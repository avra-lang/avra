new file mode 100644
index 00000000..a001b024
--- /dev/null
+++ b/packages/std-relation/src/tests/context_query/context_query.av
@@ -0,0 +1,79 @@
+// proves: a `@query` over a CONTEXT that answers its Db (`query_db()`), keyed
+// by a dense id, answers in the process only — reused while what it read
+// stands, run again once an input it read moves, and never kept for a later
+// process; the same query over the Db alone with a stable key is kept.
+use @std.relation.{query, input}
+use @std.relation.db.{Db, Durable, durable_db}
+use @std.meta.{dense}
+
+@dense
+type Item = { index: int }
+
+/// What a query's body reads beside its Db.
+type Shelf = { db: Db, scale: int }
+
+impl Shelf {
+    fn query_db() -> Db { self.db }
+
+    /// An item no other process can name: its calls stand on what they read.
+    fn item_spelled(_i: Item) -> string? { null }
+
+    fn item_numbered(_s: string) -> Item? { null }
+}
+
+once fn disk() -> Cell<Map<string, Bytes>> { Cell.new({}) }
+
+once fn kept() -> Cell<int> { Cell.new(0) }
+
+once fn computes() -> Cell<int> { Cell.new(0) }
+
+fn counted() {
+    let c = computes()
+    c.set(c.get() + 1)
+}
+
+fn read_record(query: string, args: int) -> Bytes? { disk().get().get("${query}\t${args}") }
+
+fn keep_record(query: string, args: int, record: Bytes) {
+    kept().set(kept().get() + 1)
+    disk().put("${query}\t${args}", record)
+}
+
+fn process() -> Db { durable_db(Durable { answer: read_record, keep: keep_record }) }
+
+@input
+fn base(_db: Db, at: string) -> int { 0 }
+
+@query
+fn weighed(s: Shelf, item: Item) -> int {
+    counted()
+    base(s.db, "w") * s.scale + item.index
+}
+
+@query
+fn plain(db: Db, k: string) -> int {
+    counted()
+    base(db, k) + 1
+}
+
+fn main_run() -> string {
+    let db = process()
+    set_base(db, "w", 2)
+    set_base(db, "p", 5)
+    let s = Shelf { db: db, scale: 10 }
+    let first = weighed(s, Item { index: 3 })
+    let again = weighed(s, Item { index: 3 })
+    let reused = computes().get()
+    set_base(db, "w", 4)
+    let moved = weighed(s, Item { index: 3 })
+    let ran = computes().get()
+    let p = plain(db, "p")
+    let later = process()
+    set_base(later, "w", 4)
+    set_base(later, "p", 5)
+    let fresh = weighed(Shelf { db: later, scale: 10 }, Item { index: 3 })
+    let read_back = plain(later, "p")
+    "${first} ${again} ${reused} | ${moved} ${ran} | ${p} kept ${kept().get()} | ${fresh} ${read_back} ${computes().get()}"
+}
+
+main_run()
