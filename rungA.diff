@@ -0,0 +1,58 @@
+//! A warm check after a file is deleted says what a cold check of the tree without it says:
+//! a deleted file moves its module, so nothing kept from it stands.
+use @std.io.{make_dirs, write_text, remove}
+use @std.time.{stamp}
+use commands.{checked_at}
+
+/// An app over a path dependency whose `m` module holds two files, the second warning.
+fn wd_tree(name: string) -> string {
+    let root = "/tmp/avra-warm-deleted-test/${name}-${stamp()}"
+    let _ = make_dirs("${root}/app/src")
+    let _ = make_dirs("${root}/lib/src/m")
+    let _ = write_text(
+        "${root}/lib/avra.toml",
+        "[package]\nname = \"@x/lib\"\nversion = \"0.0.1\"\n\n[lib]\nname = \"x-lib\"\npath = \"src/main.av\"\n",
+    )
+    let _ = write_text("${root}/lib/src/main.av", "export fn top() -> int { 0 }\n")
+    let _ = write_text("${root}/lib/src/m/one.av", "export fn k(x: int) -> int { x ?? 1 }\n")
+    let _ = write_text("${root}/lib/src/m/two.av", "export fn h(x: int) -> int { x ?? 2 }\n")
+    let _ = write_text(
+        "${root}/app/avra.toml",
+        "[package]\nname = \"app\"\nversion = \"0.0.1\"\n\n[lib]\nname = \"app\"\npath = \"src/main.av\"\n\n[dependencies]\n\"@x/lib\" = { path = \"../lib\" }\n",
+    )
+    let _ = write_text(
+        "${root}/app/src/main.av",
+        "use @x.lib.m.{k}\nexport fn f() -> int { k(1) }\n",
+    )
+    root
+}
+
+/// What a check of `root`'s app warns, its root spelled out of it.
+fn wd_warned(root: string) -> string? {
+    match checked_at("${root}/app") {
+        .Ok(c) -> c.warnings.replace(root, "<root>"),
+        .Err(_) -> null,
+    }
+}
+
+/// A warm check after `two.av` is deleted, beside a cold check of the tree without it.
+fn wd_pair() -> List<string?> {
+    let warm = wd_tree("warm")
+    let _ = wd_warned(warm)
+    let _ = remove("${warm}/lib/src/m/two.av")
+    let cold = wd_tree("cold")
+    let _ = remove("${cold}/lib/src/m/two.av")
+    [wd_warned(warm), wd_warned(cold)]
+}
+
+spec "commands/check warm after a deletion" {
+    given "a dependency's module file that warned, deleted after a check" {
+        then "the warm check says what a cold check says, and nothing of the deleted file" {
+            let both = wd_pair()
+            both[0] != null &&
+                both[0] == both[1] &&
+                !both[0]!.contains("two.av") &&
+                both[0]!.contains("one.av")
+        }
+    }
+}
