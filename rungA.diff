@@ -0,0 +1,68 @@
+// A query keyed by a declaration or a file names its calls past the process by the key's
+// durable spelling: one per declaration, the same whatever else its file declares, and none
+// in a process where the declaration is gone.
+use @std.avrac.testing.{test_workspace}
+use @std.avrac.core.{DeclId}
+use compiler.{Workspace}
+use compiler.host.{memory_host}
+
+fn package(files: Map<string, string>) -> Workspace {
+    let all = {..files, "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n"}
+    test_workspace(memory_host(all, all.keys()), "/w")
+}
+
+fn named(ws: Workspace, path: string, name: string) -> DeclId {
+    let f = ws.file_id(path)
+    let _ = ws.items(f)
+    ws.decls.decls_of_file(f).find((d) -> ws.decls.decl(d).name == name)!
+}
+
+fn spelled(ws: Workspace, path: string, name: string) -> string { ws.decl_id_spelled(named(ws, path, name)) ?? "" }
+
+fn two_files() -> Workspace {
+    package(
+        {
