//! PING-PONG in Avra: two tasks alternate over a pair of rendezvous
//! channels — `open_channel<int>(0)`, capacity zero, so both legs of a
//! trip park. Prints `pingpong_ns` per round trip and `pingpong_rounds`;
//! then the same rally over a pair of bells, bare (`pingpong_bell_ns`) and
//! with a five-second `within` around each wait (`pingpong_bell_within_ns`).
use @std.io.{env_or}
use @std.net.{Bell, bell}
use @std.text.{parse_int}
use @std.time.{now_ns, secs}
use @std.task.{Channel, open_channel}

/// The benchmark's environment value, or its default.
fn env_int(name: string, fallback: int) -> int {
    parse_int(env_or(name, "${fallback}")) ?? fallback
}

/// Take a ping, answer a pong — n times.
fn ponger(to_pong: Channel<int>, to_ping: Channel<int>, n: int) {
    mut i = 0
    while i < n {
        let got = to_pong.source.next()
        if got == null { return }
        let _ = to_ping.sink.send(1)
        i = i + 1
    }
}

/// One rally: n round trips, timed from the first send to the last answer.
fn rally(n: int) -> int {
    let to_pong = open_channel<int>(0)
    let to_ping = open_channel<int>(0)
    let t = spawn ponger(to_pong, to_ping, n)
    let t0 = now_ns()
    mut i = 0
    while i < n {
        let _ = to_pong.sink.send(1)
        let _ = to_ping.source.next()
        i = i + 1
    }
    let spent = now_ns() - t0
    t.await
    spent
}

fn held() -> Bell {
    match bell() { .Ok(b) -> b, .Err(_) -> Bell {} }
}

/// Answers every ring of `mine` with one of `theirs`, `n` times.
fn bell_ponger(mine: Bell, theirs: Bell, n: int) -> int {
    for i in 0..n {
        let _ = mine.waited_since(i, null)
        theirs.ring()
    }
    n
}

/// `n` round trips over two bells; each wait under a deadline when `bounded`.
fn bell_rally(n: int, bounded: bool) -> int {
    let ping = held()
    let pong = held()
    let other = spawn bell_ponger(ping, pong, n)
    let t0 = now_ns()
    for i in 0..n {
        ping.ring()
        if bounded {
            let _ = within secs(5) { pong.waited_since(i, null) }
        } else {
            let _ = pong.waited_since(i, null)
        }
    }
    let spent = now_ns() - t0
    let _ = other.await
    ping.close()
    pong.close()
    spent
}

/// The least of `rounds` runs of `run`.
fn least_of(rounds: int, run: fn() -> int) -> int {
    (1..rounds)
        .fold(
            run(),
            (best, _r) -> {
                let s = run()
                if s < best { s } else { best }
            },
        )
}

let n = env_int("BENCH_N", 100000)
let rounds = env_int("BENCH_ROUNDS", 5)
let per = (spent: int) -> spent.float() / n.float()
println("pingpong_ns\t${least_of(rounds, () -> rally(n)) / n}\tns\t${rounds}")
println("pingpong_rounds\t${n}\tops\t${rounds}")
println("pingpong_bell_ns\t${per(least_of(rounds, () -> bell_rally(n, false)))}\tns\t${rounds}")
println(
    "pingpong_bell_within_ns\t${per(least_of(rounds, () -> bell_rally(n, true)))}\tns\t${rounds}",
)
