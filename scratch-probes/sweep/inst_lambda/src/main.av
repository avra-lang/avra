use @std.meta.{Diagnostic, refuse}

component tray {
    capacity: int = 1
    run: fn(int) -> int = (x: int) -> x
    fn check() -> List<Diagnostic> { if self.capacity < 1 { [refuse("a tray holds at least one")] } else { [] } }
}

tray t {
    capacity: 0
    run: (x: int) -> x + 1
}
"${t.capacity}"
