use @std.ui.components.{field, dialog, alert, text}
use @std.ui.tree.view.{View, tree_of}
use @std.ui.tree.outline.{outline}
use @std.ui.realize.html.html.{fragment}

fn base() -> field { field "Name" }
fn shut() -> dialog { dialog "Confirm" { text "Sure?" } }

fn said(v: dyn View) -> string { outline(tree_of(v)) }

[
    said(base()),
    said(base() with { value: "Ada" }),
    said(base() with { shown: "Ada" }),
    said(base() with { label: "نام کامل شما برای ثبت" }),
    said(base() with { invalid: true }),
    said(shut() with { open: true }),
    said(shut() with { shown: true }),
    said((alert "Saved") with { urgency: .Assertive }),
    fragment(tree_of(base() with { label: "نام" })),
]
    .join("\n")
