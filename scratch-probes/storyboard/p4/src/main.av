// A component gathered as its `@std.meta` description: refused today (a record type is not —
// record_type_control.av.txt is the same collect over a `type`, answering "Gadget 1 Widget 3").
use @std.meta.{Named, Type}

fn tag(_what: Named, _label: string) {}

type Entry = { kind: Type, name: string }

@tag("a")
component widget(label: string) {
    on: bool = false
}

collect xs: List<Entry> = @tag in self as Entry { kind: it, name: it.name } by it.name

"${xs.length} ${xs[0].name} ${xs[0].kind.fields.length}"
