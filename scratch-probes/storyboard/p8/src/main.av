use @std.ui.components.{button, field, dialog, text, checkbox, column}
use @std.ui.tree.view.{View}
use @std.ui_gallery.{Case, Entry, snapshots, gallery_text, changed}

fn cases(i: int) -> List<Case> {
    [
        Case { name: "base", view: button "Save ${i}" },
        Case { name: "disabled", view: (button "Save ${i}") with { disabled: true } },
        Case { name: "field", view: (field "Name ${i}") with { value: "Ada" } },
        Case { name: "dialog", view: dialog "Sure ${i}" { text "Really?" } with { open: true } },
        Case { name: "check", view: checkbox "Agree ${i}" },
        Case { name: "column", view: column { text "a" } },
    ]
}

let entries = [Entry { view: "e${i}", cases: cases(i) } for i in 0..20]
let a = snapshots(entries)
let b = snapshots(entries)
let t = gallery_text(entries, 60)
"${a.length} snapshots, ${changed(a, b).length} changed, terminal ${t.length} chars"
