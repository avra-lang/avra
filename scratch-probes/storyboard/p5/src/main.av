use stories.story.{Shown, case_of}

type Told = { name: string, cases: fn() -> List<Shown> }
type Prim = { name: string }

collect told: List<Told> = @case_of in package as Told { name: it.name, cases: it } by it.name
collect prims: List<Prim> = @prim in closure as Prim { name: it.name } by it.name

fn storied(p: Prim) -> bool { told.any(it.name == "${p.name}_base_cases") }

let missing = [p.name for p in prims if !storied(p)]
"${prims.length} components, ${prims.length - missing.length} with a story; no story: ${missing.join(", ")}"
