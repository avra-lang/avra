// Every std-ui primitive, by the mark it wears, from a program that imports one.
use @std.ui.components.{button}

type E = { name: string, module: string }

collect xs: List<E> = @prim in closure as E { name: it.name, module: it.module } by it.module, it.name

"${xs.length}: ${xs.map(it.name).join(",")}"
