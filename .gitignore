build/
scratch/
__pycache__/
*.avra-sha256
*.av.ll
*.av.o
*.av.*.ll
packages/*/build/
*.ll.tmp.*

# a package built in place — `avra build packages/cli`
packages/**/src/main
a.out
# a bench program built in place — `avra build tools/bench/<name>`
tools/bench/*/src/main
tools/bench/*/*/src/main

# the tasks tracker (local SQLite, TASKS_DB). A `tasks` call with TASKS_DB
# unset silently creates an empty db where it stands — never commit one.
.tasks/
/tasks.db
/data/tasks.db

# compiled program-test binaries are build output
**/src/main
# a page built in place — `avra dev <package>`, `avra build --target wasm`
**/src/main.wasm
# a program test built in place — `avra build …/tests/<name>/<name>.av` —
# writes `<name>` beside its source: the one entry there with no extension
packages/**/tests/*/*
!packages/**/tests/*/*.*
!packages/**/tests/*/*/
# a fixture package's own build output — `avra test` over a package under tests/
packages/**/tests/*/build/

# the compiler build cache — derived artifacts, keyed by content
.avra-cache/
*.ll.o

.pi/
