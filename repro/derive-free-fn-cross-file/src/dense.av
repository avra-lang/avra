use @std.meta.{derive}

@derive(Unwrap)
export enum Row {
    A(int)
    B(string)
    C(bool)
    D(List<int>)
    E(int)
    F(string)
    G(bool)
    H(List<int>)
    I(int)
    J(string)
    K(bool)
    L(List<int>)
    M(int)
    N(string)
    O(bool)
    P(List<int>)
}

fn hand_written_of(r: Row) -> int { 1 }
