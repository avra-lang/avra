//! References every generated `${variant}_of` fn from a DIFFERENT file
//! than the one the `@derive(Unwrap)` annotation lives on (`dense.av`)
//! — the shape `compiler/workspace.av` calling `compiler/db.av`'s
//! `source_of`/`parsed_of`/... actually takes.
fn touch_all() -> int {
    let a: int = a_of(Row.A(1))
    let _b: string = b_of(Row.B("x"))
    let _c: bool = c_of(Row.C(true))
    let _d: List<int> = d_of(Row.D([1]))
    let e: int = e_of(Row.E(1))
    let _f: string = f_of(Row.F("x"))
    let _g: bool = g_of(Row.G(true))
    let _h: List<int> = h_of(Row.H([1]))
    let i: int = i_of(Row.I(1))
    let _j: string = j_of(Row.J("x"))
    let _k: bool = k_of(Row.K(true))
    let _l: List<int> = l_of(Row.L([1]))
    let m: int = m_of(Row.M(1))
    let _n: string = n_of(Row.N("x"))
    let _o: bool = o_of(Row.O(true))
    let _p: List<int> = p_of(Row.P([1]))
    a + e + i + m
}

fn touch_hand_written() -> int { hand_written_of(Row.A(1)) }
