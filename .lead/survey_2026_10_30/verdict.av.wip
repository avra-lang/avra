//! THE CHECK VERDICT, A NAMED ROOT. What `check` said of a program is kept under
//! a key that names the program (its root and entry) and no input, with the reads
//! it stood on — each read's name and the digest of exactly what was seen. The
//! verdict stands while every read still digests the same, so what a program
//! reads is recorded as it was read and never folded into the key by hand.
//!
//! A read is named by the door that answered it: a source's text, a covered
//! directory's listing, an embedded file, a package's object bytes, and the
//! compiler's own print. The analysed program's own packages name the set, never
//! a remembered closure row.
use core.{fp_str, joined}
use compiler.store.{Store, Stored, Reading, node_key}
use compiler.host.{Read, InputName, InputKind}
use compiler.families.{Family}

impl Workspace {
    /// Where the verdict of `under` is kept: the program's name, never an input.
    fn verdict_key(under: Keyed) -> string {
        node_key(Stored.Unit, ["verdict", self.root, under.named, joined(under.beside, "\t")])
    }

    /// THE VERDICT ANSWER: one digest of everything the verdict read, settled as
    /// the `Verdict` family's answer so `make leaves` names it and the kernel holds
    /// what it stood on.
    fn verdict_answer(under: Keyed) -> int {
        let k = key(Family.Verdict, 0)
        if !(self.db.ask(k) is .Compute) { return self.db.value_hash_of(k) ?? 0 }
        self.db.begin(k)
        let h = fp_str(
            joined(["${r.name}=${r.digest}" for r in self.verdict_reads(under)], "\n"),
        )
        self.db.settle(k, h)
        h
    }

    /// The verdict's reads written, after the answer they vouch for: a read list never
    /// stands in front of an answer that was not kept.
    fn keep_check_verdict(store: Store, under: Keyed) {
        let _ = store
            .keep_reading(Stored.Unit, self.verdict_key(under), "verdict", self.verdict_reads(under))
    }

    /// What the last derivation of `under` read — the closure AS THE ANALYSED PROGRAM
    /// HOLDS IT, never a remembered row: its inputs, each covered directory's listing,
    /// the files its compile-time runs embedded, its packages' objects, and the compiler.
    fn verdict_reads(under: Keyed) -> List<Reading> {
        let closure = ["${p.src}\t${p.root}" for p in self.packages()]
        let inputs = self.sources_of(closure).concat(under.beside)
        let embedded = self.embeds(inputs)
        let objects = self.objects_of(closure)
        [self.verdict_read(self.input(InputName { kind: .Compiler, key: "" }))]
            .concat([self.verdict_read(self.input(InputName { kind: .Text, key: f })) for f in inputs])
            .concat([self.verdict_read(self.input(InputName { kind: .Listing, key: p.src })) for p in self.packages()])
            .concat([self.verdict_read(self.input(InputName { kind: .Embedded, key: f })) for f in embedded])
            .concat([self.verdict_read(self.input(InputName { kind: .Octets, key: o })) for o in objects])
    }

    /// One door read as a saved answer's read: the name it was asked by and the
    /// digest of exactly what was seen.
    fn verdict_read(r: Read) -> Reading {
        let i = r.input()
        Reading { name: spelled(i.name), digest: i.digest.key }
    }

    /// What a named read digests to now, absent for a name this does not know.
    fn verdict_now(name: string) -> string? {
        let at = name.index_of(" ")
        if at < 1 { return null }
        let kind? = verdict_kind(name.substring(0, at)) else { return null }
        let key = name.substring(at + 1, name.length)
        self.input(InputName { kind: kind, key: key }).input().digest.key
    }
}

/// The door kind a saved read's word names, absent for a word no read begins with.
fn verdict_kind(word: string) -> InputKind? {
    [InputKind.Compiler, InputKind.Text, InputKind.Listing, InputKind.Embedded, InputKind.Octets]
        .find(kind_word(it) == word)
}
