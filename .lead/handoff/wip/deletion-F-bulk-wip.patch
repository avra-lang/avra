-/// Two tables compared WHOLE, column by column: its name, where its window starts, the value it
-/// grows with, and every cell in order.
-fn same_facts(a: TypeFacts, b: TypeFacts) -> bool {
-    same_column(a.of_expr, b.of_expr, same_type) &&
-        same_column(a.widens, b.widens, same_opt_type) &&
-        same_column(a.narrows, b.narrows, same_opt_type) &&
-        same_column(a.asks, b.asks, (x, y) -> opt_eq(x, y, same_asked)) &&
-        same_column(a.substs, b.substs, (x, y) -> opt_eq(x, y, same_sub)) &&
-        same_column(a.lambda_params, b.lambda_params, same_opt_types) &&
-        same_column(a.lambda_marks, b.lambda_marks, (x, y) -> opt_eq(x, y, same_marks)) &&
-        same_column(a.captures, b.captures, same_opt_types) &&
-        same_column(a.wants, b.wants, same_opt_type) &&
-        same_column(a.flags, b.flags, (x: int, y: int) -> x == y) &&
-        same_column(a.starved, b.starved, same_opt_type) &&
-        same_column(
-            a.scopes,
-            b.scopes,
-            (x, y) -> opt_eq(x, y, (p: ParamScope, q: ParamScope) -> same_types(p.params, q.params)),
-        ) &&
-        same_column(a.pattern_types, b.pattern_types, same_types) &&
-        same_column(a.binding_types, b.binding_types, same_opt_type) &&
-        same_column(a.const_types, b.const_types, same_opt_type) &&
-        same_column(a.index_types, b.index_types, same_opt_type) &&
-        same_column(a.stmt_flags, b.stmt_flags, (x: int, y: int) -> x == y) &&
-        same_column(
-            a.collections,
-            b.collections,
-            (x, y) -> opt_eq(x, y, (p: List<ExprId>, q: List<ExprId>) -> list_eq(p, q, same_expr)),
-        ) &&
-        same_column(a.chosen, b.chosen, (x, y) -> opt_eq(x, y, same_decl)) &&
-        same_column(a.dispatches, b.dispatches, (x, y) -> opt_eq(x, y, same_choice)) &&
-        same_column(
-            a.stages,
-            b.stages,
-            (x, y) -> opt_eq(x, y, (p: PipeStage, q: PipeStage) -> p.ordinal == q.ordinal),
-        ) &&
-        a.voices.list.is_empty() &&
-        b.voices.list.is_empty()
-}
