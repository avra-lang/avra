-                decl: null,
-                name: "plain",
-                sub: null,
-                seats: [],
-                root: null,
-            },
-            Wanted {
-                file: self.file_id("/w/src/main.av"),
-                decl: null,
-                name: "seated",
-                sub: null,
-                seats: [seat],
-                root: null,
