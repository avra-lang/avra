-        let host2 = self.ws.host with { peek: (p: string) -> if normalized(p) == normalized(path) { Beneath.Text(text) } else { (self.ws.host.peek)(p) }, quiet: (p: string) -> if normalized(p) == normalized(path) { kept_from } else { everything } }
