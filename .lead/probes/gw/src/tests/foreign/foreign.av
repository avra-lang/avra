// proves: a trait whose argument is the impl's own type parameter, over a
// generic another package declares: a channel's source.
use @std.task.{Channel, Source, open_channel}

trait Drawn<T> {
    fn drawn() -> T?
}

impl Drawn<T> for Source<T> {
    fn drawn() -> T? { self.next() }
}

let c: Channel<int> = open_channel(2)
let _ = c.sink.send(7)
let s = c.source
"${s.drawn() ?? -1}"
