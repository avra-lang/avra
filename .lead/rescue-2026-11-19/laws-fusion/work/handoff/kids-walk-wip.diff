+/// One variant's kids pushed onto `onto` in `kids_case`'s order, answering how long `onto` then is:
+/// an id payload pushed where it lies, any other payload through its kids.
+fn pushed_case(t: MetaType, v: MetaVariant) -> Arms {
+    if v.fields.is_empty() { return quote { .${v} -> onto.length } }
+    let pushes = [pushed_part(f, r!) for f in v.fields if reached(f) for r in [reach_shape(t, v, f)] if r != null]
+    if pushes.is_empty() { return quote { .${v}(${binders(v)}) -> onto.length } }
+    quote {
+        .${v}(${binders(v)}) -> {
+            ${..pushes}
+            onto.length
+        }
+    }
+}
+
+/// One payload's kids pushed onto `onto`; `reach` is its kids as a list, for a payload of no id row.
+fn pushed_part(f: Field, reach: Code) -> Stmts {
+    let b = name(f.name)
+    match f.kind.spelled() {
+        "ExprId" -> quote { onto.push(At.Expr(${b})) },
+        "ExprId?" -> quote { if ${b} != null { onto.push(At.Expr(${b}!)) } },
+        "List<ExprId>" -> quote { for each in ${b} { onto.push(At.Expr(each)) } },
+        "StmtId" -> quote { onto.push(At.Stmt(${b})) },
+        "List<StmtId>" -> quote { for each in ${b} { onto.push(At.Stmt(each)) } },
+        "PatId" -> quote { onto.push(At.Pat(${b})) },
+        "List<PatId>" -> quote { for each in ${b} { onto.push(At.Pat(each)) } },
+        _ -> quote { for each in ${reach} { onto.push(each) } },
+    }
+}
+
