trait Show {
    fn show() -> int
}
type P = { x: int }
type Q = { y: int }
type Model<T> = { v: T }
impl Show for P {
    fn show() -> int { self.x }
}
impl Show for Q {
    fn show() -> int { self.y * 2 }
}
impl Show for Model<T> {
    fn show() -> int { 7 }
}
fn call_it(d: dyn Show) -> int { d.show() }
fn make_it(n: int) -> dyn Show { P { x: n } }
fn make_model(n: int) -> dyn Show { Model { v: P { x: n } } }
fn test_it(d: dyn Show) -> int {
    if d is p: P { return p.x }
    0
}
mut total = 0
for i in 0..1000 {
    let d: dyn Show = if i % 3 == 0 { make_it(i) } else if i % 3 == 1 { make_model(i) } else { Q { y: i } }
    total = total + call_it(d) + test_it(d)
}
println("${total}")
