trait Show {
    fn show() -> int
}
type P = { x: int }
impl Show for P {
    fn show() -> int { self.x }
}
type Pt = { a: int, b: int }
fn note(s: string) {}
const JOINED: string = "a" + "b"
fn pick(const p: string, s: string) -> int { p.length + s.length }
fn kept(p: List<int>, b: bool) -> List<List<int>> {
    if b { return [p] }
    [p]
}
fn work(m: Map<string, int>, k: string, d: dyn Show, n: int) -> int {
    let label = "x${n}"
    defer note(label)
    mut mm = m
    mm.set(k, (mm.get(k) ?? 0) + k.length)
    let pts = [Pt { a: 1, b: 2 }, Pt { a: n, b: 3 }]
    let maybe: List<int?> = [1, null]
    let parts = [1, 2]
    pick(JOINED, "s") + parts.length + d.show() + pts.length + maybe.length + kept([n], true).length
}
println("${work({}, "k", P { x: 2 }, 3)}")
