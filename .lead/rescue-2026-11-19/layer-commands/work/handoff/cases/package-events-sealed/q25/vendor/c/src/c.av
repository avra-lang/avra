use @std.meta.{Code}
use @std.meta.{Type, Directive, sealed}
@sealed
export type Token = string
export fn token_of(s: string) -> Token {
    Token(s)
}
export trait Blank {
    static fn derive(t: Type) -> List<Directive> {
        [Directive { twin: "", name: t.name, at: t.at, source: quote { impl ${t} { fn blank() -> ${t} {
    let made: ${t} = ""
    made
} } } }]
    }
}
export trait Forge {
    static fn derive(t: Type) -> List<Directive> {
        [Directive { twin: "", name: t.name, at: t.at, source: quote { impl ${t} { fn forged() -> Token { Token("forged") } } } }]
    }
}
