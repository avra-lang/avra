use @std.meta.{sealed, Type}
@sealed
export type Url = string
@sealed
export type Box<T> = { held: T }
export fn boxed(n: int) -> Box<int> {
    Box { held: n }
}
export enum Wrap {
    W(Url)
}
export fn linked(_t: Type, _to: Url) {}
@sealed
export type Point = { x: int, y: int }
@sealed
export enum Scheme {
    Http
    Other(string)
}
export fn url_of(s: string) -> Url {
    Url(s)
}
export fn home() -> Url {
    Url("home")
}
export fn origin() -> Point {
    Point { x: 0, y: 0 }
}
export fn east(p: Point) -> Point {
    p with { x: p.x + 1 }
}
export fn north(mut p: Point) {
    p.y = p.y + 1
}
export fn http() -> Scheme {
    .Http
}
export fn other(s: string) -> Scheme {
    .Other(s)
}
export fn scheme_name(s: Scheme) -> string {
    match s {
        .Http -> "http"
        .Other(n) -> n
    }
}
