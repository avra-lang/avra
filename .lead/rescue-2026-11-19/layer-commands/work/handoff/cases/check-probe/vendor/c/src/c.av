use @std.meta.{Diagnostic, refuse}

export type Cron = { fields: List<string> }

export fn cron(text: string) -> Cron { Cron { fields: text.split(" ") } }

export fn cron_or(text: string) -> Result<Cron, string> {
    if text.is_empty() { return .Err("empty") }
    .Ok(Cron { fields: text.split(" ") })
}

export component schedule {
    at: Cron
    name: string = "job"
    fn check() -> List<Diagnostic> {
        if self.at.fields.length == 5 { return [] }
        [refuse("a cron line has 5 fields, this has ${self.at.fields.length}")]
    }
}

