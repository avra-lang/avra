trait Realize<P> {
    fn draw(p: P) -> string
}
type Text = { content: string }
type Button = { label: string }
type Plain = {}
impl Realize<Text> for Plain {
    fn draw(p: Text) -> string { p.content }
}
fn f<R: Realize<Text>>(r: R) -> string { r.draw(Text { content: "m" }) }
fn g<Q: Realize<Text>>(q: Q) -> string { f(q) + f(q) }
g(Plain {})
