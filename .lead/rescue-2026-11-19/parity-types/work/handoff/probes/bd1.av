trait Realize<T> {
    fn draw(t: T) -> string
}
type Text = { content: string }
type Button = { label: string }
type Plain = { tag: string = "" }
impl Realize<Text> for Plain {
    fn draw(t: Text) -> string { t.content }
}
fn f<T, R: Realize<T>>(r: R, t: T) -> int { 1 }
fn g<Q: Realize<Text>>(q: Q) -> int { f(q, Button { label: "b" }) }
fn h<Q: Realize<Text>>(q: Q) -> int { f(q, Text { content: "c" }) }
h(Plain {})
