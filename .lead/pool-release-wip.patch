diff --git a/runtime/avra_pool.c b/runtime/avra_pool.c
index e2d2114b..b8d0660c 100644
--- a/runtime/avra_pool.c
+++ b/runtime/avra_pool.c
@@ -132,6 +132,17 @@ int64_t avra_pool_allowed(int64_t in_use) {
     return FREE_BYTES + (int64_t)g_held_count * SLOT_BYTES;
 }
 
+// The slots this process holds past what `in_use` needs, given back to the machine; what it may
+// use before it asks again. Half a slot of slack stays, so a run that grows a little asks nobody.
+int64_t avra_pool_let_go(int64_t in_use) {
+    pool_settled();
+    if (g_slot_count <= 0) return INT64_MAX;
+    while (g_held_count > 0 && FREE_BYTES + (int64_t)(g_held_count - 1) * SLOT_BYTES >= in_use + SLOT_BYTES) {
+        close(g_held[--g_held_count]);
+    }
+    return FREE_BYTES + (int64_t)g_held_count * SLOT_BYTES;
+}
+
 // How many slots this process holds.
 int64_t avra_pool_held(void) { return g_held_count; }
 
@@ -142,6 +153,8 @@ int64_t avra_pool_free_bytes(void) { return FREE_BYTES; }
 
 int64_t avra_pool_allowed(int64_t in_use) { (void)in_use; return INT64_MAX; }
 
+int64_t avra_pool_let_go(int64_t in_use) { (void)in_use; return INT64_MAX; }
+
 int64_t avra_pool_held(void) { return 0; }
 
 int64_t avra_pool_free_bytes(void) { return INT64_MAX; }
diff --git a/runtime/avra_runtime.c b/runtime/avra_runtime.c
index d5f47b24..939c9a8d 100644
--- a/runtime/avra_runtime.c
+++ b/runtime/avra_runtime.c
@@ -573,6 +573,7 @@ static void acc_report(void) {
 static int64_t g_mem_ceiling;
 static int64_t g_mem_next;
 int64_t avra_pool_allowed(int64_t in_use);
+int64_t avra_pool_let_go(int64_t in_use);
 int64_t avra_pool_free_bytes(void);
 #endif
 
@@ -674,6 +675,18 @@ static void mem_ceiling_measure(void) {
 }
 #endif
 
+// THE POOL IS HELD FOR WHAT IS IN USE, NEVER FOR A PEAK: a run about to wait on a child gives back
+// the slots its own memory no longer fills, so the child and every other run may take them.
+void avra_mem_settle(void) {
+#if AVRA_MEASURES_MEMORY
+    if (g_mem_ceiling <= 0) return;
+    int64_t used = mem_in_use();
+    int64_t allowed = avra_pool_let_go(used);
+    int64_t limit = allowed < g_mem_ceiling ? allowed : g_mem_ceiling;
+    g_mem_next = g_live_bytes + (limit - used);
+#endif
+}
+
 static inline void mem_ceiling_check(void) {
 #if AVRA_MEASURES_MEMORY
     if (__builtin_expect(g_mem_ceiling > 0 && g_live_bytes > g_mem_next, 0)) mem_ceiling_measure();
@@ -4704,6 +4717,7 @@ int64_t avra_spawn_status(const char* prog, void* args) {
     free(argv);
     if (started != 0) return 127;
     int status;
+    avra_mem_settle();
     avra_clock_hold(1);
     pid_t waited = waitpid(pid, &status, 0);
     avra_clock_hold(-1);
@@ -4735,6 +4749,7 @@ int64_t avra_spawn_in(const char* dir, const char* prog, void* args) {
     free(argv);
     if (started != 0) return 127;
     int status;
+    avra_mem_settle();
     avra_clock_hold(1);
     pid_t waited = waitpid(pid, &status, 0);
     avra_clock_hold(-1);
