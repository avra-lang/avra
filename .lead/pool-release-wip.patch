diff --git a/tools/pool/src/main.av b/tools/pool/src/main.av
index e9aac468..ddc046fb 100644
--- a/tools/pool/src/main.av
+++ b/tools/pool/src/main.av
@@ -1,9 +1,32 @@
 use @std.io.{env}
+use @std.process.{cmd, inherited, status_of, tool_at}
 use @std.text.{parse_int}
 use @std.time.{ms, sleep}
 
-let count = 1000000 * (parse_int(env("POOL_MB") ?? "100") ?? 100) / 8
-let xs = [i for i in 0..count]
+/// How many numbers a list of `mb` megabytes holds.
+fn held_in(mb: int) -> int { 1000000 * mb / 8 }
+
+/// A list of `mb` megabytes made and dropped: how many it held.
+fn peaked(mb: int) -> int {
+    let xs = [i for i in 0..held_in(mb)]
+    xs.length
+}
+
+/// This program run again as a child holding `mb` megabytes: its exit status, or -1 unstarted.
+fn child_status(self_path: string, mb: int) -> int {
+    match (cmd(tool_at("probe", self_path), []) with { env: inherited().with_var("POOL_MB", "${mb}").with_var("PEAK_MB", "0") })
+        .outcome() {
+        .Ok(ran) -> status_of(ran.exit),
+        .Err(_) -> -1,
+    }
+}
+
+let peak = parse_int(env("PEAK_MB") ?? "0") ?? 0
+if peak > 0 {
+    println("peaked ${peaked(peak)}")
+    println("child ${child_status(env("POOL_SELF") ?? "", parse_int(env("POOL_MB") ?? "100") ?? 100)}")
+}
+let xs = [i for i in 0..held_in(if peak > 0 { 1 } else { parse_int(env("POOL_MB") ?? "100") ?? 100 })]
 println("allocated ${xs.length}")
 sleep(ms(parse_int(env("HOLD_MS") ?? "0") ?? 0))
 println("done ${xs[xs.length - 1]}")
diff --git a/tools/pool_check.sh b/tools/pool_check.sh
index 8b51464e..c6c5c164 100755
--- a/tools/pool_check.sh
+++ b/tools/pool_check.sh
@@ -1,7 +1,7 @@
 #!/bin/sh
 # THE MEMORY POOL, held to what it promises, with real processes: a run needing more than the whole
 # pool refuses in its own words; a run inside it finishes; a run that finds the pool held waits for
-# it and then finishes. Each case gets a pool of its own, so no real run's slots are touched.
+# it and then finishes; a run that waits on a child holds only what it still uses. Each case gets a pool of its own, so no real run's slots are touched.
 set -u
 cd "$(dirname "$0")/.."
 probe_dir=tools/pool
@@ -29,5 +29,9 @@ wait "$first"
 case "$second" in *"waiting for memory"*"done 37499999"*) said "a run finding the pool held waits, then finishes";; *) said "FAIL: a run finding the pool held: $second"; failed=1;; esac
 grep -q "done 62499999" "$pools/first.out" || { said "FAIL: the run holding the pool: $(cat "$pools/first.out")"; failed=1; }
 
-[ "$failed" = 0 ] && said "3 cases held" && exit 0
+mkdir "$pools/peak"
+out=$(AVRA_MEM_POOL_DIR="$pools/peak" AVRA_MEM_POOL_MB=1024 AVRA_MEM_POOL_WAIT_MS=2000 PEAK_MB=400 POOL_MB=300 POOL_SELF="$PWD/$probe" "$probe" 2>&1)
+case "$out" in *"child 0"*) said "a run past its peak gives its slots back to the child it waits on";; *) said "FAIL: a run past its peak kept the pool from its child: $out"; failed=1;; esac
+
+[ "$failed" = 0 ] && said "4 cases held" && exit 0
 exit 1
