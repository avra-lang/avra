+/// A program at `/w` that uses the real `@std/task`, with its closure vendored beside the
+/// prelude: a channel or a producer opens through the package's own fns, so it runs.
+export fn beside_task(main: string) -> Judged {
+    let files = vendored_task(
+        {"/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n", "/w/src/main.av": main},
+    )
+    held_at(files, "/w").judged_at("/w/src/main.av")
+}
+
 /// A program at `/w` whose toolchain carries the real `@std/prelude`
