index 00000000..49066df1
--- /dev/null
+++ b/packages/std-avrac/src/compiler/item_never_ends.av
@@ -0,0 +1,136 @@
+//! WHERE A TASK IS JOINED WITH A CHANNEL OPEN: a bare `channel<T>(n)` ends only at `close()`, so a
+//! block that spawns a task reading a channel's `.source`, and closes no channel's sink, joins that
+//! task with the channel open — the reader parks for a close nobody writes. The block's own nodes
+//! are read, never a callee's body: the spawn spells the `.source` read. The statements an entry runs
+//! are one block, read once for the file; each fn's body is a block of its own.
+use core.{ExprId, Span, SyntaxArena, flatten, some_list}
+use compiler.laws.{Found, law}
+use diagnostics.{Voice}
+use features.tasks.{channel_never_ends}
+use @std.meta.{derive}
+use @std.program.address.{SourceFileAddress}
+use @std.program.query_engine.{QueryDefinition, QueryEngine}
+use @std.program.saved_derive.{Saved}
+use @std.program.saved_query.{ListedQuery, definitions_of, query, query_definition}
+
+/// A spawn among the statements an entry runs whose task reads the channel `name` to its end: the
+/// written item it stands in, and where.
+@derive(Saved)
+type EntryNeverEnding = { item: int, at: FindingAt?, name: string }
+
+/// Every spawn among the statements an entry runs whose task reads a channel no close ends.
+@derive(Saved)
+type EntryNeverEnds = { rows: List<EntryNeverEnding> }
+
+/// A spawn `spawned` whose task reads the channel `name` to its end.
+type NeverEnding = { spawned: ExprId, name: string }
+
+/// Every spawn among the statements the entry `file` runs whose task reads a channel no close ends,
+/// each with the written item it stands in: the entry read once, as one block, for all its items.
+@query
+fn entry_never_ends(engine: QueryEngine, file: SourceFileAddress) -> EntryNeverEnds {
+    let read = entry_read(engine, file)
+    let exprs = [ExprId { index: i } for i in 0..read.store.expr_count()]
+    EntryNeverEnds {
+        rows: [EntryNeverEnding {
+            item: item_holding(read, n.spawned.index),
+            at: kept_at(read.store.expr_span(n.spawned)),
+            name: n.name,
+        } for n in never_ending(read.store, exprs)],
+    }
+}
+
+/// Every spawn of the written item `at` of `file` whose task reads a channel its block closes none
+/// of: in each fn the item declares, and among the statements of the entry it stands in.
+fn channels_left_open(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
+    if at >= item_count(engine, file) { return [] }
+    let store = read_item(engine, file, at).store
+    let bodies = [b for s in read_item(engine, file, at).stmts for b in some_list(store.fn_parts(s)?.body)]
+    let in_fns = flatten([never_ending(store, store.every_expr(b)) for b in bodies])
+    [Found { at: store.expr_span(n.spawned), args: [n.name] } for n in in_fns]
+        .concat(
+            [Found { at: span_of(r.at), args: [r.name] } for r in entry_never_ends(engine, file).rows if r.item == at],
+        )
+}
+
+/// Each spawn among `exprs`, the nodes of one block of `store`, whose task reads a bare channel's
+/// `.source`, where the block closes no channel's sink.
+fn never_ending(store: SyntaxArena, exprs: List<ExprId>) -> List<NeverEnding> {
+    if exprs.any((e) -> closes_sink(store, e)) { return [] }
+    [NeverEnding { spawned: e, name: n! } for e in exprs if store.expr(e) is .Spawn for n in [read_inside(store, exprs, e)] if n != null]
+}
+
+/// The name of the channel the spawn `spawned` reads `.source` of, among `exprs`: its own span bounds
+/// the reads, so one beside it in the same block is not the task's.
+fn read_inside(store: SyntaxArena, exprs: List<ExprId>, spawned: ExprId) -> string? {
+    let at? = store.expr_span(spawned) else { return null }
+    let read? = exprs.find((e) -> stands_inside(store.expr_span(e), at) && source_read(store, e)) else { return null }
+    reader_name(store, read)
