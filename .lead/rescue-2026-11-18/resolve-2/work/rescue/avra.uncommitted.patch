+//! THE KIND OF A NODE, with no payload: one arm per variant of `Expr`, `Stmt` and `Pat`, named by
+//! its family and its variant. What a law that judges nodes declares it judges, and what an item's
+//! nodes are filed under. Each family's kind is one match spelling every variant, so a variant added
+//! without its kind is refused where it is declared.
+
+/// Which variant of which node family a node is.
+export enum NodeKind {
+    ExprArmsBody
+    ExprBinary
+    ExprBitnot
+    ExprBlock
+    ExprBlockLambda
+    ExprBody
+    ExprBoolLit
+    ExprBracedHead
+    ExprBytesLit
+    ExprCall
+    ExprCallValue
+    ExprCatch
+    ExprChain
+    ExprChainApply
+    ExprChainCall
+    ExprChainType
+    ExprChannel
+    ExprCoalesce
+    ExprCollect
+    ExprComp
+    ExprComponent
+    ExprElseArm
+    ExprEmit
+    ExprEnv
+    ExprError
+    ExprFloatLit
+    ExprForce
+    ExprGrammarLit
+    ExprIdent
+    ExprIf
+    ExprIndex
+    ExprInstanceFn
+    ExprIntLit
+    ExprIs
+    ExprLambda
+    ExprLetPattern
+    ExprListLit
+    ExprMapLit
+    ExprMatch
+    ExprMatchOpt
+    ExprMethodCall
+    ExprNamed
+    ExprNeg
+    ExprNot
+    ExprNullLit
+    ExprPipe
+    ExprProduce
+    ExprProp
+    ExprPropagate
+    ExprRange
+    ExprReceiver
+    ExprSelect
+    ExprSpawn
+    ExprStrLit
+    ExprStructLit
+    ExprTable
+    ExprTrailed
+    ExprTypeLiteral
+    ExprVariantLit
+    ExprWaitArm
+    ExprWhen
+    ExprWith
+    ExprWithin
+    StmtAlias
+    StmtAssign
+    StmtCollect
+    StmtCollectEnum
+    StmtComponentDecl
+    StmtConstDecl
+    StmtDefer
+    StmtDiscard
+    StmtEnumDecl
+    StmtError
+    StmtExprStmt
+    StmtExternFn
+    StmtFail
+    StmtFnDecl
+    StmtForEach
+    StmtImplDecl
+    StmtJump
+    StmtLet
+    StmtLetElse
+    StmtMutLet
+    StmtNamedType
+    StmtReturn
+    StmtSetting
+    StmtSpec
+    StmtStructDecl
+    StmtSyntaxDecl
+    StmtTraitDecl
+    StmtUse
+    StmtWhile
+    PatBind
+    PatFields
+    PatFormat
+    PatLit
+    PatMember
+    PatQuote
+    PatRest
+    PatSeq
+    PatTyped
+    PatVariant
+    PatWild
+}
+
+/// The kind of the expr `n`.
+export fn kind_of_expr(n: Expr) -> NodeKind {
+    match n {
+        .ArmsBody -> NodeKind.ExprArmsBody,
+        .Binary -> NodeKind.ExprBinary,
+        .Bitnot -> NodeKind.ExprBitnot,
+        .Block -> NodeKind.ExprBlock,
+        .BlockLambda -> NodeKind.ExprBlockLambda,
+        .Body -> NodeKind.ExprBody,
+        .BoolLit -> NodeKind.ExprBoolLit,
+        .BracedHead -> NodeKind.ExprBracedHead,
+        .BytesLit -> NodeKind.ExprBytesLit,
+        .Call -> NodeKind.ExprCall,
+        .CallValue -> NodeKind.ExprCallValue,
+        .Catch -> NodeKind.ExprCatch,
+        .Chain -> NodeKind.ExprChain,
+        .ChainApply -> NodeKind.ExprChainApply,
+        .ChainCall -> NodeKind.ExprChainCall,
+        .ChainType -> NodeKind.ExprChainType,
+        .Channel -> NodeKind.ExprChannel,
+        .Coalesce -> NodeKind.ExprCoalesce,
+        .Collect -> NodeKind.ExprCollect,
+        .Comp -> NodeKind.ExprComp,
+        .Component -> NodeKind.ExprComponent,
+        .ElseArm -> NodeKind.ExprElseArm,
+        .Emit -> NodeKind.ExprEmit,
+        .Env -> NodeKind.ExprEnv,
+        .Error -> NodeKind.ExprError,
+        .FloatLit -> NodeKind.ExprFloatLit,
+        .Force -> NodeKind.ExprForce,
+        .GrammarLit -> NodeKind.ExprGrammarLit,
+        .Ident -> NodeKind.ExprIdent,
+        .If -> NodeKind.ExprIf,
+        .Index -> NodeKind.ExprIndex,
+        .InstanceFn -> NodeKind.ExprInstanceFn,
+        .IntLit -> NodeKind.ExprIntLit,
+        .Is -> NodeKind.ExprIs,
+        .Lambda -> NodeKind.ExprLambda,
+        .LetPattern -> NodeKind.ExprLetPattern,
+        .ListLit -> NodeKind.ExprListLit,
+        .MapLit -> NodeKind.ExprMapLit,
+        .Match -> NodeKind.ExprMatch,
+        .MatchOpt -> NodeKind.ExprMatchOpt,
+        .MethodCall -> NodeKind.ExprMethodCall,
+        .Named -> NodeKind.ExprNamed,
+        .Neg -> NodeKind.ExprNeg,
+        .Not -> NodeKind.ExprNot,
+        .NullLit -> NodeKind.ExprNullLit,
+        .Pipe -> NodeKind.ExprPipe,
+        .Produce -> NodeKind.ExprProduce,
+        .Prop -> NodeKind.ExprProp,
+        .Propagate -> NodeKind.ExprPropagate,
+        .Range -> NodeKind.ExprRange,
+        .Receiver -> NodeKind.ExprReceiver,
+        .Select -> NodeKind.ExprSelect,
+        .Spawn -> NodeKind.ExprSpawn,
+        .StrLit -> NodeKind.ExprStrLit,
+        .StructLit -> NodeKind.ExprStructLit,
+        .Table -> NodeKind.ExprTable,
+        .Trailed -> NodeKind.ExprTrailed,
+        .TypeLiteral -> NodeKind.ExprTypeLiteral,
+        .VariantLit -> NodeKind.ExprVariantLit,
+        .WaitArm -> NodeKind.ExprWaitArm,
+        .When -> NodeKind.ExprWhen,
+        .With -> NodeKind.ExprWith,
+        .Within -> NodeKind.ExprWithin,
+    }
+}
+
+/// The kind of the stmt `n`.
+export fn kind_of_stmt(n: Stmt) -> NodeKind {
+    match n {
+        .Alias -> NodeKind.StmtAlias,
+        .Assign -> NodeKind.StmtAssign,
+        .Collect -> NodeKind.StmtCollect,
+        .CollectEnum -> NodeKind.StmtCollectEnum,
+        .ComponentDecl -> NodeKind.StmtComponentDecl,
+        .ConstDecl -> NodeKind.StmtConstDecl,
+        .Defer -> NodeKind.StmtDefer,
+        .Discard -> NodeKind.StmtDiscard,
+        .EnumDecl -> NodeKind.StmtEnumDecl,
+        .Error -> NodeKind.StmtError,
+        .ExprStmt -> NodeKind.StmtExprStmt,
+        .ExternFn -> NodeKind.StmtExternFn,
+        .Fail -> NodeKind.StmtFail,
+        .FnDecl -> NodeKind.StmtFnDecl,
+        .ForEach -> NodeKind.StmtForEach,
+        .ImplDecl -> NodeKind.StmtImplDecl,
+        .Jump -> NodeKind.StmtJump,
+        .Let -> NodeKind.StmtLet,
+        .LetElse -> NodeKind.StmtLetElse,
+        .MutLet -> NodeKind.StmtMutLet,
+        .NamedType -> NodeKind.StmtNamedType,
+        .Return -> NodeKind.StmtReturn,
+        .Setting -> NodeKind.StmtSetting,
+        .Spec -> NodeKind.StmtSpec,
+        .StructDecl -> NodeKind.StmtStructDecl,
+        .SyntaxDecl -> NodeKind.StmtSyntaxDecl,
+        .TraitDecl -> NodeKind.StmtTraitDecl,
+        .Use -> NodeKind.StmtUse,
+        .While -> NodeKind.StmtWhile,
+    }
+}
+
+/// The kind of the pat `n`.
+export fn kind_of_pat(n: Pat) -> NodeKind {
+    match n {
+        .Bind -> NodeKind.PatBind,
+        .Fields -> NodeKind.PatFields,
+        .Format -> NodeKind.PatFormat,
+        .Lit -> NodeKind.PatLit,
+        .Member -> NodeKind.PatMember,
+        .Quote -> NodeKind.PatQuote,
+        .Rest -> NodeKind.PatRest,
+        .Seq -> NodeKind.PatSeq,
+        .Typed -> NodeKind.PatTyped,
+        .Variant -> NodeKind.PatVariant,
+        .Wild -> NodeKind.PatWild,
+    }
+}
+
+impl SyntaxArena {
+    /// The kind of the node `at`; absent for a field or a seat, which no arena holds.
+    fn node_kind(at: At) -> NodeKind? {
+        match at {
+            .Expr(id) -> kind_of_expr(self.expr(id)),
+            .Stmt(id) -> kind_of_stmt(self.stmt(id)),
+            .Pat(id) -> kind_of_pat(self.pat(id)),
+            .Field(_, _) or .Param(_, _) -> null,
+        }
+    }
+}
