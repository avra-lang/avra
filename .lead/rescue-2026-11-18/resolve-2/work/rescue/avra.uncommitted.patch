+
+/// How a handler is unheard and the names the reason holds, as a finding hands them on.
+fn unheard_words(why: Unheard?) -> List<List<string>> {
+    let w? = why else { return [] }
+    match w {
+        .Undeclared(declared) -> [["undeclared", declared.join(NAMES_APART)]],
+        .Seats(says) -> [["seats", says.join(NAMES_APART)]],
+        .Twice -> [["twice", ""]],
+    }
+}
+
+/// an event's seats have distinct names
+export law event_seats_distinct {
+    kind: "type.component_event"
+    reads: seats_named_twice
+    voice: seat_twice_words
+    witness: "component pad {\n    on drag(x: int, x: int)\n}\n"
+}
+
+/// a component has one default event
+export law event_default_once {
+    kind: "type.component_event"
+    reads: defaults_twice
+    voice: default_twice_words
+    witness: "component pair {\n    @default on a\n    @default on b\n}\n"
+}
+
+/// only an event is a component's default
+export law event_default_is_an_event {
+    kind: "type.component_event"
+    reads: defaults_on_fields
+    voice: default_field_words
+    witness: "component flat {\n    @default size: int = 1\n}\n"
+}
+
+/// a composition fires or hands on each event it declares
+export law event_fired {
+    kind: "type.component_event"
+    reads: events_unfired
+    voice: unfired_words
+    warns: true
+    witness: "component feed(name: string) {\n    on message(text: string)\n    self.name\n}\n"
+}
+
+/// a template declares no event
+export law event_of_no_template {
+    kind: "type.component_event"
+    reads: events_copied
+    voice: copied_words
+    witness: "use @std.meta.{Code}\n\ncomponent lim {\n    on press\n    fn expand() -> Code { quote { 1 } }\n}\n"
+}
+
+/// an instance hears the events its component declares
+export law event_heard {
+    kind: "type.component_event"
+    reads: handlers_unheard
+    voice: unheard_voice
+    witness: "component panel {\n    on press\n}\n\nfn f() -> int {\n    let a = panel { on hover { 1 } }\n    1\n}\n"
+}
+
+fn seat_twice_words(a: List<string>) -> Voice { event_seat_twice(a[0], a[1]) }
+
+fn default_twice_words(a: List<string>) -> Voice { event_default_twice(a[0], names_of(a[1])) }
+
+fn default_field_words(a: List<string>) -> Voice { event_default_field(a[0], a[1]) }
+
+fn unfired_words(a: List<string>) -> Voice { event_unfired(a[0], a[1]) }
+
+fn copied_words(a: List<string>) -> Voice { event_copied(a[0], a[1]) }
+
+fn unheard_voice(a: List<string>) -> Voice {
+    match a[0] {
+        "undeclared" -> event_undeclared(a[1], a[2], names_of(a[3])),
+        "seats" -> event_misheard(a[2], names_of(a[3])),
+        _ -> event_heard_twice(a[1], a[2]),
+    }
+}
