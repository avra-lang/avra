+/// A quote's hole, or the quote, breaking its seat beyond its position: the fault, then what it holds.
+fn holes_faulted(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
+    flatten([hole_fault_words(r) for r in refused_in(engine, file, at)])
+}
+
+fn hole_fault_words(r: RefusedSeat) -> List<Found> {
+    let fault? = match r.seat { .HoleFault(f) -> f, _ -> null } else { return [] }
+    found_saying(
+        r,
+        match fault {
+            .Unfillable(found) -> ["unfillable", found],
+            .Mixed -> ["mixed"],
+            .Ambiguous -> ["ambiguous"],
+            .Unnoded(found) -> ["unnoded", found],
+        },
+    )
+}
+
+/// a quote's holes fill as the quote's kind takes them
+export law hole_fills_its_quote {
+    kind: "type.quote_hole"
+    reads: holes_faulted
+    voice: hole_fault_said
+    witness: "use @std.meta.{Code}\n\nfn f(s: string) -> Code { quote { fn g() -> string { \${s} } } }\n"
+}
+
+fn hole_fault_said(a: List<string>) -> Voice {
+    match a[0] {
+        "unfillable" -> hole_unfillable(a[1]),
+        "mixed" -> holes_mixed(),
+        "ambiguous" -> hole_ambiguous(),
+        _ -> hole_unnoded(a[1]),
+    }
+}
