#!/bin/sh
# THE avra COMMAND — the compiler, hosted by itself. `build/avra` is
# the working binary; it rebuilds from `make avra`, which uses the
# binary that is already there. The bootstrap path exists for a cold
# tree only, and names bs2 in exactly one place.
root="$(cd "$(dirname "$0")" && pwd)"
# the link flags a manifest writes as ${LLVM_PREFIX}
LLVM_PREFIX="${LLVM_PREFIX:-/opt/homebrew/opt/llvm}"
export LLVM_PREFIX
cd "$root" || exit 2

if [ -x build/avra ]; then
    exec build/avra "$@"
fi

# COLD TREE: no compiler yet. The SEED is the way back — the compiler
# emitted, committed, and linkable by clang alone. bs2 cannot do this
# any more: it has never heard of `grammar { … }`, which 30 feature
# manifests use, and it cannot lex a raw block.
if [ -f "$root/bootstrap/seed.ll" ]; then
    echo "avra: no build/avra — bootstrapping from the seed" >&2
    make -C "$root" -s bootstrap >&2 || exit 2
    exec build/avra "$@"
fi
echo "avra: no build/avra and no bootstrap/seed.ll" >&2
echo "      the seed is the only cold path; restore it from git." >&2
exit 2
