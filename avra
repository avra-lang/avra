#!/bin/sh
# The avra command, hosted by bs2 until self-host (ROADMAP: the
# endgame). bs2 keys `bs2 run`'s cache by the ENTRY FILE'S BYTES
# ALONE — so the entry is generated with a content stamp of every
# package source, making the cache key truthful: stale serves are
# impossible, warm hits remain.
root="$(cd "$(dirname "$0")" && pwd)"
# the link flags a manifest writes as ${LLVM_PREFIX}
LLVM_PREFIX="${LLVM_PREFIX:-/opt/homebrew/opt/llvm}"
export LLVM_PREFIX
cd "$root" || exit 2
find packages -name '*.avra-sha256' -delete
stamp=$(find packages -name '*.av' -not -path '*/build/*' -not -name 'main_stamped.av' -print0 | sort -z | xargs -0 cat | shasum -a 256 | cut -c1-16)
gen="packages/cli/src/main_stamped.av"
{ printf '// deps-stamp: %s\n' "$stamp"; cat packages/cli/src/main.av; } > "$gen"
exec "$root/../forge-crafting-intepreters/bootstrap/build/bs2" run "$gen" -- "$@"
