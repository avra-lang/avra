#!/bin/sh
# The avra command, hosted by bs2 until self-host (ROADMAP: the
# endgame). Sidecars clear first — bs2's lib-mode freshness truth
# goes stale against edits (CLAUDE.md, subset notes).
root="$(cd "$(dirname "$0")" && pwd)"
cd "$root" || exit 2
find packages -name '*.avra-sha256' -delete
exec "$root/../forge-crafting-intepreters/bootstrap/build/bs2" run packages/cli/src/main.av -- "$@"
