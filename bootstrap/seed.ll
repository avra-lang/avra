ase written (CLAUDE.md). */\0A#ifndef AVRA_RT_H\0A#define AVRA_RT_H\0A#include <stdint.h>\0A\0A#define AVRA_RT_PTR ((void*)1)\0A#define AVRA_RT_I64 ((int64_t)1)\0A#define AVRA_RT_I32 ((int32_t)1)\0A#define AVRA_RT_U32 ((uint32_t)1)\0A#define AVRA_RT_F64 ((double)1)\0A\0A/* A SEAT CANNOT BE VOID. A row that declares one is a defect, and\0A   it stops at the C compiler with this name unresolved. */\0A#define AVRA_RT_VOID_SEAT AVRA_RT_a_row_declares_a_void_seat\0A\0A/* __builtin_classify_type's pointer_type_class. */\0A#define AVRA_RT_POINTER 5\0A\00" }, align 16
