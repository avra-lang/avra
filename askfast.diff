+/// A seat spelled straight, never through the codec: a text by its length and itself — a
+/// lone text seat as itself, which nothing beside it can run into — a number as itself. None for any other kind, which the codec spells.
+fn plain_spelled(p: Param) -> Code? {
+    if p.kind is .Str { return quote { text_spelled(${name(p.name)}) } }
+    let n? = numbered(p) else { return null }
+    quote { int_spelled(${n}) }
+}
+
+/// Plain seats' spellings as one key: none as empty, one alone, more joined by `/`, which no
+/// number spells and a text's own length puts past.
+fn joined_spelling(parts: List<Code>) -> Code {
+    let first? = parts.first() else { return quote { "" } }
+    parts.drop(1).fold(first, (at: Code, p: Code) -> quote { ${at} + "/" + ${p} })
+}
+
 /// One seat written: a number as its number, any other kind through the codec.
 fn seat_written(p: Param, owner: Owner) -> Code {
     let n? = numbered(p) else { return written(quote { w }, name(p.name), p.kind, owner) }
