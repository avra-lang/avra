use @avra.graph.{model, Ref, Registration, registered}
use @std.validate.{length, email, one_of, items}

/// A person, independent of their employment, family or speaking context.
/// A display name or alias is not a unique identity. "My" is bound to the
/// utterance speaker by the caller's Context, never a permanent alias here.
@model
export type Person = {
    @length(min: 1, max: 256) name: string,
    @items(max: 64) aliases: List<string> = [],
    @email email: string?,
    @length(min: 1, max: 64) phone: string?,
}

/// A company, studio or other organization; names are not unique keys.
@model
export type Organization = {
    @length(min: 1, max: 256) name: string,
    @items(max: 64) aliases: List<string> = [],
}

fn chronological(v: Validity) -> Result<Validity, string> {
    if v.from_ms != null && v.until_ms != null && v.until_ms! <= v.from_ms! {
        fail "a known validity end must be later than its start"
    }
    v
}

/// Embedded valid-time bounds, not source receipt or graph knowledge time.
/// Half-open [from_ms, until_ms) in UTC Unix milliseconds. Null is an
/// unspecified bound, not evidence that a relationship held for all time.
/// For this fixture, a source's date-only inclusive end becomes next-day
/// midnight UTC; original wording and date precision remain in the source.
@model
@chronological
export type Validity = {
    from_ms: int?,
    until_ms: int?,
}

/// A directed family relationship: relative is subject's relation.
/// For "Rowan's wife Elena", subject=Rowan, relation=wife, relative=Elena.
/// For "Elena's mum Ruth", subject=Elena, relation=mother, relative=Ruth.
/// wife/husband/spouse describe a partnership; mum/mom are mother labels.
/// This declaration does not assert an inverse relationship, gender of the
/// subject, employment, or a global meaning for "my wife"/"my mum".
@model
export type PersonalRelationship = {
    subject: Ref<Person>,
    @one_of(["wife", "husband", "spouse", "mother", "father", "parent", "sister", "brother", "sibling"]) relation: string,
    relative: Ref<Person>,
    validity: Validity,
}

/// One person's role at one organization during a validity interval.
/// title retains qualifications such as "interim creative director";
/// a creative-director transition changes this role, not family relations.
/// A title is neither a permanent Person property nor a unique identity.
@model
export type OrganizationRole = {
    person: Ref<Person>,
    organization: Ref<Organization>,
    @length(min: 1, max: 256) title: string,
    validity: Validity,
}

/// Explicit membership in a named group, such as the styling crew.
/// is_member=false is a source-backed denial, not absence of evidence;
/// unknown membership must omit the assertion rather than invent false.
/// A spouse's membership does not follow from the other spouse's job.
@model
export type GroupMembership = {
    person: Ref<Person>,
    @length(min: 1, max: 256) group_name: string,
    is_member: bool,
    validity: Validity,
}

export collect models: List<Registration> = @registered in package as Registration { make: it } by it.name
