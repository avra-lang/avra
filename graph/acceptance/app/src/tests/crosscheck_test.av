use models.people.{models}
use @avra.graph.{Catalog}

spec "x" {
    given "y" {
        then "interpreted fingerprint equals the native app's" {
            match Catalog.collected(models) {
                .Ok(c) -> c.fingerprint == "83ba0827e8baa5e8c568a8eca025151da13afd82c0c5f3c9c417b8c7c16a5e76",
                .Err(_) -> false,
            }
        }
    }
}
