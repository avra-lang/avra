use @avra.graph.{model, derived, Unknown, DerivationRegistration, derivation_registered}
use models.workshop.{Resident}

/// A yes or no a derivation answers about one row.
@model
export type Neighbourhood = { holds: bool }

/// A resident is a neighbour when a side is recorded: where they live or keep their plot.
@derived
export fn is_neighbour(resident: Resident) -> Result<Neighbourhood, Unknown> {
    Neighbourhood { holds: resident.side != null }
}

export collect derivations: List<DerivationRegistration> = @derivation_registered in package as DerivationRegistration { make: it } by it.name
