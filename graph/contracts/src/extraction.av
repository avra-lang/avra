use @std.meta.{derive}
use @std.validate.{Decode, range, length, items, one_of}
use common.{JsonValue, SourceRef, IdentityKey, Candidate, Problem, confidence}
use source.{SourceEnvelope, Frame}
use answer.{Selector}

/// Descriptor is the engine-exported catalog, not an independently kept
/// ontology. Admission must check it against the installed fingerprint.
@derive(Decode)
export type CatalogBinding = {
    @length(min: 1, max: 256) fingerprint: string,
    descriptor: JsonValue,
}

@derive(Decode)
export type ExtractorVersion = {
    @length(min: 1, max: 256) producer: string,
    @length(min: 1, max: 256) code: string,
    @length(min: 1, max: 256) model: string,
}

@derive(Decode)
export type ExtractionRequest = {
    @range(1, 1) contract: int,
    @length(min: 1, max: 512) request: string,
    input: SourceEnvelope,
    catalog: CatalogBinding,
    extractor: ExtractorVersion,
    @length(min: 1, max: 512) scope: string,
    @items(max: 64) candidates: List<Candidate> = [],
}

fn passage_coherent(e: Passage) -> Result<Passage, string> {
    if e.selector.filter(it.kind == "TextPositionSelector").length != 1 { fail "a passage has exactly one position selector" }
    if e.selector.filter(it.kind == "TextQuoteSelector").length > 1 { fail "a passage has at most one quote selector" }
    e
}

/// One passage of the source revision, as W3C Web Annotation selectors that
/// all name the same text: a position (Unicode code points, half-open) and,
/// optionally, the quote it must hold.
@derive(Decode)
@passage_coherent
export type Passage = { @items(min: 1, max: 2) selector: List<Selector> }

fn normalization_coherent(n: Normalization) -> Result<Normalization, string> {
    if n.kind == "TIMEX3" {
        if n.timex_type == null ||
            n.value == null ||
            n.currency != null ||
            n.minor_units != null ||
            n.exponent != null {
            fail "a TIMEX3 normalization carries timex_type and an ISO 8601 value only"
        }
        if !["DATE", "TIME", "DURATION", "SET"].contains(n.timex_type!) { fail "a TIMEX3 type is DATE, TIME, DURATION or SET" }
    } else {
        if n.currency == null ||
            n.minor_units == null ||
            n.exponent == null ||
            n.timex_type != null ||
            n.value != null {
            fail "an ISO 4217 normalization carries currency, minor_units and exponent only"
        }
        let code = n.currency!
        if code.length != 3 ||
            (0..3).any((i: int) -> code.char_code(i) < 65 || code.char_code(i) > 90) { fail "an ISO 4217 currency is three capital letters" }
        if n.exponent! < 0 || n.exponent! > 4 { fail "an ISO 4217 exponent is 0..4" }
    }
    n
}

/// How a value was normalized from its text: TIMEX3 (type plus ISO 8601
/// value) or ISO 4217 money in integer minor units.
@derive(Decode)
@normalization_coherent
export type Normalization = {
    @one_of(["TIMEX3", "ISO4217"]) kind: string,
    timex_type: string? = null,
    @length(min: 1, max: 128) value: string? = null,
    currency: string? = null,
    minor_units: int? = null,
    exponent: int? = null,
}

/// `value` is the normalized, model-shaped value; `evidence` locates the
/// text it was read from, which need not contain it. A plain fact is
/// factuality `CT+` (FactBank) with speech act `assert`.
@derive(Decode)
export type ProposedField = {
    @length(min: 1, max: 256) property: string,
    value: JsonValue,
    @items(min: 1, max: 64) evidence: List<Passage>,
    frame: string? = null,
    @one_of(["CT+", "CT-", "PR+", "PR-", "PS+", "PS-", "Uu"]) factuality: string,
    @one_of(["assert", "report", "plan", "request", "condition", "draft"]) speech_act: string,
    normalization: Normalization? = null,
    @confidence score: float? = null,
}

fn record_coherent(r: ProposedRecord) -> Result<ProposedRecord, string> {
    for i, field in r.fields {
        if r.fields.slice(0, i).any(it.property == field.property) {
            fail "a record proposes each property at most once"
        }
    }
    if r.fields.is_empty() && r.identities.is_empty() { fail "a record needs evidence or an identity" }
    r
}

@derive(Decode)
export type ProposedIdentity = {
    identity: IdentityKey,
    @items(min: 1, max: 64) evidence: List<Passage>,
    frame: string? = null,
}

fn resolution_coherent(r: Resolution) -> Result<Resolution, string> {
    if (r.kind == "candidate") != (r.entity != null) { fail "only a candidate resolution names an entity" }
    r
}

/// The extractor's entity-resolution proposal: one offered candidate, a new
/// entity, or abstention. A proposal, never an identity grant.
@derive(Decode)
@resolution_coherent
export type Resolution = {
    @one_of(["candidate", "new", "abstain"]) kind: string,
    @length(min: 1, max: 512) entity: string? = null,
    @confidence score: float? = null,
}

@derive(Decode)
@record_coherent
export type ProposedRecord = {
    @length(min: 1, max: 128) local_id: string,
    @length(min: 1, max: 256) model: string,
    @items(max: 512) fields: List<ProposedField> = [],
    @items(max: 64) identities: List<ProposedIdentity> = [],
    resolution: Resolution? = null,
}

fn result_coherent(r: ExtractionResult) -> Result<ExtractionResult, string> {
    if r.status == "failed" && (!r.records.is_empty() || r.problems.is_empty()) {
        fail "failed extraction needs problems and cannot publish records"
    }
    if r.status == "complete" && !r.problems.is_empty() {
        fail "complete extraction cannot also report failure"
    }
    for i, record in r.records {
        if r.records.slice(0, i).any(it.local_id == record.local_id) { fail "local record ids must be unique" }
    }
    r
}

/// Complete covers the whole requested scope, not just one successful
/// window. Empty complete is meaningful; an empty failure is not success.
@derive(Decode)
@result_coherent
export type ExtractionResult = {
    @range(2, 2) contract: int,
    @length(min: 1, max: 512) request: string,
    source: SourceRef,
    @length(min: 1, max: 256) schema: string,
    extractor: ExtractorVersion,
    @one_of(["complete", "failed"]) status: string,
    @items(max: 1000) records: List<ProposedRecord> = [],
    @items(max: 256) proposed_frames: List<Frame> = [],
    @items(max: 128) problems: List<Problem> = [],
}
