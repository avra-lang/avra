use @std.meta.{derive}
use @std.validate.{Decode, range, length, items, one_of}
use common.{JsonValue, SourceRef, Candidate, Problem}

fn selector_coherent(s: Selector) -> Result<Selector, string> {
    let texted = s.kind == "TextQuoteSelector"
    if texted {
        if s.exact == null || s.start != null || s.end != null { fail "a quote selector carries exact text and no positions" }
    } else {
        if s.start == null ||
            s.end == null ||
            s.exact != null ||
            s.prefix != null ||
            s.suffix != null {
            fail "a position selector carries start and end only"
        }
        if s.end! <= s.start! { fail "a position selector must cover at least one character" }
    }
    s
}

/// A W3C Web Annotation selector into the cited revision's original content.
/// Positions count Unicode code points, as the Web Annotation model defines
/// them; they are not the byte offsets of an extraction Span. `kind` is
/// the JSON-LD `@type` (the context aliases it).
@derive(Decode)
@selector_coherent
export type Selector = {
    @one_of(["TextQuoteSelector", "TextPositionSelector"]) kind: string,
    @length(min: 1, max: 4096) exact: string? = null,
    @length(max: 256) prefix: string? = null,
    @length(max: 256) suffix: string? = null,
    @range(0, 1048576) start: int? = null,
    @range(1, 1048576) end: int? = null,
}

/// A PROV-O entity: it was derived from one source revision (`source`),
/// generated by a run, and attributed to a quoted speaker. `selectors`
/// locate the cited passage in that revision. The JSON-LD context in
/// ../jsonld/answer.context.jsonld maps these keys to PROV-O and Web
/// Annotation terms.
@derive(Decode)
export type Citation = {
    @length(min: 1, max: 128) id: string,
    source: SourceRef,
    claim: string? = null,
    run: string? = null,
    frame: string? = null,
    speaker: string? = null,
    @items(max: 8) selectors: List<Selector> = [],
}

fn field_coherent(f: AnswerField) -> Result<AnswerField, string> {
    if f.path.any(it.is_empty()) { fail "an answer path cannot contain empty tokens" }
    if f.basis == "policy" {
        if f.policies.is_empty() || !f.citations.is_empty() { fail "a policy field needs policy provenance only" }
    } else {
        if f.citations.is_empty() || !f.policies.is_empty() { fail "a fact needs source provenance" }
    }
    if (f.basis == "derived") != (f.derivation != null) { fail "only a derived field names a derivation" }
    if f.derivation == "" { fail "a derivation needs its declared rule id" }
    f
}

/// record_status describes the bounded evidence view, not global truth.
@derive(Decode)
@field_coherent
export type AnswerField = {
    @items(min: 1, max: 64) path: List<string>,
    value: JsonValue,
    @one_of(["observed", "derived", "record_status", "policy"]) basis: string,
    @items(max: 64) citations: List<string> = [],
    @items(max: 16) policies: List<string> = [],
    derivation: string? = null,
}

/// One supported value among several that compete for the same property.
@derive(Decode)
export type Rival = {
    value: JsonValue,
    @items(min: 1, max: 64) citations: List<string>,
}

/// Competing values of one property of one entity; none is selected.
@derive(Decode)
export type Conflict = {
    @items(min: 1, max: 64) path: List<string>,
    @items(min: 2, max: 16) rivals: List<Rival>,
}

fn answer_coherent(a: Answer) -> Result<Answer, string> {
    if a.status == "answered" &&
        (a.fields.is_empty() || !a.problems.is_empty() || !a.candidates.is_empty()) {
        fail "answered needs fields and cannot report an unresolved problem"
    }
    if a.status != "answered" && a.problems.is_empty() { fail "an unresolved answer needs a problem code" }
    if a.status == "ambiguous" && a.candidates.length < 2 && a.conflicts.is_empty() {
        fail "ambiguity needs two candidate entities or a conflicting property"
    }
    if a.status != "ambiguous" && (!a.conflicts.is_empty() || a.clarify != null) {
        fail "only an ambiguous answer carries conflicts or a clarification"
    }
    for conflict in a.conflicts {
        if conflict.path.any(it.is_empty()) { fail "a conflict path cannot contain empty tokens" }
        for rival in conflict.rivals {
            for citation in rival.citations {
                if !a.citations.any(it.id == citation) { fail "a competing value names an unknown citation" }
            }
        }
    }
    if a.status == "refused" &&
        (!a.fields.is_empty() || !a.candidates.is_empty() || a.policies.is_empty()) {
        fail "a refusal needs policy provenance and cannot disclose fact fields"
    }
    for i, candidate in a.candidates {
        if a.candidates.slice(0, i).any(it.entity == candidate.entity) { fail "candidate entities must be distinct" }
    }
    for i, citation in a.citations {
        if a.citations.slice(0, i).any(it.id == citation.id) { fail "citation ids must be unique" }
    }
    for field in a.fields {
        for citation in field.citations {
            if !a.citations.any(it.id == citation) { fail "answer field names an unknown citation" }
        }
        for policy in field.policies {
            if !a.policies.contains(policy) { fail "answer field names an unknown policy" }
        }
    }
    a
}

@derive(Decode)
@answer_coherent
export type Answer = {
    @range(1, 1) contract: int,
    @length(min: 1, max: 512) request: string,
    @one_of(["answered", "ambiguous", "unknown", "refused"]) status: string,
    @range(0, 9223372036854775807) read_revision: int,
    @items(max: 256) fields: List<AnswerField> = [],
    @items(max: 64) candidates: List<Candidate> = [],
    @items(max: 16) conflicts: List<Conflict> = [],
    @length(min: 1, max: 128) clarify: string? = null,
    @items(max: 256) citations: List<Citation> = [],
    @items(max: 16) policies: List<string> = [],
    @items(max: 128) problems: List<Problem> = [],
}
