use source.{Passage}
use extraction.{
    ExtractionRequest,
    ExtractionResult,
    ProposedField,
    ProposedRecord,
    ProposedIdentity,
    Normalization,
    Resolution,
}

const complete = "{\"contract\":2,\"request\":\"request:1\",\"source\":{\"observation\":\"note:1\",\"revision\":1},\"schema\":\"schema:1\",\"extractor\":{\"producer\":\"encoder\",\"code\":\"code:1\",\"model\":\"model:1\"},\"status\":\"complete\"}"
const proposed = "{\"property\":\"field\",\"value\":null,\"evidence\":[{\"selector\":[{\"kind\":\"TextPositionSelector\",\"start\":0,\"end\":1},{\"kind\":\"TextQuoteSelector\",\"exact\":\"A\"}]}],\"factuality\":\"CT+\",\"speech_act\":\"report\",\"score\":0.8}"
const passage = "{\"selector\":[{\"kind\":\"TextPositionSelector\",\"start\":0,\"end\":1}]}"
const request = "{\"contract\":1,\"request\":\"request:1\",\"input\":{\"contract\":2,\"source\":{\"observation\":\"note:1\",\"revision\":1},\"authored_at_ms\":null,\"received_at_ms\":1,\"author\":null,\"media_type\":\"text/plain\",\"content\":\"A\"},\"catalog\":{\"fingerprint\":\"schema:1\",\"descriptor\":{\"models\":[]}},\"extractor\":{\"producer\":\"encoder\",\"code\":\"code:1\",\"model\":\"model:1\"},\"scope\":\"all\"}"

spec "v2 extraction contracts" {
    given "a provider proposes evidence rather than publishing truth" {
        then "an extraction request carries source and catalog without an SDK" {
            ExtractionRequest.from_json(request) is .Ok
        }
        then "provider-private options cannot leak into the shared envelope" {
            ExtractionRequest
                .from_json(request.replace("\"scope\":\"all\"", "\"scope\":\"all\",\"sdk_options\":{}")) is .Err
        }
        then "a catalog fingerprint alone is not a descriptor" {
            ExtractionRequest.from_json(request.replace(",\"descriptor\":{\"models\":[]}", "")) is .Err
        }
        then "complete empty results are explicit successes" { ExtractionResult.from_json(complete) is .Ok }
        then "failure cannot be confused with empty success" {
            ExtractionResult.from_json(complete.replace("\"complete\"", "\"failed\"")) is .Err
        }
        then "failure carries structured problems" {
            ExtractionResult
                .from_json(
                    complete
                        .replace(
                            "\"complete\"",
                            "\"failed\",\"problems\":[{\"code\":\"extractor.failed\",\"message\":\"worker failed\"}]",
                        ),
                ) is .Ok
        }
        then "success cannot conceal a failure" {
            ExtractionResult
                .from_json(
                    complete
                        .replace(
                            "\"complete\"",
                            "\"complete\",\"problems\":[{\"code\":\"extractor.failed\",\"message\":\"worker failed\"}]",
                        ),
                ) is .Err
        }
        then "explicit null is a literal, not an omitted property" {
            match ProposedField.from_json(proposed) {
                .Ok(field) -> field.value.value is .Null && field.speech_act == "report",
                .Err(_) -> false,
            }
        }
        then "a missing literal is refused" {
            ProposedField.from_json(proposed.replace("\"value\":null,", "")) is .Err
        }
        then "unanchored properties are refused" {
            ProposedField
                .from_json(
                    proposed
                        .replace(
                            "[{\"selector\":[{\"kind\":\"TextPositionSelector\",\"start\":0,\"end\":1},{\"kind\":\"TextQuoteSelector\",\"exact\":\"A\"}]}]",
                            "[]",
                        ),
                ) is .Err
        }
        then "out-of-range confidence is refused" {
            ProposedField.from_json(proposed.replace("0.8", "1.1")) is .Err
        }
        then "factuality and speech act are closed vocabularies" {
            ProposedField.from_json(proposed.replace("\"report\"", "\"true\"")) is .Err &&
                ProposedField.from_json(proposed.replace("\"CT+\"", "\"likely\"")) is .Err
        }
        then "a passage names exactly one position and at most one quote" {
            Passage.from_json(passage) is .Ok &&
                Passage
                    .from_json("{\"selector\":[{\"kind\":\"TextQuoteSelector\",\"exact\":\"A\"}]}") is .Err &&
                Passage
                    .from_json(
                        passage
                            .replace("]}", ",{\"kind\":\"TextPositionSelector\",\"start\":0,\"end\":1}]}"),
                    ) is .Err
        }
        then "a normalization names its standard and only that standard's fields" {
            Normalization
                    .from_json("{\"kind\":\"TIMEX3\",\"timex_type\":\"DATE\",\"value\":\"2026-10-23\"}") is .Ok &&
                Normalization
                    .from_json(
                        "{\"kind\":\"ISO4217\",\"currency\":\"EUR\",\"minor_units\":1250,\"exponent\":2}",
                    ) is .Ok &&
                Normalization
                    .from_json("{\"kind\":\"TIMEX3\",\"timex_type\":\"WEEKDAY\",\"value\":\"x\"}") is .Err &&
                Normalization
                    .from_json("{\"kind\":\"ISO4217\",\"currency\":\"eur\",\"minor_units\":1,\"exponent\":2}") is .Err &&
                Normalization
                    .from_json(
                        "{\"kind\":\"TIMEX3\",\"timex_type\":\"DATE\",\"value\":\"x\",\"currency\":\"EUR\"}",
                    ) is .Err
        }
        then "only a candidate resolution names an entity" {
            Resolution.from_json("{\"kind\":\"candidate\",\"entity\":\"e1\",\"score\":0.7}") is .Ok &&
                Resolution.from_json("{\"kind\":\"new\"}") is .Ok &&
                Resolution.from_json("{\"kind\":\"candidate\"}") is .Err &&
                Resolution.from_json("{\"kind\":\"abstain\",\"entity\":\"e1\"}") is .Err
        }
        then "a version-one result is refused" {
            ExtractionResult.from_json(complete.replace("\"contract\":2", "\"contract\":1")) is .Err
        }
        then "a candidate score cannot select an existing entity" {
            ProposedRecord
                .from_json(
                    "{\"local_id\":\"m1\",\"model\":\"Record\",\"entity\":\"entity:a\",\"fields\":[${proposed}]}",
                ) is .Err
        }
        then "an empty phantom record is refused" {
            ProposedRecord.from_json("{\"local_id\":\"m1\",\"model\":\"Record\"}") is .Err
        }
        then "identity keys require source anchors too" {
            ProposedIdentity
                .from_json("{\"identity\":{\"namespace\":\"source\",\"key\":\"a\"},\"evidence\":[]}") is .Err
        }
        then "an anchored identity-only record is representable" {
            ProposedRecord
                .from_json(
                    "{\"local_id\":\"m1\",\"model\":\"Record\",\"identities\":[{\"identity\":{\"namespace\":\"source\",\"key\":\"a\"},\"evidence\":[${passage}]}]}",
                ) is .Ok
        }
        then "a property cannot be silently overwritten within one record" {
            ProposedRecord
                .from_json("{\"local_id\":\"m1\",\"model\":\"Record\",\"fields\":[${proposed},${proposed}]}") is .Err
        }
    }
}
