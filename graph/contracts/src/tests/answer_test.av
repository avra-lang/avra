use answer.{Answer, AnswerField, Selector, Citation}

const unknown = "{\"contract\":1,\"request\":\"request:1\",\"status\":\"unknown\",\"read_revision\":8,\"problems\":[{\"code\":\"answer.missing_evidence\",\"path\":[\"attendance\"],\"message\":\"No completion evidence in this read view\"}]}"
const refusal = "{\"contract\":1,\"request\":\"request:1\",\"status\":\"refused\",\"read_revision\":8,\"policies\":[\"query.read_only\"],\"problems\":[{\"code\":\"query.read_only\",\"message\":\"This interface does not execute writes\"}]}"
const ambiguous = "{\"contract\":1,\"request\":\"request:1\",\"status\":\"ambiguous\",\"read_revision\":8,\"candidates\":[{\"entity\":\"entity:a\",\"model\":\"Record\",\"label\":\"A\"},{\"entity\":\"entity:b\",\"model\":\"Record\",\"label\":\"B\"}],\"problems\":[{\"code\":\"reference.ambiguous\",\"message\":\"Which record?\"}]}"
const grounded = "{\"contract\":1,\"request\":\"request:1\",\"status\":\"answered\",\"read_revision\":8,\"fields\":[{\"path\":[\"amount\"],\"value\":{\"minor\":27000,\"currency\":\"EUR\"},\"basis\":\"observed\",\"citations\":[\"e1\"]}],\"citations\":[{\"id\":\"e1\",\"source\":{\"observation\":\"note:1\",\"revision\":2}}]}"

const conflicted = "{\"contract\":1,\"request\":\"request:1\",\"status\":\"ambiguous\",\"read_revision\":8,\"conflicts\":[{\"path\":[\"entity:a\",\"phone\"],\"rivals\":[{\"value\":\"1\",\"citations\":[\"e1\"]},{\"value\":\"2\",\"citations\":[\"e2\"]}]}],\"citations\":[{\"id\":\"e1\",\"source\":{\"observation\":\"note:1\",\"revision\":1}},{\"id\":\"e2\",\"source\":{\"observation\":\"note:2\",\"revision\":1}}],\"problems\":[{\"code\":\"value.conflict\",\"message\":\"Two supported phones\"}]}"

spec "v1 structured answer contracts" {
    given "facts, uncertainty and policy refusals have separate representations" {
        then "a bounded-view unknown is not a negative fact" {
            match Answer.from_json(unknown) {
                .Ok(a) -> a.fields.is_empty() && a.problems[0].path[0] == "attendance",
                .Err(_) -> false,
            }
        }
        then "policy can refuse before retrieving any document" {
            match Answer.from_json(refusal) {
                .Ok(a) -> a.citations.is_empty() && a.fields.is_empty(),
                .Err(_) -> false,
            }
        }
        then "a refusal cannot silently omit its policy" {
            Answer
                .from_json(refusal.replace("\"policies\":[\"query.read_only\"]", "\"policies\":[]")) is .Err
        }
        then "two distinct candidates carry ambiguity" { Answer.from_json(ambiguous) is .Ok }
        then "duplicating one candidate is not ambiguity" {
            Answer.from_json(ambiguous.replace("\"entity:b\"", "\"entity:a\"")) is .Err
        }
        then "competing values of one property carry ambiguity without a candidate entity" {
            Answer.from_json(conflicted) is .Ok
        }
        then "a conflict needs two rival values" {
            Answer.from_json(conflicted.replace(",{\"value\":\"2\",\"citations\":[\"e2\"]}", "")) is .Err
        }
        then "a rival cannot invent a citation id" {
            Answer
                .from_json(
                    conflicted
                        .replace("\"citations\":[\"e2\"]}]}],", "\"citations\":[\"nope\"]}]}],"),
                ) is .Err
        }
        then "an answered result cannot hide a conflict" {
            Answer.from_json(conflicted.replace("\"ambiguous\"", "\"answered\"")) is .Err
        }
        then "a clarification belongs to an ambiguous answer only" {
            Answer
                .from_json(ambiguous.replace("\"problems\"", "\"clarify\":\"which_person\",\"problems\"")) is .Ok
        }
        then "an unknown answer cannot carry a clarification" {
            Answer
                .from_json(unknown.replace("\"problems\"", "\"clarify\":\"which_person\",\"problems\"")) is .Err
        }
        then "a citation locates its passage with Web Annotation selectors" {
            Answer
                .from_json(
                    grounded
                        .replace(
                            "\"revision\":2}}]",
                            "\"revision\":2},\"selectors\":[{\"kind\":\"TextQuoteSelector\",\"exact\":\"EUR 270\",\"prefix\":\"top-up \"},{\"kind\":\"TextPositionSelector\",\"start\":10,\"end\":17}]}]",
                        ),
                ) is .Ok
        }
        then "a quote selector cannot carry positions and a position selector cannot carry text" {
            Selector
                    .from_json("{\"kind\":\"TextQuoteSelector\",\"exact\":\"a\",\"start\":0,\"end\":1}") is .Err &&
                Selector
                    .from_json("{\"kind\":\"TextPositionSelector\",\"start\":0,\"end\":1,\"exact\":\"a\"}") is .Err &&
                Selector.from_json("{\"kind\":\"TextQuoteSelector\"}") is .Err
        }
        then "a citation's selectors describe one passage: a position and at most one quote" {
            let both = "{\"kind\":\"TextPositionSelector\",\"start\":0,\"end\":1},{\"kind\":\"TextQuoteSelector\",\"exact\":\"a\"}"
            let cite = "{\"id\":\"c\",\"source\":{\"observation\":\"o\",\"revision\":1},\"selectors\":[SEL]}"
            Citation.from_json(cite.replace("SEL", both)) is .Ok &&
                Citation.from_json(cite.replace("SEL", both + "," + both)) is .Err &&
                Citation
                    .from_json(cite.replace("SEL", "{\"kind\":\"TextQuoteSelector\",\"exact\":\"a\"}")) is .Err
        }
        then "retrieved passages accompany an unresolved answer and cite a known citation" {
            let passage = "\"passages\":[{\"id\":\"p1\",\"text\":\"quoted\",\"citation\":\"e1\",\"rank\":0.5,\"basis\":\"source_passage\"}]"
            let held = unknown
                .replace(
                    "\"problems\"",
                    "\"citations\":[{\"id\":\"e1\",\"source\":{\"observation\":\"note:1\",\"revision\":2}}]," +
                        passage +
                        ",\"problems\"",
                )
            Answer.from_json(held) is .Ok &&
                Answer.from_json(held.replace("\"unknown\"", "\"answered\"")) is .Err &&
                Answer.from_json(held.replace("\"citation\":\"e1\"", "\"citation\":\"nope\"")) is .Err
        }
        then "a position selector covers at least one character and needs both ends" {
            Selector.from_json("{\"kind\":\"TextPositionSelector\",\"start\":3,\"end\":3}") is .Err &&
                Selector.from_json("{\"kind\":\"TextPositionSelector\",\"start\":3}") is .Err &&
                Selector.from_json("{\"kind\":\"RangeSelector\",\"start\":0,\"end\":1}") is .Err
        }
        then "an answered result requires supported fields" {
            Answer.from_json(unknown.replace("\"unknown\"", "\"answered\"")) is .Err
        }
        then "a generic structured monetary literal retains its currency" {
            Answer.from_json(grounded) is .Ok
        }
        then "a fact cannot invent a citation id" {
            Answer
                .from_json(grounded.replace("\"citations\":[\"e1\"]", "\"citations\":[\"missing\"]")) is .Err
        }
        then "derived fields name a declared derivation" {
            Answer.from_json(grounded.replace("\"basis\":\"observed\"", "\"basis\":\"derived\"")) is .Err
        }
        then "an absence in the bounded view may stand without a citation, a fact may not" {
            Answer
                    .from_json(
                        grounded
                            .replace("\"basis\":\"observed\"", "\"basis\":\"record_status\"")
                            .replace("\"citations\":[\"e1\"]", "\"citations\":[]"),
                    ) is .Ok &&
                Answer.from_json(grounded.replace("\"citations\":[\"e1\"]", "\"citations\":[]")) is .Err
        }
        then "observations cannot pretend to be policy" {
            Answer.from_json(grounded.replace("\"basis\":\"observed\"", "\"basis\":\"policy\"")) is .Err
        }
        then "explicitly supported null is still a value" {
            AnswerField
                .from_json(
                    "{\"path\":[\"field\"],\"value\":null,\"basis\":\"observed\",\"citations\":[\"e1\"]}",
                ) is .Ok
        }
        then "missing evidence and missing values are refused" {
            AnswerField.from_json("{\"path\":[\"field\"],\"basis\":\"observed\"}") is .Err
        }
    }
}
