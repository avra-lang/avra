{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://avra.dev/ns/answer#",
    "prov": "http://www.w3.org/ns/prov#",
    "oa": "http://www.w3.org/ns/oa#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "id": "@id",
    "kind": "@type",
    "contract": "https://avra.dev/ns/answer#contract",
    "request": "https://avra.dev/ns/answer#request",
    "status": "https://avra.dev/ns/answer#status",
    "read_revision": {"@id": "https://avra.dev/ns/answer#readRevision", "@type": "xsd:integer"},
    "fields": {"@id": "https://avra.dev/ns/answer#field", "@container": "@set"},
    "candidates": {"@id": "https://avra.dev/ns/answer#candidate", "@container": "@set"},
    "conflicts": {"@id": "https://avra.dev/ns/answer#conflict", "@container": "@set"},
    "rivals": {"@id": "https://avra.dev/ns/answer#rival", "@container": "@set"},
    "citations": {"@id": "prov:wasInfluencedBy", "@container": "@set"},
    "policies": {"@id": "https://avra.dev/ns/answer#policy", "@container": "@set"},
    "problems": {"@id": "https://avra.dev/ns/answer#problem", "@container": "@set"},
    "source": "prov:wasDerivedFrom",
    "observation": "https://avra.dev/ns/source#observation",
    "revision": {"@id": "https://avra.dev/ns/source#revision", "@type": "xsd:integer"},
    "run": "prov:wasGeneratedBy",
    "speaker": "prov:wasAttributedTo",
    "frame": "https://avra.dev/ns/source#frame",
    "claim": "https://avra.dev/ns/answer#claim",
    "selectors": {"@id": "oa:hasSelector", "@container": "@set"},
    "exact": "oa:exact",
    "prefix": "oa:prefix",
    "suffix": "oa:suffix",
    "start": {"@id": "oa:start", "@type": "xsd:nonNegativeInteger"},
    "end": {"@id": "oa:end", "@type": "xsd:nonNegativeInteger"},
    "TextQuoteSelector": "oa:TextQuoteSelector",
    "TextPositionSelector": "oa:TextPositionSelector",
    "path": {"@id": "https://avra.dev/ns/answer#path", "@container": "@list"},
    "value": "https://avra.dev/ns/answer#value",
    "basis": "https://avra.dev/ns/answer#basis",
    "derivation": "https://avra.dev/ns/answer#derivation",
    "entity": "https://avra.dev/ns/answer#entity",
    "model": "https://avra.dev/ns/answer#model",
    "label": "https://avra.dev/ns/answer#label",
    "score": "https://avra.dev/ns/answer#score",
    "code": "https://avra.dev/ns/answer#code",
    "message": "https://avra.dev/ns/answer#message",
    "clarify": "https://avra.dev/ns/answer#clarify"
  }
}
