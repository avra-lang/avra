/// Calibrated parameters: the one file where numeric limits live.

/// Most identity, quantity or absence bindings one model declares.
export const binding_limit = 64

/// Most relation labels, or phrases of one label, a binding declares.
export const label_limit = 128

/// Longest semantic path, in property tokens; also the deepest label hierarchy.
export const path_limit = 16

/// Largest decimal scale of a quantity.
export const decimal_places_limit = 18

/// Longest absence code, in bytes.
export const code_length_limit = 64

/// Most derivations one catalog declares.
export const derivation_limit = 256

/// ASCII codes bounding the characters of an absence code.
export const ascii_a = 97

export const ascii_z = 122

export const ascii_zero = 48

export const ascii_nine = 57

export const ascii_underscore = 95
