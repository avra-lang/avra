/// Calibrated parameters: the one file where word tables live.

/// Function words per language: closed-class words that carry no relation
/// alone, so a bare one cannot trigger a relation reading.
export fn function_words(language: string) -> Result<List<string>, string> {
    match language {
        "en" -> [
            "a",
            "an",
            "the",
            "of",
            "in",
            "on",
            "at",
            "to",
            "for",
            "by",
            "with",
            "from",
            "and",
            "or",
            "is",
            "are",
            "was",
            "were",
            "be",
            "has",
            "have",
            "had",
            "as",
            "it",
            "its",
        ],
        _ -> { fail "no function-word table for language `${language}`: add one to parameters.av" },
    }
}
