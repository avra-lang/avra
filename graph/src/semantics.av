use schema.{Model, Shape}
use parameters.{
    binding_limit,
    label_limit,
    path_limit,
    decimal_places_limit,
    code_length_limit,
    ascii_a,
    ascii_z,
    ascii_zero,
    ascii_nine,
    ascii_underscore,
}
use @std.json.{Json, field}

/// Identity normalization is explicit and domain-independent. It does not
/// infer a namespace from a property name or turn display names into keys.
export enum KeyNormalization { Exact, Trim, AsciiLowerTrim }
/// `scoped_by` scopes a key by other properties of the same record: text, or a
/// reference whose target's own declared keys stand for it. An invoice
/// number within its issuer is one binding, never a producer-spelled key.
export type IdentityBinding = {
    namespace: string,
    path: List<string>,
    normalization: KeyNormalization = .Exact,
    scoped_by: List<List<string>> = [],
}

/// `broader` names labels of the same binding that this one specializes: a
/// query for the broader relation also covers this one.
export type RelationLabel = {
    value: string,
    forward: List<string>,
    reverse: List<string> = [],
    broader: List<string> = [],
}
/// `phrasing` reads one record of the relation as a sentence with the
/// slots `{from}` and `{to}` (each exactly once) and optionally `{label}`.
export type RelationBinding = {
    from: List<string>,
    to: List<string>,
    label: List<string>,
    labels: List<RelationLabel> = [],
    phrasing: string = "",
}

/// These declare representation, not a date parser or temporal inference.
export enum TimeEncoding { UnixMillis, IsoDate, IsoInstant }
export type ValidityBinding = {
    from: List<string>? = null,
    until: List<string>? = null,
    encoding: TimeEncoding = .UnixMillis,
}

export enum UnitBinding { Field(path: List<string>), Constant(name: string) }
export type QuantityBinding = { amount: List<string>, unit: UnitBinding, decimal_places: int = 0 }

/// The model's own reason code for a missing value at `path`: an unknown
/// answer about an absent property carries it. The path must be optional.
export type AbsenceBinding = { path: List<string>, code: string }

/// Optional arguments to @model. All paths are property tokens, never SQL
/// or source code. Paths may cross embedded records, not entity references
/// or lists. A missing optional value is not an unbounded or zero value.
export type Semantics = {
    identities: List<IdentityBinding> = [],
    relation: RelationBinding? = null,
    validity: ValidityBinding? = null,
    quantities: List<QuantityBinding> = [],
    absences: List<AbsenceBinding> = [],
}

impl Semantics {
    fn checked(models: List<Model>, owner: Model) -> Result<bool, string> {
        if self.identities.length > binding_limit ||
            self.quantities.length > binding_limit ||
            self.absences.length > binding_limit { fail "model semantic bindings exceed their budget" }
        for i, identity in self.identities {
            if identity.namespace.is_empty() { fail "an identity binding needs an explicit namespace" }
            if self
                .identities
                .slice(0, i)
                .any(it.namespace == identity.namespace || same_path(it.path, identity.path)) {
                fail "identity namespaces and paths must have unambiguous bindings"
            }
            if !(path_shape(models, owner, identity.path)? is .Text) { fail "an identity key must bind a text property" }
            identity.scoped(models, owner)?
        }
        if self.relation != null { self.relation!.checked(models, owner)? }
        if self.validity != null { self.validity!.checked(models, owner)? }
        for i, quantity in self.quantities {
            if self.quantities.slice(0, i).any(same_path(it.amount, quantity.amount)) { fail "a quantity amount has one unit binding" }
            if quantity.decimal_places < 0 || quantity.decimal_places > decimal_places_limit { fail "quantity decimal places are within the declared limit" }
            let shape = path_shape(models, owner, quantity.amount)?
            if !(shape is .Integer || shape is .Number) { fail "a quantity amount must bind a numeric property" }
            match quantity.unit {
                .Field(path) -> {
                    if !(path_shape(models, owner, path)? is .Text) { fail "a quantity unit must bind a text property" }
                },
                .Constant(name) -> {
                    if name.is_empty() { fail "a constant unit cannot be empty" }
                },
            }
        }
        for i, absence in self.absences {
            if self.absences.slice(0, i).any(same_path(it.path, absence.path)) { fail "a property has one absence code" }
            if !snake_token(absence.code) { fail "an absence code is a lowercase snake_case token: ${absence.code}" }
            path_shape(models, owner, absence.path)?
            if !path_optional(models, owner, absence.path)? { fail "an absence code binds an optional property" }
        }
        true
    }

    fn describe() -> Json {
        Json
            .Obj(
                [
                    field("version", Json.Int(1)),
                    field("identities", Json.Arr([i.describe() for i in self.identities])),
                    field(
                        "relation",
                        if self.relation == null { Json.Null } else { self.relation!.describe() },
                    ),
                    field(
                        "validity",
                        if self.validity == null { Json.Null } else { self.validity!.describe() },
                    ),
                    field("quantities", Json.Arr([q.describe() for q in self.quantities])),
                    field(
                        "absences",
                        Json
                            .Arr(
                                [Json
                                    .Obj(
                                        [
                                            field("path", path_document(a.path)),
                                            field("code", Json.Str(a.code)),
                                        ],
                                    ) for a in self.absences],
                            ),
                    ),
                ],
            )
    }
}

impl RelationBinding {
    /// The phrasing is declared, and names its slots rightly.
    fn phrased() -> Result<bool, string> {
        if self.phrasing.is_empty() { fail "a relation declares its phrasing with {from} and {to} slots" }
        for slot in ["{from}", "{to}"] {
            if (self.phrasing.length - self.phrasing.replace(slot, "").length) / slot.length != 1 {
                fail "a relation phrasing names ${slot} exactly once: ${self.phrasing}"
            }
        }
        let leftover = self
            .phrasing
            .replace("{from}", "")
            .replace("{to}", "")
            .replace("{label}", "")
        if leftover.contains("{") || leftover.contains("}") { fail "a relation phrasing has only {from}, {to} and {label} slots" }
        true
    }

    /// Whether `value` reaches `target` by following broader labels, or is it.
    fn generalizes(value: string, target: string, budget: int) -> bool {
        if value == target { return true }
        if budget == 0 { return false }
        let label? = self.labels.find(it.value == value) else { return false }
        label.broader.any((w) -> self.generalizes(w, target, budget - 1))
    }

    fn checked(models: List<Model>, owner: Model) -> Result<bool, string> {
        if same_path(self.from, self.to) { fail "a relation needs distinct endpoint bindings" }
        self.phrased()?
        if !(path_shape(models, owner, self.from)? is .Reference) ||
            !(path_shape(models, owner, self.to)? is .Reference) {
            fail "relation endpoints must bind typed references"
        }
        if !(path_shape(models, owner, self.label)? is .Text) { fail "a relation label must bind a text property" }
        if self.labels.length > label_limit { fail "relation labels exceed their budget" }
        for i, label in self.labels {
            if label.value.is_empty() || label.forward.is_empty() { fail "a relation label needs a value and forward phrases" }
            if self.labels.slice(0, i).any(it.value == label.value) { fail "relation label values must be unique" }
            for wider in label.broader {
                if !self.labels.any(it.value == wider) { fail "a broader relation label is declared in the same binding: ${wider}" }
                if self.generalizes(wider, label.value, self.labels.length) { fail "relation label hierarchies have no cycles: ${label.value}" }
            }
            let phrases = label.forward.concat(label.reverse)
            if phrases.length > label_limit || phrases.any(it.is_empty()) { fail "relation phrases must be nonempty and bounded" }
            for j, phrase in phrases {
                if phrases.slice(0, j).contains(phrase) { fail "a relation phrase has one direction per label" }
                if self
                    .labels
                    .slice(0, i)
                    .any(it.forward.contains(phrase) || it.reverse.contains(phrase)) {
                    fail "a relation phrase has one declared label binding"
                }
            }
        }
        true
    }

    fn describe() -> Json {
        Json
            .Obj(
                [
                    field("from", path_document(self.from)),
                    field("to", path_document(self.to)),
                    field("label", path_document(self.label)),
                    field("phrasing", Json.Str(self.phrasing)),
                    field(
                        "labels",
                        Json
                            .Arr(
                                [Json
                                    .Obj(
                                        [
                                            field("value", Json.Str(label.value)),
                                            field("forward", path_document(label.forward)),
                                            field("reverse", path_document(label.reverse)),
                                            field("broader", path_document(label.broader)),
                                        ],
                                    ) for label in self.labels],
                            ),
                    ),
                ],
            )
    }
}

impl ValidityBinding {
    fn checked(models: List<Model>, owner: Model) -> Result<bool, string> {
        if self.from == null && self.until == null { fail "a validity binding needs a bound" }
        if self.from != null && self.until != null && same_path(self.from!, self.until!) { fail "validity bounds need distinct paths" }
        for path in [self.from, self.until] {
            if path != null {
                let shape = path_shape(models, owner, path!)?
                let valid = match self.encoding {
                    .UnixMillis -> shape is .Integer,
                    .IsoDate or .IsoInstant -> shape is .Text,
                }
                if !valid { fail "a validity bound has the wrong declared time representation" }
            }
        }
        true
    }

    fn describe() -> Json {
        Json
            .Obj(
                [
                    field(
                        "from",
                        if self.from == null { Json.Null } else { path_document(self.from!) },
                    ),
                    field(
                        "until",
                        if self.until == null { Json.Null } else { path_document(self.until!) },
                    ),
                    field(
                        "encoding",
                        Json
                            .Str(
                                match self.encoding {
                                    .UnixMillis -> "unix_millis",
                                    .IsoDate -> "iso_date",
                                    .IsoInstant -> "iso_instant",
                                },
                            ),
                    ),
                    field("interval", Json.Str("half_open")),
                ],
            )
    }
}

impl IdentityBinding {
    /// Scope paths are distinct text or references to models with keys of
    /// their own, and no chain of scopes returns to the owner.
    fn scoped(models: List<Model>, owner: Model) -> Result<bool, string> {
        if self.scoped_by.length > 4 { fail "an identity has at most four scope paths" }
        for i, scope in self.scoped_by {
            if same_path(scope, self.path) || self.scoped_by.slice(0, i).any(same_path(it, scope)) {
                fail "identity scope paths must be distinct from the key and each other"
            }
            scope_checked(models, owner, scope)?
        }
        true
    }

    fn describe() -> Json {
        let scoped = if self.scoped_by.is_empty() { [] } else { [field("scoped_by", Json.Arr([path_document(p) for p in self.scoped_by]))] }
        Json
            .Obj(
                [
                    field("namespace", Json.Str(self.namespace)),
                    field("path", path_document(self.path)),
                    field(
                        "normalization",
                        Json
                            .Str(
                                match self.normalization {
                                    .Exact -> "exact",
                                    .Trim -> "trim",
                                    .AsciiLowerTrim -> "ascii_lower_trim",
                                },
                            ),
                    ),
                ]
                    .concat(scoped),
            )
    }
}

fn scope_checked(models: List<Model>, owner: Model, scope: List<string>) -> Result<bool, string> {
    match path_shape(models, owner, scope)? {
        .Text -> true,
        .Reference(target) -> {
            let model? = models.find(it.name == target) else { fail "unknown identity scope target: ${target}" }
            if model.semantics.identities.is_empty() { fail "an identity scoped by `${target}` needs `${target}` to declare an identity" }
            if scope_reaches(models, model, owner.name, 0) { fail "identity scopes cannot form a cycle through `${target}`" }
            true
        },
        rest -> { fail "an identity scope must bind text or a reference" },
    }
}

/// Whether `model`'s identity scopes lead, through references, to `owner`.
fn scope_reaches(models: List<Model>, model: Model, owner: string, depth: int) -> bool {
    if model.name == owner { return true }
    if depth > path_limit { return true }
    for identity in model.semantics.identities {
        for scope in identity.scoped_by {
            let target? = scope_target(models, model, scope) else { continue }
            let next? = models.find(it.name == target) else { continue }
            if scope_reaches(models, next, owner, depth + 1) { return true }
        }
    }
    false
}

fn scope_target(models: List<Model>, model: Model, scope: List<string>) -> string? {
    match path_shape(models, model, scope) { .Ok(.Reference(target)) -> target, rest -> null }
}

impl QuantityBinding {
    fn describe() -> Json {
        Json
            .Obj(
                [
                    field("amount", path_document(self.amount)),
                    field(
                        "unit",
                        match self.unit {
                            .Field(path) -> Json.Obj([field("path", path_document(path))]),
                            .Constant(name) -> Json.Obj([field("constant", Json.Str(name))]),
                        },
                    ),
                    field("decimal_places", Json.Int(self.decimal_places)),
                ],
            )
    }
}

fn path_document(path: List<string>) -> Json { Json.Arr([Json.Str(p) for p in path]) }

/// Whether a value can be missing at the end of `path`: any optional step.
fn path_optional(models: List<Model>, owner: Model, path: List<string>) -> Result<bool, string> {
    mut current = owner
    mut optional = false
    for i, token in path {
        let property? = current.properties.find(it.name == token) else { fail "unknown semantic property: ${current.name}.${token}" }
        optional = optional || property.shape is .Optional
        if i == path.length - 1 { return optional }
        let target = match unwrapped(property.shape) {
            .Embedded(name) -> name,
            rest -> { fail "semantic paths may cross only embedded records" },
        }
        let next? = models.find(it.name == target) else { fail "unknown embedded semantic target: ${target}" }
        current = next
    }
    fail "a semantic path must reach a property"
}

fn snake_token(code: string) -> bool {
    let bytes = code.bytes()
    if bytes.length == 0 || bytes.length > code_length_limit { return false }
    let lower = (b: int) -> b >= ascii_a && b <= ascii_z
    let tail = (b: int) -> lower(b) || b >= ascii_zero && b <= ascii_nine || b == ascii_underscore
    lower(bytes.at(0)) && (0..bytes.length).all((i) -> tail(bytes.at(i)))
}

fn unwrapped(shape: Shape) -> Shape {
    match shape { .Optional(inner) -> unwrapped(inner), rest -> shape }
}

fn same_path(a: List<string>, b: List<string>) -> bool {
    if a.length != b.length { return false }
    for i, token in a {
        if token != b[i] { return false }
    }
    true
}

export fn path_shape(models: List<Model>, owner: Model, path: List<string>) -> Result<Shape, string> {
    if path.is_empty() || path.length > path_limit || path.any(it.is_empty()) { fail "semantic paths need nonempty property tokens within the declared limit" }
    mut current = owner
    for i, token in path {
        let property? = current.properties.find(it.name == token) else { fail "unknown semantic property: ${current.name}.${token}" }
        let shape = unwrapped(property.shape)
        if i == path.length - 1 { return shape }
        let target = match shape {
            .Embedded(name) -> name,
            rest -> { fail "semantic paths may cross only embedded records" },
        }
        let next? = models.find(it.name == target) else { fail "unknown embedded semantic target: ${target}" }
        current = next
    }
    fail "a semantic path must reach a property"
}
