use @std.json.{Json, field, parse}
use store.open.{Graph}
use store.publish.{Publication}
use store.query.{Entity, Edge}
use transport.request.{Operation, operation}
use data.{as_json}
use ingest.envelope.{source_document}
use query.cypher.{compiled}
use query.passages.{selectors}
use query.respond.{responded}
use store.search.{Passage}

impl Graph {
    fn dispatch(request: Json) -> Result<Json, string> {
        match operation(request)? {
            .Schema -> {
                let opened = self.read_snapshot()?
                defer { let _ = self.db.finish_if_opened(opened) }
                self.current()?
                Json
                    .Obj(
                        [
                            field("fingerprint", Json.Str(self.catalog.fingerprint)),
                            field("revision", Json.Int(self.revision()?)),
                            field("models", schema_document(self.catalog.document)?),
                        ],
                    )
            },
            .Observe(id, payload) -> Json
                .Obj(
                    [
                        field("input_revision", Json.Int(self.observe(id, payload)?)),
                        field("revision", Json.Int(self.revision()?)),
                    ],
                ),
            .Ingest(payload) -> (self.ingest(payload)?).document(),
            .Source(id, revision) -> source_document(self.source(id, revision)?),
            .Observation(id, revision) -> self.observation(id, revision)?,
            .Publish(p) -> Json.Obj([field("revision", Json.Int(self.publish(p)?))]),
            .Get(id) -> (self.entity(id)?).json(),
            .Value(id) -> as_json(self.value(id)?),
            .Find(model, limit, offset) -> Json.Arr([Json.Str(id) for id in self.find(model, limit, offset)?]),
            .Where(model, property, value, limit, offset) -> Json.Arr([Json.Str(id) for id in self.matching(model, property, value, limit, offset)?]),
            .Edges(id, incoming) -> Json.Arr([edge_json(e) for e in self.edges(id, incoming)?]),
            .Traverse(id, depth, limit) -> Json.Arr([Json.Str(id) for id in self.traverse(id, depth, limit)?]),
            .Explain(id, property) -> self.explain(id, property)?,
            .Resolve(namespace, key) -> Json.Obj([field("entity", Json.Str(self.resolve(namespace, key)?))]),
            .Aliases(id) -> Json.Arr([i.json() for i in self.aliases(id)?]),
            .Merge(decision) -> Json.Obj([field("revision", Json.Int(self.merge(decision)?))]),
            .Split(decision) -> Json.Obj([field("revision", Json.Int(self.split(decision)?))]),
            .Merges(entity) -> Json.Arr([m.json() for m in self.merges(entity)?]),
            .Tombstone(decision) -> Json.Obj([field("revision", Json.Int(self.tombstone(decision)?))]),
            .Revive(decision) -> Json.Obj([field("revision", Json.Int(self.revive(decision)?))]),
            .Tombstones(entity) -> Json.Arr([t.json() for t in self.tombstones(entity)?]),
            .Choose(decision) -> Json.Obj([field("revision", Json.Int(self.choose(decision)?))]),
            .Unchoose(decision) -> Json.Obj([field("revision", Json.Int(self.unchoose(decision)?))]),
            .Choices(claim) -> Json.Arr([c.json() for c in self.choices(claim)?]),
            .Dirty -> self.dirty()?,
            .Query(plan) -> self.query(plan)?,
            .Cypher(text, params) -> self.cypher(text, params)?,
            .Check(text, params) -> self.check_cypher(text, params),
            .Search(query, limit) -> self.passages(query, limit)?,
            .Admit(a) -> (self.admit(a)?).json(),
        }
    }
}

export fn failure(message: string) -> Json { Json.Obj([field("error", Json.Str(message))]) }

fn schema_document(text: string) -> Result<Json, string> {
    match parse(text) { .Ok(j) -> j, .Err(_) -> { fail "catalog document is not JSON" } }
}

fn edge_json(e: Edge) -> Json {
    Json
        .Obj(
            [
                field("entity", Json.Str(e.entity)),
                field("property", Json.Str(e.property)),
                field("target", Json.Str(e.target)),
                field("path", Json.Str(e.path)),
            ],
        )
}
