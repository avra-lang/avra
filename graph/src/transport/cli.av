use @std.cli.{cli, command, option, arg, Runnable, CliResult, argv}
use @std.io.{read_text}
use @std.json.{parse, to_text}
use @std.text.{parse_int}
use policy.{DerivationRegistration}
use schema.{Registration}
use store.open.{Graph}
use store.policy.{EnginePolicy}
use transport.dispatch.{failure}
use transport.server.{serve}
use mcp.tools.{Door, tools}
use @std.mcp.{serve_stdio}

type Command = { models: List<Registration>, derived: List<DerivationRegistration>, policy: EnginePolicy }

impl Runnable for Command {
    fn run(args: CliResult) -> int {
        match self.execute(args) {
            .Ok(_) -> 0,
            .Err(e) -> {
                println(to_text(failure(e)))
                1
            },
        }
    }
}

impl Command {
    fn execute(args: CliResult) -> Result<int, string> {
        if args.command == "mcp" {
            let door = Door {
                db: args.option("db"),
                models: self.models,
                policy: self.policy,
                planner: words(args.option("planner")),
                extractor: words(args.option("extractor")),
                graph: [argv()[0], "request", "--db", args.option("db")],
            }
            serve_stdio(tools(door)?)
            return 0
        }
        if args.command == "serve" {
            let token = (file_text(args.option("token-file"))?).trim()
            let port? = parse_int(args.option("port")) else { fail "port must be an integer" }
            return serve(args.option("db"), self.models, port, token, self.policy, self.derived)
        }
        let request = match parse(file_text(args.arg("file"))?) {
            .Ok(j) -> j,
            .Err(_) -> { fail "request file must contain JSON" },
        }
        mut graph = Graph.open(args.option("db"), self.models, self.derived, self.policy)?
        defer { let _ = graph.close() }
        println(to_text(graph.dispatch(request)?))
        0
    }
}

/// A host's entire executable layer is `run(models)`, with the policy it
/// declares (its producers' authority, say) and the derivations it offers.
export fn run(
    models: List<Registration>,
    policy: EnginePolicy = EnginePolicy {},
    derived: List<DerivationRegistration> = [],
) -> int {
    let handler = Command { models: models, derived: derived, policy: policy }
    let request = command {
        name: "request"
        description: "Execute one generic JSON graph request"
        option db { default: "graph.db" }
        arg file { required: true }
        run: handler
    }
    let server = command {
        name: "serve"
        description: "Serve authenticated POST /graph on loopback"
        option db { default: "graph.db" }
        option port { default: "7331" }
        option {
            name: "token-file"
            description: "File containing a bearer token of at least 24 bytes"
        }
        run: handler
    }
    let door = command {
        name: "mcp"
        description: "Serve the graph's tools to an agent over MCP on stdin and stdout"
        option db { default: "graph.db" }
        option planner {
            default: ""
            description: "The command that plans a question (offered as `ask` when set)"
        }
        option extractor {
            default: ""
            description: "The command that reads a source (offered as `ingest` when set); {schema} names the catalog file"
        }
        run: handler
    }
    let app = cli {
        name: "graph"
        version: "0.1.0"
        description: "Model-driven personal evidence graph"
        request
        server
        door
    }
    app.run()
}

/// A command line's words: split at spaces, no quoting.
fn words(line: string) -> List<string> { [w for w in line.split(" ") if !w.is_empty()] }

fn file_text(path: string) -> Result<string, string> {
    match read_text(path) {
        .Ok(text) -> text,
        .Err(e) -> { fail "read ${path}: ${e.describe().message}" },
    }
}
