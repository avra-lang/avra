use @std.cli.{cli, command, option, arg, Runnable, CliResult}
use @std.io.{read_text}
use @std.json.{parse, to_text}
use @std.text.{parse_int}
use policy.{DerivationRegistration}
use schema.{Registration}
use store.open.{Graph}
use store.policy.{EnginePolicy}
use transport.dispatch.{failure}
use transport.server.{serve}
use mcp.tools.{Door, tools}
use @std.mcp.{serve_stdio, server, server_faults}
use @std.action.{Mandate}
use @std.time.{wall_secs}

/// The program's own invocation path: the planner reaches this graph through it.
extern fn avra_selfhost_get_arg_cstr(i: int) -> string

type Command = { models: List<Registration>, derived: List<DerivationRegistration>, policy: EnginePolicy }

impl Runnable for Command {
    fn run(args: CliResult) -> int {
        match self.execute(args) {
            .Ok(_) -> 0,
            .Err(e) -> {
                println(to_text(failure(e)))
                1
            },
        }
    }
}

impl Command {
    fn execute(args: CliResult) -> Result<int, string> {
        if args.command == "mcp" {
            let door = Door {
                db: args.option("db"),
                models: self.models,
                policy: self.policy,
                planner: words(args.option("planner")),
                extractor: words(args.option("extractor")),
                graph: [avra_selfhost_get_arg_cstr(0), "request", "--db", args.option("db")],
            }
            let offered = tools(door)?
            let granted = granted(args)?
            let faults = server_faults(server(offered, granted))
            if !faults.is_empty() { fail faults.join("; ") }
            serve_stdio(offered, granted)
            return 0
        }
        if args.command == "serve" {
            let token = (file_text(args.option("token-file"))?).trim()
            let port? = parse_int(args.option("port")) else { fail "port must be an integer" }
            return serve(args.option("db"), self.models, port, token, self.policy, self.derived)
        }
        let request = match parse(file_text(args.arg("file"))?) {
            .Ok(j) -> j,
            .Err(_) -> { fail "request file must contain JSON" },
        }
        mut graph = Graph.open(args.option("db"), self.models, self.derived, self.policy)?
        defer { let _ = graph.close() }
        println(to_text(graph.dispatch(request)?))
        0
    }
}

/// A host's entire executable layer is `run(models)`, with the policy it
/// declares (its producers' authority, say) and the derivations it offers.
export fn run(
    models: List<Registration>,
    policy: EnginePolicy = EnginePolicy {},
    derived: List<DerivationRegistration> = [],
) -> int {
    let handler = Command { models: models, derived: derived, policy: policy }
    let request = command {
        name: "request"
        description: "Execute one generic JSON graph request"
        option db { default: "graph.db" }
        arg file { required: true }
        run: handler
    }
    let server = command {
        name: "serve"
        description: "Serve authenticated POST /graph on loopback"
        option db { default: "graph.db" }
        option port { default: "7331" }
        option {
            name: "token-file"
            description: "File containing a bearer token of at least 24 bytes"
        }
        run: handler
    }
    let door = command {
        name: "mcp"
        description: "Serve the graph's tools to an agent over MCP on stdin and stdout"
        option db { default: "graph.db" }
        option planner {
            default: ""
            description: "The command that plans a question (offered as `ask` when set)"
        }
        option extractor {
            default: ""
            description: "The command that reads a source (offered as `ingest` when set); {schema} names the catalog file"
        }
        option grant {
            default: ""
            description: "Tools the agent may run unattended, comma-separated (e.g. ingest,correct); each write records the grant"
        }
        option grantor {
            default: ""
            description: "Who grants them: recorded with every write made under the grant"
        }
        option agent {
            default: ""
            description: "Who the grant is for: recorded with every write made under the grant"
        }
        option budget {
            default: ""
            description: "How many writes the grant covers; unbounded when unset"
        }
        option minutes {
            default: ""
            description: "How long the grant lasts from launch; until the door closes when unset"
        }
        run: handler
    }
    let app = cli {
        name: "graph"
        version: "0.1.0"
        description: "Model-driven personal evidence graph"
        request
        server
        door
    }
    app.run()
}

/// A command line's words: split at spaces, no quoting.
/// The mandate a host grants at launch, or none when it grants nothing.
fn granted(args: CliResult) -> Result<List<Mandate>, string> {
    let actions = [w.trim() for w in args.option("grant").split(",") if !w.trim().is_empty()]
    if actions.is_empty() { return [] }
    let grantor = args.option("grantor")
    let agent = args.option("agent")
    if grantor.is_empty() || agent.is_empty() { fail "a grant names its grantor and its agent: --grantor and --agent" }
    let now = wall_secs() * 1000
    let minutes = bounded(args.option("minutes"), "minutes")?
    [
        Mandate {
            id: "${grantor}:${agent}:${now}",
            issuer: grantor,
            subject: agent,
            actions: actions,
            granted_ms: now,
            expires_ms: if minutes == null { null } else { now + minutes! * 60000 },
            budget: bounded(args.option("budget"), "budget")?,
        },
    ]
}

/// An optional whole-number option: absent when unset.
fn bounded(text: string, name: string) -> Result<int?, string> {
    if text.is_empty() { return .Ok(null) }
    let n? = parse_int(text) else { fail "--${name} must be a whole number" }
    .Ok(n)
}

fn words(line: string) -> List<string> { [w for w in line.split(" ") if !w.is_empty()] }

fn file_text(path: string) -> Result<string, string> {
    match read_text(path) {
        .Ok(text) -> text,
        .Err(e) -> { fail "read ${path}: ${e.describe().message}" },
    }
}
