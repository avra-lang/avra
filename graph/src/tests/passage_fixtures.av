use @avra.graph_contracts.{Frame, Passage, Selector}

/// Code points [start, end) holding `exact`, as Web Annotation selectors.
fn passage_at(start: int, end: int, exact: string) -> Passage {
    Passage {
        selector: [
            Selector { kind: "TextPositionSelector", start: start, end: end },
            Selector { kind: "TextQuoteSelector", exact: exact },
        ],
    }
}

/// A quotation frame over code points [start, end) holding `exact`.
fn quote_frame(
    id: string,
    start: int,
    end: int,
    exact: string,
    speaker: string? = null,
    parent: string? = null,
) -> Frame {
    Frame { id: id, passage: passage_at(start, end, exact), speaker: speaker, parent: parent }
}
