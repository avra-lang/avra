use derive.model.{model}
use schema.{Registration}
use semantics.{Semantics, AbsenceBinding}
use store.open.{Graph}
use store.publish.{Record, Publication}
use store.query.{stored_value}
use @std.json.{Json, field, parse}

@model(quote { Semantics { absences: [AbsenceBinding { path: ["confirmed_at"], code: "no_confirmation" }] } })
type Booking = { venue: string, confirmed_at: string?, note: string? }

fn registrations() -> List<Registration> { [Registration { make: Booking_graph_model }] }

fn bookings() -> Result<Graph, string> {
    mut g = Graph.memory(registrations())?
    g.observe("in:1", "raw")?
    g
        .publish(
            Publication {
                id: "one",
                producer: "agent",
                scope: "in:1",
                input: "in:1",
                input_revision: 1,
                schema: g.catalog.fingerprint,
                expected_revision: g.revision()?,
                records: [
                    Record {
                        id: "b1",
                        model: "Booking",
                        value: stored_value("{\"venue\":\"Alder\",\"confirmed_at\":null,\"note\":null}")?,
                    },
                ],
            },
        )?
    g
}

fn code_for(mut g: Graph, returns: string) -> Result<string, string> {
    let params = match parse("{\"asker\":\"u\",\"now\":1}") {
        .Ok(j) -> j,
        .Err(_) -> { fail "params are not JSON" },
    }
    let answer = g
        .dispatch(
            Json
                .Obj(
                    [
                        field("op", Json.Str("query")),
                        field("cypher", Json.Str("MATCH (b:Booking) RETURN ${returns}")),
                        field("params", params),
                    ],
                ),
        )?
    if answer.member("status").text() != "unknown" { return "-" }
    answer.member("problems").item(0).member("code").text() ?? "-"
}

fn declared_code_names_the_absence() -> Result<bool, string> {
    mut g = bookings()?
    defer { let _ = g.close() }
    let declared = code_for(g, "b.confirmed_at AS confirmed")?
    let generic = code_for(g, "b.note AS note")?
    declared == "no_confirmation" && generic == "null_result"
}

fn passed(answer: Result<bool, string>) -> bool {
    answer catch e -> {
        println(e)
        false
    }
}

spec "absence codes" {
    given "a model that declares why a value may be missing" {
        then "an unknown answer carries the model's own code, else the generic one" { passed(declared_code_names_the_absence()) }
    }
}
