use tests.support.{sample_models as models, Person}
use store.open.{Graph, stored}
use store.publish.{Record, Publication}
use store.query.{stored_value}
use store.engine.{EntityRow, ClaimRow, SupportRow}
use store.policy.{EnginePolicy, Migration}
use @std.io.{remove}
use @std.time.{stamp}

fn temp_base(name: string) -> string { "/tmp/avra-graph-${name}-${stamp()}.db" }

fn recorded() -> Result<Record, string> {
    Record { id: "p1", model: "Person", value: Person { name: "Ada", email: null }.graph_value() }
}

fn published(g: Graph) -> Result<Publication, string> {
    Publication {
        id: "one",
        producer: "agent",
        scope: "in:1",
        input: "in:1",
        input_revision: 1,
        schema: g.catalog.fingerprint,
        expected_revision: g.revision()?,
        records: [recorded()?],
    }
}

/// Removing models is an incompatible catalog change: refused without a
/// declared migration, leaving the store as it was; with one, unchanged
/// models keep reading and nothing is quarantined.
fn schema_move_needs_migration() -> Result<bool, string> {
    let path = temp_base("schema")
    let _ = remove(path)
    let _ = remove(path + "-wal")
    let _ = remove(path + "-shm")
    mut g = Graph.open(path, models)?
    g.observe("in:1", "raw")?
    g.publish(published(g)?)?
    let old = g.catalog.fingerprint
    let _ = g.close()

    let person? = models.find(it.make().name == "Person") else { fail "the fixture has no Person" }
    let refused = match Graph.open(path, [person]) {
        .Ok(_) -> false,
        .Err(e) -> e.contains("needs a declared migration") && e.contains("Message model_removed"),
    }
    let migrations = [Migration.RemoveModel("Message"), Migration.RemoveModel("WorkItem")]
    let g2 = Graph.open(path, [person], policy: EnginePolicy { migrations: migrations })?
    defer {
        let _ = g2.close()
        let _ = remove(path)
        let _ = remove(path + "-wal")
        let _ = remove(path + "-shm")
    }
    let found = stored(EntityRow.where(g2.db, name: "p1"))?
    let entity? = found.first() else { fail "the entity row vanished" }
    let claims = [claim for claims in stored(EntityRow.with_claims(g2.db, [entity]))? for claim in claims]
    let kept = claims.all(it.schema == old) && g2.catalog.fingerprint != old
    let fields = (g2.entity("p1")?).fields
    let history = g2.explain("p1", "name")?
    refused &&
        kept &&
        fields.any(it.property == "name") &&
        g2.value("p1") is .Ok &&
        history.item(0).member("active").truth() == true &&
        (g2.dirty()?).items().is_empty()
}

fn passed(answer: Result<bool, string>) -> bool {
    answer catch e -> {
        println(e)
        false
    }
}

spec "graph catalog changes" {
    given "a model catalog moves under a committed claim" {
        then "a removed model is refused without a migration and, with one, unchanged models keep reading" {
            passed(schema_move_needs_migration())
        }
    }
}
