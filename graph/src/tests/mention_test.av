use models.{models}
use store.open.{Graph}
use store.publish.{Record, Publication, Mention}
use store.query.{stored_value}
use @std.json.{Json}

fn mentioned(id: string, model: string, value: string, mentions: List<Mention>) -> Result<Record, string> {
    Record { id: id, model: model, value: stored_value(value)?, mentions: mentions }
}

fn publication(g: Graph, id: string, producer: string, scope: string, records: List<Record>) -> Result<
    Publication,
    string,
> {
    Publication {
        id: id,
        producer: producer,
        scope: scope,
        input: "input:1",
        input_revision: 1,
        schema: g.catalog.fingerprint,
        expected_revision: g.revision()?,
        records: records,
    }
}

fn span(start: int, length: int, surface: string) -> Mention {
    Mention { start: start, end: start + length, surface: surface }
}

fn title_mentions(g: Graph) -> Result<Json, string> {
    (g.explain("w1", "title")?).item(0).member("mentions")
}

fn mentions_of(rows: List<Json>, producer: string) -> Json {
    match rows.find(it.member("producer").text() == producer) {
        found? -> found.member("mentions")
        null -> Json.Null
    }
}

/// Two mentions of one entity arrive on one record, and every claim from
/// that record carries both.
fn many_mentions_on_one_record() -> Result<bool, string> {
    mut g = Graph.memory(models)?
    defer { let _ = g.close() }
    g.observe("input:1", "Ada: review the design with Grace.")?
    g
        .publish(
            publication(
                g,
                "one",
                "agent",
                "input:1",
                [
                    mentioned(
                        "w1",
                        "WorkItem",
                        "{\"title\":\"Review the design\",\"status\":\"open\"}",
                        [span(5, 17, "review the design"), span(31, 5, "Grace")],
                    )?,
                ],
            )?,
        )?
    let status = (g.explain("w1", "status")?).item(0).member("mentions")
    (title_mentions(g)?).items().length == 2 && status.items().length == 2
}

fn spans_returned_through_explain() -> Result<bool, string> {
    mut g = Graph.memory(models)?
    defer { let _ = g.close() }
    g.observe("input:1", "Ada: review the design with Grace.")?
    g
        .publish(
            publication(
                g,
                "one",
                "agent",
                "input:1",
                [
                    mentioned(
                        "w1",
                        "WorkItem",
                        "{\"title\":\"Review the design\"}",
                        [span(5, 17, "review the design"), span(31, 5, "Grace")],
                    )?,
                ],
            )?,
        )?
    let first = (title_mentions(g)?).item(0)
    let second = (title_mentions(g)?).item(1)
    first.member("start").int() == 5 &&
        first.member("end").int() == 22 &&
        first.member("surface").text() == "review the design" &&
        second.member("start").int() == 31 &&
        second.member("end").int() == 36 &&
        second.member("surface").text() == "Grace"
}

/// An identical publication replays; a different set of mentions reuses a run id.
fn mentions_are_replay_identity() -> Result<bool, string> {
    mut g = Graph.memory(models)?
    defer { let _ = g.close() }
    g.observe("input:1", "Ada: review the design with Grace.")?
    let record = mentioned(
        "w1",
        "WorkItem",
        "{\"title\":\"Review the design\"}",
        [span(5, 17, "review the design")],
    )?
    let p = publication(g, "one", "agent", "input:1", [record])?
    let revision = g.publish(p)?
    let replay = g.publish(p)? == revision
    let changed = match g
        .publish(p with { records: [record with { mentions: [span(31, 5, "Grace")] }] }) {
        .Ok(_) -> false,
        .Err(_) -> true,
    }
    replay && changed && g.revision()? == revision
}

fn refusals(mut g: Graph, malformed: List<List<Mention>>) -> Result<int, string> {
    mut refused = 0
    for i, mentions in malformed {
        let record = mentioned("bad${i}", "WorkItem", "{\"title\":\"Review\"}", mentions)?
        let p = publication(g, "bad${i}", "agent", "input:${i}", [record])?
        let rejected = match g.publish(p) { .Ok(_) -> false, .Err(_) -> true }
        if rejected { refused = refused + 1 }
    }
    refused
}

/// A malformed span or empty surface refuses its whole publication, so
/// the revision stands and no entity is born.
fn invalid_ranges_refused_atomically() -> Result<bool, string> {
    mut g = Graph.memory(models)?
    defer { let _ = g.close() }
    g.observe("input:1", "Ada: review the design.")?
    let settled = g.revision()?
    let refused = refusals(
        g,
        [
            [span(-1, 3, "Ada")],
            [Mention { start: 9, end: 4, surface: "Ada" }],
            [Mention { start: 0, end: 3, surface: "" }],
        ],
    )?
    let absent = match g.entity("bad0") { .Ok(_) -> false, .Err(_) -> true }
    refused == 3 && absent && g.revision()? == settled
}

/// Two producers supporting one value keep the mentions each of them observed.
fn mentions_stay_per_support() -> Result<bool, string> {
    mut g = Graph.memory(models)?
    defer { let _ = g.close() }
    g.observe("input:1", "Ada: review the design.")?
    g
        .publish(
            publication(
                g,
                "one",
                "reader-a",
                "input:1",
                [
                    mentioned(
                        "w1",
                        "WorkItem",
                        "{\"title\":\"Review the design\"}",
                        [span(5, 17, "review the design")],
                    )?,
                ],
            )?,
        )?
    g
        .publish(
            publication(
                g,
                "two",
                "reader-b",
                "input:1",
                [
                    mentioned(
                        "w1",
                        "WorkItem",
                        "{\"title\":\"Review the design\"}",
                        [span(0, 3, "Ada"), span(5, 17, "review the design")],
                    )?,
                ],
            )?,
        )?
    let rows = (g.explain("w1", "title")?).items()
    rows.length == 2 &&
        mentions_of(rows, "reader-a").items().length == 1 &&
        mentions_of(rows, "reader-b").items().length == 2
}

fn passed(answer: Result<bool, string>) -> bool {
    answer catch e -> {
        println(e)
        false
    }
}

spec "graph mention evidence" {
    given "a record names the source spans it observed its entity at" {
        then "several mentions of one entity travel on one record" { passed(many_mentions_on_one_record()) }
        then "each span returns through explain" { passed(spans_returned_through_explain()) }
        then "mentions are part of the replay identity" { passed(mentions_are_replay_identity()) }
        then "an invalid span or empty surface refuses the whole publication" {
            passed(invalid_ranges_refused_atomically())
        }
        then "two producers keep their own mentions of one supported value" {
            passed(mentions_stay_per_support())
        }
    }
}
