use derive.model.{model}
use schema.{Ref, Model, Registration, registered}
use @std.validate.{length, email, one_of}

/// A person known through one or more observations.
@model
export type Person = {
    @length(min: 1) name: string,
    @email email: string?,
}

/// A message with independently identified participants.
@model
export type Message = {
    author: Ref<Person>,
    recipients: List<Ref<Person>>,
    @length(min: 1) body: string,
    sent_at: string?,
}

/// Work extracted from observations or entered directly.
@model
export type WorkItem = {
    @length(min: 1) title: string,
    @one_of(["open", "active", "done"]) status: string = "open",
    assignee: Ref<Person>?,
    messages: List<Ref<Message>> = [],
    due_at: string?,
}

export collect models: List<Registration> = @registered in package as Registration { make: it } by it.name
