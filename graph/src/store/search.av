use @std.sqlite.{sql, SqlValue, Row}
use @std.text.{from_codepoints}
use ingest.chunks.{windows}
use @avra.graph_contracts.{SourceEnvelope}
use @std.validate.{Value}
use store.engine.{ObservationRow}
use store.open.{Graph, stored, put_meta}
use data.{encoded}

/// One indexed passage: source text, or a fact admitted from a source.
export type Passage = {
    row: int,
    kind: string,
    observation: string,
    revision: int,
    start: int,
    stop: int,
    text: string,
    claim: int,
    run: string,
    entity: string,
    rank: float,
}

/// The index tracks the graph revision it was built at.
const index_revision_key = "search_revision"

const index_table = "passage_index"

/// What a result row reads, in order.
const columns = "rowid, kind, observation, revision, start, stop, text, claim, run, entity"

impl Graph {
    /// Passages ranked by BM25 over source text and admitted facts, best first.
    /// The index is rebuilt when the graph has moved since it was built.
    fn search(query: string, limit: int = 10) -> Result<List<Passage>, string> {
        if limit < 1 || limit > 100 { fail "search limit must be 1..100" }
        self.indexed()?
        let match_text = fts_query(query)
        if match_text.is_empty() { return [] }
        let rows = stored(
            self
                .db
                .all(
                    sql(
                        "SELECT ${columns}, bm25(${index_table}) FROM ${index_table} WHERE ${index_table} MATCH ? ORDER BY bm25(${index_table}), observation, start LIMIT ?",
                        [.Text(match_text), .Int(limit)],
                    ),
                ),
        )?
        [passage_of(r, stored(r.real(10))?)? for r in rows]
    }

    /// Indexed rows by predicate over the unindexed columns, in index order.
    fn passages_where(condition: string, values: List<SqlValue>) -> Result<List<Passage>, string> {
        self.indexed()?
        let rows = stored(
            self
                .db
                .all(
                    sql(
                        "SELECT ${columns} FROM ${index_table} WHERE ${condition} ORDER BY rowid",
                        values,
                    ),
                ),
        )?
        [passage_of(r, 0.0)? for r in rows]
    }

    /// Indexed documents containing the phrase, or all of them for none.
    fn index_documents(phrase: string?) -> Result<int, string> {
        self.indexed()?
        let match_text = if phrase == null { "" } else { fts_phrase(phrase!) }
        let rows = stored(
            if match_text.is_empty() {
                self.db.all(sql("SELECT count(*) FROM ${index_table}", []))
            } else {
                self
                    .db
                    .all(
                        sql(
                            "SELECT count(*) FROM ${index_table} WHERE ${index_table} MATCH ?",
                            [.Text(match_text)],
                        ),
                    )
            },
        )?
        stored(rows[0].int(0))?
    }

    /// Brings the index up to the graph's revision; a no-op when it is current.
    fn indexed() -> Result<int, string> {
        let revision = self.revision()?
        if self.has_table(index_table)? && self.meta(index_revision_key)? == "${revision}" { return revision }
        stored(self.db.begin())?
        defer { let _ = self.db.finish() }
        mut db = self.db
        stored(
            db
                .exec(
                    "CREATE VIRTUAL TABLE IF NOT EXISTS ${index_table} USING fts5(text, kind UNINDEXED, observation UNINDEXED, revision UNINDEXED, start UNINDEXED, stop UNINDEXED, claim UNINDEXED, run UNINDEXED, entity UNINDEXED, tokenize = 'porter unicode61 remove_diacritics 2')",
                ),
        )?
        stored(db.run(sql("DELETE FROM ${index_table}")))?
        for p in (self.source_passages()?).concat(self.fact_passages()?) {
            stored(
                db
                    .run(
                        sql(
                            "INSERT INTO ${index_table}(text, kind, observation, revision, start, stop, claim, run, entity) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)",
                            [
                                .Text(p.text),
                                .Text(p.kind),
                                .Text(p.observation),
                                .Int(p.revision),
                                .Int(p.start),
                                .Int(p.stop),
                                .Int(p.claim),
                                .Text(p.run),
                                .Text(p.entity),
                            ],
                        ),
                    ),
            )?
        }
        put_meta(db, index_revision_key, "${revision}")?
        stored(db.commit())?
        revision
    }

    /// Each observation's current text: envelope windows, or the raw text whole.
    fn source_passages() -> Result<List<Passage>, string> {
        let rows = stored(ObservationRow.all(self.db))?
        let nested = [self.windowed(r)? for r in rows]
        [p for run in nested for p in run]
    }

    fn windowed(r: ObservationRow) -> Result<List<Passage>, string> {
        match SourceEnvelope.from_json(r.payload) {
            .Ok(envelope) -> [Passage {
                row: 0,
                kind: "source",
                observation: r.name,
                revision: r.revision,
                start: w.original.start,
                stop: w.original.end,
                text: w.original.text,
                claim: 0,
                run: "",
                entity: "",
                rank: 0.0,
            } for w in windows(envelope)?],
            .Err(_) -> [
                Passage {
                    row: 0,
                    kind: "source",
                    observation: r.name,
                    revision: r.revision,
                    start: 0,
                    stop: r.payload.bytes().length,
                    text: r.payload,
                    claim: 0,
                    run: "",
                    entity: "",
                    rank: 0.0,
                },
            ],
        }
    }

    /// Every standing value, spelled `Model property: value`, filed under each source that supports it.
    fn fact_passages() -> Result<List<Passage>, string> {
        let nested = [self.facts_of(m.name, id)? for m in self.catalog.models for id in self.find(m.name, limit: 1000)?]
        [p for run in nested for p in run]
    }

    fn facts_of(model: string, id: string) -> Result<List<Passage>, string> {
        let entity = self.entity(id)?
        [Passage {
            row: 0,
            kind: "fact",
            observation: s.member("input").text() ?? "",
            revision: s.member("input_revision").int() ?? 0,
            start: 0,
            stop: 0,
            text: "${model} ${sel.property}: ${spelled(c.value)}",
            claim: c.claim,
            run: s.member("run").text() ?? "",
            entity: id,
            rank: 0.0,
        } for sel in entity.fields for c in sel.candidates for s in (self.explain(id, sel.property)?).items() if s.member("active").truth() == true && s.member("claim").int() == c.claim]
    }
}

/// A text value as written; anything else as its JSON.
fn spelled(v: Value) -> string {
    match v {
        .Text(s) -> s,
        .Null or .Bool(_) or .Int(_) or .Float(_) or .List(_) or .Map(_) -> encoded(v),
    }
}

/// A question as an FTS5 query: its words, quoted, any of which may match.
/// The phrase as one FTS5 phrase, quotes doubled.
fn fts_phrase(text: string) -> string {
    if text.trim().is_empty() { return "" }
    "\"${text.replace("\"", "\"\"")}\""
}

fn fts_query(text: string) -> string {
    let spaced = from_codepoints(
        [if word_char(text.char_code(i)) { text.char_code(i) } else { 32 } for i in 0..text.length],
    )
    let words = [w for w in spaced.split(" ") if !w.is_empty()]
    words.slice(0, if words.length > 32 { 32 } else { words.length }).map("\"${it}\"").join(" OR ")
}

fn word_char(c: int) -> bool {
    c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c >= 128
}

fn passage_of(r: Row, rank: float) -> Result<Passage, string> {
    Passage {
        row: stored(r.int(0))?,
        kind: stored(r.text(1))?,
        observation: stored(r.text(2))?,
        revision: stored(r.int(3))?,
        start: stored(r.int(4))?,
        stop: stored(r.int(5))?,
        text: stored(r.text(6))?,
        claim: stored(r.int(7))?,
        run: stored(r.text(8))?,
        entity: stored(r.text(9))?,
        rank: rank,
    }
}
