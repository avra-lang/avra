use @std.sqlite.{sql, SqlValue, Row}
use @std.text.{from_codepoints}
use ingest.chunks.{windows}
use @avra.graph_contracts.{SourceEnvelope}
use @std.validate.{Value, Entry}
use catalog.{Catalog}
use store.query.{Entity}
use store.evidence.{Interval, interval}
use store.engine.{ObservationRow}
use store.open.{Graph, stored, put_meta}
use data.{encoded}
use parameters.{
    search_limit_max,
    search_limit_default,
    page_limit,
    ascii_space,
    search_terms_max,
    ascii_zero,
    ascii_nine,
    ascii_upper_a,
    ascii_upper_z,
    ascii_a,
    ascii_z,
    ascii_limit,
}

/// One indexed passage: source text, or a fact admitted from a source.
export type Passage = {
    row: int,
    kind: string,
    observation: string,
    revision: int,
    start: int,
    stop: int,
    text: string,
    claim: int,
    run: string,
    entity: string,
    observed: int?,
    valid_from: int?,
    valid_until: int?,
    rank: float,
}

/// An entity that a mention of its model may refer to, found by the model's declared label.
export type Referent = { entity: string, label: string, rank: float }

/// The index tracks the graph revision it was built at.
const index_revision_key = "search_revision"

const index_table = "passage_index"

/// What a result row reads, in order.
const columns = "rowid, kind, observation, revision, start, stop, text, claim, run, entity, observed_at, valid_from, valid_until"

impl Graph {
    /// Passages ranked by BM25 over source text and admitted facts, best first.
    /// The index is rebuilt when the graph has moved since it was built.
    fn search(query: string, limit: int = search_limit_default) -> Result<List<Passage>, string> {
        if limit < 1 || limit > search_limit_max { fail "search limit must be 1..${search_limit_max}" }
        self.indexed()?
        let match_text = fts_query(query)
        if match_text.is_empty() { return [] }
        let rows = stored(
            self
                .db
                .all(
                    sql(
                        "SELECT ${columns}, bm25(${index_table}) FROM ${index_table} WHERE ${index_table} MATCH ? ORDER BY bm25(${index_table}), observation, start LIMIT ?",
                        [.Text(match_text), .Int(limit)],
                    ),
                ),
        )?
        [passage_of(r, stored(r.real(13))?)? for r in rows]
    }

    /// Entities of `model` whose declared label shares words with `mention`,
    /// best first, each merge group once and never the group of `exclude`.
    fn referents(model: string, mention: string, exclude: string, limit: int = search_limit_default) -> Result<
        List<Referent>,
        string,
    > {
        if limit < 1 || limit > search_limit_max { fail "referent limit must be 1..${search_limit_max}" }
        let label? = (self.catalog.model(model)?).semantics.label else { fail "${model} declares no label to find its entities by" }
        self.indexed()?
        let match_text = fts_query(mention)
        if match_text.is_empty() { return [] }
        let prefix = "${model} ${label[0]}: "
        let rows = stored(
            self
                .db
                .all(
                    sql(
                        "SELECT entity, substr(text, ?), bm25(${index_table}) FROM ${index_table} WHERE ${index_table} MATCH ? AND kind = 'fact' AND substr(text, 1, ?) = ? ORDER BY bm25(${index_table}), entity LIMIT ?",
                        [
                            .Int(prefix.length + 1),
                            .Text(match_text),
                            .Int(prefix.length),
                            .Text(prefix),
                            .Int(search_limit_max),
                        ],
                    ),
                ),
        )?
        let own = if exclude.is_empty() { [] } else { self.group(exclude)? }
        mut found: List<Referent> = []
        for r in rows {
            let entity = stored(r.text(0))?
            if own.contains(entity) || found.any(it.entity == entity) { continue }
            found
                .push(Referent { entity: entity, label: stored(r.text(1))?, rank: stored(r.real(2))? })
        }
        found.slice(0, limit)
    }

    /// Indexed rows by predicate over the unindexed columns, in index order.
    fn passages_where(condition: string, values: List<SqlValue>) -> Result<List<Passage>, string> {
        self.indexed()?
        let rows = stored(
            self
                .db
                .all(
                    sql(
                        "SELECT ${columns} FROM ${index_table} WHERE ${condition} ORDER BY rowid",
                        values,
                    ),
                ),
        )?
        [passage_of(r, 0.0)? for r in rows]
    }

    /// Indexed documents containing the phrase, or all of them for none.
    fn index_documents(phrase: string?) -> Result<int, string> {
        self.indexed()?
        let match_text = if phrase == null { "" } else { fts_phrase(phrase!) }
        let rows = stored(
            if match_text.is_empty() {
                self.db.all(sql("SELECT count(*) FROM ${index_table}", []))
            } else {
                self
                    .db
                    .all(
                        sql(
                            "SELECT count(*) FROM ${index_table} WHERE ${index_table} MATCH ?",
                            [.Text(match_text)],
                        ),
                    )
            },
        )?
        stored(rows[0].int(0))?
    }

    /// Brings the index up to the graph's revision; a no-op when it is current.
    fn indexed() -> Result<int, string> {
        let revision = self.revision()?
        if self.has_table(index_table)? && self.meta(index_revision_key)? == "${revision}" { return revision }
        stored(self.db.begin())?
        defer { let _ = self.db.finish() }
        mut db = self.db
        stored(
            db
                .exec(
                    "CREATE VIRTUAL TABLE IF NOT EXISTS ${index_table} USING fts5(text, kind UNINDEXED, observation UNINDEXED, revision UNINDEXED, start UNINDEXED, stop UNINDEXED, claim UNINDEXED, run UNINDEXED, entity UNINDEXED, observed_at UNINDEXED, valid_from UNINDEXED, valid_until UNINDEXED, tokenize = 'porter unicode61 remove_diacritics 2')",
                ),
        )?
        stored(db.run(sql("DELETE FROM ${index_table}")))?
        for p in self.indexable()? {
            stored(
                db
                    .run(
                        sql(
                            "INSERT INTO ${index_table}(text, kind, observation, revision, start, stop, claim, run, entity, observed_at, valid_from, valid_until) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
                            [
                                .Text(p.text),
                                .Text(p.kind),
                                .Text(p.observation),
                                .Int(p.revision),
                                .Int(p.start),
                                .Int(p.stop),
                                .Int(p.claim),
                                .Text(p.run),
                                .Text(p.entity),
                                maybe(p.observed),
                                maybe(p.valid_from),
                                maybe(p.valid_until),
                            ],
                        ),
                    ),
            )?
        }
        put_meta(db, index_revision_key, "${revision}")?
        stored(db.commit())?
        revision
    }

    /// Every row the index holds: source text, then the facts admitted from it.
    fn indexable() -> Result<List<Passage>, string> {
        let sources = self.source_passages()?
        sources.concat(self.fact_passages(sources)?)
    }

    /// Each observation's current text: envelope windows, or the raw text whole.
    fn source_passages() -> Result<List<Passage>, string> {
        let rows = stored(ObservationRow.all(self.db))?
        let nested = [self.windowed(r)? for r in rows]
        [p for run in nested for p in run]
    }

    fn windowed(r: ObservationRow) -> Result<List<Passage>, string> {
        match SourceEnvelope.from_json(r.payload) {
            .Ok(envelope) -> [Passage {
                row: 0,
                kind: "source",
                observation: r.name,
                revision: r.revision,
                start: w.original.start,
                stop: w.original.end,
                text: w.original.text,
                claim: 0,
                run: "",
                entity: "",
                observed: envelope.authored_at_ms ?? envelope.received_at_ms,
                valid_from: null,
                valid_until: null,
                rank: 0.0,
            } for w in windows(envelope)?],
            .Err(_) -> [
                Passage {
                    row: 0,
                    kind: "source",
                    observation: r.name,
                    revision: r.revision,
                    start: 0,
                    stop: r.payload.bytes().length,
                    text: r.payload,
                    claim: 0,
                    run: "",
                    entity: "",
                    observed: null,
                    valid_from: null,
                    valid_until: null,
                    rank: 0.0,
                },
            ],
        }
    }

    /// Every standing value, spelled `Model property: value`, filed under each source that supports it.
    fn fact_passages(sources: List<Passage>) -> Result<List<Passage>, string> {
        let nested = [self.facts_of(m.name, id, sources)? for m in self.catalog.models for id in self.find(m.name, limit: page_limit)?]
        [p for run in nested for p in run]
    }

    fn facts_of(model: string, id: string, sources: List<Passage>) -> Result<List<Passage>, string> {
        let entity = self.entity(id)?
        let held = valid_time(self.catalog, model, entity)?
        [Passage {
            row: 0,
            kind: "fact",
            observation: s.member("input").text() ?? "",
            revision: s.member("input_revision").int() ?? 0,
            start: 0,
            stop: 0,
            text: "${model} ${sel.property}: ${spelled(c.value)}",
            claim: c.claim,
            run: s.member("run").text() ?? "",
            entity: id,
            observed: observed_of(sources, s.member("input").text() ?? ""),
            valid_from: held.from?.millis(),
            valid_until: held.until?.millis(),
            rank: 0.0,
        } for sel in entity.fields for c in sel.candidates for s in (self.explain(id, sel.property)?).items() if s.member("active").truth() == true && s.member("claim").int() == c.claim]
    }
}

/// A text value as written; anything else as its JSON.
fn spelled(v: Value) -> string {
    match v {
        .Text(s) -> s,
        .Null or .Bool(_) or .Int(_) or .Float(_) or .List(_) or .Map(_) -> encoded(v),
    }
}

/// A question as an FTS5 query: its words, quoted, any of which may match.
/// The phrase as one FTS5 phrase, quotes doubled.
fn fts_phrase(text: string) -> string {
    if text.trim().is_empty() { return "" }
    "\"${text.replace("\"", "\"\"")}\""
}

fn fts_query(text: string) -> string {
    let spaced = from_codepoints(
        [if word_char(text.char_code(i)) { text.char_code(i) } else { ascii_space } for i in 0..text.length],
    )
    let words = [w for w in spaced.split(" ") if !w.is_empty()]
    words
        .slice(0, if words.length > search_terms_max { search_terms_max } else { words.length })
        .map("\"${it}\"")
        .join(" OR ")
}

fn word_char(c: int) -> bool {
    c >= ascii_zero && c <= ascii_nine ||
        c >= ascii_upper_a && c <= ascii_upper_z ||
        c >= ascii_a && c <= ascii_z ||
        c >= ascii_limit
}

fn passage_of(r: Row, rank: float) -> Result<Passage, string> {
    Passage {
        row: stored(r.int(0))?,
        kind: stored(r.text(1))?,
        observation: stored(r.text(2))?,
        revision: stored(r.int(3))?,
        start: stored(r.int(4))?,
        stop: stored(r.int(5))?,
        text: stored(r.text(6))?,
        claim: stored(r.int(7))?,
        run: stored(r.text(8))?,
        entity: stored(r.text(9))?,
        observed: nullable(r.values[10]),
        valid_from: nullable(r.values[11]),
        valid_until: nullable(r.values[12]),
        rank: rank,
    }
}

fn maybe(n: int?) -> SqlValue {
    match n {
        v? -> SqlValue.Int(v)
        null -> SqlValue.Null
    }
}

fn nullable(v: SqlValue) -> int? {
    match v { .Int(n) -> n, .Real(_) or .Text(_) or .Blob(_) or .Null -> null }
}

/// The interval a fact holds in the world, read through its model's validity binding.
fn valid_time(catalog: Catalog, model: string, entity: Entity) -> Result<Interval, string> {
    let binding = catalog.models.find(it.name == model)?.semantics?.validity
    interval(
        binding,
        Value
            .Map(
                [Entry { key: sel.property, value: sel.candidates[0].value } for sel in entity.fields if !sel.candidates.is_empty()],
            ),
    )
}

/// When the named source was authored (else received), if it is a structured source.
fn observed_of(sources: List<Passage>, observation: string) -> int? {
    let found = sources.find(it.observation == observation)
    if found == null { null } else { found!.observed }
}
