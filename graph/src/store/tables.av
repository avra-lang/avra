export const ddl: List<string> = [
    "CREATE TABLE IF NOT EXISTS graph_meta (key TEXT PRIMARY KEY, value TEXT NOT NULL)",
    "INSERT OR IGNORE INTO graph_meta VALUES ('revision', '0')",
    "CREATE TABLE IF NOT EXISTS schemas (fingerprint TEXT PRIMARY KEY, document TEXT NOT NULL)",
    "CREATE TABLE IF NOT EXISTS entities (id TEXT PRIMARY KEY, model TEXT NOT NULL, born_revision INTEGER NOT NULL)",
    "CREATE TABLE IF NOT EXISTS observations (id TEXT PRIMARY KEY, revision INTEGER NOT NULL, payload TEXT NOT NULL, digest TEXT NOT NULL)",
    "CREATE TABLE IF NOT EXISTS observation_versions (id TEXT NOT NULL, revision INTEGER NOT NULL, payload TEXT NOT NULL, PRIMARY KEY(id, revision))",
    "CREATE TABLE IF NOT EXISTS runs (id TEXT PRIMARY KEY, producer TEXT NOT NULL, scope TEXT NOT NULL, input_id TEXT NOT NULL, input_revision INTEGER NOT NULL, schema TEXT NOT NULL, request TEXT NOT NULL, revision INTEGER NOT NULL, FOREIGN KEY(input_id, input_revision) REFERENCES observation_versions(id, revision), FOREIGN KEY(schema) REFERENCES schemas(fingerprint))",
    "CREATE TABLE IF NOT EXISTS claims (id INTEGER PRIMARY KEY, entity TEXT NOT NULL REFERENCES entities(id), property TEXT NOT NULL, value TEXT NOT NULL, schema TEXT NOT NULL REFERENCES schemas(fingerprint), UNIQUE(entity, property, value, schema))",
    "CREATE TABLE IF NOT EXISTS supports (run TEXT NOT NULL REFERENCES runs(id), claim INTEGER NOT NULL REFERENCES claims(id), until_revision INTEGER, PRIMARY KEY(run, claim))",
    "CREATE TABLE IF NOT EXISTS edges (claim INTEGER NOT NULL REFERENCES claims(id), target TEXT NOT NULL REFERENCES entities(id), path TEXT NOT NULL, PRIMARY KEY(claim, target, path))",
    evidence,
    aliases,
    merges,
    tombstones,
    "CREATE INDEX IF NOT EXISTS supports_active ON supports(claim, until_revision)",
    "CREATE INDEX IF NOT EXISTS runs_owner ON runs(producer, scope)",
    "CREATE INDEX IF NOT EXISTS claims_entity ON claims(entity, property)",
    "CREATE INDEX IF NOT EXISTS claims_lookup ON claims(property, value, entity)",
    "CREATE INDEX IF NOT EXISTS edges_target ON edges(target, claim)",
    aliases_active,
    aliases_entity,
    merges_left,
    merges_right,
    tombstones_active,
]

/// A producer's external name for an entity, owned by the run that asserted it.
export const aliases: string = "CREATE TABLE IF NOT EXISTS aliases (namespace TEXT NOT NULL, external_key TEXT NOT NULL, entity TEXT NOT NULL REFERENCES entities(id), run TEXT NOT NULL REFERENCES runs(id), until_revision INTEGER, PRIMARY KEY(namespace, external_key, entity, run))"

/// Resolving one external name reads only its active rows.
export const aliases_active: string = "CREATE INDEX IF NOT EXISTS aliases_active ON aliases(namespace, external_key, until_revision)"

/// An entity's names are read from the entity side.
export const aliases_entity: string = "CREATE INDEX IF NOT EXISTS aliases_entity ON aliases(entity)"

/// A producer's opaque source locator for one supported claim.
export const evidence: string = "CREATE TABLE IF NOT EXISTS evidence (run TEXT NOT NULL REFERENCES runs(id), claim INTEGER NOT NULL REFERENCES claims(id), locator TEXT NOT NULL, PRIMARY KEY(run, claim))"

/// One explicit decision joining two entities into one read group.
export const merges: string = "CREATE TABLE IF NOT EXISTS merges (id TEXT PRIMARY KEY, left_entity TEXT NOT NULL REFERENCES entities(id), right_entity TEXT NOT NULL REFERENCES entities(id), decider TEXT NOT NULL, revision INTEGER NOT NULL, until_revision INTEGER)"

/// A group walk reads decisions from both sides.
export const merges_left: string = "CREATE INDEX IF NOT EXISTS merges_left ON merges(left_entity, until_revision)"
export const merges_right: string = "CREATE INDEX IF NOT EXISTS merges_right ON merges(right_entity, until_revision)"

/// One explicit decision that an entity is absent, kept for revival and history.
export const tombstones: string = "CREATE TABLE IF NOT EXISTS tombstones (id TEXT PRIMARY KEY, entity TEXT NOT NULL REFERENCES entities(id), decider TEXT NOT NULL, revision INTEGER NOT NULL, until_revision INTEGER)"

/// A tombstone is read from the entity side.
export const tombstones_active: string = "CREATE INDEX IF NOT EXISTS tombstones_active ON tombstones(entity, until_revision)"

/// Active external names, under the same revision laws as `active`.
export const active_alias: string = "SELECT a.namespace, a.external_key, a.entity FROM aliases a JOIN runs r ON r.id=a.run JOIN observations o ON o.id=r.input_id JOIN graph_meta m ON m.key='schema' AND m.value=r.schema WHERE a.until_revision IS NULL AND o.revision=r.input_revision"

/// Supported claims under the current observation and schema revisions.
export const active: string = "SELECT DISTINCT c.id, c.entity, c.property, c.value FROM claims c JOIN supports s ON s.claim=c.id JOIN runs r ON r.id=s.run JOIN observations o ON o.id=r.input_id JOIN graph_meta m ON m.key='schema' AND m.value=r.schema WHERE s.until_revision IS NULL AND o.revision=r.input_revision"
