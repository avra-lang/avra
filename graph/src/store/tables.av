export const ddl: List<string> = [
    "CREATE TABLE IF NOT EXISTS graph_meta (key TEXT PRIMARY KEY, value TEXT NOT NULL)",
    "INSERT OR IGNORE INTO graph_meta VALUES ('revision', '0')",
    "CREATE TABLE IF NOT EXISTS schemas (fingerprint TEXT PRIMARY KEY, document TEXT NOT NULL)",
    "CREATE TABLE IF NOT EXISTS entities (id TEXT PRIMARY KEY, model TEXT NOT NULL, born_revision INTEGER NOT NULL)",
    "CREATE TABLE IF NOT EXISTS observations (id TEXT PRIMARY KEY, revision INTEGER NOT NULL, payload TEXT NOT NULL, digest TEXT NOT NULL)",
    "CREATE TABLE IF NOT EXISTS observation_versions (id TEXT NOT NULL, revision INTEGER NOT NULL, payload TEXT NOT NULL, PRIMARY KEY(id, revision))",
    "CREATE TABLE IF NOT EXISTS runs (id TEXT PRIMARY KEY, producer TEXT NOT NULL, scope TEXT NOT NULL, input_id TEXT NOT NULL, input_revision INTEGER NOT NULL, schema TEXT NOT NULL, request TEXT NOT NULL, revision INTEGER NOT NULL, FOREIGN KEY(input_id, input_revision) REFERENCES observation_versions(id, revision), FOREIGN KEY(schema) REFERENCES schemas(fingerprint))",
    "CREATE TABLE IF NOT EXISTS claims (id INTEGER PRIMARY KEY, entity TEXT NOT NULL REFERENCES entities(id), property TEXT NOT NULL, value TEXT NOT NULL, schema TEXT NOT NULL REFERENCES schemas(fingerprint), UNIQUE(entity, property, value, schema))",
    "CREATE TABLE IF NOT EXISTS supports (run TEXT NOT NULL REFERENCES runs(id), claim INTEGER NOT NULL REFERENCES claims(id), until_revision INTEGER, PRIMARY KEY(run, claim))",
    "CREATE TABLE IF NOT EXISTS edges (claim INTEGER NOT NULL REFERENCES claims(id), target TEXT NOT NULL REFERENCES entities(id), path TEXT NOT NULL, PRIMARY KEY(claim, target, path))",
    "CREATE INDEX IF NOT EXISTS supports_active ON supports(claim, until_revision)",
    "CREATE INDEX IF NOT EXISTS runs_owner ON runs(producer, scope)",
    "CREATE INDEX IF NOT EXISTS claims_entity ON claims(entity, property)",
    "CREATE INDEX IF NOT EXISTS claims_lookup ON claims(property, value, entity)",
    "CREATE INDEX IF NOT EXISTS edges_target ON edges(target, claim)",
]

/// Supported claims under the current observation and schema revisions.
export const active: string = "SELECT DISTINCT c.id, c.entity, c.property, c.value FROM claims c JOIN supports s ON s.claim=c.id JOIN runs r ON r.id=s.run JOIN observations o ON o.id=r.input_id JOIN graph_meta m ON m.key='schema' AND m.value=r.schema WHERE s.until_revision IS NULL AND o.revision=r.input_revision"
