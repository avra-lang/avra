use @std.validate.{Value}
use @std.json.{Json, Field, field}
use @avra.graph_contracts.{Passage as Quoted, Selector, Normalization}
use semantics.{ValidityBinding, TimeEncoding}
use parameters.{
    iso_instant_shortest,
    last_hour,
    last_minute,
    last_second,
    month_lengths,
    months_from_march,
    ascii_t,
    ascii_colon,
    ascii_hyphen,
    ascii_dot,
    ascii_upper_z,
    ascii_plus,
    ascii_zero,
    ascii_nine,
}

/// FactBank factuality: the source's commitment to a statement's truth.
export enum Factuality {
    CertainTrue
    CertainFalse
    ProbableTrue
    ProbableFalse
    PossibleTrue
    PossibleFalse
    Unknown
}

/// What the source did with the statement. Only an assertion can be a fact.
export enum SpeechAct { Assert, Report, Plan, Request, Condition, Draft }

impl Factuality {
    fn word() -> string {
        match self {
            .CertainTrue -> "CT+",
            .CertainFalse -> "CT-",
            .ProbableTrue -> "PR+",
            .ProbableFalse -> "PR-",
            .PossibleTrue -> "PS+",
            .PossibleFalse -> "PS-",
            .Unknown -> "Uu",
        }
    }
}

impl SpeechAct {
    fn word() -> string {
        match self {
            .Assert -> "assert",
            .Report -> "report",
            .Plan -> "plan",
            .Request -> "request",
            .Condition -> "condition",
            .Draft -> "draft",
        }
    }
}

export fn factuality_named(word: string) -> Result<Factuality, string> {
    match word {
        "CT+" -> Factuality.CertainTrue,
        "CT-" -> Factuality.CertainFalse,
        "PR+" -> Factuality.ProbableTrue,
        "PR-" -> Factuality.ProbableFalse,
        "PS+" -> Factuality.PossibleTrue,
        "PS-" -> Factuality.PossibleFalse,
        "Uu" -> Factuality.Unknown,
        rest -> { fail "unknown factuality: ${word}" },
    }
}

export fn speech_act_named(word: string) -> Result<SpeechAct, string> {
    match word {
        "assert" -> SpeechAct.Assert,
        "report" -> SpeechAct.Report,
        "plan" -> SpeechAct.Plan,
        "request" -> SpeechAct.Request,
        "condition" -> SpeechAct.Condition,
        "draft" -> SpeechAct.Draft,
        rest -> { fail "unknown speech act: ${word}" },
    }
}

/// A plain fact: asserted as certainly true.
export fn plain(factuality: Factuality, act: SpeechAct) -> bool { asserted(act) && certain(factuality, true) }

/// An asserted certain denial: a plain fact's contradiction, never a value.
export fn denial(factuality: Factuality, act: SpeechAct) -> bool { asserted(act) && certain(factuality, false) }

fn asserted(act: SpeechAct) -> bool {
    match act { .Assert -> true, .Report or .Plan or .Request or .Condition or .Draft -> false }
}

fn certain(factuality: Factuality, truth: bool) -> bool {
    match factuality {
        .CertainTrue -> truth,
        .CertainFalse -> !truth,
        .ProbableTrue or .ProbableFalse or .PossibleTrue or .PossibleFalse or .Unknown -> false,
    }
}

/// One property's evidence: the passages it was read from, how the source
/// committed to it, and in whose voice. The value it supports is the
/// record's normalized value, which the passages need not contain.
export type FieldEvidence = {
    property: string,
    evidence: List<Quoted>,
    factuality: Factuality = .CertainTrue,
    speech_act: SpeechAct = .Assert,
    frame: string? = null,
    normalization: Normalization? = null,
    score: float? = null,
}

impl FieldEvidence {
    fn plain() -> bool { plain(self.factuality, self.speech_act) }

    fn json() -> Json {
        Json
            .Obj(
                [
                    field("property", Json.Str(self.property)),
                    field("factuality", Json.Str(self.factuality.word())),
                    field("speech_act", Json.Str(self.speech_act.word())),
                    field("frame", optional_text(self.frame)),
                    field(
                        "score",
                        if self.score == null { Json.Null } else { Json.Float(self.score!) },
                    ),
                ]
                    .concat(self.annotation()),
            )
    }

    /// The stored evidence document: passages and normalization.
    fn annotation() -> List<Field> {
        [
            field("evidence", Json.Arr([passage_json(p) for p in self.evidence])),
            field("normalization", normalization_json(self.normalization)),
        ]
    }
}

/// A quotation frame's speaker within one source, or the source's own voice
/// when `frame` is null. Null speaker or audience means unknown.
export type Voice = {
    frame: string? = null,
    speaker: string? = null,
    author: string? = null,
    audience: List<string>? = null,
}

impl Voice {
    fn json() -> Json {
        Json
            .Obj(
                [
                    field("frame", optional_text(self.frame)),
                    field("speaker", optional_text(self.speaker)),
                    field("author", optional_text(self.author)),
                    field("audience", audience_json(self.audience)),
                ],
            )
    }
}

export fn audience_json(audience: List<string>?) -> Json {
    let found? = audience else { return Json.Null }
    Json.Arr([Json.Str(a) for a in found])
}

export fn optional_text(s: string?) -> Json {
    let found? = s else { return Json.Null }
    Json.Str(found)
}

fn optional_int(n: int?) -> Json {
    let found? = n else { return Json.Null }
    Json.Int(found)
}

/// A W3C Web Annotation selector; absent keys are omitted.
export fn selector_json(s: Selector) -> Json {
    let present = [
        field("prefix", optional_text(s.prefix)),
        field("exact", optional_text(s.exact)),
        field("suffix", optional_text(s.suffix)),
        field("start", optional_int(s.start)),
        field("end", optional_int(s.end)),
    ]
    Json.Obj([field("kind", Json.Str(s.kind))].concat(present.filter(!(it.value is .Null))))
}

export fn passage_json(p: Quoted) -> Json {
    Json.Obj([field("selector", Json.Arr([selector_json(s) for s in p.selector]))])
}

export fn normalization_json(n: Normalization?) -> Json {
    let found? = n else { return Json.Null }
    let present = [
        field("timex_type", optional_text(found.timex_type)),
        field("value", optional_text(found.value)),
        field("currency", optional_text(found.currency)),
        field("minor_units", optional_int(found.minor_units)),
        field("exponent", optional_int(found.exponent)),
    ]
    Json.Obj([field("kind", Json.Str(found.kind))].concat(present.filter(!(it.value is .Null))))
}

/// A UTC instant: whole seconds since 1970-01-01 and the decimal fraction
/// of a second exactly as written, trailing zeros dropped.
export type Instant = { seconds: int, fraction: string = "" }

impl Instant {
    /// Whether this instant precedes `other`.
    fn before(other: Instant) -> bool {
        if self.seconds != other.seconds { return self.seconds < other.seconds }
        let width = if self.fraction.length > other.fraction.length { self.fraction.length } else { other.fraction.length }
        earlier_text(padded(self.fraction, width), padded(other.fraction, width))
    }

    /// Normalized ISO 8601 in UTC: `YYYY-MM-DDTHH:MM:SS[.fraction]Z`.
    fn iso() -> string {
        let days = floor_div(self.seconds, 86400)
        let rest = self.seconds - days * 86400
        let date = civil_from_days(days)
        let fraction = if self.fraction.is_empty() { "" } else { ".${self.fraction}" }
        "${padded_int(date[0], 4)}-${padded_int(date[1], 2)}-${padded_int(date[2], 2)}T${padded_int(rest / 3600, 2)}:${padded_int(rest / 60 % 60, 2)}:${padded_int(rest % 60, 2)}${fraction}Z"
    }

    /// Whole milliseconds, toward the past.
    fn millis() -> int {
        let head = padded(self.fraction, 3).substring(0, 3)
        self.seconds * 1000 + (digits(head, 0, 3) catch 0)
    }
}

/// When a record holds in the world, half-open. Null is unknown.
export type Interval = { from: Instant? = null, until: Instant? = null }

impl Interval {
    /// Whether the instant lies within; an unknown bound is open.
    fn holds(at: Instant) -> bool {
        let started = match self.from {
            start? -> !at.before(start)
            null -> true
        }
        started && self.open_at(at)
    }

    /// Whether this interval is still open at `at`.
    fn open_at(at: Instant) -> bool {
        let end? = self.until else { return true }
        at.before(end)
    }
}

/// A record's declared valid time, read through its model's binding.
export fn interval(binding: ValidityBinding?, value: Value) -> Result<Interval, string> {
    let b? = binding else { return Interval {} }
    Interval { from: bound(b.from, b.encoding, value)?, until: bound(b.until, b.encoding, value)? }
}

fn bound(path: List<string>?, encoding: TimeEncoding, value: Value) -> Result<Instant?, string> {
    let unknown: Instant? = null
    let p? = path else { return unknown }
    let found? = at_path(value, p) else { return unknown }
    let moment: Instant? = match found {
        .Null -> unknown,
        .Int(ms) -> match encoding {
            .UnixMillis -> from_millis(ms),
            .IsoDate or .IsoInstant -> { fail off_encoding() },
        },
        .Text(t) -> match encoding {
            .UnixMillis -> { fail off_encoding() },
            .IsoDate -> iso_date(t)?,
            .IsoInstant -> iso_instant(t)?,
        },
        rest -> { fail off_encoding() },
    }
    moment
}

fn at_path(value: Value, path: List<string>) -> Value? {
    mut current = value
    for token in path {
        let next? = current.entries().find(it.key == token) else { return null }
        current = next.value
    }
    current
}

/// An ISO 8601 date (its UTC start) or instant.
export fn instant_named(t: string) -> Result<Instant, string> {
    if t.length == 10 { iso_date(t) } else { iso_instant(t) }
}

fn from_millis(ms: int) -> Instant {
    let seconds = floor_div(ms, 1000)
    Instant { seconds: seconds, fraction: trimmed(padded_int(ms - seconds * 1000, 3)) }
}

/// `YYYY-MM-DD`, as the start of that UTC day.
fn iso_date(t: string) -> Result<Instant, string> {
    if t.length != 10 { fail not_iso(t) }
    Instant { seconds: day_seconds(t)? }
}

/// `YYYY-MM-DDTHH:MM:SS`, an optional fraction of any length, then `Z` or
/// an offset `±HH`, `±HHMM` or `±HH:MM`.
fn iso_instant(t: string) -> Result<Instant, string> {
    if t.length < iso_instant_shortest ||
        t.char_code(10) != ascii_t ||
        t.char_code(13) != ascii_colon ||
        t.char_code(16) != ascii_colon {
        fail not_iso(t)
    }
    let hour = digits(t, 11, 13)?
    let minute = digits(t, 14, 16)?
    let second = digits(t, 17, 19)?
    if hour > last_hour || minute > last_minute || second > last_second { fail not_iso(t) }
    mut at = 19
    mut fraction = ""
    if t.char_code(at) == ascii_dot {
        let start = at + 1
        at = start
        while at < t.length && digit(t.char_code(at)) { at = at + 1 }
        if at == start { fail not_iso(t) }
        fraction = trimmed(t.substring(start, at))
    }
    let local = day_seconds(t)? + (hour * 60 + minute) * 60 + second
    Instant { seconds: local - offset_seconds(t, at)?, fraction: fraction }
}

/// The offset at `at` in seconds east of UTC.
fn offset_seconds(t: string, at: int) -> Result<int, string> {
    if at == t.length - 1 && t.char_code(at) == ascii_upper_z { return 0 }
    let mark = t.char_code(at)
    if mark != ascii_plus && mark != ascii_hyphen { fail not_iso(t) }
    let sign = if mark == ascii_plus { 1 } else { -1 }
    let size = t.length - at
    let minutes = match size {
        3 -> 0,
        5 -> digits(t, at + 3, at + 5)?,
        6 -> {
            if t.char_code(at + 3) != ascii_colon { fail not_iso(t) }
            digits(t, at + 4, at + 6)?
        },
        rest -> { fail not_iso(t) },
    }
    let hours = digits(t, at + 1, at + 3)?
    if hours > last_hour || minutes > last_minute { fail not_iso(t) }
    sign * (hours * 60 + minutes) * 60
}

fn day_seconds(t: string) -> Result<int, string> {
    if t.char_code(4) != ascii_hyphen || t.char_code(7) != ascii_hyphen { fail not_iso(t) }
    let year = digits(t, 0, 4)?
    let month = digits(t, 5, 7)?
    let day = digits(t, 8, 10)?
    if month < 1 || month > month_lengths.length || day < 1 || day > month_days(year, month) { fail not_iso(t) }
    days_from_civil(year, month, day) * 86400
}

fn digits(t: string, from: int, to: int) -> Result<int, string> {
    mut n = 0
    for i in from..to {
        let c = t.char_code(i)
        if !digit(c) { fail not_iso(t) }
        n = n * 10 + c - 48
    }
    n
}

fn digit(c: int) -> bool { c >= ascii_zero && c <= ascii_nine }

fn month_days(year: int, month: int) -> int {
    let leap = year % 4 == 0 && year % 100 != 0 || year % 400 == 0
    month_lengths[month - 1] + if month == 2 && leap { 1 } else { 0 }
}

fn floor_div(n: int, d: int) -> int {
    let q = n / d
    if q * d > n { q - 1 } else { q }
}

/// Days since 1970-01-01 in the proleptic Gregorian calendar.
fn days_from_civil(year: int, month: int, day: int) -> int {
    let y = if month <= 2 { year - 1 } else { year }
    let era = floor_div(y, 400)
    let yoe = y - era * 400
    let shifted = if month > 2 { month - 3 } else { month + 9 }
    let doy = (153 * shifted + 2) / 5 + day - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146097 + doe - 719468
}

/// Year, month and day of a count of days since 1970-01-01.
fn civil_from_days(days: int) -> List<int> {
    let z = days + 719468
    let era = floor_div(z, 146097)
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let day = doy - (153 * mp + 2) / 5 + 1
    let month = if mp < months_from_march { mp + 3 } else { mp - 9 }
    [yoe + era * 400 + if month <= 2 { 1 } else { 0 }, month, day]
}

fn padded(s: string, width: int) -> string { s + ["0" for i in s.length..width].join("") }

fn padded_int(n: int, width: int) -> string {
    let text = "${n}"
    ["0" for i in text.length..width].join("") + text
}

/// Trailing zeros dropped from a fraction's digits.
fn trimmed(fraction: string) -> string {
    mut end = fraction.length
    while end > 0 && fraction.char_code(end - 1) == ascii_zero { end = end - 1 }
    fraction.substring(0, end)
}

/// Equal-width digit strings in order.
fn earlier_text(a: string, b: string) -> bool {
    for i in 0..a.length {
        if a.char_code(i) != b.char_code(i) { return a.char_code(i) < b.char_code(i) }
    }
    false
}

fn off_encoding() -> string { "a validity bound is not its declared time encoding" }

fn not_iso(t: string) -> string { "a validity bound is not a canonical ISO time: ${t}" }
