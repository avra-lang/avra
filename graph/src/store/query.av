use @std.validate.{Value, Entry}
use @std.json.{Json, parse, field}
use store.open.{Graph, stored}
use store.engine.{
    ObservationRow,
    ObservationVersionRow,
    EntityRow,
    EdgeRow,
    SupportRow,
    RunRow,
    RunTrailRow,
}
use data.{as_value, as_json, encoded}

export type Candidate = { claim: int, value: Value }
export type Selection = { property: string, candidates: List<Candidate> }
export type Entity = { id: string, model: string, revision: int, fields: List<Selection> }
export type Edge = { entity: string, property: string, target: string, path: string }

impl Graph {
    fn observation_row(id: string) -> Result<ObservationRow, string> {
        match stored(ObservationRow.where(self.db, name: id))? {
            [only] -> only,
            [] -> { fail "observation not found: ${id}" },
            rest -> { fail "observation name is not unique: ${id}" },
        }
    }

    /// A source's current payload, or one immutable historical revision.
    fn observation(id: string, revision: int = 0) -> Result<Json, string> {
        if revision < 0 { fail "observation revision must be nonnegative" }
        self.current()?
        let row = self.observation_row(id)?
        let at = if revision == 0 { row.revision } else { revision }
        let payload = if at == row.revision {
            row.payload
        } else {
            match stored(ObservationVersionRow.where(self.db, observation: row, revision: at))? {
                [old] -> old.payload,
                rest -> { fail "observation revision not found: ${id}/${at}" },
            }
        }
        Json
            .Obj(
                [
                    field("id", Json.Str(id)),
                    field("revision", Json.Int(at)),
                    field("payload", Json.Str(payload)),
                ],
            )
    }

    fn entity(id: string) -> Result<Entity, string> {
        let revision = self.current()?
        let named = self.entity_named(id)?
        if self.hidden(id)? { fail "entity is tombstoned: ${id}" }
        let live = self.standing(self.claims_of(self.entities_named(self.group(id)?)?)?)?
        mut selections: List<Selection> = []
        for s in live {
            if selections.any(it.property == s.claim.property) { continue }
            mut candidates: List<Candidate> = []
            for other in live {
                if other.claim.property != s.claim.property { continue }
                let value = stored_value(other.claim.value)?
                if candidates.any(encoded(it.value) == encoded(value)) { continue }
                candidates.push(Candidate { claim: other.claim.id, value: value })
            }
            selections.push(Selection { property: s.claim.property, candidates: candidates })
        }
        Entity { id: id, model: named.model, revision: revision, fields: selections }
    }

    /// A complete record only when every property has one supported answer.
    fn value(id: string) -> Result<Value, string> {
        let entity = self.entity(id)?
        if entity.fields.is_empty() { fail "entity has no current support: ${id}" }
        if entity.fields.any(it.candidates.length != 1) { fail "entity has competing statements: ${id}" }
        let assembled = Value
            .Map([Entry { key: f.property, value: f.candidates[0].value } for f in entity.fields])
        let model = self.catalog.model(entity.model)?
        match (model.check)(assembled) {
            .Ok(value) -> value,
            .Err(issues) -> { fail "entity is not a valid complete record: ${issues.report()}" },
        }
    }

    fn find(model: string, limit: int = 100) -> Result<List<string>, string> {
        if limit < 1 || limit > 1000 { fail "limit must be between 1 and 1000" }
        self.current()?
        let hidden = self.hidden_members()?
        let candidates = stored(EntityRow.where(self.db, model: model))?
        mut live: List<string> = []
        for e in candidates {
            if hidden.contains(e.name) { continue }
            if !(self.standing(self.claims_of([e])?)?).is_empty() { live.push(e.name) }
        }
        let roots = [self.root(name)? for name in live]
        [name for i, name in live if !roots.slice(0, i).contains(roots[i])].slice(0, limit)
    }

    fn edges(id: string, incoming: bool = false) -> Result<List<Edge>, string> {
        self.current()?
        if self.hidden(id)? { fail "entity is tombstoned: ${id}" }
        let members = self.entities_named(self.group(id)?)?
        let hidden = self.hidden_members()?
        mut found: List<Edge> = []
        if incoming {
            for e in stored(EdgeRow.in_target(self.db, members))? {
                if hidden.contains(e.target.name) { continue }
                if (self.standing([e.claim])?).is_empty() { continue }
                found.push(self.edge_of(e))
            }
        } else {
            let live = [s.claim for s in self.standing(self.claims_of(members)?)?]
            for e in stored(EdgeRow.in_claim(self.db, live))? {
                if hidden.contains(e.target.name) { continue }
                found.push(self.edge_of(e))
            }
        }
        found
    }

    fn edge_of(e: EdgeRow) -> Edge {
        Edge {
            entity: e.claim.entity.name,
            property: e.claim.property,
            target: e.target.name,
            path: e.path,
        }
    }

    /// Breadth-first reachability; a hard node budget bounds cyclic graphs.
    fn traverse(id: string, depth: int = 2, limit: int = 100) -> Result<List<string>, string> {
        if depth < 0 || depth > 20 || limit < 1 || limit > 1000 { fail "depth must be 0..20 and limit 1..1000" }
        self.current()?
        mut seen = [id]
        mut frontier = [id]
        for _level in 0..depth {
            mut next: List<string> = []
            for from in frontier {
                for edge in self.edges(from)? {
                    if !seen.contains(edge.target) {
                        if seen.length >= limit { fail "traversal exceeded its node budget" }
                        seen.push(edge.target)
                        next.push(edge.target)
                    }
                }
            }
            frontier = next
            if frontier.is_empty() { break }
        }
        seen
    }

    /// Every historical support, including why it no longer contributes.
    fn explain(id: string, property: string) -> Result<Json, string> {
        self.current()?
        let entities = self.entities_named(self.group(id)?)?
        let claims = self.claims_of(entities)?
        let supports = stored(SupportRow.in_claim(self.db, claims))?
        let trails = stored(RunTrailRow.in_run(self.db, supports.map(it.run)))?
        let confidence = stored(ConfidenceRow.in_support(self.db, supports))?
        let scheme = self.catalog.fingerprint
        mut rows: List<Json> = []
        for s in supports {
            if s.claim.property != property { continue }
            rows
                .push(
                    Json
                        .Obj(
                            [
                                field("claim", Json.Int(s.claim.id)),
                                field("value", as_json(stored_value(s.claim.value)?)),
                                field("run", Json.Str(s.run.name)),
                                field("producer", Json.Str(s.run.producer)),
                                field("scope", Json.Str(s.run.scope)),
                                field("input", Json.Str(s.run.input.name)),
                                field("input_revision", Json.Int(s.run.input.revision)),
                                field("schema", Json.Str(s.claim.schema)),
                                field("until_revision", Json.Int(s.until ?? 0)),
                                field("active", Json.Bool(self.contributes(s, trails, scheme))),
                                field("published_revision", Json.Int(s.run.revision)),
                                field("locator", self.locator(s)?),
                                field("confidence", self.confidence_of(s, confidence)),
                            ],
                        ),
                )
        }
        Json.Arr(rows)
    }

    fn confidence_of(s: SupportRow, rows: List<ConfidenceRow>) -> Json {
        match rows.find(it.support.id == s.id) {
            found? -> Json.Float(found.value)
            null -> Json.Null
        }
    }

    fn locator(s: SupportRow) -> Result<Json, string> {
        match s.locator {
            text? -> as_json(stored_value(text)?)
            null -> Json.Null
        }
    }

    fn contributes(s: SupportRow, trails: List<RunTrailRow>, scheme: string) -> bool {
        s.until == null && s.claim.schema == scheme && self.stands(s, trails, scheme)
    }

    /// Inputs whose last supported interpretation is out of date.
    fn dirty() -> Result<Json, string> {
        self.current()?
        let runs = stored(RunRow.all(self.db))?
        let trails = stored(RunTrailRow.in_run(self.db, runs))?
        let scheme = self.catalog.fingerprint
        mut rows: List<Json> = []
        for r in runs {
            if runs
                .any(it.producer == r.producer && it.scope == r.scope && it.revision > r.revision) {
                continue
            }
            if !self.stale(r, trails, scheme) { continue }
            rows
                .push(
                    Json
                        .Obj(
                            [
                                field("producer", Json.Str(r.producer)),
                                field("scope", Json.Str(r.scope)),
                                field("input", Json.Str(r.input.name)),
                                field("input_revision", Json.Int(r.input.revision)),
                            ],
                        ),
                )
        }
        Json.Arr(rows)
    }

    fn stale(r: RunRow, trails: List<RunTrailRow>, scheme: string) -> bool {
        let trail? = self.trail_of(trails, r.id) else { return true }
        trail.schema != scheme || trail.input_revision != r.input.revision
    }
}

impl Entity {
    fn json() -> Json {
        Json
            .Obj(
                [
                    field("id", Json.Str(self.id)),
                    field("model", Json.Str(self.model)),
                    field("revision", Json.Int(self.revision)),
                    field(
                        "fields",
                        Json
                            .Obj(
                                [field(
                                    f.property,
                                    Json
                                        .Arr(
                                            [Json
                                                .Obj(
                                                    [
                                                        field("claim", Json.Int(c.claim)),
                                                        field("value", as_json(c.value)),
                                                    ],
                                                ) for c in f.candidates],
                                        ),
                                ) for f in self.fields],
                            ),
                    ),
                ],
            )
    }
}

export fn stored_value(text: string) -> Result<Value, string> {
    match parse(text) {
        .Ok(j) -> as_value(j),
        .Err(_) -> { fail "stored graph value is not JSON" },
    }
}
