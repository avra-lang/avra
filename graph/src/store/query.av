use @std.validate.{Value, Entry}
use @std.json.{Json, Field, parse, field}
use store.open.{Graph, stored}
use store.engine.{
    ObservationRow,
    ObservationVersionRow,
    EntityRow,
    EdgeRow,
    SupportRow,
    RunRow,
    RunTrailRow,
    EvidenceRow,
    SupersessionRow,
    ConfidenceRow,
    FailedRunRow,
}
use store.state.{Standing}
use store.evidence.{Interval, optional_text}
use data.{as_value, as_json, encoded}

/// `denied` marks a value a standing assertion also denies: a contradiction
/// kept, never resolved here.
export type Candidate = { claim: int, value: Value, chosen: bool = false, denied: bool = false }
export type Selection = { property: string, candidates: List<Candidate> }

/// A standing statement that is not a plain fact: denied, planned, reported…
export type Qualified = { claim: int, property: string, value: Value, factuality: string, speech_act: string }

/// `fields` are current plain facts; `qualified` never reads as a value.
export type Entity = {
    id: string,
    model: string,
    revision: int,
    fields: List<Selection>,
    qualified: List<Qualified> = [],
}
export type Edge = { entity: string, property: string, target: string, path: string }

impl Graph {
    fn observation_row(id: string) -> Result<ObservationRow, string> {
        match stored(ObservationRow.where(self.db, name: id))? {
            [only] -> only,
            [] -> { fail "observation not found: ${id}" },
            rest -> { fail "observation name is not unique: ${id}" },
        }
    }

    /// A source's current payload, or one immutable historical revision.
    fn observation(id: string, revision: int = 0) -> Result<Json, string> {
        let opened = self.read_snapshot()?
        defer { let _ = self.db.finish_if_opened(opened) }
        if revision < 0 { fail "observation revision must be nonnegative" }
        self.current()?
        let row = self.observation_row(id)?
        let at = if revision == 0 { row.revision } else { revision }
        let payload = if at == row.revision {
            row.payload
        } else {
            match stored(ObservationVersionRow.where(self.db, observation: row, revision: at))? {
                [old] -> old.payload,
                rest -> { fail "observation revision not found: ${id}/${at}" },
            }
        }
        Json
            .Obj(
                [
                    field("id", Json.Str(id)),
                    field("revision", Json.Int(at)),
                    field("payload", Json.Str(payload)),
                ],
            )
    }

    fn entity(id: string) -> Result<Entity, string> {
        let opened = self.read_snapshot()?
        defer { let _ = self.db.finish_if_opened(opened) }
        let revision = self.current()?
        let named = self.entity_named(id)?
        if self.hidden(id)? { fail "entity is tombstoned: ${id}" }
        let standing = self.standing(self.claims_of(self.entities_named(self.group(id)?)?)?)?
        let live = self.held(standing)?
        let denied = [s.claim.id for s in standing if s.denies()]
        mut selections: List<Selection> = []
        for s in live {
            if selections.any(it.property == s.claim.property) { continue }
            mut candidates: List<Candidate> = []
            let chosen = self.chosen_claim(live, s.claim.property)?
            for other in live {
                if other.claim.property != s.claim.property { continue }
                let value = stored_value(other.claim.value)?
                if candidates.any(encoded(it.value) == encoded(value)) { continue }
                candidates
                    .push(
                        Candidate {
                            claim: other.claim.id,
                            value: value,
                            chosen: self.picked(chosen, value),
                            denied: denied.contains(other.claim.id),
                        },
                    )
            }
            selections.push(Selection { property: s.claim.property, candidates: candidates })
        }
        Entity {
            id: id,
            model: named.model,
            revision: revision,
            fields: selections,
            qualified: qualified_of(standing)?,
        }
    }

    /// Whether a standing choice names this value.
    fn picked(chosen: ClaimRow?, value: Value) -> bool {
        match chosen {
            claim? -> claim.value == encoded(value)
            null -> false
        }
    }

    /// A complete record only when every property has one supported answer.
    fn value(id: string) -> Result<Value, string> {
        let opened = self.read_snapshot()?
        defer { let _ = self.db.finish_if_opened(opened) }
        let entity = self.entity(id)?
        if entity.fields.is_empty() { fail "entity has no current support: ${id}" }
        mut assembled: List<Entry> = []
        for f in entity.fields {
            let pick = if f.candidates.length == 1 {
                f.candidates[0]
            } else {
                let chosen? = f.candidates.find(it.chosen) else { fail "entity has competing statements: ${id}" }
                chosen
            }
            if pick.denied && !pick.chosen { fail "entity has a denied statement: ${id}.${f.property}" }
            assembled.push(Entry { key: f.property, value: pick.value })
        }
        let assembled = Value.Map(assembled)
        let model = self.catalog.model(entity.model)?
        match (model.check)(assembled) {
            .Ok(value) -> value,
            .Err(issues) -> { fail "entity is not a valid complete record: ${issues.report()}" },
        }
    }

    fn find(model: string, limit: int = 100, offset: int = 0) -> Result<List<string>, string> {
        let opened = self.read_snapshot()?
        defer { let _ = self.db.finish_if_opened(opened) }
        page_ok(limit, offset)?
        self.current()?
        let hidden = self.hidden_members()?
        let candidates = stored(EntityRow.where(self.db, model: model))?
        mut live: List<string> = []
        for e in candidates {
            if hidden.contains(e.name) { continue }
            if !(self.facts(self.claims_of([e])?)?).is_empty() { live.push(e.name) }
        }
        let roots = [self.root(name)? for name in live]
        [name for i, name in live if !roots.slice(0, i).contains(roots[i])]
            .slice(offset, offset + limit)
    }

    /// Entities whose named property currently has this exact value.
    fn matching(model: string, property: string, value: Value, limit: int = 100, offset: int = 0) -> Result<
        List<string>,
        string,
    > {
        let opened = self.read_snapshot()?
        defer { let _ = self.db.finish_if_opened(opened) }
        if property.is_empty() { fail "a filter needs a property name" }
        page_ok(limit, offset)?
        self.current()?
        let hidden = self.hidden_members()?
        let wanted = encoded(value)
        let candidates = stored(EntityRow.where(self.db, model: model))?
        mut live: List<string> = []
        for e in candidates {
            if hidden.contains(e.name) { continue }
            let claims = self.facts(self.claims_of([e])?)?
            if claims.any(it.claim.property == property && it.claim.value == wanted) { live.push(e.name) }
        }
        let roots = [self.root(name)? for name in live]
        [name for i, name in live if !roots.slice(0, i).contains(roots[i])]
            .slice(offset, offset + limit)
    }

    fn edges(id: string, incoming: bool = false) -> Result<List<Edge>, string> {
        let opened = self.read_snapshot()?
        defer { let _ = self.db.finish_if_opened(opened) }
        self.current()?
        if self.hidden(id)? { fail "entity is tombstoned: ${id}" }
        let members = self.entities_named(self.group(id)?)?
        let hidden = self.hidden_members()?
        mut found: List<Edge> = []
        if incoming {
            for e in stored(EdgeRow.in_target(self.db, members))? {
                if hidden.contains(e.target.name) || hidden.contains(e.claim.entity.name) { continue }
                if (self.facts([e.claim])?).is_empty() { continue }
                found.push(self.edge_of(e))
            }
        } else {
            let live = [s.claim for s in self.facts(self.claims_of(members)?)?]
            for e in stored(EdgeRow.in_claim(self.db, live))? {
                if hidden.contains(e.target.name) { continue }
                found.push(self.edge_of(e))
            }
        }
        found
    }

    fn edge_of(e: EdgeRow) -> Edge {
        Edge {
            entity: e.claim.entity.name,
            property: e.claim.property,
            target: e.target.name,
            path: e.path,
        }
    }

    /// Breadth-first reachability; a hard node budget bounds cyclic graphs.
    fn traverse(id: string, depth: int = 2, limit: int = 100) -> Result<List<string>, string> {
        let opened = self.read_snapshot()?
        defer { let _ = self.db.finish_if_opened(opened) }
        if depth < 0 || depth > 20 || limit < 1 || limit > 1000 { fail "depth must be 0..20 and limit 1..1000" }
        self.current()?
        mut seen = [id]
        mut frontier = [id]
        for _level in 0..depth {
            mut next: List<string> = []
            for from in frontier {
                for edge in self.edges(from)? {
                    if !seen.contains(edge.target) {
                        if seen.length >= limit { fail "traversal exceeded its node budget" }
                        seen.push(edge.target)
                        next.push(edge.target)
                    }
                }
            }
            frontier = next
            if frontier.is_empty() { break }
        }
        seen
    }

    /// Every historical support, including why it no longer contributes.
    fn explain(id: string, property: string) -> Result<Json, string> {
        let opened = self.read_snapshot()?
        defer { let _ = self.db.finish_if_opened(opened) }
        self.current()?
        let entities = self.entities_named(self.group(id)?)?
        let claims = self.claims_of(entities)?
        let supports = stored(SupportRow.in_claim(self.db, claims))?
        let trails = stored(RunTrailRow.in_run(self.db, supports.map(it.run)))?
        let confidence = stored(ConfidenceRow.in_support(self.db, supports))?
        let evidence = stored(EvidenceRow.in_support(self.db, supports))?
        let closings = stored(SupersessionRow.in_old(self.db, supports))?
        let closers = stored(RunTrailRow.in_run(self.db, closings.map(it.new.run)))?
        let scheme = self.catalog.fingerprint
        let current = (self.facts(claims)?).map(it.support.id)
        mut rows: List<Json> = []
        for s in supports {
            if s.claim.property != property { continue }
            let trail? = self.trail_of(trails, s.run.id) else { fail "a run has no trail: ${s.run.name}" }
            let closed = [c for c in closings if c.old.id == s.id]
            let standing = self.upheld(s, trails, scheme)
            let span = self.valid_time(s)?
            rows
                .push(
                    Json
                        .Obj(
                            [
                                field("claim", Json.Int(s.claim.id)),
                                field("value", as_json(stored_value(s.claim.value)?)),
                                field("run", Json.Str(s.run.name)),
                                field("producer", Json.Str(s.run.producer)),
                                field("scope", Json.Str(s.run.scope)),
                                field("input", Json.Str(s.run.input.name)),
                                field("input_revision", Json.Int(trail.input_revision)),
                                field("schema", Json.Str(s.claim.schema)),
                                field("until_revision", Json.Int(s.until ?? 0)),
                                field("active", Json.Bool(current.contains(s.id))),
                                field("authority", Json.Int(self.rank(s.run.producer))),
                                field("standing", Json.Bool(standing)),
                                field("published_revision", Json.Int(s.run.revision)),
                                field("locator", self.locator(s)?),
                                field("confidence", self.confidence_of(s, confidence)),
                                field("valid_from", optional_int(span.from)),
                                field("valid_until", optional_int(span.until)),
                                field(
                                    "superseded_by",
                                    Json
                                        .Arr(
                                            [Json
                                                .Obj(
                                                    [
                                                        field("claim", Json.Int(c.new.claim.id)),
                                                        field("run", Json.Str(c.new.run.name)),
                                                        field("at", Json.Int(c.at)),
                                                        field(
                                                            "standing",
                                                            Json
                                                                .Bool(
                                                                    self
                                                                        .upheld(c.new, closers, scheme),
                                                                ),
                                                        ),
                                                    ],
                                                ) for c in closed],
                                        ),
                                ),
                            ]
                                .concat(
                                    qualifiers(
                                        evidence.find(it.support.id == s.id),
                                        s,
                                        trail.input_revision,
                                    )?,
                                ),
                        ),
                )
        }
        Json.Arr(rows)
    }

    /// A support's declared valid time; unknown when its model left the catalog.
    fn valid_time(s: SupportRow) -> Result<Interval, string> {
        match self.catalog.model(s.claim.entity.model) {
            .Ok(model) -> self.interval_of(s.run, s.claim.entity, model)?,
            .Err(_) -> Interval {},
        }
    }

    fn confidence_of(s: SupportRow, rows: List<ConfidenceRow>) -> Json {
        match rows.find(it.support.id == s.id) {
            found? -> Json.Float(found.value)
            null -> Json.Null
        }
    }

    fn locator(s: SupportRow) -> Result<Json, string> {
        match s.locator {
            text? -> as_json(stored_value(text)?)
            null -> Json.Null
        }
    }

    /// Inputs whose last supported interpretation is out of date.
    fn dirty() -> Result<Json, string> {
        let opened = self.read_snapshot()?
        defer { let _ = self.db.finish_if_opened(opened) }
        self.current()?
        let runs = stored(RunRow.all(self.db))?
        let trails = stored(RunTrailRow.in_run(self.db, runs))?
        let scheme = self.catalog.fingerprint
        mut rows: List<Json> = []
        for r in runs {
            if runs
                .any(it.producer == r.producer && it.scope == r.scope && it.revision > r.revision) {
                continue
            }
            if !self.stale(r, trails, scheme) { continue }
            rows
                .push(
                    Json
                        .Obj(
                            [
                                field("producer", Json.Str(r.producer)),
                                field("scope", Json.Str(r.scope)),
                                field("input", Json.Str(r.input.name)),
                                field("input_revision", Json.Int(r.input.revision)),
                                field("failed", Json.Bool(false)),
                            ],
                        ),
                )
        }
        Json.Arr(rows.concat(self.unretried(runs)?))
    }

    /// Failed admissions no later run of their producer and scope replaced.
    fn unretried(runs: List<RunRow>) -> Result<List<Json>, string> {
        mut rows: List<Json> = []
        for f in stored(FailedRunRow.all(self.db))? {
            let document = match parse(f.document) {
                .Ok(j) -> j,
                .Err(_) -> { fail "a stored failed run is not JSON" },
            }
            let at = document.member("revision").int() ?? 0
            if runs.any(it.producer == f.producer && it.scope == f.scope && it.revision > at) { continue }
            rows
                .push(
                    Json
                        .Obj(
                            [
                                field("producer", Json.Str(f.producer)),
                                field("scope", Json.Str(f.scope)),
                                field("input", Json.Str(f.input.name)),
                                field("input_revision", document.member("input_revision")),
                                field("failed", Json.Bool(true)),
                                field("run", Json.Str(f.name)),
                                field("problems", document.member("problems")),
                            ],
                        ),
                )
        }
        rows
    }

    fn stale(r: RunRow, trails: List<RunTrailRow>, scheme: string) -> bool {
        let trail? = self.trail_of(trails, r.id) else { return true }
        trail.schema != scheme || trail.input_revision != r.input.revision
    }
}

impl Entity {
    fn json() -> Json {
        Json
            .Obj(
                [
                    field("id", Json.Str(self.id)),
                    field("model", Json.Str(self.model)),
                    field("revision", Json.Int(self.revision)),
                    field(
                        "fields",
                        Json
                            .Obj(
                                [field(
                                    f.property,
                                    Json
                                        .Arr(
                                            [Json
                                                .Obj(
                                                    [
                                                        field("claim", Json.Int(c.claim)),
                                                        field("value", as_json(c.value)),
                                                        field("chosen", Json.Bool(c.chosen)),
                                                        field("denied", Json.Bool(c.denied)),
                                                    ],
                                                ) for c in f.candidates],
                                        ),
                                ) for f in self.fields],
                            ),
                    ),
                    field(
                        "qualified",
                        Json
                            .Arr(
                                [Json
                                    .Obj(
                                        [
                                            field("claim", Json.Int(q.claim)),
                                            field("property", Json.Str(q.property)),
                                            field("value", as_json(q.value)),
                                            field("factuality", Json.Str(q.factuality)),
                                            field("speech_act", Json.Str(q.speech_act)),
                                        ],
                                    ) for q in self.qualified],
                            ),
                    ),
                ],
            )
    }
}

/// Legacy support is asserted as certainly true, with no anchor or voice.
/// Each of `anchors` is one passage in the Answer contract's Citation shape:
/// its selectors are alternative descriptions of that one passage.
fn qualifiers(evidence: EvidenceRow?, s: SupportRow, revision: int) -> Result<List<Field>, string> {
    let e? = evidence else {
        return [
            field("factuality", Json.Str("CT+")),
            field("speech_act", Json.Str("assert")),
            field("anchors", Json.Arr([])),
            field("normalization", Json.Null),
            field("author", Json.Null),
            field("audience", Json.Null),
        ]
    }
    let document = match parse(e.evidence) {
        .Ok(j) -> j,
        .Err(_) -> { fail "stored evidence is not JSON" },
    }
    let source = Json
        .Obj(
            [
                field("observation", Json.Str(s.run.input.name)),
                field("revision", Json.Int(revision)),
            ],
        )
    let audience = match e.voice.audience {
        text? -> match parse(text) {
            .Ok(j) -> j,
            .Err(_) -> { fail "stored audience is not JSON" },
        }
        null -> Json.Null
    }
    [
        field("factuality", Json.Str(e.factuality)),
        field("speech_act", Json.Str(e.speech_act)),
        field(
            "anchors",
            Json
                .Arr(
                    [Json
                        .Obj(
                            [
                                field("source", source),
                                field("frame", optional_text(e.voice.frame)),
                                field("speaker", optional_text(e.voice.speaker)),
                                field("selectors", passage.member("selector")),
                            ],
                        ) for passage in document.member("evidence").items()],
                ),
        ),
        field("normalization", document.member("normalization")),
        field("author", optional_text(e.voice.author)),
        field("audience", audience),
    ]
}

fn optional_int(n: int?) -> Json {
    let found? = n else { return Json.Null }
    Json.Int(found)
}

/// Each distinct qualified statement once, in standing order.
fn qualified_of(standing: List<Standing>) -> Result<List<Qualified>, string> {
    let rows = [Qualified {
        claim: s.claim.id,
        property: s.claim.property,
        value: stored_value(s.claim.value)?,
        factuality: e.factuality,
        speech_act: e.speech_act,
    } for s in standing if !s.plain() for e in [s.evidence!]]
    [q for i, q in rows if !rows
        .slice(0, i)
        .any(it.claim == q.claim && it.factuality == q.factuality && it.speech_act == q.speech_act)]
}

export fn stored_value(text: string) -> Result<Value, string> {
    match parse(text) {
        .Ok(j) -> as_value(j),
        .Err(_) -> { fail "stored graph value is not JSON" },
    }
}

fn page_ok(limit: int, offset: int) -> Result<int, string> {
    if limit < 1 || limit > 1000 || offset < 0 { fail "limit must be 1..1000 and offset nonnegative" }
    if offset > 9223372036854775807 - limit { fail "page end exceeds the integer range" }
    0
}
