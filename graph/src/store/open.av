use @std.sqlite.{Db, OpenConfig, Mode, sql, SqlValue}
use @std.sqlite.error.{SqlError}
use @std.db.error.{ModelError}
use @std.errors.{Error}
use @std.text.{parse_int}
use catalog.{Catalog}
use schema.{Registration}
use policy.{DerivationRegistration}
use store.engine.{
    Meta,
    Schema,
    EntityRow,
    ObservationRow,
    ObservationVersionRow,
    RunRow,
    RunTrailRow,
    ClaimRow,
    SupportRow,
    EdgeRow,
    ConfidenceRow,
    AliasRow,
    MergeRow,
    MergeEndRow,
    ChoiceRow,
    ChoiceEndRow,
    TombstoneRow,
    TombstoneEndRow,
    VoiceRow,
    EvidenceRow,
    SupersessionRow,
    CorrectionRow,
    CorrectionEndRow,
    FailedRunRow,
    InputEpochRow,
    SchemaEdgeRow,
    ClaimRetiredRow,
}
use data.{digest}
use store.policy.{EnginePolicy}
use store.evidence.{Instant}
use parameters.{storage_formats}

/// One connection, the immutable model catalog this process was built with,
/// the policy its host declares, and the view reads take: current unless
/// it names an earlier graph revision or a valid-time instant.
export type Graph = {
    db: Db,
    catalog: Catalog,
    policy: EnginePolicy = EnginePolicy {},
    view: ReadView = ReadView {},
}

/// What a read sees. `revision` reads the graph as it stood then
/// (transaction time); `valid_at` keeps only statements valid at that
/// instant (valid time). Both null is the current view.
export type ReadView = { revision: int? = null, valid_at: Instant? = null }

enum CatalogUse { Install, Existing }

impl Graph {
    /// Attach without installing a model catalog; the tables must stand.
    static fn attach(
        path: string,
        registrations: List<Registration>,
        derived: List<DerivationRegistration> = [],
        policy: EnginePolicy = EnginePolicy {},
    ) -> Result<Graph, string> {
        let catalog = Catalog.collected(registrations, derived)?
        let db = stored(Db.open_with(OpenConfig.config_at(path) with { mode: Mode.OpenExisting }))?
        Graph.admitted(db, catalog, CatalogUse.Existing, policy)
    }

    static fn memory(
        registrations: List<Registration>,
        derived: List<DerivationRegistration> = [],
        policy: EnginePolicy = EnginePolicy {},
    ) -> Result<Graph, string> {
        let catalog = Catalog.collected(registrations, derived)?
        let db = stored(Db.memory())?
        Graph.admitted(db, catalog, CatalogUse.Install, policy)
    }

    static fn open(
        path: string,
        registrations: List<Registration>,
        derived: List<DerivationRegistration> = [],
        policy: EnginePolicy = EnginePolicy {},
    ) -> Result<Graph, string> {
        let catalog = Catalog.collected(registrations, derived)?
        let db = stored(Db.open(path))?
        Graph.admitted(db, catalog, CatalogUse.Install, policy)
    }

    static fn admitted(db: Db, catalog: Catalog, mode: CatalogUse, policy: EnginePolicy) -> Result<
        Graph,
        string,
    > {
        let graph = Graph { db: db, catalog: catalog, policy: policy }
        let outcome = graph.prepared(mode)
        match outcome {
            .Ok(_) -> graph,
            .Err(e) -> {
                let _ = db.close()
                fail e
            },
        }
    }

    fn close() -> int { self.db.close() }

    fn prepared(mode: CatalogUse) -> Result<int, string> {
        stored(self.db.scalar(sql("PRAGMA busy_timeout=3000")))?
        match mode { .Install -> self.initialize()?, .Existing -> self.current()? }
        match stored(self.db.scalar(sql("PRAGMA journal_mode=WAL")))? {
            .Text("wal") or .Text("memory") -> {},
            rest -> { fail "graph storage could not enable WAL" },
        }
        self.revision()
    }

    /// Nested reads borrow their caller's transaction; only the owner ends it.
    fn read_snapshot() -> Result<bool, string> {
        if self.db.in_transaction() { return false }
        stored(self.db.begin_read())?
        true
    }

    /// Every engine table is a model's own DDL; nothing here spells SQL.
    fn initialized() -> Result<int, string> {
        mut db = self.db
        stored(Meta.create_table(db))?
        stored(Schema.create_table(db))?
        stored(EntityRow.create_table(db))?
        stored(ObservationRow.create_table(db))?
        stored(ObservationVersionRow.create_table(db))?
        stored(RunRow.create_table(db))?
        stored(RunTrailRow.create_table(db))?
        stored(ClaimRow.create_table(db))?
        stored(SupportRow.create_table(db))?
        stored(ConfidenceRow.create_table(db))?
        stored(EdgeRow.create_table(db))?
        stored(AliasRow.create_table(db))?
        stored(MergeRow.create_table(db))?
        stored(MergeEndRow.create_table(db))?
        stored(ChoiceRow.create_table(db))?
        stored(ChoiceEndRow.create_table(db))?
        stored(TombstoneRow.create_table(db))?
        stored(TombstoneEndRow.create_table(db))?
        stored(VoiceRow.create_table(db))?
        stored(EvidenceRow.create_table(db))?
        stored(SupersessionRow.create_table(db))?
        stored(CorrectionRow.create_table(db))?
        stored(CorrectionEndRow.create_table(db))?
        stored(FailedRunRow.create_table(db))?
        stored(InputEpochRow.create_table(db))?
        stored(SchemaEdgeRow.create_table(db))?
        stored(ClaimRetiredRow.create_table(db))?
        0
    }

    fn initialize() -> Result<int, string> {
        mut db = self.db
        stored(db.begin())?
        defer { let _ = db.finish() }
        let existing = self.has_table("Meta")?
        if !existing && self.has_table("graph_meta")? { fail "old hand-table graph store; migration is required; keep the original file" }
        if !existing && self.has_table("EntityRow")? { fail "graph storage is missing its metadata table" }
        let previous = if existing { self.meta("format")? } else { "" }
        if existing && !storage_formats.contains(previous) {
            fail "unsupported graph storage format: ${previous}"
        }
        if existing {
            self.revision()?
            if (self.meta("schema")?).is_empty() { fail "graph storage is missing its catalog fingerprint" }
        }
        self.initialized()?
        if !existing {
            modeled(Meta { key: "revision", value: "0" }.insert(db))?
        }
        // Formats 7 to 13 only add tables. Install them and advance the marker
        // atomically; never rewrite evidence or silently adopt a future format.
        if previous != format { put_meta(db, "format", format)? }
        if (stored(Schema.where(db, fingerprint: self.catalog.fingerprint))?).is_empty() {
            modeled(
                Schema { fingerprint: self.catalog.fingerprint, document: self.catalog.document }
                    .insert(db),
            )?
        }
        let installed = self.meta("schema")?
        if installed != self.catalog.fingerprint {
            if existing { self.evolved(db, installed)? }
            put_meta(db, "schema", self.catalog.fingerprint)?
            self.advanced()?
        }
        stored(db.commit())?
        self.revision()
    }

    fn current() -> Result<int, string> {
        let found = self.meta("format")?
        if found != format { fail "unsupported graph storage format: ${found}; open with a compatible engine to upgrade" }
        if self.meta("schema")? != self.catalog.fingerprint { fail "schema changed; reopen with the current models" }
        self.revision()
    }

    /// Catalog inspection is infrastructure, never an ontology-specific query.
    fn has_table(name: string) -> Result<bool, string> {
        match stored(
            self
                .db
                .scalar(
                    sql(
                        "SELECT count(*) FROM sqlite_master WHERE type='table' AND name=?",
                        [.Text(name)],
                    ),
                ),
        )? { .Int(n) -> n > 0, rest -> { fail "storage catalog count is not an integer" } }
    }

    fn meta(key: string) -> Result<string, string> {
        match stored(Meta.where(self.db, key: key))? {
            [only] -> only.value,
            [] -> "",
            rest -> { fail "graph metadata key is not unique: ${key}" },
        }
    }

    fn revision() -> Result<int, string> {
        let value? = parse_int(self.meta("revision")?) else { fail "graph revision is not an integer" }
        value
    }

    fn advanced() -> Result<int, string> {
        if self.view.revision != null || self.view.valid_at != null { fail "a historical view cannot write" }
        mut db = self.db
        let next = self.revision()? + 1
        put_meta(db, "revision", "${next}")?
        next
    }

    /// Identical input is a no-op; changed input invalidates its old interpretations.
    fn observe(id: string, payload: string) -> Result<int, string> {
        let db = self.db
        stored(db.begin())?
        defer { let _ = db.finish() }
        self.current()?
        let next = self.observed(id, payload)?
        stored(db.commit())?
        next
    }

    /// Store an observation within its caller's write transaction.
    fn observed(id: string, payload: string) -> Result<int, string> {
        if !self.db.in_transaction() { fail "observation update needs its owner's transaction" }
        if id.is_empty() { fail "an observation needs a nonempty id" }
        mut db = self.db
        let old = stored(ObservationRow.where(db, name: id))?
        let next = match old {
            [only] -> {
                if only.digest == digest(payload) { return only.revision }
                let revision = only.revision + 1
                modeled(
                    (only with { revision: revision, payload: payload, digest: digest(payload) })
                        .update(db),
                )?
                revision
            },
            [] -> {
                let made = modeled(
                    ObservationRow {
                        name: id,
                        revision: 1,
                        payload: payload,
                        digest: digest(payload),
                    }
                        .insert(db),
                )?
                modeled(
                    ObservationVersionRow {
                        observation: made,
                        revision: 1,
                        payload: payload,
                        stamp: digest("${id}\t1"),
                    }
                        .insert(db),
                )?
                1
            },
            rest -> { fail "observation name is not unique: ${id}" },
        }
        if next > 1 {
            let row = match stored(ObservationRow.where(db, name: id))? {
                [only] -> only,
                rest -> { fail "observation vanished" },
            }
            modeled(
                ObservationVersionRow {
                    observation: row,
                    revision: next,
                    payload: payload,
                    stamp: digest("${id}\t${next}"),
                }
                    .insert(db),
            )?
        }
        self.advanced()?
        let made = self.observation_row(id)?
        let _ = modeled(
            InputEpochRow { observation: made, revision: next, at: self.revision()? }.insert(db),
        )?
        next
    }
}

/// The storage format this engine writes.
const format = storage_formats.last()!

export fn put_meta(mut db: Db, key: string, value: string) -> Result<int, string> {
    match stored(Meta.where(db, key: key))? {
        [only] -> { let _ = modeled((only with { value: value }).update(db))? },
        [] -> { let _ = modeled(Meta { key: key, value: value }.insert(db))? },
        rest -> { fail "graph metadata key is not unique: ${key}" },
    }
    0
}

export fn stored<T>(answer: Result<T, SqlError>) -> Result<T, string> {
    match answer { .Ok(value) -> value, .Err(e) -> { fail why(e) } }
}

fn why(e: SqlError) -> string {
    let at = match e.sql {
        q? -> " — ${q}"
        null -> ""
    }
    "storage: ${e.cause.kind()}: ${e.message}${at}"
}

export fn modeled<T>(answer: Result<T, ModelError>) -> Result<T, string> {
    match answer {
        .Ok(value) -> value,
        .Err(.Other(sql)) or .Err(.Unique(_, _, sql)) or .Err(.Ambiguous(_, _, sql)) or .Err(.Referenced(_, sql)) -> {
            fail why(sql)
        },
        .Err(.Invalid(issues)) -> { fail issues.report() },
    }
}
