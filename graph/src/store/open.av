use @std.sqlite.{Db, Row, SqlValue, sql, OpenConfig, Mode}
use @std.sqlite.error.{SqlError}
use @std.json.{Json, parse}
use catalog.{Catalog}
use schema.{Registration}
use store.tables.{ddl}
use data.{digest}

/// One connection and the immutable model catalog this process was built with.
export type Graph = { db: Db, catalog: Catalog }

enum CatalogUse { Install, Existing }

impl Graph {
    /// Attach without changing the installed schema.
    static fn attach(path: string, registrations: List<Registration>) -> Result<Graph, string> {
        let catalog = Catalog.collected(registrations)?
        let db = storage(Db.open_with(OpenConfig.config_at(path) with { mode: Mode.OpenExisting }))?
        Graph.admitted(db, catalog, CatalogUse.Existing)
    }

    static fn memory(registrations: List<Registration>) -> Result<Graph, string> {
        let catalog = Catalog.collected(registrations)?
        let db = storage(Db.memory())?
        Graph.admitted(db, catalog, CatalogUse.Install)
    }

    static fn open(path: string, registrations: List<Registration>) -> Result<Graph, string> {
        let catalog = Catalog.collected(registrations)?
        let db = storage(Db.open(path))?
        Graph.admitted(db, catalog, CatalogUse.Install)
    }

    static fn admitted(db: Db, catalog: Catalog, mode: CatalogUse) -> Result<Graph, string> {
        mut graph = Graph { db: db, catalog: catalog }
        let outcome = match mode { .Install -> graph.initialize(), .Existing -> graph.current() }
        match outcome {
            .Ok(_) -> graph,
            .Err(e) -> {
                let _ = db.close()
                fail e
            },
        }
    }

    fn close() -> int { self.db.close() }

    fn execute(text: string, values: List<SqlValue> = []) -> Result<int, string> {
        storage(self.db.run(sql(text, values)))
    }

    fn rows(text: string, values: List<SqlValue> = []) -> Result<List<Row>, string> {
        storage(self.db.all(sql(text, values)))
    }

    fn revision() -> Result<int, string> {
        let row = self.rows("SELECT CAST(value AS INTEGER) FROM graph_meta WHERE key='revision'")?[0]
        cell_int(row, 0)
    }

    fn advance() -> Result<int, string> {
        self.execute("UPDATE graph_meta SET value=CAST(value AS INTEGER)+1 WHERE key='revision'")?
        self.revision()
    }

    fn current() -> Result<int, string> {
        let rows = self.rows("SELECT value FROM graph_meta WHERE key='schema'")?
        if rows.is_empty() || cell_text(rows[0], 0)? != self.catalog.fingerprint { fail "schema changed; reopen with the current models" }
        self.revision()
    }

    fn initialize() -> Result<int, string> {
        self.execute("PRAGMA foreign_keys=ON")?
        self.rows("PRAGMA busy_timeout=3000")?
        self.rows("PRAGMA journal_mode=WAL")?
        storage(self.db.begin())?
        defer { let _ = self.db.finish() }
        self.execute(ddl[0])?
        let version = self.rows("SELECT value FROM graph_meta WHERE key='format'")?
        if !version.is_empty() && cell_text(version[0], 0)? != "1" { fail "unsupported graph storage format" }
        for text in ddl { self.execute(text)? }
        self.execute("INSERT OR IGNORE INTO graph_meta VALUES ('format', '1')")?
        self
            .execute(
                "INSERT OR IGNORE INTO schemas VALUES (?, ?)",
                [.Text(self.catalog.fingerprint), .Text(self.catalog.document)],
            )?
        let old = self.rows("SELECT value FROM graph_meta WHERE key='schema'")?
        if old.is_empty() || cell_text(old[0], 0)? != self.catalog.fingerprint {
            self
                .execute(
                    "INSERT INTO graph_meta VALUES ('schema', ?) ON CONFLICT(key) DO UPDATE SET value=excluded.value",
                    [.Text(self.catalog.fingerprint)],
                )?
            self.advance()?
        }
        storage(self.db.commit())?
        self.revision()
    }

    /// Identical input is a no-op; changed input invalidates its old interpretations.
    fn observe(id: string, payload: string) -> Result<int, string> {
        if id.is_empty() { fail "an observation needs a nonempty id" }
        storage(self.db.begin())?
        defer { let _ = self.db.finish() }
        self.current()?
        let old = self.rows("SELECT revision, digest FROM observations WHERE id=?", [.Text(id)])?
        if !old.is_empty() && cell_text(old[0], 1)? == digest(payload) { return cell_int(old[0], 0) }
        let next = if old.is_empty() { 1 } else { cell_int(old[0], 0)? + 1 }
        self
            .execute(
                "INSERT INTO observation_versions VALUES (?, ?, ?)",
                [.Text(id), .Int(next), .Text(payload)],
            )?
        self
            .execute(
                "INSERT INTO observations VALUES (?, ?, ?, ?) ON CONFLICT(id) DO UPDATE SET revision=excluded.revision, payload=excluded.payload, digest=excluded.digest",
                [.Text(id), .Int(next), .Text(payload), .Text(digest(payload))],
            )?
        self.advance()?
        storage(self.db.commit())?
        next
    }
}

export fn cell_text(row: Row, index: int) -> Result<string, string> {
    storage(row.text(index))
}

export fn cell_int(row: Row, index: int) -> Result<int, string> {
    storage(row.int(index))
}

export fn storage<T>(answer: Result<T, SqlError>) -> Result<T, string> {
    match answer { .Ok(value) -> value, .Err(e) -> { fail "storage: ${e.message}" } }
}
