use store.open.{Graph, stored}
use data.{before}
use store.engine.{
    EntityRow,
    ClaimRow,
    SupportRow,
    RunRow,
    RunTrailRow,
    MergeRow,
    MergeEndRow,
    TombstoneRow,
    TombstoneEndRow,
    EvidenceRow,
    SupersessionRow,
}
use store.evidence.{Polarity, Modality, plain, denial, polarity_named, modality_named}

/// Two entities an active merge joins.
export type MergeEdge = { left: string, right: string }

/// One claim standing under an active scheme and input revision, with the
/// field evidence it was published with; none is a legacy plain assertion.
export type Standing = { claim: ClaimRow, support: SupportRow, evidence: EvidenceRow? }

impl Standing {
    /// Affirmed and asserted, the only kind a current read returns as a value.
    fn plain() -> bool { judged(self.evidence, plain, true) }

    /// An asserted denial of this claim.
    fn denies() -> bool { judged(self.evidence, denial, false) }
}

/// A test of stored qualifiers. Legacy support answers `legacy`; stored
/// words outside the vocabulary answer false.
export fn judged(evidence: EvidenceRow?, test: fn(Polarity, Modality) -> bool, legacy: bool) -> bool {
    let e? = evidence else { return legacy }
    worded(e, test) catch false
}

fn worded(e: EvidenceRow, test: fn(Polarity, Modality) -> bool) -> Result<bool, string> {
    test(polarity_named(e.polarity)?, modality_named(e.modality)?)
}

impl Graph {
    fn entity_named(name: string) -> Result<EntityRow, string> {
        let found = stored(EntityRow.where(self.db, name: name))?
        match found {
            [only] -> only,
            [] -> { fail "unknown entity: ${name}" },
            rest -> { fail "entity name is not unique: ${name}" },
        }
    }

    fn entities_named(names: List<string>) -> Result<List<EntityRow>, string> {
        [e for name in names for e in stored(EntityRow.where(self.db, name: name))?]
    }

    fn claims_of(entities: List<EntityRow>) -> Result<List<ClaimRow>, string> {
        [claim for claims in stored(EntityRow.with_claims(self.db, entities))? for claim in claims]
    }

    fn trail_of(trails: List<RunTrailRow>, run: int) -> RunTrailRow? {
        trails.find(it.run.id == run)
    }

    /// Claims whose support still stands: not withdrawn, under the current
    /// schema and the input revision the run actually read.
    fn standing(claims: List<ClaimRow>) -> Result<List<Standing>, string> {
        let supports = stored(SupportRow.in_claim(self.db, claims))?
        let trails = stored(RunTrailRow.in_run(self.db, supports.map(it.run)))?
        let scheme = self.catalog.fingerprint
        let live = [s for s in supports if self.upheld(s, trails, scheme)]
        let evidence = stored(EvidenceRow.in_support(self.db, live))?
        [Standing { claim: s.claim, support: s, evidence: evidence.find(it.support.id == s.id) } for s in live]
    }

    /// Current facts: standing plain claims no standing newer claim supersedes.
    fn facts(claims: List<ClaimRow>) -> Result<List<Standing>, string> { self.held(self.standing(claims)?) }

    /// The facts among standing claims.
    fn held(live: List<Standing>) -> Result<List<Standing>, string> {
        let closed = self.superseded(live.map(it.support))?
        [s for s in live if s.plain() && !closed.contains(s.support.id)]
    }

    /// Supports a still-standing newer claim has closed, by support id.
    fn superseded(supports: List<SupportRow>) -> Result<List<int>, string> {
        let rows = stored(SupersessionRow.in_old(self.db, supports))?
        let trails = stored(RunTrailRow.in_run(self.db, rows.map(it.new.run)))?
        let scheme = self.catalog.fingerprint
        [r.old.id for r in rows if self.upheld(r.new, trails, scheme)]
    }

    /// Not withdrawn, under the current schema and its run's current input.
    fn upheld(s: SupportRow, trails: List<RunTrailRow>, scheme: string) -> bool {
        s.until == null && s.claim.schema == scheme && self.stands(s, trails, scheme)
    }

    fn stands(s: SupportRow, trails: List<RunTrailRow>, scheme: string) -> bool {
        let trail? = self.trail_of(trails, s.run.id) else { return false }
        trail.schema == scheme && trail.input_revision == s.run.input.revision
    }

    /// The active merge decisions as undirected edges over entity names.
    fn merge_edges() -> Result<List<MergeEdge>, string> {
        let ended = stored(MergeEndRow.all(self.db))?
        [MergeEdge { left: m.left.name, right: m.right.name } for m in stored(MergeRow.all(self.db))? if !ended.any(it.merge.id == m.id)]
    }

    fn merge_pair(a: string, b: string, edges: List<MergeEdge>) -> bool {
        edges.any((e: MergeEdge) -> e.left == a && e.right == b || e.left == b && e.right == a)
    }

    /// Every entity the group holding `name` contains, `name` first.
    fn group(name: string) -> Result<List<string>, string> {
        let edges = self.merge_edges()?
        self.reached([name], edges)
    }

    /// The group's stable name: its least entity name.
    fn root(name: string) -> Result<string, string> {
        mut least = name
        for member in self.group(name)? {
            if before(member, least) { least = member }
        }
        least
    }

    fn reached(seen: List<string>, edges: List<MergeEdge>) -> Result<List<string>, string> {
        mut found = seen
        mut frontier = seen
        while !frontier.is_empty() {
            let next = [other for from in frontier for e in edges if e.left == from || e.right == from for other in [if e.left == from { e.right } else { e.left }] if !found.contains(other)]
            found = found.concat(next)
            frontier = next
        }
        found
    }

    /// The active tombstone roots, by entity name.
    fn tombstone_names() -> Result<List<string>, string> {
        let ended = stored(TombstoneEndRow.all(self.db))?
        [t.entity.name for t in stored(TombstoneRow.all(self.db))? if !ended.any(it.tombstone.id == t.id)]
    }

    /// Every entity a live tombstone hides, its group included.
    fn hidden_members() -> Result<List<string>, string> {
        self.reached(self.tombstone_names()?, self.merge_edges()?)
    }

    fn hidden(name: string) -> Result<bool, string> {
        (self.hidden_members()?).contains(name)
    }
}
