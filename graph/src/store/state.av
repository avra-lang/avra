use store.open.{Graph, stored}
use data.{before}
use store.engine.{
    EntityRow,
    ClaimRow,
    SupportRow,
    RunRow,
    RunTrailRow,
    MergeRow,
    MergeEndRow,
    TombstoneRow,
    TombstoneEndRow,
    EvidenceRow,
    SupersessionRow,
    ObservationRow,
    InputEpochRow,
}
use store.evidence.{
    Factuality,
    SpeechAct,
    Interval,
    plain,
    denial,
    factuality_named,
    speech_act_named,
}

/// What a support's standing is judged against: its run's trail, the
/// input revisions current in the view, and the installed schema.
export type Footing = { trails: List<RunTrailRow>, epochs: List<InputEpochRow>, scheme: string }

/// Two entities an active merge joins.
export type MergeEdge = { left: string, right: string }

/// One claim standing under an active scheme and input revision, with the
/// field evidence it was published with; none is a legacy plain assertion.
export type Standing = { claim: ClaimRow, support: SupportRow, evidence: EvidenceRow? }

impl Standing {
    /// Affirmed and asserted, the only kind a current read returns as a value.
    fn plain() -> bool { judged(self.evidence, plain, true) }

    /// An asserted denial of this claim.
    fn denies() -> bool { judged(self.evidence, denial, false) }
}

/// A test of stored qualifiers. Legacy support answers `legacy`; stored
/// words outside the vocabulary answer false.
export fn judged(evidence: EvidenceRow?, test: fn(Factuality, SpeechAct) -> bool, legacy: bool) -> bool {
    let e? = evidence else { return legacy }
    worded(e, test) catch false
}

fn worded(e: EvidenceRow, test: fn(Factuality, SpeechAct) -> bool) -> Result<bool, string> {
    test(factuality_named(e.factuality)?, speech_act_named(e.speech_act)?)
}

impl Graph {
    fn entity_named(name: string) -> Result<EntityRow, string> {
        let found = stored(EntityRow.where(self.db, name: name))?
        match found {
            [only] -> only,
            [] -> { fail "unknown entity: ${name}" },
            rest -> { fail "entity name is not unique: ${name}" },
        }
    }

    fn entities_named(names: List<string>) -> Result<List<EntityRow>, string> {
        [e for name in names for e in stored(EntityRow.where(self.db, name: name))?]
    }

    fn claims_of(entities: List<EntityRow>) -> Result<List<ClaimRow>, string> {
        [claim for claims in stored(EntityRow.with_claims(self.db, entities))? for claim in claims]
    }

    fn trail_of(trails: List<RunTrailRow>, run: int) -> RunTrailRow? {
        trails.find(it.run.id == run)
    }

    /// Claims whose support stands in the view: published by then, not yet
    /// withdrawn, under the installed schema and the input revision then
    /// current.
    fn standing(claims: List<ClaimRow>) -> Result<List<Standing>, string> {
        let supports = stored(SupportRow.in_claim(self.db, claims))?
        let footing = self.footing(supports.map(it.run))?
        let live = [s for s in supports if self.upheld(s, footing)]
        let evidence = stored(EvidenceRow.in_support(self.db, live))?
        [Standing { claim: s.claim, support: s, evidence: evidence.find(it.support.id == s.id) } for s in live]
    }

    /// Current facts: standing plain claims no standing newer claim supersedes.
    fn facts(claims: List<ClaimRow>) -> Result<List<Standing>, string> { self.held(self.standing(claims)?) }

    /// The facts among standing claims.
    fn held(live: List<Standing>) -> Result<List<Standing>, string> {
        let closed = self.superseded(live.map(it.support))?
        let unclosed = [s for s in live if !closed.contains(s.support.id)]
        let open = if self.view.valid_at == null {
            unclosed
        } else {
            [s for s in unclosed for span in [self.valid_time(s.support)?] if self.valid_in_view(span)]
        }
        [s for s in open if s.plain() && self.prevails(s, open)]
    }

    /// A producer's declared rank.
    fn rank(producer: string) -> int { self.policy.rank(producer) }

    /// The highest rank among statements that pass `test`, or -1.
    fn top(live: List<Standing>, test: fn(Standing) -> bool) -> int {
        [self.rank(s.support.run.producer) for s in live if test(s)].max() ?? -1
    }

    /// A plain claim prevails when its best support ranks with the property's
    /// best plain support and no denial of it ranks higher.
    fn prevails(s: Standing, live: List<Standing>) -> bool {
        let best = self.top(live, (o: Standing) -> o.claim.id == s.claim.id && o.plain())
        let property = self
            .top(live, (o: Standing) -> o.claim.property == s.claim.property && o.plain())
        let denied = self.top(live, (o: Standing) -> o.claim.id == s.claim.id && o.denies())
        best == property && !self.policy.removes(denied, best)
    }

    /// Supports a still-standing newer claim has closed, by support id.
    /// In a valid-time view, only once the closing claim's start has come.
    fn superseded(supports: List<SupportRow>) -> Result<List<int>, string> {
        let rows = stored(SupersessionRow.in_old(self.db, supports))?
        let footing = self.footing(rows.map(it.new.run))?
        let closing = [r for r in rows if self.upheld(r.new, footing)]
        if self.view.valid_at == null { return closing.map(it.old.id) }
        [r.old.id for r in closing for span in [self.valid_time(r.new)?] if self.begun_in_view(span)]
    }

    fn footing(runs: List<RunRow>) -> Result<Footing, string> {
        let epochs = if self.view.revision == null {
            []
        } else {
            stored(InputEpochRow.in_observation(self.db, runs.map(it.input)))?
        }
        Footing {
            trails: stored(RunTrailRow.in_run(self.db, runs))?,
            epochs: epochs,
            scheme: self.catalog.fingerprint,
        }
    }

    /// Standing in the view, under the installed schema and its run's input.
    fn upheld(s: SupportRow, f: Footing) -> bool {
        self.in_view(s.run.revision, s.until) && s.claim.schema == f.scheme && self.stands(s, f)
    }

    fn stands(s: SupportRow, f: Footing) -> bool {
        let trail? = self.trail_of(f.trails, s.run.id) else { return false }
        trail.schema == f.scheme &&
            trail.input_revision == self.input_revision(s.run.input, f.epochs)
    }

    /// The revision a read answers for: the view's, or the current one.
    fn read_revision() -> Result<int, string> {
        let current = self.revision()?
        self.view.revision ?? current
    }

    /// Whether something decided at `from` and ended at `until` (null: never)
    /// stands in the view.
    fn in_view(from: int, until: int?) -> bool {
        let at? = self.view.revision else { return until == null }
        from <= at && (until == null || until! > at)
    }

    /// An input's revision current in the view. Revisions observed before
    /// epochs were recorded count from before the earliest recorded one.
    fn input_revision(input: ObservationRow, epochs: List<InputEpochRow>) -> int {
        let at? = self.view.revision else { return input.revision }
        let known = epochs.filter(it.observation.id == input.id)
        if known.is_empty() { return input.revision }
        [e.revision for e in known if e.at <= at].max() ?? (known.map(it.revision).min() ?? 1) - 1
    }

    /// Whether a declared interval holds the view's valid-time instant.
    fn valid_in_view(span: Interval) -> bool {
        let t? = self.view.valid_at else { return true }
        span.holds(t)
    }

    /// Whether a declared start has come by the view's valid-time instant.
    fn begun_in_view(span: Interval) -> bool {
        let t? = self.view.valid_at else { return true }
        let start? = span.from else { return true }
        !t.before(start)
    }

    /// The active merge decisions as undirected edges over entity names.
    fn merge_edges() -> Result<List<MergeEdge>, string> {
        let ended = stored(MergeEndRow.all(self.db))?
        [MergeEdge { left: m.left.name, right: m.right.name } for m in stored(MergeRow.all(self.db))? if self.in_view(m.revision, ended.find(it.merge.id == m.id)?.until)]
    }

    fn merge_pair(a: string, b: string, edges: List<MergeEdge>) -> bool {
        edges.any((e: MergeEdge) -> e.left == a && e.right == b || e.left == b && e.right == a)
    }

    /// Every entity the group holding `name` contains, `name` first.
    fn group(name: string) -> Result<List<string>, string> {
        let edges = self.merge_edges()?
        self.reached([name], edges)
    }

    /// The group's stable name: its least entity name.
    fn root(name: string) -> Result<string, string> {
        mut least = name
        for member in self.group(name)? {
            if before(member, least) { least = member }
        }
        least
    }

    fn reached(seen: List<string>, edges: List<MergeEdge>) -> Result<List<string>, string> {
        mut found = seen
        mut frontier = seen
        while !frontier.is_empty() {
            let next = [other for from in frontier for e in edges if e.left == from || e.right == from for other in [if e.left == from { e.right } else { e.left }] if !found.contains(other)]
            found = found.concat(next)
            frontier = next
        }
        found
    }

    /// The active tombstone roots, by entity name.
    fn tombstone_names() -> Result<List<string>, string> {
        let ended = stored(TombstoneEndRow.all(self.db))?
        [t.entity.name for t in stored(TombstoneRow.all(self.db))? if self.in_view(t.revision, ended.find(it.tombstone.id == t.id)?.until)]
    }

    /// Every entity a live tombstone hides, its group included.
    fn hidden_members() -> Result<List<string>, string> {
        self.reached(self.tombstone_names()?, self.merge_edges()?)
    }

    fn hidden(name: string) -> Result<bool, string> {
        (self.hidden_members()?).contains(name)
    }
}
