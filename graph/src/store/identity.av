use @std.json.{Json, field}
use store.open.{Graph, stored}
use store.engine.{AliasRow, RunTrailRow}

/// A producer's name for an entity, in its own namespace.
export type Identity = { namespace: string, external_key: string }

impl Identity {
    fn json() -> Json {
        Json
            .Obj(
                [
                    field("namespace", Json.Str(self.namespace)),
                    field("key", Json.Str(self.external_key)),
                ],
            )
    }
}

impl Graph {
    /// Active entities an external identity names, in entity order.
    fn bound(namespace: string, key: string) -> Result<List<string>, string> {
        let aliases = stored(AliasRow.where(self.db, namespace: namespace, key: key))?
        let trails = stored(RunTrailRow.in_run(self.db, aliases.map(it.run)))?
        [a.entity.name for i, a in aliases if self.alias_stands(a, trails) && !aliases.slice(0, i).any(it.entity.name == a.entity.name)]
    }

    fn alias_stands(a: AliasRow, trails: List<RunTrailRow>) -> bool {
        if a.until != null { return false }
        let trail? = self.trail_of(trails, a.run.id) else { return false }
        trail.schema == self.catalog.fingerprint && trail.input_revision == a.run.input.revision
    }

    /// The one entity an external identity names.
    fn resolve(namespace: string, key: string) -> Result<string, string> {
        self.current()?
        let hidden = self.hidden_members()?
        match self.bound(namespace, key)? {
            [] -> { fail "unknown identity: ${namespace}/${key}" },
            [only] -> if hidden.contains(only) { fail "identity names a tombstoned entity: ${namespace}/${key}" } else { only },
            rest -> { fail "identity names more than one entity: ${namespace}/${key}" },
        }
    }

    /// The active external identities of an entity and its group.
    fn aliases(id: string) -> Result<List<Identity>, string> {
        self.current()?
        if self.hidden(id)? { fail "entity is tombstoned: ${id}" }
        let entities = self.entities_named(self.group(id)?)?
        let rows = stored(AliasRow.in_entity(self.db, entities))?
        let trails = stored(RunTrailRow.in_run(self.db, rows.map(it.run)))?
        [Identity { namespace: a.namespace, external_key: a.key } for i, a in rows if self.alias_stands(a, trails) &&
            !rows.slice(0, i).any(it.namespace == a.namespace && it.key == a.key)]
    }
}
