use @std.validate.{Value, Entry}
use @std.json.{Json, Field, field, to_text}
use schema.{Shape}
use catalog.{Catalog}
use data.{as_json, encoded, digest, json_safe}
use store.open.{Graph, storage, cell_text, cell_int}
use store.identity.{Identity}

export enum RecordMode { Complete, Partial }

export type Record = {
    id: string,
    model: string,
    value: Value,
    mode: RecordMode = .Complete,
    locator: Value = Value.Null,
    identities: List<Identity> = [],
}

impl Record {
    fn request_value() -> Json {
        let fields = [
            field("id", Json.Str(self.id)),
            field("model", Json.Str(self.model)),
            field("value", as_json(self.value)),
        ]
        let mode = match self.mode {
            .Complete -> [],
            .Partial -> [field("mode", Json.Str("partial"))],
        }
        Json
            .Obj(
                fields
                    .concat(mode)
                    .concat(located(self.locator))
                    .concat(identified(self.identities)),
            )
    }
}

/// No identity means no field, so an identity-free run keeps its identity.
fn identified(identities: List<Identity>) -> List<Field> {
    if identities.is_empty() { [] } else { [field("identities", Json.Arr([i.json() for i in identities]))] }
}

/// An absent locator is not part of the run's identity.
fn located(locator: Value) -> List<Field> {
    match locator { .Null -> [], found -> [field("locator", as_json(found))] }
}

/// A successful replacement of one producer's contribution in one scope.
export type Publication = {
    id: string,
    producer: string,
    scope: string,
    input: string,
    input_revision: int,
    schema: string,
    expected_revision: int,
    records: List<Record>,
}

export type Link = { target: string, model: string, path: string }

impl Publication {
    fn fingerprint() -> string {
        digest(
            to_text(
                Json
                    .Obj(
                        [
                            field("id", Json.Str(self.id)),
                            field("producer", Json.Str(self.producer)),
                            field("scope", Json.Str(self.scope)),
                            field("input", Json.Str(self.input)),
                            field("input_revision", Json.Int(self.input_revision)),
                            field("schema", Json.Str(self.schema)),
                            field("expected_revision", Json.Int(self.expected_revision)),
                            field("records", Json.Arr([r.request_value() for r in self.records])),
                        ],
                    ),
            ),
        )
    }
}

impl Graph {
    /// All validation, references, withdrawals, and inserts share one snapshot.
    fn publish(publication: Publication) -> Result<int, string> {
        let p = publication
        if p.records.any(!json_safe(it.value) || !json_safe(it.locator)) { fail "graph values must contain only finite numbers" }
        if p.records.any(it.identities.any(it.namespace.is_empty() || it.external_key.is_empty())) { fail "an identity needs a nonempty namespace and key" }
        if p.id.is_empty() || p.producer.is_empty() || p.scope.is_empty() { fail "run id, producer, and scope must be nonempty" }
        storage(self.db.begin())?
        defer { let _ = self.db.finish() }
        let revision = self.current()?
        let replay = self.rows("SELECT request, revision FROM runs WHERE id=?", [.Text(p.id)])?
        if !replay.is_empty() {
            if cell_text(replay[0], 0)? != p.fingerprint() { fail "run id was already used with a different publication" }
            return cell_int(replay[0], 1)
        }
        if p.schema != self.catalog.fingerprint { fail "stale schema" }
        if p.expected_revision != revision { fail "stale graph revision" }
        let input = self.rows("SELECT revision FROM observations WHERE id=?", [.Text(p.input)])?
        if input.is_empty() || cell_int(input[0], 0)? != p.input_revision { fail "stale or missing observation" }
        let records = [self.checked(r)? for r in p.records]
        for i, r in records {
            if records.slice(0, i).any(it.id == r.id) { fail "one publication declares an entity at most once: ${r.id}" }
            for j, a in r.identities {
                if r.identities.slice(0, j).any(same_identity(it, a)) { fail "one record declares an identity twice: ${a.namespace}/${a.external_key}" }
                if records.slice(0, i).any(it.id != r.id && it.identities.any(same_identity(it, a))) {
                    fail "one identity cannot name two entities in one publication: ${a.namespace}/${a.external_key}"
                }
            }
            self.identify(r, revision + 1)?
        }
        self
            .execute(
                "INSERT INTO runs VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
                [
                    .Text(p.id),
                    .Text(p.producer),
                    .Text(p.scope),
                    .Text(p.input),
                    .Int(p.input_revision),
                    .Text(p.schema),
                    .Text(p.fingerprint()),
                    .Int(revision + 1),
                ],
            )?
        self
            .execute(
                "UPDATE supports SET until_revision=? WHERE until_revision IS NULL AND run IN (SELECT id FROM runs WHERE producer=? AND scope=? AND id<>?)",
                [.Int(revision + 1), .Text(p.producer), .Text(p.scope), .Text(p.id)],
            )?
        self
            .execute(
                "UPDATE aliases SET until_revision=? WHERE until_revision IS NULL AND run IN (SELECT id FROM runs WHERE producer=? AND scope=? AND id<>?)",
                [.Int(revision + 1), .Text(p.producer), .Text(p.scope), .Text(p.id)],
            )?
        for r in records { self.contribute(p, r)? }
        self.advance()?
        storage(self.db.commit())?
        revision + 1
    }

    fn checked(record: Record) -> Result<Record, string> {
        if record.id.is_empty() { fail "entity ids must be nonempty" }
        let model = self.catalog.model(record.model)?
        let checked = match record.mode {
            .Complete -> (model.check)(record.value),
            .Partial -> (model.check_fields)(record.value),
        }
        match checked {
            .Ok(value) -> {
                if !json_safe(value) { fail "model normalization produced a non-finite number" }
                record with { value: observed(record.value, value) }
            },
            .Err(issues) -> { fail "${record.id}: ${issues.report()}" },
        }
    }

    fn identify(record: Record, revision: int) -> Result<int, string> {
        let old = self.rows("SELECT model FROM entities WHERE id=?", [.Text(record.id)])?
        if !old.is_empty() && cell_text(old[0], 0)? != record.model { fail "an entity's model cannot change: ${record.id}" }
        self
            .execute(
                "INSERT OR IGNORE INTO entities VALUES (?, ?, ?)",
                [.Text(record.id), .Text(record.model), .Int(revision)],
            )
    }

    fn contribute(p: Publication, r: Record) -> Result<int, string> {
        let model = self.catalog.model(r.model)?
        for a in r.identities {
            if (self.bound(a.namespace, a.external_key)?).any(it != r.id) {
                fail "identity already names another entity: ${a.namespace}/${a.external_key}"
            }
            self
                .execute(
                    "INSERT OR IGNORE INTO aliases(namespace, external_key, entity, run) VALUES (?, ?, ?, ?)",
                    [.Text(a.namespace), .Text(a.external_key), .Text(r.id), .Text(p.id)],
                )?
        }
        for entry in r.value.entries() {
            let property? = model.properties.find(it.name == entry.key) else { fail "validated property is absent from its model" }
            let links = property.shape.links(self.catalog, entry.value, entry.key)?
            for link in links { self.reference(link)? }
            self
                .execute(
                    "INSERT OR IGNORE INTO claims(entity, property, value, schema) VALUES (?, ?, ?, ?)",
                    [.Text(r.id), .Text(entry.key), .Text(encoded(entry.value)), .Text(p.schema)],
                )?
            let claim = self
                .rows(
                    "SELECT id FROM claims WHERE entity=? AND property=? AND value=? AND schema=?",
                    [.Text(r.id), .Text(entry.key), .Text(encoded(entry.value)), .Text(p.schema)],
                )?[0]
            let id = cell_int(claim, 0)?
            self.execute("INSERT INTO supports(run, claim) VALUES (?, ?)", [.Text(p.id), .Int(id)])?
            if !absent(r.locator) {
                self
                    .execute(
                        "INSERT INTO evidence VALUES (?, ?, ?)",
                        [.Text(p.id), .Int(id), .Text(encoded(r.locator))],
                    )?
            }
            for link in links {
                self
                    .execute(
                        "INSERT OR IGNORE INTO edges VALUES (?, ?, ?)",
                        [.Int(id), .Text(link.target), .Text(link.path)],
                    )?
            }
        }
        0
    }

    fn reference(link: Link) -> Result<int, string> {
        let targets = self.rows("SELECT model FROM entities WHERE id=?", [.Text(link.target)])?
        if targets.is_empty() || cell_text(targets[0], 0)? != link.model { fail "${link.path} must refer to an existing ${link.model}: ${link.target}" }
        0
    }
}

/// Defaults construct records; only supplied fields become evidence.
fn absent(v: Value) -> bool { match v { .Null -> true, rest -> false } }

fn same_identity(a: Identity, b: Identity) -> bool {
    a.namespace == b.namespace && a.external_key == b.external_key
}
fn observed(original: Value, normalized: Value) -> Value {
    Value.Map([e for e in normalized.entries() if original.entries().any(it.key == e.key)])
}

impl Shape {
    fn links(catalog: Catalog, value: Value, path: string) -> Result<List<Link>, string> {
        match self {
            .Text or .Integer or .Number or .Boolean -> [],
            .Reference(target) -> {
                let id? = match value { .Text(id) -> id, rest -> null } else { fail "a reference must be text" }
                [Link { target: id, model: target, path: path }]
            },
            .Optional(inner) -> if value is .Null { [] } else { inner.links(catalog, value, path)? },
            .Many(inner) -> [link for i, v in value.items() for link in inner.links(catalog, v, "${path}[${i}]")?],
            .Embedded(name) -> {
                let model = catalog.model(name)?
                [link for e in value.entries() for p in model.properties if p.name == e.key for link in p.shape.links(catalog, e.value, "${path}.${e.key}")?]
            },
        }
    }
}
