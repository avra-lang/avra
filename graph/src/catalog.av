use schema.{Model, Shape, Property, Registration}
use semantics.{Semantics, encoding_word}
use @std.json.{Json, field, to_text, parse}
use data.{before, digest}
use policy.{Derivation, DerivationRegistration, checked_derivations}

/// `document` describes the models; derivations, when declared, join the
/// fingerprint as their own versioned section.
export type Catalog = {
    models: List<Model>,
    fingerprint: string,
    document: string,
    derivations: List<Derivation> = [],
}

impl Catalog {
    static fn collected(
        registrations: List<Registration>,
        derived: List<DerivationRegistration> = [],
    ) -> Result<Catalog, string> {
        let models = ordered([r.make() for r in registrations])
        for i, m in models {
            if models.slice(0, i).any(it.name == m.name) { fail "model names must be unique: ${m.name}" }
            for p in m.properties {
                if !(p.choices_source ?? "").is_empty() && p.choices().is_empty() {
                    fail "${m.name}.${p.name} declares one_of values that are not a list of text: ${p.choices_source!}"
                }
                for target in p.shape.targets() {
                    if !models.any(it.name == target) { fail "${m.name}.${p.name} names an unregistered model: ${target}" }
                }
            }
            m.semantics.checked(models, m)?
        }
        let derivations = [r.make() for r in derived]
        checked_derivations(models, derivations)?
        let described = Json.Arr([m.describe() for m in models])
        let document = to_text(described)
        Catalog {
            models: models,
            document: document,
            fingerprint: digest(identified(described, derivations)),
            derivations: derivations,
        }
    }

    fn model(name: string) -> Result<Model, string> {
        let found? = self.models.find(it.name == name) else { fail "unknown model: ${name}" }
        found
    }

    fn derivation(name: string) -> Result<Derivation, string> {
        let found? = self.derivations.find(it.name == name) else { fail "unknown derivation: ${name}" }
        found
    }
}

impl Model {
    fn describe() -> Json {
        Json
            .Obj(
                [
                    field("name", Json.Str(self.name)),
                    field("description", Json.Str(self.description)),
                    field(
                        "properties",
                        Json.Arr([p.describe_in(self.semantics) for p in self.properties]),
                    ),
                    field("rules", Json.Arr([Json.Str(r) for r in self.rules])),
                    field("semantics", self.semantics.describe()),
                ],
            )
    }
}

impl Property {
    /// The allowed values of a `one_of` field, read from its declaration.
    fn choices() -> List<string> {
        let source? = self.choices_source else { return [] }
        match parse(source) {
            .Ok(list) -> [v.text()! for v in list.items() if v.text() != null],
            .Err(_) -> [],
        }
    }

    /// The property with its declared time encoding, when the model binds one.
    fn describe_in(semantics: Semantics) -> Json {
        let base = self.describe()
        match semantics.times.find(it.path.length == 1 && it.path[0] == self.name) {
            t? -> Json
                .Obj(
                    base
                        .fields()
                        .concat(
                            [
                                field(
                                    "time",
                                    Json
                                        .Obj(
                                            [
                                                field(
                                                    "encoding",
                                                    Json.Str(encoding_word(t.encoding)),
                                                ),
                                            ],
                                        ),
                                ),
                            ],
                        ),
                )
            null -> base
        }
    }

    /// The property as a JSON Schema fragment plus the declaration's own
    /// names: `enum` carries a `one_of` field's values.
    fn describe() -> Json {
        let base = [
            field("name", Json.Str(self.name)),
            field("shape", self.shape.describe()),
            field("description", Json.Str(self.description)),
            field("rules", Json.Arr([Json.Str(r) for r in self.rules])),
            field(
                "default_source",
                if self.default_source == null { Json.Null } else { Json.Str(self.default_source!) },
            ),
        ]
        Json
            .Obj(
                if self.choices_source == null { base } else { base.concat([field("enum", Json.Arr([Json.Str(v) for v in self.choices()]))]) },
            )
    }
}

impl Shape {
    fn describe() -> Json {
        match self {
            .Text -> Json.Str("string"),
            .Integer -> Json.Str("integer"),
            .Number -> Json.Str("number"),
            .Boolean -> Json.Str("boolean"),
            .Optional(inner) -> Json.Obj([field("optional", inner.describe())]),
            .Many(inner) -> Json.Obj([field("list", inner.describe())]),
            .Reference(target) -> Json.Obj([field("reference", Json.Str(target))]),
            .Embedded(model) -> Json.Obj([field("embedded", Json.Str(model))]),
        }
    }

    fn targets() -> List<string> {
        match self {
            .Text or .Integer or .Number or .Boolean -> [],
            .Optional(inner) or .Many(inner) -> inner.targets(),
            .Reference(target) or .Embedded(target) -> [target],
        }
    }
}

/// The text a fingerprint covers: the model array alone, or an object
/// holding it beside the versioned derivations — never equal to an array.
fn identified(models: Json, derivations: List<Derivation>) -> string {
    if derivations.is_empty() { return to_text(models) }
    to_text(
        Json
            .Obj(
                [
                    field("models", models),
                    field(
                        "derivations",
                        Json
                            .Obj(
                                [
                                    field("version", Json.Int(1)),
                                    field("declared", Json.Arr([d.describe() for d in derivations])),
                                ],
                            ),
                    ),
                ],
            ),
    )
}

fn ordered(xs: List<Model>) -> List<Model> {
    if xs.length < 2 { return xs }
    let pivot = xs[0]
    let tail = xs.slice(1, xs.length)
    ordered([x for x in tail if before(x.name, pivot.name)])
        .concat([pivot])
        .concat(ordered([x for x in tail if !before(x.name, pivot.name)]))
}
