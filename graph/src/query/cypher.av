use @avra.cypher.parser.{parse_cypher, Query, Expr, MatchClause, NodePat, ReturnItem, CypherError}
use @std.json.{Json, Field, field, to_text}
use @std.text.{parse_int, parse_float}
use store.open.{Graph}
use query.plan.{prepare_read, ReadNode, ReadOnlyPlan}
use query.respond.{responded, refused}

/// A node's declared label, checked against the model its step reaches.
type Label = { step: string, label: string }

/// A compiled query: the read plan as JSON and the labels to hold it to.
type Compiled = { plan: Json, labels: List<Label> }

/// The query's seats: its parameters, read by name.
type Args = { params: Json }

/// What a WHERE conjunct asks of one node variable.
enum Cond {
    Filter(prop: string, comparison: string, literal: Json)
    Search(prop: string, needle: Json)
    Nullness(prop: string, negated: bool)
    Seat(binding: string)
}

type Placed = { name: string, cond: Cond }

type Slot = { name: string?, step: string }

/// One MATCH clause as steps; `last` is the step holding its rows.
type Chain = { steps: List<Json>, last: string, slots: List<Slot>, labels: List<Label>, optional: bool }

enum Aggregate { Count(star: bool), Sum(prop: string), Holds(prop: string) }

type PropWant = { who: string, prop: string, out: string }

type TotalWant = { who: string?, agg: Aggregate, out: string? }

enum Wanted { Prop(want: PropWant), Total(want: TotalWant) }

/// A query either becomes an admitted plan or is refused with a code.
enum Admission {
    Ready(plan: ReadOnlyPlan)
    Rejected(code: string, message: string)
}

impl Graph {
    /// A Cypher query and its parameters answer a contract `Answer`.
    fn cypher(text: string, params: Json) -> Result<Json, string> {
        let request = if text.length > 512 { text.substring(0, 512) } else { text }
        let revision = self.revision()?
        match self.admission(text, params) {
            .Rejected(code, message) -> refused(request, revision, "read_plan", code, message),
            .Ready(admitted) -> responded(request, self.read(admitted)?),
        }
    }

    /// Whether a query would run: `{"ok": true}`, or the refusal's code and words. Nothing executes.
    fn check_cypher(text: string, params: Json) -> Json {
        match self.admission(text, params) {
            .Rejected(code, message) -> Json
                .Obj(
                    [
                        field("ok", Json.Bool(false)),
                        field("code", Json.Str(code)),
                        field("message", Json.Str(message)),
                    ],
                ),
            .Ready(admitted) -> Json
                .Obj([field("ok", Json.Bool(true)), field("steps", Json.Int(admitted.nodes.length))]),
        }
    }

    /// The one door from Cypher text to a plan the executor accepts.
    fn admission(text: string, params: Json) -> Admission {
        match compiled(text, params, self.catalog.fingerprint) {
            .Err(e) -> Admission.Rejected(e.code, e.message),
            .Ok(c) -> self.labelled(c, prepare_read(self.catalog, to_text(c.plan))),
        }
    }

    fn labelled(c: Compiled, admitted: Result<ReadOnlyPlan, string>) -> Admission {
        match admitted {
            .Err(m) -> Admission.Rejected("plan_refused", m),
            .Ok(plan) -> self.labels_hold(c.labels, plan),
        }
    }

    fn labels_hold(labels: List<Label>, plan: ReadOnlyPlan) -> Admission {
        let wrong = mislabelled(labels, plan.nodes)
        if wrong != null { Admission.Rejected("label_mismatch", wrong!) } else { Admission.Ready(plan) }
    }
}

fn compiled(text: string, params: Json, fingerprint: string) -> Result<Compiled, CypherError> {
    let q = parse_cypher(text)?
    let args = Args { params: params }
    mut chains: List<Chain> = []
    for i, m in q.matches {
        let anchors = [c.slots[c.slots.length - 1] for c in chains]
        chains.push(chain_of(i, m, args, anchors)?)
    }
    let wanted = [wanted_of(r)? for r in q.returns]
    let finished = finish(chains, wanted)?
    .Ok(
        Compiled {
            plan: plan_json(text, fingerprint, context_of(params)?, finished, q.limit),
            labels: [l for c in chains for l in c.labels],
        },
    )
}

fn refuse(code: string, message: string) -> CypherError { CypherError { code: code, message: message } }

type Rename = { param: string, key: string }

/// Optional context seats a caller may bind, with their wire names.
const CONTEXT_SEATS: List<Rename> = [
    Rename { param: "speaker", key: "speaker" },
    Rename { param: "valid_at", key: "valid_at_ms" },
    Rename { param: "known_revision", key: "known_revision" },
    Rename { param: "conversation", key: "conversation" },
    Rename { param: "previous_answer", key: "previous_answer" },
]

fn context_of(params: Json) -> Result<Json, CypherError> {
    let asker? = params.get("asker")?.text() else { return .Err(missing_parameter("asker", "the principal asking")) }
    let now? = params.get("now")?.int() else { return .Err(missing_parameter("now", "the question time in milliseconds")) }
    let optional = [field(r.key, params.get(r.param)!) for r in CONTEXT_SEATS if params.get(r.param) != null]
    .Ok(
        Json
            .Obj(
                [field("principal", Json.Str(asker)), field("question_at_ms", Json.Int(now))]
                    .concat(optional),
            ),
    )
}

/// ---- MATCH ----

/// A clause may start from the last node of an earlier one (a shared variable).
fn chain_of(i: int, clause: MatchClause, args: Args, anchors: List<Slot>) -> Result<
    Chain,
    CypherError,
> {
    let nodes = [clause.pattern.first].concat([h.node for h in clause.pattern.hops])
    let names = [n.name! for n in nodes if n.name != null]
    for j, name in names {
        if names.slice(0, j).contains(name) { return .Err(refuse("duplicate_variable", "a variable names one node: ${name}")) }
    }
    for h in clause.pattern.hops {
        if h.rel.var_length {
            return .Err(
                refuse(
                    "variable_length_path",
                    "a relationship names one hop; paths of unbounded length are not run",
                ),
            )
        }
        if h.rel.name != null {
            return .Err(
                refuse("relationship_variable", "a relationship carries no properties to bind"),
            )
        }
    }
    let rebound = [a for a in anchors if nodes[0].name != null && a.name == nodes[0].name]
    for a in anchors {
        if a.name != null && names.slice(1, names.length).contains(a.name!) {
            return .Err(refuse("duplicate_variable", "a variable names one node: ${a.name!}"))
        }
    }
    if !rebound.is_empty() && clause.pattern.hops.is_empty() {
        return .Err(refuse("unused_match", "a rebound variable needs a hop to reach something new"))
    }
    if rebound.is_empty() && nodes[0].label == null {
        return .Err(refuse("unlabelled_node", "the first node of a path names its label"))
    }
    let placed = match clause.where {
        w? -> placements(w, nodes, args)?
        null -> []
    }
    if !rebound.is_empty() && placed.any(it.name == nodes[0].name!) {
        return .Err(
            refuse(
                "unsupported_rebound_filter",
                "a rebound variable is not filtered again; filter it where it was first matched",
            ),
        )
    }
    mut steps: List<Json> = []
    mut slots: List<Slot> = []
    mut labels: List<Label> = []
    mut last = if rebound.is_empty() { "" } else { rebound[0].step }
    for j, n in nodes {
        let id = "m${i}n${j}"
        let mine = [p for p in placed if n.name != null && p.name == n.name!]
        if j == 0 {
            if rebound.is_empty() {
                steps.push(arrival(id, nodes[0].label!, mine)?)
                last = id
            }
        } else {
            let hop = clause.pattern.hops[j - 1]
            steps.push(follow_json(id, last, hop.rel.label, hop.rel.forward, n.label))
            last = id
        }
        if n.label != null && (j > 0 || rebound.is_empty()) { labels.push(Label { step: id, label: n.label! }) }
        if j > 0 && mine.any(it.cond is .Seat) { return .Err(refuse("unsupported_id_filter", "id() seeds the first node of a path only")) }
        for p in mine {
            let step_id = "${id}f${steps.length}"
            let narrowed = narrowing(p.cond, step_id, last)
            if narrowed != null {
                steps.push(narrowed!)
                last = step_id
            }
        }
        slots.push(Slot { name: n.name, step: last })
    }
    .Ok(Chain { steps: steps, last: last, slots: slots, labels: labels, optional: clause.optional })
}

/// The first node: seeded from the context when a conjunct says so, else scanned.
fn arrival(id: string, label: string, mine: List<Placed>) -> Result<Json, CypherError> {
    let seats = [binding for p in mine for binding in seat_of(p.cond)]
    match seats {
        [] -> .Ok(
            Json
                .Obj(
                    [
                        field("id", Json.Str(id)),
                        field("op", Json.Str("scan")),
                        field("model", Json.Str(label)),
                    ],
                ),
        ),
        [binding] -> .Ok(
            Json
                .Obj(
                    [
                        field("id", Json.Str(id)),
                        field("op", Json.Str("seed")),
                        field("model", Json.Str(label)),
                        field("binding", Json.Str(binding)),
                    ],
                ),
        ),
        rest -> .Err(refuse("unsupported_id_filter", "a node is seeded by one id() equality")),
    }
}

fn seat_of(c: Cond) -> List<string> {
    match c {
        .Seat(binding) -> [binding],
        .Filter(_, _, _) or .Search(_, _) or .Nullness(_, _) -> [],
    }
}

/// The step a condition adds, or nothing for a seat (the first step took it).
fn narrowing(c: Cond, id: string, input: string) -> Json? {
    match c {
        .Filter(prop, comparison, literal) -> Json
            .Obj(
                [
                    field("id", Json.Str(id)),
                    field("op", Json.Str("filter")),
                    field("inputs", Json.Arr([Json.Str(input)])),
                    field("property", Json.Str(prop)),
                    field("comparison", Json.Str(comparison)),
                    field("arguments", Json.Arr([literal])),
                ],
            ),
        .Nullness(prop, negated) -> narrowing(Cond.Filter(prop, if negated { "ne" } else { "eq" }, Json.Null), id, input),
        .Search(prop, needle) -> Json
            .Obj(
                [
                    field("id", Json.Str(id)),
                    field("op", Json.Str("search")),
                    field("inputs", Json.Arr([Json.Str(input)])),
                    field("property", Json.Str(prop)),
                    field("arguments", Json.Arr([needle])),
                ],
            ),
        .Seat(_) -> null,
    }
}

fn follow_json(id: string, input: string, property: string, forward: bool, owner: string?) -> Json {
    let base = [
        field("id", Json.Str(id)),
        field("op", Json.Str("follow")),
        field("inputs", Json.Arr([Json.Str(input)])),
        field("property", Json.Str(property)),
        field("direction", Json.Str(if forward { "out" } else { "in" })),
    ]
    Json
        .Obj(
            if forward || owner == null { base } else { base.concat([field("owner", Json.Str(owner!))]) },
        )
}

/// ---- WHERE ----

fn placements(w: Expr, nodes: List<NodePat>, args: Args) -> Result<List<Placed>, CypherError> {
    let placed = [placement(c, args)? for c in conjuncts(w)]
    for p in placed {
        if !nodes.any(it.name == p.name) { return .Err(refuse("unknown_variable", "${p.name} is not a variable of this MATCH")) }
    }
    placed
}

fn conjuncts(e: Expr) -> List<Expr> {
    match e {
        .Binary(op, lhs, rhs) -> if op == "AND" { conjuncts(lhs).concat(conjuncts(rhs)) } else { [e] },
        rest -> [e],
    }
}

fn placement(e: Expr, args: Args) -> Result<Placed, CypherError> {
    match e {
        .Binary(op, lhs, rhs) -> binary_placement(op, lhs, rhs, args),
        .IsNull(inner, negated) -> match inner {
            .Prop(owner, name) -> .Ok(Placed { name: owner, cond: Cond.Nullness(name, negated) }),
            rest -> .Err(unsupported_predicate()),
        },
        .Not(_) -> .Err(refuse("unsupported_not", "NOT is outside the subset; state the comparison directly")),
        rest -> .Err(unsupported_predicate()),
    }
}

fn binary_placement(op: string, lhs: Expr, rhs: Expr, args: Args) -> Result<Placed, CypherError> {
    if op == "OR" {
        return .Err(
            refuse(
                "unsupported_or",
                "OR is outside the subset; ask two queries or state one alternative",
            ),
        )
    }
    let seat? = seat_binding(lhs, rhs) else { return comparison_placement(op, lhs, rhs, args) }
    if op != "=" { return .Err(unsupported_predicate()) }
    .Ok(seat)
}

/// `id(v) = $speaker` or `$asker`, in either order.
fn seat_binding(lhs: Expr, rhs: Expr) -> Placed? {
    let named? = id_of(lhs) ?? id_of(rhs) else { return null }
    let param? = param_of(rhs) ?? param_of(lhs) else { return null }
    let binding? = match param { "speaker" -> "speaker", "asker" -> "principal", rest -> null } else {
        return null
    }
    Placed { name: named, cond: Cond.Seat(binding) }
}

fn id_of(e: Expr) -> string? {
    match e {
        .Call(name, args) -> if name == "id" && args.length == 1 { var_of(args[0]) } else { null },
        rest -> null,
    }
}

fn var_of(e: Expr) -> string? { match e { .Var(name) -> name, rest -> null } }

fn param_of(e: Expr) -> string? { match e { .Param(name) -> name, rest -> null } }

fn comparison_placement(op: string, lhs: Expr, rhs: Expr, args: Args) -> Result<Placed, CypherError> {
    if op == "CONTAINS" {
        return match lhs {
            .Prop(owner, name) -> .Ok(Placed { name: owner, cond: Cond.Search(name, literal(rhs, args)?) }),
            rest -> .Err(unsupported_predicate()),
        }
    }
    let word? = comparison_word(op) else { return .Err(unsupported_predicate()) }
    match lhs {
        .Prop(owner, name) -> .Ok(Placed { name: owner, cond: Cond.Filter(name, word, literal(rhs, args)?) }),
        rest -> match rhs {
            .Prop(owner, name) -> .Ok(Placed { name: owner, cond: Cond.Filter(name, flipped(word), literal(lhs, args)?) }),
            rest -> .Err(unsupported_predicate()),
        },
    }
}

fn comparison_word(op: string) -> string? {
    match op {
        "=" -> "eq",
        "<>" -> "ne",
        "<" -> "lt",
        "<=" -> "le",
        ">" -> "gt",
        ">=" -> "ge",
        rest -> null,
    }
}

fn flipped(word: string) -> string {
    match word { "lt" -> "gt", "le" -> "ge", "gt" -> "lt", "ge" -> "le", rest -> word }
}

fn literal(e: Expr, args: Args) -> Result<Json, CypherError> {
    match e {
        .Num(text) -> number(text),
        .Str(text) -> .Ok(Json.Str(text)),
        .Bool(value) -> .Ok(Json.Bool(value)),
        .Null -> .Ok(Json.Null),
        .Param(name) -> bound(args.params.get(name), name),
        .Prop(_, _) or .Var(_) or .Not(_) or .Binary(_, _, _) or .IsNull(_, _) or .Call(_, _) or .Star -> .Err(
            refuse(
                "unsupported_predicate",
                "a comparison reads a property against a literal or a parameter",
            ),
        ),
    }
}

fn bound(value: Json?, name: string) -> Result<Json, CypherError> {
    match value {
        v? -> .Ok(v)
        null -> .Err(refuse("unbound_parameter", "\$${name} is not bound"))
    }
}

fn number(text: string) -> Result<Json, CypherError> {
    if text.contains(".") {
        let x = parse_float(text)
        match x {
            f? -> .Ok(Json.Float(f))
            null -> .Err(refuse("syntax", "not a number: ${text}"))
        }
    } else {
        let n = parse_int(text)
        match n {
            v? -> .Ok(Json.Int(v))
            null -> .Err(refuse("syntax", "not an integer: ${text}"))
        }
    }
}

fn unsupported_predicate() -> CypherError {
    refuse(
        "unsupported_predicate",
        "a condition compares one property to a literal or a parameter, CONTAINS text, or tests IS NULL",
    )
}

fn missing_parameter(name: string, meaning: string) -> CypherError {
    refuse("missing_parameter", "\$${name} is required: ${meaning}")
}

/// ---- RETURN ----

fn wanted_of(r: ReturnItem) -> Result<Wanted, CypherError> {
    match r.expr {
        .Prop(owner, name) -> .Ok(Wanted.Prop(PropWant { who: owner, prop: name, out: r.name ?? name })),
        .Call(name, args) -> aggregate_of(name, args, r.name),
        rest -> .Err(unsupported_return()),
    }
}

fn aggregate_of(name: string, args: List<Expr>, out: string?) -> Result<Wanted, CypherError> {
    match name {
        "count" -> match args {
            [only] -> match only {
                .Star -> .Ok(Wanted.Total(TotalWant { who: null, agg: Aggregate.Count(true), out: out })),
                .Var(v) -> .Ok(Wanted.Total(TotalWant { who: v, agg: Aggregate.Count(false), out: out })),
                rest -> .Err(unsupported_return()),
            },
            rest -> .Err(unsupported_return()),
        },
        "sum" -> match args {
            [only] -> match only {
                .Prop(owner, prop) -> .Ok(Wanted.Total(TotalWant { who: owner, agg: Aggregate.Sum(prop), out: out })),
                rest -> .Err(unsupported_return()),
            },
            rest -> .Err(unsupported_return()),
        },
        "coalesce" -> match args {
            [first, fallback] -> match first {
                .Prop(owner, prop) -> if is_false(fallback) {
                    .Ok(
                        Wanted.Total(TotalWant { who: owner, agg: Aggregate.Holds(prop), out: out }),
                    )
                } else {
                    .Err(
                        refuse(
                            "unsupported_coalesce",
                            "coalesce(property, false) is the one defaulting form: absence reads false",
                        ),
                    )
                },
                rest -> .Err(unsupported_return()),
            },
            rest -> .Err(unsupported_return()),
        },
        rest -> .Err(
            refuse(
                "unsupported_function",
                "only count(), sum(), coalesce() and id() are functions of the subset",
            ),
        ),
    }
}

fn is_false(e: Expr) -> bool { match e { .Bool(value) -> !value, rest -> false } }

fn unsupported_return() -> CypherError {
    refuse(
        "unsupported_return",
        "return properties of a path's last node, count(), sum(property) or coalesce(property, false)",
    )
}

/// The plan's tail: what to return, from which chains.
type Finished = { steps: List<Json>, output: string, joined: List<string> }

fn finish(chains: List<Chain>, wanted: List<Wanted>) -> Result<Finished, CypherError> {
    let totals = [t for w in wanted for t in total_want(w)]
    let props = [p for w in wanted for p in prop_want(w)]
    let sole = [t for t in totals if !is_holds(t)]
    let statuses = [t for t in totals if is_holds(t)]
    if !sole.is_empty() {
        if wanted.length != 1 {
            return .Err(
                refuse(
                    "unsupported_aggregate_mix",
                    "count() and sum() are the only item of their RETURN",
                ),
            )
        }
        if chains.length != 1 { return .Err(refuse("unused_match", "an aggregate reads the one MATCH it follows")) }
        return aggregated(chains[0], sole[0])
    }
    for p in props {
        let _ = owner_chain_of(chains, p.who)?
    }
    for t in statuses {
        let _ = owner_chain_of(chains, t.who ?? "")?
    }
    mut steps = [s for c in chains for s in c.steps]
    mut tails: List<string> = []
    for i, c in chains {
        let mine = [p for p in props if owner_chain(chains, p.who) == i]
        let held = [t for t in statuses if owner_chain(chains, t.who ?? "") == i]
        if mine.is_empty() && held.is_empty() {
            return .Err(refuse("unused_match", "every MATCH contributes to the RETURN"))
        }
        if !mine.is_empty() {
            let tail = returned(i, c, mine)
            steps = steps.concat(tail.steps)
            tails.push(tail.output)
        }
        for k, t in held {
            let id = "r${i}h${k}"
            steps.push(status_step(id, c.last, t))
            tails.push(id)
        }
    }
    .Ok(Finished { steps: steps, output: tails[0], joined: tails.slice(1, tails.length) })
}

fn is_holds(t: TotalWant) -> bool {
    match t.agg { .Holds(_) -> true, .Count(_) or .Sum(_) -> false }
}

/// A declared boolean status over one path's rows.
fn status_step(id: string, input: string, t: TotalWant) -> Json {
    let prop = match t.agg { .Holds(name) -> name, .Count(_) or .Sum(_) -> "" }
    step_json(
        id,
        "holds",
        input,
        [field("property", Json.Str(prop)), field("names", Json.Arr([Json.Str(t.out ?? prop)]))],
    )
}

fn total_want(w: Wanted) -> List<TotalWant> { match w { .Total(t) -> [t], .Prop(_) -> [] } }

fn prop_want(w: Wanted) -> List<PropWant> { match w { .Prop(p) -> [p], .Total(_) -> [] } }

fn tail_name(c: Chain) -> string? { c.slots[c.slots.length - 1].name }

fn owner_chain(chains: List<Chain>, who: string) -> int? {
    [i for i, c in chains if tail_name(c) == who].first()
}

/// The chain a returned variable ends, or the reason it ends none.
fn owner_chain_of(chains: List<Chain>, who: string) -> Result<int, CypherError> {
    let found = owner_chain(chains, who)
    match found {
        i? -> .Ok(i)
        null -> if chains.any(it.slots.any((s) -> s.name == who)) {
            .Err(
                refuse(
                    "return_not_last",
                    "${who} is not the last node of its path; return properties of the last node",
                ),
            )
        } else {
            .Err(refuse("unknown_variable", "${who} is not a variable of any MATCH"))
        }
    }
}

fn returned(i: int, c: Chain, props: List<PropWant>) -> Finished {
    mut steps: List<Json> = []
    mut last = c.last
    if !c.optional {
        for k, p in props {
            let id = "r${i}e${k}"
            steps
                .push(
                    step_json(
                        id,
                        "expect",
                        last,
                        [
                            field("property", Json.Str(p.prop)),
                            field("reason", Json.Str("null_result")),
                        ],
                    ),
                )
            last = id
        }
    }
    let id = "r${i}p"
    steps
        .push(
            step_json(
                id,
                "project",
                last,
                [
                    field("properties", Json.Arr([Json.Str(p.prop) for p in props])),
                    field("names", Json.Arr([Json.Str(p.out) for p in props])),
                ],
            ),
        )
    Finished { steps: steps, output: id, joined: [] }
}

fn step_json(id: string, op: string, input: string, rest: List<Field>) -> Json {
    Json
        .Obj(
            [
                field("id", Json.Str(id)),
                field("op", Json.Str(op)),
                field("inputs", Json.Arr([Json.Str(input)])),
            ]
                .concat(rest),
        )
}

/// An aggregate over the rows of the one path it follows.
fn aggregated(c: Chain, t: TotalWant) -> Result<Finished, CypherError> {
    if t.who != null && tail_name(c) != t.who { return .Err(refuse("return_not_last", "${t.who!} is not the last node of its path")) }
    let id = "r0a"
    let named = if t.out == null { [] } else { [field("names", Json.Arr([Json.Str(t.out!)]))] }
    let step = match t.agg {
        .Count(_) -> step_json(id, "count", c.last, named),
        .Sum(prop) -> step_json(id, "sum", c.last, [field("property", Json.Str(prop))].concat(named)),
        .Holds(_) -> status_step(id, c.last, t),
    }
    .Ok(Finished { steps: c.steps.concat([step]), output: id, joined: [] })
}

/// ---- plan ----

fn plan_json(text: string, fingerprint: string, context: Json, f: Finished, limit: int?) -> Json {
    let base = [
        field("contract", Json.Int(1)),
        field("request", Json.Str(if text.length > 512 { text.substring(0, 512) } else { text })),
        field("schema", Json.Str(fingerprint)),
        field("context", context),
        field("source_view", Json.Str("current")),
        field("steps", Json.Arr(f.steps)),
        field("output", Json.Str(f.output)),
        field("joined", Json.Arr([Json.Str(id) for id in f.joined])),
        field("budget", budget()),
    ]
    Json.Obj(if limit == null { base } else { base.concat([field("limit", Json.Int(limit!))]) })
}

fn budget() -> Json {
    Json
        .Obj(
            [
                field("steps", Json.Int(32)),
                field("rows", Json.Int(1000)),
                field("work", Json.Int(100000)),
                field("depth", Json.Int(8)),
                field("timeout_ms", Json.Int(10000)),
            ],
        )
}

/// The first declared label that is not the model its step reaches.
fn mislabelled(labels: List<Label>, nodes: List<ReadNode>) -> string? {
    ["${l.label} is not the model ${l.step} reaches" for l in labels for n in nodes if n.id == l.step && model_of(n) != l.label]
        .first()
}

fn model_of(n: ReadNode) -> string {
    match n.shape { .Rows(rows) -> rows.model, .Status or .Count or .Quantity(_) -> "" }
}
