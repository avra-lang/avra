use @avra.graph_contracts.{ReadPlan, ReadStep, Budget, Context}
use @std.validate.{Value}
use catalog.{Catalog}
use schema.{Shape, Property, Model}
use semantics.{QuantityBinding}

export enum Comparison { Equal, NotEqual, Less, LessEqual, Greater, GreaterEqual }
export enum Direction { Outgoing, Incoming }
/// Which party of the request a seed starts from.
export enum Binding { Speaker, Principal }
export enum SourceView { Current, History }

/// Row identities and evidence survive projection; visible fields do not.
export type ReadRows = { model: string, properties: List<Property> }
export enum ReadShape { Rows(rows: ReadRows), Status, Count, Quantity(binding: QuantityBinding), Derived }

export enum ReadOperation {
    Scan(model: string)
    Seed(model: string, binding: Binding)
    Filter(input: int, property: Property, comparison: Comparison, literal: Value)
    Follow(input: int, owner: string, property: Property, direction: Direction)
    Search(input: int, property: Property, needle: string)
    Project(input: int, properties: List<Property>, names: List<string>)
    Expect(input: int, property: Property, reason: string)
    Holds(input: int, property: Property, name: string)
    Count(input: int, name: string)
    Derive(inputs: List<int>, derivation: string, literals: List<Value>, name: string)
    Sum(input: int, property: Property, quantity: QuantityBinding, name: string)
}

export type ReadNode = { id: string, operation: ReadOperation, shape: ReadShape, depth: int }
export type ReadOnlyPlan = {
    request: string,
    schema: string,
    context: Context,
    source_view: SourceView,
    nodes: List<ReadNode>,
    output: int,
    joined: List<int>,
    limit: int?,
    budget: Budget,
}

/// Pure admission, not execution or authorization. The trusted caller supplies
/// the catalog; untrusted planners supply only the bounded wire document.
export fn prepare_read(catalog: Catalog, payload: string) -> Result<ReadOnlyPlan, string> {
    if payload.bytes().length > 262144 { fail "read plan exceeds its byte budget" }
    let wire = match ReadPlan.from_json(payload) {
        .Ok(p) -> p,
        .Err(issues) -> { fail "read plan: ${issues.report()}" },
    }
    if wire.schema != catalog.fingerprint { fail "read plan names a different catalog revision" }
    if wire.steps.length > wire.budget.work { fail "read plan exceeds its minimum work budget" }
    mut nodes: List<ReadNode> = []
    for step in wire.steps {
        let node = prepared_node(catalog, nodes, step)?
        if node.depth > wire.budget.depth { fail "read plan exceeds its reference-depth budget" }
        nodes.push(node)
    }
    let output = node_at(nodes, wire.output, "read plan output is absent")?
    let joined = [node_at(nodes, id, "read plan joined output is absent")? for id in wire.joined]
    if !joined.is_empty() &&
        ![output].concat(joined).all(nodes[it].shape is .Rows || nodes[it].shape is .Status) {
        fail "joined outputs must be row sets or statuses"
    }
    ReadOnlyPlan {
        request: wire.request,
        schema: wire.schema,
        context: wire.context,
        source_view: if wire.source_view == "current" { .Current } else { .History },
        nodes: nodes,
        output: output,
        joined: joined,
        limit: wire.limit,
        budget: wire.budget,
    }
}

fn all_rows(model: Model) -> ReadShape {
    .Rows(ReadRows { model: model.name, properties: model.properties })
}

fn node_at(nodes: List<ReadNode>, id: string, absent: string) -> Result<int, string> {
    let at = nodes.map(it.id).index_of(id)
    if at < 0 { fail absent }
    at
}

fn visible(rows: ReadRows, name: string) -> Result<Property, string> {
    let property? = rows.properties.find(it.name == name) else { fail "read property is unknown or not visible: ${rows.model}.${name}" }
    property
}

fn row_shape(node: ReadNode) -> Result<ReadRows, string> {
    match node.shape {
        .Rows(rows) -> rows,
        .Count or .Status or .Quantity(_) or .Derived -> { fail "a scalar aggregate or derived value cannot be used as graph rows" },
    }
}

fn unwrapped(shape: Shape) -> Shape {
    match shape { .Optional(inner) -> unwrapped(inner), rest -> shape }
}

/// The model a reference shape points at, through optional and list wrappers.
export fn target(shape: Shape) -> string? {
    match shape {
        .Reference(model) -> model,
        .Optional(inner) or .Many(inner) -> target(inner),
        .Text or .Integer or .Number or .Boolean or .Embedded(_) -> null,
    }
}

fn comparison(word: string) -> Result<Comparison, string> {
    match word {
        "eq" -> Comparison.Equal,
        "ne" -> Comparison.NotEqual,
        "lt" -> Comparison.Less,
        "le" -> Comparison.LessEqual,
        "gt" -> Comparison.Greater,
        "ge" -> Comparison.GreaterEqual,
        rest -> { fail "unknown comparison" },
    }
}

fn checked_literal(property: Property, literal: Value, compare: Comparison) -> Result<Value, string> {
    let equality = compare is .Equal || compare is .NotEqual
    if literal is .Null {
        if property.shape is .Optional && equality { return literal }
        fail "null predicates require an optional property and equality comparison"
    }
    let compatible = match unwrapped(property.shape) {
        .Text -> literal is .Text,
        .Integer -> literal is .Int,
        .Number -> literal is .Float,
        .Boolean -> literal is .Bool && equality,
        .Reference(_) -> literal is .Text && equality,
        .Optional(_) or .Many(_) or .Embedded(_) -> false,
    }
    if !compatible { fail "read predicate has an incompatible literal or comparison" }
    if !bounded(literal) { fail "read literal exceeds its text budget or is not finite" }
    literal
}

fn bounded(literal: Value) -> bool {
    match literal {
        .Text(s) -> s.bytes().length <= 4096,
        .Float(n) -> n - n == 0.0,
        .Null or .Bool(_) or .Int(_) or .List(_) or .Map(_) -> true,
    }
}

type ReverseBinding = { owner: string, property: Property }

fn reverse_binding(catalog: Catalog, rows: ReadRows, property: string, owner: string?) -> Result<
    ReverseBinding,
    string,
> {
    let found = [ReverseBinding { owner: model.name, property: p } for model in catalog.models for p in model.properties if p.name == property && target(p.shape) == rows.model && (owner == null || owner == model.name)]
    match found {
        [only] -> only,
        [] -> { fail "incoming read reference has no declared owner" },
        rest -> { fail "incoming read reference has multiple declared owners — name one" },
    }
}

fn prepared_node(catalog: Catalog, nodes: List<ReadNode>, step: ReadStep) -> Result<
    ReadNode,
    string,
> {
    if step.op == "scan" {
        let model = catalog.model(step.model!)?
        return ReadNode {
            id: step.id,
            operation: .Scan(model.name),
            shape: all_rows(model),
            depth: 0,
        }
    }
    if step.op == "seed" {
        let model = catalog.model(step.model!)?
        return ReadNode {
            id: step.id,
            operation: .Seed(
                model.name,
                if step.binding == "speaker" { Binding.Speaker } else { Binding.Principal },
            ),
            shape: all_rows(model),
            depth: 0,
        }
    }
    if step.op == "derive" { return derived_node(catalog, nodes, step) }
    let input = node_at(nodes, step.inputs[0], "read input must precede its consumer")?
    let rows = row_shape(nodes[input])?
    let depth = nodes[input].depth
    match step.op {
        "filter" -> {
            let property = visible(rows, step.property!)?
            let compare = comparison(step.comparison!)?
            let literal = checked_literal(property, step.arguments[0].value, compare)?
            ReadNode {
                id: step.id,
                operation: .Filter(input, property, compare, literal),
                shape: .Rows(rows),
                depth: depth,
            }
        },
        "search" -> {
            let property = visible(rows, step.property!)?
            if !(unwrapped(property.shape) is .Text) { fail "search requires a declared text property" }
            let needle = match step.arguments[0].value {
                .Text(s) -> s,
                rest -> { fail "search requires a text literal" },
            }
            if needle.is_empty() || needle.bytes().length > 4096 { fail "search text must be nonempty and bounded" }
            ReadNode {
                id: step.id,
                operation: .Search(input, property, needle),
                shape: .Rows(rows),
                depth: depth,
            }
        },
        "follow" -> {
            let direction = if step.direction == "out" { Direction.Outgoing } else { Direction.Incoming }
            let binding = match direction {
                .Outgoing -> ReverseBinding { owner: rows.model, property: visible(rows, step.property!)? },
                .Incoming -> reverse_binding(catalog, rows, step.property!, step.owner)?,
            }
            let next = match direction {
                .Outgoing -> {
                    let destination? = target(binding.property.shape) else { fail "follow requires a declared reference property" }
                    destination
                },
                .Incoming -> binding.owner,
            }
            let model = catalog.model(next)?
            ReadNode {
                id: step.id,
                operation: .Follow(input, binding.owner, binding.property, direction),
                shape: all_rows(model),
                depth: depth + 1,
            }
        },
        "project" -> {
            for i, name in step.properties {
                if step.properties.slice(0, i).contains(name) { fail "read projections must name distinct properties" }
            }
            let properties = [visible(rows, name)? for name in step.properties]
            let names = if step.names.is_empty() { step.properties } else { step.names }
            for i, name in names {
                if names.slice(0, i).contains(name) { fail "read output names must be distinct" }
            }
            ReadNode {
                id: step.id,
                operation: .Project(input, properties, names),
                shape: .Rows(ReadRows { model: rows.model, properties: properties }),
                depth: depth,
            }
        },
        "expect" -> ReadNode {
            id: step.id,
            operation: .Expect(input, visible(rows, step.property!)?, step.reason!),
            shape: .Rows(rows),
            depth: depth,
        },
        "holds" -> {
            let property = visible(rows, step.property!)?
            if !(unwrapped(property.shape) is .Boolean) { fail "holds reads a declared boolean property" }
            ReadNode {
                id: step.id,
                operation: .Holds(input, property, step.names[0]),
                shape: .Status,
                depth: depth,
            }
        },
        "count" -> ReadNode {
            id: step.id,
            operation: .Count(input, step.names.first() ?? "count"),
            shape: .Count,
            depth: depth,
        },
        "sum" -> {
            let property = visible(rows, step.property!)?
            if !(unwrapped(property.shape) is .Integer) { fail "sum requires an integer property in minor units" }
            let model = catalog.model(rows.model)?
            let quantity? = model
                .semantics
                .quantities
                .find(it.amount.length == 1 && it.amount[0] == property.name) else {
                fail "sum requires an explicit declared quantity/unit binding"
            }
            if quantity.unit is .Field(path) {
                if path.length != 1 { fail "sum over an embedded unit path needs an explicit policy plan" }
                let _ = visible(rows, path[0])?
            }
            ReadNode {
                id: step.id,
                operation: .Sum(input, property, quantity, step.names.first() ?? "sum"),
                shape: .Quantity(quantity),
                depth: depth,
            }
        },
        rest -> { fail "unknown read operation" },
    }
}

/// A declared derivation over earlier row sets and literals: one input per
/// row seat in order, one argument per literal seat in order.
fn derived_node(catalog: Catalog, nodes: List<ReadNode>, step: ReadStep) -> Result<ReadNode, string> {
    let derivation = catalog.derivation(step.derivation!)?
    let row_seats = derivation.parameters.filter(it.input.rows())
    let literal_seats = derivation.parameters.filter(!it.input.rows())
    if step.inputs.length != row_seats.length {
        fail "derivation `${derivation.name}` reads ${row_seats.length} row sets, this step gives ${step.inputs.length}"
    }
    if step.arguments.length != literal_seats.length {
        fail "derivation `${derivation.name}` takes ${literal_seats.length} literal arguments, this step gives ${step.arguments.length}"
    }
    mut depth = 0
    mut inputs: List<int> = []
    for i, seat in row_seats {
        let at = node_at(nodes, step.inputs[i], "read input must precede its consumer")?
        let rows = row_shape(nodes[at])?
        if rows.model != seat.input.model()! {
            fail "derivation `${derivation.name}` reads ${seat.input.model()!} for `${seat.name}`, this step gives ${rows.model}"
        }
        if nodes[at].depth > depth { depth = nodes[at].depth }
        inputs.push(at)
    }
    for i, seat in literal_seats {
        let value = step.arguments[i].value
        let fits = match seat.input {
            .Text -> value is .Text,
            .Integer -> value is .Int,
            .Boolean -> value is .Bool,
            .One(_) or .Maybe(_) or .All(_) -> false,
        }
        if !fits { fail "derivation `${derivation.name}` takes a different literal for `${seat.name}`" }
        if !bounded(value) { fail "read literal exceeds its text budget or is not finite" }
    }
    ReadNode {
        id: step.id,
        operation: .Derive(
            inputs,
            derivation.name,
            [a.value for a in step.arguments],
            step.names.first() ?? derivation.name,
        ),
        shape: .Derived,
        depth: depth,
    }
}
