use @avra.cypher.parser.{parse_cypher, cypher_parser_grammar, Query, Expr}

spec "cypher/parser_grammar" {
    given "the assembled grammar" {
        then "every rule text parsed and cross-references resolved" {
            cypher_parser_grammar().defects(["IDENT", "NUMBER", "STRING", "PARAM"]).is_empty()
        }
    }
}

fn first_error(source: string) -> string {
    match parse_cypher(source) { .Ok(_) -> "ok", .Err(e) -> e.code }
}

spec "cypher/parse" {
    given "a path with a filter and a named return" {
        then "it builds nodes, hops and returns" {
            match parse_cypher(
                "MATCH (me:Person)<-[:subject]-(r:Relationship)-[:relative]->(w:Person) WHERE r.relation = 'wife' RETURN w.name AS person",
            ) {
                .Ok(q) -> q.matches.length == 1 &&
                    q.matches[0].pattern.hops.length == 2 &&
                    q.matches[0].pattern.first.label == "Person" &&
                    !q.matches[0].pattern.hops[0].rel.forward &&
                    q.matches[0].pattern.hops[0].rel.label == "subject" &&
                    q.matches[0].pattern.hops[1].rel.label == "relative" &&
                    q.matches[0].pattern.hops[1].rel.name == null &&
                    q.matches[0].pattern.hops[1].rel.forward &&
                    q.matches[0].pattern.hops[1].node.name == "w" &&
                    q.returns[0].name == "person",
                .Err(e) -> {
                    println(e.message)
                    false
                },
            }
        }
        then "keywords are case-insensitive" { first_error("match (a:P) return a.x") == "ok" }
    }
}

fn render(e: Expr) -> string {
    match e {
        .Prop(owner, name) -> "${owner}.${name}",
        .Var(name) -> name,
        .Num(text) -> text,
        .Str(text) -> "'${text}'",
        .Bool(value) -> "${value}",
        .Null -> "null",
        .Param(name) -> "\$${name}",
        .Not(inner) -> "(NOT ${render(inner)})",
        .Binary(op, lhs, rhs) -> "(${render(lhs)} ${op} ${render(rhs)})",
        .IsNull(inner, negated) -> "(${render(inner)} IS ${if negated { "NOT " } else { "" }}NULL)",
        .Call(name, args) -> "${name}(${[render(a) for a in args].join(",")})",
        .Star -> "*",
    }
}

fn where_of(source: string) -> string {
    match parse_cypher("MATCH (a:P) WHERE ${source} RETURN a.x") {
        .Ok(q) -> render(q.matches[0].where!),
        .Err(e) -> e.code,
    }
}

fn returns_of(source: string) -> string {
    match parse_cypher("MATCH (a:P) RETURN ${source}") {
        .Ok(q) -> [render(r.expr) + "=" + (r.name ?? "-") for r in q.returns].join(";"),
        .Err(e) -> e.code,
    }
}

spec "cypher/expressions" {
    given "a WHERE clause" {
        then "AND binds tighter than OR" { where_of("a.x = 1 OR a.y = 2 AND a.z = 3") == "((a.x = 1) OR ((a.y = 2) AND (a.z = 3)))" }
        then "NOT wraps a comparison" { where_of("NOT a.x = 1") == "(NOT (a.x = 1))" }
        then "CONTAINS, parameters and string literals read" {
            where_of("a.name CONTAINS \$needle AND a.kind = 'x'") == "((a.name CONTAINS \$needle) AND (a.kind = 'x'))"
        }
        then "IS NULL and IS NOT NULL read" {
            where_of("a.x IS NULL") == "(a.x IS NULL)" &&
                where_of("a.x IS NOT NULL") == "(a.x IS NOT NULL)"
        }
        then "id() reads as a call, true and null as literals" {
            where_of("id(a) = \$speaker AND a.ok = true AND a.y = null") == "(((id(a) = \$speaker) AND (a.ok = true)) AND (a.y = null))"
        }
        then "a negative number reads" { where_of("a.x >= -3") == "(a.x >= -3)" }
    }
    given "a RETURN list" {
        then "items carry their AS names" {
            returns_of("a.x AS one, a.y, count(*) AS n") == "a.x=one;a.y=-;count(*)=n"
        }
        then "coalesce reads as a call" { returns_of("coalesce(a.ok, false) AS ok") == "coalesce(a.ok,false)=ok" }
    }
}

spec "cypher/refusals" {
    given "clauses outside the read-only subset" {
        then "every write is refused with a mutation code" {
            [
                "CREATE (a:P)",
                "MATCH (a:P) SET a.x = 1 RETURN a",
                "MATCH (a:P) DELETE a",
                "MERGE (a:P)",
                "MATCH (a:P) DETACH DELETE a",
                "MATCH (a:P) REMOVE a.x RETURN a",
            ]
                .all(first_error(it) == "mutation_refused")
        }
        then "a procedure call is refused" { first_error("CALL db.labels()") == "procedure_refused" }
        then "an unsupported clause is named" {
            first_error("MATCH (a:P) WITH a RETURN a.x") == "unsupported_clause" &&
                first_error("MATCH (a:P) RETURN a.x ORDER BY a.x") == "unsupported_clause"
        }
        then "garbage is a syntax refusal" {
            first_error("MATCH (a:P RETURN a.x") == "syntax" &&
                first_error("") == "syntax" &&
                first_error("MATCH (a:P) RETURN a.x %") == "syntax"
        }
        then "a variable-length path still parses, flagged for the compiler" {
            match parse_cypher("MATCH (a:P)-[:p*1..3]->(b:P) RETURN b.x") {
                .Ok(q) -> q.matches[0].pattern.hops[0].rel.var_length,
                .Err(_) -> false,
            }
        }
    }
}

spec "cypher/property maps" {
    given "a node pattern with a property map" {
        then "keys and literal or parameter values read" {
            match parse_cypher("MATCH (p:P {name: 'Ada', age: \$a,}) RETURN p.name") {
                .Ok(q) -> q.matches[0].pattern.first.props.length == 2 &&
                    q.matches[0].pattern.first.props[0].key == "name" &&
                    render(q.matches[0].pattern.first.props[1].value) == "\$a",
                .Err(e) -> {
                    println(e.message)
                    false
                },
            }
        }
        then "a node without a map has none" {
            match parse_cypher("MATCH (p:P) RETURN p.name") {
                .Ok(q) -> q.matches[0].pattern.first.props.is_empty(),
                .Err(_) -> false,
            }
        }
    }
}
