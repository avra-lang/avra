//! THE WIDTH WITNESS, read by Avra. Every number here is wrong by one
//! bit-pattern if the extern seam stops honouring a declared width,
//! and `src/reader.c` prints the same line from the same object — so
//! a disagreement names the boundary, not the C.
extern fn witness_i32_neg() -> i32
extern fn witness_u32_max() -> u32
extern fn witness_out_i32(mut a: i32, mut b: i32) -> i32
extern fn witness_out_i64(mut out: i64) -> i32

mut a = 0
mut b = 0
let _ = witness_out_i32(a, b)
mut w = 0
let _ = witness_out_i64(w)

"ans_i32=${witness_i32_neg()} ans_u32=${witness_u32_max()} out=${a},${b} out64=${w}"
