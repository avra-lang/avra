fn expired_key() -> Bytes {
    pem_of(
        [
            "-----BEGIN PRIVATE KEY-----",
            "MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgaJXoTe1R+2/O6Bc1",
            "QIg1jmct/gYwSQePlAPuaXt2fbuhRANCAARHWBGXF1xQS6SpOU067Jyas+AkwkkX",
            "VEvUz9DiA74Plg29vb4Ln81J4mXkJX/XUTbG1J0V5eE8f5PfWvzxRvZJ",
            "-----END PRIVATE KEY-----",
        ],
    )
}

/// A server presenting localhost first, then the wildcard.
fn named_server() -> Result<Config, TlsError> {
    let s = server()?
    s.presenting(localhost_chain(), localhost_key())?
    s.presenting(wildcard_chain(), wildcard_key())
}

fn served(chain: Bytes, key: Bytes) -> Result<Config, TlsError> {
    (server()?).presenting(chain, key)
}

/// A client's handshake against `sc`, asking for `host`: "<ok>" or
/// the refusal's words.
fn verdict(cc: Result<Config, TlsError>, sc: Config, host: string) -> string {
    match shaken_with(cc, sc, host) {
        .Ok(done) -> if done { "<ok>" } else { "<stalled>" },
        .Err(e) -> e.describe().message,
    }
}

fn shaken_with(cc: Result<Config, TlsError>, sc: Config, host: string) -> Result<bool, TlsError> {
    shaken(paired(cc?, sc, host)?)
}

fn asked(sc: Config, host: string) -> string { verdict(trusting_localhost(), sc, host) }

fn asked_system(host: string) -> string {
    match named_server() { .Ok(sc) -> verdict(client(), sc, host), .Err(e) -> e.describe().message }
}

fn asked_named(host: string) -> string {
    match named_server() { .Ok(sc) -> asked(sc, host), .Err(e) -> e.describe().message }
}

fn asked_of(chain: Bytes, key: Bytes, host: string) -> string {
    match served(chain, key) { .Ok(sc) -> asked(sc, host), .Err(e) -> e.describe().message }
}

fn system_roots_load() -> Result<bool, TlsError> {
    let path? = roots_path() else { return false }
    let c = client()?
    let bundle = read_bytes(path) catch "".bytes()
    let counted = (anchored(bundle)?).trusting(localhost_ca())?
    c.free()?
    !bundle.is_empty() && counted == 1
}

/// The refusal for a certificate no anchor signed.
fn unsigned(host: string) -> string {
    "${host}'s certificate is not trusted: The certificate is not correctly signed by the trusted CA"
}

/// The refusal for a certificate that does not name the host asked for.
fn misnamed(host: string) -> string {
    "${host}'s certificate is not trusted: The certificate Common Name (CN) does not match with the expected CN"
}

/// The refusal for a certificate past its validity.
fn lapsed(host: string) -> string {
    "${host}'s certificate is not trusted: The certificate validity has expired"
}

spec "std.tls certificates" {
    given "a client's default trust" {
        then "the system's bundle is found and loaded" { passes(system_roots_load()) }
        then "the system's anchors do not include the test authority" {
            asked_system("localhost") == unsigned("localhost")
        }
    }
    given "a server holding an identity per name" {
        then "SNI for localhost is answered by the localhost leaf" { asked_named("localhost") == "<ok>" }
        then "SNI for a name under the wildcard is answered through its intermediate" {
            asked_named("api.example.test") == "<ok>"
        }
        then "names are compared ignoring case" { asked_named("API.Example.TEST") == "<ok>" }
        then "a wildcard covers one label, never two" {
            asked_named("a.b.example.test") == misnamed("a.b.example.test")
        }
        then "a wildcard does not cover its own parent" {
            asked_named("example.test") == misnamed("example.test")
        }
    }
    given "what a client verifies" {
        then "an address is checked against the certificate's addresses" { asked_named("127.0.0.1") == "<ok>" }
        then "an address the certificate does not carry is refused" {
            asked_named("127.0.0.2") == misnamed("127.0.0.2")
        }
        then "a chain missing its intermediate is refused" {
            asked_of(wildcard_leaf_alone(), wildcard_key(), "api.example.test") == unsigned("api.example.test")
        }
        then "an expired leaf is refused" {
            asked_of(expired_chain(), expired_key(), "localhost") == lapsed("localhost")
        }
        then "a verifying client that names no host is refused before it trusts anything" {
            asked_named("") == "session naming no host: a verifying client names the host it expects"
        }
    }
}
