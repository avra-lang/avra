//! proves: TLS over loopback with every verb parked — a server task
//! accepts, shakes hands and echoes while the main task dials,
//! verifies the test authority's leaf for localhost, writes, shuts its
//! write side with close_notify and reads the echo back to the
//! server's own close_notify, the two having agreed on http/1.1. One
//! side's error ends the program with its words.
use @std.net.{listen, Listener, NetError}
use @std.time.{secs}
use @std.tls.{TlsConn, TlsError, dial, handshake, wired}
use @std.tls.testing.{trusting_localhost, serving_localhost}

fn echo(l: Listener) -> Result<int, TlsError> {
    let c = handshake(wired(l.accept())?, (serving_localhost()?).offering(["h2", "http/1.1"])?, "")?
    mut total = 0
    while true {
        let b? = c.read(64)? else { break }
        total = total + c.write(b)?
    }
    c.shutdown_write()?
    c.close()?
    .Ok(total)
}

fn drained(c: TlsConn) -> Result<string, TlsError> {
    mut got = ""
    while true {
        let b? = c.read(5)? else { break }
        got = got + (b.text() ?? "?")
    }
    .Ok(got)
}

fn run() -> Result<string, TlsError> {
    let l = wired(listen("127.0.0.1", 0))?
    let server = spawn echo(l)
    let c = dial("localhost", l.port, secs(5), (trusting_localhost()?).offering(["http/1.1"])?)?
    let sent = c.write("hello, secure world".bytes())?
    c.shutdown_write()?
    let back = drained(c)?
    let echoed = server.await?
    let v = c.version()
    let agreed = c.protocol() ?? "<none>"
    c.close()?
    "${sent} ${echoed} ${back} ${v == 772} ${c.version()} ${agreed}"
}

run() catch e -> e.describe().message
