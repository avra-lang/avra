//! THE SETTINGS' PROJECTIONS: the one declaration (`declared.av`) laid
//! into each package that reads it as plain records and one loader,
//! importing nothing above `@std/io`; into this package as `Setting`,
//! each declared setting as data an oracle reading names; and into the
//! runtime as a C header naming every variable, with a reader per switch.
//! Every file is a function of the declaration alone, so `--check`
//! regenerates and compares.
use @std.validate.{FieldShape, FieldKind, Value}
use @std.config.{Variable}
use @std.text.{ascii_lower, from_codepoint}

/// Where a package's settings land: its key under each section, the file
/// they are written to, and the stem their types take.
export type Landing = { key: string, file: string, stem: string }

/// The packages whose Avra reads the settings, lowest first: the first
/// holds the readers, and every other imports them from `READERS_MODULE`.
export const LANDINGS: List<Landing> = [
    Landing {
        key: "program",
        file: "packages/std-program/src/settings/settings.av",
        stem: "Program",
    },
    Landing {
        key: "avrac",
        file: "packages/std-avrac/src/core/settings/settings.av",
        stem: "Avrac",
    },
    Landing { key: "cli", file: "packages/cli/src/settings/settings.av", stem: "Cli" },
]

/// The package key whose settings only the runtime's C reads: its leaves
/// land in no Avra file.
const RUNTIME_KEY: string = "runtime"

/// Where the runtime's header is written.
export const RUNTIME_FILE: string = "runtime/avra_settings.h"

/// Where the first landing's readers are imported from.
const READERS_MODULE: string = "@std.program.settings"

/// Where `Setting` is written.
export const NAMED_FILE: string = "packages/wisp/src/settings/named.av"

/// A file the declaration projects to, and its text.
export type Projection = { file: string, text: string }

/// One declared setting: its section, package, field, dotted path, kind,
/// its value when unset, and its exact variable.
export type Leaf = {
    section: string,
    package: string,
    name: string,
    path: string,
    kind: FieldKind,
    unset: Value,
    variable: string?,
}

/// Every projection of the declaration whose sections are `sections`,
/// whose defaults are `unset` and whose exact names are `variables` —
/// or every reason it cannot be projected.
export fn projections(sections: List<FieldShape>, unset: Value, variables: List<Variable>) -> Result<
    List<Projection>,
    List<string>,
> {
    let leaves = leaves_of(sections, unset, variables)
    let refusals = [refusal for l in leaves for refusal in leaf_refusals(l)]
        .concat(landing_refusals(sections))
    if !refusals.is_empty() { return .Err(refusals) }
    .Ok(
        [package_projection(d, sections, leaves) for d in LANDINGS]
            .concat([named_projection(leaves), runtime_projection(leaves)]),
    )
}

/// Every leaf under every section's packages, in declared order.
export fn leaves_of(sections: List<FieldShape>, unset: Value, variables: List<Variable>) -> List<
    Leaf,
> {
    [leaf(s.name, p.name, f, unset, variables) for s in sections for p in records_in(s.kind) for f in records_in(p.kind)]
}

fn leaf(section: string, package: string, f: FieldShape, unset: Value, variables: List<Variable>) -> Leaf {
    let path = "${section}.${package}.${f.name}"
    Leaf {
        section: section,
        package: package,
        name: f.name,
        path: path,
        kind: f.kind,
        unset: entry(entry(entry(unset, section), package), f.name),
        variable: variables.find(it.path == path)?.name,
    }
}

fn records_in(k: FieldKind) -> List<FieldShape> {
    match k { .Record(fields) -> fields, rest -> [] }
}

fn entry(v: Value, key: string) -> Value {
    match v {
        .Map(entries) -> entries.find(it.key == key)?.value ?? Value.Null,
        rest -> Value.Null,
    }
}

fn leaf_refusals(l: Leaf) -> List<string> {
    let named = if l.variable == null { [unnamed(l.path)] } else { [] }
    let typed = match l.kind {
        .Bool -> if l.unset is .Null { [switch_unset(l.path)] } else { [] },
        .Int -> [],
        .Text -> if spellable(l.unset) { [] } else { [unspellable(l.path)] },
        .Float or .Record(_) or .Records(_) or .Other(_) -> [untyped(l.path)],
    }
    named.concat(typed)
}

/// Whether a text default spells as a literal with no escape.
fn spellable(v: Value) -> bool {
    match v {
        .Text(s) -> !["\"", "\\", "\$", "\n"].any((c) -> s.contains(c)),
        .Null or .Bool(_) or .Int(_) or .Float(_) or .List(_) or .Map(_) -> true,
    }
}

fn landing_refusals(sections: List<FieldShape>) -> List<string> {
    let keys = [d.key for d in LANDINGS].concat([RUNTIME_KEY])
    [unlanded(s.name, p.name) for s in sections for p in records_in(s.kind) if !keys.contains(p.name)]
}

// ── A package's projection ──────────────────────────────────────

fn package_projection(d: Landing, sections: List<FieldShape>, leaves: List<Leaf>) -> Projection {
    let own = [s.name for s in sections]
    let records = [record_text(d, s, [l for l in leaves if l.section == s && l.package == d.key]) for s in own]
    let whole = "export type ${d.stem}Settings = {\n${[whole_field(d, s) for s in own].join("")}}\n"
    let loader = loader_text(d, own, leaves)
    let first = d.key == LANDINGS[0].key
    let imports = if first { READER_IMPORTS } else { readers_used([l for l in leaves if l.package == d.key]) }
    let parts = [header(), imports, whole_doc() + whole, records.join("\n"), loader]
    Projection {
        file: d.file,
        text: if first { parts.concat([readers()]) } else { parts }.join("\n"),
    }
}

/// The import of the readers a package's leaves call.
fn readers_used(leaves: List<Leaf>) -> string {
    let names = [n for n in ["setting_number", "setting_said", "setting_switch"] if leaves.any((l) -> reader(l).starts_with("${n}("))]
    "use ${READERS_MODULE}.{${names.join(", ")}}\n"
}

fn header() -> string {
    "//! GENERATED by `wisp tree settings --write` from packages/wisp/src/settings/declared.av: edit the\n//! declaration, never this file. `wisp tree settings --check` holds it fresh.\n"
}

const READER_IMPORTS: string = "use @std.io.{env}\nuse @std.text.{parse_int}\n"

fn whole_doc() -> string {
    "/// The settings this package's Avra reads, each from its exact variable.\n"
}

fn whole_field(d: Landing, section: string) -> string {
    "    ${section}: ${d.stem}${titled(section)},\n"
}

fn record_text(d: Landing, section: string, leaves: List<Leaf>) -> string {
    let fields = [field_text(l) for l in leaves].join("")
    if leaves.is_empty() { return "export type ${d.stem}${titled(section)} = {}\n" }
    "export type ${d.stem}${titled(section)} = {\n${fields}}\n"
}

fn field_text(l: Leaf) -> string {
    "    ${l.name}: ${type_spelled(l)},\n"
}

fn type_spelled(l: Leaf) -> string {
    let base = match l.kind {
        .Bool -> "bool",
        .Int -> "int",
        .Text -> "string",
        .Float or .Record(_) or .Records(_) or .Other(_) -> "",
    }
    if l.unset is .Null { "${base}?" } else { base }
}

fn loader_text(d: Landing, sections: List<string>, leaves: List<Leaf>) -> string {
    let parts = [section_init(d, s, [l for l in leaves if l.section == s && l.package == d.key]) for s in sections]
    [
        "/// The settings, read once: an unset variable is its default, and a value",
        "/// its type cannot read stops the program, naming the variable.",
        "export once fn ${d.key}_settings() -> ${d.stem}Settings {",
        "    ${d.stem}Settings {",
        parts.join("") + "    }",
        "}",
        "",
    ]
        .join("\n")
}

/// A section's record literal: on one line where it fits the width, else
/// a field a line, as `fmt` lays it.
fn section_init(d: Landing, section: string, leaves: List<Leaf>) -> string {
    let head = "        ${section}: ${d.stem}${titled(section)} {"
    if leaves.is_empty() { return "${head}},\n" }
    let one = "${head} ${[leaf_inline(l) for l in leaves].join(", ")} },"
    if one.length <= WIDTH { return "${one}\n" }
    "${head}\n${[leaf_init(l) for l in leaves].join("")}        },\n"
}

/// The widest line `fmt` keeps whole.
const WIDTH: int = 100

fn leaf_inline(l: Leaf) -> string { "${l.name}: ${reader(l)}" }

fn leaf_init(l: Leaf) -> string {
    "            ${l.name}: ${reader(l)},\n"
}

/// The call that reads a leaf's variable.
fn reader(l: Leaf) -> string {
    let name = "\"${l.variable ?? ""}\""
    match l.unset {
        .Null -> match l.kind {
            .Int -> "setting_number(${name})",
            .Text -> "setting_said(${name})",
            .Bool or .Float or .Record(_) or .Records(_) or .Other(_) -> "",
        },
        .Bool(b) -> "setting_switch(${name}, ${b})",
        .Int(n) -> "setting_number(${name}) ?? ${n}",
        .Text(s) -> "setting_said(${name}) ?? \"${s}\"",
        .Float(_) or .List(_) or .Map(_) -> "",
    }
}

/// The readers the first landing carries and every other imports.
fn readers() -> string {
    [
        "/// A switch's variable: `1` or `true` is on, `0` or `false` off, unset its default.",
        "export fn setting_switch(name: string, unset: bool) -> bool {",
        "    let raw? = setting_said(name) else { return unset }",
        "    let on? = switch_read(raw) else {",
        "        setting_unread(name, raw, \"a switch: 1, 0, true or false\")",
        "        return unset",
        "    }",
        "    on",
        "}",
        "",
        "/// A switch's text read: `1` or `true` on, `0` or `false` off, absent for any other.",
        "export fn switch_read(raw: string) -> bool? {",
        "    if raw == \"1\" || raw == \"true\" { return true }",
        "    if raw == \"0\" || raw == \"false\" { return false }",
        "    null",
        "}",
        "",
        "/// A number's variable.",
        "export fn setting_number(name: string) -> int? {",
        "    let raw? = setting_said(name) else { return null }",
        "    let n? = parse_int(raw) else {",
        "        setting_unread(name, raw, \"a whole number\")",
        "        return null",
        "    }",
        "    n",
        "}",
        "",
        "/// The variable's text, absent when it is unset.",
        "export fn setting_said(name: string) -> string? {",
        "    // LICENSED input.debug_flag: the compiler's settings are the process's own, never an input of what is built",
        "    env(name)",
        "}",
        "",
        "/// A value its setting's type cannot read.",
        "fn setting_unread(name: string, raw: string, want: string) {",
        "    avra_trap(\"`${hole("name")}=${hole("raw")}` is not ${hole("want")}\")",
        "}",
        "",
        "extern fn avra_trap(message: string)",
        "",
    ]
        .join("\n")
}

/// An interpolation hole naming `n`, as generated source spells it.
fn hole(n: string) -> string { "\$" + "{" + n + "}" }

// ── The oracle's names ──────────────────────────────────────────

fn named_projection(leaves: List<Leaf>) -> Projection {
    Projection { file: NAMED_FILE, text: named_text(leaves) }
}

fn named_text(leaves: List<Leaf>) -> string {
    let variants = [variant_line(l) for l in leaves].join("")
    let variables = [arm(l, "\"${l.variable ?? ""}\"") for l in leaves].join("")
    let paths = [arm(l, "\"${l.path}\"") for l in leaves].join("")
    let switches = bool_arms([l.kind is .Bool for l in leaves], leaves)
    let debugs = bool_arms([l.section == "debug" for l in leaves], leaves)
    let every = ["        .${variant(l)},\n" for l in leaves].join("")
    [
        header(),
        "/// A declared setting: what an oracle reading names, never a variable's spelling.",
        "export enum Setting {",
        variants + "}",
        "",
        "impl Setting {",
        "    /// The exact variable it is read from.",
        "    fn variable() -> string {",
        "        match self {",
        variables + "        }",
        "    }",
        "",
        "    /// Its dotted path in the declaration.",
        "    fn path() -> string {",
        "        match self {",
        paths + "        }",
        "    }",
        "",
        "    /// Whether it is a switch, set on by `1`.",
        "    fn switch() -> bool {",
        "        match self {",
        switches + "        }",
        "    }",
        "",
        "    /// Whether it is one of `settings.debug`, what an oracle reading sets.",
        "    fn debug() -> bool {",
        "        match self {",
        debugs + "        }",
        "    }",
        "}",
        "",
        "/// Every declared setting, in declared order.",
        "export fn every_setting() -> List<Setting> {",
        "    [",
        every + "    ]",
        "}",
        "",
    ]
        .join("\n")
}

fn variant_line(l: Leaf) -> string { "    ${variant(l)}\n" }

fn arm(l: Leaf, answer: string) -> string { "            .${variant(l)} -> ${answer},\n" }

/// A bool projection as at most two arms, each an `or`-run of the variants answering it.
fn bool_arms(answers: List<bool>, leaves: List<Leaf>) -> string {
    [run_arm(leaves, answers, side) for side in [true, false] if answers.contains(side)].join("")
}

fn run_arm(leaves: List<Leaf>, answers: List<bool>, side: bool) -> string {
    let run = [".${variant(leaves[i])}" for i in 0..leaves.length if answers[i] == side]
        .join(" or ")
    "            ${run} -> ${side},\n"
}

/// A leaf's variant name: its path, each word titled.
fn variant(l: Leaf) -> string {
    [titled(w) for part in l.path.split(".") for w in part.split("_")].join("")
}

fn titled(word: string) -> string {
    if word.is_empty() { return word }
    let c = word.char_code(0)
    "${from_codepoint(if c >= 97 && c <= 122 { c - 32 } else { c })}${word.substring(1, word.length)}"
}

// ── The runtime's header ────────────────────────────────────────

fn runtime_projection(leaves: List<Leaf>) -> Projection {
    Projection { file: RUNTIME_FILE, text: runtime_text(leaves) }
}

fn runtime_text(leaves: List<Leaf>) -> string {
    [
        "// GENERATED by `wisp tree settings --write` from packages/wisp/src/settings/declared.av: edit the",
        "// declaration, never this file. `wisp tree settings --check` holds it fresh.",
        "//",
        "// Every setting the compiler declares, by its exact variable, and a reader per switch",
        "// that reads it as the Avra projections do. A number or text is parsed where it is read.",
        "#ifndef AVRA_SETTINGS_H",
        "#define AVRA_SETTINGS_H",
        "",
        "#include <stdio.h>",
        "#include <stdlib.h>",
        "#include <string.h>",
        "",
        "void avra_trap(const char* msg) __attribute__((noreturn));",
        "",
        [c_name(l) for l in leaves].join(""),
        "// A switch's variable: `1` or `true` is on, `0` or `false` off, unset its default.",
        "static inline int avra_setting_switch(const char* name, int unset) {",
        "    const char* raw = getenv(name);",
        "    if (!raw) return unset;",
        "    if (strcmp(raw, \"1\") == 0 || strcmp(raw, \"true\") == 0) return 1;",
        "    if (strcmp(raw, \"0\") == 0 || strcmp(raw, \"false\") == 0) return 0;",
        "    char words[300];",
        "    snprintf(words, sizeof words, \"`%s=%.200s` is not a switch: 1, 0, true or false\", name, raw);",
        "    avra_trap(words);",
        "}",
        "",
        [c_switch(l) for l in leaves if l.kind is .Bool].join(""),
        "#endif",
        "",
    ]
        .join("\n")
}

/// A leaf's name in C: its variable under `AVRA_SET_`.
fn c_name(l: Leaf) -> string {
    "// ${l.path}: ${c_kind(l)}\n#define AVRA_SET_${c_stem(l)} \"${l.variable ?? ""}\"\n"
}

fn c_kind(l: Leaf) -> string {
    match l.unset {
        .Null -> match l.kind {
            .Int -> "a whole number, else unset",
            .Text -> "text, else unset",
            .Bool or .Float or .Record(_) or .Records(_) or .Other(_) -> "",
        },
        .Bool(b) -> "a switch, ${if b { "on" } else { "off" }} when unset",
        .Int(n) -> "a whole number, ${n} when unset",
        .Text(s) -> "text, `${s}` when unset",
        .Float(_) or .List(_) or .Map(_) -> "",
    }
}

/// A switch's reader, at its declared default.
fn c_switch(l: Leaf) -> string {
    let on = match l.unset { .Bool(b) -> b, rest -> false }
    "static inline int ${ascii_lower("AVRA_SET_${c_stem(l)}")}(void) { return avra_setting_switch(AVRA_SET_${c_stem(l)}, ${if on { 1 } else { 0 }}); }\n"
}

/// A variable without its `AVRA_` prefix.
fn c_stem(l: Leaf) -> string {
    let v = l.variable ?? ""
    if v.starts_with("AVRA_") { v.substring(5, v.length) } else { v }
}

// ── Voices ──────────────────────────────────────────────────────

fn unnamed(path: string) -> string {
    "settings: `${path}` names no variable — a setting is read from its exact name, `@variable(\"AVRA_…\")`"
}

fn switch_unset(path: string) -> string {
    "settings: `${path}` is a switch with no value when unset — a switch is off or on, `= false`"
}

fn unspellable(path: string) -> string {
    "settings: `${path}`'s default holds a quote, a backslash, a `\$` or a line break — a default is plain text"
}

fn untyped(path: string) -> string {
    "settings: `${path}` is neither a switch, a number nor text — a setting is `bool`, `int` or `string`"
}

fn unlanded(section: string, package: string) -> string {
    "settings: `${section}.${package}` names no package that reads settings — add its landing to LANDINGS"
}
