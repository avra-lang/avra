use @std.meta.{derive}
use @std.validate.{Decode}
use @std.config.{Configured, flags}

/// A record of this file's own, which the derive's code below never reads.
type Loaded = { count: int }

@derive(Decode)
component Knobs {
    depth: int = 3
    flags ["--depth=4"]
}

export fn counted() -> int { Loaded { count: 2 }.count }

export fn depth() -> int {
    match Knobs.load() { .Ok(l) -> l.value.depth, .Err(_) -> 0 }
}

/// What the witness shows: the private record's count, then the config's depth.
export fn told() -> string { "${counted()} ${depth()}" }
