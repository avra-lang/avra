// A derive's code reads its names where its quote was written: the `Configured` impl
// `@Decode` writes names `Loaded`, and neither a private `Loaded` in a sibling file of the
// module it lands in nor one in the very file it lands in is the one it reads.
use tests.hygiene.{told}
use tests.hygiene_own.{told as told_own}

spec "a derive's names bind where its quote was written" {
    given "a module that declares a `Loaded` of its own" {
        then "a sibling file's private one takes nothing from the derive" { told() == "2 4" }
        then "the landing file's own takes nothing from it either" { told_own() == "2 4" }
    }
}
