//! `wisp` — the tree's instruments as one program, a command each
//! under `commands/`. This entry composes them and nothing else.
//! Exit 0 clean, 1 refused, 2 usage.

use @std.cli.{cli, argv}
use @std.process.{exit, Exit}
use commands.{
    pr_mode,
    ci_path_gate,
    host_events,
    suites,
    tree_settings,
    cost,
    mutations,
    oracle,
    keepers,
    parser,
    preflight,
    bench,
    ci_invariants,
    inputs,
    defects,
    release,
    libs,
    ladder,
    ladder_clean,
    reclaim,
}

cli wisp {
    description: "The tree's instruments"
    version: "0.0.1"
    pr_mode
    ci_path_gate
    host_events
    suites
    tree_settings
    cost
    mutations
    oracle
    keepers
    parser
    preflight
    bench
    ci_invariants
    inputs
    defects
    release
    libs
    ladder
    ladder_clean
    reclaim
}
exit(Exit.Code(wisp.run()))
