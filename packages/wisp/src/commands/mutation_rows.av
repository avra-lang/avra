            ],
        },
        Break {
            name: "a virtual task's site is not in the trace",
            file: Unit.Fiber,
            edits: [Edit { old: "    if (TRACING) traced_site(virtual_at(t), site, NULL);\n", new: "" }],
        },
        Break {
            name: "a cancel displaces a claim",
            file: Unit.Fiber,
            edits: [
                Edit {
                    old: "    if (f->parked && !shield_scope_stands(f)) set_claimed(f, -1, 0, by);",
