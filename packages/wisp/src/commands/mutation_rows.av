//! The breaks `wisp mutations` makes: each one line of a scheduler source, or the few
//! that make one fault, and some runtime test must fail for it.

/// The source a break edits.
enum Unit {
    Fiber
    Clock
    Door
    Host
}

/// One text replacement; its `old` must stand exactly once in the source.
type Edit = { old: string, new: string }

type Break = { name: string, file: Unit, edits: List<Edit> }

const VTASK_ASKED: string = "int64_t avra_vtask_asked(int64_t t) { return virtual_at(t)->cancel_by != 0; }"
const VTASK_SHIELDED: string = "int64_t avra_vtask_shielded(int64_t t) { return virtual_at(t)->shield_depth != 0; }"

/// The deadline claims only a wait that heeds it.
fn deadline_heeds() -> Edit {
    Edit {
        old: "    if (f->parked && f->heeds) set_claimed(f, -1, 1, BY_DEADLINE);",
        new: "    if (f->parked) set_claimed(f, -1, 1, BY_DEADLINE);",
    }
}

/// The switch's floor test, spelled by the machine's assembly.
fn floor() -> List<Edit> {
    if on_arm() {
        [Edit { old: "    \"    b.lo 1f\\n\"\n", new: "    \"    nop\\n\"\n" }]
    } else {
        [Edit { old: "    \"    jb 1f\\n\"\n", new: "    \"    nop\\n\"\n" }]
    }
}

/// The switch's canary test, spelled by the machine's assembly.
fn canary() -> List<Edit> {
    if on_arm() {
        [Edit { old: "    \"    cbnz x10, 1f\\n\"\n", new: "    \"    nop\\n\"\n" }]
    } else {
        [Edit { old: "    \"    jne 1f\\n\"\n", new: "    \"    nop\\n\"\n" }]
    }
}

/// Every break, in the order the shards number them.
fn breaks() -> List<Break> {
    [
        // MUTATIONS
        Break { name: "the switch does not test the floor", file: Unit.Fiber, edits: floor() },
        Break { name: "the switch does not test the canary", file: Unit.Fiber, edits: canary() },
        Break {
            name: "a claimant leaves the winner filed",
            file: Unit.Fiber,
            edits: [
                Edit {
                    old: "    waiter_out(w);\n    return set_claimed(w->fiber, w->arm, w->member, by);",
                    new: "    return set_claimed(w->fiber, w->arm, w->member, by);",
