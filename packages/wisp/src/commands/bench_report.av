//! THE REPORTER: a PURE PROJECTION of the stored rows into `benchmarks/report/results.md` and
//! `index.html`. It measures nothing and reads no clock, so one `results/runs.jsonl` renders
//! byte-identically every time — the self-test holds the committed report to a fresh projection.
use @std.io.{read_text, write_text, make_dirs, is_file}
use @std.path.{joined_path}
use @std.text.{repeat, text_before}

const HEADER: List<string> = [
    "# Avra benchmark report",
    "",
    "_GENERATED by `benchmarks/run.sh --report` from",
    "`benchmarks/results/runs.jsonl`. Never hand-edit: edit a `spec.toml` or a",
    "language's program and run `--record` again._",
    "",
    "The suite measures concurrency and task primitives across languages.",
    "Every language's twin for one benchmark must satisfy the SAME invariant,",
    "written in its `spec.toml`; the rows differ only in what is timed. A",
    "value is the run's own report — typically the least of the program's",
    "`samples` rounds — and the sample count stands beside it. A versionless",
    "number is a claim, so every row carries its toolchain and machine.",
    "",
    "See `benchmarks/README.md` for the JSON schema, the row contract, and how",
    "to add a benchmark or a language.",
    "",
]

const STYLE: string = "<style>body{font:15px/1.5 system-ui,sans-serif;max-width:60rem;margin:2rem auto;padding:0 1rem}table{border-collapse:collapse;margin:1rem 0}th,td{border:1px solid #ccc;padding:.3rem .6rem;text-align:right}td:first-child,th:first-child{text-align:left}code{background:#f4f4f4;padding:.1rem .3rem}h2{border-top:1px solid #ddd;padding-top:1rem}</style></head><body>"

fn report_dir() -> string { joined_path(bench_root(), "report") }

// ── formatting ───────────────────────────────────────────────────

fn human_bytes(v: float) -> string {
    if v >= 1048576.0 { return "${fixed(v / 1048576.0, 1)} MB" }
    if v >= 1024.0 { return "${fixed(v / 1024.0, 1)} kB" }
    "${fixed(v, 0)} B"
}

fn shown_value(unit: string, v: float) -> string {
    match unit {
        "ns" -> when {
            v < 1000.0 -> "${fixed(v, 1)} ns"
            v < 1000000.0 -> "${fixed(v / 1000.0, 2)} µs"
            _ -> "${fixed(v / 1000000.0, 2)} ms"
        },
        "bytes" -> human_bytes(v),
        "ops" -> "${thousands_grouped(v)} ops",
        _ -> "${general(v, 6)} ${unit}",
    }
}

/// A cell: the value in its unit, the sample count beside it.
fn cell_text(unit: string, v: float, samples: int) -> string { "${shown_value(unit, v)} (${samples})" }

/// The stored run at a place, the last one stored when two are.
fn run_at(runs: List<Run>, bench: string, lang: string, machine: string) -> Run? {
    runs.filter(it.benchmark == bench && it.language == lang && it.machine == machine).last()
}

fn shown_cell(runs: List<Run>, bench: string, lang: string, machine: string, r: RowSpec) -> string {
    let run? = run_at(runs, bench, lang, machine) else { return "—" }
    let m? = run.rows.find(it.name == r.name) else { return if run.notes.starts_with("SKIPPED") { "SKIPPED" } else { "—" } }
    cell_text(if m.unit.is_empty() { r.unit } else { m.unit }, m.value, m.samples)
}

/// The version a machine last stored for a language, or "".
fn version_at(runs: List<Run>, machine: string, lang: string) -> string {
    runs
        .filter(
            it.machine == machine &&
                it.language == lang &&
                !it.version.is_empty() &&
                it.version != "unknown",
        )
        .last()?.version ?? ""
}

fn machines_of(runs: List<Run>) -> List<string> {
    ordered_by(distinct_words(runs.map(it.machine)), text_before)
}

/// The languages a benchmark measures that were skipped here, with their notes.
fn skipped_here(runs: List<Run>, b: Bench, langs: List<string>, machine: string) -> List<Said> {
    [Said { key: l, text: r!.notes } for l in langs for r in [run_at(runs, b.key, l, machine)] if r != null && r!.notes.starts_with("SKIPPED")]
}

// ── markdown ─────────────────────────────────────────────────────

fn markdown(runs: List<Run>, reg: Registry, benches: List<Bench>) -> string {
    let sections = machines_of(runs).flat_map((m) -> machine_md(runs, reg, benches, m))
    HEADER.join("\n") +
        "\n" +
        sections.join("\n") +
        "\n_Projected from ${runs.length} stored row(s)._\n"
}

fn machine_md(runs: List<Run>, reg: Registry, benches: List<Bench>, machine: string) -> List<string> {
    let versions = ["| ${l.title} | `${version_at(runs, machine, l.name)}` |" for l in reg.languages if !version_at(runs, machine, l.name).is_empty()]
    ["## Machine `${machine}`\n", "| language | version |", "|---|---|"]
        .concat(versions)
        .concat([""])
        .concat(benches.flat_map((b) -> bench_md(runs, reg, b, machine)))
}

fn bench_md(runs: List<Run>, reg: Registry, b: Bench, machine: string) -> List<string> {
    let s = b.declared
    let langs = listed_languages(reg, s)
    let lead = ["### `${b.key}` — ${s.title ?? b.key}\n"]
        .concat(present_when(!s.invariant.is_empty(), "**Invariant.** ${s.invariant}\n"))
        .concat(present_when(!s.row.is_empty(), "**Row.** ${s.row}\n"))
        .concat(
            present_when(
                !s.workload.is_empty(),
                "**Workload.** ${["`${w.key}=${w.text}`" for w in s.workload].join(", ")}\n",
            ),
        )
        .concat(
            present_when(
                !s.analogues.is_empty(),
                "**Analogues.** ${["**${title_of(reg, a.key)}** — ${a.text}" for a in s.analogues].join("; ")}\n",
            ),
        )
    let grid = [
        "| row (unit) | ${[title_of(reg, l) for l in langs].join(" | ")} |",
        "|---|${repeat("---|", langs.length)}",
    ]
        .concat(
            ["| `${r.name}` (${r.unit}) | ${[shown_cell(runs, b.key, l, machine, r) for l in langs].join(" | ")} |" for r in s.rows],
        )
        .concat([""])
    let legend = ["`${r.name}` (${r.unit}) — ${r.about}" for r in s.rows if !r.about.is_empty()]
    let legend_lines = if legend.is_empty() { [] } else { ["_Rows:_ ${legend.join("; ")}.", ""] }
    let skipped = skipped_here(runs, b, langs, machine)
    let skipped_lines = if skipped.is_empty() {
        []
    } else {
        ["Not measured here:"]
            .concat(["- **${title_of(reg, k.key)}** — ${k.text}" for k in skipped])
            .concat([""])
    }
    lead.concat(grid).concat(legend_lines).concat(skipped_lines)
}

fn present_when(shown: bool, line: string) -> List<string> { if shown { [line] } else { [] } }

// ── html ─────────────────────────────────────────────────────────

fn esc(text: string) -> string { text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;") }

fn html(runs: List<Run>, reg: Registry, benches: List<Bench>) -> string {
    let head = [
        "<!doctype html>",
        "<html lang=\"en\"><head><meta charset=\"utf-8\">",
        "<title>Avra benchmark report</title>",
        STYLE,
        "<h1>Avra benchmark report</h1>",
        "<p>Generated by <code>benchmarks/run.sh --report</code> from <code>benchmarks/results/runs.jsonl</code>. Never hand-edit.</p>",
    ]
    head
            .concat(machines_of(runs).flat_map((m) -> machine_html(runs, reg, benches, m)))
            .concat(["</body></html>"])
            .join("\n") +
        "\n"
}

fn machine_html(runs: List<Run>, reg: Registry, benches: List<Bench>, machine: string) -> List<
    string,
> {
    let versions = ["<tr><td>${esc(l.title)}</td><td><code>${esc(version_at(runs, machine, l.name))}</code></td></tr>" for l in reg.languages if !version_at(runs, machine, l.name).is_empty()]
    [
        "<h2>Machine <code>${esc(machine)}</code></h2>",
        "<table><tr><th>language</th><th>version</th></tr>",
    ]
        .concat(versions)
        .concat(["</table>"])
        .concat(benches.flat_map((b) -> bench_html(runs, reg, b, machine)))
}

fn bench_html(runs: List<Run>, reg: Registry, b: Bench, machine: string) -> List<string> {
    let s = b.declared
    let langs = listed_languages(reg, s)
    let lead = ["<h3><code>${esc(b.key)}</code> — ${esc(s.title ?? b.key)}</h3>"]
        .concat(present_when(!s.invariant.is_empty(), "<p><b>Invariant.</b> ${esc(s.invariant)}</p>"))
        .concat(present_when(!s.row.is_empty(), "<p><b>Row.</b> ${esc(s.row)}</p>"))
        .concat(
            present_when(
                !s.workload.is_empty(),
                "<p><b>Workload.</b> ${["<code>${esc(w.key)}=${esc(w.text)}</code>" for w in s.workload].join(", ")}</p>",
            ),
        )
        .concat(
            present_when(
                !s.analogues.is_empty(),
                "<p><b>Analogues.</b> ${["<b>${esc(title_of(reg, a.key))}</b> — ${esc(a.text)}" for a in s.analogues].join("; ")}</p>",
            ),
        )
    let grid = [
        "<table><tr><th>row (unit)</th>${["<th>${esc(title_of(reg, l))}</th>" for l in langs].join("")}</tr>",
    ]
        .concat(
            ["<tr><td><code>${esc(r.name)}</code> (${esc(r.unit)})</td>${["<td>${esc(shown_cell(runs, b.key, l, machine, r))}</td>" for l in langs].join("")}</tr>" for r in s.rows],
        )
        .concat(["</table>"])
    let skipped = skipped_here(runs, b, langs, machine)
    let skipped_lines = if skipped.is_empty() {
        []
    } else {
        ["<p>Not measured here:</p><ul>"]
            .concat(["<li><b>${esc(title_of(reg, k.key))}</b> — ${esc(k.text)}</li>" for k in skipped])
            .concat(["</ul>"])
    }
    lead.concat(grid).concat(skipped_lines)
}

// ── the projection ───────────────────────────────────────────────

/// The two pages a projection writes.
type Pages = { md: string, html: string }

fn rendered() -> Result<Pages, string> {
    let runs = stored_runs(results_path())?
    let reg = registry_at(joined_path(bench_root(), "bench.toml"))?
    let benches = benches_under(null)?
    Pages { md: markdown(runs, reg, benches), html: html(runs, reg, benches) }
}

/// The report projected into `benchmarks/report`.
fn write_report() -> Result<Pages, string> {
    let pages = rendered()?
    let _ = make_dirs(report_dir())
    written_file(joined_path(report_dir(), "results.md"), pages.md)?
    written_file(joined_path(report_dir(), "index.html"), pages.html)?
    pages
}

/// The committed pages that differ from a fresh projection, by name.
fn report_drift() -> Result<List<string>, string> {
    let pages = rendered()?
    let committed = (name: string) -> {
        let path = joined_path(report_dir(), name)
        if is_file(path) { read_text(path) catch "" } else { "" }
    }
    [n for n in ["results.md", "index.html"] if committed(n) != if n == "results.md" { pages.md } else { pages.html }]
}
