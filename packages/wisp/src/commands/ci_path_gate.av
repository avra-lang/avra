/// The paths `job` reads where they're narrower than the tree; null is every path.
fn reads_of(job: string) -> List<string>? { PATH_ROWS.find(it.job == job && !it.beside_compiler)?.reads }

/// What a check reads beside the compiler's own source, for one whose input is otherwise fixed: null
/// for every other.
export fn reads_compiler(job: string) -> List<string>? { PATH_ROWS.find(it.job == job && it.beside_compiler)?.reads }

fn reads(path: string, entry: string) -> bool {
    let name = path.split("/").last() ?? path
    path == entry ||
        entry.ends_with("/") && path.starts_with(entry) ||
        entry == "*" && !name.contains(".") ||
        entry.starts_with("*.") && name.ends_with(entry.substring(1, entry.length))
}

/// Whether a change owes `job`, `compiler` the compiler's source paths a compiler-read row is judged by.
export fn owed(job: string, event: string, changed: List<string>, compiler: List<string>) -> bool {
    let beside? = reads_compiler(job) else { return owes(job, event, changed) }
    if event != "pull_request" { return true }
    changed
        .any(
            (path) -> beside.any((entry) -> reads(path, entry)) ||
                compiler.any((c) -> reads(path, c) || reads(path, "${c}/")),
        )
}

export fn owes(job: string, event: string, changed: List<string>) -> bool {
    if event != "pull_request" { return true }
    let entries? = reads_of(job) else { return !changed.is_empty() }
    changed.any((path) -> entries.any((entry) -> reads(path, entry)))
}
