/// The sets a keeper is asked by: `all` (the train), a leg, `a` (both A halves), `static`, `pr`.
export fn in_set(k: Keeper, set: string) -> bool {
    match set {
        "all" -> true,
        "alone" -> k.leg == .Alone,
        "a" -> k.leg == .A1 || k.leg == .A2,
        "a1" -> k.leg == .A1,
        "a2" -> k.leg == .A2,
        "b" -> k.leg == .B,
        "wasm" -> k.leg == .Wasm,
        "static" -> k.free,
        "pr" -> k.pr,
        rest -> false,
    }
}

/// Each set's word and the Make variable it once was, which tools/ci_invariants.py still reads.
type SetName = { word: string, variable: string }

const SETS: List<SetName> = table<SetName> {
    word     | variable
    "all"    | "KEEPERS"
    "alone"  | "KEEPERS_ALONE"
    "a"      | "KEEPERS_A"
    "a1"     | "KEEPERS_A1"
    "a2"     | "KEEPERS_A2"
    "b"      | "KEEPERS_B"
    "wasm"   | "KEEPERS_WASM"
    "static" | "KEEPERS_STATIC"
    "pr"     | "KEEPERS_PR"
}

/// The sets as `KEEPERS_<SET> = <names>` lines.
export fn sets_text() -> string {
    SETS.map((s) -> "${s.variable} = ${members(s.word).join(" ")}").join("\n")
}

fn members(set: string) -> List<string> {
    KEEPERS.filter((k) -> in_set(k, set)).map(it.name)
}

type KeepersCmd = {}

impl Runnable for KeepersCmd {
    fn run(args: CliResult) -> int {
        if args.has_flag("sets") {
            println(sets_text())
            return 0
        }
        let set = args.option("set")
        if !SETS.any(it.word == set) {
            eprintln(no_set(set))
            return 2
        }
        let named = args.args_of("names")
        let unknown = named.filter((n) -> !KEEPERS.any(it.name == n))
        if !unknown.is_empty() {
            eprintln(no_keeper(unknown))
            return 2
        }
        let chosen = members(set).filter((n) -> named.is_empty() || named.contains(n))
        let refused = refusals(chosen, ran)
        if refused.is_empty() {
            0
        } else {
            eprintln(refused_all(refused))
            1
        }
    }
}

export command keepers {
    description: "Run the keepers: every one named, or every one in a set, the refusals named last"
    arg names {
        description: "the keepers to run; none runs the whole set"
        variadic: true
    }
    option set {
        description: "all, alone, a, a1, a2, b, wasm, static or pr"
        default: "all"
    }
    flag sets { description: "print each set as a `KEEPERS_<SET> = …` line and run nothing" }
    run: KeepersCmd {}
}

/// Runs each keeper in order through `held`; the names of those that refused.
export fn refusals(names: List<string>, held: fn(string) -> bool) -> List<string> {
    names.filter((n) -> !timed(n, held))
}

fn timed(name: string, held: fn(string) -> bool) -> bool {
    eprintln(running(name))
    let t0 = now_ms()
    let ok = held(name)
    if !ok { eprintln(refused_one(name)) }
    println(took(name, (now_ms() - t0) / 1000))
    ok
}

/// One keeper, run by its Make target with the invoker's environment: the recipe owns what it reads.
fn ran(name: string) -> bool {
    match tool("make") {
        .Ok(make) -> clean(
            (cmd(make, ["-s", "-o", "avra", name]) with { env: inherited(), streams: .Inherited })
                .outcome(),
        ),
        .Err(_) -> false,
    }
}

fn clean(o: Result<Outcome, ProcessError>) -> bool {
    match o { .Ok(done) -> exited_clean(done.exit), .Err(_) -> false }
}

fn exited_clean(e: Exit) -> bool {
    match e { .Clean -> true, .Code(_) or .Signal(_, _) -> false }
}

// ── voices ──

fn running(name: string) -> string {
    "keepers: running ${name}"
}

fn refused_one(name: string) -> string {
    "keepers: ${name} refused"
}

fn took(name: string, seconds: int) -> string {
    "keepers: ${name} ${seconds}s"
}

fn refused_all(names: List<string>) -> string {
    "keepers: REFUSED: ${names.join(" ")}"
}

fn no_set(set: string) -> string {
    "keepers: no set `${set}`; the sets are ${SETS.map(it.word).join(", ")}"
}

fn no_keeper(names: List<string>) -> string {
    "keepers: no keeper named ${names.map("`${it}`").join(", ")}"
}
