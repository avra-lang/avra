//! `wisp keepers [<name>…] [--set <set>] [--sets]` — THE KEEPERS, ONE REGISTRY. Every check the
//! train holds a landing to is a row: its name (the Make target that runs it), the leg of CI that
//! runs it, and whether a pull request's own check runs it too — with no compiler (`free` of one, the
//! `static` set), or
//! once its compiler is built (`pr`). A set is a question asked of the rows, never a list of its
//! own, so a keeper cannot be named in a set and missing from the train.
//! Each keeper runs, each refusal is said as it happens, and the LAST line names every refusal:
//! a refusal mid-stream scrolls away under the ones after it. Exit 0 all held, 1 one refused,
//! 2 usage.
use @std.cli.{CliResult, Runnable, arg, command, flag, option}
use @std.process.{Exit, Outcome, ProcessError, cmd, tool, inherited}
use @std.time.{now_ms}

/// Which CI leg runs a keeper. `Alone` keepers are held to a clock, so nothing shares their
/// runner; `A1`/`A2` and `B` are balanced by measured seconds; `Wasm` is the wasm target's
/// proof; `Train` runs only in the whole list.
export enum Leg {
    Train
    Alone
    A1
    A2
    B
    Wasm
}

export type Keeper = { name: string, leg: Leg, free: bool, pr: bool }

/// Every keeper, by the leg that runs it.
export const KEEPERS: List<Keeper> = table<Keeper> {
    name                   | leg    | free  | pr
    "clock-holds"          | .Train | false | false
    "runtime-tests"        | .Alone | false | false
    "runtime-mutations"    | .Alone | false | false
    "speed-ratchet"        | .A1    | false | true
    "cost"                 | .A1    | false | false
    "fmt-lossless"         | .A1    | false | false
    "hash-door"            | .A1    | false | false
    "stems"                | .A1    | false | false
    "read-cost"            | .A2    | false | false
    "read-lists"           | .A2    | false | false
    "warm-edit"            | .A2    | false | true
