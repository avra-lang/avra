//! THE COST SURFACE: what the compiler costs, as the tree records it under `cost/` — one file a
//! workload (a matrix part's edits its sections), every measure a line. A count is a number the
//! census compiler counts the same on every machine; a told count is printed and judged by nothing,
//! its ticket beside it; a share is a count held per million of the program; a clock is a time, held
//! within a band of its accepted value and under its target, never to an exact value.
//!
//! The files ARE the ledger: `wisp cost show` renders them, and every other reader projects them to
//! the rows `wisp cost` judges (`surface_rows`), so one record has one reading.
use @std.io.{read_text, list_dir, is_dir}
use @std.path.{joined_path}
use @std.text.{parse_int, repeat, text_before}
use @std.program.sorted.{sorted_by}

/// Where the record stands, beside the tree's root.
export const SURFACE: string = "cost"

/// What a measure is, and so how it is judged.
export enum CostKind {
    Count
    Told
    Share
    Clock
}

/// One measure of a workload: its kind, its counter, its value, and what a clock or a told count
/// carries after it (a band, a target, an over line's owner and ticket, a told count's ticket).
export type CostMeasure = { kind: CostKind, counter: string, value: int, extra: List<string> }

/// One workload's measures, under its name.
export type CostSection = { workload: string, measures: List<CostMeasure> }

/// One file of the record: where it stands under `cost/`, its comment lines, its workloads, and every
/// line it holds that reads as no measure.
export type CostFile = {
    path: string,
    header: List<string>,
    sections: List<CostSection>,
    unread: List<string> = [],
}

// THE FILES

/// A file's text read back: `# ` comment lines, `[<workload>]` headers, and a measure a line.
export fn cost_file(path: string, text: string) -> CostFile {
    mut header: List<string> = []
    mut sections: List<CostSection> = []
    mut workload = ""
    mut measures: List<CostMeasure> = []
    mut unread: List<string> = []
    for raw in text.split("\n") {
        let line = raw.trim()
        if line.is_empty() { continue }
        if line.starts_with("#") {
            if sections.is_empty() && workload.is_empty() { header.push(line) }
            continue
        }
        if line.starts_with("[") && line.ends_with("]") {
            if !workload.is_empty() { sections.push(section(workload, measures)) }
            workload = line.substring(1, line.length - 1)
            measures = []
            continue
        }
        let m? = measure_line(line) else {
            unread.push(line)
            continue
        }
        measures.push(m)
    }
    if !workload.is_empty() { sections.push(section(workload, measures)) }
    CostFile { path: path, header: header, sections: sections, unread: unread }
}

/// A file as the record writes it: its comments, then each workload and its measures, in order.
export fn file_text(f: CostFile) -> string {
    let head = [key_line(h) for h in f.header].join("")
    let body = [section_text(s) for s in f.sections].join("\n")
    "${head}${if head.is_empty() { "" } else { "\n" }}${body}"
}

fn section_text(s: CostSection) -> string { "[${s.workload}]\n${[key_line(measure_text(m)) for m in s.measures].join("")}" }

fn key_line(s: string) -> string { "${s}\n" }

/// `<kind> <counter> <value>`, then what the measure carries.
fn measure_text(m: CostMeasure) -> string {
    ["${kind_word(m.kind)} ${m.counter} ${m.value}"].concat(m.extra).join(" ")
}

fn measure_line(line: string) -> CostMeasure? {
    let w = line.split(" ")
    if w.length < 3 { return null }
    let kind? = kind_named(w[0]) else { return null }
    let value? = parse_int(w[2]) else { return null }
    CostMeasure { kind: kind, counter: w[1], value: value, extra: w.drop(3) }
}

fn kind_word(k: CostKind) -> string {
    match k { .Count -> "count", .Told -> "told", .Share -> "share", .Clock -> "clock" }
}

fn kind_named(word: string) -> CostKind? {
    match word {
        "count" -> CostKind.Count,
        "told" -> CostKind.Told,
        "share" -> CostKind.Share,
        "clock" -> CostKind.Clock,
        _ -> null,
    }
}

/// Every file under `root`'s `cost/`, read back, by its path under it.
export fn surface_at(root: string) -> List<CostFile> {
    let top = joined_path(root, SURFACE)
    [cost_file(p, read_text(joined_path(top, p)) catch "") for p in record_files(top, "")]
}

fn record_files(top: string, at: string) -> List<string> {
    let here = if at.is_empty() { top } else { joined_path(top, at) }
    let names = sorted_by(list_dir(here) catch [], text_before)
    flatten_paths(
        [when {
            is_dir(joined_path(here, n)) -> record_files(top, under_path(at, n))
            n.ends_with(".cost") -> [under_path(at, n)]
            _ -> []
        } for n in names],
    )
}

fn under_path(at: string, n: string) -> string { if at.is_empty() { n } else { "${at}/${n}" } }

fn flatten_paths(xs: List<List<string>>) -> List<string> { xs.fold([], (all, x) -> all.concat(x)) }

// THE ROWS

/// The record as the rows `wisp cost` judges: `<workload> <counter>` for a census, ledger or matrix
/// count, `<kind>:<key>:<workload> <counter>` for a keyed one — the key the file's name under its
/// family's directory.
export fn surface_rows(files: List<CostFile>) -> Map<string, int> {
    mut rows: Map<string, int> = {}
    for f in files {
        for s in f.sections {
            for m in s.measures {
                let k? = row_key(f.path, s.workload, m) else { continue }
                rows.set(k, m.value)
            }
        }
    }
    rows
}

/// The row a measure of `workload` in the file at `path` projects to; none where the record holds no
/// such family.
fn row_key(path: string, workload: string, m: CostMeasure) -> string? {
    let w? = row_workload(path, workload, m.kind) else { return null }
    "${w} ${m.counter}"
}

/// The row's workload for a measure of `workload` in the file at `path`: an unkeyed family's rows are
/// their workload's, a keyed one's carry its kind and the file's key. None for a family the record
/// does not hold.
fn row_workload(path: string, workload: string, kind: CostKind) -> string? {
    let key = key_of(path)
    match path.split("/").first() ?? "" {
        "census" or "ledger" or "matrix" -> workload,
        "speed" -> "speed:${key}:${workload}",
        "warm" -> "warm:${key}:${workload}",
        "wall" -> "wall:${key}:${workload}",
        "footprint" -> "bytes:${key}:${workload}",
        "grows" -> "grows:${key}:${workload}",
        "gate" -> "gate:${key}:${workload}",
        "proofs" -> "proofs:-:${workload}",
        "reads" -> "reads:-:${workload}",
        "work" -> "${work_kind(kind)}:-:${workload}",
        _ -> null,
    }
}

fn work_kind(kind: CostKind) -> string {
    match kind { .Count -> "work", .Told -> "told", .Share -> "share", .Clock -> "work" }
}

/// The key a keyed family's file names: its file name without `.cost`.
fn key_of(path: string) -> string {
    let name = path.split("/").last() ?? path
    name.substring(0, name.length - 5)
}

// THE MIGRATION

/// The record a ledger's text holds, as files: each row placed in the family its workload
/// names, a matrix part's edits and the edits of the cli's warm check sections of one file each, and
/// each keyed row in its key's file; a target and an over line ride the clock they hold.
export fn migrated(
    baseline: string,
    rows: Map<string, int>,
    targets: List<string>,
    overs: List<string>,
) -> List<CostFile> {
    mut by_file: Map<string, Map<string, List<CostMeasure>>> = {}
    for key in sorted_by([k for k, _n in rows], text_before) {
        let w = key.split(" ")
        let place? = placed(w[0]) else { continue }
        let m = CostMeasure {
            kind: place.kind,
            counter: w[1],
            value: rows.get(key) ?? 0,
            extra: carried(key, place, targets, overs),
        }
        let sections = by_file.get(place.path) ?? {}
        by_file
            .set(
                place.path,
                {..sections, place.workload: (sections.get(place.workload) ?? []).concat([m])},
            )
    }
    let _ = baseline
    [CostFile {
        path: p,
        header: [header_for(p)],
        sections: [CostSection { workload: w, measures: ms } for w, ms in secs],
    } for p, secs in by_file]
}

/// Where a row lies: its file, its section, its kind.
type CostPlaced = { path: string, workload: string, kind: CostKind }

/// Where a row of `workload` lies; none for a keyed row whose kind no family holds.
fn placed(workload: string) -> CostPlaced? {
    let parts = workload.split(":")
    if parts.length == 3 { return keyed(parts[0], parts[1], parts[2]) }
    if workload.starts_with("matrix-") {
        let w = workload.split("-")
        return CostPlaced {
            path: "matrix/${w[1]}-${w[2]}.cost",
            workload: workload,
            kind: CostKind.Count,
        }
    }
    if workload.starts_with("ledger-edit-") { return section_of("ledger/edits.cost", workload) }
    if workload.starts_with("ledger-") {
        return CostPlaced {
            path: "ledger/${workload.substring(7, workload.length)}.cost",
            workload: workload,
            kind: CostKind.Count,
        }
    }
    if workload.starts_with("edit-") { return section_of("census/edits.cost", workload) }
    CostPlaced { path: "census/${workload}.cost", workload: workload, kind: CostKind.Count }
}

/// The family a keyed row of `kind` lies in, every kind the record judges spelled; none for any other.
fn keyed(kind: string, key: string, workload: string) -> CostPlaced? {
    match kind {
        "speed" -> CostPlaced { path: "speed/${key}.cost", workload: workload, kind: CostKind.Clock },
        "warm" -> CostPlaced { path: "warm/${key}.cost", workload: workload, kind: CostKind.Clock },
        "wall" -> CostPlaced { path: "wall/${key}.cost", workload: workload, kind: CostKind.Clock },
        "bytes" -> CostPlaced { path: "footprint/${key}.cost", workload: workload, kind: CostKind.Count },
        "share" -> CostPlaced { path: "work/warm.cost", workload: workload, kind: CostKind.Share },
        "told" -> CostPlaced { path: "work/warm.cost", workload: workload, kind: CostKind.Told },
        "work" -> CostPlaced { path: "work/warm.cost", workload: workload, kind: CostKind.Count },
        "grows" -> CostPlaced { path: "grows/${key}.cost", workload: workload, kind: CostKind.Count },
        "gate" -> CostPlaced { path: "gate/${key}.cost", workload: workload, kind: CostKind.Clock },
        "proofs" -> CostPlaced { path: "proofs/${workload}.cost", workload: workload, kind: CostKind.Count },
        "reads" -> CostPlaced { path: "reads/${workload}.cost", workload: workload, kind: CostKind.Count },
        _ -> null,
    }
}

/// What a clock carries: the band its kind allows, the target its workload and counter are held to,
/// and the over line that lets it stand above.
fn carried(key: string, place: CostPlaced, targets: List<string>, overs: List<string>) -> List<
    string,
> {
    if !(place.kind is .Clock) { return [] }
    let kind = key.split(":").first() ?? ""
    let counter = key.split(" ").last() ?? ""
    let plain = (key.split(" ").first() ?? "").split(":").last() ?? ""
    let band = when {
        kind == "speed" -> ["band", "25%+250"]
        kind == "warm" -> ["band", "30%+250"]
        _ -> []
    }
    let target = targets
        .find(
            it.split(" ").length == 5 &&
                it.split(" ")[1] == kind &&
                it.split(" ")[2] == plain &&
                it.split(" ")[3] == counter,
        )
    let over = overs
        .find(it.split(" ").length == 5 && "${it.split(" ")[1]} ${it.split(" ")[2]}" == key)
    band
        .concat(if target == null { [] } else { ["target", target!.split(" ")[4]] })
        .concat(if over == null { [] } else { ["over", over!.split(" ")[3], over!.split(" ")[4]] })
}

fn header_for(path: string) -> string { "# ${path.substring(0, path.length - 5)} — what the compiler costs, measured by `wisp cost`" }

// THE VIEW

/// The record as a table: a file a block, each workload a row and each counter a column, a told
/// count marked `~`, a clock over its target `!`.
export fn cost_view(files: List<CostFile>, only: string) -> string {
    [file_view(f) for f in files if only.is_empty() || f.path.starts_with("${only}/") || f.path == "${only}.cost"]
        .join("\n")
}

fn file_view(f: CostFile) -> string {
    let counters = distinct_counters([m.counter for s in f.sections for m in s.measures])
    let width = f
        .sections
        .fold(8, (w, s) -> if s.workload.length > w { s.workload.length } else { w })
    let head = "${padded(f.path, width)}  ${[right(c, cell_width(c)) for c in counters].join("  ")}"
    let rows = ["${padded(s.workload, width)}  ${[right(cell(s, c), cell_width(c)) for c in counters].join("  ")}" for s in f.sections]
    [head].concat(rows).join("\n") + "\n"
}

fn cell(s: CostSection, counter: string) -> string {
    let m? = s.measures.find(it.counter == counter) else { return "·" }
    "${m.value}${mark(m)}"
}

/// A told count `~`; a clock above its target `!` where an over line lets it stand, `!!` where none does.
fn mark(m: CostMeasure) -> string {
    match m.kind {
        .Told -> "~",
        .Clock -> when {
            !above_target(m) -> ""
            m.extra.contains("over") -> "!"
            _ -> "!!"
        },
        .Count or .Share -> "",
    }
}

/// Whether a clock measures above the target it carries.
fn above_target(m: CostMeasure) -> bool {
    let at = m.extra.index_of("target")
    if at < 0 || at + 1 >= m.extra.length { return false }
    m.value > parse_int(m.extra[at + 1]) ?? m.value
}

fn cell_width(counter: string) -> int { if counter.length > 12 { counter.length } else { 12 } }

fn distinct_counters(cs: List<string>) -> List<string> {
    mut seen: Map<string, bool> = {}
    mut out: List<string> = []
    for c in cs {
        if seen.has(c) { continue }
        seen.set(c, true)
        out.push(c)
    }
    out
}

fn padded(s: string, n: int) -> string { if s.length >= n { s } else { s + repeat(" ", n - s.length) } }

fn right(s: string, n: int) -> string { if s.length >= n { s } else { repeat(" ", n - s.length) + s } }

fn section(workload: string, measures: List<CostMeasure>) -> CostSection { CostSection { workload: workload, measures: measures } }

/// A count of `workload` in the file at `path`.
fn section_of(path: string, workload: string) -> CostPlaced { CostPlaced { path: path, workload: workload, kind: CostKind.Count } }

// THE RECORD'S FAULTS

/// What the record cannot hold, each said: a file under a family it does not know, a line of a file
/// that reads as no measure, and a row of `rows` whose kind no family holds. A reader that keeps
/// going past one loses that row's kind and what it is held to, so every reader refuses on any.
export fn record_faults(files: List<CostFile>, rows: Map<string, int>) -> List<string> {
    let families = [unknown_family_said(f.path) for f in files if row_workload(f.path, "", CostKind.Count) == null]
    let lines = [unread_said(f.path, l) for f in files for l in f.unread]
    let kinds = [unknown_kind_said(k) for k, _n in rows if placed(k.split(" ").first() ?? "") == null]
    families.concat(lines).concat(kinds)
}

// THE RECORD AS THE LEDGER

/// The commit every count is measured over, beside the record.
export const SNAPSHOT_FILE: string = "cost/SNAPSHOT"

/// How each kind of row is judged: a count exactly, a told row by nothing, a share within two in a
/// million of its program, a clock within its band of what was accepted.
const RECORD_KINDS: string = "kind bytes keyed-by toolchain over 0ppm\nkind gate keyed-by host over none\nkind count keyed-by - over 0ppm\nkind grows keyed-by toolchain over none\nkind proofs keyed-by - over 0ppm\nkind reads keyed-by - over 0ppm cap 3000\nkind share keyed-by - over 0ppm+2000\nkind speed keyed-by host over 250000ppm+250 least\nkind told keyed-by - over none\nkind wall keyed-by host over 0ppm\nkind warm keyed-by host over 300000ppm+250 least\nkind work keyed-by - over 0ppm\n"

/// The record as the ledger `wisp cost` judges: its kinds, every clock's target and over line, the
/// pinned snapshot and every row.
export fn record_ledger(files: List<CostFile>, snapshot: string) -> string {
    let clocks = clocks_of(files)
    let targets = [target_of(c)! for c in clocks if target_of(c) != null]
    let overs = [over_of(c)! for c in clocks if over_of(c) != null]
    let rows = surface_rows(files)
    let lines = [key_line(t) for t in sorted_by(distinct_counters(targets), text_before)].join("") +
        [key_line(o) for o in overs].join("")
    "${RECORD_KINDS}${lines}snapshot ${snapshot}\n" +
        [key_line("${k} ${rows.get(k) ?? 0}") for k in sorted_by([k for k, _n in rows], text_before)]
            .join("")
}

/// A clock and the row it projects to.
type Clocked = { key: string, m: CostMeasure }

/// Every clock the record holds, under the row it projects to.
fn clocks_of(files: List<CostFile>) -> List<Clocked> {
    mut clocks: List<Clocked> = []
    for f in files {
        for s in f.sections {
            for m in s.measures {
                if !(m.kind is .Clock) { continue }
                let k? = row_key(f.path, s.workload, m) else { continue }
                clocks.push(Clocked { key: k, m: m })
            }
        }
    }
    clocks
}

/// The `target <kind> <workload> <counter> <n>` line a clock carries.
fn target_of(c: Clocked) -> string? {
    let at = c.m.extra.index_of("target")
    if at < 0 || at + 1 >= c.m.extra.length { return null }
    let w = c.key.split(" ")[0].split(":")
    "target ${w[0]} ${w.last()!} ${c.m.counter} ${c.m.extra[at + 1]}"
}

/// The `over <row> <owner> <ticket>` line a clock carries.
fn over_of(c: Clocked) -> string? {
    let at = c.m.extra.index_of("over")
    if at < 0 || at + 2 >= c.m.extra.length { return null }
    "over ${c.key} ${c.m.extra[at + 1]} ${c.m.extra[at + 2]}"
}

/// Every told row the record holds, by its row, with the ticket that owes it a cause.
export fn told_rows(files: List<CostFile>) -> Map<string, string> {
    mut told: Map<string, string> = {}
    for f in files {
        for s in f.sections {
            for m in s.measures {
                if !(m.kind is .Told) { continue }
                let k? = row_key(f.path, s.workload, m) else { continue }
                told.set(k, m.extra.first() ?? "")
            }
        }
    }
    told
}

/// The record with `rows` laid into it: each measure the rows hold takes its value, a row the record
/// holds no measure of joins the file its workload names, and each file a value moved in names
/// `cause` on its `# accepted:` line. A measure's kind and what it carries stand as they were.
export fn record_accepted(files: List<CostFile>, rows: Map<string, int>, cause: string) -> List<
    CostFile,
> {
    let held = surface_rows(files)
    let fresh = [k for k in sorted_by([k for k, _n in rows], text_before) if !held.has(k)]
    let grown = [g for g in migrated("", rows.filter((e) -> fresh.contains(e.key)), [], [])]
    let paths = distinct_counters([f.path for f in files].concat([g.path for g in grown]))
    [accepted_file(p, files.find(it.path == p), grown.find(it.path == p), rows, cause) for p in paths]
}

fn accepted_file(
    path: string,
    was: CostFile?,
    grown: CostFile?,
    rows: Map<string, int>,
    cause: string,
) -> CostFile {
    let before = was ?? CostFile { path: path, header: [], sections: [] }
    let laid = [section(
        s.workload,
        [m with { value: rows.get(row_key(path, s.workload, m) ?? "") ?? m.value } for m in s.measures],
    ) for s in before.sections]
    let joined_in = merged(laid, grown?.sections ?? [])
    let moved = grown != null ||
        !same_rows(
            surface_rows([before]),
            surface_rows([CostFile { path: path, header: [], sections: laid }]),
        )
    let header = if moved { [h for h in before.header if !h.starts_with("# accepted:")].concat(["# accepted: ${cause}"]) } else { before.header }
    CostFile {
        path: path,
        header: if header.is_empty() { [header_for(path)] } else { header },
        sections: joined_in,
    }
}

/// `laid`'s sections with `grown`'s measures joined in, a new workload's section appended.
fn merged(laid: List<CostSection>, grown: List<CostSection>) -> List<CostSection> {
    let old = [section(s.workload, s.measures.concat(grown.find(it.workload == s.workload)?.measures ?? [])) for s in laid]
    old.concat([g for g in grown if !laid.any(it.workload == g.workload)])
}

/// Whether two sets of rows hold the same rows, each at the same value.
// LICENSED compiler.trait_family: maps do not compare, so two row sets agree key by key
export fn same_rows(a: Map<string, int>, b: Map<string, int>) -> bool { a.length == b.length && a.all((e) -> b.get(e.key) == e.value) }

// VOICES

fn unknown_family_said(path: string) -> string { "cost: cost/${path} stands under no family the record holds — census, ledger, matrix, speed, warm, wall, footprint, grows, gate, proofs, reads or work" }

fn unread_said(path: string, line: string) -> string { "cost: cost/${path} holds `${line}`, which reads as no measure — `<count|told|share|clock> <counter> <value>`" }

fn unknown_kind_said(row: string) -> string { "cost: the row `${row}` names a kind no family holds — a new kind is declared in RECORD_KINDS and given its family's arm in `keyed`" }
