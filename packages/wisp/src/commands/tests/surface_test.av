// The record under `cost/` holds exactly the rows the ledger held: migrated, written, read back and
// projected, every row and its value come home, and a clock keeps its band, target and over line.
use commands.{
    RECORD_KINDS,
    CostFile,
    cost_file,
    cost_view,
    file_text,
    kinds_of,
    migrated,
    record_accepted,
    record_faults,
    record_ledger,
    rows_of,
    surface_rows,
    targets_of,
    told_rows,
}

fn ledger() -> string {
    [
        "kind warm keyed-by host over 300000ppm+250 least",
        "target warm warm edit 300",
        "target warm warm unchanged 300",
        "over warm:ci-warm:warm edit avra-lane-r2-warm .112.26",
        "snapshot ea25dd426b98aa9ea1b22e1a5d014cccc49d34b3",
        "check-cli boxes 154152527",
        "check-cli queries_computed 145145",
        "edit-body boxes 25637476",
        "edit-noop worked 0",
        "ledger-check-cli pass_tape_asks 12",
        "ledger-edit-body pass_tape_asks 9",
        "ledger-edit-noop pass_tape_asks 0",
        "matrix-check-bare-body pass_tape_asks 19",
        "matrix-check-bare-none pass_tape_asks 7",
        "matrix-build-laid-std pass_lower_asks 106",
        "speed:linux-x86-64-amd-epyc:build keep 6704",
        "warm:ci-warm:warm edit 23216",
        "warm:ci-warm:warm unchanged 314",
        "bytes:linux-x86_64-clang-22.1.2:footprint-hello stripped 16384",
        "share:-:warm-edit query_reads_ppm 1588651",
        "work:-:warm-unchanged files_loaded 0",
    ]
        .join("\n")
}

fn lines_of(text: string) -> List<string> { [l for l in text.split("\n") if !l.is_empty()] }

fn files() -> List<CostFile> {
    let text = ledger()
    migrated(
        text,
        rows_of(text),
        [l for l in lines_of(text) if l.starts_with("target ")],
        [l for l in lines_of(text) if l.starts_with("over ")],
    )
}

/// Each file written as the record writes it and read back from its text.
fn read_back() -> List<CostFile> { [cost_file(f.path, file_text(f)) for f in files()] }

fn file_at(path: string) -> CostFile? { read_back().find(it.path == path) }

fn sections_in(path: string) -> int { (file_at(path)?.sections ?? []).length }

spec "cost surface — the record holds the ledger's rows" {
    then "migrated, written and read back, every row comes home with its value" {
        let back = surface_rows(read_back())
        let rows = rows_of(ledger())
        back.length == rows.length && rows.all((e) -> back.get(e.key) == e.value)
    }
    then "a matrix part is one file, its edits its sections" {
        sections_in("matrix/check-bare.cost") == 2
    }
    then "the cli's edits share one file, and the ledger's theirs" {
        sections_in("census/edits.cost") == 2 && sections_in("ledger/edits.cost") == 2
    }
    then "a keyed row stands in its key's file" {
        file_at("warm/ci-warm.cost") != null &&
            file_at("speed/linux-x86-64-amd-epyc.cost") != null &&
            file_at("footprint/linux-x86_64-clang-22.1.2.cost") != null
    }
    then "a clock keeps its band, its target and its over line" {
        let warm? = file_at("warm/ci-warm.cost") else { return false }
        let edit? = warm.sections[0].measures.find(it.counter == "edit") else { return false }
        edit.extra.join(" ") == "band 30%+250 target 300 over avra-lane-r2-warm .112.26"
    }
    then "a count carries nothing after its value" {
        file_text(file_at("census/check-cli.cost")!).contains("count boxes 154152527\n")
    }
}

spec "cost surface — the view" {
    then "a file is a table: a workload a row, a counter a column" {
        let v = cost_view(read_back(), "matrix")
        v.contains("matrix/check-bare.cost") &&
            v.contains("matrix-check-bare-body") &&
            v.contains("pass_tape_asks")
    }
    then "a clock above its target is marked: `!` on an over line, `!!` on none" {
        let v = cost_view(read_back(), "warm")
        v.contains("23216! ") && v.contains("314!!")
    }
    then "a family names only its own files" {
        !cost_view(read_back(), "warm").contains("check-cli")
    }
}

/// The record with check-cli's `queries_computed` told under `.112.27`.
fn with_told() -> List<CostFile> {
    let told = file_text(file_at("census/check-cli.cost")!)
        .replace("count queries_computed 145145", "told queries_computed 145145 .112.27")
    read_back()
        .filter(it.path != "census/check-cli.cost")
        .concat([cost_file("census/check-cli.cost", told)])
}

fn accepted_at(path: string, files: List<CostFile>) -> CostFile? { files.find(it.path == path) }

fn header_of(path: string, files: List<CostFile>) -> List<string> { accepted_at(path, files)?.header ?? [] }

spec "cost surface — the record as the ledger" {
    then "the ledger it makes holds exactly its rows" {
        let ledger = record_ledger(read_back(), "abc")
        let rows = rows_of(ledger)
        let back = surface_rows(read_back())
        rows.length == back.length &&
            back.all((e) -> rows.get(e.key) == e.value) &&
            ledger.contains("snapshot abc\n")
    }
    then "a count is judged exactly" {
        kinds_of(record_ledger(read_back(), "abc")).get("count")?.ppm == 0
    }
    then "a clock's target and over line are the ledger's" {
        let ledger = record_ledger(read_back(), "abc")
        targets_of(ledger).length == 2 &&
            ledger.contains("over warm:ci-warm:warm edit avra-lane-r2-warm .112.26\n")
    }
    then "a told count is the record's, its ticket beside it" {
        told_rows(with_told()).get("check-cli queries_computed") == ".112.27"
    }
}

spec "cost surface — the accept" {
    then "a rise and a fall are both recorded, each its measured value" {
        let rows: Map<string, int> = {"check-cli boxes": 154152600, "edit-body boxes": 25637000}
        let got = surface_rows(record_accepted(read_back(), rows, "a cause"))
        got.get("check-cli boxes") == 154152600 && got.get("edit-body boxes") == 25637000
    }
    then "a file a value moved in names the cause; one nothing moved in keeps its line" {
        let rows: Map<string, int> = {"check-cli boxes": 154152600}
        let got = record_accepted(read_back(), rows, "the read set is kept")
        header_of("census/check-cli.cost", got).contains("# accepted: the read set is kept") &&
            !header_of("census/edits.cost", got).any(it.starts_with("# accepted:"))
    }
    then "a row the record never held joins the file its workload names" {
        let rows: Map<string, int> = {
            "check-cli fresh_counter": 3,
            "matrix-check-bare-renamed pass_tape_asks": 9,
        }
        let got = record_accepted(read_back(), rows, "two new rows")
        let back = surface_rows(got)
        back.get("check-cli fresh_counter") == 3 &&
            back.get("matrix-check-bare-renamed pass_tape_asks") == 9 &&
            (accepted_at("matrix/check-bare.cost", got)?.sections ?? []).length == 3
    }
    then "a told count stays told, its ticket kept, when its value moves" {
        let rows: Map<string, int> = {"check-cli queries_computed": 145200}
        told_rows(record_accepted(with_told(), rows, "moved")).get("check-cli queries_computed") == ".112.27"
    }
}

/// A row of every keyed kind the record declares, each under a key of what keys it.
fn keyed_rows() -> Map<string, int> {
    mut rows: Map<string, int> = {}
    for name, k in kinds_of(RECORD_KINDS) {
        if name == "count" { continue }
        rows
            .set("${name}:${if k.keyed_by == "-" { "-" } else { "a-host" }}:a-workload a_counter", 7)
    }
    rows
}

fn round_trip(rows: Map<string, int>) -> Map<string, int> {
    let made = migrated("", rows, [], [])
    surface_rows([cost_file(f.path, file_text(f)) for f in made])
}

spec "cost surface — every kind keeps its kind" {
    then "a row of each keyed kind the record declares comes home under its own kind" {
        let rows = keyed_rows()
        let back = round_trip(rows)
        rows.length == 8 &&
            back.length == rows.length &&
            rows.all((e) -> back.get(e.key) == e.value)
    }
    then "a record of every declared kind holds no fault" {
        record_faults(read_back(), keyed_rows()).is_empty()
    }
    then "a row of a kind no family holds refuses, naming the row" {
        let faults = record_faults(read_back(), {"reads:-:warm-edit proved": 3})
        faults.length == 1 && faults[0].contains("`reads:-:warm-edit proved`")
    }
    then "a row of a kind no family holds is never laid in as another kind" {
        round_trip({"reads:-:warm-edit proved": 3}).is_empty()
    }
    then "a file under a family the record does not hold refuses, naming the file" {
        let faults = record_faults([cost_file("reads/a-workload.cost", "[w]\ncount c 1\n")], {})
        faults.length == 1 && faults[0].contains("cost/reads/a-workload.cost")
    }
    then "a line that reads as no measure refuses, naming the line" {
        let faults = record_faults([cost_file("census/w.cost", "[w]\ncount c 1\nproofs c 2\n")], {})
        faults.length == 1 && faults[0].contains("`proofs c 2`")
    }
}
