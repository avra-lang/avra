use commands.{owed, owes}

spec "ci_path_gate — which jobs a change owes" {
    given "the runtime-keep job" {
        then "a changed runtime file, the Makefile and its own script are owed" {
            owes("runtime-keep", "pull_request", ["runtime/avra_fiber.c"]) &&
                owes("runtime-keep", "pull_request", ["runtime/tests/flow_test.c"]) &&
                owes("runtime-keep", "pull_request", ["Makefile"]) &&
                owes("runtime-keep", "pull_request", ["tools/memcap.sh"])
        }
        then "other paths, no paths and a lookalike directory are not owed" {
            !owes("runtime-keep", "pull_request", ["packages/cli/src/main.av"]) &&
                !owes("runtime-keep", "pull_request", ["docs/x.md", "tools/other.py"]) &&
                !owes("runtime-keep", "pull_request", []) &&
                !owes("runtime-keep", "pull_request", ["runtimes/x.c"])
        }
    }
    given "the layout-oracle job" {
        then "the UI and text packages and the oracle's own tools are owed" {
            owes("layout-oracle", "pull_request", ["packages/std-ui/src/place/solve.av"]) &&
                owes("layout-oracle", "pull_request", ["packages/std-text/src/display.av"]) &&
                owes("layout-oracle", "pull_request", ["tools/layout-oracle/oracle.mjs"])
        }
        then "other paths and a lookalike package are not owed" {
            !owes("layout-oracle", "pull_request", ["packages/cli/src/main.av", "docs/x.md"]) &&
                !owes("layout-oracle", "pull_request", ["packages/std-uix/a.av"])
        }
    }
    given "a keeper" {
        then "runtime-mutations is owed by runtime/ alone, its list among it" {
            owes(
                    "runtime-mutations",
                    "pull_request",
                    ["packages/wisp/src/commands/mutation_rows.av"],
                ) &&
                owes("runtime-mutations", "pull_request", ["runtime/avra_runtime.c"]) &&
                !owes("runtime-mutations", "pull_request", ["packages/cli/src/main.av", "Makefile"])
        }
        then "a name with no row reads every path, so it is owed by any change" {
            owes("dogfooding-rules", "pull_request", ["docs/x.md"]) &&
                owes("no-such-keeper", "pull_request", ["a"])
        }
        then "a name with no row is owed nothing by no change" { !owes("dogfooding-rules", "pull_request", []) }
    }
    given "an event that is no pull request" {
        then "every job is owed" {
            owes("runtime-keep", "push", []) &&
                owes("runtime-keep", "push", ["packages/cli/src/main.av"]) &&
                owes("runtime-keep", "workflow_dispatch", []) &&
                owes("layout-oracle", "push", [])
        }
    }
    given "the bash-parse keeper, which reads shell scripts" {
        then "a `.sh` file anywhere, a file with no extension and its own script are owed" {
            owes("bash-parse", "pull_request", ["tools/lib/tree.sh"]) &&
                owes("bash-parse", "pull_request", ["tools/work"]) &&
                owes("bash-parse", "pull_request", ["wisp"]) &&
                owes("bash-parse", "pull_request", ["tools/bash_parse.sh"])
        }
        then "a source file, a doc and a name ending in `sh` without its dot are not" {
            !owes("bash-parse", "pull_request", ["packages/std-queue/src/schedule.av"]) &&
                !owes("bash-parse", "pull_request", ["docs/x.md", "runtime/avra_runtime.c"]) &&
                !owes("bash-parse", "pull_request", ["tools/fresh.py"]) &&
                !owes("bash-parse", "pull_request", ["packages/std-sh/a.av"])
        }
    }
    given "the cost-snapshot keeper, which reads the compiler and its pin" {
        then "a compiler path, a file under one and the pin are owed" {
            owed("cost-snapshot", "pull_request", ["Makefile"], ["Makefile", "packages/cli"]) &&
                owed(
                    "cost-snapshot",
                    "pull_request",
                    ["packages/cli/src/main.av"],
                    ["Makefile", "packages/cli"],
                ) &&
                owed("cost-snapshot", "pull_request", ["cost/SNAPSHOT"], [])
        }
        then "a package that is no compiler source, a sibling's prefix and a test-free change are not" {
            !owed(
                    "cost-snapshot",
                    "pull_request",
                    ["packages/std-queue/src/schedule.av"],
                    ["packages/cli"],
                ) &&
                !owed("cost-snapshot", "pull_request", ["packages/cli-x/a.av"], ["packages/cli"]) &&
                !owed("cost-snapshot", "pull_request", [], ["packages/cli"])
        }
        then "a push owes it, and another keeper is judged by its own row" {
            owed("cost-snapshot", "push", [], []) &&
                owed("runtime-keep", "pull_request", ["runtime/a.c"], []) &&
                !owed("runtime-keep", "pull_request", ["packages/cli/a.av"], ["packages/cli"])
        }
    }
}
