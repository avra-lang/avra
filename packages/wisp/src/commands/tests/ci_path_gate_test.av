use commands.{KEEPERS, owed, owes}

spec "ci_path_gate — which jobs a change owes" {
    given "the runtime-keep job" {
        then "a changed runtime file, the Makefile and its own script are owed" {
            owes("runtime-keep", "pull_request", ["runtime/avra_fiber.c"]) &&
                owes("runtime-keep", "pull_request", ["runtime/tests/flow_test.c"]) &&
                owes("runtime-keep", "pull_request", ["Makefile"]) &&
                owes("runtime-keep", "pull_request", ["tools/memcap.sh"])
        }
        then "other paths, no paths and a lookalike directory are not owed" {
            !owes("runtime-keep", "pull_request", ["packages/cli/src/main.av"]) &&
                !owes("runtime-keep", "pull_request", ["docs/x.md", "tools/other.py"]) &&
                !owes("runtime-keep", "pull_request", []) &&
                !owes("runtime-keep", "pull_request", ["runtimes/x.c"])
        }
    }
    given "the layout-oracle job" {
        then "the UI and text packages and the oracle's own tools are owed" {
            owes("layout-oracle", "pull_request", ["packages/std-ui/src/place/solve.av"]) &&
                owes("layout-oracle", "pull_request", ["packages/std-text/src/display.av"]) &&
                owes("layout-oracle", "pull_request", ["tools/layout-oracle/oracle.mjs"])
        }
        then "other paths and a lookalike package are not owed" {
            !owes("layout-oracle", "pull_request", ["packages/cli/src/main.av", "docs/x.md"]) &&
                !owes("layout-oracle", "pull_request", ["packages/std-uix/a.av"])
        }
    }
    given "a keeper" {
        then "runtime-mutations is owed by runtime/ alone, its list among it" {
            owes(
                    "runtime-mutations",
                    "pull_request",
                    ["packages/wisp/src/commands/mutation_rows.av"],
                ) &&
                owes("runtime-mutations", "pull_request", ["runtime/avra_runtime.c"]) &&
                !owes("runtime-mutations", "pull_request", ["packages/cli/src/main.av", "Makefile"])
        }
        then "a name with no row reads every path, so it is owed by any change" {
            owes("dogfooding-rules", "pull_request", ["docs/x.md"]) &&
                owes("no-such-keeper", "pull_request", ["a"])
        }
        then "a name with no row is owed nothing by no change" { !owes("dogfooding-rules", "pull_request", []) }
    }
    given "an event that is no pull request" {
        then "every job is owed" {
            owes("runtime-keep", "push", []) &&
                owes("runtime-keep", "push", ["packages/cli/src/main.av"]) &&
                owes("runtime-keep", "workflow_dispatch", []) &&
                owes("layout-oracle", "push", [])
        }
    }
    given "the bash-parse keeper, which reads shell scripts" {
        then "a `.sh` file anywhere, a file with no extension and its own script are owed" {
            owes("bash-parse", "pull_request", ["tools/lib/tree.sh"]) &&
                owes("bash-parse", "pull_request", ["tools/work"]) &&
                owes("bash-parse", "pull_request", ["wisp"]) &&
                owes("bash-parse", "pull_request", ["tools/bash_parse.sh"])
        }
        then "a source file, a doc and a name ending in `sh` without its dot are not" {
            !owes("bash-parse", "pull_request", ["packages/std-queue/src/schedule.av"]) &&
                !owes("bash-parse", "pull_request", ["docs/x.md", "runtime/avra_runtime.c"]) &&
                !owes("bash-parse", "pull_request", ["tools/fresh.py"]) &&
                !owes("bash-parse", "pull_request", ["packages/std-sh/a.av"])
        }
    }
    given "the cost-snapshot keeper, which reads the compiler and its pin" {
        then "a compiler path, a file under one and the pin are owed" {
            owed("cost-snapshot", "pull_request", ["Makefile"], ["Makefile", "packages/cli"]) &&
                owed(
                    "cost-snapshot",
                    "pull_request",
                    ["packages/cli/src/main.av"],
                    ["Makefile", "packages/cli"],
                ) &&
                owed("cost-snapshot", "pull_request", ["cost/SNAPSHOT"], [])
        }
        then "a package that is no compiler source, a sibling's prefix and a test-free change are not" {
            !owed(
                    "cost-snapshot",
                    "pull_request",
                    ["packages/std-queue/src/schedule.av"],
                    ["packages/cli"],
                ) &&
                !owed("cost-snapshot", "pull_request", ["packages/cli-x/a.av"], ["packages/cli"]) &&
                !owed("cost-snapshot", "pull_request", [], ["packages/cli"])
        }
        then "a push owes it, and another keeper is judged by its own row" {
            owed("cost-snapshot", "push", [], []) &&
                owed("runtime-keep", "pull_request", ["runtime/a.c"], []) &&
                !owed("runtime-keep", "pull_request", ["packages/cli/a.av"], ["packages/cli"])
        }
    }
    given "the generated runtime header and row namespace" {
        then "a change to the runtime's rows alone owes both" {
            let rows = ["packages/std-avrac/src/core/runtime_api.av"]
            let compiler = ["Makefile", "packages/std-avrac", "runtime"]
            owed("rt-header", "pull_request", rows, compiler) &&
                owed("rt-ns", "pull_request", rows, compiler)
        }
        then "a change no compiler source holds owes neither" {
            let compiler = ["Makefile", "packages/std-avrac", "runtime"]
            !owed("rt-header", "pull_request", ["docs/x.md"], compiler) &&
                !owed("rt-ns", "pull_request", ["docs/x.md"], compiler)
        }
        then "both are keepers a preflight narrows to the change, wherever the gate runs them" {
            ["rt-header", "rt-ns"]
                .all(
                    (k) -> KEEPERS.any(it.name == k && !it.free) &&
                        !owed(k, "pull_request", ["preflight/an-unread-path"], []),
                )
        }
    }
    given "every keeper that needs a compiler" {
        then "each has a row, so a preflight owes it by what a change touches" {
            KEEPERS
                .filter(!it.free)
                .all((k) -> !owed(k.name, "pull_request", ["preflight/an-unread-path"], []))
        }
        then "a change to a file its row names owes it" {
            keeper_reads().all((r) -> owed(r.keeper, "pull_request", [r.path], COMPILER))
        }
        then "a change no compiler source and no row holds owes none of them" {
            KEEPERS
                .filter(!it.free)
                .all((k) -> !owed(k.name, "pull_request", ["docs/x.md"], COMPILER))
        }
    }
}

/// The compiler's source as a test names it: a path under these is compiler source.
const COMPILER: List<string> = [
    "Makefile",
    "backend",
    "bootstrap",
    "packages/cli",
    "packages/std-avrac",
    "runtime",
]

/// A keeper and one path its row names.
type KeeperRead = { keeper: string, path: string }

fn keeper_reads() -> List<KeeperRead> {
    [
        KeeperRead { keeper: "clock-holds", path: "tools/clock_holds.py" },
        KeeperRead { keeper: "speed-ratchet", path: "cost/a_file" },
        KeeperRead { keeper: "cost", path: "cost/a_file" },
        KeeperRead { keeper: "fmt-lossless", path: "tools/probe/a.av" },
        KeeperRead { keeper: "stems", path: "tools/stems.sh" },
        KeeperRead { keeper: "read-cost", path: "benchmarks/db/a_file" },
        KeeperRead { keeper: "warm-edit", path: "cost/a_file" },
        KeeperRead { keeper: "traps", path: "tools/traps.sh" },
        KeeperRead { keeper: "compile-slots", path: "tools/compile_slots.sh" },
        KeeperRead { keeper: "witness", path: "packages/wisp/a_file" },
        KeeperRead { keeper: "flow-trace", path: "tools/flow_trace/a_file" },
        KeeperRead { keeper: "libscope", path: "tools/libscope.sh" },
        KeeperRead { keeper: "h2spec", path: "tools/h2spec/a_file" },
        KeeperRead { keeper: "pool-check", path: "tools/pool/a_file" },
        KeeperRead { keeper: "inputs", path: "packages/wisp/a_file" },
        KeeperRead { keeper: "trap-marks", path: "tools/traps.py" },
        KeeperRead { keeper: "parser", path: "packages/wisp/a_file" },
        KeeperRead { keeper: "witnesses", path: "docs/DIAGNOSTICS.md" },
        KeeperRead { keeper: "dogfooding-rules", path: "DOGFOODING.md" },
        KeeperRead { keeper: "rule-examples", path: "packages/std-avrac/src/core/a.av" },
        KeeperRead { keeper: "attack", path: "tools/attack.sh" },
        KeeperRead { keeper: "voices", path: "docs/VOICES.md" },
        KeeperRead { keeper: "defects", path: "packages/wisp/a_file" },
        KeeperRead { keeper: "bench-build", path: "packages/wisp/a_file" },
        KeeperRead { keeper: "ui-host", path: "tools/ui_host.sh" },
        KeeperRead { keeper: "ui-host-test", path: "tools/ui_host_test.sh" },
        KeeperRead { keeper: "ui-board", path: "tools/ui-board/a_file" },
        KeeperRead { keeper: "exact-patches", path: "tools/exact-patches/a_file" },
        KeeperRead { keeper: "dev-server", path: "tools/lib/a_file" },
        KeeperRead { keeper: "ui-browser", path: "tools/ui-board/a_file" },
        KeeperRead { keeper: "tool-witnesses", path: "tools/a_file" },
        KeeperRead { keeper: "footprint", path: "cost/a_file" },
        KeeperRead { keeper: "seed-check", path: "tools/seed_guard.sh" },
        KeeperRead { keeper: "pkgs-witness", path: "packages/a_file" },
        KeeperRead { keeper: "wasm-host-check", path: "tools/wasm-host/a_file" },
        KeeperRead { keeper: "wasm-check", path: "tools/wasm-check.sh" },
        KeeperRead { keeper: "wasm-seam", path: "tools/wasm-seam-check.sh" },
        KeeperRead { keeper: "wasm-refuses", path: "tools/wasm-refuses.sh" },
        KeeperRead { keeper: "wasm-tasks-mutations", path: "tools/wasm-tasks-mutations.sh" },
        KeeperRead { keeper: "wasm-cache", path: "tools/wasm-cache-attacks.sh" },
        KeeperRead { keeper: "wasm-archive", path: "tools/wasm-archive.sh" },
        KeeperRead { keeper: "wasm-size-guard", path: "tools/ui-board/a_file" },
        KeeperRead { keeper: "wasm-routes-size", path: "tools/wasm-routes/a_file" },
    ]
}
