// Reclaim over repositories of its own: every repository and worktree here is made fresh under
// `mktemp -d`, never the tree's.
use @std.io.{exists, make_dirs}
use @std.process.{Ready, cmd, tool}
use @std.time.{secs}
use commands.{Asked, ReclaimFlags, Worktree, inside, reclaimed, worktrees_of}

/// A repository on `main` with one commit, in a directory of its own; its real path.
fn repo() -> string {
    let root = scratch_dir()
    shell(
        root,
        "git init -q -b main repo && cd repo && git config user.email t@t && git config user.name t && echo base > file && git add -A && git commit -q -m base && pwd -P",
    )
}

/// A linked tree at `<repo>-<branch>` on a new branch off main.
fn linked(d: string, branch: string) -> string {
    let _ = shell(d, "git worktree add -q -b ${branch} ${d}-${branch} main")
    "${d}-${branch}"
}

fn swept(d: string, now: bool, dry: bool, floor: int) -> List<string> {
    reclaimed(ReclaimFlags { floor: floor, repo: d }, Asked { now: now, dry: dry }) catch [
        "refused",
    ]
}

/// A repository's check, then its directory gone, with every tree linked beside it: a case passes
/// only when both hold.
fn checked(d: string, ok: bool) -> bool { cleared(d.substring(0, d.length - "/repo".length)) && ok }

/// Neither named under `--dry-run` nor removed for real.
fn kept(d: string, wt: string) -> bool {
    let named = swept(d, true, true, 20).any(it.starts_with("would retire ${wt} "))
    let _ = swept(d, true, false, 20)
    !named && exists(wt)
}

/// Kept while a process stands inside it; the process is stopped either way.
fn kept_while_held(d: string, wt: string) -> bool {
    let sleep = tool("sleep") catch { return false }
    match (cmd(sleep, ["60"]) with { cwd: "${wt}/deep" }).start(Ready.Started, secs(5)) {
        .Ok(child) -> {
            let held = kept(d, wt)
            let _ = child.stop()
            held
        },
        .Err(_) -> false,
    }
}

spec "wisp reclaim — which worktrees retire" {
    given "a merged, clean, idle tree" {
        then "it is retired and its branch kept" {
            let d = repo()
            let wt = linked(d, "done")
            let lines = swept(d, true, false, 20)
            checked(
                d,
                !exists(wt) &&
                    lines.contains("retired ${wt} (done)") &&
                    shell(d, "git rev-parse -q --verify refs/heads/done") != "",
            )
        }
        then "under `--dry-run` it is named and nothing moves" {
            let d = repo()
            let wt = linked(d, "done")
            let lines = swept(d, true, true, 20)
            checked(
                d,
                exists(wt) &&
                    lines.contains("would retire ${wt} (done)") &&
                    shell(d, "git worktree list | wc -l").trim() == "2",
            )
        }
    }
    given "a tree a rule keeps" {
        then "a dirty tree is kept" {
            let d = repo()
            let wt = linked(d, "wip")
            let _ = shell(wt, "echo change > file")
            checked(d, kept(d, wt))
        }
        then "an unmerged tree is kept" {
            let d = repo()
            let wt = linked(d, "ahead")
            let _ = shell(wt, "echo own > own && git add -A && git commit -q -m own")
            checked(d, kept(d, wt))
        }
        then "a tree a process stands inside is kept" {
            let d = repo()
            let wt = linked(d, "held")
            let _ = make_dirs("${wt}/deep")
            checked(d, kept_while_held(d, wt))
        }
        then "main's checkout is never touched" {
            let d = repo()
            let _ = shell(d, "git checkout -q -b home && git worktree add -q ${d}-main main")
            checked(d, kept(d, "${d}-main"))
        }
        then "a detached tree is kept" {
            let d = repo()
            let _ = shell(d, "git worktree add -q --detach ${d}-side main")
            checked(d, kept(d, "${d}-side"))
        }
    }
    given "the floor" {
        then "free space at or over it retires nothing" {
            let d = repo()
            let wt = linked(d, "done")
            checked(d, swept(d, false, false, 0).any(it.contains("nothing to do")) && exists(wt))
        }
        then "free space under it retires" {
            let d = repo()
            let wt = linked(d, "done")
            let _ = swept(d, false, false, 1000000)
            checked(d, !exists(wt))
        }
    }
    given "git's listing" {
        then "each stanza is a tree, a detached one with no branch, each path once" {
            let listing = "worktree /r\nHEAD 1\nbranch refs/heads/main\n\nworktree /r-side\nHEAD 2\ndetached\n\nworktree /r\nHEAD 1\n"
            let trees = worktrees_of(listing)
            trees.length == 2 &&
                trees[0].branch == "main" &&
                trees[1].path == "/r-side" &&
                trees[1].branch == ""
        }
        then "a path inside a tree is the tree's, a lookalike sibling is not" {
            inside("/r-a/deep", "/r-a") && inside("/r-a", "/r-a") && !inside("/r-ab", "/r-a")
        }
    }
    given "the fixtures' own clearing" {
        then "a link inside is unlinked and what it points at stands" {
            let mine = scratch_dir()
            let other = scratch_dir()
            let _ = shell(other, "echo kept > kept && mkdir sub && echo deep > sub/deep")
            let _ = shell(mine, "ln -s '${other}' out && ln -s '${other}/kept' file")
            let ok = cleared(mine) &&
                !exists(mine) &&
                exists("${other}/kept") &&
                exists("${other}/sub/deep")
            cleared(other) && ok
        }
        then "a directory `mktemp` did not make is left alone" {
            let root = scratch_dir()
            let _ = shell(root, "mkdir plain")
            let ok = !cleared("${root}/plain") && exists("${root}/plain")
            cleared(root) && ok
        }
    }
}
