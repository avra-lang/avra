// Reclaim over repositories of its own: every repository and worktree here is made fresh under
// `mktemp -d`, never the tree's.
use @std.io.{exists, make_dirs}
use @std.process.{Ready, cmd, tool}
use @std.time.{secs}
use commands.{
    Asked,
    ReclaimFlags,
    Seen,
    Worktree,
    cwds,
    inside,
    lsof_seen,
    proc_seen,
    reclaimed_seeing,
    worktrees_of,
}

/// A repository on `main` with one commit, in a directory of its own; its real path.
fn repo() -> string {
    let root = scratch_dir()
    shell(
        root,
        "git init -q -b main repo && cd repo && git config user.email t@t && git config user.name t && echo base > file && git add -A && git commit -q -m base && pwd -P",
    )
}

/// A linked tree at `<repo>-<branch>` on a new branch off main.
fn linked(d: string, branch: string) -> string {
    let _ = shell(d, "git worktree add -q -b ${branch} ${d}-${branch} main")
    "${d}-${branch}"
}

/// No process stands in any tree.
fn nothing_seen() -> Result<Seen, string> { Seen { dirs: [] } }

/// A reader that cannot say where processes stand.
fn unseen() -> Result<Seen, string> { fail "no process's directory may be read" }

fn swept(d: string, now: bool, dry: bool, floor: int) -> List<string> { swept_seeing(d, now, dry, floor, nothing_seen) }

fn swept_seeing(d: string, now: bool, dry: bool, floor: int, seen: fn() -> Result<Seen, string>) -> List<
    string,
> {
    reclaimed_seeing(ReclaimFlags { floor: floor, repo: d }, Asked { now: now, dry: dry }, seen) catch [
        "refused",
    ]
}

/// A repository's check, then its directory gone, with every tree linked beside it: a case passes
/// only when both hold.
fn checked(d: string, ok: bool) -> bool { cleared(d.substring(0, d.length - "/repo".length)) && ok }

/// Neither named under `--dry-run` nor removed for real.
fn kept(d: string, wt: string) -> bool {
    let named = swept(d, true, true, 20).any(it.starts_with("would retire ${wt} "))
    let _ = swept(d, true, false, 20)
    !named && exists(wt)
}

/// Whether the machine's own reader, while a process stands in `wt/deep`, sees it there or refuses to
/// say: never neither. The process is stopped either way.
fn seen_or_refused(wt: string) -> bool {
    let sleep = tool("sleep") catch { return false }
    match (cmd(sleep, ["60"]) with { cwd: "${wt}/deep" }).start(Ready.Started, secs(5)) {
        .Ok(child) -> {
            let stood = stood_in(child.pid(), "${wt}/deep")
            let read = cwds()
            let told = match read {
                .Ok(s) -> s.dirs.any((c: string) -> inside(c, wt)),
                .Err(_) -> true,
            }
            if !told { eprintln(unseen_words(child.pid(), stood, wt, read)) }
            let _ = child.stop()
            told
        },
        .Err(_) -> false,
    }
}

/// Whether the machine's reader, while a sleeper stands in `wt/deep`, reads more than one directory, or
/// refuses to say; what it read is said when it reads one or none.
fn read_many(wt: string) -> bool {
    let sleep = tool("sleep") catch { return false }
    match (cmd(sleep, ["60"]) with { cwd: "${wt}/deep" }).start(Ready.Started, secs(5)) {
        .Ok(child) -> {
            let _ = stood_in(child.pid(), "${wt}/deep")
            let many = match cwds() { .Ok(s) -> s.dirs.length > 1, .Err(_) -> true }
            if !many { eprintln(unseen_words(child.pid(), "", wt, cwds())) }
            let _ = child.stop()
            many
        },
        .Err(_) -> false,
    }
}

/// Where the process `pid` stands once it stands in `dir`, asked of the kernel every tenth of a second
/// for ten seconds: a child is started before it has moved into the directory it was given.
fn stood_in(pid: int, dir: string) -> string {
    mut at = ""
    mut tries = 0
    while tries < 100 {
        at = shell("/", "readlink -v /proc/${pid}/cwd 2>&1")
        if at == dir { return at }
        let _ = shell("/", "sleep 0.1")
        tries = tries + 1
    }
    at
}

/// What the reader read when it missed the process standing in `wt`.
fn unseen_words(pid: int, stood: string, wt: string, read: Result<Seen, string>) -> string {
    let dirs = match read { .Ok(s) -> s.dirs, .Err(why) -> [why] }
    let near = [c for c in dirs if c.contains(wt) || wt.contains(c) && c != "/"]
    "reclaim_test: the sleeper (pid ${pid}) stood in `${stood}`; the reader read ${dirs.length} directories, none inside `${wt}`; those near it: [${near.join(", ")}]"
}

spec "wisp reclaim — which worktrees retire" {
    given "a merged, clean, idle tree" {
        then "it is retired and its branch kept" {
            let d = repo()
            let wt = linked(d, "done")
            let lines = swept(d, true, false, 20)
            checked(
                d,
                !exists(wt) &&
                    lines.contains("retired ${wt} (done)") &&
                    shell(d, "git rev-parse -q --verify refs/heads/done") != "",
            )
        }
        then "under `--dry-run` it is named and nothing moves" {
            let d = repo()
            let wt = linked(d, "done")
            let lines = swept(d, true, true, 20)
            checked(
                d,
                exists(wt) &&
                    lines.contains("would retire ${wt} (done)") &&
                    shell(d, "git worktree list | wc -l").trim() == "2",
            )
        }
    }
    given "a tree a rule keeps" {
        then "a dirty tree is kept" {
            let d = repo()
            let wt = linked(d, "wip")
            let _ = shell(wt, "echo change > file")
            checked(d, kept(d, wt))
        }
        then "an unmerged tree is kept" {
            let d = repo()
            let wt = linked(d, "ahead")
            let _ = shell(wt, "echo own > own && git add -A && git commit -q -m own")
            checked(d, kept(d, wt))
        }
        then "a tree a process stands inside is kept" {
            let d = repo()
            let wt = linked(d, "held")
            let standing = "${wt}/deep"
            let seen: fn() -> Result<Seen, string> = () -> Seen { dirs: [standing] }
            let named = swept_seeing(d, true, true, 20, seen)
                .any(it.starts_with("would retire ${wt} "))
            let _ = swept_seeing(d, true, false, 20, seen)
            checked(d, !named && exists(wt))
        }
        then "where no process's directory may be read, nothing is retired and the sweep says why" {
            let d = repo()
            let wt = linked(d, "done")
            let ok = match reclaimed_seeing(
                ReclaimFlags { floor: 20, repo: d },
                Asked { now: true },
                unseen,
            ) { .Ok(_) -> false, .Err(why) -> why.contains("no process's directory") }
            checked(d, ok && exists(wt))
        }
        then "another user's process it may not read is named, and retires nothing less" {
            let d = repo()
            let wt = linked(d, "done")
            let hid: fn() -> Result<Seen, string> = () -> Seen { dirs: [], hidden: 2 }
            let lines = swept_seeing(d, true, false, 20, hid)
            checked(
                d,
                !exists(wt) &&
                    lines.any(it.starts_with("reclaim: 2 process(es) of other users not read")),
            )
        }
        then "the kernel's marks: this user's refused read refuses, another's is counted, an ended process is no mark" {
            (proc_seen("/a\n!other\n/b\n!other\n") catch Seen { dirs: [], hidden: -1 }).hidden == 2 &&
                proc_seen("/a\n!own\n") is .Err &&
                (proc_seen("/a\n/b\n") catch Seen { dirs: [] }).dirs.length == 2
        }
        then "lsof's records: a refused read is this user's or another's by the process's user" {
            let text = "p1\nu0\nn/r\np2\nu501\nn/proc/2/cwd (readlink: Permission denied)\n"
            (lsof_seen(text, "0") catch Seen { dirs: [], hidden: -1 }).hidden == 1 &&
                lsof_seen(text, "501") is .Err
        }
        then "this machine's reader reads more than one process's directory: this one's and its sleeper's" {
            let d = repo()
            let wt = linked(d, "held")
            let _ = make_dirs("${wt}/deep")
            checked(d, read_many(wt))
        }
        then "this machine's reader sees a process standing in a tree, or refuses to say" {
            let d = repo()
            let wt = linked(d, "held")
            let _ = make_dirs("${wt}/deep")
            checked(d, seen_or_refused(wt))
        }
        then "main's checkout is never touched" {
            let d = repo()
            let _ = shell(d, "git checkout -q -b home && git worktree add -q ${d}-main main")
            checked(d, kept(d, "${d}-main"))
        }
        then "a detached tree is kept" {
            let d = repo()
            let _ = shell(d, "git worktree add -q --detach ${d}-side main")
            checked(d, kept(d, "${d}-side"))
        }
    }
    given "the floor" {
        then "free space at or over it retires nothing" {
            let d = repo()
            let wt = linked(d, "done")
            checked(d, swept(d, false, false, 0).any(it.contains("nothing to do")) && exists(wt))
        }
        then "free space under it retires" {
            let d = repo()
            let wt = linked(d, "done")
            let _ = swept(d, false, false, 1000000)
            checked(d, !exists(wt))
        }
    }
    given "git's listing" {
        then "each stanza is a tree, a detached one with no branch, each path once" {
            let listing = "worktree /r\nHEAD 1\nbranch refs/heads/main\n\nworktree /r-side\nHEAD 2\ndetached\n\nworktree /r\nHEAD 1\n"
            let trees = worktrees_of(listing)
            trees.length == 2 &&
                trees[0].branch == "main" &&
                trees[1].path == "/r-side" &&
                trees[1].branch == ""
        }
        then "a path inside a tree is the tree's, a lookalike sibling is not" {
            inside("/r-a/deep", "/r-a") && inside("/r-a", "/r-a") && !inside("/r-ab", "/r-a")
        }
    }
    given "the fixtures' own clearing" {
        then "a link inside is unlinked and what it points at stands" {
            let mine = scratch_dir()
            let other = scratch_dir()
            let _ = shell(other, "echo kept > kept && mkdir sub && echo deep > sub/deep")
            let _ = shell(mine, "ln -s '${other}' out && ln -s '${other}/kept' file")
            let ok = cleared(mine) &&
                !exists(mine) &&
                exists("${other}/kept") &&
                exists("${other}/sub/deep")
            cleared(other) && ok
        }
        then "a directory `mktemp` did not make is left alone" {
            let root = scratch_dir()
            let _ = shell(root, "mkdir plain")
            let ok = !cleared("${root}/plain") && exists("${root}/plain")
            cleared(root) && ok
        }
    }
}
