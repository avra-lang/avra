use commands.{RATCHETS}
use @std.io.{exists}

spec "cost — the ratchets, one registry" {
    then "every ratchet names itself once" { RATCHETS.all((r) -> RATCHETS.filter(it.name == r.name).length == 1) }
    then "every ratchet's baseline is a file the tree holds" { RATCHETS.all(exists(it.baseline)) }
    then "every ratchet records by at least one step" { RATCHETS.all(!it.accept.is_empty()) }
    then "only `wall` reads a measured file" {
        RATCHETS.filter((r) -> r.accept.any(it.file)).map(it.name).join(" ") == "wall"
    }
}
