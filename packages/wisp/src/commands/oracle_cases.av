//! THE ORACLE'S CASES, one row each (`wisp oracle`). A case added here is run by the gate's
//! keeper that names it; its old script or Make recipe goes in the same change.

/// Every case `wisp oracle` knows, in the order it runs them.
export const CASES: List<Case> = [
    // The extern seam keeps every width: the Avra reader and a C reader of the same object agree.
    Case {
        name: "width-witness",
        subject: "packages/width-witness",
        needs: ["build/width_witness.o"],
        readings: [
            Reading.Native,
            Reading
                .Reference(
                    "c",
                    [
                        [
                            "cc",
                            "-O2",
                            "-o",
                            "build/witness-c",
                            "packages/width-witness/src/reader.c",
                            "build/width_witness.o",
                        ],
                        ["build/witness-c"],
                    ],
                ),
        ],
    },
]
