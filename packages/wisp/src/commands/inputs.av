//! `wisp inputs [--accept] [--avra <compiler>]` — EVERY READ OF THE WORLD IS AN INPUT THROUGH ONE
//! DOOR, and this counts the reads that are not: a call in the compiler or its CLI that asks the
//! disk, the environment, a tool, a child process, the clock, the process table or argv, outside
//! the door — the files that define the input verbs and the disk's answers to them (DOOR), never
//! the directories they stand in.
//!
//! A SITE IS FOUND FROM WHAT ITS FILE IMPORTS, never from a verb's spelling: a name taken from a
//! world package is looked up in that package's table and its calls counted, so a local fn that
//! happens to be called `env` is nobody's site. Beside those: a call through a `Host` value
//! (`host.read(…)`), and a call of a world runtime row the file declares itself.
//!
//! THE TABLES CANNOT GO STALE QUIETLY. A `use @std.…` line the keeper cannot read is refused; a
//! `@std` package a scope file imports is in WORLD or INERT, or refused; a WORLD package's name
//! classed pure is held to its own source (a read reached only through a METHOD is not followed);
//! an INERT package declares the rows pinned here and no other, and imports inert packages alone;
//! a name imported from a WORLD package, and a row a scope file declares, is classified or refused.
//!
//! THE BASELINE LISTS SITES, NEVER COUNTS: tools/inputs.baseline holds a group, a file and the
//! site's own source line. A site not listed fails, naming its line. A licence comment (`LICENSED`, an `input.` id, a reason) on
//! the line above says a read is no input and takes it out; its id's shape is the compiler's own
//! (`avra licences --json`). The file only falls: `--accept` prunes what a move made gone.
use @std.cli.{CliResult, Runnable, command, flag, option}
use @std.io.{read_text, write_text}
use @std.json.{Json, parse}
use @std.process.{cmd, tool_at}
use @std.path.{dir_of}
use @std.text.{pad_left, pad_right}

const SCOPE: List<string> = [
    "packages/std-avrac/src",
    "packages/cli/src",
    "packages/std-program/src",
]

/// The `@std` packages whose sources the scope reads: their own, never WORLD or INERT.
const OWN: List<string> = ["avrac", "program"]

/// The FILES that define the input verbs and the disk's answers to them. A read beside one, in the
/// same directory, is outside like any other.
const DOOR: List<string> = [
    "packages/cli/src/commands/disk_host.av",
    "packages/std-avrac/src/compiler/host/host.av",
    "packages/std-program/src/source_facts.av",
]

const BASELINE: string = "tools/inputs.baseline"

/// What a call asks of the world. A kind here is a read; the rest classify a name.
const COUNTED: List<string> = ["read", "env", "tool", "spawn", "clock", "pid", "argv", "fetch"]

