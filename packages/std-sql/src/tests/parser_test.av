// The SQL lexicon tokenizes its own vocabulary, the assembled parser
// grammar (built from `@grammar_rule`-annotated functions) carries no
// coherence defects, and `parse_sql` builds a real `SqlSelect` from a
// SELECT statement — the end-to-end proof the `@grammar_rule` +
// `collect` + `@std/grammar` assembly actually works.
use @std.sql.lexicon.{SQL}
use @std.sql.parser.{parse_sql, sql_parser_grammar, SqlNode, SqlExpr, SqlSelect, SelectItem, TableRef, JoinItem, WhenClause, InsertStmt, UpdateStmt, DeleteStmt}
use @std.grammar.{lex}

fn kinds_of(source: string) -> string {
    [t.kind for t in lex(SQL, source, ["WS"]).tokens if t.kind != "EOF"].join(",")
}

spec "sql/lexicon" {
    given "SQL's own token vocabulary" {
        then "a single-letter identifier is IDENT, not the alpha fragment" {
            kinds_of("a") == "IDENT"
        }
        then "a single digit is NUMBER, not the digit fragment" {
            kinds_of("5") == "NUMBER"
        }
        then "a statement's shape tokenizes as keywords, idents and punctuation" {
            kinds_of("SELECT a, b FROM t") == "IDENT,IDENT,OP,IDENT,IDENT,IDENT"
        }
        then "a line comment is its own token" {
            kinds_of("-- a comment\na") == "LINE_COMMENT,IDENT"
        }
    }
}

spec "sql/parser_grammar" {
    given "the assembled parser grammar" {
        then "every @grammar_rule text parsed and cross-references resolved" {
            sql_parser_grammar().defects(["IDENT", "NUMBER", "STRING", "QUOTED_IDENT", "HOLE"]).is_empty()
        }
    }
}

fn selected(source: string) -> SqlNode? {
    let o = parse_sql(source)
    if !o.diagnostics.is_empty() || o.result == null { return null }
    match o.result! {
        .Node(n) -> n,
        _ -> null,
    }
}

fn select_of(n: SqlNode?) -> SqlSelect? {
    if n == null { return null }
    match n! {
        .Sel(s) -> s,
        _ -> null,
    }
}

fn insert_of(n: SqlNode?) -> InsertStmt? {
    if n == null { return null }
    match n! {
        .Ins(i) -> i,
        _ -> null,
    }
}

fn update_of(n: SqlNode?) -> UpdateStmt? {
    if n == null { return null }
    match n! {
        .Upd(u) -> u,
        _ -> null,
    }
}

fn delete_of(n: SqlNode?) -> DeleteStmt? {
    if n == null { return null }
    match n! {
        .Del(d) -> d,
        _ -> null,
    }
}

/// A canonical rendering of an expression tree — for asserting on
/// clause shape (precedence, operator nesting, qualified columns)
/// without hand-unwrapping `SqlExpr` in every test.
fn render_expr(e: SqlExpr) -> string {
    match e {
        .Column(qualifier, name) -> if qualifier == null { name } else { "${qualifier!}.${name}" },
        .Number(text) -> text,
        .Str(text) -> "'${text}'",
        .Hole(name) -> "\${${name}}",
        .Not(inner) -> "(NOT ${render_expr(inner)})",
        .BinOp(op, lhs, rhs) -> "(${render_expr(lhs)} ${op} ${render_expr(rhs)})",
        .Call(fn_name, args) -> "${fn_name}(${[render_expr(a) for a in args].join(", ")})",
        .Star -> "*",
        .IsNull(inner, negated) -> "(${render_expr(inner)} IS ${if negated { "NOT " } else { "" }}NULL)",
        .Between(inner, lo, hi, negated) -> "(${render_expr(inner)} ${if negated { "NOT " } else { "" }}BETWEEN ${render_expr(lo)} AND ${render_expr(hi)})",
        .In(inner, list, negated) -> "(${render_expr(inner)} ${if negated { "NOT " } else { "" }}IN (${[render_expr(a) for a in list].join(", ")}))",
        .Case(operand, whens, else_branch) -> render_case(operand, whens, else_branch),
    }
}

fn render_case(operand: SqlExpr?, whens: List<WhenClause>, else_branch: SqlExpr?) -> string {
    let head = if operand == null { "CASE" } else { "CASE ${render_expr(operand!)}" }
    let arms = [" WHEN ${render_expr(w.cond)} THEN ${render_expr(w.result)}" for w in whens].join("")
    let tail = if else_branch == null { "" } else { " ELSE ${render_expr(else_branch!)}" }
    "${head}${arms}${tail} END"
}

fn where_ident(e: SqlExpr?) -> string? {
    if e == null { return null }
    render_expr(e!)
}

fn where_shape(source: string) -> string? {
    let s? = select_of(selected(source)) else { return null }
    let w? = s.where else { return null }
    render_expr(w)
}

fn columns_shape(items: List<SelectItem>) -> string {
    [if i.as_name == null { render_expr(i.expr) } else { "${render_expr(i.expr)} AS ${i.as_name!}" } for i in items].join(",")
}

fn table_shape(t: TableRef) -> string {
    if t.as_name == null { t.name } else { "${t.name} AS ${t.as_name!}" }
}

fn join_shape(j: JoinItem) -> string {
    "${j.kind} JOIN ${table_shape(j.other)} ON ${render_expr(j.on)}"
}

fn from_shape(source: string) -> string? {
    let s? = select_of(selected(source)) else { return null }
    let joins = [join_shape(j) for j in s.from.joins].join(" ")
    if joins.is_empty() { table_shape(s.from.first) } else { "${table_shape(s.from.first)} ${joins}" }
}

fn order_shape(source: string) -> string? {
    let s? = select_of(selected(source)) else { return null }
    [if o.desc { "${render_expr(o.expr)} DESC" } else { render_expr(o.expr) } for o in s.order_by].join(",")
}

fn limit_shape(source: string) -> string? {
    let s? = select_of(selected(source)) else { return null }
    let lim? = s.limit else { return null }
    render_expr(lim)
}

fn group_by_shape(source: string) -> string? {
    let s? = select_of(selected(source)) else { return null }
    [render_expr(e) for e in s.group_by].join(",")
}

fn having_shape(source: string) -> string? {
    let s? = select_of(selected(source)) else { return null }
    let h? = s.having else { return null }
    render_expr(h)
}

spec "sql/parse_sql" {
    given "a plain SELECT" {
        then "columns, table and no WHERE" {
            let s = select_of(selected("SELECT title FROM Post"))
            s != null && columns_shape(s!.columns) == "title" && from_shape("SELECT title FROM Post") == "Post" && s!.where == null
        }
    }
    given "a SELECT with several columns and a WHERE" {
        then "every column, the table, and the WHERE identifier" {
            let s = select_of(selected("SELECT title, author FROM Post WHERE title"))
            s != null && columns_shape(s!.columns) == "title,author" && where_ident(s!.where) == "title"
        }
    }
    given "malformed input" {
        then "a diagnostic, not a crash" {
            !parse_sql("SELECT").diagnostics.is_empty()
        }
    }
}

spec "sql/atoms" {
    given "a number literal" {
        then "builds as Number" {
            where_shape("SELECT a FROM t WHERE 5") == "5"
        }
    }
    given "a string literal" {
        then "unquoted, and a doubled quote unescapes to one" {
            where_shape("SELECT a FROM t WHERE 'it''s'") == "'it's'"
        }
    }
    given "a hole placeholder" {
        then "builds as Hole, name only, no braces" {
            where_shape("SELECT a FROM t WHERE \${id}") == "\${id}"
        }
    }
    given "a table-qualified column" {
        then "builds as Column(qualifier, name)" {
            where_shape("SELECT a FROM t WHERE p.title") == "p.title"
        }
    }
}

spec "sql/boolean_expr" {
    given "NOT" {
        then "wraps its comparison" {
            where_shape("SELECT a FROM t WHERE NOT a = 1") == "(NOT (a = 1))"
        }
    }
    given "an AND chain of three" {
        then "folds left-associatively" {
            where_shape("SELECT a FROM t WHERE a AND b AND c") == "((a AND b) AND c)"
        }
    }
    given "an OR chain of three" {
        then "folds left-associatively" {
            where_shape("SELECT a FROM t WHERE a OR b OR c") == "((a OR b) OR c)"
        }
    }
    given "AND binding tighter than OR" {
        then "a AND b OR c groups as (a AND b) OR c" {
            where_shape("SELECT a FROM t WHERE a AND b OR c") == "((a AND b) OR c)"
        }
    }
    given "NOT binding tighter than AND" {
        then "NOT a AND b groups as (NOT a) AND b" {
            where_shape("SELECT a FROM t WHERE NOT a AND b") == "((NOT a) AND b)"
        }
    }
}

spec "sql/select_list" {
    given "a column with AS" {
        then "aliases correctly" {
            let s = select_of(selected("SELECT u.name AS author_name FROM User AS u"))
            s != null && columns_shape(s!.columns) == "u.name AS author_name"
        }
    }
    given "an expression column" {
        then "builds like any other WHERE expression" {
            let s = select_of(selected("SELECT p.published FROM Post AS p"))
            s != null && columns_shape(s!.columns) == "p.published"
        }
    }
}

spec "sql/from_join" {
    given "a bare table" {
        then "no joins" {
            from_shape("SELECT a FROM Post") == "Post"
        }
    }
    given "a table with AS" {
        then "the alias renders" {
            from_shape("SELECT a FROM Post AS p") == "Post AS p"
        }
    }
    given "an INNER JOIN, keyword omitted" {
        then "defaults to INNER" {
            from_shape("SELECT a FROM Post AS p JOIN User AS u ON u.id = p.author_id") == "Post AS p INNER JOIN User AS u ON (u.id = p.author_id)"
        }
    }
    given "an explicit LEFT JOIN" {
        then "the kind carries through" {
            from_shape("SELECT a FROM Post AS p LEFT JOIN User AS u ON u.id = p.author_id") == "Post AS p LEFT JOIN User AS u ON (u.id = p.author_id)"
        }
    }
    given "two joins" {
        then "both appear in order" {
            let expect = "Post AS p INNER JOIN User AS u ON (u.id = p.author_id) INNER JOIN Tag AS t ON (t.post_id = p.id)"
            from_shape("SELECT a FROM Post AS p JOIN User AS u ON u.id = p.author_id JOIN Tag AS t ON t.post_id = p.id") == expect
        }
    }
}

spec "sql/order_limit" {
    given "ORDER BY with no direction" {
        then "defaults to ascending (not DESC)" {
            order_shape("SELECT a FROM t ORDER BY a") == "a"
        }
    }
    given "ORDER BY DESC" {
        then "the direction renders" {
            order_shape("SELECT a FROM t ORDER BY a DESC") == "a DESC"
        }
    }
    given "ORDER BY two columns" {
        then "both appear in order" {
            order_shape("SELECT a FROM t ORDER BY a DESC, b") == "a DESC,b"
        }
    }
    given "LIMIT" {
        then "builds as a Number" {
            limit_shape("SELECT a FROM t LIMIT 20") == "20"
        }
    }
    given "no LIMIT" {
        then "absent" {
            limit_shape("SELECT a FROM t") == null
        }
    }
    given "the user's own worked example" {
        then "everything together — columns, aliases, join, WHERE, ORDER BY, LIMIT" {
            let source = "SELECT p.title, u.name AS author_name FROM Post AS p JOIN User AS u ON u.id = p.author_id WHERE p.published AND p.created_at > \${ninety_days_ago} ORDER BY p.created_at DESC LIMIT 20"
            let s = select_of(selected(source))
            s != null && columns_shape(s!.columns) == "p.title,u.name AS author_name" && from_shape(source) == "Post AS p INNER JOIN User AS u ON (u.id = p.author_id)" && where_shape(source) == "(p.published AND (p.created_at > \${ninety_days_ago}))" && order_shape(source) == "p.created_at DESC" && limit_shape(source) == "20"
        }
    }
}

spec "sql/functions" {
    given "COUNT(*)" {
        then "the bare star builds as Star" {
            where_shape("SELECT a FROM t WHERE COUNT(*) > 0") == "(COUNT(*) > 0)"
        }
    }
    given "a call with one real argument" {
        then "builds as Call with one expression arg" {
            where_shape("SELECT a FROM t WHERE AVG(price) > 10") == "(AVG(price) > 10)"
        }
    }
    given "a call with several arguments" {
        then "every argument, in order" {
            where_shape("SELECT a FROM t WHERE date(created_at, '-90 days') > 0") == "(date(created_at, '-90 days') > 0)"
        }
    }
    given "a zero-argument call" {
        then "an empty argument list, not absence" {
            where_shape("SELECT a FROM t WHERE now() > 0") == "(now() > 0)"
        }
    }
    given "a call as a SELECT item" {
        then "aliases like any other expression" {
            let s = select_of(selected("SELECT COUNT(*) AS n FROM Post"))
            s != null && columns_shape(s!.columns) == "COUNT(*) AS n"
        }
    }
}

spec "sql/group_having" {
    given "GROUP BY one column" {
        then "builds the list" {
            group_by_shape("SELECT a, COUNT(*) FROM t GROUP BY a") == "a"
        }
    }
    given "GROUP BY two columns" {
        then "both, in order" {
            group_by_shape("SELECT a, b, COUNT(*) FROM t GROUP BY a, b") == "a,b"
        }
    }
    given "no GROUP BY" {
        then "an empty list" {
            group_by_shape("SELECT a FROM t") == ""
        }
    }
    given "HAVING" {
        then "builds like any other boolean expression" {
            having_shape("SELECT a, COUNT(*) FROM t GROUP BY a HAVING COUNT(*) >= 3") == "(COUNT(*) >= 3)"
        }
    }
    given "no HAVING" {
        then "absent" {
            having_shape("SELECT a FROM t GROUP BY a") == null
        }
    }
    given "GROUP BY and HAVING together with everything else" {
        then "all clauses build, in the right order" {
            let source = "SELECT customer, COUNT(*) AS n FROM Orders AS o WHERE o.placed_at > \${cutoff} GROUP BY customer HAVING COUNT(*) >= 3 ORDER BY n DESC LIMIT 10"
            let s = select_of(selected(source))
            s != null && columns_shape(s!.columns) == "customer,COUNT(*) AS n" && group_by_shape(source) == "customer" && having_shape(source) == "(COUNT(*) >= 3)" && order_shape(source) == "n DESC" && limit_shape(source) == "10"
        }
    }
}

spec "sql/predicates" {
    given "LIKE" {
        then "builds as a LIKE comparison" {
            where_shape("SELECT a FROM t WHERE name LIKE 'a%'") == "(name LIKE 'a%')"
        }
    }
    given "NOT LIKE" {
        then "carries the negation in the operator" {
            where_shape("SELECT a FROM t WHERE name NOT LIKE 'a%'") == "(name NOT LIKE 'a%')"
        }
    }
    given "IN with several values" {
        then "every value, in order" {
            where_shape("SELECT a FROM t WHERE id IN (1, 2, 3)") == "(id IN (1, 2, 3))"
        }
    }
    given "NOT IN" {
        then "negated" {
            where_shape("SELECT a FROM t WHERE id NOT IN (1, 2)") == "(id NOT IN (1, 2))"
        }
    }
    given "BETWEEN" {
        then "both bounds, in order" {
            where_shape("SELECT a FROM t WHERE age BETWEEN 1 AND 10") == "(age BETWEEN 1 AND 10)"
        }
    }
    given "NOT BETWEEN" {
        then "negated" {
            where_shape("SELECT a FROM t WHERE age NOT BETWEEN 1 AND 10") == "(age NOT BETWEEN 1 AND 10)"
        }
    }
    given "IS NULL" {
        then "builds as IsNull" {
            where_shape("SELECT a FROM t WHERE deleted_at IS NULL") == "(deleted_at IS NULL)"
        }
    }
    given "IS NOT NULL" {
        then "negated" {
            where_shape("SELECT a FROM t WHERE deleted_at IS NOT NULL") == "(deleted_at IS NOT NULL)"
        }
    }
    given "a predicate beside an ordinary comparison" {
        then "both sides of AND build independently" {
            where_shape("SELECT a FROM t WHERE age > 1 AND deleted_at IS NULL") == "((age > 1) AND (deleted_at IS NULL))"
        }
    }
}

spec "sql/case" {
    given "the searched form, no operand" {
        then "each WHEN is its own boolean condition" {
            where_shape("SELECT a FROM t WHERE CASE WHEN x > 1 THEN 1 ELSE 0 END = 1") == "(CASE WHEN (x > 1) THEN 1 ELSE 0 END = 1)"
        }
    }
    given "the searched form with no ELSE" {
        then "else_branch is absent, not a defaulted value" {
            where_shape("SELECT a FROM t WHERE CASE WHEN x > 1 THEN 1 END = 1") == "(CASE WHEN (x > 1) THEN 1 END = 1)"
        }
    }
    given "the simple form, with an operand" {
        then "each WHEN compares a value against the operand" {
            where_shape("SELECT a FROM t WHERE CASE x WHEN 1 THEN 'one' WHEN 2 THEN 'two' ELSE 'many' END = 'one'") == "(CASE x WHEN 1 THEN 'one' WHEN 2 THEN 'two' ELSE 'many' END = 'one')"
        }
    }
    given "CASE as a SELECT item" {
        then "aliases like any other expression" {
            let s = select_of(selected("SELECT CASE WHEN a > 0 THEN 'pos' ELSE 'non' END AS sign FROM t"))
            s != null && columns_shape(s!.columns) == "CASE WHEN (a > 0) THEN 'pos' ELSE 'non' END AS sign"
        }
    }
}

spec "sql/dml" {
    given "INSERT with one row" {
        then "the table, columns, and one row build" {
            let i = insert_of(selected("INSERT INTO posts (title, body) VALUES ('hi', 'there')"))
            i != null && i!.table_name == "posts" && i!.columns.join(",") == "title,body" && i!.rows.length == 1 && render_expr(i!.rows[0][0]) == "'hi'" && render_expr(i!.rows[0][1]) == "'there'"
        }
    }
    given "INSERT with several rows" {
        then "every row, in order" {
            let i = insert_of(selected("INSERT INTO posts (title) VALUES ('a'), ('b'), ('c')"))
            i != null && i!.rows.length == 3 && [render_expr(r[0]) for r in i!.rows].join(",") == "'a','b','c'"
        }
    }
    given "INSERT with RETURNING" {
        then "the returning list builds like a SELECT list" {
            let i = insert_of(selected("INSERT INTO posts (title) VALUES ('a') RETURNING id, title AS t"))
            i != null && columns_shape(i!.returning) == "id,title AS t"
        }
    }
    given "INSERT with no RETURNING" {
        then "an empty list" {
            let i = insert_of(selected("INSERT INTO posts (title) VALUES ('a')"))
            i != null && i!.returning.is_empty()
        }
    }
    given "UPDATE with one assignment" {
        then "the table and assignment build" {
            let u = update_of(selected("UPDATE posts SET title = 'new' WHERE id = 5"))
            u != null && u!.table_name == "posts" && u!.assignments.length == 1 && u!.assignments[0].column == "title" && render_expr(u!.assignments[0].value) == "'new'" && where_ident(u!.where) == "(id = 5)"
        }
    }
    given "UPDATE with several assignments" {
        then "every assignment, in order" {
            let u = update_of(selected("UPDATE posts SET title = 'new', published = 1 WHERE id = 5"))
            u != null && u!.assignments.length == 2 && u!.assignments[1].column == "published"
        }
    }
    given "UPDATE with no WHERE" {
        then "absent" {
            let u = update_of(selected("UPDATE posts SET title = 'new'"))
            u != null && u!.where == null
        }
    }
    given "UPDATE with RETURNING" {
        then "builds like a SELECT list" {
            let u = update_of(selected("UPDATE posts SET title = 'new' WHERE id = 5 RETURNING id"))
            u != null && columns_shape(u!.returning) == "id"
        }
    }
    given "DELETE with WHERE" {
        then "the table and condition build" {
            let d = delete_of(selected("DELETE FROM posts WHERE id = 5"))
            d != null && d!.table_name == "posts" && where_ident(d!.where) == "(id = 5)"
        }
    }
    given "DELETE with no WHERE" {
        then "absent — every row" {
            let d = delete_of(selected("DELETE FROM posts"))
            d != null && d!.where == null
        }
    }
    given "DELETE with RETURNING" {
        then "builds like a SELECT list" {
            let d = delete_of(selected("DELETE FROM posts WHERE id = 5 RETURNING id, title"))
            d != null && columns_shape(d!.returning) == "id,title"
        }
    }
}
