//! SQL's PARSER grammar, assembled from its own builder functions —
//! each rule's text lives on `@grammar_rule`, right beside the
//! function that builds it, nothing spelled twice. See
//! `@std/grammar`'s `collected.av` for the mechanism this reuses.

use @std.grammar.{
    grammar_rule,
    Grammar,
    Rule,
    Captured,
    parse_grammar_text,
    run_grammar,
    ready,
    Ready,
    RunOutcome,
    LexToken,
    Lexeme,
    lex,
    want,
}
use lexicon.{SQL}
use @std.meta.{Annotation}
use @std.errors.{Loc}

export enum SqlExpr {
    Column(qualifier: string?, name: string)
    Number(text: string)
    Str(text: string)
    Hole(name: string)
    Not(e: SqlExpr)
    BinOp(op: string, lhs: SqlExpr, rhs: SqlExpr)
    Call(fn_name: string, args: List<SqlExpr>)
    /// The bare `*` argument (`COUNT(*)`) — never a real column value.
    Star
    IsNull(e: SqlExpr, negated: bool)
    Between(e: SqlExpr, lo: SqlExpr, hi: SqlExpr, negated: bool)
    In(e: SqlExpr, source: InSource, negated: bool)
    /// `CASE operand WHEN ... THEN ... ELSE ... END` — `operand` null
    /// is the searched form (`CASE WHEN cond THEN ... END`), where
    /// each `WhenClause.when` is a full boolean condition rather than
    /// a value compared against `operand`.
    Case(operand: SqlExpr?, whens: List<WhenClause>, else_branch: SqlExpr?)
    /// A parenthesized `SELECT` used as a value — a scalar subquery,
    /// or `IN (SELECT ...)`'s own right side.
    Subquery(s: SqlSelect)
    Exists(s: SqlSelect)
    /// A window function — `e` is the call it modifies (`ROW_NUMBER()`,
    /// `SUM(amount)`), never a value on its own.
    Over(e: SqlExpr, over: OverClause)
}

/// A window function's own frame — `PARTITION BY`/`ORDER BY` only;
/// an explicit frame (`ROWS`/`RANGE BETWEEN ...`) has no spelling yet.
export type OverClause = { partition_by: List<SqlExpr>, order_by: List<OrderItem> }

/// `IN`'s own right side — a literal value list, or a subquery
/// answering the rows to compare against.
export enum InSource {
    Values(items: List<SqlExpr>)
    Subquery(s: SqlSelect)
}

/// One `WHEN ... THEN ...` arm of a `CASE` expression.
export type WhenClause = { cond: SqlExpr, result: SqlExpr }

/// One `SELECT` item: an expression, optionally named (`AS alias`).
export type SelectItem = { expr: SqlExpr, as_name: string? }

/// One `FROM`/`JOIN` table, optionally named (`AS alias`) — a bare
/// alias with no `AS` is not supported yet: it is grammatically
/// ambiguous with a following keyword (`FROM Post JOIN ...` would
/// read `JOIN` itself as `Post`'s alias, since keywords are ordinary
/// IDENT-kind tokens here, not a lexer class) — real SQL parsers close
/// this with a reserved-word list; this engine has none yet.
export enum FromSource {
    Named(name: string)
    /// A derived table — `FROM (SELECT ...) AS alias`. Unlike a named
    /// table's alias, this one is not optional: nothing else could
    /// name the columns a derived table exposes.
    Derived(sub: SqlSelect)
}

export type TableRef = { source: FromSource, as_name: string? }

export type JoinItem = { kind: string, other: TableRef, on: SqlExpr }

export type FromClause = { first: TableRef, joins: List<JoinItem> }

export type OrderItem = { expr: SqlExpr, desc: bool }

/// One `WITH name AS (subquery)` binding.
export type CteDef = { name: string, query: SqlSelect }

export type SqlSelect = {
    ctes: List<CteDef>,
    columns: List<SelectItem>,
    from: FromClause,
    where: SqlExpr?,
    group_by: List<SqlExpr>,
    having: SqlExpr?,
    order_by: List<OrderItem>,
    limit: SqlExpr?,
}

export type InsertStmt = { table_name: string, columns: List<string>, rows: List<List<SqlExpr>>, returning: List<SelectItem> }

/// One `SET column = value` — the value side is any expression, the
/// same grammar a `WHERE` condition builds from.
export type Assignment = { column: string, value: SqlExpr }

export type UpdateStmt = { table_name: string, assignments: List<Assignment>, where: SqlExpr?, returning: List<SelectItem> }

export type DeleteStmt = { table_name: string, where: SqlExpr?, returning: List<SelectItem> }

/// The one node type every rule in this file builds into — the
/// engine is monomorphic over it, so one wrapper spans every rule's
/// own answer shape, the same way the compiler's own DSL parser has
/// one `GrammarNode` for its whole grammar.
export enum SqlNode {
    SelItem(item: SelectItem)
    Cols(items: List<SelectItem>)
    Ex(e: SqlExpr)
    Sel(s: SqlSelect)
    Table(t: TableRef)
    Join(j: JoinItem)
    From(f: FromClause)
    Ord(o: OrderItem)
    OrderList(items: List<OrderItem>)
    /// A plain expression list — a function call's arguments, or a
    /// `GROUP BY` clause's own columns.
    ExList(items: List<SqlExpr>)
    When(w: WhenClause)
    Ins(i: InsertStmt)
    Assign(a: Assignment)
    Upd(u: UpdateStmt)
    Del(d: DeleteStmt)
    Cte(c: CteDef)
    Over(o: OverClause)
}

fn text_of(c: Captured<LexToken, SqlNode>) -> string {
    match c { .Terminal(t) -> t.text, .Node(_) or .Many(_) or .Absent -> "" }
}

/// Whether an optional capture matched at all — a marker slot's whole
/// job (`ink`/`isk`/`lp`), never the payload itself.
fn present(c: Captured<LexToken, SqlNode>) -> bool {
    match c { .Absent -> false, .Terminal(_) or .Node(_) or .Many(_) -> true }
}

/// The captured token's own KIND (`IDENT`/`NUMBER`/`STRING`/`HOLE`) —
/// `atom` reads this to decide which `SqlExpr` variant a bare
/// terminal becomes.
fn kind_of(c: Captured<LexToken, SqlNode>) -> string {
    match c { .Terminal(t) -> t.kind, .Node(_) or .Many(_) or .Absent -> "" }
}

/// A `STRING` token's raw text still carries its surrounding quotes
/// and SQL's own escape (a doubled quote, `''`, for a literal one).
fn unquote_sql_string(text: string) -> string {
    text.substring(1, text.length - 1).replace("''", "'")
}

/// A `HOLE` token's raw text is `${name}` — the parameter's bare name.
fn hole_name(text: string) -> string {
    text.substring(2, text.length - 1)
}

fn node_of(c: Captured<LexToken, SqlNode>) -> SqlNode? {
    match c { .Node(n) -> n, _ -> null }
}

impl SqlNode {
    fn as_ex() -> SqlExpr? { match self { .Ex(e) -> e, _ -> null } }
    fn as_sel_item() -> SelectItem? { match self { .SelItem(item) -> item, _ -> null } }
    fn as_cols() -> List<SelectItem>? { match self { .Cols(items) -> items, _ -> null } }
    fn as_table() -> TableRef? { match self { .Table(t) -> t, _ -> null } }
    fn as_join() -> JoinItem? { match self { .Join(j) -> j, _ -> null } }
    fn as_from() -> FromClause? { match self { .From(f) -> f, _ -> null } }
    fn as_order_item() -> OrderItem? { match self { .Ord(o) -> o, _ -> null } }
    fn as_order_list() -> List<OrderItem>? { match self { .OrderList(items) -> items, _ -> null } }
    fn as_ex_list() -> List<SqlExpr>? { match self { .ExList(items) -> items, _ -> null } }
    fn as_when() -> WhenClause? { match self { .When(w) -> w, _ -> null } }
    fn as_insert() -> InsertStmt? { match self { .Ins(i) -> i, _ -> null } }
    fn as_assign() -> Assignment? { match self { .Assign(a) -> a, _ -> null } }
    fn as_update() -> UpdateStmt? { match self { .Upd(u) -> u, _ -> null } }
    fn as_delete() -> DeleteStmt? { match self { .Del(d) -> d, _ -> null } }
    fn as_select() -> SqlSelect? { match self { .Sel(s) -> s, _ -> null } }
    fn as_cte() -> CteDef? { match self { .Cte(c) -> c, _ -> null } }
    fn as_over() -> OverClause? { match self { .Over(o) -> o, _ -> null } }
}

fn ex_of(c: Captured<LexToken, SqlNode>) -> SqlExpr? {
    node_of(c)?.as_ex()
}

fn table_of(c: Captured<LexToken, SqlNode>) -> TableRef? {
    node_of(c)?.as_table()
}

fn from_of(c: Captured<LexToken, SqlNode>) -> FromClause? {
    node_of(c)?.as_from()
}

/// A repeated operand capture (`(\"AND\" r:not_expr)*`'s accumulated
/// `r`), each already built into its own `SqlExpr`.
fn exprs_of(c: Captured<LexToken, SqlNode>) -> Result<List<SqlExpr>, string> {
    match c {
        .Many(items) -> .Ok([want(ex_of(i), "an operand")? for i in items]),
        .Absent -> .Ok([]),
        .Terminal(_) or .Node(_) -> .Err("expected a list of operands"),
    }
}

/// A repeated capture whose elements each build one `SelectItem` —
/// `column_list`'s own `c:col_item (\",\" c:col_item)*`.
fn sel_items_of(c: Captured<LexToken, SqlNode>) -> Result<List<SelectItem>, string> {
    match c {
        .Many(items) -> .Ok([want(node_of(i)?.as_sel_item(), "a select item")? for i in items]),
        .Absent -> .Ok([]),
        .Terminal(_) or .Node(_) -> .Err("expected a list of select items"),
    }
}

/// A repeated capture whose elements each build one `JoinItem` — the
/// `FROM`'s own `(j:join_item)*` tail.
fn join_items_of(c: Captured<LexToken, SqlNode>) -> Result<List<JoinItem>, string> {
    match c {
        .Many(items) -> .Ok([want(node_of(i)?.as_join(), "a join")? for i in items]),
        .Absent -> .Ok([]),
        .Terminal(_) or .Node(_) -> .Err("expected a list of joins"),
    }
}

/// `order_by_clause`'s own repeated capture, one `OrderItem` per
/// element — distinct from `order_items_of`, which reads the WHOLE
/// clause's already-aggregated `OrderList` back out.
fn ord_items_of(c: Captured<LexToken, SqlNode>) -> Result<List<OrderItem>, string> {
    match c {
        .Many(items) -> .Ok([want(node_of(i)?.as_order_item(), "an order item")? for i in items]),
        .Absent -> .Ok([]),
        .Terminal(_) or .Node(_) -> .Err("expected a list of order items"),
    }
}

/// `CASE`'s own `(w:when_clause)+` — one `WhenClause` per arm, always
/// at least one (`+`, never `*`).
fn when_items_of(c: Captured<LexToken, SqlNode>) -> Result<List<WhenClause>, string> {
    match c {
        .Many(items) -> .Ok([want(node_of(i)?.as_when(), "a when clause")? for i in items]),
        .Absent -> .Ok([]),
        .Terminal(_) or .Node(_) -> .Err("expected a list of when clauses"),
    }
}

/// `select_stmt`'s own `c:cte_def (\",\" c:cte_def)*` — absent when
/// there is no `WITH` clause at all.
fn cte_items_of(c: Captured<LexToken, SqlNode>) -> Result<List<CteDef>, string> {
    match c {
        .Many(items) -> .Ok([want(node_of(i)?.as_cte(), "a WITH binding")? for i in items]),
        .Absent -> .Ok([]),
        .Terminal(_) or .Node(_) -> .Err("expected a list of WITH bindings"),
    }
}

/// `insert_stmt`'s own `c:IDENT (\",\" c:IDENT)*` — bare column
/// names, never expressions.
fn names_of(c: Captured<LexToken, SqlNode>) -> Result<List<string>, string> {
    match c {
        .Many(items) -> .Ok([text_of(i) for i in items]),
        .Absent -> .Ok([]),
        .Terminal(_) or .Node(_) -> .Err("expected a list of names"),
    }
}

/// `insert_stmt`'s own `r:values_row (\",\" r:values_row)*` — one
/// already-built expression list per row.
fn rows_of(c: Captured<LexToken, SqlNode>) -> Result<List<List<SqlExpr>>, string> {
    match c {
        .Many(items) -> .Ok([want(node_of(i)?.as_ex_list(), "a values row")? for i in items]),
        .Absent -> .Ok([]),
        .Terminal(_) or .Node(_) -> .Err("expected a list of value rows"),
    }
}

/// `update_stmt`'s own `a:assignment (\",\" a:assignment)*`.
fn assignments_of(c: Captured<LexToken, SqlNode>) -> Result<List<Assignment>, string> {
    match c {
        .Many(items) -> .Ok([want(node_of(i)?.as_assign(), "an assignment")? for i in items]),
        .Absent -> .Ok([]),
        .Terminal(_) or .Node(_) -> .Err("expected a list of assignments"),
    }
}

/// `insert_stmt`/`update_stmt`/`delete_stmt`'s own optional
/// `RETURNING` — absent reads as no returning list at all.
fn returning_of(c: Captured<LexToken, SqlNode>) -> List<SelectItem> {
    node_of(c)?.as_cols() ?? []
}

/// `select_stmt`'s own `o:order_by_clause?` — absent when there is no
/// `ORDER BY` at all. A single optional reference, never `.Many` —
/// `order_by_clause` itself already aggregated its own list.
fn order_items_of(c: Captured<LexToken, SqlNode>) -> List<OrderItem> {
    node_of(c)?.as_order_list() ?? []
}

/// `select_stmt`'s own `cols:column_list` — a single reference to a
/// rule that already aggregated its own list, never `.Many` — the
/// same shape as `order_items_of`, not `sel_items_of` (that one reads
/// `column_list`'s OWN repeated `c:col_item (\",\" c:col_item)*`).
fn cols_of(c: Captured<LexToken, SqlNode>) -> List<SelectItem> {
    node_of(c)?.as_cols() ?? []
}

/// A single optional reference to a rule that already aggregated its
/// own `ExList` — `select_stmt`'s `g:group_by_clause?`, same shape as
/// `cols_of`/`order_items_of`, and the `IN (...)` predicate's own
/// `list:expr_list?`. Absent reads as the empty list.
fn ex_list_of(c: Captured<LexToken, SqlNode>) -> List<SqlExpr> {
    node_of(c)?.as_ex_list() ?? []
}

/// `IN`'s own `list:in_source?` — a subquery if `in_source` matched
/// `select_stmt`, a value list if it matched `expr_list`, and an
/// empty value list for a bare `IN ()` (nothing between the parens
/// is neither, and reads absent the same way an empty list always
/// has).
fn in_source_of(c: Captured<LexToken, SqlNode>) -> InSource {
    let n? = node_of(c) else { return InSource.Values([]) }
    match n {
        .Sel(s) -> InSource.Subquery(s),
        .ExList(items) -> InSource.Values(items),
        rest -> InSource.Values([]),
    }
}

fn node(n: SqlNode) -> Captured<LexToken, SqlNode> { Captured.Node(n) }

/// One `SELECT` list entry: an expression, optionally `AS`-named.
@grammar_rule("e:or_expr (\"AS\" a:IDENT)?")
fn col_item(caps: List<Captured<LexToken, SqlNode>>) -> Result<Captured<LexToken, SqlNode>, string> {
    let e? = ex_of(caps[0]) else { return .Err("select item: did not build") }
    let as_name = match caps[1] {
        .Absent -> null,
        .Terminal(_) or .Node(_) or .Many(_) -> text_of(caps[1]),
    }
    .Ok(node(SqlNode.SelItem(SelectItem { expr: e, as_name: as_name })))
}

@grammar_rule("c:col_item (\",\" c:col_item)*")
fn column_list(caps: List<Captured<LexToken, SqlNode>>) -> Result<
    Captured<LexToken, SqlNode>,
    string,
> {
    .Ok(node(SqlNode.Cols(sel_items_of(caps[0])?)))
}

/// One `FROM`/`JOIN` table — `AS`-named or bare, or a derived table
/// (`(SELECT ...) AS alias`). The two branches share no first token
/// (`"("` vs a bare `IDENT`), so unlike `atom`'s own parenthesized
/// forms there is nothing here for the checker to refuse. Both
/// branches happen to answer `caps.length == 2` — a coincidence of
/// their own shapes, not something this dispatch relies on — so
/// telling them apart reads `caps[0]`'s SHAPE (an already-built
/// `.Node` for the derived form, a raw `.Terminal` for a bare name),
/// the same idiom `atom` uses one level up.
@grammar_rule("\"(\" s:select_stmt \")\" \"AS\" a:IDENT | n:IDENT (\"AS\" a:IDENT)?")
fn table_ref(caps: List<Captured<LexToken, SqlNode>>) -> Result<Captured<LexToken, SqlNode>, string> {
    let derived = node_of(caps[0])
    if derived != null {
        let sub? = derived!.as_select() else { return .Err("derived table: subquery did not build") }
        return .Ok(
            node(
                SqlNode
                    .Table(TableRef { source: FromSource.Derived(sub), as_name: text_of(caps[1]) }),
            ),
        )
    }
    let name = text_of(caps[0])
    let as_name = match caps[1] {
        .Absent -> null,
        .Terminal(_) or .Node(_) or .Many(_) -> text_of(caps[1]),
    }
    .Ok(node(SqlNode.Table(TableRef { source: FromSource.Named(name), as_name: as_name })))
}

/// `INNER`/`LEFT`/`RIGHT` all optional (bare `JOIN` is `INNER`).
@grammar_rule("k:(\"LEFT\"|\"INNER\"|\"RIGHT\")? \"JOIN\" t:table_ref \"ON\" c:or_expr")
fn join_item(caps: List<Captured<LexToken, SqlNode>>) -> Result<Captured<LexToken, SqlNode>, string> {
    let kind = text_of(caps[0])
    let t? = table_of(caps[1]) else { return .Err("join: table did not build") }
    let c? = ex_of(caps[2]) else { return .Err("join: condition did not build") }
    .Ok(
        node(
            SqlNode
                .Join(JoinItem { kind: if kind.is_empty() { "INNER" } else { kind }, other: t, on: c }),
        ),
    )
}

@grammar_rule("t:table_ref (j:join_item)*")
fn from_clause(caps: List<Captured<LexToken, SqlNode>>) -> Result<
    Captured<LexToken, SqlNode>,
    string,
> {
    let t? = table_of(caps[0]) else { return .Err("from: table did not build") }
    let joins = join_items_of(caps[1])?
    .Ok(node(SqlNode.From(FromClause { first: t, joins: joins })))
}

@grammar_rule("e:or_expr (d:(\"ASC\"|\"DESC\"))?")
fn order_item(caps: List<Captured<LexToken, SqlNode>>) -> Result<
    Captured<LexToken, SqlNode>,
    string,
> {
    let e? = ex_of(caps[0]) else { return .Err("order: operand did not build") }
    .Ok(node(SqlNode.Ord(OrderItem { expr: e, desc: text_of(caps[1]) == "DESC" })))
}

@grammar_rule("\"ORDER\" \"BY\" o:order_item (\",\" o:order_item)*")
fn order_by_clause(caps: List<Captured<LexToken, SqlNode>>) -> Result<
    Captured<LexToken, SqlNode>,
    string,
> {
    .Ok(node(SqlNode.OrderList(ord_items_of(caps[0])?)))
}

@grammar_rule("\"WHERE\" e:or_expr")
fn where_clause(caps: List<Captured<LexToken, SqlNode>>) -> Result<
    Captured<LexToken, SqlNode>,
    string,
> {
    .Ok(caps[0])
}

/// Lowest precedence: `a AND b OR c AND d` groups as `(a AND b) OR (c
/// AND d)` — left-associative, folded from the repeated tail.
@grammar_rule("l:and_expr (\"OR\" r:and_expr)*")
fn or_expr(caps: List<Captured<LexToken, SqlNode>>) -> Result<Captured<LexToken, SqlNode>, string> {
    let l? = ex_of(caps[0]) else { return .Err("or: left operand did not build") }
    let rest = exprs_of(caps[1])?
    mut acc = l
    for r in rest { acc = SqlExpr.BinOp("OR", acc, r) }
    .Ok(node(SqlNode.Ex(acc)))
}

@grammar_rule("l:not_expr (\"AND\" r:not_expr)*")
fn and_expr(caps: List<Captured<LexToken, SqlNode>>) -> Result<Captured<LexToken, SqlNode>, string> {
    let l? = ex_of(caps[0]) else { return .Err("and: left operand did not build") }
    let rest = exprs_of(caps[1])?
    mut acc = l
    for r in rest { acc = SqlExpr.BinOp("AND", acc, r) }
    .Ok(node(SqlNode.Ex(acc)))
}

/// `NOT` binds tighter than `AND`/`OR`, looser than a comparison.
/// Labels bind in `deep_items` order — the OUTER sequence's own items
/// first, a nested group's after — so `e` (the outer item) is
/// `caps[0]` and `n` (nested inside the optional group) is `caps[1]`,
/// not source order (confirmed by direct probe, not assumed).
@grammar_rule("(n:\"NOT\")? e:cmp_expr")
fn not_expr(caps: List<Captured<LexToken, SqlNode>>) -> Result<Captured<LexToken, SqlNode>, string> {
    let e? = ex_of(caps[0]) else { return .Err("not: operand did not build") }
    match caps[1] {
        .Absent -> .Ok(node(SqlNode.Ex(e))),
        _ -> .Ok(node(SqlNode.Ex(SqlExpr.Not(e)))),
    }
}

/// A comparison, or one of the negatable keyword predicates (`LIKE`,
/// `IN (...)`, `BETWEEN … AND …`, `IS [NOT] NULL`) — five independent
/// optional suffixes after one shared `l:atom`, the same reason
/// `atom` itself uses two: each starts on a different first token
/// (an operator symbol, `LIKE`, `IN`, `BETWEEN`, `IS`), so none
/// competes with the others or with `l`.
///
/// Each group's own REQUIRED item is its presence marker — `rl`,
/// `ink`, `lo`, `isk` are never optional inside their own group, so
/// unlike `list` (an empty `IN ()`) or a bare `NOT`, they can never
/// read Absent for a reason other than "this group did not match".
@grammar_rule("l:atom (op:(\"=\"|\"<\"|\">\"|\"<=\"|\">=\"|\"<>\"|\"!=\") r:atom)? ((nl:\"NOT\")? \"LIKE\" rl:atom)? ((ni:\"NOT\")? ink:\"IN\" \"(\" list:in_source? \")\")? ((nb:\"NOT\")? \"BETWEEN\" lo:atom \"AND\" hi:atom)? (isk:\"IS\" (nn:\"NOT\")? \"NULL\")?")
fn cmp_expr(caps: List<Captured<LexToken, SqlNode>>) -> Result<Captured<LexToken, SqlNode>, string> {
    let l? = ex_of(caps[0]) else { return .Err("expr: left side did not build") }
    let op = text_of(caps[1])
    if !op.is_empty() {
        let r? = ex_of(caps[2]) else { return .Err("expr: right side did not build") }
        return .Ok(node(SqlNode.Ex(SqlExpr.BinOp(op, l, r))))
    }
    if present(caps[3]) {
        let rl? = ex_of(caps[3]) else { return .Err("like: right side did not build") }
        let kw = if present(caps[4]) { "NOT LIKE" } else { "LIKE" }
        return .Ok(node(SqlNode.Ex(SqlExpr.BinOp(kw, l, rl))))
    }
    if present(caps[5]) {
        return .Ok(node(SqlNode.Ex(SqlExpr.In(l, in_source_of(caps[6]), present(caps[7])))))
    }
    if present(caps[8]) {
        let lo? = ex_of(caps[8]) else { return .Err("between: lower bound did not build") }
        let hi? = ex_of(caps[9]) else { return .Err("between: upper bound did not build") }
        return .Ok(node(SqlNode.Ex(SqlExpr.Between(l, lo, hi, present(caps[10])))))
    }
    if present(caps[11]) {
        return .Ok(node(SqlNode.Ex(SqlExpr.IsNull(l, present(caps[12])))))
    }
    .Ok(node(SqlNode.Ex(l)))
}

/// One function-call argument: the bare `*` (`COUNT(*)`) delivers as
/// a `.Terminal` (a literal match), never `.Node` — `or_expr`'s own
/// build always is one — so the two arms tell apart by SHAPE, the
/// same idiom `atom` itself uses one level up.
@grammar_rule("\"*\" | e:or_expr")
fn call_arg(caps: List<Captured<LexToken, SqlNode>>) -> Result<Captured<LexToken, SqlNode>, string> {
    match caps[0] {
        .Terminal(_) -> .Ok(node(SqlNode.Ex(SqlExpr.Star))),
        .Node(_) or .Many(_) or .Absent -> {
            let e? = ex_of(caps[0]) else { return .Err("call arg: did not build") }
            .Ok(node(SqlNode.Ex(e)))
        },
    }
}

@grammar_rule("a:call_arg (\",\" a:call_arg)*")
fn call_args(caps: List<Captured<LexToken, SqlNode>>) -> Result<Captured<LexToken, SqlNode>, string> {
    .Ok(node(SqlNode.ExList(exprs_of(caps[0])?)))
}

/// A window function's own frame — both halves optional, neither
/// directly labeled at this level (each is its own parenthesized
/// group), so `pb` and `ob` land in the order their groups appear:
/// `caps[0]`, `caps[1]`.
@grammar_rule("\"OVER\" \"(\" (\"PARTITION\" \"BY\" pb:expr_list)? (\"ORDER\" \"BY\" ob:order_item (\",\" ob:order_item)*)? \")\"")
fn over_clause(caps: List<Captured<LexToken, SqlNode>>) -> Result<
    Captured<LexToken, SqlNode>,
    string,
> {
    .Ok(
        node(
            SqlNode
                .Over(
                    OverClause {
                        partition_by: ex_list_of(caps[0]),
                        order_by: ord_items_of(caps[1])?,
                    },
                ),
        ),
    )
}

@grammar_rule("\"WHEN\" w:or_expr \"THEN\" t:or_expr")
fn when_clause(caps: List<Captured<LexToken, SqlNode>>) -> Result<
    Captured<LexToken, SqlNode>,
    string,
> {
    let w? = ex_of(caps[0]) else { return .Err("when: condition did not build") }
    let t? = ex_of(caps[1]) else { return .Err("when: result did not build") }
    .Ok(node(SqlNode.When(WhenClause { cond: w, result: t })))
}

/// An IDENT-headed atom is a bare column (`title`), a qualified one
/// (`p.title`), or a call (`COUNT(*)`) — all three share `IDENT` as
/// their first token, so they cannot be separate `|` branches (the
/// engine's first-set check correctly refuses that: a call and a bare
/// name both starting with IDENT, one of them committing, makes the
/// other unreachable — probed and confirmed, not assumed). Two
/// INDEPENDENT optional suffixes after one shared `n:IDENT` sidesteps
/// it: `.` and `(` are different first tokens, so neither suffix
/// competes with the other or with `n` itself.
///
/// `CASE` leads the alternation, ahead of `n:IDENT` — both share
/// `IDENT` as their lexer-level first token (a keyword is just an
/// ordinary IDENT-shaped literal here), and `n:IDENT`'s own branch
/// has exactly one required item, which this engine's first-set
/// checker treats as committing: an earlier committing branch
/// swallows every later one sharing its first token. A literal match
/// carries no such hazard in the other direction (it fails outright
/// and cleanly falls through), so ordering `"CASE"` first is what
/// makes this safe, not the (silent, unrelated) absence of a
/// checker diagnostic — confirmed by reading `first.av`'s own
/// `subsuming_term`, which only recognizes the compiler's own
/// `NAME`/`NUMBER` terminal names and is blind to this grammar's
/// `IDENT`, not by trusting that silence.
///
/// The searched form (`CASE WHEN … THEN … END`, no operand) and the
/// simple form (`CASE x WHEN … THEN … END`) are TWO branches, not one
/// with an optional operand — an optional `op:or_expr?` would greedily
/// match the searched form's own `WHEN` as a bare column (nothing
/// distinguishes a keyword from an identifier at this lexer's level,
/// same reason `TableRef`'s bare alias is unsupported), and a
/// successfully-matched optional never backtracks just because a
/// later required item then fails. Ordering the searched form FIRST
/// works with no lookahead: its own first required item after `CASE`
/// is `(w:when_clause)+`, whose own first required token is the
/// literal `WHEN` — on the simple form's input that fails outright,
/// atomically, with nothing consumed (nothing optional sits before it
/// to have greedily eaten anything), so the engine falls straight
/// through to the simple-form branch. Confirmed empirically: the
/// naive one-branch form silently broke the searched case with
/// "unexpected input after `select_stmt`" before this split.
///
/// `p`/`ex` each delegate to a rule that fully builds its own
/// `Ex(...)` before atom ever sees it — `paren_expr`, `exists_expr`
/// — rather than inlining their bodies here as bare items. Inlining
/// would give every one of them the SAME arity problem CASE's operand
/// did: several branches all reducing to one label apiece are
/// indistinguishable by `caps.length` alone (all answer 1).
/// Delegating sidesteps it entirely — whichever of these two fires,
/// atom sees exactly one `.Node(SqlNode.Ex(...))` already built, so
/// telling THEM apart is unnecessary; only telling a built node apart
/// from a bare terminal (NUMBER/STRING/HOLE) is. `ex` leads `n:IDENT`
/// for the same reason `"CASE"` does — `EXISTS` is exactly as
/// IDENT-shaped as any other identifier here.
@grammar_rule("p:paren_expr | ex:exists_expr | \"CASE\" (w:when_clause)+ (\"ELSE\" e:or_expr)? \"END\" | \"CASE\" op:or_expr (w:when_clause)+ (\"ELSE\" e:or_expr)? \"END\" | n:IDENT (\".\" m:IDENT)? (lp:\"(\" args:call_args? \")\")? (ov:over_clause)? | NUMBER | STRING | HOLE")
fn atom(caps: List<Captured<LexToken, SqlNode>>) -> Result<Captured<LexToken, SqlNode>, string> {
    if caps.length == 2 {
        let whens = when_items_of(caps[0])?
        let else_branch = ex_of(caps[1])
        return .Ok(node(SqlNode.Ex(SqlExpr.Case(null, whens, else_branch))))
    }
    if caps.length == 3 {
        let operand = ex_of(caps[0])
        let whens = when_items_of(caps[1])?
        let else_branch = ex_of(caps[2])
        return .Ok(node(SqlNode.Ex(SqlExpr.Case(operand, whens, else_branch))))
    }
    if caps.length == 5 {
        let name = text_of(caps[0])
        let inner = match caps[2] {
            .Absent -> match caps[1] {
                .Absent -> SqlExpr.Column(null, name),
                .Terminal(_) or .Node(_) or .Many(_) -> SqlExpr.Column(name, text_of(caps[1])),
            },
            .Terminal(_) or .Node(_) or .Many(_) -> SqlExpr.Call(name, node_of(caps[3])?.as_ex_list() ?? []),
        }
        if !present(caps[4]) { return .Ok(node(SqlNode.Ex(inner))) }
        let over? = node_of(caps[4])?.as_over() else { return .Err("window function: OVER clause did not build") }
        return .Ok(node(SqlNode.Ex(SqlExpr.Over(inner, over))))
    }
    let already_built = node_of(caps[0])
    if already_built != null {
        let e? = already_built!.as_ex() else { return .Err("atom: parenthesized form did not build") }
        return .Ok(node(SqlNode.Ex(e)))
    }
    let text = text_of(caps[0])
    match kind_of(caps[0]) {
        "NUMBER" -> .Ok(node(SqlNode.Ex(SqlExpr.Number(text)))),
        "STRING" -> .Ok(node(SqlNode.Ex(SqlExpr.Str(unquote_sql_string(text))))),
        rest -> .Ok(node(SqlNode.Ex(SqlExpr.Hole(hole_name(text))))),
    }
}

/// A scalar subquery, or a plain parenthesized grouping — `select_stmt`
/// and `or_expr` share ONE `"("`, never two competing
/// `"(" select_stmt ")" | "(" or_expr ")"` branches, which the checker
/// correctly refuses (`branches 1 and 2 both begin with "(" — branch 2
/// is unreachable`): both would be single-item, rule-reference
/// branches, and both commit on their shared leading literal, not just
/// the first. `select_stmt` leads inside the ONE shared `"("`, for the
/// same reason `in_source` orders it first: a bare `or_expr` would
/// otherwise read `SELECT` as a column.
///
/// A NESTED alt used as a plain (unrepeated) item inside a larger
/// sequence is NOT the same shape as a whole rule's own top-level
/// alt (`atom`'s, which gives each branch its OWN, possibly different,
/// arity — confirmed by direct probe, `caps.length` 1/2/3/4 depending
/// which of atom's branches fired). Nested this way, the engine
/// reserves ONE FIXED SLOT PER DISTINCT LABEL across every branch
/// (`s` at 0, `e` at 1, always both, only the one that matched ever
/// non-Absent) — so `caps[0]` is not "whichever fired," and reading it
/// as such silently misread `(a = 1)` as an unbuilt subquery. `present`
/// on each slot is the correct — and, for this shape, only — way to
/// tell which one fired, the same marker idiom `atom`'s own `lp`/`isk`/
/// `ink` already use for a different reason (there, an optional
/// payload that can't tell "matched empty" from "didn't match"; here,
/// a nested alt's fixed-but-sparse slots).
@grammar_rule("\"(\" (s:select_stmt | e:or_expr) \")\"")
fn paren_expr(caps: List<Captured<LexToken, SqlNode>>) -> Result<
    Captured<LexToken, SqlNode>,
    string,
> {
    if present(caps[0]) {
        let s? = node_of(caps[0])?.as_select() else { return .Err("subquery: did not build") }
        return .Ok(node(SqlNode.Ex(SqlExpr.Subquery(s))))
    }
    let e? = ex_of(caps[1]) else { return .Err("paren: grouped expression did not build") }
    .Ok(node(SqlNode.Ex(e)))
}

/// `NOT EXISTS (...)` needs no case of its own — `not_expr`'s own
/// leading `NOT` already wraps any `cmp_expr`, and `EXISTS (...)` is
/// an ordinary atom to it, same as a bare column would be.
@grammar_rule("\"EXISTS\" \"(\" s:select_stmt \")\"")
fn exists_expr(caps: List<Captured<LexToken, SqlNode>>) -> Result<
    Captured<LexToken, SqlNode>,
    string,
> {
    let s? = node_of(caps[0])?.as_select() else { return .Err("exists: subquery did not build") }
    .Ok(node(SqlNode.Ex(SqlExpr.Exists(s))))
}

/// A bare comma-separated expression list — `GROUP BY`'s own columns,
/// and the `IN (...)` predicate's own set.
@grammar_rule("e:or_expr (\",\" e:or_expr)*")
fn expr_list(caps: List<Captured<LexToken, SqlNode>>) -> Result<Captured<LexToken, SqlNode>, string> {
    .Ok(node(SqlNode.ExList(exprs_of(caps[0])?)))
}

/// `IN`'s own right side — `select_stmt` leads, ahead of `expr_list`,
/// for the same reason `atom`'s parenthesized branches order a
/// subquery first: `expr_list`'s own underlying `atom` would
/// otherwise swallow a bare `SELECT` token as a column.
@grammar_rule("s:select_stmt | e:expr_list")
fn in_source(caps: List<Captured<LexToken, SqlNode>>) -> Result<Captured<LexToken, SqlNode>, string> {
    .Ok(caps[0])
}

@grammar_rule("\"GROUP\" \"BY\" e:expr_list")
fn group_by_clause(caps: List<Captured<LexToken, SqlNode>>) -> Result<
    Captured<LexToken, SqlNode>,
    string,
> {
    .Ok(caps[0])
}

@grammar_rule("\"HAVING\" e:or_expr")
fn having_clause(caps: List<Captured<LexToken, SqlNode>>) -> Result<
    Captured<LexToken, SqlNode>,
    string,
> {
    .Ok(caps[0])
}

/// One `WITH` binding — `name AS (subquery)`.
@grammar_rule("n:IDENT \"AS\" \"(\" s:select_stmt \")\"")
fn cte_def(caps: List<Captured<LexToken, SqlNode>>) -> Result<Captured<LexToken, SqlNode>, string> {
    let name = text_of(caps[0])
    let sub? = node_of(caps[1])?.as_select() else { return .Err("cte: subquery did not build") }
    .Ok(node(SqlNode.Cte(CteDef { name: name, query: sub })))
}

/// The leading `(\"WITH\" ...)? ` group is NESTED (a parenthesized
/// group, not a direct label), same as the trailing `(\"LIMIT\" ...)?`
/// group already was — so BOTH land after every direct top-level
/// label (`cols`/`f`/`w`/`g`/`h`/`o`, six of them, `caps[0..5]`), in
/// the order their OWN groups appear relative to each other: `c` at
/// `caps[6]`, `lim` at `caps[7]` — pushed one slot later than before
/// this change, `WITH` coming first in the text notwithstanding. Same
/// rule as `not_expr`'s `e`/`n` ordering, applied to a bigger rule;
/// a first attempt assumed `w:where_clause?` and `(\"LIMIT\"...)?`'s
/// own `lim` were equally "direct" and got this backwards — verified,
/// and corrected, by direct probe rather than trusted on inspection.
@grammar_rule("(\"WITH\" c:cte_def (\",\" c:cte_def)*)? \"SELECT\" cols:column_list \"FROM\" f:from_clause w:where_clause? g:group_by_clause? h:having_clause? o:order_by_clause? (\"LIMIT\" lim:NUMBER)?")
fn select_stmt(caps: List<Captured<LexToken, SqlNode>>) -> Result<
    Captured<LexToken, SqlNode>,
    string,
> {
    let cols = cols_of(caps[0])
    let from? = from_of(caps[1]) else { return .Err("select: FROM did not build") }
    let where_ = ex_of(caps[2])
    let group_by = ex_list_of(caps[3])
    let having = ex_of(caps[4])
    let order = order_items_of(caps[5])
    let ctes = cte_items_of(caps[6])?
    let limit = match caps[7] {
        .Absent -> null,
        .Terminal(_) or .Node(_) or .Many(_) -> SqlExpr.Number(text_of(caps[7])),
    }
    .Ok(
        node(
            SqlNode
                .Sel(
                    SqlSelect {
                        ctes: ctes,
                        columns: cols,
                        from: from,
                        where: where_,
                        group_by: group_by,
                        having: having,
                        order_by: order,
                        limit: limit,
                    },
                ),
        ),
    )
}

/// Shared by `insert_stmt`/`update_stmt`/`delete_stmt` — the same
/// expression-with-alias shape a `SELECT` list already builds from.
@grammar_rule("\"RETURNING\" r:column_list")
fn returning_clause(caps: List<Captured<LexToken, SqlNode>>) -> Result<
    Captured<LexToken, SqlNode>,
    string,
> {
    .Ok(caps[0])
}

/// One `VALUES (...)` row — a plain expression list, the same shape
/// a function call's arguments already build from.
@grammar_rule("\"(\" v:expr_list \")\"")
fn values_row(caps: List<Captured<LexToken, SqlNode>>) -> Result<
    Captured<LexToken, SqlNode>,
    string,
> {
    .Ok(caps[0])
}

@grammar_rule("\"INSERT\" \"INTO\" t:IDENT \"(\" c:IDENT (\",\" c:IDENT)* \")\" \"VALUES\" r:values_row (\",\" r:values_row)* (ret:returning_clause)?")
fn insert_stmt(caps: List<Captured<LexToken, SqlNode>>) -> Result<
    Captured<LexToken, SqlNode>,
    string,
> {
    let table_name = text_of(caps[0])
    let columns = names_of(caps[1])?
    let rows = rows_of(caps[2])?
    .Ok(
        node(
            SqlNode
                .Ins(
                    InsertStmt {
                        table_name: table_name,
                        columns: columns,
                        rows: rows,
                        returning: returning_of(caps[3]),
                    },
                ),
        ),
    )
}

@grammar_rule("n:IDENT \"=\" v:or_expr")
fn assignment(caps: List<Captured<LexToken, SqlNode>>) -> Result<
    Captured<LexToken, SqlNode>,
    string,
> {
    let name = text_of(caps[0])
    let v? = ex_of(caps[1]) else { return .Err("assignment: value did not build") }
    .Ok(node(SqlNode.Assign(Assignment { column: name, value: v })))
}

@grammar_rule("\"UPDATE\" t:IDENT \"SET\" a:assignment (\",\" a:assignment)* w:where_clause? (ret:returning_clause)?")
fn update_stmt(caps: List<Captured<LexToken, SqlNode>>) -> Result<
    Captured<LexToken, SqlNode>,
    string,
> {
    let table_name = text_of(caps[0])
    let assignments = assignments_of(caps[1])?
    .Ok(
        node(
            SqlNode
                .Upd(
                    UpdateStmt {
                        table_name: table_name,
                        assignments: assignments,
                        where: ex_of(caps[2]),
                        returning: returning_of(caps[3]),
                    },
                ),
        ),
    )
}

@grammar_rule("\"DELETE\" \"FROM\" t:IDENT w:where_clause? (ret:returning_clause)?")
fn delete_stmt(caps: List<Captured<LexToken, SqlNode>>) -> Result<
    Captured<LexToken, SqlNode>,
    string,
> {
    let table_name = text_of(caps[0])
    .Ok(
        node(
            SqlNode
                .Del(
                    DeleteStmt {
                        table_name: table_name,
                        where: ex_of(caps[1]),
                        returning: returning_of(caps[2]),
                    },
                ),
        ),
    )
}

/// The one entry point — `SELECT`/`INSERT`/`UPDATE`/`DELETE` each
/// lead with a distinct keyword, so no first-set overlap among them.
@grammar_rule("s:select_stmt | s:insert_stmt | s:update_stmt | s:delete_stmt")
fn stmt(caps: List<Captured<LexToken, SqlNode>>) -> Result<Captured<LexToken, SqlNode>, string> {
    .Ok(caps[0])
}

type RuleSource = {
    name: string,
    mark: Annotation,
    handler: fn(List<Captured<LexToken, SqlNode>>) -> Result<Captured<LexToken, SqlNode>, string>,
}

collect sql_sources: List<RuleSource> = @grammar_rule in self as RuleSource { name: it.name, mark: it.mark, handler: it } by it.name

impl RuleSource {
    /// This source's rule, its body's build directives synthesized
    /// from its own captured labels.
    fn built() -> Rule {
        let parsed = parse_grammar_text(self.name, self.mark.args[0]).built!
        let r = parsed.rules[0]
        r with { body: r.body.synthesized_build(self.name) }
    }
}

/// The assembled parser grammar — one rule per `@grammar_rule`d
/// function in this file, no hand-written `Grammar` literal.
export fn sql_parser_grammar() -> Grammar {
    Grammar { name: "sql_parser", start: "stmt", rules: [s.built() for s in sql_sources] }
}

fn dispatch(name: string, caps: List<Captured<LexToken, SqlNode>>, _at: Loc?) -> Result<
    Captured<LexToken, SqlNode>,
    string,
> {
    let found? = sql_sources.find(it.name == name) else { return .Err("no rule named ${name}") }
    found.handler(caps)
}

fn sql_lexeme() -> Lexeme<LexToken> {
    Lexeme {
        lit_matches: (t: LexToken, text: string) -> t.text == text,
        is_eof: (t: LexToken) -> t.kind == "EOF",
        ends_statement: (t: LexToken) -> false,
        wears: (t: LexToken, term: string) -> t.kind == term,
        text: (t: LexToken) -> t.text,
        loc: (t: LexToken) -> t.loc,
        stated: (text: string, loc: Loc?) -> LexToken {
            kind: "STATED",
            text: text,
            loc: loc ?? Loc { file: null, lo: 0, hi: 0 },
        },
    }
}

/// The parser grammar prepared once, at compile time — every parse
/// reads it, none rebuilds it.
const SQL_PARSER: Ready = ready(sql_parser_grammar(), ["IDENT", "NUMBER", "STRING", "QUOTED_IDENT", "HOLE"])

export fn parse_sql(source: string) -> RunOutcome<LexToken, SqlNode> {
    let tokens = lex(SQL, source, ["WS", "LINE_COMMENT", "BLOCK_COMMENT"]).tokens
    run_grammar<LexToken, SqlNode>(SQL_PARSER, tokens, sql_lexeme(), dispatch)
}
