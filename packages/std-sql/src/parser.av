//! SQL's PARSER grammar, assembled from its own builder functions —
//! each rule's text lives on `@grammar_rule`, right beside the
//! function that builds it, nothing spelled twice. See
//! `@std/grammar`'s `collected.av` for the mechanism this reuses.

use @std.grammar.{grammar_rule, Grammar, Rule, Captured, parse_grammar_text, run_grammar, ready, RunOutcome, LexToken, Lexeme, lex, want}
use lexicon.{SQL}
use @std.meta.{Annotation}
use @std.errors.{Loc}

export enum SqlExpr {
    Ident(name: string)
    Number(text: string)
    Str(text: string)
    Hole(name: string)
    Not(e: SqlExpr)
    BinOp(op: string, lhs: SqlExpr, rhs: SqlExpr)
}

export type SqlSelect = { columns: List<string>, from_table: string, where: SqlExpr? }

/// The one node type every rule in this file builds into — the
/// engine is monomorphic over it, so one wrapper spans every rule's
/// own answer shape, the same way the compiler's own DSL parser has
/// one `GrammarNode` for its whole grammar.
export enum SqlNode { Cols(names: List<string>), Ex(e: SqlExpr), Sel(s: SqlSelect) }

fn text_of(c: Captured<LexToken, SqlNode>) -> string {
    match c {
        .Terminal(t) -> t.text,
        .Node(_) or .Many(_) or .Absent -> "",
    }
}

/// The captured token's own KIND (`IDENT`/`NUMBER`/`STRING`/`HOLE`) —
/// `atom` reads this to decide which `SqlExpr` variant a bare
/// terminal becomes.
fn kind_of(c: Captured<LexToken, SqlNode>) -> string {
    match c {
        .Terminal(t) -> t.kind,
        .Node(_) or .Many(_) or .Absent -> "",
    }
}

/// A `STRING` token's raw text still carries its surrounding quotes
/// and SQL's own escape (a doubled quote, `''`, for a literal one).
fn unquote_sql_string(text: string) -> string {
    text.substring(1, text.length - 1).replace("''", "'")
}

/// A `HOLE` token's raw text is `${name}` — the parameter's bare name.
fn hole_name(text: string) -> string {
    text.substring(2, text.length - 1)
}

fn node_of(c: Captured<LexToken, SqlNode>) -> SqlNode? {
    match c {
        .Node(n) -> n,
        _ -> null,
    }
}

impl SqlNode {
    fn as_ex() -> SqlExpr? { match self { .Ex(e) -> e, _ -> null } }
    fn as_cols() -> List<string>? { match self { .Cols(names) -> names, _ -> null } }
}

fn ex_of(c: Captured<LexToken, SqlNode>) -> SqlExpr? {
    node_of(c)?.as_ex()
}

fn cols_of(c: Captured<LexToken, SqlNode>) -> List<string> {
    match c {
        .Many(items) -> [text_of(i) for i in items],
        _ -> node_of(c)?.as_cols() ?? [],
    }
}

/// A repeated operand capture (`(\"AND\" r:not_expr)*`'s accumulated
/// `r`), each already built into its own `SqlExpr`.
fn exprs_of(c: Captured<LexToken, SqlNode>) -> Result<List<SqlExpr>, string> {
    match c {
        .Many(items) -> .Ok([want(ex_of(i), "an operand")? for i in items]),
        .Absent -> .Ok([]),
        .Terminal(_) or .Node(_) -> .Err("expected a list of operands"),
    }
}

fn node(n: SqlNode) -> Captured<LexToken, SqlNode> { Captured.Node(n) }

@grammar_rule("c:IDENT (\",\" c:IDENT)*")
fn column_list(caps: List<Captured<LexToken, SqlNode>>) -> Result<Captured<LexToken, SqlNode>, string> {
    .Ok(node(SqlNode.Cols(cols_of(caps[0]))))
}

@grammar_rule("\"WHERE\" e:or_expr")
fn where_clause(caps: List<Captured<LexToken, SqlNode>>) -> Result<Captured<LexToken, SqlNode>, string> {
    .Ok(caps[0])
}

/// Lowest precedence: `a AND b OR c AND d` groups as `(a AND b) OR (c
/// AND d)` — left-associative, folded from the repeated tail.
@grammar_rule("l:and_expr (\"OR\" r:and_expr)*")
fn or_expr(caps: List<Captured<LexToken, SqlNode>>) -> Result<Captured<LexToken, SqlNode>, string> {
    let l? = ex_of(caps[0]) else { return .Err("or: left operand did not build") }
    let rest = exprs_of(caps[1])?
    mut acc = l
    for r in rest { acc = SqlExpr.BinOp("OR", acc, r) }
    .Ok(node(SqlNode.Ex(acc)))
}

@grammar_rule("l:not_expr (\"AND\" r:not_expr)*")
fn and_expr(caps: List<Captured<LexToken, SqlNode>>) -> Result<Captured<LexToken, SqlNode>, string> {
    let l? = ex_of(caps[0]) else { return .Err("and: left operand did not build") }
    let rest = exprs_of(caps[1])?
    mut acc = l
    for r in rest { acc = SqlExpr.BinOp("AND", acc, r) }
    .Ok(node(SqlNode.Ex(acc)))
}

/// `NOT` binds tighter than `AND`/`OR`, looser than a comparison.
/// Labels bind in `deep_items` order — the OUTER sequence's own items
/// first, a nested group's after — so `e` (the outer item) is
/// `caps[0]` and `n` (nested inside the optional group) is `caps[1]`,
/// not source order (confirmed by direct probe, not assumed).
@grammar_rule("(n:\"NOT\")? e:cmp_expr")
fn not_expr(caps: List<Captured<LexToken, SqlNode>>) -> Result<Captured<LexToken, SqlNode>, string> {
    let e? = ex_of(caps[0]) else { return .Err("not: operand did not build") }
    match caps[1] {
        .Absent -> .Ok(node(SqlNode.Ex(e))),
        _ -> .Ok(node(SqlNode.Ex(SqlExpr.Not(e)))),
    }
}

@grammar_rule("l:atom (op:(\"=\"|\"<\"|\">\"|\"<=\"|\">=\"|\"<>\"|\"!=\") r:atom)?")
fn cmp_expr(caps: List<Captured<LexToken, SqlNode>>) -> Result<Captured<LexToken, SqlNode>, string> {
    let l? = ex_of(caps[0]) else { return .Err("expr: left side did not build") }
    let op = text_of(caps[1])
    if op.is_empty() { return .Ok(node(SqlNode.Ex(l))) }
    let r? = ex_of(caps[2]) else { return .Err("expr: right side did not build") }
    .Ok(node(SqlNode.Ex(SqlExpr.BinOp(op, l, r))))
}

@grammar_rule("IDENT|NUMBER|STRING|HOLE")
fn atom(caps: List<Captured<LexToken, SqlNode>>) -> Result<Captured<LexToken, SqlNode>, string> {
    let text = text_of(caps[0])
    match kind_of(caps[0]) {
        "NUMBER" -> .Ok(node(SqlNode.Ex(SqlExpr.Number(text)))),
        "STRING" -> .Ok(node(SqlNode.Ex(SqlExpr.Str(unquote_sql_string(text))))),
        "HOLE" -> .Ok(node(SqlNode.Ex(SqlExpr.Hole(hole_name(text))))),
        _ -> .Ok(node(SqlNode.Ex(SqlExpr.Ident(text)))),
    }
}

@grammar_rule("\"SELECT\" cols:column_list \"FROM\" t:IDENT w:where_clause?")
fn select_stmt(caps: List<Captured<LexToken, SqlNode>>) -> Result<Captured<LexToken, SqlNode>, string> {
    let where_ = ex_of(caps[2])
    .Ok(node(SqlNode.Sel(SqlSelect { columns: cols_of(caps[0]), from_table: text_of(caps[1]), where: where_ })))
}

type RuleSource = {
    name: string,
    mark: Annotation,
    handler: fn(List<Captured<LexToken, SqlNode>>) -> Result<Captured<LexToken, SqlNode>, string>,
}

collect sql_sources: List<RuleSource> = @grammar_rule in self as RuleSource { name: it.name, mark: it.mark, handler: it } by it.name

impl RuleSource {
    /// This source's rule, its body's build directives synthesized
    /// from its own captured labels.
    fn built() -> Rule {
        let parsed = parse_grammar_text(self.name, self.mark.args[0]).built!
        let r = parsed.rules[0]
        r with { body: r.body.synthesized_build(self.name) }
    }
}

/// The assembled parser grammar — one rule per `@grammar_rule`d
/// function in this file, no hand-written `Grammar` literal.
export fn sql_parser_grammar() -> Grammar {
    Grammar { name: "sql_parser", start: "select_stmt", rules: [s.built() for s in sql_sources] }
}

fn dispatch(name: string, caps: List<Captured<LexToken, SqlNode>>, _at: Loc?) -> Result<Captured<LexToken, SqlNode>, string> {
    let found? = sql_sources.find(it.name == name) else { return .Err("no rule named ${name}") }
    found.handler(caps)
}

fn sql_lexeme() -> Lexeme<LexToken> {
    Lexeme {
        lit_matches: (t: LexToken, text: string) -> t.text == text,
        is_eof: (t: LexToken) -> t.kind == "EOF",
        ends_statement: (t: LexToken) -> false,
        wears: (t: LexToken, term: string) -> t.kind == term,
        text: (t: LexToken) -> t.text,
        loc: (t: LexToken) -> t.loc,
        stated: (text: string, loc: Loc?) -> LexToken { kind: "STATED", text: text, loc: loc ?? Loc { file: null, lo: 0, hi: 0 } },
    }
}

const SQL_KNOWN_TERMINALS: List<string> = ["IDENT", "NUMBER", "STRING", "QUOTED_IDENT", "HOLE"]

export fn parse_sql(source: string) -> RunOutcome<LexToken, SqlNode> {
    let tokens = lex(SQL, source, ["WS", "LINE_COMMENT", "BLOCK_COMMENT"]).tokens
    run_grammar<LexToken, SqlNode>(ready(sql_parser_grammar(), SQL_KNOWN_TERMINALS), tokens, sql_lexeme(), dispatch)
}
