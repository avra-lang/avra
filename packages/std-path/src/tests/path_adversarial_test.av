// The red team's record for @std/path: the empty path, the root, doubled
// and trailing slashes, names that are only dots, and relating paths
// that share nothing or everything.
use @std.path.{dir_of, file_name, stem_of, extension_of, with_extension, under_dir, joined_path, normalized, relative_path, segments}

spec "std/path — adversarial" {
    given "the empty path and the root" {
        then "the empty path has no directory, no name, no stem, no extension" {
            dir_of("") == "" && file_name("") == "" && stem_of("") == "" && extension_of("") == ""
        }
        then "the root's directory is nothing and its name is nothing" {
            dir_of("/") == "" && file_name("/") == "" && normalized("/") == "/"
        }
        then "normalizing the empty path is the empty path; a lone dot is empty too" {
            normalized("") == "" && normalized(".") == "" && normalized("./") == ""
        }
        then "segments of slashes alone are none" { segments("///").length == 0 }
    }
    given "slashes doubled and trailing" {
        then "a trailing slash names an empty file" { file_name("a/") == "" && stem_of("a/") == "" && dir_of("a/") == "a" }
        then "doubled slashes fold under normalized, and stand as written elsewhere" {
            normalized("a//b") == "a/b" && dir_of("a//b") == "a/" && joined_path("a/", "b") == "a//b"
        }
        then "under_dir with a trailing slash on the directory asks for two slashes" {
            !under_dir("a/b", "a/") && under_dir("a//b", "a/")
        }
    }
    given "names that are only dots" {
        then "a lone dot or two are names without extensions" {
            stem_of(".") == "." && extension_of(".") == "" && stem_of("..") == "." && extension_of("..") == ""
        }
        then "a name ending in a dot has an empty extension and keeps its stem" {
            stem_of("a.") == "a" && extension_of("a.") == "" && with_extension("a.", "x") == "a.x"
        }
        then "with_extension on a dotfile appends" { with_extension(".env", "bak") == ".env.bak" }
    }
    given "relating at the edges" {
        then "from the empty directory, the path is itself" { relative_path("", "a/b") == "a/b" }
        then "to the empty path, only the climb remains" { relative_path("a/b", "") == "../.." }
        then "absolute and relative relate by their segments alone" { relative_path("/a/b", "a/c") == "../c" }
        then "a path relates to its own parent as one climb" { relative_path("a/b", "a") == ".." }
    }
}
