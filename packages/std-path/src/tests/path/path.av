// proves: @std/path end to end, evaluated and native alike — the cuts,
// a join, containment, folding and one path relative to another.
use @std.path.{dir_of, file_name, stem_of, extension_of, with_extension, under_dir, joined_path, normalized, relative_path}

let p = "packages/std-path/src/path.av"
println("${dir_of(p)} | ${file_name(p)} | ${stem_of(p)} | ${extension_of(p)}")
println(with_extension(p, "ll"))
println("${under_dir(p, "packages")} ${under_dir("packages", "packages")}")
println(normalized("a/./b/../c//d"))
println(relative_path("packages/std-path", "packages/std-io/src"))
joined_path("", "alone")
