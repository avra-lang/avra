// proves: content coding as a layer, evaluated and native alike — the
// coding a client weighs highest, a page read back, a posted gzip body
// decoded_x, and a bomb refused at its ceiling.
use @std.http.frame.{framed, limits}
use @std.http.body.{whole}
use @std.http.http.{Request, Unrouted, Response, text}
use @std.http_compress.{compressed}
use @std.compress.{Format, encoded, decoded_x}
use @std.text.{repeat}

fn asked(fields: string, body: Bytes) -> Request<Unrouted> {
    let raw = "POST /x HTTP/1.1\r\nHost: h\r\n${fields}\r\n".bytes()
    let head = match framed(raw, 0, 0, limits()) {
        .Complete(h) -> h,
        .Partial or .Refused(_) -> null,
    }
    Request { raw: raw, head: head!, body: whole(body), peer: "t", params: Unrouted {} }
}

let page = repeat("a page of text, ", 200)
for ae in ["br", "gzip;q=0.9, deflate", "deflate", "identity"] {
    let r = compressed(asked("Accept-Encoding: ${ae}\r\n", "".bytes()), (_q) -> text(200, page))
    println(
        "${ae} -> ${r.header("content-encoding") ?? "none"} ${r.body.length < page.length} ${r.header("vary") ?? "-"}",
    )
}
let r = compressed(asked("Accept-Encoding: br\r\n", "".bytes()), (_q) -> text(200, page))
println("${(decoded_x(r.body, Format.Brotli, 100000) catch "".bytes()).text() == page}")
let posted = compressed(
    asked("Content-Encoding: gzip\r\n", encoded("posted".bytes(), Format.Gzip) catch "".bytes()),
    (q) -> text(200, q.body.text() ?? "?"),
)
println("${posted.status} ${posted.body.text() ?? "?"}")
mut zeros = "0".bytes()
for _i in 0..21 {
    zeros = zeros.concat(zeros)
}
let bomb = compressed(
    asked("Content-Encoding: br\r\n", encoded(zeros, Format.Brotli) catch "".bytes()),
    (_q) -> text(200, "reached"),
)
"${bomb.status} ${bomb.body.text() ?? "?"}"
