// ASCII case: `A`-`Z` fold and nothing else does — the letters beside
// them, the digits, a NUL, and the bytes of a non-ASCII letter.
use @std.text.{ascii_lower, ascii_lowered, ascii_folded, from_codepoints}

spec "@std.text ASCII case" {
    given "a fold" {
        then "the empty text stays empty" { ascii_lower("") == "" }
        then "capitals fold" { ascii_lower("Set-Cookie") == "set-cookie" }
        then "the neighbours of the capitals stay" { ascii_lower("@[`{") == "@[`{" }
        then "a non-ASCII capital stays" { ascii_lower("É") == "É" }
        then "a NUL stays and is counted" { ascii_lower(from_codepoints([65, 0, 66])).length == 3 }
        then "octets fold as text does" { ascii_lowered("AbC".bytes()).text() == "abc" }
        then "one octet folds" { ascii_folded(90) == 122 && ascii_folded(91) == 91 && ascii_folded(64) == 64 }
    }
}
