// proves: @std/text end to end, evaluated and native alike — a builder
// joining runs, a table padded in code points, rows split and set in,
// and the UTF-8 walk decoding two, three and four byte characters.
use @std.text.{builder, repeat, pad_right, pad_left, lines, indent, codepoints, chars, codepoint_count}

let t = builder()
for w in ["one", " ", "two", " ", "three"] { t.push(w) }
println(t.built())
println("[${pad_right("é", 3)}|${pad_left("7", 3)}|${repeat("-", 5)}]")
println(indent(lines("a\nb\n").join("\n"), 2))
println(["${c}" for c in codepoints("aé日😀")].join(","))
println(chars("aé日😀").join("|"))
println(["${c}" for c in codepoints("日".substring(1, 3))].join(","))
"${codepoint_count("aé日😀")} ${"aé日😀".length}"
