// Text built and shaped, vertically: the builder joins what it was
// given, shaping measures in code points, rows split honestly, and
// the walk reads every UTF-8 width.
use @std.text.{
    Text,
    builder,
    repeat,
    pad_left,
    pad_right,
    lines,
    indent,
    is_blank,
    codepoints,
    chars,
    codepoint_count,
    from_codepoint,
    from_codepoints,
    nul_at,
    has_nul,
    with_room,
}

/// A text's code points as decimal words.
/// "AB", a NUL, then "CD" — five bytes C reads as two.
fn holed() -> string {
    from_codepoints([65, 66, 0, 67, 68])
}

fn codes(s: string) -> string {
    ["${c}" for c in codepoints(s)].join(",")
}

fn built_from(pieces: List<string>) -> string {
    mut t = builder()
    // LICENSED loops.push_loop: the builder's push IS the subject under test
    for p in pieces { t.push(p) }
    t.built()
}

spec "std/text" {
    given "the builder" {
        then "pieces join in order" { built_from(["a", "bc", "", "d"]) == "abcd" }
        then "nothing pushed is empty text" { built_from([]) == "" }
        then "a thousand pieces build what a thousand concatenations would" {
            mut t = builder()
            mut i = 0
            while i < 1000 {
                t.push("x")
                i = i + 1
            }
            t.built().length == 1000
        }
    }
    given "shaping" {
        then "repeat writes n times, and nothing for zero or less" {
            repeat("ab", 3) == "ababab" &&
                repeat("ab", 0) == "" &&
                repeat("ab", 0 - 2) == "" &&
                repeat("", 5) == ""
        }
        then "pad_right fills to the width and leaves a wider text alone" {
            pad_right("ab", 4) == "ab  " &&
                pad_right("abcd", 4) == "abcd" &&
                pad_right("abcde", 4) == "abcde"
        }
        then "pad_left fills before" { pad_left("7", 3) == "  7" }
        then "width is code points, not bytes — an accent takes one column" {
            pad_right("é", 3) == "é  " && pad_left("日本", 4) == "  日本"
        }
    }
    given "rows" {
        then "lines split at newlines; a closing newline opens no empty row" {
            lines("a\nb\n").join("|") == "a|b" && lines("a\nb").join("|") == "a|b"
        }
        then "an empty row inside stays" { lines("a\n\nb").length == 3 }
        then "empty text has no rows" { lines("").length == 0 }
        then "indent sets every row in" { indent("a\nb", 2) == "  a\n  b" }
        then "blank is spaces, tabs and newlines, or nothing" {
            is_blank(" \t\n") && is_blank("") && !is_blank(" x ")
        }
    }
    given "the code-point walk" {
        then "ASCII is one byte per code point" { codes("ab") == "97,98" }
        then "two, three and four byte sequences decode to their values" {
            codes("é") == "233" && codes("日") == "26085" && codes("😀") == "128512"
        }
        then "chars answers each code point as its own text" {
            chars("héllo").join("|") == "h|é|l|l|o" && chars("日本").length == 2
        }
        then "codepoint_count counts characters where length counts bytes" {
            codepoint_count("日本") == 2 && "日本".length == 6 && codepoint_count("") == 0
        }
        then "a mixed text walks in order" { chars("a😀b").join("|") == "a|😀|b" }
        then "from_codepoint writes each width back" {
            from_codepoint(97) == "a" &&
                from_codepoint(233) == "é" &&
                from_codepoint(26085) == "日" &&
                from_codepoint(128512) == "😀"
        }
        then "the walk and its inverse round-trip" { from_codepoints(codepoints("héllo 日本 😀")) == "héllo 日本 😀" }
        then "a code point no sequence carries is the replacement character" {
            from_codepoint(0 - 1) == from_codepoint(65533) &&
                from_codepoint(55296) == from_codepoint(65533) &&
                from_codepoint(1114112) == from_codepoint(65533)
        }
    }
    given "the C boundary" {

        then "nul_at finds the NUL a C reader would stop at" { nul_at(holed()) == 2 }
        then "nul_at is -1 for text a C reader would take whole" { nul_at("plain") == 0 - 1 }
        then "nul_at is -1 for the empty text" { nul_at("") == 0 - 1 }
        then "a leading NUL is position 0 — C sees nothing at all" {
            nul_at(from_codepoints([0, 120])) == 0
        }
        then "has_nul is true for text holding one" { has_nul(holed()) }
        then "has_nul is false for text holding none" { !has_nul("plain") }
        then "has_nul is false for the empty text" { !has_nul("") }
        then "length reads the whole text, past the NUL" { holed().length == 5 }
        then "contains reads past the NUL" { holed().contains("CD") }
        then "== does not read a prefix — holed text is unequal to it" { !(holed() == "AB") }
        then "text beginning with a NUL is two characters long" {
            (from_codepoint(0) + "x").length == 2
        }
        then "text beginning with a NUL does not equal the empty string" {
            !(from_codepoint(0) + "x" == "")
        }
        then "a lone NUL does not equal the empty string" { !(from_codepoint(0) == "") }
        then "a NUL is an ordinary needle — found where it is" {
            holed().contains(from_codepoint(0))
        }
        then "a NUL is an ordinary needle — absent where it is not" {
            !"abc".contains(from_codepoint(0))
        }
    }
    given "a buffer with room" {
        then "it is empty, whatever its room" {
            with_room(0).length == 0 && with_room(4096).length == 0 && with_room(4096) == "".bytes()
        }
        then "what is appended reads back whole, past the room as well as within it" {
            let within = with_room(8).concat("abc".bytes()).concat("de".bytes())
            let past = with_room(2).concat("abc".bytes()).concat("defgh".bytes())
            within == "abcde".bytes() && past == "abcdefgh".bytes()
        }
        then "a mut buffer grown in a loop holds every piece in order" {
            mut out = with_room(64)
            for i in 0..20 { out = out.concat("${i},".bytes()) }
            out.text() ?? "?" == ["${i}," for i in 0..20].join("")
        }
    }
}
