// Text built and shaped, vertically: the builder joins what it was
// given, shaping measures in code points, rows split honestly, and
// the walk reads every UTF-8 width.
use @std.text.{Text, builder, repeat, pad_left, pad_right, lines, indent, is_blank, codepoints, chars, codepoint_count}

/// A text's code points as decimal words.
fn codes(s: string) -> string {
    ["${c}" for c in codepoints(s)].join(",")
}

fn built_from(pieces: List<string>) -> string {
    mut t = builder()
    // LICENSED I3: the builder's push IS the subject under test
    for p in pieces { t.push(p) }
    t.built()
}

spec "std/text" {
    given "the builder" {
        then "pieces join in order" { built_from(["a", "bc", "", "d"]) == "abcd" }
        then "nothing pushed is empty text" { built_from([]) == "" }
        then "a thousand pieces build what a thousand concatenations would" {
            mut t = builder()
            mut i = 0
            while i < 1000 {
                t.push("x")
                i = i + 1
            }
            t.built().length == 1000
        }
    }
    given "shaping" {
        then "repeat writes n times, and nothing for zero or less" {
            repeat("ab", 3) == "ababab" && repeat("ab", 0) == "" && repeat("ab", 0 - 2) == "" && repeat("", 5) == ""
        }
        then "pad_right fills to the width and leaves a wider text alone" {
            pad_right("ab", 4) == "ab  " && pad_right("abcd", 4) == "abcd" && pad_right("abcde", 4) == "abcde"
        }
        then "pad_left fills before" { pad_left("7", 3) == "  7" }
        then "width is code points, not bytes — an accent takes one column" {
            pad_right("é", 3) == "é  " && pad_left("日本", 4) == "  日本"
        }
    }
    given "rows" {
        then "lines split at newlines; a closing newline opens no empty row" {
            lines("a\nb\n").join("|") == "a|b" && lines("a\nb").join("|") == "a|b"
        }
        then "an empty row inside stays" { lines("a\n\nb").length == 3 }
        then "empty text has no rows" { lines("").length == 0 }
        then "indent sets every row in" { indent("a\nb", 2) == "  a\n  b" }
        then "blank is spaces, tabs and newlines, or nothing" {
            is_blank(" \t\n") && is_blank("") && !is_blank(" x ")
        }
    }
    given "the code-point walk" {
        then "ASCII is one byte per code point" { codes("ab") == "97,98" }
        then "two, three and four byte sequences decode to their values" {
            codes("é") == "233" && codes("日") == "26085" && codes("😀") == "128512"
        }
        then "chars answers each code point as its own text" {
            chars("héllo").join("|") == "h|é|l|l|o" && chars("日本").length == 2
        }
        then "codepoint_count counts characters where length counts bytes" {
            codepoint_count("日本") == 2 && "日本".length == 6 && codepoint_count("") == 0
        }
        then "a mixed text walks in order" { chars("a😀b").join("|") == "a|😀|b" }
    }
}
