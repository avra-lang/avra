// proves: parse_float end to end, evaluated and native alike — the
// walk and the read are two externs, so this is where the engines
// are held to one answer for each shape.
use @std.text.{parse_float, from_codepoint, repeat}

fn shown(s: string) -> string {
    let v? = parse_float(s) else { return "absent" }
    "${v}"
}

println(shown(""))
println(shown("0"))
println(shown("-0"))
println(shown("0.1"))
println(shown("-2.25"))
println(shown("1e3"))
println(shown("25E-1"))
println(shown("1.7976931348623157e308"))
println(shown("1e400"))
println(shown("1e-400"))
println(shown("5e-324"))
println(shown("1" + repeat("0", 400) + "e-400"))
println(shown("+1"))
println(shown("inf"))
println(shown("nan"))
println(shown("0x1p3"))
println(shown(".5"))
println(shown("5."))
println(shown("1e+"))
println(shown("1.5" + from_codepoint(0)))
shown("123456789012345678901234567890")
