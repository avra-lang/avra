// proves: core's float roundings link natively with no `[link]` row in the package — the
// math library rides every native link the way libc does.
fn whole(r: Result<int, ToInt>) -> string {
    match r { .Ok(n) -> "${n}", rest -> "out of range" }
}

fn at(x: float) -> string { "${whole(x.round())} ${whole(x.floor())} ${whole(x.ceil())} ${whole(x.trunc())}" }

println(at(2.5))
println(at(-2.5))
println(at(7.25))
