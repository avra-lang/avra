// proves: parse_int end to end, evaluated and native alike — the
// ceiling on both sides one digit either way, the empty case, a
// NUL read past, every malformed shape, and a run long enough to
// wrap an unguarded fold twice over (spec cases are native-only, so
// this program is the only place text_int and avra_int_parse_walk
// are proved to agree).
use @std.text.{parse_int, from_codepoint}

fn shown(s: string) -> string {
    let v? = parse_int(s) else { return "absent" }
    "${v}"
}

fn int_min() -> int { 9223372036854775807 + 1 }

println(shown("0"))
println(shown("-42"))
println(shown("9223372036854775807"))
println(shown("-9223372036854775808"))
println(shown("9223372036854775808"))
println(shown("9223372036854775817"))
println(shown("-9223372036854775809"))
println(shown("-9223372036854775818"))
println(shown(""))
println(shown("-"))
println(shown(" 42"))
println(shown("+42"))
println(shown("1.5"))
println(shown("--42"))
println(shown("4-2"))
println(shown("1" + from_codepoint(0) + "2"))
println(shown(from_codepoint(0) + "12"))
println(shown("9223372036854775807" + from_codepoint(0)))
println(shown("999999999999999999999999999999999999")) // 38 nines
println(shown("333333333333333333333333333333")) // 30 threes
println("${int_min()}")
"${parse_int("-9223372036854775808") == int_min()}"
