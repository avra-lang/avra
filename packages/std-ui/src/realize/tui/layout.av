//! `realize/tui/layout.av` — the shapes the terminal draws a node's own
//! content in, and the steps its spacing tokens take there. One exhaustive
//! match over the primitives decides a node's own lines; where they go is
//! the solver's (`place`), not this file's.
//!
//! A heading reads in upper case (ASCII letters only), underlined `=` at
//! level one and `-` deeper. A card and an open dialog read their title
//! over a dash rule. A gap is None and Xs 0, S and M 1, L and Xl 2 lines
//! down a column, and None 0, Xs and S 1, M 2, L 3, Xl 4 cells along a
//! row; a pad is None 0, Xs 1, S 2, M 4, L 6, Xl 8 cells across and a
//! gap's lines down. A list keeps two cells for its bullet.
use @std.text.{repeat, codepoints, from_codepoints, cells}
use tree.node.{Node, Prim}
use realize.tui.wrap.{wrap, cut, at_least_one, shown}
use realize.tui.said.{Reads, said_of}
use style.tokens.{Size}

/// The cells a field's value is padded to.
const field_cells = 12

/// The cells a list's bullet takes before each child.
const bullet_cells = 2

// ── the box ─────────────────────────────────────────────────────

fn gap_lines(z: Size) -> int {
    match z { .None or .Xs -> 0, .S or .M -> 1, .L or .Xl -> 2 }
}

fn gap_columns(z: Size) -> int {
    match z { .None -> 0, .Xs or .S -> 1, .M -> 2, .L -> 3, .Xl -> 4 }
}

fn pad_columns(z: Size) -> int {
    match z { .None -> 0, .Xs -> 1, .S -> 2, .M -> 4, .L -> 6, .Xl -> 8 }
}

/// The cells a primitive keeps from its children before their lines.
/// Every primitive spelled: a list keeps its bullet's.
fn kept(p: Prim) -> int {
    match p {
        .List -> bullet_cells,
        .Text or .Heading or .Button or .Link or .Image or .Field or .Checkbox or .Row or .Column or .Dialog or .Divider or .Icon or .Surface or .Item or .Card or .Progress or .Alert or .Spinner or .Form or .Switch or .Slider or .Key -> 0,
    }
}

// ── the lines ───────────────────────────────────────────────────

/// The lines a node draws of itself in `w` cells, before any child's: a
/// leaf's content, a card's or dialog's title over its rule, nothing for
/// a node that only holds.
export fn own_lines(n: Node, w: int) -> List<string> { body(n, at_least_one(w)) }

/// The cells of the longest run of a node's own content that cannot be
/// broken across lines: a word of its text, or the whole of anything drawn
/// as one piece. A word wider than the room it is given is cut where it must,
/// but only then: asking for room never asks for less than the word.
export fn unbreakable_cells(n: Node) -> int {
    let said = said_of(n.attrs)
    match n.prim {
        .Text or .Alert or .Spinner or .Heading -> longest_word(n.words()),
        .Card or .Dialog -> longest_word(said.title),
        .Button or .Link or .Image or .Field or .Checkbox or .Row or .Column or .Divider or .Icon or .Surface or .List or .Item or .Progress or .Form or .Switch or .Slider or .Key -> [cells(l) for l in own_lines(n, 1000000)].max() ?? 0,
    }
}

fn longest_word(s: string) -> int { [cells(w) for p in s.split("\n") for w in p.split(" ")].max() ?? 0 }

/// The cells beside the node the keys go to, which hold its `> ` mark.
export const pointer_cells = 2

/// Whether a node is a dialog that is shut: it takes no place and draws
/// nothing, children included.
export fn closed_node(n: Node) -> bool { n.prim is .Dialog && !n.open() }

/// Whether a node's children take part in the layout: a container's do, a
/// leaf's are not drawn. Every primitive spelled.
export fn holds_children(n: Node) -> bool {
    match n.prim {
        .Row or .Column or .Surface or .List or .Item or .Card or .Dialog or .Form -> true,
        .Text or .Heading or .Button or .Link or .Image or .Field or .Checkbox or .Divider or .Icon or .Progress or .Alert or .Spinner or .Switch or .Slider or .Key -> false,
    }
}

/// The cells a node keeps from its children before their lines.
export fn kept_cells(n: Node) -> int { kept(n.prim) }

/// The blank lines a gap puts between a column's children.
export fn gap_rows(z: Size) -> int { gap_lines(z) }

/// The spaces a gap puts between a row's children.
export fn gap_cols(z: Size) -> int { gap_columns(z) }

/// The cells a leading pad indents by.
export fn pad_cols(z: Size) -> int { pad_columns(z) }

fn body(n: Node, w: int) -> List<string> {
    let said = said_of(n.attrs)
    let own = shown(n.words())
    match n.prim {
        .Text or .Alert or .Spinner -> wrap(own, w),
        .Heading -> titled(upper(own), if n.level() <= 1 { "=" } else { "-" }, w),
        .Image -> atom("[${n.prim.word()}: ${said.alt}]", w),
        .Icon -> atom("[${n.prim.word()}: ${said.name}]", w),
        .Link -> atom("${own} (${said.href})", w),
        .Button -> atom("[ ${own} ]", w),
        .Checkbox or .Switch -> atom(if said.checked { "[x] ${own}" } else { "[ ] ${own}" }, w),
        .Field -> atom("${own}: ${said.drawn_value()}${repeat("_", field_cells - cells(said.value))}", w),
        .Slider -> atom("${own}: ${said.amount} (${said.min}..${said.max})", w),
        .Progress -> atom("${own}: ${said.amount}/${said.max}", w),
        .Divider -> [repeat("-", w)],
        .Item -> if said.skipped > 0 { atom("⋮ ${said.skipped} more", w) } else { [] },
        .Row or .Column or .Surface or .Form or .List -> [],
        .Card -> titled(said.title, "-", w),
        .Dialog -> if said.open { titled(own, "-", w) } else { [] },
        .Key -> [],
    }
}

/// A leaf's text as lines, at its own newlines, each cut at the width.
fn atom(s: string, w: int) -> List<string> { [piece for line in s.split("\n") for piece in cut(line, w)] }

/// The title wrapped, over a rule of `mark` as wide as its widest line.
/// An empty title has no lines and no rule.
fn titled(title: string, mark: string, w: int) -> List<string> {
    let ls = wrap(title, w)
    if ls.is_empty() { return [] }
    ls.concat([repeat(mark, [cells(l) for l in ls].max() ?? 0)])
}

/// ASCII upper case; every other code point stays.
fn upper(s: string) -> string {
    from_codepoints([if c >= 97 && c <= 122 { c - 32 } else { c } for c in codepoints(s)])
}
