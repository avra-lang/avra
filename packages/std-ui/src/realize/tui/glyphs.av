//! `realize/tui/glyphs.av` — THE MARKS A STATE IS DRAWN WITH. No state is
//! shown by colour alone: each is a glyph or words in the text itself, so it
//! reads without colour, on a monochrome terminal and to a screen reader.
//! Colour is laid over them, never in their place. The Unicode marks are the
//! default; a locale without UTF-8 draws the ASCII ones.
use env.{Env}
use @std.text.{ascii_lower}

/// The marks the terminal draws states with.
export type Glyphs = {
    ticked: string,
    unticked: string,
    chosen: string,
    unchosen: string,
    invalid: string,
    focus: string,
    busy: string,
    unavailable: string,
}

/// The marks a UTF-8 terminal draws.
export const unicode = Glyphs {
    ticked: "☑",
    unticked: "☐",
    chosen: "◉",
    unchosen: "○",
    invalid: "✗",
    focus: "❯ ",
    busy: "…",
    unavailable: "(unavailable)",
}

/// The marks a terminal without UTF-8 draws.
export const ascii = Glyphs {
    ticked: "[x]",
    unticked: "[ ]",
    chosen: "(*)",
    unchosen: "( )",
    invalid: "x",
    focus: "> ",
    busy: "...",
    unavailable: "(unavailable)",
}

/// The marks a device's terminal draws.
export fn glyphs_for(e: Env) -> Glyphs { if e.utf8 { unicode } else { ascii } }

/// Whether the locale the environment names draws UTF-8: the first of
/// `LC_ALL`, `LC_CTYPE` and `LANG` that is set decides, and a locale named
/// without UTF-8 draws none. No locale named keeps the default.
export fn utf8_named(named: List<string?>) -> bool {
    let locale? = [n ?? "" for n in named if n ?? "" != ""].first() else { return true }
    ascii_lower(locale).contains("utf-8") || ascii_lower(locale).contains("utf8")
}
