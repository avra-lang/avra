// Each primitive's exact lines, the layout containers, and the box
// fields that shape them.
use @std.ui.tree.url.{local}
use @std.ui.tree.node.{Node, Prim}
use @std.ui.realize.tui.tui.{render}
use @std.ui.env.{Env}
use @std.ui.style.box.{Box}
use @std.ui.style.layout.{Layout, Edge, around}
use @std.ui.style.style.{Style}
use @std.ui.style.tokens.{Size}
use @std.ui.realize.tests.support.{
    leaf,
    boxed,
    holding,
    keyed,
    gap,
    pad,
    gap_pad,
    text_node,
    heading_node,
    image_node,
    link_node,
    button_node,
    switch_node,
    field_node,
    card_node,
}

fn drawn(n: Node, width: int) -> string { render(n, Env {}, width) }

fn item(s: string) -> Node { holding(.Item, [text_node(s)]) }

fn pair() -> List<Node> { [text_node("a"), text_node("b")] }

spec "std/ui tui — primitives" {
    given "the leaves" {
        then "a text is its words" { drawn(text_node("hello"), 40) == "hello" }
        then "a level one heading is upper case over an equals rule" { drawn(heading_node("Tasks", 1), 40) == "TASKS\n=====" }
        then "a deeper heading is upper case over a dash rule" { drawn(heading_node("Tasks", 2), 40) == "TASKS\n-----" }
        then "an image is its alt in brackets" { drawn(image_node("a.png", "a cat"), 40) == "[image: a cat]" }
        then "an icon is its name in brackets" { drawn(leaf(.Icon, [.Src(local("x.svg")), .Name("Close")]), 40) == "[icon: Close]" }
        then "a link is its label then its target" { drawn(link_node("docs", "/docs"), 40) == "docs (/docs)" }
        then "a button is its label in spaced brackets" { drawn(button_node("Add"), 40) == "[ Add ]" }
        then "a switch shows whether it is checked" {
            drawn(switch_node("Done", true), 40) == "[x] Done" &&
                drawn(switch_node("Done", false), 40) == "[ ] Done"
        }
        then "a checkbox shows whether it is checked" {
            drawn(leaf(.Checkbox, [.Label("Done"), .Checked(true)]), 40) == "[x] Done" &&
                drawn(leaf(.Checkbox, [.Label("Done")]), 40) == "[ ] Done"
        }
        then "a field pads its value with underscores to twelve" { drawn(field_node("Name", "Ada"), 40) == "Name: Ada_________" }
        then "an empty field is twelve underscores" { drawn(field_node("Name", ""), 40) == "Name: ____________" }
        then "a value past twelve is kept whole" { drawn(field_node("N", "abcdefghijklmn"), 40) == "N: abcdefghijklmn" }
        then "a slider is its label, its amount and its bounds" {
            drawn(leaf(.Slider, [.Label("Vol"), .Amount(4), .Min(1), .Max(9)]), 40) == "Vol: 4 (1..9)"
        }
        then "a progress is its label and its amount over its max" {
            drawn(leaf(.Progress, [.Label("Up"), .Amount(3), .Max(10)]), 40) == "Up: 3/10"
        }
        then "an alert and a spinner are their words" {
            drawn(leaf(.Alert, [.Text("Saved")]), 40) == "Saved" &&
                drawn(leaf(.Spinner, [.Label("Loading")]), 40) == "Loading"
        }
        then "a divider is a dash rule across the width" { drawn(leaf(.Divider, []), 6) == "------" }
    }
    given "the containers" {
        then "a column stacks its children with no gap by default" { drawn(holding(.Column, pair()), 40) == "a\nb" }
        then "a small gap is one blank line and a large one two" {
            drawn(boxed(.Column, gap(.M), pair()), 40) == "a\n\nb" &&
                drawn(boxed(.Column, gap(.L), pair()), 40) == "a\n\n\nb"
        }
        then "an extra-small gap is no blank line" { drawn(boxed(.Column, gap(.Xs), pair()), 40) == "a\nb" }
        then "an empty column renders nothing" { drawn(holding(.Column, []), 40) == "" }
        then "an empty child leaves no extra gap" {
            drawn(
                boxed(.Column, gap(.M), [text_node("a"), holding(.Column, []), text_node("b")]),
                40,
            ) == "a\n\nb"
        }
        then "a surface and a form stack as a column does" {
            drawn(boxed(.Surface, gap(.M), pair()), 40) == "a\n\nb" &&
                drawn(holding(.Form, pair()), 40) == "a\nb"
        }
        then "a row joins its children on one line" {
            drawn(boxed(.Row, gap(.M), [text_node("a"), button_node("go"), text_node("b")]), 40) == "a  [ go ]  b"
        }
        then "a row's gap sizes are none, one, one, three and four spaces" {
            drawn(boxed(.Row, gap(.None), pair()), 40) == "ab" &&
                drawn(boxed(.Row, gap(.Xs), pair()), 40) == "a b" &&
                drawn(boxed(.Row, gap(.S), pair()), 40) == "a b" &&
                drawn(boxed(.Row, gap(.L), pair()), 40) == "a   b" &&
                drawn(boxed(.Row, gap(.Xl), pair()), 40) == "a    b"
        }
        then "a row that overflows continues on the next line" {
            drawn(
                boxed(.Row, gap(.S), [text_node("aaaa"), text_node("bbbb"), text_node("cccc")]),
                10,
            ) == "aaaa bbbb\ncccc"
        }
        then "a multi-line child of a row is stacked" {
            drawn(
                boxed(.Row, gap(.S), [text_node("x"), holding(.Column, pair()), text_node("y")]),
                40,
            ) == "x\na\nb\ny"
        }
        then "a row that names no gap keeps a cell between its children" { drawn(holding(.Row, pair()), 40) == "a b" }
        then "a row that names no gap at all says so: its children touch" {
            drawn(boxed(.Row, gap(.None), pair()), 40) == "ab"
        }
        then "a column whose layout says row joins its children on one line" {
            drawn(boxed(.Column, Layout { direction: .Row, gap: .S }, pair()), 40) == "a b"
        }
        then "a row whose layout says column stacks its children" {
            drawn(boxed(.Row, Layout { direction: .Column }, pair()), 40) == "a\nb"
        }
        then "a card is its title, a dash rule, then its children" {
            drawn(card_node("Inbox", [text_node("one"), text_node("two")]), 40) == "Inbox\n-----\none\ntwo"
        }
        then "an open dialog is its label, a dash rule, then its children" {
            drawn(
                Node {
                    prim: .Dialog,
                    attrs: [.Label("Sure?"), .Open(true)],
                    box: Box {},
                    children: [text_node("in")],
                },
                40,
            ) == "Sure?\n-----\nin"
        }
        then "a closed dialog renders nothing, its children included" {
            drawn(
                    Node {
                        prim: .Dialog,
                        attrs: [.Label("Sure?"), .Open(false)],
                        box: Box {},
                        children: [text_node("in")],
                    },
                    40,
                ) == "" &&
                drawn(
                    holding(
                        .Column,
                        [text_node("a"), holding(.Dialog, [text_node("in")]), text_node("b")],
                    ),
                    40,
                ) == "a\nb"
        }
        then "a list prefixes each item with a bullet" { drawn(holding(.List, [item("one"), item("two")]), 40) == "• one\n• two" }
        then "an item's key never prints" { drawn(keyed(item("one"), "k1"), 40) == "one" }
        then "a list hangs a wrapped item's later lines under its text" {
            drawn(holding(.List, [item("aaa bbb ccc")]), 9) == "• aaa bbb\n  ccc"
        }
    }
    given "the box" {
        then "a leading pad indents every line of the node" { drawn(boxed(.Column, pad(.S), pair()), 40) == "  a\n  b" }
        then "the pad sizes are zero, one, two, four, six and eight spaces" {
            let padded = (z: Size) -> drawn(boxed(.Column, pad(z), [text_node("a")]), 40)
            padded(.None) == "a" &&
                padded(.Xs) == " a" &&
                padded(.S) == "  a" &&
                padded(.M) == "    a" &&
                padded(.L) == "      a" &&
                padded(.Xl) == "        a"
        }
        then "a pad narrows the wrap of what is inside" { drawn(boxed(.Column, pad(.S), [text_node("aaa bbb")]), 7) == "  aaa\n  bbb" }
        then "a blank gap line is never padded" { drawn(boxed(.Column, gap_pad(.M, .S), pair()), 40) == "  a\n\n  b" }
        then "only the leading edge of a pad prints" {
            drawn(boxed(.Column, Layout { pad: around(.S) }, pair()), 40) == "  a\n  b" &&
                drawn(
                    boxed(.Column, Layout { pad: Edge { end: .Xl, top: .Xl, bottom: .Xl } }, pair()),
                    40,
                ) == "a\nb"
        }
        then "fill, radius, color and face print nothing" {
            let dressed = Node {
                prim: .Text,
                attrs: [.Text("hi")],
                box: Box { style: Style { color: .Muted, face: .Mono, fill: .Danger, radius: .L } },
                children: [],
            }
            drawn(dressed, 40) == drawn(text_node("hi"), 40)
        }
    }
    given "nesting" {
        then "a column in a row in a column, each padded" {
            let inner = boxed(.Column, pad(.Xs), [text_node("p"), text_node("q")])
            let row = boxed(.Row, gap_pad(.S, .S), [text_node("x"), text_node("y"), inner])
            drawn(boxed(.Column, gap_pad(.S, .Xs), [text_node("top"), row]), 40) == " top\n\n   x y\n    p\n    q"
        }
    }
}
