// A column of many rows and a deep nest both render to every row and level.
use @std.ui.tree.node.{Node}
use @std.ui.realize.tui.tui.{render}
use @std.ui.env.{Env}
use @std.ui.realize.tests.support.{holding, text_node}

fn nested(depth: int) -> Node {
    if depth == 0 { text_node("core") } else { holding(.Column, [nested(depth - 1)]) }
}

fn lines_in(n: Node) -> int { render(n, Env {}, 40).split("\n").length }

println("rows ${lines_in(holding(.Column, [text_node("row ${i}") for i in 0..3000]))}")
println("deep ${lines_in(nested(300))}")
