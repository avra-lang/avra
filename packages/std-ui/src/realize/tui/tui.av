//! `realize/tui/tui.av` — the terminal target: the same tree as lines of
//! plain text. One complete impl block; each method draws one component
//! through the accumulator. UI.md §19.2.
use realize.realizer.{Realizer}
use components.text.{text}

/// The terminal target: one accumulator of lines.
export type Tui = { lines: Cell<List<string>> = Cell.new([]) }

impl Realizer for Tui {
    fn text(t: text) { self.lines.push(t.content) }
}

/// The finished frame.
export fn frame(t: Tui) -> string { t.lines.get().join("\n") }
