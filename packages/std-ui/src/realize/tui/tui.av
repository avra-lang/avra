//! `realize/tui/tui.av` — the terminal target. The same Node, the same
//! vocabulary, drawn as lines. A second target is a table and a walker,
//! never a component list. UI.md §19.2.
use realize.render.{Node, Prim, Attribute}
use realize.identity.{NodeId}
use realize.sink.{Sink, draw}
use env.{Env}

/// The terminal target: one accumulator of lines.
export type Tui = { lines: Cell<List<string>> = Cell.new([]) }

/// The one line a primitive draws for itself; a container draws none.
/// The shape a primitive's line takes: its content, bracketed, a
/// checkbox, a rule, or nothing.
export enum LineForm { Content, Bracketed, Checkbox, Rule, Blank }

/// How a primitive draws its line — ONE match, so no per-row aggregate
/// settles: the mapping is code, not data.
fn line_form(p: Prim) -> LineForm {
    match p {
        .Text or .Heading or .Link or .Image or .Field or .Slider or .Icon or .Progress or .Alert or .Spinner -> .Content,
        .Button -> .Bracketed,
        .Checkbox or .Switch -> .Checkbox,
        .Divider -> .Rule,
        .Row or .Column or .Dialog or .Surface or .List or .Item or .Card or .Form -> .Blank,
    }
}

fn line_of(n: Node) -> string {
    match line_form(n.prim) {
        .Content -> n.words(),
        .Bracketed -> "[${n.words()}]",
        .Checkbox -> "[ ] ${n.words()}",
        .Rule -> "----",
        .Blank -> "",
    }
}

impl Sink for Tui {
    fn opened(_id: NodeId, _parent: NodeId?, _index: int, n: Node) {
        let line = line_of(n)
        if line != "" { self.lines.push(line) }
    }
    fn words(_id: NodeId, _s: string) {}
    fn closed(_n: Node) {}
}

/// The finished frame for one tree.
export fn render(root: Node, _env: Env) -> string {
    let t = Tui {}
    draw(root, t)
    t.lines.get().join("\n")
}
