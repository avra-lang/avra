//! `realize/tui/tui.av` — the terminal target. The same Node, the same
//! vocabulary, drawn as plain text in a width: the tree is placed by the
//! layout solver in terminal cells (`place`), then painted on a grid of
//! them (`paint`).
use tree.node.{Node}
use place.measure.{Cells}
use place.solve.{Placed, place}
use realize.tui.paint.{painted, trimmed, gridded, Grid, Painted}
use realize.tui.wrap.{at_least_one}
use env.{Env}

/// The tree as text in `width` cells, one `\n` between rows and none after
/// the last. A width below one reads as one. Text wraps on word boundaries; a
/// word wider than the line is cut at the width, and an atom (button, link,
/// image) wider than it is clipped there.
export fn render(root: Node, _env: Env, width: int) -> string { focused(root, width, null) }

/// `render`, with the node at walk seat `focus` marked `> ` as the one
/// the keys go to.
export fn focused(root: Node, width: int, focus: int?) -> string {
    let w = at_least_one(width)
    [trimmed(row) for row in drawn(root, w, path_of(root, focus)).rows].join("\n")
}

/// The screen as a value: `width` cells across and `height` down (absent: as
/// tall as the layout asks), the node at walk seat `focus` marked and the
/// caret at its content. Rows past the layout are blank, rows past the
/// height are cut off.
export fn raster(root: Node, width: int, height: int?, focus: int?) -> Grid {
    let w = at_least_one(width)
    gridded(drawn(root, w, path_of(root, focus)), w, height)
}

fn drawn(root: Node, w: int, at: string) -> Painted {
    painted(root, place(root, Cells { focus: at }, w), w, at)
}

/// The boxes the solver gives the tree in `width` cells, with the node at
/// walk seat `focus` holding the keys: where `raster` draws everything.
export fn placed(root: Node, width: int, focus: int?) -> Placed {
    place(root, Cells { focus: path_of(root, focus) }, at_least_one(width))
}

/// The path of the node at walk seat `seat`, which is its place in the
/// walk that numbers a tree's nodes in the order they open; nothing when
/// there is no seat.
fn path_of(root: Node, seat: int?) -> string {
    let s? = seat else { return "" }
    let all = paths(root, "0")
    if s < all.length { all[s] } else { "" }
}

fn paths(n: Node, path: string) -> List<string> {
    [path].concat([p for i, c in n.children for p in paths(c, "${path}.${i}")])
}
