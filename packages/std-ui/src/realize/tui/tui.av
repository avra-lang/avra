//! `realize/tui/tui.av` — the terminal target. The same Node, the same
//! vocabulary, drawn as lines. A second target is a table and a walker,
//! never a component list. UI.md §19.2.
use realize.render.{Node, Prim, Attribute, content_of}
use env.{Env}

/// The terminal target: one accumulator of lines.
export type Tui = { lines: Cell<List<string>> = Cell.new([]) }

/// The one line a primitive draws for itself; a container draws none.
fn line_of(p: Prim, attrs: List<Attribute>) -> string {
    match p {
        .Text or .Heading or .Link or .Image or .Field or .Slider -> content_of(attrs),
        .Button -> "[${content_of(attrs)}]",
        .Checkbox or .Switch -> "[ ] ${content_of(attrs)}",
        .Progress or .Alert or .Spinner or .Icon -> content_of(attrs),
        .Divider -> "----",
        .Row or .Column or .Dialog or .Surface or .List or .Item or .Card or .Form -> "",
    }
}

fn draw(n: Node, t: Tui) {
    let line = line_of(n.prim, n.attrs)
    if line != "" { t.lines.push(line) }
    for c in n.children { draw(c, t) }
}

/// The finished frame for one tree.
export fn render(root: Node, _env: Env) -> string {
    let t = Tui {}
    draw(root, t)
    t.lines.get().join("\n")
}
