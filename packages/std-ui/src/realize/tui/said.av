//! `realize/tui/said.av` — what the terminal reads from a node's
//! attributes. ONE exhaustive match folds them, so a new attribute is a
//! decision here: drawn, or spelled as not drawn.
use tree.node.{Attribute}

/// The attributes the terminal draws, each at its absent value until a
/// node gives it.
export type Reads = {
    value: string = "",
    alt: string = "",
    href: string = "",
    title: string = "",
    name: string = "",
    checked: bool = false,
    open: bool = false,
    amount: int = 0,
    min: int = 0,
    max: int = 0,
}

/// `s` with what one attribute says. Words and a level are the node's own
/// reads; a state with no glyph and a hint the terminal has no place for
/// are not drawn.
fn heard(s: Reads, a: Attribute) -> Reads {
    match a {
        .Value(t) -> s with { value: t },
        .Alt(t) -> s with { alt: t },
        .Href(u) -> s with { href: u.text() },
        .Title(t) -> s with { title: t },
        .Name(t) -> s with { name: t },
        .Checked(flag) -> s with { checked: flag },
        .Open(flag) -> s with { open: flag },
        .Amount(n) -> s with { amount: n },
        .Min(n) -> s with { min: n },
        .Max(n) -> s with { max: n },
        .Text(_) or .Label(_) or .Level(_) or .Placeholder(_) or .Src(_) or .Disabled(_) or .Selected(_) or .Invalid(_) or .Loading(_) or .Urgency(_) or .Submits(_) -> s,
    }
}

/// Everything a node's attributes say to the terminal; a later attribute
/// of a kind wins.
export fn said_of(attrs: List<Attribute>) -> Reads {
    mut s = Reads {}
    for a in attrs { s = heard(s, a) }
    s
}
