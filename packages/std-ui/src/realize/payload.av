//! `realize/payload.av` — what a control SAYS when it speaks: the value
//! the user gave it, as DATA a target hands back with the event. A scalar
//! today; it grows an arm as a control needs one. ABSENCE IS THE OPTION'S
//! OWN NULL — a click says nothing — never a sentinel value.
export enum Payload {
    Text(value: string)
    Int(value: int)
    Bool(value: bool)
}
