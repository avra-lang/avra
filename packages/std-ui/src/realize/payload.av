//! `realize/payload.av` — the event wire's typed payload: the captures a
//! message variant carries, kept as DATA a frame can compare, encode and
//! inspect. A scalar today; the channel grows an arm as a capture needs
//! one. ABSENCE IS THE OPTION'S OWN NULL — `Action.payload` is `Payload?`
//! — never a sentinel value, so a present payload can never be mistaken
//! for a control that binds no handler.
export enum Payload {
    Text(value: string)
    Int(value: int)
    Bool(value: bool)
}
