// proves: one walk becomes a neutral update GRAPH — ids, placement, words
// and events — with no target's currency (tag, class, byte op, line) in it.
use @std.ui.realize.identity.{NodeId}
use @std.ui.realize.render.{Node, Prim, Attribute, EventKind, Action, Handler}
use @std.ui.realize.update.{Op, plan, words_at}
use @std.ui.style.box.{Box}

fn kind_word(k: EventKind) -> string {
    match k { .Press -> "press", .Input -> "input", .Change -> "change", .Submit -> "submit" }
}

fn op_word(op: Op) -> string {
    match op {
        .Mount(m) -> "M ${m.id.path} <${m.parent?.path ?? "-"} #${m.index} ${m.prim.word()}",
        .Words(id, t) -> if t == "" { "W ${id.path}" } else { "W ${id.path} ${t}" },
        .Event(id, a) -> "E ${id.path} ${kind_word(a.kind)}",
    }
}

fn nothing() {}

fn leaf(prim: Prim, words: string) -> Node {
    Node { prim: prim, attrs: [Attribute.Label(words)], box: Box {}, children: [] }
}

let button = Node {
    prim: .Button,
    attrs: [Attribute.Label("Add")],
    box: Box {},
    children: [],
    events: [Action { kind: .Press, handler: Handler.Nothing(nothing) }],
}

let root = Node {
    prim: .Column,
    attrs: [],
    box: Box {},
    children: [leaf(.Heading, "Tasks"), Node { prim: .Column, attrs: [], box: Box {}, children: [button] }],
}

let ops = plan(root)
println(ops.map(op_word).join("\n"))
println(words_at(ops, NodeId { path: "0/1/0" }) ?? "none")
println(words_at(ops, NodeId { path: "0/9" }) ?? "none")
println("${ops.length}")
