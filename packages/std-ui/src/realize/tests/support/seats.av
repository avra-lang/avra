//! The seats the target suites speak in: the five semantic kinds the neutral
//! nodes are written with, each as the seat a std control declares for it.
use tree.node.{Action, EventKind, Handler, Node}
use tree.seats.{Seat, seat_named, row_at}

/// The seat a std control declares for a kind of event.
export fn seat_for(kind: EventKind) -> Seat {
    match kind {
        .Press -> seat_named("button", "press"),
        .Input -> seat_named("field", "input"),
        .Change -> seat_named("checkbox", "change"),
        .Submit -> seat_named("form", "submit"),
        .Dismiss -> seat_named("dialog", "dismiss"),
    }
}

/// The kind of event a seat is.
export fn kind_at(seat: Seat) -> EventKind { row_at(seat).kind }

/// An action hearing `kind` with `handler`.
export fn action(kind: EventKind, handler: Handler) -> Action { Action { seat: seat_for(kind), handler: handler } }

/// `n` hearing `kind` with `handler`, and nothing else.
export fn hearing(n: Node, kind: EventKind, handler: Handler) -> Node { n with { events: [action(kind, handler)] } }
