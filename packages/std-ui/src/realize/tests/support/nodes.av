//! What the target suites share: neutral nodes written directly, so a
//! target is tested against the vocabulary and no component stands
//! between.
use @std.ui.realize.render.{Node, Prim, Attribute}
use @std.ui.style.box.{Box}
use @std.ui.style.layout.{Layout, Edge}
use @std.ui.ui.{Size}

/// A childless node of `prim` saying `attrs`.
export fn leaf(prim: Prim, attrs: List<Attribute>) -> Node {
    Node { prim: prim, attrs: attrs, box: Box {}, children: [] }
}

/// A node of `prim` placed by `layout`, holding `kids`.
export fn boxed(prim: Prim, layout: Layout, kids: List<Node>) -> Node {
    Node { prim: prim, attrs: [], box: Box { layout: layout }, children: kids }
}

/// A node of `prim` holding `kids`.
export fn holding(prim: Prim, kids: List<Node>) -> Node { boxed(prim, Layout {}, kids) }

/// `n` under the identity `key`.
export fn keyed(n: Node, key: string) -> Node { n with { box: n.box with { key: key } } }

/// `n` placed by `layout`.
export fn placed(n: Node, layout: Layout) -> Node { n with { box: n.box with { layout: layout } } }

/// `n` holding `kids`.
export fn with_kids(n: Node, kids: List<Node>) -> Node { n with { children: kids } }

export fn text_node(s: string) -> Node { leaf(.Text, [.Text(s)]) }

export fn heading_node(s: string, rank: int) -> Node { leaf(.Heading, [.Text(s), .Level(rank)]) }

export fn image_node(src: string, alt: string) -> Node { leaf(.Image, [.Src(src), .Alt(alt)]) }

export fn link_node(label: string, to: string) -> Node { leaf(.Link, [.Label(label), .Href(to)]) }

export fn button_node(label: string) -> Node { leaf(.Button, [.Label(label)]) }

export fn switch_node(label: string, on: bool) -> Node { leaf(.Switch, [.Label(label), .Checked(on)]) }

export fn field_node(label: string, value: string) -> Node { leaf(.Field, [.Label(label), .Value(value)]) }

export fn card_node(title: string, kids: List<Node>) -> Node {
    Node { prim: .Card, attrs: [.Title(title)], box: Box {}, children: kids }
}

/// A layout that only gaps.
export fn gap(z: Size) -> Layout { Layout { gap: z } }

/// A layout that only pads its leading edge.
export fn pad(z: Size) -> Layout { Layout { pad: Edge { start: z } } }

/// A layout that gaps and pads its leading edge.
export fn gap_pad(g: Size, p: Size) -> Layout { Layout { gap: g, pad: Edge { start: p } } }
