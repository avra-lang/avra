//! Event identity is the MESSAGE's content-addressed site: one message hashes
//! alike wherever it is bound, a different message hashes apart, and
//! `event_at` resolves the message the tree asked for by that site alone.
use @std.meta.{derive}
use @std.ui.components.{column, text}
use @std.ui.realize.view.{View}
use @std.ui.realize.prim.{prim}
use @std.ui.realize.render.{Node}
use @std.ui.realize.dom.frame.{event_at}
use @std.ui.realize.messages.{Messages}
use @std.ui.style.box.{Box}

@derive(Messages)
enum ToggleMsg {
    Toggle
    Open
}

@derive(View)
@prim(.Button)
component toggle_button {
    ..Box
    on_click: ToggleMsg = ToggleMsg.Toggle
}

fn toggle() -> toggle_button { toggle_button { on_click: ToggleMsg.Toggle } }

fn site_of(v: dyn View) -> int {
    let first = v.describe().events.first()
    match first {
        a? -> a.site
        null -> 0
    }
}

fn resolved(root: Node, site: int) -> ToggleMsg? {
    let found = event_at(root, site, 1)
    match found {
        a? -> ToggleMsg.from_site(a.site)
        null -> null
    }
}

spec "std/ui sites — a message's content, never an ordinal" {
    given "one message on two instances" {
        then "hashes alike" {
            site_of(toggle()) == site_of(toggle_button { on_click: ToggleMsg.Toggle })
        }
    }
    given "two messages on one declaration" {
        then "hash apart" {
            site_of(toggle_button { on_click: ToggleMsg.Toggle }) != site_of(toggle_button { on_click: ToggleMsg.Open })
        }
    }
    given "a node that moves down the tree" {
        then "keeps its site and its message" {
            let forward = column { items: [toggle(), text "x"] }
            let backward = column { items: [text "x", toggle()] }
            resolved(forward.describe(), site_of(toggle())) != null &&
                resolved(backward.describe(), site_of(toggle())) != null
        }
    }
    given "a site the tree does not carry" {
        then "resolves nothing" {
            event_at(toggle().describe(), site_of(toggle()) + 1, 1) == null
        }
    }
}
