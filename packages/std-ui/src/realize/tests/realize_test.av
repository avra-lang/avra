//! One component tree drawn through two realizers, by its laws: order is
//! kept, containers nest, and the HTML target escapes what it prints.
use @std.ui.realize.view.{View}
use @std.ui.realize.realizer.{drawn}
use @std.ui.components.{text, heading, button, column, row}
use @std.ui.realize.html.html.{Html, document}
use @std.ui.realize.tui.tui.{Tui, frame}

fn two() -> List<dyn View> { [text "a", text "b"] }

fn html_two() -> string {
    let h = Html {}
    drawn(two(), h)
    document(h)
}

fn terminal_two() -> string {
    let t = Tui {}
    drawn(two(), t)
    frame(t)
}

fn html_markup() -> string {
    let h = Html {}
    drawn([text "<b> & 'x'"], h)
    document(h)
}

fn terminal_markup() -> string {
    let t = Tui {}
    drawn([text "<b> & 'x'"], t)
    frame(t)
}

fn html_page() -> string {
    let h = Html {}
    let c = column {
        items: [heading "Shop" { rank: 2 }, text "hi", button "Buy"]
    }
    drawn([c], h)
    document(h)
}

fn terminal_page() -> string {
    let t = Tui {}
    let c = column {
        items: [heading "Shop" { rank: 2 }, text "hi", button "Buy"]
    }
    drawn([c], t)
    frame(t)
}

fn html_row() -> string {
    let h = Html {}
    let r = row {
        items: [text "a", text "b"]
    }
    drawn([r], h)
    document(h)
}

spec "std/ui realize — one tree, every target" {
    given "two texts drawn through html" {
        then "each is a span, in order" {
            html_two() == "<span>a</span><span>b</span>"
        }
    }
    given "the same two texts through the terminal" {
        then "each is a line, in order" {
            terminal_two() == "a\nb"
        }
    }
    given "text that looks like markup" {
        then "is escaped in html" {
            html_markup() == "<span>&lt;b&gt; &amp; &#39;x&#39;</span>"
        }
        then "is left alone in the terminal" {
            terminal_markup() == "<b> & 'x'"
        }
    }
}

spec "std/ui realize — a container of mixed components" {
    given "a column holding a heading, a text and a button" {
        then "html nests each in its own element, in order" {
            html_page() == "<div><h2>Shop</h2><span>hi</span><button>Buy</button></div>"
        }
        then "the terminal stacks one line each" {
            terminal_page() == "Shop\nhi\n[Buy]"
        }
    }
    given "a row of two texts" {
        then "html groups them in one element" { html_row() == "<div><span>a</span><span>b</span></div>" }
    }
}
