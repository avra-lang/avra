//! Attacks on realization: the empty tree, a view drawn twice, degenerate
//! text, and order at width.
use @std.ui.realize.view.{View}
use @std.ui.realize.realizer.{drawn}
use @std.ui.components.text.{text}
use @std.ui.realize.html.html.{Html, document}
use @std.ui.realize.html.writer.{HtmlOp, source}
use @std.ui.realize.tui.tui.{Tui, frame}

fn no_views() -> List<dyn View> { [] }

fn many(n: int) -> List<dyn View> { [text "t${i}" for i in 0..n] }

fn draw_html(vs: List<dyn View>) -> string {
    let h = Html {}
    drawn(vs, h)
    document(h)
}

fn draw_terminal(vs: List<dyn View>) -> string {
    let t = Tui {}
    drawn(vs, t)
    frame(t)
}

/// One view standing in a list twice.
fn doubled() -> string {
    let v: dyn View = text "x"
    draw_html([v, v])
}

spec "std/ui realize — the empty tree" {
    given "no views at all" {
        then "html is empty" { draw_html(no_views()).is_empty() }
        then "the terminal is empty" { draw_terminal(no_views()).is_empty() }
    }
}

spec "std/ui realize — a view drawn twice" {
    given "one view standing in a list twice" {
        then "is drawn once per standing" {
            doubled() == "<span>x</span><span>x</span>"
        }
    }
}

spec "std/ui realize — degenerate text" {
    given "text that is only markup" {
        then "html escapes every bracket" { draw_html([text "<>"]) == "<span>&lt;&gt;</span>" }
        then "the terminal prints it whole" { draw_terminal([text "<>"]) == "<>" }
    }
    given "empty text" {
        then "html still opens and closes its span" { draw_html([text ""]) == "<span></span>" }
        then "the terminal keeps its place, before the next line" {
            draw_terminal([text "", text "x"]) == "\nx"
        }
    }
}

spec "std/ui realize — the writer keeps its promises" {
    given "a document with a hostile element name" {
        then "drops every character a tag may not carry" {
            source([HtmlOp.Open("div onclick=x", null)]) == "<divonclickx>"
        }
        then "cannot be made to close early" {
            source([HtmlOp.Text("<script>")]) == "&lt;script&gt;"
        }
    }
    given "a component with a key" {
        then "carries it as an escaped attribute" {
            source([HtmlOp.Open("div", "a\"b")]) == "<div data-key=\"a&quot;b\">"
        }
        then "carries nothing when it has no key" {
            source([HtmlOp.Open("div", null)]) == "<div>"
        }
    }
    given "every character a text run may not carry" {
        then "is an entity" {
            source([HtmlOp.Text("\"&'")]) == "&quot;&amp;&#39;"
        }
    }
}

spec "std/ui realize — order at length" {
    given "a hundred texts" {
        then "html keeps every one, in order" {
            draw_html(many(100)).starts_with("<span>t0</span><span>t1</span>") &&
                draw_html(many(100)).ends_with("<span>t99</span>")
        }
        then "the terminal keeps every line, in order" {
            draw_terminal(many(100)).starts_with("t0\nt1\n") &&
                draw_terminal(many(100)).ends_with("t99")
        }
    }
}
