//! `realize/html/url.av` — which URLs may reach an attribute. A URL the
//! browser would RUN (`javascript:`, `data:`) never does: a reference
//! passes only when it is relative, names no scheme, or names an allowed
//! one. The scheme is read as written — no trimming, no decoding — so a
//! spelling the browser would repair is refused, never repaired here.
use @std.text.{ascii_lowered}

/// The schemes a link or a source may name.
const schemes = ["http", "https", "mailto"]

/// The openings that make a reference relative, whatever follows.
const relative_heads = ["/", "./", "../", "#", "?"]

/// Whether `u` may be emitted as a link's target or an image's source.
export fn safe_url(u: string) -> bool {
    let colon = u.index_of(":")
    colon < 0 || relative_heads.any((head) -> u.starts_with(head)) || allowed(u.substring(0, colon))
}

/// Whether a scheme is an allowed one, read without ASCII case. Octets
/// are compared, so no text is rebuilt from what a stranger wrote.
fn allowed(scheme: string) -> bool {
    let folded = ascii_lowered(scheme.bytes())
    schemes.any(it.bytes() == folded)
}
