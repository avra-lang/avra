//! `realize/html/css.av` — the atomic class vocabulary and the one
//! stylesheet. A `Box` field becomes a class named for its token
//! (`fill-surface`, `gap-m`), and the class carries the value through a
//! CSS variable the theme fills; an interaction override prefixes its
//! classes with the state (`hover:fill-surface-hover`) and the
//! stylesheet appends the pseudo-class. The class set is deduped per
//! document, so two nodes that share a look share one rule, and no
//! value ever reaches a class name.
use style.box.{Box}
use style.style.{Style, StateStyle, Interaction}
use style.layout.{Axis, Align, Distribute, Sizing, Edge, Layout}
use style.theme.{Theme, space_of, radius_of, color_of, face_of}
use ui.{Size, Tone, Font}

/// One atomic rule: its class name (already state-prefixed), the state
/// it applies in, and the declaration it carries.
export type CssRule = { name: string, state: Interaction?, decl: string }

const sizes = [Size.None, .Xs, .S, .M, .L, .Xl]
const tones = [Tone.Text, .Muted, .Danger, .Surface, .SurfaceRaised, .SurfaceSunk, .SurfaceHover]
const fonts = [Font.Body, .Heading, .Footnote, .Mono]

fn size_word(z: Size) -> string {
    match z { .None -> "none", .Xs -> "xs", .S -> "s", .M -> "m", .L -> "l", .Xl -> "xl" }
}

fn tone_word(t: Tone) -> string {
    match t {
        .Text -> "text",
        .Muted -> "muted",
        .Danger -> "danger",
        .Surface -> "surface",
        .SurfaceRaised -> "surface-raised",
        .SurfaceSunk -> "surface-sunk",
        .SurfaceHover -> "surface-hover",
    }
}

fn font_word(f: Font) -> string {
    match f { .Body -> "body", .Heading -> "heading", .Footnote -> "footnote", .Mono -> "mono" }
}

fn state_word(s: Interaction) -> string {
    match s { .Hover -> "hover", .Focus -> "focus", .Pressed -> "pressed", .Disabled -> "disabled" }
}

/// The pseudo-class a state maps to on the web.
fn pseudo_class(s: Interaction) -> string {
    match s {
        .Hover -> ":hover",
        .Focus -> ":focus-visible",
        .Pressed -> ":active",
        .Disabled -> ":disabled",
    }
}

fn prefixed(name: string, state: Interaction?) -> string {
    match state {
        s? -> "${state_word(s)}:${name}"
        null -> name
    }
}

/// One rule, or nothing when the field was not given.
fn rule(name: string, state: Interaction?, decl: string) -> List<CssRule> {
    if name == "" { return [] }
    [CssRule { name: prefixed(name, state), state: state, decl: decl }]
}

// ── layout ──────────────────────────────────────────────────────

/// A token's class name and the declaration it carries — ONE value, so
/// the name and the declaration of a variant are written together.
type CssWord = { name: string, decl: string }

fn axis_word(a: Axis) -> CssWord {
    match a {
        .Row -> CssWord { name: "dir-row", decl: "display:flex;flex-direction:row" },
        .Column -> CssWord { name: "dir-col", decl: "display:flex;flex-direction:column" },
    }
}

/// One value's rule, or nothing when the field was not given — the one
/// shape every optional token shares.
fn opted<T>(x: T?, state: Interaction?, mk: fn(T) -> CssWord) -> List<CssRule> {
    match x {
        v? -> {
            let w = mk(v)
            rule(w.name, state, w.decl)
        }
        null -> []
    }
}

fn gap_word(z: Size) -> CssWord {
    CssWord { name: "gap-${size_word(z)}", decl: "gap:var(--space-${size_word(z)})" }
}

fn color_word(c: Tone) -> CssWord {
    CssWord { name: "color-${tone_word(c)}", decl: "color:var(--tone-${tone_word(c)})" }
}

fn fill_word(c: Tone) -> CssWord {
    CssWord { name: "fill-${tone_word(c)}", decl: "background:var(--tone-${tone_word(c)})" }
}

fn radius_word(z: Size) -> CssWord {
    CssWord { name: "radius-${size_word(z)}", decl: "border-radius:var(--radius-${size_word(z)})" }
}

fn face_word(f: Font) -> CssWord {
    CssWord { name: "face-${font_word(f)}", decl: "font-family:var(--face-${font_word(f)})" }
}

/// A sizing token's class and declaration; `Hug`/`Percent` draw none.
fn size_word_of(prefix: string, prop: string, s: Sizing) -> CssWord {
    match s {
        .Hug -> CssWord { name: "", decl: "" },
        .Fill -> CssWord { name: "${prefix}-fill", decl: "${prop}:100%" },
        .Fixed(n) -> CssWord { name: "${prefix}-${n}", decl: "${prop}:${n}px" },
        .Percent(_) -> CssWord { name: "", decl: "" },
    }
}

/// The wrappers: a token, its state and its word.
fn axis_rule(a: Axis?, state: Interaction?) -> List<CssRule> { opted(a, state, axis_word) }

fn gap_rule(z: Size?, state: Interaction?) -> List<CssRule> { opted(z, state, gap_word) }

fn align_rule(a: Align?, state: Interaction?) -> List<CssRule> { opted(a, state, align_word) }

fn distribute_rule(d: Distribute?, state: Interaction?) -> List<CssRule> { opted(d, state, distribute_word) }

fn color_rule(c: Tone?, state: Interaction?) -> List<CssRule> { opted(c, state, color_word) }

fn fill_rule(c: Tone?, state: Interaction?) -> List<CssRule> { opted(c, state, fill_word) }

fn radius_rule(z: Size?, state: Interaction?) -> List<CssRule> { opted(z, state, radius_word) }

fn face_rule(f: Font?, state: Interaction?) -> List<CssRule> { opted(f, state, face_word) }

fn sizing_rule(prefix: string, prop: string, s: Sizing?, state: Interaction?) -> List<CssRule> {
    opted(s, state, (v) -> size_word_of(prefix, prop, v))
}

fn edge_rule(prefix: string, prop: string, z: Size?, state: Interaction?) -> List<CssRule> {
    match z {
        v? -> rule("${prefix}-${size_word(v)}", state, "${prop}:var(--space-${size_word(v)})")
        null -> []
    }
}

fn pad_rules(e: Edge?, state: Interaction?) -> List<CssRule> {
    match e {
        v? -> edge_rule("pis", "padding-inline-start", v.start, state)
            .concat(edge_rule("pie", "padding-inline-end", v.end, state))
            .concat(edge_rule("pt", "padding-top", v.top, state))
            .concat(edge_rule("pb", "padding-bottom", v.bottom, state))
        null -> []
    }
}

fn align_word(a: Align) -> CssWord {
    match a {
        .Start -> CssWord { name: "ai-start", decl: "align-items:flex-start" },
        .Center -> CssWord { name: "ai-center", decl: "align-items:center" },
        .End -> CssWord { name: "ai-end", decl: "align-items:flex-end" },
        .Stretch -> CssWord { name: "ai-stretch", decl: "align-items:stretch" },
        .Baseline -> CssWord { name: "ai-baseline", decl: "align-items:baseline" },
    }
}

fn distribute_word(d: Distribute) -> CssWord {
    match d {
        .Start -> CssWord { name: "jc-start", decl: "justify-content:flex-start" },
        .Center -> CssWord { name: "jc-center", decl: "justify-content:center" },
        .End -> CssWord { name: "jc-end", decl: "justify-content:flex-end" },
        .SpaceBetween -> CssWord { name: "jc-between", decl: "justify-content:space-between" },
        .SpaceAround -> CssWord { name: "jc-around", decl: "justify-content:space-around" },
        .SpaceEvenly -> CssWord { name: "jc-evenly", decl: "justify-content:space-evenly" },
    }
}

/// A sizing token's class name, or nothing when it draws no rule.

fn grow_rule(n: int, state: Interaction?) -> List<CssRule> {
    if n > 0 { rule("grow-${n}", state, "flex-grow:${n}") } else { [] }
}

fn layout_rules(l: Layout, state: Interaction?) -> List<CssRule> {
    axis_rule(l.direction, state)
        .concat(gap_rule(l.gap, state))
        .concat(pad_rules(l.pad, state))
        .concat(align_rule(l.align, state))
        .concat(distribute_rule(l.distribute, state))
        .concat(sizing_rule("w", "width", l.width, state))
        .concat(sizing_rule("h", "height", l.height, state))
        .concat(grow_rule(l.grow, state))
}

// ── appearance ──────────────────────────────────────────────────

fn appearance_rules(s: Style, state: Interaction?) -> List<CssRule> {
    color_rule(s.color, state)
        .concat(fill_rule(s.fill, state))
        .concat(radius_rule(s.radius, state))
        .concat(face_rule(s.face, state))
}

// ── the rules a box names ───────────────────────────────────────

/// Every atomic rule a `Box` names: its layout and appearance, then one
/// group per interaction state.
export fn rules_of(box: Box) -> List<CssRule> {
    mut out = layout_rules(box.layout, null).concat(appearance_rules(box.style, null))
    for ss in box.style.states { out = out.concat(appearance_rules(ss.style, ss.state)) }
    out
}

/// Rules with each class name kept once, order intact; two nodes that
/// share a look share the rule.
export fn distinct_rules(rules: List<CssRule>) -> List<CssRule> {
    mut seen: List<string> = []
    mut out: List<CssRule> = []
    for r in rules {
        if !seen.contains(r.name) {
            seen = seen.concat([r.name])
            out = out.concat([r])
        }
    }
    out
}

// ── the stylesheet ──────────────────────────────────────────────

fn space_vars(t: Theme) -> string {
    ["--space-${size_word(z)}:${space_of(t, z)}px;" for z in sizes].join("")
}

fn radius_vars(t: Theme) -> string {
    ["--radius-${size_word(z)}:${radius_of(t, z)}px;" for z in sizes].join("")
}

fn tone_vars(t: Theme) -> string {
    ["--tone-${tone_word(c)}:${color_of(t, c)};" for c in tones].join("")
}

fn face_vars(t: Theme) -> string {
    ["--face-${font_word(f)}:${face_of(t, f)};" for f in fonts].join("")
}

/// The theme as the variables every class reads. A mode is a whole
/// theme, so a mode change rewrites these and moves no class.
fn root_vars(t: Theme) -> string {
    ":root{${space_vars(t)}${radius_vars(t)}${tone_vars(t)}${face_vars(t)} }"
}

/// A class name as a selector; `:` in a state prefix is escaped.
fn selector(name: string) -> string { ".${name.replace(":", "\\:")}" }

fn pseudo_of(s: Interaction?) -> string {
    match s {
        v? -> pseudo_class(v)
        null -> ""
    }
}

fn rule_source(r: CssRule) -> string { "${selector(r.name)}${pseudo_of(r.state)}{${r.decl}}" }

/// The one stylesheet every class in the document names.
export fn stylesheet(rules: List<CssRule>, t: Theme) -> string {
    [root_vars(t)].concat([rule_source(r) for r in rules]).join("\n")
}
