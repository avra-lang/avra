//! `realize/html/css.av` — the atomic class vocabulary and the one
//! stylesheet. A `Box` field becomes a class named for its token
//! (`fill-surface`, `gap-m`), and the class carries the value through a
//! CSS variable the theme fills; an interaction override prefixes its
//! classes with the state (`hover:fill-surface-hover`) and the
//! stylesheet appends the pseudo-class. The class set is deduped per
//! document, so two nodes that share a look share one rule, and no
//! value ever reaches a class name.
use style.box.{Box}
use style.style.{Style, StateStyle, Interaction}
use style.layout.{Axis, Align, Distribute, Wrap, Sizing, Edge, Layout, around}
use style.theme.{Theme, Mode}
use tree.lists.{flatten}
use tree.node.{Node, Prim, Attribute, own_axis, gap_between}
use style.tokens.{Size, Tone, Font}
use realize.html.tags.{HtmlTag}

/// One atomic rule: its class name (already state-prefixed), the state
/// it applies in, the selector it applies under (the parent axis a size
/// or a growth speaks for; nothing for a rule that needs no parent), and
/// the declaration it carries.
export type CssRule = { name: string, state: Interaction?, under: string, decl: string }

const sizes = [Size.None, .Xs, .S, .M, .L, .Xl]
const tones = [Tone.Text, .Muted, .Danger, .Surface, .SurfaceRaised, .SurfaceSunk, .SurfaceHover]
const fonts = [Font.Body, .Heading, .Footnote, .Mono]

/// The pseudo-class a state maps to on the web — ONE match, so no
/// per-row aggregate settles.
fn pseudo_class(s: Interaction) -> string {
    match s {
        .Hover -> ":hover",
        .Focus -> ":focus-visible",
        .Pressed -> ":active",
        .Disabled -> ":disabled",
    }
}

fn prefixed(name: string, state: Interaction?) -> string {
    match state {
        s? -> "${s.word()}:${name}"
        null -> name
    }
}

/// One rule, or nothing when the field was not given.
fn rule(name: string, state: Interaction?, decl: string) -> List<CssRule> {
    if name == "" { return [] }
    [CssRule { name: prefixed(name, state), state: state, under: "", decl: decl }]
}

/// A rule that applies to a child of a parent laid along `parent`: what a
/// size or a growth means depends on the axis it sits on.
fn scoped(parent: Axis, name: string, state: Interaction?, decl: string) -> List<CssRule> {
    [
        CssRule {
            name: prefixed(name, state),
            state: state,
            under: ".${axis_word(parent).name}>",
            decl: decl,
        },
    ]
}

fn across(a: Axis) -> Axis {
    match a { .Row -> .Column, .Column -> .Row }
}

// ── layout ──────────────────────────────────────────────────────

/// A token's class name and the declaration it carries — ONE value, so
/// the name and the declaration of a variant are written together.
type CssWord = { name: string, decl: string }

/// The empty word — a token with no CSS of its own.
const no_word = CssWord { name: "", decl: "" }
/// Every axis and its class+declaration — ONE match.
fn axis_word(a: Axis) -> CssWord {
    match a {
        .Row -> CssWord { name: "dir-row", decl: "display:flex;flex-direction:row" },
        .Column -> CssWord { name: "dir-col", decl: "display:flex;flex-direction:column" },
    }
}

/// One value's rule, or nothing when the field was not given — the one
/// shape every optional token shares.
fn opted<T>(x: T?, state: Interaction?, mk: fn(T) -> CssWord) -> List<CssRule> {
    match x {
        v? -> {
            let w = mk(v)
            rule(w.name, state, w.decl)
        }
        null -> []
    }
}

fn gap_word(z: Size) -> CssWord {
    CssWord { name: "gap-${z.word()}", decl: "gap:var(--space-${z.word()})" }
}

fn color_word(c: Tone) -> CssWord {
    CssWord { name: "color-${c.word()}", decl: "color:var(--tone-${c.word()})" }
}

fn fill_word(c: Tone) -> CssWord {
    CssWord { name: "fill-${c.word()}", decl: "background:var(--tone-${c.word()})" }
}

fn radius_word(z: Size) -> CssWord {
    CssWord { name: "radius-${z.word()}", decl: "border-radius:var(--radius-${z.word()})" }
}

fn face_word(f: Font) -> CssWord {
    CssWord { name: "face-${f.word()}", decl: "font-family:var(--face-${f.word()})" }
}

/// The wrappers: a token, its state and its word.
fn axis_rule(a: Axis?, state: Interaction?) -> List<CssRule> { opted(a, state, axis_word) }

fn gap_rule(z: Size?, state: Interaction?) -> List<CssRule> { opted(z, state, gap_word) }

fn align_rule(a: Align?, state: Interaction?) -> List<CssRule> { opted(a, state, align_word) }

fn distribute_rule(d: Distribute?, state: Interaction?) -> List<CssRule> { opted(d, state, distribute_word) }

fn color_rule(c: Tone?, state: Interaction?) -> List<CssRule> { opted(c, state, color_word) }

fn fill_rule(c: Tone?, state: Interaction?) -> List<CssRule> { opted(c, state, fill_word) }

fn radius_rule(z: Size?, state: Interaction?) -> List<CssRule> { opted(z, state, radius_word) }

fn face_rule(f: Font?, state: Interaction?) -> List<CssRule> { opted(f, state, face_word) }

/// A size along `along`, the parent axis it is the main one of. A fixed
/// size holds on it; a fill takes the room that is left there (a growth
/// given is its share) and stretches across; hug and a fraction write
/// nothing. The flex basis is a percentage so that a parent whose size
/// along is not yet known gives it the content's.
fn sizing_rule(
    along: Axis,
    prefix: string,
    prop: string,
    least: string,
    s: Sizing?,
    state: Interaction?,
) -> List<CssRule> {
    let v? = s else { return [] }
    match v {
        .Hug or .Percent(_) -> [],
        .Fill -> scoped(along, "${prefix}-fill", state, "flex:var(--grow) 1 0%;${least}:0")
            .concat(scoped(across(along), "${prefix}-fill", state, "align-self:stretch")),
        .Fixed(_) -> rule("${prefix}-fixed", state, "${prop}:var(--${prefix})")
            .concat(scoped(along, "${prefix}-fixed", state, "flex-shrink:0")),
    }
}

fn edge_rule(prefix: string, prop: string, z: Size?, state: Interaction?) -> List<CssRule> {
    match z {
        v? -> rule("${prefix}-${v.word()}", state, "${prop}:var(--space-${v.word()})")
        null -> []
    }
}

fn pad_rules(e: Edge?, state: Interaction?) -> List<CssRule> {
    match e {
        v? -> edge_rule("pis", "padding-inline-start", v.start, state)
            .concat(edge_rule("pie", "padding-inline-end", v.end, state))
            .concat(edge_rule("pt", "padding-top", v.top, state))
            .concat(edge_rule("pb", "padding-bottom", v.bottom, state))
        null -> []
    }
}

/// Every alignment and its class+declaration — ONE match.
fn align_word(a: Align) -> CssWord {
    match a {
        .Start -> CssWord { name: "ai-start", decl: "align-items:flex-start" },
        .Center -> CssWord { name: "ai-center", decl: "align-items:center" },
        .End -> CssWord { name: "ai-end", decl: "align-items:flex-end" },
        .Stretch -> CssWord { name: "ai-stretch", decl: "align-items:stretch" },
        .Baseline -> CssWord { name: "ai-baseline", decl: "align-items:baseline" },
    }
}

/// Every distribution and its class+declaration — ONE match.
fn distribute_word(d: Distribute) -> CssWord {
    match d {
        .Start -> CssWord { name: "jc-start", decl: "justify-content:flex-start" },
        .Center -> CssWord { name: "jc-center", decl: "justify-content:center" },
        .End -> CssWord { name: "jc-end", decl: "justify-content:flex-end" },
        .SpaceBetween -> CssWord { name: "jc-between", decl: "justify-content:space-between" },
        .SpaceAround -> CssWord { name: "jc-around", decl: "justify-content:space-around" },
        .SpaceEvenly -> CssWord { name: "jc-evenly", decl: "justify-content:space-evenly" },
    }
}

/// A sizing token's class name, or nothing when it draws no rule.

fn grow_rule(n: int, state: Interaction?) -> List<CssRule> {
    if n > 0 { rule("grow", state, "flex-grow:var(--grow)") } else { [] }
}

fn order_rule(n: int, state: Interaction?) -> List<CssRule> {
    if n == 0 { return [] }
    rule("order", state, "order:var(--order)")
}

fn wrap_word(w: Wrap) -> CssWord {
    match w {
        .NoWrap -> CssWord { name: "wrap-no", decl: "flex-wrap:nowrap" },
        .Wrap -> CssWord { name: "wrap-yes", decl: "flex-wrap:wrap" },
        .WrapReverse -> CssWord { name: "wrap-rev", decl: "flex-wrap:wrap-reverse" },
    }
}

fn wrap_rule(w: Wrap?, state: Interaction?) -> List<CssRule> { opted(w, state, wrap_word) }

fn margin_rules(e: Edge?, state: Interaction?) -> List<CssRule> {
    match e {
        v? -> edge_rule("mis", "margin-inline-start", v.start, state)
            .concat(edge_rule("mie", "margin-inline-end", v.end, state))
            .concat(edge_rule("mt", "margin-top", v.top, state))
            .concat(edge_rule("mb", "margin-bottom", v.bottom, state))
        null -> []
    }
}

fn layout_rules(l: Layout, state: Interaction?) -> List<CssRule> {
    flatten(
        [
            axis_rule(l.direction, state),
            gap_rule(l.gap, state),
            pad_rules(l.pad, state),
            align_rule(l.align, state),
            distribute_rule(l.distribute, state),
            sizing_rule(.Row, "w", "width", "min-width", l.width, state),
            sizing_rule(.Column, "h", "height", "min-height", l.height, state),
            wrap_rule(l.wrap, state),
            margin_rules(l.margin, state),
            grow_rule(l.grow, state),
            order_rule(l.order, state),
        ],
    )
}

// ── appearance ──────────────────────────────────────────────────

fn appearance_rules(s: Style, state: Interaction?) -> List<CssRule> {
    flatten(
        [
            color_rule(s.color, state),
            fill_rule(s.fill, state),
            radius_rule(s.radius, state),
            face_rule(s.face, state),
        ],
    )
}

// ── the rules a box names ───────────────────────────────────────

impl Box {
    /// Every atomic rule this box names: its layout and appearance, then
    /// one group per interaction state.
    fn rules() -> List<CssRule> {
        mut out = layout_rules(self.layout, null).concat(appearance_rules(self.style, null))
        for ss in self.style.states { out = out.concat(appearance_rules(ss.style, ss.state)) }
        out
    }
}
/// One custom property a node writes: a value a class reads, so no value
/// ever reaches a class name.
export type CssVar = { name: string, value: string }

impl CssVar {
    /// The custom property this names.
    fn property() -> string { "--${self.name}" }
}

/// The property a fixed sizing writes, in pixels; nothing for any other sizing.
fn px_var(name: string, s: Sizing?) -> List<CssVar> {
    let v? = s else { return [] }
    match v {
        .Fixed(n) -> [CssVar { name: name, value: "${n}px" }],
        .Hug or .Fill or .Percent(_) -> [],
    }
}

/// The custom properties a box writes on its node: its fixed sizes, its growth
/// and its order — the values its `w-fixed`, `h-fixed`, `grow` and `order`
/// classes read.
export fn box_vars(box: Box) -> List<CssVar> {
    flatten(
        [
            px_var("w", box.layout.width),
            px_var("h", box.layout.height),
            if box.layout.grow > 0 { [CssVar { name: "grow", value: "${box.layout.grow}" }] } else { [] },
            if box.layout.order != 0 { [CssVar { name: "order", value: "${box.layout.order}" }] } else { [] },
        ],
    )
}

/// Every rule a node names: its primitive's own axis unless its layout
/// names one, the gap its axis keeps unless its layout names one, then
/// its box. An item flows as its element does: a flex box draws no list
/// marker.
export fn node_rules(prim: Prim, box: Box) -> List<CssRule> {
    let axis = if box.layout.direction == null { axis_rule(own_axis(prim), null) } else { [] }
    let gap = if box.layout.gap == null { gap_rule(gap_between(prim, box), null) } else { [] }
    axis.concat(gap).concat(box.rules())
}

/// The height a window's spacer stands for, in pixels: its unbuilt rows at the
/// height each took. Any other attribute stands for none.
fn spacing(a: Attribute) -> List<int> {
    match a { .Skipped(_, rows, extent) -> [rows * extent], rest -> [] }
}

/// The box a node is drawn with: a window's spacer stands as the fixed height of
/// the rows it stands for, so it wears what every fixed height wears.
export fn drawn_box(n: Node) -> Box {
    let height? = [h for a in n.attrs for h in spacing(a)].first() else { return n.box }
    n.box with { layout: n.box.layout with { height: .Fixed(height) } }
}

/// Every rule a tree's nodes name, in walk order.
export fn rules_of(n: Node) -> List<CssRule> {
    node_rules(n.prim, drawn_box(n)).concat([r for c in n.children for r in rules_of(c)])
}

/// Every class a node names, once, in rule order.
export fn class_names(n: Node) -> List<string> { names_once([r.name for r in node_rules(n.prim, drawn_box(n))]) }

fn names_once(names: List<string>) -> List<string> { [name for i, name in names if !names.slice(0, i).contains(name)] }

/// Rules with each class name kept once, order intact; two nodes that
/// share a look share the rule.
export fn distinct_rules(rules: List<CssRule>) -> List<CssRule> {
    mut seen: List<string> = []
    mut out: List<CssRule> = []
    for r in rules {
        if !seen.contains("${r.under}${r.name}") {
            seen = seen.concat(["${r.under}${r.name}"])
            out = out.concat([r])
        }
    }
    out
}

// ── the vocabulary ──────────────────────────────────────────────

const axes = [Axis.Row, .Column]
const aligns = [Align.Start, .Center, .End, .Stretch, .Baseline]
const distributions = [Distribute.Start, .Center, .End, .SpaceBetween, .SpaceAround, .SpaceEvenly]
const wraps = [Wrap.NoWrap, .Wrap, .WrapReverse]
const interactions = [Interaction.Hover, .Focus, .Pressed, .Disabled]

/// The states a look may be given in: at rest, then each interaction.
fn states() -> List<Interaction?> {
    let rest: List<Interaction?> = [null]
    let each: List<Interaction?> = [i for i in interactions]
    rest.concat(each)
}

/// Every layout rule a token can name. A size, a growth and an order ride a
/// custom property, so each is ONE rule here whatever its value.
fn layout_vocabulary() -> List<CssRule> {
    flatten(
        [
            flatten([axis_rule(a, null) for a in axes]),
            flatten([gap_rule(z, null) for z in sizes]),
            flatten([pad_rules(around(z), null) for z in sizes]),
            flatten([margin_rules(around(z), null) for z in sizes]),
            flatten([align_rule(a, null) for a in aligns]),
            flatten([distribute_rule(d, null) for d in distributions]),
            flatten([wrap_rule(w, null) for w in wraps]),
            sizing_rule(.Row, "w", "width", "min-width", Sizing.Fill, null),
            sizing_rule(.Row, "w", "width", "min-width", Sizing.Fixed(0), null),
            sizing_rule(.Column, "h", "height", "min-height", Sizing.Fill, null),
            sizing_rule(.Column, "h", "height", "min-height", Sizing.Fixed(0), null),
            grow_rule(1, null),
            order_rule(1, null),
        ],
    )
}

/// Every appearance rule a token can name, at rest and in each state.
fn appearance_vocabulary() -> List<CssRule> {
    flatten(
        [
            flatten([color_rule(c, s) for s in states() for c in tones]),
            flatten([fill_rule(c, s) for s in states() for c in tones]),
            flatten([radius_rule(z, s) for s in states() for z in sizes]),
            flatten([face_rule(f, s) for s in states() for f in fonts]),
        ],
    )
}

/// EVERY RULE THE VOCABULARY CAN NAME, once, in a fixed order: no value ever
/// reaches a class name, so what a tree names is always a subset of this.
/// It is the same for every program on this version of the vocabulary.
export fn all_rules() -> List<CssRule> { distinct_rules(layout_vocabulary().concat(appearance_vocabulary())) }

/// The vocabulary as a stylesheet — the page's base and every rule, with no
/// theme in it: one file for every page of every program.
export fn atoms_sheet() -> string { base_rules().concat([rule_source(r) for r in all_rules()]).join("\n") }

/// A theme as a stylesheet: its variables, then each alternate under its mode's query.
export fn theme_sheet(t: Theme, alternates: List<Theme>) -> string {
    [root_vars(t)].concat([alternate(a) for a in alternates]).join("\n")
}

// ── the stylesheet ──────────────────────────────────────────────

fn space_vars(t: Theme) -> string {
    ["--space-${z.word()}:${t.space_of(z)}px;" for z in sizes].join("")
}

fn radius_vars(t: Theme) -> string {
    ["--radius-${z.word()}:${t.radius_of(z)}px;" for z in sizes].join("")
}

fn tone_vars(t: Theme) -> string {
    ["--tone-${c.word()}:${t.color_of(c)};" for c in tones].join("")
}

fn face_vars(t: Theme) -> string {
    ["--face-${f.word()}:${t.face_of(f)};" for f in fonts].join("")
}

/// The scheme a mode asks the browser's own controls to wear. Every
/// mode spelled.
fn scheme(m: Mode) -> string {
    match m { .Light or .HighContrast -> "light", .Dark -> "dark" }
}

/// The theme as the variables every class reads, and the scheme its
/// mode is. A mode is a whole
/// theme, so a mode change rewrites these and moves no class.
export fn root_vars(t: Theme) -> string {
    ":root{color-scheme:${scheme(t.mode)};${space_vars(t)}${radius_vars(t)}${tone_vars(t)}${face_vars(t)} }"
}

/// A class name as a selector; `:` in a state prefix is escaped.
fn selector(name: string) -> string { ".${name.replace(":", "\\:")}" }

fn pseudo_of(s: Interaction?) -> string {
    match s {
        v? -> pseudo_class(v)
        null -> ""
    }
}

fn rule_source(r: CssRule) -> string { "${r.under}${selector(r.name)}${pseudo_of(r.state)}{${r.decl}}" }

/// These tags as one selector.
fn tags(of: List<HtmlTag>) -> string { [t.word() for t in of].join(",") }

/// The axis classes, as what an element that is no flex box does not wear.
fn unflexed() -> string { [":not(.${axis_word(a).name})" for a in [Axis.Row, .Column]].join("") }

/// What the page looks like under every node, read from the same
/// variables. The page wears the surface, the text colour and the body
/// face, and a control wears them too rather than the browser's own: a
/// button shows what it stands on inside a border, so a fill it names is
/// the fill a reader sees, and one that cannot speak is muted. A heading
/// and a rule keep no margin: space is a gap or a pad. A control and its
/// words sit on one line, a step apart; what an item holds on one line
/// stands a step apart too, and the item keeps its marker. A dialog wears
/// the surface over the middle of the page, and a closed one is not
/// drawn whatever its classes say.
fn base_rules() -> List<string> {
    [
        "*,*::before,*::after{box-sizing:border-box}",
        "@property --grow{syntax:\"<number>\";inherits:false;initial-value:1}",
        "body{margin:0;overflow-wrap:break-word;${fill_word(.Surface).decl};${color_word(.Text).decl};${face_word(.Body).decl}}",
        "${tags([.Button, .Input])}{font:inherit;color:inherit}",
        "${tags([.Button])}{background:transparent;border:1px solid var(--tone-${Tone.Muted.word()});padding:var(--space-${Size.Xs.word()}) var(--space-${Size.S.word()})}",
        "${tags([.Button])}:disabled{${color_word(.Muted).decl}}",
        "${tags([.H1, .H2, .H3, .H4, .H5, .H6, .Hr])}{margin:0}",
        "${tags([.Label])}{display:inline-flex;align-items:center;${gap_word(.Xs).decl}}",
        "${tags([.Li])}${unflexed()}>*+*{margin-inline-start:var(--space-${Size.S.word()})}",
        "${tags([.Dialog])}{position:fixed;inset-block:0;${fill_word(.Surface).decl};${color_word(.Text).decl}}",
        "${tags([.Dialog])}:not([open]){display:none}",
    ]
}

/// The media query under which a reader's settings ask for a mode. Every
/// mode spelled.
fn mode_query(m: Mode) -> string {
    match m {
        .Light -> "(prefers-color-scheme: light)",
        .Dark -> "(prefers-color-scheme: dark)",
        .HighContrast -> "(prefers-contrast: more)",
    }
}

/// An alternate theme: the same variables, rewritten while its mode is asked for.
fn alternate(t: Theme) -> string { "@media ${mode_query(t.mode)}{${root_vars(t)}}" }

/// A whole page's stylesheet: the theme, each alternate under its mode's
/// query, the page's own base, then the rules the tree named.
export fn page_sheet(rules: List<CssRule>, t: Theme, alternates: List<Theme>) -> string {
    [root_vars(t)]
        .concat([alternate(a) for a in alternates])
        .concat(base_rules())
        .concat([rule_source(r) for r in rules])
        .join("\n")
}
