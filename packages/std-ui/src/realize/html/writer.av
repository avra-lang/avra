//! `realize/html/writer.av` — the typed HTML writer. A document is a list
//! of OPS; `source` serializes them, escaping every value.
use realize.html.tags.{HtmlTag, HtmlAttr, HtmlAttrName, tag_text, attr_text}

/// One piece of a document, in drawing order.
export enum HtmlOp {
    Open(tag: HtmlTag, attrs: List<HtmlAttr>)
    Close(tag: HtmlTag)
    Text(content: string)
}

/// The five characters that end a text or attribute context, as entities.
fn entities(s: string) -> string {
    s
        .replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace("\"", "&quot;")
        .replace("'", "&#39;")
}

fn attr_source(a: HtmlAttr) -> string { " ${attr_text(a.name)}=\"${entities(a.value)}\"" }

fn op_source(op: HtmlOp) -> string {
    match op {
        .Open(tag, attrs) -> "<${tag_text(tag)}${[attr_source(a) for a in attrs].join("")}>",
        .Close(tag) -> "</${tag_text(tag)}>",
        .Text(content) -> entities(content),
    }
}

/// A document's ops as HTML source.
export fn source(ops: List<HtmlOp>) -> string { [op_source(o) for o in ops].join("") }
