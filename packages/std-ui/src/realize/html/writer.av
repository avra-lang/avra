//! `realize/html/writer.av` — the typed HTML writer. A document is a list
//! of OPS — open, close, text — never a format string; `source` serializes
//! them, escaping every text run and keeping every element name to what a
//! tag may be. UI.md §19.1.
use @std.text.{codepoints, from_codepoints}

/// One piece of a document, in drawing order.
export enum HtmlOp {
    Open(name: string, key: string?)
    Close(name: string)
    Text(content: string)
}

/// The five characters that end a text or attribute context, as entities.
fn entities(s: string) -> string {
    s
        .replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace("\"", "&quot;")
        .replace("'", "&#39;")
}

/// An attribute value: escaped and double-quoted, so it cannot end its
/// attribute.
fn escape_attr(s: string) -> string { "\"${entities(s)}\"" }

/// A node's key as an attribute, when it has one.
fn key_attr(key: string?) -> string {
    match key {
        k? -> " data-key=${escape_attr(k)}"
        null -> ""
    }
}

/// Whether a character may stand in an element name: letters, digits or
/// `-`. Everything else is dropped.
fn tag_char(c: int) -> bool {
    c >= 97 && c <= 122 || c >= 65 && c <= 90 || c >= 48 && c <= 57 || c == 45
}

/// A name kept to what a tag may be, so a name from outside cannot end
/// the tag or open an attribute.
fn safe_name(name: string) -> string {
    from_codepoints([c for c in codepoints(name) if tag_char(c)])
}

fn op_source(op: HtmlOp) -> string {
    match op {
        .Open(name, key) -> "<${safe_name(name)}${key_attr(key)}>",
        .Close(name) -> "</${safe_name(name)}>",
        .Text(content) -> entities(content),
    }
}

/// A document's ops as HTML source.
export fn source(ops: List<HtmlOp>) -> string { [op_source(o) for o in ops].join("") }
