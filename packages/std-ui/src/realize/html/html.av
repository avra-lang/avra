//! `realize/html/html.av` — the HTML adapter. It enumerates the VOCABULARY,
//! never components: a table from `Prim` to a tag, a table from `Attribute`
//! to an attribute, and `Box` to one style declaration list. The walker is
//! the same for every tree. UI.md §19.2.
use realize.render.{Node, Prim, Attribute, content_of, level_of}
use realize.html.tags.{HtmlTag, HtmlAttr, HtmlAttrName}
use realize.html.writer.{HtmlOp, source}
use env.{Env, Direction}
use style.box.{Box}
use style.theme.{Theme, space_of, radius_of, color_of, face_of}
use style.layout.{Axis, Align, Distribute, Sizing, Edge, Layout}
use style.style.{Style}
use ui.{Size, Tone, Font}

/// The HTML target: an accumulator of ops and the environment it draws in.
export type Html = { ops: Cell<List<HtmlOp>> = Cell.new([]), env: Env = Env {} }

// ── the primitive table ─────────────────────────────────────────

fn heading_tag(rank: int) -> HtmlTag {
    let r = if rank < 1 { 1 } else if rank > 6 { 6 } else { rank }
    let tags: List<HtmlTag> = [.H1, .H2, .H3, .H4, .H5, .H6]
    tags[r - 1]
}

fn tag_of(p: Prim, attrs: List<Attribute>) -> HtmlTag {
    match p {
        .Text -> .Span,
        .Heading -> heading_tag(level_of(attrs)),
        .Button -> .Button,
        .Link -> .A,
        .Image -> .Img,
        .Field or .Checkbox -> .Input,
        .Row or .Column -> .Div,
        .Dialog -> .Dialog,
    }
}

// ── the attribute table ─────────────────────────────────────────

/// A component property as an HTML attribute, or nothing (content and
/// levels are drawn, not attached). Every arm spelled.
fn attr_list(a: Attribute) -> List<HtmlAttr> {
    match a {
        .Value(v) -> [HtmlAttr { name: .Value, value: v }],
        .Placeholder(t) -> [HtmlAttr { name: .Placeholder, value: t }],
        .Src(u) -> [HtmlAttr { name: .Src, value: u }],
        .Disabled(flag) -> if flag { [HtmlAttr { name: .Disabled, value: "" }] } else { [] },
        .Checked(flag) -> if flag { [HtmlAttr { name: .Checked, value: "" }] } else { [] },
        .Text(_) or .Label(_) or .Level(_) or .Alt(_) -> [],
    }
}

fn attrs_of(attrs: List<Attribute>) -> List<HtmlAttr> {
    [h for a in attrs for h in attr_list(a)]
}

// ── the box table ───────────────────────────────────────────────

fn decl(parts: List<string>) -> string { [p for p in parts if p != ""].join(";") }

fn color_decl(c: Tone?, t: Theme) -> string {
    match c {
        v? -> "color:${color_of(t, v)}"
        null -> ""
    }
}

fn fill_decl(c: Tone?, t: Theme) -> string {
    match c {
        v? -> "background:${color_of(t, v)}"
        null -> ""
    }
}

fn radius_decl(z: Size?, t: Theme) -> string {
    match z {
        v? -> "border-radius:${radius_of(t, v)}px"
        null -> ""
    }
}

fn face_decl(f: Font?, t: Theme) -> string {
    match f {
        v? -> "font-family:${face_of(t, v)}"
        null -> ""
    }
}

fn axis_decl(a: Axis?) -> string {
    match a {
        v? -> axis_one(v)
        null -> ""
    }
}

fn axis_one(a: Axis) -> string {
    match a {
        .Row -> "display:flex;flex-direction:row",
        .Column -> "display:flex;flex-direction:column",
    }
}

fn gap_decl(z: Size?, t: Theme) -> string {
    match z {
        v? -> "gap:${space_of(t, v)}px"
        null -> ""
    }
}

fn pad_one(e: Edge, t: Theme, dir: Direction) -> string {
    let s = e.start ?? Size.None
    let en = e.end ?? Size.None
    let top = e.top ?? Size.None
    let bot = e.bottom ?? Size.None
    let left = if dir == Direction.Ltr { s } else { en }
    let right = if dir == Direction.Ltr { en } else { s }
    "padding:${space_of(t, top)}px ${space_of(t, right)}px ${space_of(t, bot)}px ${space_of(t, left)}px"
}

fn pad_decl(e: Edge?, t: Theme, dir: Direction) -> string {
    match e {
        v? -> pad_one(v, t, dir)
        null -> ""
    }
}

fn align_one(a: Align) -> string {
    match a {
        .Start -> "align-items:flex-start",
        .Center -> "align-items:center",
        .End -> "align-items:flex-end",
        .Stretch -> "align-items:stretch",
        .Baseline -> "align-items:baseline",
    }
}

fn align_decl(a: Align?) -> string {
    match a {
        v? -> align_one(v)
        null -> ""
    }
}

fn distribute_one(d: Distribute) -> string {
    match d {
        .Start -> "justify-content:flex-start",
        .Center -> "justify-content:center",
        .End -> "justify-content:flex-end",
        .SpaceBetween -> "justify-content:space-between",
        .SpaceAround -> "justify-content:space-around",
        .SpaceEvenly -> "justify-content:space-evenly",
    }
}

fn distribute_decl(d: Distribute?) -> string {
    match d {
        v? -> distribute_one(v)
        null -> ""
    }
}

fn sizing_one(prop: string, s: Sizing) -> string {
    match s {
        .Hug -> "",
        .Fill -> "${prop}:100%",
        .Fixed(n) -> "${prop}:${n}px",
        .Percent(_) -> "",
    }
}

fn sizing_decl(prop: string, s: Sizing?) -> string {
    match s {
        v? -> sizing_one(prop, v)
        null -> ""
    }
}

fn grow_decl(n: int) -> string { if n > 0 { "flex-grow:${n}" } else { "" } }

fn layout_css(l: Layout, t: Theme, dir: Direction) -> string {
    decl(
        [
            axis_decl(l.direction),
            gap_decl(l.gap, t),
            pad_decl(l.pad, t, dir),
            align_decl(l.align),
            distribute_decl(l.distribute),
            sizing_decl("width", l.width),
            sizing_decl("height", l.height),
            grow_decl(l.grow),
        ],
    )
}

fn appearance_css(s: Style, t: Theme) -> string {
    decl(
        [
            color_decl(s.color, t),
            fill_decl(s.fill, t),
            radius_decl(s.radius, t),
            face_decl(s.face, t),
        ],
    )
}

fn box_attrs(n: Node, env: Env) -> List<HtmlAttr> {
    let css_text = decl(
        [layout_css(n.box.layout, env.theme, env.direction), appearance_css(n.box.style, env.theme)],
    )
    let keyed: List<HtmlAttr> = match n.box.key {
        k? -> [HtmlAttr { name: .DataKey, value: k }]
        null -> []
    }
    if css_text == "" { keyed } else { keyed.concat([HtmlAttr { name: .Style, value: css_text }]) }
}

// ── the walker ──────────────────────────────────────────────────

fn draw(n: Node, h: Html) {
    let tag = tag_of(n.prim, n.attrs)
    h.ops.push(HtmlOp.Open(tag, attrs_of(n.attrs).concat(box_attrs(n, h.env))))
    h.ops.push(HtmlOp.Text(content_of(n.attrs)))
    for c in n.children { draw(c, h) }
    h.ops.push(HtmlOp.Close(tag))
}

/// The finished document for one tree, in one environment.
export fn render(root: Node, env: Env) -> string {
    let h = Html { env: env }
    draw(root, h)
    source(h.ops.get())
}
