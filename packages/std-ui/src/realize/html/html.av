//! `realize/html/html.av` — the HTML adapter. It enumerates the VOCABULARY,
//! never components: a table from `Prim` to a tag, a table from `Attribute`
//! to an attribute, and `Box` to the atomic classes its rules name. The
//! walker is the same for every tree; the class set is deduped per
//! document and the one stylesheet is emitted beside it.
//!
//! Every value is escaped by the writer for the context it lands in, and
//! a URL arrives as a `Url`, which has no unsafe value. A control holds no
//! content, so it sits under a `label` beside its words.
use tree.node.{Node}
use realize.html.tags.{HtmlAttr}
use realize.html.element.{Element, lowered}
use realize.html.writer.{HtmlOp, Head, Takeover, document, page_source, source, takeover_source}
use realize.html.print.{print_of}
use realize.html.css.{CssRule, CssVar, distinct_rules, page_sheet, rules_of}
use tree.lists.{flatten}
use style.theme.{Theme}
use env.{Env}

// ── the page ────────────────────────────────────────────────────

/// What a run of elements draws: the writer's ops, and the custom properties
/// each element that writes any carries, in document order. An element's
/// `data-v` is its place in that list, which the sheet's rule for it names.
type Drawn = { ops: List<HtmlOp>, vars: List<List<CssVar>> }

/// The elements as ops, the first of them standing after `before` that
/// write custom properties.
/// TWO RUNS OF TEXT SIDE BY SIDE WOULD BE ONE NODE TO A PARSER, so a marker
/// stands between them: the DOM holds the elements the lowering made, in its
/// order, and an adopted page's numbers count out the same.
fn drawn_all(es: List<Element>, before: int) -> Drawn {
    mut ops: List<HtmlOp> = []
    mut vars: List<List<CssVar>> = []
    mut prev_text = false
    for e in es {
        let text = is_text(e)
        if text && prev_text { ops = ops.concat([HtmlOp.Marker]) }
        let d = drawn_one(e, before + vars.length)
        ops = ops.concat(d.ops)
        vars = vars.concat(d.vars)
        prev_text = text
    }
    Drawn { ops: ops, vars: vars }
}

fn is_text(e: Element) -> bool {
    match e { .Text(_) -> true, .Tag(_) -> false }
}

/// One element as ops: opened, what it holds, closed.
fn drawn_one(e: Element, before: int) -> Drawn {
    match e {
        .Text(run) -> Drawn { ops: [HtmlOp.Text(run.content)], vars: [] },
        .Tag(el) -> {
            let own: List<List<CssVar>> = if el.vars.is_empty() { [] } else { [el.vars] }
            let kids = drawn_all(el.kids, before + own.length)
            Drawn {
                ops: [HtmlOp.Open(el.tag, el.attrs.concat(vars_attr(own, before)))]
                    .concat(kids.ops)
                    .concat([HtmlOp.Close(el.tag)]),
                vars: own.concat(kids.vars),
            }
        },
    }
}

/// The attribute that ties an element to its rule in the sheet, when it has one.
fn vars_attr(own: List<List<CssVar>>, at: int) -> List<HtmlAttr> {
    if own.is_empty() { [] } else { [HtmlAttr { name: .DataV, value: "${at}" }] }
}

/// A tree as the writer's ops and the custom properties it writes.
fn drawn(root: Node) -> Drawn { drawn_all(lowered(root), 0) }

/// A run of elements as the writer's ops alone.
fn run_ops(run: List<Element>) -> List<HtmlOp> { drawn_all(run, 0).ops }

/// The rule that writes one element's custom properties.
fn vars_rule(at: int, vars: List<CssVar>) -> string {
    let props = ["${v.property()}:${v.value}" for v in vars].join(";")
    "[data-v=\"${at}\"]{${props}}"
}

/// A tree's sheet: the atomic rules and the theme, then the rule that writes
/// each element's custom properties. The sheet is the one place a value
/// lives, so no element carries a `style` attribute.
fn sheet_of(root: Node, theme: Theme, alternates: List<Theme>, d: Drawn) -> string {
    [page_sheet(distinct_rules(rules_of(root)), theme, alternates)]
        .concat([vars_rule(i, vs) for i, vs in d.vars])
        .join("\n")
}

/// The tree alone as HTML: no stylesheet, no document around it.
export fn fragment(root: Node) -> string { source(drawn(root).ops) }

/// The finished document for one tree: its one stylesheet, then its body.
export fn render(root: Node, env: Env) -> string {
    let d = drawn(root)
    document(sheet_of(root, env.theme, [], d), null, d.ops)
}

/// What a whole page says about itself. `alternates` are the themes the
/// reader's own settings may choose over the environment's, each under
/// the media query its mode names. A `nonce` marks the page's one `style`
/// element, for a policy that allows styles by nonce alone.
export type Page = { title: string, env: Env = Env {}, alternates: List<Theme> = [], nonce: string? = null }

/// A complete document with no script: the page's head, its one
/// stylesheet, then the tree.
export fn page(p: Page, root: Node) -> string {
    let d = drawn(root)
    page_source(
        Head { title: p.title, locale: p.env.locale, direction: p.env.direction },
        sheet_of(root, p.env.theme, p.alternates, d),
        p.nonce,
        d.ops,
    )
}

/// A page a module can ADOPT: the tree as HTML, the sheet the live page
/// draws for it, and the print both are folded to.
export type Hydration = { html: string, css: string, print: int }

/// The server's first frame for `root` under `theme`: what a page holds
/// before its module runs and what the module checks itself against.
export fn hydration(root: Node, theme: Theme) -> Hydration {
    let run = lowered(root)
    let css = page_sheet(distinct_rules(rules_of(root)), theme, [])
    Hydration { html: source(run_ops(run)), css: css, print: print_of(run, css) }
}

/// A complete document the module at `module` takes over: the tree drawn
/// for the first paint under the sheet the live page wears, stamped with the
/// print the module checks itself against. `host` is where the host's
/// scripts (`bootstrap.js`, `wasi.js`) are served.
export fn takeover(p: Page, root: Node, module: string, host: string) -> string {
    let run = lowered(root)
    let css = page_sheet(distinct_rules(rules_of(root)), p.env.theme, [])
    takeover_source(
        Head { title: p.title, locale: p.env.locale, direction: p.env.direction },
        css,
        run_ops(run),
        Takeover { print: print_of(run, css), module: module, host: host },
    )
}
