//! `realize/html/html.av` — the HTML adapter. It enumerates the VOCABULARY,
//! never components: a table from `Prim` to a tag, a table from `Attribute`
//! to an attribute, and `Box` to the atomic classes its rules name. The
//! walker is the same for every tree; the class set is deduped per
//! document and the one stylesheet is emitted beside it.
//!
//! Every value is escaped by the writer for the context it lands in, and
//! a URL arrives as a `Url`, which has no unsafe value. A control holds no
//! content, so it sits under a `label` beside its words.
use tree.node.{Node}
use realize.html.element.{Element, lowered}
use realize.html.writer.{HtmlOp, Head, Takeover, document, page_source, source, takeover_source}
use realize.html.print.{print_of}
use tree.lists.{flatten}
use realize.html.css.{CssRule, distinct_rules, node_rules, page_sheet}
use style.theme.{Theme}
use env.{Env}

// ── the page ────────────────────────────────────────────────────

/// One element as the writer's ops: opened, what it holds, closed.
fn ops(e: Element) -> List<HtmlOp> {
    match e {
        .Text(run) -> [HtmlOp.Text(run.content)],
        .Tag(el) -> [HtmlOp.Open(el.tag, el.attrs)].concat(run_ops(el.kids)).concat([HtmlOp.Close(el.tag)]),
    }
}

/// A run of siblings as ops. Two runs of text side by side would be ONE text
/// node to a parser, so a marker stands between them: the DOM holds the
/// elements the lowering made, in its order.
fn run_ops(run: List<Element>) -> List<HtmlOp> {
    flatten([marked_ops(run, j) for j in 0..run.length])
}

fn marked_ops(run: List<Element>, j: int) -> List<HtmlOp> {
    let before = if j > 0 && is_text(run[j]) && is_text(run[j - 1]) { [HtmlOp.Marker] } else { [] }
    before.concat(ops(run[j]))
}

fn is_text(e: Element) -> bool {
    match e { .Text(_) -> true, .Tag(_) -> false }
}

/// A tree as the writer's ops.
fn drawn(root: Node) -> List<HtmlOp> { run_ops(lowered(root)) }

/// Every rule a tree's nodes name, in walk order.
fn rules_of(n: Node) -> List<CssRule> {
    node_rules(n.prim, n.box).concat([r for c in n.children for r in rules_of(c)])
}

/// The tree alone as HTML: no stylesheet, no document around it.
export fn fragment(root: Node) -> string { source(drawn(root)) }

/// The finished document for one tree: its one stylesheet, then its body.
export fn render(root: Node, env: Env) -> string {
    document(page_sheet(distinct_rules(rules_of(root)), env.theme, []), drawn(root))
}

/// What a whole page says about itself. `alternates` are the themes the
/// reader's own settings may choose over the environment's, each under
/// the media query its mode names.
export type Page = { title: string, env: Env = Env {}, alternates: List<Theme> = [] }

/// What a page's head says: its title and the environment's words.
fn head_of(p: Page) -> Head { Head { title: p.title, locale: p.env.locale, direction: p.env.direction } }

/// A complete document with no script: the page's head, its one
/// stylesheet, then the tree.
export fn page(p: Page, root: Node) -> string {
    page_source(
        head_of(p),
        page_sheet(distinct_rules(rules_of(root)), p.env.theme, p.alternates),
        drawn(root),
    )
}

/// A page a module can ADOPT: the tree as HTML, the sheet the live page
/// draws for it, and the print both are folded to.
export type Hydration = { html: string, css: string, print: int }

/// The server's first frame for `root` under `theme`: what a page holds
/// before its module runs and what the module checks itself against.
export fn hydration(root: Node, theme: Theme) -> Hydration {
    let run = lowered(root)
    let css = page_sheet(distinct_rules(rules_of(root)), theme, [])
    Hydration { html: source(run_ops(run)), css: css, print: print_of(run, css) }
}

/// A complete document the module at `module` takes over: the tree drawn
/// for the first paint under the sheet the live page wears, stamped with the
/// print the module checks itself against. `host` is where the host's
/// scripts (`bootstrap.js`, `wasi.js`) are served.
export fn takeover(p: Page, root: Node, module: string, host: string, state: string = "") -> string {
    let run = lowered(root)
    let css = page_sheet(distinct_rules(rules_of(root)), p.env.theme, [])
    takeover_source(
        head_of(p),
        css,
        run_ops(run),
        Takeover { print: print_of(run, css), module: module, host: host, state: state },
    )
}
