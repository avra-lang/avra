//! `realize/html/html.av` — the HTML adapter. It enumerates the VOCABULARY,
//! never components: a table from `Prim` to a tag, a table from `Attribute`
//! to an attribute, and `Box` to the atomic classes its rules name. The
//! walker is the same for every tree; the class set is deduped per
//! document and the one stylesheet is emitted beside it. UI.md §19.2.
use realize.render.{Node, Attribute}
use realize.sink.{Sink, draw}
use realize.html.tags.{HtmlTag, HtmlAttr, HtmlAttrName, tag_of}
use realize.html.writer.{HtmlOp, document}
use realize.html.css.{CssRule, distinct_rules, class_names, stylesheet}
use env.{Env}

/// The HTML target: an accumulator of ops, the rules the tree named, and
/// the environment it draws in.
export type Html = {
    ops: Cell<List<HtmlOp>> = Cell.new([]),
    env: Env = Env {},
    rules: Cell<List<CssRule>> = Cell.new([]),
}

// ── the attribute table ─────────────────────────────────────────

/// A component property as an HTML attribute, or nothing (content and
/// levels are drawn, not attached). Every arm spelled.
fn attr_list(a: Attribute) -> List<HtmlAttr> {
    match a {
        .Value(v) -> [HtmlAttr { name: .Value, value: v }],
        .Amount(n) -> [HtmlAttr { name: .Value, value: "${n}" }],
        .Placeholder(t) -> [HtmlAttr { name: .Placeholder, value: t }],
        .Src(u) -> [HtmlAttr { name: .Src, value: u }],
        .Alt(t) -> [HtmlAttr { name: .Alt, value: t }],
        .Href(u) -> [HtmlAttr { name: .Href, value: u }],
        .Min(n) -> [HtmlAttr { name: .Min, value: "${n}" }],
        .Max(n) -> [HtmlAttr { name: .Max, value: "${n}" }],
        .Disabled(flag) -> if flag { [HtmlAttr { name: .Disabled, value: "" }] } else { [] },
        .Checked(flag) -> if flag { [HtmlAttr { name: .Checked, value: "" }] } else { [] },
        .Selected(flag) -> if flag { [HtmlAttr { name: .AriaSelected, value: "true" }] } else { [] },
        .Open(flag) -> if flag { [HtmlAttr { name: .Open, value: "" }] } else { [] },
        .Invalid(flag) -> if flag { [HtmlAttr { name: .AriaInvalid, value: "true" }] } else { [] },
        .Loading(flag) -> if flag { [HtmlAttr { name: .AriaBusy, value: "true" }] } else { [] },
        .Urgency(u) -> [HtmlAttr { name: .AriaLive, value: u.word() }],
        .Title(t) -> [HtmlAttr { name: .Title, value: t }],
        .Name(t) or .Label(t) -> [HtmlAttr { name: .AriaLabel, value: t }],
        .Text(_) or .Level(_) -> [],
    }
}

fn attrs_of(attrs: List<Attribute>) -> List<HtmlAttr> {
    [h for a in attrs for h in attr_list(a)]
}

// ── the class attribute ─────────────────────────────────────────

fn class_attrs(n: Node) -> List<HtmlAttr> {
    let names = class_names(n)
    if names.is_empty() { [] } else { [HtmlAttr { name: .Class, value: names.join(" ") }] }
}

/// A node's own attributes: its identity, its classes, its box.
fn node_attrs(n: Node) -> List<HtmlAttr> {
    let keyed: List<HtmlAttr> = match n.box.key {
        k? -> [HtmlAttr { name: .DataKey, value: k }]
        null -> []
    }
    keyed.concat(class_attrs(n))
}

// ── the walker ──────────────────────────────────────────────────

impl Sink for Html {
    fn opened(n: Node) {
        // LICENSED loops.push_loop: the rules ride a shared Cell; a concat assignment would rebind a copy
        for r in distinct_rules(n.box.rules()) { self.rules.push(r) }
        self.ops.push(HtmlOp.Open(tag_of(n), attrs_of(n.attrs).concat(node_attrs(n))))
    }
    fn words(s: string) { self.ops.push(HtmlOp.Text(s)) }
    fn closed(n: Node) { self.ops.push(HtmlOp.Close(tag_of(n))) }
}

/// The finished document for one tree: its one stylesheet, then its body.
export fn render(root: Node, env: Env) -> string {
    let h = Html { env: env }
    draw(root, h)
    document(stylesheet(distinct_rules(h.rules.get()), env.theme), h.ops.get())
}
