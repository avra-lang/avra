// A field's return key, as a page draws it: a field that hears its own submit wears a key that says
// what it does — its label, Done where none is written — and one that hears none wears no hint.
use @std.ui.components.{field}
use @std.ui.tree.view.{tree_of}
use @std.ui.realize.html.html.{fragment}

spec "std/ui html — a field's return key" {
    given "a field" {
        then "one that hears its submit wears a return key that says Done" {
            fragment(tree_of(field "Task" { on submit {} })).contains("enterkeyhint=\"done\"")
        }
        then "its key says the label written for it" {
            fragment(
                tree_of(
                    field "Find" {
                        submit_label: .Search
                        on submit {}
                    },
                ),
            )
                .contains("enterkeyhint=\"search\"")
        }
        then "one that hears no submit wears no hint, so its key is the keyboard's own" {
            !fragment(tree_of(field "Task" {})).contains("enterkeyhint")
        }
    }
}
