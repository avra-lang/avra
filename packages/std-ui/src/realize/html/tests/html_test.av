// Each primitive's exact HTML, the look as atomic classes, nesting, the
// stylesheet and the page. Trees are neutral nodes, so no component is
// involved.
use @std.ui.tree.node.{Node, Prim, Attribute}
use @std.ui.realize.html.html.{fragment, render, page, Page}
use @std.ui.env.{Env}
use @std.ui.realize.html.css.{all_rules, class_names}
use @std.text.{codepoints}
use @std.ui.style.box.{Box}
use @std.ui.style.layout.{Layout, around}
use @std.ui.style.style.{Style}
use @std.ui.style.theme.{dark_theme, high_contrast_theme}
use @std.ui.realize.tests.support.{
    served_at,
    leaf,
    boxed,
    holding,
    keyed,
    with_kids,
    gap,
    text_node,
    heading_node,
    image_node,
    link_node,
    button_node,
    switch_node,
    field_node,
    card_node,
}

fn styled(s: Style) -> Node { Node { prim: .Text, attrs: [.Text("x")], box: Box { style: s }, children: [] } }

fn tree() -> Node {
    boxed(
        .Column,
        Layout { gap: .M, pad: around(.S) },
        [heading_node("Tasks", 1), holding(.Row, [text_node("one"), button_node("Add")])],
    )
}

/// The stylesheet a document carries.
fn css_of(document: string) -> string { document.split("<style>")[1].split("</style>")[0] }

fn sheet() -> string { css_of(render(tree(), Env {})) }

fn count(hay: string, needle: string) -> int { hay.split(needle).length - 1 }

spec "std/ui html — primitives" {
    given "each primitive" {
        then "a text is a span of its words" { fragment(text_node("hi")) == "<span>hi</span>" }
        then "a heading takes its level" { fragment(heading_node("T", 3)) == "<h3>T</h3>" }
        then "a heading level below one is h1" {
            fragment(heading_node("T", 0)) == "<h1>T</h1>" &&
                fragment(heading_node("T", -4)) == "<h1>T</h1>"
        }
        then "a heading level above six is h6" {
            fragment(heading_node("T", 7)) == "<h6>T</h6>" &&
                fragment(heading_node("T", 6)) == "<h6>T</h6>"
        }
        then "an image carries its picture and alt and is never closed" {
            fragment(image_node("/a.png", "A")) == "<img src=\"/assets/${served_at("/a.png")}\" width=\"10\" height=\"10\" alt=\"A\">"
        }
        then "an image with an empty alt still carries alt" {
            fragment(image_node("/a.png", "")) == "<img src=\"/assets/${served_at("/a.png")}\" width=\"10\" height=\"10\" alt=\"\">"
        }
        then "a link carries its name, its escaped href and its label" {
            fragment(link_node("go", "https://x.dev/a?b=1&c=2")) == "<a aria-label=\"go\" href=\"https://x.dev/a?b=1&amp;c=2\">go</a>"
        }
        then "a button holds its label" { fragment(button_node("Add")) == "<button type=\"button\" aria-label=\"Add\">Add</button>" }
        then "a switch that is on is a checked switch input under a label" {
            fragment(switch_node("Dark", true)) == "<label><input type=\"checkbox\" role=\"switch\" aria-label=\"Dark\" checked=\"\"><span>Dark</span></label>"
        }
        then "a switch that is off carries no checked attribute" {
            fragment(switch_node("Dark", false)) == "<label><input type=\"checkbox\" role=\"switch\" aria-label=\"Dark\"><span>Dark</span></label>"
        }
        then "a checkbox is a checkbox input under a label" {
            fragment(leaf(.Checkbox, [.Label("Done"), .Checked(true)])) == "<label><input type=\"checkbox\" aria-label=\"Done\" checked=\"\"><span>Done</span></label>"
        }
        then "a field is a text input holding its value, its label before it" {
            fragment(field_node("Name", "Ann")) == "<label><span>Name</span><input type=\"text\" aria-label=\"Name\" value=\"Ann\"></label>"
        }
        then "a masked field is a password input that never writes its value" {
            fragment(leaf(.Field, [.Label("Pin"), .Value("4321"), .Masked(true)])) == "<label><span>Pin</span><input type=\"password\" aria-label=\"Pin\"></label>"
        }
        then "a slider is a range input, its label before it" {
            fragment(leaf(.Slider, [.Label("Vol"), .Amount(4), .Min(0), .Max(9)])) == "<label><span>Vol</span><input type=\"range\" aria-label=\"Vol\" value=\"4\" min=\"0\" max=\"9\"></label>"
        }
        then "a progress follows its label, both under a label" {
            fragment(leaf(.Progress, [.Label("Up"), .Amount(3), .Max(10)])) == "<label><span>Up</span><progress aria-label=\"Up\" value=\"3\" max=\"10\"></progress></label>"
        }
        then "a divider is a rule that is never closed" { fragment(leaf(.Divider, [])) == "<hr>" }
        then "a card shows its title as a heading over its children" {
            fragment(card_node("T", [text_node("x")])) == "<article title=\"T\" class=\"dir-col\"><h2>T</h2><span>x</span></article>"
        }
        then "an empty card keeps its title" { fragment(card_node("T", [])) == "<article title=\"T\" class=\"dir-col\"><h2>T</h2></article>" }
        then "a card given no title has no heading" { fragment(holding(.Card, [])) == "<article class=\"dir-col\"></article>" }
        then "a card's appearance classes sit on its own element" {
            fragment(card_node("T", []) with { box: Box { style: Style { fill: .Surface } } }) == "<article title=\"T\" class=\"dir-col fill-surface\"><h2>T</h2></article>"
        }
        then "a keyed item carries its identity" {
            fragment(keyed(holding(.Item, [text_node("x")]), "a")) == "<li data-key=\"a\"><span>x</span></li>"
        }
        then "an unkeyed item carries none" { fragment(leaf(.Item, [])) == "<li></li>" }
        then "an empty key is still a key" { fragment(keyed(leaf(.Item, []), "")) == "<li data-key=\"\"></li>" }
        then "a list holds its items in order" {
            fragment(holding(.List, [keyed(leaf(.Item, []), "a"), leaf(.Item, [])])) == "<ul><li data-key=\"a\"></li><li></li></ul>"
        }
        then "a control's key and classes sit on its label, its attributes on the control" {
            fragment(keyed(boxed(.Field, gap(.M), []), "k")) == "<label data-key=\"k\" class=\"gap-m\"><span></span><input type=\"text\"></label>"
        }
    }
    given "the look" {
        then "style tokens become atomic classes in rule order" {
            fragment(styled(Style { color: .Muted, face: .Body })) == "<span class=\"color-muted face-body\">x</span>"
        }
        then "every appearance token names its own class" {
            fragment(
                styled(Style { radius: .L, fill: .SurfaceRaised, color: .Danger, face: .Mono }),
            ) == "<span class=\"color-danger fill-surface-raised radius-l face-mono\">x</span>"
        }
        then "a column flows down, its axis class first" {
            fragment(boxed(.Column, gap(.M), [])) == "<div class=\"dir-col gap-m\"></div>"
        }
        then "a row flows across, its axis class first" {
            fragment(boxed(.Row, gap(.Xl), [])) == "<div class=\"dir-row gap-xl\"></div>"
        }
        then "a row that names no gap keeps a step between its children" {
            fragment(holding(.Row, [])) == "<div class=\"dir-row gap-s\"></div>"
        }
        then "a row made a column keeps none: nothing shares a line" {
            fragment(boxed(.Row, Layout { direction: .Column }, [])) == "<div class=\"dir-col\"></div>"
        }
        then "a column made a row keeps a step" {
            fragment(boxed(.Column, Layout { direction: .Row }, [])) == "<div class=\"gap-s dir-row\"></div>"
        }
        then "a box is ticked and then named: its control stands first" {
            fragment(leaf(.Checkbox, [.Label("c")])) == "<label><input type=\"checkbox\" aria-label=\"c\"><span>c</span></label>" &&
                fragment(leaf(.Switch, [.Label("s")]))
                    .starts_with("<label><input type=\"checkbox\" role=\"switch\"")
        }
        then "a layout's direction replaces a row's own axis" {
            fragment(boxed(.Row, Layout { direction: .Column }, [])) == "<div class=\"dir-col\"></div>"
        }
        then "what stacks its children is a column, so its gap is drawn" {
            [Prim.Surface, .Form, .Card, .Dialog]
                .all((p) -> fragment(boxed(p, gap(.M), [])).contains("class=\"dir-col gap-m\""))
        }
        then "an item flows as its element does and keeps its marker" { fragment(leaf(.Item, [])) == "<li></li>" }
        then "a pad names one class per logical edge" {
            fragment(boxed(.Column, Layout { pad: around(.S) }, [])) == "<div class=\"dir-col pis-s pie-s pt-s pb-s\"></div>"
        }
    }
    given "nesting" {
        then "children recurse in order" {
            fragment(tree()) == "<div class=\"dir-col gap-m pis-s pie-s pt-s pb-s\"><h1>Tasks</h1><div class=\"dir-row gap-s\"><span>one</span><button type=\"button\" aria-label=\"Add\">Add</button></div></div>"
        }
        then "a child given to an image follows it, never inside it" {
            fragment(with_kids(image_node("/a.png", "A"), [text_node("y")])) == "<img src=\"/assets/${served_at("/a.png")}\" width=\"10\" height=\"10\" alt=\"A\"><span>y</span>"
        }
        then "a child given to a control stays inside its label" {
            fragment(with_kids(field_node("N", ""), [text_node("y")])) == "<label><span>N</span><input type=\"text\" aria-label=\"N\" value=\"\"><span>y</span></label>"
        }
    }
    given "the stylesheet" {
        then "it names every space and radius step" {
            ["none", "xs", "s", "m", "l", "xl"]
                .all((z) -> sheet().contains("--space-${z}:") && sheet().contains("--radius-${z}:"))
        }
        then "it names every tone" {
            [
                "text",
                "muted",
                "danger",
                "surface",
                "surface-raised",
                "surface-sunk",
                "surface-hover",
            ]
                .all((t) -> sheet().contains("--tone-${t}:"))
        }
        then "it names every face" { ["body", "heading", "footnote", "mono"].all((f) -> sheet().contains("--face-${f}:")) }
        then "the page's base reads the surface, the text tone and the body face" {
            sheet()
                .contains(
                    "body{margin:0;overflow-wrap:break-word;background:var(--tone-surface);color:var(--tone-text);font-family:var(--face-body)}",
                )
        }
        then "the axis classes are flex" {
            sheet().contains(".dir-col{display:flex;flex-direction:column}") &&
                sheet().contains(".dir-row{display:flex;flex-direction:row}")
        }
        then "atomic rules read the variables" {
            sheet().contains(".gap-m{gap:var(--space-m)}") &&
                sheet().contains(".pis-s{padding-inline-start:var(--space-s)}")
        }
        then "every class the tree names has exactly one rule" {
            ["dir-col", "dir-row", "gap-m", "pis-s", "pie-s", "pt-s", "pb-s"]
                .all((c) -> count(sheet(), ".${c}{") == 1)
        }
        then "it holds the variables, the eleven base rules and one line per class the tree named" {
            sheet().split("\n").length == 1 + 11 + 8
        }
        then "a button shows what it stands on inside a border, so a fill it names is the fill a reader sees" {
            sheet()
                .contains(
                    "\nbutton{background:transparent;border:1px solid var(--tone-muted);padding:var(--space-xs) var(--space-s)}\n",
                )
        }
        then "a button that cannot speak is muted" { sheet().contains("\nbutton:disabled{color:var(--tone-muted)}\n") }
        then "what an item holds on one line stands a step apart, and the item keeps its marker" {
            sheet()
                .contains("\nli:not(.dir-row):not(.dir-col)>*+*{margin-inline-start:var(--space-s)}\n")
        }
        then "the variables say which scheme the browser's own controls wear" {
            sheet().starts_with(":root{color-scheme:light;") &&
                render(tree(), Env { theme: dark_theme }).contains(":root{color-scheme:dark;")
        }
        then "a control wears the page's ink and face, never the browser's" {
            sheet().contains("\nbutton,input{font:inherit;color:inherit}\n")
        }
        then "a heading and a rule keep no margin" { sheet().contains("\nh1,h2,h3,h4,h5,h6,hr{margin:0}\n") }
        then "a control and its words sit on one line, a step apart" {
            sheet()
                .contains("\nlabel{display:inline-flex;align-items:center;gap:var(--space-xs)}\n")
        }
        then "a dialog wears the surface, and a closed one is not drawn whatever its classes say" {
            sheet()
                    .contains(
                        "\ndialog{position:fixed;inset-block:0;background:var(--tone-surface);color:var(--tone-text)}\n",
                    ) &&
                sheet().contains("\ndialog:not([open]){display:none}")
        }
        then "two renders of one tree are equal" { render(tree(), Env {}) == render(tree(), Env {}) }
        then "it holds no `<`" { !sheet().contains("<") }
    }
    given "the page" {
        then "it is a complete document around the tree" {
            let out = page(Page { title: "T" }, text_node("x"))
            out
                    .starts_with(
                        "<!doctype html><html lang=\"en\" dir=\"ltr\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>T</title><style>:root{",
                    ) &&
                out.ends_with("</style></head><body><span>x</span></body></html>")
        }
        then "it carries no script tag" { !page(Page { title: "T" }, tree()).contains("<script") }
        then "its language and direction are the environment's" {
            page(Page { title: "T", env: Env { locale: "ar", direction: .Rtl } }, tree())
                .contains("<html lang=\"ar\" dir=\"rtl\">")
        }
        then "its variables are the environment's theme" {
            css_of(page(Page { title: "T", env: Env { theme: dark_theme } }, tree()))
                    .contains(":root{") &&
                css_of(page(Page { title: "T", env: Env { theme: dark_theme } }, tree()))
                    .contains("--tone-surface:#121212")
        }
        then "with no alternate it holds no media query" { !page(Page { title: "T" }, tree()).contains("@media") }
        then "a dark alternate rewrites the variables under the dark scheme query, once" {
            let css = css_of(page(Page { title: "T", alternates: [dark_theme] }, tree()))
            count(css, "@media (prefers-color-scheme: dark){:root{") == 1 &&
                css.split("prefers-color-scheme: dark")[1].contains("--tone-text:#eeeeee") &&
                css.split("prefers-color-scheme: dark")[0].contains("--tone-text:#111111")
        }
        then "a high-contrast alternate sits under the contrast query" {
            css_of(page(Page { title: "T", alternates: [high_contrast_theme] }, tree()))
                .contains("@media (prefers-contrast: more){:root{")
        }
        then "the fragment is the page's body" {
            page(Page { title: "T" }, tree()).contains("<body>${fragment(tree())}</body>")
        }
    }
    given "sizes along an axis" {
        then "a fill takes the room that is left along its parent's axis and stretches across it" {
            let css = render(
                boxed(.Row, Layout {}, [boxed(.Column, Layout { width: .Fill, height: .Fill }, [])]),
                Env {},
            )
            css.contains("\n.dir-row>.w-fill{flex:var(--grow) 1 0%;min-width:0}") &&
                css.contains("\n.dir-col>.w-fill{align-self:stretch}") &&
                css.contains("\n.dir-col>.h-fill{flex:var(--grow) 1 0%;min-height:0}") &&
                css.contains("\n.dir-row>.h-fill{align-self:stretch}")
        }
        then "a fixed size holds along its parent's axis and is no more than its width elsewhere" {
            let css = render(
                boxed(
                    .Row,
                    Layout {},
                    [boxed(.Column, Layout { width: .Fixed(8), height: .Fixed(3) }, [])],
                ),
                Env {},
            )
            css.contains("\n.w-fixed{width:var(--w)}") &&
                css.contains("\n.dir-row>.w-fixed{flex-shrink:0}") &&
                css.contains("\n.h-fixed{height:var(--h)}") &&
                css.contains("\n.dir-col>.h-fixed{flex-shrink:0}")
        }
        then "a node that fills in both directions names its class once" {
            fragment(boxed(.Column, Layout { width: .Fill }, [])) == "<div class=\"dir-col w-fill\"></div>"
        }
        then "a growth given to a fill is its share" {
            render(boxed(.Row, Layout { grow: 3 }, []), Env {})
                .contains("\n.grow{flex-grow:var(--grow)}")
        }
        then "wrap, margin and order are written, an order by a class that reads its property" {
            let css = render(
                boxed(.Row, Layout { wrap: .WrapReverse, margin: around(.S), order: -2 }, []),
                Env {},
            )
            css.contains("\n.wrap-rev{flex-wrap:wrap-reverse}") &&
                css.contains("\n.mis-s{margin-inline-start:var(--space-s)}") &&
                css.contains("\n.order{order:var(--order)}")
        }
        then "every box is measured by its border" { sheet().contains("\n*,*::before,*::after{box-sizing:border-box}\n") }
        then "text breaks at spaces and a word longer than its line breaks where it must" {
            sheet().contains("\nbody{margin:0;overflow-wrap:break-word;")
        }
    }
}

spec "std/ui html — no value reaches a class name" {
    given "fixed sizes, a growth and an order" {
        then "a node names the classes that read them and the place of its rule in the sheet" {
            fragment(
                boxed(
                    .Column,
                    Layout { width: .Fixed(8), height: .Fixed(3), grow: 2, order: -2 },
                    [],
                ),
            ) == "<div class=\"dir-col w-fixed h-fixed grow order\" data-v=\"0\"></div>"
        }
        then "two nodes of different sizes are the same markup" {
            fragment(boxed(.Row, Layout { width: .Fixed(8) }, [])) == fragment(boxed(.Row, Layout { width: .Fixed(99) }, []))
        }
        then "a node that states none writes no style" {
            fragment(boxed(.Column, Layout { width: .Fill }, [])) == "<div class=\"dir-col w-fill\"></div>"
        }
    }
    given "the vocabulary" {
        then "every rule a node names is one of its rules" {
            let all = all_rules().map(it.name)
            let nodes = [
                boxed(
                    .Row,
                    Layout {
                        width: .Fixed(8),
                        grow: 3,
                        order: 1,
                        gap: .L,
                        align: .Center,
                        wrap: .Wrap,
                        pad: around(.M),
                    },
                    [],
                ),
                boxed(
                    .Column,
                    Layout { height: .Fill, margin: around(.S), distribute: .SpaceBetween },
                    [],
                ),
            ]
            nodes.all((n) -> class_names(n).all((c) -> all.contains(c)))
        }
        then "no class name carries a number" {
            !all_rules().any((r) -> codepoints(r.name).any((c) -> c >= 48 && c <= 57))
        }
    }
}

/// A column of fixed size over two rows, one fixed and one filling.
fn tall() -> Node {
    boxed(
        .Column,
        Layout { width: .Fixed(8), height: .Fixed(3), grow: 2, order: -2 },
        [boxed(.Row, Layout { width: .Fixed(5) }, []), boxed(.Row, Layout { width: .Fill }, [])],
    )
}

fn small() -> Node { boxed(.Row, Layout { width: .Fixed(8) }, []) }

spec "std/ui html — the sheet carries the values" {
    given "a page of nodes that state sizes" {
        then "each element that states any has a rule, numbered in document order" {
            let html = page(Page { title: "t" }, tall())
            html.contains("<div class=\"dir-col w-fixed h-fixed grow order\" data-v=\"0\">") &&
                html.contains("<div class=\"dir-row gap-s w-fixed\" data-v=\"1\">") &&
                html.contains("\n[data-v=\"0\"]{--w:8px;--h:3px;--grow:2;--order:-2}") &&
                html.contains("\n[data-v=\"1\"]{--w:5px}")
        }
        then "an element that states none has no rule and no number" {
            page(Page { title: "t" }, tall()).contains("<div class=\"dir-row gap-s w-fill\">")
        }
        then "no element carries a style attribute" { !page(Page { title: "t" }, tall()).contains("style=\"") }
    }
    given "a page under a policy that allows styles by nonce" {
        then "its one style element carries the nonce" {
            page(Page { title: "t", nonce: "n1" }, small()).contains("<style nonce=\"n1\">")
        }
        then "a nonce is escaped where it lands" {
            page(Page { title: "t", nonce: "a\"b" }, small()).contains("<style nonce=\"a&quot;b\">")
        }
        then "a page with no nonce writes a bare style element" {
            page(Page { title: "t" }, small()).contains("<style>")
        }
    }
}

spec "std/ui html — a shortcut" {
    given "a key node" {
        then "stands hidden and says its chord as a page's keydown reads it" {
            fragment(leaf(.Key, [.Label("ctrl+s")])) == "<div hidden=\"\" data-avra-chord=\"c/KeyS/s\" aria-label=\"ctrl+s\">ctrl+s</div>"
        }
        then "spells a named key as KeyboardEvent.key does, with every modifier it holds" {
            fragment(leaf(.Key, [.Label("ctrl+alt+shift+Up")]))
                    .contains("data-avra-chord=\"cas//ArrowUp\"") &&
                fragment(leaf(.Key, [.Label("F5")])).contains("data-avra-chord=\"//F5\"") &&
                fragment(leaf(.Key, [.Label("ctrl+Plus")])).contains("data-avra-chord=\"c//+\"")
        }
        then "says the place of a letter, a digit and a punctuation key as a US layout has it" {
            fragment(leaf(.Key, [.Label("ctrl+1")])).contains("data-avra-chord=\"c/Digit1/1\"") &&
                fragment(leaf(.Key, [.Label("ctrl+/")])).contains("data-avra-chord=\"c/Slash//\"") &&
                fragment(leaf(.Key, [.Label("alt+[")]))
                    .contains("data-avra-chord=\"a/BracketLeft/[\"")
        }
        then "with a chord that is none stands hidden and says none" {
            fragment(leaf(.Key, [.Label("ctrl+")])) == "<div hidden=\"\" aria-label=\"ctrl+\">ctrl+</div>"
        }
    }
}

/// A spacer standing for four unbuilt rows of twenty pixels each, which says no height of its own.
fn spacer() -> Node {
    Node { prim: .Item, attrs: [Attribute.Skipped("p", 4, 20)], box: Box {}, children: [] }
}

spec "std/ui html — a window's spacer" {
    given "a spacer standing for unbuilt rows" {
        then "stands as a fixed height its class reads, never as a style attribute" {
            let item = fragment(spacer())
            item.contains("h-fixed") &&
                item.contains("data-avra-skip=\"4\"") &&
                !item.contains("style=")
        }
        then "has its height in the page's sheet" { page(Page { title: "t" }, spacer()).contains("{--h:80px}") }
    }
}
