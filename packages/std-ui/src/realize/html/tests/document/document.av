// proves: the HTML target writes one tree alike evaluated and native — a
// control under its label, a refused URL, escaped words, the axis
// classes, and the page around them with its dark alternate.
use @std.ui.tree.node.{Node, Prim}
use @std.ui.realize.html.html.{fragment, page, Page}
use @std.ui.style.layout.{Layout, around}
use @std.ui.style.theme.{dark_theme}
use @std.ui.realize.tests.support.{
    leaf,
    boxed,
    holding,
    keyed,
    text_node,
    heading_node,
    image_node,
    link_node,
    button_node,
    switch_node,
    field_node,
    card_node,
}

let body = boxed(
    .Column,
    Layout { gap: .M, pad: around(.S) },
    [
        heading_node("Tasks <today>", 1),
        boxed(
            .Row,
            Layout { gap: .S },
            [field_node("New", "a \"quoted\" value"), button_node("Add")],
        ),
        card_node(
            "Open",
            [holding(.List, [keyed(holding(.Item, [switch_node("Water & feed", true)]), "t1")])],
        ),
        link_node("docs", "https://x.dev/a?b=1&c=2"),
        link_node("trap", "javascript:alert(1)"),
        image_node("data:image/png;base64,AA", "a pixel"),
        leaf(.Divider, []),
        text_node("done"),
    ],
)

println(fragment(body))
println(page(Page { title: "Tasks & more", alternates: [dark_theme] }, text_node("x")))
