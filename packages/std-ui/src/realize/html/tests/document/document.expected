<div class="dir-col gap-m pis-s pie-s pt-s pb-s"><h1>Tasks &lt;today&gt;</h1><div class="dir-row gap-s"><label><span>New</span><input type="text" aria-label="New" value="a &quot;quoted&quot; value"></label><button type="button" aria-label="Add">Add</button></div><article title="Open" class="dir-col"><h2>Open</h2><ul><li data-key="t1"><label><input type="checkbox" role="switch" aria-label="Water &amp; feed" checked=""><span>Water &amp; feed</span></label></li></ul></article><a aria-label="docs" href="https://x.dev/a?b=1&amp;c=2">docs</a><a aria-label="trap">trap</a><img alt="a pixel"><hr><span>done</span></div>
<!doctype html><html lang="en" dir="ltr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Tasks &amp; more</title><style>:root{color-scheme:light;--space-none:0px;--space-xs:4px;--space-s:8px;--space-m:16px;--space-l:32px;--space-xl:48px;--radius-none:0px;--radius-xs:2px;--radius-s:4px;--radius-m:8px;--radius-l:16px;--radius-xl:24px;--tone-text:#111111;--tone-muted:#666666;--tone-danger:#b00020;--tone-surface:#ffffff;--tone-surface-raised:#f7f7f7;--tone-surface-sunk:#ececec;--tone-surface-hover:#f0f0f0;--face-body:system-ui, sans-serif;--face-heading:system-ui, sans-serif;--face-footnote:system-ui, sans-serif;--face-mono:ui-monospace, monospace; }
@media (prefers-color-scheme: dark){:root{color-scheme:dark;--space-none:0px;--space-xs:4px;--space-s:8px;--space-m:16px;--space-l:32px;--space-xl:48px;--radius-none:0px;--radius-xs:2px;--radius-s:4px;--radius-m:8px;--radius-l:16px;--radius-xl:24px;--tone-text:#eeeeee;--tone-muted:#aaaaaa;--tone-danger:#ff6b6b;--tone-surface:#121212;--tone-surface-raised:#1e1e1e;--tone-surface-sunk:#0a0a0a;--tone-surface-hover:#2a2a2a;--face-body:system-ui, sans-serif;--face-heading:system-ui, sans-serif;--face-footnote:system-ui, sans-serif;--face-mono:ui-monospace, monospace; }}
body{margin:0;background:var(--tone-surface);color:var(--tone-text);font-family:var(--face-body)}
button,input{font:inherit;color:inherit}
button{background:transparent;border:1px solid var(--tone-muted);padding:var(--space-xs) var(--space-s)}
button:disabled{color:var(--tone-muted)}
h1,h2,h3,h4,h5,h6,hr{margin:0}
label{display:inline-flex;align-items:center;gap:var(--space-xs)}
li:not(.dir-row):not(.dir-col)>*+*{margin-inline-start:var(--space-s)}
dialog{position:fixed;inset-block:0;background:var(--tone-surface);color:var(--tone-text)}
dialog:not([open]){display:none}</style></head><body><span>x</span></body></html>
