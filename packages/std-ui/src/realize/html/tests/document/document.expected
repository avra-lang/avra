<div class="dir-col gap-m pis-s pie-s pt-s pb-s"><h1>Tasks &lt;today&gt;</h1><div class="dir-row gap-s"><label><span>New</span><input type="text" aria-label="New" value="a &quot;quoted&quot; value" dir="auto"></label><button type="button" aria-label="Add">Add</button></div><article title="Open" class="dir-col"><h2>Open</h2><ul><li data-key="t1"><label><input type="checkbox" role="switch" aria-label="Water &amp; feed" checked=""><span>Water &amp; feed</span></label></li></ul></article><a aria-label="docs" href="https://x.dev/a?b=1&amp;c=2">docs</a><a aria-label="trap">trap</a><img alt="a pixel"><hr><span>done</span></div>
<!doctype html><html lang="en" dir="ltr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Tasks &amp; more</title><style>:root{color-scheme:light dark;--space-none:0px;--space-xs:4px;--space-s:8px;--space-m:16px;--space-l:32px;--space-xl:48px;--radius-none:0px;--radius-xs:2px;--radius-s:3px;--radius-m:4px;--radius-l:6px;--radius-xl:12px;--tone-canvas:light-dark(#FFFFFF,#0A0A0A);--on-canvas:light-dark(#0A0A0A,#FAFAFA);--tone-surface:light-dark(#FFFFFF,#0A0A0A);--on-surface:light-dark(#0A0A0A,#FAFAFA);--tone-surface-raised:light-dark(#FFFFFF,#0A0A0A);--on-surface-raised:light-dark(#0A0A0A,#FAFAFA);--tone-surface-sunk:light-dark(#F2F2F2,#1C1C1C);--on-surface-sunk:light-dark(#0A0A0A,#FAFAFA);--tone-accent:light-dark(#0A0A0A,#FAFAFA);--on-accent:light-dark(#FFFFFF,#0A0A0A);--tone-neutral:light-dark(#F2F2F2,#1C1C1C);--on-neutral:light-dark(#0A0A0A,#FAFAFA);--tone-danger:light-dark(#B3261E,#FF6B5E);--on-danger:light-dark(#FFFFFF,#1F0502);--tone-success:light-dark(#0F5132,#7FE0AE);--on-success:light-dark(#FFFFFF,#0A0A0A);--tone-warning:light-dark(#8A4B00,#FFB547);--on-warning:light-dark(#FFFFFF,#1F1300);--ink-text:light-dark(#0A0A0A,#FAFAFA);--ink-muted:light-dark(#525252,#ADADAD);--ink-disabled:light-dark(#8A8A8A,#707070);--ink-danger:light-dark(#A1211A,#FF8D82);--ink-success:light-dark(#0F5132,#7FE0AE);--ink-warning:light-dark(#8A4B00,#FFC46B);--ink-link:light-dark(#0A0A0A,#FAFAFA);--ink-border:light-dark(#D6D6D6,#3A3A3A);--ink-field:light-dark(#767676,#8A8A8A);--ink-focus:light-dark(#0A0A0A,#FAFAFA);--level-flat:var(--tone-surface);--on-level-flat:var(--on-surface);--level-low:var(--tone-surface-raised);--on-level-low:var(--on-surface-raised);--level-medium:var(--tone-surface-raised);--on-level-medium:var(--on-surface-raised);--level-high:var(--tone-surface-raised);--on-level-high:var(--on-surface-raised);--level-highest:var(--tone-surface-raised);--on-level-highest:var(--on-surface-raised);--face-body:system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;--face-heading:system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;--face-footnote:system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;--face-mono:ui-monospace, "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace;--text-display:32px;--text-headline:26px;--text-title:17px;--text-body:15px;--text-label:12px;--leading-tight:1.2;--leading-normal:1.45;--leading-loose:1.7;--tracking-tight:-0.02em;--tracking-normal:0.0em;--tracking-wide:0.06em;--control:36px;--row:10px; }
@media (prefers-contrast: more){:root{--ink-muted:light-dark(#2E2E2E,#D9D9D9);--ink-disabled:light-dark(#5C5C5C,#A3A3A3);--ink-border:light-dark(#0A0A0A,#FAFAFA);--ink-field:light-dark(#0A0A0A,#FAFAFA);}}
*,*::before,*::after{box-sizing:border-box}
@property --grow{syntax:"\3c number>";inherits:false;initial-value:1}
body{margin:0;overflow-wrap:break-word;background:var(--tone-canvas);color:var(--on-canvas);font-family:var(--face-body);font-size:var(--text-body);line-height:var(--leading-normal)}
button,input{font:inherit;color:inherit}
input:not([type=checkbox]){min-width:0;max-width:100%}
fieldset{min-width:0}
h1,h2,h3,h4,h5,h6,hr{margin:0}
label{display:inline-flex;align-items:center;gap:var(--space-xs)}
li:not(.dir-row):not(.dir-col)>*+*{margin-inline-start:var(--space-s)}
dialog{position:fixed;inset-block:0}
dialog:not([open]){display:none}
button{background:transparent;border:1px solid var(--ink-field);border-radius:var(--radius-m);min-height:var(--control);padding:var(--space-xs) var(--space-s)}
input{border-radius:var(--radius-m);min-height:var(--control)}
dialog{background:var(--tone-surface-raised);color:var(--on-surface-raised)}
li{padding-block:var(--row)}
button:disabled,input:disabled{color:var(--ink-disabled)}</style></head><body><span>x</span></body></html>
