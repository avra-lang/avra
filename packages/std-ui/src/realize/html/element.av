//! `realize/html/element.av` — the LOWERING: a neutral node as the
//! elements an HTML page holds. ONE place knows the page's structure — a
//! control cannot hold its own words, so a `label` takes its node's place
//! and the words sit beside the control inside it; a card draws its title
//! above its children; a void element's children follow it. The static
//! writer and the live page both read this tree, so neither knows any of
//! it.
//!
//! Every element stands at a SEAT among its siblings: its node's own
//! step, or — for an element the lowering makes inside a node — that
//! part's (`tree/identity.av`). A page that keeps it gives it a number. A URL arrives as a `Url`, which has no unsafe
//! value, and every other value is escaped by whoever writes it.
use tree.identity.{NodeId, Step, root as root_step, steps, unplaced, under}
use tree.node.{Node, Attribute, Prim, Action, EventKind, submits_among}
use realize.html.tags.{HtmlTag, HtmlAttr, HtmlAttrName, carries, control_attrs, tag_of}
use realize.html.css.{class_names}

/// One piece of a page: an element, or a run of text.
export enum Element {
    Tag(el: Tagged)
    Text(run: Worded)
}

/// A run of text: where it stands among its siblings, and its words.
/// `id` is the number a page gave it — none until a page places it.
export type Worded = { id: NodeId = unplaced, seat: string, reads: string, content: string }

/// An element: where it stands among its siblings (`seat`, its step as
/// matched; `reads`, the same step as a reader is shown it), its tag,
/// its attributes in written order, what it hears, and what it holds. `id` is the number a page gave it — none until a
/// page places it. `rests` names what its node draws AT REST: a box
/// drawn unticked holds no attribute, and is drawn all the same.
export type Tagged = {
    id: NodeId = unplaced,
    seat: string,
    reads: string,
    tag: HtmlTag,
    attrs: List<HtmlAttr> = [],
    rests: List<HtmlAttrName> = [],
    hears: List<Action> = [],
    kids: List<Element> = [],
}

impl Element {
    fn id() -> NodeId {
        match self { .Tag(el) -> el.id, .Text(run) -> run.id }
    }

    /// Where this stands among its siblings.
    fn seat() -> string {
        match self { .Tag(el) -> el.seat, .Text(run) -> run.seat }
    }

    /// Where this stands, as a reader's path shows it.
    fn reads() -> string {
        match self { .Tag(el) -> el.reads, .Text(run) -> run.reads }
    }

    /// The element, when this is one.
    fn tagged() -> Tagged? {
        match self { .Tag(el) -> el, .Text(_) -> null }
    }

    /// The text, when this is a run of it.
    fn text() -> string? {
        match self { .Text(run) -> run.content, .Tag(_) -> null }
    }
}

// ── the attribute table ─────────────────────────────────────────

/// What one component property writes under an attribute's name: its
/// value, or — a flag drawn `false` — the name left off.
type Wrote = { name: HtmlAttrName, value: string = "", on: bool = true }

fn flag(name: HtmlAttrName, on: bool, value: string) -> List<Wrote> {
    [Wrote { name: name, value: value, on: on }]
}

/// A component property as what it writes, or nothing (content and
/// levels are drawn, not attached). Every arm spelled.
fn wrote(a: Attribute) -> List<Wrote> {
    match a {
        .Value(v) -> [Wrote { name: .Value, value: v }],
        .Amount(n) -> [Wrote { name: .Value, value: "${n}" }],
        .Placeholder(t) -> [Wrote { name: .Placeholder, value: t }],
        .Src(u) -> [Wrote { name: .Src, value: u.text() }],
        .Alt(t) -> [Wrote { name: .Alt, value: t }],
        .Href(u) -> [Wrote { name: .Href, value: u.text() }],
        .Min(n) -> [Wrote { name: .Min, value: "${n}" }],
        .Max(n) -> [Wrote { name: .Max, value: "${n}" }],
        .Disabled(on) -> flag(.Disabled, on, ""),
        .Checked(on) -> flag(.Checked, on, ""),
        .Selected(on) -> flag(.AriaSelected, on, "true"),
        .Open(on) -> flag(.Open, on, ""),
        .Invalid(on) -> flag(.AriaInvalid, on, "true"),
        .Loading(on) -> flag(.AriaBusy, on, "true"),
        .Urgency(u) -> [Wrote { name: .AriaLive, value: u.word() }],
        .Title(t) -> [Wrote { name: .Title, value: t }],
        .Name(t) or .Label(t) -> [Wrote { name: .AriaLabel, value: t }],
        .Text(_) or .Level(_) or .Submits(_) -> [],
    }
}

/// What a node's properties write, EACH NAME ONCE: a name two properties
/// write holds what the later one wrote, as a page set twice would — so
/// the page written out, the page first painted and the page repainted
/// are one page.
fn written(attrs: List<Attribute>) -> List<Wrote> {
    let all = [w for a in attrs for w in wrote(a)]
    [w for j, w in all if !all.drop(j + 1).any(it.name == w.name)]
}

/// A node's properties as attributes.
fn attrs_of(attrs: List<Attribute>) -> List<HtmlAttr> {
    [HtmlAttr { name: w.name, value: w.value } for w in written(attrs) if w.on]
}

/// The names a node draws AT REST: each flag its properties leave off.
fn rests_of(attrs: List<Attribute>) -> List<HtmlAttrName> {
    [w.name for w in written(attrs) if !w.on]
}

/// An element's attributes from the neutral node: what kind of control it
/// is, then its properties.
fn element_attrs(prim: Prim, attrs: List<Attribute>) -> List<HtmlAttr> {
    control_attrs(prim, submits_among(attrs)).concat(attrs_of(attrs))
}

// ── the class attribute ─────────────────────────────────────────

fn class_attrs(n: Node) -> List<HtmlAttr> {
    let names = class_names(n)
    if names.is_empty() { [] } else { [HtmlAttr { name: .Class, value: names.join(" ") }] }
}

/// A node's own attributes: its identity, its classes, its box.
fn node_attrs(n: Node) -> List<HtmlAttr> {
    let keyed: List<HtmlAttr> = match n.box.key {
        k? -> [HtmlAttr { name: .DataKey, value: k }]
        null -> []
    }
    keyed.concat(class_attrs(n))
}

// ── the elements a node lowers to ───────────────────────────────

/// Where an element stands among its siblings: its step as it is
/// MATCHED, and the same step as a reader is SHOWN it.
type Seat = { matched: string, shown: string }

/// The seat of a step, under the seat of what its siblings stand beside
/// — none, when they stand inside their node.
fn seat_of(seat: Seat?, step: Step) -> Seat {
    Seat { matched: under(seat?.matched, step.spelled()), shown: under(seat?.shown, step.shown()) }
}

/// The parts a lowering makes inside a node, by the step each stands at.
const text_part = Step.Part("text").spelled()
const control_part = Step.Part("control").spelled()
const words_part = Step.Part("words").spelled()

fn title_part(j: int) -> string { Step.Part(if j == 0 { "title" } else { "title~${j}" }).spelled() }

/// A run of text, when there are words to say.
fn said(words: string) -> List<Element> {
    if words == "" { [] } else { [Element.Text(Worded { seat: text_part, reads: text_part, content: words })] }
}

/// The title an attribute carries, when it is one.
fn titles(a: Attribute) -> List<string> {
    match a { .Title(t) -> [t], _ -> [] }
}

/// The headings a titled grouping shows above its children. Every
/// primitive spelled: only a card draws its title.
fn headings(n: Node) -> List<Element> {
    match n.prim {
        .Card -> [Element
            .Tag(Tagged { seat: title_part(j), reads: title_part(j), tag: .H2, kids: said(title) }) for j, title in [t for a in n.attrs for t in titles(a)]],
        .Text or .Heading or .Button or .Link or .Image or .Field or .Checkbox or .Row or .Column or .Dialog or .Divider or .Icon or .Surface or .List or .Item or .Progress or .Alert or .Spinner or .Form or .Switch or .Slider -> [],
    }
}

/// Whether a control's words are read before it. Every primitive
/// spelled: a field, a slider and a progress are named and then shown; a
/// box is ticked and then named.
fn words_lead(p: Prim) -> bool {
    match p {
        .Field or .Slider or .Progress -> true,
        .Checkbox or .Switch or .Text or .Heading or .Button or .Link or .Image or .Row or .Column or .Dialog or .Divider or .Icon or .Surface or .List or .Item or .Card or .Alert or .Spinner or .Form -> false,
    }
}

/// A control under its label: the label takes the node's place — its
/// seat, its key and its classes — and the control inside it takes the
/// node's attributes and hears its events. The control and its words
/// stand in the order a reader expects of its kind.
fn labelled(n: Node, at: Seat, kids: List<Element>) -> Element {
    let control = Element
        .Tag(
            Tagged {
                seat: control_part,
                reads: control_part,
                tag: tag_of(n),
                attrs: element_attrs(n.prim, n.attrs),
                rests: rests_of(n.attrs),
                hears: n.events,
            },
        )
    let words = Element
        .Tag(Tagged { seat: words_part, reads: words_part, tag: .Span, kids: said(n.words()) })
    Element
        .Tag(
            Tagged {
                seat: at.matched,
                reads: at.shown,
                tag: .Label,
                attrs: node_attrs(n),
                kids: if words_lead(n.prim) { [words, control] } else { [control, words] }.concat(kids),
            },
        )
}

fn unheard() {}

/// The event a primitive always hears on a page, handler or none: the
/// page's own answer to it would undo what the program drew — a form's
/// submit leaves the page, a dialog's dismissal closes it. Every primitive
/// spelled.
fn always_heard(p: Prim) -> EventKind? {
    match p {
        .Form -> .Submit,
        .Dialog -> .Dismiss,
        .Text or .Heading or .Button or .Link or .Image or .Field or .Checkbox or .Row or .Column or .Divider or .Icon or .Surface or .List or .Item or .Card or .Progress or .Alert or .Spinner or .Switch or .Slider -> null,
    }
}

/// What a node's element hears: its own events, and the one its
/// primitive always hears, doing nothing, when no handler does.
fn heard(n: Node) -> List<Action> {
    let kind? = always_heard(n.prim) else { return n.events }
    if n.events.any(it.kind == kind) { return n.events }
    n.events.concat([Action { kind: kind, handler: .Nothing(unheard) }])
}

/// The node itself as one element holding `kids`.
fn element(n: Node, at: Seat, kids: List<Element>) -> Element {
    Element
        .Tag(
            Tagged {
                seat: at.matched,
                reads: at.shown,
                tag: tag_of(n),
                attrs: element_attrs(n.prim, n.attrs).concat(node_attrs(n)),
                rests: rests_of(n.attrs),
                hears: heard(n),
                kids: kids,
            },
        )
}

/// The elements `n` lowers to, the node standing at `at`: one, or —
/// for an element that holds nothing — that one and then its children,
/// each standing under the node's seat so it is told from the node's own
/// siblings.
fn lower(n: Node, at: Seat) -> List<Element> {
    let stands = steps([c.box.stand() for c in n.children])
    match carries(tag_of(n)) {
        .Within -> [
            element(
                n,
                at,
                said(n.words()).concat(headings(n)).concat(lower_each(n.children, stands, null)),
            ),
        ],
        .Never -> [element(n, at, [])].concat(lower_each(n.children, stands, at)),
        .Beside -> [labelled(n, at, lower_each(n.children, stands, null))],
    }
}

/// Each child lowered at its own step — under `within`, when its
/// children stand beside the node rather than inside it.
fn lower_each(children: List<Node>, stands: List<Step>, seat: Seat?) -> List<Element> {
    [e for i, c in children for e in lower(c, seat_of(seat, stands[i]))]
}

/// The elements a tree lowers to, in page order.
export fn lowered(root: Node) -> List<Element> { lower(root, seat_of(null, root_step(root.box.key))) }
