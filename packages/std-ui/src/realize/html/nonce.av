//! `realize/html/nonce.av` — the nonce a page's one `style` element wears
//! for a policy that allows styles by nonce alone.
use @std.meta.{sealed}
use @std.random.{token}

/// A nonce. SEALED: only `fresh_nonce` builds one, so every nonce on a page
/// was drawn from the OS for that page — never a caller's, never reused.
@sealed
export type Nonce = { text: string }

/// A fresh nonce, 128 bits of the OS's entropy as URL-safe text; absent
/// when the OS gave none.
export fn fresh_nonce() -> Nonce? {
    let text? = token(16) else { return null }
    Nonce { text: text }
}
