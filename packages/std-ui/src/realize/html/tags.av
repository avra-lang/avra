//! `realize/html/tags.av` — the HTML target's OWN typed vocabulary. The
//! model upstream is typed end to end; strings appear only in the two
//! serializers, so a tag cannot be hostile.
use realize.render.{Node, Prim}

export enum HtmlTag {
    Span
    Button
    Div
    A
    Img
    Input
    Dialog
    H1
    H2
    H3
    H4
    H5
    H6
    Hr
    Ul
    Li
    Article
    Progress
    Form
}

export enum HtmlAttrName {
    DataKey
    Class
    AriaLabel
    AriaSelected
    AriaInvalid
    AriaBusy
    AriaLive
    Title
    Href
    Min
    Max
    Open
    Value
    Placeholder
    Src
    Alt
    Disabled
    Checked
}

/// One attribute: a typed name, an escaped value.
export type HtmlAttr = { name: HtmlAttrName, value: string }

/// Every tag and its word — DATA: a row is the whole spelling, and the
/// enum-keyed table is the roster read both ways.
export type TagWord = { tag: HtmlTag, word: string }

const tag_words: List<TagWord> = table<TagWord> {
    tag       | word
    .Span     | "span"
    .Button   | "button"
    .Div      | "div"
    .A        | "a"
    .Img      | "img"
    .Input    | "input"
    .Dialog   | "dialog"
    .H1       | "h1"
    .H2       | "h2"
    .H3       | "h3"
    .H4       | "h4"
    .H5       | "h5"
    .H6       | "h6"
    .Hr       | "hr"
    .Ul       | "ul"
    .Li       | "li"
    .Article  | "article"
    .Progress | "progress"
    .Form     | "form"
}

impl HtmlTag {
    /// This tag's word.
    fn text() -> string { tag_words.find(it.tag == self)?.word ?? "" }
}

/// Every attribute name and its word — DATA.
export type AttrWord = { attr: HtmlAttrName, word: string }

const attr_words: List<AttrWord> = table<AttrWord> {
    attr          | word
    .DataKey      | "data-key"
    .Class        | "class"
    .AriaLabel    | "aria-label"
    .AriaSelected | "aria-selected"
    .AriaInvalid  | "aria-invalid"
    .AriaBusy     | "aria-busy"
    .AriaLive     | "aria-live"
    .Title        | "title"
    .Href         | "href"
    .Min          | "min"
    .Max          | "max"
    .Open         | "open"
    .Value        | "value"
    .Placeholder  | "placeholder"
    .Src          | "src"
    .Alt          | "alt"
    .Disabled     | "disabled"
    .Checked      | "checked"
}

impl HtmlAttrName {
    /// This attribute name's word.
    fn text() -> string { attr_words.find(it.attr == self)?.word ?? "" }
}

/// Every primitive's element — DATA. `Heading` is the one row a level
/// overrides, so it is read before the table.
export type PrimTag = { prim: Prim, tag: HtmlTag }

export const prim_tags: List<PrimTag> = table<PrimTag> {
    prim      | tag
    .Text     | .Span
    .Button   | .Button
    .Link     | .A
    .Image    | .Img
    .Icon     | .Img
    .Field    | .Input
    .Checkbox | .Input
    .Switch   | .Input
    .Slider   | .Input
    .Row      | .Div
    .Column   | .Div
    .Surface  | .Div
    .List     | .Ul
    .Item     | .Li
    .Card     | .Article
    .Dialog   | .Dialog
    .Divider  | .Hr
    .Progress | .Progress
    .Alert    | .Div
    .Spinner  | .Div
    .Form     | .Form
    .Heading  | .H1
}

export fn heading_tag(rank: int) -> HtmlTag {
    let r = if rank < 1 { 1 } else if rank > 6 { 6 } else { rank }
    let tags: List<HtmlTag> = [.H1, .H2, .H3, .H4, .H5, .H6]
    tags[r - 1]
}

export fn tag_of(n: Node) -> HtmlTag {
    if n.prim is .Heading { return heading_tag(n.level()) }
    prim_tags.find(it.prim == n.prim)?.tag ?? .Div
}
