//! `realize/html/tags.av` — the HTML target's OWN typed vocabulary. The
//! model upstream is typed end to end; strings appear only in the two
//! serializers, so a tag cannot be hostile.
export enum HtmlTag {
    Span
    Button
    Div
    A
    Img
    Input
    Dialog
    H1
    H2
    H3
    H4
    H5
    H6
    Hr
    Ul
    Li
    Article
    Progress
    Form
}

export enum HtmlAttrName {
    DataKey
    Class
    AriaLabel
    AriaSelected
    AriaInvalid
    AriaBusy
    AriaLive
    Title
    Href
    Min
    Max
    Open
    Value
    Placeholder
    Src
    Alt
    Disabled
    Checked
}

/// One attribute: a typed name, an escaped value.
export type HtmlAttr = { name: HtmlAttrName, value: string }

/// Every tag and its word — DATA: a row is the whole spelling, and the
/// enum-keyed table is the roster read both ways.
export type TagWord = { tag: HtmlTag, word: string }

const tag_words: List<TagWord> = table<TagWord> {
    tag       | word
    .Span     | "span"
    .Button   | "button"
    .Div      | "div"
    .A        | "a"
    .Img      | "img"
    .Input    | "input"
    .Dialog   | "dialog"
    .H1       | "h1"
    .H2       | "h2"
    .H3       | "h3"
    .H4       | "h4"
    .H5       | "h5"
    .H6       | "h6"
    .Hr       | "hr"
    .Ul       | "ul"
    .Li       | "li"
    .Article  | "article"
    .Progress | "progress"
    .Form     | "form"
}

impl HtmlTag {
    /// This tag's word.
    fn text(self) -> string { tag_words.find(it.tag == self)?.word ?? "" }
}

/// Every attribute name and its word — DATA.
export type AttrWord = { attr: HtmlAttrName, word: string }

const attr_words: List<AttrWord> = table<AttrWord> {
    attr          | word
    .DataKey      | "data-key"
    .Class        | "class"
    .AriaLabel    | "aria-label"
    .AriaSelected | "aria-selected"
    .AriaInvalid  | "aria-invalid"
    .AriaBusy     | "aria-busy"
    .AriaLive     | "aria-live"
    .Title        | "title"
    .Href         | "href"
    .Min          | "min"
    .Max          | "max"
    .Open         | "open"
    .Value        | "value"
    .Placeholder  | "placeholder"
    .Src          | "src"
    .Alt          | "alt"
    .Disabled     | "disabled"
    .Checked      | "checked"
}

impl HtmlAttrName {
    /// This attribute name's word.
    fn text(self) -> string { attr_words.find(it.attr == self)?.word ?? "" }
}
