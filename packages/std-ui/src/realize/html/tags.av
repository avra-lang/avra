//! `realize/html/tags.av` — the HTML target's OWN typed vocabulary. The
//! model upstream is typed end to end; strings appear only in the two
//! serializers, so a tag cannot be hostile.
export enum HtmlTag { Span, Button, Div, A, Img, Input, Dialog, H1, H2, H3, H4, H5, H6 }

export enum HtmlAttrName { DataKey, Style, AriaLabel, Value, Placeholder, Src, Disabled, Checked }

/// One attribute: a typed name, an escaped value.
export type HtmlAttr = { name: HtmlAttrName, value: string }

export fn tag_text(t: HtmlTag) -> string {
    match t {
        .Span -> "span",
        .Button -> "button",
        .Div -> "div",
        .A -> "a",
        .Img -> "img",
        .Input -> "input",
        .Dialog -> "dialog",
        .H1 -> "h1",
        .H2 -> "h2",
        .H3 -> "h3",
        .H4 -> "h4",
        .H5 -> "h5",
        .H6 -> "h6",
    }
}

export fn attr_text(n: HtmlAttrName) -> string {
    match n {
        .DataKey -> "data-key",
        .Style -> "style",
        .AriaLabel -> "aria-label",
        .Value -> "value",
        .Placeholder -> "placeholder",
        .Src -> "src",
        .Disabled -> "disabled",
        .Checked -> "checked",
    }
}
