//! `realize/html/tags.av` — the HTML target's OWN typed vocabulary. The
//! model upstream is typed end to end; strings appear only in the two
//! serializers, so a tag cannot be hostile.
use @std.meta.{derive}
use realize.render.{Node, Prim}
use style.words.{Words}

/// Every tag carries its own word: the variant IS the roster.
@derive(Words)
export enum HtmlTag {
    @word(span) Span
    @word(button) Button
    @word(div) Div
    @word(a) A
    @word(img) Img
    @word(input) Input
    @word(dialog) Dialog
    @word(h1) H1
    @word(h2) H2
    @word(h3) H3
    @word(h4) H4
    @word(h5) H5
    @word(h6) H6
    @word(hr) Hr
    @word(ul) Ul
    @word(li) Li
    @word(article) Article
    @word(progress) Progress
    @word(form) Form
}

/// Every attribute name carries its own word.
@derive(Words)
export enum HtmlAttrName {
    @word(data_key) DataKey
    @word(class) Class
    @word(aria_label) AriaLabel
    @word(aria_selected) AriaSelected
    @word(aria_invalid) AriaInvalid
    @word(aria_busy) AriaBusy
    @word(aria_live) AriaLive
    @word(title) Title
    @word(href) Href
    @word(min) Min
    @word(max) Max
    @word(open) Open
    @word(value) Value
    @word(placeholder) Placeholder
    @word(src) Src
    @word(alt) Alt
    @word(disabled) Disabled
    @word(checked) Checked
}

/// One attribute: a typed name, an escaped value.
export type HtmlAttr = { name: HtmlAttrName, value: string }

/// Every primitive's element — DATA. `Heading` is the one row a level
/// overrides, so it is read before the table.
export type PrimTag = { prim: Prim, tag: HtmlTag }

export const prim_tags: List<PrimTag> = table<PrimTag> {
    prim      | tag
    .Text     | .Span
    .Button   | .Button
    .Link     | .A
    .Image    | .Img
    .Icon     | .Img
    .Field    | .Input
    .Checkbox | .Input
    .Switch   | .Input
    .Slider   | .Input
    .Row      | .Div
    .Column   | .Div
    .Surface  | .Div
    .List     | .Ul
    .Item     | .Li
    .Card     | .Article
    .Dialog   | .Dialog
    .Divider  | .Hr
    .Progress | .Progress
    .Alert    | .Div
    .Spinner  | .Div
    .Form     | .Form
    .Heading  | .H1
}

export fn heading_tag(rank: int) -> HtmlTag {
    let r = if rank < 1 { 1 } else if rank > 6 { 6 } else { rank }
    let tags: List<HtmlTag> = [.H1, .H2, .H3, .H4, .H5, .H6]
    tags[r - 1]
}

export fn tag_of(n: Node) -> HtmlTag {
    if n.prim is .Heading { return heading_tag(n.level()) }
    prim_tags.find(it.prim == n.prim)?.tag ?? .Div
}
