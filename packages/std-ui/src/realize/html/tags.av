//! `realize/html/tags.av` — the HTML target's OWN typed vocabulary. The
//! model upstream is typed end to end; strings appear only in the two
//! serializers, so a tag cannot be hostile.
use @std.meta.{derive}
use realize.render.{Node, Prim}
use style.words.{Words}

/// Every tag carries its own word: the variant IS the roster.
@derive(Words)
export enum HtmlTag {
    @word(span) Span
    @word(button) Button
    @word(div) Div
    @word(a) A
    @word(img) Img
    @word(input) Input
    @word(dialog) Dialog
    @word(h1) H1
    @word(h2) H2
    @word(h3) H3
    @word(h4) H4
    @word(h5) H5
    @word(h6) H6
    @word(hr) Hr
    @word(ul) Ul
    @word(li) Li
    @word(article) Article
    @word(progress) Progress
    @word(form) Form
    @word(label) Label
}

/// Every attribute name carries its own word.
@derive(Words)
export enum HtmlAttrName {
    @word(data_key) DataKey
    @word(class) Class
    @word(aria_label) AriaLabel
    @word(aria_selected) AriaSelected
    @word(aria_invalid) AriaInvalid
    @word(aria_busy) AriaBusy
    @word(aria_live) AriaLive
    @word(title) Title
    @word(href) Href
    @word(min) Min
    @word(max) Max
    @word(open) Open
    @word(value) Value
    @word(placeholder) Placeholder
    @word(src) Src
    @word(alt) Alt
    @word(disabled) Disabled
    @word(checked) Checked
    @word(type) Type
    @word(role) Role
    @word(data_refused_url) DataRefusedUrl
}

/// One attribute: a typed name, an escaped value.
export type HtmlAttr = { name: HtmlAttrName, value: string }

/// What an `input` IS, by its primitive: the element is one tag for four
/// controls, so the kind rides an attribute. Every primitive spelled.
export fn control_attrs(prim: Prim) -> List<HtmlAttr> {
    match prim {
        .Field -> [input_type("text")],
        .Checkbox -> [input_type("checkbox")],
        .Switch -> [input_type("checkbox"), HtmlAttr { name: .Role, value: "switch" }],
        .Slider -> [input_type("range")],
        .Text or .Heading or .Button or .Link or .Image or .Row or .Column or .Dialog or .Divider or .Icon or .Surface or .List or .Item or .Card or .Progress or .Alert or .Spinner or .Form -> [],
    }
}

/// The attribute that says which control an `input` is.
fn input_type(kind: string) -> HtmlAttr { HtmlAttr { name: .Type, value: kind } }

export fn heading_tag(rank: int) -> HtmlTag {
    let r = if rank < 1 { 1 } else if rank > 6 { 6 } else { rank }
    let tags: List<HtmlTag> = [.H1, .H2, .H3, .H4, .H5, .H6]
    tags[r - 1]
}

/// The element a primitive draws as, given a heading's level. The ONE
/// projection, and ONE match: the mapping is code, so no per-row
/// aggregate settles. A heading's level overrides its default element.
export fn tag_for(prim: Prim, rank: int) -> HtmlTag {
    if prim is .Heading { return heading_tag(rank) }
    match prim {
        .Text -> .Span,
        .Button -> .Button,
        .Link -> .A,
        .Image or .Icon -> .Img,
        .Field or .Checkbox or .Switch or .Slider -> .Input,
        .Row or .Column or .Surface or .Alert or .Spinner -> .Div,
        .List -> .Ul,
        .Item -> .Li,
        .Card -> .Article,
        .Dialog -> .Dialog,
        .Divider -> .Hr,
        .Progress -> .Progress,
        .Form -> .Form,
        .Heading -> .H1,
    }
}

export fn tag_of(n: Node) -> HtmlTag { tag_for(n.prim, n.level()) }

/// Where an element's own words go: inside it, nowhere, or beside it
/// under a `label` that names it.
export enum Carries { Within, Never, Beside }

/// How each element carries words. A control holds no content, so its
/// words sit beside it; an image and a rule say nothing. Every tag spelled.
export fn carries(tag: HtmlTag) -> Carries {
    match tag {
        .Input or .Progress -> .Beside,
        .Img or .Hr -> .Never,
        .Span or .Button or .Div or .A or .Dialog or .H1 or .H2 or .H3 or .H4 or .H5 or .H6 or .Ul or .Li or .Article or .Form or .Label -> .Within,
    }
}

/// Whether an element is VOID: it holds nothing and is never closed.
/// Every tag spelled.
export fn is_void(tag: HtmlTag) -> bool {
    match tag {
        .Input or .Img or .Hr -> true,
        .Progress or .Span or .Button or .Div or .A or .Dialog or .H1 or .H2 or .H3 or .H4 or .H5 or .H6 or .Ul or .Li or .Article or .Form or .Label -> false,
    }
}
