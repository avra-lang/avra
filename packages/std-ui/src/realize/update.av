//! `realize/update.av` — the ONE update graph every target emits from. A
//! tree is walked ONCE (the `Sink` walk) into a stream of NEUTRAL ops:
//! where a node sits, what it is, how it looks, what it says and what it
//! answers. No target's currency appears here — a tag, a class, a byte
//! op and a drawn line are an EMITTER's business. The DOM wire, the
//! canvas draw calls and a native tree each project this one graph.
use realize.identity.{NodeId}
use realize.render.{Node, Prim, Attribute, Action}
use realize.sink.{Sink, draw}
use style.box.{Box}

/// Who a node is, where it sits, and everything a target needs to make
/// it: its neutral primitive, its attributes and its box. The root has no
/// parent.
export type Mount = {
    id: NodeId,
    parent: NodeId?,
    index: int,
    prim: Prim,
    attrs: List<Attribute>,
    box: Box,
}

/// One update op, addressed by its node's id. A target projects the
/// stream into its own currency: `Mount` places, `Words` says, `Event`
/// answers.
export enum Op {
    Mount(m: Mount)
    Words(id: NodeId, text: string)
    Event(id: NodeId, action: Action)
}

/// The graph being collected: the ops in walk order.
export type Recorder = { ops: Cell<List<Op>> = Cell.new([]) }

impl Sink for Recorder {
    fn opened(id: NodeId, parent: NodeId?, index: int, n: Node) {
        self
            .ops
            .push(
                Op
                    .Mount(
                        Mount {
                            id: id,
                            parent: parent,
                            index: index,
                            prim: n.prim,
                            attrs: n.attrs,
                            box: n.box,
                        },
                    ),
            )
        // LICENSED loops.push_loop: the ops ride a shared Cell; a concat assignment would rebind a copy
        for ev in n.events { self.ops.push(Op.Event(id, ev)) }
    }

    fn words(id: NodeId, s: string) { self.ops.push(Op.Words(id, s)) }

    fn closed(_n: Node) {}
}

/// The update graph of one tree, in walk order.
export fn plan(root: Node) -> List<Op> {
    let r = Recorder {}
    draw(root, r)
    r.ops.get()
}

/// Whether an op is the words of `id`.
fn has_words(id: NodeId, op: Op) -> bool {
    match op { .Words(who, _) -> who == id, .Mount(_) or .Event(_, _) -> false }
}

/// A node's words, read back from the op that carries them. Absence is a
/// node the graph never walked.
export fn words_at(ops: List<Op>, id: NodeId) -> string? {
    let found? = ops.find(has_words(id, it)) else { return null }
    match found { .Words(_, text) -> text, .Mount(_) or .Event(_, _) -> null }
}
