//! `realize/realizer.av` — the visitor. ONE non-generic trait, one method
//! per component, each answering `void` and drawing into the target's own
//! accumulator, so a target missing a component fails to compile. A
//! target holds one complete impl block; its per-component drawing lives
//! in the target's own files. UI.md §19.2.
use realize.view.{View}
use components.text.{text}

/// What draws a component tree for one target.
export trait Realizer {
    fn text(t: text)
}

/// Draw a list of views through one realizer, in order.
export fn drawn(items: List<dyn View>, r: dyn Realizer) {
    for v in items { v.realize(r) }
}
