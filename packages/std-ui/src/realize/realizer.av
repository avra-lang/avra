//! `realize/realizer.av` — the drawing surface. ONE non-generic trait, a
//! method per component PRIMITIVE, each answering `void` and drawing into
//! the target's own accumulator (a shared `Cell`, a read of the receiver,
//! so nothing here is `mut`). A CONTAINER is two primitives, open and
//! close; the component's own `View::realize` draws its children between
//! them, so the recursion lives in the component and no method hands
//! `self` back into the visitor. A target missing a primitive fails to
//! compile. UI.md §19.2, charter §6.
use realize.view.{View}
use components.{text, heading, button, column, row}

/// What draws a component's primitives for one target.
export trait Realizer {
    fn text(t: text)
    fn heading(h: heading)
    fn button(b: button)
    fn column_begin(c: column)
    fn column_end()
    fn row_begin(r: row)
    fn row_end()
}

/// Draw a list of views through one realizer, in order.
export fn drawn(items: List<dyn View>, r: dyn Realizer) {
    for v in items { v.realize(r) }
}
