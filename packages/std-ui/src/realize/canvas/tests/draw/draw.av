// proves: the SAME neutral update graph becomes canvas draw calls — a flow
// layout in whole theme steps, addressed by coordinates. No DOM tag, no
// byte op: the currency here is geometry.
use @std.ui.components.{column, heading, button}
use @std.ui.realize.canvas.canvas.{canvas, draw_text}
use @std.ui.tree.view.{View, tree_of}
use @std.ui.style.layout.{around, Layout}
use @std.ui.style.style.{Style}
use @std.ui.style.theme.{default_theme}

let page = column {
    style: Style { fill: .SurfaceSunk }
    layout: Layout { gap: .S, pad: around(.S) }
    items: [heading "Tasks" { rank: 1 }, button "Add"]
}

println(draw_text(canvas(tree_of(page), default_theme)))
println("${canvas(tree_of(page), default_theme).length}")
