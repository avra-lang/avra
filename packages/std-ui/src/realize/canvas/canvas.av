//! `realize/canvas/canvas.av` — the canvas backend over the ONE update
//! graph (`realize/update.av`). A canvas has no elements, so this emitter
//! names its OWN currency — a fill, a line of text, a rule, a block — and
//! lays the graph out as a flow. The same neutral ops the DOM serializes
//! as tags become geometry here; neither target is the other's lowest
//! common denominator.
use realize.render.{Node, Prim}
use realize.update.{Op, Mount, plan}
use style.layout.{Axis}
use style.theme.{Theme}
use ui.{Size, Tone, Font}

/// A canvas's fixed metrics: one text line's height and one character's
/// width. Real text measurement belongs to the platform; a draw program
/// is arithmetic over these.
export type Metrics = { line: int = 18, char: int = 8 }

export fn metrics() -> Metrics { Metrics {} }

/// One draw call.
export enum Draw {
    Fill(x: int, y: int, w: int, h: int, color: string)
    Text(x: int, y: int, words: string, color: string, face: string)
    Rule(x: int, y: int, w: int, color: string)
    Block(x: int, y: int, w: int, h: int, color: string)
}

/// How a primitive draws: words, bracketed words, a checkbox, a rule, an
/// opaque block, or a flow container. DATA, keyed by the primitive.
export enum Form { Words, Bracketed, Checkbox, Rule, Block, Flow }

export type FormRow = { prim: Prim, form: Form }

const form_rows: List<FormRow> = table<FormRow> {
    prim      | form
    .Text     | Form.Words
    .Heading  | Form.Words
    .Button   | Form.Bracketed
    .Link     | Form.Words
    .Image    | Form.Block
    .Field    | Form.Words
    .Checkbox | Form.Checkbox
    .Row      | Form.Flow
    .Column   | Form.Flow
    .Dialog   | Form.Flow
    .Divider  | Form.Rule
    .Icon     | Form.Block
    .Surface  | Form.Flow
    .List     | Form.Flow
    .Item     | Form.Flow
    .Card     | Form.Flow
    .Progress | Form.Words
    .Alert    | Form.Words
    .Spinner  | Form.Words
    .Form     | Form.Flow
    .Switch   | Form.Checkbox
    .Slider   | Form.Words
}

fn form_of(p: Prim) -> Form { form_rows.find(it.prim == p)?.form ?? Form.Words }

/// A node in the flat graph: its mount, its words and its child ids.
type Frame = { mount: Mount, words: string, kids: List<int> }

/// A laid-out extent.
type Extent = { w: int, h: int }

/// A box's four insets, in whole units.
type Inset = { start: int, end: int, top: int, bottom: int }

// ── the graph, rebuilt as an arena ──────────────────────────────

/// Every mount by id, with its words and children. The ops are pre-order,
/// so a mount's index IS its id.
fn arena_of(ops: List<Op>) -> List<Frame> {
    let arena: Cell<List<Frame>> = Cell.new([])
    for op in ops {
        let _ = match op {
            .Mount(m) -> {
                // LICENSED loops.push_loop: the arena rides a shared Cell; a concat assignment would rebind a copy
                arena.push(Frame { mount: m, words: "", kids: [] })
                if m.parent >= 0 {
                    let p = arena.get()[m.parent]
                    arena.set_at(m.parent, p with { kids: p.kids.concat([m.id]) })
                }
                0
            },
            .Words(id, t) -> {
                let n = arena.get()[id]
                arena.set_at(id, n with { words: t })
                0
            },
            .Event(_, _) -> 0,
        }
    }
    arena.get()
}

// ── measuring ───────────────────────────────────────────────────

fn text_w(words: string, extra: int, m: Metrics) -> int { (words.length + extra) * m.char }

fn size_of(arena: List<Frame>, id: int, m: Metrics, theme: Theme) -> Extent {
    let f = arena[id]
    match form_of(f.mount.prim) {
        .Flow -> flow_size(arena, f, m, theme),
        .Rule -> Extent { w: 0, h: 2 },
        .Block -> Extent { w: m.line * 2, h: m.line },
        .Words -> Extent { w: text_w(f.words, 0, m), h: m.line },
        .Bracketed -> Extent { w: text_w(f.words, 2, m), h: m.line },
        .Checkbox -> Extent { w: text_w(f.words, 4, m), h: m.line },
    }
}

fn flow_size(arena: List<Frame>, f: Frame, m: Metrics, theme: Theme) -> Extent {
    let sizes = [size_of(arena, k, m, theme) for k in f.kids]
    let widths = [s.w for s in sizes]
    let heights = [s.h for s in sizes]
    let g = gap_of(f.mount, theme) * gaps(sizes.length)
    let pad = pad_of(f.mount, theme)
    if axis_of(f.mount) is .Row {
        Extent {
            w: pad.start + widths.sum() + g + pad.end,
            h: pad.top + (heights.max() ?? 0) + pad.bottom,
        }
    } else {
        Extent {
            w: pad.start + (widths.max() ?? 0) + pad.end,
            h: pad.top + heights.sum() + g + pad.bottom,
        }
    }
}

/// The gaps between n children: one fewer than the children.
fn gaps(n: int) -> int { if n == 0 { 0 } else { n - 1 } }

fn axis_of(mnt: Mount) -> Axis {
    match mnt.box.layout.direction {
        a? -> a
        null -> if mnt.prim is .Row { Axis.Row } else { Axis.Column }
    }
}

fn gap_of(mnt: Mount, theme: Theme) -> int {
    match mnt.box.layout.gap {
        z? -> theme.space_of(z)
        null -> 0
    }
}

fn pad_of(mnt: Mount, theme: Theme) -> Inset {
    match mnt.box.layout.pad {
        e? -> Inset {
            start: step(e.start, theme),
            end: step(e.end, theme),
            top: step(e.top, theme),
            bottom: step(e.bottom, theme),
        }
        null -> Inset { start: 0, end: 0, top: 0, bottom: 0 }
    }
}

fn step(z: Size?, theme: Theme) -> int {
    match z {
        v? -> theme.space_of(v)
        null -> 0
    }
}

fn fill_color(f: Frame, theme: Theme) -> string? {
    match f.mount.box.style.fill {
        t? -> theme.color_of(t)
        null -> null
    }
}

fn text_color(f: Frame, theme: Theme) -> string {
    match f.mount.box.style.color {
        t? -> theme.color_of(t)
        null -> theme.color_of(Tone.Text)
    }
}

fn text_face(f: Frame, theme: Theme) -> string {
    match f.mount.box.style.face {
        t? -> theme.face_of(t)
        null -> theme.face_of(Font.Body)
    }
}

// ── placing ─────────────────────────────────────────────────────

/// A node's draw calls, at its own origin, then its children's.
fn place(
    arena: List<Frame>,
    id: int,
    x: int,
    y: int,
    out: Cell<List<Draw>>,
    m: Metrics,
    theme: Theme,
) {
    let f = arena[id]
    let e = size_of(arena, id, m, theme)
    let _ = match fill_color(f, theme) {
        c? -> {
            out.push(Draw.Fill(x, y, e.w, e.h, c))
            0
        }
        null -> 0
    }
    match form_of(f.mount.prim) {
        .Flow -> flow_place(arena, f, x, y, out, m, theme),
        .Rule -> out.push(Draw.Rule(x, y, e.w, text_color(f, theme))),
        .Block -> out.push(Draw.Block(x, y, e.w, e.h, text_color(f, theme))),
        .Words -> out.push(Draw.Text(x, y, f.words, text_color(f, theme), text_face(f, theme))),
        .Bracketed -> out.push(Draw.Text(x, y, "[${f.words}]", text_color(f, theme), text_face(f, theme))),
        .Checkbox -> out.push(Draw.Text(x, y, "[ ] ${f.words}", text_color(f, theme), text_face(f, theme))),
    }
}

fn flow_place(
    arena: List<Frame>,
    f: Frame,
    x: int,
    y: int,
    out: Cell<List<Draw>>,
    m: Metrics,
    theme: Theme,
) {
    let pad = pad_of(f.mount, theme)
    let g = gap_of(f.mount, theme)
    let row = axis_of(f.mount) is .Row
    let at = Cell.new(if row { x + pad.start } else { y + pad.top })
    for k in f.kids {
        let e = size_of(arena, k, m, theme)
        let kx = if row { at.get() } else { x + pad.start }
        let ky = if row { y + pad.top } else { at.get() }
        place(arena, k, kx, ky, out, m, theme)
        at.set(at.get() + if row { e.w } else { e.h } + g)
    }
}

// ── the emitter ─────────────────────────────────────────────────

/// The graph drawn on a canvas, in paint order.
export fn canvas_with(root: Node, theme: Theme, m: Metrics) -> List<Draw> {
    let arena = arena_of(plan(root))
    let out: Cell<List<Draw>> = Cell.new([])
    place(arena, 0, 0, 0, out, m, theme)
    out.get()
}

/// The graph drawn on a canvas at default metrics.
export fn canvas(root: Node, theme: Theme) -> List<Draw> { canvas_with(root, theme, metrics()) }

/// The draw program as readable lines — for tests and `explain`.
export fn draw_text(draws: List<Draw>) -> string { [draw_word(d) for d in draws].join("\n") }

fn draw_word(d: Draw) -> string {
    match d {
        .Fill(x, y, w, h, c) -> "fill ${x} ${y} ${w} ${h} ${c}",
        .Text(x, y, words, c, f) -> "text ${x} ${y} ${words} ${c} ${f}",
        .Rule(x, y, w, c) -> "rule ${x} ${y} ${w} ${c}",
        .Block(x, y, w, h, c) -> "block ${x} ${y} ${w} ${h} ${c}",
    }
}
