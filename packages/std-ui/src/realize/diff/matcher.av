//! `realize/diff/matcher.av` — THE MATCHER: one parent's children as they
//! stand against how they should stand, for any target's elements. A run is
//! matched by SEAT (the step a node stands at), an element kept only where
//! its kind is kept; what left is removed, what is new or moved is placed
//! after the sibling it now follows, and of the kept the longest run still
//! in order stands still. What a kept or new element says beyond that is
//! its target's (`Draws`), so one matcher serves every vocabulary.
use tree.identity.{NodeId, Step, StepTable, same_step}

/// What the matcher reads of an element: its number on the page, its seat
/// among its siblings, and whether it keeps another's place.
export trait Diffable {
    fn id() -> NodeId
    fn seat() -> Step
    /// Whether `now` is this element drawn again: the same kind, so it keeps
    /// this one's number and only its differences are said.
    fn keeps(now: Self) -> bool
    /// Whether `now` is this element drawn again unchanged, so it stands on the page as it was.
    fn unchanged(now: Self) -> bool
}

/// How an element of the new run stands against the old one: new to the
/// page, or kept from the element that stood at `at`.
export enum Stands<E> {
    Made(e: E)
    Kept(at: int, was: E, now: E)
}

/// One element on the page, wearing its number, and the next number to give.
export type Drawn<E> = { element: E, next: int }

/// A run of elements on the page and the next number to give.
export type Run<E> = { page: List<E>, next: int }

/// A target's side of a diff: how it says an element left or was placed, and
/// how it draws one by how it stands — a new one built whole, a kept one by
/// its differences, its children through `siblings` again.
export trait Draws<E> {
    fn removed(id: NodeId)
    fn placed(id: NodeId, parent: NodeId?, after: NodeId?)
    fn drawn(p: Stands<E>, next: int) -> Drawn<E>
}

/// One parent's children: what left is removed, what stays is drawn where it
/// stands, and what is new or moved is placed after the sibling it now
/// follows.
export fn siblings<E: Diffable, D: Draws<E>>(
    d: D,
    parent: NodeId?,
    old: List<E>,
    new: List<E>,
    next: int,
) -> Run<E> {
    let pairs = matched(old, new)
    let was = [stood(p) for p in pairs]
    let held = marked(old.length, [at! for at in was if at != null])
    for j, e in old {
        if !held[j] { d.removed(e.id()) }
    }
    let stays = still(was)
    mut page: List<E> = []
    let free: Cell<int> = Cell.new(next)
    // LICENSED loops.push_loop: each element takes the numbers the ones before it left
    for j, p in pairs {
        let e = unchanged(p) ?? drawn_from(d, p, free)
        if !stays[j] { d.placed(e.id(), parent, page.last()?.id()) }
        page.push(e)
    }
    Run { page: page, next: free.get() }
}

/// The old element a pair keeps as it stood, when it is drawn again unchanged.
fn unchanged<E: Diffable>(p: Stands<E>) -> E? {
    match p { .Made(_) -> null, .Kept(_, was, now) -> if was.unchanged(now) { was } else { null } }
}

/// `p` drawn, numbered from what `free` holds, which then holds the next number to give.
fn drawn_from<E, D: Draws<E>>(d: D, p: Stands<E>, free: Cell<int>) -> E {
    let drawn = d.drawn(p, free.get())
    free.set(drawn.next)
    drawn.element
}

/// Where in the old run an element stood — nowhere for a new one.
fn stood<E>(p: Stands<E>) -> int? {
    match p { .Made(_) -> null, .Kept(at, _, _) -> at }
}

/// `e` against the old element at `at`.
fn standing_at<E: Diffable>(old: E, at: int, e: E) -> Stands<E> {
    if old.keeps(e) { Stands.Kept(at, old, e) } else { Stands.Made(e) }
}

/// `e` against whichever element of `old` stands at its seat.
fn found<E: Diffable>(old: List<E>, at: StepTable, e: E) -> Stands<E> {
    let j? = at.find(e.seat()) else { return Stands.Made(e) }
    standing_at(old[j], j, e)
}

/// Whether two runs hold the same seats in the same order.
fn pair_off<E: Diffable>(old: List<E>, new: List<E>) -> bool {
    if old.length != new.length { return false }
    for j, e in new {
        if !same_step(old[j].seat(), e.seat()) { return false }
    }
    true
}

/// Each element of `new` against the old run, matched by seat. Two runs that
/// pair off in order, as an unchanged list does, are matched without a table.
export fn matched<E: Diffable>(old: List<E>, new: List<E>) -> List<Stands<E>> {
    if pair_off(old, new) { return [standing_at(old[j], j, e) for j, e in new] }
    let at = StepTable.of([e.seat() for e in old])
    [found(old, at, e) for e in new]
}

/// One mark per element of a run of `length`, true at each place in `at`.
fn marked(length: int, at: List<int>) -> List<bool> {
    let marks: Cell<List<bool>> = Cell.new([false for j in 0..length])
    for j in at { marks.set_at(j, true) }
    marks.get()
}

/// The first place in `tails` whose element stood at or past `stood`, by
/// halving: `tails` holds places in rising order of where they stood.
fn first_not_before(tails: List<int>, was: List<int>, stood: int) -> int {
    mut low = 0
    mut high = tails.length
    while low < high {
        let mid = (low + high) / 2
        if was[tails[mid]] < stood { low = mid + 1 } else { high = mid }
    }
    low
}

/// Whether the kept elements' old places already rise, so every one of them stands still.
fn rising(stood: List<int?>) -> bool {
    let kept = [at! for at in stood if at != null]
    (1..kept.length).all(kept[it - 1] < kept[it])
}

/// WHICH KEPT ELEMENTS STAND STILL: the longest run of them whose old places
/// still rise, so the fewest are moved — a row carried to the front is one
/// move, whatever the length of the list. `stood` is each new element's old
/// place; the answer marks, per new element, the ones that stay where they
/// are. Patience sorting: `tails[k]` is the element ending the best rising
/// run of length k + 1, `before` the one it follows.
export fn still(stood: List<int?>) -> List<bool> {
    if rising(stood) { return [at != null for at in stood] }
    let kept = [j for j, at in stood if at != null]
    let was = [at ?? 0 for at in stood]
    let tails: Cell<List<int>> = Cell.new([])
    let before: Cell<List<int>> = Cell.new([-1 for j in stood])
    for j in kept {
        let k = first_not_before(tails.get(), was, was[j])
        if k > 0 { before.set_at(j, tails.get()[k - 1]) }
        if k == tails.get().length { tails.push(j) } else { tails.set_at(k, j) }
    }
    let run: Cell<List<int>> = Cell.new([])
    mut at = tails.get().last() ?? -1
    let follows = before.get()
    // LICENSED loops.push_loop: a chain walked back link by link
    while at >= 0 {
        run.push(at)
        at = follows[at]
    }
    marked(stood.length, run.get())
}
