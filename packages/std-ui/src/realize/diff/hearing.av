//! `realize/diff/hearing.av` — WHO HEARS WHAT, for any target's elements: the
//! handlers a paint bound, by the element that hears each, and the owner keys
//! a page gives the controls it shows.
use tree.identity.{NodeId, Owner}
use tree.node.{Action}
use tree.seats.{Seat}

/// What a page reads of an element to know what it hears: the handlers it
/// binds itself, and the elements it holds.
export trait Hears {
    fn bound() -> List<Bound>
    fn held() -> List<Self>
}

/// An element that hears an event, and what it does then.
export type Bound = { id: NodeId, action: Action, ordered: bool }

/// Every handler an element and what it holds bound, by who hears it.
export fn bound_in<E: Hears>(e: E) -> List<Bound> { e.bound().concat([b for k in e.held() for b in bound_in(k)]) }

/// Every handler a run of elements bound.
export fn bound_on<E: Hears>(page: List<E>) -> List<Bound> { [b for e in page for b in bound_in(e)] }

/// The owner keys of the elements that hear something: a node's number, the
/// identity a page gives it while it stays.
export fn owners_of(bound: List<Bound>) -> List<Owner> { [Owner { key: "${b.id.n}", ordered: b.ordered } for b in bound] }

/// The handler `id` bound at `seat`, if any.
export fn bound_at(bound: List<Bound>, id: NodeId, seat: Seat) -> Action? { bound.find(it.id == id && it.action.seat == seat)?.action }
