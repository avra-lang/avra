//! The matcher over a vocabulary of its own: elements that are a name and a
//! kind, a target that records what it is told. What a run keeps, moves,
//! removes and makes anew is the matcher's alone.
use @std.ui.realize.diff.matcher.{Diffable, Draws, Drawn, Stands, siblings, still}
use @std.ui.tree.identity.{NodeId, Step, unplaced}

/// An element of a toy vocabulary: its number, its name as its seat, its kind.
type Toy = { id: NodeId = unplaced, name: string, kind: string = "box" }

impl Diffable for Toy {
    fn id() -> NodeId { self.id }

    fn seat() -> Step { Step.Part(self.name) }

    fn keeps(now: Toy) -> bool { self.kind == now.kind }

    fn unchanged(_now: Toy) -> bool { false }
}

/// A target that writes down what it was told, one word a line.
type Told = { lines: Cell<List<string>> = Cell.new([]) }

impl Draws<Toy> for Told {
    fn removed(id: NodeId) { self.lines.push("remove ${id.n}") }

    fn placed(id: NodeId, parent: NodeId?, after: NodeId?) { self.lines.push("place ${id.n} after ${after?.n ?? -1}") }

    fn drawn(p: Stands<Toy>, next: int) -> Drawn<Toy> {
        match p {
            .Made(e) -> {
                self.lines.push("make ${e.name} as ${next}")
                Drawn { element: e with { id: NodeId { n: next } }, next: next + 1 }
            },
            .Kept(_, was, now) -> Drawn { element: now with { id: was.id }, next: next },
        }
    }
}

/// Which elements stand still, as one word: `s` still, `m` moved.
fn stills(stood: List<int?>) -> string { [if s { "s" } else { "m" } for s in still(stood)].join("") }

fn toys(names: List<string>) -> List<Toy> { [Toy { name: n } for n in names] }

/// What a target is told when `old`, first drawn, is drawn again as `new`.
fn told(old: List<Toy>, new: List<Toy>) -> List<string> {
    let first = siblings(Told {}, null, [], old, 0)
    let t = Told {}
    let _ = siblings(t, null, first.page, new, first.next)
    t.lines.get()
}

spec "std/ui diff — the matcher" {
    given "a run drawn again in another order" {
        then "a row carried to the front is the one move" { told(toys(["a", "b", "c"]), toys(["c", "a", "b"])).join(" | ") == "place 2 after -1" }
        then "an unchanged run says nothing" { told(toys(["a", "b"]), toys(["a", "b"])).is_empty() }
    }
    given "a run that loses and gains" {
        then "the one that left is removed and the new one made and placed" {
            told(toys(["a", "b"]), toys(["a", "c"])).join(" | ") == "remove 1 | make c as 2 | place 2 after 0"
        }
        then "a seat whose kind changed is made anew" {
            told(toys(["a"]), [Toy { name: "a", kind: "label" }]).join(" | ") == "remove 0 | make a as 1 | place 1 after -1"
        }
    }
    given "the old places of a run" {
        then "places that rise all stand still" { stills([0, 1, 2]) == "sss" }
        then "one carried to the front moves alone" { stills([2, 0, 1]) == "mss" }
        then "a new element never stands still" { stills([null, 0]) == "ms" }
        then "places that rise around new ones all stand still" { stills([0, null, 3, 5]) == "smss" }
        then "a run that falls keeps the one longest rise" { stills([1, null, 0]) == "mms" }
    }
}
