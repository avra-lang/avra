//! The semantic target, by its law: one tree, read as typed ops.
use @std.ui.realize.describe.describe.{Describe, DescOp, Group, trace}
use @std.ui.realize.realizer.{drawn}
use @std.ui.components.{text, heading, button, column, row}

fn group_word(g: Group) -> string {
    match g { .Column -> "col", .Row -> "row" }
}

fn op_word(op: DescOp) -> string {
    match op {
        .Text(s) -> "text:${s}",
        .Heading(s, n) -> "h${n}:${s}",
        .Button(s) -> "btn:${s}",
        .Open(g, k) -> "open:${group_word(g)}:${k ?? "-"}",
        .Close -> "close",
    }
}

fn trace_words(ops: List<DescOp>) -> string { [op_word(o) for o in ops].join("|") }

fn page() -> string {
    let d = Describe {}
    let c = column {
        key: "cart"
        items: [heading "Shop" { rank: 2 }, text "hi", button "Buy"]
    }
    drawn([c], d)
    trace_words(trace(d))
}

fn nested() -> string {
    let d = Describe {}
    let c = column {
        items: [row { items: [text "a", text "b"] }]
    }
    drawn([c], d)
    trace_words(trace(d))
}

spec "std/ui describe — the semantic trace" {
    given "a column of heading, text and button" {
        then "reads as typed ops, in order" {
            page() == "open:col:cart|h2:Shop|text:hi|btn:Buy|close"
        }
    }
    given "a column holding a row" {
        then "nests the groups" {
            nested() == "open:col:-|open:row:-|text:a|text:b|close|close"
        }
    }
}
