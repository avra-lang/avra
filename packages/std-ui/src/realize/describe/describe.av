//! `realize/describe/describe.av` — the semantic target. It draws the same
//! tree as a target-neutral op list: what the inspector, a diff, a test
//! snapshot and an agent read. One more realizer over the same tree, never
//! a second type system. UI.md §19.1.
use realize.realizer.{Realizer}
use components.{text, heading, button, column, row}

/// Which container a node is.
export enum Group { Column, Row }

/// One semantic piece a tree is made of.
export enum DescOp {
    Text(content: string)
    Heading(content: string, rank: int)
    Button(label: string)
    Open(group: Group, key: string?)
    Close
}

/// The semantic target: one accumulator of ops.
export type Describe = { ops: Cell<List<DescOp>> = Cell.new([]) }

impl Realizer for Describe {
    fn text(t: text) { self.ops.push(DescOp.Text(t.content)) }
    fn heading(hd: heading) { self.ops.push(DescOp.Heading(hd.content, hd.rank)) }
    fn button(b: button) { self.ops.push(DescOp.Button(b.label)) }
    fn column_begin(c: column) { self.ops.push(DescOp.Open(Group.Column, c.key)) }
    fn column_end() { self.ops.push(DescOp.Close) }
    fn row_begin(r: row) { self.ops.push(DescOp.Open(Group.Row, r.key)) }
    fn row_end() { self.ops.push(DescOp.Close) }
}

/// The semantic trace, in drawing order.
export fn trace(d: Describe) -> List<DescOp> { d.ops.get() }
