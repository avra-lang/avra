//! `realize/sink.av` — ONE walk, every target. A target answers three
//! operations; the tree is walked here and nowhere else. The walk owns
//! each node's IDENTITY (`realize/identity.av`), so no target recomputes
//! who a node is or where it sits.
use realize.identity.{NodeId, root_id, steps}
use realize.render.{Node}

/// What a target answers while a tree is walked. `opened` is handed the
/// node's id, its parent's — absent at the root — and its index among
/// its siblings; `words` its own words under that id; `closed` its end.
export trait Sink {
    fn opened(id: NodeId, parent: NodeId?, index: int, n: Node)
    fn words(id: NodeId, s: string)
    fn closed(n: Node)
}

/// The walk: a node opened, its words, its children, then closed.
export fn draw(n: Node, sink: dyn Sink) { walk(n, root_id(n.box.key), null, 0, sink) }

fn walk(n: Node, id: NodeId, parent: NodeId?, index: int, sink: dyn Sink) {
    sink.opened(id, parent, index, n)
    sink.words(id, n.words())
    let under = steps([c.box.key for c in n.children])
    for i, c in n.children { walk(c, id.child(under[i]), id, i, sink) }
    sink.closed(n)
}
