//! `realize/sink.av` — ONE walk, every target. A target answers three
//! operations; the tree is walked here and nowhere else.
use realize.render.{Node}

/// What a target answers while a tree is walked.
export trait Sink {
    fn opened(n: Node)
    fn words(s: string)
    fn closed(n: Node)
}

/// The walk: a node opened, its words, its children, then closed.
export fn draw(n: Node, sink: dyn Sink) {
    sink.opened(n)
    sink.words(n.words())
    for c in n.children { draw(c, sink) }
    sink.closed(n)
}
