//! `realize/native/fact.av` — A NATIVE ELEMENT'S FACTS: what a node says, as
//! a typed code and the one scalar it holds. A fact is at once what the diff
//! compares, what a frame sends and what a host's table is keyed by, so a
//! node's attributes, style, layout and theme are each projected to facts
//! ONCE, every arm spelled: a new attribute or style field breaks the build
//! until a native target answers it. A value at its default says no fact.
use @std.meta.{derive}
use @std.assets.{Picture}
use tree.codes.{Codes}
use frame.derive.{Frame}
use tree.node.{Attribute, Node}
use style.style.{Style, Interaction}
use style.layout.{Layout, Axis, Wrap, Align, Distribute, Sizing, Edge}
use style.tokens.{Size}
use style.theme.{Theme}

/// What a fact holds.
@derive(Frame)
export enum Scalar {
    @code(1) Text(value: string)
    @code(2) Flag(value: bool)
    @code(3) Number(value: int)
    @code(4) Fraction(value: float)
}

/// Whether two scalars are one value. A NaN is the same NaN, so a fact
/// holding one never reads as changed.
// LICENSED compiler.trait_family: a fraction may be NaN, and a NaN fact is the same NaN so it never reads as changed
export fn same(a: Scalar, b: Scalar) -> bool {
    match a {
        .Text(x) -> match b { .Text(y) -> x == y, .Flag(_) or .Number(_) or .Fraction(_) -> false },
        .Flag(x) -> match b { .Flag(y) -> x == y, .Text(_) or .Number(_) or .Fraction(_) -> false },
        .Number(x) -> match b { .Number(y) -> x == y, .Text(_) or .Flag(_) or .Fraction(_) -> false },
        .Fraction(x) -> match b {
            .Fraction(y) -> x == y || x != x && y != y,
            .Text(_) or .Flag(_) or .Number(_) -> false,
        },
    }
}

/// What a fact is about: the number a frame spells it with.
@derive(Codes)
export enum What {
    @code(1) Words
    @code(2) Label
    @code(3) Rank
    @code(4) Value
    @code(5) Amount
    @code(6) Placeholder
    @code(7) Source
    @code(8) SourceWidth
    @code(9) SourceHeight
    @code(10) Alt
    @code(11) Decorative
    @code(12) Href
    @code(13) Min
    @code(14) Max
    @code(15) Disabled
    @code(16) Checked
    @code(17) Selected
    @code(18) Open
    @code(19) Invalid
    @code(20) Loading
    @code(21) Urgency
    @code(22) Title
    @code(23) Name
    @code(24) Submits
    @code(25) Masked
    @code(26) SkippedPath
    @code(27) SkippedRows
    @code(28) SkippedExtent
    @code(29) PlacedAt
    @code(30) PlacedOf
    @code(31) Reveal
    @code(32) SubmitLabel
    @code(40) Radius
    @code(41) Fill
    @code(42) Ink
    @code(43) Elevation
    @code(44) Face
    @code(45) TextSize
    @code(46) LineHeight
    @code(47) Tracking
    @code(48) WordsWriting
    @code(60) Direction
    @code(61) Wrap
    @code(62) Gap
    @code(63) PadStart
    @code(64) PadEnd
    @code(65) PadTop
    @code(66) PadBottom
    @code(67) MarginStart
    @code(68) MarginEnd
    @code(69) MarginTop
    @code(70) MarginBottom
    @code(71) Align
    @code(72) Distribute
    @code(73) Width
    @code(74) Height
    @code(75) Grow
    @code(76) Aspect
    @code(77) InsetStart
    @code(78) InsetEnd
    @code(79) InsetTop
    @code(80) InsetBottom
    @code(81) Order
    @code(90) Mode
    @code(91) Contrast
    @code(92) Writing
}

/// One fact: what it is about, the interaction it holds under (none for the
/// node at rest), and its value.
@derive(Frame)
export type Fact = { what: What, under: Interaction? = null, holds: Scalar }

/// Whether a fact about `w` can move a box: a change to it may change a node's
/// size or where its children stand, so the tree is placed again. Every code
/// spelled; one that only changes how a box looks, or what it says to a reader,
/// moves nothing.
export fn moves_box(w: What) -> bool {
    match w {
        .Words or .Label or .Rank or .Placeholder or .Source or .SourceWidth or .SourceHeight or .Open or .Title or .SkippedRows or .SkippedExtent or .Face or .TextSize or .LineHeight or .Tracking or .Direction or .Wrap or .Gap or .PadStart or .PadEnd or .PadTop or .PadBottom or .MarginStart or .MarginEnd or .MarginTop or .MarginBottom or .Align or .Distribute or .Width or .Height or .Grow or .Aspect or .InsetStart or .InsetEnd or .InsetTop or .InsetBottom or .Order or .Contrast or .Writing or .WordsWriting -> true,
        .Value or .Amount or .Alt or .Decorative or .Href or .Min or .Max or .Disabled or .Checked or .Selected or .Invalid or .Loading or .Urgency or .Name or .Submits or .SubmitLabel or .Masked or .SkippedPath or .PlacedAt or .PlacedOf or .Reveal or .Fill or .Ink or .Radius or .Elevation or .Mode -> false,
    }
}

/// Whether two facts are about the same thing.
export fn about(a: Fact, b: Fact) -> bool { a.what.code() == b.what.code() && a.under == b.under }

/// Whether two facts say the same thing of it.
export fn agree(a: Fact, b: Fact) -> bool { about(a, b) && same(a.holds, b.holds) }

fn text(what: What, value: string) -> List<Fact> { [Fact { what: what, holds: .Text(value) }] }

fn flag(what: What, on: bool) -> List<Fact> { if on { [Fact { what: what, holds: .Flag(true) }] } else { [] } }

fn number(what: What, n: int) -> List<Fact> { [Fact { what: what, holds: .Number(n) }] }

/// A token, when one is present.
fn word(what: What, w: string?) -> List<Fact> {
    let present? = w else { return [] }
    text(what, present)
}

/// What an attribute says. Every arm spelled. A row's place in a windowed list is the
/// page's reading-order bookkeeping; a native host lays out and reads its own rows, so it
/// is told only when to bring one into view.
export fn attribute_facts(a: Attribute) -> List<Fact> {
    match a {
        .Text(t) -> text(.Words, t),
        .Label(t) -> text(.Label, t),
        .Level(rank) -> number(.Rank, rank),
        .Value(t) -> text(.Value, t),
        .Amount(n) -> number(.Amount, n),
        .Placeholder(t) -> text(.Placeholder, t),
        .Source(p) -> picture_facts(p),
        .Alt(t) -> text(.Alt, t),
        .Decorative(on) -> flag(.Decorative, on),
        .Href(u) -> text(.Href, u.text()),
        .Min(n) -> number(.Min, n),
        .Max(n) -> number(.Max, n),
        .Disabled(on) -> flag(.Disabled, on),
        .Checked(on) -> flag(.Checked, on),
        .Selected(on) -> flag(.Selected, on),
        .Open(on) -> flag(.Open, on),
        .Invalid(on) -> flag(.Invalid, on),
        .Loading(on) -> flag(.Loading, on),
        .Urgency(u) -> text(.Urgency, u.word()),
        .Title(t) -> text(.Title, t),
        .Name(t) -> text(.Name, t),
        .Submits(on) -> flag(.Submits, on),
        .Masked(on) -> flag(.Masked, on),
        .SubmitLabel(label) -> text(.SubmitLabel, label.word()),
        .Skipped(path, rows, extent) -> text(.SkippedPath, path)
            .concat(number(.SkippedRows, rows))
            .concat(number(.SkippedExtent, extent)),
        .Placed(_, _, reveal) -> flag(.Reveal, reveal),
    }
}

/// A picture as where it is read from and the size it keeps.
fn picture_facts(p: Picture) -> List<Fact> {
    match p {
        .Bundled(name, width, height, _, _, _) -> text(.Source, "/assets/${name}")
            .concat(number(.SourceWidth, width))
            .concat(number(.SourceHeight, height)),
        .Remote(url, width, height) -> text(.Source, url.text())
            .concat(number(.SourceWidth, width))
            .concat(number(.SourceHeight, height)),
    }
}

/// What a style says at rest, then under each interaction. Every field spelled.
export fn style_facts(s: Style) -> List<Fact> {
    rest_facts(s)
        .concat([f with { under: st.state } for st in s.states for f in rest_facts(st.style)])
}

/// A style's own fields, each read: a field this leaves out is `type.record_pattern`'s refusal.
fn rest_facts(s: Style) -> List<Fact> {
    let Style { radius, fill, color, elevation, face, text_size, line_height, tracking, writing, states: _ } = s
    word(.Radius, radius?.word())
        .concat(word(.Fill, fill?.word()))
        .concat(word(.Ink, color?.word()))
        .concat(word(.Elevation, elevation?.word()))
        .concat(word(.Face, face?.word()))
        .concat(word(.TextSize, text_size?.word()))
        .concat(word(.LineHeight, line_height?.word()))
        .concat(word(.Tracking, tracking?.word()))
        .concat(word(.WordsWriting, writing?.word()))
}

/// What a layout says, each field read: a field this leaves out is `type.record_pattern`'s refusal.
export fn layout_facts(l: Layout) -> List<Fact> {
    let Layout { direction, wrap, gap, pad, margin, align, distribute, width, height, grow, aspect, inset, order } = l
    word(.Direction, axis_word(direction))
        .concat(word(.Wrap, wrap_word(wrap)))
        .concat(word(.Gap, gap?.word()))
        .concat(edge_facts(pad, [.PadStart, .PadEnd, .PadTop, .PadBottom]))
        .concat(edge_facts(margin, [.MarginStart, .MarginEnd, .MarginTop, .MarginBottom]))
        .concat(word(.Align, align_word(align)))
        .concat(word(.Distribute, distribute_word(distribute)))
        .concat(sizing_facts(.Width, width))
        .concat(sizing_facts(.Height, height))
        .concat(if grow == 0 { [] } else { number(.Grow, grow) })
        .concat(fraction_facts(.Aspect, aspect))
        .concat(edge_facts(inset, [.InsetStart, .InsetEnd, .InsetTop, .InsetBottom]))
        .concat(if order == 0 { [] } else { number(.Order, order) })
}

/// The direction a node is laid out in, where it is another than the one the node above it was.
export fn writing_facts(n: Node) -> List<Fact> {
    let stamp? = n.theme else { return [] }
    if stamp.rewritten { text(.Writing, stamp.writing.word()) } else { [] }
}

/// The theme a tree is drawn in: its mode and its contrast.
export fn theme_facts(t: Theme) -> List<Fact> { text(.Mode, t.mode.word()).concat(text(.Contrast, t.contrast.word())) }

/// An edge's steps, one fact a side, `sides` naming start, end, top, bottom.
fn edge_facts(e: Edge?, sides: List<What>) -> List<Fact> {
    let present? = e else { return [] }
    [f for j, z in [present.start, present.end, present.top, present.bottom] for f in word(sides[j], z?.word())]
}

fn sizing_facts(what: What, s: Sizing?) -> List<Fact> {
    let present? = s else { return [] }
    match present {
        .Hug -> text(what, "hug"),
        .Fill -> text(what, "fill"),
        .Fixed(n) -> number(what, n),
        .Percent(f) -> [Fact { what: what, holds: .Fraction(f) }],
    }
}

fn fraction_facts(what: What, f: float?) -> List<Fact> {
    let present? = f else { return [] }
    [Fact { what: what, holds: .Fraction(present) }]
}

fn axis_word(a: Axis?) -> string? {
    let present? = a else { return null }
    match present { .Row -> "row", .Column -> "column" }
}

fn wrap_word(w: Wrap?) -> string? {
    let present? = w else { return null }
    match present { .NoWrap -> "nowrap", .Wrap -> "wrap", .WrapReverse -> "wrap_reverse" }
}

fn align_word(a: Align?) -> string? {
    let present? = a else { return null }
    match present {
        .Start -> "start",
        .Center -> "center",
        .End -> "end",
        .Stretch -> "stretch",
        .Baseline -> "baseline",
    }
}

fn distribute_word(d: Distribute?) -> string? {
    let present? = d else { return null }
    match present {
        .Start -> "start",
        .Center -> "center",
        .End -> "end",
        .SpaceBetween -> "space_between",
        .SpaceAround -> "space_around",
        .SpaceEvenly -> "space_evenly",
    }
}
