//! `realize/native/element.av` — A NATIVE ELEMENT: one per node, its prim,
//! its facts, what it hears and its children, standing at the node's own
//! step. A native host composes its own control from the prim and its facts,
//! so a title, a label or a control's words are facts, never children.
use tree.identity.{NodeId, Step, StepTable, root as root_step, same_step, stepped, unplaced}
use tree.node.{Node, Prim, Action}
use realize.diff.matcher.{Diffable}
use realize.diff.hearing.{Bound, Hears}
use style.theme.{plain}
use realize.native.fact.{
    Fact,
    attribute_facts,
    style_facts,
    layout_facts,
    theme_facts,
    writing_facts,
}

/// One node as a native host draws it. `id` is the number a diff gave it —
/// none until one places it.
export type Native = {
    id: NodeId = unplaced,
    seat: Step,
    prim: Prim,
    facts: List<Fact> = [],
    hears: List<Action> = [],
    kids: List<Native> = [],
    ordered: bool = false,
    from: int = 0,
    /// What it and what it holds hear, in order, once a diff numbered them.
    heard: List<Bound> = [],
}

impl Diffable for Native {
    /// Its number on the page.
    fn id() -> NodeId { self.id }

    /// Where it stands among its siblings.
    fn seat() -> Step { self.seat }

    /// An element keeps one of its own prim.
    fn keeps(now: Native) -> bool { self.prim == now.prim }
}

impl Hears for Native {
    /// The handlers it binds.
    fn bound() -> List<Bound> { [Bound { id: self.id, action: a, ordered: self.ordered } for a in self.hears] }

    /// What it holds.
    fn held() -> List<Native> { self.kids }
}

/// The tree as native elements: the root wears the theme it was drawn in,
/// the plain one when none was stamped.
export fn lowered(root: Node) -> List<Native> {
    let drawn = lower(root, root_step(root.box.key), false)
    [drawn with { facts: drawn.facts.concat(theme_facts(root.theme?.theme ?? plain())) }]
}

/// A node's address: its identity while something holds it, 0 for a value no header stands before.
extern fn avra_box_key(cell: Node) -> int

/// What a paint lowered a root to, the root held so every address under it stays its own.
export type LoweredAt = { node: Node, el: Native }

/// The lowering a page keeps between paints: the root it last lowered, and its element.
export alias Lowering = Cell<List<LoweredAt>>

/// A lowering nothing was kept in.
export fn no_lowering() -> Lowering {
    let none: List<LoweredAt> = []
    Cell.new(none)
}

/// `lowered`, reusing the element the last paint lowered a node to while the node is the
/// same node at the same step: a node is a value, so the same node lowers alike.
export fn lowered_kept(root: Node, kept: Lowering) -> List<Native> {
    let at = root_step(root.box.key)
    let was = kept.get().first()?.el
    let drawn = lower_from(
        root,
        at,
        false,
        if was != null && same_step(was!.seat, at) { was } else { null },
    )
    kept.set([LoweredAt { node: root, el: drawn }])
    [drawn with { facts: drawn.facts.concat(theme_facts(root.theme?.theme ?? plain())) }]
}

/// `n` lowered at `at`, against `was`, the element last lowered at that step: kept whole when it
/// is the same node, lowered in the same order.
fn lower_from(n: Node, at: Step, ordered: bool, was: Native?) -> Native {
    let from = avra_box_key(n)
    if was != null && from != 0 && was!.from == from && was!.ordered == ordered { return was! }
    let stands = stepped([c.box.stand() for c in n.children])
    let olds = PriorKids.of(was?.kids ?? [], stands.steps)
    Native {
        seat: at,
        prim: n.prim,
        facts: node_facts(n),
        hears: n.events,
        kids: [lower_from(c, stands.steps[j], ordered || c.drawn_by_order || stands.shared[j], olds.at(j)) for j, c in n.children],
        ordered: ordered,
        from: from,
    }
}

/// The children a node was last lowered to, found by the steps its children stand at now: by
/// place while the two runs stand step for step alike, else through a table of the old steps.
type PriorKids = { kids: List<Native>, steps: List<Step>, found: StepTable? }

impl PriorKids {
    static fn of(kids: List<Native>, steps: List<Step>) -> PriorKids {
        if kids.is_empty() || aligned(kids, steps) { return PriorKids { kids: kids, steps: steps, found: null } }
        PriorKids { kids: kids, steps: steps, found: StepTable.of([k.seat for k in kids]) }
    }

    /// The element last lowered at the step the child at `j` stands at, if any.
    fn at(j: int) -> Native? {
        let by_step? = self.found else { return if j < self.kids.length { self.kids[j] } else { null } }
        let old? = by_step.find(self.steps[j]) else { return null }
        self.kids[old]
    }
}

/// Whether old children stand step for step where new ones do.
fn aligned(kids: List<Native>, steps: List<Step>) -> bool {
    kids.length == steps.length && (0..steps.length).all(same_step(kids[it].seat, steps[it]))
}

/// `n` standing at `at`, and its children each at its own step. A node is
/// ordered when it, or what holds it, is told from a sibling by order alone.
fn lower(n: Node, at: Step, ordered: bool) -> Native {
    let stands = stepped([c.box.stand() for c in n.children])
    Native {
        seat: at,
        prim: n.prim,
        facts: node_facts(n),
        hears: n.events,
        kids: [lower(c, stands.steps[j], ordered || c.drawn_by_order || stands.shared[j]) for j, c in n.children],
        ordered: ordered,
    }
}

/// What a node says: its attributes, its style, its layout and the direction it is laid out in.
fn node_facts(n: Node) -> List<Fact> {
    [f for a in n.attrs for f in attribute_facts(a)]
        .concat(style_facts(n.box.style))
        .concat(layout_facts(n.box.layout))
        .concat(writing_facts(n))
}
