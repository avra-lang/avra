//! The native page between paints: what it says, who it tells, and who hears.
use @std.ui.realize.native.live.{native_live}
use @std.ui.realize.native.patch.{NativePatch}
use @std.ui.realize.tests.support.{holding, keyed, text_node, button_node, switch_node}
use @std.ui.realize.tests.support.seats.{Event, hearing, seat_for}
use @std.ui.tree.identity.{NodeId}
use @std.ui.tree.node.{Node, Handler, Said}

/// What the handlers under test heard, in order.
once fn heard() -> Cell<List<string>> { Cell.new([]) }

fn pressed() { heard().push("pressed") }

fn flipped(on: bool) { heard().push("flipped ${on}") }

fn counter(n: int) -> Node {
    holding(
        .Column,
        [text_node("taps: ${n}"), hearing(button_node("taps+"), .Press, Handler.Nothing(pressed))],
    )
}

fn row(title: string) -> Node {
    keyed(
        holding(.Item, [hearing(switch_node(title, false), .Change, Handler.Flag(flipped))]),
        title,
    )
}

fn board(titles: List<string>) -> Node { holding(.List, [row(t) for t in titles]) }

fn kind(p: NativePatch) -> string {
    match p {
        .Create(_, _) -> "create",
        .SetFact(_, _) -> "set",
        .DropFact(_, _, _) -> "drop",
        .Place(_, _, _) -> "place",
        .Remove(_) -> "remove",
        .Listen(_, _) -> "listen",
        .Unlisten(_, _) -> "unlisten",
    }
}

/// What the second of two paints says, one word a patch.
fn second(first: Node, next: Node) -> string {
    let page = native_live()
    let _ = page.patches(first)
    [kind(p) for p in page.patches(next)].join(" | ")
}

/// What the second paint of the same rows, held between paints, says when it lays them out as
/// `order` and puts `swapped` in for the row at 1.
fn held_rows(order: List<int>, swapped: Node?) -> string {
    let rows = [row(t) for t in ["a", "b", "c"]]
    let page = native_live()
    let _ = page.patches(holding(.List, rows))
    let laid = [if j == 1 && swapped != null { swapped! } else { rows[j] } for j in order]
    [kind(p) for p in page.patches(holding(.List, laid))].join(" | ")
}

/// The number the page gave the first element that hears something.
fn first_hearer(root: Node) -> NodeId? {
    let page = native_live()
    let _ = page.patches(root)
    page.bound.get().first()?.id
}

/// Whether firing the press on a freshly painted counter ran its handler.
fn press_runs() -> bool {
    let page = native_live()
    let _ = page.patches(counter(0))
    let id? = page.bound.get().first()?.id else { return false }
    let before = heard().get().length
    page.fire(id, seat_for(.Press), null) &&
        heard().get().length == before + 1 &&
        heard().get().last() == "pressed"
}

/// Whether a flag said on a row's switch reaches its handler.
fn flip_runs() -> bool {
    let page = native_live()
    let _ = page.patches(board(["a"]))
    let id? = page.bound.get().first()?.id else { return false }
    page.fire(id, seat_for(.Change), Said.Flag(true)) && heard().get().last() == "flipped true"
}

spec "std/ui native — the page between paints" {
    given "two paints" {
        then "a text change is one set" { second(counter(0), counter(1)) == "set" }
        then "the same tree says nothing" { second(counter(2), counter(2)) == "" }
        then "a reorder of keyed rows is places only" { second(board(["a", "b", "c"]), board(["c", "a", "b"])) == "place" }
        then "a removed row is one remove" { second(board(["a", "b"]), board(["b"])) == "remove" }
        then "the same rows again say nothing" { held_rows([0, 1, 2], null) == "" }
        then "the same rows reordered are places only" { held_rows([2, 0, 1], null) == "place" }
        then "a row put in among the same rows says its own change" {
            held_rows([0, 1, 2], keyed(holding(.Item, [switch_node("b", true)]), "b")) == "set | unlisten"
        }
    }
    given "a seat the page listens to" {
        then "a press runs its handler" { press_runs() }
        then "a flag reaches its handler" { flip_runs() }
        then "a seat nothing bound answers false" {
            let page = native_live()
            let _ = page.patches(counter(0))
            !page.fire(NodeId { n: 999 }, seat_for(.Press), null)
        }
    }
    given "the owners" {
        then "each control that hears is an owner" {
            let page = native_live()
            let _ = page.patches(board(["a", "b"]))
            page.owners().length == 2
        }
        then "an owner is keyed by its element's number" { first_hearer(counter(0)) != null }
    }
}
