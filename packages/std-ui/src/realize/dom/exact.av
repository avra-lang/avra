//! `realize/dom/exact.av` — EXACT PATCHES: a state write updates only the
//! text that reads it. A SITE is one text node whose words hold a value
//! computed from state. The page watches the CELLS its sites read: at mount
//! each site observes its cells and the page files the cells' keys under the
//! site; a turn asks which observed cells were written, recomputes only the
//! sites under them, and says `SetText` where the words changed. A site the
//! compiler cannot place (an opaque call, a structure change) is not here at
//! all and the full paint speaks for it.
//!
//! A SITE HOLDS NO CELL. The compiler writes each site's `observe` as a
//! closure over the typed cells it reads, so a cell is handed to the runtime
//! at a pointer seat by the code that owns it, and what comes back is a KEY: a
//! number that names a box and opens nothing. The page indexes keys; it never
//! turns a number into a pointer.
//!
//! THE TURN'S ORDER IS THE LAW: the stamp moves on FIRST, then the log is
//! taken. A write after the stamp moved stores a stamp the observer has not
//! seen; read the log first and a write between the two is filed under the
//! stamp that is already spent.
use tree.identity.{NodeId}
use realize.dom.patch.{Patch}

extern fn avra_turn_next() -> int
extern fn avra_changes_take() -> List<int>

/// A text the page holds whose words read state. `words` recomputes the whole
/// text from the state as it stands; `observe` observes each cell the text
/// reads and answers their keys; `release` lets them go; `shown` is what the
/// page was last told.
export type Site = {
    node: NodeId,
    words: fn() -> string,
    observe: fn() -> List<int>,
    release: fn() -> void,
    shown: Cell<string>,
}

/// The sites a page watches, and the keys filed under them: a key as text maps
/// to the positions of the sites that read that cell.
export type Watch = { sites: List<Site>, under: Map<string, List<int>> }

fn key_of(key: int) -> string { "${key}" }

/// `sites` under watch: each observes its cells, and each key is filed under
/// the sites that gave it.
export fn watching(sites: List<Site>) -> Watch {
    mut index: Map<string, List<int>> = {}
    for at, site in sites {
        for key in site.observe() {
            index.set(key_of(key), (index.get(key_of(key)) ?? []).concat([at]))
        }
    }
    Watch { sites: sites, under: index }
}

impl Watch {
    /// The positions of the sites under the keys the runtime logged, each once.
    fn affected(changed: List<int>) -> List<int> {
        changed
            .fold([]) { seen, key ->
                let under = self.under.get(key_of(key)) ?? []
                seen.concat([i for i in under if !seen.contains(i)])
            }
    }

    /// One site brought up to date: the patch that says its new words, or none
    /// when they came out as they were (the cutoff).
    fn refreshed(at: int) -> List<Patch> {
        let site = self.sites[at]
        let now = (site.words)()
        if now == site.shown.get() { return [] }
        site.shown.set(now)
        [Patch.SetText(site.node, now)]
    }

    /// The cells observed again after the stamp wrapped: a box stamped a full
    /// cycle ago would read as already written this turn.
    fn observed_again() {
        for site in self.sites {
            let _ = site.observe()
        }
    }

    /// THE TURN: the stamp moves on first, the log is taken second, and only
    /// the sites under the changed cells are recomputed.
    fn turn() -> List<Patch> {
        if avra_turn_next() == 1 { self.observed_again() }
        [p for at in self.affected(avra_changes_take()) for p in self.refreshed(at)]
    }

    /// The page stops watching: every cell its sites observed is let go.
    fn released() {
        for site in self.sites { (site.release)() }
    }
}
