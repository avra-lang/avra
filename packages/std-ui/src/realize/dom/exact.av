//! `realize/dom/exact.av` — EXACT PATCHES: a state write updates only the
//! text that reads it. A SITE is one text node whose words hold a value
//! computed from state. The page watches the CELLS its sites read: at mount
//! each cell is observed and filed under its sites; a turn asks which observed
//! cells were written, recomputes only the sites under them, and says
//! `SetText` where the words changed. Every site the compiler cannot place
//! (an opaque call, a structure change) is not here at all and the full paint
//! speaks for it.
//!
//! THE TURN'S ORDER IS THE LAW: the stamp moves on FIRST, then the log is
//! taken. A write after the stamp moved stores a stamp the observer has not
//! seen; read the log first and a write between the two is filed under the
//! stamp that is already spent.
use tree.identity.{NodeId}
use realize.dom.patch.{Patch}

extern fn avra_ptr_at(address: int) -> ptr?
extern fn avra_box_observe(cell: ptr) -> int
extern fn avra_box_unobserve(cell: ptr) -> int
extern fn avra_turn_next() -> int
extern fn avra_changes_take() -> List<int>

/// A text the page holds whose words read state. `cells` are the state
/// cells (as the runtime names a box: its address) the value reads, `words`
/// recomputes the whole text from the state as it stands, and `shown` is what
/// the page was last told.
export type Site = { node: NodeId, cells: List<int>, words: fn() -> string, shown: Cell<string> }

/// The sites a page watches, the distinct cells they read, and the cells filed
/// under their sites: a cell's address as text maps to the positions of the
/// sites that read it.
export type Watch = { sites: List<Site>, cells: List<int>, under: Map<string, List<int>> }

/// A cell's key in the index.
fn key_of(cell: int) -> string { "${cell}" }

/// The positions of `sites` whose `cells` hold `cell`.
fn readers(sites: List<Site>, cell: int) -> List<int> { [i for i, s in sites if s.cells.contains(cell)] }

/// Every distinct cell the sites read, in the order first met.
fn cells_of(sites: List<Site>) -> List<int> {
    sites.fold([]) { seen, s -> seen.concat([c for c in s.cells if !seen.contains(c)]) }
}

/// The cell at an address, observed (false for an address that is no box).
fn observed(cell: int) -> bool {
    let box? = avra_ptr_at(cell) else { return false }
    avra_box_observe(box) == 1
}

/// The cell at an address, no longer observed.
fn released_cell(cell: int) {
    let box? = avra_ptr_at(cell) else { return }
    let _ = avra_box_unobserve(box)
}

/// `sites` under watch: each cell they read is observed and filed once.
export fn watching(sites: List<Site>) -> Watch {
    let cells = cells_of(sites)
    mut index: Map<string, List<int>> = {}
    for c in cells {
        let _ = observed(c)
        index.set(key_of(c), readers(sites, c))
    }
    Watch { sites: sites, cells: cells, under: index }
}

impl Watch {
    /// The positions of the sites under the cells the runtime logged, each once.
    fn affected(changed: List<int>) -> List<int> {
        changed
            .fold([]) { seen, c ->
                let under = self.under.get(key_of(c)) ?? []
                seen.concat([i for i in under if !seen.contains(i)])
            }
    }

    /// One site brought up to date: the patch that says its new words, or none
    /// when they came out as they were (the cutoff).
    fn refreshed(at: int) -> List<Patch> {
        let site = self.sites[at]
        let now = (site.words)()
        if now == site.shown.get() { return [] }
        site.shown.set(now)
        [Patch.SetText(site.node, now)]
    }

    /// The cells observed again after the stamp wrapped: a box stamped a full
    /// cycle ago would read as already written this turn.
    fn observed_again() {
        for c in self.cells { let _ = observed(c) }
    }

    /// THE TURN: the stamp moves on first, the log is taken second, and only
    /// the sites under the changed cells are recomputed.
    fn turn() -> List<Patch> {
        if avra_turn_next() == 1 { self.observed_again() }
        let changed = avra_changes_take()
        [p for at in self.affected(changed) for p in self.refreshed(at)]
    }

    /// The page stops watching: every cell it observed is let go.
    fn released() {
        for c in self.cells { released_cell(c) }
    }
}
