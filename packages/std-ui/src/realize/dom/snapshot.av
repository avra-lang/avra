//! `realize/dom/snapshot.av` — a page, said and read back. A module that
//! stands down says its page (every element's number, seat, tag, attributes
//! and words, the sheet it wears and the next number it will give); the
//! module that takes over reads it into its own `Live`, so its first paint
//! is a diff against the page that stands. Listeners are not said: a
//! closure belongs to the module that made it, and the new module binds its
//! own. The page is a frame: the `snapshot1` dialect, then the page as
//! `@derive(Frame)` writes it (`frame/`).
use @std.meta.{derive}
use frame.derive.{Frame}
use frame.kinds.{writer, reader, told_nothing, heard_nothing}
use frame.dialect.{Dialect, opened, read_dialect}
use tree.identity.{NodeId, Step}
use realize.html.element.{Element, Tagged, Worded}
use realize.html.tags.{HtmlAttr, HtmlAttrName, HtmlTag}

/// What a snapshot holds: the elements, the next number to give, and the
/// sheet the page wears.
export type Page = { elements: List<Element>, next: int, sheet: string }

/// An element as a page that stands down says it: its number, where it
/// stands — its step's words, and as a reader is shown them — and what it
/// holds: its words, or its tag, attributes, what it draws at rest and its
/// children.
@derive(Frame)
export enum Kept {
    @code(1) Run(id: NodeId, words: string, shows: string, content: string)
    @code(2) Tag(
        id: NodeId,
        words: string,
        shows: string,
        tag: HtmlTag,
        attrs: List<HtmlAttr>,
        rests: List<HtmlAttrName>,
        kids: List<Kept>,
    )
}

/// A page as it is said: the next number, the sheet, and each element.
@derive(Frame)
export type Snapshot = { next: int, sheet: string, elements: List<Kept> }

fn kept_of(e: Element) -> Kept {
    match e {
        .Text(run) -> Kept.Run(run.id, run.seat.spelled(), run.seat.shown(), run.content),
        .Tag(el) -> Kept
            .Tag(
                el.id,
                el.seat.spelled(),
                el.seat.shown(),
                el.tag,
                el.attrs,
                el.rests,
                el.kids.map(kept_of(it)),
            ),
    }
}

fn element_of(k: Kept) -> Element {
    match k {
        .Run(id, words, shows, content) -> Element.Text(Worded { id: id, seat: Step.Read(words, shows), content: content }),
        .Tag(id, words, shows, tag, attrs, rests, kids) -> Element
            .Tag(
                Tagged {
                    id: id,
                    seat: Step.Read(words, shows),
                    tag: tag,
                    attrs: attrs,
                    rests: rests,
                    kids: kids.map(element_of(it)),
                },
            ),
    }
}

/// A page as bytes.
export fn said(p: Page) -> Bytes {
    let w = writer(told_nothing())
    opened(w, Dialect.Snapshot1)
    Snapshot { next: p.next, sheet: p.sheet, elements: p.elements.map(kept_of(it)) }.framed(w)
    w.take()
}

/// A page read back from `bytes`: none for bytes of another dialect, a
/// truncated run, a word the vocabulary lacks or anything left over.
export fn taken(bytes: Bytes) -> Page? {
    let r = reader(bytes, heard_nothing())
    let read = match read_dialect(r, Dialect.Snapshot1) {
        .Ok(_) -> Snapshot.unframed(r),
        .Err(_) -> { return null },
    }
    match read {
        .Ok(s) -> if r.ended() { Page { elements: s.elements.map(element_of(it)), next: s.next, sheet: s.sheet } } else { null },
        .Err(_) -> null,
    }
}
