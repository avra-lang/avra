//! `realize/dom/asked.av` — a request as a page's host reads it, once, to
//! send with its own `fetch`: the method's word, the URL, the wait in
//! milliseconds (none: -1), the fields' names and values in turn, and the
//! body as its content type (empty for none) and its octets.
use @std.meta.{derive}
use frame.derive.{Frame}

@derive(Frame)
export type Asked = { method: string, url: string, wait_ms: int, fields: List<string>, kind: string, body: Bytes }
