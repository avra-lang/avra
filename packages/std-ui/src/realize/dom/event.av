//! `realize/dom/event.av` — the host's event text, read back. The host
//! sends `<key> <kind> [value…]`; the program names the element that
//! spoke and what it said, and routes it to that component's handler.
export type Event = { key: string, kind: string, value: string }

/// `<key> <kind> [value…]` — absence when there is no key AND kind to read.
export fn parse_event(s: string) -> Event? {
    let parts = s.split(" ")
    if parts.length < 2 { return null }
    Event { key: parts[0], kind: parts[1], value: parts.drop(2).join(" ") }
}
