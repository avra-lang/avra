//! `realize/dom/frame.av` — the live target's op frame. One render emits a
//! frame; the program hands it to the runtime, which hands it to the host,
//! which reconciles it into the live tree. Values are LENGTH-PREFIXED, so
//! they are carried raw — no escaping on either side to drift apart.
//!
//!   V2                       the wire's version; a stale host REFUSES
//!   C <path> <tag>           create element <tag> at <path>
//!   K <path> <len>           data-key, identity for a keyed reorder
//!   A <path> <len>           the class attribute
//!   T <path> <len>           the node's words
//!   N                        nothing changed
//! A value op's bytes follow its line, then a newline.
use realize.render.{Node}
use realize.html.tags.{tag_of}
use realize.html.css.{CssRule, distinct_rules, class_names, stylesheet}
use realize.lists.{union}
use style.theme.{Theme}

/// The wire's version — a stale bootstrap must REFUSE, never misapply.
const frame_version = "V2"

/// An op's line, then its value raw with the length that reads it back.
fn valued(line: string, v: string) -> string { "${line} ${v.length}\n${v}\n" }

/// This node's own ops: its element, its key, its classes, its words.
fn own_ops(n: Node, path: string) -> List<string> {
    let key = n.box.key ?? ""
    let key_ops: List<string> = if key == "" { [] } else { [valued("K ${path}", key)] }
    let names = class_names(n)
    let class_ops: List<string> = if names.is_empty() { [] } else { [valued("A ${path}", names.join(" "))] }
    let words = n.words()
    let word_ops: List<string> = if words == "" { [] } else { [valued("T ${path}", words)] }
    ["C ${path} ${tag_of(n).text()}\n"].concat(key_ops).concat(class_ops).concat(word_ops)
}

/// The ops for one node and its subtree — this node's, then each child's.
fn ops_of(n: Node, path: string) -> List<string> {
    own_ops(n, path).concat(union([ops_of(c, "${path}/${i}") for i, c in n.children]))
}

/// The whole tree as one frame.
export fn frame(root: Node) -> string { "${frame_version}\n${ops_of(root, "0").join("")}" }

/// Nothing changed: one op, so an unchanged render costs one line.
export fn no_change() -> string { "${frame_version}\nN\n" }

/// The last frame sent — a render that changes nothing costs one line.
export type Live = { last: Cell<string> }

export fn live() -> Live { Live { last: Cell.new("") } }

/// `root`'s frame, or `no_change()` when it is the frame last sent. A
/// string compare is a memcmp; a host call, a parse and a reconcile are
/// not, and most renders change nothing the last one did not say.
export fn diff(l: Live, root: Node) -> string {
    let next = frame(root)
    if next == l.last.get() { return no_change() }
    l.last.set(next)
    next
}

/// Every rule any node in the tree names.
fn all_rules(n: Node) -> List<CssRule> {
    n.box.rules().concat(union([all_rules(c) for c in n.children]))
}

/// The tree's one stylesheet — the classes the frame hands the live tree,
/// each declared once. The page carries this in its `<style>`.
export fn sheet(root: Node, theme: Theme) -> string {
    stylesheet(distinct_rules(all_rules(root)), theme)
}
