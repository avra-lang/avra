//! `realize/dom/frame.av` — the live target's op frame. `frame` emits the
//! WIRE (bytes); `frame_text` is the same tree as readable lines, the debug
//! projection tests and `explain` read. Values ride length-prefixed and raw,
//! so neither side escapes and nothing can drift.
//!
//!   byte 0        version 3 — a stale host REFUSES, never misapplies
//!   op 1  C       id, parent(-1 root), index, tag(len+bytes)
//!   op 2  K       id, key(len+bytes)      data-key: identity for a reorder
//!   op 3  A       id, class(len+bytes)
//!   op 4  T       id, words(len+bytes)
//!   op 5  E       id, event kind — the host SUBSCRIBES and calls back
//!   op 6  S       css(len+bytes) — the stylesheet, sent ONCE
//!   op 0  N       nothing changed
//! Every int is four little-endian bytes.
use realize.render.{Node, EventKind, Event}
use realize.html.tags.{tag_of}
use realize.html.css.{CssRule, distinct_rules, class_names, stylesheet}
use realize.dom.buf.{Buf, buf}
use realize.lists.{union}
use style.theme.{Theme}

/// The wire's version.
const version = 3

/// The host's own code for an event kind — the wire's currency, not the
/// enum's order. ONE arm per kind.
fn kind_code(k: EventKind) -> int {
    match k { .Click -> 1, .Input -> 2, .Change -> 3, .Submit -> 4 }
}

/// This node and its subtree, as wire records. `id` is the pre-order
/// counter — the host addresses a node by it, never by a path string.
fn emit(n: Node, parent: int, index: int, b: Buf, next: Cell<int>) {
    let id = next.get()
    next.set(id + 1)
    b.push_byte(1)
    b.push_int(id)
    b.push_int(parent)
    b.push_int(index)
    b.push_str(tag_of(n).text())
    let key = n.box.key ?? ""
    if key != "" {
        b.push_byte(2)
        b.push_int(id)
        b.push_str(key)
    }
    let names = class_names(n)
    if !names.is_empty() {
        b.push_byte(3)
        b.push_int(id)
        b.push_str(names.join(" "))
    }
    let words = n.words()
    if words != "" {
        b.push_byte(4)
        b.push_int(id)
        b.push_str(words)
    }
    for ev in n.events {
        b.push_byte(5)
        b.push_int(id)
        b.push_int(kind_code(ev.kind))
    }
    for i, c in n.children { emit(c, id, i, b, next) }
}

/// The whole tree as one wire frame.
export fn frame(root: Node) -> Bytes {
    let b = buf()
    b.push_byte(version)
    let next = Cell.new(0)
    emit(root, -1, 0, b, next)
    b.take()
}

/// The tree's first frame: the stylesheet the classes need, then the tree.
/// The sheet is sent ONCE — later frames carry only what changed.
fn styled_frame(root: Node, theme: Theme) -> Bytes {
    let b = buf()
    b.push_byte(version)
    b.push_byte(6)
    b.push_str(sheet(root, theme))
    emit(root, -1, 0, b, Cell.new(0))
    b.take()
}

/// Nothing changed: a version and the no-op code, two bytes.
export fn no_change() -> Bytes {
    let b = buf()
    b.push_byte(version)
    b.push_byte(0)
    b.take()
}

/// The last frame sent, and whether the stylesheet has gone with it.
export type Live = { last: Cell<Bytes>, styled: Cell<bool> }

export fn live() -> Live { Live { last: Cell.new("".bytes()), styled: Cell.new(false) } }

impl Live {
    /// `root`'s frame, or `no_change()` when it is the frame last sent. The
    /// FIRST frame carries the stylesheet, so a page styles itself from the
    /// program's own classes.
    fn diff(root: Node, theme: Theme) -> Bytes {
        let first = !self.styled.get()
        let next = if first { styled_frame(root, theme) } else { frame(root) }
        if !first && next == self.last.get() { return no_change() }
        self.last.set(next)
        self.styled.set(true)
        next
    }
}

// ── the debug projection ────────────────────────────────────────

/// This node's own lines.
fn text_ops(n: Node, path: string) -> List<string> {
    let key = n.box.key ?? ""
    let key_ops: List<string> = if key == "" { [] } else { ["K ${path} ${key}"] }
    let names = class_names(n)
    let class_ops: List<string> = if names.is_empty() { [] } else { ["A ${path} ${names.join(" ")}"] }
    let words = n.words()
    let word_ops: List<string> = if words == "" { [] } else { ["T ${path} ${words}"] }
    ["C ${path} ${tag_of(n).text()}"].concat(key_ops).concat(class_ops).concat(word_ops)
}

fn walk_text(n: Node, path: string) -> List<string> {
    text_ops(n, path).concat(union([walk_text(c, "${path}/${i}") for i, c in n.children]))
}

/// The same tree as readable lines — for tests and `explain`, never the wire.
export fn frame_text(root: Node) -> string { "V3\n${walk_text(root, "0").join("\n")}" }

// ── dispatch: the host echoes what the frame told it ────────────

/// The event at pre-order `id` for `kind`. The walk is the SAME one the
/// frame made, so an app needs no registry: the host echoes the id and kind
/// the frame gave it, and the program finds the NAME the tree asked for.
export fn event_at(root: Node, id: int, kind: int) -> Event? {
    let at = Cell.new(0)
    seek(root, id, kind, at)
}

fn seek(n: Node, want: int, kind: int, at: Cell<int>) -> Event? {
    let here = at.get()
    at.set(here + 1)
    if here == want { return n.events.find(kind_code(it.kind) == kind) }
    for c in n.children {
        let hit = seek(c, want, kind, at)
        if hit != null { return hit }
    }
    null
}

/// Every rule any node in the tree names.
fn all_rules(n: Node) -> List<CssRule> {
    n.box.rules().concat(union([all_rules(c) for c in n.children]))
}

/// The tree's one stylesheet. The page carries this in its `<style>`.
export fn sheet(root: Node, theme: Theme) -> string {
    stylesheet(distinct_rules(all_rules(root)), theme)
}
