//! `realize/dom/frame.av` — the DOM backend over the ONE update graph
//! (`realize/update.av`). `plan` says what changed in neutral ops; this
//! file names the DOM's OWN currency — a tag, a class, a byte op — and
//! serializes it. `frame` emits the WIRE (bytes); `frame_text` is the
//! same graph as readable lines, the debug projection tests and `explain`
//! read.
//!
//!   byte 0        version 5 — a stale host REFUSES, never misapplies
//!   op 1  C       id, parent(-1 root), index, tag(len+bytes)
//!   op 2  K       id, key(len+bytes)      data-key: identity for a reorder
//!   op 3  A       id, class(len+bytes)
//!   op 4  T       id, words(len+bytes)
//!   op 5  E       id, event kind — the host SUBSCRIBES and echoes the id
//!                 and kind; the handler itself never leaves the program
//!   op 6  S       css(len+bytes) — the stylesheet, sent ONCE
//!   op 0  N       nothing changed
//! Every int is four little-endian bytes.
use realize.render.{Node, EventKind, Action, Handler, level_of}
use realize.payload.{Payload}
use realize.update.{Op, Mount, plan}
use realize.html.tags.{tag_for}
use realize.html.css.{CssRule, distinct_rules, class_names_of, stylesheet}
use realize.dom.buf.{Buf, buf}
use realize.lists.{union}
use style.theme.{Theme}

/// The wire's version.
const version = 5

/// The host's own code for an event kind — the wire's currency, not the
/// enum's order. ONE arm per kind.
fn kind_code(k: EventKind) -> int {
    match k { .Click -> 1, .Input -> 2, .Change -> 3, .Submit -> 4 }
}

/// The host's own word for an event kind — the debug projection's.
fn kind_word(k: EventKind) -> string {
    match k { .Click -> "click", .Input -> "input", .Change -> "change", .Submit -> "submit" }
}

// ── the wire ─────────────────────────────────────────────────────

/// One mounted node's records: its structure, then its key and classes.
fn mount_wire(m: Mount, b: Buf) {
    b.push_byte(1)
    b.push_int(m.id)
    b.push_int(m.parent)
    b.push_int(m.index)
    b.push_str(tag_for(m.prim, level_of(m.attrs)).word())
    let key = m.box.key ?? ""
    if key != "" {
        b.push_byte(2)
        b.push_int(m.id)
        b.push_str(key)
    }
    let names = class_names_of(m.box)
    if !names.is_empty() {
        b.push_byte(3)
        b.push_int(m.id)
        b.push_str(names.join(" "))
    }
}

/// One neutral op as its wire records.
fn wire_op(op: Op, b: Buf) {
    match op {
        .Mount(m) -> mount_wire(m, b),
        .Words(id, text) -> {
            if text != "" {
                b.push_byte(4)
                b.push_int(id)
                b.push_str(text)
            }
        },
        .Event(id, action) -> {
            b.push_byte(5)
            b.push_int(id)
            b.push_int(kind_code(action.kind))
        },
    }
}

/// The whole tree as one wire frame.
export fn frame(root: Node) -> Bytes { frame_of(plan(root)) }

fn frame_of(ops: List<Op>) -> Bytes {
    let b = buf()
    b.push_byte(version)
    for op in ops { wire_op(op, b) }
    b.take()
}

/// The tree's first frame: the stylesheet the classes need, then the tree.
/// The sheet is sent ONCE — later frames carry only what changed.
fn styled_frame(ops: List<Op>, theme: Theme) -> Bytes {
    let b = buf()
    b.push_byte(version)
    b.push_byte(6)
    b.push_str(sheet_of(ops, theme))
    for op in ops { wire_op(op, b) }
    b.take()
}

/// Nothing changed: a version and the no-op code, two bytes.
export fn no_change() -> Bytes {
    let b = buf()
    b.push_byte(version)
    b.push_byte(0)
    b.take()
}

/// The last frame sent, whether the stylesheet has gone with it, and the
/// events that frame bound — the handlers a host's echo runs.
export type Live = { last: Cell<Bytes>, styled: Cell<bool>, bound: Cell<List<Op>> }

export fn live() -> Live {
    let none: List<Op> = []
    Live { last: Cell.new("".bytes()), styled: Cell.new(false), bound: Cell.new(none) }
}

impl Live {
    /// `root`'s frame, or `no_change()` when the tree is the one last sent.
    /// The FIRST frame carries the stylesheet, so a page styles itself from
    /// the program's own classes; every later frame is the tree alone.
    ///
    /// The remembered value is ALWAYS the bare tree, never the styled frame:
    /// remembering the styled one would make every later comparison fail (the
    /// stylesheet is not in them) and `no_change` could never fire. The
    /// bound events are replaced EVERY paint: two trees that draw alike may
    /// still close over different values.
    fn diff(root: Node, theme: Theme) -> Bytes {
        let ops = plan(root)
        let plain = frame_of(ops)
        self.bound.set([op for op in ops if is_event(op)])
        if self.styled.get() && plain == self.last.get() { return no_change() }
        self.last.set(plain)
        if !self.styled.get() {
            self.styled.set(true)
            return styled_frame(ops, theme)
        }
        plain
    }

    /// The host's echo: node `id` spoke `kind`, saying `said`. The handler
    /// the last frame bound there runs; false when nothing answered.
    fn fire(id: int, kind: int, said: Payload?) -> bool {
        let action? = find_event(self.bound.get(), id, kind) else { return false }
        action.fire(said)
    }
}

// ── the debug projection ────────────────────────────────────────

/// This node's own lines.
fn text_ops(m: Mount, path: string) -> List<string> {
    let key = m.box.key ?? ""
    let key_ops: List<string> = if key == "" { [] } else { ["K ${path} ${key}"] }
    let names = class_names_of(m.box)
    let class_ops: List<string> = if names.is_empty() { [] } else { ["A ${path} ${names.join(" ")}"] }
    ["C ${path} ${tag_for(m.prim, level_of(m.attrs)).word()}"].concat(key_ops).concat(class_ops)
}

/// One event as a readable line: its path and kind.
fn event_line(path: string, action: Action) -> string { "E ${path} ${kind_word(action.kind)}" }

/// The same graph as readable lines, addressed by lexical path — for tests
/// and `explain`, never the wire. The first node's path is "0".
export fn frame_text(root: Node) -> string {
    let paths: Cell<List<string>> = Cell.new([])
    let lines: Cell<List<string>> = Cell.new([])
    for op in plan(root) {
        match op {
            .Mount(m) -> {
                let path = if m.parent < 0 { "${m.index}" } else { "${paths.get()[m.parent]}/${m.index}" }
                paths.push(path)
                lines.set(lines.get().concat(text_ops(m, path)))
            },
            .Event(id, action) -> lines.push(event_line(paths.get()[id], action)),
            .Words(id, text) -> {
                if text != "" { lines.push("T ${paths.get()[id]} ${text}") }
            },
        }
    }
    "V5\n${lines.get().join("\n")}"
}

// ── dispatch: the host echoes what the frame told it ────────────

/// The action node `id` bound for `kind`, in the tree as a frame numbers it.
export fn event_at(root: Node, id: int, kind: int) -> Action? { find_event(plan(root), id, kind) }

fn is_event(op: Op) -> bool {
    match op { .Event(_, _) -> true, .Mount(_) or .Words(_, _) -> false }
}

fn has_event(id: int, kind: int, op: Op) -> bool {
    match op {
        .Event(who, action) -> who == id && kind_code(action.kind) == kind,
        .Mount(_) or .Words(_, _) -> false,
    }
}

fn find_event(ops: List<Op>, id: int, kind: int) -> Action? {
    let found? = ops.find(has_event(id, kind, it)) else { return null }
    match found { .Event(_, action) -> action, .Mount(_) or .Words(_, _) -> null }
}

// ── the stylesheet ──────────────────────────────────────────────

/// Every rule any mounted node in the graph names.
fn all_rules(ops: List<Op>) -> List<CssRule> {
    union([m.box.rules() for op in ops for m in as_mount(op)])
}

/// The mount an op carries, if it places a node.
fn as_mount(op: Op) -> List<Mount> {
    match op { .Mount(m) -> [m], .Words(_, _) or .Event(_, _) -> [] }
}

fn sheet_of(ops: List<Op>, theme: Theme) -> string {
    stylesheet(distinct_rules(all_rules(ops)), theme)
}

/// The tree's one stylesheet. The page carries this in its `<style>`.
export fn sheet(root: Node, theme: Theme) -> string { sheet_of(plan(root), theme) }
