// proves: when a cell is read by something that is NOT a reading, the exact
// path alone would leave the page stale, and the check refuses it: the
// button's label is an attribute no reading covers, so a write to `n` changes
// a patch the full paint says and the exact path does not.
use @std.ui.components.{button, column, text}
use @std.ui.realize.dom.live.{live}
use @std.ui.style.theme.{default_theme}
use @std.ui.tree.view.{tree_of}

state n: int = 1

fn view() -> column {
    column {
        text "n=${n}"
        button "go ${n}"
    }
}

let page = live()
let _ = page.paint(tree_of(view()), default_theme)
n = 2
let _ = page.paint(tree_of(view()), default_theme)
println("unreachable under AVRA_EXACT=check")
