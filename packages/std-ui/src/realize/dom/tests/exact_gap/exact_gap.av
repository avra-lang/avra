// proves: a cell read by something that is NOT a reading takes the full paint.
// The button's label is an attribute no reading covers, so a write to `n`
// changes patches the exact path alone would miss; the page knows the cell is
// structural, DECLINES the turn, and the full paint stands — under
// `AVRA_EXACT=check` the two are compared and nothing traps.
use @std.ui.components.{button, column, text}
use @std.ui.realize.dom.live.{live}
use @std.ui.style.theme.{default_theme}
use @std.ui.tree.view.{tree_of}

state n: int = 1

fn view() -> column {
    column {
        text "n=${n}"
        button "go ${n}"
    }
}

let page = live()
let _ = page.paint(tree_of(view()), default_theme)
n = 2
let _ = page.paint(tree_of(view()), default_theme)
println(page.exact_counts())
