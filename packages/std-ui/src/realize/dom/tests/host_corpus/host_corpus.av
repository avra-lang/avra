// proves: cases grown from a seed leave the program as lines another host
// can be held to — each frame's bytes, what a user did between them, and
// the page the model host ends holding. runtime/dom/corpus_test.js applies
// them with the page's own host and compares (`make ui-host-test`);
// `UI_CORPUS_SEED` and `UI_CORPUS_CASES` widen the run.
use @std.io.{env}
use @std.text.{parse_int}
use @std.ui.realize.dom.tests.support.{corpus}

/// The number a variable holds, or `otherwise` when it is unset or no number.
fn setting(name: string, otherwise: int) -> int { parse_int(env(name) ?? "") ?? otherwise }

for line in corpus(setting("UI_CORPUS_SEED", 1), setting("UI_CORPUS_CASES", 2)) { println(line) }
