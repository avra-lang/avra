// proves: for trees grown and edited by chance from a seed, a page showing
// one tree and sent the frame that repaints it as the next is the page the
// next tree is — and both engines grow the same trees and say the same
// patches. `UI_FUZZ_SEED`, `UI_FUZZ_SEEDS` and `UI_FUZZ_CASES` widen the
// run (`make ui-fuzz`); a case that breaks the law is told shrunk, with
// its seed.
use @std.io.{env}
use @std.text.{parse_int}
use @std.ui.realize.dom.tests.support.{run}

/// The number a variable holds, or `otherwise` when it is unset or no number.
fn setting(name: string, otherwise: int) -> int { parse_int(env(name) ?? "") ?? otherwise }

let first = setting("UI_FUZZ_SEED", 6)
for seed in first..first + setting("UI_FUZZ_SEEDS", 1) { println(run(seed, setting("UI_FUZZ_CASES", 3))) }
