//! `tests/support/corpus.av` — cases as LINES a host outside the program
//! is shown: the frames a page was sent, what a user did between them,
//! and the page the model host ends holding — so another host, applying
//! the same frames, can be held to the same page.
//!
//!   case   seed, turn
//!   frame  the frame's bytes
//!   page   the page then, as `told` tells it outward
//!   move   id, what the user left on it with nothing hearing: the name
//!          a page keeps it under, the wire's tag for its value, the value
//!   say    id, event, the property moved (`-`: none), the wire's tag for its value,
//!          the value — then the echo due: kind, what is said, its value
//!   hear   id, event, kind, what is said, the property read, whether the
//!          page's own answer is stopped
//!
//! A word is a number, a name with no space in it, or text as base64 —
//! `-` for none.
use tree.node.{Said}
use @std.text.{base64}

/// Text as one word of a line: `-` for none.
fn worded(text: string) -> string { if text == "" { "-" } else { base64(text.bytes()) } }

fn page_line(at: Host) -> string { "page ${worded(told(at.page(), outward))}" }

/// What a host echoes of what a control said, as text.
fn echoed(said: Said?) -> string {
    match said {
        s? -> match s { .Text(t) -> t, .Number(n) -> "${n}", .Flag(on) -> "${on}" }
        null -> ""
    }
}

fn say_line(m: Move) -> string {
    "say ${m.id} ${page_word(m.action.kind)} ${if m.reads == "" { "-" } else { m.reads }} ${m.says} ${worded(m.text)} ${m.action.kind.code()} ${voice(m.action.handler).code()} ${worded(echoed(m.said))}"
}

fn move_line(t: Touch) -> string { "move ${t.id} ${t.name} ${t.says} ${worded(t.text)}" }

fn hear_line(id: int, e: Ear) -> string {
    "hear ${id} ${e.event} ${e.kind} ${e.says} ${if e.reads == "" { "-" } else { e.reads }} ${if e.prevents { 1 } else { 0 }}"
}

/// Every element under `run`, itself first.
fn every(run: List<Seen>) -> List<Seen> { [each for s in run for each in [s].concat(every(s.kids))] }

/// The lines of one case: its first paint, the user's moves, heard and
/// unheard, its repaint and its paint back — the page after each — and every event
/// the page ends hearing.
fn shown(c: Case) -> List<string> {
    let run = played(c)
    mut at = host()
    at.take(run.first)
    let drawn = page_line(at)
    hold(at, run.made)
    lay(at, run.strayed)
    at.take(run.second)
    let redrawn = page_line(at)
    hold(at, run.spoken)
    lay(at, run.strayed_back)
    at.take(run.back)
    ["frame ${base64(run.first)}", drawn]
        .concat([say_line(m) for m in run.made])
        .concat([move_line(t) for t in run.strayed])
        .concat(["frame ${base64(run.second)}", redrawn])
        .concat([say_line(m) for m in run.spoken])
        .concat([move_line(t) for t in run.strayed_back])
        .concat(["frame ${base64(run.back)}", page_line(at)])
        .concat([hear_line(s.id, e) for s in every(at.page()) for e in s.ears])
}

/// The lines of `count` cases under `seed`.
export fn corpus(seed: int, count: int) -> List<string> {
    [l for turn in 0..count for l in ["case ${seed} ${turn}"].concat(shown(case_at(seed, turn)))]
}
