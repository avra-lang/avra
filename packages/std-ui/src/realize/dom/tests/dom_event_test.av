//! The web's events as the platform lists them: the enum is generated from
//! the pinned webref file, so these pin what it reads back.
use @std.ui.realize.dom.dom_event.{DomEvent}

spec "a DOM event is the platform's own" {
    given "an event type" {
        then "spells the type the DOM names it" {
            DomEvent.Click.word() == "click" &&
                DomEvent.DOMContentLoaded.word() == "DOMContentLoaded"
        }
        then "keeps the interface its event objects implement" {
            DomEvent.Mousemove.interface() == "MouseEvent" &&
                DomEvent.Keydown.interface() == "KeyboardEvent"
        }
        then "names the element it fires at" {
            DomEvent.Submit.targets().join(",") == "HTMLFormElement"
        }
    }
}
