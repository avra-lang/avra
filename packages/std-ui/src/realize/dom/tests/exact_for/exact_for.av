// proves: a cell read outside any reading — here a loop — takes the full paint: the
// exact path DECLINES the turn that writes it, and under AVRA_EXACT=check the
// full paint stands with nothing trapping.
use @std.ui.components.{button, column, text}
use @std.ui.realize.dom.live.{live}
use @std.ui.style.theme.{default_theme}
use @std.ui.tree.view.{tree_of}

state n: int = 1

fn view() -> column {
    column {
        text "n=${n}"
        for i in 0..n { text "row ${i}" }
    }
}

let page = live()
let _ = page.paint(tree_of(view()), default_theme)
n = 2
let _ = page.paint(tree_of(view()), default_theme)
println(page.exact_counts())
