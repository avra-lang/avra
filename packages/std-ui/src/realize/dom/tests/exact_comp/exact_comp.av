// proves: a composition's own state and its props are cells of its instance,
// so a write to either patches the one text that reads it and the parent's
// other texts are left alone. Under `AVRA_EXACT=check` every answer is
// compared with the full paint's.
use @std.ui.components.{column, text}
use @std.ui.realize.dom.live.{live}
use @std.ui.style.theme.{default_theme}
use @std.ui.tests.parts.{counter}
use @std.ui.tree.view.{tree_of}

state title: string = "a"
state beside: int = 1

fn view() -> column {
    column {
        counter title
        text "beside ${beside}"
    }
}

let page = live()
let first = page.paint(tree_of(view()), default_theme)
title = "b"
let after_prop = page.paint(tree_of(view()), default_theme)
beside = 2
let after_beside = page.paint(tree_of(view()), default_theme)
println("${first.length > 0} ${after_prop.length > 0} ${after_beside.length > 0}")
println(page.exact_counts())
