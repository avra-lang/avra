// proves: a first paint is a diff against nothing — the element made, its
// text made and placed in it, then the element placed on the page.
use @std.ui.components.{text}
use @std.ui.realize.tests.support.{drawn_text}
use @std.ui.tree.view.{tree_of}
let t = text "hi"
println(drawn_text(tree_of(t)))
