// proves: a page that watches the cells its texts read answers a write with
// the one text that reads it, and that answer is the full paint's own — run
// under `AVRA_EXACT=check`, the two are compared every turn and a
// disagreement traps, so this program printing at all is the comparison.
use @std.ui.components.{column, text}
use @std.ui.realize.dom.live.{live}
use @std.ui.style.theme.{default_theme}

state n: int = 1
state m: int = 10

fn view() -> column {
    column {
        text "n=${n}"
        text "m=${m}"
        text "fixed"
    }
}

let page = live()
let first = page.paint_view(view(), default_theme)
let still = page.paint_view(view(), default_theme)
n = 2
let after_n = page.paint_view(view(), default_theme)
m = 11
n = 3
let after_both = page.paint_view(view(), default_theme)
let again = page.paint_view(view(), default_theme)
println(
    "${first.length > 0} ${still.length} ${after_n.length > 0} ${after_both.length > after_n.length} ${again.length == still.length}",
)
println(page.exact_counts())
