//! The seat table the View derive writes beside each primitive, and what
//! each target's own table says delivers every seat in it: a component names
//! its events, never a target.
use @std.ui.components.{button, checkbox, dialog, field, form, link, slider, switch}
use @std.ui.tree.node.{Prim}
use @std.ui.tree.seats.{Seat, SeatRow, seat_rows, ties}
use @std.ui.realize.html.delivery.{on_web}
use @std.ui.terminal.delivery.{terminal_key}

fn rows() -> List<SeatRow> { [g.row for g in seat_rows] }

fn seats() -> List<Seat> { [Seat(j) for j, _g in seat_rows] }

fn named(s: Seat) -> string { "${seat_rows[s.number()].row.owner}.${seat_rows[s.number()].row.event}" }

spec "the seat table" {
    given "the controls std-ui declares" {
        then "holds one seat per event, in name order" {
            [r.owner + "." + r.event for r in rows()].join(" ") == "button.press checkbox.change dialog.dismiss field.input field.submit form.submit key.press link.press slider.change switch.change"
        }
        then "names each seat once" { ties(rows()).is_empty() }
        then "names the primitive that declares each seat" {
            rows().find(it.owner == "form")?.prim == Prim.Form &&
                rows().find(it.owner == "dialog")?.prim == Prim.Dialog &&
                rows().find(it.owner == "slider")?.prim == Prim.Slider
        }
    }
    given "two seats of one name" {
        then "are a tie, named" {
            let twice = rows().concat([rows()[0]])
            ties(twice).join(",") == "button.press"
        }
    }
}

spec "the page's table" {
    given "every seat std-ui declares" {
        then "delivers each by what the web calls it" {
            ["${named(s)}=${on_web(s).by?.word() ?? "none"}" for s in seats()].join(" ") == "button.press=click checkbox.change=change dialog.dismiss=cancel field.input=input field.submit=keydown form.submit=submit key.press=keydown link.press=click slider.change=change switch.change=change"
        }
        then "listens, handler or none, for a form's submit and a dialog's dismissal" {
            [named(s) for s in seats() if on_web(s).always].join(" ") == "dialog.dismiss form.submit"
        }
        then "prevents the page's own answer only where it would leave the page" {
            [named(s) for s in seats() if on_web(s).prevent].join(" ") == "field.submit form.submit"
        }
        then "fires a seat by one key only where that key alone says it: a field's submit, by Enter" {
            ["${named(s)}=${on_web(s).key}" for s in seats() if on_web(s).key != ""].join(" ") == "field.submit=Enter"
        }
    }
}

spec "the terminal's table" {
    given "every seat std-ui declares" {
        then "fires each by its key, and none where what is typed says it" {
            ["${named(s)}=${key_word(s)}" for s in seats()].join(" ") == "button.press=enter checkbox.change=enter dialog.dismiss=escape field.input=none field.submit=enter form.submit=enter key.press=shortcut link.press=enter slider.change=none switch.change=enter"
        }
    }
}

/// A seat's terminal key, as a word.
fn key_word(s: Seat) -> string {
    let k? = terminal_key(s) else { return "none" }
    match k { .Enter -> "enter", .Escape -> "escape", .Shortcut -> "shortcut", rest -> "another" }
}
