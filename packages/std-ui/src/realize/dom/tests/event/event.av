// proves: the host's event text is read back — key, kind, and a value that
// may hold spaces — and an unreadable line is absent, never a guess.
use @std.ui.realize.dom.event.{parse_event}
match parse_event("card-3 click hello world") {
    e? -> println("${e.key}|${e.kind}|${e.value}")
    null -> println("none")
}
match parse_event("bad") {
    e? -> println("${e.key}|${e.kind}|${e.value}")
    null -> println("none")
}
