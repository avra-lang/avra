// proves: the wire's byte builder appends in place and the list becomes
// Bytes once — a byte, a little-endian int, and a length-prefixed string.
use @std.ui.realize.dom.buf.{buf}
let b = buf()
b.push_byte(65)
b.push_int(300)
b.push_str("hi")
let out = b.take()
println("${out.length}")
mut parts: List<string> = []
mut i = 0
while i < out.length {
    parts = parts.concat(["${out.at(i)}"])
    i = i + 1
}
println(parts.join(","))
