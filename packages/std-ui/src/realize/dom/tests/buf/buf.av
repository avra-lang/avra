// proves: the wire's byte builder appends in place and the list becomes
// Bytes once — a byte, a little-endian int, and a length-prefixed string.
use @std.ui.realize.dom.buf.{buf, push_byte, push_int, push_str, take}
let b = buf()
push_byte(b, 65)
push_int(b, 300)
push_str(b, "hi")
let out = take(b)
println("${out.length}")
mut parts: List<string> = []
mut i = 0
while i < out.length {
    parts = parts.concat(["${out.at(i)}"])
    i = i + 1
}
println(parts.join(","))
