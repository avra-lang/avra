// proves: the wire is BYTES — a version, records, little-endian ints, and
// values carried raw with their length. 33 bytes for one text node.
use @std.ui.components.{text}
use @std.ui.realize.dom.frame.{frame}
let out = frame(text "hi".describe())
println("${out.length}")
mut parts: List<string> = []
mut i = 0
while i < out.length {
    parts = parts.concat(["${out.at(i)}"])
    i = i + 1
}
println(parts.join(","))
