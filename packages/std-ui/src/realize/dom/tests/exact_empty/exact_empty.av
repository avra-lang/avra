// proves: a text that is empty when painted has no run on the page, so a later
// value is the full paint's to speak, and a text that turns empty is too: the
// exact path declines both, and under `AVRA_EXACT=check` the full paint's own
// answer is what the page gets.
use @std.ui.components.{column, text}
use @std.ui.realize.dom.live.{live}
use @std.ui.style.theme.{default_theme}

state s: string = ""

fn view() -> column {
    column {
        text "${s}"
    }
}

let page = live()
let first = page.paint_view(view(), default_theme)
s = "a"
let filled = page.paint_view(view(), default_theme)
s = ""
let emptied = page.paint_view(view(), default_theme)
println("${first.length > 0} ${filled.length > 0} ${emptied.length > 0}")
println(page.exact_counts())
