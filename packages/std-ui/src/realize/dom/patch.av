//! `realize/dom/patch.av` — the DIFF: the page as it stands against the
//! page as it should be, as the PATCHES that turn one into the other. Two
//! element trees (`realize/html/element.av`) are matched by ID — an id is
//! its node, so the same id is the same element — and only what differs
//! is said. A first paint is a diff against nothing.
//!
//! A host applies patches and holds no tree of its own: every decision —
//! what moved, what is a property, what an event says — is made here.
use @std.meta.{derive}
use realize.identity.{NodeId}
use realize.render.{Action, EventKind, Handler, Said}
use realize.codes.{Codes, Coded}
use realize.html.element.{Element, Tagged}
use realize.html.tags.{HtmlTag, HtmlAttr, HtmlAttrName}

/// One change to the page. `Place` puts an element under its parent —
/// the page itself when absent — right after a sibling, or first.
export enum Patch {
    Create(id: NodeId, tag: HtmlTag)
    CreateText(id: NodeId, content: string)
    Place(id: NodeId, parent: NodeId?, after: NodeId?)
    Remove(id: NodeId)
    SetAttr(id: NodeId, name: HtmlAttrName, value: string)
    DropAttr(id: NodeId, name: HtmlAttrName)
    SetProp(id: NodeId, name: HtmlAttrName, value: Said)
    SetText(id: NodeId, content: string)
    Listen(id: NodeId, to: Listening)
    Unlisten(id: NodeId, kind: EventKind)
    Style(css: string)
}

/// What a value a control holds IS — the tag a host is told to read a
/// control's answer as, and writes a property's value as. ONE variant per
/// thing a control can say, and one for saying nothing.
@derive(Codes)
export enum Says {
    @code(0) Nothing
    @code(1) Number
    @code(2) Flag
    @code(3) Text
}

/// How an element hears one event: the page's own word for it, what the
/// event says and the property that answer is read from — none for an
/// event that says nothing — and whether the page's own answer to it is
/// stopped.
export type Listening = { action: Action, event: string, says: Says, reads: HtmlAttrName?, prevents: bool }

/// What a control was heard to say: the user moved its property to this.
export type Heard = { id: NodeId, name: HtmlAttrName, value: Said }

// ── the page's own facts ────────────────────────────────────────

/// The page's word for each event. Every kind spelled.
fn event_word(k: EventKind) -> string {
    match k { .Press -> "click", .Input -> "input", .Change -> "change", .Submit -> "submit" }
}

/// Whether the page's own answer to an event is stopped: a form's submit
/// would leave the page the program is drawing. Every kind spelled.
fn prevented(k: EventKind) -> bool {
    match k { .Submit -> true, .Press or .Input or .Change -> false }
}

/// What a handler hears. ONE arm per thing a control can say.
export fn says(h: Handler) -> Says {
    match h { .Nothing(_) -> .Nothing, .Number(_) -> .Number, .Flag(_) -> .Flag, .Text(_) -> .Text }
}

/// What a value is. ONE arm per thing a control can say.
export fn said_as(value: Said) -> Says {
    match value { .Number(_) -> .Number, .Flag(_) -> .Flag, .Text(_) -> .Text }
}

/// The property a control's answer is read from, by what it says. Every
/// answer spelled.
fn read_from(s: Says) -> HtmlAttrName? {
    match s { .Nothing -> null, .Text or .Number -> .Value, .Flag -> .Checked }
}

/// How the page hears an action.
export fn listening_of(a: Action) -> Listening {
    let told = says(a.handler)
    Listening {
        action: a,
        event: event_word(a.kind),
        says: told,
        reads: read_from(told),
        prevents: prevented(a.kind),
    }
}

/// A PROPERTY is live state the user moves — a field's text, a box's
/// tick — where its attribute only seeds it. An attribute of these names
/// is set as a property, as the value it means; every other name is an
/// attribute. Every name spelled.
fn property(a: HtmlAttr) -> Said? {
    match a.name {
        .Value -> Said.Text(a.value),
        .Checked -> Said.Flag(true),
        .DataKey or .Class or .AriaLabel or .AriaSelected or .AriaInvalid or .AriaBusy or .AriaLive or .Title or .Href or .Min or .Max or .Open or .Placeholder or .Src or .Alt or .Disabled or .Type or .Role -> null,
    }
}

/// A property no attribute seeds, at rest.
fn at_rest(value: Said) -> Said {
    match value {
        .Text(_) -> Said.Text(""),
        .Flag(_) -> Said.Flag(false),
        .Number(_) -> Said.Number(0),
    }
}

/// Two values a control may hold, compared.
fn same_said(a: Said, b: Said) -> bool {
    match a {
        .Text(x) -> match b { .Text(y) -> x == y, .Flag(_) or .Number(_) -> false },
        .Flag(x) -> match b { .Flag(y) -> x == y, .Text(_) or .Number(_) -> false },
        .Number(x) -> match b { .Number(y) -> x == y, .Text(_) or .Flag(_) -> false },
    }
}

// ── the diff ────────────────────────────────────────────────────

/// A diff's answer: the patches, the page as it now stands — every
/// element wearing its number — and the next number to give.
export type Diffed = { patches: List<Patch>, page: List<Element>, next: int }

/// One property of an element, by its name.
type Prop = { name: HtmlAttrName, value: Said }

fn props_of(el: Tagged) -> List<Prop> {
    [Prop { name: a.name, value: v } for a in el.attrs for v in held(property(a))]
}

fn held(value: Said?) -> List<Said> {
    match value {
        v? -> [v]
        null -> []
    }
}

fn attrs_of(el: Tagged) -> List<HtmlAttr> { [a for a in el.attrs if property(a) == null] }

/// Whether two elements are ONE across a paint: they stand at one seat
/// and are one kind of thing — text and text, or elements of one tag. A
/// seat whose node became another kind holds a new element.
fn same(old: Element, new: Element) -> bool {
    old.seat() == new.seat() && same_kind(old, new)
}

fn same_kind(old: Element, new: Element) -> bool {
    match old {
        .Text(_, _, _) -> match new { .Text(_, _, _) -> true, .Tag(_) -> false },
        .Tag(was) -> match new { .Tag(el) -> was.tag == el.tag, .Text(_, _, _) -> false },
    }
}

/// Each element's place in a run, by its seat.
fn places(run: List<Element>) -> Map<string, int> {
    mut at: Map<string, int> = {}
    for j, e in run { at.set(e.seat(), j) }
    at
}

/// For each element of `of`, where in `run` the same element stands —
/// absent for one `run` does not hold. Two runs that pair off in order,
/// as an unchanged list does, are matched without a table.
fn twins(run: List<Element>, of: List<Element>) -> List<int?> {
    if run.length == of.length && [j for j, e in of if !same(run[j], e)].is_empty() { return [twin(j) for j, e in of] }
    let at = places(run)
    [twin_at(run, at, e) for e in of]
}

fn twin(j: int) -> int? { j }

fn twin_at(run: List<Element>, at: Map<string, int>, e: Element) -> int? {
    let j? = at.get(e.seat()) else { return null }
    if same_kind(run[j], e) { j } else { null }
}

/// Whether an element that stood at `at` in the old order still follows
/// every kept element before it — one new to the page never does.
fn follows(at: int?, reached: int) -> bool {
    let stood? = at else { return false }
    stood > reached
}

/// Whether two actions ask the page for the same listener: the kind, and
/// what the event says.
fn same_hearing(a: Action, b: Action) -> bool { a.kind == b.kind && says(a.handler) == says(b.handler) }

/// A run of elements on the page, each wearing its number, and the next
/// number to give.
type Drawn = { page: List<Element>, next: int }

/// A diff under way: what the user was heard to do to the page since it
/// was last drawn, and the patches said so far. EVERY PATCH IS SAID INTO
/// THE ONE LIST, in the order a host applies them, so a level never
/// copies what the levels under it said.
type Differ = { heard: List<Heard>, said: Cell<List<Patch>> = Cell.new([]) }

impl Differ {
    fn say(patches: List<Patch>) {
        // LICENSED loops.push_loop: a cell's list grows in place — a concat copies all said so far
        for p in patches { self.said.push(p) }
    }

    /// One parent's children: what left is removed, what stays is diffed
    /// where it stands, and what is new or out of order is placed after
    /// the sibling it now follows. A kept element stands still while it
    /// follows, in the old order, every kept element before it.
    fn siblings(parent: NodeId?, old: List<Element>, new: List<Element>, next: int) -> Drawn {
        let stays = twins(new, old)
        let was = twins(old, new)
        self.say([Patch.Remove(e.id()) for j, e in old if stays[j] == null])
        mut page: List<Element> = []
        mut free = next
        mut reached = -1
        // LICENSED loops.push_loop: each element takes the numbers the ones before it left
        for j, e in new {
            let d = self.drawn(old, was[j], e, free)
            let now? = d.page.first() else { continue }
            if follows(was[j], reached) {
                reached = was[j] ?? reached
            } else {
                self.said.push(Patch.Place(now.id(), parent, page.last()?.id()))
            }
            page.push(now)
            free = d.next
        }
        Drawn { page: page, next: free }
    }

    /// `e` on the page: kept, when `old` holds it at `at`, else made.
    fn drawn(old: List<Element>, at: int?, e: Element, next: int) -> Drawn {
        let stood? = at else { return self.made(e, next) }
        self.kept(old[stood], e, next)
    }

    /// An element new to the page: given the next number and built whole,
    /// for its parent to place.
    fn made(e: Element, next: int) -> Drawn {
        let id = NodeId { n: next }
        match e {
            .Text(_, seat, content) -> {
                self.said.push(Patch.CreateText(id, content))
                Drawn { page: [Element.Text(id, seat, content)], next: next + 1 }
            },
            .Tag(el) -> {
                self.said.push(Patch.Create(id, el.tag))
                self.say([Patch.SetAttr(id, a.name, a.value) for a in attrs_of(el)])
                self.say([Patch.SetProp(id, p.name, p.value) for p in props_of(el)])
                self.say([Patch.Listen(id, listening_of(a)) for a in el.hears])
                let within = self.siblings(id, [], el.kids, next + 1)
                Drawn {
                    page: [Element.Tag(el with { id: id, kids: within.page })],
                    next: within.next,
                }
            },
        }
    }

    /// An element that stays keeps its number: only what differs is said.
    fn kept(old: Element, new: Element, next: int) -> Drawn {
        match new {
            .Text(_, seat, content) -> {
                if old.text() != content { self.said.push(Patch.SetText(old.id(), content)) }
                Drawn { page: [Element.Text(old.id(), seat, content)], next: next }
            },
            .Tag(el) -> {
                let was? = old.tagged() else { return self.made(new, next) }
                self.say(attributes(was.id, attrs_of(was), attrs_of(el)))
                self.say(self.properties(was.id, props_of(was), props_of(el)))
                self.say(hearing(was.id, was.hears, el.hears))
                let within = self.siblings(was.id, was.kids, el.kids, next)
                Drawn {
                    page: [Element.Tag(el with { id: was.id, kids: within.page })],
                    next: within.next,
                }
            },
        }
    }

    /// What a property holds on the page: what the user was heard to move
    /// it to, else what it was last drawn with.
    fn standing(id: NodeId, drawn: Prop) -> Said {
        self.heard.find(it.id == id && it.name == drawn.name)?.value ?? drawn.value
    }

    /// A property is set when the page does not already hold its value:
    /// what the program last drew is not what stands once a user has
    /// typed, so the page's own value is the one compared. A property a
    /// paint no longer names goes back to rest.
    fn properties(id: NodeId, old: List<Prop>, new: List<Prop>) -> List<Patch> {
        [Patch.SetProp(id, p.name, p.value) for p in new if !same_said(
            self
                .standing(id, old.find(it.name == p.name) ?? Prop { name: p.name, value: at_rest(p.value) }),
            p.value,
        )]
            .concat(
                [Patch.SetProp(id, was.name, at_rest(was.value)) for was in old if !new.any(it.name == was.name) &&
                    !same_said(self.standing(id, was), at_rest(was.value))],
            )
    }
}

/// An attribute is set when it arrives or changes, and dropped when it goes.
fn attributes(id: NodeId, old: List<HtmlAttr>, new: List<HtmlAttr>) -> List<Patch> {
    [Patch.SetAttr(id, a.name, a.value) for a in new if !old.any(it.name == a.name && it.value == a.value)]
        .concat([Patch.DropAttr(id, b.name) for b in old if !new.any(it.name == b.name)])
}

/// An event is heard anew when it is new, or says something else.
fn hearing(id: NodeId, old: List<Action>, new: List<Action>) -> List<Patch> {
    [Patch.Unlisten(id, was.kind) for was in old if !new.any((a) -> same_hearing(was, a))]
        .concat(
            [Patch.Listen(id, listening_of(a)) for a in new if !old.any((was) -> same_hearing(was, a))],
        )
}

/// The patches that turn the page `old` into `new`, given what the user
/// was heard to do to it since `old` was drawn. Every element of `old`
/// wears its number; one that stays keeps it, and a new one takes the
/// next from `next` on.
export fn diff(old: List<Element>, new: List<Element>, heard: List<Heard>, next: int) -> Diffed {
    let at = Differ { heard: heard }
    let drawn = at.siblings(null, old, new, next)
    Diffed { patches: at.said.get(), page: drawn.page, next: drawn.next }
}
