//! `render.av` — the neutral vocabulary a component PROJECTS to and every
//! target consumes. Closed and versioned: a primitive is a semantic
//! interaction contract, an attribute is a component property, a Node is
//! the eager tree. No user writes these; they are a component's machine
//! projection, the component being the one source of truth.
use style.box.{Box}
use @std.meta.{derive}
use style.words.{Words}
use realize.facets.{Facets, Facet}

/// The interaction contract a component IS. Every target answers every
/// one, or the build names the target.
export enum Prim {
    Text
    Heading
    Button
    Link
    Image
    Field
    Checkbox
    Row
    Column
    Dialog
    Divider
    Icon
    Surface
    List
    Item
    Card
    Progress
    Alert
    Spinner
    Form
    Switch
    Slider
}

/// How urgently a live region speaks.
@derive(Words)
export enum Urgency {
    @word(polite) Polite
    @word(assertive) Assertive
}

/// A component property, projected from the component's own fields.
/// Semantic STATE crosses as an attribute (`Disabled`, `Open`, `Invalid`);
/// a visual variant resolves to `Style` at the component.
@derive(Facets)
export enum Attribute {
    @facet(content) Text(content: string)
    @facet(content) Label(text: string)
    @facet(level) Level(rank: int)
    Value(text: string)
    Amount(n: int)
    Placeholder(text: string)
    Src(url: string)
    Alt(text: string)
    Href(url: string)
    Min(n: int)
    Max(n: int)
    Disabled(flag: bool)
    Checked(flag: bool)
    Selected(flag: bool)
    Open(flag: bool)
    Invalid(flag: bool)
    Loading(flag: bool)
    @facet(urgency) Urgency(level: Urgency)
    Title(text: string)
    Name(text: string)
}

/// A drawn node: its primitive, its attributes, its shared Box and its
/// children, eager — so the tree IS data a tool can read.
export type Node = {
    prim: Prim,
    attrs: List<Attribute>,
    box: Box,
    children: List<Node>,
}

// ── neutral projections every target reads ──────────────────────

/// A node's words: its `Text`, else its `Label`.
export fn content_of(attrs: List<Attribute>) -> string {
    let found? = attrs.find(is_words) else { return "" }
    match found { .Text(t) or .Label(t) -> t, rest -> "" }
}

/// Whether an attribute carries a node's own words.
fn is_words(a: Attribute) -> bool { a.facet() == Facet.Content }

/// A heading's level, defaulting to one.
export fn level_of(attrs: List<Attribute>) -> int {
    let found? = attrs.find(is_level) else { return 1 }
    match found { .Level(r) -> r, rest -> 1 }
}

/// Whether an attribute is a heading's level.
fn is_level(a: Attribute) -> bool { a.facet() == Facet.Level }

