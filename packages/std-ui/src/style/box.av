//! `style/box.av` — the groups every component shares, spread in as
//! `..Box` so a component's fields are its look, its placement, its
//! announcement and where it stands, with ONE definition per concern.
//! Charter §6.
use style.style.{Style}
use style.layout.{Layout}
use a11y.name.{Name}
use tree.identity.{Stand, stand_of}

/// What every component instance carries beside its own content.
export type Box = {
    style: Style = Style {},
    layout: Layout = Layout {},
    a11y: Name = Name {},
    ..Stand,
}

impl Box {
    /// What the box says of where its node stands.
    fn stand() -> Stand { stand_of(self.key, self.site) }
}
