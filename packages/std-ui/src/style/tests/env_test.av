//! The inherited environment, by its law: it always resolves, because the
//! library ships defaults, and it is replaced whole.
use @std.ui.env.{Env, Density, Direction, SizeClass}

fn unset() -> Env { Env {} }

fn arabic() -> Env {
    Env { density: .Compact, direction: .Rtl, locale: "ar", size_class: .Expanded }
}

spec "std/ui env — an environment nobody set" {
    given "the library's defaults" {
        then "is comfortable inside" { unset().density == Density.Comfortable }
        then "is left to right" { unset().direction == Direction.Ltr }
        then "is english and medium" { unset().locale == "en" && unset().size_class == SizeClass.Medium }
    }
}

spec "std/ui env — an environment replaced" {
    given "a compact, right-to-left, expanded environment" {
        then "reads back each value" { arabic().density == Density.Compact && arabic().direction == Direction.Rtl }
        then "keeps the locale and size class it was given" {
            arabic().locale == "ar" && arabic().size_class == SizeClass.Expanded
        }
    }
}
