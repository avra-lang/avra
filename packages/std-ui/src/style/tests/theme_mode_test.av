//! The theme modes, by their law: a mode is a whole theme — its scales
//! kept, every colour replaced — never a patch.
use @std.ui.{Tone, Size}
use @std.ui.style.theme.{Mode, default_theme, dark_theme, high_contrast_theme, space_of, color_of}

spec "std/ui theme — modes" {
    given "the default theme" {
        then "is light" { default_theme.mode == Mode.Light }
    }
    given "the dark theme" {
        then "is dark" { dark_theme.mode == Mode.Dark }
        then "keeps the light theme's scale" { space_of(dark_theme, Size.M) == 16 }
        then "replaces the text colour" { color_of(dark_theme, Tone.Text) == "#eeeeee" }
    }
    given "the high-contrast theme" {
        then "is high contrast" { high_contrast_theme.mode == Mode.HighContrast }
        then "flattens the raised surface" { color_of(high_contrast_theme, Tone.SurfaceRaised) == "#ffffff" }
    }
}
