//! Attacks on the style data: absence against the empty value, a theme
//! replaced whole, and every field present at once.
use @std.ui.style.style.{Style}
use @std.ui.{Size, Tone, Font}
use @std.ui.style.theme.{Theme, default_theme, space_of, radius_of, color_of, face_of}
use @std.ui.style.tokens.{Level, TypeSize}

/// `.None` is a REAL token: present, and not the same as absent.
fn present_none() -> Style { Style { radius: .None } }

fn full() -> Style {
    Style {
        radius: .M,
        fill: .SurfaceRaised,
        color: .Danger,
        elevation: .High,
        face: .Mono,
        text_size: .Title,
        line_height: .Tight,
        tracking: .Wide,
    }
}

/// The default theme with its space scale shifted up by one.
fn shifted() -> Theme {
    default_theme with { space: {"none": 1, "xs": 2, "s": 3, "m": 4, "l": 5, "xl": 6} }
}

spec "std/ui style — absence is not the empty value" {
    given "a radius nobody set" {
        then "falls back when a question supplies a default" {
            empty_style().radius ?? Size.Xs == Size.Xs
        }
    }
    given "a radius set to the empty size" {
        then "is present — the fallback is never consulted" {
            present_none().radius ?? Size.Xs == Size.None
        }
        then "reads as zero through the theme, not as absent" {
            default_theme.space_of(present_none().radius ?? Size.M) == 0
        }
    }
}

spec "std/ui style — a theme is read whole" {
    given "a theme whose space scale shifted by one" {
        then "every step reads from the replaced table" {
            space_of(shifted(), Size.None) == 1 && space_of(shifted(), Size.Xl) == 6
        }
        then "a table it kept reads its own value" {
            radius_of(shifted(), Size.M) == 8
        }
    }
}

spec "std/ui style — every field present at once" {
    given "a style with every appearance field set" {
        then "reads back the shape and type it was given" {
            full().radius ?? Size.None == Size.M &&
                full().text_size ?? TypeSize.Body == TypeSize.Title
        }
        then "reads back the face and elevation it was given" {
            full().face == Font.Mono && full().elevation ?? Level.Flat == Level.High
        }
        then "projects to the tokens the theme names" {
            default_theme.color_of(full().color ?? Tone.Text) == "#b00020" &&
                default_theme.face_of(full().face ?? Font.Body) == "ui-monospace, monospace"
        }
    }
}
