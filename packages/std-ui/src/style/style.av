//! `style/style.av` — a component's LOOK as data: typed, optional,
//! token-valued. Every field is absent unless set, so a realizer tells
//! "not given" from "given the default". Geometry lives in `Layout`;
//! this is appearance only. UI.md §19.1, charter §4.
use ui.{Size, Tone, Font}
use style.tokens.{Level, TypeSize, LineHeight, Tracking}
use @std.meta.{derive}
use style.words.{Words}

/// A platform interaction state a component may look different in. The
/// realizer tracks it; the app never writes it.
@derive(Words)
export enum Interaction {
    @word(hover) Hover
    @word(focus) Focus
    @word(pressed) Pressed
    @word(disabled) Disabled
}

/// One state's look, overriding the base `Style` while the state holds.
export type StateStyle = { state: Interaction, style: Style }

/// The appearance a component was given: shape, colour, elevation and
/// type ROLES, never a length or a colour. `states` are the interaction
/// overrides a target maps to its own mechanism (CSS pseudo-classes,
/// native highlight).
export type Style = {
    radius: Size? = null,
    fill: Tone? = null,
    color: Tone? = null,
    elevation: Level? = null,
    face: Font? = null,
    text_size: TypeSize? = null,
    line_height: LineHeight? = null,
    tracking: Tracking? = null,
    states: List<StateStyle> = [],
}
