//! `style/style.av` — a component's LOOK, as data. Every field is
//! OPTIONAL and token-valued: absent means the component did not ask,
//! so a realizer tells "not given" from "given the default". A
//! `Theme` turns the tokens into per-target values. UI.md §19.1.
use ui.{Size, Tone, Font}

/// The look a component was given: spacing, shape and colour ROLES,
/// never a length or a colour. Nothing here is target-specific.
export type Style = {
    gap: Size? = null,
    pad: Size? = null,
    radius: Size? = null,
    fill: Tone? = null,
    color: Tone? = null,
    face: Font? = null,
}
