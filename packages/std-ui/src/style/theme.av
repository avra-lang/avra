//! `style/theme.av` — the token TABLES as data. A token is a name; the
//! theme is what each name means on a target, held as a Map keyed by the
//! token's own WORD. One default ships; a user replaces it whole. Values
//! are target-neutral (whole units, a colour as text, a family list).
use ui.{Size, Tone, Font}
use @std.meta.{derive}
use style.words.{Words}

/// Which contrast mode a theme is written for.
@derive(Words)
export enum Mode {
    @word(light) Light
    @word(dark) Dark
    @word(high_contrast) HighContrast
}

/// Every token family one target needs, together.
export type Theme = {
    mode: Mode,
    space: Map<string, int>,
    radius: Map<string, int>,
    color: Map<string, string>,
    face: Map<string, string>,
}

const system_ui = "system-ui, sans-serif"

export const default_theme = Theme {
    mode: .Light,
    space: {"none": 0, "xs": 4, "s": 8, "m": 16, "l": 32, "xl": 48},
    radius: {"none": 0, "xs": 2, "s": 4, "m": 8, "l": 16, "xl": 24},
    color: {
        "text": "#111111",
        "muted": "#666666",
        "danger": "#b00020",
        "surface": "#ffffff",
        "surface_raised": "#f7f7f7",
        "surface_sunk": "#ececec",
        "surface_hover": "#f0f0f0",
    },
    face: {
        "body": system_ui,
        "heading": system_ui,
        "footnote": system_ui,
        "mono": "ui-monospace, monospace",
    },
}

/// The dark mode: the scales kept, every colour replaced.
export const dark_theme = default_theme with { mode: .Dark, color: {
    "text": "#eeeeee",
    "muted": "#aaaaaa",
    "danger": "#ff6b6b",
    "surface": "#121212",
    "surface_raised": "#1e1e1e",
    "surface_sunk": "#0a0a0a",
    "surface_hover": "#2a2a2a",
} }

/// The high-contrast mode: flat surfaces, the strongest text.
export const high_contrast_theme = default_theme with { mode: .HighContrast, color: {
    "text": "#000000",
    "muted": "#000000",
    "danger": "#a00000",
    "surface": "#ffffff",
    "surface_raised": "#ffffff",
    "surface_sunk": "#ffffff",
    "surface_hover": "#ffff00",
} }

/// The spacing step a `Size` names.
export fn space_of(t: Theme, z: Size) -> int { t.space.get(z.word()) ?? 0 }

/// The corner step a `Size` names.
export fn radius_of(t: Theme, z: Size) -> int { t.radius.get(z.word()) ?? 0 }

/// The colour a `Tone` names.
export fn color_of(t: Theme, c: Tone) -> string { t.color.get(c.word()) ?? "" }

/// The family list a `Font` names.
export fn face_of(t: Theme, f: Font) -> string { t.face.get(f.word()) ?? "" }
