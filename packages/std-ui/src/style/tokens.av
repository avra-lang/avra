//! `style/tokens.av` — the role tokens a look names beyond spacing and
//! colour: elevation, the type scale, leading and tracking. A token is a
//! NAME; the theme decides what it means on a target. UI.md §19.1.

/// How far a surface floats above the one below it.
export enum Level { Flat, Low, Medium, High, Highest }

/// A step of the type scale: display, headline, title, body, label.
export enum TypeSize { Display, Headline, Title, Body, Label }

/// Leading, relative to the type size.
export enum LineHeight { Tight, Normal, Loose }

/// Letter spacing, relative to the type size.
export enum Tracking { Tight, Normal, Wide }
