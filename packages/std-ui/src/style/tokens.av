//! `style/tokens.av` — the role tokens a look names: spacing, surface and
//! ink, face, elevation, the type scale, leading and tracking. A token is a
//! NAME, never a value: the theme decides what `.M` or `.Muted` means on
//! a target.
use @std.meta.{derive}
use style.words.{Words}
use style.table.{Table}

/// A step of the spacing scale: gaps, pads and radii.
@derive(Words)
@derive(Table)
export enum Size {
    @word(none) None
    @word(xs) Xs
    @word(s) S
    @word(m) M
    @word(l) L
    @word(xl) Xl
}

/// A value for every `Size`.
export type Sizes<V> = { none: V, xs: V, s: V, m: V, l: V, xl: V }

/// A surface by its role: a colour something sits on. The theme pairs each
/// with what sits on it, so a fill names its words' colour too.
@derive(Words)
@derive(Table)
export enum Tone {
    @word(canvas) Canvas
    @word(surface) Surface
    @word(surface_raised) SurfaceRaised
    @word(surface_sunk) SurfaceSunk
    @word(accent) Accent
    @word(neutral) Neutral
    @word(danger) Danger
    @word(success) Success
    @word(warning) Warning
}

/// A value for every `Tone`.
export type Tones<V> = {
    canvas: V,
    surface: V,
    surface_raised: V,
    surface_sunk: V,
    accent: V,
    neutral: V,
    danger: V,
    success: V,
    warning: V,
}

/// A colour drawn over a surface by its role: words, a line, a ring.
@derive(Words)
@derive(Table)
export enum Ink {
    @word(text) Text
    @word(muted) Muted
    @word(disabled) Disabled
    @word(danger) Danger
    @word(success) Success
    @word(warning) Warning
    @word(link) Link
    @word(border) Border
    @word(field) Field
    @word(focus) Focus
}

/// A value for every `Ink`.
export type Inks<V> = {
    text: V,
    muted: V,
    disabled: V,
    danger: V,
    success: V,
    warning: V,
    link: V,
    border: V,
    field: V,
    focus: V,
}

/// A typeface by its role.
@derive(Words)
@derive(Table)
export enum Font {
    @word(body) Body
    @word(heading) Heading
    @word(footnote) Footnote
    @word(mono) Mono
}

/// A value for every `Font`.
export type Fonts<V> = { body: V, heading: V, footnote: V, mono: V }

/// How far a surface floats above the one below it. The theme names the
/// surface each level wears: a level is a surface, never a shadow.
@derive(Words)
@derive(Table)
export enum Level {
    @word(flat) Flat
    @word(low) Low
    @word(medium) Medium
    @word(high) High
    @word(highest) Highest
}

/// A value for every `Level`.
export type Levels<V> = { flat: V, low: V, medium: V, high: V, highest: V }

/// A step of the type scale: display, headline, title, body, label.
@derive(Words)
@derive(Table)
export enum TypeSize {
    @word(display) Display
    @word(headline) Headline
    @word(title) Title
    @word(body) Body
    @word(label) Label
}

/// A value for every `TypeSize`.
export type TypeSizes<V> = { display: V, headline: V, title: V, body: V, label: V }

/// Leading, relative to the type size.
@derive(Words)
@derive(Table)
export enum LineHeight {
    @word(tight) Tight
    @word(normal) Normal
    @word(loose) Loose
}

/// A value for every `LineHeight`.
export type LineHeights<V> = { tight: V, normal: V, loose: V }

/// Letter spacing, relative to the type size.
@derive(Words)
@derive(Table)
export enum Tracking {
    @word(tight) Tight
    @word(normal) Normal
    @word(wide) Wide
}

/// A value for every `Tracking`.
export type Trackings<V> = { tight: V, normal: V, wide: V }
