//! `style/tokens.av` — the role tokens a look names: spacing, colour and
//! face, elevation, the type scale, leading and tracking. A token is a
//! NAME, never a value: the theme decides what `.M` or `.Muted` means on
//! a target.
use @std.meta.{derive}
use style.words.{Words}

/// A step of the spacing scale: gaps, pads and radii.
@derive(Words)
export enum Size {
    @word(none) None
    @word(xs) Xs
    @word(s) S
    @word(m) M
    @word(l) L
    @word(xl) Xl
}

/// A colour by its role.
@derive(Words)
export enum Tone {
    @word(text) Text
    @word(muted) Muted
    @word(danger) Danger
    @word(surface) Surface
    @word(surface_raised) SurfaceRaised
    @word(surface_sunk) SurfaceSunk
    @word(surface_hover) SurfaceHover
}

/// A typeface by its role.
@derive(Words)
export enum Font {
    @word(body) Body
    @word(heading) Heading
    @word(footnote) Footnote
    @word(mono) Mono
}

/// How far a surface floats above the one below it.
export enum Level { Flat, Low, Medium, High, Highest }

/// A step of the type scale: display, headline, title, body, label.
export enum TypeSize { Display, Headline, Title, Body, Label }

/// Leading, relative to the type size.
export enum LineHeight { Tight, Normal, Loose }

/// Letter spacing, relative to the type size.
export enum Tracking { Tight, Normal, Wide }
