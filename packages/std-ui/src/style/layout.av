//! `style/layout.av` — how a component is PLACED: direction, alignment,
//! distribution, wrapping, sizing and the logical edges. Geometry is
//! here and nowhere else; `Style` never carries a gap or a pad. Values
//! are token steps, never pixels. UI.md §4.3, charter §5.
use ui.{Size}

/// The main axis of a flex container.
export enum Axis { Row, Column }

/// Alignment across the main axis.
export enum Align { Start, Center, End, Stretch, Baseline }

/// Distribution along the main axis.
export enum Distribute { Start, Center, End, SpaceBetween, SpaceAround, SpaceEvenly }

/// Whether and how a flex container wraps.
export enum Wrap { NoWrap, Wrap, WrapReverse }

/// How a box takes its size: its content, its parent, a fixed count of
/// units, or a fraction of its parent.
export enum Sizing { Hug, Fill, Fixed(int), Percent(float) }

/// One token step per LOGICAL edge, so a right-to-left tree mirrors
/// without a second field.
export type Edge = {
    start: Size? = null,
    end: Size? = null,
    top: Size? = null,
    bottom: Size? = null,
}

/// Every edge the same step.
export fn around(z: Size) -> Edge { Edge { start: z, end: z, top: z, bottom: z } }

/// The placement a container or component asks for.
export type Layout = {
    direction: Axis? = null,
    wrap: Wrap? = null,
    gap: Size? = null,
    pad: Edge? = null,
    margin: Edge? = null,
    align: Align? = null,
    distribute: Distribute? = null,
    width: Sizing? = null,
    height: Sizing? = null,
    grow: int = 0,
    aspect: float? = null,
    inset: Edge? = null,
    order: int = 0,
}
