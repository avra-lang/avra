//! `frame/standing.av` — EACH DIALECT'S SHAPES, AS PUBLISHED: the rows a
//! reader of that dialect was written against, kept here as the code stood
//! when the dialect was named. The code may GROW past them under the same
//! dialect — a variant added, a field appended — and a reader of these
//! shapes still reads what it writes. A shape that MOVED is a new dialect:
//! `tests/frame_standing_test.av` refuses a moved slot under a dialect these
//! rows already name, by the slot.
use frame.dialect.{Dialect}

/// One dialect's shapes, a row a line (`frame/shapes.av`).
export type Standing = { dialect: Dialect, shapes: List<string> }

export const standing: List<Standing> = [
    Standing {
        dialect: Dialect.Dom16,
        shapes: [
            "Patch create 1 id:word:NodeId tag:word:HtmlTag",
            "Patch create_text 2 id:word:NodeId content:text",
            "Patch place 3 id:word:NodeId parent:word_or_none:NodeId after:nested:After",
            "Patch remove 4 id:word:NodeId",
            "Patch set_attr 5 id:word:NodeId name:word:HtmlAttrName value:text",
            "Patch drop_attr 6 id:word:NodeId name:word:HtmlAttrName",
            "Patch set_prop 7 id:word:NodeId name:word:HtmlAttrName value:nested:Held",
            "Patch set_text 8 id:word:NodeId content:text",
            "Patch listen 9 id:word:NodeId to:told:Listening",
            "Patch unlisten 10 id:word:NodeId seat:word:Seat",
            "Patch style 11 css:text",
            "Patch call 12 id:word:NodeId verb:text",
            "Patch set_var 14 id:word:NodeId property:text value:text",
            "Patch drop_var 15 id:word:NodeId property:text",
            "Patch adopt 16 kinds:texts words:number",
            "After first 1",
            "After append 2",
            "After sibling 3 id:word:NodeId",
            "Held text 1 value:text",
            "Held flag 2 value:flag",
            "Listening listening 0 seat:word:Seat event:text says:word:Says reads:word_or_none:HtmlAttrName prevents:flag shuts:word_or_none:HtmlAttrName key:text",
            "Asked asked 0 method:text url:text wait_ms:number fields:texts kind:text body:octets",
        ],
    },
    Standing {
        dialect: Dialect.Neutral1,
        shapes: [
            "NativePatch create 1 id:word:NodeId prim:word:Prim",
            "NativePatch set_fact 2 id:word:NodeId fact:nested:Fact",
            "NativePatch drop_fact 3 id:word:NodeId what:word:What under:word_or_none:Interaction",
            "NativePatch place 4 id:word:NodeId parent:word_or_none:NodeId after:word_or_none:NodeId",
            "NativePatch remove 5 id:word:NodeId",
            "NativePatch listen 6 id:word:NodeId seat:word:Seat",
            "NativePatch unlisten 7 id:word:NodeId seat:word:Seat",
            "Fact fact 0 what:word:What under:word_or_none:Interaction holds:nested:Scalar",
            "Scalar text 1 value:text",
            "Scalar flag 2 value:flag",
            "Scalar number 3 value:number",
            "Scalar fraction 4 value:fraction",
        ],
    },
    Standing {
        dialect: Dialect.Tape1,
        shapes: [
            "TapeHead tape_head 0 magic:text frames:word:Dialect shapes:texts",
            "Entry painted 1 frame:octets",
            "Entry echoed 2 id:word:NodeId seat:word:Seat said:nested_or_none:Said",
            "Said text 1 value:text",
            "Said flag 2 value:flag",
            "Said number 3 value:number",
        ],
    },
]
