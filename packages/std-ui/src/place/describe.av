//! `place/describe.av` — a placed tree as text, one node a line, each
//! indented under its parent: its primitive and `x,y` then `w`x`h`.
use tree.node.{Node}
use place.solve.{Placed}
use @std.text.{repeat}

/// The lines of `p`, the placement of `n`.
export fn describe(n: Node, p: Placed) -> string { lines_of(n, p, 0).join("\n") }

fn lines_of(n: Node, p: Placed, depth: int) -> List<string> {
    let r = p.rect
    ["${repeat("  ", depth)}${n.prim.word()} ${r.x},${r.y} ${r.w}x${r.h}"]
        .concat([l for i, c in n.children for l in lines_of(c, p.kids[i], depth + 1)])
}
