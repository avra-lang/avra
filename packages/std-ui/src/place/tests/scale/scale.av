// A tall column and nests of rows and columns place to every row and level.
use @std.ui.tree.node.{Node}
use @std.ui.style.layout.{Layout}
use @std.ui.place.measure.{Cells}
use @std.ui.place.solve.{place}
use @std.ui.realize.tests.support.{holding, boxed, text_node}

fn rows_in(n: Node, width: int) -> int { place(n, Cells {}, width).rect.h }

fn row_nest(depth: int) -> Node {
    if depth == 0 { text_node("core") } else { boxed(.Row, Layout {}, [text_node("x"), row_nest(depth - 1)]) }
}

fn column_nest(depth: int) -> Node {
    if depth == 0 { text_node("core") } else { holding(.Column, [column_nest(depth - 1)]) }
}

println("tall ${rows_in(holding(.Column, [text_node("row ${i}") for i in 0..3000]), 40)}")
println("row nest ${rows_in(row_nest(60), 400)}")
println("column nest ${rows_in(column_nest(300), 40)}")
