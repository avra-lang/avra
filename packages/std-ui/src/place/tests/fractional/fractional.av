// proves: a typeface whose sizes are not whole sixtieths lays out alike in
// both engines — a word 64.06 pixels wide keeps one line in a 64-pixel box, "aa"
// (6.4 pixels) is not cut inside its own box, and two words that fit by
// whole-pixel advances wrap by the true ones.
use @std.ui.env.{Env}
use @std.ui.style.layout.{Layout}
use @std.ui.place.measure.{Cells}
use @std.ui.place.metrics.{Table}
use @std.ui.place.solve.{place}
use @std.ui.place.describe.{describe}
use @std.ui.place.text.{Text}
use @std.ui.realize.tests.support.{boxed, text_node}

fn pixels() -> Text {
    Text {
        metrics: Table {
            advances: {"i": 96, "m": 272, "W": 320, " ": 128},
            fallback: 205,
            up: 768,
            down: 256,
        },
        theme: Env {}.theme,
        rest: Cells {},
    }
}

fn in_row(s: string, width: int) -> string {
    let root = boxed(.Row, Layout {}, [text_node(s)])
    describe(root, place(root, pixels(), width))
}

println(in_row("xxxxxxxxxxxxxxxxxxxx", 64))
println(in_row("xxxxxxxxxx xxxxxxxxxx", 64))
println(in_row("aa", 300))
