// proves: a percent that is no number is refused with its words in both engines, never read as some other size
use @std.ui.place.measure.{Cells}
use @std.ui.place.solve.{place}
use @std.ui.realize.tests.support.{boxed, placed, text_node}
use @std.ui.style.layout.{Layout}

let root = boxed(.Row, Layout {}, [placed(text_node(""), Layout { width: .Percent(0.0 / 0.0) })])
let laid = place(root, Cells {}, 20)
println("unreached ${laid.rect.w}")
