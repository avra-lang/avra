//! `place/measure.av` — what the solver asks a target about size. The
//! solver knows no unit: a target answers in its own (terminal cells, or
//! pixels from a typeface's metrics), always whole numbers, so one
//! algorithm places a tree on every surface.
use @std.text.{cells}
use tree.node.{Node}
use style.tokens.{Size}
use realize.tui.layout.{
    own_lines,
    kept_cells,
    pointer_cells,
    closed_node,
    holds_children,
    unbreakable_cells,
    gap_rows,
    gap_cols,
    pad_cols,
}

/// A size in the target's unit.
export type Extent = { w: int, h: int }

/// Parts to the unit that `own_fine` and `min_own_fine` speak: the solver's
/// own, sixtieths, as a browser carries a length.
export const fine = 60

/// The questions the solver asks. `own` is the node's content before its
/// children, wrapped to `avail` across; `kept` what a node keeps from its
/// children's start edge, given where it stands (a list's bullet, the mark
/// beside the node the keys go to); `hidden` whether it takes no place at
/// all, as a closed dialog does; `holds` whether its children take part in
/// the layout at all; `min_own` the narrowest that
/// content can be laid (its longest unbreakable run); `gap_x`/`gap_y` and
/// `pad_x`/`pad_y` what a spacing step is along each axis.
export trait Measure {
    fn own(n: Node, avail: int) -> Extent
    fn own_fine(n: Node, avail: int) -> Extent {
        let e = self.own(n, avail / fine)
        Extent { w: e.w * fine, h: e.h * fine }
    }
    fn min_own_fine(n: Node) -> int { self.min_own(n) * fine }
    fn kept(n: Node, path: string) -> int
    fn hidden(n: Node) -> bool
    fn holds(n: Node) -> bool
    fn min_own(n: Node) -> int
    fn gap_x(z: Size) -> int
    fn gap_y(z: Size) -> int
    fn pad_x(z: Size) -> int
    fn pad_y(z: Size) -> int
}

/// The terminal's answers: one cell across, one line down. `focus` is the
/// path of the node the keys go to, which keeps a gutter for its mark.
export type Cells = { focus: string = "" }

impl Measure for Cells {
    fn own(n: Node, avail: int) -> Extent { extent_of(own_lines(n, avail)) }
    fn kept(n: Node, path: string) -> int { kept_cells(n) + if path == self.focus { pointer_cells } else { 0 } }
    fn hidden(n: Node) -> bool { closed_node(n) }
    fn holds(n: Node) -> bool { holds_children(n) }
    fn min_own(n: Node) -> int { unbreakable_cells(n) }
    fn gap_x(z: Size) -> int { gap_cols(z) }
    fn gap_y(z: Size) -> int { gap_rows(z) }
    fn pad_x(z: Size) -> int { pad_cols(z) }
    fn pad_y(z: Size) -> int { gap_rows(z) }
}

/// The widest line and the line count.
fn extent_of(ls: List<string>) -> Extent { Extent { w: [cells(l) for l in ls].max() ?? 0, h: ls.length } }
