//! `place/text.av` — the solver's questions about text, answered from a
//! typeface. A text node is broken into lines by its face's advances, summed
//! in sixty-fourths and handed to the solver in sixtieths, rounded once on the
//! way; every other node is `rest`'s to answer.
use tree.node.{Node}
use style.tokens.{Size}
use style.theme.{Theme}
use place.lines.{lines_in, longest_in}
use place.measure.{Measure, Extent, fine}
use place.metrics.{Metrics, run_width, line_height, subunits}

/// A target of pixels (or any unit a face is drawn in): `metrics` measures
/// the text, `theme` gives the spacing, and `rest` answers for what is not text.
export type Text = { metrics: dyn Metrics, theme: Theme, rest: dyn Measure }

/// `n` in a ratio of `to` parts per `from`, halves up.
fn rescaled(n: int, to: int, from: int) -> int { (n * to + from / 2) / from }

impl Measure for Text {
    fn own(n: Node, avail: int) -> Extent {
        if !(n.prim is .Text) { return self.rest.own(n, avail) }
        let m = self.metrics
        let room = rescaled(avail, subunits, fine)
        let ls = lines_in(
            n.words(),
            if room < subunits { subunits } else { room },
            (s: string) -> run_width(m, s),
        )
        Extent {
            w: rescaled([run_width(m, l) for l in ls].max() ?? 0, fine, subunits),
            h: rescaled(ls.length * line_height(m), fine, subunits),
        }
    }

    fn kept(n: Node, path: string) -> int { self.rest.kept(n, path) }
    fn hidden(n: Node) -> bool { self.rest.hidden(n) }
    fn holds(n: Node) -> bool { self.rest.holds(n) }

    fn min_own(n: Node) -> int {
        if !(n.prim is .Text) { return self.rest.min_own(n) }
        let m = self.metrics
        rescaled(longest_in(n.words(), (s: string) -> run_width(m, s)), fine, subunits)
    }

    fn gap_x(z: Size) -> int { self.theme.space_of(z) }
    fn gap_y(z: Size) -> int { self.theme.space_of(z) }
    fn pad_x(z: Size) -> int { self.theme.space_of(z) }
    fn pad_y(z: Size) -> int { self.theme.space_of(z) }
}
