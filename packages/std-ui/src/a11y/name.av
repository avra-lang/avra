//! `a11y/name.av` — how a node is ANNOUNCED. The words a person hears
//! come from the component's own content by default — a button's
//! label, a heading's text — and a component that needs something else
//! gives an explicit `label`, a longer `describe`, or marks a purely
//! decorative node `hidden`. WEB_UI §10.2; UI.md §19.2.

/// The accessible name a component instance carries. Absent `label`
/// means the component's own visible words name it, which is the
/// ordinary case; `describe` is a longer explanation and never a name.
export type Name = {
    label: string? = null,
    describe: string? = null,
    hidden: bool = false,
}

/// The words announced for a node: its explicit label, else its own.
export fn announced(n: Name, own: string) -> string { n.label ?? own }

/// Whether a node has anything to announce. A component whose own
/// words can be empty (a label built from data) is checked with this;
/// a description alone does not name a node.
export fn named(n: Name, own: string) -> bool { !announced(n, own).is_empty() }
