// proves: a `state` record FIELD holds a Cell — a copy of the record
// shares the cell, so a write through one copy is seen by another, and
// the read answers the value it holds with no Cell in sight.
type Registry = { state shapes: List<int> = [] }

fn add(r: Registry, v: int) -> int {
    r.shapes.push(v)
    r.shapes.length
}

let r = Registry {}
println("${add(r, 7)} ${add(r, 8)} ${r.shapes.length}")
