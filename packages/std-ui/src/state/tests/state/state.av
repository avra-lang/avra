// proves: a `state` binding is SHARED by what captures it — the place
// outlives the call, so three calls see one value. A `mut` local
// cannot: a capture is a copy of a value, and a Cell's copy shares.
fn counter() -> fn() -> int {
    state n: int = 0
    () -> {
        n.set(n.get() + 1)
        n.get()
    }
}

let c = counter()
println("${c()} ${c()} ${c()}")
