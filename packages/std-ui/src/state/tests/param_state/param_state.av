// proves: a `state` parameter is a PLACE the caller owns — the seat is
// the caller's Cell, so the callee's `n = n + 1` reaches `counted`'s `c`.
fn stepper(state n: int) {
    n = n + 1
}

fn counted() -> int {
    state c: int = 0
    stepper(c)
    stepper(c)
    stepper(c)
    c
}

println("${counted()}")
