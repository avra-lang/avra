//! `native/net.av` — the network a native app sends its requests over: the
//! one `@std/http` client, so a page's `fetch` and this send the same
//! `Request` value. A screen under test is given a network of its own.
use @std.http.fetch.{options, send}
use @std.http_message.message.{Reply, Request}

/// `r` sent over `@std/http`: its reply, or the words of why there is none.
export fn over_http(r: Request) -> Result<Reply, string> {
    match send(r, options()) {
        .Ok(a) -> .Ok(Reply { status: a.status, headers: a.headers, body: a.body }),
        .Err(e) -> .Err(e.describe().message),
    }
}

/// The network of a screen nothing wired one to.
export fn unwired(_r: Request) -> Result<Reply, string> { .Err("this screen has no network") }
