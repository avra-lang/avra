//! `components/card.av` — a titled grouping surface.
use @std.meta.{derive}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}
use tree.story.{story}

@derive(View)
@prim(.Card)
export component card(@attr(.Title) title: string) {
    ..Box
    @children items: List<dyn View> = []
}

/// A titled group of what belongs together.
@story
fn card_story() -> card {
    card "Today" {
        text "Three tasks are open."
    }
}
