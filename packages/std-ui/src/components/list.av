//! `components/list.av` — a collection of items.
use @std.meta.{derive}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}
use tree.story.{story}

@derive(View)
@prim(.List)
export component list {
    ..Box
    @children items: List<dyn View> = []
}

/// Entries in order.
@story
fn list_story() -> list {
    list {
        item {
            text "Milk"
        }
        item {
            text "Eggs"
        }
    }
}
