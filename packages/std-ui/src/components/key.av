//! `components/key.av` — a shortcut. It draws nothing: it is live while the
//! node that holds it, or anything under that node, has the focus, and the
//! key goes to the nearest, from the focused node out to the root.
use @std.meta.{derive}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}

@derive(View)
@prim(.Key)
export component key(@attr(.Label) chord: string) {
    ..Box
    @host(web: .Keydown, terminal: .Shortcut) on press
}
