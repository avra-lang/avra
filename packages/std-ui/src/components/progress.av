//! `components/progress.av` — a bounded task's advancement.
use @std.meta.{derive}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}
use tree.sites.{Sighted}
use tree.story.{story}

@derive(View)
@prim(.Progress)
export component progress(@attr(.Label) label: string) {
    ..Box
    ..Sighted
    @attr(.Amount) amount: int = 0
    @attr(.Max) max: int = 100
}

/// How far along a task is.
@story
fn progress_story() -> progress { progress "Done" { amount: 2, max: 4 } }
