//! `components/progress.av` — a bounded task's advancement.
use @std.meta.{derive, Cells, Words}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}
use tree.sites.{no_words}

@derive(View)
@prim(.Progress)
export component progress(@attr(.Label) label: string) {
    ..Box
    words: Words = no_words()
    reads: Cells = []
    @attr(.Amount) amount: int = 0
    @attr(.Max) max: int = 100
}
