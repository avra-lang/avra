//! `components/row.av` — its children side by side.
use @std.meta.{derive}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}
use tree.story.{story}

@derive(View)
@prim(.Row)
export component row {
    ..Box
    @children items: List<dyn View> = []
}

/// Views side by side, in reading order.
@story
fn row_story() -> row {
    row {
        button "Back"
        button "Next"
    }
}
