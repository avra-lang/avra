//! `components/row.av` — a horizontal run of views. UI.md §19.2.
use realize.view.{View}
use realize.realizer.{Realizer, drawn}
use style.box.{Box}

/// A horizontal run.
export component row {
    ..Box
    items: List<dyn View> = []
}

impl View for row {
    fn realize(r: dyn Realizer) {
        r.row_begin()
        drawn(self.items, r)
        r.row_end()
    }
}
