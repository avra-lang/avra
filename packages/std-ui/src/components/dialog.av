//! `components/dialog.av` — a modal layer; `label` names it, `open` is its place, and `dismiss`
//! is the user sending it away: the key, or a press outside it. Given a place it shares it, given
//! none it keeps its own, seeded from `initial`; a dismissal writes `false` into it, then the
//! `dismiss` handler hears it. `shown`, where given, is whether it stands open instead.
use @std.meta.{derive}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}
use tree.sites.{Sighted}
use tree.story.{story}

@derive(View)
@prim(.Dialog)
export component dialog(@attr(.Label) label: string) {
    ..Box
    ..Sighted
    initial: bool = false
    @attr(.Open) state open: bool = self.initial
    @over(open) shown: bool? = null
    @children items: List<dyn View> = []
    @sets(open, false) on dismiss
}

/// A question that stands over the page.
@story
fn dialog_story() -> dialog {
    dialog "Delete the task?" {
        text "It cannot be undone."
        button "Delete"
    }
}
