//! `components/dialog.av` — a modal layer; `label` names it, `open` is its state.
use @std.meta.{derive}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}

@derive(View)
@prim(.Dialog)
export component dialog(@attr(.Label) label: string) {
    ..Box
    @attr(.Open) open: bool = false
    @children items: List<dyn View> = []
}
