//! `components/dialog.av` — a modal layer; `label` names it, `open` is its state.
use @std.meta.{derive}
use realize.prim.{prim}
use realize.view.{View}
use style.box.{Box}

@derive(View)
@prim(.Dialog)
export component dialog(label: string) {
    ..Box
    open: bool = false
    items: List<dyn View> = []
}
