//! `components/dialog.av` — a modal layer; `label` names it, `open` is its
//! state, and `dismiss` is the user sending it away: the key, or a press
//! outside it.
use @std.meta.{derive, Cells, Words}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}
use tree.sites.{no_words}

@derive(View)
@prim(.Dialog)
export component dialog(@attr(.Label) label: string) {
    ..Box
    words: Words = no_words()
    reads: Cells = []
    @attr(.Open) open: bool = false
    @children items: List<dyn View> = []
    @host(web: .Cancel, terminal: .Escape, always: true) on dismiss
}
