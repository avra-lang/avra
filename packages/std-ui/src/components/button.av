//! `components/button.av` — a control that is pressed; `submits` sends the form it stands in.
use @std.meta.{derive}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}

@derive(View)
@prim(.Button)
export component button(@attr(.Label) label: string) {
    ..Box
    @attr(.Disabled) disabled: bool = false
    @attr(.Loading) loading: bool = false
    @attr(.Submits) submits: bool = false
    on press
}
