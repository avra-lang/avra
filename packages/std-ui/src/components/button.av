//! `components/button.av` — a control that is pressed; `submits` sends the form it stands in.
use @std.meta.{derive}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}
use tree.sites.{Sighted}
use tree.story.{story, case}

@derive(View)
@prim(.Button)
export component button(@attr(.Label) label: string) {
    ..Box
    ..Sighted
    @attr(.Disabled) disabled: bool = false
    @attr(.Loading) loading: bool = false
    @attr(.Submits) submits: bool = false
    on press
}

/// Words to press.
@story
fn button_story() -> button { button "Save" }

/// Saving: pressed, and waiting on the server.
@case("busy")
fn button_busy() -> button { button_story() with { loading: true, disabled: true } }
