//! `components/button.av`. UI.md §19.2.
use @std.meta.{derive}
use realize.prim.{prim}
use realize.render.{Run}
use realize.view.{View}
use style.box.{Box}

@derive(View)
@prim(.Button)
export component button(label: string) {
    ..Box
    disabled: bool = false
    loading: bool = false
    on_click: Run? = null
}
