//! `components/button.av`. UI.md §19.2.
use @std.meta.{derive}
use realize.prim.{prim}
use realize.view.{View}
use style.box.{Box}

@derive(View)
@prim(.Button)
export component button(@attr(Label) label: string) {
    ..Box
    @attr(Disabled) disabled: bool = false
    @attr(Loading) loading: bool = false
    on press
}
