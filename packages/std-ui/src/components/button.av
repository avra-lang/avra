//! `components/button.av` — a pressable action. UI.md §19.2.
use realize.view.{View}
use realize.realizer.{Realizer}
use style.box.{Box}

/// A button, named by its label.
export component button(label: string) {
    ..Box
    disabled: bool = false
}

impl View for button {
    fn realize(r: dyn Realizer) { r.button(self) }
}
