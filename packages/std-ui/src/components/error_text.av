//! `components/error_text.av` — a validation message; its colour is the
//! danger role, resolved to the node's `Style`.
use @std.meta.{derive}
use realize.prim.{prim}
use realize.view.{View}
use style.box.{Box}
use ui.{Tone}

@derive(View)
@prim(.Text)
export component error_text {
    ..Box
    @attr(Text) message: string
    @style(color) tone: Tone = .Danger
}
