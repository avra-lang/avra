//! `components/error_text.av` — a validation message; its colour is the
//! danger role, resolved to the node's `Style`.
use @std.meta.{derive}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}
use style.tokens.{Ink}
use tree.story.{story}

@derive(View)
@prim(.Text)
export component error_text {
    ..Box
    @attr(.Text) message: string
    @style(color) ink: Ink = .Danger
}

/// What went wrong, beside what it is about.
@story
fn error_text_story() -> error_text { error_text { message: "A name is required." } }
