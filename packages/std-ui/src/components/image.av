//! `components/image.av` — a content image; its meaning is its alternative.
use @std.meta.{derive}
use realize.prim.{prim}
use realize.url.{Url}
use realize.view.{View}
use style.box.{Box}

@derive(View)
@prim(.Image)
export component image(@attr(Src) src: Url) {
    ..Box
    @attr(Alt) alt: string
}
