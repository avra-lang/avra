//! `components/catalogue.av` — every component, gathered. A new component
//! is ONE declaration; this list, and everything built on it (the gallery,
//! the a11y audit, a target's skeleton), sees it with no hand list.
export type ComponentEntry = { name: string }

collect components: List<ComponentEntry> = @prim in package as ComponentEntry { name: it.name } by it.name
