//! `components/slider.av` — a bounded numeric control; its label names it.
use @std.meta.{derive}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}
use tree.sites.{Sighted}
use tree.story.{story}

@derive(View)
@prim(.Slider)
export component slider(@attr(.Label) label: string) {
    ..Box
    ..Sighted
    @attr(.Amount) amount: int? = null
    @attr(.Min) min: int = 0
    @attr(.Max) max: int = 100
    on change(amount: int)
}

/// An amount between two ends.
@story
fn slider_story() -> slider { slider "Volume" { amount: 30 } }
