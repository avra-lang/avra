//! `components/slider.av` — a bounded numeric control; its label names it.
use @std.meta.{derive, Cells, Words}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}
use tree.sites.{no_words}

@derive(View)
@prim(.Slider)
export component slider(@attr(.Label) label: string) {
    ..Box
    words: Words = no_words()
    reads: Cells = []
    @attr(.Amount) amount: int? = null
    @attr(.Min) min: int = 0
    @attr(.Max) max: int = 100
    @host(web: .Change) on change(amount: int)
}
