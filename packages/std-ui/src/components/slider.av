//! `components/slider.av` — a bounded numeric control; its label names it.
use @std.meta.{derive}
use realize.prim.{prim}
use realize.view.{View}
use style.box.{Box}

@derive(View)
@prim(.Slider)
export component slider(label: string) {
    ..Box
    amount: int = 0
    min: int = 0
    max: int = 100
}
