//! `components/spinner.av` — an indeterminate wait; `label` names it.
use @std.meta.{derive, Cells, Words}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}
use tree.sites.{no_words}

@derive(View)
@prim(.Spinner)
export component spinner(@attr(.Label) label: string) {
    ..Box
    words: Words = no_words()
    reads: Cells = []
}
