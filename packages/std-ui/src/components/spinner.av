//! `components/spinner.av` — an indeterminate wait; `label` names it.
use @std.meta.{derive}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}
use tree.sites.{Sighted}
use tree.story.{story}

@derive(View)
@prim(.Spinner)
export component spinner(@attr(.Label) label: string) {
    ..Box
    ..Sighted
}

/// Work under way, said in words.
@story
fn spinner_story() -> spinner { spinner "Loading" }
