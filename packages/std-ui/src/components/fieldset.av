//! `components/fieldset.av` — a group of a form's inputs under its legend.
use @std.meta.{derive}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}
use tree.story.{story}

@derive(View)
@prim(.Fieldset)
export component fieldset(@attr(.Title) legend: string) {
    ..Box
    @children items: List<dyn View> = []
}

/// Inputs that belong together, under one legend.
@story
fn fieldset_story() -> fieldset {
    fieldset "Address" {
        field "City"
    }
}
