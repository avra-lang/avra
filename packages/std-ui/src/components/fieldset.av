//! `components/fieldset.av` — a group of a form's inputs under its legend.
use @std.meta.{derive}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}

@derive(View)
@prim(.Fieldset)
export component fieldset(@attr(.Title) legend: string) {
    ..Box
    @children items: List<dyn View> = []
}
