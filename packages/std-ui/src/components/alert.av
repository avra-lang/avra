//! `components/alert.av` — a live message; `urgency` is how loudly it speaks.
use @std.meta.{derive}
use realize.prim.{prim}
use realize.render.{Urgency}
use realize.view.{View}
use style.box.{Box}

@derive(View)
@prim(.Alert)
export component alert(@attr(Text) message: string) {
    ..Box
    @attr(Urgency) urgency: Urgency = .Polite
}
