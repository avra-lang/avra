//! `components/alert.av` — a live message; `urgency` is how loudly it speaks.
use @std.meta.{derive, Cells, Words}
use tree.prim.{prim}
use tree.node.{Urgency}
use tree.view.{View}
use style.box.{Box}
use tree.sites.{no_words}

@derive(View)
@prim(.Alert)
export component alert(@attr(.Text) message: string) {
    ..Box
    words: Words = no_words()
    reads: Cells = []
    @attr(.Urgency) urgency: Urgency = .Polite
}
