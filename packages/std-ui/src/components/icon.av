//! `components/icon.av` — a picture drawn text-sized in the tone the use
//! names; silent unless it is named.
use @std.meta.{derive}
use @std.assets.{Picture}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}
use tree.story.{story}
use tree.story_text.{story_picture}

@derive(View)
@prim(.Icon)
export component icon(@attr(.Source) picture: Picture) {
    ..Box
    @attr(.Name) name: string = ""
}

/// A picture drawn text-sized, named.
@story
fn icon_story() -> icon { icon story_picture { name: "Done" } }
