//! `components/icon.av` — a picture drawn text-sized in the tone the use
//! names; silent unless it is named.
use @std.meta.{derive}
use @std.assets.{Picture}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}

@derive(View)
@prim(.Icon)
export component icon(@attr(.Source) picture: Picture) {
    ..Box
    @attr(.Name) name: string = ""
}
