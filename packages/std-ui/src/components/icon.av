//! `components/icon.av` — a decorative glyph, named so it is never silent.
use @std.meta.{derive}
use realize.prim.{prim}
use realize.url.{Url}
use realize.view.{View}
use style.box.{Box}

@derive(View)
@prim(.Icon)
export component icon(@attr(.Src) src: Url) {
    ..Box
    @attr(.Name) name: string
}
