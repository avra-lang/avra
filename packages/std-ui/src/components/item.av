//! `components/item.av` — one collection row; `selected` is its state.
use @std.meta.{derive}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}

@derive(View)
@prim(.Item)
export component item {
    ..Box
    @attr(.Selected) selected: bool = false
    @children items: List<dyn View> = []
}
