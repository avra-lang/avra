//! `components/column.av` — its children one under another.
use @std.meta.{derive}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}
use tree.story.{story}

@derive(View)
@prim(.Column)
export component column {
    ..Box
    @children items: List<dyn View> = []
}

/// Views stacked top to bottom.
@story
fn column_story() -> column {
    column {
        text "First"
        text "Second"
    }
}
