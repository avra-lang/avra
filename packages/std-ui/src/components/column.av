//! `components/column.av` — a vertical stack of views. UI.md §19.2.
use realize.view.{View}
use realize.realizer.{Realizer, drawn}
use style.box.{Box}

/// A vertical stack.
export component column {
    ..Box
    items: List<dyn View> = []
}

impl View for column {
    fn realize(r: dyn Realizer) {
        r.column_begin(self)
        drawn(self.items, r)
        r.column_end()
    }
}
