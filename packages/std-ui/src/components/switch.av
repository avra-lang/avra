//! `components/switch.av` — an on/off control whose label names it. `checked` is its place: given
//! one it shares it, given none it keeps its own, seeded from `initial`. A flip writes it, then the
//! `change` handler hears it; `shown`, where given, is what the switch shows instead.
use @std.meta.{derive}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}
use tree.sites.{Sighted}

@derive(View)
@prim(.Switch)
export component switch(@attr(.Label) label: string) {
    ..Box
    ..Sighted
    initial: bool = false
    @attr(.Checked) state checked: bool = self.initial
    @over(checked) shown: bool? = null
    @sets(checked) on change(checked: bool)
}
