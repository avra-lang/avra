//! `components/switch.av` — an on/off control whose label names it.
use @std.meta.{derive, Cells, Words}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}
use tree.sites.{no_words}

@derive(View)
@prim(.Switch)
export component switch(@attr(.Label) label: string) {
    ..Box
    words: Words = no_words()
    reads: Cells = []
    @attr(.Checked) checked: bool? = null
    @host(web: .Change, terminal: .Enter) on change(checked: bool)
}
