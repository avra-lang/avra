//! `components/surface.av` — a plain container with a look, no semantics.
use @std.meta.{derive}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}
use tree.story.{story}

@derive(View)
@prim(.Surface)
export component surface {
    ..Box
    @children items: List<dyn View> = []
}

/// A ground that sets what stands on it apart.
@story
fn surface_story() -> surface {
    surface {
        text "Inside"
    }
}
