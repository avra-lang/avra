//! `components/form.av` — a group of fields with one submit meaning.
use @std.meta.{derive}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}
use tree.story.{story}

@derive(View)
@prim(.Form)
export component form {
    ..Box
    @children items: List<dyn View> = []
    on submit
}

/// Inputs sent together.
@story
fn form_story() -> form {
    form {
        field "Email"
        button "Send" { submits: true }
    }
}
