//! `components/text.av` — a run of words.
use @std.meta.{derive, Cells}
use tree.prim.{prim}
use tree.view.{View}
use tree.sites.{no_words}
use style.box.{Box}

@derive(View)
@prim(.Text)
export component text(@attr(.Text) content: string) {
    ..Box

    @words(said) words: fn() -> string = no_words
    @words(cells) reads: Cells = []
}
