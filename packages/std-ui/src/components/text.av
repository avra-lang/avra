//! `components/text.av` — inline text: the words a person reads. The
//! component is the node, and it draws itself through `View`. UI.md §19.2.
use realize.view.{View}
use realize.realizer.{Realizer}

/// Inline text.
export component text(content: string) {}

impl View for text {
    fn realize(r: dyn Realizer) { r.text(self) }
}
