//! `components/text.av` — a run of words.
use @std.meta.{derive}
use tree.prim.{prim}
use tree.view.{View}
use tree.sites.{Sighted}
use style.box.{Box}
use tree.story.{story, case}
use style.style.{Style}

@derive(View)
@prim(.Text)
export component text(@attr(.Text) content: string) {
    ..Box
    ..Sighted
}

/// Words.
@story
fn text_story() -> text { text "Hello" }

/// Every script at once: right to left, ideographs, and an emoji its joiner holds together.
@case("scripts")
fn text_scripts() -> text { text "مرحبا بالعالم · 你好，世界 · 👩‍💻" }

/// Words whose first strong character misleads, stating the direction they read in.
@case("stated")
fn text_stated() -> text { text "iPhone ‏מחיר" { style: Style { writing: .Rtl } } }
