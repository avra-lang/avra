//! `components/text.av` — a run of words.
use @std.meta.{derive, Cells, Words}
use tree.prim.{prim}
use tree.view.{View}
use tree.sites.{no_words}
use style.box.{Box}

@derive(View)
@prim(.Text)
export component text(@attr(.Text) content: string) {
    ..Box

    words: Words = no_words()
    reads: Cells = []
}
