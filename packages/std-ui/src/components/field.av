//! `components/field.av` — a text input; its label is its accessible name.
use @std.meta.{derive}
use realize.messages.{Messages}
use realize.prim.{prim}
use realize.view.{View}
use style.box.{Box}

@derive(View)
@prim(.Field)
export component field(label: string) {
    ..Box
    value: string = ""
    placeholder: string = ""
    invalid: bool = false
    on_input: dyn Messages? = null
}
