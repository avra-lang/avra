//! `components/field.av` — a text input; its label is its accessible name.
use @std.meta.{derive}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}

@derive(View)
@prim(.Field)
export component field(@attr(.Label) label: string) {
    ..Box
    @attr(.Value) value: string? = null
    @attr(.Placeholder) placeholder: string = ""
    @attr(.Invalid) invalid: bool = false
    on input(typed: string)
}
