//! `components/field.av` — a text input; its label is its accessible name.
use @std.meta.{derive, Cells, Words}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}
use tree.sites.{no_words}

@derive(View)
@prim(.Field)
export component field(@attr(.Label) label: string) {
    ..Box
    words: Words = no_words()
    reads: Cells = []
    @attr(.Value) value: string? = null
    @attr(.Placeholder) placeholder: string = ""
    @attr(.Invalid) invalid: bool = false
    @attr(.Masked) masked: bool = false
    @host(web: .Input) on input(typed: string)
}
