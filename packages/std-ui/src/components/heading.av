//! `components/heading.av` — a title of what follows, at its rank.
use @std.meta.{derive}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}
use tree.sites.{Sighted}
use tree.story.{story}

@derive(View)
@prim(.Heading)
export component heading(@attr(.Text) content: string) {
    ..Box
    ..Sighted
    @attr(.Level) rank: int = 1
}

/// The title of what follows.
@story
fn heading_story() -> heading { heading "Tasks" }
