//! `components/heading.av` — a section heading. `rank` is its level,
//! `1` the top. UI.md §19.2.
use realize.view.{View}
use realize.realizer.{Realizer}
use style.box.{Box}

/// A section heading.
export component heading(content: string) {
    ..Box
    rank: int = 1
}

impl View for heading {
    fn realize(r: dyn Realizer) { r.heading(self) }
}
