//! `components/heading.av` — a title of what follows, at its rank.
use @std.meta.{derive, Cells, Words}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}
use tree.sites.{no_words}

@derive(View)
@prim(.Heading)
export component heading(@attr(.Text) content: string) {
    ..Box
    words: Words = no_words()
    reads: Cells = []
    @attr(.Level) rank: int = 1
}
