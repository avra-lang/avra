//! `components/checkbox.av` — a binary choice whose label names it.
use @std.meta.{derive}
use tree.prim.{prim}
use tree.view.{View}
use style.box.{Box}

@derive(View)
@prim(.Checkbox)
export component checkbox(@attr(.Label) label: string) {
    ..Box
    @attr(.Checked) checked: bool = false
    on change(checked: bool)
}
