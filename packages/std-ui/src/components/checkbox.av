//! `components/checkbox.av` — a binary choice whose label names it.
use @std.meta.{derive}
use realize.prim.{prim}
use realize.render.{Run}
use realize.view.{View}
use style.box.{Box}

@derive(View)
@prim(.Checkbox)
export component checkbox(label: string) {
    ..Box
    checked: bool = false
    on_change: Run? = null
}
