//! `components/link.av` — a navigation action whose words are its label.
use @std.meta.{derive, Diagnostic}
use tree.prim.{prim}
use tree.url.{Url, local}
use tree.view.{View}
use style.box.{Box}
use tree.sites.{Sighted}
use tree.story.{story}
use tree.named.{control_named}

@derive(View)
@prim(.Link)
export component link(@attr(.Label) label: string) {
    ..Box
    ..Sighted
    @attr(.Href) href: Url
    on press
    /// Its label is its name, never empty.
    fn check() -> List<Diagnostic> { control_named("link", self.label) }
}

/// Words that go somewhere.
@story
fn link_story() -> link { link "About" { href: local("/about") } }
