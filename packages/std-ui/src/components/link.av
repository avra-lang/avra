//! `components/link.av` — a navigation action whose words are its label.
use @std.meta.{derive, Cells, Words}
use tree.prim.{prim}
use tree.url.{Url}
use tree.view.{View}
use style.box.{Box}
use tree.sites.{no_words}

@derive(View)
@prim(.Link)
export component link(@attr(.Label) label: string) {
    ..Box
    words: Words = no_words()
    reads: Cells = []
    @attr(.Href) href: Url
    @host(web: .Click, terminal: .Enter) on press
}
