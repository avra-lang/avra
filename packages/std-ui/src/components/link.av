//! `components/link.av` — a navigation action whose words are its label.
use @std.meta.{derive}
use tree.prim.{prim}
use tree.url.{Url}
use tree.view.{View}
use style.box.{Box}

@derive(View)
@prim(.Link)
export component link(@attr(.Label) label: string) {
    ..Box
    @attr(.Href) href: Url
    on press
}
