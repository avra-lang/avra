//! `components/link.av` — a navigation action whose words are its label.
use @std.meta.{derive}
use realize.messages.{Messages}
use realize.prim.{prim}
use realize.view.{View}
use style.box.{Box}

@derive(View)
@prim(.Link)
export component link(label: string) {
    ..Box
    href: string
    on_click: dyn Messages? = null
}
