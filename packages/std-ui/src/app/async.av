//! `app/async.av` — what a view shows of work that has not finished: the
//! four states it can be in, as a library type a state holds.

/// Work asked for and not yet answered: nothing asked, under way, refused
/// with its words, or answered.
export enum Async<T> {
    Idle
    Loading
    Failed(message: string)
    Ready(value: T)
}

impl Async<T> {
    /// Whether the answer is awaited.
    fn is_loading() -> bool {
        match self { .Loading -> true, .Idle or .Failed(_) or .Ready(_) -> false }
    }

    /// The answer, once there is one.
    fn value() -> T? {
        match self { .Ready(v) -> v, .Idle or .Loading or .Failed(_) -> null }
    }

    /// The refusal's words, when the work failed.
    fn failure() -> string? {
        match self { .Failed(m) -> m, .Idle or .Loading or .Ready(_) -> null }
    }
}

/// An async state with its asks counted: the answer of the LATEST ask is
/// the one that stands, whatever order the answers come in.
export type Fetch<T> = { now: Cell<Async<T>>, asks: Cell<int> }

/// A fetch nothing has asked yet.
export fn fetch<T>() -> Fetch<T> {
    let idle: Async<T> = .Idle
    Fetch { now: Cell.new(idle), asks: Cell.new(0) }
}

impl Fetch<T> {
    /// The state now, to `match` on.
    fn state() -> Async<T> { self.now.get() }

    /// Whether an answer is awaited.
    fn is_loading() -> bool { self.now.get().is_loading() }

    /// The answer, once there is one.
    fn value() -> T? { self.now.get().value() }

    /// The refusal's words, when the work failed.
    fn failure() -> string? { self.now.get().failure() }
}
