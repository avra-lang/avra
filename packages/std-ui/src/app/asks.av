//! `app/asks.av` — the sources a handler asks for by name. Each is a
//! `Want`, data, handed to the app's loop: no task, no host row is named
//! here, so the same call runs on every target.
use app.{Act, Async, Cache, Entry, Fetch, Want, Watcher, running, watching}
use @std.http_message.message.{Reply, Request}
use @std.time.{Duration}

/// `act` runs as a turn once `span` has gone by. False when no loop runs.
export fn later(span: Duration, act: Act) -> bool {
    let on? = running() else { return false }
    on.ask(Want.After(span.ms()), act)
}

/// `act` runs as a turn every `period`, until the loop ends. False when no
/// loop runs.
export fn repeating(period: Duration, act: Act) -> bool {
    let on? = running() else { return false }
    on.ask(Want.Every(period.ms()), act)
}

/// `held` reads the observation `request` makes: loading now, and `Ready`
/// with what `parse` makes of the reply, or `Failed` with its refusal — the
/// words `parse` gives, or why no reply came. A GET is observed under its key
/// and SHARED: a view asking what is already out joins that request, and the
/// answer reaches every view that reads it. Of two asks by one view the LATEST
/// is the one it shows, whatever order the answers come in. False, and the
/// fetch untouched, when no loop runs. The request is data, so the page's host
/// and a native client send the same value. `parse` must be PURE: it answers the value the view shows
/// and assigns no state, because it runs again for every answer the observation gets, a refresh after
/// a write included. An observation whose server announces its changes on a stream (`avra-feed`) is
/// FRESH while that stream is up and nothing has been announced about what it read: asking it again
/// sends nothing then, and the moment the stream drops, is refused or says otherwise, the next ask sends.
export fn fetched<T>(held: Fetch<T>, request: Request, parse: fn(Reply) -> Result<T, string>) -> bool {
    let on? = running() else { return false }
    let entry = on.observed.entry_of(request)
    let before = held.at.get()
    before?.left(held.id)
    if before == null || before!.id != entry.id { held.last.set(null) }
    held.at.set(entry)
    entry
        .joined(
            Watcher {
                id: held.id,
                apply: (a: Async<Reply>) -> {
                    let seen = settled(a, parse)
                    held.now.set(seen)
                    held.last.set(seen.value() ?? held.last.get())
                },
            },
        )
    on.observed.swept()
    if entry.loading() || entry.fresh.get() { return true }
    asking(on, entry, request)
}

/// `request` goes out for `entry`, carrying the version it holds. The entry keeps the request,
/// so a write that makes it stale can ask it again.
fn asking(on: App, entry: Entry, request: Request) -> bool {
    entry.request.set(request)
    entry.floor.set(on.observed.known.get())
    let sent = entry.conditional(request)
    entry.asked()
    let into: Cell<Result<Reply, string>?> = Cell.new(null)
    on.ask_observed(Want.Get(sent, into), () -> landed(on, entry, into))
}

/// The reply has come: the entry takes it if it is the latest it has seen, and every view that
/// reads the entry shows it. A write's answer names the tables it touched, and the observations
/// those reach are asked again now. Whether the screen follows: the entry changed and a view
/// reads it.
fn landed(on: App, entry: Entry, into: Cell<Result<Reply, string>?>) -> bool {
    let answer? = into.get() else { return false }
    let changed = entry.offered(answer)
    let stood = match answer { .Ok(r) -> r.stand(), .Err(_) -> null }
    on.observed.learned(stood)
    entry.floor.set(max_of(entry.floor.get(), stood ?? 0))
    on.observed.swept()
    refreshed(on, entry, answer)
    watching(on, entry)
    changed && !entry.unread()
}

/// What an answer asks of the observations: a write's names the tables it touched, so each
/// observation a view reads that reaches one is asked again — or, when a request for it is
/// already out, once that one lands.
fn refreshed(on: App, entry: Entry, answer: Result<Reply, string>) {
    if entry.again.get() {
        entry.again.set(false)
        asked_again(on, entry)
    }
    let reply? = match answer { .Ok(r) -> r, .Err(_) -> null } else { return }
    let written? = reply.wrote() else { return }
    let after = reply.stand()
    for e in on.observed.stale_by(written) {
        if e.id == entry.id || reflects(e, after) { continue }
        e.fresh.set(false)
        if e.loading() { e.again.set(true) } else { asked_again(on, e) }
    }
}

/// Whether the request an entry has out was asked after the database stood at `after` — the count a
/// write left it at — so it reflects that write already.
fn reflects(e: Entry, after: int?) -> bool {
    let at? = after else { return false }
    e.loading() && e.floor.get() >= at
}

export fn asked_again(on: App, entry: Entry) {
    let request? = entry.request.get() else { return }
    let _ = asking(on, entry, request)
}

/// What a view shows of the entry's state: its parser's word on a reply.
fn settled<T>(a: Async<Reply>, parse: fn(Reply) -> Result<T, string>) -> Async<T> {
    match a {
        .Idle -> Async.Idle,
        .Loading -> Async.Loading,
        .Failed(why) -> Async.Failed(why),
        .Ready(reply) -> match parse(reply) { .Ok(v) -> Async.Ready(v), .Err(m) -> Async.Failed(m) },
    }
}

fn max_of(a: int, b: int) -> int { if a > b { a } else { b } }
