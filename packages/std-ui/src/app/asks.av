//! `app/asks.av` — the sources a handler asks for by name. Each is a
//! `Want`, data, handed to the app's loop: no task, no host row is named
//! here, so the same call runs on every target.
use app.{Act, Async, Cache, Entry, Fetch, Want, Watcher, running}
use @std.http_message.message.{Reply, Request}
use @std.time.{Duration}

/// `act` runs as a turn once `span` has gone by. False when no loop runs.
export fn later(span: Duration, act: Act) -> bool {
    let on? = running() else { return false }
    on.ask(Want.After(span.ms()), act)
}

/// `act` runs as a turn every `period`, until the loop ends. False when no
/// loop runs.
export fn repeating(period: Duration, act: Act) -> bool {
    let on? = running() else { return false }
    on.ask(Want.Every(period.ms()), act)
}

/// `held` reads the observation `request` makes: loading now, and `Ready`
/// with what `parse` makes of the reply, or `Failed` with its refusal — the
/// words `parse` gives, or why no reply came. A GET is observed under its key
/// and SHARED: a view asking what is already out joins that request, and the
/// answer reaches every view that reads it. Of two asks by one view the LATEST
/// is the one it shows, whatever order the answers come in. False, and the
/// fetch untouched, when no loop runs. The request is data, so the page's host
/// and a native client send the same value.
export fn fetched<T>(held: Fetch<T>, request: Request, parse: fn(Reply) -> Result<T, string>) -> bool {
    let on? = running() else { return false }
    let entry = on.observed.entry_of(request)
    held.at.get()?.left(held.id)
    held.at.set(entry)
    entry
        .joined(Watcher { id: held.id, apply: (a: Async<Reply>) -> held.now.set(settled(a, parse)) })
    on.observed.swept()
    if entry.loading() { return true }
    entry.now.set(Async.Loading)
    entry.told()
    let into: Cell<Result<Reply, string>?> = Cell.new(null)
    on.ask_observed(Want.Get(request, into), () -> landed(on.observed, entry, into))
}

/// The reply has come: it is the entry's answer, shown by every view that
/// reads it. Whether a view did, so the screen follows.
fn landed(cache: Cache, entry: Entry, into: Cell<Result<Reply, string>?>) -> bool {
    let answer? = into.get() else { return false }
    entry.now.set(received(answer))
    entry.told()
    cache.swept()
    !entry.unread()
}

fn received(answer: Result<Reply, string>) -> Async<Reply> {
    match answer { .Ok(reply) -> Async.Ready(reply), .Err(why) -> Async.Failed(why) }
}

/// What a view shows of the entry's state: its parser's word on a reply.
fn settled<T>(a: Async<Reply>, parse: fn(Reply) -> Result<T, string>) -> Async<T> {
    match a {
        .Idle -> Async.Idle,
        .Loading -> Async.Loading,
        .Failed(why) -> Async.Failed(why),
        .Ready(reply) -> match parse(reply) { .Ok(v) -> Async.Ready(v), .Err(m) -> Async.Failed(m) },
    }
}
