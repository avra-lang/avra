//! `app/cache.av` — what a loop has observed: one entry per key, shared by
//! every view that asks it, and kept a while after its last reader leaves.
use @std.http_message.message.{Reply, Request, Version}
use @std.text.{text_before}
use @std.time.{now_ms}
use app.{
    Async,
    Cause,
    Counts,
    Heard,
    Laid,
    Layer,
    Overlay,
    Row,
    Snapshot,
    collection_of,
    counts,
    laid,
}
use @std.json.{Json, parse}

/// How long an entry nobody reads is kept.
const KEPT_MS: int = 300000

/// The bytes all unread entries together may hold.
const CAP_BYTES: int = 16777216

/// What an observation is asked by: the path and its arguments, the query
/// sorted so the order a caller wrote them in is no second observation.
export type Key = { path: string, query: string }

/// The key a request observes under, or none when it is no observation: only
/// a GET without a body reads; any other request writes.
export fn key_of(request: Request) -> Key? {
    if !(request.method is .Get) || !(request.body is .Empty) { return null }
    let parts = request.url.split("?")
    let none: List<string> = []
    let pairs = parts.drop(1).join("?").split("&").fold(none, inserted)
    Key { path: parts.first() ?? "", query: pairs.join("&") }
}

/// `pairs` in byte order with `word` placed.
fn inserted(pairs: List<string>, word: string) -> List<string> {
    if word.is_empty() { return pairs }
    [p for p in pairs if text_before(p, word)]
        .concat([word])
        .concat([p for p in pairs if !text_before(p, word)])
}

/// A view that reads an entry: told each time the entry's state moves.
/// `seen` is the paint that last showed what the view reads (none yet: zero).
export type Watcher = { id: int, apply: fn(Async<Reply>) -> void, seen: Cell<int> }

/// One observation: the answer to a key's request as the reply it came in, the
/// version that answer carries, the tables the server said it read (none: it did not
/// say), where changes to them are announced and the count the answer stood at, whether
/// it is FRESH (its feed is up and no notice has reached it since), the request that asks it
/// again, whether a request is out and whether a write landed meanwhile that asks for
/// another, its readers, and when the last of them left.
export type Entry = {
    id: int,
    key: Key?,
    now: Cell<Async<Reply>>,
    version: Cell<Version?>,
    reads: Cell<List<string>?>,
    feed: Cell<string?>,
    stand: Cell<int?>,
    floor: Cell<int>,
    fresh: Cell<bool>,
    request: Cell<Request?>,
    out: Cell<bool>,
    again: Cell<bool>,
    watchers: Cell<List<Watcher>>,
    parked: Cell<List<Watcher>>,
    read: Cell<int>,
    layers: Cell<List<Layer>>,
    shown_laid: Cell<Laid?>,
    asked_n: Cell<int>,
    aliases: Cell<Map<string, int>>,
    staled: Cell<Cause?>,
    answered: Cell<int>,
    counts: Counts,
}

impl Entry {
    /// Whether the request is out and unanswered.
    fn loading() -> bool { self.out.get() }

    /// The version of the answer the entry holds, when it holds one.
    fn held() -> Version? {
        match self.now.get() {
            .Ready(_) -> self.version.get(),
            .Idle or .Loading or .Failed(_) -> null,
        }
    }

    /// `request`, as it is sent: asking again what a version answered carries
    /// that version, so the server may say nothing has changed.
    fn conditional(request: Request) -> Request {
        let at? = self.held() else { return request }
        request.header("If-None-Match", at.tag())
    }

    /// Whether the entry holds an answer its views show.
    fn shows() -> bool {
        match self.now.get() { .Ready(_) -> true, .Idle or .Loading or .Failed(_) -> false }
    }

    /// A request goes out. An entry that holds an answer keeps showing it while
    /// the question is asked again; any other shows loading.
    fn asked() {
        self.out.set(true)
        if self.shows() { return }
        self.now.set(Async.Loading)
        self.told()
    }

    /// An answer came, and whether the entry changed. A 304 leaves what the
    /// entry holds. An answer whose version is no later than the one held is
    /// never taken, so what arrives late cannot replace what arrived first. A
    /// failed ask is what its views show — each keeps the last good reading it
    /// had beside the failure.
    fn offered(answer: Result<Reply, string>) -> bool {
        self.out.set(false)
        let kept = self.held() != null
        match answer {
            .Err(why) -> self.now.set(Async.Failed(why)),
            .Ok(reply) -> {
                if kept && reply.status == 304 {
                    self.counts.bump(self.counts.not_modified)
                    self.staled.set(null)
                    self.answered.set(now_ms())
                    self.stand.set(reply.stand() ?? self.stand.get())
                    return false
                }
                let at = reply.version()
                let current? = self.held() else { return self.taken(reply, at) }
                if at != null && !at!.after(current) { return false }
                self.taken(reply, at)
                return true
            },
        }
        self.told()
        true
    }

    fn taken(reply: Reply, at: Version?) -> bool {
        self.now.set(Async.Ready(reply))
        self.staled.set(null)
        self.answered.set(now_ms())
        self.version.set(at)
        self.reads.set(reply.reads())
        self.feed.set(reply.feed())
        self.stand.set(reply.stand())
        self.told()
        true
    }

    /// Whether this entry's answer is past a layer: it is not out, and it was asked after the write
    /// answered, or it stood at or past where the database stood after it.
    fn reflects(stand: int?, after: int) -> bool {
        if self.loading() { return false }
        let at? = self.stand.get() else { return self.asked_n.get() > after }
        let want? = stand else { return self.asked_n.get() > after }
        at >= want
    }

    /// The write was replaced before it went out: it is answered no more.
    fn superseded() {
        self.out.set(false)
        self.now.set(Async.Failed("replaced by a later change to the same row"))
        self.told()
    }

    /// No longer fresh, and why.
    fn stale(why: Cause) {
        self.fresh.set(false)
        self.staled.set(why)
    }

    /// Whether no view reads it.
    fn unread() -> bool { self.watchers.get().is_empty() }

    /// The reply's bytes it holds.
    fn size() -> int {
        match self.now.get() {
            .Ready(reply) -> reply.body.length,
            .Idle or .Loading or .Failed(_) -> 0,
        }
    }

    /// `w` reads it from now, in place of any earlier word of the same view,
    /// and is told what it holds.
    fn joined(w: Watcher) {
        self.parked.set([x for x in self.parked.get() if x.id != w.id])
        self.watchers.set([x for x in self.watchers.get() if x.id != w.id].concat([w]))
        (w.apply)(self.shown())
    }

    /// The view `id` reads no more.
    fn left(id: int) {
        self.parked.set([x for x in self.parked.get() if x.id != id])
        self.watchers.set([x for x in self.watchers.get() if x.id != id])
        if self.unread() { self.read.set(now_ms()) }
    }

    /// Every reader a paint showed once and `walk` did not has been removed from the screen: it reads no more.
    fn unseen(walk: int) {
        for w in self.watchers.get() {
            if w.seen.get() > 0 && w.seen.get() < walk {
                self.left(w.id)
                self.parked.push(w)
            }
        }
    }

    /// A view a paint left out reads the entry again: it is told what the entry holds. Whether it was parked.
    fn rejoined(id: int) -> bool {
        let w? = self.parked.get().find(it.id == id) else { return false }
        self.joined(w)
        true
    }

    /// Its state moved: every reader is told.
    fn told() {
        self.shown_laid.set(null)
        for w in self.watchers.get() { (w.apply)(self.shown()) }
    }

    /// What a view reads: the answer with the layers of the writes it was not yet answered for over it.
    fn shown() -> Async<Reply> {
        let l? = self.laid_over() else { return self.now.get() }
        Async.Ready(l.reply)
    }

    /// The answer with the layers laid over it, kept until the entry or a layer moves; none where no
    /// layer reaches it.
    fn laid_over() -> Laid? {
        let held = self.shown_laid.get()
        if held != null { return held }
        let key? = self.key else { return null }
        let reply? = match self.now.get() {
            .Ready(r) -> r,
            .Idle or .Loading or .Failed(_) -> null,
        } else {
            return null
        }
        let made = laid(self.layers.get(), key, reply)
        self.shown_laid.set(made)
        made
    }

    /// The key row `at` of the list a view reads is kept under, when its own key is `id`: a row a write
    /// appended keeps the key of that write, before and after the server names it, so its node stays
    /// where it is mounted. The kind is written first, so a key the server chose can never be a layer's.
    fn key_at(at: int, id: string) -> string {
        let marks = self.laid_over()?.marks ?? []
        let mark = if at < marks.length { marks[at] } else { null }
        let former = self.aliases.get().get(id)
        let layer? = mark ?? former else { return "s:${id}" }
        "p:${layer}"
    }
}

/// A stream a loop listens to for the changes of what its entries read: where it is, what it said
/// (queued until its turn runs), whether it has said where the database stands since it was last
/// opened — until it has, no entry on it is fresh — and whether the server refused it for good.
export type Feed = { path: string, heard: Cell<List<Heard>>, synced: Cell<bool>, closed: Cell<bool> }

/// The writes to one row, one in flight: what waits behind it, newest only.
export type Lane = { url: string, flying: Cell<bool>, queued: Cell<Entry?> }

/// The entries a loop holds, the streams it listens to, the layers of writes not yet reflected, the
/// lanes writes to one row go in, and how many asks have been made.
export type Cache = {
    entries: Cell<List<Entry>>,
    minted: Cell<int>,
    feeds: Cell<List<Feed>>,
    known: Cell<int>,
    layers: Cell<List<Layer>>,
    lanes: Cell<List<Lane>>,
    laid: Cell<int>,
    asks: Cell<int>,
    counts: Counts,
    sink: Cell<fn(Snapshot) -> void>,
    watched: Cell<bool>,
}

/// The sink of a cache nobody watches.
fn unwatched(_s: Snapshot) {}

export fn cache() -> Cache {
    let none: List<Entry> = []
    let silent: List<Feed> = []
    let unlaid: List<Layer> = []
    let alone: List<Lane> = []
    Cache {
        entries: Cell.new(none),
        minted: Cell.new(0),
        feeds: Cell.new(silent),
        known: Cell.new(0),
        layers: Cell.new(unlaid),
        lanes: Cell.new(alone),
        laid: Cell.new(0),
        asks: Cell.new(0),
        counts: counts(),
        sink: Cell.new(unwatched),
        watched: Cell.new(false),
    }
}

impl Cache {
    /// The entry `request` is observed under: the one standing for its key,
    /// shared by every view that asks, or a new one. A request that is no
    /// observation gets an entry nobody else reads.
    fn entry_of(request: Request) -> Entry {
        let key? = key_of(request) else { return self.minted_entry(null) }
        let held = self.entries.get().find((e) -> self.holds(e, key))
        if held != null { return held! }
        let made = self.minted_entry(key)
        self.entries.push(made)
        made
    }

    fn holds(e: Entry, key: Key) -> bool {
        let at? = e.key else { return false }
        at.path == key.path && at.query == key.query
    }

    fn minted_entry(key: Key?) -> Entry {
        self.minted.set(self.minted.get() + 1)
        let idle: Async<Reply> = .Idle
        let nobody: List<Watcher> = []
        let unversioned: Version? = null
        let unsaid: List<string>? = null
        let unasked: Request? = null
        let unfed: string? = null
        let unstood: int? = null
        let unlaid: Laid? = null
        let unsaid_cause: Cause? = null
        let unnamed: Map<string, int> = {}
        Entry {
            id: self.minted.get(),
            key: key,
            now: Cell.new(idle),
            version: Cell.new(unversioned),
            reads: Cell.new(unsaid),
            feed: Cell.new(unfed),
            stand: Cell.new(unstood),
            floor: Cell.new(0),
            fresh: Cell.new(false),
            request: Cell.new(unasked),
            out: Cell.new(false),
            again: Cell.new(false),
            watchers: Cell.new(nobody),
            parked: Cell.new(nobody),
            read: Cell.new(now_ms()),
            layers: self.layers,
            shown_laid: Cell.new(unlaid),
            asked_n: Cell.new(0),
            aliases: Cell.new(unnamed),
            staled: Cell.new(unsaid_cause),
            answered: Cell.new(0),
            counts: self.counts,
        }
    }

    /// What is not worth keeping goes: an answered entry nobody has read for
    /// `KEPT_MS`, and then, least recently read first, unread entries past the
    /// cap.
    fn swept() {
        let now = now_ms()
        let held = [e for e in self.entries.get() if !(e.unread() && !e.loading() && now - e.read.get() >= KEPT_MS)]
        self.entries.set(self.under_cap(held))
    }

    fn under_cap(held: List<Entry>) -> List<Entry> {
        let unread = [e for e in held if e.unread() && !e.loading()]
        if unread.fold(0, (n: int, e: Entry) -> n + e.size()) <= CAP_BYTES { return held }
        let nobody: Entry? = null
        let oldest? = unread
            .fold(
                nobody,
                (best: Entry?, e: Entry) -> if best == null || e.read.get() < best!.read.get() { e } else { best },
            ) else {
            return held
        }
        self.under_cap([e for e in held if e.id != oldest.id])
    }

    /// Whether a write that touched `written` reaches this entry: it read one of them, or the
    /// server never said what it read.
    fn reached(e: Entry, written: List<string>) -> bool {
        let read? = e.reads.get() else { return true }
        written.any((w: string) -> read.contains(w))
    }

    /// The observations a write that touched `written` leaves stale: those a view reads that the
    /// write reaches. (An entry no view reads keeps its version; its next ask sends it and the
    /// server answers by what it read.)
    /// Every view the paint `walk` did not show, having shown before, lets go of what it read.
    fn released(walk: int) {
        for e in self.entries.get() { e.unseen(walk) }
    }

    fn stale_by(written: List<string>) -> List<Entry> {
        [e for e in self.entries.get() if !e.unread() && self.reached(e, written)]
    }

    /// Every entry is let go: a loop that ends takes the requests it kept.
    fn reset() {
        let none: List<Entry> = []
        let silent: List<Feed> = []
        self.entries.set(none)
        let unlaid: List<Layer> = []
        let alone: List<Lane> = []
        self.feeds.set(silent)
        self.known.set(0)
        self.layers.set(unlaid)
        self.lanes.set(alone)
    }

    /// The lane writes to `url`'s row go in, or none for a create, which no write waits behind.
    fn lane_of(request: Request) -> Lane? {
        if request.method is .Post { return null }
        let url = request.url.split("?").first() ?? ""
        let held = self.lanes.get().find(it.url == url)
        if held != null { return held }
        let nobody: Entry? = null
        let made = Lane { url: url, flying: Cell.new(false), queued: Cell.new(nobody) }
        self.lanes.push(made)
        made
    }

    /// The write `request` makes is laid over every entry it reaches until the server's reading catches up with it.
    fn lay(request: Request, overlay: Overlay, owner: int) -> Layer {
        self.laid.set(self.laid.get() + 1)
        let unstood: int? = null
        let unanswered: Json? = null
        let body = match request.body {
            .Json(text) -> match parse(text) { .Ok(j) -> j, .Err(_) -> null },
            .Empty or .Text(_) or .Form(_) or .Octets(_, _) -> null,
        }
        let made = Layer {
            id: self.laid.get(),
            path: collection_of(request.url, overlay),
            overlay: overlay,
            body: body,
            owner: Cell.new(owner),
            stand: Cell.new(unstood),
            answered: Cell.new(unanswered),
            after: Cell.new(unstood),
        }
        self.layers.push(made)
        self.counts.bump(self.counts.laid)
        self.felt(made)
        made
    }

    /// The entries a layer reaches that a view reads.
    fn reaching(l: Layer) -> List<Entry> {
        [e for e in self.entries.get() if !e.unread() && e.key != null && l.reaches(e.key!)]
    }

    /// The views of everything `l` reaches are shown it, or shown it gone.
    fn felt(l: Layer) { for e in self.reaching(l) { e.told() } }

    /// The layers the write of entry `id` stands behind.
    fn owned(id: int) -> List<Layer> { [l for l in self.layers.get() if l.owner.get() == id] }

    /// A write that waited was replaced by a later one: its layers settle with the later answer.
    fn handed(from: int, to: int) { for l in self.owned(from) { l.owner.set(to) } }

    /// The write's answer came: where the database stood after it, and the row the server made.
    fn answered(mine: List<Layer>, reply: Reply) {
        let row = match parse(reply.body.text() ?? "") { .Ok(j) -> j, .Err(_) -> null }
        for l in mine {
            l.stand.set(reply.stand())
            l.answered.set(if l.overlay is .Append(_) { row } else { null })
            l.after.set(self.asks.get())
            self.felt(l)
        }
    }

    /// A layer is gone: a row it appended stays under the key it was shown with, however the server
    /// names it, and every view it reached is shown the server's reading alone.
    fn dropped(l: Layer) {
        let reached = self.reaching(l)
        let kept_as = l.named_by()
        if kept_as != null { for e in reached { e.aliases.put(kept_as!, l.id) } }
        self.layers.set([x for x in self.layers.get() if x.id != l.id])
        self.counts.bump(self.counts.dropped)
        for e in reached { e.told() }
    }

    /// Every layer the server's reading has caught up with is dropped: each view it reaches has been
    /// answered since, at or past where the database stood after the write.
    fn settled() {
        for l in self.layers.get() {
            let after? = l.after.get() else { continue }
            if self.reaching(l).all(it.reflects(l.stand.get(), after)) { self.dropped(l) }
        }
    }

    /// The database has been seen at `count`: an answer read at it, a write's answer, an announcement. A
    /// request asked from now on reflects at least that.
    fn learned(count: int?) {
        let at? = count else { return }
        if at > self.known.get() { self.known.set(at) }
    }

    /// The stream listened to at `path`, if one is.
    fn feed_named(path: string) -> Feed? { self.feeds.get().find(it.path == path) }

    /// The entries whose answers say they are announced on `path`.
    fn on_feed(path: string) -> List<Entry> { [e for e in self.entries.get() if e.feed.get() == path] }
}

impl Cache {
    /// Every entry, stream and write in flight as it stands now. Built on demand.
    fn snapshot() -> Snapshot {
        self.counts.bump(self.counts.built)
        let now = now_ms()
        Snapshot {
            rows: [self.row_of(e, now) for e in self.entries.get() if e.key != null],
            streams: [f.line() for f in self.feeds.get()],
            writes: [w.line() for w in self.lanes.get() if w.flying.get()],
            counts: self.counts.line(self.asks.get()),
        }
    }

    fn row_of(e: Entry, now: int) -> Row {
        let key = e.key!
        Row {
            key: if key.query.is_empty() { key.path } else { "${key.path}?${key.query}" },
            state: match e.now.get() {
                .Idle -> "idle",
                .Loading -> "loading",
                .Failed(why) -> "failed: ${why}",
                .Ready(_) -> "ready",
            },
            fresh: e.fresh.get(),
            stale_by: e.staled.get()?.words() ?? "",
            age_ms: if e.answered.get() == 0 { 0 } else { now - e.answered.get() },
            bytes: e.size(),
            readers: e.watchers.get().length,
            parked: e.parked.get().length,
            layers: [l.id for l in self.layers.get() if l.reaches(key)],
            feed: e.feed.get() ?? "",
        }
    }

    /// The sink is told the snapshot from now on; none: nothing is built.
    fn watching(sink: fn(Snapshot) -> void) {
        self.sink.set(sink)
        self.watched.set(true)
    }

    /// The cache moved: a watcher is told, and a cache nobody watches builds nothing.
    fn moved() {
        if !self.watched.get() { return }
        (self.sink.get())(self.snapshot())
    }
}

impl Feed {
    fn line() -> string {
        let state = when {
            self.closed.get() -> "refused"
            self.synced.get() -> "synced"
            _ -> "waiting for its first notice"
        }
        "stream ${self.path}  ${state}"
    }
}

impl Lane {
    fn line() -> string { "write ${self.url}  in flight${if self.queued.get() == null { "" } else { ", one waiting" }}" }
}
