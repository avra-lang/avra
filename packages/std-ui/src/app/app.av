//! `app/app.av` — an app as a target runs it: the view of the program's
//! state, the theme it wears and where a paint is shown. THE LOOP IS ONE
//! DOOR, `turn`: whatever may change the state — a control speaking, a
//! timer, an answer arriving — runs through it, and a paint follows only
//! when it ran.
use tree.node.{Node}
use tree.standing.{Standing, standing}
use tree.view.{View, rooted}
use style.theme.{Theme, default_theme}
use @std.task.{Channel, unbounded_channel}

/// Whatever may change the program's state, as the door takes it: it
/// answers whether it ran.
export alias Act = fn() -> bool

/// Work that waits and then leaves an `Act` behind. It runs as a task the
/// loop owns, so it ends with the loop.
export alias Job = fn() -> bool

/// What a source leaves in the inbox: a turn to run, or a job to start.
export enum Msg {
    Turn(act: Act)
    Start(job: Job)
}

/// An app on one target. `show` is the target's own paint: the tree as it
/// stands and the theme it wears, in; whatever the target does with them.
/// The view and the theme are held in cells, so the app stays ONE identity
/// when it is given another view to show. `stands` is where its walk
/// starts: every component instance on the app is kept under it, and
/// nowhere else. `told` is what its walk has said that a target already
/// passed on. `inbox` is where every source that is not a control —
/// a timer, an answer, a stream — leaves its `Act`; its writers never
/// wait.
export type App = {
    view: Cell<fn(Standing) -> Node>,
    theme: Cell<fn() -> Theme>,
    show: fn(Node, Theme) -> void,
    stands: Standing,
    told: Cell<List<string>>,
    inbox: Channel<Msg>,
}

/// The theme of an app that names none.
export fn plain() -> Theme { default_theme }

/// `view` under `theme`, shown by `show`.
export fn app<V: View>(view: fn() -> V, theme: fn() -> Theme, show: fn(Node, Theme) -> void) -> App {
    let drawn: fn(Standing) -> Node = (at: Standing) -> rooted(view().describe(at))
    let untold: List<string> = []
    App {
        view: Cell.new(drawn),
        theme: Cell.new(theme),
        show: show,
        stands: standing(),
        told: Cell.new(untold),
        inbox: unbounded_channel<Msg>(),
    }
}

/// `on` shows `view` under `theme` from now on: the same app on the same
/// target, so a paint already under way paints this view, never the one
/// it replaced. What stood stays on offer: an instance the new view
/// reaches where the old one had it keeps its state.
export fn remounted<V: View>(on: App, view: fn() -> V, theme: fn() -> Theme) {
    on.view.set((at: Standing) -> rooted(view().describe(at)))
    on.theme.set(theme)
}

impl App {
    /// The view as the state stands now, shown. The walk opens the
    /// app's standing, so an instance this paint does not reach is gone
    /// with it.
    fn paint() {
        let view = self.view.get()
        let theme = self.theme.get()
        self.stands.begun()
        self.show(view(self.stands), theme())
    }

    /// What the last paint's walk said of the tree it was handed — an
    /// instance that keeps state and is told from its siblings by order
    /// alone.
    fn warnings() -> List<string> { self.stands.warnings() }

    /// What the last paint said that no paint before it did — each
    /// warning once an app.
    fn said_anew() -> List<string> {
        let fresh = [w for w in self.warnings() if !self.told.get().contains(w)]
        self.told.set(self.told.get().concat(fresh))
        fresh
    }

    /// A target with an error stream passes on what its walk said: a
    /// terminal's, a page's console.
    fn warn() {
        for w in self.said_anew() { eprintln("ui: ${w}") }
    }

    /// How many component instances the app keeps — the lifetime
    /// witness.
    fn held() -> int { self.stands.held() }

    /// THE ONE DOOR INTO THE LOOP. `act` is whatever may change the
    /// program's state; it answers whether it ran, and a paint follows
    /// only then. What the paint says is the target's to decide — a page
    /// that did not change is sent nothing.
    fn turn(act: fn() -> bool) -> bool {
        let ran = act()
        if ran { self.paint() }
        ran
    }

    /// A source leaves `act` for the loop to run as a turn. False when
    /// the loop has ended.
    fn post(act: Act) -> bool { self.send(Msg.Turn(act)) }

    /// A source leaves `job` for the loop to start as a task it owns.
    /// False when the loop has ended.
    fn start(job: Job) -> bool { self.send(Msg.Start(job)) }

    fn send(msg: Msg) -> bool {
        match self.inbox.sink.post(msg) { .Taken or .Full -> true, .Ended -> false }
    }

    /// The loop ends once what stands in the inbox has run.
    fn close() { self.inbox.sink.close() }
}

/// The app whose loop is running: where a handler's `later` and
/// `repeating` leave their jobs.
once fn afoot() -> Cell<App?> { Cell.new(null) }

/// `on` is the app whose loop runs from now, or none. A loop's owner says
/// so before the loop starts and puts back what it replaced when the
/// loop ends, so loops nest without crossing.
export fn stood(on: App?) { afoot().set(on) }

/// The app whose loop runs, if any.
export fn running() -> App? { afoot().get() }
