//! The loop, by its law: one door, and a paint only after what came
//! through it ran.
use @std.ui.app.{App, app, plain}
use @std.ui.components.{text}
use @std.ui.tree.node.{Node}
use @std.ui.style.theme.{Theme, dark_theme}

/// What a target was shown, paint by paint: each tree's words under the
/// mode it wore.
type Shown = { paints: Cell<List<string>> = Cell.new([]) }

/// An app whose view says `words` as they stand, shown to `on`.
fn saying(words: Cell<string>, on: Shown, theme: fn() -> Theme) -> App {
    app(
        () -> text words.get(),
        theme,
        (root: Node, worn: Theme) -> on.paints.push("${root.words()} ${worn.mode.word()}"),
    )
}

spec "the loop is one door" {
    given "something that ran" {
        then "a paint of the state as it now stands follows" {
            let words: Cell<string> = Cell.new("before")
            let on = Shown {}
            let ran = saying(words, on, plain)
                .turn(
                    () -> {
                        words.set("after")
                        true
                    },
                )
            ran && on.paints.get().join(",") == "after light"
        }
    }
    given "something that did not run" {
        then "nothing is painted" {
            let words: Cell<string> = Cell.new("before")
            let on = Shown {}
            let ran = saying(words, on, plain).turn(() -> false)
            !ran && on.paints.get().is_empty()
        }
    }
    given "a theme that follows the state" {
        then "each paint wears the theme as it stands then" {
            let words: Cell<string> = Cell.new("w")
            let night: Cell<bool> = Cell.new(false)
            let on = Shown {}
            let made = saying(words, on, () -> if night.get() { dark_theme } else { plain() })
            made.paint()
            night.set(true)
            made.paint()
            on.paints.get().join(",") == "w light,w dark"
        }
    }
}

spec "a source reaches an app that has no loop" {
    given "an app with no loop" {
        then "an act runs as a turn at once, and a job has nowhere to run" {
            let words: Cell<string> = Cell.new("before")
            let on = saying(words, Shown {}, plain)
            on
                    .post(
                        () -> {
                            words.set("after")
                            true
                        },
                    ) &&
                words.get() == "after" &&
                !on.start(() -> true)
        }
    }
}

/// A door that fails every action it is handed, as a containing runtime
/// would after restoring the state.
fn failing(_act: fn() -> bool) -> Result<bool, string> { .Err("boom") }

/// A door that runs the action as the app's own does.
fn running(act: fn() -> bool) -> Result<bool, string> { .Ok(act()) }

spec "a failure is contained to its turn" {
    given "a turn that failed" {
        then "its words are kept and the paint wears the notice" {
            let words: Cell<string> = Cell.new("before")
            let on = Shown {}
            let made = saying(words, on, plain)
            made.guarded(failing)
            let ran = made.turn(() -> true)
            !ran && made.failed.get() == "boom" && on.paints.get().length == 1
        }
        then "the next turn that runs clears them" {
            let words: Cell<string> = Cell.new("before")
            let on = Shown {}
            let made = saying(words, on, plain)
            made.guarded(failing)
            let _ = made.turn(() -> true)
            made.guarded(running)
            let ran = made.turn(() -> true)
            ran && made.failed.get() == null
        }
    }
}
