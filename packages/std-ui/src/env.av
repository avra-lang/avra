//! `env.av` — the context a tree is drawn in: the theme, the writing
//! direction and the locale. A target reads it; nothing threads it
//! through a component's fields. The library ships defaults, so a read
//! always resolves.
use style.theme.{Theme, default_theme}

/// The writing direction; layout edges are logical and mirror with it.
export enum Direction { Ltr, Rtl }

/// Everything inherited down the tree.
export type Env = {
    theme: Theme = default_theme,
    direction: Direction = .Ltr,
    locale: string = "en",
}
