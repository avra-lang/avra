//! `env.av` — the context a subtree shares, read by every component and
//! realizer: the theme, density, direction, locale and size class. It
//! flows down; nothing threads it through props. The library ships
//! defaults, so a read always resolves. UI.md §3.5, WEB_UI §5.3, charter
//! §6.2.
use style.theme.{Theme, default_theme}

/// How tightly a surface packs.
export enum Density { Compact, Comfortable, Spacious }

/// The writing direction; layout edges are logical and mirror with it.
export enum Direction { Ltr, Rtl }

/// The window's size class, the input to responsive layout.
export enum SizeClass { Compact, Medium, Expanded }

/// Everything inherited down the tree.
export type Env = {
    theme: Theme = default_theme,
    density: Density = .Comfortable,
    direction: Direction = .Ltr,
    locale: string = "en",
    size_class: SizeClass = .Medium,
}
