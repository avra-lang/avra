//! `env.av` — the context a tree is drawn in: the writing direction and the locale. A target reads
//! it; nothing threads it through a component's fields. The library ships defaults, so a read always
//! resolves. The theme is no part of it: a tree carries the theme it was drawn in (`ctx theme`).

/// The writing direction; layout edges are logical and mirror with it.
export enum Direction { Ltr, Rtl }

impl Direction {
    /// The word a direction is spelled with, as `dir` and a native fact both say it.
    fn word() -> string {
        match self { .Ltr -> "ltr", .Rtl -> "rtl" }
    }
}

/// The direction a subtree is laid out in: a node is laid out under the one in force where it is
/// placed, as it is drawn in the theme in force there.
export ctx writing: Direction = Direction.Ltr

/// Everything inherited down the tree.
export type Env = {
    direction: Direction = .Ltr,
    locale: string = "en",
}
