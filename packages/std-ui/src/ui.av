//! `@std/ui` — the semantic vocabulary. A view answers a `Node` tree:
//! interaction contracts (a button, a toggle, a heading), never
//! widgets. A REALIZER draws the tree for its target — HTML, the
//! terminal, UIKit, an in-memory tree for tests — and every realizer
//! is one exhaustive match over `Role` and `Setting`.
//!
//!     use @std.ui.{column, text, button}
//!
//!     column {
//!         gap: .M
//!         text "Tasks"
//!         button "Add"
//!     }
//!
//! The head of a component says WHAT it is (its content, its value,
//! its label); the body says HOW (its look, its children). Docs:
//! docs/2026_09_29_UI.md §4, §15.

/// The interaction contract a node carries. A registry: every realizer
/// spells every arm.
export enum Role {
    Text(content: string)
    Heading(content: string, level: int)
    Image(src: string, alt: string)
    Link(label: string, to: string)
    Button(label: string)
    Toggle(label: string, on: bool)
    Field(label: string, value: string)
    Column
    Row
    Section(title: string)
    List
    Item
}

/// A style ROLE, never a CSS value: the theme decides what `.M` or
/// `.Muted` means on each target.
export enum Setting {
    Gap(Size)
    Pad(Size)
    Radius(Size)
    Fill(Tone)
    Color(Tone)
    Face(Font)
}

@derive(Words)
export enum Size {
    @word(none) None
    @word(xs) Xs
    @word(s) S
    @word(m) M
    @word(l) L
    @word(xl) Xl
}

@derive(Words)
export enum Tone {
    @word(text) Text
    @word(muted) Muted
    @word(danger) Danger
    @word(surface) Surface
    @word(surface_raised) SurfaceRaised
    @word(surface_sunk) SurfaceSunk
    @word(surface_hover) SurfaceHover
}

@derive(Words)
export enum Font {
    @word(body) Body
    @word(heading) Heading
    @word(footnote) Footnote
    @word(mono) Mono
}

/// One element of the semantic tree. `key` is a list item's identity
/// (reconciliation and state follow it), null elsewhere.
export type Node = {
    role: Role,
    look: List<Setting> = [],
    children: List<Node> = [],
    key: string? = null,
}

/// What every component answers. A realizer walks the answer.
export trait View {
    fn node() -> Node
}

/// How a value shows itself wherever it is listed: a `list` of `T`
/// renders each `T` through its `Shows`.
export trait Shows {
    fn view() -> dyn View
}

// ── Components. A head says what a node is; the body its look and
// children. A setting with no default is REQUIRED: the value cannot be
// built without it.

export component text(content: string) {
    tone: Tone = .Text
    font: Font = .Body
}

impl View for text {
    fn node() -> Node {
        Node { role: .Text(self.content), look: [Setting.Color(self.tone), .Face(self.font)] }
    }
}

export component heading(content: string) {
    rank: int = 1
    tone: Tone = .Text
}

impl View for heading {
    fn node() -> Node {
        Node {
            role: .Heading(self.content, self.rank),
            look: [Setting.Color(self.tone), .Face(Font.Heading)],
        }
    }
}

export component image(src: string) {
    alt: string
}

impl View for image {
    fn node() -> Node { Node { role: .Image(self.src, self.alt) } }
}

export component link(label: string) {
    to: string
}

impl View for link {
    fn node() -> Node { Node { role: .Link(self.label, self.to) } }
}

export component button(label: string) {}

impl View for button {
    fn node() -> Node { Node { role: .Button(self.label) } }
}

export component toggle(label: string) {
    on: bool = false
}

impl View for toggle {
    fn node() -> Node { Node { role: .Toggle(self.label, self.on) } }
}

export component field(label: string) {
    value: string = ""
}

impl View for field {
    fn node() -> Node { Node { role: .Field(self.label, self.value) } }
}

export component column {
    gap: Size = .None
    pad: Size = .None
    fill: Tone? = null
    radius: Size = .None
    items: List<dyn View> = []
}

impl View for column {
    fn node() -> Node {
        framed(.Column, self.gap, self.pad, self.fill, self.radius, self.items)
    }
}

export component row {
    gap: Size = .None
    pad: Size = .None
    fill: Tone? = null
    radius: Size = .None
    items: List<dyn View> = []
}

impl View for row {
    fn node() -> Node {
        framed(.Row, self.gap, self.pad, self.fill, self.radius, self.items)
    }
}

export component section(title: string) {
    gap: Size = .None
    pad: Size = .None
    fill: Tone? = .SurfaceRaised
    radius: Size = .None
    items: List<dyn View> = []
}

impl View for section {
    fn node() -> Node {
        framed(.Section(self.title), self.gap, self.pad, self.fill, self.radius, self.items)
    }
}

export component list {
    items: List<dyn View> = []
}

impl View for list {
    fn node() -> Node { Node { role: .List, children: nodes(self.items) } }
}

export component item {
    key: string
    items: List<dyn View> = []
}

impl View for item {
    fn node() -> Node { Node { role: .Item, children: nodes(self.items), key: self.key } }
}

/// A container's node: its look is the settings it was given, the fill
/// only when it has one.
fn framed(role: Role, gap: Size, pad: Size, fill: Tone?, radius: Size, items: List<dyn View>) -> Node {
    let sized: List<Setting> = [Setting.Gap(gap), .Pad(pad), .Radius(radius)]
    let look = match fill {
        t? -> sized.concat([Setting.Fill(t)])
        null -> sized
    }
    Node { role: role, look: look, children: nodes(items) }
}

/// Values listed as views, each through its `Shows`: a child of a
/// container spreads like a comprehension does.
export fn rows(shown: List<dyn Shows>) -> List<dyn View> { [s.view() for s in shown] }

/// The children of a container, as nodes.
export fn nodes(views: List<dyn View>) -> List<Node> { [v.node() for v in views] }

/// The text a node would read as, for tests and the terminal: content
/// and labels, joined by its structure.
export fn spoken(n: Node) -> string {
    let own = match n.role {
        .Text(c) or .Heading(c, _) -> c,
        .Image(_, alt) -> alt,
        .Link(l, _) -> l,
        .Button(l) -> "[${l}]",
        .Toggle(l, on) -> if on { "[x] ${l}" } else { "[ ] ${l}" },
        .Field(l, v) -> "${l}: ${v}",
        .Section(t) -> t,
        .Column or .Row or .List or .Item -> "",
    }
    [s for s in [own].concat([spoken(c) for c in n.children]) if s != ""].join(" ")
}
