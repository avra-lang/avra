// proves: `list <source> by it.<field> { x -> … }` states a list's key
// once, and renders the SAME frame the explicit `key:` spelling does —
// identity is what moved, never a pixel. The list's key is the element
// accessor, so a reorder or insert keeps every node instead of
// re-emitting the rows below it.
use @std.ui.components.{item, list, text}
use @std.ui.realize.dom.frame.{frame_text}
use @std.ui.realize.view.{View}

type Row = { id: string, label: string }

state rows: List<Row> = [Row { id: "a", label: "alpha" }, Row { id: "b", label: "beta" }]

fn row_item(r: Row) -> item {
    item {
        key: r.id
        items: [text r.label]
    }
}

fn explicit() -> list { list { items: [row_item(r) for r in rows] } }

fn keyed() -> list {
    list rows by it.id { r ->
        item { items: [text r.label] }
    }
}

fn listed() -> List<Row> { rows }

fn keyed_called() -> list {
    list listed() by it.id { r ->
        item { items: [text r.label] }
    }
}

println(frame_text(explicit().describe()))
println(frame_text(keyed().describe()))
println("identity=${frame_text(explicit().describe()) == frame_text(keyed().describe())}")
println("called=${frame_text(keyed_called().describe()) == frame_text(explicit().describe())}")
