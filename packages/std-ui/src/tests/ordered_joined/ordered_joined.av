// proves: work a control asked while it stood alone in an unkeyed list is dropped when a
// row is inserted before it — its place now names the new row, which the work must never
// answer for — and the app says why. eval == native.
use @std.ui.components.{button, item}
use @std.ui.headless.{headless}
use @std.ui.native.sources.{later}
use @std.time.{ms}

state log: List<string> = []
state rows: List<string> = ["a"]

fn note(what: string) -> bool {
    log = log.concat([what])
    true
}

fn asks(who: string) {
    let filed = later(ms(5), () -> note("fired into ${who}"))
    log = log.concat(["${who} filed ${filed}"])
}

fn prepended() -> bool {
    rows = ["z"].concat(rows)
    true
}

fn view() -> item { item { items: [button r { on press { asks(r) } } for r in rows] } }

let screen = headless(view)
screen
    .running(
        () -> {
            let _ = screen.press("a")
            let _ = screen.turn(prepended)
            screen.advance(ms(10))
            println("[${log.join(",")}]")
            println(screen.shown.app.warnings().join(" | "))
        },
    )
