start: text "shut" | text "shut" | text "shut" held=3
open beta, star beta and gamma: text "shut" | text "open starred" | text "shut starred" held=3
reorder: text "shut starred" | text "shut" | text "open starred" held=3
hide beta: text "shut starred" | text "shut" held=2
show beta: text "shut starred" | text "shut" | text "shut starred" held=3
remove gamma: text "shut" | text "shut starred" held=2
a new gamma: text "shut" | text "shut starred" | text "shut" held=3
