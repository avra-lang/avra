// Attacks on the vocabulary: degenerate sizes, computed (managed)
// strings, depth, and views shared or repeated.
use @std.ui.{
    View,
    Shows,
    Node,
    Role,
    column,
    row,
    list,
    item,
    text,
    button,
    toggle,
    section,
    rows,
    spoken,
}

type Label = { word: string }

impl Shows for Label {
    fn view() -> dyn View { text "${self.word}!" }
}

fn words(n: int) -> List<dyn Shows> { [Label { word: "w${i}" } for i in 0..n] }

/// A column nested `depth` deep around one text.
fn nested(depth: int) -> Node {
    if depth == 0 {
        let t = text "core"
        t.node()
    } else {
        let inner = nested(depth - 1)
        Node { role: .Column, children: [inner] }
    }
}

fn depth_of(n: Node) -> int {
    match n.children.first() {
        c? -> 1 + depth_of(c)
        null -> 0
    }
}

fn many(n: int) -> Node {
    let c = column {
        [text "t${i}" for i in 0..n]
    }
    c.node()
}

fn keyed_pair() -> List<Node> {
    let a = item {
        key: "x${1 + 1}"
    }
    let b = item {
        key: "x2"
    }
    [a.node(), b.node()]
}

fn same_view_twice() -> Node {
    let b = button "again"
    let c = row {
        b
        b
    }
    c.node()
}

spec "std/ui adversarial" {
    given "degenerate shapes" {
        then "a container with no children has none, at every container" {
            let s = section "S" {}
            let r = row {}
            let l = list {}
            s.node().children.length + r.node().children.length + l.node().children.length == 0
        }
        then "a one-element rows is one child" {
            list { rows(words(1)) }.node().children.length == 1
        }
        then "a large list keeps every child in order" {
            many(2000).children.length == 2000 && spoken(many(3)) == "t0 t1 t2"
        }
    }
    given "computed strings" {
        then "a label built at run time survives the node that holds it" {
            spoken(list { rows(words(3)) }.node()) == "w0! w1! w2!"
        }
        then "computed keys that agree are equal keys" {
            let ks = keyed_pair()
            ks[0].key == ks[1].key
        }
    }
    given "depth and sharing" {
        then "a tree nested 200 deep keeps its depth" {
            depth_of(nested(200)) == 200
        }
        then "one view written twice answers two equal nodes" {
            let n = same_view_twice()
            spoken(n) == "[again] [again]" && n.children.length == 2
        }
    }
}
