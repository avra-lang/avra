// proves: an app runs one loop at a time. A screen run inside its own
// running body would orphan the outer loop's sources, so it is refused.
use @std.ui.components.{text}
use @std.ui.headless.{headless}
use @std.time.{ms}

let screen = headless(() -> text "x")
screen.running(() -> screen.running(() -> screen.advance(ms(1))))
