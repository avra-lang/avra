// proves: a `text` whose words hold a hole carries a closure that says the
// same words again from the state as it stands, and the cells that closure
// reads — one per state, none for a text that reads no state — and one with
// no hole carries the default that says nothing.
use @std.ui.components.{text}

state n: int = 7
state m: int = 1

fn double() -> int { n * 2 }

fn once_more() -> string {
    let t = text "a ${n} b"
    (t.words)()
}

fn plain() -> string {
    let t = text "no holes"
    (t.words)()
}

fn cells_of_n() -> int {
    let t = text "a ${n} b"
    t.reads.length
}

fn cells_of_both() -> int {
    let t = text "${n} ${m}"
    t.reads.length
}

fn cells_of_constant() -> int {
    let t = text "two is ${1 + 1}"
    t.reads.length
}

fn cells_through_a_call() -> int {
    let t = text "twice ${double()}"
    t.reads.length
}

fn cells_of_a_local() -> int {
    state k: int = 3
    let t = text "k is ${k}"
    t.reads.length
}

let before = once_more()
n = 8
println("${before}|${once_more()}|${plain().length}")
println(
    "${cells_of_n()} ${cells_of_both()} ${cells_of_constant()} ${cells_through_a_call()} ${cells_of_a_local()}",
)
