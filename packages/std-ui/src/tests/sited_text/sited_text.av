// proves: a `text` whose words hold a hole carries a closure that says the
// same words again from the state as it stands, and one with no hole carries
// the default that says nothing.
use @std.ui.components.{text}

state n: int = 7

fn once_more() -> string {
    let t = text "a ${n} b"
    t.words()
}

fn plain() -> string {
    let t = text "no holes"
    t.words()
}

let before = once_more()
n = 8
println("${before}|${once_more()}|${plain().length}")
