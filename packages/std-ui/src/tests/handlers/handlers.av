// proves: `on <kind> { … }` in a std control's block is its handler — a
// closure over what the view could see, `on input { said -> … }` taking
// what the control says — and the control projects ONE
// Action with the kind the word names. A handler left unset binds no
// action at all, so a handlerless control is inert.
use @std.ui.components.{button, checkbox, field, row}
use @std.ui.realize.view.{View}
use @std.ui.realize.render.{Node, Action, EventKind, Handler}

state count: int = 0
state draft: string = ""
state done: bool = false

fn first(view: dyn View) -> Action? { view.describe().events.first() }

fn kind(view: dyn View) -> string {
    let a? = first(view) else { return "none" }
    match a.kind { .Click -> "click", .Input -> "input", .Change -> "change", .Submit -> "submit" }
}

/// The view's first handler, run as a target would run it.
fn fired(view: dyn View, said: string) -> bool {
    let a? = first(view) else { return false }
    match a.handler { .Run(f) -> f(), .Text(f) -> f(said) }
    true
}

fn count_of(view: dyn View) -> int { view.describe().events.length }

fn total(n: Node) -> int {
    mut t = n.events.length
    for c in n.children { t = t + total(c) }
    t
}

fn step(by: int) -> button { button "x" { on click { count = count + by } } }

let add = button "x" { on click { count = count + 1 } }
let inert = button "x"
let empty_field = field "n"
let drafted = field "n" { on input { said -> draft = said } }
let changed = checkbox "c" { on change { done = !done } }
let mixed = row {
    button "x" { on click { count = 0 } }
    field "n" { on input { said -> draft = said } }
}

println("add_kind=${kind(add)}")
println("add=${fired(add, "")} ${fired(add, "")} count=${count}")
println("absent=${count_of(inert)} fired=${fired(inert, "")}")
println("absent_field=${count_of(empty_field)}")
println("input_kind=${kind(drafted)}")
println("input=${fired(drafted, "hi")} draft=${draft}")
println("change_kind=${kind(changed)}")
println("change=${fired(changed, "")} done=${done}")
println("mixed=${total(mixed.describe())}")
// a handler closes over a local: each instance carries its own.
println("captured=${fired(step(10), "")} ${fired(step(5), "")} count=${count}")
