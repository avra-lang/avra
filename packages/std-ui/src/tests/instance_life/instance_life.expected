nested: text "f taps: 0" | text "f inner: 0" | text "t taps: 0" | text "t inner: 0" held=5
pressed: text "f taps: 1" | text "f inner: 1" | text "t taps: 0" | text "t inner: 2" held=5
a second screen: text "f taps: 0" | text "f inner: 0" | text "t taps: 0" | text "t inner: 0" held=5
the first, after the second was pressed: text "f taps: 1" | text "f inner: 1" | text "t taps: 0" | text "t inner: 2" held=5
after 40 mounts and unmounts: text "f taps: 0" | text "f inner: 0" | text "t taps: 0" | text "t inner: 0" held=5
unmounted:  held=0
a counter: text "x: 1" held=1
a tally where the counter stood: text "x taps: 0" | text "x inner: 0" held=2
a counter again: text "x: 0" held=1
a write in the walk: text "e walked 1" held=1
and the next paint: text "e walked 2" held=1
