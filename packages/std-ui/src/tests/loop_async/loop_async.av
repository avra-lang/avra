// proves: a task's answer and a stream's items reach the loop as turns.
// A fetch shows Loading, then Ready or Failed; a channel the test owns
// feeds the view item by item; nothing runs on a wall clock.
// The real loop (`looped`), not the driven one: a channel the test owns feeds the view from its own task.
use @std.ui.components.{text}
use @std.ui.headless.{headless}
use @std.ui.app.{Async, Fetch, fetch, fetched}
use @std.ui.native.sources.{watching}
use @std.http_message.message.{Reply, Request}
use @std.text.{parse_int}
use @std.task.{unbounded_channel}
use @std.time.{ms, sleep}

fn shown(a: Async<int>) -> string {
    match a {
        .Idle -> "idle",
        .Loading -> "loading",
        .Failed(m) -> "failed ${m}",
        .Ready(v) -> "ready ${v}",
    }
}

/// A network that answers "<wait>/<body>" after the wait: a body of `offline`
/// is no answer at all.
fn network(r: Request) -> Result<Reply, string> {
    let parts = r.url.split("/")
    sleep(ms(parse_int(parts[0]) ?? 0))
    if parts[1] == "offline" { return .Err("offline") }
    .Ok(Reply { status: 200, body: parts[1].bytes() })
}

fn parsed(r: Reply) -> Result<int, string> {
    let n? = parse_int(r.body.text() ?? "") else { return .Err("not a number") }
    .Ok(n)
}

let good: Fetch<int> = fetch()
let bad: Fetch<int> = fetch()
let seen: Cell<List<int>> = Cell.new([])
let screen = headless(
    () -> text "good=${shown(good.state())} bad=${shown(bad.state())} seen=${seen.get().length}",
)
screen.wired(network)
let feed = unbounded_channel<int>()
println("before: ${screen.text()} asked=${fetched(good, Request.get("100/42"), parsed)}")
screen
    .looped(
        () -> {
            let _ = screen
                .turn(
                    () -> {
                        let _ = fetched(good, Request.get("100/42"), parsed)
                        fetched(bad, Request.get("100/offline"), parsed)
                    },
                )
            let _ = watching(
                feed.source,
                (n: int) -> {
                    seen.set(seen.get().concat([n]))
                    true
                },
            )
            screen.advance(ms(10))
            println("asked: ${screen.text()}")
            let _ = feed.sink.send(1)
            let _ = feed.sink.send(2)
            screen.advance(ms(10))
            println("items: ${screen.text()}")
            screen.advance(ms(200))
            println("answered: ${screen.text()}")
            println("reads: ${good.value() ?? -1} ${good.is_loading()} ${bad.failure() ?? "-"}")
            feed.sink.close()
            screen.advance(ms(10))
        },
    )
"items ${["${n}" for n in seen.get()].join(",")}"
