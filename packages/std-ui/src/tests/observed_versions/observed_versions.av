// proves: an answer carries the version it was made at, and the cache orders answers by it. A re-ask sends
// the version it holds; a 304 changes nothing and costs no paint; a newer version replaces the answer; and an
// answer that arrives late under an older version, or the same one, never does — eval == native.
use @std.ui.app.{Async, Fetch, fetch, fetched, running}
use @std.ui.components.{button, item}
use @std.ui.headless.{headless}
use @std.http_message.message.{Header, Reply, Request, Version}
use @std.time.{ms}

state shown: Fetch<int> = fetch()
state serving: string = "v5/aaa"
state sent: List<string> = []

fn words(a: Async<int>) -> string {
    match a {
        .Idle -> "idle",
        .Loading -> "loading",
        .Failed(m) -> "failed ${m}",
        .Ready(n) -> "ready ${n}",
    }
}

fn parsed(r: Reply) -> Result<int, string> { .Ok(r.body.length) }

/// The network: serves `serving` ("v<sequence>/<body>"), and answers 304 to a caller
/// that already holds the version it serves. What it was sent is kept.
fn network(r: Request) -> Result<Reply, string> {
    let held = r.headers.find(it.name == "If-None-Match")
    sent = sent.concat([if held == null { "-" } else { held!.value }])
    let at = serving.split("/")
    let tag = "\"${at[0]}\""
    if held != null && held!.value == tag {
        return .Ok(
            Reply { status: 304, headers: [Header { name: "etag", value: tag }], body: "".bytes() },
        )
    }
    .Ok(Reply { status: 200, headers: [Header { name: "etag", value: tag }], body: at[1].bytes() })
}

fn view() -> item {
    item {
        items: [
            button "Load" { on press { let _ = fetched(shown, Request.get("/tasks"), parsed) } },
        ]
    }
}

fn write(to: string) -> bool {
    serving = to
    true
}

/// What the entry for /tasks does with an answer that arrives, as the loop would hand it over:
/// tagged with `at`, or with no version at all.
fn arrives(at: Version?, body: string) -> bool {
    let on? = running() else { return false }
    let entry? = on.observed.entries.get().first() else { return false }
    let tagged = if at == null { [] } else { [Header { name: "etag", value: at!.tag() }] }
    entry.offered(.Ok(Reply { status: 200, headers: tagged, body: body.bytes() }))
}

fn at(sequence: int) -> Version? { Version { sequence: sequence } }

let screen = headless(view)
screen.wired(network)
screen
    .running(
        () -> {
            let _ = screen.press("Load")
            screen.advance(ms(10))
            println("a first answer: ${words(shown.state())}, asked with ${sent.join(" ")}")
            let _ = screen.press("Load")
            let walks = screen.shown.app.walks.get()
            screen.advance(ms(10))
            println(
                "asked again with ${sent.join(" ")}: ${words(shown.state())}, ${screen.shown.app.walks.get() - walks} paints for the 304",
            )
            let _ = screen.turn(() -> write("v6/bbbb"))
            let _ = screen.press("Load")
            screen.advance(ms(10))
            println("a write: asked with ${sent.join(" ")}, shows ${words(shown.state())}")
            println(
                "an older version arriving late: replaced ${arrives(at(5), "x")}, shows ${words(shown.state())}",
            )
            println(
                "the same version again: replaced ${arrives(at(6), "y")}, shows ${words(shown.state())}",
            )
            println(
                "a higher sequence: replaced ${arrives(at(9), "zzzzzz")}, shows ${words(shown.state())}",
            )
            println(
                "an answer with no version has none to lose to: replaced ${arrives(null, "q")}, shows ${words(shown.state())}",
            )
        },
    )
