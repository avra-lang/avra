// proves: a driven screen is deterministic by construction. What the app asks
// for falls due in time order and, together, in the order it was asked; a
// period repeats on its own beat; a zero wait runs what is due now; a request
// is answered in the instant it is asked; what a control asked is dropped
// when the control leaves the screen and what another asked stands; and a
// loop that has ended refuses new asks — eval == native, under every schedule.
use @std.ui.app.{Async, Fetch, fetch, fetched}
use @std.ui.app.{later, repeating}
use @std.ui.components.{button, item}
use @std.ui.headless.{headless}
use @std.http_message.message.{Reply, Request}
use @std.time.{ms}

state log: List<string> = []
state b_stands: int = 1
state profile: Fetch<int> = fetch()

fn note(what: string) -> bool {
    log = log.concat([what])
    true
}

fn asks(who: string) {
    let _ = later(ms(5), () -> note("${who}5"))
    let _ = later(ms(2), () -> note("${who}2"))
}

fn parsed(r: Reply) -> Result<int, string> { .Ok(r.body.length) }

fn names() -> List<string> { if b_stands > 0 { ["A", "B"] } else { ["A"] } }

fn view() -> item {
    item {
        items: [button who {
            key: who
            on press { asks(who) }
        } for who in names()]
    }
}

fn leave_b() -> bool {
    b_stands = 0
    true
}

fn words(a: Async<int>) -> string {
    match a {
        .Idle -> "idle",
        .Loading -> "loading",
        .Failed(m) -> "failed ${m}",
        .Ready(v) -> "ready ${v}",
    }
}

fn said() -> string { log.join(",") }

fn network(r: Request) -> Result<Reply, string> { .Ok(Reply { status: 200, body: r.url.bytes() }) }

let screen = headless(view)
screen.wired(network)
screen
    .running(
        () -> {
            let _ = screen.press("A")
            let _ = screen.press("B")
            screen.advance(ms(0))
            println("asked, nothing due: [${said()}]")
            screen.advance(ms(2))
            println("two ms on, in the order asked: [${said()}]")
            screen.advance(ms(3))
            println("five ms on: [${said()}]")
            let _ = later(ms(0), () -> note("zero"))
            screen.advance(ms(0))
            println("a zero wait runs when waited for: [${said()}]")
            let _ = repeating(ms(3), () -> note("tick"))
            screen.advance(ms(10))
            println("a period beats at 3, 6 and 9: ${said().split(",").length - 5} ticks")
            let before = said().length
            let _ = screen.press("A")
            let _ = screen.press("B")
            let _ = screen.turn(leave_b)
            screen.advance(ms(5))
            println(
                "a control left: its asks dropped, the other's stand: ${said().substring(before, said().length).replace("tick,", "").replace(",tick", "")}",
            )
            let _ = screen.press("B")
            let _ = fetched(profile, Request.get("abcd"), parsed)
            screen.advance(ms(0))
            println("a request is answered in the instant it is asked: ${words(profile.state())}")
        },
    )
let late = later(ms(1), () -> true)
println("after the loop: ${late}")
