//! A composition whose file declares its own, unrelated `View` and
//! imports the library's none: what composes it is found by what it is,
//! never by a name its file happens to bind.
use components.{button, text}

/// Nothing to do with the library's trait of the same name.
export type View = { angle: int }

export component dial(label: string) {
    state turns: int = 0
    text "${self.label} at ${quarter(View { angle: self.turns }).angle}"
    button "turn ${self.label}" { on press { self.turns = self.turns + 1 } }
}

/// A quarter turn on.
fn quarter(v: View) -> View { View { angle: v.angle + 90 } }
