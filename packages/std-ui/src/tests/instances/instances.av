// proves: state a component INSTANCE owns. Two instances of one
// component hold two counts; a seed is read once; a later instance's
// props reach the one that stands.
use @std.ui.components.{column, text}
use @std.ui.headless.{headless}
use @std.ui.tests.parts.{counter}
use @std.ui.tree.view.{View}

state title: string = "left"

fn page() -> column {
    column {
        counter title
        counter "right" { n: 10 }
    }
}

let screen = headless(page)
println(screen.text())
println("${screen.press("left+")} ${screen.press("left+")} ${screen.press("right+")}")
println(screen.text())
title = "renamed"
screen.repaint()
println(screen.text())
println("held=${screen.held()}")
