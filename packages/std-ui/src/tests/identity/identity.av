// proves: a node's id is ITS OWN across paints — the host's echo of an id
// an earlier paint gave still runs that node's handler after a sibling is
// inserted above it, a second paint of one state says nothing, and what
// lands above a kept row is created and placed while the row is untouched.
use @std.ui.components.{button, item, list, text}
use @std.ui.realize.dom.live.{Live, live}
use @std.ui.realize.tests.support.{named}
use @std.ui.realize.view.{View}
use @std.ui.style.theme.{default_theme}

type Row = { id: string }

fn rows_of(ids: List<string>) -> List<Row> { [Row { id: i } for i in ids] }

state rows: List<Row> = rows_of(["a", "b"])
state banner: bool = false
state pressed: string = ""

fn row_item(r: Row) -> item {
    item {
        key: r.id
        items: [button "Pick" { on press { pressed = r.id } }]
    }
}

/// The keyed rows, under an unkeyed banner when one is shown.
fn view() -> list {
    let shown: List<dyn View> = if banner { [text "new above"] } else { [] }
    let listed: List<dyn View> = [row_item(r) for r in rows]
    list { items: shown.concat(listed) }
}

/// The page the host would hold.
once fn page() -> Live { live() }

/// What a paint of the view says to the host.
fn painted() -> string { page().said(view().describe(), default_theme) }

println(painted())
let before = named(page(), "Pick")
println("same_twice=[${painted()}]")

// an unkeyed sibling and a keyed row both land above rows a and b
banner = true
rows = rows_of(["new", "a", "b"])
println(painted())
println("b_kept=${named(page(), "Pick").contains(before[1])}")
println("fired=${page().fire(before[1], .Press, null)} pressed=${pressed}")
println("fired=${page().fire(before[0], .Press, null)} pressed=${pressed}")

// a row that left answers nothing
rows = rows_of(["new", "b"])
println(painted())
println("gone=${page().fire(before[0], .Press, null)} pressed=${pressed}")
