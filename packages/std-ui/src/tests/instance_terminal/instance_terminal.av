// proves: instance state in a TERMINAL. Enter presses the counter that
// holds the focus and that counter alone counts; Tab moves to the
// next; and a keyed row that moves keeps both its count and the focus.
use @std.ui.components.{list}
use @std.ui.terminal.{terminal}
use @std.ui.tests.parts.{counter}
use @std.ui.tree.view.{View}

state order: List<string> = ["a", "b"]

fn page() -> list { list { items: [counter "${id}" { key: id } for id in order] } }

let on = terminal(page, width: 24)

println("── start")
println(on.screen())
on.feed("\n\n")
println("── enter, enter")
println(on.screen())
on.feed("\t\n")
println("── tab, enter")
println(on.screen())
order = ["b", "a"]
on.repaint()
on.feed("\n")
println("── b first, enter")
println(on.screen())
println("held=${on.shown.app.held()}")
