// proves: the board is a REAL screen — tasks with done-state, three filters,
// adding from a field, a derived count and progress, a card/row/column/item
// layout, a dialog and a theme — and its frame is a function of module
// `state`. The controls are the library's OWN (`button`, `checkbox`, `field`)
// with `on <kind> { … }` handlers, and the task rows are one KEYED list. The
// frame is printed byte-exact in both engines, so a change to the view
// changes THIS receipt.
use @std.ui.components.{
    button,
    card,
    checkbox,
    column,
    dialog,
    divider,
    field,
    heading,
    item,
    list,
    progress,
    row,
    surface,
    text,
}
use @std.ui.realize.dom.frame.{Live, frame_text, live, sheet}
use @std.ui.realize.payload.{Payload}
use @std.ui.realize.update.{Op, plan}
use @std.ui.realize.view.{View}
use @std.ui.style.layout.{Layout, around}
use @std.ui.style.style.{Style}
use @std.ui.style.theme.{dark_theme, default_theme}

type Todo = { id: string, title: string, done: bool }

state filter: string = "all"
state dark: bool = false
state dialog_open: bool = false
state draft: string = ""
state seq: int = 5
state tasks: List<Todo> = [
    Todo { id: "t1", title: "Draft the spec", done: true },
    Todo { id: "t2", title: "Wire the event channel", done: false },
    Todo { id: "t3", title: "Land the wasm board", done: false },
    Todo { id: "t4", title: "Write the tour", done: true },
]

fn done_count() -> int { [t for t in tasks if t.done].length }

fn admits(t: Todo) -> bool {
    when {
        filter == "active" -> !t.done
        filter == "done" -> t.done
        _ -> true
    }
}

fn visible() -> List<Todo> { [t for t in tasks if admits(t)] }

fn theme_label() -> string { if dark { "Light mode" } else { "Dark mode" } }

fn tab_style(on: bool) -> Style {
    if on { sunk_style() } else { Style { radius: .S } }
}

fn title_style(done: bool) -> Style {
    if done { Style { color: .Muted } } else { Style { color: .Text } }
}

fn sunk_style() -> Style { Style { fill: .SurfaceSunk, radius: .S } }

fn spread_layout() -> Layout { Layout { gap: .M, align: .Center, distribute: .SpaceBetween } }

/// The draft becomes the next task, and the draft is spent.
fn add() {
    if draft != "" {
        tasks = tasks.concat([Todo { id: "t${seq}", title: draft, done: false }])
        seq = seq + 1
        draft = ""
    }
}

/// This task with its state flipped when it is the named one, unchanged
/// otherwise.
fn flipped(t: Todo, id: string) -> Todo {
    if t.id == id { t with { done: !t.done } } else { t }
}

/// The page the host would hold: the last frame and the handlers it bound.
once fn page() -> Live { live() }

/// The ids of the nodes whose words are `words`, in frame order.
fn worded(op: Op, words: string) -> List<int> {
    match op {
        .Words(id, label) -> if label == words { [id] } else { [] },
        .Mount(_) or .Event(_, _) -> [],
    }
}

/// The host's echo, without the wire: paint, then the `nth` control saying
/// `words` speaks `kind`. The frame bound the handler; the echo names only
/// the node, so row t3's Remove runs t3's closure, never the first row's.
fn press(words: string, nth: int, kind: int, said: Payload?) -> bool {
    let root = view().describe()
    page().diff(root, default_theme)
    let ids = [id for op in plan(root) for id in worded(op, words)]
    if nth >= ids.length { return false }
    page().fire(ids[nth], kind, said)
}

fn tab(label: string, shows: string) -> button {
    button label {
        on click { filter = shows }
        style: tab_style(filter == shows)
    }
}

fn header() -> row {
    row {
        layout: spread_layout()
        items: [
            column {
                layout: Layout { gap: .Xs }
                items: [
                    heading "Tasks" { rank: 1 },
                    text "Every task is a value; the screen is a function of state." {
                        style: Style { color: .Muted }
                    },
                ]
            },
            button theme_label() {
                on click { dark = !dark }
                style: sunk_style()
            },
        ]
    }
}

fn filters() -> row {
    row {
        layout: Layout { gap: .S, align: .Center }
        items: [
            tab("All", "all"),
            tab("Active", "active"),
            tab("Done", "done"),
            button "Clear done" {
                on click { tasks = [t for t in tasks if !t.done] }
                disabled: done_count() == 0
                style: sunk_style()
            },
        ]
    }
}

fn new_task() -> row {
    row {
        layout: Layout { gap: .S, align: .Center }
        items: [
            field "New task" {
                value: draft
                placeholder: "Type a task…"
                on_input: (body: string) -> { draft = body }
            },
            button "Add" {
                on click { add() }
                style: sunk_style()
            },
        ]
    }
}

/// The task rows: ONE keyed list, so a reorder or an insert keeps every node.
/// The item is written IN THE LIST — the keyed head reads `it.id` off the
/// element it hands the body, and a helper returning an item would carry no
/// key. An empty view is a word, never a stray row.
fn task_view() -> List<dyn View> {
    if visible().is_empty() {
        [text "Nothing here yet." { style: Style { color: .Muted } }]
    } else {
        [task_list()]
    }
}

fn task_list() -> list {
    list visible() by it.id { t ->
        item {
            items: [
                checkbox t.title {
                    checked: t.done
                    on change { tasks = [flipped(x, t.id) for x in tasks] }
                    style: title_style(t.done)
                },
                button "Remove" {
                    on click { tasks = [x for x in tasks if x.id != t.id] }
                    style: sunk_style()
                },
            ]
        }
    }
}

fn board_items() -> List<dyn View> {
    let done = progress "Done" {
        amount: done_count()
        max: tasks.length
    }
    let head: List<dyn View> = [done, filters(), new_task(), divider {}]
    let body: List<dyn View> = task_view()
    head.concat(body)
}

fn board() -> card {
    card "Board" {
        style: Style { fill: .SurfaceRaised, radius: .M }
        layout: Layout { gap: .M, pad: around(.M) }
        items: board_items()
    }
}

fn footer() -> row {
    row {
        layout: spread_layout()
        items: [
            text "${[t for t in tasks if !t.done].length} open · ${done_count()} done of ${tasks.length}" {
                style: Style { color: .Muted }
            },
            button "About" {
                on click { dialog_open = true }
                style: sunk_style()
            },
        ]
    }
}

fn about() -> dialog {
    dialog "About" {
        open: dialog_open
        items: [
            heading "Task board" { rank: 2 },
            text "State lives in module `state`; the frame is its projection.",
            button "Close" {
                on click { dialog_open = false }
                style: sunk_style()
            },
        ]
    }
}

fn view() -> surface {
    surface {
        style: Style { fill: .Surface, radius: .M }
        layout: Layout { gap: .M, pad: around(.L) }
        items: [header(), board(), footer(), about()]
    }
}

println(frame_text(view().describe()))
println("active=${press("Active", 0, 1, null)}")
println(frame_text(view().describe()))
println("clear=${press("Clear done", 0, 1, null)}")
println(frame_text(view().describe()))
println("about=${press("About", 0, 1, null)}")
println(frame_text(view().describe()))
println(
    "all=${filter} open=${[t for t in tasks if !t.done].length} done=${done_count()} total=${tasks.length}",
)
println("dark=${sheet(view().describe(), dark_theme).contains("--tone-text:#eeeeee")}")
println("unbound=${press("Tasks", 0, 1, null)} wrong_kind=${press("About", 0, 2, null)}")

// THE PER-ITEM WITNESS: both rows share one `on click` in the source, and the
// second row's Remove takes only its own task. A wrong row or none at all
// would show here.
println("remove=${press("Remove", 1, 1, null)}")
println("after_remove_t3=[${[t.id for t in tasks].join(",")}]")
println("toggle=${press("Wire the event channel", 0, 3, null)}")
println("after_toggle_t2=${[t.title for t in tasks if t.done].join(",")}")

// THE ADD WITNESS: the field hands its handler the text the user gave, so
// the draft becomes a task and the next id advances. An input that says
// nothing runs no handler.
println("silent=${press("New task", 0, 2, null)} draft=[${draft}]")
println("typed=${press("New task", 0, 2, Payload.Text("Ship the rewrite"))}")
println("add=${press("Add", 0, 1, null)}")
println("after_add=[${[t.id for t in tasks].join(",")}] draft_after=[${draft}]")
