// proves: the board is a COMPONENT whose state is an explicit Cell field;
// one render emits the live target's op frame. No state keyword, no
// compiler change — identity is the Cell that already exists.
use @std.meta.{derive}
use @std.ui.components.{heading, item, button}
use @std.ui.realize.dom.frame.{frame}
use @std.ui.realize.prim.{prim}
use @std.ui.realize.view.{View}
use @std.ui.style.box.{Box}

@derive(View)
@prim(.Surface)
component board {
    ..Box
    show: Cell<string> = Cell.new("all")
    items: List<dyn View> = []
}

let b = board { items: [heading "Tasks" { rank: 1 }, item { button "Add" }] }
b.show.set("open")
println(frame(b.describe()))
println(b.show.get())
