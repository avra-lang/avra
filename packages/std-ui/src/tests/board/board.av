// proves: the board is a REAL screen — tasks with done-state, three filters,
// adding from a field, a derived count and progress, a card/row/column/item
// layout, a dialog and a theme — and its frame is a function of module
// `state`. The controls are the library's OWN (`button`, `checkbox`, `field`)
// carrying typed event fields, and the task rows are one KEYED list. The
// frame is printed byte-exact in both engines, so a change to the view
// changes THIS receipt.
use @std.meta.{derive}
use @std.ui.components.{
    button,
    card,
    checkbox,
    column,
    dialog,
    divider,
    field,
    heading,
    item,
    list,
    progress,
    row,
    surface,
    text,
}
use @std.ui.realize.dom.frame.{event_at, frame_text, sheet}
use @std.ui.realize.messages.{Messages}
use @std.ui.realize.payload.{Payload}
use @std.ui.realize.view.{View}
use @std.ui.style.layout.{Layout, around}
use @std.ui.style.style.{Style}
use @std.ui.style.theme.{dark_theme, default_theme}

/// Every action carries a typed message: a control with no payload carries
/// its site alone, and a per-item action names its row by id. The host echoes
/// the payload the frame named back, so `host_event` below is the app's own
/// door exactly as `avra_event` uses it — site plus payload, never the first
/// row's.
///
/// A BOOL-PAYLOAD VARIANT MUST STAY IN THIS ENUM: the event channel's `dyn
/// Messages` coercion lowers `marks` with the wrong ABI when every payload is
/// text or int, and LLVM refuses the module. `SetTheme(on)` is this board's
/// own bool.
@derive(Messages)
enum Msg {
    ShowAll
    ShowActive
    ShowDone
    ClearDone
    SetTheme(on: bool)
    OpenDialog
    CloseDialog
    Toggle(id: string)
    Remove(id: string)
    Add
    Draft(body: string)
}

type Todo = { id: string, title: string, done: bool }

state filter: string = "all"
state dark: bool = false
state dialog_open: bool = false
state draft: string = ""
state seq: int = 5
state tasks: List<Todo> = [
    Todo { id: "t1", title: "Draft the spec", done: true },
    Todo { id: "t2", title: "Wire the event channel", done: false },
    Todo { id: "t3", title: "Land the wasm board", done: false },
    Todo { id: "t4", title: "Write the tour", done: true },
]

fn done_count() -> int { [t for t in tasks if t.done].length }

fn admits(t: Todo) -> bool {
    when {
        filter == "active" -> !t.done
        filter == "done" -> t.done
        _ -> true
    }
}

fn visible() -> List<Todo> { [t for t in tasks if admits(t)] }

fn theme_label() -> string { if dark { "Light mode" } else { "Dark mode" } }

fn tab_style(on: bool) -> Style {
    if on { sunk_style() } else { Style { radius: .S } }
}

fn title_style(done: bool) -> Style {
    if done { Style { color: .Muted } } else { Style { color: .Text } }
}

fn sunk_style() -> Style { Style { fill: .SurfaceSunk, radius: .S } }

fn spread_layout() -> Layout { Layout { gap: .M, align: .Center, distribute: .SpaceBetween } }

fn update(m: Msg) {
    match m {
        .Add -> { add() },
        .Draft(body) -> { draft = body },
        .ShowAll -> { filter = "all" },
        .ShowActive -> { filter = "active" },
        .ShowDone -> { filter = "done" },
        .ClearDone -> { tasks = [t for t in tasks if !t.done] },
        .SetTheme(on) -> { dark = on },
        .OpenDialog -> { dialog_open = true },
        .CloseDialog -> { dialog_open = false },
        .Toggle(id) -> { tasks = [flipped(t, id) for t in tasks] },
        .Remove(id) -> { tasks = [t for t in tasks if t.id != id] },
    }
}

/// The draft becomes the next task, and the draft is spent.
fn add() {
    if draft != "" {
        tasks = tasks.concat([Todo { id: "t${seq}", title: draft, done: false }])
        seq = seq + 1
        draft = ""
    }
}

/// This task with its state flipped when it is the named one, unchanged
/// otherwise.
fn flipped(t: Todo, id: string) -> Todo {
    if t.id == id { t with { done: !t.done } } else { t }
}

/// The host's echo, without the wire: rebuild the typed message from the
/// SITE the frame named and the PAYLOAD the host carried back, then
/// dispatch it. This is the one door `avra_event` uses. The two arrive
/// separately, so row t3's payload builds `Remove("t3")` even though t2's
/// Remove shares the same site.
fn host_event(site: int, payload: Payload?) {
    let rebuilt? = Msg.from_site(site, payload) else { return }
    update(rebuilt)
}

fn tab(label: string, m: Msg, on: bool) -> button {
    button label {
        on_click: m
        style: tab_style(on)
    }
}

fn header() -> row {
    row {
        layout: spread_layout()
        items: [
            column {
                layout: Layout { gap: .Xs }
                items: [
                    heading "Tasks" { rank: 1 },
                    text "Every task is a value; the screen is a function of state." {
                        style: Style { color: .Muted }
                    },
                ]
            },
            button theme_label() {
                on_click: Msg.SetTheme(!dark)
                style: sunk_style()
            },
        ]
    }
}

fn filters() -> row {
    row {
        layout: Layout { gap: .S, align: .Center }
        items: [
            tab("All", Msg.ShowAll, filter == "all"),
            tab("Active", Msg.ShowActive, filter == "active"),
            tab("Done", Msg.ShowDone, filter == "done"),
            button "Clear done" {
                on_click: Msg.ClearDone
                disabled: done_count() == 0
                style: sunk_style()
            },
        ]
    }
}

fn new_task() -> row {
    row {
        layout: Layout { gap: .S, align: .Center }
        items: [
            field "New task" {
                placeholder: "Type a task…"
                on_input: Msg.Draft("")
            },
            button "Add" {
                on_click: Msg.Add
                style: sunk_style()
            },
        ]
    }
}

/// The task rows: ONE keyed list, so a reorder or an insert keeps every node.
/// The item is written IN THE LIST — the keyed head reads `it.id` off the
/// element it hands the body, and a helper returning an item would carry no
/// key. An empty view is a word, never a stray row.
fn task_view() -> List<dyn View> {
    if visible().is_empty() {
        [text "Nothing here yet." { style: Style { color: .Muted } }]
    } else {
        [task_list()]
    }
}

fn task_list() -> list {
    list visible() by it.id { t ->
        item {
            items: [
                checkbox t.title {
                    checked: t.done
                    on_change: Msg.Toggle(t.id)
                    style: title_style(t.done)
                },
                button "Remove" {
                    on_click: Msg.Remove(t.id)
                    style: sunk_style()
                },
            ]
        }
    }
}

fn board_items() -> List<dyn View> {
    let done = progress "Done" {
        amount: done_count()
        max: tasks.length
    }
    let head: List<dyn View> = [done, filters(), new_task(), divider {}]
    let body: List<dyn View> = task_view()
    head.concat(body)
}

fn board() -> card {
    card "Board" {
        style: Style { fill: .SurfaceRaised, radius: .M }
        layout: Layout { gap: .M, pad: around(.M) }
        items: board_items()
    }
}

fn footer() -> row {
    row {
        layout: spread_layout()
        items: [
            text "${[t for t in tasks if !t.done].length} open · ${done_count()} done of ${tasks.length}" {
                style: Style { color: .Muted }
            },
            button "About" {
                on_click: Msg.OpenDialog
                style: sunk_style()
            },
        ]
    }
}

fn about() -> dialog {
    dialog "About" {
        open: dialog_open
        items: [
            heading "Task board" { rank: 2 },
            text "State lives in module `state`; the frame is its projection.",
            button "Close" {
                on_click: Msg.CloseDialog
                style: sunk_style()
            },
        ]
    }
}

fn view() -> surface {
    surface {
        style: Style { fill: .Surface, radius: .M }
        layout: Layout { gap: .M, pad: around(.L) }
        items: [header(), board(), footer(), about()]
    }
}

println(frame_text(view().describe()))
update(Msg.ShowActive)
println(frame_text(view().describe()))
update(Msg.ClearDone)
println(frame_text(view().describe()))
update(Msg.OpenDialog)
println(frame_text(view().describe()))
println(
    "all=${filter} open=${[t for t in tasks if !t.done].length} done=${done_count()} total=${tasks.length}",
)
println(
    "from_site=${Msg.from_site(Msg.ShowAll.site(), Msg.ShowAll.payload()) != null} distinct=${Msg.ShowAll.site() != Msg.ShowActive.site()}",
)
println("dark=${sheet(view().describe(), dark_theme).contains("--tone-text:#eeeeee")}")
println("event=${event_at(view().describe(), Msg.OpenDialog.site(), 1) != null}")

// THE PER-ITEM WITNESS: the host echoes row t3's Remove payload, and only t3
// leaves. The id is read from `tasks`, so a wrong row (t1) or none at all
// would show here.
host_event(Msg.Remove("t3").site(), Msg.Remove("t3").payload())
println("after_remove_t3=[${[t.id for t in tasks].join(",")}]")
host_event(Msg.Toggle("t2").site(), Msg.Toggle("t2").payload())
println("after_toggle_t2=${[t.title for t in tasks if t.done].join(",")}")

// THE ADD WITNESS: the field's own text rides the payload the same way, so
// the draft becomes a task and the next id advances.
host_event(Msg.Draft("Ship the rewrite").site(), Msg.Draft("Ship the rewrite").payload())
host_event(Msg.Add.site(), Msg.Add.payload())
println("after_add=[${[t.id for t in tasks].join(",")}] draft_after=[${draft}]")
