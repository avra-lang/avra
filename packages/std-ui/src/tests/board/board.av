// proves: the board is a REAL screen — tasks with done-state, three filters,
// a derived count and progress, a card/row/column/item layout, a dialog and a
// theme — and its frame is a function of module `state`. The frame is printed
// byte-exact in both engines, so a change to the view changes THIS receipt.
use @std.meta.{derive}
use @std.ui.components.{
    button,
    card,
    checkbox,
    column,
    dialog,
    divider,
    field,
    heading,
    item,
    list,
    progress,
    row,
    surface,
    text,
}
use @std.ui.realize.dom.frame.{event_at, frame_text, sheet}
use @std.ui.realize.messages.{Messages}
use @std.ui.realize.prim.{prim}
use @std.ui.realize.view.{View}
use @std.ui.style.box.{Box}
use @std.ui.style.layout.{Layout, around}
use @std.ui.style.style.{Style}
use @std.ui.style.theme.{dark_theme, default_theme}

/// Every action carries no payload, so `from_site` resolves it and `update`
/// is ONE exhaustive match. A per-item action needs `Msg.Toggle(id)`, and the
/// event channel does not yet carry the value that would resolve it.
@derive(Messages)
enum Msg {
    ShowAll
    ShowActive
    ShowDone
    ClearDone
    ToggleTheme
    OpenDialog
    CloseDialog
}

type Todo = { id: string, title: string, done: bool }

@derive(View)
@prim(.Button)
component board_action {
    ..Box
    label: string
    on_click: Msg
    disabled: bool = false
}

state filter: string = "all"
state dark: bool = false
state dialog_open: bool = false
state tasks: List<Todo> = [
    Todo { id: "t1", title: "Draft the spec", done: true },
    Todo { id: "t2", title: "Wire the event channel", done: false },
    Todo { id: "t3", title: "Land the wasm board", done: false },
    Todo { id: "t4", title: "Write the tour", done: true },
]

fn done_count() -> int { [t for t in tasks if t.done].length }

fn admits(t: Todo) -> bool {
    when {
        filter == "active" -> !t.done
        filter == "done" -> t.done
        _ -> true
    }
}

fn theme_label() -> string { if dark { "Light mode" } else { "Dark mode" } }

fn tab_style(on: bool) -> Style {
    if on { sunk_style() } else { Style { radius: .S } }
}

fn title_style(done: bool) -> Style {
    if done { Style { color: .Muted } } else { Style { color: .Text } }
}

fn sunk_style() -> Style { Style { fill: .SurfaceSunk, radius: .S } }

fn spread_layout() -> Layout { Layout { gap: .M, align: .Center, distribute: .SpaceBetween } }

fn update(m: Msg) {
    match m {
        .ShowAll -> { filter = "all" },
        .ShowActive -> { filter = "active" },
        .ShowDone -> { filter = "done" },
        .ClearDone -> { tasks = [t for t in tasks if !t.done] },
        .ToggleTheme -> { dark = !dark },
        .OpenDialog -> { dialog_open = true },
        .CloseDialog -> { dialog_open = false },
    }
}

fn tab(label: string, m: Msg, on: bool) -> board_action {
    board_action { label: label, on_click: m, style: tab_style(on) }
}

fn header() -> row {
    row {
        layout: spread_layout()
        items: [
            column {
                layout: Layout { gap: .Xs }
                items: [
                    heading "Tasks" { rank: 1 },
                    text "Every task is a value; the screen is a function of state." {
                        style: Style { color: .Muted }
                    },
                ]
            },
            board_action { label: theme_label(), on_click: Msg.ToggleTheme, style: sunk_style() },
        ]
    }
}

fn filters() -> row {
    row {
        layout: Layout { gap: .S, align: .Center }
        items: [
            tab("All", Msg.ShowAll, filter == "all"),
            tab("Active", Msg.ShowActive, filter == "active"),
            tab("Done", Msg.ShowDone, filter == "done"),
            board_action {
                label: "Clear done",
                on_click: Msg.ClearDone,
                disabled: done_count() == 0,
                style: sunk_style(),
            },
        ]
    }
}

fn task_item(t: Todo) -> item {
    item {
        key: t.id
        layout: Layout { gap: .S, align: .Center, pad: around(.S) }
        items: [
            checkbox t.title {
                checked: t.done
                style: title_style(t.done)
            },
            button "Remove" { disabled: true },
        ]
    }
}

fn task_items() -> List<dyn View> {
    let shown = [t for t in tasks if admits(t)]
    if shown.is_empty() {
        [text "Nothing here yet." { style: Style { color: .Muted } }]
    } else {
        [task_item(t) for t in shown]
    }
}

fn task_list() -> list {
    list {
        layout: Layout { gap: .S }
        items: task_items()
    }
}

fn board_items() -> List<dyn View> {
    let done = progress "Done" {
        amount: done_count()
        max: tasks.length
    }
    let head: List<dyn View> = [
        done,
        filters(),
        field "New task" { placeholder: "Type a task…" },
        divider {},
    ]
    let body: List<dyn View> = [task_list()]
    head.concat(body)
}

fn board() -> card {
    card "Board" {
        style: Style { fill: .SurfaceRaised, radius: .M }
        layout: Layout { gap: .M, pad: around(.M) }
        items: board_items()
    }
}

fn footer() -> row {
    row {
        layout: spread_layout()
        items: [
            text "${[t for t in tasks if !t.done].length} open · ${done_count()} done of ${tasks.length}" {
                style: Style { color: .Muted }
            },
            board_action { label: "About", on_click: Msg.OpenDialog, style: sunk_style() },
        ]
    }
}

fn about() -> dialog {
    dialog "About" {
        open: dialog_open
        items: [
            heading "Task board" { rank: 2 },
            text "State lives in module `state`; the frame is its projection.",
            board_action { label: "Close", on_click: Msg.CloseDialog, style: sunk_style() },
        ]
    }
}

fn view() -> surface {
    surface {
        style: Style { fill: .Surface, radius: .M }
        layout: Layout { gap: .M, pad: around(.L) }
        items: [header(), board(), footer(), about()]
    }
}

println(frame_text(view().describe()))
update(Msg.ShowActive)
println(frame_text(view().describe()))
update(Msg.ClearDone)
println(frame_text(view().describe()))
update(Msg.OpenDialog)
println(frame_text(view().describe()))
println(
    "all=${filter} open=${[t for t in tasks if !t.done].length} done=${done_count()} total=${tasks.length}",
)
println(
    "from_site=${Msg.from_site(Msg.ShowAll.site()) != null} distinct=${Msg.ShowAll.site() != Msg.ShowActive.site()}",
)
println("dark=${sheet(view().describe(), dark_theme).contains("--tone-text:#eeeeee")}")
println("event=${event_at(view().describe(), Msg.OpenDialog.site(), 1) != null}")
