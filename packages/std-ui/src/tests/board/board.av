// proves: the board is a COMPONENT whose state is a `state` field (a record
// spread in), so a read answers the value and a write lands in the one cell;
// one render emits the live target's op frame, classes included.
use @std.meta.{derive}
use @std.ui.components.{heading, item, button}
use @std.ui.realize.dom.frame.{frame_text, sheet, live, no_change}
use @std.ui.realize.html.css.{class_names}
use @std.ui.realize.prim.{prim}
use @std.ui.realize.view.{View}
use @std.ui.style.box.{Box}
use @std.ui.style.style.{Style}
use @std.ui.style.theme.{default_theme}

/// The board's own place, spread into the component: a `state` field holds a
/// Cell, so a read answers the value and a write lands in the one slot.
type BoardState = {
    state show: string = "all",
}

@derive(View)
@prim(.Surface)
component board {
    ..Box
    ..BoardState
    items: List<dyn View> = []
}

const sunk = Style { fill: .SurfaceSunk }

mut b = board { style: sunk, items: [heading "Tasks" { rank: 1 }, item { button "Add" }] }
b.show = "open"
println(frame_text(b.describe()))
println(b.show)
println(class_names(b.describe()).join(","))
let has_class = sheet(b.describe(), default_theme).contains(".fill-surface-sunk{")
println("${has_class}")
let l = live()
let first_sent = l.diff(b.describe(), default_theme)
let second_sent = l.diff(b.describe(), default_theme)
println("${first_sent.length > 2 && second_sent == no_change()}")
println(
    "${l.diff(board { items: [heading "Other" { rank: 2 }] }.describe(), default_theme) != no_change()}",
)
