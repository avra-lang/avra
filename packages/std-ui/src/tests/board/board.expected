surface
  row
    column
      heading "Tasks" level=1
      text "Every task is a value; the screen is a function of state."
    button "Dark mode"
  card title="Board"
    progress "Done" amount=2 max=4
    row
      button "All"
      button "Active"
      button "Done"
      button "Clear done"
    row
      field "New task" value="" placeholder="Type a task…"
      button "Add"
    divider
    list
      item key="t1"
        checkbox "Draft the spec" checked
        button "Remove"
      item key="t2"
        checkbox "Wire the event channel"
        button "Remove"
      item key="t3"
        checkbox "Land the wasm board"
        button "Remove"
      item key="t4"
        checkbox "Write the tour" checked
        button "Remove"
  row
    text "2 open · 2 done of 4"
    button "About"
  dialog "About"
