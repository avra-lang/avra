//! A composition whose view is one thing or another, and one that holds
//! itself: each instance keeps its own state whatever its view becomes.
use @std.meta.{derive}
use components.{button, column, text}
use tree.identity.{Stand}
use tree.view.{View}
use tests.parts.{counter}

@derive(View)
export component shifting(label: string) {
    ..Stand
    state wide: bool = false
    state notes: List<string> = []

    fn view() -> dyn View {
        let flip = button "flip ${self.label}" {
            on press {
                self.wide = !self.wide
                self.notes.push("flipped")
            }
        }
        if self.wide {
            column {
                flip
                text "${self.label} wide ${self.notes.length}"
                counter "${self.label} extra"
            }
        } else {
            column {
                flip
                text "${self.label} narrow ${self.notes.length}"
            }
        }
    }
}
