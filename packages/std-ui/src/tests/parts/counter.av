//! A counter: its count is the INSTANCE's own, starting from `start`, read once as it's made.
use components.{button, text}

export component counter(label: string) {
    start: int = 0
    state n: int = self.start
    text "${self.label}: ${self.n}"
    button "${self.label}+" { on press { self.n = self.n + 1 } }
}
