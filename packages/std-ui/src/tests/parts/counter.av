//! A counter: its count is the INSTANCE's own.
use @std.meta.{derive}
use components.{button, row, text}
use tree.identity.{Stand}
use tree.view.{View}

@derive(View)
export component counter(label: string) {
    ..Stand
    state n: int = 0

    fn view() -> row {
        row {
            text "${self.label}: ${self.n}"
            button "${self.label}+" { on press { self.n = self.n + 1 } }
        }
    }
}
