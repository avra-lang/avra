//! A composition whose own `fn`s, and its file's, wear the names a
//! composition's generated parts might: none of them is taken.
use components.{button, text}

export fn clash_kept() -> int { 7 }

export fn clash_made() -> int { 8 }

export component clash(label: string) {
    state n: int = 0
    fn composed() -> string { "mine" }
    fn made() -> int { clash_kept() + clash_made() }
    text "${self.label} ${self.composed()} ${self.made()}: ${self.n}"
    button "${self.label}+" { on press { self.n = self.n + 1 } }
}
