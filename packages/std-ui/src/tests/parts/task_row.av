//! A task's row. `open` is the ROW's — gone when the row leaves the
//! screen; `starred` is the TODO's, a place on the model itself, so it
//! lives as long as the todo does.
use @std.meta.{derive}
use components.{button, item, text}
use tree.identity.{Stand}
use tree.view.{View}

export type Todo = { id: string, title: string, state starred: bool = false }

@derive(View)
export component task_row(todo: Todo) {
    ..Stand
    state open: bool = false

    fn view() -> item {
        item {
            button self.todo.title { on press { self.open = !self.open } }
            button "star ${self.todo.title}" { on press { self.todo.starred = !self.todo.starred } }
            text "${if self.open { "open" } else { "shut" }}${if self.todo.starred { " starred" } else { "" }}"
        }
    }
}
