//! Attacks on the vocabulary: degenerate sizes, computed strings, depth,
//! and views shared or repeated.
use @std.ui.components.{button, column, item, list, row, text}
use @std.ui.realize.outline.{outline}
use @std.ui.realize.render.{Node}
use @std.ui.realize.shows.{Shows, rows}
use @std.ui.realize.view.{View}
use @std.ui.style.box.{Box}

type Label = { word: string }

impl Shows for Label {
    fn view() -> dyn View { text "${self.word}!" }
}

fn words(n: int) -> List<dyn Shows> { [Label { word: "w${i}" } for i in 0..n] }

/// A column nested `depth` deep around one text.
fn nested(depth: int) -> Node {
    if depth == 0 { return (text "core").describe() }
    Node { prim: .Column, attrs: [], box: Box {}, children: [nested(depth - 1)] }
}

fn depth_of(n: Node) -> int {
    match n.children.first() {
        c? -> 1 + depth_of(c)
        null -> 0
    }
}

fn many(n: int) -> Node { (column { [text "t${i}" for i in 0..n] }).describe() }

spec "the vocabulary under attack" {
    given "degenerate sizes" {
        then "a one-element rows is one child" { (list { rows(words(1)) }).describe().children.length == 1 }
        then "a large list keeps every child in order" {
            many(2000).children.length == 2000 &&
                outline(many(3)) == "column\n  text \"t0\"\n  text \"t1\"\n  text \"t2\""
        }
    }
    given "computed strings" {
        then "a label built at run time survives the node that holds it" {
            outline((list { rows(words(3)) }).describe()) == "list\n  text \"w0!\"\n  text \"w1!\"\n  text \"w2!\""
        }
        then "computed keys that agree are equal keys" {
            (item { key: "x${1 + 1}" }).describe().box.key == (item { key: "x2" }).describe().box.key
        }
    }
    given "depth and sharing" {
        then "a tree nested 200 deep keeps its depth" { depth_of(nested(200)) == 200 }
        then "one view written twice answers two equal nodes" {
            let b = button "again"
            let n = (row {
                b
                b
            })
                .describe()
            outline(n) == "row\n  button \"again\"\n  button \"again\"" && n.children.length == 2
        }
    }
}
