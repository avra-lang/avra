//! A composition whose VIEW is a composition: the two stand at one
//! node of the tree and never share a standing.
use @std.meta.{derive}
use tree.view.{View}
use tests.panels.{tally}

@derive(View)
export component framed(label: string) {
    state seen: int = 0

    fn view() -> tally { tally self.label }
}
