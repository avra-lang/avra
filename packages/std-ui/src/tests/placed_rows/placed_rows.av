// proves: in a program that sets a context, a handler that reads none
// keeps what it captures where its control is drawn — each keyed row's
// Remove takes its own row, and each checkbox marks its own — and a
// handler that reads one hears the one in force where its control was
// placed.
use @std.ui.components.{button, checkbox, column, item, list}
use @std.ui.headless.{headless}

ctx tone: string = "plain"

type Row = { id: string, done: bool }

state rows: List<Row> = [
    Row { id: "a", done: false },
    Row { id: "b", done: false },
    Row { id: "c", done: false },
]
state heard: string = ""

fn marked(x: Row, id: string, on: bool) -> Row { if x.id == id { x with { done: on } } else { x } }

fn row_list() -> list {
    list rows by it.id { r ->
        item {
            items: [
                checkbox r.id {
                    shown: r.done
                    on change { on -> rows = [marked(x, r.id, on) for x in rows] }
                },
                button "Remove" { on press { rows = [x for x in rows if x.id != r.id] } },
            ]
        }
    }
}

fn page_view() -> column {
    column {
        ctx tone = "loud"
        row_list()
        button "Tone" { on press { heard = ctx.tone } }
    }
}

let page = headless(page_view)
println("remove=${page.press("Remove", nth: 1)} left=[${[r.id for r in rows].join(",")}]")
println("toggle=${page.check("c", true)} done=[${[r.id for r in rows if r.done].join(",")}]")
println("tone=${page.press("Tone")} heard=${heard}")
println(page.text())
