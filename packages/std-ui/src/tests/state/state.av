// proves: a `state` binding is a PLACE — a read answers the value it
// holds, a write assigns it, and what captures it SHARES it. A `mut`
// local cannot: a capture is a copy of a value, and a Cell's copy shares.
fn counter() -> fn() -> int {
    state n: int = 0
    () -> {
        n = n + 1
        n
    }
}

let c = counter()
println("${c()} ${c()} ${c()}")
