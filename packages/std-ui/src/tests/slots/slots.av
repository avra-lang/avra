// proves: a slot is a field of views, and one may be the default. An
// instance's bare statements fill the `@default` slot in written order,
// `actions { … }` fills the slot of that name wherever it is written among
// them, `actions: collect { … }` still does, and a component with one slot
// takes bare content as before.
use @std.ui.components.{button, column, heading, row, text}
use @std.ui.headless.{headless}
use @std.ui.tree.view.{View}

component panel(title: string) {
    @default body: List<dyn View> = []
    actions: List<dyn View> = []
    column {
        heading self.title
        self.body
        row { self.actions }
    }
}

component single {
    items: List<dyn View> = []
    column { self.items }
}

fn named() -> panel {
    panel "Settings" {
        text "dense"
        actions {
            button "Done" {}
            button "Cancel" {}
        }
        text "wide"
    }
}

fn collected() -> panel {
    panel "Old" {
        text "body"
        actions: collect {
            button "Ok" {}
        }
    }
}

fn lone() -> single {
    single {
        text "one"
        text "two"
    }
}

println(headless(named).text().trim())
println(headless(collected).text().trim())
println(headless(lone).text().trim())
