//! The environment a tree is drawn in, by its law: it always resolves,
//! because the library ships defaults, and it is replaced whole.
use @std.ui.env.{Env, Direction}

fn unset() -> Env { Env {} }

fn arabic() -> Env { Env { direction: .Rtl, locale: "ar" } }

spec "std/ui env — an environment nobody set" {
    given "the library's defaults" {
        then "is left to right" { unset().direction == Direction.Ltr }
        then "is english" { unset().locale == "en" }
    }
}

spec "std/ui env — an environment replaced" {
    given "a right-to-left environment in another locale" {
        then "reads back its direction" { arabic().direction == Direction.Rtl }
        then "keeps the locale it was given" { arabic().locale == "ar" }
    }
}
