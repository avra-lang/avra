// A component answers a Node; containers collect their children; the
// spoken form reads the tree in order.
use @std.ui.{column, row, text, button, spoken, Node, Setting}

/// The gap is the medium one.
fn gap_m(s: Setting) -> bool {
    match s { .Gap(z) -> z is .M, _ -> false }
}

fn tree() -> Node {
    let c = column {
        gap: .M
        text "Tasks"
        row {
            text "one" {
                tone: .Muted
            }
            button "Add"
        }
    }
    c.node()
}

spec "std/ui" {
    given "a tree" {
        then "a container's children are its body, in order" {
            tree().children.length == 2 && tree().children[1].children.length == 2
        }
        then "a value head is the node's content" {
            spoken(tree()) == "Tasks one [Add]"
        }
        then "a setting rides as a style role" {
            tree().look.any(gap_m)
        }
        then "a control with no body has no children" {
            tree().children[1].children[1].children.length == 0
        }
    }
}
