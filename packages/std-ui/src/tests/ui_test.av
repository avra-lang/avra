// Every component answers one exact node; containers collect their
// children; `shape` prints the whole node, role and look and key.
use @std.ui.{View, Shows, Node, Role, Setting, Size, Tone, Font}
use @std.ui.{text, heading, image, link, button, toggle, field, column, row, section, list, item}
use @std.ui.{rows, spoken}

fn size_word(z: Size) -> string {
    match z { .None -> "none", .Xs -> "xs", .S -> "s", .M -> "m", .L -> "l", .Xl -> "xl" }
}

fn tone_word(t: Tone) -> string {
    match t {
        .Text -> "text",
        .Muted -> "muted",
        .Danger -> "danger",
        .Surface -> "surface",
        .SurfaceRaised -> "raised",
        .SurfaceSunk -> "sunk",
        .SurfaceHover -> "hover",
    }
}

fn font_word(f: Font) -> string {
    match f { .Body -> "body", .Heading -> "heading", .Footnote -> "footnote", .Mono -> "mono" }
}

fn setting_word(s: Setting) -> string {
    match s {
        .Gap(z) -> "gap=${size_word(z)}",
        .Pad(z) -> "pad=${size_word(z)}",
        .Radius(z) -> "radius=${size_word(z)}",
        .Fill(t) -> "fill=${tone_word(t)}",
        .Color(t) -> "color=${tone_word(t)}",
        .Face(f) -> "face=${font_word(f)}",
    }
}

fn role_word(r: Role) -> string {
    match r {
        .Text(c) -> "Text(${c})",
        .Heading(c, n) -> "Heading(${c}, ${n})",
        .Image(s, a) -> "Image(${s}, ${a})",
        .Link(l, t) -> "Link(${l}, ${t})",
        .Button(l) -> "Button(${l})",
        .Toggle(l, on) -> "Toggle(${l}, ${on})",
        .Field(l, v) -> "Field(${l}, ${v})",
        .Column -> "Column",
        .Row -> "Row",
        .Section(t) -> "Section(${t})",
        .List -> "List",
        .Item -> "Item",
    }
}

/// A node, whole: role, look, key, then its children in braces.
fn shape(n: Node) -> string {
    let look = [setting_word(s) for s in n.look].join(",")
    let kids = [shape(c) for c in n.children].join(" ")
    "${role_word(n.role)} [${look}] key=${n.key ?? "-"} {${kids}}"
}

type Chore = { title: string, done: bool }

impl Shows for Chore {
    fn view() -> dyn View { toggle self.title { on: self.done } }
}

fn tasks() -> List<dyn Shows> {
    [Chore { title: "milk", done: true }, Chore { title: "eggs", done: false }]
}

fn everything() -> Node {
    let c = column {
        gap: .M
        heading "Shop" {
            rank: 2
        }
        section "Basket" {
            pad: .S
            list {
                item {
                    key: "a"
                    text "apples"
                    link "more" {
                        to: "/apples"
                    }
                }
            }
            image "a.png" {
                alt: "apples"
            }
        }
        row {
            field "qty" {
                value: "3"
            }
            toggle "gift"
            button "Buy"
        }
    }
    c.node()
}

fn loud() -> Node {
    let t = text "hi" {
        tone: .Danger
        font: .Mono
    }
    t.node()
}

fn ranked() -> Node {
    let h = heading "T" {
        rank: 3
        tone: .Muted
    }
    h.node()
}

fn spaced() -> Node {
    let r = row {
        gap: .L
        pad: .Xs
        fill: .SurfaceSunk
        radius: .M
    }
    r.node()
}

fn plain_text() -> Node {
    let t = text "hi"
    t.node()
}

fn plain_heading() -> Node {
    let h = heading "T"
    h.node()
}

fn pic() -> Node {
    let i = image "a.png" {
        alt: "apples"
    }
    i.node()
}

fn ref_link() -> Node {
    let l = link "more" {
        to: "/x"
    }
    l.node()
}

fn go() -> Node {
    let b = button "Go"
    b.node()
}

fn switch(on: bool) -> Node {
    let t = toggle "a" {
        on: on
    }
    t.node()
}

fn entry(v: string) -> Node {
    let f = field "n" {
        value: v
    }
    f.node()
}

fn bare_field() -> Node {
    let f = field "n"
    f.node()
}

fn bare_toggle() -> Node {
    let t = toggle "a"
    t.node()
}

fn empty_column() -> Node {
    let c = column {}
    c.node()
}

fn empty_section() -> Node {
    let s = section "S" {}
    s.node()
}

fn empty_list() -> Node {
    let l = list {}
    l.node()
}

fn keyed(k: string) -> Node {
    let i = item {
        key: k
    }
    i.node()
}

spec "std/ui components" {
    given "a value head with settings" {
        then "text carries its tone and face" {
            shape(loud()) == "Text(hi) [color=danger,face=mono] key=- {}"
        }
        then "text defaults to the body face in the text tone" {
            shape(plain_text()) == "Text(hi) [color=text,face=body] key=- {}"
        }
        then "a heading takes rank 1 by default and always the heading face" {
            shape(plain_heading()) == "Heading(T, 1) [color=text,face=heading] key=- {}"
        }
        then "a heading's rank and tone are settings" {
            shape(ranked()) == "Heading(T, 3) [color=muted,face=heading] key=- {}"
        }
    }
    given "the controls" {
        then "an image carries its source and its alt" {
            shape(pic()) == "Image(a.png, apples) [] key=- {}"
        }
        then "a link carries its label and destination" {
            shape(ref_link()) == "Link(more, /x) [] key=- {}"
        }
        then "a button is its label alone" {
            shape(go()) == "Button(Go) [] key=- {}"
        }
        then "a toggle is off unless it says on" {
            shape(bare_toggle()) == "Toggle(a, false) [] key=- {}" &&
                shape(switch(true)) == "Toggle(a, true) [] key=- {}"
        }
        then "a field is empty unless it has a value" {
            shape(bare_field()) == "Field(n, ) [] key=- {}" &&
                shape(entry("v")) == "Field(n, v) [] key=- {}"
        }
    }
    given "the containers" {
        then "a column defaults to no gap, no pad, the surface fill, no radius" {
            shape(empty_column()) == "Column [gap=none,pad=none,fill=surface,radius=none] key=- {}"
        }
        then "a row takes the same look settings" {
            shape(spaced()) == "Row [gap=l,pad=xs,fill=sunk,radius=m] key=- {}"
        }
        then "a section defaults to the raised fill and carries its title" {
            shape(empty_section()) == "Section(S) [gap=none,pad=none,fill=raised,radius=none] key=- {}"
        }
        then "a list has no look and no key" {
            shape(empty_list()) == "List [] key=- {}"
        }
        then "an item's key lands in the node's key" {
            shape(keyed("k1")) == "Item [] key=k1 {}"
        }
        then "an empty key is a key, not an absence" {
            keyed("").key == ""
        }
    }
    given "a nested tree of every role" {
        then "the whole tree is exactly the written one" {
            shape(everything()) == "Column [gap=m,pad=none,fill=surface,radius=none] key=- {Heading(Shop, 2) [color=text,face=heading] key=- {} Section(Basket) [gap=none,pad=s,fill=raised,radius=none] key=- {List [] key=- {Item [] key=a {Text(apples) [color=text,face=body] key=- {} Link(more, /apples) [] key=- {}}} Image(a.png, apples) [] key=- {}} Row [gap=none,pad=none,fill=surface,radius=none] key=- {Field(qty, 3) [] key=- {} Toggle(gift, false) [] key=- {} Button(Buy) [] key=- {}}}"
        }
        then "the spoken form reads the tree in order" {
            spoken(everything()) == "Shop Basket apples more apples qty: 3 [ ] gift [Buy]"
        }
    }
    given "children written with control flow" {
        then "a for statement contributes a child per turn" {
            let c = column {
                for i in 0..3 {
                    text "n${i}"
                }
            }
            spoken(c.node()) == "n0 n1 n2"
        }
        then "an if statement contributes a child only when it holds" {
            let shown = false
            let c = column {
                text "a"
                if shown {
                    text "b"
                }
                text "c"
            }
            spoken(c.node()) == "a c"
        }
        then "a comprehension spreads its views among their siblings" {
            let c = row {
                button "x"
                [button "n${i}" for i in 0..2]
                button "y"
            }
            spoken(c.node()) == "[x] [n0] [n1] [y]"
        }
        then "a for inside an item keeps the item's key" {
            let it = item {
                key: "k"
                for i in 0..2 {
                    text "t${i}"
                }
            }
            shape(it.node()) == "Item [] key=k {Text(t0) [color=text,face=body] key=- {} Text(t1) [color=text,face=body] key=- {}}"
        }
    }
    given "values that show themselves" {
        then "a list of them lists each through its Shows, twice over" {
            let l = list {
                rows(tasks())
                rows(tasks())
            }
            spoken(l.node()) == "[x] milk [ ] eggs [x] milk [ ] eggs"
        }
        then "listed values share the list with written children, in order" {
            let l = list {
                text "head"
                rows(tasks())
                text "tail"
            }
            spoken(l.node()) == "head [x] milk [ ] eggs tail"
        }
        then "no values is no children" {
            let none: List<dyn Shows> = []
            list { rows(none) }.node().children.length == 0
        }
    }
    given "hostile strings" {
        then "markup, quotes, newlines and unicode ride through untouched" {
            let b = button "<b>\"x\"</b>\né 😀"
            shape(b.node()) == "Button(<b>\"x\"</b>\né 😀) [] key=- {}"
        }
        then "an empty alt is an image with a description of nothing, still an image" {
            let i = image "a.png" {
                alt: ""
            }
            shape(i.node()) == "Image(a.png, ) [] key=- {}"
        }
        then "a rank outside the usual range is the node's rank, unclamped" {
            let h = heading "T" {
                rank: 0
            }
            shape(h.node()) == "Heading(T, 0) [color=text,face=heading] key=- {}"
        }
        then "an empty label speaks as nothing" {
            let c = column {
                button ""
                text "a"
            }
            spoken(c.node()) == "[] a"
        }
    }
}
