// proves: a message variant's captures ride the wire as a typed payload —
// the site stays the variant's identity, `payload()` lifts its one scalar
// field, `from_site(site, payload)` rebuilds the message, and a frame with
// an equal payload compares equal while a different one does not.
use @std.meta.{derive}
use @std.ui.realize.view.{View}
use @std.ui.realize.prim.{prim}
use @std.ui.realize.dom.frame.{frame}
use @std.ui.realize.messages.{Messages}
use @std.ui.style.box.{Box}

@derive(Messages)
enum Item {
    Toggle(id: int)
    Draft(text: string)
    Flag(on: bool)
    Clear
}

@derive(View)
@prim(.Button)
component item_button {
    ..Box
    on_click: Item = Item.Clear
}

fn btn(m: Item) -> item_button { item_button { on_click: m } }

fn word(m: Item) -> string {
    match m {
        .Toggle(id) -> "toggle:${id}",
        .Draft(text) -> "draft:${text}",
        .Flag(on) -> "flag:${on}",
        .Clear -> "clear",
    }
}

fn rebuilt(v: dyn View) -> Item? {
    let first = v.describe().events.first()
    match first {
        a? -> Item.from_site(a.site, a.payload)
        null -> null
    }
}

let draft = Item.Draft("hi")
let a = frame(btn(Item.Toggle(7)).describe())
let b = frame(btn(Item.Toggle(7)).describe())
let c = frame(btn(Item.Toggle(9)).describe())
let plain = frame(btn(Item.Clear).describe())

println("round=${word(rebuilt(btn(Item.Toggle(7))) ?? Item.Clear)}")
println("text=${word(rebuilt(btn(draft)) ?? Item.Clear)}")
println("flag=${word(rebuilt(btn(Item.Flag(true))) ?? Item.Clear)}")
println("none=${Item.Clear.payload() == null}")
println("wrong_shape=${Item.from_site(Item.Toggle(1).site(), draft.payload()) == null}")
println("same_payload=${a == b}")
println("different_payload=${a == c}")
println("payload_widens=${a.length > plain.length}")
