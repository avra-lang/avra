// proves: an event is addressed by the MESSAGE's content-addressed site, so
// the same message resolves wherever its node moved, and two messages never
// collide. No string names an action: the tree carries a typed `Msg`.
use @std.meta.{derive}
use @std.ui.components.{column, text}
use @std.ui.realize.view.{View}
use @std.ui.realize.prim.{prim}
use @std.ui.realize.render.{Node}
use @std.ui.realize.dom.frame.{event_at}
use @std.ui.realize.messages.{Messages}
use @std.ui.style.box.{Box}

@derive(Messages)
enum ToggleMsg {
    Toggle
    Open
}

@derive(View)
@prim(.Button)
component toggle_button {
    ..Box
    on_click: ToggleMsg = ToggleMsg.Toggle
}

fn toggle() -> toggle_button { toggle_button { on_click: ToggleMsg.Toggle } }

fn site_of(v: dyn View) -> int {
    let first = v.describe().events.first()
    match first {
        a? -> a.site
        null -> 0
    }
}

fn message_word(root: Node, site: int) -> string {
    let found = event_at(root, site, 1)
    match found {
        a? -> match ToggleMsg.from_site(a.site) {
            m? -> m.word()
            null -> "none"
        }
        null -> "none"
    }
}

let forward = column { items: [toggle(), text "x"] }
let backward = column { items: [text "x", toggle()] }
println("${message_word(forward.describe(), site_of(toggle()))}")
println("${message_word(backward.describe(), site_of(toggle()))}")
println("${site_of(toggle()) == site_of(toggle_button { on_click: ToggleMsg.Toggle })}")
println(
    "${site_of(toggle_button { on_click: ToggleMsg.Toggle }) != site_of(toggle_button { on_click: ToggleMsg.Open })}",
)
println("${event_at(forward.describe(), site_of(toggle()) + 1, 1) == null}")
