//! A composition that holds a composition: each instance stands on
//! its own, the inner one under the outer's view.
use @std.meta.{derive}
use components.{button, column, text}
use tree.view.{View}
use tests.parts.{counter}

@derive(View)
export component tally(label: string) {
    state taps: int = 0

    fn view() -> column {
        column {
            button "tap ${self.label}" { on press { self.taps = self.taps + 1 } }
            text "${self.label} taps: ${self.taps}"
            counter "${self.label} inner"
        }
    }
}
