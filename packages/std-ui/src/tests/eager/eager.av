//! A composition that WRITES ITS OWN STATE WHILE IT IS DESCRIBED: the
//! write lands, and no paint follows from it.
use @std.meta.{derive}
use components.{text}
use tree.identity.{Stand}
use tree.view.{View}

@derive(View)
export component eager(label: string) {
    ..Stand
    state walks: int = 0

    fn view() -> text {
        self.walks = self.walks + 1
        text "${self.label} walked ${self.walks}"
    }
}
