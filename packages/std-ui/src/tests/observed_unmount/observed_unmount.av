// proves: a view that reads an observation and is then removed from the screen releases it, as one that
// reads another does: with no view left on the feed, its stream is ended
use @std.ui.app.{Async, Fetch, Heard, fetch, fetched}
use @std.ui.components.{button, column, text}
use @std.ui.headless.{headless}
use @std.http_message.message.{Header, Reply, Request}
use @std.time.{ms}

state shown: bool = true

fn words(a: Async<int>) -> string {
    match a {
        .Idle -> "idle",
        .Loading -> "loading",
        .Failed(m) -> "failed ${m}",
        .Ready(n) -> "ready ${n}",
    }
}

fn parsed(r: Reply) -> Result<int, string> { .Ok(r.body.length) }

let rows: Fetch<int> = fetch()

fn view_of(rows: Fetch<int>) -> column {
    if !shown { return column {} }
    column {
        text "${words(rows.state())}"
        button "Load" {
            on press {
                let _ = fetched(rows, Request.get("/rows"), parsed)
            }
        }
    }
}

fn serve(_r: Request) -> Result<Reply, string> {
    .Ok(
        Reply {
            status: 200,
            headers: [
                Header { name: "etag", value: "\"v1\"" },
                Header { name: "avra-reads", value: "Row" },
                Header { name: "avra-stand", value: "1" },
                Header { name: "avra-feed", value: "/feed" },
            ],
            body: "x".bytes(),
        },
    )
}

let screen = headless(() -> view_of(rows))
screen.wired(serve)
screen
    .running(
        () -> {
            let _ = screen.press("Load")
            screen.advance(ms(10))
            println(
                "the view shows ${words(rows.state())} and listens: ${screen.listened("/feed") != null}",
            )
            shown = false
            screen.turn(() -> true)
            println("the view removed, listening: ${screen.listened("/feed") != null}")
            shown = true
            screen.turn(() -> true)
            let _ = screen.press("Load")
            screen.advance(ms(10))
            println("shown and loaded again, listening: ${screen.listened("/feed") != null}")
        },
    )
