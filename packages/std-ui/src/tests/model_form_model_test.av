//! `model_form<T>` over a `@model`'s draft, the create form: an input per
//! field the create is handed and none for the key, the model's own field
//! rules the form's, each refusal the one the database write would name,
//! and what a submit hands over a draft the database stores.
use @std.db.{model}
use @std.db.error.{ModelError, modeled}
use @std.sqlite.{Db}
use @std.validate.{range, length}
use @std.ui.forms.{model_form}
use @std.ui.headless.{Screen, headless}

@model
type Member = {
    id: int = 0,
    @unique @length(min: 3) email: string,
    @range(13, 130) age: int,
    nick: string? = null,
}

fn page(got: Cell<List<MemberDraft>>) -> Screen {
    headless(() -> model_form<MemberDraft> { on submit { m -> got.set(got.get().concat([m])) } })
}

/// Every issue the database write names, as `path rule`.
fn refused_by_insert(m: MemberDraft) -> Result<string, ModelError> {
    let db = modeled(Db.memory())?
    modeled(Member.create_table(db))?
    match m.insert(db) {
        .Ok(_) -> "landed",
        .Err(e) -> [i.path.text() + " " + i.rule for i in e.issues().all].join(", "),
    }
}

/// The handed draft, stored: its key as the database named it.
fn stored(m: MemberDraft) -> Result<int, ModelError> {
    let db = modeled(Db.memory())?
    modeled(Member.create_table(db))?
    (m.insert(db)?).id
}

spec "std/ui model_form over a @model's draft" {
    given "a model whose fields carry rules" {
        then "draws a field per drafted field, and none for the key" {
            page(Cell.new([])).text() == "form\n  list\n    column key=\"email\"\n      field \"email\" value=\"\" placeholder=\"\"\n    column key=\"age\"\n      field \"age\" value=\"\" placeholder=\"\"\n    column key=\"nick\"\n      field \"nick\" value=\"\" placeholder=\"\"\n  button \"Save\" submits"
        }
        then "a refused field shows its rule's words beside it, and nothing is handed" {
            let got: Cell<List<MemberDraft>> = Cell.new([])
            let p = page(got)
            p.fill("email", "ab") &&
                p.fill("age", "9") &&
                p.submit("email") &&
                got.get().is_empty() &&
                p
                    .text()
                    .contains(
                        "field \"email\" value=\"ab\" placeholder=\"\" invalid\n      text \"must be at least 3 characters\"",
                    ) &&
                p
                    .text()
                    .contains(
                        "field \"age\" value=\"9\" placeholder=\"\" invalid\n      text \"must be between 13 and 130\"",
                    )
        }
        then "the rules the form refuses by are the ones the database write refuses by" {
            (refused_by_insert(MemberDraft { email: "ab", age: 9 }) catch _ -> "") == "email length, age range"
        }
        then "a submit hands over a draft the database stores under a key it names" {
            let got: Cell<List<MemberDraft>> = Cell.new([])
            let p = page(got)
            let handed = p.fill("email", "ada@x") && p.fill("age", "36") && p.submit("email")
            handed &&
                got.get().length == 1 &&
                got.get()[0].nick == null &&
                (stored(got.get()[0]) catch _ -> 0) == 1
        }
    }
}
