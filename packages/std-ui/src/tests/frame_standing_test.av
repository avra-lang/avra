//! THE KEEPER OF EACH DIALECT'S SHAPES: the types the code writes in a
//! dialect, held to the shapes that dialect was published with
//! (`frame/standing.av`). Growth crosses; a moved or dropped slot under a
//! dialect already named is refused, by the slot — a moved shape takes a
//! new dialect.
use @std.ui.frame.dialect.{Dialect}
use @std.ui.frame.rows.{FrameType}
use @std.ui.frame.shapes.{held_to, type_lines, types_of_lines}
use @std.ui.frame.standing.{standing}
use @std.ui.frame.tape.{Entry, TapeHead}
use @std.ui.realize.dom.asked.{Asked}
use @std.ui.realize.dom.snapshot.{Snapshot}
use @std.ui.realize.dom.patch.{Patch}
use @std.ui.realize.native.patch.{NativePatch}

/// The types the code writes each dialect's frames in. Every dialect spelled.
fn written(d: Dialect) -> List<FrameType> {
    match d {
        .Dom15 -> [],
        .Dom16 -> Patch.frame_types().concat(Asked.frame_types()),
        .Neutral1 -> NativePatch.frame_types(),
        .Tape1 -> TapeHead.frame_types().concat(Entry.frame_types()),
        .Snapshot1 -> Snapshot.frame_types(),
    }
}

/// The dialects the code writes.
const writes = [Dialect.Dom16, Dialect.Neutral1, Dialect.Tape1, Dialect.Snapshot1]

/// Why the code does not hold `d`'s standing shapes; nothing where it does.
fn unheld(d: Dialect) -> string {
    let stood? = standing.find(it.dialect == d) else { return "`${d.name()}` has no standing shapes" }
    held_to(types_of_lines(stood.shapes), written(d)).why()
}

/// Dom16's standing shapes with one line rewritten.
fn rewritten(from: string, to: string) -> List<FrameType> {
    let stood = standing.find(it.dialect == Dialect.Dom16)!.shapes
    types_of_lines([if l == from { to } else { l } for l in stood])
}

const place_line = "Patch place 3 id:word:NodeId parent:word_or_none:NodeId after:nested:After"

spec "std/ui frame — each dialect's shapes, as published" {
    given "the dialects the code writes" {
        then "each has its shapes standing" { writes.all((d) -> standing.any(it.dialect == d)) }
        then "the code holds each one's: nothing moved, nothing gone" {
            [w for d in writes for w in [unheld(d)] if w != ""].join("; ") == ""
        }
        then "the shapes read back as lines, each the line it was" {
            writes
                .all(
                    (d) -> type_lines(types_of_lines(standing.find(it.dialect == d)!.shapes))
                        .join("\n") == standing.find(it.dialect == d)!.shapes.join("\n"),
                )
        }
    }
    given "a slot that moved under a published dialect" {
        then "is refused, by the slot" {
            let moved = rewritten(
                place_line,
                "Patch place 3 id:word:NodeId after:nested:After parent:word_or_none:NodeId",
            )
            held_to(moved, written(Dialect.Dom16)).why() == "`Patch.place` slot 1 is `after:nested:After` to this reader and `parent:word_or_none:NodeId` to the stream: a moved shape takes a new dialect; `Patch.place` slot 2 is `parent:word_or_none:NodeId` to this reader and `after:nested:After` to the stream: a moved shape takes a new dialect"
        }
        then "and so is a slot the code dropped" {
            let longer = rewritten(place_line, place_line + " gap:word:NodeId")
            held_to(longer, written(Dialect.Dom16)).why() == "`Patch.place` slot 3 is `gap:word:NodeId` to this reader, and the stream carries no slot 3"
        }
    }
    given "a shape that only grew" {
        then "crosses, and says it grew" {
            let shorter = rewritten(
                place_line,
                "Patch place 3 id:word:NodeId parent:word_or_none:NodeId",
            )
            let h = held_to(shorter, written(Dialect.Dom16))
            h.reads() && h.grown
        }
    }
}
