// proves: work a row asks belongs to its row. A row of an unkeyed dynamic list
// is told by order even while it stands alone, so its work is refused and
// said; a keyed row keeps its own across a replace, a prepend and a removal
// before it. Before: a lone unkeyed row's answer landed on the row that took
// its place. eval == native.
use @std.ui.components.{button, item, text}
use @std.ui.headless.{headless}
use @std.ui.app.{later}
use @std.time.{ms}

state rows: List<string> = ["a"]

component pending(label: string) {
    state got: string = "none"
    item {
        button "ask ${self.label}" {
            on press {
                let mine = self.label
                let _ = later(
                    ms(5),
                    () -> {
                        self.got = "answer for ${mine}"
                        true
                    },
                )
            }
        }
        text "${self.label}: ${self.got}"
    }
}

state keyed: bool = false

fn view() -> item {
    if keyed { return item { items: [pending r { key: r } for r in rows] } }
    item { items: [pending r for r in rows] }
}

fn case(name: string, before: List<string>, after: List<string>, by_key: bool = false) {
    rows = before
    keyed = by_key
    let screen = headless(view)
    screen
        .running(
            () -> {
                let _ = screen.press("ask ${before.last()!}")
                let refused = screen.shown.app.warnings().any(it.contains("does not outlive"))
                let _ = screen
                    .turn(
                        () -> {
                            rows = after
                            true
                        },
                    )
                screen.advance(ms(10))
                let said = [l.trim() for l in screen.text().split("\n") if l.trim().starts_with("text")]
                println("${name}: ${said.join(", ")} | refused: ${refused}")
            },
        )
}

case("one, then replaced", ["a"], ["z"])
case("one, then one prepended", ["a"], ["z", "a"])
case("one, then one appended", ["a"], ["a", "z"])
case("two, last pressed, first removed", ["a", "b"], ["b"])
case("keyed: one, then replaced", ["a"], ["z"], by_key: true)
case("keyed: one, then one prepended", ["a"], ["z", "a"], by_key: true)
case("keyed: two, last pressed, first removed", ["a", "b"], ["b"], by_key: true)
