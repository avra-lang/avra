// proves: work a row asks belongs to its row, and a row drawn by a COMPOSITION is
// told by order as a primitive is: among unkeyed siblings one site made, the work
// is refused and said, never landed on the row that later holds its place; a keyed
// row keeps its own across a removal before it. The rows are made through a
// helper, so this is the runtime's half — what no literal in the loop shows the
// compiler. eval == native.
use @std.ui.components.{button, item, text}
use @std.ui.headless.{headless}
use @std.ui.app.{later}
use @std.time.{ms}

state rows: List<string> = []
state keyed: bool = false

component pending(label: string) {
    state got: string = "none"
    item {
        button "ask ${self.label}" {
            on press {
                let mine = self.label
                let _ = later(
                    ms(5),
                    () -> {
                        self.got = "answer for ${mine}"
                        true
                    },
                )
            }
        }
        text "${self.label}: ${self.got}"
    }
}

/// A row, made where the loop cannot show it.
fn row(r: string) -> pending {
    if keyed { return pending r { key: r } }
    pending r
}

fn view() -> item { item { items: [row(r) for r in rows] } }

fn case(
    name: string,
    before: List<string>,
    pressed: string,
    after: List<string>,
    by_key: bool = false,
) {
    rows = before
    keyed = by_key
    let screen = headless(view)
    screen
        .running(
            () -> {
                let _ = screen.press("ask ${pressed}")
                let refused = screen.shown.app.warnings().any(it.contains("does not outlive"))
                let _ = screen
                    .turn(
                        () -> {
                            rows = after
                            true
                        },
                    )
                screen.advance(ms(10))
                let said = [l.trim() for l in screen.text().split("\n") if l.trim().starts_with("text")]
                println("${name}: ${said.join(", ")} | refused: ${refused}")
            },
        )
}

case("two, last pressed, first removed", ["a", "b"], "b", ["b"])
case("two, first pressed, last removed", ["a", "b"], "a", ["a"])
case("keyed: two, last pressed, first removed", ["a", "b"], "b", ["b"], by_key: true)
case(
    "keyed: two, first pressed, then one prepended",
    ["a", "b"],
    "a",
    ["z", "a", "b"],
    by_key: true,
)
