// proves: a view component declared in a program's ENTRY file has a row in the
// seat table. The table is gathered over the closure of the library it lives in,
// so a program that depends on @std/ui is gathered as a dependent; the View
// derive exports every seat row, as a collection across packages gathers
// exported declarations only.
use @std.meta.{derive}
use @std.ui.style.box.{Box}
use @std.ui.tree.prim.{prim}
use @std.ui.tree.seats.{seat_rows, seat_named, row_at}
use @std.ui.tree.node.{Prim}
use @std.ui.tree.view.{View, tree_of}
use @std.ui.components.{button}

@derive(View)
@prim(.Button)
export component knob(@attr(.Label) label: string) {
    ..Box
    @host(web: .Mousedown, terminal: .Enter) on press
}

let own = row_at(seat_named("knob", "press"))
println("${own.owner}.${own.event} web=${own.web!.word()} prim=${own.prim == Prim.Button}")
println("beside the library's: ${seat_rows.any(it.row.owner == "button")}")
println("heard: ${tree_of(knob "k" { on press { println("pressed") } }).events.length}")
