//! `tree/shows.av` — a value that shows itself wherever it is listed.
use tree.view.{View}

/// How a value shows itself: a list of `T` draws each `T` through its
/// `Shows`.
export trait Shows {
    fn view() -> dyn View
}

/// Values listed as views, each through its `Shows`.
export fn rows(shown: List<dyn Shows>) -> List<dyn View> { [s.view() for s in shown] }
