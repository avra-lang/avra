//! `tree/sites.av` — a READING is one text whose words read state. The
//! compiler writes it beside the node it belongs to, for a text it can place
//! exactly: the `id` is the literal's own site, `words` recomputes the whole
//! text from the state as it stands, and `cells` are the state cells that
//! text reads, fixed for the reading's life. A text the compiler cannot place
//! carries none, and the full paint speaks for it. The page that watches a
//! reading holds what it observes (the runtime takes its own reference to an
//! observed cell), so a cell cannot die under it.
use @std.meta.{Site, Cells, Words}

/// One text whose words read state.
export type Reading = { id: Site, words: Words, cells: Cells }

/// What a text with no hole in it says again: nothing.
export fn no_words() -> Words { Words(() -> "") }

/// The readings a text carries: its one reading when it reads any cell,
/// none when it reads none (a text of constants, or one the compiler could
/// not place).
export fn sighted(id: Site, words: Words, cells: Cells) -> List<Reading> {
    if cells.is_empty() { [] } else { [Reading { id: id, words: words, cells: cells }] }
}
