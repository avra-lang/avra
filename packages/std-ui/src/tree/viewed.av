//! `tree/viewed.av` — THE VIEWS A PACKAGE DECLARES. The View derive writes a row beside every
//! component it makes a view of (`@viewed`), a primitive or a composition, so a collect over the
//! mark is the compiler's own list of them, in the scope it names: `views` is this package's, and a
//! program gathers its own the same way (`@viewed in package`, or `in closure` for every package it
//! reaches).
use @std.meta.{Named, Marker}

/// The mark the View derive puts on a view's row.
export fn viewed(_d: Named) -> Marker { Marker {} }

/// A component the View derive made a view of: its name, and the module that declares it.
export type ViewRow = { name: string, module: string }

/// A gathered row. The collection holds rows and nothing else.
export type Viewed = { row: ViewRow }

/// Every view this package declares, ordered by module, then name.
export collect views: List<Viewed> = @viewed in package as Viewed { row: it } by it.module, it.name
