//! `tree/bindings.av` — WHICH BINDING A KEY MEETS. A binding on a node is live
//! while the node, or anything it holds, has the focus: the key goes to the
//! nearest, from the focused node out to the root, the way an event bubbles
//! up a page. The chain is read off the tree by the focused node's seat, the
//! number the walk gives it.
use tree.chord.{Binding, Chord}
use tree.lists.{flatten}
use tree.node.{Node}

/// How many nodes `n` and what it holds open in the walk.
fn size(n: Node) -> int { 1 + n.children.fold(0, (a: int, c: Node) -> a + size(c)) }

/// The nodes from the node at walk seat `seat` below `n` up to `n`, `at`
/// being the seat of `n`: the chain of what holds the focus, nearest first.
/// Empty when no node stands at the seat.
fn chain(n: Node, at: int, seat: int) -> List<Node> {
    if seat == at { return [n] }
    if seat < at || seat >= at + size(n) { return [] }
    let sizes = [size(c) for c in n.children]
    let starts = [at + 1 + sizes.slice(0, j).fold(0, (a: int, k: int) -> a + k) for j in 0..sizes.length]
    let inside = [j for j, c in n.children if seat >= starts[j] && seat < starts[j] + sizes[j]]
        .first()
    let j? = inside else { return [] }
    chain(n.children[j], starts[j], seat).concat([n])
}

/// The bindings live while the node at `seat` has the focus, nearest first;
/// the root's alone when `seat` is none.
export fn live(root: Node, seat: int?) -> List<Binding> {
    flatten([n.box.keys for n in chain(root, 0, seat ?? 0)])
}

/// The binding the key `c` meets, or none: the nearest live one that names it.
export fn meeting(root: Node, seat: int?, c: Chord) -> Binding? {
    live(root, seat).find(it.chord.text() == c.text())
}

/// Whether any binding live while the node at `seat` has the focus names `c`.
export fn names(root: Node, seat: int?, c: Chord) -> bool { meeting(root, seat, c) != null }
