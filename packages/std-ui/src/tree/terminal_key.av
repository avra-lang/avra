//! `tree/terminal_key.av` — the terminal's keys, beside the web's events
//! (`dom_event.av`): the vocabulary `@host(terminal: …)` is checked against.
//! They live in `tree/` because the neutral tree names them, and importing
//! anything under `terminal/` loads the terminal itself, which a web page
//! must not carry.

/// What a paste was: its text, whole, or — the terminal's limit passed — only
/// how many octets were let go.
export enum Paste {
    Text(text: string)
    TooLarge(bytes: int)
}

/// A key as the loop reads it.
export enum Key {
    Next
    Back
    Enter
    Erase
    Char(text: string)
    End
    PageUp
    PageDown
    Top
    Bottom
    Escape
    /// A key with Ctrl or Alt held, by its character — only a terminal that
    /// speaks the kitty keyboard protocol can say so.
    Chord(text: string, ctrl: bool, alt: bool, shift: bool)
    /// The primary button pressed over the cell at `x`, `y` (from zero).
    Click(x: int, y: int, shift: bool, alt: bool, ctrl: bool)
    /// The wheel turned over a cell; `down` is toward the end of a list.
    Wheel(x: int, y: int, down: bool)
    /// Text the user pasted, whole: one event however long, never keys.
    Paste(paste: Paste)
    /// The terminal window gained or lost the user's focus.
    FocusIn
    FocusOut
    /// The terminal answered the kitty keyboard query with its flags.
    Reports(flags: int)
    /// A key primitive's own chord, whatever its `chord` says: the marker `@host(terminal: …)` names
    /// for a shortcut. The loop never reads it; the key's seat fires when the chord pressed is the
    /// key's.
    Shortcut
}

impl Key {
    /// Whether `pressed` is the key this one names, as a seat's `@host(terminal:
    /// …)` names it: a seat names a key that carries nothing, so a key with a
    /// payload names none.
    fn names(pressed: Key) -> bool {
        match self {
            .Next -> pressed is .Next,
            .Back -> pressed is .Back,
            .Enter -> pressed is .Enter,
            .Erase -> pressed is .Erase,
            .End -> pressed is .End,
            .PageUp -> pressed is .PageUp,
            .PageDown -> pressed is .PageDown,
            .Top -> pressed is .Top,
            .Bottom -> pressed is .Bottom,
            .Escape -> pressed is .Escape,
            .FocusIn -> pressed is .FocusIn,
            .FocusOut -> pressed is .FocusOut,
            .Shortcut -> pressed is .Shortcut,
            .Char(_) or .Chord(_, _, _, _) or .Click(_, _, _, _, _) or .Wheel(_, _, _) or .Paste(_) or .Reports(_) -> false,
        }
    }
}
