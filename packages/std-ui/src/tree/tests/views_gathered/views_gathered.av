// proves: the View derive writes a row beside every view this package declares, a primitive and a
// composition alike, so `views` lists them all: 25 primitives, `form_inputs`, `model_form`,
// `model_table` and the private `shape_inputs`.
use @std.ui.tree.viewed.{views}

"${views.length}: ${views.map(it.row.name).join(" ")}"
