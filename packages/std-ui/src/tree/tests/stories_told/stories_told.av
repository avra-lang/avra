// proves: `@story` derives one case per member from the base its fn answers — a required text
// empty, long and unbroken, a flag flipped, a place given, an optional shown, a list emptied, each
// variant of a plain enum but the base's — and `@case` adds one named case; a member `fixed` names
// derives none (a key's chord), and `stories` gathers every story this package tells.
use @std.ui.components.{button}
use @std.ui.tree.story.{Story, stories}

fn told() -> List<Story> { [t.tell() for t in stories] }

fn names(owner: string) -> string { [c.name for s in told() if s.owner == owner for c in s.cases].join(", ") }

[
    "button: ${names("button")}",
    "dialog: ${names("dialog")}",
    "alert: ${names("alert")}",
    "key: ${names("key")}",
    "${told().length} stories, ${[s.cases.length for s in told()].fold(0, (a, n) -> a + n)} cases",
]
    .join("\n")
