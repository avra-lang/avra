// proves: one walk becomes a neutral update GRAPH — ids, placement, words
// and events — with no target's currency (tag, class, byte op, line) in it.
use @std.ui.tree.node.{Node, Prim, Attribute, EventKind, Action, Handler}
use @std.ui.tree.plan.{Op, plan}
use @std.ui.style.box.{Box}

fn parent_word(parent: int?) -> string {
    match parent {
        p? -> "${p}"
        null -> "-"
    }
}

fn op_word(op: Op) -> string {
    match op {
        .Mount(m) -> "M ${m.seat} <${parent_word(m.parent)} #${m.index} ${m.prim.word()}",
        .Words(id, t) -> if t == "" { "W ${id}" } else { "W ${id} ${t}" },
        .Event(id, a) -> "E ${id} ${a.kind.word()}",
    }
}

/// The words an op says for `seat`, when it is that seat's.
fn words_of(op: Op, seat: int) -> string? {
    match op {
        .Words(who, text) -> if who == seat { text } else { null },
        .Mount(_) or .Event(_, _) -> null,
    }
}

/// A node's words, read back from the op that carries them — absent for a
/// seat the walk never reached.
fn words_at(ops: List<Op>, seat: int) -> string? { ops.find_map(words_of(it, seat)) }

fn nothing() {}

fn leaf(prim: Prim, words: string) -> Node {
    Node { prim: prim, attrs: [Attribute.Label(words)], box: Box {}, children: [] }
}

let button = Node {
    prim: .Button,
    attrs: [Attribute.Label("Add")],
    box: Box {},
    children: [],
    events: [Action { kind: .Press, handler: Handler.Nothing(nothing) }],
}

let root = Node {
    prim: .Column,
    attrs: [],
    box: Box {},
    children: [leaf(.Heading, "Tasks"), Node { prim: .Column, attrs: [], box: Box {}, children: [button] }],
}

let ops = plan(root)
println(ops.map(op_word).join("\n"))
println(words_at(ops, 3) ?? "none")
println(words_at(ops, 9) ?? "none")
println("${ops.length}")
