//! `tree/outline.av` — a screen as text no target owns: what each node
//! is, its words and what its attributes say. The readable twin of a
//! tree, for a test and for `explain`.
use tree.controls.{shows_content}
use tree.identity.{readable}
use tree.node.{Node, Attribute, masked_among}
use @std.text.{codepoint_count, repeat}
use @std.assets.{Picture}

/// A text between quotes, on one line: a quote, a backslash and a line
/// break are written as their escapes, so no value reads as the end of
/// its own quotes or as a line of the screen.
fn quoted(s: string) -> string { "\"${readable(s).replace("\"", "\\\"")}\"" }

/// A state a node is in, by its word — nothing while it is not.
fn state(word: string, on: bool) -> List<string> { if on { [word] } else { [] } }

/// What a picture says: where it is from, and the size it draws.
fn picture_notes(p: Picture) -> List<string> {
    match p {
        .Bundled(name, width, height, _, _, _) -> ["picture=${name}", "${width}×${height}"],
        .Remote(url, width, height) -> ["src=${quoted(url.text())}", "${width}×${height}"],
    }
}

/// What one attribute tells a reader beyond the node's own words — a
/// masked control's value as one mark per character, never the text.
/// ONE exhaustive match, so a new attribute is a decision here.
fn noted(a: Attribute, masked: bool) -> List<string> {
    match a {
        .Text(_) or .Label(_) -> [],
        .Level(rank) -> ["level=${rank}"],
        .Value(t) -> ["value=${quoted(if masked { repeat("•", codepoint_count(t)) } else { t })}"],
        .Amount(n) -> ["amount=${n}"],
        .Placeholder(t) -> ["placeholder=${quoted(t)}"],
        .Source(p) -> picture_notes(p),
        .Alt(t) -> ["alt=${quoted(t)}"],
        .Decorative(on) -> state("decorative", on),
        .Href(u) -> ["href=${quoted(u.text())}"],
        .Min(n) -> ["min=${n}"],
        .Max(n) -> ["max=${n}"],
        .Disabled(on) -> state("disabled", on),
        .Checked(on) -> state("checked", on),
        .Selected(on) -> state("selected", on),
        .Open(on) -> state("open", on),
        .Invalid(on) -> state("invalid", on),
        .Loading(on) -> state("loading", on),
        .Urgency(how) -> [how.word()],
        .Title(t) -> ["title=${quoted(t)}"],
        .Name(t) -> ["name=${quoted(t)}"],
        .Submits(on) -> state("submits", on),
        .Masked(on) -> state("masked", on),
        .Skipped(_, rows, extent) -> ["skipped=${rows}x${extent}"],
        .Placed(at, of, reveal) -> ["row=${at}/${of}"].concat(if reveal { ["reveal"] } else { [] }),
    }
}

/// What a node's attributes tell a reader, masked as the node is.
fn notes(attrs: List<Attribute>) -> List<string> {
    let masked = masked_among(attrs)
    [w for a in attrs for w in noted(a, masked)]
}

/// A node's own line: what it is, its words, its key, what it says.
fn line(n: Node) -> string {
    let words = n.words()
    let named: List<string> = if words == "" { [] } else { [quoted(words)] }
    let keyed: List<string> = match n.box.key {
        key? -> ["key=${quoted(key)}"]
        null -> []
    }
    [n.prim.word()].concat(named).concat(keyed).concat(notes(n.attrs)).join(" ")
}

fn lines(n: Node, indent: string) -> List<string> {
    let own = ["${indent}${line(n)}"]
    if !shows_content(n) { return own }
    own.concat([l for k in n.children for l in lines(k, "${indent}  ")])
}

/// The screen `root` draws, as a reader finds it: one line a node, its
/// words and what its attributes say, what it holds indented under it.
/// What is not on the screen is left out.
export fn outline(root: Node) -> string { lines(root, "").join("\n") }
