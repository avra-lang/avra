//! `tree/story_text.av` — THE WORDS A STORY'S DERIVED CASES SET. One file of fixed data: a
//! required text is drawn empty, long (it wraps) and unbroken (one token, no spaces, which only
//! a box that holds its overflow survives); a text with a default, a place and an optional are
//! drawn with the sample.
use @std.assets.{Picture}

/// About two hundred characters of ordinary words, so a line has to wrap.
export const long_text: string = "Every component is drawn here in each state its own members imply, under each dial the reader's settings turn, so a change that moves any of them is seen before it ships and named by its case."

/// One token of about sixty letters, no space and no hyphen, so nothing can wrap it.
export const unbroken_text: string = "Pneumonoultramicroscopicsilicovolcanoconiosissupercalifragilistic"

/// Ordinary words, for a text a case gives where the base gave none.
export const sample_text: string = "Ada Lovelace"

/// A picture of a ticked box, for the stories of what draws one.
export asset story_picture: Picture = "art/story.svg"
