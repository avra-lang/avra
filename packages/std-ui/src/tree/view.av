//! `view.av` — `View` is what a component implements: `describe`, THE
//! WALK that makes a tree, handed where it stands (`tree/standing.av`).
//! `@derive(View)` WRITES that impl. A component that names a primitive
//! (`@prim`) is one, drawn from what each member SAYS it projects to:
//!
//!     @attr(.Label) label: string     an attribute of the node
//!     @attr(.Value) value: string?    one the node names only when given
//!     @children items: List<dyn View> the node's children
//!     @style(color) ink: Ink          a token laid over the node's style
//!     on input(typed: string)         an event the node speaks
//!     ..Box                           the shared box, read field for field
//!
//! A primitive may keep ONE KIND OF PLACE: a `state` member its own gesture moves.
//!
//!     initial: string = ""                read by the place's default: what it starts from
//!     @attr(.Value) state value: string = self.initial
//!     @over(value) shown: string? = null   what the node shows where it is given
//!     @sets(value) on input(typed: string) what the gesture says is written first
//!
//! Given a place, the instance shares it; given none, the instance first built where it stands
//! is kept, as a composition's is. The node shows `shown ?? value`, so a target the gesture moved
//! is drawn back to what the program shows.
//!
//! NO MEANING IS READ FROM A MEMBER'S NAME: a member that says nothing is
//! refused where it stands. Every word a member says is checked against
//! the library's own declaration — a primitive against `Prim`, an
//! attribute against `Attribute`, a style against `Style`, what an event
//! says against `Handler` — so each fact has the one table its type
//! already is, and a word or a type that does not fit is refused at the
//! member, never inside this file. An event names no target: each target's
//! own table says what delivers a primitive's event there.
//!
//! A component that names none is a COMPOSITION: its BODY is the views
//! it is made of, drawn in place under its own parent; it projects
//! nothing of its own, and its `state` members are places each INSTANCE
//! owns — kept by where the instance stands, alive while a paint reaches
//! it. The author writes no `@derive` and no spread: `@composes` says a
//! component with a body is a `View` and carries a `Stand`.
//!
//! A derive's template text resolves in THIS file, so every foreign name
//! it writes is a static `quote`; a generated hole resolves in the
//! annotated file, so fields are read as `self.<field>`.
use @std.meta.{
    Key as NodeKey,
    Type,
    Field,
    Param,
    Variant,
    Mark,
    Kind,
    Directive,
    Declared,
    Diagnostic,
    Code,
    Stmts,
    list_of,
    literal,
    refuse_as_at,
    type_exported,
    type_named,
    composes,
    beside,
    declares,
    placed,
    rehomed,
    ctx_entry,
    as_code,
    int_node,
}
use @std.text.{parse_int}
use tree.node.{Node, Prim, Attribute, Action, Handler, Stamp}
use tree.seats.{SeatRow, seat, seat_named}
// LICENSED modules.unused_import: `sighted` is named by GENERATED code (the node a primitive derives).
use tree.sites.{sighted}
use tree.identity.{Stand, Step, stand_of, stepped}
use tree.standing.{Standing, Kept, standing, kept, stood}
use style.box.{Box}
use style.theme.{theme}
use compose.{gathered}

/// A component that projects to a neutral `Node`. A COMPONENT WITH A
/// BODY IS A VIEW: the compiler derives this trait over it, and it
/// carries a `Stand` — its key, the site it was written at — with
/// nothing written. A view is drawn under the contexts in force where
/// it is PLACED — the statement of the body that yields it — not where
/// it was built.
@composes(Stand)
@placed
export trait View {
    /// What this view says of where it stands among its siblings.
    fn stand() -> Stand

    /// What this view draws under its parent, made standing at `at`: a
    /// primitive its one node, a composition the nodes of what it is
    /// made of — none, one or several, in place.
    fn describe(at: Standing) -> List<Node>

    static fn derive(t: Type) -> Declared {
        let said? = vocabulary() else { return Declared { made: [], problems: [unread(t)] } }
        let word? = prim_word(t) else { return composition(said, t) }
        if t.body != null { return unmade(t, [primitive_body(t)]) }
        let parts = [said.part(t, f) for f in t.fields]
        let problems = [d for p in parts for d in p.problems].concat(said.unfit(t, word, parts))
        if !problems.is_empty() { return unmade(t, problems) }
        let node = quote {
            Node {
                prim: Prim.${word},
                attrs: ${attrs_code(parts)},
                box: ${said.box_code(parts)},
                children: ${held_by([c for p in parts for c in p.children])},
                events: ${joined([c for p in parts for c in p.events])},
                sites: ${sites_code(t)},
                theme: drawn,
            }
        }
        let rows = [said.seat_row(t, f) for f in t.fields if f.says != null]
        if !t.fields.any(it.state && !it.prop) {
            return Declared {
                made: [
                    beside(
                        t,
                        quote {
                            impl View for ${t} {
                                fn stand() -> Stand { stand_of(self.key, self.site) }

                                fn describe(at: Standing) -> List<Node> {
                                    let was = at.entry.get()
                                    let drawn = drawn_in(at)
                                    let made = [${node}]
                                    at.entry.set(was)
                                    made
                                }
                            }
                        },
                    ),
                ]
                    .concat(rows),
            }
        }
        // A primitive that keeps a place stands as a composition does: the instance first built
        // where it stands is kept and handed this paint's props, so a gesture's write to its own
        // `state` lasts to the next paint.
        let seat = unwritable(t, "kept")
        let drawn = unwritable(t, "node")
        let me = said.standing_instance(t, seat, said.primitive_props(t))
        Declared {
            made: [
                declares(
                    seat,
                    t.at,
                    quote { once fn ${seat}() -> Kept<${t}> { kept(${literal(t.name)}) } },
                ),
                beside(
                    t,
                    quote {
                        impl ${t} {
                            fn ${drawn}(at: Standing) -> Node {
                                let was = at.entry.get()
                                let drawn = drawn_in(at)
                                let made = ${node}
                                at.entry.set(was)
                                made
                            }
                        }
                    },
                ),
                beside(
                    t,
                    quote {
                        impl View for ${t} {
                            fn stand() -> Stand { stand_of(self.key, self.site) }

                            fn describe(at: Standing) -> List<Node> {
                                let me = ${me}
                                [me.${drawn}(at)]
                            }
                        }
                    },
                ),
            ]
                .concat(rows),
        }
    }

    static fn marks(t: Type) -> List<string> { [attr_mark, children_mark, style_mark, over_mark, sets_mark] }
}

/// A view that was refused: the impl that stands in for it, and why.
fn unmade(t: Type, problems: List<Diagnostic>) -> Declared { Declared { made: [refused_view(t)], problems: problems } }

/// What a refused view is given: a `describe` that draws nothing, so the
/// refusal is the one thing said and no user of the view is blamed for a
/// method that was never made.
fn refused_view(t: Type) -> Directive {
    beside(
        t,
        quote {
            impl View for ${t} {
                fn stand() -> Stand { Stand {} }

                fn describe(at: Standing) -> List<Node> { [] }
            }
        },
    )
}

/// The theme the node standing at `at` is drawn in, where it is another than the one the node drawn
/// above it was: one compare of the frame's entry for `ctx theme`, the theme read only where it
/// moved. The walk's cell holds the entry from now, so what the node draws under it compares with
/// it; the node's describe gives the cell back once its own subtree is drawn.
export fn drawn_in(at: Standing) -> Stamp? {
    let entry = ctx_entry(ctx.theme)
    if entry == at.entry.get() { return null }
    at.entry.set(entry)
    Stamp { theme: ctx.theme, entry: entry }
}

/// A view's tree standing ALONE: no paint came before it and none
/// follows, so every instance in it is new.
/// A page that persists paints through `Live.paint_view`.
export fn tree_of(v: dyn View) -> Node { rooted(v.describe(standing())) }

/// A TREE HAS ONE ROOT. What a view drew, as a tree: its one node — or,
/// for a composition that drew none or several where nothing holds
/// them, a column of them.
export fn rooted(drawn: List<Node>) -> Node {
    if drawn.length == 1 { return drawn[0] }
    // The column stands where its first node was drawn; a node beside it drawn under the same set
    // carries nothing of its own.
    let stamp = drawn.first()?.theme
    let under = [if n.theme?.entry == stamp?.entry { n with { theme: null } } else { n } for n in drawn]
    Node { prim: Prim.Column, attrs: [], box: Box {}, children: under, theme: stamp }
}

/// What `items` draw under the node standing at `at`, each standing
/// under it at its own step.
export fn described(at: Standing, items: List<dyn View>) -> List<Node> { each_described(at, items, true).flatten() }

/// What a COMPOSITION standing at `at` draws: what `items` draw, IN
/// PLACE — under the composition's own parent, with no node of its own
/// around them. Each node is stepped through the composition, so two
/// instances' nodes are told apart beside each other; and the FIRST
/// node it draws wears the composition's `key` where it wears none of
/// its own, so a keyed row is found on a page by its key.
export fn made_of(at: Standing, items: List<dyn View>, key: NodeKey?) -> List<Node> {
    let drawn = each_described(at, items, false).flatten()
    [drawn_through(n, at.step.get(), if j == 0 { key } else { null }, at.by_order.get()) for j, n in drawn]
}

/// A node as a composition drew it: stepped through `via` where it was
/// drawn through nothing yet, wearing `key` where it wears none, and told by
/// order when the composition is.
fn drawn_through(n: Node, via: Step?, key: NodeKey?, by_order: bool) -> Node {
    n with { box: n.box with { via: n.box.via ?? via, key: n.box.key ?? key }, drawn_by_order: n.drawn_by_order || by_order }
}

/// What each of `items` draws, standing under `at` at its own step.
fn each_described(at: Standing, items: List<dyn View>, drawn: bool) -> List<List<Node>> {
    let said = [v.stand() for v in items]
    let told = stepped(said)
    let stands = at.children(told.steps, told.shared, drawn)
    [v.describe(stands[j]) for j, v in items]
}

// ── compositions ────────────────────────────────────────────────

/// The impls a composition is given: `composed`, its body gathered —
/// the statements the author wrote, with `self` the instance — and its
/// `View`: what the body made, drawn in place under where it stands,
/// and — when it holds state — the instance that stands there kept and
/// handed this paint's props.
fn composition(said: Vocabulary, t: Type) -> Declared {
    let body? = t.body else { return unmade(t, [no_body(t)]) }
    let problems = composition_problems(t)
    if !problems.is_empty() { return unmade(t, problems) }
    let seat = unwritable(t, "kept")
    let composed = unwritable(t, "made")
    let stateful = t.fields.any(it.state)
    let me = if stateful { said.standing_instance(t, seat, said.prop_names(t)) } else { quote { self } }
    let made = [
        beside(
            t,
            quote {
                impl ${t} {
                    fn ${composed}() -> List<dyn View> {
                        let made = gathered {
                            ${body}
                        }
                        made.items
                    }
                }
            },
        ),
        beside(
            t,
            quote {
                impl View for ${t} {
                    fn stand() -> Stand { stand_of(self.key, self.site) }

                    fn describe(at: Standing) -> List<Node> {
                        let me = ${me}
                        made_of(at, me.${composed}(), self.key)
                    }
                }
            },
        ),
    ]
    if !stateful { return Declared { made: made } }
    Declared {
        made: [
            declares(
                seat,
                t.at,
                quote { once fn ${seat}() -> Kept<${t}> { kept(${literal(t.name)}) } },
            ),
        ]
            .concat(made),
    }
}

/// A name the derive mints beside a component and no program can
/// write: the component's own, a `$`, and what it is for.
fn unwritable(t: Type, role: string) -> string { "${t.name}\$${role}" }

impl Vocabulary {
    /// The instance that stands: the one kept, with this paint's props —
    /// `props` — laid over it — a copy shares its `state` cells — else this one.
    fn standing_instance(t: Type, seat: string, props: List<string>) -> Code {
        mut carried = quote { held }
        for name in props { carried = quote { ${carried} with { ${name}: self.${name} } } }
        let synced: List<Stmts> = [quote { if held.${p} != self.${p} { held.${p} = self.${p} } } for p in self.cell_props(t)]
        quote {
            match stood(${seat}(), at, self) {
                held? -> {
                    ${synced}
                    ${carried}
                }
                null -> self
            }
        }
    }

    /// A prop the compiler made a cell: the PARENT writes it, at each paint.
    fn prop_cell(f: Field) -> bool { f.state && f.prop }

    /// A place the author keeps: a `state` written in the body. A prop cell is
    /// no such place — it is the parent's, so a primitive is told it, never
    /// left to keep it.
    fn kept_state(f: Field) -> bool { f.state && !f.prop }

    /// The props the compiler made cells of: a later instance writes each into
    /// the one that stands, only where its value moved.
    fn cell_props(t: Type) -> List<string> { [f.name for f in t.fields if self.prop_cell(f)] }

    /// The members a later instance hands the one that stands: every one
    /// that is no `state`, and where it says it stands.
    fn prop_names(t: Type) -> List<string> { [f.name for f in t.fields if !f.state].concat([f.name for f in self.stand]) }

    /// What a later instance of a primitive hands the one that stands: its own props, and every
    /// field its spreads place — the box's and what it says its words with — each this paint's.
    fn primitive_props(t: Type) -> List<string> {
        let boxed = if t.spreads.any(is_box(it)) { [f.name for f in self.box] } else { [] }
        let sighted = if t.spreads.any(is_sighted(it)) { self.sighted } else { [] }
        self.prop_names(t).concat(boxed).concat(sighted)
    }
}

/// What a composition gets wrong: a box of its own, or a member marked
/// as a primitive's is.
fn composition_problems(t: Type) -> List<Diagnostic> {
    let boxed = if t.spreads.any(is_box(it)) { [boxed_composition(t)] } else { [] }
    boxed
        .concat([marked_composition(f, m) for f in t.fields for m in f.marks if m.name != slot_mark])
}

/// The language's mark for the field an instance's bare statements fill: the component's, never a
/// projection.
const slot_mark = "default"

/// The library's own declarations a member's words are checked against.
type Vocabulary = {
    prims: List<Variant>,
    attributes: List<Variant>,
    box: List<Field>,
    style: List<Field>,
    stand: List<Field>,
    sighted: List<string>,
}

/// The modules that declare the vocabulary, as `Type.module` spells them.
const tree_module = "@std.ui.tree"
const style_module = "@std.ui.style"

/// The shared box's own name, and the name of what a view says where
/// it stands with.
const box_name = "Box"
const stand_name = "Stand"

/// The vocabulary as the library declares it. Absent only when a
/// declaration this file imports is not where it is read — the derive's
/// own defect.
fn vocabulary() -> Vocabulary? {
    let prim? = type_exported(tree_module, "Prim") else { return null }
    let attribute? = type_exported(tree_module, "Attribute") else { return null }
    let box? = type_exported(style_module, box_name) else { return null }
    let style? = type_exported(style_module, "Style") else { return null }
    let stand? = type_exported(tree_module, stand_name) else { return null }
    Vocabulary {
        prims: prim.variants,
        attributes: attribute.variants,
        box: box.fields,
        style: style.fields,
        stand: stand.fields,
        sighted: sighted_fields,
    }
}

/// What one member of a primitive projects to, as the code that reads
/// it: the attributes it gives the node, the children, the events it
/// binds and the style fields it is laid over — or why it cannot project.
/// `named` holds the attributes an optional member gives, each as the
/// code of a run: the one attribute when the member is given, else none.
/// One member fills one of them; a derive reads each across every member.
type Part = {
    attrs: List<Code> = [],
    named: List<Code> = [],
    children: List<Code> = [],
    events: List<Code> = [],
    styles: List<Laid> = [],
    problems: List<Diagnostic> = [],
    said_attrs: List<Saying> = [],
    said_styles: List<Saying> = [],
}

/// A member laid over one field of the node's style.
type Laid = { over: string, member: Field }

/// One thing a member says of the node, and the mark that says it.
type Saying = { word: string, content: bool, at: Mark }

/// A member that cannot project, and why.
fn refused(why: Diagnostic) -> Part { Part { problems: [why] } }

impl Vocabulary {
    /// What `f` projects to: its event, or the one thing its mark says.
    /// A primitive's `state` is a place its own gesture moves: refused where no event of it
    /// `@sets` it, since a place nothing writes is a value spelled as a place. A member marked
    /// `@over` is what the node shows in its place where it is given, and projects nothing itself.
    fn part(t: Type, f: Field) -> Part {
        if self.kept_state(f) && !set_by_any(t, f.name) { return refused(stateful_primitive(f)) }
        let over? = marks_of(f, over_mark).first() else {
            let says? = f.says else { return self.marked(t, f) }
            let marked? = f.marks.find(it.name != sets_mark) else { return self.event(t, f, says) }
            return refused(marked_event(f, marked))
        }
        over_part(t, f, over)
    }

    /// The one thing a member's marks say. Each mark is read by its own
    /// word, so a member saying two things shows as two parts.
    fn marked(t: Type, f: Field) -> Part {
        let said = [self.attribute(t, f, m) for m in marks_of(f, attr_mark)]
            .concat([children(f, m) for m in marks_of(f, children_mark)])
            .concat([self.styled(f, m) for m in marks_of(f, style_mark)])
        if said.length > 1 { return refused(says_twice(f)) }
        let one? = said.first() else {
            // A member that projects nothing stands where another member's default reads it — the
            // place `state value: string = self.initial` starts from.
            if f.marks.is_empty() && f.says == null && !f.state && read_by_default(t, f.name) { return Part {} }
            return refused(says_nothing(f))
        }
        one
    }

    /// `@attr(.Label) label` → the code `Attribute.Label(self.label)`.
    /// AN OPTIONAL MEMBER NAMES ITS ATTRIBUTE ONLY WHEN GIVEN: a node
    /// whose instance wrote no `value` carries no `Value`, so a target
    /// can tell what the program draws from what it leaves alone.
    fn attribute(t: Type, f: Field, m: Mark) -> Part {
        let word? = m.args.first() else { return refused(unnamed_mark(m, "@attr(.Label)")) }
        let v? = self.attributes.find(it.name == word) else {
            return refused(no_attribute(m, word, [a.name for a in self.attributes]))
        }
        let carried? = v.fields.first() else { return refused(bare_attribute(m, v.name)) }
        if carried.kind.spelled() != filled_by(held_kind(f)).spelled() { return refused(attribute_misfit(m, v.name, carried.kind, f)) }
        let said = [Saying { word: v.name, content: is_content(v), at: m }]
        // What the node shows of a kept place: the member over it where that is given, else the
        // place — so a target is held to what the program shows, whatever the gesture wrote.
        let shown? = shown_over(t, f.name) else {
            if carried.kind.spelled() == held_kind(f).spelled() {
                return Part {
                    attrs: [quote { Attribute.${v.name}(self.${f.name}) }],
                    said_attrs: said,
                }
            }
            return self.optional_attribute(f, v, said)
        }
        Part {
            attrs: [quote { Attribute.${v.name}(self.${shown.name} ?? self.${f.name}) }],
            said_attrs: said,
        }
    }

    /// An optional member's attribute: named only where the member is given.
    fn optional_attribute(f: Field, v: Variant, said: List<Saying>) -> Part {
        Part {
            named: [
                quote {
                    match self.${f.name} {
                        written? -> [Attribute.${v.name}(written)]
                        null -> []
                    }
                },
            ],
            said_attrs: said,
        }
    }

    /// `@style(color) ink` → `ink` laid over the node's `style.color`.
    /// A style field is optional, and the member fills it.
    fn styled(f: Field, m: Mark) -> Part {
        let word? = m.args.first() else { return refused(unnamed_mark(m, "@style(color)")) }
        let over? = self.style.find(it.name == word) else {
            return refused(no_style(m, word, [s.name for s in self.style]))
        }
        if filled_by(over.kind).spelled() != f.kind.spelled() { return refused(style_misfit(m, over, f)) }
        Part {
            styles: [Laid { over: word, member: f }],
            said_styles: [Saying { word: word, content: false, at: m }],
        }
    }

    /// `on press` → the action the node binds while an instance hears
    /// it. ABSENCE IS THE OPTION'S OWN NULL: a handler left unset binds
    /// no action, so a control nobody hears emits nothing. The handler
    /// runs under the contexts the node is drawn under, wherever its
    /// caller built it.
    fn event(t: Type, f: Field, says: List<Param>) -> Part {
        let sets? = marks_of(f, sets_mark).first() else { return self.heard(t, f, says) }
        let into? = sets.args.first() else { return refused(unnamed_mark(sets, "@sets(value)")) }
        let place? = kept_named(t, into) else { return refused(sets_no_place(f, sets, into)) }
        let wrote? = written_by(says, place, sets) else { return refused(sets_misfit(f, sets, place, says)) }
        let fn_value? = written_then_heard(f, says, into, wrote) else { return refused(unsayable(f, says)) }
        let handler? = hearing(says, quote { rehomed(${fn_value}) }) else { return refused(unsayable(f, says)) }
        Part {
            events: [
                quote { [Action { seat: seat_named(${literal(t.name)}, ${literal(f.name)}), handler: ${handler} }] },
            ],
        }
    }

    /// An event the caller alone hears: bound only where a handler is given.
    fn heard(t: Type, f: Field, says: List<Param>) -> Part {
        let handler? = hearing(says, quote { rehomed(bound) }) else { return refused(unsayable(f, says)) }
        Part {
            events: [
                quote {
                    match self.${f.name} {
                        bound? -> [Action { seat: seat_named(${literal(t.name)}, ${literal(f.name)}), handler: ${handler} }]
                        null -> []
                    }
                },
            ],
        }
    }

    /// The const that declares an event seat, beside its component: the
    /// owner and event it is, and its primitive — never what a target
    /// calls it, which is that target's own table's to say. Named by owner
    /// and event, so the seats are ordered by the one name that tells them
    /// apart.
    fn seat_row(t: Type, f: Field) -> Directive {
        let named = "${t.name}\$${f.name}"
        let row = quote {
            SeatRow { owner: ${literal(t.name)}, event: ${literal(f.name)}, prim: Prim.${prim_word(t) ?? ""} }
        }
        declares(
            named,
            t.at,
            quote {
                @seat
                export const ${named}: SeatRow = ${row}
            },
        )
    }

    /// The node's box: every field of `Box` read off the component, its
    /// style with each styling member laid over it.
    fn box_code(parts: List<Part>) -> Code {
        mut style = quote { self.style }
        for l in [l for p in parts for l in p.styles] { style = quote { ${style} with { ${l.over}: self.${l.member.name} } } }
        let rest = [quote { Box { ${f.name}: self.${f.name} } } for f in self.box.concat(self.stand) if f.name != style_field]
        quote { Box { style: ${style}, ..${rest} } }
    }

    /// What the primitive as a WHOLE gets wrong: a word `Prim` does not
    /// have, no shared box, and anything two members say twice — a
    /// second saying would be dropped, or drawn over the first.
    fn unfit(t: Type, word: string, parts: List<Part>) -> List<Diagnostic> {
        self.prim_problem(t, word).concat(unboxed(t)).concat(said_twice(parts))
    }

    fn prim_problem(t: Type, word: string) -> List<Diagnostic> {
        if self.prims.any(it.name == word) { [] } else { [not_a_prim(t, word, [p.name for p in self.prims])] }
    }
}

/// The marks a member says its projection with.
const attr_mark = "attr"
const children_mark = "children"
const style_mark = "style"

/// The annotation that names a view's primitive.
const prim_mark = "prim"

/// The mark that says an attribute is its node's own words.
const facet_mark = "facet"
const content_facet = "content"

/// A member's marks of one word.
fn marks_of(f: Field, word: string) -> List<Mark> { [m for m in f.marks if m.name == word] }

/// The box's field a styling member is laid over.
const style_field = "style"

/// What a member holds: a `state` member's value, which the record keeps in a Cell.
fn held_kind(f: Field) -> Kind {
    if !f.state { return f.kind }
    match f.kind { .Cell(inner) -> inner, rest -> f.kind }
}

/// What fills an optional field: the type it may hold.
fn filled_by(k: Kind) -> Kind {
    match k { .Opt(inner) -> inner, rest -> k }
}

/// `@children items` → each child's own `describe`.
fn children(f: Field, m: Mark) -> Part {
    match f.kind {
        .List(.Dyn(_)) -> Part { children: [quote { self.${f.name} }] },
        rest -> refused(not_children(m, f)),
    }
}

/// The marks that tie a primitive's gesture to its place: `@sets(value)` on an event writes what
/// it says into the `state` member `value` (`@sets(open, false)` writes `false` for an event that
/// says nothing), and `@over(value)` on a member makes it what the node shows where it is given.
const sets_mark = "sets"
const over_mark = "over"

/// Whether some member of `t` reads `name` in its default (`self.name`): what the default makes,
/// and so what an instance that keeps its own place starts from.
fn read_by_default(t: Type, name: string) -> bool {
    for f in t.fields {
        let code? = f.default else { continue }
        if reads_member(code.text(), name) { return true }
    }
    false
}

/// Whether the code `text` reads the member `name` of `self` — `self.name`, the name whole.
fn reads_member(text: string, name: string) -> bool {
    let read = "self.${name}"
    let at = text.index_of(read)
    if at < 0 { return false }
    let after = at + read.length
    if after >= text.length { return true }
    let next = text.substring(after, after + 1)
    !(next == "_" || is_word_char(next)) || reads_member(text.substring(after, text.length), name)
}

/// Whether one character can continue a name.
fn is_word_char(c: string) -> bool { "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789".contains(c) }

/// Whether an event of `t` sets the place `name`.
fn set_by_any(t: Type, name: string) -> bool { t.fields.any(sets_member(it) == name) }

/// The member of `t` shown over the place `name`, where one is.
fn shown_over(t: Type, name: string) -> Field? { t.fields.find(over_member(it) == name) }

/// The kept place of `t` named `name`: a `state` member no parent writes.
fn kept_named(t: Type, name: string) -> Field? { t.fields.find(it.name == name && it.state && !it.prop) }

/// The place an event writes, as its `@sets` names it; none for a member that is no event.
fn sets_member(f: Field) -> string? {
    if f.says == null { return null }
    marks_of(f, sets_mark).first()?.args?.first()
}

/// The place a member is shown over, as its `@over` names it.
fn over_member(f: Field) -> string? { marks_of(f, over_mark).first()?.args?.first() }

/// What a gesture writes into `place`: what it says, or the one flag its mark names for an
/// event that says nothing — absent where that does not fit the place.
fn written_by(says: List<Param>, place: Field, sets: Mark) -> Code? {
    if says.is_empty() {
        if sets.args.length != 2 { return null }
        return constant_of(sets.args[1], held_kind(place))
    }
    if sets.args.length != 1 ||
        says.length != 1 ||
        says[0].kind.spelled() != held_kind(place).spelled() { return null }
    quote { said }
}

/// The constant `word` names, as code of the place's kind `k`: a flag for a `bool` place, a whole
/// number for an `int` one — absent where it fits neither.
fn constant_of(word: string, k: Kind) -> Code? {
    match k {
        .Bool -> match word { "true" -> quote { true }, "false" -> quote { false }, _ -> null },
        .Int -> {
            let n? = parse_int(word) else { return null }
            as_code(int_node(n))
        },
        rest -> null,
    }
}

/// The fn a gesture runs: the place written first, then the caller's handler where one is given,
/// told what was said — so a handler reads the place as the gesture left it.
fn written_then_heard(f: Field, says: List<Param>, into: string, wrote: Code) -> Code? {
    if says.is_empty() {
        return quote {
            () -> {
                self.${into} = ${wrote}
                let heard = self.${f.name}
                if heard != null { heard!() }
            }
        }
    }
    match says[0].kind {
        .Str -> quote {
            (said: string) -> {
                self.${into} = ${wrote}
                let heard = self.${f.name}
                if heard != null { heard!(said) }
            }
        },
        .Bool -> quote {
            (said: bool) -> {
                self.${into} = ${wrote}
                let heard = self.${f.name}
                if heard != null { heard!(said) }
            }
        },
        .Int -> quote {
            (said: int) -> {
                self.${into} = ${wrote}
                let heard = self.${f.name}
                if heard != null { heard!(said) }
            }
        },
        .Float or .Ptr or .Void or .List(_) or .Cell(_) or .Map(_, _) or .Opt(_) or .Result(_, _) or .Named(_, _) or .Fn(_, _) or .Dyn(_) or .Var(_) or .Unspelled(_) or .Bytes -> null,
    }
}

/// A member shown over a kept place: optional of the place's own type, no place itself, and
/// saying nothing else — it projects only through the place's attribute.
fn over_part(t: Type, f: Field, over: Mark) -> Part {
    let into? = over.args.first() else { return refused(unnamed_mark(over, "@over(value)")) }
    let place? = kept_named(t, into) else { return refused(over_no_place(f, over, into)) }
    if f.state || f.kind.spelled() != Kind.Opt(held_kind(place)).spelled() { return refused(over_misfit(f, over, place)) }
    let first? = shown_over(t, into) else { return refused(over_no_place(f, over, into)) }
    if first.name != f.name { return refused(over_twice(f, over, first, into)) }
    let other? = f.marks.find(it.name != over_mark) else { return Part {} }
    refused(over_marked(f, other))
}

/// The `Handler` arm that hears what an event says: ONE arm per thing a
/// control can say, and absent for anything else.
fn hearing(says: List<Param>, bound: Code) -> Code? {
    if says.is_empty() { return quote { Handler.Nothing(${bound}) } }
    if says.length > 1 { return null }
    match says[0].kind {
        .Str -> quote { Handler.Text(${bound}) },
        .Bool -> quote { Handler.Flag(${bound}) },
        .Int -> quote { Handler.Number(${bound}) },
        .Float or .Ptr or .Void or .List(_) or .Cell(_) or .Map(_, _) or .Opt(_) or .Result(_, _) or .Named(_, _) or .Fn(_, _) or .Dyn(_) or .Var(_) or .Unspelled(_) or .Bytes -> null,
    }
}

/// What a node holds: its members' views, described under where the
/// node stands — nothing for a node no member gives children.
fn held_by(members: List<Code>) -> Code {
    if members.is_empty() { return quote { [] } }
    quote { described(at, ${joined(members)}) }
}

/// A node's attributes in the order its members stand: one list, or —
/// where an optional member may name none — the runs each member gives.
fn attrs_code(parts: List<Part>) -> Code {
    if parts.all(it.named.is_empty()) { return list_of([c for p in parts for c in p.attrs]) }
    joined([run for p in parts for run in [list_of([c]) for c in p.attrs].concat(p.named)])
}

/// Several runs as one list — none is the empty list, one is itself.
fn joined(runs: List<Code>) -> Code {
    if runs.is_empty() { return quote { [] } }
    if runs.length == 1 { return runs[0] }
    quote { [${..runs}].flatten() }
}

/// The readings a primitive carries: what its spread `Sighted` holds, the
/// closure that says its words again and the cells they read, made one
/// reading when the cells are any. A primitive that spreads none has none.
fn sites_code(t: Type) -> Code {
    if !t.spreads.any(is_sighted(it)) { return quote { [] } }
    quote { sighted(self.site, self.words, self.reads) }
}

/// What a primitive that says text spreads in, and the fields it places: what `Sighted` is in
/// `tree/sites.av`, named here since reading the tree's own exports from its derive asks the
/// derive of itself.
const sighted_name = "Sighted"
const sighted_fields: List<string> = ["words", "reads"]

/// The mark the compiler gives a composition's head prop it made a cell of.

/// The primitive a component named with `@prim` — `@prim(.Button)` says
/// `Button` — absent when it named none.
fn prim_word(t: Type) -> string? { t.annotations.find(it.name == prim_mark)?.args?.first() }

/// A primitive spreads the shared box in: the node's box is read off it
/// field for field.
fn unboxed(t: Type) -> List<Diagnostic> {
    if t.spreads.any(is_box(it)) { [] } else { [no_box(t)] }
}

/// Whether a spread, as its own file names it, is the shared box.
fn is_box(written: string) -> bool { spreads(written, box_name, style_module) }

/// Whether a spread, as its own file names it, is what a primitive that says
/// text carries.
fn is_sighted(written: string) -> bool { spreads(written, sighted_name, tree_module) }

/// Whether a spread, as its own file names it, is `module`'s `name`.
fn spreads(written: string, name: string, module: string) -> bool {
    let spread? = type_named(written) else { return false }
    spread.name == name && spread.module == module
}

/// Whether an attribute is its node's own words — its `@facet(content)`.
fn is_content(v: Variant) -> bool { v.marks.any(it.name == facet_mark && it.args.first() == content_facet) }

/// Each thing a second member says again: an attribute, a style field,
/// or the node's own words — refused where the second one stands.
fn said_twice(parts: List<Part>) -> List<Diagnostic> {
    let attrs = [s for p in parts for s in p.said_attrs]
    let styles = [s for p in parts for s in p.said_styles]
    [attribute_twice(s) for j, s in attrs if attrs.slice(0, j).any(it.word == s.word)]
        .concat(
            [words_twice(s) for j, s in attrs if s.content && attrs.slice(0, j).any(it.content && it.word != s.word)],
        )
        .concat([style_twice(s) for j, s in styles if styles.slice(0, j).any(it.word == s.word)])
}

// ── voices ──────────────────────────────────────────────────────

fn unread(t: Type) -> Diagnostic {
    refuse_as_at(
        "defect",
        t.at,
        "defect: `@derive(View)` could not read the library's own vocabulary over `${t.name}`",
        "`Prim`, `Attribute`, `Box`, `Style`, `Stand` and `Sighted` are read by their modules' names — one moved",
    )
}

fn says_nothing(f: Field) -> Diagnostic {
    refuse_as_at(
        "unprojected",
        f.at,
        "a primitive says what each member projects to, and `${f.name}` says nothing",
        "mark it `@attr(.Label)`, `@children` or `@style(color)`, declare it an event — `on ${f.name}` — or read it in a place's default — `state value: T = self.${f.name}`",
    )
}

fn says_twice(f: Field) -> Diagnostic {
    refuse_as_at(
        "two-marks",
        f.at,
        "a member projects to one thing, and `${f.name}` says more than one",
        "keep one of `@attr`, `@children` and `@style`",
    )
}

fn marked_event(f: Field, m: Mark) -> Diagnostic {
    refuse_as_at(
        "marked-event",
        m.at,
        "an event is heard by its own word, and `${f.name}` is marked `@${m.name}` too",
        "drop the mark — `on ${f.name}`",
    )
}

fn unnamed_mark(m: Mark, form: string) -> Diagnostic {
    refuse_as_at(
        "unnamed-mark",
        m.at,
        "`@${m.name}` names what it marks its member as, and this one names nothing",
        "`${form}`",
    )
}

fn no_attribute(m: Mark, word: string, known: List<string>) -> Diagnostic {
    refuse_as_at(
        "attribute",
        m.at,
        "`${word}` is no attribute of a node",
        "the attributes are ${ticked(known)}",
    )
}

fn bare_attribute(m: Mark, attribute: string) -> Diagnostic {
    refuse_as_at(
        "attribute-misfit",
        m.at,
        "`${attribute}` carries nothing a member could fill",
        null,
    )
}

fn attribute_misfit(m: Mark, attribute: string, carried: Kind, f: Field) -> Diagnostic {
    refuse_as_at(
        "attribute-misfit",
        m.at,
        "`${attribute}` carries `${carried.spelled()}`, and `${f.name}` is `${f.kind.spelled()}`",
        null,
    )
}

fn attribute_twice(s: Saying) -> Diagnostic {
    refuse_as_at(
        "said-twice",
        s.at.at,
        "a node carries an attribute once, and `${s.word}` is already another member's",
        "mark one member `@attr(.${s.word})`",
    )
}

fn words_twice(s: Saying) -> Diagnostic {
    refuse_as_at(
        "said-twice",
        s.at.at,
        "a node says its own words once, and another member already says them — `${s.word}` would be lost",
        "keep one member as the node's words",
    )
}

fn no_style(m: Mark, word: string, known: List<string>) -> Diagnostic {
    refuse_as_at(
        "style",
        m.at,
        "`${word}` is no field of a node's style",
        "the fields are ${ticked(known)}",
    )
}

fn style_misfit(m: Mark, over: Field, f: Field) -> Diagnostic {
    refuse_as_at(
        "style-misfit",
        m.at,
        "a style's `${over.name}` is `${filled_by(over.kind).spelled()}`, and `${f.name}` is `${f.kind.spelled()}`",
        null,
    )
}

fn style_twice(s: Saying) -> Diagnostic {
    refuse_as_at(
        "said-twice",
        s.at.at,
        "a node's style holds `${s.word}` once, and another member already fills it",
        "mark one member `@style(${s.word})`",
    )
}

fn not_children(m: Mark, f: Field) -> Diagnostic {
    refuse_as_at(
        "children",
        m.at,
        "a node's children are views, and `${f.name}` is `${f.kind.spelled()}`",
        "`@children` marks a `List<dyn View>`",
    )
}

fn unsayable(f: Field, says: List<Param>) -> Diagnostic {
    refuse_as_at(
        "unsayable",
        f.at,
        "a control says nothing, text, a flag or a number, and `${f.name}` says `${["${s.name}: ${s.ty}" for s in says].join(", ")}`",
        "say one `string`, `bool` or `int`",
    )
}

fn stateful_primitive(f: Field) -> Diagnostic {
    refuse_as_at(
        "stateful-primitive",
        f.at,
        "a primitive keeps a place its own gesture moves, and no event of it sets `${f.name}`",
        "mark the event that moves it — `@sets(${f.name}) on change(…)` — or keep the state in the composition that uses the primitive",
    )
}

fn sets_no_place(f: Field, m: Mark, into: string) -> Diagnostic {
    refuse_as_at(
        "sets",
        m.at,
        "`${f.name}` sets `${into}`, and `${into}` is no `state` member of this primitive",
        "name the primitive's own place — `state ${into}: T = …` beside it",
    )
}

fn sets_misfit(f: Field, m: Mark, place: Field, says: List<Param>) -> Diagnostic {
    if says.is_empty() && m.args.length == 2 {
        return refuse_as_at(
            "sets",
            m.at,
            "`${f.name}` sets `${place.name}` to `${m.args[1]}`, and `${place.name}` is `${held_kind(place).spelled()}`",
            "set it to a value of its type — a `bool` place takes `true` or `false`, an `int` one a whole number",
        )
    }
    let told = if says.is_empty() { "nothing" } else { ["`${s.ty}`" for s in says].join(", ") }
    refuse_as_at(
        "sets",
        m.at,
        "`${f.name}` says ${told}, and the place it sets, `${place.name}`, is `${held_kind(place).spelled()}`",
        "an event sets a place of the type it says — or, saying nothing, a flag it names: `@sets(${place.name}, false)`",
    )
}

fn over_no_place(f: Field, m: Mark, into: string) -> Diagnostic {
    refuse_as_at(
        "over",
        m.at,
        "`${f.name}` is marked `@${m.name}(${into})`, and `${into}` is no `state` member of this primitive",
        "name the primitive's own place — `state ${into}: T = …` beside it",
    )
}

fn over_misfit(f: Field, m: Mark, place: Field) -> Diagnostic {
    let mark = state_mark(f)
    refuse_as_at(
        "over",
        m.at,
        "what is shown over `${place.name}` is told each paint and may be left out, and `${f.name}` is `${mark}${f.kind.spelled()}`",
        "declare it `${f.name}: ${held_kind(place).spelled()}? = null`",
    )
}

/// How a member's own `state` is spelled before its type, in a refusal's words.
fn state_mark(f: Field) -> string { if f.state { "state " } else { "" } }

fn over_twice(f: Field, m: Mark, first: Field, into: string) -> Diagnostic {
    refuse_as_at(
        "over",
        m.at,
        "`${into}` is shown under one member, and `${first.name}` is already shown over it",
        "drop `@over(${into})` from `${f.name}` — a place shows one thing told over it",
    )
}

fn over_marked(f: Field, m: Mark) -> Diagnostic {
    refuse_as_at(
        "over",
        m.at,
        "`${f.name}` is tied to its place and says nothing of its own, and is marked `@${m.name}` too",
        "drop the mark — the place says what the node holds",
    )
}

fn no_body(t: Type) -> Diagnostic {
    refuse_as_at(
        "prim",
        t.at,
        "a view is a primitive or is made of views, and `${t.name}` is neither",
        "name the primitive it is — `@prim(.Text)` above it — or write in its body the views it is made of",
    )
}

fn primitive_body(t: Type) -> Diagnostic {
    refuse_as_at(
        "primitive-body",
        t.at,
        "a primitive is drawn by its target, and `${t.name}` holds a body of its own",
        "drop `@prim` and `@derive(View)` — a component made of views needs neither — or drop the body",
    )
}

fn boxed_composition(t: Type) -> Diagnostic {
    refuse_as_at(
        "boxed-composition",
        t.at,
        "a composition wears its view's box, and `${t.name}` spreads one of its own",
        "drop the spread — where a composition stands is carried for it — or name the primitive it is with `@prim`",
    )
}

fn marked_composition(f: Field, m: Mark) -> Diagnostic {
    refuse_as_at(
        "marked-composition",
        m.at,
        "a composition projects nothing of its own, and `${f.name}` is marked `@${m.name}`",
        "its body says what it is made of — drop the mark, or name the primitive it is with `@prim`",
    )
}

fn no_box(t: Type) -> Diagnostic {
    refuse_as_at(
        "box",
        t.at,
        "a view carries the shared box, and `${t.name}` spreads none",
        "spread it in — `..Box`",
    )
}

fn not_a_prim(t: Type, word: string, known: List<string>) -> Diagnostic {
    refuse_as_at(
        "not-a-prim",
        t.annotations.find(it.name == prim_mark)?.at ?? t.at,
        "`${word}` is no primitive a target draws",
        "the primitives are ${ticked(known)}",
    )
}

/// Words as a diagnostic lists them.
fn ticked(words: List<string>) -> string { ["`${w}`" for w in words].join(", ") }
