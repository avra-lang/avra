//! `view.av` — `View` is what a component implements: `describe`, THE
//! WALK that makes a tree, handed where it stands (`tree/standing.av`).
//! `@derive(View)` WRITES that impl. A component that names a primitive
//! (`@prim`) is one, drawn from what each member SAYS it projects to:
//!
//!     @attr(.Label) label: string     an attribute of the node
//!     @children items: List<dyn View> the node's children
//!     @style(color) tone: Tone        a token laid over the node's style
//!     on input(typed: string)         an event the node speaks
//!     ..Box                           the shared box, read field for field
//!
//! NO MEANING IS READ FROM A MEMBER'S NAME: a member that says nothing is
//! refused where it stands. Every word a member says is checked against
//! the library's own declaration — a primitive against `Prim`, an
//! attribute against `Attribute`, a style against `Style`, an event
//! against `EventKind`'s words, what it says against `Handler` — so each
//! fact has the one table its type already is, and a word or a type that
//! does not fit is refused at the member, never inside this file.
//!
//! A component that names none is a COMPOSITION: `fn view()` answers
//! what it is made of, it projects nothing of its own, and its `state`
//! members are places each INSTANCE owns — kept by where the instance
//! stands, alive while a paint reaches it. `..Stand` gives it a key.
//!
//! A derive's template text resolves in THIS file, so every foreign name
//! it writes is a static `quote`; a generated hole resolves in the
//! annotated file, so fields are read as `self.<field>`.
use @std.meta.{
    Type,
    Field,
    Param,
    Variant,
    Mark,
    Kind,
    Directive,
    Declared,
    Diagnostic,
    Code,
    list_of,
    refuse_as_at,
    type_exported,
    type_named,
}
use tree.node.{Node, Prim, Attribute, EventKind, Action, Handler}
use tree.lists.{flatten}
use tree.identity.{Step, steps}
use tree.standing.{Standing, Kept, standing, kept, stood}
use style.box.{Box}

/// A component that projects to a neutral `Node`.
export trait View {
    /// The key that tells this view from its siblings, when it has one.
    fn key() -> string?

    /// This view's tree, made standing at `at`.
    fn describe(at: Standing) -> Node

    static fn derive(t: Type) -> Declared {
        let said? = vocabulary() else { return Declared { made: [], problems: [unread(t)] } }
        let word? = prim_word(t) else { return composition(t) }
        let parts = [said.part(f) for f in t.fields]
        let problems = [d for p in parts for d in p.problems].concat(said.unfit(t, word, parts))
        if !problems.is_empty() { return unmade(t, problems) }
        let node = quote {
            Node {
                prim: Prim.${word},
                attrs: ${list_of([c for p in parts for c in p.attrs])},
                box: ${said.box_code(parts)},
                children: ${held_by([c for p in parts for c in p.children])},
                events: ${joined([c for p in parts for c in p.events])},
            }
        }
        Declared {
            made: [
                Directive {
                    twin: "",
                    name: t.name,
                    at: t.at,
                    source: quote {
                        impl View for ${t} {
                            fn key() -> string? { self.key }

                            fn describe(at: Standing) -> Node { ${node} }
                        }
                    },
                },
            ],
        }
    }

    static fn marks(t: Type) -> List<string> { [attr_mark, children_mark, style_mark] }
}

/// A view that was refused: the impl that stands in for it, and why.
fn unmade(t: Type, problems: List<Diagnostic>) -> Declared { Declared { made: [refused_view(t)], problems: problems } }

/// What a refused view is given: a `describe` that draws nothing, so the
/// refusal is the one thing said and no user of the view is blamed for a
/// method that was never made.
fn refused_view(t: Type) -> Directive {
    Directive {
        twin: "",
        name: t.name,
        at: t.at,
        source: quote {
            impl View for ${t} {
                fn key() -> string? { null }

                fn describe(at: Standing) -> Node { Node { prim: Prim.Text, attrs: [], box: Box {}, children: [] } }
            }
        },
    }
}

/// A view's tree standing ALONE: no paint came before it and none
/// follows, so every instance in it is new.
export fn tree_of(v: dyn View) -> Node { v.describe(standing()) }

/// What `items` describe, each standing under `at` at its own step.
export fn described(at: Standing, items: List<dyn View>) -> List<Node> {
    let stands = at.children([s.spelled() for s in steps([v.key() for v in items])])
    [v.describe(stands[j]) for j, v in items]
}

/// Where a composition's view stands: a step of its own under the
/// composition's, so a view that is itself a composition never shares
/// its standing.
export fn composed(at: Standing) -> Standing { at.child(Step.Part("view").spelled()) }

/// A composition's tree: its view's, wearing the composition's key —
/// the instance is told from its siblings, never its view's root.
export fn rooted(n: Node, key: string?) -> Node { n with { box: n.box with { key: key } } }

// ── compositions ────────────────────────────────────────────────

/// The impl a composition is given: its view described under its own
/// standing, and — when it holds state — the instance that stands
/// there kept, handed this paint's props.
fn composition(t: Type) -> Declared {
    let problems = composition_problems(t)
    if !problems.is_empty() { return unmade(t, problems) }
    let key = if keyed(t) { quote { self.key } } else { quote { null } }
    let seat = "${t.name}_kept"
    let stateful = t.fields.any(it.state)
    let me = if stateful { standing_instance(t, seat) } else { quote { self } }
    let made = Directive {
        twin: "",
        name: t.name,
        at: t.at,
        source: quote {
            impl View for ${t} {
                fn key() -> string? { ${key} }

                fn describe(at: Standing) -> Node {
                    let me = ${me}
                    rooted(me.view().describe(composed(at)), ${key})
                }
            }
        },
    }
    if !stateful { return Declared { made: [made] } }
    Declared {
        made: [
            Directive {
                twin: "",
                name: seat,
                at: t.at,
                source: quote { once fn ${seat}() -> Kept<${t}> { kept() } },
            },
            made,
        ],
    }
}

/// The instance that stands: the one kept, with this paint's props laid
/// over it — a copy shares its `state` cells — else this one.
fn standing_instance(t: Type, seat: string) -> Code {
    mut carried = quote { held }
    for name in prop_names(t) { carried = quote { ${carried} with { ${name}: self.${name} } } }
    quote {
        match stood(${seat}(), at, self) {
            held? -> ${carried}
            null -> self
        }
    }
}

/// The members a later instance hands the one that stands: every one
/// that is no `state`, and its key.
fn prop_names(t: Type) -> List<string> {
    let own = [f.name for f in t.fields if !f.state]
    if keyed(t) { own.concat([f.name for f in stand_fields()]) } else { own }
}

/// What `Stand` declares, as the library reads its own declaration.
fn stand_fields() -> List<Field> { type_exported(tree_module, stand_name)?.fields ?? [] }

/// Whether a composition spreads `Stand` in — it has a key.
fn keyed(t: Type) -> bool { t.spreads.any(spreads(it, stand_name, tree_module)) }

/// What a composition gets wrong: no view, a box of its own, or a
/// member marked as a primitive's is.
fn composition_problems(t: Type) -> List<Diagnostic> {
    let viewless = if t.fns.contains(view_fn) { [] } else { [no_view(t)] }
    let boxed = if t.spreads.any(is_box(it)) { [boxed_composition(t)] } else { [] }
    viewless.concat(boxed).concat([marked_composition(f, m) for f in t.fields for m in f.marks])
}

/// The fn a composition says what it is made of with.
const view_fn = "view"

/// The library's own declarations a member's words are checked against.
type Vocabulary = {
    prims: List<Variant>,
    attributes: List<Variant>,
    kinds: List<Variant>,
    box: List<Field>,
    style: List<Field>,
}

/// The modules that declare the vocabulary, as `Type.module` spells them.
const tree_module = "@std.ui.tree"
const style_module = "@std.ui.style"

/// The shared box's own name, and the name of what gives a composition
/// its key.
const box_name = "Box"
const stand_name = "Stand"

/// The vocabulary as the library declares it. Absent only when a
/// declaration this file imports is not where it is read — the derive's
/// own defect.
fn vocabulary() -> Vocabulary? {
    let prim? = type_exported(tree_module, "Prim") else { return null }
    let attribute? = type_exported(tree_module, "Attribute") else { return null }
    let kind? = type_exported(tree_module, "EventKind") else { return null }
    let box? = type_exported(style_module, box_name) else { return null }
    let style? = type_exported(style_module, "Style") else { return null }
    Vocabulary {
        prims: prim.variants,
        attributes: attribute.variants,
        kinds: kind.variants,
        box: box.fields,
        style: style.fields,
    }
}

/// What one member of a primitive projects to, as the code that reads
/// it: the attributes it gives the node, the children, the events it
/// binds and the style fields it is laid over — or why it cannot project.
/// One member fills one of them; a derive reads each across every member.
type Part = {
    attrs: List<Code> = [],
    children: List<Code> = [],
    events: List<Code> = [],
    styles: List<Laid> = [],
    problems: List<Diagnostic> = [],
    said_attrs: List<Saying> = [],
    said_styles: List<Saying> = [],
}

/// A member laid over one field of the node's style.
type Laid = { over: string, member: Field }

/// One thing a member says of the node, and the mark that says it.
type Saying = { word: string, content: bool, at: Mark }

/// A member that cannot project, and why.
fn refused(why: Diagnostic) -> Part { Part { problems: [why] } }

impl Vocabulary {
    /// What `f` projects to: its event, or the one thing its mark says.
    fn part(f: Field) -> Part {
        if f.state { return refused(stateful_primitive(f)) }
        let says? = f.says else { return self.marked(f) }
        let marked? = f.marks.first() else { return self.event(f, says) }
        refused(marked_event(f, marked))
    }

    /// The one thing a member's marks say. Each mark is read by its own
    /// word, so a member saying two things shows as two parts.
    fn marked(f: Field) -> Part {
        let said = [self.attribute(f, m) for m in marks_of(f, attr_mark)]
            .concat([children(f, m) for m in marks_of(f, children_mark)])
            .concat([self.styled(f, m) for m in marks_of(f, style_mark)])
        if said.length > 1 { return refused(says_twice(f)) }
        said.first() ?? refused(says_nothing(f))
    }

    /// `@attr(.Label) label` → the code `Attribute.Label(self.label)`.
    fn attribute(f: Field, m: Mark) -> Part {
        let word? = m.args.first() else { return refused(unnamed_mark(m, "@attr(.Label)")) }
        let v? = self.attributes.find(it.name == word) else {
            return refused(no_attribute(m, word, [a.name for a in self.attributes]))
        }
        let carried? = v.fields.first() else { return refused(bare_attribute(m, v.name)) }
        if carried.kind.spelled() != f.kind.spelled() { return refused(attribute_misfit(m, v.name, carried.kind, f)) }
        Part {
            attrs: [quote { Attribute.${v.name}(self.${f.name}) }],
            said_attrs: [Saying { word: v.name, content: is_content(v), at: m }],
        }
    }

    /// `@style(color) tone` → `tone` laid over the node's `style.color`.
    /// A style field is optional, and the member fills it.
    fn styled(f: Field, m: Mark) -> Part {
        let word? = m.args.first() else { return refused(unnamed_mark(m, "@style(color)")) }
        let over? = self.style.find(it.name == word) else {
            return refused(no_style(m, word, [s.name for s in self.style]))
        }
        if filled_by(over.kind).spelled() != f.kind.spelled() { return refused(style_misfit(m, over, f)) }
        Part {
            styles: [Laid { over: word, member: f }],
            said_styles: [Saying { word: word, content: false, at: m }],
        }
    }

    /// `on press` → the action the node binds while an instance hears
    /// it. ABSENCE IS THE OPTION'S OWN NULL: a handler left unset binds
    /// no action, so a control nobody hears emits nothing.
    fn event(f: Field, says: List<Param>) -> Part {
        let kind? = self.kinds.find(word_of(it) == f.name) else {
            return refused(no_event(f, [word_of(k) for k in self.kinds]))
        }
        let handler? = hearing(says, quote { bound }) else { return refused(unsayable(f, says)) }
        Part {
            events: [
                quote {
                    match self.${f.name} {
                        bound? -> [Action { kind: EventKind.${kind.name}, handler: ${handler} }]
                        null -> []
                    }
                },
            ],
        }
    }

    /// The node's box: every field of `Box` read off the component, its
    /// style with each styling member laid over it.
    fn box_code(parts: List<Part>) -> Code {
        mut style = quote { self.style }
        for l in [l for p in parts for l in p.styles] { style = quote { ${style} with { ${l.over}: self.${l.member.name} } } }
        let rest = [quote { Box { ${f.name}: self.${f.name} } } for f in self.box if f.name != style_field]
        quote { Box { style: ${style}, ..${rest} } }
    }

    /// What the primitive as a WHOLE gets wrong: a word `Prim` does not
    /// have, no shared box, and anything two members say twice — a
    /// second saying would be dropped, or drawn over the first.
    fn unfit(t: Type, word: string, parts: List<Part>) -> List<Diagnostic> {
        self.prim_problem(t, word).concat(unboxed(t)).concat(said_twice(parts))
    }

    fn prim_problem(t: Type, word: string) -> List<Diagnostic> {
        if self.prims.any(it.name == word) { [] } else { [not_a_prim(t, word, [p.name for p in self.prims])] }
    }
}

/// The marks a member says its projection with.
const attr_mark = "attr"
const children_mark = "children"
const style_mark = "style"

/// The annotation that names a view's primitive, and the mark that gives
/// an event kind its word.
const prim_mark = "prim"
const word_mark = "word"

/// The mark that says an attribute is its node's own words.
const facet_mark = "facet"
const content_facet = "content"

/// A member's marks of one word.
fn marks_of(f: Field, word: string) -> List<Mark> { [m for m in f.marks if m.name == word] }

/// The box's field a styling member is laid over.
const style_field = "style"

/// What fills an optional field: the type it may hold.
fn filled_by(k: Kind) -> Kind {
    match k { .Opt(inner) -> inner, rest -> k }
}

/// `@children items` → each child's own `describe`.
fn children(f: Field, m: Mark) -> Part {
    match f.kind {
        .List(.Dyn(_)) -> Part { children: [quote { self.${f.name} }] },
        rest -> refused(not_children(m, f)),
    }
}

/// The word an `EventKind` answers to — its `@word`.
fn word_of(kind: Variant) -> string { kind.marks.find(it.name == word_mark)?.args?.first() ?? kind.name }

/// The `Handler` arm that hears what an event says: ONE arm per thing a
/// control can say, and absent for anything else.
fn hearing(says: List<Param>, bound: Code) -> Code? {
    if says.is_empty() { return quote { Handler.Nothing(${bound}) } }
    if says.length > 1 { return null }
    match says[0].kind {
        .Str -> quote { Handler.Text(${bound}) },
        .Bool -> quote { Handler.Flag(${bound}) },
        .Int -> quote { Handler.Number(${bound}) },
        .Float or .Ptr or .Void or .List(_) or .Cell(_) or .Map(_, _) or .Opt(_) or .Result(_, _) or .Named(_, _) or .Fn(_, _) or .Dyn(_) or .Var(_) or .Unspelled(_) -> null,
    }
}

/// What a node holds: its members' views, described under where the
/// node stands — nothing for a node no member gives children.
fn held_by(members: List<Code>) -> Code {
    if members.is_empty() { return quote { [] } }
    quote { described(at, ${joined(members)}) }
}

/// Several runs as one list — none is the empty list, one is itself.
fn joined(runs: List<Code>) -> Code {
    if runs.is_empty() { return quote { [] } }
    if runs.length == 1 { return runs[0] }
    quote { flatten([${..runs}]) }
}

/// The primitive a component named with `@prim` — `@prim(.Button)` says
/// `Button` — absent when it named none.
fn prim_word(t: Type) -> string? { t.annotations.find(it.name == prim_mark)?.args?.first() }

/// A primitive spreads the shared box in: the node's box is read off it
/// field for field.
fn unboxed(t: Type) -> List<Diagnostic> {
    if t.spreads.any(is_box(it)) { [] } else { [no_box(t)] }
}

/// Whether a spread, as its own file names it, is the shared box.
fn is_box(written: string) -> bool { spreads(written, box_name, style_module) }

/// Whether a spread, as its own file names it, is `module`'s `name`.
fn spreads(written: string, name: string, module: string) -> bool {
    let spread? = type_named(written) else { return false }
    spread.name == name && spread.module == module
}

/// Whether an attribute is its node's own words — its `@facet(content)`.
fn is_content(v: Variant) -> bool { v.marks.any(it.name == facet_mark && it.args.first() == content_facet) }

/// Each thing a second member says again: an attribute, a style field,
/// or the node's own words — refused where the second one stands.
fn said_twice(parts: List<Part>) -> List<Diagnostic> {
    let attrs = [s for p in parts for s in p.said_attrs]
    let styles = [s for p in parts for s in p.said_styles]
    [attribute_twice(s) for j, s in attrs if attrs.slice(0, j).any(it.word == s.word)]
        .concat(
            [words_twice(s) for j, s in attrs if s.content && attrs.slice(0, j).any(it.content && it.word != s.word)],
        )
        .concat([style_twice(s) for j, s in styles if styles.slice(0, j).any(it.word == s.word)])
}

// ── voices ──────────────────────────────────────────────────────

fn unread(t: Type) -> Diagnostic {
    refuse_as_at(
        "defect",
        t.at,
        "defect: `@derive(View)` could not read the library's own vocabulary over `${t.name}`",
        "`Prim`, `Attribute`, `EventKind`, `Box` and `Style` are read by their modules' names — one moved",
    )
}

fn says_nothing(f: Field) -> Diagnostic {
    refuse_as_at(
        "unprojected",
        f.at,
        "a primitive says what each member projects to, and `${f.name}` says nothing",
        "mark it `@attr(.Label)`, `@children` or `@style(color)`, or declare it an event — `on ${f.name}`",
    )
}

fn says_twice(f: Field) -> Diagnostic {
    refuse_as_at(
        "two-marks",
        f.at,
        "a member projects to one thing, and `${f.name}` says more than one",
        "keep one of `@attr`, `@children` and `@style`",
    )
}

fn marked_event(f: Field, m: Mark) -> Diagnostic {
    refuse_as_at(
        "marked-event",
        m.at,
        "an event is heard by its own word, and `${f.name}` is marked `@${m.name}` too",
        "drop the mark — `on ${f.name}`",
    )
}

fn unnamed_mark(m: Mark, form: string) -> Diagnostic {
    refuse_as_at(
        "unnamed-mark",
        m.at,
        "`@${m.name}` names what it marks its member as, and this one names nothing",
        "`${form}`",
    )
}

fn no_attribute(m: Mark, word: string, known: List<string>) -> Diagnostic {
    refuse_as_at(
        "attribute",
        m.at,
        "`${word}` is no attribute of a node",
        "the attributes are ${ticked(known)}",
    )
}

fn bare_attribute(m: Mark, attribute: string) -> Diagnostic {
    refuse_as_at(
        "attribute-misfit",
        m.at,
        "`${attribute}` carries nothing a member could fill",
        null,
    )
}

fn attribute_misfit(m: Mark, attribute: string, carried: Kind, f: Field) -> Diagnostic {
    refuse_as_at(
        "attribute-misfit",
        m.at,
        "`${attribute}` carries `${carried.spelled()}`, and `${f.name}` is `${f.kind.spelled()}`",
        null,
    )
}

fn attribute_twice(s: Saying) -> Diagnostic {
    refuse_as_at(
        "said-twice",
        s.at.at,
        "a node carries an attribute once, and `${s.word}` is already another member's",
        "mark one member `@attr(.${s.word})`",
    )
}

fn words_twice(s: Saying) -> Diagnostic {
    refuse_as_at(
        "said-twice",
        s.at.at,
        "a node says its own words once, and another member already says them — `${s.word}` would be lost",
        "keep one member as the node's words",
    )
}

fn no_style(m: Mark, word: string, known: List<string>) -> Diagnostic {
    refuse_as_at(
        "style",
        m.at,
        "`${word}` is no field of a node's style",
        "the fields are ${ticked(known)}",
    )
}

fn style_misfit(m: Mark, over: Field, f: Field) -> Diagnostic {
    refuse_as_at(
        "style-misfit",
        m.at,
        "a style's `${over.name}` is `${filled_by(over.kind).spelled()}`, and `${f.name}` is `${f.kind.spelled()}`",
        null,
    )
}

fn style_twice(s: Saying) -> Diagnostic {
    refuse_as_at(
        "said-twice",
        s.at.at,
        "a node's style holds `${s.word}` once, and another member already fills it",
        "mark one member `@style(${s.word})`",
    )
}

fn not_children(m: Mark, f: Field) -> Diagnostic {
    refuse_as_at(
        "children",
        m.at,
        "a node's children are views, and `${f.name}` is `${f.kind.spelled()}`",
        "`@children` marks a `List<dyn View>`",
    )
}

fn no_event(f: Field, known: List<string>) -> Diagnostic {
    refuse_as_at(
        "event",
        f.at,
        "`${f.name}` is no event a target hears",
        "a primitive's events are ${ticked(known)}",
    )
}

fn unsayable(f: Field, says: List<Param>) -> Diagnostic {
    refuse_as_at(
        "unsayable",
        f.at,
        "a control says nothing, text, a flag or a number, and `${f.name}` says `${["${s.name}: ${s.ty}" for s in says].join(", ")}`",
        "say one `string`, `bool` or `int`",
    )
}

fn stateful_primitive(f: Field) -> Diagnostic {
    refuse_as_at(
        "stateful-primitive",
        f.at,
        "a primitive draws what it is told, and `${f.name}` is a place it would keep",
        "state is kept by the composition that uses the primitive — a component with `fn view()`",
    )
}

fn no_view(t: Type) -> Diagnostic {
    refuse_as_at(
        "prim",
        t.at,
        "a view is a primitive or is made of views, and `${t.name}` says neither",
        "name the primitive it is — `@prim(.Text)` above it — or what it is made of — `fn view()` in it",
    )
}

fn boxed_composition(t: Type) -> Diagnostic {
    refuse_as_at(
        "boxed-composition",
        t.at,
        "a composition wears its view's box, and `${t.name}` spreads one of its own",
        "spread `..Stand` for its key, or name the primitive it is — `@prim(.Text)`",
    )
}

fn marked_composition(f: Field, m: Mark) -> Diagnostic {
    refuse_as_at(
        "marked-composition",
        m.at,
        "a composition projects nothing of its own, and `${f.name}` is marked `@${m.name}`",
        "its `view` says what it is made of — drop the mark, or name the primitive it is with `@prim`",
    )
}

fn no_box(t: Type) -> Diagnostic {
    refuse_as_at(
        "box",
        t.at,
        "a view carries the shared box, and `${t.name}` spreads none",
        "spread it in — `..Box`",
    )
}

fn not_a_prim(t: Type, word: string, known: List<string>) -> Diagnostic {
    refuse_as_at(
        "not-a-prim",
        t.annotations.find(it.name == prim_mark)?.at ?? t.at,
        "`${word}` is no primitive a target draws",
        "the primitives are ${ticked(known)}",
    )
}

/// Words as a diagnostic lists them.
fn ticked(words: List<string>) -> string { ["`${w}`" for w in words].join(", ") }
