//! `tree/named.av` — A CONTROL ALWAYS HAS A NAME. A control's words are its accessible name, so
//! one drawn with none is a control nobody can find by what it does: the paint that draws it says
//! so (`nameless`), once a paint, under `avra dev`.
use tree.node.{Node, Prim}

/// Whether a primitive is a control a reader finds by its words. A REGISTRY over `Prim`: every
/// primitive is spelled.
export fn names_itself(p: Prim) -> bool {
    match p {
        .Button or .Link or .Field or .Checkbox or .Switch or .Slider -> true,
        .Text or .Heading or .Image or .Row or .Column or .Dialog or .Divider or .Icon or .Surface or .List or .Item or .Card or .Progress or .Alert or .Spinner or .Form or .Fieldset or .Key -> false,
    }
}

/// What a tree's controls drawn with no words say, one each.
export fn nameless(n: Node) -> List<string> {
    let own = if names_itself(n.prim) && n.words().is_empty() { [drawn_unnamed(n.prim.word())] } else { [] }
    own.concat([nameless(c) for c in n.children].flatten())
}

// ── voices ──────────────────────────────────────────────────────

/// A control drawn with no words.
fn drawn_unnamed(control: string) -> string {
    "a `${control}` is drawn with no words, and a control's words are its name: give it a label that is not empty"
}
