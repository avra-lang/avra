//! `tree/identity.av` — ONE identity per node: WHERE IT STANDS — its
//! parent, then its own STEP: its key, or its place among its unkeyed
//! siblings. A node is the same node while its key and its ancestors'
//! stand, whatever is inserted, removed or reordered beside it.
//!
//! Identity is never written out whole. A page that keeps a node across
//! paints gives it a NUMBER when it first appears (`NodeId`) and the node
//! wears that number while it stays: fixed in width however deep the node
//! sits, and never shared, since a number is counted out and not hashed.
//! The steps a number stands under are spelled only for a reader.

/// The number a page gives a node while the node stays on it. Compared
/// and echoed, never parsed. A node no page has placed wears none.
export type NodeId = { n: int }

/// What a node not yet on a page wears.
export const unplaced = NodeId { n: -1 }

/// What a composition spreads in to be told from its siblings: its key.
export type Stand = { key: string? = null }

/// What tells a node from its siblings.
export enum Step {
    /// Its key, and its turn among the siblings that share it.
    Keyed(key: string, turn: int)
    /// Its place among its unkeyed siblings.
    Placed(at: int)
    /// A part a target makes inside a node, by the name the target gives
    /// it — a control under its label, a run of text.
    Part(name: string)
}

impl Step {
    /// A step as a sibling is matched by and a reader's path spells it. A
    /// key is written with its LENGTH, so no key's own text reads as
    /// another node's steps; a place is digits and a part opens with `+`,
    /// so the three never spell alike.
    fn spelled() -> string {
        match self {
            .Keyed(key, turn) -> if turn == 0 { "k${key.length}:${key}" } else { "k${key.length}:${key}~${turn}" },
            .Placed(at) -> "${at}",
            .Part(name) -> "+${name}",
        }
    }
}

/// Each sibling's step, from the siblings' keys in order. A key seen
/// before takes the next turn, so two siblings never share a step.
export fn steps(keys: List<string?>) -> List<Step> {
    if keys.all(it == null) { return [Step.Placed(j) for j, k in keys] }
    mut turns: Map<string, int> = {}
    mut placed = 0
    mut out: List<Step> = []
    // LICENSED loops.push_loop: a running count — each step is the keys before it
    for key in keys {
        match key {
            k? -> {
                let turn = turns.get(k) ?? 0
                turns.set(k, turn + 1)
                out.push(Step.Keyed(k, turn))
            }
            null -> {
                out.push(Step.Placed(placed))
                placed = placed + 1
            }
        }
    }
    out
}

/// A PATH: steps from a root down, as one text. The ONE place a path is
/// spelled from its steps.
export fn path(of: List<string>) -> string { of.join("/") }

/// `step` under the path of what holds it — alone when nothing does.
export fn under(above: string?, step: string) -> string {
    match above {
        p? -> path([p, step])
        null -> step
    }
}

/// The step of a node with no siblings — a tree's root.
export fn lone(key: string?) -> Step {
    match key {
        k? -> Step.Keyed(k, 0)
        null -> Step.Placed(0)
    }
}

/// A step as a reader's line shows it: a character that would break the
/// line is written as its escape, so no key forges a line of its own.
export fn readable(step: string) -> string {
    step.replace("\\", "\\\\").replace("\n", "\\n").replace("\r", "\\r")
}
