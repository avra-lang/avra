//! `tree/identity.av` — ONE identity per node: WHERE IT STANDS — its
//! parent, then its own STEP: its key, or the SITE it was written at.
//! A node is the same node while its step and its ancestors' stand,
//! whatever is inserted, removed or reordered beside it: a sibling that
//! comes and goes above it moves nothing.
//!
//! A SITE IS LEXICAL: the literal that made the node, one number a
//! written literal (`@std/meta`'s `Site`). Siblings one site made — a
//! loop's, a helper's called twice — are told apart by their TURN, which
//! is order, so what must keep its own through a reorder wears a key.
//!
//! Identity is never written out whole. A page that keeps a node across
//! paints gives it a NUMBER when it first appears (`NodeId`) and the node
//! wears that number while it stays: fixed in width however deep the node
//! sits, and never shared, since a number is counted out and not hashed.
//! The steps a number stands under are spelled only for a reader, who is
//! shown a place where a site would say nothing.
use @std.meta.{Site}

/// The number a page gives a node while the node stays on it. Compared
/// and echoed, never parsed. A node no page has placed wears none.
export type NodeId = { n: int }

/// What a node not yet on a page wears.
export const unplaced = NodeId { n: -1 }

/// What a view says of where it stands among its siblings: its key, when
/// it has one, and the site it was written at — which fills itself.
/// `via` is the steps of the compositions a node was drawn THROUGH: a
/// composition draws what it is made of in place, under its own parent,
/// so its step is part of each of those nodes' own.
export type Stand = { key: string? = null, site: Site, via: string = "" }

/// A view standing under `key`, written at `site`.
export fn stand_of(key: string?, site: Site) -> Stand { Stand { key: key, site: site } }

/// What tells a node from its siblings.
export enum Step {
    /// Its key, and its turn among the siblings that share it.
    Keyed(key: string, turn: int)
    /// The site it was written at, its turn among the siblings that site
    /// made, and — for a reader — its place among its unkeyed siblings.
    Sited(site: Site, turn: int, at: int)
    /// A part a target makes inside a node, by the name the target gives
    /// it — a control under its label, a run of text.
    Part(name: string)
    /// A step drawn through compositions: theirs, then its own.
    Through(via: string, step: Step)
}

impl Step {
    /// A step as a sibling is MATCHED by. A key is written with its
    /// LENGTH, so no key's own text reads as another node's steps; a site
    /// opens with `s` and a part with `+`, so the three never spell alike.
    fn spelled() -> string {
        match self {
            .Keyed(key, turn) -> turned("k${key.length}:${key}", turn),
            .Sited(site, turn, _) -> turned("s${site}", turn),
            .Part(name) -> "+${name}",
            .Through(via, step) -> under(via, step.spelled()),
        }
    }

    /// A step as a READER's path shows it: a site is shown as the place
    /// it stands at, since its number says nothing to a reader.
    fn shown() -> string {
        match self {
            .Sited(_, _, at) -> "${at}",
            .Through(_, step) -> step.shown(),
            .Keyed(_, _) or .Part(_) -> self.spelled(),
        }
    }
}

/// A step's words with its turn — the first turn says nothing.
fn turned(words: string, turn: int) -> string {
    if turn == 0 { words } else { "${words}~${turn}" }
}

/// Each sibling's step, from what each says of where it stands, in
/// order. A key or a site seen before takes the next turn, so two
/// siblings never share a step.
export fn steps(stands: List<Stand>) -> List<Step> {
    mut turns: Map<string, int> = {}
    mut placed = 0
    mut out: List<Step> = []
    // LICENSED loops.push_loop: a running count — each step is the stands before it
    for stand in stands {
        let words = lone(stand).spelled()
        let turn = turns.get(words) ?? 0
        turns.set(words, turn + 1)
        out.push(through(stand.via, turned_step(stand, turn, placed)))
        if stand.key == null { placed = placed + 1 }
    }
    out
}

/// A sibling's own step at its `turn`; an unkeyed one stands at `at`
/// among the unkeyed, for a reader.
fn turned_step(stand: Stand, turn: int, at: int) -> Step {
    match stand.key {
        k? -> Step.Keyed(k, turn)
        null -> Step.Sited(stand.site, turn, at)
    }
}

/// `step` as drawn through `via` — itself, when it was drawn through
/// nothing.
fn through(via: string, step: Step) -> Step {
    if via == "" { step } else { Step.Through(via, step) }
}

/// Whether each sibling shares its key or its site with another — the
/// two are then told apart by their order alone.
export fn shared(stands: List<Stand>) -> List<bool> {
    let words = [lone(s).spelled() for s in stands]
    mut seen: Map<string, int> = {}
    for w in words { seen.set(w, (seen.get(w) ?? 0) + 1) }
    [seen.get(w) ?? 0 > 1 for w in words]
}

/// A PATH: steps from a root down, as one text. The ONE place a path is
/// spelled from its steps.
export fn path(of: List<string>) -> string { of.join("/") }

/// `step` under the path of what holds it — alone when nothing does.
export fn under(above: string?, step: string) -> string {
    match above {
        p? -> path([p, step])
        null -> step
    }
}

/// A sibling's step before its turn is counted: what it was drawn
/// through, then its key, else its site.
fn lone(stand: Stand) -> Step { through(stand.via, turned_step(stand, 0, 0)) }

/// The step of a tree's ROOT. It has no sibling to be told from, so
/// where it was written says nothing: a root is its key, or the one
/// place a root stands — and a page turned into another view keeps its
/// root.
export fn root(key: string?) -> Step {
    match key {
        k? -> Step.Keyed(k, 0)
        null -> Step.Sited(Site(0), 0, 0)
    }
}

/// A step as a reader's line shows it: a character that would break the
/// line is written as its escape, so no key forges a line of its own.
export fn readable(step: string) -> string {
    step.replace("\\", "\\\\").replace("\n", "\\n").replace("\r", "\\r")
}
