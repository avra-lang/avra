// proves: writes coalesce to a frame boundary — N writes to one place in
// one turn drain as ONE write in ONE frame; priorities drain the most
// urgent lane first; and a drag's hot writes coalesce to a direct
// transform that re-renders nothing.
use @std.ui.sched.sched.{sched, Update, Priority}

let s = sched()

// four writes to ONE place in one turn are one write in the next frame.
for i in 0..4 {
    s.request(Update { site: 12, key: "", what: .Flag(i % 2 == 0) }, Priority.Input)
}
let flags = s.frame()!
println("${flags.priority.rank()} ${flags.updates.length} ${flags.renders()} ${s.owed()}")

// sixty pointer moves are ONE direct transform, and the tree is untouched.
for i in 0..60 {
    s.hot(7, "drag", .Translate(1.0, 2.0), Priority.Input)
}
let drag = s.frame()!
println("${drag.hot_work().length} ${drag.renders()}")

// input runs before transition before background, each its own boundary.
s.request(Update { site: 1, key: "", what: .Structure }, Priority.Background)
s.request(Update { site: 2, key: "", what: .Text("now") }, Priority.Input)
s.request(Update { site: 3, key: "", what: .Text("later") }, Priority.Transition)
let first = s.frame()!
let second = s.frame()!
let third = s.frame()!
println(
    "${first.priority.rank()} ${first.updates.length} ${second.priority.rank()} ${third.priority.rank()} ${s.owed()}",
)
