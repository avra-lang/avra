//! `@std/ui.sched` by its laws: a write is data, a turn's writes coalesce
//! to the boundary, the most urgent lane drains first, and the hot channel
//! is a kind on the same queue that renders nothing.
use @std.ui.sched.sched.{sched, Update, Priority}

fn flag(site: int, on: bool) -> Update { Update { site: site, key: "", what: .Flag(on) } }

fn words(site: int, text: string) -> Update { Update { site: site, key: "", what: .Text(text) } }

fn said(u: Update) -> string {
    match u.what { .Text(t) -> t, .Structure or .Flag(_) or .Hot(_) -> "" }
}

spec "std/ui sched — coalescing at the frame boundary" {
    given "four writes to one place in one turn" {
        then "drain as one write" {
            let s = sched()
            for i in 0..4 { s.request(flag(12, i % 2 == 0), Priority.Input) }
            s.frame()!.updates.length == 1
        }
        then "leave nothing owed" {
            let s = sched()
            for i in 0..4 { s.request(flag(12, i % 2 == 0), Priority.Input) }
            let before = s.owed()
            let after = s.frame()
            before && s.owed() == false && after != null
        }
    }
    given "writes to two different places in one turn" {
        then "are one frame holding both" {
            let s = sched()
            s.request(flag(1, true), Priority.Input)
            s.request(flag(2, true), Priority.Input)
            s.frame()!.updates.length == 2
        }
    }
    given "a write repeated with different text" {
        then "keeps only the last" {
            let s = sched()
            s.request(words(4, "a"), Priority.Transition)
            s.request(words(4, "b"), Priority.Transition)
            let f = s.frame()!
            f.updates.length == 1 && said(f.updates.first()!) == "b"
        }
    }
    given "a place written as both a flag and its words" {
        then "is two writes, because the kind differs" {
            let s = sched()
            s.request(flag(9, true), Priority.Input)
            s.request(words(9, "hi"), Priority.Input)
            s.frame()!.updates.length == 2
        }
    }
    given "an empty scheduler" {
        then "answers no frame" { sched().frame() == null }
    }
}

spec "std/ui sched — the priorities" {
    given "one write at each priority" {
        then "input drains before transition before background" {
            let s = sched()
            s.request(flag(1, true), Priority.Background)
            s.request(flag(2, true), Priority.Transition)
            s.request(flag(3, true), Priority.Input)
            let first = s.frame()!
            let second = s.frame()!
            let third = s.frame()!
            first.priority.rank() == 0 && second.priority.rank() == 1 && third.priority.rank() == 2
        }
        then "leaves the lower lanes pending until their boundary" {
            let s = sched()
            s.request(flag(1, true), Priority.Background)
            s.request(flag(2, true), Priority.Input)
            let drained = s.frame()!
            drained.priority.rank() == 0 && s.owed()
        }
    }
}

spec "std/ui sched — the hot channel never renders" {
    given "sixty pointer moves in one turn" {
        then "coalesce to one direct write" {
            let s = sched()
            for i in 0..60 { s.hot(7, "drag", .Translate(1.0, 2.0), Priority.Input) }
            s.frame()!.hot_work().length == 1
        }
        then "re-render nothing" {
            let s = sched()
            for i in 0..60 { s.hot(7, "drag", .Translate(1.0, 2.0), Priority.Input) }
            !s.frame()!.renders()
        }
    }
    given "a direct write beside a structural one" {
        then "is one frame that renders the tree once" {
            let s = sched()
            s.hot(7, "drag", .Scroll(0.0, 40.0), Priority.Input)
            s.request(flag(8, true), Priority.Input)
            let f = s.frame()!
            f.hot_work().length == 1 && f.tree_work().length == 1 && f.renders()
        }
    }
}
