//! `tests/support/input.av` — the bytes a terminal reads and writes, as the
//! terminal tests spell them.
use @std.text.{from_codepoint}

/// The escape octet.
export fn esc() -> string { from_codepoint(27) }

/// The sequence that addresses the cell at column `x`, row `y` (from zero).
export fn at(x: int, y: int) -> string { "${esc()}[${y + 1};${x + 1}H" }

/// A kitty-protocol key: its code and its modifier field (1 + shift 1, alt 2, ctrl 4).
export fn kitty(code: int, mods: int) -> string { "${esc()}[${code};${mods}u" }
