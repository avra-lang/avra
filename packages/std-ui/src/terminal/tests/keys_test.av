//! What a terminal's input spells, key by key.
use @std.ui.terminal.tests.support.{esc}
use @std.text.{from_codepoint}
use @std.text.{repeat}
use @std.ui.terminal.keys.{
    Heard,
    heard,
    keys,
    kitty_off,
    kitty_on,
    modes_off,
    modes_on,
    paste_cap,
    resume,
}
use @std.ui.tree.terminal_key.{Key, Paste}

fn word(k: Key) -> string {
    match k {
        .Next -> "next",
        .Back -> "back",
        .Enter -> "enter",
        .Erase -> "erase",
        .Char(ch) -> "'${ch}'",
        .End -> "end",
        .PageUp -> "pageup",
        .PageDown -> "pagedown",
        .Top -> "top",
        .Bottom -> "bottom",
        .Escape -> "escape",
        .Chord(t, ctrl, alt, shift) -> "chord(${t},${if ctrl { "c" } else { "" }}${if alt { "a" } else { "" }}${if shift { "s" } else { "" }})",
        .Click(x, y, shift, alt, ctrl) -> "click(${x},${y}${if shift { ",shift" } else { "" }}${if alt { ",alt" } else { "" }}${if ctrl { ",ctrl" } else { "" }})",
        .Wheel(x, y, toward_end) -> "wheel(${x},${y},${if toward_end { "down" } else { "up" }})",
        .Paste(.Text(t)) -> "paste(${t})",
        .Paste(.TooLarge(n)) -> "paste_too_large(${n})",
        .FocusIn -> "focus_in",
        .FocusOut -> "focus_out",
        .Reports(n) -> "reports(${n})",
        .Shortcut -> "shortcut",
    }
}

fn spelled(text: string) -> string { [word(k) for k in keys(text)].join(" ") }

/// What a run of octets spells, then how many it holds back: `'a' | 2`.
fn read(octets: List<int>) -> string {
    let run = heard(octets.bytes() ?? "".bytes())
    "${[word(k) for k in run.keys].join(" ")} | ${run.held.length}"
}

/// What two runs spell when the second arrives behind what the first held.
fn across(first: List<int>, second: List<int>) -> string {
    let one = heard(first.bytes() ?? "".bytes())
    let two = heard(one.held.concat(second.bytes() ?? "".bytes()))
    [word(k) for k in one.keys.concat(two.keys)].join(" ")
}

spec "a terminal's input is read as keys" {
    given "plain text" {
        then "each character is itself" { spelled("hé!") == "'h' 'é' '!'" }
        then "a space is a character" { spelled("a b") == "'a' ' ' 'b'" }
        then "nothing spells no key" { spelled("") == "" }
    }
    given "the keys that move and act" {
        then "a tab moves on and a line feed enters" { spelled("\t\n") == "next enter" }
        then "a carriage return enters" { spelled("\r") == "enter" }
        then "a carriage return and its line feed are one Enter" { spelled("a\r\nb") == "'a' enter 'b'" }
        then "backspace and delete erase" { spelled(from_codepoint(8) + from_codepoint(127)) == "erase erase" }
        then "Ctrl-D ends" { spelled("a" + from_codepoint(4)) == "'a' end" }
    }
    given "a control sequence" {
        then "Shift-Tab and the up arrow move back" { spelled("${esc()}[Z${esc()}[A") == "back back" }
        then "the down arrow moves on" { spelled("${esc()}[B") == "next" }
        then "page, home and end keys, by letter or number" {
            spelled(
                "${esc()}[5~${esc()}[6~${esc()}[H${esc()}[F${esc()}[1~${esc()}[4~${esc()}[7~${esc()}[8~",
            ) == "pageup pagedown top bottom top bottom top bottom"
        }
        then "home and end as single-shift sequences" { spelled("${esc()}OH${esc()}OF") == "top bottom" }
        then "a numbered key the loop has no key for is dropped whole" { spelled("${esc()}[3~x") == "'x'" }
        then "one the loop has no key for is dropped whole, never typed" {
            spelled("a${esc()}[1;5Cb${esc()}[3~c") == "'a' 'b' 'c'"
        }
        then "one cut short spells no key" { spelled("a${esc()}[1;5") == "'a'" }
        then "a lone escape takes the one character after it with it" { spelled("${esc()}xy") == "'y'" }
        then "a single-shift arrow moves the focus and types nothing" {
            spelled("a${esc()}OA${esc()}OBb") == "'a' back next 'b'"
        }
        then "a single-shift sequence with no key is dropped whole" { spelled("a${esc()}OPb") == "'a' 'b'" }
        then "one a control character cuts is dropped, and the control character is read" {
            spelled("${esc()}[1;\nb") == "enter 'b'"
        }
    }
    given "a run that ends inside a sequence" {
        then "holds a lone escape, typing nothing" { read([97, 27]) == "'a' | 1" }
        then "holds an opened control sequence" { read([97, 27, 91, 49]) == "'a' | 3" }
        then "holds an opened single-shift sequence" { read([27, 79]) == " | 2" }
        then "the next run finishes it as one key, with no tail typed" {
            across([97, 27, 91], [66, 98]) == "'a' next 'b'" && across([27], [79, 65]) == "back"
        }
        then "one that never ends is dropped once it is too long to be one" {
            read([27, 91].concat([49 for n in 0..80])) == " | 0"
        }
    }
    given "octets that are not a character" {
        then "one that can start no character is dropped alone, and what follows is heard" {
            read([97, 255, 98, 9, 10]) == "'a' 'b' next enter | 0"
        }
        then "a stray continuation octet is dropped alone" { read([128, 97]) == "'a' | 0" }
        then "an overlong spelling is dropped, octet by octet" { read([192, 128, 97]) == "'a' | 0" }
        then "a lead whose next octet does not continue it is dropped, and that octet is read" {
            read([195, 97]) == "'a' | 0"
        }
    }
    given "a run that ends inside a character" {
        then "holds its octets, typing nothing" { read([97, 195]) == "'a' | 1" && read([240, 159, 152]) == " | 3" }
        then "the next run finishes it whole" {
            across([195], [169]) == "'é'" && across([240, 159], [152, 128, 98]) == "'😀' 'b'"
        }
    }
    given "a control character with no key" {
        then "it is dropped" { spelled("a" + from_codepoint(0) + from_codepoint(28) + "b") == "'a' 'b'" }
    }
}

spec "the mouse, the paste, the focus and the kitty keyboard" {
    given "an SGR mouse report" {
        then "a primary press is a click at the cell, from zero" { spelled("${esc()}[<0;12;5M") == "click(11,4)" }
        then "a press carries the modifiers held" {
            spelled("${esc()}[<4;3;3M${esc()}[<8;3;3M${esc()}[<16;3;3M${esc()}[<20;3;3M") == "click(2,2,shift) click(2,2,alt) click(2,2,ctrl) click(2,2,shift,ctrl)"
        }
        then "a release, a drag and the other buttons spell nothing" {
            spelled("${esc()}[<0;3;3m${esc()}[<32;3;3M${esc()}[<2;3;3M${esc()}[<1;3;3M") == ""
        }
        then "the wheel turns up and down over a cell" {
            spelled("${esc()}[<64;7;9M${esc()}[<65;7;9M") == "wheel(6,8,up) wheel(6,8,down)"
        }
        then "a report with the wrong number of fields, or a cell before the first, spells nothing" {
            spelled("${esc()}[<0;3M${esc()}[<0;0;3M${esc()}[<0;3;0M") == ""
        }
        then "a report cut anywhere across two reads is read whole" {
            across([27, 91, 60, 48, 59, 49], [50, 59, 53, 77]) == "click(11,4)"
        }
    }
    given "a bracketed paste" {
        then "is one event holding what was pasted" {
            spelled("${esc()}[200~hello world${esc()}[201~") == "paste(hello world)"
        }
        then "keys inside it are text, never keys" {
            spelled("${esc()}[200~a\tb${esc()}[Ac\n${esc()}[201~") == "paste(a\tb${esc()}[Ac\n)"
        }
        then "keys after it are heard as keys" { spelled("${esc()}[200~ab${esc()}[201~\tx") == "paste(ab) next 'x'" }
        then "an empty paste is an empty event" { spelled("${esc()}[200~${esc()}[201~") == "paste()" }
        then "a paste cut across reads is held, then handed over whole" {
            across([27, 91, 50, 48, 48, 126, 97, 98], [99, 100, 27, 91, 50, 48, 49, 126]) == "paste(abcd)"
        }
        then "a paste whose end is cut in two is held" {
            across([27, 91, 50, 48, 48, 126, 97, 27, 91, 50, 48], [49, 126, 120]) == "paste(a) 'x'"
        }
        then "an unfinished paste leaves its octets held and no key" {
            read([27, 91, 50, 48, 48, 126, 97, 98]) == " | 8"
        }
        then "one too long to hold is let go, and the keys after it are heard, with how many octets went" {
            let first = heard("${esc()}[200~${repeat("x", 1100000)}".bytes())
            let second = resume(
                first.held.concat("yyy${esc()}[201~k".bytes()),
                first.draining,
                paste_cap,
            )
            first.draining > 0 &&
                first.keys.is_empty() &&
                first.held.length < 16 &&
                second.draining == 0 &&
                [word(k) for k in second.keys].join(" ") == "paste_too_large(1100003) 'k'"
        }
        then "a long paste's end cut across reads while it is let go still ends it" {
            let first = heard("${esc()}[200~${repeat("x", 1100000)}${esc()}[20".bytes())
            let second = resume(first.held.concat("1~k".bytes()), first.draining, paste_cap)
            first.draining > 0 &&
                [word(k) for k in second.keys].join(" ") == "paste_too_large(1100000) 'k'"
        }
        then "the limit is the terminal's to set" {
            let first = resume("${esc()}[200~${repeat("x", 100)}".bytes(), 0, 50)
            let second = resume(first.held.concat("${esc()}[201~".bytes()), first.draining, 50)
            first.draining > 0 && [word(k) for k in second.keys].join(" ") == "paste_too_large(100)"
        }
        then "a paste inside the limit is whole" {
            let run = resume("${esc()}[200~${repeat("x", 50)}${esc()}[201~".bytes(), 0, 50)
            [word(k) for k in run.keys].join(" ") == "paste(${repeat("x", 50)})"
        }
    }
    given "the terminal's focus" {
        then "in and out are events" { spelled("${esc()}[I${esc()}[O") == "focus_in focus_out" }
    }
    given "the kitty keyboard protocol" {
        then "Tab, Shift-Tab, Enter, Escape and Backspace are told apart" {
            spelled("${esc()}[9u${esc()}[9;2u${esc()}[13u${esc()}[27u${esc()}[127u") == "next back enter escape erase"
        }
        then "Ctrl-I is not Tab, and Alt-x is not Escape then x" {
            spelled("${esc()}[105;5u${esc()}[120;3u") == "chord(i,c) chord(x,a)"
        }
        then "a key with no modifier but Shift is its text" { spelled("${esc()}[97u${esc()}[97;2u") == "'a' 'a'" }
        then "Ctrl-D ends the input and Ctrl-C is a chord" { spelled("${esc()}[99;5u${esc()}[100;5u") == "chord(c,c) end" }
        then "a release, or a key with Super held, spells nothing" { spelled("${esc()}[97;1:3u${esc()}[97;9u") == "" }
        then "the terminal's answer to the query is told, with its flags" {
            spelled("${esc()}[?0u${esc()}[?1u") == "reports(0) reports(1)"
        }
        then "a report cut across reads is read whole" { across([27, 91, 49, 48], [53, 59, 53, 117]) == "chord(i,c)" }
        then "the legacy octets are read as they were" { spelled("\t\n${from_codepoint(127)}") == "next enter erase" }
        then "a control octet is a Ctrl chord, and Ctrl-D ends the input" {
            spelled("a${from_codepoint(3)}${from_codepoint(1)}${from_codepoint(4)}b") == "'a' chord(c,c) chord(a,c) end 'b'"
        }
    }
    given "the modes the app asks for" {
        then "are mouse reports, bracketed paste, focus events and the kitty query, and off again in reverse" {
            modes_on() == "${esc()}[?1000h${esc()}[?1006h${esc()}[?2004h${esc()}[?1004h${esc()}[?u" &&
                modes_off() == "${esc()}[?1004l${esc()}[?2004l${esc()}[?1006l${esc()}[?1000l"
        }
        then "the kitty protocol is pushed once the terminal answers, and popped" {
            kitty_on() == "${esc()}[>5u" && kitty_off() == "${esc()}[<u"
        }
    }
}
