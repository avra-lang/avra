//! A `key` is pressed by the chord that is its own, and by nothing else — the
//! terminal host's half of one law the web host holds too (runtime/dom/
//! bootstrap_test.js, case for case).
use @std.ui.terminal.tests.support.{esc, kitty}
use @std.ui.components.{button, column, item, key}
use @std.ui.terminal.{Terminal, terminal_in_place}
use @std.ui.terminal.screen.{screen}
use @std.ui.tree.view.{View}

fn ignored(_bytes: string) {}

fn untouched() {}

fn unmoded(_mode: int) {}

/// A terminal in place on a fake one, its output let go.
fn held<V: View>(view: fn() -> V) -> Terminal {
    terminal_in_place(view, 20, 5, screen(ignored), ignored, untouched, unmoded)
}

/// How many times the key named `chord` was pressed by `keys`, fed to a
/// terminal holding it.
fn pressed(chord: string, keys: string) -> int {
    let hits: Cell<int> = Cell.new(0)
    let r = held(
        () -> column {
            button "Go" { on press {} }
            key chord { on press { hits.set(hits.get() + 1) } }
        },
    )
    r.feed(keys)
    hits.get()
}

/// A kitty-protocol key on a layout whose key `code` stands at the place of `base`.
fn placed(code: int, base: int, mods: int) -> string { "${esc()}[${code}::${base};${mods}u" }

spec "a key is pressed by its own chord" {
    given "a key named ctrl+s" {
        then "ctrl+s presses it, once" { pressed("ctrl+s", kitty(115, 5)) == 1 }
        then "ctrl+a, plain s and alt+s press nothing" {
            pressed("ctrl+s", kitty(97, 5)) == 0 &&
                pressed("ctrl+s", "s") == 0 &&
                pressed("ctrl+s", kitty(115, 3)) == 0
        }
        then "an extra modifier is another chord" {
            pressed("ctrl+s", kitty(115, 7)) == 0 &&
                pressed("ctrl+s", kitty(115, 6)) == 0 &&
                pressed("ctrl+alt+s", kitty(115, 7)) == 1 &&
                pressed("ctrl+shift+s", kitty(115, 6)) == 1
        }
        then "a letter meets its chord in either case, since shift is a modifier of its own" {
            pressed("ctrl+s", kitty(83, 5)) == 1
        }
    }
    given "a key of another script" {
        then "is pressed by the key the terminal reports for it" { pressed("ctrl+ы", kitty(1099, 5)) == 1 }
        then "a letter chord is met by the key's place, whatever the layout" {
            pressed("ctrl+s", placed(1099, 115, 5)) == 1 &&
                pressed("ctrl+s", placed(963, 115, 5)) == 1 &&
                pressed("ctrl+s", placed(1099, 97, 5)) == 0
        }
        then "and a punctuation chord by its place too" {
            pressed("ctrl+.", placed(1102, 46, 5)) == 1 && pressed("ctrl+/", placed(46, 47, 5)) == 1
        }
    }
    given "a key held below the root" {
        then "answers only while the focus is within what holds it" {
            let hits: Cell<int> = Cell.new(0)
            let r = held(
                () -> column {
                    item {
                        button "Inside" { on press {} }
                        key "ctrl+s" { on press { hits.set(hits.get() + 1) } }
                    }
                    button "Outside" { on press {} }
                },
            )
            r.feed(kitty(115, 5))
            let inside = hits.get()
            r.feed("\t")
            r.feed(kitty(115, 5))
            inside == 1 && hits.get() == 1
        }
    }
}
