start a1- b1- a2- tasks=3 panels=2
toggle a1=true a1+ b1- a2-
toggle b1=true a1+ b1+ a2-
untoggle b1=true a1+ b1- a2-
filter=true open hidden=true held=3
remove b1=true a1+ a2- held=2
unmount b=true panels=1 tasks=2
remount b=true panels=2
unfilter=true a1+ a2-
column
  card key=a
    row
      button "alpha:+"
      button "x"
    row
      button "gamma:-"
      button "x"
    button "hide a"
  card key=b
    button "hide b"
  button "filter"
  button "show b"
