//! Finds DEAD BRANCHES in a grammar before anything parses with it.
//!
//! The executor tries branches in order and BACKTRACKS out of a
//! branch that fails past its first token — so overlap alone is not
//! death. A branch COMMITS when its head alone decides it: once the
//! first required item matches, nothing after it can refuse. A later
//! branch is dead only when an earlier COMMITTING branch can take
//! its first token — that branch swallows the token and succeeds,
//! and the later branch is never tried. This file computes each
//! branch's first tokens and commitment, and refuses the grammar
//! when:
//!   - two branches can start with the same token and the earlier
//!     one commits (`f(x)` before bare `f` passes: the call branch
//!     needs its `(` and hands the tokens back),
//!   - a branch can match nothing and is not last (it always wins),
//!   - a keyword like `"let"` sits AFTER a committing NAME branch —
//!     NAME also matches the word `let`, so the keyword never fires.
//!     The other order (keyword first) is how keywords work,
//!   - a rule starts with itself — the parser would recurse forever.
//!
//! Rules only: this guards what feature merging builds. Alternatives
//! inside one branch's groups are written by one author in one place.

/// One terminal a branch can begin with, and the rule whose body
/// directly holds it — the name a failure there reports.
type TermStart = { prim: Prim, rname: string }

/// What a branch can begin with, and whether it can begin with
/// nothing at all. `lits`/`terms` are a SET for shadowing checks;
/// `ordered` is the same terminals in the order the engine would
/// merge their expectations, stopping where the first nullable
/// branch would.
type FirstSet = { lits: List<string>, terms: List<string>, nullable: bool, ordered: List<TermStart> = [] }

// `firsts`: each rule's set, derived once — a rule referenced from
// forty places is walked once, not forty times
type FirstCx = { g: Grammar, visiting: List<string>, firsts: Map<string, FirstSet>, defects: List<Diagnostic> }

/// The empty first set — nothing matchable, nothing skippable.
const no_first: FirstSet = FirstSet { lits: [], terms: [], nullable: false }

impl FirstCx {
    fn note(d: Diagnostic) {
        self.defects.push(d)
    }

    fn rule_first(name: string) -> FirstSet {
        let known: FirstSet? = self.firsts.get(name)
        if known != null { return known! }
        if self.visiting.contains(name) {
            self.note(defect(name, "rule is left-recursive — no first token can ever commit"))
            return no_first
        }
        // An undefined ref is validate's defect, not a first set.
        let body? = self.g.rules.find(it.name == name)?.body else { return no_first }
        // LICENSED compiler.bracket_ritual: one call site; a bracket earns itself at the second
        self.visiting.push(name)
        let f = self.alt_first(name, body)
        let _ = self.visiting.pop()
        self.firsts.set(name, f)
        f
    }

    fn alt_first(rname: string, a: Alt) -> FirstSet {
        mut lits: List<string> = []
        mut terms: List<string> = []
        mut nullable = false
        mut ordered: List<TermStart> = []
        // A nullable branch is the first HIT on a token none can
        // start on, so the branches after it never run — the engine
        // never sees their expectations.
        mut stopped = false
        for s in a.branches {
            let f = self.seq_first(rname, s)
            lits = first_lits(lits, f.lits)
            terms = first_lits(terms, f.terms)
            nullable = nullable || f.nullable
            if !stopped {
                ordered = ordered.concat(f.ordered)
                if f.nullable { stopped = true }
            }
        }
        FirstSet { lits: lits, terms: terms, nullable: nullable, ordered: ordered }
    }

    /// Walk items left to right: a skippable item's tokens join the
    /// set and the walk continues; the first required item ends it.
    /// All items skippable means the branch can match nothing.
    fn seq_first(rname: string, s: Seq) -> FirstSet {
        mut out = no_first
        for m in s.items {
            let f = self.prim_first(rname, m.prim)
            out = FirstSet {
                lits: first_lits(out.lits, f.lits),
                terms: first_lits(out.terms, f.terms),
                nullable: false,
                ordered: out.ordered.concat(f.ordered),
            }
            let skippable = m.rep == Rep.Opt || m.rep == Rep.Star || f.nullable
            if !skippable { return out }
        }
        out with { nullable: true }
    }

    fn prim_first(rname: string, p: Prim) -> FirstSet {
        match p {
            .Lit(text) -> FirstSet { lits: [text], terms: [], nullable: false, ordered: [term_start(p, rname)] },
            .Named(term) -> FirstSet { lits: [], terms: [term], nullable: false, ordered: [term_start(p, rname)] },
            .Ref(target) -> self.rule_first(target),
            .Group(inner) -> self.alt_first(rname, inner),
            // A lexicon's own atom: a parsing grammar never carries
            // one, so a first set for one names only itself.
            .NotChar(_) ->
                FirstSet { lits: [], terms: [], nullable: false, ordered: [term_start(p, rname)] },
        }
    }

    /// True when the branch's head alone decides it: after its first
    /// required item, every item is skippable — nothing left can
    /// refuse, so the executor never backtracks out.
    fn commits(rname: string, s: Seq) -> bool {
        mut seen_head = false
        for m in s.items {
            let f = self.prim_first(rname, m.prim)
            let skippable = m.rep == Rep.Opt || m.rep == Rep.Star || f.nullable
            if seen_head && !skippable { return false }
            if !skippable { seen_head = true }
        }
        true
    }

    /// A COMMITTING earlier branch's start tokens against a later
    /// branch's: any shared token — or a general token before a
    /// keyword it also matches — makes the later branch dead. A
    /// non-committing earlier branch backtracks, so its overlaps are
    /// harmless.
    fn overlap_defects(rule_name: string, i: int, fi: FirstSet, j: int, fj: FirstSet) {
        for l in fj.lits {
            if fi.lits.contains(l) {
                self.note(defect(rule_name, "branches ${i + 1} and ${j + 1} both begin with `${l}` — branch ${j + 1} is unreachable"))
            }
            let sub: string? = subsuming_term(l)
            if sub != null && fi.terms.contains(sub!) {
                self.note(defect(rule_name, "branch ${j + 1}'s `${l}` is shadowed by branch ${i + 1}'s ${sub!} — anchor the literal branch first"))
            }
        }
        for t in fj.terms {
            if fi.terms.contains(t) {
                self.note(defect(rule_name, "branches ${i + 1} and ${j + 1} both begin with ${t} — branch ${j + 1} is unreachable"))
            }
        }
    }

    /// The grammar with every branch's start info filled. First sets
    /// are read from the ORIGINAL tree, so the memo is shared.
    fn started(g: Grammar) -> Grammar {
        g with { rules: [r with { body: self.started_alt(r.name, r.body) } for r in g.rules] }
    }

    fn started_alt(rname: string, a: Alt) -> Alt {
        a with { branches: [self.started_seq(rname, s) for s in a.branches] }
    }

    fn started_seq(rname: string, s: Seq) -> Seq {
        let f = self.seq_first(rname, s)
        s with { items: [self.started_item(rname, m) for m in s.items], start: BranchStart {
            terminals: [t.prim for t in f.ordered],
            words: distinct([start_word(t.prim) for t in f.ordered]),
            nullable: f.nullable,
            in_rule: f.ordered.first()?.rname ?? rname,
        } }
    }

    fn started_item(rname: string, m: Item) -> Item {
        m with { prim: self.started_prim(rname, m.prim) }
    }

    fn started_prim(rname: string, p: Prim) -> Prim {
        match p {
            .Group(inner) -> Prim.Group(self.started_alt(rname, inner)),
            .Ref(_) or .Lit(_) or .Named(_) or .NotChar(_) -> p,
        }
    }
}

/// How a terminal and the rule that holds it are minted together.
fn term_start(p: Prim, rname: string) -> TermStart {
    TermStart { prim: p, rname: rname }
}

/// How a first terminal reads in an "expected ..." message — the same
/// spelling the engine's own miss uses.
fn start_word(p: Prim) -> string {
    match p {
        .Lit(text) -> lit_expected(text)[0],
        .Named(term) -> expected_word(term),
        .Ref(_) or .Group(_) or .NotChar(_) -> "",
    }
}

/// Every branch's start info, filled once per assembly. A branch whose
/// terminals cannot take the token is skipped whole by the engine, and
/// the words it would have contributed are closed here, so a skip
/// still says what it expected.
export fn with_branch_starts(g: Grammar) -> Grammar {
    mut cx = FirstCx { g: g, visiting: [], firsts: {}, defects: [] }
    cx.started(g)
}

/// A FIRST set is a SET. It is built ONCE per assembly, off every
/// parse, and `overlap_defects` says one word per element — so a
/// literal reaching a branch's head twice would be refused twice.
fn first_lits(a: List<string>, b: List<string>) -> List<string> {
    distinct(a.concat(b))
}

/// The token class that would also match this literal's text:
/// `"let"` is also a NAME, `"42"` is also a NUMBER.
fn subsuming_term(text: string) -> string? {
    if text.is_empty() { return null }
    let c = text.char_code(0)
    when {
        is_name_start(c) -> "NAME"
        is_digit(c) -> "NUMBER"
        _ -> null
    }
}

/// Every dead branch in the grammar, each defect saying why.
export fn first_defects(g: Grammar) -> List<Diagnostic> {
    mut cx = FirstCx { g: g, visiting: [], firsts: {}, defects: [] }
    for r in g.rules {
        let firsts = [cx.seq_first(r.name, s) for s in r.body.branches]
        let commit_flags = [cx.commits(r.name, s) for s in r.body.branches]
        for i, fi in firsts {
            if fi.nullable && i < firsts.length - 1 {
                cx.note(defect(r.name, "branch ${i + 1} can match empty input — every later branch is unreachable"))
            }
            for j, fj in firsts {
                if j > i && commit_flags[i] { cx.overlap_defects(r.name, i, fi, j, fj) }
            }
        }
    }
    cx.defects
}
