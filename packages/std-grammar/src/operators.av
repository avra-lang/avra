//! The climb's tables, read off a branch's tiers once.

use util.{flatten, distinct}
use ast.{Tier, Suffix, OpEntry, Operators, Prim}
use diagnostics.{Want}

/// The operators a list of tiers (loosest first) declares: entries
/// tightest first, so an operator spelled with more tokens than another
/// that shares its first (`>` `>` over `>`) is tried at its own tier
/// before a looser one.
export fn operators_of(tiers: List<Tier>) -> Operators {
    let entries = flatten([tier_entries(tiers[i], i) for i in tightest_first(tiers)])
    Operators {
        tiers: tiers,
        entries: entries,
        by_first: keyed_by_first(entries),
        expects: [tier_expects(l) for l in tiers],
        reach: [flatten([tier_expects(tiers[i]) for i in tightest_first(tiers) if i >= m]) for m in 0..tiers.length + 1],
        lits: distinct(flatten([tier_lits(l) for l in tiers])),
    }
}

fn tightest_first(tiers: List<Tier>) -> List<int> {
    [tiers.length - 1 - k for k in 0..tiers.length]
}

fn tier_entries(l: Tier, at: int) -> List<OpEntry> {
    [OpEntry { words: w, tier: at, rule: null } for w in l.words]
        .concat([OpEntry { words: [x.word], tier: at, rule: x.rule, at: k } for k, x in l.suffixes])
}

fn keyed_by_first(entries: List<OpEntry>) -> Map<string, List<OpEntry>> {
    mut out: Map<string, List<OpEntry>> = {}
    for e in entries {
        out.set(e.words[0], (out.get(e.words[0]) ?? []).concat([e]))
    }
    out
}

/// What a miss at this tier's operators expects: each one's first token.
fn tier_expects(l: Tier) -> Want {
    [Prim.Lit(w[0]) for w in l.words].concat([Prim.Lit(x.word) for x in l.suffixes])
}

fn tier_lits(l: Tier) -> List<string> {
    flatten(l.words).concat([x.word for x in l.suffixes])
}
