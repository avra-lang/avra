// Hand-builds the module doc's calculator grammar and checks every
// type's shape once.
use @std.grammar.{Grammar, Rule, Alt, Seq, Item, Rep, Prim, Build, Expect}

/// term = NUMBER
///      | "(" e:expression ")" @expect(")", "expected ')'") -> e
fn term_rule() -> Rule {
    let number = Seq {
        items: [Item { label: null, prim: Prim.Named("NUMBER"), rep: Rep.One, expect: null }],
        build: null,
        recover: null,
    }
    let grouped = Seq {
        items: [
            Item { label: null, prim: Prim.Lit("("), rep: Rep.One, expect: null },
            Item { label: "e", prim: Prim.Ref("expression"), rep: Rep.One, expect: null },
            Item {
                label: null,
                prim: Prim.Lit(")"),
                rep: Rep.One,
                expect: Expect { message: "expected ')'" },
            },
        ],
        build: Build.Var("e"),
        recover: null,
    }
    Rule { name: "term", body: Alt { branches: [number, grouped] } }
}

/// expression = l:term ( op:("+" | "-") r:term )* -> fold_binary(l, op, r)
fn expression_rule() -> Rule {
    let plus = Seq {
        items: [Item { label: "op", prim: Prim.Lit("+"), rep: Rep.One, expect: null }],
        build: null,
        recover: null,
    }
    let minus = Seq {
        items: [Item { label: "op", prim: Prim.Lit("-"), rep: Rep.One, expect: null }],
        build: null,
        recover: null,
    }
    let tail = Item {
        label: null,
        prim: Prim
            .Group(
                Alt {
                    branches: [
                        Seq {
                            items: [
                                Item {
                                    label: null,
                                    prim: Prim.Group(Alt { branches: [plus, minus] }),
                                    rep: Rep.One,
                                    expect: null,
                                },
                                Item {
                                    label: "r",
                                    prim: Prim.Ref("term"),
                                    rep: Rep.One,
                                    expect: null,
                                },
                            ],
                            build: null,
                            recover: null,
                        },
                    ],
                },
            ),
        rep: Rep.Star,
        expect: null,
    }
    let branch = Seq {
        items: [Item { label: "l", prim: Prim.Ref("term"), rep: Rep.One, expect: null }, tail],
        build: Build.Call("fold_binary", ["l", "op", "r"]),
        recover: null,
    }
    Rule { name: "expression", body: Alt { branches: [branch] } }
}

fn calc() -> Grammar {
    Grammar { name: "Calc", start: "expression", rules: [expression_rule(), term_rule()] }
}

/// defer_stmt = "defer" ( "if" e:expression | "defer" ) BREAK
fn defer_rule() -> Rule {
    let iffed = Seq {
        items: [
            Item { label: null, prim: Prim.Lit("if"), rep: Rep.One, expect: null },
            Item { label: "e", prim: Prim.Ref("expression"), rep: Rep.One, expect: null },
        ],
        build: null,
        recover: null,
    }
    let again = Seq {
        items: [Item { label: null, prim: Prim.Lit("defer"), rep: Rep.One, expect: null }],
        build: null,
        recover: null,
    }
    let branch = Seq {
        items: [
            Item { label: null, prim: Prim.Lit("defer"), rep: Rep.One, expect: null },
            Item {
                label: null,
                prim: Prim.Group(Alt { branches: [iffed, again] }),
                rep: Rep.One,
                expect: null,
            },
            Item { label: null, prim: Prim.Named("BREAK"), rep: Rep.One, expect: null },
        ],
        build: null,
        recover: null,
    }
    Rule { name: "defer_stmt", body: Alt { branches: [branch] } }
}

spec "grammar/ast" {
    given "the calculator grammar built by hand" {
        then "the grammar names its start explicitly" {
            let g = calc()
            g.start == "expression" && g.rules.length == 2
        }
        then "a rule body is an Alt of Seq branches" {
            let t = term_rule()
            t.body.branches.length == 2
        }
        then "an uncaptured Named atom has no label" {
            let first = term_rule().body.branches[0].items[0]
            let named = match first.prim {
                .Named(term) -> term,
                .Ref(_) or .Lit(_) or .Group(_) or .NotChar(_) -> "",
            }
            first.label == null && named == "NUMBER"
        }
        then "a captured Ref carries its label" {
            let e = term_rule().body.branches[1].items[1]
            let target = match e.prim {
                .Ref(name) -> name,
                .Named(_) or .Lit(_) or .Group(_) or .NotChar(_) -> "",
            }
            e.label == "e" && target == "expression"
        }
        then "an Expect lives on the item it guards" {
            let close = term_rule().body.branches[1].items[2]
            close.expect?.message == "expected ')'"
        }
        then "absence of a build means pass-through" {
            term_rule().body.branches[0].build == null
        }
        then "a Var build returns one capture" {
            let b = term_rule().body.branches[1].build!
            match b { .Var(name) -> name == "e", .Call(_, _) or .Node(_, _, _, _) -> false }
        }
        then "a Call build names its builder and captures" {
            let b = expression_rule().body.branches[0].build!
            match b {
                .Call(name, args) -> name == "fold_binary" && args.length == 3,
                .Var(_) or .Node(_, _, _, _) -> false,
            }
        }
        then "a repeated group is one Item with Rep.Star" {
            let tail = expression_rule().body.branches[0].items[1]
            tail.prim is .Group && tail.rep == Rep.Star
        }
    }
    given "the keywords a grammar claims" {
        then "operator and bracket literals are not words" {
            calc().keywords().is_empty()
        }
        then "word literals surface once each, groups included, in order" {
            let g = Grammar {
                name: "K",
                start: "defer_stmt",
                rules: [defer_rule(), expression_rule(), term_rule()],
            }
            let ks = g.keywords()
            ks.length == 2 && ks[0] == "defer" && ks[1] == "if"
        }
    }
}
