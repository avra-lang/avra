//! Grammar coherence: defects a grammar can carry that would otherwise
//! surface later as confusing parse failures. The executor refuses to
//! run a grammar with defects, so every check here is a guarantee the
//! matcher can lean on.
//!
//! A `.Named` terminal's class name is checked against the CALLER'S
//! own vocabulary — this package tokenizes nothing and so names no
//! terminal of its own. Avra's compiler passes its fixed list
//! (NAME, NUMBER, STRING, BREAK, END, EOF, ...); a future SQL grammar
//! passes its own.

use util.{flatten, some_list}
use ast.{Grammar, Rule, Alt, Seq, Item, Prim, Tier, Build}
use diagnostics.{Diagnostic, defect}
use first.{first_defects}
impl Seq {
    /// This branch's capture labels, including those inside nested
    /// groups — capture accumulation makes them all visible to the
    /// build.
    fn labels() -> List<string> {
        flatten([some_list(m.label) for m in self.deep_items()]).concat(self.operator_labels())
    }

    /// The captures an `@operators` branch's builds read besides its operand.
    fn operator_labels() -> List<string> {
        if self.operators == null { [] } else { ["op", "r"] }
    }
}

fn prim_defects(
    rule_name: string,
    p: Prim,
    names: List<string>,
    known_terminals: List<string>,
    labeled: bool,
) -> List<Diagnostic> {
    match p {
        .Ref(target) -> if names.contains(target) {
            []
        } else {
            [defect(rule_name, "references undefined rule `${target}`")]
        },
        .Named(term) -> if known_terminals.contains(term) {
            []
        } else {
            [defect(rule_name, "unknown terminal `${term}`")]
        },
        .Lit(_) -> [],
        // A labeled group is consumed for its value; an unlabeled one
        // is structural (its value is Absent, its captures escape).
        .Group(inner) -> alt_defects(rule_name, inner, names, known_terminals, labeled),
        // A lexicon's own atom: `NotChar` wraps one Prim that may
        // itself be a rule reference, so it is checked the same way.
        .NotChar(inner) -> prim_defects(rule_name, inner, names, known_terminals, labeled),
    }
}

fn build_defects(rule_name: string, s: Seq, value_needed: bool) -> List<Diagnostic> {
    if s.build == null {
        if !value_needed || s.items.length == 1 { return [] }
        return [
            defect(rule_name, "a branch without a build must have exactly one item to pass through"),
        ]
    }
    let labels = s.labels()
    match s.build! {
        .Var(name) -> if labels.contains(name) {
            []
        } else {
            [defect(rule_name, "build returns uncaptured label `${name}`")]
        },
        .Call(_, args) -> [defect(rule_name, "build argument `${a}` is not captured in its branch") for a in args if !labels.contains(a)],
        // A node build's labels are checked against the NODE's
        // payloads, by whoever holds the node model — never here.
        .Node(_, _, _, _) -> [],
    }
}

fn alt_defects(
    rule_name: string,
    a: Alt,
    names: List<string>,
    known_terminals: List<string>,
    value_needed: bool,
) -> List<Diagnostic> {
    flatten([seq_defects(rule_name, s, names, known_terminals, value_needed) for s in a.branches])
}

/// An `@operators` branch's own shape: one operand item labeled `l`,
/// at least one tier, each tier naming an operator, and builds
/// that read only what the climb captures.
fn operator_defects(rule_name: string, s: Seq, names: List<string>) -> List<Diagnostic> {
    let ops? = s.operators else { return [] }
    let shape = if s.items.length == 1 && s.items[0].label == "l" {
        []
    } else {
        [defect(rule_name, "an @operators branch has one item, its operand, captured as `l`")]
    }
    let none = if ops.tiers.is_empty() { [defect(rule_name, "@operators holds no tier")] } else { [] }
    shape.concat(none).concat(flatten([tier_defects(rule_name, l, names) for l in ops.tiers]))
}

fn tier_defects(rule_name: string, l: Tier, names: List<string>) -> List<Diagnostic> {
    let empty = if l.words.is_empty() && l.suffixes.is_empty() { [defect(rule_name, "an @operators tier names no operator")] } else { [] }
    let blank = [defect(rule_name, "an @operators operator spells no token") for w in l.words if w.is_empty() || w.any(it.is_empty())]
    let unknown = [defect(rule_name, "@operators suffix rule `${x.rule}` is undefined") for x in l.suffixes if !names.contains(x.rule)]
    empty.concat(blank).concat(unknown).concat(tier_build_defects(rule_name, l.build))
}

fn tier_build_defects(rule_name: string, b: Build?) -> List<Diagnostic> {
    let named? = b else { return [] }
    match named {
        .Var(_) -> [
            defect(
                rule_name,
                "an @operators tier builds by a call or a node, not by returning a capture",
            ),
        ],
        .Call(_, args) -> [defect(rule_name, "an @operators build reads `l`, `op` and `r`, not `${a}`") for a in args if !["l", "op", "r"].contains(a)],
        .Node(_, _, _, _) -> [],
    }
}

/// One branch's defects: its items', then its build's.
fn seq_defects(
    rule_name: string,
    s: Seq,
    names: List<string>,
    known_terminals: List<string>,
    value_needed: bool,
) -> List<Diagnostic> {
    flatten(
        [prim_defects(rule_name, m.prim, names, known_terminals, m.label != null) for m in s.items],
    )
        .concat(build_defects(rule_name, s, value_needed))
        .concat(operator_defects(rule_name, s, names))
}

/// The executor indexes rules by name; a duplicate would silently
/// shadow. Same-name rules must merge before a grammar runs.
// LICENSED compiler.seen_accumulator: duplicate DETECTION across rules, not one list
fn duplicate_defects(rules: List<Rule>) -> List<Diagnostic> {
    mut seen: List<string> = []
    mut out: List<Diagnostic> = []
    for r in rules {
        if seen.contains(r.name) {
            out.push(defect(r.name, "declared more than once — merge same-name rules first"))
        } else {
            seen.push(r.name)
        }
    }
    out
}

impl Grammar {
    /// Every defect in this grammar; empty means the matcher's
    /// assumptions all hold. `known_terminals` is the caller's own
    /// vocabulary of `.Named` class names — this engine names none.
    fn defects(known_terminals: List<string>) -> List<Diagnostic> {
        let names = self.rules.map(it.name)
        let start_defect = if names.contains(self.start) { [] } else { [defect(self.start, "start rule is not defined")] }
        start_defect
            .concat(duplicate_defects(self.rules))
            .concat(
                flatten(
                    [alt_defects(r.name, r.body, names, known_terminals, true) for r in self.rules],
                ),
            )
            .concat(first_defects(self))
    }
}
