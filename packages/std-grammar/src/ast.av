//! Grammar values: the tree DSL text becomes, and the one input the
//! grammar engine runs.
//!
//! A Grammar is rules; a rule is alternatives; an alternative is a
//! sequence; a sequence is items; an item is an atom with modifiers.
//! Build, Expect, and Recover annotate what to construct, what to say
//! when a token is missing, and where to resume after failure.
//!
//! The worked shape, for the rules
//!
//!     expression = l:term ( op:("+" | "-") r:term )*  -> fold_binary(l, op, r)
//!     term       = NUMBER
//!                | "(" e:expression ")" @expect(")", "expected ')'") -> e
//!
//! `term` is a Rule whose body is an Alt of two Seq branches: the first
//! holds one Item (the Named atom NUMBER); the second holds three
//! (Lit "(", the captured Ref `e:expression`, Lit ")"), with the Expect
//! stored on the ")" item and Var("e") as the build.
//!
//! Authored text and stored value differ on purpose: surface
//! conveniences (first rule is the start, a trailing @expect names its
//! token) are resolved at parse time into explicit fields (`start`,
//! `Item.expect`), so consumers read structure, never conventions.

use util.{flatten, distinct, is_name_start}
/// A named bag of rules and which one parsing begins at. `start` always
/// names a rule in `rules`.
export type Grammar = { name: string, start: string, rules: List<Rule> }

impl Grammar {
    /// The identifier-shaped literals across every rule, deduped in
    /// first-appearance order — the words this grammar claims, which
    /// a language refuses as names.
    fn keywords() -> List<string> {
        distinct(flatten([alt_words(r.body) for r in self.rules]))
    }
}

fn alt_words(a: Alt) -> List<string> {
    flatten([item_words(x) for x in a.items()])
}

fn item_words(x: Item) -> List<string> {
    match x.prim {
        .Lit(text) if !text.is_empty() && is_name_start(text.char_code(0)) -> [text],
        .Lit(_) or .Ref(_) or .Named(_) or .Group(_) or .NotChar(_) -> [],
    }
}

/// One `name = body` line: a name and its right-hand side.
export type Rule = { name: string, body: Alt }

/// Alternatives separated by `|`, tried top to bottom; first match
/// wins. A rule body is always an Alt, even with one branch.
export type Alt = { branches: List<Seq> }

/// What a branch can BEGIN with, closed to terminals and in the order
/// the engine would merge their expectations: the terminals the first
/// token may wear, the words a reader sees for them, whether the
/// branch can match empty, and the rule a failure at its first token
/// reports from. Filled by `ready`, never authored.
export type BranchStart = {
    terminals: List<Prim>,
    words: List<string>,
    nullable: bool,
    in_rule: string,
}

/// One branch of an Alt: items that must appear in order, plus the
/// branch's build directive and recovery policy. No build means
/// pass-through of the single sub-result. `start` is computed at
/// `ready`, never authored.
export type Seq = { items: List<Item>, build: Build?, recover: Recover?, start: BranchStart? = null }

/// One thing in a sequence: an atom wearing up to three modifiers — an
/// optional capture label, a repetition, and an optional missing-token
/// message. No label means uncaptured.
///
/// THE HEAD LAW, two marks: a HEAD (`@head(c)`) is matched with every
/// TRAILER (`@trailer(tb)`) closed — a trailer item never matches
/// inside a head — until a delimiter (`(`, `[`, `{`) in the sequence
/// opens the rest of it. So `if f(a) { … }` keeps its brace while
/// `g(f(a) { … })` takes the block, and the grammar says which is
/// which without spelling the ladder twice.
export type Item = { label: string?, prim: Prim, rep: Rep, expect: Expect?, head: bool = false, trailer: bool = false, listed: bool = false }

/// THE LIST LAW: a label that can bind MORE THAN ONCE in one match
/// COLLECTS, and one that binds once carries its value. `listed` is
/// that question answered — resolved at `ready`, never authored, so
/// the notation says only where a label appears and the engine says
/// what it means.
///
/// Counted along the sequence: alternatives take the most any ONE of
/// them binds (only one runs), and a repetition binds MANY.
impl Seq {
    /// Whether `label` collects in this branch.
    fn binds_many(label: string) -> bool {
        self.binding_count(label) > 1
    }

    /// How often `label` can bind here, counted no higher than `many`.
    fn binding_count(label: string) -> int {
        capped(sum_of([item_bindings(m, label) for m in self.items]))
    }
}

/// Two IS many: nothing asks how many past the second.
const many: int = 2

fn capped(n: int) -> int {
    if n > many { many } else { n }
}

fn sum_of(ns: List<int>) -> int {
    mut total = 0
    for n in ns { total = total + n }
    total
}

/// One item's bindings of `label`: its own, or the most any branch of
/// a group it opens binds — many when it repeats.
fn item_bindings(m: Item, label: string) -> int {
    let inner = capped(own_binding(m, label) + group_bindings(m.prim, label))
    if inner > 0 && repeats(m.rep) { return many }
    inner
}

fn own_binding(m: Item, label: string) -> int {
    if m.label != null && m.label! == label { 1 } else { 0 }
}

fn group_bindings(p: Prim, label: string) -> int {
    match p {
        .Group(inner) -> most_of([s.binding_count(label) for s in inner.branches]),
        .Ref(_) or .Lit(_) or .Named(_) or .NotChar(_) -> 0,
    }
}

fn most_of(ns: List<int>) -> int {
    mut best = 0
    for n in ns { if n > best { best = n } }
    best
}

fn repeats(r: Rep) -> bool {
    match r { .Star or .Plus -> true, .One or .Opt -> false }
}

/// Every branch's items marked with THE LIST LAW's answer.
export fn listed_grammar(g: Grammar) -> Grammar {
    g with { rules: [r with { body: listed_alt(r.body) } for r in g.rules] }
}

fn listed_alt(a: Alt) -> Alt {
    a with { branches: [listed_seq(s) for s in a.branches] }
}

fn listed_seq(s: Seq) -> Seq {
    s with { items: [listed_item(s, m) for m in s.items] }
}

/// An item's own mark, and its group's branches marked against THIS
/// branch — a nested label's law is the enclosing branch's, since
/// captures escape a group into it.
fn listed_item(s: Seq, m: Item) -> Item {
    m with { listed: m.label != null && s.binds_many(m.label!), prim: listed_prim(s, m.prim) }
}

fn listed_prim(s: Seq, p: Prim) -> Prim {
    match p {
        .Group(inner) -> Prim.Group(inner with { branches: [nested_seq(s, b) for b in inner.branches] }),
        .Ref(_) or .Lit(_) or .Named(_) or .NotChar(_) -> p,
    }
}

/// A group's branch, its items judged by the ENCLOSING branch.
fn nested_seq(outer: Seq, inner: Seq) -> Seq {
    inner with { items: [listed_item(outer, m) for m in inner.items] }
}

/// How many times an Item may appear: exactly once, `*` zero or more,
/// `+` one or more, `?` optional.
export enum Rep { One, Star, Plus, Opt }

/// What an Item actually is. `NotChar` is a LEXICON's own —
/// character-level matching, the way `Lit`/`Named` work at the token
/// level; a parsing grammar's rules never carry it.
export enum Prim {
    /// Another rule's name — recurse into it.
    Ref(rule: string)
    /// Exact source text that must appear (`"+"`, `"defer"`).
    Lit(text: string)
    /// A token class from the lexer (`NUMBER`, `STRING`, `IDENT`) —
    /// any token of that kind, not specific text.
    Named(term: string)
    /// Parentheses in the grammar: a nested Alt as one atom.
    Group(inner: Alt)
    /// One character NOT matching `inner` — negation over an open
    /// character set, which has no finite-alternation equivalent.
    NotChar(inner: Prim)
}

impl Prim {
    /// The token this atom answers to by name — what an `@expect`
    /// names. Rules, groups, and a lexicon's character atom have no
    /// single token.
    fn token_name() -> string? {
        match self {
            .Lit(text) or .Named(text) -> text,
            .Ref(_) or .Group(_) or .NotChar(_) -> null,
        }
    }

    /// True when an `@expect` naming `token` guards this atom.
    fn answers_to(token: string) -> bool {
        let tn? = self.token_name() else { return false }
        tn == token
    }
}

impl Seq {
    /// This branch, then every branch nested in its groups.
    fn seqs() -> List<Seq> {
        [self].concat(flatten([group_seqs(m.prim) for m in self.items]))
    }

    /// This branch's items, nested groups opened.
    fn deep_items() -> List<Item> {
        flatten([s.items for s in self.seqs()])
    }
}

impl Alt {
    /// Every branch under this alternation, nested groups opened.
    fn seqs() -> List<Seq> {
        flatten([s.seqs() for s in self.branches])
    }

    /// Every item under this alternation, nested groups opened.
    fn items() -> List<Item> {
        flatten([s.deep_items() for s in self.branches])
    }
}

/// The branches a prim opens — a group's, nothing else's.
fn group_seqs(p: Prim) -> List<Seq> {
    match p { .Group(inner) -> inner.seqs(), .Ref(_) or .Lit(_) or .Named(_) or .NotChar(_) -> [] }
}

/// The `->` at the end of a branch: what to construct once it matched.
/// Call invokes a builder with the named captures; Var returns one
/// capture; Node NAMES the node the branch builds (`-> Expr.StrLit`).
///
/// A Node is BOUND before a grammar runs, by whoever holds the node
/// model — which the engine does not: binding fills `slots`, one per
/// payload in PAYLOAD ORDER, so the parse itself never joins a label
/// to a payload. `slots` is null until then.
export enum Build {
    Var(name: string)
    Call(name: string, args: List<string>)
    Node(owner: string, variant: string, fixed: List<Fixed>, slots: List<Slot>?)
}

/// What fills one payload: the capture its LABEL bound, the value the
/// rule STATED, or nothing — which the arity law permits only for a
/// list or a nullable payload.
///
/// A stated value is its TEXT. No consumer reads how it was spelled:
/// what a value means is decided by the payload it fills.
export enum Slot {
    Label(name: string)
    Fixed(text: string)
    Empty
}

/// A payload the rule states rather than captures — `-> Expr.BoolLit(value = true)`.
export type Fixed = { name: string, text: string }

/// One argument as the DSL wrote it, before the build kind is known:
/// a bare name (a capture's label) or a name given a value (a fixed
/// payload). Exists only between a build's parse and its construction.
export type BuildArg = { name: string, fixed: string? }

/// The builder a node build calls. ONE definition, read by the engine
/// that calls it and by whoever registers it — a node builder is
/// named for the variant it constructs.
export fn node_builder_name(owner: string, variant: string) -> string {
    "${owner}.${variant}"
}

/// The error message a specific token owes when it is missing. Written
/// `@expect(tok, msg)` trailing the branch; stored on the Item it
/// names, so the token needs no field here.
export type Expect = { message: string }

/// A branch's failure policy: skip ahead to `sync_to` and continue, so
/// one parse reports every error, not just the first.
export type Recover = { sync_to: string }
