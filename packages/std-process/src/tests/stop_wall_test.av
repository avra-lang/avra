// A kill deadline is a promise about the wall: while another task sleeps on the virtual clock,
// a child given its grace to leave after TERM leaves by itself and is never KILLed early.
use @std.process.{ProcessError, Ready, cmd, exit_text, tool}
use @std.time.{secs, sleep}

/// A task that sleeps on the virtual clock and never wakes on its own.
fn slept_long() -> int {
    sleep(secs(600))
    0
}

/// A child that takes a second of real time to leave once TERM reaches it, stopped `n` times over
/// while another task sleeps on the virtual clock.
fn stopped_beside_a_sleeper(n: int) -> Result<string, ProcessError> {
    let sleeper = spawn slept_long()
    let said = stopped_over(n)
    sleeper.cancel()
    said
}

/// The child stopped `n` times over, each ending as it was met.
fn stopped_over(n: int) -> Result<string, ProcessError> {
    let s = tool("sh")?
    let c = cmd(s, ["-c", "trap 'sleep 1; exit 0' TERM; echo set; while :; do sleep 0.05; done"])
    mut said: List<string> = []
    for _i in 0..n {
        mut child = c.start(Ready.Line("set"), secs(5))?
        said.push(exit_text(child.stop()))
    }
    said.join(",")
}

fn shown(r: Result<string, ProcessError>) -> string {
    match r { .Ok(s) -> s, .Err(e) -> "refused: ${e.describe().message}" }
}

spec "std/process — a stop's grace is the wall's" {
    given "a child that leaves a second after TERM, while another task sleeps on the virtual clock" {
        then "each of four stops sees it leave by itself, never by KILL" {
            shown(stopped_beside_a_sleeper(4)) == "clean,clean,clean,clean"
        }
    }
}
