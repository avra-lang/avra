//! `@std/random` — the OS's entropy, for what must not be guessed: a
//! nonce, a session, a key. Nothing here is seeded, replayable or drawn
//! from a clock; when the OS gives no randomness the answer is absent,
//! never a weaker one.
use @std.text.{base64url}

extern fn avra_random_bytes(n: int) -> Bytes?

/// `n` bytes of the OS's entropy: an empty `Bytes` for none, absent only
/// when the OS gave none. A negative `n` is the caller's mistake and
/// traps.
export fn random_bytes(n: int) -> Bytes? { avra_random_bytes(n) }

/// `n` bytes of the OS's entropy as URL-safe text, absent when the OS
/// gave none.
export fn token(n: int) -> string? { base64url(random_bytes(n)?) }
