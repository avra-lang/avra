//! `@std/ui-html` — the html realizer. `html` draws a `Node` tree as
//! semantic HTML, `css` answers the one stylesheet its classes name,
//! and `page` wraps both in a document with no script.
//!
//! Every byte a tree carries is escaped for the context it lands in:
//! text content by `escape_text`, an attribute value by `escape_attr`
//! (always double-quoted), a URL by `safe_url` before it reaches an
//! attribute. No role concatenates a raw string. A look is one atomic
//! class per `Setting` (`gap-m`, `fill-surface-raised`), so the
//! stylesheet is a fixed table read in enum order.

use @std.ui.{Node, Role, Setting, Size, Tone, Font}
use @std.text.{codepoints, from_codepoints}

// ── Escaping ─────────────────────────────────────────────────────

/// The five characters that end a text or attribute context, as entities.
fn entities(s: string) -> string {
    s
        .replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace("\"", "&quot;")
        .replace("'", "&#39;")
}

/// Text content: safe between tags.
export fn escape_text(s: string) -> string { entities(s) }

/// An attribute value: escaped and double-quoted, so it cannot end its attribute.
export fn escape_attr(s: string) -> string { "\"${entities(s)}\"" }

/// ASCII lowercase; every other code point stays.
fn fold(s: string) -> string {
    from_codepoints([if c >= 65 && c <= 90 { c + 32 } else { c } for c in codepoints(s)])
}

/// A URL that may be emitted: relative, scheme-free, or http, https, mailto.
export fn safe_url(u: string) -> bool {
    let colon = u.index_of(":")
    relative(u) || colon < 0 || allowed_scheme(fold(u.substring(0, colon)))
}

fn relative(u: string) -> bool {
    ["/", "./", "../", "#", "?"].any((p) -> u.starts_with(p))
}

fn allowed_scheme(scheme: string) -> bool {
    ["http", "https", "mailto"].contains(scheme)
}

/// The attribute a refused URL leaves behind: the value, inert.
fn refusal(u: string) -> string { " data-refused-url=${escape_attr(u)}" }

/// A link's target: the URL if safe, else `#` and the refusal.
fn href_attr(u: string) -> string {
    if safe_url(u) { " href=${escape_attr(u)}" } else { " href=\"#\"${refusal(u)}" }
}

/// An image's source: the URL if safe, else no source and the refusal.
fn src_attr(u: string) -> string {
    if safe_url(u) { " src=${escape_attr(u)}" } else { refusal(u) }
}

// ── Look ─────────────────────────────────────────────────────────

fn size_word(z: Size) -> string {
    match z { .None -> "none", .Xs -> "xs", .S -> "s", .M -> "m", .L -> "l", .Xl -> "xl" }
}

fn tone_word(t: Tone) -> string {
    match t {
        .Text -> "text",
        .Muted -> "muted",
        .Danger -> "danger",
        .Surface -> "surface",
        .SurfaceRaised -> "surface-raised",
        .SurfaceSunk -> "surface-sunk",
        .SurfaceHover -> "surface-hover",
    }
}

fn font_word(f: Font) -> string {
    match f { .Body -> "body", .Heading -> "heading", .Footnote -> "footnote", .Mono -> "mono" }
}

/// The atomic class a setting names.
fn class_of(s: Setting) -> string {
    match s {
        .Gap(z) -> "gap-${size_word(z)}",
        .Pad(z) -> "pad-${size_word(z)}",
        .Radius(z) -> "radius-${size_word(z)}",
        .Fill(t) -> "fill-${tone_word(t)}",
        .Color(t) -> "color-${tone_word(t)}",
        .Face(f) -> "face-${font_word(f)}",
    }
}

/// The declaration an atomic class carries, over the custom properties.
fn declaration(s: Setting) -> string {
    match s {
        .Gap(z) -> "gap:var(--size-${size_word(z)})",
        .Pad(z) -> "padding:var(--size-${size_word(z)})",
        .Radius(z) -> "border-radius:var(--size-${size_word(z)})",
        .Fill(t) -> "background-color:var(--tone-${tone_word(t)})",
        .Color(t) -> "color:var(--tone-${tone_word(t)})",
        .Face(f) -> "font-family:var(--font-${font_word(f)})",
    }
}

/// A node's class attribute: its structural class, then one per setting.
fn class_attr(n: Node, structural: string) -> string {
    let names = [structural].concat([class_of(s) for s in n.look]).filter(it != "")
    if names.length == 0 { "" } else { " class=${escape_attr(names.join(" "))}" }
}

// ── Roles ────────────────────────────────────────────────────────

/// A node as HTML.
export fn html(n: Node) -> string {
    match n.role {
        .Text(c) -> "<p${class_attr(n, "")}>${escape_text(c)}</p>",
        .Heading(c, depth) -> heading(n, c, depth),
        .Image(src, alt) -> "<img${src_attr(src)} alt=${escape_attr(alt)}${class_attr(n, "")}>",
        .Link(label, to) -> "<a${href_attr(to)}${class_attr(n, "")}>${escape_text(label)}</a>",
        .Button(label) -> "<button type=\"button\"${class_attr(n, "")}>${escape_text(label)}</button>",
        .Toggle(label, on) -> toggle(n, label, on),
        .Field(label, value) -> "<label${class_attr(n, "")}>${escape_text(label)} <input type=\"text\" value=${escape_attr(value)}></label>",
        .Column -> "<div${class_attr(n, "col")}>${kids(n)}</div>",
        .Row -> "<div${class_attr(n, "row")}>${kids(n)}</div>",
        .Section(title) -> "<section${class_attr(n, "section")}><h2>${escape_text(title)}</h2>${kids(n)}</section>",
        .List -> "<ul${class_attr(n, "")}>${kids(n)}</ul>",
        .Item -> "<li${class_attr(n, "")}${key_attr(n.key)}>${kids(n)}</li>",
    }
}

fn kids(n: Node) -> string { [html(c) for c in n.children].join("") }

/// An item's identity, when it has one.
fn key_attr(key: string?) -> string {
    match key {
        k? -> " data-key=${escape_attr(k)}"
        null -> ""
    }
}

fn heading(n: Node, content: string, depth: int) -> string {
    let h = clamp(depth, 1, 6)
    "<h${h}${class_attr(n, "")}>${escape_text(content)}</h${h}>"
}

fn clamp(v: int, lo: int, hi: int) -> int {
    when {
        v < lo -> lo
        v > hi -> hi
        _ -> v
    }
}

fn toggle(n: Node, label: string, on: bool) -> string {
    let checked = if on { " checked" } else { "" }
    "<label${class_attr(n, "")}><input type=\"checkbox\" role=\"switch\"${checked}> ${escape_text(label)}</label>"
}

// ── Stylesheet ───────────────────────────────────────────────────

const sizes = [Size.None, .Xs, .S, .M, .L, .Xl]
const tones = [Tone.Text, .Muted, .Danger, .Surface, .SurfaceRaised, .SurfaceSunk, .SurfaceHover]
const fonts = [Font.Body, .Heading, .Footnote, .Mono]

fn size_length(z: Size) -> string {
    match z {
        .None -> "0",
        .Xs -> "0.25rem",
        .S -> "0.5rem",
        .M -> "1rem",
        .L -> "1.5rem",
        .Xl -> "2.5rem",
    }
}

fn tone_light(t: Tone) -> string {
    match t {
        .Text -> "#1a1a1a",
        .Muted -> "#6b6b6b",
        .Danger -> "#c62828",
        .Surface -> "#ffffff",
        .SurfaceRaised -> "#f5f5f5",
        .SurfaceSunk -> "#ebebeb",
        .SurfaceHover -> "#e0e0e0",
    }
}

fn tone_dark(t: Tone) -> string {
    match t {
        .Text -> "#ececec",
        .Muted -> "#9a9a9a",
        .Danger -> "#ef5350",
        .Surface -> "#121212",
        .SurfaceRaised -> "#1e1e1e",
        .SurfaceSunk -> "#0a0a0a",
        .SurfaceHover -> "#2a2a2a",
    }
}

fn font_family(f: Font) -> string {
    match f {
        .Body or .Heading or .Footnote -> "system-ui,sans-serif",
        .Mono -> "ui-monospace,monospace",
    }
}

/// Every setting, in enum order.
fn all_settings() -> List<Setting> {
    [Setting.Gap(z) for z in sizes]
        .concat([Setting.Pad(z) for z in sizes])
        .concat([Setting.Radius(z) for z in sizes])
        .concat([Setting.Fill(t) for t in tones])
        .concat([Setting.Color(t) for t in tones])
        .concat([Setting.Face(f) for f in fonts])
}

fn size_vars() -> string {
    [" --size-${size_word(z)}:${size_length(z)};" for z in sizes].join("")
}

fn font_vars() -> string {
    [" --font-${font_word(f)}:${font_family(f)};" for f in fonts].join("")
}

fn tone_vars(shade: fn(Tone) -> string) -> string {
    [" --tone-${tone_word(t)}:${shade(t)};" for t in tones].join("")
}

fn root_rules() -> List<string> {
    [
        ":root{${size_vars()}${tone_vars(tone_light)}${font_vars()} }",
        "@media (prefers-color-scheme: dark){:root{${tone_vars(tone_dark)} }}",
    ]
}

fn structural_rules() -> List<string> {
    [
        "body{margin:0;background-color:var(--tone-surface);color:var(--tone-text);font-family:var(--font-body)}",
        ".col{display:flex;flex-direction:column}",
        ".row{display:flex;flex-direction:row}",
        ".section{display:block}",
    ]
}

/// The one stylesheet every class in `html`'s output names.
export fn css() -> string {
    root_rules()
        .concat(structural_rules())
        .concat([".${class_of(s)}{${declaration(s)}}" for s in all_settings()])
        .join("\n")
}

/// A full document: no script, the stylesheet inline.
export fn page(title: string, body: Node) -> string {
    "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>${escape_text(title)}</title><style>${css()}</style></head><body>${html(body)}</body></html>"
}
