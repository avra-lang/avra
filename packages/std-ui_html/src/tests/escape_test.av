// Every context a byte can end: text, a quoted attribute, a URL, the
// title. Each hostile string arrives inert.
use @std.ui.{Node, Role}
use @std.text.{from_codepoint}
use @std.ui_html.{html, page, escape_text, escape_attr, safe_url}

fn plain(r: Role) -> Node { Node { role: r } }

fn link(to: string) -> string { html(plain(.Link("x", to))) }

fn refused(to: string) -> string {
    "<a href=\"#\" data-refused-url=\"${escape_text(to)}\">x</a>"
}

spec "std/ui-html escaping" {
    given "text content" {
        then "a script tag is inert" {
            html(plain(.Text("<script>alert(1)</script>"))) == "<p>&lt;script&gt;alert(1)&lt;/script&gt;</p>"
        }
        then "all five specials escape" {
            escape_text("&<>\"'") == "&amp;&lt;&gt;&quot;&#39;"
        }
        then "an entity is not decoded" {
            escape_text("&lt;") == "&amp;lt;"
        }
        then "the empty string is empty" {
            escape_text("") == ""
        }
        then "plain text and unicode pass through" {
            escape_text("héllo ✓") == "héllo ✓"
        }
        then "a NUL stays and the specials around it escape" {
            escape_text("<" + from_codepoint(0) + ">") == "&lt;" + from_codepoint(0) + "&gt;"
        }
        then "a button label escapes" {
            html(plain(.Button("<b>"))) == "<button type=\"button\">&lt;b&gt;</button>"
        }
        then "a toggle label escapes" {
            html(plain(.Toggle("<b>", false))) == "<label><input type=\"checkbox\" role=\"switch\"> &lt;b&gt;</label>"
        }
        then "a field label escapes" {
            html(plain(.Field("<b>", ""))) == "<label>&lt;b&gt; <input type=\"text\" value=\"\"></label>"
        }
        then "a heading escapes" {
            html(plain(.Heading("</h1><script>", 1))) == "<h1>&lt;/h1&gt;&lt;script&gt;</h1>"
        }
        then "a section title escapes" {
            html(plain(.Section("<i>"))) == "<section class=\"section\"><h2>&lt;i&gt;</h2></section>"
        }
    }
    given "an attribute value" {
        then "it is double-quoted" {
            escape_attr("a") == "\"a\""
        }
        then "a quote cannot end it" {
            html(plain(.Image("/a.png", "\" onmouseover=\"x"))) == "<img src=\"/a.png\" alt=\"&quot; onmouseover=&quot;x\">"
        }
        then "a single quote is escaped too" {
            escape_attr("' onfocus='x") == "\"&#39; onfocus=&#39;x\""
        }
        then "an angle bracket is escaped" {
            escape_attr("><script>") == "\"&gt;&lt;script&gt;\""
        }
        then "a field value cannot end its attribute" {
            html(plain(.Field("f", "\" autofocus onfocus=\"x"))) == "<label>f <input type=\"text\" value=\"&quot; autofocus onfocus=&quot;x\"></label>"
        }
        then "an item key cannot end its attribute" {
            html(Node { role: .Item, key: "\"><script>" }) == "<li data-key=\"&quot;&gt;&lt;script&gt;\"></li>"
        }
        then "a newline stays inside the quotes" {
            escape_attr("a\nb") == "\"a\nb\""
        }
    }
    given "a URL" {
        then "https passes" {
            link("https://x.dev/a") == "<a href=\"https://x.dev/a\">x</a>"
        }
        then "http and mailto pass" {
            safe_url("http://x.dev") && safe_url("mailto:a@b.c")
        }
        then "a scheme is read without case" {
            safe_url("HTTPS://x.dev") && safe_url("MailTo:a@b.c")
        }
        then "a relative path with a query and fragment passes" {
            link("/x?y=1#z") == "<a href=\"/x?y=1#z\">x</a>"
        }
        then "the other relative forms pass" {
            safe_url("./a") && safe_url("../a") && safe_url("#top") && safe_url("?q=1")
        }
        then "a path with no scheme passes" {
            safe_url("about.html")
        }
        then "the empty URL passes as no scheme" {
            safe_url("")
        }
        then "javascript is refused" {
            link("javascript:alert(1)") == refused("javascript:alert(1)")
        }
        then "javascript in mixed case is refused" {
            link("JaVaScRiPt:alert(1)") == refused("JaVaScRiPt:alert(1)")
        }
        then "javascript after leading whitespace is refused" {
            link(" javascript:alert(1)") == refused(" javascript:alert(1)")
        }
        then "javascript after a leading newline is refused" {
            !safe_url("\njavascript:alert(1)")
        }
        then "a tab inside the scheme is refused" {
            !safe_url("java" + from_codepoint(9) + "script:alert(1)")
        }
        then "a NUL before the scheme is refused" {
            !safe_url(from_codepoint(0) + "javascript:alert(1)")
        }
        then "data is refused" {
            link("data:text/html,<script>alert(1)</script>") == refused("data:text/html,<script>alert(1)</script>")
        }
        then "vbscript is refused" {
            !safe_url("vbscript:msgbox(1)")
        }
        then "file and ftp are refused" {
            !safe_url("file:///etc/passwd") && !safe_url("ftp://x")
        }
        then "a scheme that only starts like http is refused" {
            !safe_url("httpx://x") && !safe_url("https2:x")
        }
        then "an entity-spelled scheme is refused" {
            !safe_url("&#106;avascript:alert(1)") && !safe_url("&colon;x:y")
        }
        then "a scheme hidden behind a relative-looking prefix is still only a path" {
            safe_url("/javascript:alert(1)") &&
                link("/javascript:alert(1)") == "<a href=\"/javascript:alert(1)\">x</a>"
        }
        then "a colon-led URL is refused" {
            !safe_url(":x")
        }
        then "a refused value is escaped inside its data attribute" {
            link("javascript:\"onmouseover=\"x") == "<a href=\"#\" data-refused-url=\"javascript:&quot;onmouseover=&quot;x\">x</a>"
        }
        then "a refused image drops its source" {
            html(plain(.Image("data:image/png;base64,AA", "a"))) == "<img data-refused-url=\"data:image/png;base64,AA\" alt=\"a\">"
        }
        then "a valid URL is escaped as an attribute" {
            link("/a\"b") == "<a href=\"/a&quot;b\">x</a>"
        }
    }
    given "the title" {
        then "a closing title tag cannot end it" {
            page("</title><script>alert(1)</script>", plain(.Column))
                .contains("<title>&lt;/title&gt;&lt;script&gt;alert(1)&lt;/script&gt;</title>")
        }
        then "an ampersand escapes" {
            page("a & b", plain(.Column)).contains("<title>a &amp; b</title>")
        }
    }
}
