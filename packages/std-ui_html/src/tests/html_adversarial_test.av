// Hostile input against every string slot and every context, the
// escapers checked over an exhaustive corpus, and the shapes at both
// ends of size.
use @std.ui.{Node, Role, Setting}
use @std.text.{repeat}
use @std.ui_html.{html, css, page, escape_text, escape_attr, safe_url}

fn hostile() -> string { "\"'><script>x</script>&" }

/// Every string over the special characters and one plain one, up to length `n`.
fn words(n: int) -> List<string> {
    if n == 0 { return [""] }
    let rest = words(n - 1)
    mut out: List<string> = [""]
    for a in ["&", "<", ">", "\"", "'", "a"] {
        out = out.concat([a + w for w in rest if w != ""]).concat([a])
    }
    out
}

fn decoded(s: string) -> string {
    s
        .replace("&lt;", "<")
        .replace("&gt;", ">")
        .replace("&quot;", "\"")
        .replace("&#39;", "'")
        .replace("&amp;", "&")
}

fn specials_free(s: string) -> bool {
    !s.contains("<") && !s.contains(">") && !s.contains("\"") && !s.contains("'")
}

/// One node per string slot of every role, each holding the hostile string.
fn hostile_nodes() -> List<Node> {
    let h = hostile()
    [
        leaf(.Text(h)),
        leaf(.Heading(h, 2)),
        leaf(.Image(h, h)),
        leaf(.Image("/ok", h)),
        leaf(.Link(h, h)),
        leaf(.Link(h, "/ok")),
        leaf(.Button(h)),
        leaf(.Toggle(h, true)),
        leaf(.Field(h, h)),
        leaf(.Section(h)),
        Node { role: .Item, key: h },
    ]
}

/// The double quotes in a node's HTML.
fn quotes(n: Node) -> int { html(n).split("\"").length - 1 }

fn nested(depth: int) -> Node {
    if depth == 0 { return leaf(.Text("x")) }
    Node { role: .Column, children: [nested(depth - 1)] }
}

spec "std/ui-html adversarial" {
    given "degenerate shapes" {
        then "empty text is an empty paragraph" {
            html(leaf(.Text(""))) == "<p></p>"
        }
        then "an empty heading keeps its tag" {
            html(leaf(.Heading("", 1))) == "<h1></h1>"
        }
        then "an empty button label is an empty button" {
            html(leaf(.Button(""))) == "<button type=\"button\"></button>"
        }
        then "an empty link keeps its target" {
            html(leaf(.Link("", "/a"))) == "<a href=\"/a\"></a>"
        }
        then "an empty toggle label leaves the space" {
            html(leaf(.Toggle("", false))) == "<label><input type=\"checkbox\" role=\"switch\"> </label>"
        }
        then "an empty image source is a path with no scheme" {
            html(leaf(.Image("", ""))) == "<img src=\"\" alt=\"\">"
        }
        then "an empty page title is an empty title" {
            page("", leaf(.Column)).contains("<title></title>")
        }
        then "a heading depth at the integer ends clamps" {
            html(leaf(.Heading("x", 9223372036854775807))) == "<h6>x</h6>" &&
                html(leaf(.Heading("x", -9223372036854775807))) == "<h1>x</h1>"
        }
        then "a repeated setting repeats its class" {
            html(Node { role: .Text("x"), look: [Setting.Gap(.M), .Gap(.M)] }) == "<p class=\"gap-m gap-m\">x</p>"
        }
        then "two nested columns close in order" {
            html(nested(2)) == "<div class=\"col\"><div class=\"col\"><p>x</p></div></div>"
        }
        then "two hundred nested columns keep every open and close" {
            let out = html(nested(200))
            out.length == 200 * 23 + 8 &&
                out.starts_with("<div class=\"col\"><div") &&
                out.ends_with("</p>" + repeat("</div>", 200))
        }
        then "a thousand siblings keep their order" {
            let items = [Node { role: .Item, key: "${i}" } for i in 0..1000]
            let out = html(Node { role: .List, children: items })
            out.starts_with("<ul><li data-key=\"0\"></li><li data-key=\"1\"></li>") &&
                out.ends_with("<li data-key=\"999\"></li></ul>") &&
                out.split("<li").length == 1001
        }
        then "a long text survives whole" {
            html(leaf(.Text(repeat("<", 5000)))).length == 3 + 5000 * 4 + 4
        }
    }
    given "hostile strings in every slot" {
        then "no slot lets a script tag out" {
            hostile_nodes().all((n) -> !html(n).contains("<script"))
        }
        then "no slot lets a raw single quote out" {
            hostile_nodes().all((n) -> !html(n).contains("'"))
        }
        then "every double quote a role writes is its own" {
            ["${quotes(n)}" for n in hostile_nodes()].join(",") == "0,0,4,4,2,2,2,4,4,2,2"
        }
        then "a hostile tree inside containers stays inert" {
            let tree = Node { role: .Column, children: hostile_nodes() }
            !html(tree).contains("<script") && !page(hostile(), tree).contains("<script")
        }
        then "a hostile title cannot leave the title" {
            page(hostile(), leaf(.Column))
                .contains("<title>&quot;&#39;&gt;&lt;script&gt;x&lt;/script&gt;&amp;</title>")
        }
    }
    given "the escapers over every short string" {
        then "text escaping leaves no special character" {
            words(3).all((w) -> specials_free(escape_text(w)))
        }
        then "text escaping decodes back to the input" {
            words(3).all((w) -> decoded(escape_text(w)) == w)
        }
        then "attribute escaping is the text escaping in quotes" {
            words(3).all((w) -> escape_attr(w) == "\"${escape_text(w)}\"")
        }
        then "the corpus covers every string up to three characters" {
            words(3).length == 1 + 6 + 36 + 216
        }
    }
    given "URLs beyond the listed attacks" {
        then "a full-width scheme is refused" {
            !safe_url("ｊavascript:alert(1)")
        }
        then "a scheme with a slash before the colon is refused" {
            !safe_url("a/b:c")
        }
        then "a leading space before a relative path is a path" {
            safe_url(" /x")
        }
        then "a leading space before a colon is refused" {
            !safe_url(" /x:y") && !safe_url(" https://x")
        }
        then "a query colon with no relative prefix is refused" {
            !safe_url("x?a=b:c")
        }
        then "a URL holding an entity for its colon is only a path" {
            safe_url("javascript&colon;alert(1)") &&
                html(leaf(.Link("x", "javascript&colon;alert(1)"))) == "<a href=\"javascript&amp;colon;alert(1)\">x</a>"
        }
        then "a very long scheme is refused" {
            !safe_url(repeat("a", 10000) + ":x")
        }
    }
    given "the stylesheet" {
        then "its braces balance" {
            (css() + "x").split("{").length == (css() + "x").split("}").length
        }
        then "it declares the dark block once" {
            css().split("prefers-color-scheme: dark").length == 2
        }
        then "it can never close a style element" {
            !css().contains("</") && !css().contains("<")
        }
    }
}
