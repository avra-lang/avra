DIFF 2 — packages/std-avrac/src/compiler/workspace.av
────────────────────────────────────────────────────────────────

--- a/packages/std-avrac/src/compiler/workspace.av
+++ b/packages/std-avrac/src/compiler/workspace.av
@@ beside link_inputs / link_words @@
+/// One native step: the source, the object it becomes, and the words
+/// that make it.
+export type BuildStep = { package: string, source: string, object: string, words: List<string> }
+
+/// WHAT THE PROGRAM BUILDS BEFORE IT LINKS: every package's `[build]`
+/// promise, in package order — one step per declared source, its
+/// object DERIVED under the package's own `build/`, its flags with
+/// their `${NAME}` holes filled. A package that vendors C says here
+/// how the object `[link]` names comes to exist.
+export fn build_steps(ws: Workspace) -> List<BuildStep> {
+    flatten([package_steps(ws, pkg) for pkg in ws.packages])
+}
+
+fn package_steps(ws: Workspace, pkg: Package) -> List<BuildStep> {
+    let m = manifest(ws, pkg.ordinal)
+    [step_of(m, pkg, s) for s in native_sources(m)]
+}
+
+fn native_sources(m: Manifest) -> List<string> {
+    let n: NativeBuild? = m.native
+    if n == null { return [] }
+    n!.sources
+}
+
+fn step_of(m: Manifest, pkg: Package, source: string) -> BuildStep {
+    let from = joined_path(pkg.root, source)
+    let object = joined_path(pkg.root, "build/${stem_of(source)}.o")
+    BuildStep {
+        package: m.name, source: from, object: object,
+        words: ["-c"].concat(native_flags(m)).concat([from, "-o", object]),
+    }
+}
+
+/// A build's flags as words, `${NAME}` filled, no empty word — the
+/// same discipline `link_words` holds its own to.
+fn native_flags(m: Manifest) -> List<string> {
+    let n: NativeBuild? = m.native
+    if n == null { return [] }
+    [w for w in [expanded(f) for f in n!.flags] if !w.is_empty()]
+}

  (`expanded` is already in this file, private; `stem_of` joins the
   `@std.path` import.)

  AND ONE CHECK THE COMPILER CAN NOW MAKE, which is the point of
  putting both promises in one manifest: a `[link] objects` row that
  names a path no `[build]` step produces AND no file provides is the
  refusal a consumer gets today at the linker, in the linker's words.
  It becomes a manifest voice, at the row, before anything runs.

