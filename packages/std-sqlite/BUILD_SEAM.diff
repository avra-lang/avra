@@ beside clang_words @@
+/// THE NATIVE HALF, BUILT BEFORE THE LINK: every package's `[build]`
+/// steps in package order, each one an argv. The two call sites are
+/// `link` and `staged`, which is `avra build`, `avra test` and `avra
+/// corpus`; `avra check` links nothing and compiles no C.
+fn native_built(p: Program) -> bool {
+    build_steps(p.ws).all(step_done(it))
+}
+
+/// One step run, or skipped as fresh. A step SAYS what it compiles:
+/// a vendored amalgamation is seconds and hundreds of megabytes, and
+/// a build that goes quiet for that long reads as a hang.
+fn step_done(s: BuildStep) -> bool {
+    if fresh(s) { return true }
+    println("${s.package}: compiling ${s.source}")
+    match cc_ran(s) {
+        .Ok(x) -> stamped(s, x),
+        .Err(e) -> host_refused(e.describe().message) == 0,
+    }
+}
+
+/// FRESH TAKES BOTH ANSWERS: the object newer than its source, and the
+/// words beside it the words we would run now. An mtime alone misses a
+/// flag change; a stamp alone misses an edit.
+fn fresh(s: BuildStep) -> bool {
+    exists(s.object) && modified(s.object) >= modified(s.source) &&
+        (read_text(stamp_path(s)) catch "") == joined(s.words, "\n")
+}
+
+fn stamp_path(s: BuildStep) -> string { "${s.object}.words" }
+
+/// The C compiler over one step's words — the same tool the link uses.
+fn cc_ran(s: BuildStep) -> Result<Exit, ProcessError> {
+    (at_the_terminal(cmd(linker()?, s.words)).outcome()?).exit
+}
+
+/// A step that exited 0 leaves its words beside its object; anything
+/// else is spoken in the compiler's own output, which was inherited.
+fn stamped(x: Exit, s: BuildStep) -> bool {
+    if exit_code(x) != 0 { return false }
+    match write_text(stamp_path(s), joined(s.words, "\n")) {
+        .Ok(_) -> true,
+        .Err(_) -> false,
+    }
+}

  (`stamped` takes its arguments in the order `step_done` passes them;
   `exit_code` is whatever `judged_link` already reads an `Exit` with.)

