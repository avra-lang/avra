@@ impl Reader — beside `tools()` and `profiles()` @@
+    /// The package's own native build, or absence when it declares
+    /// none. Every source is judged here: under the root, no NUL, and
+    /// no two sharing a stem, because their objects would collide.
+    fn native() -> NativeBuild? {
+        if !self.doc.has_section("build") { return null }
+        let sources = self.words_of("build", "sources")
+        if sources.is_empty() { self.speak(self.no_sources()) }
+        for s in sources { self.judge_source(s) }
+        for s in sources { if stem_shared(sources, s) { self.speak(self.colliding_stem(s)) } }
+        NativeBuild { sources: sources, flags: self.words_of("build", "flags") }
+    }
+
+    fn judge_source(s: string) {
+        if has_nul(s) { self.speak(self.nul_in_path(s)) }
+        if !under_dir(s, ".") { self.speak(self.escaping_source(s)) }
+    }

+/// Whether another source shares this one's stem — two objects at one
+/// path, and the second overwrites the first.
+fn stem_shared(sources: List<string>, s: string) -> bool {
+    [x for x in sources if stem_of(x) == stem_of(s)].length > 1
+}
+
+/// A NUL anywhere in the text. `contains` and `index_of` are C string
+/// calls and stop at the first one, so they cannot answer this.
+fn has_nul(s: string) -> bool {
+    [i for i in 0..s.length if s.char_code(i) == 0].length > 0
+}

