//! TRANSACTIONS: a unit of work, and what happens to it when things go
//! wrong.
//!
//! A WRITE TRANSACTION BEGINS IMMEDIATE, and that is the whole reason
//! this module has two begin verbs instead of one. `BEGIN` alone is
//! DEFERRED: it takes no lock until the first statement, so two
//! connections can both start reading and then both try to promote to a
//! writer — and one gets `SQLITE_BUSY_SNAPSHOT`, which no timeout can
//! clear because the loser's read snapshot is already stale. `BEGIN
//! IMMEDIATE` takes the write lock up front, so the contention happens
//! at the START where a busy timeout can actually wait it out.
//!
//! AND A READ TRANSACTION DOES NOT REFUSE A WRITE. `begin_read` then an
//! `insert` answers `Ok(1)` — the deferred transaction simply promotes.
//! On an uncontended connection that is harmless and on a contended one
//! it is the `SQLITE_BUSY_SNAPSHOT` above, arriving mid-transaction
//! where no timeout clears it. Nothing here refuses it, because refusing
//! would mean reading the caller's SQL, and a driver that matches words
//! in a language it does not parse is a blocklist wearing a guard's
//! clothes. The verb's NAME is the contract.
//!
//! WHAT A TRAP DOES TO AN OPEN TRANSACTION, measured rather than
//! assumed: `avra_trap` exits 2 with no unwinding, so no `defer` runs,
//! no ROLLBACK is sent, and the process is gone with the transaction
//! open. SQLite's answer is the HOT JOURNAL — measured against the
//! vendored library with a real child process:
//!
//! ```
//! before the child: 1 row
//! the child exited 2, and left a journal: YES (4616 bytes)
//! after reopening:  1 row     <- the two uncommitted inserts are gone
//! a second reopen still reads: 1 row
//! ```
//!
//! So a dead process cannot leave half a transaction visible, and the
//! database is not corrupted. That is SQLITE's guarantee and not this
//! driver's, which is why it is written down with the numbers rather
//! than trusted.
use error.{Cause, SqlError, refused, barred}
use open.{Db, closed_fault}
use stmt.{run}
use c.{sqlite3_get_autocommit}

/// Whether a transaction is open on this connection. SQLite's own
/// answer — `sqlite3_get_autocommit` is zero inside one — so no flag of
/// ours can drift from the truth.
///
/// A CLOSED CONNECTION IS IN NO TRANSACTION, and the null test is what
/// says so, because C will not. `sqlite3_get_autocommit` answers 0 for a
/// handle it refuses (`SQLITE_ENABLE_API_ARMOR`, sqlite3.c:191346) and 0
/// is also its answer for a connection INSIDE one: the misuse path
/// SPENDS the value the real answer needs. Read through, every guard in
/// this module inverts on a closed handle — `begin` answered "a
/// transaction is already open on this connection" about a connection
/// that was gone, and `finish` answered 0, its word for "nothing was
/// open", to a cleanup path that had cleaned up nothing.
export fn in_transaction(db: Db) -> bool {
    if db.raw.get() == null { return false }
    sqlite3_get_autocommit(db.raw.get()) == 0
}

/// A WRITE transaction begun. Takes the write lock now, so a busy
/// database is a wait at the start rather than a stale-snapshot failure
/// in the middle.
export fn begin(db: Db) -> Result<int, SqlError> { started(db, "begin immediate") }

/// A READ transaction begun — deferred, taking no lock until the first
/// statement. Correct for a connection that only reads, and wrong for
/// one that might write, which is why it says `read` in its name.
export fn begin_read(db: Db) -> Result<int, SqlError> { started(db, "begin deferred") }

/// The work kept.
///
/// A FAILED COMMIT MAY LEAVE THE TRANSACTION OPEN, and which failures do
/// is not a caller's to remember. `SQLITE_BUSY` — another connection
/// reading while this one tries to promote — is answered with the
/// transaction STILL STANDING, measured:
///
/// ```
/// commit under a standing reader   sqlite.busy: database is locked
///   still in a transaction?        true
///   finish afterwards              1     <- there was one to roll back
/// ```
///
/// while a constraint failure, a full disk and an I/O error have already
/// rolled back by the time they answer. So a caller who catches this
/// calls `finish`, which asks autocommit and sends the right verb or
/// none. Carrying on instead leaves a write transaction holding the
/// database for the life of the connection, and every later write joins
/// work the caller believes was ended.
export fn commit(db: Db) -> Result<int, SqlError> {
    let _ = barred(closed_fault(db))?
    if !in_transaction(db) { fail nothing_to_keep }
    run(db, "commit")
}

/// The work thrown away. Answers nothing when no transaction is open,
/// because a rollback of nothing is what a caller means when they are
/// cleaning up after a failure they did not cause.
export fn rollback(db: Db) -> Result<int, SqlError> {
    if !in_transaction(db) { return 0 }
    run(db, "rollback")
}

/// A transaction begun only if one is not already open. Answers whether
/// it opened one, and `finish_if_opened` is what that answer is FOR —
/// an inner scope that ends a transaction it was handed rolls back its
/// caller's work with nothing reporting it.
export fn begin_unless_open(db: Db) -> Result<bool, SqlError> {
    if in_transaction(db) { return false }
    let _ = begin(db)?
    true
}

/// THE CLEANUP THAT CANNOT SEND THE WRONG VERB. Ends whatever is open,
/// or does nothing when nothing is — so a failure path calls this and
/// never has to know whether the commit got far enough to have already
/// rolled back.
///
/// This is the shape T69 asks for: ASK AUTOCOMMIT FIRST, and never let
/// a "cannot rollback" message replace the real error a caller was
/// about to be told.
export fn finish(db: Db) -> int {
    if !in_transaction(db) { return 0 }
    rolled_back(db)
}

/// THE CLEANUP FOR A SCOPE THAT MAY NOT OWN THE TRANSACTION — the other
/// half of `begin_unless_open`, and what makes its answer a value rather
/// than advice.
///
/// `finish` ends WHATEVER is open, which is right for the driver that
/// owns the connection and wrong for a nested helper. Measured, with the
/// helper cleaning up through `finish`:
///
/// ```
/// inner opened one?        false
/// inner called finish      1        <- it rolled back its CALLER's work
/// outer still open?        false
/// a later write            Ok(1)    <- and ran in autocommit, silently
/// ```
///
/// No error is raised anywhere along that path: the outer scope's
/// transaction becomes a run of independent auto-committed writes, and
/// its own `commit` then finds nothing to keep.
export fn finish_if_opened(db: Db, opened: bool) -> int {
    if !opened { return 0 }
    finish(db)
}

fn rolled_back(db: Db) -> int {
    match rollback(db) {
        .Ok(n) -> n,
        .Err(_) -> 0,
    }
}

fn started(db: Db, sql: string) -> Result<int, SqlError> {
    let _ = barred(closed_fault(db))?
    if in_transaction(db) { fail already_open }
    run(db, sql)
}

// ── The voices ──────────────────────────────────────────────────

const nothing_to_keep: SqlError = refused(Cause.NoTransaction, "`commit` found no transaction open — either none was begun, or the database ended it under you after the error it already reported")

const already_open: SqlError = refused(Cause.TransactionOpen, "a transaction is already open on this connection — nesting wants a savepoint, which is a later slice")
