// The first code in this package that opens a real database.
//
// What it can assert today is the CONNECTION's own story: a handle
// arrives, a bad path is refused before SQLite sees it, a missing file
// under read-only fails rather than being created, and closing answers
// zero. What it CANNOT assert is that the file is a database — that is
// T127, opening is lazy, and the check needs a statement.
use @std.io.{exists, write_text, remove}
use @std.sqlite.open.{Db, Mode, OpenConfig, config_at, open, open_read, memory, open_with, close}
use @std.sqlite.stmt.{Stmt, prepare, finalize}
use @std.sqlite.error.{SqlError}

/// A fresh in-memory database handed to `work`, or the kind the OPEN
/// itself failed with. FOURTEEN COPIES OF THIS SHAPE stood across six
/// files in this suite; it lives here because a connection is what it
/// makes, and test files share one module so every file reaches it.
///
/// It answers `string` because that is what fourteen of the seventeen
/// answered. The other three take their own type and stay spelled out:
/// a helper generic in the answer would need `absent` as a second
/// parameter, which is more ceremony than the ladder it replaces.
fn in_memory(work: fn(Db) -> string) -> string {
    match memory() {
        .Ok(db) -> work(db),
        .Err(e) -> e.cause.kind(),
    }
}

/// Whether an open succeeded, having closed whatever it got.
fn opens(r: Result<Db, SqlError>) -> bool {
    match r {
        .Ok(db) -> closed(db),
        .Err(_) -> false,
    }
}

/// `close` writes through its receiver, so the handle must sit in a
/// place that can be nulled — `F2048` refuses a `let`.
fn closed(db: Db) -> bool {
    mut held = db
    close(held) == 0
}

/// Closing the SAME binding twice: the second finds a nulled handle,
/// does nothing, and answers zero. This is the half of the double-close
/// the type actually closes.
fn closed_twice(db: Db) -> bool {
    mut held = db
    close(held) == 0 && close(held) == 0
}

/// The kind an open was refused with, or the word for success.
fn open_kind(r: Result<Db, SqlError>) -> string {
    match r {
        .Ok(db) -> opened_word(db),
        .Err(e) -> e.cause.kind(),
    }
}

fn opened_word(db: Db) -> string {
    mut held = db
    ok_after(close(held))
}

fn ok_after(rc: int) -> string { "OPENED" }

/// An open whose handle is closed twice, through one binding.
fn opens_and_closes_twice(r: Result<Db, SqlError>) -> bool {
    match r {
        .Ok(db) -> closed_twice(db),
        .Err(_) -> false,
    }
}

fn a_path() -> string { "/tmp/avra-sqlite-conn-test.db" }
fn absent() -> string { "/tmp/avra-sqlite-absent-conn.db" }
fn not_a_db() -> string { "/tmp/avra-sqlite-notadb-conn.db" }

/// The fixture files, made and removed by the cases that need them.
fn made(path: string, text: string) -> bool { (write_text(path, text) catch "") != "" }
fn gone(path: string) -> bool { (remove(path) catch "") != "" }

// ── S2 TRIPWIRES ────────────────────────────────────────────────
//
// TWO DESTRUCTORS IN THIS PACKAGE HAVE THE SAME SHAPE: guard on null,
// call the C destructor, null the handle. `close` (open.av) and
// `finalize` (stmt.av). Each is safe against a SECOND call through the
// SAME binding, and the suite proves that elsewhere.
//
// NEITHER IS SAFE AGAINST A COPY, and today that does not bite for a
// reason outside this package: `mut b = a` ALIASES rather than copies —
// lane C's S2 receiver-aliasing hole. So nulling through `b` nulls `a`
// too, and the second call finds nothing to free.
//
// THE DAY S2 LANDS AND COPIES COPY, `a.raw` still holds a freed pointer
// and the second call is a DOUBLE FREE inside a std package. These two
// cases assert TODAY'S answer, so they FAIL the day the aliasing goes —
// which is the notice, and it is aimed at whoever takes S2.

/// Closing through a copy, and what the original still holds.
fn close_through_a_copy() -> string { in_memory(aliased_close) }

fn aliased_close(db: Db) -> string {
    mut a = db
    mut b = a
    let first = close(b)
    let original_nulled = a.raw == null
    let second = close(a)
    "first=${first} second=${second} original_nulled=${original_nulled}"
}

/// Finalizing through a copy, and what the original still holds.
fn finalize_through_a_copy() -> string { in_memory(aliased_finalize) }

fn aliased_finalize(db: Db) -> string {
    mut held = db
    let said = with_statement(db)
    let _ = close(held)
    said
}

fn with_statement(db: Db) -> string {
    match prepare(db, "select 1") {
        .Ok(s) -> aliased_stmt(s),
        .Err(e) -> e.cause.kind(),
    }
}

fn aliased_stmt(s: Stmt) -> string {
    mut a = s
    mut b = a
    let first = finalize(b)
    let original_nulled = a.raw == null
    let second = finalize(a)
    "first=${first} second=${second} original_nulled=${original_nulled}"
}

spec "std/sqlite connection" {

    given "the S2 tripwires — these must FAIL when copies stop aliasing" {
        // Both pass today BECAUSE `mut b = a` aliases. When lane C's S2
        // lands and copies copy, `original_nulled` goes false and the
        // second call double-frees. Do not "fix" these by updating the
        // string: the failure is the point, and the fix is a handle a
        // copy cannot outlive.
        then "closing a copy nulls the original too, which is what saves us" { close_through_a_copy() == "first=0 second=0 original_nulled=true" }
        then "finalizing a copy nulls the original too" { finalize_through_a_copy() == "first=0 second=0 original_nulled=true" }
    }

    given "a database in memory" {
        // It dies with the connection, so it is a verb rather than a
        // path a caller could spell by accident.
        then "it opens" { opens(memory()) }
        then "and closing answers zero" { opens(memory()) }
        then "two of them are independent" { opens(memory()) && opens(memory()) }
        // The half of the double-close this type DOES close: `close`
        // nulls its receiver, so the second call finds nothing to do.
        then "closing the same binding twice is safe" { opens_and_closes_twice(memory()) }
    }

    given "a database in a file" {
        then "the fixture starts absent" { gone(a_path()) || !exists(a_path()) }
        then "opening creates it" { opens(open(a_path())) }
        then "and the file is on disk afterwards" { exists(a_path()) }
        then "opening it again finds it" { opens(open(a_path())) }
        then "read-only opens an existing file" { opens(open_read(a_path())) }
        then "open-existing opens it too" { opens(open_with(config_at(a_path()) with { mode: Mode.OpenExisting })) }
        then "and it can be cleaned up" { gone(a_path()) }
    }

    given "a file that is not there" {
        // T129: the default flags carry CREATE, so "open it and see"
        // CREATES the file. Read-only is the existence check that does
        // not create what it asks about — measured, rc=14 CANTOPEN.
        then "the fixture is absent" { !exists(absent()) }
        then "read-only fails" { open_kind(open_read(absent())) == "sqlite.cant_open" }
        then "and the file is STILL absent" { !exists(absent()) }
        then "open-existing fails the same way" { open_kind(open_with(config_at(absent()) with { mode: Mode.OpenExisting })) == "sqlite.cant_open" }
        then "and still creates nothing" { !exists(absent()) }
    }

    given "a path the door refuses before SQLite sees it" {
        then "an empty path" { open_kind(open("")) == "sqlite.empty_path" }
        then "`:memory:` spelled as a path" { open_kind(open(":memory:")) == "sqlite.empty_path" }
        then "a `file:` path" { open_kind(open("file:/tmp/x.db")) == "sqlite.uri_path" }
        then "and none of them reached the library" { !exists("file:/tmp/x.db") }
    }

    given "a file that is not a database — T127, now CLOSED" {
        // OPENING IS LAZY: SQLite records the filename and allocates,
        // and the header is not read until a statement needs the schema.
        // So this file used to OPEN CLEANLY and fail at the caller's
        // first query, blaming the query.
        //
        // THESE CASES USED TO ASSERT THAT, on purpose, with the note
        // that they would flip the day `open` ran its one trivial
        // statement. It runs one now — `select count(*) from
        // sqlite_schema` — and they flipped, which is how the closure
        // was noticed rather than remembered.
        then "the fixture is a text file" { made(not_a_db(), "this is not a database") }
        then "and it is REFUSED at open, not at the first query" { open_kind(open(not_a_db())) == "sqlite.not_a_database" }
        then "the file is unharmed by the attempt" { exists(not_a_db()) }
        then "cleaned up" { gone(not_a_db()) }
    }

    given "the probe that closes T127 does not disturb a real database" {
        // It costs one page read and must leave nothing behind: no open
        // statement, and no file where there was none.
        then "a fresh file still opens" { opens(open(a_path())) }
        then "and opens again, so the probe finalized" { opens(open(a_path())) }
        then "an in-memory database passes it too" { opens(memory()) }
        then "read-only passes it on an existing file" { opens(open_read(a_path())) }
        then "cleaned up" { gone(a_path()) }
    }
}
