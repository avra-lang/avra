// PENDING — the extension is not `.av`, so no tool globs it and no
// suite can run it. Rename it to `sqlite_face_test.av` the day the face
// below exists; nothing else marks it and nothing else needs to.
//
// This file is the FFI slice's DEFINITION OF DONE, written before the
// code so the landing is measured rather than declared. What it waits
// on. TWO OF THE THREE HAVE LANDED:
//
//   out-parameters   LANDED — the `mut` extern seat. `open`/`close` are
//                    built on it and the connection suite passes.
//   sized widths     LANDED — `sqlite3_error_offset`'s -1 is -1 now.
//   the sentinel     WAITING — `SQLITE_TRANSIENT` is `(void*)-1` and has
//                    no spelling, and `SQLITE_STATIC` is the UNSAFE half,
//                    so no bind verb ships before the mint (CENSUS §10).
//
// What these cases still wait on is the STATEMENT slice — `prepare`,
// `step`, `finalize` and the column reads — not a language gap. The
// `given` blocks for `open`/`close` below are now covered for real by
// `sqlite_connection_test.av`; they stay here because they assert the
// FACE's shape (`Db`, the causes) rather than the wall's.
//
// Every case cites the trap it defends against, by number, from the
// semantics research. The behaviour asserted is SQLite's DOCUMENTED
// behaviour, never this driver's preference.
//
// FIVE CAUSES THE DESIGN DOES NOT YET HAVE. §4.2's `Cause` is a
// REGISTRY with no `_ ->`, and it has no arm for the driver's own
// refusal of a caller's argument — which §3 and §7 promise five times.
// These cases name the kinds those arms must mint:
// `sqlite.empty_path`, `sqlite.uri_path`, `sqlite.many_statements`,
// `sqlite.no_statement`, `sqlite.rows_discarded`.
use @std.io.{exists, write_text}
use @std.sqlite.{open, open_read, memory, version, sql, Db, Row, SqlValue, SqlError}

// ── The fixtures ────────────────────────────────────────────────

/// One table, three rows, and ONE column holding three storage
/// classes — integer, text and NULL. That is what SQLite permits and
/// what a typed read must refuse rather than coerce (T1, T14).
fn seeded() -> Result<Db, SqlError> {
    let db = memory()?
    db.run(sql("create table t (id integer primary key, a, b text)"))?
    db.run(sql("insert into t (a, b) values (?, ?)").args([.Int(1), .Text("one")]))?
    db.run(sql("insert into t (a, b) values (?, ?)").args([.Text("two"), .Text("2")]))?
    db.run(sql("insert into t (a, b) values (?, ?)").args([.Null, .Text("three")]))?
    db
}

/// The empty triple as three rows: SQL NULL, the empty string, the
/// zero-length blob (T96, T97, T29).
fn empties() -> Result<Db, SqlError> {
    let db = memory()?
    db.run(sql("create table e (v)"))?
    db.run(sql("insert into e values (null), (''), (x'')"))?
    db
}

/// A file that is not a database. Answers its path.
fn not_a_database() -> string {
    write_text("/tmp/avra-sqlite-not-a-db.db", "this is not a database") catch "/tmp/avra-sqlite-not-a-db.db"
}

fn absent_path() -> string { "/tmp/avra-sqlite-absent.db" }

// ── The projections a `then` reads through ──────────────────────

/// The dotted kind a failure names, or empty text when it did not
/// fail. `Cause` carries payloads, so it does not compare with `==`
/// ("`==` compares scalars for now" — help: "only an enum carrying
/// nothing compares"); `kind()` is the design's own projection and it
/// is what a caller matches by prefix.
fn kind_of<T>(r: Result<T, SqlError>) -> string {
    match r {
        .Ok(_) -> "",
        .Err(e) -> e.cause.kind(),
    }
}

/// Whether the failure carried a span into its SQL — `at`, which is
/// absent exactly when `sqlite3_error_offset` answered -1.
fn spanned<T>(r: Result<T, SqlError>) -> bool {
    match r {
        .Ok(_) -> false,
        .Err(e) -> e.at != null,
    }
}

fn ran(text: string) -> Result<int, SqlError> { (seeded()?).run(sql(text)) }

/// A whole script through the verb that owns the `pzTail` loop — its
/// answer is the number of statements that RAN, so a skipped empty one
/// is visible as a count rather than as an error.
fn script(text: string) -> Result<int, SqlError> { (seeded()?).exec(text) }
fn run_kind(text: string) -> string { kind_of(ran(text)) }
fn open_kind(path: string) -> string { kind_of(open(path)) }

fn one_row(text: string) -> Result<Row, SqlError> { (seeded()?).one(sql(text)) }
fn one_text(text: string) -> Result<string, SqlError> { (one_row(text)?).text(0) }
fn one_int(text: string) -> Result<int, SqlError> { (one_row(text)?).int(0) }

fn first_row(text: string) -> Result<Row?, SqlError> { (seeded()?).first(sql(text)) }
fn first_absent(text: string) -> bool { (first_row(text) catch null) == null }
fn first_text(text: string) -> Result<string, SqlError> { ((first_row(text)?)!).text(0) }

fn scalar_int(text: string) -> Result<int, SqlError> { ((seeded()?).scalar(sql(text))?).int() }

/// Each row's storage class as SQLite itself names it — the answer the
/// driver must agree with, taken from SQL rather than from the wall.
fn classes_in_e() -> List<string> {
    [text_at(r, 0) for r in (empties()?).all(sql("select typeof(v) from e order by rowid"))?] catch []
}

fn text_at(r: Row, i: int) -> string { r.text(i) catch "?" }

/// The class the driver reports for the one row matching a `typeof`.
fn class_of(which: string) -> string {
    (((empties()?).one(sql("select v from e where typeof(v) = ?").args([.Text(which)]))?).class().name()) catch "?"
}

/// The empty string's length, read back through the face.
fn empty_text_length() -> Result<int, SqlError> {
    (((empties()?).one(sql("select v from e where typeof(v) = 'text'"))?).text(0)?).length
}

spec "std/sqlite face" {

    given "the face and the wall answering for ONE library" {
        // A driver bound to the host's SQLite answers differently per
        // machine (README, the vendoring decision). The version the
        // face reports is the version it opens databases with.
        then "the version is the vendored one" { version() == "3.53.4" }
        then "an in-memory database opens against it" { memory_opens() }
    }

    given "a path, before anything is opened" {
        // T125 — the EMPTY PATH IS SPENT. SQLite reads `""` as "a
        // private temporary on-disk database, deleted at close". A
        // config with a missing `path =` key then runs, succeeds at
        // every write, and loses everything at shutdown, silently.
        then "an empty path is refused by name" { open_kind("") == "sqlite.empty_path" }
        // The two temporary forms are separately named verbs, so a
        // caller asks for one instead of spelling it as a path.
        then "`:memory:` as a path is refused; `memory()` is the verb" { open_kind(":memory:") == "sqlite.empty_path" }
        // T130 — URI filenames change what a path MEANS (`?mode=ro`,
        // `?cache=shared`). A caller's path is a path.
        then "a path beginning `file:` is refused, never reinterpreted" { open_kind("file:x.db?mode=ro") == "sqlite.uri_path" }
    }

    given "opening a file that is not a database" {
        // T127 — OPENING IS LAZY. `sqlite3_open_v2` records the filename
        // and allocates; the header is not read until a statement needs
        // the schema, so the shell opens a text file without complaint
        // and fails at prepare with SQLITE_NOTADB (26). A driver whose
        // health check is "did open succeed" blames the first query.
        then "the fixture is on disk" { exists(not_a_database()) }
        then "open fails, and it fails AT OPEN" { open_kind(not_a_database()) == "sqlite.not_a_database" }
    }

    given "asking whether a database exists" {
        // T129 — the default flags carry CREATE, so "open it and see"
        // CREATES a zero-byte file, and a zero-byte file is a valid
        // empty database. From then on the answer is always yes.
        then "a read-only open of a missing file fails" { kind_of(open_read(absent_path())) == "sqlite.cant_open" }
        then "and the file is still not there" { !exists(absent_path()) }
    }

    given "a statement that answers no rows" {
        // §7 — `run` answers `sqlite3_changes64`: rows this statement
        // changed DIRECTLY. Trigger, foreign-key and REPLACE side
        // effects are not counted (T164, LAW Q5).
        then "an insert answers the rows it wrote" { (ran("insert into t (a) values (9)") catch 0) == 1 }
        then "a delete of nothing answers zero" { (ran("delete from t where id = 9999") catch (0 - 1)) == 0 }
        then "a create answers zero rather than a count of nothing" { (ran("create table u (x)") catch (0 - 1)) == 0 }
        // `sqlite3_column_count` says at PREPARE time whether a
        // statement yields rows (K5), so a SELECT through `run` is
        // refused before it runs instead of throwing its rows away.
        then "a select through `run` is refused, naming the verb that reads" { run_kind("select 1") == "sqlite.rows_discarded" }
    }

    given "`run` is ONE statement, and SQL that is not one" {
        // T36 — `prepare` compiles only the FIRST statement, and
        // `pzTail` is the only way to learn there was a second. A driver
        // that ignores it runs one and reports success for both.
        then "two statements in one call are refused" { run_kind("insert into t (a) values (1); insert into t (a) values (2)") == "sqlite.many_statements" }
        then "a trailing semicolon is not a second statement" { (ran("insert into t (a) values (1);") catch 0) == 1 }
        // T37 — comment-only or empty SQL prepares to a NULL statement
        // with rc = SQLITE_OK, and stepping that pointer is a crash.
        // THE ANSWER SPLITS BY VERB, and the split is deliberate: `run`
        // was asked to run ONE statement and there is none, so "prepared
        // to NULL and did nothing" would be the silent wrong answer the
        // other arms exist to catch. The script verb skips instead —
        // the `exec` block below, same trap, opposite answer.
        then "empty SQL is refused, not stepped" { run_kind("") == "sqlite.no_statement" }
        then "comment-only SQL is refused, not stepped" { run_kind("-- nothing here") == "sqlite.no_statement" }
        then "whitespace-only SQL is refused, not stepped" { run_kind("   ") == "sqlite.no_statement" }
    }

    given "`exec` is a SCRIPT, and a script legitimately holds both" {
        // T37's own defence, which is the opposite of `run`'s: "prepare
        // returning OK with a NULL statement means 'nothing to run' —
        // skip it and continue the loop". Refusing here would break
        // every migration file that ends in a comment or a newline,
        // which the research names as the symmetric bug.
        then "a script of two statements runs both" { (script("insert into t (a) values (7); insert into t (a) values (8)") catch 0) == 2 }
        then "a trailing comment is skipped, not refused" { (script("insert into t (a) values (7);\n-- done") catch (0 - 1)) == 1 }
        then "a trailing newline is skipped, not refused" { (script("insert into t (a) values (7);\n\n") catch (0 - 1)) == 1 }
        then "a leading comment is skipped too" { (script("-- migration 004\ninsert into t (a) values (7)") catch (0 - 1)) == 1 }
        then "a script of nothing but comments runs nothing, and that is not an error" { (script("-- nothing\n-- at all") catch (0 - 1)) == 0 }
        then "empty script text runs nothing, and that is not an error" { (script("") catch (0 - 1)) == 0 }
        // T36 again, from the other side: the script verb is the one
        // that OWNS the pzTail loop, so it must reach the last statement.
        then "the last statement of a script really ran" { (scalar_int("select count(*) from t where a = 8") catch 0) >= 0 }
    }

    given "where a failing statement failed" {
        // T84 — `sqlite3_error_offset` gives a byte offset into the SQL
        // for a parse error and -1 where no token is to blame. CENSUS.md
        // §11: that -1 crosses the wall as 4294967295 unless the seat is
        // sized, so absence must be ABSENCE and not a span 4 GB in.
        then "a parse error carries a span" { spanned(ran("select from")) }
        then "an error with no token carries none" { !spanned(ran("insert into nosuchtable values (1)")) }
        then "and it is still a syntax-free failure with its own kind" { run_kind("insert into nosuchtable values (1)") == "sqlite.other" }
    }

    given "one row asked for and one row there" {
        then "the row comes back" { (one_text("select b from t where a = 1") catch "") == "one" }
        then "its integer cell reads as an integer" { (one_int("select id from t where a = 1") catch 0) > 0 }
        then "the seeded rows are all there" { (scalar_int("select count(*) from t") catch (0 - 1)) == 3 }
    }

    given "one row asked for and the wrong number there" {
        // §7 — a query that meant `limit 1` and did not say so is a bug
        // this refuses instead of hiding behind "the first one".
        then "no row is its own cause" { kind_of(one_row("select b from t where a = 999")) == "sqlite.no_row" }
        then "a second row is its own cause" { kind_of(one_row("select b from t")) == "sqlite.many_rows" }
        // `first` is the verb that means "or nothing", lawful because
        // `Result<Row?, E>` is (§5.4).
        then "`first` answers absence instead of failing" { first_absent("select b from t where a = 999") }
        then "`first` stops after one row" { (first_text("select b from t order by id") catch "") == "one" }
    }

    given "a scalar over no rows" {
        // T95 — `sum()` of nothing is NULL, not 0. A reader that coerces
        // answers 0 for "there was no data", which is the right answer
        // to a different question.
        then "sum of nothing refuses rather than answering zero" { kind_of(scalar_int("select sum(id) from t where id = 999")) == "sqlite.mismatch" }
        then "count of nothing really is zero" { (scalar_int("select count(*) from t where id = 999") catch (0 - 1)) == 0 }
    }

    given "the empty triple, written and read back" {
        // T96, T97 — SQL NULL, `''` and `x''` are THREE values, and
        // `sqlite3_column_blob` answers a NULL pointer for all three of
        // "SQL NULL", "zero-length blob" and "out of memory". A read
        // that tests the POINTER cannot tell them apart, so the class is
        // asked FIRST, always (probe log §2a).
        then "three rows go in and three classes come out" { classes_in_e() == ["null", "text", "blob"] }
        then "the driver agrees with SQLite about the text row" { class_of("text") == "text" }
        then "and about the blob row" { class_of("blob") == "blob" }
        then "and about the null row" { class_of("null") == "null" }
        then "the empty string reads as empty text, never as absence" { (empty_text_length() catch (0 - 1)) == 0 }
    }

    given "a column holding more than one storage class" {
        // T1, T14 — a column has AFFINITY, not a type. A typed read
        // refuses the rows that do not match and names the class it
        // found; it coerces nothing.
        then "the integer row reads as an integer" { (one_int("select a from t where id = 1") catch 0) == 1 }
        then "the text row refuses an integer seat" { kind_of(one_int("select a from t where id = 2")) == "sqlite.mismatch" }
        then "the null row refuses one too" { kind_of(one_int("select a from t where id = 3")) == "sqlite.mismatch" }
    }

    given "a column index that is not there" {
        // §6 / C1 — the width is the witness: `sqlite3_data_count` is 0
        // before the first row, 0 after DONE and 0 after a reset, so one
        // guard refuses both "column 7 of 4" and "no row standing".
        then "an index past the row's width is refused by name" { kind_of(read_at("select id from t where a = 1", 7)) == "sqlite.out_of_row" }
        then "a column name the result set does not have is refused" { kind_of(read_named("select id from t where a = 1", "nope")) == "sqlite.no_column" }
    }
}

// ── The last two projections, kept beside the cases they serve ──

fn memory_opens() -> bool {
    match memory() {
        .Ok(_) -> true,
        .Err(_) -> false,
    }
}

fn read_at(text: string, i: int) -> Result<int, SqlError> { (one_row(text)?).int(i) }
fn read_named(text: string, name: string) -> Result<SqlValue, SqlError> { (one_row(text)?).get(name) }
