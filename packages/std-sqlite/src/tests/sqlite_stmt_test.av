// A statement compiled, stepped, read and finalized — the first time
// this driver reads a VALUE out of a database.
//
// `column_text` and `column_blob` hand back BORROWED pointers whose
// buffers die at the next step, so every cell that is text or octets is
// COPIED into a box of ours before the driver answers it. The class is
// asked first and the copy is made second, which is what lets an empty
// value and an absent one be different answers.
use @std.sqlite.open.{Db}
use @std.sqlite.stmt.{Stmt}
use @std.sqlite.error.{Storage, SqlError}

/// A cell's CLASS and what the matching read answers — the length of
/// the box, or the kind the read was refused with. A class the reads
/// disagree with shows both refusals, which is the NULL case.
fn cell(sql: string) -> string { in_memory((db) -> class_and_read(db, sql)) }

fn class_and_read(db: Db, sql: string) -> string {
    let said = match db.prepare(sql) {
        .Ok(s) -> cell_of_row(s),
        .Err(e) -> e.cause.kind(),
    }
    let _ = db.close()
    said
}

fn cell_of_row(s: Stmt) -> string {
    let _ = s.step()
    let word = cell_class_word(s.class_at(0))
    let said = match s.class_at(0) {
        .Ok(c) -> "${word}|${read_by_class(s, c)}",
        .Err(e) -> e.cause.kind(),
    }
    let _ = s.finalize()
    said
}

fn read_by_class(s: Stmt, c: Storage) -> string {
    match c {
        .Text -> "text:${text_len_word(s.text_at(0))}",
        .Blob -> "blob:${octet_len_word(s.blob_at(0))}",
        .Null -> "text:${text_len_word(s.text_at(0))}|blob:${octet_len_word(s.blob_at(0))}",
        .Int or .Real -> "scalar",
    }
}

fn text_len_word(r: Result<string, SqlError>) -> string {
    match r { .Ok(v) -> "${v.length}", .Err(e) -> e.cause.kind() }
}

fn octet_len_word(r: Result<Bytes, SqlError>) -> string {
    match r { .Ok(v) -> "${v.length}", .Err(e) -> e.cause.kind() }
}

fn cell_class_word(r: Result<Storage, SqlError>) -> string {
    match r {
        .Ok(c) -> cell_class_named(c),
        .Err(e) -> e.cause.kind(),
    }
}

fn cell_class_named(c: Storage) -> string {
    match c {
        .Int -> "int",
        .Real -> "real",
        .Text -> "text",
        .Blob -> "blob",
        .Null -> "null",
    }
}

/// One integer out of a one-row query, or the kind it was refused with.
fn scalar(sql: string) -> string { in_memory((db) -> read_one(db, sql)) }

fn read_one(db: Db, sql: string) -> string {
    let said = said_by(db, sql)
    let _ = db.close()
    said
}

fn said_by(db: Db, sql: string) -> string {
    match db.prepare(sql) {
        .Ok(s) -> stepped_int(s),
        .Err(e) -> e.cause.kind(),
    }
}

fn stepped_int(s: Stmt) -> string {
    let said = first_int(s)
    let _ = s.finalize()
    said
}

fn first_int(s: Stmt) -> string {
    match s.step() {
        .Ok(more) -> if more { told(s.int_at(0)) } else { "NO ROW" },
        .Err(e) -> e.cause.kind(),
    }
}

fn told(r: Result<int, SqlError>) -> string {
    match r {
        .Ok(v) -> "${v}",
        .Err(e) -> e.cause.kind(),
    }
}

/// Column 0 of a one-row query read as a FLOAT, or the refusal's kind.
fn real_scalar(sql: string) -> string { in_memory((db) -> real_said_by(db, sql)) }

fn real_said_by(db: Db, sql: string) -> string {
    match db.prepare(sql) {
        .Ok(s) -> stepped_real(s),
        .Err(e) -> e.cause.kind(),
    }
}

fn stepped_real(s: Stmt) -> string {
    let said = first_real(s)
    let _ = s.finalize()
    said
}

fn first_real(s: Stmt) -> string {
    match s.step() {
        .Ok(more) -> if more { told_real(s.real_at(0)) } else { "NO ROW" },
        .Err(e) -> e.cause.kind(),
    }
}

fn told_real(r: Result<float, SqlError>) -> string {
    match r {
        .Ok(v) -> "${v}",
        .Err(e) -> e.cause.kind(),
    }
}

/// The class of column 0 of a one-row query, as a word.
fn class_word_of(sql: string) -> string { in_memory((db) -> classed(db, sql)) }

fn classed(db: Db, sql: string) -> string {
    let said = class_said(db, sql)
    let _ = db.close()
    said
}

fn class_said(db: Db, sql: string) -> string {
    match db.prepare(sql) {
        .Ok(s) -> class_stepped(s),
        .Err(e) -> e.cause.kind(),
    }
}

fn class_stepped(s: Stmt) -> string {
    let said = class_after_step(s)
    let _ = s.finalize()
    said
}

fn class_after_step(s: Stmt) -> string {
    match s.step() {
        .Ok(more) -> if more { named(s.class_at(0)) } else { "NO ROW" },
        .Err(e) -> e.cause.kind(),
    }
}

fn named(r: Result<Storage, SqlError>) -> string {
    match r {
        .Ok(c) -> word(c),
        .Err(e) -> e.cause.kind(),
    }
}

fn word(c: Storage) -> string {
    match c {
        .Int -> "int",
        .Real -> "real",
        .Text -> "text",
        .Blob -> "blob",
        .Null -> "null",
    }
}

spec "std/sqlite statement" {
    given "a value read out of a database" {

        then "one is one" { scalar("select 1") == "1" }
        then "arithmetic arrives" { scalar("select 2 + 3") == "5" }
        then "a negative arrives as a negative" { scalar("select 0 - 7") == "-7" }
        // 64 bits, exactly — this is the width work arriving where a
        // caller can see it. A 32-bit read would wrap this to 1.
        then "a value past 32 bits survives" { scalar("select 4294967297") == "4294967297" }
        then "the largest signed 64-bit integer survives" { scalar("select 9223372036854775807") == "9223372036854775807" }
        then "a count over the schema works" { scalar("select count(*) from sqlite_schema") == "0" }
    }
    given "a real cell read as a float" {

        then "a fraction arrives" { real_scalar("select 1.5") == "1.5" }
        then "a real that is a whole number keeps its class" { real_scalar("select 3.0") == "3.0" }
        then "arithmetic over reals arrives" { real_scalar("select 1.5 + 2.25") == "3.75" }
        then "avg over integers is a real" { real_scalar("select avg(v) from (select 1 as v union all select 2)") == "1.5" }
        // THE REFUSAL IS THE DESIGN. An INTEGER cell read as a double
        // loses precision above 2^53, and nothing in the answer says
        // so — accepting it would be an implicit widen at the boundary,
        // decided by the driver, on a value from outside. The language
        // refuses the same widen inside itself:  does not
        // compile.
        then "an integer is refused rather than widened" { real_scalar("select 1") == "sqlite.mismatch" }
        then "sum over integers is an integer, and refused" { real_scalar("select sum(v) from (select 1 as v union all select 2)") == "sqlite.mismatch" }
        then "text is refused" { real_scalar("select 'hi'") == "sqlite.mismatch" }
        then "null is refused" { real_scalar("select null") == "sqlite.mismatch" }
    }
    given "a query that answers no row" {

        then "an empty result steps straight to done" { scalar("select 1 where 0") == "NO ROW" }
    }
    given "the class is asked first, and a wrong read is refused" {

        then "an integer is an integer" { class_word_of("select 1") == "int" }
        then "a real is a real" { class_word_of("select 1.5") == "real" }
        then "text is text" { class_word_of("select 'hi'") == "text" }
        then "a blob is a blob" { class_word_of("select x'00ff'") == "blob" }
        then "null is null" { class_word_of("select null") == "null" }
        // The cell holds one class and the read asked for another. It
        // is refused rather than coerced to zero — which is what a
        // driver that tested the POINTER would answer.
        then "reading text as an integer is refused" { scalar("select 'hi'") == "sqlite.mismatch" }
        then "reading a blob as an integer is refused" { scalar("select x'00ff'") == "sqlite.mismatch" }
        then "reading NULL as an integer is refused" { scalar("select null") == "sqlite.mismatch" }
        // A real IS a number, and it is still not an integer.
        then "reading a real as an integer is refused" { scalar("select 1.5") == "sqlite.mismatch" }
    }
    given "an empty value is an EMPTY BOX, and only SQL NULL is absence" {

        // THE FIRST CASES WRITTEN FOR THIS READ, and the reason the
        // class is asked before the pointer: `sqlite3_column_blob`
        // answers a NULL POINTER for SQL NULL and for a ZERO-LENGTH
        // BLOB alike, so a read that branched on the pointer would
        // spend absence twice and hand an empty blob back as `null`.
        then "an empty text is text, and it is empty" { cell("select ''") == "text|text:0" }
        then "an empty blob is a blob, and it is empty" { cell("select x''") == "blob|blob:0" }
        then "SQL NULL is neither, and both reads refuse it by class" { cell("select null") == "null|text:sqlite.mismatch|blob:sqlite.mismatch" }
        then "text that is there reads its own length" { cell("select 'abc'") == "text|text:3" }
        then "and octets that are there read theirs" { cell("select x'00ff41'") == "blob|blob:3" }
    }
    given "a column index outside the row" {

        then "column 7 of a row 1 wide is refused" { scalar_at("select 1", 7) == "sqlite.out_of_row" }
        then "a negative column is refused" { scalar_at("select 1", 0 - 1) == "sqlite.out_of_row" }
    }
    given "text that is not one statement" {

        then "two statements are refused" { scalar("select 1; select 2") == "sqlite.many_statements" }
        then "comment-only text is refused" { scalar("-- nothing") == "sqlite.no_statement" }
        then "empty text is refused" { scalar("") == "sqlite.no_statement" }
        // The parser, not a `;` scan: this is ONE statement.
        then "a semicolon inside a literal is one statement" { scalar("select length('a;b')") == "3" }
    }
    given "SQL the database refuses" {

        then "a syntax error names itself" { scalar("select from") == "sqlite.syntax" }
        // SQLITE_ERROR is SQLite's GENERIC code, so `syntax` is wider
        // than its name — a missing table lands here too. What tells
        // them apart is the token offset, which a parse error has and
        // a missing table does not.
        then "a missing table is SQLite's generic error" { scalar("select * from nosuchtable") == "sqlite.syntax" }
    }
}

/// A read at a chosen column, so the out-of-row guard can be aimed.
fn scalar_at(sql: string, col: int) -> string { in_memory((db) -> at_col(db, sql, col)) }

fn at_col(db: Db, sql: string, col: int) -> string {
    let said = col_said(db, sql, col)
    let _ = db.close()
    said
}

fn col_said(db: Db, sql: string, col: int) -> string {
    match db.prepare(sql) {
        .Ok(s) -> col_stepped(s, col),
        .Err(e) -> e.cause.kind(),
    }
}

fn col_stepped(s: Stmt, col: int) -> string {
    let said = col_after_step(s, col)
    let _ = s.finalize()
    said
}

fn col_after_step(s: Stmt, col: int) -> string {
    match s.step() {
        .Ok(more) -> if more { told(s.int_at(col)) } else { "NO ROW" },
        .Err(e) -> e.cause.kind(),
    }
}
