// A connection waits out a lock another holds, unless it asked not to.
use @std.io.{make_dirs}
use @std.sqlite.open.{Db, Journal, OpenConfig}
use @std.sqlite.sql.{sql}
use @std.time.{now_ns}

once fn busy_default_base() -> string {
    let d = "/tmp/avra-sqlite-busy-default-test/${now_ns()}"
    let _ = make_dirs(d)
    d
}

/// The wait in milliseconds `db` was given.
fn wait_of(db: Db) -> string {
    match db.scalar(sql("PRAGMA busy_timeout")) {
        .Ok(v) -> match v.int() { .Ok(n) -> "${n}", .Err(e) -> e.message },
        .Err(e) -> e.message,
    }
}

/// The wait, in milliseconds, a connection opened by `open` is given.
fn waited_by_default() -> string {
    match Db.open("${busy_default_base()}/default.db") {
        .Ok(db) -> wait_of(db),
        .Err(e) -> e.message,
    }
}

/// The wait of a connection opened with `busy` set.
fn waited_when_set() -> string {
    let c = OpenConfig.config_at("${busy_default_base()}/set.db") with { busy: 0 }
    match Db.open_with(c) { .Ok(db) -> wait_of(db), .Err(e) -> e.message }
}

/// The journal mode of a connection opened with `journal`, by the file's own word.
fn journal_of(name: string, journal: Journal) -> string {
    let c = OpenConfig.config_at("${busy_default_base()}/${name}.db") with { journal: journal }
    match Db.open_with(c) {
        .Ok(db) -> match db.scalar(sql("PRAGMA journal_mode")) {
            .Ok(v) -> match v.text() { .Ok(s) -> s, .Err(e) -> e.message },
            .Err(e) -> e.message,
        },
        .Err(e) -> e.message,
    }
}

spec "std/sqlite busy default" {
    given "a connection opened with `open`" {
        then "it waits five seconds for a held lock" { waited_by_default() == "5000" }
    }
    given "a connection opened with `busy: 0`" {
        then "it is refused at once" { waited_when_set() == "0" }
    }
    given "a file opened for writing" {
        then "it is kept in a write-ahead log by default" { journal_of("wal", .Wal) == "wal" }
        then "and in a rollback journal when asked" { journal_of("delete", .Rollback) == "delete" }
    }
}
