// The red team's record for @std/sqlite's library-wide surface.
// Two findings drove the wall's shape: a C answer that can be NULL
// declared `string` kills the process in `strlen` (the fix is the
// declaration — `string?` — because Avra's absent pointer IS the C
// null), and a borrowed immortal `const char*` survives every retain
// path only because `hdr` refuses a header without its tag.
use @std.text.{from_codepoint, from_codepoints}
use @std.sqlite.{version, compiled_with, compile_options, is_complete, describe, is_keyword, like, glob, equal_nocase, keyword_count}
use @std.sqlite.c.{sqlite3_keyword_check, sqlite3_stricmp, sqlite3_complete}
use @std.sqlite.error.{SqlError}

/// Text holding a NUL, which no literal can spell. The five lossy
/// primitives (`==`, `contains`, `index_of`, `split`, `replace`) stop
/// at it; the C wall stops at it too, and both must agree.
fn with_nul() -> string { from_codepoints([115, 101, 108, 101, 99, 116, 0, 120]) }

/// A word held only in a header-less C string is what the wall hands
/// back; holding it across a list, a struct field and a fn seat is
/// the retain path that a foreign pointer must survive.
type Held = { text: string }

fn through(s: string) -> string { s }

/// The borrowed version text, put through every path that retains.
fn retained() -> List<string> {
    let v = version()
    [v, through(v), Held { text: v }.text, v + ""]
}

/// A borrowed answer held across work that would clobber a reused
/// buffer. `describe(5)` is "database is locked"; if the pointer were
/// per-call scratch, walking the option table would overwrite it.
fn held_survives_options() -> bool {
    let held = describe(5)
    let churn = compile_options().length
    held == "database is locked" && churn > 0
}

fn held_survives_describes() -> bool {
    let held = describe(5)
    let churn = [describe(c).length for c in 0..40].length
    held == "database is locked" && churn == 40
}

fn version_survives() -> bool {
    let held = version()
    let churn = [describe(c).length for c in 0..40].length
    held == "3.53.4" && churn == 40
}

/// The face's answer, with a refusal reading as `false`.
fn adv_complete_says(sql: string) -> bool { is_complete(sql) catch false }

/// The kind the face refuses a text with, or the word for an answer.
fn complete_kind(sql: string) -> string {
    match is_complete(sql) {
        .Ok(_) -> "ANSWERED",
        .Err(e) -> e.cause.kind(),
    }
}

/// The WALL's own answer, unguarded — this is C's behaviour and the
/// place it is asserted.
fn wall_completes(sql: string) -> bool { sqlite3_complete(sql) == 1 }

spec "std/sqlite adversarial" {
    given "a C answer that can be NULL" {
        // sqlite3_compileoption_get(N) answers NULL past the last
        // option. Declared `-> string`, reading `.length` on it dies
        // in strlen; declared `-> string?`, the niche and the C
        // convention are the same value.
        then "walking the option list to its end does not die" { compile_options().length > 0 }
        then "the walk ends where the library says, not at a guess" { compile_options().length < 200 }
        then "no option in the list is empty text" { [o for o in compile_options() if o.is_empty()].length == 0 }
    }

    given "a borrowed pointer SQLite owns and never frees" {
        then "it survives a list, a struct field, a fn seat and a concat" { retained().length == 4 }
        then "and every one of them still reads as the version" { [s for s in retained() if s.starts_with("3.53.4")].length == 4 }
        then "its length comes out right without a header" { version().length == 6 }
    }

    given "empty text at every door — the empty case written first" {
        then "empty SQL is not a complete statement" { !adv_complete_says("") }
        then "empty text is not a keyword" { !is_keyword("") }
        then "an empty option name is not carried" { !compiled_with("") }
        then "LIKE of empty against empty matches" { like("", "") }
        then "LIKE of empty against text does not" { !like("", "a") }
        then "GLOB of empty against empty matches" { glob("", "") }
        then "NOCASE holds two empties equal" { equal_nocase("", "") }
    }

    given "a `const char*` seat that CARRIES a length" {
        // `select\0x` is eight bytes. Passing the honest length puts
        // the NUL inside the compared region, so the wall judges all
        // eight — which is why the face never passes -1 and never
        // lets C measure an Avra string.
        then "Avra measures the whole text" { with_nul().length == 8 }
        then "the face passes the honest length, so it is no keyword" { !is_keyword(with_nul()) }
        then "the same bytes cut at the NUL ARE a keyword" { sqlite3_keyword_check(with_nul().bytes(), 6) != 0 }
        then "a lone NUL is one byte to us" { from_codepoint(0).length == 1 }
        then "and one byte to the wall too, so it is no keyword" { !is_keyword(from_codepoint(0)) }
    }

    given "a `const char*` seat with NO length — the language refuses the crossing" {
        // THE WALL'S HALF OF THE NUL LAW, AND WHAT BECAME OF IT. Avra's
        // string carries its length; C's ends at the first NUL, so a
        // seat with no companion length read the C half and a longer
        // Avra string smuggled a shorter C one across. THE SEAM NOW
        // TRAPS THAT CROSSING — a bare `const char*` seat is checked
        // against the header's length — so the wall-level cases that
        // ASSERTED the truncation cannot be asserted from a suite any
        // more: they end the process. They live in `tools/traps.sh`,
        // which exists for exactly that, and what stays here is the
        // half a suite can hold.
        //
        // A LIBRARY REFUSES BEFORE THE LANGUAGE TRAPS. These faces
        // answer a `Result` with a named cause, because the driver
        // knows WHY the seat resolves; the seam's trap is the floor
        // for a package that has not thought about it. Neither makes
        // the other redundant — and the trap firing inside a package
        // that has guards is a bug in the guards.
        then "the face refuses those bytes rather than answering about a prefix" { complete_kind("select 1;${from_codepoint(0)} select") == "sqlite.holds_nul" }
        then "and answers ordinary text as before" { complete_kind("select 1;") == "ANSWERED" }
        then "though Avra still sees every byte of it" { "select 1;${from_codepoint(0)} select".length == 17 }
        then "and the two Avra strings the wall could not tell apart are still different lengths" { "DQS=0${from_codepoint(0)}x".length != "DQS=0".length }
    }

    given "codes and options nobody promised" {
        then "a negative result code still answers text" { describe(0 - 1) == "unknown error" }
        then "a huge result code still answers text" { describe(2147483647).length > 0 }
        then "an option name that is a prefix of a real one is not carried" { !compiled_with("ENABLE_FTS") }
        then "the keyword count is a real count, not a sentinel" { keyword_count() > 100 && keyword_count() < 1000 }
    }

    given "a C `int` read at its own width" {
        // THESE CASES USED TO PIN A LIE. C writes 32 bits and neither
        // ABI promises the half above, so a declared `int` read
        // `sqlite3_stricmp("a","b")` — which is -1 — as 4294967295, and
        // both engines agreed on the wrong answer, which is why
        // `eval == native` could never catch it. The old cases asserted
        // the wrong values on purpose, with the note that the day the
        // extern wall carried sized types they would fail.
        //
        // The wall carries them now, the two cases failed exactly as
        // written, and these are their replacements. A comparison
        // answers a COMPARISON again.
        then "a negative comparison is negative" { sqlite3_stricmp("a", "b") < 0 }
        then "and it is not the widened lie it used to be" { sqlite3_stricmp("a", "b") != 4294967295 }
        then "a positive comparison is positive" { sqlite3_stricmp("b", "a") > 0 }
        then "equal text compares equal" { sqlite3_stricmp("a", "a") == 0 }
        then "so ordering by the wall's own answer is right now" { sqlite3_stricmp("a", "b") < sqlite3_stricmp("b", "a") }
        then "and the face's equality is unaffected either way" { equal_nocase("Ada", "aDA") && !equal_nocase("a", "b") }
    }

    given "an IMMORTAL borrowed pointer, measured rather than cited" {
        // The four `-> string` declarations are permitted only because
        // the text is static for the life of the process. That is read
        // in the amalgamation, and it is ASSERTED here: an Avra `string`
        // from the wall IS the C pointer, with no copy anywhere, so if
        // SQLite reused the memory these would change under us.
        then "a code's words survive walking the whole option table" { held_survives_options() }
        then "and survive describing forty other codes" { held_survives_describes() }
        then "two calls for one code answer the same text" { describe(5) == describe(5) }
        then "different codes still answer differently" { describe(5) != describe(7) }
        then "the version survives the same traffic" { version_survives() }
    }

    given "the three verbs that stopped at a NUL — their trigger fired" {
        // `strlike`, `strglob` and `stricmp` are C string calls with no
        // length, so both arguments ended at the first NUL and text
        // compared equal to its own prefix. This group PINNED that lie
        // and recorded its own TRIGGER for changing it: "a `Bytes`
        // value, or a caller who meets it."
        //
        // THE TRIGGER FIRED. The seam checks every bare `const char*`
        // seat against the header's length and traps the crossing, so
        // the lie is no longer reachable to assert — a suite cannot
        // hold a case that ends the process. The demonstrations moved
        // to `tools/traps.sh`; what stays is the behaviour on text
        // these verbs can answer about honestly.
        then "all three are honest about text with no NUL in it" { equal_nocase("abcd", "abcd") && !equal_nocase("abcd", "ab") }
        then "LIKE and GLOB agree on the same bytes" { like("ab", "ab") && glob("ab", "ab") }
        then "and Avra still measures what C would not have seen" { "ab${from_codepoint(0)}cd".length == 5 }
    }

    given "patterns that make the operators work" {
        then "LIKE takes _ as one character" { like("a_c", "abc") }
        then "LIKE's _ is one, not many" { !like("a_c", "abbc") }
        then "GLOB takes ? as one character" { glob("a?c", "abc") }
        then "GLOB takes a character class" { glob("a[bc]d", "abd") }
        then "a pattern of only wildcards matches empty" { like("%", "") }
    }
}
