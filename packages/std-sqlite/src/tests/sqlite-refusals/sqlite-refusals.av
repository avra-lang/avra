// proves: what @std/sqlite REFUSES, and what each refusal says. A
// driver's error surface is as much its contract as its happy path —
// this is the program a caller reads to learn what a `SqlError` looks
// like before they meet one. Native only: the driver is FFI and the
// evaluator cannot host an extern.
use @std.sqlite.open.{Db, memory, open, open_read, close}
use @std.sqlite.stmt.{Stmt, prepare, step, finalize, run, bind_int, int_at, class_at}
use @std.sqlite.error.{SqlError, Cause}
use @std.sqlite.script.{statements}
use @std.text.{from_codepoint}

fn nul() -> string { from_codepoint(0) }

/// A refusal shown as a caller sees it: the kind it branches on, then
/// the sentence it prints.
fn shown(name: string, e: SqlError) -> string { "${name}\n  ${e.cause.kind()}\n  ${e.message}" }

/// What opening a path answers.
fn opening(name: string, path: string) -> string {
    match open(path) {
        .Ok(db) -> "${name}\n  OPENED${shut(db)}",
        .Err(e) -> shown(name, e),
    }
}

fn shut(db: Db) -> string {
    mut held = db
    closed_word(close(held))
}

fn closed_word(rc: int) -> string { "" }

/// What a statement verb answers, run against a live database.
fn on(db: Db, name: string, act: fn(Db) -> Result<int, SqlError>) -> string {
    match act(db) {
        .Ok(n) -> "${name}\n  OK ${n}",
        .Err(e) -> shown(name, e),
    }
}

fn two_statements(db: Db) -> Result<int, SqlError> { run(db, "select 1; select 2") }
fn only_a_comment(db: Db) -> Result<int, SqlError> { run(db, "-- nothing here") }
fn rows_thrown_away(db: Db) -> Result<int, SqlError> { run(db, "select 1") }
fn a_syntax_error(db: Db) -> Result<int, SqlError> { run(db, "select from") }

/// Reading text as an integer.
fn wrong_class(db: Db) -> Result<int, SqlError> {
    mut s = prepare(db, "select 'apple'")?
    let v = first(s)
    let _ = finalize(s)
    v
}

/// A column past the row's width.
fn past_the_row(db: Db) -> Result<int, SqlError> {
    mut s = prepare(db, "select 1")?
    let _ = step(s)?
    let v = int_at(s, 7)
    let _ = finalize(s)
    v
}

/// A cell read with NO ROW STANDING — the width is zero there, so one
/// guard covers both.
fn before_stepping(db: Db) -> Result<int, SqlError> {
    mut s = prepare(db, "select 1")?
    let v = int_at(s, 0)
    let _ = finalize(s)
    v
}

/// A parameter index outside the statement's slots.
fn wrong_hole(db: Db) -> Result<int, SqlError> {
    mut s = prepare(db, "select ?1")?
    let v = bind_int(s, 4, 1)
    let _ = finalize(s)
    v
}

/// A statement used after it was destroyed.
fn after_finalize(db: Db) -> Result<int, SqlError> {
    mut s = prepare(db, "select 1")?
    let _ = finalize(s)
    let _ = step(s)?
    0
}

fn first(s: Stmt) -> Result<int, SqlError> {
    let more = step(s)?
    if !more { return 0 }
    int_at(s, 0)
}

/// A script whose bytes change meaning at the C boundary.
fn nul_script() -> string {
    match statements("select 1;${nul()} select 2;") {
        .Ok(xs) -> "a script holding a NUL\n  ACCEPTED ${xs.length}",
        .Err(e) -> shown("a script holding a NUL", e),
    }
}

fn told() -> string {
    match memory() {
        .Ok(db) -> every(db),
        .Err(e) -> shown("could not open", e),
    }
}

fn every(db: Db) -> string {
    mut d = db
    let paths = "${opening("an empty path", "")}\n${opening("`:memory:` written as a path", ":memory:")}\n${opening("a `file:` path", "file:/tmp/x.db")}"
    let verbs = "${on(d, "two statements where one is meant", two_statements)}\n${on(d, "text holding no statement", only_a_comment)}\n${on(d, "a row-yielding statement run for a count", rows_thrown_away)}\n${on(d, "SQL the database refuses", a_syntax_error)}"
    let reads = "${on(d, "text read as an integer", wrong_class)}\n${on(d, "a column past the row", past_the_row)}\n${on(d, "a cell read before stepping", before_stepping)}"
    let binds = "${on(d, "a parameter outside the slots", wrong_hole)}\n${on(d, "a statement used after finalize", after_finalize)}"
    let rc = close(d)
    "${paths}\n${verbs}\n${reads}\n${binds}\n${nul_script()}\nclosed ${rc}"
}

told()
