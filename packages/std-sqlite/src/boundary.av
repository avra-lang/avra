//! WHAT THE GUARDS MUST SEE. Avra's `string` carries its length; C's
//! ends at the first NUL. So a value crossing into C is judged by the
//! callee on DIFFERENT BYTES than a guard built from the lossy
//! primitives read.
//!
//! NUL-SAFE, because they read the header: `.length`, `char_code`,
//! `starts_with`, `ends_with`, `trim`, `+`.
//! NUL-LOSSY, because they are C string calls: `==`, `contains`,
//! `index_of`, `split`, `replace`.
//!
//! THE RULE: a guard and the thing it guards must read the same bytes.
//! Where the callee is C, that means judging the whole string and
//! refusing anything C would truncate — a value whose meaning changes at
//! the boundary is not a value anyone meant to pass.
//!
//! A NUL HAS NO LITERAL SPELLING. `"\0x"` is THREE characters —
//! backslash, `0`, `x` — so `@std/text`'s `from_codepoint` and
//! `from_codepoints` are the only way to mint one.
//!
//! This was not theoretical. A path `from_codepoints([0, 120])` — a NUL
//! then an `x`, length 2 — passed a door built from `==`, and reached
//! SQLite as the EMPTY STRING: the private temporary database deleted at
//! close, which is the exact trap that door exists to prevent.

/// Whether the text holds a NUL anywhere, read with the primitives that
/// can see one.
export fn has_nul(s: string) -> bool { [s.char_code(i) for i in 0..s.length].any(it == 0) }

/// Whether the text is nothing but blanks — space, tab, newline,
/// carriage return. A CHARACTER test, never a reading of SQL.
export fn is_blank(s: string) -> bool { [s.char_code(i) for i in 0..s.length].all(blank_code(it)) }

fn blank_code(c: int) -> bool { c == 32 || c == 9 || c == 10 || c == 13 }


// ── The pointer sentinels ───────────────────────────────────────
//
// Two of SQLite's arguments are POINTER VALUES rather than pointers to
// anything: the destructor seat of every `bind_*` and `result_*` takes
// either `SQLITE_STATIC` — `(void*)0` — or `SQLITE_TRANSIENT` —
// `(void*)-1` — and SQLite COMPARES the value before it would ever call
// through it (`vendor/sqlite3.h:6429-6430`).

/// A pointer at a literal address, which is what a sentinel is.
extern fn avra_ptr_at(address: int) -> ptr?

/// `SQLITE_TRANSIENT`: SQLite COPIES the bytes before the bind returns,
/// so nothing the caller holds has to outlive anything. This is the
/// default every bind should take.
export fn transient() -> ptr? { avra_ptr_at(0 - 1) }

/// `SQLITE_STATIC`: the caller promises the bytes stay valid until the
/// statement is finalized or the parameter is rebound
/// (`vendor/sqlite3.h:4946-4950`). Avra cannot enforce that promise —
/// a released box is a use-after-free INSIDE SQLite, where the
/// runtime's refcounter is blind by construction — so this is a named
/// hatch and never a default.
export fn static_bytes() -> ptr? { null }

// ONE THING TO KNOW BEFORE A REAL CALLBACK IS EVER BOUND.
// `SQLITE_TRANSIENT` is a FUNCTION pointer type, and clang SIGNS
// function pointers on arm64e — it does not sign pointers to ordinary
// data. `(void*)-1` is safe here only because SQLite compares it and
// never calls through it. The day this driver binds a real destructor,
// or any other C callback, that stops being true and the pointer has to
// be signed like the function pointer it is.
