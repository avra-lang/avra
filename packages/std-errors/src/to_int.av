//! The `Error` view of the prelude's `ToInt`. It lives beside `errors.av`,
//! so the sources the test harness vendors as `@std/errors` stay free of
//! `ToInt`, which only a real package sees.
impl Error for ToInt {
    fn describe() -> ErrorInfo {
        match self {
            .NotANumber -> info("to_int.not_a_number", "a NaN has no int"),
            .TooLarge(v) -> info("to_int.too_large", "${v} is past the largest int"),
            .TooSmall(v) -> info("to_int.too_small", "${v} is below the smallest int"),
        }
    }
}
