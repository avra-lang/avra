//! @std.io — the host's streams, files and environment, as values.
//!
//! Printing is the prelude's (`println`/`eprintln`, no `use`). A file
//! is read whole (`read_text`) or written whole (`write_text` — through a sibling
//! temp file and a rename, so a reader never sees half of it). A
//! directory is listed in byte order (`list_dir`), made along its
//! whole path (`make_dirs`), and a path is asked what stands there
//! (`kind_of`, `exists`, `is_file`, `is_dir`) or removed (`remove`).
//! The environment answers absence honestly: `env` is a `string?`.
//! Every refusal is an `IoError` naming the path; a writing verb
//! answers the path it wrote, so one feeds the next —
//! `remove(write_text(p, t)?)`. That answer is a `Result`, so reading
//! it parenthesises the propagation: `(write_text(p, t)?).length`.
use @std.errors.{Error, ErrorInfo, info}
use @std.text.{nul_at}

// THIS PACKAGE'S OWN C (src/c/std_io.c) — every one answers an int: a
// status, a descriptor, a handle, a kind, or a negative errno. No text
// and no bytes cross here.
extern fn avra_io_kind(path: string) -> int
extern fn avra_io_open(path: string) -> int
extern fn avra_io_stamp(path: string) -> int
extern fn avra_io_close(fd: int) -> int
extern fn avra_io_mkdir(path: string) -> int
extern fn avra_io_remove(path: string) -> int
extern fn avra_io_temp(path: string) -> int
extern fn avra_io_temp_fd(h: int) -> int
extern fn avra_io_commit(h: int) -> int
extern fn avra_io_drop(h: int) -> int
extern fn avra_io_env_set(name: string) -> int
extern fn avra_io_open_append(path: string) -> int
extern fn avra_fd_sync(fd: int) -> int
extern fn avra_io_truncate(path: string, len: int) -> int
extern fn avra_io_open_beneath(root: string, rel: string) -> int
extern fn avra_io_fd_kind(fd: int) -> int
extern fn avra_io_fd_size(fd: int) -> int
extern fn avra_io_fd_mtime(fd: int) -> int
extern fn avra_io_seek(fd: int, at: int) -> int
extern fn avra_io_compile_slot() -> int

// THE RUNTIME'S OWN, which mint or answer immortal text — the only
// doors through which bytes become a value. `avra_io_list` is the one
// io row core keeps, because a directory entry's name flows through no
// descriptor; it leaves the day the adoption row lands.
extern fn avra_io_list(path: string) -> int
extern fn avra_fd_read(fd: int, max: int) -> int
extern fn avra_fd_taken(token: int) -> Bytes
extern fn avra_fd_write(fd: int, bytes: Bytes, from: int) -> int
extern fn avra_utf8_bad_at(b: Bytes) -> int
extern fn avra_host_env(name: string) -> string
extern fn avra_errno_text(err: int) -> string

// ── Streams ─────────────────────────────────────────────────────

// ── Refusals ────────────────────────────────────────────────────

/// Why the host refused, with the path it refused.
export enum IoError {
    NotFound(path: string)
    Denied(path: string)
    IsDirectory(path: string)
    NotDirectory(path: string)
    NotText(path: string, at: int)
    Holed(path: string, at: int)
    Failed(path: string, errno: int)
}

impl Error for IoError {
    fn describe() -> ErrorInfo {
        match self {
            .NotFound(p) -> info("io.not_found", "`${p}` does not exist"),
            .Denied(p) -> info("io.denied", "`${p}` may not be accessed"),
            .IsDirectory(p) -> info("io.is_directory", "`${p}` is a directory"),
            .NotDirectory(p) -> info("io.not_directory", "`${p}` is not a directory"),
            .NotText(p, at) -> info("io.not_text", "`${p}` is not UTF-8 — byte ${at}"),
            .Holed(p, at) -> info(
                "io.holed",
                "a path holding a NUL is two paths — the host reads to byte ${at} and no further",
            ),
            .Failed(p, e) -> info("io.failed", "`${p}`: ${avra_errno_text(e)}"),
        }
    }
}

/// A PATH THE HOST WILL READ AS ONE PATH, or a refusal. A NUL makes
/// it TWO: this face measures the header's length and C stops at the
/// NUL, so a caller who checked the visible text checked something
/// the host never sees. Measured before this door existed — a
/// 79-byte path ending `/../../etc/passwd` read a 5-byte file and
/// `exists` answered true for a path that does not exist, on BOTH
/// engines, which is agreement rather than correctness.
///
/// JUDGED OVER THE BYTES. A door built from `==`, `is_empty` or
/// `contains` reads the C string and stops at the same NUL it is
/// there to catch — the guard and the guarded must read the same
/// bytes.
export fn one_path(path: string) -> Result<string, IoError> {
    let at = path.bytes().index_of([0].bytes()!, 0)
    if at >= 0 { fail IoError.Holed(path, at) }
    path
}

/// The host's status judged: a refusal raises, naming the path.
fn done(path: string, status: int) -> Result<int, IoError> {
    if status < 0 { fail refused(path, 0 - status) }
    status
}

/// An errno as the refusal it means.
export fn refused(path: string, errno: int) -> IoError {
    if errno == enoent { return IoError.NotFound(path) }
    if errno == eacces || errno == eperm { return IoError.Denied(path) }
    if errno == eisdir { return IoError.IsDirectory(path) }
    if errno == enotdir { return IoError.NotDirectory(path) }
    IoError.Failed(path, errno)
}

const eperm: int = 1
export const enoent: int = 2
export const eacces: int = 13
export const enotdir: int = 20
const eisdir: int = 21

// ── Paths ───────────────────────────────────────────────────────

/// What stands at a path.
export enum Entry {
    Missing
    File
    Dir
    Other
}

export fn kind_of(path: string) -> Result<Entry, IoError> {
    entry_of(done(path, avra_io_kind(one_path(path)?))?)
}

fn entry_of(kind: int) -> Entry {
    match kind { 0 -> Entry.Missing, 1 -> Entry.File, 2 -> Entry.Dir, _ -> Entry.Other }
}

/// A FILE'S STAMP — its size, its times and its inode as one number — or null
/// when there is no telling: the path is no file, or it moved within the last
/// two seconds, where two writes can wear one time. One path under one stamp
/// is the same bytes, so a reader that kept what it made of them need not read
/// them again.
export fn stamp(path: string) -> int? {
    let held = one_path(path) catch ""
    if held.is_empty() { return null }
    let s = avra_io_stamp(held)
    if s <= 0 { null } else { s }
}

/// Whether anything stands at the path — one the host will not
/// describe counts as absent.
export fn exists(path: string) -> bool {
    !(standing(path) is .Missing)
}

export fn is_file(path: string) -> bool {
    standing(path) is .File
}

export fn is_dir(path: string) -> bool {
    standing(path) is .Dir
}

fn standing(path: string) -> Entry {
    kind_of(path) catch Entry.Missing
}

// ── Files ───────────────────────────────────────────────────────

/// The whole file as text.
///
/// READING A FIFO OR A DEVICE WITH NO WRITER BLOCKS, and there is no
/// timeout — ask `kind_of` what stands there first.
export fn read_text(path: string) -> Result<string, IoError> {
    text_of(path, read_bytes(path)?)
}

/// The whole file as OCTETS — the lossless door, and the one to
/// reach for when the file is not text. `read_text` is this verb plus
/// a UTF-8 check, so the two can never drift about what a file holds.
///
/// READING A FIFO OR A DEVICE WITH NO WRITER BLOCKS, and there is no
/// timeout — ask `kind_of` what stands there first.
export fn read_bytes(path: string) -> Result<Bytes, IoError> {
    let fd = done(path, avra_io_open(one_path(path)?))?
    defer avra_io_close(fd)
    drained(path, fd)
}

/// Every byte the descriptor gives, to its end. A read answers a
/// TOKEN and the take mints from it once, so the loop takes each
/// landing before asking for the next — a token held across a second
/// read is stale and traps.
///
/// THE LANDINGS ARE KEPT AND GATHERED ONCE, never concatenated as
/// they arrive: growing one box per landing re-copies everything
/// before it, which is quadratic in the file and invisible on a file
/// small enough to land in one turn. One gather allocates the exact
/// total and copies each byte once.
fn drained(path: string, fd: int) -> Result<Bytes, IoError> {
    mut parts: List<Bytes> = []
    mut token = done(path, avra_fd_read(fd, chunk()))?
    while token > 0 {
        parts.push(avra_fd_taken(token))
        token = done(path, avra_fd_read(fd, chunk()))?
    }
    parts.bytes()
}

// ── Beneath a root ──────────────────────────────────────────────

/// A descriptor opened for reading, and what stood there when it was
/// opened: its kind, its size in octets and its modification time in
/// seconds. Close it with `close`.
export type Opened = { fd: int, kind: Entry, size: int, mtime: int }

/// `rel` opened for reading BENEATH the directory `root`, never above
/// it: `rel` is `/`-separated segments walked one at a time without
/// following a symlink, so `..`, `.`, an empty segment, a leading `/`
/// and a symlink anywhere below the root all refuse — a caller handing
/// in a path from a request cannot name a file the root does not hold.
/// A FIFO opens without blocking; ask `kind` what was opened.
export fn open_beneath(root: string, rel: string) -> Result<Opened, IoError> {
    let fd = done(rel, avra_io_open_beneath(one_path(root)?, one_path(rel)?))?
    let kind = entry_of(done(rel, avra_io_fd_kind(fd)) catch 3)
    Opened { fd: fd, kind: kind, size: avra_io_fd_size(fd), mtime: avra_io_fd_mtime(fd) }
}

impl Opened {
    /// At most `n` octets from offset `from` — fewer only at the file's
    /// end.
    fn span(from: int, n: int) -> Result<Bytes, IoError> {
        done("", avra_io_seek(self.fd, from))?
        mut parts: List<Bytes> = []
        mut left = n
        while left > 0 {
            let token = done("", avra_fd_read(self.fd, min_of(left, chunk())))?
            if token == 0 { return parts.bytes() }
            let got = avra_fd_taken(token)
            left = left - got.length
            parts.push(got)
        }
        parts.bytes()
    }

    fn close() { let _ = avra_io_close(self.fd) }
}

fn min_of(a: int, b: int) -> int { if a < b { a } else { b } }

/// A file's bytes as text. TEXT THAT IS NOT TEXT IS A REFUSAL, and
/// the refusal CARRIES THE OFFSET: `at` is the first byte that is not
/// UTF-8, which is what a reader needs when one file among hundreds
/// is wrong. Asking `.text()` and failing on its null would throw
/// exactly that away.
///
/// IT IS ONE WALK OVER THE ASSEMBLED BYTES, not one per chunk read.
/// A multi-byte character may STRADDLE a chunk boundary, and
/// `utf8_bad_at` cannot tell a truncated sequence from an invalid
/// one — so validating each landing would refuse a good file whose
/// character fell across the seam. A resumable validator would let
/// this fold into the read; there is none, and the ask is recorded.
fn text_of(path: string, raw: Bytes) -> Result<string, IoError> {
    let at = avra_utf8_bad_at(raw)
    if at >= 0 { fail IoError.NotText(path, at) }
    raw.text()!
}

/// The read's bite. A megabyte is the descriptor scratch's own size,
/// so a whole small file lands in one turn and a large one in as few
/// as the scratch allows.
fn chunk() -> int { 1048576 }

/// The text written whole — a reader sees the old file or the new,
/// never half. Answers the path.
export fn write_text(path: string, text: string) -> Result<string, IoError> {
    write_bytes(path, text.bytes())
}

/// OCTETS written whole, the same publish-or-remove as `write_text`
/// and its lossless twin: bytes that are not text still reach a file.
/// Answers the path.
export fn write_bytes(path: string, bytes: Bytes) -> Result<string, IoError> {
    let h = done(path, avra_io_temp(one_path(path)?))?
    // DROPPING IS THE DEFAULT AND COMMITTING THE DELIBERATE ACT: a
    // `?` below runs this before it leaves, and an uncommitted temp
    // is REMOVED. A deferred commit here would publish a truncated
    // file over the reader's data, in code that reads as careful.
    defer avra_io_drop(h)
    let fd = done(path, avra_io_temp_fd(h))?
    poured(path, fd, bytes)?
    done(path, avra_io_commit(h))?
    path
}

/// The bytes handed to the descriptor from the front, however many
/// turns it takes — a short write is normal and not an error.
fn poured(path: string, fd: int, bytes: Bytes) -> Result<int, IoError> {
    mut at = 0
    while at < bytes.length {
        at = at + done(path, avra_fd_write(fd, bytes, at))?
    }
    at
}

/// OCTETS appended after the file's current end, created if absent —
/// never a rewrite of what was already there, so a caller's own
/// growing content is never copied to append a small addition. NOT
/// durable on its own: the write reaches the OS's page cache, not
/// necessarily the device, until a caller asks `synced` for it —
/// call that once for a whole batch of appends, never once per
/// append. Answers the path, the same convention as `write_bytes`.
export fn append_bytes(path: string, bytes: Bytes) -> Result<string, IoError> {
    let fd = done(path, avra_io_open_append(one_path(path)?))?
    defer avra_io_close(fd)
    poured(path, fd, bytes)?
    path
}

/// Every byte appended to `path` since the last `synced` (or ever)
/// made durable on the device — a crash after this returns cannot
/// lose them. The cost of durability paid ONCE for however many
/// `append_bytes` calls came before it, not once per call.
export fn synced(path: string) -> Result<string, IoError> {
    let fd = done(path, avra_io_open_append(one_path(path)?))?
    defer avra_io_close(fd)
    done(path, avra_fd_sync(fd))?
    path
}

/// An append-mode descriptor held OPEN across many writes — the cost
/// of `open`/`close` paid once for a whole session of `append_bytes`
/// calls, not once per call, the same shape `append_bytes` itself
/// gives durability.
export type AppendFile = { path: string, fd: int }

export fn opened_for_append(path: string) -> Result<AppendFile, IoError> {
    let clean = one_path(path)?
    let fd = done(clean, avra_io_open_append(clean))?
    AppendFile { path: clean, fd: fd }
}

impl AppendFile {
    /// OCTETS appended after the file's current end. NOT durable on
    /// its own — the same convention `append_bytes` keeps.
    fn write(bytes: Bytes) -> Result<int, IoError> { poured(self.path, self.fd, bytes) }

    fn synced() -> Result<int, IoError> { done(self.path, avra_fd_sync(self.fd)) }

    fn closed() -> Result<int, IoError> { done(self.path, avra_io_close(self.fd)) }
}

/// The file cut back to exactly `len` bytes — what a caller trims a
/// TORN TAIL to (bytes an earlier crash left past the last frame it
/// could verify) before appending past it, so a half-written frame
/// never ends up between two valid ones. Answers the path.
export fn truncate_to(path: string, len: int) -> Result<string, IoError> {
    done(path, avra_io_truncate(one_path(path)?, len))?
    path
}

/// The directory's entries in byte order, `.` and `..` left out.
export fn list_dir(path: string) -> Result<List<string>, IoError> {
    let token = done(path, avra_io_list(one_path(path)?))?
    names_of(text_of(path, avra_fd_taken(token))?)
}

/// The stash's names, joined on `/` — the one byte a name cannot
/// hold; an empty directory is `[]`.
fn names_of(joined: string) -> List<string> {
    if joined.length == 0 { return [] }
    joined.split("/")
}

/// Every directory along the path made; one already standing is
/// fine. Answers the path.
export fn make_dirs(path: string) -> Result<string, IoError> {
    done(path, avra_io_mkdir(one_path(path)?))?
    path
}

/// A file, or an empty directory, gone. Answers the path.
export fn remove(path: string) -> Result<string, IoError> {
    done(path, avra_io_remove(one_path(path)?))?
    path
}

// ── The environment ─────────────────────────────────────────────

/// The variable's value, or null when it is not set — an empty
/// value is set. A name holding `=` names nothing: the host would
/// read it up to the `=` and answer another variable's value.
/// The variable's value, or null when it is not set — an empty value
/// is set. A name holding `=` or a NUL names nothing: `getenv` reads
/// only to the NUL and would answer about a DIFFERENT variable, so
/// absence is the honest answer. `env` has no failure channel by
/// design — absence IS its answer — which is why this refuses by
/// answering null where the file verbs answer `io.holed`.
export fn env(name: string) -> string? {
    if nul_at(name) >= 0 || name.contains("=") || avra_io_env_set(name) < 0 { return null }
    // THE PREDICATE CARRIES WHAT THE VALUE CANNOT. The host answers
    // the empty string for a variable that is unset AND for one set
    // to nothing, so the value alone cannot tell them apart.
    //
    // IT IS TWO READS OF THE ENVIRONMENT, atomic only while nothing
    // writes it concurrently with a read — true today: the one write,
    // `compile_slot`'s `AVRA_COMPILE_SLOT`, happens once as a command
    // starts, before it reads anything. The day a `set_env` verb lands
    // this becomes a check-then-use with a window between, and the
    // answer is one C call returning both.
    avra_host_env(name)
}

export fn env_or(name: string, default: string) -> string {
    env(name) ?? default
}

/// One of `AVRA_MAX_COMPILES` machine-wide compile slots (default 3;
/// 0 = off; under `AVRA_SLOT_DIR`), held until the process ends; waits, saying so once,
/// while every slot is taken. A process whose parent holds one takes
/// none. The slot taken, or -1 when none is.
export fn compile_slot() -> int {
    avra_io_compile_slot()
}
