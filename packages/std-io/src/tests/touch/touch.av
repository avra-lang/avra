// proves: `touch` sets a file's modification time to now through the runtime's own row — it answers
// the path of a file that is there and names NotFound for one that is not, in both engines.
use @std.io.{touch, write_text, make_dirs, remove, env_or, IoError}

fn said(r: Result<string, IoError>) -> string {
    match r { .Ok(_) -> "ok", .Err(.NotFound(_)) -> "not found", rest -> "refused" }
}

let dir = "${env_or("TMPDIR", "/tmp")}/avra-touch-program-test"
let path = "${dir}/file.txt"
println(said(touch("${dir}/no_such_dir/none.txt")))
println(said(make_dirs(dir)))
println(said(write_text(path, "x")))
println(said(touch(path)))
println(said(remove(path)))
