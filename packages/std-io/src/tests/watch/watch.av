// proves: a watch end to end, evaluated and native alike — a task
// parked in `next` woken by another task's write, a save by rename and
// a new entry in a watched directory seen in one look, a removal, a
// wait that a `within` ends, and the set replaced whole.
use @std.io.{
    IoError,
    Seen,
    Moved,
    Change,
    watch,
    write_text,
    append_bytes,
    make_dirs,
    remove,
    env_or,
}
use @std.time.{ms, sleep, within}

fn word(m: Moved) -> string {
    match m {
        .Created -> "created",
        .Changed -> "changed",
        .Removed -> "removed",
        .Unwatched -> "unwatched",
    }
}

/// What `cs` say of `path`, `-` when nothing.
fn of(cs: List<Change>, path: string) -> string {
    let words = [word(c.what) for c in cs if c.path == path]
    if words.is_empty() { "-" } else { words.join("+") }
}

/// What a look said of each of `paths`, in their order.
fn said(seen: Result<Seen, IoError>, paths: List<string>) -> string {
    match seen {
        .Ok(.Changes(cs)) -> [of(cs, p) for p in paths].join(" "),
        .Ok(.Everything) -> "everything",
        .Ok(.Quiet) -> "quiet",
        .Err(e) -> e.describe().message,
    }
}

fn appends_later(path: string, after: int) {
    sleep(ms(after))
    let _ = append_bytes(path, "more".bytes())
}

fn shown() -> string {
    let dir = "${env_or("TMPDIR", "/tmp")}/avra-watch-corpus"
    let f = "${dir}/f.txt"
    let fresh = "${dir}/new.txt"
    let _ = make_dirs(dir)
    let _ = remove(fresh)
    let _ = write_text(f, "one")
    let w = match watch() { .Ok(w) -> w, .Err(e) -> { return e.describe().message } }
    let _ = w.add(f)
    let _ = w.add(dir)
    let writer = spawn appends_later(f, 50)
    println("woken: ${said(within ms(5000) { w.next() }, [f, dir])}")
    writer.await
    let _ = write_text(f, "two")
    println("saved: ${said(w.taken(), [f])}")
    let _ = write_text(fresh, "new")
    println("arrived: ${said(w.taken(), [f, dir])}")
    println("waited: ${said(within ms(60) { w.next() }, [f, dir])}")
    println("refused: ${w.only([dir, fresh]).length}")
    let _ = append_bytes(f, "unwatched".bytes())
    let _ = remove(fresh)
    println("left: ${said(w.taken(), [f, dir, fresh])}")
    w.close()
    let _ = remove(f)
    let _ = remove(dir)
    "closed: ${w.taken() is .Err}"
}

shown()
