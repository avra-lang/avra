// The red team's record for @std/io: how it breaks, by attack class.
// Three findings drove fixes — a filename holding a newline listed
// as two names (the stash joined on `\n`), `make_dirs("")` spoke of a
// name too long, and `env("PATH=")` answered PATH's value because the
// C library reads a name up to its `=`.
use @std.text.{from_codepoint}
use @std.io.{IoError, Entry, kind_of, exists, is_dir, read_text, write_text, read_bytes, write_bytes, list_dir, make_dirs, remove, env, env_or, stamp}

/// The scratch directory for the adversarial set, made.
fn pit() -> string {
    let dir = "${env_or("TMPDIR", "/tmp")}/avra-io-adversarial"
    let _ = make_dirs(dir)
    dir
}

/// A path under the pit with nothing standing at it — a directory
/// left by an earlier run is emptied first.
fn cleared(name: string) -> string {
    let p = "${pit()}/${name}"
    for n in list_dir(p) catch [] { let _ = remove("${p}/${n}") }
    let _ = remove(p)
    p
}

fn said(r: Result<string, IoError>) -> string {
    match r {
        .Ok(t) -> "ok:${t}",
        .Err(e) -> e.describe().message,
    }
}

fn stands(r: Result<Entry, IoError>) -> string {
    match r {
        .Ok(e) -> match e { .Missing -> "missing", .File -> "file", .Dir -> "dir", .Other -> "other" },
        .Err(e) -> e.describe().message,
    }
}

fn names(r: Result<List<string>, IoError>) -> string {
    match r {
        .Ok(xs) -> xs.join("|"),
        .Err(e) -> e.describe().message,
    }
}

fn many(n: int) -> string {
    mut out = ""
    mut i = 0
    while i < n {
        // LICENSED I36: a 300-byte fixture built once — @std/text is not a dependency of io
        out = out + "x"
        i = i + 1
    }
    out
}

/// A read passed on through `?`.
fn first(p: string) -> Result<string, IoError> {
    let t = read_text(p)?
    t
}

/// A read with its cleanup deferred.
fn peek(p: string) -> string {
    defer { let _ = remove(p) }
    read_text(p) catch "gone"
}

spec "std/io — adversarial" {
    given "degenerate paths" {
        then "the empty path does not exist, whatever is asked of it" {
            said(read_text("")) == "`` does not exist" && said(write_text("", "x")) == "`` does not exist" && names(list_dir("")) == "`` does not exist" && said(remove("")) == "`` does not exist" && said(make_dirs("")) == "`` does not exist"
        }
        then "the empty path stands nowhere — missing, not an error" {
            match kind_of("") {
                .Ok(k) -> k is .Missing,
                .Err(_) -> false,
            }
        }
        then "the root is a directory, and making it again is fine" {
            is_dir("/") && said(make_dirs("/")) == "ok:/"
        }
        then "`.` and `..` are directories" {
            is_dir(".") && is_dir("..")
        }
        then "doubled and trailing slashes are the host's business — the path answers as written" {
            let d = cleared("slashes")
            said(make_dirs("${d}//a/")) == "ok:${d}//a/" && is_dir("${d}/a")
        }
        then "a device reads as empty text and stands as Other" {
            let other = match kind_of("/dev/null") {
                .Ok(k) -> k is .Other,
                .Err(_) -> false,
            }
            said(read_text("/dev/null")) == "ok:" && other
        }
        then "a name too long is the host's refusal, in its words" {
            let p = "${pit()}/${many(300)}"
            said(write_text(p, "x")) == "`${p}`: File name too long"
        }
    }
    given "the shared scratch — one landing, taken once" {
        then "a failed read between two reads leaves each its own text" {
            let p = cleared("kept.txt")
            let _ = write_text(p, "kept")
            said(read_text(p)) == "ok:kept" && said(read_text("${pit()}/absent")) != "ok:kept" && said(read_text(p)) == "ok:kept"
        }
        then "a filename holding a newline lists as ONE name" {
            let d = cleared("newline")
            let _ = make_dirs(d)
            let _ = write_text("${d}/a\nb", "x")
            names(list_dir(d)) == "a\nb"
        }
        then "a listing and a read interleave without crossing" {
            let d = cleared("cross")
            let _ = make_dirs(d)
            let _ = write_text("${d}/one", "1")
            let r = read_text("${d}/one")
            let l = list_dir(d)
            said(r) == "ok:1" && names(l) == "one"
        }
    }
    given "bytes that are not letters" {
        then "a text holding a NUL round-trips whole — the write reads the header's length, not strlen" {
            let p = cleared("nul.bin")
            let payload = "ab${from_codepoint(0)}cd"
            let _ = write_text(p, payload)
            (read_text(p) catch "").length == 5 && payload.length == 5
        }
        then "the byte survives in the middle, not just the count" {
            let p = cleared("nul2.bin")
            let _ = write_text(p, "x${from_codepoint(0)}y")
            let back = read_text(p) catch ""
            back.length == 3 && back.char_code(0) == 120 && back.char_code(1) == 0 && back.char_code(2) == 121
        }
    }
    given "the descriptor loops — past one chunk, and bytes that are not text" {
        then "a file past ONE read lands whole — the loop takes each landing before asking again" {
            let p = cleared("wide.txt")
            let payload = ["0123456789" for i in 0..300000].join("")
            let _ = write_text(p, payload)
            (read_text(p) catch "").length == 3000000 && payload.length == 3000000
        }
        then "an empty file round-trips — the write pours nothing and the read takes the empty box" {
            let p = cleared("hollow.txt")
            let _ = write_text(p, "")
            said(read_text(p)) == "ok:"
        }
        then "bytes that are not UTF-8 are refused as text, and the refusal names the OFFSET" {
            let p = cleared("raw.bin")
            let _ = write_bytes(p, [97, 98, 255, 99, 100].bytes()!)
            match read_text(p) {
                .Ok(_) -> false,
                .Err(e) -> match e {
                    .NotText(at, off) -> at == p && off == 2,
                    rest -> false,
                },
            }
        }
        then "and it says so in words a reader can act on" {
            let p = cleared("raw2.bin")
            let _ = write_bytes(p, [255].bytes()!)
            said(read_text(p)) == "`${p}` is not UTF-8 — byte 0"
        }
        then "an empty file through the OCTET door is an EMPTY BOX, and a file" {
            // THE EMPTY CASE, on the side that can spend it. An octet
            // door has three ways to get this wrong: answer absence for
            // an empty file, refuse it, or write no file at all for an
            // empty box. All three are the same mistake — spending the
            // empty value on "nothing here".
            let p = cleared("hollow.bin")
            let _ = write_bytes(p, "".bytes())
            (read_bytes(p) catch "x".bytes()).length == 0 && exists(p)
        }
        then "a NUL is an octet like any other, all the way to the file" {
            // 255 is refused as text and never reaches `read_bytes`
            // as a question; a NUL is VALID UTF-8, so it crosses both
            // doors and is where a length-carrying box and a
            // C-terminated one part company.
            let p = cleared("holed.bin")
            let _ = write_bytes(p, [97, 0, 98].bytes()!)
            let back = read_bytes(p) catch "".bytes()
            back.length == 3 && back.at(1) == 0 && (read_text(p) catch "").length == 3
        }
        then "the same bytes read back WHOLE through the lossless door" {
            let p = cleared("raw3.bin")
            let raw = [97, 98, 255, 99, 100].bytes()!
            let _ = write_bytes(p, raw)
            (read_bytes(p) catch "".bytes()).length == 5 && (read_bytes(p) catch "".bytes()).at(2) == 255
        }
        then "a write that cannot open its temp leaves NOTHING beside the target" {
            let d = cleared("nowhere")
            let _ = make_dirs(d)
            // the parent of the target does not exist, so the temp
            // never opens — and no half-written sibling is left
            let r = write_text("${d}/deep/gone.txt", "x")
            names(list_dir(d)) == "" && r is .Err
        }
        then "a write over a standing file replaces it whole, never appends" {
            let p = cleared("replaced.txt")
            let _ = write_text(p, "a much longer first version")
            let _ = write_text(p, "short")
            said(read_text(p)) == "ok:short"
        }
    }
    given "a path holding a NUL — two paths at once, refused at the face" {
        // MEASURED BEFORE THE DOOR EXISTED: a 79-byte path ending
        // `/../../etc/passwd` read a 5-byte file and `exists` answered
        // true, on BOTH engines. Agreement, not correctness.
        then "every verb that takes a path refuses one, in the law's own words" {
            let p = "${pit()}/a${from_codepoint(0)}/../../etc/passwd"
            let law = "a path holding a NUL is two paths — the host reads to byte ${pit().length + 2} and no further"
            said(read_text(p)) == law && said(write_text(p, "x")) == law && said(make_dirs(p)) == law && said(remove(p)) == law && names(list_dir(p)) == law && stands(kind_of(p)) == law
        }
        then "the asking verbs answer false rather than the truth about a shorter path" {
            let p = "${pit()}/a${from_codepoint(0)}bcd"
            !exists(p) && !is_dir(p)
        }
        then "the refusal carries the NUL's own offset" {
            match read_text("ab${from_codepoint(0)}cd") {
                .Ok(_) -> false,
                .Err(e) -> match e {
                    .Holed(_, at) -> at == 2,
                    rest -> false,
                },
            }
        }
        then "a path with no NUL is untouched by the door" {
            let p = cleared("plain.txt")
            let _ = write_text(p, "fine")
            said(read_text(p)) == "ok:fine"
        }
    }
    given "the environment's names" {
        then "set-to-empty is SET, and unset is null — the value alone cannot tell them apart" {
            env("AVRA_IO_SURELY_UNSET_") == null
        }
        then "a name holding a NUL names nothing — it must not read the variable it truncates to" {
            env("PATH${from_codepoint(0)}/junk") == null && env("PATH") != null
        }
        then "a NUL hides an `=` from the guard that looks for one, so the NUL is judged first" {
            env("A${from_codepoint(0)}=B") == null
        }
        then "env_or falls back for a holed name rather than answering another variable's value" {
            env_or("PATH${from_codepoint(0)}/junk", "fallback") == "fallback"
        }
        then "a name holding `=` is no variable — null, not the prefix's value" {
            env("PATH=") == null && env("=") == null && env("=PATH") == null
        }
        then "the empty name is null" {
            env("") == null
        }
    }
    given "crossings" {
        then "a refusal propagates through `?` in a Result fn, its variant intact" {
            match first("${pit()}/never-there") {
                .Ok(_) -> false,
                .Err(e) -> e is .NotFound,
            }
        }
        then "two hundred files written in a loop are listed in byte order" {
            let d = cleared("two-hundred")
            let _ = make_dirs(d)
            mut i = 0
            while i < 200 {
                let _ = write_text("${d}/f${i + 100}", "${i}")
                i = i + 1
            }
            let xs = list_dir(d) catch []
            xs.length == 200 && xs[0] == "f100" && xs[199] == "f299" && said(read_text("${d}/f299")) == "ok:199"
        }
        then "a deferred cleanup runs after the frame's own read" {
            let p = cleared("deferred.txt")
            let _ = write_text(p, "there")
            peek(p) == "there" && !exists(p)
        }
        then "the refusal's payload is the path, read by a nested match" {
            let p = "${pit()}/payload"
            match read_text(p) {
                .Ok(_) -> false,
                .Err(e) -> match e {
                    .NotFound(at) -> at == p,
                    rest -> false,
                },
            }
        }
    }
}

spec "io/stamp" {
    given "a path" {
        then "nothing standing there has no stamp" {
            stamp("${pit()}/never-made") == null
        }
        then "a directory has no stamp" {
            stamp(pit()) == null
        }
        then "a path holding a NUL has no stamp" {
            stamp("/etc/hosts${from_codepoint(0)}x") == null
        }
        then "a file written this second has none — two writes can wear one time" {
            let p = "${cleared("stamp")}/now"
            let _ = write_text(p, "x")
            stamp(p) == null
        }
        then "a file that has stood is stamped, and the same twice" {
            let first = stamp("/etc/hosts")
            first != null && first == stamp("/etc/hosts")
        }
    }
}
