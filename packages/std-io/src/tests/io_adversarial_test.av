// The red team's record for @std/io: how it breaks, by attack class.
// Three findings drove fixes — a filename holding a newline listed
// as two names (the stash joined on `\n`), `make_dirs("")` spoke of a
// name too long, and `env("PATH=")` answered PATH's value because the
// C library reads a name up to its `=`.
use @std.io.{IoError, Entry, kind_of, exists, is_dir, read_text, write_text, list_dir, make_dirs, remove, env, env_or}
use @std.errors.{Error}

/// The scratch directory for the adversarial set, made.
fn pit() -> string {
    let dir = "${env_or("TMPDIR", "/tmp")}/avra-io-adversarial"
    let _ = make_dirs(dir)
    dir
}

/// A path under the pit with nothing standing at it — a directory
/// left by an earlier run is emptied first.
fn cleared(name: string) -> string {
    let p = "${pit()}/${name}"
    for n in list_dir(p) catch [] { let _ = remove("${p}/${n}") }
    let _ = remove(p)
    p
}

fn said(r: Result<string, IoError>) -> string {
    match r {
        .Ok(t) -> "ok:${t}",
        .Err(e) -> e.describe().message,
    }
}

fn names(r: Result<List<string>, IoError>) -> string {
    match r {
        .Ok(xs) -> xs.join("|"),
        .Err(e) -> e.describe().message,
    }
}

fn many(n: int) -> string {
    mut out = ""
    mut i = 0
    while i < n {
        out = out + "x"
        i = i + 1
    }
    out
}

/// A read passed on through `?`.
fn first(p: string) -> Result<string, IoError> {
    let t = read_text(p)?
    t
}

/// A read with its cleanup deferred.
fn peek(p: string) -> string {
    defer { let _ = remove(p) }
    read_text(p) catch "gone"
}

spec "std/io — adversarial" {
    given "degenerate paths" {
        then "the empty path does not exist, whatever is asked of it" {
            said(read_text("")) == "`` does not exist" && said(write_text("", "x")) == "`` does not exist" &&
                names(list_dir("")) == "`` does not exist" && said(remove("")) == "`` does not exist" &&
                said(make_dirs("")) == "`` does not exist"
        }
        then "the empty path stands nowhere — missing, not an error" {
            match kind_of("") {
                .Ok(k) -> k is .Missing,
                .Err(_) -> false,
            }
        }
        then "the root is a directory, and making it again is fine" {
            is_dir("/") && said(make_dirs("/")) == "ok:/"
        }
        then "`.` and `..` are directories" {
            is_dir(".") && is_dir("..")
        }
        then "doubled and trailing slashes are the host's business — the path answers as written" {
            let d = cleared("slashes")
            said(make_dirs("${d}//a/")) == "ok:${d}//a/" && is_dir("${d}/a")
        }
        then "a device reads as empty text and stands as Other" {
            let other = match kind_of("/dev/null") {
                .Ok(k) -> k is .Other,
                .Err(_) -> false,
            }
            said(read_text("/dev/null")) == "ok:" && other
        }
        then "a name too long is the host's refusal, in its words" {
            let p = "${pit()}/${many(300)}"
            said(write_text(p, "x")) == "`${p}`: File name too long"
        }
    }
    given "the stash — one text, handed over once" {
        then "a failed read between two reads leaves each its own text" {
            let p = cleared("kept.txt")
            let _ = write_text(p, "kept")
            said(read_text(p)) == "ok:kept" && said(read_text("${pit()}/absent")) != "ok:kept" && said(read_text(p)) == "ok:kept"
        }
        then "a filename holding a newline lists as ONE name" {
            let d = cleared("newline")
            let _ = make_dirs(d)
            let _ = write_text("${d}/a\nb", "x")
            names(list_dir(d)) == "a\nb"
        }
        then "a listing and a read interleave without crossing" {
            let d = cleared("cross")
            let _ = make_dirs(d)
            let _ = write_text("${d}/one", "1")
            let r = read_text("${d}/one")
            let l = list_dir(d)
            said(r) == "ok:1" && names(l) == "one"
        }
    }
    given "the environment's names" {
        then "a name holding `=` is no variable — null, not the prefix's value" {
            env("PATH=") == null && env("=") == null && env("=PATH") == null
        }
        then "the empty name is null" {
            env("") == null
        }
    }
    given "crossings" {
        then "a refusal propagates through `?` in a Result fn, its variant intact" {
            match first("${pit()}/never-there") {
                .Ok(_) -> false,
                .Err(e) -> e is .NotFound,
            }
        }
        then "two hundred files written in a loop are listed in byte order" {
            let d = cleared("two-hundred")
            let _ = make_dirs(d)
            mut i = 0
            while i < 200 {
                let _ = write_text("${d}/f${i + 100}", "${i}")
                i = i + 1
            }
            let xs = list_dir(d) catch []
            xs.length == 200 && xs[0] == "f100" && xs[199] == "f299" && said(read_text("${d}/f299")) == "ok:199"
        }
        then "a deferred cleanup runs after the frame's own read" {
            let p = cleared("deferred.txt")
            let _ = write_text(p, "there")
            peek(p) == "there" && !exists(p)
        }
        then "the refusal's payload is the path, read by a nested match" {
            let p = "${pit()}/payload"
            match read_text(p) {
                .Ok(_) -> false,
                .Err(e) -> match e {
                    .NotFound(at) -> at == p,
                    rest -> false,
                },
            }
        }
    }
}
