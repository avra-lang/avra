//! A table's SHAPE: the facts the database is told about each column, and
//! the two texts they become — the column's DDL and its line in the shape
//! text a table is recorded under. One definition renders both and reads
//! the second back, so DDL, recorded shape and a diff between shapes
//! cannot say different things.
//!
//! A shape text is the table's name, then one line per column in column-name
//! byte order: `name|TYPE|null|key|unique|default|ref|on_delete`, `-` for
//! an absent fact, so the text is the same for the same model however its
//! fields are ordered and changes when any column fact does. Each index
//! follows the columns, one line each, its columns in index order: `unique(a,b)`
//! for a key over several, `index(a)` or `index(a,b)` for a plain one, and a
//! plain one over only some rows says which after a space: `absent(c)` or
//! `present(c)`.

/// EVERYTHING THE DATABASE IS TOLD ABOUT ONE COLUMN.
export type ColumnFacts = {
    name: string,
    sql_type: string,
    not_null: bool = false,
    key: bool = false,
    unique: bool = false,
    default: string? = null,
    refs: string? = null,
    on_delete: string? = null,
}

/// An INDEX over a table's columns, in index order: a key when no two rows
/// may hold the same values in them, and over the rows `only` names when it
/// holds some rather than all.
export type Index = { columns: List<string>, unique: bool = false, only: Only? = null }

/// The rows a partial index holds: those whose `column` is null when
/// `absent`, those whose is not otherwise.
export type Only = { column: string, absent: bool }

/// A table as recorded: its name, its columns, and each index over them.
export type Shape = { name: string, columns: List<ColumnFacts>, indexes: List<Index> = [] }

/// Every identifier written into SQL text is double-quoted,
/// unconditionally — a field or type named after a SQL keyword
/// (`order`, `group`, `table`) is a real Avra name and must stay one.
export fn quoted(name: string) -> string { "\"${name}\"" }

export fn column_ddl(c: ColumnFacts) -> string {
    let key = if c.key { " PRIMARY KEY AUTOINCREMENT" } else { "" }
    let required = if c.not_null { " NOT NULL" } else { "" }
    let fallback = if c.default == null { "" } else { " DEFAULT ${c.default!}" }
    let distinct = if c.unique { " UNIQUE" } else { "" }
    let link = if c.refs == null { "" } else { " REFERENCES ${quoted(c.refs!)}(${quoted("id")}) ON DELETE ${c.on_delete ?? "NO ACTION"}" }
    "${quoted(c.name)} ${c.sql_type}${key}${required}${fallback}${distinct}${link}"
}

/// The statement that makes a table of these columns, if it is not there.
export fn create_sql(name: string, columns: List<ColumnFacts>) -> string {
    "CREATE TABLE IF NOT EXISTS ${quoted(name)} (${[column_ddl(c) for c in columns].join(", ")})"
}

/// The line an index is recorded as; two indexes are one when their lines are.
export fn index_line(i: Index) -> string {
    let word = if i.unique { "unique" } else { "index" }
    "${word}(${i.columns.join(",")})${only_word(i.only)}"
}

fn only_word(o: Only?) -> string {
    match o {
        held? -> " ${if held.absent { "absent" } else { "present" }}(${held.column})"
        null -> ""
    }
}

/// An index's name: its table and its line, which no table or column name can spell.
fn index_name(on: string, i: Index) -> string { quoted("${on}_${index_line(i)}") }

/// The statement that makes an index of a table.
export fn index_sql(on: string, i: Index) -> string {
    let word = if i.unique { "UNIQUE INDEX" } else { "INDEX" }
    "CREATE ${word} ${index_name(on, i)} ON ${quoted(on)} (${[quoted(c) for c in i.columns].join(", ")})${only_sql(i.only)}"
}

fn only_sql(o: Only?) -> string {
    match o {
        held? -> " WHERE ${quoted(held.column)} IS ${if held.absent { "NULL" } else { "NOT NULL" }}"
        null -> ""
    }
}

/// The statement that ends one.
export fn unindex_sql(on: string, i: Index) -> string { "DROP INDEX ${index_name(on, i)}" }

export fn shape_line(c: ColumnFacts) -> string {
    let facts = [
        c.name,
        c.sql_type,
        if c.not_null { "notnull" } else { "null" },
        if c.key { "key" } else { "-" },
        if c.unique { "unique" } else { "-" },
        c.default ?? "-",
        c.refs ?? "-",
        c.on_delete ?? "-",
    ]
    facts.join("|")
}

/// The text a table is recorded under.
export fn shape_text(s: Shape) -> string {
    [s.name]
        .concat(ordered([shape_line(c) for c in s.columns]))
        .concat(ordered([index_line(i) for i in s.indexes]))
        .join("\n")
}

/// A shape text read back; absent for text that is no shape.
export fn shape_read(text: string) -> Shape? {
    let lines = text.split("\n")
    if lines.length < 2 { return null }
    let facts = lines.slice(1, lines.length)
    let read = [column_read(l) for l in facts if l.contains("|")]
    let indexes = [index_read(l) for l in facts if !l.contains("|")]
    if read.is_empty() || read.any(it == null) || indexes.any(it == null) { return null }
    Shape { name: lines[0], columns: [c! for c in read], indexes: [i! for i in indexes] }
}

/// An index line read back; absent for a line that is no index. A key
/// holds two columns or more, since one column's key is its own fact, and
/// it holds every row.
fn index_read(line: string) -> Index? {
    let parts = line.split(" ")
    if parts.is_empty() || parts.length > 2 { return null }
    let unique = parts[0].starts_with("unique(")
    let columns? = listed(parts[0], if unique { "unique" } else { "index" }) else { return null }
    let only = if parts.length == 2 { only_read(parts[1]) } else { null }
    if parts.length == 2 && only == null || unique && (columns.length < 2 || only != null) { return null }
    Index { columns: columns, unique: unique, only: only }
}

fn only_read(word: string) -> Only? {
    let absent = listed(word, "absent")
    let named? = absent ?? listed(word, "present") else { return null }
    if named.length != 1 { return null }
    Only { column: named[0], absent: absent != null }
}

/// The names `word(a,b,…)` lists; absent when the text is not that, or names an empty one.
fn listed(text: string, word: string) -> List<string>? {
    if !text.starts_with("${word}(") || !text.ends_with(")") { return null }
    let names = text.substring(word.length + 1, text.length - 1).split(",")
    if names.is_empty() || names.any(it.is_empty()) { return null }
    names
}

fn column_read(line: string) -> ColumnFacts? {
    let p = line.split("|")
    if p.length != 8 { return null }
    let not_null? = flag(p[2], "notnull", "null") else { return null }
    let key? = flag(p[3], "key", "-") else { return null }
    let unique? = flag(p[4], "unique", "-") else { return null }
    ColumnFacts {
        name: p[0],
        sql_type: p[1],
        not_null: not_null,
        key: key,
        unique: unique,
        default: stated(p[5]),
        refs: stated(p[6]),
        on_delete: stated(p[7]),
    }
}

/// Which of two words a flag column holds; absent for any other.
fn flag(word: string, yes: string, no: string) -> bool? {
    when {
        word == yes -> true
        word == no -> false
        _ -> null
    }
}

/// A fact column's value, absent when it holds the absent mark.
fn stated(word: string) -> string? { if word == "-" { null } else { word } }

/// Texts in byte order, each placed after those that come before it.
fn ordered(xs: List<string>) -> List<string> {
    mut out: List<string> = []
    for x in xs {
        let at = [y for y in out if before(y, x)].length
        out = out.slice(0, at).concat([x]).concat(out.slice(at, out.length))
    }
    out
}

/// Whether `a` comes before `b` by their octets; a prefix comes first.
fn before(a: string, b: string) -> bool {
    let x = a.bytes()
    let y = b.bytes()
    let shared = if x.length < y.length { x.length } else { y.length }
    for i in 0..shared {
        if x.at(i) != y.at(i) { return x.at(i) < y.at(i) }
    }
    x.length < y.length
}
