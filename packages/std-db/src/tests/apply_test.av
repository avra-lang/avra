// The runner over real databases: growth is applied and recorded, a moving
// change is refused with nothing written, a file database is copied before
// it is written, and a plan that leaves the database unsound is rolled back.
use @std.db.{model}
use @std.db.apply.{MigrateError, grown}
use @std.errors.{Error}
use @std.io.{list_dir, make_dirs}
use @std.sqlite.{Db, sql}
use @std.sqlite.error.{SqlError}
use @std.time.{stamp}

@model
type Note = {
    id: int = 0,
    title: string,
}

@model
type Owner = {
    id: int = 0,
    name: string,
}

@model
type Pet = {
    id: int = 0,
    owner: Owner,
}

@model
type Memo = {
    id: int = 0,
    @renamed_from("body") text: string,
}

@model
type Seat = {
    id: int = 0,
    room: string,
    @unique(room) n: int,
}

@model
type Desk = {
    id: int = 0,
    @renamed_from("hall") room: string,
    @unique(room) n: int,
}

/// The line `Seat`'s key adds to its shape text.
const SEAT_KEY: string = "\nunique(room,n)"

/// The line a new optional column adds to a shape text.
const EXTRA: string = "\nnote|TEXT|null|-|-|-|-|-"

fn kind_of(r: Result<int, MigrateError>) -> string {
    match r { .Ok(n) -> "ok ${n}", .Err(e) -> e.describe().kind }
}

fn said(r: Result<int, MigrateError>) -> string {
    match r { .Ok(n) -> "ok ${n}", .Err(e) -> e.describe().message }
}

fn columns(db: Db, tname: string) -> Result<int, SqlError> {
    (db.scalar(sql("SELECT count(*) FROM pragma_table_info(?)", [.Text(tname)]))?).int()
}

fn recorded(db: Db, tname: string) -> Result<string, SqlError> {
    (db.scalar(sql("SELECT shape FROM \"__avra_models__\" WHERE table_name = ?", [.Text(tname)]))?)
        .text()
}

fn made() -> Result<string, SqlError> {
    let db = Db.memory()?
    let first = kind_of(Note.migrate(db))
    let again = kind_of(Note.migrate(db))
    "${first} ${again} ${columns(db, "Note")?}"
}

fn grown_once() -> Result<string, SqlError> {
    let db = Db.memory()?
    let _ = kind_of(Note.migrate(db))
    let _ = db.run(sql("INSERT INTO \"Note\" (title) VALUES ('kept')"))?
    let steps = kind_of(grown(db, Note.shape() + EXTRA, [], []))
    let held = (db.scalar(sql("SELECT title FROM \"Note\""))?).text()?
    let blank = (db.scalar(sql("SELECT note IS NULL FROM \"Note\""))?).int()?
    "${steps} ${columns(db, "Note")?} ${held} ${blank} ${(recorded(db, "Note")?).contains("note|TEXT|null")}"
}

fn then_nothing_to_do() -> Result<string, SqlError> {
    let db = Db.memory()?
    let _ = kind_of(Note.migrate(db))
    let _ = kind_of(grown(db, Note.shape() + EXTRA, [], []))
    "${kind_of(grown(db, Note.shape() + EXTRA, [], []))} ${kind_of(Note.migrate(db))}"
}

fn refused_move() -> Result<string, SqlError> {
    let db = Db.memory()?
    let _ = kind_of(Note.migrate(db))
    let before = recorded(db, "Note")?
    let dropped = "Note\nid|INTEGER|null|key|-|-|-|-\n__avra_version__|INTEGER|notnull|-|-|1|-|-"
    let r = grown(db, dropped, [], [])
    let kept = columns(db, "Note")? == 3 && recorded(db, "Note")? == before
    "${kind_of(r)} ${kept} ${said(r)}"
}

fn unrecorded() -> Result<string, SqlError> {
    let db = Db.memory()?
    let _ = kind_of(Note.migrate(db))
    let _ = db.run(sql("UPDATE \"__avra_models__\" SET shape = NULL"))?
    kind_of(grown(db, Note.shape(), [], []))
}

fn copied_first() -> Result<string, SqlError> {
    let dir = "/tmp/avra-db-apply-test/${stamp()}"
    let _ = make_dirs(dir)
    let db = Db.open("${dir}/app.db")?
    let _ = kind_of(Note.migrate(db))
    let _ = db.run(sql("INSERT INTO \"Note\" (title) VALUES ('before')"))?
    let none = (list_dir(dir) catch []).filter(it.ends_with(".bak")).length
    let steps = kind_of(grown(db, Note.shape() + EXTRA, [], []))
    let baks = (list_dir(dir) catch []).filter(it.ends_with(".bak"))
    let copy = Db.open_read("${dir}/${baks[0]}")?
    let had = (copy.scalar(sql("SELECT count(*) FROM pragma_table_info('Note')"))?).int()?
    let rows = (copy.scalar(sql("SELECT count(*) FROM \"Note\""))?).int()?
    "${none} ${steps} ${baks.length} ${had} ${rows}"
}

fn untouched_when_copy_is_not_needed() -> Result<string, SqlError> {
    let dir = "/tmp/avra-db-apply-test/${stamp()}"
    let _ = make_dirs(dir)
    let db = Db.open("${dir}/app.db")?
    let _ = kind_of(Note.migrate(db))
    let _ = kind_of(Note.migrate(db))
    "${(list_dir(dir) catch []).filter(it.ends_with(".bak")).length}"
}

fn rolled_back() -> Result<string, SqlError> {
    let db = Db.memory()?
    let _ = kind_of(Owner.migrate(db))
    let _ = kind_of(Pet.migrate(db))
    let _ = db.run(sql("PRAGMA foreign_keys = OFF"))?
    let _ = db.run(sql("INSERT INTO \"Pet\" (owner_id) VALUES (99)"))?
    let r = grown(db, Pet.shape() + EXTRA, [], [])
    "${kind_of(r)} ${columns(db, "Pet")?} ${(recorded(db, "Pet")?).contains("note")}"
}

/// A Memo table as an earlier declaration left it: the column still called `body`.
fn memo_as_it_was() -> Result<Db, SqlError> {
    let db = Db.memory()?
    let _ = kind_of(Memo.migrate(db))
    let _ = db.run(sql("INSERT INTO \"Memo\" (text) VALUES ('kept')"))?
    let _ = db.run(sql("ALTER TABLE \"Memo\" RENAME COLUMN \"text\" TO \"body\""))?
    let old = (recorded(db, "Memo")?).replace("text|TEXT", "body|TEXT")
    let _ = db
        .run(sql("UPDATE \"__avra_models__\" SET shape = ? WHERE table_name = 'Memo'", [.Text(old)]))?
    db
}

fn renamed() -> Result<string, SqlError> {
    let db = memo_as_it_was()?
    let r = kind_of(Memo.migrate(db))
    let held = (db.scalar(sql("SELECT text FROM \"Memo\""))?).text()?
    let old = (db.scalar(sql("SELECT count(*) FROM pragma_table_info('Memo') WHERE name = 'body'"))?)
        .int()?
    let again = kind_of(Memo.migrate(db))
    "${r} ${held} ${old} ${again} ${(recorded(db, "Memo")?).contains("text|TEXT")}"
}

/// The names of the indexes a table was given, in name order.
fn keys(db: Db, tname: string) -> Result<string, SqlError> {
    (db
        .scalar(
            sql(
                "SELECT coalesce(group_concat(name, ' '), '') FROM (SELECT name FROM sqlite_master WHERE type = 'index' AND tbl_name = ? AND sql IS NOT NULL ORDER BY name)",
                [.Text(tname)],
            ),
        )?)
        .text()
}

fn seat(db: Db, room: string, n: int) -> Result<int, SqlError> {
    db.run(sql("INSERT INTO \"Seat\" (room, n) VALUES (?, ?)", [.Text(room), .Int(n)]))
}

/// A Seat table as a declaration without the key left it.
fn seats_unkeyed() -> Result<Db, SqlError> {
    let db = Db.memory()?
    let _ = kind_of(grown_from_nothing(db))
    let _ = seat(db, "a", 1)?
    db
}

fn grown_from_nothing(db: Db) -> Result<int, MigrateError> {
    let _ = Seat.migrate(db)?
    grown(db, Seat.shape().replace(SEAT_KEY, ""), [], [])
}

fn keyed_at_birth() -> Result<string, SqlError> {
    let db = Db.memory()?
    let first = kind_of(Seat.migrate(db))
    "${first} ${kind_of(Seat.migrate(db))} ${keys(db, "Seat")?}"
}

fn key_ended() -> Result<string, SqlError> {
    let db = seats_unkeyed()?
    let _ = seat(db, "a", 1)?
    "${keys(db, "Seat")?}|${(recorded(db, "Seat")?).contains("unique(")}"
}

fn key_begun() -> Result<string, SqlError> {
    let db = seats_unkeyed()?
    let _ = seat(db, "a", 2)?
    let steps = kind_of(Seat.migrate(db))
    let again = match seat(db, "a", 2) { .Ok(_) -> "kept", .Err(e) -> e.message }
    "${steps} ${keys(db, "Seat")?} ${(recorded(db, "Seat")?).ends_with(SEAT_KEY)} ${again}"
}

fn key_begun_over_repeats() -> Result<string, SqlError> {
    let db = seats_unkeyed()?
    let _ = seat(db, "a", 1)?
    let r = Seat.migrate(db)
    "${kind_of(r)}|${said(r)}|${keys(db, "Seat")?}|${(recorded(db, "Seat")?).contains("unique(")}"
}

fn key_reordered() -> Result<string, SqlError> {
    let db = Db.memory()?
    let _ = kind_of(Seat.migrate(db))
    let steps = kind_of(grown(db, Seat.shape().replace(SEAT_KEY, "\nunique(n,room)"), [], []))
    "${steps} ${keys(db, "Seat")?}"
}

/// A Desk table as an earlier declaration left it: the column still called
/// `hall`, and the key over it under that name.
fn desk_as_it_was() -> Result<Db, SqlError> {
    let db = Db.memory()?
    let _ = kind_of(Desk.migrate(db))
    let _ = db.run(sql("INSERT INTO \"Desk\" (room, n) VALUES ('a', 1)"))?
    let _ = db.run(sql("DROP INDEX \"Desk_unique(room,n)\""))?
    let _ = db.run(sql("ALTER TABLE \"Desk\" RENAME COLUMN \"room\" TO \"hall\""))?
    let _ = db.run(sql("CREATE UNIQUE INDEX \"Desk_unique(hall,n)\" ON \"Desk\" (\"hall\", \"n\")"))?
    let old = (recorded(db, "Desk")?)
        .replace("room|TEXT", "hall|TEXT")
        .replace("unique(room,n)", "unique(hall,n)")
    let _ = db
        .run(sql("UPDATE \"__avra_models__\" SET shape = ? WHERE table_name = 'Desk'", [.Text(old)]))?
    db
}

fn key_renamed() -> Result<string, SqlError> {
    let db = desk_as_it_was()?
    let steps = kind_of(Desk.migrate(db))
    let again = match db.run(sql("INSERT INTO \"Desk\" (room, n) VALUES ('a', 1)")) {
        .Ok(_) -> "kept",
        .Err(e) -> e.message,
    }
    "${steps} ${keys(db, "Desk")?} ${kind_of(Desk.migrate(db))} ${again}"
}

fn shown(r: Result<string, SqlError>) -> string {
    match r { .Ok(t) -> t, .Err(e) -> "failed: ${e.message}" }
}

spec "std/db apply" {
    given "a model with no table" {
        then "migrate makes it, grows nothing, and a second run does nothing" {
            shown(made()) == "ok 0 ok 0 3"
        }
    }
    given "a declared column the table lacks" {
        then "is added, the rows stay, the new column is empty for them, and the registry records it" {
            shown(grown_once()) == "ok 1 4 kept 1 true"
        }
        then "and a table already at that shape has nothing to do" {
            shown(then_nothing_to_do()) == "ok 0 db.migrate.moving"
        }
    }
    given "a field that says what it was called" {
        then "continues the old column under its new name, rows and all, and records it" {
            shown(renamed()) == "ok 1 kept 0 ok 0 true"
        }
    }
    given "a model with a key over several columns" {
        then "is made with its index, and a second run does nothing" {
            shown(keyed_at_birth()) == "ok 0 ok 0 Seat_unique(room,n)"
        }
        then "a key no longer declared is ended: the index goes, the shape forgets it, and rows may repeat" {
            shown(key_ended()) == "|false"
        }
        then "a key newly declared over rows that keep it is begun, recorded, and held" {
            shown(key_begun()) == "ok 1 Seat_unique(room,n) true UNIQUE constraint failed: Seat.room, Seat.n"
        }
        then "over rows that already repeat it is refused by the database, and nothing is kept" {
            shown(key_begun_over_repeats()) == "sqlite.constraint.unique|UNIQUE constraint failed: Seat.room, Seat.n||false"
        }
        then "a key whose columns change order ends and begins again" {
            shown(key_reordered()) == "ok 2 Seat_unique(n,room)"
        }
        then "a renamed column inside a key takes the key with it, under the new name" {
            shown(key_renamed()) == "ok 3 Desk_unique(room,n) ok 0 UNIQUE constraint failed: Desk.room, Desk.n"
        }
    }
    given "a change that moves" {
        then "is refused in its own words, and nothing is written" {
            shown(refused_move()) == "db.migrate.moving true `Note` cannot be migrated by itself: `Note.title` is recorded and no longer declared — dropping a column loses its values; say `@renamed_from(\"title\")` on the field that continues it, or migrate by hand"
        }
    }
    given "a table the registry holds no shape for" {
        then "is refused, never guessed" { shown(unrecorded()) == "db.migrate.unrecorded" }
    }
    given "a file database" {
        then "is copied whole before the first write, and the copy holds the old shape and the rows" {
            shown(copied_first()) == "0 ok 1 1 3 1"
        }
        then "and a run that writes nothing takes no copy" { shown(untouched_when_copy_is_not_needed()) == "0" }
    }
    given "a plan that leaves the database unsound" {
        then "is rolled back whole: no column, no new shape" {
            shown(rolled_back()) == "db.migrate.broken 3 false"
        }
    }
}
