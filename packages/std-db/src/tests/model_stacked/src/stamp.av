//! `@stamped`: a declaring annotation that gives a type `stamp()`, its name.
use @std.meta.{Type, Directive, Declared, literal}

export fn stamped(t: Type) -> Declared {
    Declared {
        made: [
            Directive {
                twin: "",
                name: t.name,
                at: t.at,
                source: quote {
                    impl ${t} {
                        static fn stamp() -> string { ${literal(t.name)} }
                    }
                },
            },
        ],
    }
}
