use @std.db.{model_shape, model}

// A DIFFERENT shape from collide_a/collide_b's `Shared` — the claim
// registry must refuse on `declared_at` alone, never on whether the
// shapes happen to agree, or a same-named model with a genuinely
// different column set could silently no-op its CREATE TABLE against
// the first claimant's real table.
@model_shape
@model
export type Shared = {
    id: int = 0,
    nickname: string,
    age: int,
}
