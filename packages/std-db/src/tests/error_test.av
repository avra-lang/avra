use @std.db.error.{ModelError, UniqueField, attributed}
use @std.sqlite.error.{Cause, SqlError, Violation}

fn field(name: string) -> UniqueField { UniqueField { name: name, at: null, columns: [name] } }

/// `name` unique within `among`: the key is those columns, then its own.
fn key(name: string, among: List<string>) -> UniqueField {
    UniqueField { name: name, at: null, columns: among.concat([name]), among: among }
}

fn unique_failure(message: string) -> SqlError {
    SqlError {
        cause: Cause.Constraint(Violation.Unique),
        code: 19,
        extended: 2067,
        message: message,
        sql: null,
    }
}

fn other_failure() -> SqlError {
    SqlError { cause: Cause.Closed, code: 0, extended: 0, message: "database is closed", sql: null }
}

fn kind_of(e: ModelError) -> string { e.describe().kind }
fn message_of(e: ModelError) -> string { e.describe().message }

spec "std/db ModelError attribution" {
    given "a failure that is not a unique-constraint violation at all" {
        then "it always passes through unenriched, whatever fields are known" {
            kind_of(attributed(other_failure(), "T", [field("a"), field("b")])) == "sqlite.closed"
        }
        then "and its own message stays SQLite's, untouched" {
            message_of(attributed(other_failure(), "T", [field("a")])) == "database is closed"
        }
    }
    given "a unique-constraint violation and zero known @unique fields" {

        then "the structurally-impossible case still passes through plainly, never a fabricated field" {
            kind_of(attributed(unique_failure("UNIQUE constraint failed: T.x"), "T", [])) == "sqlite.constraint.unique"
        }
    }
    given "a unique-constraint violation and exactly one known @unique field" {

        then "it attributes with full confidence, without needing to parse the message at all" {
            kind_of(attributed(unique_failure("constraint failed"), "T", [field("email")])) == "db.constraint.unique"
        }
        then "the message names that one field" {
            message_of(attributed(unique_failure("constraint failed"), "T", [field("email")]))
                .contains("`email`")
        }
    }
    given "a unique-constraint violation and two known @unique fields, the message naming one cleanly" {

        then "it attributes to the exact column SQLite named, not the other" {
            let m = message_of(
                attributed(
                    unique_failure("UNIQUE constraint failed: T.email"),
                    "T",
                    [field("email"), field("username")],
                ),
            )
            m.contains("`email`") && !m.contains("`username`")
        }
        then "naming the other column attributes to that one instead" {
            let m = message_of(
                attributed(
                    unique_failure("UNIQUE constraint failed: T.username"),
                    "T",
                    [field("email"), field("username")],
                ),
            )
            m.contains("`username`") && !m.contains("`email`")
        }
    }
    given "a unique-constraint violation, two known @unique fields, and a message that does not parse" {

        then "an unrecognized format falls back honestly, never a wrong guess" {
            let m = message_of(
                attributed(
                    unique_failure("constraint failed"),
                    "T",
                    [field("email"), field("username")],
                ),
            )
            m.contains("`T.email`") && m.contains("`T.username`")
        }
        then "different capitalization in the message is not force-matched" {
            let m = message_of(
                attributed(
                    unique_failure("UNIQUE CONSTRAINT FAILED: T.EMAIL"),
                    "T",
                    [field("email"), field("username")],
                ),
            )
            m.contains("`T.email`") && m.contains("`T.username`")
        }
        then "a message naming a column that isn't one of the model's own @unique fields falls back too" {
            let m = message_of(
                attributed(
                    unique_failure("UNIQUE constraint failed: T.other_column"),
                    "T",
                    [field("email"), field("username")],
                ),
            )
            m.contains("`T.email`") && m.contains("`T.username`")
        }
    }
    given "a key over several columns, alone on its model" {

        then "it attributes without parsing, in the key's own words" {
            message_of(attributed(unique_failure("constraint failed"), "T", [key("c", ["a", "b"])])) == "`c` must be unique within `a`, `b` — declared @unique(a, b) on `T.c`"
        }
    }
    given "a key over several columns beside a unique column it holds" {

        then "a message naming every column of the key attributes to the key" {
            message_of(
                attributed(
                    unique_failure("UNIQUE constraint failed: T.a, T.c"),
                    "T",
                    [field("a"), key("c", ["a"])],
                ),
            ) == "`c` must be unique within `a` — declared @unique(a) on `T.c`"
        }
        then "a message naming the one column attributes to the column" {
            message_of(
                attributed(
                    unique_failure("UNIQUE constraint failed: T.a"),
                    "T",
                    [field("a"), key("c", ["a"])],
                ),
            ) == "`a` must be unique — declared @unique on `T.a`"
        }
    }
    given "two keys, one holding the other's columns" {

        then "the message naming the longer key's columns attributes to the longer" {
            message_of(
                attributed(
                    unique_failure("UNIQUE constraint failed: T.a, T.b, T.c"),
                    "T",
                    [key("b", ["a"]), key("c", ["a", "b"])],
                ),
            )
                .starts_with("`c` must be unique within `a`, `b`")
        }
        then "the message naming the shorter key's columns attributes to the shorter" {
            message_of(
                attributed(
                    unique_failure("UNIQUE constraint failed: T.a, T.b"),
                    "T",
                    [key("b", ["a"]), key("c", ["a", "b"])],
                ),
            )
                .starts_with("`b` must be unique within `a`")
        }
        then "a message naming only part of every key falls back to all of them" {
            let m = message_of(
                attributed(
                    unique_failure("UNIQUE constraint failed: T.a"),
                    "T",
                    [key("b", ["a"]), key("c", ["a", "b"])],
                ),
            )
            m.contains("`T.b`") && m.contains("`T.c`")
        }
        then "a column whose name begins another's is not that column" {
            let m = message_of(
                attributed(
                    unique_failure("UNIQUE constraint failed: T.ab, T.b"),
                    "T",
                    [key("b", ["a"]), key("d", ["c"])],
                ),
            )
            m.contains("`T.b`") && m.contains("`T.d`")
        }
        then "a key holding a column and one its name begins is still named whole" {
            message_of(
                attributed(
                    unique_failure("UNIQUE constraint failed: T.ab, T.a"),
                    "T",
                    [key("a", ["ab"]), key("d", ["c"])],
                ),
            )
                .starts_with("`a` must be unique within `ab`")
        }
    }
    given "two different models sharing a field name, one violation between them" {

        then "the message naming the OTHER model's table never cross-attributes into this one" {
            let m = message_of(
                attributed(
                    unique_failure("UNIQUE constraint failed: OtherModel.email"),
                    "ThisModel",
                    [field("email"), field("username")],
                ),
            )
            m.contains("`ThisModel.email`") && m.contains("`ThisModel.username`")
        }
        then "a model name that is a SUFFIX of the violated table's name never cross-attributes either" {
            let m = message_of(
                attributed(
                    unique_failure("UNIQUE constraint failed: SuperUser.email"),
                    "User",
                    [field("email"), field("username")],
                ),
            )
            m.contains("`User.email`") && m.contains("`User.username`")
        }
    }
    given "two @unique fields where one field's name is a PREFIX of the other's" {

        then "a violation on the longer name attributes to the longer name, not the prefix" {
            let m = message_of(
                attributed(
                    unique_failure("UNIQUE constraint failed: T.name2"),
                    "T",
                    [field("name"), field("name2")],
                ),
            )
            m.contains("`name2`") && !m.contains("`name` must")
        }
        then "a violation on the shorter name still attributes to the shorter name" {
            let m = message_of(
                attributed(
                    unique_failure("UNIQUE constraint failed: T.name"),
                    "T",
                    [field("name"), field("name2")],
                ),
            )
            m.contains("`name` must") && !m.contains("`name2`")
        }
    }
}
