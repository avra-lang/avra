// `@index`: rows found by their fields, held by an index the model declares. It
// is made with the table, recorded in the shape, begun and ended by a
// migration over rows already there, and a lookup by its fields reads it.
use @std.db.{model, index}
use @std.db.apply.{MigrateError, grown}
use @std.db.error.{ModelError, modeled}
use @std.sqlite.{Db, sql}
use @std.sqlite.error.{SqlError}

@model
type Card = {
    id: int = 0,
    @index board: string,
    @index(board) due: int,
    done_at: int? = null,
    @index(absent: done_at) lane: string,
    @index(present: done_at) owner: string? = null,
}

@index(lane, due)
@model
type Ticket = {
    id: int = 0,
    lane: string,
    due: int,
}

@model
type Card_index = {
    id: int = 0,
    @index board: string,
}

@model
type Lane = {
    id: int = 0,
    done_at: int? = null,
    @index @index(absent: done_at) name: string,
}

@model
type Moved = {
    id: int = 0,
    @renamed_from("hall") @index room: string,
}

/// The line `Card`'s index over `board` then `due` adds to its shape text.
const BOARD_DUE: string = "\nindex(board,due)"

fn kind_of(r: Result<int, MigrateError>) -> string {
    match r { .Ok(n) -> "ok ${n}", .Err(e) -> e.describe().kind }
}

/// The names of the indexes a table was given, in name order.
fn indexes(db: Db, name: string) -> Result<string, SqlError> {
    (db
        .scalar(
            sql(
                "select coalesce(group_concat(name, ';'), '') from (select name from sqlite_master where type = 'index' and tbl_name = ? and sql is not null order by name)",
                [.Text(name)],
            ),
        )?)
        .text()
}

/// The statement an index was made by.
fn made_by(db: Db, index: string) -> Result<string, SqlError> {
    (db.scalar(sql("select sql from sqlite_master where name = ?", [.Text(index)]))?).text()
}

/// How SQLite plans a query: its plan's details, joined.
fn plan(db: Db, query: string) -> Result<string, SqlError> {
    let rows = db.all(sql("EXPLAIN QUERY PLAN ${query}"))?
    [r.text(3)? for r in rows].join(";")
}

fn cards() -> Result<Db, SqlError> {
    let db = Db.memory()?
    Card.create_table(db)?
    db
}

fn card(db: Db, board: string, due: int) -> Result<Card, ModelError> {
    Card { board: board, due: due, lane: "l" }.insert(db)
}

fn made_with_table() -> Result<string, SqlError> { indexes(cards()?, "Card") }

fn partial_made() -> Result<string, SqlError> {
    let db = cards()?
    "${made_by(db, "Card_index(lane) absent(done_at)")?}|${made_by(db, "Card_index(owner) present(done_at)")?}"
}

fn type_index_made() -> Result<string, SqlError> {
    let db = Db.memory()?
    Ticket.create_table(db)?
    indexes(db, "Ticket")
}

fn lookup_planned() -> Result<string, SqlError> {
    plan(cards()?, "SELECT id FROM \"Card\" WHERE \"board\" = 'b' AND \"due\" < 5")
}

fn open_lane_planned() -> Result<string, SqlError> {
    plan(
        cards()?,
        "SELECT id FROM \"Card\" WHERE \"lane\" = 'l' AND \"done_at\" IS NULL ORDER BY id",
    )
}

/// A database whose `Card` table was recorded without the index over `board`
/// then `due`, holding rows.
fn cards_unindexed() -> Result<Db, ModelError> {
    let db = modeled(Db.memory())?
    let _ = kind_of(Card.migrate(db))
    let _ = card(db, "b", 1)?
    let _ = card(db, "b", 2)?
    let _ = kind_of(grown(db, Card.shape().replace(BOARD_DUE, ""), [], []))
    db
}

fn index_ended() -> Result<string, ModelError> {
    let db = cards_unindexed()?
    "${modeled(indexes(db, "Card"))?}"
}

fn index_begun() -> Result<string, ModelError> {
    let db = cards_unindexed()?
    let steps = kind_of(Card.migrate(db))
    let rows = (modeled(Card.all(db))?).length
    "${steps} ${rows} ${(modeled(indexes(db, "Card"))?).contains("Card_index(board,due)")}"
}

fn index_current() -> Result<string, SqlError> {
    let db = Db.memory()?
    "${kind_of(Card.migrate(db))} ${kind_of(Card.migrate(db))}"
}

/// A Moved table as an earlier declaration left it: the column called `hall`,
/// indexed under that name, holding a row.
fn moved_as_it_was() -> Result<Db, SqlError> {
    let db = Db.memory()?
    let _ = kind_of(Moved.migrate(db))
    let _ = db.run(sql("INSERT INTO \"Moved\" (room) VALUES ('a')"))?
    let _ = db.run(sql("DROP INDEX \"Moved_index(room)\""))?
    let _ = db.run(sql("ALTER TABLE \"Moved\" RENAME COLUMN \"room\" TO \"hall\""))?
    let _ = db.run(sql("CREATE INDEX \"Moved_index(hall)\" ON \"Moved\" (\"hall\")"))?
    let old = ((db.scalar(sql("SELECT shape FROM \"__avra_models__\" WHERE table_name = 'Moved'"))?)
        .text()?)
        .replace("room|TEXT", "hall|TEXT")
        .replace("index(room)", "index(hall)")
    let _ = db
        .run(sql("UPDATE \"__avra_models__\" SET shape = ? WHERE table_name = 'Moved'", [.Text(old)]))?
    db
}

fn index_renamed() -> Result<string, SqlError> {
    let db = moved_as_it_was()?
    let steps = kind_of(Moved.migrate(db))
    let room = (db.scalar(sql("SELECT room FROM \"Moved\""))?).text()?
    "${steps} ${indexes(db, "Moved")?} ${room}"
}

fn one_column_twice() -> Result<string, SqlError> {
    let db = Db.memory()?
    Lane.create_table(db)?
    indexes(db, "Lane")
}

fn names_kept_apart() -> Result<string, SqlError> {
    let db = cards()?
    Card_index.create_table(db)?
    "${indexes(db, "Card_index")?}"
}

spec "std/db @index" {
    given "a model's indexes" {
        then "are recorded in its shape, after the columns, in byte order" {
            Card
                .shape()
                .ends_with(
                    "\nindex(board)\nindex(board,due)\nindex(lane) absent(done_at)\nindex(owner) present(done_at)",
                )
        }
        then "are made with its table, each named by its table and its line" {
            (made_with_table() catch _ -> "") == "Card_index(board);Card_index(board,due);Card_index(lane) absent(done_at);Card_index(owner) present(done_at)"
        }
        then "a partial one holds the rows its field is null in, or those it is not" {
            (partial_made() catch _ -> "") == "CREATE INDEX \"Card_index(lane) absent(done_at)\" ON \"Card\" (\"lane\") WHERE \"done_at\" IS NULL|CREATE INDEX \"Card_index(owner) present(done_at)\" ON \"Card\" (\"owner\") WHERE \"done_at\" IS NOT NULL"
        }
        then "one declared on the type is over its fields in written order" {
            (type_index_made() catch _ -> "") == "Ticket_index(lane,due)"
        }
        then "a lookup by the fields searches the index over them" {
            (lookup_planned() catch _ -> "") == "SEARCH Card USING COVERING INDEX Card_index(board,due) (board=? AND due<?)"
        }
        then "a lookup of the rows a partial index holds searches it, and sorts nothing" {
            (open_lane_planned() catch _ -> "") == "SEARCH Card USING INDEX Card_index(lane) absent(done_at) (lane=?)"
        }
        then "over every row and over some, of one column, are two indexes" {
            (one_column_twice() catch _ -> "") == "Lane_index(name);Lane_index(name) absent(done_at)"
        }
        then "named by table and line, never collide with another model's" {
            (names_kept_apart() catch _ -> "") == "Card_index_index(board)"
        }
    }
    given "a migration over rows already there" {
        then "an index no longer declared is ended" {
            !(index_ended() catch _ -> "Card_index(board,due)").contains("Card_index(board,due)")
        }
        then "an index newly declared is begun, and every row stays" {
            (index_begun() catch _ -> "") == "ok 1 2 true"
        }
        then "the same indexes recorded and declared change nothing" {
            (index_current() catch _ -> "") == "ok 0 ok 0"
        }
        then "a renamed indexed field ends its index and begins it under the new name" {
            (index_renamed() catch _ -> "") == "ok 3 Moved_index(room) a"
        }
    }
}
