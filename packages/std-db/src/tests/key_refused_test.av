//! A several-column key that cannot be held — `@unique(a, b) c` naming a
//! field the model stores no column for, naming a field twice, or written
//! twice — is refused where it is written: once per mistake, under the
//! library's own kind, in its words and with its help.
use @std.io.{env, make_dirs, write_text}
use @std.meta.{embed}
use @std.process.{cmd, inherited, tool}
use @std.time.{ms, stamp}

/// Models whose every key breaks one law.
const key_models: string = embed("key_refused/models.txt")

/// What stands for a check that never answered: no line of it is a refusal.
const key_check_unrun = "the check did not run"

/// What `avra check` says about a package holding the models, once.
once fn key_check() -> string {
    let tree = env("PWD") ?? "."
    let root = "${tree}/build/scratch/db_key_refused_${stamp()}"
    let _ = make_dirs("${root}/src")
    let _ = write_text(
        "${root}/avra.toml",
        "[package]\nname = \"db_key_refused\"\nversion = \"0.1.0\"\n",
    )
    let _ = write_text("${root}/src/main.av", key_models)
    let avra = match tool("${tree}/avra") { .Ok(t) -> t, .Err(_) -> { return key_check_unrun } }
    match (cmd(avra, ["check", root]) with { env: inherited(), timeout: ms(600000) }).outcome() {
        .Ok(o) -> o.out.stdout,
        .Err(_) -> key_check_unrun,
    }
}

/// Every refusal the check spoke and every help under one, in order.
fn key_voices() -> List<string> {
    [l for l in key_check().split("\n") if l.starts_with("error[") || l.starts_with("help: ")]
}

/// Whether `refusal` was spoken exactly once, with `help` the line under it.
fn voiced_once(refusal: string, help: string) -> bool {
    let voices = key_voices()
    let at = [j for j, l in voices if l == refusal]
    at.length == 1 && at[0] + 1 < voices.length && voices[at[0] + 1] == help
}

/// How many refusals of `kind` the check spoke.
fn voiced_as(kind: string) -> int { key_voices().filter(it.starts_with("error[@std/db:${kind}]: ")).length }

spec "@model — a several-column key that cannot be held" {
    given "a key naming a field the model does not declare" {
        then "is refused once as `unique_unstored`, naming the model and the field, and told the fields it stores" {
            voiced_once(
                "error[@std/db:unique_unstored]: `@unique(…)` names the fields a value is unique within, each one a column, and `Misnamed` stores none for `nmae`",
                "help: name fields `Misnamed` stores: id, name",
            )
        }
    }
    given "a key naming a `Many`" {
        then "is refused once as `unique_unstored`, a `Many` storing no column, and told the fields it stores" {
            voiced_once(
                "error[@std/db:unique_unstored]: `@unique(…)` names the fields a value is unique within, each one a column, and `OverMany` stores none for `tags`",
                "help: name fields `OverMany` stores: id",
            )
        }
    }
    given "a key naming one field twice" {
        then "is refused once as `unique_repeats`, naming the marked field and the repeated one" {
            voiced_once(
                "error[@std/db:unique_repeats]: a key holds each field once, and this one on `slug` holds `name` twice",
                "help: name `name` once, and never the field the mark stands on",
            )
        }
    }
    given "a key naming the field its mark stands on" {
        then "is refused once as `unique_repeats`, the marked field held twice" {
            voiced_once(
                "error[@std/db:unique_repeats]: a key holds each field once, and this one on `slug` holds `slug` twice",
                "help: name `slug` once, and never the field the mark stands on",
            )
        }
    }
    given "one key written twice on a field" {
        then "is refused once as `unique_twice`, naming the key's fields and the marked field" {
            voiced_once(
                "error[@std/db:unique_twice]: a key is declared once, and the key over `name`, `slug` stands on `slug` twice",
                "help: write the mark once",
            )
        }
    }
    given "the five mistakes in one package" {
        then "speaks two `unique_unstored`, two `unique_repeats` and one `unique_twice`" {
            voiced_as("unique_unstored") == 2 &&
                voiced_as("unique_repeats") == 2 &&
                voiced_as("unique_twice") == 1
        }
        then "speaks five refusals and no other" { key_voices().filter(it.starts_with("error[")).length == 5 }
    }
}
