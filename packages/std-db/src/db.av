//! `@std/db` — a record type IS the schema. `@model` reads a
//! declaration's fields (their names, their shapes, their marks) and
//! answers the table DDL and the typed CRUD that agree with it —
//! never a second, hand-kept schema description. It answers both the
//! generated code AND the declaration's own contract in one `Declared`
//! value: `made` is the `impl`, `problems` is every way the shape
//! breaks the model law, spoken at the declaration itself.
//!
//!     use @std.db.{model}
//!     use @std.sqlite.{Db}
//!
//!     @model
//!     type User = {
//!         id: int = 0
//!         @unique email: string
//!         name: string
//!     }
//!
//! Every model's FIRST field is `id: int = 0` — the primary key SQLite
//! mints, held in the type itself so a found row and an inserted one
//! are the same shape. `@unique` marks a column's own constraint.
//!
//! Stands ALONE with `@std/meta`, per CLAUDE.md's derive-isolation law
//! — the file that types this trait must not also carry code the
//! annotated file's own names could shadow.
use @std.meta.{
    Type,
    Field,
    Kind,
    Directive,
    Diagnostic,
    Declared,
    Code,
    Decls,
    Stmts,
    name,
    literal,
    type_named,
    refuse_as_at,
}
use @std.errors.{Loc}
use @std.sqlite.{Db, Row, SqlValue, sql, prepared}
use @std.sqlite.error.{SqlError}
use @std.validate.{Checked, Issues, checker, decoder, stripped}
use @std.time.{now_ms}
use apply.{MigrateError, grown, lifted}
use shape.{ColumnFacts, create_sql, quoted, shape_text}
use error.{ModelError, UniqueField, or_attributed, or_invalid, modeled, parent_of, removed}

/// The phantom a one-to-many relation is held as. `cards: Many<Card>`
/// stores nothing: the derive reads the rows through the child's own link
/// (`board.cards(db)`), so the field only says which children a parent has.
export type Many<T> = {}

export trait Model {
    static fn derive(t: Type) -> List<Directive> {
        let read = stripped(t, claimed(t))
        [
            Directive { twin: "", name: t.name, at: t.at, source: generated(t) },
            Directive { twin: "", name: t.name, at: t.at, source: checks(read) },
            Directive { twin: "", name: t.name, at: t.at, source: decodes(read) },
        ]
            .concat(
                [Directive { twin: "", name: filter_name(t, f), at: t.at, source: filter_enum(t, f) } for f in filtered_fields(t)],
            )
    }

    /// The marks this derive reads: `@unique` makes a column unique,
    /// `@soft_delete` makes `remove` keep the row, `@auto` makes a column
    /// the database's to set, `@cascade` and `@set_null` say what removing a
    /// parent does to a child, `@via(field)` names a `Many`'s link, and
    /// `@renamed_from("old")` says a field continues a column of that name.
    static fn marks(t: Type) -> List<string> { ["unique", "soft_delete", "auto", "cascade", "set_null", "via", "renamed_from"] }
}

/// `@model` — the library's own name for `@derive(Model)`, so the
/// declaration reads as what it is rather than a trait a reader has
/// to look up. `made` is the generated `impl`, built even over a
/// shape `problems` refuses (the `impl` it builds may be one nothing
/// should call, but it never traps the compiler on a shape it was
/// never built for) — `problems` is what actually stops the build,
/// spoken as real diagnostics at the declaration itself.
export fn model(t: Type) -> Declared {
    Declared { made: Model.derive(t), problems: shape_problems(t) }
}

/// `@model`'s contract: every refusal here is a package-namespaced
/// `Diagnostic` (`@std/db: no_id_field`, ...), in the law's own words.
fn shape_problems(t: Type) -> List<Diagnostic> {
    if t.variants.length > 0 { return [enum_not_supported(t)] }
    if !has_id_field(t) { return [no_id_field(t)] }
    [soft_delete_kind(f) for f in t.fields if is_mark(f, "soft_delete") && !nullable_int(f.kind)]
        .concat([auto_kind(f) for f in t.fields if is_mark(f, "auto") && !plain_int(f.kind)])
}

// ── The shape a model must have ──────────────────────────────────

/// The FIRST field, required, or `@model` refuses with `no_id_field`.
fn has_id_field(t: Type) -> bool {
    !t.fields.is_empty() && t.fields[0].name == "id" && t.fields[0].kind is .Int
}

fn nullable_int(k: Kind) -> bool {
    match k { .Opt(.Int) -> true, rest -> false }
}

fn plain_int(k: Kind) -> bool {
    match k { .Int -> true, rest -> false }
}

/// The same question `shape_problems` answers as diagnostics, asked
/// here as a bool: `generated` builds NOTHING over a shape this
/// fails, rather than an `impl` whose every method mistypes against a
/// shape it was never built for. `shape_problems` is what SPEAKS the
/// refusal; this is what stops a second, silent, unrelated pile of
/// errors from speaking over it.
fn shape_ok(t: Type) -> bool { t.variants.is_empty() && has_id_field(t) && shape_problems(t).is_empty() }

/// The annotations a model owns — its marks and its own — which are no
/// rule of the validation it brings.
fn claimed(t: Type) -> List<string> { Model.marks(t).concat(["model"]) }

/// The rules the type declares, run over a row before any SQL.
fn checks(t: Type) -> Decls {
    if !shape_ok(t) { return quote { impl ${t} { } } }
    checker(t)
}

/// The type read from a body by the same rules: one door in. A model that
/// holds links has no whole wire shape yet: its link travels as a key and
/// the parent is fetched after, which the body alone cannot do, so it
/// derives no decoder until the key-carrying projection exists.
fn decodes(t: Type) -> Decls {
    if !shape_ok(t) || t.fields.any(link_target(it) != null || is_many(it)) { return quote { impl ${t} { } } }
    decoder(t)
}

fn generated(t: Type) -> Decls {
    if !shape_ok(t) { return quote { impl ${t} { } } }
    quote {
        impl ${t} {
            static fn table_name() -> string { ${literal(table_name_of(t))} }
            static fn create_table_sql() -> string { ${literal(create_table_sql_of(t))} }

            /// The table as the database holds it, one line per column in
            /// name order — what the registry records when it is created.
            static fn shape() -> string { ${literal(shape_text_of(t))} }

            static fn create_table(db: Db) -> Result<int, SqlError> {
                db.run(sql("PRAGMA foreign_keys = ON"))?
                db.run(sql(${literal(claim_registry_sql())}))?
                if (db.scalar(sql(${literal(shape_column_probe_sql())}))?).int()? == 0 {
                    let _ = db.run(sql(${literal(shape_column_add_sql())}))?
                }
                if (db.scalar(sql(${literal(owner_column_probe_sql())}))?).int()? == 0 {
                    let _ = db.run(sql(${literal(owner_column_add_sql())}))?
                }
                let claim = db.first(sql(${literal(claim_select_sql())}, [.Text(${literal(table_name_of(t))})]))?
                match claim {
                    null -> {
                        let _ = db.run(sql(${literal(claim_insert_sql())}, [.Text(${literal(table_name_of(t))}), .Text(${literal(declared_at_of(t))}), .Text(${literal(shape_text_of(t))}), .Text(${literal(owner_of(t))})]))?
                    }
                    row? -> {
                        let owner = text_or_null(row, 0)
                        let shape = text_or_null(row, 1)
                        if owner == null && (shape == null || shape == ${literal(shape_text_of(t))}) {
                            let _ = db.run(sql(${literal(claim_adopt_sql())}, [.Text(${literal(owner_of(t))}), .Text(${literal(table_name_of(t))})]))?
                        } else if owner != ${literal(owner_of(t))} {
                            fail SqlError.defect(${literal(collision_message(t))} + (owner ?? shape_conflict_word()))
                        }
                    }
                }
                db.run(sql(${literal(create_table_sql_of(t))}))
            }

            /// The table made if it is not there, and grown to this model's
            /// shape if it is; a change that moves is refused with its words.
            /// Answers how many steps it took.
            static fn migrate(db: Db) -> Result<int, MigrateError> {
                let _ = lifted(${name(t.name)}.create_table(db))?
                grown(db, ${name(t.name)}.shape(), [..${renamed_to(t)}], [..${renamed_from(t)}])
            }

            fn insert(db: Db) -> Result<${t}, ModelError> {
                let _ = or_invalid(self.check())?
                mut args: List<SqlValue> = []
                ${[push_bound(f) for f in written_fields(t)]}
                or_attributed(db.run(sql(${literal(insert_sql_of(t))}, args)), ${literal(table_name_of(t))}, ${unique_fields_code(t)})?
                ${inserted_row(t)}
            }

            static fn find(db: Db, id: int) -> Result<${t}?, SqlError> {
                ${[cache_stmt(f) for f in links(t)]}
                let s = prepared(db, sql(${literal(select_by_id_sql_of(t))}, [.Int(id)]))?
                defer s.reset()
                if s.step()? { ${row_ctor(t)} } else { null }
            }

            fn update(db: Db) -> Result<int, ModelError> {
                let _ = or_invalid(self.check())?
                mut args: List<SqlValue> = []
                ${[push_bound(f) for f in written_fields(t)]}
                args.push(.Int(self.id))
                or_attributed(db.run(sql(${literal(update_sql_of(t))}, args)), ${literal(table_name_of(t))}, ${unique_fields_code(t)})
            }

            /// The rows, in the order they were inserted.
            static fn all(db: Db) -> Result<List<${t}>, SqlError> {
                ${name(t.name)}.where(db)
            }

            ${where_decl(t)}

            fn remove(db: Db) -> Result<int, ModelError> {
                ${removal(t)}
            }

            ${soft_decls(t)}

            ${link_decls(t)}

            ${many_decls(t)}
        }
    }
}

// ── Reading and removing by the fields. ──

/// The columns a request writes: every one but the key and the ones the
/// database sets.
fn written_fields(t: Type) -> List<Field> { [f for f in non_id_fields(t) if !is_mark(f, "auto") && !is_many(f)] }

// ── Relations. A field of another model's type is a LINK: the column
// `<field>_id` holds its key, and a read fetches the parent. `Many<T>` is
// the other end: no column, an accessor over the child's link. ──

/// The model a link field points at, null for any other field.
fn link_target(f: Field) -> string? {
    match f.kind {
        .Named(n, args) or .Opt(.Named(n, args)) -> if n != "Many" && args.is_empty() { n } else { null },
        rest -> null,
    }
}

fn links(t: Type) -> List<Field> { [f for f in t.fields if link_target(f) != null] }

fn is_many(f: Field) -> bool {
    match f.kind { .Named(n, args) -> n == "Many" && args.length == 1, rest -> false }
}

/// The columns a model stores: its fields but the `Many`s.
fn stored(t: Type) -> List<Field> { [f for f in t.fields if !is_many(f)] }

/// The column a field is stored in: a link's key, else the field's own name.
fn column_of(f: Field) -> string {
    if link_target(f) != null { return "${f.name}_id" }
    f.name
}

/// A link's per-call cache of parents already fetched.
fn cache_name(f: Field) -> string { "parents_${f.name}" }

fn cache_stmt(f: Field) -> Stmts {
    quote {
        // LICENSED let_stmt.unmutated_mut: `parent_of`'s call, in another template, fills it
        mut ${cache_name(f)}: Map<string, ${link_target(f) ?? ""}> = {}
    }
}

fn is_mark(f: Field, word: string) -> bool { f.marks.any(it.name == word) }

fn soft_field(t: Type) -> Field? { t.fields.find(is_mark(it, "soft_delete")) }

/// The row as the database holds it once written: re-read when it has
/// columns the database set, else the value written with its new key.
fn inserted_row(t: Type) -> Code {
    if t.fields.all(!is_mark(it, "auto")) { return quote { self with { id: db.last_insert_rowid() } } }
    quote {
        {
            let key = db.last_insert_rowid()
            let held = modeled(${name(t.name)}.find(db, key))?
            held ?? (self with { id: key })
        }
    }
}

/// `where`: a row per match of every field named, none named is every
/// row. A soft-delete model's reads skip what was removed. A nullable
/// field filters by its value; null names no filter.
fn where_decl(t: Type) -> Decls {
    let seats = [where_seat(t, f) for f in stored(t)]
    quote { static fn where(db: Db, ..${seats}) -> Result<List<${t}>, SqlError> { ${where_body(t)} } }
}

/// One filter seat — the shape the parameter list splices, its own name
/// and type holes read off the field.
fn where_seat(t: Type, f: Field) -> Decls {
    quote { fn _(${f.name}: ${param_type(t, f)} = ${param_default(f)}) {} }
}

/// A filter's seat. A column that cannot hold null filters by its value,
/// the seat nullable so that leaving it out names no filter; a nullable
/// column takes a `Filter`, since null is itself a value to match.
fn param_type(t: Type, f: Field) -> string {
    if nullable(f.kind) { return filter_name(t, f) }
    "${f.kind.spelled()}?"
}

/// The enum a nullable column's filter seat takes, generated beside
/// the model so it needs no import: `Any` names no filter, `Is(v)` the
/// value it must equal, `Is(null)` the rows where it IS NULL — null is a
/// value to match there, so it cannot also mean "not given".
fn filter_name(t: Type, f: Field) -> string { "${t.name}_${f.name}_filter" }

fn filter_enum(t: Type, f: Field) -> Decls {
    quote {
        enum ${filter_name(t, f)} {
            Any
            Is(value: ${f.kind.spelled()})
        }
    }
}

fn param_default(f: Field) -> Code {
    if nullable(f.kind) { quote { .Any } } else { quote { null } }
}

/// The columns whose `where` seat is a generated filter enum.
fn filtered_fields(t: Type) -> List<Field> { if shape_ok(t) { [f for f in t.fields if nullable(f.kind)] } else { [] } }

fn nullable(k: Kind) -> bool {
    match k { .Opt(_) -> true, rest -> false }
}

fn filter_kind(k: Kind) -> Kind {
    match k { .Opt(inner) -> inner, rest -> k }
}

fn where_body(t: Type) -> Stmts {
    quote {
        mut clauses: List<string> = ${clauses_code(live_clause(t))}
        mut args: List<SqlValue> = []
        ${[cache_stmt(f) for f in links(t)]}
        ${[filter_stmt(f) for f in stored(t)]}
        let where_text = if clauses.is_empty() { "" } else { " WHERE " + clauses.join(" AND ") }
        let s = prepared(db, sql(${literal(select_prefix_sql_of(t))} + where_text + ${literal(order_suffix_sql())}, args))?
        defer s.reset()
        mut rows: List<${t}> = []
        while s.step()? { rows.push(${row_ctor(t)}) }
        rows
    }
}

fn clauses_code(live: string) -> Code {
    if live.is_empty() { quote { [] } } else { quote { [${literal(live)}] } }
}

fn filter_stmt(f: Field) -> Stmts {
    if nullable(f.kind) { return nullable_filter(f) }
    quote {
        if ${name(f.name)} != null {
            clauses.push(${literal("${quoted(column_of(f))} = ?")})
            args.push(${bound_value(f.kind, quote { ${name(f.name)}! })})
        }
    }
}

/// `Any` names no filter; `Is(null)` keeps the rows where the column is
/// NULL, `Is(v)` those equal to `v`.
fn nullable_filter(f: Field) -> Stmts {
    quote {
        if ${name(f.name)} is .Is(wanted) {
            if wanted == null {
                clauses.push(${literal("${quoted(column_of(f))} IS NULL")})
            } else {
                clauses.push(${literal("${quoted(column_of(f))} = ?")})
                args.push(${bound_value(filter_kind(f.kind), quote { wanted! })})
            }
        }
    }
}

/// What `remove` does: a soft-delete model stamps the time and keeps
/// the row; any other deletes it.
fn removal(t: Type) -> Code {
    if soft_field(t) == null {
        return quote { removed(db.run(sql(${literal(delete_sql_of(t))}, [.Int(self.id)])), ${literal(table_name_of(t))}) }
    }
    quote {
        let opened = modeled(db.begin_unless_open())?
        defer db.finish_if_opened(opened)
        ${[cascade_stmt(f) for f in cascading(t)]}
        let changed = modeled(db.run(sql(${literal(soft_remove_sql_of(t))}, [.Int(now_ms()), .Int(self.id)])))?
        if opened { let _ = modeled(db.commit())? }
        changed
    }
}

// ── The other end of a link. ──

/// The child model a `Many` field names.
fn many_child(f: Field) -> string? {
    match f.kind {
        .Named(n, args) -> if n == "Many" && args.length == 1 { args[0].spelled() } else { null },
        rest -> null,
    }
}

/// The columns a `@renamed_from("old")` field continues, and the names they had:
/// two lists of one length, a column and its old name at each index.
fn renamed_to(t: Type) -> List<Code> { [literal(column_of(f)) for f in stored(t) if old_name(f) != null] }

fn renamed_from(t: Type) -> List<Code> { [literal(old_name(f)!) for f in stored(t) if old_name(f) != null] }

/// The name a field's column had before, as `@renamed_from("name")` says it.
fn old_name(f: Field) -> string? {
    let mark? = f.marks.find(it.name == "renamed_from") else { return null }
    let word? = mark.args.first() else { return null }
    if word.starts_with("\"") && word.ends_with("\"") && word.length >= 2 { word.substring(1, word.length - 1) } else { word }
}

/// The child's field that links back: `@via(field)` when written, else the
/// child's one link to this model, read from the child's own declaration.
fn inverse_link(t: Type, f: Field) -> string? {
    let via = f.marks.find(it.name == "via")
    if via != null && !via!.args.is_empty() { return via!.args[0] }
    let child? = many_child(f) else { return null }
    let declared? = type_named(child) else { return null }
    let ours = [g.name for g in declared.fields if link_target(g) == t.name]
    if ours.length == 1 { ours[0] } else { null }
}

/// The `Many` fields whose children go when this row does: the child's
/// link says `@cascade`.
fn cascading(t: Type) -> List<Field> { [f for f in t.fields if is_many(f) && child_cascades(t, f)] }

fn child_cascades(t: Type, f: Field) -> bool {
    let child? = many_child(f) else { return false }
    let link? = inverse_link(t, f) else { return false }
    let declared? = type_named(child) else { return false }
    declared.fields.any(it.name == link && is_mark(it, "cascade"))
}

fn cascade_stmt(f: Field) -> Stmts {
    quote {
        for kid in modeled(self.${f.name}(db))? { let _ = kid.remove(db)? }
    }
}

/// For each link: `in_<field>`, the rows whose link is one of these
/// parents, in one query however many there are.
fn link_decls(t: Type) -> List<Decls> {
    [link_decl(t, f) for f in links(t)]
}

fn link_decl(t: Type, f: Field) -> Decls {
    let parent = link_target(f) ?? ""
    let live = live_clause(t)
    quote {
        static fn ${"in_" + f.name}(db: Db, owners: List<${parent}>) -> Result<List<${t}>, SqlError> {
            if owners.is_empty() { return [] }
            ${[cache_stmt(g) for g in links(t)]}
            let marks = ["?" for _o in owners].join(", ")
            let keys = [SqlValue.Int(o.id) for o in owners]
            let text = ${literal(select_prefix_sql_of(t) + " WHERE " + quoted(column_of(f)) + " IN (")} + marks + ${literal(")" + if live.is_empty() { "" } else { " AND " + live } + order_suffix_sql())}
            let s = prepared(db, sql(text, keys))?
            defer s.reset()
            mut rows: List<${t}> = []
            while s.step()? { rows.push(${row_ctor(t)}) }
            rows
        }
    }
}

/// Whether child `k` links to owner `o`; an optional link may hold none.
fn owned_by(child: string, link: string) -> Code {
    let declared? = type_named(child) else { return quote { k.${link}.id == o.id } }
    let optional = declared.fields.any(it.name == link && nullable(it.kind))
    if optional { quote { k.${link}?.id == o.id } } else { quote { k.${link}.id == o.id } }
}

/// For each `Many`: its rows, and the whole page's in one query.
fn many_decls(t: Type) -> List<Decls> { [many_decl(t, f) for f in t.fields if is_many(f)] }

fn many_decl(t: Type, f: Field) -> Decls {
    let child = many_child(f) ?? ""
    let link = inverse_link(t, f) ?? ""
    quote {
        /// The rows linked to this one.
        fn ${f.name}(db: Db) -> Result<List<${child}>, SqlError> {
            ${name(child)}.${"in_" + link}(db, [self])
        }

        /// These parents' rows, one list each, fetched in one query.
        static fn ${"with_" + f.name}(db: Db, owners: List<${t}>) -> Result<List<List<${child}>>, SqlError> {
            let kids = ${name(child)}.${"in_" + link}(db, owners)?
            [[k for k in kids if ${owned_by(child, link)}] for o in owners]
        }
    }
}

/// The trash and its undo, for a soft-delete model alone.
fn soft_decls(t: Type) -> List<Decls> {
    if soft_field(t) == null { return [] }
    [
        quote {
            /// The rows that were removed, in the order they were inserted.
            static fn trash(db: Db) -> Result<List<${t}>, SqlError> {
                ${[cache_stmt(f) for f in links(t)]}
                let s = prepared(db, sql(${literal(trash_sql_of(t))}, []))?
                defer s.reset()
                mut rows: List<${t}> = []
                while s.step()? { rows.push(${row_ctor(t)}) }
                rows
            }

            /// A removed row, back among the living.
            fn restore(db: Db) -> Result<int, SqlError> {
                db.run(sql(${literal(restore_sql_of(t))}, [.Int(self.id)]))
            }
        },
    ]
}

// ── `@model`'s refusals — each a `Diagnostic` at the type's own
// declaration, stating the law broken in its own words, never a
// generic "`@model` failed:" prefix flattening three different
// mistakes into one sentence. A KIND IS A BARE WORD, never dotted —
// `is_kind_word` (core/modules.av) refuses `.` in one, because the
// package is ALREADY the namespace: `user_kind` prefixes it as
// `@std/db:enum_not_supported`, so a self-chosen `model.` prefix
// would only duplicate what the package name already says. ──

fn enum_not_supported(t: Type) -> Diagnostic {
    refuse_as_at(
        "enum_not_supported",
        t.at,
        "`@model` derives a table from a record's fields — `${t.name}` is an enum, with none",
        "declare `${t.name}` as a record: `type ${t.name} = { id: int = 0, ... }`",
    )
}

fn no_id_field(t: Type) -> Diagnostic {
    refuse_as_at(
        "no_id_field",
        t.at,
        "every `@model`'s first field is `id: int = 0` — the primary key SQLite mints — and `${t.name}` ${first_field_words(t)}",
        "add `id: int = 0` as `${t.name}`'s first field",
    )
}

fn first_field_words(t: Type) -> string {
    if t.fields.is_empty() { return "has no fields at all" }
    "declares `${t.fields[0].name}: ${t.fields[0].ty}` first"
}

fn soft_delete_kind(f: Field) -> Diagnostic {
    refuse_as_at(
        "soft_delete_kind",
        f.at,
        "`@soft_delete` holds the time a row was removed, a nullable integer, and `${f.name}` is `${f.ty}`",
        "declare it `${f.name}: int? = null`",
    )
}

fn auto_kind(f: Field) -> Diagnostic {
    refuse_as_at(
        "auto_kind",
        f.at,
        "`@auto` is a time the database sets, an integer, and `${f.name}` is `${f.ty}`",
        "declare it `${f.name}: int`",
    )
}

// ── The DDL, built once from the fields — plain string assembly at
// derive time, never a quote hole (a run of columns has no expression
// position to splice into; a string is just a value). ──

fn table_name_of(t: Type) -> string { t.name }

fn quoted_table(t: Type) -> string { quoted(table_name_of(t)) }

fn non_id_fields(t: Type) -> List<Field> { t.fields.slice(1, t.fields.length) }

/// Reserved on every table, unconditionally, whether or not this phase
/// reads it — a monotonic write counter Phase 7's compare-and-set
/// authority needs on rows that already exist by the time it lands.
/// Double-underscore-wrapped like `__avra_models__`, so no field an Avra
/// program can declare will ever collide with it. Hidden: it never
/// appears on the struct, in `find`'s column list, or anywhere a user
/// can read or write from Phase 1.
const VERSION_COLUMN: string = "__avra_version__"

fn create_table_sql_of(t: Type) -> string { create_sql(table_name_of(t), table_columns(t)) }

/// A model's columns as the database holds them: its stored fields, then the
/// hidden version column.
fn table_columns(t: Type) -> List<ColumnFacts> { [column_facts(f) for f in stored(t)].concat([version_facts()]) }

fn version_facts() -> ColumnFacts {
    ColumnFacts { name: VERSION_COLUMN, sql_type: "INTEGER", not_null: true, default: "1" }
}

fn column_facts(f: Field) -> ColumnFacts {
    if f.name == "id" { return ColumnFacts { name: f.name, sql_type: "INTEGER", key: true } }
    let parent? = link_target(f) else { return plain_facts(f) }
    ColumnFacts {
        name: column_of(f),
        sql_type: "INTEGER",
        not_null: !nullable(f.kind),
        refs: parent,
        on_delete: on_delete(f),
    }
}

fn plain_facts(f: Field) -> ColumnFacts {
    if is_mark(f, "auto") {
        return ColumnFacts {
            name: f.name,
            sql_type: "INTEGER",
            not_null: true,
            default: auto_default(),
        }
    }
    ColumnFacts {
        name: f.name,
        sql_type: sql_type_of(f.kind),
        not_null: !nullable(f.kind),
        unique: is_unique(f),
    }
}

/// What removing a parent does to this child: `@cascade` removes it,
/// `@set_null` clears the link, and neither refuses the removal
/// (`NO ACTION`, which answers constraint code 787; `RESTRICT` would
/// answer the trigger code 1811, SQLite building it from a trigger).
fn on_delete(f: Field) -> string {
    when {
        is_mark(f, "cascade") -> "CASCADE"
        is_mark(f, "set_null") -> "SET NULL"
        _ -> "NO ACTION"
    }
}

fn shape_text_of(t: Type) -> string { shape_text(table_name_of(t), table_columns(t)) }

/// Milliseconds since the epoch, as the database reads its own clock.
fn auto_default() -> string { "(CAST((julianday('now') - 2440587.5) * 86400000 AS INTEGER))" }

fn is_unique(f: Field) -> bool { f.marks.any(it.name == "unique") }

/// The `@unique` fields' own (name, declaration site) pairs, baked
/// into `insert`/`update`'s generated body so a constraint violation
/// resolves back through the schema the moment it happens — never a
/// second lookup against `t` at run time, which the derive has no
/// reason to keep around. The list's elements are a run, so no arity is
/// known here.
fn unique_fields_code(t: Type) -> Code {
    let fs = [f for f in non_id_fields(t) if is_unique(f)]
    quote { [..${[unique_field_code(f) for f in fs]}] }
}

fn unique_field_code(f: Field) -> Code {
    quote { UniqueField { name: ${literal(f.name)}, at: ${loc_code(f.at)} } }
}

fn loc_code(at: Loc?) -> Code {
    match at {
        loc? -> quote { Loc { file: ${loc_file_code(loc.file)}, lo: ${loc.lo}, hi: ${loc.hi} } }
        null -> quote { null }
    }
}

fn loc_file_code(file: string?) -> Code {
    match file {
        f? -> quote { ${literal(f)} }
        null -> quote { null }
    }
}

fn sql_type_of(k: Kind) -> string {
    match k {
        .Int or .Bool -> "INTEGER",
        .Float -> "REAL",
        .Str -> "TEXT",
        .Opt(inner) -> sql_type_of(inner),
        rest -> "a_model_field_kind_this_derive_has_no_sql_type_for",
    }
}

/// A model with no field besides `id` has nothing to name in a column
/// list SQLite will accept — `INSERT INTO t () VALUES ()` is a syntax
/// error, so the zero-column case is its own, still-honest SQL.
fn insert_sql_of(t: Type) -> string {
    let fs = written_fields(t)
    if fs.is_empty() { return "INSERT INTO ${quoted_table(t)} DEFAULT VALUES" }
    let names = [quoted(column_of(f)) for f in fs].join(", ")
    let marks = ["?" for f in fs].join(", ")
    "INSERT INTO ${quoted_table(t)} (${names}) VALUES (${marks})"
}

fn select_prefix_sql_of(t: Type) -> string {
    let names = [quoted(column_of(f)) for f in stored(t)].join(", ")
    "SELECT ${names} FROM ${quoted_table(t)}"
}

fn order_suffix_sql() -> string { " ORDER BY ${quoted("id")}" }

/// A soft-delete model's reads skip what was removed.
fn live_clause(t: Type) -> string {
    let f? = soft_field(t) else { return "" }
    "${quoted(f.name)} IS NULL"
}

fn select_by_id_sql_of(t: Type) -> string {
    let live = live_clause(t)
    "${select_prefix_sql_of(t)} WHERE ${quoted("id")} = ?${if live.is_empty() { "" } else { " AND " + live }}"
}

fn trash_sql_of(t: Type) -> string {
    let f? = soft_field(t) else { return "" }
    "${select_prefix_sql_of(t)} WHERE ${quoted(f.name)} IS NOT NULL${order_suffix_sql()}"
}

fn soft_remove_sql_of(t: Type) -> string {
    let f? = soft_field(t) else { return "" }
    "UPDATE ${quoted_table(t)} SET ${quoted(f.name)} = ?, ${version_bump_clause()} WHERE ${quoted("id")} = ? AND ${quoted(f.name)} IS NULL"
}

fn restore_sql_of(t: Type) -> string {
    let f? = soft_field(t) else { return "" }
    "UPDATE ${quoted_table(t)} SET ${quoted(f.name)} = NULL, ${version_bump_clause()} WHERE ${quoted("id")} = ?"
}

/// The version bump is always in `SET`, so a column-free model still
/// gets a syntactically valid `UPDATE` with no special case — unlike
/// `insert_sql_of`, which has no such column to fall back on.
fn update_sql_of(t: Type) -> string {
    let sets = [set_clause(f) for f in written_fields(t)].concat([version_bump_clause()]).join(", ")
    "UPDATE ${quoted_table(t)} SET ${sets} WHERE ${quoted("id")} = ?"
}

fn set_clause(f: Field) -> string { "${quoted(column_of(f))} = ?" }

fn version_bump_clause() -> string { "${quoted(VERSION_COLUMN)} = ${quoted(VERSION_COLUMN)} + 1" }

fn delete_sql_of(t: Type) -> string {
    "DELETE FROM ${quoted_table(t)} WHERE ${quoted("id")} = ?"
}

// ── The table-name claim registry — TWO different @model types
// sharing a bare name (across modules, no language law stops it) will
// otherwise write into ONE physical table with no error at all if
// their shapes ever happen to line up. `create_table` claims its name
// here before ever touching the real table, naming the exact file
// that claimed it first, the moment a second claimant disagrees. ──

fn claim_registry_sql() -> string {
    "CREATE TABLE IF NOT EXISTS \"__avra_models__\" (\"table_name\" TEXT PRIMARY KEY, \"declared_at\" TEXT, \"shape\" TEXT)"
}

/// A registry made before shapes were recorded lacks the column: it is
/// added, and an older claim's shape stays NULL — unknown, never guessed.
fn shape_column_probe_sql() -> string {
    "SELECT count(*) FROM pragma_table_info('__avra_models__') WHERE name = 'shape'"
}

fn shape_column_add_sql() -> string { "ALTER TABLE \"__avra_models__\" ADD COLUMN \"shape\" TEXT" }

/// A registry made before owners were recorded lacks the column: it is
/// added, and an older claim's owner stays NULL until a model whose shape
/// agrees adopts it.
fn owner_column_probe_sql() -> string {
    "SELECT count(*) FROM pragma_table_info('__avra_models__') WHERE name = 'owner'"
}

fn owner_column_add_sql() -> string { "ALTER TABLE \"__avra_models__\" ADD COLUMN \"owner\" TEXT" }

fn claim_select_sql() -> string {
    "SELECT \"owner\", \"shape\" FROM \"__avra_models__\" WHERE \"table_name\" = ?"
}

fn claim_insert_sql() -> string {
    "INSERT INTO \"__avra_models__\" (\"table_name\", \"declared_at\", \"shape\", \"owner\") VALUES (?, ?, ?, ?)"
}

fn claim_adopt_sql() -> string {
    "UPDATE \"__avra_models__\" SET \"owner\" = ? WHERE \"table_name\" = ?"
}

/// A model's identity: its package-qualified module. It survives moving
/// or recloning the project, which a file path does not.
fn owner_of(t: Type) -> string { t.module }

/// The declaring file, kept in the registry for a reader only.
fn declared_at_of(t: Type) -> string { t.at?.file ?? "?" }

fn collision_message(t: Type) -> string {
    "table \"${table_name_of(t)}\" is already claimed by a @model of module "
}

/// A column's text, or null where it holds NULL.
fn text_or_null(r: Row, i: int) -> string? {
    match r.values[i] { .Text(v) -> v, _ -> null }
}

fn shape_conflict_word() -> string { "an earlier version with another shape" }

// ── Binding a field OUT (a value crossing to SQLite) and reading one
// IN (a column crossing back) — one exhaustive dispatch each way. ──

fn bound(f: Field) -> Code { bound_value(f.kind, quote { self.${f.name} }) }

/// A value of kind `k`, as the column holds it; a nullable one is NULL
/// when absent.
fn bound_value(k: Kind, v: Code) -> Code {
    match k {
        .Int -> quote { .Int(${v}) },
        .Bool -> quote { .Int(if ${v} { 1 } else { 0 }) },
        .Float -> quote { .Real(${v}) },
        .Str -> quote { .Text(${v}) },
        .Opt(inner) -> quote { if ${v} == null { .Null } else { ${bound_value(inner, quote { ${v}! })} } },
        .Named(_, _) -> quote { .Int(${v}.id) },
        rest -> quote { a_model_field_kind_this_derive_does_not_bind_yet() },
    }
}

fn push_bound(f: Field) -> Code {
    quote { args.push(${bound(f)}) }
}

/// A column read straight off the STANDING statement — never through
/// `Row`/`SqlValue`, which `first_as` (std-sqlite's `sql.av`) is what
/// buys this: a found row costs no values list, no per-cell box, and
/// no `Row` record, only the scalars the struct literal actually holds.
fn read_at(f: Field, i: int) -> Code {
    let parent? = link_target(f) else { return read_kind(f.kind, i) }
    let fetched = quote { parent_of(${name(cache_name(f))}, db, s.int_at(${i})?, (d: Db, key: int) -> ${name(parent)}.find(d, key))? }
    if f.kind is .Opt(_) { return quote { if s.class_at(${i})? is .Null { null } else { ${fetched} } } }
    fetched
}

/// What field `j` of a row is built from: the column it reads, or for a
/// `Many` the phantom it is.
fn field_value(t: Type, j: int) -> Code {
    let f = t.fields[j]
    if is_many(f) { return quote { Many {} } }
    read_at(f, [g for g in t.fields.slice(0, j) if !is_many(g)].length)
}

fn read_kind(k: Kind, i: int) -> Code {
    match k {
        .Int -> quote { s.int_at(${i})? },
        .Bool -> quote { s.int_at(${i})? != 0 },
        .Float -> quote { s.real_at(${i})? },
        .Str -> quote { s.text_at(${i})? },
        .Opt(inner) -> quote { if s.class_at(${i})? is .Null { null } else { ${read_kind(inner, i)} } },
        rest -> quote { a_model_field_kind_this_derive_does_not_read_yet() },
    }
}

/// The row literal a column read fills: one entry per field, spliced as
/// a run, so no arity is known here. Wired into `find` and the reads,
/// above.
fn row_ctor(t: Type) -> Code { quote { ${t} { ..${[row_init(t, f, j) for j, f in t.fields]} } } }

/// One literal entry, named off the field it reads.
fn row_init(t: Type, f: Field, j: int) -> Code { quote { W { ${f.name}: ${field_value(t, j)} } } }
