//! A library that hands a map's entries across its boundary while
//! declaring an `Entry` of its own: the prelude's is named by import.
use @std.prelude.{Entry as Pair}

export type Entry = { label: string }

export fn pairs(m: Map<string, int>) -> List<Pair<string, int>> { m.entries() }

export fn labelled(m: Map<string, int>) -> List<Entry> { [Entry { label: "${k}:${v}" } for k, v in m] }
