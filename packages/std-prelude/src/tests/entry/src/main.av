// proves: `Entry` is the prelude's wherever no nearer name takes it —
// one type across a package boundary, beside a library's own `Entry`.
use @test.pairs.{pairs, labelled}

fn widest(es: List<Entry<string, int>>) -> string { es.find(it.value > 2)?.key ?? "" }

let m = {"a": 1, "b": 3, "c": 2}
"${widest(pairs(m))} ${widest(m.entries())} ${labelled(m)[1].label}"
