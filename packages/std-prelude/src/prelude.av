//! THE PRELUDE: every file in every package sees these names without
//! a `use`, and a file's own declaration or explicit import shadows
//! them silently. It depends on nothing, and the compiler refuses a
//! manifest that says otherwise: it is the floor of the layering
//! `prelude <- text <- io <- process <- …`. Its contents are what the
//! compiler already emits for a program — a line printed, a map's
//! entry — and no more; a name a program can be compiled without
//! belongs to a package above.
extern fn avra_puts(line: string)
extern fn avra_eputs(line: string)

/// One line to standard output.
export fn println(line: string) {
    avra_puts(line)
}

/// One line to standard error.
export fn eprintln(line: string) {
    avra_eputs(line)
}

/// One key of a map beside its value — what `m.entries()` answers,
/// in the map's own order.
export type Entry<K, V> = { key: K, value: V }
