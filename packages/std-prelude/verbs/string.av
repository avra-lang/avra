//! THE VERBS OF `string`, as typing reads them: each a fn whose first seat is the receiver. What a
//! verb does is the compiler's; these say only what it takes and answers.

fn contains(s: string, part: string) -> bool {}
fn starts_with(s: string, part: string) -> bool {}
fn ends_with(s: string, part: string) -> bool {}
fn index_of(s: string, part: string) -> int {}
fn substring(s: string, lo: int, hi: int) -> string {}
fn split(s: string, between: string) -> List<string> {}
fn replace(s: string, old: string, new: string) -> string {}
fn char_code(s: string, at: int) -> int {}
fn trim(s: string) -> string {}
fn is_empty(s: string) -> bool {}
fn chars(s: string) -> List<int> {}
