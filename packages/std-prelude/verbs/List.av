//! THE VERBS OF `List<T>`, as typing reads them: each a fn whose first seat is the receiver. A verb
//! with a body is that body; an empty one is the compiler's, and says only what it takes and answers.

fn map<T, U>(xs: List<T>, f: fn(T) -> U) -> List<U> {}
fn filter<T>(xs: List<T>, f: fn(T) -> bool) -> List<T> {}
fn filter_map<T, U>(xs: List<T>, f: fn(T) -> U?) -> List<U> { [y! for x in xs for y in [f(x)] if y != null] }
fn flat_map<T, U>(xs: List<T>, f: fn(T) -> List<U>) -> List<U> { [y for x in xs for y in f(x)] }
fn flatten<T>(xs: List<List<T>>) -> List<T> { [x for run in xs for x in run] }
fn take<T>(xs: List<T>, n: int) -> List<T> {}
fn drop<T>(xs: List<T>, n: int) -> List<T> {}
fn take_while<T>(xs: List<T>, f: fn(T) -> bool) -> List<T> { xs.slice(0, xs.find_index((x) -> !f(x)) ?? xs.length) }
fn drop_while<T>(xs: List<T>, f: fn(T) -> bool) -> List<T> { xs.slice(xs.find_index((x) -> !f(x)) ?? xs.length, xs.length) }
fn find<T>(xs: List<T>, f: fn(T) -> bool) -> T? {}
fn find_last<T>(xs: List<T>, f: fn(T) -> bool) -> T? {
    mut at = xs.length - 1
    while at >= 0 {
        if f(xs[at]) { return xs[at] }
        at = at - 1
    }
    null
}
fn find_map<T, U>(xs: List<T>, f: fn(T) -> U?) -> U? {}
fn any<T>(xs: List<T>, f: fn(T) -> bool) -> bool {}
fn all<T>(xs: List<T>, f: fn(T) -> bool) -> bool {}
fn contains<T>(xs: List<T>, x: T) -> bool {}
fn index_of<T>(xs: List<T>, x: T) -> int {}
fn fold<T, A>(xs: List<T>, init: A, f: fn(A, T) -> A) -> A {}
fn count<T>(xs: List<T>) -> int {}
fn find_index<T>(xs: List<T>, f: fn(T) -> bool) -> int? {}
fn sum(xs: List<int>) -> int {}
fn min(xs: List<int>) -> int? {}
fn max(xs: List<int>) -> int? {}
fn min_by<T>(xs: List<T>, key: fn(T) -> int) -> T? {
    let first? = xs.first() else { return null }
    xs.fold(first, (best, x) -> if key(x) < key(best) { x } else { best })
}
fn max_by<T>(xs: List<T>, key: fn(T) -> int) -> T? {
    let first? = xs.first() else { return null }
    xs.fold(first, (best, x) -> if key(x) > key(best) { x } else { best })
}
fn push<T>(mut xs: List<T>, x: T) {}
fn pop<T>(mut xs: List<T>) -> T {}
fn set<T>(mut xs: List<T>, at: int, x: T) {}
fn is_empty<T>(xs: List<T>) -> bool { xs.length == 0 }
fn first<T>(xs: List<T>) -> T? {}
fn last<T>(xs: List<T>) -> T? {}
fn get<T>(xs: List<T>, at: int) -> T? {}
fn concat<T>(xs: List<T>, ys: List<T>) -> List<T> {}
fn removed_at<T>(xs: List<T>, at: int) -> List<T> { xs.slice(0, at).concat(xs.slice(at + 1, xs.length)) }
fn inserted<T>(xs: List<T>, at: int, x: T) -> List<T> { xs.slice(0, at).concat([x]).concat(xs.slice(at, xs.length)) }
fn slice<T>(xs: List<T>, lo: int, hi: int) -> List<T> {}
fn join(xs: List<string>, between: string) -> string {}
fn enumerate<T>(xs: List<T>) -> List<T> {}
fn bytes(xs: List<int>) -> Bytes? {}
fn bytes(xs: List<Bytes>) -> Bytes {}
