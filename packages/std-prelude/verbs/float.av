//! THE VERBS OF `float`, as typing reads them: each a fn whose first seat is the receiver. What a
//! verb does is the compiler's; these say only what it takes and answers.
use @std.prelude.{ToInt}

fn floor(x: float) -> Result<int, ToInt> {}
fn ceil(x: float) -> Result<int, ToInt> {}
fn round(x: float) -> Result<int, ToInt> {}
fn trunc(x: float) -> Result<int, ToInt> {}
