//! THE VERBS OF `Cell<T>`, as typing reads them: each a fn whose first seat is the receiver. What a
//! verb does is the compiler's; these say only what it takes and answers.

fn get<T>(c: Cell<T>) -> T {}
fn set<T>(c: Cell<T>, value: T) {}
fn push<T>(c: Cell<List<T>>, x: T) {}
fn set_at<T>(c: Cell<List<T>>, at: int, x: T) {}
fn put<V>(c: Cell<Map<string, V>>, key: string, value: V) {}
