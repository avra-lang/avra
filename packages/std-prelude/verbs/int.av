//! THE VERBS OF `int`, as typing reads them: each a fn whose first seat is the receiver. What a
//! verb does is the compiler's; these say only what it takes and answers.

fn wrapping_add(a: int, b: int) -> int {}
fn wrapping_sub(a: int, b: int) -> int {}
fn wrapping_mul(a: int, b: int) -> int {}
fn wrapping_shl(a: int, b: int) -> int {}
fn checked_add(a: int, b: int) -> int? {}
fn checked_sub(a: int, b: int) -> int? {}
fn checked_mul(a: int, b: int) -> int? {}
fn checked_shl(a: int, b: int) -> int? {}
fn float(a: int) -> float {}
