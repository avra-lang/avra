//! THE VERBS OF `Range`, as typing reads them: each a fn whose first seat is the receiver, whose
//! elements are its `int`s in order. What a verb does is the compiler's; these say only what it
//! takes and answers.

fn map<U>(r: Range, f: fn(int) -> U) -> List<U> {}
fn find(r: Range, f: fn(int) -> bool) -> int? {}
fn find_map<U>(r: Range, f: fn(int) -> U?) -> U? {}
fn any(r: Range, f: fn(int) -> bool) -> bool {}
fn all(r: Range, f: fn(int) -> bool) -> bool {}
fn fold<A>(r: Range, init: A, f: fn(A, int) -> A) -> A {}
fn find_index(r: Range, f: fn(int) -> bool) -> int? {}
fn contains(r: Range, x: int) -> bool {}
fn index_of(r: Range, x: int) -> int {}
fn count(r: Range) -> int {}
fn sum(r: Range) -> int {}
fn min(r: Range) -> int? {}
fn max(r: Range) -> int? {}
