//! THE VERBS OF `Map<string, V>`, as typing reads them: each a fn whose first seat is the receiver.
//! What a verb does is the compiler's; these say only what it takes and answers.

fn get<V>(m: Map<string, V>, key: string) -> V? {}
fn set<V>(mut m: Map<string, V>, key: string, value: V) {}
fn has<V>(m: Map<string, V>, key: string) -> bool {}
fn keys<V>(m: Map<string, V>) -> List<string> {}
fn values<V>(m: Map<string, V>) -> List<V> {}
fn remove<V>(mut m: Map<string, V>, key: string) -> V? {}
fn is_empty<V>(m: Map<string, V>) -> bool {}
