//! THE VERBS OF `Map<string, V>`, as typing reads them: each a fn whose first seat is the receiver.
//! A verb with a body is that body; an empty one is the compiler's, and says only what it takes and answers. A map is a walk
//! source: a walk runs over its entries, and one that keeps its shape answers a map.
use @std.prelude.{Entry}

fn get<V>(m: Map<string, V>, key: string) -> V? {}
fn set<V>(mut m: Map<string, V>, key: string, value: V) {}
fn has<V>(m: Map<string, V>, key: string) -> bool {}
fn keys<V>(m: Map<string, V>) -> List<string> {}
fn values<V>(m: Map<string, V>) -> List<V> {}
fn remove<V>(mut m: Map<string, V>, key: string) -> V? {}
fn is_empty<V>(m: Map<string, V>) -> bool { m.length == 0 }
fn entries<V>(m: Map<string, V>) -> List<Entry<string, V>> { [Entry { key: k, value: v } for k, v in m] }
fn map<V, U>(m: Map<string, V>, f: fn(Entry<string, V>) -> U) -> List<U> { [f(Entry { key: k, value: v }) for k, v in m] }
fn filter<V>(m: Map<string, V>, f: fn(Entry<string, V>) -> bool) -> Map<string, V> {}
fn filter_map<V, U>(m: Map<string, V>, f: fn(Entry<string, V>) -> U?) -> List<U> {}
fn flat_map<V, U>(m: Map<string, V>, f: fn(Entry<string, V>) -> List<U>) -> List<U> { [u for k, v in m for u in f(Entry { key: k, value: v })] }
fn take<V>(m: Map<string, V>, n: int) -> Map<string, V> {}
fn drop<V>(m: Map<string, V>, n: int) -> Map<string, V> {}
fn take_while<V>(m: Map<string, V>, f: fn(Entry<string, V>) -> bool) -> Map<string, V> {}
fn drop_while<V>(m: Map<string, V>, f: fn(Entry<string, V>) -> bool) -> Map<string, V> {}
fn find<V>(m: Map<string, V>, f: fn(Entry<string, V>) -> bool) -> Entry<string, V>? {}
fn find_last<V>(m: Map<string, V>, f: fn(Entry<string, V>) -> bool) -> Entry<string, V>? {}
fn find_map<V, U>(m: Map<string, V>, f: fn(Entry<string, V>) -> U?) -> U? { m.entries().find_map(f) }
fn find_index<V>(m: Map<string, V>, f: fn(Entry<string, V>) -> bool) -> int? {}
fn any<V>(m: Map<string, V>, f: fn(Entry<string, V>) -> bool) -> bool { m.entries().any(f) }
fn all<V>(m: Map<string, V>, f: fn(Entry<string, V>) -> bool) -> bool {}
fn fold<V, A>(m: Map<string, V>, init: A, f: fn(A, Entry<string, V>) -> A) -> A {}
fn count<V>(m: Map<string, V>) -> int {}
fn min_by<V>(m: Map<string, V>, key: fn(Entry<string, V>) -> int) -> Entry<string, V>? {}
fn max_by<V>(m: Map<string, V>, key: fn(Entry<string, V>) -> int) -> Entry<string, V>? {}
