//! THE VERBS OF `Map<K, V>`, as typing reads them: each a fn whose first seat is the receiver.
//! A verb with a body is that body; an empty one is the compiler's, and says only what it takes and answers. A map is a walk
//! source: a walk runs over its entries, and one that keeps its shape answers a map.
use @std.prelude.{Entry}

fn get<K, V>(m: Map<K, V>, key: K) -> V? {}
fn set<K, V>(mut m: Map<K, V>, key: K, value: V) {}
fn has<K, V>(m: Map<K, V>, key: K) -> bool {}
fn keys<K, V>(m: Map<K, V>) -> List<K> {}
fn values<K, V>(m: Map<K, V>) -> List<V> {}
fn remove<K, V>(mut m: Map<K, V>, key: K) -> V? {}
fn is_empty<K, V>(m: Map<K, V>) -> bool { m.length == 0 }
fn entries<K, V>(m: Map<K, V>) -> List<Entry<K, V>> { [Entry { key: k, value: v } for k, v in m] }
fn map<K, V, U>(m: Map<K, V>, f: fn(Entry<K, V>) -> U) -> List<U> { [f(Entry { key: k, value: v }) for k, v in m] }
fn filter<K, V>(m: Map<K, V>, f: fn(Entry<K, V>) -> bool) -> Map<K, V> {}
fn filter_map<K, V, U>(m: Map<K, V>, f: fn(Entry<K, V>) -> U?) -> List<U> {}
fn flat_map<K, V, U>(m: Map<K, V>, f: fn(Entry<K, V>) -> List<U>) -> List<U> { [u for k, v in m for u in f(Entry { key: k, value: v })] }
fn take<K, V>(m: Map<K, V>, n: int) -> Map<K, V> {}
fn drop<K, V>(m: Map<K, V>, n: int) -> Map<K, V> {}
fn take_while<K, V>(m: Map<K, V>, f: fn(Entry<K, V>) -> bool) -> Map<K, V> {}
fn drop_while<K, V>(m: Map<K, V>, f: fn(Entry<K, V>) -> bool) -> Map<K, V> {}
fn find<K, V>(m: Map<K, V>, f: fn(Entry<K, V>) -> bool) -> Entry<K, V>? {}
fn find_last<K, V>(m: Map<K, V>, f: fn(Entry<K, V>) -> bool) -> Entry<K, V>? {}
fn find_map<K, V, U>(m: Map<K, V>, f: fn(Entry<K, V>) -> U?) -> U? { m.entries().find_map(f) }
fn find_index<K, V>(m: Map<K, V>, f: fn(Entry<K, V>) -> bool) -> int? {}
fn any<K, V>(m: Map<K, V>, f: fn(Entry<K, V>) -> bool) -> bool { m.entries().any(f) }
fn all<K, V>(m: Map<K, V>, f: fn(Entry<K, V>) -> bool) -> bool {}
fn fold<K, V, A>(m: Map<K, V>, init: A, f: fn(A, Entry<K, V>) -> A) -> A {}
fn count<K, V>(m: Map<K, V>) -> int {}
fn min_by<K, V>(m: Map<K, V>, key: fn(Entry<K, V>) -> int) -> Entry<K, V>? {}
fn max_by<K, V>(m: Map<K, V>, key: fn(Entry<K, V>) -> int) -> Entry<K, V>? {}
