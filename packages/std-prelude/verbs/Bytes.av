//! THE VERBS OF `Bytes`, as typing reads them: each a fn whose first seat is the receiver. What a
//! verb does is the compiler's; these say only what it takes and answers.

fn text(b: Bytes) -> string? {}
fn text_prefix(b: Bytes) -> string {}
fn text_lossy(b: Bytes) -> string {}
fn at(b: Bytes, at: int) -> int {}
fn slice(b: Bytes, lo: int, hi: int) -> Bytes {}
fn concat(b: Bytes, other: Bytes) -> Bytes {}
fn is_empty(b: Bytes) -> bool {}
