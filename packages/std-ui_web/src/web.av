//! `@std/ui_web` — a `Screen` is a titled View; answered from a route,
//! it is the page, printed by `@std/ui_html`, with no script.
//!
//!     server site {
//!         port: 8080
//!         get "/" { _req -> Screen { title: "Home", body: home() } }
//!     }
use @std.ui.{View}
use @std.ui_html.{page}
use @std.http.{Response, Header, Respond}

/// A titled view. Answered by a handler, it is a `text/html` page of
/// its status.
export type Screen = { title: string, body: dyn View, status: int = 200 }

impl Respond for Screen {
    fn response() -> Response { html_response(self.status, page(self.title, self.body.node())) }
}

/// A full page as a response of this status.
export fn html_response(status: int, document: string) -> Response {
    Response {
        status: status,
        headers: [Header { name: "content-type", value: "text/html; charset=utf-8" }],
        body: document.bytes(),
    }
}
