// A type made from two types, and a conversion between two of them.
use @std.convert.{From}

type Celsius = { deg: int }
type Fahrenheit = { deg: int }

impl From<int> for Celsius {
    static fn from(t: int) -> Celsius { Celsius { deg: t } }
}

impl From<bool> for Celsius {
    static fn from(boiling: bool) -> Celsius { Celsius { deg: if boiling { 100 } else { 0 } } }
}

impl From<Celsius> for Fahrenheit {
    static fn from(c: Celsius) -> Fahrenheit { Fahrenheit { deg: c.deg * 9 / 5 + 32 } }
}

"${Celsius.from(21).deg} ${Celsius.from(false).deg} ${Fahrenheit.from(Celsius.from(true)).deg}"
