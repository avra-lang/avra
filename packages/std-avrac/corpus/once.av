// proves: `once fn` — a pure fn whose answer settles for the
// process, kept by the runtime under the fn's own symbol. A string,
// a list, a map and an enum each cached; one once fn calling
// another; the answer identical on every call, and the same in both
// engines (the evaluator keeps its own table per run).
once fn tag() -> string {
    "avra"
}

once fn xs() -> List<int> {
    [1, 2, 3]
}

once fn rows() -> Map<string, int> {
    { "a": 1, "b": 2 }
}

enum Mood {
    hot
    cold
}

once fn mood() -> Mood {
    Mood.hot
}

once fn greeting() -> string {
    "${tag()} says hello"
}

fn total() -> int {
    xs().length + xs().length + (rows().get("b") ?? 0)
}

mut n = 0
mut i = 0
while i < 50 {
    n = n + xs().length
    i = i + 1
}
"${tag()} ${greeting()} ${total()} ${mood() is .hot} ${n}"
