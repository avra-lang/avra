// proves: `let x: T = v` — the binding holds what it DECLARES. The
// annotation widens a guarantee into its nullable (pair and niche
// alike), adopts absence directly, and every later read sees the
// declared type. The spec's `let x: int? = null` sentence, running.
fn greeting(b: bool) -> string? {
    if b { "hello" } else { null }
}

let plain: int = 41
let lifted: int? = 5
let absent: int? = null
let word: string? = "kept"
let hollow: string? = null
let adopted: string? = greeting(true)
"plain ${plain + 1} lifted ${lifted ?? 0} absent ${absent ?? 7} word ${word ?? "lost"} hollow ${hollow ?? "was-null"} adopted ${adopted ?? "none"}"
