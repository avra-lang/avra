//! Canonical DSL text from Grammar values — the projection that makes
//! a grammar inspectable (P7) and comparable: two grammars are
//! structurally equal exactly when their renders are equal. Renders
//! the rules only; a grammar's name is packaging, not structure.
use core.{quoted_text, joined}

/// The whole grammar, one rule per line, in rule order.
export fn render_grammar(g: Grammar) -> string {
    joined([render_rule(r) for r in g.rules], "\n")
}

fn render_rule(r: Rule) -> string {
    "${r.name} = ${render_alt(r.body)}"
}

fn render_alt(a: Alt) -> string {
    joined([render_seq(s) for s in a.branches], " | ")
}

/// Items, then annotations (expects in item order, then recover), then
/// the build — one of the orders the notation accepts.
fn render_seq(s: Seq) -> string {
    mut parts = [render_item(m) for m in s.items]
    parts = parts.concat([render_expect(m) for m in s.items if m.expect != null])
    parts = parts.concat(["@head(${m.label ?? "?"})" for m in s.items if m.head])
    parts = parts.concat(["@trailer(${m.label ?? "?"})" for m in s.items if m.trailer])
    if s.recover != null {
        parts.push("@recover(sync_to: ${quoted_text(s.recover!.sync_to)})")
    }
    if s.build != null {
        match s.build! {
            .Var(name) -> parts.push("-> ${name}"),
            .Call(name, args) -> parts.push("-> ${name}(${joined(args, ", ")})"),
            .Node(owner, variant, fixed, _) -> parts.push("-> ${owner}.${variant}${stated_payloads(fixed)}"),
        }
    }
    joined(parts, " ")
}

impl Rep {
    /// The notation's repetition suffix.
    fn suffix() -> string {
        match self {
            .One -> "",
            .Star -> "*",
            .Plus -> "+",
            .Opt -> "?",
        }
    }
}

fn render_expect(m: Item) -> string {
    "@expect(${quoted_text(m.prim.token_name() ?? "?")}, ${quoted_text(m.expect!.message)})"
}

fn render_item(m: Item) -> string {
    let repped = "${render_prim(m.prim)}${m.rep.suffix()}"
    if m.label == null { repped } else { "${m.label!}:${repped}" }
}

fn render_prim(p: Prim) -> string {
    match p {
        .Ref(target) -> target,
        .Named(term) -> term,
        .Lit(text) -> quoted_text(text),
        .Group(inner) -> "( ${render_alt(inner)} )",
    }
}

/// The payloads a node build STATES, as the notation writes them.
fn stated_payloads(fixed: List<Fixed>) -> string {
    if fixed.is_empty() { return "" }
    "(${joined(["${f.name} = ${f.text}" for f in fixed], ", ")})"
}

