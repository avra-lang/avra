//! Builders for the grammar DSL: executor captures -> Grammar values.
//! `grammar_build` is the dispatch `run_grammar` calls; each builder
//! unwraps its typed captures and constructs one node.
//!
//! `build_seq` resolves surface conveniences into structural truth:
//! each trailing `@expect(tok, msg)` attaches to the first unclaimed
//! item matching `tok` (a missing target is a parse-time error), and
//! `@recover` lands on the branch. The token named in the text never
//! reaches the value model.

use core.{all_codes, is_upper_name_cont, want, Span}

/// What grammar-DSL builders construct — one variant per node kind.
export enum GrammarNode {
    NGrammar(g: Grammar)
    NRule(r: Rule)
    NAlt(a: Alt)
    NSeq(s: Seq)
    NItem(m: Item)
    NPrim(p: Prim)
    NBuild(b: Build)
    NAnnot(an: PendingAnnot)
    NArg(a: BuildArg)
}

/// A parsed-but-unattached annotation. Exists only between a branch's
/// parse and build_seq's attachment resolution.
export enum PendingAnnot {
    AExpect(tok: string, message: string)
    ARecover(sync_to: string)
    /// `@head(label)` — the labeled item is matched with trailers closed.
    AHead(label: string)
    /// `@trailer(label)` — the labeled item never matches inside a head.
    ATrailer(label: string)
}

/// All-caps-and-underscores: the convention marking a lexer terminal
/// (`NUMBER`) apart from a rule reference (`expression`).
fn is_terminal_name(s: string) -> bool {
    !s.is_empty() && s.char_code(0) != 95 && all_codes(s, is_upper_name_cont)
}

fn ok(g: GrammarNode) -> Result<Captured<GrammarNode>, string> {
    .Ok(Captured.Node(g))
}

// ── Per-kind extractors: one nested pattern each — the payload when
// the capture is that node, null otherwise. ──

fn tok_of(v: Captured<GrammarNode>) -> Token? {
    match v {
        .Terminal(t) -> t,
        _ -> null,
    }
}

fn alt_of(v: Captured<GrammarNode>) -> Alt? {
    match v {
        .Node(.NAlt(a)) -> a,
        _ -> null,
    }
}

fn prim_of(v: Captured<GrammarNode>) -> Prim? {
    match v {
        .Node(.NPrim(p)) -> p,
        _ -> null,
    }
}

fn item_of(v: Captured<GrammarNode>) -> Item? {
    match v {
        .Node(.NItem(m)) -> m,
        _ -> null,
    }
}

fn seq_of(v: Captured<GrammarNode>) -> Seq? {
    match v {
        .Node(.NSeq(sq)) -> sq,
        _ -> null,
    }
}

fn rule_of(v: Captured<GrammarNode>) -> Rule? {
    match v {
        .Node(.NRule(r)) -> r,
        _ -> null,
    }
}

fn build_of(v: Captured<GrammarNode>) -> Build? {
    match v {
        .Node(.NBuild(b)) -> b,
        _ -> null,
    }
}

fn annot_of(v: Captured<GrammarNode>) -> PendingAnnot? {
    match v {
        .Node(.NAnnot(an)) -> an,
        _ -> null,
    }
}

/// List delivery for a repeated capture. A label repeated across a
/// scalar position and a repetition (`x ("," x)*`) can bind a scalar
/// when the repetition loops zero times — delivery normalizes it.
fn as_list(v: Captured<GrammarNode>) -> Result<List<Captured<GrammarNode>>, string> {
    let items: List<Captured<GrammarNode>> = match v {
        .Many(xs) -> xs,
        .Absent -> [],
        .Terminal(t) -> [Captured.Terminal(t)],
        .Node(g) -> [Captured.Node(g)],
    }
    .Ok(items)
}

fn as_seqs(v: Captured<GrammarNode>) -> Result<List<Seq>, string> {
    .Ok([want(seq_of(x), "a branch")? for x in as_list(v)?])
}

fn as_items(v: Captured<GrammarNode>) -> Result<List<Item>, string> {
    .Ok([want(item_of(x), "an item")? for x in as_list(v)?])
}

fn as_rules(v: Captured<GrammarNode>) -> Result<List<Rule>, string> {
    .Ok([want(rule_of(x), "a rule")? for x in as_list(v)?])
}

fn as_annots(v: Captured<GrammarNode>) -> Result<List<PendingAnnot>, string> {
    .Ok([want(annot_of(x), "an annotation")? for x in as_list(v)?])
}

/// The repetition a notation suffix names — the inverse of `Rep.suffix`.
fn rep_of_suffix(text: string) -> Rep? {
    match text {
        "*" -> Rep.Star,
        "+" -> Rep.Plus,
        "?" -> Rep.Opt,
        _ -> null,
    }
}

/// A postfix capture's repetition: absent is one, a terminal is its
/// suffix, and nothing else can stand there.
fn as_rep(v: Captured<GrammarNode>) -> Result<Rep, string> {
    match v {
        .Absent -> .Ok(Rep.One),
        .Terminal(t) -> want(rep_of_suffix(t.text), "a repetition suffix"),
        .Node(_) or .Many(_) -> .Err("expected a repetition suffix"),
    }
}

/// The builder-call argument names from a repeated NAME capture.
fn call_args(v: Captured<GrammarNode>) -> Result<List<BuildArg>, string> {
    .Ok([want(arg_of(x), "a build argument")? for x in as_list(v)?])
}

/// A branch that NAMES A NODE: its arguments state payloads the rule
/// carries in its own words, and nothing else — a captured payload
/// reaches its slot by LABEL.
fn node_build(owner: string, variant: string, written: List<BuildArg>) -> Result<Captured<GrammarNode>, string> {
    ok(GrammarNode.NBuild(Build.Node(owner, variant, [fixed_arg(a)? for a in written], null)))
}

fn fixed_arg(a: BuildArg) -> Result<Fixed, string> {
    if a.fixed == null { return .Err(capture_is_not_an_argument(a.name)) }
    .Ok(Fixed { name: a.name, text: a.fixed! })
}

fn label_arg(a: BuildArg) -> Result<string, string> {
    if a.fixed != null { return .Err(fixed_needs_a_node(a.name)) }
    .Ok(a.name)
}

/// One captured argument's text. (Never `want(...)?.text` — the
/// `?.`-after-`?` shape corrupts inside a comprehension.)
fn arg_of(v: Captured<GrammarNode>) -> BuildArg? {
    match v {
        .Node(.NArg(a)) -> a,
        _ -> null,
    }
}

// ── Voices: what a build's own words refuse. ──

/// A node build's captures reach their payloads by LABEL, so a bare
/// name in its argument list names nothing.
fn capture_is_not_an_argument(name: string) -> string {
    "`${name}` names no value here — a node build's captures reach their payloads by label, and its arguments STATE a payload (`value = true`)"
}

/// A fixed value fills a payload, and only a node build has one.
fn fixed_needs_a_node(name: string) -> string {
    "`${name} = …` states a payload, and this build calls a builder — a fixed value fills a NODE's payload (`-> Expr.BoolLit(value = true)`)"
}

/// Attach each @expect to the first unclaimed matching item; land
/// @recover on the branch. The resolution step of the surface -> value
/// collapse.
fn attach(items: List<Item>, annots: List<PendingAnnot>) -> Result<Seq, string> {
    mut out = [m for m in items]
    // LICENSED I4: dual channel: finds AND refuses a duplicate
    mut rec: Recover? = null
    for an in annots {
        match an {
            .AExpect(token, message) -> {
                let idx? = out.find_index(it.expect == null && it.prim.answers_to(token)) else {
                    return .Err("@expect names `${token}` but the branch has no matching item")
                }
                out = [if i == idx { m with { expect: Expect { message: message } } } else { m } for i, m in out]
            },
            .ARecover(sync_to) -> {
                if rec != null { return .Err("duplicate @recover on one branch") }
                rec = Recover { sync_to: sync_to }
            },
            .AHead(label) -> { out = marked_by_label(out, label, "@head", true)? },
            .ATrailer(label) -> { out = marked_by_label(out, label, "@trailer", false)? },
        }
    }
    .Ok(Seq { items: out, build: null, recover: rec })
}

/// The items with every one carrying `label` marked as a head or a
/// trailer, groups opened — a label is captured at any depth. One
/// the branch does not capture is the author's mistake, named.
fn marked_by_label(items: List<Item>, label: string, word: string, as_head: bool) -> Result<List<Item>, string> {
    if !seq(items).labels().contains(label) { return .Err("${word} names `${label}` but the branch captures no such label") }
    .Ok([marked_item(m, label, as_head) for m in items])
}

fn marked_item(m: Item, label: string, as_head: bool) -> Item {
    if m.label == label { return head_or_trailer(m, as_head) }
    match m.prim {
        .Group(inner) -> m with { prim: Prim.Group(Alt { branches: [s with { items: [marked_item(x, label, as_head) for x in s.items] } for s in inner.branches] }) },
        .Ref(_) or .Lit(_) or .Named(_) -> m,
    }
}

fn head_or_trailer(m: Item, as_head: bool) -> Item {
    if as_head { m with { head: true } } else { m with { trailer: true } }
}

/// The parsed grammar inside a run outcome, when one was built.
/// Consumers use this instead of unwrapping GrammarNode themselves.
export fn grammar_result(o: RunOutcome<GrammarNode>) -> Grammar? {
    let res? = o.result else { return null }
    match res {
        .Node(.NGrammar(gr)) -> gr,
        _ -> null,
    }
}

/// The builder dispatch for the grammar DSL itself. Grammar values
/// carry no spans, so the branch span goes unused here.
export fn grammar_build(name: string, args: List<Captured<GrammarNode>>, span: Span?) -> Result<Captured<GrammarNode>, string> {
    match name {
        "build_grammar" -> {
            let rules = as_rules(args[0])?
            if rules.is_empty() { return .Err("a grammar needs at least one rule") }
            ok(GrammarNode.NGrammar(Grammar { name: "", start: rules[0].name, rules: rules }))
        },
        "build_rule" -> {
            let rule_name = want(tok_of(args[0]), "a rule name")?
            let body = want(alt_of(args[1]), "an alternation")?
            ok(GrammarNode.NRule(Rule { name: rule_name.text, body: body }))
        },
        "build_alt" -> {
            let branches = as_seqs(args[0])?
            ok(GrammarNode.NAlt(Alt { branches: branches }))
        },
        "build_seq" -> {
            let items = as_items(args[0])?
            let annots = as_annots(args[2])?
            let sq = attach(items, annots)?
            match args[1] {
                .Absent -> ok(GrammarNode.NSeq(sq)),
                .Node(_) -> {
                    let b = want(build_of(args[1]), "a build directive")?
                    ok(GrammarNode.NSeq(sq with { build: b }))
                },
                .Terminal(_) or .Many(_) -> .Err("expected a build directive"),
            }
        },
        "build_labeled" -> {
            let inner = want(item_of(args[1]), "an item")?
            match args[0] {
                .Absent -> ok(GrammarNode.NItem(inner)),
                .Terminal(t) -> ok(GrammarNode.NItem(inner with { label: t.text })),
                .Node(_) or .Many(_) -> .Err("expected a label"),
            }
        },
        "build_postfix" -> {
            let inner = want(prim_of(args[0]), "an atom")?
            ok(GrammarNode.NItem(item(inner) with { rep: as_rep(args[1])? }))
        },
        "build_prim_name" -> {
            let t = want(tok_of(args[0]), "a name")?
            if is_terminal_name(t.text) {
                ok(GrammarNode.NPrim(named(t.text)))
            } else {
                ok(GrammarNode.NPrim(rule_ref(t.text)))
            }
        },
        "build_lit" -> {
            let t = want(tok_of(args[0]), "a quoted terminal")?
            ok(GrammarNode.NPrim(lit(t.text)))
        },
        "build_group" -> {
            let inner = want(alt_of(args[0]), "an alternation")?
            ok(GrammarNode.NPrim(Prim.Group(inner)))
        },
        "build_build" -> {
            let t = want(tok_of(args[0]), "a builder name")?
            let variant: Token? = tok_of(args[1])
            let written = call_args(args[3])?
            if variant != null { return node_build(t.text, variant!.text, written) }
            match args[2] {
                .Absent -> ok(GrammarNode.NBuild(Build.Var(t.text))),
                .Terminal(_) -> ok(GrammarNode.NBuild(Build.Call(t.text, [label_arg(a)? for a in written]))),
                .Node(_) or .Many(_) -> .Err("expected `(`"),
            }
        },
        "build_arg" -> {
            let n = want(tok_of(args[0]), "an argument name")?
            ok(GrammarNode.NArg(BuildArg { name: n.text, fixed: tok_of(args[1])?.text }))
        },
        "build_expect" -> {
            let token = want(tok_of(args[0]), "the expected token")?
            let msg = want(tok_of(args[1]), "the message")?
            ok(GrammarNode.NAnnot(PendingAnnot.AExpect(token.text, msg.text)))
        },
        "build_recover" -> {
            let target = want(tok_of(args[0]), "the sync target")?
            ok(GrammarNode.NAnnot(PendingAnnot.ARecover(target.text)))
        },
        "build_head" -> {
            let label = want(tok_of(args[0]), "the head's label")?
            ok(GrammarNode.NAnnot(PendingAnnot.AHead(label.text)))
        },
        "build_trailer" -> {
            let label = want(tok_of(args[0]), "the trailer's label")?
            ok(GrammarNode.NAnnot(PendingAnnot.ATrailer(label.text)))
        },
        _ -> .Err("unknown builder `${name}`"),
    }
}
