//! The grammar engine: runs a Grammar over tokens, producing built
//! values and structured diagnostics.
//!
//! Alternation is ordered choice with DEFERRED commitment: a branch
//! that fails past its first token is a committed break — its
//! diagnostics are real, authored `Expect` messages first, panic-mode
//! `Recover` sync second (a recovered branch is a HIT with a hole,
//! and stands immediately) — but the break itself waits: later
//! branches still try, and only when none hits does the first break
//! surface. So `f(x)` and bare `f` share a rule, keyword branches
//! survive behind NAME-headed ones, and a genuinely broken committed
//! branch still reports from inside itself. Options and repetitions
//! are SPECULATION BOUNDARIES: a committed failure inside one means
//! not-taken or loop-end, surviving only as farthest-failure
//! information.
//! The engine tracks the farthest cursor any attempt reached and every
//! terminal that would have matched there, so a failed parse reports
//! "expected A, B or C while parsing `rule`".
//!
//! State threads functionally: a match returns its new state, so
//! rolling back a speculative attempt is keeping the old one.
//! Diagnostics are structured (span, expected set, rule); prose
//! rendering is a projection.
use core.{Span, span_of, filled, flatten}

/// What a builder receives and returns. The engine never looks inside
/// `Node` — `N` belongs to whoever supplies the builders.
export enum Captured<N> {
    /// A matched terminal.
    Terminal(t: Token)
    /// Whatever a builder constructed.
    Node(n: N)
    /// Accumulated repetition captures, in source order.
    Many(items: List<Captured<N>>)
    /// An optional capture not taken, or a recovered error hole.
    Absent
}

/// The parse outcome: a result when anything was built (partial trees
/// included), plus every diagnostic from the run.
export type RunOutcome<N> = { result: Captured<N>?, diagnostics: List<Diagnostic> }

/// One capture binding in a branch's scope.
type Binding<N> = { label: string, value: Captured<N> }

/// The farthest point speculation reached: what would have matched
/// there, inside which rule.
type FarthestFailure = { cursor: int, expected: List<string>, in_rule: string }

/// How one match attempt ended: matched, missed cleanly (speculation
/// may continue), broke inside a committed branch (final for this
/// branch, but a speculation boundary may absorb it), or hit a fatal
/// defect (a builder error — grammar-authoring problems pass through
/// every boundary). The four states that exist, and no fifth.
enum MatchStatus { Hit, Miss, Broke, Fatal }

/// One match attempt's outcome.
type MatchResult<N> = {
    status: MatchStatus,
    // where the attempt ended, with the captures in scope there —
    // once a boxed state per hit and per call, now the result's own
    cursor: int,
    bindings: List<Binding<N>>,
    value: Captured<N>,
    diagnostics: List<Diagnostic>,
    farthest: FarthestFailure?,
}

/// Everything a match needs to see. `ordinals` numbers the grammar's
/// rules by name, built once per grammar — a rule IS `g.rules` at its
/// ordinal; `memo` remembers what each rule answered at each cursor
/// — a rule enters with a FRESH binding scope, so its answer
/// depends on nothing else, and speculation that revisits it reads
/// instead of re-matching.
type MatchContext<N> = {
    g: Grammar,
    tokens: List<Token>,
    ordinals: Map<string, int>,
    // what a miss on each terminal EXPECTED, as a reader sees it —
    // built once per grammar, where every miss spelled its own
    lit_expects: Map<string, List<string>>,
    kind_expects: Map<string, List<string>>,
    // one absence and one silence per run: a miss is the engine's
    // commonest outcome, and a value it shares costs nothing to hand
    // out (a consumer that changed one would copy it)
    absent: Captured<N>,
    silence: List<Diagnostic>,
    build: fn(string, List<Captured<N>>, Span?) -> Result<Captured<N>, string>,
    memo: Memo<N>,
}

/// The memo: one table of `rules x (tokens + 1) x 2` slots — a rule
/// at a cursor, capped or open — a slot holding one past the index
/// of its answer in `results` (0 is unanswered), so a rule attempt
/// costs two reads and no key is ever spelled. A struct because a
/// write reaches a place through its field.
type Memo<N> = { slots: List<int>, results: List<MatchResult<N>>, stride: int }

/// Captured.Absent with its type parameter pinned.
fn captured_absent<N>() -> Captured<N> { Captured.Absent }

/// Captured.Terminal with its type parameter pinned.
fn captured_terminal<N>(t: Token) -> Captured<N> { Captured.Terminal(t) }

/// Captured.Many with its type parameter pinned.
fn captured_many<N>(items: List<Captured<N>>) -> Captured<N> { Captured.Many(items) }

fn matched<N>(cursor: int, bindings: List<Binding<N>>, v: Captured<N>, diagnostics: List<Diagnostic>,
              farthest: FarthestFailure?) -> MatchResult<N> {
    MatchResult {
        status: MatchStatus.Hit, cursor: cursor, bindings: bindings, value: v,
        diagnostics: diagnostics, farthest: farthest,
    }
}

/// A non-hit outcome: no value was built, so only HOW it ended
/// differs. The three verbs below are the vocabulary; this is the
/// one shape behind them, and a site holding a status in hand
/// (a sub-match's, passed straight through) calls it directly.
fn ended<N>(cx: MatchContext<N>, status: MatchStatus, cursor: int, bindings: List<Binding<N>>,
            diagnostics: List<Diagnostic>, farthest: FarthestFailure?) -> MatchResult<N> {
    MatchResult {
        status: status, cursor: cursor, bindings: bindings, value: cx.absent,
        diagnostics: diagnostics, farthest: farthest,
    }
}

fn missed<N>(cx: MatchContext<N>, cursor: int, bindings: List<Binding<N>>, diagnostics: List<Diagnostic>, farthest: FarthestFailure?) -> MatchResult<N> {
    ended<N>(cx, MatchStatus.Miss, cursor, bindings, diagnostics, farthest)
}

fn broke<N>(cx: MatchContext<N>, cursor: int, bindings: List<Binding<N>>, diagnostics: List<Diagnostic>, farthest: FarthestFailure?) -> MatchResult<N> {
    ended<N>(cx, MatchStatus.Broke, cursor, bindings, diagnostics, farthest)
}

fn fatal_defect<N>(cx: MatchContext<N>, cursor: int, bindings: List<Binding<N>>, diagnostics: List<Diagnostic>,
                   farthest: FarthestFailure?) -> MatchResult<N> {
    ended<N>(cx, MatchStatus.Fatal, cursor, bindings, diagnostics, farthest)
}

/// The deeper of two farthest points; a tie unions the expected sets.
fn far_merge(a: FarthestFailure?, b: FarthestFailure?) -> FarthestFailure? {
    if a == null { return b }
    if b == null { return a }
    let fa = a!
    let fb = b!
    when {
        fa.cursor > fb.cursor -> a
        fb.cursor > fa.cursor -> b
        _ -> FarthestFailure {
            cursor: fa.cursor,
            expected: appended_expected(fa.expected, fb.expected),
            in_rule: fa.in_rule,
        }
    }
}

/// Append with copy, so a rolled-back attempt cannot have mutated a
/// list an earlier snapshot still references.
fn accumulate<N>(prev: Captured<N>, v: Captured<N>) -> Captured<N> {
    match prev {
        .Many(items) -> {
            mut xs = [x for x in items]
            xs.push(v)
            Captured.Many(xs)
        }
        .Terminal(t) -> Captured.Many([Captured.Terminal(t), v]),
        .Node(n) -> Captured.Many([Captured.Node(n), v]),
        .Absent -> Captured.Many([v]),
    }
}

/// A new scope with `label` bound: accumulating inside repetitions,
/// last-wins otherwise.
fn bind_label<N>(bindings: List<Binding<N>>, label: string, v: Captured<N>, acc: bool) -> List<Binding<N>> {
    if !bindings.any(it.label == label) {
        mut out = [b for b in bindings]
        let bound: Binding<N> = Binding { label: label, value: if acc { captured_many<N>([v]) } else { v } }
        out.push(bound)
        return out
    }
    mut out: List<Binding<N>> = []
    for b in bindings {
        if b.label == label {
            out.push(b with { value: if acc { accumulate<N>(b.value, v) } else { v } })
        } else {
            out.push(b)
        }
    }
    out
}

fn binding_for<N>(bindings: List<Binding<N>>, label: string) -> Captured<N>? {
    bindings.find(it.label == label)?.value
}

/// Skip to just past the sync target: an uppercase known terminal
/// syncs by kind, anything else by text. `END` syncs to the
/// statement's end: past the next Break, or BEFORE a `}` the
/// statement did not open — braces it consumed between its entry
/// and its failure are its own to close. Stops at Eof.
fn sync_past<N>(cx: MatchContext<N>, target: string, entry: int, from: int) -> int {
    if is_end(target) { return sync_to_end<N>(cx, entry, from) }
    let k = term_kind(target)
    mut i = from
    while cx.tokens[i].kind != TokenKind.Eof {
        let t = cx.tokens[i]
        let hit: bool = if k == null { t.lit_matches(target) } else { t.kind == k! }
        if hit { return i + 1 }
        i = i + 1
    }
    i
}

fn sync_to_end<N>(cx: MatchContext<N>, entry: int, from: int) -> int {
    mut depth = open_braces<N>(cx, entry, from)
    mut i = from
    while cx.tokens[i].kind != TokenKind.Eof {
        let t = cx.tokens[i]
        if t.kind == TokenKind.Break { return i + 1 }
        if t.lit_matches("{") { depth = depth + 1 }
        if closes_body(t) {
            if depth == 0 { return i }
            depth = depth - 1
        }
        i = i + 1
    }
    i
}

/// How many `{` the tokens in [lo, hi) leave open.
fn open_braces<N>(cx: MatchContext<N>, lo: int, hi: int) -> int {
    mut depth = 0
    for j in lo..hi {
        if cx.tokens[j].lit_matches("{") { depth = depth + 1 }
        if closes_body(cx.tokens[j]) && depth > 0 { depth = depth - 1 }
    }
    depth
}

/// The statement-end terminal.
fn is_end(term: string) -> bool {
    term == "END"
}

/// A `}` — the token a statement may end against without consuming.
fn closes_body(t: Token) -> bool {
    t.lit_matches("}")
}

/// How a terminal reads when it was expected: `END` asks for the
/// line's end.
fn expected_word(term: string) -> string {
    if is_end(term) { "BREAK" } else { term }
}

fn match_rule<N>(mut cx: MatchContext<N>, name: string, cursor: int, capped: bool) -> MatchResult<N> {
    let ordinal: int? = cx.ordinals.get(name)
    if ordinal == null { return undefined_rule<N>(cx, name, cursor) }
    let at = (ordinal! * cx.memo.stride + cursor) * 2 + if capped { 1 } else { 0 }
    let known = cx.memo.slots[at]
    if known > 0 { return cx.memo.results[known - 1] }
    let fresh = match_alt<N>(cx, name, cx.g.rules[ordinal!].body, cursor, [], false, capped)
    cx.memo.results.push(fresh)
    cx.memo.slots.set(at, cx.memo.results.length)
    fresh
}

/// A reference to no rule — a grammar-authoring defect, final.
fn undefined_rule<N>(cx: MatchContext<N>, name: string, cursor: int) -> MatchResult<N> {
    broke<N>(cx, cursor, [], [defect(name, "undefined rule `${name}`")], null)
}

/// Branches tried top to bottom; the first success wins. A committed
/// break DEFERS — later branches still try, and the first break
/// stands only when nothing hits. A wholly-uncommitted failure
/// carries the merged farthest point of every branch.
fn match_alt<N>(mut cx: MatchContext<N>, rule_name: string, a: Alt,
                cursor: int, bindings: List<Binding<N>>, acc: bool, capped: bool) -> MatchResult<N> {
    // LICENSED I4: a merge fold (far_merge), not a scan
    mut farthest: FarthestFailure? = null
    // LICENSED I4: the first break's words, held while the fold runs on
    mut fb_diags: List<Diagnostic>? = null
    for br in a.branches {
        let r = match_seq<N>(cx, rule_name, br, cursor, bindings, acc, capped)
        farthest = far_merge(farthest, r.farthest)
        if r.status == MatchStatus.Hit || r.status == MatchStatus.Fatal {
            return r with { farthest: farthest }
        }
        if r.status == MatchStatus.Broke && fb_diags == null { fb_diags = r.diagnostics }
    }
    if fb_diags == null { return missed<N>(cx, cursor, bindings, cx.silence, farthest) }
    broke<N>(cx, cursor, bindings, fb_diags!, farthest)
}

/// "expected A, B or C while parsing `rule`" from a farthest point.
fn farthest_diagnostic<N>(cx: MatchContext<N>, f: FarthestFailure) -> Diagnostic {
    let want = shown_expected(f.expected)
    Diagnostic {
        cause: Cause.Expected,
        message: "expected ${join_expected(want)} while parsing `${f.in_rule}`",
        span: cx.tokens[f.cursor].span, expected: want, in_rule: f.in_rule,
    }
}

/// The diagnostic for a failure inside a committed branch, preferring
/// the failed sub-match's own farthest point.
fn committed_failure<N>(cx: MatchContext<N>, rule_name: string, member: Item,
                        r: MatchResult<N>, cursor: int) -> Diagnostic {
    let f = r.farthest ?? FarthestFailure {
        cursor: cursor,
        expected: [describe_prim(member.prim)],
        in_rule: rule_name,
    }
    farthest_diagnostic<N>(cx, f)
}

fn match_seq<N>(mut cx: MatchContext<N>, rule_name: string, s: Seq,
                entry: int, entry_bindings: List<Binding<N>>, acc: bool, capped: bool) -> MatchResult<N> {
    mut cursor = entry
    mut bindings = entry_bindings
    mut vals: List<Captured<N>> = []
    mut diagnostics: List<Diagnostic> = []
    // LICENSED I4: a merge fold (far_merge), not a scan
    mut farthest: FarthestFailure? = null
    mut anchored = false
    // THE HEAD LAW: a trailer never matches under a cap, and a
    // delimiter the sequence consumes opens the rest of it
    mut open = !capped
    for member in s.items {
        let r = if member.trailer && !open { missed<N>(cx, cursor, bindings, cx.silence, null) } else { match_item<N>(cx, rule_name, member, cursor, bindings, acc, !open) }
        farthest = far_merge(farthest, r.farthest)
        if r.status == MatchStatus.Hit {
            diagnostics = diagnostics.concat(r.diagnostics)
            if r.cursor > cursor { anchored = true }
            if opens(member.prim) { open = true }
            cursor = r.cursor
            bindings = r.bindings
            vals.push(r.value)
        } else if r.status == MatchStatus.Broke || r.status == MatchStatus.Fatal {
            diagnostics = diagnostics.concat(r.diagnostics)
            return ended<N>(cx, r.status, cursor, bindings, diagnostics, farthest)
        } else if !anchored {
            return missed<N>(cx, entry, entry_bindings, diagnostics, farthest)
        } else if member.expect != null {
            // Committed territory: this failure is real — a hole.
            diagnostics.push(Diagnostic {
                cause: Cause.Expected,
                message: member.expect!.message,
                span: cx.tokens[cursor].span,
                expected: [describe_prim(member.prim)], in_rule: rule_name,
            })
            if member.label != null { bindings = bind_label<N>(bindings, member.label!, cx.absent, acc) }
            vals.push(cx.absent)
        } else {
            diagnostics.push(committed_failure<N>(cx, rule_name, member, r, cursor))
            if s.recover == null { return broke<N>(cx, cursor, bindings, diagnostics, farthest) }
            let c = sync_past<N>(cx, s.recover!.sync_to, entry, cursor)
            return matched<N>(c, bindings, cx.absent, diagnostics, farthest)
        }
    }
    // Build phase. The branch's consumed range is the builder's span.
    // A BUILDER'S WORDS ARE ITS CLAIM, carried whole: the words say
    // the law or the defect, `Cause` says the category, and neither
    // restates the other.
    let branch = consumed_span(cx.tokens, entry, cursor)
    match built<N>(cx, s, bindings, vals, branch) {
        .Ok(v) -> matched<N>(cursor, bindings, v, diagnostics, farthest),
        .Err(m) -> {
            diagnostics.push(Diagnostic {
                cause: Cause.Builder, message: m,
                span: branch ?? cx.tokens[cursor].span,
                expected: [], in_rule: rule_name,
            })
            fatal_defect<N>(cx, cursor, bindings, diagnostics, farthest)
        }
    }
}

/// The branch's value: its sole capture, a named binding, or the
/// builder called over its named captures.
fn built<N>(cx: MatchContext<N>, s: Seq, bindings: List<Binding<N>>,
            vals: List<Captured<N>>, branch: Span?) -> Result<Captured<N>, string> {
    // A pass-through branch carries exactly one item — the validator
    // says so where a value is needed, and an empty one would index
    // nothing, so it refuses through the builder's own channel.
    if s.build == null {
        let only: Captured<N>? = vals.first()
        if only == null { return .Err("a pass-through branch captured nothing") }
        return .Ok(only!)
    }
    match s.build! {
        .Var(name) -> .Ok(binding_for<N>(bindings, name) ?? cx.absent),
        .Call(name, args) -> cx.build(name, [binding_for<N>(bindings, a) ?? cx.absent for a in args], branch),
        .Node(owner, variant, _, slots) ->
            if slots == null { .Err(unresolved_node(owner, variant)) }
            else { cx.build(node_builder_name(owner, variant),
                            [slot_value<N>(cx, bindings, sl, branch) for sl in slots!], branch) },
    }
}

/// One payload as the builder receives it: the capture its label
/// bound, the value the rule stated, or nothing.
fn slot_value<N>(cx: MatchContext<N>, bindings: List<Binding<N>>, sl: Slot, branch: Span?) -> Captured<N> {
    match sl {
        .Label(name) -> binding_for<N>(bindings, name) ?? cx.absent,
        .Fixed(text) -> captured_terminal<N>(stated(text, branch)),
        .Empty -> cx.absent,
    }
}

/// A payload the rule stated, worn as a terminal. It spans the branch
/// that stated it: no source holds these characters.
fn stated(text: string, branch: Span?) -> Token {
    Token { kind: TokenKind.Name, text: text, span: branch ?? span_of(0, 0) }
}

/// A node build reaching the engine is a DEFECT of the assembly, not
/// of the input: the engine holds no node model, so whoever does owes
/// every `-> Owner.Variant` its resolution before a grammar runs.
fn unresolved_node(owner: string, variant: string) -> string {
    "`${owner}.${variant}` was never resolved into a builder — a node build is bound where the node model lives"
}

/// The source range tokens `[from, until)` cover; null when empty.
fn consumed_span(tokens: List<Token>, from: int, until: int) -> Span? {
    if until <= from { return null }
    tokens[from].span.cover(tokens[until - 1].span)
}

/// A delimiter that OPENS what follows it in its sequence: inside
/// parentheses, brackets or braces a head's cap no longer holds.
fn opens(p: Prim) -> bool {
    match p {
        .Lit(text) -> text == "(" || text == "[" || text == "{",
        .Ref(_) or .Named(_) or .Group(_) -> false,
    }
}

/// The result with this item's label bound, when it carries one.
fn with_label<N>(member: Item, r: MatchResult<N>, acc: bool) -> MatchResult<N> {
    if member.label == null { return r }
    r with { bindings: bind_label<N>(r.bindings, member.label!, r.value, acc || member.listed) }
}

fn match_item<N>(mut cx: MatchContext<N>, rule_name: string, member: Item,
                 cursor: int, bindings: List<Binding<N>>, acc: bool, capped: bool) -> MatchResult<N> {
    match member.rep {
        .One -> {
            let r = match_prim<N>(cx, rule_name, member, cursor, bindings, acc, capped)
            if r.status != MatchStatus.Hit { return r }
            with_label<N>(member, r, acc)
        }
        .Opt -> {
            // An option is a speculation boundary: even a committed
            // sub-failure means not-taken, surviving only in `farthest`.
            let r = match_prim<N>(cx, rule_name, member, cursor, bindings, acc, capped)
            if r.status == MatchStatus.Hit { return with_label<N>(member, r, acc) }
            if r.status == MatchStatus.Fatal { return r }
            matched<N>(cursor, bindings, cx.absent, cx.silence, r.farthest)
        }
        .Star -> match_repetition<N>(cx, rule_name, member, cursor, bindings, 0, capped),
        .Plus -> match_repetition<N>(cx, rule_name, member, cursor, bindings, 1, capped),
    }
}

/// Greedy repetition: iterations are speculative (an uncommitted
/// iteration failure ends the loop cleanly), committed failures
/// propagate, and every iteration must consume input.
fn match_repetition<N>(mut cx: MatchContext<N>, rule_name: string, member: Item,
                       entry: int, entry_bindings: List<Binding<N>>, min: int, capped: bool) -> MatchResult<N> {
    mut cursor = entry
    mut bindings = entry_bindings
    mut collected: List<Captured<N>> = []
    mut diagnostics: List<Diagnostic> = []
    // LICENSED I4: a merge fold (far_merge), not a scan
    mut farthest: FarthestFailure? = null
    mut count = 0
    mut going = true
    while going {
        let r = match_prim<N>(cx, rule_name, member, cursor, bindings, true, capped)
        farthest = far_merge(farthest, r.farthest)
        // A repetition is a speculation boundary: a failed iteration
        // (committed included) ends the loop; its story lives in `farthest`.
        if r.status == MatchStatus.Fatal {
            diagnostics = diagnostics.concat(r.diagnostics)
            return fatal_defect<N>(cx, cursor, bindings, diagnostics, farthest)
        }
        if r.status != MatchStatus.Hit {
            going = false
        } else if r.cursor == cursor {
            diagnostics.push(defect(rule_name, "repetition matched without consuming input; stopped"))
            going = false
        } else {
            diagnostics = diagnostics.concat(r.diagnostics)
            collected.push(r.value)
            bindings = if member.label != null { bind_label<N>(r.bindings, member.label!, r.value, true) } else { r.bindings }
            cursor = r.cursor
            count = count + 1
        }
    }
    if count < min { return missed<N>(cx, entry, entry_bindings, diagnostics, farthest) }
    matched<N>(cursor, bindings, captured_many<N>(collected), diagnostics, farthest)
}

fn match_prim<N>(mut cx: MatchContext<N>, rule_name: string, member: Item,
                 cursor: int, bindings: List<Binding<N>>, acc: bool, capped: bool) -> MatchResult<N> {
    match member.prim {
        .Lit(text) -> {
            let t = cx.tokens[cursor]
            if t.lit_matches(text) {
                matched<N>(cursor + 1, bindings, captured_terminal<N>(t), cx.silence, null)
            } else {
                let far = FarthestFailure { cursor: cursor, expected: cx.lit_expects.get(text) ?? lit_expected(text), in_rule: rule_name }
                missed<N>(cx, cursor, bindings, cx.silence, far)
            }
        }
        .Named(term) -> {
            let t = cx.tokens[cursor]
            let k = term_kind(term)
            if k != null && t.kind_is(k!) {
                // Eof is a position, not a token: match without consuming.
                let step = if t.kind == TokenKind.Eof { 0 } else { 1 }
                matched<N>(cursor + step, bindings, captured_terminal<N>(t), cx.silence, null)
            } else if is_end(term) && closes_body(t) {
                // A statement ends where its body closes: the `}` is
                // the body's to consume.
                matched<N>(cursor, bindings, captured_terminal<N>(t), cx.silence, null)
            } else {
                let far = FarthestFailure { cursor: cursor, expected: cx.kind_expects.get(term) ?? [expected_word(term)], in_rule: rule_name }
                missed<N>(cx, cursor, bindings, cx.silence, far)
            }
        }
        .Ref(target) -> {
            let r = match_rule<N>(cx, target, cursor, capped || member.head)
            if r.status == MatchStatus.Hit {
                matched<N>(r.cursor, bindings, r.value, r.diagnostics, r.farthest)
            } else {
                ended<N>(cx, r.status, cursor, bindings, r.diagnostics, r.farthest)
            }
        }
        .Group(inner) -> {
            // Captures inside a group escape to the branch's scope; the
            // group's own value exists only when the item is labeled.
            let r = match_alt<N>(cx, rule_name, inner, cursor, bindings, acc, capped)
            if r.status != MatchStatus.Hit { return r }
            let v = if member.label != null { r.value } else { cx.absent }
            r with { value: v }
        }
    }
}

/// The final diagnostic when the whole parse failed silently — the
/// farthest point speculation reached, or a generic failure.
fn overall_failure<N>(cx: MatchContext<N>, r: MatchResult<N>) -> Diagnostic {
    if r.farthest != null { return farthest_diagnostic<N>(cx, r.farthest!) }
    Diagnostic {
        cause: Cause.Expected, message: "cannot parse `${cx.g.start}`",
        span: cx.tokens[0].span, expected: [], in_rule: cx.g.start,
    }
}

/// A grammar READY TO RUN: its defects found once and its rules
/// indexed once. Neither belongs to a parse — a grammar's defects are
/// a property of the GRAMMAR, and the index is the same map for every
/// token stream. Paying them per FILE re-proved a fixed grammar
/// well-formed once per source file in the workspace.
export type Ready = { g: Grammar, ordinals: Map<string, int>, lit_expects: Map<string, List<string>>, kind_expects: Map<string, List<string>>, defects: List<Diagnostic> }

/// A grammar prepared: validated, numbered, its terminals' expected
/// words spelled, and answered ONCE.
export fn ready(g: Grammar) -> Ready {
    mut ordinals: Map<string, int> = {}
    for j, r in g.rules { ordinals.set(r.name, j) }
    mut lits: Map<string, List<string>> = {}
    mut kinds: Map<string, List<string>> = {}
    for p in flatten([terminals_of(r.body) for r in g.rules]) {
        match p {
            .Lit(text) -> lits.set(text, lit_expected(text)),
            .Named(term) -> kinds.set(term, [expected_word(term)]),
            .Ref(_) or .Group(_) -> nothing_noted(),
        }
    }
    Ready { g: listed_grammar(g), ordinals: ordinals, lit_expects: lits, kind_expects: kinds, defects: g.defects() }
}

/// How a literal reads when it was expected.
fn lit_expected(text: string) -> List<string> {
    ["`${text}`"]
}

/// Every terminal under an alternation, groups opened.
fn terminals_of(a: Alt) -> List<Prim> {
    flatten([terminal_prims(m.prim) for m in a.items()])
}

fn terminal_prims(p: Prim) -> List<Prim> {
    match p {
        .Lit(_) or .Named(_) -> [p],
        .Ref(_) or .Group(_) -> [],
    }
}

fn nothing_noted() {
}

/// Run `rd` over `tokens`. A defective grammar refuses to run; a failed
/// parse still reports every diagnostic gathered; a partial result
/// (error holes inside) is a result.
export fn run_grammar<N>(rd: Ready, tokens: List<Token>,
                         build: fn(string, List<Captured<N>>, Span?) -> Result<Captured<N>, string>) -> RunOutcome<N> {
    run_from<N>(rd, rd.g.start, tokens, build)
}

/// Run `rd` from the rule named `start` — a FRAGMENT parse, for a
/// spelling that is one type or one expression rather than a program.
export fn run_from<N>(rd: Ready, start: string, tokens: List<Token>,
                      build: fn(string, List<Captured<N>>, Span?) -> Result<Captured<N>, string>) -> RunOutcome<N> {
    if !rd.defects.is_empty() {
        return RunOutcome { result: null, diagnostics: rd.defects }
    }
    let g = rd.g
    let stride = tokens.length + 1
    let answers: List<MatchResult<N>> = []
    let memo: Memo<N> = Memo { slots: filled(g.rules.length * stride * 2, 0), results: answers, stride: stride }
    let silence: List<Diagnostic> = []
    mut cx: MatchContext<N> = MatchContext {
        g: g, tokens: tokens, ordinals: rd.ordinals, lit_expects: rd.lit_expects, kind_expects: rd.kind_expects,
        absent: captured_absent<N>(), silence: silence, build: build, memo: memo,
    }
    let r = match_rule<N>(cx, start, 0, false)
    mut diagnostics = [d for d in r.diagnostics]
    if r.status != MatchStatus.Hit {
        if diagnostics.is_empty() { diagnostics.push(overall_failure<N>(cx, r)) }
        return RunOutcome { result: null, diagnostics: diagnostics }
    }
    if cx.tokens[r.cursor].kind != TokenKind.Eof {
        diagnostics.push(Diagnostic {
            cause: Cause.Trailing, message: "unexpected input after `${start}`",
            span: cx.tokens[r.cursor].span, expected: [], in_rule: start,
        })
    }
    RunOutcome { result: r.value, diagnostics: diagnostics }
}
