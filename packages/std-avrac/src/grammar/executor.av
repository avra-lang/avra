//! The grammar engine: runs a Grammar over tokens, producing built
//! values and structured diagnostics.
//!
//! Alternation is speculative only until a branch matches its first
//! token — then the branch is COMMITTED: sibling branches are never
//! tried, and failures inside it are real errors, reported where they
//! happen (authored `Expect` messages first, panic-mode `Recover` sync
//! second, propagation last). Branches of one rule must therefore not
//! share a first token. Options and repetitions are SPECULATION
//! BOUNDARIES: a committed failure inside one means not-taken or
//! loop-end, surviving only as farthest-failure information.
//! The engine tracks the farthest cursor any attempt reached and every
//! terminal that would have matched there, so a failed parse reports
//! "expected A, B or C while parsing `rule`".
//!
//! State threads functionally: a match returns its new state, so
//! rolling back a speculative attempt is keeping the old one.
//! Diagnostics are structured (span, expected set, rule); prose
//! rendering is a projection.
use core.{concat, Span}

/// What a builder receives and returns. The engine never looks inside
/// `Node` — `N` belongs to whoever supplies the builders.
export enum Captured<N> {
    /// A matched terminal.
    Terminal(t: Token)
    /// Whatever a builder constructed.
    Node(n: N)
    /// Accumulated repetition captures, in source order.
    Many(items: List<Captured<N>>)
    /// An optional capture not taken, or a recovered error hole.
    Absent
}

/// The parse outcome: a result when anything was built (partial trees
/// included), plus every diagnostic from the run.
export type RunOutcome<N> = { result: Captured<N>?, diagnostics: List<Diagnostic> }

/// One capture binding in a branch's scope.
type Binding<N> = { label: string, value: Captured<N> }

/// Cursor plus capture scope; passed and returned, never mutated.
type MatchState<N> = { cursor: int, bindings: List<Binding<N>> }

/// The farthest point speculation reached: what would have matched
/// there, inside which rule.
type FarthestFailure = { cursor: int, expected: List<string>, in_rule: string }

/// How one match attempt ended: matched, missed cleanly (speculation
/// may continue), broke inside a committed branch (final for this
/// branch, but a speculation boundary may absorb it), or hit a fatal
/// defect (a builder error — grammar-authoring problems pass through
/// every boundary). The four states that exist, and no fifth.
enum MatchStatus { Hit, Miss, Broke, Fatal }

/// One match attempt's outcome.
type MatchResult<N> = { status: MatchStatus, state: MatchState<N>, value: Captured<N>, diagnostics: List<Diagnostic>, farthest: FarthestFailure? }

/// Everything a match needs to see. `rules` indexes the grammar's
/// rules by name, built once per run.
type MatchContext<N> = { g: Grammar, tokens: List<Token>, rules: Map<string, Rule>, build: fn(string, List<Captured<N>>, Span?) -> Result<Captured<N>, string> }

/// Captured.Absent with its type parameter pinned.
fn captured_absent<N>() -> Captured<N> { Captured.Absent }

/// Captured.Terminal with its type parameter pinned.
fn captured_terminal<N>(t: Token) -> Captured<N> { Captured.Terminal(t) }

/// Captured.Many with its type parameter pinned.
fn captured_many<N>(items: List<Captured<N>>) -> Captured<N> { Captured.Many(items) }

/// A state at `cursor` with `bindings` in scope.
fn state_at<N>(cursor: int, bindings: List<Binding<N>>) -> MatchState<N> {
    MatchState { cursor: cursor, bindings: bindings }
}

fn matched<N>(state: MatchState<N>, v: Captured<N>, diagnostics: List<Diagnostic>, farthest: FarthestFailure?) -> MatchResult<N> {
    MatchResult { status: MatchStatus.Hit, state: state, value: v, diagnostics: diagnostics, farthest: farthest }
}

fn missed<N>(state: MatchState<N>, diagnostics: List<Diagnostic>, farthest: FarthestFailure?) -> MatchResult<N> {
    MatchResult { status: MatchStatus.Miss, state: state, value: captured_absent<N>(), diagnostics: diagnostics, farthest: farthest }
}

fn broke<N>(state: MatchState<N>, diagnostics: List<Diagnostic>, farthest: FarthestFailure?) -> MatchResult<N> {
    MatchResult { status: MatchStatus.Broke, state: state, value: captured_absent<N>(), diagnostics: diagnostics, farthest: farthest }
}

fn fatal_defect<N>(state: MatchState<N>, diagnostics: List<Diagnostic>, farthest: FarthestFailure?) -> MatchResult<N> {
    MatchResult { status: MatchStatus.Fatal, state: state, value: captured_absent<N>(), diagnostics: diagnostics, farthest: farthest }
}

/// The deeper of two farthest points; a tie unions the expected sets.
fn far_merge(a: FarthestFailure?, b: FarthestFailure?) -> FarthestFailure? {
    match a {
        null -> b,
        let fa -> match b {
            null -> a,
            let fb -> when {
                fa.cursor > fb.cursor -> a
                fb.cursor > fa.cursor -> b
                _ -> FarthestFailure { cursor: fa.cursor, expected: union_expected(fa.expected, fb.expected), in_rule: fa.in_rule }
            },
        },
    }
}

/// Append with copy, so a rolled-back attempt cannot have mutated a
/// list an earlier snapshot still references.
fn accumulate<N>(prev: Captured<N>, v: Captured<N>) -> Captured<N> {
    match prev {
        .Many(items) -> {
            mut xs = [x for x in items]
            xs.push(v)
            Captured.Many(xs)
        }
        .Terminal(t) -> {
            let first: Captured<N> = Captured.Terminal(t)
            Captured.Many([first, v])
        }
        .Node(n) -> {
            let first: Captured<N> = Captured.Node(n)
            Captured.Many([first, v])
        }
        .Absent -> Captured.Many([v]),
    }
}

/// A new scope with `label` with_label: accumulating inside repetitions,
/// last-wins otherwise.
fn bind_label<N>(bindings: List<Binding<N>>, label: string, v: Captured<N>, acc: bool) -> List<Binding<N>> {
    mut out: List<Binding<N>> = []
    mut found = false
    for b in bindings {
        if b.label == label {
            found = true
            let nv = if acc { accumulate<N>(b.value, v) } else { v }
            let nb: Binding<N> = Binding { label: label, value: nv }
            out.push(nb)
        } else {
            out.push(b)
        }
    }
    if !found {
        mut first = v
        if acc { first = captured_many<N>([v]) }
        let nb: Binding<N> = Binding { label: label, value: first }
        out.push(nb)
    }
    out
}

fn binding_for<N>(bindings: List<Binding<N>>, label: string) -> Captured<N>? {
    for b in bindings { if b.label == label { return b.value } }
    null
}

/// Skip to just past the sync target: an uppercase known terminal
/// syncs by kind, anything else by text. Stops at Eof.
fn sync_past<N>(cx: MatchContext<N>, target: string, from: int) -> int {
    let k = term_kind(target)
    mut i = from
    while cx.tokens[i].kind != TokenKind.Eof {
        let t = cx.tokens[i]
        mut hit = false
        if k == null {
            hit = t.lit_matches(target)
        } else {
            hit = t.kind == k!
        }
        if hit { return i + 1 }
        i = i + 1
    }
    i
}

fn match_rule<N>(cx: MatchContext<N>, name: string, cursor: int) -> MatchResult<N> {
    let entry_state: MatchState<N> = state_at<N>(cursor, [])
    let found: Rule? = cx.rules.get(name)
    match found {
        null -> broke<N>(entry_state,
            [Diagnostic { message: "undefined rule `${name}`", span: null, expected: [], in_rule: name }], null),
        let rl -> match_alt<N>(cx, name, rl.body, entry_state, false),
    }
}

/// Branches tried top to bottom; the first success or committed
/// failure wins. A wholly-uncommitted failure carries the merged
/// farthest point of every branch.
fn match_alt<N>(cx: MatchContext<N>, rule_name: string, a: Alt, state: MatchState<N>, acc: bool) -> MatchResult<N> {
    mut farthest: FarthestFailure? = null
    for br in a.branches {
        let r = match_seq<N>(cx, rule_name, br, state, acc)
        farthest = far_merge(farthest, r.farthest)
        if r.status != MatchStatus.Miss { return r with { farthest: farthest } }
    }
    missed<N>(state, [], farthest)
}

/// The diagnostic for a failure inside a committed branch, preferring
/// the failed sub-match's own farthest point.
/// "expected A, B or C while parsing `rule`" from a farthest point.
fn farthest_diagnostic<N>(cx: MatchContext<N>, f: FarthestFailure) -> Diagnostic {
    Diagnostic {
        message: "expected ${join_expected(f.expected)} while parsing `${f.in_rule}`",
        span: cx.tokens[f.cursor].span, expected: f.expected, in_rule: f.in_rule,
    }
}

fn committed_failure<N>(cx: MatchContext<N>, rule_name: string, member: Item, r: MatchResult<N>, state: MatchState<N>) -> Diagnostic {
    match r.farthest {
        null -> farthest_diagnostic<N>(cx, FarthestFailure { cursor: state.cursor, expected: [describe_prim(member.prim)], in_rule: rule_name }),
        let f -> farthest_diagnostic<N>(cx, f),
    }
}

fn match_seq<N>(cx: MatchContext<N>, rule_name: string, s: Seq, entry_state: MatchState<N>, acc: bool) -> MatchResult<N> {
    mut state = entry_state
    mut vals: List<Captured<N>> = []
    mut diagnostics: List<Diagnostic> = []
    mut farthest: FarthestFailure? = null
    mut anchored = false
    for member in s.items {
        let r = match_item<N>(cx, rule_name, member, state, acc)
        farthest = far_merge(farthest, r.farthest)
        if r.status == MatchStatus.Hit {
            diagnostics = concat<Diagnostic>(diagnostics, r.diagnostics)
            if r.state.cursor > state.cursor { anchored = true }
            state = r.state
            vals.push(r.value)
            continue
        }
        if r.status == MatchStatus.Broke || r.status == MatchStatus.Fatal {
            diagnostics = concat<Diagnostic>(diagnostics, r.diagnostics)
            let out: MatchResult<N> = MatchResult { status: r.status, state: state, value: captured_absent<N>(), diagnostics: diagnostics, farthest: farthest }
            return out
        }
        if !anchored { return missed<N>(entry_state, diagnostics, farthest) }
        // Committed territory: this failure is real.
        if member.expect != null {
            diagnostics.push(Diagnostic {
                message: member.expect!.message,
                span: cx.tokens[state.cursor].span,
                expected: [describe_prim(member.prim)], in_rule: rule_name,
            })
            if member.label != null {
                state = state_at<N>(state.cursor, bind_label<N>(state.bindings, member.label!, captured_absent<N>(), acc))
            }
            vals.push(captured_absent<N>())
            continue
        }
        diagnostics.push(committed_failure<N>(cx, rule_name, member, r, state))
        match s.recover {
            null -> { return broke<N>(state, diagnostics, farthest) }
            let rec -> {
                let c = sync_past<N>(cx, rec.sync_to, state.cursor)
                return matched<N>(state_at<N>(c, state.bindings), captured_absent<N>(), diagnostics, farthest)
            }
        }
    }
    // Build phase. The branch's consumed range is the builder's span.
    let branch = consumed_span(cx.tokens, entry_state.cursor, state.cursor)
    let built: Result<Captured<N>, string> = match s.build {
        null -> built_ok<N>(vals[0]),
        let b -> match b {
            .Var(name) -> built_ok<N>(binding_for<N>(state.bindings, name) ?? captured_absent<N>()),
            .Call(name, args) -> {
                let argv: List<Captured<N>> = [binding_for<N>(state.bindings, a) ?? captured_absent<N>() for a in args]
                cx.build(name, argv, branch)
            }
        }
    }
    match built {
        .Ok(v) -> matched<N>(state, v, diagnostics, farthest),
        .Err(m) -> {
            diagnostics.push(Diagnostic { message: "builder failed: ${m}", span: branch ?? cx.tokens[state.cursor].span, expected: [], in_rule: rule_name })
            fatal_defect<N>(state, diagnostics, farthest)
        }
    }
}

/// The source range tokens `[from, until)` cover; null when empty.
fn consumed_span(tokens: List<Token>, from: int, until: int) -> Span? {
    if until <= from { return null }
    tokens[from].span.cover(tokens[until - 1].span)
}

/// A successful build result, with both Result parameters pinned.
fn built_ok<N>(v: Captured<N>) -> Result<Captured<N>, string> {
    Result.Ok(v)
}

/// The result of one prim match with this item's label with_label.
fn with_label<N>(member: Item, r: MatchResult<N>, acc: bool) -> MatchResult<N> {
    match member.label {
        null -> r,
        let l -> r with { state: state_at<N>(r.state.cursor, bind_label<N>(r.state.bindings, l, r.value, acc)) },
    }
}

fn match_item<N>(cx: MatchContext<N>, rule_name: string, member: Item, state: MatchState<N>, acc: bool) -> MatchResult<N> {
    match member.rep {
        .One -> {
            let r = match_prim<N>(cx, rule_name, member, state, acc)
            if r.status != MatchStatus.Hit { return r }
            with_label<N>(member, r, acc)
        }
        .Opt -> {
            // An option is a speculation boundary: even a committed
            // sub-failure means not-taken, surviving only in `farthest`.
            let r = match_prim<N>(cx, rule_name, member, state, acc)
            if r.status == MatchStatus.Hit { return with_label<N>(member, r, acc) }
            if r.status == MatchStatus.Fatal { return r }
            matched<N>(state, captured_absent<N>(), [], r.farthest)
        }
        .Star -> match_repetition<N>(cx, rule_name, member, state, 0),
        .Plus -> match_repetition<N>(cx, rule_name, member, state, 1),
    }
}

/// Greedy repetition: iterations are speculative (an uncommitted
/// iteration failure ends the loop cleanly), committed failures
/// propagate, and every iteration must consume input.
fn match_repetition<N>(cx: MatchContext<N>, rule_name: string, member: Item, entry_state: MatchState<N>, min: int) -> MatchResult<N> {
    mut state = entry_state
    mut collected: List<Captured<N>> = []
    mut diagnostics: List<Diagnostic> = []
    mut farthest: FarthestFailure? = null
    mut count = 0
    mut going = true
    while going {
        let r = match_prim<N>(cx, rule_name, member, state, true)
        farthest = far_merge(farthest, r.farthest)
        // A repetition is a speculation boundary: a failed iteration
        // (committed included) ends the loop; its story lives in `farthest`.
        if r.status == MatchStatus.Fatal {
            diagnostics = concat<Diagnostic>(diagnostics, r.diagnostics)
            return fatal_defect<N>(state, diagnostics, farthest)
        }
        if r.status != MatchStatus.Hit {
            going = false
            continue
        }
        if r.state.cursor == state.cursor {
            diagnostics.push(Diagnostic { message: "repetition matched without consuming input; stopped", span: null, expected: [], in_rule: rule_name })
            going = false
            continue
        }
        diagnostics = concat<Diagnostic>(diagnostics, r.diagnostics)
        collected.push(r.value)
        mut nb = r.state.bindings
        if member.label != null { nb = bind_label<N>(nb, member.label!, r.value, true) }
        state = state_at<N>(r.state.cursor, nb)
        count = count + 1
    }
    if count < min { return missed<N>(entry_state, diagnostics, farthest) }
    matched<N>(state, captured_many<N>(collected), diagnostics, farthest)
}

fn match_prim<N>(cx: MatchContext<N>, rule_name: string, member: Item, state: MatchState<N>, acc: bool) -> MatchResult<N> {
    match member.prim {
        .Lit(text) -> {
            let t = cx.tokens[state.cursor]
            if t.lit_matches(text) {
                matched<N>(state_at<N>(state.cursor + 1, state.bindings), captured_terminal<N>(t), [], null)
            } else {
                missed<N>(state, [], FarthestFailure { cursor: state.cursor, expected: ["`${text}`"], in_rule: rule_name })
            }
        }
        .Named(term) -> {
            let t = cx.tokens[state.cursor]
            let k = term_kind(term)
            if k != null && t.kind == k! {
                // Eof is a position, not a token: match without consuming.
                let step = if t.kind == TokenKind.Eof { 0 } else { 1 }
                matched<N>(state_at<N>(state.cursor + step, state.bindings), captured_terminal<N>(t), [], null)
            } else {
                missed<N>(state, [], FarthestFailure { cursor: state.cursor, expected: [term], in_rule: rule_name })
            }
        }
        .Ref(target) -> {
            let r = match_rule<N>(cx, target, state.cursor)
            if r.status == MatchStatus.Hit {
                matched<N>(state_at<N>(r.state.cursor, state.bindings), r.value, r.diagnostics, r.farthest)
            } else {
                let out: MatchResult<N> = MatchResult { status: r.status, state: state, value: captured_absent<N>(), diagnostics: r.diagnostics, farthest: r.farthest }
                out
            }
        }
        .Group(inner) -> {
            // Captures inside a group escape to the branch's scope; the
            // group's own value exists only when the item is labeled.
            let r = match_alt<N>(cx, rule_name, inner, state, acc)
            if r.status != MatchStatus.Hit { return r }
            let v = if member.label != null { r.value } else { captured_absent<N>() }
            r with { value: v }
        }
    }
}

/// The final diagnostic when the whole parse failed silently — the
/// farthest point speculation reached, or a generic failure.
fn overall_failure<N>(cx: MatchContext<N>, r: MatchResult<N>) -> Diagnostic {
    match r.farthest {
        null -> Diagnostic { message: "cannot parse `${cx.g.start}`", span: cx.tokens[0].span, expected: [], in_rule: cx.g.start },
        let f -> farthest_diagnostic<N>(cx, f),
    }
}

/// Run `g` over `tokens`. A defective grammar refuses to run; a failed
/// parse still reports every diagnostic gathered; a partial result
/// (error holes inside) is a result.
export fn run_grammar<N>(g: Grammar, tokens: List<Token>, build: fn(string, List<Captured<N>>, Span?) -> Result<Captured<N>, string>) -> RunOutcome<N> {
    let defects = g.defects()
    if defects.length > 0 {
        let refused: RunOutcome<N> = RunOutcome { result: null, diagnostics: defects }
        return refused
    }
    mut rules: Map<string, Rule> = {}
    for r in g.rules { rules.set(r.name, r) }
    let cx: MatchContext<N> = MatchContext { g: g, tokens: tokens, rules: rules, build: build }
    let r = match_rule<N>(cx, g.start, 0)
    mut diagnostics = [d for d in r.diagnostics]
    if r.status != MatchStatus.Hit {
        if diagnostics.length == 0 { diagnostics.push(overall_failure<N>(cx, r)) }
        let failed: RunOutcome<N> = RunOutcome { result: null, diagnostics: diagnostics }
        return failed
    }
    if cx.tokens[r.state.cursor].kind != TokenKind.Eof {
        diagnostics.push(Diagnostic { message: "unexpected input after `${g.start}`", span: cx.tokens[r.state.cursor].span, expected: [], in_rule: g.start })
    }
    RunOutcome { result: r.value, diagnostics: diagnostics }
}
