// The grammar-of-grammars must be defect-free, and validate_grammar
// must actually catch each defect class.
use @std.avrac.grammar.{Grammar, Build, grammar_of_grammars, rule_def, seq, seq_to, item, cap, rule_ref, lit, named}

spec "grammar/seed" {
    given "the grammar-of-grammars" {
        then "the start rule is grammar" {
            grammar_of_grammars.start == "grammar"
        }
        then "all ten notation rules are present" {
            grammar_of_grammars.rules.length == 10
        }
        then "it has zero coherence defects" {
            grammar_of_grammars.defects().is_empty()
        }
    }
    given "deliberately broken grammars" {
        then "a dangling rule reference is a defect" {
            let g = Grammar { name: "t", start: "a", rules: [
                rule_def("a", [seq([item(rule_ref("ghost"))])]),
            ] }
            g.defects().length == 1
        }
        then "an unknown terminal is a defect" {
            let g = Grammar { name: "t", start: "a", rules: [
                rule_def("a", [seq([item(named("FLOAT"))])]),
            ] }
            g.defects().length == 1
        }
        then "a multi-item branch without a build is a defect" {
            let g = Grammar { name: "t", start: "a", rules: [
                rule_def("a", [seq([item(lit("x")), item(lit("y"))])]),
            ] }
            g.defects().length == 1
        }
        then "an uncaptured build argument is a defect" {
            let g = Grammar { name: "t", start: "a", rules: [
                rule_def("a", [seq_to([cap("x", named("NAME"))], Build.Call("mk", ["x", "ghost"]))]),
            ] }
            g.defects().length == 1
        }
        then "an undefined start rule is a defect" {
            let g = Grammar { name: "t", start: "missing", rules: [
                rule_def("a", [seq([item(named("NAME"))])]),
            ] }
            g.defects().length == 1
        }
    }
}
