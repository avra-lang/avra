// proves: continuation lines, brackets spanning lines, a bare return,
// a block arm, and if-chains as statements and values — natively
enum K {
    A
    B
}
fn total(a: int, b: int) -> int {
    a + b
}
fn sign(n: int) -> int {
    mut s = 0
    if n > 0 {
        s = 1
    } else if n < 0 {
        s = -1
    }
    s
}
fn grade(n: int) -> string {
    if n > 90 {
        "a"
    } else {
        if n > 80 {
            "b"
        } else {
            "c"
        }
    }
}
fn poke(n: int) {
    if n > 0 { return }
    let m = n
}
let xs = [
    1,
    2,
    3,
]
poke(1)
let chained = [3, 1, 2].length
let branchy = if chained > 5 {
    1
} else {
    2
}
let picked = match K.B {
    .A -> {
        let x = 1
        x
    },
    .B -> 20,
}
total(1, 2) + xs.length + sign(-7) + picked + grade(85).length + grade(95).length + chained + branchy
