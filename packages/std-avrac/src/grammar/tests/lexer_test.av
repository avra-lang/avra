use @std.avrac.core.{Span}
use @std.avrac.grammar.{lex_grammar, Tok, TokKind, LexResult}

/// One line-structure fixture: a source and its Break count.
type BreakCase = { src: string, breaks: int }

fn kinds_of(r: LexResult) -> List<TokKind> {
    [t.kind for t in r.toks]
}

fn count_breaks(r: LexResult) -> int {
    [t for t in r.toks if t.kind == TokKind.Break].length
}

fn op_texts(r: LexResult) -> List<string> {
    [t.text for t in r.toks if t.kind == TokKind.Op]
}

spec "grammar/lexer" {
    given "a one-line rule" {
        then "kinds, texts, and spans are exact" {
            let r = lex_grammar("term = NUMBER")
            let t0 = r.toks[0]
            let t2 = r.toks[2]
            r.toks.length == 5 &&
                t0.kind == TokKind.Name && t0.text == "term" && t0.span.lo == 0 && t0.span.hi == 4 &&
                r.toks[1].text == "=" &&
                t2.text == "NUMBER" && t2.span.lo == 7 && t2.span.hi == 13 &&
                r.toks[3].kind == TokKind.Break && r.toks[4].kind == TokKind.Eof
        }
        then "a final Break is guaranteed without a trailing newline" {
            let r = lex_grammar("a = b")
            r.toks[r.toks.length - 2].kind == TokKind.Break
        }
    }
    given "operators" {
        then "-> munches maximally" {
            let r = lex_grammar("x = a -> f")
            let ops = op_texts(r)
            ops.length == 2 && ops[1] == "->"
        }
        then "a bare - is an error and lexing continues" {
            let r = lex_grammar("x = -")
            r.errors.length == 1 && r.toks[r.toks.length - 1].kind == TokKind.Eof
        }
        then "@expect lexes as one token" {
            let r = lex_grammar("x = y @expect(\")\", \"msg\")")
            let ops = op_texts(r)
            ops[1] == "@expect"
        }
    }
    given "strings" {
        then "text is unquoted" {
            let r = lex_grammar("x = \"+\"")
            let s = r.toks[2]
            s.kind == TokKind.Str && s.text == "+" && s.span.lo == 4 && s.span.hi == 7
        }
        then "escaped quote and backslash unescape" {
            let r = lex_grammar("x = \"\\\"\" y = \"\\\\\"")
            r.toks[2].text == "\"" && r.toks[5].text == "\\"
        }
        then "an unterminated string reports and lexing continues" {
            let r = lex_grammar("a = \"oops\nb = c")
            let names = [t.text for t in r.toks if t.kind == TokKind.Name]
            r.errors.length == 1 && names.length == 3 && names[1] == "b"
        }
    }
    given "line structure" {
        then "a Break appears exactly at rule boundaries" {
            let cases: List<BreakCase> = table {
                src                       | breaks
                "a = b\n   | c\nd = e"    | 2
                "a = b\n\n\nc = d"        | 2
                "\na = b"                 | 1
                "a = b\n    c\nd = e"     | 2
                "a = b -> f\nc = d"       | 2
            }
            cases.filter((c: BreakCase) -> count_breaks(lex_grammar(c.src)) != c.breaks).length == 0
        }
        then "a leading newline is not a Break" {
            let r = lex_grammar("\na = b")
            r.toks[0].kind == TokKind.Name
        }
    }
}
