use @std.avrac.grammar.{lex_grammar, lex_source, TokenKind, LexResult}

/// One line-structure fixture: a source and its Break count.
type BreakCase = { src: string, breaks: int }

fn count_breaks(r: LexResult) -> int {
    [t for t in r.tokens if t.kind == TokenKind.Break].length
}

fn op_texts(r: LexResult) -> List<string> {
    [t.text for t in r.tokens if t.kind == TokenKind.Op]
}

spec "grammar/lexer" {
    given "a one-line rule" {
        then "kinds, texts, and spans are exact" {
            let r = lex_grammar("term = NUMBER")
            let t0 = r.tokens[0]
            let t2 = r.tokens[2]
            r.tokens.length == 5 &&
                t0.kind == TokenKind.Name && t0.text == "term" && t0.span.lo == 0 && t0.span.hi == 4 &&
                r.tokens[1].text == "=" &&
                t2.text == "NUMBER" && t2.span.lo == 7 && t2.span.hi == 13 &&
                r.tokens[3].kind == TokenKind.Break && r.tokens[4].kind == TokenKind.Eof
        }
        then "a final Break is guaranteed without a trailing newline" {
            let r = lex_grammar("a = b")
            r.tokens[r.tokens.length - 2].kind == TokenKind.Break
        }
    }
    given "operators" {
        then "-> munches maximally" {
            let r = lex_grammar("x = a -> f")
            let ops = op_texts(r)
            ops.length == 2 && ops[1] == "->"
        }
        then "a bare - is an Op once -> fails to munch" {
            let r = lex_grammar("x = - y -> z")
            r.tokens[2].text == "-" && r.tokens[4].text == "->"
        }
        then ".. munches as one Op; a lone . is the property dot" {
            let r = lex_grammar("x = a .. b")
            let lone = lex_grammar("x = .")
            op_texts(r)[1] == ".." && op_texts(lone)[1] == "." && lone.errors.is_empty()
        }
        then "a stray character is an error and lexing continues" {
            let r = lex_grammar("x = $")
            r.errors.length == 1 && r.tokens.last()!.kind == TokenKind.Eof
        }
        then "@expect lexes as one token" {
            let r = lex_grammar("x = y @expect(\")\", \"msg\")")
            let ops = op_texts(r)
            ops[1] == "@expect"
        }
    }
    given "numbers" {
        then "a digit run is one Num token with exact span" {
            let r = lex_grammar("x = 42 7")
            let n = r.tokens[2]
            n.kind == TokenKind.Num && n.text == "42" && n.span.lo == 4 && n.span.hi == 6 &&
                r.tokens[3].kind == TokenKind.Num
        }
        then "digits then letters lex as Num then Name" {
            let r = lex_grammar("x = 1abc")
            r.tokens[2].kind == TokenKind.Num && r.tokens[2].text == "1" &&
                r.tokens[3].kind == TokenKind.Name && r.tokens[3].text == "abc"
        }
    }
    given "strings" {
        then "text is unquoted" {
            let r = lex_grammar("x = \"+\"")
            let s = r.tokens[2]
            s.kind == TokenKind.Str && s.text == "+" && s.span.lo == 4 && s.span.hi == 7
        }
        then "escaped quote and backslash unescape" {
            let r = lex_grammar("x = \"\\\"\" y = \"\\\\\"")
            r.tokens[2].text == "\"" && r.tokens[5].text == "\\"
        }
        then "an unterminated string reports and lexing continues" {
            let r = lex_grammar("a = \"oops\nb = c")
            let names = [t.text for t in r.tokens if t.kind == TokenKind.Name]
            r.errors.length == 1 && names.length == 3 && names[1] == "b"
        }
    }
    given "line structure" {
        then "a Break appears exactly at rule boundaries" {
            let cases = table<BreakCase> {
                src                       | breaks
                "a = b\n   | c\nd = e"    | 2
                "a = b\n\n\nc = d"        | 2
                "\na = b"                 | 1
                "a = b\n    c\nd = e"     | 2
                "a = b -> f\nc = d"       | 2
            }
            cases.all(count_breaks(lex_grammar(it.src)) == it.breaks)
        }
        then "a leading newline is not a Break" {
            let r = lex_grammar("\na = b")
            r.tokens[0].kind == TokenKind.Name
        }
    }
    given "comments" {
        then "`//` to end of line is whitespace in both lexers" {
            let src = lex_source("a // trailing words\nb")
            let dsl = lex_grammar("a = b // trailing\nc = d")
            let names = [t.text for t in src.tokens if t.kind == TokenKind.Name]
            names.length == 2 && names[1] == "b" && count_breaks(dsl) == 2 &&
                op_texts(dsl).length == 2
        }
        then "a comment-only line is a blank line" {
            count_breaks(lex_source("a\n// note\nb")) == 2
        }
        then "a comment at end of input needs no newline" {
            let r = lex_source("a // last")
            let names = [t.text for t in r.tokens if t.kind == TokenKind.Name]
            names.length == 1 && r.errors.is_empty()
        }
        then "a lone `/` is division; `//` stays a comment" {
            let div = lex_source("a / b")
            let ops = [t.text for t in div.tokens if t.kind == TokenKind.Op]
            ops.length == 1 && ops[0] == "/" && div.errors.is_empty()
        }
    }
    given "interpolation pieces" {
        then "a holed string lexes as begin, hole tokens, end" {
            let r = lex_source("\"a $" + "{x} b\"")
            r.errors.is_empty() && r.tokens[0].kind == TokenKind.IStrBegin &&
                r.tokens[0].text == "a " && r.tokens[1].kind == TokenKind.Name &&
                r.tokens[2].kind == TokenKind.IStrEnd && r.tokens[2].text == " b"
        }
        then "two holes meet at a mid piece; braces nest by depth" {
            let r = lex_source("\"$" + "{if a { 1 } else { 2 }}-$" + "{y}\"")
            let kinds = [t for t in r.tokens if t.kind == TokenKind.IStrBegin ||
                t.kind == TokenKind.IStrMid || t.kind == TokenKind.IStrEnd]
            r.errors.is_empty() && kinds.length == 3 && kinds[1].text == "-"
        }
        then "an escaped dollar never opens a hole" {
            let r = lex_source("\"a \\$" + "{x}\"")
            r.tokens[0].kind == TokenKind.Str && r.tokens[0].text == "a $" + "{x}"
        }
        then "the grammar DSL never interpolates" {
            let r = lex_grammar("x = \"$\"")
            r.errors.is_empty() && r.tokens[2].kind == TokenKind.Str
        }
        then "a string nested inside a hole opens its own holes" {
            let r = lex_source("\"$" + "{f(\"$" + "{y}\")}\"")
            r.errors.is_empty() &&
                [t for t in r.tokens if t.kind == TokenKind.IStrBegin].length == 2
        }
        then "an unclosed hole says which brace is missing, once" {
            let r = lex_source("\"a $" + "{x\n1")
            r.errors.length == 1 &&
                r.errors[0].message == "an interpolation hole is missing its `}`"
        }
        then "an unclosed hole at end of input is the same complaint" {
            let r = lex_source("\"a $" + "{x")
            r.errors.length == 1 &&
                r.errors[0].message == "an interpolation hole is missing its `}`"
        }
    }
    given "language source line structure" {
        then "every line break separates; runs collapse; leading drops" {
            let cases = table<BreakCase> {
                src               | breaks
                "a\nb"            | 2
                "a\n\n\nb"        | 2
                "\na"             | 1
                ""                | 0
            }
            cases.all(count_breaks(lex_source(it.src)) == it.breaks)
        }
        then "the last statement ends in a Break without a trailing newline" {
            let r = lex_source("a")
            r.tokens[1].kind == TokenKind.Break && r.tokens[2].kind == TokenKind.Eof
        }
    }
}
