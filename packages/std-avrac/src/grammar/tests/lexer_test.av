use @std.avrac.grammar.{
    lex_grammar,
    lex_source,
    lex_blocks,
    byte_string_octets,
    TokenKind,
    LexResult,
}

/// One line-structure fixture: a source and its Break count.
type BreakCase = { src: string, breaks: int }

fn count_breaks(r: LexResult) -> int {
    [t for t in r.tokens if t.kind == TokenKind.Break].length
}

fn op_texts(r: LexResult) -> List<string> {
    [t.text for t in r.tokens if t.kind == TokenKind.Op]
}

/// The texts lexed as a component's word, joined, under one word the
/// file's own module declares.
fn own_opened(src: string) -> string {
    [t.text for t in lex_blocks(src, [], [], ["thing"], ["let", "fn", "for", "in", "is"]).tokens if t.kind == TokenKind.Component]
        .join(",")
}

spec "grammar/lexer" {
    given "a one-line rule" {
        then "kinds, texts, and spans are exact" {
            let r = lex_grammar("term = NUMBER")
            let t0 = r.tokens[0]
            let t2 = r.tokens[2]
            r.tokens.length == 5 &&
                t0.kind == TokenKind.Name &&
                t0.text == "term" &&
                t0.span.lo == 0 &&
                t0.span.hi == 4 &&
                r.tokens[1].text == "=" &&
                t2.text == "NUMBER" &&
                t2.span.lo == 7 &&
                t2.span.hi == 13 &&
                r.tokens[3].kind == TokenKind.Break &&
                r.tokens[4].kind == TokenKind.Eof
        }
        then "a final Break is guaranteed without a trailing newline" {
            let r = lex_grammar("a = b")
            r.tokens[r.tokens.length - 2].kind == TokenKind.Break
        }
    }
    given "operators" {
        then "-> munches maximally" {
            let r = lex_grammar("x = a -> f")
            let ops = op_texts(r)
            ops.length == 2 && ops[1] == "->"
        }
        then "a bare - is an Op once -> fails to munch" {
            let r = lex_grammar("x = - y -> z")
            r.tokens[2].text == "-" && r.tokens[4].text == "->"
        }
        then ".. munches as one Op; a lone . is the property dot" {
            let r = lex_grammar("x = a .. b")
            let lone = lex_grammar("x = .")
            op_texts(r)[1] == ".." && op_texts(lone)[1] == "." && lone.errors.is_empty()
        }
        then "a stray character is an error and lexing continues" {
            let r = lex_grammar("x = \$")
            r.errors.length == 1 && r.tokens.last()!.kind == TokenKind.Eof
        }
        then "@expect lexes as one PKG token — the `@name` class" {
            let r = lex_grammar("x = y @expect(\")\", \"msg\")")
            r.tokens[3].kind == TokenKind.Pkg && r.tokens[3].text == "@expect"
        }
    }
    given "numbers" {
        then "a digit run is one Num token with exact span" {
            let r = lex_grammar("x = 42 7")
            let n = r.tokens[2]
            n.kind == TokenKind.Num &&
                n.text == "42" &&
                n.span.lo == 4 &&
                n.span.hi == 6 &&
                r.tokens[3].kind == TokenKind.Num
        }
        then "digits then letters lex as Num then Name" {
            let r = lex_grammar("x = 1abc")
            r.tokens[2].kind == TokenKind.Num &&
                r.tokens[2].text == "1" &&
                r.tokens[3].kind == TokenKind.Name &&
                r.tokens[3].text == "abc"
        }
    }
    given "strings" {
        then "text is unquoted" {
            let r = lex_grammar("x = \"+\"")
            let s = r.tokens[2]
            s.kind == TokenKind.Str && s.text == "+" && s.span.lo == 4 && s.span.hi == 7
        }
        then "escaped quote and backslash unescape" {
            let r = lex_grammar("x = \"\\\"\" y = \"\\\\\"")
            r.tokens[2].text == "\"" && r.tokens[5].text == "\\"
        }
        then "an unterminated string reports and lexing continues" {
            let r = lex_grammar("a = \"oops\nb = c")
            let names = [t.text for t in r.tokens if t.kind == TokenKind.Name]
            r.errors.length == 1 && names.length == 3 && names[1] == "b"
        }
    }
    given "line structure" {
        then "a Break appears exactly at rule boundaries" {
            let cases = table<BreakCase> {
                src                    | breaks
                "a = b\n   | c\nd = e" | 2
                "a = b\n\n\nc = d"     | 2
                "\na = b"              | 1
                "a = b\n    c\nd = e"  | 2
                "a = b -> f\nc = d"    | 2
            }
            cases.all(count_breaks(lex_grammar(it.src)) == it.breaks)
        }
        then "a leading newline is not a Break" {
            let r = lex_grammar("\na = b")
            r.tokens[0].kind == TokenKind.Name
        }
    }
    given "comments" {
        then "`//` to end of line is whitespace in both lexers" {
            let src = lex_source("a // trailing words\nb")
            let dsl = lex_grammar("a = b // trailing\nc = d")
            let names = [t.text for t in src.tokens if t.kind == TokenKind.Name]
            names.length == 2 &&
                names[1] == "b" &&
                count_breaks(dsl) == 2 &&
                op_texts(dsl).length == 2
        }
        then "a comment-only line is a blank line" {
            count_breaks(lex_source("a\n// note\nb")) == 2
        }
        then "the LENGTH of a leading comment changes no layout" {
            // `line_indent` seeded from `raw[0].span.lo` read a byte
            // OFFSET as a column: with a leading comment `raw[0]` is
            // that line's Break, whose offset is the comment's
            // length, so a continuation flipped between a 3- and a
            // 4-character comment. Every prefix answers alike.
            let body = "x = f()\n    .g()"
            let alone = count_breaks(lex_source(body))
            [count_breaks(lex_source("${p}\n${body}")) for p in ["//", "//a", "//ab", "// leading", "/// doc", "//! header"]]
                .all(it == alone)
        }
        then "a comment at end of input needs no newline" {
            let r = lex_source("a // last")
            let names = [t.text for t in r.tokens if t.kind == TokenKind.Name]
            names.length == 1 && r.errors.is_empty()
        }
        then "a lone `/` is division; `//` stays a comment" {
            let div = lex_source("a / b")
            let ops = [t.text for t in div.tokens if t.kind == TokenKind.Op]
            ops.length == 1 && ops[0] == "/" && div.errors.is_empty()
        }
        then "contiguous declaration-leading `///` lines are retained as one group" {
            let r = lex_source(
                "/// First line.\n/// Second line.\nexport fn answer() -> int { 42 }",
            )
            r.docs.length == 1 &&
                r.docs[0].lines.join("\n") == "First line.\nSecond line." &&
                r.docs[0].before == 33
        }
        then "an empty `///` line is a line of the group" {
            let r = lex_source("///\n/// a\nfn a() -> int { 1 }")
            r.docs.length == 1 &&
                r.docs[0].lines.length == 2 &&
                r.docs[0].lines[0].is_empty() &&
                r.docs[0].lines[1] == "a"
        }
        then "an ordinary comment inside a doc group does not detach it" {
            let r = lex_source("/// kept\n// note\nfn a() {}")
            r.docs.length == 1 && r.docs[0].lines.join("\n") == "kept"
        }
        then "a blank line, a module doc alone, or a trailing doc cannot become a doc group" {
            let blank = lex_source("/// orphan\n\nfn a() {}")
            let module = lex_source("//! module\nfn a() {}")
            let trailing = lex_source("let x = 1 /// trailing\nfn a() {}")
            blank.docs.is_empty() && module.docs.is_empty() && trailing.docs.is_empty()
        }
        then "an orphan before a closing brace cannot attach across the scope" {
            lex_source("fn a() {\n    /// orphan\n}\nfn b() {}").docs.is_empty()
        }
    }
    given "interpolation pieces" {
        then "a holed string lexes as begin, hole tokens, end" {
            let r = lex_source("\"a \${x} b\"")
            r.errors.is_empty() &&
                r.tokens[0].kind == TokenKind.IStrBegin &&
                r.tokens[0].text == "a " &&
                r.tokens[1].kind == TokenKind.Name &&
                r.tokens[2].kind == TokenKind.IStrEnd &&
                r.tokens[2].text == " b"
        }
        then "two holes meet at a mid piece; braces nest by depth" {
            let r = lex_source("\"\${if a { 1 } else { 2 }}-\${y}\"")
            let kinds = [t for t in r.tokens if t.kind == TokenKind.IStrBegin ||
                t.kind == TokenKind.IStrMid ||
                t.kind == TokenKind.IStrEnd]
            r.errors.is_empty() && kinds.length == 3 && kinds[1].text == "-"
        }
        then "an escaped dollar never opens a hole" {
            let r = lex_source("\"a \\\${x}\"")
            r.tokens[0].kind == TokenKind.Str && r.tokens[0].text == "a \${x}"
        }
        then "the grammar DSL never interpolates" {
            let r = lex_grammar("x = \"\$\"")
            r.errors.is_empty() && r.tokens[2].kind == TokenKind.Str
        }
        then "a string nested inside a hole opens its own holes" {
            let r = lex_source("\"\${f(\"\${y}\")}\"")
            r.errors.is_empty() &&
                [t for t in r.tokens if t.kind == TokenKind.IStrBegin].length == 2
        }
        then "an unclosed hole says which brace is missing, once" {
            let r = lex_source("\"a \${x\n1")
            r.errors.length == 1 &&
                r.errors[0].message == "an interpolation hole is missing its `}`"
        }
        then "an unclosed hole at end of input is the same complaint" {
            let r = lex_source("\"a \${x")
            r.errors.length == 1 &&
                r.errors[0].message == "an interpolation hole is missing its `}`"
        }
    }
    given "language source line structure" {
        then "every line break separates; runs collapse; leading drops" {
            let cases = table<BreakCase> {
                src        | breaks
                "a\nb"     | 2
                "a\n\n\nb" | 2
                "\na"      | 1
                ""         | 0
            }
            cases.all(count_breaks(lex_source(it.src)) == it.breaks)
        }
        then "the last statement ends in a Break without a trailing newline" {
            let r = lex_source("a")
            r.tokens[1].kind == TokenKind.Break && r.tokens[2].kind == TokenKind.Eof
        }
        then "a chain step after a call whose argument broke a brace continues the call's line, where the same step no deeper than that line starts a statement" {
            let continued = lex_source("f(\n    {\n        \"a\": 1,\n    },\n)\n    .g()")
            let separate = lex_source("f(\n    {\n        \"a\": 1,\n    },\n)\n.g()")
            count_breaks(continued) + 1 == count_breaks(separate)
        }
    }
    given "one depth law — a body in a hole closes" {

        then "a raw block opened inside a quote hole closes, and its hole is its own" {
            // The block's `{` is not counted against the enclosing hole,
            // and the block's `}` is the block's — the outer hole still
            // closes at ITS `}`, so the source lexes whole.
            let r = lex_blocks("quote { \${ sql { a \${1} } } }", ["sql"], [])
            let bodies = [t for t in r.tokens if t.kind == TokenKind.Body].length
            r.errors.is_empty() && bodies == 1
        }
        then "a brace inside a quote hole nests it, and the hole still closes" {
            lex_source("quote { \${ P { x: 1 } } }").errors.is_empty()
        }
        then "a hole directly in a hole is refused, once" {
            let r = lex_source("quote { \${ \${1} } }")
            r.errors.length == 1 && r.errors[0].message.contains("a hole inside a hole")
        }
        then "a raw block's closer closes it, not the hole around it" {
            let r = lex_blocks("quote { \${ sql { a }.relation } }", ["sql"], [])
            let names = [t.text for t in r.tokens if t.kind == TokenKind.Name]
            r.errors.is_empty() && names.contains("relation")
        }
    }
    given "a component its own module declares" {
        then "its word opens an instance before a name, body or none" {
            own_opened("thing add { a -> a }") == "thing" &&
                own_opened("thing add") == "thing" &&
                own_opened("export thing add { a -> a }") == "thing"
        }
        then "it opens one on a later line and in a block's body" {
            own_opened("x = y\nthing add { a -> a }") == "thing" &&
                own_opened("fn f() {\n    thing add\n}") == "thing" &&
                own_opened("fn f() { thing add }") == "thing"
        }
        then "a literal, a type, an argument and a keyword after it stay names" {
            own_opened("thing { w: 1 }") == "" &&
                own_opened("let v: thing = thing { w: 1 }") == "" &&
                own_opened("f(thing)\nthing") == "" &&
                own_opened("thing let") == ""
        }
        then "it opens one before a head value, wherever it stands" {
            own_opened("let v = thing \"x\"") == "thing" &&
                own_opened("let v = thing \"a \${b}\" { k: 1 }") == "thing" &&
                own_opened("f(thing 3)") == "thing" &&
                own_opened("[thing id for id in ids]") == "thing" &&
                own_opened("x = thing self.name") == "thing" &&
                own_opened("a +\nthing add") == "thing"
        }
        then "a keyword that is no value after it leaves it a name" {
            own_opened("for thing in things { }") == "" &&
                own_opened("[x for thing in things]") == "" &&
                own_opened("thing is .Ready") == "" &&
                own_opened("let v = thing") == ""
        }
    }
    given "a byte string" {
        then "`b` touching a quote is one token carrying the spelling" {
            let r = lex_source("b\"a\\x00\"")
            r.errors.is_empty() &&
                r.tokens[0].kind == TokenKind.Octets &&
                r.tokens[0].text == "a\\x00"
        }
        then "a name before a quote stays a name" {
            let r = lex_source("ab\"x\"")
            r.tokens[0].kind == TokenKind.Name && r.tokens[1].kind == TokenKind.Str
        }
        then "every escape decodes to its octet, and a raw byte is itself" {
            match byte_string_octets("q\\\"\\\\\\n\\t\\r\\0\\x7f\\xFFé") {
                .Ok(xs) -> xs.length == 11 &&
                    xs[0] == 113 &&
                    xs[1] == 34 &&
                    xs[2] == 92 &&
                    xs[3] == 10 &&
                    xs[4] == 9 &&
                    xs[5] == 13 &&
                    xs[6] == 0 &&
                    xs[7] == 127 &&
                    xs[8] == 255 &&
                    xs[9] == 195 &&
                    xs[10] == 169,
                .Err(_) -> false,
            }
        }
        then "the empty spelling is no octets" {
            match byte_string_octets("") { .Ok(xs) -> xs.is_empty(), .Err(_) -> false }
        }
        then "a short hex escape and an unknown one are refused, and the token still stands" {
            let short = lex_source("b\"a\\x4\"")
            let unknown = lex_source("b\"a\\q\"")
            short.errors.length == 1 &&
                short.errors[0].message.contains("two hex digits") &&
                unknown.errors.length == 1 &&
                unknown.errors[0].message.contains("spell any other octet") &&
                short.tokens[0].kind == TokenKind.Octets
        }
        then "a byte string that meets its line's end is refused once" {
            let r = lex_source("b\"abc\\\"\nx")
            r.errors.length == 1 && r.errors[0].message.contains("closes on its own line")
        }
    }
    given "an integer literal's ceiling" {

        // `v * 10 + d` past the ceiling wraps in SILENCE, and the
        // wrapped number is not the one on the page: 99999999999-
        // 999999999 answered 7766279631452241919 with no message.
        then "the largest int lexes clean" {
            lex_source("9223372036854775807").errors.is_empty()
        }
        then "one past it is refused, once" {
            let r = lex_source("9223372036854775808")
            r.errors.length == 1 && r.errors[0].message.contains("does not fit an `int`")
        }
        then "far past it is refused, once" {
            let r = lex_source("99999999999999999999")
            r.errors.length == 1 && r.errors[0].message.contains("does not fit an `int`")
        }
        then "an ordinary number is untouched" {
            lex_source("1234567890123").errors.is_empty()
        }
        then "the token still stands, so nothing cascades" {
            lex_source("9223372036854775808").tokens.length == lex_source("1").tokens.length
        }
    }
}
