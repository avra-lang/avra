// Rule merging: same-name rules from separate fragments become one
// rule with branches in first-appearance order — and the executor
// refuses an unmerged grammar, so silent shadowing is unrepresentable.
use @std.errors.{Loc}
use @std.grammar.{Grammar, Captured, run_grammar, ready}
use @std.avrac.grammar.{Token, lex_grammar, avra_known_terminals, avra_lexeme, parse_grammar}

fn composed(src: string) -> Grammar {
    parse_grammar(src).built!
}

/// Renders the build name and its argument's text.
// LICENSED style.dead_parameter: conforms to a callback signature — the CONTRACT owns
// the parameter list, not this body
fn name_build(name: string, args: List<Captured<Token, string>>, loc: Loc?) -> Result<Captured<Token, string>, string> {
    let arg = match args[0] {
        .Terminal(t) -> t.text,
        .Node(n) -> n,
        .Many(_) -> "?",
        .Absent -> "_",
    }
    let built: Captured<Token, string> = Captured.Node("${name}:${arg}")
    Result.Ok(built)
}

fn run_merged(g: Grammar, src: string) -> string {
    let o = run_grammar<Token, string>(ready(g.merged(), avra_known_terminals()), lex_grammar(src).tokens, avra_lexeme(), name_build)
    if o.result == null { return "<none>" }
    match o.result! {
        .Node(n) -> n,
        .Terminal(_) or .Many(_) -> "?",
        .Absent -> "_",
    }
}

spec "grammar/compose" {
    given "same-name rules across fragments" {
        then "they merge into one rule, branches in first-appearance order" {
            let g = composed("s = x:NAME -> f(x)\ns = v:NUMBER -> g(v)").merged()
            g.rules.length == 1 && g.rules[0].body.branches.length == 2
        }
        then "distinct rules pass through untouched" {
            let g = composed("a = NAME\nb = NUMBER").merged()
            g.rules.length == 2 && g.rules[0].name == "a" && g.rules[1].name == "b"
        }
        then "interleaved declarations keep first-appearance rule order" {
            let g = composed("a = x:NAME -> f(x)\nb = STRING\na = v:NUMBER -> g(v)").merged()
            g.rules.length == 2 && g.rules[0].name == "a" && g.rules[0].body.branches.length == 2 && g.start == "a"
        }
    }
    given "the executor over a merged alternation" {
        then "branches try in declaration order across fragments" {
            let g = composed("s = v:\"x\" BREAK -> first(v)\ns = n:NAME BREAK -> second(n)")
            run_merged(g, "x") == "first:x" && run_merged(g, "y") == "second:y"
        }
    }
    given "an unmerged grammar" {
        then "duplicate declarations are a defect naming the rule" {
            let g = composed("s = NAME\ns = NUMBER")
            let ds = g.defects(avra_known_terminals())
            ds.length == 1 && ds[0].in_rule == "s" &&
                ds[0].message == "declared more than once — merge same-name rules first"
        }
        then "the executor refuses to run it" {
            let g = composed("s = n:NAME BREAK -> only(n)\ns = NUMBER")
            let o = run_grammar<Token, string>(ready(g, avra_known_terminals()), lex_grammar("y").tokens, avra_lexeme(), name_build)
            o.result == null && o.diagnostics.length == 1
        }
    }
}
