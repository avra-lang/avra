//! Finds DEAD BRANCHES in a grammar before anything parses with it.
//!
//! The executor tries branches in order and BACKTRACKS out of a
//! branch that fails past its first token — so overlap alone is not
//! death. A branch COMMITS when its head alone decides it: once the
//! first required item matches, nothing after it can refuse. A later
//! branch is dead only when an earlier COMMITTING branch can take
//! its first token — that branch swallows the token and succeeds,
//! and the later branch is never tried. This file computes each
//! branch's first tokens and commitment, and refuses the grammar
//! when:
//!   - two branches can start with the same token and the earlier
//!     one commits (`f(x)` before bare `f` passes: the call branch
//!     needs its `(` and hands the tokens back),
//!   - a branch can match nothing and is not last (it always wins),
//!   - a keyword like `"let"` sits AFTER a committing NAME branch —
//!     NAME also matches the word `let`, so the keyword never fires.
//!     The other order (keyword first) is how keywords work,
//!   - a rule starts with itself — the parser would recurse forever.
//!
//! Rules only: this guards what feature merging builds. Alternatives
//! inside one branch's groups are written by one author in one place.
use core.{is_name_start, is_digit, distinct}

/// What a branch can begin with, and whether it can begin with
/// nothing at all.
type FirstSet = { lits: List<string>, terms: List<string>, nullable: bool }

// `firsts`: each rule's set, derived once — a rule referenced from
// forty places is walked once, not forty times
type FirstCx = { g: Grammar, visiting: List<string>, firsts: Map<string, FirstSet>, defects: List<Diagnostic> }

/// The empty first set — nothing matchable, nothing skippable.
fn no_first() -> FirstSet {
    FirstSet { lits: [], terms: [], nullable: false }
}

impl FirstCx {
    fn note(d: Diagnostic) {
        self.defects.push(d)
    }

    fn rule_first(name: string) -> FirstSet {
        let known: FirstSet? = self.firsts.get(name)
        if known != null { return known! }
        if self.visiting.contains(name) {
            self.note(defect(name, "rule is left-recursive — no first token can ever commit"))
            return no_first()
        }
        // An undefined ref is validate's defect, not a first set.
        let body: Alt? = self.g.rules.find(it.name == name)?.body
        if body == null { return no_first() }
        // LICENSED I15: one call site; a bracket earns itself at the second
        self.visiting.push(name)
        let f = self.alt_first(body!)
        let _ = self.visiting.pop()
        self.firsts.set(name, f)
        f
    }

    fn alt_first(a: Alt) -> FirstSet {
        mut out = no_first()
        for s in a.branches { out = first_union(out, self.seq_first(s)) }
        out
    }

    /// Walk items left to right: a skippable item's tokens join the
    /// set and the walk continues; the first required item ends it.
    /// All items skippable means the branch can match nothing.
    fn seq_first(s: Seq) -> FirstSet {
        mut out = no_first()
        for m in s.items {
            let f = self.prim_first(m.prim)
            out = FirstSet {
                lits: first_lits(out.lits, f.lits),
                terms: first_lits(out.terms, f.terms),
                nullable: false,
            }
            let skippable = m.rep == Rep.Opt || m.rep == Rep.Star || f.nullable
            if !skippable { return out }
        }
        out with { nullable: true }
    }

    fn prim_first(p: Prim) -> FirstSet {
        match p {
            .Lit(text) -> FirstSet { lits: [text], terms: [], nullable: false },
            .Named(term) -> FirstSet { lits: [], terms: [term], nullable: false },
            .Ref(target) -> self.rule_first(target),
            .Group(inner) -> self.alt_first(inner),
        }
    }

    /// True when the branch's head alone decides it: after its first
    /// required item, every item is skippable — nothing left can
    /// refuse, so the executor never backtracks out.
    fn commits(s: Seq) -> bool {
        mut seen_head = false
        for m in s.items {
            let f = self.prim_first(m.prim)
            let skippable = m.rep == Rep.Opt || m.rep == Rep.Star || f.nullable
            if seen_head && !skippable { return false }
            if !skippable { seen_head = true }
        }
        true
    }

    /// A COMMITTING earlier branch's start tokens against a later
    /// branch's: any shared token — or a general token before a
    /// keyword it also matches — makes the later branch dead. A
    /// non-committing earlier branch backtracks, so its overlaps are
    /// harmless.
    fn overlap_defects(rule_name: string, i: int, fi: FirstSet, j: int, fj: FirstSet) {
        for l in fj.lits {
            if fi.lits.contains(l) {
                self.note(defect(rule_name,
                    "branches ${i + 1} and ${j + 1} both begin with `${l}` — branch ${j + 1} is unreachable"))
            }
            let sub: string? = subsuming_term(l)
            if sub != null && fi.terms.contains(sub!) {
                self.note(defect(rule_name,
                    "branch ${j + 1}'s `${l}` is shadowed by branch ${i + 1}'s ${sub!} — anchor the literal branch first"))
            }
        }
        for t in fj.terms {
            if fi.terms.contains(t) {
                self.note(defect(rule_name,
                    "branches ${i + 1} and ${j + 1} both begin with ${t} — branch ${j + 1} is unreachable"))
            }
        }
    }
}

/// A FIRST set is a SET. It is built ONCE per assembly, off every
/// parse, and `overlap_defects` says one word per element — so a
/// literal reaching a branch's head twice would be refused twice.
fn first_lits(a: List<string>, b: List<string>) -> List<string> {
    distinct(a.concat(b))
}

fn first_union(a: FirstSet, b: FirstSet) -> FirstSet {
    FirstSet {
        lits: first_lits(a.lits, b.lits),
        terms: first_lits(a.terms, b.terms),
        nullable: a.nullable || b.nullable,
    }
}

/// The token class that would also match this literal's text:
/// `"let"` is also a NAME, `"42"` is also a NUMBER.
fn subsuming_term(text: string) -> string? {
    if text.is_empty() { return null }
    let c = text.char_code(0)
    when {
        is_name_start(c) -> "NAME"
        is_digit(c) -> "NUMBER"
        _ -> null
    }
}

/// Every dead branch in the grammar, each defect saying why.
export fn first_defects(g: Grammar) -> List<Diagnostic> {
    mut cx = FirstCx { g: g, visiting: [], firsts: {}, defects: [] }
    for r in g.rules {
        let firsts = [cx.seq_first(s) for s in r.body.branches]
        let commit_flags = [cx.commits(s) for s in r.body.branches]
        for i, fi in firsts {
            if fi.nullable && i < firsts.length - 1 {
                cx.note(defect(r.name,
                    "branch ${i + 1} can match empty input — every later branch is unreachable"))
            }
            for j, fj in firsts {
                if j > i && commit_flags[i] { cx.overlap_defects(r.name, i, fi, j, fj) }
            }
        }
    }
    cx.defects
}
