//! DSL text -> tokens, for `parse_grammar`. Six kinds: Name, Num,
//! Str, Op (single chars, `->`, and `@`-words), Break, Eof.
//!
//! The notation is line-structured: one rule per line. The lexer owns
//! that layout — a newline becomes a Break token only where a rule can
//! end (the next tokens are `NAME =`, or input ends); every other
//! newline is whitespace, so continuation lines (`| …`, `-> …`,
//! `@expect(…)`) need no special casing anywhere else. A final Break
//! is guaranteed before Eof.
//!
//! Lexing is error-tolerant: a bad character or unterminated string is
//! recorded and lexing continues, so one pass reports everything.
use core.{Span}
use core.{code_at, is_space, is_name_start, is_name_cont, is_digit}

/// What a token is; Lit-vs-kind matching keys off this.
export enum TokenKind { Name, Num, Str, Op, Break, Eof }

/// One DSL token. For Str, `text` is the unquoted, unescaped contents;
/// the span covers the quotes.
export type Token = { kind: TokenKind, text: string, span: Span }

impl Token {
    /// True when a grammar Lit matches this token: text equality, and
    /// never against quoted input — a Str's text is data, not syntax.
    fn lit_matches(self, text: string) -> bool {
        self.kind != TokenKind.Str && self.kind != TokenKind.Eof && self.text == text
    }

    /// The integer a Num token's digits denote.
    fn int_value(self) -> int {
        mut v = 0
        mut i = 0
        while i < self.text.length {
            v = v * 10 + (code_at(self.text, i) - 48)
            i = i + 1
        }
        v
    }
}

/// One recorded problem; lexing continued past it.
export type LexError = { message: string, span: Span }

/// Every token and every problem from one pass.
export type LexResult = { tokens: List<Token>, errors: List<LexError> }

/// Membership in the single-char operator set; `-`, `<`, `>`, `!`,
/// and `|` reach here only after their two-char munches have failed.
fn is_single_op(ch: string) -> bool { "=|()*+?:,-<>{}/%!".contains(ch) }

/// A token spanning `[lo, hi)`.
fn token(kind: TokenKind, text: string, lo: int, hi: int) -> Token {
    Token { kind: kind, text: text, span: Span { lo: lo, hi: hi } }
}

/// First index at or after `from` where `pred` stops holding.
fn scan_while(src: string, from: int, pred: fn(int) -> bool) -> int {
    mut j = from
    while j < src.length && pred(code_at(src, j)) { j = j + 1 }
    j
}

/// One scanner step: at most one token, at most one error, always
/// progress.
type ScanStep = { token: Token?, err: LexError?, next: int }

/// A step that produced a token.
fn emit(t: Token, next: int) -> ScanStep { ScanStep { token: t, err: null, next: next } }

/// A step that produced nothing (whitespace).
fn skip(next: int) -> ScanStep { ScanStep { token: null, err: null, next: next } }

/// A step that produced only an error.
fn fail(message: string, lo: int, hi: int) -> ScanStep {
    ScanStep { token: null, err: LexError { message: message, span: Span { lo: lo, hi: hi } }, next: hi }
}

/// The two escapes; anything else after `\` stays raw.
fn unescape(e: int) -> string? {
    match e {
        34 -> "\"",
        92 -> "\\",
        _ -> null,
    }
}

/// A quoted string from `i`: emits the Str token even when
/// unterminated, so the parse can keep going.
fn scan_string(src: string, i: int) -> ScanStep {
    let n = src.length
    mut j = i + 1
    mut text = ""
    mut closed = false
    while j < n {
        let c = code_at(src, j)
        if c == 34 {
            closed = true
            j = j + 1
            break
        }
        if c == 10 { break }
        if c == 92 && j + 1 < n {
            let un = unescape(code_at(src, j + 1))
            text = text + (un ?? src.substring(j, j + 2))
            j = j + 2
            continue
        }
        text = text + src.substring(j, j + 1)
        j = j + 1
    }
    let t = token(TokenKind.Str, text, i, j)
    if closed { return emit(t, j) }
    ScanStep { token: t, err: LexError { message: "unterminated string", span: Span { lo: i, hi: j } }, next: j }
}

/// First index at or after `from` that is a newline (or the end).
fn line_end(src: string, from: int) -> int {
    mut j = from
    while j < src.length && code_at(src, j) != 10 { j = j + 1 }
    j
}

/// The two-char operators, as the text itself — each munches before
/// its single-char prefix.
fn two_char_ops() -> List<string> {
    ["->", "==", "..", "!=", "<=", ">=", "&&", "||"]
}

/// The two-char operator starting at `i`, or null.
fn two_char_at(src: string, i: int) -> string? {
    if i + 1 >= src.length { return null }
    let hit: string? = two_char_ops().find(
        code_at(it, 0) == code_at(src, i) && code_at(it, 1) == code_at(src, i + 1))
    hit
}

/// One token (or skip, or error) starting at `i`.
fn scan_step(src: string, i: int) -> ScanStep {
    let n = src.length
    let c = code_at(src, i)
    let pair: string? = two_char_at(src, i)
    when {
        // Newline: raw Break, resolved to layout after the scan.
        c == 10 -> emit(token(TokenKind.Break, "", i, i + 1), i + 1)
        is_space(c) -> skip(i + 1)
        // `//` comment: whitespace to end of line — the newline
        // itself still arrives as layout.
        c == 47 && i + 1 < n && code_at(src, i + 1) == 47 -> skip(line_end(src, i))
        // Name: idents and named terminals alike.
        is_name_start(c) -> {
            let j = scan_while(src, i + 1, is_name_cont)
            emit(token(TokenKind.Name, src.substring(i, j), i, j), j)
        }
        // Number: a digit run; adjacent letters lex as their own Name.
        is_digit(c) -> {
            let j = scan_while(src, i + 1, is_digit)
            emit(token(TokenKind.Num, src.substring(i, j), i, j), j)
        }
        // String: unquote and unescape.
        c == 34 -> scan_string(src, i)
        // `@`-word: one Op token (`@expect`, `@recover`).
        c == 64 -> {
            let j = scan_while(src, i + 1, is_name_cont)
            if j == i + 1 { fail("expected a name after `@`", i, i + 1) }
            else { emit(token(TokenKind.Op, src.substring(i, j), i, j), j) }
        }
        // A two-char op munches before its single-char prefix.
        pair != null -> emit(token(TokenKind.Op, pair!, i, i + 2), i + 2)
        is_single_op(src.substring(i, i + 1)) ->
            emit(token(TokenKind.Op, src.substring(i, i + 1), i, i + 1), i + 1)
        _ -> fail("unexpected character", i, i + 1)
    }
}

/// True where a grammar rule may end: before `NAME =`, or at end of
/// input.
fn rule_boundary(tokens: List<Token>, j: int) -> bool {
    when {
        j >= tokens.length -> true
        tokens[j].kind != TokenKind.Name -> false
        j + 1 >= tokens.length -> false
        _ -> tokens[j + 1].kind == TokenKind.Op && tokens[j + 1].text == "="
    }
}

/// In language source every line break separates.
fn line_boundary(tokens: List<Token>, j: int) -> bool {
    true
}

/// Collapse each Break run to one, kept only where `boundary` allows;
/// leading breaks always drop.
fn collapse_breaks(raw: List<Token>, boundary: fn(List<Token>, int) -> bool) -> List<Token> {
    mut out: List<Token> = []
    mut i = 0
    while i < raw.length {
        let t = raw[i]
        if t.kind == TokenKind.Break {
            mut j = i + 1
            while j < raw.length && raw[j].kind == TokenKind.Break { j = j + 1 }
            if boundary(raw, j) && !out.is_empty() { out.push(t) }
            i = j
        } else {
            out.push(t)
            i = i + 1
        }
    }
    out
}

/// The whole input, one ScanStep at a time; then the line policy, a
/// final Break, and Eof.
fn lex_with(src: string, boundary: fn(List<Token>, int) -> bool) -> LexResult {
    mut raw: List<Token> = []
    mut errors: List<LexError> = []
    mut i = 0
    while i < src.length {
        let s = scan_step(src, i)
        if s.token != null { raw.push(s.token!) }
        if s.err != null { errors.push(s.err!) }
        i = s.next
    }
    mut tokens = collapse_breaks(raw, boundary)
    // Every rule or statement ends in a Break, even without a trailing
    // newline.
    let tail: Token? = tokens.last()
    if tail != null && tail!.kind != TokenKind.Break {
        tokens.push(token(TokenKind.Break, "", src.length, src.length))
    }
    tokens.push(token(TokenKind.Eof, "", src.length, src.length))
    LexResult { tokens: tokens, errors: errors }
}

/// Grammar-DSL text: a line break survives only at a rule boundary.
export fn lex_grammar(src: string) -> LexResult {
    lex_with(src, rule_boundary)
}

/// Language source: a line break survives between any two statements.
export fn lex_source(src: string) -> LexResult {
    lex_with(src, line_boundary)
}
