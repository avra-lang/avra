//! Text -> tokens, in two flavors sharing one scanner: grammar-DSL
//! (`lex_grammar` — rule-boundary layout, no interpolation) and
//! language source (`lex_source` — every newline separates, and
//! strings carry `${}` holes: IStrBegin/IStrMid/IStrEnd pieces
//! around ordinary hole tokens, a stack tracking nested holes and
//! their brace depths).
//!
//! Layout is the lexer's: a newline becomes a Break token only where
//! the flavor's boundary allows; every other newline is whitespace.
//! A final Break is guaranteed before Eof.
//!
//! Lexing is error-tolerant: a bad character, an unterminated
//! string, or an unclosed hole is recorded and lexing continues, so
//! one pass reports everything.
use @std.text.{Text, builder}
use core.{Span, span_of}
use core.{is_space, is_name_start, is_name_cont, is_digit}

/// What a token is; Lit-vs-kind matching keys off this. The IStr
/// kinds are an interpolated string's pieces: `"a ${x} b ${y} c"`
/// lexes as IStrBegin("a ") <hole> IStrMid(" b ") <hole>
/// IStrEnd(" c").
/// `Pkg` is an `@name` — a package's head in a `use` path, and the
/// grammar DSL's own `@expect`/`@recover` words.
export enum TokenKind { Name, Num, Str, IStrBegin, IStrMid, IStrEnd, Op, Break, Eof, Pkg }

/// One DSL token. For Str and the IStr kinds, `text` is the
/// unquoted, unescaped contents; the span covers the delimiters.
export type Token = { kind: TokenKind, text: string, span: Span }

impl Token {
    /// True when a grammar Lit matches this token: text equality, and
    /// never against quoted input — quoted text is data, not syntax.
    fn lit_matches(text: string) -> bool {
        match self.kind {
            .Name or .Num or .Op or .Break or .Pkg -> self.text == text,
            .Str or .IStrBegin or .IStrMid or .IStrEnd or .Eof -> false,
        }
    }

    /// The integer a Num token's digits denote.
    /// The digits as a number, or absence when no `int` holds them —
    /// `v * 10 + d` past the ceiling wraps, and the wrapped number is
    /// not the one on the page.
    fn int_value() -> int? {
        mut v = 0
        mut i = 0
        let n = self.text.length
        while i < n {
            let d = self.text.char_code(i) - 48
            if v > (9223372036854775807 - d) / 10 { return null }
            v = v * 10 + d
            i = i + 1
        }
        v
    }
}

/// One recorded problem; lexing continued past it.
export type LexError = { message: string, span: Span }

/// Every token and every problem from one pass.
export type LexResult = { tokens: List<Token>, errors: List<LexError> }

/// Membership in the single-char operator set; `-`, `<`, `>`, `!`,
/// `.`, and `|` reach here only after their two-char munches have
/// failed.
/// A single-character operator, by code — the scanner asks this of
/// every character that is not a name, a number or a space.
fn is_single_op_code(c: int) -> bool {
    c == 61 || c == 124 || c == 40 || c == 41 || c == 42 || c == 43 || c == 63 ||
    c == 58 || c == 44 || c == 45 || c == 60 || c == 62 || c == 123 || c == 125 ||
    c == 47 || c == 37 || c == 33 || c == 91 || c == 93 || c == 46
}

/// A token spanning `[lo, hi)`.
fn token(kind: TokenKind, text: string, lo: int, hi: int) -> Token {
    Token { kind: kind, text: text, span: span_of(lo, hi) }
}

/// First index at or after `from` where `pred` stops holding. The
/// length is PASSED, never re-asked: `src.length` is `strlen` in the
/// runtime, so testing it per character makes a scan quadratic.
fn scan_while(src: string, n: int, from: int, pred: fn(int) -> bool) -> int {
    mut j = from
    while j < n && pred(src.char_code(j)) { j = j + 1 }
    j
}

/// One scanner step: at most one token, at most one error, always
/// progress. `opens_hole` means the token ended at `${` and the
/// loop now lexes the hole's expression.
type ScanStep = { token: Token?, err: LexError?, opens_hole: bool, next: int }

/// A step that produced a token.
fn emit(t: Token, next: int) -> ScanStep {
    ScanStep { token: t, err: null, opens_hole: false, next: next }
}

/// A step that produced nothing (whitespace).
fn skip(next: int) -> ScanStep {
    ScanStep { token: null, err: null, opens_hole: false, next: next }
}

/// A number token — and, when the digits name a value no `int` can
/// hold, the refusal beside it. The token still stands so one bad
/// literal does not cascade; what must never stand is the WRAPPED
/// value, which is not the number on the page.
fn numbered(text: string, lo: int, hi: int) -> ScanStep {
    let t = token(TokenKind.Num, text, lo, hi)
    if t.int_value() != null { return emit(t, hi) }
    ScanStep {
        token: t, opens_hole: false,
        err: LexError { message: "`${text}` does not fit an `int`", span: span_of(lo, hi) },
        next: hi,
    }
}

/// Whether the token just emitted opens a grammar block — the
/// keyword, then the brace the block's own body may not be read
/// through.
fn opens_grammar(raw: List<Token>, just: Token?) -> bool {
    if just == null { return false }
    if just!.kind != TokenKind.Op || just!.text != "{" { return false }
    if raw.length < 2 { return false }
    let before = raw[raw.length - 2]
    before.kind == TokenKind.Name && before.text == "grammar"
}

/// THE GRAMMAR BLOCK'S BODY, taken whole: every byte to the brace
/// that closes the one already consumed. Braces inside the body's
/// own STRING literals do not count — `block`'s grammar writes `"{"`
/// as a literal, and a counter blind to quotes would end there.
fn scan_raw_block(src: string, n: int, from: int) -> ScanStep {
    mut depth = 1
    mut i = from
    mut quoted = false
    while i < n {
        let c = src.char_code(i)
        if quoted {
            if c == 92 { i = i + 1 }
            else if c == 34 { quoted = false }
        } else if c == 34 {
            quoted = true
        } else if c == 123 {
            depth = depth + 1
        } else if c == 125 {
            depth = depth - 1
            if depth == 0 {
                // the closing brace is the block's, not the program's
                return emit(token(TokenKind.Str, src.substring(from, i), from, i), i + 1)
            }
        }
        i = i + 1
    }
    refused("a `grammar` block is never closed", from, n)
}

/// A step that produced only an error.
fn refused(message: string, lo: int, hi: int) -> ScanStep {
    ScanStep {
        token: null, opens_hole: false,
        err: LexError { message: message, span: span_of(lo, hi) },
        next: hi,
    }
}

/// Three quotes open a RAW string.
fn triple_at(src: string, n: int, i: int) -> bool {
    i + 2 < n && src.char_code(i + 1) == 34 && src.char_code(i + 2) == 34
}

/// The raw text between `"""` and the next `"""` — one Str token,
/// unterminated when the file ends first.
fn scan_triple(src: string, n: int, i: int) -> ScanStep {
    mut j = i + 3
    while j + 2 < n {
        if src.char_code(j) == 34 && src.char_code(j + 1) == 34 && src.char_code(j + 2) == 34 {
            return emit(token(TokenKind.Str, src.substring(i + 3, j), i, j + 3), j + 3)
        }
        j = j + 1
    }
    ScanStep {
        token: token(TokenKind.Str, src.substring(i + 3, n), i, n), opens_hole: false,
        err: LexError { message: "unterminated string", span: span_of(i, n) },
        next: n,
    }
}

/// The three escapes; anything else after `\` stays raw. `\$` exists
/// so text can hold a literal `${`.
fn unescape(e: int) -> string? {
    match e {
        34 -> "\"",
        92 -> "\\",
        36 -> "$",
        110 -> "\n",
        116 -> "\t",
        114 -> "\r",
        _ -> null,
    }
}

/// How one string piece ended: at its closing quote, at a `${` hole,
/// or not at all.
enum StrStop { Quote, Hole, Ragged }

type StrPart = { text: string, stop: StrStop, next: int }

/// Text from `from` (already inside the quotes) to the piece's end.
/// Plain runs are copied whole into the builder; only an escape
/// breaks a run.
fn scan_str_part(src: string, from: int, interpolate: bool) -> StrPart {
    let n = src.length
    mut out = builder()
    mut run = from
    mut j = from
    while j < n {
        let c = src.char_code(j)
        if c == 34 { return StrPart { text: closed(out, src, run, j), stop: StrStop.Quote, next: j + 1 } }
        if c == 10 { return ragged(closed(out, src, run, j), j) }
        if interpolate && c == 36 && j + 1 < n && src.char_code(j + 1) == 123 {
            return StrPart { text: closed(out, src, run, j), stop: StrStop.Hole, next: j + 2 }
        }
        if c == 92 && j + 1 < n {
            out.push(src.substring(run, j))
            out.push(unescape(src.char_code(j + 1)) ?? src.substring(j, j + 2))
            j = j + 2
            run = j
        } else {
            j = j + 1
        }
    }
    ragged(closed(out, src, run, j), j)
}

/// The run since the last escape appended; the text complete.
fn closed(mut out: Text, src: string, run: int, j: int) -> string {
    out.push(src.substring(run, j))
    out.built()
}

/// A string piece the line ended before its quote did.
fn ragged(text: string, at: int) -> StrPart {
    StrPart { text: text, stop: StrStop.Ragged, next: at }
}

/// A string piece as its token: the OPENING piece is Str (no hole)
/// or IStrBegin; a CONTINUATION piece (after a hole's `}`) is
/// IStrMid or IStrEnd. `opens_hole` tells the loop to enter a hole.
fn scan_string(src: string, i: int, opening: bool, interpolate: bool) -> ScanStep {
    let from = if opening { i + 1 } else { i }
    let p = scan_str_part(src, from, interpolate)
    let kind = match p.stop {
        .Quote or .Ragged -> if opening { TokenKind.Str } else { TokenKind.IStrEnd },
        .Hole -> if opening { TokenKind.IStrBegin } else { TokenKind.IStrMid },
    }
    let t = token(kind, p.text, i, p.next)
    if p.stop is .Ragged {
        return ScanStep {
            token: t, opens_hole: false,
            err: LexError { message: "unterminated string", span: span_of(i, p.next) },
            next: p.next,
        }
    }
    ScanStep { token: t, err: null, opens_hole: p.stop is .Hole, next: p.next }
}

/// First index at or after `from` that is a newline (or the end).
fn line_end(src: string, n: int, from: int) -> int {
    mut j = from
    while j < n && src.char_code(j) != 10 { j = j + 1 }
    j
}

/// THE TWO-CHAR OPERATORS, by the CODES that spell them — each
/// munches before its single-char prefix. Read by code because this
/// is the scanner's inner loop: a list of strings here is a fresh
/// list and a substring per character of every source.
fn two_char_of(a: int, b: int) -> string? {
    when {
        a == 45 && b == 62 -> "->"
        a == 61 && b == 61 -> "=="
        a == 46 && b == 46 -> ".."
        a == 33 && b == 61 -> "!="
        a == 60 && b == 61 -> "<="
        a == 62 && b == 61 -> ">="
        a == 38 && b == 38 -> "&&"
        a == 124 && b == 124 -> "||"
        a == 63 && b == 63 -> "??"
        a == 63 && b == 46 -> "?."
        _ -> null
    }
}

/// The two-char operator starting at `i`, or null.
fn two_char_at(src: string, n: int, i: int) -> string? {
    if i + 1 >= n { return null }
    two_char_of(src.char_code(i), src.char_code(i + 1))
}

/// One token (or skip, or error) starting at `i`.
fn scan_step(src: string, n: int, i: int, interpolate: bool) -> ScanStep {
    let c = src.char_code(i)
    let pair: string? = two_char_at(src, n, i)
    when {
        // Newline: raw Break, resolved to layout after the scan.
        c == 10 -> emit(token(TokenKind.Break, "", i, i + 1), i + 1)
        is_space(c) -> skip(i + 1)
        // `//` comment: whitespace to end of line — the newline
        // itself still arrives as layout.
        c == 47 && i + 1 < n && src.char_code(i + 1) == 47 -> skip(line_end(src, n, i))
        // Name: idents and named terminals alike.
        is_name_start(c) -> {
            let j = scan_while(src, n, i + 1, is_name_cont)
            emit(token(TokenKind.Name, src.substring(i, j), i, j), j)
        }
        // Number: a digit run; adjacent letters lex as their own Name.
        is_digit(c) -> {
            let j = scan_while(src, n, i + 1, is_digit)
            numbered(src.substring(i, j), i, j)
        }
        // A RAW string: `"""` to `"""`, no escapes, no holes.
        c == 34 && triple_at(src, n, i) -> scan_triple(src, n, i)
        // String: unquote and unescape.
        c == 34 -> scan_string(src, i, true, interpolate)
        // `@`-word: one Op token (`@expect`, `@recover`).
        c == 64 -> {
            let j = scan_while(src, n, i + 1, is_name_cont)
            if j == i + 1 { refused("expected a name after `@`", i, i + 1) }
            else { emit(token(TokenKind.Pkg, src.substring(i, j), i, j), j) }
        }
        // A two-char op munches before its single-char prefix.
        pair != null -> emit(token(TokenKind.Op, pair!, i, i + 2), i + 2)
        is_single_op_code(c) ->
            emit(token(TokenKind.Op, src.substring(i, i + 1), i, i + 1), i + 1)
        _ -> refused("unexpected character", i, i + 1)
    }
}

/// True where a grammar rule may end: before `NAME =`, or at end of
/// input.
fn rule_boundary(tokens: List<Token>, j: int) -> bool {
    when {
        j >= tokens.length -> true
        tokens[j].kind != TokenKind.Name -> false
        j + 1 >= tokens.length -> false
        _ -> tokens[j + 1].kind == TokenKind.Op && tokens[j + 1].text == "="
    }
}

/// Language source has no rule boundary: every break is a candidate,
/// and `collapse_breaks` decides which survive.
// LICENSED I23: conforms to a callback signature — the CONTRACT owns
// the parameter list, not this body
fn line_boundary(tokens: List<Token>, j: int) -> bool {
    true
}

/// Collapse each Break run to one, kept only where `boundary` allows
/// and the line does not continue; leading breaks always drop.
fn collapse_breaks(raw: List<Token>, boundary: fn(List<Token>, int) -> bool) -> List<Token> {
    mut out: List<Token> = []
    mut open: List<string> = []
    mut line_indent = if raw.is_empty() { 0 } else { raw[0].span.lo }
    mut i = 0
    while i < raw.length {
        let t = raw[i]
        if t.kind == TokenKind.Break {
            mut j = i + 1
            while j < raw.length && raw[j].kind == TokenKind.Break { j = j + 1 }
            let next_indent = if j < raw.length { raw[j].span.lo - raw[j - 1].span.hi } else { 0 }
            if boundary(raw, j) && !out.is_empty() && separates(open) && !continues(out.last()!) && !continued_by(raw, j, next_indent > line_indent, out.last()!) {
                out.push(t)
                line_indent = next_indent
            }
            i = j
        } else {
            open = opened(open, t)
            out.push(t)
            i = i + 1
        }
    }
    out
}

/// Whether the next line continues this one by how it BEGINS: an
/// `else` or an `or`, or a `.name` chain step indented deeper than the line it
/// continues — unless this line opened a brace (a first match arm)
/// or ended in a comma (a listed item).
fn continued_by(raw: List<Token>, j: int, deeper: bool, last: Token) -> bool {
    if j >= raw.length { return false }
    let next = raw[j]
    if next.kind == TokenKind.Name && (next.text == "else" || next.text == "or" || next.text == "with") { return true }
    let chain = next.kind == TokenKind.Op && next.text == "." && j + 1 < raw.length && raw[j + 1].kind == TokenKind.Name
    chain && deeper && !(last.kind == TokenKind.Op && (last.text == "{" || last.text == ","))
}

/// Whether a line break separates here: outside every bracket, or
/// directly inside a brace — inside `(` or `[` it never does.
fn separates(open: List<string>) -> bool {
    let top: string? = open.last()
    top == null || top! == "{"
}

/// The bracket stack after a token: an opener pushes, a closer pops.
fn opened(open: List<string>, t: Token) -> List<string> {
    if t.kind != TokenKind.Op { return open }
    if t.text == "(" || t.text == "[" || t.text == "{" { return open.concat([t.text]) }
    if (t.text == ")" || t.text == "]" || t.text == "}") && !open.is_empty() { return open.slice(0, open.length - 1) }
    open
}

/// A token after which the line continues — an operator that wants
/// a right side, or the `or` between a pattern's alternatives.
fn continues(t: Token) -> bool {
    (t.kind == TokenKind.Op && continuing_op(t.text)) || (t.kind == TokenKind.Name && t.text == "or")
}

/// An operator that wants a right side. A match, not a list: this is
/// asked once per line of every source, and a list here would be a
/// fresh list per line.
fn continuing_op(text: string) -> bool {
    match text {
        "+" or "-" or "*" or "/" or "%" or "==" or "!=" or "<" or "<=" or ">"
            or ">=" or "&&" or "||" or "??" or "=" or "->" or "," -> true,
        _ -> false,
    }
}

/// The whole input, one ScanStep at a time; then the line policy, a
/// final Break, and Eof. `holes` is the stack of open interpolation
/// holes, each entry its brace depth — a depth-0 `}` resumes the
/// string instead of emitting the brace.
fn lex_with(src: string, boundary: fn(List<Token>, int) -> bool, interpolate: bool) -> LexResult {
    mut raw: List<Token> = []
    mut errors: List<LexError> = []
    mut holes: List<int> = []
    mut i = 0
    let n = src.length
    while i < n {
        mut s = scan_step(src, n, i, interpolate)
        if in_hole(holes, s.token) {
            let t = s.token!
            if t.text == "{" { holes.set(holes.length - 1, holes.last()! + 1) }
            if t.text == "}" {
                if holes.last()! == 0 {
                    let _ = holes.pop()
                    s = scan_string(src, s.next, false, interpolate)
                } else {
                    holes.set(holes.length - 1, holes.last()! - 1)
                }
            }
        }
        // A hole is single-line: a newline inside one is the missing
        // `}`, said once, and lexing recovers to normal.
        if !holes.is_empty() && s.token != null && s.token!.kind == TokenKind.Break {
            errors.push(hole_error(s.token!.span.lo))
            holes = []
        }
        if s.token != null { raw.push(s.token!) }
        if s.err != null { errors.push(s.err!) }
        if s.opens_hole { holes.push(0) }
        i = s.next
        // THE GRAMMAR BLOCK is not Avra: its body is grammar
        // notation, so the lexer hands it over whole. Nothing else
        // could read it — `n:NAME` and `->` are not our tokens, and
        // the braces it counts live inside its own string literals.
        if opens_grammar(raw, s.token) {
            let body = scan_raw_block(src, n, i)
            if body.token != null { raw.push(body.token!) }
            if body.err != null { errors.push(body.err!) }
            i = body.next
        }
    }
    if !holes.is_empty() { errors.push(hole_error(src.length)) }
    mut tokens = collapse_breaks(raw, boundary)
    // Every rule or statement ends in a Break, even without a trailing
    // newline.
    let tail: Token? = tokens.last()
    if tail != null && tail!.kind != TokenKind.Break {
        tokens.push(token(TokenKind.Break, "", src.length, src.length))
    }
    tokens.push(token(TokenKind.Eof, "", src.length, src.length))
    LexResult { tokens: tokens, errors: errors }
}

/// The unclosed-hole complaint, at `at`.
fn hole_error(at: int) -> LexError {
    LexError { message: "an interpolation hole is missing its `}`", span: span_of(at, at) }
}

/// True when the step's token is a brace the open hole owns.
fn in_hole(holes: List<int>, t: Token?) -> bool {
    if holes.is_empty() || t == null { return false }
    let tok = t!
    tok.kind == TokenKind.Op && (tok.text == "{" || tok.text == "}")
}

/// Grammar-DSL text: a line break survives only at a rule boundary;
/// quoted literals never interpolate.
export fn lex_grammar(src: string) -> LexResult {
    lex_with(src, rule_boundary, false)
}

/// Language source: every line break separates — except directly
/// inside `(` or `[` (a brace opened inside them separates again),
/// after a token that promises more (a binary operator, `=`, `->`,
/// a comma, a trailing `or`), before an `else`, `or` or `with`, and
/// before a `.name` line indented deeper than the line it continues
/// (a method chain; a match arm sits level with its siblings and
/// follows a `{`). Strings carry `${}` holes.
export fn lex_source(src: string) -> LexResult {
    lex_with(src, line_boundary, true)
}
