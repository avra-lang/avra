//! Text -> tokens, in two flavors sharing one scanner: grammar-DSL
//! (`lex_grammar` — rule-boundary layout, no interpolation) and
//! language source (`lex_source` — every newline separates, and
//! strings carry `${}` holes: IStrBegin/IStrMid/IStrEnd pieces
//! around ordinary hole tokens, a stack tracking nested holes and
//! their brace depths). A `quote { … }` body is tokenized like any
//! source, except that a `${…}` in code position is a TEMPLATE HOLE:
//! one `Hole` token stands in its place (a name no program can
//! write, `holes.av`), and the hole's own tokens are DEFERRED to
//! after the quote's closing brace as a `HoleBegin … HoleEnd` group.
//!
//! Layout is the lexer's: a newline becomes a Break token only where
//! the flavor's boundary allows; every other newline is whitespace.
//! A final Break is guaranteed before Eof.
//!
//! Lexing is error-tolerant: a bad character, an unterminated
//! string, or an unclosed hole is recorded and lexing continues, so
//! one pass reports everything.
use @std.text.{Text, builder}
use core.{Span, span_of, Remark, Trivia}
use core.{is_space, is_name_start, is_name_cont, is_digit, placeholder}

/// What a token is; Lit-vs-kind matching keys off this. The IStr
/// kinds are an interpolated string's pieces: `"a ${x} b ${y} c"`
/// lexes as IStrBegin("a ") <hole> IStrMid(" b ") <hole>
/// IStrEnd(" c").
/// `Pkg` is an `@name` — a package's head in a `use` path, and the
/// grammar DSL's own `@expect`/`@recover` words.
/// `Hole` is a template's placeholder name; `HoleBegin`/`HoleEnd`
/// bracket a deferred hole expression after the quote's brace.
/// `Block` is a sublanguage's word before its brace and `Body` the
/// text between the braces, holes as placeholders. `Component` is an
/// imported component's word, which opens an instance. `Octets` is a
/// byte string `b"…"`, its `text` the spelling between the quotes.
export enum TokenKind { Name, Num, Str, IStrBegin, IStrMid, IStrEnd, Op, Break, Eof, Pkg, Hole, HoleBegin, HoleEnd, Block, Body, Component, State, Octets, Env, Provide, On }

/// One DSL token. For Str and the IStr kinds, `text` is the
/// unquoted, unescaped contents; the span covers the delimiters. A
/// `Str` token spelled `"""..."""` carries `raw: true` — the same
/// kind, since the grammar's `STRING` terminal takes both, and the
/// one bit a printer needs to tell which delimiter to spell back.
export type Token = { kind: TokenKind, text: string, span: Span, raw: bool = false }

impl Token {
    /// Whether this token spells `text` literally — the ordinary
    /// compiler's own convenience over `bridge.av`'s free contract,
    /// which the generic engine reaches through `Lexeme<Token>` instead.
    fn lit_matches(text: string) -> bool { token_lit_matches(self, text) }

    /// The BITS of the real this number denotes. A fraction only —
    /// `is_fraction` is the guard, and the text the scanner shaped is
    /// exactly what `strtod` reads.
    fn float_bits() -> int { avra_float_bits(self.text) }

    /// Whether this number carries a POINT — a fraction, whose value
    /// no `int` holds and whose ceiling law is a different one.
    fn is_fraction() -> bool { self.text.contains(".") }

    /// The integer a Num token's digits denote.
    /// The digits as a number, or absence when no `int` holds them —
    /// `v * 10 + d` past the ceiling wraps, and the wrapped number is
    /// not the one on the page.
    fn int_value() -> int? {
        mut v = 0
        mut i = 0
        let n = self.text.length
        while i < n {
            let d = self.text.char_code(i) - 48
            if v > (9223372036854775807 - d) / 10 { return null }
            v = v * 10 + d
            i = i + 1
        }
        v
    }
}

/// One recorded problem; lexing continued past it.
export type LexError = { message: string, span: Span }

/// A declaration-leading `///` group, one entry per line. `before`
/// is the first token after the group; parsing uses that source-order
/// anchor to attach the lines without making comments part of the
/// grammar. `line_ats` is each line's own offset, kept so a group
/// that turns out to open a MARK rather than a declaration can fall
/// back to a remark per line, in place. `pkg` marks a `@`-anchored
/// group: a `@word` opens either an ANNOTATION (a declaration's own
/// prefix) or a MARK (a variant's, a field's) — the same token at
/// the lexer, so only the parse that follows can tell them apart.
export type DocComment = { lines: List<string>, before: int, at: int, line_ats: List<int>, pkg: bool }

/// Every token, retained doc comment and problem from one pass.
export type LexResult = { tokens: List<Token>, docs: List<DocComment>, file_doc: List<string>, remarks: List<Remark>, errors: List<LexError> }

/// Membership in the single-char operator set; `-`, `<`, `>`, `!`,
/// `.`, and `|` reach here only after their two-char munches have
/// failed.
/// A single-character operator, by code — the scanner asks this of
/// every character that is not a name, a number or a space.
fn is_single_op_code(c: int) -> bool {
    c == 61 ||
        c == 124 ||
        c == 40 ||
        c == 41 ||
        c == 42 ||
        c == 43 ||
        c == 63 ||
        c == 58 ||
        c == 44 ||
        c == 45 ||
        c == 60 ||
        c == 62 ||
        c == 123 ||
        c == 125 ||
        c == 47 ||
        c == 37 ||
        c == 33 ||
        c == 91 ||
        c == 93 ||
        c == 46 ||
        c == 38 ||
        c == 94 ||
        c == 126
}
// the bitwise three: `&` and `^` reach here only after `&&`
// failed its munch, and `~` has no two-character form at all

/// A token spanning `[lo, hi)`.
fn token(kind: TokenKind, text: string, lo: int, hi: int) -> Token {
    Token { kind: kind, text: text, span: span_of(lo, hi) }
}

/// First index at or after `from` where `pred` stops holding. The
/// length is PASSED, never re-asked: `src.length` is `strlen` in the
/// runtime, so testing it per character makes a scan quadratic.
fn scan_while(src: string, n: int, from: int, pred: fn(int) -> bool) -> int {
    mut j = from
    while j < n && pred(src.char_code(j)) { j = j + 1 }
    j
}

/// One scanner step: at most one token, at most one error, always
/// progress. `opens_hole` means the token ended at `${` and the
/// loop now lexes the hole's expression.
type ScanStep = { token: Token?, err: LexError?, opens_hole: bool, next: int }

/// A step that produced a token.
fn emit(t: Token, next: int) -> ScanStep {
    ScanStep { token: t, err: null, opens_hole: false, next: next }
}

/// Whether a raw body's scan ended at its closing brace — not at a
/// hole, and not ragged.
fn body_closed(s: ScanStep) -> bool {
    s.token != null && s.err == null && !s.opens_hole
}

/// The closing brace a raw body's scan consumed, as its own token.
fn brace_at(next: int) -> Token {
    token(TokenKind.Op, "}", next - 1, next)
}

/// Whether a `//` line comment starts at `j`.
fn line_comment_at(src: string, n: int, j: int) -> bool {
    j + 1 < n && src.char_code(j) == 47 && src.char_code(j + 1) == 47
}

/// A step that produced nothing (whitespace).
fn skip(next: int) -> ScanStep {
    ScanStep { token: null, err: null, opens_hole: false, next: next }
}

/// Where a number's FRACTION ends, or `j` when it has none. A `.`
/// JOINS the number only when a DIGIT follows it, and that one
/// character of lookahead is the whole rule: `0..3` is a range and
/// `5.length` is a property, and a greedier scan eats both. A number
/// never STARTS with a point either — `.A` is a bare variant.
fn fraction_end(src: string, n: int, j: int) -> int {
    if j >= n || src.char_code(j) != 46 { return j }
    if j + 1 >= n || !is_digit(src.char_code(j + 1)) { return j }
    scan_while(src, n, j + 1, is_digit)
}

/// A number token — and, when the digits name a value no `int` can
/// hold, the refusal beside it. The token still stands so one bad
/// literal does not cascade; what must never stand is the WRAPPED
/// value, which is not the number on the page.
fn numbered(text: string, lo: int, hi: int) -> ScanStep {
    let t = token(TokenKind.Num, text, lo, hi)
    if t.is_fraction() { return measured_real(t, text, lo, hi) }
    if t.int_value() != null { return emit(t, hi) }
    ScanStep {
        token: t,
        opens_hole: false,
        err: LexError { message: "`${text}` does not fit an `int`", span: span_of(lo, hi) },
        next: hi,
    }
}

/// A REAL, refused when it overflows to infinity. Its twin is the
/// integer's: the token stands so one bad literal does not cascade,
/// and what must never stand is the value that is not on the page.
fn measured_real(t: Token, text: string, lo: int, hi: int) -> ScanStep {
    if avra_float_fits(text) != 0 { return emit(t, hi) }
    ScanStep {
        token: t,
        opens_hole: false,
        err: LexError { message: "`${text}` does not fit a `float`", span: span_of(lo, hi) },
        next: hi,
    }
}

/// Whether the token just emitted opens a grammar block — the
/// keyword, then the brace the block's own body may not be read
/// through.
fn opens_grammar(raw: List<Token>, just: Token?) -> bool {
    opens_word_block(raw, just, "grammar")
}

/// Whether the token just emitted opens a quote's body.
fn opens_quote(raw: List<Token>, just: Token?) -> bool {
    opens_word_block(raw, just, "quote")
}

/// Whether the token just consumed is a `{` opening a raw block after
/// the word `word`.
fn opens_word_block(raw: List<Token>, just: Token?, word: string) -> bool {
    let before: Token? = word_before_brace(raw, just)
    before != null && before!.text == word
}

/// The name standing right before a `{` just consumed, when one does
/// and no `syntax` stands before it — a sublanguage's block word when
/// the file imports one.
fn opens_block(raw: List<Token>, just: Token?, words: List<string>) -> bool {
    let before: Token? = word_before_brace(raw, just)
    before != null && words.contains(before!.text) && !opens_syntax(raw, just)
}

/// `grammar <word> {` — a NAMED grammar, a sublanguage's declaration,
/// its notation taken whole like a `grammar {` body's.
fn opens_syntax(raw: List<Token>, just: Token?) -> bool {
    if word_before_brace(raw, just) == null || raw.length < 3 { return false }
    let first = raw[raw.length - 3]
    first.kind == TokenKind.Name && first.text == "grammar"
}

/// The name token before a `{` just consumed, or null.
fn word_before_brace(raw: List<Token>, just: Token?) -> Token? {
    if just == null { return null }
    if just!.kind != TokenKind.Op || just!.text != "{" { return null }
    if raw.length < 2 { return null }
    let before = raw[raw.length - 2]
    if before.kind == TokenKind.Name { before } else { null }
}

/// THE GRAMMAR BLOCK'S BODY, taken whole: every byte to the brace
/// that closes the one already consumed. Braces inside the body's
/// own STRING literals do not count — `block`'s grammar writes `"{"`
/// as a literal, and a counter blind to quotes would end there.
fn scan_raw_block(src: string, n: int, from: int, word: string) -> ScanStep {
    mut depth = 1
    mut i = from
    mut quoted = false
    while i < n {
        let c = src.char_code(i)
        if quoted {
            if c == 92 {
                i = i + 1
            } else if c == 34 { quoted = false }
        } else if line_comment_at(src, n, i) {
            i = line_end(src, n, i)
        } else if c == 34 {
            quoted = true
        } else if c == 123 {
            depth = depth + 1
        } else if c == 125 {
            depth = depth - 1
            if depth == 0 {
                // the closing brace is the block's, not the program's
                return emit(token(TokenKind.Str, src.substring(from, i), from, i), i + 1)
            }
        }
        i = i + 1
    }
    refused("a `${word}` block is never closed", from, n)
}

/// A step that produced only an error.
fn refused(message: string, lo: int, hi: int) -> ScanStep {
    ScanStep {
        token: null,
        opens_hole: false,
        err: LexError { message: message, span: span_of(lo, hi) },
        next: hi,
    }
}

/// Three quotes open a RAW string.
fn triple_at(src: string, n: int, i: int) -> bool {
    i + 2 < n && src.char_code(i + 1) == 34 && src.char_code(i + 2) == 34
}

/// The raw text between `"""` and the next `"""` — one Str token,
/// unterminated when the file ends first.
fn scan_triple(src: string, n: int, i: int) -> ScanStep {
    mut j = i + 3
    while j + 2 < n {
        if src.char_code(j) == 34 && src.char_code(j + 1) == 34 && src.char_code(j + 2) == 34 {
            return emit(
                token(TokenKind.Str, src.substring(i + 3, j), i, j + 3) with { raw: true },
                j + 3,
            )
        }
        j = j + 1
    }
    ScanStep {
        token: token(TokenKind.Str, src.substring(i + 3, n), i, n) with { raw: true },
        opens_hole: false,
        err: LexError { message: "unterminated string", span: span_of(i, n) },
        next: n,
    }
}

/// A BYTE STRING, `b"…"`: its token carries the spelling between the
/// quotes, which `byte_string_octets` reads — one decoder for the
/// lexer's verdict and the value alike. No hole opens in one.
fn scan_octets(src: string, n: int, i: int) -> ScanStep {
    let close = closing_quote(src, n, i + 2)
    if close < 0 { return octets_refused(src, i, line_end(src, n, i), unterminated_octets()) }
    let spelled = src.substring(i + 2, close)
    match byte_string_octets(spelled) {
        .Ok(_) -> emit(token(TokenKind.Octets, spelled, i, close + 1), close + 1),
        .Err(why) -> octets_refused(src, i, close + 1, why),
    }
}

/// A byte string the lexer refuses still stands as its token, so the
/// parse around it reads on and only the refusal is heard.
fn octets_refused(src: string, lo: int, hi: int, why: string) -> ScanStep {
    ScanStep {
        token: token(TokenKind.Octets, src.substring(lo + 2, hi), lo, hi),
        opens_hole: false,
        err: LexError { message: why, span: span_of(lo, hi) },
        next: hi,
    }
}

/// The unescaped quote that closes a one-line string whose text starts
/// at `from`, or -1 when the line or the file ends first.
fn closing_quote(src: string, n: int, from: int) -> int {
    mut j = from
    while j < n {
        let c = src.char_code(j)
        if c == 34 { return j }
        if c == 10 { return -1 }
        j = j + if c == 92 { 2 } else { 1 }
    }
    -1
}

/// A byte string's octets from its spelling: every byte as written,
/// or an escape — `\"`, `\\`, `\n`, `\t`, `\r`, `\0`, or `\xHH` for any
/// octet. An escape it does not know is refused, never kept raw.
export fn byte_string_octets(spelled: string) -> Result<List<int>, string> {
    mut out: List<int> = []
    mut i = 0
    while i < spelled.length {
        let c = spelled.char_code(i)
        if c != 92 {
            out.push(c)
            i = i + 1
        } else {
            let e = if i + 1 < spelled.length { spelled.char_code(i + 1) } else { -1 }
            if e == 120 {
                let v = hex_pair(spelled, i + 2)
                if v < 0 { return .Err(bad_hex_escape()) }
                out.push(v)
                i = i + 4
            } else {
                let v = octet_escape(e)
                if v < 0 { return .Err(unknown_octet_escape()) }
                out.push(v)
                i = i + 2
            }
        }
    }
    .Ok(out)
}

/// The octet a one-letter escape names, or -1.
fn octet_escape(e: int) -> int {
    match e { 34 -> 34, 92 -> 92, 110 -> 10, 116 -> 9, 114 -> 13, 48 -> 0, _ -> -1 }
}

/// Two hex digits at `at` as one octet, or -1.
fn hex_pair(s: string, at: int) -> int {
    if at + 1 >= s.length { return -1 }
    let hi = hex_digit(s.char_code(at))
    let lo = hex_digit(s.char_code(at + 1))
    if hi < 0 || lo < 0 { -1 } else { hi * 16 + lo }
}

fn hex_digit(c: int) -> int {
    when {
        c >= 48 && c <= 57 -> c - 48
        c >= 97 && c <= 102 -> c - 87
        c >= 65 && c <= 70 -> c - 55
        _ -> -1
    }
}

/// The three escapes; anything else after `\` stays raw. `\$` exists
/// so text can hold a literal `${`.
fn unescape(e: int) -> string? {
    match e { 34 -> "\"", 92 -> "\\", 36 -> "\$", 110 -> "\n", 116 -> "\t", 114 -> "\r", _ -> null }
}

/// How one string piece ended: at its closing quote, at a `${` hole,
/// or not at all.
enum StrStop { Quote, Hole, Ragged }

type StrPart = { text: string, stop: StrStop, next: int }

/// Text from `from` (already inside the quotes) to the piece's end.
/// Plain runs are copied whole into the builder; only an escape
/// breaks a run.
fn scan_str_part(src: string, from: int, interpolate: bool) -> StrPart {
    let n = src.length
    mut out = builder()
    mut run = from
    mut j = from
    while j < n {
        let c = src.char_code(j)
        if c == 34 { return StrPart { text: closed(out, src, run, j), stop: StrStop.Quote, next: j + 1 } }
        if c == 10 { return ragged(closed(out, src, run, j), j) }
        if interpolate && c == 36 && j + 1 < n && src.char_code(j + 1) == 123 {
            return StrPart { text: closed(out, src, run, j), stop: StrStop.Hole, next: j + 2 }
        }
        if c == 92 && j + 1 < n {
            out.push(src.substring(run, j))
            out.push(unescape(src.char_code(j + 1)) ?? src.substring(j, j + 2))
            j = j + 2
            run = j
        } else {
            j = j + 1
        }
    }
    ragged(closed(out, src, run, j), j)
}

/// The run since the last escape appended; the text complete.
fn closed(mut out: Text, src: string, run: int, j: int) -> string {
    out.push(src.substring(run, j))
    out.built()
}

/// A string piece the line ended before its quote did.
fn ragged(text: string, at: int) -> StrPart {
    StrPart { text: text, stop: StrStop.Ragged, next: at }
}

/// A string piece as its token: the OPENING piece is Str (no hole)
/// or IStrBegin; a CONTINUATION piece (after a hole's `}`) is
/// IStrMid or IStrEnd. `opens_hole` tells the loop to enter a hole.
fn scan_string(src: string, i: int, opening: bool, interpolate: bool) -> ScanStep {
    let from = if opening { i + 1 } else { i }
    let p = scan_str_part(src, from, interpolate)
    let kind = match p.stop {
        .Quote or .Ragged -> if opening { TokenKind.Str } else { TokenKind.IStrEnd },
        .Hole -> if opening { TokenKind.IStrBegin } else { TokenKind.IStrMid },
    }
    let t = token(kind, p.text, i, p.next)
    if p.stop is .Ragged {
        return ScanStep {
            token: t,
            opens_hole: false,
            err: LexError { message: "unterminated string", span: span_of(i, p.next) },
            next: p.next,
        }
    }
    ScanStep { token: t, err: null, opens_hole: p.stop is .Hole, next: p.next }
}

/// First index at or after `from` that is a newline (or the end).
fn line_end(src: string, n: int, from: int) -> int {
    mut j = from
    while j < n && src.char_code(j) != 10 { j = j + 1 }
    j
}

/// The contents of one `///` line, with its conventional one space
/// removed. Further indentation is the documentation's own text.
/// A comment line AS WRITTEN — `//` included, the newline and a
/// carriage return excluded. The printer replays this verbatim, so
/// nothing here reconstructs the author's spacing.
fn comment_line(src: string, n: int, i: int) -> string {
    let end = line_end(src, n, i)
    let hi = if end > i && src.char_code(end - 1) == 13 { end - 1 } else { end }
    src.substring(i, hi)
}

fn doc_line(src: string, n: int, i: int) -> string {
    let end = line_end(src, n, i)
    let from = if i + 3 < end && src.char_code(i + 3) == 32 { i + 4 } else { i + 3 }
    let hi = if end > from && src.char_code(end - 1) == 13 { end - 1 } else { end }
    src.substring(from, hi)
}

/// Whether a token can begin a documented declaration. This guard
/// keeps an orphan doc before `}` from drifting to the next scope's
/// declaration. An annotation is a declaration prefix too.
fn declaration_start(t: Token) -> bool {
    if t.kind == TokenKind.Pkg { return true }
    if t.kind != TokenKind.Name { return false }
    match t.text {
        "export" or "fn" or "extern" or "mut" or "once" or "static" or "const" or "type" or "enum" or "trait" or "impl" -> true,
        _ -> false,
    }
}

/// THE TWO-CHAR OPERATORS, by the CODES that spell them — each
/// munches before its single-char prefix. Read by code because this
/// is the scanner's inner loop: a list of strings here is a fresh
/// list and a substring per character of every source.
fn two_char_of(a: int, b: int) -> string? {
    when {
        a == 45 && b == 62 -> "->"
        a == 61 && b == 61 -> "=="
        a == 46 && b == 46 -> ".."
        a == 33 && b == 61 -> "!="
        a == 60 && b == 61 -> "<="
        a == 62 && b == 61 -> ">="
        a == 38 && b == 38 -> "&&"
        // `<<` MUNCHES AND `>>` MUST NOT. A type argument closes
        // with `>`, so `Table<List<string>>` would end in one shift
        // token and the type would never close. `<<` has no twin —
        // nothing opens two argument lists with no name between
        // them. Shift-RIGHT is therefore two adjacent `>` the
        // grammar joins: the split has to happen somewhere, and this
        // grammar matches tokens and cannot split one.
        a == 60 && b == 60 -> "<<"
        a == 124 && b == 124 -> "||"
        a == 63 && b == 63 -> "??"
        a == 63 && b == 46 -> "?."
        _ -> null
    }
}

/// The two-char operator starting at `i`, or null.
fn two_char_at(src: string, n: int, i: int) -> string? {
    if i + 1 >= n { return null }
    two_char_of(src.char_code(i), src.char_code(i + 1))
}

/// One token (or skip, or error) starting at `i`.
fn scan_step(src: string, n: int, i: int, interpolate: bool) -> ScanStep {
    let c = src.char_code(i)
    let pair: string? = two_char_at(src, n, i)
    when {
        // Newline: raw Break, resolved to layout after the scan.
        c == 10 -> emit(token(TokenKind.Break, "", i, i + 1), i + 1)
        is_space(c) -> skip(i + 1)
        // `//` comment: whitespace to end of line — the newline
        // itself still arrives as layout.
        c == 47 && i + 1 < n && src.char_code(i + 1) == 47 -> skip(line_end(src, n, i))
        // A byte string: `b` touching its opening quote.
        c == 98 && i + 1 < n && src.char_code(i + 1) == 34 -> scan_octets(src, n, i)
        // Name: idents and named terminals alike.
        is_name_start(c) -> {
            let j = scan_while(src, n, i + 1, is_name_cont)
            emit(token(TokenKind.Name, src.substring(i, j), i, j), j)
        }
        // Number: a digit run and its fraction; adjacent letters lex
        // as their own Name.
        is_digit(c) -> {
            let j = scan_while(src, n, i + 1, is_digit)
            let k = fraction_end(src, n, j)
            numbered(src.substring(i, k), i, k)
        }
        // A RAW string: `"""` to `"""`, no escapes, no holes.
        c == 34 && triple_at(src, n, i) -> scan_triple(src, n, i)
        // String: unquote and unescape.
        c == 34 -> scan_string(src, i, true, interpolate)
        // `@`-word: one Op token (`@expect`, `@recover`).
        c == 64 -> {
            let j = scan_while(src, n, i + 1, is_name_cont)
            if j == i + 1 {
                refused("expected a name after `@`", i, i + 1)
            } else {
                emit(token(TokenKind.Pkg, src.substring(i, j), i, j), j)
            }
        }
        // A two-char op munches before its single-char prefix.
        pair != null -> emit(token(TokenKind.Op, pair!, i, i + 2), i + 2)
        is_single_op_code(c) -> emit(token(TokenKind.Op, src.substring(i, i + 1), i, i + 1), i + 1)
        _ -> refused("unexpected character", i, i + 1)
    }
}

/// True where a grammar rule may end: before `NAME =`, or at end of
/// input.
fn rule_boundary(tokens: List<Token>, j: int) -> bool {
    when {
        j >= tokens.length -> true
        tokens[j].kind != TokenKind.Name -> false
        j + 1 >= tokens.length -> false
        _ -> tokens[j + 1].kind == TokenKind.Op && tokens[j + 1].text == "="
    }
}

/// Language source has no rule boundary: every break is a candidate,
/// and `collapse_breaks` decides which survive.
// LICENSED fns.dead_parameter: conforms to a callback signature — the CONTRACT owns
// the parameter list, not this body
fn line_boundary(tokens: List<Token>, j: int) -> bool {
    true
}

/// Collapse each Break run to one, kept only where `boundary` allows
/// and the line does not continue; leading breaks always drop.
fn collapse_breaks(raw: List<Token>, boundary: fn(List<Token>, int) -> bool) -> List<Token> {
    mut out: List<Token> = []
    mut open: List<string> = []
    // A COLUMN, and a file's first statement stands at column zero.
    // `span.lo` is a byte OFFSET, which only reads as a column while
    // the first token is on line one — a leading comment makes
    // `raw[0]` that line's Break, whose offset is the comment's
    // LENGTH, and leading breaks never push, so nothing corrects it
    // before the first continuation is decided.
    mut line_indent = 0
    // The indent each open bracket was opened at: a line inside a brace
    // is kept and moves `line_indent`, and closing the brace returns to
    // the line the brace opened on — the line a following chain step
    // continues.
    mut opened_at: List<int> = []
    mut i = 0
    while i < raw.length {
        let t = raw[i]
        if t.kind == TokenKind.Break {
            mut j = i + 1
            while j < raw.length && raw[j].kind == TokenKind.Break { j = j + 1 }
            let next_indent = if j < raw.length { raw[j].span.lo - raw[j - 1].span.hi } else { 0 }
            if boundary(raw, j) &&
                !out.is_empty() &&
                separates(open) &&
                !continues(out.last()!) &&
                !continued_by(raw, j, next_indent > line_indent, out.last()!) {
                out.push(t)
                line_indent = next_indent
            }
            i = j
        } else {
            if opens_bracket(t) { opened_at.push(line_indent) }
            if closes_bracket(t) && !opened_at.is_empty() {
                line_indent = opened_at.last()!
                opened_at = opened_at.slice(0, opened_at.length - 1)
            }
            open = opened(open, t)
            out.push(t)
            i = i + 1
        }
    }
    out
}

/// Whether the next line continues this one by how it BEGINS: an
/// `else` or an `or`, or a `.name` chain step indented deeper than the line it
/// continues — unless this line opened a brace (a first match arm)
/// or ended in a comma (a listed item).
fn continued_by(raw: List<Token>, j: int, deeper: bool, last: Token) -> bool {
    if j >= raw.length { return false }
    let next = raw[j]
    if next.kind == TokenKind.Name &&
        (next.text == "else" || next.text == "or" || next.text == "with") {
        return true
    }
    let chain = next.kind == TokenKind.Op &&
        next.text == "." &&
        j + 1 < raw.length &&
        raw[j + 1].kind == TokenKind.Name
    chain && deeper && !(last.kind == TokenKind.Op && (last.text == "{" || last.text == ","))
}

/// Whether a line break separates here: outside every bracket, or
/// directly inside a brace — inside `(` or `[` it never does.
fn separates(open: List<string>) -> bool {
    let top: string? = open.last()
    top == null || top! == "{"
}

/// The bracket stack after a token: an opener pushes, a closer pops.
fn opened(open: List<string>, t: Token) -> List<string> {
    if opens_bracket(t) { return open.concat([t.text]) }
    if closes_bracket(t) && !open.is_empty() { return open.slice(0, open.length - 1) }
    open
}

fn opens_bracket(t: Token) -> bool { t.kind == TokenKind.Op && (t.text == "(" || t.text == "[" || t.text == "{") }

fn closes_bracket(t: Token) -> bool { t.kind == TokenKind.Op && (t.text == ")" || t.text == "]" || t.text == "}") }

/// A token after which the line continues — an operator that wants
/// a right side, or the `or` between a pattern's alternatives.
fn continues(t: Token) -> bool {
    t.kind == TokenKind.Op && continuing_op(t.text) || t.kind == TokenKind.Name && t.text == "or"
}

/// An operator that wants a right side. A match, not a list: this is
/// asked once per line of every source, and a list here would be a
/// fresh list per line.
///
/// A CLOSER NEVER CONTINUES A LINE, which is why `<` is here and `>`
/// is not. `>` closes a TYPE ARGUMENT LIST as well as wanting a
/// right side, and a line ending in one is complete far more often
/// than it is half of a comparison — `type Rows = List<int>`, a
/// trait's `fn a() -> List<T>`. Reading it as a continuation glued
/// the next statement onto this line. The asymmetry belongs to the
/// bracket, not to the operator; it is the `>>`-munch law at the
/// LINE rather than the token.
fn continuing_op(text: string) -> bool {
    match text {
        "+" or "-" or "*" or "/" or "%" or "==" or "!=" or "<" or "<=" or ">=" or "&&" or "||" or "??" or "=" or "->" or "," -> true,
        _ -> false,
    }
}

/// The whole input, one ScanStep at a time; then the line policy, a
/// final Break, and Eof.
fn lex_with(src: string, boundary: fn(List<Token>, int) -> bool, interpolate: bool) -> LexResult {
    lex_words(src, boundary, interpolate, [], false)
}

/// The whole input under a set of BLOCK WORDS — a word of the set
/// before `{` opens a raw block whose text is one `Body` token — and,
/// in PLACEHOLDER mode, `${k}` lexes as the `Hole` token it names.
fn lex_words(
    src: string,
    boundary: fn(List<Token>, int) -> bool,
    interpolate: bool,
    words: List<string>,
    placeholders: bool,
) -> LexResult {
    mut lx = Lexing {
        src: src,
        n: src.length,
        interpolate: interpolate,
        words: words,
        placeholders: placeholders,
        raw: [],
        docs: [],
        remarks: [],
        blank_run: false,
        pending: [],
        pending_at: 0,
        pending_ats: [],
        file_pending: [],
        file_doc_open: true,
        errors: [],
        stack: [],
        frames: [],
        line_comment: false,
        line_has_token: false,
        i: 0,
    }
    lx.run()
    mut tokens = collapse_breaks(lx.raw, boundary)
    // Every rule or statement ends in a Break, even without a trailing
    // newline.
    let tail: Token? = tokens.last()
    if tail != null && tail!.kind != TokenKind.Break {
        tokens.push(token(TokenKind.Break, "", src.length, src.length))
    }
    tokens.push(token(TokenKind.Eof, "", src.length, src.length))
    LexResult {
        tokens: tokens,
        docs: lx.docs,
        file_doc: lx.file_pending,
        remarks: sorted_remarks(lx.remarks),
        errors: lx.errors,
    }
}

/// `remarks`, by `at` ascending. Every push during a scan already
/// lands in order EXCEPT an orphaned `///` group's: it is flushed at
/// the NEXT real token, which can stand after a plain `//` an
/// interleaved line already pushed straight to the list — so the
/// list is sorted once, the printer's cursor being a single forward
/// walk that a single out-of-order entry would desync for good.
fn sorted_remarks(rs: List<Remark>) -> List<Remark> {
    mut remaining = rs
    mut out: List<Remark> = []
    while !remaining.is_empty() {
        let m = lowest_at_index(remaining)
        out.push(remaining[m])
        remaining = remaining.slice(0, m).concat(remaining.slice(m + 1, remaining.length))
    }
    out
}

fn lowest_at_index(rs: List<Remark>) -> int {
    mut best = 0
    for i, r in rs {
        if r.at < rs[best].at { best = i }
    }
    best
}

/// What the scanner is INSIDE, innermost last: a quote's or block's
/// body, a string's hole, or a template hole. A hole's brace depth
/// rides the CONTEXT, never the frame it belongs to, so a hole
/// nested in a hole counts its own braces.
enum Ctx {
    Body(frame: int)
    StrHole(depth: int)
    QuoteHole(frame: int, depth: int)
}

/// One open `quote { … }` or sublanguage block: its body's brace
/// depth, the hole groups deferred to after its closing brace, and
/// the Hole token being assembled — its name runs, its start, and the
/// holes it spans. A RAW frame keeps its body as text (`body`), holes
/// written as placeholders, instead of tokenizing it.
type QuoteFrame = {
    raw: bool,
    body: Text,
    depth: int,
    groups: List<HoleGroup>,
    count: int,
    // the open hole's tokens, brace depth, and where its `${` stands
    current: List<Token>,
    hole_lo: int,
    // the Hole token in assembly, when one is
    assembling: bool,
    parts: List<string>,
    holes: List<int>,
    // the hole token's own start — the name run it begins with — while
    // `lo` is the BODY's start, which the Body token and the unclosed
    // block's span read. Two starts, two fields.
    head: int,
    lo: int,
}

/// One deferred hole: its tokens and its extent, `${` to `}`.
type HoleGroup = { tokens: List<Token>, lo: int, hi: int }

/// The scan's state: the tokens so far, the doc-comment bookkeeping,
/// the context stack, and the quote frames the stack's entries name.
type Lexing = {
    src: string,
    n: int,
    interpolate: bool,
    // the sublanguage words the file imports, and whether `${k}` is
    // read as the placeholder it names (a block body being re-lexed)
    words: List<string>,
    placeholders: bool,
    raw: List<Token>,
    docs: List<DocComment>,
    remarks: List<Remark>,
    blank_run: bool,
    pending: List<string>,
    pending_at: int,
    // one offset per pending line, so an orphaned group can still
    // replay each line at its own position when it turns into remarks
    pending_ats: List<int>,
    // a leading run of `//!` lines — the file's own doc — collected
    // only while file_doc_open holds
    file_pending: List<string>,
    // true until the first thing that isn't a leading `//!` line: a
    // real token, a `///` line, or a plain remark
    file_doc_open: bool,
    errors: List<LexError>,
    stack: List<Ctx>,
    frames: List<QuoteFrame>,
    line_comment: bool,
    line_has_token: bool,
    i: int,
}

impl Lexing {
    mut fn run() {
        while self.i < self.n {
            if self.in_raw_body() {
                self.raw_step()
            } else if self.placeholders && self.at_hole_open() {
                self.placeholder()
            } else {
                self.noted_comment()
                if self.hole_opens_here() {
                    self.open_hole()
                } else {
                    self.step()
                }
            }
        }
        self.closed_at_end()
    }

    // ── a raw block body ──

    /// Whether the scanner stands in a raw block's body — the innermost
    /// context a raw frame's own, not one of its holes.
    fn in_raw_body() -> bool {
        let top? = self.stack.last() else { return false }
        match top { .Body(f) -> self.frames[f].raw, .StrHole(_) or .QuoteHole(_, _) -> false }
    }

    /// One byte of a raw body: a hole opens and leaves its placeholder
    /// in the text; a brace steps the depth, the closing one ends the
    /// block; every other byte is the body's — a string's braces
    /// included, as the grammar block's scan reads them.
    mut fn raw_step() {
        let f = self.frames.length - 1
        if self.at_hole_open() {
            self.body_push(f, "\${${self.frames[f].count}}")
            self.open_hole()
            return
        }
        let c = self.src.char_code(self.i)
        if c == 34 {
            let j = string_end(self.src, self.n, self.i)
            self.body_push(f, self.src.substring(self.i, j))
            self.i = j
            return
        }
        if c == 123 { self.frame_depth(f, 1) }
        if c == 125 {
            if self.frames[f].depth == 0 {
                self
                    .push(
                        token(
                            TokenKind.Body,
                            self.frames[f].body.built(),
                            self.frames[f].lo,
                            self.i,
                        ),
                    )
                self.close_quote(token(TokenKind.Op, "}", self.i, self.i + 1))
                self.i = self.i + 1
                return
            }
            self.frame_depth(f, -1)
        }
        self.body_push(f, self.src.substring(self.i, self.i + 1))
        self.i = self.i + 1
    }

    mut fn body_push(f: int, text: string) {
        mut fr = self.frames[f]
        fr.body.push(text)
        self.frames.set(f, fr)
    }

    /// A placeholder `${k}` read as the Hole token it names.
    mut fn placeholder() {
        let close = scan_while(self.src, self.n, self.i + 2, is_digit)
        if close >= self.n || self.src.char_code(close) != 125 {
            self
                .errors
                .push(LexError { message: "a placeholder is `\${k}`", span: span_of(self.i, close) })
            self.i = close
            return
        }
        self.push(token(TokenKind.Hole, self.src.substring(self.i, close + 1), self.i, close + 1))
        self.i = close + 1
    }

    fn at_hole_open() -> bool {
        self.i + 1 < self.n &&
            self.src.char_code(self.i) == 36 &&
            self.src.char_code(self.i + 1) == 123
    }

    /// One scanner step, routed by what the scanner is inside.
    mut fn step() {
        let s = scan_step(self.src, self.n, self.i, self.interpolate)
        let routed = self.routed(s)
        if routed.token != null { self.push(routed.token!) }
        if routed.err != null { self.errors.push(routed.err!) }
        if routed.opens_hole { self.stack.push(Ctx.StrHole(0)) }
        self.i = routed.next
        self.opened_blocks(routed.token)
    }

    /// A `}` steps the innermost context's depth, or CLOSES it at
    /// depth zero — a string resumes, a template hole finishes, a
    /// quote body ends and its deferred holes follow. A `{` is NOT
    /// counted here: whether it opens a body or merely nests is
    /// decided once the token is pushed (`opened_blocks`), so no
    /// opener is ever counted against a context it does not belong to.
    mut fn routed(s: ScanStep) -> ScanStep {
        let top: Ctx? = self.stack.last()
        if top == null || s.token == null || !is_brace(s.token!) { return s }
        if s.token!.text == "{" { return s }
        match top! {
            .Body(f) -> {
                if self.frames[f].depth > 0 {
                    self.frame_depth(f, -1)
                    return s
                }
                self.close_quote(s.token!)
                skip(s.next)
            },
            .StrHole(depth) -> {
                if depth > 0 {
                    self.str_depth(depth - 1)
                    return s
                }
                let _ = self.stack.pop()
                scan_string(self.src, s.next, false, self.interpolate)
            },
            .QuoteHole(f, depth) -> {
                if depth > 0 {
                    self.nested(-1)
                    return s
                }
                self.close_hole(f, s.next)
                skip(self.i)
            },
        }
    }

    // ── contexts ──

    mut fn frame_depth(f: int, by: int) {
        mut fr = self.frames[f]
        fr.depth = fr.depth + by
        self.frames.set(f, fr)
    }

    mut fn str_depth(depth: int) {
        self.stack.set(self.stack.length - 1, Ctx.StrHole(depth))
    }

    /// THE ONE DEPTH LAW: a brace that neither opens a body nor closes
    /// the context nests it by one, every context alike.
    mut fn nested(by: int) {
        let top? = self.stack.last() else { return }
        match top {
            .Body(f) -> self.frame_depth(f, by),
            .StrHole(depth) -> self.str_depth(depth + by),
            .QuoteHole(f, depth) -> { self.stack.set(self.stack.length - 1, Ctx.QuoteHole(f, depth + by)) },
        }
    }

    /// A `grammar {` or `syntax w {` body is handed over whole; a
    /// `quote {` opens a frame whose body is tokenized like any
    /// source; a block word's `{` opens a RAW frame. A `{` that opens
    /// nothing nests the enclosing context — the one depth law.
    mut fn opened_blocks(just: Token?) {
        if opens_grammar(self.sink(), just) || opens_syntax(self.sink(), just) {
            let body = scan_raw_block(self.src, self.n, self.i, "grammar")
            if body.token != null { self.push(body.token!) }
            if body_closed(body) { self.push(brace_at(body.next)) }
            if body.err != null { self.errors.push(body.err!) }
            self.i = body.next
            return
        }
        if opens_quote(self.sink(), just) {
            self.opened_frame(false)
            return
        }
        if opens_block(self.sink(), just, self.words) {
            self.retagged_word()
            self.opened_frame(true)
            return
        }
        if just != null && just!.kind == TokenKind.Op && just!.text == "{" { self.nested(1) }
    }

    mut fn opened_frame(raw: bool) {
        self
            .frames
            .push(
                QuoteFrame {
                    raw: raw,
                    body: builder(),
                    depth: 0,
                    groups: [],
                    count: 0,
                    current: [],
                    hole_lo: 0,
                    assembling: false,
                    parts: [],
                    holes: [],
                    head: 0,
                    lo: self.i,
                },
            )
        self.stack.push(Ctx.Body(self.frames.length - 1))
    }

    /// The block word, emitted as a Name, wears its own kind now that
    /// its brace has arrived.
    mut fn retagged_word() {
        let brace = self.sink().last()!
        self.unpushed()
        let word = self.sink().last()!
        self.unpushed()
        self.push(token(TokenKind.Block, word.text, word.span.lo, word.span.hi))
        self.push(brace)
    }

    /// Whether a template hole opens here: `${` in code position
    /// inside a quote.
    fn hole_opens_here() -> bool {
        !self.frames.is_empty() &&
            self.i + 1 < self.n &&
            self.src.char_code(self.i) == 36 &&
            self.src.char_code(self.i + 1) == 123
    }

    /// A hole of the innermost quote opens: a Hole token begins here
    /// (or continues, after `}${`), taking the name run just emitted
    /// when it touches the hole.
    mut fn open_hole() {
        let f = self.frames.length - 1
        let top: Ctx? = self.stack.last()
        if top != null && top! is .QuoteHole {
            self
                .errors
                .push(
                    LexError {
                        message: "a hole inside a hole — splice the inner value first",
                        span: span_of(self.i, self.i + 2),
                    },
                )
            self.i = self.i + 2
            return
        }
        mut fr = self.frames[f]
        if !fr.assembling {
            let touching: Token? = if fr.raw { null } else { self.touching_name() }
            if touching != null {
                self.unpushed()
                fr.parts = [touching!.text]
                fr.head = touching!.span.lo
            } else {
                fr.parts = [""]
                fr.head = self.i
            }
            fr.holes = []
            fr.assembling = true
        }
        fr.holes.push(fr.count)
        fr.count = fr.count + 1
        fr.current = []
        fr.hole_lo = self.i
        self.frames.set(f, fr)
        self.stack.push(Ctx.QuoteHole(f, 0))
        self.i = self.i + 2
    }

    /// The name token just emitted, when it ends exactly where the
    /// hole begins — the run a name-embedded hole continues.
    fn touching_name() -> Token? {
        let t? = self.sink().last() else { return null }
        if t.kind == TokenKind.Name && t.span.hi == self.i { t } else { null }
    }

    /// The hole's `}`: its tokens become a deferred group, the name
    /// run after it joins the token, and the token is emitted unless
    /// another hole follows at once.
    mut fn close_hole(f: int, next: int) {
        let _ = self.stack.pop()
        mut fr = self.frames[f]
        fr.groups.push(HoleGroup { tokens: fr.current, lo: fr.hole_lo, hi: next })
        fr.current = []
        // a raw body already holds the hole's placeholder in its text
        if fr.raw {
            fr.assembling = false
            self.frames.set(f, fr)
            self.i = next
            return
        }
        let j = scan_while(self.src, self.n, next, is_name_cont)
        fr.parts.push(self.src.substring(next, j))
        self.i = j
        let continues = j + 1 < self.n &&
            self.src.char_code(j) == 36 &&
            self.src.char_code(j + 1) == 123
        if !continues {
            fr.assembling = false
            self.frames.set(f, fr)
            self.push(token(TokenKind.Hole, placeholder(fr.parts, fr.holes), fr.head, j))
            return
        }
        self.frames.set(f, fr)
    }

    /// The body's `}`: the brace, then every deferred hole as its own
    /// bracketed group, in body order.
    mut fn close_quote(brace: Token) {
        let _ = self.stack.pop()
        let fr = self.frames.pop()
        self.push(brace)
        for g in fr.groups {
            self.push(token(TokenKind.HoleBegin, "\${", g.lo, g.lo + 2))
            // LICENSED loops.push_loop: `push` is the sink's verb — it routes each token by context, not a list write
            for t in g.tokens { self.push(t) }
            self.push(token(TokenKind.HoleEnd, "}", g.hi - 1, g.hi))
        }
    }

    // ── the sink ──

    /// Where a token lands: the innermost open quote hole's group, or
    /// the stream itself.
    fn sink() -> List<Token> {
        let f? = self.open_hole_frame() else { return self.raw }
        self.frames[f].current
    }

    fn open_hole_frame() -> int? {
        mut j = self.stack.length - 1
        while j >= 0 {
            let f: int? = match self.stack[j] {
                .QuoteHole(f, _) -> f,
                .Body(_) or .StrHole(_) -> null,
            }
            if f != null { return f }
            j = j - 1
        }
        null
    }

    /// One token to its sink, with the doc-comment bookkeeping every
    /// token pays: a line's first token ends a comment group unless it
    /// starts a declaration, and a Break ends a line.
    mut fn push(t: Token) {
        if t.kind == TokenKind.Break {
            // A BLANK LINE IS THE AUTHOR'S PARAGRAPH BREAK, kept like a
            // comment. `blank_run` collapses a run to one and is ended
            // by any line that is not itself blank — a token or a
            // comment both end it, so blanks on either side of a
            // comment line stay two blanks.
            if self.line_has_token || self.line_comment {
                self.blank_run = false
            } else if !self.blank_run {
                self.remarks.push(Remark { trivia: Trivia.Blank, at: t.span.lo })
                self.blank_run = true
            }
            self.line_has_token = false
            if !self.pending.is_empty() && !self.line_comment { self.orphan_pending() }
            self.line_comment = false
        } else {
            self.file_doc_open = false
            if !self.pending.is_empty() {
                if declaration_start(t) {
                    self
                        .docs
                        .push(
                            DocComment {
                                lines: self.pending,
                                before: t.span.lo,
                                at: self.pending_at,
                                line_ats: self.pending_ats,
                                pkg: t.kind == TokenKind.Pkg,
                            },
                        )
                    self.pending = []
                    self.pending_ats = []
                } else {
                    self.orphan_pending()
                }
            }
            self.line_has_token = true
            self.line_comment = false
            self.blank_run = false
        }
        // A hole is single-line: a newline inside one is the missing
        // `}`, said once, and lexing recovers to the enclosing body.
        if t.kind == TokenKind.Break && self.in_hole() {
            self.errors.push(hole_error(t.span.lo))
            self.left_holes()
        }
        let f: int? = self.open_hole_frame()
        if f == null {
            self.raw.push(t)
            return
        }
        mut fr = self.frames[f!]
        fr.current.push(t)
        self.frames.set(f!, fr)
    }

    /// The token just pushed, taken back — a name run that a hole
    /// continues.
    mut fn unpushed() {
        let f: int? = self.open_hole_frame()
        if f == null {
            let _ = self.raw.pop()
            return
        }
        mut fr = self.frames[f!]
        let _ = fr.current.pop()
        self.frames.set(f!, fr)
    }

    fn in_hole() -> bool {
        let top? = self.stack.last() else { return false }
        match top { .Body(_) -> false, .StrHole(_) or .QuoteHole(_, _) -> true }
    }

    /// Every open hole abandoned, down to the enclosing body.
    mut fn left_holes() {
        while self.in_hole() {
            let top = self.stack.pop()
            match top {
                .QuoteHole(f, _) -> self.dropped_hole(f),
                .Body(_) or .StrHole(_) -> nothing_noted(),
            }
        }
    }

    mut fn dropped_hole(f: int) {
        mut fr = self.frames[f]
        fr.assembling = false
        fr.current = []
        self.frames.set(f, fr)
    }

    /// A `//` comment marks its line; only a `///` at line start is a
    /// doc line, and only a blank line detaches a group. A leading
    /// run of `//!` lines — before anything else in the file — is the
    /// FILE's own doc; `file_doc_open` stays true only until the
    /// first thing that isn't one.
    mut fn noted_comment() {
        if !line_comment_at(self.src, self.n, self.i) { return }
        self.line_comment = true
        if self.line_has_token {
            // A TRAILING REMARK SHARES ITS LINE WITH CODE. It is kept
            // whole and by position like an own-line remark, marked
            // same-line so the printer appends it to the code it
            // trails instead of giving it a line of its own.
            self
                .remarks
                .push(
                    Remark {
                        trivia: Trivia.Comment(comment_line(self.src, self.n, self.i)),
                        at: self.i,
                        same_line: true,
                    },
                )
            self.file_doc_open = false
            return
        }
        if self.i + 2 < self.n && self.src.char_code(self.i + 2) == 33 && self.file_doc_open {
            // Recorded TWICE, deliberately: as a remark, byte-for-byte,
            // so the printer's round trip is untouched — and as
            // stripped content, so it answers a doc query. The two
            // paths must never merge into one: a remark's text is
            // exactly what was written, a doc line's is what it means.
            self.remarks.push(self.own_line_remark())
            self.file_pending.push(doc_line(self.src, self.n, self.i))
            return
        }
        self.file_doc_open = false
        if self.i + 2 < self.n && self.src.char_code(self.i + 2) == 47 {
            if self.pending.is_empty() { self.pending_at = self.i }
            self.pending.push(doc_line(self.src, self.n, self.i))
            self.pending_ats.push(self.i)
            return
        }
        // AN OWN-LINE REMARK IS KEPT WHOLE AND BY POSITION. It becomes
        // no token — a token would put a skip in every grammar rule —
        // and it is never dropped, so a comment with no statement
        // after it survives as much as one with.
        self.remarks.push(self.own_line_remark())
    }

    /// The current line, kept whole and by position — a `//`, `///`
    /// or `//!` comment that carries no other meaning at this site.
    fn own_line_remark() -> Remark {
        Remark { trivia: Trivia.Comment(comment_line(self.src, self.n, self.i)), at: self.i }
    }

    /// A `///` GROUP THAT NEVER REACHES A DECLARATION IS NOT
    /// DOCUMENTATION OF ANYTHING — kept whole, as the ordinary remarks
    /// it always could have been, one line per offset it was written
    /// at. Otherwise the group's lines join the file's every-`//`-line
    /// law only by an accident of where they land: attached, they
    /// print through `docs`; unattached, they were silently dropped.
    mut fn orphan_pending() {
        self.remarks = self
            .remarks
            .concat(
                [Remark { trivia: Trivia.Comment(comment_line(self.src, self.n, at)), at: at } for at in self.pending_ats],
            )
        self.pending = []
        self.pending_ats = []
    }

    /// What the input ended inside: an open hole or an open quote.
    mut fn closed_at_end() {
        if self.in_hole() { self.errors.push(hole_error(self.n)) }
        self.errors = self
            .errors
            .concat(
                [LexError {
                    message: if fr.raw { "a block is never closed" } else { "a `quote` block is never closed" },
                    span: span_of(fr.lo, self.n),
                } for fr in self.frames],
            )
    }
}

/// A match arm with nothing to do.
fn nothing_noted() {}

fn is_brace(t: Token) -> bool {
    t.kind == TokenKind.Op && (t.text == "{" || t.text == "}")
}

/// The index just past the string literal opening at `i` — the
/// closing quote, or the line's end when it never closes.
fn string_end(src: string, n: int, i: int) -> int {
    mut j = i + 1
    while j < n {
        let c = src.char_code(j)
        if c == 92 {
            j = j + 2
        } else if c == 34 {
            return j + 1
        } else if c == 10 {
            return j
        } else {
            j = j + 1
        }
    }
    j
}

/// The unclosed-hole complaint, at `at`.
fn hole_error(at: int) -> LexError {
    LexError { message: "an interpolation hole is missing its `}`", span: span_of(at, at) }
}

/// Grammar-DSL text: a line break survives only at a rule boundary;
/// quoted literals never interpolate.
export fn lex_grammar(src: string) -> LexResult {
    lex_with(src, rule_boundary, false)
}

/// Language source: every line break separates — except directly
/// inside `(` or `[` (a brace opened inside them separates again),
/// after a token that promises more (a binary operator, `=`, `->`,
/// a comma, a trailing `or`), before an `else`, `or` or `with`, and
/// before a `.name` line indented deeper than the line it continues
/// (a method chain; a match arm sits level with its siblings and
/// follows a `{`). Strings carry `${}` holes.
export fn lex_source(src: string) -> LexResult {
    lex_with(src, line_boundary, true)
}

/// Language source under the file's words: a sublanguage's word
/// before `{` opens a raw block, and a component's word opens an
/// instance. A word the file's OWN module declares (`named`) opens one
/// only where it names one — `word name {` or `word name` alone, at a
/// statement's start — since everywhere else in that module the name
/// is an ordinary one (a type, a literal's, a binding's).
export fn lex_blocks(
    src: string,
    words: List<string>,
    components: List<string>,
    named: List<string> = [],
    keywords: List<string> = [],
) -> LexResult {
    let lexed = lex_words(src, line_boundary, true, words, false)
    let ts = lexed.tokens
    lexed with { tokens: [if opens_instance(ts, i, components, named, keywords) {
        t with { kind: TokenKind.Component }
    } else if opens_env(ts, i, keywords) {
        t with { kind: TokenKind.Env }
    } else if opens_state(ts, i) {
        t with { kind: TokenKind.State }
    } else if opens_provide(ts, i) {
        t with { kind: TokenKind.Provide }
    } else if opens_on(ts, i) {
        t with { kind: TokenKind.On }
    } else {
        t
    } for i, t in ts] }
}

/// Whether the token at `i` is `provide` opening a provider — a SOFT
/// keyword: it means `provide` only in `provide NAME :`, at a
/// statement's start, so a fn, a package or a binding spelled
/// `provide` stays an ordinary name.
fn opens_provide(ts: List<Token>, i: int) -> bool {
    let t = ts[i]
    if t.kind != TokenKind.Name || t.text != "provide" { return false }
    if !starts_statement(ts, i) { return false }
    if i + 1 >= ts.length || ts[i + 1].kind != TokenKind.Name { return false }
    i + 2 < ts.length && ts[i + 2].lit_matches(":")
}

/// Whether the token at `i` is `env` reading the environment — a
/// SOFT keyword: it means `env` only before a WRITTEN TYPE, so a
/// binding, a field, a parameter or a call spelled `env` stays an
/// ordinary name. `env NAME` is the shape it claims, and the name
/// must not be a keyword, so `use @std.io.{env as e}` still imports
/// a binding called `env`; an instance head (`env Foo { … }`) is
/// claimed first, so a component word spelled `env` still opens its
/// instance.
fn opens_env(ts: List<Token>, i: int, keywords: List<string>) -> bool {
    let t = ts[i]
    if t.kind != TokenKind.Name || t.text != "env" { return false }
    if i + 1 >= ts.length || ts[i + 1].kind != TokenKind.Name { return false }
    !keywords.contains(ts[i + 1].text)
}

/// Whether the token at `i` is `state` opening a state declaration — a
/// SOFT keyword: it means `state` only where a binding follows, so a
/// binding, a field or a property called `state` stays an ordinary name.
/// `state NAME :` and `state NAME =` are the two shapes it claims, at a
/// statement's start or a parameter's own mark position.
fn opens_state(ts: List<Token>, i: int) -> bool {
    let t = ts[i]
    if t.kind != TokenKind.Name || t.text != "state" { return false }
    if !starts_statement(ts, i) && !after_param_sep(ts, i) { return false }
    if i + 1 >= ts.length || ts[i + 1].kind != TokenKind.Name { return false }
    i + 2 < ts.length && (ts[i + 2].lit_matches(":") || ts[i + 2].lit_matches("="))
}

/// Whether `i` stands where a parameter's mark does: right after the
/// list's `(` or a `,`. A parameter NAMED `state` writes `state :`,
/// so this shape claims only a mark before a binding.
fn after_param_sep(ts: List<Token>, i: int) -> bool {
    i > 0 && (ts[i - 1].lit_matches("(") || ts[i - 1].lit_matches(","))
}

/// Whether the token at `i` is `on` opening an instance's handler — a
/// SOFT keyword: it means `on` only before a NAME and a block, at a
/// statement's start, so `fn maybe(on: bool)` and `Row { on: true }`
/// stay ordinary names.
fn opens_on(ts: List<Token>, i: int) -> bool {
    let t = ts[i]
    if t.kind != TokenKind.Name || t.text != "on" { return false }
    if !starts_statement(ts, i) { return false }
    if i + 1 >= ts.length || ts[i + 1].kind != TokenKind.Name { return false }
    i + 2 < ts.length && ts[i + 2].lit_matches("{")
}

/// Whether the token at `i` is a component's word opening an instance.
fn opens_instance(
    ts: List<Token>,
    i: int,
    components: List<string>,
    named: List<string>,
    keywords: List<string>,
) -> bool {
    let t = ts[i]
    if t.kind != TokenKind.Name { return false }
    if components.contains(t.text) { return true }
    named.contains(t.text) && starts_statement(ts, i) && names_instance(ts, i + 1, keywords)
}

/// Whether nothing of a statement stands before `i` on its line.
fn starts_statement(ts: List<Token>, i: int) -> bool {
    i == 0 ||
        ts[i - 1].kind == TokenKind.Break ||
        ts[i - 1].lit_matches("export") ||
        ts[i - 1].lit_matches("{")
}

/// Whether `at` is an instance's name: a name no keyword spells, then
/// its block or the statement's end — a break, the file's, or the
/// enclosing block's `}`.
fn names_instance(ts: List<Token>, at: int, keywords: List<string>) -> bool {
    if at >= ts.length || ts[at].kind != TokenKind.Name || keywords.contains(ts[at].text) { return false }
    at + 1 >= ts.length || ends_instance_head(ts[at + 1])
}

/// Whether a token closes an instance's head: its block's `{`, or the
/// statement's end.
fn ends_instance_head(t: Token) -> bool {
    t.lit_matches("{") || t.lit_matches("}") || t.kind == TokenKind.Break || t.kind == TokenKind.Eof
}

/// A block's body re-lexed for its sublanguage's grammar: every
/// `${k}` is the Hole token it names, and a line break is nothing.
export fn lex_body(text: string) -> LexResult {
    lex_words(text, line_boundary, true, [], true)
}

/// A literal's text to its IEEE-754 bits — the compiler holds no
/// float of its own, so this is how one crosses it.
extern fn avra_float_bits(text: string) -> int

/// Whether a real fits a `float` — infinity is not the number written.
extern fn avra_float_fits(text: string) -> int

/// The source runs between holes: one run more than there are holes.
/// `begins` is each `${`'s opening token and `ends` its closing `}`'s,
/// in body order.
export fn runs(text: string, lo: int, hi: int, begins: List<Token>, ends: List<Token>) -> List<
    string,
> {
    let starts = [lo].concat([t.span.hi for t in ends])
    let stops = [t.span.lo for t in begins].concat([hi])
    [text.substring(starts[j], stops[j]) for j in 0..starts.length]
}

// ── The voices ──

fn unterminated_octets() -> string { "a byte string closes on its own line" }

fn bad_hex_escape() -> string { "`\\x` in a byte string takes two hex digits — `\\x00` through `\\xff`" }

fn unknown_octet_escape() -> string { "a byte string knows `\\\"`, `\\\\`, `\\n`, `\\t`, `\\r`, `\\0` and `\\xHH` — spell any other octet as `\\xHH`" }
