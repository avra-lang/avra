//! Grammar coherence: defects a grammar can carry that would otherwise
//! surface later as confusing parse failures. The executor refuses to
//! run a grammar with defects, so every check here is a guarantee the
//! matcher can lean on.

use core.{flatten, some_list}

/// The TokenKind a terminal name denotes, or null for an unknown name.
/// `END` is a statement's end — a Break consumed, or a `}` left for
/// the body that opened it — and answers to the Break class here.
export fn term_kind(term: string) -> TokenKind? {
    match term {
        "NAME" -> TokenKind.Name,
        "NUMBER" -> TokenKind.Num,
        "STRING" -> TokenKind.Str,
        "ISTR_BEGIN" -> TokenKind.IStrBegin,
        "ISTR_MID" -> TokenKind.IStrMid,
        "ISTR_END" -> TokenKind.IStrEnd,
        "BREAK" -> TokenKind.Break,
        "END" -> TokenKind.Break,
        "EOF" -> TokenKind.Eof,
        "PKG" -> TokenKind.Pkg,
        "HOLE" -> TokenKind.Hole,
        "HOLE_BEGIN" -> TokenKind.HoleBegin,
        "HOLE_END" -> TokenKind.HoleEnd,
        "BLOCK" -> TokenKind.Block,
        "COMPONENT" -> TokenKind.Component,
        "BODY" -> TokenKind.Body,
        _ -> null,
    }
}

impl Seq {
    /// This branch's capture labels, including those inside nested
    /// groups — capture accumulation makes them all visible to the
    /// build.
    fn labels() -> List<string> {
        flatten([some_list(m.label) for m in self.deep_items()])
    }
}

fn prim_defects(rule_name: string, p: Prim, names: List<string>, labeled: bool) -> List<Diagnostic> {
    match p {
        .Ref(target) -> if names.contains(target) {
            []
        } else {
            [defect(rule_name, "references undefined rule `${target}`")]
        },
        .Named(term) -> if term_kind(term) != null {
            []
        } else {
            [defect(rule_name, "unknown terminal `${term}`")]
        },
        .Lit(_) -> [],
        // A labeled group is consumed for its value; an unlabeled one
        // is structural (its value is Absent, its captures escape).
        .Group(inner) -> alt_defects(rule_name, inner, names, labeled),
    }
}

fn build_defects(rule_name: string, s: Seq, value_needed: bool) -> List<Diagnostic> {
    if s.build == null {
        if !value_needed || s.items.length == 1 { return [] }
        return [defect(rule_name, "a branch without a build must have exactly one item to pass through")]
    }
    let labels = s.labels()
    match s.build! {
        .Var(name) -> if labels.contains(name) {
            []
        } else {
            [defect(rule_name, "build returns uncaptured label `${name}`")]
        },
        .Call(_, args) -> [defect(rule_name, "build argument `${a}` is not captured in its branch") for a in args if !labels.contains(a)],
        // A node build's labels are checked against the NODE's
        // payloads, by whoever holds the node model — never here.
        .Node(_, _, _, _) -> [],
    }
}

fn alt_defects(rule_name: string, a: Alt, names: List<string>, value_needed: bool) -> List<Diagnostic> {
    flatten([seq_defects(rule_name, s, names, value_needed) for s in a.branches])
}

/// One branch's defects: its items', then its build's.
fn seq_defects(rule_name: string, s: Seq, names: List<string>, value_needed: bool) -> List<Diagnostic> {
    flatten([prim_defects(rule_name, m.prim, names, m.label != null) for m in s.items]).concat(build_defects(rule_name, s, value_needed))
}

impl Grammar {
    /// Every defect in this grammar; empty means the matcher's
    /// assumptions all hold.
    fn defects() -> List<Diagnostic> {
        let names = self.rules.map(it.name)
        mut out: List<Diagnostic> = []
        if !names.contains(self.start) {
            out.push(defect(self.start, "start rule is not defined"))
        }
        // The executor indexes rules by name; a duplicate would silently
        // shadow. Same-name rules must merge before a grammar runs.
        // LICENSED compiler.seen_accumulator: duplicate DETECTION across rules, not one list
        mut seen: List<string> = []
        for r in self.rules {
            if seen.contains(r.name) {
                out.push(defect(r.name, "declared more than once — merge same-name rules first"))
            } else {
                seen.push(r.name)
            }
        }
        out.concat(flatten([alt_defects(r.name, r.body, names, true) for r in self.rules])).concat(first_defects(self))
    }
}
