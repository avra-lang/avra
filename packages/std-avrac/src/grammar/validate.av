//! Grammar coherence: defects a grammar can carry that would otherwise
//! surface later as confusing parse failures. The executor refuses to
//! run a grammar with defects, so every check here is a guarantee the
//! matcher can lean on.

use core.{concat}

/// The TokenKind a terminal name denotes, or null for an unknown name.
export fn term_kind(term: string) -> TokenKind? {
    match term {
        "NAME" -> TokenKind.Name,
        "NUMBER" -> TokenKind.Num,
        "STRING" -> TokenKind.Str,
        "BREAK" -> TokenKind.Break,
        "EOF" -> TokenKind.Eof,
        _ -> null,
    }
}

impl Seq {
    /// This branch's capture labels, including those inside nested
    /// groups — capture accumulation makes them all visible to the
    /// build.
    fn labels(self) -> List<string> {
        mut out: List<string> = []
        for member in self.items {
            if member.label != null { out.push(member.label!) }
            for l in prim_labels(member.prim) { out.push(l) }
        }
        out
    }
}

fn prim_labels(p: Prim) -> List<string> {
    match p {
        .Group(inner) -> {
            mut out: List<string> = []
            for s in inner.branches { out = concat(out, s.labels()) }
            out
        }
        .Ref(_) or .Lit(_) or .Named(_) -> [],
    }
}

fn prim_defects(rule_name: string, p: Prim, names: List<string>, labeled: bool) -> List<Diagnostic> {
    match p {
        .Ref(target) ->
            if names.contains(target) { [] }
            else { [defect(rule_name, "references undefined rule `${target}`")] },
        .Named(term) ->
            if term_kind(term) != null { [] }
            else { [defect(rule_name, "unknown terminal `${term}`")] },
        .Lit(_) -> [],
        // A labeled group is consumed for its value; an unlabeled one
        // is structural (its value is Absent, its captures escape).
        .Group(inner) -> alt_defects(rule_name, inner, names, labeled),
    }
}

fn build_defects(rule_name: string, s: Seq, value_needed: bool) -> List<Diagnostic> {
    mut out: List<Diagnostic> = []
    let labels = s.labels()
    match s.build {
        null -> {
            if value_needed && s.items.length != 1 {
                out.push(defect(rule_name, "a branch without a build must have exactly one item to pass through"))
            }
        }
        let b -> match b {
            .Var(name) -> {
                if !labels.contains(name) {
                    out.push(defect(rule_name, "build returns uncaptured label `${name}`"))
                }
            }
            .Call(_, args) -> {
                for a in args {
                    if !labels.contains(a) {
                        out.push(defect(rule_name, "build argument `${a}` is not captured in its branch"))
                    }
                }
            }
        }
    }
    out
}

fn alt_defects(rule_name: string, a: Alt, names: List<string>, value_needed: bool) -> List<Diagnostic> {
    mut out: List<Diagnostic> = []
    for s in a.branches {
        for member in s.items {
            out = concat(out, prim_defects(rule_name, member.prim, names, member.label != null))
        }
        out = concat(out, build_defects(rule_name, s, value_needed))
    }
    out
}

impl Grammar {
    /// Every defect in this grammar; empty means the matcher's
    /// assumptions all hold.
    fn defects(self) -> List<Diagnostic> {
        let names = self.rules.map(it.name)
        mut out: List<Diagnostic> = []
        if !names.contains(self.start) {
            out.push(defect(self.start, "start rule is not defined"))
        }
        // The executor indexes rules by name; a duplicate would silently
        // shadow. Same-name rules must merge before a grammar runs.
        mut seen: List<string> = []
        for r in self.rules {
            if seen.contains(r.name) {
                out.push(defect(r.name, "declared more than once — merge same-name rules first"))
            } else {
                seen.push(r.name)
            }
        }
        for r in self.rules { out = concat(out, alt_defects(r.name, r.body, names, true)) }
        out
    }
}
