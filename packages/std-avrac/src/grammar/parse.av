//! `parse_grammar` — grammar text in, Grammar value out. The executor
//! running the data seed: no hand-written parser for the DSL exists.
//! bs2's `grammar { ... }` blocks desugar to a call of this function.
use core.{concat}

/// The parse outcome: the grammar when one was built (partial trees
/// included), plus every diagnostic — lexing, parsing, and the built
/// grammar's own coherence defects, in that order.
export type GrammarParse = { grammar: Grammar?, diagnostics: List<Diagnostic> }

/// Parse DSL text. The grammar's name is its start rule's name.
export fn parse_grammar(source: string) -> GrammarParse {
    let lexed = lex_grammar(source)
    mut diagnostics = [lex_diagnostic(e) for e in lexed.errors]
    let o = run_grammar<GrammarNode>(grammar_of_grammars(), lexed.tokens, grammar_build)
    diagnostics = concat(diagnostics, o.diagnostics)
    let g: Grammar? = grammar_result(o)
    match g {
        null -> GrammarParse { grammar: null, diagnostics: diagnostics },
        let gr -> {
            let named_g = gr with { name: gr.start }
            GrammarParse { grammar: named_g, diagnostics: concat(diagnostics, named_g.defects()) }
        }
    }
}
