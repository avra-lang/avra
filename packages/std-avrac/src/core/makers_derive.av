//! `@derive(Makes)` — a flat node's MAKERS, read off the declaration. A
//! variant whose every payload has a `Slots` accessor gets one fn that
//! builds it from its labels and one `Maker` row naming that fn. A
//! payload that declares a default takes it where the rule leaves its
//! label out. A variant with a payload no accessor reads is not made;
//! it keeps its own builder.
//!
//! It stands ALONE in this file on purpose (CLAUDE.md): running a derive
//! TYPES the file that declares it.
use @std.meta.{Type as MetaType, Variant as MetaVariant, Field, Directive, Code, literal, name}

/// The compiler's derive for a node enum's makers.
export trait Makes {
    static fn derive(t: MetaType) -> List<Directive> {
        [
            Directive {
                twin: "",
                name: t.name,
                at: t.at,
                source: quote {
            export fn ${"makers_${t.name}"}() -> List<Maker<${t}>> {
                ${as_list_expr([maker_row(t, v) for v in t.variants.filter(makeable(it))])}
            }
        },
            },
        ]
            .concat([made(t, v) for v in t.variants.filter(makeable(it))])
    }

    /// The mark a facet rides: the maker reads it, so a `@facet` field
    /// reaches the payload's writer.
    static fn marks(t: MetaType) -> List<string> { [facet_word] }
}

/// A variant is made when every payload is one a `Slots` accessor reads
/// and every default it declares crossed.
fn makeable(v: MetaVariant) -> bool {
    v.fields.all(known(it) && crossed(it))
}

/// A declared default is readable when it crossed as code.
fn crossed(f: Field) -> bool {
    !f.defaulted || f.default != null
}

/// The payload types a `Slots` accessor reads.
fn known(f: Field) -> bool {
    [
        "ExprId",
        "ExprId?",
        "List<ExprId>",
        "List<StmtId>",
        "List<PatId>",
        "List<Param>",
        "List<Arm>",
        "List<Case>",
        "List<Plain>",
        "List<Variant>",
        "List<TypeRef>",
        "TypeRef",
        "TypeRef?",
        "Scoped",
        "Scoped?",
        "Plain",
        "string",
        "bool",
        "BinOp",
    ]
        .contains(f.ty)
}

/// The name of a variant's maker fn.
fn made_name(t: MetaType, v: MetaVariant) -> string {
    "make_${t.name}_${v.name}"
}

/// One variant's row in the registry.
fn maker_row(t: MetaType, v: MetaVariant) -> Code {
    quote { Maker { name: ${literal(v.name)}, make: ${name(made_name(t, v))} } }
}

/// One variant's maker fn: the variant built from its payloads' labels.
fn made(t: MetaType, v: MetaVariant) -> Directive {
    Directive {
        twin: "",
        name: t.name,
        at: t.at,
        source: quote {
            fn ${made_name(t, v)}(s: dyn Slots) -> Result<${t}, string> {
                ${construction(v)}
            }
        },
    }
}

/// The variant's constructor, its payloads read by label. A `@facet`
/// field is not among them: its value left the payload for a side
/// table the builder writes, keyed by the node it just made.
fn construction(v: MetaVariant) -> Code {
    let args = [slot(f) for f in v.fields if carried(f)]
    if args.is_empty() { return quote { .Ok(.${v}) } }
    quote { .Ok(.${v}(${..args})) }
}

/// One payload's value: its read, or its declared default when the rule
/// writes nothing under the label.
fn slot(f: Field) -> Code {
    let fallback? = f.default else { return read(f) }
    quote { if s.present_of(${literal(f.name)})? { ${read(f)} } else { ${fallback} } }
}

/// One payload's read: the `Slots` accessor its type names, by its label.
fn read(f: Field) -> Code {
    match f.ty {
        "ExprId" -> quote { s.expr_of(${literal(f.name)})? },
        "List<ExprId>" -> quote { s.exprs_of(${literal(f.name)})? },
        "ExprId?" -> quote { s.expr_opt_of(${literal(f.name)})? },
        "List<StmtId>" -> quote { s.stmts_of(${literal(f.name)})? },
        "List<Param>" -> quote { s.params_of(${literal(f.name)})? },
        "List<Arm>" -> quote { s.arms_of(${literal(f.name)})? },
        "List<Case>" -> quote { s.cases_of(${literal(f.name)})? },
        "List<Variant>" -> quote { s.variants_of(${literal(f.name)})? },
        "List<Plain>" -> quote { [Plain(t) for t in s.texts_of(${literal(f.name)})?] },
        "Scoped?" -> quote { s.scoped_opt_of(${literal(f.name)})? },
        "List<PatId>" -> quote { s.pats_of(${literal(f.name)})? },
        "List<TypeRef>" -> quote { s.types_of(${literal(f.name)})? },
        "TypeRef" -> quote { s.type_of(${literal(f.name)})? },
        "Scoped" or "Plain" -> quote { ${f.ty}(s.text_of(${literal(f.name)})?) },
        "TypeRef?" -> quote { s.type_opt_of(${literal(f.name)})? },
        "string" -> quote { s.text_of(${literal(f.name)})? },
        "BinOp" -> quote { s.op_of(${literal(f.name)})? },
        _ -> quote { s.flag_of(${literal(f.name)})? },
    }
}

/// The parts as ONE list expression — each part an element, folded.
fn as_list_expr(parts: List<Code>) -> Code {
    if parts.is_empty() { return quote { [] } }
    mut all = quote { [${parts[0]}] }
    for p in parts.slice(1, parts.length) {
        let sofar = all
        all = quote { ${sofar}.concat([${p}]) }
    }
    all
}
