//! Byte-level (ASCII) character classification — shared by every
//! scanner in the compiler.

/// Codepoint value at byte index `i`.
export fn code_at(s: string, i: int) -> int {
    s.substring(i, i + 1).char_code()
}

/// Space, tab, or carriage return — never newline (that is layout).
export fn is_space(c: int) -> bool { c == 32 || c == 9 || c == 13 }

/// A letter or `_`.
export fn is_name_start(c: int) -> bool {
    (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

/// A letter, digit, or `_`.
export fn is_name_cont(c: int) -> bool {
    is_name_start(c) || is_digit(c)
}

/// An ASCII digit.
export fn is_digit(c: int) -> bool { c >= 48 && c <= 57 }

/// An uppercase letter, digit, or `_`.
export fn is_upper_name_cont(c: int) -> bool {
    (c >= 65 && c <= 90) || c == 95 || is_digit(c)
}

/// A string as SOURCE spells it, quotes included — the inverse of
/// the lexer's unescape, so what a renderer prints reads back as
/// the same text.
export fn quoted_text(s: string) -> string {
    mut out = "\""
    let n = s.length
    mut i = 0
    while i < n {
        out = out + escaped_char(code_at(s, i), s.substring(i, i + 1))
        i = i + 1
    }
    out + "\""
}

/// One character as source spells it.
fn escaped_char(c: int, raw: string) -> string {
    when {
        c == 34 -> "\\\""
        c == 92 -> "\\\\"
        c == 10 -> "\\n"
        c == 9 -> "\\t"
        c == 13 -> "\\r"
        _ -> raw
    }
}
