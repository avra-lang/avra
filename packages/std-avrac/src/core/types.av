//! The type currency: opaque ids, interned shapes, one registry.
//! Core because every layer above speaks it — features implement
//! typing semantics against these, the driver owns the pass.

/// Opaque handle into the registry: compared and looked up, never
/// inspected. Text exists only in the registry's printing projection.
export type TypeId = { index: int }

/// A type's shape. Interned once; identity is the id — composites
/// carry their children as interned ids, so equality stays an int
/// comparison at every depth.
export enum Type {
    Int
    Str
    Bool
    /// The first composite: a homogeneous aggregate.
    List(elem: TypeId)
    /// A declared record — NOMINAL: the declaration site is the
    /// identity, the name rides along for printing alone.
    Struct(decl: StmtId, name: string)
    /// A declared enum's VALUE — nominal like a struct; a tagged
    /// slot array at runtime.
    Enum(decl: StmtId, name: string)
    /// A type used as a VALUE (`Color` in `Color.red`) — the only
    /// compile-only shape: no runtime value ever has it, so every
    /// operand law and the answer projection refuse it.
    TypeName(decl: StmtId, name: string)
    /// `T?` — a value that may be ABSENT. Nullability is opt-in
    /// (spec Axis 10.2), so every other shape is a guarantee.
    Opt(inner: TypeId)
    /// The `null` literal's own type: it inhabits every `Opt` and
    /// nothing else, which is what makes `let x: int = null` refuse.
    Null
    Error
}

/// The interner: shapes in, ids out — assigned once, compared as
/// ints forever. The index map is keyed by each shape's CANONICAL
/// form — deterministic structural content, children by interned id —
/// which is exactly what content-addressing later hashes: the key
/// derivation swaps, the map and its callers do not.
export type TypeRegistry = { shapes: List<Type>, ids: Map<string, TypeId> }

export fn new_type_registry() -> TypeRegistry {
    TypeRegistry { shapes: [], ids: {} }
}

/// A heap-shaped value: it rides POINTERS, and it waits on
/// ownership analysis wherever mutation or management is concerned.
/// Exhaustive on purpose — a new shape must decide, consciously.
/// A bare shape cannot see what an `Opt` carries, so it answers
/// pointer; the registry's `rides_pointer` is the carried-aware
/// truth the machine projections ask.
export fn ptr_shape(t: Type) -> bool {
    match t {
        .Str or .List(_) or .Struct(_, _) or .Enum(_, _) or .Opt(_) or .Null -> true,
        .Int or .Bool or .Error or .TypeName(_, _) -> false,
    }
}

impl TypeRegistry {
    /// A shape's canonical key: variant ordinal, then child ids as
    /// payload shapes arrive. Structural — never the printed name.
    fn canon(self, t: Type) -> string {
        match t {
            .Int -> "0",
            .Error -> "1",
            .Str -> "2",
            .Bool -> "3",
            .List(elem) -> "4:${elem.index}",
            .Struct(decl, _) -> "5:${decl.index}",
            .Enum(decl, _) -> "6:${decl.index}",
            .TypeName(decl, _) -> "7:${decl.index}",
            .Opt(inner) -> "8:${inner.index}",
            .Null -> "9",
        }
    }

    /// The id for a shape, minted on first sight — one map probe.
    fn intern(self, t: Type) -> TypeId {
        let key = self.canon(t)
        let hit: TypeId? = self.ids.get(key)
        if hit != null { return hit! }
        mut shapes = self.shapes
        shapes.push(t)
        let id = TypeId { index: shapes.length - 1 }
        mut ids = self.ids
        ids.set(key, id)
        id
    }

    fn shape_of(self, id: TypeId) -> Type { self.shapes[id.index] }

    /// What a nullable carries, or absent when the id is not one —
    /// THE projection. (checks.av's `opt_inner` and values.av's
    /// `carried_type` are its cx-space mirrors: capability closures
    /// cannot reach the registry, so each vocabulary keeps one.)
    fn carried(self, id: TypeId) -> TypeId? {
        match self.shape_of(id) {
            .Opt(inner) -> inner,
            _ -> null,
        }
    }

    /// Does a value of this type RIDE A POINTER at runtime —
    /// `ptr_shape` with `Opt` answering as what it CARRIES: a niche
    /// nullable IS its pointer, a scalar pair is registers and no
    /// pointer at all. The machine projections ask here.
    fn rides_pointer(self, id: TypeId) -> bool {
        match self.shape_of(id) {
            .Opt(inner) -> self.rides_pointer(inner),
            _ -> ptr_shape(self.shape_of(id)),
        }
    }

    /// The printing projection — the ONLY place a type becomes text.
    fn name_of(self, id: TypeId) -> string {
        match self.shape_of(id) {
            .Int -> "int",
            .Str -> "string",
            .Bool -> "bool",
            .List(elem) -> "List<${self.name_of(elem)}>",
            .Struct(_, name) -> name,
            .Enum(_, name) -> name,
            .TypeName(_, name) -> "type ${name}",
            .Opt(inner) -> "${self.name_of(inner)}?",
            .Null -> "null",
            .Error -> "<error>",
        }
    }
}

