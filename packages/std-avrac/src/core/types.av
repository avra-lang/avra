//! The type currency: opaque ids, interned shapes, one registry.
//! Core because every layer above speaks it — features implement
//! typing semantics against these, the driver owns the pass.

/// Opaque handle into the registry: compared and looked up, never
/// inspected. Text exists only in the registry's printing projection.
export type TypeId = { index: int }

/// A type's shape. Interned once; identity is the id — composites
/// carry their children as interned ids, so equality stays an int
/// comparison at every depth.
export enum Type {
    // ── The words: one unmanaged register each. ──
    Int
    Bool
    /// Text — the first MANAGED value: a registered pointer the
    /// ownership registry reclaims at count zero.
    Str
    /// An opaque host pointer — what an extern fn passes and answers;
    /// nothing reads through it.
    Ptr

    // ── The declared boxes — NOMINAL: the declaration site is the
    // identity, the name rides along for printing alone. ──
    /// A record: a slot array at runtime.
    Struct(decl: DeclId, name: string)
    /// An enum's VALUE: a tagged slot array at runtime.
    Enum(decl: DeclId, name: string)
    /// A USER generic declaration INSTANTIATED — nominal by its
    /// decl, interned by its arguments (the List/Opt/Res precedent
    /// generalized to declared names). The declared field/variant
    /// tables keep their Vars; `fields_of`/`variants_of` answer
    /// them substituted. A tagged/slot box at runtime, like the
    /// plain declaration it instantiates.
    App(decl: DeclId, name: string, args: List<TypeId>)
    /// `dyn Trait` — a value known only by its CONTRACT: a box of
    /// the value and its methods (spec 5.x, the heterogeneity
    /// hatch — dispatch cost made visible, P7). Nominal to the
    /// trait's declaration.
    Dyn(decl: DeclId, name: string)

    // ── The built-in boxes — STRUCTURAL: interned by their parts. ──
    /// A homogeneous aggregate.
    List(elem: TypeId)
    /// A string-keyed, insertion-ordered map — order is BY DESIGN,
    /// so iterating one never needs a rule. Other key types are
    /// recorded.
    Map(key: TypeId, value: TypeId)
    /// `Result<T, E>` — an answer OR a failure. A BUILT-IN enum
    /// (variants `Ok`/`Err`), interned by its sides, no generics
    /// involved. A tagged slot array at runtime, exactly an enum's
    /// layout — which is why the enum machinery serves it whole.
    Res(ok: TypeId, err: TypeId)
    /// A FN VALUE — `fn(int) -> bool`: what a lambda or a named fn
    /// wears. The runtime shape is a box `[code address,
    /// captures…]`; a call rides CallPtr with the box at seat 0.
    Fn(params: List<TypeId>, ret: TypeId)
    /// The answer of a mutation — a value that is nothing. Spec 4.2.
    Void

    // ── Absence, and the values that inhabit it. ──
    /// `T?` — a value that may be ABSENT. Nullability is opt-in
    /// (spec Axis 10.2), so every other shape is a guarantee.
    Opt(inner: TypeId)
    /// The `null` literal's own type: it inhabits every `Opt` and
    /// nothing else, which is what makes `let x: int = null` refuse.
    Null
    /// The empty list literal's own type — `[]` is to `List` what
    /// `null` is to `Opt`: it inhabits every `List<T>` and nothing
    /// else, adopted at the one widening edge. The value needs no
    /// lift: an empty array IS a valid list of anything.
    EmptyList
    /// The empty map literal's own type — `{}` is to `Map` what `[]`
    /// is to `List`: adopted at the one widening edge, no lift.
    EmptyMap

    // ── Compile-only: no runtime value ever wears these. ──
    /// A type used as a VALUE (`Color` in `Color.red`): every
    /// operand law and the answer projection refuse it.
    TypeName(decl: DeclId, name: string)
    /// A generic fn's TYPE PARAMETER — nominal to its declaration
    /// site, by ordinal (`fn f<A, B>` interns Var(f, 0) and
    /// Var(f, 1); the name rides for printing). Abstract: a value
    /// of this type can only MOVE, and mono guarantees no register
    /// is ever minted wearing it.
    Var(decl: DeclId, ordinal: int, name: string)

    /// The absorber: laws already spoke; downstream stays quiet.
    Error
}

/// The interner: shapes in, ids out — assigned once, compared as
/// ints forever. The index map is keyed by each shape's CANONICAL
/// form — deterministic structural content, children by interned id —
/// which is exactly what content-addressing later hashes: the key
/// derivation swaps, the map and its callers do not.
export type TypeRegistry = { shapes: List<Type>, ids: Map<string, TypeId>, flats: List<List<TypeId>> }

export fn new_type_registry() -> TypeRegistry {
    TypeRegistry { shapes: [], ids: {}, flats: [] }
}

/// A heap-shaped value: it rides POINTERS, and it waits on
/// ownership analysis wherever mutation or management is concerned.
/// Exhaustive on purpose — a new shape must decide, consciously.
/// A bare shape cannot see what an `Opt` carries, so it answers
/// pointer; the registry's `rides_pointer` is the carried-aware
/// truth the machine projections ask.
export fn ptr_shape(t: Type) -> bool {
    match t {
        .Str or .Ptr or .List(_) or .Struct(_, _) or .Enum(_, _) or .Opt(_) or
        .Res(_, _) or .App(_, _, _) or .Dyn(_, _) or .Fn(_, _) or .Null or .EmptyList or
        .Map(_, _) or .EmptyMap -> true,
        .Int or .Bool or .Error or .TypeName(_, _) or .Var(_, _, _) or .Void -> false,
    }
}

impl TypeRegistry {
    /// A shape's canonical key: variant ordinal, then child ids as
    /// payload shapes arrive. Structural — never the printed name.
    fn canon(self, t: Type) -> string {
        match t {
            .Int -> "0",
            .Ptr -> "ptr",
            .Error -> "1",
            .Str -> "2",
            .Bool -> "3",
            .List(elem) -> "4:${elem.index}",
            .Struct(decl, _) -> "5:${decl.index}",
            .Enum(decl, _) -> "6:${decl.index}",
            .TypeName(decl, _) -> "7:${decl.index}",
            .Opt(inner) -> "8:${inner.index}",
            .Null -> "9",
            .EmptyList -> "13",
            .Map(k, v) -> "17:${k.index}.${v.index}",
            .EmptyMap -> "18",
            .Res(ok, err) -> "10:${ok.index}.${err.index}",
            .Var(decl, ordinal, _) -> "11:${decl.index}.${ordinal}",
            .App(decl, _, args) -> "12:${decl.index}.${joined(["${a.index}" for a in args], ".")}",
            .Dyn(decl, _) -> "14:${decl.index}",
            .Fn(params, ret) -> "15:${joined(["${a.index}" for a in params], ".")}:${ret.index}",
            .Void -> "16",
        }
    }

    /// The id for a shape, minted on first sight — one map probe.
    fn intern(self, t: Type) -> TypeId {
        let key = self.canon(t)
        let hit: TypeId? = self.ids.get(key)
        if hit != null { return hit! }
        self.shapes.push(t)
        // the flat table runs PARALLEL to the shapes: every type has
        // a row, and only a declared record of scalars fills one
        let unflat: List<TypeId> = []
        self.flats.push(unflat)
        let id = TypeId { index: self.shapes.length - 1 }
        self.ids.set(key, id)
        id
    }

    fn shape_of(self, id: TypeId) -> Type { self.shapes[id.index] }

    /// A FLAT record's fields, in slot order — a record of scalars
    /// alone, which rides REGISTERS and is never a heap box. Empty
    /// for every other type; the flat ones are marked at
    /// declaration, where the fields are known.
    fn flat_fields(self, id: TypeId) -> List<TypeId> { self.flats[id.index] }

    /// The flat table can LAG the shapes — a substituted type is
    /// interned by a registry the marking never reached — so a row
    /// past its end is simply "not flat", never a trap.
    fn is_flat(self, id: TypeId) -> bool {
        id.index < self.flats.length && !self.flats[id.index].is_empty()
    }

    /// Whether a NULLABLE of `inner` rides a pointer — the question
    /// the slot law and the machine type ask. A flat record answers
    /// YES though the bare record answers no: its nullable is a
    /// one-slot box, because a word has no spare value for absence.
    fn opt_rides_pointer(self, inner: TypeId) -> bool {
        self.rides_pointer(inner) || self.is_flat(inner)
    }

    /// Mark a declared record flat. Its fields hold no reference, so
    /// nothing counts them and nothing frees them: the value IS its
    /// fields.
    fn mark_flat(self, id: TypeId, fields: List<TypeId>) {
        mut fs = self.flats
        fs.set(id.index, fields)
    }

    /// What a nullable carries, or absent when the id is not one —
    /// THE projection (values.av's `carried_type` is its cx-space
    /// mirror).
    fn carried(self, id: TypeId) -> TypeId? {
        match self.shape_of(id) {
            .Opt(inner) -> inner,
            _ -> null,
        }
    }

    /// A list's element, or absent when the id is not one — the
    /// projection every walk and index reads.
    fn element(self, id: TypeId) -> TypeId? {
        match self.shape_of(id) {
            .List(t) -> t,
            _ -> null,
        }
    }

    /// A Result's two sides, or absent when the id is not one —
    /// `carried`'s twin for the failure channel.
    fn res_parts(self, id: TypeId) -> ResSides? {
        match self.shape_of(id) {
            .Res(ok, err) -> ResSides { ok: ok, err: err },
            _ -> null,
        }
    }

    /// A fn type's seats and answer — res_parts' twin.
    fn arrow_parts(self, id: TypeId) -> Arrow? {
        match self.shape_of(id) {
            .Fn(params, ret) -> Arrow { seats: params, answer: ret },
            _ -> null,
        }
    }

    /// Does a value of this type RIDE A POINTER at runtime —
    /// `ptr_shape` with `Opt` answering as what it CARRIES: a niche
    /// nullable IS its pointer, a scalar pair is registers and no
    /// pointer at all. The machine projections ask here.
    fn rides_pointer(self, id: TypeId) -> bool {
        // a FLAT record is a machine word — its NULLABLE is the box,
        // and `opt_rides_pointer` is the question that asks about it
        if self.is_flat(id) { return false }
        match self.shape_of(id) {
            // a nullable answers as ITS OWN machine form: a flat
            // record's nullable is the box, though the record is not
            .Opt(inner) -> self.opt_rides_pointer(inner),
            _ -> ptr_shape(self.shape_of(id)),
        }
    }

    /// `ty` with the TARGET fn's Vars replaced by `args`, by
    /// ordinal — THE substitution, recursive through every
    /// composite. Another fn's Vars pass through untouched.
    fn substituted(self, ty: TypeId, target: DeclId, args: List<TypeId>) -> TypeId {
        match self.shape_of(ty) {
            // LICENSED I9: DECLARATION identity, not type agreement — whose Var this is
            .Var(decl, j, _) ->
                if decl.index == target.index { args[j] } else { ty },
            .List(elem) -> self.intern(Type.List(self.substituted(elem, target, args))),
            .Map(k, v) -> self.intern(Type.Map(self.substituted(k, target, args), self.substituted(v, target, args))),
            .Opt(inner) -> self.intern(Type.Opt(self.substituted(inner, target, args))),
            .Res(ok, err) -> self.intern(Type.Res(self.substituted(ok, target, args),
                                                  self.substituted(err, target, args))),
            .App(decl, name, aa) ->
                self.intern(Type.App(decl, name, [self.substituted(a, target, args) for a in aa])),
            .Fn(ps, ret) ->
                self.intern(Type.Fn([self.substituted(a, target, args) for a in ps],
                                    self.substituted(ret, target, args))),
            .Ptr or .Int or .Str or .Bool or .Struct(_, _) or .Enum(_, _) or
            .TypeName(_, _) or .Dyn(_, _) or .Null or .EmptyList or .Error or .Void or .EmptyMap -> ty,
        }
    }

    /// The printing projection — the ONLY place a type becomes text.
    fn name_of(self, id: TypeId) -> string {
        match self.shape_of(id) {
            .Int -> "int",
            .Ptr -> "ptr",
            .Str -> "string",
            .Bool -> "bool",
            .List(elem) -> "List<${self.name_of(elem)}>",
            .Struct(_, name) -> name,
            .Dyn(_, name) -> "dyn ${name}",
            .Fn(params, ret) -> "fn(${joined([self.name_of(a) for a in params], ", ")})${self.answer_word(ret)}",
            .Void -> "void",
            .Enum(_, name) -> name,
            .TypeName(_, name) -> "type ${name}",
            .Opt(inner) -> "${self.name_of(inner)}?",
            .Res(ok, err) -> "Result<${self.name_of(ok)}, ${self.name_of(err)}>",
            .Var(_, _, name) -> name,
            .App(_, name, args) -> "${name}<${joined([self.name_of(a) for a in args], ", ")}>",
            .Null -> "null",
            .EmptyList -> "[]",
            .Map(k, v) -> "Map<${self.name_of(k)}, ${self.name_of(v)}>",
            .EmptyMap -> "{}",
            .Error -> "<error>",
        }
    }

    /// A type's arguments, positionally — what its declaration's
    /// parameters were bound to; nothing for a type without any.
    fn args_of(self, id: TypeId) -> List<TypeId> {
        match self.shape_of(id) {
            .App(_, _, args) -> args,
            .Res(ok, err) -> [ok, err],
            .List(t) -> [t],
            .Map(k, v) -> [k, v],
            .Opt(t) -> [t],
            .Ptr or .Int or .Str or .Bool or .Struct(_, _) or .Enum(_, _) or .TypeName(_, _) or .Var(_, _, _) or
            .Dyn(_, _) or .Fn(_, _) or .Null or .EmptyList or .Error or .Void or .EmptyMap -> [],
        }
    }

    /// A fn type's written answer — nothing when it answers `void`.
    fn answer_word(self, ret: TypeId) -> string {
        if self.shape_of(ret) is .Void { return "" }
        " -> ${self.name_of(ret)}"
    }
}


/// What a `Result` carries on each side — res_parts' answer.
export type ResSides = { ok: TypeId, err: TypeId }

/// What a fn type promises — arrow_parts' answer.
export type Arrow = { seats: List<TypeId>, answer: TypeId }
