//! The type currency: opaque ids, interned shapes, one registry.
//! Core because every layer above speaks it — features implement
//! typing semantics against these, the driver owns the pass.
use @std.meta.{derive, identity}

/// Opaque handle into the registry: compared and looked up, never
/// inspected. Text exists only in the registry's printing projection.
@derive(Fingerprint)
export type TypeId = { index: int }

/// Type identity — two ids name one type when their indexes agree.
export fn same_type(a: TypeId, b: TypeId) -> bool {
    // LICENSED structs.index_compared: type identity, not type agreement — ids compare by index
    a.index == b.index
}

/// A type's shape. Interned once; identity is the id — composites
/// carry their children as interned ids, so equality stays an int
/// comparison at every depth.
export enum Type {
    // ── The words: one unmanaged register each. ──
    Int
    /// A binary64 real. THE VALUE IS THE MACHINE'S, not a decimal:
    /// `0.1 + 0.2` is not `0.3` and no amount of wishing changes it.
    /// A money column wants `decimal`, which is core's and arrives
    /// with the ORM.
    Float
    Bool
    /// Text — the first MANAGED value: a headered box the runtime
    /// reclaims at count zero.
    Str
    /// Octets — the second managed value: a box of its own kind whose
    /// header length is the length, with no terminator anyone reads.
    Bytes
    /// An opaque host pointer — what an extern fn passes and answers;
    /// nothing reads through it.
    Ptr

    // ── The declared boxes — NOMINAL: the declaration site is the
    // identity, the name rides along for printing alone. ──
    /// A record: a slot array at runtime.
    Struct(decl: DeclId, name: string)
    /// An enum's VALUE: a tagged slot array at runtime.
    Enum(decl: DeclId, name: string)
    /// A USER generic declaration INSTANTIATED — nominal by its
    /// decl, interned by its arguments (the List/Opt/Res precedent
    /// generalized to declared names). The declared field/variant
    /// tables keep their Vars; `fields_of`/`variants_of` answer
    /// them substituted. A tagged/slot box at runtime, like the
    /// plain declaration it instantiates.
    App(decl: DeclId, name: string, args: List<TypeId>)
    /// `dyn Trait` — a value known only by its CONTRACT: a box of
    /// the value and its methods (spec 5.x, the heterogeneity
    /// hatch — dispatch cost made visible, P7). Nominal to the
    /// trait's declaration.
    Dyn(decl: DeclId, name: string)

    // ── The built-in boxes — STRUCTURAL: interned by their parts. ──
    /// A homogeneous aggregate.
    List(elem: TypeId)
    /// Explicit shared interior mutability. Copies share one slot;
    /// `get` reads a value snapshot and `set` replaces the shared slot.
    Cell(inner: TypeId)
    /// A running task's handle: its answer, once it has one (`.await`).
    /// Joined when its last owner's scope ends; never outlives it.
    Task(answer: TypeId)
    /// An owner of tasks whose answers nobody reads: each finished one
    /// leaves it unseen, and the rest are joined where it ends.
    Tasks
    /// A string-keyed, insertion-ordered map — order is BY DESIGN,
    /// so iterating one never needs a rule. Other key types are
    /// recorded.
    Map(key: TypeId, value: TypeId)
    /// `Result<T, E>` — an answer OR a failure. A BUILT-IN enum
    /// (variants `Ok`/`Err`), interned by its sides, no generics
    /// involved. A tagged slot array at runtime, exactly an enum's
    /// layout — which is why the enum machinery serves it whole.
    Res(ok: TypeId, err: TypeId)
    /// A FN VALUE — `fn(int) -> bool`: what a lambda or a named fn
    /// wears. The runtime shape is a box `[code address,
    /// captures…]`; a call rides CallPtr with the box at seat 0.
    /// A fn as a VALUE. `marks` carries each seat's CONTRACT — the
    /// seats the callee writes through, and the seats it demands be
    /// settled at compile time. A fn's contract travels with its
    /// type, so a writing or const-demanding fn cannot sit in a seat
    /// that promised neither.
    Fn(params: List<TypeId>, marks: List<SeatMark>, ret: TypeId)
    /// The answer of a mutation — a value that is nothing. Spec 4.2.
    Void

    // ── Absence, and the values that inhabit it. ──
    /// `T?` — a value that may be ABSENT. Nullability is opt-in
    /// (spec Axis 10.2), so every other shape is a guarantee.
    Opt(inner: TypeId)
    /// The `null` literal's own type: it inhabits every `Opt` and
    /// nothing else, which is what makes `let x: int = null` refuse.
    Null
    /// The empty list literal's own type — `[]` is to `List` what
    /// `null` is to `Opt`: it inhabits every `List<T>` and nothing
    /// else, adopted at the one widening edge. The value needs no
    /// lift: an empty array IS a valid list of anything.
    EmptyList
    /// The empty map literal's own type — `{}` is to `Map` what `[]`
    /// is to `List`: adopted at the one widening edge, no lift.
    EmptyMap

    // ── Compile-only: no runtime value ever wears these. ──
    /// A type used as a VALUE (`Color` in `Color.red`): every
    /// operand law and the answer projection refuse it.
    TypeName(decl: DeclId, name: string)
    /// A generic fn's TYPE PARAMETER — nominal to its declaration
    /// site, by ordinal (`fn f<A, B>` interns Var(f, 0) and
    /// Var(f, 1); the name rides for printing). Abstract: a value
    /// of this type can only MOVE, and mono guarantees no register
    /// is ever minted wearing it.
    Var(decl: DeclId, ordinal: int, name: string)

    /// `A or B` — a CLOSED set of declared types, any one of which a
    /// value may be. Structural, like `List`/`Map`/`Res`: interned by
    /// its members, SORTED and DEDUPED so `A or B` and `B or A` are
    /// one type. `union_of` is the only door — a member list built any
    /// other way may fail to be canonical. Always boxed: a value's
    /// own member is not enough to tell it apart at runtime, so it
    /// carries a discriminant no bare member does.
    Union(members: List<TypeId>)

    /// The absorber: laws already spoke; downstream stays quiet.
    Error
    /// `(lo..hi)` — a counting range of ints: its two bounds in one
    /// box. Its own identity so a method row can name a range
    /// receiver without a string tag.
    Range
}

/// A type as a program SPELLS it — what `v.type(List<string?>)`
/// expands to, one value the receiver's `interned` folds to an id.
/// Structural shapes only: a declared name has no spelling here,
/// its id is a binding named in the literal (`Id`).
export enum TypeLit {
    Int
    Float
    Bool
    Str
    Bytes
    Ptr
    Void
    Opt(inner: TypeLit)
    List(elem: TypeLit)
    Cell(inner: TypeLit)
    Map(key: TypeLit, value: TypeLit)
    Res(ok: TypeLit, err: TypeLit)
    /// The spelling keeps the grammar's two marks apart — they are
    /// written as separate words — and `interned` zips them into the
    /// one `SeatMark` currency. A spelling, never an identity.
    Fn(params: List<TypeLit>, muts: List<bool>, consts: List<bool>, ret: TypeLit)
    /// A hole: an id already in hand, named in the literal.
    Id(id: TypeId)
}

/// A type's REPRESENTATION row: the fields it IS when flat, whether
/// an impl SEALED it boxed, and the shape a NAMED type stands for.
/// A record's declaration and its impl block are ordered only by
/// demand — two memoized queries, possibly in different files — so
/// the sealed answer is STICKY. `stands_for` is kept BESIDE the
/// fields, not read out of them: sealing empties the fields and a
/// name must outlive that.
///
/// `read_*` marks a FACT BUCKET once anything has asked it — never
/// cleared. WRITE-ONCE-AFTER-READ: a write that would move a bucket
/// already read is refused (`flag_stale`), never applied — the
/// answer a caller already holds cannot go stale under it.
export type RepRow = { fields: List<TypeId>, sealed: bool, stands_for: TypeId? = null, boxed_flat: bool = false, valued: bool = false, counted: int = 0, settled: bool = false, read_flat: bool = false, read_valued: bool = false, read_settled: bool = false, read_named: bool = false }

/// The layout buckets a body can ask about — one write-once-after-read
/// mark each. `Flat` covers `fields`/`boxed_flat` together: sealing
/// changes both in one step (R11c, avra-8sb5.34.21), so a read of
/// either stands for the other.
export enum LayoutFact { Flat, Valued, Settled, Named }

/// A layout write the registry refused: what fact moved, on which
/// type, and the write site's own words for why — a compiler DEFECT,
/// never a silent representation change.
export type LayoutStale = { id: TypeId, fact: LayoutFact, cause: string }

/// The interner: shapes in, ids out — assigned once, compared as
/// ints forever. The index map is keyed by each shape's CANONICAL
/// form — deterministic structural content, children by interned id —
/// which is exactly what content-addressing later hashes: the key
/// derivation swaps, the map and its callers do not.
/// ONE IDENTITY: every table is a `Cell`, so a copy of the registry
/// shares its tables and an intern through any copy reaches them all.
@identity
export type TypeRegistry = { shapes: Cell<List<Type>>, ids: Cell<Map<string, TypeId>>, named: Cell<Map<string, TypeId>>, indexed: Cell<bool>, reps: Cell<List<RepRow>>, stale: Cell<List<LayoutStale>>, declare_hook: Cell<fn(TypeId) -> void>, declaring: Cell<List<int>> }

export fn new_type_registry() -> TypeRegistry {
    TypeRegistry {
        shapes: list_cell(),
        ids: map_cell(),
        named: map_cell(),
        indexed: Cell.new(false),
        reps: list_cell(),
        stale: list_cell(),
        declare_hook: Cell.new(nothing_declared),
        declaring: list_cell(),
    }
}

/// The declare hook's floor, before anything arms it — core cannot see a
/// declaration, only ask whether one is owed.
fn nothing_declared(_t: TypeId) {}

/// A heap-shaped value: it rides POINTERS, and it waits on
/// ownership analysis wherever mutation or management is concerned.
/// Exhaustive on purpose — a new shape must decide, consciously.
/// A bare shape cannot see what an `Opt` carries, so it answers
/// pointer; the registry's `rides_pointer` is the carried-aware
/// truth the machine projections ask.
export fn ptr_shape(t: Type) -> bool {
    match t {
        .Bytes or .Str or .Ptr or .List(_) or .Cell(_) or .Task(_) or .Tasks or .Struct(_, _) or .Enum(_, _) or .Opt(_) or .Res(_, _) or .App(_, _, _) or .Dyn(_, _) or .Fn(_, _, _) or .Null or .EmptyList or .Map(_, _) or .EmptyMap or .Union(_) or .Range -> true,
        .Int or .Float or .Bool or .Error or .TypeName(_, _) or .Var(_, _, _) or .Void -> false,
    }
}

impl TypeRegistry {
    /// A shape's canonical key: variant ordinal, then child ids as
    /// payload shapes arrive. Structural — never the printed name.
    fn canon(t: Type) -> string {
        match t {
            .Int -> "0",
            .Float -> "f",
            .Ptr -> "ptr",
            .Error -> "1",
            .Str -> "2",
            .Bytes -> "19",
            .Bool -> "3",
            .List(elem) -> "4:${elem.index}",
            .Cell(inner) -> "19:${inner.index}",
            .Task(answer) -> "22:${answer.index}",
            .Tasks -> "23",
            .Struct(decl, _) -> "5:${decl.index}",
            .Enum(decl, _) -> "6:${decl.index}",
            .TypeName(decl, _) -> "7:${decl.index}",
            .Opt(inner) -> "8:${inner.index}",
            .Null -> "9",
            .EmptyList -> "13",
            .Map(k, v) -> "17:${k.index}.${v.index}",
            .EmptyMap -> "18",
            .Res(ok, err) -> "10:${ok.index}.${err.index}",
            .Var(decl, ordinal, _) -> "11:${decl.index}.${ordinal}",
            .App(decl, _, args) -> "12:${decl.index}.${joined(["${a.index}" for a in args], ".")}",
            .Dyn(decl, _) -> "14:${decl.index}",
            .Fn(params, marks, ret) -> "15:${joined(["${a.index}" for a in params], ".")}:${mark_words(marks)}:${ret.index}",
            .Void -> "16",
            .Range -> "20",
            // members arrive pre-sorted from `union_of`, the only door
            .Union(members) -> "20:${joined(["${m.index}" for m in members], ".")}",
        }
    }

    /// A union of these members — FLATTENED (a `Union` absorbed
    /// rather than nested, so `(A or B) or C` interns as `A or B or C`)
    /// and DEDUPED, SORTED by id so the set is order-independent:
    /// `A or B` and `B or A` intern identically. A single surviving member is not
    /// a union at all — the constructor answers it directly, so
    /// `Result<T, E>` for a plain `E` costs nothing new. THE ONLY
    /// DOOR that mints a `Type.Union`.
    fn union_of(parts: List<TypeId>) -> TypeId {
        let members = sorted_distinct_ids(flatten([self.union_members(p) for p in parts]))
        if members.length == 1 { return members[0] }
        self.intern(Type.Union(members))
    }

    /// A type's own member set — a `Union`'s members, or itself
    /// alone. `union_of`'s flattening reads through this.
    fn union_members(id: TypeId) -> List<TypeId> {
        match self.shape_of(id) { .Union(members) -> members, _ -> [id] }
    }

    /// `sub`'s member set inside `sup`'s — a plain type is its own
    /// one-element set, so a value's exact type into itself, a member
    /// into its union, and a narrower union into a wider one are this
    /// ONE question. THE WIDENING LAW every union-typed slot obeys.
    fn covers(sup: TypeId, sub: TypeId) -> bool {
        let superset = self.union_members(sup)
        self.union_members(sub).all((m) -> superset.any(same_type(it, m)))
    }

    /// `sup`'s members minus `removed` — a selective catch's
    /// remaining error side, raw: the caller re-interns through
    /// `union_of`, which answers a plain type when one member
    /// survives.
    fn subtracted(sup: TypeId, removed: List<TypeId>) -> List<TypeId> {
        [m for m in self.union_members(sup) if !removed.any(same_type(it, m))]
    }

    /// The id for a shape, minted on first sight — one map probe.
    fn intern(raw: Type) -> TypeId {
        // A FN TYPE'S MARKS ARE NORMALIZED HERE, so `fn(T)` interns
        // as one type however it was built: an unmarked seat list is
        // empty, and `mark_at` reads absence as plain.
        let t = trimmed_marks(raw)
        self.keep_seats_boxed(t)
        let key = self.canon(t)
        let hit: TypeId? = self.ids.get().get(key)
        if hit != null { return hit! }
        self.shapes.push(t)
        // the representation table runs PARALLEL to the shapes:
        // every type has a row, and only a declared record fills one
        let blank = RepRow { fields: [], sealed: false }
        self.reps.push(blank)
        let id = TypeId { index: self.shapes.get().length - 1 }
        self.ids.put(key, id)
        self.judge_result(id, t)
        // Interface loading may ask by spelling before later named types are
        // interned. Keep the lazy index current once it has been built.
        if self.indexed.get() {
            let name = self.name_of(id)
            if self.named.get().get(name) == null { self.named.put(name, id) }
        }
        id
    }

    /// The id a spelled type names — `.type(T)`'s answer: every
    /// part interned, children first, through the one `intern`.
    fn interned(t: TypeLit) -> TypeId {
        match t {
            .Int -> self.intern(Type.Int),
            .Float -> self.intern(Type.Float),
            .Bool -> self.intern(Type.Bool),
            .Str -> self.intern(Type.Str),
            .Bytes -> self.intern(Type.Bytes),
            .Ptr -> self.intern(Type.Ptr),
            .Void -> self.intern(Type.Void),
            .Opt(inner) -> self.intern(Type.Opt(self.interned(inner))),
            .List(elem) -> self.intern(Type.List(self.interned(elem))),
            .Cell(inner) -> self.intern(Type.Cell(self.interned(inner))),
            .Map(k, v) -> self.intern(Type.Map(self.interned(k), self.interned(v))),
            .Res(ok, err) -> self.intern(Type.Res(self.interned(ok), self.interned(err))),
            .Fn(ps, muts, consts, ret) -> self
                .intern(
                    Type
                        .Fn(
                            [self.interned(p) for p in ps],
                            zip_marks(muts, consts),
                            self.interned(ret),
                        ),
                ),
            .Id(id) -> id,
        }
    }

    /// The id already interned for this shape — a LOOKUP, never a
    /// mint: absence means the shape was never asked for. A rule
    /// reads the registry; only a pass that TYPES a program grows it.
    fn known(raw: Type) -> TypeId? {
        self.ids.get().get(self.canon(trimmed_marks(raw)))
    }

    fn shape_of(id: TypeId) -> Type { self.shapes.get()[id.index] }

    /// A FLAT record's fields, in slot order — a value that IS its
    /// fields, with no box of its own: a record of scalars, which
    /// rides REGISTERS, or a NAME over any shape, which rides
    /// whatever that shape rides. Empty for every other type; the
    /// flat ones are marked at declaration, where the fields are
    /// known.
    fn flat_fields(id: TypeId) -> List<TypeId> {
        self.note(id, LayoutFact.Flat)
        self.reps.get()[id.index].fields
    }

    fn is_flat(id: TypeId) -> bool { !self.flat_fields(id).is_empty() }

    /// `is_flat`, UNTRACKED — a peek at what the fact answers RIGHT NOW,
    /// for a caller comparing it against a STORED belief rather than
    /// relying on the answer forever. A held file's interface loading
    /// asks this to decide whether a type is worth watching for drift
    /// (`Workspace.held_flat`); the drift check itself (`layouts_moved`,
    /// compiler/derive.av) asks it again once typing has finished, to
    /// see whether THIS attempt sealed what the store remembered flat.
    /// Both reads are the mechanism a hold already has for catching a
    /// stale layout and retrying unheld — marking either one read would
    /// make the LATER seal (a fresh file's own `mut` seat, elsewhere
    /// than the record's declaration) refuse itself instead of landing,
    /// which starves that retry of the very drift it exists to see.
    fn peek_flat(id: TypeId) -> bool { !self.reps.get()[id.index].fields.is_empty() }

    /// A VALUE RECORD: flat over more than one field, so it rides
    /// REGISTERS as an aggregate — and a one-word seat holds it boxed.
    fn is_wide(id: TypeId) -> bool { self.flat_fields(id).length > 1 }

    /// THE TYPE A VALUE TRAVELS AS: a flat record of one field is that
    /// field, all the way down, so a name over a value record travels
    /// as the value record.
    fn machine_type(id: TypeId) -> TypeId {
        if self.is_flat(id) && !self.is_wide(id) { return self.machine_type(self.flat_fields(id)[0]) }
        id
    }

    /// Whether a value TRAVELS in registers as an aggregate — a value
    /// record or a value enum — seen through names.
    fn travels_wide(id: TypeId) -> bool {
        self.is_wide(self.machine_type(id)) || self.valued_carrier(id)
    }

    /// A value enum or a nullable of one: a tag and a word in
    /// registers, absence the spare tag.
    fn valued_carrier(id: TypeId) -> bool {
        let m = self.machine_type(id)
        if self.is_valued(m) { return true }
        match self.shape_of(m) {
            .Opt(inner) -> self.is_valued(self.machine_type(inner)),
            rest -> false,
        }
    }

    /// Whether a value is LAID INLINE in a box that holds it: a value
    /// record's fields are the box's slots, a value enum's tag and word
    /// two of them.
    fn lays_inline(id: TypeId) -> bool { self.is_wide(self.machine_type(id)) || self.valued_carrier(id) }

    /// A VALUE ENUM: every variant carries at most one word, so a value
    /// is its tag and that word in registers, boxed only in a slot.
    fn is_valued(id: TypeId) -> bool {
        self.note(id, LayoutFact.Valued)
        self.reps.get()[id.index].valued
    }

    /// Which of a value enum's variants carry a COUNTED word: bit `t`
    /// for tag `t`.
    fn counted_mask(id: TypeId) -> int {
        let m = self.machine_type(id)
        match self.shape_of(m) {
            .Opt(inner) -> self.counted_of(self.machine_type(inner)),
            rest -> self.counted_of(m),
        }
    }

    fn counted_of(id: TypeId) -> int {
        self.note(id, LayoutFact.Valued)
        self.reps.get()[id.index].counted
    }

    /// A declaration's LAYOUT IS FINAL: what it was marked — word, value,
    /// box — no later mark moves. WRITE-ONCE-AFTER-READ: settling twice
    /// is a no-op, moving the answer after it was read is refused.
    fn mark_settled(id: TypeId) {
        let r = self.reps.get()[id.index]
        if r.settled { return }
        if r.read_settled { return self.flag_stale(id, LayoutFact.Settled, "its declaration settled a second time") }
        self.reps.set_at(id.index, r with { settled: true })
    }

    fn is_settled(id: TypeId) -> bool {
        self.note(id, LayoutFact.Settled)
        self.reps.get()[id.index].settled
    }

    /// FEATURES arms this once (`Decls`'s own `declared_first`) — core
    /// cannot reach a declaration table, only ask one to run first. A
    /// registry with no arming reads whatever a bare `intern` left,
    /// same as before this door existed.
    fn arm_declare(hook: fn(TypeId) -> void) {
        self.declare_hook.set(hook)
    }

    /// A fact bucket asked once — never cleared, so the first ask is
    /// the one that counts. THE DECLARATION RUNS FIRST: a struct or
    /// enum's layout is the blank default until its own declare has,
    /// and demand order does not guarantee that happened before this
    /// ask — the crossing and comptime machinery reach every type
    /// this way, `Reg`'s Fingerprint derive among them
    /// (avra-8sb5.34.21).
    fn note(id: TypeId, fact: LayoutFact) {
        if self.was_read(id, fact) { return }
        (self.declare_hook.get())(id)
        // A READ WHILE THE TYPE'S OWN DECLARATION IS IN FLIGHT answers the
        // declaration's PROVISIONAL state, and the declaration is itself what
        // settles it: recording the read would flag that settle as a move after a
        // decision nobody made. A read that lands after the declaration records as
        // before. (The seal law's own sealer-sig forcing reads a return type it is
        // mid-declaring — avra-8sb5.34.21's warm-hold defect.)
        if self.declaring(id) { return }
        let r = self.reps.get()[id.index]
        match fact {
            .Flat -> self.reps.set_at(id.index, r with { read_flat: true }),
            .Valued -> self.reps.set_at(id.index, r with { read_valued: true }),
            .Settled -> self.reps.set_at(id.index, r with { read_settled: true }),
            .Named -> self.reps.set_at(id.index, r with { read_named: true }),
        }
    }

    /// Brackets a type's OWN declaration: a fact read while it is in flight is the
    /// declaration's provisional state, never a decision (see `note`).
    fn begin_declare(id: TypeId) {
        mut held = self.declaring.get()
        if !held.contains(id.index) {
            held.push(id.index)
            self.declaring.set(held)
        }
    }

    fn end_declare(id: TypeId) { self.declaring.set([i for i in self.declaring.get() if i != id.index]) }

    fn declaring(id: TypeId) -> bool { self.declaring.get().contains(id.index) }

    fn was_read(id: TypeId, fact: LayoutFact) -> bool {
        let r = self.reps.get()[id.index]
        match fact {
            .Flat -> r.read_flat,
            .Valued -> r.read_valued,
            .Settled -> r.read_settled,
            .Named -> r.read_named,
        }
    }

    /// A fact bucket's name, for a stale-write's own words.
    fn fact_word(fact: LayoutFact) -> string {
        match fact {
            .Flat -> "flatness",
            .Valued -> "value-enum layout",
            .Settled -> "settlement",
            .Named -> "declared shape",
        }
    }

    /// Refuse a write that would move a fact bucket already read —
    /// the write does not happen; the caller returns right after.
    fn flag_stale(id: TypeId, fact: LayoutFact, cause: string) {
        self.stale.push(LayoutStale { id: id, fact: fact, cause: cause })
    }

    /// Every stale write caught since the last drain, worded — the
    /// ONE place a `TypeId` becomes prose here, so a caller with no
    /// diagnostic machinery of its own (a fresh mint, deep in
    /// `intern`) still raises a readable defect. Draining, not
    /// peeking: a build asks once and the log does not repeat itself.
    fn drain_stale() -> List<string> {
        let out = [self.stale_message(v) for v in self.stale.get()]
        self.stale.set([])
        out
    }

    fn stale_message(v: LayoutStale) -> string {
        "`${self.name_of(v.id)}`'s ${self.fact_word(v.fact)} was read before ${v.cause}"
    }

    /// A RESULT is a value enum when each side is ONE WORD by a layout
    /// that can no longer move: judged once, where the type is first
    /// interned, so every body that names it agrees. Ok is tag 0, Err 1.
    fn judge_result(id: TypeId, t: Type) {
        match t {
            .Res(ok, err) -> {
                let o? = self.side_word(ok) else { return }
                let e? = self.side_word(err) else { return }
                self.mark_valued(id, o + 2 * e)
            },
            rest -> nothing_judged(),
        }
    }

    /// A Result side's word: 0 an int, a bool, a float, or a word
    /// enum — none of them ride a pointer, so none is counted — 1 a
    /// counted pointer, absent when it is not one word or its
    /// declaration has not settled what it is — a flat record stays
    /// out, since a `mut` seat may still box it.
    fn side_word(t: TypeId) -> int? {
        match self.shape_of(t) {
            .Int or .Float or .Bool -> 0,
            .Enum(_, _) -> if !self.is_settled(t) || self.is_valued(t) { null } else if self.is_flat(t) { 0 } else { 1 },
            .Struct(_, _) -> if self.is_settled(t) && !self.is_flat(t) { 1 } else { null },
            .Res(_, _) -> if self.is_valued(t) { null } else { 1 },
            .Opt(inner) -> if self.valued_carrier(inner) || !self.opt_rides_pointer(inner) { null } else { 1 },
            .Str or .Bytes or .List(_) or .Map(_, _) or .Cell(_) or .Task(_) or .Tasks or .Dyn(_, _) or .Fn(_, _, _) or .App(_, _, _) -> 1,
            .Ptr or .TypeName(_, _) or .Var(_, _, _) or .Null or .EmptyList or .EmptyMap or .Error or .Void or .Union(_) -> null,
            .Range -> 1,
        }
    }

    /// Mark an enum a VALUE ENUM whose `counted` variants carry a
    /// pointer. A SEALED enum keeps its box. WRITE-ONCE-AFTER-READ:
    /// the same answer twice is a no-op, a different one after a read
    /// is refused.
    fn mark_valued(id: TypeId, counted: int) {
        let r = self.reps.get()[id.index]
        if r.sealed { return }
        if r.valued && r.counted == counted { return }
        if r.read_valued {
            return self
                .flag_stale(id, LayoutFact.Valued, "its value-enum layout was computed a second time")
        }
        self.reps.set_at(id.index, r with { valued: true, counted: counted })
    }

    /// THE SLOTS a value takes inside a box that holds it: one, or a
    /// value record's fields laid inline, as C lays a struct member.
    fn slot_width(id: TypeId) -> int {
        if !self.lays_inline(id) { return 1 }
        if self.valued_carrier(id) { return 2 }
        self.flat_fields(self.machine_type(id)).length
    }

    /// Where the Nth of these fields starts in the box holding them all.
    fn slot_offset(fields: List<TypeId>, n: int) -> int {
        mut at = 0
        for j, f in fields { if j < n { at = at + self.slot_width(f) } }
        at
    }

    /// THE SHAPE A NAME STANDS FOR — `type Rows = List<int>` answers
    /// `List<int>`; every other type answers absence. A NAME IS
    /// OPAQUE AT A SEAT AND TRANSPARENT AT A READ, and this is the
    /// read's door: the seat law compares ids and never asks here.
    fn stands_for(id: TypeId) -> TypeId? {
        self.note(id, LayoutFact.Named)
        self.reps.get()[id.index].stands_for
    }

    /// `stands_for` all the way down — a name over a name over a
    /// shape is that shape. Itself when the type names nothing.
    fn seen_through(id: TypeId) -> TypeId {
        let under? = self.stands_for(id) else { return id }
        self.seen_through(under)
    }

    /// THE READ'S SHAPE — a named type's stands-over shape, every
    /// other type's own. Every rule that DISPATCHES ON A SHAPE to
    /// read, print, measure or compare asks here; a SEAT law asks
    /// `shape_of` and keeps the name.
    fn seen_shape(id: TypeId) -> Type { self.shape_of(self.seen_through(id)) }

    /// A NAME's shape, recorded once at declare. The name keeps its
    /// own identity — this says only what it travels as.
    /// WRITE-ONCE-AFTER-READ: the same shape twice is a no-op, a
    /// different one after a read is refused.
    fn mark_named(id: TypeId, of: TypeId) {
        let r = self.reps.get()[id.index]
        if r.stands_for != null && same_type(r.stands_for!, of) { return }
        if r.read_named { return self.flag_stale(id, LayoutFact.Named, "its name was bound to a different shape") }
        self.reps.set_at(id.index, r with { stands_for: of })
    }

    /// Whether naming `id` over `of` would CLOSE A CIRCLE — a name
    /// standing for itself, however many names away. The guard that
    /// keeps `seen_through` finite; the declaration is its only
    /// caller, so the recorded graph is acyclic by construction.
    fn names_itself(id: TypeId, of: TypeId) -> bool {
        // LICENSED structs.index_compared: type IDENTITY, not agreement — the same interned type
        if of.index == id.index { return true }
        let under? = self.stands_for(of) else { return false }
        self.names_itself(id, under)
    }

    /// THE MACHINE FORM a value of this type takes. A FLAT record IS
    /// its one field, all the way down, so every seam that COERCES
    /// by shape — a word into an i64 slot, a bool's zext, a double's
    /// bitcast, an LLVM type — asks here and never `shape_of`.
    fn machine_shape(id: TypeId) -> Type {
        if self.is_flat(id) && !self.is_wide(id) { return self.machine_shape(self.flat_fields(id)[0]) }
        self.shape_of(id)
    }

    /// Whether a type is still a PARAMETER — nothing is decided about
    /// it until mono substitutes, so a law that must judge a
    /// representation defers rather than answers.
    fn abstract_yet(id: TypeId) -> bool {
        self.shape_of(id) is .Var
    }

    /// A WORD ENUM: every variant carries nothing, so its value IS its
    /// tag (`flatten_enum` marks it flat) — told apart from a flat
    /// RECORD by its own declared shape, since only an enum's tag has
    /// a spare value no variant will ever take.
    fn is_word_enum(id: TypeId) -> bool {
        match self.shape_of(id) { .Enum(_, _) -> self.is_flat(id), rest -> false }
    }

    /// A WORD ENUM's tag register, whichever type names it: the enum
    /// itself, or its NULLABLE once insisted or unwrapped — `insisted`
    /// and `carried_of` answer the SAME register the nullable held, so
    /// a reader asking what that register IS must read the two types
    /// alike, exactly as `valued_carrier` already does for a value
    /// enum's Opt.
    fn word_carrier(id: TypeId) -> bool {
        if self.is_word_enum(id) { return true }
        match self.shape_of(id) { .Opt(inner) -> self.is_word_enum(inner), rest -> false }
    }

    /// Whether a NULLABLE of `inner` rides a pointer — the question
    /// the slot law and the machine type ask. A flat record answers
    /// YES though the bare record answers no: its nullable is a
    /// one-slot box, because a word has no spare value for absence. A
    /// WORD ENUM answers NO: its nullable spends the spare tag -1
    /// instead (the value enum's own trick, `Repr.Tagged`).
    fn opt_rides_pointer(inner: TypeId) -> bool {
        // a nullable over a nullable is a pair: the null pointer is
        // already the inner one's absence
        if self.seen_shape(inner) is .Opt { return false }
        if self.is_word_enum(inner) { return false }
        self.rides_pointer(inner) || self.is_flat(inner)
    }

    /// A `mut` SEAT KEEPS ITS BOX whichever fn type names it — a
    /// lambda's, a written `fn(mut C)`, a declared fn worn as a value
    /// — since a write must reach a box and a flat record has none.
    /// A declaration's own seats seal at declare (`keep_boxed`); this
    /// is the same law at the type's seam.
    fn keep_seats_boxed(t: Type) {
        match t {
            .Fn(params, marks, _) -> {
                for j, p in params {
                    if mut_mark(marks, j) { self.unflatten(p) }
                }
            },
            _ -> nothing_sealed(),
        }
    }

    /// A record KEEPS its box: an impl may write through `self`, and
    /// a value in a register has no identity to write through
    /// (ROADMAP: RECEIVER ALIASING). STICKY — a later `mark_flat`
    /// must not undo it, because the two run in demand order.
    /// A NAMED TYPE never seals: it has no field to write through,
    /// and its whole promise is that it travels as its shape. A
    /// `mut` seat and a `mut fn` receiver of one still work — they
    /// alias exactly as a record's receiver does (ROADMAP: RECEIVER
    /// ALIASING), which the adversarial suite pins as a PARITY.
    /// WRITE-ONCE-AFTER-READ (R11c, avra-8sb5.34.21): sealing a record
    /// whose flatness was already read is refused rather than applied
    /// — the mask a reader derived from that flatness stays the mask
    /// it read, never silently wrong under it. `r with { … }` keeps
    /// `valued`/`counted`/`settled` exactly as they were: a bare
    /// `RepRow { … }` here once reset them to their declared defaults
    /// on every seal, which is the same shape of bug one field over.
    fn unflatten(id: TypeId) {
        if self.reps.get()[id.index].stands_for != null { return }
        // an enum has no path a `mut` seat writes through, so it keeps
        // the layout its declaration made
        if self.shape_of(id) is .Enum { return }
        let r = self.reps.get()[id.index]
        let was_flat = !r.fields.is_empty()
        if was_flat && r.read_flat { return self.flag_stale(id, LayoutFact.Flat, "a `mut` seat sealed it") }
        self
            .reps
            .set_at(id.index, r with { fields: [], sealed: true, boxed_flat: r.boxed_flat || was_flat })
    }

    /// Mark a type FLAT: the value IS its fields, with no box of its
    /// own. A record of scalars holds no reference at all; a NAME
    /// holds exactly what its shape holds, and the memory pass asks
    /// the field. A SEALED record refuses. WRITE-ONCE-AFTER-READ: the
    /// same fields twice, or a seal already boxed, is a no-op.
    fn mark_flat(id: TypeId, fields: List<TypeId>) {
        let r = self.reps.get()[id.index]
        if r.sealed {
            if r.boxed_flat { return }
            if r.read_flat {
                return self
                    .flag_stale(
                        id,
                        LayoutFact.Flat,
                        "it was found flat after a `mut` seat had already sealed it",
                    )
            }
            return self.reps.set_at(id.index, r with { boxed_flat: true })
        }
        if same_fields(r.fields, fields) { return }
        if r.read_flat {
            return self
                .flag_stale(
                    id,
                    LayoutFact.Flat,
                    "its fields were declared a second time (id=${id.index}, was [${joined(["${f.index}" for f in r.fields], ",")}], now [${joined(["${f.index}" for f in fields], ",")}])",
                )
        }
        self.reps.set_at(id.index, r with { fields: fields })
    }

    /// Whether a seal boxed this record, which its declaration alone makes
    /// flat — the one layout fact a declaration's own text does not decide.
    fn boxed_flat(id: TypeId) -> bool {
        self.note(id, LayoutFact.Flat)
        self.reps.get()[id.index].boxed_flat
    }

    /// `boxed_flat`'s untracked twin — `peek_flat`'s own reason.
    fn peek_boxed_flat(id: TypeId) -> bool { self.reps.get()[id.index].boxed_flat }

    /// What a nullable carries, or absent when the id is not one —
    /// THE projection (values.av's `carried_type` is its cx-space
    /// mirror).
    fn carried(id: TypeId) -> TypeId? {
        match self.shape_of(self.seen_through(id)) { .Opt(inner) -> inner, _ -> null }
    }

    /// Whether a value of this type is one — `void` is the absence of
    /// any, so a statement answering it has nothing to keep.
    fn holds_value(id: TypeId) -> bool {
        !(self.shape_of(id) is .Void)
    }

    /// A walk source's element, or absent when the id is not one — the
    /// projection every walk and index reads. A `Range` counts, so its
    /// element is its counter; a list's is what it holds.
    fn element(id: TypeId) -> TypeId? {
        match self.shape_of(self.seen_through(id)) {
            .List(t) -> t,
            .Range -> self.intern(Type.Int),
            _ -> null,
        }
    }

    fn cell_inner(id: TypeId) -> TypeId? {
        match self.shape_of(self.seen_through(id)) { .Cell(t) -> t, _ -> null }
    }

    /// What a task answers once it has an answer.
    fn task_answer(id: TypeId) -> TypeId? {
        match self.shape_of(self.seen_through(id)) { .Task(t) -> t, _ -> null }
    }

    /// Whether a value of this type holds a task ANYWHERE inside it —
    /// what the escape laws ask of a seat a task may never reach.
    fn holds_tasks(id: TypeId) -> bool {
        match self.shape_of(self.seen_through(id)) {
            .Task(_) or .Tasks -> true,
            rest -> self.args_of(id).any((a) -> self.holds_tasks(a)),
        }
    }

    /// Whether a value of this type OWNS tasks it can join where it
    /// ends: one task (or its nullable), a list of them, or `Tasks`.
    /// Every other shape holding one is refused where it is written.
    fn owns_tasks(id: TypeId) -> bool {
        if self.shape_of(self.seen_through(id)) is .Tasks { return true }
        let elem? = self.element(id) else { return self.owns_one_task(id) }
        self.shape_of(self.seen_through(elem)) is .Task
    }

    /// A task, or a nullable one — the niche, so absence joins nothing.
    fn owns_one_task(id: TypeId) -> bool {
        match self.shape_of(self.seen_through(id)) {
            .Task(_) -> true,
            .Opt(t) -> self.shape_of(self.seen_through(t)) is .Task,
            rest -> false,
        }
    }

    /// A map's value type, or absent when the id is not one —
    /// `element`'s twin for a keyed aggregate.
    fn map_value(id: TypeId) -> TypeId? {
        match self.shape_of(self.seen_through(id)) { .Map(_, v) -> v, _ -> null }
    }

    /// A Result's two sides, or absent when the id is not one —
    /// `carried`'s twin for the failure channel.
    fn res_parts(id: TypeId) -> ResSides? {
        match self.shape_of(self.seen_through(id)) {
            .Res(ok, err) -> ResSides { ok: ok, err: err },
            _ -> null,
        }
    }

    /// A fn type's seats and answer — res_parts' twin.
    fn arrow_parts(id: TypeId) -> Arrow? {
        match self.shape_of(self.seen_through(id)) {
            .Fn(params, marks, ret) -> Arrow { seats: params, marks: marks, answer: ret },
            _ -> null,
        }
    }

    /// A value the compiler SPELLS as a literal — a scalar or text —
    /// so a settled const of it is a constant at every use; any other
    /// value is built once and called for.
    fn spells(id: TypeId) -> bool {
        match self.shape_of(id) { .Int or .Float or .Bool or .Str -> true, _ -> false }
    }

    /// Does a value of this type RIDE A POINTER at runtime —
    /// `ptr_shape` asked of the MACHINE form, so a flat record is its
    /// field and an `Opt` answers as what it CARRIES: a niche nullable
    /// IS its pointer, a scalar pair is registers and no pointer at
    /// all. The machine projections ask here.
    ///
    /// ONE OF THREE NEIGHBOURING QUESTIONS, and they are not one
    /// property with three readers (the perfect-compiler §4
    /// measurement): this asks WHAT A VALUE TRAVELS ON, `is_managed`
    /// (below) asks WHETHER THE RUNTIME COUNTS IT, `ll_type_of`
    /// (llvm.av) asks WHICH MACHINE CLASS IT LANDS IN. They part
    /// company at `Ptr` and `Null` — both ride a pointer and neither
    /// is counted, because neither carries a header — and at `Struct`
    /// and `Opt`, where the bare shape cannot see the flatness or the
    /// payload that decides. Asking one where another is meant
    /// answers about the wrong thing, quietly.
    fn rides_pointer(id: TypeId) -> bool {
        // A FLAT RECORD IS ITS FIELD, so it rides whatever the field
        // rides — a name over `int` is a word, a name over a list is
        // that list's pointer. Its NULLABLE is the question
        // `opt_rides_pointer` asks.
        if self.travels_wide(id) { return false }
        let m: Type = self.machine_shape(id)
        match m {
            // a nullable answers as ITS OWN machine form: a flat
            // record's nullable is the box, though the record is not
            .Opt(inner) -> self.opt_rides_pointer(inner),
            _ -> ptr_shape(m),
        }
    }

    /// `ty` with the TARGET fn's Vars replaced by `args`, by
    /// ordinal — THE substitution, recursive through every
    /// composite. Another fn's Vars pass through untouched.
    fn substituted(ty: TypeId, target: DeclId, args: List<TypeId>) -> TypeId {
        match self.shape_of(ty) {
            // LICENSED structs.index_compared: DECLARATION identity, not type agreement — whose Var this is
            .Var(decl, j, _) -> if decl.index == target.index { args[j] } else { ty },
            .List(elem) -> self.intern(Type.List(self.substituted(elem, target, args))),
            .Cell(inner) -> self.intern(Type.Cell(self.substituted(inner, target, args))),
            .Task(answer) -> self.intern(Type.Task(self.substituted(answer, target, args))),
            .Map(k, v) -> self
                .intern(Type.Map(self.substituted(k, target, args), self.substituted(v, target, args))),
            .Opt(inner) -> self.intern(Type.Opt(self.substituted(inner, target, args))),
            .Res(ok, err) -> self
                .intern(
                    Type
                        .Res(self.substituted(ok, target, args), self.substituted(err, target, args)),
                ),
            .App(decl, name, aa) -> self.intern(Type.App(decl, name, [self.substituted(a, target, args) for a in aa])),
            .Fn(ps, marks, ret) -> self
                .intern(
                    Type
                        .Fn(
                            [self.substituted(a, target, args) for a in ps],
                            marks,
                            self.substituted(ret, target, args),
                        ),
                ),
            .Union(members) -> self.union_of([self.substituted(m, target, args) for m in members]),
            .Ptr or .Int or .Float or .Bytes or .Str or .Bool or .Struct(_, _) or .Enum(_, _) or .TypeName(_, _) or .Dyn(_, _) or .Null or .EmptyList or .Error or .Void or .EmptyMap or .Tasks or .Range -> ty,
        }
    }

    /// Whether `ty` names a type parameter anywhere inside it.
    fn open(ty: TypeId) -> bool {
        match self.shape_of(ty) {
            .Var(_, _, _) -> true,
            .List(t) or .Cell(t) or .Task(t) or .Opt(t) -> self.open(t),
            .Map(k, v) or .Res(k, v) -> self.open(k) || self.open(v),
            .App(_, _, aa) -> [a for a in aa if self.open(a)].length > 0,
            .Fn(ps, _, ret) -> self.open(ret) || [p for p in ps if self.open(p)].length > 0,
            .Union(members) -> members.any((m) -> self.open(m)),
            .Ptr or .Int or .Float or .Bytes or .Str or .Bool or .Struct(_, _) or .Enum(_, _) or .TypeName(_, _) or .Dyn(_, _) or .Null or .EmptyList or .Error or .Void or .EmptyMap or .Tasks or .Range -> false,
        }
    }

    /// The printing projection — the ONLY place a type becomes text.
    fn name_of(id: TypeId) -> string {
        match self.shape_of(id) {
            .Int -> "int",
            .Float -> "float",
            .Ptr -> "ptr",
            .Str -> "string",
            .Bytes -> "Bytes",
            .Bool -> "bool",
            .List(elem) -> "List<${self.name_of(elem)}>",
            .Cell(inner) -> "Cell<${self.name_of(inner)}>",
            .Task(answer) -> "Task<${self.name_of(answer)}>",
            .Tasks -> "Tasks",
            .Struct(_, name) -> name,
            .Dyn(_, name) -> "dyn ${name}",
            .Fn(params, marks, ret) -> "fn(${joined(self.seat_words(params, marks), ", ")})${self.answer_word(ret)}",
            .Void -> "void",
            .Enum(_, name) -> name,
            .TypeName(_, name) -> "type ${name}",
            .Opt(inner) -> "${self.name_of(inner)}?",
            .Res(ok, err) -> "Result<${self.name_of(ok)}, ${self.name_of(err)}>",
            .Var(_, _, name) -> name,
            .App(_, name, args) -> "${name}<${joined([self.name_of(a) for a in args], ", ")}>",
            .Null -> "null",
            .EmptyList -> "[]",
            .Range -> "Range",
            .Map(k, v) -> "Map<${self.name_of(k)}, ${self.name_of(v)}>",
            .EmptyMap -> "{}",
            .Union(members) -> joined([self.name_of(m) for m in members], " or "),
            .Error -> "<error>",
        }
    }

    /// THE INVERSE OF `name_of` — the type a spelling names, or null when the
    /// registry has never made one. The loader that mints declarations from a
    /// record needs it: a held module's seats are written as spellings, and a
    /// spelling only becomes a `TypeId` through here.
    ///
    /// BUILT ON FIRST ASK, NOT ON EVERY `intern`. An index kept eagerly costs a
    /// rendering and a map write for every type the compiler ever makes — measured
    /// at 7% of a package check — to answer a question only a LOADER asks. A build
    /// that loads no record never builds it.
    ///
    /// A NAME IS NOT GUARANTEED UNIQUE. Two declarations in different modules may
    /// render the same text, and this answers the FIRST interned — so A CALLER
    /// THAT MINTS FROM A NAME MUST CHECK THE ROUND TRIP: render what it got back
    /// and refuse unless it equals the spelling it asked for. A collision then
    /// costs a REFUSAL rather than a wrong type, which is the only direction this
    /// may fail in.
    fn by_name(name: string) -> TypeId? {
        if !self.indexed.get() {
            for i in 0..self.shapes.get().length {
                let id = TypeId { index: i }
                self.named.put(self.name_of(id), id)
            }
            self.indexed.set(true)
        }
        self.named.get().get(name)
    }

    /// A type's arguments, positionally — what its declaration's
    /// parameters were bound to; nothing for a type without any.
    fn args_of(id: TypeId) -> List<TypeId> {
        match self.shape_of(id) {
            .App(_, _, args) -> args,
            .Res(ok, err) -> [ok, err],
            .List(t) or .Cell(t) or .Task(t) -> [t],
            .Map(k, v) -> [k, v],
            .Opt(t) -> [t],
            .Ptr or .Int or .Float or .Bytes or .Str or .Bool or .Struct(_, _) or .Enum(_, _) or .TypeName(_, _) or .Var(_, _, _) or .Dyn(_, _) or .Fn(_, _, _) or .Null or .EmptyList or .Error or .Void or .EmptyMap or .Tasks or .Union(_) or .Range -> [],
        }
    }

    /// A fn type's written answer — nothing when it answers `void`.
    /// Each seat spelled, its marks in front when it carries any.
    fn seat_words(params: List<TypeId>, marks: List<SeatMark>) -> List<string> {
        mut out: List<string> = []
        // LICENSED loops.push_loop: a PAIRED comprehension is our own sugar backlog — `[f(j, p) for j, p in ps]` does not parse
        for j, p in params {
            out.push(mark_prefixed(mark_at(marks, j), self.name_of(p)))
        }
        out
    }

    fn answer_word(ret: TypeId) -> string {
        if self.shape_of(ret) is .Void { return "" }
        " -> ${self.name_of(ret)}"
    }
}

/// What a `Result` carries on each side — res_parts' answer.
export type ResSides = { ok: TypeId, err: TypeId }

/// What a fn type promises — arrow_parts' answer.
export type Arrow = { seats: List<TypeId>, marks: List<SeatMark>, answer: TypeId }

/// A fn seat's contract, ONE value per seat. `mutable` lets the
/// callee write through the seat; `settled` demands the caller
/// settle the seat's value at compile time; `isolated` demands a fn
/// that shares nothing with its caller — it may run on another core.
/// `consumed` is never WRITTEN — no keyword names it (`owned` itself
/// is reserved for a future one) — it is INFERRED from the callee's
/// own body (compiler/consumes.av) the same way a method's receiver
/// write is: the caller hands its dying argument over instead of
/// retaining across the call. All ride the fn type's identity, so a
/// callee demanding one cannot sit in a seat that promised none —
/// and a new promise is a field here, never a parallel list at every
/// mark site. `@derive(Fingerprint)` for `Body.marks`
/// (compiler/lower/lower.av) — every other holder (`Type.Fn`'s own
/// identity) already folds it through `mark_words`' own string,
/// never through this derive.
@derive(Fingerprint)
@derive(Exemplar)
export type SeatMark = { mutable: bool, settled: bool, state: bool = false, unshared: bool = false, consumed: bool = false }

/// The unmarked seat — a lambda's, a wrapper's, a trailing seat's.
export const plain_mark: SeatMark = SeatMark { mutable: false, settled: false }

impl SeatMark {
    /// `@derive(Exemplar)`'s seed — every promise unmade.
    static fn codec_zero() -> SeatMark { plain_mark }
}

/// A flag list's seat, absent read false — the spelling's list may
/// be shorter than its seats.
fn flag_at(flags: List<bool>, j: int) -> bool {
    j < flags.length && flags[j]
}

/// The spelling's two mark lists, zipped into the one currency —
/// the ONLY place the two representations meet.
fn zip_marks(muts: List<bool>, consts: List<bool>) -> List<SeatMark> {
    [SeatMark { mutable: flag_at(muts, j), settled: flag_at(consts, j) } for j in 0..muts.length]
}

/// Seat `j`'s mark — absent marks read plain, so a fn type built
/// before the marks existed is a plain one.
export fn mark_at(marks: List<SeatMark>, j: int) -> SeatMark {
    if j < marks.length { return marks[j] }
    plain_mark
}

/// Whether seat `j` is written through.
export fn mut_mark(marks: List<SeatMark>, j: int) -> bool {
    mark_at(marks, j).mutable
}

/// Whether seat `j` is a `state` seat — a PLACE the caller owns: the
/// callee reads `T` and writes the caller's cell, so its argument is
/// the place, never a value.
export fn state_mark(marks: List<SeatMark>, j: int) -> bool {
    mark_at(marks, j).state
}

/// Whether seat `j` demands compile-time settlement.
export fn settled_mark(marks: List<SeatMark>, j: int) -> bool {
    mark_at(marks, j).settled
}

/// Whether seat `j` demands a fn that shares nothing with its caller.
export fn isolated_mark(marks: List<SeatMark>, j: int) -> bool {
    mark_at(marks, j).unshared
}

/// Whether seat `j`'s argument is CONSUMED — the caller hands its
/// dying reference over rather than retaining across the call.
export fn consumed_mark(marks: List<SeatMark>, j: int) -> bool {
    mark_at(marks, j).consumed
}

/// A seat's written prefix — `const`, `mut` and `isolated`, in the
/// order the grammar takes them.
export fn mark_prefixed(m: SeatMark, word: string) -> string {
    let inner = if m.unshared { "isolated ${word}" } else { word }
    let stated = if m.state { "state ${inner}" } else { inner }
    if m.settled { return if m.mutable { "const mut ${stated}" } else { "const ${stated}" } }
    if m.mutable { return "mut ${stated}" }
    stated
}

/// The canonical word for a mark set — ONE spelling in the
/// interner's key, so two mark sets are one type exactly when their
/// words agree. FIXED WIDTH PER SEAT: a splice with no separator over
/// a variable-width element moves its own boundary (CLAUDE.md, "a
/// flat concatenation of two sequences has a boundary that moves"),
/// so `owned` and `state` ride LATER characters alongside the first
/// rather than optional trailing ones — every seat spends exactly
/// the same width.
fn mark_words(marks: List<SeatMark>) -> string {
    joined([mark_word(m) for m in marks], "")
}

fn mark_word(m: SeatMark) -> string {
    "${mark_letter(m)}${if m.consumed { "o" } else { "_" }}${if m.state { "s" } else { "_" }}"
}

fn mark_letter(m: SeatMark) -> string {
    if m.unshared {
        return when {
            m.mutable -> if m.settled { "B" } else { "M" }
            m.settled -> "C"
            _ -> "P"
        }
    }
    when {
        m.mutable -> if m.settled { "b" } else { "m" }
        m.settled -> "c"
        _ -> "p"
    }
}

/// A fn type with its trailing PLAIN marks dropped — the ONE normal
/// form, so `fn(T, U)` built with no marks and with two plain ones
/// are the same type.
fn trimmed_marks(t: Type) -> Type {
    match t { .Fn(ps, marks, ret) -> Type.Fn(ps, trimmed(marks), ret), _ -> t }
}

fn is_plain(m: SeatMark) -> bool {
    !m.mutable && !m.settled && !m.unshared && !m.consumed && !m.state
}

fn trimmed(marks: List<SeatMark>) -> List<SeatMark> {
    mut last = marks.length
    while last > 0 && is_plain(marks[last - 1]) {
        last = last - 1
    }
    marks.slice(0, last)
}

/// Marks for a seat count, all plain — a lambda's, a wrapper's.
export fn no_marks(n: int) -> List<SeatMark> {
    mut out: List<SeatMark> = []
    mut j = 0
    while j < n {
        out.push(plain_mark)
        j = j + 1
    }
    out
}

/// A shape with no seats to seal.
fn nothing_sealed() {}

fn nothing_judged() {}

/// Whether two field lists name the SAME types in the SAME order —
/// `mark_flat`'s own guard against flagging a re-declaration that
/// changes nothing.
fn same_fields(a: List<TypeId>, b: List<TypeId>) -> bool {
    a.length == b.length && [j for j, x in a if !same_type(x, b[j])].is_empty()
}

/// `ids`, ascending by index, first appearance kept — a union's
/// canon key needs this order-independence and nothing else in the
/// registry has members that commute.
fn sorted_distinct_ids(ids: List<TypeId>) -> List<TypeId> {
    mut remaining = ids
    mut out: List<TypeId> = []
    while !remaining.is_empty() {
        let m = lowest_id_index(remaining)
        let id = remaining[m]
        remaining = remaining.slice(0, m).concat(remaining.slice(m + 1, remaining.length))
        if !out.any(same_type(it, id)) { out.push(id) }
    }
    out
}

fn lowest_id_index(ids: List<TypeId>) -> int {
    mut best = 0
    for i, id in ids {
        if id.index < ids[best].index { best = i }
    }
    best
}

/// WHETHER THE RUNTIME COUNTS a value of this type: strings AND the
/// aggregate shapes — the ownership milestone. `Opt` is INVISIBLE
/// here: a niche nullable IS its carried value, and the runtime's rc
/// ops no-op on the null pointer by construction.
///
/// NOT `rides_pointer`, which asks what a value travels on — a `Ptr`
/// and a `Null` ride one and carry no header, so nothing counts them.
/// The three neighbouring questions are stated at `rides_pointer`.
export fn is_managed(types: TypeRegistry, ty: TypeId) -> bool {
    match types.shape_of(ty) {
        .Str or .Bytes -> true,
        // A FLAT RECORD IS ITS FIELD: a record of words holds no
        // reference, a NAME over a list holds the list's.
        .Struct(_, _) -> flat_managed(types, ty),
        // EmptyList is the one identity widen whose pointer is a
        // REAL box: the callee's List param releases it, so the
        // caller must own it too, or the seam frees a live name.
        // an enum whose variants carry nothing is its tag — a word; a
        // value enum is counted only when a variant carries a pointer
        .Enum(_, _) -> !types.is_flat(ty) && !(types.is_valued(ty) && types.counted_mask(ty) == 0),
        .List(_) or .Cell(_) or .Task(_) or .Tasks or .EmptyList or .Map(_, _) or .EmptyMap or .App(_, _, _) or .Dyn(_, _) or .Fn(_, _, _) or .Union(_) or .Range -> true,
        .Res(_, _) -> !(types.is_valued(ty) && types.counted_mask(ty) == 0),
        // a FLAT record's nullable is a one-slot BOX — counted,
        // though the bare record never is; a WORD ENUM's nullable
        // spends its spare tag instead and never boxes
        .Opt(inner) -> types.is_flat(inner) && !types.is_word_enum(inner) || is_managed(types, inner),
        .Ptr or .Int or .Float or .Bool or .TypeName(_, _) or .Var(_, _, _) or .Null or .Error or .Void -> false,
    }
}

/// A RECORD's own answer: a flat one IS its fields, so it is managed
/// exactly when one of them is; a boxed one always counts.
fn flat_managed(types: TypeRegistry, ty: TypeId) -> bool {
    if !types.is_flat(ty) { return true }
    types.flat_fields(ty).any(is_managed(types, it))
}
