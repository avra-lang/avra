//! The named payloads a node holds, each folded into its identity by
//! its own `identity` — the leaves `@derive(Identity)` stops at.

impl Identity for ExprId {
    fn identity(arena: SyntaxArena) -> int { arena.expr_fingerprint(self) }
}

impl Identity for StmtId {
    fn identity(arena: SyntaxArena) -> int { arena.stmt_fingerprint(self) }
}

impl Identity for BodyView {
    fn identity(arena: SyntaxArena) -> int { arena.view_fp(self) }
}

impl Identity for TypeRef {
    fn identity(arena: SyntaxArena) -> int { self.fingerprint() }
}

impl Identity for Scoped {
    fn identity(arena: SyntaxArena) -> int { fp_str(self.of) }
}

impl Identity for Plain {
    fn identity(arena: SyntaxArena) -> int { fp_str(self.of) }
}

impl Identity for Nominal {
    fn identity(arena: SyntaxArena) -> int { fp_str(self.of) }
}

impl Identity for PatId {
    fn identity(arena: SyntaxArena) -> int { arena.pat_fingerprint(self) }
}
