//! The named payloads a node holds, each folded into its identity by
//! its own `identity` — the leaves `@derive(Identity)` stops at.

impl Identity for ExprId {
    fn identity(arena: SyntaxArena) -> int { arena.expr_fingerprint(self) }
}

impl Identity for StmtId {
    fn identity(arena: SyntaxArena) -> int { arena.stmt_fingerprint(self) }
}

impl Identity for Arm {
    fn identity(arena: SyntaxArena) -> int { arena.arm_fp(self) }
}

impl Identity for CompClause {
    fn identity(arena: SyntaxArena) -> int { arena.comp_clause_fp(self) }
}

impl Identity for Param {
    fn identity(arena: SyntaxArena) -> int { arena.param_fp(self) }
}

impl Identity for Variant {
    fn identity(arena: SyntaxArena) -> int { arena.variant_fp(self) }
}

impl Identity for Case {
    fn identity(arena: SyntaxArena) -> int { arena.case_fp(self) }
}

impl Identity for BodyView {
    fn identity(arena: SyntaxArena) -> int { arena.view_fp(self) }
}

impl Identity for TypeRef {
    fn identity(arena: SyntaxArena) -> int { type_fp(self) }
}

impl Identity for Scoped {
    fn identity(arena: SyntaxArena) -> int { fp_str(self.of) }
}

impl Identity for Plain {
    fn identity(arena: SyntaxArena) -> int { fp_str(self.of) }
}

impl Identity for Nominal {
    fn identity(arena: SyntaxArena) -> int { fp_str(self.of) }
}

impl Identity for BinOp {
    fn identity(arena: SyntaxArena) -> int { fp_binop(self) }
}

impl Identity for CollectKind {
    fn identity(arena: SyntaxArena) -> int { collectkind_fp(self) }
}

impl Identity for CollectScope {
    fn identity(arena: SyntaxArena) -> int { collectscope_fp(self) }
}

impl Identity for Projection {
    fn identity(arena: SyntaxArena) -> int { projection_fp(self) }
}
