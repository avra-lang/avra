//! `Heirs` — the sub-expressions a planted WANT flows into UNCHANGED: a
//! branch answers its arms' values, every other node answers none. A
//! `collect enum Expr: Heirs` derives the empty impl for a member with
//! none of its own, which takes the trait's default.
//!
//! It stands ALONE in this file on purpose (CLAUDE.md).
use @std.meta.{Type as MetaType, Directive}

export trait Heirs {
    fn heirs() -> List<ExprId> { [] }

    static fn derive(t: MetaType) -> List<Directive> {
        [Directive { twin: "", name: t.name, at: t.at, source: quote { impl Heirs for ${t} {} } }]
    }
}
