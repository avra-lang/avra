//! `@derive(Identity)` — A NODE'S CONTENT IDENTITY, read off the node
//! model: a tag, the type's name, the variant's INDEX, then one folded
//! value per payload. Spans never participate, so reformatting never
//! changes an identity, and two nodes with the same content wear the
//! same number however far apart they sit in the arena.
//!
//! IT IS NOT `Fingerprint`, AND THE DIFFERENCE IS NOT COSMETIC.
//! `Fingerprint` folds a VALUE's own fields. A node's payloads are
//! `ExprId`s — `{ index: int }` — so folding the value folds an ARENA
//! POSITION, and two structurally identical subtrees would wear
//! different identities, which is the one thing a fingerprint must
//! never do. A node's identity is only meaningful THROUGH its arena,
//! so this generates `impl NodeStore` and an id payload reaches its
//! answer through the store's memoized column.
//!
//! THE FOLD ITSELF IS `Fingerprint`'S, CALLED AND NEVER COPIED.
//! `parted_at` writes the tag, folds the type's name at derive time
//! and pins the variant's index — one fold, one literal tag, in the
//! one file `make fingerprints` can read it in. What THIS derive owns
//! is the row per payload TYPE and the two marks; a second copy of
//! the fold would be two tags for one space, which is the collision
//! the keeper exists to refuse.
//!
//! A PARTS LIST IS FIXED ARITY. Every variable-length payload folds
//! through `fp_list` to ONE value before it stands in a parts list, so
//! no payload's boundary can move and two shapes cannot splice to one
//! sequence.
//!
//! It stands ALONE in this file on purpose (CLAUDE.md).
use @std.meta.{Type as MetaType, Variant as MetaVariant, Field, Mark as MetaMark, Directive, Code, Arms, name}

/// The compiler's derive for a node's content identity.
export trait Identity {
    static fn derive(t: MetaType) -> List<Directive> {
        [Directive { twin: "", name: t.name, at: t.at, source: quote {
            impl NodeStore {
                fn ${fold_of(t.name)}(node: ${t}) -> int {
                    match node { ${[ident_arm(t, v, j) for j, v in t.variants]} }
                }
            }
        } }]
    }

    /// The one word this derive reads off a variant, and no others.
    static fn marks(t: MetaType) -> List<string> { ["expands"] }
}

/// One variant's arm. Its INDEX pins the arity, so two variants of one
/// type cannot fold alike however their payloads line up.
fn ident_arm(t: MetaType, v: MetaVariant, at: int) -> Arms {
    if v.fields.is_empty() { return quote { .${v} -> ${folded_parts(t, v, at)} } }
    quote { .${v}(${binders(v)}) -> ${folded_parts(t, v, at)} }
}

/// The fold: the type's name, the variant's place, then its payloads.
/// AN EXPANSION IS NOT PART OF WHAT A NODE IS — it is what the other
/// payloads expand TO, so folding it would make one program wear two
/// identities either side of its own expansion.
fn folded_parts(t: MetaType, v: MetaVariant, at: int) -> Code {
    let expands: MetaMark? = v.marks.find(it.name == "expands")
    let except = if expands == null { "" } else { expands!.args.first() ?? "" }
    parted_at(t.name, at, [part(f) for f in v.fields if f.name != except])
}

/// HOW A PAYLOAD'S TYPE FOLDS — asked of its SHAPE, never of its
/// spelling. `Kind` is the structural answer the crossing already
/// carries beside the words, so "is this a list", "is this absent-able"
/// and "is this a scalar" are read rather than parsed.
///
/// WHAT `Kind` DOES NOT BUY, stated here so nobody re-litigates it:
/// `ExprId`, `StmtId` and `PatId` are all `Named` single-field
/// structs, so WHICH ARENA a payload belongs to is a NAME comparison
/// whatever shape we give this. The structure says list-or-one; only
/// the name says which store answers. That boundary is the reason the
/// three name-asking rows below exist and is not a failure to finish
/// the job.
fn part(f: Field) -> Code {
    let b = name(f.name)
    match f.kind {
        .Int -> b,
        .Bool -> quote { flagged(${b}) },
        .Str -> quote { fp_str(${b}) },
        .Named(n, _) -> one_part(n, b),
        .Opt(.Named(n, _)) -> absent_part(n, b),
        .List(.Str) -> quote { fp_list(str_fps(${b})) },
        .List(.Named(n, _)) -> many_part(n, b),
        rest -> quote { a_payload_shape_the_identity_derive_has_no_row_for() },
    }
}

/// ONE declared value — the arena's own fold, a name's text, or a
/// written type. The ONLY place a payload's arena is asked by NAME.
fn one_part(declared: string, b: Code) -> Code {
    match declared {
        "ExprId" -> quote { self.expr_fingerprint(${b}) },
        "Scoped" or "Plain" or "Nominal" -> quote { fp_str(${b}.of) },
        "TypeRef" -> quote { type_fp(${b}) },
        "BinOp" -> quote { fp_binop(${b}) },
        _ -> quote { a_declared_payload_the_identity_derive_has_no_row_for() },
    }
}

/// ONE declared value that may be ABSENT — absence is its own value,
/// told apart by arity and never by a spare number.
fn absent_part(declared: string, b: Code) -> Code {
    match declared {
        "ExprId" -> quote { self.opt_fp(${b}) },
        "Scoped" or "Plain" or "Nominal" -> quote { fp_str(${b}?.of ?? "") },
        "TypeRef" -> quote { type_fp(${b}) },
        _ -> quote { an_absent_payload_the_identity_derive_has_no_row_for() },
    }
}

/// A RUN of declared values, folded to ONE value before it stands in
/// a parts list — the arity law, applied where a run appears.
fn many_part(declared: string, b: Code) -> Code {
    match declared {
        "ExprId" -> quote { fp_list(self.expr_fps(${b})) },
        "StmtId" -> quote { fp_list(self.stmt_fps(${b})) },
        "Arm" -> quote { fp_list(self.arm_fps(${b})) },
        "Param" -> quote { fp_list(self.param_fps(${b})) },
        "Variant" -> quote { fp_list(self.variant_fps(${b})) },
        "Case" -> quote { fp_list(self.case_fps(${b})) },
        "Plain" -> quote { fp_list(plain_fps(${b})) },
        "Scoped" -> quote { fp_list(scoped_fps(${b})) },
        "TypeRef" -> quote { fp_list([type_fp(each) for each in ${b}]) },
        _ -> quote { a_run_payload_the_identity_derive_has_no_row_for() },
    }
}

/// The fold's name for a node arena — the node model's two, named
/// once, as the child walk names them.
fn fold_of(owner: string) -> string {
    if owner == "Expr" { return "fingerprint_expr" }
    "fingerprint_stmt"
}
