//! `@derive(Identity)` — A NODE'S CONTENT IDENTITY, read off the node
//! model: a tag, the type's name, then one folded value per payload.
//! Spans never participate, so reformatting never changes an identity,
//! and two nodes with the same content wear the same number however
//! far apart they sit in the arena.
//!
//! EACH NODE RECORD DERIVES ITS OWN `identity`: a `collect enum E:
//! Identity` implements the trait over its members and reaches the
//! member's impl, so no arm per variant is written here.
//!
//! IT IS NOT `Fingerprint`, AND THE DIFFERENCE IS NOT COSMETIC.
//! `Fingerprint` folds a VALUE's own fields. A node's payloads are
//! `ExprId`s — `{ index: int }` — so folding the value folds an ARENA
//! POSITION, and two structurally identical subtrees would wear
//! different identities, which is the one thing a fingerprint must
//! never do. A node's identity is only meaningful THROUGH its arena,
//! so `identity` takes the arena and an id payload reaches its answer
//! through the store's memoized column.
//!
//! THE FOLD ITSELF IS `Fingerprint`'S, CALLED AND NEVER COPIED.
//! `parted` writes the tag and folds the type's name at derive time —
//! one fold, one literal tag, in the one file `make fingerprints` can
//! read it in. What THIS derive owns is the row per payload TYPE.
//!
//! A PARTS LIST IS FIXED ARITY. Every variable-length payload folds
//! through `fp_list` to ONE value before it stands in a parts list, so
//! no payload's boundary can move and two shapes cannot splice to one
//! sequence.
//!
//! It stands ALONE in this file on purpose (CLAUDE.md).
use @std.meta.{Type as MetaType, Field, Declared, Diagnostic, Directive, Code, refuse_as_at}

/// The compiler's derive for a node's content identity.
export trait Identity {
    fn identity(arena: SyntaxArena) -> int

    static fn derive(t: MetaType) -> Declared {
        let problems = [unrowed(t, f) for f in t.fields if part(f) == null]
        if !problems.is_empty() { return Declared { made: [], problems: problems } }
        Declared {
            made: [
                Directive {
                    twin: "",
                    name: t.name,
                    at: t.at,
                    source: quote {
                        impl Identity for ${t} {
                            fn identity(arena: SyntaxArena) -> int { ${folded(t)} }
                        }
                    },
                },
            ],
            problems: [],
        }
    }
}

/// The fold: the type's name, then its payloads.
fn folded(t: MetaType) -> Code {
    parted(t.name, [part(f)! for f in t.fields])
}

/// HOW A PAYLOAD'S TYPE FOLDS — the whole registry, one row per shape
/// the node model spells. A type absent here is a payload the model
/// does not carry: absence, which the derive refuses rather than fold
/// to a silent zero.
fn part(f: Field) -> Code? {
    let b = quote { self.${f.name} }
    match f.ty {
        "ExprId" -> quote { arena.expr_fingerprint(${b}) },
        "ExprId?" -> quote { arena.opt_fp(${b}) },
        "List<ExprId>" -> quote { fp_list(arena.expr_fps(${b})) },
        "List<StmtId>" -> quote { fp_list(arena.stmt_fps(${b})) },
        "List<Arm>" -> quote { fp_list(arena.arm_fps(${b})) },
        "List<CompClause>" -> quote { fp_list(arena.comp_clause_fps(${b})) },
        "List<Param>" -> quote { fp_list(arena.param_fps(${b})) },
        "List<Variant>" -> quote { fp_list(arena.variant_fps(${b})) },
        "List<Case>" -> quote { fp_list(arena.case_fps(${b})) },
        "string" -> quote { fp_str(${b}) },
        "List<string>" -> quote { fp_list(str_fps(${b})) },
        "int" -> b,
        "bool" -> quote { flagged(${b}) },
        "BinOp" -> quote { fp_binop(${b}) },
        "Scoped" or "Plain" or "Nominal" -> quote { fp_str(${b}.of) },
        "Scoped?" or "Plain?" or "Nominal?" -> quote { fp_str(${b}?.of ?? "") },
        "List<Plain>" -> quote { fp_list(plain_fps(${b})) },
        "List<Scoped>" -> quote { fp_list(scoped_fps(${b})) },
        "TypeRef" or "TypeRef?" -> quote { type_fp(${b}) },
        "List<TypeRef>" -> quote { fp_list([type_fp(each) for each in ${b}]) },
        "BodyView" -> quote { arena.view_fp(${b}) },
        "CollectKind" -> quote { collectkind_fp(${b}) },
        "CollectScope" -> quote { collectscope_fp(${b}) },
        "Projection" -> quote { projection_fp(${b}) },
        _ -> null,
    }
}

// ── voices ──

fn unrowed(t: MetaType, f: Field) -> Diagnostic {
    refuse_as_at(
        "identity-payload",
        f.at,
        "a node's identity folds the payload types the node model spells — `${t.name}.${f.name}` is `${f.ty}`, which has no row",
        "give the type a row in `Identity`'s registry (core/identity_derive.av), or change the field's type",
    )
}
