//! The pattern nodes: each record is one variant of `Pat`
//! (core/nodes.av), its fields the variant's payload.
use core.{pat_node, Scoped, Plain, PatId, ExprId, FormatPart, TypeRef}

@pat_node
type Wild = {}

@pat_node
type Rest = {}

@pat_node
type Bind = { name: Scoped }

@pat_node
type Variant = { name: Plain, args: List<PatId> }

@pat_node
type Lit = { value: ExprId }

/// A text FORMAT: literal `head`, then a hole and the literal
/// that follows it, repeated. `"a{x}b{y}c"` is head `"a"` with
/// parts `[{x, "b"}, {y, "c"}]`; a format with no holes is head
/// alone. The count relationship between literals and holes is
/// true by construction and unspellable otherwise.
@pat_node
type Format = { head: string, parts: List<FormatPart> }

/// A CODE SHAPE: `body` is the quote expression the primary
/// already mints, wrapped — the same node, matched structurally
/// instead of spliced. A hole binds the code at its seat.
@pat_node
type Quote = { body: ExprId }

/// A TYPE TEST over a `dyn`: `name: T` accepts the value whose type
/// is `T` and binds it as one.
@pat_node
type Typed = { name: Scoped, ty: TypeRef }

/// A GATHERED variant taken whole: `.V as r` tests for `V` and binds
/// `r` as its member's record.
@pat_node
type Member = { name: Plain, bind: Scoped }

/// A LIST pattern: the patterns before a `..`, the `..` itself (one
/// wildcard or binder of the middle, none when no `..` was written), and the patterns after it. Without a `..` the list must
/// have exactly that many elements.
@pat_node
type Seq = { before: List<PatId>, rest: List<PatId>, after: List<PatId> }

/// A RECORD pattern: the type's name and the fields it looks at, each
/// with the pattern it takes (a punned field binds its own name).
/// `open` is a written `..` — the fields not named are not looked at.
@pat_node
type Fields = { name: Plain, fields: List<Plain>, args: List<PatId>, open: bool }
