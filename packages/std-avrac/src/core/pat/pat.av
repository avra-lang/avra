//! The pattern nodes: each record is one variant of `Pat`
//! (core/nodes.av), its fields the variant's payload.
use core.{pat_node, Scoped, Plain, PatId, ExprId, FormatPart}

@pat_node(0)
type Wild = {}

@pat_node(1)
type Rest = {}

@pat_node(2)
type Bind = { name: Scoped }

@pat_node(3)
type Variant = { name: Plain, args: List<PatId> }

@pat_node(4)
type Lit = { value: ExprId }

/// A text FORMAT: literal `head`, then a hole and the literal
/// that follows it, repeated. `"a{x}b{y}c"` is head `"a"` with
/// parts `[{x, "b"}, {y, "c"}]`; a format with no holes is head
/// alone. The count relationship between literals and holes is
/// true by construction and unspellable otherwise.
@pat_node(5)
type Format = { head: string, parts: List<FormatPart> }

/// A CODE SHAPE: `body` is the quote expression the primary
/// already mints, wrapped — the same node, matched structurally
/// instead of spliced. A hole binds the code at its seat.
@pat_node(6)
type Quote = { body: ExprId }
