//! A component's RECORD FORM, read off its declaration: what an instance
//! that is a literal of the record needs to know. It is plain data, so a
//! held provider says it in its record and its file is never parsed for it.
use core.{
    SyntaxArena,
    ComponentParts,
    FnParts,
    Param,
    TypeRef,
    Record,
    ChildSlot,
    Event,
    flatten,
    some_list,
}

/// `@std/meta`'s `default`: the one member an instance's bare statements fill.
export const META_DEFAULT: Known = Known { package: "@std/meta", name: "default" }

/// `@std/meta`'s `over`: the place a member is shown over.
export const META_OVER: Known = Known { package: "@std/meta", name: "over" }

/// `@std/meta`'s `names`: the field a named instance's name fills.
export const META_NAMES: Known = Known { package: "@std/meta", name: "names" }

/// What `@std/meta`'s `ComponentMembers`, the reader of every component's members, reads.
const COMPONENT_MEMBERS: List<Known> = [META_DEFAULT, META_OVER, META_NAMES]

/// The language's mark a component member's written mark `m` binds: the one `ComponentMembers`
/// reads under its word, a lookup in that reader's namespace; absent where it reads none.
export fn component_mark(m: Mark) -> Known? { COMPONENT_MEMBERS.find(it.name == m.name) }

/// Whether a component member's marks bind `known`.
export fn wears_component_mark(marks: List<Mark>, known: Known) -> bool { marks.any((m) -> component_mark(m) == known) }

/// The record an instance of the component is a literal of — absent for one
/// that expands, whose instance is its template copied in place.
export fn record_form(store: SyntaxArena, c: ComponentParts, components: List<string>) -> Record? {
    if expand_of(store, c) != null { return null }
    record_of(store, c, components)
}

/// A component read as a record: its head in order and the head seats a default fills, the `List` fields
/// its instance's statements may fill — never a `state` one, a place the
/// instance keeps or is handed — its one fn field — an event's
/// handler is heard, never a body — and its events. `components` are the names its file declares
/// components by: a list of one takes that component's instances alone.
export fn record_of(store: SyntaxArena, c: ComponentParts, components: List<string>) -> Record {
    let fields = c.fields()
    let arrow_fields = [p for p in fields if p.ty?.arrow ?? false]
    Record {
        head: [p.name.text() for p in c.head],
        defaulted: [p.name.text() for p in c.head if p.default != null],
        slots: [ChildSlot {
            name: p.name.text(),
            of: element_name(p),
            gathers: !components.contains(element_name(p)),
            default: wears_component_mark(p.marks, META_DEFAULT),
        } for p in fields if lists(p) && !p.state],
        named: fields.any(wears_component_mark(it.marks, META_NAMES)),
        checks: component_verb(store, c, META_CHECKS) != null,
        fn_field: if arrow_fields.length == 1 { arrow_fields[0].name.text() } else { null },
        fn_optional: arrow_fields.length == 1 && answers_nullable(arrow_fields[0].ty),
        events: [Event {
            name: e.name,
            says: [s.name.text() for s in e.says],
            default: wears_component_mark(e.holder.marks, META_DEFAULT),
        } for e in c.events()],
        words: !c.spreads.is_empty(),
    }
}

/// A written fn type's own answer reads as nullable: the `?` an arms
/// body's implicit `_ -> null` tail answers to.
fn answers_nullable(ty: TypeRef?) -> bool {
    ty?.answer?.optional ?? false
}

impl SyntaxArena {
    /// The names this store's statements declare components by.
    fn component_names() -> List<string> { [c!.name for s in self.stmt_ids() for c in [self.component_parts(s)] if c != null] }
}

/// The name a `List` field's elements are written with.
fn element_name(p: Param) -> string {
    p.ty?.applied?.first()?.name ?? ""
}

fn lists(p: Param) -> bool {
    p.ty?.names_builtin(OwnType.List) ?? false
}

/// A verb a component declares as a member: the member `@std/meta`'s trait `of` declares as
/// `member`, judged against that trait's signature.
export type ComponentVerb = { of: Known, member: string }

/// `@std/meta`'s `Checks.check`.
export const META_CHECKS: ComponentVerb = ComponentVerb {
    of: Known { package: "@std/meta", name: "Checks" },
    member: "check",
}

/// `@std/meta`'s `Expands.expand`.
export const META_EXPANDS: ComponentVerb = ComponentVerb {
    of: Known { package: "@std/meta", name: "Expands" },
    member: "expand",
}

/// `@std/meta`'s `Declares.expand`.
export const META_DECLARES: ComponentVerb = ComponentVerb {
    of: Known { package: "@std/meta", name: "Declares" },
    member: "expand",
}

/// The member of `c` that is the verb `v`, when it declares one.
export fn component_verb(store: SyntaxArena, c: ComponentParts, v: ComponentVerb) -> FnParts? { member(store, c, v.member) }

/// A component's `expand`, when it declares one: the member `Expands` and `Declares` both name.
export fn expand_of(store: SyntaxArena, c: ComponentParts) -> FnParts? { component_verb(store, c, META_EXPANDS) }

/// A component's method of this name, when it declares one.
export fn member(store: SyntaxArena, c: ComponentParts, name: string) -> FnParts? {
    flatten([some_list(store.fn_parts(m)) for m in c.fns]).find(it.name == name)
}

