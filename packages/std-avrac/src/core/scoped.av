//! A SCOPE-KEYING NAME'S VERBS: its text, whether it spells a word, and the one way to mint one,
//! with the fixed words the compiler asks for most, each minted once.
use @std.program.names.{name_of}

impl Scoped {
    /// The text this name spells.
    fn text() -> string { self.of.text() }

    /// Whether this name spells `word`. A word arrives as text, so it is compared with this name's
    /// text, one compare: minting the word to compare names would hash it and probe the table first.
    fn spells(word: string) -> bool { self.text() == word }
}

/// The scope-keying name `text` spells, interned.
export fn scoped(text: string) -> Scoped { Scoped(name_of(text)) }

/// The fixed words below, each minted once a process, in the order they are read by.
once fn fixed_names() -> List<Scoped> { [scoped(""), scoped(RECEIVER), scoped(PRONOUN)] }

/// The name that spells nothing, which a blanked name stands as.
export fn no_name() -> Scoped { fixed_names()[0] }

/// The receiver's name.
export fn receiver_name() -> Scoped { fixed_names()[1] }

/// The pronoun's name.
export fn pronoun_name() -> Scoped { fixed_names()[2] }
