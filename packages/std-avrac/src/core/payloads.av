//! THE NODE MODEL'S OWN DECLARATION, AS ROWS. A node variant's
//! payloads — each name with its type's spelling, in declaration
//! order — read off the enum by `@derive(Grammar)` and consumed by
//! the grammar's node binding. Order IS the contract: a build's
//! arguments are filled in payload order, so two same-typed payloads
//! are told apart by nothing else.

/// One payload of one variant: its name and its type's spelling.
export type Payload = { name: string, ty: string }

/// What a node build needs to know about the variant it names.
export type PayloadRow = { owner: string, variant: string, payloads: List<Payload> }

/// The row for `owner.variant`, or nothing when the model declares
/// no such variant.
export fn row_for(rows: List<PayloadRow>, owner: string, variant: string) -> PayloadRow? {
    rows.find(it.owner == owner && it.variant == variant)
}
