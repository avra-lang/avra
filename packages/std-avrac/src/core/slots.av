//! The label accessors a flat node's maker reads its payloads through.
//! A maker names its payloads by LABEL, so it never depends on their
//! positions. Features implement `Slots` over their builder.

/// A builder's labelled payloads, read by the label that names each.
export trait Slots {
    fn expr_of(label: string) -> Result<ExprId, string>
    fn text_of(label: string) -> Result<string, string>
    fn int_of(label: string) -> Result<int, string>
    fn flag_of(label: string) -> Result<bool, string>
    fn op_of(label: string) -> Result<BinOp, string>
    fn exprs_of(label: string) -> Result<List<ExprId>, string>
    /// The records the payload `label` carries, as data.
    fn carried_of(label: string) -> Result<List<Carried>, string>
    /// The expressions under `label`, each that reads `it` built as a
    /// one-seat lambda.
    fn riding_of(label: string) -> Result<List<ExprId>, string>
    fn expr_opt_of(label: string) -> Result<ExprId?, string>
    fn texts_of(label: string) -> Result<List<string>, string>
    fn scoped_opt_of(label: string) -> Result<Scoped?, string>
    fn present_of(label: string) -> Result<bool, string>
    fn params_of(label: string) -> Result<List<Param>, string> { .Ok(flatten([some_list(c.param()) for c in self.carried_of(label)?])) }
    fn variants_of(label: string) -> Result<List<Variant>, string> { .Ok(flatten([some_list(c.variant()) for c in self.carried_of(label)?])) }
    fn use_items_of(label: string) -> Result<List<UseItem>, string> { .Ok(flatten([some_list(c.use_item()) for c in self.carried_of(label)?])) }
    fn field_pats_of(label: string) -> Result<List<FieldPat>, string> { .Ok(flatten([some_list(c.field_pat()) for c in self.carried_of(label)?])) }
    fn proj_fields_of(label: string) -> Result<List<ProjField>, string> { .Ok(flatten([some_list(c.proj_field()) for c in self.carried_of(label)?])) }
    fn order_keys_of(label: string) -> Result<List<OrderKey>, string> { .Ok(flatten([some_list(c.order_key()) for c in self.carried_of(label)?])) }
    fn givens_of(label: string) -> Result<List<Given>, string> { .Ok(flatten([some_list(c.given()) for c in self.carried_of(label)?])) }
    fn fn_seats_of(label: string) -> Result<List<FnSeat>, string> { .Ok(flatten([some_list(c.fn_seat()) for c in self.carried_of(label)?])) }
    fn marks_of(label: string) -> Result<List<Mark>, string> { .Ok(flatten([some_list(c.mark()) for c in self.carried_of(label)?])) }
    fn arms_of(label: string) -> Result<List<Arm>, string> { .Ok(flatten([some_list(c.arm()) for c in self.carried_of(label)?])) }
    fn catch_arms_of(label: string) -> Result<List<CatchArm>, string> { .Ok(flatten([some_list(c.catch_arm()) for c in self.carried_of(label)?])) }
    fn cases_of(label: string) -> Result<List<Case>, string> { .Ok(flatten([some_list(c.case()) for c in self.carried_of(label)?])) }
    fn map_entries_of(label: string) -> Result<List<MapEntry>, string> { .Ok(flatten([some_list(c.map_entry()) for c in self.carried_of(label)?])) }
    fn comp_clauses_of(label: string) -> Result<List<CompClause>, string> { .Ok(flatten([some_list(c.comp_clause()) for c in self.carried_of(label)?])) }
    fn stmts_of(label: string) -> Result<List<StmtId>, string>
    fn pats_of(label: string) -> Result<List<PatId>, string>
    fn pat_of(label: string) -> Result<PatId, string>
    fn type_of(label: string) -> Result<TypeRef, string>
    fn types_of(label: string) -> Result<List<TypeRef>, string>
    fn type_opt_of(label: string) -> Result<TypeRef?, string>
    /// The span the payload `label` was WRITTEN at — its token's, or the
    /// node its rule built. Null where the rule wrote nothing under it.
    fn at_of(label: string) -> Result<Span?, string>
    /// Where each capture under `label` was written, in order.
    fn spans_of(label: string) -> Result<List<Span?>, string>
    /// The text of the file the build reads.
    fn source() -> string
    /// The span the whole build was written at.
    fn built_at() -> Span?
    /// An error node standing for a payload the rule left unwritten.
    fn hollow() -> ExprId
    /// The arena the build allocates into.
    fn arena() -> SyntaxArena
    /// The imported component `word` opens in the build's file.
    fn component_word(word: string) -> ComponentWord?
    /// A new statement at the build's place, its facets written.
    fn made_stmt(s: Stmt) -> Result<StmtId, string>
    /// A new expression at the build's place, its facets written and a
    /// sugar's meaning minted.
    fn made_expr(e: Expr) -> Result<ExprId, string>
}

/// A flat variant's maker: its grammar name, and the fn that builds it
/// from a `Slots` value.
export type Maker<T> = { name: string, make: fn(dyn Slots) -> Result<T, string> }
