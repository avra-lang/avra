//! A quote used as a PATTERN: its `${...}` holes are BINDERS, not
//! fills — matching real code structurally, never splicing. An
//! EXPRESSION or a STATEMENT seat has its own tree position this
//! matcher can wildcard (`shape.av`'s `Shape.Hole` recurses into a
//! CHILD position, never into a scalar field its parent folds into
//! its own identity); a NAME seat's written text (a `let`'s declared
//! name, a call's callee, a field name — `own_name_at`'s catalog) is
//! such a scalar TOO, but a LONE hole there is a position this
//! matcher CAN hold open (`Shape.TypedNode`'s `Open.Name`), reading
//! the subject's own name text back as a `string` rather than
//! recursing into it — an EMBEDDED
//! hole (`l${x}_y`) still has none. A TYPE seat's own written type (a
//! `let`'s annotation, a call's one pinned type argument, a param's
//! own type — `own_type_at`'s catalog) is a scalar the SAME way, held
//! open by `Shape.TypedNode`'s `Open.Type`, reading the subject's own
//! written `TypeRef` back. A node holds BOTH a name and a type open
//! at once (`let ${x}: ${T} = ...`), since `TypedNode` carries a LIST
//! of them, never a single index. `${..name}` at an Expression or
//! Statement seat is a RUN: it binds a whole CONTIGUOUS SPAN of
//! siblings there (`Shape.Run`), zero or more, never one node — a
//! call's arguments, a list literal's elements, a block's statements
//! are the seats it can stand among today. An Arm seat, and a param
//! LIST's own arbitrary arity, name no `At` a pattern can hold open
//! yet — a param's own name and type ARE reachable, structurally,
//! through `Code.fn_params` (features/code.av), never through this
//! matcher's own recursion.

/// One `${...}` occurrence in a quote pattern's body, in written
/// order: the bare name its content reads, when it is one — a
/// compound expression (`${f(x)}`) reads null — the seat it stands
/// in, and whether it was written `${..name}` — a RUN, binding a
/// `List<Code>` span of siblings rather than one `Code`.
export type QuoteHole = { name: string?, kind: HoleKind, run: bool }

/// Every hole a quote pattern's body carries, raw, one per
/// occurrence — never deduped: a name written twice is two
/// occurrences of ONE binder, and the caller decides what that means.
export fn quote_pat_holes(store: SyntaxArena, body: ExprId) -> List<QuoteHole> {
    let q? = store.expr(body).body_of() else { return [] }
    let kinds = hole_kinds(store, body)
    [QuoteHole { name: store.ident_name(h), kind: kinds[k], run: store.is_run_hole(h) } for k, h in q.holes]
}

/// Whether this occurrence names a binder the matcher can hold — an
/// Expression, a Statement or a Run seat, read as a bare name; a
/// Name, a Binder or a Type seat too, when it is LONE at its own
/// field (`quote_pat_reached` is the precise, position-aware gate
/// typing refuses against — this is the loose, kind-only test
/// `quote_pat_names` dedupes with).
export fn quote_hole_ok(h: QuoteHole) -> bool {
    h.name != null &&
        (h.kind is .Expression ||
            h.kind is .Statement ||
            h.kind is .Name ||
            h.kind is .Binder ||
            h.kind is .Run ||
            h.kind is .Type)
}

/// Whether a hole's kind binds TEXT (a name's own written text)
/// rather than CODE (a store position).
export fn quote_hole_is_text(k: HoleKind) -> bool { k is .Name || k is .Binder }

/// The DISTINCT binder names these holes read, first-occurrence
/// order — an occurrence `quote_hole_ok` refuses binds nothing. Read
/// for SCOPE (every name a rule's body may resolve); `quote_pat_is_text`
/// says what each one answers.
export fn quote_pat_names(holes: List<QuoteHole>) -> List<string> {
    let named = [h.name! for h in holes if quote_hole_ok(h)]
    [n for i, n in named if named.index_of(n) == i]
}

/// Whether binder `n`'s occurrences are all a NAME or BINDER seat —
/// its own text, not code.
export fn quote_pat_is_text(holes: List<QuoteHole>, n: string) -> bool {
    [h.kind for h in holes if h.name == n].any(quote_hole_is_text)
}

/// Whether binder `n` mixes a text seat, a type seat or a code seat —
/// one binder answers one type, so this is refused before a pattern
/// is matched or lowered. TWO independent buckets, since a TYPE seat
/// is neither text nor code: mixing text with anything else, or
/// mixing a type seat with anything but another type seat.
export fn quote_pat_mixed(holes: List<QuoteHole>, n: string) -> bool {
    let mine = [h.kind for h in holes if h.name == n]
    let texts = mine.any(quote_hole_is_text) && !mine.all(quote_hole_is_text)
    let types = mine.any(it is .Type) && !mine.all(it is .Type)
    texts || types
}

/// Whether ANY occurrence of binder `n` was written `${..n}` — a RUN.
export fn quote_pat_is_run(holes: List<QuoteHole>, n: string) -> bool {
    [h.run for h in holes if h.name == n].any(it)
}

/// Whether binder `n` was ever written at a TYPE seat — a written
/// `TypeRef`, never code or text. `quote_pat_is_text`'s twin; a
/// binder MIXING a type seat with any other kind is refused before
/// either reads it (`quote_pat_mixed`).
export fn quote_pat_is_type(holes: List<QuoteHole>, n: string) -> bool {
    [h.kind for h in holes if h.name == n].any(it is .Type)
}

/// Whether binder `n` mixes a RUN occurrence with an ordinary one —
/// `quote_pat_mixed`'s twin: one binder answers one SHAPE (`Code` or
/// `List<Code>`), so this is refused the same way.
export fn quote_pat_run_mixed(holes: List<QuoteHole>, n: string) -> bool {
    let mine = [h.run for h in holes if h.name == n]
    mine.any(it) && !mine.all(it)
}

/// Two run holes with nothing between them, anywhere under `at` — no
/// anchored scan can split them (design's own open item, §9). Walks
/// every node's own flattened kids, since that is the one list an
/// anchored pass ever runs over.
export fn quote_pat_adjacent_runs(store: SyntaxArena, at: At, holes: List<QuoteHole>) -> bool {
    let kids = store.kids_at(at)
    let runs = [is_run_kid(store, k, holes) for k in kids]
    if has_adjacent(runs) { return true }
    kids.any(quote_pat_adjacent_runs(store, it, holes))
}

fn has_adjacent(runs: List<bool>) -> bool {
    [j for j in 0..runs.length - 1].any(runs[it] && runs[it + 1])
}

/// Whether `at` is itself a run-hole occurrence — `quote_hole_at`'s
/// answer, checked against that hole's own `run` flag. Exported for
/// the ROOT itself: a pattern that is NOTHING BUT a run
/// (`quote { \${..xs} }`) has no enclosing `Node` to bind a span
/// inside, so `features/quote/check.av` refuses it before this ever
/// reaches a match.
export fn is_run_kid(store: SyntaxArena, at: At, holes: List<QuoteHole>) -> bool {
    let w? = quote_hole_at(store, at) else { return false }
    holes[w].run
}

/// The single node a quote pattern's body names — the root its Shape
/// is built from — or absence when the body is not exactly one
/// statement with no arms.
export fn quote_pat_root(store: SyntaxArena, body: ExprId) -> At? {
    let q? = store.expr(body).body_of() else { return null }
    match q.view {
        .Verbatim(stmts, arms) if arms.is_empty() && stmts.length == 1 -> root_of(store, stmts[0]),
        .Verbatim(_, _) or .None or .Expanded(_) -> null,
    }
}

/// A rule's own INDEX: the root kind EVERY pattern narrows to — each
/// arm, each `or` alternative — so the pass tries the rule at a node
/// of ANY of them, never at every node just because two arms
/// disagree. Absence ("any node") only when a SINGLE pattern cannot
/// narrow at all; may repeat a kind when two patterns share one, and
/// the caller reads it as a set.
export fn root_kind_of(store: SyntaxArena, arms: List<Arm>) -> List<int>? {
    let pats = flatten([a.pats for a in arms])
    if pats.is_empty() { return null }
    let kinds = [pat_root_kind(store, p) for p in pats]
    if kinds.any(it == null) { return null }
    [k! for k in kinds]
}

/// EVERY NODE KIND A RULE'S PATTERNS NAME, as `kind_at` folds them — what
/// a running compiler checks a rule another compiler baked against.
export fn pattern_kinds(store: SyntaxArena, arms: List<Arm>) -> List<int> {
    let roots = flatten([some_list(quote_root(store, p)) for a in arms for p in a.pats])
    let kinds = [store.kind_at(at) for root in roots for at in nodes_under(store, root)]
    [k for i, k in kinds if kinds.index_of(k) == i]
}

fn quote_root(store: SyntaxArena, p: PatId) -> At? {
    let body? = match store.pat(p) { .Quote(b) -> b, rest -> null } else { return null }
    quote_pat_root(store, body)
}

/// A node and every node under it.
fn nodes_under(store: SyntaxArena, at: At) -> List<At> {
    [at].concat(flatten([nodes_under(store, k) for k in store.kids_at(at)]))
}

/// One pattern's own INDEX: when it is a `Pat.Quote`, rooted
/// (`quote_pat_root`), its root folded to its shallow kind
/// (`shallow_at` — Expr vs Stmt, which variant, and every field). A
/// ROOT whose own NAME or TYPE field is a lone hole, or whose own kids
/// hold a run hole, folds to its KIND alone (`kind_at`): a subject is
/// indexed by its raw fold, which a root blind to one field could never
/// agree with, and by its kind, which it always does. Absence ("any
/// node") only when nothing narrows: not a quote, no single root, or a
/// root that IS a hole.
fn pat_root_kind(store: SyntaxArena, p: PatId) -> int? {
    let body? = match store.pat(p) { .Quote(b) -> b, rest -> null } else { return null }
    let at? = quote_pat_root(store, body) else { return null }
    // a root that IS the whole hole binds any subject, so its index
    // is the placeholder's own fold — meaningless, and never a real
    // subject's; "any node" is what a bare-hole root means
    if quote_hole_at(store, at) != null { return null }
    // a root with a hole in its own field, or a run among its kids, is
    // known by its kind alone
    if !own_hole_indices(store, at).is_empty() { return store.kind_at(at) }
    let holes = quote_pat_holes(store, body)
    if store.kids_at(at).any(is_run_kid(store, it, holes)) { return store.kind_at(at) }
    store.shallow_at(at)
}

/// A statement's own root: an expression statement stands as ITS
/// expression, every other statement stands as itself — reading
/// whatever shape `s` already carries, never reshaping it here. A
/// both-branches-answering `if`/`else` arrives already promoted to
/// `Stmt.ExprStmt(Expr.If(...))` when it is a quote body's own tail
/// (`build_quote`) or a program's (`program_stmts`) — the SAME tail
/// law, applied at the SAME parse time, in both trees — so a written
/// pattern and the subject it is matched against agree by construction
/// (avra-8sb5.25.21); `compiler/rule_examples.av`'s `example_root`
/// shares this door for exactly that reason.
export fn root_of(store: SyntaxArena, s: StmtId) -> At {
    match store.stmt(s) { .ExprStmt(v) -> At.Expr(v), rest -> At.Stmt(s) }
}

/// The quote pattern's own Shape: like `shape_at`, but a hole is
/// identified by the NAME its placeholder decodes to, not by arena
/// identity — two `${x}` occurrences anywhere under `at` share ONE
/// binder because they read the same name, whether both sit at code
/// seats, both at name seats, or (refused before this runs) a mix of
/// the two. `names` is the pattern's own deduped binder list
/// (`quote_pat_names`), so a binder's index here is its position
/// there. Total once every hole is `quote_pat_reached` — the caller's
/// typing already refused otherwise.
export fn quote_pat_shape(store: SyntaxArena, at: At, holes: List<QuoteHole>, names: List<string>) -> Shape {
    let w? = quote_hole_at(store, at) else {
        // `opens` is `[]` at a node with neither field open, one
        // `Open` at a node with a NAME or a TYPE open alone, and both
        // at a node with a name and a type open at once
        // (`let ${x}: ${T} = ...`) — `TypedNode` holds every one of
        // these shapes.
        let opens = node_opens(store, at, holes, names)
        let kids = [quote_pat_shape(store, kid, holes, names) for kid in store.kids_at(at)]
        return Shape.TypedNode(typed_node_shallow_at(store, at, kids, opens), kids, opens)
    }
    let index = names.index_of(holes[w].name!)
    if holes[w].run { Shape.Run(index) } else { Shape.Hole(index) }
}

/// `at`'s own OPEN fields, as a `TypedNode` is being built: a NAME
/// open when a lone hole stands at its name-bearing field, a TYPE
/// open the same way at its written-type field — both, in that
/// order, when it carries both (`let ${x}: ${T} = ...`).
fn node_opens(store: SyntaxArena, at: At, holes: List<QuoteHole>, names: List<string>) -> List<Open> {
    let named = [Open.Name(binder_index(holes, names, i)) for i in some_list(name_hole_at(store, at))]
    named
        .concat([Open.Type(binder_index(holes, names, i)) for i in some_list(type_hole_at(store, at))])
}

fn binder_index(holes: List<QuoteHole>, names: List<string>, i: int) -> int {
    names.index_of(holes[i].name!)
}

/// Every raw hole index this pattern's Shape can hold open — the
/// SAME walk `quote_pat_shape` takes, answering positions instead of
/// building. Typing refuses any hole whose index is absent here
/// (`features/quote/check.av`'s `quote_pat_types`), which is what
/// makes a non-lone Name or Type occurrence (`l${x}_y`, `${T}<int>`)
/// a refusal rather than a silently-ignored one: `quote_hole_ok`'s
/// kind-only test cannot tell the two apart, this walk can.
export fn quote_pat_reached(store: SyntaxArena, at: At) -> List<int> {
    let w? = quote_hole_at(store, at) else {
        let kids = flatten([quote_pat_reached(store, kid) for kid in store.kids_at(at)])
        return own_hole_indices(store, at).concat(kids)
    }
    [w]
}

/// The occurrence index `at`'s own position IS, when it stands as a
/// lone hole placeholder filling a whole expression or statement;
/// null for every other seat — a Pat, a Field or a Param included,
/// none a whole-node hole this matcher can hold open yet.
fn quote_hole_at(store: SyntaxArena, at: At) -> int? {
    match at {
        .Expr(e) -> lone_hole_of(store.ident_name(e)),
        .Stmt(s) -> store.hole_stmt(s),
        .Pat(_) or .Field(_, _) or .Param(_, _) -> null,
    }
}

/// The occurrence index `at`'s own NAME field is, when that field is
/// nothing but a hole — absence when the kind names no field
/// (`own_name_at`'s catalog) or the field carries more than the hole.
fn name_hole_at(store: SyntaxArena, at: At) -> int? {
    let t? = own_name_at(store, at) else { return null }
    lone_hole_of(t)
}

/// The occurrence index `at`'s own TYPE field is, when that field is
/// nothing but a hole — absence when the kind names no field
/// (`own_type_at`'s catalog), when there is no field written at all
/// (an unannotated `let`, an untyped param — `own_type_at` answers
/// null the same as for a kind with none), or when the field carries
/// more than the hole (`${T}<int>`, `${T}?`) — a LONE hole fills the
/// whole field only when it stands utterly alone there, `name_hole_at`'s
/// law over a `TypeRef` instead of a `string`.
fn type_hole_at(store: SyntaxArena, at: At) -> int? {
    let t? = own_type_at(store, at) else { return null }
    if !bare_type(t) { return null }
    lone_hole_of(t.name)
}

/// Whether a written type carries nothing but its own name — no `?`,
/// no `<...>`, no `dyn`, no `or` union.
fn bare_type(t: TypeRef) -> bool {
    t.args.is_empty() && !t.optional && !t.dynamic && !t.arrow && t.alternatives.is_empty()
}

/// `at`'s own open-field hole indices, raw (into the quote's OWN
/// `holes`, never yet the pattern's deduped binder position) — its
/// NAME hole's, its TYPE hole's, both when it carries both, empty
/// when it carries neither.
fn own_hole_indices(store: SyntaxArena, at: At) -> List<int> {
    some_list(name_hole_at(store, at)).concat(some_list(type_hole_at(store, at)))
}

/// The index a LONE hole's own text names, or absence — `${k}`
/// alone, never `l${k}_x`: this matcher wildcards only a whole seat.
fn lone_hole_of(text: string?) -> int? {
    let t? = text else { return null }
    let h? = hole_name(t) else { return null }
    if !h.lone() { return null }
    h.holes[0]
}
