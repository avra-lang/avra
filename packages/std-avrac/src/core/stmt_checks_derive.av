//! `StmtChecks` — a statement's typing rule: what it checks, and what it binds. A
//! `collect enum Stmt: StmtChecks` derives the empty impl for a member with no rule of its own: it
//! checks each expression it holds against nothing and binds nothing.
//!
//! It stands ALONE in this file on purpose (CLAUDE.md).
use @std.meta.{Type as MetaType, Directive, beside}

export trait StmtChecks {
    /// What this statement checks, and what it binds in the scope it stands in.
    fn stmt_checked(mut cx: Checking, s: StmtId) { cx.stmt_held_checked(s) }

    static fn derive(t: MetaType) -> List<Directive> {
        [beside(t, quote { impl StmtChecks for ${t} {} })]
    }
}
