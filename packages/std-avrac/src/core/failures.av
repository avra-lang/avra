//! A FAILURE LEAVING: a `Result`'s `Err` made, and one carried into the fn's own `Result`. The `Err`
//! is tag 1 beside its word or in a box behind its tag, so a failure whose error the fn's `Result`
//! holds the same way leaves as it is, and any other is made again in the fn's layout.

impl Lowering {
    /// The `Err` of the `Result` `into`, carrying `r`.
    mut fn failure_of(into: SignedType, r: Reg) -> Reg { self.tagged_value(self.laid_out(into), 1, [r]) }

    /// The fn leaves here failing with `failure`.
    mut fn fail_exit(failure: Reg) {
        self.ended_from(0, Leaving.Failing)
        self.kept_once(failure)
        self.emit(Ins.FnExit(failure))
    }

    /// The failure `v`, a `Result` of `from`, as the fn's own `Result` holds it: itself where the error
    /// sides are one type or both unions and both lay out alike; its error made again in the fn's
    /// layout where they're laid out apart; a union's member read out where only `from`'s is a union.
    /// A member boxed into the fn's union isn't lowered yet.
    mut fn propagated(v: Reg, from: SignedType) -> Reg {
        let into = self.answer
        if !into.resulted() || !from.resulted() { return self.missed_as("a failure carried into what isn't a `Result`") }
        let fe = from.args[1]
        let ie = into.args[1]
        let was_union = !fe.alternatives.is_empty()
        let agrees = fe.spelled() == ie.spelled() || was_union && !ie.alternatives.is_empty()
        if agrees && self.laid_out(from).inline() == self.laid_out(into).inline() { return v }
        if !agrees && !was_union { return self.missed_as("a failure boxed into its union, tagged by its type's number") }
        let error = self.payload_at(v, 0, [self.laid_out(fe)])
        if agrees { return self.failure_of(into, error) }
        self.failure_of(into, self.payload_at(error, 0, [self.laid_out(ie)]))
    }

    /// Whether `ty`, a value an `Err` of `into` carries, is the error as the fn's `Result` holds it,
    /// rather than a member its union boxes.
    fn fails_as(ty: SignedType?, into: SignedType) -> bool {
        let err = into.args[1]
        err.alternatives.is_empty() || ty?.spelled() == err.spelled()
    }
}
