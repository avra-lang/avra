//! The ids a node holds: on a tape an id is the node it names, placed where that was written.
use @std.program.syntax_tape.{TapeWriter}

/// Says where the next node was written, or that it has no place.
fn placed(mut tape: TapeWriter, span: Span?) {
    let written? = span else {
        let _ = tape.unplaced()
        return
    }
    let _ = tape.place(written.lo, written.hi - written.lo)
}

impl Taped for ExprId {
    fn taped(tree: SyntaxArena, mut tape: TapeWriter) {
        placed(tape, tree.expr_span(self))
        tree.expr(self).taped_node(tree, tape)
    }
}

impl Taped for StmtId {
    fn taped(tree: SyntaxArena, mut tape: TapeWriter) {
        placed(tape, tree.stmt_span(self))
        tree.stmt(self).taped_node(tree, tape)
    }
}

impl Taped for PatId {
    fn taped(tree: SyntaxArena, mut tape: TapeWriter) {
        placed(tape, tree.pat_span(self))
        tree.pat(self).taped_node(tree, tape)
    }
}
