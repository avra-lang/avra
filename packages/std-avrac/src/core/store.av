//! The node store: append-only arenas in one table, side tables keyed
//! by id, and the mint/access seam. The node MODEL lives in nodes.av.

/// A STATEMENT'S MARKS: `export`, `mut fn`, `once fn`, `static fn` — the
/// fn-shaped keywords a declaration wears, one bitset instead of four
/// parallel `List<bool>` keyed alike. `grammars` does NOT fold in here
/// despite sharing the same StmtId key: it carries a PAYLOAD (the format a
/// `grammar` declaration read), so it stays its own side table — a
/// payload wearing a nullable field inside this struct would read as
/// "grammar-ness is a mark" when it is a kept value.
export type StmtMarks = { is_exported: bool, is_mutating: bool, is_once: bool, is_static: bool }

fn no_stmt_marks() -> StmtMarks {
    StmtMarks { is_exported: false, is_mutating: false, is_once: false, is_static: false }
}

export type NodeStore = {
    exprs: Arena<Expr>,
    expr_fingerprints: List<int>,
    stmts: Arena<Stmt>,
    stmt_fingerprints: List<int>,
    marks: List<StmtMarks>,
    // the format a `grammar` declaration read, by its statement
    grammars: List<GrammarSpec?>,
    // `@name(args)` marks per statement, in written order
    annotations: List<List<Annotation>>,
    // declaration-leading `///` lines; absent on synthesized nodes
    docs: List<List<string>?>,
    // the offset each doc group's FIRST `///` was written at, and -1
    // for none, so the printer can put a remark between a doc and its
    // declaration back in the author's order
    doc_ats: List<int>,
    // plain `//` lines, by source offset — printing only
    remarks: List<Remark>,
    pats: List<Pat>,
    pat_spans: List<Span?>,
    pat_fingerprints: List<int>,
    // a lambda written as a TRAILING BLOCK (`f(a) { x -> … }`)
    trailing: List<bool>,
    // a call written as a TYPE LITERAL (`v.type(T)`), and a NAME
    // written inside one — a hole
    type_lits: List<bool>,
    holes: List<bool>,
    // each quote by the offset it starts at — how a template VALUE
    // names its node
    quotes_at: Map<string, int>,
    // the file's sublanguage blocks, in order, and each one's body
    // offset in the source; what their grammars refused; the node
    // runs their actions minted, with the library each names
    sublangs: List<ExprId>,
    body_starts: Map<string, int>,
    block_voices: List<BlockVoice>,
    foreign: List<ForeignRange>,
}

export fn new_node_store() -> NodeStore {
    NodeStore {
        exprs: new_arena(), expr_fingerprints: [],
        stmts: new_arena(), stmt_fingerprints: [], marks: [], grammars: [], annotations: [], docs: [], doc_ats: [], remarks: [],
        pats: [], pat_spans: [], pat_fingerprints: [], trailing: [], type_lits: [], holes: [], quotes_at: {}, sublangs: [], body_starts: {}, block_voices: [], foreign: [],
    }
}

impl NodeStore {
    /// The one expression-allocation seam.
    fn alloc_expr(e: Expr, span: Span? = null) -> ExprId {
        self.expr_fingerprints.push(self.fingerprint_expr(e))
        self.trailing.push(false)
        self.type_lits.push(false)
        self.holes.push(false)
        ExprId { index: self.exprs.add(e, span) }
    }

    /// A lambda written as a TRAILING BLOCK — the mark is part of the
    /// node: the block's refusals speak in the block's words.
    fn mark_trailing(e: ExprId) {
        self.trailing.set(e.index, true)
        self.expr_fingerprints.set(e.index, fp(111, [self.expr_fingerprints[e.index]]))
    }

    fn is_trailing(e: ExprId) -> bool {
        self.trailing[e.index]
    }

    /// The seat an argument names, when it is written `name: value`.
    fn arg_label(a: ExprId) -> string? {
        match self.expr(a) {
            .Named(name, _) -> name.of,
            _ -> null,
        }
    }

    /// An argument's value, its name stripped.
    fn unnamed(a: ExprId) -> ExprId {
        match self.expr(a) {
            .Named(_, value) -> value,
            _ -> a,
        }
    }

    /// A call's arguments in SEAT order, names stripped; a seat no
    /// argument writes is skipped. A callee that names fewer seats
    /// than it is handed keeps the written order.
    fn seated_args(args: List<ExprId>, seats: List<string>) -> List<ExprId> {
        if seats.length < args.length { return [self.unnamed(a) for a in args] }
        [self.unnamed(args[i]) for i in self.seat_plan(args, seats) if i >= 0]
    }

    /// Which argument fills each seat: its index among `args`, or -1
    /// for a seat no argument writes. A positional argument fills the
    /// seat at its own position; a named one, the seat of its name.
    fn seat_plan(args: List<ExprId>, seats: List<string>) -> List<int> {
        let labels = [self.arg_label(a) ?? "" for a in args]
        [filler(labels, seats[j], j) for j in 0..seats.length]
    }

    /// A call written as a TYPE LITERAL — the mark is part of the
    /// node: a receiver that cannot answer refuses in the literal's words.
    fn mark_type_lit(e: ExprId) {
        self.type_lits.set(e.index, true)
        self.expr_fingerprints.set(e.index, fp(112, [self.expr_fingerprints[e.index]]))
    }

    fn is_type_lit(e: ExprId) -> bool {
        self.type_lits[e.index]
    }

    /// A name written inside a type literal — a HOLE, the id it
    /// names: a binding of the wrong type refuses as a hole.
    fn mark_hole(e: ExprId) {
        self.holes.set(e.index, true)
        self.expr_fingerprints.set(e.index, fp(113, [self.expr_fingerprints[e.index]]))
    }

    fn is_hole(e: ExprId) -> bool {
        self.holes[e.index]
    }

    /// Where a quote's runs of text start in the source, one per part.
    fn mark_quote_at(e: ExprId) {
        let sp: Span? = self.expr_span(e)
        if sp != null { self.quotes_at.set("${sp!.lo}", e.index) }
    }

    /// The quote starting at a source offset, when one does.
    fn quote_at(offset: int) -> ExprId? {
        let i? = self.quotes_at.get("${offset}") else { return null }
        ExprId { index: i }
    }

    /// A sublanguage block and where its body starts in the source.
    fn mark_sublang(e: ExprId, body_at: int) {
        self.sublangs.push(e)
        self.body_starts.set("${e.index}", body_at)
    }

    fn body_start(e: ExprId) -> int { self.body_starts.get("${e.index}") ?? 0 }

    fn speak_block(v: BlockVoice) { self.block_voices.push(v) }

    fn note_foreign(lo: int, hi: int, path: string) { self.foreign.push(ForeignRange { lo: lo, hi: hi, path: path }) }

    /// The block words the file's blocks wear.
    fn sublang_words() -> List<string> {
        [(self.expr(e)).body_of()?.word ?? "" for e in self.sublangs]
    }

    fn expansion_of(e: ExprId) -> ExprId? {
        match self.expr(e) {
            .Body(_, _, _, .Expanded(x)) -> x,
            _ -> null,
        }
    }

    /// The expressions a body's view holds, for the complete walk: a
    /// parsed quote's statements and arms, or the expansion that
    /// STANDS IN PLACE OF the holes once the file resolves.
    fn body_view_children(v: BodyView) -> List<ExprId> {
        match v {
            .None -> [],
            .Verbatim(stmts, arms) -> self.stmts_exprs(stmts).concat([a.value for a in arms]),
            .Expanded(expansion) -> self.expr_children(expansion),
        }
    }

    /// A body view's content identity. An EXPANSION IS NOT PART OF
    /// WHAT A NODE IS — it is what the holes expand TO — so it folds
    /// to nothing and a node wears one identity either side of its
    /// own expansion.
    fn view_fp(v: BodyView) -> int {
        match v {
            .None -> fp(140, []),
            .Verbatim(stmts, arms) -> fp(141, [fp_list(self.stmt_fps(stmts)), fp_list(self.arm_fps(arms))]),
            .Expanded(_) -> fp(142, []),
        }
    }

    /// The hole a statement IS — a lone placeholder standing as a
    /// whole statement — by index, or null.
    fn hole_stmt(s: StmtId) -> int? {
        let v? = match self.stmt(s) { .ExprStmt(v) -> v, _ -> null } else { return null }
        let hole: HoleName? = hole_name(self.ident_name(v) ?? "")
        if hole == null || !hole!.lone() { return null }
        hole!.holes[0]
    }

    /// Whether a statement DECLARES: a fn, a type, an enum, a trait,
    /// an impl, a top-level const.
    fn declares(s: StmtId) -> bool {
        self.declared_kind(s) != null || self.impl_parts(s) != null || self.const_value(s) != null
    }

    /// THE CALL PROTOCOL: the node with `blocks` appended to its
    /// arguments — a trailing block is a call's LAST argument, and a
    /// name or a field read with no parentheses is a call with none.
    /// Null for every shape that is not a call.
    fn called_with(e: ExprId, blocks: List<ExprId>) -> Expr? {
        match self.expr(e) {
            .Call(callee, pins, args) -> Expr.Call(callee, pins, args.concat(blocks)),
            .MethodCall(subject, name, args) -> Expr.MethodCall(subject, name, args.concat(blocks)),
            .CallValue(subject, args) -> Expr.CallValue(subject, args.concat(blocks)),
            .Ident(name) -> Expr.Call(name, [], blocks),
            .Prop(subject, name) -> Expr.MethodCall(subject, name, blocks),
            .IntLit(_) or .FloatLit(_) or .StrLit(_) or .BoolLit(_) or .NullLit or .Error or .Binary(_, _, _)
                or .Not(_) or .ListLit(_) or .MapLit(_, _) or .Body(_, _, _, _) or .If(_, _, _) or .Receiver
                or .When(_, _, _) or .Block(_, _) or .StructLit(_, _, _) or .Index(_, _)
                or .With(_, _, _) or .Match(_, _) or .Catch(_, _, _, _) or .MatchOpt(_, _, _, _)
                or .Chain(_, _) or .Coalesce(_, _) or .Force(_) or .Propagate(_)
                or .Lambda(_, _) or .Spawn(_) or .Is(_, _) or .Comp(_, _, _, _, _, _) or .VariantLit(_, _) or .Named(_, _) -> null,
        }
    }

    /// An argument the PRONOUN rides becomes an implicit one-param
    /// lambda — `xs.map(it * 2)` is `xs.map((it) -> it * 2)`, and the
    /// expected-type channel seats it like any other. The wrap is the
    /// pronoun's WHOLE mechanism: nothing downstream knows it exists.
    fn pronouned(a: ExprId) -> ExprId {
        if !self.pronoun_rides(a) { return a }
        let label? = self.arg_label(a) else { return self.alloc_expr(Expr.Lambda([pronoun_param], a), self.expr_span(a)) }
        // a named argument keeps its name: the wrap goes inside it
        self.alloc_expr(Expr.Named(Plain(label), self.pronouned(self.unnamed(a))), self.expr_span(a))
    }

    /// The value a tail statement answers with: an expression
    /// statement's expression, or an if-chain every branch of which
    /// answers — rebuilt as the if-expression over branch blocks, so
    /// a chain in tail position is a value wherever a block is.
    fn answer_of(s: StmtId) -> ExprId? {
        match self.stmt(s) {
            .ExprStmt(v) -> v,
            .Discard(_) -> null,
            .IfStmt(c, t, e) -> self.chain_value(s, c, t, e),
            .Let(_, _, _) or .MutLet(_, _, _) or .ConstDecl(_, _, _) or .Assign(_, _) or .Use(_, _, _) or .FnDecl(_, _, _, _, _) or .ExternFn(_, _, _) or
            .While(_, _) or .For(_, _, _, _, _, _) or .ForEach(_, _, _, _) or .Return(_) or .Fail(_) or
            .LetElse(_, _, _) or .StructDecl(_, _, _) or .NamedType(_, _, _) or .EnumDecl(_, _, _) or .ImplDecl(_, _, _) or
            .TraitDecl(_, _) or .SyntaxDecl(_, _) or .Spec(_, _) or .Defer(_, _) or .Rule(_, _, _) or .Error -> null,
        }
    }

    /// A chain answers when it has an else and both sides answer.
    fn chain_value(s: StmtId, c: ExprId, t: List<StmtId>, e: List<StmtId>) -> ExprId? {
        if e.is_empty() { return null }
        let tv: ExprId? = self.branch_value(t)
        let ev: ExprId? = self.branch_value(e)
        if tv == null || ev == null { return null }
        self.alloc_expr(Expr.If(c, tv!, ev!), self.stmt_span(s))
    }

    /// THE TAIL LAW: a scope's tail STATEMENT already answered a
    /// non-null VALUE (the caller found one); this is what wrapping it
    /// back into the scope means, and both `block_of` (an explicit `{
    /// }`) and `branch_value` (an if-chain's branch) call it so the
    /// law can only be spelled once. AN ANNOTATED TAIL STAYS A
    /// STATEMENT: kept in `stmts`, where `type_annotations` reads it,
    /// and still answers as the value — one node walked both ways,
    /// safe because no seat's receiver ever fits a non-declaration, so
    /// an annotated tail always refuses and the doubled node never
    /// reaches lowering. A LONE VALUE WEARS ITS OWN SPAN: the scope's
    /// braces are the author's form, so a diagnostic about the answer
    /// points at the answer, never at them. `span` wraps every other
    /// case — a Builder's matched branch, or the tail statement's own.
    fn tail_scoped(stmts: List<StmtId>, tail: StmtId, value: ExprId, span: Span?) -> ExprId {
        if !self.annotations_of(tail).is_empty() { return self.alloc_expr(Expr.Block(stmts, value), span) }
        if stmts.length == 1 { return self.alloc_expr(Expr.Block([], value), self.expr_span(value)) }
        self.alloc_expr(Expr.Block(stmts.slice(0, stmts.length - 1), value), span)
    }

    /// A branch's statements as its answer: the one expression when
    /// that is all the branch holds, else a block answering with its
    /// tail — `null` when the branch neither leaves nor answers, which
    /// refuses the whole chain as a value (`chain_value`).
    fn branch_value(stmts: List<StmtId>) -> ExprId? {
        let held? = stmts.last() else { return null }
        let last = held
        // a branch that LEAVES answers the fn's promise — a block
        // whose value is absent, as the block law reads it
        if self.diverges(last) { return self.alloc_expr(Expr.Block(stmts, null), self.stmt_span(last)) }
        let value? = self.answer_of(last) else { return null }
        self.tail_scoped(stmts, last, value, self.stmt_span(last))
    }

    /// The statements with a trailing if-chain that answers turned
    /// into the expression statement it is — the top level's tail
    /// law, the same as a block's. THE MINT REPLACES THE STATEMENT,
    /// so an annotated chain is left UNCONVERTED: the fresh copy
    /// would carry no annotation, and the original would no longer
    /// stand in the list for `type_annotations` to read.
    fn answered(stmts: List<StmtId>) -> List<StmtId> {
        let held? = stmts.last() else { return stmts }
        let last = held
        let chained: bool = match self.stmt(last) {
            .IfStmt(_, _, e) -> !e.is_empty(),
            _ -> false,
        }
        if !chained || !self.annotations_of(last).is_empty() { return stmts }
        let value? = self.answer_of(last) else { return stmts }
        stmts.slice(0, stmts.length - 1).concat([self.alloc_stmt(Stmt.ExprStmt(value), self.stmt_span(last))])
    }

    /// The one pattern-allocation seam.
    fn alloc_pat(p: Pat, span: Span? = null) -> PatId {
        self.pat_fingerprints.push(self.fingerprint_pat(p))
        self.pat_spans.push(span)
        self.pats.push(p)
        PatId { index: self.pats.length - 1 }
    }

    fn pat(id: PatId) -> Pat { self.pats[id.index] }
    fn pat_span(id: PatId) -> Span? { self.pat_spans[id.index] }
    fn pat_fingerprint(id: PatId) -> int { self.pat_fingerprints[id.index] }

    /// The names a pattern binds, in pre-order — the arm's bind
    /// order, which every pass keys by index.
    /// A pattern's BINDERS in pre-order — the order that indexes
    /// `Binding.Pattern`. A format's holes bind under the format's own
    /// node: a hole is not a sub-pattern.
    fn pattern_binds(id: PatId) -> List<Binder> {
        match self.pat(id) {
            .Bind(name) -> [Binder { pat: id, name: name.of }],
            .Variant(_, args) -> flatten([self.pattern_binds(a) for a in args]),
            .Format(_, parts) -> named_binders(id, bound_names(parts)),
            .Quote(body) -> named_binders(id, quote_pat_names(quote_pat_holes(self, body))),
            .Wild or .Rest or .Lit(_) -> [],
        }
    }

    /// A binding pattern's name; absence for any other pattern.
    fn bind_name(id: PatId) -> string? {
        match self.pat(id) {
            .Bind(name) -> name.of,
            _ -> null,
        }
    }

    /// A pattern nothing can refuse: a hole or a name.
    fn irrefutable(id: PatId) -> bool {
        match self.pat(id) {
            .Wild or .Rest or .Bind(_) -> true,
            .Variant(_, _) or .Lit(_) or .Format(_, _) or .Quote(_) -> false,
        }
    }

    /// The pattern's fingerprint parts: its own shape, then its
    /// children's.
    fn fingerprint_pat(p: Pat) -> int {
        match p {
            .Wild -> fp(50, []),
            .Rest -> fp(51, []),
            .Bind(name) -> fp(52, [fp_str(name.of)]),
            .Variant(name, args) -> fp(53, [fp_str(name.of), fp_list([self.pat_fingerprint(a) for a in args])]),
            .Lit(v) -> fp(54, [self.expr_fingerprint(v)]),
            .Format(head, parts) -> fp(129, [fp_str(head), fp_list([hole_fp(p) for p in parts])]),
            .Quote(body) -> fp(143, [self.expr_fingerprint(body)]),
        }
    }

    /// An arm list's fingerprint parts — ONE HASH PER ARM, never a
    /// run of them. Flattening the patterns and the value into a
    /// single list loses the arm BOUNDARIES, so one arm taking three
    /// alternatives and two arms taking one each produce the same
    /// sequence and the same fingerprint. Two different programs,
    /// one identity, and the memo kernel cannot tell them apart.
    fn arm_fps(arms: List<Arm>) -> List<int> {
        [fp(29, [fp_list([self.pat_fingerprint(p) for p in a.pats]), fp_list([self.expr_fingerprint(g) for g in some_list(a.guard)]), self.expr_fingerprint(a.value)]) for a in arms]
    }

    /// The one statement-allocation seam.
    fn alloc_stmt(s: Stmt, span: Span? = null) -> StmtId {
        self.stmt_fingerprints.push(self.fingerprint_stmt(s))
        self.marks.push(no_stmt_marks())
        self.grammars.push(null)
        self.annotations.push([])
        self.docs.push(null)
        self.doc_ats.push(-1)
        StmtId { index: self.stmts.add(s, span) }
    }

    /// Store the declaration-leading documentation as part of the
    /// statement's identity: tools observe it, so a doc-only edit
    /// must not be cut off by the parsed-program memo. Lines never
    /// contain a newline, so the joined text is a lossless key.
    /// The file's plain `//` lines, by the offset each was written at.
    mut fn keep_remarks(rs: List<Remark>) {
        self.remarks = rs
    }

    /// Store the declaration-leading documentation as part of the
    /// statement's identity: tools observe it, so a doc-only edit
    /// must not be cut off by the parsed-program memo. Lines never
    /// contain a newline, so the joined text is a lossless key.
    fn document(s: StmtId, lines: List<string>, at: int) {
        self.docs.set(s.index, lines)
        self.doc_ats.set(s.index, at)
        self.stmt_fingerprints.set(s.index, fp(115, [self.stmt_fingerprints[s.index], fp_str(lines.join("\n"))]))
    }

    fn doc_comment(s: StmtId) -> List<string>? {
        self.docs[s.index]
    }

    /// Where a declaration's doc group began, or -1 when it has none.
    fn doc_at(s: StmtId) -> int {
        self.doc_ats[s.index]
    }

    /// The statement whose span begins at or after `at`, earliest
    /// first — where a doc group's anchor lands.
    fn statement_after(at: int) -> StmtId? {
        // LICENSED I4: a min-by fold; the subset has no min_by
        mut best: StmtId? = null
        mut best_lo = 0
        for i in 0..self.stmts.count() {
            let s = StmtId { index: i }
            let span = self.stmt_span(s)
            if span != null {
                let lo = span!.lo
                if lo >= at && (best == null || lo < best_lo) {
                    best = s
                    best_lo = lo
                }
            }
        }
        best
    }

    /// `@name(args)` crossed this declaration: the call the compiler
    /// makes over it, recorded as a fact of the declaration — its
    /// callee an ident node, so every pass reads it as one. Appends —
    /// `annotations_of` reads in the order `annotate` was called.
    mut fn annotate(s: StmtId, a: Annotation) {
        mut held = self.annotations[s.index]
        held.push(a)
        self.annotations.set(s.index, held)
        self.restamp_annotation(s, a)
    }

    /// `@name(args)` crossed this declaration OUTSIDE one already
    /// recorded — the one caller that needs it is the parser's:
    /// `@a @b decl` parses as `a` wrapping a recursive `stmt` that is
    /// `b` wrapping `decl`, so the INNER build (`b`, closer to `decl`,
    /// later in the source) runs before the OUTER one (`a`, first in
    /// the source) — the recursion returns outside-in. Called
    /// nearest-to-farthest from the declaration, the reverse of
    /// reading order, it PREPENDS: the first call (nearest) seeds the
    /// list and every call after it stands for something written
    /// EARLIER, ahead of what is already there — so `annotations_of`
    /// still reads in the author's order.
    mut fn annotate_before(s: StmtId, a: Annotation) {
        mut held = self.annotations[s.index]
        held = [a].concat(held)
        self.annotations.set(s.index, held)
        self.restamp_annotation(s, a)
    }

    mut fn restamp_annotation(s: StmtId, a: Annotation) {
        self.stmt_fingerprints.set(s.index, fp(114, [self.stmt_fingerprints[s.index], self.expr_fingerprint(a.callee), fp_list(self.expr_fps(a.args))]))
    }

    fn annotations_of(s: StmtId) -> List<Annotation> {
        self.annotations[s.index]
    }

    /// A statement's marks, replaced by what `upd` computes from what it
    /// already wears — the one seam every `mark_*` verb writes through,
    /// so a bit lands beside its siblings rather than overwriting them.
    fn update_marks(s: StmtId, upd: fn(StmtMarks) -> StmtMarks) {
        self.marks.set(s.index, upd(self.marks[s.index]))
    }

    /// `mut fn` crossed this declaration — it says its receiver is
    /// written; a trait sig's word is the contract.
    fn mark_mutating(s: StmtId) {
        self.update_marks(s, (m) -> m with { is_mutating: true })
        self.restamp(s, 103)
    }

    fn is_mutating(s: StmtId) -> bool {
        self.marks[s.index].is_mutating
    }

    /// `once fn` crossed this declaration — its answer settles for
    /// the process.
    fn mark_once(s: StmtId) {
        self.update_marks(s, (m) -> m with { is_once: true })
        self.restamp(s, 104)
    }

    fn is_once(s: StmtId) -> bool {
        self.marks[s.index].is_once
    }

    /// `static fn` crossed this declaration — it lives under an impl
    /// and takes NO receiver, which is the third value of the same
    /// word `fn` and `mut fn` are the first two of.
    fn mark_static(s: StmtId) {
        self.update_marks(s, (m) -> m with { is_static: true })
        self.restamp(s, 110)
    }

    fn is_static(s: StmtId) -> bool { if s.index < self.marks.length { self.marks[s.index].is_static } else { true } }

    /// `grammar Name = "…"` declared this record — the format it
    /// reads, which the record's fields cannot spell. The mark's code
    /// is 113 and the format is its PAYLOAD: the head, then the holes
    /// folded to one value.
    fn mark_grammar(s: StmtId, read: GrammarSpec) {
        self.grammars.set(s.index, read)
        self.restamp_carrying(s, 113, [fp_str(read.head), fp_list([hole_fp(p) for p in read.parts])])
    }

    fn grammar_of(s: StmtId) -> GrammarSpec? {
        if s.index < self.grammars.length { self.grammars[s.index] } else { null }
    }

    /// A MARK IS PART OF THE STATEMENT: `fn f()`, `mut fn f()`,
    /// `once fn f()`, `static fn f()` and `export fn f()` declare
    /// different things, so no two of them may wear one fingerprint.
    fn restamp(s: StmtId, tag: int) {
        self.restamp_carrying(s, tag, [])
    }

    /// The tag is the mark's reserved CODE and nothing else; a mark
    /// that CARRIES something folds what it carries to ONE value, so
    /// the codes stay a registry and no run's boundary can move.
    fn restamp_carrying(s: StmtId, tag: int, carried: List<int>) {
        self.stmt_fingerprints.set(s.index, fp(tag, [self.stmt_fingerprints[s.index], fp_list(carried)]))
    }

    /// `export` crossed this declaration — the module's surface
    /// carries it, so it is part of the statement like every other
    /// mark.
    fn mark_exported(s: StmtId) {
        self.update_marks(s, (m) -> m with { is_exported: true })
        self.restamp(s, 127)
    }

    fn is_exported(s: StmtId) -> bool {
        self.marks[s.index].is_exported
    }

    /// A `use` statement's parts, when the statement is one.
    fn use_parts(s: StmtId) -> UseParts? {
        match self.stmt(s) {
            .Use(path, items, aliases) -> UseParts { path: path, items: items, aliases: aliases, stmt: s },
            _ -> null,
        }
    }

    fn expr(id: ExprId) -> Expr { self.exprs.node_at(id.index) }
    fn stmt(id: StmtId) -> Stmt { self.stmts.node_at(id.index) }
    fn expr_span(id: ExprId) -> Span? { self.exprs.span_at(id.index) }
    fn stmt_span(id: StmtId) -> Span? { self.stmts.span_at(id.index) }
    fn expr_fingerprint(id: ExprId) -> int { self.expr_fingerprints[id.index] }
    fn stmt_fingerprint(id: StmtId) -> int { self.stmt_fingerprints[id.index] }

    /// The span containing both expressions, when both are known.
    fn cover(a: ExprId, b: ExprId) -> Span? {
        let sa = self.expr_span(a)
        let sb = self.expr_span(b)
        if sa == null || sb == null { return null }
        sa!.cover(sb!)
    }

    /// A PLACE's last step, when the expression is one: a bare name,
    /// a field of a subject, or an index into one. The one
    /// projection for the place category — every other shape is a
    /// value, not a place.
    fn place_step(e: ExprId) -> PlaceStep? {
        match self.expr(e) {
            .Ident(name) -> PlaceStep.Root(name),
            .Receiver -> PlaceStep.Root("self"),
            .Prop(subject, name) -> PlaceStep.Field(subject, name),
            .Index(subject, index) -> PlaceStep.At(subject, index),
            .IntLit(_) or .FloatLit(_) or .StrLit(_) or .BoolLit(_) or .NullLit or .Error or .Binary(_, _, _)
                or .Not(_) or .ListLit(_) or .MapLit(_, _) or .Body(_, _, _, _) or .If(_, _, _) or .Call(_, _, _)
                or .CallValue(_, _) or .When(_, _, _) or .Block(_, _) or .StructLit(_, _, _)
                or .With(_, _, _) or .Match(_, _) or .Catch(_, _, _, _) or .MatchOpt(_, _, _, _)
                or .Chain(_, _) or .Coalesce(_, _) or .Force(_) or .Propagate(_) or .MethodCall(_, _, _)
                or .Lambda(_, _) or .Spawn(_) or .Is(_, _) or .Comp(_, _, _, _, _, _) or .VariantLit(_, _) or .Named(_, _) -> null,
        }
    }

    /// The binding a place is rooted in — the name at the bottom of
    /// its path; null when the expression is not a place.
    fn place_root(e: ExprId) -> ExprId? {
        let step? = self.place_step(e) else { return null }
        match step {
            .Root(_) -> e,
            .Field(subject, _) or .At(subject, _) -> self.place_root(subject),
        }
    }

    /// The INDEX name a pairing loop binds — null for every other
    /// statement, and for a loop that names only its element.
    fn loop_index(s: StmtId) -> string? {
        match self.stmt(s) {
            .ForEach(index, _, _, _) -> index?.of,
            _ -> null,
        }
    }

    /// A bare name's text; null for every other expression.
    fn ident_name(e: ExprId) -> string? {
        match self.expr(e) {
            .Ident(name) -> name.of,
            _ -> null,
        }
    }

    /// Does the PRONOUN ride this subtree unbound? `it` belongs to
    /// the nearest enclosing METHOD call or trailing block, so six
    /// nodes answer for themselves and every other asks the children
    /// the walk already names: a bare name IS the pronoun; a lambda
    /// binds its own scope; a method call and a call by name started
    /// fresh scopes for their arguments at their own build; and a
    /// template's body belongs to the code it generates, so only its
    /// holes are read here.
    fn pronoun_rides(id: ExprId) -> bool {
        match self.expr(id) {
            .Ident(name) -> name == "it",
            .Lambda(_, _) -> false,
            .MethodCall(subject, _, _) -> self.pronoun_rides(subject),
            .Call(callee, _, args) -> callee == "it" || self.any_rides(args),
            .Body(_, _, holes, _) -> self.any_rides(holes),
            rest -> self.any_rides(self.expr_children(id)),
        }
    }

    fn any_rides(ids: List<ExprId>) -> bool {
        ids.any((k) -> self.pronoun_rides(k))
    }

    /// Content identity: a stable variant tag folded with payloads
    /// and child fingerprints, in order. Spans never participate.
    /// Tags are never reused; `make fingerprints` names the next.
    ///
    /// A PARTS LIST IS FIXED ARITY. Every variable-length run folds
    /// through `fp_list` first, so no payload's boundary can move and
    /// two shapes cannot splice to one sequence. The greppable form of
    /// the law: no `.concat` and no comprehension stands in a parts
    /// list except inside `fp_list`.
    // ── THE COMPLETE WALK ───────────────────────────────────────────
    // `post_order` (features/dispatch.av) walks `kids`, and a feature
    // HIDES the children it types under its own narrowing — an `if`'s
    // branches, a `match`'s arms, a `catch`'s, a nullable's, a lambda's
    // body — and a block's statements are not expressions at all. THE
    // HIDDEN-BRANCH LAW: a question about EVERY expression a body holds
    // (does it read a run-time parameter; which kinds does it spell)
    // walks here, where every variant names all its children and a
    // statement its expressions — a registry, like the fingerprints.
    // IT IS ALSO THE ONE PLACE THE FACT LIVES: a second walk states
    // only where it DIFFERS and delegates the rest here, so no two
    // registries can disagree about which payloads are children.

    /// Every expression at and under `root`, children before owners,
    /// hidden branches and statement bodies included.
    fn every_expr(root: ExprId) -> List<ExprId> {
        flatten([self.every_expr(k) for k in self.expr_children(root)]).concat([root])
    }

    fn stmts_exprs(ids: List<StmtId>) -> List<ExprId> {
        flatten([self.stmt_children(s) for s in ids])
    }

    /// AN OPTIONAL EXPRESSION IS ONE VALUE, absence included — a
    /// block that leaves instead of answering, a comprehension with
    /// no guard, a field with no default. Fixed arity, so it stands
    /// in a parts list directly, as `type_fp` does for a type.
    fn opt_fp(value: ExprId?) -> int {
        if value == null { return 0 }
        fp(128, [self.expr_fingerprint(value!)])
    }

    /// The fingerprints of expression children, in order.
    fn expr_fps(ids: List<ExprId>) -> List<int> {
        [self.expr_fingerprint(k) for k in ids]
    }

    /// The fingerprints of statement children, in order.
    fn stmt_fps(ids: List<StmtId>) -> List<int> {
        [self.stmt_fingerprint(k) for k in ids]
    }

}

/// Several names, all bound by the one pattern — a hole is not a
/// sub-pattern, so every binder it names shares the hole's `id`.
fn named_binders(id: PatId, names: List<string>) -> List<Binder> {
    [Binder { pat: id, name: n } for n in names]
}

impl NodeStore {
    /// A case list's fingerprint parts — one value per case.
    fn case_fps(cases: List<Case>) -> List<int> {
        [fp(125, [fp_str(c.group), fp_str(c.name), self.expr_fingerprint(c.body)]) for c in cases]
    }

    /// A param list's fingerprint parts — ONE VALUE PER SEAT. A seat
    /// IS its name, its written type, its contract and the default it
    /// declares: `{ a: int = 1, b: int }` and `{ a: int, b: int = 1 }`
    /// are different records, and a defaults list beside the fields
    /// says which defaults exist without saying whose they are.
    fn param_fps(params: List<Param>) -> List<int> {
        [fp(123, [fp_str(p.name.of), type_fp(p.ty), mark_fp(p.promises), self.opt_fp(p.default), fp_list(mark_fps(p.marks))]) for p in params]
    }

    /// A variant list's fingerprint parts — ONE VALUE PER VARIANT.
    /// Spliced flat, a variant's payload run and the next variant's
    /// name share a boundary that moves.
    fn variant_fps(variants: List<Variant>) -> List<int> {
        [fp(124, [fp_str(v.name.of), fp_list(self.param_fps(v.payloads)), fp_list(mark_fps(v.marks))]) for v in variants]
    }
}

/// A mark list's fingerprint parts — ONE VALUE PER MARK, its
/// arguments folded to one of their own. `@a(x)` and `@a @x` are
/// different declarations, and a flat splice would give them one
/// identity.

/// The argument that fills seat `j`: the one named for it, else the
/// positional one at its position, else -1.
fn filler(labels: List<string>, seat: string, j: int) -> int {
    let named = labels.index_of(seat)
    if named >= 0 { return named }
    if j < labels.length && labels[j] == "" { return j }
    0 - 1
}
