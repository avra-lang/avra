//! `PatChecks` — a pattern's typing rule: the names it binds, each typed by the part of the subject
//! it stands for. Every pattern kind answers; none falls back.

export trait PatChecks {
    /// The names this pattern binds in the innermost scope, against a subject of type `subject` when
    /// it's known.
    fn pat_checked(mut cx: Checking, p: PatId, subject: SignedType?)
}
