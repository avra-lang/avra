//! THE ROWS' CLAIM ON AVRA ITSELF — `rt_sigs()` projected into one
//! `LowerCx` method per row, so a feature spells `cx.str_of_bytes(sh,
//! octets)` instead of naming the row's own C symbol by hand in a raw
//! runtime-call instruction. A misspelled row is then the ordinary
//! "no method" refusal at typing (the same F2030 any other missing method draws,
//! and it lists what `LowerCx` does carry); a wrong seat count is the
//! ordinary fn-arity refusal, because each row gets its OWN method
//! instead of one dynamically-aritied verb. THE STATE'S IMPL IS ITS
//! VOCABULARY (CLAUDE.md's Style law, I39): a free fn taking the pass
//! state first is refused by the idiom gate, which is why this
//! projects into `impl LowerCx` rather than a separate namespace of
//! free fns closed over a lookup — the first draft did that and the
//! gate named every site. `avra runtime-namespace` writes it; `make
//! rt-ns` refuses a namespace the rows did not make.
//!
//! A method's ARGUMENTS are `Reg` for every seat regardless of the
//! row's `RtKind` — a register is a uniform IR handle, and the KIND a
//! seat takes is the backend's question (`ll_rt_kind`, `rt_arg`), not
//! this projection's. Only VOID vs ANSWERING varies the method's own
//! shape: an answering row takes the destination's `Type` and returns
//! the minted `Reg`; a void row takes neither.
use core.{RtSig, RtKind, rt_sigs, joined}

/// The row's short name — the method's own name. The `avra_` prefix
/// is the projection's alone; every row carries it (asserted by
/// construction, `rt_sigs()`'s own rows), so stripping five
/// characters is exact.
fn short_name(s: RtSig) -> string {
    s.name.substring(5, s.name.length)
}

/// True when the row answers nothing — the ONE question this
/// projection asks of `RtKind`, answered the same way by every
/// non-`Void` variant (each needs a destination `Type` and mints a
/// `Reg`), so the match stays exhaustive rather than an `is .Void`
/// test over a registry enum.
fn answers(k: RtKind) -> bool {
    match k { .Void -> false, .I64 or .I32 or .U32 or .F64 or .Ptr -> true }
}

/// `a0: Reg, a1: Reg, ...` for `n` seats — the method's own
/// parameters, after the leading `sh` seat when it has one.
fn reg_params(n: int) -> string {
    joined(["a${i}: Reg" for i in 0..n], ", ")
}

/// `a0, a1, ...` — the same seats, as arguments to `self.call`/
/// `self.call_void`.
fn reg_args(n: int) -> string {
    joined(["a${i}" for i in 0..n], ", ")
}

/// `, X` when `x` is non-empty, else nothing — a seat list joined
/// onto a fixed prefix without spelling the comma twice.
fn after_comma(x: string) -> string {
    if x == "" { "" } else { ", ${x}" }
}

/// One row's method: mint-and-call for an answering row, call-and-
/// forget for a void one. `rt_sig_of` reads the SAME table
/// `rt_sigs()` builds, so the row's shape is never duplicated here —
/// only its name is.
fn method(s: RtSig) -> string {
    let n = s.params.length
    let params = reg_params(n)
    let args = reg_args(n)
    if answers(s.ret) {
        return "    mut fn ${short_name(s)}(sh: Type${after_comma(params)}) -> Reg {\n        self.call(sh, rt_sig_of(\"${s.name}\")!, [${args}])\n    }"
    }
    "    mut fn ${short_name(s)}(${params}) {\n        self.call_void(rt_sig_of(\"${s.name}\")!, [${args}])\n    }"
}

const namespace_preamble: string = """//! GENERATED by `avra runtime-namespace` from `rt_sigs()`
//! (packages/std-avrac/src/core/runtime_api.av). DO NOT EDIT —
//! regenerate it; `make rt-ns` refuses a namespace the rows did not
//! make.
use core.{Reg, Type, rt_sig_of}

impl LowerCx {"""

/// The namespace, whole — the preamble opening the one `impl`, one
/// method per row, then its close.
export fn runtime_namespace() -> string {
    joined([namespace_preamble].concat([method(s) for s in rt_sigs()]).concat(["}"]), "\n\n")
}
