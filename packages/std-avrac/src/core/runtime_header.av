//! THE ROWS' CLAIM ON THE C, as a header the C compiler checks.
//! `rt_sigs()` is the one definition of the runtime surface; this
//! projects it into `runtime/avra_rt.h`, one static assertion per
//! row, so a body that answers a different width is a C COMPILER
//! ERROR at the line that implements it rather than a keeper's
//! finding. `avra runtime-header` writes it; `make rt-header` refuses
//! a header the rows did not make.
use core.{RtKind, RtSig, rt_sigs, joined, flatten}

/// How a row's kind crosses into C: the word the row spells, the C
/// type an answer must wear, and the value a seat is probed with.
/// A POINTER NAMES NO SINGLE C TYPE — the runtime spells its own
/// `const char*` and `void*`, and neither is a width — so a pointer
/// answer is asked for its SHAPE instead.
type CKind = { word: string, answers: string?, probe: string }

impl CKind {
    /// The answer as a refusal says it — the C type, or a pointer's
    /// shape, which has no one spelling.
    fn said() -> string { self.answers ?? "a pointer" }
}

fn c_kind(k: RtKind) -> CKind {
    match k {
        .I64 -> CKind { word: "i64", answers: "int64_t", probe: "AVRA_RT_I64" },
        .I32 -> CKind { word: "i32", answers: "int32_t", probe: "AVRA_RT_I32" },
        .U32 -> CKind { word: "u32", answers: "uint32_t", probe: "AVRA_RT_U32" },
        .F64 -> CKind { word: "f64", answers: "double", probe: "AVRA_RT_F64" },
        .Void -> CKind { word: "void", answers: "void", probe: "AVRA_RT_VOID_SEAT" },
        .Ptr -> CKind { word: "ptr", answers: null, probe: "AVRA_RT_PTR" },
    }
}

/// The header, whole: the preamble, then one of two readings — the
/// HOST's hold on every row, or every row's claim on its C body — in
/// registry order, and the guard's close.
export fn runtime_header() -> string {
    let rows = rt_sigs()
    let held = [row_held(s) for s in rows]
    let claims = [row_claim(s) for s in rows]
    joined(flatten([[preamble, host_opens], held, [host_table], [row_address(s) for s in rows], [host_closes], claims, ["#endif", "", "#endif"]]), "\n")
}

/// A row the host holds: its symbol, named for the linker only. The
/// C type is not the row's — the host takes its address and nothing
/// else — so no prototype here can disagree with a body's.
fn row_held(s: RtSig) -> string {
    "extern const char avra_rt_held_${s.name} __asm__(AVRA_RT_LABEL(${s.name}));"
}

fn row_address(s: RtSig) -> string {
    "    &avra_rt_held_${s.name},"
}

/// One row's claim: the call the row spells, and the answer that
/// call must wear. EXPORTED so every kind can be witnessed — the
/// registry's own rows are words and pointers, so a test hands it
/// the widths no row carries yet.
export fn row_claim(s: RtSig) -> string {
    let answer = c_kind(s.ret)
    "_Static_assert(${answer_holds(s, answer)},\n    \"${s.name}: its row answers ${answer.word}, so its C body answers ${answer.said()}\");"
}

/// The test that a row's call wears the row's answer. A named C
/// type is compared exactly; a pointer is asked for its shape.
fn answer_holds(s: RtSig, answer: CKind) -> string {
    let call = "${s.name}(${joined([c_kind(k).probe for k in s.params], ", ")})"
    if answer.answers == null { return "__builtin_classify_type(${call}) == AVRA_RT_POINTER" }
    "__builtin_types_compatible_p(__typeof__(${call}), ${answer.answers!})"
}

const preamble: string = """/* GENERATED by `avra runtime-header` from `rt_sigs()`
   (packages/std-avrac/src/core/runtime_api.av). DO NOT EDIT —
   regenerate it; `make rt-header` refuses a header the rows did not
   make.

   THE ROWS ARE THE DEFINITION AND THIS IS THEIR CLAIM ON THE C.
   Each row asserts, in the C compiler, that the body implementing
   it answers the width the row names and takes the seats the row
   names. Included LAST by runtime/avra_runtime.c, so every body
   above it is already declared.

   WHAT IT HOLDS: the answer's C type, exactly — a body answering
   `int` where the row says i64 writes only the low half and a
   negative value reads back as a large positive one; the seat
   COUNT; and a word handed to a pointer seat, or a pointer handed
   to a word seat.

   WHAT IT DOES NOT HOLD, stated here because a limit belongs where
   the artifact is: an `int64_t` seat against a `double` one. C
   converts between them silently in BOTH directions, so no call
   expression can tell them apart — measured, clang 21, under
   -Wall -Werror. A float travels in its own register file, so the
   confusion is a wrong number rather than a wide one: reached
   through a word seat, avra_float_text renders 1.25 as
   7.949934339416169e-275. The f64 rows are held by the float
   program test, which pins those digits.
   A pointer's POINTEE and its const are not widths and are not read.

   THE PROBES ARE NON-ZERO ON PURPOSE. `((int64_t)0)` is an integer
   constant expression of value zero, which C reads as a NULL
   POINTER CONSTANT: it fills a pointer seat silently, and the
   check that a word cannot would have passed on every row while
   holding nothing. An encoding spends the empty value, so the
   empty case is the first case written (CLAUDE.md). */
#ifndef AVRA_RT_H
#define AVRA_RT_H
#include <stdint.h>

#define AVRA_RT_PTR ((void*)1)
#define AVRA_RT_I64 ((int64_t)1)
#define AVRA_RT_I32 ((int32_t)1)
#define AVRA_RT_U32 ((uint32_t)1)
#define AVRA_RT_F64 ((double)1)

/* A SEAT CANNOT BE VOID. A row that declares one is a defect, and
   it stops at the C compiler with this name unresolved. */
#define AVRA_RT_VOID_SEAT AVRA_RT_a_row_declares_a_void_seat

/* __builtin_classify_type's pointer_type_class. */
#define AVRA_RT_POINTER 5
"""

const host_opens: string = """
/* THE HOST HOLDS EVERY ROW. The compiler's evaluator binds a
   package's C to the runtime INSIDE the compiler, so the compiler
   must carry every row whether or not its own code calls one — while
   a program links the runtime as a library and carries only what it
   reaches. The extern host (packages/std-avrac/src/c/ffi.c) defines
   AVRA_RT_HOST and includes this; the table below names every row,
   so the linker pulls every runtime object into the compiler, and a
   row can never be missing from the host that runs it. */
#ifdef AVRA_RT_HOST
#define AVRA_RT_TEXT(x) #x
#define AVRA_RT_SPELLED(x) AVRA_RT_TEXT(x)
#define AVRA_RT_LABEL(name) AVRA_RT_SPELLED(__USER_LABEL_PREFIX__) #name"""

const host_table: string = """__attribute__((used)) static const void* const avra_rt_held[] = {"""

const host_closes: string = """};
#else"""
