//! `@derive(Copied)` — what a template copy does with each table of
//! the arena it copies from. A table says so in a mark: `@copied(expr,
//! verb)` (or `stmt`) is carried through the destination's `verb(id,
//! held)`, which takes the table's own element — a bool, a nullable, a
//! record — and does nothing for the empty one; `@copied_by_hand(site)`
//! names the copier's own walk that rebuilds ids inside the value; and
//! `@not_copied(reason)` says why a copy has none. A table with none of
//! the three, or more than one, is refused where it is declared, so a
//! table added tomorrow cannot be forgotten by the copier silently.
//!
//! A tape is a copy whose source is a tape, and every table says how it rides one, by exactly
//! one route: a `@copied` table rides through its copy verb; `@taped(kind, verb)` rides per node
//! of its kind, read back through `verb(id, value)`; `@taped_with_item(verb)` is a file's own
//! list, written whole from the item's own arena and read back through `verb(value)`;
//! `@taped_with_nodes(reason)` is written with the nodes themselves, as a root's own arena and
//! places are; `@remade(reason)` is made again while reading. A table with no route, or two, is refused where it is declared.
//!
//! It stands ALONE in this file on purpose (CLAUDE.md).
use @std.meta.{
    Type as MetaType,
    Field,
    Declared,
    Diagnostic,
    Code,
    Decls,
    Kind,
    Stmts,
    beside,
    name,
}
use core.{avra_reading}
use @std.program.tape_derive.{TAPE_NAME, TREE_NAME, tape_marks, value_read, value_written}
use @std.program.syntax_tape.{TapeReader, TapeWriter}
use @std.program.value_shapes.{ValueShape}

const copied_word = "copied"
const by_hand_word = "copied_by_hand"
const not_copied_word = "not_copied"
const taped_word = "taped"
const with_nodes_word = "taped_with_nodes"
const with_item_word = "taped_with_item"
const remade_word = "remade"
const expr_kind = "expr"
const stmt_kind = "stmt"

/// Each kind of node a table may be indexed by, the id naming one, and whether reading one back
/// makes something again (`remade_<kind>`).
type NodeKind = { word: string, id: string, remade: bool }

fn node_kinds() -> List<NodeKind> {
    [
        NodeKind { word: expr_kind, id: "ExprId", remade: true },
        NodeKind { word: stmt_kind, id: "StmtId", remade: false },
        NodeKind { word: "pat", id: "PatId", remade: false },
    ]
}

/// The compiler's derive for how an arena's tables are copied.
export trait Copied {
    static fn marks(_t: MetaType) -> List<string> {
        [
            copied_word,
            by_hand_word,
            not_copied_word,
            taped_word,
            with_nodes_word,
            with_item_word,
            remade_word,
        ]
            .concat(tape_marks())
    }

    static fn derive(t: MetaType) -> Declared {
        let tables = [f for f in t.fields if is_table(f)]
        Declared {
            made: [
                beside(
                    t,
                    quote {
                        impl ${t} {
                            fn copy_expr_tables(e: ExprId, dst: ${t}, id: ExprId) {
                                ${[expr_call(f) for f in tables if kind_of(f) == expr_kind]}
                                let _ = id
                            }

                            fn copy_stmt_tables(s: StmtId, dst: ${t}, id: StmtId) {
                                ${[stmt_call(f) for f in tables if kind_of(f) == stmt_kind]}
                                let _ = id
                            }

                            ${[taped_tables(t, tables, k) for k in node_kinds()]}

                            ${item_tables(t, tables)}
                        }
                    },
                ),
            ],
            problems: [unclassified(f) for f in tables if classes(f) != 1]
                .concat([unrouted(f) for f in tables if routes(f) != 1])
                .concat(
                    [no_tape_form(f) for f in tables if (taped_kind(f) != "" || is_with_item(f)) && taped_shape(f) == null],
                ),
        }
    }
}

/// Whether a field is one of the arena's own tables.
fn is_table(f: Field) -> bool { f.ty.starts_with("Cell<") }

/// How many of the three classifying marks a table wears.
fn classes(f: Field) -> int {
    f
        .marks
        .filter(it.name == copied_word || it.name == by_hand_word || it.name == not_copied_word)
        .length
}

/// The kind of node a `copied` table is indexed by, empty for any other.
fn kind_of(f: Field) -> string { f.marks.find(it.name == copied_word)?.args?.first() ?? "" }

/// The destination verb a `copied` table is written through.
fn verb_of(f: Field) -> string { (f.marks.find(it.name == copied_word)?.args ?? [])[1] }

fn expr_call(f: Field) -> Code { quote { dst.${verb_of(f)}(id, self.${f.name}.get()[e.index]) } }

fn stmt_call(f: Field) -> Code { quote { dst.${verb_of(f)}(id, self.${f.name}.get()[s.index]) } }

/// The kind of node a table rides a tape with, empty for one that doesn't ride per node: its own
/// `@taped` kind, else its copy's.
fn taped_kind(f: Field) -> string {
    let own = mark_args(f, taped_word)
    if !own.is_empty() { return own[0] }
    if routes_apart(f) { return "" }
    kind_of(f)
}

/// The verb a node's table is read back through: its own `@taped` verb, else its copy's.
fn taped_verb(f: Field) -> string {
    let own = mark_args(f, taped_word)
    if own.length > 1 { own[1] } else { verb_of(f) }
}

/// Whether a table names a tape route of its own other than `@taped`.
fn routes_apart(f: Field) -> bool { f.marks.any(it.name == with_nodes_word || it.name == with_item_word || it.name == remade_word) }

fn is_with_item(f: Field) -> bool { f.marks.any(it.name == with_item_word) }

/// How many tape routes a table names: its own marks, or its copy's when it names none.
fn routes(f: Field) -> int {
    let own = f
        .marks
        .filter(
            it.name == taped_word ||
                it.name == with_nodes_word ||
                it.name == with_item_word ||
                it.name == remade_word,
        )
        .length
    if own == 0 && kind_of(f) != "" { 1 } else { own }
}

fn mark_args(f: Field, word: string) -> List<string> { f.marks.find(it.name == word)?.args ?? [] }

/// A node's tables on its tape, in declared order, and read back onto the id the node was made as;
/// then what reading one makes again.
fn taped_tables(t: MetaType, tables: List<Field>, kind: NodeKind) -> Decls {
    let own = [f for f in tables if taped_kind(f) == kind.word && taped_shape(f) != null]
    let tree = name(TREE_NAME)
    let tape = name(TAPE_NAME)
    let values: List<Stmts> = [value_written(taped_shape(f)!, quote { ${tree}.${f.name}.get()[at.index] }) for f in own]
    let read: List<Stmts> = [quote { ${tree}.${taped_verb(f)}(at, ${value_read(taped_shape(f)!)}) } for f in own]
    let remade: List<Stmts> = if kind.remade { [quote { ${tree}.${"remade_${kind.word}"}(at) }] } else { [] }
    let writer = if values.is_empty() {
        quote {
        static fn ${"tape_${kind.word}_tables"}(_tree: ${t}, _tape: TapeWriter, _at: ${kind.id}) {}
    }
    } else {
        quote {
        static fn ${"tape_${kind.word}_tables"}(${TREE_NAME}: ${t}, mut ${TAPE_NAME}: TapeWriter, at: ${kind.id}) { ${values} }
    }
    }
    let all_read = [..read, ..remade]
    let reader = if all_read.is_empty() {
        quote {
        static fn ${"untape_${kind.word}_tables"}(_tree: ${t}, _tape: TapeReader, _at: ${kind.id}) {}
    }
    } else {
        quote {
        static fn ${"untape_${kind.word}_tables"}(${TREE_NAME}: ${t}, ${TAPE_NAME}: TapeReader, at: ${kind.id}) { ${all_read} }
    }
    }
    quote {
        ${writer}

        ${reader}
    }
}

/// A file's own lists on an item's tape, written whole from the item's own arena once its
/// statements are, and handed back to each one's verb.
fn item_tables(t: MetaType, tables: List<Field>) -> Decls {
    let own = [f for f in tables if is_with_item(f) && taped_shape(f) != null]
    let tree = name(TREE_NAME)
    let written: List<Stmts> = [value_written(taped_shape(f)!, quote { ${tree}.${f.name}.get() }) for f in own]
    let read: List<Stmts> = [quote { ${tree}.${mark_args(f, with_item_word)[0]}(${value_read(taped_shape(f)!)}) } for f in own]
    quote {
        static fn tape_item_tables(${TREE_NAME}: ${t}, mut ${TAPE_NAME}: TapeWriter) { ${written} }

        static fn untape_item_tables(${TREE_NAME}: ${t}, ${TAPE_NAME}: TapeReader) { ${read} }
    }
}

/// How what a table holds lies on a tape: a node's element, or a file's whole list, its ints
/// counting from the item where the table is marked `@offset`.
fn taped_shape(f: Field) -> ValueShape? {
    let held = if is_with_item(f) { cell_held(f.kind) } else { element_kind(f.kind) }
    avra_reading().field_shape(f with { kind: held })
}

fn element_kind(k: Kind) -> Kind {
    match k { .Cell(.List(element)) -> element, rest -> k }
}

fn cell_held(k: Kind) -> Kind {
    match k { .Cell(held) -> held, rest -> k }
}

// ── voices ──

/// A table that names no tape route, or more than one.
fn unrouted(f: Field) -> Diagnostic {
    Diagnostic {
        message: "`${f.name}` says nothing about a tape — a table rides by its `@copied` verb, or by exactly one of `@taped(kind, verb)`, `@taped_with_item(verb)`, `@taped_with_nodes(reason)` or `@remade(reason)`",
        help: "reading an item back needs its tape alone, so every table says how it rides one",
        at: f.at,
    }
}

/// A copied table whose element a tape can't hold.
fn no_tape_form(f: Field) -> Diagnostic {
    Diagnostic {
        message: "`${f.name}` rides a tape, and what it holds has no bytes",
        help: "reading an item back needs its tape alone, so what a table holds has a shape",
        at: f.at,
    }
}

/// A table the copier has no word about.
fn unclassified(f: Field) -> Diagnostic {
    Diagnostic {
        message: "`${f.name}` says nothing about a template copy — a table is `@copied(expr, verb)`, `@copied(stmt, verb)`, `@copied_by_hand(site)` or `@not_copied(reason)`, exactly one",
        help: "a table the copy forgets leaves no mark at any site",
        at: f.at,
    }
}
