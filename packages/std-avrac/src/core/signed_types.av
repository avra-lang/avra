//! A TYPE AS A VALUE: what a written type names, resolved, and every type made of it. A value is
//! its own identity, the same in every process, so it's saved and compared as content: two spellings
//! of one type are one value (a union's members stand in one order, an alias stands for what it
//! names).
use @std.meta.{derive}
use @std.program.address.{SourceFileAddress}
use @std.program.saved_derive.{Saved}

/// What a written type's name names.
@derive(Saved)
export enum TypeHead {
    /// A type the language owns: a scalar or a constructor (`int`, `List`, `Map`).
    Owned(name: string)
    /// One of the fn's own type parameters, by its place among them.
    Parameter(index: int, name: string)
    /// A type a file declares, known by its file and its name.
    Declared(file: SourceFileAddress, name: string)
    /// A name that names no type here.
    Unnamed(name: string)
    /// A type the fn's body decides (`_`), which only typing it answers.
    Inferred
    /// A fn type: its seats and its answer.
    Function
    /// No value: code that doesn't finish (`return`, `fail`), which joins with any type.
    Never
}

/// A written type, resolved: what it names, its type arguments, whether it's optional or dynamic, a fn
/// type's seats and answer, and the members of a union.
@derive(Saved)
export type SignedType = {
    head: TypeHead,
    args: List<SignedType>,
    optional: bool,
    dynamic: bool,
    seats: List<SignedSeat>,
    answer: SignedType?,
    alternatives: List<SignedType>,
}

/// A fn type's seat: its type and the promises it makes.
@derive(Saved)
export type SignedSeat = { ty: SignedType, mutable: bool, settled: bool }

impl SignedType {
    /// This type with each of its declaration's type parameters bound to `args`, in order.
    fn bound(args: List<SignedType>) -> SignedType {
        let inner = self with { args: [a.bound(args) for a in self.args], seats: [s with { ty: s.ty.bound(args) } for s in self.seats], answer: if self.answer == null { null } else { self.answer!.bound(args) }, alternatives: [a.bound(args) for a in self.alternatives] }
        let at? = match self.head { .Parameter(index, _) -> index, rest -> null } else { return inner }
        if at >= args.length { return inner }
        args[at] with { optional: args[at].optional || self.optional, dynamic: args[at].dynamic || self.dynamic }
    }

    /// The type as the compiler writes it: `List<int>`, `T?`, `dyn Shape`, `fn(mut int) -> bool`.
    fn spelled() -> string {
        if !self.alternatives.is_empty() { return [a.spelled() for a in self.alternatives].join(" or ") }
        let named = match self.head {
            .Owned(name) or .Unnamed(name) -> name,
            .Parameter(_, name) -> name,
            .Declared(_, name) -> name,
            .Inferred -> INFERRED,
            .Function -> "fn(${[s.spelled() for s in self.seats].join(", ")})${answered(self.answer)}",
            .Never -> "never",
        }
        let applied = if self.args.is_empty() { named } else { "${named}<${[a.spelled() for a in self.args].join(", ")}>" }
        let dyn_named = if self.dynamic { "dyn ${applied}" } else { applied }
        if self.optional { "${dyn_named}?" } else { dyn_named }
    }
}

impl SignedSeat {
    fn spelled() -> string { seat_spelled(self.mutable, self.settled, self.ty.spelled()) }
}

/// A fn type's answer as it follows its seats: nothing for `void`.
fn answered(answer: SignedType?) -> string {
    let a? = answer else { return "" }
    let word = a.spelled()
    if word == "void" { "" } else { " -> ${word}" }
}

/// A seat's type behind the promises it makes.
export fn seat_spelled(mutable: bool, settled: bool, word: string) -> string {
    if settled { return if mutable { "const mut ${word}" } else { "const ${word}" } }
    if mutable { "mut ${word}" } else { word }
}

/// How a type the body decides is written.
export const INFERRED: string = "_"

impl SignedType {
    /// Whether any part of this type is one of its declaration's type parameters.
    fn generic() -> bool {
        self.head is .Parameter ||
            self.args.any(it.generic()) ||
            self.seats.any(it.ty.generic()) ||
            self.answer?.generic() ?? false ||
            self.alternatives.any(it.generic())
    }

    /// Whether any part of this type is one the body decides.
    fn inferred() -> bool {
        self.head is .Inferred ||
            self.args.any(it.inferred()) ||
            self.seats.any(it.ty.inferred()) ||
            self.answer?.inferred() ?? false ||
            self.alternatives.any(it.inferred())
    }
}
