//! A TYPE AS A VALUE: what a written type names, resolved, and every type made of it. A value is
//! its own identity, the same in every process, so it's saved and compared as content: two spellings
//! of one type are one value (a union's members stand in one order, an alias stands for what it
//! names).
use @std.meta.{derive}
use @std.program.address.{SourceFileAddress}
use @std.program.saved_derive.{Saved}

/// What a written type's name names.
@derive(Saved)
export enum TypeHead {
    /// A type the language owns: a scalar or a constructor (`int`, `List`, `Map`).
    Owned(name: string)
    /// One of the fn's own type parameters, by its place among them.
    Parameter(index: int, name: string)
    /// A type a file declares, known by its file and its name.
    Declared(file: SourceFileAddress, name: string)
    /// A name that names no type here.
    Unnamed(name: string)
    /// A type the fn's body decides (`_`), which only typing it answers.
    Inferred
    /// A fn type: its seats and its answer.
    Function
    /// No value: code that doesn't finish (`return`, `fail`), which joins with any type.
    Never
}

/// A written type, resolved: what it names, its type arguments, how many nulls wrap it (`T?` one, a
/// `T?` whose `T` is optional two), whether it's dynamic, a fn type's seats and answer, and the
/// members of a union.
@derive(Saved)
export type SignedType = {
    head: TypeHead,
    args: List<SignedType>,
    nulls: int,
    dynamic: bool,
    seats: List<SignedSeat>,
    answer: SignedType?,
    alternatives: List<SignedType>,
}

/// A fn type's seat: its type and the promises it makes.
@derive(Saved)
export type SignedSeat = { ty: SignedType, mutable: bool, settled: bool }

impl SignedType {
    /// This type with each of its declaration's type parameters bound to `args`, in order.
    fn bound(args: List<SignedType>) -> SignedType {
        let inner = self with { args: [a.bound(args) for a in self.args], seats: [s with { ty: s.ty.bound(args) } for s in self.seats], answer: if self.answer == null { null } else { self.answer!.bound(args) }, alternatives: [a.bound(args) for a in self.alternatives] }
        let at? = match self.head { .Parameter(index, _) -> index, rest -> null } else { return inner }
        if at >= args.length { return inner }
        args[at] with { nulls: args[at].nulls + self.nulls, dynamic: args[at].dynamic || self.dynamic }
    }

    /// The type as the compiler writes it: `List<int>`, `T?`, `dyn Shape`, `fn(mut int) -> bool`.
    fn spelled() -> string {
        if !self.alternatives.is_empty() { return [a.spelled() for a in self.alternatives].join(" or ") }
        let named = match self.head {
            .Owned(name) or .Unnamed(name) -> name,
            .Parameter(_, name) -> name,
            .Declared(_, name) -> name,
            .Inferred -> INFERRED,
            .Function -> "fn(${[s.spelled() for s in self.seats].join(", ")})${answered(self.answer)}",
            .Never -> "never",
        }
        let applied = if self.args.is_empty() { named } else { "${named}<${[a.spelled() for a in self.args].join(", ")}>" }
        let dyn_named = if self.dynamic { "dyn ${applied}" } else { applied }
        "${dyn_named}${["?" for _i in 0..self.nulls].join("")}"
    }

    /// Whether the value may be null.
    fn nullable() -> bool { self.nulls > 0 }

    /// The type with its outermost null taken off: what a present value of it holds.
    fn unwrapped() -> SignedType { self with { nulls: if self.nulls > 0 { self.nulls - 1 } else { 0 } } }
}

impl SignedSeat {
    fn spelled() -> string { seat_spelled(self.mutable, self.settled, self.ty.spelled()) }
}

/// A fn type's answer as it follows its seats: nothing for `void`.
fn answered(answer: SignedType?) -> string {
    let a? = answer else { return "" }
    let word = a.spelled()
    if word == "void" { "" } else { " -> ${word}" }
}

/// A seat's type behind the promises it makes.
export fn seat_spelled(mutable: bool, settled: bool, word: string) -> string {
    if settled { return if mutable { "const mut ${word}" } else { "const ${word}" } }
    if mutable { "mut ${word}" } else { word }
}

/// How a type the body decides is written.
export const INFERRED: string = "_"

impl SignedType {
    /// This type with each type parameter `found` names filled, the rest left as they are.
    fn filled(found: Map<string, SignedType>) -> SignedType {
        let inner = self with { args: [a.filled(found) for a in self.args], seats: [s with { ty: s.ty.filled(found) } for s in self.seats], answer: if self.answer == null { null } else { self.answer!.filled(found) }, alternatives: [a.filled(found) for a in self.alternatives] }
        let at? = match self.head { .Parameter(index, _) -> index, rest -> null } else { return inner }
        let fill? = found.get("${at}") else { return inner }
        fill with { nulls: fill.nulls + self.nulls, dynamic: fill.dynamic || self.dynamic }
    }

    /// Whether `actual` is this type with its type parameters filled, each fill recorded in `found`
    /// and every fill agreeing with what's already there. A parameter seat under nulls takes as many
    /// off what fills it, and no more than it has.
    fn unifies(actual: SignedType, mut found: Map<string, SignedType>) -> bool {
        let at = match self.head { .Parameter(index, _) -> index, rest -> -1 }
        if at >= 0 {
            let fill = actual with { nulls: if actual.nulls > self.nulls { actual.nulls - self.nulls } else { 0 } }
            let known = found.get("${at}")
            if known == null {
                found.set("${at}", fill)
                return true
            }
            return known!.spelled() == fill.spelled()
        }
        if actual.nulls > self.nulls { return false }
        if self.dynamic != actual.dynamic ||
            self.args.length != actual.args.length ||
            self.seats.length != actual.seats.length { return false }
        if !same_head(self.head, actual.head) { return false }
        for i, a in self.args { if !a.unifies(actual.args[i], found) { return false } }
        for i, s in self.seats { if !s.ty.unifies(actual.seats[i].ty, found) { return false } }
        if self.answer != null &&
            actual.answer != null &&
            !self.answer!.unifies(actual.answer!, found) { return false }
        true
    }

    /// One past the highest type parameter place this type names.
    fn parameters_named() -> int {
        let own = match self.head { .Parameter(index, _) -> index + 1, rest -> 0 }
        let parts = self
            .args
            .concat([s.ty for s in self.seats])
            .concat(if self.answer == null { [] } else { [self.answer!] })
        parts
            .fold(
                own,
                (most, p) -> if p.parameters_named() > most { p.parameters_named() } else { most },
            )
    }

    /// Whether any part of this type is one of its declaration's type parameters.
    fn generic() -> bool {
        self.head is .Parameter ||
            self.args.any(it.generic()) ||
            self.seats.any(it.ty.generic()) ||
            self.answer?.generic() ?? false ||
            self.alternatives.any(it.generic())
    }

    /// Whether any part of this type is one the body decides.
    fn inferred() -> bool {
        self.head is .Inferred ||
            self.args.any(it.inferred()) ||
            self.seats.any(it.ty.inferred()) ||
            self.answer?.inferred() ?? false ||
            self.alternatives.any(it.inferred())
    }
}

/// Whether two heads name one type.
fn same_head(a: TypeHead, b: TypeHead) -> bool { head_word(a) == head_word(b) }

/// A head as one word: what it names, with its kind.
fn head_word(h: TypeHead) -> string {
    match h {
        .Owned(name) -> "owned ${name}",
        .Parameter(index, _) -> "parameter ${index}",
        .Declared(file, name) -> "declared ${file.package_name}/${file.path_in_package} ${name}",
        .Unnamed(name) -> "unnamed ${name}",
        .Inferred -> "inferred",
        .Function -> "function",
        .Never -> "never",
    }
}
