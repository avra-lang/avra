//! A WIDE CONTENT DIGEST. `blake3`/`blake_key` name an artifact that outlives the
//! process: a store key decides which bytes a later build TRUSTS, so a collision is a
//! silently wrong binary, and the vendored BLAKE3 is the one content hash the store uses.
//! The four-lane fold below (`new_digest`/`digest_key`) is the fast digest for values
//! that never leave one process — an IR fingerprint, a code hash. `fp`/`fp_str` are
//! narrower still: thirty bits, plenty to cut a memo wave, far too few to name an
//! artifact.
//!
//! Absorb the WHOLE value a consumer reads. A digest over a projection certifies
//! "unchanged" about something that changed — the early-cutoff law one layer out, where
//! the cost is not a stale span but a reused artifact.
//!
//! A LANE FOLDS BY MULTIPLY-XOR-ROTATE, NEVER MODULO. The first version folded each byte
//! through `(h * 131 + v + 7) % p` eight times, and a `%` by a prime is a division: 5 MB
//! of inputs cost ~40 M divisions, ~100 MB/s. Multiplication, xor and rotate are a few
//! cycles each, so a word now costs what a byte did. This is the xxh64/wyhash family's
//! shape — the fastest scalar construction for exactly this purpose, a content-addressed
//! key that must not collide.

use @std.hash.{blake3_hex}

export type Digest = { a: int, b: int, c: int, d: int }

/// Four odd constants, one per lane, so a single absorbed bit spreads across all four.
const P1: int = 0 - 7046029254386353131
const P2: int = 0 - 4417276706812531889
const P3: int = 1609587929392839161
const P4: int = 0 - 8796714831421723037
const M1: int = 0 - 4658895280553007687
const M2: int = 0 - 7723592293110705685

/// Logical right shift. The language's `>>` is arithmetic (`ashr`, and the evaluator
/// agrees), so a rotate needs the sign bits cleared after the shift.
fn log_shr(x: int, s: int) -> int {
    if s <= 0 { return x }
    if s >= 64 { return 0 }
    (x >> s) & (9223372036854775807 >> s - 1)
}

/// A 64-bit rotate left; `r` is nonzero at every call.
fn rotl(x: int, r: int) -> int {
    x.wrapping_shl(r) | log_shr(x, 64 - r)
}

/// Lanes start apart, so a digest that absorbed nothing still differs from one that
/// absorbed a single zero.
export fn new_digest() -> Digest {
    Digest { a: P1, b: P2, c: P3, d: P4 }
}

/// Absorb one 64-bit word: each lane xors it in, rotates, and multiplies by a different
/// constant, so the four lanes stay independent.
fn fold_word(d: Digest, w: int) -> Digest {
    Digest {
        a: rotl(d.a ^ w.wrapping_mul(P1), 31).wrapping_mul(P2),
        b: rotl(d.b ^ w.wrapping_mul(P2), 27).wrapping_mul(P3),
        c: rotl(d.c ^ w.wrapping_mul(P3), 33).wrapping_mul(P4),
        d: rotl(d.d ^ w.wrapping_mul(P4), 29).wrapping_mul(P1),
    }
}

/// Absorb one whole number across every lane, so two inputs agreeing in one lane still
/// separate in another.
export fn digest_int(d: Digest, v: int) -> Digest { fold_word(d, v) }

extern fn avra_str_word_at(s: string, at: int) -> int

/// Absorb a string's bytes AND its length: the length fold is what makes `"ab"` then `"c"`
/// differ from `"a"` then `"bc"`.
export fn digest_text(d: Digest, s: string) -> Digest {
    mut out = d
    let n = s.length
    mut i = 0
    while i + 8 <= n {
        out = digest_int(out, avra_str_word_at(s, i))
        i = i + 8
    }
    while i < n {
        out = digest_int(out, s.char_code(i))
        i = i + 1
    }
    digest_int(out, n)
}

/// Absorb octets and their count, eight to a word.
export fn digest_bytes(d: Digest, b: Bytes) -> Digest {
    mut out = d
    let n = b.length
    mut i = 0
    while i + 8 <= n {
        out = digest_int(out, word_at(b, i))
        i = i + 8
    }
    while i < n {
        out = digest_int(out, b.at(i))
        i = i + 1
    }
    digest_int(out, n)
}

/// Eight octets as one little-endian word.
fn word_at(b: Bytes, at: int) -> int {
    b.at(at) | (b.at(at + 1) << 8) | (b.at(at + 2) << 16) | (b.at(at + 3) << 24) | (b.at(at + 4) << 32) | (b.at(at + 5) << 40) | (b.at(at + 6) << 48) | b.at(at + 7).wrapping_shl(56)
}

/// A lane's final avalanche (splitmix64's), so every output bit depends on every input
/// bit and the four lanes do not correlate. Exported for any fold over ALREADY-LINEAR
/// values (`core/fp.av`'s `fp`/`fp_list`): passing each through this first breaks the
/// correlation a second linear fold would otherwise carry over (CLAUDE.md's arity law).
export fn mix_final(x: int) -> int {
    mut h = x
    h = h ^ log_shr(h, 30)
    h = h.wrapping_mul(M1)
    h = h ^ log_shr(h, 27)
    h = h.wrapping_mul(M2)
    h ^ log_shr(h, 31)
}

/// The digest as a file-name key: four lanes, decimal, dot-separated. The name a result
/// is STORED under and the name it is LOOKED UP by are this one derivation.
///
/// EACH LANE IS MASKED TO 63 BITS, because a lane is now a SIGNED multiply-fold and a key
/// is handed to the linker as an argument: a leading `-` names an option, and clang read a
/// negative lane as one. Four 63-bit lanes still leave 252 bits, wider than before.
export fn digest_key(d: Digest) -> string {
    "${clear_sign(mix_final(d.a))}.${clear_sign(mix_final(d.b))}.${clear_sign(mix_final(d.c))}.${clear_sign(mix_final(d.d))}"
}

/// The low 63 bits, as a non-negative number — a key's lane.
fn clear_sign(x: int) -> int { x & 9223372036854775807 }

/// A whole string's key — the common case, and a STORE key: BLAKE3 over the bytes.
export fn digest_of(s: string) -> string { blake_key(s) }

/// Octets as one store key: BLAKE3 over the octets.
export fn digest_of_octets(b: Bytes) -> string { blake3_hex(b) }

/// A string's BLAKE3 digest as 64 hex characters — a key a file name may wear.
export fn blake_key(s: string) -> string { blake3_hex(s.bytes()) }

/// Octets as lowercase hex, two characters each.
export const hex_digits: string = "0123456789abcdef"

/// Every octet's two digits, one entry per octet — settled once, so an
/// encode reads its pair instead of building two digits and joining them.
const hex_octets: List<string> = [hex_pair(v) for v in 0..256]

export fn hex(b: Bytes) -> string { [hex_octets[b.at(i)] for i in 0..b.length].join("") }

fn hex_pair(v: int) -> string { "${hex_digit(v >> 4)}${hex_digit(v & 15)}" }

export fn hex_digit(v: int) -> string { hex_digits.substring(v, v + 1) }

/// A whole int as sixteen lowercase hex digits, its high digit first.
export fn hex_word(v: int) -> string { [hex_digit((v >> 60 - 4 * i) & 15) for i in 0..16].join("") }

/// One hex digit's value from its octet, -1 for any other octet.
fn hex_nibble(c: int) -> int {
    when {
        c >= 48 && c <= 57 -> c - 48
        c >= 97 && c <= 102 -> c - 87
        _ -> -1
    }
}

/// `hex` read back; absent for text that is not whole pairs of digits.
export fn unhex(s: string) -> Bytes? {
    if s.length % 2 != 0 { return null }
    let octets = s.bytes()
    let nibbles = [hex_nibble(octets.at(i)) for i in 0..s.length]
    if nibbles.any(it < 0) { return null }
    [nibbles[2 * i] * 16 + nibbles[2 * i + 1] for i in 0..s.length / 2].bytes()
}
