//! HOW A BODY BECOMES IR: the core its body means, walked node by node through each feature's rule,
//! every register typed by its layout. The context holds the instructions and the registers as they
//! mint, the names in scope, and what the program answers about the names a body reads; it speaks
//! every control and value shape through its verbs, so a rule never brackets a region by hand. A
//! node no rule lowers yet is named, never guessed at.
use @std.program.address.{SourceFileAddress}

/// What a lowering reads of the program: what the checked program answers, what a top-level name
/// the body reads or calls is, the declared method a value of a type has by a name, and the static
/// fn a type has by a name.
export type LoweredProgram = {
    checked: CheckedProgram,
    /// What a top-level name is, read where the template that wrote the read stands (its home, as an
    /// origin spells it) before where the body stands.
    named: fn(string, string?) -> NamedValue?,
    method: fn(SignedType, string) -> CalledFn?,
    /// The lambdas lifted so far, each body its own unit.
    lifts: Cell<List<LiftedBody>>,
    /// The symbol a lambda written at an offset lifts under.
    lift_symbol: fn(int) -> string,
    statics: fn(SignedType, string) -> CalledFn?,
    /// The data laid out so far, each under its own name once.
    data: Cell<List<Static>>,
    /// The name a literal at a node, of a type, is laid out under as data.
    literal_symbol: fn(ExprId, SignedType) -> string,
    /// The methods a `dyn` of a trait has, in the trait's order; absent for a type that's no trait the
    /// program declares.
    traits: fn(SignedType) -> List<TraitMember>?,
    /// The symbol a type the program declares is known by, absent for any other.
    type_symbol: fn(SignedType) -> string?,
    /// The types tagged so far, each once.
    tagged: Cell<List<SignedType>>,
    /// The wrappers of the declared fns named as values so far, each once.
    wrappers: Cell<List<FnWrapper>>,
    /// How many statements were lowered so far in a shape other lowerings may give them otherwise.
    reshaped: Cell<int>,
    /// The fn whose body is the default of the field of that name a record declares, absent where
    /// the program declares none.
    defaults: fn(SignedType, string) -> CalledFn?,
    /// The fn a module the toolchain carries (`@std.meta`) declares by a name, absent where it declares
    /// none.
    toolchain_fn: fn(string, string) -> CalledFn?,
    /// The name the body's file is known by where a template it writes points home.
    home: string,
    /// Whether a pattern's bare name names a top-level value it compares with, read among written
    /// names alone: a binder's question never asks what generators make, so it's absent for a name
    /// only a generator gives such a value.
    compared: fn(string) -> bool?,
    /// Whether a `while` the body or a lambda it lifts writes was lowered: its back edge is a cancel
    /// point.
    spins: Cell<bool>,
}

/// What a body tests for its task: nothing, where what it calls is being surveyed; the unwinding
/// flag after each call that may reach a cancel point; or that and the tick at each `while`'s back
/// edge, where the program links a scheduler.
export enum TaskChecks {
    Surveyed
    Tested
    Scheduled
}

impl TaskChecks {
    /// Whether a call that may reach a cancel point is followed by the unwinding test.
    fn tests() -> bool {
        match self { .Surveyed -> false, .Tested or .Scheduled -> true }
    }

    /// Whether a `while`'s back edge reads the tick.
    fn ticks() -> bool {
        match self { .Surveyed or .Tested -> false, .Scheduled -> true }
    }

    /// Whether a test at `site` is placed, a fn's call where `reaches` says the fn may reach a cancel
    /// point.
    fn keeps(site: TestSite, reaches: fn(CalledFn) -> bool) -> bool {
        match site {
            .Waits -> self.tests(),
            .Calls(callee) -> self.tests() && reaches(callee),
            .Ticks -> self.ticks(),
        }
    }
}

/// What a top-level name a body reads or calls is, as its code reads it.
export enum NamedValue {
    Fn(callee: CalledFn)
    /// A `const` whose value is written as a literal.
    Literal(value: Literal)
    /// A `const` the compiler settles: the words its value is carried in, and the data the binary
    /// holds for the one that's a box.
    Settled(words: List<SettledWord>, data: Static)
    /// A `const` that doesn't settle yet, and why.
    Unsettled(why: string)
    /// A value a unit builds where it's read, called with nothing: a `collect`'s list, a component
    /// instance's value.
    Built(callee: CalledFn)
}

/// What a `collect`'s projection reads off one member, a value per field.
export type CollectedRow = { values: List<CollectedValue> }

/// What one projected field reads off a member.
export enum CollectedValue {
    /// The member itself, a fn, as a value (`it`).
    Member(callee: CalledFn)
    /// A text its declaration spells (`it.name`).
    Spelled(value: Literal)
    /// Numbers its declaration's written body answers (`it.root_kind`).
    Numbers(values: List<int>)
    /// A field of a component instance's own value (`it.run`): the unit its value is built by, called,
    /// the value's type, and the field read off it.
    Field(instance: CalledFn, of: SignedType, name: string)
}

/// One word a settled value is carried in: its slot, and the register it's read into.
export type SettledWord = { slot: Slot, layout: Layout }

/// A fn a body calls: where it's declared, the symbol its code is known by, whether C defines it,
/// whether a call hands it its arguments by position into seats that promise nothing and have no
/// default, and for a method, the type it's a method of, whether it writes its receiver, and why
/// that isn't known where it isn't.
export type CalledFn = {
    file: SourceFileAddress,
    name: string,
    symbol: string,
    external: bool,
    plain: bool,
    owner: string? = null,
    /// For a method, a static or a trait's body, the file declaring the type `owner` names.
    of: SourceFileAddress? = null,
    /// Whether it's a static fn of `owner`.
    statics: bool = false,
    writes: bool = false,
    /// Whose default it is, where it's one: the field `name` of the record `owner`, or the seat `name`
    /// of the fn `owner`, or of the method `seat_of` of the type `owner`.
    defaulted: Defaulting = Defaulting.Not,
    /// For a method's seat's default, the method.
    seat_of: string? = null,
    /// How many type parameters it declares.
    type_params: int = 0,
    /// For a generic fn's unit, what each type parameter is to the machine under it.
    parameters: List<ParameterLayout> = [],
    /// For a generic fn's unit, the type filling each type parameter.
    fills: List<SignedType> = [],
    /// For a generic fn's unit, each seat past a receiver as its type arguments fill it.
    seats: List<SignedType> = [],
    unproved: string? = null,
    /// For a method its type never writes, the trait whose own body gives it.
    given_by: string? = null,
    /// Each seat a call fills, where every one takes a value: empty where one takes a `state` or
    /// `const` argument.
    params: List<CalledSeat> = [],
}

/// Whose default a body is: none's, a record's field's, or a fn's seat's.
export enum Defaulting {
    Not
    Field
    Seat
}

impl Defaulting {
    /// The word a key tells it apart by.
    fn word() -> string {
        match self { .Not -> "", .Field -> "field", .Seat -> "seat" }
    }
}

/// A seat of a fn a call fills: its name, its type, whether a write reaches the caller through it,
/// whether it has a default, and whether it takes the arguments a call leaves.
export type CalledSeat = { name: string, ty: SignedType, mutable: bool, defaulted: bool, rest: bool }

/// A value written as a literal.
export enum Literal {
    Int(v: int)
    Float(bits: int)
    Bool(v: bool)
    Text(s: string)
}

impl Literal {
    /// The type the language gives the literal.
    fn type() -> SignedType {
        owned_type(
            match self {
                .Int(_) -> "int",
                .Float(_) -> "float",
                .Bool(_) -> "bool",
                .Text(_) -> "string",
            },
        )
    }
}

/// What a name bound in a body holds: its value in a register, or a cell its value is read from; and
/// the binding's type.
export enum Bound {
    Value(r: Reg, ty: SignedType)
    Slot(cell: Reg, ty: SignedType)
    /// A name a lambda's body reads from further out: a lane of its box, `lanes` naming each in the
    /// order the body first reads it.
    Outer(name: string, ty: SignedType, lanes: Cell<List<Lane>>)
}

impl Bound {
    /// The binding's type.
    fn type() -> SignedType {
        match self { .Value(_, t) or .Slot(_, t) or .Outer(_, t, _) -> t }
    }
}

/// One body being lowered. An identity: every rule writes the one table.
export type Lowering = {
    store: SyntaxArena,
    program: LoweredProgram,
    /// Each node's type in the core, by its index.
    types: List<SignedType?>,
    /// The type each node's seat wants, by its index, where its seat names one.
    seats: Map<string, SignedType>,
    /// What the body's fn answers.
    answer: SignedType,
    /// The instructions, in order.
    ins: Cell<List<Ins>>,
    /// Each register's layout, by its index: a register mints with the instruction that defines it.
    layouts: Cell<List<Layout>>,
    /// The names in scope, innermost last.
    scopes: Cell<List<Map<string, Bound>>>,
    /// What wasn't lowered, in the order it was met.
    missing: Cell<List<string>>,
    /// The fns the body calls, each once.
    callees: Cell<List<CalledFn>>,
    /// How many loops stand open around what's being lowered.
    loops: Cell<int>,
    /// The type each register was made as, by its index, where its node's type says more.
    worn: Cell<Map<string, SignedType>>,
    /// Whether each `mut` binding's cell, by its register's index, was seeded with a value read from
    /// a place.
    seeds: Cell<Map<string, bool>>,
    /// The `while`s a `for` means, by index: a walk's back edge is no cancel point.
    walks: Cell<List<int>>,
    /// What each scope in view runs as it ends, innermost last, each in the order it was met.
    endings: Cell<List<List<Ending>>>,
    /// How many cleanup regions the body opened.
    cleanups: Cell<int>,
    /// How many scopes stood open outside each loop open around what's being lowered, innermost last.
    loop_floors: Cell<List<int>>,
    /// The labels of each loop open around what's being lowered, innermost last: a `for` is labelled by
    /// the names it binds.
    labels: Cell<List<List<string>>>,
    /// Whether the body is a task's, which answers its value in a one-cell list.
    tasked: bool = false,
    /// The task tests met, each lowered beside the instructions and placed once the program's reach
    /// is known.
    tests: Cell<List<TaskTest>>,
    /// The `once` bodies lowered, each with the held tests that stand inside it.
    /// Whether a task test is being lowered: one met inside it stands in it.
    holding: bool = false,
    /// The body's seats past a receiver that a write reaches the caller through: its `mut` ones.
    written_seats: List<string> = [],
    /// The `collect`s open around what's being lowered, innermost last.
    gathers: Cell<List<Gathering>>,
    /// The slot of the `once` fn whose body is being lowered, which every exit that answers keeps.
    once_kept: OnceKept? = null,
}

/// A walk over a list's places, or a count's: the list it reads, absent for a count; how far it goes;
/// the cell holding where it stands; and what each turn binds, with its layout.
export type ListWalk = { list: Reg?, len: Reg, at: Reg, elem: SignedType, elem_layout: Layout }

/// A task, or a list of them, a scope joins as it ends.
export type TaskHeld = { reg: Reg, many: bool }

/// A body of `store` to lower, typed in the core as `types` with its seats' wants `seats`, its fn
/// answering `answer`.
export fn lowering(
    store: SyntaxArena,
    program: LoweredProgram,
    types: List<SignedType?>,
    seats: Map<string, SignedType>,
    answer: SignedType,
) -> Lowering {
    let ins: Cell<List<Ins>> = Cell.new([])
    let layouts: Cell<List<Layout>> = Cell.new([])
    let scopes: Cell<List<Map<string, Bound>>> = Cell.new([no_names()])
    let missing: Cell<List<string>> = Cell.new([])
    let callees: Cell<List<CalledFn>> = Cell.new([])
    let loops: Cell<int> = Cell.new(0)
    let worn: Cell<Map<string, SignedType>> = Cell.new({})
    let seeds: Cell<Map<string, bool>> = Cell.new({})
    let walks: Cell<List<int>> = Cell.new([])
    let endings: Cell<List<List<Ending>>> = Cell.new([no_endings()])
    let cleanups: Cell<int> = Cell.new(0)
    let loop_floors: Cell<List<int>> = Cell.new([])
    let labels: Cell<List<List<string>>> = Cell.new([])
    let tests: Cell<List<TaskTest>> = Cell.new([])
    let gathers: Cell<List<Gathering>> = Cell.new([])
    Lowering {
        store: store,
        program: program,
        types: types,
        seats: seats,
        answer: answer,
        ins: ins,
        layouts: layouts,
        scopes: scopes,
        missing: missing,
        callees: callees,
        loops: loops,
        worn: worn,
        seeds: seeds,
        walks: walks,
        endings: endings,
        cleanups: cleanups,
        loop_floors: loop_floors,
        labels: labels,
        tests: tests,
        gathers: gathers,
    }
}

/// A scope with nothing bound in it yet.
fn no_names() -> Map<string, Bound> {
    let names: Map<string, Bound> = {}
    names
}

impl Lowering {
    // ── The walk ────────────────────────────────────────────────────

    /// `e`'s value, emitted: what the node means, by its rule.
    mut fn lower(e: ExprId) -> Reg { self.lowered_as(e, false) }

    /// `e` as a value nothing reads, emitted: what it does.
    mut fn dropped(e: ExprId) -> Reg { self.lowered_as(e, true) }

    /// `e` emitted, then lifted into what its seat takes; a dropped value is lifted nowhere.
    mut fn lowered_as(e: ExprId, dropped: bool) -> Reg {
        if dropped {
            let core = self.meaning_of(e)
            return self.store.expr(core).lowered_dropped(self, core)
        }
        let born = self.born(e)
        let seat? = self.seat_at(e) else { return born }
        let ty? = self.type_at(self.meaning_of(e)) else { return born }
        self.lifted(born, self.worn_as(born) ?? ty, seat)
    }

    /// `e`'s value as its own type holds it, emitted by the rule of the core node it means: what a
    /// node that hands its seat on (a block its tail) asks for.
    mut fn born(e: ExprId) -> Reg {
        let core = self.meaning_of(e)
        self.store.expr(core).lowered(self, core)
    }

    /// The core node `e` means: itself where it's core already; an instance's value, the literal its
    /// meaning minted, where the meaning also judges it.
    fn meaning_of(e: ExprId) -> ExprId {
        let meant? = self.store.instance_value(e) ?? self.store.meant(e) else { return e }
        self.meaning_of(meant)
    }

    /// `s`, emitted: what it means, by its rule.
    mut fn lower_stmt(s: StmtId) {
        let meant? = self.store.stmt_meant(s) else { return self.store.stmt(s).stmt_lowered(self, s) }
        self.store.stmt(s).meant_lowered(self, s, meant)
    }

    /// A block's statements, then its tail's value, lowered in the scope open now, which joins what they
    /// hold where it ends; any other node lowered.
    mut fn lowered_open(e: ExprId) -> Reg {
        let core = self.meaning_of(e)
        if self.store.block_stmts(core) == null { return self.lower(e) }
        for s in self.store.lead_of(core) { self.lower_stmt(s) }
        let tail? = self.store.tail_of(core) else { return self.hollow_of(owned_type("void")) }
        self.born(tail)
    }

    /// A statement lowered in a shape other lowerings may give it otherwise, counted.
    mut fn reshaped() { self.program.reshaped.set(self.program.reshaped.get() + 1) }

    /// A branch whose value nothing reads: a block's statements in a scope of names of their own, or
    /// the one expression it is, dropped.
    mut fn arm_stmts(value: ExprId) {
        let stmts? = self.store.block_stmts(value) else {
            let _ = self.dropped(value)
            return
        }
        self.opened()
        for s in stmts { self.lower_stmt(s) }
        self.closed()
    }

    /// `e` isn't lowered yet: its kind noted, and a register nothing reads in its place.
    mut fn unlowered(e: ExprId) -> Reg { self.missed_as("`${self.store.expr(e).surface().node}`") }

    /// `s` isn't lowered yet: its kind noted.
    mut fn stmt_unlowered(s: StmtId) { self.missed("`${self.store.stmt(s).surface().node}`") }

    /// What isn't lowered yet, noted.
    mut fn missed(what: string) { self.missing.push(what) }

    /// What isn't lowered yet, noted, and a register nothing reads in its place.
    mut fn missed_as(what: string) -> Reg {
        self.missed(what)
        self.mint(Layout.Void)
    }

    // ── Types and layouts ───────────────────────────────────────────

    /// The type `e` has in the core, absent when typing didn't find one.
    fn type_at(e: ExprId) -> SignedType? { if e.index < self.types.length { self.types[e.index] } else { null } }

    /// The type `e`'s seat wants, absent where its seat names none.
    fn seat_at(e: ExprId) -> SignedType? { self.seats.get("${e.index}") }

    /// A binding's type: as it's written, else its value's.
    fn binding_type(written: TypeRef?, value: ExprId) -> SignedType? {
        if written == null { self.type_at(value) } else { self.written(written!) }
    }

    /// What a value of `ty` is to the machine; a type whose layout isn't known is noted.
    mut fn laid_out(ty: SignedType) -> Layout {
        let laid? = self.program.checked.layout(ty) else {
            self.missed("the layout of `${ty.spelled()}`${self.unlaid_part(ty, [])}")
            return Layout.Void
        }
        laid
    }

    /// Where `ty`, whose layout isn't known, holds the first part whose layout isn't: a field, a
    /// variant's payload, or a type argument, followed down; or that it names no type at all;
    /// nothing where every part is known.
    fn unlaid_part(ty: SignedType, met: List<string>) -> string {
        if met.contains(ty.spelled()) { return "" }
        if ty.head is .Unnamed { return ", which names no type where it's read" }
        let seen = met.concat([ty.spelled()])
        let parts = [UnlaidPart { said: "its field `${f.name}`", ty: f.ty! } for f in self.fields_of(ty) ?? [] if f.ty != null]
            .concat(
                [UnlaidPart { said: "its variant `${v.name}`'s payload `${p.name}`", ty: p.ty! } for v in self.variants_of(ty) ?? [] for p in v.payloads if p.ty != null],
            )
            .concat([UnlaidPart { said: "its argument `${a.spelled()}`", ty: a } for a in ty.args])
        let first? = parts.find((p) -> self.program.checked.layout(p.ty) == null) else { return "" }
        ", ${first.said}${self.unlaid_part(first.ty, seen)}"
    }

    /// What `e`'s value is to the machine; an untyped node is noted.
    mut fn layout_at(e: ExprId) -> Layout {
        let ty? = self.type_at(e) else {
            self.missed("an untyped `${self.store.expr(e).surface().node}`")
            return Layout.Void
        }
        self.laid_out(ty)
    }

    /// A type written in the body, resolved.
    fn written(ty: TypeRef) -> SignedType { (self.program.checked.written)(ty) }

    /// The fields of the record `ty` is, each typed under its arguments; absent for a type that's no
    /// record, or that doesn't give the record every argument.
    fn fields_of(ty: SignedType) -> List<FieldSeat>? {
        if ty.nullable() || ty.dynamic { return null }
        let record? = (self.program.checked.record_of)(ty) else { return null }
        if ty.args.length != record.params { return null }
        [f with { ty: f.ty?.bound(ty.args) } for f in record.fields]
    }

    /// The shape the named type `ty` stands over, absent for any other type.
    fn named_over(ty: SignedType) -> SignedType? { (self.program.checked.named_of)(ty) }

    /// The variants of the enum `ty` is, `Result` among them, each payload typed under its arguments;
    /// absent for a type that's no enum, or that doesn't give the enum every argument.
    fn variants_of(ty: SignedType) -> List<VariantSeat>? {
        let shape? = self.program.checked.enum_shape(ty) else { return null }
        if ty.args.length != shape.params { return null }
        [v with { payloads: [p with { ty: p.ty?.bound(ty.args) } for p in v.payloads] } for v in shape.variants]
    }

    /// What each of `seats` is to the machine, absent when one's type isn't known.
    mut fn seat_layouts(seats: List<FieldSeat>) -> List<Layout>? {
        if seats.any(it.ty == null) { return null }
        [self.laid_out(s.ty!) for s in seats]
    }

    /// What a top-level name the body reads or calls at `e` is.
    fn named(e: ExprId, name: string) -> NamedValue? { (self.program.named)(name, self.store.home_of(e)) }

    /// The declared method `name` a value of `ty` has, absent where the program declares none.
    fn method(ty: SignedType, name: string) -> CalledFn? { (self.program.method)(ty, name) }

    /// The static fn `name` the type `ty` has, absent where the program declares none.
    fn static_fn(ty: SignedType, name: string) -> CalledFn? { (self.program.statics)(ty, name) }

    /// Whether the type `ty` names is declared with type parameters.
    fn generic_declared(ty: SignedType) -> bool {
        (self.program.checked.record_of)(ty)?.params ?? 0 > 0 ||
            self.program.checked.enum_shape(ty)?.params ?? 0 > 0
    }

    // ── Names ───────────────────────────────────────────────────────

    /// `name` bound in the innermost scope.
    mut fn bind(name: string, b: Bound) {
        let scopes = self.scopes.get()
        mut innermost = scopes.last()!
        innermost.set(name, b)
        self.scopes.set_at(scopes.length - 1, innermost)
    }

    /// What `name` is bound to here, absent when the body binds it nowhere in view.
    fn bound(name: string) -> Bound? { reversed(self.scopes.get()).find(it.has(name))?.get(name) }

    /// Whether `name` here is one of the fn's seats: bound in the outermost scope, where the seats
    /// are, and nowhere further in.
    fn seat_named(name: string) -> bool {
        let scopes = self.scopes.get()
        reversed(scopes).find_index(it.has(name)) == scopes.length - 1
    }

    /// The fn's seat `name` of type `ty`: the next register, as the seats mint in order.
    mut fn seated(name: string, ty: SignedType) { self.bind(name, Bound.Value(self.mint(self.laid_out(ty)), ty)) }

    /// A read of `b` at `e`: its register, or what its cell holds now; where a test proved a nullable
    /// binding present, what it carries. A read typed any other way isn't lowered yet.
    mut fn read(e: ExprId, b: Bound) -> Reg {
        let ty = b.type()
        let worn = self.type_at(e)?.spelled()
        if worn != ty.spelled() && !(ty.nullable() && worn == ty.unwrapped().spelled()) { return self.missed_as("a narrowed read") }
        let held = self.held(b)
        if worn == ty.spelled() { held } else { self.carried(held, ty) }
    }

    /// What `b` holds now, as its own type: its register, what its cell holds, or its lane of the box.
    mut fn held(b: Bound) -> Reg {
        match b {
            .Value(r, _) -> r,
            .Slot(cell, ty) -> self.loaded(self.laid_out(ty), cell),
            .Outer(name, ty, lanes) -> {
                let l = self.laid_out(ty)
                self.unboxed_at(l, Reg { index: 0 }, capture_slot(lanes, name, l.slots()))
            },
        }
    }

    // ── Registers ───────────────────────────────────────────────────
    // A register is minted with the instruction that defines it, after every register that
    // instruction reads: operands first, the answer last.

    /// A fresh register of layout `l`.
    mut fn mint(l: Layout) -> Reg {
        let r = Reg { index: self.layouts.get().length }
        self.layouts.push(l)
        r
    }

    /// `i`, emitted.
    mut fn emit(i: Ins) { self.ins.push(i) }

    /// What register `r` is to the machine.
    fn layout_of(r: Reg) -> Layout { self.layouts.get()[r.index] }

    // ── Constants ───────────────────────────────────────────────────

    mut fn const_int(n: int) -> Reg { self.word_at(Layout.Word, n) }

    mut fn const_bool(b: bool) -> Reg {
        let r = self.mint(Layout.Truth)
        self.emit(Ins.ConstBool(r, b))
        r
    }

    mut fn const_str(s: string) -> Reg {
        let r = self.mint(Layout.Boxed(BoxKind.Text))
        self.emit(Ins.ConstStr(r, s))
        r
    }

    /// A float constant, given as its IEEE-754 bits.
    mut fn const_float(bits: int) -> Reg {
        let r = self.mint(Layout.Real)
        self.emit(Ins.ConstFloat(r, bits))
        r
    }

    /// The word `n` in a register of layout `l`: a void's nothing, a pointer's null.
    mut fn word_at(l: Layout, n: int) -> Reg {
        let r = self.mint(l)
        self.emit(Ins.ConstInt(r, n))
        r
    }

    /// A literal's constant.
    mut fn constant(v: Literal) -> Reg {
        match v {
            .Int(n) -> self.const_int(n),
            .Float(bits) -> self.const_float(bits),
            .Bool(b) -> self.const_bool(b),
            .Text(s) -> self.const_str(s),
        }
    }

    // ── Operations ──────────────────────────────────────────────────

    /// An eager binary operation, its operands one layout, answering a value of layout `l`.
    mut fn bin(l: Layout, op: BinOp, a: Reg, b: Reg) -> Reg {
        let dst = self.mint(l)
        self.emit(Ins.Bin(dst, op, a, b))
        dst
    }

    /// `!src`.
    mut fn not(src: Reg) -> Reg {
        let dst = self.mint(Layout.Truth)
        self.emit(Ins.Un(dst, UnOp.Not, src))
        dst
    }

    /// The registers `elems` as one value of layout `l`.
    mut fn pack(l: Layout, elems: List<Reg>) -> Reg {
        let dst = self.mint(l)
        self.emit(Ins.Pack(dst, elems))
        dst
    }

    // ── Calls ───────────────────────────────────────────────────────

    /// A call of the body the program answers `target`'s code hash with, answering a value of
    /// layout `l`.
    mut fn code_hash_called(l: Layout, target: CalledFn) -> Reg {
        let dst = self.mint(l)
        self.emit(Ins.Call(dst, code_hash_symbol(target.symbol), []))
        dst
    }

    /// A call of a declared fn by its symbol, answering a value of layout `l`.
    mut fn call_fn(l: Layout, callee: CalledFn, args: List<Reg>) -> Reg {
        self.reached(callee)
        let dst = self.mint(l)
        self.emit(Ins.Call(dst, callee.symbol, args))
        self.task_test(TestSite.Calls(callee)) { cx -> cx.unwound_test() }
        dst
    }

    /// `callee` among the fns the body reaches, once.
    mut fn reached(callee: CalledFn) { if !self.callees.get().any(it.symbol == callee.symbol) { self.callees.push(callee) } }

    /// A call of a fn C defines, answering a value of layout `l`; one answering nothing answers a
    /// void's register.
    mut fn call_c(l: Layout, symbol: string, args: List<Reg>) -> Reg {
        match l {
            .Void -> {
                self.emit(Ins.CallRtVoid(symbol, args))
                self.unwound_after(rt_waits(symbol))
                self.word_at(Layout.Void, 0)
            },
            .Word or .Truth or .Real or .Boxed(_) or .Bare or .Fields(_) or .Tagged(_) or .Maybe(_) -> {
                let dst = self.mint(l)
                self.emit(Ins.CallRt(dst, symbol, args))
                self.unwound_after(rt_waits(symbol))
                dst
            },
        }
    }

    /// A call of the runtime's row `row`, answering a value of layout `l`.
    mut fn call_row(l: Layout, row: RtSig, args: List<Reg>) -> Reg { self.call_c(l, row.name, args) }

    /// A call of the runtime's row `row`, which answers nothing.
    mut fn run_row(row: RtSig, args: List<Reg>) {
        self.emit(Ins.CallRtVoid(row.name, args))
        self.unwound_after(row.waits)
    }

    /// A call of the runtime's row `row` answering a value of layout `l`, or nothing, where the answer
    /// and each argument cross as the one word each is; a wider value crosses boxed, which isn't
    /// lowered yet.
    mut fn call_words(l: Layout, row: RtSig, args: List<Reg>) -> Reg {
        if !(l.one_word() || l.inline() || l.empty()) || !self.crossable(args) { return self.missed_as(wider_than_a_word(row)) }
        self.call_crossed(l, row, args)
    }

    /// A call of the runtime's row `row`, which answers nothing, each argument crossing as the one
    /// word it is; a wider value crosses boxed, which isn't lowered yet.
    mut fn run_words(row: RtSig, args: List<Reg>) {
        if !self.crossable(args) { return self.missed(wider_than_a_word(row)) }
        self.run_crossed(row, args)
    }

    // ── The test after a call ───────────────────────────────────────
    // A call that may reach a cancel point is followed by one read of the running task's unwinding
    // flag; set, the fn leaves at once, answering a hollow its caller never reads, since the caller
    // tests in turn. Each test is lowered where it stands and held beside the body, so one lowering
    // serves every placement.

    /// The unwinding test, after a call that `may` reach a cancel point.
    mut fn unwound_after(may: bool) {
        if !may { return }
        self.task_test(TestSite.Waits) { cx -> cx.unwound_test() }
    }

    /// The running task's unwinding flag read, and the fn left where it's set.
    mut fn unwound_test() { self.void_region(self.flag_read(RtFlag.Unwinding)) { cx -> cx.unwound_exit() } }

    /// A task test at `site`, lowered by `body` with its own instructions and notes, its registers
    /// minted in place, then held: every placement keeping it splices it back where it stood.
    mut fn task_test(site: TestSite, body: fn(mut Lowering) -> void) {
        if self.holding {
            body(self)
            return
        }
        let ins = self.ins
        let missing = self.missing
        let first = self.layouts.get().length
        self.ins = Cell.new([])
        self.missing = Cell.new([])
        self.holding = true
        body(self)
        self.holding = false
        let held = TaskTest {
            site: site,
            at: ins.get().length,
            ins: self.ins.get(),
            first: first,
            count: self.layouts.get().length - first,
            missed_at: missing.get().length,
            missing: self.missing.get(),
        }
        self.ins = ins
        self.missing = missing
        self.tests.push(held)
    }

    /// What the fn answers leaving unwinding: a task an empty cell, which no joiner reads as a value;
    /// any other fn a hollow no caller reads.
    mut fn exit_answer() -> Reg {
        if self.tasked { return self.call_row(Layout.Boxed(BoxKind.List), rt_sig_of("avra_array_new")!, []) }
        self.hollow_of(self.answer)
    }

    /// The flag `flag` read in place: one load, no call.
    mut fn flag_read(flag: RtFlag) -> Reg {
        let r = self.mint(Layout.Truth)
        self.emit(Ins.FlagRead(r, flag))
        r
    }

    /// A loop's back edge: a `while` the source writes spins, and where the program links a scheduler
    /// reads the tick, whose taken side lets others run; a walk's back edge is neither.
    mut fn back_edge(s: StmtId) {
        if self.walks.get().contains(s.index) { return }
        self.program.spins.set(true)
        self.task_test(TestSite.Ticks) { cx -> cx.tick_test() }
    }

    /// The tick read, and the scheduler run where it's taken.
    mut fn tick_test() {
        self
            .void_region(self.flag_read(RtFlag.Tick)) { cx -> cx.run_row(rt_sig_of("avra_tick_cold")!, []) }
    }

    /// The `while`s among `stmts` a walk means: their back edges are no cancel point.
    mut fn walking(stmts: List<StmtId>) { self.walks.set(self.walks.get().concat([s.index for s in stmts])) }

    // ── Regions ─────────────────────────────────────────────────────
    // A region is ONE expression whose arms are blocks handed the context, so no rule opens a bracket
    // it doesn't close. The answer mints last, after every arm's.

    /// A two-armed region answering a value of layout `l`: `taken` when `cond` holds, else `other`.
    mut fn region(
        cond: Reg,
        l: Layout,
        taken: fn(mut Lowering) -> Reg,
        other: fn(mut Lowering) -> Reg,
    ) -> Reg {
        // LICENSED compiler.if_start_raw: this IS the verb
        self.emit(Ins.IfStart(cond))
        // LICENSED compiler.arm_end_raw: this IS the verb
        self.emit(Ins.ArmEnd(taken(self)))
        let last = other(self)
        let dst = self.mint(l)
        // LICENSED compiler.region_end_raw: this IS the verb
        self.emit(Ins.RegionEnd(dst, last))
        dst
    }

    /// A region over `selector` answering a value of layout `l`: arm `j` taken where the selector is
    /// `cases[j]`, and arm `cases.length` where it's none of them.
    mut fn switched(selector: Reg, cases: List<int>, l: Layout, arm: fn(mut Lowering, int) -> Reg) -> Reg {
        self.emit(Ins.SwitchStart(selector, cases))
        for j in 0..cases.length {
            // LICENSED compiler.arm_end_raw: this IS the verb
            self.emit(Ins.ArmEnd(arm(self, j)))
        }
        let last = arm(self, cases.length)
        let dst = self.mint(l)
        // LICENSED compiler.region_end_raw: this IS the verb
        self.emit(Ins.RegionEnd(dst, last))
        dst
    }

    /// A two-armed region whose value nothing reads: each arm closes on a word nobody reads.
    mut fn void_branches(
        cond: Reg,
        taken: fn(mut Lowering) -> void,
        other: fn(mut Lowering) -> void,
    ) {
        // LICENSED compiler.if_start_raw: this IS the verb
        self.emit(Ins.IfStart(cond))
        taken(self)
        // LICENSED compiler.arm_end_raw: this IS the verb
        self.emit(Ins.ArmEnd(self.const_int(0)))
        other(self)
        let last = self.const_int(0)
        let dst = self.mint(Layout.Word)
        // LICENSED compiler.region_end_raw: this IS the verb
        self.emit(Ins.RegionEnd(dst, last))
    }

    /// A region whose value nothing reads: `body` runs where `cond` holds, and nothing where it doesn't.
    mut fn void_region(cond: Reg, body: fn(mut Lowering) -> void) {
        // LICENSED compiler.if_start_raw: this IS the verb
        self.emit(Ins.IfStart(cond))
        body(self)
        // LICENSED compiler.arm_end_raw: this IS the verb
        self.emit(Ins.ArmEnd(self.const_int(0)))
        let last = self.const_int(0)
        let dst = self.mint(Layout.Word)
        // LICENSED compiler.region_end_raw: this IS the verb
        self.emit(Ins.RegionEnd(dst, last))
    }

    // ── Scopes ──────────────────────────────────────────────────────

    /// A scope opens: what it makes is released where it ends.
    mut fn scope_enter() {
        // LICENSED compiler.scope_enter_raw: this IS the verb
        self.emit(Ins.ScopeEnter(Level.Application))
    }

    /// A scope ends, `gives` escaping it.
    mut fn scope_exit(gives: Reg?) {
        // LICENSED compiler.scope_exit_raw: this IS the verb
        self.emit(Ins.ScopeExit(gives))
    }

    // ── Loops ───────────────────────────────────────────────────────
    // `loop_start`, the condition's instructions, `loop_cond`, which opens the turn's scope, the body,
    // then `loop_end`.

    mut fn loop_start() {
        self.loops.set(self.loops.get() + 1)
        self.labels.push([])
        // LICENSED compiler.loop_start_raw: this IS the verb
        self.emit(Ins.LoopStart)
    }

    /// The condition each turn tests, then the turn's scope.
    mut fn loop_cond(more: Reg) {
        // LICENSED compiler.loop_cond_raw: this IS the verb
        self.emit(Ins.LoopCond(more))
        self.scope_enter()
        self.loop_floors.push(self.endings.get().length)
        self.opened()
    }

    mut fn loop_end() {
        self.closed()
        let floors = self.loop_floors.get()
        self.loop_floors.set(floors.take(floors.length - 1))
        self.scope_exit(null)
        // LICENSED compiler.loop_end_raw: this IS the verb
        self.emit(Ins.LoopEnd)
        self.loops.set(self.loops.get() - 1)
        let labels = self.labels.get()
        self.labels.set(labels.take(labels.length - 1))
    }

    /// The innermost loop's turn ends here, what its turn's scopes hold ended: its next begins when
    /// `again`, else the loop ends.
    mut fn jumped(again: bool) {
        if self.loops.get() == 0 { return self.missed("a jump outside a loop") }
        self.ended_from(self.loop_floors.get().last() ?? 0, Leaving.Plain)
        self.emit(Ins.LoopJump(0, again))
    }

    /// A `break` or `continue` of the open loop labelled `label`, the innermost so labelled, every
    /// scope inside it ended.
    mut fn jumped_to(label: string, again: bool) {
        let labels = self.labels.get()
        let at? = [j for j, names in labels if names.contains(label)].last() else { return self.missed("a jump naming no loop around it") }
        self.ended_from(self.loop_floors.get()[at], Leaving.Plain)
        self.emit(Ins.LoopJump(labels.length - 1 - at, again))
    }

    /// The innermost open loop labelled by `names`: a jump naming one leaves or turns that loop.
    mut fn labelled(names: List<string>) {
        let labels = self.labels.get()
        self.labels.set(labels.take(labels.length - 1).concat([names]))
    }

    // ── Walks ───────────────────────────────────────────────────────

    /// A walk over the list `list` of `elem`s, from its start to its length.
    mut fn walk_list(list: Reg, elem: SignedType) -> ListWalk {
        let len = self.call_row(Layout.Word, rt_sig_of("avra_array_len")!, [list])
        ListWalk {
            list: list,
            len: len,
            at: self.seeded_cell(Layout.Word, self.const_int(0)),
            elem: elem,
            elem_layout: self.laid_out(elem),
        }
    }

    /// A count from `lo` up to `hi`, each read already.
    mut fn walk_count(lo: Reg, hi: Reg) -> ListWalk {
        ListWalk {
            list: null,
            len: hi,
            at: self.seeded_cell(Layout.Word, lo),
            elem: owned_type("int"),
            elem_layout: Layout.Word,
        }
    }

    /// A count over the range `r`, a box of two slots: from its start up to its end, each read once.
    mut fn walk_range(r: Reg) -> ListWalk {
        let lo = self.element_at(Layout.Word, r, self.const_int(0))
        self.walk_count(lo, self.element_at(Layout.Word, r, self.const_int(1)))
    }

    /// A turn of the walk opened: the loop, its test that the walk stands short of its length, the
    /// turn's scope, then the step past this place. Answers the place.
    mut fn walk_turn(w: ListWalk) -> Reg {
        self.loop_start()
        let here = self.loaded(Layout.Word, w.at)
        self.loop_cond(self.bin(Layout.Truth, BinOp.Lt, here, w.len))
        self.stored(w.at, self.bin(Layout.Word, BinOp.Add, here, self.const_int(1)))
        here
    }

    // ── Cells ───────────────────────────────────────────────────────

    /// A cell of layout `l`, holding `seed`: the seed minted before the cell.
    mut fn seeded_cell(l: Layout, seed: Reg) -> Reg {
        let cell = self.mint(l)
        self.emit(Ins.Alloca(cell))
        self.emit(Ins.Store(cell, seed))
        cell
    }

    /// What `cell` holds now, a value of layout `l`.
    mut fn loaded(l: Layout, cell: Reg) -> Reg {
        let dst = self.mint(l)
        self.emit(Ins.Load(dst, cell))
        dst
    }

    /// `v` written into `cell`.
    mut fn stored(cell: Reg, v: Reg) { self.emit(Ins.Store(cell, v)) }

    // ── Exits ───────────────────────────────────────────────────────

    /// The fn leaves here, answering `answer`, or nothing, what every scope holds ended first.
    mut fn answer_exit(answer: Reg?) {
        let gives = answer ?? self.hollow_of(owned_type("void"))
        self.ended_from(0, if answer == null { Leaving.Plain } else { Leaving.Answering(answer!) })
        self.kept_once(gives)
        self.emit(Ins.FnExit(gives))
    }

    // ── Hollows ─────────────────────────────────────────────────────
    // A value of a type that's never read but must be total: what an arm that left yields, and what
    // a block ending in a statement answers.

    /// A value of `ty` nobody reads: a nullable's absence, else its type's zero.
    mut fn hollow_of(ty: SignedType) -> Reg {
        let l = self.laid_out(ty)
        if ty.nullable() { self.absent_of(ty, l) } else { self.zero_of(l) }
    }

    /// The zero of layout `l`: each field's zero, a value enum's spare tag beside a zero word.
    mut fn zero_of(l: Layout) -> Reg {
        match l {
            .Tagged(_) -> self.pack(l, [self.const_int(ABSENT_TAG), self.const_int(0)]),
            .Fields(fields) -> self.pack(l, [self.zero_of(f) for f in fields]),
            .Truth -> self.const_bool(false),
            .Real -> self.const_float(0),
            .Maybe(value) -> self.pack(l, [self.const_bool(false), self.zero_of(value)]),
            .Void or .Word or .Boxed(_) or .Bare -> self.word_at(l, 0),
        }
    }

    /// The absence of `ty`, a nullable of layout `l`: a null pointer, a spare tag, or a pair whose
    /// flag is false.
    mut fn absent_of(ty: SignedType, l: Layout) -> Reg {
        match l {
            .Maybe(_) -> {
                let payload = self.hollow_of(ty.unwrapped())
                self.pack(l, [self.const_bool(false), payload])
            },
            .Tagged(_) -> self.pack(l, [self.const_int(ABSENT_TAG), self.const_int(0)]),
            .Word -> self.pack(l, [self.const_int(ABSENT_TAG)]),
            .Void or .Truth or .Real or .Boxed(_) or .Bare or .Fields(_) -> self.word_at(l, 0),
        }
    }
}

/// How a value of `ty` holds tasks its scope joins: false for one task, true for a list of them or
/// the language's group of them; absent for any other value.
fn tasks_held(ty: SignedType?) -> bool? {
    let t? = ty else { return null }
    if t.nullable() || t.dynamic { return null }
    let word? = t.owned() else { return null }
    if word == "Task" { return false }
    if word == "Tasks" { return true }
    if word != "List" { return null }
    let elem? = t.args.first() else { return null }
    if !elem.nullable() && elem.owned() == "Task" { true } else { null }
}

/// A value wider than a word crossing `row`, which isn't lowered yet.
fn wider_than_a_word(row: RtSig) -> string { "a value wider than a word crossing `${row.name}`" }

/// An enum's spare tag: the one no variant has, which its nullable spends on absence.
export const ABSENT_TAG: int = -1

/// The symbol of the body that answers `target`'s code hash.
export fn code_hash_symbol(target: string) -> string { "${CODE_HASH_PREFIX}${target}" }

/// The fn whose code hash the body `symbol` answers; absent for any other symbol.
export fn code_hash_target(symbol: string) -> string? {
    if symbol.starts_with(CODE_HASH_PREFIX) { symbol.substring(CODE_HASH_PREFIX.length, symbol.length) } else { null }
}

/// What a code hash's body is named by, before the fn whose hash it answers.
const CODE_HASH_PREFIX: string = "avra.code_hash."

/// A part of a type, as a layout's refusal names it, and its type.
type UnlaidPart = { said: string, ty: SignedType }
