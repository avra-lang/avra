//! The language AST substrate: nodes in append-only arenas, addressed
//! by typed ids. Children are ids, never boxed nodes. Every per-node
//! fact — span, content fingerprint, later types — lives in a side
//! table keyed by the id, so a node's identity is the hash of its
//! structure alone: reformatting never changes a fingerprint.
//!
//! Ids are opaque: compared or looked up, never inspected. All
//! allocation goes through the one `alloc_*` seam per arena, so
//! interning can arrive without call-site churn.

/// Typed index into the expression arena. A single-field struct, not
/// an int newtype — see the subset note on newtypes in generic flows.
export type ExprId = { index: int }

/// Typed index into the statement arena.
export type StmtId = { index: int }

/// The binary operators. And/Or are LAZY — their owner evaluates
/// and lowers them as control; every other op is an eager Bin.
export enum BinOp { Add, Sub, Mul, Div, Mod, Eq, Ne, Lt, Le, Gt, Ge, And, Or }

/// The operator's surface symbol — THE one projection; consumers
/// (parser, law wording, renderer) query, never keep their own.
export fn op_symbol(op: BinOp) -> string {
    match op {
        .Add -> "+",
        .Sub -> "-",
        .Mul -> "*",
        .Div -> "/",
        .Mod -> "%",
        .Eq -> "==",
        .Ne -> "!=",
        .Lt -> "<",
        .Le -> "<=",
        .Gt -> ">",
        .Ge -> ">=",
        .And -> "&&",
        .Or -> "||",
    }
}

/// Every binary operator — the roster symbol->op derivations scan.
export fn all_binops() -> List<BinOp> {
    let ops: List<BinOp> =
        [BinOp.Add, BinOp.Sub, BinOp.Mul, BinOp.Div, BinOp.Mod,
         BinOp.Eq, BinOp.Ne, BinOp.Lt, BinOp.Le, BinOp.Gt, BinOp.Ge,
         BinOp.And, BinOp.Or]
    ops
}

export enum Expr {
    IntLit(value: int)
    StrLit(value: string)
    BoolLit(value: bool)
    Ident(name: string)
    Binary(op: BinOp, left: ExprId, right: ExprId)
    /// Boolean negation — the one unary, until minus.
    Not(value: ExprId)
    /// The first aggregate — homogeneous scalar elements.
    ListLit(elems: List<ExprId>)
    /// `subject[index]` — element access.
    Index(subject: ExprId, index: ExprId)
    /// `subject.name` — a property read; TYPING refuses unknown
    /// names, so the parse stays generous.
    Prop(subject: ExprId, name: string)
    /// `"a ${x} b"` — parts always one longer than holes.
    Interp(parts: List<string>, holes: List<ExprId>)
    If(cond: ExprId, on_true: ExprId, on_false: ExprId)
    /// Multi-way choice; `fallback` is the total `_` arm.
    When(conds: List<ExprId>, values: List<ExprId>, fallback: ExprId)
    /// Statements then a value — a scope as an expression.
    Block(stmts: List<StmtId>, value: ExprId)
    /// A direct call by name; fn values arrive later.
    Call(callee: string, args: List<ExprId>)
    /// A parse failure's placeholder — the tree survives bad input.
    Error
}

/// The VALUE PROTOCOL: a literal node's payload, one projection per
/// value category — what features read instead of matching a
/// variant, their own included.
export fn truth_of(e: Expr) -> bool? {
    match e {
        .BoolLit(v) -> v,
        _ -> null,
    }
}

export fn int_of(e: Expr) -> int? {
    match e {
        .IntLit(v) -> v,
        _ -> null,
    }
}

export fn text_of(e: Expr) -> string? {
    match e {
        .StrLit(v) -> v,
        _ -> null,
    }
}

export fn elems_of(e: Expr) -> List<ExprId>? {
    match e {
        .ListLit(elems) -> elems,
        _ -> null,
    }
}

/// One declared parameter: its name and its annotated type NAME —
/// surface syntax, resolved to a shape by the type pass.
export type Param = { name: string, ty: string }

export enum Stmt {
    Let(name: string, value: ExprId)
    /// A reassignable binding — scalars only, until ownership
    /// analysis arrives for managed values.
    MutLet(name: string, value: ExprId)
    /// Reassignment of a `mut` binding, by name.
    Assign(name: string, value: ExprId)
    /// An expression at statement position.
    ExprStmt(value: ExprId)
    FnDecl(name: string, params: List<Param>, ret: string, body: ExprId)
    /// Condition re-evaluated each turn; the body is a scope.
    While(cond: ExprId, stmts: List<StmtId>)
    /// `for name in from..to` — binds `name` over the body. `cond`
    /// and `step` are parse-time desugar (`name < to`, `name + 1`):
    /// real nodes every pass walks, so the loop is mut+while in
    /// costume.
    For(name: string, from: ExprId, to: ExprId, cond: ExprId, step: ExprId, stmts: List<StmtId>)
    Error
}

/// The language AST's arenas plus their fingerprint side tables. A
/// synthesized node's span is null.
export type NodeStore = {
    exprs: Arena<Expr>,
    expr_fingerprints: List<int>,
    stmts: Arena<Stmt>,
    stmt_fingerprints: List<int>,
}

export fn new_node_store() -> NodeStore {
    NodeStore {
        exprs: new_arena<Expr>(), expr_fingerprints: [],
        stmts: new_arena<Stmt>(), stmt_fingerprints: [],
    }
}

impl NodeStore {
    /// The one expression-allocation seam.
    fn alloc_expr(self, e: Expr, span: Span?) -> ExprId {
        mut fingerprints = self.expr_fingerprints
        fingerprints.push(self.fingerprint_expr(e))
        ExprId { index: self.exprs.add(e, span) }
    }

    /// The one statement-allocation seam.
    fn alloc_stmt(self, s: Stmt, span: Span?) -> StmtId {
        mut fingerprints = self.stmt_fingerprints
        fingerprints.push(self.fingerprint_stmt(s))
        StmtId { index: self.stmts.add(s, span) }
    }

    fn expr(self, id: ExprId) -> Expr { self.exprs.node_at(id.index) }
    fn stmt(self, id: StmtId) -> Stmt { self.stmts.node_at(id.index) }
    fn expr_span(self, id: ExprId) -> Span? { self.exprs.span_at(id.index) }
    fn stmt_span(self, id: StmtId) -> Span? { self.stmts.span_at(id.index) }
    fn expr_fingerprint(self, id: ExprId) -> int { self.expr_fingerprints[id.index] }
    fn stmt_fingerprint(self, id: StmtId) -> int { self.stmt_fingerprints[id.index] }

    /// The span containing both expressions, when both are known.
    fn cover(self, a: ExprId, b: ExprId) -> Span? {
        let sa = self.expr_span(a)
        let sb = self.expr_span(b)
        if sa == null || sb == null { return null }
        sa!.cover(sb!)
    }

    /// Content identity: a stable variant tag folded with payloads
    /// and child fingerprints, in order. Spans never participate.
    /// Tags are never reused; the next free tag is 24.
    fn fingerprint_expr(self, e: Expr) -> int {
        match e {
            .IntLit(value) -> fp(1, [value]),
            .Ident(name) -> fp(2, [fp_str(name)]),
            .Binary(op, left, right) ->
                fp(3, [fp_binop(op), self.expr_fingerprint(left), self.expr_fingerprint(right)]),
            .Error -> fp(4, []),
            .Not(value) -> fp(19, [self.expr_fingerprint(value)]),
            .ListLit(elems) -> fp(20, self.expr_fps(elems)),
            .Index(subject, index) ->
                fp(21, [self.expr_fingerprint(subject), self.expr_fingerprint(index)]),
            .Prop(subject, name) ->
                fp(22, [self.expr_fingerprint(subject), fp_str(name)]),
            .Interp(parts, holes) ->
                fp(23, concat([fp_str(p) for p in parts], self.expr_fps(holes))),
            .StrLit(value) -> fp(8, [fp_str(value)]),
            .BoolLit(value) -> fp(9, [if value { 1 } else { 0 }]),
            .If(cond, on_true, on_false) ->
                fp(10, [self.expr_fingerprint(cond), self.expr_fingerprint(on_true),
                        self.expr_fingerprint(on_false)]),
            .Call(callee, args) -> fp(11, concat([fp_str(callee)], self.expr_fps(args))),
            .When(conds, values, fallback) ->
                fp(13, flatten([self.expr_fps(conds), self.expr_fps(values),
                                [self.expr_fingerprint(fallback)]])),
            .Block(stmts, value) ->
                fp(14, concat(self.stmt_fps(stmts), [self.expr_fingerprint(value)])),
        }
    }

    /// The fingerprints of expression children, in order.
    fn expr_fps(self, ids: List<ExprId>) -> List<int> {
        [self.expr_fingerprint(k) for k in ids]
    }

    /// The fingerprints of statement children, in order.
    fn stmt_fps(self, ids: List<StmtId>) -> List<int> {
        [self.stmt_fingerprint(k) for k in ids]
    }

    fn fingerprint_stmt(self, s: Stmt) -> int {
        match s {
            .Let(name, value) -> fp(5, [fp_str(name), self.expr_fingerprint(value)]),
            .MutLet(name, value) -> fp(15, [fp_str(name), self.expr_fingerprint(value)]),
            .Assign(name, value) -> fp(16, [fp_str(name), self.expr_fingerprint(value)]),
            .While(cond, stmts) ->
                fp(17, concat([self.expr_fingerprint(cond)], self.stmt_fps(stmts))),
            // For's cond and step derive from name/from/to — the
            // identity needs only the sources.
            .For(name, from, to, _, _, stmts) ->
                fp(18, concat([fp_str(name), self.expr_fingerprint(from), self.expr_fingerprint(to)],
                              self.stmt_fps(stmts))),
            .ExprStmt(value) -> fp(6, [self.expr_fingerprint(value)]),
            .Error -> fp(7, []),
            .FnDecl(name, params, ret, body) ->
                fp(12, flatten([[fp_str(name)], param_fps(params),
                                [fp_str(ret), self.expr_fingerprint(body)]])),
        }
    }
}

/// A param list's fingerprint parts: name, type, in declaration order.
fn param_fps(params: List<Param>) -> List<int> {
    flatten([[fp_str(p.name), fp_str(p.ty)] for p in params])
}

fn fp_binop(op: BinOp) -> int {
    match op {
        .Add -> 1,
        .Sub -> 2,
        .Eq -> 3,
        .Lt -> 4,
        .Mul -> 5,
        .Div -> 6,
        .Mod -> 7,
        .Ne -> 8,
        .Le -> 9,
        .Gt -> 10,
        .Ge -> 11,
        .And -> 12,
        .Or -> 13,
    }
}

/// A variant tag folded with its parts, in order.
fn fp(tag: int, parts: List<int>) -> int {
    mut h = tag
    for p in parts { h = fp_mix(h, p) }
    h
}

/// In-process rolling hash; both operands normalized under a prime so
/// mixing never overflows, negative payloads included. The crypto
/// tier arrives with the on-disk cache.
fn fp_mix(h: int, v: int) -> int {
    mut nv = v % 1000000007
    if nv < 0 { nv = nv + 1000000007 }
    (h * 131 + nv + 7) % 1000000007
}

fn fp_str(s: string) -> int {
    mut h = 0
    mut i = 0
    while i < s.length {
        h = fp_mix(h, code_at(s, i))
        i = i + 1
    }
    fp_mix(h, s.length)
}
