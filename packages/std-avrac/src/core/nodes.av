//! The language AST substrate: nodes in append-only arenas, addressed
//! by typed ids. Children are ids, never boxed nodes. Every per-node
//! fact — span, content fingerprint, later types — lives in a side
//! table keyed by the id, so a node's identity is the hash of its
//! structure alone: reformatting never changes a fingerprint.
//!
//! Ids are opaque: compared or looked up, never inspected. All
//! allocation goes through the one `alloc_*` seam per arena, so
//! interning can arrive without call-site churn.

/// Typed index into the expression arena. A single-field struct, not
/// an int newtype — see the subset note on newtypes in generic flows.
export type ExprId = { index: int }

/// Typed index into the statement arena.
export type StmtId = { index: int }

/// A DECLARATION's identity across the workspace — a fn, type, enum,
/// trait or method — minted once per declaration; every type shape
/// that names a declaration carries it, never a file-local StmtId.
/// In a lone file the two coincide; the workspace makes them differ.
export type DeclId = { index: int }

/// Declaration identity — one id, one declaration.
export fn same_decl(a: DeclId, b: DeclId) -> bool {
    // LICENSED I9: declaration identity, not type agreement — ids compare by index
    a.index == b.index
}

/// A FILE's identity across the workspace — minted once per path,
/// before its parse.
export type FileId = { index: int }

export fn same_file(a: FileId, b: FileId) -> bool {
    // LICENSED I9: file identity, not type agreement — ids compare by index
    a.index == b.index
}

/// What a name USE resolves to — the ONE binding currency every
/// consumer dispatches on. A new binding kind (a captured upvalue,
/// a loop's counter) is a new VARIANT here, and every consumer's
/// match breaks loudly.
///
/// EVERY VARIANT OWES TWO FACTS, one per pass — the passes cannot
/// share a table, so each keeps its own and the shapes MIRROR:
///
///   variant    TYPE fact (typing)     REGISTER fact (lowering)
///   Param      param_types[i]         the index IS the register
///   Def        decls[stmt]            slots[stmt]
///   Pattern    pattern_types[arm]     pattern_regs[arm]
///
/// A new variant answers both columns or the build refuses.
export enum Binding {
    /// The enclosing fn's Nth parameter — params ARE registers.
    Param(index: int)
    /// A binding statement (`let`, `mut`, `fn`) — the definition
    /// site is the identity.
    Def(stmt: StmtId)
    /// A PATTERN's Nth bind, held for the ONE arm whose value this
    /// is — the first binding in the language that is not a
    /// statement. The arm's value IS the identity, so both later
    /// passes key their facts by it like any other node fact; the
    /// index is the bind's place in the pattern's pre-order.
    Pattern(arm: ExprId, index: int)
    /// A LAMBDA's Nth parameter — in the LIFTED body, register N+1
    /// (the env box rides seat 0). Type fact: the lambda's own
    /// annotation table.
    LambdaParam(lam: ExprId, index: int)
    /// A name a lambda CAPTURED — slot 1+index of its env box. The
    /// lambda's capture fact names the underlying outer binding;
    /// nesting chains Capture through Capture.
    Capture(lam: ExprId, index: int)
    /// A pairing loop's INDEX — an int, the loop's own counter; the
    /// statement is the identity, beside its element binding.
    Index(stmt: StmtId)
    /// A DECLARATION — a fn, a type, a trait — this file's or any
    /// other's, by the table's identity; the scope resolved it.
    Decl(decl: DeclId)
}

/// What a declaring statement declares. A Method is an impl's or a
/// trait's fn, minted under its owner; a Default is a record
/// field's default value — a body of its own, called by every
/// literal that omits the field; an Impl is the block itself (its
/// contract is checked as one); Main is a file's run-time
/// statements, one synthetic declaration per file.
export enum DeclKind {
    Fn
    Record
    Enum
    Trait
    Method
    Default
    Impl
    Main
}

/// A MODULE's identity — a directory under the root, interned.
export type ModuleId = { index: int }

/// The binary operators. And/Or are LAZY — their owner evaluates
/// and lowers them as control; every other op is an eager Bin.
export enum BinOp { Add, Sub, Mul, Div, Mod, Eq, Ne, Lt, Le, Gt, Ge, And, Or }

/// The operator's surface symbol — THE one projection; consumers
/// (parser, law wording, renderer) query, never keep their own.
export fn op_symbol(op: BinOp) -> string {
    match op {
        .Add -> "+",
        .Sub -> "-",
        .Mul -> "*",
        .Div -> "/",
        .Mod -> "%",
        .Eq -> "==",
        .Ne -> "!=",
        .Lt -> "<",
        .Le -> "<=",
        .Gt -> ">",
        .Ge -> ">=",
        .And -> "&&",
        .Or -> "||",
    }
}

/// Every binary operator — the roster symbol->op derivations scan.
export fn all_binops() -> List<BinOp> {
    let ops: List<BinOp> =
        [BinOp.Add, BinOp.Sub, BinOp.Mul, BinOp.Div, BinOp.Mod,
         BinOp.Eq, BinOp.Ne, BinOp.Lt, BinOp.Le, BinOp.Gt, BinOp.Ge,
         BinOp.And, BinOp.Or]
    ops
}

export enum Expr {
    IntLit(value: int)
    StrLit(value: string)
    BoolLit(value: bool)
    Ident(name: string)
    Binary(op: BinOp, left: ExprId, right: ExprId)
    /// Boolean negation — the one unary, until minus.
    Not(value: ExprId)
    /// The first aggregate — homogeneous scalar elements.
    ListLit(elems: List<ExprId>)
    /// `{ "k": v, … }` — keys and values in written order.
    MapLit(keys: List<ExprId>, values: List<ExprId>)
    /// `subject[index]` — element access.
    Index(subject: ExprId, index: ExprId)
    /// `subject.name` — a property read; TYPING refuses unknown
    /// names, so the parse stays generous.
    Prop(subject: ExprId, name: string)
    /// `"a ${x} b"` — parts always one longer than holes.
    Interp(parts: List<string>, holes: List<ExprId>)
    If(cond: ExprId, on_true: ExprId, on_false: ExprId)
    /// Multi-way choice; `fallback` is the total `_` arm.
    When(conds: List<ExprId>, values: List<ExprId>, fallback: ExprId)
    /// Statements then a value — a scope as an expression. The
    /// value is ABSENT only when the last statement DIVERGES
    /// (`return`, `fail`): a block that leaves needs no tail, and
    /// it answers whatever the fn it leaves promises.
    Block(stmts: List<StmtId>, value: ExprId?)
    /// A direct call by name; fn values arrive later. `pins` are
    /// explicit type arguments (`f<int>(x)`) — empty when inferred.
    Call(callee: string, pins: List<TypeRef>, args: List<ExprId>)
    /// `Name { field: value, ... }` — fields in WRITTEN order
    /// (evaluation order); lowering reorders to declaration slots.
    StructLit(name: string, fields: List<string>, values: List<ExprId>)
    /// `subject with { field: value, ... }` — a modified COPY; the
    /// unwritten fields carry over.
    With(subject: ExprId, fields: List<string>, values: List<ExprId>)
    /// `match subject { pattern -> value, ... }` — the first arm
    /// whose pattern accepts the subject answers; typing proves the
    /// arms cover the subject (every variant, or a catch-all).
    Match(subject: ExprId, arms: List<Arm>)
    /// The absent value. Its type inhabits every `T?` and nothing
    /// else, which is what makes `let x: int = null` refuse.
    NullLit
    /// `left ?? right` — the left value unless it is absent. The
    /// right side is evaluated ONLY then.
    Coalesce(left: ExprId, right: ExprId)
    /// `match v { b? -> present, null -> absent }` — the absence
    /// answered by ASKING. Exactly two arms, and `bind` names what
    /// the present arm receives, so no arm needs a string tag.
    MatchOpt(subject: ExprId, bind: string, present: ExprId, absent: ExprId)
    /// `(params) -> body` — a CLOSURE: the body may read outer
    /// names, captured BY VALUE into the closure's box at
    /// creation (value semantics makes by-value capture silent).
    /// Param types ride Param.ty; an unannotated param refuses
    /// until the expected-type channel lands.
    Lambda(params: List<Param>, body: ExprId)
    /// `subject(args)` — a call on an EXPRESSION: the fn value the
    /// subject holds is applied. `f(x)` by NAME stays the direct
    /// Call; this node is the postfix `pick(m)(x)` / `(lambda)(x)`.
    CallValue(subject: ExprId, args: List<ExprId>)
    /// `subject?.name` — the member of what a nullable CARRIES,
    /// nullable again: an absent subject answers absence, and the
    /// whole chain short-circuits on the first one.
    Chain(subject: ExprId, name: string)
    /// `value!` — the absence answered by INSISTING. The type loses
    /// its `?`; a value that is absent anyway refuses at runtime,
    /// which is the whole cost of writing it.
    Force(value: ExprId)
    /// `subject is .variant` — the tag test; typing demands an enum
    /// subject that names the variant, and answers bool.
    Is(subject: ExprId, variant: string)
    /// `value?` — the absence answered by PASSING IT ON: a present
    /// value unwraps; an absent one makes the ENCLOSING fn answer
    /// `null` right here, so the fn must promise a nullable.
    Propagate(value: ExprId)
    /// `subject catch <recovery>` — recover from a Result's
    /// failure. Arms mirror Match's shape: `variants[j]` names the
    /// error variant an arm takes ("" is a catch-all arm),
    /// `binds[j]` what it receives ("" is nothing). COVERAGE
    /// decides the type: a total catch recovers to the ok side; a
    /// selective one stays the Result, the unmatched propagating.
    Catch(subject: ExprId, variants: List<string>, binds: List<string>, values: List<ExprId>)
    /// `subject.name(args)` — a METHOD call: the impl the
    /// receiver's TYPE names supplies the fn; `subject` rides as
    /// its first argument. Resolution is provable at typing —
    /// never a runtime lookup.
    MethodCall(subject: ExprId, name: string, args: List<ExprId>)
    /// A parse failure's placeholder — the tree survives bad input.
    Error
}

/// The VALUE PROTOCOL: a literal node's payload, one projection per
/// value category — what features read instead of matching a
/// variant, their own included.
export fn truth_of(e: Expr) -> bool? {
    match e {
        .BoolLit(v) -> v,
        _ -> null,
    }
}

export fn text_of(e: Expr) -> string? {
    match e {
        .StrLit(v) -> v,
        _ -> null,
    }
}

/// A map literal's keys and values, in written order.
export type MapPairs = { keys: List<ExprId>, values: List<ExprId> }

/// The map-literal projection of the value protocol.
export fn pairs_of(e: Expr) -> MapPairs? {
    match e {
        .MapLit(keys, values) -> MapPairs { keys: keys, values: values },
        _ -> null,
    }
}

export fn elems_of(e: Expr) -> List<ExprId>? {
    match e {
        .ListLit(elems) -> elems,
        _ -> null,
    }
}

/// A WRITTEN type: its name, its arguments (`List<int>`), and
/// whether it was written nullable (`int?`). An annotation is DATA,
/// not a node — no pass walks one — so its span rides here rather
/// than in a side table.
export type TypeRef = { name: string, args: List<TypeRef>, optional: bool, dynamic: bool, arrow: bool, span: Span? }

/// The same written type with its `?` dropped — what a nullable
/// CARRIES, which is the thing the declared-slot law judges.
export fn plain(t: TypeRef) -> TypeRef {
    TypeRef { name: t.name, args: t.args, optional: false, dynamic: t.dynamic, arrow: t.arrow, span: t.span }
}

/// A written type, spelled back — what a diagnostic quotes.
export fn spelled(t: TypeRef) -> string {
    let base = if t.args.is_empty() { t.name }
               else { "${t.name}<${joined([spelled(a) for a in t.args], ", ")}>" }
    if t.optional { return "${base}?" }
    base
}

/// One declared parameter: its name and its written type. An ABSENT
/// type IS a unit enum variant, so one shape covers both and no arm
/// has to ask which kind it is.
/// A declared seat — a fn's param, a lambda's, a struct's field, an
/// enum variant's payload — with the DEFAULT a field may declare.
export type Param = { name: string, ty: TypeRef?, default: ExprId? }

/// A pattern's identity in the store's pattern table.
export type PatId = { index: int }

/// What an arm accepts. A pattern is a tree over the subject's
/// shape: a variant test with one pattern per payload, a literal to
/// equal, a name that binds the value at its path, or the hole —
/// `_` (which the lint watches) and `rest` (the deliberate
/// remainder, exempt).
export enum Pat {
    Wild
    Rest
    Bind(name: string)
    Variant(name: string, args: List<PatId>)
    Lit(value: ExprId)
}

/// One match arm: its alternatives (`a or b`) and its value.
export type Arm = { pats: List<PatId>, value: ExprId }

/// One declared variant: its name and what it carries, in order —
/// a single positional payload, or named fields.
export type Variant = { name: string, payloads: List<Param> }

/// One step of a PLACE — where a mutation lands.
export enum PlaceStep {
    Root(name: string)
    Field(subject: ExprId, name: string)
    At(subject: ExprId, index: ExprId)
}

/// A `use` statement's projection: the path, the items, the site.
export type UseParts = { path: List<string>, items: List<string>, stmt: StmtId }

export enum Stmt {
    /// `let name = v`, optionally `let name: T = v` — the written
    /// type, when declared, is what the binding HOLDS; the value
    /// must be accepted by it.
    Let(name: string, ty: TypeRef?, value: ExprId)
    /// A reassignable binding — unmanaged values only, until
    /// ownership analysis; optionally annotated, holding what it
    /// declares exactly as `let` does.
    MutLet(name: string, ty: TypeRef?, value: ExprId)
    /// Reassignment of a `mut` binding, by name.
    Assign(target: ExprId, value: ExprId)
    /// An expression at statement position.
    ExprStmt(value: ExprId)
    /// `tparams` are the declared type parameters, in order — the
    /// ordinal IS the Var identity; a tparam's `ty` names its
    /// BOUND (`<T: Show>`), absent when unconstrained.
    FnDecl(name: string, tparams: List<Param>, params: List<Param>, ret: TypeRef, body: ExprId)
    /// Condition re-evaluated each turn; the body is a scope.
    While(cond: ExprId, stmts: List<StmtId>)
    /// `if c { … }` (optionally `else { … }`) at STATEMENT
    /// position: the branches are statement lists and the whole
    /// carries no value — the guard idiom's home. An absent else
    /// IS the empty list.
    IfStmt(cond: ExprId, then_stmts: List<StmtId>, else_stmts: List<StmtId>)
    /// `return v` — the enclosing fn answers NOW. Typing accepts
    /// `v` against the declared return; lowering exits with every
    /// open scope's debts settled at the site.
    Return(value: ExprId)
    /// `fail value` — raise: the enclosing fn answers the failure
    /// channel of its Result right here. Diverges, like `return`.
    Fail(value: ExprId)
    /// `impl Target { fns… }` — methods for a declared type: each
    /// fn's bare `self` first param types as the target, and the
    /// fn lowers under a QUALIFIED name (`Target.method`). `of`
    /// names the TRAIT being implemented — "" for an inherent impl
    /// — and an impl-for must answer every trait method.
    ImplDecl(of: string, target: string, fns: List<StmtId>)
    /// `trait Name { fn sigs… }` — a nominal behavior contract.
    /// The sigs ride as BODYLESS fn declarations (body = a hole no
    /// pass walks), so declare and totality reuse fn machinery.
    TraitDecl(name: string, fns: List<StmtId>)
    /// `let name? = subject else { stmts }` — the bind-fresh form
    /// that KEEPS GOING: a present subject binds its carried value
    /// in the enclosing scope; an absent one runs the else, which
    /// must leave. Parsed by `let_stmt`; nullability gives it
    /// meaning.
    LetElse(name: string, subject: ExprId, stmts: List<StmtId>)
    /// `for name in from..to` — binds `name` over the body. `cond`
    /// and `step` are parse-time desugar (`name < to`, `name + 1`):
    /// real nodes every pass walks, so the loop is mut+while in
    /// costume.
    For(name: string, from: ExprId, to: ExprId, cond: ExprId, step: ExprId, stmts: List<StmtId>)
    /// `use a.b.{x, y}` — the path's segments (a `@pkg` head kept
    /// as written) and the items brought into scope.
    Use(path: List<string>, items: List<string>)
    /// `for x in xs` — or `for i, x in xs`, the index beside the
    /// element, the loop's own counter with a name.
    ForEach(index: string?, name: string, subject: ExprId, stmts: List<StmtId>)
    /// `type Name = { field: ty, ... }` — a nominal record; the
    /// name lives in the TYPE namespace, program-wide like fns.
    StructDecl(name: string, tparams: List<string>, fields: List<Param>)
    /// `enum Name { A B(payload: int) }` — a nominal closed set
    /// sharing the TYPE namespace with records. A variant is a
    /// Param: an ABSENT `ty` IS a unit variant.
    EnumDecl(name: string, tparams: List<string>, variants: List<Variant>)
    Error
}

/// The language AST's arenas plus their fingerprint side tables. A
/// synthesized node's span is null.
export type NodeStore = {
    exprs: Arena<Expr>,
    expr_fingerprints: List<int>,
    stmts: Arena<Stmt>,
    stmt_fingerprints: List<int>,
    exported: List<bool>,
    pats: List<Pat>,
    pat_spans: List<Span?>,
    pat_fingerprints: List<int>,
}

export fn new_node_store() -> NodeStore {
    NodeStore {
        exprs: new_arena<Expr>(), expr_fingerprints: [],
        stmts: new_arena<Stmt>(), stmt_fingerprints: [], exported: [],
        pats: [], pat_spans: [], pat_fingerprints: [],
    }
}

impl NodeStore {
    /// The one expression-allocation seam.
    fn alloc_expr(self, e: Expr, span: Span?) -> ExprId {
        mut fingerprints = self.expr_fingerprints
        fingerprints.push(self.fingerprint_expr(e))
        ExprId { index: self.exprs.add(e, span) }
    }

    /// The one pattern-allocation seam.
    fn alloc_pat(self, p: Pat, span: Span?) -> PatId {
        mut fingerprints = self.pat_fingerprints
        fingerprints.push(self.fingerprint_pat(p))
        mut spans = self.pat_spans
        spans.push(span)
        mut ps = self.pats
        ps.push(p)
        PatId { index: ps.length - 1 }
    }

    fn pat(self, id: PatId) -> Pat { self.pats[id.index] }
    fn pat_span(self, id: PatId) -> Span? { self.pat_spans[id.index] }
    fn pat_fingerprint(self, id: PatId) -> int { self.pat_fingerprints[id.index] }

    /// The names a pattern binds, in pre-order — the arm's bind
    /// order, which every pass keys by index.
    fn pattern_binds(self, id: PatId) -> List<string> {
        match self.pat(id) {
            .Bind(name) -> [name],
            .Variant(_, args) -> flatten([self.pattern_binds(a) for a in args]),
            .Wild or .Rest or .Lit(_) -> [],
        }
    }

    /// A pattern nothing can refuse: a hole or a name.
    fn irrefutable(self, id: PatId) -> bool {
        match self.pat(id) {
            .Wild or .Rest or .Bind(_) -> true,
            .Variant(_, _) or .Lit(_) -> false,
        }
    }

    /// The pattern's fingerprint parts: its own shape, then its
    /// children's.
    fn fingerprint_pat(self, p: Pat) -> int {
        match p {
            .Wild -> fp(50, []),
            .Rest -> fp(51, []),
            .Bind(name) -> fp(52, [fp_str(name)]),
            .Variant(name, args) -> fp(53, [fp_str(name)].concat([self.pat_fingerprint(a) for a in args])),
            .Lit(v) -> fp(54, [self.expr_fingerprint(v)]),
        }
    }

    /// An arm list's fingerprint parts: each arm's patterns, then
    /// its value.
    fn arm_fps(self, arms: List<Arm>) -> List<int> {
        flatten([[self.pat_fingerprint(p) for p in a.pats].concat([self.expr_fingerprint(a.value)]) for a in arms])
    }

    /// The one statement-allocation seam.
    fn alloc_stmt(self, s: Stmt, span: Span?) -> StmtId {
        mut fingerprints = self.stmt_fingerprints
        fingerprints.push(self.fingerprint_stmt(s))
        mut ex = self.exported
        ex.push(false)
        StmtId { index: self.stmts.add(s, span) }
    }

    /// `export` crossed this declaration — the module's surface
    /// carries it.
    fn mark_exported(self, s: StmtId) {
        mut ex = self.exported
        ex.set(s.index, true)
    }

    fn is_exported(self, s: StmtId) -> bool {
        self.exported[s.index]
    }

    /// A `use` statement's parts, when the statement is one.
    fn use_parts(self, s: StmtId) -> UseParts? {
        match self.stmt(s) {
            .Use(path, items) -> UseParts { path: path, items: items, stmt: s },
            _ -> null,
        }
    }

    fn expr(self, id: ExprId) -> Expr { self.exprs.node_at(id.index) }
    fn stmt(self, id: StmtId) -> Stmt { self.stmts.node_at(id.index) }
    fn expr_span(self, id: ExprId) -> Span? { self.exprs.span_at(id.index) }
    fn stmt_span(self, id: StmtId) -> Span? { self.stmts.span_at(id.index) }
    fn expr_fingerprint(self, id: ExprId) -> int { self.expr_fingerprints[id.index] }
    fn stmt_fingerprint(self, id: StmtId) -> int { self.stmt_fingerprints[id.index] }

    /// The span containing both expressions, when both are known.
    fn cover(self, a: ExprId, b: ExprId) -> Span? {
        let sa = self.expr_span(a)
        let sb = self.expr_span(b)
        if sa == null || sb == null { return null }
        sa!.cover(sb!)
    }

    /// A PLACE's last step, when the expression is one: a bare name,
    /// a field of a subject, or an index into one. The one
    /// projection for the place category — every other shape is a
    /// value, not a place.
    fn place_step(self, e: ExprId) -> PlaceStep? {
        match self.expr(e) {
            .Ident(name) -> PlaceStep.Root(name),
            .Prop(subject, name) -> PlaceStep.Field(subject, name),
            .Index(subject, index) -> PlaceStep.At(subject, index),
            .IntLit(_) or .StrLit(_) or .BoolLit(_) or .NullLit or .Error or .Binary(_, _, _) or
            .Not(_) or .ListLit(_) or .MapLit(_, _) or .Interp(_, _) or .If(_, _, _) or .Call(_, _, _) or
            .CallValue(_, _) or .When(_, _, _) or .Block(_, _) or .StructLit(_, _, _) or
            .With(_, _, _) or .Match(_, _) or .Catch(_, _, _, _) or .MatchOpt(_, _, _, _) or
            .Chain(_, _) or .Coalesce(_, _) or .Force(_) or .Propagate(_) or .MethodCall(_, _, _) or
            .Lambda(_, _) or .Is(_, _) -> null,
        }
    }

    /// The binding a place is rooted in — the name at the bottom of
    /// its path; null when the expression is not a place.
    fn place_root(self, e: ExprId) -> ExprId? {
        let step: PlaceStep? = self.place_step(e)
        if step == null { return null }
        match step! {
            .Root(_) -> e,
            .Field(subject, _) -> self.place_root(subject),
            .At(subject, _) -> self.place_root(subject),
        }
    }

    /// The INDEX name a pairing loop binds — null for every other
    /// statement, and for a loop that names only its element.
    fn loop_index(self, s: StmtId) -> string? {
        match self.stmt(s) {
            .ForEach(index, _, _, _) -> index,
            _ -> null,
        }
    }

    /// A bare name's text; null for every other expression.
    fn ident_name(self, e: ExprId) -> string? {
        match self.expr(e) {
            .Ident(name) -> name,
            _ -> null,
        }
    }

    /// Does the PRONOUN ride this subtree unbound? `it` belongs to
    /// the nearest enclosing METHOD call: a lambda binds its own
    /// scope (false), a nested method call's arguments started
    /// fresh scopes at their own build (subject only), and every
    /// other node asks its children. A block's STATEMENTS do not
    /// carry the pronoun (recorded) — only its answering value.
    /// Exhaustive: a new expression must answer.
    fn pronoun_rides(self, id: ExprId) -> bool {
        match self.expr(id) {
            .Ident(name) -> name == "it",
            .Lambda(_, _) -> false,
            .MethodCall(subject, _, _) -> self.pronoun_rides(subject),
            .IntLit(_) or .StrLit(_) or .BoolLit(_) or .NullLit or .Error -> false,
            .Binary(_, left, right) -> self.pronoun_rides(left) || self.pronoun_rides(right),
            .Not(v) -> self.pronoun_rides(v),
            .Force(v) -> self.pronoun_rides(v),
            .Is(v, _) -> self.pronoun_rides(v),
            .Propagate(v) -> self.pronoun_rides(v),
            .ListLit(elems) -> self.any_rides(elems),
            .MapLit(keys, values) -> self.any_rides(keys) || self.any_rides(values),
            .Index(subject, index) -> self.pronoun_rides(subject) || self.pronoun_rides(index),
            .Prop(subject, _) -> self.pronoun_rides(subject),
            .Chain(subject, _) -> self.pronoun_rides(subject),
            .Interp(_, holes) -> self.any_rides(holes),
            .If(cond, on_true, on_false) ->
                self.pronoun_rides(cond) || self.pronoun_rides(on_true) || self.pronoun_rides(on_false),
            .Call(callee, _, args) -> callee == "it" || self.any_rides(args),
            .CallValue(subject, cargs) -> self.pronoun_rides(subject) || self.any_rides(cargs),
            .When(conds, values, fallback) ->
                self.any_rides(conds) || self.any_rides(values) || self.pronoun_rides(fallback),
            .Block(_, value) -> if value == null { false } else { self.pronoun_rides(value!) },
            .StructLit(_, _, values) -> self.any_rides(values),
            .With(subject, _, values) -> self.pronoun_rides(subject) || self.any_rides(values),
            .Match(subject, arms) -> self.pronoun_rides(subject) || self.any_rides([a.value for a in arms]),
            .Catch(subject, _, _, values) -> self.pronoun_rides(subject) || self.any_rides(values),
            .MatchOpt(subject, _, present, absent) ->
                self.pronoun_rides(subject) || self.pronoun_rides(present) || self.pronoun_rides(absent),
            .Coalesce(l, r) -> self.pronoun_rides(l) || self.pronoun_rides(r),
        }
    }

    fn any_rides(self, ids: List<ExprId>) -> bool {
        // LICENSED I5: bs2's pronoun detector misses self-method
        // wrappers — the scan is spelled
        for k in ids {
            if self.pronoun_rides(k) { return true }
        }
        false
    }

    /// Content identity: a stable variant tag folded with payloads
    /// and child fingerprints, in order. Spans never participate.
    /// Tags are never reused; the next free tag is 51.
    fn fingerprint_expr(self, e: Expr) -> int {
        match e {
            .IntLit(value) -> fp(1, [value]),
            .Ident(name) -> fp(2, [fp_str(name)]),
            .Binary(op, left, right) ->
                fp(3, [fp_binop(op), self.expr_fingerprint(left), self.expr_fingerprint(right)]),
            .Error -> fp(4, []),
            .Not(value) -> fp(19, [self.expr_fingerprint(value)]),
            .ListLit(elems) -> fp(20, self.expr_fps(elems)),
            .MapLit(keys, values) -> fp(48, self.expr_fps(keys).concat(self.expr_fps(values))),
            .Index(subject, index) ->
                fp(21, [self.expr_fingerprint(subject), self.expr_fingerprint(index)]),
            .Prop(subject, name) ->
                fp(22, [self.expr_fingerprint(subject), fp_str(name)]),
            .Interp(parts, holes) ->
                fp(23, [fp_str(p) for p in parts].concat(self.expr_fps(holes))),
            .StrLit(value) -> fp(8, [fp_str(value)]),
            .BoolLit(value) -> fp(9, [if value { 1 } else { 0 }]),
            .If(cond, on_true, on_false) ->
                fp(10, [self.expr_fingerprint(cond), self.expr_fingerprint(on_true),
                        self.expr_fingerprint(on_false)]),
            .Call(callee, pins, args) ->
                fp(11, flatten([[fp_str(callee)], [type_fp(p) for p in pins],
                                self.expr_fps(args)])),
            .When(conds, values, fallback) ->
                fp(13, flatten([self.expr_fps(conds), self.expr_fps(values),
                                [self.expr_fingerprint(fallback)]])),
            .Block(stmts, value) ->
                fp(14, self.stmt_fps(stmts).concat(self.tail_fp(value))),
            .StructLit(name, fields, values) ->
                fp(24, flatten([[fp_str(name)], [fp_str(f) for f in fields],
                                self.expr_fps(values)])),
            .With(subject, fields, values) ->
                fp(26, flatten([[self.expr_fingerprint(subject)],
                                [fp_str(f) for f in fields], self.expr_fps(values)])),
            .Match(subject, arms) ->
                fp(28, [self.expr_fingerprint(subject)].concat(self.arm_fps(arms))),
            .NullLit -> fp(30, []),
            .Coalesce(l, r) ->
                fp(31, [self.expr_fingerprint(l), self.expr_fingerprint(r)]),
            .Force(v) -> fp(32, [self.expr_fingerprint(v)]),
            .Is(v, variant) -> fp(49, [self.expr_fingerprint(v), fp_str(variant)]),
            .Propagate(v) -> fp(37, [self.expr_fingerprint(v)]),
            .MethodCall(subject, name, margs) ->
                fp(43, flatten([[self.expr_fingerprint(subject)], [fp_str(name)],
                                self.expr_fps(margs)])),
            .Lambda(params, body) ->
                fp(46, param_fps(params).concat([self.expr_fingerprint(body)])),
            .CallValue(subject, cargs) ->
                fp(47, [self.expr_fingerprint(subject)].concat(self.expr_fps(cargs))),
            .Catch(subject, variants, binds, values) ->
                fp(40, flatten([[self.expr_fingerprint(subject)],
                                [fp_str(v) for v in variants],
                                [fp_str(bn) for bn in binds],
                                self.expr_fps(values)])),
            .MatchOpt(subject, bind, present, absent) ->
                fp(33, [self.expr_fingerprint(subject), fp_str(bind),
                        self.expr_fingerprint(present), self.expr_fingerprint(absent)]),
            .Chain(subject, name) ->
                fp(34, [self.expr_fingerprint(subject), fp_str(name)]),
        }
    }

    /// A block tail's fingerprint contribution — nothing when the
    /// block leaves instead of answering.
    fn tail_fp(self, value: ExprId?) -> List<int> {
        if value == null { return [] }
        [self.expr_fingerprint(value!)]
    }

    /// The fingerprints of expression children, in order.
    fn expr_fps(self, ids: List<ExprId>) -> List<int> {
        [self.expr_fingerprint(k) for k in ids]
    }

    /// The fingerprints of statement children, in order.
    fn stmt_fps(self, ids: List<StmtId>) -> List<int> {
        [self.stmt_fingerprint(k) for k in ids]
    }

    fn fingerprint_stmt(self, s: Stmt) -> int {
        match s {
            .Let(name, ty, value) -> fp(5, [fp_str(name), type_fp(ty), self.expr_fingerprint(value)]),
            .MutLet(name, ty, value) -> fp(15, [fp_str(name), type_fp(ty), self.expr_fingerprint(value)]),
            .Assign(target, value) -> fp(16, [self.expr_fingerprint(target), self.expr_fingerprint(value)]),
            .While(cond, stmts) ->
                fp(17, [self.expr_fingerprint(cond)].concat(self.stmt_fps(stmts))),
            .IfStmt(cond, then_stmts, else_stmts) ->
                fp(35, flatten([[self.expr_fingerprint(cond)],
                                self.stmt_fps(then_stmts), [0],
                                self.stmt_fps(else_stmts)])),
            .Return(value) -> fp(36, [self.expr_fingerprint(value)]),
            .Fail(value) -> fp(39, [self.expr_fingerprint(value)]),
            .ImplDecl(of, target, fns) ->
                fp(44, [fp_str(of), fp_str(target)].concat(self.stmt_fps(fns))),
            .TraitDecl(name, fns) ->
                fp(45, [fp_str(name)].concat(self.stmt_fps(fns))),
            .LetElse(name, subject, stmts) ->
                fp(38, [fp_str(name), self.expr_fingerprint(subject)].concat(self.stmt_fps(stmts))),
            // For's cond and step derive from name/from/to — the
            // identity needs only the sources.
            .For(name, from, to, _, _, stmts) ->
                fp(18, [fp_str(name), self.expr_fingerprint(from), self.expr_fingerprint(to)].concat(self.stmt_fps(stmts))),
            .ExprStmt(value) -> fp(6, [self.expr_fingerprint(value)]),
            .Use(path, items) -> fp(50, [fp_str(p) for p in path].concat([fp_str(i) for i in items])),
            .ForEach(index, name, subject, stmts) ->
                fp(42, [fp_str(index ?? ""), fp_str(name), self.expr_fingerprint(subject)].concat(self.stmt_fps(stmts))),
            .Error -> fp(7, []),
            .FnDecl(name, tparams, params, ret, body) ->
                fp(12, flatten([[fp_str(name)], param_fps(tparams),
                                param_fps(params),
                                [type_fp(ret), self.expr_fingerprint(body)]])),
            .StructDecl(name, tparams, fields) ->
                fp(25, flatten([[fp_str(name)], [fp_str(t) for t in tparams],
                                param_fps(fields),
                                self.expr_fps([f.default! for f in fields if f.default != null])])),
            .EnumDecl(name, tparams, variants) ->
                fp(27, flatten([[fp_str(name)], [fp_str(t) for t in tparams],
                                variant_fps(variants)])),
        }
    }
}

/// A variant list's fingerprint parts: each name, then its payloads.
fn variant_fps(variants: List<Variant>) -> List<int> {
    flatten([[fp_str(v.name)].concat(param_fps(v.payloads)) for v in variants])
}

/// A param list's fingerprint parts: name, type, in declaration order.
fn param_fps(params: List<Param>) -> List<int> {
    flatten([[fp_str(p.name), type_fp(p.ty)] for p in params])
}

/// A written type's identity: absence is its own value, and the `?`
/// is part of what the type IS.
fn type_fp(t: TypeRef?) -> int {
    if t == null { return 0 }
    let written = t!
    fp(if written.optional { 2 } else { 1 },
       [fp_str(written.name)].concat([type_fp(a) for a in written.args]))
}

fn fp_binop(op: BinOp) -> int {
    match op {
        .Add -> 1,
        .Sub -> 2,
        .Eq -> 3,
        .Lt -> 4,
        .Mul -> 5,
        .Div -> 6,
        .Mod -> 7,
        .Ne -> 8,
        .Le -> 9,
        .Gt -> 10,
        .Ge -> 11,
        .And -> 12,
        .Or -> 13,
    }
}

/// A variant tag folded with its parts, in order — THE fingerprint
/// fold, for nodes and for every query value's hash alike.
export fn fp(tag: int, parts: List<int>) -> int {
    mut h = tag
    for p in parts { h = fp_mix(h, p) }
    h
}

/// In-process rolling hash; both operands normalized under a prime so
/// mixing never overflows, negative payloads included. The crypto
/// tier arrives with the on-disk cache.
fn fp_mix(h: int, v: int) -> int {
    mut nv = v % 1000000007
    if nv < 0 { nv = nv + 1000000007 }
    (h * 131 + nv + 7) % 1000000007
}

export fn fp_str(s: string) -> int {
    mut h = 0
    mut i = 0
    // A string's `.length` is `strlen`: asked once, not per character.
    let n = s.length
    while i < n {
        h = fp_mix(h, code_at(s, i))
        i = i + 1
    }
    fp_mix(h, n)
}
