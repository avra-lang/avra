//! The language AST substrate: nodes in append-only arenas, addressed
//! by typed ids. Children are ids, never boxed nodes. Every per-node
//! fact — span, content fingerprint, later types — lives in a side
//! table keyed by the id, so a node's identity is the hash of its
//! structure alone: reformatting never changes a fingerprint.
//!
//! Ids are opaque: compared or looked up, never inspected. All
//! allocation goes through the one `alloc_*` seam per arena, so
//! interning can arrive without call-site churn.
use @std.meta.{derive}


/// Typed index into the expression arena. A single-field struct, not
/// an int newtype — see the subset note on newtypes in generic flows.
export type ExprId = { index: int }

/// Node identity — two ids name one node when their indexes agree.
export fn same_expr(a: ExprId, b: ExprId) -> bool {
    // LICENSED I9: node identity — ids compare by index
    a.index == b.index
}

/// Typed index into the statement arena.
export type StmtId = { index: int }

/// The statement a declaration stands on when it has none — an
/// empty file's main, a builtin: the first slot, which a builtin
/// never reads.
export const no_stmt: StmtId = StmtId { index: 0 }

/// A DECLARATION's identity across the workspace — a fn, type, enum,
/// trait or method — minted once per declaration; every type shape
/// that names a declaration carries it, never a file-local StmtId.
/// In a lone file the two coincide; the workspace makes them differ.
@derive(Fingerprint)
export type DeclId = { index: int }

/// Statement identity — two ids name one statement when their
/// indexes agree.
export fn same_stmt(a: StmtId, b: StmtId) -> bool {
    // LICENSED I9: statement identity — ids compare by index
    a.index == b.index
}

/// Declaration identity — one id, one declaration.
export fn same_decl(a: DeclId, b: DeclId) -> bool {
    // LICENSED I9: declaration identity, not type agreement — ids compare by index
    a.index == b.index
}

/// A FILE's identity across the workspace — minted once per path,
/// before its parse.
export type FileId = { index: int }

export fn same_file(a: FileId, b: FileId) -> bool {
    // LICENSED I9: file identity, not type agreement — ids compare by index
    a.index == b.index
}

/// What a name USE resolves to — the ONE binding currency every
/// consumer dispatches on. A new binding kind (a captured upvalue,
/// a loop's counter) is a new VARIANT here, and every consumer's
/// match breaks loudly.
///
/// EVERY VARIANT OWES TWO FACTS, one per pass — the passes cannot
/// share a table, so each keeps its own and the shapes MIRROR:
///
///   variant    TYPE fact (typing)     REGISTER fact (lowering)
///   Param      param_types[i]         the index IS the register
///   Def        decls[stmt]            slots[stmt]
///   Pattern    pattern_types[arm]     pattern_regs[arm]
///
/// A new variant answers both columns or the build refuses.
export enum Binding {
    /// The enclosing fn's Nth parameter — params ARE registers. In
    /// a method the written parameters start at seat 1.
    Param(index: int)
    /// The enclosing method's receiver — seat 0, never written in
    /// the parameter list: `self` binds here.
    Receiver
    /// A binding statement (`let`, `mut`, `fn`) — the definition
    /// site is the identity.
    Def(stmt: StmtId)
    /// A PATTERN's Nth bind, held for the ONE arm whose value this
    /// is — the first binding in the language that is not a
    /// statement. The arm's value IS the identity, so both later
    /// passes key their facts by it like any other node fact; the
    /// index is the bind's place in the pattern's pre-order.
    Pattern(arm: ExprId, index: int)
    /// A LAMBDA's Nth parameter — in the LIFTED body, register N+1
    /// (the env box rides seat 0). Type fact: the lambda's own
    /// annotation table.
    LambdaParam(lam: ExprId, index: int)
    /// A name a lambda CAPTURED — slot 1+index of its env box. The
    /// lambda's capture fact names the underlying outer binding;
    /// nesting chains Capture through Capture.
    Capture(lam: ExprId, index: int)
    /// A pairing loop's INDEX — an int, the loop's own counter; the
    /// statement is the identity, beside its element binding.
    Index(stmt: StmtId)
    /// A DECLARATION — a fn, a type, a trait — this file's or any
    /// other's, by the table's identity; the scope resolved it.
    Decl(decl: DeclId)
}

/// What a declaring statement declares. A Method is an impl's or a
/// trait's fn, minted under its owner; a Default is a record
/// field's default value — a body of its own, called by every
/// literal that omits the field; an Impl is the block itself (its
/// contract is checked as one); Main is a file's run-time
/// statements, one synthetic declaration per file.
export enum DeclKind {
    /// A type the LANGUAGE declares — a row, not a statement: its
    /// parts come from the row, never from a store.
    Builtin
    Fn
    Record
    /// `type Name = <type>` — a name over a shape, distinct from it.
    Named
    Enum
    Trait
    /// a sublanguage — a block word and its grammar
    Syntax
    Method
    Default
    Impl
    Main
    /// One `then` of a spec — a bodied declaration answering a bool.
    Case
    /// A settled value the compiler computes — a declaration whose
    /// READ is its value, cross-file like any other.
    Const
}

/// A MODULE's identity — a directory under the root, interned.
export type ModuleId = { index: int }

/// The binary operators. And/Or are LAZY — their owner evaluates
/// and lowers them as control; every other op is an eager Bin.
/// THE BINARY OPERATORS. `And`/`Or` are the LAZY pair — `&&`/`||` —
/// and lowering diverts them to regions before any `Bin` is emitted;
/// the BITWISE five below are eager machine operations and share
/// nothing with them but a shape. APPEND-ONLY, like every registry
/// here: the fingerprint table numbers by ordinal-in-spirit and a
/// renumbering would silently rewrite every memo key.
export enum BinOp { Add, Sub, Mul, Div, Mod, Eq, Ne, Lt, Le, Gt, Ge, And, Or, BitAnd, BitOr, BitXor, Shl, Shr }

/// The operator's surface symbol — THE one projection; consumers
/// (parser, law wording, renderer) query, never keep their own.
export fn op_symbol(op: BinOp) -> string {
    match op {
        .Add -> "+",
        .Sub -> "-",
        .Mul -> "*",
        .Div -> "/",
        .Mod -> "%",
        .Eq -> "==",
        .Ne -> "!=",
        .Lt -> "<",
        .Le -> "<=",
        .Gt -> ">",
        .Ge -> ">=",
        .And -> "&&",
        .Or -> "||",
        .BitAnd -> "&",
        .BitOr -> "|",
        .BitXor -> "^",
        .Shl -> "<<",
        .Shr -> ">>",
    }
}

/// Every binary operator — the roster symbol->op derivations scan.
export const all_binops: List<BinOp> = [BinOp.Add, BinOp.Sub, BinOp.Mul, BinOp.Div, BinOp.Mod,
     BinOp.Eq, BinOp.Ne, BinOp.Lt, BinOp.Le, BinOp.Gt, BinOp.Ge,
     BinOp.And, BinOp.Or,
     BinOp.BitAnd, BinOp.BitOr, BinOp.BitXor, BinOp.Shl, BinOp.Shr]

// THE THREE KINDS OF NAME A NODE CARRIES. Every name in the tree is
// text; what differs is WHAT IT KEYS, and that fact used to live only
// in the walks that read it. It is the payload's TYPE now, so the
// enum states it and a derive can read it. Free at runtime: each is
// its own type over `string` and travels as the string it is, and
// `n.of` reads the text back.

/// A name that KEYS A SCOPE — a binder (`let x`, a parameter, a
/// pattern's bind, a fn's own name) or a READ of one (`x`, a call's
/// callee). The resolver walks the scope chain for it, so a
/// TEMPLATE filling one hands the node to the splice site's scope.
export type Scoped = string

/// A name that keys NO scope — a field, a method, a property, a
/// variant, a type parameter. It is answered by a shape the
/// compiler already knows, so filling one changes nothing about
/// where the node resolves.
export type Plain = string

/// A name in the TYPE namespace — a literal's type, an impl's
/// target. A template's hole in one is filled by a written TYPE.
export type Nominal = string

/// EVERY NODE VARIANT A GRAMMAR RULE MAY NAME, read off the
/// declarations by `@derive(Grammar)`. It stands HERE because a
/// derive's output is FILE-LOCAL — not even a sibling file in this
/// module can call what it made — so the union is written beside the
/// enums it unions.
export fn node_payload_rows() -> List<PayloadRow> {
    grammar_payloads_Expr()
        .concat(grammar_payloads_Pat())
        .concat(grammar_payloads_Stmt())
}

@derive(ValueProtocol)
@derive(Rebuild)
@derive(Grammar)
@derive(Children)
@derive(Identity)
export enum Expr {
    IntLit(value: int)
    /// A REAL literal, carried as its IEEE-754 BIT PATTERN rather than
    /// as a value. The compiler is written in Avra and Avra's own
    /// source holds no float, so the bits are how a float literal
    /// crosses the compiler that emits it — reinterpreted once, at
    /// the machine.
    FloatLit(bits: int)
    StrLit(value: string)
    BoolLit(value: bool)
    Ident(name: Scoped)
    /// `self` — the enclosing method's receiver. A keyword, so it
    /// carries no name: the binding says what it is.
    Receiver
    Binary(op: BinOp, left: ExprId, right: ExprId)
    /// Boolean negation — the one unary, until minus.
    Not(value: ExprId)
    /// The first aggregate — homogeneous scalar elements.
    ListLit(elems: List<ExprId>)
    /// `[elem for name in source if cond]` — a list built by walking
    /// another, or counting `source..hi` when `hi` is present;
    /// `index` names the position when written as `index, name`,
    /// null otherwise. The binders hold for `elem` and `cond` alone.
    Comp(elem: ExprId, index: Scoped?, name: Scoped, source: ExprId, hi: ExprId?, cond: ExprId?)
    /// `{ "k": v, … }` — keys and values in written order.
    MapLit(keys: List<ExprId>, values: List<ExprId>)
    /// `subject[index]` — element access.
    Index(subject: ExprId, index: ExprId)
    /// `subject.name` — a property read; TYPING refuses unknown
    /// names, so the parse stays generous.
    Prop(subject: ExprId, name: Plain)
    /// `"a ${x} b"` — parts always one longer than holes.
    Interp(parts: List<string>, holes: List<ExprId>)
    /// `quote { a ${x} b }` — a TEMPLATE: its body parsed here, into
    /// this store, as statements or as match arms, every hole a
    /// placeholder NAME (`holes.av`); the holes are the expressions
    /// that fill them, in body order; the parts are the runs of
    /// source between holes (one longer), the printing projection.
    @verbatim Quote(parts: List<string>, stmts: List<StmtId>, arms: List<Arm>, holes: List<ExprId>)
    /// `sql { … ${x} … }` — a SUBLANGUAGE block: the word that names
    /// its grammar, the body's text with holes as placeholders, the
    /// hole expressions in body order, and — once the file resolves —
    /// its EXPANSION, the calls the grammar's actions became, which
    /// every pass reads in its place (`expand_sublang`).
    @expands(expansion) Sublang(word: string, body: string, holes: List<ExprId>, expansion: ExprId?)
    If(cond: ExprId, on_true: ExprId, on_false: ExprId)
    /// Multi-way choice; `fallback` is the total `_` arm.
    When(conds: List<ExprId>, values: List<ExprId>, fallback: ExprId)
    /// Statements then a value — a scope as an expression. The
    /// value is ABSENT only when the last statement DIVERGES
    /// (`return`, `fail`): a block that leaves needs no tail, and
    /// it answers whatever the fn it leaves promises.
    Block(stmts: List<StmtId>, value: ExprId?)
    /// A direct call by name; fn values arrive later. `pins` are
    /// explicit type arguments (`f<int>(x)`) — empty when inferred.
    Call(callee: Scoped, pins: List<TypeRef>, args: List<ExprId>)
    /// `Name { field: value, ... }` — fields in WRITTEN order
    /// (evaluation order); lowering reorders to declaration slots.
    StructLit(name: Nominal, fields: List<Plain>, values: List<ExprId>)
    /// `subject with { field: value, ... }` — a modified COPY; the
    /// unwritten fields carry over.
    With(subject: ExprId, fields: List<Plain>, values: List<ExprId>)
    /// `match subject { pattern -> value, ... }` — the first arm
    /// whose pattern accepts the subject answers; typing proves the
    /// arms cover the subject (every variant, or a catch-all).
    Match(subject: ExprId, arms: List<Arm>)
    /// The absent value. Its type inhabits every `T?` and nothing
    /// else, which is what makes `let x: int = null` refuse.
    NullLit
    /// `left ?? right` — the left value unless it is absent. The
    /// right side is evaluated ONLY then.
    Coalesce(left: ExprId, right: ExprId)
    /// `match v { b? -> present, null -> absent }` — the absence
    /// answered by ASKING. Exactly two arms, and `bind` names what
    /// the present arm receives, so no arm needs a string tag.
    MatchOpt(subject: ExprId, bind: Scoped, present: ExprId, absent: ExprId)
    /// `(params) -> body` — a CLOSURE: the body may read outer
    /// names, captured BY VALUE into the closure's box at
    /// creation (value semantics makes by-value capture silent).
    /// Param types ride Param.ty; an unannotated param refuses
    /// until the expected-type channel lands.
    Lambda(params: List<Param>, body: ExprId)
    /// `subject(args)` — a call on an EXPRESSION: the fn value the
    /// subject holds is applied. `f(x)` by NAME stays the direct
    /// Call; this node is the postfix `pick(m)(x)` / `(lambda)(x)`.
    CallValue(subject: ExprId, args: List<ExprId>)
    /// `subject?.name` — the member of what a nullable CARRIES,
    /// nullable again: an absent subject answers absence, and the
    /// whole chain short-circuits on the first one.
    Chain(subject: ExprId, name: Plain)
    /// `value!` — the absence answered by INSISTING. The type loses
    /// its `?`; a value that is absent anyway refuses at runtime,
    /// which is the whole cost of writing it.
    Force(value: ExprId)
    /// `subject is .variant` — the tag test; typing demands an enum
    /// subject that names the variant, and answers bool.
    Is(subject: ExprId, variant: Plain)
    /// `.name(args)` — a variant of the enum the site EXPECTS; the
    /// want names the enum, the literal names the variant.
    VariantLit(name: Plain, args: List<ExprId>)
    /// `value?` — the absence answered by PASSING IT ON: a present
    /// value unwraps; an absent one makes the ENCLOSING fn answer
    /// `null` right here, so the fn must promise a nullable.
    Propagate(value: ExprId)
    /// `subject catch <recovery>` — recover from a Result's
    /// failure. Arms mirror Match's shape: `variants[j]` names the
    /// error variant an arm takes ("" is a catch-all arm),
    /// `binds[j]` what it receives ("" is nothing). COVERAGE
    /// decides the type: a total catch recovers to the ok side; a
    /// selective one stays the Result, the unmatched propagating.
    Catch(subject: ExprId, variants: List<Plain>, binds: List<Scoped>, values: List<ExprId>)
    /// `subject.name(args)` — a METHOD call: the impl the
    /// receiver's TYPE names supplies the fn; `subject` rides as
    /// its first argument. Resolution is provable at typing —
    /// never a runtime lookup.
    MethodCall(subject: ExprId, name: Plain, args: List<ExprId>)
    /// A parse failure's placeholder — the tree survives bad input.
    Error
}
/// Whether the parse tree already HOLDS this value — an int, float,
/// bool or string literal. A computed expression is not a literal:
/// reading it needs typed answers that do not exist before analysis.
export fn is_literal(e: Expr) -> bool {
    (e).int_of() != null || (e).bits_of() != null || (e).bool_of() != null || (e).text_of() != null
}

/// A FORM THE SOURCE SPELLS AS A VALUE — a scalar, text, a list, a
/// map, a variant, `null`. The parts inside may be computed; the
/// FORM is what this asks about.
///
/// A NAMED TYPE'S SEAT TAKES ONE DIRECTLY (`let id: UserId = 5`):
/// the name's shape becomes the want and the literal fills it.
/// Nothing COMPUTED wears a name it was not given, which is the
/// opacity half of the named-type law and what makes the name worth
/// having. A REGISTRY, every arm spelled: the day a new value form
/// lands it must decide whether a name adopts it.
export fn literal_form(e: Expr) -> bool {
    match e {
        .IntLit(_) or .FloatLit(_) or .StrLit(_) or .BoolLit(_) or .Interp(_, _) or
        .ListLit(_) or .Comp(_, _, _, _, _, _) or .MapLit(_, _) or .NullLit or
        .VariantLit(_, _) or .StructLit(_, _, _) -> true,
        .Ident(_) or .Receiver or .Binary(_, _, _) or .Not(_) or .Index(_, _) or .Prop(_, _) or
        .Quote(_, _, _, _) or .Sublang(_, _, _, _) or .If(_, _, _) or .When(_, _, _) or
        .Block(_, _) or .Call(_, _, _) or .With(_, _, _) or .Match(_, _) or
        .Coalesce(_, _) or .MatchOpt(_, _, _, _) or .Lambda(_, _) or .CallValue(_, _) or
        .Chain(_, _) or .Force(_) or .Is(_, _) or .Propagate(_) or
        .Catch(_, _, _, _) or .MethodCall(_, _, _) or .Error -> false,
    }
}

/// What the SOURCE alone spells: a literal, or a quote with no
/// holes — code that needs no evaluation to cross.
export fn source_spelled(e: Expr) -> bool {
    is_literal(e) || hole_free(e)
}

/// A quote with no holes is source-spelled code.
fn hole_free(e: Expr) -> bool {
    match e {
        .Quote(_, _, _, holes) -> holes.is_empty(),
        _ -> false,
    }
}

/// A map literal's keys and values, in written order.
export type MapPairs = { keys: List<ExprId>, values: List<ExprId> }
/// A quote's parts, its parsed body, and the holes between the parts.
export type QuoteParts = { parts: List<string>, stmts: List<StmtId>, arms: List<Arm>, holes: List<ExprId> }
/// A sublanguage block's word, body, holes, and expansion once made.
export type SublangParts = { word: string, body: string, holes: List<ExprId>, expansion: ExprId? }
/// What a block's grammar refused, in the file's offsets — spoken
/// with the parse's own words.
export type BlockVoice = { message: string, lo: int, hi: int, expected: List<string>, in_rule: string }
/// A run of nodes minted from a sublanguage's actions, and the file
/// whose fns they name — their origin.
export type ForeignRange = { lo: int, hi: int, path: string }
/// A WRITTEN type: its name, its arguments (`List<int>`), and
/// whether it was written nullable (`int?`). An annotation is DATA,
/// not a node — no pass walks one — so its span rides here rather
/// than in a side table.
/// `@name(args)` on a declaration: the call the compiler makes over
/// it at compile time. The callee is an ident NODE and the arguments
/// are expression nodes, so resolution and typing read them as any
/// expression — no second name law.
export type Annotation = { name: string, callee: ExprId, args: List<ExprId>, span: Span? }

export type TypeRef = { name: string, args: List<TypeRef>, optional: bool, dynamic: bool, arrow: bool, span: Span?, marks: List<SeatMark> = [] }

/// The same written type with its `?` dropped — what a nullable
/// CARRIES, which is the thing the declared-slot law judges. EVERY
/// field rides across: a fn type's `marks` are part of its identity
/// (`fn(mut Cx)` is not `fn(Cx)`), so dropping them here would hand
/// the seat law a type that had quietly lost its contract.
/// A RECONSTRUCTION NAMES WHAT CHANGES, never the rest — spelling
/// the others out drops the NEXT field silently, and a field with a
/// DEFAULT drops without even a compile error. `marks` was lost here
/// exactly so, from the day `mut` was added.
/// A written type naming a declaration, bare — THE ONE PLACE the
/// seven fields are spelled. Every other shape is this `with` what
/// differs, so a field added to `TypeRef` reaches every site through
/// one edit instead of dropping silently at each hand-spelling.
export fn named_ref(name: string) -> TypeRef {
    TypeRef { name: name, args: [], optional: false, dynamic: false, arrow: false, span: null }
}

export fn plain(t: TypeRef) -> TypeRef {
    t with { optional: false }
}

/// A written type, spelled back — what a diagnostic quotes.
export fn spelled(t: TypeRef) -> string {
    let base = if t.arrow { spelled_arrow(t) }
               else if t.args.is_empty() { "${if t.dynamic { "dyn " } else { "" }}${t.name}" }
               else { "${t.name}<${joined([spelled(a) for a in t.args], ", ")}>" }
    if t.optional { return "${base}?" }
    base
}

/// A fn type's arguments are its seats followed by its answer.
fn spelled_arrow(t: TypeRef) -> string {
    let n = t.args.length
    if n == 0 { return "fn()" }
    let seats = [mark_prefixed(mark_at(t.marks, j), spelled(a)) for j, a in t.args.slice(0, n - 1)]
    "fn(${joined(seats, ", ")}) -> ${spelled(t.args[n - 1])}"
}

/// The pronoun's own seat — what an implicit `it` lambda declares.
export const pronoun_param: Param = Param { name: "it", ty: null, default: null, promises: plain_mark, span: null }

/// A MARK IS DATA; AN ANNOTATION IS A CALL. `@word` or
/// `@word(a, b)` written before a declared member — a variant, a
/// field — is recorded and handed to whoever reads it, never run.
/// That is why its arguments are WORDS: a mark is read while the
/// file's names are still resolving, so it can reach only what the
/// parse holds. `Annotation` is the other half of the `@` surface,
/// where the arguments are expressions because something evaluates
/// them.
///
/// THE COMPILER JUDGES NO MARK. A mark's meaning lives with its
/// reader, and a reader says which marks it claims; a mark no reader
/// claims is refused where it is written, so a typo cannot be silent.
// LICENSED — a string where the doctrine says no string tag: a mark
// CROSSES into `@std/meta`, where a foreign enum has no typed id, so
// its word is the only currency both sides can spell. The same reason
// `node_value` matches `@std.meta.Node`'s variant names. The
// mitigation the doctrine names is paid in full: the unknown SPEAKS
// (workspace's claim law) rather than falling through.
export type Mark = { name: string, args: List<string>, span: Span? = null }

/// A declared seat — a fn's param, a lambda's, a struct's field, an
/// enum variant's payload — with the DEFAULT a field may declare,
/// the PROMISES it makes its callee (`mut`, `const`) and the MARKS
/// written before it. An ABSENT type IS a unit enum variant, so one
/// shape covers both and no arm has to ask which kind it is.
export type Param = { name: Scoped, ty: TypeRef?, default: ExprId?, promises: SeatMark, span: Span? = null, marks: List<Mark> = [] }

/// A member's marks as they were written, with a trailing space —
/// "" when it carries none, so a printer needs no branch.
export fn marks_prefixed(ms: List<Mark>) -> string {
    joined([mark_spelled(m) + " " for m in ms], "")
}

/// One mark as it was written.
fn mark_spelled(m: Mark) -> string {
    if m.args.is_empty() { return "@${m.name}" }
    "@${m.name}(${joined(m.args, ", ")})"
}

/// A pattern's identity in the store's pattern table.
export type PatId = { index: int }

/// What an arm accepts. A pattern is a tree over the subject's
/// shape: a variant test with one pattern per payload, a literal to
/// equal, a name that binds the value at its path, or the hole —
/// `_` (which the lint watches) and `rest` (the deliberate
/// remainder, exempt).
@derive(Rebuild)
@derive(Grammar)
export enum Pat {
    Wild
    Rest
    Bind(name: Scoped)
    Variant(name: Plain, args: List<PatId>)
    Lit(value: ExprId)
    /// A text FORMAT: literal `head`, then a hole and the literal
    /// that follows it, repeated. `"a{x}b{y}c"` is head `"a"` with
    /// parts `[{x, "b"}, {y, "c"}]`; a format with no holes is head
    /// alone. The count relationship between literals and holes is
    /// true by construction and unspellable otherwise.
    Format(head: string, parts: List<FormatPart>)
}

/// One hole of a format: the name it binds — `_` binds nothing, as
/// `Wild` spells it — the type it parses through, absent when it
/// takes the span as text, and whether it is GREEDY.
///
/// A greedy hole (`{name...}`) finds the literal after it at that
/// literal's LAST occurrence rather than its first. On the final hole
/// the two agree, because a suffix anchor already fixes that hole's
/// end — which is why the mark reads there as a statement of what the
/// hole does rather than a change to it.
export type Hole = { name: string, ty: TypeRef?, greedy: bool }

/// A hole and the literal text that follows it.
export type FormatPart = { hole: Hole, piece: string }

/// The format a `grammar` declaration read. Its holes became the
/// record's fields, and a record cannot say what text it reads —
/// so the format is kept beside the statement that declared it.
export type GrammarSpec = { head: string, parts: List<FormatPart> }

/// One name a pattern binds, and the pattern node it binds under.
export type Binder = { pat: PatId, name: string }

/// The word a name takes when it binds nothing.
export fn nothing_bound() -> string { "_" }

/// Whether a hole BINDS what it takes. One definition: the arm's
/// scope, the lowering's cuts and the pattern's bind list must agree
/// about which holes bind, and a rule spelled three times is a
/// disagreement waiting to happen that no reading would find.
export fn binds(h: Hole) -> bool {
    h.name != nothing_bound()
}

/// The names a format's parts bind, in order — the arm's bind order,
/// which every pass keys by index.
export fn bound_names(parts: List<FormatPart>) -> List<string> {
    [p.hole.name for p in parts if binds(p.hole)]
}

/// One match arm: its alternatives (`a or b`) and its value.
export type Arm = { pats: List<PatId>, value: ExprId }

/// One declared variant: its name, what it carries in order — a
/// single positional payload, or named fields — and the marks
/// written before it.
export type Variant = { name: Plain, payloads: List<Param>, span: Span? = null, marks: List<Mark> = [] }

/// One test case: its `given` group's name, its own name (the
/// `then`'s), and its body — a block answering a bool.
export type Case = { group: string, name: string, body: ExprId }

/// One step of a PLACE — where a mutation lands.
export enum PlaceStep {
    Root(name: Scoped)
    Field(subject: ExprId, name: Plain)
    At(subject: ExprId, index: ExprId)
}

/// A method call's projection: the receiver, the name, the arguments.
export type MethodParts = { subject: ExprId, name: string, args: List<ExprId> }

/// A `use` statement's projection: the path, the items, the site.
export type UseParts = { path: List<string>, items: List<string>, aliases: List<string>, stmt: StmtId }

@derive(Rebuild)
@derive(Grammar)
@derive(Children)
@derive(Identity)
export enum Stmt {
    /// `let name = v`, optionally `let name: T = v` — the written
    /// type, when declared, is what the binding HOLDS; the value
    /// must be accepted by it.
    Let(name: Scoped, ty: TypeRef?, value: ExprId)
    /// A reassignable binding — unmanaged values only, until
    /// ownership analysis; optionally annotated, holding what it
    /// declares exactly as `let` does.
    MutLet(name: Scoped, ty: TypeRef?, value: ExprId)
    /// `const name = v` — a value the COMPILER computes, so every
    /// use is that value and the program never computes it. Its
    /// initializer is evaluated at compile time, which is also the
    /// law it must satisfy: nothing the host answers, nothing that
    /// does not settle.
    ConstDecl(name: Scoped, ty: TypeRef?, value: ExprId)
    /// Reassignment of a `mut` binding, by name.
    Assign(target: ExprId, value: ExprId)
    /// An expression at statement position.
    ExprStmt(value: ExprId)
    /// `let _ = v` — the value run for its effect, never an answer.
    Discard(value: ExprId)
    /// `tparams` are the declared type parameters, in order — the
    /// ordinal IS the Var identity; a tparam's `ty` names its
    /// BOUND (`<T: Show>`), absent when unconstrained.
    @declares FnDecl(name: Scoped, tparams: List<Param>, params: List<Param>, ret: TypeRef, body: ExprId)
    /// `extern fn name(params) -> ret` — a fn the host provides: a
    /// signature with no body, called by its bare symbol.
    ExternFn(name: Scoped, params: List<Param>, ret: TypeRef)
    /// Condition re-evaluated each turn; the body is a scope.
    While(cond: ExprId, stmts: List<StmtId>)
    /// `if c { … }` (optionally `else { … }`) at STATEMENT
    /// position: the branches are statement lists and the whole
    /// carries no value — the guard idiom's home. An absent else
    /// IS the empty list.
    IfStmt(cond: ExprId, then_stmts: List<StmtId>, else_stmts: List<StmtId>)
    /// `return v` — the enclosing fn answers NOW. Typing accepts
    /// `v` against the declared return; lowering exits with every
    /// open scope's debts settled at the site.
    /// `return`, with a value or bare — a bare one leaves a void fn.
    Return(value: ExprId?)
    /// `fail value` — raise: the enclosing fn answers the failure
    /// channel of its Result right here. Diverges, like `return`.
    Fail(value: ExprId)
    /// `impl Target { fns… }` — methods for a declared type: each
    /// fn is a method: `self` types as the target, and the
    /// fn lowers under a QUALIFIED name (`Target.method`). `of`
    /// names the TRAIT being implemented — null for an inherent impl
    /// — and an impl-for must answer every trait method.
    @declares ImplDecl(of: Nominal?, target: Nominal, fns: List<StmtId>)
    /// `trait Name { fn sigs… }` — a nominal behavior contract.
    /// The sigs ride as BODYLESS fn declarations (body = a hole no
    /// pass walks), so declare and totality reuse fn machinery.
    @declares TraitDecl(name: Scoped, fns: List<StmtId>)
    /// `let name? = subject else { stmts }` — the bind-fresh form
    /// that KEEPS GOING: a present subject binds its carried value
    /// in the enclosing scope; an absent one runs the else, which
    /// must leave. Parsed by `let_stmt`; nullability gives it
    /// meaning.
    LetElse(name: Scoped, subject: ExprId, stmts: List<StmtId>)
    /// `for name in from..to` — binds `name` over the body. `cond`
    /// and `step` are parse-time desugar (`name < to`, `name + 1`):
    /// real nodes every pass walks, so the loop is mut+while in
    /// costume.
    For(name: Scoped, from: ExprId, to: ExprId, cond: ExprId, step: ExprId, stmts: List<StmtId>)
    /// `use a.b.{x, y}` — the path's segments (a `@pkg` head kept
    /// as written) and the items brought into scope.
    Use(path: List<string>, items: List<string>, aliases: List<string>)
    /// `for x in xs` — or `for i, x in xs`, the index beside the
    /// element, the loop's own counter with a name.
    ForEach(index: Scoped?, name: Scoped, subject: ExprId, stmts: List<StmtId>)
    /// `type Name = { field: ty, ... }` — a nominal record; the
    /// name lives in the TYPE namespace, program-wide like fns.
    StructDecl(name: Scoped, tparams: List<Plain>, fields: List<Param>)
    /// `type Name = <type>` — a DISTINCT type over a written shape,
    /// never an alias: the name counts at every seat and the shape
    /// answers every read. It travels AS its shape (a flat record
    /// of one anonymous field), so the name is free at runtime.
    NamedType(name: Scoped, tparams: List<Plain>, of: TypeRef)
    /// `enum Name { A B(payload: int) }` — a nominal closed set
    /// sharing the TYPE namespace with records. A variant is a
    /// Param: an ABSENT `ty` IS a unit variant.
    EnumDecl(name: Scoped, tparams: List<Plain>, variants: List<Variant>)
    /// `spec "name" { given "…" { then "…" { … } } }` — a test
    /// suite; each case is a declaration of its own.
    Spec(name: string, cases: List<Case>)
    /// `syntax sql { … }` — a sublanguage declared: the block word and
    /// the grammar notation, kept as text; the workspace readies it.
    SyntaxDecl(name: Scoped, text: string)
    /// `defer e` — the body runs when the enclosing scope ends or
    /// the fn exits early, last-registered first; `on_error` marks
    /// an `errdefer`, which runs only when the fn exits through its
    /// failure channel. The body is a lambda of no seats: captures
    /// are copied at the statement, the call happens at the exit.
    Defer(body: ExprId, on_error: bool)
    Error
}

/// The language AST's arenas plus their fingerprint side tables. A
/// synthesized node's span is null.
export type NodeStore = {
    exprs: Arena<Expr>,
    expr_fingerprints: List<int>,
    stmts: Arena<Stmt>,
    stmt_fingerprints: List<int>,
    exported: List<bool>,
    // `mut fn` — a method declaring that it writes its receiver
    mutating: List<bool>,
    onces: List<bool>,
    // the format a `grammar` declaration read, by its statement
    grammars: List<GrammarSpec?>,
    // `@name(args)` marks per statement, in written order
    annotations: List<List<Annotation>>,
    // declaration-leading `///` lines; absent on synthesized nodes
    docs: List<List<string>?>,
    // `static fn` — a fn under an impl declaring it has NO receiver
    statics: List<bool>,
    pats: List<Pat>,
    pat_spans: List<Span?>,
    pat_fingerprints: List<int>,
    // a lambda written as a TRAILING BLOCK (`f(a) { x -> … }`)
    trailing: List<bool>,
    // a call written as a TYPE LITERAL (`v.type(T)`), and a NAME
    // written inside one — a hole
    type_lits: List<bool>,
    holes: List<bool>,
    // each quote by the offset it starts at — how a template VALUE
    // names its node
    quotes_at: Map<string, int>,
    // the file's sublanguage blocks, in order, and each one's body
    // offset in the source; what their grammars refused; the node
    // runs their actions minted, with the library each names
    sublangs: List<ExprId>,
    body_starts: Map<string, int>,
    block_voices: List<BlockVoice>,
    foreign: List<ForeignRange>,
}

export fn new_node_store() -> NodeStore {
    NodeStore {
        exprs: new_arena(), expr_fingerprints: [],
        stmts: new_arena(), stmt_fingerprints: [], exported: [], mutating: [], onces: [], grammars: [], statics: [], annotations: [], docs: [],
        pats: [], pat_spans: [], pat_fingerprints: [], trailing: [], type_lits: [], holes: [], quotes_at: {}, sublangs: [], body_starts: {}, block_voices: [], foreign: [],
    }
}

impl NodeStore {
    /// The one expression-allocation seam.
    fn alloc_expr(e: Expr, span: Span?) -> ExprId {
        self.expr_fingerprints.push(self.fingerprint_expr(e))
        self.trailing.push(false)
        self.type_lits.push(false)
        self.holes.push(false)
        ExprId { index: self.exprs.add(e, span) }
    }

    /// A lambda written as a TRAILING BLOCK — the mark is part of the
    /// node: the block's refusals speak in the block's words.
    fn mark_trailing(e: ExprId) {
        self.trailing.set(e.index, true)
        self.expr_fingerprints.set(e.index, fp(111, [self.expr_fingerprints[e.index]]))
    }

    fn is_trailing(e: ExprId) -> bool {
        self.trailing[e.index]
    }

    /// A call written as a TYPE LITERAL — the mark is part of the
    /// node: a receiver that cannot answer refuses in the literal's words.
    fn mark_type_lit(e: ExprId) {
        self.type_lits.set(e.index, true)
        self.expr_fingerprints.set(e.index, fp(112, [self.expr_fingerprints[e.index]]))
    }

    fn is_type_lit(e: ExprId) -> bool {
        self.type_lits[e.index]
    }

    /// A name written inside a type literal — a HOLE, the id it
    /// names: a binding of the wrong type refuses as a hole.
    fn mark_hole(e: ExprId) {
        self.holes.set(e.index, true)
        self.expr_fingerprints.set(e.index, fp(113, [self.expr_fingerprints[e.index]]))
    }

    fn is_hole(e: ExprId) -> bool {
        self.holes[e.index]
    }

    /// Where a quote's runs of text start in the source, one per part.
    fn mark_quote_at(e: ExprId) {
        let sp: Span? = self.expr_span(e)
        if sp != null { self.quotes_at.set("${sp!.lo}", e.index) }
    }

    /// The quote starting at a source offset, when one does.
    fn quote_at(offset: int) -> ExprId? {
        let i: int? = self.quotes_at.get("${offset}")
        if i == null { return null }
        ExprId { index: i! }
    }

    /// A sublanguage block and where its body starts in the source.
    fn mark_sublang(e: ExprId, body_at: int) {
        self.sublangs.push(e)
        self.body_starts.set("${e.index}", body_at)
    }

    fn body_start(e: ExprId) -> int { self.body_starts.get("${e.index}") ?? 0 }

    fn speak_block(v: BlockVoice) { self.block_voices.push(v) }

    fn note_foreign(lo: int, hi: int, path: string) { self.foreign.push(ForeignRange { lo: lo, hi: hi, path: path }) }

    /// The block words the file's blocks wear.
    fn sublang_words() -> List<string> {
        [(self.expr(e)).sublang_of()?.word ?? "" for e in self.sublangs]
    }

    fn expansion_of(e: ExprId) -> ExprId? {
        match self.expr(e) {
            .Sublang(_, _, _, x) -> x,
            _ -> null,
        }
    }

    /// The hole a statement IS — a lone placeholder standing as a
    /// whole statement — by index, or null.
    fn hole_stmt(s: StmtId) -> int? {
        let v: ExprId? = match self.stmt(s) { .ExprStmt(v) -> v, _ -> null }
        if v == null { return null }
        let hole: HoleName? = hole_name(self.ident_name(v!) ?? "")
        if hole == null || !hole!.lone() { return null }
        hole!.holes[0]
    }

    /// Whether a statement DECLARES: a fn, a type, an enum, a trait,
    /// an impl, a top-level const.
    fn declares(s: StmtId) -> bool {
        self.declared_kind(s) != null || self.impl_parts(s) != null || self.const_value(s) != null
    }

    /// THE CALL PROTOCOL: the node with `blocks` appended to its
    /// arguments — a trailing block is a call's LAST argument, and a
    /// name or a field read with no parentheses is a call with none.
    /// Null for every shape that is not a call.
    fn called_with(e: ExprId, blocks: List<ExprId>) -> Expr? {
        match self.expr(e) {
            .Call(callee, pins, args) -> Expr.Call(callee, pins, args.concat(blocks)),
            .MethodCall(subject, name, args) -> Expr.MethodCall(subject, name, args.concat(blocks)),
            .CallValue(subject, args) -> Expr.CallValue(subject, args.concat(blocks)),
            .Ident(name) -> Expr.Call(name, [], blocks),
            .Prop(subject, name) -> Expr.MethodCall(subject, name, blocks),
            .IntLit(_) or .FloatLit(_) or .StrLit(_) or .BoolLit(_) or .NullLit or .Error or .Binary(_, _, _) or
            .Not(_) or .ListLit(_) or .MapLit(_, _) or .Interp(_, _) or .Quote(_, _, _, _) or .Sublang(_, _, _, _) or .If(_, _, _) or .Receiver or
            .When(_, _, _) or .Block(_, _) or .StructLit(_, _, _) or .Index(_, _) or
            .With(_, _, _) or .Match(_, _) or .Catch(_, _, _, _) or .MatchOpt(_, _, _, _) or
            .Chain(_, _) or .Coalesce(_, _) or .Force(_) or .Propagate(_) or
            .Lambda(_, _) or .Is(_, _) or .Comp(_, _, _, _, _, _) or .VariantLit(_, _) -> null,
        }
    }

    /// An argument the PRONOUN rides becomes an implicit one-param
    /// lambda — `xs.map(it * 2)` is `xs.map((it) -> it * 2)`, and the
    /// expected-type channel seats it like any other. The wrap is the
    /// pronoun's WHOLE mechanism: nothing downstream knows it exists.
    fn pronouned(a: ExprId) -> ExprId {
        if !self.pronoun_rides(a) { return a }
        self.alloc_expr(Expr.Lambda([pronoun_param], a), self.expr_span(a))
    }

    /// The value a tail statement answers with: an expression
    /// statement's expression, or an if-chain every branch of which
    /// answers — rebuilt as the if-expression over branch blocks, so
    /// a chain in tail position is a value wherever a block is.
    fn answer_of(s: StmtId) -> ExprId? {
        match self.stmt(s) {
            .ExprStmt(v) -> v,
            .Discard(_) -> null,
            .IfStmt(c, t, e) -> self.chain_value(s, c, t, e),
            .Let(_, _, _) or .MutLet(_, _, _) or .ConstDecl(_, _, _) or .Assign(_, _) or .Use(_, _, _) or .FnDecl(_, _, _, _, _) or .ExternFn(_, _, _) or
            .While(_, _) or .For(_, _, _, _, _, _) or .ForEach(_, _, _, _) or .Return(_) or .Fail(_) or
            .LetElse(_, _, _) or .StructDecl(_, _, _) or .NamedType(_, _, _) or .EnumDecl(_, _, _) or .ImplDecl(_, _, _) or
            .TraitDecl(_, _) or .SyntaxDecl(_, _) or .Spec(_, _) or .Defer(_, _) or .Error -> null,
        }
    }

    /// A chain answers when it has an else and both sides answer.
    fn chain_value(s: StmtId, c: ExprId, t: List<StmtId>, e: List<StmtId>) -> ExprId? {
        if e.is_empty() { return null }
        let tv: ExprId? = self.branch_value(t)
        let ev: ExprId? = self.branch_value(e)
        if tv == null || ev == null { return null }
        self.alloc_expr(Expr.If(c, tv!, ev!), self.stmt_span(s))
    }

    /// A branch's statements as its answer: the one expression when
    /// that is all the branch holds, else a block answering with its
    /// tail.
    fn branch_value(stmts: List<StmtId>) -> ExprId? {
        let held: StmtId? = stmts.last()
        if held == null { return null }
        let last = held!
        // a branch that LEAVES answers the fn's promise — a block
        // whose value is absent, as the block law reads it
        if self.diverges(last) { return self.alloc_expr(Expr.Block(stmts, null), self.stmt_span(last)) }
        let value: ExprId? = self.answer_of(last)
        if value == null { return null }
        if stmts.length == 1 { return value }
        self.alloc_expr(Expr.Block(stmts.slice(0, stmts.length - 1), value!), self.stmt_span(last))
    }

    /// The statements with a trailing if-chain that answers turned
    /// into the expression statement it is — the top level's tail
    /// law, the same as a block's.
    fn answered(stmts: List<StmtId>) -> List<StmtId> {
        let held: StmtId? = stmts.last()
        if held == null { return stmts }
        let last = held!
        let chained: bool = match self.stmt(last) {
            .IfStmt(_, _, e) -> !e.is_empty(),
            _ -> false,
        }
        if !chained { return stmts }
        let value: ExprId? = self.answer_of(last)
        if value == null { return stmts }
        stmts.slice(0, stmts.length - 1).concat([self.alloc_stmt(Stmt.ExprStmt(value!), self.stmt_span(last))])
    }

    /// The one pattern-allocation seam.
    fn alloc_pat(p: Pat, span: Span?) -> PatId {
        self.pat_fingerprints.push(self.fingerprint_pat(p))
        self.pat_spans.push(span)
        self.pats.push(p)
        PatId { index: self.pats.length - 1 }
    }

    fn pat(id: PatId) -> Pat { self.pats[id.index] }
    fn pat_span(id: PatId) -> Span? { self.pat_spans[id.index] }
    fn pat_fingerprint(id: PatId) -> int { self.pat_fingerprints[id.index] }

    /// The names a pattern binds, in pre-order — the arm's bind
    /// order, which every pass keys by index.
    /// A pattern's BINDERS in pre-order — the order that indexes
    /// `Binding.Pattern`. A format's holes bind under the format's own
    /// node: a hole is not a sub-pattern.
    fn pattern_binds(id: PatId) -> List<Binder> {
        match self.pat(id) {
            .Bind(name) -> [Binder { pat: id, name: name.of }],
            .Variant(_, args) -> flatten([self.pattern_binds(a) for a in args]),
            .Format(_, parts) -> [Binder { pat: id, name: n } for n in bound_names(parts)],
            .Wild or .Rest or .Lit(_) -> [],
        }
    }

    /// A binding pattern's name; absence for any other pattern.
    fn bind_name(id: PatId) -> string? {
        match self.pat(id) {
            .Bind(name) -> name.of,
            _ -> null,
        }
    }

    /// A pattern nothing can refuse: a hole or a name.
    fn irrefutable(id: PatId) -> bool {
        match self.pat(id) {
            .Wild or .Rest or .Bind(_) -> true,
            .Variant(_, _) or .Lit(_) or .Format(_, _) -> false,
        }
    }

    /// The pattern's fingerprint parts: its own shape, then its
    /// children's.
    fn fingerprint_pat(p: Pat) -> int {
        match p {
            .Wild -> fp(50, []),
            .Rest -> fp(51, []),
            .Bind(name) -> fp(52, [fp_str(name.of)]),
            .Variant(name, args) -> fp(53, [fp_str(name.of), fp_list([self.pat_fingerprint(a) for a in args])]),
            .Lit(v) -> fp(54, [self.expr_fingerprint(v)]),
            .Format(head, parts) -> fp(129, [fp_str(head), fp_list([hole_fp(p) for p in parts])]),
        }
    }

    /// An arm list's fingerprint parts — ONE HASH PER ARM, never a
    /// run of them. Flattening the patterns and the value into a
    /// single list loses the arm BOUNDARIES, so one arm taking three
    /// alternatives and two arms taking one each produce the same
    /// sequence and the same fingerprint. Two different programs,
    /// one identity, and the memo kernel cannot tell them apart.
    fn arm_fps(arms: List<Arm>) -> List<int> {
        [fp(29, [fp_list([self.pat_fingerprint(p) for p in a.pats]), self.expr_fingerprint(a.value)]) for a in arms]
    }

    /// The one statement-allocation seam.
    fn alloc_stmt(s: Stmt, span: Span?) -> StmtId {
        self.stmt_fingerprints.push(self.fingerprint_stmt(s))
        self.exported.push(false)
        self.mutating.push(false)
        self.onces.push(false)
        self.grammars.push(null)
        self.statics.push(false)
        self.annotations.push([])
        self.docs.push(null)
        StmtId { index: self.stmts.add(s, span) }
    }

    /// Store the declaration-leading documentation as part of the
    /// statement's identity: tools observe it, so a doc-only edit
    /// must not be cut off by the parsed-program memo. Lines never
    /// contain a newline, so the joined text is a lossless key.
    fn document(s: StmtId, lines: List<string>) {
        self.docs.set(s.index, lines)
        self.stmt_fingerprints.set(s.index, fp(115, [self.stmt_fingerprints[s.index], fp_str(lines.join("\n"))]))
    }

    fn doc_comment(s: StmtId) -> List<string>? {
        self.docs[s.index]
    }

    /// The statement whose span begins at or after `at`, earliest
    /// first — where a doc group's anchor lands.
    fn statement_after(at: int) -> StmtId? {
        // LICENSED I4: a min-by fold; the subset has no min_by
        mut best: StmtId? = null
        mut best_lo = 0
        for i in 0..self.stmts.count() {
            let s = StmtId { index: i }
            let span = self.stmt_span(s)
            if span != null {
                let lo = span!.lo
                if lo >= at && (best == null || lo < best_lo) {
                    best = s
                    best_lo = lo
                }
            }
        }
        best
    }

    /// `@name(args)` crossed this declaration: the call the compiler
    /// makes over it, recorded as a fact of the declaration — its
    /// callee an ident node, so every pass reads it as one.
    fn annotate(s: StmtId, a: Annotation) {
        mut held = self.annotations[s.index]
        held.push(a)
        self.annotations.set(s.index, held)
        self.stmt_fingerprints.set(s.index, fp(114, [self.stmt_fingerprints[s.index], self.expr_fingerprint(a.callee), fp_list(self.expr_fps(a.args))]))
    }

    fn annotations_of(s: StmtId) -> List<Annotation> {
        self.annotations[s.index]
    }

    /// `mut fn` crossed this declaration — it says its receiver is
    /// written; a trait sig's word is the contract.
    fn mark_mutating(s: StmtId) {
        self.mutating.set(s.index, true)
        self.restamp(s, 103)
    }

    fn is_mutating(s: StmtId) -> bool {
        self.mutating[s.index]
    }

    /// `once fn` crossed this declaration — its answer settles for
    /// the process.
    fn mark_once(s: StmtId) {
        self.onces.set(s.index, true)
        self.restamp(s, 104)
    }

    fn is_once(s: StmtId) -> bool {
        self.onces[s.index]
    }

    /// `static fn` crossed this declaration — it lives under an impl
    /// and takes NO receiver, which is the third value of the same
    /// word `fn` and `mut fn` are the first two of.
    fn mark_static(s: StmtId) {
        self.statics.set(s.index, true)
        self.restamp(s, 110)
    }

    fn is_static(s: StmtId) -> bool {
        self.statics[s.index]
    }

    /// `grammar Name = "…"` declared this record — the format it
    /// reads, which the record's fields cannot spell. The mark's code
    /// is 113 and the format is its PAYLOAD: the head, then the holes
    /// folded to one value.
    fn mark_grammar(s: StmtId, read: GrammarSpec) {
        self.grammars.set(s.index, read)
        self.restamp_carrying(s, 113, [fp_str(read.head), fp_list([hole_fp(p) for p in read.parts])])
    }

    fn grammar_of(s: StmtId) -> GrammarSpec? {
        self.grammars[s.index]
    }

    /// A MARK IS PART OF THE STATEMENT: `fn f()`, `mut fn f()`,
    /// `once fn f()`, `static fn f()` and `export fn f()` declare
    /// different things, so no two of them may wear one fingerprint.
    fn restamp(s: StmtId, tag: int) {
        self.restamp_carrying(s, tag, [])
    }

    /// The tag is the mark's reserved CODE and nothing else; a mark
    /// that CARRIES something folds what it carries to ONE value, so
    /// the codes stay a registry and no run's boundary can move.
    fn restamp_carrying(s: StmtId, tag: int, carried: List<int>) {
        self.stmt_fingerprints.set(s.index, fp(tag, [self.stmt_fingerprints[s.index], fp_list(carried)]))
    }

    /// `export` crossed this declaration — the module's surface
    /// carries it, so it is part of the statement like every other
    /// mark.
    fn mark_exported(s: StmtId) {
        self.exported.set(s.index, true)
        self.restamp(s, 127)
    }

    fn is_exported(s: StmtId) -> bool {
        self.exported[s.index]
    }

    /// A `use` statement's parts, when the statement is one.
    fn use_parts(s: StmtId) -> UseParts? {
        match self.stmt(s) {
            .Use(path, items, aliases) -> UseParts { path: path, items: items, aliases: aliases, stmt: s },
            _ -> null,
        }
    }

    fn expr(id: ExprId) -> Expr { self.exprs.node_at(id.index) }
    fn stmt(id: StmtId) -> Stmt { self.stmts.node_at(id.index) }
    fn expr_span(id: ExprId) -> Span? { self.exprs.span_at(id.index) }
    fn stmt_span(id: StmtId) -> Span? { self.stmts.span_at(id.index) }
    fn expr_fingerprint(id: ExprId) -> int { self.expr_fingerprints[id.index] }
    fn stmt_fingerprint(id: StmtId) -> int { self.stmt_fingerprints[id.index] }

    /// The span containing both expressions, when both are known.
    fn cover(a: ExprId, b: ExprId) -> Span? {
        let sa = self.expr_span(a)
        let sb = self.expr_span(b)
        if sa == null || sb == null { return null }
        sa!.cover(sb!)
    }

    /// A PLACE's last step, when the expression is one: a bare name,
    /// a field of a subject, or an index into one. The one
    /// projection for the place category — every other shape is a
    /// value, not a place.
    fn place_step(e: ExprId) -> PlaceStep? {
        match self.expr(e) {
            .Ident(name) -> PlaceStep.Root(name),
            .Receiver -> PlaceStep.Root("self"),
            .Prop(subject, name) -> PlaceStep.Field(subject, name),
            .Index(subject, index) -> PlaceStep.At(subject, index),
            .IntLit(_) or .FloatLit(_) or .StrLit(_) or .BoolLit(_) or .NullLit or .Error or .Binary(_, _, _) or
            .Not(_) or .ListLit(_) or .MapLit(_, _) or .Interp(_, _) or .Quote(_, _, _, _) or .Sublang(_, _, _, _) or .If(_, _, _) or .Call(_, _, _) or
            .CallValue(_, _) or .When(_, _, _) or .Block(_, _) or .StructLit(_, _, _) or
            .With(_, _, _) or .Match(_, _) or .Catch(_, _, _, _) or .MatchOpt(_, _, _, _) or
            .Chain(_, _) or .Coalesce(_, _) or .Force(_) or .Propagate(_) or .MethodCall(_, _, _) or
            .Lambda(_, _) or .Is(_, _) or .Comp(_, _, _, _, _, _) or .VariantLit(_, _) -> null,
        }
    }

    /// The binding a place is rooted in — the name at the bottom of
    /// its path; null when the expression is not a place.
    fn place_root(e: ExprId) -> ExprId? {
        let step: PlaceStep? = self.place_step(e)
        if step == null { return null }
        match step! {
            .Root(_) -> e,
            .Field(subject, _) -> self.place_root(subject),
            .At(subject, _) -> self.place_root(subject),
        }
    }

    /// The INDEX name a pairing loop binds — null for every other
    /// statement, and for a loop that names only its element.
    fn loop_index(s: StmtId) -> string? {
        match self.stmt(s) {
            .ForEach(index, _, _, _) -> index?.of,
            _ -> null,
        }
    }

    /// A bare name's text; null for every other expression.
    fn ident_name(e: ExprId) -> string? {
        match self.expr(e) {
            .Ident(name) -> name.of,
            _ -> null,
        }
    }

    /// Does the PRONOUN ride this subtree unbound? `it` belongs to
    /// the nearest enclosing METHOD call or trailing block, so six
    /// nodes answer for themselves and every other asks the children
    /// the walk already names: a bare name IS the pronoun; a lambda
    /// binds its own scope; a method call and a call by name started
    /// fresh scopes for their arguments at their own build; and a
    /// template's body belongs to the code it generates, so only its
    /// holes are read here.
    fn pronoun_rides(id: ExprId) -> bool {
        match self.expr(id) {
            .Ident(name) -> name == "it",
            .Lambda(_, _) -> false,
            .MethodCall(subject, _, _) -> self.pronoun_rides(subject),
            .Call(callee, _, args) -> callee == "it" || self.any_rides(args),
            .Quote(_, _, _, holes) -> self.any_rides(holes),
            .Sublang(_, _, holes, _) -> self.any_rides(holes),
            rest -> self.any_rides(self.expr_children(id)),
        }
    }

    fn any_rides(ids: List<ExprId>) -> bool {
        ids.any((k) -> self.pronoun_rides(k))
    }

    /// Content identity: a stable variant tag folded with payloads
    /// and child fingerprints, in order. Spans never participate.
    /// Tags are never reused; `make fingerprints` names the next.
    ///
    /// A PARTS LIST IS FIXED ARITY. Every variable-length run folds
    /// through `fp_list` first, so no payload's boundary can move and
    /// two shapes cannot splice to one sequence. The greppable form of
    /// the law: no `.concat` and no comprehension stands in a parts
    /// list except inside `fp_list`.
    // ── THE COMPLETE WALK ───────────────────────────────────────────
    // `post_order` (features/dispatch.av) walks `kids`, and a feature
    // HIDES the children it types under its own narrowing — an `if`'s
    // branches, a `match`'s arms, a `catch`'s, a nullable's, a lambda's
    // body — and a block's statements are not expressions at all. THE
    // HIDDEN-BRANCH LAW: a question about EVERY expression a body holds
    // (does it read a run-time parameter; which kinds does it spell)
    // walks here, where every variant names all its children and a
    // statement its expressions — a registry, like the fingerprints.
    // IT IS ALSO THE ONE PLACE THE FACT LIVES: a second walk states
    // only where it DIFFERS and delegates the rest here, so no two
    // registries can disagree about which payloads are children.

    /// Every expression at and under `root`, children before owners,
    /// hidden branches and statement bodies included.
    fn every_expr(root: ExprId) -> List<ExprId> {
        flatten([self.every_expr(k) for k in self.expr_children(root)]).concat([root])
    }

    fn stmts_exprs(ids: List<StmtId>) -> List<ExprId> {
        flatten([self.stmt_children(s) for s in ids])
    }

    /// AN OPTIONAL EXPRESSION IS ONE VALUE, absence included — a
    /// block that leaves instead of answering, a comprehension with
    /// no guard, a field with no default. Fixed arity, so it stands
    /// in a parts list directly, as `type_fp` does for a type.
    fn opt_fp(value: ExprId?) -> int {
        if value == null { return 0 }
        fp(128, [self.expr_fingerprint(value!)])
    }

    /// The fingerprints of expression children, in order.
    fn expr_fps(ids: List<ExprId>) -> List<int> {
        [self.expr_fingerprint(k) for k in ids]
    }

    /// The fingerprints of statement children, in order.
    fn stmt_fps(ids: List<StmtId>) -> List<int> {
        [self.stmt_fingerprint(k) for k in ids]
    }

}

impl NodeStore {
    /// A case list's fingerprint parts — one value per case.
    fn case_fps(cases: List<Case>) -> List<int> {
        [fp(125, [fp_str(c.group), fp_str(c.name), self.expr_fingerprint(c.body)]) for c in cases]
    }

    /// A param list's fingerprint parts — ONE VALUE PER SEAT. A seat
    /// IS its name, its written type, its contract and the default it
    /// declares: `{ a: int = 1, b: int }` and `{ a: int, b: int = 1 }`
    /// are different records, and a defaults list beside the fields
    /// says which defaults exist without saying whose they are.
    fn param_fps(params: List<Param>) -> List<int> {
        [fp(123, [fp_str(p.name.of), type_fp(p.ty), mark_fp(p.promises), self.opt_fp(p.default), fp_list(mark_fps(p.marks))]) for p in params]
    }

    /// A variant list's fingerprint parts — ONE VALUE PER VARIANT.
    /// Spliced flat, a variant's payload run and the next variant's
    /// name share a boundary that moves.
    fn variant_fps(variants: List<Variant>) -> List<int> {
        [fp(124, [fp_str(v.name.of), fp_list(self.param_fps(v.payloads)), fp_list(mark_fps(v.marks))]) for v in variants]
    }
}

/// A mark list's fingerprint parts — ONE VALUE PER MARK, its
/// arguments folded to one of their own. `@a(x)` and `@a @x` are
/// different declarations, and a flat splice would give them one
/// identity.
fn mark_fps(marks: List<Mark>) -> List<int> {
    [fp(131, [fp_str(m.name), fp_list(str_fps(m.args))]) for m in marks]
}

/// A string list's fingerprint parts, in order.
fn str_fps(texts: List<string>) -> List<int> {
    [fp_str(t) for t in texts]
}

// A run of NAMES fingerprinted. One per name kind, and the bodies
// agree because the difference is the SEAT: a name is opaque there,
// so a `List<Plain>` and a `List<Scoped>` are two types and a fold
// over one is not a fold over the other. Spelling the unwrap at each
// call site instead would build a second list per node.

fn plain_fps(names: List<Plain>) -> List<int> {
    [fp_str(n.of) for n in names]
}

fn scoped_fps(names: List<Scoped>) -> List<int> {
    [fp_str(n.of) for n in names]
}

/// A bool as a fingerprint part.
fn flagged(b: bool) -> int {
    if b { 1 } else { 0 }
}

/// A format part's identity: what it binds, what it parses through,
/// and the literal that follows it — every field, so a reindented
/// or retyped hole is a different pattern.
/// One hole folded to ONE value, so a run of holes has no boundary
/// that can move whatever a hole comes to carry — the pattern and
/// the grammar mark fold each hole through this one door.
fn hole_fp(p: FormatPart) -> int { fp(130, hole_fps(p)) }

fn hole_fps(p: FormatPart) -> List<int> {
    [fp_str(p.hole.name), type_fp(p.hole.ty), fp_str(p.piece), greed_fp(p.hole.greedy)]
}

/// Greed rides the fingerprint: two formats that differ only in which
/// occurrence a hole takes are different formats, and a fold that
/// dropped it would hand them one hash.
fn greed_fp(greedy: bool) -> int { if greedy { 1 } else { 0 } }

/// A SEAT'S CONTRACT IS PART OF WHAT THE SEAT IS: `fn(mut Cx)` is a
/// different type from `fn(Cx)`, and `const x` a different seat from
/// `x`, so the marks ride the identity as the interner's key already
/// says they ride the type.
fn mark_fp(m: SeatMark) -> int {
    fp(126, [flagged(m.mutable), flagged(m.settled)])
}

/// A written type's identity: absence is its own value, and the `?`,
/// the `dyn`, the arrow and the seats' marks are all part of what the
/// type IS — a fingerprint that forgets one of them certifies a
/// changed program as unchanged.
fn type_fp(t: TypeRef?) -> int {
    if t == null { return 0 }
    let written = t!
    fp(if written.optional { 101 } else { 100 },
       [fp_str(written.name), flagged(written.dynamic), flagged(written.arrow),
        fp_list([mark_fp(m) for m in written.marks]),
        fp_list([type_fp(a) for a in written.args])])
}

fn fp_binop(op: BinOp) -> int {
    match op {
        .Add -> 1,
        .Sub -> 2,
        .Eq -> 3,
        .Lt -> 4,
        .Mul -> 5,
        .Div -> 6,
        .Mod -> 7,
        .Ne -> 8,
        .Le -> 9,
        .Gt -> 10,
        .Ge -> 11,
        .And -> 12,
        .Or -> 13,
        .BitAnd -> 14,
        .BitOr -> 15,
        .BitXor -> 16,
        .Shl -> 17,
        .Shr -> 18,
    }
}

