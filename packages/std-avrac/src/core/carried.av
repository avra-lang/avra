//! The records a rule's capture carries as DATA — no pass walks one, so it
//! needs no id and no arena beyond its own parts. One variant per record
//! type, so a capture list is `List<Carried>` and each typed read is one
//! projection of it.

/// A record built by a rule, riding a capture.
export enum Carried {
    Mark(mark: Mark)
    Param(param: Param)
    Variant(variant: Variant)
    UseItem(item: UseItem)
    FieldPat(field: FieldPat)
    ProjField(field: ProjField)
    OrderKey(key: OrderKey)
    Given(group: Given)
    FnSeat(seat: FnSeat)
    CatchArm(arm: CatchArm)
    Arm(arm: Arm)
    CompClause(clause: CompClause)
    MapEntry(entry: MapEntry)
    Case(case: Case)
}

impl Carried {
    fn mark() -> Mark? { match self { .Mark(r) -> r, _ -> null } }
    fn param() -> Param? { match self { .Param(r) -> r, _ -> null } }
    fn variant() -> Variant? { match self { .Variant(r) -> r, _ -> null } }
    fn use_item() -> UseItem? { match self { .UseItem(r) -> r, _ -> null } }
    fn field_pat() -> FieldPat? { match self { .FieldPat(r) -> r, _ -> null } }
    fn proj_field() -> ProjField? { match self { .ProjField(r) -> r, _ -> null } }
    fn order_key() -> OrderKey? { match self { .OrderKey(r) -> r, _ -> null } }
    fn given() -> Given? { match self { .Given(r) -> r, _ -> null } }
    fn fn_seat() -> FnSeat? { match self { .FnSeat(r) -> r, _ -> null } }
    fn catch_arm() -> CatchArm? { match self { .CatchArm(r) -> r, _ -> null } }
    fn arm() -> Arm? { match self { .Arm(r) -> r, _ -> null } }
    fn comp_clause() -> CompClause? { match self { .CompClause(r) -> r, _ -> null } }
    fn map_entry() -> MapEntry? { match self { .MapEntry(r) -> r, _ -> null } }
    fn case() -> Case? { match self { .Case(r) -> r, _ -> null } }
}
