        },
        RtSig {
            name: "avra_spawn_status",
            ret: RtKind.I64,
            params: [RtKind.Ptr, RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.SpawnStatus,
            reach: Reach.World,
            boxes: [Box.Text, Box.List],
        },
        RtSig {
            name: "avra_spawn_in",
            ret: RtKind.I64,
            params: [RtKind.Ptr, RtKind.Ptr, RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.SpawnIn,
            reach: Reach.World,
            boxes: [Box.Text, Box.Text, Box.List],
        },
    ]
    sigs
}

/// The runtime kind a type rides in a call across the host seam:
/// scalars are words, every pointer shape a pointer, void nothing.
export fn rt_kind_of(types: TypeRegistry, ty: TypeId) -> RtKind {
    if types.shape_of(ty) is .Void { return RtKind.Void }
    // A DOUBLE IS NOT A WORD. It travels in its own register file, so
    // a float falling through to `I64` puts it in an integer seat and
    // the callee reads a different number — the same silent class the
    // integer widths closed, one register file over.
    if types.shape_of(ty) is .Float { return RtKind.F64 }
    if types.rides_pointer(ty) { return RtKind.Ptr }
    RtKind.I64
}

/// One width word and the kind it names.
export type WidthRow = { word: string, kind: RtKind, carries: string }

/// THE WIDTH WORDS an extern seat may name. Read both ways — a
/// declaration asks word -> kind, a refusal reads the words back —
/// so the roster is data, not a match. `"f64"` and `"f32"` join it
/// the day a float VALUE exists: two rows here and two `ll_rt_kind`
/// arms are the whole edit.
const width_rows: List<WidthRow> = table<WidthRow> {
    word  | kind       | carries
    "i32" | RtKind.I32 | "int"
    "u32" | RtKind.U32 | "int"
    "i64" | RtKind.I64 | "int"
    "f64" | RtKind.F64 | "float"
}

/// The kind a width word names, or absence for every other name.
export fn width_named(name: string) -> RtKind? {
    width_rows.find(it.word == name)?.kind
}

/// The width words, spelled for a refusal.
export const width_words: string = joined(["`${w.word}`" for w in width_rows], ", ")

/// The annotation a seat DECLARES, with a width word read as the
/// `int` that actually crosses. A WIDTH IS A PROPERTY OF A SEAT,
/// NOT OF A VALUE: the width rides the extern's ROW alone, and the
/// type the seat names is Avra's one integer. Every other
/// annotation passes through untouched, which is what keeps a width
/// word a type nowhere else — `let x: i32 = 5` stays a refusal.
export fn widthless(t: TypeRef?) -> TypeRef? {
    if t == null { return null }
    let written = t!
    let row? = width_rows.find(it.word == written.name) else { return written }
    written with { name: row.carries }
}

/// A seat's runtime kind: the WIDTH its annotation named, else the
/// kind its type rides. The fallback IS the whole standing law —
/// an extern seat with no width is a word or a pointer, as before.
export fn extern_kind(types: TypeRegistry, written: TypeRef?, ty: TypeId) -> RtKind {
    if written == null { return rt_kind_of(types, ty) }
    width_named(written!.name) ?? rt_kind_of(types, ty)
}

/// The same, from the WIDTH NAME alone — what a declaration fact carries. "" is the
/// unwritten seat, whose kind rides its type.
export fn extern_kind_name(types: TypeRegistry, named: string, ty: TypeId) -> RtKind {
    if named == "" { return rt_kind_of(types, ty) }
    width_named(named) ?? rt_kind_of(types, ty)
}

/// An extern fn's row — borrowed answers, no twin, hosted by the
/// backend alone.
export fn extern_row(name: string, ret: RtKind, params: List<RtKind>) -> RtSig {
    RtSig {
        name: name,
        ret: ret,
        params: params,
        owns_result: false,
        has_owned_twin: false,
        host: RtHost.Unhosted,
    }
}

/// An extern row whose `mut` seats carry cells — `cells[j]` the
/// width behind seat `j`, `Void` where the seat is not an inout.
export fn inout_row(name: string, ret: RtKind, params: List<RtKind>, cells: List<RtKind>) -> RtSig {
    RtSig {
        name: name,
        ret: ret,
        params: params,
        owns_result: false,
        has_owned_twin: false,
        host: RtHost.Unhosted,
        cells: cells,
    }
}

/// The callee's contract, when the registry knows it — through the
/// index, so an ask is a lookup and never a rebuild.
export fn rt_sig_of(name: string) -> RtSig? {
    rt_index().get(name)
}

/// The registry keyed by name — ONCE per process: the rows are the
/// same rows every time, and the memory pass, the backend and the
/// evaluator all ask per instruction.
export once fn rt_index() -> Map<string, RtSig> {
    mut index: Map<string, RtSig> = {}
    for s in rt_sigs() { index.set(s.name, s) }
    index
}

/// True when the row may switch the calling task out — a cancel point.
export fn rt_waits(name: string) -> bool {
    let sig: RtSig? = rt_index().get(name)
    sig != null && sig!.waits
}

/// True when the subject STILL HOLDS what the callee answered, so
/// the answer may be BORROWED rather than taken through the owned
/// twin. False for every row that hands its answer over.
export fn rt_lends(name: string) -> bool {
    let sig: RtSig? = rt_index().get(name)
    sig != null && sig!.lends
}

/// True when the row TAKES ITS OWN REFERENCE to seat `j` — the
/// `_owned` twins, and `avra_once_set` on both. A row that does not
/// keep a seat BORROWS it, which is the Avra call's opposite.
export fn rt_keeps(name: string, j: int) -> bool {
    let sig: RtSig? = rt_index().get(name)
    sig != null && j < sig!.keeps.length && sig!.keeps[j]
}

/// True when the row CHANGES seat `j`'s OWN CONTENTS — a push, a set,
/// a release, an in-place reusing transform. A borrow taken from that
/// seat before the call cannot be trusted to stand after it. A row
/// nobody has named here answers false, the safe default for a row
/// that only reads.
export fn rt_writes(name: string, j: int) -> bool {
    let sig: RtSig? = rt_index().get(name)
    sig != null && j < sig!.writes.length && sig!.writes[j]
}

/// True when an OWNED answer may be the SAME box as seat 0 rather
/// than a fresh one — `avra_box_thawed`'s fast path. A row nobody has
/// marked here answers false, on the SAME side as `owns_result`
/// stopping a root trace: an ordinary allocator's answer never
/// aliases its argument, so the trace is right not to continue.
export fn rt_aliases_arg0(name: string) -> bool {
    let sig: RtSig? = rt_index().get(name)
    sig != null && sig!.aliases_arg0
}

/// True when the callee's result is a FRESH allocation the memory
/// pass must release.
export fn rt_owns(name: string) -> bool {
    rt_sig_of(name)?.owns_result ?? false
}

/// The callee's owned twin — `<name>_owned` — when the row says
/// one exists.
export fn rt_owned_twin(name: string) -> string? {
    let sig: RtSig? = rt_sig_of(name)
    if sig == null || !sig!.has_owned_twin { return null }
    "${name}_owned"
}

/// The callee's MOVING twin — `<name>_moved` — when the row says one
/// exists: the owned twin's store, the caller's own reference handed
/// over instead of a retain.
export fn rt_moving_twin(name: string) -> string? {
    let sig: RtSig? = rt_sig_of(name)
    if sig == null || !sig!.has_moving_twin { return null }
    "${name}_moved"
}

/// The callee's REUSING twin — `<name>_reusing` — when the row says one
/// exists: the same answer, its first seat CONSUMED, so a box that seat
/// holds alone is written in place.
export fn rt_reusing_twin(name: string) -> string? {
    let sig: RtSig? = rt_sig_of(name)
    if sig == null || !sig!.has_reusing_twin { return null }
    "${name}_reusing"
}
