//! THE runtime surface, as data — one table, five consumers: the
//! backend DECLARES from it, COERCES arguments by it, the memory
//! pass derives OWNERSHIP from it (the owned twin is a column), the
//! lowering REFUSES a callee it does not know, and the interpreter
//! HOSTS every row by its host column. The twins: runtime/
//! avra_runtime.c natively, the host arm in the interpreter — a new
//! runtime fn is a row plus both bodies, nothing else.
use core.{RtKind, RtSig, RtHost, Reach, Takes, TypeRegistry, TypeId, TypeRef, joined, Box}

export once fn rt_sigs() -> List<RtSig> {
    let sigs: List<RtSig> = [
        // A trace line: written to stderr under AVRA_QTRACE, read by no answer.
        RtSig {
            name: "avra_qtrace",
            ret: RtKind.Void,
            params: [RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.Unhosted,
            reach: Reach.Pure,
            boxes: [Box.Text],
        },
        RtSig {
            name: "avra_puts",
            ret: RtKind.Void,
            params: [RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.Puts,
            reach: Reach.World,
            inert: true,
            boxes: [Box.Text],
        },
        // A program's own trap, in its words: exits 2, never returns.
        RtSig {
            name: "avra_trap",
            ret: RtKind.Void,
            params: [RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.Unhosted,
            inert: true,
            boxes: [Box.Text],
        },
        RtSig {
            name: "avra_streq",
            ret: RtKind.I64,
            params: [RtKind.Ptr, RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.Streq,
            inert: true,
            boxes: [Box.Text, Box.Text],
        },
        RtSig {
            name: "avra_rc_release",
            ret: RtKind.Void,
            params: [RtKind.Ptr],
            writes: [true],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.Unhosted,
            inert: true,
        },
        RtSig {
            name: "avra_rc_retain",
            ret: RtKind.Void,
            params: [RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.Unhosted,
            inert: true,
        },
        RtSig {
            name: "avra_array_new",
            ret: RtKind.Ptr,
            params: [],
            answer: Box.List,
            owns_result: true,
            has_owned_twin: false,
            host: RtHost.ArrayNew,
            inert: true,
        },
        RtSig {
            name: "avra_array_sized",
            ret: RtKind.Ptr,
            params: [RtKind.I64],
            answer: Box.List,
            owns_result: true,
            has_owned_twin: false,
            host: RtHost.ArrayNew,
            inert: true,
        },
        RtSig {
            name: "avra_array_push",
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.I64],
            writes: [true, false],
            owns_result: false,
            has_owned_twin: true,
            host: RtHost.ArrayPush,
            inert: true,
            boxes: [Box.List],
            has_moving_twin: true,
        },
        RtSig {
            name: "avra_array_push_owned",
            takes: Takes.Always(1),
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.Ptr],
            writes: [true, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.ArrayPush,
            keeps: [false, true],
            inert: true,
            boxes: [Box.List],
        },
        RtSig {
            name: "avra_array_push_moved",
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.Ptr],
            writes: [true, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.ArrayPush,
            keeps: [false, true],
            inert: true,
            boxes: [Box.List],
        },
        RtSig {
            name: "avra_array_get",
            ret: RtKind.I64,
            params: [RtKind.Ptr, RtKind.I64],
            owns_result: false,
            has_owned_twin: true,
            host: RtHost.ArrayGet,
            lends: true,
            inert: true,
            boxes: [Box.List],
        },
        RtSig {
            name: "avra_array_get_owned",
            stood: true,
            ret: RtKind.Ptr,
            params: [RtKind.Ptr, RtKind.I64],
            owns_result: true,
            has_owned_twin: false,
            host: RtHost.ArrayGet,
            inert: true,
            boxes: [Box.List],
        },
        // A SLOT THE READER'S TYPE PROVES: a declared field of a boxed
        // record, a cell's one slot. The shape guarantees the slot, so
        // the native read is a load with no bounds test; the evaluator
        // keeps `avra_array_get`'s, which is how a row written short
        // across a generation still refuses.
        RtSig {
            name: "avra_slot_get",
            ret: RtKind.I64,
            params: [RtKind.Ptr, RtKind.I64],
            owns_result: false,
            has_owned_twin: true,
            host: RtHost.ArrayGet,
            lends: true,
            inert: true,
            boxes: [Box.List],
        },
        RtSig {
            name: "avra_slot_get_owned",
            stood: true,
            ret: RtKind.Ptr,
            params: [RtKind.Ptr, RtKind.I64],
            owns_result: true,
            has_owned_twin: false,
            host: RtHost.ArrayGet,
            inert: true,
            boxes: [Box.List],
        },
        RtSig {
            name: "avra_cell_release",
            ret: RtKind.Void,
            params: [RtKind.Ptr],
            writes: [true],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.CellRelease,
            inert: true,
        },
        RtSig {
            name: "avra_cell_unique",
            ret: RtKind.Ptr,
            params: [RtKind.Ptr],
            writes: [true],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.CellUnique,
            inert: true,
        },
        RtSig {
            name: "avra_cell_thawed",
            ret: RtKind.Ptr,
            params: [RtKind.Ptr],
            writes: [true],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.CellThawed,
            inert: true,
        },
        RtSig {
            name: "avra_box_thawed",
            ret: RtKind.Ptr,
            params: [RtKind.Ptr],
            owns_result: true,
            has_owned_twin: false,
            host: RtHost.BoxThawed,
            inert: true,
            aliases_arg0: true,
        },
        RtSig {
            name: "avra_enum_boxed",
            takes: Takes.Counted(1, 0, 2),
            ret: RtKind.Ptr,
            params: [RtKind.I64, RtKind.I64, RtKind.I64],
            answer: Box.List,
            owns_result: true,
            has_owned_twin: false,
            host: RtHost.EnumBoxed,
            inert: true,
        },
        RtSig {
            name: "avra_array_push_tagged",
            takes: Takes.Counted(1, 2, 3),
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.I64, RtKind.I64, RtKind.I64],
            writes: [true, false, false, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.ArrayPush,
            inert: true,
            boxes: [Box.List],
        },
        RtSig {
            name: "avra_slot_set_tagged",
            takes: Takes.Counted(2, 3, 4),
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.I64, RtKind.I64, RtKind.I64, RtKind.I64],
            writes: [true, false, false, false, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.SlotSet,
            inert: true,
        },
        RtSig {
            name: "avra_enum_tag",
            ret: RtKind.I64,
            params: [RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.EnumTag,
            inert: true,
            boxes: [Box.List],
        },
        RtSig {
            name: "avra_enum_word",
            ret: RtKind.I64,
            params: [RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.EnumWord,
            lends: true,
            inert: true,
            boxes: [Box.List],
        },
        RtSig {
            name: "avra_rc_retain_tagged",
            ret: RtKind.Void,
            params: [RtKind.I64, RtKind.I64, RtKind.I64],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.Unhosted,
            inert: true,
        },
        RtSig {
            name: "avra_rc_release_tagged",
            ret: RtKind.Void,
            params: [RtKind.I64, RtKind.I64, RtKind.I64],
            writes: [true, false, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.Unhosted,
            inert: true,
        },
        RtSig {
            name: "avra_cell_forget",
            ret: RtKind.Void,
            params: [RtKind.Ptr],
            writes: [true],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.CellForget,
            inert: true,
        },
        RtSig {
            name: "avra_map_new",
            ret: RtKind.Ptr,
            params: [],
            answer: Box.Map,
            owns_result: true,
            has_owned_twin: false,
            host: RtHost.MapNew,
            inert: true,
        },
        RtSig {
            name: "avra_map_len",
            ret: RtKind.I64,
            params: [RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.MapLen,
            inert: true,
            boxes: [Box.Map],
        },
        RtSig {
            name: "avra_map_has",
            ret: RtKind.I64,
            params: [RtKind.Ptr, RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.MapHas,
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        RtSig {
            name: "avra_map_get",
            ret: RtKind.I64,
            params: [RtKind.Ptr, RtKind.Ptr],
            owns_result: false,
            has_owned_twin: true,
            host: RtHost.MapGet,
            lends: true,
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        RtSig {
            name: "avra_map_get_owned",
            stood: true,
            ret: RtKind.Ptr,
            params: [RtKind.Ptr, RtKind.Ptr],
            owns_result: true,
            has_owned_twin: false,
            host: RtHost.MapGet,
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        RtSig {
            name: "avra_map_set",
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.Ptr, RtKind.I64],
            writes: [true, false, false],
            owns_result: false,
            has_owned_twin: true,
            host: RtHost.MapSet,
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        RtSig {
            name: "avra_map_set_owned",
            takes: Takes.Always(2),
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.Ptr, RtKind.Ptr],
            writes: [true, false, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.MapSet,
            keeps: [false, false, true],
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        RtSig {
            name: "avra_map_set_maybe",
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.Ptr, RtKind.I64, RtKind.I64],
            writes: [true, false, false, false],
            owns_result: false,
            has_owned_twin: true,
            host: RtHost.MapSetMaybe,
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        RtSig {
            name: "avra_map_set_maybe_owned",
            takes: Takes.Present(3, 2),
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.Ptr, RtKind.I64, RtKind.Ptr],
            writes: [true, false, false, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.MapSetMaybe,
            keeps: [false, false, false, true],
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        // The set family under a token — `avra_map_slot`'s word for the
        // same key, so the write walks no index.
        RtSig {
            name: "avra_map_set_at",
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.Ptr, RtKind.I64, RtKind.I64],
            writes: [true, false, false, false],
            owns_result: false,
            has_owned_twin: true,
            host: RtHost.MapSetAt,
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        RtSig {
            name: "avra_map_set_at_owned",
            takes: Takes.Always(3),
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.Ptr, RtKind.I64, RtKind.Ptr],
            writes: [true, false, false, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.MapSetAt,
            keeps: [false, false, false, true],
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        RtSig {
            name: "avra_map_set_at_maybe",
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.Ptr, RtKind.I64, RtKind.I64, RtKind.I64],
            writes: [true, false, false, false, false],
            owns_result: false,
            has_owned_twin: true,
            host: RtHost.MapSetAtMaybe,
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        RtSig {
            name: "avra_map_set_at_maybe_owned",
            takes: Takes.Present(4, 3),
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.Ptr, RtKind.I64, RtKind.I64, RtKind.Ptr],
            writes: [true, false, false, false, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.MapSetAtMaybe,
            keeps: [false, false, false, false, true],
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        RtSig {
            name: "avra_map_value_present",
            ret: RtKind.I64,
            params: [RtKind.Ptr, RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.MapValuePresent,
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        // A KEY'S ONE PROBE: the slot it names, or -1 — then the value
        // and its presence read that slot, so `get` hashes once.
        RtSig {
            name: "avra_map_slot",
            ret: RtKind.I64,
            params: [RtKind.Ptr, RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.MapSlot,
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        RtSig {
            name: "avra_map_value_at",
            ret: RtKind.I64,
            params: [RtKind.Ptr, RtKind.I64],
            owns_result: false,
            has_owned_twin: true,
            host: RtHost.MapValueAt,
            lends: true,
            inert: true,
            boxes: [Box.Map],
        },
        RtSig {
            name: "avra_map_value_at_owned",
            stood: true,
            ret: RtKind.Ptr,
            params: [RtKind.Ptr, RtKind.I64],
            owns_result: true,
            has_owned_twin: false,
            host: RtHost.MapValueAt,
            inert: true,
            boxes: [Box.Map],
        },
        RtSig {
            name: "avra_map_present_at",
            ret: RtKind.I64,
            params: [RtKind.Ptr, RtKind.I64],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.MapPresentAt,
            inert: true,
            boxes: [Box.Map],
        },
        // A map's ORDER IS A PROPERTY OF THE VALUE: its keys and its
        // values each read back as a fresh list in insertion order.
        RtSig {
            name: "avra_map_keys",
            ret: RtKind.Ptr,
            params: [RtKind.Ptr],
            owns_result: true,
            has_owned_twin: false,
            host: RtHost.MapKeys,
            inert: true,
            answer: Box.List,
            boxes: [Box.Map],
        },
        RtSig {
            name: "avra_map_vals",
            ret: RtKind.Ptr,
            params: [RtKind.Ptr],
            owns_result: true,
            has_owned_twin: false,
            host: RtHost.MapVals,
            inert: true,
            answer: Box.List,
            boxes: [Box.Map],
        },
        // A key removed — the rest keep their order; the answer is
        // nothing, the value read before the call.
        RtSig {
            name: "avra_map_remove",
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.Ptr],
            writes: [true, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.MapRemove,
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        RtSig {
            name: "avra_slot_unique",
            ret: RtKind.Ptr,
            params: [RtKind.Ptr, RtKind.I64],
            writes: [true, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.SlotUnique,
            inert: true,
        },
        // a slot whose word may be a scalar (a `dyn` box's value): opened only when the slot owns a box
        RtSig {
            name: "avra_owned_slot_unique",
            ret: RtKind.Ptr,
            params: [RtKind.Ptr, RtKind.I64],
            writes: [true, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.SlotUnique,
            inert: true,
        },
        RtSig {
            name: "avra_slot_set",
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.I64, RtKind.I64],
            writes: [true, false, false],
            owns_result: false,
            has_owned_twin: true,
            host: RtHost.SlotSet,
            inert: true,
            has_moving_twin: true,
        },
        RtSig {
            name: "avra_slot_set_owned",
            takes: Takes.Always(2),
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.I64, RtKind.Ptr],
            writes: [true, false, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.SlotSet,
            keeps: [false, false, true],
            inert: true,
        },
        RtSig {
            name: "avra_slot_set_moved",
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.I64, RtKind.Ptr],
            writes: [true, false, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.SlotSet,
            keeps: [false, false, true],
            inert: true,
        },
        // A NULLABLE SCALAR IN A SLOT: its word, and its absence in the
        // cell's mark — written with presence, asked for presence
        RtSig {
            name: "avra_array_push_maybe",
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.I64, RtKind.I64],
            writes: [true, false, false],
            owns_result: false,
            has_owned_twin: true,
            host: RtHost.ArrayPushMaybe,
            inert: true,
            boxes: [Box.List],
        },
        RtSig {
            name: "avra_array_push_maybe_owned",
            takes: Takes.Present(2, 1),
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.I64, RtKind.Ptr],
            writes: [true, false, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.ArrayPushMaybe,
            keeps: [false, false, true],
            inert: true,
            boxes: [Box.List],
        },
        RtSig {
            name: "avra_slot_set_maybe",
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.I64, RtKind.I64, RtKind.I64],
            writes: [true, false, false, false],
            owns_result: false,
            has_owned_twin: true,
            host: RtHost.SlotSetMaybe,
            inert: true,
        },
        RtSig {
            name: "avra_slot_set_maybe_owned",
            takes: Takes.Present(3, 2),
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.I64, RtKind.I64, RtKind.Ptr],
            writes: [true, false, false, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.SlotSetMaybe,
            keeps: [false, false, false, true],
            inert: true,
        },
        RtSig {
            name: "avra_slot_present",
            ret: RtKind.I64,
            params: [RtKind.Ptr, RtKind.I64],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.SlotPresent,
            inert: true,
        },
        RtSig {
            name: "avra_array_last_present",
            ret: RtKind.I64,
            params: [RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.ArrayLastPresent,
            inert: true,
            boxes: [Box.List],
        },
        RtSig {
            name: "avra_array_len",
            ret: RtKind.I64,
            params: [RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.ArrayLen,
            inert: true,
            boxes: [Box.List],
        },
        // THE ONCE CACHE: a `once fn`'s answer, asked by the fn's own
        // symbol. The get ANSWERS OWNED (the cache keeps its own
        // reference forever); the set KEEPS what it is handed and so
        // takes its OWN reference, as every keeping row does — it
        // does not consume the caller's.
        RtSig {
            name: "avra_once_get",
            stood: true,
            ret: RtKind.Ptr,
            params: [RtKind.Ptr],
            owns_result: true,
            has_owned_twin: false,
            host: RtHost.OnceGet,
            inert: true,
        },
        RtSig {
            name: "avra_once_set",
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.Ptr],
            writes: [false, true],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.OnceSet,
            keeps: [true, true],
            inert: true,
        },
        // A COMPILED `once fn`'s OWN SLOT, committed: settles the
        // keyed table exactly as `avra_once_set` always has (the
        // credit and the immortal flip happen there, unchanged), then
        // fills this fn's own process-lifetime global with whichever
