//! THE runtime surface, as data — one table, five consumers: the
//! backend DECLARES from it, COERCES arguments by it, the memory
//! pass derives OWNERSHIP from it (the owned twin is a column), the
//! lowering REFUSES a callee it does not know, and the interpreter
//! HOSTS every row by its host column. The twins: runtime/
//! avra_runtime.c natively, the host arm in the interpreter — a new
//! runtime fn is a row plus both bodies, nothing else.
use core.{RtKind, RtSig, RtHost, TypeRegistry, TypeId}

export fn rt_sigs() -> List<RtSig> {
    let sigs: List<RtSig> = [
        RtSig { name: "avra_puts", ret: RtKind.Void, params: [RtKind.Ptr], owns_result: false, has_owned_twin: false, host: RtHost.Puts },
        RtSig { name: "avra_streq", ret: RtKind.I64, params: [RtKind.Ptr, RtKind.Ptr], owns_result: false, has_owned_twin: false, host: RtHost.Streq },
        RtSig { name: "avra_rc_release", ret: RtKind.Void, params: [RtKind.Ptr], owns_result: false, has_owned_twin: false, host: RtHost.Unhosted },
        RtSig { name: "avra_rc_retain", ret: RtKind.Void, params: [RtKind.Ptr], owns_result: false, has_owned_twin: false, host: RtHost.Unhosted },
        RtSig { name: "avra_array_new", ret: RtKind.Ptr, params: [], owns_result: true, has_owned_twin: false, host: RtHost.ArrayNew },
        RtSig { name: "avra_array_push", ret: RtKind.Void, params: [RtKind.Ptr, RtKind.I64], owns_result: false, has_owned_twin: true, host: RtHost.ArrayPush },
        RtSig { name: "avra_array_push_owned", ret: RtKind.Void, params: [RtKind.Ptr, RtKind.Ptr], owns_result: false, has_owned_twin: false, host: RtHost.ArrayPush },
        RtSig { name: "avra_array_get", ret: RtKind.I64, params: [RtKind.Ptr, RtKind.I64], owns_result: false, has_owned_twin: true, host: RtHost.ArrayGet },
        RtSig { name: "avra_array_get_owned", ret: RtKind.Ptr, params: [RtKind.Ptr, RtKind.I64], owns_result: true, has_owned_twin: false, host: RtHost.ArrayGet },
        RtSig { name: "avra_cell_release", ret: RtKind.Void, params: [RtKind.Ptr], owns_result: false, has_owned_twin: false, host: RtHost.CellRelease },
        RtSig { name: "avra_cell_unique", ret: RtKind.Ptr, params: [RtKind.Ptr], owns_result: false, has_owned_twin: false, host: RtHost.CellUnique },
        RtSig { name: "avra_map_new", ret: RtKind.Ptr, params: [], owns_result: true, has_owned_twin: false, host: RtHost.MapNew },
        RtSig { name: "avra_map_len", ret: RtKind.I64, params: [RtKind.Ptr], owns_result: false, has_owned_twin: false, host: RtHost.MapLen },
        RtSig { name: "avra_map_has", ret: RtKind.I64, params: [RtKind.Ptr, RtKind.Ptr], owns_result: false, has_owned_twin: false, host: RtHost.MapHas },
        RtSig { name: "avra_map_get", ret: RtKind.I64, params: [RtKind.Ptr, RtKind.Ptr], owns_result: false, has_owned_twin: true, host: RtHost.MapGet },
        RtSig { name: "avra_map_get_owned", ret: RtKind.Ptr, params: [RtKind.Ptr, RtKind.Ptr], owns_result: true, has_owned_twin: false, host: RtHost.MapGet },
        RtSig { name: "avra_map_set", ret: RtKind.Void, params: [RtKind.Ptr, RtKind.Ptr, RtKind.I64], owns_result: false, has_owned_twin: true, host: RtHost.MapSet },
        RtSig { name: "avra_map_set_owned", ret: RtKind.Void, params: [RtKind.Ptr, RtKind.Ptr, RtKind.Ptr], owns_result: false, has_owned_twin: false, host: RtHost.MapSet },
        RtSig { name: "avra_slot_unique", ret: RtKind.Ptr, params: [RtKind.Ptr, RtKind.I64], owns_result: false, has_owned_twin: false, host: RtHost.SlotUnique },
        RtSig { name: "avra_slot_set", ret: RtKind.Void, params: [RtKind.Ptr, RtKind.I64, RtKind.I64], owns_result: false, has_owned_twin: true, host: RtHost.SlotSet },
        RtSig { name: "avra_slot_set_owned", ret: RtKind.Void, params: [RtKind.Ptr, RtKind.I64, RtKind.Ptr], owns_result: false, has_owned_twin: false, host: RtHost.SlotSet },
        RtSig { name: "avra_array_len", ret: RtKind.I64, params: [RtKind.Ptr], owns_result: false, has_owned_twin: false, host: RtHost.ArrayLen },
        RtSig { name: "avra_str_join", ret: RtKind.Ptr, params: [RtKind.Ptr, RtKind.Ptr], owns_result: true, has_owned_twin: false, host: RtHost.StrJoin },
        RtSig { name: "avra_insist", ret: RtKind.Ptr, params: [RtKind.Ptr], owns_result: true, has_owned_twin: false, host: RtHost.Insist },
        RtSig { name: "avra_insist_scalar", ret: RtKind.I64, params: [RtKind.I64, RtKind.I64], owns_result: false, has_owned_twin: false, host: RtHost.InsistScalar },
        RtSig { name: "avra_int_div", ret: RtKind.I64, params: [RtKind.I64, RtKind.I64], owns_result: false, has_owned_twin: false, host: RtHost.Unhosted },
        RtSig { name: "avra_int_mod", ret: RtKind.I64, params: [RtKind.I64, RtKind.I64], owns_result: false, has_owned_twin: false, host: RtHost.Unhosted },
        RtSig { name: "avra_int_text", ret: RtKind.Ptr, params: [RtKind.I64], owns_result: true, has_owned_twin: false, host: RtHost.Text },
        RtSig { name: "avra_bool_text", ret: RtKind.Ptr, params: [RtKind.I64], owns_result: false, has_owned_twin: false, host: RtHost.Text },
        RtSig { name: "avra_ints_text", ret: RtKind.Ptr, params: [RtKind.Ptr], owns_result: true, has_owned_twin: false, host: RtHost.Text },
        RtSig { name: "avra_bools_text", ret: RtKind.Ptr, params: [RtKind.Ptr], owns_result: true, has_owned_twin: false, host: RtHost.Text },
        RtSig { name: "avra_strs_text", ret: RtKind.Ptr, params: [RtKind.Ptr], owns_result: true, has_owned_twin: false, host: RtHost.Text },
        RtSig { name: "avra_str_len", ret: RtKind.I64, params: [RtKind.Ptr], owns_result: false, has_owned_twin: false, host: RtHost.Strlen },
        RtSig { name: "avra_array_pop", ret: RtKind.I64, params: [RtKind.Ptr], owns_result: false, has_owned_twin: true, host: RtHost.ArrayPop },
        RtSig { name: "avra_array_pop_owned", ret: RtKind.Ptr, params: [RtKind.Ptr], owns_result: true, has_owned_twin: false, host: RtHost.ArrayPop },
        RtSig { name: "avra_array_concat", ret: RtKind.Ptr, params: [RtKind.Ptr, RtKind.Ptr], owns_result: true, has_owned_twin: false, host: RtHost.ArrayConcat },
        RtSig { name: "avra_array_slice", ret: RtKind.Ptr, params: [RtKind.Ptr, RtKind.I64, RtKind.I64], owns_result: true, has_owned_twin: false, host: RtHost.ArraySlice },
        RtSig { name: "avra_str_contains", ret: RtKind.I64, params: [RtKind.Ptr, RtKind.Ptr], owns_result: false, has_owned_twin: false, host: RtHost.StrContains },
        RtSig { name: "avra_str_starts_with", ret: RtKind.I64, params: [RtKind.Ptr, RtKind.Ptr], owns_result: false, has_owned_twin: false, host: RtHost.StrStartsWith },
        RtSig { name: "avra_str_ends_with", ret: RtKind.I64, params: [RtKind.Ptr, RtKind.Ptr], owns_result: false, has_owned_twin: false, host: RtHost.StrEndsWith },
        RtSig { name: "avra_str_index_of", ret: RtKind.I64, params: [RtKind.Ptr, RtKind.Ptr], owns_result: false, has_owned_twin: false, host: RtHost.StrIndexOf },
        RtSig { name: "avra_str_substring", ret: RtKind.Ptr, params: [RtKind.Ptr, RtKind.I64, RtKind.I64], owns_result: true, has_owned_twin: false, host: RtHost.StrSubstring },
        RtSig { name: "avra_str_split", ret: RtKind.Ptr, params: [RtKind.Ptr, RtKind.Ptr], owns_result: true, has_owned_twin: false, host: RtHost.StrSplit },
        RtSig { name: "avra_str_replace", ret: RtKind.Ptr, params: [RtKind.Ptr, RtKind.Ptr, RtKind.Ptr], owns_result: true, has_owned_twin: false, host: RtHost.StrReplace },
        RtSig { name: "avra_str_char_code", ret: RtKind.I64, params: [RtKind.Ptr, RtKind.I64], owns_result: false, has_owned_twin: false, host: RtHost.StrCharCode },
        RtSig { name: "avra_str_trim", ret: RtKind.Ptr, params: [RtKind.Ptr], owns_result: true, has_owned_twin: false, host: RtHost.StrTrim },
        RtSig { name: "avra_str_concat", ret: RtKind.Ptr, params: [RtKind.Ptr, RtKind.Ptr], owns_result: true, has_owned_twin: false, host: RtHost.StrConcat },
        RtSig { name: "avra_proc_spawn", ret: RtKind.I64, params: [RtKind.Ptr, RtKind.Ptr, RtKind.Ptr, RtKind.Ptr, RtKind.I64, RtKind.I64, RtKind.I64], owns_result: false, has_owned_twin: false, host: RtHost.ProcSpawn },
        RtSig { name: "avra_proc_run", ret: RtKind.I64, params: [RtKind.Ptr, RtKind.Ptr, RtKind.Ptr, RtKind.Ptr, RtKind.I64, RtKind.Ptr, RtKind.I64, RtKind.I64, RtKind.I64], owns_result: false, has_owned_twin: false, host: RtHost.ProcRun },
        RtSig { name: "avra_proc_poll", ret: RtKind.I64, params: [RtKind.I64, RtKind.I64], owns_result: false, has_owned_twin: false, host: RtHost.ProcPoll },
        RtSig { name: "avra_proc_write", ret: RtKind.I64, params: [RtKind.I64, RtKind.Ptr], owns_result: false, has_owned_twin: false, host: RtHost.ProcWrite },
        RtSig { name: "avra_proc_stdin_close", ret: RtKind.I64, params: [RtKind.I64], owns_result: false, has_owned_twin: false, host: RtHost.ProcStdinClose },
        RtSig { name: "avra_proc_take", ret: RtKind.Ptr, params: [RtKind.I64, RtKind.I64], owns_result: true, has_owned_twin: false, host: RtHost.ProcTake },
        RtSig { name: "avra_proc_signal", ret: RtKind.I64, params: [RtKind.I64, RtKind.I64, RtKind.I64], owns_result: false, has_owned_twin: false, host: RtHost.ProcSignal },
        RtSig { name: "avra_proc_status", ret: RtKind.I64, params: [RtKind.I64], owns_result: false, has_owned_twin: false, host: RtHost.ProcStatus },
        RtSig { name: "avra_proc_pid", ret: RtKind.I64, params: [RtKind.I64], owns_result: false, has_owned_twin: false, host: RtHost.ProcPid },
        RtSig { name: "avra_proc_close", ret: RtKind.Void, params: [RtKind.I64], owns_result: false, has_owned_twin: false, host: RtHost.ProcClose },
        RtSig { name: "avra_proc_which", ret: RtKind.Ptr, params: [RtKind.Ptr, RtKind.Ptr], owns_result: true, has_owned_twin: false, host: RtHost.ProcWhich },
        RtSig { name: "avra_proc_error_text", ret: RtKind.Ptr, params: [RtKind.I64], owns_result: false, has_owned_twin: false, host: RtHost.ProcErrorText },
        RtSig { name: "avra_now_ns", ret: RtKind.I64, params: [], owns_result: false, has_owned_twin: false, host: RtHost.NowNs },
        RtSig { name: "avra_host_env", ret: RtKind.Ptr, params: [RtKind.Ptr], owns_result: false, has_owned_twin: false, host: RtHost.HostEnv },
    ]
    sigs
}

/// The runtime kind a type rides in a call across the host seam:
/// scalars are words, every pointer shape a pointer, void nothing.
export fn rt_kind_of(types: TypeRegistry, ty: TypeId) -> RtKind {
    if types.shape_of(ty) is .Void { return RtKind.Void }
    if types.rides_pointer(ty) { return RtKind.Ptr }
    RtKind.I64
}

/// An extern fn's row — borrowed answers, no twin, hosted by the
/// backend alone.
export fn extern_row(name: string, ret: RtKind, params: List<RtKind>) -> RtSig {
    RtSig { name: name, ret: ret, params: params, owns_result: false, has_owned_twin: false, host: RtHost.Unhosted }
}

/// The callee's contract, when the registry knows it.
export fn rt_sig_of(name: string) -> RtSig? {
    rt_sigs().find(it.name == name)
}

/// The registry keyed by name — built ONCE by a consumer that asks
/// per call (the backend per module, the evaluator per machine),
/// where `rt_sig_of` rebuilds every row per ask.
export fn rt_index() -> Map<string, RtSig> {
    mut index: Map<string, RtSig> = {}
    for s in rt_sigs() { index.set(s.name, s) }
    index
}

/// True when the callee's result is a FRESH allocation the memory
/// pass must release.
export fn rt_owns(name: string) -> bool {
    rt_sig_of(name)?.owns_result ?? false
}

/// The callee's owned twin — `<name>_owned` — when the row says
/// one exists.
export fn rt_owned_twin(name: string) -> string? {
    let sig: RtSig? = rt_sig_of(name)
    if sig == null || !sig!.has_owned_twin { return null }
    "${name}_owned"
}
