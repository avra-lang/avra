//! THE runtime surface, as data — one table, five consumers: the
//! backend DECLARES from it, COERCES arguments by it, the memory
//! pass derives OWNERSHIP from it (the owned twin is a column), the
//! lowering REFUSES a callee it does not know, and the interpreter
//! HOSTS every row by its host column. The twins: runtime/
//! avra_runtime.c natively, the host arm in the interpreter — a new
//! runtime fn is a row plus both bodies, nothing else.
use core.{RtKind, RtSig, RtHost, Reach, Takes, TypeRegistry, TypeId, TypeRef, joined, Box}

export once fn rt_sigs() -> List<RtSig> {
    let sigs: List<RtSig> = [
        // A trace line: written to stderr under AVRA_QTRACE, read by no answer.
        RtSig {
            name: "avra_qtrace",
            ret: RtKind.Void,
            params: [RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.Unhosted,
            reach: Reach.Pure,
            boxes: [Box.Text],
        },
        RtSig {
            name: "avra_puts",
            ret: RtKind.Void,
            params: [RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.Puts,
            reach: Reach.World,
            inert: true,
            boxes: [Box.Text],
        },
        // A program's own trap, in its words: exits 2, never returns.
        RtSig {
            name: "avra_trap",
            traps: true,
            ret: RtKind.Void,
            params: [RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.Trap,
            inert: true,
            boxes: [Box.Text],
        },
        RtSig {
            name: "avra_streq",
            ret: RtKind.I64,
            params: [RtKind.Ptr, RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.Streq,
            inert: true,
            boxes: [Box.Text, Box.Text],
        },
        RtSig {
            name: "avra_rc_release",
            ret: RtKind.Void,
            params: [RtKind.Ptr],
            writes: [true],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.Unhosted,
            inert: true,
        },
        RtSig {
            name: "avra_rc_retain",
            ret: RtKind.Void,
            params: [RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.Unhosted,
            inert: true,
        },
        RtSig {
            name: "avra_array_new",
            ret: RtKind.Ptr,
            params: [],
            answer: Box.List,
            owns_result: true,
            has_owned_twin: false,
            host: RtHost.ArrayNew,
            inert: true,
        },
        RtSig {
            name: "avra_array_sized",
            ret: RtKind.Ptr,
            params: [RtKind.I64],
            answer: Box.List,
            owns_result: true,
            has_owned_twin: false,
            host: RtHost.ArrayNew,
            inert: true,
        },
        RtSig {
            name: "avra_array_push",
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.I64],
            writes: [true, false],
            owns_result: false,
            has_owned_twin: true,
            host: RtHost.ArrayPush,
            inert: true,
            boxes: [Box.List],
            has_moving_twin: true,
        },
        RtSig {
            name: "avra_array_push_owned",
            takes: Takes.Always(1),
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.Ptr],
            writes: [true, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.ArrayPush,
            keeps: [false, true],
            inert: true,
            boxes: [Box.List],
        },
        RtSig {
            name: "avra_array_push_moved",
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.Ptr],
            writes: [true, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.ArrayPush,
            keeps: [false, true],
            inert: true,
            boxes: [Box.List],
        },
        RtSig {
            name: "avra_array_get",
            traps: true,
            ret: RtKind.I64,
            params: [RtKind.Ptr, RtKind.I64],
            owns_result: false,
            has_owned_twin: true,
            host: RtHost.ArrayGet,
            lends: true,
            inert: true,
            boxes: [Box.List],
        },
        RtSig {
            name: "avra_array_get_owned",
            traps: true,
            stood: true,
            ret: RtKind.Ptr,
            params: [RtKind.Ptr, RtKind.I64],
            owns_result: true,
            has_owned_twin: false,
            host: RtHost.ArrayGet,
            inert: true,
            boxes: [Box.List],
        },
        // A SLOT THE READER'S TYPE PROVES: a declared field of a boxed
        // record, a cell's one slot. The shape guarantees the slot, so
        // the native read is a load with no bounds test; the evaluator
        // keeps `avra_array_get`'s, which is how a row written short
        // across a generation still refuses.
        RtSig {
            name: "avra_slot_get",
            ret: RtKind.I64,
            params: [RtKind.Ptr, RtKind.I64],
            owns_result: false,
            has_owned_twin: true,
            host: RtHost.ArrayGet,
            lends: true,
            inert: true,
            boxes: [Box.List],
        },
        RtSig {
            name: "avra_slot_get_owned",
            stood: true,
            ret: RtKind.Ptr,
            params: [RtKind.Ptr, RtKind.I64],
            owns_result: true,
            has_owned_twin: false,
            host: RtHost.ArrayGet,
            inert: true,
            boxes: [Box.List],
        },
        RtSig {
            name: "avra_cell_release",
            ret: RtKind.Void,
            params: [RtKind.Ptr],
            writes: [true],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.CellRelease,
            inert: true,
        },
        RtSig {
            name: "avra_cell_unique",
            ret: RtKind.Ptr,
            params: [RtKind.Ptr],
            writes: [true],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.CellUnique,
            inert: true,
        },
        RtSig {
            name: "avra_cell_thawed",
            ret: RtKind.Ptr,
            params: [RtKind.Ptr],
            writes: [true],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.CellThawed,
            inert: true,
        },
        RtSig {
            name: "avra_box_thawed",
            ret: RtKind.Ptr,
            params: [RtKind.Ptr],
            owns_result: true,
            has_owned_twin: false,
            host: RtHost.BoxThawed,
            inert: true,
            aliases_arg0: true,
        },
        RtSig {
            name: "avra_enum_boxed",
            takes: Takes.Counted(1, 0, 2),
            ret: RtKind.Ptr,
            params: [RtKind.I64, RtKind.I64, RtKind.I64],
            answer: Box.List,
            owns_result: true,
            has_owned_twin: false,
            host: RtHost.EnumBoxed,
            inert: true,
        },
        RtSig {
            name: "avra_array_push_tagged",
            takes: Takes.Counted(1, 2, 3),
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.I64, RtKind.I64, RtKind.I64],
            writes: [true, false, false, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.ArrayPush,
            inert: true,
            boxes: [Box.List],
        },
        RtSig {
            name: "avra_slot_set_tagged",
            traps: true,
            takes: Takes.Counted(2, 3, 4),
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.I64, RtKind.I64, RtKind.I64, RtKind.I64],
            writes: [true, false, false, false, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.SlotSet,
            inert: true,
        },
        RtSig {
            name: "avra_enum_tag",
            ret: RtKind.I64,
            params: [RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.EnumTag,
            inert: true,
            boxes: [Box.List],
        },
        RtSig {
            name: "avra_enum_word",
            ret: RtKind.I64,
            params: [RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.EnumWord,
            lends: true,
            inert: true,
            boxes: [Box.List],
        },
        RtSig {
            name: "avra_rc_retain_tagged",
            ret: RtKind.Void,
            params: [RtKind.I64, RtKind.I64, RtKind.I64],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.Unhosted,
            inert: true,
        },
        RtSig {
            name: "avra_rc_release_tagged",
            ret: RtKind.Void,
            params: [RtKind.I64, RtKind.I64, RtKind.I64],
            writes: [true, false, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.Unhosted,
            inert: true,
        },
        RtSig {
            name: "avra_cell_forget",
            ret: RtKind.Void,
            params: [RtKind.Ptr],
            writes: [true],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.CellForget,
            inert: true,
        },
        RtSig {
            name: "avra_map_new",
            ret: RtKind.Ptr,
            params: [],
            answer: Box.Map,
            owns_result: true,
            has_owned_twin: false,
            host: RtHost.MapNew,
            inert: true,
        },
        RtSig {
            name: "avra_map_len",
            ret: RtKind.I64,
            params: [RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.MapLen,
            inert: true,
            boxes: [Box.Map],
        },
        RtSig {
            name: "avra_map_has",
            ret: RtKind.I64,
            params: [RtKind.Ptr, RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.MapHas,
            inert: true,
            boxes: [Box.Map, Box.Text],
