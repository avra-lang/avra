        RtSig {
            name: "avra_map_remove",
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.Ptr],
            writes: [true, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.MapRemove,
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        RtSig {
            name: "avra_slot_unique",
            traps: true,
            ret: RtKind.Ptr,
            params: [RtKind.Ptr, RtKind.I64],
            writes: [true, false],
            owns_result: false,
            has_owned_twin: false,
