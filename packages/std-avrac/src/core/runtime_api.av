        RtSig {
            name: "avra_map_get",
            ret: RtKind.I64,
            params: [RtKind.Ptr, RtKind.Ptr],
            owns_result: false,
            has_owned_twin: true,
            host: RtHost.MapGet,
            lends: true,
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        RtSig {
            name: "avra_map_get_owned",
            stood: true,
            ret: RtKind.Ptr,
            params: [RtKind.Ptr, RtKind.Ptr],
            owns_result: true,
            has_owned_twin: false,
            host: RtHost.MapGet,
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        RtSig {
            name: "avra_map_set",
            traps: true,
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.Ptr, RtKind.I64],
            writes: [true, false, false],
            owns_result: false,
            has_owned_twin: true,
            host: RtHost.MapSet,
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        RtSig {
            name: "avra_map_set_owned",
            traps: true,
            takes: Takes.Always(2),
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.Ptr, RtKind.Ptr],
            writes: [true, false, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.MapSet,
            keeps: [false, false, true],
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        RtSig {
            name: "avra_map_set_maybe",
            traps: true,
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.Ptr, RtKind.I64, RtKind.I64],
            writes: [true, false, false, false],
            owns_result: false,
            has_owned_twin: true,
            host: RtHost.MapSetMaybe,
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        RtSig {
            name: "avra_map_set_maybe_owned",
            traps: true,
            takes: Takes.Present(3, 2),
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.Ptr, RtKind.I64, RtKind.Ptr],
            writes: [true, false, false, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.MapSetMaybe,
            keeps: [false, false, false, true],
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        // The set family under a token — `avra_map_slot`'s word for the
        // same key, so the write walks no index.
        RtSig {
            name: "avra_map_set_at",
            traps: true,
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.Ptr, RtKind.I64, RtKind.I64],
            writes: [true, false, false, false],
            owns_result: false,
            has_owned_twin: true,
            host: RtHost.MapSetAt,
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        RtSig {
            name: "avra_map_set_at_owned",
            traps: true,
            takes: Takes.Always(3),
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.Ptr, RtKind.I64, RtKind.Ptr],
            writes: [true, false, false, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.MapSetAt,
            keeps: [false, false, false, true],
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        RtSig {
            name: "avra_map_set_at_maybe",
            traps: true,
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.Ptr, RtKind.I64, RtKind.I64, RtKind.I64],
            writes: [true, false, false, false, false],
            owns_result: false,
            has_owned_twin: true,
            host: RtHost.MapSetAtMaybe,
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        RtSig {
            name: "avra_map_set_at_maybe_owned",
            traps: true,
            takes: Takes.Present(4, 3),
            ret: RtKind.Void,
            params: [RtKind.Ptr, RtKind.Ptr, RtKind.I64, RtKind.I64, RtKind.Ptr],
            writes: [true, false, false, false, false],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.MapSetAtMaybe,
            keeps: [false, false, false, false, true],
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        RtSig {
            name: "avra_map_value_present",
            ret: RtKind.I64,
            params: [RtKind.Ptr, RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.MapValuePresent,
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        // A KEY'S ONE PROBE: the slot it names, or -1 — then the value
        // and its presence read that slot, so `get` hashes once.
        RtSig {
            name: "avra_map_slot",
            ret: RtKind.I64,
            params: [RtKind.Ptr, RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.MapSlot,
            inert: true,
            boxes: [Box.Map, Box.Text],
        },
        RtSig {
            name: "avra_map_value_at",
            traps: true,
            ret: RtKind.I64,
            params: [RtKind.Ptr, RtKind.I64],
            owns_result: false,
            has_owned_twin: true,
            host: RtHost.MapValueAt,
            lends: true,
            inert: true,
            boxes: [Box.Map],
        },
        RtSig {
            name: "avra_map_value_at_owned",
            traps: true,
            stood: true,
            ret: RtKind.Ptr,
            params: [RtKind.Ptr, RtKind.I64],
            owns_result: true,
            has_owned_twin: false,
            host: RtHost.MapValueAt,
            inert: true,
            boxes: [Box.Map],
        },
        RtSig {
            name: "avra_map_present_at",
            traps: true,
            ret: RtKind.I64,
            params: [RtKind.Ptr, RtKind.I64],
            owns_result: false,
            has_owned_twin: false,
            host: RtHost.MapPresentAt,
            inert: true,
            boxes: [Box.Map],
        },
        // A map's ORDER IS A PROPERTY OF THE VALUE: its keys and its
        // values each read back as a fresh list in insertion order.
        RtSig {
            name: "avra_map_keys",
            ret: RtKind.Ptr,
            params: [RtKind.Ptr],
            owns_result: true,
            has_owned_twin: false,
            host: RtHost.MapKeys,
            inert: true,
            answer: Box.List,
            boxes: [Box.Map],
        },
        RtSig {
            name: "avra_map_vals",
            ret: RtKind.Ptr,
            params: [RtKind.Ptr],
            owns_result: true,
            has_owned_twin: false,
            host: RtHost.MapVals,
            inert: true,
            answer: Box.List,
            boxes: [Box.Map],
