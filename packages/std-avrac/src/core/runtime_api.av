        RtSig { name: "avra_insist_scalar", ret: RtKind.I64, params: [RtKind.I64, RtKind.I64], owns_result: false, has_owned_twin: false, host: RtHost.InsistScalar },
        RtSig { name: "avra_int_div", ret: RtKind.I64, params: [RtKind.I64, RtKind.I64], owns_result: false, has_owned_twin: false, host: RtHost.Unhosted },
        RtSig { name: "avra_int_mod", ret: RtKind.I64, params: [RtKind.I64, RtKind.I64], owns_result: false, has_owned_twin: false, host: RtHost.Unhosted },
        RtSig { name: "avra_float_text", ret: RtKind.Ptr, params: [RtKind.F64], owns_result: true, has_owned_twin: false, host: RtHost.Text },
        RtSig { name: "avra_int_and", ret: RtKind.I64, params: [RtKind.I64, RtKind.I64], owns_result: false, has_owned_twin: false, host: RtHost.Unhosted },
        RtSig { name: "avra_int_or", ret: RtKind.I64, params: [RtKind.I64, RtKind.I64], owns_result: false, has_owned_twin: false, host: RtHost.Unhosted },
        RtSig { name: "avra_int_xor", ret: RtKind.I64, params: [RtKind.I64, RtKind.I64], owns_result: false, has_owned_twin: false, host: RtHost.Unhosted },
