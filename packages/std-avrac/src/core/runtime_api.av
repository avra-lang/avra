        // answer exists. The per-seat check cannot see inside a list,
        // so the C body checks each word at the crossing itself.
        RtSig {
            name: "avra_exec_self",
            ret: RtKind.I64,
            params: [RtKind.Ptr],
            owns_result: false,
            has_owned_twin: false,
