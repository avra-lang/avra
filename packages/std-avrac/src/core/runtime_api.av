        // no declaration table. The answer wears no box this
        // vocabulary names (an arbitrary record, not text/bytes/a
        // list/a map), so `Any` — the row's arm is the only reader.
        RtSig {
            name: "avra_type_named",
            traps: true,
            ret: RtKind.Ptr,
            params: [RtKind.Ptr],
            answer: Box.Any,
            owns_result: true,
