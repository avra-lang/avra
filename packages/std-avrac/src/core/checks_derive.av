//! `Checks` — a node's typing rule: its type, checked against what its seat wants. A
//! `collect enum Expr: Checks` derives the empty impl for a member with no rule of its own: it checks
//! each node it holds against nothing and answers nothing itself, so a node whose feature has no rule
//! yet is unchecked while everything beneath it still is.
//!
//! It stands ALONE in this file on purpose (CLAUDE.md).
use @std.meta.{Type as MetaType, Directive, beside}

export trait Checks {
    /// This node's type, checked against `expected`; absent while its feature has no rule.
    fn checked(mut cx: Checking, e: ExprId, expected: Expected) -> SignedType? { cx.held_checked(e) }

    static fn derive(t: MetaType) -> List<Directive> {
        [beside(t, quote { impl Checks for ${t} {} })]
    }
}
