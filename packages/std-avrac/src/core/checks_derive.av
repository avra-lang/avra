//! `Checks` — a node's typing rule: its type, checked against what its seat wants. A
//! `collect enum Expr: Checks` derives a default for a member with nothing that can bind a name: it
//! checks each node it holds against what isn't known and answers nothing itself. A member holding a
//! binder (parameters, arms, clauses, a pattern, statements, a name) gets none, so it doesn't build
//! until its feature writes the rule that says what it binds.
//!
//! It stands ALONE in this file on purpose (CLAUDE.md).
use @std.meta.{Type as MetaType, Directive, beside}

export trait Checks {
    /// This node's type, checked against `expected`; absent when it isn't known.
    fn checked(mut cx: Checking, e: ExprId, expected: Expected) -> SignedType? { cx.children_checked(e) }

    static fn derive(t: MetaType) -> List<Directive> {
        if t.fields.any((f) -> BINDERS.contains(f.ty)) { [] } else { [beside(t, quote { impl Checks for ${t} {} })] }
    }
}

/// The field types that can bind a name.
const BINDERS: List<string> = [
    "List<Param>",
    "List<Arm>",
    "List<CatchArm>",
    "List<CompClause>",
    "PatId",
    "PatId?",
    "List<StmtId>",
    "BodyView",
    "Scoped",
    "Scoped?",
]
