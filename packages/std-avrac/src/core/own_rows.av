//! THE VERBS THE LANGUAGE OWNS THAT ARE ONE RUNTIME ROW: a verb or property `@std/prelude`'s
//! `verbs/` declares on a type the language owns, and the row it is, handed the receiver then each
//! argument. A verb no row is lowers by its own rule, or isn't lowered yet.

/// A verb on a type the language owns that is one runtime row: the receiver's type word, the
/// verb's name, the row's, and what the verb makes of the row's answer.
export type OwnRow = { receiver: string, verb: string, row: string, answer: RowUse }

/// What a verb makes of its row's answer.
export enum RowUse {
    /// The answer is the verb's.
    Answer
    /// The verb is whether the answer is zero.
    Zero
    /// The answer, known before the program runs where the receiver is a literal and the index one.
    Folds
}

/// Every verb the language owns that is one runtime row; `length` is the row that measures. A row
/// whose receiver is written applied (`List<Bytes>`) is that receiver's alone.
export once fn own_rows() -> List<OwnRow> {
    table<OwnRow> {
        receiver      | verb          | row                        | answer
        "string"      | "length"      | "avra_str_len"             | RowUse.Answer
        "string"      | "is_empty"    | "avra_str_len"             | RowUse.Zero
        "string"      | "contains"    | "avra_str_contains"        | RowUse.Answer
        "string"      | "starts_with" | "avra_str_starts_with"     | RowUse.Answer
        "string"      | "ends_with"   | "avra_str_ends_with"       | RowUse.Answer
        "string"      | "index_of"    | "avra_str_index_of"        | RowUse.Answer
        "string"      | "substring"   | "avra_str_substring"       | RowUse.Answer
        "string"      | "split"       | "avra_str_split"           | RowUse.Answer
        "string"      | "replace"     | "avra_str_replace"         | RowUse.Answer
        "string"      | "trim"        | "avra_str_trim"            | RowUse.Answer
        "string"      | "char_code"   | "avra_str_char_code"       | RowUse.Folds
        "string"      | "bytes"       | "avra_bytes_of_str"        | RowUse.Answer
        "Bytes"       | "length"      | "avra_bytes_len"           | RowUse.Answer
        "Bytes"       | "is_empty"    | "avra_bytes_len"           | RowUse.Zero
        "Bytes"       | "text"        | "avra_str_of_bytes"        | RowUse.Answer
        "Bytes"       | "text_prefix" | "avra_str_of_bytes_prefix" | RowUse.Answer
        "Bytes"       | "text_lossy"  | "avra_str_of_bytes_lossy"  | RowUse.Answer
        "Bytes"       | "at"          | "avra_bytes_at"            | RowUse.Answer
        "Bytes"       | "slice"       | "avra_bytes_slice"         | RowUse.Answer
        "Bytes"       | "concat"      | "avra_bytes_concat"        | RowUse.Answer
        "Bytes"       | "index_of"    | "avra_bytes_index_of"      | RowUse.Answer
        "Bytes"       | "index_in"    | "avra_bytes_index_in"      | RowUse.Answer
        "Bytes"       | "run"         | "avra_bytes_run"           | RowUse.Answer
        "Bytes"       | "run_back"    | "avra_bytes_run_back"      | RowUse.Answer
        "Bytes"       | "eq_at"       | "avra_bytes_eq_at"         | RowUse.Answer
        "Bytes"       | "ieq_at"      | "avra_bytes_ieq_at"        | RowUse.Answer
        "List"        | "length"      | "avra_array_len"           | RowUse.Answer
        "List"        | "is_empty"    | "avra_array_len"           | RowUse.Zero
        "List"        | "concat"      | "avra_array_concat"        | RowUse.Answer
        "List"        | "slice"       | "avra_array_slice"         | RowUse.Answer
        "List"        | "join"        | "avra_str_join"            | RowUse.Answer
        "List<int>"   | "bytes"       | "avra_bytes_of_list"       | RowUse.Answer
        "List<Bytes>" | "bytes"       | "avra_bytes_gathered"      | RowUse.Answer
        "Map"         | "length"      | "avra_map_len"             | RowUse.Answer
        "Map"         | "is_empty"    | "avra_map_len"             | RowUse.Zero
        "Map"         | "has"         | "avra_map_has"             | RowUse.Answer
        "Map"         | "keys"        | "avra_map_keys"            | RowUse.Answer
        "Map"         | "values"      | "avra_map_vals"            | RowUse.Answer
    }
}

/// The row the verb `verb` on a receiver of the type word `receiver` is, absent when it's no one row.
export fn own_row(receiver: string, verb: string) -> OwnRow? { own_rows().find(it.receiver == receiver && it.verb == verb) }

/// The row the verb `verb` on a value of `ty` is: the row of its type as written, else of its type
/// word; absent when it's no one row.
export fn own_row_of(ty: SignedType, verb: string) -> OwnRow? {
    let word? = ty.owned() else { return null }
    own_row(ty.spelled(), verb) ?? own_row(word, verb)
}
