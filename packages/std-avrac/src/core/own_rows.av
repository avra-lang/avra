//! THE VERBS THE LANGUAGE OWNS THAT ARE ONE RUNTIME ROW: a verb or property `@std/prelude`'s
//! `verbs/` declares on a type the language owns, and the row it is, handed the receiver then each
//! argument. A verb no row is lowers by its own rule, or isn't lowered yet.

/// A verb on a type the language owns that is one runtime row: the receiver's type, the type its
/// elements are where the row is that receiver's alone, the verb's name, the row's, and what the verb
/// makes of the row's answer.
export type OwnRow = { receiver: OwnType, of: OwnType?, verb: string, row: string, answer: RowUse }

/// What a verb makes of its row's answer.
export enum RowUse {
    /// The answer is the verb's.
    Answer
    /// The answer, known before the program runs where the receiver is a literal and the index one.
    Folds
    /// The answer, where the argument is a list literal of plain values: the receiver opened and each
    /// element pushed, the literal never made.
    Appends
}

impl RowUse {
    /// Whether a list literal argument is pushed onto the receiver rather than made.
    fn appends() -> bool {
        match self { .Appends -> true, .Answer or .Folds -> false }
    }
}

/// Every verb the language owns that is one runtime row; `length` is the row that measures. A row
/// naming what its receiver's elements are (`List<Bytes>`) is that receiver's alone.
export once fn own_rows() -> List<OwnRow> {
    table<OwnRow> {
        receiver      | of            | verb          | row                        | answer
        OwnType.Str   | null          | "length"      | "avra_str_len"             | RowUse.Answer
        OwnType.Str   | null          | "contains"    | "avra_str_contains"        | RowUse.Answer
        OwnType.Str   | null          | "starts_with" | "avra_str_starts_with"     | RowUse.Answer
        OwnType.Str   | null          | "ends_with"   | "avra_str_ends_with"       | RowUse.Answer
        OwnType.Str   | null          | "index_of"    | "avra_str_index_of"        | RowUse.Answer
        OwnType.Str   | null          | "substring"   | "avra_str_substring"       | RowUse.Answer
        OwnType.Str   | null          | "split"       | "avra_str_split"           | RowUse.Answer
        OwnType.Str   | null          | "replace"     | "avra_str_replace"         | RowUse.Answer
        OwnType.Str   | null          | "trim"        | "avra_str_trim"            | RowUse.Answer
        OwnType.Str   | null          | "char_code"   | "avra_str_char_code"       | RowUse.Folds
        OwnType.Str   | null          | "bytes"       | "avra_bytes_of_str"        | RowUse.Answer
        OwnType.Bytes | null          | "length"      | "avra_bytes_len"           | RowUse.Answer
        OwnType.Bytes | null          | "text"        | "avra_str_of_bytes"        | RowUse.Answer
        OwnType.Bytes | null          | "text_prefix" | "avra_str_of_bytes_prefix" | RowUse.Answer
        OwnType.Bytes | null          | "text_lossy"  | "avra_str_of_bytes_lossy"  | RowUse.Answer
        OwnType.Bytes | null          | "at"          | "avra_bytes_at"            | RowUse.Answer
        OwnType.Bytes | null          | "slice"       | "avra_bytes_slice"         | RowUse.Answer
        OwnType.Bytes | null          | "concat"      | "avra_bytes_concat"        | RowUse.Answer
        OwnType.Bytes | null          | "index_of"    | "avra_bytes_index_of"      | RowUse.Answer
        OwnType.Bytes | null          | "index_in"    | "avra_bytes_index_in"      | RowUse.Answer
        OwnType.Bytes | null          | "run"         | "avra_bytes_run"           | RowUse.Answer
        OwnType.Bytes | null          | "run_back"    | "avra_bytes_run_back"      | RowUse.Answer
        OwnType.Bytes | null          | "eq_at"       | "avra_bytes_eq_at"         | RowUse.Answer
        OwnType.Bytes | null          | "ieq_at"      | "avra_bytes_ieq_at"        | RowUse.Answer
        OwnType.List  | null          | "length"      | "avra_array_len"           | RowUse.Answer
        OwnType.List  | null          | "concat"      | "avra_array_concat"        | RowUse.Appends
        OwnType.List  | null          | "slice"       | "avra_array_slice"         | RowUse.Answer
        OwnType.List  | null          | "join"        | "avra_str_join"            | RowUse.Answer
        OwnType.List  | OwnType.Int   | "bytes"       | "avra_bytes_of_list"       | RowUse.Answer
        OwnType.List  | OwnType.Bytes | "bytes"       | "avra_bytes_gathered"      | RowUse.Answer
        OwnType.Map   | null          | "length"      | "avra_map_len"             | RowUse.Answer
        OwnType.Map   | null          | "has"         | "avra_map_has"             | RowUse.Answer
        OwnType.Map   | null          | "keys"        | "avra_map_keys"            | RowUse.Answer
        OwnType.Map   | null          | "values"      | "avra_map_vals"            | RowUse.Answer
        OwnType.Task  | null          | "done"        | "avra_task_done"           | RowUse.Answer
        OwnType.Task  | null          | "cancel"      | "avra_task_cancel"         | RowUse.Answer
        OwnType.Tasks | null          | "push"        | "avra_tasks_push"          | RowUse.Answer
    }
}

/// The row the verb `verb` on a value of `ty` is: one naming what its elements are, else one that
/// names none; absent when it's no one row.
export fn own_row_of(ty: SignedType, verb: string) -> OwnRow? {
    let own? = ty.own() else { return null }
    own_rows().find(it.receiver == own && it.verb == verb && elements_fit(it, ty))
}

/// Whether the elements of `ty` are what `row` names them, where it names any: an empty literal's
/// elements, which are nothing yet, fit the first row that names its verb, as typing reads it.
fn elements_fit(row: OwnRow, ty: SignedType) -> bool {
    let of? = row.of else { return true }
    let elem? = ty.args.first() else { return false }
    elem.bottom() || elem.owns(of)
}

/// A property every enum has.
export enum EnumProperty {
    /// Its variant's place in the declaration.
    Ordinal
    /// Its variant's name.
    Name
}

/// The property every enum has that is named `name`; absent for any other name.
export fn enum_property_named(name: string) -> EnumProperty? {
    match name { "ordinal" -> EnumProperty.Ordinal, "name" -> EnumProperty.Name, rest -> null }
}

impl Lowering {
    /// The property `p` of `v`, a value of the enum whose variants are `variants`, as a value of layout
    /// `l`: its variant's place, or its variant's name.
    mut fn enum_property(v: Reg, variants: List<VariantSeat>, p: EnumProperty, l: Layout) -> Reg {
        let tag = self.tag_of(v)
        match p {
            .Ordinal -> tag,
            .Name -> {
                // an enum no variant names holds no value, so no name is ever read: what answers is
                // never seen, and the refusal of the enum is what the program hears
                if variants.is_empty() { return self.const_str("") }
                let last = variants.length - 1
                if last == 0 { return self.const_str(variants[0].name) }
                self
                    .switched(tag, [j for j in 0..last], l) { cx, j -> cx.const_str(variants[j].name) }
            },
        }
    }
}

