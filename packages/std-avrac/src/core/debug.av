//! A debug line for the compiler's own instrumentation.
extern fn avra_debug(s: string)

/// Write `s` to stderr when `AVRA_DEBUG` is set, and NOTHING
/// otherwise. The compiler's own instrument: usable from any module
/// (core is the root) and inert under the self-compile, so a probe can
/// stand in a pass without breaking `make avra`.
export fn debug(s: string) {
    avra_debug(s)
}
