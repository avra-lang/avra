//! A debug line for the compiler's own instrumentation, and the
//! compiler's own WRECK.
use @std.io.{env}
use @std.relation.engine.{Kernel, new_kernel}

extern fn avra_debug(s: string)
extern fn avra_qtrace(s: string)
extern fn avra_trap(s: string)

/// Write `s` to stderr when `AVRA_DEBUG` is set, and NOTHING
/// otherwise. The compiler's own instrument: usable from any module
/// (core is the root) and inert under the self-compile, so a probe can
/// stand in a pass without breaking `make avra`.
export fn debug(s: string) {
    avra_debug(s)
}

/// `AVRA_QTRACE`'s presence, read once: a trace line is never built
/// when nobody reads it.
once fn qtrace_flag() -> string? { env("AVRA_QTRACE") }

/// Whether a query-kernel trace line is worth building at all.
export fn traced() -> bool { qtrace_flag() != null }

/// `AVRA_DB_GRAPH`'s presence, read once.
once fn graph_flag() -> string? { env("AVRA_DB_GRAPH") }

/// Whether the kernel's graph is written out.
fn graphed() -> bool { graph_flag() != null }

/// A kernel that traces and writes its graph when the flags ask.
export fn watched_kernel() -> Kernel {
    let kernel = new_kernel()
    if graphed() { kernel.graphed() }
    if traced() { kernel.traced() }
    kernel
}

/// A query-kernel trace line, under `AVRA_QTRACE` alone — a gen-N vs
/// gen-N+1 differential names the first query whose answer diverges
/// (CLAUDE.md, Working discipline). Inert otherwise, same as `debug`.
export fn qtrace(s: string) {
    avra_qtrace(s)
}

/// THE COMPILER'S OWN WRECK — words for a defect that must not ship
/// a value. Exits 2, so a wreck can never be read as a
/// disagreement, and never a program's error: the program is
/// innocent wherever this fires. THE ONE DOOR, so no module
/// declares the trap again.
export fn wreck(s: string) {
    avra_trap(s)
}
