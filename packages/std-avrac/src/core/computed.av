//! The nodes a rule COMPUTES from its labels (`-> Owner.Variant by fn`):
//! each fn reads what the rule wrote and answers the node it means, its
//! own law applied once, where the rule stands.
use @std.meta.{Named}

/// Marks a fn that computes a node from its rule's labels — the fn a
/// rule's `by` names, gathered by `computes` (features/node_scaffold.av).
export fn computed(_f: Named) {}

/// An expression alone on a line, or an assignment when an `=` follows
/// it: one parse of the expression serves both.
///
/// STAYS A FUNCTION: the statement is an assignment or an expression by what follows its head;
/// two rules would parse every expression statement twice.
@computed
fn expr_stmt_written(s: dyn Slots) -> Result<Built, string> {
    let target = s.expr_of("target")?
    let value? = s.expr_opt_of("value")? else { return .Ok(Built.Stmt(s.made_stmt(Stmt.ExprStmt(target))?)) }
    .Ok(Built.Stmt(s.made_stmt(Stmt.Assign(target, value))?))
}

