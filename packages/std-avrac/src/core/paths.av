//! Paths as text: the directory part, the slashes, and whether a
//! path lies under a directory. The host reads and lists; these
//! only cut strings.
use core.{code_at, joined}

/// The directory part of a path; "" when it has none.
export fn dir_of(path: string) -> string {
    let cut = last_slash(path)
    if cut < 0 { return "" }
    path.substring(0, cut)
}

/// The index of a path's last `/`, or -1.
fn last_slash(path: string) -> int {
    mut i = path.length - 1
    while i >= 0 {
        if code_at(path, i) == 47 { return i }
        i = i - 1
    }
    0 - 1
}

/// The index of a path's first `/`, or -1.
export fn first_slash(path: string) -> int {
    let n = path.length
    mut i = 0
    while i < n {
        if code_at(path, i) == 47 { return i }
        i = i + 1
    }
    0 - 1
}

/// Whether `name` lies under `dir` — strictly below it; the empty
/// directory is the root of everything.
export fn under_dir(name: string, dir: string) -> bool {
    if dir.length == 0 { return true }
    name.length > dir.length + 1 && name.substring(0, dir.length + 1) == "${dir}/"
}

/// A name under a directory; the empty directory adds nothing.
export fn joined_path(dir: string, name: string) -> string {
    if dir.length == 0 { return name }
    "${dir}/${name}"
}

/// A path with `.` dropped and `..` folded into the segment before
/// it; a leading `/` survives, and a `..` past the top stays.
export fn normalized(path: string) -> string {
    mut kept: List<string> = []
    for seg in path.split("/") {
        if seg == ".." && !kept.is_empty() && kept.last()! != ".." && kept.last()!.length > 0 {
            kept = kept.slice(0, kept.length - 1)
        } else if seg != "." && (seg.length > 0 || kept.is_empty()) {
            kept.push(seg)
        }
    }
    joined(kept, "/")
}

/// `to` as a path relative to the directory `from` — `..` up to the
/// shared prefix, then down.
export fn relative_path(from: string, to: string) -> string {
    let a = segments(from)
    let b = segments(to)
    let shared = shared_prefix(a, b)
    let ups = [".." for j in a.slice(shared, a.length)]
    joined(ups.concat(b.slice(shared, b.length)), "/")
}

/// A path's non-empty segments.
fn segments(path: string) -> List<string> {
    [s for s in path.split("/") if s.length > 0]
}

/// How many leading segments two paths share.
fn shared_prefix(a: List<string>, b: List<string>) -> int {
    let limit = if a.length < b.length { a.length } else { b.length }
    mut n = 0
    while n < limit && a[n] == b[n] { n = n + 1 }
    n
}
