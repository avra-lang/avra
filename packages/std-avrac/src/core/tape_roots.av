//! Every type an Avra tape holds, gathered from its roots.
use @std.program.tape_schema.{TapeSchema, TypeSchema, tape_schema}

/// The schema of every Avra tape, laid out in the binary. An item is a statement, and a statement
/// reaches the other roots.
export const AVRA_TAPE_SCHEMA: TapeSchema = gathered_schema()

fn gathered_schema() -> TapeSchema {
    mut found: Map<string, TypeSchema> = {}
    Stmt.tape_types_into(found)
    tape_schema(found.values())
}
