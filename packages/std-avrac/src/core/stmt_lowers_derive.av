//! `StmtLowers` — a statement's lowering rule: what it does, emitted, and what it binds. A
//! `collect enum Stmt: StmtLowers` derives the default for every member with no rule of its own: the
//! statement isn't lowered yet, and says so.
//!
//! It stands ALONE in this file on purpose (CLAUDE.md).
use @std.meta.{Type as MetaType, Directive, beside}

export trait StmtLowers {
    /// What this statement does, emitted, and what it binds in the scope it stands in.
    fn stmt_lowered(mut cx: Lowering, s: StmtId) { cx.stmt_unlowered(s) }

    /// What this statement does where a meaning rewrote it as `meant`: those statements, emitted.
    fn meant_lowered(mut cx: Lowering, s: StmtId, meant: List<StmtId>) { for m in meant { cx.lower_stmt(m) } }

    static fn derive(t: MetaType) -> List<Directive> {
        [beside(t, quote { impl StmtLowers for ${t} {} })]
    }
}
