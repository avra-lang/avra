//! Byte-offset source spans. Position is byte offsets everywhere in the
//! compiler: nodes never store line/col (computed from a line index only
//! when a diagnostic is rendered), and spans live in side tables keyed
//! by node id, never on nodes.

/// A half-open byte range `[lo, hi)` in one source file.
///
/// A Span is always a real position; absence is `Span?` at the use
/// site. Zero-width spans (`lo == hi`) mark a position rather than an
/// extent (EOF, an insertion point).
export type Span = { lo: int, hi: int }

/// The span from `lo` to `hi` — the constructor its four hand-written
/// spellings were waiting for.
export fn span_of(lo: int, hi: int) -> Span {
    Span { lo: lo, hi: hi }
}

impl Span {
    /// Bytes covered.
    fn len() -> int { self.hi - self.lo }

    /// True when the span covers no bytes.
    fn is_empty() -> bool { self.hi <= self.lo }

    /// The smallest span containing both, in either argument order.
    fn cover(other: Span) -> Span {
        Span {
            lo: if self.lo < other.lo { self.lo } else { other.lo },
            hi: if self.hi > other.hi { self.hi } else { other.hi },
        }
    }

    /// The text this span selects from its file's source.
    fn text(source: string) -> string {
        source.substring(self.lo, self.hi)
    }
}
