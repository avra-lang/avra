//! A DECLARATION A LAW HOLDS TO, by its package and its name: the one door every law that asks
//! "is this that declaration" goes through, so no law compares a name it read to a word it knows.
use @std.program.address.{SourceFileAddress}

/// A package a law holds to, in either spelling (`@std/meta` or `@std.meta`).
export type KnownPackage = { name: string }

impl KnownPackage {
    /// Whether `package` is this one.
    fn is(package: string) -> bool { key_spelled(package) == key_spelled(self.name) }
}

/// The package that declares what a program asks of the compiler.
export const STD_META: KnownPackage = KnownPackage { name: "@std/meta" }

/// The package every file sees without a `use`.
export const STD_PRELUDE: KnownPackage = KnownPackage { name: "@std/prelude" }

/// A declaration the compiler gives meaning to: the package that declares it, in either spelling
/// (`@std/meta` or `@std.meta`), and the name it is declared under.
export type Known = { package: string, name: string }

impl Known {
    /// Whether the declaration `name` that `package` declares is this one.
    fn is(package: string, name: string) -> bool { name == self.name && key_spelled(package) == key_spelled(self.package) }

    /// Whether the declaration `name` that `file` declares is this one.
    fn is_in(file: SourceFileAddress, name: string) -> bool { self.is(file.package_name, name) }

    /// Whether the written type `head` names this declaration.
    fn heads(head: TypeHead) -> bool {
        match head { .Declared(file, name) -> self.is_in(file, name), rest -> false }
    }
}

/// `@std/task`'s running supply.
export const TASK_SOURCE: Known = Known { package: "@std/task", name: "Source" }

/// `@std/task`'s first of several supplies.
export const TASK_ANY_OF: Known = Known { package: "@std/task", name: "AnyOf" }

/// `@std/time`'s timer that fires once, at an instant.
export const TIME_DEADLINE: Known = Known { package: "@std/time", name: "Deadline" }

/// `@std/time`'s timer that fires once nothing else has for a while.
export const TIME_QUIET: Known = Known { package: "@std/time", name: "Quiet" }

/// `@std/time`'s timer that fires on every period.
export const TIME_EVERY: Known = Known { package: "@std/time", name: "Every" }

/// `@std/meta`'s key a derive mints for a node.
export const META_KEY: Known = Known { package: "@std/meta", name: "Key" }
