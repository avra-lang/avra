//! The lowering IR: what a program DOES, flat and typed. Virtual
//! registers, one instruction list, and SCOPES as real structure —
//! memory strategy is decided per scope by its LEVEL (the scoped
//! abstraction levels design), so lowering never writes a memory op;
//! the memory pass inserts them at the boundaries recorded here.
//! The language binds every name once, so a definition's register IS
//! its value everywhere it is read — the IR is born SSA.

use @std.meta.{derive}

/// A virtual register. Minted in instruction order: the Nth
/// value-producing instruction defines register N.
@derive(Fingerprint)
export type Reg = { index: int }

/// A scope's abstraction level — which memory strategy owns it.
@derive(Fingerprint)
export enum Level { Application, Systems, Bare, Hardware }

/// The unary operators.
@derive(Fingerprint)
export enum UnOp { Not }

/// The operator's surface symbol — the projection beside its enum.
export fn un_symbol(op: UnOp) -> string {
    match op {
        .Not -> "!",
    }
}

/// THE INSTRUCTION VOCABULARY. Features lower into it and never
/// grow it; growth is a core event with a protocol (CLAUDE.md),
/// and performance is a first-class reason to grow — a shape the
/// backend can exploit but cannot infer earns a variant.
///
/// A new variant owes EVERY consumer `make vocab` names, and the
/// compiler names them for you because each dispatch is exhaustive:
///   dst_of (below)          the register it defines
///   body_symbol (below)     the program body it names
///   hosted_symbol (below)   the hosted fn it calls
///   interp.av  step         its MEANING, interpreted
///   memory.av  memory_ins   its ownership effect
///   ir_text.av body_lines   its human projection
///   llvm.av    emit_ins     its machine projection
///   facts.av   give         whether the runtime registry validates it
///   memory.av  managed_dst  whether its answer is the caller's to release
/// plus a program test (eval == native) and an IR golden.
/// `avra new ins <Name>` prints the whole checklist.
///
/// GENERALIZE BEFORE ADDING: SwitchStart reuses ArmEnd/RegionEnd,
/// so an N-arm region and a 2-arm `if` are ONE mechanism in every consumer —
/// prefer making an existing concept more general over adding a
/// parallel one. That is what keeps this vocabulary small while it
/// grows.
@derive(Roles)
export enum Ins {
    // Values.
    ConstInt(@dst dst: Reg, v: int)
    /// A REAL constant, carried as its IEEE-754 bit pattern because
    /// the compiler that emits it holds no float of its own. THE
    /// VARIANT IS THE TYPE: every value category has its own
    /// constant, so what an instruction MEANS never depends on where
    /// its answer is going.
    ConstFloat(@dst dst: Reg, bits: int)
    /// A string constant is the binary's own data — immortal, so it owns nothing.
    ConstStr(@dst dst: Reg, s: string)
    ConstBool(@dst dst: Reg, v: bool)
    /// The eager binary operations — operands same-typed. The lazy
    /// ops (And/Or) never reach here: they lower as regions.
    Bin(@dst dst: Reg, op: BinOp, a: Reg, b: Reg)
    /// The unary operations.
    Un(@dst dst: Reg, op: UnOp, src: Reg)
    /// An effect-only call into the runtime's C surface — no value
    /// defined (seeding an aggregate, releasing early).
    CallRtVoid(@host callee: string, args: List<Reg>)
    /// A call into the runtime's C surface — THE escape hatch that
    /// keeps this instruction set closed: features lower
    /// value-producing runtime needs here, never as new variants.
    CallRt(@dst @owns dst: Reg, @host callee: string, args: List<Reg>)
    /// A small immutable aggregate built IN REGISTERS — the machine
    /// shape behind the unboxed pair (a scalar nullable's
    /// {present, value}); the backend keeps it out of memory
    /// entirely, so the optimizer sees through it. A register holds
    /// ONE VALUE, not one word — this is the variant that says so.
    Pack(@dst @owns dst: Reg, elems: List<Reg>)
    /// One element of a packed value.
    Extract(@dst @view dst: Reg, src: Reg, at: int)
    /// A named fn's ADDRESS as a value — the code pointer a dyn
    /// box (and, ahead, a closure) carries; `CallPtr` calls
    /// through it. An opaque word to every other consumer.
    FnAddr(@dst @owns dst: Reg, @code sym: string)
    /// A SETTLED aggregate's ADDRESS: the `Static` of that name in
    /// the program, laid out before it runs as an immortal headered
    /// box — never built, never released, so a read costs one
    /// address and the memory pass owes it nothing. The one constant
    /// that aims at a pointer register, and it is a name, never a
    /// number.
    StaticAddr(@dst dst: Reg, sym: string)

    // Structure: scopes, regions, and calls — all BRACKETS in the
    // one flat list, never labels or jumps. Each branch of a region
    // is a scope to the memory pass and names the register it
    // yields; `dst` merges the two.
    ScopeEnter(tier: Level)
    /// A scope YIELDS like a branch does: `gives` escapes upward —
    /// released never here, adopted by the enclosing scope.
    ScopeExit(gives: Reg?)
    /// A TWO-arm region on a bool — the special case of the region
    /// shape below.
    IfStart(cond: Reg)
    /// An N-ARM region on an int selector: `cases` are the selector
    /// values of arms 0..N-2 IN ARM ORDER, and the last arm is the
    /// default, so a total match needs no fallthrough. The backend
    /// emits one jump table; the arms are bracketed exactly like an
    /// if's, because a region is a region.
    SwitchStart(selector: Reg, cases: List<int>)
    /// End of ONE arm, yielding — shared by both openers, which is
    /// why it is not named for either.
    ArmEnd(gives: Reg)
    /// End of the LAST arm: every arm's yield merges into `dst`.
    RegionEnd(@dst @owns dst: Reg, gives: Reg)
    /// A call to an Avra fn body. A PARAMETER IS BORROWED: the caller
    /// keeps each managed argument standing for the call, and the
    /// callee owns none of them — what it keeps takes its own reference.
    Call(@dst @owns dst: Reg, @body callee: string, @seats @lent args: List<Reg>)
    /// An INDIRECT call through a register-held fn address — dyn
    /// dispatch (and, ahead, closures). The ABI is `Call`'s.
    CallPtr(@dst @owns dst: Reg, f: Reg, @seats @lent args: List<Reg>)
    /// A fn body's answer, after its scope has settled its debts.
    RetVal(r: Reg)
    /// An EARLY answer — `return` from anywhere in a body. The
    /// memory pass settles every open scope's debts at the site
    /// (nothing pops: other paths continue); the backend returns
    /// right here and opens a dead continuation for the arm's
    /// unreachable tail.
    FnExit(gives: Reg)

    // Slots: mutation lives in MEMORY so registers stay
    // single-assignment — a mut binding allocates a slot, loads
    // mint fresh registers, stores update the slot. Scalars only
    // until ownership analysis covers managed values.
    Alloca(@dst dst: Reg)
    Load(@dst @owns dst: Reg, slot: Reg)
    Store(slot: Reg, src: Reg)

    // Loops: the third bracket family. The condition's instructions
    // sit between LoopStart and LoopCond and re-run each turn;
    // LoopCond exits when false; LoopEnd closes the back edge.
    LoopStart
    LoopCond(c: Reg)
    LoopEnd

    // Memory: inserted by the memory pass, never by lowering.
    Retain(r: Reg)
    Release(r: Reg)

    // Effects.
    Ret(code: int)
}

/// `Ins`'s content identity, written HERE because the IR vocabulary
/// carries its own identity — the trait's exit for a type whose fold
/// the derive cannot serve. The arms mirror `@derive(Fingerprint)`'s
/// convention exactly: tag 1, the type's name, the variant's index,
/// then each payload folded by its SHAPE (`fp_list` for a list,
/// arity for an optional, the value's own `fingerprint()` for a
/// declared name). A new variant lands an arm here or the fold is
/// incomplete, which `make fingerprints` reads.
impl Ins {
    fn fingerprint() -> int {
        match self {
            .ConstInt(dst, v) -> derived([fp_str("Ins"), 0, dst.fingerprint(), v]),
            .ConstFloat(dst, bits) -> derived([fp_str("Ins"), 1, dst.fingerprint(), bits]),
            .ConstStr(dst, s) -> derived([fp_str("Ins"), 2, dst.fingerprint(), fp_str(s)]),
            .ConstBool(dst, v) -> derived([fp_str("Ins"), 3, dst.fingerprint(), (if v { 1 } else { 0 })]),
            .Bin(dst, op, a, b) -> derived([fp_str("Ins"), 4, dst.fingerprint(), op.fingerprint(), a.fingerprint(), b.fingerprint()]),
            .Un(dst, op, src) -> derived([fp_str("Ins"), 5, dst.fingerprint(), op.fingerprint(), src.fingerprint()]),
            .CallRtVoid(callee, args) -> derived([fp_str("Ins"), 6, fp_str(callee), fp_list([x.fingerprint() for x in args])]),
            .CallRt(dst, callee, args) -> derived([fp_str("Ins"), 7, dst.fingerprint(), fp_str(callee), fp_list([x.fingerprint() for x in args])]),
            .Pack(dst, elems) -> derived([fp_str("Ins"), 8, dst.fingerprint(), fp_list([x.fingerprint() for x in elems])]),
            .Extract(dst, src, at) -> derived([fp_str("Ins"), 9, dst.fingerprint(), src.fingerprint(), at]),
            .FnAddr(dst, sym) -> derived([fp_str("Ins"), 10, dst.fingerprint(), fp_str(sym)]),
            .StaticAddr(dst, sym) -> derived([fp_str("Ins"), 11, dst.fingerprint(), fp_str(sym)]),
            .ScopeEnter(tier) -> derived([fp_str("Ins"), 12, tier.fingerprint()]),
            .ScopeExit(gives) -> derived([fp_str("Ins"), 13, (if gives == null { derived([0]) } else { derived([1, gives!.fingerprint()]) })]),
            .IfStart(cond) -> derived([fp_str("Ins"), 14, cond.fingerprint()]),
            .SwitchStart(selector, cases) -> derived([fp_str("Ins"), 15, selector.fingerprint(), fp_list(cases)]),
            .ArmEnd(gives) -> derived([fp_str("Ins"), 16, gives.fingerprint()]),
            .RegionEnd(dst, gives) -> derived([fp_str("Ins"), 17, dst.fingerprint(), gives.fingerprint()]),
            .Call(dst, callee, args) -> derived([fp_str("Ins"), 18, dst.fingerprint(), fp_str(callee), fp_list([x.fingerprint() for x in args])]),
            .CallPtr(dst, f, args) -> derived([fp_str("Ins"), 19, dst.fingerprint(), f.fingerprint(), fp_list([x.fingerprint() for x in args])]),
            .RetVal(r) -> derived([fp_str("Ins"), 20, r.fingerprint()]),
            .FnExit(gives) -> derived([fp_str("Ins"), 21, gives.fingerprint()]),
            .Alloca(dst) -> derived([fp_str("Ins"), 22, dst.fingerprint()]),
            .Load(dst, slot) -> derived([fp_str("Ins"), 23, dst.fingerprint(), slot.fingerprint()]),
            .Store(slot, src) -> derived([fp_str("Ins"), 24, slot.fingerprint(), src.fingerprint()]),
            .LoopStart -> derived([fp_str("Ins"), 25]),
            .LoopCond(c) -> derived([fp_str("Ins"), 26, c.fingerprint()]),
            .LoopEnd -> derived([fp_str("Ins"), 27]),
            .Retain(r) -> derived([fp_str("Ins"), 28, r.fingerprint()]),
            .Release(r) -> derived([fp_str("Ins"), 29, r.fingerprint()]),
            .Ret(code) -> derived([fp_str("Ins"), 30, code]),
        }
    }
}

// ── Static data ─────────────────────────────────────────────────
// A value the compiler settled and the program only READS is laid
// out, not built: the lowering folds it into boxes of slots under
// its type, the backend emits the boxes as headered globals and the
// evaluator builds them once per run. ONE tree, two projections.

/// One slot of a static box — the word a cell holds before the
/// program runs.
export enum Slot {
    Int(v: int)
    Float(bits: int)
    Bool(v: bool)
    Text(s: string)
    /// The box at `at` in the same static, laid out BEFORE this one —
    /// a static reads child-first, so no slot points ahead.
    Box(at: int)
    /// The null pointer — a niche nullable's absence.
    Null
}

/// One box: a slot array, or a map's keys beside its values.
export enum StaticBox {
    Slots(cells: List<Slot>)
    Table(keys: List<string>, values: List<Slot>)
}

/// A settled aggregate as its boxes, the ROOT last — the address a
/// `StaticAddr` of this name answers.
/// One settled aggregate's layout: every box, child-first, under the static's
/// own name. `file` names the unit that first read it, so a per-file module
/// knows which of them it owns — a GROWTH, defaulted, so the existing
/// construction site is untouched.
export type Static = { name: string, boxes: List<StaticBox>, file: FileId? = null }

/// Which instructions BRACKET a region — kept beside the enum, like
/// every fact about it, so no consumer re-derives the list.
export fn opens_region(i: Ins) -> bool {
    i is .IfStart || i is .SwitchStart
}

export fn closes_region(i: Ins) -> bool {
    i is .RegionEnd
}

/// Register identity — two registers are one when their indexes
/// agree.
export fn same_reg(a: Reg, b: Reg) -> bool {
    // LICENSED I9: register identity, not type agreement — ids compare by index
    a.index == b.index
}

/// A slot in a runtime signature — the CallRt contract's currency,
/// and an extern seat's machine WIDTH.
///
/// A WIDTH IS A PROPERTY OF A SEAT, NOT OF A VALUE. Avra keeps one
/// integer; an extern's seat may name the width its C prototype
/// uses, and the value crossing is still an Avra `int` — the
/// compiler narrows at the argument and widens the answer with the
/// sign the width names. A width word is a type NOWHERE else.
///
/// APPEND-ONLY: a new kind goes at the END — the integer widths did,
/// then `F64` when a float VALUE arrived to construct it. `F32` is
/// the same edit again the day a seat needs it.
/// Nothing reads the ordinal today; the rule is here so that if
/// anything ever does, it inherits an order that never moved.
///
/// A new variant owes FOUR consumers, all in language/llvm.av, and
/// `make vocab` refuses a catch-all OR an `is .Variant` test at any
/// of them: `ll_rt_kind` (the LLVM type it becomes), `rt_arg` (how
/// an argument crosses), `answers_word` (whether an answer is a
/// pointer's word) and `answered` (the SIGN a narrow answer widens
/// with). An `is` test is a partial handler the compiler cannot see.
export enum RtKind { I64, Ptr, Void, I32, U32, F64 }

/// Where the interpreter HOSTS a runtime fn — one variant per host
/// body, so the interpreter's dispatch is exhaustive: a new row
/// names its host and the compiler demands the arm.
export enum RtHost {
    Puts
    Streq
    ArrayNew
    ArrayPush
    ArrayGet
    ArrayLen
    CellRelease
    CellUnique
    SlotUnique
    SlotSet
    MapNew
    MapLen
    MapHas
    MapGet
    MapSet
    StrJoin
    Insist
    InsistScalar
    Text
    /// The EVALUATOR's float rendering: it holds a float as bits,
    /// so it cannot reach `Text`'s double seat. A row of its own is
    /// what lets the memory pass know the text is MINTED — an extern
    /// that is not a row answers `owns_result: false` and leaks.
    FloatTextBits
    Strlen
    ArrayPop
    ArrayConcat
    ArraySlice
    StrContains
    StrStartsWith
    StrEndsWith
    StrIndexOf
    StrSubstring
    StrSplit
    StrReplace
    StrCharCode
    /// EIGHT BYTES AS ONE WORD — the digest's fold, whose C is one call where
    /// `StrCharCode` was eight. Its arm reads the same bytes, so eval == native.
    StrWordAt
    StrTrim
    StrConcat
    BytesLen
    BytesEq
    BytesAt
    BytesSlice
    BytesConcat
    BytesIndexOf
    BytesOfStr
    BytesOfList
    StrOfBytes
    Utf8BadAt
    BytesRun
    BytesEqAt
    BytesIeqAt
    BytesGathered
    /// The one door a FOREIGN buffer enters by: an address the program
    /// supplied and a length, copied into a box of ours.
    BytesAdopted
    FdRead
    FdTaken
    FdWrite
    /// The process substrate: one host arm per row, each a thin call
    /// into the same C the native program calls, so eval == native
    /// holds by construction.
    ErrnoText
    NowNs
    HostEnv
    Eputs
    IoList
    Embed
    StrFromCodepoint
    /// This image re-executed with new words. A ROW because its C
    /// reads an `AvraArray` — §2.1's line — and because a uniform
    /// frame cannot hand C a box the evaluator holds as a HANDLE. Its
    /// arm materialises the words on the interpreted side.
    ExecSelf
    /// A program run with its words and waited for. A ROW for the same
    /// two reasons as `ExecSelf`, and its words are resolved by the
    /// host exactly as `execv`'s are.
    SpawnStatus
    /// The same spawn, run IN a directory — a child writes its outputs relative to where
    /// it starts, so a batch handed to ONE invocation needs the directory as part of the
    /// request rather than as an accident of where the compiler happens to stand.
    SpawnIn
    /// The once cache — a pure fn's answer, settled for the run and
    /// keyed by the fn's own symbol.
    OnceGet
    OnceSet
    /// Reached by the backend only — an instruction or a Bin op
    /// covers it in the interpreter.
    Unhosted
}

/// One runtime fn's contract: its shape, whether its result is
/// OWNED (a fresh allocation the memory pass must release), whether
/// an OWNED TWIN (`<name>_owned`) exists for the memory pass to
/// substitute when the value stored or answered is managed, whether
/// it LENDS that answer, and its interpreter host.
///
/// `lends` is the memory pass's question and it is false by
/// default: a row LENDS when the subject STILL HOLDS the value it
/// answered, so the caller may borrow it instead of taking the
/// owned twin. A row that HANDS OVER — `avra_array_pop`, which
/// shrinks the list — must never be borrowed, and answering false
/// is the safe side for every row nobody has thought about.
///
/// `keeps[j]` says seat `j` OUTLIVES the call: the body takes its own
/// reference and stores it somewhere the callee owns, so the value
/// ESCAPES. It is the mirror of `lends`, which is about the ANSWER.
/// RETAINING IS NOT KEEPING — `avra_insist` retains its seat and
/// ANSWERS it, which is `owns_result` and hands the reference to the
/// caller; only a body that STORES what it retained keeps. Marking
/// the answering kind would make every `!` unwrap read as an escape.
/// Empty means the row keeps nothing, which is 82 of 86 rows.
///
/// `inert` says the C body reads its text as BYTES it was handed and
/// resolves nothing outside the program — no path, no name, no
/// command, no environment key, and no C-string call that stops at a
/// NUL. Only such a row may skip the crossing check.
///
/// THE DEFAULT IS CHECKED, and the polarity is the whole point: a row
/// nobody has thought about is checked, not exempt. An `exempt: false`
/// default would make forgetting the field the same as deciding it,
/// and the forgetting is silent. A package's extern can never be
/// inert — its C is not ours to certify.
///
/// `cells[j]` is the width of the CELL BEHIND an inout seat — never
/// the seat's own ABI kind, which is always `Ptr` because an inout
/// carries an address. `Void` means seat `j` is not an inout. Only
/// an extern fills it: the registry's own rows take addresses of
/// nothing.
/// What a runtime row REACHES: `Pure` answers from its arguments
/// alone, so a settlement may run it; `Embed` reads a file the BUILD
/// owns, beside the source, so a settlement may run it and records
/// the file; `World` reads or writes the process's world — io, time,
/// env, a child — and no compile-time evaluation may.
export enum Reach { Pure, Embed, World }

export type RtSig = { name: string, ret: RtKind, params: List<RtKind>, owns_result: bool, has_owned_twin: bool, host: RtHost, lends: bool = false, keeps: List<bool> = [], cells: List<RtKind> = [], reach: Reach = Reach.Pure, boxes: List<Box> = [], answer: Box = Box.Any, inert: bool = false }

/// WHICH BOX a `Ptr` seat takes — and, in `answer`, which box a `Ptr`
/// ANSWER hands back. A pointer says only that a header
/// stands there, and a text length read from a list's header is a
/// plausible number. `Text` is C's `const char*`; `List` and `Map`
/// are the runtime's own layouts; `Any` is a seat that takes every
/// box and means it (`avra_rc_retain`). A row that names no boxes
/// takes `Any` at every pointer seat — unconstrained, never wrongly
/// constrained. `Bytes` is octets: C's `const char*` too, but the row
/// reads the box's LENGTH from its header or a seat beside it, never
/// to a NUL — and the Avra seat that fills it is `Bytes`.
export enum Box {
    Any
    Text
    Bytes
    List
    Map
}

impl RtSig {
    /// The box the j-th seat takes.
    fn box_at(j: int) -> Box {
        if j < self.boxes.length { self.boxes[j] } else { Box.Any }
    }
}

// ── The role projections ──────────────────────────────────────────
// A DERIVE'S DECLARATION IS ITS MODULE'S, NOT ITS PACKAGE'S: a
// generated `export` does not reach the module surface, so each
// projection's BODY is derived off the payload roles above and its
// DOOR is written here. (`node_payload_rows` in core/nodes.av carries
// the same one-line door for `@derive(Grammar)`.)

/// The register an instruction DEFINES, when it defines one.
export fn dst_of(i: Ins) -> Reg? { dst_of_role(i) }

/// The registers a step READS — its operands, never its destination.
/// ONE definition of what an instruction consumes, so a pass asking
/// about a register's uses asks here. A slot is read by the step that
/// touches it: a Load reads its cell, a Store the cell and the value.
export fn reads_of(i: Ins) -> List<Reg> { reads_of_role(i) }

/// An AVRA CALL's argument registers — the seats `retained_args`
/// retains, and the only ones a conditional ABI could stop retaining.
/// A runtime row BORROWS its arguments, so its are not seats.
export fn seat_regs(i: Ins) -> List<Reg> { seat_regs_role(i) }

/// The register an instruction DEFINES that OWNS a reference when
/// its value is managed — the payload marked `@owns`. A destination
/// carrying only `@dst` owns NOTHING: a scalar's word, a cell, an
/// immortal static address. That absence is a role, not an omission.
export fn owned_dst(i: Ins) -> Reg? { owned_dst_role(i) }

/// The register that is a VIEW of another box — it rides a reference
/// somebody else holds and owns nothing of its own.
export fn viewed_dst(i: Ins) -> Reg? { viewed_dst_role(i) }

/// An AVRA CALL's argument registers, as the memory pass reads them: the
/// seats the caller LENDS. `@seats` is the structural claim (these are an
/// Avra call's arguments); `@lent` is the ABI claim (the caller keeps each
/// standing for the call, and holds a VIEW across it). A runtime row's
/// arguments are its own registry's, and are no seats here.
export fn lent_args(i: Ins) -> List<Reg> { lent_args_role(i) }

/// The symbol an AVRA call names, when it is a known body — a
/// `CallPtr` names none, so its seats can never be shown read-only.
export fn call_symbol(i: Ins) -> string? { call_symbol_role(i) }

/// THE USER BODY a step names — a call's callee, a fn value's
/// address. Runtime and host callees name no body of ours. Every
/// symbol a program's bodies name must be a body the program holds:
/// the emitter's closure law.
export fn body_symbol(i: Ins) -> string? { body_symbol_role(i) }

/// THE HOSTED FN a step calls — the runtime's rows and the program's
/// own externs share one call shape, so they share one projection.
/// Every name here must be a declared row.
export fn hosted_symbol(i: Ins) -> string? { hosted_symbol_role(i) }

/// THE SETTLED AGGREGATE a step takes the address of — the one global
/// a read looks up by name. Every such name must be a static the
/// program holds, and a module lays out exactly the ones its own
/// bodies name: the emitter's closure law, at the other end.
export fn static_symbol(i: Ins) -> string? {
    match i { .StaticAddr(_, sym) -> sym, rest -> null }
}

