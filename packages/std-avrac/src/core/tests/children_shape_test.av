// `@derive(Children)`: a variant's shape is the mark it wears, and a
// variant wearing none is refused naming the missing mark.
use @std.avrac.core.{Children, CompClause, Scoped, Expr, new_node_store}
use @std.meta.{Type, Variant, Field, Mark}

fn variant(name: string, words: List<string>, fields: List<Field>) -> Variant {
    Variant {
        name: name,
        payload: [f.ty for f in fields],
        at: null,
        fields: fields,
        marks: [Mark { name: w, args: [], at: null } for w in words],
    }
}

fn field(name: string, ty: string) -> Field { Field { name: name, ty: ty, at: null } }

fn enum_of(vs: List<Variant>) -> Type { Type { name: "Expr", fields: [], variants: vs, at: null } }

fn said(vs: List<Variant>) -> List<string> { [d.message for d in Children.derive(enum_of(vs)).problems] }

spec "core/children — a variant's shape is its mark" {
    given "the law a variant is held to" {
        then "a variant wearing no shape word is refused, named" {
            said([variant("A", ["apart"], []), variant("B", [], [])]).join("|") == "a node's children follow the mark its variant wears — `Expr.B` wears none"
        }
        then "`@clauses` without a clause list is refused, named" {
            said([variant("A", ["clauses"], [field("elem", "ExprId")])]).length == 1
        }
        then "`@clauses` with a clause list is accepted" {
            said(
                [
                    variant(
                        "A",
                        ["clauses"],
                        [field("elem", "ExprId"), field("clauses", "List<CompClause>")],
                    ),
                ],
            )
                .is_empty()
        }
        then "every shape word is accepted on its own" {
            said(
                [
                    variant("A", ["apart"], []),
                    variant("B", ["sequence"], [field("v", "ExprId")]),
                    variant("C", ["branches"], []),
                    variant("D", ["declares"], []),
                    variant("E", ["expands"], [field("view", "BodyView")]),
                ],
            )
                .is_empty()
        }
    }
    given "the walk the derive generates" {
        then "a `@clauses` variant reaches its element and each clause's source, in order" {
            mut s = new_node_store()
            let elem = s.alloc_expr(Expr.IntLit(1))
            let source = s.alloc_expr(Expr.IntLit(2))
            let hi = s.alloc_expr(Expr.IntLit(3))
            let cond = s.alloc_expr(Expr.IntLit(4))
            let made = s
                .alloc_expr(
                    Expr
                        .Comp(
                            elem,
                            [
                                CompClause.Head(null, Scoped("x"), source, hi),
                                CompClause.Filter(cond),
                            ],
                        ),
                )
            let kids = s.expr_children(made)
            ["${k.index}" for k in kids].join(" ") == "${elem.index} ${source.index} ${hi.index} ${cond.index}"
        }
    }
}
