// Attacks on the structural matcher, assuming it is broken: degenerate
// shapes, binders repeated more than twice, nesting through Pat and
// through a quote body, and a subject deeper than its pattern.
use @std.avrac.core.{
    new_node_store,
    SyntaxArena,
    Expr,
    Stmt,
    Pat,
    Arm,
    BinOp,
    BodyView,
    At,
    Shape,
    shape_at,
    matched,
    matched_runs,
    typed_node_shallow_at,
    ExprId,
}

spec "core/shape adversarial" {
    given "degenerate shapes" {
        then "a bare hole at the root matches any subject" {
            mut s = new_node_store()
            let h = s.alloc_expr(Expr.Ident("H"))
            let pat = shape_at(s, At.Expr(h), [At.Expr(h)])!
            let subj = s.alloc_expr(Expr.StrLit("anything"))
            let r = matched(s, At.Expr(subj), pat)
            r != null && r!.length == 1 && kid_is_expr(r![0], subj)
        }
        then "[] never matches a hole-bearing [H], and [H] never matches []" {
            mut s = new_node_store()
            let h = s.alloc_expr(Expr.Ident("H"))
            let one_hole_src = s.alloc_expr(Expr.ListLit([h]))
            let one_hole_pat = shape_at(s, At.Expr(one_hole_src), [At.Expr(h)])!
            let empty_src = s.alloc_expr(Expr.ListLit([]))
            let empty_pat = shape_at(s, At.Expr(empty_src), [])!
            let x = s.alloc_expr(Expr.IntLit(1))
            let one_elem_subj = s.alloc_expr(Expr.ListLit([x]))
            matched(s, At.Expr(empty_src), one_hole_pat) == null &&
                matched(s, At.Expr(one_elem_subj), empty_pat) == null
        }
        then "a hole under a hole: the outer absorbs its subtree, so the inner placeholder is never reached — refused, not silently dropped" {
            mut s = new_node_store()
            let inner = s.alloc_expr(Expr.Ident("inner"))
            let outer = s.alloc_expr(Expr.Not(inner))
            shape_at(s, At.Expr(outer), [At.Expr(outer), At.Expr(inner)]) == null
        }
    }
    given "repeated binders" {
        then "the same binder three times requires all three occurrences to share one subtree fingerprint" {
            mut s = new_node_store()
            let h = s.alloc_expr(Expr.Ident("H"))
            let triple_src = s.alloc_expr(Expr.ListLit([h, h, h]))
            let pat = shape_at(s, At.Expr(triple_src), [At.Expr(h)])!

            let a1 = s.alloc_expr(Expr.IntLit(1))
            let a2 = s.alloc_expr(Expr.IntLit(1))
            let a3 = s.alloc_expr(Expr.IntLit(1))
            let all_same = s.alloc_expr(Expr.ListLit([a1, a2, a3]))
            let r_same = matched(s, At.Expr(all_same), pat)

            let b = s.alloc_expr(Expr.IntLit(2))
            let last_differs = s.alloc_expr(Expr.ListLit([a1, a2, b]))
            let r_differs = matched(s, At.Expr(last_differs), pat)

            r_same != null && r_same!.length == 1 && r_differs == null
        }
        then "two arms with the same pats but different guard content are told apart by kids, not by shallow" {
            mut s = new_node_store()
            let w1 = s.alloc_pat(Pat.Wild)
            let true_guard = s.alloc_expr(Expr.BoolLit(true))
            let val1 = s.alloc_expr(Expr.IntLit(1))
            let subj_e = s.alloc_expr(Expr.IntLit(0))

            let w2 = s.alloc_pat(Pat.Wild)
            let false_guard = s.alloc_expr(Expr.BoolLit(false))
            let val2 = s.alloc_expr(Expr.IntLit(1))

            let arity_equal = s
                .shallow_expr(Expr.Match(subj_e, [Arm { pats: [w1], guard: true_guard, value: val1 }])) == s
                .shallow_expr(Expr.Match(subj_e, [Arm { pats: [w2], guard: false_guard, value: val2 }]))

            let true_arm_src = s
                .alloc_expr(Expr.Match(subj_e, [Arm { pats: [w1], guard: true_guard, value: val1 }]))
            let pat = shape_at(s, At.Expr(true_arm_src), [])!
            let false_arm = s
                .alloc_expr(Expr.Match(subj_e, [Arm { pats: [w2], guard: false_guard, value: val2 }]))
            let r = matched(s, At.Expr(false_arm), pat)

            arity_equal && r == null
        }
        then "a placeholder listed twice, then a fresh one after it, never produces a gap `matched` could trap on" {
            mut s = new_node_store()
            let h = s.alloc_expr(Expr.Ident("H"))
            let y = s.alloc_expr(Expr.Ident("Y"))
            let pat_src = s.alloc_expr(Expr.ListLit([h, y]))
            let pat = shape_at(s, At.Expr(pat_src), [At.Expr(h), At.Expr(h), At.Expr(y)])!

            let a = s.alloc_expr(Expr.IntLit(1))
            let b = s.alloc_expr(Expr.IntLit(2))
            let subj = s.alloc_expr(Expr.ListLit([a, b]))
            let r = matched(s, At.Expr(subj), pat)

            r != null && r!.length == 2 && kid_is_expr(r![0], a) && kid_is_expr(r![1], b)
        }
    }
    given "nesting" {
        then "a quote body's Verbatim statements are matched through kids, and arity still refuses an extra one" {
            mut s = new_node_store()
            let lit = s.alloc_expr(Expr.IntLit(1))
            let inner_stmt = s.alloc_stmt(Stmt.Discard(lit))
            let body_src = s
                .alloc_expr(Expr.Body("quote", ["", ""], [], BodyView.Verbatim([inner_stmt], [])))
            let pat = shape_at(s, At.Expr(body_src), [At.Stmt(inner_stmt)])!

            let lit2 = s.alloc_expr(Expr.IntLit(2))
            let inner_stmt2 = s.alloc_stmt(Stmt.Discard(lit2))
            let body_subj = s
                .alloc_expr(Expr.Body("quote", ["", ""], [], BodyView.Verbatim([inner_stmt2], [])))
            let r = matched(s, At.Expr(body_subj), pat)

            let extra_stmt = s.alloc_stmt(Stmt.Discard(lit2))
            let body_wrong = s
                .alloc_expr(
                    Expr
                        .Body("quote", ["", ""], [], BodyView.Verbatim([inner_stmt2, extra_stmt], [])),
                )
            let r_wrong = matched(s, At.Expr(body_wrong), pat)

            r != null && r!.length == 1 && kid_is_stmt(r![0], inner_stmt2) && r_wrong == null
        }
        then "a Pat subject with nested variants matches through every level, and a deep mismatch still misses" {
            mut s = new_node_store()
            let leaf_src = s.alloc_pat(Pat.Wild)
            let mid_src = s.alloc_pat(Pat.Variant("Inner", [leaf_src]))
            let outer_src = s.alloc_pat(Pat.Variant("Outer", [mid_src]))
            let pat = shape_at(s, At.Pat(outer_src), [])!

            let leaf_subj = s.alloc_pat(Pat.Wild)
            let mid_subj = s.alloc_pat(Pat.Variant("Inner", [leaf_subj]))
            let outer_subj = s.alloc_pat(Pat.Variant("Outer", [mid_subj]))
            let r_hit = matched(s, At.Pat(outer_subj), pat)

            let wrong_leaf = s.alloc_pat(Pat.Rest)
            let mid_wrong = s.alloc_pat(Pat.Variant("Inner", [wrong_leaf]))
            let outer_wrong = s.alloc_pat(Pat.Variant("Outer", [mid_wrong]))
            let r_miss = matched(s, At.Pat(outer_wrong), pat)

            r_hit != null && r_miss == null
        }
        then "a shallow hole pattern matches a subject far deeper than the pattern itself" {
            mut s = new_node_store()
            let h = s.alloc_expr(Expr.Ident("H"))
            let pat = shape_at(s, At.Expr(h), [At.Expr(h)])!
            let deep = deep_binary(s, 12)
            let r = matched(s, At.Expr(deep), pat)
            r != null && r!.length == 1 && kid_is_expr(r![0], deep)
        }
    }
    given "a subtree_fp collision — `aihhotaz`/`eepturoq` hash-collide under fp_str, ERRORS' avra-8sb5.45 pair" {
        then "the two strings really do collide, span-blind, at the SUBTREE level — the pre-filter a repeated binder trusts" {
            mut s = new_node_store()
            let a = s.alloc_expr(Expr.StrLit("aihhotaz"))
            let b = s.alloc_expr(Expr.StrLit("eepturoq"))
            s.subtree_fp(At.Expr(a)) == s.subtree_fp(At.Expr(b))
        }
        then "a repeated H binder is NOT fooled by it: the two colliding literals are DIFFERENT subtrees, and the match REFUSES" {
            mut s = new_node_store()
            let h = s.alloc_expr(Expr.Ident("H"))
            let pat_src = s.alloc_expr(Expr.ListLit([h, h]))
            let pat = shape_at(s, At.Expr(pat_src), [At.Expr(h)])!

            let a = s.alloc_expr(Expr.StrLit("aihhotaz"))
            let b = s.alloc_expr(Expr.StrLit("eepturoq"))
            let colliding_subj = s.alloc_expr(Expr.ListLit([a, b]))
            let r_colliding = matched(s, At.Expr(colliding_subj), pat)

            let a2 = s.alloc_expr(Expr.StrLit("aihhotaz"))
            let same_subj = s.alloc_expr(Expr.ListLit([a, a2]))
            let r_same = matched(s, At.Expr(same_subj), pat)

            r_colliding == null && r_same != null && r_same!.length == 1
        }
        then "the SAME hazard, over a Run binder's repeat (`bound_run`'s own `same_run`) — Shape.Run hand-built, since quote_pat.av's grammar is a different door than shape_at's" {
            mut s = new_node_store()

            // a Run-bearing node's own template is folded BLIND to the
            // field the Run occupies (`typed_node_shallow_at`), so its
            // actual element count never matters once a Run sits among
            // its kids.
            let inner_kids = [Shape.Run(0)]
            let inner_template = s.alloc_expr(Expr.ListLit([]))
            let inner_shape = Shape
                .TypedNode(typed_node_shallow_at(s, At.Expr(inner_template), inner_kids, []), inner_kids, [])

            let d1 = s.alloc_expr(Expr.IntLit(0))
            let d2 = s.alloc_expr(Expr.IntLit(0))
            let outer_template = s.alloc_expr(Expr.ListLit([d1, d2]))
            let outer_kids = [inner_shape, inner_shape]
            let pat = Shape
                .TypedNode(typed_node_shallow_at(s, At.Expr(outer_template), outer_kids, []), outer_kids, [])

            let a = s.alloc_expr(Expr.StrLit("aihhotaz"))
            let b = s.alloc_expr(Expr.StrLit("eepturoq"))
            let run1 = s.alloc_expr(Expr.ListLit([a]))
            let run2 = s.alloc_expr(Expr.ListLit([b]))
            let subj = s.alloc_expr(Expr.ListLit([run1, run2]))
            matched_runs(s, At.Expr(subj), pat) == null
        }
    }
    given "a node's kind alone" {
        then "two method calls of different names share a kind, never a shallow fold" {
            mut s = new_node_store()
            let x = s.alloc_expr(Expr.Ident("x"))
            let a = s.alloc_expr(Expr.MethodCall(x, "push", []))
            let b = s.alloc_expr(Expr.MethodCall(x, "pop", [x]))
            s.kind_at(At.Expr(a)) == s.kind_at(At.Expr(b)) &&
                s.shallow_at(At.Expr(a)) != s.shallow_at(At.Expr(b))
        }
        then "another variant is another kind" {
            mut s = new_node_store()
            let x = s.alloc_expr(Expr.Ident("x"))
            let call = s.alloc_expr(Expr.MethodCall(x, "push", []))
            s.kind_at(At.Expr(call)) != s.kind_at(At.Expr(x))
        }
    }
}

/// A right-nested `... + i + (i-1) + ... + 0` chain, `depth` levels
/// deep — a subject a shallow hole pattern must never need to open.
fn deep_binary(s: SyntaxArena, depth: int) -> ExprId {
    mut cur = s.alloc_expr(Expr.IntLit(0))
    mut i = 0
    while i < depth {
        let lit = s.alloc_expr(Expr.IntLit(i))
        cur = s.alloc_expr(Expr.Binary(BinOp.Add, cur, lit))
        i = i + 1
    }
    cur
}
