// A side column — a fact few nodes have — and a tail column — a fact every node has, held only for those nodes. Attacked where its table is
// made, where it grows past its slots, where nodes land on one slot, and where a fork and the store
// it was forked from each write after the fork.
use @std.avrac.core.{SideColumn, TailColumn, side_column, tail_column, tail_column_of}

/// Nodes `from` up to `to`, each read, comma-joined.
fn read(c: SideColumn<int>, from: int, to: int) -> string { ["${c.at(i)}" for i in from..to].join(",") }

spec "core/side_column" {
    given "a column nothing was set in" {
        then "every node reads absent" { read(side_column(7), 0, 4) == "7,7,7,7" }
        then "it holds no node" { side_column(7).indexes().is_empty() }
    }
    given "values set" {
        then "a node reads what it was set to, its neighbours absent" {
            let c = side_column(0)
            c.set_at(5, 50)
            read(c, 3, 8) == "0,0,50,0,0"
        }
        then "a node set again reads the last value, and is held once" {
            let c = side_column(0)
            c.set_at(2, 1)
            c.set_at(2, 9)
            c.at(2) == 9 && c.indexes().length == 1
        }
        then "past many growths every node reads its own value" {
            let c = side_column(0 - 1)
            for i in 0..5000 { c.set_at(i * 3, i) }
            [i for i in 0..5000 if c.at(i * 3) != i].is_empty() &&
                c.at(1) == 0 - 1 &&
                c.at(15001) == 0 - 1
        }
        then "nodes a slot count apart share a home slot and each keeps its own value" {
            let c = side_column(0)
            for k in 0..6 { c.set_at(k * 1024, k + 1) }
            read(c, 0, 1) == "1" && c.at(5 * 1024) == 6 && c.at(2048) == 3 && c.at(512) == 0
        }
        then "the held nodes are listed ascending, whatever order they were set in" {
            let c = side_column(0)
            for i in [9, 2, 7, 0, 4] { c.set_at(i, 1) }
            c.indexes().map((i) -> "${i}").join(",") == "0,2,4,7,9"
        }
        then "a cleared column reads absent everywhere and holds nothing" {
            let c = side_column(0)
            c.set_at(3, 3)
            c.clear()
            c.at(3) == 0 && c.indexes().is_empty()
        }
        then "remade replaces each held value and nothing else" {
            let c = side_column(0)
            c.set_at(1, 10)
            c.set_at(4, 40)
            c.remade((v) -> v + 1)
            read(c, 0, 6) == "0,11,0,0,41,0"
        }
    }
    given "a fork" {
        then "the fork reads what the column held when it was forked" {
            let c = side_column(0)
            c.set_at(1, 1)
            read(c.forked(), 0, 3) == "0,1,0"
        }
        then "a write to the fork, old node or new, never reaches the column" {
            let c = side_column(0)
            c.set_at(1, 1)
            let f = c.forked()
            f.set_at(1, 5)
            f.set_at(2, 6)
            for i in 100..200 { f.set_at(i, i) }
            read(c, 0, 3) == "0,1,0" &&
                c.at(150) == 0 &&
                f.at(150) == 150 &&
                read(f, 0, 3) == "0,5,6"
        }
        then "a write to the column after the fork never reaches the fork" {
            let c = side_column(0)
            c.set_at(1, 1)
            let f = c.forked()
            c.set_at(1, 7)
            c.set_at(2, 8)
            read(f, 0, 3) == "0,1,0" && read(c, 0, 3) == "0,7,8"
        }
        then "a fork of a column nothing was set in gets a table of its own on its first value" {
            let c = side_column(0)
            let f = c.forked()
            f.set_at(3, 3)
            c.at(3) == 0 && f.at(3) == 3
        }
    }
}

/// Every node's value in a tail column, comma-joined.
fn values(c: TailColumn<int>) -> string { ["${c.at(i)}" for i in 0..c.count()].join(",") }

/// A tail column holding 0 up to `n`.
fn counted(n: int) -> TailColumn<int> { tail_column_of([i for i in 0..n]) }

spec "core/tail_column" {
    given "a column" {
        then "each node reads what it was pushed" { values(counted(4)) == "0,1,2,3" }
        then "a node of a nullable column written again to none reads none, its neighbours as they were" {
            let c: TailColumn<int?> = tail_column()
            for i in 0..3 { c.push(i) }
            let f = c.forked()
            f.set_at(1, null)
            "${f.at(0) ?? 9},${f.at(1) ?? 9},${f.at(2) ?? 9} ${c.at(1) ?? 9}" == "0,9,2 1"
        }
        then "a node written again reads its new value" {
            let c = counted(4)
            c.set_at(2, 9)
            values(c) == "0,1,9,3"
        }
    }
    given "a fork" {
        then "reads what the column held, and its own nodes after them" {
            let f = counted(3).forked()
            f.push(7)
            values(f) == "0,1,2,7"
        }
        then "a fork's write, to an old node or its own, never reaches the column" {
            let c = counted(3)
            let f = c.forked()
            f.set_at(1, 5)
            f.push(8)
            f.set_at(3, 9)
            values(c) == "0,1,2" && values(f) == "0,5,2,9"
        }
        then "the column's writes after the fork never reach the fork" {
            let c = counted(3)
            let f = c.forked()
            c.set_at(0, 4)
            c.push(6)
            values(f) == "0,1,2" && values(c) == "4,1,2,6"
        }
        then "a fork of a fork reads every write the first fork made, and neither sees the other's after" {
            let c = counted(2)
            let f = c.forked()
            f.set_at(0, 3)
            f.push(4)
            let g = f.forked()
            g.set_at(1, 5)
            f.set_at(2, 6)
            values(g) == "3,5,4" && values(f) == "3,1,6" && values(c) == "0,1"
        }
    }
}
