// A FINGERPRINT'S PAYLOAD IS A FLAT LIST, so two sequences spliced
// into one carry a boundary that can MOVE: shifting an item from the
// first to the second leaves the same list, and two different nodes
// wear one identity. Every node kind splicing two sequences is
// attacked here by moving exactly one item across its boundary.
use @std.avrac.core.{Scoped, Plain, new_node_store, Expr, Stmt, Pat, Param, Variant, TypeRef, SeatMark, Mark, named_ref, plain_mark, GrammarSpec, BodyView}

fn written(name: string, optional: bool) -> TypeRef {
    named_ref(name) with { optional: optional }
}

fn seat(name: string, t: TypeRef?) -> Param {
    Param { name: Scoped(name), ty: t, default: null, promises: plain_mark }
}

fn seat_marked(name: string, t: TypeRef?, promises: SeatMark) -> Param {
    Param { name: Scoped(name), ty: t, default: null, promises: promises }
}

fn marked(name: string, args: List<string>) -> Mark {
    Mark { name: name, args: args }
}

fn marked_variant(name: string, payloads: List<Param>, marks: List<Mark>) -> Variant {
    Variant { name: Plain(name), payloads: payloads, marks: marks }
}

const mut_mark: SeatMark = SeatMark { mutable: true, settled: false }
const const_mark: SeatMark = SeatMark { mutable: false, settled: true }

spec "core/nodes adversarial" {
    given "a boundary between two spliced sequences" {
        then "a pinned type is not an argument — `f<A>(B)` vs `f<A, B?>()`" {
            mut s = new_node_store()
            let b = s.alloc_expr(Expr.Ident("B"), null)
            let arg = s.alloc_expr(Expr.Call("f", [written("A", false)], [b]), null)
            let pin = s.alloc_expr(Expr.Call("f", [written("A", false), written("B", true)], []), null)
            s.expr_fingerprint(arg) != s.expr_fingerprint(pin)
        }
        then "a module path is not an item list — `use a.b` vs `use a.{b}`" {
            mut s = new_node_store()
            let deep = s.alloc_stmt(Stmt.Use(["a", "b"], [], []), null)
            let item = s.alloc_stmt(Stmt.Use(["a"], ["b"], [""]), null)
            s.stmt_fingerprint(deep) != s.stmt_fingerprint(item)
        }
        then "a type parameter is not a value parameter" {
            mut s = new_node_store()
            let body = s.alloc_expr(Expr.IntLit(1), null)
            let t = seat("T", null)
            let x = seat("x", written("int", false))
            let split = s.alloc_stmt(Stmt.FnDecl("f", [t], [x], written("int", false), body), null)
            let both = s.alloc_stmt(Stmt.FnDecl("f", [t, x], [], written("int", false), body), null)
            s.stmt_fingerprint(split) != s.stmt_fingerprint(both)
        }
        then "a then-branch is not an else-branch — `if c { a b }` vs `if c { a } else { b }`" {
            mut s = new_node_store()
            let v = s.alloc_expr(Expr.IntLit(1), null)
            let c = s.alloc_expr(Expr.BoolLit(true), null)
            let a = s.alloc_stmt(Stmt.ExprStmt(v), null)
            let b = s.alloc_stmt(Stmt.ExprStmt(v), null)
            let fell = s.alloc_stmt(Stmt.IfStmt(c, [a, b], []), null)
            let split = s.alloc_stmt(Stmt.IfStmt(c, [a], [b]), null)
            s.stmt_fingerprint(fell) != s.stmt_fingerprint(split)
        }
        then "a map's keys are not its values" {
            mut s = new_node_store()
            let a = s.alloc_expr(Expr.IntLit(1), null)
            let b = s.alloc_expr(Expr.IntLit(2), null)
            let c = s.alloc_expr(Expr.IntLit(3), null)
            let l = s.alloc_expr(Expr.MapLit([a, b], [c]), null)
            let r = s.alloc_expr(Expr.MapLit([a], [b, c]), null)
            s.expr_fingerprint(l) != s.expr_fingerprint(r)
        }
        then "a `when`'s conditions are not its values" {
            mut s = new_node_store()
            let a = s.alloc_expr(Expr.IntLit(1), null)
            let b = s.alloc_expr(Expr.IntLit(2), null)
            let c = s.alloc_expr(Expr.IntLit(3), null)
            let f = s.alloc_expr(Expr.IntLit(4), null)
            let l = s.alloc_expr(Expr.When([a, b], [c], f), null)
            let r = s.alloc_expr(Expr.When([a], [b, c], f), null)
            s.expr_fingerprint(l) != s.expr_fingerprint(r)
        }
        then "a caught variant is not its bind" {
            mut s = new_node_store()
            let subject = s.alloc_expr(Expr.IntLit(1), null)
            let v = s.alloc_expr(Expr.IntLit(2), null)
            let l = s.alloc_expr(Expr.Catch(subject, [Plain("A"), Plain("B")], [Scoped("b")], [v]), null)
            let r = s.alloc_expr(Expr.Catch(subject, [Plain("A")], [Scoped("B"), Scoped("b")], [v]), null)
            s.expr_fingerprint(l) != s.expr_fingerprint(r)
        }
        then "a block's statements are not its tail" {
            mut s = new_node_store()
            let v = s.alloc_expr(Expr.IntLit(1), null)
            let a = s.alloc_stmt(Stmt.ExprStmt(v), null)
            let held = s.alloc_expr(Expr.Block([a], v), null)
            let left = s.alloc_expr(Expr.Block([a], null), null)
            s.expr_fingerprint(held) != s.expr_fingerprint(left)
        }
        then "an interpolation's text is not its holes" {
            mut s = new_node_store()
            let h = s.alloc_expr(Expr.IntLit(1), null)
            let l = s.alloc_expr(Expr.Body("text", ["a", "b"], [h], BodyView.None), null)
            let r = s.alloc_expr(Expr.Body("text", ["a"], [h, h], BodyView.None), null)
            s.expr_fingerprint(l) != s.expr_fingerprint(r)
        }
        then "a lambda's parameters are not its body" {
            mut s = new_node_store()
            let body = s.alloc_expr(Expr.IntLit(1), null)
            let l = s.alloc_expr(Expr.Lambda([seat("x", null)], body), null)
            let r = s.alloc_expr(Expr.Lambda([seat("x", null), seat("y", null)], body), null)
            s.expr_fingerprint(l) != s.expr_fingerprint(r)
        }
    }
    given "a tag shared by two node kinds" {
        then "a zero-payload pattern and expression cannot share one" {
            mut s = new_node_store()
            let rest = s.alloc_pat(Pat.Rest, null)
            let recv = s.alloc_expr(Expr.Receiver, null)
            s.pat_fingerprint(rest) != s.expr_fingerprint(recv)
        }
        then "a zero-payload pattern and statement cannot share one" {
            mut s = new_node_store()
            let wild = s.alloc_pat(Pat.Wild, null)
            let empty_use = s.alloc_stmt(Stmt.Use([], [], []), null)
            s.pat_fingerprint(wild) != s.stmt_fingerprint(empty_use)
        }
        then "a written type and an expression cannot share one — `f<B?>()` vs `f(B)`" {
            mut s = new_node_store()
            // A nullable type read as `fp(2, [fp_str("B")])` and `.Ident("B")`
            // read the same: one is a PIN, the other an ARGUMENT.
            let ident = s.alloc_expr(Expr.Ident("B"), null)
            let pinned = s.alloc_expr(Expr.Call("f", [written("B", true)], []), null)
            let passed = s.alloc_expr(Expr.Call("f", [], [ident]), null)
            s.expr_fingerprint(pinned) != s.expr_fingerprint(passed)
        }
    }
    given "a marker word is part of a declaration's identity" {
        then "plain, `mut`, `once`, `static` and a grammar mark are five fingerprints" {
            mut s = new_node_store()
            let body = s.alloc_expr(Expr.IntLit(1), null)
            let plain = s.alloc_stmt(Stmt.FnDecl("f", [], [], written("int", false), body), null)
            let writes = s.alloc_stmt(Stmt.FnDecl("f", [], [], written("int", false), body), null)
            let single = s.alloc_stmt(Stmt.FnDecl("f", [], [], written("int", false), body), null)
            let fixed = s.alloc_stmt(Stmt.FnDecl("f", [], [], written("int", false), body), null)
            let read = s.alloc_stmt(Stmt.FnDecl("f", [], [], written("int", false), body), null)
            s.mark_mutating(writes)
            s.mark_once(single)
            s.mark_static(fixed)
            s.mark_grammar(read, GrammarSpec { head: "", parts: [] })
            let a = s.stmt_fingerprint(plain)
            let b = s.stmt_fingerprint(writes)
            let c = s.stmt_fingerprint(single)
            let d = s.stmt_fingerprint(fixed)
            let e = s.stmt_fingerprint(read)
            a != b && a != c && a != d && a != e && b != c && b != d && b != e && c != d && c != e && d != e
        }
    }
    given "a payload the fingerprint must not forget" {
        then "`export fn` is not `fn`" {
            mut s = new_node_store()
            let body = s.alloc_expr(Expr.IntLit(1), null)
            let unmarked = s.alloc_stmt(Stmt.FnDecl("f", [], [], written("int", false), body), null)
            let shown = s.alloc_stmt(Stmt.FnDecl("f", [], [], written("int", false), body), null)
            s.mark_exported(shown)
            s.stmt_fingerprint(unmarked) != s.stmt_fingerprint(shown)
        }
        then "a `mut` seat is not a plain seat" {
            mut s = new_node_store()
            let body = s.alloc_expr(Expr.IntLit(1), null)
            let t = written("int", false)
            let unmarked = s.alloc_stmt(Stmt.FnDecl("f", [], [seat("x", t)], t, body), null)
            let writes = s.alloc_stmt(Stmt.FnDecl("f", [], [seat_marked("x", t, mut_mark)], t, body), null)
            s.stmt_fingerprint(unmarked) != s.stmt_fingerprint(writes)
        }
        then "a `const` seat is not a plain seat" {
            mut s = new_node_store()
            let body = s.alloc_expr(Expr.IntLit(1), null)
            let t = written("int", false)
            let unmarked = s.alloc_stmt(Stmt.FnDecl("f", [], [seat("x", t)], t, body), null)
            let settled = s.alloc_stmt(Stmt.FnDecl("f", [], [seat_marked("x", t, const_mark)], t, body), null)
            s.stmt_fingerprint(unmarked) != s.stmt_fingerprint(settled)
        }
        then "a field's default belongs to its field" {
            mut s = new_node_store()
            let one = s.alloc_expr(Expr.IntLit(1), null)
            let t = written("int", false)
            let a_def = Param { name: "a", ty: t, default: one, promises: plain_mark }
            let b_def = Param { name: "b", ty: t, default: one, promises: plain_mark }
            let first = s.alloc_stmt(Stmt.StructDecl("S", [], [a_def, seat("b", t)]), null)
            let second = s.alloc_stmt(Stmt.StructDecl("S", [], [seat("a", t), b_def]), null)
            s.stmt_fingerprint(first) != s.stmt_fingerprint(second)
        }
        then "`dyn Show` is not `Show`" {
            mut s = new_node_store()
            let v = s.alloc_expr(Expr.IntLit(1), null)
            let unmarked = s.alloc_stmt(Stmt.Let("x", named_ref("Show"), v), null)
            let boxed = s.alloc_stmt(Stmt.Let("x", named_ref("Show") with { dynamic: true }, v), null)
            s.stmt_fingerprint(unmarked) != s.stmt_fingerprint(boxed)
        }
        then "a marked variant is not a plain one" {
            mut s = new_node_store()
            let t = written("int", false)
            let plain = s.alloc_stmt(Stmt.EnumDecl("E", [], [marked_variant("A", [seat("x", t)], [])]), null)
            let held = s.alloc_stmt(Stmt.EnumDecl("E", [], [marked_variant("A", [seat("x", t)], [marked("frozen", [])])]), null)
            s.stmt_fingerprint(plain) != s.stmt_fingerprint(held)
        }
        then "a marked field is not a plain one" {
            mut s = new_node_store()
            let t = written("int", false)
            let plain = s.alloc_stmt(Stmt.StructDecl("S", [], [seat("a", t)]), null)
            let held = s.alloc_stmt(Stmt.StructDecl("S", [], [seat("a", t) with { marks: [marked("excluded", [])] }]), null)
            s.stmt_fingerprint(plain) != s.stmt_fingerprint(held)
        }
        then "a mark's WORDS are part of it — `@by(a)` is not `@by(b)`" {
            mut s = new_node_store()
            let t = written("int", false)
            let by_a = s.alloc_stmt(Stmt.EnumDecl("E", [], [marked_variant("A", [seat("x", t)], [marked("by", ["a"])])]), null)
            let by_b = s.alloc_stmt(Stmt.EnumDecl("E", [], [marked_variant("A", [seat("x", t)], [marked("by", ["b"])])]), null)
            s.stmt_fingerprint(by_a) != s.stmt_fingerprint(by_b)
        }
        then "a mark's arguments do not splice into the mark run — `@a(x)` is not `@a @x`" {
            mut s = new_node_store()
            let t = written("int", false)
            let with_arg = s.alloc_stmt(Stmt.EnumDecl("E", [], [marked_variant("A", [seat("x", t)], [marked("a", ["x"])])]), null)
            let two = s.alloc_stmt(Stmt.EnumDecl("E", [], [marked_variant("A", [seat("x", t)], [marked("a", []), marked("x", [])])]), null)
            s.stmt_fingerprint(with_arg) != s.stmt_fingerprint(two)
        }
        then "a variant's marks are not its payload's" {
            mut s = new_node_store()
            let t = written("int", false)
            let m = marked("dst", [])
            let on_variant = s.alloc_stmt(Stmt.EnumDecl("E", [], [marked_variant("A", [seat("x", t)], [m])]), null)
            let on_payload = s.alloc_stmt(Stmt.EnumDecl("E", [], [marked_variant("A", [seat("x", t) with { marks: [m] }], [])]), null)
            s.stmt_fingerprint(on_variant) != s.stmt_fingerprint(on_payload)
        }
        then "a fn type's seat marks ride its identity" {
            mut s = new_node_store()
            let v = s.alloc_expr(Expr.IntLit(1), null)
            let t = written("int", false)
            let unmarked = named_ref("fn") with { args: [t, t], arrow: true, marks: [plain_mark, plain_mark] }
            let writes = unmarked with { marks: [mut_mark, plain_mark] }
            let a = s.alloc_stmt(Stmt.Let("f", unmarked, v), null)
            let b = s.alloc_stmt(Stmt.Let("f", writes, v), null)
            s.stmt_fingerprint(a) != s.stmt_fingerprint(b)
        }
    }
}
