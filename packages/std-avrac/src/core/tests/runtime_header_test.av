// The rows' claim on the C: every row states one, in its own kind's
// currency. The C compiler holds the claim; these hold its SHAPE, so
// a row that stops being asserted fails here rather than passing
// silently in a header nobody reads.
use @std.avrac.core.{rt_sigs, RtSig, RtKind, RtHost, runtime_header, row_claim}

/// A row's claim is present when its call stands inside an assertion —
/// compared to a named C type, or asked for its pointer shape.
fn claimed(h: string, r: RtSig) -> bool {
    h.contains("__typeof__(${r.name}(") || h.contains("__builtin_classify_type(${r.name}(")
}

spec "core/runtime_header" {
    given "the generated header" {
        then "it opens and closes one include guard" {
            let h = runtime_header()
            h.contains("#ifndef AVRA_RT_H") && h.contains("#define AVRA_RT_H") && h.ends_with("#endif")
        }
        then "every row claims a C body" {
            let h = runtime_header()
            rt_sigs().all(claimed(h, it))
        }
        then "one assertion per row, and no more" {
            runtime_header().split("_Static_assert").length == rt_sigs().length + 1
        }
    }
    given "an answer whose kind names a C type" {
        then "the claim compares that type exactly" {
            runtime_header().contains("_Static_assert(__builtin_types_compatible_p(__typeof__(avra_streq(AVRA_RT_PTR, AVRA_RT_PTR)), int64_t)")
        }
        then "a void answer is compared too — nothing to read is its own defect" {
            runtime_header().contains("_Static_assert(__builtin_types_compatible_p(__typeof__(avra_puts(AVRA_RT_PTR)), void)")
        }
    }
    given "a pointer answer, which names no one C type" {
        // the runtime spells its own `const char*` and `void*`, and
        // neither is a width — the SHAPE is what the row claims
        then "the claim asks for the pointer class" {
            runtime_header().contains("_Static_assert(__builtin_classify_type(avra_array_new()) == AVRA_RT_POINTER,")
        }
    }
    given "the seat probes" {
        then "a word seat is probed with a word and a pointer seat with a pointer" {
            runtime_header().contains("avra_array_push(AVRA_RT_PTR, AVRA_RT_I64)")
        }
        then "a float seat is probed with a double" {
            runtime_header().contains("avra_float_text(AVRA_RT_F64)")
        }
        // `((int64_t)0)` is an integer constant expression of value
        // zero, which C reads as a NULL POINTER CONSTANT: it fills a
        // pointer seat silently, and the check that a word cannot
        // would have passed on every row while holding nothing.
        then "no probe is the empty value" {
            let h = runtime_header()
            h.contains("#define AVRA_RT_PTR ((void*)1)") && h.contains("#define AVRA_RT_I64 ((int64_t)1)")
        }
    }
}

/// A row of any shape, so every kind is witnessed in both positions.
/// THE REGISTRY'S OWN ROWS ARE WORDS AND POINTERS, so the widths are
/// arms nothing else reaches — an arm no row exercises is an untested
/// instrument, and its first widening would be its first real test.
fn probe_row(ret: RtKind, params: List<RtKind>) -> RtSig {
    RtSig { name: "probe", ret: ret, params: params, owns_result: false, has_owned_twin: false, host: RtHost.Unhosted }
}

spec "core/runtime_header — every kind" {
    given "an answer of each kind" {
        then "a word compares to its exact C type" {
            row_claim(probe_row(RtKind.I64, [])).contains("__typeof__(probe()), int64_t)")
        }
        then "the narrow widths name theirs, though no row carries one yet" {
            row_claim(probe_row(RtKind.I32, [])).contains("__typeof__(probe()), int32_t)") &&
                row_claim(probe_row(RtKind.U32, [])).contains("__typeof__(probe()), uint32_t)")
        }
        then "a float compares to double" {
            row_claim(probe_row(RtKind.F64, [])).contains("__typeof__(probe()), double)")
        }
        then "nothing answered compares to void" {
            row_claim(probe_row(RtKind.Void, [])).contains("__typeof__(probe()), void)")
        }
        then "a pointer is asked for its shape, having no one C type" {
            row_claim(probe_row(RtKind.Ptr, [])).contains("__builtin_classify_type(probe()) == AVRA_RT_POINTER")
        }
    }
    given "a seat of each kind" {
        then "each is probed with a value of its own kind" {
            row_claim(probe_row(RtKind.Void, [RtKind.Ptr, RtKind.I64, RtKind.I32, RtKind.U32, RtKind.F64]))
                .contains("probe(AVRA_RT_PTR, AVRA_RT_I64, AVRA_RT_I32, AVRA_RT_U32, AVRA_RT_F64)")
        }
        // a seat cannot be void; the claim names the defect rather
        // than spelling a value C has none of
        then "a void seat stops at a name the header never defines" {
            row_claim(probe_row(RtKind.I64, [RtKind.Void])).contains("probe(AVRA_RT_VOID_SEAT)")
        }
    }
    given "the words a refusal says" {
        then "each kind says its own" {
            row_claim(probe_row(RtKind.I32, [])).contains("its row answers i32, so its C body answers int32_t") &&
                row_claim(probe_row(RtKind.Ptr, [])).contains("its row answers ptr, so its C body answers a pointer")
        }
    }
}
