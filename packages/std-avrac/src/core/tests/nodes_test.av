// The arena contract: sequential opaque ids, spans in side tables,
// and content identity that sees structure only — never spans.
use @std.avrac.core.{Span, new_node_store, Expr, Stmt, BinOp, Param, TypeRef, Variant}

fn at(lo: int, hi: int) -> Span? { Span { lo: lo, hi: hi } }

/// A written type, as the parser would hand it over.
fn ty(name: string, optional: bool) -> TypeRef {
    TypeRef { name: name, args: [], optional: optional, dynamic: false, arrow: false, span: null }
}

/// One param carrying a written type.
fn param(name: string, t: TypeRef?) -> Param {
    Param { name: name, ty: t }
}

/// One variant: unit when `t` is absent, else carrying one payload.
fn variant(name: string, t: TypeRef?) -> Variant {
    if t == null { return Variant { name: name, payloads: [] } }
    Variant { name: name, payloads: [param("", t)] }
}

spec "core/nodes" {
    given "an empty store" {
        then "allocation returns sequential ids and round-trips" {
            let s = new_node_store()
            let a = s.alloc_expr(Expr.IntLit(1), at(0, 1))
            let b = s.alloc_expr(Expr.Ident("x"), at(2, 3))
            let same = match s.expr(b) { .Ident(n) -> n == "x", _ -> false }
            // LICENSED I9: arena identity is what this test asserts
            a.index == 0 && b.index == 1 && s.exprs.count() == 2 && same
        }
        then "spans live in the side table; synthesized nodes have none" {
            let s = new_node_store()
            let a = s.alloc_expr(Expr.IntLit(1), at(4, 5))
            let ghost = s.alloc_expr(Expr.Error, null)
            s.expr_span(a)?.lo == 4 && s.expr_span(ghost) == null
        }
    }
    given "content fingerprints" {
        then "same content means same fingerprint, despite distinct ids and spans" {
            let s = new_node_store()
            let a = s.alloc_expr(Expr.IntLit(42), at(0, 2))
            let b = s.alloc_expr(Expr.IntLit(42), at(9, 11))
            // LICENSED I9: arena identity is what this test asserts
            a.index != b.index && s.expr_fingerprint(a) == s.expr_fingerprint(b)
        }
        then "negative payloads fingerprint deterministically" {
            let s = new_node_store()
            let a = s.alloc_expr(Expr.IntLit(0 - 42), null)
            let b = s.alloc_expr(Expr.IntLit(0 - 42), null)
            let c = s.alloc_expr(Expr.IntLit(42), null)
            s.expr_fingerprint(a) == s.expr_fingerprint(b) &&
                s.expr_fingerprint(a) != s.expr_fingerprint(c)
        }
        then "different content means different fingerprints" {
            let s = new_node_store()
            let a = s.alloc_expr(Expr.IntLit(1), null)
            let b = s.alloc_expr(Expr.IntLit(2), null)
            let c = s.alloc_expr(Expr.Ident("1"), null)
            s.expr_fingerprint(a) != s.expr_fingerprint(b) &&
                s.expr_fingerprint(a) != s.expr_fingerprint(c)
        }
        then "the LINK is part of identity: `a?.b` and `a.b` differ" {
            let s = new_node_store()
            let subject = s.alloc_expr(Expr.Ident("a"), null)
            let read = s.alloc_expr(Expr.Prop(subject, "b"), null)
            let chain = s.alloc_expr(Expr.Chain(subject, "b"), null)
            s.expr_fingerprint(read) != s.expr_fingerprint(chain)
        }
        then "the chain's MEMBER is part of identity" {
            let s = new_node_store()
            let subject = s.alloc_expr(Expr.Ident("a"), null)
            let b = s.alloc_expr(Expr.Chain(subject, "b"), null)
            let c = s.alloc_expr(Expr.Chain(subject, "c"), null)
            s.expr_fingerprint(b) != s.expr_fingerprint(c)
        }
        then "a nullable match records MEANING — the written arm order never counts" {
            let s = new_node_store()
            let subject = s.alloc_expr(Expr.Ident("v"), null)
            let present = s.alloc_expr(Expr.IntLit(1), null)
            let absent = s.alloc_expr(Expr.IntLit(2), null)
            // both writings build the SAME node shape (the builder
            // hands captures by meaning), so identity follows
            let a = s.alloc_expr(Expr.MatchOpt(subject, "x", present, absent), at(0, 9))
            let b = s.alloc_expr(Expr.MatchOpt(subject, "x", present, absent), at(20, 29))
            s.expr_fingerprint(a) == s.expr_fingerprint(b)
        }
        then "a WRITTEN TYPE is part of identity: `int` and `int?` differ" {
            let s = new_node_store()
            let body = s.alloc_expr(Expr.IntLit(1), null)
            let plain = param("x", ty("int", false))
            let opt = param("x", ty("int", true))
            let a = s.alloc_stmt(Stmt.FnDecl("f", [], [plain], ty("int", false), body), null)
            let b = s.alloc_stmt(Stmt.FnDecl("f", [], [opt], ty("int", false), body), null)
            s.stmt_fingerprint(a) != s.stmt_fingerprint(b)
        }
        then "a nullable RETURN differs from its guarantee" {
            let s = new_node_store()
            let body = s.alloc_expr(Expr.IntLit(1), null)
            let p = param("x", ty("int", false))
            let a = s.alloc_stmt(Stmt.FnDecl("f", [], [p], ty("int", false), body), null)
            let b = s.alloc_stmt(Stmt.FnDecl("f", [], [p], ty("int", true), body), null)
            s.stmt_fingerprint(a) != s.stmt_fingerprint(b)
        }
        then "an ABSENT type differs from every written one" {
            let s = new_node_store()
            let unit = s.alloc_stmt(Stmt.EnumDecl("E", [], [variant("a", null)]), null)
            let carrying = s.alloc_stmt(Stmt.EnumDecl("E", [], [variant("a", ty("int", false))]), null)
            let nullable = s.alloc_stmt(Stmt.EnumDecl("E", [], [variant("a", ty("int", true))]), null)
            s.stmt_fingerprint(unit) != s.stmt_fingerprint(carrying) &&
                s.stmt_fingerprint(unit) != s.stmt_fingerprint(nullable) &&
                s.stmt_fingerprint(carrying) != s.stmt_fingerprint(nullable)
        }
        then "a field's written type is part of the record's identity" {
            let s = new_node_store()
            let a = s.alloc_stmt(Stmt.StructDecl("P", [], [param("x", ty("int", false))]), null)
            let b = s.alloc_stmt(Stmt.StructDecl("P", [], [param("x", ty("int", true))]), null)
            let c = s.alloc_stmt(Stmt.StructDecl("P", [], [param("x", ty("bool", false))]), null)
            s.stmt_fingerprint(a) != s.stmt_fingerprint(b) &&
                s.stmt_fingerprint(a) != s.stmt_fingerprint(c)
        }
        then "an APPLICATION is part of identity: `List<int>` vs `int`" {
            let s = new_node_store()
            let body = s.alloc_expr(Expr.IntLit(1), null)
            let plain = param("x", ty("int", false))
            let applied = TypeRef { name: "List", args: [ty("int", false)], optional: false, dynamic: false, arrow: false, span: null }
            let a = s.alloc_stmt(Stmt.FnDecl("f", [], [plain], ty("int", false), body), null)
            let b = s.alloc_stmt(Stmt.FnDecl("f", [], [param("x", applied)], ty("int", false), body), null)
            s.stmt_fingerprint(a) != s.stmt_fingerprint(b)
        }
        then "the ELEMENT is part of identity: `List<int>` vs `List<bool>`" {
            let s = new_node_store()
            let body = s.alloc_expr(Expr.IntLit(1), null)
            let li = TypeRef { name: "List", args: [ty("int", false)], optional: false, dynamic: false, arrow: false, span: null }
            let lb = TypeRef { name: "List", args: [ty("bool", false)], optional: false, dynamic: false, arrow: false, span: null }
            let a = s.alloc_stmt(Stmt.FnDecl("f", [], [param("x", li)], ty("int", false), body), null)
            let b = s.alloc_stmt(Stmt.FnDecl("f", [], [param("x", lb)], ty("int", false), body), null)
            s.stmt_fingerprint(a) != s.stmt_fingerprint(b)
        }
        then "NESTING is part of identity: `List<int>` vs `List<List<int>>`" {
            let s = new_node_store()
            let body = s.alloc_expr(Expr.IntLit(1), null)
            let li = TypeRef { name: "List", args: [ty("int", false)], optional: false, dynamic: false, arrow: false, span: null }
            let ll = TypeRef { name: "List", args: [li], optional: false, dynamic: false, arrow: false, span: null }
            let a = s.alloc_stmt(Stmt.FnDecl("f", [], [param("x", li)], ty("int", false), body), null)
            let b = s.alloc_stmt(Stmt.FnDecl("f", [], [param("x", ll)], ty("int", false), body), null)
            s.stmt_fingerprint(a) != s.stmt_fingerprint(b)
        }
        then "two spellings of one type still agree — spans never count" {
            let s = new_node_store()
            let here = TypeRef { name: "int", args: [], optional: true, dynamic: false, arrow: false, span: at(0, 4) }
            let there = TypeRef { name: "int", args: [], optional: true, dynamic: false, arrow: false, span: at(90, 94) }
            let a = s.alloc_stmt(Stmt.StructDecl("P", [], [param("x", here)]), null)
            let b = s.alloc_stmt(Stmt.StructDecl("P", [], [param("x", there)]), null)
            s.stmt_fingerprint(a) == s.stmt_fingerprint(b)
        }
        then "a parent's fingerprint sees its children's" {
            let s = new_node_store()
            let one = s.alloc_expr(Expr.IntLit(1), null)
            let two = s.alloc_expr(Expr.IntLit(2), null)
            let x = s.alloc_expr(Expr.Ident("x"), null)
            let p = s.alloc_expr(Expr.Binary(BinOp.Add, one, two), null)
            let q = s.alloc_expr(Expr.Binary(BinOp.Add, one, x), null)
            let r = s.alloc_expr(Expr.Binary(BinOp.Sub, one, two), null)
            s.expr_fingerprint(p) != s.expr_fingerprint(q) &&
                s.expr_fingerprint(p) != s.expr_fingerprint(r)
        }
        then "statements fingerprint through their expressions" {
            let s = new_node_store()
            let one = s.alloc_expr(Expr.IntLit(1), null)
            let a = s.alloc_stmt(Stmt.Let("x", null, one), at(0, 9))
            let b = s.alloc_stmt(Stmt.Let("x", null, one), null)
            let c = s.alloc_stmt(Stmt.Let("y", null, one), null)
            s.stmt_fingerprint(a) == s.stmt_fingerprint(b) &&
                s.stmt_fingerprint(a) != s.stmt_fingerprint(c)
        }
    }
}
