// Edit distance and nearest-candidate: the numbers Axis 20.3's
// confidence tiers hang from.
use @std.avrac.core.{edit_distance, closest, quoted_text}

spec "core/text" {
    given "edit distance" {
        then "identity is zero, single edits are one, the classic is three" {
            edit_distance("x", "x") == 0 && edit_distance("y", "x") == 1 &&
                edit_distance("vlaue", "value") == 2 &&
                edit_distance("kitten", "sitting") == 3
        }
        then "empty strings measure the other's length" {
            edit_distance("", "abc") == 3 && edit_distance("ab", "") == 2
        }
    }
    given "closest" {
        then "the nearest candidate within two wins" {
            let c = closest("vlaue", ["alpha", "value"])
            c != null && c!.name == "value" && c!.distance == 2
        }
        then "an exact match is not a suggestion" {
            closest("x", ["x"]) == null
        }
        then "beyond distance two there is nothing" {
            closest("zz", ["alpha"]) == null
        }
    }
    given "source quoting" {
        then "a dollar-brace stays text when parsed again" {
            quoted_text("a \${hole} b") == "\"a \\\${hole} b\""
        }
    }
}
