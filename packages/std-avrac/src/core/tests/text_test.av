// Edit distance and nearest-candidate: the numbers Axis 20.3's
// confidence tiers hang from.
use @std.avrac.core.{
    wire_fields,
    edit_distance,
    closest,
    quoted_text,
    tuple_before,
    sorted_by,
    sorted_texts,
    text_before,
}

spec "core/text" {
    given "a joined record's fields" {
        then "an empty line is one empty field" { wire_fields("", ",").length == 1 && wire_fields("", ",")[0] == "" }
        then "a lone separator is two empty fields" { wire_fields(",", ",").length == 2 }
        then "an empty last field is kept" { wire_fields("a,", ",").length == 2 && wire_fields("a,", ",")[1] == "" }
        then "two empty last fields are both kept" { wire_fields("a,,", ",").length == 3 }
        then "a leading empty field is kept" { wire_fields(",a", ",").length == 2 && wire_fields(",a", ",")[0] == "" }
        then "a line with no separator is one field" { wire_fields("abc", ",").length == 1 && wire_fields("abc", ",")[0] == "abc" }
    }
    given "ordering tuples of text" {
        then "(\"a.b\", \"c\") and (\"a\", \"b.c\") are two keys, never one" {
            tuple_before(["a", "b.c"], ["a.b", "c"]) && !tuple_before(["a.b", "c"], ["a", "b.c"])
        }
        then "a tie is before neither way" {
            !tuple_before(["a", "b"], ["a", "b"])
        }
        then "a tuple sorts before its own extension" {
            tuple_before(["a"], ["a", "b"]) && !tuple_before(["a", "b"], ["a"])
        }
    }
    given "a stable sort" {
        then "equals keep the order they came in" {
            let pairs = [["b", "1"], ["a", "2"], ["b", "3"], ["a", "4"]]
            let firsts = (x: List<string>, y: List<string>) -> text_before(x[0], y[0])
            [p[1] for p in sorted_by(pairs, firsts)].join("") == "2413"
        }
        then "sorted_texts is byte order" {
            sorted_texts(["b", "a", "c"]).join("") == "abc"
        }
    }
    given "edit distance" {
        then "identity is zero, single edits are one, the classic is three" {
            edit_distance("x", "x") == 0 &&
                edit_distance("y", "x") == 1 &&
                edit_distance("vlaue", "value") == 2 &&
                edit_distance("kitten", "sitting") == 3
        }
        then "empty strings measure the other's length" {
            edit_distance("", "abc") == 3 && edit_distance("ab", "") == 2
        }
    }
    given "closest" {
        then "the nearest candidate within two wins" {
            let c = closest("vlaue", ["alpha", "value"])
            c != null && c!.name == "value" && c!.distance == 2
        }
        then "an exact match is not a suggestion" {
            closest("x", ["x"]) == null
        }
        then "beyond distance two there is nothing" {
            closest("zz", ["alpha"]) == null
        }
    }
    given "source quoting" {
        then "a dollar-brace stays text when parsed again" {
            quoted_text("a \${hole} b") == "\"a \\\${hole} b\""
        }
    }
}
