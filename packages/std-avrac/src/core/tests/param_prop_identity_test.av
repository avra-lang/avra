// A parameter's identity folds every field it wrote, so a head param the compiler
// made a prop and the same declaration without that mark are different statements.
use @std.avrac.core.{Param, Scoped, new_node_store, plain_mark}

fn head(prop: bool) -> int {
    let store = new_node_store()
    let seat = Param {
        name: Scoped("p"),
        ty: null,
        default: null,
        promises: plain_mark,
        id: store.alloc_param_id(null),
        prop: prop,
    }
    seat.identity(store)
}

spec "core/param — a prop is part of a parameter's identity" {
    given "two heads that differ only in being a prop" {
        then "their identities differ" { head(true) != head(false) }
    }
    given "the same head twice" {
        then "its identity is the same" { head(false) == head(false) && head(true) == head(true) }
    }
}
