// A plain record is a build's target too: `ParamSyntax` answers one payload
// row under the `Record` owner, its fields in declaration order.
use @std.avrac.core.{node_payload_rows, row_for}

spec "core/ParamSyntax — a record that is no node" {
    given "the derive it wears" {
        then "Grammar answers one row owned by `Record`, spelling every labelled part" {
            let row = row_for(node_payload_rows(), "Record", "ParamSyntax")
            ["${f.name}: ${f.ty}" for f in row?.payloads ?? []].join(", ") == "marks: List<Mark>, state_field: bool, constant: bool, mutable: bool, state: bool, unshared: bool, spread: bool, name: Scoped?, ty: TypeRef?, default: ExprId?, variadic: bool"
        }
        then "and it is the only row the record answers" {
            [r for r in node_payload_rows() if r.variant == "ParamSyntax"].length == 1
        }
    }
}
