// `Type.Union`'s own laws: order-independent interning, flattening,
// the one-member collapse, and the set operations `catch`/widening
// read (`covers`, `subtracted`). Pure registry calls — no source, no
// parsing — since the shape's contract lives entirely in
// `TypeRegistry`. Also the write-once-after-read settle guard: a
// declare hook asked before its declaration has settled anything.
use @std.avrac.core.{new_type_registry, Type, DeclId}

fn decl(n: int) -> DeclId { DeclId { index: n } }

fn nothing_settled() {}

spec "core/types: Union" {
    given "a union of members" {
        then "order does not matter — A|B and B|A intern identically" {
            let r = new_type_registry()
            let a = r.intern(Type.Struct(decl(0), "A"))
            let b = r.intern(Type.Struct(decl(1), "B"))
            r.union_of([a, b]).index == r.union_of([b, a]).index
        }
        then "a union absorbs a union — (A|B)|C and A|B|C intern alike" {
            let r = new_type_registry()
            let a = r.intern(Type.Struct(decl(0), "A"))
            let b = r.intern(Type.Struct(decl(1), "B"))
            let c = r.intern(Type.Struct(decl(2), "C"))
            let nested = r.union_of([r.union_of([a, b]), c])
            let flat = r.union_of([a, b, c])
            nested.index == flat.index
        }
        then "a repeated member dedupes to one" {
            let r = new_type_registry()
            let a = r.intern(Type.Struct(decl(0), "A"))
            r.union_of([a, a]).index == a.index
        }
        then "a one-member union is not a union at all" {
            let r = new_type_registry()
            let a = r.intern(Type.Struct(decl(0), "A"))
            let one = r.union_of([a])
            !(r.shape_of(one) is .Union) && one.index == a.index
        }
    }
    given "covers — the subset law every widen and `catch` reads" {
        then "a member is covered by its union, a union by a wider one, a type by itself" {
            let r = new_type_registry()
            let a = r.intern(Type.Struct(decl(0), "A"))
            let b = r.intern(Type.Struct(decl(1), "B"))
            let c = r.intern(Type.Struct(decl(2), "C"))
            let ab = r.union_of([a, b])
            let abc = r.union_of([a, b, c])
            r.covers(ab, a) && r.covers(abc, ab) && r.covers(a, a)
        }
        then "a stranger is not covered" {
            let r = new_type_registry()
            let a = r.intern(Type.Struct(decl(0), "A"))
            let b = r.intern(Type.Struct(decl(1), "B"))
            let c = r.intern(Type.Struct(decl(2), "C"))
            !r.covers(r.union_of([a, b]), c)
        }
    }
    given "subtracted — a selective catch's remaining set" {
        then "the named members leave, the rest survive" {
            let r = new_type_registry()
            let a = r.intern(Type.Struct(decl(0), "A"))
            let b = r.intern(Type.Struct(decl(1), "B"))
            let c = r.intern(Type.Struct(decl(2), "C"))
            let abc = r.union_of([a, b, c])
            let remaining = r.union_of(r.subtracted(abc, [a]))
            r.covers(remaining, b) && r.covers(remaining, c) && !r.covers(remaining, a)
        }
        then "one member left is a plain type, not a union" {
            let r = new_type_registry()
            let a = r.intern(Type.Struct(decl(0), "A"))
            let b = r.intern(Type.Struct(decl(1), "B"))
            let ab = r.union_of([a, b])
            let remaining = r.union_of(r.subtracted(ab, [a]))
            !(r.shape_of(remaining) is .Union) && remaining.index == b.index
        }
    }
    given "a declare hook asked before its own declaration has settled anything" {
        then "a hook that only forces the sig, settling nothing, leaves a later real settle refused" {
            let r = new_type_registry()
            let a = r.intern(Type.Struct(decl(0), "A"))
            r.arm_declare((id) -> nothing_settled())
            let _ = r.is_settled(a)
            r.mark_settled(a)
            !r.drain_stale().is_empty()
        }
        then "a hook that settles the type FROM ITS RECORD on first ask is read correctly, and a repeat settle is a no-op, never a stale write" {
            let r = new_type_registry()
            let a = r.intern(Type.Struct(decl(0), "A"))
            r.arm_declare((id) -> r.mark_settled(id))
            let settled = r.is_settled(a)
            r.mark_settled(a)
            settled && r.drain_stale().is_empty()
        }
        then "a read while the type's OWN declaration is in flight is its provisional state, never a decision — the settle it triggers stands clean" {
            let r = new_type_registry()
            let a = r.intern(Type.Struct(decl(0), "A"))
            r.begin_declare(a)
            let _ = r.is_settled(a)
            r.mark_settled(a)
            r.end_declare(a)
            r.drain_stale().is_empty() && r.is_settled(a)
        }
        then "a read AFTER the declaration still records: a settle that moves it after that is still refused" {
            let r = new_type_registry()
            let a = r.intern(Type.Struct(decl(0), "A"))
            r.begin_declare(a)
            r.end_declare(a)
            let _ = r.is_settled(a)
            r.mark_settled(a)
            !r.drain_stale().is_empty()
        }
    }
}
