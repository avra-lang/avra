// `unhex` reads back what `hex` wrote, and refuses text that is not whole pairs of digits.
use @std.avrac.core.{hex, unhex}

spec "core/hex" {
    given "unhex" {
        then "every octet round-trips" {
            let all = [i for i in 0..256].bytes()!
            unhex(hex(all))! == all
        }
        then "upper-case digits are no digits" {
            unhex("0A") == null
        }
        then "a non-digit in either place is absent" {
            unhex("0g") == null && unhex("g0") == null && unhex("zz") == null
        }
        then "an odd length is absent" {
            unhex("abc") == null
        }
        then "nothing is an empty octet list" {
            unhex("")!.length == 0
        }
    }
}
