//! The registry's COUNT columns against its own twin columns: `takes`
//! and `stood` say what a row's body counts, and an engine that hosts
//! the row moves exactly those — so a twin that disagrees with its
//! base about them is a count one engine makes and the other does not.
use core.{RtSig, Takes, rt_sigs, rt_sig_of, rt_owned_twin, rt_moving_twin}

/// The seat a row takes its own reference to, or -1.
fn taken_seat(s: RtSig) -> int {
    match s.takes {
        .Never -> -1,
        .Always(seat) or .Present(seat, _) or .Counted(seat, _, _) -> seat,
    }
}

fn twin_of(name: string?) -> RtSig? {
    let n? = name else { return null }
    rt_sig_of(n)
}

/// An owned twin that STORES pays for the seat it keeps. One that
/// ANSWERS hands back a box that stood exactly when its base LENDS —
/// a pop hands the slot's own reference over, and nothing stood.
fn owned_twin_counts(base: RtSig) -> bool {
    let twin? = twin_of(rt_owned_twin(base.name)) else { return true }
    if twin.owns_result { twin.stood == base.lends } else { taken_seat(twin) >= 0 }
}

/// A moving twin keeps the seat and takes nothing: the caller paid.
fn moving_twin_takes_nothing(base: RtSig) -> bool {
    let twin? = twin_of(rt_moving_twin(base.name)) else { return true }
    twin.takes is .Never && twin.keeps.any(it)
}

/// A taken seat is a seat the row has, and one it keeps or packs.
fn takes_a_real_seat(s: RtSig) -> bool {
    let seat = taken_seat(s)
    seat < s.params.length && (seat < 0 || s.keeps.is_empty() || s.keeps[seat])
}

spec "core/runtime_api (count columns)" {
    then "every owned twin counts what it stores or answers" { rt_sigs().all(owned_twin_counts(it)) }
    then "every moving twin keeps its seat and takes nothing" { rt_sigs().all(moving_twin_takes_nothing(it)) }
    then "a taken seat is one the row has and keeps" { rt_sigs().all(takes_a_real_seat(it)) }
    then "a row whose answer stood answers owned" { rt_sigs().all(!it.stood || it.owns_result) }
    then "the columns are filled: rows take, and rows answer what stood" {
        [1 for s in rt_sigs() if taken_seat(s) >= 0].length == 13 &&
            [1 for s in rt_sigs() if s.stood].length == 8
    }
}
