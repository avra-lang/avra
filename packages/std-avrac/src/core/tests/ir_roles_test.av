fn r(at: int) -> Reg {
    Reg { index: at }
}

fn shown_reg(x: Reg?) -> string {
    if x == null { return "-" }
    "${x!.index}"
}

fn shown_regs(rs: List<Reg>) -> string {
    ["${x.index}" for x in rs].join(",")
}

fn shown_sym(s: string?) -> string {
    s ?? "-"
}

fn dst_agrees(row: Row) -> bool {
    shown_reg(dst_of(row.ins)) == row.dst
}

fn reads_agree(row: Row) -> bool {
    shown_regs(reads_of(row.ins)) == row.reads
}

fn seats_agree(row: Row) -> bool {
    shown_regs(seat_regs(row.ins)) == row.seats
}

fn owns_agree(row: Row) -> bool {
    shown_reg(owned_dst(row.ins)) == row.owns
}

fn view_agree(row: Row) -> bool {
    shown_reg(viewed_dst(row.ins)) == row.view
}

fn lent_agree(row: Row) -> bool {
    shown_regs(lent_args(row.ins)) == row.lent
}

fn call_agrees(row: Row) -> bool {
    shown_sym(call_symbol(row.ins)) == row.call
}

fn body_agrees(row: Row) -> bool {
    shown_sym(body_symbol(row.ins)) == row.body
}

fn host_agrees(row: Row) -> bool {
    shown_sym(hosted_symbol(row.ins)) == row.host
}

spec "core/ir — a role projection answers what a person reads off the declaration" {
    given "one instruction per variant, and the absent `Reg?`" {
        then "the fixture covers every variant — a missed one proves nothing" {
            rows().length == 33
        }
        then "`dst_of` answers the `@dst` payload, and nothing where there is none" {
            rows().all(dst_agrees(it))
        }
        then "`reads_of` answers every OTHER register, in declaration order" {
            rows().all(reads_agree(it))
        }
        then "`seat_regs` answers an Avra call's seats, and a runtime row has none" {
            rows().all(seats_agree(it))
        }
        then "`owned_dst` answers the `@owns` payload — a plain `@dst` owns nothing" {
            rows().all(owns_agree(it))
        }
        then "`viewed_dst` answers the `@view` payload, and a pack is not a view" {
            rows().all(view_agree(it))
        }
        then "`lent_args` answers the seats a call is LENT, and a runtime row's are not seats" {
            rows().all(lent_agree(it))
        }
        then "`call_symbol` answers the body a call ENTERS" {
            rows().all(call_agrees(it))
        }
        then "`body_symbol` answers a body entered OR addressed, never a static's name" {
            rows().all(body_agrees(it))
        }
        then "`hosted_symbol` answers the runtime's name and never a body's" {
            rows().all(host_agrees(it))
        }
    }
}
