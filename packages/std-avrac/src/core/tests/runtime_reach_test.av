// The reach column: a row that reads or writes the process's world
// says so, and a settlement may run only the rest.
use @std.avrac.core.{rt_sigs, RtSig}

spec "core/runtime_api — reach" {
    given "the registry" {
        then "every io, process, time, env and print row reaches the world, and no other" {
            rt_sigs().all((r: RtSig) -> worldly(r.name) == (r.reach is .World))
        }
        then "the world rows are counted" {
            [r for r in rt_sigs() if r.reach is .World].length == 24
        }
        then "one row embeds" {
            [r.name for r in rt_sigs() if r.reach is .Embed].join(",") == "avra_embed"
        }
    }
}

fn worldly(name: string) -> bool {
    name.starts_with("avra_io_") || name.starts_with("avra_proc_") || name == "avra_now_ns" || name == "avra_host_env" || name == "avra_puts" || name == "avra_eputs" || name == "avra_errno_text"
}
