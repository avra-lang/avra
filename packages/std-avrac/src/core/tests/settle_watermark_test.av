// A settle derives the prints of the nodes added since the last; a node it derived, written after,
// makes the next settle derive every print — so an edit to a settled node prints as a fresh settle.
use @std.avrac.core.{scoped, new_node_store, Expr, ExprId, Pat, PatId, SyntaxArena}

/// A node, a negation over it and a pattern, settled first where `between`; then `edit`, a node added,
/// and a settle.
fn edited(between: bool, edit: fn(SyntaxArena) -> void) -> SyntaxArena {
    let store = new_node_store()
    let kid = store.alloc_expr(Expr.IntLit(1))
    let _ = store.alloc_expr(Expr.Neg(kid))
    let _ = store.alloc_pat(Pat.Bind(scoped("a")))
    if between { store.settle_prints() }
    edit(store)
    let _ = store.alloc_expr(Expr.IntLit(3))
    store.settle_prints()
    store
}

/// Every print the store holds, in node order.
fn prints(store: SyntaxArena) -> string {
    ["${store.expr_fingerprint(ExprId { index: i })}" for i in 0..store.expr_count()]
        .concat(["${store.pat_fingerprint(PatId { index: i })}" for i in 0..store.pat_count()])
        .join(",")
}

fn unedited(_store: SyntaxArena) {}

/// The first node replaced by another number.
fn kid_replaced(store: SyntaxArena) { store.exprs.replaced(0, Expr.IntLit(2)) }

/// The first node extended by a node minted after it.
fn kid_extended(store: SyntaxArena) {
    let root = store.alloc_expr(Expr.IntLit(7))
    store.extended_with(ExprId { index: 0 }, [root])
}

/// The pattern rebound to another name.
fn pat_rebound(store: SyntaxArena) { store.pat_replaced(PatId { index: 0 }, Pat.Bind(scoped("b"))) }

/// Whether `edit`, made after a settle, prints as it does made before one, and moves a print.
fn settles_fresh(edit: fn(SyntaxArena) -> void) -> bool {
    let after = prints(edited(true, edit))
    after == prints(edited(false, edit)) && after != prints(edited(true, unedited))
}

spec "core/store — a settle derives what was added since the last" {
    given "a node a settle derived, written after it" {
        then "a node replaced under a settled one prints as a fresh settle" { settles_fresh(kid_replaced) }
        then "a node extended after its settle prints as a fresh settle" { settles_fresh(kid_extended) }
        then "a pattern rebound after its settle prints as a fresh settle" { settles_fresh(pat_rebound) }
    }
    given "nodes added after a settle, nothing written under it" {
        then "the next settle prints them as a fresh one" {
            prints(edited(true, unedited)) == prints(edited(false, unedited))
        }
    }
}
