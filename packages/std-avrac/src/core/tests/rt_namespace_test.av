// The rows' claim on Avra itself: every row gets one `LowerCx`
// method, so a row that stops being projected fails here rather than
// passing silently in a namespace nobody rebuilds.
use @std.avrac.core.{rt_sigs, RtSig, RtKind, RtHost, runtime_namespace}

/// The name every row's method is keyed by — the row's own name with
/// the projection's `avra_` prefix stripped.
fn short_of(s: RtSig) -> string {
    s.name.substring(5, s.name.length)
}

fn has_one_method(ns: string, s: RtSig) -> bool {
    ns.split("mut fn ${short_of(s)}(").length == 2
}

spec "core/rt_namespace" {
    given "the generated namespace" {
        then "every row gets exactly one method" {
            let ns = runtime_namespace()
            rt_sigs().all(has_one_method(ns, it))
        }
        then "the namespace opens on its own preamble, once" {
            runtime_namespace().split("GENERATED by `avra runtime-namespace`").length == 2
        }
        then "every method lives inside one `impl LowerCx`" {
            runtime_namespace().split("impl LowerCx {").length == 2
        }
    }
    given "a row that answers a value" {
        then "its method takes the destination type and mints through `self.call`" {
            runtime_namespace().contains("    mut fn streq(sh: Type, a0: Reg, a1: Reg) -> Reg {\n        self.call(sh, rt_sig_of(\"avra_streq\")!, [a0, a1])\n    }")
        }
    }
    given "a row that answers nothing" {
        then "its method takes no destination type and calls void" {
            runtime_namespace().contains("    mut fn puts(a0: Reg) {\n        self.call_void(rt_sig_of(\"avra_puts\")!, [a0])\n    }")
        }
    }
    given "a row of no seats" {
        then "its method takes no registers at all" {
            runtime_namespace().contains("    mut fn array_new(sh: Type) -> Reg {\n        self.call(sh, rt_sig_of(\"avra_array_new\")!, [])\n    }")
        }
    }
}
