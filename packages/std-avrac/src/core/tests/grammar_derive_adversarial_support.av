//! A trait whose `derive` and `marks` stand in a file OTHER than the
//! one that annotates with it (CLAUDE.md: a derive's file is typed
//! while the annotated file still registers). Exists only so the
//! adversarial test's `@dst` mark is claimed and F2092 stays quiet —
//! the question that test asks is about marks_code/mark_code, not
//! about the unread-mark law, which has its own suite.
use @std.meta.{Type as MetaType, Directive}

export trait Claims {
    static fn derive(t: MetaType) -> List<Directive> { [] }
    static fn marks(t: MetaType) -> List<string> { ["dst"] }
}
