//! `@derive(Fingerprint)` — a value's identity as ONE number, folded
//! by the ARITY LAW: a tag, the type's NAME, then exactly one value
//! per field or payload, so two shapes collide only if their parts
//! do. What every `finish(key, value, HASH)` hand-wrote, derived.
//!
//! IT DISPATCHES ON `Kind`, NEVER ON A SPELLING. A field's shape is
//! what decides its fold — `List<T>` folds through `fp_list`, `T?`
//! folds to one value, a declared name folds through its own
//! `fingerprint()`. A registry over type TEXT is a registry nothing
//! checks, and telling `List<int>` from a type named `Listen` would
//! be a substring test.
//!
//! THE TAG IS ONE RESERVED NUMBER AND THE TYPE'S NAME SEPARATES.
//! Generated code lands in the ANNOTATED file, whose own source
//! spells no fold call for `make fingerprints` to read — so a
//! per-type tag would be invisible. ONE literal tag lives HERE,
//! where the keeper sees it, and the type's name folded first is
//! what keeps two derived types apart. `fp` seeds with `fp_mix(tag,
//! parts.length)` and mixes multiplicatively, so this is not the
//! additive renumbering that separates nothing.
//!
//! A FIELD WITH NO STRUCTURAL READING IS REFUSED BY THE COMPILER,
//! not skipped here. Every shape `Kind` does not fold defers to the
//! value's own `fingerprint()`, so a `Voices`, a fn value or a map
//! is F2030 "`Voices` has no method `fingerprint`" at the generated
//! code, homed to the annotation. The two exits are the trait's:
//! implement it by hand (what a type carrying its own identity does)
//! or stop deriving. SKIPPING a field silently is the one thing this
//! must never do — that is "a hash that forgets a payload", and the
//! forgetting leaves no mark at the site.
use @std.meta.{
    Type as MetaType,
    Variant as MetaVariant,
    Field,
    Kind,
    Code,
    Arms,
    Directive as MetaDirective,
    Decls as MetaDecls,
    name,
    as_code,
    int_node,
}

// ── The field-mark registry. `@local` is this process's own: no child,
// out of identity, its value stays on the node. `@facet(table)` leaves
// the gathered payload for the side table the mark names: no child
// either, and still part of what the node is. ONE row says each, and a
// shape derive asks HERE — never the mark's own word. ──

/// The mark that takes a field out of what a value IS.
export const local_word: string = "local"

/// The mark that takes a field's value out of the payload, for a side
/// table the mark names.
export const facet_word: string = "facet"

/// How a field's mark routes it.
export enum FieldRoute {
    /// Unmarked — a payload, a child, part of the node.
    Plain
    /// `@local` — no child, out of identity, the value stays on the node.
    Local
    /// `@facet(table)` — no child; the value leaves the payload for the
    /// side table `table` names, and still tells one node from another.
    Facet(side: string)
}

/// The route a field's marks name. A field wears at most one; one
/// wearing both reads as a facet.
export fn field_route(f: Field) -> FieldRoute {
    let facet? = f.marks.find(it.name == facet_word) else {
        if f.marks.any(it.name == local_word) { return FieldRoute.Local }
        return FieldRoute.Plain
    }
    FieldRoute.Facet(facet.args.first() ?? "")
}

/// Whether the field is one a shape derive REACHES: a `@local` field and
/// a `@facet` field are no child, and neither folds from the payload.
export fn reached(f: Field) -> bool {
    match field_route(f) { .Plain -> true, .Local or .Facet(_) -> false }
}

/// Whether the gathered payload CARRIES the field: a facet does not.
export fn carried(f: Field) -> bool {
    match field_route(f) { .Facet(_) -> false, .Plain or .Local -> true }
}

/// The side table a `@facet` field names, absent for any other field.
export fn facet_table(f: Field) -> string? {
    match field_route(f) { .Facet(side) -> side, .Plain or .Local -> null }
}

/// The side table a WRITTEN field's own marks name — the same question
/// asked of the store's `Mark`, before the crossing makes a `Field`.
export fn facet_on(marks: List<Mark>) -> string? {
    let m? = marks.find(it.name == facet_word) else { return null }
    m.args.first()
}

/// Whether a written field's marks name a facet.
export fn faceted(marks: List<Mark>) -> bool { facet_on(marks) != null }

// ── The ANCHOR. A route says what a payload CARRIES; an anchor says
// where the node it belongs to BEGINS. It rides beside the route and
// never in it: an anchored payload is carried and reached like any
// other, and only the span its rule allocated at changes. ──

/// The mark that anchors a node at the written span of the payload it
/// names, where the whole rule's branch would otherwise be that span.
export const anchor_word: string = "anchor"

/// Whether the payload is its node's anchor. One payload of a node is,
/// and the assembly refuses a second — a node begins in ONE place.
export fn has_anchor(f: Field) -> bool { f.marks.any(it.name == anchor_word) }

export trait Fingerprint {
    /// `@local` and `@facet` fields are not part of what a value folds.
    static fn marks(t: MetaType) -> List<string> { [local_word, facet_word] }

    static fn derive(t: MetaType) -> List<MetaDirective> {
        [
            MetaDirective {
                twin: "",
                name: t.name,
                at: t.at,
                source: quote { impl ${t} { ${body_of(t)} } },
            },
        ]
    }
}

/// A record folds its fields; an enum chooses, then folds a
/// variant's payload. A type that is neither has nothing to fold and
/// answers its name alone, which is still an identity.
fn body_of(t: MetaType) -> MetaDecls {
    quote {
        fn fingerprint() -> int { ${folding(t, own_fingerprint)} }
        fn fingerprint_in(ids: Ids) -> int { ${folding(t, own_fingerprint_in)} }
    }
}

/// What a method folding `self` answers: the variant chosen, or the
/// record's fields, each named payload folded by `leaf`.
fn folding(t: MetaType, leaf: fn(Code) -> Code) -> Code {
    if !t.variants.is_empty() { return quote { match self { ${arms_of(t, leaf)} } } }
    record_fold(t, leaf)
}

/// `fp(tag, [name, f1, f2, …])` over `self.<field>`.
fn record_fold(t: MetaType, leaf: fn(Code) -> Code) -> Code {
    parted(t.name, [folded(f.kind, quote { self.${f.name} }, leaf) for f in t.fields if reached(f)])
}

/// One arm per variant: its INDEX pins the arity, so two variants of
/// one type cannot fold alike however their payloads line up.
fn arms_of(t: MetaType, leaf: fn(Code) -> Code) -> List<Arms> {
    [variant_arm(t.name, v, j, leaf) for j, v in t.variants]
}

fn variant_arm(owner: string, v: MetaVariant, at: int, leaf: fn(Code) -> Code) -> Arms {
    if v.fields.is_empty() { return quote { .${v} -> ${parted_at(owner, at, [])} } }
    quote { .${v}(${binders(v)}) -> ${parted_at(owner, at, payload_folds([f for f in v.fields if reached(f)], leaf))} }
}

/// A payload's own FIELD NAMES are the binders — the names the
/// declaration wrote, so an arm reads as the declaration does. A
/// BINDER HOLE TAKES NAMES, not templates. The carried fields bind;
/// a `@facet` field is not in the payload at all.
fn binders(v: MetaVariant) -> List<string> {
    [f.name for f in v.fields if carried(f)]
}

fn payload_folds(kept: List<Field>, leaf: fn(Code) -> Code) -> List<Code> {
    [folded(f.kind, name(f.name), leaf) for f in kept]
}

/// The type's NAME folded first, then its parts. THE NAME IS FOLDED
/// WHERE THE DERIVE RUNS, not where the value does: the derive knows
/// the name at compile time, so it spends `fp_str` ONCE and splices
/// the number. A generated fold that walked a constant string on
/// every call would cost what the hand hashes it replaces do not.
fn parted(owner: string, parts: List<Code>) -> Code {
    mixed(int_lit(fp_str(owner)), parts)
}

/// A variant's fold: the name, then the variant's INDEX, then its
/// payload.
fn parted_at(owner: string, at: int, parts: List<Code>) -> Code {
    mixed(int_lit(fp_str(owner)), [int_lit(at)].concat(parts))
}

/// THE ONE SITE THAT WRITES THE TAG, and it writes it as a LITERAL.
/// `make fingerprints` reads the tag space from what the source
/// SPELLS, so a tag spelled through a fn is invisible to the one
/// instrument that guards it — and the keeper reads the space
/// correctly, which is why the honest way to claim a number is to
/// let it see one.
fn int_lit(v: int) -> Code { as_code(int_node(v)) }

fn mixed(head: Code, rest: List<Code>) -> Code {
    quote { derived(${listed(head, rest)}) }
}

/// THE TAG, AS A VALUE: the fold every derived identity wears and
/// every hand-written one must match — the reserved number, then the
/// parts the caller built (the type's name, the variant's index, one
/// value per field). The generated code CALLS this rather than
/// spelling the tag, so the number is claimed in exactly one place
/// and a type whose identity is written by hand folds to the same
/// number as the type next to it.
export fn derived(parts: List<int>) -> int { fp(1, parts) }

/// A LIST OF TEMPLATES IS NOT AN EXPRESSION HOLE — a hole in
/// expression position takes ONE `Code`. The list is built HERE
/// instead, one hole per element, so the generated literal's length
/// is fixed at derive time and the arity law holds by construction.
/// The seed is the HEAD rather than `[]`, which cannot know its
/// elements.
fn listed(head: Code, rest: List<Code>) -> Code {
    mut acc = quote { [${head}] }
    for p in rest { acc = quote { ${acc}.concat([${p}]) } }
    acc
}

/// A named value folds by its own `fingerprint()`.
fn own_fingerprint(e: Code) -> Code { quote { ${e}.fingerprint() } }

/// A named value folds by its own `fingerprint_in`: a fold that reads
/// an arena id through the durable name it indexes.
fn own_fingerprint_in(e: Code) -> Code { quote { ${e}.fingerprint_in(ids) } }

/// ONE FOLD PER SHAPE, every variant answering. A shape this does not
/// spell structurally defers to `leaf`, which names a method of the
/// value; the compiler refuses a type that has none — naming the type
/// and the method, which is the honest refusal.
fn folded(k: Kind, e: Code, leaf: fn(Code) -> Code) -> Code {
    match k {
        .Int -> e,
        .Bool -> quote { (if ${e} { 1 } else { 0 }) },
        .Str -> quote { fp_str(${e}) },
        .List(elem) -> quote { fp_list([${folded(elem, quote { each }, leaf)} for each in ${e}]) },
        .Opt(inner) -> optional(inner, e, leaf),
        .Result(ok, err) -> answered(ok, err, e, leaf),
        .Float or .Ptr or .Void or .Cell(_) or .Map(_, _) or .Named(_, _) or .Fn(_, _) or .Dyn(_) or .Var(_) or .Unspelled(_) -> leaf(e),
    }
}

/// ABSENCE IS ITS OWN VALUE, and it is told apart BY ARITY: absence
/// folds one part, presence folds two. An additive offset would be
/// the renumbering that separates nothing — a present value whose own
/// fold is -1 reads as null.
fn optional(inner: Kind, e: Code, leaf: fn(Code) -> Code) -> Code {
    quote { (if ${e} == null { ${mixed(int_lit(0), [])} } else { ${mixed(int_lit(1), [folded(inner, quote { ${e}! }, leaf)])} }) }
}

/// The SIDE is a part, not a tag: two tags under a multiplicative
/// fold would separate the sides, and one tag with the side as the
/// first part separates them the same way every other choice here
/// does — so the file claims ONE number and the keeper sees it.
fn answered(ok: Kind, err: Kind, e: Code, leaf: fn(Code) -> Code) -> Code {
    quote { (match ${e} { .Ok(held) -> ${mixed(int_lit(0), [folded(ok, name("held"), leaf)])}, .Err(held) -> ${mixed(int_lit(1), [folded(err, name("held"), leaf)])} }) }
}
