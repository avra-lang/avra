//! Append-only typed storage with a parallel span side table — the
//! shape every node arena shares. Callers wrap the raw index in their
//! typed id.
use @std.meta.{identity}

/// ONE IDENTITY: every table is a `Cell`, so a copy of the arena
/// appends into the same storage as the original. `kind_index` is
/// `Expr`'s alone (COMPILER DB townhall §6.11's `@index kind`,
/// `core/store.av`'s `exprs_by_kind`) — a `Stmt`/`Pat` arena carries
/// the field unbuilt, never populated, at the cost of one always-null
/// slot rather than a field on `SyntaxArena` itself, which every one of
/// its ~30 sibling fields would pay a retain/release for on every
/// copy and drop.
@identity
export type Arena<N> = {
    nodes: Cell<List<N>>,
    spans: Cell<List<Span?>>,
    kind_index: Cell<Map<string, Cell<List<int>>>?>,
}

export fn new_arena<N>() -> Arena<N> {
    let no_kind_index: Map<string, Cell<List<int>>>? = null
    Arena { nodes: list_cell<N>(), spans: list_cell<Span?>(), kind_index: Cell.new(no_kind_index) }
}

impl Arena {
    /// Append a node and its span; the new raw index.
    fn add(n: N, span: Span?) -> int {
        self.nodes.push(n)
        self.spans.push(span)
        self.nodes.get().length - 1
    }

    fn node_at(i: int) -> N { self.nodes.get()[i] }
    fn span_at(i: int) -> Span? {
        let spans = self.spans.get()
        if i >= 0 && i < spans.length { spans[i] } else { null }
    }
    fn count() -> int { self.nodes.get().length }
}
