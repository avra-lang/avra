//! Append-only typed storage with a parallel span side table — the
//! shape every node arena shares. Callers wrap the raw index in their
//! typed id.

export type Arena<N> = { nodes: List<N>, spans: List<Span?> }

export fn new_arena<N>() -> Arena<N> {
    Arena { nodes: [], spans: [] }
}

impl Arena<N> {
    /// Append a node and its span; the new raw index.
    fn add(self, n: N, span: Span?) -> int {
        mut nodes = self.nodes
        mut spans = self.spans
        nodes.push(n)
        spans.push(span)
        nodes.length - 1
    }

    fn node_at(self, i: int) -> N { self.nodes[i] }
    fn span_at(self, i: int) -> Span? { self.spans[i] }
    fn count(self) -> int { self.nodes.length }
}
