//! `@derive(Exact)` — two nodes of one kind, compared by their actual
//! VALUES, never by a folded hash. `@derive(Identity)`/`@derive(Matchable)`
//! both answer an int a repeated `${x}` binder can trust as a
//! PRE-FILTER only: `fp`/`fp_str` are un-keyed rolling hashes
//! (core/fp.av) and two different subtrees can share one (the same
//! hazard `same_ins`/`same_ins_list` close for the IR, core/ir.av).
//! This derive is the verdict behind that filter.
//!
//! EVERY FIELD COMPARES BY ITS SHAPE (`Kind`), the way Identity folds
//! it: a scalar or text with `==`, a list element by element, an
//! optional by presence then payload, a named value by its own
//! `exact`. A `@local` field is not part of what a node IS and is not
//! compared. An id dereferences through the arena, which is why
//! `exact` takes it.
//!
//! It stands ALONE in this file on purpose (CLAUDE.md).
use @std.meta.{Type as MetaType, Variant as MetaVariant, Field, Kind, Directive, Code, Arms, name}

/// Equality by value, over an arena.
export trait Exact {
    fn exact(other: Self, arena: SyntaxArena) -> bool

    static fn derive(t: MetaType) -> List<Directive> {
        [
            Directive {
                twin: "",
                name: t.name,
                at: t.at,
                source: quote {
                    impl Exact for ${t} {
                        fn exact(other: ${t}, arena: SyntaxArena) -> bool { ${comparing(t)} }
                    }
                },
            },
        ]
    }

    /// `@local` fields are not part of what a node IS.
    static fn marks(t: MetaType) -> List<string> { [local_word] }
}

/// A record compares its fields; an enum its variant, then payloads.
fn comparing(t: MetaType) -> Code {
    if t.variants.is_empty() { return fields_same(t) }
    quote { match self { ${[arm(v) for v in t.variants]} } }
}

fn fields_same(t: MetaType) -> Code {
    anded(
        [same(f.kind, quote { self.${f.name} }, quote { other.${f.name} }) for f in counted(t.fields)],
    )
}

/// One variant's arm: `self`'s payloads bind under their own names, `other`'s
/// under the same names suffixed `_b`; any other variant on `other`'s side is a miss.
fn arm(v: MetaVariant) -> Arms {
    if v.fields.is_empty() { return quote { .${v} -> match other { .${v} -> true, rest -> false } } }
    quote { .${v}(${[f.name for f in v.fields]}) -> match other { .${v}(${["${f.name}_b" for f in v.fields]}) -> ${anded([same(f.kind, name(f.name), name("${f.name}_b")) for f in counted(v.fields)])}, rest -> false } }
}

/// How two values of one shape compare. Every shape answers; a named one
/// defers to its own `exact`, which the compiler refuses a type without.
fn same(k: Kind, a: Code, b: Code) -> Code {
    match k {
        .Int or .Float or .Bool or .Str -> quote { ${a} == ${b} },
        .List(elem) -> quote { ${a}.length == ${b}.length && (0..${a}.length).all((k) -> ${same(elem, quote { ${a}[k] }, quote { ${b}[k] })}) },
        .Opt(inner) -> quote { (if ${a} == null || ${b} == null { ${a} == null && ${b} == null } else { ${same(inner, quote { ${a}! }, quote { ${b}! })} }) },
        .Ptr or .Void or .Cell(_) or .Map(_, _) or .Result(_, _) or .Named(_, _) or .Fn(_, _) or .Dyn(_) or .Var(_) or .Unspelled(_) -> quote { ${a}.exact(${b}, arena) },
    }
}

/// Every comparison, `&&`-ed together; `true` for nothing to compare.
fn anded(parts: List<Code>) -> Code {
    let head? = parts.first() else { return quote { true } }
    parts.drop(1).fold(head, (acc, p) -> quote { ${acc} && ${p} })
}
