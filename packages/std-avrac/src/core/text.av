//! Text similarity — the substrate under "did you mean" suggestions.

/// Levenshtein distance between two strings, by bytes.
export fn edit_distance(a: string, b: string) -> int {
    // Both lengths are `strlen`, and the inner loop runs a*b times —
    // re-asking there made the distance O(a*b*(a+b)).
    let an = a.length
    let bn = b.length
    if an == 0 { return bn }
    if bn == 0 { return an }
    mut prev: List<int> = []
    mut j = 0
    while j <= bn {
        prev.push(j)
        j = j + 1
    }
    mut i = 1
    while i <= an {
        mut cur: List<int> = [i]
        mut k = 1
        while k <= bn {
            let cost = if a.char_code(i - 1) == b.char_code(k - 1) { 0 } else { 1 }
            mut m = prev[k] + 1
            if cur[k - 1] + 1 < m { m = cur[k - 1] + 1 }
            if prev[k - 1] + cost < m { m = prev[k - 1] + cost }
            cur.push(m)
            k = k + 1
        }
        prev = cur
        i = i + 1
    }
    prev[b.length]
}

/// A nearby name and how far away it is.
export type Closest = { name: string, distance: int }

/// The nearest candidate within distance 2 — never an exact match,
/// ties to the earliest candidate.
export fn closest(name: string, candidates: List<string>) -> Closest? {
    mut best: Closest? = null
    for c in candidates {
        let d = edit_distance(name, c)
        if best == null || d < best!.distance { best = Closest { name: c, distance: d } }
    }
    if best != null && best!.distance >= 1 && best!.distance <= 2 { best } else { null }
}

/// Byte order on text: true when `a` sorts before `b`.
export fn text_before(a: string, b: string) -> bool {
    let n = if a.length < b.length { a.length } else { b.length }
    mut i = 0
    // whole words first: names that are paths share most of their length
    while i + 8 <= n && avra_str_word_at(a, i) == avra_str_word_at(b, i) { i = i + 8 }
    while i < n {
        let ca = a.char_code(i)
        let cb = b.char_code(i)
        if ca != cb { return ca < cb }
        i = i + 1
    }
    a.length < b.length
}

/// "72 programs", "1 program" — a count with its noun.
export fn counted(n: int, noun: string) -> string {
    "${n} ${noun}${if n == 1 { "" } else { "s" }}"
}

/// Names in byte order — a host listing made deterministic. A merge sort: the
/// lists it meets run to thousands.
export fn sorted_texts(xs: List<string>) -> List<string> {
    if xs.length < 2 { return [x for x in xs] }
    let mid = xs.length / 2
    merged_texts(sorted_texts(xs.slice(0, mid)), sorted_texts(xs.slice(mid, xs.length)))
}

/// Two sorted runs as one, the first's names ahead of their equals.
fn merged_texts(a: List<string>, b: List<string>) -> List<string> {
    mut out: List<string> = []
    mut i = 0
    mut j = 0
    while i < a.length && j < b.length {
        if text_before(b[j], a[i]) {
            out.push(b[j])
            j = j + 1
        } else {
            out.push(a[i])
            i = i + 1
        }
    }
    out.concat(a.slice(i, a.length)).concat(b.slice(j, b.length))
}
