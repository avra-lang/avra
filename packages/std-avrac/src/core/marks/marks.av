//! The words a node declaration wears for its derives to read.
//! `@declares` and `@expands` are marks — their answer is `Marker`,
//! so they are never run, and a word no derive claims is refused where
//! it is written. `@apart` is a plain annotation: `Node.derive` reads
//! it off the record, so no mark reader is owed it.
use @std.meta.{Named, Marker}

/// The variant names a declaration of its own.
export fn declares(_node: Named) -> Marker { Marker {} }

/// The variant's view stands in for its written payloads.
export fn expands(_node: Named) -> Marker { Marker {} }

/// Its children run elsewhere, or never here.
export fn apart(_node: Named) {}
