//! The words a node variant wears for its derives to read. Each is a
//! mark: its answer is `Marker`, so it is never run, and a word no
//! derive claims is refused where it is written.
use @std.meta.{Named, Marker}

/// The variant names a declaration of its own.
export fn declares(_node: Named) -> Marker { Marker {} }

/// The variant's view stands in for its written payloads.
export fn expands(_node: Named) -> Marker { Marker {} }

/// Its children run elsewhere, or never here.
export fn apart(_node: Named) -> Marker { Marker {} }

/// Its fields' expressions run in field order.
export fn sequence(_node: Named) -> Marker { Marker {} }

/// Its own fn decides how control runs through it.
export fn branches(_node: Named) -> Marker { Marker {} }

/// The variant's children follow a clause list's KIND and ORDER — the
/// shape a deciding fn reads, named here so the walk can find it.
export fn clauses(_node: Named, _order: string, _kind: string) -> Marker { Marker {} }
