//! The words a node's members wear for core's derives to read. Each is a
//! mark: its answer is `Marker`, so it is never run; a derive names the ones
//! it reads in its `@reads`, and a word nothing reads is refused where it is
//! written.
use @std.meta.{Named, Marker}

/// The variant names a declaration of its own.
export fn declares(_node: Named) -> Marker { Marker {} }

/// The variant's view stands in for its written payloads.
export fn expands(_node: Named) -> Marker { Marker {} }

/// Its children run elsewhere, or never here.
export fn apart(_node: Named) -> Marker { Marker {} }

/// Its fields' expressions run in field order.
export fn sequence(_node: Named) -> Marker { Marker {} }

/// Its own fn decides how control runs through it.
export fn branches(_node: Named) -> Marker { Marker {} }

/// The variant's children follow a clause list's KIND and ORDER — the
/// shape a deciding fn reads, named here so the walk can find it.
export fn clauses(_node: Named, _order: string, _kind: string) -> Marker { Marker {} }

/// A field that names no child, which a walk passes by.
export fn local(_d: Named) -> Marker { Marker {} }

/// A field read through one of a node's facets, `@facet(name)`.
export fn facet(_d: Named, _name: string) -> Marker { Marker {} }

/// The payload a node's grammar anchors on.
export fn anchor(_d: Named) -> Marker { Marker {} }

/// A field a node carries without a value of its own.
export fn hollow(_d: Named) -> Marker { Marker {} }

/// A field the pronoun `it` rides.
export fn pronoun(_d: Named) -> Marker { Marker {} }

/// A variant's word, `@word("w")`, where its own name is not it.
export fn word(_d: Named, _word: string) -> Marker { Marker {} }

/// A table a template copy carries, `@copied(arena, verb)`.
export fn copied(_d: Named, _arena: string, _verb: string) -> Marker { Marker {} }

/// A table a template copy carries by hand, `@copied_by_hand(site)`.
export fn copied_by_hand(_d: Named, _site: string) -> Marker { Marker {} }

/// A table a template copy leaves behind, `@not_copied(reason)`.
export fn not_copied(_d: Named, _reason: string) -> Marker { Marker {} }

/// A table a tape carries, `@taped(arena, read)`.
export fn taped(_d: Named, _arena: string, _read: string) -> Marker { Marker {} }

/// A table a tape carries beside the nodes it reads.
export fn taped_with_nodes(_d: Named, _read: string) -> Marker { Marker {} }

/// A table a tape carries beside the item it reads.
export fn taped_with_item(_d: Named, _verb: string) -> Marker { Marker {} }

/// A table an expansion hands again, `@remade(reason)`.
export fn remade(_d: Named, _reason: string) -> Marker { Marker {} }

/// The payload an instruction defines.
export fn dst(_d: Named) -> Marker { Marker {} }

/// The payload an instruction's seats are.
export fn seats(_d: Named) -> Marker { Marker {} }

/// The payload naming the body an instruction enters.
export fn body(_d: Named) -> Marker { Marker {} }

/// The payload naming the code an instruction takes the address of.
export fn code(_d: Named) -> Marker { Marker {} }

/// The payload naming the hosted fn an instruction calls.
export fn host(_d: Named) -> Marker { Marker {} }

/// The payload an instruction owns.
export fn owns(_d: Named) -> Marker { Marker {} }

/// The payload an instruction views.
export fn view(_d: Named) -> Marker { Marker {} }

/// The payloads an instruction lends.
export fn lent(_d: Named) -> Marker { Marker {} }
