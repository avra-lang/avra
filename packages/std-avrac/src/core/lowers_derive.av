//! `Lowers` — a node's lowering rule: the IR its value is, emitted. A `collect enum Expr: Lowers`
//! derives the default for every member with no rule of its own: the node isn't lowered yet, and
//! says so.
//!
//! It stands ALONE in this file on purpose (CLAUDE.md).
use @std.meta.{Type as MetaType, Directive, beside}

export trait Lowers {
    /// This node's value, emitted: the register that holds it.
    fn lowered(mut cx: Lowering, e: ExprId) -> Reg { cx.unlowered(e) }

    /// This node as a value nothing reads, emitted: what it does.
    fn lowered_dropped(mut cx: Lowering, e: ExprId) -> Reg { self.lowered(cx, e) }

    static fn derive(t: MetaType) -> List<Directive> {
        [beside(t, quote { impl Lowers for ${t} {} })]
    }
}
