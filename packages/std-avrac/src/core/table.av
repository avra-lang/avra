//! A DENSE-BY-INDEX table: one value per id, grown as ids arrive.
//! Every memo the workspace keeps is one of these — a query's answer
//! filed under the id that asked. The table is a TYPE because a
//! write reaches a place through its receiver.

/// One dense slot: absence is a variant rather than `T?`, so scalar
/// and managed values use the same table representation.
enum TableSlot<T> { Empty, Held(T) }

/// Values by index, absent until placed.
export type Table<T> = { rows: List<TableSlot<T>> }

/// An empty table — its rows arrive with the ids that ask.
export fn new_table<T>() -> Table<T> {
    let empty: List<TableSlot<T>> = []
    Table { rows: empty }
}

/// The value filed under `i`, absent past the table's end.
impl Table<T> {
    fn at(i: int) -> T? {
        if i >= self.rows.length { return null }
        match self.rows[i] {
            .Held(v) -> v,
            .Empty -> null,
        }
    }

    /// `v` filed under `i` — the table grows to hold it.
    fn keep(i: int, v: T) {
        while self.rows.length <= i { self.rows.push(TableSlot.Empty) }
        self.rows.set(i, TableSlot.Held(v))
    }

    /// How many ids the table has room for — its last placement's,
    /// plus one.
    fn span() -> int { self.rows.length }
}
