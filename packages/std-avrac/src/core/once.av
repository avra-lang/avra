//! A `once` FN'S ANSWER: kept in the fn's own slot the first time its body answers, and read back
//! from that slot by every call after. A pointer is kept as it is; any other answer rides a list of
//! one, so a kept absence is told apart from a slot nothing was kept in yet.

impl Lowering {
    /// The answer of the `once` fn known by `symbol`, its body `body` answering `answer`: what its slot
    /// holds, else the body's value, kept. An answer laid inline or that is nothing, and a body that
    /// leaves before its end, aren't lowered yet.
    mut fn once_answered(symbol: string, body: ExprId, answer: SignedType) -> Reg {
        let carried = self.laid_out(answer)
        let boxed = answer.nullable() || !carried.pointer()
        if boxed && (carried.inline() || answer.owned() == "void") { return self.missed_as("a `once` fn answering `${answer.spelled()}`") }
        let slot = if boxed { owned_type("List") with { args: [answer], nulls: 1 } } else { answer with { nulls: 1 } }
        let held = self.mint(self.laid_out(slot))
        self.emit(Ins.OnceRead(held, symbol))
        let exits = self.exits()
        let r = self
            .region(self.present(held, slot), carried) { cx ->
                let kept = cx.carried(held, slot)
                if boxed { cx.slot_read(carried, kept, 0) } else { kept }
            } else { cx ->
                let made = cx.lower(body)
                let kept = if boxed { cx.boxed_words(cx.laid_out(slot), [], [made]) } else { made }
                cx.emit(Ins.OnceCommit(symbol, kept))
                made
            }
        if self.exits() != exits { return self.missed_as("a `once` fn's body that leaves before its end") }
        r
    }

    /// How many exits from the fn are emitted so far.
    fn exits() -> int { [i for i in self.ins.get() if fn_exit(i)].length }
}

/// Whether `i` leaves the fn.
fn fn_exit(i: Ins) -> bool {
    match i { .FnExit(_) -> true, rest -> false }
}
