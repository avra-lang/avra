//! THE QUERY KERNEL — the compiler as a spreadsheet (L6, ps3t.8):
//! every step is a query that remembers its answer, the queries it
//! read (its deps, discovered by execution), the revision its answer
//! last CHANGED and the revision it was last VERIFIED. `ask` is the
//! red-green decision: a cell verified this revision is current;
//! otherwise its deps are re-verified through their families, and a
//! cell none of whose deps changed since its own verification is
//! re-marked current without running (green). A recomputed answer
//! whose hash is unchanged keeps its changed_at — the wave dies
//! there (early cutoff). A query that reaches itself is a CYCLE,
//! answered as such rather than recursed into. Inputs are cells the
//! driver sets. A key is a FAMILY number and the dense id the family
//! keys by — two list indexes, no strings. Values live in the
//! families' own typed tables; the kernel holds only bookkeeping.
/// A cell's address: its family, and the dense id the family keys
/// by (a FileId, a DeclId).
export type Key = { family: int, arg: int }

export fn same_key(a: Key, b: Key) -> bool {
    a.family == b.family && a.arg == b.arg
}

export enum Verdict {
    Reuse
    Compute
    Cycle
}

/// A cached query's bookkeeping: the deps it discovered, the
/// revisions it last CHANGED and was last VERIFIED, and its answer's
/// hash. The last-reader stamp `record_dep` dedupes against lives
/// apart, in `KernelState.stamps` — a repeat read never touches this.
type QueryCell = { deps: List<Key>, changed_at: int, verified_at: int, value_hash: int }

/// A fresh cell for an input: no deps, changed and verified as of
/// `rev` alike (it was just set, so this revision is both).
fn input_cell(rev: int, value_hash: int) -> QueryCell {
    QueryCell { deps: [], changed_at: rev, verified_at: rev, value_hash: value_hash }
}

/// One stamp a frame overwrote and must hand back to whoever it took
/// it from — `record_dep`, `settle`.
type Restore = { key: Key, previous: int }

// A shared KernelState's cell list copies on write. Bound each copy to
// one short row rather than a table that grows with the program.
const cell_chunk: int = 256

type KernelState = {
    rev: int,
    /// ONE SLOT, SHARED — see `features/decls.av`'s member tables: a write must
    /// not copy the block.
    cells: List<Cell<List<QueryCell?>>>,
    // The last-reader stamps, chunked and addressed exactly as `cells`
    // is (same `state_slot`) but held apart from it: a stamp is a bare
    // int, so reading one never retains a `QueryCell` or its `deps`
    // list, and a repeat read touches nothing but this array.
    stamps: List<Cell<List<int>>>,
    verifiers: List<fn(int) -> int>,
    // One dependency list per open query, EACH IN ITS OWN CELL. A shared
    // `List` reaches a copy at every append, so a list routed through the
    // state copied its whole self per recorded read; a cell is a stable
    // box, so `push` on it appends in place.
    pending: List<Cell<List<Key>>>,
    open: List<Key>,
    // The open queries' own ids, parallel to `pending`/`open` — a
    // repeat read's LAST-READER STAMP (in `stamps`) is compared
    // against `reading.last()`, never against the key itself, so
    // recognizing "I already recorded this" costs one int compare.
    reading: List<int>,
    // One RESTORE LIST per open query, parallel to `pending` — null
    // until that frame's first STAMP OVERWRITE of a STILL-OPEN
    // ancestor's cell (most frames never nest into one, so most stay
    // null: no allocation at all on that path, only a bare slot in
    // this outer list). A NESTED query reading the same cell
    // overwrites its STAMP (one field, the last reader wins), so the
    // outer query's next read sees a mismatch that is not "never
    // read" — it is "read, then clobbered". `record_dep` saves the
    // clobbered value here; `settle` writes it back, so the ancestor
    // that resumes sees its own stamp again and its next read is the
    // one-compare fast path, same as if nothing had nested at all.
    restore: List<Cell<List<Restore>>?>,
    next_reader: int,
    hits: int,
    misses: int,
}

/// No key has been read in a fresh frame yet. `state_slot` traps
/// under a negative family, so this sentinel names no real query and
/// never matches one.
const no_frame_key: Key = Key { family: -1, arg: -1 }

/// A kernel is a shared handle. Copying it copies the handle; every
/// query family and verifier therefore sees the same revision, open
/// stack, dependencies, and counters.
export type Kernel = {
    state: Cell<KernelState>,
    /// One LAST-RECORDED-KEY slot per open frame, held apart from
    /// `state`: a repeat read of the frame's own last key costs one
    /// `Cell.get` and one list index, never a `KernelState` snapshot.
    /// `begin` pushes `no_frame_key`, `settle` pops — a nested
    /// frame's slot sits above the outer's, so closing it exposes the
    /// outer's own last key exactly as it stood before the nesting.
    frame_last: Cell<List<Key>>,
}

export fn new_kernel() -> Kernel {
    let state = KernelState {
        rev: 1,
        cells: [],
        stamps: [],
        verifiers: [],
        pending: [],
        open: [],
        reading: [],
        restore: [],
        next_reader: 0,
        hits: 0,
        misses: 0,
    }
    let no_frame_reads: List<Key> = []
    Kernel { state: Cell.new(state), frame_last: Cell.new(no_frame_reads) }
}

impl Kernel {
    fn snapshot() -> KernelState { self.state.get() }

    fn replace(state: KernelState) { self.state.set(state) }

    fn revision() -> int { self.snapshot().rev }

    fn bump() {
        mut s = self.snapshot()
        s.rev = s.rev + 1
        self.replace(s)
    }

    fn family(verify: fn(int) -> int) -> int {
        mut s = self.snapshot()
        s.verifiers.push(verify)
        let ordinal = s.verifiers.length - 1
        self.replace(s)
        ordinal
    }

    /// Verifiers capture their workspace, which contains this handle.
    /// Replacing them breaks that ownership cycle after a one-shot run.
    fn disarm() {
        mut s = self.snapshot()
        s.verifiers = [never_verify for v in s.verifiers]
        self.replace(s)
    }

    fn set_input(key: Key, value_hash: int) {
        mut s = self.snapshot()
        let prior? = state_cell(s, key) else {
            write_cell(s, key, input_cell(state_revision(s), value_hash))
            self.replace(s)
            return
        }
        if prior.value_hash == value_hash {
            write_cell(
                s,
                key,
                prior with { deps: [], verified_at: state_revision(s), value_hash: value_hash },
            )
            self.replace(s)
            return
        }
        s.rev = state_revision(s) + 1
        write_cell(s, key, input_cell(state_revision(s), value_hash))
        self.replace(s)
    }

    fn ask(key: Key) -> Verdict {
        self.record_dep(key)
        let seen = self.snapshot()
        if seen.open.any(same_key(it, key)) { return Verdict.Cycle }
        let cell? = state_cell(seen, key) else { return self.miss() }
        if cell.verified_at == state_revision(seen) { return self.hit() }
        // A verifier may recursively update this same database. No
        // snapshot is written across that call.
        if self.any_dep_changed(cell) { return self.miss() }
        mut latest = self.snapshot()
        write_cell(latest, key, cell with { verified_at: state_revision(latest) })
        self.replace(latest)
        self.hit()
    }

    fn any_dep_changed(cell: QueryCell) -> bool {
        for d in cell.deps {
            if self.changed_after(d, cell.verified_at) { return true }
        }
        false
    }

    fn changed_after(dep: Key, since: int) -> bool {
        let verify = self.snapshot().verifiers[dep.family]
        verify(dep.arg) > since
    }

    fn active(key: Key) -> bool {
        self.snapshot().open.any(same_key(it, key))
    }

    /// Whether ANY key of a family is open — a query of that family is
    /// in flight. The kernel is language-agnostic, so the family is
    /// passed in.
    fn family_active(family: int) -> bool {
        self.snapshot().open.any(it.family == family)
    }

    fn changed_at(key: Key) -> int {
        let s = self.snapshot()
        state_cell(s, key)?.changed_at ?? state_revision(s)
    }

    fn cell(key: Key) -> QueryCell? { state_cell(self.snapshot(), key) }

    /// The keys a settled cell reads, for a caller translating them
    /// into a durable witness's edges — the only reason to look inside
    /// a `QueryCell` from outside this file.
    fn deps_of(key: Key) -> List<Key> {
        let none: List<Key> = []
        state_cell(self.snapshot(), key)?.deps ?? none
    }

    /// A settled cell's own value hash — an edge's other half, read
    /// back once the dep it names has itself settled.
    fn value_hash_of(key: Key) -> int? {
        state_cell(self.snapshot(), key)?.value_hash
    }

    fn begin(key: Key) {
        mut s = self.snapshot()
        let none: List<Key> = []
        let no_restore: Cell<List<Restore>>? = null
        s.pending.push(Cell.new(none))
        s.restore.push(no_restore)
        s.open.push(key)
        s.next_reader = s.next_reader + 1
        s.reading.push(s.next_reader)
        self.replace(s)
        self.frame_last.push(no_frame_key)
    }

    fn settle(key: Key, value_hash: int) {
        mut s = self.snapshot()
        let deps: List<Key> = s.pending.pop().get()
        let restored: Cell<List<Restore>>? = s.restore.pop()
        let _ = s.open.pop()
        let _ = s.reading.pop()
        mut fl = self.frame_last.get()
        let _ = fl.pop()
        self.frame_last.set(fl)
        if restored != null { for r in restored!.get() { restore_one(s, r) } }
        let prior? = state_cell(s, key) else {
            write_cell(
                s,
                key,
                QueryCell {
                    deps: deps,
                    changed_at: state_revision(s),
                    verified_at: state_revision(s),
                    value_hash: value_hash,
                },
            )
            self.replace(s)
            return
        }
        let changed = if prior.value_hash == value_hash { prior.changed_at } else { state_revision(s) }
        write_cell(
            s,
            key,
            QueryCell {
                deps: deps,
                changed_at: changed,
                verified_at: state_revision(s),
                value_hash: value_hash,
            },
        )
        self.replace(s)
    }

    /// Two fast paths, cheapest first. THE FRAME PATH compares `key`
    /// against the OPEN FRAME'S OWN last-recorded key (`frame_last`,
    /// held apart from `state`) — one `Cell.get`, one length check,
    /// one indexed read, no `KernelState` snapshot at all — and
    /// answers most repeat reads, since a query's reads of one key
    /// cluster together. A miss there (a different key, or nothing
    /// recorded in this frame yet) falls to THE STAMP PATH: one
    /// flat-array read and one int compare, touching neither the cell
    /// table nor a `QueryCell`'s `deps` list. A MISMATCH is not
    /// always "never read": a NESTED query reading the same key
    /// overwrites the stamp with ITS OWN reader id, so the outer
    /// query's next read of that key mismatches too, though it
    /// already recorded the dep. The two are told apart by asking
    /// whether the STAMP BEING OVERWRITTEN belongs to a STILL-OPEN
    /// frame (`reading.contains`, a scan of the open stack — a
    /// handful of ints deep, never the program's dep count): if so,
    /// that frame will read this key again and must see its own
    /// stamp restored, so the value is saved (`save_restore`, lazily
    /// minting the frame's own restore list); if not — a genuinely
    /// new dep, or a stamp some now-closed query left behind —
    /// nothing will ever ask for it again, so nothing is saved.
    /// Either way — stamp hit or genuinely new dep — `key` becomes
    /// this frame's new last key, so its NEXT read takes the frame
    /// path. ONE fn, not two: a split tried here paid a second
    /// prologue on every miss (`record_dep_miss`, avra-8sb5.57.56)
    /// for a hit-path saving smaller than that cost — kbench's altkey
    /// and newdep modes both got slower, so the fn stayed whole.
    fn record_dep(key: Key) {
        let fl = self.frame_last.get()
        if fl.is_empty() { return }
        // LICENSED lists.last_index: `last()` answers `Key?`, and a
        // flat record wrapped nullable is a BOXED answer — minting
        // one here to read a value this compare never keeps costs an
        // allocation per call; measured 6-7x the indexed read's cost
        // (kbench's hit mode, avra-8sb5.57.56: ~100 vs 626-689
        // instructions/call, `last()` and `last()!` alike).
        if same_key(fl[fl.length - 1], key) { return }
        // The depth alone crosses the slow path below, never `fl`
        // itself: an int costs nothing to hold live across a run of
        // calls, where the LIST would need retaining across every one
        // of them for a write this fn makes only once, at the end.
        let depth = fl.length
        mut s = self.snapshot()
        let reader = s.reading.last() ?? 0
        let stamp = state_stamp(s, key)
        if stamp != reader {
            if s.reading.contains(stamp) { self.save_restore(s, key, stamp) }
            write_stamp(s, key, reader)
            s.pending.last()!.push(key)
            self.replace(s)
        }
        self.frame_last.set_at(depth - 1, key)
    }

    /// Remembers a stamp `record_dep` is about to overwrite, so
    /// `settle` can hand it back to the frame it belonged to. Lazily
    /// mints this frame's own restore list on its first entry — the
    /// common, no-nesting case never allocates one at all; every later
    /// entry in the same frame just pushes onto the `Cell` already
    /// there, in place.
    fn save_restore(mut s: KernelState, key: Key, previous: int) {
        let idx = s.restore.length - 1
        let entry = Restore { key: key, previous: previous }
        let frame? = s.restore[idx] else {
            s.restore.set(idx, Cell.new([entry]))
            self.replace(s)
            return
        }
        frame.push(entry)
    }

    fn sweep() {
        let s = self.snapshot()
        let rev = state_revision(s)
        for row in s.cells {
            for j, held in row.get() {
                if held != null && held!.verified_at != rev { row.set_at(j, null) }
            }
        }
        self.replace(s)
    }

    /// Remove every cell in one family. Typed memo storage must be
    /// evicted with it, so a later ask cannot reuse bookkeeping after
    /// its value has been released.
    fn evict_family(family: int) {
        mut s = self.snapshot()
        mut at = family
        let stride = s.verifiers.length
        while at < s.cells.length * cell_chunk {
            let block = at / cell_chunk
            let offset = at % cell_chunk
            if offset < s.cells[block].get().length {
                s.cells[block].set_at(offset, null)
            }
            at = at + stride
        }
        self.replace(s)
    }

    fn hit() -> Verdict {
        mut s = self.snapshot()
        s.hits = s.hits + 1
        self.replace(s)
        Verdict.Reuse
    }

    fn miss() -> Verdict {
        mut s = self.snapshot()
        s.misses = s.misses + 1
        self.replace(s)
        Verdict.Compute
    }

    fn stats() -> string {
        let s = self.snapshot()
        "rev ${state_revision(s)}: ${s.hits} hits, ${s.misses} misses"
    }
}

fn state_revision(s: KernelState) -> int { s.rev }

// A bound check by length compare, not by indexing `verifiers`: that
// index would answer a `fn` value nobody wants, and retaining one to
// discard it is the one cost this slot math must never carry — it
// runs on every dep read, hit or miss.
fn state_slot(s: KernelState, key: Key) -> int {
    if key.family < 0 || key.family >= s.verifiers.length {
        avra_trap("defect: key names family ${key.family}, no such family is registered")
    }
    key.arg * s.verifiers.length + key.family
}

/// Hands one overwritten stamp back to the key it came from. Stamps
/// grow lazily to hold any key, so there is no missing-slot case to
/// guard against, unlike a `QueryCell`.
fn restore_one(mut s: KernelState, r: Restore) {
    write_stamp(s, r.key, r.previous)
}

fn state_cell(s: KernelState, key: Key) -> QueryCell? {
    let at = state_slot(s, key)
    let block = at / cell_chunk
    let offset = at % cell_chunk
    if block >= s.cells.length { return null }
    let row = s.cells[block].get()
    if offset >= row.length { return null }
    row[offset]
}

fn write_cell(mut s: KernelState, key: Key, cell: QueryCell) {
    let at = state_slot(s, key)
    let block = at / cell_chunk
    let offset = at % cell_chunk
    while s.cells.length <= block {
        let no_row: List<QueryCell?> = []
        s.cells.push(Cell.new(no_row))
    }
    while s.cells[block].get().length <= offset { s.cells[block].push(null) }
    s.cells[block].set_at(offset, cell)
}

/// The stamp at `key`'s slot, or 0 (never assigned — no reader id is
/// ever minted as 0) when its block or row has not grown that far.
fn state_stamp(s: KernelState, key: Key) -> int {
    let at = state_slot(s, key)
    let block = at / cell_chunk
    let offset = at % cell_chunk
    if block >= s.stamps.length { return 0 }
    let row = s.stamps[block].get()
    if offset >= row.length { return 0 }
    row[offset]
}

fn write_stamp(mut s: KernelState, key: Key, stamp: int) {
    let at = state_slot(s, key)
    let block = at / cell_chunk
    let offset = at % cell_chunk
    while s.stamps.length <= block {
        let no_row: List<int> = []
        s.stamps.push(Cell.new(no_row))
    }
    while s.stamps[block].get().length <= offset { s.stamps[block].push(0) }
    s.stamps[block].set_at(offset, stamp)
}

extern fn avra_trap(message: string)

fn never_verify(arg: int) -> int {
    avra_trap("defect: a disarmed query database was reused")
    arg
}
