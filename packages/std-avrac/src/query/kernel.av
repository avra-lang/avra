//! THE QUERY KERNEL — the compiler as a spreadsheet (L6, ps3t.8):
//! every step is a query that remembers its answer, the queries it
//! read (its deps, discovered by execution), the revision its answer
//! last CHANGED and the revision it was last VERIFIED. `ask` is the
//! red-green decision: a cell verified this revision is current;
//! otherwise its deps are re-verified through their families, and a
//! cell none of whose deps changed since its own verification is
//! re-marked current without running (green). A recomputed answer
//! whose hash is unchanged keeps its changed_at — the wave dies
//! there (early cutoff). A query that reaches itself is a CYCLE,
//! answered as such rather than recursed into. Inputs are cells the
//! driver sets. A key is a FAMILY number and the dense id the family
//! keys by — two list indexes, no strings. Values live in the
//! families' own typed tables; the kernel holds only bookkeeping.
use core.{list_cell, map_cell}
use @std.meta.{identity}

/// A cell's address: its family, and the dense id the family keys
/// by (a FileId, a DeclId).
export type Key = { family: int, arg: int }

export fn same_key(a: Key, b: Key) -> bool {
    a.family == b.family && a.arg == b.arg
}

export enum Verdict {
    Reuse
    Compute
    Cycle
}

/// A cached query's bookkeeping: the deps it discovered, the
/// revisions it last CHANGED and was last VERIFIED, and its answer's
/// hash. The last-reader stamp `record_dep` dedupes against lives
/// apart, in `KernelState.stamps` — a repeat read never touches this.
/// `value_hash` is NULL for a cell `settle_lazy` wrote whose fold was
/// never asked — its OWN state, never a sentinel a real fold could
/// equal (CLAUDE.md, "an encoding spends the empty value"): the
/// common case, since a key's first-ever settle has no prior to
/// compare against and nobody asks a fold to be thrown away unread.
type QueryCell = { deps: List<Key>, changed_at: int, verified_at: int, value_hash: int? }

/// A fresh cell for an input: no deps, changed and verified as of
/// `rev` alike (it was just set, so this revision is both).
fn input_cell(rev: int, value_hash: int) -> QueryCell {
    QueryCell { deps: [], changed_at: rev, verified_at: rev, value_hash: value_hash }
}

/// One stamp a frame overwrote and must hand back to whoever it took
/// it from — `record_dep`, `settle`.
type Restore = { key: Key, previous: int }

// A shared KernelState's cell list copies on write. Bound each copy to
// one short row rather than a table that grows with the program.
const cell_chunk: int = 256

type KernelState = {
    rev: int,
    /// ONE SLOT, SHARED — see `features/decls.av`'s member tables: a write must
    /// not copy the block.
    cells: List<Cell<List<QueryCell?>>>,
    // The last-reader stamps, chunked and addressed exactly as `cells`
    // is (same `state_slot`) but held apart from it: a stamp is a bare
    // int, so reading one never retains a `QueryCell` or its `deps`
    // list, and a repeat read touches nothing but this array.
    stamps: List<Cell<List<int>>>,
    verifiers: List<fn(int) -> int>,
    // One dependency list per open query, EACH IN ITS OWN CELL. A shared
    // `List` reaches a copy at every append, so a list routed through the
    // state copied its whole self per recorded read; a cell is a stable
    // box, so `push` on it appends in place.
    pending: List<Cell<List<Key>>>,
    open: List<Key>,
    // The open queries' own ids, parallel to `pending`/`open` — a
    // repeat read's LAST-READER STAMP (in `stamps`) is compared
    // against `reading.last()`, never against the key itself, so
    // recognizing "I already recorded this" costs one int compare.
    reading: List<int>,
    // One RESTORE LIST per open query, parallel to `pending` — null
    // until that frame's first STAMP OVERWRITE of a STILL-OPEN
    // ancestor's cell (most frames never nest into one, so most stay
    // null: no allocation at all on that path, only a bare slot in
    // this outer list). A NESTED query reading the same cell
    // overwrites its STAMP (one field, the last reader wins), so the
    // outer query's next read sees a mismatch that is not "never
    // read" — it is "read, then clobbered". `record_dep` saves the
    // clobbered value here; `settle` writes it back, so the ancestor
    // that resumes sees its own stamp again and its next read is the
    // one-compare fast path, same as if nothing had nested at all.
    restore: List<Cell<List<Restore>>?>,
    next_reader: int,
    hits: int,
    misses: int,
}

/// No key has been read in a fresh frame yet. `state_slot` traps
/// under a negative family, so this sentinel's family half names no
/// real query and never matches one — the arg half rides along
/// unchecked, since a match already needs the family half to agree.
const no_frame_slot: int = -1

/// A read that skipped `ask`, held for the outermost open query: which verb read
/// which subject (both the reader's own dense numbers), and the queries open when it
/// first happened.
export type Bypass = { verb: int, subject: int, frames: List<Key> }

/// THE DEPENDENCY AUDIT: off, it is one flag. On, a bypass read is held once per
/// (verb, subject) until the outermost query settles, then judged against the queries
/// that were open when it happened: a read none of them records a cover for is one no
/// witness of them could see, and goes to `sink`. `seen` marks the pairs held so far,
/// `touched` lists them for the reset.
@identity
export type Audit = {
    on: Cell<bool>,
    width: Cell<int>,
    held: Cell<List<Bypass>>,
    seen: Cell<List<bool>>,
    touched: Cell<List<int>>,
    exempt: Cell<fn(Bypass) -> bool>,
    covers: Cell<fn(Bypass) -> List<Key>>,
    sink: Cell<fn(Bypass) -> void>,
    visit: Cell<List<Cell<List<int>>>>,
    round: Cell<int>,
    reach: Cell<Map<string, bool>>,
}

/// A kernel is a shared handle. Copying it copies the handle; every
/// query family and verifier therefore sees the same revision, open
/// stack, dependencies, and counters.
@identity
export type Kernel = {
    state: Cell<KernelState>,
    /// The open frames' own last-recorded key, FLAT: each frame's
    /// family then arg, at `2*depth` and `2*depth+1` — an int write
    /// mints nothing, where a `Key` record write boxes one.
    /// Held apart from `state`: a repeat read of
    /// the frame's own last key costs one `Cell.get`, two indexed
    /// reads, two compares, never a `KernelState` snapshot. `begin`
    /// pushes two sentinel ints, `settle` pops two — a nested frame's
    /// pair sits above the outer's, so closing it exposes the outer's
    /// own pair exactly as it stood before the nesting.
    frame_last: Cell<List<int>>,
    audit: Audit,
}

fn unheard(_b: Bypass) {}

fn unexempt(_b: Bypass) -> bool { false }

fn uncovering(_b: Bypass) -> List<Key> { [] }

export fn new_kernel() -> Kernel {
    let state = KernelState {
        rev: 1,
        cells: [],
        stamps: [],
        verifiers: [],
        pending: [],
        open: [],
        reading: [],
        restore: [],
        next_reader: 0,
        hits: 0,
        misses: 0,
    }
    let no_frame_reads: List<int> = []
    Kernel {
        state: Cell.new(state),
        frame_last: Cell.new(no_frame_reads),
        audit: Audit {
            on: Cell.new(false),
            width: Cell.new(1),
            held: list_cell(),
            seen: list_cell(),
            touched: list_cell(),
            exempt: Cell.new(unexempt),
            covers: Cell.new(uncovering),
            sink: Cell.new(unheard),
            visit: list_cell(),
            round: Cell.new(0),
            reach: map_cell(),
        },
    }
}

impl Kernel {
    fn snapshot() -> KernelState { self.state.get() }

    /// Arms the audit for a reader with `width` verbs: `exempt` names the reads that need
    /// no dependency, `covers` the keys that would have recorded one, and `sink` hears
    /// each read no open query covered, when the outermost query settles.
    fn audit_to(
        width: int,
        exempt: fn(Bypass) -> bool,
        covers: fn(Bypass) -> List<Key>,
        sink: fn(Bypass) -> void,
    ) {
        self.audit.width.set(width)
        self.audit.exempt.set(exempt)
        self.audit.covers.set(covers)
        self.audit.sink.set(sink)
        self.audit.on.set(true)
    }

    /// Notes a read that skipped `ask`, for the outermost open query to judge — once per
    /// (verb, subject). With no query open, nothing depends on the read.
    fn bypassed(verb: int, subject: int) {
        if !self.audit.on.get() { return }
        let open = self.snapshot().open
        if open.is_empty() { return }
        let at = subject * self.audit.width.get() + verb
        while self.audit.seen.get().length <= at { self.audit.seen.push(false) }
        if self.audit.seen.get()[at] { return }
        self.audit.seen.set_at(at, true)
        self.audit.touched.push(at)
        self.audit.held.push(Bypass { verb: verb, subject: subject, frames: open })
    }

    /// The outermost query settled: every read held for it is judged against the queries
    /// that were open when it happened, whose deps are final now.
    fn judged() {
        if !self.snapshot().open.is_empty() { return }
        let held = self.audit.held.get()
        if held.is_empty() { return }
        let exempt = self.audit.exempt.get()
        let covers = self.audit.covers.get()
        let sink = self.audit.sink.get()
        for b in held {
            if !exempt(b) && !self.covered(b, covers(b)) { sink(b) }
        }
        for at in self.audit.touched.get() { self.audit.seen.set_at(at, false) }
        let no_touched: List<int> = []
        self.audit.touched.set(no_touched)
        let none: List<Bypass> = []
        self.audit.held.set(none)
        let unasked: Map<string, bool> = {}
        self.audit.reach.set(unasked)
    }

    /// Whether the cover is a query open at the read (the read is of a table that query
    /// is making), or the query that PERFORMED the read reaches it: every query is a cell
    /// verified on its own dependencies, so a cover only an ancestor reaches leaves the
    /// reader's own cell unsound.
    fn covered(b: Bypass, covers: List<Key>) -> bool {
        let reader? = b.frames.last() else { return true }
        covers.any((c: Key) -> b.frames.any((f: Key) -> same_key(c, f)) || self.reaches(reader, c))
    }

    /// Whether following `from`'s dependencies to the bottom meets `target`; answered once
    /// per (from, target) until the judging ends.
    fn reaches(from: Key, target: Key) -> bool {
        let asked = "${from.family}:${from.arg}>${target.family}:${target.arg}"
        let known? = self.audit.reach.get().get(asked) else {
            let found = self.searched(from, target)
            self.audit.reach.put(asked, found)
            return found
        }
        known
    }

    /// The search: each cell is visited once, stamped with a round the call opens.
    fn searched(from: Key, target: Key) -> bool {
        self.audit.round.set(self.audit.round.get() + 1)
        mut frontier = [from]
        while !frontier.is_empty() {
            mut below: List<Key> = []
            for k in frontier {
                for d in self.deps_of(k) {
                    if same_key(d, target) { return true }
                    if self.first_visit(d) { below.push(d) }
                }
            }
            frontier = below
        }
        false
    }

    /// Whether `k` has not yet been reached in this round; stamps it.
    fn first_visit(k: Key) -> bool {
        while self.audit.visit.get().length <= k.family {
            let row: Cell<List<int>> = list_cell()
            self.audit.visit.push(row)
        }
        let row = self.audit.visit.get()[k.family]
        while row.get().length <= k.arg { row.push(0) }
        let round = self.audit.round.get()
        if row.get()[k.arg] == round { return false }
        row.set_at(k.arg, round)
        true
    }

    fn replace(state: KernelState) { self.state.set(state) }

    fn revision() -> int { self.snapshot().rev }

    fn bump() {
        mut s = self.snapshot()
        s.rev = s.rev + 1
        self.replace(s)
    }

    fn family(verify: fn(int) -> int) -> int {
        mut s = self.snapshot()
        s.verifiers.push(verify)
        let ordinal = s.verifiers.length - 1
        self.replace(s)
        ordinal
    }

    /// Verifiers capture their workspace, which contains this handle.
    /// Replacing them breaks that ownership cycle after a one-shot run.
    fn disarm() {
        mut s = self.snapshot()
        s.verifiers = [never_verify for v in s.verifiers]
        self.replace(s)
    }

    fn set_input(key: Key, value_hash: int) {
        mut s = self.snapshot()
        let prior? = state_cell(s, key) else {
            write_cell(s, key, input_cell(state_revision(s), value_hash))
            self.replace(s)
            return
        }
        if prior.value_hash == value_hash {
            write_cell(
                s,
                key,
                prior with { deps: [], verified_at: state_revision(s), value_hash: value_hash },
            )
            self.replace(s)
            return
        }
        s.rev = state_revision(s) + 1
        write_cell(s, key, input_cell(state_revision(s), value_hash))
        self.replace(s)
    }

    fn ask(key: Key) -> Verdict {
        self.record_dep(key)
        let seen = self.snapshot()
        if seen.open.any(same_key(it, key)) { return Verdict.Cycle }
        let cell? = state_cell(seen, key) else { return self.miss() }
        if cell.verified_at == state_revision(seen) { return self.hit() }
        // Marked verified at this revision BEFORE its deps are walked: a
        // verifier may recursively update this database and re-enter this
        // key, and a re-entry reads the mark and reuses rather than walking
        // again. The mark names the revision the walk began at, so a late
        // write during the walk leaves it stale.
        mut marked = seen
        write_cell(marked, key, cell with { verified_at: state_revision(seen) })
        self.replace(marked)
        if self.any_dep_changed(cell) { return self.miss() }
        self.hit()
    }

    fn any_dep_changed(cell: QueryCell) -> bool {
        for d in cell.deps {
            if self.changed_after(d, cell.verified_at) { return true }
        }
        false
    }

    fn changed_after(dep: Key, since: int) -> bool {
        let verify = self.snapshot().verifiers[dep.family]
        verify(dep.arg) > since
    }

    fn active(key: Key) -> bool {
        self.snapshot().open.any(same_key(it, key))
    }

    /// Whether ANY key of a family is open — a query of that family is
    /// in flight. The kernel is language-agnostic, so the family is
    /// passed in.
    fn family_active(family: int) -> bool {
        self.snapshot().open.any(it.family == family)
    }

    /// The innermost open frame's own reader id — the same number
    /// `record_dep` stamps a cell with, so a repeat ask by the frame
    /// still running answers the SAME identity every time and two
    /// different frames never share one. -1 when nothing is open.
    fn reader() -> int {
        self.snapshot().reading.last() ?? 0 - 1
    }

    fn changed_at(key: Key) -> int {
        let s = self.snapshot()
        state_cell(s, key)?.changed_at ?? state_revision(s)
    }

    fn cell(key: Key) -> QueryCell? { state_cell(self.snapshot(), key) }

    /// The keys a settled cell reads, for a caller translating them
    /// into a durable witness's edges — the only reason to look inside
    /// a `QueryCell` from outside this file.
    fn deps_of(key: Key) -> List<Key> {
        let none: List<Key> = []
        state_cell(self.snapshot(), key)?.deps ?? none
    }

    /// A settled cell's own value hash — an edge's other half, read
    /// back once the dep it names has itself settled. NULL both for
    /// no cell at all and for one `settle_lazy` wrote whose fold was
    /// never asked — a reader that must tell those apart has no
    /// business forcing a fold nothing else needed; a reader that
    /// only composes this into ANOTHER fold should fold the absence
    /// itself as one more part (the arity law), never coalesce it
    /// into a plain int a real hash could also answer.
    fn value_hash_of(key: Key) -> int? {
        state_cell(self.snapshot(), key)?.value_hash
    }

    fn begin(key: Key) {
        mut s = self.snapshot()
        let none: List<Key> = []
        let no_restore: Cell<List<Restore>>? = null
        s.pending.push(Cell.new(none))
        s.restore.push(no_restore)
        s.open.push(key)
        s.next_reader = s.next_reader + 1
        s.reading.push(s.next_reader)
        self.replace(s)
        self.frame_last.push(no_frame_slot)
        self.frame_last.push(no_frame_slot)
    }

    fn settle(key: Key, value_hash: int) {
        mut s = self.snapshot()
        let deps = self.closed_frame(s)
        self
            .settled(
                s,
                key,
                deps,
                kept_since(state_cell(s, key), value_hash) ?? state_revision(s),
                value_hash,
            )
    }

    /// Like `settle`, but `fingerprint` is called AT MOST ONCE, and
    /// only when a PRIOR cell stands to compare it against — a fresh
    /// key (every key, on a cold compile: nothing has ever settled
    /// it before) costs nothing, since there is nothing yet to cut
    /// off against. A prior cell whose OWN hash was never asked (its
    /// one and only settle before this one, the same fresh case one
    /// key up) reads as unknown and this settle answers changed —
    /// conservative, never wrong, and the last imprecise transition:
    /// the hash THIS settle writes is always real, so every
    /// comparison after it is exact.
    fn settle_lazy(key: Key, fingerprint: fn() -> int) {
        mut s = self.snapshot()
        let deps = self.closed_frame(s)
        let prior? = state_cell(s, key) else {
            self.settled(s, key, deps, state_revision(s), null)
            return
        }
        let value_hash = fingerprint()
        self.settled(s, key, deps, kept_since(prior, value_hash) ?? state_revision(s), value_hash)
    }

    /// Closes the open query frame: its read deps, with the frame's
    /// restores replayed and its stacks popped.
    fn closed_frame(mut s: KernelState) -> List<Key> {
        let deps: List<Key> = s.pending.pop().get()
        let restored: Cell<List<Restore>>? = s.restore.pop()
        let _ = s.open.pop()
        let _ = s.reading.pop()
        mut fl = self.frame_last.get()
        let _ = fl.pop()
        let _ = fl.pop()
        self.frame_last.set(fl)
        if restored != null { for r in restored!.get() { restore_one(s, r) } }
        deps
    }

    /// Writes a settled cell, verified this revision, and publishes it.
    fn settled(mut s: KernelState, key: Key, deps: List<Key>, changed: int, value_hash: int?) {
        write_cell(
            s,
            key,
            QueryCell {
                deps: deps,
                changed_at: changed,
                verified_at: state_revision(s),
                value_hash: value_hash,
            },
        )
        self.replace(s)
        if self.audit.on.get() { self.judged() }
    }

    /// Two fast paths, cheapest first. THE FRAME PATH compares `key`
    /// against the OPEN FRAME'S OWN last-recorded key (`frame_last`,
    /// held apart from `state`, FLAT ints — see the field doc) — one
    /// `Cell.get`, two indexed reads, two compares, no `KernelState`
    /// snapshot at all — and answers most repeat reads, since a
    /// query's reads of one key cluster together. A miss there (a
    /// different key, or nothing recorded in this frame yet) falls to
    /// THE STAMP PATH: one flat-array read and one int compare,
    /// touching neither the cell table nor a `QueryCell`'s `deps`
    /// list. A MISMATCH is not always "never read": a NESTED query
    /// reading the same key overwrites the stamp with ITS OWN reader
    /// id, so the outer query's next read of that key mismatches too,
    /// though it already recorded the dep. The two are told apart by
    /// asking whether the STAMP BEING OVERWRITTEN belongs to a
    /// STILL-OPEN frame (`reading.contains`, a scan of the open stack
    /// — a handful of ints deep, never the program's dep count): if
    /// so, that frame will read this key again and must see its own
    /// stamp restored, so the value is saved (`save_restore`, lazily
    /// minting the frame's own restore list); if not — a genuinely
    /// new dep, or a stamp some now-closed query left behind —
    /// nothing will ever ask for it again, so nothing is saved.
    /// Either way — stamp hit or genuinely new dep — `key` becomes
    /// this frame's new last key, so its NEXT read takes the frame
    /// path. ONE fn, not two: a split tried here paid a second
    /// prologue on every miss (`record_dep_miss`, avra-8sb5.57.56)
    /// for a hit-path saving smaller than that cost — kbench's altkey
    /// and newdep modes both got slower, so the fn stayed whole.
    fn record_dep(key: Key) {
        let fl = self.frame_last.get()
        if fl.is_empty() { return }
        let fam_at = fl.length - 2
        if fl[fam_at] == key.family && fl[fam_at + 1] == key.arg { return }
        mut s = self.snapshot()
        let reader = s.reading.last() ?? 0
        let stamp = state_stamp(s, key)
        if stamp != reader {
            if s.reading.contains(stamp) { self.save_restore(s, key, stamp) }
            write_stamp(s, key, reader)
            s.pending.last()!.push(key)
            self.replace(s)
        }
        // Read afresh: an index held live across this branch's calls
        // pins a register through all of them, which costs more than a
        // second `Cell.get` here.
        let end_at = self.frame_last.get().length - 2
        self.frame_last.set_at(end_at, key.family)
        self.frame_last.set_at(end_at + 1, key.arg)
    }

    /// Remembers a stamp `record_dep` is about to overwrite, so
    /// `settle` can hand it back to the frame it belonged to. Lazily
    /// mints this frame's own restore list on its first entry — the
    /// common, no-nesting case never allocates one at all; every later
    /// entry in the same frame just pushes onto the `Cell` already
    /// there, in place.
    fn save_restore(mut s: KernelState, key: Key, previous: int) {
        let idx = s.restore.length - 1
        let entry = Restore { key: key, previous: previous }
        let frame? = s.restore[idx] else {
            s.restore.set(idx, Cell.new([entry]))
            self.replace(s)
            return
        }
        frame.push(entry)
    }

    fn sweep() {
        let s = self.snapshot()
        let rev = state_revision(s)
        for row in s.cells {
            for j, held in row.get() {
                if held != null && held!.verified_at != rev { row.set_at(j, null) }
            }
        }
        self.replace(s)
    }

    /// Remove every cell in one family. Typed memo storage must be
    /// evicted with it, so a later ask cannot reuse bookkeeping after
    /// its value has been released.
    fn evict_family(family: int) {
        mut s = self.snapshot()
        mut at = family
        let stride = s.verifiers.length
        while at < s.cells.length * cell_chunk {
            let block = at / cell_chunk
            let offset = at % cell_chunk
            if offset < s.cells[block].get().length {
                s.cells[block].set_at(offset, null)
            }
            at = at + stride
        }
        self.replace(s)
    }

    fn hit() -> Verdict {
        mut s = self.snapshot()
        s.hits = s.hits + 1
        self.replace(s)
        Verdict.Reuse
    }

    fn miss() -> Verdict {
        mut s = self.snapshot()
        s.misses = s.misses + 1
        self.replace(s)
        Verdict.Compute
    }

    fn stats() -> string {
        let s = self.snapshot()
        "rev ${state_revision(s)}: ${s.hits} hits, ${s.misses} misses"
    }
}

fn state_revision(s: KernelState) -> int { s.rev }

// A bound check by length compare, not by indexing `verifiers`: that
// index would answer a `fn` value nobody wants, and retaining one to
// discard it is the one cost this slot math must never carry — it
// runs on every dep read, hit or miss.
fn state_slot(s: KernelState, key: Key) -> int {
    if key.family < 0 || key.family >= s.verifiers.length {
        avra_trap("defect: key names family ${key.family}, no such family is registered")
    }
    key.arg * s.verifiers.length + key.family
}

/// Hands one overwritten stamp back to the key it came from. Stamps
/// grow lazily to hold any key, so there is no missing-slot case to
/// guard against, unlike a `QueryCell`.
fn restore_one(mut s: KernelState, r: Restore) {
    write_stamp(s, r.key, r.previous)
}

/// The revision a prior cell last changed at, when its hash matches —
/// absent when there is no prior or the answer moved.
fn kept_since(prior: QueryCell?, value_hash: int) -> int? {
    if prior?.value_hash == value_hash { prior?.changed_at } else { null }
}

fn state_cell(s: KernelState, key: Key) -> QueryCell? {
    let at = state_slot(s, key)
    let block = at / cell_chunk
    let offset = at % cell_chunk
    if block >= s.cells.length { return null }
    let row = s.cells[block].get()
    if offset >= row.length { return null }
    row[offset]
}

fn write_cell(mut s: KernelState, key: Key, cell: QueryCell) {
    let at = state_slot(s, key)
    let block = at / cell_chunk
    let offset = at % cell_chunk
    while s.cells.length <= block {
        let no_row: List<QueryCell?> = []
        s.cells.push(Cell.new(no_row))
    }
    while s.cells[block].get().length <= offset { s.cells[block].push(null) }
    s.cells[block].set_at(offset, cell)
}

/// The stamp at `key`'s slot, or 0 (never assigned — no reader id is
/// ever minted as 0) when its block or row has not grown that far.
fn state_stamp(s: KernelState, key: Key) -> int {
    let at = state_slot(s, key)
    let block = at / cell_chunk
    let offset = at % cell_chunk
    if block >= s.stamps.length { return 0 }
    let row = s.stamps[block].get()
    if offset >= row.length { return 0 }
    row[offset]
}

fn write_stamp(mut s: KernelState, key: Key, stamp: int) {
    let at = state_slot(s, key)
    let block = at / cell_chunk
    let offset = at % cell_chunk
    while s.stamps.length <= block {
        let no_row: List<int> = []
        s.stamps.push(Cell.new(no_row))
    }
    while s.stamps[block].get().length <= offset { s.stamps[block].push(0) }
    s.stamps[block].set_at(offset, stamp)
}

extern fn avra_trap(message: string)

fn never_verify(arg: int) -> int {
    avra_trap("defect: a disarmed query database was reused")
    arg
}
