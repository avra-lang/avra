// proves: a read of a negative arg inside an open query is refused by
// name — an edge has no room for one
use @std.avrac.query.{new_kernel, Key}

let db = new_kernel()
let fam = db.family((arg: int) -> 0)
db.begin(Key { family: fam, arg: 0 })
db.record_at(fam, 0 - 1)
db.settle(Key { family: fam, arg: 0 }, 1)
db.revision()
