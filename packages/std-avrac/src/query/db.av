//! THE QUERY KERNEL — the compiler as a spreadsheet (L6, ps3t.8):
//! every step is a query that remembers its answer, the queries it
//! read (its deps, discovered by execution), the revision its answer
//! last CHANGED and the revision it was last VERIFIED. `ask` is the
//! red-green decision: a cell verified this revision is current;
//! otherwise its deps are re-verified through their families, and a
//! cell none of whose deps changed since its own verification is
//! re-marked current without running (green). A recomputed answer
//! whose hash is unchanged keeps its changed_at — the wave dies
//! there (early cutoff). A query that reaches itself is a CYCLE,
//! answered as such rather than recursed into. Inputs are cells the
//! driver sets. A key is a FAMILY number and the dense id the family
//! keys by — two list indexes, no strings. Values live in the
//! families' own typed tables; the kernel holds only bookkeeping.
/// A cell's address: its family, and the dense id the family keys
/// by (a FileId, a DeclId).
export type Key = { family: int, arg: int }

export fn same_key(a: Key, b: Key) -> bool {
    a.family == b.family && a.arg == b.arg
}

/// The red-green verdict for a derived query.
export enum Verdict {
    /// The held value is current.
    Reuse
    /// Run the query; `begin` and `settle` bracket it.
    Compute
    /// The query is already running above this ask.
    Cycle
}

type Cell = { deps: List<Key>, changed_at: int, verified_at: int, value_hash: int }

/// The revision, hits and misses are one-cell lists (the mut-cell
/// protocol). `cells` is ONE flat list, ARG-MAJOR — the cell of
/// (family, arg) sits at `arg * families + family` — so a write is
/// one element set through the field and growing the arg space is an
/// append, never a copied row (a row nested in a list copies on
/// every write). `verifiers` by family — the fn that re-fetches one
/// of its keys and answers the cell's changed_at. `deps` is every
/// open computation's reads, flat, and `marks` where each frame
/// began; `open` is the stack of queries computing now.
export type Db = {
    rev: List<int>,
    cells: List<Cell?>,
    verifiers: List<fn(int) -> int>,
    deps: List<Key>,
    marks: List<int>,
    open: List<Key>,
    hits: List<int>,
    misses: List<int>,
}

export fn new_db() -> Db {
    Db { rev: [1], cells: [], verifiers: [], deps: [], marks: [], open: [], hits: [0], misses: [0] }
}

impl Db {
    fn revision() -> int { self.rev[0] }

    /// An input changed (or arrived): the revision advances.
    fn bump() {
            self.rev.set(0, self.rev[0] + 1)
    }

    /// A family registered with its verifier; its number answers.
    /// Every family registers before any cell is written — the
    /// layout's stride is their count.
    fn family(verify: fn(int) -> int) -> int {
        self.verifiers.push(verify)
        self.verifiers.length - 1
    }

    /// Where a key's cell sits in the flat list. An unregistered
    /// family would alias another's cells silently; reading its
    /// verifier first keeps the old row layout's trap.
    fn slot(key: Key) -> int {
        let _ = self.verifiers[key.family]
        key.arg * self.verifiers.length + key.family
    }

    /// The driver sets an INPUT: a cell with no deps whose changed_at
    /// advances only when the hash moved.
    fn set_input(key: Key, value_hash: int) {
        let prior: Cell? = self.cell(key)
        if prior != null && prior!.value_hash == value_hash {
            self.write(key, Cell { deps: [], changed_at: prior!.changed_at, verified_at: self.revision(), value_hash: value_hash })
            return
        }
        if prior != null { self.bump() }
        self.write(key, Cell { deps: [], changed_at: self.revision(), verified_at: self.revision(), value_hash: value_hash })
    }

    /// The red-green decision for a derived query, recording the
    /// read in the open frame.
    fn ask(key: Key) -> Verdict {
        self.record_dep(key)
        if self.open.any(same_key(it, key)) { return Verdict.Cycle }
        let held: Cell? = self.cell(key)
        if held == null { return self.miss() }
        let cell = held!
        if cell.verified_at == self.revision() { return self.hit() }
        if self.any_dep_changed(cell) { return self.miss() }
        self.write(key, Cell { deps: cell.deps, changed_at: cell.changed_at, verified_at: self.revision(), value_hash: cell.value_hash })
        self.hit()
    }

    /// Re-verify each dep through its family; true when one changed
    /// after this cell was last verified.
    fn any_dep_changed(cell: Cell) -> bool {
        for d in cell.deps {
            if self.changed_after(d, cell.verified_at) { return true }
        }
        false
    }

    fn changed_after(dep: Key, since: int) -> bool {
        let verify = self.verifiers[dep.family]
        verify(dep.arg) > since
    }

    /// Whether a computation of this key is open right now.
    fn active(key: Key) -> bool {
        self.open.any(same_key(it, key))
    }

    /// The cell's changed_at, or the current revision for a key the
    /// kernel has never seen (an unknown is always new).
    fn changed_at(key: Key) -> int {
        self.cell(key)?.changed_at ?? self.revision()
    }

    /// A computation begins: its reads land after a fresh mark, and
    /// it is open until it settles.
    fn begin(key: Key) {
        // LICENSED I15: the bracketed VALUE is the caller's — a thunk cannot carry a generic answer (F1002)
        self.marks.push(self.deps.length)
        // LICENSED I15: the open stack brackets the same computation
        self.open.push(key)
    }

    /// A computation ends: the reads since its mark become the
    /// cell's deps and leave the flat list; an unchanged hash keeps
    /// changed_at (early cutoff).
    fn settle(key: Key, value_hash: int) {
        let start = self.marks.pop() ?? 0
        let deps = self.deps.slice(start, self.deps.length)
        while self.deps.length > start { let _ = self.deps.pop() }
        let _ = self.open.pop()
        let prior: Cell? = self.cell(key)
        let changed = if prior != null && prior!.value_hash == value_hash { prior!.changed_at } else { self.revision() }
        self.write(key, Cell { deps: deps, changed_at: changed, verified_at: self.revision(), value_hash: value_hash })
    }

    /// A read lands in the open frame — one push, no frame copied.
    fn record_dep(key: Key) {
        if self.marks.is_empty() { return }
        self.deps.push(key)
    }

    fn cell(key: Key) -> Cell? {
        let at = self.slot(key)
        if at >= self.cells.length { return null }
        let held: Cell? = self.cells[at]
        held
    }

    /// One element set through the field; the arg space grows by
    /// appending a stride of absences.
    fn write(key: Key, cell: Cell) {
        let at = self.slot(key)
        while self.cells.length <= at { self.cells.push(null) }
        self.cells.set(at, cell)
    }

    /// Cells not verified this revision are dead: dropped, so a
    /// long-lived kernel holds only what the last full pass touched.
    fn sweep() {
        for i, held in self.cells {
            if held != null && held!.verified_at != self.revision() { self.cells.set(i, null) }
        }
    }

    fn hit() -> Verdict {
            self.hits.set(0, self.hits[0] + 1)
        Verdict.Reuse
    }

    fn miss() -> Verdict {
            self.misses.set(0, self.misses[0] + 1)
        Verdict.Compute
    }

    /// The counters, rendered — `--time`'s cache line.
    fn stats() -> string {
        "rev ${self.revision()}: ${self.hits[0]} hits, ${self.misses[0]} misses"
    }
}
