//! A GROWING-SET FIXPOINT over a group of mutually-dependent members —
//! one dense family, semi-naive: every member runs once, then only a
//! member that read something whose answer grew runs again, until
//! nothing does. `failures.av`'s header names why the kernel's own
//! `Cycle`/`start_recursive` isn't this: those answer ONE re-entrant
//! call with a snapshot, once; this re-visits every member of a group
//! repeatedly until a genuine fixpoint, over a caller-DECLARED join.
//! `Fixpoint<T>` wraps a `Kernel` exactly as `Memo<T>` does — the
//! kernel holds hash bookkeeping alone, this holds the typed lattice
//! values, the join, and the worklist.
//!
//! REVERSE EDGES ARE SCOPED TO THE GROUP, NEVER GLOBAL: built from
//! each member's own forward deps (already recorded by `settle`, read
//! back via `Kernel.cell`), and refreshed on every re-run — a member
//! that starts reading a new one mid-solve is found by that one's
//! later growth from that point on, and one that stops reading
//! something stops being woken by it. `record_dep`/`ask`/`settle`
//! carry no new cost for this: nothing here changes them.
//!
//! A MISDECLARED LATTICE IS THE CALLER'S ERROR, NEVER THE COMPILER'S
//! DEFECT: `solve` answers `Result<int, FixpointRefusal>` rather than
//! trapping, so a bad join or an unbounded height is a value a caller
//! (eventually `@query(fixpoint)`'s own generated wrapper) can turn
//! into a diagnostic at the declaration it came from.
use core.{Table, new_table}
use @std.meta.{identity, plain_field}

/// `values` is the shared lattice table; the rest is this family's
/// own config, fixed at registration.
@identity
@plain_field("family")
@plain_field("bottom")
@plain_field("join")
@plain_field("fp")
@plain_field("turn_cap")
export type Fixpoint<T> = {
    db: Kernel,
    // plain for its identity: registered once at the family's
    // construction, then read only
    family: int,
    // plain for its identity: registered once, then read only
    bottom: T,
    // plain for its identity: registered once, then read only
    join: fn(T, T) -> T,
    // plain for its identity: registered once, then read only
    fp: fn(T) -> int,
    // plain for its identity: minted lazily on first `solve`, then
    // read only — see `scc_key`
    frame_family: Cell<int>,
    values: Table<T>,
    // plain for its identity: set at registration, `with` swaps in
    // a fresh value rather than writing through a path
    turn_cap: int,
}

/// Past this many re-runs of one member, the body is a defect (a
/// non-monotone join, or a lattice with no finite height). Members,
/// not rounds: each queue pop counts toward its own member's cap
/// alone. `with { turn_cap: … }` lowers it — a suite proving the cap
/// fires needs it small, not 10000 real turns.
const default_turn_cap: int = 10000

export fn new_fixpoint<T>(db: Kernel, family: int, bottom: T, join: fn(T, T) -> T, fp: fn(T) -> int) -> Fixpoint<
    T,
> {
    Fixpoint {
        db: db,
        family: family,
        bottom: bottom,
        join: join,
        fp: fp,
        frame_family: Cell.new(0 - 1),
        values: new_table<T>(),
        turn_cap: default_turn_cap,
    }
}

/// Why `solve` refused a group, named by the law it found broken — the
/// words a caller reports ARE the law (`spoken`, below), never a
/// paraphrase.
export enum FixpointRefusal {
    NotIdempotent(family: int)
    NotCommutative(family: int)
    Identity(family: int)
    TurnCap(family: int, arg: int, cap: int)
}

impl Fixpoint {
    fn query_key(arg: int) -> Key { Key { family: self.family, arg: arg } }

    /// The whole solve's own frame — one key, never a member's,
    /// minted on first use. A read made before any member's own frame
    /// exists (the law-check sample) or between two members' turns
    /// still lands somewhere: here, never in whatever frame happened
    /// to be open in the CALLER that reached this fixpoint at all.
    fn scc_key() -> Key {
        let known = self.frame_family.get()
        if known >= 0 { return Key { family: known, arg: 0 } }
        let minted = self.db.family((arg: int) -> 0)
        self.frame_family.set(minted)
        Key { family: minted, arg: 0 }
    }

    /// The current best-known answer — `bottom` before anything settles.
    /// Records a dependency on `arg`, so a `compute` body reading a
    /// FELLOW MEMBER through this (rather than through `self.db.ask`
    /// directly) is still found by `index`/`reindex` afterward — the
    /// read that makes the worklist propagate at all.
    fn value_at(arg: int) -> T {
        self.db.record_at(self.family, arg)
        self.values.at(arg) ?? self.bottom
    }

    /// One member's own re-run: `compute(arg)` answers fresh, joined
    /// onto what is already known. Answers whether the joined value
    /// GREW (its hash moved) — never merely whether it ran. `arg`'s
    /// own FIRST non-bottom answer is checked against the identity law
    /// before it is kept — the one hash-visible law a meet cannot pass.
    fn step(arg: int, compute: fn(int) -> T) -> Result<bool, FixpointRefusal> {
        let key = self.query_key(arg)
        self.db.begin(key)
        let current = self.value_at(arg)
        let before = self.fp(current)
        let computed = compute(arg)
        let bottom_fp = self.fp(self.bottom)
        // Checked on the RAW contribution, before joining: a meet from
        // bottom answers bottom again (`∅ ∩ x = ∅`), so gating this on
        // whether the JOINED value grew would never fire for exactly
        // the case it exists to catch.
        if before == bottom_fp &&
            self.fp(computed) != bottom_fp &&
            !self.keeps_what_its_given(computed) {
            return .Err(FixpointRefusal.Identity(self.family))
        }
        let joined = self.join(current, computed)
        let hash = self.fp(joined)
        self.values.keep(arg, joined)
        self.db.settle(key, hash)
        .Ok(hash != before)
    }

    /// The one law a hash CAN test directly that idempotence and
    /// commutativity cannot: a real join keeps what it is given.
    /// `join(bottom, x)` failing to equal `x` is exactly a MEET's
    /// signature — `bottom ∩ x = bottom` the moment `x` is not itself
    /// bottom — so this is the check that finally closes that gap.
    fn keeps_what_its_given(x: T) -> bool { self.fp(self.join(self.bottom, x)) == self.fp(x) }

    /// This member's own just-recorded forward deps, read straight off
    /// the kernel cell `settle` just wrote — never re-derived by hand.
    fn deps_of(arg: int) -> List<Key> { self.db.deps_of(self.query_key(arg)) }

    /// This member's forward deps filed as a reader under each dep's
    /// own arg — only the deps THIS family owns; a read of something
    /// outside the group cannot re-trigger anyone in it.
    fn index(arg: int, reverse: Table<List<int>>) {
        for d in self.deps_of(arg) {
            if d.family == self.family {
                let readers = reverse.at(d.arg) ?? []
                if !readers.contains(arg) { reverse.keep(d.arg, readers.concat([arg])) }
            }
        }
    }

    /// `arg`'s edges into `reverse`, replaced by its FRESH deps. Its
    /// old edges are not at hand (only the new list is), so every
    /// bucket is swept once — bounded by the GROUP's own size, never
    /// the whole program's.
    fn reindex(arg: int, reverse: Table<List<int>>) {
        for d_arg in 0..reverse.span() {
            let readers = reverse.at(d_arg) ?? []
            if readers.contains(arg) { reverse.keep(d_arg, [r for r in readers if r != arg]) }
        }
        self.index(arg, reverse)
    }

    /// The two algebraic laws a hash can check on ONE sample before any
    /// member's kernel cell is touched. Idempotence and commutativity
    /// alone cannot tell a real join from a MEET (intersection passes
    /// both), which `keeps_what_its_given` closes instead, checked
    /// separately in `step` at each member's own first non-bottom
    /// answer.
    fn refused_join(seed: T) -> FixpointRefusal? {
        let mixed = self.join(self.bottom, seed)
        let idempotent = self.join(mixed, mixed)
        if self.fp(idempotent) != self.fp(mixed) { return FixpointRefusal.NotIdempotent(self.family) }
        let ab = self.join(self.bottom, mixed)
        let ba = self.join(mixed, self.bottom)
        if self.fp(ab) != self.fp(ba) { return FixpointRefusal.NotCommutative(self.family) }
        null
    }

    /// Solve the fixpoint over `members`, each answered by `compute`,
    /// the whole run inside ONE frame of its own (`scc_key`) — settled
    /// on every exit, `solve_within`'s answer whatever it is, so a
    /// refused law or a blown turn cap still closes it.
    fn solve(members: List<int>, compute: fn(int) -> T) -> Result<int, FixpointRefusal> {
        let scc = self.scc_key()
        self.db.begin(scc)
        let result = self.solve_within(members, compute)
        self.db.settle(scc, 0)
        result
    }

    fn solve_within(members: List<int>, compute: fn(int) -> T) -> Result<int, FixpointRefusal> {
        if !members.is_empty() {
            let refusal = self.refused_join(compute(members[0]))
            if refusal != null { return .Err(refusal!) }
        }
        for m in members { let _ = self.step(m, compute)? }
        let reverse: Table<List<int>> = new_table<List<int>>()
        for m in members { self.index(m, reverse) }
        mut queue: List<int> = members
        let turns: Table<int> = new_table<int>()
        mut steps = members.length
        while !queue.is_empty() {
            let m = queue[0]
            queue = [queue[i] for i in 1..queue.length]
            let count = (turns.at(m) ?? 0) + 1
            if count > self.turn_cap { return .Err(FixpointRefusal.TurnCap(self.family, m, self.turn_cap)) }
            turns.keep(m, count)
            steps = steps + 1
            if self.step(m, compute)? {
                self.reindex(m, reverse)
                for r in reverse.at(m) ?? [] {
                    if !queue.contains(r) { queue = queue.concat([r]) }
                }
            }
        }
        .Ok(steps)
    }
}

// ── Voices ──

/// The law a refusal names, in the caller's own words — never a
/// paraphrase of the enum tag.
export fn spoken(r: FixpointRefusal) -> string {
    match r {
        .NotIdempotent(f) -> not_idempotent_voice(f),
        .NotCommutative(f) -> not_commutative_voice(f),
        .Identity(f) -> identity_voice(f),
        .TurnCap(f, arg, cap) -> turn_cap_voice(f, arg, cap),
    }
}

fn not_idempotent_voice(family: int) -> string {
    "family ${family}'s join is not idempotent — join(v, v) must equal v"
}

fn not_commutative_voice(family: int) -> string {
    "family ${family}'s join is not commutative — join(a, b) must equal join(b, a)"
}

fn identity_voice(family: int) -> string {
    "family ${family}'s join must keep what it's given — join(bottom, x) must be x"
}

fn turn_cap_voice(family: int, arg: int, cap: int) -> string {
    "family ${family} member ${arg} exceeded ${cap} turns — a non-monotone body, or a lattice with no finite height"
}
