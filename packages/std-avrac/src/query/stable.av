//! STABLE ENCODINGS — a hash and a byte codec that answer from a value's
//! CONTENT alone: never a dense id, an address, or the process that
//! built it, so an answer written by one process is checked by the next.
//!
//! Every variable-length part carries its own length or count ahead of
//! it, and every `?` layer its own presence flag: the arity is fixed per
//! kind, so no two shapes spell the same bytes. The hash mixes at every
//! step — a mix only at the end keeps every collision a linear fold made
//! on the way.

/// splitmix64's finalizer: a nonlinear 64-bit mix.
export fn mix(x: int) -> int {
    let a = (x ^ shifted(x, 30)) * -4658895280553007687
    let b = (a ^ shifted(a, 27)) * -7723592293110705685
    b ^ shifted(b, 31)
}

/// `z` shifted right by `k` with zeros in from the top — `>>` carries
/// the sign bit.
fn shifted(z: int, k: int) -> int {
    (z >> k) & (1 << 64 - k) - 1
}

/// A hash under construction — one word, so it rides a register and a
/// field costs no allocation.
export type StableHasher = { z: int }

export fn stable_hasher(seed: int) -> StableHasher {
    StableHasher { z: mix(seed) }
}

/// A text's own stable hash — the seed a relation's stable name gives
/// its rows.
export fn text_hash(s: string) -> int {
    stable_hasher(0).text(s).finish()
}

/// A multiset's hash: the wrapping sum of its members' finished hashes —
/// order-free, and a duplicate counts twice. The empty set is zero.
export fn set_hash(hashes: List<int>) -> int {
    mut sum = 0
    for h in hashes { sum = sum + h }
    sum
}

impl StableHasher {
    fn word(w: int) -> StableHasher { StableHasher { z: mix(self.z ^ w) } }

    fn int(v: int) -> StableHasher { self.word(v) }

    fn bool(v: bool) -> StableHasher { self.word(flag(v)) }

    /// One `?` layer: whether a value is there.
    fn present(p: bool) -> StableHasher { self.bool(p) }

    /// A list's length, ahead of its elements.
    fn count(n: int) -> StableHasher { self.word(n) }

    fn text(s: string) -> StableHasher { self.octets(s.bytes()) }

    /// The length first, then every eight octets as one little-endian
    /// word.
    fn octets(b: Bytes) -> StableHasher {
        mut h = self.word(b.length)
        // LICENSED loops.index_walk: a stride of eight — no element walk says it
        mut at = 0
        while at < b.length {
            h = h.word(word_at(b, at))
            at = at + 8
        }
        h
    }

    fn finish() -> int { mix(self.z) }
}

/// Up to eight octets from `at`, little-endian; the length ahead of
/// them says where a short final word ends.
fn word_at(b: Bytes, at: int) -> int {
    mut w = 0
    for k in 0..8 {
        if at + k < b.length { w = w | (b.at(at + k) << 8 * k) }
    }
    w
}

fn flag(v: bool) -> int {
    if v { 1 } else { 0 }
}

// ── The codec ──

/// A record under construction, as octets.
export type Writer = { out: List<int> }

export fn writer() -> Writer {
    Writer { out: [] }
}

impl Writer {
    fn byte(v: int) { self.out.push(v & 255) }

    /// Unsigned LEB128 over all 64 bits: seven at a time, low first.
    fn varint(v: int) {
        mut rest = v
        while rest < 0 || rest > 127 {
            self.byte((rest & 127) | 128)
            rest = shifted(rest, 7)
        }
        self.byte(rest)
    }

    /// Zigzag, so a small negative is a short varint.
    fn int(v: int) { self.varint((v << 1) ^ (v >> 63)) }

    fn bool(v: bool) { self.byte(flag(v)) }

    fn present(p: bool) { self.bool(p) }

    fn count(n: int) { self.varint(n) }

    fn text(s: string) { self.octets(s.bytes()) }

    fn octets(b: Bytes) {
        self.count(b.length)
        for i in 0..b.length { self.byte(b.at(i)) }
    }

    fn bytes() -> Bytes { self.out.bytes()! }
}

/// Why a record does not decode. A record that does not decode is
/// dropped and recomputed, never guessed at.
export enum CodecFault {
    Truncated
    Overlong
    NotFlag
    NotText
}

impl CodecFault {
    fn word() -> string {
        match self {
            .Truncated -> "truncated",
            .Overlong -> "overlong",
            .NotFlag -> "not_flag",
            .NotText -> "not_text",
        }
    }
}

/// A record being read: its octets and the position reached.
export type Reader = { b: Bytes, at: int }

export fn reader(b: Bytes) -> Reader {
    Reader { b: b, at: 0 }
}

impl Reader {
    fn byte() -> Result<int, CodecFault> {
        if self.at >= self.b.length { fail CodecFault.Truncated }
        let v = self.b.at(self.at)
        self.at = self.at + 1
        v
    }

    fn varint() -> Result<int, CodecFault> {
        mut v = 0
        for k in 0..10 {
            let o = self.byte()?
            v = v | ((o & 127) << 7 * k)
            if o < 128 { return v }
        }
        fail CodecFault.Overlong
    }

    fn int() -> Result<int, CodecFault> {
        let z = self.varint()?
        shifted(z, 1) ^ 0 - (z & 1)
    }

    fn bool() -> Result<bool, CodecFault> {
        match self.byte()? { 0 -> false, 1 -> true, rest -> { fail CodecFault.NotFlag } }
    }

    fn present() -> Result<bool, CodecFault> { self.bool() }

    /// A count, never past what is left to read.
    fn count() -> Result<int, CodecFault> {
        let n = self.varint()?
        if n < 0 || n > self.b.length - self.at { fail CodecFault.Truncated }
        n
    }

    fn octets() -> Result<Bytes, CodecFault> {
        let n = self.count()?
        let part = self.b.slice(self.at, self.at + n)
        self.at = self.at + n
        part
    }

    fn text() -> Result<string, CodecFault> {
        let s? = (self.octets()?).text() else { fail CodecFault.NotText }
        s
    }

    /// Whether every octet has been read.
    fn done() -> bool { self.at == self.b.length }
}
