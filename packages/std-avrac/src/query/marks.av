//! One small int per key, family by family — a walk's own marks over the
//! kernel's keys, 0 for a key no walk has marked.
use core.{list_cell}

export type KeyMarks = { rows: Cell<List<Cell<List<int>>>> }

export fn no_key_marks() -> KeyMarks { KeyMarks { rows: list_cell() } }

impl KeyMarks {
    fn mark_of(k: Key) -> int {
        let rows = self.rows.get()
        if k.family >= rows.length { return 0 }
        let row = rows[k.family].get()
        if k.arg >= row.length { 0 } else { row[k.arg] }
    }

    fn mark(k: Key, v: int) {
        while self.rows.get().length <= k.family {
            let row: Cell<List<int>> = list_cell()
            self.rows.push(row)
        }
        let row = self.rows.get()[k.family]
        while row.get().length <= k.arg { row.push(0) }
        row.set_at(k.arg, v)
    }
}
