//! WHAT A FN MEANS: its body with every sugar's meaning spliced beside it, as the sugar's feature
//! states it in a `meaning`, and the whole typed again as the core it means. A sugar is typed twice,
//! by its own rule on the surface and as its meaning in the core, and the two agree, or the core
//! answers the type its seat wants and the surface's type fits that seat, or a meaning is wrong.
use core.{At, ExprId, SignedType, StmtId, SyntaxArena, flatten, minting}
use @std.meta.{Rewrite}
use features.{TypedCode, TypedItem, TypedView}
use @std.program.address.{SourceFileAddress}
use @std.program.query_engine.{QueryEngine}

/// A fn's body and what it means: the store holding both, each sugar given a meaning, each
/// expression's type on the surface, and its type in the core.
export type ElaboratedBody = {
    store: SyntaxArena,
    sugars: List<ExprId>,
    /// The statements a meaning rewrote.
    statements: List<StmtId>,
    surface: List<SignedType?>,
    core: List<SignedType?>,
    /// The type each node's seat wanted in the core, by the node's index, where its seat names one.
    seats: Map<string, SignedType>,
}

impl ElaboratedBody {
    /// The type the seat of the node at `index` wanted in the core, absent where it names none.
    fn seat_at(index: int) -> SignedType? { self.seats.get("${index}") }
}

/// The body of the fn `file` declares as `name`, elaborated; absent when it declares none with a
/// body.
export fn elaborated_fn(engine: QueryEngine, file: SourceFileAddress, name: string) -> ElaboratedBody? {
    let signed? = signed_body(engine, file, name) else { return null }
    let store = signed.item.store
    let typed = TypedItem {
        view: TypedView { store: store },
        types: body_checked(engine, file, signed, false).types.get(),
    }
    let statements = [s for s in every_stmt(store, At.Expr(signed.body)) if stmt_meant_beside(typed, s)]
    let sugars = [e for e in store.every_expr(signed.body) if meant_beside(typed, e)]
    let core = body_checked(engine, file, signed, true)
    ElaboratedBody {
        store: store,
        sugars: sugars,
        statements: statements,
        surface: typed.types,
        core: core.types.get(),
        seats: core.seats.get(),
    }
}

/// Whether `e` is a sugar some meaning rewrites, its meaning then spliced beside it: the first of
/// the meanings filed under it whose arms match. A node the parse already gave a meaning keeps
/// that one.
fn meant_beside(typed: TypedItem, e: ExprId) -> bool {
    let store = typed.view.store
    if store.meant(e) != null { return false }
    let said? = meaning_said(typed, At.Expr(e)) else { return false }
    let made = rewritten_beside(avra(), store, e, said.rewrite)
    if made.is_empty() { return false }
    store.means_as(e, minting(made), "`${said.by}`")
    true
}

/// Whether `s` is a statement some meaning rewrites, the statements it means then standing for it.
fn stmt_meant_beside(typed: TypedItem, s: StmtId) -> bool {
    let store = typed.view.store
    if store.stmt_meant(s) != null { return false }
    let said? = meaning_said(typed, At.Stmt(s)) else { return false }
    let made = stmts_rewritten_beside(avra(), store, s, said.rewrite)
    if made.is_empty() { return false }
    store.stmt_means_as(s, made)
    true
}

/// What a meaning says a node means, and the meaning that said it.
type MeaningSaid = { rewrite: Rewrite, by: string }

/// What the first meaning filed under the node whose arms match says the node means.
fn meaning_said(typed: TypedItem, at: At) -> MeaningSaid? {
    let store = typed.view.store
    for m in meaning_index().at_node(store.shallow_at(at), store.kind_at(at)) {
        let said? = (m.run)(TypedCode { of: typed, at: at }) else { continue }
        return MeaningSaid { rewrite: said, by: "${m.module}.${m.name}" }
    }
    null
}

/// Every statement at and under `root`, inner statements before the ones holding them.
fn every_stmt(store: SyntaxArena, root: At) -> List<StmtId> {
    let own = match root { .Stmt(s) -> [s], rest -> [] }
    flatten([every_stmt(store, k) for k in store.kids_at(root)]).concat(own)
}
