//! The instruction emitter: `impl Emit`, one arm per IR instruction.
//! The module/declaration/entry machinery lives in llvm.av.
use core.{Ins, Reg, BinOp, UnOp, TypeId, RtKind, RtSig}
use features.{nothing, absent_tag}

impl Emit {
    /// A register's LLVM type.
    fn reg_type(r: Reg) -> ptr {
        ll_type_of(self.lc, self.types, self.tys[r.index])
    }

    /// The indirect call: the fn TYPE derives from the site's own
    /// registers (ret from dst, params from args), so the built type
    /// matches the callee that boxing named — every seat is cast to
    /// its register's declared shape on the way in.
    fn call_ptr_value(d: Reg, f: Reg, args: List<Reg>) -> ptr {
        let ptys = avra_llvm_type_array_new(args.length)
        for j, a in args {
            avra_llvm_type_array_set(ptys, j, ll_type_of(self.lc, self.types, self.tys[a.index]))
        }
        let fty = avra_llvm_function_type(
            ll_type_of(self.lc, self.types, self.tys[d.index]),
            ptys,
            args.length,
            0,
        )
        avra_llvm_type_array_free(ptys)
        let vargs = avra_llvm_value_array_new(args.length)
        for j, a in args {
            avra_llvm_value_array_set(
                vargs,
                j,
                avra_llvm_cast_to_type(
                    self.b,
                    self.vals[a.index],
                    ll_type_of(self.lc, self.types, self.tys[a.index]),
                ),
            )
        }
        let fp = avra_llvm_cast_to_type(self.b, self.vals[f.index], avra_llvm_pointer_type(self.lc))
        avra_llvm_build_call(self.b, fty, fp, vargs, args.length, "")
    }

    fn call(name: string, args: List<ptr>) -> ptr {
        let f = avra_llvm_get_named_function(self.m, name)
        let arr = avra_llvm_value_array_new(args.length)
        for i, a in args { avra_llvm_value_array_set(arr, i, a) }
        avra_llvm_build_call(self.b, avra_llvm_fn_type_of(f), f, arr, args.length, "")
    }

    /// The slot's first write: settle the keyed table (unchanged —
    /// `avra_once_slot_commit` calls straight through to
    /// `avra_once_set`) and this fn's own global together, so every
    /// `OnceRead` after this one sees whichever value won.
    fn once_committed(sym: string, value: Reg) {
        let slot = avra_llvm_once_slot(self.m, once_slot_name(sym))
        let key = avra_llvm_build_text(self.b, sym.bytes(), sym.length, ".once_key")
        let _ = self.call("avra_once_slot_commit", [key, self.vals[value.index], slot])
    }

    fn emit_ins(i: Ins) {
        match i {
            .ConstInt(dst, v) -> self.define(self.const_int_value(dst, v)),
            .ConstFloat(_, bits) -> self.define(avra_llvm_const_double_bits(self.lc, bits)),
            .ConstBool(_, v) -> self.define(avra_llvm_const_int(avra_llvm_int1_type(self.lc), if v { 1 } else { 0 }, 0)),
            .ConstStr(_, s) -> self.define(avra_llvm_build_text(self.b, s.bytes(), s.length, ".str")),
            .Bin(_, op, a, x) -> self.define(self.binary_value(op, a, x)),
            .Un(_, op, src) -> self.define(self.un_value(op, self.vals[src.index])),
            .CallRtVoid(callee, args) -> self.void_rt_call(callee, args),
            .CallRt(dst, callee, args) -> self.define(self.call_rt_value(dst, callee, args)),
            .Pack(dst, elems) -> self.define(self.pack_value(dst, elems)),
            .Extract(dst, src, at) -> self
                .define(avra_llvm_cast_to_type(self.b, self.extract_value(src, at), self.reg_type(dst))),
            .Call(_, callee, args) -> self.define(self.call(mangled(callee), [self.vals[a.index] for a in args])),
            .FnAddr(_, sym) -> self
                .define(
                    avra_llvm_cast_to_type(
                        self.b,
                        avra_llvm_get_named_function(self.m, mangled(sym)),
                        avra_llvm_int64_type(self.lc),
                    ),
                ),
            .StaticAddr(_, sym) -> self.define(avra_llvm_global_payload(self.m, mangled(sym))),
            .OnceRead(dst, sym) -> self
                .define(
                    avra_llvm_build_load(
                        self.b,
                        self.reg_type(dst),
                        avra_llvm_once_slot(self.m, once_slot_name(sym)),
                        "once",
                    ),
                ),
            .OnceCommit(sym, value) -> self.once_committed(sym, value),
            .CallPtr(d, f, args) -> self.define(self.call_ptr_value(d, f, args)),
            .Release(r) -> self.released(r),
            .Retain(r) -> self.retained(r),
            .RetVal(r) -> self.ret_value(r),
            .FnExit(r) -> self.fn_exit(r),
            .Ret(code) -> self.ret_code(code),
            .IfStart(c) -> self.if_start(c),
            .SwitchStart(sel, cases) -> self.switch_start(sel, cases),
            .ArmEnd(gives) -> self.arm_end(gives),
            .RegionEnd(dst, gives) -> self.region_end(dst, gives),
            .Alloca(dst) -> self.allocated(dst),
            .Load(dst, slot) -> self
                .define(avra_llvm_build_load(self.b, self.reg_type(dst), self.vals[slot.index], "ld")),
            .Store(slot, src) -> self.stored(slot, src),
            .LoopStart -> self.loop_start(),
            .LoopCond(c) -> self.loop_cond(c),
            .LoopEnd -> self.loop_end(),
            .ScopeEnter(_) or .ScopeExit(_) -> nothing(),
        }
    }

    /// An int constant — or the NULL POINTER when the destination
    /// rides one: absence is the zero of its type, and the only
    /// ConstInt lowering ever aims at a pointer register is 0. The
    /// interpreter's const_int_val is this rule's twin.
    fn const_int_value(dst: Reg, v: int) -> ptr {
        if self.types.rides_pointer(self.tys[dst.index]) {
            return avra_llvm_const_pointer_null(avra_llvm_pointer_type(self.lc))
        }
        avra_llvm_const_int(avra_llvm_int64_type(self.lc), v, 1)
    }

    /// Whether a register holds a value with no LLVM aggregate at
    /// all: a FLAT record of one field, which IS its field, or a
    /// nullable WORD ENUM, whose own tag doubles as the absent
    /// sentinel — one register either way.
    fn bare_value(r: Reg) -> bool {
        let ty = self.tys[r.index]
        self.types.is_flat(ty) && !self.types.is_wide(ty) || self.word_opt(ty)
    }

    /// A nullable WORD ENUM, by its own shape — never reduced through
    /// `machine_type`, which would already have flattened it away.
    fn word_opt(ty: TypeId) -> bool {
        match self.types.shape_of(ty) {
            .Opt(inner) -> self.types.is_word_enum(inner),
            rest -> false,
        }
    }

    /// One element out of an aggregate — or the value itself, when the
    /// register rides BARE.
    fn extract_value(src: Reg, at: int) -> ptr {
        if self.bare_value(src) { return self.vals[src.index] }
        avra_llvm_build_extract_value(self.b, self.vals[src.index], at, "x")
    }

    /// A packed value: element by element into an undef aggregate —
    /// registers all the way, which is what lets SROA see through it.
    fn pack_value(dst: Reg, elems: List<Reg>) -> ptr {
        // A BARE register IS its one element — the pack is the value itself.
        if self.bare_value(dst) { return avra_llvm_cast_to_type(self.b, self.vals[elems[0].index], self.reg_type(dst)) }
        mut agg = avra_llvm_get_undef(self.reg_type(dst))
        let valued = self.types.valued_carrier(self.tys[dst.index])
        for j, r in elems {
            let part = if valued { self.worded(r, self.vals[r.index]) } else { self.vals[r.index] }
            agg = avra_llvm_build_insert_value(self.b, agg, part, j, "pack")
        }
        agg
    }

    /// The next register's value — registers mint in instruction order.
    fn define(v: ptr) {
        self.vals.push(v)
    }

    /// icmp predicates by number: 32 eq, 33 ne, 38 sgt, 39 sge, 40 slt,
    /// 41 sle. `And`/`Or` are the LAZY ops: they lower as regions and
    /// a `Bin` carrying one is the IR's bool law broken, which both
    /// engines say in the same words — an eager `and` here would be a
    /// plausible answer to an impossible question, in the exact arms a
    /// bitwise operator would be tempted to reuse.
    /// An IR shape the compiler's own law forbids. `unreached` is the
    /// answer the subset demands and the trap never lets it give.
    fn wrecked(what: string, unreached: ptr) -> ptr {
        avra_trap("compiler defect: ${what}")
        unreached
    }

    /// A binary operation, by the OPERANDS' kind. A double lives in
    /// its own register file, so the float ops are a separate table
    /// and not a flag on the integer one — mixing them is not a
    /// wrong answer, it is a wrong instruction.
    fn binary_value(op: BinOp, a: Reg, x: Reg) -> ptr {
        let l = self.vals[a.index]
        let r = self.vals[x.index]
        if self.types.machine_shape(self.tys[a.index]) is .Float { return self.float_value(op, l, r) }
        self.bin_value(op, l, r)
    }

    /// IEEE-754 arithmetic and ORDERED comparison. NaN answers false
    /// to every ordered question, which is the standard's rule.
    fn float_value(op: BinOp, a: ptr, b: ptr) -> ptr {
        match op {
            .Add -> avra_llvm_build_fadd(self.b, a, b, "fadd"),
            .Sub -> avra_llvm_build_fsub(self.b, a, b, "fsub"),
            .Mul -> avra_llvm_build_fmul(self.b, a, b, "fmul"),
            .Div -> avra_llvm_build_fdiv(self.b, a, b, "fdiv"),
            // LLVMRealPredicate: OEQ 1, OGT 2, OGE 3, OLT 4, OLE 5, ONE 6
            .Eq -> avra_llvm_build_fcmp(self.b, 1, a, b, "fcmp"),
            .Ne -> avra_llvm_build_fcmp(self.b, 6, a, b, "fcmp"),
            .Gt -> avra_llvm_build_fcmp(self.b, 2, a, b, "fcmp"),
            .Ge -> avra_llvm_build_fcmp(self.b, 3, a, b, "fcmp"),
            .Lt -> avra_llvm_build_fcmp(self.b, 4, a, b, "fcmp"),
            .Le -> avra_llvm_build_fcmp(self.b, 5, a, b, "fcmp"),
            .Mod or .BitAnd or .BitOr or .BitXor or .Shl or .Shr -> self.wrecked(int_only_on_floats, a),
            .And or .Or -> self.wrecked(lazy_in_eager, a),
        }
    }

    fn bin_value(op: BinOp, a: ptr, b: ptr) -> ptr {
        match op {
            .Add -> avra_llvm_build_add(self.b, a, b, "add"),
            .Sub -> avra_llvm_build_sub(self.b, a, b, "sub"),
            .Mul -> avra_llvm_build_mul(self.b, a, b, "mul"),
            // Guarded unless the divisor is plain: sdiv/srem by zero is
            // undefined, and the interpreter refuses, so the two engines
            // must agree.
            .Div -> if plain_divisor(b) { avra_llvm_build_sdiv(self.b, a, b, "sdiv") } else { self.call("avra_int_div", [a, b]) },
            .Mod -> if plain_divisor(b) { avra_llvm_build_srem(self.b, a, b, "srem") } else { self.call("avra_int_mod", [a, b]) },
            .Eq -> avra_llvm_build_icmp(self.b, 32, a, b, "cmp"),
            .Ne -> avra_llvm_build_icmp(self.b, 33, a, b, "cmp"),
            .Lt -> avra_llvm_build_icmp(self.b, 40, a, b, "cmp"),
            .Le -> avra_llvm_build_icmp(self.b, 41, a, b, "cmp"),
            .Gt -> avra_llvm_build_icmp(self.b, 38, a, b, "cmp"),
            .Ge -> avra_llvm_build_icmp(self.b, 39, a, b, "cmp"),
            .And or .Or -> self.wrecked(lazy_in_eager, a),
            .BitAnd -> avra_llvm_build_and(self.b, a, b, "band"),
            .BitOr -> avra_llvm_build_or(self.b, a, b, "bor"),
            .BitXor -> avra_llvm_build_xor(self.b, a, b, "bxor"),
            // Guarded like Div/Mod: a shift past the width is POISON
            // in LLVM and undefined in C, so one C body decides where
            // the edge is and both engines call it.
            .Shl -> self.call("avra_int_shl", [a, b]),
            .Shr -> self.call("avra_int_shr", [a, b]),
        }
    }

    fn un_value(op: UnOp, v: ptr) -> ptr {
        match op { .Not -> avra_llvm_build_not(self.b, v, "not") }
    }

    /// A runtime call, generic over every callee declare_runtime names.
    /// The answer crosses back out of the slot it rode in.
    fn call_rt_value(dst: Reg, callee: string, args: List<Reg>) -> ptr {
        let called = self.call(callee, self.rt_args(callee, args))
        self.normalized_cells(callee, args)
        if self.census && self.mints(callee) {
            avra_llvm_build_census_box(
                self.b,
                self.m,
                "${self.types.name_of(self.tys[dst.index])} by ${callee}",
            )
        }
        self.unworded(self.answer_form(dst, callee), self.answered(callee, called))
    }

    /// Whether a row answers a box it made: it owns its answer and names
    /// that box, where a row answering `Any` hands back one that stood.
    fn mints(callee: string) -> bool {
        let row? = self.rt.get(callee) else { return false }
        match row.answer { .Any -> false, .Text or .Bytes or .List or .Map -> row.owns_result }
    }

    /// HOW A CALLEE'S ANSWER CROSSES BACK: the destination's slot form,
    /// unless the callee answered outside a word. An address and a
    /// double are only ever IN a word, so a callee answering otherwise
    /// hands its value back untouched.
    ///
    /// A BOOL NARROWS WHATEVER THE CALLEE ANSWERED, and that rests on
    /// `rt_kind_of`: a bool is neither void, float nor pointer-riding,
    /// so it rides I64, and a width word carries `int` and never
    /// `bool`. A bool destination's callee therefore answers an
    /// integer. The day a width carries `bool`, this arm owes the
    /// narrower question — which kinds arrive in an integer register —
    /// instead of `answers_word`.
    fn answer_form(dst: Reg, callee: string) -> SlotForm {
        let form = self.slot_form(self.tys[dst.index])
        if self.answers_word(callee) { return form }
        match form {
            .Widened -> SlotForm.Widened,
            .Address or .Reinterpreted or .Word -> SlotForm.Word,
        }
    }

    /// Whether the registry declares an I64 answer for this callee.
    /// A MATCH, never `is .I64`: this decides what crosses the extern
    /// boundary, so a new RtKind must state its answer here or the
    /// build fails — an `is` test would silently answer "not a word".
    fn answers_word(callee: string) -> bool {
        let sig? = self.callee_sig(callee) else { return false }
        match sig.ret {
            .I64 -> true,
            // a width answers an Avra `int`, never a pointer's word
            // a width answers an Avra `int`, and a double answers in
            // its own register file — neither is a pointer's word
            .I32 or .U32 or .F64 or .Ptr or .Void -> false,
        }
    }

    /// A NARROW ANSWER IS WIDENED WITH THE SIGN ITS WIDTH NAMES, and
    /// this match is where the author must say which: `i32` and `u32`
    /// differ in nothing else. Reading a narrow answer at 64 bits is
    /// the silent wrong answer — a C `int` of -1 reads 4294967295 —
    /// because the bits above the declared width are the callee's
    /// business and only the declaration says how to read them.
    /// NOT `avra_llvm_cast_to_type`: it TRAPS on a widening rather
    /// than guess a sign, and names these two builders when it does.
    /// This match is the caller it means — the row already said which.
    fn answered(callee: string, raw: ptr) -> ptr {
        let sig? = self.callee_sig(callee) else { return raw }
        let wide = avra_llvm_int64_type(self.lc)
        match sig.ret {
            .I32 -> avra_llvm_build_sext(self.b, raw, wide, "wide"),
            .U32 -> avra_llvm_build_zext(self.b, raw, wide, "wide"),
            // a double is already the width its seat declared
            .I64 or .F64 or .Ptr or .Void -> raw,
        }
    }

    /// A callee's row: the runtime's, or one of the program's externs.
    fn callee_sig(callee: string) -> RtSig? {
        self.rt.get(callee) ?? self.externs.find(it.name == callee)
    }

    fn void_rt_call(callee: string, args: List<Reg>) {
        if self.settled_valued(callee, args) { return }
        let _ = self.call(callee, self.rt_args(callee, args))
        self.normalized_cells(callee, args)
    }

    /// A VALUE ENUM'S CELL is its tag and word, never one pointer: its
    /// release counts the word down by tag, and both a release and a
    /// forget leave the cell holding the absent tag. Whether the row
    /// did this, answered for the cell rows alone.
    fn settled_valued(callee: string, args: List<Reg>) -> bool {
        let sig? = self.callee_sig(callee) else { return false }
        let slot? = args.first() else { return false }
        if !self.types.valued_carrier(self.tys[slot.index]) { return false }
        match sig.host {
            .CellRelease -> {
                let held = avra_llvm_build_load(
                    self.b,
                    self.reg_type(slot),
                    self.vals[slot.index],
                    "held",
                )
                self.counted_by_tag(tagged_release, held, self.tys[slot.index])
            },
            .CellForget -> nothing(),
            rest -> { return false },
        }
        let _ = avra_llvm_build_store(self.b, self.absent_valued(slot), self.vals[slot.index])
        true
    }

    /// A FRESH CELL HOLDS NOTHING, as the evaluator's does: the memory
    /// pass settles a cell before its first store, so a value enum's
    /// cell starts at the absent tag — never stack garbage its settle
    /// would release by tag. A pointer's cell starts null at the
    /// alloca itself.
    fn allocated(dst: Reg) {
        self.define(avra_llvm_build_alloca(self.b, self.reg_type(dst), "slot"))
        if self.types.valued_carrier(self.tys[dst.index]) {
            let _ = avra_llvm_build_store(self.b, self.absent_valued(dst), self.vals[dst.index])
        }
    }

    /// The absent tag and no word, as a cell of `slot`'s type holds them.
    fn absent_valued(slot: Reg) -> ptr {
        let i64 = avra_llvm_int64_type(self.lc)
        let tagged = avra_llvm_build_insert_value(
            self.b,
            avra_llvm_get_undef(self.reg_type(slot)),
            avra_llvm_const_int(i64, absent_tag, 1),
            0,
            "absent",
        )
        avra_llvm_build_insert_value(self.b, tagged, avra_llvm_const_int(i64, 0, 0), 1, "absent")
    }

    /// A NARROW INOUT CELL IS NORMALISED AFTER THE CALL. An Avra cell
    /// is eight bytes; a C `int*` out-parameter writes FOUR of them,
    /// and the other four keep whatever the cell held — so
    /// `wal_checkpoint_v2` writing -1 reads back 4294967295 until the
    /// low half is extended over the high one.
    ///
    /// LITTLE-ENDIAN: the four bytes C writes are the LOW four of the
    /// slot. True on arm64 and x86-64, which is the only reason a
    /// shared cell works at all — say it rather than assume it.
    ///
    /// The SIGN comes from the WIDTH WORD the seat declared, never
    /// from the value: `i32` sign-extends, `u32` zero-extends, and
    /// they differ in nothing else. Lane C's rule holds — the cell
    /// register went to the call DIRECTLY and this reads the SAME
    /// register, so the memory pass still sees one slot.
    ///
    /// The interpreter needs this too the day it hosts an extern
    /// (it traps on every one today), and it must read the width
    /// from the same `cells` column.
    fn normalized_cells(callee: string, args: List<Reg>) {
        let sig? = self.callee_sig(callee) else { return }
        let cells = sig.cells
        for j, r in args {
            if j < cells.length { self.normalized_cell(cells[j], r) }
        }
    }

    /// One cell re-read at its declared width. DECIDE BEFORE EMITTING:
    /// a seat that is not a narrow inout gets no instructions at all,
    /// and its register is not a cell to load from — the first draft
    /// built the load before asking, and emitted `load i64, i64 %1`
    /// against an ordinary argument.
    fn normalized_cell(width: RtKind, slot: Reg) {
        let signed: bool? = self.narrow_sign(width)
        if signed == null { return }
        let wide = avra_llvm_int64_type(self.lc)
        let cell = self.vals[slot.index]
        let low = avra_llvm_build_trunc(
            self.b,
            avra_llvm_build_load(self.b, wide, cell, "cell"),
            avra_llvm_int32_type(self.lc),
            "low",
        )
        let full = if signed! {
            avra_llvm_build_sext(self.b, low, wide, "signed")
        } else {
            avra_llvm_build_zext(self.b, low, wide, "unsigned")
        }
        let _ = avra_llvm_build_store(self.b, full, cell)
    }

    /// Whether a cell's width extends SIGNED, or absence when the
    /// width is not a narrow one and the cell needs nothing.
    fn narrow_sign(width: RtKind) -> bool? {
        match width {
            .I32 -> true,
            .U32 -> false,
            // a double cell is whole — nothing to sign-extend
            .I64 or .F64 or .Ptr or .Void -> null,
        }
    }

    /// Runtime-call arguments, each coerced to its declared param —
    /// the runtime's int64 slots carry pointers too, so a
    /// pointer-shaped register entering `avra_array_push`'s element
    /// slot casts down.
    fn rt_args(callee: string, args: List<Reg>) -> List<ptr> {
        mut out: List<ptr> = []
        // LICENSED loops.push_loop: the coercion needs the param INDEX; comprehensions
        // cannot destructure enumerate
        for j, r in args { out.push(self.rt_arg(callee, j, r)) }
        out
    }

    /// A registry I64 param is a SLOT — every value category rides it,
    /// so pointer-riding registers cast down and bools widen in. A
    /// MATCH, never `is .I64`: this decides what crosses the extern
    /// boundary, and an `is` test would pass a NEW kind's argument
    /// UNCONVERTED — the conversions all live in the branch it skips.
    fn rt_arg(callee: string, j: int, r: Reg) -> ptr {
        let v = self.vals[r.index]
        let sig? = self.callee_sig(callee) else { return v }
        if j >= sig.params.length { return v }
        match sig.params[j] {
            .I64 -> self.worded(r, v),
            // the low bits are what a narrow C seat reads; the
            // SIGN of an argument is the callee's to interpret
            .I32 or .U32 -> avra_llvm_build_trunc(self.b, v, avra_llvm_int32_type(self.lc), "narrow"),
            .F64 -> v,
            .Ptr -> self.crossing(callee, sig, r, v),
            // nothing fills a `void` seat, and grouping it with `.Ptr`
            // gave it a check here that `carries_text` does not give it
            // in the evaluator — an asymmetry waiting for the day one
            // becomes fillable
            .Void -> v,
        }
    }

    /// A STRING CROSSING TO C IS ONE STRING. Avra measures text by the
    /// header and C reads to the first NUL, so a string holding one is
    /// TWO VALUES at the seam. The check is a call to the runtime's
    /// own `avra_str_crossing`, which the extern frame calls too — ONE
    /// check, so the engines cannot disagree about which strings are
    /// allowed to cross.
    ///
    fn crossing(callee: string, sig: RtSig, r: Reg, v: ptr) -> ptr {
        if sig.inert { return v }
        if !self.names_a_name(callee, r) { return v }
        self.call("avra_str_crossing", [v])
    }

    /// WHETHER THIS REGISTER IS A NAME THE CALLEE WILL RESOLVE, which
    /// is a question about the ROW and not only about the type. Text
    /// always is. A `Bytes` is the caller saying OCTETS, and the
    /// exemption it wears is EARNED BY THE CALLEE KNOWING THE LENGTH
    /// — a blob and its `n` — which only a C prototype can say, so a
    /// PACKAGE's extern is `tools/externs.py`'s to judge and never
    /// this seam's. CORE's non-inert rows take a name and no length
    /// at all (`avra_host_env`, `avra_io_list`, `avra_exec_self`,
    /// `avra_spawn_status`), so octets there mean a PREFIX of
    /// themselves exactly as text does: the same holed name refused as
    /// a `string` read a different variable as a `Bytes`, and the same
    /// holed program ran.
    fn names_a_name(callee: string, r: Reg) -> bool {
        match self.types.shape_of(self.tys[r.index]) {
            .Str -> true,
            .Bytes -> self.rt.get(callee) != null,
            .Int or .Float or .Bool or .Ptr or .Struct(_, _) or .Enum(_, _) or .App(_, _, _) or .Dyn(_, _) or .List(_) or .Cell(_) or .Task(_) or .Tasks or .Map(_, _) or .Res(_, _) or .Fn(_, _, _) or .Void or .Opt(_) or .Null or .EmptyList or .EmptyMap or .TypeName(_, _) or .Var(_, _, _) or .Union(_) or .Error -> false,
        }
    }

    /// A value cast INTO the I64 slot every category rides.
    fn worded(r: Reg, v: ptr) -> ptr {
        let i64t = avra_llvm_int64_type(self.lc)
        match self.slot_form(self.tys[r.index]) {
            .Address -> avra_llvm_build_ptr_to_int(self.b, v, i64t, "slot"),
            .Widened -> avra_llvm_build_zext(self.b, v, i64t, "slot"),
            .Reinterpreted -> avra_llvm_build_bitcast(self.b, v, i64t, "slot"),
            .Word -> v,
        }
    }

    /// The slot read BACK OUT — `worded` inverted, arm for arm from the
    /// same table, so a pack and an unpack cannot disagree about a
    /// category.
    fn unworded(form: SlotForm, raw: ptr) -> ptr {
        match form {
            .Address -> avra_llvm_build_int_to_ptr(self.b, raw, avra_llvm_pointer_type(self.lc), "boxed"),
            .Widened -> avra_llvm_build_icmp(
                self.b,
                33,
                raw,
                avra_llvm_const_int(avra_llvm_int64_type(self.lc), 0, 0),
                "b",
            ),
            .Reinterpreted -> avra_llvm_build_bitcast(self.b, raw, avra_llvm_double_type(self.lc), "unslotted"),
            .Word -> raw,
        }
    }

    /// WHICH CONVERSION A VALUE CATEGORY OWES THE WORD SLOT, asked in
    /// both directions so neither can be written alone. A CHAIN of `is`
    /// tests answers "no conversion" for every category nobody thought
    /// of, and an unconverted value is not a refusal: a double filed as
    /// a word rides an integer seat and the callee reads a different
    /// number.
    fn slot_form(ty: TypeId) -> SlotForm {
        match self.types.machine_shape(ty) {
            .Bool -> SlotForm.Widened,
            .Float -> SlotForm.Reinterpreted,
            .Int or .Error or .Void or .TypeName(_, _) or .Var(_, _, _) -> SlotForm.Word,
            // a nullable is two machine forms: the niche IS the box's
            // pointer, a scalar pair is a register pair no slot holds
            .Opt(inner) if !self.types.opt_rides_pointer(inner) -> SlotForm.Word,
            .Bytes or .Str or .Ptr or .List(_) or .Cell(_) or .Task(_) or .Tasks or .Struct(_, _) or .Enum(_, _) or .Res(_, _) or .App(_, _, _) or .Dyn(_, _) or .Fn(_, _, _) or .Null or .EmptyList or .Opt(_) or .Map(_, _) or .EmptyMap or .Union(_) -> SlotForm.Address,
        }
    }

    fn released(r: Reg) {
        if self.types.valued_carrier(self.tys[r.index]) { return self.tagged_count(tagged_release, r) }
        let _ = self.call("avra_rc_release", [self.counted(self.vals[r.index], self.tys[r.index])])
    }

    fn retained(r: Reg) {
        if self.types.valued_carrier(self.tys[r.index]) { return self.tagged_count(tagged_retain, r) }
        let _ = self.call("avra_rc_retain", [self.counted(self.vals[r.index], self.tys[r.index])])
    }

    /// A value enum's count: its word, counted by the row only when its
    /// tag's variant carries a pointer.
    fn tagged_count(row: string, r: Reg) {
        self.counted_by_tag(row, self.vals[r.index], self.tys[r.index])
    }

    /// A value enum's word counted by `row` when its tag's variant
    /// carries a pointer.
    fn counted_by_tag(row: string, v: ptr, ty: TypeId) {
        let tag = avra_llvm_build_extract_value(self.b, v, 0, "tag")
        let word = avra_llvm_build_extract_value(self.b, v, 1, "word")
        let _ = self
            .call(
                row,
                [
                    word,
                    tag,
                    avra_llvm_const_int(
                        avra_llvm_int64_type(self.lc),
                        self.types.counted_mask(ty),
                        0,
                    ),
                ],
            )
    }

    /// The pointer a count lands on: the value itself, or — for a
    /// nullable riding a pair — its carried half, whose absence is the
    /// null pointer a count skips.
    fn counted(v: ptr, ty: TypeId) -> ptr {
        match self.types.machine_shape(ty) {
            .Opt(inner) -> if self.types.opt_rides_pointer(inner) { v } else { self.counted(avra_llvm_build_extract_value(self.b, v, 1, "held"), inner) },
            _ -> v,
        }
    }

    fn ret_value(r: Reg) {
        let _ = avra_llvm_build_ret(self.b, self.vals[r.index])
    }

    /// An early return: ret RIGHT HERE, then open a dead block so the
    /// arm's unreachable tail (its yield, the region's br) lands
    /// somewhere harmless.
    fn fn_exit(r: Reg) {
        let _ = avra_llvm_build_ret(self.b, self.vals[r.index])
        let dead = avra_llvm_append_basic_block(self.lc, self.fn_val, "postret")
        avra_llvm_position_at_end(self.b, dead)
    }

    /// A process code wears the answer type the fn was declared with:
    /// C's `int` at the entry, the IR's `int` in a program body.
    fn ret_code(code: int) {
        let _ = avra_llvm_build_ret(
            self.b,
            avra_llvm_const_int(avra_llvm_return_type_of(self.fn_val), code, 0),
        )
    }

    fn stored(slot: Reg, src: Reg) {
        let _ = avra_llvm_build_store(self.b, self.vals[src.index], self.vals[slot.index])
    }

    /// Open the loop: fall into the header, where the condition's
    /// instructions re-run each turn.
    fn loop_start() {
        let header = avra_llvm_append_basic_block(self.lc, self.fn_val, "lhead")
        let exit = avra_llvm_append_basic_block(self.lc, self.fn_val, "lexit")
        let _ = avra_llvm_build_br(self.b, header)
        avra_llvm_position_at_end(self.b, header)
        self.loops.push(LoopFrame { header: header, exit: exit })
    }

    /// The condition decides: true falls into the body, false exits.
    fn loop_cond(c: Reg) {
        let f = self.loops.last()!
        let body = avra_llvm_append_basic_block(self.lc, self.fn_val, "lbody")
        let _ = avra_llvm_build_cond_br(self.b, self.vals[c.index], body, f.exit)
        avra_llvm_position_at_end(self.b, body)
    }

    /// Close the back edge and stand at the exit.
    fn loop_end() {
        let f = self.loops.pop()
        let _ = avra_llvm_build_br(self.b, f.header)
        avra_llvm_position_at_end(self.b, f.exit)
    }

    /// Open a two-arm region: branch on the condition, build into the
    /// first arm.
    fn if_start(c: Reg) {
        let then_bb = avra_llvm_append_basic_block(self.lc, self.fn_val, "then")
        let else_bb = avra_llvm_append_basic_block(self.lc, self.fn_val, "else")
        let merge_bb = avra_llvm_append_basic_block(self.lc, self.fn_val, "endif")
        let _ = avra_llvm_build_cond_br(self.b, self.vals[c.index], then_bb, else_bb)
        avra_llvm_position_at_end(self.b, then_bb)
        self.open_region([then_bb, else_bb], merge_bb)
    }

    /// Open an N-arm region: ONE jump table over the selector, the last
    /// arm its default — which is why a total match needs no
    /// fallthrough. This is the whole point of the instruction: the
    /// machine indexes, it does not walk.
    fn switch_start(sel: Reg, cases: List<int>) {
        // One block per case, plus the default's — the last arm.
        let arms = [avra_llvm_append_basic_block(self.lc, self.fn_val, "arm") for c in cases]
            .concat([avra_llvm_append_basic_block(self.lc, self.fn_val, "arm")])
        let merge_bb = avra_llvm_append_basic_block(self.lc, self.fn_val, "endswitch")
        let sw = avra_llvm_build_switch(
            self.b,
            self.vals[sel.index],
            arms[cases.length],
            cases.length,
        )
        let i64t = avra_llvm_int64_type(self.lc)
        for j, v in cases {
            avra_llvm_add_case(sw, avra_llvm_const_int(i64t, v, 1), arms[j])
        }
        avra_llvm_position_at_end(self.b, arms[0])
        self.open_region(arms, merge_bb)
    }

    /// The region stack's push — arm 0 is already being built.
    fn open_region(arms: List<ptr>, merge_bb: ptr) {
        let r = Region { arms: arms, next: 1, merge_bb: merge_bb, ended: [], gives: [] }
        // LICENSED compiler.bracket_ritual: a region STACK across fns, not a bracket body
        self.frames.push(r)
    }

    /// End this arm — where it ended, what it yields — and build into
    /// the next. Nested regions moved the insert block; ask, never
    /// assume.
    fn arm_end(gives: Reg) {
        let f = self.frames.pop()
        let here = avra_llvm_get_insert_block(self.b)
        let _ = avra_llvm_build_br(self.b, f.merge_bb)
        avra_llvm_position_at_end(self.b, f.arms[f.next])
        let advanced = f with { ended: f.ended.concat([here]), gives: f.gives.concat([gives]), next: f.next + 1 }
        // LICENSED compiler.bracket_ritual: a region STACK across fns, not a bracket body
        self.frames.push(advanced)
    }

    /// End the LAST arm and merge: one phi over every arm's yield is
    /// the region's register.
    fn region_end(dst: Reg, gives: Reg) {
        let f = self.frames.pop()
        let ended = f.ended.concat([avra_llvm_get_insert_block(self.b)])
        let gs = f.gives.concat([gives])
        let _ = avra_llvm_build_br(self.b, f.merge_bb)
        avra_llvm_position_at_end(self.b, f.merge_bb)
        let phi = avra_llvm_build_phi(self.b, self.reg_type(dst), "regval")
        for j, bb in ended { avra_llvm_add_incoming(phi, self.vals[gs[j].index], bb) }
        self.define(phi)
    }
}

/// A divisor no division traps or overflows on: a constant other than
/// zero, which traps, and -1, which overflows the smallest int.
fn plain_divisor(v: ptr) -> bool {
    if avra_llvm_is_const_int(v) == 0 { return false }
    let d = avra_llvm_const_int_sext(v)
    d != 0 && d != -1
}

/// The rows that count a value enum's word by its tag.
const tagged_retain: string = "avra_rc_retain_tagged"
const tagged_release: string = "avra_rc_release_tagged"
