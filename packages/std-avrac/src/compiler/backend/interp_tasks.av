//! The scheduler's rows, hosted: every interpreted task runs on this
//! one machine, as its own call stack. The runtime's policy — the one a
//! compiled program's fibers obey — files each task and names the next;
//! the machine switches stacks. A row that must wait marks the machine
//! PARKING and the run loop saves the task at that very instruction, so
//! the row runs again when its task resumes and answers then.

extern fn avra_vtask_new_at(site: int, id: int) -> int
extern fn avra_vtask_free(t: int)
extern fn avra_vtask_end(t: int)
extern fn avra_vtask_ready(t: int)
extern fn avra_vtask_joins(t: int, on: int)
extern fn avra_vtask_joined(t: int, by: int)
extern fn avra_vtask_sited(t: int, site: string)
extern fn avra_vtask_sleep(t: int, ms: int)
extern fn avra_vtask_park_fd(t: int, fd: int, writable: int, timeout_ms: int) -> int
extern fn avra_vtask_timed_out(t: int) -> int
extern fn avra_vtask_interrupted(t: int) -> int
extern fn avra_vtask_unwinding(t: int) -> int
extern fn avra_vtask_within(t: int, ms: int) -> int
extern fn avra_vtask_within_end(t: int, id: int) -> int
extern fn avra_vtask_inherits(t: int, from: int)
extern fn avra_vtask_next() -> int
extern fn avra_vtask_wait_fd(t: int, fd: int, writable: int, arm: int, member: int)
extern fn avra_vtask_wait_until(t: int, at_ns: int, arm: int, member: int)
extern fn avra_vtask_wait_gate(t: int, gate: ptr, arm: int, member: int)
extern fn avra_vtask_join(t: int, task: ptr) -> int
extern fn avra_sched_run_begins()
extern fn avra_sched_run_ends()
extern fn avra_sched_guest_waits()
extern fn avra_sched_seed(schedule: int)
extern fn avra_sched_settle() -> int
extern fn avra_clock_virtual(on: int)
extern fn avra_case_clock_virtual() -> int
extern fn avra_task_at(at_ns: int) -> ptr
extern fn avra_task_done(task: ptr) -> int
extern fn avra_task_cancel(task: ptr)
extern fn avra_vtask_park(t: int) -> int
extern fn avra_vtask_claim(t: int) -> int
extern fn avra_vtask_cancel(t: int, by: int)
extern fn avra_vgate_open(gate: ptr)
extern fn avra_vgate_claim(t: int, gate: ptr) -> int
extern fn avra_gate_new() -> ptr
extern fn avra_rc_release(p: ptr)

/// One interpreted task — a JOB: its own call stack while it waits, the place it
/// resumes, and — once it has one — its answer and whoever waits for it.
type Job = {
    // its place with the policy; 0 for a task nothing runs
    vt: int,
    // what `avra_task_id` answers in it: 0 for the program's own run,
    // n for the n-th task spawned. A task nothing runs answers for
    // nobody, and wears minus its place among the jobs.
    id: int,
    frames: List<List<Val?>>,
    callers: List<Resume>,
    at: Place?,
    // its RECORD in the array table, as the runtime's task is one: its
    // id, the body it owns, and the answer it leaves. The handle a
    // program holds is this box; -1 for the program's own run.
    record: int,
    done: bool,
    waiters: List<int>,
    // it parked on the policy at the instruction it resumes on: that
    // row reads its waking
    resumed: bool,
    // what it carries: four slots, released when it ends
    slots: List<Val>,
    // the gate a wait set files on to hear its end, made when the
    // first one asks — for a task a timer ends, the runtime's own task,
    // which begins as a gate and which the timer heap opens
    gate: ptr?,
    // a timer ends it: the heap, where its time comes, never a pick
    clocked: bool,
    // it ended with no answer
    cancelled: bool,
    // a wait row filed for it and it has not parked on its set: one
    // set at a time, so no other wait may begin
    arming: bool,
}

impl Job {
    /// Whether nothing runs it: a pending task, or a timer's.
    fn unrun() -> bool { self.id < 0 }
}

/// A job at rest: nobody waits for it, and it carries nothing.
fn job_of(vt: int, id: int, record: int, at: Place?, frames: List<List<Val?>>) -> Job {
    Job {
        vt: vt,
        id: id,
        frames: frames,
        callers: [],
        at: at,
        record: record,
        done: false,
        waiters: [],
        resumed: false,
        slots: [Val.N, Val.N, Val.N, Val.N],
        gate: null,
        clocked: false,
        cancelled: false,
        arming: false,
    }
}

/// A timer's task taken out of the heap before its time, its waiters
/// woken: what ends it early, whoever ends it.
fn stopped(time: ptr?) {
    let held? = time else { return }
    avra_task_cancel(held)
}

/// The reference the machine held to a gate, given up.
fn let_go(gate: ptr?) {
    let held? = gate else { return }
    avra_rc_release(held)
}

impl Machine {
    /// A RUN HAS ITS OWN SCHEDULE AND ITS OWN CLOCK. The machine runs in
    /// its host's process — the compiler's — so a seed the program
    /// takes, a clock it turns virtual and every jump it makes begin
    /// here and end with the run: the host's stand again as they stood.
    /// A jump inside a run also fires a timer the host's own tasks had
    /// filed; the host parks no task while a run stands.
    fn run_begun() {
        avra_sched_run_begins()
        if self.schedule < 0 { return }
        avra_sched_seed(self.schedule)
        // LICENSED input.test_setting: whether a suite's runs are on the virtual clock, never an input of what is built
        if avra_case_clock_virtual() != 0 { avra_clock_virtual(1) }
    }

    fn run_ended() {
        if self.schedule >= 0 { self.choices = avra_sched_settle() }
        avra_sched_run_ends()
    }

    /// The program's own run, filed as a task the first time a row asks.
    fn rooted() {
        if !self.tasks.is_empty() { return }
        avra_sched_guest_waits()
        self.tasks.push(job_of(avra_vtask_new_at(0, 0), 0, -1, null, []))
        self.running = 0
    }

    /// Every task the run still holds leaves the policy — the root's,
    /// and any a trap stopped — and every gate it still holds is let
    /// go, so the next run starts from none.
    fn retired() {
        for t in self.tasks {
            if t.done { continue }
            if t.vt != 0 { avra_vtask_free(t.vt) }
            if t.clocked { stopped(t.gate) }
            let_go(t.gate)
            for v in t.slots { self.releases_val(v) }
        }
        for gate in self.gates { let_go(gate) }
        self.gates = []
        self.clocked = []
        self.tasks = []
        self.running = -1
    }

    fn closureless() -> Val { self.defect_val("a task over a non-closure survived typing") }

    fn task_spawn_val(vals: List<Val>) -> Val {
        self.rooted()
        let box? = array_id(vals[0]) else { return self.closureless() }
        let target? = self.addressed_val(self.arrays[box].first() ?? Val.N) else { return self.closureless() }
        // the record owns its body, and the task holds its own record
        // until it answers
        let record = self.fresh_array([Val.I(self.tasks.length), vals[0], Val.N])
        self.retains(record)
        self.spawned = self.spawned + 1
        let vt = avra_vtask_new_at(self.whole(self.arrays[box].first() ?? Val.N), self.spawned)
        avra_vtask_inherits(vt, self.tasks[self.running].vt)
        if target.site != null { avra_vtask_sited(vt, target.site!) }
        self
            .tasks
            .push(
                job_of(
                    vt,
                    self.spawned,
                    array_id(record) ?? -1,
                    Place { body: target, pc: 0 },
                    [self.frame_for(target, [vals[0]])],
                ),
            )
        avra_vtask_ready(vt)
        record
    }

    /// The task a handle names.
    fn task_of(handle: Val) -> int {
        let record? = array_id(handle) else {
            self.defect("a task handle that is no record survived typing")
            return 0
        }
        self.whole(self.arrays[record][0])
    }

    fn task_spent(handle: Val) -> bool { self.tasks[self.task_of(handle)].done }

    /// The task's answer — the one-cell list its body answered. Parks
    /// until done.
    fn task_join_val(vals: List<Val>) -> Val {
        let id = self.task_of(vals[0])
        if id == self.running { return self.trapped_val("a task joined itself — deadlock") }
        if !self.tasks[id].done { return self.waited_on(id) }
        if self.tasks[id].cancelled { return self.trapped_val("a join takes a task that answers, and this one was cancelled") }
        self.arrays[self.tasks[id].record][2]
    }

    /// The running task waits for `id`: filed among its waiters — never
    /// with the policy, which only readies it when `id` finishes — and
    /// the machine switches. A join that would close a ring traps first.
    fn waited_on(id: int) -> Val {
        mut t = id
        while t >= 0 {
            if t == self.running { return self.trapped_val("tasks join each other in a ring — deadlock") }
            t = self.joining_of(t)
        }
        if self.tasks[self.running].arming { return self.trapped_val("a task waited inside a wait it had not parked") }
        avra_vtask_joins(self.tasks[self.running].vt, self.tasks[id].id)
        if self.tasks[id].clocked { return self.waited_on_time(id) }
        self.tasks[id].waiters.push(self.running)
        self.parking = true
        Val.N
    }

    /// A join of a task a timer ends parks with the POLICY, on the
    /// task's own gate, as a compiled join does: the heap readies the
    /// joiner where the time comes, and the row runs again to a task
    /// that is done.
    fn waited_on_time(id: int) -> Val {
        let time? = self.tasks[id].gate else { return self.defect_val("a timer's task lost its time") }
        if avra_vtask_join(self.tasks[self.running].vt, time) == 0 { return self.defect_val("a timer's task ended and the machine did not hear") }
        self.parking = true
        Val.N
    }

    /// The task `id` waits to join, or -1.
    fn joining_of(id: int) -> int {
        self.tasks.find_index(it.waiters.contains(id)) ?? -1
    }

    fn task_done_val(vals: List<Val>) -> Val {
        Val.I(if self.task_spent(vals[0]) { 1 } else { 0 })
    }

    /// An owner's scope ended: its task joined, or each in its list.
    fn task_settle_val(vals: List<Val>) -> Val {
        if vals[0] is .N { return Val.I(0) }
        let id = self.task_of(vals[0])
        if !self.tasks[id].done { return self.waited_on(id) }
        Val.I(0)
    }

    /// A task joins a `Tasks` owner; a long owner first sheds the tasks
    /// that have finished, as the runtime's does, at every doubling.
    fn tasks_push_val(vals: List<Val>) -> Val {
        let list? = array_id(vals[0]) else { return self.defect_val("a `Tasks` owner that is not a list survived typing") }
        let held = self.arrays[list]
        if held.length >= 4 && held.length & held.length - 1 == 0 {
            let shed = [v for v in held if self.task_spent(v)]
            self.arrays.set(list, [v for v in held if !self.task_spent(v)])
            for v in shed { self.releases_val(v) }
        }
        self.arrays[list].push(vals[1])
        Val.I(0)
    }

    fn task_settle_all_val(vals: List<Val>) -> Val {
        let list? = array_id(vals[0]) else { return self.defect_val("a list of tasks that is not a list survived typing") }
        let open? = self.arrays[list].find((v) -> !self.task_spent(v)) else { return Val.I(0) }
        self.waited_on(self.task_of(open))
    }

    fn fiber_yield_val() -> Val {
        self.rooted()
        if self.woke() { return Val.I(0) }
        avra_vtask_ready(self.tasks[self.running].vt)
        self.parking = true
        Val.I(0)
    }

    fn fiber_sleep_val(vals: List<Val>) -> Val {
        self.rooted()
        if self.woke() { return Val.I(0) }
        avra_vtask_sleep(self.tasks[self.running].vt, self.whole(vals[0]))
        self.policy_parked()
        Val.I(0)
    }

    fn fiber_park_fd_val(vals: List<Val>) -> Val {
        self.rooted()
        let vt = self.tasks[self.running].vt
        if self.woke() { return Val.I(1 - avra_vtask_timed_out(vt)) }
        if avra_vtask_park_fd(vt, self.whole(vals[0]), self.whole(vals[1]), self.whole(vals[2])) == 0 { return Val.I(1 - avra_vtask_timed_out(vt)) }
        self.policy_parked()
        Val.I(0)
    }

    /// Whether the running task's last descriptor park ended by an
    /// interrupt.
    fn fiber_interrupted_val() -> Val { Val.I(avra_vtask_interrupted(self.tasks[self.running].vt)) }

    /// A `within` opened on the running task with its own limit: its
    /// scope's id is answered for the scope's end.
    fn fiber_within_val(vals: List<Val>) -> Val {
        self.rooted()
        Val.I(avra_vtask_within(self.tasks[self.running].vt, self.whole(vals[0])))
    }

    fn fiber_within_end_val(vals: List<Val>) -> Val {
        self.rooted()
        Val.I(avra_vtask_within_end(self.tasks[self.running].vt, self.whole(vals[0])))
    }

    /// The running task parked on the POLICY — a sleep, a descriptor — so
    /// the row that parked it re-runs as its waking, and reads it there.
    fn policy_parked() {
        self.tasks[self.running].resumed = true
        self.parking = true
    }

    /// Whether the running task is resuming at the policy row that parked
    /// it — consumed as it is read.
    fn woke() -> bool {
        if !self.tasks[self.running].resumed { return false }
        self.tasks[self.running].resumed = false
        true
    }

    /// The running task parked at `at`: its stack saved, the next task
    /// the policy names loaded — answered as the place to run on.
    fn switched(at: Place) -> Place {
        self.tasks[self.running].frames = self.frames
        self.tasks[self.running].callers = self.callers
        self.tasks[self.running].at = at
        self.resume_next()
    }

    /// The running task answered: it is done, its waiters ready, and the
    /// machine runs whoever is next.
    fn finished(answer: Val?) -> Place {
        let t = self.tasks[self.running]
        self.tasks[self.running].frames = []
        self.ended(self.running, answer ?? Val.N, t.id)
        avra_vtask_end(t.vt)
        if t.record >= 0 { self.releases_val(Val.A(t.record)) }
        self.resume_next()
    }

    /// The task `id` ended: its answer left in its record, its waiters
    /// ready, what it carried released, and its gate — when a wait set
    /// asked for one — open for ever. `by` is the task that ended it: its
    /// own, or the one that answered or cancelled a task nothing runs.
    fn ended(id: int, answer: Val, by: int) {
        let t = self.tasks[id]
        if t.record >= 0 { self.arrays[t.record].set(2, answer) }
        self.tasks[id].done = true
        for w in t.waiters { avra_vtask_joined(self.tasks[w].vt, by) }
        self.tasks[id].waiters = []
        for v in t.slots { self.releases_val(v) }
        self.tasks[id].slots = []
        let gate? = t.gate else { return }
        avra_vgate_open(gate)
        avra_rc_release(gate)
        self.tasks[id].gate = null
    }

    /// A task nothing runs ended with `answer`: a timer's leaves the
    /// heap, with the reference its time held to its record.
    fn unrun_ended(id: int, answer: Val, by: int) {
        let t = self.tasks[id]
        if t.clocked { stopped(t.gate) }
        self.ended(id, answer, by)
        if t.clocked { self.releases_val(Val.A(t.record)) }
    }

    /// A timer's time came: its task answers a unit box.
    fn fired(id: int) {
        self.unrun_ended(id, self.fresh_array([Val.I(0)]), self.tasks[id].id)
    }

    /// Whether the heap has ended the timer's task at `id` and the
    /// machine has not yet heard.
    fn came(id: int) -> bool {
        let time? = self.tasks[id].gate else { return false }
        !self.tasks[id].done && avra_task_done(time) != 0
    }

    /// EVERY TIME THAT CAME SINCE THE MACHINE LAST LOOKED IS HEARD
    /// HERE. The heap ended each task where its time came — its waiters
    /// readied there, in no pick — so all that is left is the machine's
    /// own record of it, and the policy is asked nothing.
    fn times_heard() {
        if self.clocked.is_empty() { return }
        for id in self.clocked {
            if self.came(id) { self.fired(id) }
        }
        self.clocked = [id for id in self.clocked if !self.tasks[id].done]
    }

    /// The next task to run, loaded, and every time that came while the
    /// policy chose it heard first. When every task waits the run fails
    /// with the deadlock, as a compiled one does.
    fn resume_next() -> Place {
        let vt = avra_vtask_next()
        self.times_heard()
        if vt == 0 {
            self.trapped(all_waiting())
            return self.tasks[self.running].at!
        }
        let next = self.tasks.find_index(it.vt == vt && !it.done) ?? -1
        if next < 0 {
            self.defect("the policy named a task the machine does not hold")
            return self.tasks[self.running].at!
        }
        self.running = next
        self.frames = self.tasks[next].frames
        self.callers = self.tasks[next].callers
        self.tasks[next].at!
    }

    // ── The wait set, gates, tasks nothing runs, what a task carries ──

    fn running_vt() -> int {
        self.rooted()
        self.tasks[self.running].vt
    }

    /// The running task's place with the policy, as a wait row files
    /// for it: it is arming a set until it parks on it.
    fn arming_vt() -> int {
        let vt = self.running_vt()
        self.tasks[self.running].arming = true
        vt
    }

    fn wait_fd_val(vals: List<Val>) -> Val {
        avra_vtask_wait_fd(
            self.arming_vt(),
            self.whole(vals[0]),
            self.whole(vals[1]),
            self.whole(vals[2]),
            self.whole(vals[3]),
        )
        Val.I(0)
    }

    fn wait_until_val(vals: List<Val>) -> Val {
        avra_vtask_wait_until(
            self.arming_vt(),
            self.whole(vals[0]),
            self.whole(vals[1]),
            self.whole(vals[2]),
        )
        Val.I(0)
    }

    fn ungated() -> Val { self.defect_val("a gate that is no gate survived typing") }

    /// A wait on a gate or on a task's end: a task's record begins as a
    /// gate, so either files through either row.
    fn wait_on_val(vals: List<Val>) -> Val {
        let vt = self.arming_vt()
        let own? = self.gate_of(vals[0]) else { return self.wait_on_task(vt, vals) }
        avra_vtask_wait_gate(vt, own, self.whole(vals[1]), self.whole(vals[2]))
        Val.I(0)
    }

    fn wait_on_task(vt: int, vals: List<Val>) -> Val {
        let id? = self.job_of_record(vals[0]) else { return self.ungated() }
        let gate = self.end_gate(id)
        avra_vtask_wait_gate(vt, gate, self.whole(vals[1]), self.whole(vals[2]))
        if self.tasks[id].done { avra_rc_release(gate) }
        Val.I(0)
    }

    /// The job whose record `v` is, or null: the record names its job,
    /// and the job names that record back.
    fn job_of_record(v: Val) -> int? {
        let box? = array_id(v) else { return null }
        let head = self.arrays[box].first() ?? Val.N
        let at? = match head { .I(j) -> j, rest -> null } else { return null }
        if at <= 0 || at >= self.tasks.length || self.tasks[at].record != box { return null }
        at
    }

    /// The gate a wait on task `id` files on: the task's own while it
    /// lives, opened at its end; once it is done, one already open that
    /// the caller lets go.
    fn end_gate(id: int) -> ptr {
        let held? = self.tasks[id].gate else { return self.end_gate_made(id) }
        held
    }

    fn end_gate_made(id: int) -> ptr {
        let gate = avra_gate_new()
        if self.tasks[id].done { avra_vgate_open(gate) } else { self.tasks[id].gate = gate }
        gate
    }

    /// The running task parks on its set, and answers the claim: at
    /// once when the set is claimed already, else when it resumes here.
    fn wait_park_val() -> Val {
        let vt = self.running_vt()
        if self.woke() || avra_vtask_park(vt) == 0 {
            self.tasks[self.running].arming = false
            return Val.I(avra_vtask_claim(vt))
        }
        self.policy_parked()
        Val.I(0)
    }

    /// A gate: the box a program holds, and the runtime's own gate
    /// filed beside it under the box's id.
    fn gate_new_val() -> Val {
        let box = self.fresh_array([Val.I(0), Val.I(0), Val.I(0)])
        let id? = array_id(box) else { return box }
        while self.gates.length <= id { self.gates.push(null) }
        self.gates.set(id, avra_gate_new())
        box
    }

    /// The runtime's gate behind a program's.
    fn gate_of(v: Val) -> ptr? {
        let id? = array_id(v) else { return null }
        if id >= self.gates.length { return null }
        self.gates[id]
    }

    /// The box `id` died: the gate filed beside it, if any, is let go.
    fn gate_closed(id: int) {
        if id >= self.gates.length { return }
        let_go(self.gates[id])
        self.gates.set(id, null)
    }

    fn gate_claim_val(vals: List<Val>) -> Val {
        let gate? = self.gate_of(vals[0]) else { return self.ungated() }
        Val.I(avra_vgate_claim(self.running_vt(), gate))
    }

    /// A task nothing runs, filed as a job under `vt`: its record.
    fn unrun(vt: int) -> Val {
        let record = self.fresh_array([Val.I(self.tasks.length), Val.N, Val.N])
        self.tasks.push(job_of(vt, 0 - self.tasks.length, array_id(record) ?? -1, null, []))
        record
    }

    fn task_pending_val() -> Val {
        self.rooted()
        self.unrun(0)
    }

    /// A task the timer heap ends at `at_ns` — the runtime's own, so
    /// it takes part in no pick, here as in a compiled program. Its
    /// time holds its record until then, so one nobody else holds
    /// still ends.
    fn task_at_val(vals: List<Val>) -> Val {
        self.rooted()
        let record = self.unrun(0)
        let id = self.tasks.length - 1
        self.retains(record)
        self.tasks[id].gate = avra_task_at(self.whole(vals[0]))
        self.tasks[id].clocked = true
        self.clocked.push(id)
        record
    }

    fn task_answer_val(vals: List<Val>) -> Val {
        let id = self.task_of(vals[0])
        if self.tasks[id].done { return self.trapped_val("a task answered twice") }
        if !self.tasks[id].unrun() { return self.trapped_val("a running task answers for itself") }
        self.retains(vals[1])
        self.unrun_ended(id, vals[1], self.tasks[self.running].id)
        Val.I(0)
    }

    /// A cancel: a running task hears it at its wait; a task nothing
    /// runs simply ends, with no answer.
    fn task_cancel_val(vals: List<Val>) -> Val {
        self.rooted()
        let id = self.task_of(vals[0])
        if self.tasks[id].done { return Val.I(0) }
        if !self.tasks[id].unrun() {
            avra_vtask_cancel(self.tasks[id].vt, self.tasks[self.running].id)
            return Val.I(0)
        }
        self.tasks[id].cancelled = true
        self.unrun_ended(id, Val.N, self.tasks[self.running].id)
        Val.I(0)
    }

    /// The slot a key names in the running task, or null past the four.
    fn slot_key(v: Val) -> int? {
        let key = self.whole(v)
        if key >= 0 && key < 4 { return key }
        self.trapped("a task has four slots, and this is none of them")
        null
    }

    fn task_slot_val(vals: List<Val>) -> Val {
        self.rooted()
        let key? = self.slot_key(vals[0]) else { return Val.N }
        let held = self.tasks[self.running].slots[key]
        self.retains(held)
        held
    }

    fn task_slot_set_val(vals: List<Val>) -> Val {
        self.rooted()
        let key? = self.slot_key(vals[0]) else { return Val.I(0) }
        let old = self.tasks[self.running].slots[key]
        self.retains(vals[1])
        self.tasks[self.running].slots.set(key, vals[1])
        self.releases_val(old)
        Val.I(0)
    }

    fn task_id_val() -> Val {
        Val.I(if self.running < 0 { 0 } else { self.tasks[self.running].id })
    }
}

fn all_waiting() -> string {
    "every task is waiting — deadlock"
}
