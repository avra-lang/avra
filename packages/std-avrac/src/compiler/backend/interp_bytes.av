//! The byte rows, hosted: the evaluator holds `Bytes` as the runtime's
//! own box and answers each row through the runtime's own verb, so the
//! two engines read octets through ONE implementation. What stays here
//! is each row's bounds law, spoken as the evaluator's refusal before
//! the native verb could trap the evaluator itself.
use core.{RtSig}

impl Machine {
    /// OCTETS AT A ROW'S SEAT, FROM EITHER BOX — `text_val`'s mirror,
    /// and the same law read the other way. A row's seat kind is
    /// `Ptr`, which a string and a `Bytes` both fill; natively they
    /// are one headered box, so a C body that reads BYTES reads
    /// either. Only a row that ANSWERS TEXT owes a decode, and only
    /// that decode may refuse — a length, a byte, a search and a
    /// verdict never do. Spelled over every variant: a `Val` is a
    /// registry, and the catch-all that stood here is what forgot the
    /// string, so `avra_bytes_len("hi")` answered 2 compiled and a
    /// defect interpreted.
    fn octets(v: Val) -> Bytes {
        match v {
            .Y(data) -> data,
            .S(s) -> s.bytes(),
            .I(_) or .F(_) or .B(_) or .A(_) or .P(_) or .M(_) or .C(_) or .N or .Gone -> {
                self.defect("a non-Bytes value reached a byte operation")
                "".bytes()
            },
        }
    }

    fn bytes_at_val(vals: List<Val>) -> Val {
        let data = self.octets(vals[0])
        let at = self.whole(vals[1])
        if at < 0 || at >= data.length { return self.out_of_bounds(at, data.length) }
        Val.I(data.at(at))
    }

    fn bytes_slice_val(vals: List<Val>) -> Val {
        let data = self.octets(vals[0])
        let lo = self.whole(vals[1])
        let hi = self.whole(vals[2])
        if lo < 0 || hi < lo || hi > data.length { return self.slice_out_of_bounds(lo, hi, data.length, Val.Y("".bytes())) }
        Val.Y(data.slice(lo, hi))
    }

    /// The runtime's `trap_slice`, worded the same; `answer` stands in
    /// for the value the trapped row would have produced.
    fn slice_out_of_bounds(lo: int, hi: int, len: int, answer: Val) -> Val {
        self.trapped("slice ${lo}..${hi} is out of bounds (length ${len})")
        answer
    }

    fn bytes_index_of_val(vals: List<Val>) -> Val {
        let data = self.octets(vals[0])
        let from = self.whole(vals[2])
        if from < 0 || from > data.length { return self.out_of_bounds(from, data.length) }
        Val.I(data.index_of(self.octets(vals[1]), from))
    }

    /// Its bounds law spoken here, where the C body's trap would take
    /// the evaluator with it, then the body by name.
    fn bytes_index_in_val(row: RtSig, callee: string, vals: List<Val>) -> Val {
        let data = self.octets(vals[0])
        let lo = self.whole(vals[2])
        let hi = self.whole(vals[3])
        if lo < 0 || hi < lo || hi > data.length { return self.slice_out_of_bounds(lo, hi, data.length, Val.I(-1)) }
        self.hosted_extern(row, callee, vals)
    }

    fn bytes_run_val(vals: List<Val>) -> Val {
        let data = self.octets(vals[0])
        let from = self.whole(vals[1])
        let admits = self.octets(vals[2])
        if from < 0 || from > data.length { return self.out_of_bounds(from, data.length) }
        if admits.length != 256 {
            self.trapped("a class table holds 256 bytes (length ${admits.length})")
            return Val.I(0)
        }
        Val.I(data.run(from, admits))
    }

    /// `run`'s mirror: its bounds law spoken here, where the C body's
    /// trap would take the evaluator with it, then the body by name.
    fn bytes_run_back_val(row: RtSig, callee: string, vals: List<Val>) -> Val {
        let data = self.octets(vals[0])
        let from = self.whole(vals[1])
        let admits = self.octets(vals[2])
        if from < 0 || from > data.length { return self.out_of_bounds(from, data.length) }
        if admits.length != 256 {
            self.trapped("a class table holds 256 bytes (length ${admits.length})")
            return Val.I(0)
        }
        self.hosted_extern(row, callee, vals)
    }

    fn bytes_eq_at_val(vals: List<Val>, folded: bool) -> Val {
        let data = self.octets(vals[0])
        let lo = self.whole(vals[1])
        let hi = self.whole(vals[2])
        if lo < 0 || hi < lo || hi > data.length { return self.slice_out_of_bounds(lo, hi, data.length, Val.I(0)) }
        let needle = self.octets(vals[3])
        verdict(if folded { data.ieq_at(lo, hi, needle) } else { data.eq_at(lo, hi, needle) })
    }

    fn bytes_gathered_val(v: Val) -> Val {
        let id? = array_id(v) else { return self.defect_val("a non-list reached a gather") }
        Val.Y([self.octets(x) for x in self.arrays[id]].bytes())
    }

    fn bytes_of_list_val(v: Val) -> Val {
        let id? = array_id(v) else { return self.defect_val("a non-list reached byte construction") }
        let b? = [self.whole(x) for x in self.arrays[id]].bytes() else { return Val.N }
        Val.Y(b)
    }
}

/// Text from a box, or absence when its octets are not UTF-8 — the
/// `StrOfBytes` row's own answer, absence being the null pointer.
fn text_of_octets(b: Bytes) -> Val {
    let s? = b.text() else { return Val.N }
    Val.S(s)
}

/// A native box's octets as ints — what a crossing into the meta heap
/// and a value's fingerprint read.
fn octets_of_box(b: Bytes) -> List<int> {
    [b.at(i) for i in 0..b.length]
}
