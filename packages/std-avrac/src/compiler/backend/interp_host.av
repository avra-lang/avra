/// THE VERDICT A FAULT INSIDE THE CALLEE WILL WEAR, composed BEFORE
/// the call because a fault handler may not allocate. A HOST SEAT'S
/// ABSENCE IS A NULL POINTER and only the callee's own contract says
/// whether it may be one — `free(null)` is defined and `atoi(null)`
/// wrecks — so the seats that carried absence are named beside the
/// callee rather than refused ahead of it.
fn fault_words(callee: string, vals: List<Val>) -> string {
    let absent: List<int> = [j + 1 for j, v in vals if v is .N]
    if absent.is_empty() { return "a foreign body faulted inside `${callee}`" }
    "a foreign body faulted inside `${callee}` — ${absent_seats(absent)}"
}

/// The seats a call handed absence, spelled for those words.
fn absent_seats(absent: List<int>) -> string {
    let ns = joined(["${n}" for n in absent], ", ")
    if absent.length == 1 { return "seat ${ns} was handed `null`" }
    "seats ${ns} were handed `null`"
}

/// WHICH REGISTER FILE A SEAT RIDES. Spelled over every kind rather
/// than asked with `is`: `RtKind` is a registry, and a boolean about
/// ONE variant forgets the next one exactly as a catch-all would.
fn rides_fp(k: RtKind) -> bool {
    match k { .F64 -> true, .I64 or .Ptr or .Void or .I32 or .U32 -> false }
}

/// Each seat's index WITHIN ITS OWN register file — how many earlier
/// seats ride the same file. That is the only thing the frame needs,
/// because both ABIs fill each file in class order however the seats
/// interleave.
fn file_slots(kinds: List<RtKind>) -> List<int> {
    [[1 for j, p in kinds if j < i && rides_fp(p) == rides_fp(k)].length for i, k in kinds]
}

/// WHETHER A SEAT COULD CARRY TEXT — a pointer seat, and only that.
/// Spelled over every kind: `RtKind` is a registry, and a boolean
/// asking about ONE variant forgets the next exactly as a catch-all
/// would.
fn carries_text(k: RtKind) -> bool {
    match k { .Ptr -> true, .I64 or .Void or .I32 or .U32 or .F64 -> false }
}

/// A `Val`'s BYTES at a row's seat, or absence for a value that is
/// not a box of bytes. A string and a `Bytes` are ONE headered box
/// natively and the check reads that header, so both cross the same
/// door — reading only the string was the check declining to look at
/// the box the native binary was about to hand over. A word list at a
/// seat is a box and not a name; the rows that take one check their
/// own words in C.
fn bytes_of_val(v: Val) -> Bytes? {
    match v { .S(t) -> t.bytes(), .Y(data) -> data, rest -> null }
}

/// WHETHER A SEAT CARRIES A CELL — an inout, holding the address of
/// the caller's own slot. `Void` in the row's `cells` column means
/// the seat is not one. Spelled over every kind: a boolean asking
/// about ONE variant forgets the next exactly as a catch-all would.
/// The width behind seat `i`, or `Void` where the row declares none —
/// a row's `cells` column is shorter than its params whenever no seat
/// is an inout.
fn cell_at(sig: RtSig, i: int) -> RtKind {
    if i >= sig.cells.length { return RtKind.Void }
    sig.cells[i]
}

/// A cell as its declared width leaves it — the backend's
/// `narrow_sign` in the evaluator's currency, spelled over every kind
/// so a new width demands an answer here too.
///
/// A POINTER CELL ANSWERS THROUGH THE SAME DOOR AS A POINTER ANSWER:
/// zero is ABSENCE, not the number nought. `sqlite3_open_v2` leaves
/// NULL there when it fails, and a program that reads the handle back
/// as `0` rather than `null` would carry a non-null pointer to a
/// database that never opened.
fn settled_word(width: RtKind, w: int) -> Val {
    match width {
        .Ptr -> pointer_val(w),
        .I32 -> Val.I(sign_extended(w)),
        .U32 -> Val.I(zero_extended(w)),
        .I64 or .F64 or .Void -> Val.I(w),
    }
}

fn carries_cell(k: RtKind) -> bool {
    match k { .Void -> false, .I64 or .Ptr or .I32 or .U32 or .F64 -> true }
}

/// An answered address as the evaluator holds one: zero is the null
/// pointer, which is what a C sentinel of zero means, and anything
/// else is a word Avra can pass back but never read through.
fn pointer_val(address: int) -> Val {
    if address == 0 { Val.N } else { Val.I(address) }
}

/// A C `int` answer widened over the whole register — it wrote 32
/// bits and left the rest, so the sign its width names decides.
fn sign_extended(w: int) -> int {
    let low = w - w / 4294967296 * 4294967296
    if low >= 2147483648 { low - 4294967296 } else { low }
}

fn zero_extended(w: int) -> int {
    w - w / 4294967296 * 4294967296
}

