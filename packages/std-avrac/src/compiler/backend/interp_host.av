//! What the evaluator reaches OUT through: the extern host's frame,
//! the runtime rows it hosts, and the text/array/map projections they
//! answer with. The Machine core lives in interp.av.
use core.{Ins, RtSig, RtKind, opens_region, closes_region, joined}
use features.{nothing}
use compiler.lower.{Body}
use compiler.lower.{Body}

fn no_body_named(symbol: string) -> string { "no body named `${symbol}`" }
fn over_budget(steps: int) -> string { "took more than ${steps} steps" }
fn over_memory(bytes: int) -> string { "held more than ${bytes} bytes" }
// ── The host seam the evaluator reaches through ─────────────────
// The process substrate, the io rows and the clock are the runtime's
// own C; the evaluator calls the same functions the native program
// does, so there is one implementation, not two that agree.
extern fn avra_int_and(a: int, b: int) -> int
extern fn avra_int_or(a: int, b: int) -> int
extern fn avra_int_xor(a: int, b: int) -> int
extern fn avra_int_shl(a: int, b: int) -> int
extern fn avra_int_shr(a: int, b: int) -> int
