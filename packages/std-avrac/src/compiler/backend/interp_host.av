extern fn avra_now_ns() -> int
extern fn avra_puts(line: string)
extern fn avra_eputs(line: string)
extern fn avra_io_list(path: string) -> int
extern fn avra_str_from_codepoint(code: int) -> string
extern fn avra_exec_self(args: List<string>) -> int
extern fn avra_spawn_status(prog: string, args: List<string>) -> int
extern fn avra_spawn_in(dir: string, prog: string, args: List<string>) -> int
extern fn avra_fd_read(fd: int, max: int) -> int
extern fn avra_selfhost_file_exists(path: string) -> int
extern fn avra_selfhost_read_file(path: string) -> string
extern fn avra_fd_taken(token: int) -> Bytes
extern fn avra_fd_write(fd: int, bytes: Bytes, from: int) -> int
extern fn avra_utf8_bad_at(b: Bytes) -> int
// `avra_host_env` is the module's already — workspace.av declares it.

/// A line to the evaluator's own stderr — never the program's answer.
fn eputs_val(line: string) -> Val {
    avra_eputs(line)
    Val.I(0)
}

// ── Registers (the innermost frame, rewritten in place) ─────────

// ── Operations ──────────────────────────────────────────────────

// ── Control-flow bracket scans ──────────────────────────────────

impl Body {
    /// Where arm `k` of the region opened at `from` begins: just past
    /// the k-th arm separator at depth 0.
    fn arm_start(from: int, k: int) -> int {
        mut at = from
        for j in 0..k { at = self.ahead(at, opens_region, closes_region, (i: Ins) -> i is .ArmEnd) }
        at + 1
    }

    /// Forward from `from`+1: the pc of the first `target` at depth 0,
    /// with `opens`/`closes` tracking nesting. Target wins over close
    /// at depth 0, so a closer can BE the target.
    fn ahead(from: int, opens: fn(Ins) -> bool, closes: fn(Ins) -> bool, target: fn(Ins) -> bool) -> int {
        mut depth = 0
        mut j = from + 1
        while j < self.ins.length {
            let i = self.ins[j]
            if depth == 0 && target(i) { return j }
            if opens(i) { depth = depth + 1 }
            if closes(i) { depth = depth - 1 }
            j = j + 1
        }
        self.ins.length
    }

    /// From an IfStart: the pc just past its matching ArmEnd.
    fn past_else(from: int) -> int {
        self.ahead(from, opens_region, closes_region, (i: Ins) -> i is .ArmEnd) + 1
    }

    /// From a false LoopCond: the pc just past the matching LoopEnd.
    fn past_loop(from: int) -> int {
        self.loop_close(from, 0) + 1
    }

    /// From a `LoopJump`: the target loop's own `LoopEnd`, whose back
    /// edge starts the next turn, or the pc just past it.
    fn jumped(from: int, outward: int, again: bool) -> int {
        let end = self.loop_close(from, outward)
        if again { end } else { end + 1 }
    }

    /// The `LoopEnd` closing the loop `outward` brackets out of `from`.
    fn loop_close(from: int, outward: int) -> int {
        let end = self
            .ahead(
                from,
                (i: Ins) -> i is .LoopStart,
                (i: Ins) -> i is .LoopEnd,
                (i: Ins) -> i is .LoopEnd,
            )
        if outward == 0 { end } else { self.loop_close(end, outward - 1) }
    }

    /// From a LoopEnd: its matching LoopStart — the back edge. The
    /// one backward scan, shaped exactly as `ahead`: target first at
    /// depth 0, then the open/close bookkeeping.
    fn loop_header(from: int) -> int {
        mut depth = 0
        mut j = from - 1
        while j >= 0 {
            let i = self.ins[j]
            if depth == 0 && i is .LoopStart { return j }
            if i is .LoopEnd { depth = depth + 1 }
            if i is .LoopStart { depth = depth - 1 }
            j = j - 1
        }
        0
    }
}

// ── Calls ───────────────────────────────────────────────────────

// ── Mut cells ───────────────────────────────────────────────────

// ── Text projections ────────────────────────────────────────────

// ── The runtime surface, hosted — runtime_api.av's fifth consumer ─

fn array_id(v: Val) -> int? {
    match v { .A(id) -> id, _ -> null }
}

/// A bool answer as the runtime words it — a word, which the
/// register's type reads back as a bool.
fn verdict(b: bool) -> Val {
    Val.I(if b { 1 } else { 0 })
}

/// `n` held within [lo, hi].
fn clamped(n: int, lo: int, hi: int) -> int {
    if n < lo { return lo }
    if n > hi { return hi }
    n
}

/// The pieces between separators, cut as the runtime cuts them: a
/// leading empty piece stays, one trailing is dropped, empty text
/// splits to nothing, and an empty separator keeps the text whole.
fn pieces_of(s: string, sep: string) -> List<string> {
    if s.length == 0 { return [] }
    if sep.length == 0 { return [s] }
    mut out: List<string> = []
    mut rest = s
    mut at = rest.index_of(sep)
    while at >= 0 {
        out.push(rest.substring(0, at))
        rest = rest.substring(at + sep.length, rest.length)
        at = rest.index_of(sep)
    }
    if rest.length > 0 { out.push(rest) }
    out
}

/// Every occurrence of `from` as `to`, cut as the runtime cuts:
/// an empty `from` changes nothing.
fn replaced(s: string, from: string, to: string) -> string {
    if from.length == 0 { return s }
    pieces_of_all(s, from).join(to)
}

/// The pieces between EVERY separator — a trailing empty piece
/// kept, unlike `split` — so a join with `to` is the replacement.
fn pieces_of_all(s: string, sep: string) -> List<string> {
    mut out: List<string> = []
    mut rest = s
    mut at = rest.index_of(sep)
    while at >= 0 {
        out.push(rest.substring(0, at))
        rest = rest.substring(at + sep.length, rest.length)
        at = rest.index_of(sep)
    }
    out.push(rest)
    out
}

/// The text without its surrounding blanks — space, tab, newline
/// and return, the runtime's set.
export fn trimmed(s: string) -> string {
    let n = s.length
    mut lo = 0
    while lo < n && is_blank(s.char_code(lo)) { lo = lo + 1 }
    mut hi = n
    while hi > lo && is_blank(s.char_code(hi - 1)) { hi = hi - 1 }
    s.substring(lo, hi)
}

fn is_blank(c: int) -> bool {
    c == 32 || c == 9 || c == 10 || c == 13
}

/// TEXT -> INT, mirroring `avra_int_parse_walk` in avra_runtime.c so
/// eval == native by construction: `-`? digits, the ceiling on both
/// sides, nothing else. The magnitude accumulates NEGATIVE regardless
/// of sign — a positive walk bounded by the largest int can never
/// reach the smallest one without wrapping first, which is the same
/// wall the lexer's own token grammar hits.
fn text_int(s: string) -> int? {
    let n = s.length
    let negative = n > 0 && s.char_code(0) == 45
    mut i = if negative { 1 } else { 0 }
    if i == n { return null }
    let limit = if negative { 0 - 9223372036854775807 - 1 } else { 0 - 9223372036854775807 }
    let limit_div10 = limit / 10
    let limit_last = 0 - (limit - limit_div10 * 10)
    mut v = 0
    while i < n {
        let c = s.char_code(i)
        if c < 48 || c > 57 { return null }
        let d = c - 48
        if v < limit_div10 || v == limit_div10 && d > limit_last { return null }
        v = v * 10 - d
        i = i + 1
    }
    if negative { return v }
    0 - v
}

/// A map's keys and values in written order — the spec's map,
/// found by a scan.
type MapVal = { keys: List<string>, vals: List<Val> }

fn map_id(v: Val) -> int? {
    match v { .M(id) -> id, _ -> null }
}

