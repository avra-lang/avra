//! EVERY MEANING, gathered: a `meaning` declared in any feature dir joins this with no edit here,
//! filed under the node kinds its arms are rooted at.
use features.{TypedCode, meaning}
use @std.meta.{Rewrite}

/// One meaning: its identity, its arms as one fn, and the node kinds those arms are rooted at.
export type MeaningEntry = { name: string, module: string, run: fn(TypedCode) -> Rewrite?, root: List<int>, doc: string }

export collect meanings: List<MeaningEntry> = meaning in closure as MeaningEntry { name: it.name, module: it.module, run: it.run, root: it.root_kind, doc: it.doc } by it.module, it.name

/// The meaning table's index, built once.
export once fn meaning_index() -> RootIndex<MeaningEntry> { root_indexed(meanings, (m: MeaningEntry) -> m.root) }
