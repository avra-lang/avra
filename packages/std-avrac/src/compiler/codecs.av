//! THE CODEC KEEPER — a record's wire ENCODER and its DECODER agree,
//! checked by machine. Nothing else in the tree compares them: three
//! disagreements landed the same day (avra-8sb5.57.67) — a seat mark
//! written three characters wide and read one wide, `SeatMark.consumed`
//! never encoded, a record-shape stamp never compared — and a warm
//! cache served wrong code, silently, until something else noticed.
//!
//! ONE REGISTRY, `codec_pairs()`: every row names its encode fn, its
//! decode fn, its exemplars and its equality. `decode(encode(x))` is
//! compared to `x` FIELD BY FIELD (`@derive(Exemplar)`'s `codec_same`,
//! or a hand-written one) — never `encode(decode(encode(x))) ==
//! encode(x)`, which is idempotence and passes when a field is
//! dropped both times (CLAUDE.md, "a check can pass because of the
//! bug"). `tools/codecs.py` is this file's OTHER surface: it refuses
//! an encoder/decoder-shaped pair the tree carries that this registry
//! does not name.
use core.{DeclId, SeatMark, TypeId, Type, DeclKind, list_eq}
use features.{
    DeclFacts,
    AnnotationFact,
    Settled,
    MetaHeap,
    Wanted,
    SeatValue,
    MetaVal,
    UseKind,
    kind_word,
    Unsettled,
    Settlement,
}
use diagnostics.{SourceFile, DiagFacts, Severity}
use @std.errors.{Loc, Frame, Suggestion, Edit, Confidence}
use compiler.{avra, new_workspace, Workspace}
use compiler.host.{memory_host}
use compiler.lower.{CodeFacts, FactNode, code_facts_wire, code_facts_from_wire}
use @std.text.{from_codepoint}
use compiler.failures.{Raised}

// ── THE HARNESS ─────────────────────────────────────────────────────

/// One registered pair: its name (both fn names, `encoder/decoder`),
/// and a thunk that runs every exemplar through it — a fn so the
/// registry can hold rows of DIFFERENT concrete types in one list.
export type CodecCheck = { pair: string, run: fn() -> List<string> }

/// A pair built from a type's own `@derive(Exemplar)` samples.
fn derived<T, W>(
    pair: string,
    exemplars: List<T>,
    labels: List<string>,
    encode: fn(T) -> W,
    decode: fn(W) -> T?,
    same: fn(T, T) -> bool,
) -> CodecCheck {
    CodecCheck {
        pair: pair,
        run: () -> codec_disagreements(pair, exemplars, labels, encode, decode, same),
    }
}

fn codec_disagreements<T, W>(
    pair: string,
    exemplars: List<T>,
    labels: List<string>,
    encode: fn(T) -> W,
    decode: fn(W) -> T?,
    same: fn(T, T) -> bool,
) -> List<string> {
    let raw = [codec_one(pair, label_at(labels, i), exemplars[i], encode, decode, same) for i in 0..exemplars.length]
    [m! for m in raw if m != null]
}

fn label_at(labels: List<string>, i: int) -> string {
    if i < labels.length { labels[i] } else { "exemplar ${i}" }
}

fn codec_one<T, W>(
    pair: string,
    label: string,
    value: T,
    encode: fn(T) -> W,
    decode: fn(W) -> T?,
    same: fn(T, T) -> bool,
) -> string? {
    let wire = encode(value)
    let back? = decode(wire) else { return "${pair}: exemplar \\`${label}\\` failed to decode its own wire" }
    if same(value, back) { return null }
    "${pair}: exemplar \\`${label}\\` round-tripped to a different value"
}

/// `derived`'s twin for a decoder that never answers absent — it
/// falls back to a plain default on bad input rather than failing
/// (`mark_of_word`, `unpacked`, `doc_of_wire`'s own `T` IS `List<string>?`
/// already, so ITS decode answers that type directly, never a second
/// layer of `?`). The only question left is whether the value survived.
fn derived_total<T, W>(
    pair: string,
    exemplars: List<T>,
    labels: List<string>,
    encode: fn(T) -> W,
    decode: fn(W) -> T,
    same: fn(T, T) -> bool,
) -> CodecCheck {
    CodecCheck {
        pair: pair,
        run: () -> total_disagreements(pair, exemplars, labels, encode, decode, same),
    }
}

fn total_disagreements<T, W>(
    pair: string,
    exemplars: List<T>,
    labels: List<string>,
    encode: fn(T) -> W,
    decode: fn(W) -> T,
    same: fn(T, T) -> bool,
) -> List<string> {
    let raw = [total_one(pair, label_at(labels, i), exemplars[i], encode, decode, same) for i in 0..exemplars.length]
    [m! for m in raw if m != null]
}

fn total_one<T, W>(
    pair: string,
    label: string,
    value: T,
    encode: fn(T) -> W,
    decode: fn(W) -> T,
    same: fn(T, T) -> bool,
) -> string? {
    let back = decode(encode(value))
    if same(value, back) { return null }
    "${pair}: exemplar \\`${label}\\` round-tripped to a different value"
}

// ── ADAPTERS — a decoder whose own shape does not match `fn(W) -> T?`
// (a `mut` seat, a bound method, extra context) gets ONE free-fn
// wrapper here, never a re-implementation. ──

/// `heap_from_wire`'s seat is `mut WireReader`, a different TYPE from
/// `fn(string) -> MetaHeap?` (CLAUDE.md, "a fn type carries its
/// seats' contract") — and `heap_wire` writes no envelope of its own
/// (it is always framed by a caller), so the reader starts at 0, not
/// `wire_reader`'s 2.
fn heap_from_wire_wire(raw: string) -> MetaHeap? {
    mut r = WireReader { raw: raw, pos: 0 }
    heap_from_wire(r)
}

// ── A FIXTURE WORKSPACE — the codecs that cross `TypeId`/`FileId`/
// `DeclId` need a real `Decls`/`TypeRegistry` to intern into; this is
// that one, and `codec_decl_exemplars` mints its file's declarations
// so the id-writing codecs name a real `DeclId`. Its own verbs live on
// `Workspace` (`style.free_state_verb`). ──

fn codec_workspace() -> Workspace {
    new_workspace(
        memory_host(
            {
                "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n",
                "/w/src/main.av": "fn a() { 1 }\n",
                "/w/src/other.av": "fn b() { 2 }\n",
            },
            ["/w/avra.toml", "/w/src/main.av", "/w/src/other.av"],
        ),
        "/w",
        avra(),
    )
}

impl Workspace {
    /// `interface_type`'s own decode never answers absent (a broken
    /// wire falls back to the error type), so it joins the "total"
    /// side too.
    fn codec_interface_type_total(w: string) -> TypeId { self.interface_type(w) }

    /// Every scalar, plus one composite of each structural shape — a
    /// `Fn` with every seat mark on, since that is exactly what
    /// widened (avra-8sb5.57.67), and a `Union` since it canonicalizes
    /// its own members on intern.
    fn codec_type_exemplars() -> List<TypeId> {
        let i = self.decls.types.type(int)
        let b = self.decls.types.type(bool)
        let marks = [
            SeatMark { mutable: true, settled: false },
            SeatMark { mutable: false, settled: true, unshared: true, consumed: true },
        ]
        [
            i,
            self.decls.types.type(float),
            b,
            self.decls.types.type(string),
            self.decls.types.intern(Type.Bytes),
            self.decls.types.intern(Type.Ptr),
            self.decls.types.intern(Type.Void),
            self.decls.types.intern(Type.Null),
            self.decls.types.intern(Type.EmptyList),
            self.decls.types.intern(Type.EmptyMap),
            self.decls.types.intern(Type.Error),
            self.decls.types.type(List<int>),
            self.decls.types.type(int?),
            self.decls.types.type(Map<string, int>),
            self.decls.types.type(Result<int, bool>),
            self.decls.types.intern(Type.Fn([i, b], marks, i)),
            self.decls.types.union_of([i, b]),
        ]
    }

    fn codec_same_type_shape(a: TypeId, b: TypeId) -> bool {
        self.decls.type_wire(a) == self.decls.type_wire(b)
    }

    /// A handful of `Wanted` rows — `decl: null`/`sub: null`
    /// throughout: `decl_wire`'s own round trip is exercised beside its
    /// decoder (`interface.decl_wire/wire_decl`), so `sub_wire`'s nested
    /// declaration ref is covered here only as far as its decoder never
    /// runs (`sub_mark == "+"`) — `seat_wire`'s shape is exercised in
    /// full through a seat carrying a real `TypeId`.
    fn codec_wanted_exemplars() -> List<Wanted> {
        let i = self.decls.types.type(int)
        let seat = SeatValue {
            index: 0,
            fp: "7",
            ty: i,
            value: MetaVal.Int(9),
            heap: MetaHeap.codec_zero(),
        }
        [
            Wanted {
                file: self.file_id("/w/src/main.av"),
                decl: null,
                name: "plain",
                sub: null,
                seats: [],
                root: null,
            },
            Wanted {
                file: self.file_id("/w/src/main.av"),
                decl: null,
                name: "seated",
                sub: null,
                seats: [seat],
                root: null,
            },
        ]
    }

    fn codec_wanted_batches() -> List<List<Wanted>> {
        let no_wanted: List<Wanted> = []
        [no_wanted, self.codec_wanted_exemplars()]
    }

    fn codec_same_wanted(a: Wanted, b: Wanted) -> bool {
        self.wanted_wire(a) == self.wanted_wire(b)
    }

    /// The fixture's real declarations: `items` mints every row of the
    /// file, so the id-writing codecs name a `DeclId` the program
    /// itself made — a workspace with none would pass vacuously.
    fn codec_decl_exemplars() -> List<DeclId> { self.items(self.file_id("/w/src/main.av")) }

    fn codec_decl_labels() -> List<string> { [self.decls.decl(d).name for d in self.codec_decl_exemplars()] }

    fn codec_same_decl(a: DeclId, b: DeclId) -> bool { self.decls.decl_wire(a) == self.decls.decl_wire(b) }

    fn codec_raised_exemplars() -> List<Raised> {
        let d = self.codec_decl_exemplars()[0]
        [
            Raised { owner: d, errors: [] },
            Raised { owner: d, errors: [self.decls.types.type(int), self.decls.types.type(bool)] },
        ]
    }

    fn codec_same_raised(a: Raised, b: Raised) -> bool {
        self.decls.decl_wire(a.owner) == self.decls.decl_wire(b.owner) &&
            list_eq(
                a.errors,
                b.errors,
                (x, y) -> self.decls.type_wire(x) == self.decls.type_wire(y),
            )
    }

    /// `Loc`s anchored to the fixture's real declarations: a loc with
    /// no file, a span at its declaration's start, a span inside it,
    /// and a cross-file span anchored in the other file.
    fn codec_loc_exemplars() -> List<Loc> {
        let a = self.codec_decl_exemplars().find((d) -> self.decls.decl(d).name == "a")!
        let b = self
            .items(self.file_id("/w/src/other.av"))
            .find((d) -> self.decls.decl(d).name == "b")!
        let sa = self.decls.decl_span(a)!
        let sb = self.decls.decl_span(b)!
        [
            Loc { file: null, lo: 3, hi: 7 },
            Loc { file: "/w/src/main.av", lo: sa.lo, hi: sa.lo },
            Loc { file: "/w/src/main.av", lo: sa.lo + 1, hi: sa.hi },
            Loc { file: "/w/src/other.av", lo: sb.lo, hi: sb.hi },
        ]
    }

    fn codec_loc_labels() -> List<string> {
        ["no file", "at its declaration's start", "inside its declaration", "cross-file"]
    }

    /// A `DiagFacts` bearing each loc shape, so the row's own `Loc`s
    /// are exercised beside the pair's.
    fn codec_diag_exemplars() -> List<DiagFacts> {
        let at = self.codec_loc_exemplars()[2]
        [
            DiagFacts {
                kind: "t.plain",
                severity: Severity.Warning,
                primary: Frame { label: null, loc: null },
                secondary: [],
                cause_lines: [],
                message: "no source",
                help: null,
                suggestions: [],
            },
            DiagFacts {
                kind: "t.rich",
                severity: Severity.Error,
                primary: Frame { label: "here", loc: at },
                secondary: [Frame { label: null, loc: at }],
                cause_lines: ["caused by: x"],
                message: "a message",
                help: "a help",
                suggestions: [
                    Suggestion {
                        confidence: Confidence.High,
                        description: "a fix",
                        edits: [Edit { loc: at, replacement: "z" }],
                    },
                ],
            },
        ]
    }

    fn codec_diag_labels() -> List<string> { ["an unlocated warning", "an error with a frame and a fix"] }
}

fn type_exemplar_labels() -> List<string> {
    [
        "int",
        "float",
        "bool",
        "string",
        "bytes",
        "ptr",
        "void",
        "null",
        "empty_list",
        "empty_map",
        "error",
        "list",
        "opt",
        "map",
        "res",
        "fn_with_marks",
        "union",
    ]
}

fn wanted_batch_labels() -> List<string> {
    ["empty", "no-seat and one-seat rows"]
}

// ── `DbRow` — its decoder needs the KIND alongside the wire (the
// payload carries no tag of its own; the durable key does), so it is
// not `fn(W) -> T?` shaped and stands outside `derived`. ──

fn dbrow_exemplars() -> List<DbRow> {
    [
        DbRow.Sig("n", "text"),
        DbRow.Warn("n", "warn\ntext"),
        DbRow.Scan("n", "1"),
        DbRow.Canon("n", ""),
        DbRow.Licenses("n", "a.av\t7\tstyle.thing"),
        DbRow.Findings("n", "style.thing\ta.av\tsome line"),
        DbRow.Answer("n", "0aff"),
        DbRow.Decl("n", docfacts_sample()),
    ]
}

fn docfacts_sample() -> DocFacts {
    DocFacts.codec_zero() with { answer: "rendered text" }
}

fn dbrow_check() -> CodecCheck {
    CodecCheck { pair: "db.encoded/decoded (DbRow)", run: dbrow_disagreements }
}

fn dbrow_disagreements() -> List<string> {
    let raw = [dbrow_one(r) for r in dbrow_exemplars()]
    [m! for m in raw if m != null]
}

fn dbrow_one(r: DbRow) -> string? {
    let wire = encoded(r)
    let back? = decoded(r.kind(), r.key(), wire) else { return "db.encoded/decoded (DbRow): exemplar \\`${r.kind().tag()}\\` failed to decode" }
    if dbrow_same(r, back) { return null }
    "db.encoded/decoded (DbRow): exemplar \\`${r.kind().tag()}\\` round-tripped to a different value"
}

fn dbrow_same(a: DbRow, b: DbRow) -> bool {
    match a {
        .Decl(name, facts) -> match b {
            .Decl(name_b, facts_b) -> name == name_b && facts.codec_same(facts_b),
            rest -> false,
        },
        .Sig(name, text) -> match b { .Sig(name_b, text_b) -> name == name_b && text == text_b, rest -> false },
        .Warn(name, text) -> match b { .Warn(name_b, text_b) -> name == name_b && text == text_b, rest -> false },
        .Scan(name, text) -> match b { .Scan(name_b, text_b) -> name == name_b && text == text_b, rest -> false },
        .Canon(name, text) -> match b { .Canon(name_b, text_b) -> name == name_b && text == text_b, rest -> false },
        .Licenses(name, text) -> match b { .Licenses(name_b, text_b) -> name == name_b && text == text_b, rest -> false },
        .Findings(name, text) -> match b { .Findings(name_b, text_b) -> name == name_b && text == text_b, rest -> false },
        .Answer(name, text) -> match b { .Answer(name_b, text_b) -> name == name_b && text == text_b, rest -> false },
        rest -> false,
    }
}

// ── `packed`/`unpacked` — length-prefixed, safe against ANY bytes in
// an element (its own doc: "never searched for") — hand-exemplared
// with the separators it exists to survive (`;`, `~`, `:`), an empty
// element, and an empty list. ──

/// Every list pair's sample whose last element is empty — the value a
/// decoder that splits a joined line reads back one field short.
const empty_last_label = "an empty last element"

fn packed_exemplars() -> List<List<string>> {
    let no_strings: List<string> = []
    [
        no_strings,
        [""],
        ["a"],
        ["a", "", "b"],
        ["a", ""],
        ["has;semi", "has~tilde", "has:colon"],
        ["tab\tand\nnewline"],
    ]
}

fn packed_labels() -> List<string> {
    [
        "empty",
        "one empty element",
        "one element",
        "an empty element in the middle",
        empty_last_label,
        "wire punctuation inside elements",
        "tab and newline inside an element",
    ]
}

// ── `list_field`/`read_list` — record.av's own doc: "Reserved for
// text this build already knows carries no `~`" (a type spelling, a
// parameter name), unlike `packed`. Exemplared inside that contract —
// `~` is the one byte this pair never promises to survive. ──

fn list_field_exemplars() -> List<List<string>> {
    let no_strings: List<string> = []
    [
        no_strings,
        [""],
        ["a"],
        ["a", "", "b"],
        ["a", ""],
        ["List<int>", "string?", "fn(int) -> bool"],
    ]
}

fn list_field_labels() -> List<string> {
    [
        "empty",
        "one empty element",
        "one element",
        "a middle element left empty",
        empty_last_label,
        "type spellings",
    ]
}

fn same_string_list(a: List<string>, b: List<string>) -> bool {
    list_eq(a, b, (x, y) -> x == y)
}

/// The names a file's `component` declarations wear — a `List<string>`,
/// the one shape `packed`/`unpacked` already carries.
fn component_name_exemplars() -> List<List<string>> { [[], [""], ["a", "b"]] }

fn component_name_labels() -> List<string> { ["no names", "one empty name", "two names"] }

// ── `doc_wire`/`doc_of_wire` — `List<string>?`, present vs absent. ──

fn doc_wire_exemplars() -> List<List<string>?> {
    let none: List<string>? = null
    let no_lines: List<string> = []
    [none, no_lines, [""], ["one line"], ["line one", ""], ["line one", "line two, with a comma"]]
}

fn doc_wire_labels() -> List<string> {
    ["absent", "present, empty", "one empty line", "one line", "an empty last line", "two lines"]
}

fn same_opt_string_list(a: List<string>?, b: List<string>?) -> bool {
    (a == null) == (b == null) && (a == null || same_string_list(a!, b!))
}

// ── `annotations_wire`/`annotations_of_wire` — `List<AnnotationFact>`,
// over the field's own derived exemplars. ──

fn annotations_wire_exemplars() -> List<List<AnnotationFact>> {
    let none: List<AnnotationFact> = []
    [none, [AnnotationFact.exemplars()[0]], AnnotationFact.exemplars()]
}

fn annotations_wire_labels() -> List<string> {
    ["empty", "one", "every exemplar"]
}

fn same_annotation_list(a: List<AnnotationFact>, b: List<AnnotationFact>) -> bool {
    list_eq(a, b, (x, y) -> x.codec_same(y))
}

// ── `kind_word`/`kind_of_word` — a record line's "kind" column, for
// the shapes that actually READ it back: `Fn`/`Extern`/`Opaque` alone
// (`record.av`'s `declared_kind`). `Record`/`Named`/`Alias` also
// encode through `kind_word` (all three collapse to "type"), but
// their DeclKind comes back from the SHAPE column instead — `kind_of_
// word` has no `"type"` arm at all — so those three sit outside this
// pair's own contract and are left out of its exemplars. ──

fn decl_kind_exemplars() -> List<DeclKind> {
    [
        DeclKind.Fn,
        DeclKind.Enum,
        DeclKind.Trait,
        DeclKind.Syntax,
        DeclKind.Method,
        DeclKind.Default,
        DeclKind.Impl,
        DeclKind.Main,
        DeclKind.Case,
        DeclKind.Const,
        DeclKind.Collect,
        DeclKind.CollectEnum,
        DeclKind.Builtin,
    ]
}

fn decl_kind_labels() -> List<string> {
    [
        "fn",
        "enum",
        "trait",
        "syntax",
        "method",
        "default",
        "impl",
        "main",
        "case",
        "const",
        "collect",
        "collect_enum",
        "builtin",
    ]
}

fn kind_of_word_total(w: string) -> DeclKind {
    kind_of_word(w) ?? DeclKind.Builtin
}

fn same_decl_kind(a: DeclKind, b: DeclKind) -> bool { a == b }

/// A file's key parts, the root module's empty name and an empty
/// seen module's among them.
fn key_parts_exemplars() -> List<KeyParts> {
    [
        KeyParts { module: "", path: "src/main.av", text: "t0", runs: [], gathered: [], seen: [] },
        KeyParts {
            module: "lib.deep",
            path: "src/lib/deep/a.av",
            text: "t1",
            runs: ["r0", "r1"],
            gathered: ["g0"],
            seen: [
                SeenPart { module: "", bytes_key: "b0", files: 1 },
                SeenPart { module: "io", bytes_key: "b1", files: 0 },
            ],
        },
    ]
}

fn key_parts_labels() -> List<string> { ["the root module, nothing seen", "a nested module seeing the root"] }

fn same_key_parts(a: KeyParts, b: KeyParts) -> bool {
    a.module == b.module &&
        a.path == b.path &&
        a.text == b.text &&
        list_eq(a.runs, b.runs, (x: string, y: string) -> x == y) &&
        list_eq(a.seen, b.seen, same_seen)
}

fn seen_exemplars() -> List<List<SeenPart>> {
    [
        [],
        [
            SeenPart { module: "", bytes_key: "b0", files: 0 },
            SeenPart { module: "io", bytes_key: "b1", files: 3 },
        ],
    ]
}

fn seen_labels() -> List<string> { ["nothing seen", "the root module and one other"] }

fn same_seen_list(a: List<SeenPart>, b: List<SeenPart>) -> bool { list_eq(a, b, same_seen) }

fn same_seen(a: SeenPart, b: SeenPart) -> bool { a.module == b.module && a.bytes_key == b.bytes_key && a.files == b.files }

// ── `code_facts_wire`/`code_facts_from_wire` — a held file's code. ──

fn code_facts_exemplars() -> List<CodeFacts> {
    [
        CodeFacts { nodes: [], addressed: [], asked: [] },
        CodeFacts {
            nodes: [FactNode { name: "leaf", own: "d0", refs: [] }],
            addressed: [],
            asked: [],
        },
        CodeFacts {
            nodes: [FactNode { name: "a:b", own: "d1", refs: ["leaf", "c:d"] }],
            addressed: ["leaf"],
            asked: ["answer\$body"],
        },
    ]
}

fn code_facts_labels() -> List<string> {
    ["no code", "a node with no references", "names holding a colon, an address and an ask"]
}

fn same_code_facts(a: CodeFacts, b: CodeFacts) -> bool {
    list_eq(a.nodes, b.nodes, same_fact_node) &&
        same_texts(a.addressed, b.addressed) &&
        same_texts(a.asked, b.asked)
}

fn same_fact_node(a: FactNode, b: FactNode) -> bool { a.name == b.name && a.own == b.own && same_texts(a.refs, b.refs) }

fn same_texts(a: List<string>, b: List<string>) -> bool { list_eq(a, b, (x, y) -> x == y) }

// ── `use_kind_word`/`use_kind_of_word` — every variant, one character each. ──

fn use_kind_exemplars() -> List<UseKind> {
    [UseKind.Call, UseKind.MethodCall, UseKind.Read, UseKind.Write, UseKind.Import, UseKind.TypeUse]
}

fn use_kind_labels() -> List<string> { ["call", "method call", "read", "write", "import", "type use"] }

fn same_use_kind(a: UseKind, b: UseKind) -> bool { a == b }

// ── `reach_wire`/`reach_from_wire` — a refusal's words, framed. ──

fn reach_exemplars() -> List<string> { ["", "reads the clock", "a\tb\nc", "R1 inside the words"] }

fn reach_labels() -> List<string> {
    [
        "no words",
        "plain words",
        "tab and newline inside the words",
        "the envelope's own mark inside the words",
    ]
}

fn same_text(a: string, b: string) -> bool { a == b }

// ── The scalar family answers — `int`, `bool`, `string` and `bool?`
// ride the `MetaVal` scalar wire (`scalar_wire.av`). ──

fn int_wire_exemplars() -> List<int> { [0, 1, -1, 42, 9223372036854775807] }

fn int_wire_labels() -> List<string> { ["zero", "one", "minus one", "forty-two", "the int ceiling"] }

fn bool_wire_exemplars() -> List<bool> { [true, false] }

fn bool_wire_labels() -> List<string> { ["true", "false"] }

fn text_wire_exemplars() -> List<string> { ["", "a", from_codepoint(0), "two\nlines"] }

fn text_wire_labels() -> List<string> { ["empty", "one character", "a NUL alone", "a newline inside"] }

fn presence_wire_exemplars() -> List<bool?> { [null, true, false] }

fn presence_wire_labels() -> List<string> { ["absent", "present true", "present false"] }

fn same_opt_bool(a: bool?, b: bool?) -> bool {
    (a == null) == (b == null) && (a == null || a! == b!)
}

// ── The `Loc` and `DiagFacts` wires — a span crosses anchored to its
// declaration, its offsets relative to that declaration's start. ──

fn same_loc(a: Loc, b: Loc) -> bool { a.file == b.file && a.lo == b.lo && a.hi == b.hi }

fn same_loc_opt(a: Loc?, b: Loc?) -> bool {
    (a == null) == (b == null) && (a == null || same_loc(a!, b!))
}

fn same_frame(a: Frame, b: Frame) -> bool { a.label == b.label && same_loc_opt(a.loc, b.loc) }

fn same_frame_list(a: List<Frame>, b: List<Frame>) -> bool { list_eq(a, b, same_frame) }

fn same_edit(a: Edit, b: Edit) -> bool { same_loc(a.loc, b.loc) && a.replacement == b.replacement }

fn same_suggestion(a: Suggestion, b: Suggestion) -> bool {
    a.confidence == b.confidence &&
        a.description == b.description &&
        list_eq(a.edits, b.edits, same_edit)
}

fn same_diag_facts(a: DiagFacts, b: DiagFacts) -> bool {
    a.kind == b.kind &&
        a.severity == b.severity &&
        same_frame(a.primary, b.primary) &&
        same_frame_list(a.secondary, b.secondary) &&
        list_eq(a.cause_lines, b.cause_lines, (x, y) -> x == y) &&
        a.message == b.message &&
        a.help == b.help &&
        list_eq(a.suggestions, b.suggestions, same_suggestion)
}

// ── THE REGISTRY ─────────────────────────────────────────────────────

/// The fixture workspace's declaration names — the receipt that the
/// id-writing codecs name a real `DeclId` rather than an empty list.
export fn codec_fixture_decl_names() -> List<string> { codec_workspace().codec_decl_labels() }

/// The refusal law, exercised: a span no single declaration holds whole
/// — one byte past its declaration's end — is refused, so a position
/// that pointed outside its declaration never decodes to a moved one.
export fn codec_loc_past_end_refused() -> bool {
    let ws = codec_workspace()
    let a = ws.codec_decl_exemplars().find((d) -> ws.decls.decl(d).name == "a")!
    let sp = ws.decls.decl_span(a)!
    let past = Loc { file: "/w/src/main.av", lo: sp.lo, hi: sp.hi + 1 }
    ws.loc_of_wire(ws.loc_wire(past)) == null
}

export fn codec_pairs() -> List<CodecCheck> {
    let ws = codec_workspace()
    [
        derived(
            "lower.code_facts_wire/code_facts_from_wire",
            code_facts_exemplars(),
            code_facts_labels(),
            code_facts_wire,
            code_facts_from_wire,
            same_code_facts,
        ),
        derived(
            "record.parts_wire/parts_of",
            key_parts_exemplars(),
            key_parts_labels(),
            parts_wire,
            parts_of,
            same_key_parts,
        ),
        derived(
            "record.seen_wire/seen_of",
            seen_exemplars(),
            seen_labels(),
            seen_wire,
            seen_of,
            same_seen_list,
        ),
        derived_total(
            "record.kind_word/kind_of_word",
            decl_kind_exemplars(),
            decl_kind_labels(),
            kind_word,
            kind_of_word_total,
            same_decl_kind,
        ),
        derived_total(
            "record.mark_word/mark_of_word",
            SeatMark.exemplars(),
            SeatMark.exemplar_labels(),
            mark_word,
            mark_of_word,
            (x, y) -> x.codec_same(y),
        ),
        derived_total(
            "record.annotation_wire/annotation_of_wire",
            AnnotationFact.exemplars(),
            AnnotationFact.exemplar_labels(),
            annotation_wire,
            annotation_of_wire,
            (x, y) -> x.codec_same(y),
        ),
        derived(
            "record.facts_block/facts_unblocked",
            DeclFacts.exemplars(),
            DeclFacts.exemplar_labels(),
            facts_block,
            facts_unblocked,
            (x, y) -> x.codec_same(y),
        ),
        derived(
            "db.encoded_filewitness/decoded_filewitness",
            FileWitness.exemplars(),
            FileWitness.exemplar_labels(),
            encoded_filewitness,
            decoded_filewitness,
            (x, y) -> x.codec_same(y),
        ),
        derived(
            "db.encoded_docfacts/decoded_docfacts",
            DocFacts.exemplars(),
            DocFacts.exemplar_labels(),
            encoded_docfacts,
            decoded_docfacts,
            (x, y) -> x.codec_same(y),
        ),
        derived(
            "settlement_wire.settled_wire/settled_from_wire",
            Settled.exemplars(),
            Settled.exemplar_labels(),
            settled_wire,
            settled_from_wire,
            (x, y) -> x.codec_same(y),
        ),
        derived(
            "settlement_wire.heap_wire/heap_from_wire",
            MetaHeap.exemplars(),
            MetaHeap.exemplar_labels(),
            heap_wire,
            heap_from_wire_wire,
            (x, y) -> x.codec_same(y),
        ),
        derived_total(
            "record.packed/unpacked",
            packed_exemplars(),
            packed_labels(),
            packed,
            unpacked,
            same_string_list,
        ),
        derived_total(
            "record.list_field/read_list",
            list_field_exemplars(),
            list_field_labels(),
            list_field,
            read_list,
            same_string_list,
        ),
        derived_total(
            "record.doc_wire/doc_of_wire",
            doc_wire_exemplars(),
            doc_wire_labels(),
            doc_wire,
            doc_of_wire,
            same_opt_string_list,
        ),
        derived_total(
            "record.annotations_wire/annotations_of_wire",
            annotations_wire_exemplars(),
            annotations_wire_labels(),
            annotations_wire,
            annotations_of_wire,
            same_annotation_list,
        ),
        derived_total(
            "interface.type_wire/interface_type",
            ws.codec_type_exemplars(),
            type_exemplar_labels(),
            (t) -> ws.decls.type_wire(t),
            (w) -> ws.codec_interface_type_total(w),
            (x, y) -> ws.codec_same_type_shape(x, y),
        ),
        derived(
            "interface.type_wire/settlement_wire.type_from_wire",
            ws.codec_type_exemplars(),
            type_exemplar_labels(),
            (t) -> ws.decls.type_wire(t),
            (w) -> ws.type_from_wire(w),
            (x, y) -> ws.codec_same_type_shape(x, y),
        ),
        derived(
            "settlement_wire.wanted_list_wire/wanted_list_from_wire",
            ws.codec_wanted_batches(),
            wanted_batch_labels(),
            (xs) -> ws.wanted_list_wire(xs),
            (w) -> ws.wanted_list_from_wire(w),
            (xs, ys) -> list_eq(xs, ys, (x, y) -> ws.codec_same_wanted(x, y)),
        ),
        derived(
            "references.use_kind_word/use_kind_of_word",
            use_kind_exemplars(),
            use_kind_labels(),
            use_kind_word,
            use_kind_of_word,
            same_use_kind,
        ),
        derived(
            "settlement_wire.reach_wire/reach_from_wire",
            reach_exemplars(),
            reach_labels(),
            reach_wire,
            reach_from_wire,
            same_text,
        ),
        derived(
            "family.source_file_wire/source_file_of_wire",
            SourceFile.exemplars(),
            SourceFile.exemplar_labels(),
            source_file_wire,
            source_file_of_wire,
            (x, y) -> x.codec_same(y),
        ),
        derived(
            "family.unsettled_wire/unsettled_of_wire",
            Unsettled.exemplars(),
            Unsettled.exemplar_labels(),
            unsettled_wire,
            unsettled_of_wire,
            (x, y) -> x.codec_same(y),
        ),
        derived(
            "family.settlement_enum_wire/settlement_enum_of_wire",
            Settlement.exemplars(),
            Settlement.exemplar_labels(),
            settlement_enum_wire,
            settlement_enum_of_wire,
            (x, y) -> x.codec_same(y),
        ),
        derived(
            "family.lift_result_wire/lift_result_of_wire",
            LiftResult.exemplars(),
            LiftResult.exemplar_labels(),
            lift_result_wire,
            lift_result_of_wire,
            (x, y) -> x.codec_same(y),
        ),
        derived_total(
            "record.packed/unpacked (ComponentNames)",
            component_name_exemplars(),
            component_name_labels(),
            packed,
            unpacked,
            same_string_list,
        ),
        derived(
            "interface.decl_wire/wire_decl",
            ws.codec_decl_exemplars(),
            ws.codec_decl_labels(),
            (d) -> ws.decls.decl_wire(d),
            (w) -> ws.decl_from_ref(w),
            (x, y) -> ws.codec_same_decl(x, y),
        ),
        derived(
            "family.decls_wire/decls_of_wire",
            [ws.codec_decl_exemplars()],
            ["the file's declarations"],
            (ds) -> ws.decls_wire(ds),
            (w) -> ws.decls_of_wire(w),
            (a, b) -> list_eq(a, b, (x, y) -> ws.codec_same_decl(x, y)),
        ),
        derived(
            "family.types_wire/types_of_wire",
            [[], ws.codec_type_exemplars()],
            ["empty", "every exemplar"],
            (ts) -> ws.types_wire(ts),
            (w) -> ws.types_of_wire(w),
            (a, b) -> list_eq(a, b, (x, y) -> ws.codec_same_type_shape(x, y)),
        ),
        derived(
            "family.raised_wire/raised_of_wire",
            ws.codec_raised_exemplars(),
            ["one owner, no errors", "one owner, two errors"],
            (r) -> ws.raised_wire(r),
            (w) -> ws.raised_of_wire(w),
            (x, y) -> ws.codec_same_raised(x, y),
        ),
        derived(
            "codec.loc_wire/loc_of_wire",
            ws.codec_loc_exemplars(),
            ws.codec_loc_labels(),
            (l) -> ws.loc_wire(l),
            (b) -> ws.loc_of_wire(b),
            same_loc,
        ),
        derived(
            "codec.diag_facts_wire/diag_facts_of_wire",
            ws.codec_diag_exemplars(),
            ws.codec_diag_labels(),
            (d) -> ws.diag_facts_wire(d),
            (b) -> ws.diag_facts_of_wire(b),
            same_diag_facts,
        ),
        derived(
            "interface.type_wire/read_type_wire",
            ws.codec_type_exemplars(),
            type_exemplar_labels(),
            (t) -> ws.decls.type_wire(t),
            (w) -> ws.read_type_wire_of_wire(w),
            (x, y) -> ws.codec_same_type_shape(x, y),
        ),
        derived(
            "family.int_wire/int_of_wire",
            int_wire_exemplars(),
            int_wire_labels(),
            int_wire,
            int_of_wire,
            (x, y) -> x == y,
        ),
        derived(
            "family.bool_wire/bool_of_wire",
            bool_wire_exemplars(),
            bool_wire_labels(),
            bool_wire,
            bool_of_wire,
            (x, y) -> x == y,
        ),
        derived(
            "family.text_wire/text_of_wire",
            text_wire_exemplars(),
            text_wire_labels(),
            text_wire,
            text_of_wire,
            (x, y) -> x == y,
        ),
        derived_total(
            "family.presence_wire/presence_of_wire",
            presence_wire_exemplars(),
            presence_wire_labels(),
            presence_wire,
            presence_of_wire,
            same_opt_bool,
        ),
        dbrow_check(),
    ]
}
