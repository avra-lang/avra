//! A rule's own proof: each `@fixes`/`@keeps` example, checked
//! exactly as `avra check` would read it — the before-text analysed,
//! the rule's nearest hit found (`features/rules/apply.av`'s
//! `nearest_fix` — a rule fires at a node, an example names a
//! program), a rewrite's rendered text re-parsed and compared by
//! fingerprint (span-blind; text equality is too strict), a keep
//! answered by absence alone. `avra test` (`suite.av`) runs one of
//! these per example, for every rule the package under test declares.
use core.{root_of}
use features.{Code, Fix}
use features.rules.{nearest_fix}
use compiler.{analyze_source, Analysis}

/// The example's own root: an expression statement stands as its
/// expression (the same reduction a rule's own pattern root takes,
/// `core.root_of` — never the language's OWN tail-if-chain
/// promotion, which would root a both-branches-answering
/// `if`/`else` example at a SYNTHESISED `Expr.If` while the
/// pattern it is tested against stays `Stmt.IfStmt`; avra-8sb5.25.18),
/// every other statement as itself; absent for text that parsed to
/// no statement at all (an @fixes/@keeps whose text does not parse
/// is the honest miss it looks like, never a crash).
fn example_root(a: Analysis) -> Code? {
    let s? = a.view.stmts.first() else { return null }
    a.code_at(root_of(a.view.store, s))
}

/// AN EXAMPLE IS A FRAGMENT: it stands inside a body, never at its
/// own tail, so the language's tail-if-chain law — which canonicalises
/// a BOTH-BRANCHES-ANSWERING trailing `if`/`else` into the `Expr.If`
/// it answers — never reshapes it. A rule fires at a NODE; an
/// example names the node, not a whole standalone program that
/// happens to end where it does. Parsed bare, an example's own
/// `if`/`else` WOULD be that program's only (hence trailing)
/// statement, so it would take the promotion regardless of what the
/// rule's pattern names — a mismatch no rule author writes on
/// purpose. The harmless trailing statement appended here is what
/// makes the text a FRAGMENT rather than a program: the same law
/// that already holds inside every real function body now holds
/// here too (avra-8sb5.25.18).
fn analyzed_example(text: string) -> Analysis {
    analyze_source("${text}\n0\n")
}

/// Whether `rule`, applied to `before`, answers a rewrite whose
/// rendered text — re-parsed — is span-blind equal to `after`.
export fn checks_fixes(applied: fn(Code) -> Fix?, before: string, after: string) -> bool {
    let root? = example_root(analyzed_example(before)) else { return false }
    let hit? = nearest_fix(applied, root) else { return false }
    let text? = hit.rendered() else { return false }
    same_fingerprint(text, after)
}

/// Whether the rule answers nothing anywhere in `before`.
export fn checks_keeps(applied: fn(Code) -> Fix?, before: string) -> bool {
    let root? = example_root(analyzed_example(before)) else { return true }
    nearest_fix(applied, root) == null
}

fn same_fingerprint(rendered: string, after: string) -> bool {
    let r? = example_root(analyzed_example(rendered)) else { return false }
    let a? = example_root(analyzed_example(after)) else { return false }
    r.of.view.store.subtree_fp(r.at) == a.of.view.store.subtree_fp(a.at)
}
