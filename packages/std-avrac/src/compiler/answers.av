//! THE WORKSPACE'S KEPT QUERY ANSWERS — where a `@query` answer asked of the
//! workspace's relation Db outlives the process. The record carries what it
//! stood on (std-relation's `Leaf`s), so nothing here judges validity: the hooks
//! file and fetch bytes under the query's durable name — which already holds its
//! code hash — and its arguments' hash, in the store the workspace attaches.
//! A workspace with no store attached keeps nothing and finds nothing.
use @std.relation.{input}
use @std.relation.db.{Db as RelDb, Durable}
use compiler.store.{Store, Stored, node_key}
use core.digest.{hex, hex_digit, hex_digits}

/// A source file's text as a query reads it. The workspace stages every text a
/// query is asked about (`stage_text`) before asking, so a record names the text
/// by its hash; a query asked an unstaged path is a defect, never an empty text.
@input
export fn file_text(_db: RelDb, _path: string) -> string {
    avra_trap("defect: a source text was read before the workspace staged it")
    ""
}

impl Workspace {
    /// A source's text staged as the relation Db's `file_text` input — what a query that
    /// reads the file is asked of, so its record names the text by its hash.
    fn stage_text(path: string) { set_file_text(self.decls.rows_db.get(), path, self.listed_text(path)) }
}

/// The door a workspace's relation Db keeps its answers through: `slot` is the
/// store the workspace attaches when it opens one.
// LICENSED compiler.free_state_verb: a CONSTRUCTOR — the store's slot in, the hooks out.
export fn answer_hooks(slot: Cell<Store?>) -> Durable {
    Durable {
        answer: (query: string, args: int) -> kept_answer(slot, query, args),
        keep: (query: string, args: int, record: Bytes) -> keep_answer(slot, query, args, record),
    }
}

/// The key an answer is filed under: the query's durable name and its arguments' hash.
fn answer_key(query: string, args: int) -> string { node_key(Stored.Answer, [query, "${args}"]) }

fn kept_answer(slot: Cell<Store?>, query: string, args: int) -> Bytes? {
    let store? = slot.get() else { return null }
    let text? = store.get(Stored.Answer, answer_key(query, args)) else { return null }
    unhex(text)
}

fn keep_answer(slot: Cell<Store?>, query: string, args: int, record: Bytes) {
    let store? = slot.get() else { return }
    let _ = store.keep(Stored.Answer, answer_key(query, args), hex(record), [])
}

/// A whole int as sixteen lowercase hex digits, its high digit first.
export fn hex_word(v: int) -> string { [hex_digit((v >> 60 - 4 * i) & 15) for i in 0..16].join("") }

/// `hex` read back; absent for text that is not whole pairs of digits.
fn unhex(s: string) -> Bytes? {
    if s.length % 2 != 0 { return null }
    let nibbles = [hex_digits.index_of(s.substring(i, i + 1)) for i in 0..s.length]
    if nibbles.any(it < 0) { return null }
    [nibbles[2 * i] * 16 + nibbles[2 * i + 1] for i in 0..s.length / 2].bytes()
}
