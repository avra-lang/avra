//! A QUERY BODY READS THE WORLD ONLY THROUGH ITS DOOR. A query's answer is kept under its question
//! and served to every later process whose recorded reads hold, so a read its record doesn't hold
//! is one the store answers wrong the day it moves. From each `@query`, `@cut_query` and
//! `@parted_query` body this follows every body it calls as its typing resolves the call — a fn by
//! name, a method by its receiver's type, a fn named as a value, and the same in every lambda it
//! writes — and stops at a door: an `@input`, another query's body, judged on its own, a method of a
//! type marked `@records`, and a run marked `@reach_held`. A READ is a call of an extern whose row
//! reaches the world — one whose reach, its registry row's or what its declaration states in
//! `@reach(…)`, is World or Embed, or one nothing describes — or of an engine member marked `@unrecorded`.
//!
//! EVERY CALL THAT ENTERS THE READING PACKAGE IS A SITE, on any way from the query: a call from a
//! body of another package into a body of the package whose own call reads, where that body reaches
//! the read; and the read's own call where the query stands in that package. Each needs
//! `// LICENSED input.unrecorded_read: <why>` on the line above it. At the read's own call the
//! licence says the call reads nothing of the world that varies — what it reads is what the call
//! was handed — so the read is gone for every way; at an entering call it says the query's key
//! covers what lies past it, so nothing past that call is a site of that way.
//!
//! WHAT TYPING CAN'T NAME IS NOT FOLLOWED: a call through a fn value made off the way (a seat, a
//! field, a cell, a call's answer), and a method of a type parameter, reached through its bound.
//! Each is pinned as a miss (features/tests/query_door).
//!
//! A body is read once, from its typing, into its summary (`body_world`), kept in the store; a
//! process walks the summaries once, settling the bodies that reach each other together.
use core.{ExprId, SignedType, StmtId, SyntaxArena, flatten, rt_index}
use compiler.laws.{Found, law}
use diagnostics.{Voice, new_source_file}
use @std.meta.{Reach, derive, identity}
use @std.program.address.{SourceFileAddress}
use @std.program.query_engine.{QueryDefinition, QueryEngine}
use @std.program.saved_derive.{Saved}
use @std.program.saved_query.{ListedQuery, definitions_of, query, query_definition}
use @std.program.source_facts.{source_text}

/// The licence a site's author writes where the read is the query's to make.
const READ_LICENCE: string = "input.unrecorded_read"

/// The annotations that make a fn a query's body.
const QUERY_MARKS: List<string> = ["query", "cut_query", "parted_query"]

/// The annotation that makes a fn a door: its answer is the input the engine records.
const DOOR_MARK: string = "input"

/// The annotation that marks an engine member reading past its records.
const UNRECORDED_MARK: string = "unrecorded"

/// The annotation an extern states its row's reach in.
const REACH_MARK: string = "reach"

/// The annotation that marks a fn running a program its reach law holds before it starts.
const HELD_MARK: string = "reach_held"

/// The annotation that marks the `@input` whose answer is the machine's platform.
const PLATFORM_MARK: string = "platform"

/// The annotation that marks a type whose methods read through the records it keeps.
const RECORDS_MARK: string = "records"

/// The suffix the body a query's annotation wraps is declared under.
const WRAPPED_BODY: string = "\$body"

/// a query body that reads the world past what its record holds
export law query_reads_world {
    kind: "query.reads_world"
    reads_view: queries_reading_world
    voice: reads_world_words
    witness: "use @std.program.saved_query.{query}\nuse @std.io.{env}\n\n@query(\"summary\")\nfn home(_e: int, _of: string) -> string { env(\"HOME\") ?? \"\" }\n"
}

/// A body a call runs, as the walk names it: the file declaring it, the type it's a method of — ""
/// for a fn — and its name.
@derive(Saved)
type DoorBody = { file: SourceFileAddress, owner: string, name: string }

/// A place in a file: the item, the offset, and whether the offset counts from the item's start
/// rather than the file's — as the item's read counts its places.
@derive(Saved)
type ItemPlace = { file: SourceFileAddress, item: ItemId, lo: int, from_item: bool }

/// A read a body makes itself: what it reads, worded, and where the call stands.
@derive(Saved)
type ReadAt = { read: string, at: ItemPlace }

/// A call a body makes of another body: the callee, and where the call stands.
@derive(Saved)
type CallAt = { callee: DoorBody, at: ItemPlace }

/// How a call of a body is met.
@derive(Saved)
enum Met {
    /// A door: an `@input`, a query's body or what its annotation makes, a method of a type that
    /// records what it's asked, a run its reach law holds, an extern whose row reads nothing, or a
    /// body no declaration here gives. Nothing past it is followed.
    Door
    /// A call of it is a read itself: an extern whose row reaches the world, or an engine member
    /// reading past its records.
    Read
    /// A body the walk goes into.
    Walked
    /// A call of it reads what the machine's platform answers: an extern whose row reaches
    /// `Platform`, read through the platform's door where the query's walk meets it.
    PlatformRead
    /// The platform's door: an `@input` marked `@platform`, whose answer keys the query by the
    /// platform. Nothing past it is followed.
    PlatformDoor
}

/// What one body says of the world as its typing reads it: the reads it makes itself, the reads of
/// the platform it makes itself, the calls it makes of bodies the walk goes into, and whether it
/// calls the platform's door.
@derive(Saved)
type BodyWorld = { reads: List<ReadAt>, platform_reads: List<ReadAt>, calls: List<CallAt>, platformed: bool }

/// Each query body `view`'s item holds, one finding a site it reaches unlicensed.
fn queries_reading_world(view: ItemView) -> List<Found> {
    let item = view.item
    flatten(
        [query_findings(view, s, p!.name) for s in item.stmts for p in [item.store.fn_parts(s)] if p != null && is_query(item, s)],
    )
}

/// Whether the fn statement `s` wears a query's annotation.
fn is_query(item: ReadItem, s: StmtId) -> bool { item.store.annotations_of(s).any((a) -> QUERY_MARKS.contains(a.name)) }

/// The query `name`'s unlicensed sites, at its own statement.
fn query_findings(view: ItemView, s: StmtId, name: string) -> List<Found> {
    let walk = reach_walk(view.engine)
    let wrapped = DoorBody { file: view.file, owner: "", name: "${name}${WRAPPED_BODY}" }
    let start = if declared_body(view.engine, wrapped) == null { DoorBody { file: view.file, owner: "", name: name } } else { wrapped }
    let keyed = walk.platformed_of(view.engine, start)
    let sites = walk
        .sites_of(view.engine, start)
        .filter((!it.row || it.package == view.file.package_name) && !(it.platform && keyed))
    let places = [place_key(x.at) for x in sites]
    [Found { at: view.item.store.stmt_span(s), args: [name, x.read, place_said(view.engine, x.at)] } for i, x in sites if places.index_of(place_key(x.at)) == i && !walk.licensed(view.engine, x.at)]
}

/// How a call of the body `c` is met, read from its declaration alone.
@query("laws")
fn body_met(engine: QueryEngine, c: DoorBody) -> Met {
    let d? = declared_body(engine, c) else { return Met.Door }
    let marks = [a.name for a in d.item.store.annotations_of(d.stmt)]
    if marks.contains(UNRECORDED_MARK) { return Met.Read }
    if marks.contains(PLATFORM_MARK) { return Met.PlatformDoor }
    if marks.contains(DOOR_MARK) || marks.contains(HELD_MARK) || records_asked(engine, c) { return Met.Door }
    if query_made(engine, c) { return Met.Door }
    if d.item.store.extern_parts(d.stmt) == null { return Met.Walked }
    met_row(row_reach(c.name, d))
}

/// What the extern `name` reaches: its registry row's reach, else the reach its declaration
/// states, else the world, which a row no one describes may reach.
fn row_reach(name: string, d: BodyDeclared) -> Reach { rt_index().get(name)?.reach ?? declared_reach(d.item.store, d.stmt) ?? Reach.World }

/// The reach the `@reach(…)` on the declaration `s` states; absent where it states none.
fn declared_reach(store: SyntaxArena, s: StmtId) -> Reach? {
    let mark? = store.annotations_of(s).find(it.name == REACH_MARK) else { return null }
    let arg? = mark.args.first() else { return null }
    reach_named(store.prop_parts(arg)?.name ?? store.ident_name(arg) ?? "")
}

/// The reach a variant's word names; absent for a word no variant spells.
fn reach_named(word: string) -> Reach? {
    match word {
        "Pure" -> Reach.Pure,
        "Embed" -> Reach.Embed,
        "Lookup" -> Reach.Lookup,
        "World" -> Reach.World,
        "Writes" -> Reach.Writes,
        "Platform" -> Reach.Platform,
        _ -> null,
    }
}

/// How a call of a row reaching `r` is met: a read of the world, a read of the platform, or a door —
/// a write reads nothing there, and a lookup reads the compiler's own table.
fn met_row(r: Reach) -> Met {
    match r {
        .Embed or .World -> Met.Read,
        .Platform -> Met.PlatformRead,
        .Pure or .Lookup or .Writes -> Met.Door,
    }
}

/// What the body `c` says of the world as its typing reads it.
@query("laws")
fn body_world(engine: QueryEngine, c: DoorBody) -> BodyWorld {
    let d? = declared_body(engine, c) else { return NO_WORLD }
    let parts? = d.item.store.fn_parts(d.stmt) else { return NO_WORLD }
    let typed = typed_body(engine, c, d)
    let store = d.item.store
    let named = [CallAt { callee: n!, at: place_at(d, store, r.at) } for r in typed.reads if r.binder == null for n in [named_callee(engine, d.file, r.home, r.name)] if n != null]
    let methods = [CallAt { callee: m!, at: place_at(d, store, e.index) } for e in store.every_expr(parts.body) for m in [method_callee(store, typed.types, e)] if m != null]
    let calls = named.concat(methods)
    let mets = [body_met(engine, x.callee) for x in calls]
    BodyWorld {
        reads: met_reads(engine, calls, mets, Met.Read),
        platform_reads: met_reads(engine, calls, mets, Met.PlatformRead),
        calls: [x for i, x in calls if mets[i] is .Walked],
        platformed: mets.any(it is .PlatformDoor),
    }
}

/// The reads among `calls` met as `met`, each where its call stands, the licensed ones gone.
fn met_reads(engine: QueryEngine, calls: List<CallAt>, mets: List<Met>, met: Met) -> List<ReadAt> {
    [ReadAt { read: read_words(x.callee), at: x.at } for i, x in calls if mets[i] == met && !licensed_at(engine, x.at)]
}

/// What a body no declaration here gives says of the world: nothing.
const NO_WORLD: BodyWorld = BodyWorld {
    reads: [],
    platform_reads: [],
    calls: [],
    platformed: false,
}

/// The body `c`'s typing.
fn typed_body(engine: QueryEngine, c: DoorBody, d: BodyDeclared) -> TypedBody {
    let at? = d.impl_at else { return typed_fn(engine, c.file, c.name) ?? TypedBody { types: [] } }
    method_body_typed(engine, at, c.name, d.item.store.is_static(d.stmt))
}

/// The fn a name the program declares, read in `file` or the template `home` wrote, names.
fn named_callee(engine: QueryEngine, file: SourceFileAddress, home: string?, name: string) -> DoorBody? {
    let d? = resolved(engine, home_file(engine, home) ?? file, Space.Value, name).named() else { return null }
    if !(d.kind is .Fn) { return null }
    DoorBody { file: d.file, owner: "", name: d.name }
}

/// The method a call at `e` runs, by its receiver's declared type.
fn method_callee(store: SyntaxArena, types: List<SignedType?>, e: ExprId) -> DoorBody? {
    let m? = store.method_parts(e) else { return null }
    let subject = if m.subject.index < types.length { types[m.subject.index] } else { null }
    let ty? = subject else { return null }
    match ty.head {
        .Declared(file, name) -> DoorBody { file: file, owner: name, name: m.name },
        _ -> null,
    }
}

/// The read a call of `c` makes, worded.
fn read_words(c: DoorBody) -> string { if c.owner == "" { "`${c.name}`" } else { "the `${c.owner}`'s `${c.name}`" } }

/// Where the node `index` of `d`'s item stands: the body's own statement, for a node a template
/// copied, whose span is its origin file's; the item's own start, for an item a generator made,
/// whose every span is its template's.
fn place_at(d: BodyDeclared, store: SyntaxArena, index: int) -> ItemPlace {
    if generated_rank(d.at) != null { return ItemPlace { file: d.file, item: d.at, lo: 0, from_item: true } }
    let e = ExprId { index: index }
    let lo = if store.spanned_elsewhere(e) { store.stmt_span(d.stmt)?.lo } else { store.expr_span(e)?.lo }
    ItemPlace { file: d.file, item: d.at, lo: lo ?? 0, from_item: d.item.at != null }
}

/// A body's declaration read back: its file and item, the item's syntax, its statement, and the
/// impl that gives it where it's a method.
type BodyDeclared = { file: SourceFileAddress, at: ItemId, item: ReadItem, stmt: StmtId, impl_at: ImplAt? }

/// The declaration of the body `c`: a fn or an extern its file declares or a generator makes there,
/// or a method of the impl that gives it; absent where none does.
fn declared_body(engine: QueryEngine, c: DoorBody) -> BodyDeclared? {
    if c.owner == "" {
        let d? = file_declares(engine, c.file).names.find(it.name == c.name) ?? generated_declares(
            engine,
            c.file,
        )
            .names
            .find(it.name == c.name) else { return null }
        let item = read_item(engine, d.file, d.item)
        let s? = item.stmts.find((x) -> declares_fn(item.store, x, c.name)) else { return null }
        return BodyDeclared { file: d.file, at: d.item, item: item, stmt: s, impl_at: null }
    }
    let at? = impls_given(engine, c.file, c.owner, c.name, false, c.file.package_name).first() ?? impls_given(
        engine,
        c.file,
        c.owner,
        c.name,
        true,
        c.file.package_name,
    )
        .first() else { return null }
    let item = read_item(engine, at.file, at.item)
    let s? = impl_fns_at(item, at).find((x) -> item.store.fn_parts(x)?.name == c.name) else { return null }
    BodyDeclared { file: at.file, at: at.item, item: item, stmt: s, impl_at: at }
}

/// Whether `s` declares the fn or the extern `name`.
fn declares_fn(store: SyntaxArena, s: StmtId, name: string) -> bool { store.fn_parts(s)?.name == name || store.extern_parts(s)?.name == name }

/// Whether `c` is a method of a type wearing `@records`.
fn records_asked(engine: QueryEngine, c: DoorBody) -> bool {
    if c.owner == "" { return false }
    let d? = file_declares(engine, c.file).names.find(it.name == c.owner) else { return false }
    wears_mark(engine, d, RECORDS_MARK)
}

/// Whether `c` is a query's body, or a fn its annotation makes: declared at an item whose fn wears a
/// query's annotation.
fn query_made(engine: QueryEngine, c: DoorBody) -> bool {
    if c.owner != "" { return false }
    let d? = file_declares(engine, c.file).names.find(it.name == c.name) ?? generated_declares(
        engine,
        c.file,
    )
        .names
        .find(it.name == c.name) else { return false }
    let item = read_item(engine, d.file, d.item)
    item.stmts.any((s) -> is_query(item, s))
}

/// A read a body reaches: what it reads, where the call making it stands, and that call's package.
type ReadBelow = { read: string, at: ItemPlace, package: string, platform: bool }

/// A site: what it reads, where the call stands, the package of the body it enters — of the body
/// that reads, for the read's own call — whether it is the read's own call, and whether what it reads
/// is the platform's.
type Site = { read: string, at: ItemPlace, package: string, row: bool, platform: bool }

/// THE BODIES QUERIES REACH, WALKED ONCE A PROCESS: for each body, what it reaches of the world and
/// the sites on the way to it, read off the bodies' summaries. A body is walked once, the bodies that
/// reach each other settled together (`settle`).
@identity
type ReachWalk = {
    reads: Cell<Map<string, List<ReadBelow>>>,
    sites: Cell<Map<string, List<Site>>>,
    worlds: Cell<Map<string, BodyWorld>>,
    order: Cell<Map<string, int>>,
    low: Cell<Map<string, int>>,
    open: Cell<Map<string, bool>>,
    /// The bodies walked and not settled, the first `top` of them.
    stack: Cell<List<string>>,
    top: Cell<int>,
    callees: Cell<Map<string, DoorBody>>,
    count: Cell<int>,
    granted: Cell<Map<string, bool>>,
    platformed: Cell<Map<string, bool>>,
}

/// Each engine's walk, by its serial.
once fn reach_walks() -> Cell<Map<string, ReachWalk>> { Cell.new({}) }

/// The walk the engine's process keeps.
fn reach_walk(engine: QueryEngine) -> ReachWalk {
    let held? = reach_walks().get().get("${engine.serial}") else {
        let made = ReachWalk {
            reads: Cell.new({}),
            sites: Cell.new({}),
            worlds: Cell.new({}),
            order: Cell.new({}),
            low: Cell.new({}),
            open: Cell.new({}),
            stack: Cell.new([]),
            top: Cell.new(0),
            callees: Cell.new({}),
            count: Cell.new(0),
            granted: Cell.new({}),
            platformed: Cell.new({}),
        }
        reach_walks().put("${engine.serial}", made)
        return made
    }
    held
}

/// A body as the walk tells it from another.
fn callee_key(c: DoorBody) -> string { "${spelled_file(c.file)} ${c.owner} ${c.name}" }

/// A place as the walk tells it from another.
fn place_key(p: ItemPlace) -> string { "${spelled_file(p.file)} ${p.item} ${p.lo}" }

impl ReachWalk {
    /// Every site on a way from the body `c` to a read it reaches.
    fn sites_of(engine: QueryEngine, c: DoorBody) -> List<Site> {
        let key = callee_key(c)
        if !self.order.get().has(key) { self.visit(engine, c) }
        self.sites.get().get(key) ?? []
    }

    /// Whether a way from the body `c` meets the platform's door, so its answer is keyed by the
    /// platform.
    fn platformed_of(engine: QueryEngine, c: DoorBody) -> bool {
        let key = callee_key(c)
        if !self.order.get().has(key) { self.visit(engine, c) }
        self.platformed.get().get(key) ?? false
    }

    /// Walks the body `c`, and every body below it the walk hasn't met.
    fn visit(engine: QueryEngine, c: DoorBody) {
        let key = callee_key(c)
        let n = self.count.get()
        self.count.set(n + 1)
        self.order.put(key, n)
        self.low.put(key, n)
        self.open.put(key, true)
        self.pushed(key)
        self.callees.put(key, c)
        let world = body_world(engine, c)
        self.worlds.put(key, world)
        for x in world.calls {
            let at = callee_key(x.callee)
            if !self.order.get().has(at) {
                self.visit(engine, x.callee)
                self.lowered(key, self.low.get().get(at)!)
            } else if self.open.get().get(at) ?? false {
                self.lowered(key, self.order.get().get(at)!)
            }
        }
        if self.low.get().get(key) == self.order.get().get(key) { self.settle(engine, key) }
    }

    /// `key` on the stack of bodies walked and not settled.
    fn pushed(key: string) {
        let top = self.top.get()
        if top < self.stack.get().length { self.stack.set_at(top, key) } else { self.stack.push(key) }
        self.top.set(top + 1)
    }

    /// The body on top of the stack, taken off it.
    fn popped() -> string {
        let top = self.top.get() - 1
        self.top.set(top)
        self.stack.get()[top]
    }

    /// `key`'s lowest reach, lowered to `to` where that is lower.
    fn lowered(key: string, to: int) { if to < self.low.get().get(key)! { self.low.put(key, to) } }

    /// The bodies that reach each other with `root`, settled together: each holds its own reads and
    /// sites, then those below each body it calls and each call it makes that enters the package of
    /// a read below it, until none holds more.
    fn settle(engine: QueryEngine, root: string) {
        mut members: List<string> = []
        mut at = ""
        while at != root {
            at = self.popped()
            self.open.put(at, false)
            members.push(at)
        }
        for m in members {
            let c = self.callees.get().get(m)!
            let world = self.worlds.get().get(m)!
            let own = [ReadBelow { read: r.read, at: r.at, package: c.file.package_name, platform: false } for r in world.reads]
                .concat(
                    [ReadBelow {
                        read: r.read,
                        at: r.at,
                        package: c.file.package_name,
                        platform: true,
                    } for r in world.platform_reads],
                )
            self.reads.put(m, own)
            self
                .sites
                .put(
                    m,
                    [Site {
                        read: r.read,
                        at: r.at,
                        package: r.package,
                        row: true,
                        platform: r.platform,
                    } for r in own],
                )
            self.platformed.put(m, world.platformed)
        }
        while members.any((m) -> self.grew(engine, m)) {}
    }

    /// Whether the body `m` holds more once it takes what each body it calls holds — each call but a
    /// licensed one, whose licence says the query's key covers what lies past it.
    fn grew(engine: QueryEngine, m: string) -> bool {
        let c = self.callees.get().get(m)!
        let calls = self.worlds.get().get(m)!.calls.filter((x) -> !self.licensed(engine, x.at))
        let had_reads = self.reads.get().get(m) ?? []
        let had_sites = self.sites.get().get(m) ?? []
        let reads = reads_joined(
            had_reads,
            flatten([self.reads.get().get(callee_key(x.callee)) ?? [] for x in calls]),
        )
        let entering = [Site {
            read: r.read,
            at: x.at,
            package: x.callee.file.package_name,
            row: false,
            platform: r.platform,
        } for x in calls if x.callee.file.package_name != c.file.package_name for r in self.reads.get().get(callee_key(x.callee)) ?? [] if r.package == x.callee.file.package_name]
        let sites = sites_joined(
            had_sites,
            entering
                .concat(flatten([self.sites.get().get(callee_key(x.callee)) ?? [] for x in calls])),
        )
        let had_platform = self.platformed.get().get(m) ?? false
        let platformed = had_platform ||
            calls.any((x) -> self.platformed.get().get(callee_key(x.callee)) ?? false)
        self.reads.put(m, reads)
        self.sites.put(m, sites)
        self.platformed.put(m, platformed)
        reads.length != had_reads.length ||
            sites.length != had_sites.length ||
            platformed != had_platform
    }

    /// Whether the call at `p` carries the read's licence, read once.
    fn licensed(engine: QueryEngine, p: ItemPlace) -> bool {
        let key = place_key(p)
        let held? = self.granted.get().get(key) else {
            let found = licensed_at(engine, p)
            self.granted.put(key, found)
            return found
        }
        held
    }
}

/// `had` and each read of `more` it doesn't hold, a read told apart by what it reads and where.
fn reads_joined(had: List<ReadBelow>, more: List<ReadBelow>) -> List<ReadBelow> {
    let keys: Cell<Map<string, bool>> = Cell.new({})
    for r in had { keys.put("${r.read} ${place_key(r.at)}", true) }
    mut out = had
    for r in more {
        let k = "${r.read} ${place_key(r.at)}"
        if !keys.get().has(k) {
            keys.put(k, true)
            out.push(r)
        }
    }
    out
}

/// `had` and each site of `more` it doesn't hold, a site told apart by what it reads and where.
fn sites_joined(had: List<Site>, more: List<Site>) -> List<Site> {
    let keys: Cell<Map<string, bool>> = Cell.new({})
    for s in had { keys.put("${s.read} ${place_key(s.at)}", true) }
    mut out = had
    for s in more {
        let k = "${s.read} ${place_key(s.at)}"
        if !keys.get().has(k) {
            keys.put(k, true)
            out.push(s)
        }
    }
    out
}

/// Whether the line above the call at `p` cites the read's licence.
fn licensed_at(engine: QueryEngine, p: ItemPlace) -> bool {
    let item = read_item(engine, p.file, p.item)
    let text = source_text(engine, p.file) ?? ""
    if !p.from_item {
        let whole = new_source_file(p.file.path_in_package, text)
        return site_licensed(item.store, whole, whole.linecol(p.lo).line, READ_LICENCE)
    }
    let start = item_start(engine, p.file, p.item)
    let end = item_starts(engine, p.file).find(it > start) ?? text.length
    let own = new_source_file(p.file.path_in_package, text.substring(start, end))
    site_licensed(item.store, own, own.linecol(p.lo).line, READ_LICENCE)
}

/// Where the call at `p` stands, as `package/path:line`.
fn place_said(engine: QueryEngine, p: ItemPlace) -> string {
    let text = source_text(engine, p.file) ?? ""
    let lo = if p.from_item { item_start(engine, p.file, p.item) + p.lo } else { p.lo }
    let line = new_source_file(p.file.path_in_package, text).linecol(lo).line
    "${p.file.package_name}/${p.file.path_in_package}:${line}"
}

fn reads_world_words(a: List<string>) -> Voice { query_reads_past_record(a[0], a[1], a[2]) }

collect listed_query_door_facts: List<ListedQuery> = @query_definition in self as ListedQuery { definition: it } by it.name

/// The queries the query-door law is read through, for a process to hand its engine.
export fn query_door_fact_definitions() -> List<QueryDefinition> { definitions_of(listed_query_door_facts) }

// voices

/// A query's answer is kept under its record's reads, and `query` reaches `read` past them through
/// the call at `place`.
fn query_reads_past_record(query: string, read: string, place: string) -> Voice {
    Voice {
        message: "a query's answer is kept under the reads its record holds, and `${query}` reaches ${read} past them, through the call at ${place}",
        label: "reaches ${read}",
        help: "move the read behind an `@input`, or license the call at ${place}: `// LICENSED ${READ_LICENCE}: <what the question's key covers>` on the line above it",
    }
}
