//! The filesystem seam: a record of four questions, and the in-memory
//! host a test hands in. The disk host is the CLI's.
use core.{sorted_texts}
use @std.path.{under_dir, joined_path, normalized, head_segment}

/// The filesystem, as its questions. `stamp` says a file's bytes have not moved
/// without reading them — null when the host cannot tell.
/// What stands at a path BENEATH a root, reached through no link: its
/// text, nothing, a link on the way, octets that are not UTF-8 (at that
/// byte), or the host's own refusal.
export enum Beneath { Text(text: string), Missing, Linked, NotText(at: int), Refused(why: string) }

export type Host = { exists: fn(string) -> bool, peek: fn(string) -> Beneath, refused: fn(string) -> void, beneath: fn(string, string) -> Beneath, write: fn(string, string) -> string?, list: fn(string) -> List<string>, is_dir: fn(string) -> bool, stamp: fn(string) -> int?, reads_ahead: fn(int) -> void, std_root: string? = null, cwd: string = "", compiler: string? = null }

impl Host {
    /// One spelling for one directory: a relative path rooted at the
    /// host's cwd, normalized — the identity two package roots are
    /// compared by, never the strings as typed.
    fn absolute(path: string) -> string {
        normalized(joined_path(self.cwd, path))
    }

    /// A file's text. THE HOST HAS ONE WHOLE-FILE READ, `peek`: this is
    /// that read, and where it gives no text the host's own refusal is
    /// spoken (`refused` — a host that ends runs ends this one) and no
    /// text is answered.
    fn read(path: string) -> string {
        match (self.peek)(path) {
            .Text(text) -> text,
            .Missing or .Linked or .NotText(_) or .Refused(_) -> {
                (self.refused)(path)
                ""
            },
        }
    }

    /// A file as text, through the door: what stands at `path`, links
    /// followed — its text, nothing, or that the host would not give it,
    /// by the KIND of refusal. Never the host's own words, and never the
    /// end of the run.
    fn spared_text(path: string) -> Read {
        match (self.peek)(path) {
            .Text(text) -> Read.Text(path, text),
            .Missing -> Read.Text(path, null),
            .NotText(_) -> withheld(path, "not text"),
            .Linked -> withheld(path, "linked"),
            .Refused(_) -> withheld(path, "refused"),
        }
    }

    /// An embedded file named `key`, read beneath `root` as `rel`, through
    /// no link.
    fn embedded(key: string, root: string, rel: string) -> Read { Read.Embedded(key, (self.beneath)(root, rel)) }

    /// Whether anything stands at `path`, through the door.
    fn there(path: string) -> Read { Read.Exists(path, self.exists(path)) }

    /// A directory's names through the door, sorted, each saying whether
    /// it is a directory itself; nothing where no directory stands.
    fn listing(dir: string) -> Read {
        if !self.is_dir(dir) { return Read.Listing(dir, null) }
        Read
            .Listing(
                dir,
                [Listed { name: name, dir: self.is_dir(joined_path(dir, name)) } for name in sorted_texts(self.list(dir))],
            )
    }

    /// The directory the toolchain's copy of a std package would
    /// stand in, when the host names a std root: `@std/text` is
    /// `<std_root>/std-text`, its library stem.
    fn std_dir(key: string) -> string? {
        let root? = self.std_root else { return null }
        if !key.starts_with("@std/") { return null }
        joined_path(root, library_stem(key))
    }
}

/// A host over an in-memory file table — the tests' host, and a
/// lone file's.
export fn memory_host(files: Map<string, string>, names: List<string>) -> Host {
    memory_host_at(files, names, "")
}

/// A file's text the host would not give, by the kind of its refusal.
fn withheld(path: string, kind: string) -> Read {
    Read.Refused(InputName { kind: .Text, key: path }, kind)
}

/// An in-memory host standing in a directory: a relative path is
/// looked up under `cwd`, as the disk would.
export fn memory_host_at(files: Map<string, string>, names: List<string>, cwd: string) -> Host {
    let held = Cell.new(files)
    Host {
        exists: (p: string) -> held.get().get(normalized(joined_path(cwd, p))) != null,
        refused: unrefusing,
        peek: (p: string) -> memory_beneath(held, normalized(joined_path(cwd, p))),
        beneath: (root: string, rel: string) -> memory_beneath(
            held,
            normalized(joined_path(cwd, joined_path(root, rel))),
        ),
        write: (p: string, text: string) -> memory_put(held, normalized(joined_path(cwd, p)), text),
        list: (dir: string) -> children_of(names, normalized(joined_path(cwd, dir))),
        is_dir: (dir: string) -> names.any(under_dir(it, normalized(joined_path(cwd, dir)))),
        stamp: no_stamp,
        reads_ahead: any_reads,
        cwd: cwd,
    }
}

/// The in-memory table holds text and no link.
fn memory_beneath(held: Cell<Map<string, string>>, at: string) -> Beneath {
    let text? = held.get().get(at) else { return Beneath.Missing }
    Beneath.Text(text)
}

/// A host with no links, over what it can already say of a path: what
/// stands there is its text.
export fn unlinked(exists: fn(string) -> bool, read: fn(string) -> string) -> fn(string, string) -> Beneath {
    (root: string, rel: string) -> if exists(joined_path(root, rel)) { Beneath.Text(read(joined_path(root, rel))) } else { Beneath.Missing }
}

/// A host that says nothing of a file it would not give.
export fn unrefusing(_path: string) {}

/// A host with no refusals, over what it can already say of a path:
/// what stands there is its text.
export fn plainly(exists: fn(string) -> bool, read: fn(string) -> string) -> fn(string) -> Beneath {
    (path: string) -> if exists(path) { Beneath.Text(read(path)) } else { Beneath.Missing }
}

/// A host that reads however many files it is asked to.
fn any_reads(_files: int) {}

/// A host that cannot tell: every text is read.
fn no_stamp(_path: string) -> int? { null }

/// A write through the in-memory table — a named fn because the field's answer is
/// `string?` and a lambda ending in `null` answers `null` alone.
fn memory_put(held: Cell<Map<string, string>>, path: string, text: string) -> string? {
    held.put(path, text)
    null
}

/// The direct children of `dir` among `names` — the base names, in
/// byte order like the disk host's.
fn children_of(names: List<string>, dir: string) -> List<string> {
    mut out: List<string> = []
    for n in names {
        if under_dir(n, dir) {
            let rest = if dir.is_empty() { n } else { n.substring(dir.length + 1, n.length) }
            let child = head_segment(rest)
            if !child.is_empty() && !out.contains(child) { out.push(child) }
        }
    }
    sorted_texts(out)
}
