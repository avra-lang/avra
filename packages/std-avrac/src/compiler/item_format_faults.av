//! WHERE A FORMAT PATTERN CANNOT SCAN: two holes with no literal between them, or one name bound to
//! two spans. Read off the item's patterns by the format reader's own functions, so the pattern is
//! judged as its reader splits it.
use core.{PatId, Span, SyntaxArena}
use compiler.laws.{Found, law}
use diagnostics.{Voice}
use features.formats.{Fault, adjacent_fault, hole_repeated, holes_adjacent, repeated_fault}
use @std.program.address.{SourceFileAddress}
use @std.program.query_engine.{QueryEngine}

/// Every format pattern the written item `at` of `file` writes that cannot scan, its fault.
fn format_faults(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<FaultAt> {
    if !item_held(engine, file, at) { return [] }
    let store = read_item(engine, file, at).store
    if !store.refusals().is_empty() { return [] }
    [f! for i in 0..store.pats.get().length for f in [fault_at(store, PatId { index: i })] if f != null]
}

/// A format pattern's fault, where the pattern stands.
type FaultAt = { at: Span?, fault: Fault }

/// The fault of the pattern `p` where it's a format two holes of share no literal or one name binds
/// twice; absent for any other.
fn fault_at(store: SyntaxArena, p: PatId) -> FaultAt? {
    let parts? = match store.pat(p) { .Format(_, parts) -> parts, rest -> null } else { return null }
    let fault? = adjacent_fault(parts) ?? repeated_fault(parts) else { return null }
    FaultAt { at: store.pat_span(p), fault: fault }
}

/// Every fault of the written item `at` of `file` that `words` names, beside its words.
fn faults_said(
    engine: QueryEngine,
    file: SourceFileAddress,
    at: int,
    words: fn(Fault) -> List<string>,
) -> List<Found> {
    [Found { at: f.at, args: w } for f in format_faults(engine, file, at) for w in [words(f.fault)] if !w.is_empty()]
}

fn adjacent_found(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    faults_said(engine, file, at, adjacent_pair)
}

fn repeated_found(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    faults_said(engine, file, at, repeated_name)
}

/// The two holes an adjacency fault names; none for any other fault.
fn adjacent_pair(f: Fault) -> List<string> {
    match f { .Adjacent(a, b) -> [a, b], rest -> [] }
}

/// The name a repetition fault names; none for any other fault.
fn repeated_name(f: Fault) -> List<string> {
    match f { .Repeated(n) -> [n], rest -> [] }
}

/// a format's holes are separated by a literal
export law format_holes_apart {
    kind: "type.format_shape"
    reads: adjacent_found
    voice: adjacent_words
    witness: "fn f(s: string) -> int {\n    match s { \"{a}{b}\" -> 1\n        _ -> 0 }\n}\n"
}

/// a format binds each name to one span
export law format_names_once {
    kind: "type.format_repeat"
    reads: repeated_found
    voice: repeated_words
    witness: "fn f(s: string) -> int {\n    match s { \"{a}z{a}\" -> 1\n        _ -> 0 }\n}\n"
}

fn adjacent_words(a: List<string>) -> Voice { holes_adjacent(a[0], a[1]) }

fn repeated_words(a: List<string>) -> Voice { hole_repeated(a[0]) }
