//! WHERE A MARK HAS NO READER: a mark written on a declaration's fields or variants that nothing
//! claims. Judged where the old path knows the claims exactly: a declaration wearing no annotation
//! claims only the marks the compiler reads itself; one wearing only `@derive`s claims those and what
//! each derived trait's `marks` answers, run over it. One another annotation stands on, and a
//! `collect enum`, whose members' marks its readers hold, are left alone. Read off the item's syntax.
use features.{arg_lit}
use core.{
    Annotation,
    CollectKind,
    CollectScope,
    ParseRefusal,
    Span,
    StmtId,
    SyntaxArena,
    distinct,
    flatten,
    Known,
    STD_META,
}
use compiler.laws.{Found, law}
use features.annotations.check.{miscounted}
use diagnostics.{Voice}
use @std.program.address.{SourceFileAddress}
use @std.meta.{derive}
use @std.program.query_engine.{QueryDefinition, QueryEngine}
use @std.program.saved_derive.{Saved}
use @std.program.saved_query.{ListedQuery, definitions_of, query, query_definition}

/// Every mark the written item `view` shows writes that no reader claims, with the one that
/// leaves it unread (none for the declaration itself) and the marks read: a field's or a variant's
/// on a declaration wearing no annotation; a mark annotation a declaration of the program's own wears
/// that no collect gathers and nothing else it wears reads; each mark a member a `collect enum`
/// wearing no annotation gathers wears, but the one it gathers by.
fn unread_marks(view: ItemView) -> List<Found> {
    let item = view.item
    let store = item.store
    if !store.refusals().all(lexed_past(it)) { return [] }
    let claimed = compiler_marks()
    let written = [unread_at(m.span, m.name, "", claimed) for s in item.stmts if claims_known(store, s) for m in store.marks_written(s) if !claimed.contains(m.name)]
    let derived = flatten(
        [derived_unread(view.engine, view.file, store, s, claimed) for s in item.stmts if derived_alone(store, s)],
    )
    let own = [unread_at(a.span, a.name, "", claimed) for s in item.stmts if !declared_exported(view.engine, view.file, store, s) for a in marks_alone(view.engine, view.file, store, s) if !claimed.contains(a.name)]
    let gathered = flatten(
        [members_unread(view.engine, view.file, c!.name, c!.kind, c!.scope, claimed) for s in item.stmts for c in [store.collect_enum_parts(s)] if c != null && store.annotations_of(s).is_empty()],
    )
    written.concat(derived).concat(own).concat(gathered)
}

/// The marks written on the declaration `s` makes that neither the compiler nor the traits it
/// derives claim; none where what they claim can't be known.
fn derived_unread(
    engine: QueryEngine,
    file: SourceFileAddress,
    store: SyntaxArena,
    s: StmtId,
    own: List<string>,
) -> List<Found> {
    let written = store.marks_written(s)
    if written.is_empty() { return [] }
    let read? = derive_claims(engine, file, store, s) else { return [] }
    let claimed = distinct(read.words.concat(own))
    [unread_at(m.span, m.name, "", claimed) for m in written if !claimed.contains(m.name) &&
        !(read.rules && names_a_rule(engine, file, m.name)) &&
        !names_a_marker(engine, file, m.name)]
}

/// Whether `word`, read where `file` writes it, names a fn answering `Marker`: a mark the wearer
/// brought in by name, which some reader beside the declaration reads.
fn names_a_marker(engine: QueryEngine, file: SourceFileAddress, word: string) -> bool {
    let d? = named_decl(engine, file, word) else { return false }
    answers_marker(engine, d)
}

/// Whether `word`, read where `file` writes it, names a rule: a fn whose first seat takes a value.
fn names_a_rule(engine: QueryEngine, file: SourceFileAddress, word: string) -> bool { rule_of(engine, named_decl(engine, file, word)) }

/// Whether the reader `t` reads every rule its declarations' members wear: it wears `@reads_rules`.
export fn reads_rules(engine: QueryEngine, t: TraitAt) -> bool {
    let item? = read_trait(engine, t) else { return false }
    let s? = item.stmts.find((x) -> item.store.declared_name(x) == t.name) else { return false }
    item.store.annotations_of(s).any((a) -> binds_fn(engine, t.file, a.name, META_READS_RULES))
}

/// `@std/meta`'s annotation a reader of every rule wears.
const META_READS_RULES: Known = Known { package: "@std/meta", name: "reads_rules" }

/// Whether the statement `s` is its source's own and wears annotations, no `collect enum`: one whose
/// claims its `@derive`s may say.
fn derived_alone(store: SyntaxArena, s: StmtId) -> bool {
    store.stmt_origins.at(s.index) == null &&
        !store.annotations_of(s).is_empty() &&
        store.collect_enum_parts(s) == null
}

/// Whether the refusal `r` is a character no token starts with, which the parse reads past: what it
/// read is the item's as written around it, so its marks are judged.
fn lexed_past(r: ParseRefusal) -> bool { match r { .Grammar(cause, _, _, _, _) -> cause is .Lex, rest -> false } }

/// A mark `name` at `span` no reader claims, `gatherer` the `collect enum` that leaves it unread
/// ("" for none), `claimed` the marks read.
fn unread_at(span: Span?, name: string, gatherer: string, claimed: List<string>) -> Found { Found { at: span, args: [name, gatherer].concat(claimed) } }

/// Whether the statement `s` of `file` declares a name the file exports.
fn declared_exported(engine: QueryEngine, file: SourceFileAddress, store: SyntaxArena, s: StmtId) -> bool {
    let name? = decl_word(store, s) else { return true }
    file_declares_named(engine, file, name).names.any(it.name == name && it.exported)
}

/// The mark annotations the statement `s` of `file` wears where every annotation it wears is one —
/// nothing it wears reads them, and no collect gathers it by them; none where it wears another.
fn marks_alone(engine: QueryEngine, file: SourceFileAddress, store: SyntaxArena, s: StmtId) -> List<
    Annotation,
> {
    let worn = store.annotations_of(s)
    if worn.is_empty() || !worn.all(marks(engine, file, it.name)) { return [] }
    if gathered_by_any(engine, file, [a.name for a in worn]) { return [] }
    if worn.any((a) -> gathered_by_mark(engine, file, a.name)) { return [] }
    worn
}

/// Whether the annotation `name` read from `file` is a mark: a fn answering `@std/meta`'s `Marker`.
fn marks(engine: QueryEngine, file: SourceFileAddress, name: string) -> bool {
    let d? = resolved(engine, file, Space.Value, name).named() else { return false }
    answers_marker(engine, d)
}

/// Whether the declaration `d` is a mark's fn: a fn answering `@std/meta`'s `Marker`.
export fn answers_marker(engine: QueryEngine, d: DeclaredName) -> bool {
    if d.kind != ItemKind.Fn { return false }
    let answer? = declared_signature_of(engine, d)?.answer else { return false }
    Known { package: STD_META.name, name: MARK_ANSWER }.heads(answer.head)
}

/// Every `Marker` fn named `word` one of `traits` reads, once each: what a member's mark of that
/// word binds where its declaration derives or implements them.
export fn trait_markers(engine: QueryEngine, traits: List<TraitAt>, word: string) -> List<
    DeclaredName,
> {
    let found = [d for t in traits for d in trait_reads(engine, t).read if d.name == word]
    [d for j, d in found if found.find_index((x) -> x.file == d.file && x.item == d.item) == j]
}

/// The readers whose `@reads` the members of the declaration `s` of `item` bind their marks among:
/// the traits its annotations derive, the annotation fns it wears, and the traits each `collect
/// enum` gathering it derives — what is written, never what impls are filed for it, which generators
/// may still be making. None for a statement declaring no name.
export fn declaration_traits(
    engine: QueryEngine,
    file: SourceFileAddress,
    item: ReadItem,
    s: StmtId,
) -> List<TraitAt> {
    let name? = decl_word(item.store, s) else { return [] }
    let gathering = [t for d in file_declares_named(engine, file, name).names for g in package_gatherings(engine, file.package_name).each if g.members.any(it.is(d)) for t in g.readers]
    let worn = [TraitAt { file: d!.file, name: d!.name } for a in item.store.annotations_of(s) for d in [written_resolution(engine, file, Space.Value, a.name).named()] if d != null && d!.kind == ItemKind.Fn]
    let members = if item.store.component_parts(s) == null { [] } else { component_members_reader(engine) }
    derived_traits(engine, file, item, s).concat(worn).concat(gathering).concat(members)
}

/// `@std/meta`'s reader of every component's members, as a reader; none where the package is out of reach.
fn component_members_reader(engine: QueryEngine) -> List<TraitAt> {
    [TraitAt { file: d.file, name: d.name } for d in declarations_of(engine, STD_META.name, [], false, COMPONENT_MEMBERS_READER) if d.kind == ItemKind.Trait]
}

/// The name `@std/meta` declares its reader of every component's members under.
const COMPONENT_MEMBERS_READER: string = "ComponentMembers"

/// The `Marker` fns a trait names in its `@reads`.
@derive(Saved)
export type TraitReads = { read: List<DeclaredName> }

/// The fns the trait `t` names in its `@reads` that a member may wear, each resolved where the trait
/// is written.
@query("generate")
export fn trait_reads(engine: QueryEngine, t: TraitAt) -> TraitReads {
    let item? = read_trait(engine, t) ?? declaring_item(engine, t.file, t.name, ItemKind.Fn) else { return TraitReads { read: [] } }
    TraitReads {
        read: [d for r in reads_named(engine, t.file, item, t.name) if member_wearable(engine, r.d) for d in [r.d]],
    }
}

/// A name a trait's `@reads` writes, where it stands, and the declaration it resolves to.
type ReadNamed = { name: string, at: Span?, d: DeclaredName }

/// Each name the `@reads` on the trait `name` of `item`, in `file`, writes that resolves to a
/// declaration, resolved where the trait is written.
fn reads_named(engine: QueryEngine, file: SourceFileAddress, item: ReadItem, name: string) -> List<
    ReadNamed,
> {
    let store = item.store
    let s? = item.stmts.find((x) -> store.declared_name(x) == name) else { return [] }
    [ReadNamed { name: n!, at: store.expr_span(e), d: d! } for a in store.annotations_of(s) if binds_fn(engine, file, a.name, META_READS) for e in a.args for n in [store.ident_name(e)] if n != null for d in [written_resolution(engine, file, Space.Value, n!).named()] if d != null]
}

/// Where the fn `d` may be worn, as its `@worn_on` says, each place by its `Wear` variant; absent where
/// it says nothing, so its first seat says.
export fn declared_wears(engine: QueryEngine, d: DeclaredName) -> List<string>? {
    if d.kind != ItemKind.Fn { return null }
    let item = read_item(engine, d.file, d.item)
    let s? = item.stmts.find((x) -> item.store.fn_parts(x)?.name == d.name) else { return null }
    let worn = [a for a in item.store.annotations_of(s) if binds_fn(engine, d.file, a.name, META_WORN_ON)]
    if worn.is_empty() { return null }
    [wear_of(arg_lit(item.store, x).text) for a in worn for e in a.args for x in item.store.expr(e).elems_of() ?? [e]]
}

/// The `Wear` variant a written place names: `.Field` or `Wear.Field` alike.
fn wear_of(text: string) -> string { text.split(".").last() ?? text }

/// Whether a member may wear the fn `d`: a `Marker`, or one its `@worn_on` lets a field, a variant
/// or a parameter wear.
export fn member_wearable(engine: QueryEngine, d: DeclaredName) -> bool {
    let wears? = declared_wears(engine, d) else { return answers_marker(engine, d) || first_seat_a_member(engine, d) }
    wears.any((w) -> MEMBER_WEARS.contains(w))
}

/// Whether the fn `d`'s first seat takes a member: `@std/meta`'s `Field`, `Variant` or `Param`.
fn first_seat_a_member(engine: QueryEngine, d: DeclaredName) -> bool {
    let ty? = fn_signature(engine, d.file, d.name)?.params?.first()?.ty else { return false }
    MEMBER_SEATS.any(it.heads(ty.head))
}

/// The `@std/meta` declarations a member is crossed as.
const MEMBER_SEATS: List<Known> = [
    Known { package: "@std/meta", name: "Field" },
    Known { package: "@std/meta", name: "Variant" },
    Known { package: "@std/meta", name: "Param" },
]

/// The places a member is: a `Wear` variant each.
const MEMBER_WEARS: List<string> = ["Field", "Variant", "Param"]

/// `@std/meta`'s annotation a fn says where it may be worn by.
const META_WORN_ON: Known = Known { package: "@std/meta", name: "worn_on" }

/// a trait reads fns a member may wear
export law reads_wearable {
    kind: "annotation.reads_marker"
    reads_view: reads_unwearable
    voice: reads_unwearable_words
    witness: "use @std.meta.{Type, Directive, reads}\n\nfn plain() -> int { 1 }\n\n@reads(plain)\ntrait T {\n    static fn derive(t: Type) -> List<Directive> { [] }\n}\n0\n"
}

/// Every name the `@reads` on a trait of `view`'s item writes whose fn no member may wear.
fn reads_unwearable(view: ItemView) -> List<Found> {
    let item = view.item
    [Found { at: r.at, args: [r.name] } for s in item.stmts if item.store.trait_parts(s) != null for n in [item.store.declared_name(s)] if n != null for r in reads_named(view.engine, view.file, item, n!) if !member_wearable(view.engine, r.d)]
}

fn reads_unwearable_words(a: List<string>) -> Voice { reads_unwearable_said(a[0]) }

/// a member's mark fills its fn's seats
export law mark_fills_seats {
    kind: "annotation.seats"
    reads_view: marks_misfilled
    voice: marks_misfilled_words
    witness: "use kit.{A}\n\n@A\ntype R = { @named n: int }\n0\n"
    witness_files: {
        "src/kit/kit.av": "use @std.meta.{Named, Marker, Type, Directive, reads}\n\nexport fn named(_d: Named, word: string) -> Marker { Marker {} }\n\n@reads(named)\nexport trait A {\n    static fn derive(t: Type) -> List<Directive> { [] }\n}\n",
    }
}

/// Every member's mark of `view`'s item that binds one fn and writes a count of arguments its seats
/// past the first don't take: handed the word, the least and most it takes, and the count written.
fn marks_misfilled(view: ItemView) -> List<Found> {
    let item = view.item
    flatten([misfilled(view, s) for s in item.stmts if !item.store.marks_written(s).is_empty()])
}

/// The marks the declaration `s` writes whose arguments don't fill the seats of the fn they bind.
fn misfilled(view: ItemView, s: StmtId) -> List<Found> {
    let traits = declaration_traits(view.engine, view.file, view.item, s)
    if traits.is_empty() { return [] }
    [Found {
        at: m.span,
        args: [m.name, "${t.least}", if t.rest { "" } else { "${t.most}" }, "${m.args.length}"],
    } for m in view.item.store.marks_written(s) for bound in [trait_markers(view.engine, traits, m.name)] if bound.length == 1 for t in [mark_seats(view.engine, bound[0])] if m.args.length < t.least || !t.rest && m.args.length > t.most]
}

/// How many arguments a fn takes past its first seat: at least, at most, and whether a seat takes the
/// rest.
type SeatsTaken = { least: int, most: int, rest: bool }

fn mark_seats(engine: QueryEngine, d: DeclaredName) -> SeatsTaken {
    let params = (fn_signature(engine, d.file, d.name)?.params ?? []).drop(1)
    SeatsTaken {
        least: [p for p in params if !p.defaulted && !p.rest].length,
        most: params.length,
        rest: params.any(it.rest),
    }
}

fn marks_misfilled_words(a: List<string>) -> Voice { miscounted(a[0], a[1], if a[2].is_empty() { "…" } else { a[2] }, a[3]) }

/// `@std/meta`'s annotation a trait names the marks it reads by.
const META_READS: Known = Known { package: "@std/meta", name: "reads" }

/// The name the statement `s` declares, a fn's or a type's; absent for any other statement.
fn decl_word(store: SyntaxArena, s: StmtId) -> string? { store.fn_parts(s)?.name ?? store.type_decl_name(s) }

/// The type a mark annotation answers.
const MARK_ANSWER: string = "Marker"

/// Whether a gathering a file of `file`'s package writes gathers by one of the annotations `words`.
fn gathered_by_any(engine: QueryEngine, file: SourceFileAddress, words: List<string>) -> bool {
    item_ids(engine, file)
        .any(
            (k) -> read_item(engine, file, k)
                .stmts
                .any((s) -> gathers_by_word(read_item(engine, file, k).store, s, words)),
        )
}

/// Whether a gathering gathers by the mark `name` as `file` reads it: one written in any source of
/// `file`'s package, or of the package that declares the mark, whose annotation names that same
/// declaration. A `collect … in closure` a dependency writes claims the marks a program's own
/// declarations wear.
fn gathered_by_mark(engine: QueryEngine, file: SourceFileAddress, name: string) -> bool {
    let mark? = resolved(engine, file, Space.Value, name).named() else { return false }
    let key = mark_key(mark.file, mark.name)
    distinct([file.package_name, mark.file.package_name])
        .any((p) -> package_gathered_marks(engine, p).marks.contains(key))
}

/// The marks the gatherings of `package`'s sources gather by, each as `mark_key` names its
/// declaration: asked once a package, whatever reads it.
@query("summary")
fn package_gathered_marks(engine: QueryEngine, package: string) -> GatheredMarks {
    GatheredMarks {
        marks: distinct(
            [k for path in package_source_paths(engine, package).paths for k in file_gathered_marks(engine, source_at(package, path))],
        ),
    }
}

/// The marks one package's gatherings gather by.
@derive(Saved)
type GatheredMarks = { marks: List<string> }

/// The marks the gatherings the source `f` writes gather by, each as `mark_key` names the declaration
/// its annotation resolves to where it is written.
fn file_gathered_marks(engine: QueryEngine, f: SourceFileAddress) -> List<string> {
    [k! for at in item_ids(engine, f) for item in [read_item(engine, f, at)] for s in item.stmts for k in [gathering_mark(engine, f, item.store, s)] if k != null]
}

/// The mark the statement `s` of `f` gathers by, as `mark_key` names it; absent for any other.
fn gathering_mark(engine: QueryEngine, f: SourceFileAddress, store: SyntaxArena, s: StmtId) -> string? {
    let kind? = store.collect_enum_parts(s)?.kind ?? store.collect_parts(s)?.kind else { return null }
    let word? = match kind { .Annotated(w) -> w, rest -> null } else { return null }
    let d? = resolved(engine, f, Space.Value, word).named() else { return null }
    mark_key(d.file, d.name)
}

/// A mark declaration's key: its file and its name.
fn mark_key(file: SourceFileAddress, name: string) -> string { "${spelled_file(file)}#${name}" }

/// Whether the statement `s` is a gathering by one of the annotations `words`.
fn gathers_by_word(store: SyntaxArena, s: StmtId, words: List<string>) -> bool {
    let kind? = store.collect_enum_parts(s)?.kind ?? store.collect_parts(s)?.kind else { return false }
    match kind { .Annotated(w) -> words.contains(w), rest -> false }
}

/// Each mark a member the `collect enum` `name` of `file`, gathering by `kind` over `scope`, gathers
/// wears that `claimed` doesn't hold, but the annotation it gathers by: the member's own mark
/// annotations and its fields' and variants' marks, each in `file`.
fn members_unread(
    engine: QueryEngine,
    file: SourceFileAddress,
    name: string,
    kind: CollectKind,
    scope: CollectScope,
    claimed: List<string>,
) -> List<Found> {
    let by = match kind { .Annotated(w) -> w, rest -> "" }
    let members = gathered(engine, file, kind, scope, [], false, "").members()
    flatten([member_unread(engine, d, name, by, claimed) for d in members if d.file == file])
}

/// The marks the gathered member `d` wears that `claimed` doesn't hold, but `by`, left unread by
/// `gatherer`.
fn member_unread(
    engine: QueryEngine,
    d: DeclaredName,
    gatherer: string,
    by: string,
    claimed: List<string>,
) -> List<Found> {
    let item = read_item(engine, d.file, d.item)
    let s? = item.stmts.find((x) -> decl_word(item.store, x) == d.name) else { return [] }
    let own = [unread_at(a.span, a.name, gatherer, claimed) for a in item.store.annotations_of(s) if a.name != by && !claimed.contains(a.name) && marks(engine, d.file, a.name)]
    own
        .concat(
            [unread_at(m.span, m.name, gatherer, claimed) for m in item.store.marks_written(s) if !claimed.contains(m.name)],
        )
}

/// Whether the statement `s`'s claims are known exactly: its source's own, wearing no annotation,
/// and no `collect enum`.
fn claims_known(store: SyntaxArena, s: StmtId) -> bool {
    store.stmt_origins.at(s.index) == null &&
        store.annotations_of(s).is_empty() &&
        store.collect_enum_parts(s) == null
}

/// every mark is read by something that claims it
export law mark_has_a_reader {
    kind: "annotation.unread_mark"
    reads_view: unread_marks
    voice: unread_words
    witness: "enum E {\n    @nobody A\n}\n"
}

/// a member's mark binds one marker
export law mark_bound_once {
    kind: "annotation.mark_twice"
    reads_view: twice_bound_marks
    voice: twice_bound_words
    witness: "use kit.{A}\nuse other.{B}\n\n@A\n@B\ntype R = { @flag n: int }\n0\n"
    witness_files: {
        "src/kit/kit.av": "use @std.meta.{Named, Marker, Type, Directive, reads}\n\nexport fn flag(_d: Named) -> Marker { Marker {} }\n\n@reads(flag)\nexport trait A {\n    static fn derive(t: Type) -> List<Directive> { [] }\n}\n",
        "src/other/other.av": "use @std.meta.{Named, Marker, Type, Directive, reads}\n\nexport fn flag(_d: Named) -> Marker { Marker {} }\n\n@reads(flag)\nexport trait B {\n    static fn derive(t: Type) -> List<Directive> { [] }\n}\n",
    }
}

/// Every mark the written item `view` shows on a member whose word binds two different `Marker` fns
/// among those its declaration's traits read: handed the word, then each fn's module.
fn twice_bound_marks(view: ItemView) -> List<Found> {
    let item = view.item
    if !item.store.refusals().all(lexed_past(it)) { return [] }
    flatten([twice_bound(view, s) for s in item.stmts if !item.store.marks_written(s).is_empty()])
}

/// The marks the declaration `s` of `view`'s item writes whose word binds two markers.
fn twice_bound(view: ItemView, s: StmtId) -> List<Found> {
    let traits = declaration_traits(view.engine, view.file, view.item, s)
    if traits.is_empty() { return [] }
    [Found { at: m.span, args: [m.name].concat([module_written("", b.file) for b in bound]) } for m in view.item.store.marks_written(s) for bound in [trait_markers(view.engine, traits, m.name)] if bound.length > 1]
}

fn twice_bound_words(a: List<string>) -> Voice { mark_bound_twice(a[0], a.drop(1)) }

fn unread_words(a: List<string>) -> Voice { unread_mark_said(a[0], a.drop(2), if a[1].is_empty() { null } else { a[1] }) }

collect listed_mark_facts: List<ListedQuery> = @query_definition in self as ListedQuery { definition: it } by it.name

/// The queries the mark laws read through, for a process to hand its engine.
export fn mark_fact_definitions() -> List<QueryDefinition> { definitions_of(listed_mark_facts) }
