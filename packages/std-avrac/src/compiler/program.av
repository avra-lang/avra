/// One parsed source: the tree (holes included), the SourceFile it
/// came from, and every diagnostic from lexing and parsing, in
/// source order. THE value every later pass takes first.
export type Parsed = {
    store: SyntaxArena,
    stmts: List<StmtId>,
    source: SourceFile,
    voices: Voices,
}

/// `explain_doc`'s answer: the rendered text, and the files it read to
/// say so — a durable cache of it needs both (compiler/db.av).
export type DocAnswer = { text: string, files: List<string> }

/// One exported declaration's own facts, as `avra docs dump` rows
/// them: its qualified address, its kind's word (features/decls.av's
/// `kind_word`), a best-effort signature, its `///` lines, and the
/// package it came from.
export type DocRow = { address: string, kind: string, signature: string, prose_lines: List<string>, package: string }

export fn new_dispatch() -> Dispatch {
    let enumpats: dyn PatSemantics = EnumPatSemantics {}
    let formatpats: dyn PatSemantics = FormatPatSemantics {}
    let narrowpats: dyn PatSemantics = NarrowPatSemantics {}
    let quotepats: dyn PatSemantics = QuotePatSemantics {}
    Dispatch {
        spine: SpineSemantics {},
        strs: StrSemantics {},
        bools: BoolSemantics {},
        ifs: IfSemantics {},
        whens: WhenSemantics {},
        blocks: BlockSemantics {},
        calls: FnsSemantics {},
        aggs: ListSemantics {},
        structs: StructsSemantics {},
        enums: EnumsSemantics {},
        nullables: NullableSemantics {},
        catches: CatchSemantics {},
        quotes: QuoteSemantics {},
        sublangs: SublangSemantics {},
        components: ComponentSemantics {},
        componentdecls: ComponentDeclSemantics {},
        syntaxes: SyntaxSemantics {},
        lets: LetStmtSemantics {},
        exprs: ExprStmtSemantics {},
        decls: FnStmtSemantics {},
        holes: HoleSemantics {},
        mutlets: MutLetSemantics {},
        consts: ConstSemantics {},
        assigns: AssignSemantics {},
        whiles: WhileSemantics {},
        fors: ForSemantics {},
        structdecls: StructDeclSemantics {},
        namedtypes: NamedTypeSemantics {},
        enumdecls: EnumDeclSemantics {},
        ifstmts: IfStmtSemantics {},
        returns: ReturnSemantics {},
        letelses: LetElseSemantics {},
        fails: FailSemantics {},
        foreaches: ForEachSemantics {},
        implds: ImplSemantics {},
        methods: MethodSemantics {},
        lambdas: ClosureSemantics {},
        tasks: TasksSemantics {},
        ranges: RangesSemantics {},
        maps: MapsSemantics {},
        uses: UseSemantics {},
        specs: SpecSemantics {},
        defers: DeferSemantics {},
        collects: CollectStmtSemantics {},
        collectenums: CollectEnumStmtSemantics {},
        jumps: JumpSemantics {},
        enumpats: enumpats,
        formatpats: formatpats,
        narrowpats: narrowpats,
        quotepats: quotepats,
    }
}

/// Parse a source into a FRESH store — the whole-file entry — under
/// the block words the file imports (`BlockWords {}` for a file that
/// imports none). No default: an omitted `words` parses a NARROWER
/// language than the file was written in, silently — the caller
/// states which words it parses under, even when that answer is
/// none.
///
/// THE UNTOLD RUN FIRST: a file that parses clean is parsed once, with no miss
/// keeping its story. Anything spoken is spoken again by the telling run, over a
/// store of its own — the builders wrote into the first.
export fn parse_program(lang: Language, src: SourceFile, words: BlockWords) -> Parsed {
    if traced() { qtrace("Q\tparse\t${src.file}\n") }
    let quiet = parsed_fresh(lang, src, words, false)
    if quiet.voices.list.is_empty() { quiet } else { parsed_fresh(lang, src, words, true) }
}

fn parsed_fresh(lang: Language, src: SourceFile, words: BlockWords, telling: bool) -> Parsed {
    let store = new_node_store(src.file)
    parsed_as(lang, store, src, words, telling)
}

/// Parse into a store ALREADY standing — the target file's, when a
/// generated declaration's source is admitted beside the one that
/// asked for it. The returned statements are the newly minted ones.
export fn parse_into(lang: Language, store: SyntaxArena, src: SourceFile, words: BlockWords) -> Parsed {
    parsed_as(lang, store, src, words, true)
}

fn parsed_as(lang: Language, store: SyntaxArena, src: SourceFile, words: BlockWords, telling: bool) -> Parsed {
    if lang.syntax == null {
        return Parsed {
            store: store,
            stmts: [],
            source: src,
            voices: Voices { list: lang.diagnostics },
        }
    }
    let lexed = lex_blocks(
        src.text,
        [g.word for g in words.grammars],
        [c.word for c in words.components if !c.own],
        [c.word for c in words.components if c.own],
        lang.keywords,
    )
    let build = (name: string, args: List<Captured<Token, LangNode>>, loc: Loc?) -> build_named(
        lang.builders,
        store,
        name,
        args,
        loc_span(loc),
        src.text,
        words,
    )
    let o = if telling { run_grammar<Token, LangNode>(lang.syntax!, lexed.tokens, avra_lexeme(), build) } else { run_untold<Token, LangNode>(lang.syntax!, lexed.tokens, avra_lexeme(), build) }
    // a remark means nothing to any pass; it rides the store so the
    // printer can put it back where it was written. Set before
    // attach_docs: an orphaned doc group extends this list, and
    // needs it already standing to merge into.
    store.keep_remarks(lexed.remarks)
    attach_docs(store, lexed.docs)
    if !lexed.file_doc.is_empty() { store.document_file(lexed.file_doc) }
    // what a block's grammar refused speaks with the parse, at the block
    let blocked = [block_diagnostic(v) for v in store.block_voices.get()]
    let engine = [lex_diagnostic(e.message, span_loc(e.span)) for e in lexed.errors]
        .concat(o.diagnostics)
        .concat(blocked)
    Parsed {
        store: store,
        stmts: [store.declared_instance(s) for s in program_stmts(store, o)].concat(store.hoisted_decls()),
        source: src,
        voices: Voices { list: project_all(engine, src.file, lang.rows.codes) },
    }
}

/// A block grammar's refusal as the engine's diagnostic it was.
fn block_diagnostic(v: BlockVoice) -> Diagnostic {
    Diagnostic {
        cause: Cause.Block,
        message: v.message,
        loc: Loc { file: null, lo: v.lo, hi: v.hi },
        expected: v.expected,
        in_rule: v.in_rule,
    }
}

/// The engine's own Loc, worn as this store's Span.
fn loc_span(l: Loc?) -> Span? {
    if l == null { return null }
    span_of(l!.lo, l!.hi)
}

/// A byte range in this file, worn as the engine's own Loc.
fn span_loc(s: Span) -> Loc {
    Loc { file: null, lo: s.lo, hi: s.hi }
}

/// A type SPELLING (`List<ExprId>?`) as the written type it spells —
/// the meta contract carries types as their spellings, and a type
/// hole filled from one reads it with the language's own rule. Null
/// when the spelling is not a type.
export fn parse_type_ref(lang: Language, text: string) -> TypeRef? {
    if lang.syntax == null { return null }
    let store = new_node_store()
    let lexed = lex_source(text)
    if !lexed.errors.is_empty() { return null }
    let build = (name: string, args: List<Captured<Token, LangNode>>, loc: Loc?) -> build_named(
        lang.builders,
        store,
        name,
        args,
        loc_span(loc),
        text,
        BlockWords {},
    )
    let o = run_from<Token, LangNode>(
        lang.syntax!,
        "type",
        [t for t in lexed.tokens if t.kind != TokenKind.Break],
        avra_lexeme(),
        build,
    )
    if o.result == null || !o.diagnostics.is_empty() { return null }
    type_ref_at([o.result!], 0)
}

impl Decls {
    /// A declared STRUCT's own TypeId, by name — null when no declared
    /// struct wears it (a fn, an enum and a named alias all answer null
    /// here too; each has its own signature shape, not a struct's).
    fn struct_type_ref(name: string) -> TypeId? {
        let decl? = self.named_rows(name).first() else { return null }
        let _sig? = self.sig(decl.id)?.record_sig() else { return null }
        self.record_type(decl.id)
    }
}

/// Attach each source-ordered doc group to the declaration its
/// prefix run opens — the nearest statement beginning after the
/// group's anchor, but only where nothing besides that run (an
/// `export`/marker keyword, or the annotations that wrap the
/// statement) stands in between. This includes nested methods;
/// annotations and `export` precede the declaration node's own
/// span, so token equality is deliberately not required there. A
/// group whose claim fails — its anchor was a MARK's `@word`, not
/// an ANNOTATION's, and nothing else stands between it and the
/// next real statement to redeem it — is not forced onto whatever
/// statement happens to follow; it survives as a remark instead.
fn attach_docs(store: SyntaxArena, docs: List<DocComment>) {
    let starts = store.stmt_starts()
    for doc in docs {
        let target = doc_target(store, starts, doc)
        if target == null {
            store.orphan_doc(doc.lines, doc.line_ats)
        } else {
            store.document(target!, doc.lines, doc.at)
        }
    }
}

/// The statement `doc` opens, or null when its anchor cannot be
/// claimed. A keyword anchor (`fn`, `export`, …) always opens a
/// real declaration, however far `export` or an annotation run sits
/// ahead of the statement's own span — those are the only things a
/// keyword can precede. A `@word` anchor is ambiguous at the lexer,
/// so it claims a statement only when the parse recorded an
/// ANNOTATION starting at that exact offset; a MARK never does.
fn doc_target(store: SyntaxArena, starts: List<StmtStart>, doc: DocComment) -> StmtId? {
    let target? = statement_after(starts, doc.before) else { return null }
    if !doc.pkg { return target }
    if store.annotations_of(target).any(it.span != null && it.span!.lo == doc.before) { target } else { null }
}

/// The program's statements in order. A recovery hole becomes an
/// explicit Stmt.Error node — the tree survives bad input visibly.
fn program_stmts(store: SyntaxArena, o: RunOutcome<Token, LangNode>) -> List<StmtId> {
    mut out: List<StmtId> = []
    if o.result == null { return out }
    let items = list_at([o.result!], 0)
    for j in 0..items.length {
        let sid: StmtId? = stmt_id_at(items, j)
        if sid == null {
            out.push(store.alloc_stmt(Stmt.Error))
        } else {
            out.push(sid!)
        }
    }
    store.answered(out)
}

impl Program {
    /// The entry file's analysis — absent for a program only checked.
    fn entry_file() -> Analysis? {
        if self.entry == null { return null }
        self.files[self.entry!.at]
    }

    /// An annotation fn's signature, which IS its effect — `avra
    /// explain @name`. Null when no declared fn wears the name. Asks
    /// `file_doc_of` explicitly for an undocumented fn: this names ONE
    /// declaration, the `avra docs <name>` shape `doc_of`'s fallback
    /// once carried — `explain_doc` shares the same door.
    fn explain_annotation(name: string) -> string? {
        let decls = self.ws.decls
        let decl? = decls.named_rows(name).find((d: Decl) -> decls.fn_name(d.id) != null) else {
            return null
        }
        let sig? = decls.sig(decl.id)?.fn_sig() else { return null }
        let holes = [decls.types.name_of(pt) for pt in sig.params]
        let signature = "fn ${name}(${holes.join(", ")}) -> ${decls.types.name_of(sig.ret)}"
        let doc = decls.doc_of(decl.id) ?? decls.file_doc_of(decl.file)
        if doc == null { signature } else { "${signature}\n\n${doc!.join("\n")}" }
    }

    /// A declaration's `///` doc — or, absent one, its FILE's `//!`
    /// header, asked for explicitly (`doc_of`'s door carries no such
    /// fallback of its own) — and its own `@name(args)` annotations.
    /// `avra docs <name>`'s general form. Null for a name no declared
    /// fn, type, enum, trait or const of this package wears. A name
    /// TWO modules both declare — legal, since each namespaces on its
    /// own — is named as a collision rather than silently answered
    /// from whichever one the compiler happened to reach first.
    ///
    /// The FILES an answer read ride along too — never the answer's own
    /// business, but exactly what a durable cache of this answer needs
    /// to know is still true (compiler/db.av's `DocFacts`).
    fn explain_doc(name: string) -> DocAnswer? {
        let decls = self.ws.decls
        let db = decls.rows_db.get()
        let matches = [keyed_decl(db, k)! for k in named_decls(db, name)]
        if matches.length > 1 { return self.collision_answer(decls, name, matches) }
        let decl? = matches.first() else { return null }
        let fact = DocFact.get_db(db, decls.doc_facts, decls.doc_facts_side, decl.id.index)
        let doc = fact?.doc ?? decls.file_doc_of(decl.file) ?? []
        let anns = ["@${a.name}(${[x.text for x in a.args].join(", ")})" for a in fact?.annotations ?? []]
        let lines = doc.concat(anns)
        let text = if lines.is_empty() { "${name} — no doc, no annotations" } else { lines.join("\n") }
        DocAnswer { text: text, files: [decls.file(decl.file).path] }
    }

    /// `name` names more than one declaration — never guessed at. Every
    /// matching declaration's own file backs the answer: a new module
    /// declaring the same name changes it just as much as an edit to
    /// one already listed.
    fn collision_answer(decls: Decls, name: string, matches: List<Decl>) -> DocAnswer {
        let qualified = [decls.module_of(d.id) + "." + name for d in matches].join(", ")
        DocAnswer {
            text: "`${name}` names more than one declaration in this package — qualify it: ${qualified}",
            files: [decls.file(d.file).path for d in matches],
        }
    }

    /// Every EXPORTED declaration this package's own — `avra docs
    /// dump`. A qualified address (`module.name`, `collision_answer`'s
    /// spelling) so two modules exporting the same bare name never
    /// collide in one array the way a single-name lookup would refuse.
    /// `Builtin` is excluded: the LANGUAGE declares it, not this
    /// package — every package would otherwise repeat the same rows
    /// for `int`/`List`/`Task`/…. Each row's `prose_lines` is its OWN
    /// `///` alone (`doc_of` carries no file fallback): dump lists
    /// every exported symbol in a package at once, so an undocumented
    /// one inheriting whatever `//!` its file happens to open with is
    /// the same borrowed-paragraph hazard the rule listing had.
    fn dumped_decls(package: string) -> List<DocRow> {
        let decls = self.ws.decls
        let db = decls.rows_db.get()
        [self.dump_row(decls, keyed_decl(db, k)!, package) for k in exported_decls(db)]
    }

    fn dump_row(decls: Decls, d: Decl, package: string) -> DocRow {
        let db = decls.rows_db.get()
        let fact = DocFact.get_db(db, decls.doc_facts, decls.doc_facts_side, d.id.index)
        DocRow {
            address: "${decls.module_of(d.id)}.${d.name}",
            kind: kind_word(d.kind),
            signature: self.dump_signature(decls, d),
            prose_lines: fact?.doc ?? [],
            package: package,
        }
    }

    /// A FN's signature, `explain_annotation`'s own spelling reused;
    /// every other kind has no params/ret to print, so its word and
    /// name stand in rather than a fabricated shape.
    fn dump_signature(decls: Decls, d: Decl) -> string {
        let sig? = decls.sig(d.id)?.fn_sig() else { return "${kind_word(d.kind)} ${d.name}" }
        let holes = [decls.types.name_of(pt) for pt in sig.params]
        "fn ${d.name}(${holes.join(", ")}) -> ${decls.types.name_of(sig.ret)}"
    }

    /// A TYPE EXPRESSION's runtime REPRESENTATION, in `repr_word`'s
    /// words (features/values.av) — `avra repr <type>` (P7: a
    /// representation the compiler chose is inspectable wherever a
    /// tool exists to ask). Resolves a built-in scalar, `List<…>` or
    /// `Map<…>` from the registry alone, or a declared STRUCT by
    /// name; null for text the type grammar refuses, or a name this
    /// door does not resolve (an enum or a named alias needs a wider
    /// door than `int?`/`string?`/a flat record's `Id?` have needed
    /// yet).
    fn explain_repr(type_text: string) -> string? {
        let ann? = parse_type_ref(avra(), type_text) else { return null }
        let decls = self.ws.decls
        let base? = spelled_type(decls.types, ann with { optional: false }) ?? decls
            .struct_type_ref(ann.name) else {
            return null
        }
        let ty = if ann.optional { decls.types.type(base?) } else { base }
        repr_word(decls.types, ty)
    }

    /// A fn's seat-0 WRITE-FLOW CHAIN — a method's receiver, a free
    /// fn's first parameter — from `write_chain` (compiler/
    /// receivers.av). `avra writes <fn>`. Null when no
    /// declared fn wears the name, its seat 0 is not written, or it
    /// has no seat 0 at all (a fn with no receiver and no parameters).
    /// A `mut` parameter PAST seat 0 is the pass's data too, not yet
    /// this door's — F2047, this door's motivation, is a receiver
    /// diagnostic. THE LOOKUP IS BY BARE NAME, the same door
    /// `explain_annotation` already opens this way: two types
    /// declaring a same-named method answer for whichever one
    /// the name's bucket holds first — a name, not a binding, the same
    /// sharp edge `explain @name` already carries.
    fn explain_writes(fn_name: string) -> string? {
        let decls = self.ws.decls
        let decl? = decls.named_rows(fn_name).find((d: Decl) -> decls.fn_name(d.id) != null) else {
            return null
        }
        if decls.seat_count(decl.id) == 0 { return null }
        let chain? = self.ws.write_chain(decl.id, 0, []) else { return null }
        chain.join(" -> ")
    }

    /// A file's generated declarations, each in canonical source
    /// with its origin — the compact listing API retained for tools
    /// that want only generated declarations.
    fn generated_lines(f: FileId) -> List<string> {
        [self.decl_line(d) for d in self.ws.expanded(f)]
    }

    /// A file as compiled: written nodes in source order, each
    /// component instance's expansion noted under its statement, and
    /// every generated declaration immediately after the declaration
    /// its annotation wrapped.
    fn expanded_source(f: FileId) -> string {
        let made = self.ws.expanded(f)
        let parsed = self.ws.parsed(f)
        mut chunks: List<string> = []
        mut attached: List<DeclId> = []
        for s in parsed.stmts {
            chunks.push(render_statement(parsed.store, s))
            chunks = chunks
                .concat([self.expansion_note(parsed.store, e) for e in parsed.store.instances_in(s)])
            let written: DeclId? = self.ws.decls.decl_of(f, s)
            if written != null {
                let name = self.ws.decls.decl(written!).name
                for d in made {
                    let provenance = self.ws.decls.provenance_of(d)
                    if provenance != null && provenance!.original == name {
                        chunks.push(self.decl_block(d))
                        attached.push(d)
                    }
                }
            }
        }
        // A malformed declaration table must not make a generated
        // node invisible. Clean programs attach every declaration;
        // recovery output keeps any orphan at the end.
        for d in made {
            if !attached.any(same_decl(it, d)) { chunks.push(self.decl_block(d)) }
        }
        joined(chunks, "\n\n")
    }

    /// What an instance became — its expansion as source, under the
    /// module its names resolve in. A comment, since those names are
    /// the provider's: a template may call what this file cannot name.
    fn expansion_note(store: SyntaxArena, e: ExprId) -> string {
        let x? = store.expansion_of(e) else { return "" }
        let word? = store.instance_word(e) else { return "" }
        let home: string? = store.foreign_of(x)?.path
        let module = if home == null { "" } else { " (from ${self.ws.decls.module_name(self.ws.decls.file(self.ws.file_id(home!)).module_id)})" }
        let lines = ["// `${word}`${module} expands to:"]
            .concat(["//     ${l}" for l in render_expression(store, x).split("\n")])
        joined(lines, "\n")
    }

    /// One generated declaration as source with provenance appended.
    fn decl_line(d: DeclId) -> string {
        let source = render_statement(self.ws.decls.store(d), self.ws.decls.decl(d).stmt)
        let provenance = self.provenance_line(d)
        if provenance.is_empty() { source } else { "${source}   ${provenance}" }
    }

    fn decl_block(d: DeclId) -> string {
        let source = render_statement(self.ws.decls.store(d), self.ws.decls.decl(d).stmt)
        let provenance = self.provenance_line(d)
        if provenance.is_empty() { source } else { "${provenance}\n${source}" }
    }

    /// `// from @derive on Point — template …/derive.av:24`: who asked,
    /// what it names, and the quote the declaration was copied from.
    fn provenance_line(d: DeclId) -> string {
        let provenance? = self.ws.decls.provenance_of(d) else { return "" }
        let template: string? = self.template_word(provenance.template)
        "// from @${provenance.ann} on ${provenance.original}${template ?? ""}"
    }

    /// The template's file and line, when the file is loaded.
    fn template_word(template: Loc?) -> string? {
        if template == null || template!.file == null { return null }
        let site = template!
        let path = site.file!
        let f? = self.ws.decls.known_file_id(path) else { return null }
        " — template ${path}:${self.ws.source(f).linecol(site.lo).line}"
    }

    fn clean() -> bool { self.defects.is_empty() && !has_errors(self.voices) && !self.files.any(unclean(it)) }

    /// The packages' voices first (a manifest's trouble explains
    /// the rest), then every file's diagnostics, the workspace's
    /// defects last; "" means clean.
    ///
    /// THE BOUNDARY SPEAKS FIRST, AND ALONE. A refused `@std/meta`
    /// makes every expansion generate nothing, so every USE of a
    /// derived accessor refuses — a cascade of "no method" that names
    /// the boundary NOWHERE. Three build failures in one day read
    /// exactly that way, from three different causes, and the word
    /// "boundary" appeared in none of them. When the door refused,
    /// its refusal IS the report. The VERDICT still counts every
    /// diagnostic (`clean` is untouched): only the rendering stops
    /// explaining the wrong thing.
    fn report() -> string {
        let moved: string? = self.ws.decls.meta_disagreement()
        if moved != null { return self.rendered([foreign_package(moved!)]) }
        let files = [self.rendered(a.diagnostics) for a in self.files if unclean(a)]
        let heads: List<string> = if self.voices.is_empty() { [] } else { [self.rendered(self.voices)] }
        let tails: List<string> = if self.defects.is_empty() { [] } else { [self.rendered(self.defects)] }
        joined(heads.concat(files).concat(tails), "\n\n")
    }

    /// Diagnostics rendered over EVERY loaded source — a frame's
    /// window comes from the file its Loc names: a manifest, a file
    /// of this package, or the dependency file that wrote a template.
    fn rendered(ds: List<Diag>) -> string {
        let sources = self
            .manifests
            .concat([self.ws.source(f.id) for f in self.ws.decls.all_files()])
        joined([render_among(d, sources) for d in ds], "\n\n")
    }

    /// The rows the PACKAGE kinds among `ds` render under — one per
    /// diagnostic that wears one, its message the summary. A kind
    /// spoken is registered by being spoken; `kind_rows` is the
    /// registry `avra docs` walks without a diagnostic in hand.
    fn spoken_codes(ds: List<Diag>) -> List<DiagCode> {
        [user_code(d.kind, d.message) for d in ds if is_user_kind(d.kind)]
    }

    /// THE PACKAGE KINDS `avra docs @scope/name:E1` answers from:
    /// every `refuse_as("E1", "…")` with a literal kind in the
    /// annotation fns the workspace holds (the complete walk — a
    /// dependency's fns are where a package's kinds are spelled, and
    /// `files` is the root's alone), and every kind an annotation in
    /// this program SPOKE, which is how a kind computed at run time
    /// registers.
    fn kind_rows() -> List<DiagCode> {
        let spoken = self
            .spoken_codes(flatten([a.diagnostics for a in self.files]).concat(self.voices))
        distinct_codes(
            spoken.concat(flatten([self.kind_rows_of(fi.id) for fi in self.ws.decls.all_files()])),
        )
    }

    fn kind_rows_of(f: FileId) -> List<DiagCode> {
        let decls = self.ws.decls
        let names = self.ws.resolved(f)
        flatten(
            [self.kind_rows_in(names, d) for d in decls.decls_of_file(f) if decls.decl(d).root != null],
        )
    }

    /// The kinds one declaration's body spells, hidden branches
    /// included: every call bound to `@std/meta`'s kinded constructors
    /// with a literal kind.
    fn kind_rows_in(names: NameFacts, d: DeclId) -> List<DiagCode> {
        let decls = self.ws.decls
        let x = decls.decl(d)
        let package = decls.package_of(d)
        let store = decls.store(d)
        mut rows: List<DiagCode> = []
        for e in store.every_expr(x.root!) {
            let spoken: Kinded? = decls.kinded_call(names, store, e)
            if spoken != null {
                let k = spoken!
                let kind: string? = user_kind(package, k.kind)
                if kind != null { rows.push(user_code(kind!, k.message ?? "spoken by `@${x.name}`")) }
            }
        }
        rows
    }

    /// The program as IR, memory strategy applied — every unit
    /// through the workspace's memo.
    fn lowered() -> Lowered { self.lowered_from(self.entry?.at, false) }

    /// The program lowered from `entry`: its main and what it
    /// reaches — or, with no entry, every declared body; `every`
    /// asks for every declared body under an entry too.
    fn lowered_from(entry: int?, every: bool) -> Lowered {
        self.lowered_as(entry, every, false)
    }

    /// Whether the program's ROOT waits: the entry file's own
    /// expressions, or every file's when a `programs` binary runs them
    /// all. A top-level `spawn` or waiting read is no declaration, so the
    /// cancel pass cannot survey it; the driver knows the entry.
    fn root_links(entry: int?, programs: bool) -> bool {
        if entry != null { return self.ws.file_links_scheduler(self.files[entry!].view.file) }
        if !programs { return false }
        self.files.any((a) -> self.ws.file_links_scheduler(a.view.file))
    }

    fn lowered_bodies(entry: int?, every: bool, programs: bool) -> Lowered {
        let ws = self.ws
        // Every file this program reaches is typed by now (the
        // driver's own law: analysis before lowering). Settle the
        // references relation HERE, once, so the consuming pass
        // reads it below as an ordinary dependency rather than
        // computing it lazily mid-lower. The test after a call reads
        // its callee's cancel bits, so that fact settles here too.
        touch(ws.references())
        touch(ws.cancel_reach())
        // WHETHER THE PROGRAM LINKS A SCHEDULER: a member that spawns or
        // waits, or a wait at the ENTRY ROOT's top level — the root is no
        // declaration, so the cancel pass cannot see it. Settled once
        // here, before any body lowers, so every `while` of the program
        // is judged by one bit. A library that runs no top-level
        // statement (`entry` null, `programs` false) has no root.
        ws.decls.record_schedulers(ws.members_link_scheduler() || self.root_links(entry, programs))
        memory(
            self
                .ws
                .decls
                .union(
                    self.files,
                    entry,
                    every,
                    programs,
                    ws.hold.held_wants.get(),
                    ws.hold.held_codes.get(),
                    (w: Wanted) -> ws.lowered(ws.spec_id(w)),
                    (f: FileId) -> ws.is_held(f),
                    (f: FileId) -> ws.is_program_file(f),
                    (i: Instance) -> ws.kept_instance(i),
                ),
        ) with { libraries: ws.linked_packages() }
    }

    /// A program lowered, with what its host fns owe the program beyond
    /// their own declarations.
    fn lowered_as(entry: int?, every: bool, programs: bool) -> Lowered {
        let lo = self.lowered_bodies(entry, every, programs)
        lo with { diagnostics: lo.diagnostics.concat(self.ws.host_fn_voices([a.view.file for a in self.files])) }
    }

    /// The lowered program, CHECKED — every file's analysis first,
    /// then lowering's own refusals.
    fn lowered_checked() -> Result<Lowered, string> { self.checked_from(self.entry?.at, false) }

    /// The program lowered for its cases, CHECKED: a case is a
    /// declaration nothing reaches, so every declared body lowers —
    /// under the entry's laws all the same.
    fn every_body_checked() -> Result<Lowered, string> { self.checked_from(self.entry?.at, true) }

    /// WHAT EVERY PARSED FILE'S OBJECT HOLDS, CHECKED: each declared body, and the
    /// file's top level as a body under its program symbol — the same whatever
    /// program asks, so the object is the file's. The entry's law still speaks:
    /// a module file runs nothing, and a program file is none.
    fn files_checked() -> Result<Lowered, string> {
        if !self.clean() { return .Err(self.report()) }
        let lo = self.lowered_as(null, true, true)
        let stale = self.layout_report()
        if stale != null { return .Err(stale!) }
        let ws = self.ws
        let spoken = lo
            .diagnostics
            .concat(
                ws
                    .decls
                    .outside_entry(self.files, self.entry?.at, (f: FileId) -> ws.is_program_file(f)),
            )
        if !spoken.is_empty() { return .Err(self.rendered(spoken)) }
        .Ok(lo)
    }

    fn checked_from(entry: int?, every: bool) -> Result<Lowered, string> {
        if !self.clean() { return .Err(self.report()) }
        let lo = self.lowered_from(entry, every)
        let stale = self.layout_report()
        if stale != null { return .Err(stale!) }
        if !lo.diagnostics.is_empty() { return .Err(self.rendered(lo.diagnostics)) }
        .Ok(lo)
    }

    /// A layout fact moved under lowering, the way typing's own
    /// `Workspace.program` already checked it did not — MONO can
    /// still mint a fresh combination (R11c, avra-8sb5.34.21). `?`
    /// reads odd here on purpose: absence is the clean case.
    fn layout_report() -> string? {
        let stale = self.ws.decls.types.drain_stale()
        if stale.is_empty() { return null }
        joined(stale, "\n\n")
    }

    fn run() -> Result<string, string> {
        if self.entry == null { return .Err(self.rendered([no_target(self.ws.root)])) }
        run_lowered(self.lowered_checked()?)
    }

    /// What the program's run left behind in the evaluator.
    fn kept() -> Result<Kept, string> {
        if self.entry == null { return .Err(self.rendered([no_target(self.ws.root)])) }
        run_kept(self.lowered_checked()?)
    }

    /// The program run LIVE — its lines printed as they are printed —
    /// and how it ended; the refusal when it did not compile.
    fn run_live() -> Result<Ended, string> {
        if self.entry == null { return .Err(self.rendered([no_target(self.ws.root)])) }
        .Ok(run_live(self.lowered_checked()?))
    }

    /// Every test case the program declares.
    fn cases() -> List<TestCase> { self.ws.cases() }
    fn cases_at(path: string) -> List<TestCase> { self.ws.cases_at(path) }

    /// Everything wrong, rendered, as the refusal; or what merely
    /// warned, rendered, as the answer — "" when nothing spoke.
    fn check() -> Result<string, string> { self.check_bodies(false) }

    /// `check` over EVERY declared body, as `avra test` lowers them —
    /// a body nothing reaches from the entry is checked all the same.
    fn check_every() -> Result<string, string> { self.check_bodies(true) }

    fn check_bodies(every: bool) -> Result<string, string> {
        if !self.clean() { return .Err(self.report()) }
        let lowered = self.lowered_from(self.entry?.at, every).diagnostics
        let stale = self.layout_report()
        if stale != null { return .Err(stale!) }
        if has_errors(lowered) { return .Err(self.rendered(lowered)) }
        .Ok(self.warnings())
    }

    /// The warnings alone, rendered — what a clean program still
    /// says.
    fn warnings() -> string { self.warned(self.voices.concat(flatten([a.diagnostics for a in self.files]))) }

    /// The warnings among `ds`, rendered — "" when none spoke.
    fn warned(ds: List<Diag>) -> string {
        let said = [d for d in ds if is_warning(d)]
        if said.is_empty() { "" } else { self.rendered(said) }
    }
}
