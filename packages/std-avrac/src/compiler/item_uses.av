//! WHERE A `use` LINE NAMES WHAT ISN'T THERE: a package path that names no package, a module that is
//! both a directory and a file or is neither, an item listed twice, and an item the module's surface
//! doesn't hold — or, for the module's own test, holds privately in two files. Read off the item's
//! `use` lines and the surfaces of the modules they name, in the old reader's order: the path first,
//! then each item.
use core.{ModulePath, Span, distinct, flatten, module_path}
use compiler.laws.{Found, law}
use diagnostics.{Voice}
use compiler.{
    undeclared_dependency,
    apart_to_test,
    listed_again,
    module_twofold,
    moduleless,
    packageless,
    unexported,
}
use @std.program.address.{SourceFileAddress}
use @std.program.query_engine.{QueryEngine}

/// What a `use` line names that isn't there.
enum UseFault {
    /// Its path names no package.
    Packageless
    /// Its package is none its own package declares, beside the manifest that would, as a path from
    /// the file.
    Undeclared(key: string, manifest: string)
    /// Its module is both a directory and a file.
    Twofold
    /// Its module is neither.
    Moduleless
    /// An item it lists twice.
    Listed(item: string)
    /// An item the module's surface doesn't hold, beside what it does, and whether the asker is the
    /// module's own test.
    Unexported(item: string, exports: List<string>, own_test: bool)
    /// An item the module's own test reads that each of `files` declares privately.
    Apart(item: string, files: List<string>)
}

/// A fault of a `use` line, where the line stands and the path it names.
type UseFaultAt = { at: Span?, path: List<string>, fault: UseFault }

/// Every fault of the `use` lines the written item `at` of `file` writes, line by line.
fn use_faults(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<UseFaultAt> {
    if at >= item_count(engine, file) { return [] }
    let item = read_item(engine, file, at)
    if !item.store.refusals().is_empty() { return [] }
    flatten(
        [line_faults(engine, file, item.store.stmt_span(s), u!.path, u!.items) for s in item.stmts for u in [item.store.use_parts(s)] if u != null],
    )
}

/// The package's manifest, as a path from the directory `file` stands in.
fn manifest_from(file: SourceFileAddress) -> string {
    "${["../" for part in file.path_in_package.split("/").drop(1)].join("")}avra.toml"
}

/// The faults of one `use` line of `file` naming `path` and listing `items`: its path's first, and
/// only where the path holds, each item's.
fn line_faults(
    engine: QueryEngine,
    file: SourceFileAddress,
    at: Span?,
    path: List<string>,
    items: List<string>,
) -> List<UseFaultAt> {
    let m = module_path(path)
    let fault = (f: UseFault) -> UseFaultAt { at: at, path: path, fault: f }
    if m.malformed() { return [fault(UseFault.Packageless)] }
    let provider = m.package() ?? file.package_name
    if provider == file.package_name && m.local().join(".") == module_segments(file).join(".") { return [] }
    if !reaches(engine, file.package_name, provider) { return [fault(UseFault.Undeclared(provider, manifest_from(file)))] }
    if two_modules(engine, provider, m.local()) { return [fault(UseFault.Twofold)] }
    let module = ModuleAt {
        package: provider,
        local: m.local(),
        as_root: provider == file.package_name,
    }
    if module_files(engine, provider, module.local, module.as_root).is_empty() { return [fault(UseFault.Moduleless)] }
    [fault(f!) for j, item in items for f in [item_fault(engine, file, module, items.take(j), item)] if f != null]
}

/// What the `use` line's item `item`, listed after `before`, names that isn't there in `module`;
/// absent where its surface holds it.
fn item_fault(
    engine: QueryEngine,
    file: SourceFileAddress,
    module: ModuleAt,
    before: List<string>,
    item: string,
) -> UseFault? {
    if before.contains(item) { return UseFault.Listed(item) }
    let held = module_declarations_of(engine, module, item)
    if held.any(it.exported) || reexports_name(engine, module, item) { return null }
    let own_test = tests_of(file, module)
    if own_test && held.length == 1 { return null }
    if own_test && held.length > 1 { return UseFault.Apart(item, [d.file.path_in_package.split("/").last() ?? "" for d in held]) }
    UseFault.Unexported(item, exported_names(engine, module), own_test)
}

/// The names the surface of `module` exports, each once, in the order its files put them there.
fn exported_names(engine: QueryEngine, module: ModuleAt) -> List<string> {
    distinct(
        [n.name for n in module_surface(engine, module_files(engine, module.package, module.local, module.as_root)) if n.decl.exported],
    )
}

/// Every fault of the written item `at` of `file` that `words` names, as its law finds it.
fn faults_said(
    engine: QueryEngine,
    file: SourceFileAddress,
    at: int,
    words: fn(UseFault) -> List<string>,
) -> List<Found> {
    [Found { at: f.at, args: [f.path.join(".")].concat(w) } for f in use_faults(engine, file, at) for w in [words(f.fault)] if !w.is_empty()]
}

fn packageless_uses(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    faults_said(engine, file, at, (f: UseFault) -> match f { .Packageless -> ["-"], rest -> [] })
}

fn undeclared_uses(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    [found with { local: [2] } for found in faults_said(
        engine,
        file,
        at,
        (f: UseFault) -> match f { .Undeclared(key, manifest) -> [key, manifest], rest -> [] },
    )]
}

fn twofold_uses(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    faults_said(engine, file, at, (f: UseFault) -> match f { .Twofold -> ["-"], rest -> [] })
}

fn moduleless_uses(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    faults_said(engine, file, at, (f: UseFault) -> match f { .Moduleless -> ["-"], rest -> [] })
}

fn listed_uses(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    faults_said(engine, file, at, (f: UseFault) -> match f { .Listed(item) -> [item], rest -> [] })
}

fn unexported_uses(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    faults_said(
        engine,
        file,
        at,
        (f: UseFault) -> match f {
            .Unexported(item, exports, own_test) -> [item, if own_test { "test" } else { "" }].concat(exports),
            rest -> [],
        },
    )
}

fn apart_uses(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    faults_said(
        engine,
        file,
        at,
        (f: UseFault) -> match f { .Apart(item, files) -> [item].concat(files), rest -> [] },
    )
}

/// a `use` names a package as `@scope.name`
export law use_names_a_package {
    kind: "resolve.package_form"
    reads: packageless_uses
    voice: packageless_words
    witness: "use @solo.{z}\n1\n"
}

/// a `use` names a package its own package declares
export law use_names_a_dependency {
    kind: "resolve.not_a_dependency"
    reads: undeclared_uses
    voice: undeclared_words
    witness: "use @x.y.{z}\n1\n"
}

/// A module of one exported fn, `f`, as the witnesses of the `use` laws write it.
const EXPORTS_F: string = "export fn f() -> int { 1 }\n"

/// a module is a directory or a file, not both
export law use_names_one_module {
    kind: "resolve.module_ambiguous"
    reads: twofold_uses
    voice: twofold_words
    witness: "use util.{f}\n1\n"
    witness_files: {"src/util.av": EXPORTS_F, "src/util/mod.av": "export fn g() -> int { 1 }\n"}
}

/// a `use` names a module the source root holds
export law use_names_a_module {
    kind: "resolve.no_module"
    reads: moduleless_uses
    voice: moduleless_words
    witness: "use nope.{x}\n1\n"
}

/// a `use` lists each name once
export law use_lists_once {
    kind: "resolve.import_clash"
    reads: listed_uses
    voice: listed_words
    witness: "use util.{f, f}\nf()\n"
    witness_files: {"src/util.av": EXPORTS_F}
}

/// a `use` names what its module exports
export law use_names_an_export {
    kind: "resolve.not_exported"
    reads: unexported_uses
    voice: unexported_words
    witness: "use util.{hidden}\n1\n"
    witness_files: {"src/util.av": "fn hidden() -> int { 1 }\n"}
}

/// a test reads a private name its module declares once
export law test_reads_one_private {
    kind: "resolve.private_apart"
    reads: apart_uses
    voice: apart_words
    witness: "1\n"
    witness_files: {
        "src/util/a.av": "fn h() -> int { 1 }\n",
        "src/util/b.av": "fn h() -> int { 2 }\n",
        "src/util/tests/u_test.av": "use util.{h}\nspec \"u\" {\n    given \"g\" {\n        then \"t\" { h() == 1 }\n    }\n}\n",
    }
}

fn packageless_words(a: List<string>) -> Voice { packageless(module_path(a[0].split("."))) }

fn undeclared_words(a: List<string>) -> Voice { undeclared_dependency(a[1], a[2]) }

fn twofold_words(a: List<string>) -> Voice { module_twofold(module_path(a[0].split("."))) }

fn moduleless_words(a: List<string>) -> Voice { moduleless(module_path(a[0].split("."))) }

fn listed_words(a: List<string>) -> Voice { listed_again(a[1]) }

fn unexported_words(a: List<string>) -> Voice { unexported(module_path(a[0].split(".")), a[1], a.drop(3), a[2] == "test") }

fn apart_words(a: List<string>) -> Voice { apart_to_test(module_path(a[0].split(".")), a[1], a.drop(2)) }
