//! THE DERIVATION — a program analysed and lowered over everything the store
//! can stand in for. Every command asks here; what it WANTS decides what may
//! stand in for a file it does not read.
//!
//! A held file is not parsed, resolved, typed or lowered: its declarations are
//! minted from its module's record, its warnings and its object come from the
//! store. The sources are the hold's oracle — a derivation that fails under a
//! hold is answered again from the sources alone.
use core.debug.{db_verified_files}
use core.{
    distinct,
    flatten,
    some_list,
    joined,
    sorted_texts,
    digest_of,
    module_path,
    ModulePath,
    same_file,
    qtrace,
    traced,
    db_verified,
    touch,
    Static,
    FileId,
    DeclId,
    TypeId,
}
use features.{SettleRoot, Wanted, Analysed}
use @std.path.{relative_path, joined_path}
use diagnostics.{Diag, render_among}
use compiler.store.{Store, Stored, StoredName, node_key}
use compiler.lower.{Lowered, Body, HashAsk, code_facts, code_facts_wire}
use compiler.host.{no_source}
use compiler.findings.{Finding, findings_read, findings_text, file_findings}

/// What a command wants of a program. A file's warnings stand in for it
/// always; its object and its asks too when the want LINKS.
export enum Want { Diagnostics, Binary }

impl Want {
    /// Whether the want links: a binary does, and only a link reads a program's code hashes.
    fn links() -> bool {
        match self { .Binary -> true, .Diagnostics -> false }
    }
}

/// The derivation's phases, in the order `tried` ends them.
const PHASES: List<string> = ["load", "admit", "analyze", "lower", "keep"]

/// What a file SAID the last time it parsed: its warnings, rendered, and the
/// cases it declares — what stands in for it under every want.
export type Said = { path: string, warnings: string, cases: List<CaseCall>, findings: List<Finding> = [] }

/// A program derived: clean, every body lowered, its records and what each file said
/// kept. `program.ws` is the workspace the attempt that stood ran in.
export type Derived = { entry: string?, want: Want, program: Program, lowered: Lowered, store: Store, said: List<Said>, warnings: string, asked: string, files: int, spans: List<Phase> }

/// One file's hold: held, or read with why (null for a file no record
/// knows), the stored rows a read-for-want-of-rows file lacks, and what
/// moved in its key since it was last kept.
export type FileHold = { path: string, held: bool, why: Reads?, missing: List<string>, moved: List<PartMoved> }

/// A stored row by what it keeps, and whether the store has it.
type StoreRow = { says: string, kept: bool }

/// What an attempt that holds nothing is about to read, as a count.
const EVERY_FILE: int = 1000000

/// How many read files `--time` names before it counts the rest.
const READ_NAMED: int = 12

impl Derived {
    /// THE BUILD, by the workspace this derivation was made in — an
    /// identity, so it is written through and never copied.
    fn linked(m: ProgramModule, under: Keyed, binary: string, tools: Toolchain) -> Result<
        BuildOutcome,
        BuildError,
    > {
        self.program.ws.linked(self, m, under, binary, tools)
    }

    /// WHAT `--time` SAYS: the attempt's phases and what followed them on one line.
    fn timed(more: List<Phase>) -> string {
        joined(
            [ph.shown() for ph in grouped_phases(self.program.phases)]
                .concat(["attempt 0"])
                .concat([ph.shown() for ph in grouped_phases(self.spans.concat(more))]),
            ", ",
        )
    }
}

/// An `Analysis`'s three facts tables, as a rule reads them — the
/// same value under a narrower name (features/code.av's `Analysed`),
/// since a rule takes no `lang`/`diagnostics`/`program` of its own.
export fn analysed(a: Analysis) -> Analysed {
    Analysed { view: a.view, names: a.names, facts: a.facts }
}

/// What was said, the silent dropped.
fn spoken(texts: List<string>) -> string { joined([text for text in texts if !text.is_empty()], "\n\n") }

/// Where what a file said lives: beside its object, under the object's key.
fn said_key(okey: string) -> string { node_key(Stored.Warn, ["said", okey]) }

/// Where a file's rule findings live, beside what it said — kept only by
/// a derivation that wants diagnostics, since nothing a build makes reads
/// them.
fn rules_key(okey: string) -> string { node_key(Stored.Warn, ["rules", okey]) }

/// Where a file's findings rows live, beside its rendered rule findings.
fn findings_key(okey: string) -> string { node_key(Stored.Warn, ["findings", okey]) }

/// Whether a file's rule findings were kept, rendered and as rows.
fn ruled(store: Store, okey: string) -> bool {
    store.has(Stored.Warn, rules_key(okey)) && store.has(Stored.Warn, findings_key(okey))
}

/// What a parsed file says now: its `Said`, and its rule findings.
type Spoken = { said: Said, rules: Ruled }

/// A file's rule findings: rendered for what it says, and as findings rows.
type Ruled = { rendered: string, rows: List<Finding> }

/// A `Said` as its row: the case count, a line per case, then the warnings.
fn said_wire(s: Said) -> string {
    joined(
        ["${s.cases.length}"]
            .concat(["${c.symbol}\t${field_text(c.label)}" for c in s.cases])
            .concat([s.warnings]),
        "\n",
    )
}

/// `said_wire`, read back — null for a row that is not one.
fn said_of(path: string, raw: string) -> Said? {
    let lines = raw.split("\n")
    let n? = wire_number(lines.first() ?? "") else { return null }
    if n < 0 || lines.length < n + 1 { return null }
    let cases = [case_of(line) for line in lines.slice(1, n + 1)]
    if cases.any(it == null) { return null }
    Said {
        path: path,
        warnings: joined(lines.slice(n + 1, lines.length), "\n"),
        cases: [c! for c in cases],
    }
}

fn case_of(line: string) -> CaseCall? {
    let at = line.index_of("\t")
    if at < 0 { return null }
    CaseCall {
        symbol: line.substring(0, at),
        label: text_of_field(line.substring(at + 1, line.length)),
    }
}

/// Where "these instantiations lowered clean" is remembered.
fn clean_key(asked: string) -> string { node_key(Stored.Unit, ["clean", asked]) }

/// The paths a row remembers.
fn remembered(store: Store, key: string) -> List<string> { (store.get(Stored.Unit, key) ?? "").split("\n") }

/// `paths` joined to the ones a row remembers — written when it grows.
fn remember(store: Store, key: string, paths: List<string>) {
    let known = remembered(store, key)
    if paths.any((path) -> !known.contains(path)) { let _ = store.keep(Stored.Unit, key, joined(distinct(known.concat(paths)), "\n"), []) }
}

/// What `check` says of a clean program: its warnings, its stale
/// `// LICENSED` citations (compiler/licenses.av) and its rule
/// findings (compiler/findings.av's rows — a cache hit reads all
/// three back, never rescanning or rebuilding), and whether they
/// were kept from a check of these exact inputs — plus the PROGRAM
/// this answer was derived from, when one was: a cache hit costs a
/// hash and builds none, so a caller wanting the Program itself (a
/// baseline ratchet's own `--baseline_accept` prune, which needs the
/// files a check REACHED and not merely what it found) falls back to
/// building its own rather than forcing every `check` to pay for a
/// Program it does not otherwise need. `held` names the files a derived
/// answer stood in for from the store rather than read.
export type Checked = { warnings: string, reused: bool, timed: string, program: Program? = null, licenses: string = "", findings: List<Finding> = [], held: List<string> = [] }

impl Workspace {
    /// Where a program's instantiation homes are remembered, by its entry.
    fn homes_key(entry: string) -> string { self.file_key(Stored.Unit, "homes", entry) }

    /// Where the reads the last standing attempt needed are remembered, by its entry and the
    /// files its edit moved: a guess that only pre-admits, each file with the words of the
    /// reason it was read for. The same edit needs the same reads. Under no edit the row is
    /// the last standing attempt's reads whatever it moved, the guess for any other edit.
    fn guess_key(entry: string, edit: string) -> string { self.file_key(Stored.Unit, "guess", entry, [edit]) }

    /// Whether the last standing attempt of an entry read the program's instantiation homes.
    fn homes_read_key(entry: string) -> string { self.file_key(Stored.Unit, "homes-read", entry) }

    /// A read as a row files it: its file under its stored name.
    fn filed_read(r: ReadFile) -> ReadFile { r with { path: "${self.stored_name(r.path)}" } }

    /// The paths a row remembers, each kept under its stored name and read back as a path here.
    fn remembered_paths(store: Store, key: string) -> List<string> {
        [self.path_named(StoredName(n)) for n in remembered(store, key) if !n.is_empty()]
    }

    /// `paths` joined to the ones a row remembers, each under its stored name.
    fn remember_paths(store: Store, key: string, paths: List<string>) {
        remember(store, key, ["${self.stored_name(p)}" for p in paths])
    }

    /// What names a check among the root's kept programs: its entry by stored name.
    fn check_named(entry: string?) -> string { "check:${if entry == null { "" } else { "${self.stored_name(entry!)}" }}" }

    /// EVERYTHING WRONG WITH THE PROGRAM, as the refusal — or what merely warned,
    /// kept under the program's key, so an unchanged program costs a hash. A
    /// refusal is never kept.
    fn checked(entry: string?) -> Result<Checked, string> {
        if self.nothing_to_check() { fail self.rendered_shape([no_source(self.root)]) }
        let opening = self.clock()
        let store = self.opened_store()
        self.timed("open", opening)
        let under = Keyed { named: self.check_named(entry), beside: [] }
        let judging = self.clock()
        let key0 = self.confirmed_key(store, under)
        self.timed("judge", judging)
        let loading = self.clock()
        let kept: string? = self.db.warn(store, key0)
        let found: string? = self.db.findings(store, key0)
        let licensed: string? = self.db.licenses(store, key0)
        self.timed("load", loading)
        // A missing row is UNKNOWN, never EMPTY: no hit.
        if kept != null && found != null && licensed != null {
            return Checked {
                warnings: kept!,
                reused: true,
                timed: joined(
                    ["${ph.name} ${ph.ns / 1000}us" for ph in grouped_phases(self.phases.get())],
                    ", ",
                ),
                licenses: licensed!,
                findings: findings_read(found!),
            }
        }
        let d = self.derived(entry, Want.Diagnostics)?
        // a check derives the same answer for every target: the target rides
        // the key only when a binary or an object is what is kept
        let key = d.program.ws.kept_key(under)
        d.program.ws.keep_manifest(store, under, key)
        let licenses = stale_license_lines(d.program)
        let found = flatten([s.findings for s in d.said])
        self.db.insert_warn(store, key, d.warnings)
        self.db.insert_licenses(store, key, licenses)
        self.db.insert_findings(store, key, findings_text(found))
        work_sized(
            d.program.ws.decls.file_count(),
            d.program.ws.decls.module_count(),
            d.program.ws.decls.decl_count(),
        )
        Checked {
            warnings: d.warnings,
            reused: false,
            timed: d.timed([]),
            program: d.program,
            licenses: licenses,
            findings: found,
            held: held_paths(d.program.ws),
        }
    }

    /// NOTHING FOR `check` TO EXAMINE: a directory of programs (no `src/` —
    /// `per_file` is how the workspace itself remembers that, so this asks
    /// the workspace rather than the disk again) with no `.av` file
    /// directly in the root either. `root_files` already reads
    /// `packages[0].src` as the workspace was built — a directory of
    /// programs lists direct files alone, which is what makes an empty
    /// answer here mean none exist, not merely unwalked.
    ///
    /// A MANIFEST THAT ALREADY SPOKE IS LEFT TO SPEAK: a malformed
    /// `avra.toml` earns `manifest.syntax` naming the broken line, not
    /// "nothing to check" naming a symptom of it — the more specific
    /// voice wins, so this asks only once the manifest is silent.
    fn nothing_to_check() -> bool {
        self.per_file && self.packages_voiced().is_empty() && self.root_files().is_empty()
    }

    /// A refusal about the workspace's own SHAPE — no line anywhere to
    /// point at, so no source window is ever asked for.
    fn rendered_shape(ds: List<Diag>) -> string {
        joined([render_among(d, []) for d in ds], "\n\n")
    }

    /// THE PROGRAM DERIVED: one attempt, in a workspace of its own that gives back what it
    /// derived unless the attempt stood. Every file is read, and the saved answers stand in
    /// for what they still answer.
    fn derived(entry: string?, want: Want) -> Result<Derived, string> {
        if traced() { qtrace("Q\tattempt\t0\t${want.links()}\n") }
        // NOT `mut`: `anew`'s own hooks already capture this box
        // (workspace.av's `anew` doc — an identity, never a value).
        let fresh = self.anew()
        mut clock = fresh.marking()
        match fresh.tried(entry, want, clock) {
            .Ok(d) -> d,
            .Err(why) -> {
                fresh.discarded()
                fail why
            },
        }
    }

    /// THE DERIVATION, straight through: open the store, read the program, lower it, keep
    /// what was learned.
    fn tried(entry: string?, want: Want, mut clock: Marks) -> Result<Derived, string> {
        let store = self.opened(want)
        clock.next(PHASES)
        self.admit_all()
        clock.next(PHASES)
        let p = self.analysed(entry, want)?
        clock.next(PHASES)
        let lo = self.bodies_lowered(want, p)?
        clock.next(PHASES)
        let said = self.kept(want, store, p, lo)?
        clock.next(PHASES)
        self.stood(entry, want, store, p, lo, said, clock.spans)
    }

    /// The store this derivation keeps into, attached before anything reads a file.
    fn opened(want: Want) -> Store {
        let store = self.opened_store()
        self.attach_store(store)
        self.host.reads_ahead(EVERY_FILE)
        store
    }

    /// THE PROGRAM, ANALYSED AND CLEAN.
    fn analysed(entry: string?, want: Want) -> Result<Program, string> {
        let p = self.program(entry, if want.links() { entry } else { null })
        if !p.clean() { fail p.report() }
        p
    }

    /// EVERY BODY, LOWERED.
    fn bodies_lowered(want: Want, p: Program) -> Result<Lowered, string> {
        let lowered = p.files_checked(want.links())
        self.settle_consts(p)
        lowered
    }

    /// WHAT WAS LEARNED, KEPT: the records first — every key folds them — then what stands in
    /// for each file, whole: what it said, and what its bodies ask.
    fn kept(want: Want, store: Store, p: Program, lo: Lowered) -> Result<List<Said>, string> {
        let moved = [module_path(name.split(".")) for name in distinct([self.module_of(a.view.source.file) for a in p.files])]
        keep_interfaces(self, store, moved)
        let _ = self.keep_const_units(store, moved)
        let defects = self.defects.get()
        if defects.length > p.defects.length { fail p.rendered(defects.drop(p.defects.length)) }
        let bodies = filed(lo.unmanaged, (b) -> b.file)
        let statics = filed(lo.statics, (s) -> s.file)
        let asks = filed(lo.hash_asks, (h) -> h.by)
        for a in p.files {
            self.keep_asks(store, lo, a)
            self.keep_codes(store, a, bodies, statics, asks)
        }
        self.keep_instances(store, lo)
        let said? = self.all_said(store, p, want) else { fail "what a file said could not be read" }
        self.flush_saved()
        said
    }

    /// THE DERIVATION THAT STOOD, as the program derived.
    fn stood(
        entry: string?,
        want: Want,
        store: Store,
        p: Program,
        lo: Lowered,
        said: List<Said>,
        spans: List<Phase>,
    ) -> Derived {
        let reach = reached_modules(self, store, p)
        if db_verified() {
            self.lowered_said_pass(store)
            self.typed_said_pass(store)
        }
        store.settle()
        Derived {
            entry: entry,
            want: want,
            program: p,
            lowered: lo,
            store: store,
            said: said,
            warnings: spoken(
                [p.warned(p.voices)]
                    .concat([s.warnings for s in said if reaches_file(self, reach, s.path)]),
            ),
            asked: digest_of(
                joined(sorted_texts(distinct([self.wanted_wire(k.want) for k in lo.asks])), "\n"),
            ),
            files: self.decls.file_count(),
            spans: spans,
        }
    }

    /// WHETHER THE STORE STANDS IN FOR A FILE under this want.
    fn stands_in(s: Store, okey: string, want: Want) -> bool {
        if !s.has(Stored.Warn, said_key(okey)) ||
            !s.has(Stored.Unit, self.asks_key(okey)) ||
            !s.has(Stored.Unit, self.codes_key(okey)) {
            return false
        }
        want is .Diagnostics || s.has(Stored.Obj, okey)
    }

    /// ONE FILE'S HOLD, as this package's derivation under `want` decided it:
    /// held, or read with why — and for a file nothing kept stands in for,
    /// which of its rows the store is missing.
    fn hold_report(want: Want) -> Result<List<FileHold>, string> {
        let d = self.derived(null, want)?
        d.program.ws.holds_of(d)
    }

    /// Every file's hold under the derivation that stood in this workspace.
    fn holds_of(d: Derived) -> List<FileHold> { [self.file_hold(d, fi.path, fi.id) for fi in self.decls.all_files()] }

    fn file_hold(d: Derived, path: string, f: FileId) -> FileHold {
        if self.is_held(f) { return FileHold { path: path, held: true, why: null, missing: [], moved: [] } }
        let why: Reads? = null
        let unkept = why != null && why! is .Unkept
        let missing = if unkept { self.missing_rows(d.store, self.held_okey(d.store, path), d.want) } else { [] }
        FileHold {
            path: path,
            held: false,
            why: why,
            missing: missing,
            moved: self.parts_moved_at(path),
        }
    }

    /// What this build found moved in a file's key: its own parts, then the
    /// modules its module sees.
    fn parts_moved_at(path: string) -> List<PartMoved> {
        let moved = self.hold.moved.get()
        (moved.get(self.parts_key(path)) ?? [])
            .concat(moved.get(self.seen_key(self.module_path_of(path).text())) ?? [])
    }

    /// The rows standing in for a file under `want` that the store lacks, by
    /// what each keeps.
    fn missing_rows(store: Store, okey: string, want: Want) -> List<string> {
        let rows = [
            StoreRow { says: "what it said", kept: store.has(Stored.Warn, said_key(okey)) },
            StoreRow {
                says: "what its bodies ask",
                kept: store.has(Stored.Unit, self.asks_key(okey)),
            },
            StoreRow {
                says: "what its code is",
                kept: store.has(Stored.Unit, self.codes_key(okey)),
            },
            match want {
                .Diagnostics -> StoreRow { says: "its rule findings", kept: ruled(store, okey) },
                .Binary -> StoreRow { says: "its object", kept: store.has(Stored.Obj, okey) },
            },
        ]
        [r.says for r in rows if !r.kept]
    }

    /// What one read file's bodies ask, kept under the file's key.
    fn keep_asks(store: Store, lo: Lowered, a: Analysis) {
        let asks = self.held_asks_wire([k.want for k in lo.asks if same_file(k.by, a.view.file)])
        let _ = store
            .keep_once(Stored.Unit, self.asks_key(self.held_okey(store, a.view.source.file)), asks)
        let path = a.view.source.file
        self.keep_file_row(store, path, Stored.Unit, self.asks_row(path), asks)
    }

    /// Each fresh instantiation's code, kept under its own key — what a held
    /// home's stub reads back in a later build.
    fn keep_instances(store: Store, lo: Lowered) {
        for ic in lo.instances {
            let key = self.inst_key(store, ic.key)
            let facts = code_facts(self.decls, ic.bodies, ic.statics, [])
            let _ = store.keep_once(Stored.Unit, key, code_facts_wire(facts))
            let rows = flatten([[c.symbol, self.inst_key(store, c)] for c in ic.callees])
            let _ = store
                .keep_once(
                    Stored.Unit,
                    self.callees_key(key),
                    ["${ic.callees.length}"].concat(rows).join("\n"),
                )
        }
    }

    /// What one read file's code is, kept under the file's key.
    fn keep_codes(
        store: Store,
        a: Analysis,
        bodies: Map<string, List<Body>>,
        statics: Map<string, List<Static>>,
        asks: Map<string, List<HashAsk>>,
    ) {
        let f = a.view.file
        let at = "${f.index}"
        let fresh = code_facts(
            self.decls,
            bodies.get(at) ?? [],
            statics.get(at) ?? [],
            [h.target for h in asks.get(at) ?? []],
        )
        let facts = merged_facts(
            fresh,
            [s.facts for s in self.hold.served.get() if same_file(s.file, f)],
        )
        let _ = store
            .keep_once(
                Stored.Unit,
                self.codes_key(self.held_okey(store, a.view.source.file)),
                code_facts_wire(facts),
            )
        let path = a.view.source.file
        self.keep_file_row(store, path, Stored.Unit, self.codes_row(path), code_facts_wire(facts))
    }

    /// Every declared const of every parsed file, settled.
    fn settle_consts(p: Program) {
        for a in p.files {
            for d in self.decls.decls_of_file(a.view.file) {
                let x = self.decl_at(d)
                if x.kind is .Const && !x.nested() { let _ = self.settled(x.file, SettleRoot.Const(x.stmt), []) }
            }
        }
    }

    /// The declarations a read file names, standing: its own admission, plus its
    /// resolution only where declarations are generated at resolve. Resolving a
    /// file asks the items of every file it sees, which parses each held file the
    /// holds have not yet settled.
    fn declared(f: FileId) {
        if self.has_declares(f) || self.has_marks(f) { let _ = self.resolved(f) } else { touch(self.items(f)) }
    }

    /// WHAT THE PROGRAM'S INSTANTIATIONS ARE A FUNCTION OF: its root asks, and the
    /// key of every home it has lowered from — a home's text, and the interfaces
    /// it sees. An ask a home's own body makes is that home's content. A home the
    /// tree no longer has is gone from the print, so the print moves with it.
    fn asked_print(store: Store, known_as: string, held: List<HeldAsk>, fresh: List<Wanted>) -> string {
        let homes = [path for path in sorted_texts(self.remembered_paths(store, self.homes_key(known_as))) if self.there(path)]
        digest_of(
            joined(
                sorted_texts(
                    distinct([h.wire for h in held].concat([self.wanted_wire(w) for w in fresh])),
                )
                    .concat(
                        ["${self.stored_name(path)}\t${self.held_okey(store, path)}" for path in homes],
                    ),
                "\n",
            ),
        )
    }

    /// What every file said, in file order: a parsed file's KEPT, a held file's
    /// as the store kept it — null when a held row cannot be read. A file the
    /// table knows and nothing read said nothing.
    fn all_said(store: Store, p: Program, want: Want) -> List<Said>? {
        mut fresh: Map<string, Spoken> = {}
        for a in p.files { fresh.set(a.view.source.file, self.says(store, p, a)) }
        let said = [self.file_said(store, fi.path, fresh.get(fi.path), want) for fi in self.decls.all_files() if fresh.get(fi.path) != null || self.is_held(fi.id)]
        if said.any(it == null) { return null }
        [s! for s in said]
    }

    /// What a parsed file says now: its warnings, and its rule findings —
    /// kept under every want, printed only under a diagnostics want.
    fn says(store: Store, p: Program, a: Analysis) -> Spoken {
        let said = Said {
            path: a.view.source.file,
            warnings: p.warned(a.diagnostics),
            cases: [CaseCall { symbol: c.symbol, label: case_words(c) } for c in self.file_cases(a.view.file)],
        }
        let kept = self.kept_ruled(store, a.view.source.file)
        if kept != null && !db_verified_files() { return Spoken { said: said, rules: kept! } }
        let now = ruled_now(p, a, rule_findings(analysed(a), a.view.stmts))
        if kept != null && kept!.rendered != now.rendered { self.defect(kept_rules_stale(a.view.source.file)) }
        Spoken { said: said, rules: now }
    }

    /// A read file's key parts: its own under its path, the modules it sees
    /// under its module — each rewritten only when it moved, and what moved
    /// noted in the hold under the row's key.
    fn keep_parts(store: Store, path: string) {
        let now = self.key_parts_cached(store, self.module_path_of(path), path)
        let own = now with { seen: [] }
        let kept = store.get(Stored.Unit, self.parts_key(path))
        let was = parts_of(kept ?? "")
        let filed = self.stored_parts(own)
        self
            .keep_moved(
                store,
                self.parts_key(path),
                parts_wire(filed),
                if was == null { [] } else { parts_moved(store, self.record_bodies(), was!, filed) },
            )
        // THE MODULE'S SEEN ROW is the module's whole view, one row its files share: the key a
        // file wears narrows it by name, and the move a reader is told of is the module's
        let whole = self.view_parts(store, self.module_path_of(path))
        let seen = store.get(Stored.Unit, self.seen_key(now.module))
        let seen_was = seen_of(seen ?? "")
        self
            .keep_moved(
                store,
                self.seen_key(now.module),
                seen_wire(whole),
                if seen == null || seen_was == null { [] } else { seen_list_moved(store, self.record_bodies(), seen_was!, whole) },
            )
    }

    /// A parts row kept when it moved, what moved noted under its key.
    fn keep_moved(store: Store, key: string, wire: string, moved: List<PartMoved>) {
        if store.get(Stored.Unit, key) == wire { return }
        if !moved.is_empty() { self.hold.moved.put(key, moved) }
        let _ = store.keep(Stored.Unit, key, wire, [])
    }

    /// One file's `Said`: kept under its key when it parsed, read from there
    /// when it did not. Its rule findings are kept under every want; only a
    /// diagnostics want speaks them.
    fn file_said(store: Store, path: string, fresh: Spoken?, want: Want) -> Said? {
        let okey = self.held_okey(store, path)
        let told? = fresh else {
            let kept? = store.get(Stored.Warn, said_key(okey)) else { return null }
            let said? = said_of(path, kept) else { return null }
            return held_said(store, okey, said, want)
        }
        self.said_noted(path, told)
        let _ = store.keep_once(Stored.Warn, said_key(okey), said_wire(told.said))
        self.keep_parts(store, path)
        let rules = told.rules
        let _ = store.keep_once(Stored.Warn, rules_key(okey), rules.rendered)
        let _ = store.keep_once(Stored.Warn, findings_key(okey), findings_text(rules.rows))
        self.keep_file_row(store, path, Stored.Unit, self.okey_row(path), okey)
        self.keep_file_row(store, path, Stored.Warn, self.said_row(path), said_wire(told.said))
        self.keep_file_row(store, path, Stored.Warn, self.rules_row(path), rules.rendered)
        self
            .keep_file_row(store, path, Stored.Warn, self.findings_row(path), findings_text(rules.rows))
        match want {
            .Diagnostics -> told.said with { warnings: spoken([told.said.warnings, rules.rendered]), findings: rules.rows },
            .Binary -> told.said,
        }
    }
}

/// A file's rule findings found now.
fn ruled_now(p: Program, a: Analysis, found: List<Diag>) -> Ruled {
    Ruled { rendered: p.warned(found), rows: file_findings(p.ws.host, a, found) }
}

/// A `boxed` row's name, when it names `path` — null for every other row.
fn boxed_name(parts: List<string>, path: string) -> string? {
    let row? = read_row(parts) else { return null }
    if row.shape is .Boxed && row.path == path { row.name } else { null }
}

/// A held file's `Said` under `want`: a diagnostics want reads its rule
/// findings beside it, and `stands_in` held it only where they were kept.
fn held_said(store: Store, okey: string, said: Said, want: Want) -> Said? {
    match want {
        .Diagnostics -> {
            let rules? = store.get(Stored.Warn, rules_key(okey)) else { return null }
            let rows? = store.get(Stored.Warn, findings_key(okey)) else { return null }
            said with { warnings: spoken([said.warnings, rules]), findings: findings_read(rows) }
        },
        .Binary -> said,
    }
}

// ── The voices ──

/// Whether a kept row is judged from its file alone, with no analysis run.
fn judged_by_files(r: List<string>) -> bool {
    match r[0] { "f" or "m" or "b" or "e" -> true, rest -> false }
}

/// A list filed by the file each item belongs to, keyed by the file's index; items of no
/// file are dropped.
fn filed<T>(xs: List<T>, at: fn(T) -> FileId?) -> Map<string, List<T>> {
    mut out: Map<string, List<T>> = {}
    for x in xs {
        let f = at(x)
        if f != null { out.set("${f!.index}", (out.get("${f!.index}") ?? []).concat([x])) }
    }
    out
}

/// Whether a record row declares a fn.
fn fn_shape(s: Shape) -> bool {
    match s { .Fn or .Extern -> true, rest -> false }
}

/// One read as a guess line: its path and its reason's words; none for a path a line cannot carry.
fn guess_line(r: ReadFile) -> string {
    if r.path.contains("\t") || r.path.contains("\n") || r.why.says().contains("\n") { "" } else { "${r.path}\t${r.why.says()}" }
}

fn kept_rules_stale(path: string) -> string {
    "the rule findings kept for `${path}` stood by their reads where a fresh walk of its rules says otherwise — a read the findings stand on is missing from their row"
}
