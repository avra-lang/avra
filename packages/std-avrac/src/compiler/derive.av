//! THE DERIVATION — a program analysed and lowered over everything the store
//! can stand in for. Every command asks here; what it WANTS decides what may
//! stand in for a file it does not read.
//!
//! A held file is not parsed, resolved, typed or lowered: its declarations are
//! minted from its module's record, its warnings and its object come from the
//! store. The sources are the hold's oracle — a derivation that fails under a
//! hold is answered again from the sources alone.
use core.{distinct, joined, sorted_texts, digest_of, module_path, same_file, FileId, DeclId}
use features.{SettleRoot, Wanted, Analysed}
use @std.path.{relative_path, joined_path}
use diagnostics.{Diag, render_among}
use compiler.store.{Store, Stored, node_key}
use compiler.lower.{Lowered}
use compiler.host.{no_source}
use compiler.findings.{findings_text, file_findings_text}

/// What a command wants of a program. A file's warnings stand in for it
/// always; its object and its asks too when the want LINKS.
export enum Want { Diagnostics, Binary }

/// ONE ATTEMPT AT A PROGRAM: what it derives and for what, the files it reads
/// whatever the store holds, whether it reads the program's instantiation HOMES,
/// whether it holds anything, and how many times the records moved under it.
type Attempt = { entry: string?, want: Want, parse: List<ReadFile> = [], homes: bool = false, hold: bool = true, moved: int = 0, turned: int = 0 }

/// WHAT AN ATTEMPT THAT DOES NOT STAND ANSWERS: the attempt to make instead, or
/// the refusal. It rides the failure channel, so a phase that finds the question
/// was wrong leaves with `?`, and the derivation reads as its phases alone.
enum Turn {
    Again(Attempt)
    Refused(string)
}

impl Attempt {
    /// The same attempt, reading these files too.
    fn reading(more: List<ReadFile>) -> Attempt { self with { parse: self.parse.concat(more) } }

    /// STANDS when nothing more must be read — else the attempt that reads it.
    fn having_read(more: List<ReadFile>) -> Result<int, Turn> {
        if more.is_empty() { .Ok(0) } else { .Err(Turn.Again(self.reading(more))) }
    }

    /// The attempt with nothing held — the hold's oracle. One that held nothing
    /// has no hold to blame: asking again would ask forever.
    fn unheld(why: string) -> Turn {
        if self.hold { Turn.Again(self with { hold: false }) } else { Turn.Refused(nothing_held(why)) }
    }

    /// The attempt once more, the records having moved under it — twice, no more.
    fn adrift(paths: List<string>) -> Turn {
        if self.moved >= 2 { Turn.Refused(records_adrift(paths)) } else { Turn.Again(self with { moved: self.moved + 1 }) }
    }
}

/// A refusal in the derivation's words is the attempt's refusal.
fn or_refused<T>(r: Result<T, string>) -> Result<T, Turn> {
    match r { .Ok(v) -> .Ok(v), .Err(why) -> .Err(Turn.Refused(why)) }
}

/// What a file SAID the last time it parsed: its warnings, rendered, and the
/// cases it declares — what stands in for it under every want.
export type Said = { path: string, warnings: string, cases: List<CaseCall> }

/// A program derived: clean, every parsed body lowered, its records and what
/// each file said kept. `program.ws` is the workspace the attempt that stood
/// ran in.
///
/// AN INSTANTIATION LOWERS FROM ITS GENERIC'S BODY, and a held home has none. So
/// `unlowered` are the instantiations this derivation asked for and did not
/// lower, and `asked` names what they and every other would lower to: the
/// program's root asks, and the key of every home it has ever lowered from. The
/// same `asked` is the same instantiations, whoever lowered them.
export type Derived = { entry: string?, want: Want, program: Program, lowered: Lowered, store: Store, said: List<Said>, warnings: string, unlowered: List<Wanted>, asked: string, held: int, files: int, turns: int, turned: int = 0, spans: List<Phase>, read: List<ReadFile>, refused: int = 0 }

/// One file's hold: held, or read with why (null for a file no record
/// knows), the stored rows a read-for-want-of-rows file lacks, and what
/// moved in its key since it was last kept.
export type FileHold = { path: string, held: bool, why: Reads?, missing: List<string>, moved: List<PartMoved> }

/// A stored row by what it keeps, and whether the store has it.
type StoreRow = { says: string, kept: bool }

/// What an attempt that holds nothing is about to read, as a count.
const EVERY_FILE: int = 1000000

/// How many read files `--time` names before it counts the rest.
const READ_NAMED: int = 12

impl Derived {
    /// THE BUILD, by the workspace this derivation was made in — an
    /// identity, so it is written through and never copied.
    fn linked(m: ProgramModule, under: Keyed, binary: string, tools: Toolchain) -> Result<
        BuildOutcome,
        BuildError,
    > {
        self.program.ws.linked(self, m, under, binary, tools)
    }

    /// WHAT `--time` SAYS: the phases and what followed them on one line, then
    /// the files a record knows that were read all the same, each with why.
    fn timed(more: List<Phase>) -> string {
        let counted = [
            "held ${self.held}/${self.files}",
            "attempt ${self.turns}",
            "discarded ${self.turned}",
            "refused ${self.refused}",
        ]
        let spent = joined(
            [ph.shown() for ph in grouped_phases(self.program.phases)]
                .concat(counted)
                .concat([ph.shown() for ph in grouped_phases(self.spans.concat(more))]),
            ", ",
        )
        if self.read.is_empty() { return spent }
        let named = ["  ${relative_path(self.program.ws.root, r.path)} — ${r.why.says()}" for r in self.read.slice(0, READ_NAMED)]
        let rest = if self.read.length > READ_NAMED { ["  … and ${self.read.length - READ_NAMED} more"] } else { [] }
        joined([spent, "read:"].concat(named).concat(rest), "\n")
    }
}

/// An `Analysis`'s three facts tables, as a rule reads them — the
/// same value under a narrower name (features/code.av's `Analysed`),
/// since a rule takes no `lang`/`diagnostics`/`program` of its own.
export fn analysed(a: Analysis) -> Analysed {
    Analysed { view: a.view, names: a.names, facts: a.facts }
}

/// What was said, the silent dropped.
fn spoken(texts: List<string>) -> string { joined([text for text in texts if !text.is_empty()], "\n\n") }

/// Where what a file said lives: beside its object, under the object's key.
fn said_key(okey: string) -> string { node_key(Stored.Warn, ["said", okey]) }

/// Where a file's rule findings live, beside what it said — kept only by
/// a derivation that wants diagnostics, since nothing a build makes reads
/// them.
fn rules_key(okey: string) -> string { node_key(Stored.Warn, ["rules", okey]) }

/// Where a file's findings rows live, beside its rendered rule findings.
fn findings_key(okey: string) -> string { node_key(Stored.Warn, ["findings", okey]) }

/// Whether a file's rule findings were kept, rendered and as rows.
fn ruled(store: Store, okey: string) -> bool {
    store.has(Stored.Warn, rules_key(okey)) && store.has(Stored.Warn, findings_key(okey))
}

/// What a parsed file says now: its `Said`, and its rule findings when
/// the want asks for them.
type Spoken = { said: Said, rules: Ruled? }

/// A file's rule findings: rendered for what it says, and as findings rows.
type Ruled = { rendered: string, rows: string }

/// A `Said` as its row: the case count, a line per case, then the warnings.
fn said_wire(s: Said) -> string {
    joined(
        ["${s.cases.length}"]
            .concat(["${c.symbol}\t${field_text(c.label)}" for c in s.cases])
            .concat([s.warnings]),
        "\n",
    )
}

/// `said_wire`, read back — null for a row that is not one.
fn said_of(path: string, raw: string) -> Said? {
    let lines = raw.split("\n")
    let n? = wire_number(lines.first() ?? "") else { return null }
    if n < 0 || lines.length < n + 1 { return null }
    let cases = [case_of(line) for line in lines.slice(1, n + 1)]
    if cases.any(it == null) { return null }
    Said {
        path: path,
        warnings: joined(lines.slice(n + 1, lines.length), "\n"),
        cases: [c! for c in cases],
    }
}

fn case_of(line: string) -> CaseCall? {
    let at = line.index_of("\t")
    if at < 0 { return null }
    CaseCall {
        symbol: line.substring(0, at),
        label: text_of_field(line.substring(at + 1, line.length)),
    }
}

/// Where a program's instantiation homes are remembered, by its entry.
fn homes_key(entry: string) -> string { node_key(Stored.Unit, ["homes", entry]) }

/// Where "these instantiations lowered clean" is remembered.
fn clean_key(asked: string) -> string { node_key(Stored.Unit, ["clean", asked]) }

/// The paths a row remembers.
fn remembered(store: Store, key: string) -> List<string> { (store.get(Stored.Unit, key) ?? "").split("\n") }

/// `paths` joined to the ones a row remembers — written when it grows.
fn remember(store: Store, key: string, paths: List<string>) {
    let known = remembered(store, key)
    if paths.any((path) -> !known.contains(path)) { let _ = store.keep(Stored.Unit, key, joined(distinct(known.concat(paths)), "\n"), []) }
}

/// What `check` says of a clean program: its warnings, its stale
/// `// LICENSED` citations (compiler/licenses.av) and its rule
/// findings (compiler/findings.av, TSV-encoded — a cache hit reads
/// all three back, never rescanning or rebuilding), and whether they
/// were kept from a check of these exact inputs — plus the PROGRAM
/// this answer was derived from, when one was: a cache hit costs a
/// hash and builds none, so a caller wanting the Program itself (a
/// baseline ratchet's own `--baseline_accept` prune, which needs the
/// files a check REACHED and not merely what it found) falls back to
/// building its own rather than forcing every `check` to pay for a
/// Program it does not otherwise need.
export type Checked = { warnings: string, reused: bool, timed: string, program: Program? = null, licenses: string = "", findings: string? = null }

impl Workspace {
    /// EVERYTHING WRONG WITH THE PROGRAM, as the refusal — or what merely warned,
    /// kept under the program's key, so an unchanged program costs a hash. A
    /// refusal is never kept.
    fn checked(entry: string?) -> Result<Checked, string> {
        if self.nothing_to_check() { fail self.rendered_shape([no_source(self.root)]) }
        let store = self.opened_store()
        let under = Keyed { named: "check:${entry ?? ""}", beside: [] }
        let key0 = self.program_key(under.named, under.beside)
        let kept: string? = self.db.warn(store, key0)
        if kept != null {
            return Checked {
                warnings: kept!,
                reused: true,
                timed: "",
                licenses: self.db.licenses(store, key0) ?? "",
                // A missing row reads as UNKNOWN, never as EMPTY — the
                // empty-value law applied to a cache row. A caller reads
                // null as "derive it yourself", "" as "no findings".
                findings: self.db.findings(store, key0),
            }
        }
        let d = self.derived(entry, Want.Diagnostics)?
        let key = d.program.ws.kept_key(under)
        let licenses = stale_license_lines(d.program)
        let findings = d.program.ws.all_findings(d.store, d.program)
        self.db.insert_warn(store, key, d.warnings)
        self.db.insert_licenses(store, key, licenses)
        self.db.insert_findings(store, key, findings)
        Checked {
            warnings: d.warnings,
            reused: false,
            timed: d.timed([]),
            program: d.program,
            licenses: licenses,
            findings: findings,
        }
    }

    /// EVERY RULE FINDING THE PROGRAM HOLDS: a read file's found now, a held
    /// file's answered by the rows it kept — the hold read every file whose
    /// rows were missing (`unruled`).
    fn all_findings(store: Store, p: Program) -> string {
        let held = [store.get(Stored.Warn, findings_key(self.held_okey(store, fi.path))) ?? "" for fi in self.decls.all_files() if self.is_held(fi.id)]
        joined([t for t in [findings_text(p)].concat(held) if t != ""], "\n")
    }

    /// NOTHING FOR `check` TO EXAMINE: a directory of programs (no `src/` —
    /// `per_file` is how the workspace itself remembers that, so this asks
    /// the workspace rather than the disk again) with no `.av` file
    /// directly in the root either. `root_files` already reads
    /// `packages[0].src` as the workspace was built — a directory of
    /// programs lists direct files alone, which is what makes an empty
    /// answer here mean none exist, not merely unwalked.
    ///
    /// A MANIFEST THAT ALREADY SPOKE IS LEFT TO SPEAK: a malformed
    /// `avra.toml` earns `manifest.syntax` naming the broken line, not
    /// "nothing to check" naming a symptom of it — the more specific
    /// voice wins, so this asks only once the manifest is silent.
    fn nothing_to_check() -> bool {
        self.per_file && self.packages_voiced().is_empty() && self.root_files().is_empty()
    }

    /// A refusal about the workspace's own SHAPE — no line anywhere to
    /// point at, so no source window is ever asked for.
    fn rendered_shape(ds: List<Diag>) -> string {
        joined([render_among(d, []) for d in ds], "\n\n")
    }

    /// The program at `entry`, derived — under the hold, and from the sources
    /// alone when the hold's attempt refused.
    fn derived(entry: string?, want: Want) -> Result<Derived, string> { self.derived_reading(entry, want, []) }

    /// `derived`, with files read whatever the store holds for them.
    fn derived_reading(entry: string?, want: Want, parse: List<ReadFile>) -> Result<Derived, string> {
        let held = self.attempted(Attempt { entry: entry, want: want, parse: parse })
        if held is .Ok { return self.checked_whole(held?) }
        if held_paths(self).is_empty() { return held }
        let plain = self.from_sources(entry, want)
        match plain {
            .Ok(d) -> {
                eprintln(self.refusal_noted(held))
                .Ok(d with { refused: 1 })
            },
            .Err(_) -> plain,
        }
    }

    /// A REFUSED HOLD IS A CONDITION THE COMPILER HANDLES, so it says so on one
    /// line and keeps the held attempt's words in the store, never on stderr,
    /// where they read as this run's diagnostics. An inspection keeps nothing,
    /// so it says where the words are kept instead.
    fn refusal_noted(held: Result<Derived, string>) -> string {
        let why = match held { .Ok(_) -> "", .Err(w) -> w }
        match self.keys.keeping.get() {
            .Disk -> {
                let at = joined_path(build_cache_root(self), "hold-refused.log")
                let _ = self.host.write(at, why)
                hold_refusal(why, at)
            },
            .Aside(_) -> hold_refusal_unkept(why),
        }
    }

    /// A derivation that only SPEAKS owes its instantiations' verdict: lowered now,
    /// unless these very instantiations lowered clean before.
    fn checked_whole(d: Derived) -> Result<Derived, string> {
        if !(d.want is .Diagnostics) ||
            d.unlowered.is_empty() ||
            d.store.has(Stored.Unit, clean_key(d.asked)) {
            return d
        }
        d.program.ws.whole(d, [])
    }

    /// The derivation with every instantiation lowered: the homes read, and
    /// `parse` with them.
    fn whole(d: Derived, parse: List<ReadFile>) -> Result<Derived, string> {
        if d.unlowered.is_empty() { return d }
        self.again(Attempt { entry: d.entry, want: d.want, parse: parse, homes: true })
    }

    /// The program derived with nothing held — the hold's oracle.
    fn from_sources(entry: string?, want: Want) -> Result<Derived, string> { self.again(Attempt { entry: entry, want: want, hold: false }) }

    /// WHETHER THE STORE STANDS IN FOR A FILE under this want.
    fn stands_in(s: Store, okey: string, want: Want) -> bool {
        if !s.has(Stored.Warn, said_key(okey)) || !s.has(Stored.Unit, self.asks_key(okey)) { return false }
        want is .Diagnostics || s.has(Stored.Obj, okey)
    }

    /// ONE FILE'S HOLD, as this package's derivation under `want` decided it:
    /// held, or read with why — and for a file nothing kept stands in for,
    /// which of its rows the store is missing.
    fn hold_report(want: Want) -> Result<List<FileHold>, string> {
        let d = self.derived(null, want)?
        let ws = d.program.ws
        [ws.file_hold(d, fi.path, fi.id) for fi in ws.decls.all_files()]
    }

    fn file_hold(d: Derived, path: string, f: FileId) -> FileHold {
        if self.is_held(f) { return FileHold { path: path, held: true, why: null, missing: [], moved: [] } }
        let why: Reads? = d.read.find(it.path == path)?.why
        let unkept = why != null && why! is .Unkept
        let missing = if unkept { self.missing_rows(d.store, self.held_okey(d.store, path), d.want) } else { [] }
        FileHold {
            path: path,
            held: false,
            why: why,
            missing: missing,
            moved: self.parts_moved_at(path),
        }
    }

    /// What this build found moved in a file's key: its own parts, then the
    /// modules its module sees.
    fn parts_moved_at(path: string) -> List<PartMoved> {
        let moved = self.hold.moved.get()
        (moved.get(parts_key(path)) ?? [])
            .concat(moved.get(seen_key(self.module_path_of(path).text())) ?? [])
    }

    /// The rows standing in for a file under `want` that the store lacks, by
    /// what each keeps.
    fn missing_rows(store: Store, okey: string, want: Want) -> List<string> {
        let rows = [
            StoreRow { says: "what it said", kept: store.has(Stored.Warn, said_key(okey)) },
            StoreRow {
                says: "what its bodies ask",
                kept: store.has(Stored.Unit, self.asks_key(okey)),
            },
            match want {
                .Diagnostics -> StoreRow { says: "its rule findings", kept: ruled(store, okey) },
                .Binary -> StoreRow { says: "its object", kept: store.has(Stored.Obj, okey) },
            },
        ]
        [r.says for r in rows if !r.kept]
    }

    /// The held files a diagnostics want must read after all: the ones whose
    /// rule findings were never kept, since only a check keeps them.
    fn unruled(store: Store, want: Want) -> List<ReadFile> {
        match want {
            .Diagnostics -> [ReadFile { path: path, why: Reads.Unruled } for path in held_paths(self) if !ruled(store, self.held_okey(store, path))],
            .Binary -> [],
        }
    }

    /// A fresh workspace's attempt — a restart never inherits a hold.
    fn again(at: Attempt) -> Result<Derived, string> {
        // NOT `mut`: `anew`'s own hooks already capture this box
        // (workspace.av's `anew` doc — an identity, never a value).
        let fresh = self.anew()
        fresh.attempted(at)
    }

    /// AN ATTEMPT, TURNED UNTIL IT STANDS: one that finds its question was wrong
    /// names the attempt to make instead, and a fresh workspace makes it.
    fn attempted(at: Attempt) -> Result<Derived, string> {
        match self.tried(at) {
            .Ok(d) -> d,
            .Err(.Again(next)) -> self.again(next with { turned: at.turned + 1 }),
            .Err(.Refused(why)) -> { fail why },
        }
    }

    /// THE DERIVATION, straight through: hold what the store stands in for, read
    /// the rest, lower it, keep what was learned.
    fn tried(at: Attempt) -> Result<Derived, Turn> {
        mut clock = self.marking()
        let store = self.holding(at)?
        at.having_read(self.unruled(store, at.want))?
        clock.mark("load")
        self.admit_all()
        clock.mark("admit")
        let p = self.analysed(at, store)?
        clock.mark("analyze")
        let lo = self.bodies_lowered(at, store, p)?
        clock.mark("lower")
        let said = self.kept(at, store, p, lo)?
        clock.mark("keep")
        self.stood(at, store, p, lo, said, clock.spans)
    }

    /// WHAT THE STORE STANDS IN FOR, settled: every module's record met, every
    /// hold asked, and the host told how much is about to be read — a host that
    /// must not do heavy work where it stands leaves there, having done none.
    /// From here a held file's declarations are minted when something reads them.
    fn holding(at: Attempt) -> Result<Store, Turn> {
        let store = self.opened_store()
        self.attach_store(store)
        // a home is read only when the instantiations are owed
        let homes = if at.homes { self.known_homes(store, at) } else { [] }
        for rf in [ReadFile { path: path, why: Reads.Home } for path in homes].concat(at.parse) { self.hold.forced.put(rf.path, rf.why) }
        if at.hold {
            for m in held_modules(self, store) { load_interface(self, store, m, at.entry, at.want) }
            // a home whose text moved moves what lowers from it: the homes are read from the start
            if !at.homes && self.known_homes(store, at).any((path) -> self.home_moved(store, path)) { fail Turn.Again(at with { homes: true }) }
            self.settle_holds(store)
        }
        self.host.reads_ahead(self.reads_ahead())
        self.hold.holds_settled.set(true)
        store
    }

    /// THE PROGRAM, ANALYSED AND CLEAN — with every file its compile-time runs and
    /// its held asks reach read beside it, or the attempt that reads them.
    fn analysed(at: Attempt, store: Store) -> Result<Program, Turn> {
        let p = self.program(at.entry)
        at.having_read(self.bodies_asked())?
        if !p.clean() { fail Turn.Refused(p.report()) }
        if self.layouts_moved(store, p) { fail at.unheld("a sealed layout moved") }
        at.having_read(self.read_held_asks(store))?
        p
    }

    /// EVERY READ BODY, LOWERED. A parsed const nothing parsed reads is settled
    /// here, while a held body it runs can still send the attempt back. The homes
    /// lowered from are remembered; one that is held all the same is new, and the
    /// next attempt reads it.
    fn bodies_lowered(at: Attempt, store: Store, p: Program) -> Result<Lowered, Turn> {
        let lowered = p.files_checked()
        self.settle_consts(p)
        at.having_read(self.bodies_asked())?
        let lo = or_refused(lowered)?
        remember(
            store,
            homes_key(self.known_as(at)),
            distinct([self.decls.file(f).path for f in lo.homes]),
        )
        if at.homes && lo.homes.any((f) -> self.is_held(f)) { fail Turn.Again(at) }
        lo
    }

    /// WHAT WAS LEARNED, KEPT: the records first — every key folds them — then what
    /// stands in for each read file, whole: what it said, and what its bodies ask.
    fn kept(at: Attempt, store: Store, p: Program, lo: Lowered) -> Result<List<Said>, Turn> {
        let moved = [module_path(name.split(".")) for name in distinct([self.module_of(a.view.source.file) for a in p.files])]
        keep_interfaces(self, store, moved)
        let _ = self.keep_const_units(store, moved)
        let adrift = [path for path in held_paths(self) if !self.stands_in(store, self.held_okey(store, path), at.want)]
        if !adrift.is_empty() { fail at.adrift(adrift) }
        for a in p.files { self.keep_asks(store, lo, a) }
        let said? = self.all_said(store, p, at.want) else { fail at.unheld("what a held file said could not be read") }
        said
    }

    /// What one read file's bodies ask, kept under the file's key.
    fn keep_asks(store: Store, lo: Lowered, a: Analysis) {
        let asks = [k.want for k in lo.asks if same_file(k.by, a.view.file)]
        let _ = store
            .keep_once(
                Stored.Unit,
                self.asks_key(self.held_okey(store, a.view.source.file)),
                self.wanted_list_wire(asks),
            )
    }

    /// THE ATTEMPT THAT STOOD, as the program derived. The instantiations a held
    /// home owes are named, never lowered — and a derivation that owes none is
    /// marked clean.
    fn stood(
        at: Attempt,
        store: Store,
        p: Program,
        lo: Lowered,
        said: List<Said>,
        spans: List<Phase>,
    ) -> Derived {
        let roots = self.hold.held_wants.get().concat([k.want for k in lo.asks])
        let asked = self.asked_print(store, self.known_as(at), roots)
        let unlowered = [w for w in roots if self.is_held(w.file)]
        if unlowered.is_empty() { let _ = store.keep_once(Stored.Unit, clean_key(asked), "") }
        Derived {
            entry: at.entry,
            want: at.want,
            program: p,
            lowered: lo,
            store: store,
            said: said,
            warnings: spoken([p.warned(p.voices)].concat([s.warnings for s in said])),
            unlowered: unlowered,
            asked: asked,
            held: held_paths(self).length,
            files: self.decls.file_count(),
            turns: at.moved,
            turned: at.turned,
            spans: spans,
            read: self.hold.read_files.get(),
        }
    }

    /// What names a program in the store: its entry, or the root it stands under.
    fn known_as(at: Attempt) -> string { at.entry ?? self.root }

    /// The homes this program has lowered from, as the store remembers them.
    fn known_homes(store: Store, at: Attempt) -> List<string> { remembered(store, homes_key(self.known_as(at))) }

    /// How many files this attempt is about to read: the ones it has met and does
    /// not hold — and, for all it can tell, EVERY file when it holds none.
    fn reads_ahead() -> int {
        let held = held_paths(self).length
        if held == 0 { EVERY_FILE } else { self.decls.file_count() - held }
    }

    /// WHETHER A SEALED LAYOUT MOVED UNDER THE HOLD. A seal boxes a flat record from
    /// ANY file, and a held file's seal is not re-met. So a record a held line keeps
    /// flat and this attempt boxed, or one a parsed file's last record kept boxed and
    /// this attempt did not, is a layout the stored objects and this analysis read
    /// two ways — and only the sources whole can say which.
    fn layouts_moved(store: Store, p: Program) -> bool {
        if held_paths(self).is_empty() { return false }
        // peek, not the tracked read: this compares what typing just
        // decided against what the store remembered, after the fact —
        // never the ask a later write must answer to
        if self.hold.held_flat.get().any((t) -> !self.decls.types.peek_flat(t)) { return true }
        p
            .files
            .any(
                (a: Analysis) -> self
                    .kept_boxed(store, a.view.file)
                    .any((d: DeclId) -> !self.decls.types.peek_boxed_flat(self.decls.record_type(d))),
            )
    }

    /// The records of a parsed file its module's last record kept BOXED, as they
    /// are declared now — by name, since an edit moves ordinals.
    fn kept_boxed(store: Store, f: FileId) -> List<DeclId> {
        let path = self.decls.file(f).path
        let found = [boxed_name(parts, path) for parts in record_fields(self, store, self.module_path_of(path))]
        let names = [n! for n in found if n != null]
        [d for d in self.decls.decls_of_file(f) if self.names_record(d, names)]
    }

    fn names_record(d: DeclId, names: List<string>) -> bool {
        let x = self.decl_at(d)
        x.kind is .Record && names.contains(x.name)
    }

    /// Every declared const of every parsed file, settled.
    fn settle_consts(p: Program) {
        for a in p.files {
            for d in self.decls.decls_of_file(a.view.file) {
                let x = self.decl_at(d)
                if x.kind is .Const && !x.nested { let _ = self.settled(x.file, SettleRoot.Const(x.stmt), []) }
            }
        }
    }

    /// THE HELD FILES THIS ATTEMPT ASKED A BODY OF: a compile-time run reached
    /// them, and the next attempt reads them. The file that ran them keeps the
    /// list in its record, so a later derivation reads them with it.
    fn bodies_asked() -> List<ReadFile> { [ReadFile { path: path, why: Reads.BodyAsked } for path in distinct(self.hold.body_asks.get())] }

    /// Whether a remembered home still stands and is no longer the text its
    /// module's record was written from.
    fn home_moved(store: Store, path: string) -> bool {
        if path.is_empty() || !self.host.exists(path) { return false }
        !written_from(
            record_places(self, store, self.module_path_of(path)).get(path),
            self.text_digest(path),
        )
    }

    /// THE HOLDS, SETTLED: every hold asked for, but a file a read file's
    /// compile-time runs read — and what THAT file's runs read, since it runs too.
    /// A CANDIDATE EXCLUDED THIS WAY NAMES WHY, seeded or discovered alike: the
    /// seed already carries its own `RunBy` (record.av's `load_interface`), so
    /// the noting below is the same one the worklist does for what IT finds,
    /// never a second law.
    fn settle_holds(store: Store) {
        // LICENSED compiler.seen_accumulator: a WORKLIST — the list grows while it is walked
        mut reads: List<string> = distinct(self.hold.read_with.get())
        for rf in self.hold.read_seeds.get() {
            if self.hold.hold_asked.get().contains(rf.path) &&
                !self.hold.read_files.get().any(it.path == rf.path) {
                self.hold.read_files.push(rf)
            }
        }
        mut at = 0
        while at < reads.length {
            for path in self.forced_runs(store, reads[at]) {
                if !reads.contains(path) {
                    reads.push(path)
                    if self.hold.hold_asked.get().contains(path) {
                        self
                            .hold
                            .read_files
                            .push(
                                ReadFile {
                                    path: path,
                                    why: Reads.RunBy(relative_path(self.root, reads[at])),
                                },
                            )
                    }
                }
            }
            at = at + 1
        }
        // a held file's row exists before any query reads the relation — minting it
        // parses nothing, and a module walk inside a query then only finds it
        for path in self.hold.hold_asked.get() {
            if !reads.contains(path) {
                self.hold_only(path)
                let _ = self.file_id(path)
            }
        }
    }

    /// WHAT THE PROGRAM'S INSTANTIATIONS ARE A FUNCTION OF: its root asks, and the
    /// key of every home it has lowered from — a home's text, and the interfaces
    /// it sees. An ask a home's own body makes is that home's content. A home the
    /// tree no longer has is gone from the print, so the print moves with it.
    fn asked_print(store: Store, known_as: string, roots: List<Wanted>) -> string {
        let homes = [path for path in sorted_texts(remembered(store, homes_key(known_as))) if !path.is_empty() && self.host.exists(path)]
        digest_of(
            joined(
                sorted_texts(distinct([self.wanted_wire(w) for w in roots]))
                    .concat(["${path}\t${self.held_okey(store, path)}" for path in homes]),
                "\n",
            ),
        )
    }

    /// What every file said, in file order: a parsed file's KEPT, a held file's
    /// as the store kept it — null when a held row cannot be read. A file the
    /// table knows and nothing read said nothing.
    fn all_said(store: Store, p: Program, want: Want) -> List<Said>? {
        mut fresh: Map<string, Spoken> = {}
        for a in p.files { fresh.set(a.view.source.file, self.says(p, a, want)) }
        let said = [self.file_said(store, fi.path, fresh.get(fi.path), want) for fi in self.decls.all_files() if fresh.get(fi.path) != null || self.is_held(fi.id)]
        if said.any(it == null) { return null }
        [s! for s in said]
    }

    /// What a parsed file says now: its warnings, and under a diagnostics want
    /// its rule findings — a build reads no lint.
    fn says(p: Program, a: Analysis, want: Want) -> Spoken {
        let said = Said {
            path: a.view.source.file,
            warnings: p.warned(a.diagnostics),
            cases: [CaseCall { symbol: c.symbol, label: case_words(c) } for c in self.file_cases(a.view.file)],
        }
        let rules: Ruled? = if want is .Diagnostics { ruled_now(p, a, rule_findings(analysed(a), a.view.stmts)) } else { null }
        Spoken { said: said, rules: rules }
    }

    /// A read file's key parts: its own under its path, the modules it sees
    /// under its module — each rewritten only when it moved, and what moved
    /// noted in the hold under the row's key.
    fn keep_parts(store: Store, path: string) {
        let now = self.key_parts_cached(store, self.module_path_of(path), path)
        let own = now with { seen: [] }
        let kept = store.get(Stored.Unit, parts_key(path))
        let was = parts_of(kept ?? "")
        self
            .keep_moved(
                store,
                parts_key(path),
                parts_wire(own),
                if was == null { [] } else { parts_moved(store, self.record_bodies(), was!, own) },
            )
        let seen = store.get(Stored.Unit, seen_key(now.module))
        let seen_was = seen_of(seen ?? "")
        self
            .keep_moved(
                store,
                seen_key(now.module),
                seen_wire(now.seen),
                if seen == null || seen_was == null { [] } else { seen_list_moved(store, self.record_bodies(), seen_was!, now.seen) },
            )
    }

    /// A parts row kept when it moved, what moved noted under its key.
    fn keep_moved(store: Store, key: string, wire: string, moved: List<PartMoved>) {
        if store.get(Stored.Unit, key) == wire { return }
        if !moved.is_empty() { self.hold.moved.put(key, moved) }
        let _ = store.keep(Stored.Unit, key, wire, [])
    }

    /// One file's `Said`: kept under its key when it parsed, read from there
    /// when it did not — its rule findings beside it under a diagnostics want.
    fn file_said(store: Store, path: string, fresh: Spoken?, want: Want) -> Said? {
        let okey = self.held_okey(store, path)
        let told? = fresh else {
            let kept? = store.get(Stored.Warn, said_key(okey)) else { return null }
            let said? = said_of(path, kept) else { return null }
            return held_said(store, okey, said, want)
        }
        let _ = store.keep_once(Stored.Warn, said_key(okey), said_wire(told.said))
        self.keep_parts(store, path)
        let rules? = told.rules else { return told.said }
        let _ = store.keep_once(Stored.Warn, rules_key(okey), rules.rendered)
        let _ = store.keep_once(Stored.Warn, findings_key(okey), rules.rows)
        told.said with { warnings: spoken([told.said.warnings, rules.rendered]) }
    }
}

/// A file's rule findings found now.
fn ruled_now(p: Program, a: Analysis, found: List<Diag>) -> Ruled {
    Ruled { rendered: p.warned(found), rows: file_findings_text(a, found) }
}

/// A `boxed` row's name, when it names `path` — null for every other row.
fn boxed_name(parts: List<string>, path: string) -> string? {
    let row? = read_row(parts) else { return null }
    if row.shape is .Boxed && row.path == path { row.name } else { null }
}

/// A held file's `Said` under `want`: a diagnostics want reads its rule
/// findings beside it, and `stands_in` held it only where they were kept.
fn held_said(store: Store, okey: string, said: Said, want: Want) -> Said? {
    match want {
        .Diagnostics -> {
            let rules? = store.get(Stored.Warn, rules_key(okey)) else { return null }
            said with { warnings: spoken([said.warnings, rules]) }
        },
        .Binary -> said,
    }
}

// ── The voices ──

/// The law on one line: the phrase the cache-attack and hold-sweep tools
/// read, the held attempt's first word of why, and where the rest is kept.
export fn hold_refusal(why: string, at: string) -> string {
    "avra: the hold was refused (${refusal_cause(why)}); built from its sources — the held attempt's words are in ${at}"
}

/// `hold_refusal` for an inspection, which keeps no words: a check keeps them.
export fn hold_refusal_unkept(why: string) -> string {
    "avra: the hold was refused (${refusal_cause(why)}); built from its sources — an inspection keeps nothing, and `avra check` keeps the held attempt's words"
}

/// The held attempt's first line that says anything.
fn refusal_cause(why: string) -> string {
    why.split("\n").find(!it.trim().is_empty())?.trim() ?? "it said nothing"
}

fn nothing_held(why: string) -> string {
    "internal compiler error: ${why}, and nothing was held"
}

fn records_adrift(paths: List<string>) -> string {
    "avra: interface records did not stabilize — still moving under ${joined(paths, ", ")}"
}
