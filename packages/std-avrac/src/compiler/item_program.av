//! A PROGRAM MADE ON THE PROGRAM LAYER, AS THE ENGINES RUN ONE: a program file's entry and every body
//! it reaches, each lowered here, as the bodies the evaluator and the backend consume. Each body is
//! read by its registers' layouts alone: it carries no registry type, and the program's registry is
//! empty. A program not made yet says why, by the first thing it met.
use core.{
    CalledFn,
    CheckedProgram,
    FnWrapper,
    Ins,
    Layout,
    RtKind,
    RtSig,
    SignedType,
    Static,
    TaskChecks,
    extern_row,
    flatten,
    new_type_registry,
    rt_sig_of,
    some_list,
    width_named,
}
use compiler.lower.{Body, Lowered}
use compiler.memory.{memory}
use compiler.backend.{program_closed}
use @std.program.address.{SourceFileAddress}
use @std.program.query_engine.{QueryEngine}

/// A program made on the program layer, or why it isn't yet: the reason, and where it stood.
export enum MadeProgram {
    Made(lowered: Lowered)
    Unmade(reason: string, at: string)
}

/// The program `file` runs: its entry and each body it reaches, lowered, the memory pass applied.
/// Where the entry or a body it reaches links a scheduler, every `while` reads the tick.
export fn made_program(engine: QueryEngine, file: SourceFileAddress) -> MadeProgram {
    let surveyed? = lowered_entry(engine, file, TaskChecks.Surveyed) else { return MadeProgram.Unmade("a file that runs no statement", spelled_file(file)) }
    if !surveyed.whole() { return MadeProgram.Unmade(surveyed.missing[0], "the entry") }
    let checks = if lowered_links(engine, surveyed) { TaskChecks.Scheduled } else { TaskChecks.Tested }
    let entry = lowered_entry(engine, file, checks)!
    if !entry.whole() { return MadeProgram.Unmade(entry.missing[0], "the entry") }
    made_reaching(engine, entry, ENTRY, [])
}

/// The program `root` and each body it reaches make, the memory pass applied: `root` the entry,
/// known as `name` with `seats` its first registers. With `missed`, the walk goes past each body not
/// lowered yet and files it there.
export fn made_reaching(
    engine: QueryEngine,
    root: LoweredFn,
    name: string,
    seats: List<Layout>,
    missed: Cell<List<Missed>>? = null,
) -> MadeProgram {
    mut queue = every_callee_of(root)
    mut fns = lifted_bodies(root)
    mut statics = root.statics
    mut wrappers = root.wrappers
    mut externs: List<RtSig> = []
    mut seen: Map<string, bool> = {}
    mut at = 0
    while at < queue.length {
        let c = queue[at]
        at = at + 1
        if seen.has(c.symbol) { continue }
        seen.set(c.symbol, true)
        if c.external {
            externs = externs.concat(some_list(declared_row(engine, c)))
            continue
        }
        let reached = match reached_fn(engine, c, checks) {
            .Lowered(f) -> f,
            .Not(why) -> {
                let filed? = missed else { return MadeProgram.Unmade(why, c.symbol) }
                filed.push(Missed { symbol: c.symbol, why: why })
                continue
            },
        }
        fns = fns
            .concat(
                [
                    unit_body(
                        c.symbol,
                        reached.params,
                        reached.answer,
                        reached.ins,
                        reached.layouts,
                    ),
                ],
            )
            .concat(lifted_bodies(reached))
        statics = statics.concat(reached.statics)
        wrappers = wrappers.concat(reached.wrappers)
        queue = queue.concat(every_callee_of(reached))
    }
    let filed = missed?.get() ?? []
    if !filed.is_empty() { return MadeProgram.Unmade(filed[0].why, filed[0].symbol) }
    let lowered = Lowered {
        fns: fns.concat([wrapper_body(w) for w in distinct_wrappers(wrappers)]),
        entry: unit_body(name, seats, root.answer, root.ins, root.layouts),
        types: new_type_registry(),
        diagnostics: [],
        externs: externs,
        statics: distinct_statics(statics),
    }
    unanswered(lowered) ?? MadeProgram.Made(memory(lowered))
}

/// A body a program reaches that isn't lowered yet: its symbol, and why.
export type Missed = { symbol: string, why: string }

/// A body a program reaches, lowered, or why it isn't.
enum ReachedFn {
    Lowered(f: LoweredFn)
    Not(why: string)
}

/// The body a call of `c` runs, lowered whole testing what `checks` says: the fn's, a method's or a
/// static's, the body a trait gives a type that never writes the method, or a field's default, each
/// a generic one's unit under its layouts.
fn reached_fn(engine: QueryEngine, c: CalledFn, checks: TaskChecks) -> ReachedFn {
    let f? = reached_body(engine, c, checks) else { return ReachedFn.Not("a call of a fn with no body here") }
    if !f.whole() { return ReachedFn.Not(f.missing[0]) }
    ReachedFn.Lowered(f)
}

/// The body a call of `c` runs, lowered testing what `checks` says; absent where its declaration
/// gives none.
fn reached_body(engine: QueryEngine, c: CalledFn, checks: TaskChecks) -> LoweredFn? {
    if c.defaulted { return lowered_field_default(engine, c.file, c.owner!, c.name, checks) }
    let under = if c.parameters.is_empty() { null } else { c.parameters }
    let of? = c.of else { return lowered_under(engine, c.file, c.name, under, checks) }
    if c.given_by != null { return lowered_default(engine, of, c.owner!, c.name, checks) }
    let at? = impls_with(engine, of, c.owner!, c.name, c.statics).first() else { return null }
    lowered_method_under(engine, at, c.name, c.statics, under, checks)
}

/// The row C answers the extern `c` by: each seat and the answer at the width it writes, else as its
/// type is to C. Absent for a runtime row's own name, which the row answers, and an extern with a
/// seat or answer no one word carries.
fn declared_row(engine: QueryEngine, c: CalledFn) -> RtSig? {
    if rt_sig_of(c.symbol) != null { return null }
    let sig? = fn_signature(engine, c.file, c.name) else { return null }
    let program = program_of(
        engine,
        c.file,
        Signing { engine: engine, file: c.file, type_params: [] },
    )
    let params = [crossing_kind(program, p.ty, p.width) for p in sig.params]
    let answer? = crossing_kind(program, sig.answer, sig.answer_width) else { return null }
    if params.any(it == null) { null } else { extern_row(c.symbol, answer, [k! for k in params]) }
}

/// The kind a value of `ty` crosses to C as: the width its seat writes, else what its layout is to C.
/// Absent for a value no one word carries.
fn crossing_kind(program: CheckedProgram, ty: SignedType?, width: string?) -> RtKind? {
    if width != null { return width_named(width!) }
    let t? = ty else { return null }
    let l? = program.layout(t) else { return null }
    match l {
        .Void -> RtKind.Void,
        .Real -> RtKind.F64,
        .Word or .Truth -> RtKind.I64,
        .Boxed(_) or .Bare -> RtKind.Ptr,
        .Fields(_) or .Tagged(_) or .Maybe(_) -> null,
    }
}

/// The fns a lowered body and the lambdas it lifts call.
fn every_callee_of(f: LoweredFn) -> List<CalledFn> { f.callees.concat(flatten([l.callees for l in f.lifts])) }

/// The lambdas a lowered body lifts, each a body of its own.
fn lifted_bodies(f: LoweredFn) -> List<Body> { [unit_body(l.symbol, l.params, l.answer, l.ins, l.layouts) for l in f.lifts] }

/// A unit as a body: its seats the first registers, read by their layouts.
fn unit_body(
    name: string,
    seats: List<Layout>,
    answer: Layout,
    ins: List<Ins>,
    layouts: List<Layout>,
) -> Body {
    Body {
        name: name,
        params: [],
        ret: new_type_registry().type(void),
        gives: null,
        ins: ins,
        reg_types: [],
        layouts: layouts,
        seats: seats,
        answer: answer,
    }
}

/// A fn value's wrapper as a body: the box and the fn's seats its first registers.
fn wrapper_body(w: FnWrapper) -> Body { unit_body(w.symbol, [w.box].concat(w.seats), w.answer, w.ins(), w.layouts()) }

/// Each wrapper once, by its symbol.
fn distinct_wrappers(wrappers: List<FnWrapper>) -> List<FnWrapper> {
    mut by: Map<string, FnWrapper> = {}
    for w in wrappers { if !by.has(w.symbol) { by.set(w.symbol, w) } }
    by.values()
}

/// Each static once, by its name.
fn distinct_statics(statics: List<Static>) -> List<Static> {
    mut by: Map<string, Static> = {}
    for s in statics { if !by.has(s.name) { by.set(s.name, s) } }
    by.values()
}

/// Why the program isn't run yet though every body lowered whole, absent when it is: a name no body,
/// runtime row or extern answers.
fn unanswered(l: Lowered) -> MadeProgram? {
    let open? = program_closed(l) else { return null }
    MadeProgram.Unmade("a name no lowered body, row or extern answers", open)
}
