//! A PROGRAM MADE ON THE PROGRAM LAYER, AS THE ENGINES RUN ONE: a program file's entry and every body
//! it reaches, each lowered here, as the bodies the evaluator and the backend consume. Each body is
//! read by its registers' layouts alone: it carries no registry type, and the program's registry is
//! empty. A program not made yet says why, by the first thing it met.
use core.{
    BinOp,
    reach_words,
    row_has,
    BoxKind,
    CalledFn,
    code_hash_symbol,
    code_hash_target,
    qtrace,
    traced,
    Level,
    rt_sigs,
    CheckedProgram,
    FnWrapper,
    Ins,
    Layout,
    Reg,
    RtKind,
    RtSig,
    SignedType,
    Span,
    Static,
    TaskChecks,
    flatten,
    inout_row,
    grouped_by,
    new_type_registry,
    rt_sig_of,
    some_list,
    width_named,
    digest_of,
    fp_str,
    ParameterLayout,
    LiftedBody,
    Noted,
    TestSite,
    notes_kept,
    body_symbol,
    hosted_symbol,
    static_code_syms,
    sorted_by,
    distinct,
}
use compiler.lower.{Body, DeferredFn, Lowered}
use compiler.lower.code_hash.{
    CodeFacts,
    CodeReading,
    FactNode,
    TargetHash,
    any_value_node,
    code_facts_from_wire,
    code_facts_wire,
    code_graph,
    graph_refs,
    guards_of,
    hashes_read,
    node_digest,
    summed_hash,
    with_digest,
    read_code_facts,
    value_node_of,
    values_node,
}
use compiler.memory.{memory, memory_late}
use compiler.backend.{Owned, WasmCall, body_lines, in_symbol_order, program_closed, program_opens}
use @std.program.address.{SourceFileAddress}
