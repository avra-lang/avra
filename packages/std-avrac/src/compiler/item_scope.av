//! WHAT A FILE'S TOP LEVEL SEES, under one law: a name binds once. A module's declarations bind in
//! file then declaration order; the first binder of a name in a space wins and every later one
//! clashes — except a private name two files each declare, which each keeps apart: each file sees
//! its own and no sibling sees either. A file sees its own kept-apart names and its imports, then
//! its module's winners, then the prelude's exports where nothing else took the name. Values, types
//! and sublanguages are spaces apart. A file's scope holds only what is its own; the rest is read
//! by name where it stands.
use core.{distinct}
use @std.meta.{derive}
use @std.program.address.{SourceFileAddress}
use @std.program.query_engine.{QueryDefinition, QueryEngine}
use @std.program.saved_derive.{Saved}
use @std.program.answer_parts.{AnswerParts, NamedValue, answer_parts}
use @std.program.source_facts.{source_text}
use @std.program.saved_query.{ListedQuery, definitions_of, parted_query, query, query_definition}

/// Where a name binds.
@derive(Saved)
export enum Space {
    Value
    Type
    Syntax
}

/// The space a kind of declaration binds its name in.
export fn space_of(kind: ItemKind) -> Space {
    match kind {
        .Fn or .Const or .Collect or .State -> Space.Value,
        .Record or .Enum or .Named or .Alias or .Trait or .Component or .CollectEnum -> Space.Type,
        .Syntax -> Space.Syntax,
    }
}

/// Names bound in each space.
@derive(Saved)
export type Bound = { values: Map<string, DeclaredName>, types: Map<string, DeclaredName>, syntaxes: Map<string, DeclaredName> }

fn nothing_bound() -> Bound { Bound { values: {}, types: {}, syntaxes: {} } }

impl Bound {
    /// The declaration `name` is bound to in `space`.
    fn held(space: Space, name: string) -> DeclaredName? {
        match space {
            .Value -> self.values.get(name),
            .Type -> self.types.get(name),
            .Syntax -> self.syntaxes.get(name),
        }
    }

    /// Every name bound in `space`.
    fn names_in(space: Space) -> List<string> {
        match space {
            .Value -> self.values.keys(),
            .Type -> self.types.keys(),
            .Syntax -> self.syntaxes.keys(),
        }
    }

    /// `name` bound to `d` in `space`.
    mut fn bind(space: Space, name: string, d: DeclaredName) {
        match space {
            .Value -> self.values.set(name, d),
            .Type -> self.types.set(name, d),
            .Syntax -> self.syntaxes.set(name, d),
        }
    }
}

/// A declaration that lost its name to another, the module's or an import's.
@derive(Saved)
export type NameClash = { lost: DeclaredName, holder: DeclaredName, imported: bool }

/// A module's names bound: the winners its files share, the private names its files keep apart, and
/// every declaration that lost.
@derive(Saved)
export type ModuleBindings = { shared: Bound, apart: List<DeclaredName>, clashes: List<NameClash> }

@query
export fn module_bindings(engine: QueryEngine, package: string, local: List<string>, as_root: bool) -> ModuleBindings {
    mut held = nothing_bound()
    mut apart: List<DeclaredName> = []
    mut clashes: List<NameClash> = []
    for d in module_names(engine, module_files(engine, package, local, as_root)) {
        let space = space_of(d.kind)
        let prior? = held.held(space, d.name) else {
            held.bind(space, d.name, d)
            continue
        }
        let own = apart
            .find((a) -> same_file(a.file, d.file) && a.name == d.name && space_of(a.kind) == space) ?? prior
        if kept_apart(own, d) {
            if !apart.any(it.is(prior)) { apart.push(prior) }
            apart.push(d)
        } else {
            clashes.push(NameClash { lost: d, holder: own, imported: false })
        }
    }
    ModuleBindings { shared: without(held, apart), apart: apart, clashes: clashes }
}

/// Whether two declarations of one name are each their own file's: both private, in different files.
fn kept_apart(a: DeclaredName, b: DeclaredName) -> bool { !a.exported && !b.exported && !same_file(a.file, b.file) }

/// `held` with every kept-apart declaration taken out.
fn without(held: Bound, apart: List<DeclaredName>) -> Bound {
    mut shared = nothing_bound()
    for name, d in held.values { if !apart.any(it.is(d)) { shared.values.set(name, d) } }
    for name, d in held.types { if !apart.any(it.is(d)) { shared.types.set(name, d) } }
    for name, d in held.syntaxes { if !apart.any(it.is(d)) { shared.syntaxes.set(name, d) } }
    shared
}

/// A module's shared winners, one part per name, each holding that name's winner in every space it
/// binds in, so a reader of one name stands when another moves.
@parted_query
export fn module_winners(engine: QueryEngine, package: string, local: List<string>, as_root: bool) -> AnswerParts {
    let shared = module_bindings(engine, package, local, as_root).shared
    parts_by_name(
        shared.values.values().concat(shared.types.values()).concat(shared.syntaxes.values()),
    )
}

/// The winner `file`'s module shares for `name` in `space`, absent for none.
fn winner(engine: QueryEngine, file: SourceFileAddress, space: Space, name: string) -> DeclaredName? {
    declarations_in(
        module_winners_part(engine, file.package_name, module_segments(file), true, name),
    )
        .find(space_of(it.kind) == space)
}

/// What a module keeps apart of its shared winners: the private names its files keep apart, and
/// every declaration that lost.
@derive(Saved)
type ModuleKept = { apart: List<DeclaredName>, clashes: List<NameClash> }

@query
fn module_kept(engine: QueryEngine, package: string, local: List<string>, as_root: bool) -> ModuleKept {
    let bindings = module_bindings(engine, package, local, as_root)
    ModuleKept { apart: bindings.apart, clashes: bindings.clashes }
}

/// What is a file's own at its top level: its kept-apart names and its imports (`own`); its
/// siblings' kept-apart names, which a read of here is refused with; and each of its declarations
/// and imports that lost its name. Its module's shared winners and the prelude are read where they
/// stand (`resolved`).
@derive(Saved)
export type FileScope = { own: Bound, siblings: List<DeclaredName>, clashes: List<NameClash> }

/// What is `file`'s own at its top level; absent for a file that isn't there.
@query
export fn file_scope(engine: QueryEngine, file: SourceFileAddress) -> FileScope? {
    if source_text(engine, file) == null { return null }
    let module = module_kept(engine, file.package_name, module_segments(file), true)
    mut own = nothing_bound()
    for d in module.apart { if same_file(d.file, file) { own.bind(space_of(d.kind), d.name, d) } }
    mut clashes: List<NameClash> = []
    for u in file_words(engine, file).uses {
        let at? = imported_module(engine, file, u) else { continue }
        let privately = tests_of(file, at)
        for j, item in u.items {
            for d in declarations_of(engine, at.package, at.local, at.as_root, item) {
                if !d.exported && !privately { continue }
                let clash = imported(engine, own, file, u.bound_as(j), d)
                if clash != null { clashes.push(clash!) } else { own.bind(space_of(d.kind), u.bound_as(j), d) }
            }
        }
    }
    FileScope {
        own: own,
        siblings: [d for d in module.apart if !same_file(d.file, file)],
        clashes: [c for c in module.clashes if same_file(c.lost.file, file)].concat(clashes),
    }
}

/// The clash an import of `d` as `name` makes, absent when it binds: a name already this file's, or
/// its module's export or its own, clashes unless it's that very declaration; a sibling's private
/// one it shadows.
fn imported(engine: QueryEngine, own: Bound, file: SourceFileAddress, name: string, d: DeclaredName) -> NameClash? {
    let space = space_of(d.kind)
    let prior? = own.held(space, name) ?? claimed(engine, file, space, name) else { return null }
    if prior.is(d) { return null }
    NameClash { lost: d, holder: prior, imported: true }
}

/// The module's holder of a name as `file` sees it claimed: an export, or this file's own.
fn claimed(engine: QueryEngine, file: SourceFileAddress, space: Space, name: string) -> DeclaredName? {
    let d? = winner(engine, file, space, name) else { return null }
    if d.exported || same_file(d.file, file) { d } else { null }
}

/// The prelude's export `file` sees as `name` in `space` where nothing else took it; a file of
/// the prelude sees none.
fn lent(engine: QueryEngine, file: SourceFileAddress, space: Space, name: string) -> DeclaredName? {
    if file.package_name == PRELUDE { return null }
    declarations_of(engine, PRELUDE, [], false, name).find(lends(it, space))
}

/// Whether the prelude lends `d` in `space`: it's exported there.
fn lends(d: DeclaredName, space: Space) -> bool { d.exported && space_of(d.kind) == space }

/// Whether `file` stands directly in the `tests/` of the module `at` names, so its imports read that
/// module's private names too.
fn tests_of(file: SourceFileAddress, at: ModuleAt) -> bool {
    let module = module_segments(file)
    at.package == file.package_name &&
        module.last() == TESTS &&
        module.take(module.length - 1).join(".") == at.local.join(".")
}

/// The directory a module's own tests stand in.
const TESTS: string = "tests"

/// The package every file sees without a `use`.
const PRELUDE: string = "@std/prelude"

/// What `name` names in `space` from `file`'s top level, absent for nothing: the file's own, else
/// its module's shared winner, else the prelude's. One question per name, so what reads a name
/// depends on that name alone.
@query
export fn resolved(engine: QueryEngine, file: SourceFileAddress, space: Space, name: string) -> DeclaredName? {
    let scope? = file_scope(engine, file) else { return null }
    resolved_in(engine, scope, file, space, name)
}

/// What `name` names in `space` from the top level of `file`, whose scope is `scope`.
export fn resolved_in(
    engine: QueryEngine,
    scope: FileScope,
    file: SourceFileAddress,
    space: Space,
    name: string,
) -> DeclaredName? {
    scope.own.held(space, name) ?? winner(engine, file, space, name) ?? lent(
        engine,
        file,
        space,
        name,
    )
}

/// Every name the top level of `file`, whose scope is `scope`, sees in `space`, each once: its own,
/// its module's shared winners, then the prelude's exports.
export fn seen_names(engine: QueryEngine, scope: FileScope, file: SourceFileAddress, space: Space) -> List<
    string,
> {
    let shared = module_bindings(engine, file.package_name, module_segments(file), true).shared
    let prelude = if file.package_name == PRELUDE { [] } else { module_names(engine, module_files(engine, PRELUDE, [], false)) }
    distinct(
        scope
            .own
            .names_in(space)
            .concat(shared.names_in(space))
            .concat([d.name for d in prelude if lends(d, space)]),
    )
}

collect listed_scope_facts: List<ListedQuery> = @query_definition in self as ListedQuery { definition: it } by it.name

/// The queries a file's scope reads through, for a process to hand its engine.
export fn scope_fact_definitions() -> List<QueryDefinition> { definitions_of(listed_scope_facts) }

/// Whether two addresses name one file.
fn same_file(a: SourceFileAddress, b: SourceFileAddress) -> bool { a.package_name == b.package_name && a.path_in_package == b.path_in_package }
