//! WHAT A PROGRAM READS OF ITS CONTEXTS, read off its lowered code: a body reads a context where it
//! reads its key with no set of that key in force, itself or through what it calls — a call, a lambda
//! or a fn taken as a value where it is made, which runs under the frame in force there, and a call
//! through a `dyn` box, which may be any type the program boxes there, so it reads what each of their
//! methods of that name reads. A set is in force from its instruction to its back; a branch's or a
//! loop's sets end with it. A recursion settles by asking again until no body reads more.
//!
//! Two laws read it: a required context (one declared with no default) the program reaches with
//! nothing setting it is refused where the program starts, naming how it is reached; and a set
//! nothing in force under it reads is said, since it changes nothing.
use @std.meta.{derive}
use @std.program.address.{SourceFileAddress}
use @std.program.query_engine.{QueryDefinition, QueryEngine}
use @std.program.saved_derive.{Saved}
use @std.program.saved_query.{ListedQuery, cut_query, definitions_of, query_definition}
use core.{
    Shapes,
    STATIC_FN,
    Span,
    BoxMark,
    ContextMarks,
    CalledFn,
    DynMark,
    Ins,
    Reg,
    SignedType,
    StmtId,
    SyntaxArena,
    flatten,
    some_list,
}
use compiler.laws.{Found, law}
use diagnostics.{Voice}
use features.ctxs.{context_required, context_set_unread, context_cached}

/// A context a body reads with nothing in it setting it first: its key, the bodies the read is reached
/// through from the body asked, outermost first, and the `dyn` call it crosses, where one does.
type CtxRead = { key: int, chain: List<string>, through: Through? = null }

/// A `dyn` call a read crosses: the box's type, and the type a box there may hold whose method reads.
type Through = { subject: string, held: string, placed: bool = false }

/// A set in force while a body is walked: its key, and the statement that wrote it.
type InForce = { key: int, stmt: int }

/// A survey of the program `package` that has walked every entry of it: every fn value and `dyn`
/// box the program makes is known to it before it walks one body alone.
fn program_survey(engine: QueryEngine, package: string) -> ReadSurvey {
    let survey = read_survey(engine, package)
    for f in program_files(engine, package) {
        if f.package_name != package { continue }
        let e? = entry_plain(engine, f) else { continue }
        let _ = survey.settled(e)
    }
    survey
}

/// A survey that knows every fn value and `dyn` box the program the file `file` stands in makes. A
/// file that runs is a program of its own — a package's test program is one — so its own entry is
/// all it is walked from; any other is read by the programs of its package, each walked.
fn file_survey(engine: QueryEngine, file: SourceFileAddress) -> ReadSurvey {
    if !item_ids(engine, file).any(item_said(engine, file, it).runs) { return program_survey(engine, file.package_name) }
    let survey = read_survey(engine, file.package_name)
    let e? = entry_plain(engine, file) else { return survey }
    let _ = survey.settled(e)
    survey
}

/// What one walk of a body found: the reads it owes its caller, and the statements of the sets it
/// makes that something under them read.
type Walked = { reads: List<CtxRead>, used: List<int> }

/// The most rounds a survey asks again before it stands on what it has.
const ROUNDS: int = 8

/// One survey's working set over the program `package`: each body's reads by its symbol, the bodies
/// being walked, the `dyn` boxes the program makes as far as the walk has met them, and whether a
/// round met a body it was still walking or a box it hadn't met. Nothing in it is saved.
type ReadSurvey = {
    engine: QueryEngine,
    package: string,
    memo: Cell<Map<string, List<CtxRead>>>,
    before: Cell<Map<string, List<CtxRead>>>,
    met_calls: Cell<List<CalledFn>>,
    /// The symbols of `met_calls`, the bodies being walked, and the symbols of `values`, each a set: a
    /// body is met, opened and taken as a value once however often it is reached, and asking costs one
    /// look.
    met_seen: Cell<Map<string, bool>>,
    open_seen: Cell<Map<string, bool>>,
    value_seen: Cell<Map<string, bool>>,
    values: Cell<List<CalledFn>>,
    lambdas: Cell<List<LiftRead>>,
    rehoming: Cell<bool>,
    boxes: Cell<List<BoxMark>>,
    unsettled: Cell<bool>,
}

/// A set of symbols holding none.
fn seen() -> Map<string, bool> { {} }

fn read_survey(engine: QueryEngine, package: string) -> ReadSurvey {
    let none: Map<string, List<CtxRead>> = {}
    let made: List<BoxMark> = []
    let called: List<CalledFn> = []
    let valued: List<CalledFn> = []
    let lifted: List<LiftRead> = []
    ReadSurvey {
        engine: engine,
        package: package,
        memo: Cell.new(none),
        before: Cell.new(none),
        met_calls: Cell.new(called),
        met_seen: Cell.new(seen()),
        open_seen: Cell.new(seen()),
        value_seen: Cell.new(seen()),
        values: Cell.new(valued),
        lambdas: Cell.new(lifted),
        rehoming: Cell.new(false),
        boxes: Cell.new(made),
        unsettled: Cell.new(false),
    }
}

impl ReadSurvey {
    /// What `f` reads, walked until no round meets more: each round asks every body afresh, a body
    /// still being walked answering what the round before found.
    fn settled(f: LoweredFn) -> Walked {
        self.met(made_in(f))
        mut walked = self.walk(f.ins, f, f.marks)
        mut round = 1
        while self.unsettled.get() && round < ROUNDS {
            self.before.set(self.memo.get())
            self.memo.set({})
            self.unsettled.set(false)
            walked = self.walk(f.ins, f, f.marks)
            round = round + 1
        }
        walked
    }

    /// What a call of `c` reads; a body still being walked answers what is known of it.
    fn reads_of(c: CalledFn) -> List<CtxRead> {
        let kept = self.memo.get().get(c.symbol)
        if kept != null { return kept! }
        if self.open_seen.get().get(c.symbol) ?? false {
            self.unsettled.set(true)
            return self.before.get().get(c.symbol) ?? []
        }
        let body? = reached_body(self.engine, c) else { return [] }
        if !self.met_seen.get().has(c.symbol) {
            self.met_seen.put(c.symbol, true)
            self.met_calls.push(c)
        }
        self.open_seen.put(c.symbol, true)
        self.met(made_in(body))
        let reads = shortest_each(self.walk(body.ins, body, body.marks).reads)
        self.open_seen.put(c.symbol, false)
        self.memo.put(c.symbol, reads)
        reads
    }

    /// `boxes` among the `dyn` boxes the program makes; a round that meets one it hadn't is
    /// unsettled, since a `dyn` call walked before may hold one of them.
    fn met(boxes: List<BoxMark>) {
        let known = self.boxes.get()
        let new = [b for b in boxes if !known.any((k) -> same_box(k, b))]
        if new.is_empty() { return }
        self.boxes.set(known.concat(new))
        self.unsettled.set(true)
    }

    /// `c` among the declared fns the program takes as values; a round that meets one it hadn't is
    /// unsettled, since a call through a fn value walked before may be it.
    fn valued(c: CalledFn) {
        if self.value_seen.get().has(c.symbol) { return }
        self.value_seen.put(c.symbol, true)
        self.values.push(c)
        self.unsettled.set(true)
    }

    /// What a value the code `code` names, made where `owner`'s instruction makes it under the sets
    /// `force`, owes there. A lambda `owner` lifts runs under the frame it is made under laid over
    /// the one it is called under: what its body reads that a set in force here answers is read
    /// here, and what none does is read where it is called, so it owes that at its calls — save a
    /// task's body, which runs from no frame but its spawn's, and owes all it reads here. A declared
    /// fn taken as a value runs under the frame of whoever calls it, so it owes nothing here and is
    /// kept among the program's fn values.
    fn made_value(owner: LoweredFn, code: string, force: List<InForce>) -> Walked {
        let lift? = owner.lifts.find(it.symbol == code) else { return self.made_named(owner, code) }
        let inner = self.walk(lift.ins, owner, lift.marks)
        if inner.reads.is_empty() || lift.site != null { return inner }
        let unmet = [r for r in inner.reads if !force.any(it.key == r.key)]
        self.lifted(lift.symbol, inner.reads, unmet, lift.params.length - 1)
        inner with { reads: [r for r in inner.reads if force.any(it.key == r.key)] }
    }

    /// What a declared fn the code `code` names, taken as a value where `owner` makes it, owes there:
    /// nothing, since it runs under the frame of whoever calls it; it is kept among the program's fn
    /// values.
    fn made_named(owner: LoweredFn, code: string) -> Walked {
        let target = owner.wrappers.find(it.symbol == code)?.target ?? code
        let c = callee_named(owner, target)
        if c != null { self.valued(c!) }
        NOTHING_WALKED
    }

    /// The lambda lifted as `symbol`, reading `reads`, `unmet` of them set nowhere it is made, among the
    /// program's lambdas that read a context; a round that meets one it hadn't is unsettled, since a
    /// call through a fn value walked before may be it.
    fn lifted(symbol: string, reads: List<CtxRead>, unmet: List<CtxRead>, arity: int) {
        let known = self.lambdas.get()
        if known.any(it.symbol == symbol) { return }
        self
            .lambdas
            .set(
                known
                    .concat([LiftRead { symbol: symbol, reads: reads, unmet: unmet, arity: arity }]),
            )
        self.unsettled.set(true)
    }

    /// What any lambda the program makes reads: what a fn value rehomed where it is called may read.
    fn rehomed_reads() -> List<CtxRead> { flatten([l.reads for l in self.lambdas.get()]) }

    /// What a call through a fn value of `arity` seats may read where it is called: what any declared
    /// fn of that many the program takes as a value reads; what any lambda of that many reads that its
    /// making doesn't set; and, in a program that rehomes a handler, what any such lambda reads, since
    /// a rehomed one's making frame is its placement's. A value of another arity never runs there.
    fn called_value_reads(arity: int) -> List<CtxRead> {
        let fitting = [l for l in self.lambdas.get() if l.arity == arity]
        let lambdas = if self.rehoming.get() { flatten([l.reads for l in fitting]) } else { flatten([l.unmet for l in fitting]) }
        self.value_reads(arity).concat(lambdas)
    }

    /// What the placed boxes of the body marked `marks` owe at its instruction `at`: a box of a placed
    /// trait made there, what each of its methods reads; a box of one placed there, what each method of
    /// every box of its trait the program makes reads.
    fn placed_heard(marks: ContextMarks, at: int) -> List<CtxRead> {
        let made = [r for b in marks.boxes if b.placed && b.at == at for r in self.box_reads(b)]
        let joined = [r for p in marks.placings if p.at == at for b in self.boxes.get() if b.placed && b.into.same_type(p.subject) for r in self.box_reads(b)]
        made.concat(joined)
    }

    /// The program rehomes a handler; a round that learns it is unsettled, since a call through a fn
    /// value walked before may run one.
    fn rehomes() {
        if self.rehoming.get() { return }
        self.rehoming.set(true)
        self.unsettled.set(true)
    }

    /// What the methods of the box `b` read, each reached through the type it holds.
    fn box_reads(b: BoxMark) -> List<CtxRead> {
        [r with { chain: [m.name].concat(r.chain), through: r.through ?? Through { subject: b.into.spelled(), held: b.held.spelled(), placed: true } } for m in b.methods for r in self.reads_of(m)]
    }

    /// What a call through a fn value of `arity` seats may read: what any declared fn of that many the
    /// program takes as a value reads, each reached through itself — a lambda's own reads were owed
    /// where it was made. A value whose arity isn't known is taken as fitting.
    fn value_reads(arity: int) -> List<CtxRead> {
        [r with { chain: [v.name].concat(r.chain) } for v in self.values.get() if self.fits(v, arity) for r in self.reads_of(v)]
    }

    /// Whether the declared fn `v` may run at a call through a fn value of `arity` seats.
    fn fits(v: CalledFn, arity: int) -> bool {
        let body? = reached_body(self.engine, v) else { return true }
        body.params.length == arity
    }

    /// What the call through a `dyn` box `d` may read: what the method in its slot of each box of its
    /// trait the program makes reads (rule (i)), reached through the type that holds it.
    fn dyn_reads(d: DynMark) -> List<CtxRead> {
        [r with { chain: [m.callee.name].concat(r.chain), through: r.through ?? Through { subject: d.subject.spelled(), held: m.held } } for m in self.held_methods(d.subject, d.slot) for r in self.reads_of(m.callee)]
    }

    /// The method each `dyn` box of `subject` the program makes holds in the trait's slot `slot`, with
    /// the type of the value it holds: what a call through such a box at that slot may run.
    fn held_methods(subject: SignedType, slot: int) -> List<HeldMethod> {
        [HeldMethod { callee: b.methods[slot], held: b.held.spelled() } for b in self.boxes.get() if b.into.same_type(subject) && slot < b.methods.length]
    }

    /// One walk of the instructions `ins` of the body `owner`, its marks `marks`, from no set in force.
    fn walk(ins: List<Ins>, owner: LoweredFn, marks: ContextMarks) -> Walked {
        let consts = ints_of(ins)
        mut force: List<InForce> = []
        mut saved: List<List<InForce>> = []
        mut owing = NOTHING_WALKED
        for i, x in ins {
            owing = owed(owing, force, self.placed_heard(marks, i))
            if marks.rehomes.contains(i) {
                self.rehomes()
                owing = used_by(owing, force, self.rehomed_reads())
            }
            mut heard: List<CtxRead> = []
            match x {
                .CallRtVoid(row, args) -> {
                    if row == SET_ROW && args.length > 0 {
                        force = force
                            .concat(
                                [
                                    InForce {
                                        key: int_at(consts, args[0]),
                                        stmt: set_stmt(marks, i),
                                    },
                                ],
                            )
                    } else if row == BACK_ROW && !force.is_empty() {
                        force = force.take(force.length - 1)
                    }
                },
                .CallRt(_, row, args) -> {
                    if row == READ_ROW && args.length > 0 { heard = [CtxRead { key: int_at(consts, args[0]), chain: [] }] }
                },
                .Call(_, callee, _) -> {
                    let c? = callee_named(owner, callee) else { continue }
                    heard = [r with { chain: [c.name].concat(r.chain) } for r in self.reads_of(c)]
                },
                .FnAddr(_, sym) -> {
                    let inner = self.made_value(owner, sym, force)
                    owing = owing with { used: owing.used.concat(inner.used) }
                    heard = inner.reads
                },
                .StaticAddr(_, sym) -> {
                    if !sym.starts_with(STATIC_FN) { continue }
                    let inner = self
                        .made_value(owner, sym.substring(STATIC_FN.length, sym.length), force)
                    owing = owing with { used: owing.used.concat(inner.used) }
                    heard = inner.reads
                },
                .CallPtr(dst, _, args) -> {
                    let d = marks.dyns.find(it.dst == dst.index)
                    heard = when {
                        d == null -> self.called_value_reads(args.length - 1)
                        d!.placed -> []
                        _ -> self.dyn_reads(d!)
                    }
                },
                .IfStart(_) or .SwitchStart(_, _) or .LoopStart -> { saved = saved.concat([force]) },
                .ArmEnd(_) -> { force = saved.last() ?? [] },
                .RegionEnd(_, _) or .LoopEnd -> {
                    force = saved.last() ?? []
                    saved = saved.take(max(saved.length - 1, 0))
                },
                rest -> nothing_heard(),
            }
            owing = owed(owing, force, heard)
        }
        owing
    }
}

/// A walk that met nothing: no read owed, no set used.
const NOTHING_WALKED: Walked = Walked { reads: [], used: [] }

/// `w` with the reads `heard` owed under the sets `force`: a read a set in force answers marks that
/// set used, and any other is owed to the caller, once per context.
fn owed(w: Walked, force: List<InForce>, heard: List<CtxRead>) -> Walked {
    if heard.is_empty() { return w }
    mut reads = w.reads
    mut used = w.used
    for r in heard {
        let held = force.filter(it.key == r.key).last()
        if held != null {
            used = used.concat([held!.stmt])
        } else if !reads.any(it.key == r.key) {
            reads = reads.concat([r])
        }
    }
    Walked { reads: reads, used: used }
}

/// A lambda the program makes that reads a context: the symbol it lifts as, what it reads, and what of
/// that nothing in force where it is made sets.
/// `reads` with one read for each context and the `dyn` call it crosses: the one reached by the
/// shortest chain. A cycle walked again adds a longer way to a read it already has, never a new read.
fn shortest_each(reads: List<CtxRead>) -> List<CtxRead> {
    mut kept: Map<string, int> = {}
    mut out: List<CtxRead> = []
    for r in reads {
        let k = "${r.key}|${r.through?.subject ?? ""}|${r.through?.held ?? ""}"
        let at? = kept.get(k) else {
            kept.set(k, out.length)
            out = out.concat([r])
            continue
        }
        if r.chain.length < out[at].chain.length { out.set(at, r) }
    }
    out
}

type LiftRead = { symbol: string, reads: List<CtxRead>, unmet: List<CtxRead>, arity: int }

/// `w` with each set in force under `force` that answers one of `heard` marked used; nothing owed.
fn used_by(w: Walked, force: List<InForce>, heard: List<CtxRead>) -> Walked {
    let met = [r for r in heard if force.any(it.key == r.key)]
    owed(w, force, met)
}

/// What an instruction that says nothing of contexts does to a walk.
fn nothing_heard() {}

/// The `dyn` boxes `f` and the lambdas it lifts make.
fn made_in(f: LoweredFn) -> List<BoxMark> { f.marks.boxes.concat(flatten([l.marks.boxes for l in f.lifts])) }

/// Whether two boxes are one: of one type, over values of one type.
fn same_box(a: BoxMark, b: BoxMark) -> bool { a.into.same_type(b.into) && a.held.same_type(b.held) }

/// A method a `dyn` call may run: its callee, and the type whose method it is.
type HeldMethod = { callee: CalledFn, held: string }

/// The rows a set, its end and a read call.
const SET_ROW: string = "avra_ctx_set"

const BACK_ROW: string = "avra_ctx_back"

const READ_ROW: string = "avra_ctx_read"

/// Each register `ins` writes a whole number into, by its index spelled, with the number.
fn ints_of(ins: List<Ins>) -> Map<string, int> {
    mut found: Map<string, int> = {}
    for x in ins {
        let c? = int_written(x) else { continue }
        found.set("${c.reg}", c.value)
    }
    found
}

/// A register and the whole number written into it.
type IntWritten = { reg: int, value: int }

/// The whole number `x` writes into a register, where it writes one.
fn int_written(x: Ins) -> IntWritten? {
    match x { .ConstInt(dst, v) -> IntWritten { reg: dst.index, value: v }, rest -> null }
}

/// The number `consts` says the register `r` holds; 0 where it holds none known.
fn int_at(consts: Map<string, int>, r: Reg) -> int { consts.get("${r.index}") ?? 0 }

/// The statement that wrote the set the instruction `at` makes, as `marks` holds it; -1 where none
/// does.
fn set_stmt(marks: ContextMarks, at: int) -> int { marks.sets.find(it.at == at)?.stmt ?? -1 }

/// The callee of `owner` or of a lambda it lifts known by `symbol`.
fn callee_named(owner: LoweredFn, symbol: string) -> CalledFn? {
    owner.callees.find(it.symbol == symbol) ?? flatten([l.callees for l in owner.lifts])
        .find(it.symbol == symbol)
}

fn max(a: int, b: int) -> int { if a > b { a } else { b } }

/// A context the program `package` declares, as its reads are judged: its key, its name, and whether
/// it is required: declared with no default.
type Declared = { key: int, name: string, required: bool }

/// The contexts the files the program whose entry is `entry` reaches declare.
export fn entry_contexts(engine: QueryEngine, entry: SourceFileAddress) -> List<Declared> {
    [Declared { key: c.key, name: c.name, required: c.required } for c in closure_contexts(engine, entry).contexts]
}

/// Each context the files the program `package` reaches declare, as each file's `file_contexts`
/// says: one answer a package, which an edit that declares no context leaves standing.
@cut_query
fn package_contexts(engine: QueryEngine, package: string) -> FileContexts {
    FileContexts {
        contexts: flatten([file_contexts(engine, f).contexts for f in program_files(engine, package)]),
    }
}

/// Each context the files the program `package` reaches declare outside a module's tests: all a
/// file outside them can reach, since nothing imports a test. A package whose tests alone declare a
/// context — the compiler's own — builds no file's closure for one of its other files.
@cut_query
fn library_contexts(engine: QueryEngine, package: string) -> FileContexts {
    FileContexts {
        contexts: flatten(
            [file_contexts(engine, f).contexts for f in program_files(engine, package) if !in_tests(f)],
        ),
    }
}

/// Whether `file` stands in a module's tests.
fn in_tests(file: SourceFileAddress) -> bool { module_segments(file).contains(TESTS_DIR) }

/// Each context the files the source `file` reaches declare, as each file's `file_contexts` says:
/// none, read of no file, where its package's program declares none. One answer a file, which an
/// edit that declares no context leaves standing, so the laws that read it are not asked again.
@cut_query
fn closure_contexts(engine: QueryEngine, file: SourceFileAddress) -> FileContexts {
    let held = if in_tests(file) { package_contexts(engine, file.package_name) } else { library_contexts(engine, file.package_name) }
    if held.contexts.is_empty() { return FileContexts { contexts: [] } }
    FileContexts {
        contexts: flatten([file_contexts(engine, f).contexts for f in entry_files(engine, file)]),
    }
}

/// The contexts one file declares, held apart from the rest of what it declares: a use reads the
/// declaration, never its file, so a program's framing reads which contexts its files declare and
/// stands while a file gains, loses or renames anything else.
@derive(Saved)
type FileContexts = { contexts: List<ContextDeclared> }

/// A context one file declares, as `Declared` holds it, kept.
@derive(Saved)
type ContextDeclared = { key: int, name: string, required: bool }

/// The contexts the file `file` declares.
@cut_query
fn file_contexts(engine: QueryEngine, file: SourceFileAddress) -> FileContexts {
    FileContexts {
        contexts: [ContextDeclared {
            key: context_key(d),
            name: d.name,
            required: context_required_of(engine, d),
        } for d in file_declares(engine, file).names if d.kind == ItemKind.Ctx],
    }
}

/// Whether the context `d` is declared with no default.
fn context_required_of(engine: QueryEngine, d: DeclaredName) -> bool {
    let item = read_item(engine, d.file, d.item)
    item.stmts.any((s) -> item.store.ctx_declared(s) == d.name && item.store.stmt_value(s) == null)
}

/// The first statement `file` runs, where the written item `at` holds it.
fn first_running(engine: QueryEngine, file: SourceFileAddress, at: ItemId) -> StmtId? {
    if !item_held(engine, file, at) { return null }
    if runs_before(engine, file, at) { return null }
    let item = read_item(engine, file, at)
    item.stmts.find((s) -> !item.store.is_declaration(s))
}

/// Each required context an entry the written item `view` shows holds reaches with nothing setting
/// it, said where that entry starts: the program the file's statements run, each case a spec of it
/// writes, and each host fn it declares, which the host calls from no frame. The context, how it is
/// reached, and the `dyn` box it crosses, where one does. Each case is a run of its own, so a case is
/// surveyed alone: a fn value another case makes never runs in it.
fn requireds_unset(view: ItemView) -> List<Found> {
    let engine = view.engine
    let file = view.file
    let at = view.at
    let declared = entry_contexts(engine, file)
    if !declared.any(it.required) { return [] }
    let survey = read_survey(engine, file.package_name)
    let item = view.item
    let store = item.store
    let program = [f for s in some_list(first_running(engine, file, at)) for e in some_list(entry_lowered(engine, file)) for f in unset_from(survey, declared, e, store.stmt_span(s), PROGRAM_STARTS)]
    let cases = file_cases(engine, file).cases
    let specs = [f for s in item.stmts for parts in some_list(store.spec_parts(s)) for local, c in parts.cases for k in some_list(cases.find_index(it.item == at && it.index == local)) for body in some_list(reached_body(engine, found_called(CaseFound { file: file, at: cases[k], k: k }))) for f in unset_from(read_survey(engine, file.package_name), declared, body, c.span, CASE_STARTS)]
    let hosts = [f for s in item.stmts if store.is_host_fn(s) for p in some_list(store.fn_parts(s)) for h in file_host_fns(engine, file).fns if h.called.name == p.name for body in some_list(reached_body(engine, h.called)) for f in unset_from(survey, declared, body, store.stmt_span(s), HOST_STARTS)]
    program.concat(specs).concat(hosts)
}

/// Each required context of `declared` the body `entry` reaches with nothing setting it, said at
/// `at`, where `starts` starts.
fn unset_from(
    survey: ReadSurvey,
    declared: List<Declared>,
    entry: LoweredFn,
    at: Span?,
    starts: string,
) -> List<Found> {
    let walked = survey.settled(entry)
    [Found {
        at: at,
        args: [
            d.name,
            chain_said(r.chain),
            r.through?.subject ?? "",
            r.through?.held ?? "",
            if r.through?.placed ?? false { PLACED_THERE } else { CALLED_THERE },
            starts,
        ],
    } for r in walked.reads for d in declared if d.key == r.key && d.required]
}

/// What an entry a required context is reached from is, as its refusal names where it starts.
const PROGRAM_STARTS: string = "program"

const CASE_STARTS: string = "case"

const HOST_STARTS: string = "host fn"

/// How a read is reached, as a reader follows it.
fn chain_said(chain: List<string>) -> string {
    if chain.is_empty() { return "where it starts" }
    ["`${n}`" for n in chain].join(" → ")
}

/// a required context is set before the program reads it
export law context_set_before_read {
    kind: "ctx.required"
    reads_view: requireds_unset
    voice: required_words
    witness: "ctx depth: int\n\nfn deep() -> int { ctx.depth }\n\ndeep()\n"
}

fn required_words(a: List<string>) -> Voice { context_required(a[0], a[1], a[2], a[3], a[4], a[5]) }

/// Each context a cached fn the written item `view` shows reads whose type compares by no value:
/// where the fn stands, the fn, the context, its type, and how it is reached. A cached fn is one
/// `@query` wears: its answer is kept while each context it read holds what it held
/// (runtime/avra_runtime.c), so a context told apart by no value keeps nothing.
fn cached_untold(view: ItemView) -> List<Found> {
    let item = view.item
    let store = item.store
    let cached = [s for s in item.stmts if store.annotations_of(s).any(it.name == CACHED_MARK)]
    if cached.is_empty() { return [] }
    let declared = entry_contexts(view.engine, view.file)
    if declared.is_empty() { return [] }
    let survey = file_survey(view.engine, view.file)
    let shapes = declared_shapes(view.engine)
    flatten(
        [untold_in(view, survey, declared, shapes, store.stmt_span(s), p.name) for s in cached for p in some_list(store.fn_parts(s))],
    )
}

/// The contexts the cached fn `name`'s written body reads that compare by no value, said at `at`.
fn untold_in(
    view: ItemView,
    survey: ReadSurvey,
    declared: List<Declared>,
    shapes: Shapes,
    at: Span?,
    name: string,
) -> List<Found> {
    let body? = lowered_fn(view.engine, view.file, "${name}\$body") ?? lowered_fn(
        view.engine,
        view.file,
        name,
    ) else { return [] }
    let walked = survey.settled(body)
    mut said: List<string> = []
    mut found: List<Found> = []
    for r in walked.reads {
        let d? = declared.find(it.key == r.key) else { continue }
        if said.contains(d.name) { continue }
        let ty? = context_read(view.engine, view.file, d.name) else { continue }
        if shapes.compares_by_value(ty) { continue }
        said = said.concat([d.name])
        let through = if r.chain.is_empty() { "" } else { chain_said(r.chain) }
        found = found.concat([Found { at: at, args: [name, d.name, ty.spelled(), through] }])
    }
    found
}

/// The annotation that keeps a fn's answers.
const CACHED_MARK: string = "query"

/// a cached fn reads only a context that compares by value
export law context_cached_by_value {
    kind: "ctx.cached"
    reads_view: cached_untold
    voice: cached_words
    witness: "use @std.relation.{query}\nuse @std.relation.db.{Db, new_db}\n\nctx names: List<string> = []\n\n@query\nfn counted(_db: Db) -> int { ctx.names.length }\n\nprintln(\"\${counted(new_db())}\")\n"
}

fn cached_words(a: List<string>) -> Voice { context_cached(a[0], a[1], a[2], a[3]) }

/// How a `dyn` box a read crosses is reached: called there, or placed there.
const CALLED_THERE: string = "called"

const PLACED_THERE: string = "placed"

/// Each `ctx` set the fns the written item `view` shows declares make that nothing under it reads:
/// where it stands, and the context.
fn sets_unread(view: ItemView) -> List<Found> {
    let item = view.item
    let store = item.store
    if !store.refusals().is_empty() || !store.stmt_ids().any((s) -> store.ctx_set(s) != null) { return [] }
    let bodies = [f for s in item.stmts for p in some_list(store.fn_parts(s)) for f in some_list(lowered_fn(view.engine, view.file, p.name))]
    flatten([unread_in(view.engine, view.file, store, f) for f in bodies])
}

/// The sets `f` and the lambdas it lifts make that nothing under them reads, each at its statement in
/// `store`.
fn unread_in(engine: QueryEngine, file: SourceFileAddress, store: SyntaxArena, f: LoweredFn) -> List<
    Found,
> {
    let walked = file_survey(engine, file).settled(f)
    let marked = f.marks.sets.concat(flatten([l.marks.sets for l in f.lifts]))
    [Found { at: store.stmt_span(s), args: [n] } for m in marked if m.stmt >= 0 && !walked.used.contains(m.stmt) for s in [StmtId { index: m.stmt }] for n in some_list(store.ctx_set(s))]
}

/// a `ctx` set is read by something it is in force over
export law context_set_read {
    kind: "ctx.unread"
    reads_view: sets_unread
    voice: unread_words
    warns: true
    witness: "ctx depth: int = 0\n\nfn f() -> int {\n    ctx depth = 1\n    2\n}\n\nf()\n"
}

fn unread_words(a: List<string>) -> Voice { context_set_unread(a[0]) }

collect listed_context_read_facts: List<ListedQuery> = @query_definition in self as ListedQuery { definition: it } by it.name

/// The queries a program's context reads are judged through, for a process to hand its engine.
export fn context_read_fact_definitions() -> List<QueryDefinition> { definitions_of(listed_context_read_facts) }
