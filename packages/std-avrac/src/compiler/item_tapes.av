//! Avra's items on tapes, for the program layer: Avra's source world, an item's tape read from its
//! own text, its refusals among what it keeps, and a file's tree put back together from its items'
//! tapes.
use core.{SyntaxArena, Stmt, StmtId, new_node_store}
use grammar.{avra_lexeme, lex_source}
use @std.program.address.{SourceFileAddress}
use @std.program.source_facts.{PlacedTape, SourceWorld}
use @std.program.syntax_tape.{SyntaxTape, tape_reader, tape_writer}
use @std.program.token_columns.{TokenColumns, TokenRoles, token_columns, token_roles}

/// Avra as the program layer reads it: files from `read_file`, under the reader `language_print`.
export fn avra_source_world(read_file: fn(SourceFileAddress) -> string?, language_print: string) -> SourceWorld {
    SourceWorld {
        read_file: read_file,
        language_print: language_print,
        columns_in: avra_columns,
        item_tape: avra_item_tape,
    }
}

/// A text's tokens, as Avra's grammar says they work.
export fn avra_columns(text: string) -> TokenColumns { token_columns(text, lex_source(text).tokens, avra_roles(), avra_lexeme()) }

once fn avra_roles() -> TokenRoles { token_roles(avra().syntax!) }

/// One item's tree on a tape, read from its text alone: its statements, then what its file keeps
/// of it, its refusals among them.
export fn avra_item_tape(item_text: string) -> SyntaxTape {
    let parsed = parse_source(item_text)
    mut tape = tape_writer()
    tape.count(parsed.stmts.length)
    for s in parsed.stmts { Stmt.taped_id(parsed.store, tape, s) }
    SyntaxArena.tape_item_tables(parsed.store, tape)
    tape.finished()
}

/// A file's tree read back from its items' tapes.
export type ReadBack = { store: SyntaxArena, stmts: List<StmtId> }

export fn read_back(file: string, placed: List<PlacedTape>) -> ReadBack {
    let store = new_node_store(file)
    ReadBack { store: store, stmts: [s for p in placed for s in item_read_back(store, p)] }
}

/// One item's statements read back into `store`, settled as a parse leaves them.
fn item_read_back(store: SyntaxArena, p: PlacedTape) -> List<StmtId> {
    let since = store.marks()
    let reader = tape_reader(p.tape, p.start)
    let stmts = [Stmt.untaped_id(store, reader) for _s in 0..reader.count()]
    SyntaxArena.untape_item_tables(store, reader)
    store.settled_since(since)
    stmts
}
