// What a durable witness must REFUSE, and which edge refuses it. Every case runs a
// second process over a pack the first one wrote and asserts both the verdict (the
// fresh answer, never a stored one gone stale) and the family of the edge that held
// the line. `fresh_check`, `verdict`, `refused_family` are witness_fixtures.av's own.
use compiler.{name_parts}
use query.{Key}

spec "compiler/witness — fixtures are what they claim" {
    then "a body answering string under -> int is a real error" {
        let f: Map<string, string> = {"/w/src/e.av": "export fn f() -> int {\n    \"s\"\n}\n"}
        !fresh_check(f, ["/w/src/e.av"], "/w/src/e.av").clean
    }
    then "an undefined sibling name is a real error, and defining it in a new file clears it" {
        let a = "export fn g() -> int {\n    helper()\n}\n"
        let h = "export fn helper() -> int {\n    1\n}\n"
        let before: Map<string, string> = {"/w/src/a.av": a}
        let after: Map<string, string> = {"/w/src/a.av": a, "/w/src/h.av": h}
        !fresh_check(before, ["/w/src/a.av"], "/w/src/a.av").clean &&
            fresh_check(after, ["/w/src/a.av", "/w/src/h.av"], "/w/src/a.av").clean
    }
    then "the same name defined in an earlier sibling file makes the later definition a real error" {
        let a = "export fn g() -> int {\n    1\n}\n"
        let d = "export fn g() -> int {\n    2\n}\n"
        let one: Map<string, string> = {"/w/src/d.av": d}
        let two: Map<string, string> = {"/w/src/a.av": a, "/w/src/d.av": d}
        fresh_check(one, ["/w/src/d.av"], "/w/src/d.av").clean &&
            !fresh_check(two, ["/w/src/a.av", "/w/src/d.av"], "/w/src/d.av").clean
    }
    then "a second impl of one method name, in an earlier file, is a clash spoken at the later impl" {
        let t = "export type T = { v: int }\nimpl T {\n    fn show() -> int {\n        1\n    }\n}\n"
        let w = "impl T {\n    fn show() -> int {\n        2\n    }\n}\n"
        let one: Map<string, string> = {"/w/src/x.av": t}
        let two: Map<string, string> = {"/w/src/w.av": w, "/w/src/x.av": t}
        fresh_check(one, ["/w/src/x.av"], "/w/src/x.av").clean &&
            !fresh_check(two, ["/w/src/w.av", "/w/src/x.av"], "/w/src/x.av").clean
    }
    then "List<int> -> List<string> under an unchanged caller is a real error" {
        let a = "export fn f() -> List<string> {\n    [\"s\"]\n}\n"
        let b = "export fn g() -> int {\n    f()[0] + 1\n}\n"
        let after: Map<string, string> = {"/w/src/a.av": a, "/w/src/b.av": b}
        !fresh_check(after, ["/w/src/a.av", "/w/src/b.av"], "/w/src/b.av").clean
    }
    then "the ordinals the fixtures use name the families they mean" {
        let ws = a_process_over(package_files(), package_names(), fresh_pack_path("ordinals"))
        let parsed = name_parts(
            ws
                .stable_key_name(Key { family: parsed_ordinal(), arg: ws.file_id("/w/src/a.av").index }),
        )
        let manifest = name_parts(ws.stable_key_name(Key { family: manifest_ordinal(), arg: 0 }))
        let namespace = name_parts(ws.stable_key_name(Key { family: namespace_ordinal(), arg: 0 }))
        let sig = name_parts(
            ws
                .stable_key_name(Key { family: sig_ordinal(), arg: decl_in_file(ws, "/w/src/a.av", "f").index }),
        )
        parsed?.family ?? "" == "Parsed" &&
            manifest?.family ?? "" == "Manifest" &&
            namespace?.family ?? "" == "Namespace" &&
            sig?.family ?? "" == "Sig"
    }
}

spec "compiler/witness — a name ending in an empty field" {
    then "the root module's Namespace edge, whose name is empty, resolves to a hash" {
        let ws = a_process_over(package_files(), package_names(), fresh_pack_path("empty_field"))
        let root = ws.decls.module_id("")
        ws
            .edge_current_hash(ws.stable_key_name(Key { family: namespace_ordinal(), arg: root.index })) != null
    }
}

spec "compiler/witness — a file's text, not only its structure" {
    given "a file with a diagnostic gains a leading comment between processes" {
        then "the Source edge refuses, and the report is the fresh one (positions moved)" {
            let names = ["/w/src/e.av"]
            let path = fresh_pack_path("refusal_trivia")
            let before: Map<string, string> = {
                "/w/src/e.av": "export fn f() -> int {\n    \"s\"\n}\n",
            }
            let _ = checked(a_process_over(before, names, path), "/w/src/e.av")
            let after: Map<string, string> = {
                "/w/src/e.av": "// a note\nexport fn f() -> int {\n    \"s\"\n}\n",
            }
            let v = verdict(a_process_over(after, names, path), path, "/w/src/e.av")
            refused_family(v, "Source") &&
                !refused_family(v, "Parsed") &&
                !v.outcome.reused() &&
                same_verdict_as_fresh(v, fresh_check(after, names, "/w/src/e.av"))
        }
    }
}

spec "compiler/witness — an added file is a read that returned nothing" {
    given "a new sibling file defines a name the file used and could not resolve" {
        then "the VisibleScope edge refuses, and the verdict is the fresh one (now clean)" {
            let a = "export fn g() -> int {\n    helper()\n}\n"
            let h = "export fn helper() -> int {\n    1\n}\n"
            let path = fresh_pack_path("refusal_added_definition")
            let before: Map<string, string> = {"/w/src/a.av": a}
            let _ = checked(a_process_over(before, ["/w/src/a.av"], path), "/w/src/a.av")
            let after: Map<string, string> = {"/w/src/a.av": a, "/w/src/h.av": h}
            let names = ["/w/src/a.av", "/w/src/h.av"]
            let v = verdict(a_process_over(after, names, path), path, "/w/src/a.av")
            refused_family(v, "VisibleScope") && !v.outcome.reused() && v.outcome.value().clean
        }
    }
    given "a new EARLIER sibling file defines a name the file already defined" {
        then "the VisibleVoices edge refuses, and the report is the fresh one (a duplicate, spoken at the later file)" {
            let a = "export fn g() -> int {\n    1\n}\n"
            let d = "export fn g() -> int {\n    2\n}\n"
            let path = fresh_pack_path("refusal_added_duplicate")
            let before: Map<string, string> = {"/w/src/d.av": d}
            let _ = checked(a_process_over(before, ["/w/src/d.av"], path), "/w/src/d.av")
            let after: Map<string, string> = {"/w/src/a.av": a, "/w/src/d.av": d}
            let names = ["/w/src/a.av", "/w/src/d.av"]
            let v = verdict(a_process_over(after, names, path), path, "/w/src/d.av")
            refused_family(v, "VisibleVoices") &&
                !v.outcome.reused() &&
                same_verdict_as_fresh(v, fresh_check(after, names, "/w/src/d.av"))
        }
    }
    given "a new earlier file adds a second impl of a method the file already had" {
        then "the MethodDiags edge refuses, and the report is the fresh one (a clash), even when another file ran the method-table scan first" {
            let t = "export type T = { v: int }\nimpl T {\n    fn show() -> int {\n        1\n    }\n}\n"
            let z = "export fn h() -> int {\n    2\n}\n"
            let w = "impl T {\n    fn show() -> int {\n        2\n    }\n}\n"
            let path = fresh_pack_path("refusal_added_impl")
            let before: Map<string, string> = {"/w/src/other/z.av": z, "/w/src/x.av": t}
            let first = a_process_over(before, ["/w/src/other/z.av", "/w/src/x.av"], path)
            let _ = checked(first, "/w/src/other/z.av")
            let _ = checked(first, "/w/src/x.av")
            let after: Map<string, string> = {
                "/w/src/other/z.av": z,
                "/w/src/w.av": w,
                "/w/src/x.av": t,
            }
            let names = ["/w/src/other/z.av", "/w/src/w.av", "/w/src/x.av"]
            let v = verdict(a_process_over(after, names, path), path, "/w/src/x.av")
            refused_family(v, "MethodDiags") &&
                same_verdict_as_fresh(v, fresh_check(after, names, "/w/src/x.av"))
        }
    }
}

spec "compiler/witness — a callee that changes or goes away" {
    given "a callee's return type changes List<int> -> List<string>; the caller is unchanged" {
        then "the caller's verdict is the fresh one (a type error), and the Parsed edge names the callee's file" {
            let a1 = "export fn f() -> List<int> {\n    [1]\n}\n"
            let a2 = "export fn f() -> List<string> {\n    [\"s\"]\n}\n"
            let b = "export fn g() -> int {\n    f()[0] + 1\n}\n"
            let names = ["/w/src/a.av", "/w/src/b.av"]
            let path = fresh_pack_path("refusal_callee_type")
            let before: Map<string, string> = {"/w/src/a.av": a1, "/w/src/b.av": b}
            let first = a_process_over(before, names, path)
            let _ = checked(first, "/w/src/a.av")
            let _ = checked(first, "/w/src/b.av")
            let after: Map<string, string> = {"/w/src/a.av": a2, "/w/src/b.av": b}
            let second = a_process_over(after, names, path)
            let _ = checked(second, "/w/src/a.av")
            let v = verdict(second, path, "/w/src/b.av")
            refused_family(v, "Parsed") &&
                same_verdict_as_fresh(v, fresh_check(after, names, "/w/src/b.av"))
        }
    }
    given "the callee decl is deleted but its file stays" {
        then "the caller's verdict is the fresh one (undefined)" {
            let a1 = "export fn f() -> int {\n    1\n}\nexport fn k() -> int {\n    3\n}\n"
            let a2 = "export fn k() -> int {\n    3\n}\n"
            let b = "export fn g() -> int {\n    f() + 1\n}\n"
            let names = ["/w/src/a.av", "/w/src/b.av"]
            let path = fresh_pack_path("refusal_callee_removed")
            let before: Map<string, string> = {"/w/src/a.av": a1, "/w/src/b.av": b}
            let first = a_process_over(before, names, path)
            let _ = checked(first, "/w/src/a.av")
            let _ = checked(first, "/w/src/b.av")
            let after: Map<string, string> = {"/w/src/a.av": a2, "/w/src/b.av": b}
            let v = verdict(a_process_over(after, names, path), path, "/w/src/b.av")
            !v.outcome.reused() &&
                same_verdict_as_fresh(v, fresh_check(after, names, "/w/src/b.av"))
        }
    }
}

spec "compiler/witness — a dep whose subject is gone answers unresolved" {
    then "a file the host never had answers unresolved, not the empty program's hash" {
        let ws = a_process_over(package_files(), package_names(), fresh_pack_path("gone_never"))
        let gone = ws.file_id("/w/src/gone.av")
        ws.edge_current_hash(ws.stable_key_name(Key { family: parsed_ordinal(), arg: gone.index })) == null
    }
    then "an emptied file still answers a hash of its own" {
        let empty: Map<string, string> = {"/w/src/e.av": ""}
        let ws = a_process_over(empty, ["/w/src/e.av"], fresh_pack_path("gone_emptied"))
        let f = ws.file_id("/w/src/e.av")
        ws.edge_current_hash(ws.stable_key_name(Key { family: parsed_ordinal(), arg: f.index })) != null
    }
    then "a removed callee decl's Sig edge answers unresolved" {
        let a1 = "export fn f() -> int {\n    1\n}\nexport fn k() -> int {\n    3\n}\n"
        let a2 = "export fn k() -> int {\n    3\n}\n"
        let b = "export fn g() -> int {\n    f() + 1\n}\n"
        let names = ["/w/src/a.av", "/w/src/b.av"]
        let path = fresh_pack_path("gone_sig")
        let before: Map<string, string> = {"/w/src/a.av": a1, "/w/src/b.av": b}
        let first = a_process_over(before, names, path)
        let _ = checked(first, "/w/src/a.av")
        let _ = checked(first, "/w/src/b.av")
        let after: Map<string, string> = {"/w/src/a.av": a2, "/w/src/b.av": b}
        let second = a_process_over(after, names, path)
        refusing_families(second, path, "/w/src/b.av").contains("Sig")
    }
    then "a removed type's Methods name answers unresolved" {
        let t = "export type T = { v: int }\n"
        let z = "export fn h() -> int {\n    2\n}\n"
        let before: Map<string, string> = {"/w/src/other/z.av": z, "/w/src/t.av": t}
        let first = a_process_over(
            before,
            ["/w/src/other/z.av", "/w/src/t.av"],
            fresh_pack_path("gone_methods_a"),
        )
        let name = first
            .stable_key_name(
                Key {
                    family: methods_ordinal(),
                    arg: decl_in_file(first, "/w/src/t.av", "T").index,
                },
            )
        let after: Map<string, string> = {"/w/src/other/z.av": z}
        let second = a_process_over(after, ["/w/src/other/z.av"], fresh_pack_path("gone_methods_b"))
        first.edge_current_hash(name) != null && second.edge_current_hash(name) == null
    }
}

spec "compiler/witness — the package's own avra.toml" {
    given "the manifest's text changes between processes" {
        then "the Manifest edge refuses, and the file recomputes" {
            let files: Map<string, string> = {"/w/src/a.av": "export fn f() -> int {\n    1\n}\n"}
            let names = ["/w/src/a.av"]
            let path = fresh_pack_path("refusal_manifest")
            let v1 = "[package]\nname = \"app\"\nversion = \"0.1.0\"\n"
            let v2 = "[package]\nname = \"app\"\nversion = \"0.2.0\"\n"
            let _ = checked(a_process_over_toml(files, names, v1, path), "/w/src/a.av")
            let v = verdict(a_process_over_toml(files, names, v2, path), path, "/w/src/a.av")
            refused_family(v, "Manifest") && !v.outcome.reused()
        }
    }
    given "the manifest is unchanged" {
        then "nothing refuses and the answer is reused" {
            let files: Map<string, string> = {"/w/src/a.av": "export fn f() -> int {\n    1\n}\n"}
            let names = ["/w/src/a.av"]
            let path = fresh_pack_path("reuse_manifest")
            let toml = "[package]\nname = \"app\"\nversion = \"0.1.0\"\n"
            let _ = checked(a_process_over_toml(files, names, toml, path), "/w/src/a.av")
            let v = verdict(a_process_over_toml(files, names, toml, path), path, "/w/src/a.av")
            v.refused_by.is_empty() && v.outcome.reused()
        }
    }
}
