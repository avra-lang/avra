// proves: a box a call was handed stands for the call, whatever the
// callee empties
type Box = { xs: List<int> }

fn emptied(c: Cell<List<Box>>, b: Box) -> int {
    c.set([])
    b.xs.length + b.xs[0]
}

fn drained(mut bs: List<Box>, b: Box) -> int {
    let _ = bs.pop()
    b.xs.length
}

fn kept(b: Box, sink: Cell<List<Box>>) -> int {
    sink.push(b)
    b.xs.length
}

fn shown() -> int {
    let c = Cell.new([Box { xs: [7, 8, 9] }])
    let a = emptied(c, c.get()[0])
    mut bs = [Box { xs: [1] }, Box { xs: [2, 3] }]
    let d = drained(bs, bs[1])
    let sink: Cell<List<Box>> = Cell.new([])
    mut t = 0
    for i in 0..200 { t = t + kept(Box { xs: [i] }, sink) }
    a + d + t + sink.get().length + sink.get()[199].xs[0]
}

"${shown()}"
