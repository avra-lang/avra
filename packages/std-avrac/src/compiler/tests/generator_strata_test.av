// A CYCLE NEVER STANDS IN FOR A REFUSAL — GENERATORS STAND IN STRATA. A derive's own file imports from
// the module the derive makes for a name that module never writes. Making the derive resolves its
// file; were every import of that file bound at once, the missing name would ask what the module's
// generators make, which asks the derive being made, and the cycle would trap where the refusal
// belongs. Imports a module doesn't write are read one name at a time (`resolved` over
// `written_file_scope`), so the derive is made over what it reads, and the missing name is refused
// where it's written — whoever reads it, the derive's own body among them.
use @std.avrac.testing.{held_at, vendored_meta}
use @std.avrac.testing.held.{empty_store}

/// The library whose trait `Shown` derives over its own `Part`: `shown.av` heads with `heads`, the
/// derive's body says `body`, and `main.av` holds `main`.
fn strata(heads: string, main: string, body: string = "\"x\"") -> string {
    held_at(
        vendored_meta(
            {
                "/w/avra.toml": "[package]\nname = \"@repro/shown\"\nversion = \"0.0.1\"\n\n[lib]\nname = \"repro-shown\"\npath = \"src/shown.av\"\n\n[dependencies]\n\"@std/meta\" = { path = \"vendor/meta\" }\n",
                "/w/src/shown.av": "use @std.meta.{Type, Declared, beside, derive, literal}\n${heads}\nexport trait Shown {\n    fn shown() -> string\n\n    static fn derive(t: Type) -> Declared {\n        Declared { made: [beside(t, quote { impl Shown for \${t} { fn shown() -> string { ${body} } } })] }\n    }\n}\n",
                "/w/src/parts.av": "use @std.meta.{derive}\nuse shown.{Shown}\n\n@derive(Shown)\nexport type Part = { id: int }\n",
                "/w/src/main.av": main,
            },
        ),
        "/w",
    )
        .checked_over(empty_store())
}

/// The refusal of `gone`, said once at the file `at` and nowhere a cycle.
fn refused_at(said: string, at: string) -> bool {
    said.contains("error[resolve.not_exported]: `parts` does not export `gone`") &&
        said.contains("╭─[/w/src/${at}:") &&
        said.split("error[").length == 2 &&
        !said.contains("was asked while it was being answered")
}

spec "compiler/generators — what a generator is made of never waits on what it makes" {
    given "the derive's own file imports a name the module it derives over never writes" {
        then "the import is refused where it's written, never a cycle" {
            refused_at(strata("use parts.{gone}\n", "1\n"), "shown.av")
        }
    }
    given "the derive's own body reads that name" {
        then "the same refusal, never a cycle" {
            refused_at(strata("use parts.{gone}\n", "1\n", "gone()"), "shown.av")
        }
    }
    given "another file imports the name the derived module never writes" {
        then "it is refused in that file" { refused_at(strata("", "use parts.{gone}\ngone\n"), "main.av") }
    }
    given "a file holding an impl imports the name the derived module never writes" {
        then "filing the impl runs no derive: the import is refused in that file" {
            refused_at(
                strata(
                    "",
                    "use parts.{Part, gone}\n\nimpl Part {\n    fn more() -> int { 1 }\n}\n\nPart { id: 1 }.more()\n",
                ),
                "main.av",
            )
        }
    }
    given "an import of what the module writes" {
        then "the package checks clean" { !strata("", "use parts.{Part}\n1\n").contains("error[") }
    }
}
