// A GENERATOR'S RUN IS NAMED ON THE SETTLE LINE BY WHAT IT RAN OVER: its symbol, then the
// declaration it was handed, so one derive's runs over many types read apart (`AVRA_DEBUG=1`, grep
// `settle:`).
use compiler.{GeneratorAt, GeneratorKind, generator_run_named}
use @std.program.address.{SourceFileAddress, source_file}

fn at(package: string, path: string, name: string, kind: GeneratorKind) -> GeneratorAt {
    GeneratorAt { file: source_file(package, path), name: name, kind: kind }
}

spec "compiler/generators — a run's name on the settle line" {
    given "an annotation generator over a type" {
        then "it is the generator's symbol, then the type" {
            generator_run_named(
                at("@std/relation", "src/relation.av", "codec", GeneratorKind.Annotation),
                "TypeFacts",
            ) == "@std/relation/src/relation.av.codec(TypeFacts)"
        }
    }
    given "a trait's derive over a type" {
        then "it is the derive's symbol, then the type" {
            generator_run_named(
                at("@std/avrac", "src/core/fingerprint.av", "Fingerprint", GeneratorKind.Derive),
                "Body",
            ) == "@std/avrac/src/core/fingerprint.av.Fingerprint.derive(Body)"
        }
    }
}
