// `Family.Analysis`, durable end to end (compiler/witness.av): a
// second, fully independent `Workspace` over the SAME source and the
// SAME on-disk pack — simulating a second process, since nothing
// crosses between two `Workspace`s but the pack file itself — reuses
// an unchanged file's checked answer without touching `resolved` or
// `folded`, and a changed one is refused as stale, whether the change
// is the file's own or a callee's signature in another file.
use @std.avrac.compiler.{avra, new_workspace}
use compiler.{Workspace, WitnessedOutcome, WitnessedCheck}
use compiler.host.{memory_host}
use compiler.store.{pack_at}
use @std.io.{make_dirs, exists, remove}

fn dir(name: string) -> string { "/tmp/avra-witness-test/${name}" }

/// A path with nothing at it yet — see pack_test.av's own `fresh`.
fn fresh_pack_path(name: string) -> string {
    let _ = make_dirs(dir(name))
    let path = "${dir(name)}/pack.bin"
    if exists(path) { let _ = remove(path) }
    path
}

/// `a` declares `f`; `b` calls it, a real cross-file signature
/// dependency (both root siblings — root's own `Namespace` depends on
/// every root file's `Parsed`, since siblings resolve each other with
/// no `use`). `c` lives in ITS OWN MODULE, unrelated to either and
/// naming neither: a real test of per-file reuse needs a file whose
/// edit does not move its module's shared namespace fingerprint.
fn package_files() -> Map<string, string> {
    {
        "/w/src/a.av": "export fn f() -> int {\n    1\n}\n",
        "/w/src/b.av": "export fn g() -> int {\n    f() + 1\n}\n",
        "/w/src/other/c.av": "export fn h() -> int {\n    2\n}\n",
    }
}

fn package_names() -> List<string> { ["/w/src/a.av", "/w/src/b.av", "/w/src/other/c.av"] }

/// One process's own workspace, its own everything, over the given
/// source — opened onto the shared pack path and every file admitted
/// (declare-only) up front, matching `analyze_all`'s own phase order
/// so a cross-file signature dep always finds its callee's declaration
/// already minted.
// `Workspace.compiler_id()` mints a fresh, never-reused print for a
// memory host on purpose (build.av's `unnamed_print`: "never mistaken
// for a real compiler's print and never read back by a later
// process") — the opposite of what two SIMULATED processes over the
// same pack need, so the test opens the pack under its OWN fixed id
// rather than through `open_pack`.
fn a_process(files: Map<string, string>, pack_path: string) -> Workspace {
    let ws = new_workspace(memory_host(files, package_names()), "/w", avra())
    ws.attach_pack(pack_at(pack_path, "witness-test"))
    for path in package_names() { let _ = ws.items(ws.file_id(path)) }
    ws
}

fn checked(ws: Workspace, path: string) -> WitnessedOutcome { ws.witnessed_check(ws.file_id(path)) }

fn all_reused(outs: List<WitnessedOutcome>) -> bool { outs.all((o: WitnessedOutcome) -> o.reused()) }

fn all_clean(outs: List<WitnessedOutcome>) -> bool { outs.all((o: WitnessedOutcome) -> o.value().clean) }

spec "compiler/witness" {
    given "a package checked for the first time" {
        then "every file computes fresh, clean, and the pack remembers each one" {
            let ws = a_process(package_files(), fresh_pack_path("cold"))
            let outs = [checked(ws, p) for p in package_names()]
            !all_reused(outs) && all_clean(outs)
        }
    }
    given "the same, unchanged source, opened in a second process" {
        then "every file's checked answer is reused, none recomputed" {
            let path = fresh_pack_path("warm")
            let first = a_process(package_files(), path)
            let _ = [checked(first, p) for p in package_names()]
            let second = a_process(package_files(), path)
            all_reused([checked(second, p) for p in package_names()])
        }
    }
    given "one unrelated file's body edited between processes" {
        then "only that file recomputes; the other two are reused" {
            let path = fresh_pack_path("edit_unrelated")
            let first = a_process(package_files(), path)
            let _ = [checked(first, p) for p in package_names()]
            mut edited = package_files()
            edited.set("/w/src/other/c.av", "export fn h() -> int {\n    3\n}\n")
            let second = a_process(edited, path)
            let a = checked(second, "/w/src/a.av")
            let b = checked(second, "/w/src/b.av")
            let c = checked(second, "/w/src/other/c.av")
            a.reused() && b.reused() && !c.reused() && c.value().clean
        }
    }
    given "a callee's declared return type changed in another file" {
        // NOT asserted here: that the unrelated `c` stays reused. It
        // doesn't — `f`'s `int` -> `string` shifts this compile's
        // TypeId INTERNING ORDER, and `Sig.fingerprint()` folds a
        // signature's TypeIds in directly, so `h`'s otherwise-untouched
        // signature hashes differently too. Safe (a false mismatch
        // only ever forces an unwanted recompute, never a wrong reuse)
        // but real: `Sig`'s witness is stable only once a TypeId
        // carries the shape digest §6.4 already calls for, not the
        // dense id `Fingerprint` derives over today.
        then "the caller's witness is refused as stale and its fresh check is not clean" {
            let path = fresh_pack_path("edit_signature")
            let first = a_process(package_files(), path)
            let _ = [checked(first, p) for p in package_names()]
            mut edited = package_files()
            edited.set("/w/src/a.av", "export fn f() -> string {\n    \"one\"\n}\n")
            let second = a_process(edited, path)
            let a = checked(second, "/w/src/a.av")
            let b = checked(second, "/w/src/b.av")
            !a.reused() && !b.reused() && !b.value().clean
        }
    }
}
