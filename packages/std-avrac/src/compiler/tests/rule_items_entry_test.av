//! `rule_items` ON THE PROGRAM LAYER TYPES AN ENTRY'S OWN STATEMENTS: a rule example is program
//! text, so a rule whose code asks `type()` of a top-level statement reads the type the layer gives
//! the entry (`entry_types`, the one query it is typed by) — not only the types of the fns' bodies.
use @std.avrac.testing.{held_alone}
use compiler.{example_roots}
use features.{Code}

/// Whether some code at or under `c` is typed as text.
fn texted(c: Code) -> bool { c.type()?.is_text() ?? false || c.kids().any(texted) }

/// Whether a rule reading the alone program `source` meets a text-typed node.
fn meets_text(source: string) -> bool {
    let main = "/alone/src/main.av"
    example_roots(held_alone(source).judged_at(main).rule_items(main)).any(texted)
}

spec "compiler/rule_examples — rule_items types the entry" {
    then "an entry statement's nodes are typed" { meets_text("let s = \"a\" + \"b\"\ns.length") }
    then "a fn body's nodes are typed, as they were" { meets_text("fn f() -> string { \"a\" + \"b\" }\nf().length") }
}
