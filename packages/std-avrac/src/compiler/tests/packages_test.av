// Packages over an in-memory host: a root manifest names a path
// dependency, `use @scope.name.a.{x}` reaches its module, the graph's
// laws refuse in their own words, and the entry is the manifest's.
use @std.avrac.testing.{test_workspace}
use @std.avrac.compiler.{Program}
use @std.avrac.diagnostics.{suggested}
use diagnostics.{Diag}
use compiler.{Workspace}
use compiler.host.{memory_host}

/// A program (`app`) with a vendored dependency (`@acme/greet`)
/// that itself depends on a second one (`@acme/words`), and a
/// nested package under the root's own sources.
fn files() -> Map<string, string> {
    {
        "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@acme/greet\" = { path = \"vendor/greet\" }\n",
        "/w/src/main.av": "use @acme.greet.{greet}\ngreet(2)\n",
        "/w/src/tools/avra.toml": "[package]\nname = \"@acme/tools\"\nversion = \"0.1.0\"\n",
        "/w/src/tools/src/t.av": "export fn t() -> int {\n    1\n}\n",
        "/w/vendor/greet/avra.toml": "[package]\nname = \"@acme/greet\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@acme/words\" = { path = \"../words\" }\n",
        "/w/vendor/greet/src/greet.av": "use @acme.words.{word}\nexport fn greet(n: int) -> int {\n    n + word()\n}\n",
        "/w/vendor/words/avra.toml": "[package]\nname = \"@acme/words\"\nversion = \"0.1.0\"\n",
        "/w/vendor/words/src/words.av": "export fn word() -> int {\n    40\n}\n",
    }
}

fn names() -> List<string> {
    [
        "/w/avra.toml",
        "/w/src/main.av",
        "/w/src/tools/avra.toml",
        "/w/src/tools/src/t.av",
        "/w/vendor/greet/avra.toml",
        "/w/vendor/greet/src/greet.av",
        "/w/vendor/words/avra.toml",
        "/w/vendor/words/src/words.av",
    ]
}

fn workspace() -> Workspace {
    test_workspace(memory_host(files(), names()), "/w")
}

/// The package with one file replaced.
fn with_file(path: string, text: string) -> Workspace {
    mut fs = files()
    fs.set(path, text)
    test_workspace(memory_host(fs, names()), "/w")
}

/// The package with two files replaced or added.
/// The program's printed value, or its refusal.
fn answered(p: Program) -> string {
    match p.run() { .Ok(v) -> v, .Err(why) -> why }
}

fn with_two(p1: string, t1: string, p2: string, t2: string) -> Workspace {
    mut fs = files()
    fs.set(p1, t1)
    fs.set(p2, t2)
    test_workspace(memory_host(fs, names().concat([p1, p2])), "/w")
}

fn both_deps() -> string {
    root_manifest(
        "\"@acme/greet\" = { path = \"vendor/greet\" }\n\"@acme/words\" = { path = \"vendor/words\" }",
    )
}

fn root_manifest(deps: string) -> string {
    "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n${deps}\n"
}

fn ran(ws: Workspace) -> string? {
    match ws.program("/w/src/main.av").run() { .Ok(text) -> text, .Err(_) -> null }
}

/// The root file's ONE diagnostic.
fn main_diag(ws: Workspace) -> Diag? {
    let a = ws.analyze_file("/w/src/main.av")
    if a.diagnostics.length != 1 { return null }
    a.diagnostics[0]
}

/// The root file's structured fixes as text; empty without a
/// diagnostic.
fn fixes(ws: Workspace) -> List<string> {
    let d? = main_diag(ws) else { return [] }
    suggested(d)
}

/// The root reaching `@acme/greet` under the named dependency section,
/// with greet depending BACK on the root.
fn back_edge(section: string) -> Workspace {
    with_two(
        "/w/avra.toml",
        "[package]\nname = \"@acme/app\"\nversion = \"0.1.0\"\n\n[${section}]\n\"@acme/greet\" = { path = \"vendor/greet\" }\n",
        "/w/vendor/greet/avra.toml",
        "[package]\nname = \"@acme/greet\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@acme/words\" = { path = \"../words\" }\n\"@acme/app\" = { path = \"../..\" }\n",
    )
}

/// The packages' ONE voice, saying this.
fn package_voice(ws: Workspace, saying: string) -> bool {
    let p = ws.program("/w/src/main.av")
    p.voices.length == 1 && p.rendered(p.voices).contains(saying)
}

spec "compiler/packages" {
    given "a dependency's module resolves through the manifests" {
        then "the entry runs through two packages" {
            let out: string? = ran(workspace())
            out == "42"
        }
        then "a package's own files reach it by its name" {
            ran(
                with_two(
                    "/w/vendor/greet/src/twice.av",
                    "use @acme.greet.greet.{greet}\nexport fn twice(n: int) -> int {\n    greet(n) * 2\n}\n",
                    "/w/src/main.av",
                    "use @acme.greet.twice.{twice}\ntwice(2)\n",
                ),
            ) == "84"
        }
        then "a dependency file's module carries its package" {
            let ws = workspace()
            ws.module_of("/w/vendor/greet/src/greet.av") == "@acme.greet" &&
                ws.module_of("/w/vendor/greet/src/deep/x.av") == "@acme.greet.deep" &&
                ws.module_of("/w/src/main.av") == ""
        }
        then "a nested package is not a module of the package above it" {
            let kind: string? = main_diag(with_file("/w/src/main.av", "use tools.src.t.{t}\n1\n"))?.kind
            workspace().root_files().length == 1 && kind == "resolve.no_module"
        }
    }
    given "a package sees only what its manifest declares" {
        then "a transitive dependency is invisible, and the fix writes the line" {
            let ws = with_file("/w/src/main.av", "use @acme.words.{word}\n1\n")
            let kind: string? = main_diag(ws)?.kind
            let fix = fixes(ws)
            kind == "resolve.not_a_dependency" &&
                fix.length == 1 &&
                fix[0] == "/w/avra.toml: \n\"@acme/words\" = { path = \"vendor/words\" }"
        }
        then "an unknown package has no fix to offer" {
            let d: Diag? = main_diag(with_file("/w/src/main.av", "use @nope.thing.{x}\n1\n"))
            d != null &&
                d!.kind == "resolve.not_a_dependency" &&
                fixes(with_file("/w/src/main.av", "use @nope.thing.{x}\n1\n")).is_empty()
        }
        then "a package is two segments" {
            let kind: string? = main_diag(with_file("/w/src/main.av", "use @acme.{greet}\n1\n"))?.kind
            kind == "resolve.package_form"
        }
        then "a diamond over one directory is one package" {
            let ws = with_two(
                "/w/avra.toml",
                both_deps(),
                "/w/src/main.av",
                "use @acme.greet.{greet}\nuse @acme.words.{word}\ngreet(1) + word()\n",
            )
            let out: string? = ran(ws)
            ws.program("/w/src/main.av").voices.is_empty() && out == "81"
        }
    }
    given "the graph's laws" {
        then "a cycle refuses naming it" {
            package_voice(
                with_file(
                    "/w/vendor/words/avra.toml",
                    "[package]\nname = \"@acme/words\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@acme/greet\" = { path = \"../greet\" }\n",
                ),
                "packages depend in a cycle: app -> @acme/greet -> @acme/words -> @acme/greet",
            )
        }
        then "a dev dependency closes no cycle through the package it tests" {
            back_edge("dev-dependencies").program("/w/src/main.av").voices.is_empty()
        }
        then "the same edge as a library dependency refuses" {
            package_voice(
                back_edge("dependencies"),
                "packages depend in a cycle: @acme/app -> @acme/greet -> @acme/app",
            )
        }
        then "a dependency calls itself what it was keyed as" {
            package_voice(
                with_file(
                    "/w/vendor/greet/avra.toml",
                    "[package]\nname = \"@acme/greeting\"\nversion = \"0.1.0\"\n",
                ),
                "calls itself `@acme/greeting`, not `@acme/greet`",
            )
        }
        then "a path dependency points at a package directory" {
            package_voice(
                with_file(
                    "/w/avra.toml",
                    root_manifest("\"@acme/greet\" = { path = \"vendor/nothing\" }"),
                ),
                "holds no `avra.toml`",
            )
        }
        then "one key is one directory" {
            let ws = with_two(
                "/w/avra.toml",
                root_manifest(
                    "\"@acme/greet\" = { path = \"vendor/greet\" }\n\"@acme/words\" = { path = \"vendor/words2\" }",
                ),
                "/w/vendor/words2/avra.toml",
                "[package]\nname = \"@acme/words\"\nversion = \"0.1.0\"\n",
            )
            package_voice(
                ws,
                "`@acme/words` is claimed by two directories: `/w/vendor/words` and `/w/vendor/words2`",
            )
        }
    }
    given "the entry and the warnings" {
        then "the entry is `[bin]`, else src/main.av" {
            let plain: string? = workspace().entry_of()
            let binned: string? = with_file(
                "/w/avra.toml",
                "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[bin]\npath = \"src/app.av\"\n",
            )
                .entry_of()
            plain == "/w/src/main.av" && binned == "/w/src/app.av"
        }
        then "an unknown section warns and never blocks" {
            let p = with_file(
                "/w/avra.toml",
                root_manifest("\"@acme/greet\" = { path = \"vendor/greet\" }") +
                    "\n[grants]\nnetwork = []\n",
            )
                .program("/w/src/main.av")
            p.voices.length == 1 &&
                p.voices[0].severity is .Warning &&
                p.clean() &&
                p.report().contains("warning[manifest.unknown_section]")
        }
    }
    given "impl blocks are found by name, and a name is per package" {
        then "two packages each declaring `P` with an `impl P` keep their own methods" {
            let ws = with_two(
                "/w/vendor/greet/src/greet.av",
                "export type P = { v: int }\nimpl P {\n    fn who() -> int {\n        2\n    }\n}\nexport fn make() -> P {\n    P { v: 0 }\n}\n",
                "/w/src/main.av",
                "use @acme.greet.{make}\ntype P = { v: int }\nimpl P {\n    fn who() -> int {\n        1\n    }\n}\nlet mine = P { v: 0 }\nlet theirs = make()\n\"\${mine.who()} \${theirs.who()}\"\n",
            )
            answered(ws.program("/w/src/main.av")) == "1 2"
        }
    }
    given "[lifted] budgets" {
        then "a settlement past the manifest's steps is refused, and the refusal names the row" {
            let ws = with_two(
                "/w/avra.toml",
                "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[lifted]\nsteps = 500\n",
                "/w/src/main.av",
                "fn spin() -> int {\n    mut i = 0\n    while i < 1000 { i = i + 1 }\n    i\n}\nconst N = spin()\nN\n",
            )
            let report = answered(ws.program("/w/src/main.av"))
            report.contains("error[const.budget]") &&
                report.contains("took more than 500 steps") &&
                report.contains("raise `[lifted] steps")
        }
        then "a settlement past the manifest's memory is refused in bytes" {
            let ws = with_two(
                "/w/avra.toml",
                "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[lifted]\nmemory = 1\n",
                "/w/src/main.av",
                "fn heavy() -> List<int> {\n    [i for i in 0..300000]\n}\nconst H = heavy()\nH.length\n",
            )
            let report = answered(ws.program("/w/src/main.av"))
            report.contains("error[const.budget]") &&
                report.contains("held more than 1048576 bytes")
        }
        then "within both, the const settles" {
            let ws = with_two(
                "/w/avra.toml",
                "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[lifted]\nsteps = 100000\nmemory = 1\n",
                "/w/src/main.av",
                "fn spin() -> int {\n    mut i = 0\n    while i < 1000 { i = i + 1 }\n    i\n}\nconst N = spin()\nN\n",
            )
            answered(ws.program("/w/src/main.av")) == "1000"
        }
    }
    given "every reached file is analysed, however deep the chain" {
        then "a four-package dependency chain lands every link in the program's own files" {
            let ws = test_workspace(memory_host(chain_files(), chain_names()), "/w")
            let paths = [a.view.source.file for a in ws.program("/w/src/main.av").files]
            paths.length == 5 &&
                paths.any(it == "/w/vendor/p3/src/p3.av") &&
                paths.any(it == "/w/vendor/p4/src/p4.av")
        }
    }
}

/// A four-hop dependency chain (app -> p1 -> p2 -> p3 -> p4), each link
/// calling the next only from its BODY, never its signature — deep
/// enough that `analyze_all`'s three earlier phases (resolve, sigs) run
/// out of turns before `p3`/`p4` are ever discovered, and only a phase
/// that walks to a fixed point (not a snapshot taken at its own start)
/// still reaches them in the final one.
fn chain_files() -> Map<string, string> {
    {
        "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@a/p1\" = { path = \"vendor/p1\" }\n",
        "/w/src/main.av": "use @a.p1.{f1}\nf1()\n",
        "/w/vendor/p1/avra.toml": "[package]\nname = \"@a/p1\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@a/p2\" = { path = \"../p2\" }\n",
        "/w/vendor/p1/src/p1.av": "use @a.p2.{f2}\nexport fn f1() -> int {\n    f2()\n}\n",
        "/w/vendor/p2/avra.toml": "[package]\nname = \"@a/p2\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@a/p3\" = { path = \"../p3\" }\n",
        "/w/vendor/p2/src/p2.av": "use @a.p3.{f3}\nexport fn f2() -> int {\n    f3()\n}\n",
        "/w/vendor/p3/avra.toml": "[package]\nname = \"@a/p3\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@a/p4\" = { path = \"../p4\" }\n",
        "/w/vendor/p3/src/p3.av": "use @a.p4.{f4}\nexport fn f3() -> int {\n    f4()\n}\n",
        "/w/vendor/p4/avra.toml": "[package]\nname = \"@a/p4\"\nversion = \"0.1.0\"\n",
        "/w/vendor/p4/src/p4.av": "export fn f4() -> int {\n    99\n}\n",
    }
}

fn chain_names() -> List<string> {
    [
        "/w/avra.toml",
        "/w/src/main.av",
        "/w/vendor/p1/avra.toml",
        "/w/vendor/p1/src/p1.av",
        "/w/vendor/p2/avra.toml",
        "/w/vendor/p2/src/p2.av",
        "/w/vendor/p3/avra.toml",
        "/w/vendor/p3/src/p3.av",
        "/w/vendor/p4/avra.toml",
        "/w/vendor/p4/src/p4.av",
    ]
}
