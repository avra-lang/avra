// THE COST REMARKS: each site of a body where a representation technique it is a candidate for
// declined, and the typed reason — one case a decline point, and a body that declines nothing.
use @std.avrac.compiler.{cost_remarks}
use @std.avrac.core.{CostRemark}
use @std.avrac.testing.{judged}

/// The remarks of the fn `name` the source declares, each as `technique: words`, in the order noted.
fn remarked(source: string, name: string) -> List<string> {
    let j = judged(source)
    [said(r) for r in cost_remarks(j.engine, j.entry, name).remarks]
}

fn said(r: CostRemark) -> string { "${r.declined.technique()}: ${r.declined.words()}" }

/// Whether the one remark of `name` in `source` is the technique `technique`'s, and names `phrase`.
fn declines(source: string, name: string, technique: string, phrase: string) -> bool {
    let rs = remarked(source, name)
    rs.length == 1 && rs[0].starts_with("${technique}: ") && rs[0].contains(phrase)
}

/// The remarks of `name` in `source` the technique `technique` says.
fn said_by(source: string, name: string, technique: string) -> List<string> {
    remarked(source, name).filter(it.starts_with("${technique}: "))
}

/// A fn that files `held` into `out`, its pushes standing as `pushes` writes them.
fn filing(pushes: string) -> string {
    "fn filed(names: List<string>, name: string, early: bool) -> List<string> {\n    mut out = [n for n in names]\n    let held = name + \"!\"\n    ${pushes}\n    out\n}\nfiled([\"x\"], \"y\", true).length"
}

/// A borrow read across a call handed only a scalar, whose callee writes the cell the borrow rides.
const ACROSS_WRITER: string = "fn joined(n: int) -> string { [\"name\", \"\${n}\"].join(\"-\") }\nstate names: List<string> = [joined(1), joined(2)]\nfn emptied(n: int) -> int {\n    names = [joined(n)]\n    n\n}\nfn across(n: int) -> string {\n    let held = names\n    let seen = emptied(n)\n    \"\${held[0]} \${seen}\"\n}\nacross(7)"

spec "the cost remarks of a body" {
    given "a body each technique is a candidate for, and declines" {
        then "a deferred call whose operand holds a counted reference is not run in place" {
            declines(
                "fn note(s: string) {}\nfn work(n: int) -> int {\n    let label = \"x\${n}\"\n    defer note(label)\n    n\n}\nwork(1)",
                "work",
                "deferred call in place",
                "counted reference",
            )
        }
        then "a deferred call of a fn that writes a seat is not run in place" {
            declines(
                "fn grow(mut xs: List<int>) { xs.push(1) }\nfn work(n: int) -> int {\n    mut xs = [n]\n    defer grow(xs)\n    n\n}\nwork(1)",
                "work",
                "deferred call in place",
                "writes",
            )
        }
        then "a map write whose value names the key again takes no probe" {
            declines(
                "fn work(m: Map<string, int>, k: string) -> int {\n    mut mm = m\n    mm.set(k, (mm.get(k) ?? 0) + k.length)\n    mm.length\n}\nwork({}, \"k\")",
                "work",
                "map write at its read's probe",
                "names the key again",
            )
        }
        then "a list of flat records is a box a slot" {
            declines(
                "type Pt = { a: int, b: int }\nfn work(n: int) -> int {\n    let pts = [Pt { a: 1, b: 2 }, Pt { a: n, b: 3 }]\n    pts.length\n}\nwork(1)",
                "work",
                "packed lists",
                "flat record",
            )
        }
        then "a list of nullable scalars is a box a slot" {
            declines(
                "fn work(n: int) -> int {\n    let maybe: List<int?> = [n, null]\n    maybe.length\n}\nwork(1)",
                "work",
                "packed lists",
                "nullable scalar",
            )
        }
        then "a `const` seat handed no literal reaches no unit of its own" {
            declines(
                "const JOINED: string = \"a\" + \"b\"\nfn pick(const p: string, s: string) -> int { p.length + s.length }\nfn work(n: int) -> int { pick(JOINED, \"s\") + n }\nwork(1)",
                "work",
                "a unit per settled value",
                "no literal",
            )
        }
        then "a call through a `dyn` box reads its code from the table" {
            declines(
                "trait Show {\n    fn show() -> int\n}\ntype P = { x: int }\nimpl Show for P {\n    fn show() -> int { self.x }\n}\nfn work(d: dyn Show) -> int { d.show() }\nwork(P { x: 2 })",
                "work",
                "devirtualization",
                "table",
            )
        }
    }
    given "a value whose last reads the memory pass places" {
        then "a push in each of two arms moves in each, so nothing declines" {
            said_by(
                filing(
                    "if early {\n        out.push(held)\n    } else {\n        out.push(held)\n    }",
                ),
                "filed",
                "move at last use",
            )
                .is_empty()
        }
        then "a value a loop carries into two arms' pushes declines as the loop's" {
            let said = said_by(
                "fn spread(names: List<string>, name: string) -> int {\n    mut out: List<string> = []\n    mut aside: List<string> = []\n    let held = name + \"!\"\n    for n in names {\n        if n == name { out.push(held) } else { aside.push(held) }\n    }\n    out.length + aside.length\n}\nspread([\"x\"], \"y\")",
                "spread",
                "move at last use",
            )
            said.length == 2 && said.all(it.contains("a loop runs the region again"))
        }
        then "a parameter pushed in two arms declines as borrowed" {
            let said = said_by(
                "fn split(held: string, early: bool) -> int {\n    mut out: List<string> = []\n    mut aside: List<string> = []\n    if early { out.push(held) } else { aside.push(held) }\n    out.length + aside.length\n}\nsplit(\"y\", true)",
                "split",
                "move at last use",
            )
            said.length == 2 && said.all(it.contains("borrowed from the caller"))
        }
        then "a subject one arm yields a view of and another stores declines as yielded" {
            let said = said_by(
                "enum Shape {\n    Named(string)\n    Plain(string)\n}\nfn kept(n: int) -> string {\n    mut held = Shape.Plain(\"z\")\n    let s = if n > 0 { Shape.Named(\"n\${n}\") } else { Shape.Plain(\"p\") }\n    let got = match s {\n        .Named(name) -> name,\n        .Plain(_) -> {\n            held = s\n            \"plain\"\n        },\n    }\n    match held { .Named(x) -> x, .Plain(y) -> \"\${got}\${y}\" }\n}\nkept(1)\n",
                "kept",
                "move at last use",
            )
            said.length == 1 && said.all(it.contains("an arm yields the value or a view riding it"))
        }
        then "a push in an arm that returns moves, so nothing declines" {
            said_by(
                filing(
                    "if early {\n        out.push(held)\n        return out\n    }\n    out.push(held)",
                ),
                "filed",
                "move at last use",
            )
                .is_empty()
        }
        then "a borrow read across a call that may write its cell owns, at the read" {
            let said = said_by(ACROSS_WRITER, "across", "borrows across quiet calls")
            !said.is_empty() && said.all(it.contains("may write a cell"))
        }
    }
    given "a body that declines nothing" {
        then "it has no remarks" {
            remarked(
                "fn work(n: int) -> int {\n    let parts = [n, 2]\n    parts.length + n\n}\nwork(1)",
                "work",
            )
                .is_empty()
        }
    }
}
