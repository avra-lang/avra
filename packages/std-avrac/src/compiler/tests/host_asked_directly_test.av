//! `compiler.host_asked_directly`: a `Host` question asked in the
//! compiler or its CLI outside the door's own file is refused.
use compiler.{avra, new_workspace, findings_of, Finding}
use compiler.host.{memory_host}

const HOST = "type Host = { n: int }\nimpl Host {\n    fn read(p: string) -> string { p }\n    fn exists(p: string) -> bool { p.is_empty() }\n    fn list(p: string) -> List<string> { [p] }\n    fn is_dir(p: string) -> bool { p.is_empty() }\n    fn stamp(p: string) -> int { p.length }\n}\ntype Ws = { host: Host, peek: fn(string) -> string }\n"

/// Findings of the rule over one file, `rel` under the package at `root`.
fn asked_at(root: string, rel: string, body: string) -> int {
    let path = "${root}/src/${rel}"
    let ws = new_workspace(memory_host({"${path}": "${HOST}${body}"}, [path]), root, avra())
    [f for f in findings_of(ws.program(path)) if f.rule == "compiler.host_asked_directly"].length
}

fn in_compiler(body: string) -> int { asked_at("/w/std-avrac", "compiler/x.av", body) }

spec "compiler/idioms (host_asked_directly)" {
    given "a host asked in the compiler" {
        then "`host.read` fires" { in_compiler("fn f(host: Host) -> string { host.read(\"a\") }\n") == 1 }
        then "`.exists` through a field fires" { in_compiler("fn f(ws: Ws) -> bool { ws.host.exists(\"a\") }\n") == 1 }
        then "`.list` fires" { in_compiler("fn f(host: Host) -> List<string> { host.list(\"a\") }\n") == 1 }
        then "`.is_dir` fires" { in_compiler("fn f(host: Host) -> bool { host.is_dir(\"a\") }\n") == 1 }
        then "`.stamp` fires" { in_compiler("fn f(host: Host) -> int { host.stamp(\"a\") }\n") == 1 }
        then "a `peek` through a host fires" {
            in_compiler("type Hp = { host: Ws }\nfn f(h: Hp) -> string { (h.host.peek)(\"a\") }\n") == 1
        }
        then "the CLI is the compiler's too" {
            asked_at("/w/cli", "commands/x.av", "fn f(host: Host) -> string { host.read(\"a\") }\n") == 1
        }
    }
    given "anything else" {
        then "the door's own file asks the host" {
            asked_at(
                "/w/std-avrac",
                "compiler/host/host.av",
                "fn f(host: Host) -> string { host.read(\"a\") }\n",
            ) == 0
        }
        then "a test asks the host" {
            asked_at(
                "/w/std-avrac",
                "compiler/tests/x_test.av",
                "fn f(host: Host) -> string { host.read(\"a\") }\n",
            ) == 0
        }
        then "a package outside the compiler asks the host" {
            asked_at("/w/std-io", "x.av", "fn f(host: Host) -> string { host.read(\"a\") }\n") == 0
        }
        then "a receiver that is no host is not asked" { in_compiler("fn f(cache: Host) -> string { cache.read(\"a\") }\n") == 0 }
        then "a site license clears it" {
            in_compiler(
                "fn f(host: Host) -> string {\n    // LICENSED compiler.host_asked_directly: the disk at this instant\n    host.read(\"a\")\n}\n",
            ) == 0
        }
    }
}
