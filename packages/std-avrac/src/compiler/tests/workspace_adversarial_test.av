// The module system under attack (rt33): names against names across
// files, every misuse of `export` and `use`, impls that cross a
// module's line, and the crossings that must simply work. The
// vertical story lives in workspace_test.av; these are the programs
// that tried to break it.
use @std.avrac.compiler.{avra, new_workspace, analyze_source, Analysis}
use compiler.{Workspace}
use compiler.host.{memory_host}

/// A root file plus whatever the attack adds.
fn package(files: Map<string, string>, names: List<string>) -> Workspace {
    new_workspace(memory_host(files, names), "/w", avra())
}

/// The root file's ONE refusal, saying this.
fn refuses_once(files: Map<string, string>, names: List<string>, saying: string) -> bool {
    let a = package(files, names).analyze_file("/w/src/main.av")
    a.diagnostics.length == 1 && a.report().contains(saying)
}

fn runs(files: Map<string, string>, names: List<string>) -> string? {
    match package(files, names).program("/w/src/main.av").run() {
        .Ok(text) -> text,
        .Err(_) -> null,
    }
}

/// One file's analysis in the package `files` holds.
fn analysed_at(files: Map<string, string>, names: List<string>, at: string) -> Analysis {
    package(files, names).analyze_file(at)
}

/// A test file's own helper, the name every attack below reuses.
fn thing() -> string {
    "fn make_thing() -> int {\n    1\n}\n"
}

/// Where the second test file stands: beside the first when `shared`, in a
/// directory of its own otherwise.
fn b_at(shared: bool) -> string {
    if shared { "/w/src/tests/b_test.av" } else { "/w/src/tests/b/b_test.av" }
}

/// The root file, and a test tree holding `thing` in each of three files — the
/// third always in a directory of its own.
fn tested(shared: bool) -> Map<string, string> {
    mut files = {
        "/w/src/main.av": "1\n",
        "/w/src/tests/a_test.av": thing(),
        "/w/src/tests/c/c_test.av": thing(),
    }
    files.set(b_at(shared), thing())
    files
}

fn tested_names(shared: bool) -> List<string> {
    ["/w/src/main.av", "/w/src/tests/a_test.av", b_at(shared), "/w/src/tests/c/c_test.av"]
}

fn twice() -> string {
    "export fn twice(n: int) -> int {\n    n * 2\n}\n"
}

fn pair() -> string {
    "export type Pair = { a: int, b: int }\n"
}

/// The root program over a vendored `@acme/util` whose one file
/// is `p` — the main file's text is the attack, its `use` included.
fn vendored_over(p: string, main: string) -> Map<string, string> {
    {
        "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@acme/util\" = { path = \"vendor/util\" }\n",
        "/w/src/main.av": main,
        "/w/vendor/util/avra.toml": "[package]\nname = \"@acme/util\"\nversion = \"0.1.0\"\n",
        "/w/vendor/util/src/p.av": p,
    }
}

/// The vendored `Pair`, used by the main file.
fn vendored(main: string) -> Map<string, string> {
    vendored_over(pair(), "use @acme.util.{Pair}\n${main}")
}

/// The vendored `Pair` beside a vendored trait.
fn vendored_show(main: string) -> Map<string, string> {
    vendored_over(
        "${pair()}export trait Show {\n    fn show() -> string\n}\n",
        "use @acme.util.{Pair, Show}\n${main}",
    )
}

fn vendored_names() -> List<string> {
    ["/w/avra.toml", "/w/src/main.av", "/w/vendor/util/avra.toml", "/w/vendor/util/src/p.av"]
}

/// A sibling file declaring its own private `helper`, and an export
/// that calls it.
fn own_helper(times: int, export_name: string) -> string {
    "fn helper(n: int) -> int {\n    n * ${times}\n}\nexport fn ${export_name}() -> int {\n    helper(1)\n}\n"
}

/// A sibling file declaring its own private `Table` with a `get`, and
/// an export that reads it.
fn own_table(field: string, value: string, export_name: string) -> string {
    "type Table = { ${field}: int }\nimpl Table {\n    fn get() -> int {\n        self.${field}\n    }\n}\nexport fn ${export_name}() -> int {\n    Table { ${field}: ${value} }.get()\n}\n"
}

spec "compiler/workspace (adversarial)" {
    given "private names two files declare" {
        then "each file keeps its own — the entry's and a sibling's run side by side" {
            runs(
                {
                    "/w/src/main.av": "fn helper(n: int) -> int {\n    n * 5\n}\nhelper(1) + from_a()\n",
                    "/w/src/a.av": own_helper(7, "from_a"),
                },
                ["/w/src/main.av", "/w/src/a.av"],
            ) == "12"
        }
        then "a third file's read of the name is refused, naming both files" {
            refuses_once(
                {
                    "/w/src/main.av": "helper(1)\n",
                    "/w/src/a.av": own_helper(2, "from_a"),
                    "/w/src/b.av": own_helper(3, "from_b"),
                },
                ["/w/src/main.av", "/w/src/a.av", "/w/src/b.av"],
                "`helper` is private to each of `a.av` and `b.av`",
            )
        }
        then "a third file's plain read of the name is refused the same way" {
            refuses_once(
                {
                    "/w/src/main.av": "let f = helper\nf(1)\n",
                    "/w/src/a.av": own_helper(2, "from_a"),
                    "/w/src/b.av": own_helper(3, "from_b"),
                },
                ["/w/src/main.av", "/w/src/a.av", "/w/src/b.av"],
                "`helper` is private to each of `a.av` and `b.av`",
            )
        }
        then "two files' private types of one name keep their own methods" {
            runs(
                {
                    "/w/src/main.av": "from_a() + from_b()\n",
                    "/w/src/a.av": own_table("n", "4", "from_a"),
                    "/w/src/b.av": own_table("m", "30", "from_b"),
                },
                ["/w/src/main.av", "/w/src/a.av", "/w/src/b.av"],
            ) == "34"
        }
        then "a kept-apart type named in a third file's signature is refused as kept apart" {
            refuses_once(
                {
                    "/w/src/main.av": "fn f(t: Table) -> int {\n    1\n}\nf\n",
                    "/w/src/a.av": own_table("n", "4", "from_a"),
                    "/w/src/b.av": own_table("m", "30", "from_b"),
                },
                ["/w/src/main.av", "/w/src/a.av", "/w/src/b.av"],
                "`Table` is private to each of `a.av` and `b.av`",
            )
        }
        then "an import shadows a sibling's private name in the importing file alone" {
            runs(
                {
                    "/w/src/main.av": "use util.{twice}\ntwice(2) + from_a()\n",
                    "/w/src/a.av": "fn twice(n: int) -> int {\n    n\n}\nexport fn from_a() -> int {\n    twice(10)\n}\n",
                    "/w/src/util/m.av": twice(),
                },
                ["/w/src/main.av", "/w/src/a.av", "/w/src/util/m.av"],
            ) == "14"
        }
        then "an import of a name this file keeps apart refuses" {
            refuses_once(
                {
                    "/w/src/main.av": "use util.{twice}\nfn twice(n: int) -> int {\n    n\n}\ntwice(1)\n",
                    "/w/src/a.av": "fn twice(n: int) -> int {\n    n\n}\n",
                    "/w/src/util/m.av": twice(),
                },
                ["/w/src/main.av", "/w/src/a.av", "/w/src/util/m.av"],
                "`twice` is imported, but this module (`main.av`) already has it",
            )
        }
        then "a third file's local binding shadows a kept-apart name" {
            runs(
                {
                    "/w/src/main.av": "let helper = 9\nhelper\n",
                    "/w/src/a.av": own_helper(2, "from_a"),
                    "/w/src/b.av": own_helper(3, "from_b"),
                },
                ["/w/src/main.av", "/w/src/a.av", "/w/src/b.av"],
            ) == "9"
        }
        then "a third file declaring the name keeps its own apart too" {
            runs(
                {
                    "/w/src/main.av": "fn helper(n: int) -> int {\n    n + 100\n}\nhelper(1) + from_a() + from_b()\n",
                    "/w/src/a.av": own_helper(2, "from_a"),
                    "/w/src/b.av": own_helper(3, "from_b"),
                },
                ["/w/src/main.av", "/w/src/a.av", "/w/src/b.av"],
            ) == "106"
        }
        then "a fn and a type of one name are two tables, so neither is kept apart" {
            runs(
                {
                    "/w/src/main.av": "Table { n: 2 }.n + Table()\n",
                    "/w/src/a.av": "type Table = { n: int }\n",
                    "/w/src/b.av": "fn Table() -> int {\n    40\n}\n",
                },
                ["/w/src/main.av", "/w/src/a.av", "/w/src/b.av"],
            ) == "42"
        }
        then "a private name declared twice in one file still refuses there" {
            refuses_once(
                {
                    "/w/src/main.av": "fn helper(n: int) -> int {\n    n\n}\nfn helper(n: int) -> int {\n    n\n}\nhelper(1)\n",
                    "/w/src/a.av": own_helper(2, "from_a"),
                },
                ["/w/src/main.av", "/w/src/a.av"],
                "`helper` is defined more than once",
            )
        }
    }
    given "re-exports" {
        then "a re-exported name reaches an importer of the re-exporting module" {
            runs(
                {
                    "/w/src/main.av": "use facade.{twice}\ntwice(3)\n",
                    "/w/src/facade/f.av": "export use util.{twice}\n",
                    "/w/src/util/m.av": twice(),
                },
                ["/w/src/main.av", "/w/src/facade/f.av", "/w/src/util/m.av"],
            ) == "6"
        }
        then "a re-export under `as` is exported under its alias" {
            runs(
                {
                    "/w/src/main.av": "use facade.{double}\ndouble(3)\n",
                    "/w/src/facade/f.av": "export use util.{twice as double}\n",
                    "/w/src/util/m.av": twice(),
                },
                ["/w/src/main.av", "/w/src/facade/f.av", "/w/src/util/m.av"],
            ) == "6"
        }
        then "a chain of re-exports reaches the declaration" {
            runs(
                {
                    "/w/src/main.av": "use outer.{twice}\ntwice(4)\n",
                    "/w/src/outer/o.av": "export use facade.{twice}\n",
                    "/w/src/facade/f.av": "export use util.{twice}\n",
                    "/w/src/util/m.av": twice(),
                },
                ["/w/src/main.av", "/w/src/outer/o.av", "/w/src/facade/f.av", "/w/src/util/m.av"],
            ) == "8"
        }
        then "a re-exported type builds and reads like its original" {
            runs(
                {
                    "/w/src/main.av": "use facade.{Pair}\nlet p = Pair { a: 2, b: 5 }\np.a + p.b\n",
                    "/w/src/facade/f.av": "export use util.{Pair}\n",
                    "/w/src/util/m.av": pair(),
                },
                ["/w/src/main.av", "/w/src/facade/f.av", "/w/src/util/m.av"],
            ) == "7"
        }
        then "an importer's own declaration of a re-exported name refuses" {
            refuses_once(
                {
                    "/w/src/main.av": "use facade.{twice}\nfn twice(n: int) -> int {\n    n\n}\ntwice(1)\n",
                    "/w/src/facade/f.av": "export use util.{twice}\n",
                    "/w/src/util/m.av": twice(),
                },
                ["/w/src/main.av", "/w/src/facade/f.av", "/w/src/util/m.av"],
                "`twice` is imported, but this module (`main.av`) already has it",
            )
        }
        then "the re-exporting file reads the name itself" {
            runs(
                {
                    "/w/src/main.av": "use facade.{quad}\nquad(2)\n",
                    "/w/src/facade/f.av": "export use util.{twice}\nexport fn quad(n: int) -> int {\n    twice(twice(n))\n}\n",
                    "/w/src/util/m.av": twice(),
                },
                ["/w/src/main.av", "/w/src/facade/f.av", "/w/src/util/m.av"],
            ) == "8"
        }
        then "a re-export cycle is refused as reaching no declaration" {
            analysed_at(
                {
                    "/w/src/main.av": "use a.{x}\nx()\n",
                    "/w/src/a/a.av": "export use b.{x}\n",
                    "/w/src/b/b.av": "export use a.{x}\n",
                },
                ["/w/src/main.av", "/w/src/a/a.av", "/w/src/b/b.av"],
                "/w/src/main.av",
            )
                .report()
                .contains("`a` re-exports `x`, and no declaration stands behind it")
        }
        then "a re-export of an item its module does not export refuses as not exported" {
            refuses_once(
                {
                    "/w/src/main.av": "export use util.{hidden}\n1\n",
                    "/w/src/util/m.av": "fn hidden() -> int {\n    1\n}\n",
                },
                ["/w/src/main.av", "/w/src/util/m.av"],
                "`util` does not export `hidden`",
            )
        }
        then "two files re-exporting two declarations under one name: the later is refused" {
            let a = analysed_at(
                {
                    "/w/src/main.av": "1\n",
                    "/w/src/facade/a.av": "export use util.{twice}\n",
                    "/w/src/facade/b.av": "export use other.{twice}\n",
                    "/w/src/util/m.av": twice(),
                    "/w/src/other/m.av": twice(),
                },
                [
                    "/w/src/main.av",
                    "/w/src/facade/a.av",
                    "/w/src/facade/b.av",
                    "/w/src/util/m.av",
                    "/w/src/other/m.av",
                ],
                "/w/src/facade/b.av",
            )
            a.diagnostics.length == 1 &&
                a.report().contains("`twice` is already on this module's surface")
        }
        then "two files re-exporting one declaration agree" {
            let a = analysed_at(
                {
                    "/w/src/main.av": "1\n",
                    "/w/src/facade/a.av": "export use util.{twice}\n",
                    "/w/src/facade/b.av": "export use util.{twice}\n",
                    "/w/src/util/m.av": twice(),
                },
                ["/w/src/main.av", "/w/src/facade/a.av", "/w/src/facade/b.av", "/w/src/util/m.av"],
                "/w/src/facade/b.av",
            )
            a.diagnostics.is_empty()
        }
        then "a re-export claims its name against a sibling's private declaration" {
            let a = analysed_at(
                {
                    "/w/src/main.av": "1\n",
                    "/w/src/facade/a.av": "fn twice(n: int) -> int {\n    n\n}\n",
                    "/w/src/facade/b.av": "export use util.{twice}\n",
                    "/w/src/util/m.av": twice(),
                },
                ["/w/src/main.av", "/w/src/facade/a.av", "/w/src/facade/b.av", "/w/src/util/m.av"],
                "/w/src/facade/b.av",
            )
            a.diagnostics.length == 1 &&
                a
                    .report()
                    .contains("`twice` is imported, but this module (`facade/a.av`) already has it")
        }
        then "a re-export of a name its own file declares refuses" {
            let a = analysed_at(
                {
                    "/w/src/main.av": "1\n",
                    "/w/src/facade/a.av": "export use util.{twice}\nexport fn twice(n: int) -> int {\n    n\n}\n",
                    "/w/src/util/m.av": twice(),
                },
                ["/w/src/main.av", "/w/src/facade/a.av", "/w/src/util/m.av"],
                "/w/src/facade/a.av",
            )
            a.diagnostics.length == 1 &&
                a.report().contains("`twice` is already on this module's surface")
        }
        then "a re-export from a package that already uses this one is refused as a cycle" {
            let files = {
                "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n",
                "/w/src/main.av": "use @std.low.{g}\ng()\n",
                "/std/std-low/avra.toml": "[package]\nname = \"@std/low\"\nversion = \"0.1.0\"\n",
                "/std/std-low/src/low.av": "export fn g() -> int {\n    1\n}\nexport use @std.high.{h}\n",
                "/std/std-high/avra.toml": "[package]\nname = \"@std/high\"\nversion = \"0.1.0\"\n",
                "/std/std-high/src/high.av": "use @std.low.{g}\nexport fn h() -> int {\n    g() + 1\n}\n",
            }
            let a = new_workspace(
                memory_host(
                    files,
                    [
                        "/w/avra.toml",
                        "/w/src/main.av",
                        "/std/std-low/avra.toml",
                        "/std/std-low/src/low.av",
                        "/std/std-high/avra.toml",
                        "/std/std-high/src/high.av",
                    ],
                ) with { std_root: "/std" },
                "/std/std-low",
                avra(),
            )
                .analyze_file("/std/std-low/src/low.av")
            a
                .report()
                .contains(
                    "`@std/high` already uses `@std/low`, so re-exporting from it here would close a package cycle",
                )
        }
        then "a mistyped item's help names the re-exported ones" {
            refuses_once(
                {
                    "/w/src/main.av": "use facade.{twicee}\n1\n",
                    "/w/src/facade/f.av": "export use util.{twice}\n",
                    "/w/src/util/m.av": twice(),
                },
                ["/w/src/main.av", "/w/src/facade/f.av", "/w/src/util/m.av"],
                "twice",
            )
        }
    }
    given "names against names" {
        then "a private fn duplicating a sibling's exported one refuses — the sibling named" {
            refuses_once(
                {
                    "/w/src/main.av": "fn helper(n: int) -> int {\n    n * 5\n}\nhelper(1)\n",
                    "/w/src/a.av": "export fn helper(n: int) -> int {\n    n\n}\n",
                },
                ["/w/src/main.av", "/w/src/a.av"],
                "`helper` is declared twice in this module — here and in `a.av`",
            )
        }
        then "two test files beside each other each keep their own private helper" {
            [analysed_at(tested(true), tested_names(true), at) for at in tested_names(true)]
                .all(it.diagnostics.is_empty())
        }
        then "a test file in a directory of its own redeclares its siblings' helper with no refusal" {
            [analysed_at(tested(false), tested_names(false), at) for at in tested_names(false)]
                .all(it.diagnostics.is_empty())
        }
        then "a helper declared twice in one test file still refuses" {
            let a = analysed_at(
                {"/w/src/main.av": "1\n", "/w/src/tests/a_test.av": thing() + thing()},
                ["/w/src/main.av", "/w/src/tests/a_test.av"],
                "/w/src/tests/a_test.av",
            )
            a.diagnostics.length == 1 &&
                a.report().contains("`make_thing` is defined more than once")
        }
        then "an import shadowed by a local declaration refuses" {
            refuses_once(
                {
                    "/w/src/main.av": "use util.{twice}\nfn twice(n: int) -> int {\n    n\n}\ntwice(1)\n",
                    "/w/src/util/m.av": twice(),
                },
                ["/w/src/main.av", "/w/src/util/m.av"],
                "`twice` is imported, but this module (`main.av`) already has it",
            )
        }
        then "the same item listed twice in one use refuses" {
            refuses_once(
                {
                    "/w/src/main.av": "use util.{twice, twice}\ntwice(1)\n",
                    "/w/src/util/m.av": twice(),
                },
                ["/w/src/main.av", "/w/src/util/m.av"],
                "`twice` is listed twice",
            )
        }
        then "the same name from two modules refuses" {
            refuses_once(
                {
                    "/w/src/main.av": "use x.{f}\nuse y.{f}\nf()\n",
                    "/w/src/x/a.av": "export fn f() -> int {\n    1\n}\n",
                    "/w/src/y/b.av": "export fn f() -> int {\n    2\n}\n",
                },
                ["/w/src/main.av", "/w/src/x/a.av", "/w/src/y/b.av"],
                "`f` is imported, but `x` already has it",
            )
        }
        then "importing a declaration already visible as a sibling is redundant, not a clash" {
            runs(
                {
                    "/w/src/main.av": "use solo.{only}\nonly(4)\n",
                    "/w/src/solo.av": "export fn only(n: int) -> int {\n    n\n}\n",
                },
                ["/w/src/main.av", "/w/src/solo.av"],
            ) == "4"
        }
        then "a directory and a file of one name refuse together" {
            refuses_once(
                {
                    "/w/src/main.av": "use util.{twice}\ntwice(1)\n",
                    "/w/src/util.av": twice(),
                    "/w/src/util/m.av": twice(),
                },
                ["/w/src/main.av", "/w/src/util.av", "/w/src/util/m.av"],
                "`util` is both a directory and a file under the root",
            )
        }
    }
    given "export, misused" {
        then "on a let" {
            refuses_once(
                {"/w/src/main.av": "export let x = 1\nx\n"},
                ["/w/src/main.av"],
                "`export` marks a fn, type, enum or trait — not this statement",
            )
        }
        then "on an impl — its methods travel with the type" {
            refuses_once(
                {
                    "/w/src/main.av": "type P = { x: int }\nexport impl P {\n    fn get() -> int {\n        self.x\n    }\n}\nP { x: 3 }.get()\n",
                },
                ["/w/src/main.av"],
                "an impl is not exported — its methods travel with their type",
            )
        }
        then "written twice" {
            refuses_once(
                {"/w/src/main.av": "export export fn f() -> int {\n    1\n}\nf()\n"},
                ["/w/src/main.av"],
                "`export` written twice",
            )
        }
    }
    given "use, misplaced" {
        then "inside a fn body" {
            refuses_once(
                {
                    "/w/src/main.av": "fn one() -> int {\n    use util.{twice}\n    1\n}\none()\n",
                    "/w/src/util/m.av": twice(),
                },
                ["/w/src/main.av", "/w/src/util/m.av"],
                "use lines live at the top level",
            )
        }
        then "in a file outside any package" {
            let a = analyze_source("use util.{twice}\n1\n")
            a.diagnostics.length == 1 &&
                a.report().contains("this file is not in a package — `use` needs a root")
        }
    }
    given "impls across the line" {
        then "a sibling module's type takes a method — one package, one owner" {
            runs(
                {
                    "/w/src/main.av": "use util.{Pair}\nimpl Pair {\n    fn sum() -> int {\n        self.a + self.b\n    }\n}\nPair { a: 1, b: 2 }.sum()\n",
                    "/w/src/util/p.av": pair(),
                },
                ["/w/src/main.av", "/w/src/util/p.av"],
            ) == "3"
        }
        then "an impl of a dependency's type is an orphan — and its body does not crash the walk" {
            refuses_once(
                vendored(
                    "impl Pair {\n    fn sum() -> int {\n        self.a + self.b\n    }\n}\n1\n",
                ),
                vendored_names(),
                "`impl Pair` belongs in package `@acme.util`, where `Pair` is declared",
            )
        }
        then "an orphan's method reading a param does not crash the walk either" {
            refuses_once(
                vendored(
                    "impl Pair {\n    fn plus(n: int) -> int {\n        self.a + n\n    }\n}\n1\n",
                ),
                vendored_names(),
                "`impl Pair` belongs in package `@acme.util`",
            )
        }
        then "an orphan's method, called, speaks the orphan alone" {
            refuses_once(
                vendored(
                    "impl Pair {\n    fn sum() -> int {\n        self.a + self.b\n    }\n}\nPair { a: 1, b: 2 }.sum()\n",
                ),
                vendored_names(),
                "`impl Pair` belongs in package `@acme.util`",
            )
        }
        then "a dependency's type takes a LOCAL trait's methods" {
            runs(
                vendored(
                    "trait Show {\n    fn show() -> string\n}\nimpl Show for Pair {\n    fn show() -> string {\n        \"pair\"\n    }\n}\nPair { a: 1, b: 2 }.show()\n",
                ),
                vendored_names(),
            ) == "pair"
        }
        then "a dependency's trait for a dependency's type is an orphan — the impl named as written" {
            refuses_once(
                vendored_show(
                    "impl Show for Pair {\n    fn show() -> string {\n        \"pair\"\n    }\n}\n1\n",
                ),
                vendored_names(),
                "`impl Show for Pair` belongs in package `@acme.util`, where `Pair` is declared",
            )
        }
        then "a local trait may be implemented for a foreign type" {
            runs(
                {
                    "/w/src/main.av": "use util.{Pair}\ntrait Show {\n    fn show() -> string\n}\nimpl Show for Pair {\n    fn show() -> string {\n        \"pair\"\n    }\n}\nPair { a: 1, b: 2 }.show()\n",
                    "/w/src/util/p.av": pair(),
                },
                ["/w/src/main.av", "/w/src/util/p.av"],
            ) == "pair"
        }
        then "a method declared beside its type in another file dispatches" {
            runs(
                {
                    "/w/src/main.av": "use util.{Pair}\nPair { a: 1, b: 2 }.sum()\n",
                    "/w/src/util/p.av": "${pair()}impl Pair {\n    fn sum() -> int {\n        self.a + self.b\n    }\n}\n",
                },
                ["/w/src/main.av", "/w/src/util/p.av"],
            ) == "3"
        }
        then "a foreign trait, implemented locally, reaches through dyn" {
            runs(
                {
                    "/w/src/main.av": "use util.{Show}\ntype P = { x: int }\nimpl Show for P {\n    fn show() -> string {\n        \"p\"\n    }\n}\nlet d: dyn Show = P { x: 1 }\nd.show()\n",
                    "/w/src/util/t.av": "export trait Show {\n    fn show() -> string\n}\n",
                },
                ["/w/src/main.av", "/w/src/util/t.av"],
            ) == "p"
        }
        then "two modules may each declare a type of one name with one method — the symbols differ" {
            runs(
                {
                    "/w/src/main.av": "use x.{make_a}\nuse y.{make_b}\nmake_a().v() + make_b().v()\n",
                    "/w/src/x/a.av": "export type P = { n: int }\nimpl P {\n    fn v() -> int {\n        self.n\n    }\n}\nexport fn make_a() -> P {\n    P { n: 1 }\n}\n",
                    "/w/src/y/b.av": "export type P = { n: int }\nimpl P {\n    fn v() -> int {\n        self.n * 10\n    }\n}\nexport fn make_b() -> P {\n    P { n: 2 }\n}\n",
                },
                ["/w/src/main.av", "/w/src/x/a.av", "/w/src/y/b.av"],
            ) == "21"
        }
    }
    given "crossings that must simply work" {
        then "mutual recursion across two files" {
            runs(
                {
                    "/w/src/main.av": "use a.{fa}\nfa(3)\n",
                    "/w/src/a/a.av": "use b.{fb}\nexport fn fa(n: int) -> int {\n    if n > 0 { fb(n - 1) } else { 0 }\n}\n",
                    "/w/src/b/b.av": "use a.{fa}\nexport fn fb(n: int) -> int {\n    fa(n) + 10\n}\n",
                },
                ["/w/src/main.av", "/w/src/a/a.av", "/w/src/b/b.av"],
            ) == "30"
        }
        then "a foreign generic takes a lambda" {
            runs(
                {
                    "/w/src/main.av": "use util.{apply}\napply(3, (n: int) -> n * 7)\n",
                    "/w/src/util/g.av": "export fn apply<T>(x: T, f: fn(T) -> T) -> T {\n    f(x)\n}\n",
                },
                ["/w/src/main.av", "/w/src/util/g.av"],
            ) == "21"
        }
        then "strings cross the line and come back owned" {
            runs(
                {
                    "/w/src/main.av": "use util.{greet, rep}\nlet s = greet(\"avra\")\n\"\${rep(s, 2)}!\".length\n",
                    "/w/src/util/s.av": "export fn greet(name: string) -> string {\n    \"hi \${name}\"\n}\nexport fn rep(s: string, n: int) -> string {\n    if n == 0 { \"\" } else { \"\${s}\${rep(s, n - 1)}\" }\n}\n",
                },
                ["/w/src/main.av", "/w/src/util/s.av"],
            ) == "15"
        }
    }
    given "a field default is a body of its module" {
        then "a foreign record's defaults fill a literal here — an int and a managed string" {
            runs(
                {
                    "/w/src/main.av": "use util.{P}\nlet p = P {}\np.x * 100 + p.tag.length\n",
                    "/w/src/util/shapes.av": "export type P = { x: int = 3, tag: string = \"t-\${1 + 2}\" }\n",
                },
                ["/w/src/main.av", "/w/src/util/shapes.av"],
            ) == "303"
        }
        then "a default may call its module's PRIVATE fn — the literal's file never sees the name" {
            runs(
                {
                    "/w/src/main.av": "use util.{Q}\nQ {}.x\n",
                    "/w/src/util/shapes.av": "fn twice(n: int) -> int {\n    n * 2\n}\nexport type Q = { x: int = twice(21) }\n",
                },
                ["/w/src/main.av", "/w/src/util/shapes.av"],
            ) == "42"
        }
        then "a generic record's default instantiates under the literal's arguments" {
            runs(
                {
                    "/w/src/main.av": "use util.{Pair}\nlet p = Pair { a: 1 }\np.rest.length + 5\n",
                    "/w/src/util/shapes.av": "export type Pair<T> = { a: T, rest: List<T> = [] }\n",
                },
                ["/w/src/main.av", "/w/src/util/shapes.av"],
            ) == "5"
        }
        then "a default reading its file's top-level binding refuses in ITS file, not the literal's" {
            let ws = package(
                {
                    "/w/src/main.av": "use util.{Q}\nQ {}.y\n",
                    "/w/src/util/shapes.av": "let k = 3\nexport type Q = { y: int = k }\n",
                },
                ["/w/src/main.av", "/w/src/util/shapes.av"],
            )
            let shapes = ws.analyze_file("/w/src/util/shapes.av")
            ws.analyze_file("/w/src/main.av").clean() &&
                shapes.diagnostics.length == 1 &&
                shapes.report().contains("`k` is a run-time binding of the top level")
        }
    }
    given "a type's methods are one namespace across its module's files" {
        then "the same method in two files of one module clashes at the LATER file, only" {
            let ws = package(
                {
                    "/w/src/main.av": "use util.{P}\nP { x: 1 }.show()\n",
                    "/w/src/util/a.av": "export type P = { x: int }\nimpl P {\n    fn show() -> int {\n        self.x\n    }\n}\n",
                    "/w/src/util/b.av": "impl P {\n    fn show() -> int {\n        self.x + 1\n    }\n}\n",
                },
                ["/w/src/main.av", "/w/src/util/a.av", "/w/src/util/b.av"],
            )
            let later = ws.analyze_file("/w/src/util/b.av")
            ws.analyze_file("/w/src/util/a.av").clean() &&
                later.diagnostics.length == 1 &&
                later.report().contains("`P.show` is declared twice")
        }
    }
}
