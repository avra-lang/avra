// Whether a call may reach a cancel point (`Family.CancelReach`): a
// whole-program fixpoint over the calls each body makes, seeded by a
// row that may switch the task out, a read that waits, a spawn, a
// `while`, and a call through a value. A held fn answers from its
// interface, where the bit is contract.
use compiler.{Workspace}
use compiler.host.{memory_host}
use compiler.record.{read_fields, iface_digest}
use core.{DeclId, flatten}
use @std.avrac.testing.{provided, test_workspace}
use @std.avrac.compiler.{Program}

const REACH_PATH: string = "/w/src/main.av"

fn reach_workspace(main: string) -> Workspace {
    test_workspace(
        memory_host(
            {
                "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n",
                "/w/src/main.av": main,
            },
            ["/w/avra.toml", REACH_PATH],
        ),
        "/w",
    )
}

fn reach_decl(ws: Workspace, name: string) -> DeclId {
    [x.id for x in ws.decls.all_decls() if x.name == name][0]
}

/// The program analysed, then each named fn's answer, `name=0|1`.
fn reaching(lines: List<string>, names: List<string>) -> string {
    let ws = reach_workspace(lines.concat([""]).join("\n"))
    let _ = ws.analyze_file(REACH_PATH)
    [reach_word(ws, n) for n in names].join(" ")
}

fn reach_word(ws: Workspace, name: string) -> string {
    "${name}=${if ws.reaches_cancel(reach_decl(ws, name)) { 1 } else { 0 }}"
}

/// A sleeping fn, the seed most cases call.
fn napping() -> List<string> {
    ["extern fn avra_fiber_sleep(ms: int)", "fn nap() { avra_fiber_sleep(1) }"]
}

/// Each named fn's two bits, `name=ps`: `p` where it parks, `s` where it
/// spins, `-` where it does neither.
fn bits_of(lines: List<string>, names: List<string>) -> string {
    let ws = reach_workspace(lines.concat([""]).join("\n"))
    let _ = ws.analyze_file(REACH_PATH)
    [bits_word(ws, n) for n in names].join(" ")
}

fn bits_word(ws: Workspace, name: string) -> string {
    let r = ws.reach_of(reach_decl(ws, name))
    "${name}=${if r.parks { "p" } else { "-" }}${if r.spins { "s" } else { "-" }}"
}

/// A fn whose only cancel point is a `while`'s back-edge.
fn spinning() -> List<string> {
    ["fn spin() {", "    mut i = 0", "    while i < 3 { i = i + 1 }", "}"]
}

spec "compiler/cancel_reach — the two bits" {
    then "a row parks and a `while` spins, each to its callers, and a fn calling both holds both" {
        bits_of(
            napping()
                .concat(spinning())
                .concat(
                    [
                        "fn naps() { nap() }",
                        "fn spins() { spin() }",
                        "fn both() {",
                        "    naps()",
                        "    spins()",
                        "}",
                        "fn plain() -> int { 1 }",
                        "plain()",
                    ],
                ),
            ["nap", "spin", "naps", "spins", "both", "plain"],
        ) == "nap=p- spin=-s naps=p- spins=-s both=ps plain=--"
    }
    then "a call through a value parks and spins — a value may be any fn" {
        bits_of(["fn call(f: fn() -> int) -> int { f() }", "call(() -> 1)"], ["call"]) == "call=ps"
    }
    then "a cycle takes both bits of whatever it reaches" {
        bits_of(
            napping()
                .concat(spinning())
                .concat(
                    [
                        "fn a(n: int) {",
                        "    if n > 0 { b(n - 1) }",
                        "    nap()",
                        "}",
                        "fn b(n: int) {",
                        "    if n > 0 { a(n - 1) }",
                        "    spin()",
                        "}",
                        "a(2)",
                    ],
                ),
            ["a", "b"],
        ) == "a=ps b=ps"
    }
}

spec "compiler/cancel_reach — a row that may switch the task out" {
    then "the fn calling it, its caller and its caller's caller answer 1; a fn calling neither answers 0" {
        reaching(
            napping()
                .concat(
                    [
                        "fn later() {",
                        "    nap()",
                        "}",
                        "fn later_still() { later() }",
                        "fn plain() -> int { 1 }",
                        "plain()",
                    ],
                ),
            ["nap", "later", "later_still", "plain"],
        ) == "nap=1 later=1 later_still=1 plain=0"
    }
    then "a row that cannot switch the task out reaches nothing" {
        reaching(
            ["extern fn avra_now_ns() -> int", "fn clock() -> int { avra_now_ns() }", "clock()"],
            ["clock"],
        ) == "clock=0"
    }
}

spec "compiler/cancel_reach — loops" {
    then "a fn holding a `while` answers 1" {
        reaching(
            [
                "fn spin(n: int) -> int {",
                "    mut i = 0",
                "    while i < n { i = i + 1 }",
                "    i",
                "}",
                "spin(3)",
            ],
            ["spin"],
        ) == "spin=1"
    }
    then "a fn holding only a `for` over a range answers 0" {
        reaching(
            [
                "fn count(n: int) -> int {",
                "    mut s = 0",
                "    for i in 0..n { s = s + i }",
                "    s",
                "}",
                "count(3)",
            ],
            ["count"],
        ) == "count=0"
    }
    then "a `while` in one fn is not another fn's" {
        reaching(
            [
                "fn spin(n: int) -> int {",
                "    mut i = 0",
                "    while i < n { i = i + 1 }",
                "    i",
                "}",
                "fn beside() -> int { 2 }",
                "spin(3) + beside()",
            ],
            ["beside"],
        ) == "beside=0"
    }
}

spec "compiler/cancel_reach — calls through a value" {
    then "a fn calling its fn-typed parameter answers 1" {
        reaching(["fn run(f: fn() -> int) -> int { f() }", "run(() -> 1)"], ["run"]) == "run=1"
    }
    then "a lambda's call is its maker's: a maker handing a sleeping lambda to a list method answers 1" {
        reaching(
            napping()
                .concat(
                    [
                        "fn napped(x: int) -> bool {",
                        "    nap()",
                        "    x > 1",
                        "}",
                        "fn any_napped(xs: List<int>) -> bool { xs.any((x: int) -> napped(x)) }",
                        "any_napped([1])",
                    ],
                ),
            ["any_napped"],
        ) == "any_napped=1"
    }
    then "a call on a call's answer answers 1, though the first call reaches nothing" {
        reaching(
            ["fn make() -> fn() -> int { () -> 1 }", "fn calls() -> int { make()() }", "calls()"],
            ["make", "calls"],
        ) == "make=0 calls=1"
    }
    then "a call through a fn-typed field answers 1" {
        reaching(
            [
                "type Cx = { get: fn() -> int }",
                "fn fielded(c: Cx) -> int { c.get() }",
                "fielded(Cx { get: () -> 1 })",
            ],
            ["fielded"],
        ) == "fielded=1"
    }
    then "a contract's method answers 1, whatever its impls do" {
        reaching(
            [
                "trait Show {",
                "    fn show() -> string",
                "}",
                "type P = { n: int }",
                "impl Show for P {",
                "    fn show() -> string { \"p\" }",
                "}",
                "fn shown(s: dyn Show) -> string { s.show() }",
                "shown(P { n: 1 })",
            ],
            ["shown"],
        ) == "shown=1"
    }
}

spec "compiler/cancel_reach — methods" {
    then "a call to a declared method answers that method's answer" {
        reaching(
            napping()
                .concat(
                    [
                        "type Clock = { n: int }",
                        "impl Clock {",
                        "    fn tick() { nap() }",
                        "    fn read() -> int { self.n }",
                        "}",
                        "fn ticks(c: Clock) { c.tick() }",
                        "fn reads(c: Clock) -> int { c.read() }",
                        "reads(Clock { n: 1 })",
                    ],
                ),
            ["tick", "read", "ticks", "reads"],
        ) == "tick=1 read=0 ticks=1 reads=0"
    }
}

spec "compiler/cancel_reach — tasks" {
    then "a spawner answers 1: its task is joined where its scope ends" {
        reaching(
            [
                "fn work(n: int) -> int { n * 2 }",
                "fn spawner() {",
                "    let t = spawn work(2)",
                "}",
                "spawner()",
            ],
            ["work", "spawner"],
        ) == "work=0 spawner=1"
    }
    then "an `.await` answers 1 and a `.done` answers 0, with no spawn beside either" {
        reaching(
            [
                "fn work(n: int) -> int { n * 2 }",
                "fn awaits(t: Task<int>) -> int { t.await }",
                "fn reader(t: Task<int>) -> bool { t.done }",
                "fn spawner() -> int {",
                "    let t = spawn work(2)",
                "    awaits(t)",
                "}",
                "spawner()",
            ],
            ["awaits", "reader"],
        ) == "awaits=1 reader=0"
    }
}

spec "compiler/cancel_reach — recursion" {
    then "a cycle that reaches nothing settles at 0" {
        reaching(
            [
                "fn a(n: int) -> int { if n > 0 { b(n - 1) } else { 0 } }",
                "fn b(n: int) -> int { a(n) }",
                "a(3)",
            ],
            ["a", "b"],
        ) == "a=0 b=0"
    }
    then "a cycle with a row in it answers 1 at every member" {
        reaching(
            napping()
                .concat(
                    [
                        "fn a(n: int) -> int { if n > 0 { b(n - 1) } else { 0 } }",
                        "fn b(n: int) -> int {",
                        "    nap()",
                        "    a(n)",
                        "}",
                        "a(3)",
                    ],
                ),
            ["a", "b"],
        ) == "a=1 b=1"
    }
}

/// The record lines of the program's file, and a fresh workspace
/// that holds the file from them alone.
fn held_from(lines: List<string>) -> Workspace { held_reading(lines, (line) -> line) }

/// As `held_from`, each record line passed through `edited` first.
fn held_reading(lines: List<string>, edited: fn(string) -> string) -> Workspace {
    let source = lines.concat([""]).join("\n")
    let parsed = reach_workspace(source)
    let _ = parsed.analyze_file(REACH_PATH)
    let f? = parsed.decls.known_file_id(REACH_PATH) else { return parsed }
    let records = [parsed.record_line(parsed.decls.raw_decl(d), ordinal, false) for ordinal, d in parsed.decls.decls_of_file(f)]
    let held = reach_workspace(source)
    held.hold_only(REACH_PATH)
    held.mint_file(REACH_PATH, [read_fields(edited(line)) for line in records], {})
    held
}

/// A record line with BOTH cancel bits dropped: one that says nothing
/// of either.
fn bitless(line: string) -> string {
    let fields = line.split("\t")
    fields.slice(0, fields.length - 2).join("\t")
}

/// A record line whose spins bit is dropped but whose parks bit stands:
/// one written between the two bits landed.
fn spin_less(line: string) -> string {
    let fields = line.split("\t")
    fields.slice(0, fields.length - 1).join("\t")
}

/// Each named fn's record line as its analysed pass writes it, one a line.
fn record_lines(lines: List<string>, names: List<string>) -> string {
    let ws = reach_workspace(lines.concat([""]).join("\n"))
    let _ = ws.analyze_file(REACH_PATH)
    [ws.record_line(ws.decls.raw_decl(reach_decl(ws, n)), 0, false) for n in names].join("\n")
}

/// One fn's record line, with its cancel bits set to `parks` and `spins`.
fn line_with(lines: List<string>, name: string, parks: string, spins: string) -> string {
    let ws = reach_workspace(lines.concat([""]).join("\n"))
    let _ = ws.analyze_file(REACH_PATH)
    let d = reach_decl(ws, name)
    let fields = ws.record_line(ws.decls.raw_decl(d), 0, false).split("\t")
    fields.slice(0, fields.length - 2).concat([parks, spins]).join("\t")
}

spec "compiler/cancel_reach — the interface" {
    then "a held fn answers the bit its record carries" {
        let held = held_from(napping().concat(["fn plain() -> int { 1 }", "plain()"]))
        [reach_word(held, n) for n in ["nap", "plain"]].join(" ") == "nap=1 plain=0"
    }
    then "a held fn answers both bits its record carries" {
        let held = held_from(
            napping().concat(spinning()).concat(["fn plain() -> int { 1 }", "plain()"]),
        )
        [bits_word(held, n) for n in ["nap", "spin", "plain"]].join(" ") == "nap=p- spin=-s plain=--"
    }
    then "the record line's last two fields are the bits, parks then spins" {
        let lines = napping().concat(spinning()).concat(["nap()"])
        let analysed = record_lines(lines, ["nap", "spin"])
        analysed == [line_with(lines, "nap", "1", "0"), line_with(lines, "spin", "0", "1")].join("\n")
    }
    then "each bit moves the interface digest, so a caller keyed on it is rebuilt" {
        let lines = napping().concat(["nap()"])
        let none = iface_digest([line_with(lines, "nap", "0", "0")])
        iface_digest([line_with(lines, "nap", "1", "0")]) != none &&
            iface_digest([line_with(lines, "nap", "0", "1")]) != none
    }
    then "a record that says nothing of either bit says a fn may reach both" {
        let held = held_reading(
            ["fn plain() -> int { 1 }", "plain()"],
            (line) -> if line.contains("\tplain\t") { bitless(line) } else { line },
        )
        bits_word(held, "plain") == "plain=ps"
    }
    then "a record with a parks bit and no spins bit says a fn may spin" {
        let held = held_reading(
            ["fn plain() -> int { 1 }", "plain()"],
            (line) -> if line.contains("\tplain\t") { spin_less(line) } else { line },
        )
        bits_word(held, "plain") == "plain=ps"
    }
}

/// A provider whose component's template calls a fn that sleeps.
fn napping_provider() -> string {
    [
        "extern fn avra_fiber_sleep(ms: int)",
        "export fn rest(ms: int) { avra_fiber_sleep(ms) }",
        "export component napped(limit: Code) {",
        "    body: Code",
        "    fn expand() -> Code {",
        "        quote {",
        "            {",
        "                rest(\${self.limit})",
        "                \${self.body}",
        "            }",
        "        }",
        "    }",
        "}",
        "",
    ]
        .join("\n")
}

fn provided_word(p: Program, name: string) -> string {
    let d = [x.id for x in p.ws.decls.all_decls() if x.name == name][0]
    "${name}=${if p.ws.reaches_cancel(d) { 1 } else { 0 }}"
}

spec "compiler/cancel_reach — nodes that call without a call node" {
    then "a fn whose only wait is inside a component instance it makes answers 1" {
        let p = provided(
            "use @x.c.{napped}\nfn waits_inside() -> int { napped 1 { 2 } }\nfn plain() -> int { 3 }\nwaits_inside() + plain()\n",
            napping_provider(),
        )
        provided_word(p, "waits_inside") + " " + provided_word(p, "plain") == "waits_inside=1 plain=0"
    }
    then "a `?.await` answers 1, and a `?.done` answers 0" {
        reaching(
            [
                "fn maybe(t: Task<int>?) -> int? { t?.await }",
                "fn peek(t: Task<int>?) -> bool? { t?.done }",
                "1",
            ],
            ["maybe", "peek"],
        ) == "maybe=1 peek=0"
    }
    then "a call that leaves a seat to its default answers that default's answer" {
        reaching(
            napping()
                .concat(
                    [
                        "fn slept() -> int {",
                        "    nap()",
                        "    1",
                        "}",
                        "fn f(n: int = slept()) -> int { n }",
                        "fn g() -> int { f() }",
                        "fn h(n: int = 2) -> int { n }",
                        "fn k() -> int { h() }",
                        "g() + k()",
                    ],
                ),
            ["g", "k"],
        ) == "g=1 k=0"
    }
}

/// What `explain` says of each named fn.
fn said_of(lines: List<string>, names: List<string>) -> List<string> {
    let ws = reach_workspace(lines.concat([""]).join("\n"))
    let _ = ws.analyze_file(REACH_PATH)
    flatten([ws.cancel_lines(n) for n in names])
}

spec "compiler/cancel_reach — what `explain` says" {
    then "each bit names what earned it: a row, a callee, a `while`, or nothing" {
        said_of(
            napping()
                .concat(spinning())
                .concat(
                    [
                        "fn both() {",
                        "    nap()",
                        "    spin()",
                        "}",
                        "fn plain() -> int { 1 }",
                        "plain()",
                    ],
                ),
            ["nap", "spin", "both", "plain"],
        )
            .join("\n") == [
            "`nap` may reach a cancel point",
            "  parks — calls the runtime row `avra_fiber_sleep`",
            "  spins — no",
            "`spin` may reach a cancel point",
            "  parks — no",
            "  spins — a `while` here",
            "`both` may reach a cancel point",
            "  parks — calls `nap`",
            "  spins — calls `spin`",
            "`plain` reaches no cancel point",
            "  parks — no",
            "  spins — no",
        ]
            .join("\n")
    }
}
