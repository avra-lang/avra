// proves: a package declares a `rule` with `@std/meta` alone — its
// quote arms type over a `dyn Subject`, its examples and `///` fill the
// instance, and the compiler is no dependency.
use @std.meta.{rule}

/// Adding zero changes nothing.
@fixes("a + 0", "a")
@keeps("a + 1")
export rule plus_zero { quote { ${x} + 0 } -> quote { ${x} } }

"${plus_zero.doc} ${plus_zero.fixes.length} ${plus_zero.keeps.length}"
