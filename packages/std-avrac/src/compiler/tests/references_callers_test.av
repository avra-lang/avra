//! THE REFERENCES RELATION ACROSS DECLARATIONS: `callers()` finds every
//! call of a declaration, asked of the `Code` a fact rule reads on the
//! program layer (`fn_code`, references_test.av's own).

spec "compiler/references — callers" {
    given "a fn called once, elsewhere in the same file" {
        then "callers() finds the one call site" {
            fn_code("fn a() -> int { 1 }\nfn b() -> int { a() }", "a").callers().length == 1
        }
    }
    given "a fn never called" {
        then "callers() is empty" {
            fn_code("fn a() -> int { 1 }\nlet x = 1", "a").callers().is_empty()
        }
    }
    given "a fn called twice" {
        then "callers() finds both" {
            fn_code("fn a() -> int { 1 }\nfn b() -> int { a() + a() }", "a").callers().length == 2
        }
    }
}
