// proves: a long chain of boxes is freed without depth
type Link = { val: int, next: Link? }

fn built(n: int) -> Link {
    mut head = Link { val: 0, next: null }
    for i in 1..n { head = Link { val: i, next: head } }
    head
}

fn summed(l: Link) -> int {
    mut t = 0
    mut at: Link? = l
    while true {
        let cur? = at else { break }
        t = t + cur.val
        at = cur.next
    }
    t
}

fn shown() -> int {
    mut t = 0
    for i in 0..3 { t = t + summed(built(20000)) }
    t
}

"${shown()}"
