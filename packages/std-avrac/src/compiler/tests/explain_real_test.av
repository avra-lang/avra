// `avra cache` over a REAL pack entry — the `Analysis` row
// compiler/witness.av commits — not a hand-built one: grouped by the
// family `name_parts` decodes, every recorded edge re-asked against the
// hash a second process derives live, real names shown and typed back,
// and a real dependency's dependents found. The fixtures (`a_process`,
// `checked`, `package_files`, `fresh_pack_path`) are witness_test.av's
// own; this module shares one namespace.
use compiler.{Workspace, key_family, shown_name, matching_names}
use compiler.store.{
    Pack,
    Entry,
    pack_at,
    real_entries,
    summarized,
    witnessed,
    dependents,
    family_groups,
    Held,
}

/// The pack a first process leaves after checking `b.av` — which calls
/// `f` in `a.av` — read back as `avra cache` opens it: a fresh handle
/// on the file.
fn left_behind(path: string) -> Pack {
    let first = a_process(package_files(), path)
    let _ = checked(first, "/w/src/b.av")
    pack_at(path, "witness-test")
}

fn the_entry(pack: Pack) -> Entry? { real_entries(pack).first() }

/// The first edge of `entry` whose name is in `family`.
fn edge_named(entry: Entry, family: string) -> string? {
    [e.name for e in entry.edges if key_family(e.name) ?? "" == family].first()
}

/// Every edge of the pack's one entry, re-asked against what `ws`
/// derives right now.
fn edge_verdicts(pack: Pack, ws: Workspace) -> List<Held> {
    let entry? = the_entry(pack) else { return [] }
    [witnessed(pack, e.name, e.hash, [entry.name], (n: string) -> ws.edge_current_hash(n)).held for e in entry.edges]
}

spec "compiler/store/explain — over a real Analysis entry" {
    given "one file checked by a first process" {
        then "the pack holds that one entry, grouped as an Analysis, and its edges name Parsed and Sig dependencies" {
            let s = summarized(left_behind(fresh_pack_path("explain_shape")), key_family)
            [f.family for f in s.families].join(",") == "Analysis" &&
                s.entries == 1 &&
                [r.family for r in s.referenced].contains("Parsed") &&
                [r.family for r in s.referenced].contains("Sig")
        }
    }
    given "the same source, asked again by a second process" {
        then "every recorded edge holds against the live hash that process derives" {
            let path = fresh_pack_path("explain_holds")
            let pack = left_behind(path)
            let verdicts = edge_verdicts(pack, a_process(package_files(), path))
            verdicts.length > 0 && verdicts.all((h: Held) -> h == Held.Matches)
        }
    }
    given "the callee's signature edited before the second process" {
        then "some edge is stale, and an edge the edit never touched still holds" {
            let path = fresh_pack_path("explain_stale")
            let pack = left_behind(path)
            mut edited = package_files()
            edited.set("/w/src/a.av", "export fn f() -> string {\n    \"one\"\n}\n")
            let verdicts = edge_verdicts(pack, a_process(edited, path))
            verdicts.any((h: Held) -> h == Held.Stale) &&
                verdicts.any((h: Held) -> h == Held.Matches)
        }
    }
}

spec "compiler/explain_names — real names read and typed back" {
    given "the Analysis entry a first process leaves for b.av" {
        then "it is shown as its family and its file on one line, and its family decodes" {
            let entry? = the_entry(left_behind(fresh_pack_path("names_shown"))) else { return false }
            shown_name(entry.name) == "Analysis(file · /w/src/b.av)" &&
                key_family(entry.name) == "Analysis"
        }
        then "the whole shown form names exactly that entry among every name the pack knows" {
            let pack = left_behind(fresh_pack_path("names_exact"))
            matching_names(pack.names(), "Analysis(file · /w/src/b.av)").length == 1
        }
        then "a part of the form that several names hold names several" {
            let pack = left_behind(fresh_pack_path("names_loose"))
            matching_names(pack.names(), "b.av").length > 1
        }
        then "a query nothing matches names nothing" {
            let pack = left_behind(fresh_pack_path("names_none"))
            matching_names(pack.names(), "no-such-thing").is_empty()
        }
    }
    given "a name no family claims" {
        then "it has no family and is shown by its own fields" {
            key_family("plain") == null && shown_name("plain") == "plain"
        }
    }
}

spec "compiler/store/explain — dependents of a real name" {
    given "the pack a first process leaves after checking b.av" {
        then "the callee's Sig that entry leans on has that one Analysis entry as its dependent" {
            let pack = left_behind(fresh_pack_path("dependents_sig"))
            let entry? = the_entry(pack) else { return false }
            let sig? = edge_named(entry, "Sig") else { return false }
            let found = dependents(pack, sig)
            found.length == 1 && found[0].name == entry.name
        }
        then "the dependents of a Parsed name group under the one Analysis family" {
            let pack = left_behind(fresh_pack_path("dependents_family"))
            let entry? = the_entry(pack) else { return false }
            let parsed? = edge_named(entry, "Parsed") else { return false }
            let groups = family_groups([e.name for e in dependents(pack, parsed)], key_family)
            groups.length == 1 && groups[0].family == "Analysis"
        }
        then "a name the pack has never heard of has none" {
            dependents(left_behind(fresh_pack_path("dependents_none")), "nothing").is_empty()
        }
    }
}
