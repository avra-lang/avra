// proves: a `Tasks` owner holds the tasks pushed into it — each
// handle its own after the spawning expression is gone, shed once
// finished, joined at the owner's end
fn noted(log: Cell<List<int>>, n: int) -> int {
    log.push(n)
    n
}

fn waited(n: int) -> int { n + 1 }

fn shown() -> string {
    let log: Cell<List<int>> = Cell.new([])
    mut turns = 0
    if true {
        let owner = Tasks.new()
        for i in 0..40 {
            owner.push(spawn noted(log, i))
            let gate = spawn waited(i)
            turns = turns + gate.await
        }
        for i in 40..44 { owner.push(spawn noted(log, i)) }
    }
    mut sum = 0
    for n in log.get() { sum = sum + n }
    "${log.get().length} ${sum} ${turns}"
}

shown()
