// proves: a walk over a map lets go of what it read — `values`, a
// paired `for`, a comprehension's head — over managed values and a
// null one
type Row = { vals: List<int> }

fn shown() -> string {
    mut m: Map<string, Row> = {}
    for i in 0..200 {
        m.set("k${i % 5}", Row { vals: [i, i] })
    }
    mut opt: Map<string, int?> = {}
    opt.set("n", null)
    opt.set("s", 7)
    mut t = 0
    for _k, v in m { t = t + v.vals.length }
    let firsts = [v.vals[0] for _k, v in m]
    let nulls = [v == null for _k, v in opt]
    let vs = opt.values()
    m.remove("k0")
    "${t} ${firsts.length} ${firsts[1]} ${nulls[0]} ${vs[1] ?? 0} ${m.length}"
}

shown()
