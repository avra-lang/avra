// proves: the expected-type channel. Unannotated lambdas hear
// declared slots, call seats, walk elements, and branch arms
// (if/match/when — the heirs distribution); assignment rescues
// through the one door; heterogeneous literals box under a
// declared element (the T3 scope-cut repaid); lambda lists hear
// their seats.
trait Show {
    fn show() -> int
}
type P = { x: int }
enum G {
    hot
}
enum Mode {
    up
    down
}
impl Show for P {
    fn show() -> int {
        self.x
    }
}
impl Show for G {
    fn show() -> int {
        100
    }
}
fn shift(m: Mode) -> fn(int) -> int {
    match m {
        .up -> (x) -> x + 1
        .down -> (x) -> x - 1
    }
}
fn apply(f: fn(int) -> int, v: int) -> int {
    f(v)
}
let f: fn(int) -> int = (x) -> x * 2
let heter: List<dyn Show> = [P { x: 2 }, G.hot, P { x: 5 }]
let fs: List<fn(int) -> int> = [(x) -> x + 1, (x) -> x * 3]
mut g: fn(int) -> string = (n) -> "a${n}"
g = (n) -> "b${n}"
mut t = 0
for v in heter {
    t = t + v.show()
}
"${f(21)} ${apply((x) -> x + 2, 40)} ${shift(Mode.up)(9)} ${[1, 2, 3].map((x) -> x * 10)[2]} ${t} ${fs[1](5)} ${g(1)}"
