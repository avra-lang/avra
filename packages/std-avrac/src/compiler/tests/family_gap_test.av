// `Workspace.relation`'s guard against a `Family` whose ordinal
// outran `family_at`/`family_count` — a NAMED VOICE, not a bare index
// trap, per the compiler-DB review. `family_gap_probe` is a
// test-only door: no real `Family` today has a gap to trip it, so
// this pins the exact words the guard would speak if one ever did.
use compiler.{family_gap_probe}

spec "compiler/workspace family gap" {
    given "a Family whose ordinal has outrun family_at/family_count" {
        then "the voice names the variant, its ordinal, and the fix — never a bare index" {
            family_gap_probe() == "defect: Family.Raised has ordinal 99 but family_count is 30 — add it to family_at and family_count (compiler/workspace.av)"
        }
    }
}
