//! A GUESS ONLY PRE-ADMITS. The reader of the remembered reads answers files that
//! are on disk now and not already led, each wearing the words it was read for;
//! whatever the row holds — nothing, files gone, files nothing needs, every file —
//! it can only add reads, never remove one or change what a read file is judged by.
use @std.avrac.testing.{test_workspace}
use compiler.{Attempt, Want, Workspace, guess_line}
use compiler.host.{memory_host}
use compiler.record.{ReadFile, Reads}
use compiler.store.{Store, Stored, Keeping, store_with}

const FILES: List<string> = ["/w/avra.toml", "/w/src/main.av", "/w/src/a.av", "/w/src/b.av"]

fn workspace() -> Workspace {
    test_workspace(
        memory_host(
            {
                "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n",
                "/w/src/main.av": "1",
                "/w/src/a.av": "export fn a() -> int { 1 }\n",
                "/w/src/b.av": "export fn b() -> int { 2 }\n",
            },
            FILES,
        ),
        "/w",
    )
}

/// What a fresh workspace guesses from a store holding `row` as the remembered reads.
fn guessed(row: string?, at: Attempt, led: List<string>) -> List<ReadFile> {
    let ws = workspace()
    ws.guessed_reads(store_of(ws, row), at, led)
}

fn store_of(ws: Workspace, row: string?) -> Store {
    let rows: Cell<Map<string, string>> = Cell.new({})
    let store = store_with("/w/.avra-cache", "print", Keeping.Aside(rows))
    if row != null { let _ = store.keep(Stored.Unit, ws.guess_key("/w/src/main.av", "edit"), row!, []) }
    store
}

fn attempt(edit: string) -> Attempt { Attempt { entry: "/w/src/main.av", want: Want.Diagnostics, edit: edit } }

fn paths(xs: List<ReadFile>) -> List<string> { [x.path for x in xs] }

spec "compiler/derive — a remembered guess only pre-admits" {
    given "a row of remembered reads" {
        then "no row answers nothing" {
            guessed(null, attempt("edit"), []).is_empty()
        }
        then "an empty row answers nothing" {
            guessed("", attempt("edit"), []).is_empty()
        }
        then "an edit with no moved file has no guess, whatever the row holds" {
            guessed("app:src/a.av\twords", attempt(""), []).is_empty()
        }
        then "another edit's row is not this edit's" {
            guessed("app:src/a.av\twords", attempt("other"), []).is_empty()
        }
        then "a path that is gone is dropped" {
            guessed("app:src/gone.av\twords", attempt("edit"), []).is_empty()
        }
        then "a file nothing needs is answered, wearing the words it was read for" {
            let got = guessed(
                "app:src/b.av\ta compile-time run called one of its bodies",
                attempt("edit"),
                [],
            )
            paths(got).join(",") == "/w/src/b.av" &&
                got[0].why.says() == "a compile-time run called one of its bodies"
        }
        then "every file of the package is answered, and only the files" {
            let row = "app:src/main.av\tx\napp:src/a.av\tx\napp:src/b.av\tx\napp:avra.toml\tx\napp:src/gone.av\tx"
            let got = paths(guessed(row, attempt("edit"), []))
            got.length == 4 && got.contains("/w/src/a.av") && !got.contains("/w/src/gone.av")
        }
        then "a read already led is not answered twice" {
            let got = guessed("app:src/a.av\tx\napp:src/b.av\tx", attempt("edit"), ["/w/src/a.av"])
            paths(got).join(",") == "/w/src/b.av"
        }
        then "a malformed line is dropped, never read as a path" {
            guessed("app:src/a.av\nnot a line\n\t\napp:src/b.av\tx\ty", attempt("edit"), [])
                .is_empty()
        }
    }
    given "a remembered read kept again" {
        then "it keeps the words it was remembered with" {
            guess_line(ReadFile { path: "/w/src/a.av", why: Reads.Remembered("its text moved") }) == "/w/src/a.av\tits text moved"
        }
        then "a consumer's own reason is kept as it is" {
            guess_line(ReadFile { path: "/w/src/a.av", why: Reads.Moved }) == "/w/src/a.av\tits text moved"
        }
        then "a path a line cannot carry is not kept" {
            guess_line(ReadFile { path: "/w/a\tb.av", why: Reads.Moved }).is_empty()
        }
    }
}
