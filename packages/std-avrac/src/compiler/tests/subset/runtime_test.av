// "The subset today", runtime facts: what a program answers, pinned by
// running it. A fact the compiler changes turns its case red; edit the
// case and the entry together.
use @std.avrac.testing.{shown}

spec "compiler/subset — runtime facts" {
    given "a program run in the evaluator" {
        then "`split` keeps a leading empty segment" { shown("\".a\".split(\".\").length") == "2" }
        then "`split` drops a trailing empty segment" { shown("\"a.\".split(\".\").length") == "1" }
        then "`split` of the empty string is empty" { shown("\"\".split(\".\").length") == "0" }
        then "`\\uFFFD` is not an escape" { shown("\"\\uFFFD\".length") == "6" }
        then "`\\u0041` is not an escape" { shown("\"\\u0041\".length") == "6" }
        then "`\\0` is not an escape" { shown("\"ab\\0cd\".length") == "6" }
        then "`\\u{…}` is not an escape" { shown("\"\\u{1F600}\".length") == "9" }
        then "a 50000-deep recursion runs" { shown(
                "fn depth(n: int) -> int { if n == 0 { 0 } else { 1 + depth(n - 1) } }\ndepth(50000)",
            ) == "50000" }
    }
}
