use @std.relation.{query}
use @std.relation.db.{Db, new_db}
use @std.meta.{Type, Declared, Directive, literal}

@query
export fn names_in(db: Db, dir: string) -> List<string> { ["${dir}_close", "${dir}_open"] }

export fn icons(t: Type, dir: string) -> Declared {
    Declared { made: [constant(t, n) for n in names_in(new_db(), dir)] }
}

fn constant(t: Type, n: string) -> Directive {
    Directive {
        twin: "",
        name: n,
        at: t.at,
        source: quote { export const ${n}: string = ${literal("<svg/>")} },
    }
}
