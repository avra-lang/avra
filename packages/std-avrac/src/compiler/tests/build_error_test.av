// BuildError — the build's own defects, typed: what clang, the store
// and the entry's own shape can each refuse, each answering through
// @std.errors the same way every other compiler error does.
use @std.avrac.compiler.{BuildError}

spec "BuildError" {
    given "an empty program" {
        then "it names the fact" {
            let d = BuildError.Empty.describe()
            d.kind == "build.empty" && d.message == "the program is empty"
        }
    }
    given "an LLVM emit failure" {
        then "the underlying words pass through verbatim" {
            let d = BuildError.EmitFailed("cannot write `/tmp/x.o`").describe()
            d.kind == "build.emit_failed" && d.message == "cannot write `/tmp/x.o`"
        }
    }
    given "the entry's module written but unreadable" {
        then "it names the path" {
            // LICENSED compiler.fixed_tmp_path: text a message quotes, never opened
            let d = BuildError.ModuleUnreadable("/tmp/x.bc").describe()
            d.kind == "build.module_unreadable" &&
                d.message == "avra: the entry's module could not be read back — /tmp/x.bc"
        }
    }
    given "clang failing to link" {
        then "the exit code is in the words" {
            let d = BuildError.LinkFailed(1, []).describe()
            d.kind == "build.link_failed" &&
                d.message == "avra: clang failed linking — exited with code 1"
        }
    }
    given "clang failing to link a program that names an extern nothing answers" {
        then "the words name it, and both ways to answer it" {
            BuildError.LinkFailed(1, ["avra_dom_frame"]).describe().message == "avra: clang failed linking — exited with code 1\nno package's library and no host fn of this program defines `avra_dom_frame` — when the linker names one of them, a host answers it: build for that host, or answer it here with `extern fn avra_dom_frame(…) { … }`"
        }
    }
    given "a held object gone from the store" {
        then "the path is named" {
            // LICENSED compiler.fixed_tmp_path: text a message quotes, never opened
            let d = BuildError.ObjectGone("/tmp/x.o").describe()
            d.kind == "build.object_gone" &&
                d.message == "avra: a held object disappeared: /tmp/x.o"
        }
    }
    given "a built binary that cannot be renamed onto its path" {
        then "the path is named" {
            // LICENSED compiler.fixed_tmp_path: text a message quotes, never opened
            let d = BuildError.Unpublished("/tmp/x/build/suite").describe()
            d.kind == "build.unpublished" &&
                d.message == "avra: the built binary could not be moved into place — /tmp/x/build/suite"
        }
    }
    given "a symbol nothing in the program declares" {
        then "it names the missing symbol" {
            let d = BuildError.NotClosed("av_widget").describe()
            d.kind == "build.not_closed" &&
                d.message == "internal compiler error: nothing declares `av_widget` — the program is not closed"
        }
    }
    given "a report already rendered elsewhere" {
        then "it passes through verbatim" {
            let d = BuildError.Diagnosed("error[manifest.no_target]: nothing to run").describe()
            d.kind == "build.diagnosed" && d.message == "error[manifest.no_target]: nothing to run"
        }
    }
}
