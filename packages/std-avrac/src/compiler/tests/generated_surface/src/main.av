// `OwnedKey` is `@example.q`'s own — never written there, minted by
// `@relation`'s derive over `Owned`'s `@key` field. Naming it here, from
// another package, is the whole proof.
use @example.q.{Owned, OwnedKey}
use @std.relation.db.{new_db}

let db = new_db()
let _ = Owned.insert(db, handle: "ann", team: "red")
let _ = Owned.insert(db, handle: "bo", team: "blue")
Owned.by_key(db, OwnedKey { handle: "ann" })?.team ?? "-"
