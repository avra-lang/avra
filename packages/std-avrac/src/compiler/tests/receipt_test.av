// The lossless receipt (compiler/format/receipt.av): two texts that
// lex to the same tokens, remarks and doc groups, in the same order,
// can still disagree — a remark that crossed a closing brace carries
// the same text at the same position in the list and belongs to a
// different scope.
use compiler.format.{lossless_defect, remarks_and_docs_defect}
use compiler.{Canonical, canon_defect, canonical_of, formatted_under, write_checked_under}
use core.{ComponentWord, Instancing}
use diagnostics.{new_source_file}
use features.{BlockWords}

spec "the lossless receipt's brace-nesting check" {
    given "a comment written before a scope's closing brace" {
        then "the same text, same order, standing AFTER the brace instead — refused" {
            let before = "fn f(c: int) -> bool {\n    c == 61 || c == 124\n    // the bitwise three\n}\n"
            let after = "fn f(c: int) -> bool {\n    c == 61 || c == 124\n}\n// the bitwise three\n"
            lossless_defect(before, after) != null
        }
        then "kept exactly where it was written — accepted" {
            let src = "fn f(c: int) -> bool {\n    c == 61 || c == 124\n    // the bitwise three\n}\n"
            lossless_defect(src, src) == null
        }
        then "the canon door (remarks_and_docs_defect alone) refuses the same crossing" {
            let before = "fn f(c: int) -> bool {\n    c == 61 || c == 124\n    // the bitwise three\n}\n"
            let after = "fn f(c: int) -> bool {\n    c == 61 || c == 124\n}\n// the bitwise three\n"
            remarks_and_docs_defect(before, after) != null
        }
    }
    given "a comment moving OUT to IN — the opposite crossing" {
        then "a top-level comment pulled inside the brace it now precedes — refused" {
            let before = "fn f(c: int) -> bool {\n    c == 61 || c == 124\n}\n// the bitwise three\n"
            let after = "fn f(c: int) -> bool {\n    c == 61 || c == 124\n    // the bitwise three\n}\n"
            lossless_defect(before, after) != null
        }
    }
    given "a nested brace two levels deep" {
        then "an ordinary reflow (a two-line body collapsed to one) leaves a same-depth comment accepted — the check is about crossing a brace, never about a layout change" {
            let before = "fn f() {\n    if true {\n        // a\n        1\n    }\n}\n"
            let after = "fn f() {\n    if true { 1\n        // a\n    }\n}\n"
            lossless_defect(before, after) == null
        }
        then "a comment that climbs out of the inner `if` into the outer fn — refused" {
            let before = "fn f() {\n    if true {\n        // a\n    }\n}\n"
            let after = "fn f() {\n    if true {\n    }\n    // a\n}\n"
            lossless_defect(before, after) != null
        }
    }
}

/// A file declaring a record and a component, and one whose body builds `box` with `layout`
/// written as `lit`.
fn composed_with(lit: string) -> string {
    "type L = { a: int, b: int }\ncomponent box {\n    layout: L\n}\ncomponent outer {\n    box {\n        layout: ${lit}\n    }\n}\n0\n"
}

/// The words a file that declares `box` reads under: the component known by its shape.
fn box_words() -> BlockWords {
    BlockWords {
        components: [
            ComponentWord {
                word: "box",
                declared: "box",
                form: Instancing.Shaped(false),
                origin: "",
            },
        ],
    }
}

/// What the canon receipt says of `after` as a rewrite of `before`.
fn canon_of(before: string, after: string) -> string? {
    canon_defect(new_source_file("/w/src/main.av", before), after, box_words())
}

/// The fields of a record written one a line, as an author lays them out.
const LAID_OUT: string = "L {\n            a: 1\n            b: 2\n        }"

spec "the canon receipt reads a component's body by what it means" {
    given "a record literal in a component's body, its fields one a line" {
        then "laid out on one line with commas, its meaning stands" {
            canon_of(composed_with(LAID_OUT), composed_with("L { a: 1, b: 2 }")) == null
        }
        then "a field's value changed, its meaning moved" {
            canon_of(composed_with(LAID_OUT), composed_with("L { a: 1, b: 3 }")) != null
        }
        then "a field's name changed, its meaning moved" {
            canon_of(composed_with(LAID_OUT), composed_with("L { a: 1, c: 2 }")) != null
        }
    }
    given "the same file written by the formatter" {
        then "the write is accepted, and what it wrote stands canonical" {
            let src = new_source_file("/w/src/main.av", composed_with(LAID_OUT))
            match write_checked_under(src, box_words()) {
                .Ok(text) -> match formatted_under(new_source_file("/w/src/main.av", "${text}\n"), box_words()) {
                    .Ok(again) -> again == text,
                    .Err(_) -> false,
                },
                .Err(_) -> false,
            }
        }
    }
}

/// A run hole spread into a record literal inside a quote, its list too long for a line: the
/// shape a hole must print on one line in, since a hole never spans one.
const SPREAD_HOLE: string = "fn draft_row(t: Type) -> Code {\n    quote { \${t} { ..\${[assigned_init(f) for f in t.fields if assigned(f)].concat([drafted_init(f) for f in drafted_fields(t)])} } }\n}\n"

/// What a write of `text` answers, read under no words.
fn written_of(text: string) -> Result<string, string> { write_checked_under(new_source_file("/w/src/main.av", text), BlockWords {}) }

spec "a quote's hole prints on one line" {
    given "a run hole spread into a record literal, its list too long for a line" {
        then "the write is accepted, and it writes the text as it stands: fmt(x) == x" {
            match written_of(SPREAD_HOLE) {
                .Ok(text) -> "${text}\n" == SPREAD_HOLE,
                .Err(_) -> false,
            }
        }
        then "laid out otherwise, it is written back on one line, and that stands canonical" {
            let loose = SPREAD_HOLE.replace("assigned_init(f) for", "assigned_init(f)   for")
            match written_of(loose) {
                .Ok(text) -> "${text}\n" == SPREAD_HOLE &&
                    canonical_of(SPREAD_HOLE, written_of(SPREAD_HOLE)) is .Stands,
                .Err(_) -> false,
            }
        }
    }
}

spec "--check says of a file what --write would" {
    given "what a write answers" {
        then "a write refused is a refusal, said by its first line — never a file that differs" {
            match canonical_of(
                "x\n",
                .Err("avra fmt: refusing to write — the token count moved: 2 -> 1\nmore"),
            ) {
                .Refused(why) -> why == "avra fmt: refusing to write — the token count moved: 2 -> 1",
                .Stands or .Differs -> false,
            }
        }
        then "the text a write would put back, as it stands, stands" { canonical_of("x\n", .Ok("x")) is .Stands }
        then "any other text it would put back differs" { canonical_of("x \n", .Ok("x")) is .Differs }
    }
}
