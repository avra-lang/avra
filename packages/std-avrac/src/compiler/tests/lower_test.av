// The IR half of compilation: lowering is pure and SSA (an ident IS
// its definition's register), scopes are structure, and the memory
// pass releases each managed value where it dies — at its last read, or
// at its scope's exit, in reverse binding order.
use @std.avrac.core.{
    Ins,
    RtSig,
    Reg,
    TypeId,
    SeatMark,
    dst_of,
    reads_of,
    same_reg,
    distinct,
    lent_args,
    flatten,
    some_list,
    new_type_registry,
    static_code_syms,
    consumed_mark,
}

use @std.avrac.core.{rt_sigs, rt_sig_of, rt_owns, rt_index}
use @std.avrac.testing.{ir_of, halver, shown}
use compiler.backend.{render_ir}
use compiler.lower.{Body, Lowered, minted_pointers}

/// A row is indexed under its own name.
fn indexed(index: Map<string, RtSig>, s: RtSig) -> bool {
    index.get(s.name) != null
}

fn count_releases(l: Lowered) -> int {
    l.entry.ins.filter(it is .Release).length
}

/// Every box a program builds, across all bodies — the counting
/// probe behind the never-allocates law (ROADMAP: the nullable
/// representation).
fn boxes_built(l: Lowered) -> int {
    mut n = 0
    for b in l.fns.concat([l.entry]) {
        n = n + b.ins.filter(is_box_call(it)).length
    }
    n
}

/// An owned +1 read, by index or by a slot the type proves.
fn is_owned_get(i: Ins) -> bool {
    match i {
        .CallRt(_, callee, _) -> ["avra_array_get_owned", "avra_slot_get_owned"].contains(callee),
        _ -> false,
    }
}

fn is_box_call(i: Ins) -> bool {
    match i {
        .CallRt(_, callee, _) -> callee == "avra_array_new" || callee == "avra_array_sized",
        _ -> false,
    }
}

/// The dyn subject: one contract, one signatory, one boxed call.
fn dyn_read() -> string {
    "trait Show {\n    fn show() -> int\n}\ntype P = { x: int }\nimpl Show for P {\n    fn show() -> int {\n        self.x\n    }\n}\nlet d: dyn Show = P { x: 3 }\nd.show()"
}

fn addr_syms(l: Lowered) -> List<string> {
    mut out: List<string> = []
    for i in l.entry.ins {
        let sym: string? = match i { .FnAddr(_, s) -> s, _ -> null }
        if sym != null { out.push(sym!) }
    }
    out
}

/// A capture-free box's code address, laid out static instead of
/// minted by `Ins.FnAddr` — `addr_syms`'s twin.
fn static_addr_syms(l: Lowered) -> List<string> {
    flatten([static_code_syms(st.boxes) for st in l.statics])
}

fn call_ptrs(l: Lowered) -> int {
    l.entry.ins.filter(it is .CallPtr).length
}

/// Does every load in the entry wear a POINTER — the mut fn cell's
/// witness: a call through the cell must load the box, not the
/// call's own answer.
fn entry_loads_ride_pointers(l: Lowered) -> bool {
    l.entry.ins.all(load_rides_pointer(l, it))
}

/// A non-load passes; a load passes when its register is a pointer.
fn load_rides_pointer(l: Lowered, i: Ins) -> bool {
    let d: Reg? = match i { .Load(dst, _) -> dst, _ -> null }
    d == null || l.types.rides_pointer(l.entry.reg_types[d!.index])
}

/// No CallPtr seat in ANY lowered body carries a defensive retain: THE
/// ROOT OF A PATH DECIDES WHERE A WRITE LANDS, so a call that is not
/// ALSO handed a seat's own root cannot write through it — a captured
/// fn's own env stands on its own reference the whole call through.
fn no_callptr_seat_retained(l: Lowered) -> bool {
    l.fns.all((b: Body) -> callptr_seats(b.ins).all(retains_of(b.ins, it) == 0))
}

/// Every CallPtr's first seat, across one body's instructions.
fn callptr_seats(ins: List<Ins>) -> List<Reg> {
    flatten([some_list(callptr_seat(i)) for i in ins])
}

fn callptr_seat(i: Ins) -> Reg? {
    match i { .CallPtr(_, _, args) -> args.first(), _ -> null }
}

/// A `string?` made and read through `??` — the niche subject.
fn niche_read() -> string {
    "fn f(b: bool) -> string? { if b { \"x\" } else { null } }\nf(true) ?? \"y\""
}

/// An `int?` made and read — the pair subject.
fn pair_read() -> string {
    "fn f(v: int) -> int? { v }\nf(1) ?? 0"
}

/// Every consumer of absence in one program — the law's witness.
/// Deliberately aggregate-free: a struct literal's box is a STRUCT
/// cost, and this law speaks only for the nullable's own lowering.
fn every_consumer() -> string {
    "fn g(b: bool) -> string? { if b { \"hi\" } else { null } }\n" +
        halver +
        "fn fwd(v: int?) -> int? { v? + 1 }\n" +
        "let a = half(4) ?? 0\n" +
        "let b = half(4)!\n" +
        "let c = match half(3) {\n    v? -> v\n    null -> 0\n}\n" +
        "let d = g(true)?.length ?? 0\n" +
        "let e = fwd(half(4)) ?? 0\n" +
        "a + b + c + d + e"
}

/// The identity fn whose tail WIDENS into a nullable…
fn lifting_id_fn() -> string {
    "fn f(s: string) -> string? { s }\nf(\"a\") ?? \"b\""
}

/// …and its guarantee twin, instruction-for-instruction.
fn plain_id_fn() -> string {
    "fn f(s: string) -> string { s }\nf(\"a\")"
}

spec "compiler/lower" {
    given "calls through boxes wear the callee's type" {
        then "a call through a mut fn cell loads the box, never the answer" {
            entry_loads_ride_pointers(ir_of("mut f = () -> 1\nf()"))
        }
        then "a captured fn's lane BORROWS and needs no guard — its call is never also handed the lane" {
            no_callptr_seat_retained(ir_of("let a = () -> 1\nlet b = () -> a() + 1\nb()"))
        }
        then "the same lane read twice still borrows both calls uncounted" {
            let l = ir_of("let a = () -> 1\nlet b = () -> a() + a()\nb()")
            !l.fns.any(it.ins.any(is_owned_get(it))) && no_callptr_seat_retained(l)
        }
    }
    given "arithmetic" {
        then "one scope, constants, one Bin, the answer's puts, exit 0" {
            let l = ir_of("1 + 2")
            l.diagnostics.is_empty() &&
                l.entry.ins[0] is .ScopeEnter &&
                l.entry.ins.last()! is .Ret &&
                l.entry.ins.filter(it is .Bin).length == 1 &&
                l.entry.ins.filter(it is .ConstInt).length == 2 &&
                l.entry.ins.filter(it is .CallRtVoid).length == 1
        }
        then "an ident adds NO instruction — SSA by construction" {
            let direct = ir_of("1 + 2")
            let named = ir_of("let x = 1 + 2\nx")
            named.entry.ins.length == direct.entry.ins.length
        }
    }
    given "strings under the Application strategy" {
        then "each managed binding releases once" {
            let l = ir_of("let a = \"x\" + \"1\"\nlet b = \"y\" + \"2\"\nb")
            count_releases(l) == 2
        }
        then "a string CONSTANT is the binary's own data — never counted" {
            count_releases(ir_of("let a = \"x\"\nlet b = \"y\"\nb")) == 0
        }
        then "scalars never release" {
            count_releases(ir_of("let n = 1 + 2\nn < 4")) == 0
        }
        then "string == lowers through the runtime" {
            ir_of("let t = \"a\" == \"b\"\n\"done\"").entry.ins.filter(it is .CallRt).length == 1
        }
        then "an interpolated string still lowers to ONE join over its pieces" {
            render_ir(ir_of("let x = 1\nlet s = \"a \${x} b\"\ns")).contains("call avra_str_join")
        }
    }
    given "the ownership roles read as behavior" {
        then "the identity pack of an UNMANAGED pair carries NO reference — `@owns` respects `is_managed`" {
            pack_carries_no_reference(all_ins(ir_of(pair_read())))
        }
        then "the element read is a VIEW — no retain, no release of its own" {
            extract_carries_no_reference(all_ins(ir_of(pair_read())))
        }
        then "a seat that STANDS is handed over uncounted — a parameter is borrowed" {
            no_call_seat_counted(ir_of(moved_seat()).entry.ins)
        }
        then "a VIEW whose root the call never also receives needs no guard" {
            !render_ir(ir_of(viewed_seat())).contains("retain r8")
        }
        then "a VIEW whose root the SAME call also receives takes its own reference at the read instead" {
            all_ins(ir_of(viewed_seat_with_root())).any(is_owned_get(it))
        }
        then "a call in a SIBLING branch the value's last use never reaches is no barrier to it" {
            !all_ins(ir_of(cross_branch_call())).any(is_owned_get(it))
        }
        then "a Cell's content read with no call between is a VIEW — no reference of its own" {
            !all_ins(ir_of(cell_read(""))).any(is_owned_get(it))
        }
        then "a Cell's content read past ANY user call owns — the callee may replace it" {
            all_ins(ir_of(cell_read("clear()"))).any(is_owned_get(it))
        }
        then "a `set_at` of an int through a Cell writes the held list as a VIEW — no reference of its own" {
            !all_ins(ir_of(cell_set_at("int", "i * 2", "0"))).any(is_owned_get(it))
        }
        then "a `set_at` of a string through a Cell writes the held list as a VIEW — no reference of its own" {
            !all_ins(ir_of(cell_set_at("string", "\"s\" + \"t\"", "\"a\""))).any(is_owned_get(it))
        }
    }
    given "`!` on a niche nullable" {
        then "a foreign pointer's is a null test, never the retaining insist" {
            let text = render_ir(ir_of("extern fn f() -> ptr?\nfn g(p: ptr) -> int { 0 }\ng(f()!)"))
            text.contains("avra_insist_scalar") &&
                !text.replace("avra_insist_scalar", "").contains("avra_insist")
        }
        then "a counted box's still comes back owned through the insist" {
            let text = render_ir(ir_of("extern fn f() -> string?\nf()!.length"))
            text.contains("avra_insist") && !text.contains("avra_insist_scalar")
        }
    }
    given "THE LAW: nullability never allocates" {
        // The one exception, pinned so it cannot widen: a FLAT record
        // is a machine word with no spare value and no room for a
        // flag, so its nullable is a one-slot box.
        then "a FLAT record's nullable is the law's ONE box — exactly one" {
            boxes_built(ir_of("type Id = { i: int }\nlet a: Id? = Id { i: 1 }\na!.i")) == 1
        }
        then "a pointer nullable builds NO box anywhere — the niche is free" {
            boxes_built(ir_of(niche_read())) == 0
        }
        then "a scalar nullable builds NO box either — the pair rides registers" {
            boxes_built(ir_of(pair_read())) == 0
        }
        then "widening a pointer into its nullable adds NO instruction" {
            let lifted = ir_of(lifting_id_fn())
            let plain = ir_of(plain_id_fn())
            lifted.fns[0].ins.length == plain.fns[0].ins.length
        }
        then "the whole nullable surface at once — still not one box" {
            boxes_built(ir_of(every_consumer())) == 0
        }
        then "`avra ir` SHOWS the pair — the pack and its element reads" {
            let text = render_ir(ir_of(pair_read()))
            text.contains("= pack ") && text.contains(".0") && text.contains(".1")
        }
    }
    given "a once fn answers from its own slot" {
        then "`avra ir` shows the slot read and its one commit, and no table call" {
            let text = render_ir(ir_of("once fn tag() -> string {\n    \"a\" + \"b\"\n}\ntag()"))
            text.contains(" = once ") && text.contains(" <- r") && !text.contains("avra_once_get")
        }
    }
    given "the runtime registry, indexed by name" {
        then "every row is in the index under its name, and nothing else is" {
            let index = rt_index()
            rt_sigs().all(indexed(index, it)) && index.length == rt_sigs().length
        }
        then "an extern declared with a runtime row's name is the runtime's row — the evaluator hosts it" {
            shown("extern fn avra_puts(s: string)\navra_puts(\"x\")\n2") == "x\n2"
        }
        then "the index answers the same row the scan does" {
            let scanned: RtSig? = rt_sig_of("avra_array_push")
            let indexed: RtSig? = rt_index().get("avra_array_push")
            scanned != null &&
                indexed != null &&
                scanned!.host == indexed!.host &&
                scanned!.has_owned_twin == indexed!.has_owned_twin
        }
    }
    given "the runtime registry" {
        then "a known callee answers its contract; an unknown answers null" {
            let known: RtSig? = rt_sig_of("avra_puts")
            let unknown: RtSig? = rt_sig_of("nonsense")
            known != null && unknown == null
        }
        then "ownership is provenance: fresh text owns, static text does not" {
            rt_owns("avra_int_text") && !rt_owns("avra_bool_text") && !rt_owns("nonsense")
        }
        then "every row names a distinct contract" {
            let names = [s.name for s in rt_sigs()]
            distinct(names).length == names.length
        }
    }
    given "the dyn box and its indirect call (T3)" {
        then "boxing writes one address per trait method, qualified" {
            let syms = addr_syms(ir_of(dyn_read()))
            syms.length == 1 && syms[0] == "P.show"
        }
        then "the call goes through the pointer, not a name" {
            call_ptrs(ir_of(dyn_read())) == 1
        }
        then "a boxed empty contract carries the value alone" {
            addr_syms(
                ir_of(
                    "trait Mark {\n}\ntype P = { x: int }\nimpl Mark for P {\n}\nlet d: dyn Mark = P { x: 1 }\n2",
                ),
            )
                .length == 0
        }
    }
    given "the mut-cell protocol (ownership 11.5)" {
        // A STRING field on purpose: a record of ints is a VALUE — it
        // rides registers and costs no box at all, so it cannot show
        // the managed cell's protocol. And a field READ from a binding:
        // a record the source alone spells is the binary's data.
        then "a dying value MOVES into the cell — no retain at the store, no release at the scope; the store releases old first, and the scope settles the cell" {
            let expected = """scope application {
  r0 = int 1
  r1 = str "a"
  r2 = int 2
  r3 = call avra_array_sized(r2)
  call avra_array_push(r3, r0)
  call avra_array_push_owned(r3, r1)
  r4 = slot
  call avra_cell_release(r4)
  store r4 <- r3
  r5 = int 1
  r6 = r0 + r5
  r7 = str "b"
  r8 = int 2
  r9 = call avra_array_sized(r8)
  call avra_array_push(r9, r6)
  call avra_array_push_owned(r9, r7)
  call avra_cell_release(r4)
  store r4 <- r9
  r10 = load r4
  r11 = int 0
  r12 = call avra_slot_get(r10, r11)
  r13 = call avra_int_text(r12)
  call avra_puts(r13)
  release r13
  call avra_cell_release(r4)
}
ret 0"""
            render_ir(
                ir_of(
                    "type P = { x: int, tag: string }\nlet n = 1\nmut a = P { x: n, tag: \"a\" }\na = P { x: n + 1, tag: \"b\" }\na.x",
                ),
            ) == expected
        }
    }
    given "the fn value's box (rung 13)" {
        then "a lambda lifts once, named for its file and its node" {
            let l = ir_of("let f = (x: int) -> x + 1\nf(2)")
            let names = [b.name for b in l.fns]
            // capture-free — its box is static data, never `Ins.FnAddr`
            addr_syms(l).length == 0 &&
                static_addr_syms(l).length == 1 &&
                names.any(it.ends_with("\$l3"))
        }
        then "a named fn boxes behind its wrapper" {
            let l = ir_of(
                "fn double(x: int) -> int {\n    x * 2\n}\nfn apply(f: fn(int) -> int, v: int) -> int {\n    f(v)\n}\napply(double, 4)",
            )
            let names = [b.name for b in l.fns]
            // no captures ever ride a named fn value — always static data
            let syms = static_addr_syms(l)
            addr_syms(l).length == 0 &&
                syms.length == 1 &&
                syms[0] == "double\$w" &&
                names.contains("double\$w")
        }
    }
    given "the program is the entry's closure" {
        then "a fn reached only from a lambda's body lowers; one nothing reaches stays out" {
            let l = ir_of(
                "fn helper(n: int) -> int {\n    n + 1\n}\nfn unused(n: int) -> int {\n    n\n}\nlet f = (n: int) -> helper(n)\nf(1)",
            )
            let names = [b.name for b in l.fns]
            names.contains("helper") && !names.contains("unused")
        }
        then "a struct literal calls its omitted field's default — one body, named for the field as a default" {
            let l = ir_of("type P = { x: int, y: int = 7 }\nP { x: 1 }.y")
            [b.name for b in l.fns].contains("P.y\$default")
        }
        then "a method reached only through a dyn box's vtable lowers; its uncalled sibling stays out" {
            let l = ir_of(
                "trait Show {\n    fn show() -> int\n}\ntype P = { x: int }\nimpl Show for P {\n    fn show() -> int {\n        self.x\n    }\n}\nimpl P {\n    fn unused() -> int {\n        0\n    }\n}\nlet d: dyn Show = P { x: 3 }\nd.show()",
            )
            let names = [b.name for b in l.fns]
            names.contains("P.show") && !names.contains("P.unused")
        }
        then "a fn reached only through a fn value in a struct field lowers" {
            let l = ir_of(
                "type H = { f: fn(int) -> int }\nfn inc(n: int) -> int {\n    n + 1\n}\nlet h = H { f: inc }\nh.f(1)",
            )
            [b.name for b in l.fns].contains("inc")
        }
    }
    given "the loop's condition settles every turn" {
        then "a value the condition MINTS is released before the test, inside the loop — never after it" {
            let l = ir_of(
                "type Db = { cells: List<int> }\nimpl Db {\n    fn tag() -> string {\n        \"ab\"\n    }\n    fn keep(at: int) {\n        while self.tag().length <= at { self.cells.push(1) }\n    }\n}\nmut db = Db { cells: [] }\ndb.keep(4)\ndb.cells.length",
            )
            let keep: Body? = l.fns.find(it.name == "Db.keep")
            keep != null && cond_mint_settled(keep!.ins)
        }
        then "a LENDING read in a condition borrows — the subject still holds it, so the body writes in place" {
            let l = ir_of(
                "type Db = { cells: List<int> }\nimpl Db {\n    fn keep(at: int) {\n        while self.cells.length <= at { self.cells.push(1) }\n    }\n}\nmut db = Db { cells: [] }\ndb.keep(4)\ndb.cells.length",
            )
            let keep: Body? = l.fns.find(it.name == "Db.keep")
            keep != null && !keep!.ins.any(is_owned_get(it))
        }
    }
}

/// The condition's MINTED value is released ONCE inside the loop,
/// never after it — the settle runs every turn, as the condition
/// does.
fn cond_mint_settled(ins: List<Ins>) -> bool {
    let start = marker_index(ins, Ins.LoopStart)
    let cond = cond_index(ins)
    let end = marker_index(ins, Ins.LoopEnd)
    let minted: Reg? = called_in(ins.slice(start, cond))
    minted != null &&
        releases_of(ins.slice(start, cond), minted!) == 1 &&
        releases_of(ins.slice(end, ins.length), minted!) == 0
}

/// The identity pack's destination holds NO reference — its value is
/// unmanaged, so `@owns` is a role and `is_managed` is the gate.
fn pack_carries_no_reference(ins: List<Ins>) -> bool {
    let d? = first_pack(ins) else { return false }
    retains_of(ins, d) == 0 && releases_of(ins, d) == 0
}

/// The element read views the box — no reference of its own.
fn extract_carries_no_reference(ins: List<Ins>) -> bool {
    let d? = first_extract(ins) else { return false }
    retains_of(ins, d) == 0 && releases_of(ins, d) == 0
}

/// Every instruction of every body — a projection may be emitted in a
/// callee's body while the read stands in the entry.
fn all_ins(l: Lowered) -> List<Ins> {
    flatten([b.ins for b in l.fns]).concat(l.entry.ins)
}

/// An Avra call whose one argument is managed — the `@lent` seat the
/// caller must retain before handing its reference over.
fn moved_seat() -> string {
    "fn id(s: string) -> string { s }\nid(\"a\" + \"b\")"
}

/// A call whose argument is a view into a box the caller holds.
fn viewed_seat() -> string {
    "type B = { xs: List<string> }\nfn n(xs: List<string>) -> int { xs.length }\nlet b = B { xs: [\"a\" + \"b\"] }\nn(b.xs)"
}

/// `viewed_seat`'s twin: the SAME call is ALSO handed the view's own
/// root — the one shape a callee could reach back through, so the
/// read takes its own reference rather than riding `b`'s.
fn viewed_seat_with_root() -> string {
    "type B = { xs: List<string> }\nfn n(b: B, xs: List<string>) -> int { xs.length }\nlet b = B { xs: [\"a\" + \"b\"] }\nn(b, b.xs)"
}

/// `rows_read`'s own shape: a Cell load's dependent (`state`) is read once
/// before a branch, then again inside EACH arm — one arm's last use sits
/// beside an unrelated call, the other arm's last use has none. The call
/// and that use never occur on the same executed path (each arm's own
/// check is `state`'s last read on ITS path), so it is no barrier to
/// either: the Cell field stays a view, taking no reference of its own.
fn cross_branch_call() -> string {
    "type Kernel = { tag: int }\ntype Decls = { rows_state: Cell<List<int>>, kernel: Cell<Kernel> }\nimpl Kernel {\n    fn touch(i: int) { }\n}\nimpl Decls {\n    fn rows_read(f: int) {\n        let state = self.rows_state.get()\n        if f >= state.length { return }\n        if state[f] == 1 {\n            self.kernel.get().touch(f)\n        } else if state[f] == 2 {\n        }\n    }\n}\nlet d = Decls { rows_state: Cell.new([1, 2, 3]), kernel: Cell.new(Kernel { tag: 0 }) }\nd.rows_read(0)"
}

/// A Cell's content borrowed, then `between` run, then the borrow read.
/// `clear` reaches the cell through no argument at all.
fn cell_read(between: string) -> string {
    "once fn shared() -> Cell<List<string>> { Cell.new([\"a\" + \"b\"]) }\nfn clear() { shared().set([]) }\nfn at(i: int) -> int {\n    let xs = shared().get()\n    ${between}\n    xs[i].length\n}\nat(0)"
}

/// `n` writes of `value` into the list of `elem` a Cell holds, seeded
/// with one `seed`.
fn cell_set_at(elem: string, value: string, seed: string) -> string {
    "fn fill(c: Cell<List<${elem}>>, n: int) {\n    for i in 0..n { c.set_at(i, ${value}) }\n}\nfill(Cell.new([${seed}]), 1)"
}

/// No `@lent` seat of any call in the slice is retained: each stands.
fn no_call_seat_counted(ins: List<Ins>) -> bool {
    let calls = [i for i in ins if i is .Call]
    flatten([lent_args(i) for i in calls]).all(retains_of(ins, it) == 0)
}

/// The destination of the first pack in the slice.
fn first_pack(ins: List<Ins>) -> Reg? {
    for i in ins {
        let d: Reg? = match i { .Pack(d, _) -> d, _ -> null }
        if d != null { return d }
    }
    null
}

/// The destination of the first element read in the slice.
fn first_extract(ins: List<Ins>) -> Reg? {
    for i in ins {
        let d: Reg? = match i { .Extract(d, _, _) -> d, _ -> null }
        if d != null { return d }
    }
    null
}

/// The register the first body CALL in the slice defines.
fn called_in(ins: List<Ins>) -> Reg? {
    for i in ins {
        let dst: Reg? = match i { .Call(d, _, _) -> d, _ -> null }
        if dst != null { return dst }
    }
    null
}

fn releases_of(ins: List<Ins>, r: Reg) -> int {
    ins.filter(releases(it, r)).length
}

fn releases(i: Ins, r: Reg) -> bool {
    match i { .Release(x) -> same_reg(x, r), _ -> false }
}

/// The register the FIRST slot read in the slice defines.
fn loaded_in(ins: List<Ins>) -> Reg? {
    for i in ins {
        let dst: Reg? = match i { .Load(d, _) -> d, _ -> null }
        if dst != null { return dst }
    }
    null
}

fn retains_of(ins: List<Ins>, r: Reg) -> int {
    ins.filter(retains(it, r)).length
}

fn retains(i: Ins, r: Reg) -> bool {
    match i { .Retain(x) -> same_reg(x, r), _ -> false }
}

/// The first slot read OWNS its value — retained once, released once.
fn read_owns(ins: List<Ins>) -> bool {
    let r? = loaded_in(ins) else { return false }
    retains_of(ins, r) == 1 && releases_of(ins, r) == 1
}

/// The first slot read BORROWS — the cell's reference is the only one.
fn read_borrows(ins: List<Ins>) -> bool {
    let r? = loaded_in(ins) else { return false }
    retains_of(ins, r) == 0 && releases_of(ins, r) == 0
}

fn cond_index(ins: List<Ins>) -> int {
    // LICENSED loops.push_loop: an index scan — the position is the answer
    for j, i in ins {
        if i is .LoopCond { return j }
    }
    0 - 1
}

/// The position of a unit marker (`LoopStart`, `LoopEnd`).
fn marker_index(ins: List<Ins>, marker: Ins) -> int {
    // LICENSED loops.push_loop: an index scan — the position is the answer
    for j, i in ins {
        if same_marker(i, marker) { return j }
    }
    0 - 1
}

fn same_marker(i: Ins, marker: Ins) -> bool {
    i is .LoopStart && marker is .LoopStart || i is .LoopEnd && marker is .LoopEnd
}

/// A fn's IR by name, from the rendered module.
fn body_of(text: string, name: string) -> string {
    let at = text.index_of("fn ${name}(")
    if at < 0 { return "" }
    let rest = text.substring(at, text.length)
    let end = rest.index_of("\nret ")
    if end < 0 { rest } else { rest.substring(0, end) }
}

fn cell_settles(text: string) -> int {
    text.split("avra_cell_release").length - 1
}

/// A one-instruction body whose only register wears `ty`.
fn constant_body(ty: TypeId, v: int) -> Body {
    Body {
        name: "probe",
        params: [],
        ret: ty,
        gives: null,
        ins: [Ins.ConstInt(Reg { index: 0 }, v)],
        reg_types: [ty],
    }
}

spec "the pointer-constant law" {
    given "a constant aimed at a pointer-riding register" {
        // the case source cannot reach — nothing mints a pointer —
        // so the law is fed a body directly
        then "a NON-ZERO one is refused at lowering, before either engine reads it as null" {
            mut types = new_type_registry()
            let str_ty = types.type(string)
            let spoken = minted_pointers(types, [constant_body(str_ty, 5)])
            spoken.length == 1 && spoken[0].message.contains("a pointer's only constant is null")
        }
        then "ZERO is the null pointer and passes" {
            mut types = new_type_registry()
            let str_ty = types.type(string)
            minted_pointers(types, [constant_body(str_ty, 0)]).is_empty()
        }
        then "a scalar register takes any constant" {
            mut types = new_type_registry()
            let int_ty = types.type(int)
            minted_pointers(types, [constant_body(int_ty, 5)]).is_empty()
        }
    }
}

spec "a managed read is a borrow" {
    given "liveness in the memory pass (S3)" {
        then "a read whose uses stand before any change to its cell owns NOTHING" {
            read_borrows(
                ir_of("type P = { x: int, tag: string }\nmut a = P { x: 1, tag: \"a\" }\na.x")
                    .entry
                    .ins,
            )
        }
        then "a read whose use stands PAST a write to its cell owns — the borrow must outlive it" {
            read_owns(
                ir_of(
                    "type P = { x: int, tag: string }\nmut a = P { x: 1, tag: \"a\" }\nlet b = a\na = P { x: 2, tag: \"b\" }\nb.x",
                )
                    .entry
                    .ins,
            )
        }
    }
}

spec "a value dies at its last read" {
    given "a hold taken across a call on `self`, and a write to the same field after it" {
        then "the hold is released before the write, so the write lands in place" {
            let open = ir_of(held_then_written()).fns.find(it.name.ends_with("M.open"))
            open != null && released_before_write(open!.ins)
        }
    }
    given "a payload read out of an enum, used after the enum's own last read" {
        then "no value read out of a register is read after that register's release" {
            !view_read_after_release(all_ins(ir_of(payload_read())))
        }
    }
}

fn held_then_written() -> string {
    "type M = { cells: List<List<int>> }\nimpl M {\n    fn cloned(v: List<int>) -> List<int> { v.concat([]) }\n    mut fn open(id: int) {\n        let fresh = self.cloned(self.cells[id])\n        self.cells.set(id, fresh)\n    }\n}\nmut m = M { cells: [[1]] }\nm.open(0)\nm.cells.length"
}

fn payload_read() -> string {
    "enum K {\n    A(w: string)\n    B\n}\ntype S = { k: K, n: int }\nfn made(s: string) -> K { K.A(s + \"!\") }\nlet s = S { k: made(\"x\"), n: 1 }\ns.n"
}

/// The owned read the hold is taken by is released before the first
/// write that opens the same box.
fn released_before_write(ins: List<Ins>) -> bool {
    let got? = [j for j in 0..ins.length].find((j: int) -> is_owned_get(ins[j])) else { return false }
    let held? = dst_of(ins[got]) else { return false }
    let freed? = [j for j in 0..ins.length].find((j: int) -> releases(ins[j], held)) else { return false }
    let written? = [j for j in 0..ins.length].find((j: int) -> opens_slot(ins[j])) else { return false }
    freed < written
}

fn opens_slot(i: Ins) -> bool {
    match i { .CallRt(_, callee, _) -> callee == "avra_slot_unique", _ -> false }
}

/// Whether some value read out of a register is read after the
/// register's release.
fn view_read_after_release(ins: List<Ins>) -> bool {
    [j for j in 0..ins.length].any((j: int) -> outlives_its_source(ins, j))
}

fn outlives_its_source(ins: List<Ins>, at: int) -> bool {
    let freed? = released_reg(ins[at]) else { return false }
    let views = flatten([some_list(extracted_from(ins[j], freed)) for j in 0..at])
    [k for k in at + 1..ins.length]
        .any((k: int) -> reads_of(ins[k]).any((r: Reg) -> views.any(same_reg(it, r))))
}

fn released_reg(i: Ins) -> Reg? {
    match i { .Release(r) -> r, _ -> null }
}

fn extracted_from(i: Ins, src: Reg) -> Reg? {
    match i { .Extract(d, s, _) -> if same_reg(s, src) { d } else { null }, _ -> null }
}

spec "a mut cell's type" {
    given "a cell seeded with null, its binding declared a boxed nullable" {
        then "the cell settles at the scope's end — the widen from null is identity, the declared type is the cell's" {
            let l = ir_of(
                "type Far = { cursor: int, expected: List<string> }\nfn hold(i: int) -> int {\n    mut x: Far? = null\n    x = Far { cursor: i, expected: [] }\n    if x == null { 0 } else { x!.cursor }\n}\nhold(3)",
            )
            cell_settles(body_of(render_ir(l), "hold")) >= 2
        }
        then "a store of null into a managed cell releases what it held" {
            let l = ir_of(
                "type Far = { cursor: int, expected: List<string> }\nfn drop(i: int) -> int {\n    mut x: Far? = Far { cursor: i, expected: [] }\n    x = null\n    if x == null { 0 } else { 1 }\n}\ndrop(3)",
            )
            cell_settles(body_of(render_ir(l), "drop")) >= 2
        }
    }
}

spec "a region arm that leaves the function" {
    given "a borrow read before a branch that empties the container and RETURNS" {
        then "the arm never reaches the read after it, so the borrow costs no retain" {
            let l = ir_of(early_exit_borrow())
            let skips: Body? = l.fns.find(it.name == "skips")
            skips != null && !skips!.ins.any(is_owned_get(it))
        }
    }
    given "the same branch REJOINING instead of returning" {
        then "the change now stands between the borrow and its read, so it stays owned" {
            let l = ir_of(early_exit_borrow())
            let stays: Body? = l.fns.find(it.name == "stays")
            stays != null && stays!.ins.any(is_owned_get(it))
        }
    }
}

/// A borrow taken before a branch that empties the container it was
/// read from — once by a branch that RETURNS, once by one that REJOINS.
fn early_exit_borrow() -> string {
    "type Bag = { rows: List<string> }\nfn touched(mut b: Bag, xs: List<string>) -> int {\n    b.rows = []\n    xs.length\n}\nfn skips(mut b: Bag, guard: bool) -> int {\n    let xs = b.rows\n    let row = xs[0]\n    if guard {\n        touched(b, xs)\n        return 0 - 1\n    }\n    row.length\n}\nfn stays(mut b: Bag, guard: bool) -> int {\n    let xs = b.rows\n    let row = xs[0]\n    if guard {\n        touched(b, xs)\n    }\n    row.length\n}\nmut a = Bag { rows: [\"kept-a\"] }\nmut c = Bag { rows: [\"kept-b\"] }\nskips(a, false) + stays(c, true)"
}

spec "a parameter's consumed mark, read off ir_of's own lowering" {
    given "a seat stored whole on every path to the answer" {
        then "the body's own lowered marks say so — a one-shot workspace must still ask R3 at lowering" {
            let l = ir_of(
                "type P = { n: int, items: List<int> }\nfn always(p: P) -> List<P> { [p] }\nalways(P { n: 1, items: [] })",
            )
            let always: Body? = l.fns.find(it.name == "always")
            always != null && consumed_mark(always!.marks, 0)
        }
    }
}
