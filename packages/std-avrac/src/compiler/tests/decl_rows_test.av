// A file's `Items` cell hashes its STABLE rows — name, kind, owner, visibility, parse
// facts — so a body, a comment or a reindent moves nothing, and a rename, a kind change, a
// moved annotation or a new declaration moves it. A reader of one foreign declaration
// records its NAME's bucket instead, never that whole file; the file's own minter, which
// reads its rows while they are made, never records itself. `a_process_over`, `checked`
// and `decl_in_file` are workspace_fixtures.av's own.
use query.{Key}
use compiler.{Workspace}

fn items_ordinal() -> int { 2 }

fn typed_ordinal() -> int { 8 }

/// `b`'s `Items` cell as it settles over `text`, the only file that varies.
fn items_hash(text: string) -> int? {
    let files: Map<string, string> = {"/w/src/b.av": text}
    let ws = a_process_over(files, ["/w/src/b.av"])
    let b = ws.file_id("/w/src/b.av")
    let _ = ws.items(b)
    ws.db.value_hash_of(Key { family: items_ordinal(), arg: b.index })
}

fn base_b() -> string {
    "export fn helper(n: int) -> int {\n    n + 1\n}\nexport type Box = { v: int }\nexport type Other = { w: int }\nimpl Box {\n    fn get() -> int {\n        self.v\n    }\n}\nimpl Other {\n    fn peek() -> int {\n        self.w\n    }\n}\n"
}

/// `text` is the same row set as `base_b`.
fn same_rows(text: string) -> bool {
    let before = items_hash(base_b())
    before != null && before == items_hash(text)
}

/// `text` is another row set.
fn other_rows(text: string) -> bool {
    let before = items_hash(base_b())
    let after = items_hash(text)
    before != null && after != null && before != after
}

spec "compiler/rows — a file's items hash the stable rows" {
    then "fixture: the rows settle a hash" {
        items_hash(base_b()) != null
    }
    then "a body edit moves nothing" {
        same_rows(base_b().replace("n + 1", "n + 2"))
    }
    then "a comment moves nothing" {
        same_rows("// what helper does\n${base_b()}")
    }
    then "blank lines move nothing" {
        same_rows("\n\n${base_b()}")
    }
    then "a signature's TYPE moves nothing: the signature is Sig's" {
        same_rows(
            base_b().replace("(n: int) -> int", "(n: int) -> string").replace("n + 1", "\"s\""),
        )
    }
    then "a rename moves it" {
        other_rows(base_b().replace("helper", "helper2"))
    }
    then "visibility moves it" {
        other_rows(base_b().replace("export fn helper", "fn helper"))
    }
    then "a kind change moves it" {
        other_rows(
            base_b()
                .replace("export type Box = { v: int }", "export enum Box {\n    A\n}")
                .replace("self.v", "1"),
        )
    }
    then "a new declaration moves it" {
        other_rows("${base_b()}export fn extra() -> int {\n    3\n}\n")
    }
    then "a parameter NAME moves it: the seats are a fact of the row" {
        other_rows(base_b().replace("(n: int)", "(m: int)").replace("n + 1", "m + 1"))
    }
    then "swapping two methods between two impls moves it" {
        other_rows(
            base_b()
                .replace("fn get()", "fn tmp()")
                .replace("fn peek()", "fn get()")
                .replace("fn tmp()", "fn peek()"),
        )
    }
    then "declaration order moves it" {
        other_rows(
            base_b()
                .replace(
                    "export type Box = { v: int }\nexport type Other = { w: int }\n",
                    "export type Other = { w: int }\nexport type Box = { v: int }\n",
                ),
        )
    }
    then "a `///` doc line moves it" {
        other_rows(base_b().replace("export fn helper", "/// adds one\nexport fn helper"))
    }
}

/// `a`'s `g` calls `helper` from `b`.
fn caller_files() -> Map<string, string> {
    {"/w/src/a.av": "export fn g() -> int {\n    helper(1)\n}\n", "/w/src/b.av": base_b()}
}

/// Whether `key`'s cell lists a dep on the file's `Items`.
fn reads_items(ws: Workspace, frame: Key, file: string) -> bool {
    let f = ws.file_id(file)
    ws.db.deps_of(frame).any((k: Key) -> k.family == items_ordinal() && k.arg == f.index)
}

/// Whether `frame`'s cell lists the dep a label names.
fn lists(ws: Workspace, frame: Key, label: string) -> bool {
    ws.db.deps_of(frame).any((k: Key) -> ws.key_label(k) == label)
}

spec "compiler/rows — a foreign read records its name's bucket" {
    then "a caller's typing lists its callee's name, and neither the callee's file nor a name it never reads" {
        let names = ["/w/src/a.av", "/w/src/b.av"]
        let ws = a_process_over(caller_files(), names)
        let _ = checked(ws, "/w/src/a.av")
        let g = Key { family: typed_ordinal(), arg: decl_in_file(ws, "/w/src/a.av", "g").index }
        lists(ws, g, "Named(helper)") &&
            !reads_items(ws, g, "/w/src/b.av") &&
            !lists(ws, g, "Named(peek)")
    }
    then "no file's Items lists itself" {
        let names = ["/w/src/a.av", "/w/src/b.av"]
        let ws = a_process_over(caller_files(), names)
        let _ = checked(ws, "/w/src/a.av")
        let a = ws.file_id("/w/src/a.av")
        let b = ws.file_id("/w/src/b.av")
        !reads_items(ws, Key { family: items_ordinal(), arg: a.index }, "/w/src/a.av") &&
            !reads_items(ws, Key { family: items_ordinal(), arg: b.index }, "/w/src/b.av")
    }
}
