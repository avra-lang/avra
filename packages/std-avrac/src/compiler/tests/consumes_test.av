// The consumes pass infers a seat CONSUMED only when every path to an
// answer keeps it whole; a keep on some paths leaves it borrowed.
use @std.avrac.core.{consumed_mark}
use @std.avrac.testing.{ir_of}
use compiler.lower.{Lowered}

const shapes: string = "type P = { n: int, items: List<int> }\n" +
    "fn always(p: P) -> List<P> { [p] }\n" +
    "fn bumped(p: P) -> P { p with { n: 2 } }\n" +
    "fn cold(p: P, c: bool) -> List<P> {\n    if c { return [p] }\n    []\n}\n" +
    "fn arms(p: P, c: bool) -> List<P> { if c { [p] } else { [p, p] } }\n" +
    "fn handed(p: P, c: bool) -> P {\n    if c { return p }\n    p with { n: 1 }\n}\n" +
    "fn guarded(p: P) -> P {\n    if p.n <= 0 { return P { n: 0, items: [] } }\n    p with { n: p.n - 1 }\n}\n" +
    "fn failing(p: P, c: bool) -> Result<List<P>, string> {\n    if c { fail \"no\" }\n    .Ok([p])\n}\n" +
    "fn short(p: P, c: bool) -> bool { c && [p].length > 0 }\n" +
    "fn looped(p: P, n: int) -> int {\n    mut t = 0\n    for _i in 0..n { t = t + [p].length }\n    t\n}\n" +
    "fn captured(p: P) -> fn() -> int { () -> p.n }\n" +
    "fn matched(p: P, k: int) -> List<P> { match k { 0 -> [p], _ -> [p, p] } }\n" +
    "fn coalesced(p: P, q: List<P>?) -> List<P> { q ?? [p] }\n" +
    "let q = P { n: 1, items: [1] }\n" +
    "let _ = always(q)\n" +
    "let _ = bumped(q)\n" +
    "let _ = cold(q, true)\n" +
    "let _ = arms(q, true)\n" +
    "let _ = handed(q, true)\n" +
    "let _ = guarded(q)\n" +
    "let _ = failing(q, false)\n" +
    "let _ = short(q, true)\n" +
    "let _ = looped(q, 2)\n" +
    "let _ = captured(q)\n" +
    "let _ = matched(q, 0)\n" +
    "let _ = coalesced(q, null)\n" +
    "1"

/// Whether the body named `name` consumes its seat `j`.
fn consumes(l: Lowered, name: string, j: int) -> bool {
    consumed_mark(l.fns.find(it.name == name)?.marks ?? [], j)
}

spec "compiler/consumes" {
    given "a seat kept on every path to an answer" {
        then "an unconditional store consumes it" { consumes(ir_of(shapes), "always", 0) }
        then "an unconditional `with` consumes it" { consumes(ir_of(shapes), "bumped", 0) }
        then "a keep in every arm of an `if` consumes it" { consumes(ir_of(shapes), "arms", 0) }
        then "a keep in every arm of a `match` consumes it" { consumes(ir_of(shapes), "matched", 0) }
        then "an early `return` of the seat is a keep on its own path" { consumes(ir_of(shapes), "handed", 0) }
        then "a path that fails is not asked" { consumes(ir_of(shapes), "failing", 0) }
    }
    given "a seat kept on some paths only" {
        then "a keep on a cold arm leaves it borrowed" { !consumes(ir_of(shapes), "cold", 0) }
        then "an early `return` that drops it leaves it borrowed" { !consumes(ir_of(shapes), "guarded", 0) }
        then "a short-circuited right side leaves it borrowed" { !consumes(ir_of(shapes), "short", 0) }
        then "a loop body leaves it borrowed" { !consumes(ir_of(shapes), "looped", 0) }
        then "a `??` right side leaves it borrowed" { !consumes(ir_of(shapes), "coalesced", 0) }
        then "a lambda's capture is no keep" { !consumes(ir_of(shapes), "captured", 0) }
    }
}
