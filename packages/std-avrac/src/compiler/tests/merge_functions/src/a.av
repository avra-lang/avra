export type StructA = { v: string }

fn first_of_a<T>(xs: List<T>) -> T? {
    if xs.length == 0 { null } else { xs[0] }
}

export fn describe_a() -> string {
    let empty: List<StructA> = []
    let none = first_of_a(empty)
    let items = [StructA { v: "a1" }, StructA { v: "a2" }]
    let found? = first_of_a(items) else { return "none" }
    "${none?.v ?? "empty"}/${found.v}"
}
