export type StructB = { v: List<int> }

fn first_of_b<T>(xs: List<T>) -> T? {
    if xs.length == 0 { null } else { xs[0] }
}

export fn describe_b() -> string {
    let empty: List<StructB> = []
    let none = first_of_b(empty)
    let items = [StructB { v: [1, 2] }, StructB { v: [3] }]
    let found? = first_of_b(items) else { return "none" }
    "${none?.v?.length ?? -1}/${found.v.length}"
}
