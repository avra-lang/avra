// proves: a BuildError wired as a Diag's cause renders through the
// same chain-walk every dyn Error takes — a build failure gets no
// separate mechanism from a type error's.
use @std.avrac.compiler.{BuildError}
use @std.avrac.diagnostics.{error_at, render, new_source_file}

let d = error_at("build.command_failed", null, "the build failed") with { cause: BuildError.LinkFailed(1, []) }
render(d, new_source_file("<build>", ""))
