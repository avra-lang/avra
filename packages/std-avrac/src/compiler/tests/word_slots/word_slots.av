// proves: every value category crossing a runtime row's WORD SLOT and
// coming back — the list, map and cell rows keep `int64_t` cells, so a
// value entering one is converted and a value leaving one is converted
// back, and the two directions read ONE table (`slot_form`, llvm.av).
// A category filed wrong is not a refusal: it is a double read as an
// integer, a box freed as a number, a bool that is always true.
trait Shows { fn shown() -> string }

type Flat = { only: float }
type Named = float
type Holder<T> = { held: T }

enum Carried {
    F(v: float)
    B(v: bool)
    S(v: string)
}

impl Shows for Flat { fn shown() -> string { "flat${self.only}" } }

fn doubled(v: float) -> float { v * 2.0 }

fn carried(c: Carried) -> string {
    match c {
        .F(v) -> "${v}",
        // LICENSED compiler.one_body_arms: a float and a bool, one name at two types
        .B(v) -> "${v}",
        .S(v) -> v,
    }
}

fn answered() -> Result<float, string> { .Ok(4.5) }

fn opened(r: Result<float, string>) -> float {
    match r {
        .Ok(v) -> v,
        .Err(_) -> 0.0,
    }
}

// The ADDRESS form: a box's pointer packed into a word and read back.
let strs = ["a", "b"]
let lists = [[1], [2, 3]]
let maps = [{"k": 1}]
let bytes = ["hi".bytes()]
let dyns: List<dyn Shows> = [Flat { only: 1.5 }]
let fns: List<fn(float) -> float> = [doubled]
let apps = [Holder { held: 2.5 }]
let carriers = [Carried.F(3.5), Carried.B(true), Carried.S("s")]
let results = [answered()]

// The REINTERPRETED form: a double is not a word in either direction.
mut floats = [1.5, 2.5]
let float_map = {"f": 6.5}
let float_cell = Cell.new(7.5)
let flat = Flat { only: 8.5 }
let named: Named = 9.5

// The WIDENED form: a bool rides zero-extended and narrows on the way out.
let bools = [true, false]
let bool_map = {"b": true}
let bool_cell = Cell.new(false)

// The WORD form: an int is already the slot, and a SCALAR-PAIR nullable
// is no slot at all — `Map.get` answers one and nothing converts it.
let ints = [10, 11]
let empty_ints: List<int> = []
let empty_map: Map<string, int> = {}

"str=${strs[1]} list=${lists[1].length} map=${maps[0].get("k") ?? 0} bytes=${bytes[0].length}" + " dyn=${dyns[0].shown()} fn=${(fns[0])(1.25)} app=${apps[0].held}" + " carried=${carried(carriers[0])},${carried(carriers[1])},${carried(carriers[2])}" + " res=${opened(results[0])} float=${floats[1]} fmap=${float_map.get("f") ?? 0.0}" + " fcell=${float_cell.get()} flat=${flat.only} named=${named}" + " bool=${bools[0]},${bools[1]} bmap=${bool_map.get("b") ?? false} bcell=${bool_cell.get()}" + " int=${ints[1]} pair=${bool_map.get("gone") ?? true},${float_map.get("gone") ?? 0.5}" + " n0=${empty_ints.length},${empty_map.length} pop=${floats.pop()}"
