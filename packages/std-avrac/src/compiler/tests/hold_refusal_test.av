// The voice a refused hold speaks (compiler/derive.av): one line naming
// the law, the held attempt's first word of why and where the rest is
// kept — so a fallback that WORKED does not read as a crash.
use compiler.{hold_refusal, hold_refusal_unkept}

spec "compiler/derive — the refused hold's voice" {
    given "a held attempt that said something under the hold" {
        then "it is one line" {
            !hold_refusal("error[x]: boom\n  detail", "/s/hold-refused.log").contains("\n")
        }
        then "it carries the phrase tools/cache_attacks.sh and tools/hold_sweep.sh grep for" {
            hold_refusal("x", "/s/l").starts_with("avra: the hold was refused")
        }
        then "the cause is the attempt's first line that says anything" {
            hold_refusal("\n  \nerror[x]: boom\n  detail", "/s/l").contains("(error[x]: boom)")
        }
        then "it names where the attempt's words are kept" {
            hold_refusal("error[x]: boom", "/s/hold-refused.log").ends_with("/s/hold-refused.log")
        }
        then "an attempt that said nothing still names a cause" {
            hold_refusal("", "/s/l").contains("(it said nothing)")
        }
    }
    given "an inspection, which keeps no words" {
        then "it is one line carrying the phrase, and the cause" {
            let said = hold_refusal_unkept("error[x]: boom\n  detail")
            !said.contains("\n") &&
                said.starts_with("avra: the hold was refused") &&
                said.contains("(error[x]: boom)")
        }
        then "it names the command that keeps the words, never a file" {
            !hold_refusal_unkept("x").contains("hold-refused.log") &&
                hold_refusal_unkept("x").contains("`avra check`")
        }
    }
}
