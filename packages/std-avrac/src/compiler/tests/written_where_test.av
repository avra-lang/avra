// A method's written receiver is the receivers pass's answer only where the pass can be
// asked. Inside a resolve it cannot run, so a read there answers what the method declares,
// in every order — the pass settled or not — and needs no edge. Outside one, asking records
// the pass and the answer is what was declared or found. `bump` writes through `self`
// without saying `mut`, so only the pass knows.
use core.{DeclId}
use compiler.{Workspace}
use @std.relation.engine.{Key}

fn resolve_ordinal() -> int { 30 }

/// A `bump` that writes through `self` without saying `mut`.
fn writer_body() -> string {
    "export type Box = { v: int }\nimpl Box {\n    fn bump() {\n        self.v = self.v + 1\n    }\n}\n"
}

/// `a` calls `bump` on a binding that is not `mut`; the callee sits in a module of its own.
fn written_files(callee: string) -> Map<string, string> {
    {
        "/w/src/a.av": "use other.{Box}\n\nexport fn g() -> int {\n    let b = Box { v: 1 }\n    b.bump()\n    b.v\n}\n",
        "/w/src/other/b.av": callee,
    }
}

fn written_names() -> List<string> { ["/w/src/a.av", "/w/src/other/b.av"] }

fn bump_of(ws: Workspace) -> DeclId { [d.id for d in ws.decls.all_decls() if d.name == "bump"][0] }

/// A workspace whose receivers pass has settled over the writing `bump`.
fn settled_over_writer() -> Workspace {
    let ws = a_process_over(written_files(writer_body()), written_names())
    let _ = checked(ws, "/w/src/a.av")
    ws
}

/// What `writes_receiver` answers for `d` with a resolve open, which is where the pass
/// cannot be asked.
fn writes_inside_resolve(ws: Workspace, d: DeclId) -> bool {
    let k = Key { family: resolve_ordinal(), arg: 9999 }
    ws.db.begin(k)
    let answer = ws.decls.writes_receiver(d)
    ws.db.settle(k, 1)
    answer
}

/// What `written_found` answers for `d` with a resolve open.
fn found_inside_resolve(ws: Workspace, d: DeclId) -> bool? {
    let k = Key { family: resolve_ordinal(), arg: 9999 }
    ws.db.begin(k)
    let answer = ws.decls.written_found(d)
    ws.db.settle(k, 1)
    answer
}

spec "compiler/receivers — a written receiver is read where the pass can be asked" {
    then "outside a resolve, the pass's finding is read" {
        let ws = settled_over_writer()
        ws.decls.writes_receiver(bump_of(ws))
    }
    then "inside a resolve, a method that only writes by inference reads as declaring nothing, though the pass settled" {
        let ws = settled_over_writer()
        let bump = bump_of(ws)
        !writes_inside_resolve(ws, bump)
    }
    then "outside a resolve, the pass's negative is a finding" {
        let ws = settled_over_writer()
        ws.decls.written_found(bump_of(ws)) == true
    }
    then "inside a resolve, the pass has no finding to give" {
        let ws = settled_over_writer()
        found_inside_resolve(ws, bump_of(ws)) == null
    }
}
