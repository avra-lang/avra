// proves: the IR's ownership ROLES decide the identity pack's
// reference. A FLAT record that IS a managed field (one string field)
// is packed and read back under churn, so a `Pack` marked a VIEW — or
// an `Extract` marked owning — frees a live name and the two engines
// disagree. The marks are read by the memory pass, so the program is
// the receipt that they still say what the pass acts on.
type Tag = { s: string }

fn tag(n: int) -> Tag {
    Tag { s: "t${n}" }
}

let acc = ""
let i = 0
while i < 400 {
    let t = tag(i)
    acc = t.s
    i = i + 1
}
"${acc} ${tag(7).s} ${acc.length}"
