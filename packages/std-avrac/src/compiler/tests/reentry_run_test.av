// A RE-ENTRY'S MEMORY BELONGS TO ITS OUTER RUN: what a file's first
// re-entrant expansion settled is read while that run is open, and a
// later revision's run starts with none of it.
use @std.avrac.testing.{test_workspace}
use compiler.{Workspace}
use compiler.host.{memory_host}

fn reentry_workspace() -> Workspace {
    test_workspace(
        memory_host(
            {
                "/w/avra.toml": "[package]\nname = \"w\"\nversion = \"0.1.0\"\n",
                "/w/src/a.av": "export fn f() -> int {\n    1\n}\n",
            },
            ["/w/avra.toml", "/w/src/a.av"],
        ),
        "/w",
    )
}

spec "compiler/expand — a re-entry is settled for its run only" {
    given "a file expanded outside any run" {
        then "nothing is kept once the expansion ends" {
            let ws = reentry_workspace()
            let a = ws.file_id("/w/src/a.av")
            let _ = ws.expanded(a)
            ws.decls.reentry_answer(a) == null
        }
    }
    given "a re-entry kept for an open run" {
        then "it is read back, and the run's end clears it" {
            let ws = reentry_workspace()
            let a = ws.file_id("/w/src/a.av")
            ws.decls.reentry_kept(a, [])
            let held = ws.decls.reentry_answer(a) != null
            ws.decls.reentry_over(a)
            held && ws.decls.reentry_answer(a) == null
        }
        then "a later revision's expansion starts with none of it" {
            let ws = reentry_workspace()
            let a = ws.file_id("/w/src/a.av")
            ws.decls.reentry_kept(a, [])
            ws.db.kernel.bump()
            let _ = ws.expanded(a)
            ws.decls.reentry_answer(a) == null
        }
    }
    given "a re-entry computing" {
        then "is running until it is kept, and then its answer stands" {
            let ws = reentry_workspace()
            let a = ws.file_id("/w/src/a.av")
            let before = ws.decls.reentry_running(a)
            ws.decls.reentry_begun(a)
            let during = ws.decls.reentry_running(a)
            ws.decls.reentry_kept(a, [])
            !before && during && !ws.decls.reentry_running(a) && ws.decls.reentry_answer(a) != null
        }
        then "is no longer running once the outer run ends" {
            let ws = reentry_workspace()
            let a = ws.file_id("/w/src/a.av")
            ws.decls.reentry_begun(a)
            ws.decls.reentry_over(a)
            !ws.decls.reentry_running(a)
        }
    }
}
