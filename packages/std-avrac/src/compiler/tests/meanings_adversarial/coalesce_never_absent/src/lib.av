type Header = { name: string, value: string }

/// A `??` whose left is never absent: it asks nothing, so it has no meaning of its own.
export fn never_absent(a: int) -> int { a ?? 0 }

/// The same, in a comprehension's clause.
export fn fields(lines: List<string>) -> List<Header> {
    [Header { name: l.substring(0, at), value: l.substring(at + 2, l.length) } for l in lines for at in [l.index_of(": ") ?? -1] if at > 0]
}

/// A `??` whose left may be absent keeps its meaning.
export fn may_be_absent(a: int?) -> int { a ?? 0 }
