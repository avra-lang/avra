// THE PARITY KEEPER: `File`/`Module` carry the real shape — the hand
// tables they replaced are gone, so what remains pins the two edges a
// relation-backed table can still get wrong: a bucket read before the
// row that belongs in it exists, and a row inserted after the pinned
// handle was taken.
use core.{FileId, same_file}
use compiler.{Workspace}
use features.{Decls, new_decls}

spec "compiler/file_rows — a module's file bucket read then written in one revision" {
    then "a file minted after its module's file list was read still reads back through the relation" {
        let ws = a_process_over(package_files(), ["/w/src/a.av"])
        let a_id = ws.file_id("/w/src/a.av")
        let m = ws.decls.file(a_id).module_id
        let before = ws.decls.files_of_module(m)
        let b_id = ws.file_id("/w/src/b.av")
        let after = ws.decls.files_of_module(m)
        before.length == 1 && after.length == 2 && after.any((f: FileId) -> same_file(f, b_id))
    }
}

// THE PINNED HANDLE'S IDENTITY: `Decls.file_rows`/`module_rows` are read once
// at construction (`Cell.new(File.rows_in(db))`) and never re-pinned — so a row
// a later `file_id`/`module_id` call inserts must still be visible through that
// SAME pin, or `file(f)`/`module_name(m)` would answer for a row that was never
// there when they were taken. Both read through the pin (`file`, `module_name`),
// proving it directly rather than through the index doors (`by_path`/`by_name`).
spec "compiler/file_rows — the pinned Rows<File>/Rows<Module> handle sees a row inserted after Decls was built" {
    then "a file minted after Decls was constructed reads back through the pin" {
        let d: Decls = new_decls()
        let f = d.file_id("/w/src/pinned.av", "pinned", false)
        d.file(f).path == "/w/src/pinned.av"
    }
    then "a module minted after Decls was constructed reads back through the pin" {
        let d: Decls = new_decls()
        let f = d.file_id("/w/src/pinned.av", "pinned", false)
        d.module_name(d.file(f).module_id) == "pinned"
    }
}
