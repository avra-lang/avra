// A PLACE IS A TOKEN, NOT A BYTE. Every comment and every space a file gains moves the offsets
// below it and no token at all, so a place kept as (token index, distance into it) still names
// the same program text afterwards — resolved with the lexer alone, no grammar, no parse. A
// SHAPE decides whether a file's answers may be reused: one for texts that differ only in plain
// comments and spaces, another for any edit to a token, a doc or a license claim.
use @std.errors.{Loc}
use compiler.{anchored_at, placed_in, avra, shape_digest, lexed_under, LexWords}

fn tp_text() -> string { "fn first() -> int {\n    1\n}\n\nfn second(n: int) -> int {\n    n + 2\n}\n" }

fn tp_shifted() -> string { "// a line\n// another\n\n${tp_text()}" }

fn tp_body_edited() -> string { tp_text().replace("n + 2", "n + 3") }

/// `needle`'s first occurrence, `width` bytes wide.
fn tp_place(text: string, needle: string, width: int) -> Loc {
    let lo = text.index_of(needle)
    Loc { file: null, lo: lo, hi: lo + width }
}

spec "compiler/token-place — a place follows its tokens" {
    given "a place in a file, read back over the same text" {
        then "it stands where it stood" {
            let at = tp_place(tp_text(), "n + 2", 5)
            let back? = placed_in(tp_text(), anchored_at(tp_text(), at)) else { return false }
            back.lo == at.lo && back.hi == at.hi
        }
    }
    given "two comment lines and a blank added above the file" {
        then "the place moves by exactly their length and names the same bytes" {
            let at = tp_place(tp_text(), "n + 2", 5)
            let kept = anchored_at(tp_text(), at)
            let back? = placed_in(tp_shifted(), kept) else { return false }
            back.lo == at.lo + 22 && back.hi == at.hi + 22
        }
    }
    given "a file whose body changed" {
        then "a kept place still resolves — the token it names is still there" {
            let at = tp_place(tp_text(), "n + 2", 5)
            placed_in(tp_body_edited(), anchored_at(tp_text(), at)) != null
        }
    }
}

/// `text`'s shape, lexed under `grammars`, its docs unread.
fn tp_shape(text: string, grammars: List<string>) -> string { tp_shaped(text, grammars, false) }

fn tp_shaped(text: string, grammars: List<string>, docs: bool) -> string { tp_lined(text, grammars, docs, false) }

fn tp_lined(text: string, grammars: List<string>, docs: bool, lined: bool) -> string {
    shape_digest(
        text,
        lexed_under(text, LexWords { grammars: grammars, components: [], own: [] }, avra().keywords),
        docs,
        lined,
    )
}

fn tp_claimed(gap: string) -> string { "// LICENSED style.x: a reason\nfn f() -> int { g(1,${gap} 2) }\n\nfn h() -> int {\n    3\n}\n" }

fn tp_raw(note: string) -> string { "fn f() -> int {\n    let q = sql { // ${note}\n    }\n    1\n}\n" }

spec "compiler/token-place — a shape is what a file says" {
    given "two texts that differ only in plain comments and blank lines" {
        then "they have one shape" {
            tp_shape(tp_text(), []) == tp_shape(tp_shifted(), [])
        }
        then "an edit inside a token moves it" {
            tp_shape(tp_text(), []) != tp_shape(tp_body_edited(), [])
        }
    }
    given "a doc comment" {
        then "its words are part of the shape once something reads them" {
            tp_shaped("/// one\n${tp_text()}", [], true) != tp_shaped("/// two\n${tp_text()}", [], true)
        }
        then "its words leave the shape while nothing reads them" {
            tp_shape("/// one\n${tp_text()}", []) == tp_shape("/// two\n${tp_text()}", [])
        }
        then "a doc line added moves the shape, read or not" {
            tp_shape("/// one\n${tp_text()}", []) != tp_shape("/// one\n/// two\n${tp_text()}", [])
        }
    }
    given "a license claim" {
        then "adding one moves the shape" {
            tp_shape(tp_text(), []) != tp_shape("// LICENSED style.x: a reason\n${tp_text()}", [])
        }
        then "a line break between it and the token below moves the shape" {
            tp_shape("// LICENSED style.x: a reason\n${tp_text()}", []) != tp_shape("// LICENSED style.x: a reason\n\n${tp_text()}", [])
        }
        then "a break inside the line it licenses moves the shape" {
            tp_shape(tp_claimed(""), []) != tp_shape(tp_claimed("\n"), [])
        }
        then "a blank line below that line moves nothing" {
            tp_shape(tp_claimed(""), []) == tp_shape(tp_claimed("").replace("\n\nfn h", "\n\n\nfn h"), [])
        }
    }
    given "a lined shape" {
        then "a blank line above a fn moves it" {
            tp_lined(tp_text(), [], false, true) != tp_lined("\n${tp_text()}", [], false, true)
        }
        then "a comment's words within its line do not" {
            tp_lined("// a\n${tp_text()}", [], false, true) == tp_lined("// bb\n${tp_text()}", [], false, true)
        }
    }
    given "a raw block's body" {
        then "under its word, a `//` there is the block's text and moves the shape" {
            tp_shape(tp_raw("a"), ["sql"]) != tp_shape(tp_raw("b"), ["sql"])
        }
        then "read without the word, it is a comment and moves nothing" {
            tp_shape(tp_raw("a"), []) == tp_shape(tp_raw("b"), [])
        }
    }
}
