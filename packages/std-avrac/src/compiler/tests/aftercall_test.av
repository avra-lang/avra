//! The test after a call that may reach a cancel point: one read of the
//! running task's unwind bit, emitted where the cancel fact says a call
//! may reach and nowhere else; set, the fn runs its deferred calls and
//! leaves.
use @std.io.{make_dirs}
use @std.time.{now_ns}
use @std.avrac.testing.{ir_of}
use compiler.backend.{emit_ll, render_ir}

/// The IR text of a program.
fn ir(lines: List<string>) -> string { render_ir(ir_of(lines.concat([""]).join("\n"))) }

/// One directory per run, so no earlier run's module answers for this one.
once fn emit_base() -> string { "/tmp/avra-aftercall-test/${now_ns()}" }

/// How many times `word` stands in `text`.
fn times(text: string, word: string) -> int { text.split(word).length - 1 }

fn tests(lines: List<string>) -> int { times(ir(lines), "flag unwinding") }

fn napping() -> List<string> {
    ["extern fn avra_fiber_sleep(ms: int)", "fn nap() { avra_fiber_sleep(1) }"]
}

spec "compiler/lower — the test after a call" {
    then "a row that waits, a fn calling it, and the entry calling that fn are each tested once" {
        tests(napping().concat(["fn later() { nap() }", "later()"])) == 3
    }
    then "calls that reach no cancel point carry no test" {
        tests(["fn one() -> int { 1 }", "fn two() -> int { one() + one() }", "two()"]) == 0
    }
    then "a compiler unit's call is tested — no `wanted` name to judge it by" {
        // a module state's cell is built by a unit never named through
        // `wanted`, so the conservative answer MUST be `may reach`:
        // an omission here would let a caller read a hollow
        tests(["state counter: int = 0", "counter"]) >= 1
    }
    then "a task's cold exit answers an EMPTY cell, never a null a joiner reads" {
        // the spawn body calls a may-reach fn, so its task lambda carries
        // a test and its cold exit: that exit must box an empty answer,
        // not a null the join would read as a value
        let text = ir(
            napping()
                .concat(["fn work() -> int { nap() 7 }", "let t = spawn { work() }", "t.await"]),
        )
        times(text, "call avra_array_new(") >= 1
    }
    then "a call through a value is tested, and so is a call to the fn that makes it" {
        tests(["fn call(f: fn() -> int) -> int { f() }", "call(() -> 1)"]) == 2
    }
    then "the unwind arm runs the open `defer`, then leaves" {
        let text = ir(
            napping()
                .concat(
                    [
                        "fn tidy() { }",
                        "fn work() -> int {",
                        "    defer { tidy() }",
                        "    nap()",
                        "    7",
                        "}",
                        "work()",
                    ],
                ),
        )
        // the deferred closure runs at the scope's close and again in the arm
        times(text, "= callptr ") == 2 && times(text, "return r") >= 1
    }
    then "the call that runs a `defer` carries no test; the deferred closure's own call is its own" {
        // nap's row call, the closure's call to nap, and the entry's call to work
        tests(
            napping().concat(["fn work() -> int {", "    defer { nap() }", "    7", "}", "work()"]),
        ) == 3
    }
    then "the entry's unwind arm answers C's `int`, and its LLVM verifies" {
        // a `while` spins, so the entry's call to `work` carries the test;
        // the entry `avra_main` is declared `i32 ()`, so a hollow of nothing
        // must narrow — the wasm size guard builds this shape
        let _ = make_dirs(emit_base())
        emit_ll(ir_of(croak_program().concat([""]).join("\n")), "${emit_base()}/entry.ll", "") == null
    }
}

/// A program whose entry calls a fn that spins (a `while`).
fn croak_program() -> List<string> {
    [
        "fn spinner() -> int {",
        "    mut i = 0",
        "    while i < 3 { i = i + 1 }",
        "    i",
        "}",
        "fn work() -> int { spinner() }",
        "work()",
    ]
}
