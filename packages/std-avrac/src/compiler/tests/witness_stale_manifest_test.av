// A manifest edge whose package the workspace no longer holds. Its own file: the case it
// guards was a trap, which ends the whole test binary, so it shares one with nothing.
use @std.avrac.compiler.{avra, new_workspace}
use compiler.host.{memory_host}

spec "compiler/witness — a stale manifest edge" {
    then "a package root the workspace does not hold answers unresolved, and does not trap" {
        let path = fresh_pack_path("stale_manifest")
        let first = a_process(package_files(), path)
        let _ = checked(first, "/w/src/a.av")
        let names = edge_names_of(first, path, "/w/src/a.av", "Manifest")
        let files: Map<string, string> = {"/other/src/a.av": "export fn f() -> int {\n    1\n}\n"}
        let elsewhere = new_workspace(memory_host(files, ["/other/src/a.av"]), "/other", avra())
        !names.is_empty() && names.all((n: string) -> elsewhere.edge_current_hash(n) == null)
    }
}
