// A manifest edge whose package ordinal no longer exists. Its own file: the case it
// guards is a trap, which ends the whole test binary, so it shares one with nothing.
use query.{Key}

spec "compiler/witness — a stale manifest edge" {
    then "an ordinal past the packages answers unresolved, and does not trap" {
        let ws = a_process(package_files(), fresh_pack_path("stale_manifest"))
        ws.edge_current_hash(ws.decls.stable_key_name(Key { family: manifest_ordinal(), arg: 7 })) == null
    }
}
