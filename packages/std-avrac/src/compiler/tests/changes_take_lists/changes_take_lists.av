// proves: a box is logged when a slot of it is written in place, alike in both engines — a list's slot write files its key, a push and a pop file nothing
extern fn avra_box_observe(box: List<int>) -> int
extern fn avra_box_unobserve(box: List<int>) -> int
extern fn avra_box_key(box: List<int>) -> int
extern fn avra_turn_next() -> int
extern fn avra_changes_take() -> List<int>
extern fn avra_array_push(arr: List<int>, v: int)
extern fn avra_array_pop(arr: List<int>) -> int
extern fn avra_slot_set(arr: List<int>, at: int, v: int)

fn taken() -> List<int> {
    avra_changes_take()
}

fn only(keys: List<int>, k: int) -> bool {
    keys.length == 1 && keys[0] == k
}

fn pair_of(keys: List<int>, first: int, second: int) -> bool {
    keys.length == 2 && keys[0] == first && keys[1] == second
}

fn turn() -> List<int> {
    let _ = avra_turn_next()
    taken()
}

let seed = avra_turn_next() + 1
let xs = [seed, seed + 1]
let _ = avra_box_observe(xs)
avra_array_push(xs, 3)
println("a push files nothing ${taken().length}")
let _ = avra_turn_next()
avra_slot_set(xs, 0, 7)
println("a slot write ${only(taken(), avra_box_key(xs))}")
let _ = avra_turn_next()
let _ = avra_array_pop(xs)
println("a pop files nothing ${taken().length}")
let _ = avra_turn_next()
println("a read files nothing ${xs.length} ${taken().length}")
