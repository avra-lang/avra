// The hand-off's seam attacked: the stage word out of place, worn
// twice, a plan with no name, and the words a person's line could
// carry after it.
use @std.avrac.compiler.{stage_words, staged_plans}

fn plans_of(words: List<string>) -> string {
    (staged_plans(words) ?? ["<none>"]).join(",")
}

spec "the hand-off's seam" {
    given "the stage word out of place" {
        then "second in a line it is a command's argument" {
            plans_of(["test", "@stage"]) == "<none>"
        }
        then "with a trailing space it is no hand-off" {
            plans_of(["@stage ", "a.link"]) == "<none>"
        }
        then "in another case it is no hand-off" {
            plans_of(["@Stage", "a.link"]) == "<none>"
        }
    }
    given "degenerate plans" {
        then "one plan is one plan" {
            plans_of(stage_words(["a.link"])) == "a.link"
        }
        then "the stage word worn twice names a plan by that word" {
            plans_of(["@stage", "@stage"]) == "@stage"
        }
        then "an empty plan name is a plan, for the reader to refuse" {
            (staged_plans(["@stage", ""]) ?? []).length == 1
        }
        then "a help flag after the word is a plan, never the app's help" {
            plans_of(["@stage", "--help"]) == "--help"
        }
    }
}
