// proves: a map owns its values: an overwrite and a remove release one,
// `values` shares them
type Entry = { vals: List<int> }

fn shown() -> string {
    mut m: Map<string, Entry> = {}
    for i in 0..300 {
        m.set("k${i % 7}", Entry { vals: [i, i] })
    }
    let held = m.get("k3")!
    m.set("k3", Entry { vals: [] })
    let vs = m.values()
    m.remove("k1")
    m.remove("k2")
    mut t = 0
    for v in vs { t = t + v.vals.length }
    "${held.vals[0]} ${t} ${m.length} ${m.keys().join(",")} ${vs[1].vals[0]}"
}

shown()
