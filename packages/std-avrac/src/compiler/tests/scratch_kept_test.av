// A TEMPLATE'S PARSE IS KEPT UNDER THE LANGUAGE THAT MADE IT AND ITS TEXT: a language that cannot read a
// template is never handed the parse another language kept for the same text.
use compiler.{avra, assemble, scratch, Language}
use features.stmt_spine.{stmt_spine}
use features.let_stmt.{let_stmt}
use features.expr_spine.{expr_spine}
use features.type_expr.{type_expr}

/// A language with no `quote`, so no template parses under it.
fn partial() -> Language { assemble([stmt_spine(), let_stmt(), expr_spine(), type_expr()]) }

spec "sugars — a template's parse is kept by language and text" {
    given "a template the whole language reads and a partial language, with no `quote`, cannot" {
        then "the partial language reads no template, asked first" {
            scratch(partial(), "quote { 2 }") == null
        }
        then "the whole language reads it" {
            scratch(avra(), "quote { 1 }") != null
        }
        then "the whole language's kept parse is never the partial language's" {
            scratch(partial(), "quote { 1 }") == null
        }
    }
}
