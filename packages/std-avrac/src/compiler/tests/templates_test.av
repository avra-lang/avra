// A sugar's template reads each hole once, in the order its rule captures them.
use compiler.{misread}

spec "compiler/tests — a template is judged by the order it reads its holes" {
    given "a rule capturing `left` then `right`" {
        then "reading each once, in order, is no refusal" {
            misread("Pipe", [0, 1], ["left", "right"]) == null
        }
        then "reading `left` twice names the hole" {
            misread("Pipe", [0, 1, 0], ["left", "right"]) == "the template of `Pipe` reads `left` twice — a hole evaluates its node each time, so bind it once with a `let`"
        }
        then "reading `right` before `left` names both" {
            misread("Pipe", [1, 0], ["left", "right"]) == "the template of `Pipe` reads `right` before `left`, against the order the rule captures them — bind them in source order with a `let`"
        }
    }
}
