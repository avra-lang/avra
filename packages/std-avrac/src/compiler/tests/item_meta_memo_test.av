// A declaration's `Type`, held for the process (`meta_of_decl`, a `@memo`): an edit a later engine
// of the same process sees reaches it through the reads that found it, so a field whose type moved
// is read as it now stands, and a declaration nothing moved is read as it stood.
use compiler.{avra_fact_definitions, avra_source_world, meta_of_decl}
use compiler.tests.support.{file_at, files, list_with_prelude, read_with_prelude, store_dir}
use @std.program.disk_store.{disk_store_at}
use @std.program.query_engine.{query_engine}
use @std.program.source_facts.{use_source_world}

/// The type of the first field `name` declares in `src/main.av`, as one engine over the store at
/// `dir` lifts it; "-" for none.
fn field_type(dir: string, name: string) -> string {
    use_source_world(avra_source_world(read_with_prelude, list_with_prelude, "avra-test"))
    let store = disk_store_at(dir)
    let engine = query_engine(store, avra_fact_definitions())
    let t = meta_of_decl(engine, file_at("src/main.av"), name)
    let _ = store.saved()
    t?.fields?.first()?.ty ?? "-"
}

spec "compiler/meta_of_decl — a declaration's Type, held for the process" {
    given "a record lifted, then its field's type edited, in one process" {
        then "the next engine reads the field as it now stands" {
            let dir = store_dir("memo_field_moved")
            files().set({"src/main.av": "type P = { x: int }\n\ntype Q = { y: bool }\n"})
            let before = field_type(dir, "P")
            files().put("src/main.av", "type P = { x: string }\n\ntype Q = { y: bool }\n")
            let after = field_type(dir, "P")
            before == "int" && after == "string"
        }
        then "a declaration nothing moved is read as it stood" {
            let dir = store_dir("memo_field_stood")
            files().set({"src/main.av": "type P = { x: int }\n\ntype Q = { y: bool }\n"})
            let before = field_type(dir, "Q")
            files().put("src/main.av", "type P = { x: string }\n\ntype Q = { y: bool }\n")
            let after = field_type(dir, "Q")
            before == "bool" && after == "bool"
        }
    }
}
