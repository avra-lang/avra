// proves: a list literal that spreads a list keeps every slot it spread once
// that list is gone — a fn's answer, a literal, a holder's list — over enum
// payloads and records alike, with more elements after the spread
enum Word {
    Text(s: string)
    Num(n: int)
}

type Pair = { key: string, value: Word }

fn said(w: Word) -> string {
    match w { .Text(s) -> s, .Num(n) -> "${n}" }
}

fn head(on: bool) -> List<Word> {
    if !on { return [] }
    [Word.Text("in")]
}

fn answered() -> List<Word> { [..head(true), Word.Text("path"), Word.Num(2)] }

fn literal() -> List<Word> { [..[Word.Text("lit")], Word.Text("after")] }

fn held() -> List<Pair> {
    let kept = [Pair { key: "a", value: Word.Text("one") }]
    [..kept, Pair { key: "b", value: Word.Num(2) }]
}

fn none() -> List<Word> { [..head(false), Word.Text("only")] }

fn shown() -> string {
    let a = answered()
    let b = literal()
    let c = held()
    let d = none()
    "${a.map(said(it)).join(",")} ${b.map(said(it)).join(",")} ${c.map("${it.key}=${said(it.value)}").join(",")} ${d.map(said(it)).join(",")}"
}

shown()
