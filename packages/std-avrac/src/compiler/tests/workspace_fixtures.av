// Fixtures shared by the tests that stand a workspace over memory files: one
// process's own workspace with every file admitted, a file checked in it, and the
// family ordinals a test builds a `Key` from.
use @std.avrac.testing.{test_workspace}
use compiler.{Workspace, rule_findings, analysed}
use compiler.host.{memory_host}
use compiler.families.{Family}
use core.{DeclId}

/// A family's ordinal, found by its name: ordinals move when a family is added or
/// converted, names do not.
fn family_ordinal(name: string) -> int { [f.ordinal for f in Family.all() if f.name == name][0] }

fn namespace_ordinal() -> int { family_ordinal("Namespace") }

fn sig_ordinal() -> int { family_ordinal("Sig") }

fn methods_ordinal() -> int { family_ordinal("Methods") }

/// `a` declares `f`; `b` calls it; `c` lives in a module of its own and names neither.
fn package_files() -> Map<string, string> {
    {
        "/w/src/a.av": "export fn f() -> int {\n    1\n}\n",
        "/w/src/b.av": "export fn g() -> int {\n    f() + 1\n}\n",
        "/w/src/other/c.av": "export fn h() -> int {\n    2\n}\n",
    }
}

fn package_names() -> List<string> { ["/w/src/a.av", "/w/src/b.av", "/w/src/other/c.av"] }

/// One process's own workspace over the given files, each admitted up front, so a
/// cross-file signature always finds its callee's declaration minted.
fn a_process_over(files: Map<string, string>, names: List<string>) -> Workspace {
    let ws = test_workspace(memory_host(files, names), "/w")
    for path in names { let _ = ws.items(ws.file_id(path)) }
    ws
}

/// A file checked in `ws` as `avra check` checks it — its analysis and its rule
/// findings — answering whether it is clean.
fn checked(ws: Workspace, path: string) -> bool {
    let a = ws.analysis(ws.file_id(path))
    let _ = rule_findings(analysed(a), a.view.stmts)
    a.clean()
}

/// The declaration named `name` that `file` declares.
fn decl_in_file(ws: Workspace, file: string, name: string) -> DeclId {
    [d.id for d in ws.decls.all_decls() if d.name == name && ws.decls.file(d.file).path == file][0]
}
