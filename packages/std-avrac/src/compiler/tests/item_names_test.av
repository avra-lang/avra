// A module's names off its items' tapes: what each file declares, read with no file's tapes put
// together whole, what a body edit leaves standing, and what a signature edit moves.
use compiler.{
    Declarations,
    DeclaredName,
    ItemKind,
    avra_fact_definitions,
    avra_source_world,
    module_declares,
}
use @std.program.disk_store.{disk_store_at}
use @std.program.query_engine.{QueryEngine, query_engine}
use @std.program.source_facts.{use_source_world}
use compiler.tests.support.{files, list_held, read_held, store_dir}

const LIB: string = "/// Adds.\nexport fn add(a: int, b: int) -> int { a + b }\n\ntype P = { x: int }\n\nexport const LIMIT: int = 3\n"

const SIBLING: string = "export enum Mood {\n    Calm\n    Loud\n}\n\nfn twice(x: int) -> int { add(x, x) }\n"

/// One process naming the module `lib`: its names, each one part, and the queries it ran.
type Named = { names: Map<string, List<DeclaredName>>, asked: List<string> }

fn named(dir: string) -> Named {
    use_source_world(avra_source_world(read_held, list_held, "avra-test"))
    let store = disk_store_at(dir)
    let engine = query_engine(store, avra_fact_definitions())
    mut names: Map<string, List<DeclaredName>> = {}
    for part in module_declares(engine, "@test/p", ["lib"], true).parts {
        let ds = Declarations.from_saved_bytes(part.value).names
        names.set(ds[0].name, ds)
    }
    let _ = store.saved()
    Named { names: names, asked: engine.computed_queries() }
}

/// The face the module gives `name`'s one declaration.
fn face_of(n: Named, name: string) -> string { "${n.names.get(name)?.first()?.face?.high_word ?? 0}" }

spec "a module's names, off its items' tapes" {
    given "a module of two files" {
        then "each declaration stands under its name, with what it declares and whether it's exported" {
            files().set({"src/lib/a.av": LIB, "src/lib/b.av": SIBLING})
            let names = named(store_dir("names")).names
            names.keys().length == 5 &&
                names.get("add")!.first()!.kind == ItemKind.Fn &&
                names.get("add")!.first()!.exported &&
                names.get("P")!.first()!.kind == ItemKind.Record &&
                !names.get("P")!.first()!.exported &&
                names.get("LIMIT")!.first()!.kind == ItemKind.Const &&
                names.get("Mood")!.first()!.kind == ItemKind.Enum &&
                names.get("twice")!.first()!.file.path_in_package == "src/lib/b.av"
        }
    }
    given "a module's names asked alone" {
        then "no file's tapes are put together whole for what it means" {
            files().set({"src/lib/a.av": LIB, "src/lib/b.av": SIBLING})
            let asked = named(store_dir("headers")).asked
            asked.contains("file_declares") &&
                !asked.contains("file_meant") &&
                !asked.contains("file_tapes")
        }
    }
    given "a fn's body edited" {
        then "its face stands, so the module's names are not made again" {
            let dir = store_dir("body_edit")
            files().set({"src/lib/a.av": LIB, "src/lib/b.av": SIBLING})
            let before = named(dir)
            files().put("src/lib/b.av", SIBLING.replace("add(x, x)", "add(x, x) + 1"))
            let after = named(dir)
            face_of(before, "twice") == face_of(after, "twice") &&
                after.asked.contains("file_declares") &&
                !after.asked.contains("module_declares")
        }
    }
    given "a fn's signature edited" {
        then "its face moves, and the module's names are made again" {
            let dir = store_dir("signature_edit")
            files().set({"src/lib/a.av": LIB, "src/lib/b.av": SIBLING})
            let before = named(dir)
            files()
                .put(
                    "src/lib/b.av",
                    SIBLING.replace("fn twice(x: int) -> int", "fn twice(x: int) -> string"),
                )
            let after = named(dir)
            face_of(before, "twice") != face_of(after, "twice") &&
                after.asked.contains("module_declares")
        }
    }
}
