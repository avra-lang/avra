// proves: a bare `quote` widens into `Fix.Rewrite` the same way
// under an ORDINARY fn as under a `rule` component instance's `run`
// field — the declared answer plants the want before the match's
// arms walk (fns/check.av's `checked_fn`), the same channel every
// arms-sugar body takes (features/closures's `build_trailing_arms`)
// — so the lift needs no `rule` at all, only a `fn(Code) -> Fix?`
// shape.
use @std.avrac.features.{Code, Fix}
use @std.avrac.compiler.{analyze_source}

fn widen_add(e: Code) -> Fix? {
    match e {
        quote { ${x} + 1 } -> quote { ${x} },
        _ -> null,
    }
}

let a = analyze_source("a + 1")
match a.view.stmts.first() {
    s? -> match a.view.store.answer_of(s) {
        e? -> match widen_add(a.code_at(.Expr(e))) {
            r? -> r.rendered() ?? "no text"
            null -> "miss"
        }
        null -> "no answer"
    }
    null -> "no stmt"
}
