// avra-8sb5.57.106: `Visible`/`Resolved`/`Typed`/`Folded`/`Analysis`/
// `Lowered` settle on a CONTENT fingerprint now (voices.av's
// the derived folds of `Namespace`, `NameFacts`, `TypeFacts` and `Voices`), never
// `self.db.revision()` — a build-wide counter that read every edit
// anywhere as "changed" through them. These pin each fold directly,
// at the VALUE level: a fold covers a field when two values
// differing ONLY in that field fingerprint differently, and it wins
// (never churns) when two values built the same way fingerprint
// alike. The kernel's own cutoff (`prior.value_hash == value_hash` in
// the kernel's `settle`) is exactly this equality, so a field
// left out of a fold is exactly a field whose edit would be missed.
use core.{TypeId, ExprId, StmtId, DeclId, indexed_ids}
use features.{Namespace, no_names, new_name_facts, new_type_facts, NameFacts, TypeFacts}
use @std.relation.stable.{indexed_scope}
use diagnostics.{Diag, Voices, refusal}

fn tid(n: int) -> TypeId { TypeId { index: n } }
fn eid(n: int) -> ExprId { ExprId { index: n } }
fn sid(n: int) -> StmtId { StmtId { index: n } }
fn did(n: int) -> DeclId { DeclId { index: n } }

fn named(n: string, d: DeclId) -> Namespace {
    mut fns: Map<string, DeclId> = {}
    fns.set(n, d)
    no_names() with { fns: fns, fn_names: [n] }
}

fn one_diag(kind: string, msg: string) -> Diag {
    // LICENSED compiler.helpless_refusal: a fixture voice — the test fingerprints a diagnostic, it advises on nothing
    refusal(kind, null, msg, "here", null)
}

fn voices_of(ds: List<Diag>) -> Voices {
    Voices { list: ds }
}

spec "compiler/voices — the six families' content fingerprints" {
    given "a namespace's fold, over a namespace's bound names" {
        then "two namespaces built the same way fingerprint alike" {
            named("foo", did(1)).fingerprint_in(indexed_ids()) == named("foo", did(1)).fingerprint_in(indexed_ids())
        }
        then "a different bound name's identity moves the fingerprint" {
            named("foo", did(1)).fingerprint_in(indexed_ids()) != named("foo", did(2)).fingerprint_in(indexed_ids())
        }
        then "a different bound name's spelling moves the fingerprint" {
            named("foo", did(1)).fingerprint_in(indexed_ids()) != named("bar", did(1)).fingerprint_in(indexed_ids())
        }
        then "a namespace's own voices move the fingerprint" {
            let plain = no_names()
            let voiced = no_names() with { voices: voices_of([one_diag("x.y", "boom")]) }
            plain.fingerprint_in(indexed_ids()) != voiced.fingerprint_in(indexed_ids())
        }
    }

    given "a voices fold, over a diagnostic list" {
        then "the same diagnostics fingerprint alike" {
            Voices.digest_in(indexed_scope(), voices_of([one_diag("x.y", "boom")])) == Voices.digest_in(indexed_scope(), voices_of([one_diag("x.y", "boom")]))
        }
        then "a different message moves the fingerprint" {
            Voices.digest_in(indexed_scope(), voices_of([one_diag("x.y", "boom")])) != Voices.digest_in(indexed_scope(), voices_of([one_diag("x.y", "bang")]))
        }
        then "a different kind moves the fingerprint" {
            Voices.digest_in(indexed_scope(), voices_of([one_diag("x.y", "boom")])) != Voices.digest_in(indexed_scope(), voices_of([one_diag("x.z", "boom")]))
        }
        then "an empty list is its own value" {
            Voices.digest_in(indexed_scope(), voices_of([])) != Voices.digest_in(indexed_scope(), voices_of([one_diag("x.y", "boom")]))
        }
    }

    given "a names fold, over a file's resolved names" {
        then "the SAME binding at the SAME expression fingerprints alike" {
            let a = new_name_facts(2, no_names())
            let b = new_name_facts(2, no_names())
            NameFacts.digest_in(indexed_scope(), a) == NameFacts.digest_in(indexed_scope(), b)
        }
        then "a mut-seat read mark moves the fingerprint" {
            let a = new_name_facts(2, no_names())
            let b = new_name_facts(2, no_names())
            b.mark_mut_read(eid(0))
            NameFacts.digest_in(indexed_scope(), a) != NameFacts.digest_in(indexed_scope(), b)
        }
        then "the namespace it resolved against moves the fingerprint" {
            let a = new_name_facts(1, no_names())
            let b = new_name_facts(1, named("foo", did(1)))
            NameFacts.digest_in(indexed_scope(), a) != NameFacts.digest_in(indexed_scope(), b)
        }
    }

    given "a typing fold, over one declaration's typing facts" {
        then "the SAME table fingerprints alike" {
            let a = new_type_facts(0, 2, 0 - 1, 0, 1, tid(0))
            let b = new_type_facts(0, 2, 0 - 1, 0, 1, tid(0))
            TypeFacts.digest_in(indexed_scope(), a) == TypeFacts.digest_in(indexed_scope(), b)
        }
        then "an expression's settled type moves the fingerprint" {
            let a = new_type_facts(0, 2, 0 - 1, 0, 1, tid(0))
            let b = new_type_facts(0, 2, 0 - 1, 0, 1, tid(0))
            b.set_type(eid(0), tid(9))
            TypeFacts.digest_in(indexed_scope(), a) != TypeFacts.digest_in(indexed_scope(), b)
        }
        then "a widened expression moves the fingerprint though its own type does not" {
            let a = new_type_facts(0, 2, 0 - 1, 0, 1, tid(0))
            let b = new_type_facts(0, 2, 0 - 1, 0, 1, tid(0))
            b.widen(eid(0), tid(9))
            TypeFacts.digest_in(indexed_scope(), a) != TypeFacts.digest_in(indexed_scope(), b)
        }
        then "the boxed_locals column (a WHOLE-FILE window, stmt-indexed) moves the fingerprint" {
            let a = new_type_facts(0, 2, 0 - 1, 0, 3, tid(0))
            let b = new_type_facts(0, 2, 0 - 1, 0, 3, tid(0))
            b.mark_boxed_local(sid(0))
            TypeFacts.digest_in(indexed_scope(), a) != TypeFacts.digest_in(indexed_scope(), b)
        }
        then "the table's own voices move the fingerprint though every column is untouched" {
            let a = new_type_facts(0, 1, 0 - 1, 0, 1, tid(0))
            let b = a with { voices: voices_of([one_diag("x.y", "boom")]) }
            TypeFacts.digest_in(indexed_scope(), a) != TypeFacts.digest_in(indexed_scope(), b)
        }
    }
}
