// The manifest read into facts, and every rule of the manifest spec
// speaking in its own words — errors that refuse, warnings that do
// not.
use @std.avrac.diagnostics.{new_source_file, render}

use features.{budgets_of}
use compiler.host.{Manifest, deps_offset, read_manifest}

fn reference() -> string {
    "[package]\nname    = \"@acme/app\"\nversion = \"0.1.0\"\n\n[bin]\npath = \"src/main.av\"\n\n[lib]\n\n[dependencies]\n\"@std/http\" = { path = \"../http\" }\n\"@std/toml\" = { path = \"../toml\" }\n\n[dev-dependencies]\n\"@std/test\" = { path = \"../test\" }\n\n[profile.dev]\nopt_level = 0\ndebug = true\n"
}

fn read(text: string) -> Manifest {
    read_manifest(new_source_file("avra.toml", text))
}

/// A manifest whose [package] carries these lines.
fn packaged(rest: string) -> string {
    "[package]\nname = \"app\"\nversion = \"0.1.0\"\n${rest}"
}

/// ONE voice of this kind.
fn speaks(text: string, kind: string) -> bool {
    let m = read(text)
    m.voices.length == 1 && m.voices[0].kind == kind
}

fn tooled(rest: string) -> string {
    packaged(
        "\n[process.tools]\ngit = { from = \"path\", terminator = \"--end-of-options\" }\nfind = { terminator = false }\n\n[process.tools.clang]\nfrom = \"env\"\nvar = \"CC\"\ndefault = \"clang\"\n${rest}",
    )
}

spec "compiler/manifest" {
    given "[process.tools]" {
        then "tools are read in both spellings, with their provenance and their terminator" {
            let m = read(tooled(""))
            m.voices.length == 0 &&
                m.tools.length == 3 &&
                m.tools[0].name == "git" &&
                m.tools[0].terminator == "--end-of-options" &&
                m.tools[1].terminator == null &&
                m.tools[2].name == "clang" &&
                m.tools[2].from is .Env &&
                m.tools[2].var == "CC" &&
                m.tools[2].default == "clang"
        }
        then "a tool not saying where it comes from comes from the PATH, ending its options at `--`" {
            let m = read(tooled(""))
            m.tools[1].from is .Path && m.tools[0].from is .Path && m.tools[2].terminator == "--"
        }
        then "an unknown key under [process] REFUSES — a bound on what may run is never degraded" {
            let m = read(tooled("nope = 1\n"))
            m.voices.length == 1 &&
                m.voices[0].kind == "manifest.unknown_process_key" &&
                m.voices[0].severity is .Error
        }
        then "an unknown key inside a tool's own row refuses too" {
            speaks(
                packaged("\n[process.tools]\ngit = { colour = 1 }\n"),
                "manifest.unknown_process_key",
            )
        }
        then "a provenance that is not path, env or abs is refused" {
            speaks(
                packaged("\n[process.tools]\ngit = { from = \"magic\" }\n"),
                "manifest.bad_tool_from",
            )
        }
        then "an env tool names its variable; an abs tool names its file" {
            speaks(
                    packaged("\n[process.tools]\ncc = { from = \"env\" }\n"),
                    "manifest.tool_env_var",
                ) &&
                speaks(
                    packaged("\n[process.tools]\nld = { from = \"abs\" }\n"),
                    "manifest.tool_abs_at",
                )
        }
    }
    given "the reference manifest" {
        then "its facts are read" {
            let m = read(reference())
            m.name == "@acme/app" &&
                m.version == "0.1.0" &&
                m.bin == "src/main.av" &&
                m.lib == "src/lib.av" &&
                m.voices.is_empty()
        }
        then "its dependencies are keys with paths, tests' marked" {
            let m = read(reference())
            m.deps.length == 3 &&
                m.deps[0].key == "@std/http" &&
                m.deps[0].path == "../http" &&
                !m.deps[0].dev &&
                m.deps[2].dev
        }
        then "a new dependency line goes after the last one" {
            let m = read(reference())
            let at = deps_offset(m)!
            reference().substring(at - 3, at) == "\" }" &&
                deps_offset(read("[package]\nname = \"app\"\nversion = \"1.0.0\"\n")) == null
        }
        then "an undeclared target is absent, a bare one is its default" {
            read("[package]\nname = \"app\"\nversion = \"1.0.0\"\n").bin == null &&
                read(packaged("[bin]\n")).bin == "src/main.av"
        }
    }
    given "the rules refuse" {
        then "no [package]" { speaks("[bin]\npath = \"x.av\"\n", "manifest.no_package") }
        then "no name" { speaks("[package]\nversion = \"1.0.0\"\n", "manifest.no_name") }
        then "no version" { speaks("[package]\nname = \"app\"\n", "manifest.no_version") }
        then "a version that is not semver" { speaks("[package]\nname = \"app\"\nversion = \"1.2\"\n", "manifest.bad_version") }
        then "a pre-release suffix is semver" { read("[package]\nname = \"app\"\nversion = \"1.2.3-beta.1\"\n").voices.is_empty() }
        then "a name that is neither @scope/name nor a word" { speaks("[package]\nname = \"My App\"\nversion = \"1.0.0\"\n", "manifest.bad_name") }
        then "a dependency on itself" { speaks(packaged("[dependencies]\napp = { path = \".\" }\n"), "manifest.self_dependency") }
        then "an unscoped dependency" { speaks(
                packaged("[dependencies]\nhttp = { path = \"../http\" }\n"),
                "manifest.unscoped_dependency",
            ) }
        then "a registry or git dependency" {
            speaks(
                    packaged("[dependencies]\n\"@std/http\" = \"1.2\"\n"),
                    "manifest.unsupported_dependency",
                ) &&
                speaks(
                    packaged(
                        "[dependencies]\n\"@std/http\" = { git = \"https://x/y\", rev = \"abc\" }\n",
                    ),
                    "manifest.unsupported_dependency",
                )
        }
        then "an opt level outside the set" { speaks(packaged("[profile.release]\nopt_level = 7\n"), "manifest.bad_opt_level") }
        then "a profile name outside its charset" { speaks(packaged("[profile.Fast]\nopt_level = 2\n"), "manifest.bad_profile") }
        then "a line that is not TOML" { speaks(packaged("name\n"), "manifest.syntax") }
    }
    given "[link] is typed — a dependency cannot spell a clang option" {
        then "objects, search and libs read as words" {
            let m = read(
                packaged(
                    "[link]\nobjects = [\"a.o\"]\nsearch = [\"/opt/lib\"]\nlibs = [\"m\", \"pthread\"]\n",
                ),
            )
            m.objects.join(",") == "a.o" &&
                m.search.join(",") == "/opt/lib" &&
                m.libs.join(",") == "m,pthread"
        }
        then "a `-`-leading token in libs is refused — the row spells the NAME" {
            speaks(packaged("[link]\nlibs = [\"-lm\"]\n"), "manifest.link_option")
        }
        then "a `-`-leading token in search is refused" {
            speaks(packaged("[link]\nsearch = [\"-L/opt\"]\n"), "manifest.link_option")
        }
        then "a `-`-leading token in objects is refused" {
            speaks(packaged("[link]\nobjects = [\"-Wl,--wrap=malloc\"]\n"), "manifest.link_option")
        }
        then "`flags` is no longer a [link] key" {
            speaks(packaged("[link]\nflags = [\"-lm\"]\n"), "manifest.unknown_key")
        }
        then "[link.raw] reads its flags — the root's escape hatch" {
            read(packaged("[link.raw]\nflags = [\"-Wl,-dead_strip\"]\n")).raw.join(",") == "-Wl,-dead_strip"
        }
        then "[link.raw] is not refused at the manifest layer — only the workspace knows the root" {
            read(packaged("[link.raw]\nflags = [\"-Wl,-dead_strip\"]\n")).voices.is_empty()
        }
    }
    given "the unknown warns" {

        then "an unknown section is a warning that names it" {
            let m = read(packaged("[grants]\nnetwork = []\n"))
            m.voices.length == 1 &&
                m.voices[0].kind == "manifest.unknown_section" &&
                m.voices[0].severity is .Warning
        }
        then "an unknown key is a warning that names it" {
            let m = read("[package]\nname = \"app\"\nversion = \"1.0.0\"\ncolour = \"red\"\n")
            m.voices.length == 1 &&
                m.voices[0].kind == "manifest.unknown_key" &&
                m.voices[0].message.contains("`colour`")
        }
    }
    given "rendered" {
        then "a `[link]` row spelling an option renders with its code and remedy" {
            let text = "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[link]\nlibs = [\"-lm\"]\n"
            let m = read(text)
            render(m.voices[0], new_source_file("avra.toml", text))
                .starts_with(
                    "error[manifest.link_option]: `libs` takes library names, and `-lm` spells a linker option\n  ╭─[avra.toml:6:1]",
                )
        }
        then "a refusal points at its line in the manifest" {
            let text = "[package]\nname = \"app\"\nversion = \"1.2\"\n"
            let m = read(text)
            render(m.voices[0], new_source_file("avra.toml", text))
                .starts_with(
                    "error[manifest.bad_version]: a version is `MAJOR.MINOR.PATCH` — `1.2` is not\n  ╭─[avra.toml:3:1]",
                )
        }
    }
    given "[lifted]" {
        then "steps and memory are read, memory in MiB" {
            let m = read(packaged("\n[lifted]\nsteps = 500\nmemory = 2\n"))
            m.voices.length == 0 && m.budgets.steps == 500 && m.budgets.bytes == 2097152
        }
        then "an absent row takes the measured default" {
            let m = read(packaged("\n[lifted]\nsteps = 500\n"))
            m.budgets.steps == 500 && m.budgets.bytes == budgets_of().bytes
        }
        then "a row that is not a count of at least 1 is refused and reads as the default" {
            let m = read(packaged("\n[lifted]\nsteps = 0\nmemory = \"lots\"\n"))
            m.voices.length == 2 &&
                m.voices.all(it.kind == "manifest.bad_budget") &&
                m.budgets.steps == budgets_of().steps
        }
        then "a memory past what bytes can hold is no ceiling, never a wrapped one" {
            let m = read(packaged("\n[lifted]\nmemory = 9223372036854775807\n"))
            m.voices.length == 0 &&
                m.budgets.bytes > 0 &&
                m.budgets.bytes >= budgets_of(null, 8796093022207).bytes
        }
        then "the refusal names the row and its units" {
            let text = packaged("\n[lifted]\nmemory = 0\n")
            let m = read(text)
            render(m.voices[0], new_source_file("avra.toml", text))
                .contains("error[manifest.bad_budget]: `[lifted] memory` is a count of at least 1")
        }
    }
}
