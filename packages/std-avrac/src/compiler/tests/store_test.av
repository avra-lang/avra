// THE STORE'S CONTRACT, which is four claims and every one of them is load-bearing:
//
//   * PRESENCE IS O(1) AND NEEDS NOTHING READ — `has` is one `exists`, which is what
//     makes "has this changed?" cheap enough to ask about every node.
//   * A ROW IS PRESENT ONLY WHEN ITS EDGES ARE — the second write is the COMMIT, so a
//     crash between them reads as ABSENT rather than as half a value.
//   * `cached` COMPUTES A BODY ONCE — asked twice, it answers from the store, and the
//     second `make` is never called.
//   * A KEY NAMES CONTENT, and the family is folded first, so two families naming the
//     same parts stay apart.
use @std.avrac.compiler.{Store, store_at, node_key, Stored, Backing, mem_backing, disk_backing}
use @std.io.{make_dirs, write_text}

/// A store of one spec's own, so two specs cannot see each other's rows.
fn at(name: string) -> Store { store_at("/tmp/avra-store-test/${name}") }

spec "store" {
    given "a key names content, and the family separates" {
        then "the same parts under two families are two keys" {
            node_key(Stored.Sig, ["a", "b"]) != node_key(Stored.Unit, ["a", "b"])
        }
        then "the same parts under one family are one key" {
            node_key(Stored.Sig, ["a", "b"]) == node_key(Stored.Sig, ["a", "b"])
        }
        then "different parts are different keys" {
            node_key(Stored.Sig, ["a", "b"]) != node_key(Stored.Sig, ["a", "c"])
        }
    }

    given "a store that has seen nothing" {
        then "nothing is present" {
            !at("empty").has(Stored.Sig, node_key(Stored.Sig, ["x"]))
        }
        then "and nothing is handed back" {
            at("empty").get(Stored.Sig, node_key(Stored.Sig, ["x"])) == null
        }
    }

    given "a row that was remembered" {
        then "it is present, it answers its bytes, and its edges come back whole" {
            let s = at("kept")
            let k = node_key(Stored.Unit, ["body", "int"])
            let _ = s.keep(Stored.Unit, k, "the lowered body", ["edge-one", "edge-two"])
            let edges = s.deps(Stored.Unit, k)
            s.has(Stored.Unit, k) && s.get(Stored.Unit, k) == "the lowered body" && edges.length == 2 && edges[0] == "edge-one" && edges[1] == "edge-two"
        }
    }

    given "a row whose EDGES never arrived" {
        then "it reads as ABSENT, because the second write is the commit" {
            let s = at("uncommitted")
            let k = node_key(Stored.Obj, ["half"])
            // THE DATA IS REALLY THERE — directories made, bytes written — and only the
            // EDGES are missing. A fixture that failed to write would pass this for the
            // wrong reason, which is the fixture that cannot exhibit the defect.
            let shard = "/tmp/avra-store-test/uncommitted/obj/${k.substring(0, 2)}"
            let _ = make_dirs(shard)
            let _ = write_text("${shard}/${k}", "the data landed")
            !s.has(Stored.Obj, k) && s.get(Stored.Obj, k) == null
        }
    }

    given "a body that is expensive to compute" {
        then "it is computed ONCE, and the second ask never calls it" {
            let s = at("cached")
            let k = node_key(Stored.Unit, ["cached-body"])
            let first = s.cached(Stored.Unit, k, ["dep"], () -> "computed")
            let second = s.cached(Stored.Unit, k, ["dep"], () -> "WRONG, computed again")
            first == "computed" && second == "computed"
        }
    }

    given "a family holding rows" {
        then "the collector drops what is not live and keeps what is" {
            let s = at("swept")
            let live = node_key(Stored.Fp, ["live"])
            let dead = node_key(Stored.Fp, ["dead"])
            let _ = s.keep(Stored.Fp, live, "kept", [])
            let _ = s.keep(Stored.Fp, dead, "dropped", [])
            let dropped = s.sweep(Stored.Fp, [live])
            dropped == 1 && s.has(Stored.Fp, live) && !s.has(Stored.Fp, dead)
        }
    }

    given "the backing seam" {
        then "a memory backing holds a row and answers the same verbs" {
            let b: dyn Backing = mem_backing()
            let k = node_key(Stored.Unit, ["mem"])
            let _ = b.put(Stored.Unit, k, "in memory", ["dep"])
            b.name() == "mem" && b.has(Stored.Unit, k) && b.get(Stored.Unit, k) == "in memory"
        }
        then "the disk backing answers the same verbs" {
            let b: dyn Backing = disk_backing(at("backing"))
            let k = node_key(Stored.Sig, ["disk"])
            let _ = b.put(Stored.Sig, k, "on disk", [])
            b.name() == "disk" && b.get(Stored.Sig, k) == "on disk"
        }
    }
}
