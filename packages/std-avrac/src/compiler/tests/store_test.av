// THE STORE'S CONTRACT, which is three claims and every one of them is load-bearing:
//
//   * PRESENCE IS O(1) AND NEEDS NOTHING READ — `has` is one `exists`, which is what
//     makes "has this changed?" cheap enough to ask about every node.
//   * A ROW IS PRESENT ONLY WHEN ITS EDGES ARE — the second write is the COMMIT, so a
//     crash between them reads as ABSENT rather than as half a value.
//   * A KEY NAMES CONTENT, and the family is folded first, so two families naming the
//     same parts stay apart.

use @std.io.{make_dirs, write_text}
use @std.time.{stamp}
use @std.relation.engine.{map_cell}
use compiler.host.{Host, memory_host_at}
use compiler.record.{runtime_bodies}
use compiler.store.{
    Keeping,
    Producer,
    Producers,
    Reading,
    Store,
    Stored,
    node_key,
    producer_under,
    store_at,
    store_stamped,
    store_with,
}

/// One directory per run, so no earlier run's rows answer for this one.
once fn store_base() -> string { "/tmp/avra-store-test/${stamp()}" }

/// A host over a toolchain: the compiler at `compiler`, and a runtime archive of `body` at
/// each of `at`.
fn toolchain_host(compiler: string?, at: List<string>, body: string) -> Host {
    mut files: Map<string, string> = {}
    for p in at { files.set(p, body) }
    memory_host_at(files, at, "/") with { compiler: compiler }
}

/// A store of one spec's own, so two specs cannot see each other's rows.
fn at(name: string) -> Store { store_at("${store_base()}/${name}") }

spec "store" {
    given "a key names content, and the family separates" {
        then "the same parts under two families are two keys" {
            node_key(Stored.Sig, ["a", "b"]) != node_key(Stored.Unit, ["a", "b"])
        }
        then "the same parts under one family are one key" {
            node_key(Stored.Sig, ["a", "b"]) == node_key(Stored.Sig, ["a", "b"])
        }
        then "different parts are different keys" {
            node_key(Stored.Sig, ["a", "b"]) != node_key(Stored.Sig, ["a", "c"])
        }
    }
    given "a store that has seen nothing" {

        then "nothing is present" {
            !at("empty").has(Stored.Sig, node_key(Stored.Sig, ["x"]))
        }
        then "and nothing is handed back" {
            at("empty").get(Stored.Sig, node_key(Stored.Sig, ["x"])) == null
        }
    }
    given "a row that was remembered" {

        then "it is present and answers its bytes" {
            let s = at("kept")
            let k = node_key(Stored.Unit, ["body", "int"])
            let _ = s.keep(Stored.Unit, k, "the lowered body", ["edge-one", "edge-two"])
            s.has(Stored.Unit, k) && s.get(Stored.Unit, k) == "the lowered body"
        }
    }
    given "a row whose EDGES never arrived" {

        then "it reads as ABSENT, because the second write is the commit" {
            let s = at("uncommitted")
            let k = node_key(Stored.Obj, ["half"])
            // THE DATA IS REALLY THERE — directories made, bytes written — and only the
            // EDGES are missing. A fixture that failed to write would pass this for the
            // wrong reason, which is the fixture that cannot exhibit the defect.
            let shard = "${store_base()}/uncommitted/obj/${k.substring(0, 2)}"
            let _ = make_dirs(shard)
            let _ = write_text("${shard}/${k}", "the data landed")
            !s.has(Stored.Obj, k) && s.get(Stored.Obj, k) == null
        }
    }
    given "an answer kept with what it read" {

        then "it stands while every read still has its digest" {
            let s = at("valid")
            let k = node_key(Stored.Unit, ["valid"])
            let _ = s
                .keep_reading(
                    Stored.Unit,
                    k,
                    "answer",
                    [Reading { name: "a.av", digest: "d1" }, Reading { name: "b.av", digest: "d2" }],
                )
            s.get_valid(Stored.Unit, k, (n: string) -> if n == "a.av" { "d1" } else { "d2" }) == "answer"
        }
        then "ONE read whose digest moved makes it a miss, though the bytes are there" {
            let s = at("moved")
            let k = node_key(Stored.Unit, ["moved"])
            let _ = s
                .keep_reading(
                    Stored.Unit,
                    k,
                    "answer",
                    [Reading { name: "a.av", digest: "d1" }, Reading { name: "b.av", digest: "d2" }],
                )
            s.get(Stored.Unit, k) == "answer" &&
                s.get_valid(Stored.Unit, k, (n: string) -> if n == "a.av" { "d1" } else { "d3" }) == null
        }
        then "a read that cannot be read now is a miss" {
            let s = at("gone")
            let k = node_key(Stored.Unit, ["gone"])
            let _ = s
                .keep_reading(Stored.Unit, k, "answer", [Reading { name: "a.av", digest: "d1" }])
            s.get_valid(Stored.Unit, k, (n: string) -> null) == null
        }
        then "a name holding a space reads back whole" {
            let s = at("spaced")
            let k = node_key(Stored.Unit, ["spaced"])
            let _ = s
                .keep_reading(Stored.Unit, k, "answer", [Reading { name: "a b.av", digest: "d1" }])
            s.get_valid(Stored.Unit, k, (n: string) -> if n == "a b.av" { "d1" } else { null }) == "answer"
        }
        then "a read that cannot be spelled whole refuses the keep" {
            let s = at("unspelled")
            let k = node_key(Stored.Unit, ["unspelled"])
            !s.keep_reading(Stored.Unit, k, "answer", [Reading { name: "a.av", digest: "d 1" }]) &&
                !s.keep_reading(Stored.Unit, k, "answer", [Reading { name: "a\nb", digest: "d1" }]) &&
                !s.keep_reading(Stored.Unit, k, "answer", [Reading { name: "a.av", digest: "" }]) &&
                s.get(Stored.Unit, k) == null
        }
        then "a row kept with edges that are no pairs is a miss" {
            let s = at("plain")
            let k = node_key(Stored.Unit, ["plain"])
            let _ = s.keep(Stored.Unit, k, "answer", ["edge-one"])
            s.get_valid(Stored.Unit, k, (n: string) -> "d1") == null
        }
        then "a row that read nothing stands" {
            let s = at("nothing")
            let k = node_key(Stored.Unit, ["nothing"])
            let _ = s.keep_reading(Stored.Unit, k, "answer", [])
            s.get_valid(Stored.Unit, k, (n: string) -> null) == "answer"
        }
        then "a row never kept is a miss" {
            at("never")
                .get_valid(Stored.Unit, node_key(Stored.Unit, ["never"]), (n: string) -> "d1") == null
        }
        then "an aside store judges its reads alike" {
            let s = store_with("${store_base()}/aside", "", Keeping.Aside(map_cell()))
            let k = node_key(Stored.Unit, ["aside"])
            let _ = s
                .keep_reading(Stored.Unit, k, "answer", [Reading { name: "a.av", digest: "d1" }])
            s.get_valid(Stored.Unit, k, (n: string) -> "d1") == "answer" &&
                s.get_valid(Stored.Unit, k, (n: string) -> "d2") == null
        }
        then "a file family's edges are judged too" {
            let s = at("files")
            let k = node_key(Stored.Obj, ["files"])
            let _ = s.keep_file(Stored.Obj, k, "/dev/null", [])
            s.get_valid(Stored.Obj, k, (n: string) -> null) != null
        }
    }
    given "rows that read inputs" {
        then "the suspect set of a moved input is the rows that read it, ids only" {
            let s = at("suspects")
            let a = node_key(Stored.Unit, ["a"])
            let b = node_key(Stored.Unit, ["b"])
            let c = node_key(Stored.Unit, ["c"])
            let _ = s
                .keep_reading(
                    Stored.Unit,
                    a,
                    "1",
                    [
                        Reading { name: "a.av", digest: "d1" },
                        Reading { name: "shared.av", digest: "d9" },
                    ],
                )
            let _ = s
                .keep_reading(
                    Stored.Unit,
                    b,
                    "2",
                    [
                        Reading { name: "b.av", digest: "d2" },
                        Reading { name: "shared.av", digest: "d9" },
                    ],
                )
            let _ = s.keep_reading(Stored.Unit, c, "3", [Reading { name: "c.av", digest: "d3" }])
            s.suspects(["a.av"]).length == 1 &&
                s.suspects(["shared.av"]).length == 2 &&
                s.suspects(["a.av", "shared.av"]).length == 2 &&
                s.suspects([]).is_empty() &&
                s.suspects(["nothing.av"]).is_empty()
        }
        then "a moved input names exactly its readers, and no moved input names none" {
            let s = at("suspects-exact")
            let a = node_key(Stored.Unit, ["a"])
            let b = node_key(Stored.Unit, ["b"])
            let c = node_key(Stored.Unit, ["c"])
            let _ = s
                .keep_reading(
                    Stored.Unit,
                    a,
                    "1",
                    [Reading { name: "a.av", digest: "d1" }, Reading { name: "s.av", digest: "d9" }],
                )
            let _ = s.keep_reading(Stored.Unit, b, "2", [Reading { name: "s.av", digest: "d9" }])
            let _ = s.keep_reading(Stored.Unit, c, "3", [Reading { name: "c.av", digest: "d3" }])
            let readers = s.suspects(["s.av"])
            readers.length == 2 &&
                readers.any(it.ends_with("\n${a}")) &&
                readers.any(it.ends_with("\n${b}")) &&
                s.suspects(["c.av"]).length == 1 &&
                s.suspects(["c.av"])[0].ends_with("\n${c}") &&
                s.suspects([]).is_empty()
        }
        then "a write after the index was built is seen" {
            let s = at("suspects-later")
            let a = node_key(Stored.Unit, ["a"])
            let _ = s.keep_reading(Stored.Unit, a, "1", [Reading { name: "a.av", digest: "d1" }])
            let before = s.suspects(["z.av"]).length
            let _ = s
                .keep_reading(
                    Stored.Unit,
                    node_key(Stored.Unit, ["z"]),
                    "2",
                    [Reading { name: "z.av", digest: "d1" }],
                )
            before == 0 && s.suspects(["z.av"]).length == 1
        }
    }

    given "a producer's stamp" {
        then "it is the same for the same parts and toolchain" {
            producer_stamp(["p", "enc", "dec"], "tc") == producer_stamp(["p", "enc", "dec"], "tc")
        }
        then "the producing code's hash moves it" {
            producer_stamp(["p", "enc", "dec"], "tc") != producer_stamp(["q", "enc", "dec"], "tc")
        }
        then "the encode moves it" {
            producer_stamp(["p", "enc", "dec"], "tc") != producer_stamp(["p", "enx", "dec"], "tc")
        }
        then "the decode moves it" {
            producer_stamp(["p", "enc", "dec"], "tc") != producer_stamp(["p", "enc", "dex"], "tc")
        }
        then "the toolchain moves it" {
            producer_stamp(["p", "enc", "dec"], "tc") != producer_stamp(["p", "enc", "dec"], "td")
        }
        then "a part with no hash leaves no stamp" {
            stamp_of_parts(["p", null, "dec"]) == "absent"
        }
        then "the C a producer runs is a part, read from the archive a program links" {
            let beside = "/tc/build/libavra_runtime.a"
            runtime_bodies(toolchain_host("/tc/build/avra", [beside], "one")) != runtime_bodies(toolchain_host("/tc/build/avra", [beside], "two"))
        }
        then "and the same bytes are one digest, wherever the archive stands" {
            let checked_out = toolchain_host(
                "/tc/build/avra",
                ["/tc/build/libavra_runtime.a"],
                "one",
            )
            let installed = toolchain_host(
                "/tc/bin/avra",
                ["/tc/lib/avra/libavra_runtime.a"],
                "one",
            )
            runtime_bodies(checked_out) == runtime_bodies(installed)
        }
        then "a host that cannot read its C has no part, so its rows stay its own" {
            let unread = toolchain_host("/tc/build/avra", [], "one")
            let unnamed = toolchain_host(null, ["/tc/build/libavra_runtime.a"], "one")
            runtime_bodies(unread) == null && runtime_bodies(unnamed) == null
        }
    }
    given "rows filed by a store that shares a family" {
        then "a compiler of another print with the same producer reads them" {
            let root = "${store_base()}/shared"
            let first = shared_store(root, "print-a", Producer.Hashed("s1"))
            let k = node_key(Stored.Sig, ["m"])
            let _ = first.keep(Stored.Sig, k, "record", [])
            shared_store(root, "print-b", Producer.Hashed("s1")).get(Stored.Sig, k) == "record"
        }
        then "one whose producer differs never does" {
            let root = "${store_base()}/shared-moved"
            let k = node_key(Stored.Sig, ["m"])
            let _ = shared_store(root, "print-a", Producer.Hashed("s1"))
                .keep(Stored.Sig, k, "record", [])
            shared_store(root, "print-b", Producer.Hashed("s2")).get(Stored.Sig, k) == null
        }
        then "one that cannot hash its producer never does" {
            let root = "${store_base()}/shared-absent"
            let k = node_key(Stored.Sig, ["m"])
            let _ = shared_store(root, "print-a", Producer.Hashed("s1"))
                .keep(Stored.Sig, k, "record", [])
            shared_store(root, "print-b", Producer.Absent).get(Stored.Sig, k) == null
        }
        then "a family with no producer is read by its own print alone" {
            let root = "${store_base()}/own"
            let k = node_key(Stored.Unit, ["u"])
            let _ = shared_store(root, "print-a", Producer.Hashed("s1"))
                .keep(Stored.Unit, k, "unit", [])
            shared_store(root, "print-a", Producer.Hashed("s1")).get(Stored.Unit, k) == "unit" &&
                shared_store(root, "print-b", Producer.Hashed("s1")).get(Stored.Unit, k) == null
        }
    }
}

fn shared_store(root: string, print: string, sig: Producer) -> Store {
    store_stamped(root, print, Producers { sig: sig }, Keeping.Disk)
}

fn producer_stamp(parts: List<string?>, toolchain: string) -> string { stamp_text(producer_under(parts, toolchain)) }

fn stamp_of_parts(parts: List<string?>) -> string { stamp_text(producer_under(parts, "tc")) }

fn stamp_text(p: Producer) -> string { match p { .Hashed(s) -> s, .Absent -> "absent" } }
