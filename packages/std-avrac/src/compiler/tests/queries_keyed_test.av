//! THE QUERIES KEYED BY ONE KIND OF ID ARE THE DECLARATIONS' TO LIST: every `@query` declares
//! its row, so a reader lists every query keyed by a declaration, or by a file, without a hand
//! list that forgets the next one — and without asking any of them first.
use compiler.{queries_keyed_by, IdKind}

spec "compiler/queries keyed — every query is listed by its key seat, asked or not" {
    then "a query keyed by a declaration is listed under declarations, never under files" {
        queries_keyed_by(IdKind.Decl).contains("refs_to") &&
            !queries_keyed_by(IdKind.File).contains("refs_to")
    }
    then "a query keyed by a file is listed under files" { queries_keyed_by(IdKind.File).contains("refs_from") }
}
