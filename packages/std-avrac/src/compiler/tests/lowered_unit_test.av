// A UNIT'S LOWERING STANDS ON WHAT IT READ, and its code is named by durable name, so two
// processes over one store answer one digest. A sibling file's edit moves nothing; a const
// the body READS moving moves the unit.
use @std.avrac.testing.{test_workspace}
use @std.time.{now_ns}
use compiler.{Workspace, lowered_unit_of}
use compiler.lower.{code_facts}
use compiler.host.{memory_host}
use compiler.store.{Store, store_at}
use features.{Wanted}

const UF_MAIN: string = "/w/src/main.av"

fn uf_files(konst: int, sibling: int) -> Map<string, string> {
    {
        "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n",
        UF_MAIN: "const K: int = ${konst}\nexport fn f() -> int { K + 1 }\n",
        "/w/src/b.av": "export fn g() -> int { ${sibling} }\n",
    }
}

fn uf_process(files: Map<string, string>, store: Store) -> Workspace {
    let ws = test_workspace(memory_host(files, files.keys()), "/w")
    ws.attach_store(store)
    ws
}

fn uf_want(ws: Workspace) -> Wanted {
    let _ = ws.file_id(UF_MAIN)
    ws.admit_all()
    ws.decls.plain_want([x.id for x in ws.decls.all_decls() if x.name == "f"][0])
}

/// A process over `files` runs `f`'s unit and answers its CODE, digested by durable name.
fn uf_unit(files: Map<string, string>, store: Store) -> int {
    let ws = uf_process(files, store)
    let u = lowered_unit_of(ws, uf_want(ws))
    code_facts(ws.decls, u.bodies, u.statics, []).fingerprint()
}

fn uf_store(name: string) -> Store { store_at("/tmp/avra-unit-facts-test/${now_ns()}/${name}") }

spec "compiler/lowered_unit — a unit stands on what it read" {
    given "a fn reading a const, said once" {
        then "a second process over the same files answers one unit" {
            let s = uf_store("same")
            let before = uf_unit(uf_files(1, 2), s)
            uf_unit(uf_files(1, 2), s) == before
        }
        then "a process after a sibling edit answers the unit it answered before" {
            let s = uf_store("sibling")
            let before = uf_unit(uf_files(1, 2), s)
            uf_unit(uf_files(1, 3), s) == before
        }
        then "a process after the const's value changed answers a different unit" {
            let s = uf_store("const")
            let before = uf_unit(uf_files(1, 2), s)
            uf_unit(uf_files(5, 2), s) != before
        }
    }
}
