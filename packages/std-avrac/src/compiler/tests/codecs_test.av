// `make codecs`'s own suite: every registered pair, every exemplar,
// round-tripped. A pair that disagrees names itself, its exemplar and
// (through the exemplar's own label) the field that disagreed —
// CLAUDE.md's "a hash that forgets a payload" caught by machine.
use core.{flatten}
use compiler.codecs.{codec_pairs, codec_fixture_decl_names}

fn every_disagreement() -> List<string> {
    flatten([c.run() for c in codec_pairs()])
}

spec "compiler/codecs — every registered pair round-trips" {
    given "the whole registry" {
        then "no exemplar disagrees" {
            every_disagreement().is_empty()
        }
    }
    given "the registry itself" {
        then "it names at least the pairs this ticket started from" {
            codec_pairs().length >= 16
        }
    }
    given "the id-writing codecs' fixture" {
        then "it mints a real declaration the name codec round-trips" {
            codec_fixture_decl_names().contains("a")
        }
    }
}
