// proves: the binary's own data is never counted and never freed,
// however often it is read, copied and grown
const grid: List<List<int>> = [[1, 2], [3, 4], [5]]
const names: List<string> = ["a", "b"]

type Row = { cells: List<int> }

fn pick(i: int) -> List<int> { grid[i] }

fn grown(i: int) -> List<int> {
    mut xs = pick(i)
    xs.push(9)
    xs
}

fn shown() -> string {
    mut out: List<string> = []
    for i in 0..300 {
        let g = grown(i % 3)
        let r = Row { cells: grid[i % 3] }
        if i > 296 { out.push("${g.length}:${r.cells.length}:${grid[i % 3].length}") }
    }
    out.concat(names).join(" ")
}

shown()
