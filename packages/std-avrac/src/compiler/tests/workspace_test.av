// The workspace over an in-memory host: a module is a directory or a
// file, siblings see each other, `use` reaches a module's exports,
// and every failed `use` speaks in its own words.
use @std.avrac.testing.{test_workspace}
use compiler.{Workspace, sig_hash}
use @std.avrac.core.{TypeId, DeclId}
use @std.avrac.features.{DeclSig, EnumSig, StructSig, NamedSig}
use compiler.host.{memory_host, memory_host_at}
use @std.avrac.diagnostics.{Diag, render, new_source_file}

/// A small package: a root file, a root sibling, a directory module
/// with two ws_files, and a lone-file module.
fn ws_files() -> Map<string, string> {
    {
        "/w/src/main.av": "use util.{twice, Pair}\nuse solo.{only}\nlet p = Pair { a: 1, b: 2 }\ntwice(21) + only(1) + helper(3)\n",
        "/w/src/helper.av": "fn helper(n: int) -> int {\n    n\n}\n",
        "/w/src/util/mathx.av": "export fn twice(n: int) -> int {\n    n * 2\n}\nfn hidden() -> int {\n    0\n}\nexport fn ident<T>(x: T) -> T {\n    x\n}\n",
        "/w/src/util/pair.av": "export type Pair = { a: int, b: int }\nexport type Box<T> = { v: T }\nexport enum Shape {\n    Dot\n    Line(int)\n}\n",
        "/w/src/solo.av": "export fn only(n: int) -> int {\n    n\n}\n",
    }
}

fn ws_names() -> List<string> {
    [
        "/w/src/main.av",
        "/w/src/helper.av",
        "/w/src/util/mathx.av",
        "/w/src/util/pair.av",
        "/w/src/solo.av",
    ]
}

fn ws_of() -> Workspace {
    test_workspace(memory_host(ws_files(), ws_names()), "/w")
}

/// The package with its root file replaced.
fn with_main(text: string) -> Workspace {
    mut fs = ws_files()
    fs.set("/w/src/main.av", text)
    test_workspace(memory_host(fs, ws_names()), "/w")
}

/// The package with a manifest beside its sources, its entry a spec
/// of one case.
fn spec_package(toml: string) -> Workspace {
    mut fs = ws_files()
    fs.set("/w/avra.toml", toml)
    fs
        .set(
            "/w/src/main.av",
            "spec \"s\" {\n    given \"g\" {\n        then \"t\" { true }\n    }\n}\n",
        )
    test_workspace(
        memory_host(fs, ws_names().concat(["/w/avra.toml"])) with { env: path_only },
        "/w",
    )
}

/// An environment holding `PATH` alone.
fn path_only(name: string) -> string? {
    if name == "PATH" { return "/usr/bin" }
    null
}

/// An environment whose `X` names another variable, and whose `Z`
/// names itself.
fn self_naming(name: string) -> string? {
    if name == "X" { return "\${" + "Y}" }
    if name == "Y" { return "/y" }
    if name == "Z" { return "\${" + "Z}" }
    null
}

/// The link words of a package whose search row is `word`, under
/// `self_naming`'s environment.
fn searched(word: string) -> List<string> {
    mut fs = ws_files()
    fs
        .set(
            "/w/avra.toml",
            "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[link]\nsearch = [\"${word}\"]\n",
        )
    fs.set("/w/src/main.av", "1\n")
    test_workspace(
        memory_host(fs, ws_names().concat(["/w/avra.toml"])) with { env: self_naming },
        "/w",
    )
        .link_words("")
}

/// The manifest of a package whose search row is `word`.
fn searching(word: string) -> string {
    "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[link]\nsearch = [\"${word}\"]\n"
}

/// What a package whose search row is `word` says, under `self_naming`'s
/// environment.
fn unset_voices(word: string) -> List<Diag> {
    mut fs = ws_files()
    fs.set("/w/avra.toml", searching(word))
    fs.set("/w/src/main.av", "1\n")
    let ws = test_workspace(
        memory_host(fs, ws_names().concat(["/w/avra.toml"])) with { env: self_naming },
        "/w",
    )
    [d for d in ws.program(null).voices if d.kind == "manifest.unset_link_variable"]
}

/// A manifest whose raw link option is a shell command — the
/// program's own hatch, carrying the worst word it could.
fn poisoned_manifest() -> string {
    "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[link]\nlibs = [\"m\"]\n\n[link.raw]\nflags = [\"; touch /tmp/PWNED ;\"]\n"
}

/// A manifest whose search rows carry environment holes — one that
/// fills (PATH is always set) and one that names nothing.
fn holed_manifest() -> string {
    "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[link]\nsearch = [\"\$" +
        "{PATH}\", \"\$" +
        "{AVRA_NO_SUCH_VAR_}\"]\n"
}

/// A root and one dependency, where the DEPENDENCY asks for raw
/// linker options and for a library by name. Nobody reads a
/// transitive manifest; this is what it could carry.
fn borrowing_workspace() -> Workspace {
    depending_on("[link]\nlibs = [\"m\"]\n\n[link.raw]\nflags = [\"-o\", \"/tmp/PWNED\"]\n")
}

/// A root and one dependency whose manifest ends in `rows`.
fn depending_on(rows: string) -> Workspace {
    let files = {
        "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@acme/dep\" = { path = \"vendor/dep\" }\n",
        "/w/src/main.av": "use @acme.dep.{d}\nd(1)\n",
        "/w/vendor/dep/avra.toml": "[package]\nname = \"@acme/dep\"\nversion = \"0.1.0\"\n\n${rows}",
        "/w/vendor/dep/src/dep.av": "export fn d(n: int) -> int {\n    n\n}\n",
    }
    test_workspace(
        memory_host(
            files,
            [
                "/w/avra.toml",
                "/w/src/main.av",
                "/w/vendor/dep/avra.toml",
                "/w/vendor/dep/src/dep.av",
            ],
        ),
        "/w",
    )
}

fn main_report(text: string) -> string {
    with_main(text).analyze_file("/w/src/main.av").report()
}

/// ONE refusal for the root file, saying this.
fn main_refuses(text: string, saying: string) -> bool {
    let a = with_main(text).analyze_file("/w/src/main.av")
    a.diagnostics.length == 1 && a.report().contains(saying)
}

/// Whether a run answered exactly `text`.
fn ran_as(r: Result<string, string>, text: string) -> bool {
    match r { .Ok(t) -> t == text, .Err(_) -> false }
}

spec "compiler/workspace" {
    given "modules are directories, or a file" {
        then "a root file belongs to the root module; a nested one to its directory" {
            let ws = ws_of()
            ws.module_of("/w/src/main.av") == "" && ws.module_of("/w/src/util/mathx.av") == "util"
        }
        then "every file under the root is found" {
            ws_of().all_files("/w/src").length == 5
        }
    }
    given "what a file sees" {
        then "a root sibling's fn, a directory module's exports, and a lone-file module resolve" {
            let ws = ws_of()
            let f = ws.visible(ws.file_id("/w/src/main.av"))
            f.fn_decl("helper") != null &&
                f.fn_decl("twice") != null &&
                f.type_decl("Pair") != null &&
                f.fn_decl("only") != null &&
                f.voices.list.is_empty()
        }
        then "a module's private fn is not on its surface" {
            let ws = ws_of()
            ws.visible(ws.file_id("/w/src/main.av")).fn_decl("hidden") == null
        }
        then "the whole file analyzes with nothing unresolved" {
            ws_of().analyze_file("/w/src/main.av").report() == ""
        }
    }
    given "typed across ws_files — the table is one" {
        then "a foreign fn's parameter judges the argument" {
            main_refuses("use util.{twice}\ntwice(\"x\")\n", "`int`")
        }
        then "a foreign record's fields are known — the missing one is named" {
            main_refuses("use util.{Pair}\nlet p = Pair { a: 1 }\np.a\n", "`b`")
        }
        then "a foreign record reads and adds" {
            main_report("use util.{Pair}\nlet p = Pair { a: 1, b: 2 }\np.a + p.b\n") == ""
        }
        then "a foreign fn is a value" {
            main_report("use util.{twice}\nlet f = twice\nf(4)\n") == ""
        }
        then "a foreign enum constructs and matches" {
            main_report(
                "use util.{Shape}\nlet s = Shape.Line(3)\nmatch s {\n    .Dot -> 0\n    .Line(n) -> n\n}\n",
            ) == ""
        }
        then "a foreign generic record applies in a signature and instantiates" {
            main_report(
                "use util.{Box}\nfn peek(b: Box<int>) -> int {\n    b.v\n}\npeek(Box { v: 7 })\n",
            ) == ""
        }
        then "a foreign generic fn types, and its specialization lowers in its home" {
            ran_as(with_main("use util.{ident}\nident(3)\n").program("/w/src/main.av").run(), "3")
        }
        then "a nested module's fn lowers under its qualified symbol" {
            with_main("use util.{twice}\ntwice(2)\n")
                .program("/w/src/main.av")
                .lowered()
                .fns
                .any(it.name == "util.twice")
        }
        then "the program lowers what the entry reaches — an unreached body stays out" {
            with_main("use util.{twice}\ntwice(2)\n")
                .program("/w/src/main.av")
                .lowered()
                .fns
                .any(it.name == "util.ident") == false
        }
    }
    given "the program runs across ws_files — one worklist" {
        then "a sibling, a directory module, a lone-file module, and a generic specialized in its home" {
            ran_as(
                with_main(
                    "use util.{twice, ident}\nuse solo.{only}\ntwice(20) + ident(1) + only(1) + helper(1)\n",
                )
                    .program("/w/src/main.av")
                    .run(),
                "43",
            )
        }
        then "a foreign fn worn as a value calls through its wrapper" {
            ran_as(
                with_main("use util.{twice}\nlet f = twice\nf(21)\n")
                    .program("/w/src/main.av")
                    .run(),
                "42",
            )
        }
        then "a foreign enum matches by its variants" {
            ran_as(
                with_main(
                    "use util.{Shape}\nlet s = Shape.Line(7)\nmatch s {\n    .Dot -> 0\n    .Line(n) -> n\n}\n",
                )
                    .program("/w/src/main.av")
                    .run(),
                "7",
            )
        }
        then "a foreign generic record instantiates and reads" {
            ran_as(
                with_main("use util.{Box}\nlet b = Box { v: 9 }\nb.v\n")
                    .program("/w/src/main.av")
                    .run(),
                "9",
            )
        }
        then "a run-time statement outside the entry refuses, naming the entry" {
            mut fs = ws_files()
            fs.set("/w/src/helper.av", "fn helper(n: int) -> int {\n    n\n}\nhelper(2)\n")
            let ws = test_workspace(memory_host(fs, ws_names()), "/w")
            let p = ws.program("/w/src/main.av")
            p.clean() &&
                p.lowered().diagnostics.length == 1 &&
                p
                    .rendered(p.lowered().diagnostics)
                    .contains("only the entry `/w/src/main.av` runs statements")
        }
    }
    given "a failed use speaks" {
        then "a module the root does not have" {
            main_refuses("use nope.{x}\n2\n", "no module `nope` under the package's source root")
        }
        then "an item the module does not export — the exports named" {
            main_refuses("use util.{hidden}\n2\n", "`util` does not export `hidden`") &&
                main_report("use util.{hidden}\n2\n")
                    .contains("its exports: twice, ident, Pair, Box, Shape")
        }
        then "a package the manifest does not declare — a root without one declares nothing" {
            main_refuses(
                "use @std.errors.{Loc}\n2\n",
                "`@std/errors` is not a dependency of this package",
            )
        }
    }
    given "the host seam carries words, never a shell line" {
        then "a link flag with shell metacharacters is ONE word, verbatim" {
            let words = spec_package(poisoned_manifest()).link_words("")
            words.contains("; touch /tmp/PWNED ;") && words.contains("-lm") && words.length == 2
        }
        then "an environment hole in a search row is filled from the environment" {
            let words = spec_package(holed_manifest()).link_words("")
            !words.any(it.contains("\$" + "{")) && words.any(it.starts_with("-L/"))
        }
        then "a hole naming nothing leaves no empty word behind" {
            let words = spec_package(holed_manifest()).link_words("")
            !words.any(it.is_empty()) && words.length == 1
        }
        then "a value holding a hole is data: the hole it holds is never filled" {
            searched("\$" + "{X}").join(" ") == "-L\$" + "{Y}"
        }
        then "a value naming its own variable is filled once" {
            searched("\$" + "{Z}/lib").join(" ") == "-L\$" + "{Z}/lib"
        }
        then "the holes after a value are filled" { searched("\$" + "{Y}:\$" + "{Y}").join(" ") == "-L/y:/y" }
        then "a hole naming nothing leaves no BARE `-L` either — it would eat the word after it" {
            !spec_package(holed_manifest()).link_words("").any(it == "-L")
        }
        then "the option letter is ours: a library is named, never spelled as an option" {
            spec_package(poisoned_manifest()).link_words("").contains("-lm")
        }
    }
    given "a dependency cannot put an option on the linker's line" {
        then "the dependency's raw options never reach the words" {
            let words = borrowing_workspace().link_words("")
            // LICENSED compiler.fixed_tmp_path: a word the linker line must lack, never opened
            !words.contains("-o") && !words.contains("/tmp/PWNED")
        }
        then "its TYPED row is still honoured — the rule refuses options, not needs" {
            borrowing_workspace().link_words("").contains("-lm")
        }
        then "and it is told, by name" {
            let spoken = borrowing_workspace().program(null).voices
            spoken.any(it.kind == "manifest.borrowed_raw")
        }
        then "the root's own raw hatch still carries its word" {
            spec_package(poisoned_manifest()).link_words("").contains("; touch /tmp/PWNED ;")
        }
    }
    given "a program keeps its own symbols only when a package's C names them" {
        then "a program whose packages ask nothing keeps none — the link drops what it never reaches" {
            !spec_package(poisoned_manifest()).names_its_symbols() &&
                !borrowing_workspace().names_its_symbols()
        }
        then "a DEPENDENCY's `dynamic_symbols` keeps them for the whole program" {
            depending_on("[link]\ndynamic_symbols = true\n").names_its_symbols()
        }
        then "a dependency writing it false keeps none" {
            !depending_on("[link]\ndynamic_symbols = false\n").names_its_symbols()
        }
    }
    given "a case is selected by the path it MEANS, not the text typed" {
        then "the file as listed" {
            spec_package(poisoned_manifest()).program(null).cases_at("/w/src/main.av").length == 1
        }
        then "a `./` in the path" {
            spec_package(poisoned_manifest()).program(null).cases_at("/w/src/./main.av").length == 1
        }
        then "a doubled slash" {
            spec_package(poisoned_manifest()).program(null).cases_at("/w//src/main.av").length == 1
        }
        then "a `..` folded into the path" {
            spec_package(poisoned_manifest())
                .program(null)
                .cases_at("/w/src/util/../main.av")
                .length == 1
        }
        then "another file selects nothing" {
            spec_package(poisoned_manifest()).program(null).cases_at("/w/src/helper.av").is_empty()
        }
    }
}

spec "signatures" {
    given "a signature's fingerprint covers the whole signature" {
        then "a variant's payloads are not the next variant's — `A(x, y) B` vs `A(x) B(y)`" {
            let x = TypeId { index: 1 }
            let y = TypeId { index: 2 }
            let together = DeclSig.Enum(EnumSig { names: ["A", "B"], payloads: [[x, y], []] })
            let apart = DeclSig.Enum(EnumSig { names: ["A", "B"], payloads: [[x], [y]] })
            sig_hash(together) != sig_hash(apart)
        }
        then "a field's default is part of the record that declares it" {
            let x = TypeId { index: 1 }
            // a struct-literal field seat plants no want, so the
            // nullable lists are bound at their own type first
            let absent: List<DeclId?> = [null]
            let present: List<DeclId?> = [DeclId { index: 0 }]
            let held = StructSig { names: ["a"], types: [x], defaults: absent }
            let seeded = StructSig { names: ["a"], types: [x], defaults: present }
            sig_hash(DeclSig.Record(held)) != sig_hash(DeclSig.Record(seeded))
        }
        then "a named type's shape is its signature — `type Id = int` is not `type Id = string`" {
            let over_int = DeclSig.Named(NamedSig { of: TypeId { index: 1 } })
            let over_text = DeclSig.Named(NamedSig { of: TypeId { index: 2 } })
            sig_hash(over_int) != sig_hash(over_text)
        }
    }
}

// ── The toolchain's std root ──

/// A toolchain at `/tc` carrying `@std/text` and `@std/io` (io reads
/// text by a manifest row), and a program at `/w` that declares
/// nothing.
fn toolchain_files() -> Map<string, string> {
    {
        "/tc/std-text/avra.toml": "[package]\nname = \"@std/text\"\nversion = \"0.0.1\"\n",
        "/tc/std-text/src/text.av": "export fn shout(s: string) -> string {\n    s + \"!\"\n}\n",
        "/tc/std-io/avra.toml": "[package]\nname = \"@std/io\"\nversion = \"0.0.1\"\n",
        "/tc/std-io/src/io.av": "use @std.text.{shout}\nexport fn shouted(s: string) -> string {\n    shout(s)\n}\n",
        "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n",
        "/tc/std-prelude/avra.toml": "[package]\nname = \"@std/prelude\"\nversion = \"0.0.1\"\n",
        "/tc/std-prelude/src/prelude.av": "export fn greet(s: string) -> string {\n    \"hi \" + s\n}\nexport fn floor() -> int {\n    0\n}\n",
    }
}

fn toolchain_names() -> List<string> {
    [
        "/tc/std-text/avra.toml",
        "/tc/std-text/src/text.av",
        "/tc/std-io/avra.toml",
        "/tc/std-io/src/io.av",
        "/w/avra.toml",
        "/w/src/main.av",
        "/tc/std-prelude/avra.toml",
        "/tc/std-prelude/src/prelude.av",
    ]
}

/// The program's root file, under a host whose std root is `/tc`.
fn toolchain_app(main: string) -> Workspace {
    mut fs = toolchain_files()
    fs.set("/w/src/main.av", main)
    test_workspace(memory_host(fs, toolchain_names()) with { std_root: "/tc" }, "/w")
}

/// The same program with a manifest of its own: a declared row for
/// `@std/text` pointing at a copy under the app.
fn pinned_app(main: string) -> Workspace {
    mut fs = toolchain_files()
    fs
        .set(
            "/w/avra.toml",
            "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@std/text\" = { path = \"vendor/text\" }\n",
        )
    fs.set("/w/vendor/text/avra.toml", "[package]\nname = \"@std/text\"\nversion = \"9.9.9\"\n")
    fs
        .set("/w/vendor/text/src/text.av", "export fn shout(s: string) -> string {\n    s + \"?\"\n}\n")
    fs.set("/w/src/main.av", main)
    let names = toolchain_names().concat(["/w/vendor/text/avra.toml", "/w/vendor/text/src/text.av"])
    test_workspace(memory_host(fs, names) with { std_root: "/tc" }, "/w")
}

fn toolchain_report(ws: Workspace) -> string {
    ws.analyze_file("/w/src/main.av").report()
}

fn toolchain_clean(ws: Workspace) -> bool {
    ws.analyze_file("/w/src/main.av").diagnostics.is_empty()
}

spec "the toolchain's std packages" {
    given "a program that declares no dependency" {
        then "a std package resolves from the std root" {
            toolchain_clean(toolchain_app("use @std.text.{shout}\nshout(\"hi\")\n"))
        }
        then "a std package's own dependencies come with it" {
            toolchain_clean(toolchain_app("use @std.io.{shouted}\nshouted(\"hi\")\n"))
        }
        then "the program runs through the toolchain's code" {
            ran_as(
                toolchain_app("use @std.io.{shouted}\nshouted(\"hi\")\n")
                    .program("/w/src/main.av")
                    .run(),
                "hi!",
            )
        }
        then "a package the toolchain does not carry is still not a dependency" {
            let a = toolchain_app("use @std.net.{fetch}\n1\n").analyze_file("/w/src/main.av")
            a.diagnostics.length == 1 &&
                a.report().contains("`@std/net` is not a dependency of this package")
        }
        then "a key outside @std is never the toolchain's" {
            let a = toolchain_app("use @acme.text.{shout}\n1\n").analyze_file("/w/src/main.av")
            a.diagnostics.length == 1 &&
                a.report().contains("`@acme/text` is not a dependency of this package")
        }
        then "a host with no std root refuses as before" {
            let a = with_main("use @std.text.{shout}\n1\n").analyze_file("/w/src/main.av")
            a.diagnostics.length == 1 &&
                a.report().contains("`@std/text` is not a dependency of this package")
        }
    }
    given "a manifest row for a std package" {
        then "the declared copy is the one read" {
            ran_as(
                pinned_app("use @std.text.{shout}\nshout(\"hi\")\n").program("/w/src/main.av").run(),
                "hi?",
            )
        }
        then "the pin holds for every package in the graph" {
            ran_as(
                pinned_app("use @std.io.{shouted}\nshouted(\"hi\")\n")
                    .program("/w/src/main.av")
                    .run(),
                "hi?",
            )
        }
        then "a dependency's own row disagreeing with the pin is two directories" {
            mut fs = toolchain_files()
            fs
                .set(
                    "/tc/std-io/avra.toml",
                    "[package]\nname = \"@std/io\"\nversion = \"0.0.1\"\n\n[dependencies]\n\"@std/text\" = { path = \"../std-text\" }\n",
                )
            fs
                .set(
                    "/w/avra.toml",
                    "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@std/text\" = { path = \"vendor/text\" }\n",
                )
            fs
                .set(
                    "/w/vendor/text/avra.toml",
                    "[package]\nname = \"@std/text\"\nversion = \"9.9.9\"\n",
                )
            fs
                .set("/w/vendor/text/src/text.av", "export fn shout(s: string) -> string {\n    s\n}\n")
            fs.set("/w/src/main.av", "use @std.io.{shouted}\nshouted(\"hi\")\n")
            let names = toolchain_names()
                .concat(["/w/vendor/text/avra.toml", "/w/vendor/text/src/text.av"])
            package_voice(
                test_workspace(memory_host(fs, names) with { std_root: "/tc" }, "/w"),
                "`@std/text` is claimed by two directories",
            )
        }
    }
}

spec "one directory, one spelling" {
    given "a root opened by a relative path under a host with a cwd" {
        then "a declared relative path and the toolchain's absolute one are one package" {
            mut fs = toolchain_files()
            fs
                .set(
                    "/tc/std-io/avra.toml",
                    "[package]\nname = \"@std/io\"\nversion = \"0.0.1\"\n\n[dependencies]\n\"@std/text\" = { path = \"../std-text\" }\n",
                )
            fs
                .set(
                    "w/avra.toml",
                    "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@std/text\" = { path = \"../tc/std-text\" }\n",
                )
            fs.set("w/src/main.av", "use @std.io.{shouted}\nshouted(\"hi\")\n")
            let names = [
                "/tc/std-text/avra.toml",
                "/tc/std-text/src/text.av",
                "/tc/std-io/avra.toml",
                "/tc/std-io/src/io.av",
                "w/avra.toml",
                "w/src/main.av",
            ]
            let ws = test_workspace(memory_host_at(fs, names, "/") with { std_root: "/tc" }, "w")
            ws.analyze_file("w/src/main.av").diagnostics.is_empty()
        }
    }
}

spec "the prelude" {
    given "a file that imports nothing" {
        then "a prelude export is in scope" {
            ran_as(toolchain_app("greet(\"x\")\n").program("/w/src/main.av").run(), "hi x")
        }
        then "the toolchain's own packages see it too" {
            mut fs = toolchain_files()
            fs
                .set(
                    "/tc/std-text/src/text.av",
                    "export fn shout(s: string) -> string {\n    greet(s) + \"!\"\n}\n",
                )
            fs.set("/w/src/main.av", "use @std.text.{shout}\nshout(\"x\")\n")
            ran_as(
                test_workspace(memory_host(fs, toolchain_names()) with { std_root: "/tc" }, "/w")
                    .program("/w/src/main.av")
                    .run(),
                "hi x!",
            )
        }
        then "a host with no std root has no prelude" {
            let a = with_main("greet(\"x\")\n").analyze_file("/w/src/main.av")
            a.diagnostics.length == 1 && a.report().contains("no `fn greet` is defined")
        }
    }
    given "a name the file holds itself" {
        then "the file's own declaration wins silently" {
            ran_as(
                toolchain_app(
                    "fn greet(s: string) -> string {\n    \"mine \" + s\n}\ngreet(\"x\")\n",
                )
                    .program("/w/src/main.av")
                    .run(),
                "mine x",
            )
        }
        then "an explicit import wins silently" {
            mut fs = toolchain_files()
            fs
                .set(
                    "/tc/std-text/src/text.av",
                    "export fn greet(s: string) -> string {\n    \"text \" + s\n}\n",
                )
            fs.set("/w/src/main.av", "use @std.text.{greet}\ngreet(\"x\")\n")
            ran_as(
                test_workspace(memory_host(fs, toolchain_names()) with { std_root: "/tc" }, "/w")
                    .program("/w/src/main.av")
                    .run(),
                "text x",
            )
        }
        then "the prelude's own file does not see itself twice" {
            test_workspace(
                memory_host(toolchain_files(), toolchain_names()) with { std_root: "/tc" },
                "/tc/std-prelude",
            )
                .analyze_file("/tc/std-prelude/src/prelude.av")
                .diagnostics
                .is_empty()
        }
    }
    given "the floor" {
        then "a prelude that declares a dependency is refused" {
            mut fs = toolchain_files()
            fs
                .set(
                    "/tc/std-prelude/avra.toml",
                    "[package]\nname = \"@std/prelude\"\nversion = \"0.0.1\"\n\n[dependencies]\n\"@std/text\" = { path = \"../std-text\" }\n",
                )
            fs.set("/w/src/main.av", "greet(\"x\")\n")
            package_voice(
                test_workspace(memory_host(fs, toolchain_names()) with { std_root: "/tc" }, "/w"),
                "`@std/prelude` depends on nothing",
            )
        }
    }
}

spec "the unit table" {
    given "one table, the workspace's own — never a collection's copy" {
        then "a name the collection interned answers the SAME id afterwards, and asking it again mints nothing" {
            let ws = ws_of()
            let p = ws.program(null)
            let l = p.lowered()
            let interned = ws.asks.get()
            l.fns.length > 0 &&
                interned.length > 0 &&
                ws.spec_id(interned[0]) == 0 &&
                ws.asks.get().length == interned.length
        }
    }
}

spec "avra fmt --write's own receipt" {
    given "a file already in canonical form" {
        then "write_checked_source answers it byte-identical, the CLI's own trailing newline included" {
            let ws = ws_of()
            let f = ws.file_id("/w/src/helper.av")
            match ws.write_checked_source(f) {
                .Ok(text) -> "${text}\n" == "fn helper(n: int) -> int {\n    n\n}\n",
                .Err(_) -> false,
            }
        }
        then "a trailing blank line before EOF is not read as an empty tail — write_checked_source's own receipt over the exact hazard render_with's fix closed" {
            let ws = with_main("let x = 1\n\n")
            let f = ws.file_id("/w/src/main.av")
            match ws.write_checked_source(f) {
                .Ok(text) -> "${text}\n" == "let x = 1\n\n",
                .Err(_) -> false,
            }
        }
    }
    given "a scope whose only content is its tail value — `tail_scoped`'s span narrows to the value alone, for a diagnostic pointing at the answer" {
        then "an own-line comment before the closing brace stays inside it, stable under one write" {
            let src = "fn f(c: int) -> bool {\n    c == 61 || c == 124\n    // the bitwise three\n}\n"
            let ws = with_main(src)
            let f = ws.file_id("/w/src/main.av")
            match ws.write_checked_source(f) { .Ok(text) -> "${text}\n" == src, .Err(_) -> false }
        }
        then "the same comment, mid-chain in the author's own wrapping, lands inside the brace and stays there on a second write" {
            let ws1 = with_main(
                "fn f(c: int) -> bool {\n    c == 61 ||\n    // the bitwise three\n    c == 124\n}\n",
            )
            let f1 = ws1.file_id("/w/src/main.av")
            match ws1.write_checked_source(f1) {
                .Ok(first) -> {
                    let ws2 = with_main("${first}\n")
                    let f2 = ws2.file_id("/w/src/main.av")
                    match ws2.write_checked_source(f2) {
                        .Ok(second) -> "${second}\n" == "${first}\n",
                        .Err(_) -> false,
                    }
                },
                .Err(_) -> false,
            }
        }
    }
    given "a byte string" {
        then "writes back exactly as spelled — escapes, their case and a raw byte kept" {
            let src = "let a = b\"PA\\x00TH\\xFe\\n\\\"é\"\nlet e = b\"\"\n"
            let ws = with_main(src)
            match ws.write_checked_source(ws.file_id("/w/src/main.av")) {
                .Ok(text) -> "${text}\n" == src,
                .Err(_) -> false,
            }
        }
    }
    given "a file that imports a cross-module component word — a block word the CANON door's own reparse must be handed too" {
        then "a hand-wrapped list literal with no trailing comma still writes — CANON-rescued, not refused for a reparse that forgot the file's own block words" {
            let fs = {
                "/w/src/lib.av": "export component Widget {\n    depth: int\n}\n",
                "/w/src/main.av": "use lib.{Widget}\n\nWidget w {\n    depth: 8\n}\n\nfn names(t: string) -> bool {\n    [\n        \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n        \"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\n        \"ccccccccccccccccccccccccccccccc\"\n    ].any((p) -> t == p)\n}\n",
            }
            let ws = test_workspace(memory_host(fs, ["/w/src/lib.av", "/w/src/main.av"]), "/w")
            let f = ws.file_id("/w/src/main.av")
            match ws.write_checked_source(f) {
                .Ok(text) -> text.contains("ccccccccccccccccccccccccccccccc\",\n    ]"),
                .Err(_) -> false,
            }
        }
    }
    given "a `[link]` hole whose variable is unset" {
        then "inside a longer word, it is refused naming the variable" {
            let said = unset_voices("\$" + "{UNSET}/lib")
            said.length == 1 && said[0].message.contains("`UNSET`")
        }
        then "as the whole word, it is dropped and nothing is said" { unset_voices("\$" + "{UNSET}").is_empty() }
        then "a set variable inside a word is filled and nothing is said" { unset_voices("\$" + "{Y}/lib").is_empty() }
        then "the refusal renders at its row" {
            let word = "\$" + "{UNSET}/lib"
            render(unset_voices(word)[0], new_source_file("/w/avra.toml", searching(word)))
                .starts_with(
                    "error[manifest.unset_link_variable]: `" +
                        word +
                        "` in `search` fills `UNSET`, which is not set — a hole inside a `[link]` word needs its variable, or the word names another path\n  ╭─[/w/avra.toml:6:1]",
                )
        }
    }
}
