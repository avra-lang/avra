// proves: a store, a slot write, a pop, a concat and a slice each move
// the references they should
type Node = { val: int, kids: List<Node> }

fn tree(d: int) -> Node {
    if d == 0 { return Node { val: 1, kids: [] } }
    Node { val: d, kids: [tree(d - 1), tree(d - 1)] }
}

fn weight(n: Node) -> int {
    mut t = n.val
    for k in n.kids { t = t + weight(k) }
    t
}

fn shown() -> string {
    mut cur = tree(3)
    mut best = tree(0)
    mut t = 0
    for i in 0..60 {
        cur = tree(i % 5)
        if i % 7 == 0 { best = cur }
        t = t + weight(cur)
    }
    mut xs = [[1], [2], [3]]
    let keep = xs[1]
    xs.set(1, [9, 9])
    let popped = xs.pop()
    let ys = xs.concat([keep, popped])
    let zs = ys.slice(1, 3)
    xs = []
    "${t} ${weight(best)} ${keep[0]} ${popped[0]} ${ys.length} ${zs[0][0]} ${zs[1][0]}"
}

shown()
