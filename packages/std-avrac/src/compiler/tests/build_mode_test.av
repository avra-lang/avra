// ONE STORE PER TREE, AND THE MODE IS THE PRINT'S. An object is one target's code
// and a linked module one link's answer, so every word of a toolchain that moves
// either must move the compiler's PRINT — which the store's header carries and
// every durable key folds — never the store root, which is the tree's one.
use @std.avrac.compiler.{build_cache_root}
use compiler.{Workspace, Toolchain}

/// A wasm toolchain as the build command spells one, shrinking.
fn wasm_tools() -> Toolchain {
    Toolchain {
        opt: "-Oz",
        runtime: "rt.a",
        linker: "clang",
        tools: [],
        target: "wasm32-wasip1",
        wasm_opt: "wasm-opt",
    }
}

/// The host's own toolchain.
fn host_tools() -> Toolchain { Toolchain { opt: "-O1", runtime: "rt.a", linker: "clang", tools: [] } }

/// A workspace over `binary`, built for `tools`.
fn built_workspace(binary: string, tools: Toolchain) -> Workspace {
    let ws = print_workspace(binary)
    ws.built_for(tools)
    ws
}

spec "compiler/build — one store per tree, and the mode is the print's" {
    given "a workspace built for a wasm target" {
        then "the store root is the tree's one, whatever the target" {
            let bin = real_binary("mode-target", "one compiler")
            build_cache_root(built_workspace(bin, wasm_tools())) == build_cache_root(built_workspace(bin, host_tools()))
        }
        then "the print moves with the target" {
            let bin = real_binary("mode-target-id", "one compiler")
            built_workspace(bin, wasm_tools()).compiler_id() != built_workspace(bin, host_tools()).compiler_id()
        }
        then "its restart reads the same store root" {
            let ws = built_workspace(real_binary("mode-anew", "one compiler"), wasm_tools())
            build_cache_root(ws.anew()) == build_cache_root(ws)
        }
        then "its restart's restart reads the same store root" {
            let ws = built_workspace(real_binary("mode-anew2", "one compiler"), wasm_tools())
            build_cache_root(ws.anew().anew()) == build_cache_root(ws)
        }
        then "its restart keys a binary as it does" {
            let ws = built_workspace(real_binary("mode-anew-key", "one compiler"), wasm_tools())
            ws.anew().program_key("/w/src/main.av", []) == ws.program_key("/w/src/main.av", [])
        }
        then "its binary's key is not the host build's" {
            let bin = real_binary("mode-key", "one compiler")
            built_workspace(bin, wasm_tools()).program_key("/w/src/main.av", []) != built_workspace(bin, host_tools()).program_key("/w/src/main.av", [])
        }
    }
    given "a workspace whose print and store root were asked before it was built for a target" {
        then "the store root does not move — the tree's is the tree's" {
            let bin = real_binary("mode-late", "one compiler")
            let ws = print_workspace(bin)
            let host_root = build_cache_root(ws)
            ws.built_for(wasm_tools())
            build_cache_root(ws) == host_root
        }
        then "the print moves with it" {
            let ws = print_workspace(real_binary("mode-late-id", "one compiler"))
            let host_id = ws.compiler_id()
            ws.built_for(wasm_tools())
            ws.compiler_id() != host_id
        }
        then "built for the host again, the print is the host's again" {
            let bin = real_binary("mode-back", "one compiler")
            let ws = built_workspace(bin, wasm_tools())
            let wasm_id = ws.compiler_id()
            ws.built_for(host_tools())
            ws.compiler_id() != wasm_id
        }
    }
    given "two wasm toolchains one word apart" {
        then "another target spelling is another print" {
            let bin = real_binary("mode-spelling", "one compiler")
            built_workspace(bin, wasm_tools()).compiler_id() != built_workspace(bin, wasm_tools() with { target: "wasm32-unknown-wasi" }).compiler_id()
        }
        then "a reactor is another print" {
            let bin = real_binary("mode-reactor", "one compiler")
            built_workspace(bin, wasm_tools()).compiler_id() != built_workspace(bin, wasm_tools() with { reactor: true }).compiler_id()
        }
        then "an unshrunk module is another print" {
            let bin = real_binary("mode-opt", "one compiler")
            built_workspace(bin, wasm_tools()).compiler_id() != built_workspace(bin, wasm_tools() with { wasm_opt: "" }).compiler_id()
        }
        then "a debug link is another print" {
            let bin = real_binary("mode-debug", "one compiler")
            built_workspace(bin, wasm_tools()).compiler_id() != built_workspace(bin, wasm_tools() with { debug: true }).compiler_id()
        }
        then "a reactor and a debug link are not one print" {
            let bin = real_binary("mode-marks", "one compiler")
            built_workspace(bin, wasm_tools() with { reactor: true }).compiler_id() != built_workspace(bin, wasm_tools() with { debug: true }).compiler_id()
        }
    }
    given "a workspace built for the host" {
        then "its print is the one a workspace nobody built carries" {
            let bin = real_binary("mode-host", "one compiler")
            built_workspace(bin, host_tools()).compiler_id() == print_workspace(bin).compiler_id()
        }
        then "a wasm-only word moves nothing on the host" {
            let bin = real_binary("mode-host-words", "one compiler")
            built_workspace(bin, host_tools()).compiler_id() == built_workspace(
                bin,
                host_tools() with { reactor: true, debug: true, wasm_opt: "wasm-opt" },
            )
                .compiler_id()
        }
    }
}
