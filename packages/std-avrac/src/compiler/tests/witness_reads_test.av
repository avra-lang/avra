// A file's own namespace is read by NAME: an edit elsewhere in its module moves a
// witness only when it moves a name the file asked for. Each case runs a second
// process over a pack the first wrote; `verdict` names the edges that refused.
// `fresh_check`, `verdict`, `refused_family`, `same_verdict_as_fresh`, `edge_count`
// are witness_fixtures.av's own.
use diagnostics.{DiagFacts}

/// `a` calls `helper` from `b`; `c` is a sibling `a` never names.
fn trio(b_body: string, c_body: string) -> Map<string, string> {
    {
        "/w/src/a.av": "export fn g() -> int {\n    helper()\n}\n",
        "/w/src/b.av": "export fn helper() -> int {\n    ${b_body}\n}\n",
        "/w/src/c.av": "export fn unrelated() -> int {\n    ${c_body}\n}\n",
    }
}

fn trio_names() -> List<string> { ["/w/src/a.av", "/w/src/b.av", "/w/src/c.av"] }

spec "compiler/witness — a file's names are read one by one" {
    then "fixture: the trio is clean, and a witness of `a` holds a NameRead for `helper`" {
        let path = fresh_pack_path("reads_fixture")
        let ws = a_process_over(trio("1", "2"), trio_names(), path)
        let _ = checked(ws, "/w/src/a.av")
        fresh_check(trio("1", "2"), trio_names(), "/w/src/a.av").clean &&
            edge_count(ws, path, "/w/src/a.av", "NameRead") >= 1
    }
    then "a sibling the file never names can change its body, and the witness holds" {
        let path = fresh_pack_path("reads_unrelated_body")
        let _ = checked(a_process_over(trio("1", "2"), trio_names(), path), "/w/src/a.av")
        let v = verdict(a_process_over(trio("1", "3"), trio_names(), path), path, "/w/src/a.av")
        v.refused_by.is_empty() && v.outcome.reused()
    }
    then "a sibling the file never names can gain a declaration, and the witness holds" {
        let path = fresh_pack_path("reads_unrelated_added")
        let _ = checked(a_process_over(trio("1", "2"), trio_names(), path), "/w/src/a.av")
        let more: Map<string, string> = {
            "/w/src/a.av": "export fn g() -> int {\n    helper()\n}\n",
            "/w/src/b.av": "export fn helper() -> int {\n    1\n}\n",
            "/w/src/c.av": "export fn unrelated() -> int {\n    2\n}\nexport fn another() -> int {\n    4\n}\n",
        }
        let v = verdict(a_process_over(more, trio_names(), path), path, "/w/src/a.av")
        v.refused_by.is_empty() && v.outcome.reused()
    }
    then "a name the file read that moves to another file is refused by its NameRead, and the verdict is the fresh one" {
        let path = fresh_pack_path("reads_moved")
        let _ = checked(a_process_over(trio("1", "2"), trio_names(), path), "/w/src/a.av")
        let moved: Map<string, string> = {
            "/w/src/a.av": "export fn g() -> int {\n    helper()\n}\n",
            "/w/src/b.av": "export fn other_b() -> int {\n    5\n}\n",
            "/w/src/c.av": "export fn helper() -> int {\n    1\n}\n",
        }
        let v = verdict(a_process_over(moved, trio_names(), path), path, "/w/src/a.av")
        refused_family(v, "NameRead") &&
            same_verdict_as_fresh(v, fresh_check(moved, trio_names(), "/w/src/a.av"))
    }
    then "a name the file read whose signature changes is refused, and the verdict is the fresh one" {
        let path = fresh_pack_path("reads_sig")
        let _ = checked(a_process_over(trio("1", "2"), trio_names(), path), "/w/src/a.av")
        let retyped: Map<string, string> = {
            "/w/src/a.av": "export fn g() -> int {\n    helper()\n}\n",
            "/w/src/b.av": "export fn helper() -> string {\n    \"one\"\n}\n",
            "/w/src/c.av": "export fn unrelated() -> int {\n    2\n}\n",
        }
        let v = verdict(a_process_over(retyped, trio_names(), path), path, "/w/src/a.av")
        !v.outcome.reused() &&
            same_verdict_as_fresh(v, fresh_check(retyped, trio_names(), "/w/src/a.av"))
    }
}

/// `a` misspells `helper`; `b` defines it, or a rename of it.
fn typo_files(b_name: string) -> Map<string, string> {
    {
        "/w/src/a.av": "export fn g() -> int {\n    helpe()\n}\n",
        "/w/src/b.av": "export fn ${b_name}() -> int {\n    1\n}\n",
    }
}

/// The one diagnostic's own words — enough to tell two suggestions
/// apart without rendering (`WitnessedCheck.diagnostics` is
/// structured facts now, never a rendered string).
fn diag_words(fs: List<DiagFacts>) -> string {
    let f? = fs.first() else { return "" }
    "${f.message}|${f.help ?? ""}"
}

spec "compiler/witness — a name that answered nothing depends on the whole scope" {
    then "fixture: a's diagnostic offers a suggestion, and the suggestion moves when the near name is renamed" {
        let names = ["/w/src/a.av", "/w/src/b.av"]
        let before = fresh_check(typo_files("helper"), names, "/w/src/a.av")
        let after = fresh_check(typo_files("helperz"), names, "/w/src/a.av")
        !before.clean && !after.clean && diag_words(before.diagnostics) != diag_words(after.diagnostics)
    }
    then "the VisibleScope edge refuses when a name near the missing one is renamed elsewhere" {
        let names = ["/w/src/a.av", "/w/src/b.av"]
        let path = fresh_pack_path("reads_suggestion")
        let _ = checked(a_process_over(typo_files("helper"), names, path), "/w/src/a.av")
        let v = verdict(a_process_over(typo_files("helperz"), names, path), path, "/w/src/a.av")
        refused_family(v, "VisibleScope") &&
            same_verdict_as_fresh(v, fresh_check(typo_files("helperz"), names, "/w/src/a.av"))
    }
    then "a witness of a file with no unanswered name holds no VisibleScope edge" {
        let path = fresh_pack_path("reads_no_scope")
        let ws = a_process_over(trio("1", "2"), trio_names(), path)
        let _ = checked(ws, "/w/src/a.av")
        edge_count(ws, path, "/w/src/a.av", "VisibleScope") == 0
    }
}

/// `y` imports `pick` from `lib`, which `x` declares; `w` is a sibling in `lib` that `y` never names.
fn import_files(w_body: string, w_decls: string) -> Map<string, string> {
    {
        "/w/src/lib/x.av": "export fn pick() -> int {\n    1\n}\n",
        "/w/src/lib/w.av": "export fn also() -> int {\n    ${w_body}\n}\n${w_decls}",
        "/w/src/other/y.av": "use lib.{pick}\nexport fn g() -> int {\n    pick()\n}\n",
    }
}

fn import_names() -> List<string> { ["/w/src/lib/x.av", "/w/src/lib/w.av", "/w/src/other/y.av"] }

spec "compiler/witness — an import is read through the names it binds" {
    then "a sibling in the imported module can change its body, and the importer's witness holds" {
        let path = fresh_pack_path("reads_import_body")
        let _ = checked(
            a_process_over(import_files("9", ""), import_names(), path),
            "/w/src/other/y.av",
        )
        let v = verdict(
            a_process_over(import_files("8", ""), import_names(), path),
            path,
            "/w/src/other/y.av",
        )
        v.refused_by.is_empty() && v.outcome.reused()
    }
    then "a sibling in the imported module can gain a declaration, and the importer's witness holds" {
        let path = fresh_pack_path("reads_import_added")
        let _ = checked(
            a_process_over(import_files("9", ""), import_names(), path),
            "/w/src/other/y.av",
        )
        let more = "export fn another() -> int {\n    4\n}\n"
        let v = verdict(
            a_process_over(import_files("9", more), import_names(), path),
            path,
            "/w/src/other/y.av",
        )
        v.refused_by.is_empty() && v.outcome.reused()
    }
    then "the imported name going away is refused, and the verdict is the fresh one (an import error)" {
        let path = fresh_pack_path("reads_import_removed")
        let _ = checked(
            a_process_over(import_files("9", ""), import_names(), path),
            "/w/src/other/y.av",
        )
        let gone: Map<string, string> = {
            "/w/src/lib/x.av": "export fn nope() -> int {\n    2\n}\n",
            "/w/src/lib/w.av": "export fn also() -> int {\n    9\n}\n",
            "/w/src/other/y.av": "use lib.{pick}\nexport fn g() -> int {\n    pick()\n}\n",
        }
        let v = verdict(a_process_over(gone, import_names(), path), path, "/w/src/other/y.av")
        !v.outcome.reused() &&
            same_verdict_as_fresh(v, fresh_check(gone, import_names(), "/w/src/other/y.av"))
    }
    then "the imported name moving to another file of the module is refused by its NameRead, and the verdict is the fresh one" {
        let path = fresh_pack_path("reads_import_moved")
        let _ = checked(
            a_process_over(import_files("9", ""), import_names(), path),
            "/w/src/other/y.av",
        )
        let moved: Map<string, string> = {
            "/w/src/lib/x.av": "export fn other_x() -> int {\n    1\n}\n",
            "/w/src/lib/w.av": "export fn also() -> int {\n    9\n}\nexport fn pick() -> int {\n    1\n}\n",
            "/w/src/other/y.av": "use lib.{pick}\nexport fn g() -> int {\n    pick()\n}\n",
        }
        let v = verdict(a_process_over(moved, import_names(), path), path, "/w/src/other/y.av")
        refused_family(v, "NameRead") &&
            same_verdict_as_fresh(v, fresh_check(moved, import_names(), "/w/src/other/y.av"))
    }
}
