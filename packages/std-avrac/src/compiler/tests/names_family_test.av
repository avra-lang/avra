// `Family.Names` (COMPILER DB townhall §6.11): a foreign reader of a
// body's names depends on that declaration's own slice, never on the
// file's whole `Resolved`. `Family` is compiler-internal, so this file
// names the stable, append-only ordinals: `Visible` is 4, `Receivers`
// is 16, `Names` is 26 (compiler/workspace.av's `ordinal`).
use @std.avrac.testing.{test_workspace}
use compiler.{Workspace}
use compiler.host.{memory_host}
use core.{DeclId}
use @std.relation.engine.{Key}

fn names_receivers_key() -> Key { Key { family: 16, arg: 0 } }

fn names_key(d: DeclId) -> Key { Key { family: 26, arg: d.index } }

fn names_visible_key(ws: Workspace) -> Key { Key { family: 4, arg: ws.file_id("/w/src/main.av").index } }

fn names_workspace(main: string) -> Workspace {
    test_workspace(
        memory_host(
            {
                "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n",
                "/w/src/main.av": main,
            },
            ["/w/avra.toml", "/w/src/main.av"],
        ),
        "/w",
    )
}

fn names_decl_named(ws: Workspace, name: string) -> DeclId {
    [x.id for x in ws.decls.all_decls() if x.name == name][0]
}

fn names_source(a_body: string, b_body: string) -> string {
    "fn one() -> int {\n    1\n}\nfn a() -> int {\n    ${a_body}\n}\nfn b() -> int {\n    ${b_body}\n}\n"
}

/// `b`'s name slice after `receivers()` has read it.
fn names_slice_of_b(ws: Workspace) -> int {
    let _ = ws.items(ws.file_id("/w/src/main.av"))
    let _ = ws.receivers()
    ws.name_slice(names_decl_named(ws, "b"))
}

spec "compiler/workspace — Family.Names is declaration-grain" {
    given "`receivers()` over a program with plain fns" {
        then "its dependency list names `b`'s Names directly" {
            let ws = names_workspace(names_source("1", "2"))
            let _ = ws.items(ws.file_id("/w/src/main.av"))
            let _ = ws.receivers()
            let b = names_decl_named(ws, "b")
            ws
                .db
                .edges_by_reader(names_receivers_key())
                .any((k: Key) -> k.family == names_key(b).family && k.arg == names_key(b).arg)
        }
        then "and names the file's Visible, which carries the namespace the slice leaves out" {
            let ws = names_workspace(names_source("1", "2"))
            let _ = ws.items(ws.file_id("/w/src/main.av"))
            let _ = ws.receivers()
            let v = names_visible_key(ws)
            ws
                .db
                .edges_by_reader(names_receivers_key())
                .any((k: Key) -> k.family == v.family && k.arg == v.arg)
        }
    }
    given "`b`'s slice in a file where `a` is edited" {
        then "a new binding in `a` leaves `b`'s slice where it was" {
            names_slice_of_b(names_workspace(names_source("1", "2"))) == names_slice_of_b(names_workspace(names_source("one()", "2")))
        }
        then "a new binding in `b` moves it" {
            names_slice_of_b(names_workspace(names_source("1", "2"))) != names_slice_of_b(names_workspace(names_source("1", "one()")))
        }
    }
}
