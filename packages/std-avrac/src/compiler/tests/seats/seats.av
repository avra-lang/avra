// proves: THE ONE AGREEMENT DOOR — a call argument, a struct field and
// an enum payload widen alike: a struct boxes into a `dyn` seat, a
// plain value auto-Oks into a `Result` seat, and the recorded lift
// is what lowering mints, in every seat, both engines.
trait Show {
    fn show() -> int
}
type P = { x: int }
type Q = { y: int }
impl Show for P {
    fn show() -> int { self.x }
}
impl Show for Q {
    fn show() -> int { self.y * 10 }
}
enum E {
    bad
}
enum Holder {
    Holds(s: dyn Show)
    Res(r: Result<int, E>)
    Two(a: dyn Show, b: Result<int, E>)
}
type Box = { s: dyn Show, r: Result<int, E> }
fn speak(s: dyn Show) -> int { s.show() }
fn take(r: Result<int, E>) -> int { r catch 0 - 1 }
fn held(h: Holder) -> int {
    match h {
        .Holds(s) -> s.show(),
        .Res(r) -> r catch 0 - 1,
        .Two(a, b) -> a.show() + (b catch 0 - 1),
    }
}
let b = Box { s: Q { y: 2 }, r: 3 }
mut t = 0
for i in 0..200 {
    t = t + held(Holder.Holds(P { x: i })) + held(Holder.Res(i)) + held(Holder.Two(Q { y: 1 }, i))
}
"${speak(P { x: 1 })} ${take(5)} ${b.s.show()} ${b.r catch 0 - 1} ${held(Holder.Holds(Q { y: 4 }))} ${held(Holder.Res(6))} ${held(Holder.Two(P { x: 7 }, 8))} ${t}"
