// A file read through the door: what the host's two questions make of
// a file that is there, empty, missing, or gone between them — and what
// a source and a finding make of each.
use @std.avrac.testing.{test_workspace}
use compiler.{findings_of, Workspace}
use compiler.host.{Host, Read, Beneath, InputName, memory_host}

fn host_of(files: Map<string, string>) -> Host {
    memory_host(files, files.keys())
}

/// A workspace whose host lists `gone.av` beside `main.av`, holds it
/// until `gone` is set, and writes down every path it is handed to refuse.
fn listing_gone(gone: Cell<bool>, asked: Cell<List<string>>) -> Workspace {
    let base = memory_host(
        {"/w/src/main.av": "1\n", "/w/src/gone.av": "2\n"},
        ["/w/src/main.av", "/w/src/gone.av"],
    )
    test_workspace(
        base with { exists: (p: string) -> (p != "/w/src/gone.av" || !gone.get()) && base.exists(p), refused: (p: string) -> asked.push(p), peek: (p: string) -> if p == "/w/src/gone.av" && gone.get() { Beneath.Missing } else { (base.peek)(p) } },
        "/w",
    )
}

/// A host whose whole-file read answers `answer`, and writes down every
/// path it is handed to refuse.
fn refusing(answer: Beneath, asked: Cell<List<string>>) -> Host {
    host_of({"/w/a.av": "x"}) with { peek: (p: string) -> answer, refused: (p: string) -> asked.push(p) }
}

fn refused_key(kind: string) -> string {
    Read.Refused(InputName { kind: .Text, key: "/w/a.av" }, kind).input().digest.key
}

fn key_of(r: Read) -> string { r.input().digest.key }

/// A workspace over one file whose host answers "nothing there" once
/// `gone` is set.
fn leaving(main: string, gone: Cell<bool>) -> Workspace {
    let base = host_of({"/w/src/main.av": main})
    test_workspace(
        base with { exists: (p: string) -> !gone.get() && base.exists(p), peek: (p: string) -> if gone.get() { Beneath.Missing } else { (base.peek)(p) } },
        "/w",
    )
}

/// The source line the unwritten-`mut` rule names, as the host holds
/// the file after `edit` ran.
fn named_line(main: string, edit: fn(Workspace, Cell<bool>) -> void) -> string? {
    let gone = Cell.new(false)
    let ws = leaving(main, gone)
    let p = ws.program("/w/src/main.av")
    edit(ws, gone)
    findings_of(p).find(it.rule == "let_stmt.unmutated_mut")?.text
}

/// The file can no longer be given as text: `beneath` refuses it, and
/// every path handed to the host to refuse is written down in `died`.
fn unreadable(main: string, died: Cell<List<string>>, turned: Cell<bool>) -> Workspace {
    let base = host_of({"/w/src/main.av": main})
    test_workspace(
        base with { peek: (p: string) -> if turned.get() { Beneath.NotText(0) } else { (base.peek)(p) }, refused: (p: string) -> died.push(p) },
        "/w",
    )
}

fn untouched(_ws: Workspace, _gone: Cell<bool>) {}

fn renamed(ws: Workspace, _gone: Cell<bool>) {
    let _ = ws.host.write("/w/src/main.av", "mut b = 0\nb\n")
}

fn truncated(ws: Workspace, _gone: Cell<bool>) {
    let _ = ws.host.write("/w/src/main.av", "")
}

fn removed(_ws: Workspace, gone: Cell<bool>) { gone.set(true) }

spec "compiler/input_host" {
    given "nothing there" {
        then "a missing file is absent, and no empty file" {
            let seen = host_of({"/w/a.av": ""}).spared_text("/w/b.av")
            seen.as_text() == null && seen.name().key == "/w/b.av" && seen.name().kind is .Text
        }
        then "an empty file is there, and empty" {
            host_of({"/w/a.av": ""}).spared_text("/w/a.av").as_text() == ""
        }
        then "a missing file and an empty one at one path digest apart, in key and in word" {
            let none: Map<string, string> = {}
            let absent = host_of(none).spared_text("/w/a.av").input().digest
            let empty = host_of({"/w/a.av": ""}).spared_text("/w/a.av").input().digest
            absent.key != empty.key && absent.word != empty.word
        }
    }
    given "a file the host will not give as text" {
        then "octets that are no text are refused by kind, and the host is handed nothing to refuse" {
            let asked: Cell<List<string>> = Cell.new([])
            let seen = refusing(Beneath.NotText(3), asked).spared_text("/w/a.av")
            seen.as_text() == null &&
                seen.input().digest.key == refused_key("not text") &&
                asked.get().is_empty()
        }
        then "a refusal in the host's own words is refused by kind, never by those words" {
            let asked: Cell<List<string>> = Cell.new([])
            let one = refusing(Beneath.Refused("permission denied (os error 13)"), asked)
                .spared_text("/w/a.av")
            let other = refusing(Beneath.Refused("EACCES"), asked).spared_text("/w/a.av")
            one.input().digest.key == other.input().digest.key &&
                one.input().digest.key == refused_key("refused") &&
                asked.get().is_empty()
        }
        then "a refused file and a missing one digest apart" {
            let asked: Cell<List<string>> = Cell.new([])
            let none: Map<string, string> = {}
            refusing(Beneath.Refused("x"), asked).spared_text("/w/a.av").input().digest.key != host_of(none).spared_text("/w/a.av").input().digest.key
        }
    }
    given "a file that is there" {
        then "its text is what the host reads, under the path it was asked by" {
            let seen = host_of({"/w/a.av": "let a = 1\n"}).spared_text("/w/a.av")
            seen.as_text() == "let a = 1\n" && seen.name().key == "/w/a.av"
        }
        then "two texts at one path digest apart, and one text asked twice does not" {
            let a = key_of(host_of({"/w/a.av": "let a = 1\n"}).spared_text("/w/a.av"))
            let b = key_of(host_of({"/w/a.av": "let a = 2\n"}).spared_text("/w/a.av"))
            a != b && a == key_of(host_of({"/w/a.av": "let a = 1\n"}).spared_text("/w/a.av"))
        }
        then "one text at two paths is two inputs" {
            let fs = {"/w/a.av": "x", "/w/b.av": "x"}
            key_of(host_of(fs).spared_text("/w/a.av")) != key_of(host_of(fs).spared_text("/w/b.av"))
        }
    }
    given "a source loaded through the door" {
        then "a listed file that is not there loads as no text" {
            let ws = test_workspace(
                memory_host({"/w/src/main.av": "1\n"}, ["/w/src/main.av", "/w/src/gone.av"]),
                "/w",
            )
            ws.source(ws.file_id("/w/src/gone.av")).text == ""
        }
        then "a listed file never there — a link to nothing — is handed to the host to refuse, where a disk ends the run" {
            let asked: Cell<List<string>> = Cell.new([])
            let ws = listing_gone(Cell.new(true), asked)
            let _ = ws.source(ws.file_id("/w/src/gone.av"))
            asked.get().contains("/w/src/gone.av")
        }
        then "a listed file removed after its text was read is the text this workspace read — the host is asked nothing more" {
            let asked: Cell<List<string>> = Cell.new([])
            let gone = Cell.new(false)
            let ws = listing_gone(gone, asked)
            let f = ws.file_id("/w/src/gone.av")
            gone.set(true)
            ws.source(f).text == "2\n" && !asked.get().contains("/w/src/gone.av")
        }
        then "a file asked for, not listed, and not there is never read" {
            let asked: Cell<List<string>> = Cell.new([])
            let ws = listing_gone(Cell.new(true), asked)
            ws.host.spared_text("/w/src/gone.av").as_text() == null &&
                !asked.get().contains("/w/src/gone.av")
        }
        then "a file's text is the host's" {
            let ws = test_workspace(host_of({"/w/src/main.av": "let a = 1\na\n"}), "/w")
            ws.source(ws.file_id("/w/src/main.av")).text == "let a = 1\na\n"
        }
    }
    given "a source that turns unreadable in a workspace that lives on" {
        then "read again, it is handed to the host to refuse — never analysed as an empty file in silence" {
            let died: Cell<List<string>> = Cell.new([])
            let turned = Cell.new(false)
            let ws = unreadable("1\n", died, turned)
            let f = ws.file_id("/w/src/main.av")
            let before = ws.source(f).text
            turned.set(true)
            let unasked = died.get().is_empty()
            let _ = ws.world_moved()
            let _ = ws.source(f)
            before == "1\n" && unasked && died.get().contains("/w/src/main.av")
        }
    }
    given "a proof's after-program, over one file overlaid with new text" {
        then "it reads the overlaid text where the original reads its own" {
            let ws = test_workspace(host_of({"/w/src/main.av": "1\n"}), "/w")
            let after = ws.program("/w/src/main.av").after_program("/w/src/main.av", "2\n")
            after.ws.source(after.ws.file_id("/w/src/main.av")).text == "2\n" &&
                ws.source(ws.file_id("/w/src/main.av")).text == "1\n"
        }
        then "every other file is read as the original's host reads it" {
            let ws = test_workspace(
                host_of({"/w/src/main.av": "1\n", "/w/src/other.av": "3\n"}),
                "/w",
            )
            let after = ws.program("/w/src/main.av").after_program("/w/src/main.av", "2\n")
            after.ws.source(after.ws.file_id("/w/src/other.av")).text == "3\n"
        }
    }
    given "a finding's source line, over what the file holds now" {
        then "an unchanged file names the line the parse read" {
            named_line("mut a = 0\na\n", untouched) == "mut a = 0"
        }
        then "an edited file names its current line" {
            named_line("mut a = 0\na\n", renamed) == "mut b = 0"
        }
        then "a file truncated to empty names an empty line — never the parse's old one" {
            named_line("mut a = 0\na\n", truncated) == ""
        }
        then "a file that became unreadable keeps the line the parse read, and the host is handed nothing to refuse" {
            let died: Cell<List<string>> = Cell.new([])
            let turned = Cell.new(false)
            let ws = unreadable("mut a = 0\na\n", died, turned)
            let p = ws.program("/w/src/main.av")
            turned.set(true)
            findings_of(p).find(it.rule == "let_stmt.unmutated_mut")?.text == "mut a = 0" &&
                died.get().is_empty()
        }
        then "a file that is gone keeps the line the parse read" {
            named_line("mut a = 0\na\n", removed) == "mut a = 0"
        }
    }
}
