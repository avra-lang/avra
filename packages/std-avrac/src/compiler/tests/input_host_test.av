// A file read through the door: what the host's two questions make of
// a file that is there, empty, missing, or gone between them — and what
// a source and a finding make of each.
use compiler.{avra, new_workspace, findings_of, Workspace}
use compiler.host.{Host, Read, Beneath, memory_host}

fn host_of(files: Map<string, string>) -> Host {
    memory_host(files, files.keys())
}

/// A host whose file is there for the first `stays` questions and gone
/// after, reading as `text` throughout.
fn vanishing(stays: int, text: string) -> Host {
    let asked = Cell.new(0)
    let none: Map<string, string> = {}
    memory_host(none, []) with { exists: (p: string) -> {
        asked.set(asked.get() + 1)
        asked.get() <= stays
    }, read: (p: string) -> text }
}

/// A workspace whose host lists `gone.av` beside `main.av`, holds it
/// until `gone` is set, and writes down every path it is asked to read.
fn listing_gone(gone: Cell<bool>, asked: Cell<List<string>>) -> Workspace {
    let base = memory_host(
        {"/w/src/main.av": "1\n", "/w/src/gone.av": "2\n"},
        ["/w/src/main.av", "/w/src/gone.av"],
    )
    new_workspace(
        base with { exists: (p: string) -> (p != "/w/src/gone.av" || !gone.get()) && base.exists(p), read: (p: string) -> {
            asked.push(p)
            if p == "/w/src/gone.av" && gone.get() { "" } else { base.read(p) }
        } },
        "/w",
        avra(),
    )
}

fn key_of(r: Read) -> string { r.input().digest.key }

/// A workspace over one file whose host answers "nothing there" once
/// `gone` is set.
fn leaving(main: string, gone: Cell<bool>) -> Workspace {
    let base = host_of({"/w/src/main.av": main})
    new_workspace(base with { exists: (p: string) -> !gone.get() && base.exists(p) }, "/w", avra())
}

/// The source line the unwritten-`mut` rule names, as the host holds
/// the file after `edit` ran.
fn named_line(main: string, edit: fn(Workspace, Cell<bool>) -> void) -> string? {
    let gone = Cell.new(false)
    let ws = leaving(main, gone)
    let p = ws.program("/w/src/main.av")
    edit(ws, gone)
    findings_of(p).find(it.rule == "let_stmt.unmutated_mut")?.text
}

/// The file can no longer be given as text: `beneath` refuses it, and
/// every later whole-file read is written down in `died`.
fn unreadable(main: string, died: Cell<List<string>>, turned: Cell<bool>) -> Workspace {
    let base = host_of({"/w/src/main.av": main})
    new_workspace(
        base with { beneath: (root: string, rel: string) -> if turned.get() { Beneath.NotText(0) } else { (base.beneath)(root, rel) }, read: (p: string) -> {
            if turned.get() { died.push(p) }
            base.read(p)
        } },
        "/w",
        avra(),
    )
}

fn untouched(_ws: Workspace, _gone: Cell<bool>) {}

fn renamed(ws: Workspace, _gone: Cell<bool>) {
    let _ = ws.host.write("/w/src/main.av", "mut b = 0\nb\n")
}

fn truncated(ws: Workspace, _gone: Cell<bool>) {
    let _ = ws.host.write("/w/src/main.av", "")
}

fn removed(_ws: Workspace, gone: Cell<bool>) { gone.set(true) }

spec "compiler/input_host" {
    given "nothing there" {
        then "a missing file is absent, and no empty file" {
            let seen = host_of({"/w/a.av": ""}).text("/w/b.av")
            seen.as_text() == null && seen.name().key == "/w/b.av" && seen.name().kind is .Text
        }
        then "an empty file is there, and empty" {
            host_of({"/w/a.av": ""}).text("/w/a.av").as_text() == ""
        }
        then "a missing file and an empty one at one path digest apart, in key and in word" {
            let none: Map<string, string> = {}
            let absent = host_of(none).text("/w/a.av").input().digest
            let empty = host_of({"/w/a.av": ""}).text("/w/a.av").input().digest
            absent.key != empty.key && absent.word != empty.word
        }
    }
    given "a file gone between the two questions" {
        then "one that read as nothing is absent, never an empty file" {
            vanishing(1, "").text("/w/a.av").as_text() == null
        }
        then "it digests as the missing file it is" {
            let none: Map<string, string> = {}
            key_of(vanishing(1, "").text("/w/a.av")) == key_of(host_of(none).text("/w/a.av"))
        }
        then "one whose text was read before it went is what was read" {
            vanishing(1, "let a = 1\n").text("/w/a.av").as_text() == "let a = 1\n"
        }
        then "an empty file that stays is empty" {
            vanishing(2, "").text("/w/a.av").as_text() == ""
        }
        then "a file never there is not read at all" {
            vanishing(0, "never").text("/w/a.av").as_text() == null
        }
    }
    given "a file that is there" {
        then "its text is what the host reads, under the path it was asked by" {
            let seen = host_of({"/w/a.av": "let a = 1\n"}).text("/w/a.av")
            seen.as_text() == "let a = 1\n" && seen.name().key == "/w/a.av"
        }
        then "two texts at one path digest apart, and one text asked twice does not" {
            let a = key_of(host_of({"/w/a.av": "let a = 1\n"}).text("/w/a.av"))
            let b = key_of(host_of({"/w/a.av": "let a = 2\n"}).text("/w/a.av"))
            a != b && a == key_of(host_of({"/w/a.av": "let a = 1\n"}).text("/w/a.av"))
        }
        then "one text at two paths is two inputs" {
            let fs = {"/w/a.av": "x", "/w/b.av": "x"}
            key_of(host_of(fs).text("/w/a.av")) != key_of(host_of(fs).text("/w/b.av"))
        }
    }
    given "a source loaded through the door" {
        then "a listed file that is not there loads as no text" {
            let ws = new_workspace(
                memory_host({"/w/src/main.av": "1\n"}, ["/w/src/main.av", "/w/src/gone.av"]),
                "/w",
                avra(),
            )
            ws.source(ws.file_id("/w/src/gone.av")).text == ""
        }
        then "a listed file never there — a link to nothing — is handed to the host's read, where a disk refuses" {
            let asked: Cell<List<string>> = Cell.new([])
            let ws = listing_gone(Cell.new(true), asked)
            let _ = ws.source(ws.file_id("/w/src/gone.av"))
            asked.get().contains("/w/src/gone.av")
        }
        then "a listed file removed after it was listed is handed to the host's read" {
            let asked: Cell<List<string>> = Cell.new([])
            let gone = Cell.new(false)
            let ws = listing_gone(gone, asked)
            let f = ws.file_id("/w/src/gone.av")
            gone.set(true)
            let _ = ws.source(f)
            asked.get().contains("/w/src/gone.av")
        }
        then "a file asked for, not listed, and not there is never read" {
            let asked: Cell<List<string>> = Cell.new([])
            let ws = listing_gone(Cell.new(true), asked)
            ws.host.text("/w/src/gone.av").as_text() == null &&
                !asked.get().contains("/w/src/gone.av")
        }
        then "a file's text is the host's" {
            let ws = new_workspace(host_of({"/w/src/main.av": "let a = 1\na\n"}), "/w", avra())
            ws.source(ws.file_id("/w/src/main.av")).text == "let a = 1\na\n"
        }
    }
    given "a finding's source line, over what the file holds now" {
        then "an unchanged file names the line the parse read" {
            named_line("mut a = 0\na\n", untouched) == "mut a = 0"
        }
        then "an edited file names its current line" {
            named_line("mut a = 0\na\n", renamed) == "mut b = 0"
        }
        then "a file truncated to empty names an empty line — never the parse's old one" {
            named_line("mut a = 0\na\n", truncated) == ""
        }
        then "a file that became unreadable keeps the line the parse read, and no read that ends the run is asked" {
            let died: Cell<List<string>> = Cell.new([])
            let turned = Cell.new(false)
            let ws = unreadable("mut a = 0\na\n", died, turned)
            let p = ws.program("/w/src/main.av")
            turned.set(true)
            findings_of(p).find(it.rule == "let_stmt.unmutated_mut")?.text == "mut a = 0" &&
                died.get().is_empty()
        }
        then "a file that is gone keeps the line the parse read" {
            named_line("mut a = 0\na\n", removed) == "mut a = 0"
        }
    }
}
