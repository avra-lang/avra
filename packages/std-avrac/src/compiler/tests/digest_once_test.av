// A file's key is the one its decoded text gave before the bytes were
// hashed once: the same length, a dot, then BLAKE3 of the same octets.
use core.{digest_of, digest_of_octets}

spec "compiler/tests — a file's digest is unchanged by hashing its octets" {
    given "a file's text, ASCII and multi-byte" {
        then "the octets' digest with the length prefix equals the text's" {
            let ascii = "fn main() -> int { 1 }\n"
            let wide = "// café — 名前\nfn main() -> int { 2 }\n"
            "${ascii.length}.${digest_of_octets(ascii.bytes())}" == "${ascii.length}.${digest_of(ascii)}" &&
                "${wide.length}.${digest_of_octets(wide.bytes())}" == "${wide.length}.${digest_of(wide)}"
        }
    }
}
