//! The collected `Family`: the markers in compiler/families are its
//! variant set, gathered BY NAME (`it.name`), so a family is keyed by
//! its name and declaration order is free.
use compiler.families.{Family}

spec "family declarations reflect as a collected enum" {
    given "the declared families" {
        then "are minted as variants in name order" {
            [f.name for f in Family.all()].join(",") == "Admitted,Analysis,BlockScan,CancelReach,ComponentNames,ComponentScan,ConstTyped,DeclReads,Expanded,Failures,Folded,HeldSig,Input,Items,LiftLowered,Lifted,Lowered,Manifest,Marks,MethodDiags,Methods,Named,Names,Namespace,Parsed,Plain,Raised,ReadReach,Receivers,References,Resolved,Settled,Sig,Source,Syntax,Typed,Visible"
        }
        then "each answers the word it was declared with" {
            Family.all().length == 37 &&
                Family.Source.name == "Source" &&
                Family.Input.name == "Input" &&
                Family.CancelReach.name == "CancelReach"
        }
    }
}
