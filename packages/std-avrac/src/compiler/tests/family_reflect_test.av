//! The internal family mark + `collect enum`: the families declared in
//! compiler/families are gathered BY NAME, so `Family` can be minted
//! from declarations instead of the hand-kept enum (workspace.av). The
//! hand enum stays authoritative until every family is declared.
use compiler.families.{FamilyProbe}

spec "family declarations reflect as a collected enum" {
    given "the declared families (FileId-keyed group)" {
        then "are minted as variants in name order" {
            FamilyProbe.Analysis.ordinal == 0 &&
                FamilyProbe.Parsed.ordinal == 5 &&
                FamilyProbe.Source.ordinal == 8 &&
                FamilyProbe.Syntax.ordinal == 9 &&
                FamilyProbe.Visible.ordinal == 10
        }
    }
}
