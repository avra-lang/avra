//! The internal family mark + `collect enum`: the families declared in
//! compiler/families are gathered BY NAME, so `Family` can be minted
//! from declarations instead of the hand-kept enum (workspace.av). The
//! hand enum stays authoritative until .12.4 flips to this collect.
use compiler.families.{FamilyProbe}

spec "family declarations reflect as a collected enum" {
    given "all 28 declared families" {
        then "are minted as variants in name order" {
            FamilyProbe.Analysis.ordinal == 0 &&
                FamilyProbe.ConstTyped.ordinal == 1 &&
                FamilyProbe.Expanded.ordinal == 2 &&
                FamilyProbe.Failures.ordinal == 3 &&
                FamilyProbe.Folded.ordinal == 4 &&
                FamilyProbe.HeldSig.ordinal == 5 &&
                FamilyProbe.Items.ordinal == 6 &&
                FamilyProbe.LiftLowered.ordinal == 7 &&
                FamilyProbe.Lifted.ordinal == 8 &&
                FamilyProbe.Lowered.ordinal == 9 &&
                FamilyProbe.Manifest.ordinal == 10 &&
                FamilyProbe.Marks.ordinal == 11 &&
                FamilyProbe.MethodDiags.ordinal == 12 &&
                FamilyProbe.Methods.ordinal == 13 &&
                FamilyProbe.Names.ordinal == 14 &&
                FamilyProbe.Namespace.ordinal == 15 &&
                FamilyProbe.Parsed.ordinal == 16 &&
                FamilyProbe.Plain.ordinal == 17 &&
                FamilyProbe.Raised.ordinal == 18 &&
                FamilyProbe.Receivers.ordinal == 19 &&
                FamilyProbe.References.ordinal == 20 &&
                FamilyProbe.Resolved.ordinal == 21 &&
                FamilyProbe.Settled.ordinal == 22 &&
                FamilyProbe.Sig.ordinal == 23 &&
                FamilyProbe.Source.ordinal == 24 &&
                FamilyProbe.Syntax.ordinal == 25 &&
                FamilyProbe.Typed.ordinal == 26 &&
                FamilyProbe.Visible.ordinal == 27
        }
    }
}
