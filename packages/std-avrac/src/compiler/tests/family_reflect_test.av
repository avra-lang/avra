//! The internal family mark + `collect enum`: the families declared in
//! compiler/families are gathered BY NAME, so `Family` can be minted
//! from declarations instead of the hand-kept enum (workspace.av). The
//! hand enum stays authoritative until every family is declared.
use compiler.families.{FamilyProbe}

spec "family declarations reflect as a collected enum" {
    given "the declared families (FileId-keyed group)" {
        then "are minted as variants in name order" {
            FamilyProbe.Analysis.ordinal == 0 &&
                FamilyProbe.ConstTyped.ordinal == 1 &&
                FamilyProbe.Expanded.ordinal == 2 &&
                FamilyProbe.Folded.ordinal == 3 &&
                FamilyProbe.Items.ordinal == 4 &&
                FamilyProbe.Lifted.ordinal == 5 &&
                FamilyProbe.Lowered.ordinal == 6 &&
                FamilyProbe.Manifest.ordinal == 7 &&
                FamilyProbe.Namespace.ordinal == 8 &&
                FamilyProbe.Parsed.ordinal == 9 &&
                FamilyProbe.Plain.ordinal == 10 &&
                FamilyProbe.Resolved.ordinal == 11 &&
                FamilyProbe.Settled.ordinal == 12 &&
                FamilyProbe.Source.ordinal == 13 &&
                FamilyProbe.Syntax.ordinal == 14 &&
                FamilyProbe.Typed.ordinal == 15 &&
                FamilyProbe.Visible.ordinal == 16
        }
    }
}
