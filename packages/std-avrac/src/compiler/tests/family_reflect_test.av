//! The collected `Family`: the markers in compiler/families are its
//! variant set, gathered BY RANK (`it.mark.args[0] dense`), so a family
//! is APPENDED — it takes the next rank — and the earlier ordinals do
//! not move.
use compiler.families.{Family}

spec "family declarations reflect as a collected enum" {
    given "all 30 declared families" {
        then "are minted as variants in rank order" {
            Family.Source.ordinal == 0 &&
                Family.Parsed.ordinal == 1 &&
                Family.Items.ordinal == 2 &&
                Family.Namespace.ordinal == 3 &&
                Family.Visible.ordinal == 4 &&
                Family.Resolved.ordinal == 5 &&
                Family.Sig.ordinal == 6 &&
                Family.Methods.ordinal == 7 &&
                Family.Typed.ordinal == 8 &&
                Family.ConstTyped.ordinal == 9 &&
                Family.Folded.ordinal == 10 &&
                Family.Analysis.ordinal == 11 &&
                Family.Settled.ordinal == 12 &&
                Family.Lowered.ordinal == 13 &&
                Family.Lifted.ordinal == 14 &&
                Family.Manifest.ordinal == 15 &&
                Family.Receivers.ordinal == 16 &&
                Family.Expanded.ordinal == 17 &&
                Family.Plain.ordinal == 18 &&
                Family.References.ordinal == 19 &&
                Family.Failures.ordinal == 20 &&
                Family.HeldSig.ordinal == 21 &&
                Family.Raised.ordinal == 22 &&
                Family.MethodDiags.ordinal == 23 &&
                Family.LiftLowered.ordinal == 24 &&
                Family.Syntax.ordinal == 25 &&
                Family.Names.ordinal == 26 &&
                Family.Marks.ordinal == 27 &&
                Family.Admitted.ordinal == 28 &&
                Family.Named.ordinal == 29
        }
        then "each answers the word it was declared with, in rank order" {
            [f.name for f in Family.all()].join(",") == "Source,Parsed,Items,Namespace,Visible,Resolved,Sig,Methods,Typed,ConstTyped,Folded,Analysis,Settled,Lowered,Lifted,Manifest,Receivers,Expanded,Plain,References,Failures,HeldSig,Raised,MethodDiags,LiftLowered,Syntax,Names,Marks,Admitted,Named,ReadReach,DeclReads"
        }
    }
}
