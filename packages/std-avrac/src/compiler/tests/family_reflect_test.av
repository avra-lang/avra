//! The internal family mark + `collect enum`: three families declared
//! in compiler/families are gathered BY NAME, so `Family` can be minted
//! from declarations instead of the hand-kept enum (workspace.av). The
//! hand enum stays authoritative until every family is declared.
use compiler.families.{FamilyProbe}

spec "family declarations reflect as a collected enum" {
    given "the three declared families (Source, Manifest, Syntax)" {
        then "are minted as variants in name order" {
            FamilyProbe.Manifest.ordinal == 0 &&
                FamilyProbe.Source.ordinal == 1 &&
                FamilyProbe.Syntax.ordinal == 2
        }
    }
}
