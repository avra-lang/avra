//! The collected `Family`: the markers in compiler/families are its
//! variant set, gathered BY NAME (`it.name`), so a family is keyed by
//! its name and declaration order is free.
use compiler.families.{Family}

spec "family declarations reflect as a collected enum" {
    given "the declared families" {
        then "are minted as variants in name order" {
            [f.name for f in Family.all()].join(",") == "Admitted,Analysis,CancelBits,CancelSummary,ConstTyped,Consumed,DeclReads,Expanded,Failures,FileRefs,Folded,HeldSig,Input,Items,LiftLowered,Lifted,Lowered,Marks,MethodDiags,Methods,Named,Names,Namespace,Parsed,Placed,Plain,Raised,ReadFound,ReadReach,References,Resolved,Settled,Sig,Syntax,Typed,Visible,WriteSummary,Writes"
        }
        then "each answers the word it was declared with" {
            Family.all().length == 38 &&
                Family.Parsed.name == "Parsed" &&
                Family.Input.name == "Input" &&
                Family.CancelSummary.name == "CancelSummary"
        }
    }
}
