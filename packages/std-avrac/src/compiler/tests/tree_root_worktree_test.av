// A git WORKTREE's `.git` is a FILE, not a directory. `tree_root` stops at
// the NEAREST ancestor carrying a `.git`, worktree or clone alike — never
// climbs past it looking for a directory `.git`, and never lets a HIGHER
// `avra.toml` outrank it. `avra.toml` only decides the root when no `.git`
// stands anywhere above: the fallback for a tree with no git history yet.
use @std.avrac.testing.{test_workspace}
use @std.avrac.compiler.{build_cache_root}
use compiler.host.{memory_host}

spec "compiler/build — tree_root's checkout boundary" {
    given "a worktree nested under a checkout, `.git` and `avra.toml` at both levels" {
        then "the NEAREST `.git` wins — the worktree owns its own store, not the checkout above it" {
            let ws = test_workspace(
                memory_host(
                    {
                        "/root/.git": "",
                        "/root/avra.toml": "[package]\nname = \"root\"\nversion = \"0.1.0\"\n",
                        "/root/wt/.git": "gitdir: /root/.git/worktrees/wt\n",
                        "/root/wt/avra.toml": "[package]\nname = \"wt\"\nversion = \"0.1.0\"\n",
                        "/root/wt/pkg/avra.toml": "[package]\nname = \"pkg\"\nversion = \"0.1.0\"\n",
                        "/root/wt/pkg/src/main.av": "fn a() { 1 }\n",
                    },
                    ["/root/wt/pkg/avra.toml", "/root/wt/pkg/src/main.av"],
                ),
                "/root/wt/pkg",
            )
            build_cache_root(ws).starts_with("/root/wt/.avra-cache")
        }
    }
    given "a package subdirectory under a plain checkout" {
        then "the checkout's `.git` is the root" {
            let ws = test_workspace(
                memory_host(
                    {
                        "/checkout/.git": "",
                        "/checkout/pkg/avra.toml": "[package]\nname = \"pkg\"\nversion = \"0.1.0\"\n",
                        "/checkout/pkg/src/main.av": "fn a() { 1 }\n",
                    },
                    ["/checkout/pkg/avra.toml", "/checkout/pkg/src/main.av"],
                ),
                "/checkout/pkg",
            )
            build_cache_root(ws).starts_with("/checkout/.avra-cache")
        }
    }
    given "no `.git` anywhere in the ancestry" {
        then "the HIGHEST `avra.toml` is the root" {
            let ws = test_workspace(
                memory_host(
                    {
                        "/top/avra.toml": "[package]\nname = \"top\"\nversion = \"0.1.0\"\n",
                        "/top/mid/avra.toml": "[package]\nname = \"mid\"\nversion = \"0.1.0\"\n",
                        "/top/mid/pkg/avra.toml": "[package]\nname = \"pkg\"\nversion = \"0.1.0\"\n",
                        "/top/mid/pkg/src/main.av": "fn a() { 1 }\n",
                    },
                    ["/top/mid/pkg/avra.toml", "/top/mid/pkg/src/main.av"],
                ),
                "/top/mid/pkg",
            )
            build_cache_root(ws).starts_with("/top/.avra-cache")
        }
    }
}
