// `Family.Analysis` witnessing, red-teamed: cycles, degenerate
// shapes, and a file that starts broken — grouped by attack class,
// one `given` per class. `dir`, `fresh_pack_path`, `package_names`,
// `a_process`, `checked` and `all_reused` are `witness_test.av`'s
// own: this module shares one namespace, so its fixtures serve here
// too.

spec "compiler/witness, red-teamed" {
    given "two files that call each other" {
        then "no infinite loop in leaf_keys, and both stay reused once warm" {
            let files: Map<string, string> = {
                "/w/src/x.av": "export fn even(n: int) -> bool {\n    if n == 0 { true } else { odd(n - 1) }\n}\n",
                "/w/src/y.av": "export fn odd(n: int) -> bool {\n    if n == 0 { false } else { even(n - 1) }\n}\n",
            }
            let names = ["/w/src/x.av", "/w/src/y.av"]
            let path = fresh_pack_path("mutual_recursion")
            let first = a_process_over(files, names, path)
            let outs1 = [checked(first, p) for p in names]
            let second = a_process_over(files, names, path)
            let outs2 = [checked(second, p) for p in names]
            !all_reused(outs1) && all_clean(outs1) && all_reused(outs2) && all_clean(outs2)
        }
    }
    given "a file with no declarations at all" {
        then "it checks clean, empty, and reuses warm the same as any other file" {
            let files: Map<string, string> = {"/w/src/empty.av": ""}
            let names = ["/w/src/empty.av"]
            let path = fresh_pack_path("empty_file")
            let first = a_process_over(files, names, path)
            let cold = checked(first, "/w/src/empty.av")
            let second = a_process_over(files, names, path)
            let warm = checked(second, "/w/src/empty.av")
            !cold.reused() && cold.value().clean && warm.reused() && warm.value().clean
        }
    }
    given "a file with a parse error, fixed on the next process" {
        then "the broken run is not clean and not reused; the fixed run recomputes fresh and is clean" {
            let names = ["/w/src/broken.av"]
            let path = fresh_pack_path("fixed_after_broken")
            let broken: Map<string, string> = {
                "/w/src/broken.av": "export fn f( -> int {\n    1\n}\n",
            }
            let first = a_process_over(broken, names, path)
            let was_broken = checked(first, "/w/src/broken.av")
            let fixed: Map<string, string> = {
                "/w/src/broken.av": "export fn f() -> int {\n    1\n}\n",
            }
            let second = a_process_over(fixed, names, path)
            let now_fixed = checked(second, "/w/src/broken.av")
            !was_broken.reused() &&
                !was_broken.value().clean &&
                !now_fixed.reused() &&
                now_fixed.value().clean
        }
    }
}
