// proves: a place opens its box only while another holder counts it, so
// a write lands where the runtime puts it
type Doc = { lines: List<string>, tags: List<int> }

fn appended(mut d: Doc, s: string) {
    d.lines.push(s)
    d.tags.push(d.lines.length)
}

fn shown() -> string {
    mut d = Doc { lines: ["a"], tags: [1] }
    let before = d
    let view = d.lines
    appended(d, "b")
    mut e = d
    e.lines.push("c")
    mut grid = [[1, 2], [3]]
    let row = grid[0]
    grid[0].push(5)
    mut copy = grid
    copy[1].push(6)
    mut t = 0
    for i in 0..300 {
        mut g = grid
        g[0].push(i)
        appended(d, "x")
        t = t + g[0].length
    }
    "${before.lines.length} ${view.length} ${d.lines.length} ${e.lines.length} ${row.length} ${grid[0].length} ${grid[1].length} ${copy[1].length} ${t}"
}

shown()
