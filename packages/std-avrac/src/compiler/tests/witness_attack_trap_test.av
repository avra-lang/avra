// A manifest edge whose package ordinal no longer exists. Its own file: a trap ends the
// whole test binary, so it must not share one with cases that still have to report.
use query.{Key}

spec "compiler/witness, attacked: an unresolvable manifest edge" {
    then "c-Manifest: an ordinal past the packages answers unresolved, never traps" {
        let ws = a_process(package_files(), fresh_pack_path("catk_manifest_oob"))
        ws.edge_current_hash(ws.decls.stable_key_name(Key { family: 15, arg: 7 })) == null
    }
}
