// A use reads the DECLARATION it names, never its file's parse (COMPILER
// DB townhall §6.11). Two workspaces over one package, `src/lib/a.av`
// edited in the second, stand in for one process before and after the
// edit: every query `src/main.av` asks that another file answers is the
// FRONTIER, and a frontier that fingerprints alike means red-green keeps
// every one of main's queries. `a_process_over` and `checked` are
// workspace_fixtures.av's own.
use @std.avrac.testing.{test_workspace}
use @std.avrac.testing.{vendored_meta, vendored_meta_paths}
use compiler.{Workspace, type_facts_fp}
use compiler.host.{memory_host}
use core.{sorted_texts, distinct}
use @std.relation.engine.{Key}

fn grain_main() -> string { "/w/src/main.av" }

fn grain_lib() -> string { "/w/src/lib/a.av" }

/// `caller` names a fn, a record and its method, a trait through a box,
/// an enum, a const, a defaulted seat and a generic fn — all from `a.av`.
fn grain_caller() -> string {
    "use lib.{one, Box, Color, LIMIT, dflt, ident, Shape}\nexport fn caller() -> int {\n    let b = Box { v: 1 }\n    let c = Color.Red\n    let s: dyn Shape = b\n    one() + b.get() + LIMIT + dflt(1) + ident(2) + s.area()\n}\n"
}

/// `a.av` with `one`'s head, `one`'s body and `two`'s body as given;
/// `two` is a declaration `caller` never names.
fn grain_lib_text(note: string, one_head: string, one_body: string, two_body: string) -> string {
    "${note}export type Box = { v: int }\nimpl Box {\n    fn get() -> int {\n        self.v\n    }\n}\nexport trait Shape {\n    fn area() -> int\n}\nimpl Shape for Box {\n    fn area() -> int {\n        self.v\n    }\n}\nexport enum Color { Red, Green }\nexport const LIMIT: int = 3\nexport fn ${one_head} -> int {\n    ${one_body}\n}\nexport fn two() -> int {\n    ${two_body}\n}\nexport fn dflt(a: int, n: int = 1) -> int {\n    a + n\n}\nexport fn ident<T>(x: T) -> T {\n    x\n}\n"
}

fn grain_base() -> string { grain_lib_text("", "one()", "1", "2") }

/// What a checked package answers, read out while its workspace stands:
/// main's frontier, the whole-file reads among it, its report, `caller`'s
/// typed facts and whether main is clean.
type GrainSeen = { frontier: List<string>, whole: List<string>, report: string, facts: int, clean: bool }

fn grain_seen(ws: Workspace) -> GrainSeen {
    let main = ws.analysis(ws.file_id(grain_main()))
    GrainSeen {
        frontier: grain_frontier(ws),
        whole: grain_whole_reads(ws),
        report: main.report(),
        facts: type_facts_fp(ws.typed(decl_in_file(ws, grain_main(), "caller"))),
        clean: main.clean(),
    }
}

/// The package checked once, `main.av` first.
fn grain_checked(lib: string) -> GrainSeen {
    let ws = a_process_over(
        {"/w/src/main.av": grain_caller(), "/w/src/lib/a.av": lib},
        [grain_main(), grain_lib()],
    )
    let _ = checked(ws, grain_main())
    grain_seen(ws)
}

/// The package with a second file in `a.av`'s module, checked once.
fn grain_beside(sibling: string) -> GrainSeen {
    let ws = a_process_over(
        {
            "/w/src/main.av": grain_caller(),
            "/w/src/lib/a.av": grain_base(),
            "/w/src/lib/b.av": sibling,
        },
        [grain_main(), grain_lib(), "/w/src/lib/b.av"],
    )
    let _ = checked(ws, grain_main())
    grain_seen(ws)
}

/// `a.av` with one more declaration at its end.
fn grain_grown(extra: string) -> string { grain_base() + extra }

/// `a.av` with one declaration's name changed.
fn grain_renamed(from: string, to: string) -> string { grain_base().replace("fn ${from}()", "fn ${to}()") }

/// `caller` reads a deprecated fn; the note is the only thing it varies.
fn marked_checked(lead: string, note: string) -> GrainSeen {
    let files = vendored_meta(
        {
            "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@std/meta\" = { path = \"vendor/meta\" }\n",
            "/w/src/main.av": "use lib.{old}\nexport fn caller() -> int {\n    old()\n}\n",
            "/w/src/lib/a.av": "${lead}use @std.meta.{deprecated}\n@deprecated(\"${note}\")\nexport fn old() -> int {\n    1\n}\n",
        },
    )
    let ws = test_workspace(
        memory_host(
            files,
            ["/w/avra.toml", grain_main(), grain_lib()].concat(vendored_meta_paths()),
        ),
        "/w",
    )
    for path in [grain_main(), grain_lib()] { let _ = ws.items(ws.file_id(path)) }
    let _ = checked(ws, grain_main())
    grain_seen(ws)
}

fn grain_is_main(ws: Workspace, k: Key) -> bool { ws.key_label(k).contains("src/main.av") }

/// A query another file answers: neither `main.av`'s nor the language's own.
fn grain_is_foreign(ws: Workspace, k: Key) -> bool {
    let label = ws.key_label(k)
    !label.contains("src/main.av") && !label.contains("· builtin")
}

/// Every edge from one of main's queries to a query another file answers.
fn grain_crossings(ws: Workspace) -> List<Key> {
    [d for cells in ws.db.cells_by_family() for c in cells if grain_is_main(ws, c.key) for d in ws.db.edges_by_reader(c.key) if grain_is_foreign(ws, d)]
}

/// The frontier as `label=hash`, an unknown hash as -1.
fn grain_frontier(ws: Workspace) -> List<string> {
    sorted_texts(
        distinct(
            ["${ws.key_label(d)}=${ws.db.value_hash_of(d) ?? -1}" for d in grain_crossings(ws)],
        ),
    )
}

/// A query `main.av` asks that reads `a.av` whole.
fn grain_reads_whole(ws: Workspace, k: Key) -> bool {
    let label = ws.key_label(k)
    ["Parsed", "Plain", "Expanded", "Visible", "Resolved"]
        .any((w: string) -> label == "${w}(src/lib/a.av)")
}

fn grain_whole_reads(ws: Workspace) -> List<string> {
    distinct([ws.key_label(d) for d in grain_crossings(ws) if grain_reads_whole(ws, d)])
}

fn grain_unknown(entry: string) -> bool { entry.ends_with("=-1") }

/// Every frontier hash known, and the two frontiers alike: red-green keeps main.
fn grain_kept(before: GrainSeen, after: GrainSeen) -> bool {
    !before.frontier.any(grain_unknown) && before.frontier.join(";") == after.frontier.join(";")
}

/// What main answers, its diagnostics and `caller`'s typed facts, alike in both.
fn grain_same_answer(before: GrainSeen, after: GrainSeen) -> bool {
    before.report == after.report && before.facts == after.facts
}

spec "compiler/workspace — a use reads the declaration, never its file" {
    given "a caller naming eight kinds of declaration from another file" {
        then "no query of main's reads that file's parse, resolve or namespace" {
            grain_checked(grain_base()).whole.is_empty()
        }
        then "every query it does read there fingerprints eagerly" {
            let f = grain_checked(grain_base()).frontier
            !f.is_empty() && !f.any(grain_unknown)
        }
    }
    given "the other file edited where the caller cannot see" {
        then "a comment above and inside `one` keeps every query of main's, answering alike" {
            let before = grain_checked(grain_base())
            let after = grain_checked(
                grain_lib_text("// a note\n", "one()", "// inside\n    1", "2"),
            )
            grain_kept(before, after) && grain_same_answer(before, after)
        }
        then "a new body for `one` keeps them" {
            let before = grain_checked(grain_base())
            let after = grain_checked(grain_lib_text("", "one()", "0 + 1", "2"))
            grain_kept(before, after) && grain_same_answer(before, after)
        }
        then "a new body for `two`, which the caller never names, keeps them" {
            let before = grain_checked(grain_base())
            let after = grain_checked(grain_lib_text("", "one()", "1", "0 + 2"))
            grain_kept(before, after) && grain_same_answer(before, after)
        }
    }
    given "the other file edited where the caller reads" {
        then "a new signature for `one` moves the frontier" {
            !grain_kept(
                grain_checked(grain_base()),
                grain_checked(grain_lib_text("", "one(n: int = 0)", "n", "2")),
            )
        }
    }
    given "the other file's declarations added or renamed where the caller does not read" {
        then "a declaration added keeps every query of main's, answering alike" {
            let before = grain_checked(grain_base())
            let after = grain_checked(grain_grown("export fn three() -> int {\n    3\n}\n"))
            grain_kept(before, after) && grain_same_answer(before, after)
        }
        then "`two`, which the caller never names, renamed keeps them" {
            let before = grain_checked(grain_base())
            let after = grain_checked(grain_renamed("two", "deux"))
            grain_kept(before, after) && grain_same_answer(before, after)
        }
    }
    given "the other file's declarations added or renamed where the caller reads" {
        then "`one` renamed moves the frontier, and main is refused" {
            let after = grain_checked(grain_renamed("one", "uno"))
            !grain_kept(grain_checked(grain_base()), after) && !after.clean
        }
        then "a method `one` beside the fn `one` moves it" {
            !grain_kept(
                grain_checked(grain_base()),
                grain_checked(
                    grain_grown("impl Box {\n    fn one() -> int {\n        2\n    }\n}\n"),
                ),
            )
        }
        then "a second `one` in `a.av`'s module moves it" {
            !grain_kept(
                grain_beside("export fn other() -> int {\n    4\n}\n"),
                grain_beside("export fn one() -> int {\n    4\n}\n"),
            )
        }
    }
    given "a caller of a deprecated fn in another file" {
        then "no query of main's reads that file's parse, resolve or namespace" {
            marked_checked("", "use one").whole.is_empty()
        }
        then "a comment above it keeps every query of main's, answering alike" {
            let before = marked_checked("", "use one")
            let after = marked_checked("// a note\n", "use one")
            grain_kept(before, after) && grain_same_answer(before, after)
        }
        then "a new note moves the frontier, and the warning says it" {
            let after = marked_checked("", "use two")
            !grain_kept(marked_checked("", "use one"), after) && after.report.contains("use two")
        }
    }
}
