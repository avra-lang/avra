// A use reads the DECLARATION it names, never its file. One process judges a package over a
// store; `src/lib/a.av` is edited; a second process judges it over the same store. What the
// second works out for `main.av` — past what the same edit costs a package whose main names
// nothing of the library — is main's share of the edit: none where the caller cannot see the
// edit, some where it reads what moved.
use @std.avrac.testing.held.{Held, empty_store, held_at}
use @std.avrac.testing.{vendored_meta}

fn grain_main() -> string { "/w/src/main.av" }

fn grain_lib() -> string { "/w/src/lib/a.av" }

/// `caller` names a fn, a record and its method, a trait through a box,
/// an enum, a const, a defaulted seat and a generic fn — all from `a.av`.
fn grain_caller() -> string {
    "use lib.{one, Box, Color, LIMIT, dflt, ident, Shape}\nexport fn caller() -> int {\n    let b = Box { v: 1 }\n    let c = Color.Red\n    let s: dyn Shape = b\n    one() + b.get() + LIMIT + dflt(1) + ident(2) + s.area()\n}\n"
}

/// `a.av` with `one`'s head, `one`'s body and `two`'s body as given;
/// `two` is a declaration `caller` never names.
fn grain_lib_text(note: string, one_head: string, one_body: string, two_body: string) -> string {
    "${note}export type Box = { v: int }\nimpl Box {\n    fn get() -> int {\n        self.v\n    }\n}\nexport trait Shape {\n    fn area() -> int\n}\nimpl Shape for Box {\n    fn area() -> int {\n        self.v\n    }\n}\nexport enum Color { Red, Green }\nexport const LIMIT: int = 3\nexport fn ${one_head} -> int {\n    ${one_body}\n}\nexport fn two() -> int {\n    ${two_body}\n}\nexport fn dflt(a: int, n: int = 1) -> int {\n    a + n\n}\nexport fn ident<T>(x: T) -> T {\n    x\n}\n"
}

fn grain_base() -> string { grain_lib_text("", "one()", "1", "2") }

/// `a.av` with one more declaration at its end.
fn grain_grown(extra: string) -> string { grain_base() + extra }

/// `a.av` with one declaration's name changed.
fn grain_renamed(from: string, to: string) -> string { grain_base().replace("fn ${from}()", "fn ${to}()") }

/// A main that names nothing of the library.
const BYSTANDER: string = "export fn caller() -> int {\n    1\n}\n"

const APP: string = "[package]\nname = \"app\"\nversion = \"0.1.0\"\n"

/// The package: `main` beside the library file, and a sibling in the library's module where given.
fn grain_package(main: string, lib: string, sibling: string?) -> Held {
    mut files = {"/w/avra.toml": APP, "/w/src/main.av": main, "/w/src/lib/a.av": lib}
    if sibling != null { files.set("/w/src/lib/b.av", sibling!) }
    held_at(files, "/w")
}

/// What a second process works out judging `main` after the library goes from `before` to
/// `after`, over the store the first left.
fn reworked(main: string, before: string, after: string, sibling: string?, sibling_after: string?) -> List<
    string,
> {
    let store = empty_store()
    let _ = grain_package(main, before, sibling).worked_judging(grain_main(), store)
    grain_package(main, after, sibling_after).worked_judging(grain_main(), store)
}

/// `all` with one of each name in `less` taken away.
fn beyond(all: List<string>, less: List<string>) -> List<string> {
    mut rest = less
    mut out: List<string> = []
    for name in all {
        let at = rest.index_of(name)
        if at < 0 { out.push(name) } else { rest = rest.take(at).concat(rest.drop(at + 1)) }
    }
    out
}

/// Main's share of an edit to the library: what its judging works out past what a bystander's does.
fn grain_share(before: string, after: string) -> List<string> {
    beyond(
        reworked(grain_caller(), before, after, null, null),
        reworked(BYSTANDER, before, after, null, null),
    )
}

/// What main's build says with the library as `lib`.
fn grain_report(lib: string) -> string { grain_package(grain_caller(), lib, null).judged_at(grain_main()).report() }

/// The edit keeps every answer of main's, and main answers alike.
fn grain_kept(before: string, after: string) -> bool {
    grain_share(before, after).is_empty() && grain_report(before) == grain_report(after)
}

/// The edit makes main ask again.
fn grain_moved(before: string, after: string) -> bool { !grain_share(before, after).is_empty() }

spec "compiler/workspace — a use reads the declaration, never its file" {
    given "a caller naming eight kinds of declaration from another file" {
        then "judged again with nothing edited, nothing is worked out" {
            reworked(grain_caller(), grain_base(), grain_base(), null, null).is_empty()
        }
        then "it is clean" {
            grain_report(grain_base()) == ""
        }
    }
    given "the other file edited where the caller cannot see" {
        then "a comment above and inside `one` keeps every query of main's, answering alike" {
            grain_kept(
                grain_base(),
                grain_lib_text("// a note\n", "one()", "// inside\n    1", "2"),
            )
        }
        then "a new body for `one` keeps them" {
            grain_kept(grain_base(), grain_lib_text("", "one()", "0 + 1", "2"))
        }
        then "a new body for `two`, which the caller never names, keeps them" {
            grain_kept(grain_base(), grain_lib_text("", "one()", "1", "0 + 2"))
        }
    }
    given "the other file edited where the caller reads" {
        then "a new signature for `one` moves the frontier" {
            grain_moved(grain_base(), grain_lib_text("", "one(n: int = 0)", "n", "2"))
        }
    }
    given "the other file's declarations added or renamed where the caller does not read" {
        then "a declaration added keeps every query of main's, answering alike" {
            grain_kept(grain_base(), grain_grown("export fn three() -> int {\n    3\n}\n"))
        }
        then "`two`, which the caller never names, renamed keeps them" {
            grain_kept(grain_base(), grain_renamed("two", "deux"))
        }
    }
    given "the other file's declarations added or renamed where the caller reads" {
        then "`one` renamed moves the frontier, and main is refused" {
            let after = grain_renamed("one", "uno")
            grain_moved(grain_base(), after) && grain_report(after) != ""
        }
        then "a method `one` beside the fn `one` moves it" {
            grain_moved(
                grain_base(),
                grain_grown("impl Box {\n    fn one() -> int {\n        2\n    }\n}\n"),
            )
        }
        then "a second `one` in `a.av`'s module moves it" {
            !beyond(
                reworked(
                    grain_caller(),
                    grain_base(),
                    grain_base(),
                    "export fn other() -> int {\n    4\n}\n",
                    "export fn one() -> int {\n    4\n}\n",
                ),
                reworked(
                    BYSTANDER,
                    grain_base(),
                    grain_base(),
                    "export fn other() -> int {\n    4\n}\n",
                    "export fn one() -> int {\n    4\n}\n",
                ),
            )
                .is_empty()
        }
    }
    given "a caller of a deprecated fn in another file" {
        then "a comment above it keeps every query of main's, answering alike" {
            marked_share("", "use one", "// a note\n", "use one").is_empty() &&
                marked_report("", "use one") == marked_report("// a note\n", "use one")
        }
        then "a new note moves the frontier, and the warning says it" {
            !marked_share("", "use one", "", "use two").is_empty() &&
                marked_report("", "use two").contains("use two")
        }
    }
}

/// A package whose `main` is given and whose library declares a deprecated fn under `lead` and `note`.
fn marked_package(main: string, lead: string, note: string) -> Held {
    held_at(
        vendored_meta(
            {
                "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@std/meta\" = { path = \"vendor/meta\" }\n",
                "/w/src/main.av": main,
                "/w/src/lib/a.av": "${lead}use @std.meta.{deprecated}\n@deprecated(\"${note}\")\nexport fn old() -> int {\n    1\n}\n",
            },
        ),
        "/w",
    )
}

const MARKED_CALLER: string = "use lib.{old}\nexport fn caller() -> int {\n    old()\n}\n"

/// What a second process works out judging `main` after the deprecated fn's file is edited.
fn marked_reworked(main: string, lead: string, note: string, lead_after: string, note_after: string) -> List<
    string,
> {
    let store = empty_store()
    let _ = marked_package(main, lead, note).worked_judging(grain_main(), store)
    marked_package(main, lead_after, note_after).worked_judging(grain_main(), store)
}

/// The caller's share of that edit.
fn marked_share(lead: string, note: string, lead_after: string, note_after: string) -> List<string> {
    beyond(
        marked_reworked(MARKED_CALLER, lead, note, lead_after, note_after),
        marked_reworked(BYSTANDER, lead, note, lead_after, note_after),
    )
}

/// What the caller's build says.
fn marked_report(lead: string, note: string) -> string { marked_package(MARKED_CALLER, lead, note).judged_at(grain_main()).report() }
