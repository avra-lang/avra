// A fn's cancel bits are settled with its strongly-connected set alone: a cycle takes what a
// member outside it reaches, a cycle with no waiter reaches nothing, and asking one fn settles
// no fn it does not call.
use @std.avrac.testing.{test_workspace}
use compiler.{Workspace}
use compiler.host.{memory_host}
use core.{DeclId}
use @std.relation.engine.{Key}

fn settled_bits(ws: Workspace, d: DeclId) -> bool { ws.cells_named("cancel_reach_of").any((k: Key) -> k.arg == d.index) }

fn cancel_workspace(main: string) -> Workspace {
    let ws = test_workspace(
        memory_host(
            {
                "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n",
                "/w/src/main.av": main,
            },
            ["/w/avra.toml", "/w/src/main.av"],
        ),
        "/w",
    )
    let _ = ws.items(ws.file_id("/w/src/main.av"))
    ws
}

fn cancel_decl(ws: Workspace, name: string) -> DeclId {
    [x.id for x in ws.decls.all_decls() if x.name == name][0]
}

/// Whether a call to `name` may park, asked of a fresh workspace.
fn parks(ws: Workspace, name: string) -> bool {
    let d = cancel_decl(ws, name)
    ws.reach_of(d).parks
}

fn cycle_source(leaf_body: string) -> string {
    "extern fn avra_fiber_sleep(ms: int)\nfn leaf() {\n    ${leaf_body}\n}\nfn ping(k: int) {\n    if k > 0 { pong(k - 1) } else { leaf() }\n}\nfn pong(k: int) {\n    if k > 0 { ping(k - 1) }\n}\nfn quiet() -> int { 1 }\n"
}

spec "compiler/cancel_reach — a fn's cancel bits settle with its own set" {
    given "a two-fn cycle whose way out reaches a fn that parks" {
        then "the fn that parks parks" {
            parks(cancel_workspace(cycle_source("avra_fiber_sleep(1)")), "leaf")
        }
        then "both members of the cycle park" {
            let ws = cancel_workspace(cycle_source("avra_fiber_sleep(1)"))
            parks(ws, "ping") && parks(ws, "pong")
        }
    }
    given "the same cycle where nothing parks" {
        then "neither member parks" {
            let ws = cancel_workspace(cycle_source("let _ = 1"))
            !parks(ws, "ping") && !parks(ws, "pong")
        }
    }
    given "a fn that calls nothing" {
        then "asking it settles none of the fns it does not call" {
            let ws = cancel_workspace(cycle_source("avra_fiber_sleep(1)"))
            let _ = parks(ws, "quiet")
            !settled_bits(ws, cancel_decl(ws, "ping"))
        }
    }
    given "a cycle asked from one member" {
        then "settles the whole set, and the fn it calls outside it" {
            let ws = cancel_workspace(cycle_source("avra_fiber_sleep(1)"))
            let _ = parks(ws, "pong")
            settled_bits(ws, cancel_decl(ws, "ping")) && settled_bits(ws, cancel_decl(ws, "leaf"))
        }
    }
}
