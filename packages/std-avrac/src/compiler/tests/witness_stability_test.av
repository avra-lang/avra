// What makes a witness the same witness in the next process: the edges it records
// do not depend on which file ran first (`Family.MethodDiags`), the names it holds do
// not depend on which file was admitted first, and an entry written in another shape
// is refused. `fresh_check`, `verdict`, `edge_shape`, `edge_count`, `decl_in_file` are
// witness_fixtures.av's own.
use features.{Decl}
use compiler.store.{pack_at}
use query.{Key}

/// `x` declares a type with a method; `z` is an unrelated file in another module. Whichever runs
/// first pays the method-table scan.
fn order_files() -> Map<string, string> {
    {
        "/w/src/other/z.av": "export fn h() -> int {\n    2\n}\n",
        "/w/src/x.av": "export fn k() -> int {\n    3\n}\n",
    }
}

spec "compiler/witness — a witness does not depend on which file ran first" {
    then "every file's witness records its MethodDiags edge exactly once" {
        let names = ["/w/src/other/z.av", "/w/src/x.av"]
        let path = fresh_pack_path("stab_edge_once")
        let ws = a_process_over(order_files(), names, path)
        let _ = checked(ws, "/w/src/other/z.av")
        let _ = checked(ws, "/w/src/x.av")
        edge_count(ws, path, "/w/src/other/z.av", "MethodDiags") == 1 &&
            edge_count(ws, path, "/w/src/x.av", "MethodDiags") == 1
    }
    then "the shape of each witness is the same whichever file ran first" {
        let names = ["/w/src/other/z.av", "/w/src/x.av"]
        let z_first = fresh_pack_path("stab_order_zx")
        let x_first = fresh_pack_path("stab_order_xz")
        let a = a_process_over(order_files(), names, z_first)
        let _ = checked(a, "/w/src/other/z.av")
        let _ = checked(a, "/w/src/x.av")
        let b = a_process_over(order_files(), names, x_first)
        let _ = checked(b, "/w/src/x.av")
        let _ = checked(b, "/w/src/other/z.av")
        edge_shape(a, z_first, "/w/src/x.av") == edge_shape(b, x_first, "/w/src/x.av") &&
            edge_shape(a, z_first, "/w/src/other/z.av") == edge_shape(b, x_first, "/w/src/other/z.av")
    }
}

/// `x` declares `T` with one method, named by the caller; `y`, in another module, imports `T` and
/// declares `show`. A clash is spoken at the LATER path, which is `y`.
fn clash_files(x_method: string) -> Map<string, string> {
    {
        "/w/src/lib/x.av": "export type T = { v: int }\nimpl T {\n    fn ${x_method}() -> int {\n        1\n    }\n}\n",
        "/w/src/other/y.av": "use lib.{T}\nimpl T {\n    fn show() -> int {\n        2\n    }\n}\n",
    }
}

spec "compiler/witness — a clash spoken in a file by an impl elsewhere" {
    then "fixture: x's impl of `other` is no clash, x's impl of `show` is one, spoken at y" {
        let names = ["/w/src/lib/x.av", "/w/src/other/y.av"]
        fresh_check(clash_files("other"), names, "/w/src/other/y.av").clean &&
            !fresh_check(clash_files("show"), names, "/w/src/other/y.av").clean
    }
    then "the MethodDiags edge is recorded, and refuses when the clash arrives" {
        let names = ["/w/src/lib/x.av", "/w/src/other/y.av"]
        let path = fresh_pack_path("stab_clash_elsewhere")
        let first = a_process_over(clash_files("other"), names, path)
        let _ = checked(first, "/w/src/other/y.av")
        let recorded = edge_count(first, path, "/w/src/other/y.av", "MethodDiags") == 1
        let v = verdict(a_process_over(clash_files("show"), names, path), path, "/w/src/other/y.av")
        recorded &&
            refused_family(v, "MethodDiags") &&
            !v.outcome.reused() &&
            same_verdict_as_fresh(v, fresh_check(clash_files("show"), names, "/w/src/other/y.av"))
    }
}

/// Two files each declaring `f`, in either admission order.
fn twin_files() -> Map<string, string> {
    {
        "/w/src/a.av": "export fn f() -> int {\n    1\n}\n",
        "/w/src/b.av": "export fn f() -> int {\n    2\n}\n",
    }
}

spec "compiler/witness — a stable name does not depend on admission order" {
    then "the same name in two files keeps each file's own name, whichever file was admitted first" {
        let ab = a_process_over(
            twin_files(),
            ["/w/src/a.av", "/w/src/b.av"],
            fresh_pack_path("stab_names_ab"),
        )
        let ba = a_process_over(
            twin_files(),
            ["/w/src/b.av", "/w/src/a.av"],
            fresh_pack_path("stab_names_ba"),
        )
        let a_in_ab = ab.decls.stable_decl_name(decl_in_file(ab, "/w/src/a.av", "f"))
        let b_in_ab = ab.decls.stable_decl_name(decl_in_file(ab, "/w/src/b.av", "f"))
        let a_in_ba = ba.decls.stable_decl_name(decl_in_file(ba, "/w/src/a.av", "f"))
        let b_in_ba = ba.decls.stable_decl_name(decl_in_file(ba, "/w/src/b.av", "f"))
        a_in_ab == a_in_ba && b_in_ab == b_in_ba && a_in_ab != b_in_ab
    }
    then "a type and its impl, one name in one file, keep two names" {
        let files: Map<string, string> = {
            "/w/src/x.av": "export type T = { v: int }\nimpl T {\n    fn show() -> int {\n        1\n    }\n}\n",
        }
        let ws = a_process_over(files, ["/w/src/x.av"], fresh_pack_path("stab_type_impl"))
        let named = [d for d in ws.decls.decls.get() if d.name == "T" && ws.decls.file(d.file).path == "/w/src/x.av"]
        named.length == 2 &&
            ws.decls.stable_decl_name(named[0].id) != ws.decls.stable_decl_name(named[1].id)
    }
    then "every declaration of a file resolves from its own name, the type and the impl included" {
        let files: Map<string, string> = {
            "/w/src/x.av": "export type T = { v: int }\nimpl T {\n    fn show() -> int {\n        1\n    }\n}\n",
        }
        let ws = a_process_over(files, ["/w/src/x.av"], fresh_pack_path("stab_resolves"))
        let own = [d for d in ws.decls.decls.get() if ws.decls.file(d.file).path == "/w/src/x.av" && (d.name == "T" || d.name == "show")]
        own.length == 3 &&
            own
                .all(
                    (d: Decl) -> ws
                        .edge_current_hash(ws.stable_key_name(Key { family: sig_ordinal(), arg: d.id.index })) != null,
                )
    }
    then "a builtin's name resolves though the first file admitted differs" {
        let ab = a_process_over(
            twin_files(),
            ["/w/src/a.av", "/w/src/b.av"],
            fresh_pack_path("stab_builtin_ab"),
        )
        let ba = a_process_over(
            twin_files(),
            ["/w/src/b.av", "/w/src/a.av"],
            fresh_pack_path("stab_builtin_ba"),
        )
        let list_in_ab = ab
            .decls
            .stable_decl_name([d.id for d in ab.decls.decls.get() if d.name == "List"][0])
        let list_in_ba = ba
            .decls
            .stable_decl_name([d.id for d in ba.decls.decls.get() if d.name == "List"][0])
        list_in_ab == list_in_ba
    }
}

spec "compiler/witness — the record-shape stamp" {
    then "an entry stamped with another shape is refused, and the file recomputes" {
        let path = fresh_pack_path("stab_shape")
        let first = a_process(package_files(), path)
        let _ = [checked(first, p) for p in package_names()]
        let pk = pack_at(path, "witness-test")
        let e? = pk.get(first.witness_name(first.file_id("/w/src/a.av"))) else { return false }
        pk.put(e with { fingerprint: 999 })
        let _ = pk.commit()
        let v = verdict(a_process(package_files(), path), path, "/w/src/a.av")
        !v.outcome.reused() && v.outcome.value().clean
    }
    then "an entry in the current shape is reused" {
        let path = fresh_pack_path("stab_shape_ok")
        let first = a_process(package_files(), path)
        let _ = [checked(first, p) for p in package_names()]
        checked(a_process(package_files(), path), "/w/src/a.av").reused()
    }
}
