// The light phase's pure parts: the hand-off's words, the plan's
// binary, and what a status means. Attacked at the edges: the stage
// word alone, the old command's spelling, no `-o`, `-o` last, the
// statuses a trap, a signal and a missing binary produce.
use @std.avrac.compiler.{plan_binary, verdict_of, stage_words, staged_plans}

spec "the hand-off" {
    given "a fresh image's words" {
        then "the plans a hand-off wrote are the plans it reads" {
            (staged_plans(stage_words(["a.link", "b.link"])) ?? []).join(",") == "a.link,b.link"
        }
        then "a command line is no hand-off" {
            staged_plans(["test", "packages/x"]) == null
        }
        then "the old `staged` command's line is no hand-off" {
            staged_plans(["staged", "a.link"]) == null
        }
        then "the stage word alone is no hand-off" {
            staged_plans(stage_words([])) == null
        }
        then "an empty line is no hand-off" {
            staged_plans([]) == null
        }
    }
}

spec "the link plan" {
    given "clang's words" {
        then "the binary is the word after -o" {
            plan_binary(["-w", "-O0", "m.ll", "-o", "build/m"]) == "build/m"
        }
        then "a plan without -o names no binary" {
            plan_binary(["-w", "-O0", "m.ll"]) == null
        }
        then "-o as the last word names no binary" {
            plan_binary(["-w", "m.ll", "-o"]) == null
        }
        then "an empty plan names no binary" {
            plan_binary([]) == null
        }
    }
}

spec "the verdict" {
    given "a status" {
        then "0 is green" { verdict_of(0) is .Green }
        then "1 is red" { verdict_of(1) is .Red }
        then "127 is a binary that could not start" { verdict_of(127) is .CouldNotStart }
        then "a trap's 2 is a death" { verdict_of(2) is .Died }
        then "a signal's 128+9 is a death" { verdict_of(137) is .Died }
    }
}
