// A compile-time run's read of the world is a recorded read of the file
// whose run asks: the record names it, so the file is held only while
// that text stands.
use @std.avrac.testing.{test_workspace}
use @std.avrac.core.{EmbedKind}
use compiler.{Workspace, RunRead, reads_field, reads_of, distinct_reads}
use compiler.host.{memory_host}

const RUN_READS_MAIN: string = "/w/src/main.av"

fn run_reads_workspace() -> Workspace {
    test_workspace(
        memory_host(
            {
                "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n",
                "/w/src/main.av": "1\n",
                "/w/src/data.txt": "one",
            },
            ["/w/avra.toml", RUN_READS_MAIN, "/w/src/data.txt"],
        ),
        "/w",
    )
}

/// What the file's runs are recorded as having read.
fn run_reads_of(ws: Workspace) -> string { (ws.hold.runs.get().get(RUN_READS_MAIN) ?? []).map(it.path).join(",") }

spec "compiler/settle — a run's read of the world is recorded" {
    then "a file a run reads is recorded for the file whose run asks, and its text answers" {
        let ws = run_reads_workspace()
        let before = run_reads_of(ws)
        let text = ws.run_read(ws.file_id(RUN_READS_MAIN), "/w/src/data.txt", EmbedKind.Text)
        let read = match text { .Ok(t) -> t.text() ?? "", .Err(why) -> "refused: ${why}" }
        before == "" && read == "one" && run_reads_of(ws) == "/w/src/data.txt"
    }
    then "a file that is not there is recorded all the same: its arrival moves what the run would answer" {
        let ws = run_reads_workspace()
        let gone = ws.run_read(ws.file_id(RUN_READS_MAIN), "/w/src/none.txt", EmbedKind.Text)
        let refused = match gone { .Ok(_) -> false, .Err(_) -> true }
        refused && run_reads_of(ws) == "/w/src/none.txt"
    }
    then "read twice, it is recorded once" {
        let ws = run_reads_workspace()
        let f = ws.file_id(RUN_READS_MAIN)
        let _ = ws.run_read(f, "/w/src/data.txt", EmbedKind.Text)
        let _ = ws.run_read(f, "/w/src/data.txt", EmbedKind.Text)
        run_reads_of(ws) == "/w/src/data.txt"
    }
}

spec "compiler/record — a read's wire round-trips, empty cells included" {
    then "a plain read — no ref, no print, no outline — survives" {
        let r = RunRead { path: "/w/src/data.txt", digest: "d", ref: "", print: "", outline: "" }
        let wire = reads_field([r])
        let xs = reads_of(wire) ?? []
        xs.length == 1 && reads_field(xs) == wire
    }
    then "a held declaration's read — no print or outline — survives" {
        let r = RunRead { path: "/w/src/data.txt", digest: "d", ref: "r", print: "", outline: "" }
        let wire = reads_field([r])
        let xs = reads_of(wire) ?? []
        xs.length == 1 && reads_field(xs) == wire
    }
    then "a read with no digest, ref, print or outline survives" {
        let r = RunRead { path: "/w/src/data.txt", digest: "", ref: "", print: "", outline: "" }
        let wire = reads_field([r])
        let xs = reads_of(wire) ?? []
        xs.length == 1 && reads_field(xs) == wire
    }
    then "a read of a declaration carries its outline" {
        let r = RunRead {
            path: "/w/src/data.txt",
            digest: "d",
            ref: "r",
            print: "42",
            outline: "o",
        }
        let xs = reads_of(reads_field([r])) ?? []
        xs.length == 1 && xs[0].outline == "o" && xs[0].print == "42"
    }
}

fn read_at(path: string, ref: string) -> RunRead { RunRead { path: path, digest: "d", ref: ref, print: "", outline: "" } }

/// What `distinct_reads` makes of the same sequence: the reference every list below is held to.
fn reads_named(xs: List<RunRead>) -> string { distinct_reads(xs).map("${it.path}:${it.ref}").join(",") }

fn listed(ws: Workspace) -> string { (ws.hold.runs.get().get(RUN_READS_MAIN) ?? []).map("${it.path}:${it.ref}").join(",") }

spec "compiler/settle — a reader's list is the distinct fold of what was read into it" {
    then "reads appended in pieces list as distinct_reads lists them whole, order included" {
        let ws = run_reads_workspace()
        let a = read_at("/w/a", "")
        let b = read_at("/w/b", "x")
        let b2 = read_at("/w/b", "y")
        ws.read_by(RUN_READS_MAIN, [a, b])
        ws.read_by(RUN_READS_MAIN, [b, b2, a])
        ws.read_by(RUN_READS_MAIN, [b2, read_at("/w/c", "")])
        listed(ws) == reads_named([a, b, b, b2, a, b2, read_at("/w/c", "")])
    }
    then "a scope's reads join what the list held, as the fold of both" {
        let ws = run_reads_workspace()
        let a = read_at("/w/a", "")
        let b = read_at("/w/b", "")
        let c = read_at("/w/c", "")
        ws.read_by(RUN_READS_MAIN, [a, b])
        let scope = ws.opened_reads(RUN_READS_MAIN)
        let empty = listed(ws) == ""
        ws.read_by(RUN_READS_MAIN, [b, c, c])
        let own = ws.closed_reads(RUN_READS_MAIN, scope).map(it.path).join(",")
        empty && own == "/w/b,/w/c" && listed(ws) == reads_named([a, b, b, c, c])
    }
    then "a scope nested in a scope restores each list in turn" {
        let ws = run_reads_workspace()
        let a = read_at("/w/a", "")
        let b = read_at("/w/b", "")
        let c = read_at("/w/c", "")
        ws.read_by(RUN_READS_MAIN, [a])
        let outer = ws.opened_reads(RUN_READS_MAIN)
        ws.read_by(RUN_READS_MAIN, [b])
        let inner = ws.opened_reads(RUN_READS_MAIN)
        ws.read_by(RUN_READS_MAIN, [a, c])
        let inner_own = ws.closed_reads(RUN_READS_MAIN, inner).map(it.path).join(",")
        let outer_own = ws.closed_reads(RUN_READS_MAIN, outer).map(it.path).join(",")
        inner_own == "/w/a,/w/c" &&
            outer_own == "/w/b,/w/a,/w/c" &&
            listed(ws) == reads_named([a, b, a, c])
    }
}
