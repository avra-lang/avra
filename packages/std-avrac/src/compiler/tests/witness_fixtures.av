// Fixtures shared by the durable-witness tests: the un-witnessed answer a reused one
// must equal, and WHICH stored edges a second process refuses — so a test names the
// edge that refused, not merely that something did. `fresh_pack_path`, `a_process_over`
// and `checked` are witness_test.av's own (one shared namespace).
use @std.avrac.compiler.{avra, new_workspace}
use compiler.{Workspace, WitnessedCheck, WitnessedOutcome, name_parts, rule_findings, analysed}
use core.{DeclId, joined, sorted_texts}
use compiler.host.{memory_host}
use compiler.store.{pack_at}
use diagnostics.{DiagFacts, diag_facts_of}

/// `Family.Parsed`'s, `Family.Namespace`'s, `Family.Sig`'s, `Family.Methods`'s and `Family.Manifest`'s ordinals (their places in `Family`, workspace.av), the one
/// way a test builds a `Key` without reaching a `compiler`-private enum. Pinned by name in
/// witness_refusal_test.av, so a moved ordinal fails there instead of here.
fn parsed_ordinal() -> int { 1 }

fn namespace_ordinal() -> int { 3 }

fn sig_ordinal() -> int { 6 }

fn methods_ordinal() -> int { 7 }

fn manifest_ordinal() -> int { 15 }

/// The un-witnessed answer a reused one must equal.
fn fresh_check(files: Map<string, string>, names: List<string>, path: string) -> WitnessedCheck {
    let ws = new_workspace(memory_host(files, names), "/w", avra())
    for p in names { let _ = ws.items(ws.file_id(p)) }
    let a = ws.analysis(ws.file_id(path))
    let rules = rule_findings(analysed(a), a.view.stmts)
    WitnessedCheck {
        clean: a.clean(),
        diagnostics: [diag_facts_of(d) for d in a.diagnostics],
        rules: [diag_facts_of(d) for d in rules],
    }
}

/// A process over the given files and a real `avra.toml`, opened onto the shared pack.
fn a_process_over_toml(
    files: Map<string, string>,
    names: List<string>,
    toml: string,
    pack_path: string,
) -> Workspace {
    mut all = files
    all.set("/w/avra.toml", toml)
    let ws = new_workspace(memory_host(all, names.concat(["/w/avra.toml"])), "/w", avra())
    ws.attach_pack(pack_at(pack_path, "witness-test"))
    for path in names { let _ = ws.items(ws.file_id(path)) }
    ws
}

/// The families of `file`'s STORED edges that `ws` refuses. Read BEFORE `ws` checks the
/// file, since a check rewrites the entry; empty when there is no entry or every edge holds.
fn refusing_families(ws: Workspace, pack_path: string, file: string) -> List<string> {
    let e? = pack_at(pack_path, "witness-test").get(ws.witness_name(ws.file_id(file))) else { return [] }
    [name_parts(x.name)?.family ?? "?" for x in e.edges if !ws.edge_current(x)]
}

/// One second-process check: the edges that refused, then the outcome.
type Verdict = { refused_by: List<string>, outcome: WitnessedOutcome }

fn verdict(ws: Workspace, pack_path: string, file: string) -> Verdict {
    let refused = refusing_families(ws, pack_path, file)
    Verdict { refused_by: refused, outcome: ws.witnessed_check(ws.file_id(file)) }
}

/// Whether the edge of this family refused.
fn refused_family(v: Verdict, family: string) -> bool { v.refused_by.contains(family) }

/// The stored edge names of `file`'s witness, of one family.
fn edge_names_of(ws: Workspace, pack_path: string, file: string, family: string) -> List<string> {
    let e? = pack_at(pack_path, "witness-test").get(ws.witness_name(ws.file_id(file))) else { return [] }
    [x.name for x in e.edges if name_parts(x.name)?.family ?? "" == family]
}

/// The families of `file`'s stored edges, sorted and joined — the shape of a witness, blind to order.
fn edge_shape(ws: Workspace, pack_path: string, file: string) -> string {
    let e? = pack_at(pack_path, "witness-test").get(ws.witness_name(ws.file_id(file))) else { return "" }
    joined(sorted_texts([name_parts(x.name)?.family ?? "?" for x in e.edges]), ",")
}

/// How many stored edges of `file`'s witness belong to one family.
fn edge_count(ws: Workspace, pack_path: string, file: string, family: string) -> int {
    edge_names_of(ws, pack_path, file, family).length
}

/// The declaration named `name` that `file` declares.
fn decl_in_file(ws: Workspace, file: string, name: string) -> DeclId {
    [d.id for d in ws.decls.all_decls() if d.name == name && ws.decls.file(d.file).path == file][0]
}

/// Whether a second process's verdict is the fresh, un-witnessed one —
/// by identity (kind, severity, message), never a rendered string: a
/// `Diag`'s render depends on the sources the comparing process has
/// loaded, which is exactly what a witnessed row must NOT bake in
/// (render_test.av's own fidelity tests cover the render path itself).
fn same_diag_facts(a: DiagFacts, b: DiagFacts) -> bool {
    a.kind == b.kind && a.severity == b.severity && a.message == b.message
}

fn same_facts(a: List<DiagFacts>, b: List<DiagFacts>) -> bool {
    a.length == b.length && [i for i in 0..a.length if !same_diag_facts(a[i], b[i])].is_empty()
}

fn same_verdict_as_fresh(v: Verdict, fresh: WitnessedCheck) -> bool {
    v.outcome.value().clean == fresh.clean &&
        same_facts(v.outcome.value().diagnostics, fresh.diagnostics) &&
        same_facts(v.outcome.value().rules, fresh.rules)
}
