// A file's TEXT is its own edge, held for the file itself and for every file a frame of its
// report points into. A `Parsed` edge is the parse's structure alone, so a comment or a reindent
// in a callee moves no caller. `trio`, `trio_names`, `fresh_check`, `verdict`, `refused_family`,
// `edge_names_of`, `edge_count`, `same_verdict_as_fresh` are the neighbouring test files' own.
use @std.errors.{Loc}
use diagnostics.{error_at}

/// `a` calls `helper` from `b`; `above` is written above `helper`, or above `g` when `in_a`.
fn text_files(above: string, in_a: bool) -> Map<string, string> {
    {
        "/w/src/a.av": "${if in_a { above } else { "" }}export fn g() -> int {\n    helper()\n}\n",
        "/w/src/b.av": "${if in_a { "" } else { above }}export fn helper() -> int {\n    1\n}\n",
        "/w/src/c.av": "export fn unrelated() -> int {\n    2\n}\n",
    }
}

spec "compiler/witness — a callee's text moves no caller" {
    then "fixture: the trio is clean whatever is written above `helper`" {
        fresh_check(text_files("", false), trio_names(), "/w/src/a.av").clean &&
            fresh_check(text_files("// what helper answers\n", false), trio_names(), "/w/src/a.av")
                .clean
    }
    then "a comment above the callee leaves the caller's witness reused" {
        let path = fresh_pack_path("text_comment")
        let _ = checked(a_process_over(text_files("", false), trio_names(), path), "/w/src/a.av")
        let edited = text_files("// what helper answers\n", false)
        let v = verdict(a_process_over(edited, trio_names(), path), path, "/w/src/a.av")
        v.refused_by.is_empty() && v.outcome.reused()
    }
    then "blank lines above the callee leave the caller's witness reused" {
        let path = fresh_pack_path("text_blank")
        let _ = checked(a_process_over(text_files("", false), trio_names(), path), "/w/src/a.av")
        let v = verdict(
            a_process_over(text_files("\n\n", false), trio_names(), path),
            path,
            "/w/src/a.av",
        )
        v.refused_by.is_empty() && v.outcome.reused()
    }
    then "an edit to the callee's body is refused by its Folded edge, and the verdict is the fresh one" {
        let path = fresh_pack_path("text_body")
        let _ = checked(a_process_over(trio("1", "2"), trio_names(), path), "/w/src/a.av")
        let v = verdict(a_process_over(trio("3", "2"), trio_names(), path), path, "/w/src/a.av")
        refused_family(v, "Folded") &&
            same_verdict_as_fresh(v, fresh_check(trio("3", "2"), trio_names(), "/w/src/a.av"))
    }
}

spec "compiler/witness — a file's own text" {
    then "a witness holds one Source edge, the file's own" {
        let path = fresh_pack_path("text_own")
        let ws = a_process_over(text_files("", false), trio_names(), path)
        let _ = checked(ws, "/w/src/a.av")
        let names = edge_names_of(ws, path, "/w/src/a.av", "Source")
        names.length == 1 && names[0].contains("/w/src/a.av")
    }
    then "a comment in the file's own text is refused by its Source edge, and the answer is recomputed" {
        let path = fresh_pack_path("text_own_edit")
        let _ = checked(a_process_over(text_files("", true), trio_names(), path), "/w/src/a.av")
        let v = verdict(
            a_process_over(text_files("// the caller\n", true), trio_names(), path),
            path,
            "/w/src/a.av",
        )
        refused_family(v, "Source") && !v.outcome.reused() && v.outcome.value().clean
    }
}

spec "compiler/witness — a frame that points into another file" {
    then "adds that file's text, once, beside the file's own" {
        let path = fresh_pack_path("text_foreign")
        let ws = a_process_over(text_files("", false), trio_names(), path)
        let a = ws.file_id("/w/src/a.av")
        let into_b = Loc { file: "/w/src/b.av", lo: 0, hi: 1 }
        let twice = [
            error_at("t.into_b", into_b, "points into b"),
            error_at("t.again", into_b, "points into b again"),
        ]
        let names = [e.name for e in ws.text_edges(a, twice)]
        names.length == 2 && names[0].contains("/w/src/a.av") && names[1].contains("/w/src/b.av")
    }
    then "a frame in the file's own path, or with no place, adds nothing" {
        let path = fresh_pack_path("text_own_frames")
        let ws = a_process_over(text_files("", false), trio_names(), path)
        let a = ws.file_id("/w/src/a.av")
        let here = error_at("t.here", Loc { file: "/w/src/a.av", lo: 0, hi: 1 }, "here")
        let nowhere = error_at("t.nowhere", null, "nowhere")
        ws.text_edges(a, [here, nowhere]).length == 1
    }
    then "a frame naming a file the host lacks holds an edge that refuses" {
        let path = fresh_pack_path("text_lacking")
        let ws = a_process_over(text_files("", false), trio_names(), path)
        let a = ws.file_id("/w/src/a.av")
        let elsewhere = error_at(
            "t.elsewhere",
            Loc { file: "/w/src/gone.av", lo: 0, hi: 1 },
            "gone",
        )
        let edges = ws.text_edges(a, [elsewhere])
        edges.length == 2 && ws.edge_current_hash(edges[1].name) == null
    }
}
