// proves: a map write is no slot write, alike in both engines — a set and a remove file nothing
extern fn avra_box_observe(box: Map<string, int>) -> int
extern fn avra_box_unobserve(box: Map<string, int>) -> int
extern fn avra_box_key(box: Map<string, int>) -> int
extern fn avra_turn_next() -> int
extern fn avra_changes_take() -> List<int>
extern fn avra_map_set(m: Map<string, int>, key: string, v: int)
extern fn avra_map_remove(m: Map<string, int>, key: string)

fn taken() -> List<int> {
    avra_changes_take()
}

fn only(keys: List<int>, k: int) -> bool {
    keys.length == 1 && keys[0] == k
}

fn pair_of(keys: List<int>, first: int, second: int) -> bool {
    keys.length == 2 && keys[0] == first && keys[1] == second
}

fn turn() -> List<int> {
    let _ = avra_turn_next()
    taken()
}

let seed = avra_turn_next() + 1
let dict = {"k": seed}
let _ = avra_box_observe(dict)
avra_map_set(dict, "j", 2)
println("a set files nothing ${taken().length}")
let _ = avra_turn_next()
avra_map_remove(dict, "k")
println("a remove files nothing ${taken().length}")
let _ = avra_turn_next()
println("a read files nothing ${dict.has("j")} ${taken().length}")
