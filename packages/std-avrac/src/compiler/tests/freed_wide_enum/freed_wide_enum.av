// proves: an enum past sixty-four variants keeps its payload box
enum Big {
    V0
    V1
    V2
    V3
    V4
    V5
    V6
    V7
    V8
    V9
    V10
    V11
    V12
    V13
    V14
    V15
    V16
    V17
    V18
    V19
    V20
    V21
    V22
    V23
    V24
    V25
    V26
    V27
    V28
    V29
    V30
    V31
    V32
    V33
    V34
    V35
    V36
    V37
    V38
    V39
    V40
    V41
    V42
    V43
    V44
    V45
    V46
    V47
    V48
    V49
    V50
    V51
    V52
    V53
    V54
    V55
    V56
    V57
    V58
    V59
    V60
    V61
    V62
    V63
    V64
    V65
    V66
    Held(xs: List<int>)
}

fn sized(b: Big) -> int {
    match b { .Held(xs) -> xs.length, .V66 -> 66, _ -> 1 }
}

fn shown() -> int {
    let all = [Big.V66, Big.Held([1, 2, 3]), Big.V2]
    mut t = 0
    for b in all { t = t + sized(b) }
    let n: Big? = Big.Held([4])
    let m = match n {
        v? -> sized(v)
        null -> 0
    }
    t + m
}

"${shown()}"
