// A `@model` field that is a record with neither a link nor one scalar has no column,
// so the model's own declaration refuses it, naming the field. The program is judged
// with the real `@std/db` vendored beside it, so the refusal is the model law's own.
use @std.avrac.testing.{beside_db, refused_in}

spec "std/db — a record field with no column is refused" {
    given "a model field that is a record of two fields" {
        then "the declaration names the field, and says what a column can hold" {
            refused_in(
                beside_db(
                    "use @std.db.{model}\ntype Pair = { a: int, b: int }\n@model\ntype Holder = {\n    id: int = 0,\n    pair: Pair,\n}\nlet h = Holder { pair: Pair { a: 1, b: 2 } }\nh.id",
                ),
                "`pair` is a record with neither",
            )
        }
    }
}
