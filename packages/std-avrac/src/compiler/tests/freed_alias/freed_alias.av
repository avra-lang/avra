// proves: two holders of one box: the last to let go frees it, and a
// copy reads on after its source is gone
type Bag = { items: List<int>, name: string }

fn second(b: Bag) -> Bag { b }

fn total(xs: List<int>) -> int {
    mut t = 0
    for x in xs { t = t + x }
    t
}

fn shown() -> int {
    let a = Bag { items: [1, 2, 3], name: "a" }
    mut held: List<Bag> = []
    held.push(a)
    held.push(second(a))
    let first = held[0]
    held = []
    let other = Bag { items: first.items, name: "b" }
    total(first.items) + total(other.items) + total(a.items)
}

fn churn(n: int) -> int {
    mut t = 0
    for i in 0..n {
        let b = Bag { items: [i, i + 1], name: "x" }
        let c = second(b)
        t = t + total(c.items)
    }
    t
}

"${shown()} ${churn(1000)}"
