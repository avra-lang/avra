// THE QUALIFYING SHARE: which managed seats a callee only READS.
// It was a BRACKET until `RtSig.keeps` landed — a runtime row borrows
// its arguments, but the `_owned` twins keep theirs and nothing said
// which, so every row seat had to be counted both ways. One column
// collapsed it. Each case here is a body whose answer is known before
// the instrument runs.
use @std.avrac.compiler.{SeatCensus, seat_census}
use @std.avrac.testing.{ir_of}

/// The line for a source's one interesting body, by name.
fn line_for(source: string, name: string) -> string {
    let c: SeatCensus = seat_census(ir_of(source))
    c.lines.find(it.starts_with("  ${name}:")) ?? "no such body"
}

spec "language/escapes" {
    given "a seat the callee only reads" {
        then "a read through a runtime row is not an escape — the row BORROWS" {
            line_for("fn f(s: string) -> int { s.length }\nf(\"a\")", "f") ==
                "  f: 1/1 read-only"
        }
        then "one seat read and one kept are counted apart" {
            line_for("fn f(a: string, b: string) -> string {\n    let n = a.length\n    b\n}\nf(\"a\", \"b\").length", "f") ==
                "  f: 1/2 read-only"
        }
        then "a scalar seat is not a seat at all — nothing to count" {
            seat_census(ir_of("fn f(n: int) -> int { n + 1 }\nf(1)")).seats == 0
        }
    }
    given "a seat the callee keeps" {
        then "answered outward, it escapes" {
            line_for("fn f(s: string) -> string { s }\nf(\"a\").length", "f") ==
                "  f: 0/1 read-only"
        }
        then "handed to another fn, it escapes — a callee's disposition wants a fixpoint" {
            line_for("fn r(s: string) -> int { s.length }\nfn f(s: string) -> int { r(s) }\nf(\"a\")", "f") ==
                "  f: 0/1 read-only"
        }
        // THE CASE THE `keeps` COLUMN BOUGHT, and the one that made
        // the old bracket wide: a record literal lowers to
        // `avra_array_push_owned`, which TAKES ITS OWN REFERENCE. It
        // read as read-only until the column declared the seat.
        then "packed into a record, it escapes through the row that keeps it" {
            line_for("type H = { t: string, n: int }\nfn f(s: string) -> H { H { t: s, n: 1 } }\nf(\"a\").n", "f") ==
                "  f: 0/1 read-only"
        }
    }
    given "the census over a whole program" {
        then "the reads never exceed the seats" {
            let c: SeatCensus = seat_census(ir_of("fn f(s: string) -> int { s.length }\nfn g(s: string) -> string { s }\nf(\"a\") + g(\"b\").length"))
            c.reads == 1 && c.seats == 2
        }
    }
}
