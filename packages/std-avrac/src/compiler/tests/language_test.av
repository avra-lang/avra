// The driver seam: the canonical language assembles clean, programs
// parse through one fn, recovery holes are VISIBLE Stmt.Error nodes,
// and lex errors ride the same diagnostics list.
use @std.avrac.compiler.{avra, assemble, language_features, parse_source, project, builtin_codes, analyze_source}
use @std.avrac.testing.{shown}
use @std.grammar.{Diagnostic, Cause, Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use @std.avrac.diagnostics.{registered, new_source_file}
use @std.avrac.diagnostics.{DiagCode}
use @std.avrac.features.{LanguageFeature, feature}

/// True when a cause's projected kind is in the built-in registry.
fn cause_registered(c: Cause) -> bool {
    let d = Diagnostic { cause: c, message: "m", loc: null, expected: [], in_rule: "r" }
    registered(builtin_codes, project(d, null).kind)
}

/// A feature whose registered kind collides with a built-in one.
fn clashing() -> LanguageFeature {
    let rows = table<DiagCode> {
        kind        | summary
        "lex.error" | "collides with the builtin kind"
    }
    feature("clash", clash_gram()) with { diags: rows }
}

spec "language" {
    given "the canonical language" {
        then "it assembles with no defects and the builtin registry" {
            let lang = avra()
            lang.syntax != null && lang.diagnostics.is_empty() && registered(lang.rows.codes, "parse.expected") && registered(lang.rows.codes, "resolve.unresolved") && registered(lang.rows.codes, "type.mismatch") && registered(lang.rows.codes, "type.case") && registered(lang.rows.codes, "resolve.nested_spec") && registered(lang.rows.codes, "resolve.duplicate_case")
        }
        then "a feature registering a taken kind refuses assembly" {
            let lang = assemble(language_features().concat([clashing()]))
            lang.syntax == null && lang.diagnostics.length == 1 && lang.diagnostics[0].kind == "language.defect" && lang.diagnostics[0].message == "`lex.error`: diagnostic kind is registered more than once"
        }
        then "a real parse error checks end to end" {
            let lang = avra()
            let expected = """error[parse.expected]: expected NAME while parsing `stmt`
  ╭─[app.av:2:5]
2 │ let = 3
  ·     ┬
──╯"""
            lang.check(new_source_file("app.av", "let a = 1\nlet = 3")) == expected && lang.check(new_source_file("<source>", "let a = 1")) == ""
        }
        then "a layout fact read before a `mut` seat moves it is a named compiler defect, not a silently wrong mask (R11c, avra-8sb5.34.21)" {
            let lang = avra()
            let src = """type Small = { index: int }
enum Tagged {
    A(Small)
    B
}
fn reads_tag(x: Tagged) -> int {
    match x {
        .A(s) -> s.index,
        .B -> 0,
    }
}
fn seal(mut s: Small) {
    s.index = 1
}"""
            lang.check(new_source_file("app.av", src)) == "error[language.defect]: `Small`'s flatness was read before a `mut` seat sealed it"
        }
    }
    given "the code table" {
        then "every engine cause projects to a registered kind" {
            let causes = [Cause.Lex, Cause.Expected, Cause.Trailing, Cause.Builder, Cause.Defect]
            causes.all(cause_registered(it))
        }
    }
    given "a commented program" {
        then "comments vanish; the program is untouched" {
            let p = parse_source("// leading\nlet x = 1 // trailing\n// alone\nx")
            p.voices.list.is_empty() && p.stmts.length == 2
        }
    }
    given "a well-formed program" {
        then "lets and expression statements land in order" {
            let p = parse_source("let x = 1 + y\nx")
            let let_ok = match p.store.stmt(p.stmts[0]) { .Let(name, _, _) -> name == "x", _ -> false }
            p.voices.list.is_empty() && p.stmts.length == 2 && let_ok && p.store.stmt(p.stmts[1]) is .ExprStmt
        }
    }
    given "a broken statement between good ones" {
        then "the hole is an explicit Error node, the neighbors are whole" {
            let p = parse_source("let a = 1\nlet = 3\nlet y = 2")
            let hole_ok = p.stmts.length == 3 && p.store.stmt(p.stmts[1]) is .Error
            let tail_ok = match p.store.stmt(p.stmts[2]) { .Let(name, _, _) -> name == "y", _ -> false }
            p.voices.list.length == 1 && hole_ok && tail_ok
        }
    }
    given "a lex error" {
        then "it joins the diagnostics and parsing continues" {
            let p = parse_source("let a = 1\n\$\nlet b = 2")
            let lets = [s for s in p.stmts if p.store.stmt(s) is .Let]
            p.voices.list.length == 1 && lets.length == 2
        }
    }
}

spec "language — a keyword is never a callee" {
    given "a parenthesised condition, the habit every C-shaped language teaches" {
        then "`if (c) { }` parses" {
            shown("if (true) { 1 } else { 0 }") == "1"
        }
        then "`while (c) { }` parses" {
            shown("mut i = 0\nwhile (i < 1) {\n    i = i + 1\n}\ni") == "1"
        }
        then "`match (v) { }` parses" {
            shown("enum E {\n    a\n}\nmatch (E.a) {\n    .a -> 7\n}") == "7"
        }
        then "a parenthesised range bound parses" {
            shown("mut t = 0\nfor i in (0)..3 {\n    t = t + 1\n}\nt") == "3"
        }
        then "the unparenthesised forms still parse" {
            shown("if true { 1 } else { 0 }") == "1"
        }
    }
}

fn clash_gram() -> Grammar {
    grammar {
        clash_rule = NAME
    }
}
