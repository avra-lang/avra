// avra-8sb5.57.9.1: `ErrorSite`, `raised_by` and `chain` over a small
// real program — a concrete-typed fn that fails, and a `_`-declared
// fn that catches it and re-raises.
use @std.avrac.compiler.{avra, new_workspace}
use compiler.{Workspace, ErrorSite, Raised}
use @std.relation.db.{Db as RelDb, new_db}
use compiler.host.{memory_host}
use core.{DeclId, same_decl, same_expr}

fn sites_workspace(main: string) -> Workspace {
    new_workspace(
        memory_host(
            {
                "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n",
                "/w/src/main.av": main,
            },
            ["/w/avra.toml", "/w/src/main.av"],
        ),
        "/w",
        avra(),
    )
}

fn decl_named(ws: Workspace, name: string) -> DeclId {
    [x.id for x in ws.decls.all_decls() if x.name == name][0]
}

fn source() -> string {
    "fn a() -> Result<int, string> {\n" +
        "    fail \"boom\"\n" +
        "}\n" +
        "fn other() -> Result<int, string> {\n" +
        "    fail \"oops\"\n" +
        "}\n" +
        "fn b() -> Result<int, _> {\n" +
        "    let v = a() catch e -> {\n" +
        "        other()?\n" +
        "    }\n" +
        "    v\n" +
        "}\n"
}

spec "compiler/failures — error_sites, raised_by and chain over a catch+re-raise" {
    then "the program analyzes clean, and every site's owner is a real fn" {
        let ws = sites_workspace(source())
        let a = ws.analyze_file("/w/src/main.av")
        let b = decl_named(ws, "b")
        let _ = ws.raised_by(b)
        a.clean() && !ErrorSite.all(ws.failures_db.get()).is_empty()
    }
    then "invariant: a site `within` a catch shares that catch's own owner" {
        let ws = sites_workspace(source())
        let _ = ws.analyze_file("/w/src/main.av")
        let b = decl_named(ws, "b")
        let _ = ws.raised_by(b)
        let sites = ErrorSite.all(ws.failures_db.get())
        let catches = [s for s in sites if s.how is .Catch]
        catches
            .all(
                (c: ErrorSite) -> ws
                    .error_sites_within(c.owner, c.at)
                    .all((s: ErrorSite) -> same_decl(s.owner, c.owner)),
            )
    }
    then "invariant: one owner per `at` — no two rows share a site" {
        let ws = sites_workspace(source())
        let _ = ws.analyze_file("/w/src/main.av")
        let b = decl_named(ws, "b")
        let _ = ws.raised_by(b)
        let sites = ErrorSite.all(ws.failures_db.get())
        sites.all((s: ErrorSite) -> [t for t in sites if same_expr(t.at, s.at)].length == 1)
    }
    then "raised_by(b) includes the re-raised string error" {
        let ws = sites_workspace(source())
        let _ = ws.analyze_file("/w/src/main.av")
        let b = decl_named(ws, "b")
        !ws.raised_by(b).is_empty()
    }
    then "chain from the catch reaches the re-raise, and from there the re-raise has no further caller" {
        let ws = sites_workspace(source())
        let _ = ws.analyze_file("/w/src/main.av")
        let b = decl_named(ws, "b")
        let _ = ws.raised_by(b)
        let catches = [s for s in ErrorSite.all(ws.failures_db.get()) if s.how is .Catch]
        let c = catches[0]
        let tree = ws.chain(c, [])
        tree.next.length == 1 && tree.next[0].next.length == 0
    }
}

// A re-raise nested inside further control flow within the arm — an
// `if`, a `match` — and a catch whose own arm holds another catch.
// `within` is source-span containment (`innermost_catch`), never a
// direct-statement scan, so a site at any depth inside the arm is
// found the same way a shallow one is.
fn nested_source() -> string {
    "fn a() -> Result<int, string> {\n" +
        "    fail \"boom\"\n" +
        "}\n" +
        "fn other() -> Result<int, string> {\n" +
        "    fail \"oops\"\n" +
        "}\n" +
        "fn via_if(n: int) -> Result<int, _> {\n" +
        "    let v = a() catch e -> {\n" +
        "        if n > 0 {\n" +
        "            other()?\n" +
        "        } else {\n" +
        "            0\n" +
        "        }\n" +
        "    }\n" +
        "    v\n" +
        "}\n" +
        "fn via_match(n: int) -> Result<int, _> {\n" +
        "    let v = a() catch e -> {\n" +
        "        match n {\n" +
        "            0 -> other()?,\n" +
        "            rest -> 5,\n" +
        "        }\n" +
        "    }\n" +
        "    v\n" +
        "}\n" +
        "fn via_nested_catch() -> Result<int, _> {\n" +
        "    let v = a() catch e -> {\n" +
        "        other() catch e2 -> {\n" +
        "            e2.length\n" +
        "        }\n" +
        "    }\n" +
        "    v\n" +
        "}\n"
}

fn outer_catch_of(ws: Workspace, owner: DeclId) -> ErrorSite {
    let all: List<ErrorSite> = ErrorSite.all(ws.failures_db.get())
    [s for s in all if s.how is .Catch && same_decl(s.owner, owner) && s.within == null][0]
}

spec "compiler/failures — a re-raise nested inside further control flow within the arm" {
    then "a re-raise inside an `if` inside the arm is found, `within` the catch" {
        let ws = sites_workspace(nested_source())
        let _ = ws.analyze_file("/w/src/main.av")
        let f = decl_named(ws, "via_if")
        let _ = ws.raised_by(f)
        let c = outer_catch_of(ws, f)
        let inside = ws.error_sites_within(c.owner, c.at)
        inside.length == 1 && inside[0].how is .Propagate && same_decl(inside[0].owner, f)
    }
    then "a re-raise inside a `match` inside the arm is found, `within` the catch" {
        let ws = sites_workspace(nested_source())
        let _ = ws.analyze_file("/w/src/main.av")
        let f = decl_named(ws, "via_match")
        let _ = ws.raised_by(f)
        let c = outer_catch_of(ws, f)
        let inside = ws.error_sites_within(c.owner, c.at)
        inside.length == 1 && inside[0].how is .Propagate && same_decl(inside[0].owner, f)
    }
    then "a catch nested in a catch's arm is `within` the outer catch, and chain descends into it" {
        let ws = sites_workspace(nested_source())
        let _ = ws.analyze_file("/w/src/main.av")
        let f = decl_named(ws, "via_nested_catch")
        let _ = ws.raised_by(f)
        let outer = outer_catch_of(ws, f)
        let inside = ws.error_sites_within(outer.owner, outer.at)
        let tree = ws.chain(outer, [])
        inside.length == 1 &&
            inside[0].how is .Catch &&
            tree.next.length == 1 &&
            tree.next[0].site.how is .Catch &&
            tree.next[0].next.length == 0
    }
    then "every site's `within` (nested or not) still shares that catch's own owner" {
        let ws = sites_workspace(nested_source())
        let _ = ws.analyze_file("/w/src/main.av")
        let vf = decl_named(ws, "via_if")
        let vm = decl_named(ws, "via_match")
        let vn = decl_named(ws, "via_nested_catch")
        let _ = ws.raised_by(vf)
        let _ = ws.raised_by(vm)
        let _ = ws.raised_by(vn)
        let sites = ErrorSite.all(ws.failures_db.get())
        let catches = [s for s in sites if s.how is .Catch]
        catches
            .all(
                (c: ErrorSite) -> ws
                    .error_sites_within(c.owner, c.at)
                    .all((s: ErrorSite) -> same_decl(s.owner, c.owner)),
            )
    }
    then "one owner per `at` still holds across every nested shape" {
        let ws = sites_workspace(nested_source())
        let _ = ws.analyze_file("/w/src/main.av")
        let vf = decl_named(ws, "via_if")
        let vm = decl_named(ws, "via_match")
        let vn = decl_named(ws, "via_nested_catch")
        let _ = ws.raised_by(vf)
        let _ = ws.raised_by(vm)
        let _ = ws.raised_by(vn)
        let sites = ErrorSite.all(ws.failures_db.get())
        sites.all((s: ErrorSite) -> [t for t in sites if same_expr(t.at, s.at)].length == 1)
    }
}

// `ExprId` is a PER-FILE arena index — two files parsed from the SAME
// shape mint the SAME raw indexes, so a catch's `at` in one file can
// equal another file's `at` by number alone. `error_sites_within`
// must not be fooled by that: it scopes by `owner` (workspace-global)
// before ever comparing `at` (IDIOMS, avra-8sb5.57 — this is the
// adversarial case a naive `@dense` index on `ExprId` would have
// answered wrong, filing a cross-file collision as one site).
fn two_file_workspace(a: string, b: string) -> Workspace {
    new_workspace(
        memory_host(
            {
                "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n",
                "/w/src/one.av": a,
                "/w/src/two.av": b,
            },
            ["/w/avra.toml", "/w/src/one.av", "/w/src/two.av"],
        ),
        "/w",
        avra(),
    )
}

// Identical shape in both files, so each catch's `at` mints the SAME
// arena index — the collision `error_sites_within` must see through.
fn twin_source(fail_name: string, catcher_name: string) -> string {
    "fn ${fail_name}() -> Result<int, string> {\n" +
        "    fail \"boom\"\n" +
        "}\n" +
        "export fn ${catcher_name}() -> Result<int, _> {\n" +
        "    let v = ${fail_name}() catch e -> {\n" +
        "        ${fail_name}()?\n" +
        "    }\n" +
        "    v\n" +
        "}\n"
}

spec "compiler/failures — two files whose catch sites share one raw ExprId index" {
    then "each file's chain lists only its own nested site, never the other file's" {
        let ws = two_file_workspace(twin_source("a", "one"), twin_source("a", "two"))
        let _ = ws.analyze_file("/w/src/one.av")
        let _ = ws.analyze_file("/w/src/two.av")
        let one = decl_named(ws, "one")
        let two = decl_named(ws, "two")
        let _ = ws.raised_by(one)
        let _ = ws.raised_by(two)
        let sites = ErrorSite.all(ws.failures_db.get())
        let catch_one = [s for s in sites if s.how is .Catch && same_decl(s.owner, one)][0]
        let catch_two = [s for s in sites if s.how is .Catch && same_decl(s.owner, two)][0]
        // the collision this test exists to force: same raw index, different files
        let collides = same_expr(catch_one.at, catch_two.at)
        let tree_one = ws.chain(catch_one, [])
        let tree_two = ws.chain(catch_two, [])
        collides &&
            tree_one.next.length == 1 &&
            same_decl(tree_one.next[0].site.owner, one) &&
            tree_two.next.length == 1 &&
            same_decl(tree_two.next[0].site.owner, two)
    }
}

// `Raised` is the fixpoint's own relation: one row per inferring fn,
// written by the solve alone, the last solve's rows swept by the next.
fn mutual_source() -> string {
    "enum A {\n    A\n}\nenum B {\n    B\n}\n" +
        "fn f(n: int) -> Result<int, _> {\n    if n <= 0 {\n        fail A.A\n    }\n    g(n - 1)?\n}\n" +
        "fn g(n: int) -> Result<int, _> {\n    if n <= 0 {\n        fail B.B\n    }\n    f(n - 1)?\n}\n"
}

spec "compiler/failures — `Raised` rows are the fixpoint's own" {
    then "one row, for the one inferring fn, holding its re-raised error" {
        let ws = sites_workspace(source())
        let _ = ws.analyze_file("/w/src/main.av")
        let b = decl_named(ws, "b")
        let _ = ws.raised_by(b)
        let rows = Raised.all(ws.failures_db.get())
        rows.length == 1 && same_decl(rows[0].owner, b) && rows[0].errors.length == 1
    }
    then "a concretely typed fn has no row, and reads empty" {
        let ws = sites_workspace(source())
        let _ = ws.analyze_file("/w/src/main.av")
        let a = decl_named(ws, "a")
        ws.raised_by(a).is_empty() && Raised.by_owner(ws.failures_db.get(), a).is_empty()
    }
    then "a mutually recursive pair's rows each hold the closed union" {
        let ws = sites_workspace(mutual_source())
        let _ = ws.analyze_file("/w/src/main.av")
        let f = decl_named(ws, "f")
        let g = decl_named(ws, "g")
        ws.raised_by(f).length == 2 &&
            ws.raised_by(g).length == 2 &&
            Raised.all(ws.failures_db.get()).length == 2
    }
    then "a second solve replaces the first's rows rather than adding to them" {
        let ws = sites_workspace(mutual_source())
        let _ = ws.analyze_file("/w/src/main.av")
        let f = decl_named(ws, "f")
        let g = decl_named(ws, "g")
        let _ = ws.failures()
        ws.solve_raised([f, g])
        ws.solve_raised([f])
        let rows = Raised.all(ws.failures_db.get())
        rows.length == 1 && same_decl(rows[0].owner, f) && rows[0].errors.length == 2
    }
}

once fn raised_heard() -> Cell<List<string>> { Cell.new([]) }

fn raised_noted(w: string) {
    let h = raised_heard()
    h.push(w)
}

/// A Db that records a refusal instead of trapping, so the ownership
/// law's own words can be asserted.
fn noting_db() -> RelDb {
    let db = new_db()
    db.heard_by(raised_noted)
    db
}

spec "compiler/failures — `Raised` read inside its owner's own run" {
    then "is refused, naming `prior(db)`" {
        let db = noting_db()
        let owner = db.cell(0, 0)
        db.began(owner)
        let _ = Raised.insert(db, owner: DeclId { index: 0 }, errors: [])
        let _ = Raised.by_owner(db, DeclId { index: 0 })
        db.ended(owner)
        raised_heard().get().length == 1 && raised_heard().get()[0].contains("prior(db)")
    }
}
