/// A node a seat refused in a written item, where it stands, its seat, what the seat wants and the
/// node is, spelled, and whether the node is a spread.
@derive(Saved)
type RefusedSeat = { at: FindingAt?, seat: Seating, want: string, found: string, note: SugarNote? = null, spread: bool = false, instance: string? = null }

/// What the sugar a refused node's operator means says of itself, where it stands.
@derive(Saved)
type SugarNote = { label: string, at: FindingAt? }

/// What every seat refused in one written item, and every name read there that nothing declares.
@derive(Saved)
type ItemRefusals = {
    rows: List<RefusedSeat>,
    unread: List<UnreadName> = [],
    seated: List<ConstSeated> = [],
    broken: List<ConstBroken> = [],
    /// Each bare pattern name a body's typing read as a const's, which compares rather than binds,
    /// where it stands.
    compared: List<FindingAt> = [],
}

/// A const a body declares whose run, at compile time, broke a settlement's law: where its value
/// stands, its name, the kind it is refused as, and the words its voice is handed.
@derive(Saved)
export type ConstBroken = { at: FindingAt?, name: string, kind: string, words: string }

/// A body const whose value reads a seat that holds a value only while its fn runs: where its value
/// stands, its name, and the seat's.
@derive(Saved)
type ConstSeated = { at: FindingAt?, name: string, seat: string }

/// A name read that nothing binds or declares, where it stands: the name, how it's read, and whether
/// the read is written where it stands rather than copied from a template.
@derive(Saved)
type UnreadName = { at: FindingAt?, name: string, read: ReadAs, written_here: bool }

/// A typed body beside the store its nodes stand in.
type StoredBody = { store: SyntaxArena, typed: TypedBody }

/// Every node a seat refused, and every name read that nothing binds or declares, in the written
/// item `at` of `file`: in the bodies it declares, then in the statements it runs where its file is
/// an entry. A body that didn't parse refuses nothing.
@query("laws")
fn item_refusals(engine: QueryEngine, file: SourceFileAddress, at: ItemId) -> ItemRefusals {
    if !item_judged(engine, file, at) { return ItemRefusals { rows: [] } }
    let item = read_item(engine, file, at)
    if !item.store.refusals().is_empty() { return ItemRefusals { rows: [] } }
    let bodies = [StoredBody { store: item.store, typed: b } for b in item_bodies(engine, file, at, item)]
        .concat(
            [StoredBody {
                store: b.item.store,
                typed: kept_body(body_checked(engine, file, b, false)),
            } for b in default_bodies(engine, file, at, item)],
        )
    let cases = [StoredBody { store: c.item.store, typed: kept_body(body_checked(engine, file, c, false)) } for c in case_bodies(engine, file, at)]
    let worn = [StoredBody { store: item.store, typed: kept_body(body_checked(engine, file, b, false)) } for b in annotation_bodies(engine, file, item)]
    let entry = entry_found(engine, file)
    ItemRefusals {
        rows: flatten([refusals_placed(b.store, b.typed.refused) for b in bodies.concat(worn)])
            .concat([case_seated(r) for b in cases for r in refusals_placed(b.store, b.typed.refused)])
            .concat([r.seat for r in entry.refused if r.item == at]),
        unread: flatten(
            [unread_placed(b.store, [u for u in b.typed.unread if !answered(engine, file, u)]) for b in bodies.concat(cases).concat(worn)],
        )
            .concat([u.name for u in entry.unread if u.item == at]),
        seated: flatten([seats_placed(b.store, b.typed.seats_read) for b in bodies]),
        broken: flatten([consts_broken(engine, file, b) for b in bodies]),
        compared: flatten([compared_placed(b.store, b.typed.binds) for b in bodies.concat(cases)])
            .concat(entry.compared),
    }
}

/// Where each bare pattern name among `binds`, bound in `store`, that compares stands.
fn compared_placed(store: SyntaxArena, binds: List<NameBound>) -> List<FindingAt> {
    [at! for b in binds if b.compared for p in some_list(pat_site(b.site)) for at in [kept_at(store.pat_span(p))] if at != null]
}

/// The pattern a binding's site is, absent for any other site.
fn pat_site(site: BindSite) -> PatId? {
    match site { .Pat(p) -> PatId { index: p }, rest -> null }
}

/// Whether the bare name `name` of the pattern `p`, standing in `store` in the written item `at` of
/// `file`, compares the subject with a const rather than binds: by what the name is bound to where
/// the pattern stands, as the body's typing read it, or a const only a generator makes.
fn pattern_compares(
    engine: QueryEngine,
    file: SourceFileAddress,
    at: ItemId,
    store: SyntaxArena,
    p: PatId,
    name: string,
) -> bool {
    let span? = kept_at(store.pat_span(p)) else { return false }
    item_refusals(engine, file, at).compared.any(it.lo == span.lo && it.hi == span.hi) ||
        compared_value(engine, file, name) == null
}

/// Each const the body `b` declares whose type has no compile-time value form, and each one that
/// settles at compile time — its value reading, of what the body binds, only the consts before it
/// that settled — whose run broke a settlement's law, each
/// worked out in the order the body binds them, handed those before it as they settled.
fn consts_broken(engine: QueryEngine, file: SourceFileAddress, b: StoredBody) -> List<ConstBroken> {
    let names = NamesRead { reads: b.typed.reads, binds: b.typed.binds }
    mut settled: Map<string, ConstSeed> = {}
    mut broken: List<ConstBroken> = []
    for bound in b.typed.binds {
        let i? = match bound.site { .Stmt(i) -> i, rest -> null } else { continue }
        let s = StmtId { index: i }
        let value? = b.store.const_value(s) else { continue }
        let ty? = bound.ty else { continue }
        if !const_written(b.store.valued(value)) && !const_formed(engine, file, ty) {
            broken
                .push(
                    ConstBroken {
                        at: kept_at(b.store.expr_span(value)),
                        name: bound.name,
                        kind: FORM,
                        words: ty.spelled(),
                    },
                )
            continue
        }
        let consts? = body_const_reads(b.store, names, value) else { continue }
        let seeds = [settled.get("${c.index}") for c in consts]
        if seeds.any(it == null) { continue }
        let run = body_const_settlement(
            engine,
            file,
            b.store,
            LAW_UNIT,
            s,
            ty,
            [seed! for seed in seeds],
        )
        let breach = run.broken
        if breach != null {
            broken
                .push(
                    ConstBroken {
                        at: kept_at(b.store.expr_span(value)),
                        name: bound.name,
                        kind: breach!.kind,
                        words: breach!.words,
                    },
                )
        } else if run.unsettled == null {
            settled
                .set(
                    "${i}",
                    ConstSeed {
                        name: bound.name,
                        ty: ty,
                        value: NamedValue.Settled(run.words, run.data!),
                    },
                )
        }
    }
    broken
}

/// The unit a law's own settling of a body's consts names them under.
const LAW_UNIT: string = "settling"

/// What `rows`, read in `store`, are where the consts that read them stand.
fn seats_placed(store: SyntaxArena, rows: List<SeatReadAt>) -> List<ConstSeated> {
    [ConstSeated {
        at: kept_at(store.expr_span(store.const_value(StmtId { index: r.stmt })!)),
        name: store.let_name(StmtId { index: r.stmt }) ?? "this const",
        seat: r.name,
    } for r in rows]
}

/// Each body const in the written item `at` of `file` whose value reads a seat that holds a value
/// only while its fn runs: at its value, its voice handed its name and the seat's.
fn consts_seated(engine: QueryEngine, file: SourceFileAddress, at: ItemId) -> List<Found> {
    [Found { at: span_of(c.at), args: [c.name, c.seat] } for c in item_refusals(engine, file, at).seated]
}

fn seated_said(a: List<string>) -> Voice { unsettled_voice(a[0], Unsettled.Param(a[1]))! }

/// a const in a body whose value reads a seat that holds a value only while its fn runs
export law const_param {
    kind: "const.param"
    reads: consts_seated
    voice: seated_said
    witness: "fn f(n: int) -> int {\n    const X: int = n + 1\n    X\n}\n"
}

/// What `rows`, read in `store` and answered by nothing, are where they stand.
fn unread_placed(store: SyntaxArena, rows: List<UnreadAt>) -> List<UnreadName> {
    [UnreadName {
        at: kept_at(store.expr_span(ExprId { index: u.at })),
        name: u.name,
        read: u.read,
        written_here: store.home_of(ExprId { index: u.at }) == null,
    } for u in rows]
}

/// What `rows`, refused in `store`, are where they stand.
fn refusals_placed(store: SyntaxArena, rows: List<RefusedAt>) -> List<RefusedSeat> {
    [RefusedSeat {
        at: kept_at(refused_place(store, r)),
        seat: r.seat,
        want: r.want.spelled(),
        found: r.found.spelled(),
        note: sugar_noted(store, r.seat, r.at),
        spread: store.spread_operand(ExprId { index: r.at }) != null,
        instance: handed_by(store, ExprId { index: r.at }, r.seat),
    } for r in rows]
}

/// The component whose instance hands what the program wrote, holding the refused `e`, to a call
/// its template wrote, where `seat` is that call's argument seat: the word of the innermost instance
/// whose expansion holds the call. Absent for an argument of a call the program wrote, and for any
/// other seat.
fn handed_by(store: SyntaxArena, e: ExprId, seat: Seating) -> string? {
    if !(seat is .Argument) || store.spanned_elsewhere(e) { return null }
    let call? = [c for i in 0..store.expr_count() for c in [ExprId { index: i }] if store.spanned_elsewhere(c) &&
        store
            .expr_children(c)
            .any((a) -> !store.spanned_elsewhere(a) && store.every_expr(a).contains(e))]
        .first() else { return null }
    let inner? = innermost_instance(store, call) else { return null }
    match store.expr(inner) { .Component(word, _, _, _, _, _) -> word, rest -> null }
}

/// The note a refusal inside the meaning of a sugar says beside it: the sugar's own words, where it
/// stands — an operand's sugar, or the sugar whose pattern is refused at `node`; absent for any other.
fn sugar_noted(store: SyntaxArena, seat: Seating, node: int) -> SugarNote? {
    let at? = match seat {
        .Operand(_, sugar) -> if sugar < 0 { null } else { ExprId { index: sugar } },
        .Misshapen(_, _, _) -> ExprId { index: node },
        rest -> null,
    } else { return null }
    let label? = store.means_note(at) else { return null }
    SugarNote { label: label, at: kept_at(store.expr_span(at)) }
}

/// The names of the fields the record or component `file` declares as `name` has, each once.
fn fields_named_once(engine: QueryEngine, file: SourceFileAddress, name: string) -> List<string> {
    let names = [f.name for f in record_signature(engine, file, name)?.fields ?? []]
    [n for j, n in names if names.index_of(n) == j]
}

/// The bodies a written item holds beside its fns' and methods': each seat's default a fn or a
/// method writes, each record's and component's field default, each const's value and each state's start, and each
/// body a trait's own members write.
fn default_bodies(engine: QueryEngine, file: SourceFileAddress, at: ItemId, item: ReadItem) -> List<
    SignedBody,
> {
    let names = [d for d in file_declares_at(engine, file, at).names if d.item == at]
    let fns = [s! for d in names if d.kind == ItemKind.Fn &&
        item.stmts.any((s) -> item.store.fn_parts(s)?.name == d.name && defaults_a_seat(item, s)) for s in [signed_body(engine, file, d.name)] if s != null]
    let methods = [m!.signed for a in impls_at(engine, file, at) for s in impl_fns(item, a) if defaults_a_seat(item, s) for m in [signed_method(engine, a, item.store.fn_parts(s)!.name, item.store.is_static(s))] if m != null]
    let seats = [b! for s in fns.concat(methods) for p in s.signature.params for b in [seat_default_body(s, p.name)] if b != null]
    let fields = [b! for d in names if d.kind == ItemKind.Record || d.kind == ItemKind.Component for n in fields_named_once(engine, file, d.name) for b in [field_default_body(engine, file, d.name, n)] if b != null]
    let consts = [b for d in names if d.kind == ItemKind.Const for b in some_list(const_body_of(engine, d))]
    let states = [b for d in names if d.kind == ItemKind.State for b in some_list(state_body(engine, d))]
    let contexts = [b for d in names if d.kind == ItemKind.Ctx for b in some_list(context_body(engine, d))]
    seats.concat(fields).concat(consts).concat(states).concat(contexts)
}

/// The callee and each argument of every annotation a declaration of `item` wears, each a body of
/// its own: read for the names it reads, as an expression is, and an argument filling a seat of
/// the annotation's fn that takes a value typed against that seat, as a call's is.
fn annotation_bodies(engine: QueryEngine, file: SourceFileAddress, item: ReadItem) -> List<
    SignedBody,
> {
    [b for s in item.stmts if item.store.is_declaration(s) && source_wrote_stmt(item.store, s) for a in item.store.annotations_of(s) if !example_marks(a.name) && item.store.foreign_of(a.callee) == null for b in annotation_read(engine, file, item, s, a)]
}

/// The annotation `a` on the statement `s`, as the bodies its callee and arguments are.
fn annotation_read(
    engine: QueryEngine,
    file: SourceFileAddress,
    item: ReadItem,
    s: StmtId,
    a: Annotation,
) -> List<SignedBody> {
    let seats = value_seats(engine, file, a.name)
    let written = [e for e in a.args if item.store.arg_label(e) == null]
    let words = annotation_field_words(engine, file, item.store, a, has_fields(item.store, s))
    let callee = if names_a_binding(engine, file, a.name) { [] } else { [annotation_body(item, s, a.callee, null, a.name)] }
    callee
        .concat(
            [annotation_body(item, s, e, seat_filled(seats, written.index_of(e)), a.name) for e in a.args if !words.contains(item.store.unnamed(e))],
        )
}

/// Whether the annotation `name`, read in `file`, names a run-time binding of the top level and no
/// declaration: refused as naming no fn, never read as a value.
fn names_a_binding(engine: QueryEngine, file: SourceFileAddress, name: string) -> bool {
    resolved(engine, file, Space.Value, name).named() == null &&
        top_level_defined(engine, file).contains(name)
}

/// The type the seat `at` among `seats` takes; absent past them, or for an argument that fills none.
fn seat_filled(seats: List<SignedType?>, at: int) -> SignedType? { if at >= 0 && at < seats.length { seats[at] } else { null } }

/// One expression of an annotation as a body: checked against `seat` where it fills one, else free.
fn annotation_body(item: ReadItem, s: StmtId, e: ExprId, seat: SignedType?, name: string) -> SignedBody {
    let free = SignedBody {
        signature: value_signature(owned_type("void")),
        item: item,
        body: e,
        stmt: s,
        want: Expected.Free,
    }
    let held? = seat else { return free }
    free with { signature: value_signature(held), want: null, seat: Seating.AnnotationSeat(name) }
}

/// The type of each seat past the first of the fn `name` names from `file`, where that fn takes a
/// declaration first — absent for a seat that takes a declaration or code itself, which an
/// argument's name or quote crosses into; none for a rule, or a name that names no such fn.
fn value_seats(engine: QueryEngine, file: SourceFileAddress, name: string) -> List<SignedType?> { [if crossed_seat(p.ty) { null } else { p.ty } for p in annotation_seats(engine, file, name)] }

/// Each seat past the first of the fn `name` names from `file`, where that fn takes a declaration
/// first; none for a rule, or a name that names no such fn.
export fn annotation_seats(engine: QueryEngine, file: SourceFileAddress, name: string) -> List<
    SignedParam,
> {
    let sig? = annotating_signature(engine, file, name) else { return [] }
    sig.params.drop(1)
}

/// The signature of the fn `name` names from `file`, where that fn takes a declaration first;
/// absent for a rule, or a name that names no such fn.
fn annotating_signature(engine: QueryEngine, file: SourceFileAddress, name: string) -> FnSignature? {
    let d? = resolved(engine, file, Space.Value, name).named() else { return null }
    if d.kind != ItemKind.Fn { return null }
    let sig? = fn_signature(engine, d.file, d.name) else { return null }
    if takes_a_declaration(sig.params.first()?.ty) { sig } else { null }
}

/// THE WORDS AN ANNOTATION WRITES AS NAMES OF ITS DECLARATION'S FIELDS, read among them and never
/// as expressions: each filling a seat of its fn that takes fields, and — on a declaration with
/// fields (`fielded`), its fn taking the declaration — each named argument written as a bare word,
/// which fills no seat and names a field as a field's own mark does. None for an annotation whose fn
/// takes no declaration.
export fn annotation_field_words(
    engine: QueryEngine,
    file: SourceFileAddress,
    store: SyntaxArena,
    a: Annotation,
    fielded: bool,
) -> List<ExprId> {
    let sig? = annotating_signature(engine, file, a.name) else { return [] }
    let seated = seat_field_words(
        sig.params.drop(1),
        [e for e in a.args if store.arg_label(e) == null],
    )
    if !fielded { return seated }
    seated
        .concat(
            [v for e in a.args if store.arg_label(e) != null for v in [store.unnamed(e)] if store.ident_name(v) != null],
        )
}

/// Whether the statement `s` declares what has fields an annotation may name: a record, a component.
export fn has_fields(store: SyntaxArena, s: StmtId) -> bool { store.struct_parts(s) != null || store.component_parts(s) != null }

/// Whether a seat of type `ty` takes what crosses rather than a value: a type `@std/meta` declares —
/// a declaration, code — at any depth of absence.
fn crossed_seat(ty: SignedType?) -> bool {
    let t? = ty else { return true }
    match t.head { .Declared(file, _) -> file.package_name == "@std/meta", rest -> false }
}

/// Whether the fn `s` in `item` writes a default for any of its seats.
fn defaults_a_seat(item: ReadItem, s: StmtId) -> bool { item.store.fn_parts(s)?.params?.any(it.default != null) ?? false }

/// The fns the impl `at` names in `item` writes, each with a body.
fn impl_fns(item: ReadItem, at: ImplAt) -> List<StmtId> {
    [f for s in some_list(impl_stmt_at(item, at)) for f in item.store.impl_parts(s)!.fns if item.store.fn_parts(f) != null]
}

/// Each body a trait's own members write: a static's, `Self` none, and a method's as the first type
/// of the trait's package that leaves the method to it answers it, `Self` that type.
fn trait_bodies(engine: QueryEngine, t: TraitAt) -> List<SignedBody> {
    let item? = trait_item(engine, t) else { return [] }
    let written = [s for s in trait_fns(item) if item.store.fn_parts(s) != null && written_body(item, s)]
    let heirs = if written.any((s) -> !item.store.is_static(s)) { heirs_of(engine, t) } else { [] }
    [b for s in written for b in some_list(given_signed(engine, t, heirs, item.store.fn_parts(s)!.name, item.store.is_static(s)))]
}

/// The body the trait `t` writes for its member `name`, signed: a static's with no `Self`, a
/// method's as the first type of its package that leaves it to the trait answers it, the trait's own
/// parameters what that type's impl applies it to. Absent where no type there does.
fn given_signed(engine: QueryEngine, t: TraitAt, heirs: List<Heir>, name: string, statics: bool) -> SignedBody? {
    if statics { return trait_static_body(engine, t, name) }
    let heir? = heirs.find(!it.writes.contains(name)) else { return null }
    let written? = given_body(engine, t, name) else { return null }
    let receiver = headed_type(TypeHead.Declared(heir.file, heir.name))
    let giver = default_givers(engine, heir.file, heir.name, name)
        .find((g) -> same_file(g.giver.file, t.file) && g.giver.name == t.name)
    let signature? = (if giver == null { trait_method_signature(engine, t, name, receiver) } else { given_signature(engine, giver!, name, receiver) }) else {
        return null
    }
    SignedBody {
        signature: signature,
        item: written.item,
        body: written.item.store.fn_parts(written.stmt)!.body,
        stmt: written.stmt,
        receiver: receiver,
        receiver_written: receiver_use(engine, heir.file, heir.name, name, t.file.package_name).written(),
    }
}

/// A type an impl over no parameters makes implement a trait: the trait, where the type is declared
/// and its name, and the methods that impl writes.
@derive(Saved)
type Heir = { implements: TraitAt, file: SourceFileAddress, name: string, writes: List<string> }

/// Every heir a package's written impls make, in the order its files and their items stand.
@derive(Saved)
type PackageHeirs = { heirs: List<Heir> }

/// Each type of the trait `t`'s package an impl over no parameters makes implement it.
fn heirs_of(engine: QueryEngine, t: TraitAt) -> List<Heir> {
    package_heirs(engine, t.file.package_name)
        .heirs
        .filter(it.implements.name == t.name && same_file(it.implements.file, t.file))
}

/// Every type of `package` an impl over no parameters makes implement a trait, its files read once
/// for all of its traits.
@query("summary")
fn package_heirs(engine: QueryEngine, package: string) -> PackageHeirs {
    let files = [SourceFileAddress { package_name: package, path_in_package: p } for p in package_sources(engine, package, "src")]
    PackageHeirs {
        heirs: [h! for f in files for held in written_impls(engine, f) for i in held for h in [heir_in(engine, f, i)] if h != null],
    }
}

/// The heir the impl `i` in `f` makes, where it implements a trait over a type that takes no
/// parameters.
fn heir_in(engine: QueryEngine, f: SourceFileAddress, i: ItemImpl) -> Heir? {
    let named? = i.implements else { return null }
    let tr? = impl_named(engine, f, i.trait_in, named) else { return null }
    let d? = impl_target(engine, f, i) else { return null }
    if !impl_params(engine, i, d).is_empty() { return null }
    Heir {
        implements: TraitAt { file: tr.file, name: tr.name },
        file: d.file,
        name: d.name,
        writes: i.methods,
    }
}

/// The `const` `d`'s value as a body, where it declares the type the value is held to.
fn const_body_of(engine: QueryEngine, d: DeclaredName) -> SignedBody? {
    if binding_type(engine, d.file, d.name) == null && !built_instance(engine, d) { return unknown_const_body(engine, d) }
    match const_body(engine, d) { .Ok(b) -> b, .Err(_) -> null }
}

/// The `const` `d`, written with no type, whose value's type isn't known, as a body the laws read:
/// that value under no want, so a name it reads that nothing answers is said. Absent where its value
/// types, which `const_value_type` reads.
fn unknown_const_body(engine: QueryEngine, d: DeclaredName) -> SignedBody? {
    if const_value_type(engine, d.file, d.name) != null { return null }
    let item = read_item(engine, d.file, d.item)
    let stmt? = item
        .stmts
        .find((s) -> item.store.let_name(s) == d.name && item.store.const_value(s) != null) else { return null }
    SignedBody {
        signature: value_signature(owned_type("void")),
        item: item,
        body: item.store.const_value(stmt)!,
        stmt: stmt,
        want: Expected.Free,
        seat: Seating.Binding(d.name),
    }
}

/// A node a seat refused among an entry's statements, and the written item it stands in.
@derive(Saved)
type EntryRefused = { item: ItemId, seat: RefusedSeat }

/// A name an entry's statements read that nothing binds or declares, and the written item it stands
/// in.
@derive(Saved)
type EntryUnread = { item: ItemId, name: UnreadName }

/// What a seat refused, and every name read that nothing binds or declares, among the statements an
/// entry runs.
@derive(Saved)
type EntryFound = { refused: List<EntryRefused>, unread: List<EntryUnread>, compared: List<FindingAt> = [] }

/// What a seat refused, and every name read that nothing binds or declares, among the statements the
/// entry `file` runs, each with the written item it stands in: the entry read and typed once, as one
/// body, for all of its items.
@query("laws")
fn entry_found(engine: QueryEngine, file: SourceFileAddress) -> EntryFound {
    let read = entry_read(engine, file)
    let signed? = entry_signed(read) else { return EntryFound { refused: [], unread: [] } }
    let typed = kept_body(body_checked(engine, file, signed, false))
    EntryFound {
        refused: [EntryRefused { item: item_holding(read, r.at), seat: s } for r in typed.refused for s in refusals_placed(read.store, [r])],
        unread: [EntryUnread { item: item_holding(read, u.at), name: n } for u in typed.unread if !answered(engine, file, u) for n in unread_placed(read.store, [u])],
        compared: compared_placed(read.store, typed.binds),
    }
}

/// The written item an entry's node at `at` stands in: the last whose nodes start at or before it.
fn item_holding(read: EntryRead, at: int) -> ItemId { read.items.filter(it.base <= at).last()?.at ?? ItemId(-1) }

/// Every node a seat refused in the written item `at` of `file`, as its laws read them.
fn refused_in(engine: QueryEngine, file: SourceFileAddress, at: ItemId) -> List<RefusedSeat> { item_refusals(engine, file, at).rows }

/// Whether a refusal is of a variant an `is` asks for, which is said at the `is`.
fn asked_variant(seat: Seating) -> bool { match seat { .Unvaried(_, _, _, asked) -> asked, rest -> false } }

/// Where a refusal is said: the pattern it names — the test where an `is` asks a variant its enum
/// doesn't declare — the `return` statement its value stands in, else the refused node.
fn refused_place(store: SyntaxArena, r: RefusedAt) -> Span? {
    if r.pat != null && !asked_variant(r.seat) { return store.pat_span(PatId { index: r.pat! }) }
    match r.seat {
        .Return(stmt) or .Fnless(stmt) or .Bare(stmt) or .Assigned(_, stmt) or .Raised(stmt) -> store.stmt_span(StmtId { index: stmt }),
        .Unwalked(_, _, call) or .Unpredicated(_, _, call) -> store.expr_span(ExprId { index: call }),
        .Argument(_, _) or .Method(_, _, _) or .Field(_) or .Payload(_, _) or .Binding(_) or .Body(_) or .Hole(_) or .Condition(_) or .FieldDefault(_) or .AnnotationSeat(_) or .SeatDefault(_) or .Pronoun or .Index or .Element or .MapKey or .MapValue or .Uncovered(_, _) or .Catchless(_) or .Refutable(_) or .Unmatchable or .Repeated(_) or .Unbinding(_, _) or .Arity(_, _, _) or .BindsTwice(_) or .ElementsApart(_) or .SpreadUnlike(_) or .SpreadPlace(_, _) or .Restless(_) or .VariantCount(_, _, _, _) or .Misshapen(_, _, _) or .OrBinds(_, _, _) or .PayloadOutside or .Isolated(_, _, _) or .Sealed(_, _, _) or .Computed(_, _) or .Walk(_, _, _, _) or .Unwritten(_, _) or .Valued(_) or .Unvaried(_, _, _, _) or .Handed(_, _, _, _) or .Unwaited(_) or .Nameless(_, _) or .Operand(_, _) or .Negated or .Compared(_, _) or .TwoNames or .Unnamed or .KeptArm or .Arm(_) or .Lambda(_) or .Unenumed(_, _, _) or .Unmatched or .Unasked or .Shaped or .Unlistable(_) or .CellUnmapped(_) or .ExternValue(_, _, _) or .SeatNamed(_, _, _, _) or .CompUnwalked(_) or .NotOffered(_, _, _) or .Unwaitable(_) or .ArmBinder(_, _, _) or .SpentArm or .SelectFault(_) or .HoleFault(_) or .Fateless(_) or .Miscounted(_, _, _, _, _, _, _, _) or .OneFn(_, _) or .WalkSeats(_, _) or .Block(_, _, _) or .ArmApart(_) or .BranchesApart or .WhenApart or .FieldRepeated(_) or .Uncalled(_, _) or .FailureUnpromised(_, _) or .AbsenceUnpromised(_, _) or .FailuresApart(_, _) or .RangeBound(_) or .Caught(_) or .CaughtArm or .Voided or .Within(_) or .Guarantee(_) or .ForUnwalked(_) or .Literal(_) or .Unimplemented or .Folded(_) or .Pinned(_, _, _) or .Unpinned(_, _) or .CompBound(_) or .NullPin(_, _) or .TypeHole(_) or .Unprojected(_) or .Unknowable(_) or .CellHolds or .DefaultUnimplemented(_) or .StaticUnpinned(_, _) or .Heard(_) or .LiteralUnpinned(_, _, _, _) -> written_span(store, ExprId { index: r.at }),
    }
}

/// Where the node `e` is said: its own span, or, where a component's template wrote it — its span
/// in the template's text, which this file does not hold — the instance whose expansion holds it,
/// the innermost, which is where the program wrote the call it makes.
fn written_span(store: SyntaxArena, e: ExprId) -> Span? {
    if !store.spanned_elsewhere(e) { return store.expr_span(e) }
    let inner? = innermost_instance(store, e) else { return null }
    store.expr_span(inner)
}

/// The innermost instance the program wrote whose expansion holds the node `e`; absent for a node
/// no expansion holds.
fn innermost_instance(store: SyntaxArena, e: ExprId) -> ExprId? {
    let instances = [x for i in 0..store.expr_count() for x in [ExprId { index: i }] if !store.spanned_elsewhere(x) &&
        store.expansion_of(x) != null &&
        store.every_expr(store.expansion_of(x)!).contains(e)]
    instances.find((x) -> !instances.any((o) -> o != x && store.every_expr(x).contains(o)))
}

/// A refusal as its law's voice is handed it: the seat's own words, then what it wants and what it
/// found.
fn found_in(r: RefusedSeat, words: List<string>) -> Found { Found { at: span_of(r.at), args: words.concat([r.want, r.found]) } }

/// The refusal `r` said where it stands, its voice handed `words`.
fn found_saying(r: RefusedSeat, words: List<string>) -> List<Found> { [Found { at: span_of(r.at), args: words }] }

/// A kept place as a span.
fn span_of(at: FindingAt?) -> Span? {
    let held? = at else { return null }
    Span { lo: held.lo, hi: held.hi }
}

/// An argument of a fn a seat refused: the fn, its place.
fn arguments_refused(engine: QueryEngine, file: SourceFileAddress, at: ItemId) -> List<Found> {
    let text = item_text(engine, file, at)
    flatten([argument_words(r, text) for r in refused_in(engine, file, at) if r.instance == null])
}

/// Each argument an instance's expansion hands to a seat it does not fill, in the instance's words.
fn instance_seats_unfilled(engine: QueryEngine, file: SourceFileAddress, at: ItemId) -> List<Found> {
    [Found { at: span_of(r.at), args: [r.instance!, r.want, r.found] } for r in refused_in(engine, file, at) if r.instance != null]
}

/// what an instance is written with fills the seat its expansion hands it to
export law instance_seat_mismatch {
    kind: "type.mismatch"
    reads: instance_seats_unfilled
    voice: instance_seat_words
    witness: "use @std.meta.{Code}\n\ntype Req<R> = { p: R }\n\ntype In = { a: int }\n\nexport fn takes(serve: fn(Req<int>) -> int) -> int { 1 }\n\nexport component served(name: string) {\n    body: Code\n    fn expand() -> Code {\n        quote { takes(\${self.body}) }\n    }\n}\n\nfn g() -> int { served \"x\" { (inp: In) -> inp.a } }\n"
}

fn instance_seat_words(a: List<string>) -> Voice { instance_seat_unfilled(a[0], a[1], a[2]) }

fn argument_words(r: RefusedSeat, text: string) -> List<Found> {
    match r.seat {
        .Argument(callee, place) -> [seat_converted(found_in(r, [callee, "${place + 1}"]), r, text)],
        .Method(_, _, _) or .Field(_) or .Payload(_, _) or .Binding(_) or .Return(_) or .Body(_) or .Hole(_) or .Condition(_) or .FieldDefault(_) or .AnnotationSeat(_) or .SeatDefault(_) or .Pronoun or .Index or .Element or .MapKey or .MapValue or .Uncovered(_, _) or .Catchless(_) or .Refutable(_) or .Unmatchable or .Repeated(_) or .Unbinding(_, _) or .Arity(_, _, _) or .BindsTwice(_) or .ElementsApart(_) or .SpreadUnlike(_) or .SpreadPlace(_, _) or .Restless(_) or .VariantCount(_, _, _, _) or .Misshapen(_, _, _) or .OrBinds(_, _, _) or .PayloadOutside or .Isolated(_, _, _) or .Sealed(_, _, _) or .Computed(_, _) or .Walk(_, _, _, _) or .Unwalked(_, _, _) or .Unwritten(_, _) or .Valued(_) or .Unvaried(_, _, _, _) or .Handed(_, _, _, _) or .Unwaited(_) or .Nameless(_, _) or .Operand(_, _) or .Negated or .Compared(_, _) or .TwoNames or .Unnamed or .KeptArm or .Arm(_) or .Lambda(_) or .Unenumed(_, _, _) or .Unmatched or .Unasked or .Fnless(_) or .Bare(_) or .Shaped or .Unlistable(_) or .CellUnmapped(_) or .ExternValue(_, _, _) or .SeatNamed(_, _, _, _) or .CompUnwalked(_) or .NotOffered(_, _, _) or .Unwaitable(_) or .ArmBinder(_, _, _) or .SpentArm or .SelectFault(_) or .HoleFault(_) or .Fateless(_) or .Miscounted(_, _, _, _, _, _, _, _) or .OneFn(_, _) or .WalkSeats(_, _) or .Block(_, _, _) or .Unpredicated(_, _, _) or .Assigned(_, _) or .ArmApart(_) or .BranchesApart or .WhenApart or .FieldRepeated(_) or .Uncalled(_, _) or .FailureUnpromised(_, _) or .AbsenceUnpromised(_, _) or .FailuresApart(_, _) or .Raised(_) or .RangeBound(_) or .Caught(_) or .CaughtArm or .Voided or .Within(_) or .Guarantee(_) or .ForUnwalked(_) or .Literal(_) or .Unimplemented or .Folded(_) or .Pinned(_, _, _) or .Unpinned(_, _) or .CompBound(_) or .NullPin(_, _) or .TypeHole(_) or .Unprojected(_) or .Unknowable(_) or .CellHolds or .DefaultUnimplemented(_) or .StaticUnpinned(_, _) or .Heard(_) or .LiteralUnpinned(_, _, _, _) -> [],
    }
}

/// How the empty list literal's type is spelled: a verb called on it is the list law's to refuse,
/// whatever its arguments.
const EMPTY_LIST: string = "[]"

/// An argument of a method a seat refused: the method's owner and name, the argument's place.
fn method_arguments_refused(engine: QueryEngine, file: SourceFileAddress, at: ItemId) -> List<Found> {
    let text = item_text(engine, file, at)
    flatten([method_words(r, text) for r in refused_in(engine, file, at)])
}

fn method_words(r: RefusedSeat, text: string) -> List<Found> {
    match r.seat {
        .Method(owner, name, place) -> if owner == EMPTY_LIST { [] } else { [seat_converted(found_in(r, [owner, name, "${place + 1}"]), r, text)] },
        .Argument(_, _) or .Field(_) or .Payload(_, _) or .Binding(_) or .Return(_) or .Body(_) or .Hole(_) or .Condition(_) or .FieldDefault(_) or .AnnotationSeat(_) or .SeatDefault(_) or .Pronoun or .Index or .Element or .MapKey or .MapValue or .Uncovered(_, _) or .Catchless(_) or .Refutable(_) or .Unmatchable or .Repeated(_) or .Unbinding(_, _) or .Arity(_, _, _) or .BindsTwice(_) or .ElementsApart(_) or .SpreadUnlike(_) or .SpreadPlace(_, _) or .Restless(_) or .VariantCount(_, _, _, _) or .Misshapen(_, _, _) or .OrBinds(_, _, _) or .PayloadOutside or .Isolated(_, _, _) or .Sealed(_, _, _) or .Computed(_, _) or .Walk(_, _, _, _) or .Unwalked(_, _, _) or .Unwritten(_, _) or .Valued(_) or .Unvaried(_, _, _, _) or .Handed(_, _, _, _) or .Unwaited(_) or .Nameless(_, _) or .Operand(_, _) or .Negated or .Compared(_, _) or .TwoNames or .Unnamed or .KeptArm or .Arm(_) or .Lambda(_) or .Unenumed(_, _, _) or .Unmatched or .Unasked or .Fnless(_) or .Bare(_) or .Shaped or .Unlistable(_) or .CellUnmapped(_) or .ExternValue(_, _, _) or .SeatNamed(_, _, _, _) or .CompUnwalked(_) or .NotOffered(_, _, _) or .Unwaitable(_) or .ArmBinder(_, _, _) or .SpentArm or .SelectFault(_) or .HoleFault(_) or .Fateless(_) or .Miscounted(_, _, _, _, _, _, _, _) or .OneFn(_, _) or .WalkSeats(_, _) or .Block(_, _, _) or .Unpredicated(_, _, _) or .Assigned(_, _) or .ArmApart(_) or .BranchesApart or .WhenApart or .FieldRepeated(_) or .Uncalled(_, _) or .FailureUnpromised(_, _) or .AbsenceUnpromised(_, _) or .FailuresApart(_, _) or .Raised(_) or .RangeBound(_) or .Caught(_) or .CaughtArm or .Voided or .Within(_) or .Guarantee(_) or .ForUnwalked(_) or .Literal(_) or .Unimplemented or .Folded(_) or .Pinned(_, _, _) or .Unpinned(_, _) or .CompBound(_) or .NullPin(_, _) or .TypeHole(_) or .Unprojected(_) or .Unknowable(_) or .CellHolds or .DefaultUnimplemented(_) or .StaticUnpinned(_, _) or .Heard(_) or .LiteralUnpinned(_, _, _, _) -> [],
    }
}

/// A record literal's field a seat refused.
fn fields_refused(engine: QueryEngine, file: SourceFileAddress, at: ItemId) -> List<Found> {
    let text = item_text(engine, file, at)
    flatten([field_words(r, text) for r in refused_in(engine, file, at)])
}

fn field_words(r: RefusedSeat, text: string) -> List<Found> {
    match r.seat {
        .Field(name) -> [seat_converted(found_in(r, [name]), r, text)],
        .Argument(_, _) or .Method(_, _, _) or .Payload(_, _) or .Binding(_) or .Return(_) or .Body(_) or .Hole(_) or .Condition(_) or .FieldDefault(_) or .AnnotationSeat(_) or .SeatDefault(_) or .Pronoun or .Index or .Element or .MapKey or .MapValue or .Uncovered(_, _) or .Catchless(_) or .Refutable(_) or .Unmatchable or .Repeated(_) or .Unbinding(_, _) or .Arity(_, _, _) or .BindsTwice(_) or .ElementsApart(_) or .SpreadUnlike(_) or .SpreadPlace(_, _) or .Restless(_) or .VariantCount(_, _, _, _) or .Misshapen(_, _, _) or .OrBinds(_, _, _) or .PayloadOutside or .Isolated(_, _, _) or .Sealed(_, _, _) or .Computed(_, _) or .Walk(_, _, _, _) or .Unwalked(_, _, _) or .Unwritten(_, _) or .Valued(_) or .Unvaried(_, _, _, _) or .Handed(_, _, _, _) or .Unwaited(_) or .Nameless(_, _) or .Operand(_, _) or .Negated or .Compared(_, _) or .TwoNames or .Unnamed or .KeptArm or .Arm(_) or .Lambda(_) or .Unenumed(_, _, _) or .Unmatched or .Unasked or .Fnless(_) or .Bare(_) or .Shaped or .Unlistable(_) or .CellUnmapped(_) or .ExternValue(_, _, _) or .SeatNamed(_, _, _, _) or .CompUnwalked(_) or .NotOffered(_, _, _) or .Unwaitable(_) or .ArmBinder(_, _, _) or .SpentArm or .SelectFault(_) or .HoleFault(_) or .Fateless(_) or .Miscounted(_, _, _, _, _, _, _, _) or .OneFn(_, _) or .WalkSeats(_, _) or .Block(_, _, _) or .Unpredicated(_, _, _) or .Assigned(_, _) or .ArmApart(_) or .BranchesApart or .WhenApart or .FieldRepeated(_) or .Uncalled(_, _) or .FailureUnpromised(_, _) or .AbsenceUnpromised(_, _) or .FailuresApart(_, _) or .Raised(_) or .RangeBound(_) or .Caught(_) or .CaughtArm or .Voided or .Within(_) or .Guarantee(_) or .ForUnwalked(_) or .Literal(_) or .Unimplemented or .Folded(_) or .Pinned(_, _, _) or .Unpinned(_, _) or .CompBound(_) or .NullPin(_, _) or .TypeHole(_) or .Unprojected(_) or .Unknowable(_) or .CellHolds or .DefaultUnimplemented(_) or .StaticUnpinned(_, _) or .Heard(_) or .LiteralUnpinned(_, _, _, _) -> [],
    }
}

/// A setting naming an event whose value its handler's seat refused.
fn handlers_refused(engine: QueryEngine, file: SourceFileAddress, at: ItemId) -> List<Found> {
    flatten([heard_words(r) for r in refused_in(engine, file, at)])
}

fn heard_words(r: RefusedSeat) -> List<Found> {
    match r.seat {
        .Heard(event) -> [found_in(r, [event])],
        .Argument(_, _) or .Method(_, _, _) or .Payload(_, _) or .Binding(_) or .Return(_) or .Body(_) or .Hole(_) or .Condition(_) or .FieldDefault(_) or .AnnotationSeat(_) or .SeatDefault(_) or .Pronoun or .Index or .Element or .MapKey or .MapValue or .Uncovered(_, _) or .Catchless(_) or .Refutable(_) or .Unmatchable or .Repeated(_) or .Unbinding(_, _) or .Arity(_, _, _) or .BindsTwice(_) or .ElementsApart(_) or .SpreadUnlike(_) or .SpreadPlace(_, _) or .Restless(_) or .VariantCount(_, _, _, _) or .Misshapen(_, _, _) or .OrBinds(_, _, _) or .PayloadOutside or .Isolated(_, _, _) or .Sealed(_, _, _) or .Computed(_, _) or .Walk(_, _, _, _) or .Unwalked(_, _, _) or .Unwritten(_, _) or .Valued(_) or .Unvaried(_, _, _, _) or .Handed(_, _, _, _) or .Unwaited(_) or .Nameless(_, _) or .Operand(_, _) or .Negated or .Compared(_, _) or .TwoNames or .Unnamed or .KeptArm or .Arm(_) or .Lambda(_) or .Unenumed(_, _, _) or .Unmatched or .Unasked or .Fnless(_) or .Bare(_) or .Shaped or .Unlistable(_) or .CellUnmapped(_) or .ExternValue(_, _, _) or .SeatNamed(_, _, _, _) or .CompUnwalked(_) or .NotOffered(_, _, _) or .Unwaitable(_) or .ArmBinder(_, _, _) or .SpentArm or .SelectFault(_) or .HoleFault(_) or .Fateless(_) or .Miscounted(_, _, _, _, _, _, _, _) or .OneFn(_, _) or .WalkSeats(_, _) or .Block(_, _, _) or .Unpredicated(_, _, _) or .Assigned(_, _) or .ArmApart(_) or .BranchesApart or .WhenApart or .FieldRepeated(_) or .Uncalled(_, _) or .FailureUnpromised(_, _) or .AbsenceUnpromised(_, _) or .FailuresApart(_, _) or .Raised(_) or .RangeBound(_) or .Caught(_) or .CaughtArm or .Voided or .Within(_) or .Guarantee(_) or .ForUnwalked(_) or .Literal(_) or .Unimplemented or .Folded(_) or .Pinned(_, _, _) or .Unpinned(_, _) or .CompBound(_) or .NullPin(_, _) or .TypeHole(_) or .Unprojected(_) or .Unknowable(_) or .CellHolds or .DefaultUnimplemented(_) or .StaticUnpinned(_, _) or .Field(_) or .LiteralUnpinned(_, _, _, _) -> [],
    }
}

/// A variant's payload a seat refused.
fn payloads_refused(engine: QueryEngine, file: SourceFileAddress, at: ItemId) -> List<Found> {
    flatten([payload_words(r) for r in refused_in(engine, file, at)])
}

fn payload_words(r: RefusedSeat) -> List<Found> {
    match r.seat {
        .Payload(owner, variant) -> [found_in(r, [owner, variant])],
        .Argument(_, _) or .Method(_, _, _) or .Field(_) or .Binding(_) or .Return(_) or .Body(_) or .Hole(_) or .Condition(_) or .FieldDefault(_) or .AnnotationSeat(_) or .SeatDefault(_) or .Pronoun or .Index or .Element or .MapKey or .MapValue or .Uncovered(_, _) or .Catchless(_) or .Refutable(_) or .Unmatchable or .Repeated(_) or .Unbinding(_, _) or .Arity(_, _, _) or .BindsTwice(_) or .ElementsApart(_) or .SpreadUnlike(_) or .SpreadPlace(_, _) or .Restless(_) or .VariantCount(_, _, _, _) or .Misshapen(_, _, _) or .OrBinds(_, _, _) or .PayloadOutside or .Isolated(_, _, _) or .Sealed(_, _, _) or .Computed(_, _) or .Walk(_, _, _, _) or .Unwalked(_, _, _) or .Unwritten(_, _) or .Valued(_) or .Unvaried(_, _, _, _) or .Handed(_, _, _, _) or .Unwaited(_) or .Nameless(_, _) or .Operand(_, _) or .Negated or .Compared(_, _) or .TwoNames or .Unnamed or .KeptArm or .Arm(_) or .Lambda(_) or .Unenumed(_, _, _) or .Unmatched or .Unasked or .Fnless(_) or .Bare(_) or .Shaped or .Unlistable(_) or .CellUnmapped(_) or .ExternValue(_, _, _) or .SeatNamed(_, _, _, _) or .CompUnwalked(_) or .NotOffered(_, _, _) or .Unwaitable(_) or .ArmBinder(_, _, _) or .SpentArm or .SelectFault(_) or .HoleFault(_) or .Fateless(_) or .Miscounted(_, _, _, _, _, _, _, _) or .OneFn(_, _) or .WalkSeats(_, _) or .Block(_, _, _) or .Unpredicated(_, _, _) or .Assigned(_, _) or .ArmApart(_) or .BranchesApart or .WhenApart or .FieldRepeated(_) or .Uncalled(_, _) or .FailureUnpromised(_, _) or .AbsenceUnpromised(_, _) or .FailuresApart(_, _) or .Raised(_) or .RangeBound(_) or .Caught(_) or .CaughtArm or .Voided or .Within(_) or .Guarantee(_) or .ForUnwalked(_) or .Literal(_) or .Unimplemented or .Folded(_) or .Pinned(_, _, _) or .Unpinned(_, _) or .CompBound(_) or .NullPin(_, _) or .TypeHole(_) or .Unprojected(_) or .Unknowable(_) or .CellHolds or .DefaultUnimplemented(_) or .StaticUnpinned(_, _) or .Heard(_) or .LiteralUnpinned(_, _, _, _) -> [],
