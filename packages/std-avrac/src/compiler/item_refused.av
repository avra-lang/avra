/// a record field's default whose type isn't the field's
export law field_default_mismatch {
    kind: "type.struct_fields"
    reads: field_defaults_refused
    voice: field_default_refused
    witness: "type P = { n: int = \"x\" }\n"
}

/// a fn seat's default whose type isn't the seat's
export law seat_default_mismatch {
    kind: "type.param_default"
    reads: seat_defaults_refused
    voice: seat_default_refused
    witness: "fn f(n: int = \"x\") -> int { n }\n"
}

fn field_default_refused(a: List<string>) -> Voice { refused_voice("field `${a[0]}` defaults to `${a[2]}`, and it is `${a[1]}`", a[1], a[2]) }

fn seat_default_refused(a: List<string>) -> Voice { refused_voice("parameter `${a[0]}` defaults to `${a[2]}`, and it is `${a[1]}`", a[1], a[2]) }

/// A quote's hole whose position doesn't take its value: the position's words, then what it holds.
fn holes_refused(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([hole_words(r) for r in refused_in(engine, file, at)])
}

fn hole_words(r: RefusedSeat) -> List<Found> {
    match r.seat {
        .Hole(kind) -> [Found { at: span_of(r.at), args: [kind.position_word(), kind.takes_word(), r.found] }],
        .Argument(_, _) or .Method(_, _, _) or .Field(_) or .Payload(_, _) or .Binding(_) or .Return(_) or .Body(_) or .Condition(_) or .FieldDefault(_) or .SeatDefault(_) or .Pronoun or .Index or .Element or .MapKey or .MapValue or .Uncovered(_, _) or .Catchless(_) or .Refutable(_) or .Unmatchable or .Repeated(_) or .Unbinding(_, _) or .Arity(_, _, _) or .BindsTwice(_) or .ElementsApart(_) or .SpreadUnlike(_) or .SpreadPlace(_, _) or .Restless(_) or .VariantCount(_, _, _, _) or .Misshapen(_, _, _) or .OrBinds(_, _, _) or .PayloadOutside or .Isolated(_, _, _) or .Sealed(_, _, _) or .Computed(_, _) or .Walk(_, _, _, _) or .Unwalked(_, _, _) or .Unwritten(_, _) or .Valued(_) or .Unvaried(_, _, _, _) or .Handed(_, _, _, _) or .Unwaited(_) or .Nameless(_, _) or .Operand(_, _) or .Negated or .Compared(_, _) or .TwoNames or .Unnamed or .KeptArm or .Fnless(_) or .Bare(_) or .Shaped or .Unlistable(_) or .CellUnmapped(_) or .ExternValue(_, _, _) or .SeatNamed(_, _, _, _) or .CompUnwalked(_) or .NotOffered(_, _, _) or .Unwaitable(_) or .ArmBinder(_, _, _) or .SpentArm or .Fateless(_) -> [],
    }
}

/// a quote's hole whose position doesn't take what it holds
export law hole_mismatch {
    kind: "type.quote_hole"
    reads: holes_refused
    voice: hole_refused
    witness: "use @std.meta.{Code, name}\n\ntype M = { c: string }\n\nimpl M {\n    fn code() -> Code { quote { \${name(self.c)}(self) } }\n}\n"
}

fn hole_refused(a: List<string>) -> Voice {
    Voice {
        message: "a hole in ${a[0]} position takes ${a[1]}, found `${a[2]}`",
        label: "this is `${a[2]}`",
        help: "fill the hole with what its seat takes",
    }
}

/// A condition that isn't a `bool`: its site's words, then what it holds.
fn conditions_refused(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([condition_words(r) for r in refused_in(engine, file, at)])
}

fn condition_words(r: RefusedSeat) -> List<Found> {
    match r.seat {
        .Condition(of) -> [Found { at: span_of(r.at), args: [of.subject(), of.decides(), r.found] }],
        .Argument(_, _) or .Method(_, _, _) or .Field(_) or .Payload(_, _) or .Binding(_) or .Return(_) or .Body(_) or .Hole(_) or .FieldDefault(_) or .SeatDefault(_) or .Pronoun or .Index or .Element or .MapKey or .MapValue or .Uncovered(_, _) or .Catchless(_) or .Refutable(_) or .Unmatchable or .Repeated(_) or .Unbinding(_, _) or .Arity(_, _, _) or .BindsTwice(_) or .ElementsApart(_) or .SpreadUnlike(_) or .SpreadPlace(_, _) or .Restless(_) or .VariantCount(_, _, _, _) or .Misshapen(_, _, _) or .OrBinds(_, _, _) or .PayloadOutside or .Isolated(_, _, _) or .Sealed(_, _, _) or .Computed(_, _) or .Walk(_, _, _, _) or .Unwalked(_, _, _) or .Unwritten(_, _) or .Valued(_) or .Unvaried(_, _, _, _) or .Handed(_, _, _, _) or .Unwaited(_) or .Nameless(_, _) or .Operand(_, _) or .Negated or .Compared(_, _) or .TwoNames or .Unnamed or .KeptArm or .Fnless(_) or .Bare(_) or .Shaped or .Unlistable(_) or .CellUnmapped(_) or .ExternValue(_, _, _) or .SeatNamed(_, _, _, _) or .CompUnwalked(_) or .NotOffered(_, _, _) or .Unwaitable(_) or .ArmBinder(_, _, _) or .SpentArm or .Fateless(_) -> [],
    }
}

/// a condition whose value isn't a `bool`
export law condition_mismatch {
    kind: "type.mismatch"
    reads: conditions_refused
    voice: condition_refused
    witness: "fn g() -> int {\n    if 1 { 2 } else { 3 }\n}\n"
}

fn condition_refused(a: List<string>) -> Voice { Voice { message: "${a[0]} is a `bool`, found `${a[2]}`", label: a[1], help: condition_help } }

/// An arm of a `match` a `collect` keeps that answers a list of what it keeps.
fn kept_arms_refused(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    [found_in(r, []) for r in refused_in(engine, file, at) if r.seat is .KeptArm]
}

/// an arm of a kept `match` answers one element
export law kept_arm_answers_one {
    kind: "type.kept_arm"
    reads: kept_arms_refused
    voice: kept_arm_refused
    witness: "enum K {\n    A\n    B\n}\nlet k = K.A\nlet xs: List<int> = collect {\n    match k {\n        .A -> [1, 2]\n        .B -> 3\n    }\n}\nxs.length\n"
}

fn kept_arm_refused(a: List<string>) -> Voice { kept_arm_listed(a[0], a[1]) }

/// A seat no voice names yet: what it wants and what it found, said plainly.
fn unnamed_refused(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    [found_in(r, []) for r in refused_in(engine, file, at) if r.seat is .Unnamed]
}

/// a value refused by a seat no voice names yet
export law seat_mismatch {
    kind: "type.mismatch"
    reads: unnamed_refused
    voice: seat_refused
    witness: "fn ap(f: fn(int) -> int) -> int { f(1) }\n\nfn g() -> int { ap((x) -> \"a\") }\n"
}

fn seat_refused(a: List<string>) -> Voice { refused_voice("this seat wants `${a[0]}`, found `${a[1]}`", a[0], a[1]) }

/// A seat's refusal: its message, the found value named at its place, and the remedy.
fn refused_voice(message: string, want: string, found: string) -> Voice {
    Voice {
        message: message,
        label: "this is `${found}`",
        help: "make the value `${want}`, or change the declaration that wants it",
    }
}

/// The pronoun's own lambda in a seat that takes no fn: the seat's type.
fn pronouns_starved(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    [Found { at: span_of(r.at), args: [r.want] } for r in refused_in(engine, file, at) if r.seat is .Pronoun]
}

/// `it` handed to a seat that takes no fn has no element
export law pronoun_starved {
    kind: "type.lambda"
    reads: pronouns_starved
    voice: starved_words
    witness: "fn f(ys: List<int>) -> bool { ys.contains(it) }\n"
}

fn starved_words(a: List<string>) -> Voice { pronoun_without_element(a[0]) }

/// Each `select` shape no lowering stands for: what it is.
fn selects_unwaited(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    [Found { at: span_of(r.at), args: [what] } for r in refused_in(engine, file, at) for what in some_list(unwaited_what(r.seat))]
}

/// What a `select` shape refused for no lowering is, where `seat` refused one.
fn unwaited_what(seat: Seating) -> string? {
    match seat { .Unwaited(what) -> what, rest -> null }
}

/// a `select` the language refuses: an arm-set law broken, or a shape no lowering stands for
export law select_unlowered {
    kind: "flow.select"
    reads: selects_unwaited
    voice: unwaited_words
    witness: "fn one() -> int { 1 }\n\nfn f() -> int {\n    let t = spawn one()\n    @fair select {\n        r in t -> r\n    }\n}\n"
}

fn unwaited_words(a: List<string>) -> Voice { select_refused_voice(a[0]) }

/// A receiver a writing verb refused: its root's name and the verb, or the verb alone where it stands
/// in no place.
fn receivers_refused(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([receiver_words(r) for r in refused_in(engine, file, at)])
}

fn receiver_words(r: RefusedSeat) -> List<Found> {
    match r.seat {
        .Unwritten(root, verb) -> [Found { at: span_of(r.at), args: [root, verb] }],
        .Valued(verb) -> [Found { at: span_of(r.at), args: [verb] }],
        .Argument(_, _) or .Method(_, _, _) or .Field(_) or .Payload(_, _) or .Binding(_) or .Return(_) or .Body(_) or .Hole(_) or .Condition(_) or .FieldDefault(_) or .SeatDefault(_) or .Pronoun or .Index or .Element or .MapKey or .MapValue or .Uncovered(_, _) or .Catchless(_) or .Refutable(_) or .Unmatchable or .Repeated(_) or .Unbinding(_, _) or .Arity(_, _, _) or .BindsTwice(_) or .ElementsApart(_) or .SpreadUnlike(_) or .SpreadPlace(_, _) or .Restless(_) or .VariantCount(_, _, _, _) or .Misshapen(_, _, _) or .OrBinds(_, _, _) or .PayloadOutside or .Isolated(_, _, _) or .Sealed(_, _, _) or .Computed(_, _) or .Walk(_, _, _, _) or .Unwalked(_, _, _) or .Unvaried(_, _, _, _) or .Handed(_, _, _, _) or .Unwaited(_) or .Nameless(_, _) or .Operand(_, _) or .Negated or .Compared(_, _) or .TwoNames or .Unnamed or .KeptArm or .Fnless(_) or .Bare(_) or .Shaped or .Unlistable(_) or .CellUnmapped(_) or .ExternValue(_, _, _) or .SeatNamed(_, _, _, _) or .CompUnwalked(_) or .NotOffered(_, _, _) or .Unwaitable(_) or .ArmBinder(_, _, _) or .SpentArm or .Fateless(_) -> [],
    }
}

/// a writing verb's receiver that isn't a `mut` place
export law receiver_unwritten {
    kind: "type.place"
    reads: receivers_refused
    voice: receiver_refused
    witness: "fn f(xs: List<int>) {\n    xs.push(1)\n}\n"
}

fn receiver_refused(a: List<string>) -> Voice { if a.length == 2 { unwritten_receiver(a[0], a[1]) } else { valued_receiver(a[0]) } }

/// A pattern naming a variant its enum doesn't declare: the enum, the variant, whether an `is` names
/// it, then the variants it declares.
fn variants_refused(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([variant_words(r) for r in refused_in(engine, file, at)])
}

fn variant_words(r: RefusedSeat) -> List<Found> {
    match r.seat {
        .Unvaried(owner, variant, variants, asked) -> [Found { at: span_of(r.at), args: [owner, variant, "${asked}"].concat(variants) }],
        .Argument(_, _) or .Method(_, _, _) or .Field(_) or .Payload(_, _) or .Binding(_) or .Return(_) or .Body(_) or .Hole(_) or .Condition(_) or .FieldDefault(_) or .SeatDefault(_) or .Pronoun or .Index or .Element or .MapKey or .MapValue or .Uncovered(_, _) or .Catchless(_) or .Refutable(_) or .Unmatchable or .Repeated(_) or .Unbinding(_, _) or .Arity(_, _, _) or .BindsTwice(_) or .ElementsApart(_) or .SpreadUnlike(_) or .SpreadPlace(_, _) or .Restless(_) or .VariantCount(_, _, _, _) or .Misshapen(_, _, _) or .OrBinds(_, _, _) or .PayloadOutside or .Isolated(_, _, _) or .Sealed(_, _, _) or .Computed(_, _) or .Walk(_, _, _, _) or .Unwalked(_, _, _) or .Unwritten(_, _) or .Valued(_) or .Handed(_, _, _, _) or .Unwaited(_) or .Nameless(_, _) or .Operand(_, _) or .Negated or .Compared(_, _) or .TwoNames or .Unnamed or .KeptArm or .Fnless(_) or .Bare(_) or .Shaped or .Unlistable(_) or .CellUnmapped(_) or .ExternValue(_, _, _) or .SeatNamed(_, _, _, _) or .CompUnwalked(_) or .NotOffered(_, _, _) or .Unwaitable(_) or .ArmBinder(_, _, _) or .SpentArm or .Fateless(_) -> [],
    }
}

/// a pattern naming a variant its enum doesn't declare
export law variant_unknown {
    kind: "type.match"
    reads: variants_refused
    voice: variant_refused
    witness: "enum E {\n    A\n    B\n}\n\nfn f(e: E) -> int {\n    match e {\n        .C -> 1,\n        _ -> 2,\n    }\n}\n"
}

fn variant_refused(a: List<string>) -> Voice { unknown_variant(a[0], a[1], a.drop(3), a[2] == "true") }

/// A walk's fn argument handed a value that is no fn: the walk, then what it was handed.
fn walks_refused(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([walk_words(r) for r in refused_in(engine, file, at)])
}

fn walk_words(r: RefusedSeat) -> List<Found> {
    match r.seat {
        .Walk(_, name, _, _) -> [Found { at: span_of(r.at), args: [name, r.found] }],
        .Argument(_, _) or .Method(_, _, _) or .Field(_) or .Payload(_, _) or .Binding(_) or .Return(_) or .Body(_) or .Hole(_) or .Condition(_) or .FieldDefault(_) or .SeatDefault(_) or .Pronoun or .Index or .Element or .MapKey or .MapValue or .Uncovered(_, _) or .Catchless(_) or .Refutable(_) or .Unmatchable or .Repeated(_) or .Unbinding(_, _) or .Arity(_, _, _) or .BindsTwice(_) or .ElementsApart(_) or .SpreadUnlike(_) or .SpreadPlace(_, _) or .Restless(_) or .VariantCount(_, _, _, _) or .Misshapen(_, _, _) or .OrBinds(_, _, _) or .PayloadOutside or .Isolated(_, _, _) or .Sealed(_, _, _) or .Computed(_, _) or .Unwalked(_, _, _) or .Unwritten(_, _) or .Valued(_) or .Unvaried(_, _, _, _) or .Handed(_, _, _, _) or .Unwaited(_) or .Nameless(_, _) or .Operand(_, _) or .Negated or .Compared(_, _) or .TwoNames or .Unnamed or .KeptArm or .Fnless(_) or .Bare(_) or .Shaped or .Unlistable(_) or .CellUnmapped(_) or .ExternValue(_, _, _) or .SeatNamed(_, _, _, _) or .CompUnwalked(_) or .NotOffered(_, _, _) or .Unwaitable(_) or .ArmBinder(_, _, _) or .SpentArm or .Fateless(_) -> [],
    }
}

/// a walk handed a value that is no fn
export law walk_fnless_mismatch {
    kind: "type.mismatch"
    reads: walks_refused
    voice: walk_refused
    witness: "fn f(xs: List<int>) -> bool { xs.all(true) }\n"
}

fn walk_refused(a: List<string>) -> Voice { walk_fnless(a[0], a[1]) }

/// A walk handed a fn taking another element: the walk, the element, then the fn it was handed.
fn walk_elements_refused(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([walk_element_words(r) for r in refused_in(engine, file, at)])
}

fn walk_element_words(r: RefusedSeat) -> List<Found> {
    match r.seat {
        .Unwalked(name, element, _) -> [Found { at: span_of(r.at), args: [name, element, r.found] }],
        .Argument(_, _) or .Method(_, _, _) or .Field(_) or .Payload(_, _) or .Binding(_) or .Return(_) or .Body(_) or .Hole(_) or .Condition(_) or .FieldDefault(_) or .SeatDefault(_) or .Pronoun or .Index or .Element or .MapKey or .MapValue or .Uncovered(_, _) or .Catchless(_) or .Refutable(_) or .Unmatchable or .Repeated(_) or .Unbinding(_, _) or .Arity(_, _, _) or .BindsTwice(_) or .ElementsApart(_) or .SpreadUnlike(_) or .SpreadPlace(_, _) or .Restless(_) or .VariantCount(_, _, _, _) or .Misshapen(_, _, _) or .OrBinds(_, _, _) or .PayloadOutside or .Isolated(_, _, _) or .Sealed(_, _, _) or .Computed(_, _) or .Walk(_, _, _, _) or .Unwritten(_, _) or .Valued(_) or .Unvaried(_, _, _, _) or .Handed(_, _, _, _) or .Unwaited(_) or .Nameless(_, _) or .Operand(_, _) or .Negated or .Compared(_, _) or .TwoNames or .Unnamed or .KeptArm or .Fnless(_) or .Bare(_) or .Shaped or .Unlistable(_) or .CellUnmapped(_) or .ExternValue(_, _, _) or .SeatNamed(_, _, _, _) or .CompUnwalked(_) or .NotOffered(_, _, _) or .Unwaitable(_) or .ArmBinder(_, _, _) or .SpentArm or .Fateless(_) -> [],
    }
}

/// a walk handed a fn taking another element
export law walk_element_mismatch {
    kind: "type.mismatch"
    reads: walk_elements_refused
    voice: walk_element_refused
    witness: "fn f(xs: List<int>) -> bool { xs.all((s: string) -> true) }\n"
}

fn walk_element_refused(a: List<string>) -> Voice { walk_unseated(a[0], a[1], a[2]) }

/// A list literal's element whose type isn't the one the list holds.
fn elements_refused(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    [found_in(r, []) for r in refused_in(engine, file, at) if r.seat is .Element]
}

/// a list literal's element whose type isn't the list's
export law element_mismatch {
    kind: "type.list_element"
    reads: elements_refused
    voice: element_refused
    witness: "fn f() -> List<int> { [\"a\"] }\n"
}

fn element_refused(a: List<string>) -> Voice { refused_voice(list_holds(a[0], a[1]), a[0], a[1]) }

/// A `match` that handles no arm for one of its enum's variants: the enum, then the variant.
fn matches_uncovered(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([uncovered_words(r) for r in refused_in(engine, file, at)])
}

fn uncovered_words(r: RefusedSeat) -> List<Found> {
    match r.seat {
        .Uncovered(owner, variant) -> [Found { at: span_of(r.at), args: [owner, variant] }],
        rest -> [],
    }
}

/// a `match` on an enum that handles none of its arms one of its variants
export law match_uncovered {
    kind: "type.match"
    reads: matches_uncovered
    voice: uncovered_refused
    witness: "enum E {\n    A\n    B\n}\n\nfn f(e: E) -> int {\n    match e {\n        .A -> 1,\n    }\n}\n"
}

fn uncovered_refused(a: List<string>) -> Voice { variant_unhandled(a[0], a[1]) }

/// A `match` on a value of no enum that no arm takes every value of: the value's type.
fn matches_catchless(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([catchless_words(r) for r in refused_in(engine, file, at)])
}

fn catchless_words(r: RefusedSeat) -> List<Found> {
    match r.seat { .Catchless(owner) -> found_saying(r, [owner]), _ -> [] }
}

/// a `match` on a value of no enum that no arm takes every value of
export law match_catchless {
    kind: "type.match"
    reads: matches_catchless
    voice: catchless_refused
    witness: "fn f(n: int) -> int {\n    match n {\n        1 -> 0,\n    }\n}\n"
}

fn catchless_refused(a: List<string>) -> Voice { catchless_match(a[0]) }

/// A `let` taking a value apart by a pattern that can refuse it, with no `else`: the value's type.
fn lets_refutable(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([refutable_words(r) for r in refused_in(engine, file, at)])
}

fn refutable_words(r: RefusedSeat) -> List<Found> {
    match r.seat { .Refutable(owner) -> found_saying(r, [owner]), _ -> [] }
}

/// a `let` whose pattern can refuse its value and that says nothing for what it refuses
export law let_refutable {
    kind: "type.let_pattern"
    reads: lets_refutable
    voice: refutable_refused
    witness: "fn f(xs: List<int>) -> int {\n    let [first, ..rest] = xs\n    first\n}\n"
}

fn refutable_refused(a: List<string>) -> Voice { refutable_pattern(a[0]) }

/// A `match` testing variants of a value that is no enum: the value's type.
fn matches_unenumerated(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten(
        [found_saying(r, [r.found]) for r in refused_in(engine, file, at) if r.seat is .Unmatchable],
    )
}

/// a `match` testing variants of a value that is no enum
export law match_unenumerated {
    kind: "type.match"
    reads: matches_unenumerated
    voice: unenumerated_refused
    witness: "enum C {\n    R\n    G\n}\n\nfn f(c: C?) -> int {\n    match c {\n        null -> 0,\n        .R -> 1,\n        .G -> 2,\n    }\n}\n"
}

fn unenumerated_refused(a: List<string>) -> Voice { unenumerated_match(a[0]) }

/// An arm taking whole a variant an arm before it took: the variant.
fn arms_repeated(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([repeated_words(r) for r in refused_in(engine, file, at)])
}

fn repeated_words(r: RefusedSeat) -> List<Found> { match r.seat { .Repeated(variant) -> found_saying(r, [variant]), _ -> [] } }

/// an arm that takes whole a variant an arm before it took
export law match_repeated {
    kind: "type.match"
    reads: arms_repeated
    voice: repeated_refused
    witness: "enum C {\n    R\n    G\n}\n\nfn f(c: C) -> int {\n    match c {\n        .R -> 1,\n        .R -> 2,\n        .G -> 3,\n    }\n}\n"
}

fn repeated_refused(a: List<string>) -> Voice { variant_repeated(a[0]) }

/// A pattern binding a name twice: the name.
fn names_bound_twice(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([bound_twice_found(r) for r in refused_in(engine, file, at)])
}

fn bound_twice_found(r: RefusedSeat) -> List<Found> { match r.seat { .BindsTwice(name) -> found_saying(r, [name]), _ -> [] } }

/// a pattern that binds one name twice
export law pattern_binds_twice {
    kind: "type.binds_twice"
    reads: names_bound_twice
    voice: twice_refused
    witness: "enum E {\n    A(n: int, m: int)\n}\n\nfn f(e: E) -> int {\n    match e {\n        .A(n, n) -> n,\n    }\n}\n"
}

fn twice_refused(a: List<string>) -> Voice { name_bound_twice(a[0]) }

/// A value of a sealed type built or rewritten outside its module: the type, the module, the site.
fn seals_broken(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([sealed_words(r) for r in refused_in(engine, file, at)])
}

fn sealed_words(r: RefusedSeat) -> List<Found> { match r.seat { .Sealed(name, home, how) -> found_saying(r, [name, home, how]), _ -> [] } }

/// a value of a sealed type built or rewritten outside the module that declares it
export law seal_broken {
    kind: "type.sealed"
    reads: seals_broken
    voice: sealed_refused
    witness: "use urls.{Url}\n\nfn g() -> Url { \"x\" }\n"
    witness_files: {
        "src/urls/urls.av": "use @std.meta.{sealed}\n\n@sealed\nexport type Url = string\n",
    }
}

fn sealed_refused(a: List<string>) -> Voice { sealed_elsewhere(a[0], a[1], a[2]) }

/// A list literal's element whose type isn't its first element's: the first's type, then its.
fn elements_apart(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([elements_apart_words(r) for r in refused_in(engine, file, at)])
}

fn elements_apart_words(r: RefusedSeat) -> List<Found> {
    match r.seat {
        .ElementsApart(boxed) -> [found_in(r, [if boxed { "boxed" } else { "" }])],
        _ -> [],
    }
}

/// a list literal whose elements are of more than one type
export law elements_share_one_type {
    kind: "type.list_element"
    reads: elements_apart
    voice: apart_elements_refused
    witness: "fn f() -> int {\n    let xs = [1, true]\n    xs.length\n}\n"
}

fn apart_elements_refused(a: List<string>) -> Voice {
    let said = refused_voice(elements_share(a[1], a[2]), a[1], a[2])
    if a[0] == "" { said } else { said with { help: share_a_trait() } }
}

/// A spread in a list or a map literal of what is no list or map: which literal, then the value's type.
fn spreads_unlike(engine: QueryEngine, file: SourceFileAddress, at: int, of: string) -> List<Found> {
    flatten([unlike_words(r, of) for r in refused_in(engine, file, at)])
}

fn unlike_words(r: RefusedSeat, of: string) -> List<Found> {
    match r.seat {
        .SpreadUnlike(spread_of) -> if spread_of == of { found_saying(r, [r.found]) } else { [] },
        _ -> [],
    }
}

fn list_spreads_unlike(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> { spreads_unlike(engine, file, at, "list") }

fn map_spreads_unlike(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> { spreads_unlike(engine, file, at, "map") }

/// a list literal spreading what is no list
export law list_spread_unlike {
    kind: "type.spread_list"
    reads: list_spreads_unlike
    voice: list_unlike_refused
    witness: "fn f() -> int {\n    let xs = [..5]\n    xs.length\n}\n"
}

/// a map literal spreading what is no map
export law map_spread_unlike {
    kind: "type.spread_map"
    reads: map_spreads_unlike
    voice: map_unlike_refused
    witness: "fn f() -> int {\n    let m = { ..5 }\n    m.length\n}\n"
}

fn list_unlike_refused(a: List<string>) -> Voice { list_spread_unlisted(a[0]) }

/// A spread's field into a seat that takes a place or a settled value: the callee, then the seat.
fn spreads_placeless(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([placeless_words(r) for r in refused_in(engine, file, at)])
}

fn placeless_words(r: RefusedSeat) -> List<Found> {
    match r.seat { .SpreadPlace(callee, name) -> found_saying(r, [callee, name]), _ -> [] }
}

/// a spread's field fills no seat that takes a place or a settled value
export law spread_fills_plain_seats {
    kind: "type.spread_seat"
    reads: spreads_placeless
    voice: placeless_refused
    witness: "type O = { a: int }\n\nfn g(mut a: int) -> int { a }\n\nfn f() -> int { g(..O { a: 2 }) }\n"
}

fn placeless_refused(a: List<string>) -> Voice { spread_placeless(a[0], a[1]) }

/// A spread of a list into a call whose callee takes no rest: the callee.
fn spreads_restless(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([restless_words(r) for r in refused_in(engine, file, at)])
}

fn restless_words(r: RefusedSeat) -> List<Found> {
    match r.seat { .Restless(callee) -> found_saying(r, [callee]), _ -> [] }
}

/// `..` of a list fills a seat that takes the rest
export law spread_finds_a_rest {
    kind: "type.spread_seat"
    reads: spreads_restless
    voice: restless_refused
    witness: "fn g(a: int) -> int { a }\n\nfn f() -> int { g(..[1]) }\n"
}

fn restless_refused(a: List<string>) -> Voice { spread_restless(a[0]) }

/// A variant built with other than it carries: the enum, the variant, how, what it carries, what
/// it's given.
fn variants_miscounted(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([miscounted_words(r, false) for r in refused_in(engine, file, at)])
}

/// A variant that carries a payload named without it: the enum, the variant, what it carries.
fn variants_bare(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([miscounted_words(r, true) for r in refused_in(engine, file, at)])
}

fn miscounted_words(r: RefusedSeat, named_bare: bool) -> List<Found> {
    match r.seat {
        .VariantCount(variant, how, carried, handed) -> if (how == "bare") == named_bare { found_saying(r, [r.want, variant, how, carried, "${handed}"]) } else { [] },
        _ -> [],
    }
}

/// a variant is built with what it carries
export law variant_carries_its_payloads {
    kind: "type.variant_arity"
    reads: variants_miscounted
    voice: miscounted_refused
    witness: "enum S {\n    a(int)\n    b\n}\n\nfn f() -> S { S.a() }\n"
}

fn miscounted_refused(a: List<string>) -> Voice {
    match a[2] {
        "nothing" -> variant_carries_nothing(a[0], a[1]),
        "empty" -> variant_given_nothing(a[0], a[1], a[3]),
        _ -> payloads_miscounted(a[0], a[1], parse_int(a[3]) ?? 0, parse_int(a[4]) ?? 0),
    }
}

/// a variant that carries a payload is never named without it
export law variant_named_with_payload {
    kind: "type.mismatch"
    reads: variants_bare
    voice: bare_refused
    witness: "enum S {\n    a(int)\n    b\n}\n\nfn f() -> S { S.a }\n"
}

fn bare_refused(a: List<string>) -> Voice { variant_named_bare(a[0], a[1], a[3]) }

/// `all` on an enum a variant of which carries a payload: the enum, then that variant.
fn enums_unlistable(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([unlistable_words(r) for r in refused_in(engine, file, at)])
}

fn unlistable_words(r: RefusedSeat) -> List<Found> {
    match r.seat { .Unlistable(variant) -> found_saying(r, [r.want, variant]), _ -> [] }
}

/// `all` lists an enum whose variants carry nothing
export law enum_all_bare {
    kind: "type.enum_all"
    reads: enums_unlistable
    voice: unlistable_refused
    witness: "enum K {\n    A\n    B(int)\n}\n\nfn f() -> int { K.all().length }\n"
}

fn unlistable_refused(a: List<string>) -> Voice { variants_unlistable(a[0], a[1]) }

/// `put` on a cell holding no map: what it holds.
fn cells_unmapped(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([unmapped_words(r) for r in refused_in(engine, file, at)])
}

fn unmapped_words(r: RefusedSeat) -> List<Found> {
    match r.seat { .CellUnmapped(held) -> found_saying(r, [held]), _ -> [] }
}

/// `put` inserts into the map a cell holds
export law cell_put_mapped {
    kind: "type.cell_map"
    reads: cells_unmapped
    voice: unmapped_refused
    witness: "fn f() {\n    let c = Cell.new(1)\n    c.put(\"a\", 1)\n}\n"
}

fn unmapped_refused(a: List<string>) -> Voice { cell_unmapped(a[0]) }

/// An extern read as a value: the wrapper that hands it on, beside the extern's declaration where
/// this file writes it.
fn externs_valued(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([extern_valued_words(engine, file, r) for r in refused_in(engine, file, at)])
}

fn extern_valued_words(engine: QueryEngine, file: SourceFileAddress, r: RefusedSeat) -> List<Found> {
    match r.seat {
        .ExternValue(name, types, mutable) -> [
            Found {
                at: span_of(r.at),
                args: [extern_wrapper(name, types, mutable)],
                aside: Aside { label: DECLARED_HERE, at: extern_declared(engine, file, name) },
            },
        ],
        _ -> [],
    }
}

/// Where `file` declares the extern `name`.
fn extern_declared(engine: QueryEngine, file: SourceFileAddress, name: string) -> Span? {
    [sp! for i in 0..item_count(engine, file) for item in [read_item(engine, file, i)] for s in item.stmts if item.store.extern_parts(s)?.name == name for sp in [item.store.stmt_span(s)] if sp != null]
        .first()
}

/// an extern fn is called, never read as a value
export law extern_called_only {
    kind: "type.extern_value"
    reads: externs_valued
    voice: extern_valued_refused
    witness: "extern fn avra_host_is_dir(path: string) -> int\n\nfn f() -> int {\n    let g = avra_host_is_dir\n    g(\"corpus\")\n}\n"
}

fn extern_valued_refused(a: List<string>) -> Voice { extern_unvalued(a[0]) }

/// A call naming its callee's seats as no call of it can: the callee, how, the seat, then the seats.
fn seats_misnamed(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([misnamed_words(r) for r in refused_in(engine, file, at)])
}

fn misnamed_words(r: RefusedSeat) -> List<Found> {
    match r.seat {
        .SeatNamed(callee, how, name, seats) -> found_saying(r, [callee, how, name].concat(seats)),
        _ -> [],
    }
}

/// a named argument writes a seat its callee declares, once, and every seat without a default is written
export law seats_named_once {
    kind: "type.named_arg"
    reads: seats_misnamed
    voice: misnamed_refused
    witness: "fn sub(a: int, b: int) -> int { a - b }\n\nfn f() -> int { sub(a: 1, c: 2) }\n"
}

/// A comprehension walking what holds no element: its type.
fn comps_unwalked(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([unwalked_comp_words(r) for r in refused_in(engine, file, at)])
}

fn unwalked_comp_words(r: RefusedSeat) -> List<Found> {
    match r.seat { .CompUnwalked(found) -> found_saying(r, [found]), _ -> [] }
}

/// a comprehension walks a list
export law comp_walks_a_list {
    kind: "type.list"
    reads: comps_unwalked
    voice: unwalked_comp_refused
    witness: "fn f() -> int { [x for x in 1].length }\n"
}

fn unwalked_comp_refused(a: List<string>) -> Voice { comp_walks_list(a[0]) }

/// A lambda taking its seat's record by name asking for what it doesn't offer: the name, how, then
/// the fields it offers.
fn offers_refused(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([offer_words(r) for r in refused_in(engine, file, at)])
}

fn offer_words(r: RefusedSeat) -> List<Found> {
    match r.seat {
        .NotOffered(name, how, fields) -> found_saying(r, [name, how].concat(fields)),
        _ -> [],
    }
}

/// a lambda takes by name what its seat's record offers
export law offer_taken_by_name {
    kind: "type.not_offered"
    reads: offers_refused
    voice: offer_refused_words
    witness: "type Offer = { req: string, db: int }\n\nfn handle(f: fn(Offer) -> string) -> string { f(Offer { req: \"GET /\", db: 7 }) }\n\nfn g() -> string { handle { db, reqq -> \"x\" } }\n"
}

fn offer_refused_words(a: List<string>) -> Voice { if a[1] == "typed" { offer_typed(a[0]) } else { offer_unnamed(a[0], a.drop(2)) } }

/// A `select` arm waiting on what nothing waits on: its type, then whether the program loads
/// `@std/time`.
fn arms_unwaitable(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    let timers = package_reach(engine, file.package_name).packages.contains("@std/time")
    flatten([unwaitable_words(r, timers) for r in refused_in(engine, file, at)])
}

fn unwaitable_words(r: RefusedSeat, timers: bool) -> List<Found> {
    match r.seat {
        .Unwaitable(found) -> found_saying(r, [found, if timers { "timers" } else { "" }]),
        _ -> [],
    }
}

/// a `select` arm waits on a task, a list of tasks, a source or a timer
export law arm_waits {
    kind: "flow.arm"
    reads: arms_unwaitable
    voice: unwaitable_refused
    witness: "fn f() -> int {\n    select {\n        1 -> 2\n    }\n}\n"
}

fn unwaitable_refused(a: List<string>) -> Voice { arm_unwaited(a[0], a[1] != "") }

/// A `select` arm binding what its head hands over not as it does: how, the index, the binder.
fn arms_misbound(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([misbound_words(r) for r in refused_in(engine, file, at)])
}

fn misbound_words(r: RefusedSeat) -> List<Found> {
    match r.seat { .ArmBinder(how, index, bind) -> found_saying(r, [how, index, bind]), _ -> [] }
}

/// a `select` arm binds what its head hands over
export law arm_binds_as_handed {
    kind: "flow.arm_binder"
    reads: arms_misbound
    voice: misbound_refused
    witness: "fn one() -> int { 1 }\n\nfn f() -> int {\n    let job = spawn one()\n    select {\n        i, r in job -> r\n    }\n}\n"
}

fn misbound_refused(a: List<string>) -> Voice { arm_binder_said(a[0], a[1], a[2]) }

/// A `select` arm waiting on a list of tasks inside a loop.
fn arms_spent(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    [Found { at: span_of(r.at), args: [] } for r in refused_in(engine, file, at) if r.seat is .SpentArm]
}

/// a list arm is taken once
export law list_arm_once {
    kind: "flow.spent_arm"
    reads: arms_spent
    voice: spent_refused
    witness: "fn one() -> int { 1 }\n\nfn f() -> int {\n    let jobs = [spawn one()]\n    mut n = 0\n    while n < 1 {\n        n = n + select {\n            r in jobs -> r\n        }\n    }\n    n\n}\n"
}

fn spent_refused(_a: List<string>) -> Voice { arm_spent_said() }

/// A component's handler that can fail, where it names no fate: the component.
fn handlers_fateless(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([fateless_words(r) for r in refused_in(engine, file, at)])
}

fn fateless_words(r: RefusedSeat) -> List<Found> {
    match r.seat { .Fateless(word) -> found_saying(r, [word]), _ -> [] }
}

/// a component holding a handler that can fail names a fate
export law handler_fated {
    kind: "flow.no_fate"
    reads: handlers_fateless
    voice: fateless_refused
    witness: "fn ok(n: int) -> Result<int, string> { .Ok(n) }\n\ntype W = { each: fn(int) -> Result<int, string>, dead: string? = null }\n\nfn f() -> W { W { each: ok } }\n"
}

fn fateless_refused(a: List<string>) -> Voice { fate_unnamed(a[0]) }

fn misnamed_refused(a: List<string>) -> Voice {
    match a[1] {
        "unknown" -> seat_named_unknown(a[0], a[2], a.drop(3)),
        "twice" -> seat_named_twice(a[0], a[2]),
        _ -> seat_named_unwritten(a[0], a[2]),
    }
}

fn map_unlike_refused(a: List<string>) -> Voice { map_spread_unmapped(a[0]) }

/// A variant pattern over a value that is no enum: the name it names, then the value's type.
fn pattern_variant_unshaped_found(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<
    Found,
> { misshapen_found(engine, file, at, ["variant"]) }

/// a variant pattern over a value that is no enum
export law pattern_variant_unshaped {
    kind: "type.pattern"
    reads: pattern_variant_unshaped_found
    voice: pattern_variant_unshaped_words
    witness: "enum E {\n    a(int)\n}\n\nfn f(e: E) -> int {\n    match e {\n        .a(.x) -> 1,\n        _ -> 0,\n    }\n}\n"
}

fn pattern_variant_unshaped_words(a: List<string>) -> Voice { variant_unshaped(a[1], a[2]) }

/// An `as` pattern over a written variant: the name it names, then the value's type.
fn pattern_member_written_found(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<
    Found,
> { misshapen_found(engine, file, at, ["member"]) }

/// an `as` pattern over a written variant
export law pattern_member_written {
    kind: "type.member_pattern"
    reads: pattern_member_written_found
    voice: pattern_member_written_words
    witness: "enum E {\n    a(int)\n}\n\nfn f(e: E) -> int {\n    match e {\n        .a as x -> 1,\n    }\n}\n"
}

fn pattern_member_written_words(a: List<string>) -> Voice { member_unrecorded(a[1], a[2]) }

/// A record pattern over a value that is no record: the name it names, then the value's type.
fn pattern_record_unrecorded_found(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<
    Found,
> { misshapen_found(engine, file, at, ["record"]) }

/// a record pattern over a value that is no record
export law pattern_record_unrecorded {
    kind: "type.record_pattern"
    reads: pattern_record_unrecorded_found
    voice: pattern_record_unrecorded_words
    witness: "type P = { x: int }\n\nfn f(n: int) -> int {\n    match n {\n        P { x, .. } -> x,\n        _ -> 0,\n    }\n}\n"
}

fn pattern_record_unrecorded_words(a: List<string>) -> Voice { record_pattern_unrecorded(a[1], a[2]) }

/// A list pattern over a value that is no list: the name it names, then the value's type.
fn pattern_list_unlisted_found(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> { misshapen_found(engine, file, at, ["list"]) }

/// a list pattern over a value that is no list
export law pattern_list_unlisted {
    kind: "type.list_pattern"
    reads: pattern_list_unlisted_found
    voice: pattern_list_unlisted_words
    witness: "fn f(n: int) -> int {\n    match n {\n        [a, ..] -> a,\n        _ -> 0,\n    }\n}\n"
}

fn pattern_list_unlisted_words(a: List<string>) -> Voice { list_pattern_unlisted(a[2]) }

/// A type pattern over a value no `dyn` is, or one that may be absent: whether absent, then the
/// value's type.
fn pattern_narrow_found(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> { misshapen_found(engine, file, at, ["typed", "absent"]) }

/// a type pattern over a value no `dyn` is
export law pattern_narrow_plain {
    kind: "type.narrow"
    reads: pattern_narrow_found
    voice: pattern_narrow_words
    witness: "fn f() -> int {\n    match 5 {\n        c: int -> 1,\n        _ -> 0,\n    }\n}\n"
}

fn pattern_narrow_words(a: List<string>) -> Voice { if a[0] == "absent" { narrow_absent(a[2]) } else { narrow_plain(a[2]) } }

/// Each pattern refused as the shape of its value, of a kind among `kinds`: the kind, the name it
/// names, the value's type.
fn misshapen_found(engine: QueryEngine, file: SourceFileAddress, at: int, kinds: List<string>) -> List<
    Found,
> {
    flatten([misshapen_words(r, kinds) for r in refused_in(engine, file, at)])
}

fn misshapen_words(r: RefusedSeat, kinds: List<string>) -> List<Found> {
    match r.seat {
        .Misshapen(kind, name, found) -> if kinds.contains(kind) { found_saying(r, [kind, name, found]) } else { [] },
        rest -> [],
    }
}

/// An `or` arm whose alternative binds other names than its first: the alternative, its names, then
/// the first's.
fn alternatives_apart(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([apart_words(r) for r in refused_in(engine, file, at)])
}

fn apart_words(r: RefusedSeat) -> List<Found> {
    match r.seat {
        .OrBinds(names, k, own) -> found_saying(r, ["${k}", "${own.length}"].concat(own).concat(names)),
        rest -> [],
    }
}

/// an `or` arm whose alternatives bind other names
export law alternatives_bind_alike {
    kind: "type.or_binds"
    reads: alternatives_apart
    voice: apart_refused
    witness: "enum E {\n    a(int)\n    b\n}\n\nfn f(e: E) -> int {\n    match e {\n        .a(n) or .b -> n,\n    }\n}\n"
}

fn apart_refused(a: List<string>) -> Voice {
    let k = parse_int(a[0]) ?? 0
    let count = parse_int(a[1]) ?? 0
    alternatives_bind_apart(a.drop(2 + count), k, a.drop(2).take(count))
}

/// A payload `is` outside an `if` condition.
fn payloads_outside(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten(
        [found_saying(r, []) for r in refused_in(engine, file, at) if r.seat is .PayloadOutside],
    )
}

/// a payload `is` outside an `if` condition
export law payload_is_bound_outside {
    kind: "type.is_bind"
    reads: payloads_outside
    voice: outside_refused
    witness: "enum E {\n    a(int)\n}\n\nfn f(e: E) -> bool { e is .a(x) }\n"
}

fn outside_refused(_a: List<string>) -> Voice { payload_is_outside() }

/// An `isolated` seat handed what may share its caller's: the callee and the seat, then the
/// capture's name, whether it is or holds the identity, and the identity, where a lambda captured
/// one.
fn isolations_broken(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([isolated_words(r) for r in refused_in(engine, file, at)])
}

fn isolated_words(r: RefusedSeat) -> List<Found> {
    match r.seat {
        .Isolated(callee, seat, caught) -> found_saying(
            r,
            [callee, seat]
                .concat(if caught == null { [] } else { [caught!.name, caught!.holds, caught!.held] }),
        ),
        rest -> [],
    }
}

/// an `isolated` seat handed a fn that may share what its caller has
export law isolation_broken {
    kind: "type.isolated"
    reads: isolations_broken
    voice: isolated_refused
    witness: "fn run(isolated make: fn() -> int) -> int { make() }\n\nfn g() -> int {\n    let c = Cell.new(1)\n    run(() -> c.get())\n}\n"
}

fn isolated_refused(a: List<string>) -> Voice { if a.length == 2 { isolated_unknowable(a[0], a[1]) } else { isolated_captures(a[0], a[1], a[2], a[3], a[4]) } }

/// A `const` seat handed a value computed at run time: the callee, then the seat.
fn seats_computed(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([computed_words(r) for r in refused_in(engine, file, at)])
}

fn computed_words(r: RefusedSeat) -> List<Found> { match r.seat { .Computed(callee, seat) -> found_saying(r, [callee, seat]), _ -> [] } }

/// a `const` seat handed a value computed at run time
export law const_seat_computed {
    kind: "type.const_seat"
    reads: seats_computed
    voice: computed_refused
    witness: "fn take(const n: int) -> int {\n    n\n}\n\nfn g(k: int) -> int { take(k + 1) }\n"
}

fn computed_refused(a: List<string>) -> Voice { computed_const_seat(a[0], a[1]) }

/// A variant pattern naming another number of payloads than its variant carries: the variant's
/// words.
fn arities_refused(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([arity_words(r) for r in refused_in(engine, file, at)])
}

fn arity_words(r: RefusedSeat) -> List<Found> {
    match r.seat {
        .Unbinding(owner, variant) -> found_saying(r, [owner, variant]),
        .Arity(variant, carried, named) -> found_saying(r, [variant, "${carried}", "${named}"]),
        rest -> [],
    }
}

/// a variant pattern naming another number of payloads than its variant carries
export law pattern_arity_mismatch {
    kind: "type.variant_arity"
    reads: arities_refused
    voice: arity_refused
    witness: "enum E {\n    A(int, int)\n    B\n}\n\nfn f(e: E) -> int {\n    match e {\n        .A(x) -> x,\n        .B -> 0,\n    }\n}\n"
}

fn arity_refused(a: List<string>) -> Voice {
    if a.length == 2 { nothing_carried(a[0], a[1]) } else { payloads_named(a[0], parse_int(a[1]) ?? 0, parse_int(a[2]) ?? 0) }
}

/// A map literal's key that isn't text, or value whose type isn't the one the map holds.
fn map_entries_refused(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    [found_in(r, []) for r in refused_in(engine, file, at) if r.seat is .MapValue]
}

/// a map literal's value whose type isn't the map's
export law map_value_mismatch {
    kind: "type.map_value"
    reads: map_entries_refused
    voice: map_value_refused
    witness: "fn f() -> Map<string, int> { {\"a\": \"b\"} }\n"
}

fn map_value_refused(a: List<string>) -> Voice { refused_voice(map_holds(a[0], a[1]), a[0], a[1]) }

/// A map literal's key that isn't text: what it is.
fn map_keys_refused(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    [Found { at: span_of(r.at), args: [r.found] } for r in refused_in(engine, file, at) if r.seat is .MapKey]
}

/// a map literal's key that isn't text
export law map_key_mismatch {
    kind: "type.map_key"
    reads: map_keys_refused
    voice: map_key_refused
    witness: "fn f() -> Map<string, int> { {1: 2} }\n"
}

fn map_key_refused(a: List<string>) -> Voice { Voice { message: map_keyed(a[0]), label: "this is `${a[0]}`", help: "key by text" } }

/// An index holding a value that is no `int`: what it holds.
fn indexes_refused(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([found_saying(r, [r.found]) for r in refused_in(engine, file, at) if r.seat is .Index])
}

/// an index that isn't an `int`
export law index_mismatch {
    kind: "type.mismatch"
    reads: indexes_refused
    voice: index_refused
    witness: "fn f(xs: List<int>) -> int { xs[\"a\"] }\n"
}

fn index_refused(a: List<string>) -> Voice { unplaced_index(a[0]) }

/// An operand an operator refused: the operator, the type it needs, what the operand holds.
fn operands_refused(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten([operand_words(r) for r in refused_in(engine, file, at)])
}

fn operand_words(r: RefusedSeat) -> List<Found> {
    match r.seat {
        .Operand(op, _) -> [Found { at: span_of(r.at), args: [op, r.want, r.found], aside: noted_aside(r.note) }],
        rest -> [],
    }
}

/// A sugar's note as the aside a finding says beside it.
fn noted_aside(note: SugarNote?) -> Aside? {
    let n? = note else { return null }
    Aside { label: n.label, at: span_of(n.at) }
}

/// an operand of an operator that isn't the type the operator needs
export law operand_mismatch {
    kind: "type.mismatch"
    reads: operands_refused
    voice: operand_refused
    witness: "fn f() -> int { 1 + true }\n"
}

fn operand_refused(a: List<string>) -> Voice { operand_needed(a[0], a[1], a[2]) }

/// A value `!` negates that is no `bool`: what it holds.
fn negations_refused(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten(
        [found_saying(r, [r.found]) for r in refused_in(engine, file, at) if r.seat is .Negated],
    )
}

/// a value `!` negates that isn't a `bool`
export law negation_mismatch {
    kind: "type.mismatch"
    reads: negations_refused
    voice: negation_refused
    witness: "fn f(n: int) -> bool { !n }\n"
}

fn negation_refused(a: List<string>) -> Voice { unnegated(a[0]) }

/// An operand `==` or `!=` refused as `how` says, by the words its voice reads.
fn compared_refused(
    engine: QueryEngine,
    file: SourceFileAddress,
    at: int,
    how: fn(Uncompared) -> bool,
) -> List<Found> {
    flatten([compared_words(r) for r in refused_in(engine, file, at) if compared_how(r.seat, how)])
}

/// Whether the seat `seat` is an operand `==` or `!=` refused as `how` takes.
fn compared_how(seat: Seating, how: fn(Uncompared) -> bool) -> bool {
    match seat { .Compared(_, c) -> how(c), rest -> false }
}

/// A comparison's refusal as its voice reads it: the operator, the left side's type, the right's (the
/// refused side's, for a value that compares by none), and what to reach for instead.
fn compared_words(r: RefusedSeat) -> List<Found> {
    match r.seat {
        .Compared(op, how) -> found_saying(r, [op, r.want, r.found, compared_help(how)]),
        rest -> [],
    }
}

/// Where a comparison of a value that compares by none says to look instead.
fn compared_help(how: Uncompared) -> string {
    match how { .Uncomparable(o) -> compare_help(o), .Mismatched or .Unasked or .Absent -> "" }
}

fn mismatched_found(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> { compared_refused(engine, file, at, (c) -> c is .Mismatched) }

fn mismatched_said(a: List<string>) -> Voice { sides_unmatched(a[0], a[1], a[2]) }

fn uncompared_found(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> { compared_refused(engine, file, at, (c) -> c is .Uncomparable) }

fn uncompared_said(a: List<string>) -> Voice { uncompared(a[0], a[2], a[3]) }

fn unasked_found(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> { compared_refused(engine, file, at, (c) -> c is .Unasked) }

fn unasked_said(a: List<string>) -> Voice { null_unasked(a[0], a[2]) }

fn absent_found(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> { compared_refused(engine, file, at, (c) -> c is .Absent) }

fn absent_said(a: List<string>) -> Voice { always_absent(a[0]) }

/// An operand wearing a name beside another's: the name the other side wears, then its own.
fn names_mixed(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    flatten(
        [found_saying(r, [r.want, r.found]) for r in refused_in(engine, file, at) if r.seat is .TwoNames],
    )
}

/// an operand wearing a name beside one wearing another
export law named_operands {
    kind: "type.mismatch"
    reads: names_mixed
    voice: names_mixed_said
    witness: "type A = int\ntype B = int\n\nfn f(a: A, b: B) -> A { a + b }\n"
}

fn names_mixed_said(a: List<string>) -> Voice { two_named(a[0], a[1]) }

/// An operand of the shape a name stands over, beside one wearing the name: the name, the shape, and
/// the construction that crosses it in, sure, where the operand is written.
fn shapes_mixed(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    let text = source_text(engine, file) ?? ""
    [shape_found(r, text) for r in refused_in(engine, file, at) if r.seat is .Shaped]
}

/// The refusal `r` of an operand of a name's shape, offering `Name(value)` over its written text.
fn shape_found(r: RefusedSeat, text: string) -> Found {
    let args = [r.want, r.found]
    let span? = span_of(r.at) else { return Found { at: null, args: args } }
    let call = "${r.want}(${text.substring(span.lo, span.hi)})"
    Found {
        at: span,
        args: args,
        fixes: [FoundFix { description: "write `${call}`", at: span, replacement: call, sure: true }],
    }
}

/// an operand of a name's own shape beside one wearing the name
export law mixed_with_shape {
    kind: "type.mismatch"
    reads: shapes_mixed
    voice: shape_mixed_said
    witness: "type Meters = int\n\nfn f(m: Meters, k: int) -> Meters { m + k }\n"
}

fn shape_mixed_said(a: List<string>) -> Voice { shape_mixed(a[0], a[1]) }

/// `==` or `!=` between two types
export law comparison_mismatch {
    kind: "type.mismatch"
    reads: mismatched_found
    voice: mismatched_said
    witness: "fn f(n: int) -> bool { n == \"a\" }\n"
}

/// `==` or `!=` beside a value that compares by no value
export law comparison_by_value {
    kind: "type.mismatch"
    reads: uncompared_found
    voice: uncompared_said
    witness: "fn f(xs: List<int>) -> bool { xs == xs }\n"
}

/// `== null` or `!= null` beside a value that is never absent
export law comparison_unasked {
    kind: "type.mismatch"
    reads: unasked_found
    voice: unasked_said
    witness: "fn f(n: int) -> bool { n == null }\n"
}

/// `==` or `!=` between two `null`s
export law comparison_absent {
    kind: "type.mismatch"
    reads: absent_found
    voice: absent_said
    witness: "fn f() -> bool { null == null }\n"
}

/// An argument a `mut` seat refused, as `how` says: its callee, its place, and the root it stands in.
fn handed_refused(engine: QueryEngine, file: SourceFileAddress, at: int, how: Unhanded) -> List<
    Found,
> {
    [h! for r in refused_in(engine, file, at) for h in [handed_words(r, how)] if h != null]
}

fn handed_words(r: RefusedSeat, how: Unhanded) -> Found? {
    match r.seat {
        .Handed(callee, place, root, why) -> if why == how { Found { at: span_of(r.at), args: [callee, "${place}", root] } } else { null },
        .Argument(_, _) or .Method(_, _, _) or .Field(_) or .Payload(_, _) or .Binding(_) or .Return(_) or .Body(_) or .Hole(_) or .Condition(_) or .FieldDefault(_) or .SeatDefault(_) or .Pronoun or .Index or .Element or .MapKey or .MapValue or .Uncovered(_, _) or .Catchless(_) or .Refutable(_) or .Unmatchable or .Repeated(_) or .Unbinding(_, _) or .Arity(_, _, _) or .BindsTwice(_) or .ElementsApart(_) or .SpreadUnlike(_) or .SpreadPlace(_, _) or .Restless(_) or .VariantCount(_, _, _, _) or .Misshapen(_, _, _) or .OrBinds(_, _, _) or .PayloadOutside or .Isolated(_, _, _) or .Sealed(_, _, _) or .Computed(_, _) or .Walk(_, _, _, _) or .Unwalked(_, _, _) or .Unwritten(_, _) or .Valued(_) or .Unvaried(_, _, _, _) or .Unwaited(_) or .Nameless(_, _) or .Operand(_, _) or .Negated or .Compared(_, _) or .TwoNames or .Unnamed or .KeptArm or .Fnless(_) or .Bare(_) or .Shaped or .Unlistable(_) or .CellUnmapped(_) or .ExternValue(_, _, _) or .SeatNamed(_, _, _, _) or .CompUnwalked(_) or .NotOffered(_, _, _) or .Unwaitable(_) or .ArmBinder(_, _, _) or .SpentArm or .Fateless(_) -> null,
    }
}

fn seats_valued(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> { handed_refused(engine, file, at, Unhanded.Valued) }

fn seats_unwritten(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> { handed_refused(engine, file, at, Unhanded.Unwritten) }

fn seats_captured(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> { handed_refused(engine, file, at, Unhanded.Captured) }

fn seats_cellless(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> { handed_refused(engine, file, at, Unhanded.Cellless) }

fn seats_stateless(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> { handed_refused(engine, file, at, Unhanded.Stateless) }

/// An extern's argument a seat name names: the extern and the name.
fn externs_named(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    [Found { at: span_of(r.at), args: [n.callee, n.label] } for r in refused_in(engine, file, at) for n in some_list(named_extern(r.seat))]
}

/// The extern and the name a `Nameless` seat carries; absent for any other seat.
fn named_extern(seat: Seating) -> NamedExtern? {
    match seat {
        .Nameless(callee, label) -> NamedExtern { callee: callee, label: label },
        rest -> null,
    }
}

/// An extern called with a named argument: the extern, and the name.
type NamedExtern = { callee: string, label: string }

/// an extern's seats are called by position
export law extern_named_argument {
    kind: "type.named_arg"
    reads: externs_named
    voice: nameless_words
    witness: "extern fn frexp(x: float, mut exponent: i32) -> float\n\nfn f() -> float {\n    mut e = 0\n    frexp(exponent: e, x: 0.25)\n}\n"
}

fn nameless_words(a: List<string>) -> Voice { nameless_seats(a[1], a[0]) }

/// a `mut` seat handed a value
export law seat_valued {
    kind: "type.seat"
    reads: seats_valued
    voice: valued_words
    witness: "fn grow(mut xs: List<int>) {\n    xs.push(1)\n}\n\nfn f() {\n    grow([1])\n}\n"
}

/// a `mut` seat handed a place rooted in a binding that isn't `mut`
export law seat_unwritten {
    kind: "type.seat"
    reads: seats_unwritten
    voice: unwritten_words
    witness: "fn grow(mut xs: List<int>) {\n    xs.push(1)\n}\n\nfn f() {\n    let ys = [1]\n    grow(ys)\n}\n"
}

/// a `mut` seat handed a place a lambda holds a copy of
export law seat_captured {
    kind: "type.seat"
    reads: seats_captured
    voice: captured_words
    witness: "fn grow(mut xs: List<int>) {\n    xs.push(1)\n}\n\nfn f() {\n    mut ys = [1]\n    let g = () -> grow(ys)\n    g()\n}\n"
}

/// an extern's `mut` seat handed a place that is no `mut` binding's own cell
export law seat_cellless {
    kind: "type.host_seat"
    reads: seats_cellless
    voice: cellless_words
    witness: "extern fn time(mut t: i64) -> i64\n\nfn stamp(mut t: int) -> int { time(t) }\n"
}

/// a `state` seat handed what is no `state` of the caller's own
export law seat_stateless {
    kind: "type.seat"
    reads: seats_stateless
    voice: stateless_words
    witness: "fn bump(state n: int) { n = n + 1 }\n\nfn f() {\n    bump(1)\n}\n"
}

/// The seat's index a refusal's words spell.
fn seat_index(spelled: string) -> int { parse_int(spelled) ?? 0 }

fn valued_words(a: List<string>) -> Voice { valued_seat(a[0], seat_index(a[1])) }

fn unwritten_words(a: List<string>) -> Voice { unwritten_seat(a[2], a[0], seat_index(a[1])) }

fn captured_words(a: List<string>) -> Voice { captured_seat(a[2], a[0], seat_index(a[1])) }

fn cellless_words(a: List<string>) -> Voice { cellless_seat(a[0], seat_index(a[1])) }

fn stateless_words(a: List<string>) -> Voice { stateless_seat(a[0], seat_index(a[1])) }

collect listed_refusal_facts: List<ListedQuery> = @query_definition in self as ListedQuery { definition: it } by it.name

/// The queries a seat's refusals are read through, for a process to hand its engine.
export fn refusal_fact_definitions() -> List<QueryDefinition> { definitions_of(listed_refusal_facts) }
