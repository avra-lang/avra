/// A fn's body a seat refused.
fn bodies_refused(engine: QueryEngine, file: SourceFileAddress, at: ItemId) -> List<Found> {
    flatten([body_words(r) for r in refused_in(engine, file, at)])
}

/// What a `then` case's body seat is named: a keyword, so no fn's body wears it.
const CASE_SEAT: string = "then"

/// A refusal in a `then` case's body, its answer's own refusal said as the case's.
fn case_seated(r: RefusedSeat) -> RefusedSeat {
    match r.seat { .Body(_) -> r with { seat: Seating.Body(CASE_SEAT) }, rest -> r }
}

/// Whether `r` is a `then` case's answer refused.
fn case_answer(r: RefusedSeat) -> bool {
    match r.seat { .Body(name) -> name == CASE_SEAT, rest -> false }
}

/// Each `then` case of the item `at` of `file` whose answer isn't a bool.
fn cases_refused(engine: QueryEngine, file: SourceFileAddress, at: ItemId) -> List<Found> {
    [found_in(r, []) for r in refused_in(engine, file, at) if case_answer(r)]
}

fn case_refused(a: List<string>) -> Voice {
    Voice { message: case_answers_said(a[1]), label: CASE_ANSWER_LABEL, help: CASE_ANSWER_HELP }
}

/// a `then` case whose answer isn't the bool it proves
export law case_mismatch {
    kind: "type.case"
    reads: cases_refused
    voice: case_refused
    witness: "spec \"s\" {\n    given \"g\" {\n        then \"t\" { 1 }\n    }\n}\n"
}

fn body_words(r: RefusedSeat) -> List<Found> {
    match r.seat {
        .Body(name) -> if name == CASE_SEAT { [] } else { [found_in(r, [name])] },
        .Argument(_, _) or .Method(_, _, _) or .Field(_) or .Payload(_, _) or .Binding(_) or .Return(_) or .Hole(_) or .Condition(_) or .FieldDefault(_) or .AnnotationSeat(_) or .SeatDefault(_) or .Pronoun or .Index or .Element or .MapKey or .MapValue or .Uncovered(_, _) or .Catchless(_) or .Refutable(_) or .Unmatchable or .Repeated(_) or .Unbinding(_, _) or .Arity(_, _, _) or .BindsTwice(_) or .ElementsApart(_) or .SpreadUnlike(_) or .SpreadPlace(_, _) or .Restless(_) or .VariantCount(_, _, _, _) or .Misshapen(_, _, _) or .OrBinds(_, _, _) or .PayloadOutside or .Isolated(_, _, _) or .Sealed(_, _, _) or .Computed(_, _) or .Walk(_, _, _, _) or .Unwalked(_, _, _) or .Unwritten(_, _) or .Valued(_) or .Unvaried(_, _, _, _) or .Handed(_, _, _, _) or .Unwaited(_) or .Nameless(_, _) or .Operand(_, _) or .Negated or .Compared(_, _) or .TwoNames or .Unnamed or .KeptArm or .Arm(_) or .Lambda(_) or .Unenumed(_, _, _) or .Unmatched or .Unasked or .Fnless(_) or .Bare(_) or .Shaped or .Unlistable(_) or .CellUnmapped(_) or .ExternValue(_, _, _) or .SeatNamed(_, _, _, _) or .CompUnwalked(_) or .NotOffered(_, _, _) or .Unwaitable(_) or .ArmBinder(_, _, _) or .SpentArm or .SelectFault(_) or .HoleFault(_) or .Fateless(_) or .Miscounted(_, _, _, _, _, _, _, _) or .OneFn(_, _) or .WalkSeats(_, _) or .Block(_, _, _) or .Unpredicated(_, _, _) or .Assigned(_, _) or .ArmApart(_) or .BranchesApart or .WhenApart or .FieldRepeated(_) or .Uncalled(_, _) or .FailureUnpromised(_, _) or .AbsenceUnpromised(_, _) or .FailuresApart(_, _) or .Raised(_) or .RangeBound(_) or .Caught(_) or .CaughtArm or .Voided or .Within(_) or .Guarantee(_) or .ForUnwalked(_) or .Literal(_) or .Unimplemented or .Folded(_) or .Pinned(_, _, _) or .Unpinned(_, _) or .CompBound(_) or .NullPin(_, _) or .TypeHole(_) or .Unprojected(_) or .Unknowable(_) or .CellHolds or .DefaultUnimplemented(_) or .StaticUnpinned(_, _) or .Heard(_) or .LiteralUnpinned(_, _, _, _) -> [],
    }
}

/// a fn's argument whose type isn't the seat's
export law argument_mismatch {
    kind: "type.mismatch"
    reads: arguments_refused
    voice: argument_refused
    witness: "fn f(n: int) -> int { n }\n\nfn g() -> int { f(\"x\") }\n"
}

/// a method's argument whose type isn't the seat's
export law method_argument_mismatch {
    kind: "type.method"
    reads: method_arguments_refused
    voice: method_argument_refused
    witness: "type P = { n: int }\n\nimpl P {\n    fn add(k: int) -> int { self.n + k }\n}\n\nfn g(p: P) -> int { p.add(\"x\") }\n"
}

/// a record literal's field whose type isn't the field's
export law field_mismatch {
    kind: "type.struct_fields"
    reads: fields_refused
    voice: field_refused
    witness: "type P = { n: int }\n\nfn g() -> P { P { n: \"x\" } }\n"
}

/// a setting naming an event holds a handler of the event's type
export law handler_mismatch {
    kind: "type.component_event"
    reads: handlers_refused
    voice: handler_refused
    witness: "component panel {\n    on press\n}\n\nfn f() -> int {\n    let a = panel { press: 5 }\n    1\n}\n"
}

fn handler_refused(a: List<string>) -> Voice { handler_mistyped(a[0], a[1], a[2]) }

/// a variant's payload whose type isn't the payload's
export law payload_mismatch {
    kind: "type.variant_arity"
    reads: payloads_refused
    voice: payload_refused
    witness: "enum E {\n    A(int)\n    B\n}\n\nfn g() -> E { E.A(\"x\") }\n"
}

/// a binding's value whose type isn't the one it declares
export law binding_mismatch {
    kind: "type.binding"
    reads: bindings_refused
    voice: binding_refused
    witness: "fn g() -> int {\n    let n: int = \"x\"\n    n\n}\n"
}

/// A `return` no fn encloses.
fn fnless_returns(engine: QueryEngine, file: SourceFileAddress, at: ItemId) -> List<Found> {
    flatten([found_saying(r, []) for r in refused_in(engine, file, at) if r.seat is .Fnless])
}

/// a `return` that no fn encloses
export law return_unenclosed {
    kind: "type.return"
    reads: fnless_returns
    voice: fnless_said
    witness: "return 1\n"
}

fn fnless_said(_a: List<string>) -> Voice { return_fnless() }

/// A bare `return` in a fn that answers a value: what it answers.
fn bare_returns(engine: QueryEngine, file: SourceFileAddress, at: ItemId) -> List<Found> {
    flatten([found_saying(r, [r.want]) for r in refused_in(engine, file, at) if r.seat is .Bare])
}

/// a bare `return` in a fn that answers a value
export law return_unanswered {
    kind: "type.return"
    reads: bare_returns
    voice: bare_said
    witness: "fn g() -> int {\n    return\n}\n"
}

fn bare_said(a: List<string>) -> Voice { return_bare(a[0]) }

/// a `return` whose value isn't what the fn answers
export law return_mismatch {
    kind: "type.return"
    reads: returns_refused
    voice: return_refused
    witness: "fn g() -> int {\n    return \"x\"\n}\n"
}

/// a fn's body whose value isn't what the fn declares it answers
export law body_mismatch {
    kind: "type.mismatch"
    reads: bodies_refused
    voice: body_refused
    witness: "fn g() -> int { \"x\" }\n"
}

fn argument_refused(a: List<string>) -> Voice {
    helped(
        refused_voice("argument ${a[1]} of `${a[0]}` wants `${a[2]}`, found `${a[3]}`", a[2], a[3]),
        a,
        4,
    )
}

fn method_argument_refused(a: List<string>) -> Voice {
    helped(
        refused_voice(
            "argument ${a[2]} of `${a[0]}.${a[1]}` wants `${a[3]}`, found `${a[4]}`",
            a[3],
            a[4],
        ),
        a,
        5,
    )
}

fn field_refused(a: List<string>) -> Voice { helped(refused_voice("field `${a[0]}` is `${a[1]}`, this is `${a[2]}`", a[1], a[2]), a, 3) }

fn payload_refused(a: List<string>) -> Voice { refused_voice("`${a[0]}.${a[1]}` carries `${a[2]}`, found `${a[3]}`", a[2], a[3]) }

fn binding_refused(a: List<string>) -> Voice { helped(refused_voice("`${a[0]}` declares `${a[1]}`, this is `${a[2]}`", a[1], a[2]), a, 3) }

/// `v` with the help a conversion handed its words at `at`, where one did.
fn helped(v: Voice, a: List<string>, at: int) -> Voice { if a.length > at { v with { help: a[at] } } else { v } }

/// A seat's value refused as `f`, with the one honest conversion the old path offers of it where
/// there is one: its help said, its text the fix. A spread is no value a conversion wraps.
fn seat_converted(f: Found, r: RefusedSeat, text: string) -> Found {
    if r.spread { return f }
    converted(f, seat_conversion(r.found, r.want, text_at(r.at, text)))
}

/// The text of the written item `at` of `file`; none past its items.
fn item_text(engine: QueryEngine, file: SourceFileAddress, at: ItemId) -> string { if item_held(engine, file, at) { item_under(engine, file, at).text } else { "" } }

/// `f` offering the conversion `c` where there is one: its help handed the voice last, its text the
/// fix where `f` stands.
fn converted(f: Found, c: Conversion?) -> Found {
    let offered? = c else { return f }
    f with { args: f.args.concat([offered.help]), fixes: [
        FoundFix {
            description: offered.how,
            at: f.at,
            replacement: offered.text,
            sure: offered.confidence is .High,
            guess: offered.confidence is .Low,
        },
    ] }
}

fn return_refused(a: List<string>) -> Voice { refused_voice("`return` answers `${a[0]}`, this is `${a[1]}`", a[0], a[1]) }

fn body_refused(a: List<string>) -> Voice {
    Voice {
        message: "the body answers `${a[2]}` but `${a[0]}` declares `${a[1]}`",
        label: "this is `${a[2]}`",
        help: "the body's last expression is the answer — make it a `${a[1]}`, or change the declared answer",
    }
}

/// A record field's default whose type isn't the field's.
fn field_defaults_refused(engine: QueryEngine, file: SourceFileAddress, at: ItemId) -> List<Found> {
    flatten([field_default_words(r) for r in refused_in(engine, file, at)])
}

fn field_default_words(r: RefusedSeat) -> List<Found> {
    match r.seat {
        .FieldDefault(name) -> [found_in(r, [name])],
        .Argument(_, _) or .Method(_, _, _) or .Field(_) or .Payload(_, _) or .Binding(_) or .Return(_) or .Body(_) or .Hole(_) or .Condition(_) or .AnnotationSeat(_) or .SeatDefault(_) or .Pronoun or .Index or .Element or .MapKey or .MapValue or .Uncovered(_, _) or .Catchless(_) or .Refutable(_) or .Unmatchable or .Repeated(_) or .Unbinding(_, _) or .Arity(_, _, _) or .BindsTwice(_) or .ElementsApart(_) or .SpreadUnlike(_) or .SpreadPlace(_, _) or .Restless(_) or .VariantCount(_, _, _, _) or .Misshapen(_, _, _) or .OrBinds(_, _, _) or .PayloadOutside or .Isolated(_, _, _) or .Sealed(_, _, _) or .Computed(_, _) or .Walk(_, _, _, _) or .Unwalked(_, _, _) or .Unwritten(_, _) or .Valued(_) or .Unvaried(_, _, _, _) or .Handed(_, _, _, _) or .Unwaited(_) or .Nameless(_, _) or .Operand(_, _) or .Negated or .Compared(_, _) or .TwoNames or .Unnamed or .KeptArm or .Arm(_) or .Lambda(_) or .Unenumed(_, _, _) or .Unmatched or .Unasked or .Fnless(_) or .Bare(_) or .Shaped or .Unlistable(_) or .CellUnmapped(_) or .ExternValue(_, _, _) or .SeatNamed(_, _, _, _) or .CompUnwalked(_) or .NotOffered(_, _, _) or .Unwaitable(_) or .ArmBinder(_, _, _) or .SpentArm or .SelectFault(_) or .HoleFault(_) or .Fateless(_) or .Miscounted(_, _, _, _, _, _, _, _) or .OneFn(_, _) or .WalkSeats(_, _) or .Block(_, _, _) or .Unpredicated(_, _, _) or .Assigned(_, _) or .ArmApart(_) or .BranchesApart or .WhenApart or .FieldRepeated(_) or .Uncalled(_, _) or .FailureUnpromised(_, _) or .AbsenceUnpromised(_, _) or .FailuresApart(_, _) or .Raised(_) or .RangeBound(_) or .Caught(_) or .CaughtArm or .Voided or .Within(_) or .Guarantee(_) or .ForUnwalked(_) or .Literal(_) or .Unimplemented or .Folded(_) or .Pinned(_, _, _) or .Unpinned(_, _) or .CompBound(_) or .NullPin(_, _) or .TypeHole(_) or .Unprojected(_) or .Unknowable(_) or .CellHolds or .DefaultUnimplemented(_) or .StaticUnpinned(_, _) or .Heard(_) or .LiteralUnpinned(_, _, _, _) -> [],
    }
