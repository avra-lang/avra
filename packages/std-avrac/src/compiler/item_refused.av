    extern_unvalued,
    extern_wrapper,
    seat_named_twice,
    seat_named_unknown,
    seat_named_unwritten,
    spread_placeless,
    variant_carries_nothing,
    variant_given_nothing,
    spread_restless,
    Unsettled,
    compare_help,
    uncompared,
    unsettled_voice,
    captured_seat,
    nameless_seats,
    unwritten_receiver,
    unwritten_seat,
    valued_receiver,
    valued_seat,
