//! THE FINDINGS ROWS — one row per rule hit: the rule that fired,
//! the file it fired in, and the source line it named, trimmed. A row
//! exists only where `rule_findings` (rule_pass.av) fired, so a
//! `Finding` names a RULE alone, never a compiler-law warning — no
//! kind-matching needed to tell the two apart, the way the rendered
//! `warning[kind]: …` text once required.
use core.{joined, flatten}
use diagnostics.{Diag, SourceFile, new_source_file}
use compiler.host.{Host}

export type Finding = { rule: string, file: string, text: string }

/// Every rule finding across `p`, found now — a program built outside a
/// check. A check never asks: each file's rows are kept as it speaks
/// (derive.av's `file_said`), and `Checked.findings` reads them back.
export fn findings_of(p: Program) -> List<Finding> {
    flatten([rows_found(p.ws.host, a, rule_findings(analysed(a), a.view.stmts)) for a in p.files])
}

/// One file's findings, in `findings_read`'s lines — the row a held file
/// answers with in place of its rules running again.
export fn file_findings_text(host: Host, a: Analysis, found: List<Diag>) -> string {
    joined([finding_line(f) for f in rows_found(host, a, found)], "\n")
}

fn rows_found(host: Host, a: Analysis, found: List<Diag>) -> List<Finding> {
    let src = current_source(host, a.view.source)
    flatten([filed_finding(src, d) for d in found])
}

/// The file's line table over its CURRENT text — read through the
/// host, never the parse's own copy, so a finding's trimmed line
/// answers what the file holds now. A file that is gone, or that the
/// host can no longer give as text, keeps what the parse held; an empty
/// file is empty.
fn current_source(host: Host, src: SourceFile) -> SourceFile {
    let text? = host.spared_text(src.file).as_text() else { return src }
    new_source_file(src.file, text)
}

/// The kept rows read back: one `rule\tfile\ttext` per line, the
/// shape `Db`'s durable `Findings` row holds (db.av).
export fn findings_read(text: string) -> List<Finding> {
    [finding_of_line(line) for line in text.split("\n") if line != ""]
}

fn finding_line(f: Finding) -> string { "${f.rule}\t${f.file}\t${f.text}" }

fn finding_of_line(line: string) -> Finding {
    let parts = line.split("\t")
    Finding { rule: parts[0], file: parts[1], text: parts[2] }
}

/// A finding with no place to point (a locationless `Say` voice) rows
/// nothing — a baseline site is always a source line, never a bare
/// claim.
fn filed_finding(src: SourceFile, d: Diag) -> List<Finding> {
    let loc? = d.primary.loc else { return [] }
    let line = src.linecol(loc.lo).line
    [Finding { rule: d.kind, file: loc.file ?? src.file, text: src.line_text(line).trim() }]
}
