    literal_of,
    template_file,
    template_home,
    Seating,
    callee_said,
    kept_by_key,
    named_said,
    cell_of,
    BoxedValue,
    StructParts,
    Arm,
    CollectKind,
    doc_first_paragraph,
    pattern_kinds,
    root_kind_of,
    CalledFn,
    CalledSeat,
    CollectedRow,
    CollectedValue,
    Defaulting,
    Expr,
    ExprId,
    FnWrapper,
    Ins,
    Layout,
    LiftedBody,
    Literal,
    LoweredProgram,
    Lowering,
    ProjField,
    NamedValue,
    Param,
    ParameterLayout,
    RECEIVER,
    SignedType,
    Slot,
    Span,
    Static,
    StaticBox,
    StmtId,
    SyntaxArena,
    TaskChecks,
    TaskTest,
