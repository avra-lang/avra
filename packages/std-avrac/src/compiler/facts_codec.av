//! A TYPING FACT'S SCOPE — how a body's `TypeFacts` crosses a process: every arena id its
//! columns hold is written as a name the next process can resolve, and read back through the
//! inverse. A declaration, a type and a file cross as the spelling the settlement wires
//! already use (`decl_ref`, `type_ref`, `file_ref`); an expression and a statement as their
//! offset from the window the facts were typed over, so the same body at another place in
//! its file reads as the same facts. A spelling that resolves to nothing — a declaration
//! moved, a type no longer declared — refuses the read: a stale fact is a miss, never a lie.
use core.{DeclId, TypeId, FileId}
use @std.relation.stable.{Scope}
use @std.text.{parse_int}

/// The id types a typing fact reaches.
enum IdKind {
    Decl
    Type
    File
    Expr
    Stmt
}

/// The id type a codec names by its own declaration's name. The one table that says which
/// names are the arena ids; a dense id the table does not hold is spoken, never guessed.
fn id_kind(name: string) -> IdKind? {
    match name {
        "DeclId" -> .Decl,
        "TypeId" -> .Type,
        "FileId" -> .File,
        "ExprId" -> .Expr,
        "StmtId" -> .Stmt,
        _ -> null,
    }
}

/// An offset text as the index it stands for under `base`.
fn counted_from(text: string, base: int) -> int? {
    let n? = parse_int(text) else { return null }
    n + base
}

/// A workspace and the two windows' bases its expressions and statements are offset from.
type FactsScope = { ws: Workspace, expr_base: int, stmt_base: int }

impl Scope for FactsScope {
    fn spelled(kind: string, index: int) -> string {
        let k? = id_kind(kind) else {
            self.ws.defect("a typing fact holds an id of `${kind}`, which no scope spells")
            return ""
        }
        match k {
            .Decl -> self.ws.decl_ref(DeclId { index: index }),
            .Type -> self.ws.type_ref(TypeId { index: index }),
            .File -> self.ws.file_ref(FileId { index: index }),
            .Expr -> "${index - self.expr_base}",
            .Stmt -> "${index - self.stmt_base}",
        }
    }

    fn unspelled(kind: string, text: string) -> int? {
        let k? = id_kind(kind) else { return null }
        match k {
            .Decl -> self.ws.decl_from_ref(text)?.index,
            .Type -> self.ws.type_from_wire(text)?.index,
            .File -> self.ws.decls.known_file_id(text)?.index,
            .Expr -> counted_from(text, self.expr_base),
            .Stmt -> counted_from(text, self.stmt_base),
        }
    }
}

/// The scope typing facts cross under in `ws`, expressions counted from `expr_base` and
/// statements from `stmt_base` — a body's own window starts.
export fn facts_scope(ws: Workspace, expr_base: int, stmt_base: int) -> dyn Scope {
    FactsScope { ws: ws, expr_base: expr_base, stmt_base: stmt_base }
}
