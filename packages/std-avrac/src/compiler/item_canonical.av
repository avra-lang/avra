//! A FILE AS CANONICAL AVRA, FROM A PARSE ALONE: its text read whole under the words its items read
//! under, printed, and held to the receipts a rewrite owes. Formatting moves no token that typing
//! decides, so nothing here types: a file is asked for its text and its words' shapes, and no more.
//! The same whole read says which of its `// LICENSED` citations name nothing.
use core.{Expr, ExprId, StmtId, SyntaxArena, flatten, joined}
use compiler.format.{lossless_defect, remarks_and_docs_defect, render_source_of}
use diagnostics.{SourceFile, has_errors, new_source_file, render_among}
use features.{BlockWords}
use @std.meta.{derive}
use @std.program.address.{SourceFileAddress}
use @std.program.query_engine.{QueryDefinition, QueryEngine}
use @std.program.saved_derive.{Saved}
use @std.program.saved_query.{ListedQuery, definitions_of, query, query_definition}
use @std.program.source_facts.{file_context, source_text}

/// What a file's text is to the formatter: canonical as it stands, not yet, or one it refuses —
/// a file whose parse speaks, said in its first line.
@derive(Saved)
export enum Canonical {
    Stands
    Differs
    Refused(why: string)
}

/// The words a file's text is read whole under: each component by its shape, each sublanguage it
/// imports readied, so a block of one is read by its grammar and a provider that moves a word moves
/// what the file's parse says.
fn whole_words(engine: QueryEngine, file: SourceFileAddress) -> BlockWords {
    context_words(file_context(engine, file)) with { grammars: [g! for w in file_grammars(engine, file) for g in [readied(w)] if g != null] }
}

/// A file's text as the formatter reads it: named as the program spells the file.
fn whole_source(engine: QueryEngine, file: SourceFileAddress) -> SourceFile { new_source_file(spelled_file(file), source_text(engine, file) ?? "") }

/// A FILE AS CANONICAL AVRA, without its closing newline — or its parse's report.
export fn file_formatted(engine: QueryEngine, file: SourceFileAddress) -> Result<string, string> {
    formatted_under(whole_source(engine, file), whole_words(engine, file))
}

/// `file_formatted`, gated for a write by the receipts (`write_checked_under`).
export fn file_write_checked(engine: QueryEngine, file: SourceFileAddress) -> Result<string, string> {
    write_checked_under(whole_source(engine, file), whole_words(engine, file))
}

/// A TEXT AS CANONICAL AVRA, read under `words`, without its closing newline — or its parse's
/// report. It prints the text AS WRITTEN, never a generated declaration; and it refuses one whose
/// parse speaks, since a tree with holes prints those regions back as nothing. A text that doesn't
/// type is no bar.
export fn formatted_under(src: SourceFile, words: BlockWords) -> Result<string, string> {
    let parsed = parse_program(avra(), src, words)
    if !has_errors(parsed.voices.list) { return .Ok(render_source_of(parsed.store, parsed.stmts, src.text)) }
    .Err(joined([render_among(d, [src]) for d in parsed.voices.list], "\n\n"))
}

/// `formatted_under`, gated for a write: the LOSSLESS receipt must hold — the same significant
/// tokens, remarks and doc groups the text carried, in order — or the CANON one: the same meaning,
/// remarks and doc groups, tokens free to move. It writes nothing; it answers the text safe to write.
export fn write_checked_under(src: SourceFile, words: BlockWords) -> Result<string, string> {
    let text = formatted_under(src, words)?
    // the receipt compares what reaches disk: the text and the file's closing newline
    let after = "${text}\n"
    let bad? = lossless_defect(src.text, after) else { return .Ok(text) }
    let canon? = canon_defect(src, after, words) else { return .Ok(text) }
    .Err(write_refused(bad, canon))
}

/// What a rewrite `after` of `src` moved that a canon rewrite may not: a remark or a doc group, a
/// statement, or a statement's meaning, each read under the same `words`.
export fn canon_defect(src: SourceFile, after: string, words: BlockWords) -> string? {
    let moved = remarks_and_docs_defect(src.text, after)
    if moved != null { return moved }
    let was = parse_program(avra(), src, words)
    if has_errors(was.voices.list) { return "the source has parse errors" }
    let now = parse_program(avra(), new_source_file(src.file, after), words)
    if has_errors(now.voices.list) { return "the rewrite does not reparse" }
    if was.stmts.length != now.stmts.length { return "the statement count moved: ${was.stmts.length} -> ${now.stmts.length}" }
    let before = verbatim_blanked(was.store)
    let after_read = verbatim_blanked(now.store)
    let at? = (0..was.stmts.length)
        .find((i) -> before.stmt_fingerprint(was.stmts[i]) != after_read.stmt_fingerprint(now.stmts[i])) else {
        return if same_prints(verbatim_prints(before), verbatim_prints(after_read)) { null } else { "a component body's meaning moved" }
    }
    "statement ${at}'s meaning moved"
}

/// `store` with the text of each body it keeps verbatim — a component's, beside the statements it
/// was parsed into — blanked and its prints derived again: that text is the statements' source,
/// which a canon rewrite lays out anew, and the statements say what it means (`verbatim_prints`).
fn verbatim_blanked(store: SyntaxArena) -> SyntaxArena {
    for i in 0..store.expr_count() {
        let b? = store.expr(ExprId { index: i }).body_of() else { continue }
        if b.view is .Verbatim { store.exprs.replaced(i, Expr.Body(b.word, [], b.holes, b.view)) }
    }
    store.settle_prints()
    store
}

/// The print of every statement a verbatim body of `store` was parsed into, body by body.
fn verbatim_prints(store: SyntaxArena) -> List<int> {
    flatten(
        [[store.stmt_fingerprint(s) for s in verbatim_stmts(store.expr(ExprId { index: i }))] for i in 0..store.expr_count()],
    )
}

/// Whether `a` and `b` hold the same prints in the same order.
fn same_prints(a: List<int>, b: List<int>) -> bool { a.length == b.length && (0..a.length).all(a[it] == b[it]) }

/// The statements a verbatim body `e` was parsed into; none for any other node.
fn verbatim_stmts(e: Expr) -> List<StmtId> {
    let b? = e.body_of() else { return [] }
    match b.view { .Verbatim(stmts, _) -> stmts, rest -> [] }
}

/// WHETHER A FILE STANDS CANONICAL: its text printed back is its text, byte for byte. The answer is
/// kept with what it read — the file's text and its words' shapes — so a file nobody edited, under
/// providers nobody edited, is not parsed or printed again.
@query
export fn file_canonical(engine: QueryEngine, file: SourceFileAddress) -> Canonical {
    match file_formatted(engine, file) {
        .Ok(text) -> if "${text}\n" == source_text(engine, file) ?? "" { Canonical.Stands } else { Canonical.Differs },
        .Err(report) -> Canonical.Refused(report.split("\n").first() ?? report),
    }
}

/// A `// LICENSED` citation naming nothing that reads it: the line it stands on, and its id.
@derive(Saved)
export type StaleCitation = { line: int, id: string }

/// EACH `// LICENSED` CITATION OF A FILE THAT NAMES NOTHING: no rule `avra rules` lists, and no
/// keeper's family — read off a lex of the file under its words, so a raw block's body is never
/// read as a comment.
@query
export fn stale_citations(engine: QueryEngine, file: SourceFileAddress) -> List<StaleCitation> {
    let src = whole_source(engine, file)
    citations_naming_nothing(
        src,
        lexed_under(src.text, words_lexed(whole_words(engine, file)), avra().keywords).remarks,
        known_rule_ids(),
    )
}

collect listed_canonical_facts: List<ListedQuery> = @query_definition in self as ListedQuery { definition: it } by it.name

/// The queries a file's canonical form reads through, for a process to hand its engine.
export fn canonical_fact_definitions() -> List<QueryDefinition> { definitions_of(listed_canonical_facts) }

fn write_refused(bad: string, canon: string) -> string { "avra fmt: refusing to write — ${bad} (canon: ${canon})" }
