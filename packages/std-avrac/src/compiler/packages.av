//! The manifest closure: the root package, its path dependencies, and
//! the module path each names. Moved out of the workspace god-object.
use core.{ModulePath, key_spelled, flatten, sorted_by, package_of_module}
use @std.path.{under_dir, joined_path, normalized, relative_path}
use features.{nothing, Budgets, budgets_of}
use diagnostics.{SourceFile, new_source_file, Diag, refusal}
use compiler.families.{Family}
use compiler.store.{StoredName, Stored, Reading, node_key}
use compiler.record.{KeyParts}
use compiler.db.{current_read_digest}
use @std.errors.{Loc, Suggestion, Edit, Confidence}
use @std.relation.engine.{Loaded}
use compiler.host.{
    Dependency,
    Manifest,
    bad_dependency_path,
    dependency_cycle,
    deps_offset,
    duplicate_package,
    name_mismatch,
    prelude_depends,
    read_manifest,
    row_at,
    unset_link_variable,
}

// ── The packages ──

fn empty_manifest() -> Manifest {
    Manifest {
        budgets: budgets_of(),
        name: "",
        version: "",
        bin: null,
        lib: null,
        deps: [],
        deps_at: null,
        excludes: [],
        objects: [],
        wasm_objects: [],
        search: [],
        libs: [],
        raw: [],
        tools: [],
        voices: [],
    }
}

/// A manifest row whose words are filled from the environment.
type LinkRow = { section: string, key: string, words: List<string> }

/// The rows a link fills from the environment — `[link.raw]` only for the
/// program's own manifest, the one it is heard from.
fn link_rows(m: Manifest, own: bool) -> List<LinkRow> {
    [
        LinkRow { section: "link", key: "objects", words: m.objects },
        LinkRow { section: "link", key: "wasm_objects", words: m.wasm_objects },
        LinkRow { section: "link", key: "search", words: m.search },
        LinkRow { section: "link", key: "libs", words: m.libs },
    ]
        .concat(if own { [LinkRow { section: "link.raw", key: "flags", words: m.raw }] } else { [] })
}

impl Workspace {
    /// A package's manifest, read from its `avra.toml` — an INPUT: the
    /// revision moves only when the text did. A root without a manifest
    /// reads as an empty one, quietly.
    fn manifest(i: int) -> Manifest {
        let pkg = self.packages()[i]
        let path = joined_path(pkg.root, "avra.toml")
        if !self.has_manifest(pkg) {
            return manifest_of(
                self
                    .relation(Family.Manifest)
                    .input(i, () -> DbRow.Manifest(empty_manifest()), (s: DbRow) -> 0),
            )
        }
        manifest_of(
            self.relation(Family.Manifest).input_loaded(i, () -> self.loaded_manifest(path)),
        )
    }

    /// A manifest's row over its Text input, cut by the word that cell
    /// is. Loaded once a package, so its text's cell is marked once: a
    /// manifest's text is the one text the package graph is shaped by.
    fn loaded_manifest(path: string) -> Loaded<DbRow> {
        self.manifest_texts.push(self.text_key(path))
        Loaded {
            value: DbRow.Manifest(read_manifest(new_source_file(path, self.listed_text(path)))),
            fingerprint: self.text_word(path),
        }
    }

    /// What a settlement may spend: the ROOT package's `[lifted]` rows,
    /// the measured defaults where it writes none.
    fn budgets() -> Budgets {
        self.manifest(0).budgets
    }

    fn has_manifest(pkg: Package) -> bool {
        self.there(joined_path(pkg.root, "avra.toml"))
    }

    fn manifest_source(pkg: Package) -> SourceFile {
        let path = joined_path(pkg.root, "avra.toml")
        new_source_file(path, self.listed_text(path))
    }

    /// The root package, then every path dependency reachable from its
    /// manifest: each admitted once by key, each judged — the directory
    /// holds a manifest, the manifest calls itself the keyed name, one
    /// key is one directory, and no cycle closes.
    fn load_packages(src: string) {
        let unnamed = Package {
            key: "",
            root: self.root,
            src: src,
            ordinal: 0,
            at: null,
            origin: Origin.Root,
        }
        self.package_rows.push(unnamed)
        let m = self.manifest(0)
        self.decls.name_root(m.name)
        let named = unnamed with { key: m.name }
        self.package_rows.set_at(0, named)
        self.admit_dependencies(0, m, true, [m.name])
    }

    /// A package's dependencies admitted — tests' dependencies only for
    /// the root, since they never travel.
    fn admit_dependencies(i: int, m: Manifest, root: bool, chain: List<string>) {
        for d in m.deps {
            if !d.dev || root {
                self
                    .admitted(
                        d.key,
                        normalized(joined_path(self.packages()[i].root, d.path!)),
                        d.at,
                        dep_chain(d, chain),
                    )
            }
        }
    }

    fn admitted(key: string, dir: string, at: Loc?, chain: List<string>) {
        if chain.contains(key) { return self.speak_package(dependency_cycle(at, chain.concat([key]))) }
        let known: Package? = self.packages().find(it.key == key)
        if known != null {
            if self.host.absolute(known!.root) != self.host.absolute(dir) { self.speak_package(duplicate_package(at, key, known!.root, dir)) }
            return
        }
        if !self.there(joined_path(dir, "avra.toml")) { return self.speak_package(bad_dependency_path(at, key, dir)) }
        self.entered(key, dir, at, Origin.Declared, chain)
    }

    /// A std package the toolchain carries, admitted the first time a
    /// `use` names it: no manifest row, the std root's directory, its
    /// own dependencies admitted as any package's. A key the toolchain
    /// carries is EVERY package's to reach, whichever copy is held — a
    /// declared row pins or overrides the toolchain's, for the whole
    /// graph. A key the toolchain does not carry is nobody's here.
    fn std_admitted(key: string) -> bool {
        let dir? = self.host.std_dir(key) else { return false }
        if !self.there(joined_path(dir, "avra.toml")) { return false }
        if self.packages().any(it.key == key) { return true }
        self.entered(key, dir, null, Origin.Toolchain, [])
        true
    }

    /// One package entered under a key: listed, its manifest read and
    /// held to the key, its dependencies admitted. THE FLOOR: the
    /// prelude declares no dependency, so the layering has a bottom.
    fn entered(key: string, dir: string, at: Loc?, origin: Origin, chain: List<string>) {
        let i = self.packages().length
        let pkg = Package {
            key: key,
            root: dir,
            src: joined_path(dir, "src"),
            ordinal: i,
            at: at,
            origin: origin,
        }
        self.package_rows.push(pkg)
        let m = self.manifest(i)
        if m.name != key { self.speak_package(name_mismatch(at, key, m.name, dir)) }
        if key == prelude_key && !m.deps.is_empty() { return self.speak_package(prelude_depends(m.deps[0].at)) }
        self.admit_dependencies(i, m, false, chain.concat([key]))
    }

    fn speak_package(d: Diag) {
        self.package_voices.push(d)
    }

    /// The admitted packages, root first.
    fn packages() -> List<Package> { self.package_rows.get() }

    /// THE NAME THE STORE FILES A PATH UNDER — `package:relative/path`, the package that holds it
    /// named by its manifest, the root's included — so a moved or recloned checkout reads its own
    /// rows and a dependency's file is one name in every program. A path no package holds keeps
    /// its own spelling.
    fn stored_name(path: string) -> StoredName {
        let known = self.keys.stored_names.get().get(path)
        if known != null { return StoredName(known!) }
        let held? = self.package_holding(path) else { return StoredName(path) }
        let named = "${held.key}:${if path == held.root { "" } else { path.substring(held.root.length + 1, path.length) }}"
        self.keys.stored_names.put(path, named)
        StoredName(named)
    }

    /// THE KEY OF A ROW ABOUT ONE FILE: its kind, the file's stored name and the view it is read
    /// in, then the parts — the one derivation every per-file row shares, so no row folds where
    /// the checkout stands, and a dependency's file is one row in every program that reaches it.
    fn file_key(family: Stored, kind: string, path: string, parts: List<string> = []) -> string {
        node_key(family, [kind, "${self.stored_name(path)}", self.file_view(path)].concat(parts))
    }

    /// The view a file is read in: its package built as the root, or reached as a dependency —
    /// the two answer differently (a root reads its tests, a lone file is its own module).
    fn file_view(path: string) -> string {
        let known = self.keys.file_views.get().get(path)
        if known != null { return known! }
        let root? = self.packages().first()?.root else { return "dep" }
        let view = if self.package_holding(path)?.root == root { self.root_view() } else { "dep" }
        self.keys.file_views.put(path, view)
        view
    }

    /// The view a module is read in: the root's own (spelled with no package) or a dependency's.
    fn module_view(module: string) -> string { if package_of_module(module).is_empty() { self.root_view() } else { "dep" } }

    /// THE ROOT AS A KEY READS IT: its manifest name and where it stands in the tree, so two
    /// packages of one name in one tree are two roots and a moved or recloned tree is the same.
    fn root_view() -> string {
        if self.keys.root_view.get().is_empty() {
            self
                .keys
                .root_view
                .set(
                    "root ${self.packages().first()?.key ?? ""} ${relative_path(tree_root(self), self.root)}",
                )
        }
        self.keys.root_view.get()
    }

    /// THE KEY OF A ROW ABOUT THE PROGRAM: its kind, the root's view, then the parts.
    fn root_key(family: Stored, kind: string, parts: List<string>) -> string {
        node_key(family, [kind, self.root_view()].concat(parts))
    }

    /// Key parts as the store files them: the file under its stored name.
    fn stored_parts(k: KeyParts) -> KeyParts { k with { path: "${self.stored_name(k.path)}" } }

    /// A saved answer's read of `path` as it stands now: its stored name and its digest.
    fn read_at(path: string, digest: string? = null) -> Reading {
        Reading {
            name: "${self.stored_name(path)}",
            digest: digest ?? current_read_digest(path) ?? "-",
        }
    }

    /// What a read's name stands at now, by the path the name resolves to here.
    fn read_now(name: string) -> string? { current_read_digest(self.path_named(StoredName(name))) }

    /// The path a stored name stands for here: its package's root joined with the rest.
    fn path_named(name: StoredName) -> string {
        let text = "${name}"
        let at = text.index_of(":")
        if at <= 0 { return text }
        let root? = self.root_of_package(text.substring(0, at)) else { return text }
        let rest = text.substring(at + 1, text.length)
        if rest.is_empty() { root } else { joined_path(root, rest) }
    }

    /// The package holding `path`: the innermost admitted one, else the toolchain's std package
    /// it stands in, which a check names before any `use` admits it.
    fn package_holding(path: string) -> Holding? {
        let admitted = sorted_by(
            [p for p in self.packages() if path == p.root || under_dir(path, p.root)],
            deeper_root,
        )
            .first()
        if admitted != null { return Holding { key: admitted!.key, root: admitted!.root } }
        let std? = self.host.std_root else { return null }
        if !under_dir(path, std) { return null }
        let root = joined_path(
            std,
            path.substring(std.length + 1, path.length).split("/").first() ?? "",
        )
        let key? = self.std_named(root) else { return null }
        Holding { key: key, root: root }
    }

    /// A toolchain package's manifest name, read once a workspace — none where no manifest stands.
    fn std_named(root: string) -> string? {
        let known = self.keys.std_names.get().get(root)
        if known != null { return known }
        let manifest = joined_path(root, "avra.toml")
        if !self.there(manifest) { return null }
        let named = read_manifest(new_source_file(manifest, self.listed_text(manifest))).name
        self.keys.std_names.put(root, named)
        named
    }

    /// Where a package of this key stands: an admitted one's root, else the toolchain's copy.
    fn root_of_package(key: string) -> string? { self.packages().find(it.key == key)?.root ?? self.host.std_dir(key) }

    /// Everything the packages said: each manifest's own voices, then
    /// the graph's.
    fn packages_voiced() -> List<Diag> {
        flatten([self.manifest(pkg.ordinal).voices for pkg in self.packages()])
            .concat([borrowed_raw(pkg) for pkg in self.packages() if self.raw_from_dependency(pkg)])
            .concat(flatten([self.unset_link_holes(pkg) for pkg in self.packages()]))
            .concat(self.package_voices.get())
    }

    /// Every hole inside a longer `[link]` word whose variable is unset,
    /// refused by name.
    fn unset_link_holes(pkg: Package) -> List<Diag> {
        flatten(
            [self.unset_in(pkg, row, w) for row in link_rows(self.manifest(pkg.ordinal), pkg.ordinal == 0) for w in row.words],
        )
    }

    /// One word's unset holes; none for a word that is only its hole.
    fn unset_in(pkg: Package, row: LinkRow, word: string) -> List<Diag> {
        if whole_hole(word) { return [] }
        [unset_link_variable(
            row_at(self.manifest_source(pkg), row.section, row.key),
            row.key,
            word,
            name,
        ) for name in holes(word) if self.env(name) == null]
    }

    /// A dependency asking for raw linker options: `[link.raw]` is the
    /// PROGRAM's hatch, so only ordinal 0 is heard.
    fn raw_from_dependency(pkg: Package) -> bool {
        pkg.ordinal != 0 && !self.manifest(pkg.ordinal).raw.is_empty()
    }

    /// The package a file belongs to — the one whose source root holds
    /// it, the deepest when nested; the root package otherwise.
    fn holder_of_path(path: string) -> int {
        // the DEEPEST package whose source root holds the path — a
        // nested package wins over the one around it; a path no package
        // holds is the root's (a lone file)
        mut best: int? = null
        for pkg in self.packages() {
            if under_dir(path, pkg.src) &&
                (best == null || pkg.src.length > self.packages()[best!].src.length) {
                best = pkg.ordinal
            }
        }
        best ?? 0
    }

    /// The package a module path names: the root package for a local
    /// path, a dependency by key, absence when no package has the key.
    /// A KEY NOT YET ADMITTED IS ADMITTED HERE, through the one door
    /// (`reaches`) every `use` already takes — a package joins lazily,
    /// on the first ask, so asking twice must not answer twice: once
    /// found, once absent. Admitting through the root is the same
    /// reach a root's own `use` line gets, and every other package's
    /// dependencies are already admitted transitively at ITS OWN entry
    /// (`admit_dependencies`), so nothing reachable is missed by asking
    /// from there. A key `reaches` genuinely refuses (no manifest row,
    /// no toolchain directory) is absence, still — the door speaks for
    /// itself on the one path that can misfire silently, a dependency
    /// cycle (`speak_package`, `admitted`).
    fn holder(m: ModulePath) -> Package? {
        let k? = m.package() else { return self.packages()[0] }
        let found: Package? = self.packages().find(it.key == k)
        if found != null { return found }
        if !self.reaches(self.packages()[0], k) { return null }
        self.packages().find(it.key == k)
    }

    /// A package reaches itself — its own files `use` it by name —
    /// every package its manifest declares, and every std package the
    /// toolchain carries, admitted on the first ask. The std packages
    /// are the toolchain's: no manifest row names them, and a row that
    /// does is a pin.
    fn reaches(from: Package, k: string) -> bool {
        k == from.key || self.depends_on(from, k) || self.std_admitted(k)
    }

    /// Whether a package's manifest declares the key.
    fn depends_on(from: Package, k: string) -> bool {
        self.manifest(from.ordinal).deps.any(it.key == k)
    }

    /// The dependency line a manifest lacks, as a structured fix when
    /// the package is already in the workspace (reached through
    /// another package's manifest): the path relative to the asking
    /// package's root after its last dependency.
    fn dependency_fix(from: Package, k: string) -> List<Suggestion> {
        let known? = self.packages().find(it.key == k) else { return [] }
        let m = self.manifest(from.ordinal)
        let line = "\"${k}\" = { path = \"${relative_path(from.root, known.root)}\" }"
        let manifest_path = joined_path(from.root, "avra.toml")
        let text = if m.deps_at == null { "\n[dependencies]\n${line}\n" } else { "\n${line}" }
        let at = deps_offset(m) ?? self.listed_text(manifest_path).length
        [
            Suggestion {
                confidence: Confidence.High,
                description: "add `${line}` under `[dependencies]` in `${manifest_path}`",
                edits: [Edit { loc: Loc { file: manifest_path, lo: at, hi: at }, replacement: text }],
            },
        ]
    }

    fn not_a_dependency(at: Loc?, from: Package, k: string) -> Diag {
        let fixes = self.dependency_fix(from, k)
        let at_file = joined_path(from.root, "avra.toml")
        refusal(
            "resolve.not_a_dependency",
            at,
            "`${k}` is not a dependency of this package",
            "in this use",
            "declare it under `[dependencies]` in `${at_file}` — `\"${k}\" = { path = \"…\" }`",
        ) with { suggestions: fixes }
    }
}

/// The one package every file sees without a `use`.
const prelude_key = "@std/prelude"

/// The prelude's module — every file's import, written by none.
fn prelude_module() -> ModulePath { ModulePath { segments: key_spelled(prelude_key).split(".") } }

/// The chain a dependency's admission extends. A DEV EDGE STARTS ITS
/// OWN: the tests are the consumer and nothing depends on them, so a
/// package's test reaching a library that depends BACK on it closes no
/// cycle — `@std/text`'s program prints through `@std/io`, which reads
/// `@std/text`. A library edge carries the chain it came by.
fn dep_chain(d: Dependency, chain: List<string>) -> List<string> {
    if d.dev { return [] }
    chain
}

/// A module path as the whole workspace names it: a dependency's
/// own local path carries its package's head, so `use core.{…}`
/// inside `@std/avrac` names `@std.avrac.core` from anywhere.
fn qualified(m: ModulePath, from: Package) -> ModulePath {
    if m.packaged() || from.ordinal == 0 { return m }
    ModulePath { segments: key_spelled(from.key).split(".").concat(m.segments) }
}

/// A package as a stored name spells it: its manifest key and the root its paths stand under.
type Holding = { key: string, root: string }

/// Whether `a`'s root is deeper than `b`'s: the innermost package holds a path first.
fn deeper_root(a: Package, b: Package) -> bool { a.root.length > b.root.length }
