fn avra_pair1444(
    mut u: Untold<Token, LangNode>,
    tier: int,
    suffix: int,
    left: Captured<Token, LangNode>,
    op: Captured<Token, LangNode>,
    right: Captured<Token, LangNode>,
    loc: Loc?,
) -> bool {
    if tier == 0 {
        if !u.make(131, [op, left, right], loc) {
            return false
        }
        return true
    }
    if tier == 1 {
        if !u.make(131, [op, left, right], loc) {
            return false
        }
        return true
    }
    if tier == 2 {
        if suffix == 0 {
            if !u.make(132, [left, right], loc) {
                return false
            }
            return true
        }
        if !u.make(131, [op, left, right], loc) {
            return false
        }
        return true
    }
    if tier == 3 {
        if !u.make(133, [left, right], loc) {
            return false
        }
        return true
    }
    if tier == 4 {
        if !u.make(134, [left, right], loc) {
            return false
        }
        return true
    }
    if tier == 5 {
        if !u.make(131, [op, left, right], loc) {
            return false
        }
        return true
    }
    false
}

