                        return rt
                    }
                }
                u.said = tb
            }
            no_end
        },
        88 -> {
            if 1 >= min && 1 != spent && 1 <= ceil {
                let tb = u.said
                if true {
                    mut rt = no_end
                    rt = avra_r74(u, cursor + 1, capped)
                    if rt >= 0 {
                        let tight = avra_climb1461(u, u.out, cursor + 1, rt, 2, capped, tb)
                        u.t_tier = 1
                        u.t_suffix = no_end
                        u.t_suffixed = false
                        u.t_op_at = cursor
                        u.t_words = 1
                        return tight
                    }
                }
                u.said = tb
            }
            no_end
        },
        89 -> {
            if 0 >= min && 0 != spent && 0 <= ceil {
                let tb = u.said
                if true {
                    mut rt = no_end
                    rt = avra_r74(u, cursor + 1, capped)
                    if rt >= 0 {
                        let tight = avra_climb1461(u, u.out, cursor + 1, rt, 1, capped, tb)
                        u.t_tier = 0
                        u.t_suffix = no_end
                        u.t_suffixed = false
                        u.t_op_at = cursor
                        u.t_words = 1
                        return tight
                    }
                }
                u.said = tb
            }
            no_end
        },
        _ -> no_end,
    }
}

fn avra_pair1461(
    mut u: Untold<Token, LangNode>,
    tier: int,
    suffix: int,
    left: Captured<Token, LangNode>,
    op: Captured<Token, LangNode>,
    right: Captured<Token, LangNode>,
    loc: Loc?,
) -> bool {
    if tier == 0 {
        if !u.make(134, [op, left, right], loc) {
            return false
        }
        return true
    }
    if tier == 1 {
        if !u.make(134, [op, left, right], loc) {
            return false
        }
        return true
    }
    if tier == 2 {
        if suffix == 0 {
            if !u.make(135, [left, right], loc) {
                return false
            }
            return true
        }
        if !u.make(134, [op, left, right], loc) {
            return false
        }
        return true
    }
    if tier == 3 {
        if !u.make(136, [left, right], loc) {
            return false
        }
        return true
    }
    if tier == 4 {
        if !u.make(137, [left, right], loc) {
            return false
        }
        return true
    }
    if tier == 5 {
        if !u.make(134, [op, left, right], loc) {
            return false
        }
        return true
    }
    false
}

fn avra_climb1465(
    mut u: Untold<Token, LangNode>,
    left0: Captured<Token, LangNode>,
    start: int,
    from: int,
    min: int,
    capped: bool,
    said0: int,
) -> int {
    mut left = left0
    mut cursor = from
    mut spent = no_end
    mut ceil = 1
    while true {
        let t = avra_take1465(u, cursor, min, spent, ceil, capped)
        if t < 0 {
            break
        }
        let tier = u.t_tier
        let suffixed = u.t_suffixed
        let right = u.out
        let loc = u.span(start, t)
        let op = if u.t_words == 1 { u.term(u.t_op_at) } else { u.stated(u.joined(u.t_op_at, u.t_words), loc) }
        if !avra_pair1465(u, tier, left, op, right, loc) {
            if u.refused(said0) {
                return t
            }
            return no_end
        }
        left = u.out
        cursor = t
        spent = no_end
        if suffixed {
            ceil = tier
        }
    }
    u.out = left
    cursor
}

fn avra_take1465(
    mut u: Untold<Token, LangNode>,
    cursor: int,
    min: int,
    spent: int,
    ceil: int,
    capped: bool,
) -> int {
    match u.lit[cursor] {
        90 or 91 or 92 -> {
            if 1 >= min && 1 != spent && 1 <= ceil {
                let tb = u.said
                if true {
                    mut rt = no_end
                    rt = avra_r75(u, cursor + 1, capped)
                    if rt >= 0 {
                        let tight = avra_climb1465(u, u.out, cursor + 1, rt, 2, capped, tb)
                        u.t_tier = 1
                        u.t_suffix = no_end
                        u.t_suffixed = false
                        u.t_op_at = cursor
                        u.t_words = 1
                        return tight
                    }
                }
                u.said = tb
            }
            no_end
        },
        93 or 75 -> {
            if 0 >= min && 0 != spent && 0 <= ceil {
                let tb = u.said
                if true {
                    mut rt = no_end
                    rt = avra_r75(u, cursor + 1, capped)
                    if rt >= 0 {
                        let tight = avra_climb1465(u, u.out, cursor + 1, rt, 1, capped, tb)
                        u.t_tier = 0
                        u.t_suffix = no_end
                        u.t_suffixed = false
                        u.t_op_at = cursor
                        u.t_words = 1
                        return tight
                    }
                }
                u.said = tb
            }
            no_end
        },
        _ -> no_end,
    }
}

fn avra_pair1465(
    mut u: Untold<Token, LangNode>,
    tier: int,
    left: Captured<Token, LangNode>,
    op: Captured<Token, LangNode>,
    right: Captured<Token, LangNode>,
    loc: Loc?,
) -> bool {
    if tier == 0 {
        if !u.make(134, [op, left, right], loc) {
            return false
        }
        return true
    }
    if tier == 1 {
        if !u.make(134, [op, left, right], loc) {
            return false
        }
        return true
    }
    false
}
