//! The interface's Workspace/Decls verbs: mint, fill, key, and the
//! wire each record line carries. The record FORMAT lives in record.av.
use core.{
    wire_fields,
    joined,
    flatten,
    distinct,
    sorted_texts,
    module_path,
    digest_of,
    same_decl,
    ModulePath,
    Type,
    TypeId,
    DeclId,
    FileId,
    StmtId,
    ExprId,
    SeatMark,
}
use features.{
    Decl,
    LANGUAGE_HOME,
    DeclAt,
    FnSig,
    StructSig,
    EnumSig,
    NamedSig,
    Decls,
    SettleRoot,
    Settled,
    kind_word,
    WireIndex,
}
use compiler.lower.{Body, collect_answer_type}
use compiler.store.{Store, Stored, node_key}

/// One file's lines in its module's record, and the digest of what a caller can see of them.
type FileLines = { path: string, lines: List<string>, iface: string }

impl Workspace {

    /// EVERY MODULE'S CONSTS, KEPT: a settled value under its key, or — for a
    /// const whose settlement is STRUCTURALLY refused (`Unsettled.structural`,
    /// `Reach`) — the refusal itself, since that verdict is as stable as a
    /// value and is what lets the file hold. A non-structural refusal SPEAKS a
    /// diagnostic elsewhere and stays unkept, so the next build asks again.
    /// A gathered member — a `rule`'s `run: fn(Code) -> Fix?`, any declared
    /// instance holding behavior — refuses structurally too and is kept the
    /// same way: `lower_collect` and a direct read (`instance_value_reg`)
    /// both call such a member by its `instance_unit` symbol, and
    /// `held_stubs`/`Workspace.stub_of` already declare that symbol for a
    /// held file exactly as a held fn's own symbol is declared — the same
    /// door an ordinary call into a held function goes through, never a
    /// second one for collects.
    fn keep_const_units(store: Store, modules: List<ModulePath>) -> int {
        mut count = 0
        for m in modules {
            for d in self.interface_decls(m) {
                if d.kind is .Const && !self.is_held(d.file) {
                    let path = self.decls.file(d.file).path
                    let key = self.const_unit_key(store, m, path, d.name)
                    if !store.has(Stored.Unit, key) {
                        match self.settled(d.file, SettleRoot.Const(d.stmt), []) {
                            .Ok(value) -> {
                                let _ = store
                                    .keep(
                                        Stored.Unit,
                                        key,
                                        kept_wire(value),
                                        [obj_key_of(self, store, m, path)],
                                    )
                                count = count + 1
                            },
                            .Err(_) -> {
                                // `settled` collapses a reused refusal to `.Spoken` so a
                                // diagnostic never repeats — ask the relation directly for
                                // the const's one real verdict, `Spoken` or not.
                                let verdict = self
                                    .settle_verdict(d.file, SettleRoot.Const(d.stmt), [])
                                if verdict != null {
                                    match verdict! {
                                        .Refused(why) -> {
                                            if why.structural() {
                                                let _ = store
                                                    .keep(
                                                        Stored.Unit,
                                                        key,
                                                        reach_wire(why.words()),
                                                        [obj_key_of(self, store, m, path)],
                                                    )
                                                count = count + 1
                                            }
                                        },
                                        .Held(_) -> { let _ = 0 },
                                    }
                                }
                            },
                        }
                    }
                }
            }
        }
        count
    }

    fn const_rows_ready(store: Store, m: ModulePath, path: string, rows: List<List<string>>) -> bool {
        for parts in rows {
            if parts.length > 5 && parts[0] == "const" {
                if !store.has(Stored.Unit, self.const_unit_key(store, m, path, parts[5])) { return false }
            }
        }
        true
    }

    fn const_unit_key(store: Store, m: ModulePath, path: string, name: string) -> string {
        node_key(Stored.Unit, ["const", obj_key_cached(self, store, m, path), name])
    }

    // A SHAPE NAMES OTHER TYPES, and `by_name` can only answer for types that EXIST — a
    // spelling it does not know is a DEFECT in the record, not a name to guess at. The
    // fallback is `error`, the ABSORBING type, so a broken record produces a type that
    // refuses rather than one that is silently wrong.
    fn fill_shape(store: Store, m: ModulePath, id: DeclId, row: Row) {
        let d = self.decls.decl(id)
        match row.shape {
            .Const -> self.fill_const(store, m, row, d.file, d.stmt, id),
            .Collect or .State -> self.decls.record_const_type(d.file, d.stmt, self.interface_type(row.of_wire())),
            .Aims -> self.fill_aims(row, id),
            .Named -> self.fill_named(row, id),
            .Alias -> self.decls.declare(id, .Alias(self.interface_type(row.of_wire()))),
            .Struct -> self.fill_record(row, id, false),
            .Boxed -> self.fill_record(row, id, true),
            .Enum -> self.fill_enum(row, id),
            .Fn or .Extern -> self.fill_fn(row, id),
            .Opaque -> self.fill_opaque(row, id),
        }
    }

    fn fill_const(store: Store, m: ModulePath, row: Row, f: FileId, stmt: StmtId, id: DeclId) {
        let ty = self.interface_type(row.of_wire())
        self.decls.record_const_type(f, stmt, ty)
        // a held const has no initializer to settle again: its kept row is the
        // only one, and one that decodes as neither a value nor a structural
        // refusal is a defect said
        let raw = store.get(Stored.Unit, self.const_unit_key(store, m, row.path, row.name)) ?? ""
        let value? = settled_from_wire(raw) else {
            let words? = reach_from_wire(raw) else {
                return self
                    .defect("a held const's value did not decode — `${row.name}` in ${row.path}")
            }
            return self.decls.remember_held_reach(id, words)
        }
        self.decls.remember_held_value(id, value)
    }

    fn fill_aims(row: Row, id: DeclId) {
        let aimed = self.decl_from_ref(row.field(0))
        if aimed != null { self.decls.record_target(id, aimed!) }
    }

    fn fill_named(row: Row, id: DeclId) {
        let of = self.interface_type(row.of_wire())
        self.decls.declare(id, .Named(NamedSig { of: of }))
        let named = self.decls.types.intern(Type.Struct(id, row.name))
        self.decls.types.mark_named(named, of)
        self.decls.types.mark_flat(named, [of])
    }

    fn fill_record(row: Row, id: DeclId, boxed: bool) {
        // a seal is sticky, so the layout the record kept lands before the declaration
        if boxed { self.decls.types.unflatten(self.decls.record_type(id)) }
        let fields = row.items()
        let states = row.field(2)
        self
            .decls
            .declare(
                id,
                .Record(
                    StructSig {
                        names: [field_name(f) for f in fields],
                        types: [self.interface_type(name_of_field(f)) for f in fields],
                        defaults: [self.field_default(id, field_name(f), row.list_at(1), j) for j, f in fields],
                        lacking: self.decls.lacking(id),
                        states: [j < states.length && states.char_code(j) == 49 for j, f in fields],
                    },
                ),
            )
        let made = self.decls.record_type(id)
        // peek, not is_flat: this is a belief to watch for drift, not a
        // read to answer for — layouts_moved (compiler/derive.av) asks
        // again once typing finishes, and a seal from a file that never
        // declares this record must still be free to land before then
        if self.decls.types.peek_flat(made) { self.hold.held_flat.push(made) }
    }

    /// A held field's default: the record's own, else the one its row
    /// names — a spread field's default belongs to the record it came
    /// from. A trailing empty ref is absent from the split, so an index
    /// past the end is "no default".
    fn field_default(id: DeclId, field: string, refs: List<string>, j: int) -> DeclId? {
        self.decls.default_named(id, field) ?? self
            .decl_from_ref(if j < refs.length { refs[j] } else { "" })
    }

    fn fill_enum(row: Row, id: DeclId) {
        let arms = row.items()
        self
            .decls
            .declare(
                id,
                .Enum(
                    EnumSig {
                        names: [field_name(a) for a in arms],
                        payloads: [payload_of(self, a) for a in arms],
                    },
                ),
            )
    }

    fn fill_fn(row: Row, id: DeclId) {
        let seats = row.items()
        self.decls.record_seats(id, row.marks())
        self
            .decls
            .declare(
                id,
                .Fn(
                    FnSig {
                        params: [self.interface_type(s) for s in seats],
                        ret: self.interface_type(row.ret_wire()),
                    },
                ),
            )
        let bits = row.writes()
        for j in 0..bits.length { if bits.char_code(j) == 49 { self.decls.record_seat_written(id, j) } }
        self.decls.record_bound_args(id, self.bounds_read(id, row.bounds()))
    }

    /// Each bounded seat's trait arguments as `seat=wire|wire`, `;`-joined —
    /// a seat whose bound takes none is not written, so an empty column is
    /// no arguments anywhere.
    fn bounds_wire(d: DeclId) -> string {
        let n = self.decls.tparams(d).length
        joined(
            [bound_entry(j, [self.decls.type_wire(t) for t in self.decls.bound_args(d, j)]) for j in 0..n if !self.decls.bound_args(d, j).is_empty()],
            ";",
        )
    }

    /// The column `bounds_wire` wrote, back as one argument list per seat.
    fn bounds_read(d: DeclId, entries: List<string>) -> List<List<TypeId>> {
        [self.bound_at(entries, j) for j in 0..self.decls.tparams(d).length]
    }

    fn bound_at(entries: List<string>, j: int) -> List<TypeId> {
        let hit? = entries.find(it.starts_with("${j}=")) else { return [] }
        [self.interface_type(w) for w in hit.substring("${j}=".length, hit.length).split("|")]
    }

    /// A `trait`/`syntax`/`default`/`main`/`case`/`builtin` declaration has no
    /// signature to fill — `sig(d.id)` answered null when its line was written.
    fn fill_opaque(_row: Row, _id: DeclId) {}

    fn interface_decls(m: ModulePath) -> List<Decl> {
        mut ids: List<DeclId> = []
        for path in self.met_files(m) {
            let f = self.file_id(path)
            let _ = self.items(f)
            ids = ids.concat(self.decls.decls_of_file(f))
        }
        [self.decl_at(id) for id in ids]
    }

    /// A type as a record wrote it: a wire, or the error type — a record writes nothing else.
    fn interface_type(name: string) -> TypeId {
        let words = wire_fields(name.substring(1, name.length), "~")
        let decoded? = (if name.starts_with("^") { self.decls.read_type_wire(words, 0) } else { null }) else { return self.decls.types.intern(Type.Error) }
        if decoded.next == words.length { decoded.id } else { self.decls.types.intern(Type.Error) }
    }

    /// A held file's declarations adopted by their parents, in one pass over its
    /// lines: the file and its declarations are found ONCE, never per line.
    fn link_file(path: string, rows: List<List<string>>) {
        let ids = self.decls.decls_so_far(self.file_id(path))
        for parts in rows { self.link_row(ids, parts) }
    }

    fn link_row(ids: List<DeclId>, parts: List<string>) {
        let row? = read_row(parts) else { return }
        if row.ordinal < 0 || row.ordinal >= ids.length { return }
        if row.parent_at >= 0 && row.parent_at < ids.length { self.decls.adopt(ids[row.ordinal], ids[row.parent_at]) }
    }

    fn fill_row(store: Store, m: ModulePath, ids: List<DeclId>, parts: List<string>) {
        let row? = read_row(parts) else { return }
        if row.ordinal >= 0 && row.ordinal < ids.length { self.fill_shape(store, m, ids[row.ordinal], row) }
    }

    /// A HELD DECLARATION'S OWN ROW, FILLED ON THE ASK THAT NAMES IT,
    /// never eagerly with the rest of its module: a row that fills
    /// EARLIER in record order can itself name a declaration whose row
    /// sits LATER, and a settle read through that name must see the
    /// later row's own fill, not the blank default sitting there until
    /// the module's sweep reaches it. Guarded per declaration, so a
    /// name reached while filling ITS OWN row (a cycle) sees "not
    /// filled yet" rather than recursing.
    fn fill_ensured(d: DeclId) {
        if self.hold.row_filled.at(d.index) != null { return }
        self.hold.row_filled.keep(d.index, true)
        let x = self.decls.decl(d)
        let store? = self.store.get() else { return }
        let path = self.decls.file(x.file).path
        let m = self.module_path_of(path)
        let ids = self.decls.decls_so_far(x.file)
        let ordinal? = [i for i, id in ids if same_decl(id, d)].first() else { return }
        let rows = file_rows(record_fields(self, store, m), record_places(self, store, m).get(path))
        if ordinal < rows.length { self.fill_row(store, m, ids, rows[ordinal]) }
    }

    /// ONE HELD MODULE, MINTED: every held file's declarations from its record lines,
    /// each adopted by its parent — names before shapes, since a shape names a type
    /// of its own module. A shape naming ANOTHER module's type mints that module on
    /// the way (`Decls.decls_of_file` asks), and the flag stands before the work
    /// does, so two modules that name each other meet once. SHAPES ARE NOT FILLED
    /// HERE: `fill_ensured` fills each row lazily, on the ask that names it.
    fn mint_module(store: Store, m: ModulePath) {
        if self.hold.minted.get().get(m.text()) != null { return }
        self.hold.minted.put(m.text(), true)
        let fields = record_fields(self, store, m)
        let places = record_places(self, store, m)
        let held = [path for path in self.module_files(m) if self.decls.held.get().get(path) != null]
        for path in held { self.mint_file(path, file_rows(fields, places.get(path)), makers_in(fields, path)) }
        for path in held { self.hold.reexports.put(path, reexports_in(fields, path)) }
        for path in held { self.link_file(path, file_rows(fields, places.get(path))) }
    }

    /// ONE HELD FILE'S DECLARATIONS, minted from its record lines in record order. The
    /// file's statement table is written ONCE: read out and stored back per line, it
    /// is held twice while it is written, and every line copies it.
    fn mint_file(path: string, rows: List<List<string>>, makers: Map<string, string>) {
        let f = self.file_id(path)
        self.decls.held_opened(f, makers.values())
        mut by_stmt = self.decls.decl_ids.get()[f.index].get()
        for parts in rows {
            let id: DeclId? = self.minted(f, path, parts, makers)
            let stmt_index = read_row(parts)?.stmt ?? 0
            by_stmt.grow_to(stmt_index + 1)
            if id != null && by_stmt.get(stmt_index).decl == null { by_stmt.set(stmt_index, DeclAt { decl: id }) }
        }
        self.decls.held_closed(f, makers.values())
        self.decls.keep_stmt_decls(f, by_stmt)
    }

    /// One record line as a declaration — null for a line that names nothing. A line
    /// that does not decode is a DEFECT spoken: the hold's attempt fails, and the
    /// sources answer.
    fn minted(f: FileId, path: string, parts: List<string>, makers: Map<string, string>) -> DeclId? {
        let row? = read_row(parts) else { return null }
        let kind = declared_kind(row.shape, row.kind)
        let facts = facts_unblocked(row.facts)
        if kind == null || facts == null {
            self.defect("a record line did not decode — ${path}")
            return null
        }
        let root: ExprId? = if row.root < 0 { null } else { ExprId { index: row.root } }
        let id = self
            .decls
            .mint_faced(
                f,
                StmtId { index: row.stmt },
                row.name,
                kind!,
                row.exported,
                row.owner,
                null,
                row.within,
                root,
                makers.get("${row.ordinal}") ?? "",
                facts!,
            )
        self.decls.held_joins(f, id, kind! is .Main, row.item)
        // the cancel bit is read before any signature is asked, so it lands with the row
        self.decls.record_cancel(id, row.waits())
        id
    }

    fn record_line(d: Decl, ordinal: int, item: bool) -> string {
        let shape = self.record_shape(d)
        let at = shape.index_of("\t")
        let visibility = if d.exported { "1" } else { "0" }
        // AN `extern fn` WEARS ITS OWN SHAPE WORD. The fact is a STORE read (`extern_parts`),
        // and a held file has no store, so the record must carry it: the word is the one
        // column every kind already has, and the payload's layout is unchanged.
        let first = when {
            self.decls.is_extern(d.id) -> "extern"
            at < 0 -> shape
            _ -> shape.substring(0, at)
        }
        let payload = if at < 0 { "" } else { shape.substring(at + 1, shape.length) }
        mut parent_at = 0 - 1
        if d.parent != null {
            for j, id in self.decls.decls_of_file(d.file) {
                if same_decl(id, d.parent!) { parent_at = j }
            }
        }
        let root = d.root?.index ?? 0 - 1
        let facts = self.decls.facts_or(d.id)
        let block = facts_block(facts)
        // THE CODEC IS HELD TO ITSELF WHERE IT WRITES: a fact the decoder does not give
        // back is a defect said now, never a check every reader pays
        if facts_unblocked(block)?.fingerprint() != facts.fingerprint() { self.defect("`${d.name}`'s facts do not survive their record") }
        "${first}\t${self.decls.file(d.file).path}\t${ordinal}\t${d.stmt.index}\t${visibility}\t${field_text(d.name)}\t${kind_word(d.kind)}\t${field_text(d.owner)}\t${parent_at}\t${field_text(d.within)}\t${root}\t${if item { "1" } else { "0" }}\t${block}\t${payload}"
    }

    /// The shape word and payload a declaration's record line carries.
    fn record_shape(d: Decl) -> string {
        match d.kind {
            // a reader bakes the VALUE in, so the value is the interface
            .Const -> "const\t${self.const_type_wire(d)};${self.const_print(d)}",
            // a reader calls the gathered list's own symbol, so its type is the interface
            .Collect -> "collect\t${self.const_type_wire(d)}",
            // a reader calls the shared cell's own symbol, so its type is the interface
            .State -> "state\t${self.const_type_wire(d)}",
            // an impl is filed under its target's NAME, and a held one has no namespace to
            // ask which declaration of that name it means
            .Impl -> "aims\t${self.decl_ref(self.decls.target_of(d.id))}",
            .Fn or .Method -> self.fn_shape(d),
            .Builtin or .Record or .Named or .Alias or .Enum or .Trait or .Syntax or .Default or .Main or .Case or .CollectEnum -> self.signed_shape(d),
        }
    }

    /// A const's or a collect's type as a wire — the error type for one that has none.
    fn const_type_wire(d: Decl) -> string {
        self
            .decls
            .type_wire(self.decls.type_of_const(d.file, d.stmt) ?? self.decls.types.intern(Type.Error))
    }

    /// A fn's or a method's shape: its signature, then its seats' contracts and written
    /// bits, its bounds, and whether a call to it may reach a cancel point.
    fn fn_shape(d: Decl) -> string {
        let sig? = self.sig(d.id) else { return "opaque" }
        // THE SEATS' CONTRACTS AND WHAT THE BODY WROTE are parse facts a held file
        // cannot answer, and a caller's `mut`/retain decision reads them. They ride
        // the fn's payload: one word per seat, then one bit per seat.
        // `seat_mark` alone is the DECLARED promises only — `consumed` (R3) is a
        // separate, whole-program inference merged in at lowering (`Body.marks`,
        // compiler/lower/lower.av) and never written back into `Decls`'
        // own table. A held reader has no lowering to merge it at, so the
        // record is the only place `consumed` can ever reach it: write it here.
        let n = self.decls.seat_count(d.id)
        let marks = joined(
            [mark_word(
                self.decls.seat_mark(d.id, j) with { consumed: self.decls.consumed_seat(d.id, j) },
            ) for j in 0..n],
            ";",
        )
        let writes = joined(
            [if self.decls.seat_written(d.id, j) { "1" } else { "0" } for j in 0..n],
            "",
        )
        // a record is kept once the build has lowered every body, never inside a resolve,
        // so the cancel bit is the settled pass's and not its conservative stand-in
        "${shape_line(self, sig, "")}\t${marks}\t${writes}\t${self.bounds_wire(d.id)}\t${if self.reaches_cancel(d.id) { "1" } else { "0" }}"
    }

    /// A type's shape from its signature — `opaque` for a declaration that has none.
    fn signed_shape(d: Decl) -> string {
        let sig? = self.sig(d.id) else { return "opaque" }
        shape_line(
            self,
            sig,
            if d.kind is .Record && self.decls.types.boxed_flat(self.decls.record_type(d.id)) { "boxed" } else { "struct" },
        )
    }

    /// Whether this attempt READ the file: met and not held. A file nothing
    /// met has no row, and its record lines carry forward as a held one's do.
    fn read_here(path: string) -> bool {
        let f? = self.decls.known_file_id(path) else { return false }
        !self.is_held(f)
    }

    fn record_of(store: Store, m: ModulePath) -> string {
        let prior_lines = record_cached(self, store, m).split("\n")
        let files = self.module_files(m)
        let kept = lines_by_file(prior_lines)
        let fresh = flatten([self.imported_by(path) for path in files if self.read_here(path)])
        let gathers = flatten([self.gathers_lines(path) for path in files if self.read_here(path)])
        let here = distinct(
            [line for line in prior_lines if line.starts_with("import\t") || kept_gathers(self, line)]
                .concat(["import\t${d.text()}" for d in fresh])
                .concat(gathers),
        )
        // EVERY FILE'S OWN OUTGOING REFERENCES, kept beside its
        // declarations — never inside `iface_digest`'s own fold, since a
        // dependent needs to know only that this attempt's `references()`
        // can still answer for this file once it is held, not WHAT it
        // referenced. A held file's `ref` lines ride forward from `kept`,
        // in the same place a fresh file's stand, so where they stand never
        // says which it was.
        let refs = flatten([self.file_ref_lines(path, kept) for path in files])
        let parts = [self.file_lines(store, m, path, kept) for path in files]
        // what a file's lines were read from, what its runs read and its own interface
        // stand on its `file` line; the module's interface is its files', in name order
        let read = ["file\t${f.path}\t${self.text_digest(f.path)}\t${runs_field(self.ran_by(store, f.path))}\t${f.iface}" for f in parts]
        let iface = ifaces_digest([f.iface for f in parts])
        joined(
            ["iface\t${iface}"]
                .concat(here)
                .concat(refs)
                .concat(read)
                .concat(flatten([f.lines for f in parts])),
            "\n",
        )
    }

    /// One file's part of its module's record. A HELD file's lines are copied
    /// verbatim — it is held against them — and its interface digest with them, so a
    /// body edit elsewhere in the module reads no held line.
    fn file_lines(store: Store, m: ModulePath, path: string, kept: Map<string, List<string>>) -> FileLines {
        if self.read_here(path) {
            let lines = self.lines_of(path)
            return FileLines { path: path, lines: lines, iface: iface_digest(lines) }
        }
        let lines = [line for line in kept.get(path) ?? [] if !line.starts_with("ref\t")]
        let at: Placed? = record_places(self, store, m).get(path)
        FileLines {
            path: path,
            lines: lines,
            iface: if at != null && at!.file.length > 4 { at!.file[4] } else { iface_digest(lines) },
        }
    }

    /// A file's `ref` lines: a held file's as its record kept them, a read one's fresh.
    fn file_ref_lines(path: string, kept: Map<string, List<string>>) -> List<string> {
        if !self.read_here(path) { return [line for line in kept.get(path) ?? [] if line.starts_with("ref\t")] }
        self.ref_lines(path, self.file_refs(self.file_id(path)))
    }

    /// A parsed file's record lines, one per declaration.
    fn lines_of(path: string) -> List<string> {
        let f = self.file_id(path)
        let top = self.items(f)
        let ids = self.decls.decls_of_file(f)
        [self.record_line(self.decl_at(id), ordinal, on_top(top, id)) for ordinal, id in ids]
            .concat(
                [maker_line(path, ordinal, self.decl_at(id).maker) for ordinal, id in ids if self.decl_at(id).maker != ""],
            )
            .concat([reexport_line(path, r) for r in self.file_reexports(path)])
    }

    /// A settled const's value as one number — 0 for one that did not settle.
    fn const_print(d: Decl) -> int {
        match self.settled(d.file, SettleRoot.Const(d.stmt), []) {
            .Ok(value) -> value.fingerprint,
            .Err(_) -> 0,
        }
    }

    /// EVERY FILE WHOSE TEXT A FILE'S COMPILE-TIME RUNS READ — its own runs', and the
    /// runs of every const those read. In name order.
    fn ran_by(store: Store, path: string) -> List<string> {
        // LICENSED compiler.seen_accumulator: a WORKLIST — the list grows while it is walked
        mut seen: List<string> = [path]
        mut at = 0
        while at < seen.length {
            for q in self.ran_directly(store, seen[at]) {
                if !seen.contains(q) { seen.push(q) }
            }
            at = at + 1
        }
        sorted_texts(seen.slice(1, seen.length))
    }

    /// What one file's runs read: as this build met them, or, for a held file, as
    /// its module's last record kept them.
    fn ran_directly(store: Store, path: string) -> List<string> {
        if self.read_here(path) { return self.hold.runs.get().get(path) ?? [] }
        kept_runs(record_places(self, store, self.module_path_of(path)).get(path))
    }

}

impl Workspace {

    /// What a held file's OBJECT answers to, as a caller's module must name it: a
    /// fn by its signature, a declared instance's unit by the type it builds, a
    /// collect's synthesized aggregate by its own answer type. A NESTED
    /// declaration joins no namespace, so no symbol names it.
    fn stub_of(d: Decl) -> Body? {
        if d.nested() { return null }
        if self.decls.is_instance(d.id) { return self.instance_stub(d) }
        if d.kind is .Collect { return self.collect_own_stub(d) }
        let s? = self.sig(d.id) else { return null }
        match s {
            .Fn(sig) -> Body {
                name: self.decls.symbol(d.id),
                params: sig.params,
                ret: sig.ret,
                gives: null,
                ins: [],
                reg_types: [],
                file: d.file,
            },
            rest -> null,
        }
    }

    /// A declared instance's unit, under the name a reader asks for it by and the
    /// type its const recorded: the held file's object holds the body, and a body
    /// that reads the instance calls it.
    fn instance_stub(d: Decl) -> Body? {
        let built? = self.decls.type_of_const(d.file, d.stmt) else { return null }
        Body {
            name: self.decls.instance_unit(d.id).name,
            params: [],
            ret: built,
            gives: null,
            ins: [],
            reg_types: [],
            file: d.file,
        }
    }

    /// A held collect's own symbol, under the same answer type `lower_collect`
    /// gives its body when fresh (`collect_answer_type`, compiler/lower/
    /// lower.av) — a read calls it the same way whether the file that
    /// declares it is held or not.
    fn collect_own_stub(d: Decl) -> Body {
        Body {
            name: self.decls.symbol(d.id),
            params: [],
            ret: collect_answer_type(self.decls, d.file, d.stmt),
            gives: null,
            ins: [],
            reg_types: [],
            file: d.file,
        }
    }
}

/// The sentinel wire for a declaration that cannot be named — a tilde in
/// its own text; `wire_decl` reads too few words from it to decode.
const NO_ORDINAL: int = 0 - 1

impl Decls {

    /// A declaration as a wire: its file, kind, owner and name — never a
    /// position. A moved declaration keeps this wire; a declaration reordered
    /// around it never steals it. `owner` is a method's impl target ("" for
    /// anything not one), which is what tells `impl Word { fn one() }`'s `one`
    /// apart from a free `fn one()` sharing its name. Two declarations sharing
    /// kind+owner+name in one file is the namespace law's to refuse (F3003) for
    /// every kind decl_wire actually names; the trailing index is a belt for a
    /// kind the law does not police (defaults, generated members) — a tilde in
    /// owner or name (case labels are sentences) has none of decl_wire's
    /// callers, and wears NO_ORDINAL rather than corrupt the tilde stream.
    fn decl_wire(d: DeclId) -> string {
        let x = self.decl(d)
        if x.owner.contains("~") || x.name.contains("~") { return "${self.file(x.file).path}~${NO_ORDINAL}" }
        let kind = kind_word(x.kind)
        // A BUILTIN SITS IN NO FILE OF THE PROGRAM'S: its wire names the language, so
        // one declaration has one spelling whichever file a process met first.
        if self.is_builtin(d) { return "${LANGUAGE_HOME}~${kind}~${field_text(x.owner)}~${field_text(x.name)}" }
        let siblings = self.wire_siblings(x.file, kind, x.owner, x.name)
        let base = "${self.file(x.file).path}~${kind}~${field_text(x.owner)}~${field_text(x.name)}"
        if siblings.length <= 1 { return base }
        let at = [j for j, id in siblings if same_decl(id, d)].first() ?? 0
        "${base}~${at}"
    }

    /// Every declaration of one file sharing a wire's identity — one, almost
    /// always; more only for a kind the namespace law leaves unpoliced.
    /// `f`'s declarations of one kind, owner and name, in file order: one
    /// lookup in the file's index, and one read of its rows for the asker.
    fn wire_siblings(f: FileId, kind: string, owner: string, name: string) -> List<DeclId> {
        let ids = self.decls_of_file(f)
        let kept = self.wire_index.get().get("${f.index}")
        let by = if kept != null && kept!.count == ids.length { kept!.by } else { self.wire_indexed(f, ids) }
        self.rows_read(f)
        by.get(wire_key(kind, owner, name)) ?? []
    }

    /// `f`'s declarations indexed by kind, owner and name, kept.
    fn wire_indexed(f: FileId, ids: List<DeclId>) -> Map<string, List<DeclId>> {
        mut by: Map<string, List<DeclId>> = {}
        for id in ids {
            let x = self.decl(id)
            let k = wire_key(kind_word(x.kind), x.owner, x.name)
            by.set(k, (by.get(k) ?? []).concat([id]))
        }
        self.wire_index.put("${f.index}", WireIndex { count: ids.length, by: by })
        by
    }

    fn read_type_wire(words: List<string>, at: int) -> WireType? {
        if at >= words.length { return null }
        let tag = words[at]
        let scalar: Type? = match tag {
            "i" -> Type.Int,
            "f" -> Type.Float,
            "b" -> Type.Bool,
            "s" -> Type.Str,
            "y" -> Type.Bytes,
            "p" -> Type.Ptr,
            "v" -> Type.Void,
            "n" -> Type.Null,
            "e" -> Type.EmptyList,
            "h" -> Type.EmptyMap,
            "x" -> Type.Error,
            "T" -> Type.Tasks,
            _ -> null,
        }
        if scalar != null { return WireType { id: self.types.intern(scalar!), next: at + 1 } }
        if tag == "S" || tag == "E" || tag == "D" || tag == "N" || tag == "R" || tag == "A" {
            let wd? = self.wire_decl(words, at + 1) else { return null }
            let d = wd.id
            let x = self.decl(d)
            if tag == "S" { return WireType { id: self.types.intern(Type.Struct(d, x.name)), next: wd.next } }
            if tag == "E" { return WireType { id: self.types.intern(Type.Enum(d, x.name)), next: wd.next } }
            if tag == "D" { return WireType { id: self.types.intern(Type.Dyn(d, x.name)), next: wd.next } }
            if tag == "N" { return WireType { id: self.types.intern(Type.TypeName(d, x.name)), next: wd.next } }
            if wd.next >= words.length { return null }
            let n? = wire_number(words[wd.next]) else { return null }
            if tag == "R" {
                let names = self.tparams(d)
                if n < 0 || n >= names.length { return null }
                return WireType {
                    id: self.types.intern(Type.Var(d, n, names[n])),
                    next: wd.next + 1,
                }
            }
            if n < 0 { return null }
            mut args: List<TypeId> = []
            mut cursor = wd.next + 1
            for j in 0..n {
                let child? = self.read_type_wire(words, cursor) else { return null }
                args.push(child.id)
                cursor = child.next
            }
            return WireType { id: self.types.intern(Type.App(d, x.name, args)), next: cursor }
        }
        if tag == "L" || tag == "C" || tag == "O" || tag == "K" {
            let child? = self.read_type_wire(words, at + 1) else { return null }
            let raw = when {
                tag == "L" -> Type.List(child.id)
                tag == "C" -> Type.Cell(child.id)
                tag == "K" -> Type.Task(child.id)
                _ -> Type.Opt(child.id)
            }
            return WireType { id: self.types.intern(raw), next: child.next }
        }
        if tag == "M" || tag == "Q" {
            let a? = self.read_type_wire(words, at + 1) else { return null }
            let b? = self.read_type_wire(words, a.next) else { return null }
            let raw = if tag == "M" { Type.Map(a.id, b.id) } else { Type.Res(a.id, b.id) }
            return WireType { id: self.types.intern(raw), next: b.next }
        }
        if tag == "F" {
            if at + 1 >= words.length { return null }
            let n? = wire_number(words[at + 1]) else { return null }
            mut params: List<TypeId> = []
            mut cursor = at + 2
            if n < 0 { return null }
            for j in 0..n {
                let child? = self.read_type_wire(words, cursor) else { return null }
                params.push(child.id)
                cursor = child.next
            }
            if cursor >= words.length { return null }
            let bits = words[cursor]
            // EACH SEAT SPENDS `mark_word_width` CHARACTERS, PACKED WITH NO
            // SEPARATOR — the same boundary-that-moves hazard a flat splice
            // always carries (CLAUDE.md), so a seat is read at its own
            // slice, never at one character per seat.
            mut marks: List<SeatMark> = []
            for j in 0..n {
                let lo = j * mark_word_width
                let hi = lo + mark_word_width
                if hi > bits.length { return null }
                marks.push(mark_of_word(bits.substring(lo, hi)))
            }
            let ret? = self.read_type_wire(words, cursor + 1) else { return null }
            return WireType {
                id: self.types.intern(Type.Fn(params, marks, ret.id)),
                next: ret.next,
            }
        }
        if tag == "U" {
            if at + 1 >= words.length { return null }
            let n? = wire_number(words[at + 1]) else { return null }
            if n < 0 { return null }
            mut members: List<TypeId> = []
            mut cursor = at + 2
            for j in 0..n {
                let child? = self.read_type_wire(words, cursor) else { return null }
                members.push(child.id)
                cursor = child.next
            }
            // `union_of` is the only door — a wire's members re-canonicalize
            // exactly as a freshly-declared union's would
            return WireType { id: self.types.union_of(members), next: cursor }
        }
        null
    }

    /// A type as a record writes it.
    fn type_wire(id: TypeId) -> string { "^${self.wire_body(id)}" }

    /// The wire without its mark — what a wire nests.
    fn wire_body(id: TypeId) -> string {
        match self.types.shape_of(id) {
            .Int -> "i",
            .Float -> "f",
            .Bool -> "b",
            .Str -> "s",
            .Bytes -> "y",
            .Ptr -> "p",
            .Void -> "v",
            .Null -> "n",
            .EmptyList -> "e",
            .EmptyMap -> "h",
            .Error -> "x",
            .Struct(d, _) -> "S~${self.decl_wire(d)}",
            .Enum(d, _) -> "E~${self.decl_wire(d)}",
            .Dyn(d, _) -> "D~${self.decl_wire(d)}",
            .TypeName(d, _) -> "N~${self.decl_wire(d)}",
            .Var(d, j, _) -> "R~${self.decl_wire(d)}~${j}",
            .App(d, _, args) -> "A~${self.decl_wire(d)}~${args.length}~${joined([self.wire_body(a) for a in args], "~")}",
            .List(t) -> "L~${self.wire_body(t)}",
            .Cell(t) -> "C~${self.wire_body(t)}",
            .Task(t) -> "K~${self.wire_body(t)}",
            .Tasks -> "T",
            .Opt(t) -> "O~${self.wire_body(t)}",
            .Map(k, v) -> "M~${self.wire_body(k)}~${self.wire_body(v)}",
            .Res(ok, err) -> "Q~${self.wire_body(ok)}~${self.wire_body(err)}",
            .Fn(params, marks, ret) -> joined(
                ["F", "${params.length}"]
                    .concat([self.wire_body(t) for t in params])
                    .concat(
                        [
                            joined(
                                [mark_word(if j < marks.length { marks[j] } else { no_seat_mark }) for j in 0..params.length],
                                "",
                            ),
                            self.wire_body(ret),
                        ],
                    ),
                "~",
            ),
            .Union(members) -> joined(["U", "${members.length}"].concat([self.wire_body(m) for m in members]), "~"),
            .Range -> "g",
        }
    }

    /// `decl_wire`'s inverse — the declaration a wire names, and how many
    /// words it read (4, or 5 across a name it shared with a sibling).
    fn wire_decl(words: List<string>, at: int) -> WireDeclRef? {
        if at + 3 >= words.length { return null }
        let kind = words[at + 1]
        let owner = text_of_field(words[at + 2])
        let name = text_of_field(words[at + 3])
        // A BUILTIN IS THE LANGUAGE'S, filed under no file of the program's: its name
        // alone finds it.
        if builtin_word(kind) {
            let b? = self.builtin_decls().find((d) -> self.decl(d).name == name) else { return null }
            return WireDeclRef { id: b, next: at + 4 }
        }
        let f: FileId? = self.known_file_id(words[at])
        if f == null { return null }
        let siblings = self.wire_siblings(f!, kind, owner, name)
        if siblings.length == 1 { return WireDeclRef { id: siblings[0], next: at + 4 } }
        if siblings.is_empty() { return null }
        if at + 4 >= words.length { return null }
        let idx? = wire_number(words[at + 4]) else { return null }
        if idx < 0 || idx >= siblings.length { return null }
        WireDeclRef { id: siblings[idx], next: at + 5 }
    }
}

/// A declaration's place in its file's wire index.
fn wire_key(kind: string, owner: string, name: string) -> string { "${kind}\t${owner}\t${name}" }

/// `wire_decl`'s answer: the declaration, and where the next field starts.
type WireDeclRef = { id: DeclId, next: int }

/// One bounded seat in the fn row's bounds column.
fn bound_entry(j: int, wires: List<string>) -> string { "${j}=${joined(wires, "|")}" }

/// What generated the declaration at `ordinal` of `path` — written only for a generated one.
fn maker_line(path: string, ordinal: int, maker: string) -> string {
    "maker\t${path}\t${ordinal}\t${field_text(maker)}"
}

/// A file's makers as its record keeps them, by the declaration's ordinal.
export fn makers_in(fields: List<List<string>>, path: string) -> Map<string, string> {
    mut out: Map<string, string> = {}
    for p in fields {
        if p.length == 4 && p[0] == "maker" && p[1] == path { out.set(p[2], text_of_field(p[3])) }
    }
    out
}
