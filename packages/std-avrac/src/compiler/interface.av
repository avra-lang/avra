//! The interface's Workspace/Decls verbs: mint, fill, key, and the
//! wire each record line carries. The record FORMAT lives in record.av.
use core.{joined, flatten, distinct, sorted_texts, module_path, digest_of, same_decl, ModulePath, TypeLit, Type, TypeId, DeclId, FileId, StmtId, ExprId, SeatMark, TypeRef}
use features.{Decl, FnSig, StructSig, EnumSig, NamedSig, Decls, SettleRoot, Settled, kind_word, scalar_named}
use compiler.lower.{Body}
use compiler.store.{CACHE_FORMAT, Store, Stored, node_key}

/// One file's lines in its module's record, and the digest of what a caller can see of them.
type FileLines = { path: string, lines: List<string>, iface: string }

impl Workspace {

fn keep_const_units(store: Store, modules: List<ModulePath>) -> int {
    mut count = 0
    for m in modules {
        for d in self.interface_decls( m) {
            if d.kind is .Const && !self.is_held(d.file) {
                let path = self.decls.file(d.file).path
                let key = self.const_unit_key( store, m, path, d.name)
                if !store.has(Stored.Unit, key) {
                    match self.settled(d.file, SettleRoot.Const(d.stmt), []) {
                        .Ok(value) -> {
                            let _ = store.keep(Stored.Unit, key, settled_wire(value), [obj_key_of(self, store, m, path)])
                            count = count + 1
                        },
                        .Err(_) -> { let _ = 0 },
                    }
                }
            }
        }
    }
    count
}

fn const_rows_ready(store: Store, m: ModulePath, path: string, rows: List<List<string>>) -> bool {
    for parts in rows {
        if parts.length > 5 && parts[0] == "const" {
            if !store.has(Stored.Unit, self.const_unit_key(store, m, path, parts[5])) { return false }
        }
    }
    true
}

fn const_unit_key(store: Store, m: ModulePath, path: string, name: string) -> string {
    node_key(Stored.Unit, ["const", CACHE_FORMAT, obj_key_cached(self, store, m, path), name])
}

fn fill_shape(store: Store, m: ModulePath, id: DeclId, parts: List<string>) {
    let f = self.decls.decl(id).file
    let stmt = self.decls.decl(id).stmt
    let path = parts[1]
    // A SHAPE NAMES OTHER TYPES, and `by_name` can only answer for types that EXIST — a
    // spelling it does not know is a DEFECT in the record, not a name to guess at. The
    // fallback is `error`, the ABSORBING type, so a broken record produces a type that
    // refuses rather than one that is silently wrong.
    // AN `extern fn`'s record word is `extern`; its payload is a fn's, so the shape
    // branch below is the fn branch.
    let word = if parts[0] == "extern" { "fn" } else { parts[0] }
    if word == "const" {
        let ty = self.interface_type( id, parts[13].split(";").first() ?? "")
        self.decls.record_const_type(f, stmt, ty)
        // a held const has no initializer to settle again: its kept value is the
        // only one, and a row that does not give it back is a defect said
        let value: Settled? = settled_from_wire(store.get(Stored.Unit, self.const_unit_key(store, m, path, parts[5])) ?? "")
        if value == null { return self.defect("a held const's value did not decode — `${parts[5]}` in ${path}") }
        self.decls.remember_held_value(id, value!)
    }
    if word == "aims" {
        let aimed = self.decl_from_ref(parts[13])
        if aimed != null { self.decls.record_target(id, aimed!) }
    }
    if word == "named" {
        let of = self.interface_type( id, parts[13])
        self.decls.declare(id, .Named(NamedSig { of: of }))
        let named = self.decls.types.intern(Type.Struct(id, parts[5]))
        self.decls.types.mark_named(named, of)
        self.decls.types.mark_flat(named, [of])
    }
    if word == "struct" || word == "boxed" {
        // a seal is sticky, so the layout the record kept lands before the declaration
        if word == "boxed" { self.decls.types.unflatten(self.decls.record_type(id)) }
        let fields = if parts.length > 13 && !parts[13].is_empty() { parts[13].split(";") } else { [] }
        self.decls.declare(id, .Record(StructSig {
            names: [field_name(f) for f in fields],
            types: [self.interface_type( id, name_of_field(f)) for f in fields],
            defaults: [self.decls.default_named(id, field_name(f)) for f in fields],
        }))
        let made = self.decls.record_type(id)
        if self.decls.types.is_flat(made) { self.held_flat.push(made) }
    }
    if word == "enum" {
        let arms = if parts.length > 13 && !parts[13].is_empty() { parts[13].split(";") } else { [] }
        self.decls.declare(id, .Enum(EnumSig { names: [field_name(a) for a in arms], payloads: [payload_of(self, id, a) for a in arms] }))
    }
    if word == "fn" {
        let seats = if parts.length > 13 && !parts[13].is_empty() { parts[13].split(";") } else { [] }
        let marks: List<SeatMark> = if parts.length > 15 && !parts[15].is_empty() { [mark_of_word(w) for w in parts[15].split(";")] } else { [] }
        self.decls.record_seats(id, marks)
        self.decls.declare(id, .Fn(FnSig {
            params: [self.interface_type( id, s) for s in seats],
            ret: self.interface_type( id, parts[14]),
        }))
        if parts.length > 16 {
            let bits = parts[16]
            for j in 0..bits.length { if bits.char_code(j) == 49 { self.decls.record_seat_written(id, j) } }
        }
    }
}

fn interface_decls(m: ModulePath) -> List<Decl> {
    mut ids: List<DeclId> = []
    for path in self.module_files(m) {
        let f = self.file_id(path)
        let _ = self.items(f)
        ids = ids.concat(self.decls.decls_of_file(f))
    }
    [self.decl_at(id) for id in ids]
}

fn interface_plain(owner: DeclId, a: TypeRef) -> TypeId? {
    if a.dynamic {
        let base: TypeId? = self.decls.types.by_name(a.name)
        if base == null { return null }
        let decl: DeclId? = nominal_decl(self.decls.types, base!)
        if decl == null { return null }
        return self.decls.types.intern(Type.Dyn(decl!, a.name))
    }
    if a.args.is_empty() {
        let named: TypeId? = self.decls.types.by_name(a.name)
        if named != null { return named! }
        let j: int? = self.decls.tparams(owner).index_of(a.name)
        if j != null && j! >= 0 { return self.decls.types.intern(Type.Var(owner, j!, a.name)) }
        let word: Type? = scalar_named(a.name)
        if word != null { return self.decls.types.intern(word!) }
        if a.name == "void" { return self.decls.types.interned(TypeLit.Void) }
        if a.name == "ptr" { return self.decls.types.interned(TypeLit.Ptr) }
        if a.name == "bytes" { return self.decls.types.interned(TypeLit.Bytes) }
        return null
    }
    mut args: List<TypeId> = []
    for g in a.args {
        let t: TypeId? = self.interface_spelled( owner, g)
        if t == null { return null }
        args.push(t!)
    }
    if a.name == "List" && args.length == 1 {
        let elem = args[0]
        return self.decls.types.type(List<elem>)
    }
    if a.name == "Map" && args.length == 2 {
        let val = args[1]
        return self.decls.types.type(Map<string, val>)
    }
    let base: TypeId? = self.decls.types.by_name(a.name)
    if base == null { return null }
    let decl: DeclId? = nominal_decl(self.decls.types, base!)
    if decl == null { return null }
    self.decls.types.intern(Type.App(decl!, a.name, args))
}

fn interface_spelled(owner: DeclId, a: TypeRef) -> TypeId? {
    let plain: TypeId? = self.interface_plain( owner, a)
    if plain == null { return null }
    let held = plain!
    // A NULLABLE IS ITS OWN TYPE, scalar or boxed: the interface decodes what the SOURCE
    // grammar refuses (`int?` is legal there), so no `rides_pointer` gate here.
    if !a.optional { return held }
    self.decls.types.type(held?)
}

fn interface_type(owner: DeclId, name: string) -> TypeId {
    if name.starts_with("^") {
        let words = name.substring(1, name.length).split("~")
        let decoded = self.decls.read_type_wire( words, 0)
        if decoded != null && decoded!.next == words.length { return decoded!.id }
        return self.decls.types.intern(Type.Error)
    }
    let known = self.decls.types.by_name(name)
    if known != null { return known! }
    let written = parse_type_ref(self.lang, name)
    if written == null { return self.decls.types.intern(Type.Error) }
    let ty: TypeId? = self.interface_spelled( owner, written!)
    ty ?? self.decls.types.intern(Type.Error)
}

/// A held file's declarations adopted by their parents, in one pass over its
/// lines: the file and its declarations are found ONCE, never per line.
fn link_file(path: string, rows: List<List<string>>) {
    let ids = self.decls.decls_so_far(self.file_id(path))
    for parts in rows {
        let id: DeclId? = row_of(ids, parts)
        let parent_at = if parts.length > 8 { wire_number(parts[8]) ?? (0 - 1) } else { 0 - 1 }
        if id != null && parent_at >= 0 && parent_at < ids.length { self.decls.adopt(id!, ids[parent_at]) }
    }
}

/// A held file's shapes filled, the same way.
fn fill_file(store: Store, m: ModulePath, path: string, rows: List<List<string>>) {
    let ids = self.decls.decls_so_far(self.file_id(path))
    for parts in rows {
        let id: DeclId? = row_of(ids, parts)
        if id != null { self.fill_shape(store, m, id!, parts) }
    }
}

/// ONE HELD MODULE, MINTED: every held file's declarations from its record lines,
/// each adopted by its parent, then every shape filled — names before shapes, since
/// a shape names a type of its own module. A shape naming ANOTHER module's type
/// mints that module on the way (`Decls.decls_of_file` asks), and the flag stands
/// before the work does, so two modules that name each other meet once.
fn mint_module(store: Store, m: ModulePath) {
    if self.minted.get(m.text()) != null { return }
    self.minted.set(m.text(), true)
    let fields = record_fields(self, store, m)
    let places = record_places(self, store, m)
    let held = [path for path in self.module_files(m) if self.decls.held.get(path) != null]
    for path in held { self.mint_file(path, file_rows(fields, places.get(path))) }
    for path in held { self.link_file(path, file_rows(fields, places.get(path))) }
    for path in held { self.fill_file(store, m, path, file_rows(fields, places.get(path))) }
}

/// ONE HELD FILE'S DECLARATIONS, minted from its record lines in record order. The
/// file's statement table is written ONCE: read out and stored back per line, it
/// is held twice while it is written, and every line copies it.
fn mint_file(path: string, rows: List<List<string>>) {
    let f = self.file_id(path)
    mut by_stmt = self.decls.decl_ids[f.index].get()
    for parts in rows {
        let id: DeclId? = self.minted(f, path, parts)
        let stmt_index = wire_number(parts[3]) ?? 0
        by_stmt.grow_to(stmt_index + 1)
        if id != null && by_stmt.get(stmt_index) == null { by_stmt.set(stmt_index, id!) }
    }
    self.decls.keep_stmt_decls(f, by_stmt)
}

/// One record line as a declaration — null for a line that names nothing. A line
/// that does not decode is a DEFECT spoken: the hold's attempt fails, and the
/// sources answer.
fn minted(f: FileId, path: string, parts: List<string>) -> DeclId? {
    if parts.length < 13 || nameless(parts) { return null }
    let stmt_index = wire_number(parts[3])
    let root_at = wire_number(parts[10])
    let ordinal = wire_number(parts[2])
    let kind = declared_kind(parts[0], parts[6])
    let facts = facts_unblocked(parts[12])
    if stmt_index == null || root_at == null || ordinal == null || kind == null || facts == null {
        self.defect("a record line did not decode — ${path}")
        return null
    }
    let root: ExprId? = if root_at! < 0 { null } else { ExprId { index: root_at! } }
    // the ordinal is the record's identity within a held file: a name/kind key
    // collapses generated members and same-named methods
    let id = self.decls.mint("${f.index}#held#${ordinal!}", f, StmtId { index: stmt_index! }, parts[5], kind!, parts[4] == "1", parts[7], null, parts[9] == "1", root)
    self.decls.held_joins(f, id, ordinal!, kind! is .Main, parts[11] == "1")
    self.decls.adopt_facts(id, facts!)
    id
}

fn record_line(d: Decl, ordinal: int, item: bool) -> string {
    let sig = if d.kind is .Const { null } else { self.sig(d.id) }
    let shape = if d.kind is .Const {
        let ty = self.decls.type_of_const(d.file, d.stmt) ?? self.decls.types.intern(Type.Error)
        // a reader bakes the VALUE in, so the value is the interface
        "const\t${self.decls.type_wire( ty)};${self.const_print(d)}"
    } else if d.kind is .Impl {
        // an impl is filed under its target's NAME, and a held one has no namespace to
        // ask which declaration of that name it means
        "aims\t${self.decl_ref(self.decls.target_of(d.id))}"
    } else if sig == null {
        "opaque"
    } else if d.kind is .Fn || d.kind is .Method {
        // THE SEATS' CONTRACTS AND WHAT THE BODY WROTE are parse facts a held file
        // cannot answer, and a caller's `mut`/retain decision reads them. They ride
        // the fn's payload: one word per seat, then one bit per seat.
        let n = self.decls.seat_count(d.id)
        let marks = joined([mark_word(self.decls.seat_mark(d.id, j)) for j in 0..n], ";")
        let writes = joined([if self.decls.seat_written_so_far(d.id, j) { "1" } else { "0" } for j in 0..n], "")
        "${shape_line(self, sig!, "")}\t${marks}\t${writes}"
    } else {
        shape_line(self, sig!, if d.kind is .Record && self.decls.types.boxed_flat(self.decls.record_type(d.id)) { "boxed" } else { "struct" })
    }
    let at = shape.index_of("\t")
    let visibility = if d.exported { "1" } else { "0" }
    // AN `extern fn` WEARS ITS OWN SHAPE WORD. The fact is a STORE read (`extern_parts`),
    // and a held file has no store, so the record must carry it: the word is the one
    // column every kind already has, and the payload's layout is unchanged.
    let first = if self.decls.is_extern(d.id) { "extern" } else if at < 0 { shape } else { shape.substring(0, at) }
    let payload = if at < 0 { "" } else { shape.substring(at + 1, shape.length) }
    mut parent_at = 0 - 1
    if d.parent != null {
        for j, id in self.decls.decls_of_file(d.file) {
            if same_decl(id, d.parent!) { parent_at = j }
        }
    }
    let root = d.root?.index ?? (0 - 1)
    let facts = self.decls.facts_or(d.id)
    let block = facts_block(facts)
    // THE CODEC IS HELD TO ITSELF WHERE IT WRITES: a fact the decoder does not give
    // back is a defect said now, never a check every reader pays
    if facts_unblocked(block)?.fingerprint() != facts.fingerprint() { self.defect("`${d.name}`'s facts do not survive their record") }
    "${first}\t${self.decls.file(d.file).path}\t${ordinal}\t${d.stmt.index}\t${visibility}\t${field_text(d.name)}\t${kind_word(d.kind)}\t${field_text(d.owner)}\t${parent_at}\t${if d.nested { "1" } else { "0" }}\t${root}\t${if item { "1" } else { "0" }}\t${block}\t${payload}"
}

fn record_of(store: Store, m: ModulePath) -> string {
    let prior_lines = record_cached(self, store, m).split("\n")
    let files = self.module_files(m)
    let kept = lines_by_file(prior_lines)
    let fresh = flatten([self.imported_by(path) for path in files if !self.is_held(self.file_id(path))])
    let here = distinct([line for line in prior_lines if line.starts_with("import\t")].concat(["import\t${d.text()}" for d in fresh]))
    let parts = [self.file_lines(store, m, path, kept) for path in files]
    // what a file's lines were read from, what its runs read and its own interface
    // stand on its `file` line; the module's interface is its files', in name order
    let read = ["file\t${f.path}\t${self.text_digest(f.path)}\t${joined(self.ran_by(store, f.path), "|")}\t${f.iface}" for f in parts]
    let iface = digest_of(joined(sorted_texts([f.iface for f in parts]), "\n"))
    joined(["iface\t${iface}"].concat(here).concat(read).concat(flatten([f.lines for f in parts])), "\n")
}

/// One file's part of its module's record. A HELD file's lines are copied
/// verbatim — it is held against them — and its interface digest with them, so a
/// body edit elsewhere in the module reads no held line.
fn file_lines(store: Store, m: ModulePath, path: string, kept: Map<string, List<string>>) -> FileLines {
    if !self.is_held(self.file_id(path)) {
        let lines = self.lines_of(path)
        return FileLines { path: path, lines: lines, iface: iface_digest(lines) }
    }
    let lines = kept.get(path) ?? []
    let at: Placed? = record_places(self, store, m).get(path)
    FileLines { path: path, lines: lines, iface: if at != null && at!.file.length > 4 { at!.file[4] } else { iface_digest(lines) } }
}

/// A parsed file's record lines, one per declaration.
fn lines_of(path: string) -> List<string> {
    let f = self.file_id(path)
    let top = self.items(f)
    [self.record_line(self.decl_at(id), ordinal, on_top(top, id)) for ordinal, id in self.decls.decls_of_file(f)]
}

/// A settled const's value as one number — 0 for one that did not settle.
fn const_print(d: Decl) -> int {
    match self.settled(d.file, SettleRoot.Const(d.stmt), []) {
        .Ok(value) -> value.fingerprint,
        .Err(_) -> 0,
    }
}

/// EVERY FILE WHOSE TEXT A FILE'S COMPILE-TIME RUNS READ — its own runs', and the
/// runs of every const those read. In name order.
fn ran_by(store: Store, path: string) -> List<string> {
    // LICENSED I16: a WORKLIST — the list grows while it is walked
    mut seen: List<string> = [path]
    mut at = 0
    while at < seen.length {
        for q in self.ran_directly(store, seen[at]) {
            if !seen.contains(q) { seen.push(q) }
        }
        at = at + 1
    }
    sorted_texts(seen.slice(1, seen.length))
}

/// What one file's runs read: as this build met them, or, for a held file, as
/// its module's last record kept them.
fn ran_directly(store: Store, path: string) -> List<string> {
    if !self.is_held(self.file_id(path)) { return self.runs.get(path) ?? [] }
    kept_runs(record_places(self, store, module_path(self.module_of(path).split("."))).get(path))
}

}

/// The declaration a record line speaks for, among its file's: by ordinal.
fn row_of(ids: List<DeclId>, parts: List<string>) -> DeclId? {
    if parts.length < 13 { return null }
    let ordinal? = wire_number(parts[2]) else { return null }
    if ordinal < 0 || ordinal >= ids.length { return null }
    ids[ordinal]
}

impl Workspace {

/// A NESTED declaration joins no namespace, so no symbol names it.
fn stub_of(d: Decl) -> Body? {
    if d.nested { return null }
    let s? = self.sig(d.id) else { return null }
    match s {
        .Fn(sig) -> Body { name: self.decls.symbol(d.id), params: sig.params, ret: sig.ret, gives: null, ins: [], reg_types: [], file: d.file },
        rest -> null,
    }
}
}

impl Decls {

fn decl_wire(d: DeclId) -> string {
    let x = self.decl(d)
    mut at = 0
    for j, id in self.decls_of_file(x.file) {
        if same_decl(id, d) { at = j }
    }
    "${self.file(x.file).path}~${at}"
}

fn read_type_wire(words: List<string>, at: int) -> WireType? {
    if at >= words.length { return null }
    let tag = words[at]
    let scalar: Type? = match tag {
        "i" -> Type.Int, "f" -> Type.Float, "b" -> Type.Bool,
        "s" -> Type.Str, "y" -> Type.Bytes, "p" -> Type.Ptr,
        "v" -> Type.Void, "n" -> Type.Null, "e" -> Type.EmptyList,
        "h" -> Type.EmptyMap, "x" -> Type.Error, _ -> null,
    }
    if scalar != null { return WireType { id: self.types.intern(scalar!), next: at + 1 } }
    if tag == "S" || tag == "E" || tag == "D" || tag == "N" || tag == "R" || tag == "A" {
        let d? = self.wire_decl( words, at + 1) else { return null }
        let x = self.decl(d)
        if tag == "S" { return WireType { id: self.types.intern(Type.Struct(d, x.name)), next: at + 3 } }
        if tag == "E" { return WireType { id: self.types.intern(Type.Enum(d, x.name)), next: at + 3 } }
        if tag == "D" { return WireType { id: self.types.intern(Type.Dyn(d, x.name)), next: at + 3 } }
        if tag == "N" { return WireType { id: self.types.intern(Type.TypeName(d, x.name)), next: at + 3 } }
        if at + 3 >= words.length { return null }
        let n? = wire_number(words[at + 3]) else { return null }
        if tag == "R" {
            let names = self.tparams(d)
            if n < 0 || n >= names.length { return null }
            return WireType { id: self.types.intern(Type.Var(d, n, names[n])), next: at + 4 }
        }
        if n < 0 { return null }
        mut args: List<TypeId> = []
        mut cursor = at + 4
        for j in 0..n {
            let child? = self.read_type_wire( words, cursor) else { return null }
            args.push(child.id)
            cursor = child.next
        }
        return WireType { id: self.types.intern(Type.App(d, x.name, args)), next: cursor }
    }
    if tag == "L" || tag == "C" || tag == "O" {
        let child? = self.read_type_wire( words, at + 1) else { return null }
        let raw = if tag == "L" { Type.List(child.id) } else if tag == "C" { Type.Cell(child.id) } else { Type.Opt(child.id) }
        return WireType { id: self.types.intern(raw), next: child.next }
    }
    if tag == "M" || tag == "Q" {
        let a? = self.read_type_wire( words, at + 1) else { return null }
        let b? = self.read_type_wire( words, a.next) else { return null }
        let raw = if tag == "M" { Type.Map(a.id, b.id) } else { Type.Res(a.id, b.id) }
        return WireType { id: self.types.intern(raw), next: b.next }
    }
    if tag == "F" {
        if at + 1 >= words.length { return null }
        let n? = wire_number(words[at + 1]) else { return null }
        mut params: List<TypeId> = []
        mut cursor = at + 2
        if n < 0 { return null }
        for j in 0..n {
            let child? = self.read_type_wire( words, cursor) else { return null }
            params.push(child.id)
            cursor = child.next
        }
        if cursor >= words.length { return null }
        let bits = words[cursor]
        mut marks: List<SeatMark> = []
        for j in 0..n {
            if j >= bits.length { return null }
            marks.push(mark_of_word(bits.substring(j, j + 1)))
        }
        let ret? = self.read_type_wire( words, cursor + 1) else { return null }
        return WireType { id: self.types.intern(Type.Fn(params, marks, ret.id)), next: ret.next }
    }
    null
}

fn type_wire(id: TypeId) -> string {
    let body = match self.types.shape_of(id) {
        .Int -> "i",
        .Float -> "f",
        .Bool -> "b",
        .Str -> "s",
        .Bytes -> "y",
        .Ptr -> "p",
        .Void -> "v",
        .Null -> "n",
        .EmptyList -> "e",
        .EmptyMap -> "h",
        .Error -> "x",
        .Struct(d, _) -> "S~${self.decl_wire( d)}",
        .Enum(d, _) -> "E~${self.decl_wire( d)}",
        .Dyn(d, _) -> "D~${self.decl_wire( d)}",
        .TypeName(d, _) -> "N~${self.decl_wire( d)}",
        .Var(d, j, _) -> "R~${self.decl_wire( d)}~${j}",
        .App(d, _, args) -> "A~${self.decl_wire( d)}~${args.length}~${joined([self.type_wire( a).substring(1, self.type_wire( a).length) for a in args], "~")}",
        .List(t) -> "L~${self.type_wire( t).substring(1, self.type_wire( t).length)}",
        .Cell(t) -> "C~${self.type_wire( t).substring(1, self.type_wire( t).length)}",
        .Opt(t) -> "O~${self.type_wire( t).substring(1, self.type_wire( t).length)}",
        .Map(k, v) -> "M~${self.type_wire( k).substring(1, self.type_wire( k).length)}~${self.type_wire( v).substring(1, self.type_wire( v).length)}",
        .Res(ok, err) -> "Q~${self.type_wire( ok).substring(1, self.type_wire( ok).length)}~${self.type_wire( err).substring(1, self.type_wire( err).length)}",
        .Fn(params, marks, ret) -> joined(["F", "${params.length}"].concat([self.type_wire( t).substring(1, self.type_wire( t).length) for t in params]).concat([joined([mark_word(if j < marks.length { marks[j] } else { no_seat_mark }) for j in 0..params.length], ""), self.type_wire( ret).substring(1, self.type_wire( ret).length)]), "~"),
    }
    "^${body}"
}

fn wire_decl(words: List<string>, at: int) -> DeclId? {
    if at + 1 >= words.length { return null }
    let ordinal? = wire_number(words[at + 1]) else { return null }
    let f: FileId? = self.paths.get(words[at])
    if f == null || ordinal < 0 { return null }
    let ids = self.decls_of_file(f!)
    if ordinal >= ids.length { return null }
    ids[ordinal]
}
}

