//! WHERE AN IMPL DOESN'T ANSWER ITS TRAIT: an impl-for names its trait at every parameter the trait
//! declares, answers each member the trait leaves unwritten, each under the signature the trait
//! writes for it, and writes no default the trait writes already; it lands for the whole generic it
//! is written for, on the type itself and never an alias; and a bound names its trait at every
//! parameter too. Read off the written item's impls and the trait each names, as each is written.
use core.{StmtId, SyntaxArena, TypeRef, flatten, some_list, spelled}
use compiler.laws.{Found, law}
use compiler.typing.{
    bound_miscounts_trait,
    default_is_the_traits,
    impl_miscounts_trait,
    impl_no_trait,
    impl_of_instantiation,
    impl_on_alias,
    impl_unanswered,
    signature_unworn,
}
use diagnostics.{Voice}
use @std.text.{parse_int}
use @std.program.address.{SourceFileAddress}
use @std.program.query_engine.{QueryEngine}

/// A trait as an impl or a bound reads it: its name, the item that declares it and the statement
/// there.
type TraitRead = { name: string, item: ReadItem, stmt: StmtId }

/// The trait `name` names from `file`; absent where it names none.
fn trait_read(engine: QueryEngine, file: SourceFileAddress, name: string) -> TraitRead? {
    let d? = resolved(engine, file, Space.Type, name).named() else { return null }
    if d.kind != ItemKind.Trait { return null }
    let item = read_item(engine, d.file, d.item)
    let stmt? = item.stmts.find((s) -> item.store.trait_parts(s)?.name == d.name) else { return null }
    TraitRead { name: d.name, item: item, stmt: stmt }
}

impl TraitRead {
    /// How many type arguments the trait takes.
    fn takes() -> int { self.item.store.decl_tparams(self.stmt).length }

    /// The members the trait declares.
    fn members() -> List<StmtId> { self.item.store.trait_parts(self.stmt)?.fns ?? [] }
}

/// The word a trait names its implementor by.
const SELF_WORD: string = "Self"

/// The types a fn's signature writes: each seat's, then its answer's.
fn signed_types(store: SyntaxArena, f: StmtId) -> List<TypeRef> {
    let parts? = store.fn_parts(f) else { return [] }
    flatten([some_list(p.ty) for p in parts.params]).concat([parts.ret])
}

/// Whether `t` names any of `words`, itself or in its arguments.
fn names_any(t: TypeRef, words: List<string>) -> bool {
    words.contains(t.name) || t.type_args().concat(t.alternatives).any((a) -> names_any(a, words))
}

/// An impl-for the written item holds: its statement, what it's written with, and its trait.
type ImplRead = { stmt: StmtId, of: string, target: string, fns: List<StmtId>, gave: int, args: List<string>, tr: TraitRead }

/// Every impl-for the written item `at` of `file` writes whose trait is one, each beside its trait.
fn impls_read(engine: QueryEngine, file: SourceFileAddress, item: ReadItem) -> List<ImplRead> {
    [ImplRead {
        stmt: s,
        of: p!.of!,
        target: p!.target,
        fns: p!.fns,
        gave: item.store.trait_args_of(s).length,
        args: [spelled(a) for a in item.store.trait_args_of(s)],
        tr: tr!,
    } for s in item.stmts for p in [item.store.impl_parts(s)] if p != null && p!.of != null for tr in [trait_read(engine, file, p!.of!)] if tr != null]
}

/// Every impl-for the written item `at` of `file` writes whose trait names no trait, behind the parse
/// refusal of a file of its module where one holds; a name a refused `use` binds answers to that
/// `use` alone.
fn impls_untraited(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    let item? = parsed_item(engine, file, at) else { return [] }
    let untraited = [Found { at: item.store.stmt_span(s), args: [p!.of!] } for s in item.stmts for p in [item.store.impl_parts(s)] if p != null && p!.of != null && trait_read(engine, file, p!.of!) == null]
    if untraited.is_empty() { return [] }
    let refused = refused_imports(engine, file)
    [f with { unread: unread_here(engine, file, f.args[0]) } for f in untraited if !refused.contains(f.args[0])]
}

/// The written item `at` of `file`, read where it parsed; absent otherwise.
fn parsed_item(engine: QueryEngine, file: SourceFileAddress, at: int) -> ReadItem? {
    if at >= item_count(engine, file) { return null }
    let item = read_item(engine, file, at)
    if item.store.refusals().is_empty() { item } else { null }
}

/// Every impl naming its trait at another count of type arguments than the trait takes.
fn impls_miscounting(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    let item? = parsed_item(engine, file, at) else { return [] }
    [Found { at: item.store.stmt_span(i.stmt), args: [i.of, "${i.tr.takes()}", "${i.gave}"] } for i in impls_read(engine, file, item) if i.gave != i.tr.takes()]
}

/// The member `mn` of the impl `i`'s trait as a law finds it, said at the impl.
fn member_found(item: ReadItem, i: ImplRead, mn: string) -> Found { Found { at: item.store.stmt_span(i.stmt), args: [i.of, i.target, mn] } }

/// Every member an impl that names its trait rightly leaves unanswered: the trait writes it no body
/// and the impl no method.
fn members_unanswered(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    let item? = parsed_item(engine, file, at) else { return [] }
    [member_found(item, i, mn) for i in impls_read(engine, file, item) if i.gave == i.tr.takes() for m in i.tr.members() for mn in some_list(i.tr.item.store.fn_parts(m)?.name) if !written_body(i.tr.item, m) && !i.fns.any((f) -> item.store.fn_parts(f)?.name == mn)]
}

/// Every method an impl writes under another signature than its trait writes for the member: another
/// count of seats, or, where the member reads alike wherever it's written, another type.
fn signatures_unworn(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    let item? = parsed_item(engine, file, at) else { return [] }
    [member_found(item, i, mn) for i in impls_read(engine, file, item) if i.gave == i.tr.takes() for m in i.tr.members() for mn in some_list(i.tr.item.store.fn_parts(m)?.name) for f in i.fns if item.store.fn_parts(f)?.name == mn && !wears(i, m, item.store, f)]
}

/// Whether the method `f` wears the member `m`'s signature under the impl `i`: as many seats, and
/// each type the member writes — a type parameter of the trait read as the argument the impl gives
/// it — spelled as the method spells it. A type the trait's parameters or `Self` shape any other way
/// is left unjudged.
fn wears(i: ImplRead, m: StmtId, store: SyntaxArena, f: StmtId) -> bool {
    let want = signed_types(i.tr.item.store, m)
    let got = signed_types(store, f)
    if want.length != got.length { return false }
    let params = i.tr.item.store.decl_tparams(i.tr.stmt)
    (0..want.length)
        .all((j) -> worn_as(want[j], params, i.args) ?? spelled(got[j]) == spelled(got[j]))
}

/// The member's type `t` as an impl giving the trait's `params` the arguments `args` spells it:
/// itself where no parameter and no `Self` shapes it, a bare parameter its argument; absent
/// otherwise.
fn worn_as(t: TypeRef, params: List<string>, args: List<string>) -> string? {
    if !names_any(t, params.concat([SELF_WORD])) { return spelled(t) }
    let at = params.index_of(t.name)
    if at < 0 ||
        at >= args.length ||
        t.optional ||
        t.dynamic ||
        t.arrow ||
        !t.type_args().is_empty() { return null }
    args[at]
}

/// Every default an impl's method writes for a seat its trait's member writes one for, said at the
/// default.
fn defaults_twice(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    let item? = parsed_item(engine, file, at) else { return [] }
    [Found { at: item.store.expr_span(p.default!), args: [p.name.of, i.of, mn] } for i in impls_read(engine, file, item) for m in i.tr.members() for mn in some_list(i.tr.item.store.fn_parts(m)?.name) for f in i.fns if item.store.fn_parts(f)?.name == mn for j, p in item.store.fn_parts(f)!.params if p.default != null &&
        j < i.tr.item.store.fn_parts(m)!.params.length &&
        i.tr.item.store.fn_parts(m)!.params[j].default != null]
}

/// Every impl written on an alias, beside what the alias names.
fn impls_on_aliases(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    let item? = parsed_item(engine, file, at) else { return [] }
    [Found { at: item.store.stmt_span(s), args: [p!.target, of] } for s in item.stmts for p in [item.store.impl_parts(s)] if p != null for of in some_list(alias_named(engine, file, p!.target))]
}

/// What the alias `name` names from `file`, as it's written; absent where `name` is no alias.
fn alias_named(engine: QueryEngine, file: SourceFileAddress, name: string) -> string? {
    let d? = resolved(engine, file, Space.Type, name).named() else { return null }
    if d.kind != ItemKind.Alias { return null }
    let item = read_item(engine, d.file, d.item)
    [spelled(a!.of) for s in item.stmts for a in [item.store.alias_parts(s)] if a != null && a!.name == d.name]
        .first()
}

/// Every impl-for written for one instantiation of a generic type the program declares: its target's
/// arguments aren't the type's own parameters, by name.
fn impls_of_instantiations(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    let item? = parsed_item(engine, file, at) else { return [] }
    [Found { at: item.store.stmt_span(s), args: [p!.of!, p!.target, declared.join(", ")] } for s in item.stmts for p in [item.store.impl_parts(s)] if p != null && p!.of != null for written in [[w.of for w in item.store.impl_tparams_of(s)?.target ?? []]] if !written.is_empty() for declared in some_list(declared_tparams(engine, file, p!.target)) if written.join(",") != declared.join(",")]
}

/// The type parameters the record or enum `name` names from `file` declares; absent for any other
/// name.
fn declared_tparams(engine: QueryEngine, file: SourceFileAddress, name: string) -> List<string>? {
    let d? = resolved(engine, file, Space.Type, name).named() else { return null }
    if d.kind != ItemKind.Record && d.kind != ItemKind.Enum { return null }
    let item = read_item(engine, d.file, d.item)
    [item.store.decl_tparams(s) for s in item.stmts if item.store.type_decl_name(s) == d.name]
        .first()
}

/// Every bound naming its trait at another count of type arguments than the trait takes.
fn bounds_miscounting(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    let item? = parsed_item(engine, file, at) else { return [] }
    [Found {
        at: item.store.stmt_span(s),
        args: [b.name, "${tr!.takes()}", "${b.type_args().length}"],
    } for s in item.store.stmt_ids() for b in item.store.bound_roots(s) if !b.optional && !b.dynamic && !b.arrow for tr in [trait_read(engine, file, b.name)] if tr != null && tr!.takes() != b.type_args().length]
}

/// an impl-for names a trait
export law impl_names_a_trait {
    kind: "type.trait"
    reads: impls_untraited
    voice: impl_untraited_words
    witness: "type P = { x: int }\n\nimpl Nope for P {\n}\n"
}

fn impl_untraited_words(a: List<string>) -> Voice { impl_no_trait(a[0]) }

/// an impl names its trait at every parameter the trait declares
export law impl_names_its_trait_whole {
    kind: "type.trait"
    reads: impls_miscounting
    voice: impl_count_words
    witness: "trait R<T> {\n    fn draw(t: T) -> int\n}\n\ntype P = { x: int }\n\nimpl R for P {\n    fn draw(t: int) -> int { t }\n}\n"
}

/// an impl answers every member its trait leaves unwritten
export law impl_answers_its_trait {
    kind: "type.trait"
    reads: members_unanswered
    voice: unanswered_words
    witness: "trait T {\n    fn m() -> int\n}\n\ntype P = { x: int }\n\nimpl T for P {\n}\n"
}

/// an impl's method wears the signature its trait writes for it
export law impl_wears_its_trait {
    kind: "type.trait"
    reads: signatures_unworn
    voice: unworn_words
    witness: "trait T {\n    fn m() -> int\n}\n\ntype P = { x: int }\n\nimpl T for P {\n    fn m() -> bool { true }\n}\n"
}

/// a seat's default is its trait's to write
export law impl_default_is_its_traits {
    kind: "type.trait_member"
    reads: defaults_twice
    voice: default_twice_words
    witness: "trait T {\n    fn m(a: int = 1) -> int\n}\n\ntype P = { x: int }\n\nimpl T for P {\n    fn m(a: int = 5) -> int { a }\n}\n"
}

/// an impl is written on the type itself
export law impl_on_the_type {
    kind: "type.impl"
    reads: impls_on_aliases
    voice: alias_words
    witness: "type P = { x: int }\n\nalias Q = P\n\nimpl Q {\n    fn dbl() -> int { self.x * 2 }\n}\n"
}

/// a trait impl lands for the whole generic
export law impl_for_the_whole_generic {
    kind: "type.impl"
    reads: impls_of_instantiations
    voice: instantiation_words
    witness: "trait S {\n    fn s() -> int\n}\n\ntype B<T> = { v: T }\n\nimpl S for B<int> {\n    fn s() -> int { 1 }\n}\n"
}

/// a bound names its trait at every parameter the trait declares
export law bound_names_its_trait_whole {
    kind: "type.trait"
    reads: bounds_miscounting
    voice: bound_count_words
    witness: "trait R<T> {\n    fn draw(t: T) -> int\n}\n\nfn f<X: R>(x: X) -> int { 1 }\n"
}

fn impl_count_words(a: List<string>) -> Voice { impl_miscounts_trait(a[0], parse_int(a[1]) ?? 0, parse_int(a[2]) ?? 0) }

fn bound_count_words(a: List<string>) -> Voice { bound_miscounts_trait(a[0], parse_int(a[1]) ?? 0, parse_int(a[2]) ?? 0) }

fn unanswered_words(a: List<string>) -> Voice { impl_unanswered(a[0], a[1], a[2]) }

fn unworn_words(a: List<string>) -> Voice { signature_unworn(a[0], a[1], a[2]) }

fn default_twice_words(a: List<string>) -> Voice { default_is_the_traits(a[0], a[1], a[2]) }

fn alias_words(a: List<string>) -> Voice { impl_on_alias(a[0], a[1]) }

fn instantiation_words(a: List<string>) -> Voice { impl_of_instantiation(a[0], a[1], a[2]) }
