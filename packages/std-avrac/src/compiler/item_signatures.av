//! WHAT A FN'S SIGNATURE SAYS, every type it writes resolved: to one of the fn's own type parameters,
//! to a type the language owns, or to the declaration its file's top level names. It's read off the
//! declaring item's tape and the names layer alone, and a declared type is known by its file and
//! name, never by where it stands, so a signature moves only when what it writes or what its names
//! name does.
use core.{
    Member,
    NamedParts,
    INFERRED,
    headed_type,
    Param,
    SignedSeat,
    SignedType,
    StmtId,
    SyntaxArena,
    TypeHead,
    TypeRef,
    new_node_store,
    seat_spelled,
    width_named,
    widthless,
}
use compiler.typing.{builtin_type_name}
use @std.meta.{derive}
use @std.program.address.{SourceFileAddress}
use @std.program.query_engine.{QueryDefinition, QueryEngine}
use @std.program.saved_derive.{Saved}
use @std.program.saved_query.{ListedQuery, definitions_of, query, query_definition}
use @std.program.sorted.{sorted_by}
use @std.text.{text_before}
use @std.program.source_facts.{PlacedTape}
use @std.program.syntax_tape.{SyntaxTape}

/// A fn's parameter: its name, its type when written, the promises its seat makes, and the width it
/// crosses to C at, if it names one. A width is the seat's, never the value's: the type is the
/// language's one integer.
@derive(Saved)
export type SignedParam = { name: string, ty: SignedType?, mutable: bool, settled: bool, width: string?, defaulted: bool = false }

/// A fn's signature: its type parameters, its parameters, its answer and the width its answer
/// crosses from C at, if it names one.
@derive(Saved)
export type FnSignature = { type_params: List<string>, params: List<SignedParam>, answer: SignedType, answer_width: string? }

/// What a name declared over a shape stands over: its type parameters and the shape, resolved where
/// it's declared. An alias is that shape; a named type is a distinct type over it.
@derive(Saved)
export type NameOver = { type_params: List<string>, of: SignedType }

/// The signature of the fn `file` declares as `name`, absent when it declares none.
@query
export fn fn_signature(engine: QueryEngine, file: SourceFileAddress, name: string) -> FnSignature? {
    let item? = declaring_item(engine, file, name, ItemKind.Fn) else { return null }
    let written? = written_fn(item.store, item.stmts, name) else { return null }
    let signing = Signing {
        engine: engine,
        file: file,
        type_params: written.type_params,
        writer: written.writer,
    }
    FnSignature {
        type_params: written.type_params,
        params: [signing.param(p) for p in written.params],
        answer: signing.signed(widthless(written.ret)!),
        answer_width: width_of(written.ret),
    }
}

/// The type a top-level binding — a `const`, a `collect` or a `state` — `file` declares as `name` is written
/// with, resolved where it's declared; absent when it declares none or writes no type.
@query
export fn binding_type(engine: QueryEngine, file: SourceFileAddress, name: string) -> SignedType? {
    let item? = [ItemKind.Const, ItemKind.Collect, ItemKind.State]
        .find_map((k) -> declaring_item(engine, file, name, k)) else { return null }
    let written = [t! for s in item.stmts if item.store.let_name(s) == name for t in [item.store.binding_ty(s)] if t != null]
        .first()
    if written == null { null } else { Signing { engine: engine, file: file, type_params: [] }.signed(written!) }
}

/// Every fn `file` declares as `name`, signed, in the order they're declared: a verb file may
/// declare one name over several receivers.
@query
export fn fn_signatures(engine: QueryEngine, file: SourceFileAddress, name: string) -> List<
    FnSignature,
> {
    [s! for d in file_declares(engine, file).names if d.name == name && d.kind == ItemKind.Fn for s in [item_fn_signature(engine, file, d.item, name)] if s != null]
}

/// The signature of the fn `name` the item at `at` in `file` declares.
fn item_fn_signature(engine: QueryEngine, file: SourceFileAddress, at: int, name: string) -> FnSignature? {
    let item = read_item(engine, file, at)
    let written? = written_fn(item.store, item.stmts, name) else { return null }
    let signing = Signing {
        engine: engine,
        file: file,
        type_params: written.type_params,
        writer: written.writer,
    }
    FnSignature {
        type_params: written.type_params,
        params: [signing.param(p) for p in written.params],
        answer: signing.signed(widthless(written.ret)!),
        answer_width: width_of(written.ret),
    }
}

/// What the alias `file` declares as `name` stands for, absent when it declares none.
@query
export fn alias_target(engine: QueryEngine, file: SourceFileAddress, name: string) -> NameOver? {
    let item? = declaring_item(engine, file, name, ItemKind.Alias) else { return null }
    let parts? = [a! for s in item.stmts for a in [item.store.alias_parts(s)] if a != null]
        .find(it.name == name) else { return null }
    name_over(engine, file, parts)
}

/// The shape the named type `file` declares as `name` stands over, absent when it declares none.
@query
export fn named_shape(engine: QueryEngine, file: SourceFileAddress, name: string) -> NameOver? {
    let item? = declaring_item(engine, file, name, ItemKind.Named) else { return null }
    let parts? = [n! for s in item.stmts for n in [item.store.named_parts(s)] if n != null]
        .find(it.name == name) else { return null }
    name_over(engine, file, parts)
}

/// What a name `file` declares over a shape stands over.
fn name_over(engine: QueryEngine, file: SourceFileAddress, parts: NamedParts) -> NameOver {
    NameOver {
        type_params: parts.tparams,
        of: Signing { engine: engine, file: file, type_params: parts.tparams }.signed(parts.of),
    }
}

/// The shape the named type `ty` stands over, bound to the arguments it's applied to; absent for any
/// other type, an optional or dynamic one among them.
export fn named_over(engine: QueryEngine, ty: SignedType) -> SignedType? {
    if ty.nullable() || ty.dynamic { return null }
    let at? = declared_at(ty) else { return null }
    let over? = named_shape(engine, at.file, at.name) else { return null }
    if ty.args.length != over.type_params.length { return null }
    over.of.bound(ty.args)
}

/// A record's field: its name, its type resolved where the record is declared, and whether it's a
/// `state` field.
@derive(Saved)
export type SignedField = { name: string, ty: SignedType?, state: bool = false }

/// A record's signature: its type parameters and its fields, in order, a spread's in its place.
@derive(Saved)
export type RecordSignature = { type_params: List<string>, fields: List<SignedField> }

/// The signature of the record (or component) `file` declares as `name`, absent when it declares
/// none.
@query
export fn record_signature(engine: QueryEngine, file: SourceFileAddress, name: string) -> RecordSignature? {
    let item? = record_item(engine, file, name) else { return null }
    let parts? = [p! for s in item.stmts for p in [item.store.struct_parts(s)] if p != null]
        .find(it.name == name) else { return component_signature(engine, file, item, name) }
    let signing = Signing { engine: engine, file: file, type_params: parts.tparams }
    let written = [SignedField {
        name: f.name.of,
        ty: if f.ty == null { null } else { signing.signed(f.ty!) },
        state: f.state,
    } for f in parts.fields]
    let spread = (at: int) -> [g for x in parts.spreads if x.at == at for g in spread_fields(engine, signing.signed(x.of))]
    RecordSignature {
        type_params: parts.tparams,
        fields: [f for at in 0..written.length + 1 for f in spread(at).concat(if at < written.length { [written[at]] } else { [] })],
    }
}

/// A component's signature as a record's: its type parameters, and its fields — its head's, then the
/// fields among its members, in order.
fn component_signature(engine: QueryEngine, file: SourceFileAddress, item: ReadItem, name: string) -> RecordSignature? {
    let parts? = [p! for s in item.stmts for p in [item.store.component_parts(s)] if p != null]
        .find(it.name == name) else { return null }
    let signing = Signing { engine: engine, file: file, type_params: parts.tparams }
    let members = [p! for m in parts.members for p in [field_of_member(m)] if p != null]
    RecordSignature {
        type_params: parts.tparams,
        fields: [SignedField {
            name: p.name.of,
            ty: if p.ty == null { null } else { signing.signed(p.ty!) },
            state: p.state,
        } for p in parts.head.concat(members)],
    }
}

/// A component member that is a field, absent for an event.
fn field_of_member(m: Member) -> Param? { match m { .Field(p) -> p, .Event(_) -> null } }

/// The fields a spread of `spread` brings, its record's own, bound to the arguments it's applied to.
fn spread_fields(engine: QueryEngine, spread: SignedType) -> List<SignedField> {
    let at? = declared_at(spread) else { return [] }
    let record? = record_signature(engine, at.file, at.name) else { return [] }
    [f with { ty: f.ty?.bound(spread.args) } for f in record.fields]
}

/// Where a type is declared: its file and its name there.
type DeclaredAt = { file: SourceFileAddress, name: string }

/// Where the type `ty` names is declared, absent for a type the program doesn't declare.
fn declared_at(ty: SignedType) -> DeclaredAt? {
    match ty.head {
        .Declared(file, name) -> DeclaredAt { file: file, name: name },
        .Owned(_) or .Parameter(_, _) or .Unnamed(_) or .Inferred or .Function or .Never or .Meta -> null,
    }
}

/// A variant: its name and its payloads, each typed where the enum is declared.
@derive(Saved)
export type SignedVariant = { name: string, payloads: List<SignedField> }

/// An enum's signature: its type parameters and its variants, in order.
@derive(Saved)
export type EnumSignature = { type_params: List<string>, variants: List<SignedVariant> }

/// The signature of the enum `file` declares as `name`, written or gathered; absent when it declares
/// none.
@query
export fn enum_signature(engine: QueryEngine, file: SourceFileAddress, name: string) -> EnumSignature? {
    let item? = declaring_item(engine, file, name, ItemKind.Enum) else { return gathered_signature(engine, file, name) }
    let parts? = [p! for s in item.stmts for p in [item.store.enum_parts(s)] if p != null]
        .find(it.name == name) else { return null }
    let signing = Signing { engine: engine, file: file, type_params: parts.tparams }
    EnumSignature {
        type_params: parts.tparams,
        variants: [SignedVariant {
            name: v.name.of,
            payloads: [SignedField {
                name: p.name.of,
                ty: if p.ty == null { null } else { signing.signed(p.ty!) },
            } for p in v.payloads],
        } for v in parts.variants],
    }
}

/// The signature of the `collect enum` `file` declares as `name`: a variant per member it gathers,
/// carrying the member's payload fields. Absent when it declares none, or gathers only once built.
fn gathered_signature(engine: QueryEngine, file: SourceFileAddress, name: string) -> EnumSignature? {
    let item? = declaring_item(engine, file, name, ItemKind.CollectEnum) else { return null }
    let parts? = [p! for s in item.stmts for p in [item.store.collect_enum_parts(s)] if p != null]
        .find(it.name == name) else { return null }
    let members? = gathered(engine, file, parts.kind, parts.scope, parts.order, false) else { return null }
    EnumSignature {
        type_params: [],
        variants: [SignedVariant { name: m.name, payloads: member_payloads(engine, m) } for m in members],
    }
}

/// The item at `at` in `file`, read back.
fn read_item(engine: QueryEngine, file: SourceFileAddress, at: int) -> ReadItem {
    let store = new_node_store()
    let made = generated_at(engine, file, at)
    if made != null {
        return ReadItem {
            store: store,
            stmts: item_read_back(store, PlacedTape { start: 0, tape: made!.tape }),
        }
    }
    ReadItem { store: store, stmts: read_into(engine, file, store, at) }
}

/// The statements of the item at `at` in `file`, read back into `store`.
fn read_into(engine: QueryEngine, file: SourceFileAddress, store: SyntaxArena, at: int) -> List<
    StmtId,
> {
    let item = item_under(engine, file, at)
    item_read_back(
        store,
        PlacedTape { start: item.start, tape: SyntaxTape.read_from(meant_tape(engine, file, item)) },
    )
}

/// The item that declares `name` as `kind` in `file`, read back, absent when none does: a written
/// one, and only where the file writes nothing of that name, one a generator made.
type ReadItem = { store: SyntaxArena, stmts: List<StmtId> }

fn declaring_item(engine: QueryEngine, file: SourceFileAddress, name: string, kind: ItemKind) -> ReadItem? {
    let written = file_declares(engine, file).names.filter(it.name == name)
    let made = if written.is_empty() { generated_declares(engine, file).names.filter(it.name == name) } else { written }
    let declared? = made.find(it.kind == kind) else { return null }
    read_item(engine, file, declared.item)
}

/// The item declaring the record `file` declares as `name`, or the component a record of its fields
/// stands for.
fn record_item(engine: QueryEngine, file: SourceFileAddress, name: string) -> ReadItem? {
    declaring_item(engine, file, name, ItemKind.Record) ?? declaring_item(
        engine,
        file,
        name,
        ItemKind.Component,
    )
}

/// The width a written type names, if it names one.
fn width_of(written: TypeRef?) -> string? {
    let w? = written else { return null }
    if width_named(w.name) != null { w.name } else { null }
}

/// What a fn writes of its signature: its type parameters, its parameters and its answer, and the
/// file whose template wrote it where that isn't its own.
type WrittenFn = { type_params: List<string>, params: List<Param>, ret: TypeRef, writer: SourceFileAddress? }

/// What the fn `name` among `stmts` writes, a declared fn's or an extern's.
fn written_fn(store: SyntaxArena, stmts: List<StmtId>, name: string) -> WrittenFn? {
    for s in stmts {
        let declared = store.fn_parts(s)
        if declared != null && declared!.name == name {
            return WrittenFn {
                type_params: [t.name.of for t in declared!.tparams],
                params: declared!.params,
                ret: declared!.ret,
                writer: written_by(store, s),
            }
        }
        let external = store.extern_parts(s)
        if external != null && external!.name == name {
            return WrittenFn {
                type_params: [],
                params: external!.params,
                ret: external!.ret,
                writer: written_by(store, s),
            }
        }
    }
    null
}

/// Where a signature's types are resolved: its file's top level, under the fn's own type parameters,
/// `Self` as the type a trait's method is asked for, and for a statement a template wrote, the file
/// that wrote it (`writer`): a type the template wrote is read there, one a hole filled where it lands.
type Signing = { engine: QueryEngine, file: SourceFileAddress, type_params: List<string>, self_type: SignedType? = null, writer: SourceFileAddress? = null }

impl Signing {
    fn param(p: Param) -> SignedParam {
        SignedParam {
            name: p.name.of,
            ty: if p.ty == null { null } else { self.signed(widthless(p.ty)!) },
            mutable: p.promises.mutable,
            settled: p.promises.settled,
            width: width_of(p.ty),
            defaulted: p.default != null,
        }
    }

    /// A written type with every name in it resolved, an alias standing for what it names, and a
    /// union's members in one order whatever order they were written in.
    fn signed(written: TypeRef) -> SignedType {
        if written.spliced && self.writer != null { return (self with { writer: null }).signed(written with { spliced: false }) }
        if written.name == "Self" && self.self_type != null && written.applied.is_empty() {
            return self.self_type! with { nulls: if written.optional { 1 } else { 0 }, dynamic: written.dynamic }
        }
        let made = SignedType {
            head: if written.arrow { TypeHead.Function } else { self.head_of(written.name) },
            args: [self.signed(a) for a in written.applied],
            nulls: if written.optional { 1 } else { 0 },
            dynamic: written.dynamic,
            seats: [SignedSeat { ty: self.signed(s.ty), mutable: s.mutable, settled: s.settled } for s in written.seats],
            answer: if written.answer == null { null } else { self.signed(written.answer!) },
            alternatives: sorted_by(
                [self.signed(a) for a in written.alternatives],
                (a, b) -> text_before(a.spelled(), b.spelled()),
            ),
        }
        let target? = self.aliased(made.head) else { return made }
        target.of.bound(made.args) with { nulls: target.of.nulls + made.nulls, dynamic: target.of.dynamic || made.dynamic }
    }

    /// A type named alone, an alias standing for what it names.
    fn named(name: string) -> SignedType {
        let made = headed_type(self.head_of(name))
        let target? = self.aliased(made.head) else { return made }
        target.of
    }

    /// What a head names when it names an alias.
    fn aliased(head: TypeHead) -> NameOver? {
        match head {
            .Declared(file, name) -> alias_target(self.engine, file, name),
            .Owned(_) or .Parameter(_, _) or .Unnamed(_) or .Inferred or .Function or .Never or .Meta -> null,
        }
    }

    /// What a type name names: a type parameter, a type the language owns, or a declaration.
    fn head_of(name: string) -> TypeHead {
        if name == INFERRED { return TypeHead.Inferred }
        let at = self.type_params.index_of(name)
        if at >= 0 { return TypeHead.Parameter(at, name) }
        if builtin_type_name(avra().rows.types, name) || name == RANGE { return TypeHead.Owned(name) }
        let d? = resolved(self.engine, self.writer ?? self.file, Space.Type, name).named() else { return TypeHead.Unnamed(name) }
        TypeHead.Declared(d.file, d.name)
    }
}

/// The type of a range (`(lo..hi)`): the language's own, as the prelude's verbs name it.
const RANGE: string = "Range"

/// The file whose template wrote the statement `s` of `store`; absent for one its own file wrote.
fn written_by(store: SyntaxArena, s: StmtId) -> SourceFileAddress? {
    let origin? = store.stmt_origins.get()[s.index] else { return null }
    template_file(origin.path)
}

impl SignedParam {
    fn spelled() -> string { seat_spelled(self.mutable, self.settled, self.ty?.spelled() ?? "_") }
}

collect listed_signature_facts: List<ListedQuery> = @query_definition in self as ListedQuery { definition: it } by it.name

/// The queries a fn's signature reads through, for a process to hand its engine.
export fn signature_fact_definitions() -> List<QueryDefinition> { definitions_of(listed_signature_facts) }
