//! The driver's code table: which engine cause projects to which
//! kind, under which F-code, meaning what. Kinds attach HERE — the
//! engine stays kind-free — and every projected kind is checked
//! against the assembled registry. Passes never pass through this
//! table: they emit Diag directly with their own registered kinds.
use core.{flatten, Span, span_of}
use @std.errors.{Loc}
use @std.grammar.{Diagnostic, Cause}
use diagnostics.{Diag, DiagCode, error_at, code_for, loc_at, defect_at, defect_kind}

/// One engine cause's projection row.
type EngineCode = { cause: Cause, kind: string, id: string, summary: string }

fn engine_codes() -> List<EngineCode> {
    let rows = table<EngineCode> {
        cause          | kind              | id      | summary
        Cause.Lex      | "lex.error"       | "F0001" | "a character or string the lexer cannot accept"
        Cause.Expected | "parse.expected"  | "F0100" | "the parse needed a token that is not there"
        Cause.Trailing | "parse.trailing"  | "F0101" | "input remains after the program ended"
        Cause.Builder  | "build.failed"    | "F0102" | "a builder rejected its captures"
        Cause.Defect   | "language.defect" | "F0900" | "the language definition itself is defective"
        Cause.Block    | "block.parse"     | "F2082" | "a sublanguage block parses by its grammar"
    }
    rows
}

/// Codes the driver's passes emit.
fn pass_codes() -> List<DiagCode> {
    let rows = table<DiagCode> {
        kind                     | id      | summary
        "resolve.unresolved"     | "F3000" | "a name is not defined"
        "resolve.use_before_def" | "F3001" | "a name is used before its definition"
        "resolve.reserved"       | "F3002" | "the name is a keyword — today's or a future one"
        "lower.no_projection"    | "F0901" | "the program's answer has no text projection"
        "lower.entry_only"       | "F0902" | "run-time statements belong to the entry file"
        "type.type_value"        | "F2014" | "a type name is not a value"
        "resolve.nested_type"    | "F3007" | "type declarations live at the top level"
        "resolve.builtin_type"   | "F3008" | "a built-in type name cannot be redeclared"
        "resolve.paired"         | "F3010" | "a pairing loop names its index and element apart"
        "resolve.runtime_binding" | "F3020" | "a fn body cannot read the top level's run-time bindings"
    }
    rows
}

/// Engine and pass rows as one registry, for assembly and `avra explain`.
export const builtin_codes: List<DiagCode> = [DiagCode { kind: r.kind, id: r.id, summary: r.summary } for r in engine_codes()].concat(pass_codes())

/// The dotted kind an engine cause projects to — a defect when the
/// registry has no row for it.
fn kind_for(c: Cause) -> string {
    engine_codes().find(it.cause == c)?.kind ?? defect_kind
}

/// One engine diagnostic in language currency. A defect names its
/// subject up front; parse messages already carry their rule.
export fn project(d: Diagnostic, file: string?) -> Diag {
    let message = if d.cause is .Defect { in_rule(d) } else { d.message }
    error_at(kind_for(d.cause), loc_at(file, engine_span(d.loc)), message)
}

/// The engine's own Loc, worn as a Span — its `file` is always null
/// (the engine tokenizes no file of its own) and `loc_at` stamps the
/// real one.
fn engine_span(l: Loc?) -> Span? {
    if l == null { return null }
    span_of(l!.lo, l!.hi)
}

/// An engine message with the rule it came from up front.
fn in_rule(d: Diagnostic) -> string {
    "`${d.in_rule}`: ${d.message}"
}

/// Every engine diagnostic projected, then the net: a kind the
/// registry does not know becomes a loud defect of its own.
export fn project_all(ds: List<Diagnostic>, file: string?, codes: List<DiagCode>) -> List<Diag> {
    flatten([netted(project(d, file), codes) for d in ds])
}

/// The projected diagnostic — plus the net's defect when its kind
/// is unregistered.
fn netted(p: Diag, codes: List<DiagCode>) -> List<Diag> {
    if code_for(codes, p.kind) == null {
        return [p, defect_at(null, "`${p.kind}`: diagnostic kind is not registered")]
    }
    [p]
}

/// Assembly problems are language defects regardless of engine cause —
/// their spans reference composed grammar text, not user source.
export fn as_defects(ds: List<Diagnostic>) -> List<Diag> {
    [defect_at(null, in_rule(d)) for d in ds]
}
