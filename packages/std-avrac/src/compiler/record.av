//! THE INTERFACE, REMEMBERED AND REBUILT.
//!
//! A caller needs a declaration's SIGNATURE, never its body — so a whole module can be
//! answered from what a previous build wrote down, without parsing it. That is the waist:
//! what crosses a file boundary is small, and it is the only thing that must persist.
//!
//! THE RECORD IS FLAT TEXT, one line per item, because a reader that needs a parser to
//! answer "what does this module export?" has moved the cost, not removed it. Every line
//! is a KIND and then names and SPELLINGS — `name_of`'s own text, which is the registry's
//! printing projection and therefore the one spelling that can be re-interned.
//!
//! A SHAPE IS CARRIED, NOT JUST A NAME, and that is the whole lesson of the first attempt:
//! a signature naming a USER type cannot be re-interned from its name alone, because a
//! type's identity is a per-run id and its SHAPE lives in its declaration. So a struct
//! carries its fields, an enum its variants, and loading walks the IMPORTS FIRST — a field
//! of another module's type is only internable once that module's types exist.
use core.{new_digest, digest_text, digest_key, digest_of, joined, flatten, sorted_texts, distinct, same_file, same_decl, module_path, ModulePath, TypeRegistry, TypeLit, Type, TypeId, DeclId, FileId, StmtId, ExprId, DeclKind, SeatMark, Span, TypeRef}
use features.{Decl, DeclSig, FnSig, StructSig, EnumSig, NamedSig, Decls, Namespace, SettleRoot, kind_word, spelled_type, scalar_named, DeclFacts}

/// THE NAME A MODULE'S RECORD IS STORED UNDER. The ROOT module's name is EMPTY — it holds
/// the entry file and its neighbours — and an empty name has no shard to live in and no key
/// to be asked for, so it is spelled here rather than special-cased at every reader.
// LICENSED I39: a pure PROJECTION — a module in, the name its record is stored under out.
fn record_key(ws: Workspace, m: ModulePath) -> string {
    node_key(Stored.Sig, [CACHE_FORMAT, ws.root, m.text()])
}

/// ONE READ PER RECORD PER BUILD. The record for a module, from the cache when this
/// build has already asked, else from the store. An absent record is cached too, so a
/// module with no record is asked ONCE rather than at every consumer.
// LICENSED I39: a Workspace method here trips the compiler's declaration-order defect (F2010).
fn record_cached(mut ws: Workspace, store: Store, m: ModulePath) -> string {
    let key = record_key(ws, m)
    if ws.record_asked.get(key) != null { return ws.record_texts.get(key) ?? "" }
    let text = store.get(Stored.Sig, key) ?? ""
    ws.record_texts.set(key, text)
    ws.record_asked.set(key, true)
    if text != "" { ws.record_lines.set(key, text.split("\n")) }
    text
}

/// WHERE ONE FILE STANDS IN ITS MODULE'S RECORD: its `file` line, and the run of its
/// declaration lines — a record lists a file's declarations together. Asked per
/// file, a scan of the whole record is the module's lines squared.
type Placed = { file: List<string>, lo: int, hi: int }

/// A record's files, each placed — memoized for the build.
// LICENSED I39: see `record_cached` — a Workspace method trips the F2010 defect.
fn record_places(mut ws: Workspace, store: Store, m: ModulePath) -> Map<string, Placed> {
    let key = record_key(ws, m)
    let known: Map<string, Placed>? = ws.record_places.get(key)
    if known != null { return known! }
    let made = places_of(record_fields(ws, store, m))
    ws.record_places.set(key, made)
    made
}

fn places_of(fields: List<List<string>>) -> Map<string, Placed> {
    mut out: Map<string, Placed> = {}
    for j, parts in fields {
        if parts.length >= 3 && parts[0] == "file" {
            out.set(parts[1], Placed { file: parts, lo: 0, hi: 0 })
        } else if declares(parts) && parts.length > 1 {
            let at = out.get(parts[1]) ?? Placed { file: [], lo: 0, hi: 0 }
            out.set(parts[1], at with { lo: if at.hi == 0 { j } else { at.lo }, hi: j + 1 })
        }
    }
    out
}

/// One file's declaration lines.
fn file_rows(fields: List<List<string>>, at: Placed?) -> List<List<string>> {
    if at == null { [] } else { fields.slice(at!.lo, at!.hi) }
}

/// THE RECORD AS LINES — cached, so every phase that needs them gets a pre-split list.
// LICENSED I39: see `record_cached` — a Workspace method trips the F2010 defect.
fn record_lines(mut ws: Workspace, store: Store, m: ModulePath) -> List<string> {
    let key = record_key(ws, m)
    let cached = ws.record_lines.get(key)
    if cached != null { return cached! }
    let text = record_cached(ws, store, m)
    if text == "" { return [] }
    ws.record_lines.get(key) ?? []
}

/// THE RECORD AS TAB-SPLIT FIELDS — each line split once per module, so mint and fill
/// get pre-parsed fields without a per-declaration tab split.
// LICENSED I39: see `record_cached` — a Workspace method trips the F2010 defect.
fn record_fields(mut ws: Workspace, store: Store, m: ModulePath) -> List<List<string>> {
    let key = record_key(ws, m)
    let cached = ws.record_fields.get(key)
    if cached != null { return cached! }
    let fields = [read_fields(line) for line in record_lines(ws, store, m)]
    ws.record_fields.set(key, fields)
    fields
}

/// A NAME IS ANY TEXT — a case's is a sentence — so the two name fields spell the
/// record's own separators out, and a tab or a line break in one stays one field.
fn field_text(s: string) -> string { s.replace("\\", "\\\\").replace("\t", "\\t").replace("\n", "\\n") }

/// `field_text`, read back.
fn text_of_field(s: string) -> string {
    if !s.contains("\\") { return s }
    mut out = ""
    mut i = 0
    while i < s.length {
        let escaped = s.char_code(i) == 92 && i + 1 < s.length
        let at = if escaped { i + 1 } else { i }
        let c = s.substring(at, at + 1)
        out = out + if !escaped { c } else { match c { "t" -> "\t", "n" -> "\n", _ -> c } }
        i = at + 1
    }
    out
}

/// One record line as its fields, the two NAME fields read back.
fn read_fields(line: string) -> List<string> {
    [if j == 5 || j == 7 { text_of_field(x) } else { x } for j, x in line.split("\t")]
}

/// A record as this build now knows it: its words, its lines and their fields.
// LICENSED I39: see `record_cached` — a Workspace method trips the F2010 defect.
fn record_known(mut ws: Workspace, m: ModulePath, text: string) {
    let key = record_key(ws, m)
    let lines = text.split("\n")
    ws.record_texts.set(key, text)
    ws.record_asked.set(key, true)
    ws.record_lines.set(key, lines)
    let fields = [read_fields(line) for line in lines]
    ws.record_fields.set(key, fields)
    ws.record_places.set(key, places_of(fields))
}

/// What OTHER modules' keys read of a record: its interface digest and its imports.
fn seen_part(text: string) -> string {
    joined([line for line in text.split("\n") if line.starts_with("iface\t") || line.starts_with("import\t")], "\n")
}

/// A MODULE'S INTERFACE DIGEST, memoized for the build.
// LICENSED I39: see `record_cached` — a Workspace method trips the F2010 defect.
fn bytes_key_cached(mut ws: Workspace, store: Store, m: ModulePath) -> string {
    let known: string? = ws.bytes_keys.get(m.text())
    if known != null { return known! }
    let made = bytes_key(ws, store, m)
    ws.bytes_keys.set(m.text(), made)
    made
}

/// ONE FILE'S OBJECT KEY, memoized for the build. The key is the module together with
/// the file's path, so a module-level ask and a file-level ask do not collide.
// LICENSED I39: see `record_cached` — a Workspace method trips the F2010 defect.
fn obj_key_cached(mut ws: Workspace, store: Store, m: ModulePath, path: string) -> string {
    let key = "${m.text()}\t${path}"
    let known: string? = ws.object_keys.get(key)
    if known != null { return known! }
    let made = obj_key_of(ws, store, m, path)
    ws.object_keys.set(key, made)
    made
}

/// A TYPE'S SHAPE, as one line — the declaration it belongs to, and what it stands over.
/// A NAMED type's line carries the shape it IS, so re-interning reproduces the same type
/// rather than a fresh one that merely wears the name.
///
/// THE SEPARATORS ARE `;` AND `|`, NEVER A SPACE: a spelling CONTAINS spaces
/// (`dyn Runnable`, `fn(a) -> b`), so a space-joined list splits a single type into
/// fields and invents declarations (`body:dyn Runnable` became `body:dyn` and a field
/// named `Runnable`). Neither `;` nor `|` is in the type grammar.
// LICENSED I39: a pure PROJECTION — a registry and a declaration's signature in, its line out.
fn shape_line(ws: Workspace, s: DeclSig, layout: string) -> string {
    match s {
        .Record(r) -> "${layout}\t${joined([r.names[i] + ":" + ws.decls.type_wire( r.types[i]) for i in 0..r.names.length], ";")}",
        .Enum(e) -> "enum\t${joined([e.names[i] + ":" + joined([ws.decls.type_wire( t) for t in e.payloads[i]], "|") for i in 0..e.names.length], ";")}",
        .Named(n) -> "named\t${ws.decls.type_wire( n.of)}",
        .Fn(f) -> "fn\t${joined([ws.decls.type_wire( t) for t in f.params], ";")}\t${ws.decls.type_wire( f.ret)}",
    }
}



type WireType = { id: TypeId, next: int }



/// EVERY NAME A MODULE EXPORTS — its imports first, so a reader can walk the closure in
/// the order that makes each shape internable.
// LICENSED I39: a pure PROJECTION — the workspace, a store and a module in, its record out.
/// A seat with neither promise written.
const no_seat_mark: SeatMark = SeatMark { mutable: false, settled: false }

/// Whether a declaration stands among a file's top-level items.
fn on_top(top: List<DeclId>, d: DeclId) -> bool { top.any(same_decl(it, d)) }


/// A MODULE'S INTERFACE, AS ONE DIGEST — the identity a dependent keys on. It covers what
/// a caller can SEE (names, kinds, visibility, type parameters, bounds, seat names, and
/// each signature's type wire and seat marks) and NOTHING a build recorded: the spans a
/// whitespace edit moves, the statement/expression indices, and the `writes` bits the
/// receivers pass recomputes. A body edit therefore does not move a dependent's key; a
/// seat or shape change does, because both are in the digest.
// LICENSED I39: a pure PROJECTION — a module's declaration lines in, its interface digest out.
fn iface_digest(items: List<string>) -> string {
    digest_of(joined([interface_form(line) for line in sorted_texts(items)], "\n"))
}

/// ONE DECLARATION'S CONTRACT, as one line: the fields a caller can see, and never the
/// span, the statement/expression indices, or the `writes` bits.
// LICENSED I39: a pure PROJECTION — a record line in, its contract out.
fn interface_form(line: string) -> string {
    let p = line.split("\t")
    if p.length < 13 { return "" }
    let facts = p[12].split(";")
    let stable = if facts.length >= 10 { joined([facts[0], facts[1], facts[2], facts[5], facts[6], facts[7], facts[8], facts[9]], ";") } else if facts.length >= 9 { joined([facts[0], facts[1], facts[2], facts[5], facts[6], facts[7], facts[8]], ";") } else if facts.length >= 8 { joined([facts[0], facts[1], facts[2], facts[5], facts[6], facts[7]], ";") } else { p[12] }
    let payload = if p.length > 13 { p[13] } else { "" }
    let seats = if p.length > 15 { joined([p[14], p[15]], ";") } else { "" }
    joined([p[0], p[2], p[4], p[5], p[6], p[7], p[8], p[11], stable, payload, seats], "|")
}

/// A record's declaration lines, by the file each names.
fn lines_by_file(lines: List<string>) -> Map<string, List<string>> {
    mut out: Map<string, List<string>> = {}
    for line in lines {
        let path = named_file(line)
        if path != "" { out.set(path, (out.get(path) ?? []).concat([line])) }
    }
    out
}

/// The path a record line names, or "" — the second column, and nothing for a header line.
fn named_file(line: string) -> string {
    if line.starts_with("import\t") || line.starts_with("bytes\t") || line.starts_with("iface\t") || line.starts_with("file\t") { return "" }
    let parts = line.split("\t")
    if parts.length < 2 { return "" }
    parts[1]
}



/// A DECLARATION'S FACTS, as the record's block — the encoder of `facts_unblocked`, and
/// the pair is ONE unit. `split` DROPS a trailing empty field, so a list is encoded as
/// `<count>~<items…>`: an empty list is `0`, never an empty field that would shift its
/// neighbour. Neither `;` nor `~` is in a type spelling or an identifier.
fn facts_block(f: DeclFacts) -> string {
    let slo = f.span?.lo ?? (0 - 1)
    let shi = f.span?.hi ?? (0 - 1)
    "${if f.external { "1" } else { "0" }};${if f.stat { "1" } else { "0" }};${if f.is_grammar { "1" } else { "0" }};${slo};${shi};${list_field(f.tparams)};${list_field(f.bounds)};${list_field(f.seats)};${list_field(f.host)};${if f.annotated { "1" } else { "0" }};${f.of};${f.fingerprint()}"
}

/// One string list as `<count>~<len>:<item>…`. EACH ELEMENT CARRIES ITS LENGTH, because
/// a bare `~`-join LOSES a trailing EMPTY element — `split` drops it — and a facts list
/// legitimately holds `""` (an unconstrained bound, an unwritten width). The old form
/// decoded `[""]` as `[]`: benign where the only reader returns `""` either way, and a
/// silent loss the moment a reader distinguishes them.
fn list_field(xs: List<string>) -> string { "${xs.length}~${joined(["${x.length}:${x}" for x in xs], "~")}" }

/// The inverse — `"0"` and `"0~"` both read as the empty list, and a length-prefixed
/// element survives whether or not it is empty.
fn read_list(field: string) -> List<string> {
    let parts = field.split("~")
    if parts.length < 2 { return [] }
    [item_of_field(p) for p in parts.slice(1, parts.length)]
}

/// One list element: its length prefix dropped, the value whole.
fn item_of_field(p: string) -> string {
    let at = p.index_of(":")
    if at < 0 { return p }
    p.substring(at + 1, p.length)
}

/// The decoder — a block it cannot read makes the whole RECORD undecodable, so the module
/// is a miss rather than a declaration whose facts are guessed. THE LAST FIELD IS THE
/// VALUE'S OWN FINGERPRINT: it is recomputed from what was decoded, so a field the
/// writer added but this reader does not know makes the two disagree and the record is
/// REFUSED — drift is a rebuild, never a declaration wearing a default.
fn facts_unblocked(block: string) -> DeclFacts? {
    let p = block.split(";")
    if p.length < 12 { return null }
    let slo? = wire_number(p[3]) else { return null }
    let shi? = wire_number(p[4]) else { return null }
    let want? = wire_number(p[11]) else { return null }
    let facts = DeclFacts {
        external: p[0] == "1",
        stat: p[1] == "1",
        is_grammar: p[2] == "1",
        span: if slo < 0 { null } else { Span { lo: slo, hi: shi } },
        tparams: read_list(p[5]),
        bounds: read_list(p[6]),
        seats: read_list(p[7]),
        host: read_list(p[8]),
        annotated: p[9] == "1",
        of: p[10],
    }
    if facts.fingerprint() != want { return null }
    facts
}

/// REMEMBER EVERY MODULE'S INTERFACE, once the build has computed it.
// LICENSED I39: THE RECORD STEP — a workspace, a store and a module list in, the records written.
export fn keep_interfaces(mut ws: Workspace, store: Store, modules: List<ModulePath>) {
    mut seen_moved = false
    for m in modules {
        let prior = record_cached(ws, store, m)
        let made = ws.record_of(store, m)
        // a record is keyed by its module's NAME: a write is owed when its words moved
        if made != prior {
            let _ = store.keep(Stored.Sig, record_key(ws, m), made, [])
            record_known(ws, m, made)
            if seen_part(made) != seen_part(prior) { seen_moved = true }
        }
    }
    // A BODY EDIT MOVES A RECORD'S `file` LINES, and with them no key but its own
    // files'. Only a moved interface or import list moves what other modules see.
    ws.object_keys = {}
    if seen_moved {
        ws.bytes_keys = {}
        ws.view_keys = {}
        ws.import_lists = {}
    }
}

// ── REBUILDING ──────────────────────────────────────────────────────

/// THE DECLARATIONS A MODULE'S RECORD DESCRIBES, minted into the workspace as if its file
/// had been parsed. THE IMPORTS COME FIRST: a shape may name another module's type, and
/// `by_name` can only answer for a type that exists.
///
/// A MINTED DECLARATION HAS NO BODY AND NO STORE, which is safe for the same reason a
/// `.Builtin` is: nothing lowers a module that was not read. The day something does, these
/// rows are lies.
// LICENSED I39: THE LOADER — a workspace, a store and a module in, the count minted out.
export fn load_interface(mut ws: Workspace, store: Store, m: ModulePath, entry: string?, want: Want) -> int {
    let key = record_key(ws, m)
    if ws.loaded_records.get(key) != null { return 0 }
    ws.loaded_records.set(key, true)
    let text = record_cached(ws, store, m)
    if text == "" { return 0 }
    let fields = record_fields(ws, store, m)
    // FAIL CLOSED: a record the decoder cannot rebuild WHOLE holds NOTHING, and
    // its files parse. A partial hold is how a declaration goes missing — the
    // cache must be a miss rather than a lie.
    //
    // AND A RECORD NAMING A FILE THE MODULE NO LONGER HAS is a previous tree's: minting
    // its declarations asks the host for a source that is gone.
    let here = ws.module_files(m)
    if !record_complete(fields) || fields.any((parts) -> declares(parts) && !here.contains(parts[1])) { return 0 }
    for parts in fields {
        if parts[0] == "import" {
            // the ROOT module's name is empty, and `split` drops a trailing empty field
            let imp = module_path((if parts.length > 1 { parts[1] } else { "" }).split("."))
            let key = imp.package()
            if key != null { ws.ensure_package(key!) }
            let _ = load_interface(ws, store, imp, entry, want)
        }
    }
    // NAMES BEFORE SHAPES: every declaration is minted first, so a shape naming a type in
    // this same module finds it.
    let places = record_places(ws, store, m)
    for f in ws.module_files(m) {
        // EVERY FILE OF THE MODULE IS REGISTERED HERE, held or not: a file the workspace
        // never met is neither parsed nor linked, and a home no parsed file imports is
        // met nowhere else.
        let _ = ws.file_id(f)
        // the entry is read: its law over every other file is spoken from its parse
        let is_entry = entry != null && f == entry!
        // a hold is ASKED here and settled once every module is met: a file that
        // will be read runs bodies at compile time, and those files are read with it
        let at: Placed? = places.get(f)
        let rows = file_rows(fields, at)
        let asked = !is_entry && ws.homes.get(f) == null && written_from(at, ws.text_digest(f)) && ws.stands_in(store, obj_key_cached(ws, store, m, f), want) && ws.const_rows_ready(store, m, f, rows) && holdable(rows)
        if asked { ws.hold_asked.push(f) } else { ws.read_with = ws.read_with.concat(kept_runs(at)) }
    }
    // THE DECLARATIONS COME FROM `admit_all`, which parses and mints every file — so this
    // pass only REMEMBERS the module for the shape pass. One parser, one minter.
    ws.held_order.push(m)
    fields.length
}

/// PHASE ONE: mint every held module's declarations from its record — a no-op for a
/// WRITTEN declaration `admit` already made (same identity key), a fresh mint for a
/// derive-GENERATED one. Runs AFTER every file is admitted, so the two never collide.
// LICENSED I39: THE LOADER'S FIRST HALF — the workspace and a store in, nothing out.
export fn mint_held_interfaces(mut ws: Workspace, store: Store) {
    for m in ws.held_order {
        let fields = record_fields(ws, store, m)
        let places = record_places(ws, store, m)
        for path in ws.module_files(m) { if ws.decls.held.get(path) != null { ws.mint_file(path, file_rows(fields, places.get(path))) } }
    }
    for m in ws.held_order {
        for parts in record_fields(ws, store, m) { if speaks(ws, parts) { ws.link_identity( parts) } }
    }
}

/// PHASE TWO: fill every held module's shapes, once ALL its names exist. A shape names
/// other types, so the registry must answer for every module before any shape is read.
// LICENSED I39: THE LOADER'S SECOND HALF — the workspace and a store in, nothing out.
export fn fill_interfaces(mut ws: Workspace, store: Store) {
    for m in ws.held_order {
        for parts in record_fields(ws, store, m) { if speaks(ws, parts) { ws.fill_shape( store, m, parts) } }
    }
}

/// WHETHER A RECORD'S LINES FOR A FILE WERE WRITTEN FROM THIS TEXT. A record is kept
/// under its module's NAME and an object under its file's CONTENT, so two programs share
/// the object and not the record: one that holds a file by an object another stored
/// would read lines it wrote itself, before the edit. The record says what it read.
fn written_from(at: Placed?, print: string) -> bool {
    at != null && at!.file.length >= 3 && at!.file[2] == print
}

/// A RECORD LINE SPEAKS FOR A HELD FILE ALONE. A record is a MODULE's and a hold is a
/// FILE's: a file that parsed declares itself, and a line written before its edit would
/// lay the shape it HAD over the one it has.
// LICENSED I39: a pure PREDICATE — the workspace and a record line in, one answer out.
fn speaks(ws: Workspace, parts: List<string>) -> bool { declares(parts) && ws.decls.held.get(parts[1]) != null }

/// Whether a record line is a DECLARATION's — the rest say what the module imports and digests to.
fn declares(parts: List<string>) -> bool { parts[0] != "import" && parts[0] != "bytes" && parts[0] != "iface" && parts[0] != "file" }

/// WHETHER A RECORD CAN BE REBUILT WHOLE — a total check, run BEFORE any file is
/// held, over the SAME decoder the mint uses. A field the writer adds that this
/// reader does not know makes the record short, and a short record refuses the
/// module rather than contributing a declaration nobody can see.
// LICENSED I39: a pure PREDICATE — a record's lines in, whether all of them decode out.
fn record_complete(fields: List<List<string>>) -> bool {
    // THE ORDINALS MUST BE CONTIGUOUS PER FILE, 0..n-1 IN ORDER: the mint appends each
    // held declaration to its file, so a hole is a record where a declaration would be
    // silently missing. Checking it HERE refuses the whole module instead of truncating.
    mut seen: Map<string, int> = {}
    for parts in fields {
        if declares(parts) {
            if !decodable(parts) { return false }
            let ordinal? = wire_number(parts[2]) else { return false }
            let want: int = seen.get(parts[1]) ?? 0
            if ordinal != want { return false }
            seen.set(parts[1], want + 1)
        }
    }
    true
}

/// Whether a line names nothing where a name is owed: a CASE's name is any text,
/// the empty one included.
fn nameless(parts: List<string>) -> bool { parts[5].is_empty() && parts[6] != "case" }

/// WHETHER ONE RECORD LINE DECODES — the guard half of the decoder, so a line the
/// mint would silently skip is caught here and the whole record is refused.
fn decodable(parts: List<string>) -> bool {
    if parts.length < 13 || nameless(parts) { return false }
    if wire_number(parts[2]) == null || wire_number(parts[3]) == null { return false }
    if wire_number(parts[8]) == null || wire_number(parts[10]) == null { return false }
    declared_kind(parts[0], parts[6]) != null
}

/// WHETHER A FILE MAY BE HELD — a grammar record's spec and an extern fn's raw seat
/// spellings are their own parse and are not in the interface, so a file that declares
/// either is a MISS and parses. The honest boundary: the interface carries what it
/// carries, and a fact it cannot is a rebuild, not a guess.

fn holdable(rows: List<List<string>>) -> bool {
    for parts in rows {
        if parts.length >= 13 {
            let f? = facts_unblocked(parts[12]) else { return false }
            if f.is_grammar { return false }
        }
    }
    true
}






/// A SEAT'S PROMISE as one character — the record's spelling of `SeatMark`.
fn mark_word(m: SeatMark) -> string {
    if m.mutable { "m" } else if m.settled { "s" } else { "-" }
}

/// The inverse — an unknown word is the plain unwritten seat, the shape of every
/// seat that promises nothing.
fn mark_of_word(w: string) -> SeatMark {
    if w == "m" { SeatMark { mutable: true, settled: false } } else if w == "s" { SeatMark { mutable: false, settled: true } } else { no_seat_mark }
}




/// A NOMINAL type's declaration — the one place the registry knows which types a program
/// declared. `rest -> null` is the licensed remainder: a structural or scalar shape names
/// no declaration, and a future nominal variant is added here.
fn nominal_decl(types: TypeRegistry, id: TypeId) -> DeclId? {
    match types.shape_of(id) {
        .Struct(d, _) -> d,
        .Enum(d, _) -> d,
        .App(d, _, _) -> d,
        .Dyn(d, _) -> d,
        .TypeName(d, _) -> d,
        .Var(d, _, _) -> d,
        rest -> null,
    }
}

/// A field's NAME, from its `name:spelling` pair.
fn field_name(pair: string) -> string { pair.split(":")[0] }

/// A field's SPELLING, from the same pair — the part `by_name` is asked for.
fn name_of_field(pair: string) -> string {
    let at = pair.index_of(":")
    if at < 0 { return pair }
    pair.substring(at + 1, pair.length)
}

/// A variant's PAYLOAD, from its `name:t1,t2` pair — no types when it carries none.
// LICENSED I39: a RECORD DECODER — a workspace and one arm's text in, the payload's types out.
fn payload_of(mut ws: Workspace, owner: DeclId, arm: string) -> List<TypeId> {
    [ws.interface_type( owner, t) for t in name_of_field(arm).split("|") if t != ""]
}

/// THE DECLARATION KIND a record's word names. A record line says which SHAPE it carries,
/// and the kind is that shape's own — so `struct` is a `Record` and `enum` an `Enum`,
/// never a generic "type" the tree does not have.
fn declared_kind(shape: string, word: string) -> DeclKind? {
    if shape == "struct" || shape == "boxed" { return .Record }
    if shape == "named" { return .Named }
    match word {
        "fn" -> .Fn,
        "enum" -> .Enum,
        "trait" -> .Trait,
        "syntax" -> .Syntax,
        "method" -> .Method,
        "default" -> .Default,
        "impl" -> .Impl,
        "main" -> .Main,
        "case" -> .Case,
        "const" -> .Const,
        "builtin" -> .Builtin,
        _ -> null,
    }
}



// ── THE OBJECT'S KEY, FROM INPUTS ───────────────────────────────────

/// A MODULE'S OBJECT KEY, COMPUTED FROM INPUTS ALONE — its own sources, and the records of
/// the modules it imports. NOTHING IS PARSED and NOTHING IS EMITTED to state it, which is
/// the whole point: the first attempt keyed an object by its own content, and to learn that
/// a module had not moved you had to EMIT it, so the key cost the work it exists to skip
/// (measured: 83s cold against 43s, 57s on an edit against 28s).
///
/// THE RECORD'S OWN DIGEST STANDS IN FOR THE INTERFACE, so a caller's key moves when what
/// it sees moves — a signature, a shape, anything — without a walk over the import closure.
// LICENSED I39: a KEY DERIVATION — the workspace, a store and a module in, the object's key out.
export fn obj_key(mut ws: Workspace, store: Store, m: ModulePath) -> string {
    obj_key_of(ws, store, m, "")
}

/// ONE MODULE'S BYTES — a digest over every file it holds, in path order. Parse-free.
/// This is the identity a dependent keys on, and it is STORED in the module's record so
/// a later build can read it without admitting the module's package: computing it from
/// the files works only when the package is already admitted, which at the top of a
/// build it is not.
// LICENSED I39: a KEY DERIVATION — a workspace and a module in, the digest of its bytes out.
export fn module_bytes(mut ws: Workspace, m: ModulePath) -> string {
    mut d = new_digest()
    d = digest_text(d, CACHE_FORMAT)
    for path in sorted_texts(ws.module_files(m)) {
        d = digest_text(d, path)
        d = digest_text(d, ws.text_digest(path))
    }
    digest_key(d)
}

/// A MODULE'S OWN BYTES, FROM ITS RECORD — the parse-free read, and the one a dependent
/// keys on. A record's DECLARATION text is not an interface (it carries the receivers
/// pass's written bits, which move without a contract moving); the bytes line is.
// LICENSED I39: a KEY DERIVATION — a store and a module in, its stored bytes digest out.
export fn bytes_key(mut ws: Workspace, store: Store, m: ModulePath) -> string {
    let rec = record_cached(ws, store, m)
    for line in rec.split("\n") {
        if line.starts_with("iface\t") { return line.substring(6, line.length) }
    }
    // A record written before the interface digest existed: fall back to the module's
    // bytes, which is sound (it over-invalidates, never under).
    module_bytes(ws, m)
}

/// THE SAME KEY, FOR ONE FILE OF A MODULE. The module's record supplies the imports — what
/// the file can SEE — and each import contributes ITS OWN BYTES' digest, never its record's
/// text: a key is a function of the program's meaning, never of a projection that churns.
// LICENSED I39: a KEY DERIVATION — a workspace, a store, a module and a file in, the object's key out.
export fn obj_key_of(mut ws: Workspace, store: Store, m: ModulePath, path: string) -> string {
    mut d = new_digest()
    d = digest_text(d, CACHE_FORMAT)
    d = digest_text(d, m.text())
    if path != "" {
        d = digest_text(d, path)
        d = digest_text(d, ws.text_digest(path))
    }
    // an object that bakes a compile-time run's answer in reads the TEXT the run read
    for ran in kept_runs(record_places(ws, store, m).get(path)) { d = digest_text(d, if ws.host.exists(ran) { ws.text_digest(ran) } else { "" }) }
    digest_key(digest_text(d, view_key(ws, store, m)))
}

/// The files a record says one file's compile-time runs read.
fn kept_runs(at: Placed?) -> List<string> {
    if at == null || at!.file.length < 4 { [] } else { at!.file[3].split("|") }
}

/// THE INTERFACES A MODULE'S FILES SEE, as one digest — memoized for the build, since
/// every file of a module sees the same ones.
// LICENSED I39: see `record_cached` — a Workspace method trips the F2010 defect.
fn view_key(mut ws: Workspace, store: Store, m: ModulePath) -> string {
    let known: string? = ws.view_keys.get(m.text())
    if known != null { return known! }
    let made = digest_of(joined([bytes_key_cached(ws, store, module_path(dep.split("."))) for dep in seen_modules(ws, store, m)], "\n"))
    ws.view_keys.set(m.text(), made)
    made
}

/// The modules a module's record says it imports — memoized for the build.
// LICENSED I39: see `record_cached` — a Workspace method trips the F2010 defect.
fn imports_kept(mut ws: Workspace, store: Store, name: string) -> List<string> {
    let known: List<string>? = ws.import_lists.get(name)
    if known != null { return known! }
    let made = [line.substring(7, line.length) for line in record_lines(ws, store, module_path(name.split("."))) if line.starts_with("import\t")]
    ws.import_lists.set(name, made)
    made
}

/// EVERY MODULE A FILE OF `m` CAN SEE A TYPE OF: its own — a sibling file's names need no
/// import — and the closure of its imports, since a type reaches a body through a
/// signature the body never names. In name order.
// LICENSED I39: a pure PROJECTION — the workspace, a store and a module in, the modules it sees out.
fn seen_modules(mut ws: Workspace, store: Store, m: ModulePath) -> List<string> {
    // LICENSED I16: a WORKLIST — the list grows while it is walked
    mut seen: List<string> = [m.text()]
    mut at = 0
    while at < seen.length {
        for dep in imports_kept(ws, store, seen[at]) {
            if !seen.contains(dep) { seen.push(dep) }
        }
        at = at + 1
    }
    sorted_texts(seen)
}

/// EVERY ROOT MODULE A PREVIOUS BUILD WROTE DOWN — where the held walk starts. Whether
/// a FILE is held is `load_interface`'s question, asked per file of its object and its
/// asks; a module is walked for its record alone, because the entry's object is keyed
/// by its own bytes and a root that is only an entry has no other.
// LICENSED I39: THE HELD WALK — a workspace and a store in, the modules worth loading out.
export fn held_modules(mut ws: Workspace, store: Store) -> List<ModulePath> {
    [m for m in [module_path(n.split(".")) for n in distinct([ws.module_of(p) for p in ws.root_files()])] if record_cached(ws, store, m) != ""]
}

/// EVERY HELD FILE, by path — ONE derivation for the stubs, the objects and the
/// interface writes, so no list of modules can disagree with the files actually held.
// LICENSED I39: a pure PROJECTION — the workspace in, its held files' paths out.
export fn held_paths(ws: Workspace) -> List<string> {
    [ws.decls.file(fi.id).path for fi in ws.decls.files if ws.is_held(fi.id)]
}

// ── STUB BODIES FOR HELD FUNCTIONS ──────────────────────────────────

/// A HELD FN, AS A DECLARATION THE EMITTER CAN SEE. A body that is never LOWED into
/// instructions is still a NAME and a SIGNATURE, and that is exactly what a caller's module
/// needs: `emit_module` declares what its bodies NAME, so a call to a held function finds a
/// declaration. IT IS NEVER DEFINED, because the file it belongs to is never emitted — its
/// machine code comes from the object the store already holds.
///
/// WITHOUT THIS A FRESH MODULE THAT CALLS A HELD ONE HAS NOTHING TO DECLARE THE CALL
/// AGAINST: `main.av` calling `twice` whose module was skipped died in the link, and that
/// was the one thing between the skip and a sub-second edit.
///
/// AND A HELD FILE MAY BE AN IMPORT — the modules `held_modules` walks are the ROOT's,
/// while `load_interface` holds imported files too — so the stub set is EVERY held file,
/// never the root's module list.
// LICENSED I39: A STUB — the workspace in, the bodies every held file lets a caller name.
export fn held_stubs(mut ws: Workspace) -> List<Body> {
    mut out: List<Body> = []
    for d in ws.decls.decls {
        let stub = if ws.is_held(d.file) { ws.stub_of( d) } else { null }
        if stub != null { out.push(stub!) }
    }
    // a held file's top level is a body of its object too
    out.concat([Body { name: program_symbol(path), params: [], ret: ws.decls.types.type(int), gives: null, ins: [], reg_types: [], file: ws.file_id(path) } for path in held_paths(ws)])
}

