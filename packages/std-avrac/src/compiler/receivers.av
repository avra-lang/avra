//! THE SEATS PASS — which seats a fn WRITES THROUGH: a method's
//! receiver (seat 0), and every `mut` parameter. A seat is written
//! when the body assigns to a place rooted in it, calls a mutating
//! vocabulary method on one, hands one to a written seat of another
//! fn, or calls a writing method on one — the last two make this a
//! growing-set FIXPOINT over per-fn summaries. A reader of a fn's
//! bits solves it over that fn's CALL-GRAPH CLOSURE alone
//! (`writes_of`), never the whole program, so a bystander's edit
//! moves nothing; `receivers()` is the whole-program witness the
//! `Receivers` family still owns, read by no write-bit reader.
//! A summary reads the RESOLVED body and the DECLARATIONS alone:
//! every seat-rooted place has a declared type along its whole path,
//! so no body is typed to learn it. Asked through the declaration
//! table's hook, remembered by the kernel (ROADMAP: the inout
//! receiver).
use core.{
    DeclId,
    Expr,
    ExprId,
    TypeId,
    Type,
    SyntaxArena,
    MethodParts,
    fp,
    fp_list,
    fp_str,
    mix_final,
    touch,
    filled,
    SeatMark,
    mut_mark,
    same_decl,
}
use features.{NameFacts, Decls, Decl, bound_decl_of, nothing, property_row}
use @std.meta.{bracket}
use @std.relation.engine.{Table, new_table, FixpointRefusal, spoken as fixpoint_spoken}
use compiler.families.{Family}

/// One fn's own evidence: which of its seats the body writes
/// directly, and the flows from its seats into other fns' seats —
/// the fixpoint's edges.
type Summary = { own: List<bool>, edges: List<Flow> }

/// One solve's member set with each unsettled member's summary already
/// walked, so the fixpoint's own contribution reads the SAME summary the
/// member walk built — a body is walked once, never once per turn.
type Closure = { members: List<DeclId>, sums: Table<Summary> }

/// A place rooted in seat `from` fills seat `to` of `callee`.
type Flow = { from: int, callee: DeclId, to: int }

impl Workspace {
    /// The pass: every fn's written seats, settled once per program
    /// state. Declared bits (`mut fn`, a `mut` seat, a trait's word)
    /// are recorded at declare; this pass adds the INFERRED ones.
    fn receivers() -> int {
        // A WHOLE-PROGRAM PASS MUST NOT RUN INSIDE A RESOLVE: a lifted
        // call runs inside one, and every sig this pass asks of the
        // file in flight would be computed from a smaller view and
        // kept. The declared bits answer until the resolve closes;
        // the pass runs whole at the first ask after.
        if self.db.family_active(Family.Resolved.ordinal) { return 0 }
        let k = key(Family.Receivers, 0)
        if !(self.db.ask(k) is .Compute) { return 0 }
        self.db.begin(k)
        // A HELD BODY IS NOT SURVEYED: its store is gone, and its settled bits were
        // carried in the interface (`record_line`), replayed at mint. The pass settles
        // the files that MOVED, and a call to a held fn reads its recorded bits.
        let fns = [x.id for x in self.decls.all_decls() if seated(x) && !self.is_held(x.file)]
        for d in fns { touch(self.sig(d)) }
        self.decls.clear_written()
        let sums = [self.summary(d) for d in fns]
        self.decls.settle_writers(fns, sums)
        self.db.settle(k, self.writers_print(fns))
        fns.length
    }

    /// One declaration's written seats, as the fixpoint settled them: the closure of `d`
    /// through its call graph and never the whole program, so a reader of the fn's write
    /// bit stands on that fn alone and a bystander's edit moves nothing.
    fn writes_of(d: DeclId) -> int {
        // A fixpoint must not run inside a resolve or inside another member's turn: the
        // declared bits answer until it closes, never a half-view member kept.
        if self.db.family_active(Family.Resolved.ordinal) { return 0 }
        if self.db.family_active(Family.Writes.ordinal) { return 0 }
        let k = key(Family.Writes, d.index)
        if self.db.ask(k) is .Compute {
            let closure = self.writes_members(d)
            let members = closure.members
            let solved = self
                .writes_fixpoint
                .solve(
                    [m.index for m in members],
                    (arg: int) -> self.writes_contribution(closure.sums, DeclId { index: arg }),
                )
            self.settle_written_bits(members)
            let refusal? = refusal_of(solved) else { return members.length }
            self.defect("defect: ${fixpoint_spoken(refusal)}")
            return members.length
        }
        self.decls.record_written_bits(d, self.writes_fixpoint.settled_value(d.index))
        0
    }

    /// The fixpoint's answer for each member, written where the declaration table's own
    /// readers read it.
    fn settle_written_bits(members: List<DeclId>) {
        for m in members {
            self.decls.record_written_bits(m, self.writes_fixpoint.settled_value(m.index))
        }
    }

    /// `d`'s call graph, itself included: every fn whose seats could carry a write into one
    /// of `d`'s. A member whose own answer already stands accounts for its callees, so it is
    /// a LEAF input and its edges are not walked — the closure is the unsettled frontier
    /// alone, never every ancestor's whole graph. A held body is a constant member too — its
    /// bits rode its interface, never this pass.
    fn writes_members(d: DeclId) -> Closure {
        mut members: List<DeclId> = [d]
        let sums: Table<Summary> = new_table<Summary>()
        mut at = 0
        while at < members.length {
            let m = members[at]
            at = at + 1
            if self.is_held(self.decls.decl(m).file) { continue }
            if !(self.db.ask(key(Family.Writes, m.index)) is .Compute) { continue }
            let s = self.summary(m)
            sums.keep(m.index, s)
            for f in s.edges {
                if seated(self.decls.decl(f.callee)) && !members.any(same_decl(it, f.callee)) {
                    members = members.concat([f.callee])
                }
            }
        }
        Closure { members: members, sums: sums }
    }

    /// One member's raw contribution: the seats its own body writes and the seats a
    /// callee's settled bits flow into. It is the INFERRED answer alone — a declared `mut`
    /// receiver is the contract beside it (`seat_writes_so_far`), never a bit this pass
    /// records, or a `mut fn` whose body never writes would lose its never-writes warning.
    /// The body is never walked here — the summary was walked once by `writes_members`; a
    /// member with no summary is one that already settled (a LEAF whose answer stands) or a
    /// held body whose bits rode its interface.
    fn writes_contribution(sums: Table<Summary>, d: DeclId) -> List<bool> {
        let n = self.decls.seat_count(d)
        if self.is_held(self.decls.decl(d).file) {
            return self.held_written_bits(d, n)
        }
        let s? = sums.at(d.index) else { return self.writes_fixpoint.value_at(d.index) }
        mut bits = filled(n, false)
        for i, own in s.own { if own { bits.set(i, true) } }
        for f in s.edges {
            // A callee's seat writes when its body does (the fixpoint's answer) OR when its
            // receiver is declared `mut fn` — the contract `seat_writes_so_far` folds in.
            let callee = self.writes_fixpoint.value_at(f.callee.index)
            let declared = f.to == 0 && self.decls.declares_writing(f.callee)
            if f.from < n && (declared || f.to < callee.length && callee[f.to]) { bits.set(f.from, true) }
        }
        bits
    }

    /// A held body's inferred bits, as its interface carried them: the seat marks replayed
    /// at mint, the declared receiver left to `seat_writes_so_far`. Its body is not here to
    /// walk.
    fn held_written_bits(d: DeclId, n: int) -> List<bool> {
        mut bits = filled(n, false)
        for i in 0..n { if self.decls.seat_written_so_far(d, i) { bits.set(i, true) } }
        bits
    }

    /// The pass's answer as a reader can tell it, order-free: each WRITER's bits under
    /// its own key. A fn that writes no seat reads as one never declared, so a
    /// bystander added, renamed or removed moves nothing.
    fn writers_print(fns: List<DeclId>) -> int {
        mut total = 0
        for d in fns {
            let bits = self.decls.written_bits(d)
            if bits.any(it == 1) {
                total = total +
                    mix_final(
                        fp_list(
                            [fp_str(Decl.key_text(self.decls.raw_decl(d).key())), fp_list(bits)],
                        ),
                    )
            }
        }
        fp(17, [total])
    }
}

/// The declarations with seats to write through.
fn seated(x: Decl) -> bool {
    x.kind is .Fn || x.kind is .Method
}

/// `Fixpoint`'s join for written seats: a seat is written when EITHER side writes it, padded
/// to whichever side reaches further — a callee with more seats than its caller can only
/// widen the caller's list.
fn written_join(a: List<bool>, b: List<bool>) -> List<bool> {
    let n = if a.length > b.length { a.length } else { b.length }
    let pa = bit_pad(a, n)
    let pb = bit_pad(b, n)
    [pa[i] || pb[i] for i in 0..n]
}

/// A bit list widened to `n`, the absent tail read as a false seat.
fn bit_pad(xs: List<bool>, n: int) -> List<bool> {
    [if i < xs.length { xs[i] } else { false } for i in 0..n]
}

/// A fn's written seats as a `Fixpoint` hash: one digit per seat, so no two states share a
/// word and an empty list is not the all-false one.
fn written_fp(v: List<bool>) -> int { fp_list([if b { 1 } else { 0 } for b in v]) }

impl Decls {
    /// A fn's written seats for the fingerprint — one digit per seat,
    /// in seat order, so no two states share a word.
    @bracket("receivers")
    fn written_bits(d: DeclId) -> List<int> {
        [if self.seat_written_so_far(d, i) { 1 } else { 0 } for i in 0..self.seat_count(d)]
    }

    /// Kleene iteration: a seat is written when its fn writes it, or
    /// hands it to a seat another fn writes — until no bit moves.
    /// Deterministic and order-free; cycles resolve to the least
    /// answer, which is the true one.
    fn settle_writers(fns: List<DeclId>, sums: List<Summary>) {
        mut changed = true
        while changed {
            changed = false
            for j, d in fns {
                if self.settle_one(d, sums[j]) { changed = true }
            }
        }
    }

    /// One fn's seats settled against its summary — true when a bit
    /// moved.
    @bracket("receivers")
    fn settle_one(d: DeclId, s: Summary) -> bool {
        mut moved = false
        for i, own in s.own {
            if !self.seat_written_so_far(d, i) && (own || self.flows_write(s, i)) {
                self.record_seat_written(d, i)
                moved = true
            }
        }
        moved
    }

    fn flows_write(s: Summary, i: int) -> bool {
        s.edges.any((f: Flow) -> f.from == i && self.seat_writes_so_far(f.callee, f.to))
    }
}

impl Workspace {
    /// A fn's own evidence, read from its resolved body and the
    /// declarations its seat-rooted places name.
    fn summary(d: DeclId) -> Summary {
        let x = self.decls.decl(d)
        let n = self.decls.seat_count(d)
        if x.root == null { return Summary { own: filled(n, false), edges: [] } }
        let receiver: TypeId? = self.receiver_type(x)
        let seats: List<TypeId> = self.decls.sig(d)?.fn_sig()?.params ?? []
        // `Receivers` is never `d`'s own owner — it is the whole-program
        // pass reading every fn's body — so this read of `d`'s nodes is
        // FOREIGN and depends on `d`'s own syntax (COMPILER DB townhall
        // §6.11 rule 2), never on the whole file's `Parsed`.
        touch(self.syntax(d))
        mut cx = Survey {
            ws: self,
            decls: self.decls,
            store: self.decls.store(d),
            names: self.names_of(d),
            receiver: receiver,
            seats: seats,
            lo: x.lo,
            hi: x.hi,
            own: filled(n, false),
            edges: [],
        }
        cx.assigns()
        for k in call_tags(cx.store) {
            for e in cx.store.exprs_by_kind(x.lo, x.hi, k) { cx.site_evidence(e) }
        }
        Summary { own: cx.own, edges: cx.edges }
    }
}

/// What one fn's summary reads and gathers: the body's file, its
/// seats' types (the receiver's when it has one), its expression
/// range — and the evidence as it accrues.
type Survey = { ws: Workspace, decls: Decls, store: SyntaxArena, names: NameFacts, receiver: TypeId?, seats: List<TypeId>, lo: int, hi: int, own: List<bool>, edges: List<Flow> }

impl Survey {
    /// Every assignment in the range rooted in a seat writes it —
    /// unless its path passes through a `state` field, whose cell takes
    /// the write.
    mut fn assigns() {
        for s in self.store.stmt_ids() {
            let t? = self.store.assign_target(s) else { continue }
            if self.in_range(t) && !self.shape().crosses_state(t) { self.mark(self.seat_of(t)) }
        }
    }

    fn in_range(e: ExprId) -> bool {
        e.index >= self.lo && e.index < self.hi
    }

    /// The seat a place is rooted in — asked of the BINDING: the
    /// receiver is seat 0, a parameter its own seat; null for a value
    /// and for every other binding.
    fn seat_of(e: ExprId) -> int? {
        let root? = self.store.place_root(e) else { return null }
        let b? = self.names.binding(root) else { return null }
        match b {
            .Receiver -> 0,
            .Param(i) -> i,
            .Def(_) or .Pattern(_, _) or .LambdaParam(_, _) or .Capture(_, _) or .Index(_) or .Decl(_) -> null,
        }
    }

    mut fn mark(seat: int?) {
        if seat != null && seat! < self.own.length { self.own.set(seat!, true) }
    }

    mut fn flow(seat: int?, callee: DeclId, to: int) {
        if seat != null { self.edges.push(Flow { from: seat!, callee: callee, to: to }) }
    }

    /// This fn's declared-type view, for a place's or a call's
    /// structural answer — `structural_types.av`'s shared machinery.
    fn shape() -> DeclaredTypes {
        DeclaredTypes {
            ws: self.ws,
            decls: self.decls,
            store: self.store,
            names: self.names,
            receiver: self.receiver,
            seats: self.seats,
        }
    }

    /// One expression's evidence: a method call on a seat-rooted place
    /// (a mutating row, a declared method's edge, a contract's word),
    /// and any call handing a seat-rooted place to a callee's seat.
    mut fn site_evidence(e: ExprId) {
        let mp: MethodParts? = self.store.method_parts(e)
        if mp != null { return self.method_evidence(mp!) }
        let callee: DeclId? = bound_decl_of(self.names, e)
        if callee != null { return self.feed(callee!, self.call_args(e), 0) }
        self.valued_evidence(e)
    }

    /// A call THROUGH A FN VALUE the pass can type — a fn-typed seat
    /// called by name, or a seat-rooted place applied: no declaration
    /// to flow into, so the value's marks mark their arguments, as a
    /// fn-typed field's do.
    mut fn valued_evidence(e: ExprId) {
        let seat: int? = self.called_seat(e)
        if seat != null && seat! < self.seats.length { return self.feed_marks(self.arrow_marks(self.seats[seat!]), self.call_args(e)) }
        let ap? = self.store.applied_parts(e) else { return }
        let ty: TypeId? = self.shape().place_type(ap.subject)
        if ty != null { self.feed_marks(self.arrow_marks(ty!), ap.args) }
    }

    /// The seat a named call reads its callee from, when the name is a
    /// parameter.
    fn called_seat(e: ExprId) -> int? {
        if self.call_args(e).is_empty() { return null }
        let b? = self.names.binding(e) else { return null }
        match b { .Param(i) -> i, _ -> null }
    }

    /// A fn type's marks — none for any other type.
    fn arrow_marks(ty: TypeId) -> List<SeatMark> {
        let held? = self.decls.types.arrow_parts(ty) else { return [] }
        held.marks
    }

    /// A named call's arguments; empty for every other node.
    fn call_args(e: ExprId) -> List<ExprId> {
        // one arm answers — a projection over the core node
        match self.store.expr(e) { .Call(_, _, args) -> args, _ -> [] }
    }

    mut fn method_evidence(mp: MethodParts) {
        let seat: int? = self.seat_of(mp.subject)
        let ty: TypeId? = self.shape().value_type(mp.subject)
        // A SUBJECT THIS PASS CANNOT TYPE: every seat-rooted argument is
        // taken as written — the conservative side, so the never-written
        // warning never contradicts the seat law at a call. A subject it
        // CAN type names its callee, or has none with a seat to write
        // (a fn-typed field's seats are never `mut`).
        if ty == null {
            for a in mp.args { if self.writable(a) { self.mark(self.seat_of(a)) } }
            return
        }
        match self.shape().callee_of(ty!, mp.name) {
            .Row(writes, _) if writes -> self.mark(seat),
            .Method(d) -> {
                self.flow(seat, d, 0)
                self.feed(d, mp.args, 1)
            },
            .Static(d) -> self.feed(d, mp.args, 0),
            .FnSeats(held) -> self.feed_marks(held.marks, mp.args),
            .Contract(d) -> {
                if self.decls.declares_writing(d) { self.mark(seat) }
                self.feed(d, mp.args, 1)
            },
            .Row(_, _) or .None -> nothing(),
        }
    }

    /// Whether a handed place could be written through by a callee: a
    /// scalar is copied at the seat, so only a managed value — or one
    /// this pass cannot type — can carry a write back.
    fn writable(a: ExprId) -> bool {
        if self.measured(a) { return false }
        let ty? = self.shape().place_type(a) else { return true }
        match self.decls.types.shape_of(ty) {
            .Int or .Float or .Bytes or .Bool or .Str or .Null or .Void or .Ptr -> false,
            .Struct(_, _) or .Enum(_, _) or .App(_, _, _) or .Dyn(_, _) or .List(_) or .Cell(_) or .Task(_) or .Tasks or .Map(_, _) or .Res(_, _) or .Fn(_, _, _) or .Opt(_) or .EmptyList or .EmptyMap or .TypeName(_, _) or .Var(_, _, _) or .Union(_) or .Error or .Range -> true,
        }
    }

    /// A MEASURED property (`xs.length`) — a scalar the vocabulary
    /// answers, never a slot: copied at any seat.
    fn measured(a: ExprId) -> bool {
        let step? = self.store.place_step(a) else { return false }
        match step {
            .Field(subject, name) -> {
                let holder: TypeId? = self.shape().place_type(subject)
                holder != null &&
                    property_row(
                        self.ws.lang.rows.properties,
                        name.of,
                        self.decls.types.shape_of(holder!),
                    ) != null
            },
            .Root(_) or .At(_, _) or .Unwrap(_) -> false,
        }
    }

    /// Every argument rooted in a seat flows into the callee's seat it
    /// fills, the callee's seats numbered from `base` (1 past a
    /// method's own receiver seat). A CONTRACT's seat has no body to
    /// infer from: its declared `mut` is the write, by permission.
    mut fn feed(callee: DeclId, args: List<ExprId>, base: int) {
        let contract = self.under_trait(callee)
        for j, a in self.store.seated_args(args, self.decls.facts_of(callee)?.seats ?? []) {
            if self.decls.seat_mark(callee, base + j).mutable {
                let seat: int? = self.seat_of(a)
                if contract { self.mark(seat) } else { self.flow(seat, callee, base + j) }
            }
        }
    }

    /// `feed`'s twin over MARKS rather than a declaration's seats: a fn
    /// VALUE names no callee to flow into, so a marked seat MARKS its
    /// argument — the conservative answer, and the right one, since any
    /// fn of that type may fill the field.
    mut fn feed_marks(marks: List<SeatMark>, args: List<ExprId>) {
        for j, a in args {
            if mut_mark(marks, j) { self.mark(self.seat_of(a)) }
        }
    }

    /// Whether a declaration is a trait's bodiless member — a sig; a
    /// DEFAULT has a body to infer from, like any method.
    fn under_trait(d: DeclId) -> bool {
        let parent: DeclId? = self.decls.decl(d).parent
        parent != null && self.decls.is_trait(parent!) && !self.decls.has_body(d)
    }

}

impl Workspace {
    /// A method's receiver type: its impl's target's instance type, or
    /// the record that declares it —
    /// null for a free fn, a trait's sig, and a method whose impl was
    /// refused.
    fn receiver_type(x: Decl) -> TypeId? {
        let parent? = x.parent else { return null }
        match self.decls.decl(parent).kind {
            .Record -> self.decls.self_type_of(parent),
            .Impl -> {
                let target? = self.decls.target_of(parent) else { return null }
                self.decls.self_type_of(target)
            },
            .Trait or .Fn or .Named or .Alias or .Enum or .Syntax or .Method or .Default or .Main or .Case or .Builtin or .Const or .Collect or .CollectEnum or .State -> null,
        }
    }
}

impl Workspace {
    /// A WITNESS for why seat `i` of `d` is written — one path through
    /// the fixpoint's own edges, from the asked seat to the fn whose
    /// declaration or body writes it directly. `settle_writers` proves
    /// the boolean; this walks it back to its cause — `avra docs
    /// writes` prints the same names, in the same order, as fn names
    /// joined by their calls. `self.summary(d)` is recomputed here
    /// rather than read from a stored table: the pass keeps only the
    /// fixpoint's OUTCOME (`seat_written_so_far`), never the per-fn
    /// edges it settled from, so a witness asks for the evidence
    /// again — pure and cheap, one fn at a time, never the
    /// whole-program pass. Null when the seat is not written, or no
    /// ACYCLIC witness reaches a cause (a cycle where every fn in it
    /// is written only through another member of it).
    fn write_chain(d: DeclId, i: int, seen: List<DeclId>) -> List<string>? {
        let decls = self.decls
        if !decls.seat_writes_so_far(d, i) { return null }
        let hop = decls.decl(d).name
        let s = self.summary(d)
        if i == 0 && decls.declares_writing(d) || s.own[i] { return [hop] }
        if seen.any(same_decl(it, d)) { return null }
        let edge? = s
            .edges
            .find((f: Flow) -> f.from == i && decls.seat_writes_so_far(f.callee, f.to)) else {
            return null
        }
        let rest? = self.write_chain(edge.callee, edge.to, seen.concat([d])) else { return null }
        [hop].concat(rest)
    }
}

/// The tags of every call `site_evidence` reads evidence from; each
/// payload is a placeholder `tag_expr` never reads.
fn call_tags(store: SyntaxArena) -> List<int> {
    let at = ExprId { index: 0 }
    [
        store.tag_expr(Expr.MethodCall(at, "", [])),
        store.tag_expr(Expr.Call("", [], [])),
        store.tag_expr(Expr.CallValue(at, [])),
    ]
}
