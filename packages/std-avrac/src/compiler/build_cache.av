//! THE BUILD — a derivation's objects, linked. An unchanged program costs a
//! hash: its binary is kept under a key over every input's bytes. A changed
//! one emits the files that moved, compiles them in parallel, and links them
//! with the objects the store holds for the rest.
use core.{new_digest, digest_text, digest_bytes, digest_key, digest_of, joined, distinct, sorted_texts, same_file, module_path, FileId}
use features.{Wanted}
use @std.path.{joined_path, relative_path, dir_of}
use @std.io.{read_bytes}
use @std.process.{parallel, cmd, Tool, Outcome, Env, Streams}

/// A build's result: the words that linked it, the binary, the warnings to
/// speak, whether the kept binary was reused, and where a fresh one's time went.
export type BuildOutcome = { words: List<string>, binary: string, warnings: string, reused: bool, key: string, phases: string = "" }

/// A module emitted but not yet compiled: its object's key, where clang
/// writes it, and the instantiations its bodies demand.
type PendingObj = { okey: string, obj: string, asks: List<Wanted> }

/// What one build links with: the optimisation level, the runtime object and
/// the linker the host found.
export type Toolchain = { opt: string, runtime: string, linker: string }

/// WHERE A TREE'S ARTIFACTS LIVE — one store for the whole checkout, so a
/// dependency's artifacts serve every package that reaches it, and the store
/// dies with the worktree. Every artifact is content-keyed and verified on
/// read, so the location is never a correctness question.
// LICENSED I39: a pure PROJECTION — a workspace in, its store's directory out.
export fn build_cache_root(ws: Workspace) -> string { joined_path(tree_root(ws), ".avra-cache") }

/// The HIGHEST ancestor that looks like a checkout. A lone file has no tree
/// above it and is its own root.
// LICENSED I39: a pure PROJECTION — a workspace in, the checkout it stands in out.
fn tree_root(ws: Workspace) -> string {
    mut best = ws.root
    mut up = dir_of(ws.root)
    while up != dir_of(up) {
        if looks_like_tree(ws.host, up) { best = up }
        up = dir_of(up)
    }
    best
}

fn looks_like_tree(host: Host, dir: string) -> bool {
    host.is_dir(joined_path(dir, ".git")) || host.exists(joined_path(dir, "avra.toml"))
}

/// A program built: its kept binary when these exact inputs were built
/// before, else derived, compiled and linked now. A refusal is never kept.
// LICENSED I39: THE ENTRY POINT — the one standard signature.
export fn build_program(mut ws: Workspace, entry: string, tools: Toolchain) -> Result<BuildOutcome, string> {
    let store = store_at(build_cache_root(ws))
    let key = ws.program_key(entry)
    let binary = binary_name(entry)
    if store.has(Stored.Bin, key) && store.place(Stored.Bin, key, binary) {
        // a stored binary is bytes, and its mode is not in them
        let _ = avra_spawn_status("chmod", ["+x", binary])
        return .Ok(BuildOutcome { words: [], binary: binary, warnings: store.get(Stored.Warn, key) ?? "", reused: true, key: key })
    }
    let d = ws.derived(entry, Want.Binary)?
    d.program.ws.linked(d, key, binary, tools)
}

/// THE ENTRY OBJECT'S KEY — its module's own bytes, and what compiles them. A
/// module that cannot be read back has no key: an empty read would key every
/// program alike.
fn entry_key(bc: string, tools: Toolchain) -> Result<string, string> {
    match read_bytes(bc) {
        .Ok(bytes) -> .Ok(node_key(Stored.Obj, ["entry", CACHE_FORMAT, digest_key(digest_bytes(new_digest(), bytes)), tools.opt, tools.runtime])),
        .Err(_) -> .Err("avra: the entry's module could not be read back — ${bc}"),
    }
}

impl Workspace {
    /// THE PROGRAM'S KEY — every input's path, length and digest, under the
    /// entry: a whitespace-only edit moves it.
    fn program_key(entry: string) -> string {
        let inputs = joined([self.input_line(f) for f in self.build_inputs()], "\n")
        digest_key(digest_text(digest_text(digest_text(new_digest(), CACHE_FORMAT), relative_path(self.root, entry)), inputs))
    }

    fn input_line(path: string) -> string {
        let text = self.host.read(path)
        "${relative_path(self.root, path)}\t${text.length}\t${digest_of(text)}"
    }

    /// Whether a body's home cannot emit it: the home is held, so its object
    /// is the store's.
    fn homed_in_held(bd: Body) -> bool {
        let home? = home_of(bd) else { return false }
        self.is_held(home)
    }

    /// The derivation with what ROAMS homed in the entry's module: an
    /// instantiation no file owns, and a body whose held home cannot emit it —
    /// weak, in name order, so the module's bytes are the same whatever order
    /// the walk met them in. A held fn goes in as a declaration alone.
    fn homed(lo: Lowered, entry: FileId) -> Lowered {
        let roams = [bd for bd in lo.fns if home_of(bd) == null || self.homed_in_held(bd)]
        mut by_name: Map<string, Body> = {}
        for bd in roams { by_name.set(bd.name, bd with { file: entry, weak: true }) }
        let stay = [bd for bd in lo.fns if by_name.get(bd.name) == null]
        lo with { fns: held_stubs(self).concat(stay).concat([by_name.get(n)! for n in sorted_texts(distinct([bd.name for bd in roams]))]) }
    }

    /// Emit the files that moved, compile them `CLANG_WIDTH` at once, and link
    /// them with the store's objects for the rest.
    fn linked(d: Derived, key: string, binary: string, tools: Toolchain) -> Result<BuildOutcome, string> {
        let store = d.store
        let p = d.program
        let entry = p.entry_file()!.view.file
        let full = self.homed(d.lowered, entry)
        let root = build_cache_root(self)
        let unclosed: string? = program_closed(full)
        if unclosed != null { fail not_closed(unclosed!) }
        mut objs: List<string> = []
        mut moved: List<string> = []
        mut pending: List<PendingObj> = []
        let t0 = self.clock()
        for a in p.files {
            let path = a.view.source.file
            let base = node_key(Stored.Obj, [digest_of(path)])
            let obj = "${root}/${base}.o"
            let bc = "${root}/${base}.bc"
            let is_entry = same_file(a.view.file, entry)
            // the entry's module is the program's, so its key is its own bytes:
            // emitted every build, compiled only when they moved
            if is_entry {
                let broke = emit_closed(full, bc, true, a.view.file)
                if broke != null { fail broke! }
            }
            let okey = if is_entry { entry_key(bc, tools)? } else { self.held_okey(store, path) }
            if store.place(Stored.Obj, okey, obj) {
                objs.push(obj)
            } else {
                if !is_entry {
                    let broke = emit_closed(full, bc, false, a.view.file)
                    if broke != null { fail broke! }
                }
                moved.push("${base}.bc")
                pending.push(PendingObj { okey: okey, obj: obj, asks: [k.want for k in d.lowered.asks if same_file(k.by, a.view.file)] })
            }
        }
        let t1 = self.clock()
        let _ = compiled(moved, root, tools)?
        let t2 = self.clock()
        // the asks land before the object: a hold wants both
        for po in pending {
            let _ = store.keep(Stored.Unit, self.asks_key(po.okey), self.wanted_list_wire(po.asks), [])
            let _ = store.keep_file(Stored.Obj, po.okey, po.obj, [])
            objs.push(po.obj)
        }
        // a held object links in place
        for path in held_paths(self) {
            let okey = self.held_okey(store, path)
            if !store.has(Stored.Obj, okey) { fail object_gone(path) }
            objs.push(store.path(Stored.Obj, okey))
        }
        let t3 = self.clock()
        let words = link_objects(objs, self, tools.runtime, binary)
        let code = avra_spawn_status(tools.linker, words)
        if code != 0 { fail clang_link_failed(code) }
        let t4 = self.clock()
        let _ = store.keep_file(Stored.Bin, key, binary, [key])
        let _ = store.keep(Stored.Warn, key, d.warnings, [key])
        let spent = ["${ph.name} ${ph.ns / 1000000}ms" for ph in p.phases].concat(d.trace).concat(["emit ${(t1 - t0) / 1000000}ms", "clang ${(t2 - t1) / 1000000}ms", "place ${(t3 - t2) / 1000000}ms", "link ${(t4 - t3) / 1000000}ms"])
        .Ok(BuildOutcome { words: words, binary: binary, warnings: d.warnings, reused: false, key: key, phases: joined(spent, ", ") })
    }
}

/// One clang per moved module, `CLANG_WIDTH` at once. `-c a.bc` writes `a.o`
/// beside its input, so every run stands in the store's root.
fn compiled(modules: List<string>, root: string, tools: Toolchain) -> Result<int, string> {
    if modules.is_empty() { return 0 }
    let clang = Tool { name: "clang", path: tools.linker, terminator: null }
    let jobs = [cmd(clang, ["-w", tools.opt, "-c", name]) with { cwd: root, env: Env.Inherit, streams: Streams.Captured, own_group: false } for name in modules]
    match parallel(jobs, CLANG_WIDTH) {
        .Err(why) -> .Err("avra: clang could not run — ${why.describe().message}"),
        .Ok(outs) -> {
            let bad: Outcome? = outs.find((o: Outcome) -> !exited_cleanly(o.exit))
            if bad == null { return modules.length }
            .Err("avra: clang failed compiling ${describe_exit(bad!.exit)}\n${bad!.out.stderr}")
        },
    }
}

// ── The voices ──

fn object_gone(path: string) -> string {
    "avra: a held object disappeared: ${path}"
}
