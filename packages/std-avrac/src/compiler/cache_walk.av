//! THE CACHE, WALKED (P7, P12): every form of `avra explain` is a fold here
//! over the graph as the compiler's `Db` reads it — a cell by its key, the
//! cells by family, an edge by its reader, an edge by what it reads
//! (compiler/db.av). Nothing here reaches past those four. Two derivations
//! feed them, never alive together: `--why`'s hold, judged against the kept
//! `KeyParts` and let go, and the program analysed with nothing held, whose
//! kernel is the graph. Nothing here runs in a check, and nothing here
//! keeps: the walk inspects (`inspecting`), so its store sets every write
//! aside and a second walk answers what the first did.
use core.{FileId, ModuleId, DeclId, reversed, sorted_by, sorted_texts, some_list, text_before}
use @std.path.{relative_path, joined_path, normalized}
use @std.text.{parse_int}
use compiler.families.{Family}
use compiler.host.{InputName}
use features.{Decl}
use @std.relation.engine.{Key, same_key, no_key_marks}

/// The hold against the kept state: every file a check reads, each held or
/// read with why, the files whose text moved since they were kept, and what
/// the derivation that judged them spent — its attempts, those among them
/// that did not stand, and its phases.
export type CacheWalk = { root: string, holds: List<FileHold>, moved: List<string>, attempts: int, discarded: int, phases: List<Phase> }

/// An answer as a person reads it, with its digest — none for an answer the
/// kernel never digested.
export type Digested = { label: string, digest: int? }

/// ONE ANSWER, EXPLAINED: itself; what it read and who reads it, each directly
/// and in label order; how many answers it reads and how many read it at any
/// depth; and the files whose analysis is among those readers — the files a
/// check reads again when this answer moves.
export type Explained = { answer: Digested, reads: List<Digested>, deep: int, read_by: List<Digested>, deep_by: int, files: List<string> }

/// One family's answers, counted: its cells, the reads they recorded, and how
/// long one cell's list of reads runs — the median, the ninety-ninth in a
/// hundred, the longest.
export type FamilyCount = { family: string, cells: int, edges: int, p50: int, p99: int, longest: int }

/// The program analysed with nothing held: the workspace whose kernel is the
/// graph, and what analysing it spent.
export type Graphed = { ws: Workspace, phases: List<Phase> }

/// What a target names, by its spelling alone: the whole package, a file,
/// a declaration by `name` or `Owner.name`, or an answer by its label,
/// `Family(subject)`.
export enum Subject {
    Package
    File(at: string)
    Decl(name: string)
    Query(label: string)
}

/// What a subject names in the graph: its settled answers, or why it names
/// none — a file no check reads, a name no declaration wears or several do
/// (each shown), a declaration no answer is keyed by, a family no answer
/// belongs to, a label its family holds no answer for.
export enum Meant {
    Answers(keys: List<Key>)
    FileUnread(file: string)
    NoDecl(name: string)
    ManyDecls(name: string, shown: List<string>)
    DeclUnanswered(name: string)
    NoFamily(word: string)
    NoAnswer(label: string)
}

/// Every family holding an answer, counted, and their cells and edges in all.
export type Counted = { families: List<FamilyCount>, cells: int, edges: int }

/// What an answer's key names — `Row` for a relation's minted family, whose
/// key is a row's place.
enum KeyedBy { File, Module, Decl, Package, Program, Unit, Name, Input, Row }

/// What each family keys by.
fn keyed_by(f: Family) -> KeyedBy {
    match f {
        .Source or .Parsed or .Items or .Admitted or .Visible or .Resolved or .Folded or .Analysis or .Expanded or .Plain or .MethodDiags -> KeyedBy.File,
        .Namespace or .HeldSig -> KeyedBy.Module,
        .Sig or .Methods or .Typed or .ConstTyped or .Raised or .Syntax or .Names or .Marks or .DeclReads -> KeyedBy.Decl,
        .Manifest -> KeyedBy.Package,
        .Receivers or .References or .Failures or .ReadReach -> KeyedBy.Program,
        .Lowered or .LiftLowered or .Lifted or .Settled -> KeyedBy.Unit,
        .Named -> KeyedBy.Name,
        .Input or .BlockScan or .ComponentScan or .ComponentNames -> KeyedBy.Input,
    }
}

/// What a family's keys name — a row's place for a family no declaration
/// names, a relation's minted one.
fn keyed(family: int) -> KeyedBy {
    let f? = Family.all().get(family) else { return KeyedBy.Row }
    keyed_by(f)
}

/// A family by its word — a relation's minted family by its place.
export fn family_word(family: int) -> string { Family.all().get(family)?.name ?? "${RELATION}${family}" }

/// Whether a family keys by a declaration.
fn keyed_by_decl(f: Family) -> bool {
    match keyed_by(f) {
        .Decl -> true,
        .File or .Module or .Package or .Program or .Unit or .Name or .Input or .Row -> false,
    }
}

/// A path down the walk from one query to a moved input: each step a query
/// the one before it reads, the last the input's own text.
export type Trail = { input: string, steps: List<string> }

/// One query met going down from a root, and where in the walk the query
/// that first read it stands (none for the root).
export type Reached = { key: Key, by: int? }

/// A query no walk has met.
const UNMET: int = 0

/// A query a walk has met.
const MET: int = 1

impl Workspace {
    /// THE HOLD'S REPORT under a check's want, this workspace an inspection
    /// from here on. The derivation that judged the hold is let go here, so
    /// it never stands beside the graph's.
    fn cache_walk() -> Result<CacheWalk, string> {
        self.inspecting()
        let d = self.derived(null, Want.Diagnostics)?
        let holds = d.program.ws.holds_of(d)
        let walk = CacheWalk {
            root: self.root,
            holds: holds,
            moved: [h.path for h in holds if h.moved.any(it.part is .Text)],
            attempts: d.turned + 1,
            discarded: d.turned,
            phases: grouped_phases(d.program.phases.concat(d.spans)),
        }
        d.program.ws.discarded()
        walk
    }

    /// THE GRAPH: the program analysed afresh with nothing held and nothing
    /// kept, so the kernel holds every query a check could run and what each
    /// read.
    fn walk_graph() -> Graphed {
        self.inspecting()
        let g = self.anew()
        Graphed { ws: g, phases: grouped_phases(g.program(null).phases) }
    }

    /// The file at `path` as this workspace numbers it — never minting one.
    fn walked_file(path: string) -> FileId? { self.decls.known_file_id(path) }

    /// A file's analysis: the query a check asks of it, the root of its trails.
    fn analysis_key(path: string) -> Key? {
        let f? = self.walked_file(path) else { return null }
        key(Family.Analysis, f.index)
    }

    /// A file's text: the input its source and its scans read, and the one
    /// leaf under every reader of the file. Looked up, never minted: a file
    /// nothing read has no text here.
    fn input_key(path: string) -> Key? {
        let f? = self.walked_file(path) else { return null }
        let at? = self.text_cell(self.decls.file(f).path) else { return null }
        key(Family.Input, at)
    }

    /// What `label` names: its family by the family's word, its subject
    /// through what that family keys by — `key_label`, read backwards.
    fn labelled(label: string) -> Meant {
        let open = label.index_of("(")
        if open < 0 || !label.ends_with(")") { return Meant.NoAnswer(label) }
        let word = label.substring(0, open)
        let family? = self.family_worded(word) else { return Meant.NoFamily(word) }
        let subject = label.substring(open + 1, label.length - 1)
        if subject == "" { return Meant.NoAnswer(label) }
        let keys = [Key { family: family, arg: arg } for arg in self.subject_args(keyed(family), subject)]
        let settled = [k for k in keys if self.db.cell(k) != null]
        if settled.is_empty() { Meant.NoAnswer(label) } else { Meant.Answers(settled) }
    }

    /// THE ONE DOOR FROM A TARGET TO THE GRAPH: what `subject` names here —
    /// the package nothing, a file its text and its analysis, a declaration
    /// every answer keyed by it, a label the answers wearing it — the
    /// settled ones alone.
    fn meant(subject: Subject) -> Meant {
        match subject {
            .Package -> Meant.Answers([]),
            .File(at) -> self.file_named(at),
            .Decl(name) -> self.decl_named(name),
            .Query(label) -> self.labelled(label),
        }
    }

    fn file_named(file: string) -> Meant {
        let settled = [k for k in some_list(self.input_key(file)).concat(some_list(self.analysis_key(file))) if self.db.cell(k) != null]
        if settled.is_empty() { Meant.FileUnread(self.shown_path(file)) } else { Meant.Answers(settled) }
    }

    fn decl_named(name: string) -> Meant {
        let found = self.decls_named(name)
        if found.is_empty() { return Meant.NoDecl(name) }
        if found.length > 1 { return Meant.ManyDecls(name, [self.decl_shown(d.id) for d in found]) }
        let keys = self.decl_answers(found[0].id)
        if keys.is_empty() { Meant.DeclUnanswered(name) } else { Meant.Answers(keys) }
    }

    /// The family a word names: a declared one by its name, a relation's
    /// minted one by its place among the families holding an answer.
    fn family_worded(word: string) -> int? {
        let declared? = Family.all().find(it.name == word) else { return self.relation_worded(word) }
        declared.ordinal
    }

    fn relation_worded(word: string) -> int? {
        if !word.starts_with(RELATION) { return null }
        let place? = parse_int(word.substring(RELATION.length, word.length)) else { return null }
        if place < Family.all().length || place >= self.db.cells_by_family().length { null } else { place }
    }

    /// The keys a subject names in a family keying by `by` — `key_subject`,
    /// read backwards.
    fn subject_args(by: KeyedBy, subject: string) -> List<int> {
        match by {
            .File -> [f.index for f in some_list(self.walked_file(normalized(joined_path(self.root, subject))))],
            .Module -> [m.index for m in some_list(self.decls.known_module_id(module_named(subject)))],
            .Decl -> [d.id.index for d in self.decls_named(subject.split(DECL_AT).first() ?? subject) if self.decl_shown(d.id) == subject],
            .Package -> [i for i, p in self.packages() if self.package_shown(p.root) == subject],
            .Program -> if subject == THE_PROGRAM { [0] } else { [] },
            .Unit -> if subject.starts_with(UNIT) { some_list(parse_int(subject.substring(UNIT.length, subject.length))) } else { [] },
            .Name -> if subject.starts_with(BUCKET) { some_list(parse_int(subject.substring(BUCKET.length, subject.length))) } else { [self.decls.name_bucket(subject)] },
            .Input -> [at for at, name in self.input_names.get() if self.input_shown(name) == subject],
            .Row -> some_list(parse_int(subject)),
        }
    }

    /// The declarations a name means: by `Owner.name`, or by its name alone.
    fn decls_named(name: string) -> List<Decl> {
        let last = name.split(".").last() ?? name
        let filed = if last == name { self.decls.named_rows(name) } else { self.decls.named_rows(name).concat(self.decls.named_rows(last)) }
        [d for d in filed if d.name == name || "${d.owner}.${d.name}" == name]
    }

    /// Every settled answer keyed by this declaration: its key in each family
    /// that keys by one.
    fn decl_answers(d: DeclId) -> List<Key> {
        [key(f, d.index) for f in Family.all() if keyed_by_decl(f) && self.db.cell(key(f, d.index)) != null]
    }

    /// An answer with its digest.
    fn cited(k: Key) -> Digested { Digested { label: self.key_label(k), digest: self.db.cell(k)?.digest } }

    /// Answers cited, in label order.
    fn cited_all(keys: List<Key>) -> List<Digested> {
        sorted_by(
            [self.cited(k) for k in keys],
            (a: Digested, b: Digested) -> text_before(a.label, b.label),
        )
    }

    /// Each of `keys` explained.
    fn explained_all(keys: List<Key>) -> List<Explained> { [self.explained(k) for k in keys] }

    /// One answer: what it read, who reads it, and how far each goes.
    fn explained(k: Key) -> Explained {
        let above = self.readers_from(k)
        Explained {
            answer: self.cited(k),
            reads: self.cited_all(self.db.edges_by_reader(k)),
            deep: self.reached_from(k).length - 1,
            read_by: self.cited_all(self.db.edges_by_read(k)),
            deep_by: above.length - 1,
            files: sorted_texts(
                [p for r in above.slice(1, above.length) for p in some_list(self.analysed_path(r.key))],
            ),
        }
    }

    /// Every family holding an answer, counted, in the families' own order.
    fn family_counts() -> Counted {
        let families = [self.family_count(f, [self.db.edges_by_reader(c.key).length for c in cells]) for f, cells in self.db.cells_by_family() if !cells.is_empty()]
        Counted {
            families: families,
            cells: total([f.cells for f in families]),
            edges: total([f.edges for f in families]),
        }
    }

    fn family_count(family: int, reads: List<int>) -> FamilyCount {
        let ranked = sorted_by(reads, (a: int, b: int) -> a < b)
        FamilyCount {
            family: family_word(family),
            cells: ranked.length,
            edges: total(ranked),
            p50: ranked[(ranked.length - 1) / 2],
            p99: ranked[(ranked.length - 1) * 99 / 100],
            longest: ranked.last() ?? 0,
        }
    }

    /// An input as a person reads it: what kind of read, then its path as
    /// every other answer shows a path.
    fn input_shown(name: InputName) -> string { "${kind_word(name.kind)} ${self.shown_path(name.key)}" }

    /// A query as a person reads it: its family's word and what it keys by.
    fn key_label(k: Key) -> string { "${family_word(k.family)}(${self.key_subject(k)})" }

    /// The file a query analyses, for a file's analysis alone.
    fn analysed_path(k: Key) -> string? {
        if k.family != Family.Analysis.ordinal { return null }
        self.shown_path(self.decls.file(FileId { index: k.arg }).path)
    }

    /// What an answer is keyed by, named: a file, a module, a declaration, a
    /// package, the whole program, a name, or a unit known only by its number.
    fn key_subject(k: Key) -> string {
        match keyed(k.family) {
            .File -> self.shown_path(self.decls.file(FileId { index: k.arg }).path),
            .Module -> module_shown(self.decls.module_name(ModuleId { index: k.arg })),
            .Decl -> self.decl_shown(DeclId { index: k.arg }),
            .Package -> self.package_shown(self.packages()[k.arg].root),
            .Program -> THE_PROGRAM,
            .Unit -> "${UNIT}${k.arg}",
            .Name -> self.bucket_shown(k.arg),
            .Input -> self.input_shown(self.input_names.get()[k.arg]),
            .Row -> "${k.arg}",
        }
    }

    /// A bucket of the name index by the name it files — by its place when it
    /// files none, so no two buckets wear one label.
    fn bucket_shown(b: int) -> string {
        let name = self.decls.cell_name(b)
        if name == "" { "${BUCKET}${b}" } else { name }
    }

    /// A package by its root as the asked package's root sees it — the asked
    /// package itself by `.`, so no package wears an empty label.
    fn package_shown(root: string) -> string {
        let shown = self.shown_path(root)
        if shown == "" { HERE } else { shown }
    }

    /// A path as the package's root sees it.
    fn shown_path(path: string) -> string { relative_path(self.root, path) }

    /// A declaration by its owner and name, then the file declaring it.
    fn decl_shown(d: DeclId) -> string {
        let x = self.decls.decl(d)
        let named = if x.owner == "" { x.name } else { "${x.owner}.${x.name}" }
        match x.kind {
            .Builtin -> "${named}${DECL_AT}builtin",
            rest -> "${named}${DECL_AT}${self.shown_path(self.decls.file(x.file).path)}",
        }
    }

    /// Every query `root` reads at any depth, breadth first, each once, with
    /// where the query that first read it stands.
    fn reached_from(root: Key) -> List<Reached> { reached(root, (k: Key) -> self.db.edges_by_reader(k)) }

    /// Every query that reads `root` at any depth, nearest first, each once.
    fn readers_from(root: Key) -> List<Reached> { reached(root, (k: Key) -> self.db.edges_by_read(k)) }

    /// The shortest path from `root` down to each of `inputs` it reads.
    fn trails(root: Key, inputs: List<string>) -> List<Trail> {
        let walk = self.reached_from(root)
        [t for path in inputs for t in self.trail_to(walk, path)]
    }

    fn trail_to(walk: List<Reached>, path: string) -> List<Trail> {
        let input? = self.input_key(path) else { return [] }
        let at? = [i for i, r in walk if same_key(r.key, input)].first() else { return [] }
        [
            Trail {
                input: self.shown_path(path),
                steps: [self.key_label(k) for k in back_from(walk, at)],
            },
        ]
    }
}

/// `root`, then every key `next` reaches from it at any depth, breadth first,
/// each once, with where the key that first reached it stands.
fn reached(root: Key, next: fn(Key) -> List<Key>) -> List<Reached> {
    let seen = no_key_marks()
    seen.mark(root, MET)
    mut out = [Reached { key: root, by: null }]
    mut at = 0
    while at < out.length {
        for d in next(out[at].key) {
            if seen.mark_of(d) == UNMET {
                seen.mark(d, MET)
                out.push(Reached { key: d, by: at })
            }
        }
        at = at + 1
    }
    out
}

/// The keys from the walk's root down to the one at `at`.
fn back_from(walk: List<Reached>, at: int) -> List<Key> {
    mut keys = [walk[at].key]
    mut by = walk[at].by
    while by != null {
        keys.push(walk[by!].key)
        by = walk[by!].by
    }
    reversed(keys)
}

fn total(ns: List<int>) -> int {
    mut sum = 0
    for n in ns { sum = sum + n }
    sum
}

/// A module by its name, the root's empty one spelled out.
fn module_shown(name: string) -> string { if name == "" { ROOT_MODULE } else { name } }

/// The module a shown name names.
fn module_named(shown: string) -> string { if shown == ROOT_MODULE { "" } else { shown } }

// The words a label is spelled with, one spelling for the label and its reading.

const ROOT_MODULE: string = "the root module"

const THE_PROGRAM: string = "the program"

const UNIT: string = "unit "

const HERE: string = "."

const BUCKET: string = "bucket "

const RELATION: string = "Relation "

const DECL_AT: string = " · "
