//! The canonical source projection of the AST. Every node answers in
//! parseable Avra; layout and redundant parentheses are presentation,
//! while node order, operator grouping, declaration marks and payloads
//! are preserved. `avra expand` and the future formatter share this one
//! renderer.
use core.{
    SyntaxArena,
    jump_word,
    Remark,
    Trivia,
    Span,
    StmtId,
    ExprId,
    PatId,
    Expr,
    Stmt,
    Arm,
    PayloadIs,
    CompClause,
    BinOp,
    Param,
    member_of,
    Spread,
    Mark,
    Plain,
    Variant,
    Case,
    Annotation,
    TypeRef,
    FormatPart,
    Hole,
    CollectKind,
    CollectScope,
    Projection,
    quoted_text,
    spelled,
    op_symbol,
    joined,
    flatten,
    filled,
    mark_prefixed,
    body_behavior,
    same_expr,
    some_list,
    doc_line_text,
    same_param_id,
    pronoun_param_id,
}
use features.{chained_binder}
use features.expr_spine.{words, applieds}
use @std.text.{Text, builder}
extern fn avra_float_text_bits(bits: int) -> string

/// The one column every width decision measures against — industry
/// standard (rustfmt's default), fixed: convention over
/// configuration, so `avra fmt` makes one choice and everyone reads
/// the same layout.
export const canonical_width: int = 100

/// A width no line reaches, for a group that must stay on one line.
const unbounded_width: int = 1000000000

/// A stretch of text a `{` may stand in — never inside a comment's
/// own words, since one quoting source (`` `grammar { "s" }` ``)
/// carries a `{` that is not syntax.
type Window = { lo: int, hi: int }

/// The renderer with NO remarks — one statement, or one expression.
///
/// A REMARK IS AN OFFSET INTO THE FILE IT WAS WRITTEN IN, and these
/// entry points render a node that may have been COPIED from another
/// file's store: `expand` renders generated declarations through
/// `render_statement`, and a generated node's span is homed in the
/// file that wrote the template. Interleaving a remark against a span
/// from a different text would be silent, because an offset is always
/// a number and never an error. So the guard is that these render with
/// NO remarks, and generated code carries none because none were ever
/// measured in it.
fn source_text(store: SyntaxArena) -> SourceText {
    SourceText { store: store, trivia: [], next: 0, text: null }
}

/// The renderer for a WHOLE FILE, its remarks placed. Only this entry
/// point has a text the offsets belong to.
fn source_text_of_file(store: SyntaxArena) -> SourceText {
    SourceText { store: store, trivia: store.remarks.get(), next: 0, text: null }
}

/// The renderer for a WHOLE FILE with its TEXT in hand: a braced body
/// the author wrote on ONE line keeps that form, and a construct
/// with no written form of its own — call arguments, a parameter
/// list, a chain — decides its OWN layout against `canonical_width`.
fn source_text_of_text(store: SyntaxArena, text: string) -> SourceText {
    SourceText { store: store, trivia: store.remarks.get(), next: 0, text: text }
}

/// Where a construct begins; no span means it begins nowhere, so a
/// cursor drain there consumes nothing.
fn start_of(s: Span?) -> int { if s == null { -1 } else { s.lo } }

/// Where a construct ends.
fn end_of(s: Span?) -> int { if s == null { -1 } else { s.hi } }

/// Statements as canonical source, separated at the top level. With no
/// text in hand there is no written form to keep, so every body expands.
export fn render_source(store: SyntaxArena, stmts: List<StmtId>) -> string {
    mut out = source_text_of_file(store)
    render_with(out, stmts)
}

/// The same, with the file's TEXT — a body the author wrote on one
/// line keeps that form. `canonical_width` decides layout for a
/// construct with no written form of its own to preserve (call
/// arguments, a parameter list, a chain) and OVERRIDES the written
/// form for one that has (a literal, `use`'s item list, a `match`'s
/// arms) whenever no comment stands inside it.
export fn render_source_of(store: SyntaxArena, stmts: List<StmtId>, text: string) -> string {
    mut out = source_text_of_text(store, text)
    render_with(out, stmts)
}

fn render_with(mut out: SourceText, stmts: List<StmtId>) -> string {
    // NO BLANK LINE OF THE PRINTER'S OWN. A blank between declarations
    // is the AUTHOR's paragraphing and arrives as trivia.
    let body = joined(
        [joined(out.statement(s, 0), "\n") for s in stmts if !out.store.is_hoisted(s)],
        "\n",
    )
    // A TRAILING BLANK LINE IS A REAL LINE, NOT AN EMPTY TAIL: the
    // tail's JOINED STRING and its LIST both read "" for a lone
    // trailing `Blank` remark, so testing the string cannot tell "no
    // trivia left" from "one blank line left" — the empty value spent
    // twice. Ask the LIST.
    let tail_lines = out.trivia_rest(0)
    if tail_lines.is_empty() { return body }
    let tail = joined(tail_lines, "\n")
    if body.is_empty() { return tail }
    "${body}\n${tail}"
}

/// One statement as canonical source.
export fn render_statement(store: SyntaxArena, stmt: StmtId) -> string {
    mut out = source_text(store)
    joined(out.statement(stmt, 0), "\n")
}

/// One expression as canonical source.
export fn render_expression(store: SyntaxArena, expr: ExprId) -> string {
    mut out = source_text(store)
    out.expression(expr, loosest_tier, 0)
}

/// `unbroken` counts the enclosing places a line break cannot stand in — an
/// interpolation hole — where every group prints on one line.
type SourceText = { store: SyntaxArena, trivia: List<Remark>, next: int, text: string?, unbroken: int = 0 }

/// A postfix `.` chain's own root (the first subject that is not
/// itself a `.Prop`/`.MethodCall`) and its links, outermost last —
/// `chain_walk`'s answer.
type ChainWalk = { root: ExprId, links: List<string> }

/// A `given` block, as read back off a `Spec`'s flat `cases`: a run
/// of CONSECUTIVE cases sharing one non-empty group name. Two
/// `given "a"` blocks the author wrote apart stay apart — nothing
/// between them shares the run — and an empty group is never
/// merged: it is a bare `then`, one case to its own group.
type CaseGroup = { group: string, cases: List<Case> }

/// Whether `c` continues `prev`'s run — the same non-empty group.
fn continues_run(prev: CaseGroup?, c: Case) -> bool {
    if prev == null || c.group.is_empty() { return false }
    prev!.group == c.group
}

/// `cases` folded into its `given` runs, in order.
fn grouped_cases(cases: List<Case>) -> List<CaseGroup> {
    mut out: List<CaseGroup> = []
    for c in cases {
        let prev: CaseGroup? = out.last()
        if continues_run(prev, c) {
            let g = prev!
            out.set(out.length - 1, g with { cases: g.cases.concat([c]) })
        } else {
            out.push(CaseGroup { group: c.group, cases: [c] })
        }
    }
    out
}

/// The last `{`'s own index in `s`, or -1.
fn last_brace(s: string) -> int {
    [i for i in 0..s.length if s.char_code(i) == 123].last() ?? -1
}

fn is_comment(r: Remark) -> bool { r.trivia is .Comment }

/// A `Comment` remark's own end — one past its stored text, which IS
/// its source span, the leading `//` included. A `Blank` answers its
/// own start: a blank line has no characters to skip past.
fn comment_end(r: Remark) -> int {
    match r.trivia { .Comment(text) -> r.at + text.length, .Blank -> r.at }
}

/// `[lo, hi)` split at every cut's own text — the gaps between them,
/// where the cuts are each a `Comment` remark standing in the range
/// (never a `Blank`, which hides nothing a `{` could hide behind).
fn safe_windows(cuts: List<Remark>, lo: int, hi: int) -> List<Window> {
    mut out: List<Window> = []
    mut cur = lo
    for r in cuts {
        if r.at > cur { out.push(Window { lo: cur, hi: r.at }) }
        cur = comment_end(r)
    }
    if cur < hi { out.push(Window { lo: cur, hi: hi }) }
    out
}

/// The last `{` inside one window of `t`, as an absolute offset — or
/// absent, when the window holds none.
fn window_brace(t: string, w: Window) -> int? {
    let rel = last_brace(t.substring(w.lo, w.hi))
    if rel < 0 { null } else { w.lo + rel }
}

impl SourceText {
    /// A statement, its documentation and its annotations.
    ///
    /// THE DOC AND ITS REMARKS INTERLEAVE: a `//` may sit before or
    /// after the `///` group, so the drain happens either side of it
    /// and the author's order is kept.
    ///
    /// THE STATEMENT'S OWN LAST LINE MAY TRAIL A COMMENT: the cursor
    /// sits right past the statement's tokens once `statement_node`
    /// returns, so a same-line remark found there is the one this
    /// statement's own text carries and is appended to it, never
    /// given a line of its own.
    mut fn statement(s: StmtId, depth: int) -> List<string> {
        let decl = start_of(self.store.stmt_span(s))
        let at = self.store.doc_at(s)
        let doc = if at < 0 { decl } else { at }
        // AN ANNOTATION'S OWN COMMENT STAYS AT IT: a `//` may stand
        // before ANY annotation, not just the first, so each one
        // drains the trivia before ITS OWN span before it prints —
        // never all trivia first, then every annotation flat, which
        // would pull a later annotation's comment in front of an
        // earlier annotation it was never written near.
        let lead = self
            .trivia_before(doc, depth)
            .concat(self.doc_lines(s, depth))
            .concat(
                flatten(
                    [self
                        .trivia_before(start_of(a.span), depth)
                        .concat([source_line(depth, self.annotation(a, depth))]) for a in self.store.annotations_of(s)],
                ),
            )
            .concat(self.trivia_before(decl, depth))
        let node_lines = self.statement_node(s, depth)
        lead.concat(trailed(node_lines, self.trailing()))
    }

    /// Every remark written before `at`, at `depth` — the ONE placement
    /// rule. The cursor only advances and the printer walks the source
    /// in order, so a remark is consumed by whichever emission reaches
    /// its offset first: placement and consumption are one derivation.
    mut fn trivia_before(at: int, depth: int) -> List<string> {
        let from = self.next
        while self.next < self.trivia.length && self.trivia[self.next].at < at {
            self.next = self.next + 1
        }
        [trivia_line(self.trivia[j].trivia, depth) for j in from..self.next]
    }

    /// The file's remaining remarks — the tail drain, one page.
    mut fn trivia_rest(depth: int) -> List<string> {
        if self.next >= self.trivia.length { return [] }
        self.trivia_before(self.trivia.last()!.at + 1, depth)
    }

    /// A raw body's OWN span, walked past without printing anything:
    /// a `quote { … }` (or any other raw-captured body) is copied
    /// verbatim from its own parts, so a blank line or a `//` inside
    /// it is ALREADY in that text — the file-wide lexer still recorded
    /// it as an ordinary remark, same as any other byte range, and
    /// left uncollected it sits until whatever drains next (the
    /// enclosing scope's own closing brace) prints it there A SECOND
    /// TIME. `trivia_before` would print it; this only advances past it.
    mut fn skip_trivia_within(hi: int) {
        while self.next < self.trivia.length && self.trivia[self.next].at < hi {
            self.next = self.next + 1
        }
    }

    /// A trailing comment sharing the line just finished, as text to
    /// APPEND — never its own line. The forward-only cursor is what
    /// makes this a peek-and-take: whatever remark stands next, right
    /// where the caller's own line just ended, is the one that trails
    /// it or nothing does.
    mut fn trailing() -> string {
        if self.next >= self.trivia.length { return "" }
        let r = self.trivia[self.next]
        if !r.same_line { return "" }
        self.next = self.next + 1
        " ${remark_text(r.trivia)}"
    }

    /// Whether the author wrote this span on ONE line — the form a
    /// braced body keeps. No text in hand is no written form to keep.
    fn flat(lo: int, hi: int) -> bool {
        let t? = self.text else { return false }
        if lo < 0 || hi <= lo || hi > t.length { return false }
        // a span may carry the NEXT thing's break at its end; trim it
        !t.substring(lo, hi).trim().contains("\n")
    }

    fn span_flat(sp: Span?) -> bool { self.flat(start_of(sp), end_of(sp)) }

    /// Whether a statement's own span is one line.
    fn stmt_flat(s: StmtId) -> bool { self.span_flat(self.store.stmt_span(s)) }
}

/// One piece of trivia as a line: a comment at its indent, a blank
/// line as nothing at all — an indented empty line is trailing
/// whitespace the author did not write.
fn trivia_line(t: Trivia, depth: int) -> string {
    match t { .Comment(text) -> source_line(depth, text), .Blank -> "" }
}

/// A remark's own text — same-line trivia is always a `Comment`, but
/// the match stays exhaustive over `Trivia` rather than assuming it.
fn remark_text(t: Trivia) -> string {
    match t { .Comment(text) -> text, .Blank -> "" }
}

/// `lines` with `trail` appended to its last entry — absence and an
/// empty list both pass through untouched.
fn trailed(lines: List<string>, trail: string) -> List<string> {
    if trail.is_empty() { return lines }
    let last? = lines.last() else { return lines }
    lines.slice(0, lines.length - 1).concat(["${last}${trail}"])
}

/// A line already carrying `depth` levels of indent, without them — what
/// a body's one-line form puts between its braces.
fn unpadded(line: string, depth: int) -> string {
    let pad = depth * 4
    if line.length <= pad { return line }
    line.substring(pad, line.length)
}

impl SourceText {

    fn doc_lines(s: StmtId, depth: int) -> List<string> {
        let doc? = self.store.doc_comment(s) else { return [] }
        [source_line(depth, doc_line_text(line)) for line in doc]
    }

    /// The statement registry: every Stmt variant has one source form.
    mut fn statement_node(s: StmtId, depth: int) -> List<string> {
        let exported = if self.store.is_exported(s) { "export " } else { "" }
        match self.store.stmt(s) {
            .Let(name, ty, value) -> [self.let_or_component_inst(s, name.of, ty, value, depth)],
            .MutLet(name, ty, value) -> {
                // A `state` binding IS a mut binding's place: it prints
                // the word it was written with, so the sugar round-trips.
                let word = if self.store.is_state_stmt(s) { "state" } else { "mut" }
                let name_part = "${word} ${source_name(name.of)}"
                let prefix = "${name_part}${self.annotation_type(ty, depth, col_after(name_part, depth * 4))} = "
                [
                    source_line(
                        depth,
                        "${prefix}${self.expression(value, loosest_tier, depth, col_after(prefix, depth * 4))}",
                    ),
                ]
            },
            .ConstDecl(name, ty, value) -> [
                if self.store.is_component_inst(s) {
                    self.component_inst(exported, value, name.of, depth)
                } else {
                    let name_part = "${exported}const ${source_name(name.of)}"
                    let prefix = "${name_part}${self.annotation_type(ty, depth, col_after(name_part, depth * 4))} = "
                    source_line(
                        depth,
                        "${prefix}${self.expression(value, loosest_tier, depth, col_after(prefix, depth * 4))}",
                    )
                },
            ],
            .Assign(target, value) -> {
                let prefix = "${self.expression(target, loosest_tier, depth)} = "
                [
                    source_line(
                        depth,
                        "${prefix}${self.expression(value, loosest_tier, depth, col_after(prefix, depth * 4))}",
                    ),
                ]
            },
            .ExprStmt(value) -> [source_line(depth, self.expression(value, loosest_tier, depth))],
            .Discard(value) -> {
                let prefix = "let _ = "
                [
                    source_line(
                        depth,
                        "${prefix}${self.expression(value, loosest_tier, depth, col_after(prefix, depth * 4))}",
                    ),
                ]
            },
            .FnDecl(name, tparams, params, ret, body) -> {
                let head = "${exported}${self.fn_mark(s)}fn ${source_name(name.of)}${self.type_params(tparams)}"
                let sig = "${head}${self.params_wrapped(params, depth, col_after(head, depth * 4))}"
                [
                    source_line(
                        depth,
                        "${sig}${self.ret_arrow(ret, depth, col_after(sig, depth * 4))} ${self.block(body, self.stmt_flat(s), depth)}",
                    ),
                ]
            },
            .ExternFn(name, params, ret) -> {
                let head = "${exported}extern fn ${source_name(name.of)}"
                let sig = "${head}${self.params_wrapped(params, depth, col_after(head, depth * 4))}"
                [
                    source_line(
                        depth,
                        "${sig}${self.ret_arrow(ret, depth, col_after(sig, depth * 4))}",
                    ),
                ]
            },
            .While(cond, stmts) -> {
                let prefix = "while "
                [
                    self
                        .statement_block(
                            "${prefix}${self.expression(cond, loosest_tier, depth, col_after(prefix, depth * 4))}",
                            stmts,
                            self.stmt_end(s),
                            self.stmt_flat(s),
                            depth,
                        ),
                ]
            },
            .IfStmt(cond, yes, no) -> [self.if_statement(cond, yes, no, self.stmt_end(s), self.stmt_flat(s), depth)],
            .Return(value) -> [
                source_line(
                    depth,
                    if value == null { "return" } else { "return ${self.expression(value!, loosest_tier, depth, col_after("return ", depth * 4))}" },
                ),
            ],
            .Fail(value) -> [
                source_line(
                    depth,
                    "fail ${self.expression(value, loosest_tier, depth, col_after("fail ", depth * 4))}",
                ),
            ],
            .ImplDecl(of, target, fns) -> {
                let itp = self.store.impl_tparams_of(s)
                [
                    self
                        .impl_decl(
                            exported,
                            of?.of,
                            [p.of for p in itp?.of ?? []],
                            target.of,
                            [p.of for p in itp?.target ?? []],
                            fns,
                            self.stmt_end(s),
                            self.stmt_flat(s),
                            depth,
                        ),
                ]
            },
            .TraitDecl(name, fns) -> [
                self
                    .trait_decl(
                        exported,
                        name.of,
                        self.store.trait_tparams_of(s),
                        fns,
                        self.stmt_end(s),
                        self.stmt_flat(s),
                        depth,
                    ),
            ],
            .SyntaxDecl(name, text) -> [source_line(depth, "${exported}grammar ${source_name(name.of)} {${text}}")],
            .Setting(name, value) -> self.setting(name.of, value, depth),
            .ComponentDecl(name, head, fields, fns) -> [
                self
                    .component_decl(
                        exported,
                        name.of,
                        head,
                        self.entries(fields, self.store.spreads_of(s), depth + 1),
                        fns,
                        self.stmt_end(s),
                        depth,
                    ),
            ],
            .LetElse(name, subject, stmts) -> {
                let prefix = "let ${source_name(name.of)}? = "
                [
                    self
                        .statement_block(
                            "${prefix}${self.let_else_subject(subject, depth, col_after(prefix, depth * 4))} else",
                            stmts,
                            self.stmt_end(s),
                            self.stmt_flat(s),
                            depth,
                        ),
                ]
            },
            .For(name, from, to, _, _, stmts) -> {
                let prefix = "for ${source_name(name.of)} in "
                let f = self.expression(from, loosest_tier, depth, col_after(prefix, depth * 4))
                let head = "${prefix}${f}"
                [
                    self
                        .statement_block(
                            "${head}..${self.expression(to, loosest_tier, depth, col_after(head, depth * 4) + 2)}",
                            stmts,
                            self.stmt_end(s),
                            self.stmt_flat(s),
                            depth,
                        ),
                ]
            },
            .Use(path, items, aliases) -> {
                let prefix = "use ${joined(path, ".")}."
                [
                    source_line(
                        depth,
                        "${prefix}${self.wrapped_list("{", [import_item(items[j], aliases[j]) for j in 0..items.length], "}", false, depth, col_after(prefix, depth * 4))}",
                    ),
                ]
            },
            .ForEach(index, name, subject, stmts) -> {
                let prefix = "for ${self.loop_binds(index?.of, name.of)} in "
                [
                    self
                        .statement_block(
                            "${prefix}${self.expression(subject, loosest_tier, depth, col_after(prefix, depth * 4))}",
                            stmts,
                            self.stmt_end(s),
                            self.stmt_flat(s),
                            depth,
                        ),
                ]
            },
            .StructDecl(name, tparams, fields) -> [
                self
                    .struct_or_grammar_decl(
                        s,
                        exported,
                        name.of,
                        [t.of for t in tparams],
                        fields,
                        self.stmt_end(s),
                        self.stmt_flat(s),
                        depth,
                    ),
            ],
            .NamedType(name, tparams, of) -> {
                let prefix = "${exported}type ${source_name(name.of)}${self.named_type_params([t.of for t in tparams])} = "
                [
                    source_line(
                        depth,
                        "${prefix}${self.type_ref_wrapped(of, depth, col_after(prefix, depth * 4))}",
                    ),
                ]
            },
            .Alias(name, tparams, of) -> {
                let prefix = "${exported}alias ${source_name(name.of)}${self.named_type_params([t.of for t in tparams])} = "
                [
                    source_line(
                        depth,
                        "${prefix}${self.type_ref_wrapped(of, depth, col_after(prefix, depth * 4))}",
                    ),
                ]
            },
            .EnumDecl(name, tparams, variants) -> [
                self
                    .enum_decl(
                        exported,
                        name.of,
                        [t.of for t in tparams],
                        variants,
                        self.stmt_end(s),
                        self.stmt_flat(s),
                        depth,
                    ),
            ],
            .Spec(name, cases) -> [self.spec_decl(name, cases, self.stmt_end(s), self.stmt_flat(s), depth)],
            .Defer(body, on_error) -> [
                source_line(
                    depth,
                    "${if on_error { "errdefer" } else { "defer" }} ${self.written_body(body, depth)}",
                ),
            ],
            .Collect(name, ty, kind, scope, proj, order) -> [
                source_line(
                    depth,
                    self
                        .collect_decl(
                            exported,
                            name.of,
                            ty,
                            kind,
                            scope,
                            proj,
                            order,
                            self.store.is_collect_dense(s),
                        ),
                ),
            ],
            .CollectEnum(name, kind, scope, order) -> [
                source_line(
                    depth,
                    self
                        .collect_enum_decl(exported, name.of, kind, scope, order, self.store.is_collect_dense(s)),
                ),
            ],
            .Jump(label, again) -> [source_line(depth, jump_line(again, self.written_label(label)))],
            .Error -> [source_line(depth, "__error")],
        }
    }

    fn stmt_end(s: StmtId) -> int { end_of(self.store.stmt_span(s)) }

    /// A jump's label as written — the name its `for` binds.
    fn written_label(label: ExprId?) -> string? {
        if label == null { return null }
        self.expression(label!, loosest_tier, 0)
    }

    /// A LET-ELSE'S SUBJECT, guarded against the one ambiguity this
    /// statement's own trailing `else` creates: printed at
    /// `loosest_tier`, an `if` ends in `}` with nothing asking for a
    /// group — so the `else` this statement appends right after
    /// reads as ANOTHER arm of that `if`, not the let-else's own.
    /// Every other expression kind ends in a token no `else` can
    /// continue, so only `.If` needs the parens the tier system
    /// would not otherwise put there.
    fn let_else_subject(subject: ExprId, depth: int, col: int = -1) -> string {
        let text = self.expression(subject, loosest_tier, depth, col)
        if self.store.expr(subject) is .If { "(${text})" } else { text }
    }

    /// AN INSTANCE'S HEAD KEEPS ITS BRACE: a record literal that would
    /// open in one stands in parentheses, so the brace after the head is
    /// the instance's.
    fn head(e: ExprId, depth: int, col: int = -1) -> string {
        let text = self.expression(e, loosest_tier, depth, col)
        if self.store.opens_with_literal(e) { "(${text})" } else { text }
    }

    /// Whether `value` is the SAME node as `stmts`' own last
    /// statement's answer — the annotated-tail case, where nothing
    /// else stands between the two.
    fn doubled_tail(stmts: List<StmtId>, value: ExprId) -> bool {
        let last? = stmts.last() else { return false }
        let answer? = self.store.answer_of(last) else { return false }
        same_expr(answer, value)
    }

    /// Where an arm's line begins — its first pattern, or nowhere.
    fn arm_start(a: Arm) -> int {
        let p? = a.pats.first() else { return -1 }
        start_of(self.store.pat_span(p))
    }

    mut fn annotation(a: Annotation, depth: int) -> string {
        if a.args.is_empty() { return "@${a.name}" }
        "@${a.name}(${joined([self.expression(x, loosest_tier, depth) for x in a.args], ", ")})"
    }

    fn annotation_type(ty: TypeRef?, depth: int, col: int = -1) -> string {
        if ty == null { "" } else { ": ${self.type_ref_wrapped(ty!, depth, col_after(": ", resolved_col(col, depth)))}" }
    }

    /// A written type, width-decided: `spelled`'s own text when it
    /// fits, or its OUTERMOST argument list broken one type per line
    /// — a nested argument list stays flat, the fallback a comma
    /// list's own items always take (an annotation nesting two wide
    /// generics is rare enough that one broken level is where this
    /// stops).
    fn type_ref_wrapped(t: TypeRef, depth: int, col: int = -1) -> string {
        if t.arrow || t.args.is_empty() || !t.alternatives.is_empty() { return spelled(t) }
        let head = "${if t.dynamic { "dyn " } else { "" }}${t.name}"
        let body = self
            .wrapped_list(
                "<",
                [spelled(a) for a in t.args],
                ">",
                false,
                depth,
                col_after(head, resolved_col(col, depth)),
            )
        let base = "${head}${body}"
        if t.optional { "${base}?" } else { base }
    }

    /// One collect field: `name: it.path`, or `name: it` for the
    /// bare declaration — `path` empty.
    fn collect_field(name: string, path: List<Plain>) -> string {
        "${name}: it${if path.is_empty() { "" } else { ".${joined([p.of for p in path], ".")}" }}"
    }

    fn collect_kind_word(k: CollectKind) -> string {
        match k { .Component(w) or .UnknownKind(w) -> w, .Annotated(w) -> "@${w}" }
    }

    fn collect_scope_word(s: CollectScope) -> string {
        match s {
            .Self -> "self",
            .Package -> "package",
            .Closure -> "closure",
            .UnknownScope(w) -> w,
        }
    }

    fn fn_mark(s: StmtId) -> string {
        when {
            self.store.is_mutating(s) -> "mut "
            self.store.is_static(s) -> "static "
            self.store.is_once(s) -> "once "
            self.store.is_host_fn(s) -> "extern "
            _ -> ""
        }
    }

    fn type_params(params: List<Param>) -> string {
        if params.is_empty() { return "" }
        "<${joined(["${source_name(p.name.of)}${self.bound(p.ty)}" for p in params], ", ")}>"
    }

    fn named_type_params(params: List<string>) -> string {
        if params.is_empty() { return "" }
        "<${joined([source_name(p) for p in params], ", ")}>"
    }

    fn bound(ty: TypeRef?) -> string {
        if ty == null { "" } else { ": ${spelled(ty!)}" }
    }

    mut fn params(params: List<Param>, depth: int) -> string {
        joined([self.param(p, depth) for p in params], ", ")
    }

    /// A record's field entries as written: each `..R` ahead of the
    /// field it was written before, every entry with where it began.
    mut fn entries(fields: List<Param>, spreads: List<Spread>, depth: int) -> List<FieldEntry> {
        let spread_at = (k: int) -> [FieldEntry { lo: x.lo, text: "..${spelled(x.of)}" } for x in spreads if x.at == k]
        flatten(
            [spread_at(j)
                .concat(
                    [
                        FieldEntry {
                            lo: start_of(self.store.param_id_span(f.id)),
                            text: self.param(f, depth),
                        },
                    ],
                ) for j, f in fields],
        )
            .concat(spread_at(fields.length))
    }

    /// A declared seat as written. An event is its word and the seats
    /// it says — never the field its handler is held in.
    mut fn param(p: Param, depth: int) -> string {
        match member_of(p) {
            .Event(e) -> "${self.marks(p.marks, depth)}on ${source_name(e.name)}${self.said(e.says, depth)}",
            .Field(_) -> self.field(p, depth),
        }
    }

    /// A field or a seat as written: its marks, its word, its name, its
    /// type and its default.
    mut fn field(p: Param, depth: int) -> string {
        let name = if p.name.is_empty() { "" } else { "${source_name(p.name.of)}${if p.ty == null { "" } else { ": " }}" }
        let ty = if p.ty == null { "" } else { spelled(p.ty!) }
        let word = if p.state { "state " } else { "" }
        "${self.marks(p.marks, depth)}${word}${mark_prefixed(p.promises, name)}${ty}${self.default_value(p.default, depth)}"
    }

    /// What an event says, parenthesised — nothing for one that says
    /// nothing.
    mut fn said(says: List<Param>, depth: int) -> string {
        if says.is_empty() { return "" }
        "(${joined([self.param(s, depth) for s in says], ", ")})"
    }

    /// A member's marks as written, each with a trailing space — ""
    /// when it carries none — every argument printed as the expression
    /// it is.
    mut fn marks(ms: List<Mark>, depth: int) -> string {
        joined([self.mark(m, depth) + " " for m in ms], "")
    }

    mut fn mark(m: Mark, depth: int) -> string {
        let args = self.store.mark_args(m)
        if args.is_empty() { return "@${m.name}" }
        "@${m.name}(${joined([self.expression(a, loosest_tier, depth) for a in args], ", ")})"
    }

    mut fn default_value(value: ExprId?, depth: int) -> string {
        if value == null { "" } else { " = ${self.expression(value!, loosest_tier, depth)}" }
    }

    /// A braced body keeping the author's FORM: `one_line` is the span
    /// the form was written in (a statement's, an if-expression's, a
    /// block's), so a bare-value body — which mints no Block node —
    /// still knows whether its braces were on one line.
    mut fn block(body: ExprId, one_line: bool, depth: int) -> string {
        let end = self.block_end(body)
        match self.store.expr(body) {
            .Block(stmts, value) -> self.braced("", stmts, value, end, one_line, depth),
            rest -> self.braced("", [], body, end, one_line, depth),
        }
    }

    /// A written `{ … }`'s own closing brace, as the printer's trailing-
    /// trivia boundary — `tail_scoped` (core/store.av) narrows a
    /// one-statement scope's SPAN to its lone value's, for a diagnostic
    /// pointing at the answer, and keeps the brace's real offset beside
    /// it (`written_close`) exactly for this: a comment sitting between
    /// the value and `}` still reads as inside the scope that holds it.
    fn block_end(id: ExprId) -> int {
        self.store.written_close(id) ?? end_of(self.store.expr_span(id))
    }

    /// A braced body: its statements, its value, and the remarks that
    /// fell before its closing brace. The drain at `end` is what keeps
    /// a comment at a block's end INSIDE the braces. `head` is a
    /// trailing-block's seat line (`"x ->"`, or `""` for an ordinary
    /// block) — the one thing that stands inside the braces before
    /// the body, on the opening line.
    mut fn braced(
        head: string,
        stmts: List<StmtId>,
        value: ExprId?,
        end: int,
        one_line: bool,
        depth: int,
    ) -> string {
        let body = flatten([self.statement(s, depth + 1) for s in stmts])
        // AN ANNOTATED TAIL STAYS A STATEMENT (core/store.av's
        // `tail_scoped`): its own answer becomes the block's `value`
        // too, one node walked both ways. `stmts` already printed it
        // once; a second, unconditional value line would print it
        // twice.
        let lines = if value == null {
            body
        } else {
            let v = value!
            if self.doubled_tail(stmts, v) {
                body
            } else {
                let before = self.trivia_before(start_of(self.store.expr_span(v)), depth + 1)
                let line = source_line(depth + 1, self.expression(v, 0, depth + 1))
                // A ONE-LINE BLOCK CANNOT CARRY A TRAILING COMMENT ON
                // ITS VALUE: `//` reaches to the end of the physical
                // line, so a comment there would already have eaten
                // the closing brace — the source could not have
                // parsed. Draining the cursor only when the value
                // gets its own line is what keeps a one-liner from
                // stealing the NEXT line's remark.
                let trail = if one_line { "" } else { self.trailing() }
                body.concat(before).concat(["${line}${trail}"])
            }
        }
        let all = lines.concat(self.trivia_before(end, depth + 1))
        if all.is_empty() { return if head.is_empty() { "{}" } else { "{ ${head} }" } }
        if one_line && all.length == 1 {
            let first = unpadded(all[0], depth + 1)
            return if head.is_empty() { "{ ${first} }" } else { "{ ${head} ${first} }" }
        }
        let opening = if head.is_empty() { "{" } else { "{ ${head}" }
        "${opening}\n${joined(all, "\n")}\n${source_line(depth, "}")}"
    }

    mut fn statement_block(head: string, stmts: List<StmtId>, end: int, one_line: bool, depth: int) -> string {
        let body = flatten([self.statement(s, depth + 1) for s in stmts])
            .concat(self.trivia_before(end, depth + 1))
        if body.is_empty() { return source_line(depth, "${head} {}") }
        if one_line && body.length == 1 { return source_line(depth, "${head} { ${unpadded(body[0], depth + 1)} }") }
        "${source_line(depth, "${head} {")}\n${joined(body, "\n")}\n${source_line(depth, "}")}"
    }

    mut fn if_statement(
        cond: ExprId,
        yes: List<StmtId>,
        no: List<StmtId>,
        end: int,
        one_line: bool,
        depth: int,
    ) -> string {
        source_line(depth, self.if_tail(cond, yes, no, end, one_line, depth))
    }

    /// An `if` statement's own text, UNINDENTED — a whole statement's
    /// form (its caller wraps it in `source_line`) and an `else if`
    /// chain link's form (embedded straight after `} else `) are the
    /// same text.
    mut fn if_tail(
        cond: ExprId,
        yes: List<StmtId>,
        no: List<StmtId>,
        end: int,
        one_line: bool,
        depth: int,
    ) -> string {
        let condition = self.expression(cond, loosest_tier, depth, col_after("if ", depth * 4))
        let y = flatten([self.statement(s, depth + 1) for s in yes])
        if no.is_empty() {
            let empty = y.concat(self.trivia_before(end, depth + 1))
            if empty.is_empty() { return "if ${condition} {}" }
            if one_line && empty.length == 1 { return "if ${condition} { ${unpadded(empty[0], depth + 1)} }" }
            return "if ${condition} {\n${joined(empty, "\n")}\n${source_line(depth, "}")}"
        }
        let opened = "if ${condition} {\n${joined(y, "\n")}\n"
        let elif? = self.else_if_tail(no, end, depth) else {
            let n = flatten([self.statement(s, depth + 1) for s in no])
                .concat(self.trivia_before(end, depth + 1))
            if one_line && y.length == 1 && n.length == 1 {
                return "if ${condition} { ${unpadded(y[0], depth + 1)} } else { ${unpadded(n[0], depth + 1)} }"
            }
            return "${opened}${source_line(depth, "} else {")}\n${joined(n, "\n")}\n${source_line(depth, "}")}"
        }
        "${opened}${source_line(depth, "} else ${elif}")}"
    }

    /// `no`'s sole statement, read back as an `else if` chain link
    /// when it is one — `null` when `no` holds more than one
    /// statement, is empty, or its one statement is not an `IfStmt`,
    /// a remark stands before it (nothing can stand between `else`
    /// and `if` in the source an `else if` reads back from, so a
    /// comment there means the braces were written, not the chain),
    /// OR real braces were written around it: `else if` and `else {
    /// if … }` capture the SAME one-statement list, so the enclosing
    /// span is the only witness left — `enclosing_end` is where the
    /// caller's OWN braces read back to, and it reaches past the
    /// nested if's own end only when a real `}` stands there too.
    mut fn else_if_tail(no: List<StmtId>, enclosing_end: int, depth: int) -> string? {
        if no.length != 1 { return null }
        let s = no[0]
        if self.pending_before(start_of(self.store.stmt_span(s))) { return null }
        if enclosing_end != self.stmt_end(s) { return null }
        match self.store.stmt(s) {
            .IfStmt(c2, y2, n2) -> self.if_tail(c2, y2, n2, self.stmt_end(s), self.stmt_flat(s), depth),
            rest -> null,
        }
    }

    /// Whether a remark is still queued before `at` — a peek, never a
    /// drain: `else_if_tail` must know without moving the cursor,
    /// since deciding NOT to chain leaves the drain to `statement`.
    fn pending_before(at: int) -> bool {
        self.next < self.trivia.length && self.trivia[self.next].at < at
    }

    mut fn impl_decl(
        exported: string,
        of: string?,
        of_tparams: List<string>,
        target: string,
        target_tparams: List<string>,
        fns: List<StmtId>,
        end: int,
        one_line: bool,
        depth: int,
    ) -> string {
        let head = if of == null {
            "${exported}impl ${source_name(target)}${self.named_type_params(target_tparams)}"
        } else {
            "${exported}impl ${source_name(of!)}${self.named_type_params(of_tparams)} for ${source_name(target)}${self.named_type_params(target_tparams)}"
        }
        self.statement_block(head, fns, end, one_line, depth)
    }

    mut fn trait_decl(
        exported: string,
        name: string,
        tparams: List<string>,
        fns: List<StmtId>,
        end: int,
        one_line: bool,
        depth: int,
    ) -> string {
        let body = flatten([self.trait_member(s, depth + 1) for s in fns])
            .concat(self.trivia_before(end, depth + 1))
        if body.is_empty() {
            return source_line(
                depth,
                "${exported}trait ${source_name(name)}${self.named_type_params(tparams)} {}",
            )
        }
        if one_line && body.length == 1 {
            return source_line(
                depth,
                "${exported}trait ${source_name(name)}${self.named_type_params(tparams)} { ${unpadded(body[0], depth + 1)} }",
            )
        }
        "${source_line(depth, "${exported}trait ${source_name(name)}${self.named_type_params(tparams)} {")}\n${joined(body, "\n")}\n${source_line(depth, "}")}"
    }

    /// A trait member is a declaration head WITHOUT a statement of its
    /// own, so it repeats `statement`'s doc/remark interleave.
    mut fn trait_member(s: StmtId, depth: int) -> List<string> {
        let decl = start_of(self.store.stmt_span(s))
        let at = self.store.doc_at(s)
        let doc = if at < 0 { decl } else { at }
        let lead = self
            .trivia_before(doc, depth)
            .concat(self.doc_lines(s, depth))
            .concat(self.trivia_before(decl, depth))
        match self.store.stmt(s) {
            .FnDecl(name, tparams, params, ret, body) -> {
                let name_sig = "${self.fn_mark(s)}fn ${source_name(name.of)}${self.type_params(tparams)}"
                let params_sig = "${name_sig}${self.params_wrapped(params, depth, col_after(name_sig, depth * 4))}"
                let head = "${params_sig}${self.ret_arrow(ret, depth, col_after(params_sig, depth * 4))}"
                lead
                    .concat(
                        match self.store.expr(body) {
                            .Error -> [source_line(depth, head)],
                            rest -> [
                                source_line(
                                    depth,
                                    "${head} ${self.block(body, self.stmt_flat(s), depth)}",
                                ),
                            ],
                        },
                    )
            },
            rest -> lead.concat(self.statement_node(s, depth)),
        }
    }

    /// `grammar Name = "…"` declares a record too (features/formats/
    /// builders.av's `build_grammar_decl`), its fields exactly the
    /// format's holes — so the record alone cannot tell the sugar
    /// from a plain `type`. `store.grammar_of` is the mark: present,
    /// this prints the pattern the fields cannot spell; absent, the
    /// ordinary struct form.
    mut fn struct_or_grammar_decl(
        s: StmtId,
        exported: string,
        name: string,
        tparams: List<string>,
        fields: List<Param>,
        end: int,
        one_line: bool,
        depth: int,
    ) -> string {
        let g? = self.store.grammar_of(s) else {
            return self
                .struct_decl(
                    exported,
                    name,
                    tparams,
                    self.entries(fields, self.store.spreads_of(s), depth + 1),
                    end,
                    one_line,
                    depth,
                )
        }
        source_line(depth, "grammar ${source_name(name)} = ${format_source(g.head, g.parts)}")
    }

    /// `component Name(head) { field: T = d … fn … }` — its head in
    /// parentheses, its fields one per line, then its methods.
    mut fn component_decl(
        exported: string,
        name: string,
        head: List<Param>,
        fields: List<FieldEntry>,
        fns: List<StmtId>,
        end: int,
        depth: int,
    ) -> string {
        let sig = "${exported}component ${source_name(name)}"
        let opened = "${sig}${if head.is_empty() { "" } else { self.params_wrapped(head, depth, col_after(sig, depth * 4)) }}"
        let lines = flatten(
            [self.trivia_before(f.lo, depth + 1).concat([source_line(depth + 1, f.text)]) for f in fields],
        )
        let body = lines
            .concat(
                flatten(
                    [self.statement(s, depth + 1) for m in fns for s in self.store.member_stmts(m)],
                ),
            )
            .concat(self.trivia_before(end, depth + 1))
        if body.is_empty() { return source_line(depth, "${opened} {}") }
        "${source_line(depth, "${opened} {")}\n${joined(body, "\n")}\n${source_line(depth, "}")}"
    }

    /// `let inst = ...` UNLESS `store.mark_component_inst` marked
    /// this `let` — then it is the named instance it was written as:
    /// `table orders { … }`.
    mut fn let_or_component_inst(s: StmtId, name: string, ty: TypeRef?, value: ExprId, depth: int) -> string {
        if self.store.is_component_inst(s) { return self.component_inst("", value, name, depth) }
        let name_part = "let ${source_name(name)}"
        let prefix = "${name_part}${self.annotation_type(ty, depth, col_after(name_part, depth * 4))} = "
        source_line(
            depth,
            "${prefix}${self.expression(value, loosest_tier, depth, col_after(prefix, depth * 4))}",
        )
    }

    /// A named instance, re-spelled `word name { … }` — a marked
    /// statement always binds an instance, so any other value here
    /// would be a builder defect; the fallback still answers something
    /// parseable rather than trapping the printer.
    mut fn component_inst(exported: string, value: ExprId, inst: string, depth: int) -> string {
        match self.store.expr(value) {
            .Component(word, _, block, _, _) -> source_line(
                depth,
                exported +
                    joined(
                        [source_name(word), source_name(inst)]
                            .concat([self.instance_body(b, depth) for b in some_list(block)]),
                        " ",
                    ),
            ),
            rest -> {
                let prefix = "let ${source_name(inst)} = "
                source_line(
                    depth,
                    "${prefix}${self.expression(value, loosest_tier, depth, col_after(prefix, depth * 4))}",
                )
            },
        }
    }

    mut fn struct_decl(
        exported: string,
        name: string,
        tparams: List<string>,
        fields: List<FieldEntry>,
        end: int,
        one_line: bool,
        depth: int,
    ) -> string {
        let head = "${exported}type ${source_name(name)}${self.named_type_params(tparams)}"
        if fields.is_empty() { return source_line(depth, "${head} = {}") }
        if one_line { return source_line(depth, "${head} = { ${joined([f.text for f in fields], ", ")} }") }
        let body = flatten(
            [self.trivia_before(f.lo, depth + 1).concat([source_line(depth + 1, "${f.text},")]) for f in fields],
        )
            .concat(self.trivia_before(end, depth + 1))
        "${source_line(depth, "${head} = {")}\n${joined(body, "\n")}\n${source_line(depth, "}")}"
    }

    mut fn enum_decl(
        exported: string,
        name: string,
        tparams: List<string>,
        variants: List<Variant>,
        end: int,
        one_line: bool,
        depth: int,
    ) -> string {
        let head = "${exported}enum ${source_name(name)}${self.named_type_params(tparams)}"
        if variants.is_empty() { return source_line(depth, "${head} {}") }
        if one_line {
            return source_line(
                depth,
                "${head} { ${joined([self.variant(v, depth) for v in variants], ", ")} }",
            )
        }
        let body = flatten(
            [self
                .trivia_before(start_of(v.span), depth + 1)
                .concat([source_line(depth + 1, self.variant(v, depth + 1))]) for v in variants],
        )
            .concat(self.trivia_before(end, depth + 1))
        "${source_line(depth, "${head} {")}\n${joined(body, "\n")}\n${source_line(depth, "}")}"
    }

    mut fn variant(v: Variant, depth: int) -> string {
        let head = "${self.marks(v.marks, depth)}${source_name(v.name.of)}"
        if v.payloads.is_empty() { return head }
        "${head}${self.params_wrapped(v.payloads, depth, col_after(head, depth * 4))}"
    }

    mut fn spec_decl(name: string, cases: List<Case>, end: int, one_line: bool, depth: int) -> string {
        let body = flatten([self.given_lines(g, one_line, depth + 1) for g in grouped_cases(cases)])
            .concat(self.trivia_before(end, depth + 1))
        if body.is_empty() { return source_line(depth, "spec ${quoted_text(name)} {}") }
        if one_line && body.length == 1 {
            return source_line(
                depth,
                "spec ${quoted_text(name)} { ${unpadded(body[0], depth + 1)} }",
            )
        }
        "${source_line(depth, "spec ${quoted_text(name)} {")}\n${joined(body, "\n")}\n${source_line(depth, "}")}"
    }

    /// A collect's projection prints as a struct literal over `it`
    /// paths — empty the bare declaration — and its order as the
    /// `it.field` list `by` named.
    fn collect_decl(
        exported: string,
        name: string,
        ty: TypeRef,
        kind: CollectKind,
        scope: CollectScope,
        proj: Projection,
        order: List<Plain>,
        dense: bool,
    ) -> string {
        let fields = joined([self.collect_field(f.field.of, f.path) for f in proj.fields], ", ")
        let by = self.collect_order_text(order, dense)
        "${exported}collect ${source_name(name)}: ${spelled(ty)} = ${self.collect_kind_word(kind)} in ${self.collect_scope_word(scope)} as ${proj.ty.name} { ${fields} }${by}"
    }

    /// The `by …` tail a collect prints, `dense` included — the same
    /// spelling its own grammar reads back.
    fn collect_order_text(order: List<Plain>, dense: bool) -> string {
        if order.is_empty() { return "" }
        let tail = if dense { " dense" } else { "" }
        " by ${joined(["it.${k.of}" for k in order], ", ")}${tail}"
    }

    /// `collect enum Name = kind in scope by …` — `collect_decl`'s
    /// twin with no declared type and no projection.
    fn collect_enum_decl(
        exported: string,
        name: string,
        kind: CollectKind,
        scope: CollectScope,
        order: List<Plain>,
        dense: bool,
    ) -> string {
        let by = self.collect_order_text(order, dense)
        "${exported}collect enum ${source_name(name)} = ${self.collect_kind_word(kind)} in ${self.collect_scope_word(scope)}${by}"
    }

    /// One case's `then` line, standing alone (its group is empty).
    /// `c.span` covers the whole `then "name" { … }`, never `c.body`'s
    /// own — a one-statement body's Block wears the ANSWER's span (so
    /// a diagnostic about it points at the answer, never the braces:
    /// `tail_scoped`, core/store.av), which reads a multi-line body as
    /// flat whenever its one statement happens to fit one line itself.
    mut fn then_line(c: Case, at: int) -> List<string> {
        self
            .trivia_before(start_of(c.span), at)
            .concat(
                [
                    source_line(
                        at,
                        "then ${quoted_text(c.name)} ${self.block(c.body, self.span_flat(c.span), at)}",
                    ),
                ],
            )
    }

    /// A `given` group's lines: every case it holds shares ONE
    /// wrapper, as the author wrote them — a spec the author wrote on
    /// one line keeps `given g { then n { … } }` as written, and a
    /// bare `then` (an empty group) wraps nothing.
    ///
    /// THE LEAD IS DRAINED AT THE WRAPPER'S OWN DEPTH, before `given`
    /// prints, and ONLY UP TO THE WRAPPER'S OWN BRACE: two blank runs
    /// can stand in the gap before a `given` — one before the
    /// keyword, at THIS depth, one after its `{`, at the case's
    /// deeper depth (a blank line kept for breathing room before the
    /// first `then` — this file's own style) — and `given`'s own
    /// span is nowhere recorded (`Case.span` covers `then` alone), so
    /// `given_split` finds the brace in the TEXT instead. Draining
    /// everything to `depth` in one sweep, as `then_line`'s own call
    /// already did for the WHOLE gap, moves whichever run stands
    /// after the brace one level too shallow. Without text
    /// (`render_source`, no written form to keep) the split cannot be
    /// found and the sweep is skipped; `then_line`'s own call still
    /// reaches every remark, at its one depth.
    mut fn given_lines(g: CaseGroup, one_line: bool, depth: int) -> List<string> {
        if g.group.is_empty() { return self.then_line(g.cases[0], depth) }
        let target = start_of(g.cases[0].span)
        let lead = self.trivia_before(self.given_split(target), depth)
        let at = depth + 1
        let thens = flatten([self.then_line(c, at) for c in g.cases])
        if one_line && thens.length == 1 {
            return lead
                .concat(
                    [
                        source_line(
                            depth,
                            "given ${quoted_text(g.group)} { ${unpadded(thens[0], at)} }",
                        ),
                    ],
                )
        }
        lead
            .concat([source_line(depth, "given ${quoted_text(g.group)} {")])
            .concat(thens)
            .concat([source_line(depth, "}")])
    }

    /// Where a `given` wrapper's own leading trivia ends: its own
    /// opening brace, the ONE real token standing between the two
    /// gaps — `given`'s own span is nowhere recorded, so this looks
    /// for the brace in the TEXT instead, the LAST one before
    /// `target`. THE SEARCH NEVER READS INSIDE A COMMENT'S OWN WORDS:
    /// one quoting source (`` `grammar { "s" }` ``) carries a `{` that
    /// is not syntax, and a naive scan found exactly that brace once,
    /// splicing one written comment in two. `lo` is where the last
    /// already-drained remark's own text ENDS (`comment_end` — a
    /// `Comment` there is skipped whole, never re-entered; the file's
    /// start when nothing has drained yet), never the brace's OWN
    /// remark's start, which would skip past it entirely and find
    /// nothing before it — reproducing the very split this exists to
    /// avoid. No text in hand answers `target` itself — the sweep
    /// then finds nothing before it, same as asking for nothing.
    fn given_split(target: int) -> int {
        let t? = self.text else { return target }
        let lo = if self.next == 0 { 0 } else { comment_end(self.trivia[self.next - 1]) }
        let cuts = [r for i, r in self.trivia if i >= self.next && r.at < target && is_comment(r)]
        let found = [b! for b in [window_brace(t, w) for w in safe_windows(cuts, lo, target)] if b != null]
            .last()
        if found == null { target } else { found! + 1 }
    }

    /// The source a zero-seat lambda was written as — `defer e`'s and
    /// `spawn e`'s `e`.
    mut fn written_body(body: ExprId, depth: int) -> string {
        match self.store.expr(body) {
            .Lambda(params, value) if params.is_empty() -> self.expression(value, loosest_tier, depth),
            rest -> self.expression(body, loosest_tier, depth),
        }
    }

    fn loop_binds(index: string?, name: string) -> string {
        if index == null { source_name(name) } else { "${source_name(index!)}, ${source_name(name)}" }
    }

    /// The expression registry: every Expr variant has one source form.
    /// `parent` is the tier the SITE demands; a form tighter than its
    /// site needs no group.
    /// `col` is the exact column this expression begins at, when the
    /// caller knows it — a statement's own prefix, a signature's own
    /// name, an operand already measured against its sibling — and
    /// `-1` (`resolved_col`'s fallback) when it does not: an item
    /// rendered as one of a comma list or a chain BEFORE that list
    /// decides flat or broken, where no caller can know better without
    /// looking ahead.
    mut fn expression(id: ExprId, parent: int, depth: int, col: int = -1) -> string {
        let c = resolved_col(col, depth)
        let piped = self.pipe_walk(id, depth)
        if !piped.links.is_empty() { return self.pipe_rendered(piped, parent, depth, c) }
        match self.store.expr(id) {
            // A negative literal is stored folded, but it still has
            // unary precedence on the page: `(-3).field` must keep
            // its group or it reads back as `-(3.field)`.
            .IntLit(value) -> numeric("${value}", parent),
            .FloatLit(bits) -> numeric(avra_float_text_bits(bits), parent),
            .StrLit(value) -> grouped(self.str_lit_text(id, value), atom_tier, parent),
            .BytesLit(spelled) -> grouped("b\"${spelled}\"", atom_tier, parent),
            .Range(lo, hi) -> grouped(
                "(${self.expression(lo, loosest_tier, depth, c + 1)}..${self.expression(hi, loosest_tier, depth, c + 1)})",
                atom_tier,
                parent,
            ),
            .BoolLit(value) -> grouped(if value { "true" } else { "false" }, atom_tier, parent),
            .Ident(name) -> grouped(source_name(name.of), atom_tier, parent),
            .Receiver -> grouped("self", atom_tier, parent),
            .Binary(op, left, right) -> self.binary(op, left, right, parent, depth, c),
            .Not(value) -> grouped("!${self.expression(value, unary_tier, depth, c + 1)}", unary_tier, parent),
            .ListLit(elems) -> grouped(self.list_lit_text(id, elems, depth, c), atom_tier, parent),
            .Comp(elem, clauses) -> self.comprehension(elem, clauses, parent, depth),
            .MapLit(keys, values) -> grouped(self.map_lit_text(id, keys, values, depth, c), atom_tier, parent),
            .Index(subject, index) -> {
                let s = self.expression(subject, postfix_tier, depth, c)
                grouped(
                    "${s}[${self.expression(index, loosest_tier, depth, col_after(s, c) + 1)}]",
                    postfix_tier,
                    parent,
                )
            },
            .Prop(_, _) -> self.chain_rendered(id, parent, depth, c),
            .Body(word, parts, holes, _) -> {
                let text = self.body_text(word, parts, holes, depth)
                self.skip_trivia_within(end_of(self.store.expr_span(id)))
                grouped(text, atom_tier, parent)
            },
            // A COMPONENT INSTANCE BINDS LOOSEST: its HEAD is an
            // expression, so a following `.` chain or binary operator is
            // swallowed into the head — `text "hi".describe()` reads as
            // `text ("hi".describe())`. Loosest tier forces the group
            // wherever anything follows it.
            .Component(word, heads, block, _, _) -> grouped(self.keyed_instance(id, word, heads, block, depth), loosest_tier, parent),
            .If(cond, yes, no) -> grouped(self.if_group(cond, yes, no, id, depth, c), atom_tier, parent),
            .When(conds, values, fallback) -> grouped(
                self.when_expr(conds, values, fallback, end_of(self.store.expr_span(id)), depth),
                atom_tier,
                parent,
            ),
            .Block(stmts, value) -> grouped(self.block_expr(stmts, value, id, depth), atom_tier, parent),
            .Collect(body) -> grouped(self.instance("collect", [body], null, depth), loosest_tier, parent),
            .Call(callee, pins, args) -> {
                let head = "${source_name(callee.of)}${self.pins(pins)}"
                grouped(
                    "${head}${self.call_tail(args, depth, col_after(head, c))}",
                    atom_tier,
                    parent,
                )
            },
            .Named(name, value) -> {
                let head = "${source_name(name.of)}: "
                grouped(
                    "${head}${self.expression(value, loosest_tier, depth, col_after(head, c))}",
                    loosest_tier,
                    parent,
                )
            },
            .StructLit(name, fields, values) -> grouped(self.struct_lit_text(id, name.of, fields, values, depth, c), atom_tier, parent),
            .With(subject, fields, values) -> grouped(
                "${self.expression(subject, with_tier, depth, c)} with { ${joined(["${source_name(f.of)}: ${self.expression(values[j], loosest_tier, depth)}" for j, f in fields], ", ")} }",
                with_tier,
                parent,
            ),
            .Match(subject, arms) -> grouped(self.match_or_payload_if(subject, arms, id, depth, c), atom_tier, parent),
            .NullLit -> grouped("null", atom_tier, parent),
            .Coalesce(left, right) -> {
                let l = self.expression(left, 5, depth, c)
                grouped(
                    "${l} ?? ${self.expression(right, pipe_tier, depth, col_after(l, c) + 4)}",
                    5,
                    parent,
                )
            },
            .MatchOpt(subject, bind, present, absent) -> self
                .match_optional(
                    subject,
                    bind.of,
                    present,
                    absent,
                    parent,
                    end_of(self.store.expr_span(id)),
                    depth,
                    c,
                ),
            // A LAMBDA RIDING THE PRONOUN HAS NO HEADER: `it` was
            // never written as `(it) ->` — the wrap is the sugar's
            // whole mechanism (core/store.av's `pronouned`), and its
            // param carries no span because nothing minted one.
            .Lambda(params, body) if is_pronoun(params) -> self.expression(body, parent, depth, c),
            .Lambda(params, body) -> {
                let head = self.params_wrapped(params, depth, c)
                grouped(
                    "${head} -> ${self.expression(body, loosest_tier, depth, col_after(head, c) + 4)}",
                    atom_tier,
                    parent,
                )
            },
            .Spawn(body) -> grouped("spawn ${self.written_body(body, depth)}", loosest_tier, parent),
            // Parentheses preserve VALUE application. Without the
            // witness, `(f)(x)` would print `f(x)` and read back as
            // the direct, declaration-resolved Call variant.
            .CallValue(subject, args) -> {
                let head = "(${self.expression(subject, loosest_tier, depth, c + 1)})"
                grouped(
                    "${head}${self.call_tail(args, depth, col_after(head, c))}",
                    postfix_tier,
                    parent,
                )
            },
            .Chain(subject, name) -> grouped(
                "${self.chain_subject(subject, depth, c)}?.${source_name(name.of)}",
                postfix_tier,
                parent,
            ),
            .Force(value) -> grouped("${self.expression(value, postfix_tier, depth, c)}!", postfix_tier, parent),
            .Is(subject, variant) -> {
                let payload: PayloadIs? = self.store.is_payload(id)
                if payload != null {
                    grouped(
                        "${self.expression(subject, 5, depth, c)} is ${self.pattern(payload!.pat, depth)}",
                        4,
                        parent,
                    )
                } else {
                    grouped(
                        "${self.expression(subject, 5, depth, c)} is .${source_name(variant.of)}",
                        4,
                        parent,
                    )
                }
            },
            .VariantLit(name, args) -> {
                let head = ".${source_name(name.of)}"
                grouped(
                    "${head}${if args.is_empty() { "" } else { self.args_wrapped(args, depth, col_after(head, c)) }}",
                    atom_tier,
                    parent,
                )
            },
            .Propagate(value) -> grouped("${self.chain_subject(value, depth, c)}?", postfix_tier, parent),
            .Catch(subject, variants, binds, values) -> grouped(
                self
                    .catch_expr(
                        subject,
                        [t.of for t in variants],
                        [t.of for t in binds],
                        values,
                        end_of(self.store.expr_span(id)),
                        depth,
                        c,
                    ),
                1,
                parent,
            ),
            .MethodCall(_, _, _) -> self.chain_rendered(id, parent, depth, c),
            .Env(tr) -> grouped("env ${spelled(tr)}", atom_tier, parent),
            .Error -> grouped("__error", atom_tier, parent),
        }
    }

    /// Whether a width decision may decide THIS span at all: a width
    /// decision never drains trivia (`wrapped_list` only ever sees
    /// plain rendered strings), so a comment standing inside would be
    /// left undrained and land wherever the file prints next.
    /// `pending_before` peeks without consuming, so asking costs
    /// nothing when it says no comment waits.
    fn width_decides(span: Span?) -> bool {
        !self.pending_before(end_of(span))
    }

    /// A bracketed comma list, width-decided: flat when it fits
    /// `canonical_width`, one item per line with a trailing comma
    /// otherwise, via the document algebra. `spaced` is `wrapped_list`'s
    /// own flat padding, kept in sync with `comma_list`'s. `col` is
    /// where `open` itself begins on the physical line — exact when
    /// the caller knows it, `resolved_col`'s fallback otherwise.
    fn wrapped_list(
        open: string,
        items: List<string>,
        close: string,
        spaced: bool,
        depth: int,
        col: int = -1,
    ) -> string {
        render_doc_at(
            comma_list(open, [text(it) for it in items], close, spaced),
            self.layout_width(),
            depth * 4,
            resolved_col(col, depth),
        )
    }

    /// A parameter list's parentheses — a fn's, a lambda's, a
    /// component head's, an enum variant's payload. `col` is where the
    /// list's own `(` begins; its PARAMS are each rendered before the
    /// list decides flat or broken, so they take the fallback column
    /// — but at `depth + 1`, the indent a param LANDS at once the
    /// list breaks: a param that is itself wide enough to need its
    /// own wrap must nest one level past this list's own bracket, or
    /// its closer dedents to a column shallower than its own opener,
    /// and a broken chain step no longer reads DEEPER than the line
    /// it continues — which the lexer reads back as two statements.
    mut fn params_wrapped(params: List<Param>, depth: int, col: int = -1) -> string {
        self.wrapped_list("(", [self.param(p, depth + 1) for p in params], ")", false, depth, col)
    }

    /// A call's argument parentheses, wrapping-decided the same way.
    mut fn args_wrapped(args: List<ExprId>, depth: int, col: int = -1) -> string {
        self
            .wrapped_list(
                "(",
                [self.expression(a, loosest_tier, depth + 1) for a in args],
                ")",
                false,
                depth,
                col,
            )
    }

    /// `e`'s run of `op` operands, left to right — the SAME operator
    /// only: a different one (a mixed `+`/`-` run, say) stops the
    /// walk and stands as one opaque operand, exactly as it always
    /// rendered.
    fn chain_operands(op: BinOp, e: ExprId) -> List<ExprId> {
        match self.store.expr(e) {
            .Binary(o2, l, r) if o2 == op -> self.chain_operands(op, l).concat([r]),
            rest -> [e],
        }
    }

    /// A chainable binary run (`&&`, `||`, `+`), width-decided. Every
    /// operand but the first prints at the tier `binary` always gave
    /// a right-hand side (`p + 1`); the first prints at the tier
    /// `binary` gave the OUTERMOST left (`p`, since none of these
    /// three is a comparison) — the flattening stops at the first
    /// operand that is not this same operator, so that operand is the
    /// one spot the old left/right asymmetry still matters. `col` is
    /// where the FIRST operand begins; every operand is rendered
    /// before the chain decides flat or broken, so each takes the
    /// fallback — only the chain's OWN column, measured against
    /// `col`, needs to be exact.
    mut fn chain_grouped(
        op: BinOp,
        left: ExprId,
        right: ExprId,
        p: int,
        parent: int,
        depth: int,
        col: int = -1,
    ) -> string {
        let operands = self.chain_operands(op, left).concat([right])
        let docs = [text(self.expression(operands[j], if j == 0 { p } else { p + 1 }, depth + 1)) for j in 0..operands.length]
        let rendered = render_doc_at(
            chain_doc(op_symbol(op), docs),
            self.layout_width(),
            depth * 4,
            resolved_col(col, depth),
        )
        if p < parent { "(${rendered})" } else { rendered }
    }

    /// A list's text: the header and rows `table<Row> { … }`
    /// desugared into (`store.table_of` — a row type and header the
    /// rows' own fields cannot answer once the table is empty), or
    /// the ordinary bracketed list, ONE LINE OR MANY as it was
    /// written — the written-layout rule `struct_decl`/`enum_decl`
    /// already use for a declaration's own fields and variants,
    /// generalized here: each element drains the trivia before its
    /// own span first, exactly as a declaration's does, so a comment
    /// between two elements stays between them instead of sliding to
    /// the literal's end.
    mut fn list_lit_text(id: ExprId, elems: List<ExprId>, depth: int, col: int = -1) -> string {
        let tbl? = self.store.table_of(id) else {
            if elems.is_empty() { return "[]" }
            let span = self.store.expr_span(id)
            if self.width_decides(span) {
                return self
                    .wrapped_list(
                        "[",
                        [self.expression(e, loosest_tier, depth + 1) for e in elems],
                        "]",
                        false,
                        depth,
                        col,
                    )
            }
            if self.span_flat(span) { return "[${joined([self.expression(e, loosest_tier, depth) for e in elems], ", ")}]" }
            let body = flatten(
                [self
                    .trivia_before(start_of(self.store.expr_span(e)), depth + 1)
                    .concat(
                        [
                            source_line(
                                depth + 1,
                                "${self.expression(e, loosest_tier, depth + 1)},",
                            ),
                        ],
                    ) for e in elems],
            )
                .concat(self.trivia_before(end_of(self.store.expr_span(id)), depth + 1))
            return "[\n${joined(body, "\n")}\n${source_line(depth, "]")}"
        }
        self.table_text(tbl.row_type, tbl.header, elems, depth)
    }

    /// A map's text, one line or many as it was written — an entry
    /// drains the trivia before its KEY's span, the entry's own start.
    mut fn map_lit_text(
        id: ExprId,
        keys: List<ExprId>,
        values: List<ExprId>,
        depth: int,
        col: int = -1,
    ) -> string {
        if keys.is_empty() { return "{}" }
        let span = self.store.expr_span(id)
        if self.width_decides(span) {
            return self
                .wrapped_list(
                    "{",
                    ["${self.expression(k, loosest_tier, depth + 1)}: ${self.expression(values[j], loosest_tier, depth + 1)}" for j, k in keys],
                    "}",
                    false,
                    depth,
                    col,
                )
        }
        if self.span_flat(span) { return "{${joined(["${self.expression(k, loosest_tier, depth)}: ${self.expression(values[j], loosest_tier, depth)}" for j, k in keys], ", ")}}" }
        let body = flatten(
            [self
                .trivia_before(start_of(self.store.expr_span(k)), depth + 1)
                .concat(
                    [
                        source_line(
                            depth + 1,
                            "${self.expression(k, loosest_tier, depth + 1)}: ${self.expression(values[j], loosest_tier, depth + 1)},",
                        ),
                    ],
                ) for j, k in keys],
        )
            .concat(self.trivia_before(end_of(self.store.expr_span(id)), depth + 1))
        "{\n${joined(body, "\n")}\n${source_line(depth, "}")}"
    }

    /// The table's lines, each column padded to its own widest cell
    /// (header included) EXCEPT the last, which ends the line instead
    /// — `avra fmt --write`'s receipt is blind to intra-line spacing
    /// (BREAK is the only whitespace token), so a hand-typed file
    /// whose columns drifted realigns the first time it is written,
    /// never drifting back.
    mut fn table_text(row_type: string, header: List<string>, elems: List<ExprId>, depth: int) -> string {
        let rows = [self.table_row(e, depth) for e in elems]
        let widths = [col_width(j, header, rows) for j in 0..header.length]
        let lines = [padded_row(header, widths)].concat([padded_row(r, widths) for r in rows])
        "table<${row_type}> {\n${joined([source_line(depth + 1, l) for l in lines], "\n")}\n${source_line(depth, "}")}"
    }

    /// One row's cells, rendered — a table's own row is always a
    /// `StructLit` (`features/tables/builders.av`'s `build_table`);
    /// the catch-all is the builder's own invariant, never a program's.
    mut fn table_row(e: ExprId, depth: int) -> List<string> {
        match self.store.expr(e) {
            .StructLit(name, fields, values) -> [self.expression(v, cell_tier, depth) for v in values],
            rest -> [],
        }
    }

    /// A struct literal's text: the DSL text an expression-position
    /// `grammar { … }` read, for the `Grammar` literal it fully
    /// expanded into (`store.grammar_lit_of` — the raw block's own
    /// words, never rebuilt from the expansion), the ordinary
    /// field-list form otherwise.
    mut fn struct_lit_text(
        id: ExprId,
        name: string,
        fields: List<Plain>,
        values: List<ExprId>,
        depth: int,
        col: int = -1,
    ) -> string {
        let text? = self.store.grammar_lit_of(id) else {
            let head = "${source_name(name)} "
            return "${head}${self.struct_fields_text(id, fields, values, depth, col_after(head, resolved_col(col, depth)))}"
        }
        "grammar {${text}}"
    }

    /// A struct literal's braced fields, one line or many as written
    /// — a field name carries no span of its own (`Plain` is a bare
    /// name), so an entry drains the trivia before its VALUE's span;
    /// the value always starts later than the field's own name, so a
    /// comment before the name is still before that offset too.
    mut fn struct_fields_text(
        id: ExprId,
        fields: List<Plain>,
        values: List<ExprId>,
        depth: int,
        col: int = -1,
    ) -> string {
        if fields.is_empty() { return "{}" }
        let span = self.store.expr_span(id)
        if self.width_decides(span) {
            return self
                .wrapped_list(
                    "{",
                    ["${source_name(f.of)}: ${self.expression(values[j], loosest_tier, depth + 1)}" for j, f in fields],
                    "}",
                    true,
                    depth,
                    col,
                )
        }
        if self.span_flat(span) { return "{ ${joined(["${source_name(f.of)}: ${self.expression(values[j], loosest_tier, depth)}" for j, f in fields], ", ")} }" }
        let body = flatten(
            [self
                .trivia_before(start_of(self.store.expr_span(values[j])), depth + 1)
                .concat(
                    [
                        source_line(
                            depth + 1,
                            "${source_name(f.of)}: ${self.expression(values[j], loosest_tier, depth + 1)},",
                        ),
                    ],
                ) for j, f in fields],
        )
            .concat(self.trivia_before(end_of(self.store.expr_span(id)), depth + 1))
        "{\n${joined(body, "\n")}\n${source_line(depth, "}")}"
    }

    /// A string literal's text: `"""raw"""` for the node the lexer's
    /// triple-quote scan marked (`store.is_raw_string` — its own
    /// delimiter, never backslash-escaped, since a raw string holds
    /// no escapes to spell), the ordinary quoted-and-escaped form
    /// otherwise.
    fn str_lit_text(id: ExprId, value: string) -> string {
        if self.store.is_raw_string(id) { "\"\"\"${value}\"\"\"" } else { quoted_text(value) }
    }

    /// A Match an `if` desugared, or a plain `match` — the mark is the
    /// only difference, and the printer never drops it.
    mut fn match_or_payload_if(
        subject: ExprId,
        arms: List<Arm>,
        id: ExprId,
        depth: int,
        col: int = -1,
    ) -> string {
        let payload? = self.store.is_payload(id) else { return self.match_expr(subject, arms, id, depth, col) }
        self.payload_if(subject, arms, payload, id, depth, col)
    }

    /// The `if x is .V(p) { A } else { B }` the Match desugared from.
    /// The arm values ARE blocks (the branches as written), so `block`
    /// renders them whole; an elseless guard omits the `else`.
    mut fn payload_if(
        subject: ExprId,
        arms: List<Arm>,
        payload: PayloadIs,
        id: ExprId,
        depth: int,
        col: int = -1,
    ) -> string {
        let one = self.span_flat(self.store.expr_span(id))
        let cond = "${self.expression(subject, 5, depth, resolved_col(col, depth) + 3)} is ${self.pattern(payload.pat, depth)}"
        let yes = self.block(arms[0].value, one, depth)
        if !payload.has_else { return "if ${cond} ${yes}" }
        "if ${cond} ${yes} else ${self.if_group_else(arms[1].value, one, depth)}"
    }

    /// The chained form of `payload_if` — a marked Match in an else
    /// position prints `else if …`, never `else { match … }`.
    mut fn chained_payload_if(subject: ExprId, arms: List<Arm>, id: ExprId, depth: int) -> string? {
        let payload? = self.store.is_payload(id) else { return null }
        self.payload_if(subject, arms, payload, id, depth)
    }

    /// An if EXPRESSION's branches, one-line when the whole form was.
    mut fn if_group(cond: ExprId, yes: ExprId, no: ExprId, id: ExprId, depth: int, col: int = -1) -> string {
        let one = self.span_flat(self.store.expr_span(id))
        "if ${self.expression(cond, loosest_tier, depth, resolved_col(col, depth) + 3)} ${self.block(yes, one, depth)} else ${self.if_group_else(no, one, depth)}"
    }

    /// An if-EXPRESSION's else branch — chained straight into another
    /// `if_group` when it IS one (an `else if` link, this form's
    /// twin of `else_if_tail`), so a written chain reprints as the
    /// chain it was rather than nesting one bare block inside
    /// another: `block`'s OWN fallback for a non-`.Block` value
    /// wraps ANY expression in `{ }`, which is exactly right for an
    /// ordinary `else` value and exactly wrong for a NESTED `if` —
    /// the lossless receipt refuses the extra braces it were to add.
    /// `one` rides from the WHOLE if-expression's own flatness, the
    /// same flag `yes` prints under — an else branch judged by its
    /// OWN (shorter) span collapses to one line while its sibling
    /// stays multi-line, two branches of one written form disagreeing
    /// about their shared layout.
    mut fn if_group_else(no: ExprId, one: bool, depth: int) -> string {
        let chain? = self.chained_if(no, depth) else { return self.block(no, one, depth) }
        chain
    }

    mut fn chained_if(no: ExprId, depth: int) -> string? {
        if self.pending_before(start_of(self.store.expr_span(no))) { return null }
        match self.store.expr(no) {
            .If(c2, y2, n2) -> self.if_group(c2, y2, n2, no, depth),
            // a payload `if` desugared into a marked Match chains as the
            // `if` it was, exactly as a nested `Expr.If` does
            .Match(subject, arms) -> self.chained_payload_if(subject, arms, no, depth),
            // A NESTED "else if" (its own if a STATEMENT, chain_value's
            // promotion) answers through `tail_scoped`'s lone-tail wrap
            // (core/store.av), so the chain link this sees is
            // `Block([], If(...))`, never `If(...)` bare. A written
            // `else { if … }` wraps the SAME shape, so the two are told
            // apart by `written_close` (`block_end`): a real brace sits
            // STRICTLY PAST the wrapped value's own span, where a
            // synthetic wrap's end IS that span — see through only then.
            .Block(stmts, value) -> if stmts.is_empty() &&
                value != null &&
                self.block_end(no) == end_of(self.store.expr_span(value!)) {
                self.chained_if(value!, depth)
            } else {
                null
            },
            rest -> null,
        }
    }

    /// A block EXPRESSION's braces, its written form and its end.
    mut fn block_expr(stmts: List<StmtId>, value: ExprId?, id: ExprId, depth: int) -> string {
        self
            .braced("", stmts, value, self.block_end(id), self.span_flat(self.store.expr_span(id)), depth)
    }

    /// A setting as written: the `on <event> { … }` sugar when the
    /// value is the lambda the instance-body handler built,
    /// else `name: value`. The mark is the ONE way the printer tells a
    /// handler from an ordinary closure, so the sugar round-trips.
    mut fn setting(name: string, value: ExprId, depth: int) -> List<string> {
        let kind? = self.store.on_handler_kind(value) else {
            let prefix = "${source_name(name)}: "
            return [
                source_line(
                    depth,
                    "${prefix}${self.expression(value, loosest_tier, depth, col_after(prefix, depth * 4))}",
                ),
            ]
        }
        match self.store.expr(value) {
            .Lambda(params, body) -> [source_line(depth, "on ${kind} ${self.trailing_lambda(params, body, value, depth)}")],
            rest -> {
                let prefix = "on ${kind}: "
                [
                    source_line(
                        depth,
                        "${prefix}${self.expression(value, loosest_tier, depth, col_after(prefix, depth * 4))}",
                    ),
                ]
            },
        }
    }

    mut fn binary(op: BinOp, left: ExprId, right: ExprId, parent: int, depth: int, col: int = -1) -> string {
        let p = binary_precedence(op)
        if chainable(op) { return self.chain_grouped(op, left, right, p, parent, depth, col) }
        // Comparisons do not chain. The bitwise band does, but the
        // language deliberately refuses a run mixing operators; a
        // mixed left child therefore needs its group even though a
        // conventional precedence table would drop it.
        let lp = if comparison(op) || self.mixed_bitwise(op, left) { p + 1 } else { p }
        grouped(
            "${self.expression(left, lp, depth, col)} ${op_symbol(op)} ${self.expression(right, p + 1, depth)}",
            p,
            parent,
        )
    }

    fn mixed_bitwise(op: BinOp, left: ExprId) -> bool {
        if !bitwise(op) { return false }
        match self.store.expr(left) {
            .Binary(held, _, _) -> bitwise(held) && op_symbol(held) != op_symbol(op),
            rest -> false,
        }
    }

    mut fn comprehension(elem: ExprId, clauses: List<CompClause>, parent: int, depth: int) -> string {
        let element = self.expression(elem, loosest_tier, depth)
        let clause_text = joined([self.comp_clause_text(c, depth) for c in clauses], " ")
        grouped("[${element} ${clause_text}]", atom_tier, parent)
    }

    /// One clause, as written: a head's binds and range, or a filter's
    /// condition.
    mut fn comp_clause_text(c: CompClause, depth: int) -> string {
        match c {
            .Head(index, name, source, hi) -> {
                let binds = self.loop_binds(index?.of, name.of)
                let range = if hi == null { self.expression(source, loosest_tier, depth) } else { "${self.expression(source, loosest_tier, depth)}..${self.expression(hi!, loosest_tier, depth)}" }
                "for ${binds} in ${range}"
            },
            .Filter(cond) -> "if ${self.expression(cond, loosest_tier, depth)}",
        }
    }

    /// `quote { … }` — the runs as written, the holes re-spelled.
    /// A block's body with each `${k}` placeholder shown as the hole it
    /// names.
    /// A hole-bearing body in the surface its WORD names, from the one
    /// registry: a string, a `quote { … }`, or a word's own block.
    /// A component instance as written: its word, its head values, its
    /// block.
    mut fn instance(word: string, heads: List<ExprId>, block: ExprId?, depth: int) -> string {
        joined(
            [source_name(word)]
                .concat([self.head(e, depth) for e in heads])
                .concat([self.instance_body(b, depth) for b in some_list(block)]),
            " ",
        )
    }

    /// An instance's body: its block, or a fn's braces with its `req ->`
    /// head inside them.
    mut fn instance_body(b: ExprId, depth: int) -> string {
        match self.store.expr(b) {
            .Lambda(params, body) -> self.trailing_lambda(params, body, b, depth),
            rest -> self.expression(b, loosest_tier, depth),
        }
    }

    /// A component instance as written: a keyed list states its `by`
    /// head between its source and its block, every other instance its
    /// word, head values and block.
    mut fn keyed_instance(id: ExprId, word: string, heads: List<ExprId>, block: ExprId?, depth: int) -> string {
        let key? = self.store.keyed_list_key(id) else { return self.instance(word, heads, block, depth) }
        joined(
            [source_name(word)]
                .concat([self.expression(e, loosest_tier, depth) for e in heads])
                .concat(["by it.${self.keyed_field(key)}"])
                .concat([self.instance_body(b, depth) for b in some_list(block)]),
            " ",
        )
    }

    /// The field a keyed list's `by it.<field>` clause names.
    fn keyed_field(key: ExprId) -> string {
        match self.store.expr(key) { .Prop(_, name) -> name.of, rest -> "" }
    }

    mut fn body_text(word: string, parts: List<string>, holes: List<ExprId>, depth: int) -> string {
        match body_behavior(word) {
            .Text -> self.interpolation(parts, holes, depth),
            .Quote -> self.quotation(parts, holes, depth),
            .Foreign -> "${source_name(word)} {${self.filled_parts(parts, holes, depth)}}",
        }
    }

    /// A block body's runs with each hole re-spelled as its expression.
    mut fn filled_parts(parts: List<string>, holes: List<ExprId>, depth: int) -> string {
        mut out: Text = builder()
        out.push(parts[0])
        for j, hole in holes {
            out.push("\${")
            self.unbroken = self.unbroken + 1
            out.push(self.expression(hole, loosest_tier, depth))
            self.unbroken = self.unbroken - 1
            out.push("}")
            out.push(parts[j + 1])
        }
        out.built()
    }

    mut fn quotation(parts: List<string>, holes: List<ExprId>, depth: int) -> string {
        mut out: Text = builder()
        out.push("quote {")
        out.push(parts[0])
        for j, hole in holes {
            out.push("\${")
            if self.store.is_run_hole(hole) { out.push("..") }
            out.push(self.expression(hole, loosest_tier, depth))
            out.push("}")
            out.push(parts[j + 1])
        }
        out.push("}")
        out.built()
    }

    mut fn interpolation(parts: List<string>, holes: List<ExprId>, depth: int) -> string {
        if parts.is_empty() { return quoted_text("") }
        mut out: Text = builder()
        out.push("\"")
        out.push(unquoted(parts[0]))
        for j, hole in holes {
            out.push("\${")
            self.unbroken = self.unbroken + 1
            out.push(self.expression(hole, loosest_tier, depth))
            self.unbroken = self.unbroken - 1
            out.push("}")
            out.push(unquoted(parts[j + 1]))
        }
        out.push("\"")
        out.built()
    }

    /// A `when` block always breaks (no one-line form), so an arm's
    /// own start is deterministic: this DOES thread an exact column,
    /// same as any other spine position — it is only a comma list's
    /// PRE-RENDERED items that must fall back.
    mut fn when_expr(
        conds: List<ExprId>,
        values: List<ExprId>,
        fallback: ExprId,
        end: int,
        depth: int,
    ) -> string {
        let arms = flatten(
            [self
                .trivia_before(start_of(self.store.expr_span(c)), depth + 1)
                .concat([self.when_arm(c, values[j], depth)]) for j, c in conds],
        )
        let fallback_head = "_ -> "
        let fallback_line = "${source_line(depth + 1, "${fallback_head}${self.expression(fallback, 0, depth + 1, col_after(fallback_head, (depth + 1) * 4))}")}"
        let tail = self.trivia_before(end, depth + 1).concat(["${fallback_line}${self.trailing()}"])
        "when {\n${joined(arms.concat(tail), "\n")}\n${source_line(depth, "}")}"
    }

    fn when_arm(cond: ExprId, value: ExprId, depth: int) -> string {
        let head = "${self.expression(cond, 0, depth + 1)} -> "
        "${source_line(depth + 1, "${head}${self.expression(value, 0, depth + 1, col_after(head, (depth + 1) * 4))}")}${self.trailing()}"
    }

    mut fn match_expr(subject: ExprId, arms: List<Arm>, id: ExprId, depth: int, col: int = -1) -> string {
        let head = "match ${self.expression(subject, loosest_tier, depth, resolved_col(col, depth) + 6)} "
        "${head}${self.arms_braced(arms, id, depth, col_after(head, resolved_col(col, depth)))}"
    }

    /// An arm list's own braces, `match`'s and a trailing ARMS
    /// BLOCK's shared spelling — the head ("match subject", or
    /// nothing at all) is the one difference between them.
    mut fn arms_braced(arms: List<Arm>, id: ExprId, depth: int, col: int = -1) -> string {
        let span = self.store.expr_span(id)
        if self.width_decides(span) {
            return self
                .wrapped_list("{", [self.arm_text(a, depth + 1) for a in arms], "}", true, depth, col)
        }
        if self.span_flat(span) {
            return "{ ${joined([self.arm_text(a, depth) for a in arms], ", ")} }"
        }
        // AN ARM IS NOT A STATEMENT, so its remarks are drained at the
        // arm's first pattern — the printer emits lines in more places
        // than it has node kinds.
        let body = flatten(
            [self.trivia_before(self.arm_start(a), depth + 1).concat([self.arm_line(a, depth + 1)]) for a in arms],
        )
            .concat(self.trivia_before(end_of(span), depth + 1))
        "{\n${joined(body, "\n")}\n${source_line(depth, "}")}"
    }

    /// An arm's patterns, then its guard when it has one.
    mut fn arm_head(a: Arm, depth: int) -> string {
        let pats = joined([self.pattern(p, depth) for p in a.pats], " or ")
        let g? = a.guard else { return pats }
        "${pats} if ${self.expression(g, loosest_tier, depth)}"
    }

    /// An arm's head and value, unpunctuated — the one spelling both
    /// a broken-out line and a one-line match's joined arms build on.
    mut fn arm_text(a: Arm, depth: int) -> string {
        "${self.arm_head(a, depth)} -> ${self.expression(a.value, 0, depth)}"
    }

    /// One arm's whole line, its own trailing comment consumed and
    /// appended — an arm is not a statement, so `statement`'s hook
    /// never reaches it. `match`'s arms are a comma list (its grammar's
    /// `( BREAK | "," | arm )*`), so every arm — the last included —
    /// takes the trailing comma the comma-list law requires. A
    /// ONE-LINE match never reaches this: `match_expr` joins
    /// `arm_text` there instead, uncommaed, as a one-line comma list
    /// is written everywhere else in the tree.
    mut fn arm_line(a: Arm, depth: int) -> string {
        let line = source_line(depth, "${self.arm_text(a, depth)},")
        "${line}${self.trailing()}"
    }

    mut fn match_optional(
        subject: ExprId,
        bind: string,
        present: ExprId,
        absent: ExprId,
        parent: int,
        end: int,
        depth: int,
        col: int = -1,
    ) -> string {
        let c = resolved_col(col, depth)
        let chained: Expr? = if bind == chained_binder { self.store.expr(present) } else { null }
        if chained != null && self.store.expr(absent) is .NullLit {
            match chained! {
                .MethodCall(receiver, name, args) -> {
                    if self.store.ident_name(receiver) == chained_binder {
                        let tail = self.type_lit_tail(present, name, args) ?? "${source_name(name.of)}${self.args_wrapped(args, depth)}"
                        return grouped(
                            "${self.expression(subject, postfix_tier, depth, c)}?.${tail}",
                            postfix_tier,
                            parent,
                        )
                    }
                },
                .CallValue(callee, args) -> {
                    if self.store.ident_name(callee) == chained_binder {
                        return grouped(
                            "${self.expression(subject, postfix_tier, depth, c)}?.${self.args_wrapped(args, depth)}",
                            postfix_tier,
                            parent,
                        )
                    }
                },
                rest -> { let _ = 0 },
            }
        }
        let head = self.expression(subject, loosest_tier, depth, c + 6)
        let present_head = "${source_name(bind)}? -> "
        let absent_head = "null -> "
        let arms = self
            .trivia_before(start_of(self.store.expr_span(present)), depth + 1)
            .concat(
                [
                    source_line(
                        depth + 1,
                        "${present_head}${self.expression(present, 0, depth + 1, col_after(present_head, (depth + 1) * 4))}",
                    ),
                ],
            )
            .concat(self.trivia_before(start_of(self.store.expr_span(absent)), depth + 1))
            .concat(
                [
                    source_line(
                        depth + 1,
                        "${absent_head}${self.expression(absent, 0, depth + 1, col_after(absent_head, (depth + 1) * 4))}",
                    ),
                ],
            )
            .concat(self.trivia_before(end, depth + 1))
        grouped(
            "match ${head} {\n${joined(arms, "\n")}\n${source_line(depth, "}")}",
            atom_tier,
            parent,
        )
    }

    mut fn catch_expr(
        subject: ExprId,
        variants: List<string>,
        binds: List<string>,
        values: List<ExprId>,
        end: int,
        depth: int,
        col: int = -1,
    ) -> string {
        let c = resolved_col(col, depth)
        let held = self.expression(subject, 2, depth, c)
        if values.length == 1 {
            let prefix = "${held} catch ${self.catch_head(variants[0], binds[0])}"
            return "${prefix}${self.expression(values[0], 2, depth, col_after(prefix, c))}"
        }
        let arms = flatten(
            [self
                .trivia_before(start_of(self.store.expr_span(v)), depth + 1)
                .concat(
                    [
                        "${source_line(depth + 1, "${self.catch_head(variants[j], binds[j])}${self.expression(v, 0, depth + 1)}")}${self.trailing()}",
                    ],
                ) for j, v in values],
        )
            .concat(self.trivia_before(end, depth + 1))
        "${held} catch {\n${joined(arms, "\n")}\n${source_line(depth, "}")}"
    }

    fn catch_head(variant: string, bind: string) -> string {
        if variant.is_empty() {
            if bind.is_empty() { return "" }
            return "${source_name(bind)} -> "
        }
        ".${source_name(variant)}${if bind.is_empty() { "" } else { "(${source_name(bind)})" }} -> "
    }

    mut fn pattern(id: PatId, depth: int) -> string {
        match self.store.pat(id) {
            .Wild -> "_",
            .Rest -> "rest",
            .Bind(name) -> source_name(name.of),
            .Variant(name, args) -> ".${source_name(name.of)}${if args.is_empty() { "" } else { "(${joined([self.pattern(p, depth) for p in args], ", ")})" }}",
            .Lit(value) -> self.pattern_lit(value, depth),
            .Format(head, parts) -> format_source(head, parts),
            .Quote(body) -> self.expression(body, loosest_tier, depth),
        }
    }

    /// A literal pattern's own text. A STRING is re-read by the format
    /// reader the moment it stands in pattern position (features/
    /// formats/builders.av's `build_format_pat`), which reads an
    /// unescaped `{`/`}` as a HOLE — so a literal that HELD one (a
    /// format with no holes collapses to this very node, its braces
    /// already unescaped into ordinary characters) must have them
    /// doubled back on the way out, or the pattern it reads back is a
    /// different one: `"a{{b}}c"` matches its own text; `"a{b}c"`
    /// binds `b` to whatever falls between `a` and `c`. A non-string
    /// literal carries no such hazard.
    mut fn pattern_lit(value: ExprId, depth: int) -> string {
        match self.store.expr(value) {
            .StrLit(text) -> quoted_text(braced(text)),
            rest -> self.expression(value, loosest_tier, depth),
        }
    }

    fn pins(pins: List<TypeRef>) -> string {
        if pins.is_empty() { "" } else { "<${joined([spelled(p) for p in pins], ", ")}>" }
    }

    mut fn args(args: List<ExprId>, depth: int) -> string {
        joined([self.expression(a, loosest_tier, depth) for a in args], ", ")
    }

    /// A call's parenthesised arguments, followed by any trailing
    /// blocks it carries (`store.is_trailing` — `f(a) { x -> b }` is
    /// one call, its last argument spelled outside the parens). Two
    /// trailing blocks are the head and its `else` (features/
    /// builder.av's `trailed`).
    mut fn call_tail(args: List<ExprId>, depth: int, col: int = -1) -> string {
        let regular = [a for a in args if !self.store.is_trailing(a)]
        let blocks = [a for a in args if self.store.is_trailing(a)]
        let head = self.args_wrapped(regular, depth, col)
        if blocks.is_empty() { return head }
        "${head} ${joined([self.trailing_block(b, depth) for b in blocks], " else ")}"
    }

    /// One trailing block's braces. It rides a `Lambda` (`trailed`'s
    /// whole mechanism) whose seat prints inside the braces, never
    /// before them.
    mut fn trailing_block(id: ExprId, depth: int) -> string {
        match self.store.expr(id) {
            .Lambda(params, body) -> self.trailing_lambda(params, body, id, depth),
            rest -> "{ ${self.expression(id, loosest_tier, depth)} }",
        }
    }

    mut fn trailing_lambda(params: List<Param>, body: ExprId, id: ExprId, depth: int) -> string {
        let arms? = self.arms_sugar_body(params, body) else {
            let head = self.trailing_head(params, depth)
            let one = self.span_flat(self.store.expr_span(id))
            let end = self.block_end(body)
            return match self.store.expr(body) {
                .Block(stmts, value) -> self.braced(head, stmts, value, end, one, depth),
                rest -> self.braced(head, [], body, end, one, depth),
            }
        }
        self.arms_braced(arms, body, depth)
    }

    /// A trailing lambda's body, read back as ARMS-SUGAR: the
    /// pronoun's one seat, its whole body one `match` over that same
    /// seat and nothing else — absent for every other shape, which
    /// is what makes this read-back safe: a hand-written `{ match it
    /// { ... } }` and the sugar mint the SAME node, so canonicalizing
    /// one form into the other is exactly what a formatter is for.
    fn arms_sugar_body(params: List<Param>, body: ExprId) -> List<Arm>? {
        if !is_pronoun(params) { return null }
        match self.store.expr(body) {
            .Match(subject, arms) if self.store.ident_name(subject) == "it" -> arms,
            rest -> null,
        }
    }

    /// A trailing block's seat line: nothing for the pronoun or an
    /// empty seat list, `x ->` (no parens, no trailing space) for
    /// named seats.
    mut fn trailing_head(params: List<Param>, depth: int) -> string {
        if params.is_empty() || is_pronoun(params) { return "" }
        "${self.params(params, depth)} ->"
    }

    /// `.type(T)`'s own tail, `type(T)` with no receiver — absent when
    /// `id`'s call is not that sugar, or its argument does not reverse
    /// (`type_lit_spelling`). The one detector a plain method call and
    /// a `?.`-propagated one (match_optional's chained_binder
    /// shortcut, which prints its own receiver as `subject?`) share,
    /// so both read the sugar back the same way for the same reason.
    fn type_lit_tail(id: ExprId, name: Plain, args: List<ExprId>) -> string? {
        if name.of != "interned" || args.length != 1 || !self.store.is_type_lit(id) { return null }
        let ty? = self.type_lit_spelling(args[0]) else { return null }
        "type(${ty})"
    }

    /// One `.` chain LINK's own text, no receiver: `.type(T)`'s
    /// read-back, or `.name(args)`. Rendered at the fallback column —
    /// a link, like a comma list's item, is pre-rendered before the
    /// chain it belongs to decides flat or broken.
    mut fn method_link_text(id: ExprId, name: Plain, args: List<ExprId>, depth: int) -> string {
        // A link lands at `depth + 1` once the chain breaks (postfix_chain_doc's
        // own `nest(4, ...)`), so its OWN call — if IT also wraps — must
        // nest from THAT column, never from the chain's.
        let tail? = self.type_lit_tail(id, name, args) else { return ".${source_name(name.of)}${self.call_tail(args, depth + 1)}" }
        ".${tail}"
    }

    /// A postfix `.` chain's root and its links, walked from the
    /// OUTERMOST call inward: a `.Prop` or `.MethodCall` subject
    /// extends the walk, anything else — a `?.`, an index, a force —
    /// stops it and stands as the ROOT. Only a bare `.` may lead a
    /// broken continuation line (`grammar/lexer.av`'s `continued_by`),
    /// so the walk never crosses a `?.`.
    mut fn chain_walk(e: ExprId, depth: int) -> ChainWalk {
        // a piped call is a pipeline's, never a link: it stands as the root
        if self.store.is_piped(e) { return unlinked(e) }
        match self.store.expr(e) {
            .Prop(subject, name) -> {
                let inner = self.chain_walk(subject, depth)
                ChainWalk {
                    root: inner.root,
                    links: inner.links.concat([".${source_name(name.of)}"]),
                }
            },
            .MethodCall(subject, name, args) -> {
                let inner = self.chain_walk(subject, depth)
                ChainWalk {
                    root: inner.root,
                    links: inner.links.concat([self.method_link_text(e, name, args, depth)]),
                }
            },
            rest -> unlinked(e),
        }
    }

    /// A postfix `.` chain, width-decided: flat exactly as the
    /// printer always joined it, or one link per line — LEADING its
    /// own `.` — otherwise, via the document algebra. Parenthesised
    /// when the ROOT is a bare `.Propagate`: `get(i)?` then a `.`-led
    /// accessor right after it LEXES AS ONE `?.` TOKEN, an entirely
    /// different construct (CLAUDE.md's subset note on `get(i)?.name`).
    mut fn chain_rendered(id: ExprId, parent: int, depth: int, col: int = -1) -> string {
        let walk = self.chain_walk(id, depth)
        let c = resolved_col(col, depth)
        let root = self.expression(walk.root, postfix_tier, depth, c)
        let head = if self.bare_propagate(walk.root) { "(${root})" } else { root }
        if walk.links.is_empty() { return grouped(head, postfix_tier, parent) }
        grouped(
            render_doc_at(
                postfix_chain_doc(text(head), [text(l) for l in walk.links]),
                self.layout_width(),
                depth * 4,
                c,
            ),
            postfix_tier,
            parent,
        )
    }

    /// A pipeline's root and its stages, walked from the LAST stage
    /// inward: a piped call's first argument is the value it was
    /// handed (`store.is_piped`), so that argument extends the walk
    /// and the call's remainder is the stage as it was written. A
    /// stage with nothing left in its parentheses prints bare where
    /// the bare form reads back as the same call, and a `?` or `!`
    /// on a stage's answer rides the stage (`x |> f(a)?`).
    mut fn pipe_walk(e: ExprId, depth: int) -> ChainWalk {
        match self.store.expr(e) {
            .Propagate(call) if self.store.is_piped(call) -> suffixed(self.pipe_walk(call, depth), "?"),
            .Force(call) if self.store.is_piped(call) -> suffixed(self.pipe_walk(call, depth), "!"),
            .Call(callee, pins, args) if self.store.is_piped(e) -> self
                .piped_stage(e, args, "${source_name(callee.of)}${self.pins(pins)}", pins.is_empty(), depth),
            .MethodCall(subject, name, args) if self.store.is_piped(e) -> {
                let head = "${self.chain_subject(subject, depth + 1)}.${source_name(name.of)}"
                self.piped_stage(e, args, head, true, depth)
            },
            .CallValue(subject, args) if self.store.is_piped(e) -> {
                let head = "(${self.expression(subject, loosest_tier, depth + 1)})"
                self.piped_stage(e, args, head, self.store.expr_is_closure(subject), depth)
            },
            rest -> unlinked(e),
        }
    }

    /// One stage: the walk through the piped value, then `head` and
    /// the arguments written after it.
    mut fn piped_stage(e: ExprId, args: List<ExprId>, head: string, short: bool, depth: int) -> ChainWalk {
        let value? = args.first() else { return unlinked(e) }
        let inner = self.pipe_walk(value, depth)
        let written = args.slice(1, args.length)
        let tail = if short && written.is_empty() { "" } else { self.call_tail(written, depth + 1) }
        ChainWalk { root: inner.root, links: inner.links.concat(["${head}${tail}"]) }
    }

    /// A pipeline, width-decided as an operator run is: flat, or one
    /// stage per line with `|>` ENDING the line it continues. A
    /// written lambda at the root keeps its group — bare, its body
    /// would read the whole pipeline.
    mut fn pipe_rendered(walk: ChainWalk, parent: int, depth: int, col: int) -> string {
        let root = self.expression(walk.root, pipe_tier, depth + 1)
        let head = match self.store.expr(walk.root) {
            .Lambda(params, _) if !is_pronoun(params) -> "(${root})",
            rest -> root,
        }
        grouped(
            render_doc_at(
                chain_doc("|>", [text(head)].concat([text(l) for l in walk.links])),
                self.layout_width(),
                depth * 4,
                col,
            ),
            pipe_tier,
            parent,
        )
    }

    /// A postfix chain's subject (`.Chain`, `.Propagate`) — parenthesised
    /// `.type(T)` read-back) — parenthesised when it is a bare
    /// `.Propagate`, regardless of precedence: `get(i)?` then a
    /// `.`-led accessor right after it LEXES AS ONE `?.` TOKEN — an
    /// entirely different construct (CLAUDE.md's subset note on
    /// `get(i)?.name`) — so the postfix tier alone is not enough to
    /// tell the printer parens are unneeded here.
    mut fn chain_subject(subject: ExprId, depth: int, col: int = -1) -> string {
        let text = self.expression(subject, postfix_tier, depth, col)
        if self.bare_propagate(subject) { "(${text})" } else { text }
    }

    /// A `?` a following `.` would meet and lex with as `?.` — a
    /// pipeline's own `?` already stands inside the pipeline's group.
    fn bare_propagate(e: ExprId) -> bool {
        match self.store.expr(e) { .Propagate(value) -> !self.store.is_piped(value), rest -> false }
    }

    /// `v.type(T)`'s argument read back to `T` — the SAME `words`/
    /// `applieds` tables the sugar spelled it with (features/
    /// expr_spine/type_lit.av), or `null` when the shape does not
    /// reverse (a fn type: no site has needed one back yet).
    fn type_lit_spelling(id: ExprId) -> string? {
        match self.store.expr(id) {
            .VariantLit(name, args) -> self.type_variant_spelling(name.of, args),
            rest -> null,
        }
    }

    fn type_variant_spelling(variant: string, args: List<ExprId>) -> string? {
        if variant == "Opt" {
            let inner? = self.type_lit_spelling(args[0]) else { return null }
            return "${inner}?"
        }
        if args.length == 1 && self.store.is_hole(args[0]) { return self.type_hole_name(args[0]) }
        let word? = words.find(it.variant == variant) else { return self.type_applied_spelling(variant, args) }
        word.name
    }

    fn type_hole_name(id: ExprId) -> string? {
        match self.store.expr(id) { .Ident(name) -> source_name(name.of), rest -> null }
    }

    fn type_applied_spelling(variant: string, args: List<ExprId>) -> string? {
        let applied? = applieds.find(it.variant == variant) else { return null }
        let parts = [self.type_lit_spelling(a) for a in args]
        if parts.any(it == null) { return null }
        "${applied.name}<${joined([p! for p in parts], ", ")}>"
    }
}

/// Whether `params` is the compiler-synthesized pronoun seat: one
/// unnamed parameter wearing the reserved sentinel id, minted where
/// the source read `it` with no `(it) ->` of its own
/// (core/nodes.av's `pronoun_param`).
fn is_pronoun(params: List<Param>) -> bool {
    if params.length != 1 { return false }
    same_param_id(params[0].id, pronoun_param_id)
}

/// A walk that is its root alone.
fn unlinked(root: ExprId) -> ChainWalk { ChainWalk { root: root, links: [] } }

/// A walk whose LAST link carries `mark` — the postfix a pipeline's
/// last stage was written with.
fn suffixed(walk: ChainWalk, mark: string) -> ChainWalk {
    walk with { links: [if j == walk.links.length - 1 { "${l}${mark}" } else { l } for j, l in walk.links] }
}

fn source_line(depth: int, text: string) -> string {
    "${joined(filled(depth, "    "), "")}${text}"
}

/// The column a width decision measures from: the caller's exact
/// answer when it knows one (a statement's own prefix — `let x = `,
/// `fn f` — measured via `col_after`), or `depth * 4` when the
/// construct is rendered as one of a LIST's items — a param, an
/// argument, a chain operand, a struct field's value — before the
/// enclosing list has chosen flat or broken, so no caller can know
/// its true column without looking ahead. The fallback is honest, not
/// blind: it is `render_doc`'s own shallow-fits trade, one level up.
fn resolved_col(col: int, depth: int) -> int {
    if col < 0 { depth * 4 } else { col }
}

/// The three chainable operators the LINE LAW covers — a run of
/// comparisons does not associate (CLAUDE.md's "comparisons do not
/// chain"), and a bitwise run refuses to mix operators on its own, so
/// neither reads as one width decision the way `&&`, `||` and `+` do.
fn chainable(op: BinOp) -> bool {
    match op {
        .And or .Or or .Add -> true,
        .Sub or .Mul or .Div or .Mod or .Eq or .Ne or .Lt or .Le or .Gt or .Ge or .BitAnd or .BitOr or .BitXor or .Shl or .Shr -> false,
    }
}

/// Compiler-minted binders are hygienic and intentionally not user
/// spellable. Their projection uses a readable source identifier.
fn source_name(name: string) -> string {
    name.replace("\$", "_").replace(" ", "_")
}

fn unquoted(text: string) -> string {
    let q = quoted_text(text)
    q.substring(1, q.length - 1)
}

fn grouped(text: string, own: int, parent: int) -> string {
    if own < parent { "(${text})" } else { text }
}

fn numeric(text: string, parent: int) -> string {
    grouped(text, if text.starts_with("-") { unary_tier } else { atom_tier }, parent)
}

impl SourceText {
    /// The width a group decides against: the canonical one, or no limit
    /// where a line break cannot stand.
    fn layout_width() -> int { if self.unbroken > 0 { unbounded_width } else { canonical_width } }

    /// A fn's answer, spelled — never for `void`, which nobody writes:
    /// the grammar's `( "->" r:type )?` defaults the unwritten slot to
    /// `void`, and the tree's own convention leaves it out.
    fn ret_arrow(ret: TypeRef, depth: int, col: int = -1) -> string {
        if is_void_ret(ret) { "" } else { " -> ${self.type_ref_wrapped(ret, depth, col_after(" -> ", resolved_col(col, depth)))}" }
    }
}

fn is_void_ret(ret: TypeRef) -> bool {
    ret.name == "void" && ret.args.is_empty() && !ret.optional
}

fn comparison(op: BinOp) -> bool {
    match op {
        .Eq or .Ne or .Lt or .Le or .Gt or .Ge -> true,
        .Add or .Sub or .Mul or .Div or .Mod or .And or .Or or .BitAnd or .BitOr or .BitXor or .Shl or .Shr -> false,
    }
}

fn bitwise(op: BinOp) -> bool {
    match op {
        .BitAnd or .BitOr or .BitXor or .Shl or .Shr -> true,
        .Add or .Sub or .Mul or .Div or .Mod or .And or .Or or .Eq or .Ne or .Lt or .Le or .Gt or .Ge -> false,
    }
}

/// THE PRINTER'S OWN PRECEDENCE SCALE, loosest to tightest — what a
/// site demands of the form that fills it. It MIRRORS the spine's
/// rule ladder (features/expr_spine/mod.av) and is deliberately a
/// second spelling of it: the grammar states precedence as rule
/// NESTING, which carries no number, and deciding whether to
/// parenthesise needs a scale to compare. Reading it off the grammar
/// would make `language` depend on `features`' rule NAMES, and every
/// feature adding a rule would shift the scale under the printer.
const loosest_tier: int = 0
const pipe_tier: int = 6
// a table cell parses at `additive` — `|` is the column separator
const cell_tier: int = 8
const unary_tier: int = 10
const with_tier: int = 11
const postfix_tier: int = 12
const atom_tier: int = 13

/// A binary operator's tier — below `unary_tier`, above `loosest_tier`.
fn binary_precedence(op: BinOp) -> int {
    match op {
        .Or -> 2,
        .And -> 3,
        .Eq or .Ne or .Lt or .Le or .Gt or .Ge -> 4,
        .BitAnd or .BitOr or .BitXor or .Shl or .Shr -> 7,
        .Add or .Sub -> 8,
        .Mul or .Div or .Mod -> 9,
    }
}

/// One `use` item: its name, or `name as alias` — the formatter's own
/// rendering, reused by `avra fix`'s `Fix.Delete` when it rewrites a
/// `use` line down to fewer items (`compiler/rule_delete.av`).
export fn import_item(name: string, renamed: string) -> string {
    if renamed.is_empty() { return name }
    "${name} as ${renamed}"
}

/// A table column's width — its header's, widened by every row's
/// cell in that column.
fn col_width(j: int, header: List<string>, rows: List<List<string>>) -> int {
    max_len([header[j]].concat([r[j] for r in rows]))
}

/// The widest of a run of strings.
fn max_len(strs: List<string>) -> int {
    mut m = 0
    for s in strs {
        if s.length > m { m = s.length }
    }
    m
}

/// One row's cells, each padded to its column's width and pipe-joined
/// — the LAST cell never pads, since nothing stands to its right.
fn padded_row(cells: List<string>, widths: List<int>) -> string {
    joined(
        [if j == cells.length - 1 { cells[j] } else { pad_to(cells[j], widths[j]) } for j in 0..cells.length],
        " | ",
    )
}

fn pad_to(s: string, w: int) -> string {
    if s.length >= w { return s }
    "${s}${spaces(w - s.length)}"
}

fn spaces(n: int) -> string {
    joined([" " for _n in 0..n], "")
}

/// A format pattern as the literal that spells it: literal text with
/// its braces doubled, each hole as `{name}`, `{name...}` or
/// `{name: Type}`.
fn format_source(head: string, parts: List<FormatPart>) -> string {
    "\"${braced(head)}${joined([hole_source(p.hole) + braced(p.piece) for p in parts], "")}\""
}

fn braced(text: string) -> string {
    text.replace("{", "{{").replace("}", "}}")
}

fn hole_source(h: Hole) -> string {
    let ty: TypeRef? = h.ty
    "{${h.name}${if h.greedy { "..." } else { "" }}${if ty == null { "" } else { ": ${spelled(ty!)}" }}}"
}

/// One printed entry of a field list and the offset it began at.
type FieldEntry = { lo: int, text: string }

/// `break` or `continue`, and its label when it names one.
fn jump_line(again: bool, label: string?) -> string {
    if label == null { jump_word(again) } else { "${jump_word(again)} ${label!}" }
}
