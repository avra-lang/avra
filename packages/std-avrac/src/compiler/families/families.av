//! The kernel's families as declarations. Each is a PRIVATE marker in
//! this module (so its name never collides with a same-named type
//! elsewhere in the compiler), carrying the key and answer it names.
//!
//! `Family` IS this collect: the markers are its variant set, minted in
//! NAME order, so a family is keyed by its name and declaration order is
//! free. The collect stands in the SAME FILE as the markers, so they are
//! registered by the time it is declared.
//!
//! ORDER: `by it.name` — the declaration's own name. A family's ordinal
//! is its place in that order, and it is no durable address: nothing
//! saved keys by it and no family fingerprint folds it.
use compiler.families.family_derive.{family}

/// A file's declaration rows.
@family("FileId", "List<DeclId>")
type Items = {}

/// A file's export-reachable names.
@family("FileId", "Namespace")
type Visible = {}

/// A file's resolved name facts.
@family("FileId", "NameFacts")
type Resolved = {}

/// A type's method table — the decls whose bodies dispatch through it.
@family("DeclId", "List<DeclId>")
type Methods = {}

/// A `const`'s settled type, keyed by the settlement's ask.
@family("settle-int", "TypeId")
type ConstTyped = {}

/// A file's folded type facts.
@family("FileId", "TypeFacts")
type Folded = {}

/// A `const`'s settled value, keyed by the settlement's ask.
@family("settle-int", "Settlement")
type Settled = {}

/// The lowerings a declaration produced, keyed by the lowering ask.
@family("ask-int", "Unit")
type Lowered = {}

/// A lifted declaration's units, keyed by the lift ask.
@family("lift-int", "LiftResult")
type Lifted = {}

/// The declarations a file's expansions generated.
@family("FileId", "List<DeclId>")
type Expanded = {}

/// The whole-program raised-error fixpoint's dense per-member space.
@family("DeclId", "List<TypeId>")
type Raised = {}

/// A compile-time run's own units, in a space separate from `Lowered`.
@family("lift-int", "Unit")
type LiftLowered = {}

/// The Syntax family — a declaration's own node fingerprints.
@family("DeclId", "int")
type Syntax = {}

/// A declaration's own slice of its file's names.
@family("DeclId", "int")
type Names = {}

/// Every declaration filed under one name, keyed by its bucket in
/// `Decl`'s name index.
@family("int", "Unit")
type Named = {}

/// One declaration's settled transitive read-reach answer, written by
/// `reach_solved` — a call site in any body or package reads it.
/// The family law applies: appended, never inserted.
@family("DeclId", "bool")
type DeclReads = {}

/// The Input family — one read of the world through the door, keyed by
/// its interned name. The driver re-reads it when the world may have
/// moved.
@family("int", "Read")
type Input = {}

/// One declaration's written seats as the receivers pass settled them: a reader of a
/// fn's write bit stands on this declaration's bits alone, never on the whole survey.
@family("DeclId", "int")
type Writes = {}

/// One declaration's cancel bits as its strongly-connected set settled them: a reader of a
/// fn's reach stands on this declaration's answer alone, never on the whole program.
@family("DeclId", "int")
type CancelBits = {}

export collect enum Family = @family in self by it.name
