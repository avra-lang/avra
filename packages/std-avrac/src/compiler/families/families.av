//! The kernel's families as declarations. Each is a PRIVATE marker in
//! this module (so its name never collides with a same-named type
//! elsewhere in the compiler), carrying its RANK — the real ordinal
//! `Family` (compiler/workspace.av) declares it at — and the key and
//! answer it names.
//!
//! `FamilyProbe` is the proof: this module's own markers ARE the family
//! set, all 28 of them, minted as variants. The hand-written `Family`
//! enum stays AUTHORITATIVE until .12.4 flips it to this collect; this
//! file changes no behaviour.
//!
//! ORDER: `by it.name` today proves reflection. The append-stable order
//! is the RANK each declaration carries (`by it.mark.args[0] dense`),
//! now that the seed carries the collect order grammar and all 28 ranks
//! exist (a gap refuses).
use compiler.families.family_derive.{family}

/// The Source family — an INPUT: the driver sets a file's own bytes.
@family(0, "FileId", "SourceFile")
type Source = {}

/// A file's parsed tree.
@family(1, "FileId", "Parsed")
type Parsed = {}

/// A file's declaration rows.
@family(2, "FileId", "List<DeclId>")
type Items = {}

/// A module's own names, resolved across its files.
@family(3, "ModuleId", "ModuleNames")
type Namespace = {}

/// A file's export-reachable names.
@family(4, "FileId", "Namespace")
type Visible = {}

/// A file's resolved name facts.
@family(5, "FileId", "NameFacts")
type Resolved = {}

/// A declaration's own signature, asked fresh every time a sig is read.
@family(6, "DeclId", "DeclSig")
type Sig = {}

/// A type's method table — the decls whose bodies dispatch through it.
@family(7, "DeclId", "List<DeclId>")
type Methods = {}

/// A declaration's typed facts — the body's seats, cells and answers.
@family(8, "DeclId", "TypeFacts")
type Typed = {}

/// A `const`'s settled type, keyed by the settlement's ask.
@family(9, "settle-int", "TypeId")
type ConstTyped = {}

/// A file's folded type facts.
@family(10, "FileId", "TypeFacts")
type Folded = {}

/// A file's whole analysis.
@family(11, "FileId", "Analysis")
type Analysis = {}

/// A `const`'s settled value, keyed by the settlement's ask.
@family(12, "settle-int", "Settlement")
type Settled = {}

/// The lowerings a declaration produced, keyed by the lowering ask.
@family(13, "ask-int", "Unit")
type Lowered = {}

/// A lifted declaration's units, keyed by the lift ask.
@family(14, "lift-int", "LiftResult")
type Lifted = {}

/// The Manifest family — an input keyed by package index.
@family(15, "int", "Manifest")
type Manifest = {}

/// The whole-program write survey — each fn's declared and inferred seats.
@family(16, "unit", "bool?")
type Receivers = {}

/// The declarations a file's expansions generated.
@family(17, "FileId", "List<DeclId>")
type Expanded = {}

/// A file parsed under NO sublanguage words — the block pre-scan.
@family(18, "FileId", "Parsed")
type Plain = {}

/// Every named use of a declaration, folded from every file's own rows.
@family(19, "unit", "List<Ref>")
type References = {}

/// A `Result<T, _>`'s inferred error set — the whole-program fixpoint.
@family(20, "unit", "Raised")
type Failures = {}

/// A held declaration's stored sig record, one key per module.
@family(21, "ModuleId", "string")
type HeldSig = {}

/// The whole-program raised-error fixpoint's dense per-member space.
@family(22, "DeclId", "List<TypeId>")
type Raised = {}

/// One file's method-table clashes.
@family(23, "FileId", "List<Diag>")
type MethodDiags = {}

/// A compile-time run's own units, in a space separate from `Lowered`.
@family(24, "lift-int", "Unit")
type LiftLowered = {}

/// The Syntax family — a declaration's own node fingerprints.
@family(25, "DeclId", "int")
type Syntax = {}

/// A declaration's own slice of its file's names.
@family(26, "DeclId", "int")
type Names = {}

/// The use-site warnings a declaration's well-formedness pass raised.
@family(27, "DeclId", "List<Diag>")
type Marks = {}

export collect enum FamilyProbe = @family in self by it.name
