//! The kernel's families as declarations — the first three, proving the
//! form. Each is a PRIVATE marker in this module (so its name never
//! collides with a same-named type elsewhere in the compiler), carrying
//! its rank and the key and answer it names.
//!
//! `FamilyProbe` is the proof: this module's own markers ARE the family
//! set, minted as variants in order. The hand-written `Family` enum
//! (compiler/workspace.av) stays AUTHORITATIVE until all 28 families
//! have a declaration; this file changes no behaviour.
//!
//! ORDER: `by it.name` today proves reflection. The append-stable order
//! is the RANK each declaration carries (`by it.mark.args[0] dense`),
//! which waits on `make seed` carrying the collect order grammar.
use compiler.families.family_derive.{family}

/// The Source family — an INPUT: the driver sets a file's own bytes.
@family(0, "FileId", "SourceFile")
type Source = {}

/// The Manifest family — an input keyed by package index.
@family(1, "int", "Manifest")
type Manifest = {}

/// The Syntax family — a dense query keyed by DeclId.
@family(2, "DeclId", "int")
type Syntax = {}

export collect enum FamilyProbe = @family in self by it.name
