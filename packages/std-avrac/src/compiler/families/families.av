//! The kernel's families as declarations. Each is a PRIVATE marker in
//! this module (so its name never collides with a same-named type
//! elsewhere in the compiler), carrying the key and answer it names.
//!
//! `Family` IS this collect: the markers are its variant set, minted in
//! NAME order, so a family is keyed by its name and declaration order is
//! free. The collect stands in the SAME FILE as the markers, so they are
//! registered by the time it is declared.
//!
//! ORDER: `by it.name` — the declaration's own name. A family's ordinal
//! is its place in that order, and it is no durable address: nothing
//! saved keys by it and no family fingerprint folds it.
use compiler.families.family_derive.{family}

/// The Source family — an INPUT: the driver sets a file's own bytes.
@family("FileId", "SourceFile")
type Source = {}

/// A file's parsed tree.
@family("FileId", "Parsed")
type Parsed = {}

/// A file's declaration rows.
@family("FileId", "List<DeclId>")
type Items = {}

/// A module's own names, resolved across its files.
@family("ModuleId", "ModuleNames")
type Namespace = {}

/// A file's export-reachable names.
@family("FileId", "Namespace")
type Visible = {}

/// A file's resolved name facts.
@family("FileId", "NameFacts")
type Resolved = {}

/// A declaration's own signature, asked fresh every time a sig is read.
@family("DeclId", "DeclSig")
type Sig = {}

/// A type's method table — the decls whose bodies dispatch through it.
@family("DeclId", "List<DeclId>")
type Methods = {}

/// A declaration's typed facts — the body's seats, cells and answers.
@family("DeclId", "TypeFacts")
type Typed = {}

/// A `const`'s settled type, keyed by the settlement's ask.
@family("settle-int", "TypeId")
type ConstTyped = {}

/// A file's folded type facts.
@family("FileId", "TypeFacts")
type Folded = {}

/// A file's whole analysis.
@family("FileId", "Analysis")
type Analysis = {}

/// A `const`'s settled value, keyed by the settlement's ask.
@family("settle-int", "Settlement")
type Settled = {}

/// The lowerings a declaration produced, keyed by the lowering ask.
@family("ask-int", "Unit")
type Lowered = {}

/// A lifted declaration's units, keyed by the lift ask.
@family("lift-int", "LiftResult")
type Lifted = {}

/// The Manifest family — an input keyed by package index.
@family("int", "Manifest")
type Manifest = {}

/// One fn's own write evidence — the seats its body writes and the seats of other fns it
/// hands them to — read from its resolved body alone. A hand family: a `@query` files no row
/// and takes only a `Db`, and this answer is a row read through the workspace.
@family("DeclId", "int")
type WriteSummary = {}

/// The declarations a file's expansions generated.
@family("FileId", "List<DeclId>")
type Expanded = {}

/// A file parsed under NO sublanguage words — the block pre-scan.
@family("FileId", "Parsed")
type Plain = {}

/// Every named use of a declaration, folded from every file's own rows.
@family("unit", "List<Ref>")
type References = {}

/// The named uses one file makes, filed under that file's own owner: a reader of the
/// whole relation stands on the files it gathers, and an edit re-surveys one file.
/// A hand family, not a `@query`, for three walls: a query never writes rows (D4) and this
/// files them under an owner, a query takes a `Db` alone where the survey reads the
/// workspace's resolved and typed tables, and `Ref`'s ids are `@local` with no stable
/// encoding (DB 03). It becomes a `@query` when those fall; the ceiling follows.
@family("FileId", "int")
type FileRefs = {}

/// A `Result<T, _>`'s inferred error set — the whole-program fixpoint.
@family("unit", "Raised")
type Failures = {}

/// A held declaration's stored sig record, one key per module.
@family("ModuleId", "string")
type HeldSig = {}

/// The whole-program raised-error fixpoint's dense per-member space.
@family("DeclId", "List<TypeId>")
type Raised = {}

/// One file's method-table clashes.
@family("FileId", "List<Diag>")
type MethodDiags = {}

/// A compile-time run's own units, in a space separate from `Lowered`.
@family("lift-int", "Unit")
type LiftLowered = {}

/// The Syntax family — a declaration's own node fingerprints.
@family("DeclId", "int")
type Syntax = {}

/// A declaration's own slice of its file's names.
@family("DeclId", "int")
type Names = {}

/// A declaration's PLACEMENT in its file's arena: the ids its own
/// facts sit at. Its content is durable (`Syntax`); its address never
/// is, so a same-file insert that leaves a declaration's nodes alike
/// still moves it.
@family("DeclId", "int")
type Placed = {}

/// The use-site warnings a declaration's well-formedness pass raised.
@family("DeclId", "List<Diag>")
type Marks = {}

/// A file's rows standing: one constant hash, so a reader that reads
/// them through their buckets is ordered after the admission.
@family("FileId", "Unit")
type Admitted = {}

/// Every declaration filed under one name, keyed by its bucket in
/// `Decl`'s name index.
@family("int", "Unit")
type Named = {}

/// The whole-program read-reach pass: which declarations read `state`
/// through the calls their bodies make, solved once per program state.
@family("unit", "int")
type ReadReach = {}

/// One declaration's settled transitive read-reach answer, written by
/// `ReadReach`'s solve — a call site in any body or package reads it.
/// The family law applies: appended, never inserted.
@family("DeclId", "bool")
type DeclReads = {}

/// The Input family — one read of the world through the door, keyed by
/// its interned name. The driver re-reads it when the world may have
/// moved.
@family("int", "Read")
type Input = {}

/// Whether a file's text can open a block word — a scan of one Text
/// input, keyed by that input's cell.
@family("int", "bool")
type BlockScan = {}

/// Whether a file declares a component — a scan of one Text input.
@family("int", "bool")
type ComponentScan = {}

/// The names a file's `component` declarations wear — a scan of one
/// Text input.
@family("int", "List<string>")
type ComponentNames = {}

/// One fn's own cancel evidence — what its body may reach, and the members it calls —
/// read from its typed facts alone. A hand family: a `@query` files no row and takes only a
/// `Db`, and this answer is a row read through the workspace.
@family("DeclId", "int")
type CancelSummary = {}

/// One declaration's written seats as the receivers pass settled them: a reader of a
/// fn's write bit stands on this declaration's bits alone, never on the whole survey.
@family("DeclId", "int")
type Writes = {}

/// One declaration's cancel bits as its strongly-connected set settled them: a reader of a
/// fn's reach stands on this declaration's answer alone, never on the whole program.
@family("DeclId", "int")
type CancelBits = {}

/// Whether a declaration is read as a value anywhere, as the references pass settled it:
/// a consumer of that one bit stands on this declaration's answer alone, never on the
/// whole relation of uses.
@family("DeclId", "int")
type ReadFound = {}

/// One declaration's consumed seats as the consumes pass settled them: a caller that reads
/// a callee's bits stands on this declaration's answer alone.
@family("DeclId", "int")
type Consumed = {}

/// A file's name environment: every name bucket its declarations' answers probed, as one cell,
/// so a saved answer reads one digest where it probed hundreds.
@family("FileId", "Unit")
type NameEnv = {}

/// What a file said — its warnings, cases and rule findings — kept so a file whose reads
/// still hold is not analysed again.
@family("FileId", "Unit")
type FileSaid = {}

/// A file's rows' environment: the sibling files and manifest its declarations were read under.
@family("FileId", "Unit")
type SiblingEnv = {}

export collect enum Family = @family in self by it.name

/// What an answer's key names — `Row` for a relation's minted family, whose
/// key is a row's place.
export enum KeyedBy { File, Module, Decl, Package, Program, Unit, Name, Input, Row }

/// What each family keys by.
export fn keyed_by(f: Family) -> KeyedBy {
    match f {
        .FileSaid or .NameEnv or .SiblingEnv or .Source or .Parsed or .Items or .Admitted or .FileRefs or .Visible or .Resolved or .Folded or .Analysis or .Expanded or .Plain or .MethodDiags -> KeyedBy.File,
        .Namespace or .HeldSig -> KeyedBy.Module,
        .Sig or .Methods or .Typed or .ConstTyped or .Raised or .Syntax or .Names or .Placed or .Marks or .DeclReads or .Writes or .WriteSummary or .CancelSummary or .CancelBits or .ReadFound or .Consumed -> KeyedBy.Decl,
        .Manifest -> KeyedBy.Package,
        .References or .Failures or .ReadReach -> KeyedBy.Program,
        .Lowered or .LiftLowered or .Lifted or .Settled -> KeyedBy.Unit,
        .Named -> KeyedBy.Name,
        .Input or .BlockScan or .ComponentScan or .ComponentNames -> KeyedBy.Input,
    }
}
