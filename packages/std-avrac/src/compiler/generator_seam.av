//! THE GENERATOR SEAM: what a `@derive` on a written declaration made, read from the expansion
//! engine, its statements copied whole into a store of their own, and the source of each directive
//! it ran. The program layer reads a generator it doesn't make yet through it, and a receipt holds
//! the ones it makes to it. The switch deletes this file.
use core.{
    CopiedNodes,
    DeclId,
    ExprId,
    FileId,
    ForeignOrigin,
    PatId,
    StmtId,
    SyntaxArena,
    copier,
    flatten,
    new_node_store,
    same_stmt,
}
use features.{DeclareWork, Namespace}
use @std.program.address.{SourceFileAddress}
use @std.program.source_facts.{PlacedTape}
use @std.program.syntax_tape.{SyntaxTape}

/// What one trait's derive made over a declaration: its statements, copied into a store of their
/// own, and the path of the file its derive was written in.
export type DerivedCopy = { store: SyntaxArena, stmts: List<StmtId>, home: string }

/// The door the program layer runs a generator it doesn't make through, answered by `ws`: `path_of`
/// names the file at an address on disk, `address_of` the address of a file on disk.
export fn expansion_door(
    ws: Workspace,
    path_of: fn(SourceFileAddress) -> string,
    address_of: fn(string) -> SourceFileAddress?,
) -> GeneratorDoor {
    GeneratorDoor {
        made: (file: SourceFileAddress, name: string, trait_name: string) -> copied_items(
            ws.derived_copy(path_of(file), name, trait_name),
            address_of,
        ),
    }
}

/// A copy as an item on a tape, every node marked as written in the file its derive was written in.
fn copied_items(copy: DerivedCopy?, address_of: fn(string) -> SourceFileAddress?) -> List<
    GeneratedItem,
> {
    let c? = copy else { return [] }
    let home? = address_of(c.home) else { return [] }
    c
        .store
        .note_copied(
            CopiedNodes {
                exprs: [ExprId { index: at } for at in 0..c.store.exprs.count()],
                stmts: [StmtId { index: at } for at in 0..c.store.stmts.count()],
                pats: [PatId { index: at } for at in 0..c.store.pat_count()],
                params: [],
            },
            template_home(home),
        )
    [GeneratedItem { tape: tape_of_item(c.store, c.stmts) }]
}

impl Workspace {
    /// What the `@derive` naming the trait `trait_name` on the written declaration `name` of the file
    /// at `path` made; absent for a file this workspace doesn't hold, or no such derive. The seam reads
    /// the workspace and never adds a file to it: a file it mints is a write after its readers.
    fn derived_copy(path: string, name: string, trait_name: string) -> DerivedCopy? {
        let f? = self.decls.known_file_id(path) else { return null }
        let p = self.parsed(f)
        let vis = self.visible(f)
        let _ = self.expanded(f)
        let d? = self.written_decls(f, p).find((w) -> self.decls.decl(w).name == name) else { return null }
        for w in self.declared_work(f, d, p, vis) {
            if !self.is_derived(w.ret) { continue }
            for e in w.args {
                let t? = self.named_arg(p, vis, e) else { continue }
                if self.decls.decl(t).name == trait_name { return self.trait_copy(f, w, vis, t) }
            }
        }
        null
    }

    /// The source of each directive the derive naming the trait `trait_name` made over the written
    /// declaration `name` of the file at `path`, in the order made; absent where no derive on it
    /// names that trait.
    fn derived_texts(path: string, name: string, trait_name: string) -> List<string>? {
        let f? = self.decls.known_file_id(path) else { return null }
        let p = self.parsed(f)
        let vis = self.visible(f)
        let _ = self.expanded(f)
        let d? = self.written_decls(f, p).find((w) -> self.decls.decl(w).name == name) else { return null }
        for w in self.declared_work(f, d, p, vis) {
            if !self.is_derived(w.ret) { continue }
            for e in w.args {
                let t? = self.named_arg(p, vis, e) else { continue }
                if self.decls.decl(t).name == trait_name { return [x.source?.text() ?? "" for x in self.trait_directives(t, w, f)] }
            }
        }
        null
    }

    /// What the trait `named`'s `derive` made: the declarations expansion admitted for it, their
    /// statements copied whole.
    fn trait_copy(f: FileId, w: DeclareWork, vis: Namespace, named: DeclId?) -> DerivedCopy? {
        let t? = named else { return null }
        let m? = self.decls.trait_derive(t) else { return null }
        let maker = self.maker_said(f, w)
        let made = flatten(
            [self.materialized_directive(f, w, d, vis, maker) for d in self.trait_directives(t, w, f)],
        )
        let src = self.decls.store_of(f)
        let tops = made_tops(src, [self.decls.decl(d).stmt for d in made])
        if tops.is_empty() { return null }
        let store = new_node_store()
        mut rb = copier(src, store, [], [], sugar_door(self.lang))
        let stmts = rb.stmts(tops)
        lambdas_apart(store)
        DerivedCopy {
            store: store,
            stmts: stmts,
            home: self.decls.file(self.decls.decl(m).file).path,
        }
    }
}

/// The statements a derive's declarations stand in, each once, in the order made: an impl holding
/// a made method, or a made declaration's own.
fn made_tops(src: SyntaxArena, own: List<StmtId>) -> List<StmtId> {
    let impls = [s for at in 0..src.stmts.count() for s in [StmtId { index: at }] if holds_any(src, s, own)]
    let held = flatten([src.impl_parts(s)!.fns for s in impls])
    let all = impls.concat([o for o in own if !held.any((h) -> same_stmt(h, o))])
    [s for at, s in all if !all.slice(0, at).any((x) -> same_stmt(x, s))]
}

/// Whether `s` is an impl holding any of `own`.
fn holds_any(src: SyntaxArena, s: StmtId, own: List<StmtId>) -> bool {
    let parts? = src.impl_parts(s) else { return false }
    parts.fns.any((m) -> own.any((o) -> same_stmt(o, m)))
}

/// How an item a generator made on the program layer differs from a copy the workspace's derive made,
/// where their nodes stand and the files that wrote them aside: the first statement and method that
/// mean something else; absent when alike.
export fn copy_difference(made: SyntaxTape, copy: DerivedCopy) -> string? {
    let ours = unhomed(made)
    let theirs = unhomed(tape_of_item(copy.store, copy.stmts))
    if ours.tape.meaning_hash.same_as(theirs.tape.meaning_hash) { return null }
    if ours.stmts.length != theirs.stmts.length { return "${ours.stmts.length} statements, the workspace's ${theirs.stmts.length}" }
    for j, s in ours.stmts {
        let t = theirs.stmts[j]
        if ours.store.stmt_fingerprint(s) == theirs.store.stmt_fingerprint(t) { continue }
        return "statement ${j}${method_differing(ours.store, s, theirs.store, t)} means something else"
    }
    "its meaning, though every statement's fingerprint agrees"
}

/// An item read back with every node's file dropped, and its tape written again.
type Unhomed = { store: SyntaxArena, stmts: List<StmtId>, tape: SyntaxTape }

fn unhomed(tape: SyntaxTape) -> Unhomed {
    let store = new_node_store()
    let stmts = item_read_back(store, PlacedTape { start: 0, tape: tape })
    let none: ForeignOrigin? = null
    store.expr_origins.set([none for _o in store.expr_origins.get()])
    store.stmt_origins.set([none for _o in store.stmt_origins.get()])
    store.pat_origins.set([none for _o in store.pat_origins.get()])
    Unhomed { store: store, stmts: stmts, tape: tape_of_item(store, stmts) }
}

/// The first method two impls write differently, as `, method <name>`; nothing for any other pair.
fn method_differing(ours: SyntaxArena, s: StmtId, theirs: SyntaxArena, t: StmtId) -> string {
    let a? = ours.impl_parts(s) else { return "" }
    let b? = theirs.impl_parts(t) else { return "" }
    let at? = [j for j, f in a.fns if j >= b.fns.length || ours.stmt_fingerprint(f) != theirs.stmt_fingerprint(b.fns[j])]
        .first() else { return "" }
    ", method ${ours.fn_parts(a.fns[at])?.name ?? "${at}"}"
}
