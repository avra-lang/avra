//! WHAT A BUILD SAYS OF A FILE, as diagnostics: each refusal its laws or its manifest find, and
//! what only the program's entry may hold.
use core.{some_list}
use diagnostics.{Diag, has_errors}
use compiler.lower.{entry_only_refused, no_projection_refused}
use @std.errors.{Loc}
use @std.program.address.{SourceFileAddress}
use @std.program.query_engine.{QueryEngine}
use @std.program.source_facts.{source_text}

/// A file the program reads, and the path its diagnostics name it by.
export type ProgramFile = { file: SourceFileAddress, full: string }

/// What fails a build in the file `h` of the program whose entry is `entry`: each refusal its laws,
/// or its manifest's, find, then each statement it runs where it isn't the entry, or where it is, an
/// answer no text spells — said only of a file its laws refuse nothing in, as lowering is reached.
export fn file_refusals(engine: QueryEngine, h: ProgramFile, entry: ProgramFile) -> List<Diag> {
    let found = if is_manifest(h.file) { manifest_diags(engine, h) } else { file_law_diags(engine, h) }
    let own = !is_manifest(h.file) && h.full == entry.full
    let strays = if is_manifest(h.file) || own { [] } else { strays_of(engine, h.file) }
    let unspelled = if own && !has_errors(found) { entry_lowered(engine, h.file)?.unprojected } else { null }
    [d for d in found if !(d.severity is .Warning)]
        .concat([entry_only_refused(Loc { file: h.full, lo: s.lo, hi: s.hi }, entry.full) for s in strays])
        .concat(
            [no_projection_refused(Loc { file: h.full, lo: u.lo, hi: u.hi }, u.name) for u in some_list(unspelled)],
        )
}

/// The diagnostics every law finds in the file `h`, item by item.
export fn file_law_diags(engine: QueryEngine, h: ProgramFile) -> List<Diag> {
    [d! for at in 0..item_count(engine, h.file) for f in findings_in_file(engine, h.file, at) for d in [finding_diag(f, h.full)] if d != null]
}

/// What the manifest `h` says of itself.
fn manifest_diags(engine: QueryEngine, h: ProgramFile) -> List<Diag> {
    manifest_voices(h.full, source_text(engine, h.file) ?? "")
}
