//! THE SCOPE A COMPILER VALUE CROSSES UNDER — a declaration, a type and a file by their
//! durable names, an expression and a statement by their offset from the window it was made
//! over, and a place in a text as the token place it stands in.
use core.{DeclId, TypeId, FileId, hex, unhex, wire_fields}
use features.{Wanted, Wants, Sub}
use compiler.{Workspace}
use @std.text.{parse_int}
use @std.relation.stable.{Scope}

/// The id types a typing table holds.
enum IdKind {
    Decl
    Type
    File
    Expr
    Stmt
}

/// The id type a column names by its own declaration's name. A name this table does not hold is
/// spoken at the site, never guessed.
fn id_kind(name: string) -> IdKind? {
    match name {
        "DeclId" -> .Decl,
        "TypeId" -> .Type,
        "FileId" -> .File,
        "ExprId" -> .Expr,
        "StmtId" -> .Stmt,
        _ -> null,
    }
}

/// An offset text as the index it stands for under `base`.
fn counted_from(text: string, base: int) -> int? {
    let n? = parse_int(text) else { return null }
    n + base
}

/// A workspace and the two window starts a body's ids are offset from.
type FactsScope = { ws: Workspace, expr_base: int, stmt_base: int }

impl Scope for FactsScope {
    fn spelled(kind: string, index: int) -> string {
        let k? = id_kind(kind) else {
            self.ws.defect("a typing table holds an id of `${kind}`, which no scope spells")
            return ""
        }
        match k {
            .Decl -> self.ws.decl_ref(DeclId { index: index }),
            .Type -> self.ws.type_ref(TypeId { index: index }),
            .File -> self.ws.file_ref(FileId { index: index }),
            .Expr -> "${index - self.expr_base}",
            .Stmt -> "${index - self.stmt_base}",
        }
    }

    fn placed(file: string, lo: int, hi: int) -> List<int>? { self.ws.place_of(file, lo, hi) }

    fn unplaced(file: string, at: List<int>) -> List<int>? { self.ws.span_of(file, at) }

    fn unspelled(kind: string, text: string) -> int? {
        let k? = id_kind(kind) else { return null }
        match k {
            .Decl -> self.ws.decl_from_ref(text)?.index,
            .Type -> self.ws.type_from_wire(text)?.index,
            .File -> self.ws.decls.known_file_id(text)?.index,
            .Expr -> counted_from(text, self.expr_base),
            .Stmt -> counted_from(text, self.stmt_base),
        }
    }
}

impl Workspace {
    /// The scope a body's facts cross under: expressions counted from `lo`, statements from
    /// `stmt_lo` — the declaration's own window, whose negative statement start reads as the
    /// whole file's, exactly as `new_type_facts` reads it. One rule, applied on both sides, is
    /// what makes a written offset and a read one the same offset.
    fn facts_scope(lo: int, stmt_lo: int) -> dyn Scope {
        FactsScope { ws: self, expr_base: lo, stmt_base: if stmt_lo < 0 { 0 } else { stmt_lo } }
    }

    /// The ONE scope a query over the workspace names its dense ids through — its keys, its
    /// digests and its records: an expression or a statement by its index in its file.
    fn query_scope() -> dyn Scope { self.facts_scope(0, 0) }
}

impl Workspace {
    /// A declaration's durable name; empty for none.
    fn decl_ref(d: DeclId?) -> string {
        if d == null { return "" }
        self.decls.decl_wire(d!)
    }

    /// `decl_ref`'s inverse — the whole field is a wire, since a ref is never nested inside
    /// a wider tilde stream the way a type's own is.
    fn decl_from_ref(raw: string) -> DeclId? {
        if raw == "" { return null }
        let wd? = self.decls.wire_decl(raw.split("~"), 0) else { return null }
        wd.id
    }

    /// A declaration's durable name for a query keyed by it: its wire.
    fn decl_id_spelled(d: DeclId) -> string? { self.decl_ref(d) }

    /// The declaration a durable name names in this process, none for one gone.
    fn decl_id_numbered(spelled: string) -> DeclId? { self.decl_from_ref(spelled) }

    /// A file's durable name for a query keyed by it: its path.
    fn file_id_spelled(f: FileId) -> string? { self.decls.file(f).path }

    /// The file a path names in this process, none for one this process never met.
    fn file_id_numbered(spelled: string) -> FileId? { self.decls.known_file_id(spelled) }

    fn file_ref(f: FileId) -> string { self.decls.file(f).path }

    fn type_ref(t: TypeId) -> string { self.decls.type_wire(t) }

    /// `type_ref`'s inverse: split the `~`-joined words, read the primitive at 0, and
    /// require it to consume them all.
    fn type_from_wire(raw: string) -> TypeId? {
        if !raw.starts_with("^") { return null }
        let words = wire_fields(raw.substring(1, raw.length), "~")
        let d = self.decls.read_type_wire(words, 0)
        if d == null || d!.next != words.length { return null }
        d!.id
    }

    /// A run of wants as a row keeps it: its codec's octets, spelled.
    fn wants_text(xs: List<Wanted>) -> string { hex(Wants { list: xs }.encoded_in(self.facts_scope(0, 0))) }

    /// `wants_text` read back; none for a text it did not write or a declaration gone.
    fn wants_of_text(raw: string) -> List<Wanted>? {
        let octets? = unhex(raw) else { return null }
        match Wants.decoded_in(self.facts_scope(0, 0), octets) { .Ok(w) -> w.list, .Err(_) -> null }
    }

    /// A call's instantiation as a key spells it; empty for none.
    fn sub_text(sub: Sub?) -> string {
        let s? = sub else { return "" }
        hex(s.encoded_in(self.facts_scope(0, 0)))
    }
}

