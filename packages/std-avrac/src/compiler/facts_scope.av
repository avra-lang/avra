//! THE SCOPE A COMPILER VALUE CROSSES UNDER — a declaration, a type and a file by their
//! durable names, an expression and a statement by their offset from the window it was made
//! over, and a place in a text as the token place it stands in.
use core.{DeclId, TypeId, FileId}
use compiler.{Workspace}
use @std.text.{parse_int}
use @std.relation.stable.{Scope}
use features.{tree_saved, tree_unsaved}
use compiler.store.{cas_big, cas_blob, cas_ref_of, cas_value}

/// The id types a typing table holds.
enum IdKind {
    Decl
    Type
    File
    Expr
    Stmt
    /// A module id, which no scope names: a call keyed by one stays in the process.
    Module
}

/// The id type a column names by its own declaration's name. A name this table does not hold is
/// spoken at the site, never guessed.
fn id_kind(name: string) -> IdKind? {
    match name {
        "DeclId" -> .Decl,
        "TypeId" -> .Type,
        "FileId" -> .File,
        "ExprId" -> .Expr,
        "StmtId" -> .Stmt,
        "ModuleId" -> .Module,
        _ -> null,
    }
}

/// An offset text as the index it stands for under `base`.
fn counted_from(text: string, base: int) -> int? {
    let n? = parse_int(text) else { return null }
    n + base
}

/// A workspace and the two window starts a body's ids are offset from. A scope over no window
/// names no expression or statement: their arena places mean nothing past the process.
type FactsScope = { ws: Workspace, expr_base: int, stmt_base: int, windowed: bool }

impl Scope for FactsScope {
    fn spelled(kind: string, index: int) -> string {
        let k? = id_kind(kind) else {
            self.ws.defect("a typing table holds an id of `${kind}`, which no scope spells")
            return ""
        }
        match k {
            .Decl -> tree_saved(self.ws.decl_ref(DeclId { index: index })),
            .Type -> tree_saved(self.ws.type_ref(TypeId { index: index })),
            .File -> tree_saved(self.ws.file_ref(FileId { index: index })),
            .Expr -> if self.windowed { "${index - self.expr_base}" } else { "" },
            .Stmt -> if self.windowed { "${index - self.stmt_base}" } else { "" },
            .Module -> "",
        }
    }

    fn placed(file: string, lo: int, hi: int) -> List<int>? { self.ws.place_of(file, lo, hi) }

    fn unplaced(file: string, at: List<int>) -> List<int>? { self.ws.span_of(file, at) }

    /// A text over the shared store's cut is ONE blob there, named by its content.
    fn kept_out(text: string) -> string? {
        if !cas_big(text) || !cas_blob(text) { return null }
        cas_ref_of(text)
    }

    fn kept_back(reference: string) -> string? { cas_value(reference) }

    fn unspelled(kind: string, text: string) -> int? {
        let k? = id_kind(kind) else { return null }
        match k {
            .Decl -> self.ws.decl_from_ref(tree_unsaved(text))?.index,
            .Type -> self.ws.type_from_wire(tree_unsaved(text))?.index,
            .File -> self.ws.decls.known_file_id(tree_unsaved(text))?.index,
            .Expr -> counted_from(text, self.expr_base),
            .Stmt -> counted_from(text, self.stmt_base),
            .Module -> null,
        }
    }
}

/// THE SCOPE OF WHAT THE ARENA DID: an admission, a placement — facts of this process's arenas,
/// which name nothing past it, so a call under it stays in the process.
type InArena = {}

impl Scope for InArena {
    fn spelled(kind: string, index: int) -> string { "" }

    fn unspelled(kind: string, text: string) -> int? { null }

    fn placed(file: string, lo: int, hi: int) -> List<int>? { null }

    fn unplaced(file: string, at: List<int>) -> List<int>? { null }
}

/// The scope a declaration's placement is asked under.
fn in_arena(_ws: Workspace, _d: DeclId) -> dyn Scope { InArena {} }

/// The scope a file's admission is asked under.
fn in_arena_file(_ws: Workspace, _f: FileId) -> dyn Scope { InArena {} }

impl Workspace {
    /// The scope a body's facts cross under: expressions counted from `lo`, statements from
    /// `stmt_lo` — the declaration's own window, whose negative statement start reads as the
    /// whole file's, exactly as `new_type_facts` reads it. One rule, applied on both sides, is
    /// what makes a written offset and a read one the same offset.
    fn facts_scope(lo: int, stmt_lo: int) -> dyn Scope {
        FactsScope {
            ws: self,
            expr_base: lo,
            stmt_base: if stmt_lo < 0 { 0 } else { stmt_lo },
            windowed: true,
        }
    }

    /// The ONE scope a query over the workspace crosses its ids under: a declaration, a type and a
    /// file by its durable name; an expression or a statement names nothing, so a call keyed by
    /// one stays in the process and an answer holding one never reads back.
    fn query_scope() -> dyn Scope { FactsScope { ws: self, expr_base: 0, stmt_base: 0, windowed: false } }
}
