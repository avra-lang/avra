//! THE RULES THE SUITE PROVES, BY FN VALUE — a hand-wired stand-in
//! for a program-wide table auto-discovered from `Decls` by kind.
//! std-avrac tests itself, so a rule it declares is already part of
//! the very binary running `avra test`, and each entry here calls
//! straight through to a rule's own `@fixes`/`@keeps`, no evaluator
//! needed — the example TEXT itself is not re-stated.
use compiler.{checks_fixes, checks_keeps}
use features.nullable.{if_null_ternary}
use features.lists.{last_index}
use features.structs.{index_compared}

/// One example, checked — a line iff it failed.
type ExampleCheck = { label: string, ok: bool }

fn checked(label: string, ok: bool) -> ExampleCheck { ExampleCheck { label: label, ok: ok } }

/// Every ported rule's examples, checked. `avra test` reports the
/// count and fails the build on any miss — an example is part of
/// what a rule PROVES, the same way a program's `.expected` is.
export fn rule_examples_checked() -> List<ExampleCheck> {
    [
        checked("nullable.if_null_ternary @fixes", checks_fixes(if_null_ternary, "let v = if x == null { 0 } else { x! }", "x ?? 0")),
        checked("nullable.if_null_ternary @keeps", checks_keeps(if_null_ternary, "let v = if next() == null { 0 } else { next()! }")),
        // LICENSED I7: the example text names the idiom it proves —
        // the site the scanner is built to find, held as a string
        checked("lists.last_index @fixes", checks_fixes(last_index, "xs[xs.length - 1]", "xs.last()!")),
        checked("lists.last_index @keeps", checks_keeps(last_index, "xs[xs.length - 2]")),
        checked("structs.index_compared @keeps", checks_keeps(index_compared, "a.name == b.name")),
    ]
}
