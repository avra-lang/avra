//! WHAT A METHOD DOES, AS IR: the body an impl gives a type, lowered as a fn's is, its receiver the
//! first seat; a static fn's has no receiver. Its unit is named for the type, then the method.
use core.{LandedSeat, ParameterLayout, TypeHead, headed_type}
use @std.program.address.{SourceFileAddress}
use @std.program.query_engine.{QueryEngine}

/// The body of the method, or when `statics` the static fn, `name` the impl at `at` gives, lowered.
/// Absent when it gives none with a body.
export fn lowered_method(engine: QueryEngine, at: ImplAt, name: string, statics: bool) -> LoweredFn? { lowered_method_under(engine, at, name, statics, null) }

/// The body of the method, or when `statics` the static fn, `name` the impl at `at` gives, lowered
/// under `parameters`, one per type parameter its type declares then one per its own. Absent when it
/// gives none with a body.
export fn lowered_method_under(
    engine: QueryEngine,
    at: ImplAt,
    name: string,
    statics: bool,
    parameters: List<ParameterLayout>?,
) -> LoweredFn? {
    let method? = signed_method(engine, at, name, statics) else { return null }
    lowered_signed(engine, at.file, method.signed, "${method.owner}.${name}", parameters)
}

/// The default the method, or when `statics` the static fn, `method` of the type `of` declares as
/// `owner` writes for its seat `seat`, lowered as a fn of nothing answering the seat's type. Absent
/// where no one impl gives the method, or it writes none.
export fn lowered_method_seat_default(
    engine: QueryEngine,
    of: SourceFileAddress,
    owner: string,
    method: string,
    seat: string,
    statics: bool,
) -> LoweredFn? {
    let impls = impls_with(engine, of, owner, method, statics)
    if impls.length != 1 { return null }
    let m? = signed_method(engine, impls[0], method, statics) else { return null }
    seat_default_lowered(engine, impls[0].file, m.signed, "${owner}.${method}", seat)
}

/// A method's body signed, and the name of the type it's a method of.
type SignedMethod = { signed: SignedBody, owner: string }

/// The method, or when `statics` the static fn, `name` the impl at `at` gives, its body signed under
/// the impl's type parameters and its receiver the impl's target over them; absent when it gives
/// none with a body.
fn signed_method(engine: QueryEngine, at: ImplAt, name: string, statics: bool) -> SignedMethod? {
    let item = read_item(engine, at.file, at.item)
    let held? = item.stmts.find((s) -> item.store.impl_parts(s) != null) else { return null }
    let parts = item.store.impl_parts(held)!
    let stmt? = parts
        .fns
        .find((s) -> item.store.fn_parts(s)?.name == name && item.store.is_static(s) == statics) else { return null }
    let owner? = impl_named(
        engine,
        at.file,
        item.store.seat_home(held, LandedSeat.Target),
        parts.target,
    ) else { return null }
    let signature? = method_signature(engine, at, name) else { return null }
    let receiver = headed_type(TypeHead.Declared(owner.file, owner.name)) with { args: [headed_type(TypeHead.Parameter(i, p)) for i, p in at.params] }
    SignedMethod {
        signed: SignedBody {
            signature: signature,
            item: item,
            body: item.store.fn_parts(stmt)!.body,
            stmt: stmt,
            receiver: if statics { null } else { receiver },
        },
        owner: owner.name,
    }
}
