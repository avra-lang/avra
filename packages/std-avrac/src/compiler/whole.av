/// A path's tail under a directory — the path itself when it is
/// not under it.
fn below(path: string, dir: string) -> string {
    if dir.is_empty() || !under_dir(path, dir) { return path }
    path.substring(dir.length + 1, path.length)
}

/// A source file: `.av`, or anything at all under the empty root —
/// a lone file's package of one holds exactly what it was given.
fn is_source(name: string, dir: string) -> bool {
    name.ends_with(".av") || dir.is_empty()
}

/// The symbols a linked program's own start is found by.
const entry_symbols: List<string> = [
    "main",
    "avra_main",
    "_start",
    "_initialize",
    "__main_argc_argv",
]

/// Whether a host fn named `name` would define a symbol the link already has: the platform's, or a
/// linked program's own start. THE RULE'S CONDITION: "the platform defines it" is asked of the
/// machine the compiler stands on, so the same name can refuse on one build machine and pass on
/// another, and a build for another target is judged by this one's C library.
export fn host_fn_shadowing(name: string) -> bool { platform_defines(name) || entry_symbols.contains(name) }

fn segments_of(dotted_text: string) -> List<string> {
    if dotted_text.is_empty() { return [] }
    dotted_text.split(".")
}

/// Each kind once, the first row of a name kept.
fn distinct_codes(rows: List<DiagCode>) -> List<DiagCode> {
    mut seen: Map<string, bool> = {}
    mut out: List<DiagCode> = []
    for r in rows {
        if seen.get(r.kind) == null {
            seen.set(r.kind, true)
            out.push(r)
        }
    }
    out
}

/// A kinded constructor call as its source spells it: the kind
/// literal, and the message when that is a literal too.
type Kinded = { kind: string, message: string? }

impl Decls {
    /// A call to one of `@std/meta`'s KINDED constructors (`refuse_as`,
    /// `refuse_as_at`) whose kind is a literal; null for any other
    /// expression — the callee is judged by its DECLARATION's package,
    /// never by its written name.
    fn kinded_call(names: NameFacts, store: SyntaxArena, e: ExprId) -> Kinded? {
        let args? = match store.expr(e) { .Call(_, _, xs) -> xs, rest -> null } else { return null }
        let d: DeclId? = bound_decl_of(names, e)
        if d == null || self.package_of(d!) != "@std.meta" { return null }
        let message_at: int? = match self.decl(d!).name {
            "refuse_as" -> 1,
            "refuse_as_at" -> 2,
            _ -> null,
        }
        if message_at == null || args.length <= message_at! { return null }
        let kind: string? = store.expr(args[0]).text_of()
        if kind == null { return null }
        Kinded { kind: kind!, message: store.expr(args[message_at!]).text_of() }
    }
}

/// The entry's seat among the program's files.
type Entry = { at: int }

fn same_body(c: Case, body: ExprId) -> bool {
    // LICENSED structs.index_compared: node identity — ids compare by index
    c.body.index == body.index
}

/// What a link word reads of the machine it links on: an environment variable, and whether a file
/// is there.
export type LinkWorld = { env: fn(string) -> string?, there: fn(string) -> bool }

/// A row's words with their `${NAME}` holes filled, dropping any that fill to nothing. A hole naming
/// nothing asks for NO WORD: an empty one would be an argument the linker still counts, and a bare
/// `-L` eats the word after it.
export fn link_filled(words: List<string>, world: LinkWorld) -> List<string> {
    [w for w in [env_filled(x, world) for x in words] if !w.is_empty()]
}

/// A link input with its `${NAME}` holes filled from the environment: a machine's own paths belong
/// to the machine, not to a checked-in manifest. A value is data — the holes after it are filled,
/// never the value itself.
fn env_filled(flag: string, world: LinkWorld) -> string {
    let opens = flag.index_of("\${")
    if opens < 0 { return flag }
    let closes = closing_brace(flag, opens)
    if closes < opens { return flag }
    let head = flag.substring(0, opens)
    let name = flag.substring(opens + 2, closes)
    let tail = flag.substring(closes + 1, flag.length)
    "${head}${(world.env)(name) ?? platform_hole(name, world) ?? ""}${env_filled(tail, world)}"
}

/// WHAT A LINK HOLE MEANS ON THIS PLATFORM when the environment names nothing: the C++ runtime a
/// static LLVM needs, and the directory the system's zstd lives in where the driver's default search
/// does not reach it. The environment still wins (a machine's own paths belong to the machine); this
/// is the floor, so a link run from any shell — a Sprite, a test binary, a bare `build/avra` —
/// carries them without a shim having set them.
fn platform_hole(name: string, world: LinkWorld) -> string? {
    match name {
        "AVRA_CXX_RUNTIME" -> if links_with_ld64() { "c++" } else { "stdc++" },
        "AVRA_SYS_SEARCH" -> system_library_dir(world),
        rest -> null,
    }
}

/// The directory holding the system's `libzstd`: Homebrew's on macOS, else the first multiarch or
/// lib directory that has it. None when none does — the driver's own search then decides.
fn system_library_dir(world: LinkWorld) -> string? {
    let candidates = if links_with_ld64() {
        ["/opt/homebrew/lib", "/usr/local/lib"]
    } else {
        ["/usr/lib/x86_64-linux-gnu", "/usr/lib/aarch64-linux-gnu", "/usr/lib64", "/usr/lib"]
    }
    candidates.find((dir) -> holds_zstd(dir, world))
}

fn holds_zstd(dir: string, world: LinkWorld) -> bool {
    ["libzstd.a", "libzstd.so", "libzstd.dylib"]
        .any((name) -> (world.there)(joined_path(dir, name)))
}

/// The library a package's manifest `m` builds for the evaluator to open, declaring `externs`; absent
/// for a package that links no objects.
export fn manifest_library(m: Manifest, externs: List<string>) -> LinkedPackage? {
    if m.objects.is_empty() { return null }
    LinkedPackage {
        name: m.name,
        library: "build/lib${library_stem(m.name)}",
        externs: externs,
        wasm: !platform_objects(m, object_dir(Platform.Wasm)).is_empty(),
    }
}

/// The words a package links into every program that reaches it, its manifest `m` read where it
/// stands at `root`: its objects, its searched directories and libraries, and the root package's raw
/// words.
export fn manifest_link_words(
    m: Manifest,
    root: string,
    is_root: bool,
    world: LinkWorld,
    shared: bool = false,
    dir: string = "",
) -> List<string> {
    let search = link_filled(m.search, world)
    let standing = if shared && m.shared != "" { search.find((d) -> shared_beside(d, m.shared, world)) } else { null }
    [joined_path(root, o) for o in link_filled(platform_objects(m, dir), world)]
        .concat(["-L${d}" for d in search])
        .concat(
            if standing != null { ["-l${m.shared}", "-Wl,-rpath,${standing!}"] } else { ["-l${l}" for l in link_filled(m.libs, world)] },
        )
        .concat(if is_root { link_filled(m.raw, world) } else { [] })
}

/// Whether the directory `dir` holds the shared library `name`, as ELF or Mach-O names it.
fn shared_beside(dir: string, name: string, world: LinkWorld) -> bool {
    (world.there)(joined_path(dir, "lib${name}.so")) ||
        (world.there)(joined_path(dir, "lib${name}.dylib"))
}

/// The words a wasm link carries of the package `m` at `root`: the objects it carries there, its
/// holes filled; never a native `-L`, `-l` or `[link.raw]`.
export fn manifest_wasm_words(m: Manifest, root: string, world: LinkWorld) -> List<string> {
    [joined_path(root, o) for o in link_filled(platform_objects(m, object_dir(Platform.Wasm)), world)]
}

/// THE OBJECTS THE PACKAGE `m` CARRIES ON THE PLATFORM WHOSE OBJECT DIRECTORY IS `dir` (the host's
/// is empty): its `[link.objects_for]` set for that directory where it names one, else `objects`.
/// An entry names its file once, and the platform says where it is built: `dir` stands between
/// the entry's directory and its file.
export fn platform_objects(m: Manifest, dir: string) -> List<string> {
    let named = m.objects_for.find((p) -> p.dir == dir)
    [in_platform_dir(o, dir) for o in named?.objects ?? m.objects]
}

/// The object `entry` names, built for the platform whose object directory is `dir`.
fn in_platform_dir(entry: string, dir: string) -> string {
    if dir == "" { return entry }
    let parts = entry.split("/")
    parts.take(parts.length - 1).concat([dir, parts.last() ?? entry]).join("/")
}

/// The variables a word's `${NAME}` holes name, in order.
fn holes(word: string) -> List<string> {
    let opens = word.index_of("\${")
    if opens < 0 { return [] }
    let closes = closing_brace(word, opens)
    if closes < opens { return [] }
    [word.substring(opens + 2, closes)].concat(holes(word.substring(closes + 1, word.length)))
}

/// Whether a word is one hole and nothing else.
fn whole_hole(word: string) -> bool {
    let names = holes(word)
    names.length == 1 && word == "\${" + names[0] + "}"
}

/// Where the hole closes, or -1.
fn closing_brace(s: string, from: int) -> int {
    let at = s.substring(from, s.length).index_of("}")
    if at < 0 { return 0 - 1 }
    from + at
}
