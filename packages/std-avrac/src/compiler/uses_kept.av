//! A FILE'S USE LINES, KEPT: what its last parse said they were, the guess its next parse
//! is made under and checks (`Workspace.parsed_under_blocks`).
use core.{UseParts, StmtId, joined}
use compiler.store.{Store, Stored, node_key}

impl Workspace {
    /// The use lines a file's last parse said, when a store keeps them.
    fn kept_uses(path: string) -> KeptUses? {
        let store? = self.store.get() else { return null }
        let wire? = store.get(Stored.Unit, uses_key(self.root, path)) else { return null }
        let uses? = uses_of_wire(wire) else { return null }
        KeptUses { wire: wire, uses: uses }
    }

    /// Every file's use lines its parse said this build, kept for its next parse to guess its
    /// words by.
    fn keep_uses(store: Store) {
        for path, wire in self.records.uses_seen.get() {
            if store.get(Stored.Unit, uses_key(self.root, path)) != wire { let _ = store.keep(Stored.Unit, uses_key(self.root, path), wire, []) }
        }
    }
}

/// What a file that declares a component keeps in place of its use lines: no guess.
const DECLARES: string = "declares"

/// A file's kept use lines, and the wire they were kept as — what a parse's own lines are
/// compared by.
type KeptUses = { wire: string, uses: List<UseParts> }

/// Where a file's use lines are kept, by its path alone: a guess its next parse checks.
fn uses_key(root: string, path: string) -> string { node_key(Stored.Unit, ["uses", root, path]) }

/// A file's use lines as one text: each line's path, items and aliases. Never empty, so a file
/// with no use line keeps a row.
fn uses_wire(uses: List<UseParts>) -> string {
    joined(
        ["uses"]
            .concat(
                [joined([joined(u.path, "."), joined(u.items, ","), joined(u.aliases, ",")], "\t") for u in uses],
            ),
        "\n",
    )
}

/// `uses_wire`'s inverse; null for a text that is no such wire.
fn uses_of_wire(wire: string) -> List<UseParts>? {
    let lines = wire.split("\n")
    if lines.first() != "uses" { return null }
    [use_of_line(l)? for l in lines.drop(1)]
}

fn use_of_line(line: string) -> UseParts? {
    // a split drops the trailing empty fields an itemless or aliasless line ends with
    let cols = line.split("\t")
    if cols.is_empty() || cols.length > 3 { return null }
    UseParts {
        path: cols[0].split("."),
        items: some_words(if cols.length > 1 { cols[1] } else { "" }),
        aliases: some_words(if cols.length > 2 { cols[2] } else { "" }),
        stmt: StmtId { index: 0 },
    }
}

/// A comma list's words; none for an empty one.
fn some_words(field: string) -> List<string> { if field.is_empty() { [] } else { field.split(",") } }
