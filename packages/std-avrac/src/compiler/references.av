//! THE REFERENCES PASS — fills `Decls`'s references relation: one
//! row per named USE of a declaration (`Ref`, features/decls.av),
//! filled per file as that file is resolved and typed, replaced
//! whole when the file changes. A WHOLE-PROGRAM PASS MUST NOT RUN
//! INSIDE A RESOLVE — receivers.av's law, held here too: the pass
//! answers nothing while a resolve is in flight, and runs whole at
//! the first ask after.
//!
//! A ROW'S TARGET IS A DECLARATION, never a local: a param or a
//! `mut` local is scoped to its own body, so `Code.reads`/
//! `Code.writes` (features/code.av) answer those with a bounded walk
//! of their own, no whole-program relation needed — this pass only
//! ever settles rows keyed by `DeclId`, which is what crosses files.
//!
//! A WRITTEN TYPE NAMES A DECLARATION TOO: a param's, a field's, a
//! `let`'s annotation, a bound, a return — none of them a nested
//! EXPRESSION, so `expr_refs`'s walk never sees them on its own.
//! `type_use_refs` reads `SyntaxArena.type_roots` (core/parts.av) and
//! resolves every name it reaches — arguments and `or` alternatives
//! included — through the file's namespace, exactly as a written
//! type resolves under typing (`declare.av`'s `named_type`/
//! `trait_decl_named` both bottom out at `names.type_decl`). A name
//! bound as the STATEMENT's OWN type parameter names no declaration.
//!
//! AN ANNOTATION'S CALLEE IS AN ORDINARY EXPRESSION (`@name(args)` is
//! the call `name(...)`), so `expr_refs`'s blanket walk already sees
//! it — a decl and a type position alike. A FIELD MARK is not: it is
//! a free-standing WORD the compiler judges no reader over (marks
//! stay free names everywhere else), so `mark_refs` is the one place
//! that treats a mark's word as a POSSIBLE use — a fn visible under
//! that name reads through it, and a mark matching nothing answers
//! no row, exactly as an unclaimed mark answers no reader elsewhere.
use core.{
    DeclId,
    FileId,
    ExprId,
    StmtId,
    At,
    SyntaxArena,
    Nominal,
    TypeRef,
    UseParts,
    Mark,
    touch,
    fp,
    fp_list,
    flatten,
    some_list,
    Span,
    wire_fields,
    distinct,
    same_decl,
}
use features.{
    NameFacts,
    TypeFacts,
    Decls,
    Decl,
    Ref,
    UseKind,
    Import,
    bound_decl_of,
    declaring_decl,
    LANGUAGE_HOME,
}
use core.{Ids, same_file, sorted_by, fp_list}
use compiler.families.{Family}
use @std.relation.{query, codec, scoped_by, lasting}
use @std.relation.stable.{Scope}
use compiler.store.{Store}

/// A set of references: the answer of the queries below, which cross by their codec.
@codec
export type Uses = { rows: List<Ref> }

/// Where a reference stands in its own file, whose parse its reader stands on.
fn file_places(ws: Workspace, _f: FileId) -> dyn Scope { ws.facts_scope(0, 0) }

fn decl_places(ws: Workspace, _d: DeclId) -> dyn Scope { ws.facts_scope(0, 0) }

/// One file's references, the rows its walk found: the answer a restore brings back whole.
@query
@scoped_by(file_places)
export fn file_refs_made(ws: Workspace, f: FileId) -> Uses {
    ws.stand_after_typing()
    Uses { rows: ws.file_refs(f) }
}

/// Every named use of a declaration, from every file's own rows and the held files' kept
/// ones, indexed by declaration and by file. In the process only: a reader asks the
/// projections `refs_to` and `refs_from`, whose digests move only with their own rows.
type RefsIndex = {
    by_decl: Cell<Map<string, Cell<List<Ref>>>>,
    by_file: Cell<Map<string, Cell<List<Ref>>>>,
    digest: int,
}

impl RefsIndex {
    fn fingerprint() -> int { self.digest }
}

@query
fn refs_index(ws: Workspace) -> RefsIndex { ws.indexed_references() }

/// The references to one declaration.
@query
@scoped_by(decl_places)
export fn refs_to(ws: Workspace, d: DeclId) -> Uses { Uses { rows: refs_index(ws).by_decl.get().get("${d.index}")?.get() ?? [] } }

/// The references one file makes.
@query
@scoped_by(file_places)
export fn refs_from(ws: Workspace, f: FileId) -> Uses { Uses { rows: refs_index(ws).by_file.get().get("${f.index}")?.get() ?? [] } }

/// What a reader of `d`'s references stands on: their rows' fold, each row by durable name and
/// the rows in any order, so an edit that moves no row of `d` moves no reader of it.
@query
@lasting
fn refs_print(ws: Workspace, d: DeclId) -> int {
    let _ = ws.references()
    let rows: Cell<List<Ref>> = Cell.new([])
    ws.db.kernel.unheard(() -> rows.set(ws.refs_rows(d)))
    let ids = ws.decls.ids()
    fp_list(sorted_by([ref_fp(ids, r) for r in rows.get()], (a, b) -> a < b))
}

impl Workspace {
    /// The references to `d`, standing on their fold.
    fn refs_to_now(d: DeclId) -> List<Ref> {
        let _ = refs_print(self, d)
        let rows: Cell<List<Ref>> = Cell.new([])
        self.db.kernel.unheard(() -> rows.set(self.refs_rows(d)))
        rows.get()
    }

    /// The references to `d` as they stand: in a run on kept rows, what the last whole run kept,
    /// every file read again since by its own rows.
    fn refs_rows(d: DeclId) -> List<Ref> {
        if self.records.read_again.get() == null { return refs_to(self, d).rows }
        let kept? = refs_to_kept(self, d) else { return refs_to(self, d).rows }
        let moved = self.records.refs_moved.get()
        [r for r in kept.rows if !moved.any(same_file(it, r.file))]
            .concat(
                flatten(
                    [[r for r in file_refs_made(self, f).rows if same_decl(r.decl, d)] for f in moved],
                ),
            )
    }

    /// The references one file makes as they stand.
    fn refs_from_now(f: FileId) -> List<Ref> {
        if self.records.read_again.get() == null { refs_from(self, f).rows } else { file_refs_made(self, f).rows }
    }

    /// THE PASS: every admitted file's own rows, gathered — each surveyed file stands on
    /// its own `file_refs_made` answer, and this one reads those and the held files' kept rows.
    fn references() -> int {
        if self.db.family_active(Family.Resolved.ordinal) { return 0 }
        refs_index(self).digest
    }

    /// Whether a held file left the references INCOMPLETE — a decl may be read from inside one.
    fn refs_incomplete() -> bool {
        if self.records.read_again.get() != null { return false }
        self.db.family_active(Family.Resolved.ordinal)
    }

    /// The gathering, run: every surveyed file's rows, indexed.
    fn indexed_references() -> RefsIndex {
        self.stand_after_typing()
        let all_files = self.decls.all_files()
        let files = [x.id for x in all_files if self.reads_as_source(x.path)]
        let rows = flatten([file_refs_made(self, f).rows for f in files])
        // the rows' digest names what they say, and reads nothing of what they name
        let digest = Cell.new(0)
        self
            .db
            .kernel
            .unheard(() -> digest.set(fp(43, [fp_list([ref_fp(self.decls.ids(), r) for r in rows])])))
        RefsIndex {
            by_decl: Cell.new(grouped(rows, true)),
            by_file: Cell.new(grouped(rows, false)),
            digest: digest.get(),
        }
    }

    /// Whether a body is typing or a compile-time run is lowering: no whole-program pass
    /// computes then.
    fn typing_open() -> bool {
        self.db.family_active(self.typed_family()) ||
            self.db.family_active(Family.Folded.ordinal) ||
            self.comptime_active()
    }

    /// THE RELATION SETTLES AFTER TYPING. Computed while a file is still typing, or while a
    /// compile-time run is lowering, its walk would read `folded`'s smaller recursive view
    /// for that file and settle on an incomplete one — permanently, since a settled answer is
    /// never redone. An ask that reuses the settled rows reads nothing new, so only a COMPUTE
    /// there is the defect this names.
    fn stand_after_typing() {
        if self.typing_open() {
            avra_trap(
                "defect: the references relation settles after typing, and something asked for it while a file was still typing; open: ${self.db.kernel.open_stack()}",
            )
        }
    }

    /// One file's own rows: every expression naming a declaration,
    /// every assignment's own target, and every `use` line's imports.
    fn file_refs(f: FileId) -> List<Ref> {
        let names = self.resolved(f)
        let facts = self.folded(f)
        let store = self.decls.store_of(f)
        let expr_rows = flatten(
            [self.expr_refs(f, names, facts, store, ExprId { index: i }) for i in 0..store.exprs.count()],
        )
        let write_rows = flatten([self.write_refs(f, names, store, s) for s in store.stmt_ids()])
        let impl_rows = flatten(
            [self.impl_refs(f, names, d) for d in self.decls.decls_of_file(f) if self.decls.decl(d).kind is .Impl],
        )
        let type_rows = flatten([self.type_use_refs(f, names, store, s) for s in store.stmt_ids()])
        let mark_rows = flatten([self.mark_refs(f, names, store, s) for s in store.stmt_ids()])
        expr_rows
            .concat(write_rows)
            .concat(impl_rows)
            .concat(type_rows)
            .concat(mark_rows)
            .concat(self.template_refs(f, names, store))
            .concat(self.import_refs(f))
    }

    /// A TEMPLATE'S OWN NAMES are read where its quote is written, when
    /// it is spliced, and resolve never walks a quote's body — so each
    /// name a body calls or reads, spanned inside a quote and bound to
    /// nothing, is read here through this file's namespace, as a
    /// written type already is. A hole's fill is ordinary code, bound
    /// where it stands, and counted by the walk above.
    fn template_refs(f: FileId, names: NameFacts, store: SyntaxArena) -> List<Ref> {
        let quotes = flatten(
            [quote_span(store, ExprId { index: i }) for i in 0..store.exprs.count()],
        )
        if quotes.is_empty() { return [] }
        let inside = [ExprId { index: i } for i in 0..store.exprs.count() if spanned_in(store, ExprId { index: i }, quotes)]
        flatten([some_list(self.template_name_ref(f, names, store, e)) for e in inside])
    }

    fn template_name_ref(f: FileId, names: NameFacts, store: SyntaxArena, e: ExprId) -> Ref? {
        if bound_decl_of(names, e) != null { return null }
        let called: string? = store.callee_name(e)
        if called != null { return self.named_use(f, names, e, called!, UseKind.Call) }
        let read? = store.ident_name(e) else { return null }
        self.named_use(f, names, e, read, UseKind.Read)
    }

    /// A name resolved through the file's namespace — a fn's first, a
    /// type's for a name read as a receiver.
    fn named_use(f: FileId, names: NameFacts, e: ExprId, name: string, kind: UseKind) -> Ref? {
        let d? = names.names.fn_decl(name) ?? names.names.type_decl(name) else { return null }
        expr_use(d, f, e, kind)
    }

    /// An `impl … for` block's own TRAIT, and an impl's own TARGET
    /// type — both named in the SIGNATURE alone, never as an
    /// expression, so no expression-level walk sees them. `of`
    /// (features/decls.av's `DeclFacts`) is captured at admission;
    /// the target answers once the impl is SIGNED, which `folded(f)`
    /// (typing, `file_refs`'s own caller) already forced.
    fn impl_refs(f: FileId, names: NameFacts, d: DeclId) -> List<Ref> {
        let named = self.decls.impl_trait(d) ?? names
            .names
            .type_decl(self.decls.facts_of(d)?.of ?? "")
        [Ref { decl: t, file: f, at: At.Stmt(self.decls.decl(d).stmt), kind: UseKind.Read } for t in some_list(named).concat(some_list(self.decls.target_of(d)))]
    }

    /// One expression's own use, if it names a declaration — zero or
    /// one row: a `Call`'s callee and a `MethodCall`'s method are
    /// NAME fields, not nested expressions, so one expression id
    /// never contributes twice.
    fn expr_refs(f: FileId, names: NameFacts, facts: TypeFacts, store: SyntaxArena, e: ExprId) -> List<
        Ref,
    > {
        match store.expr(e).use_shape() {
            .Read -> some_list(self.use_of(f, names, e, UseKind.Read)),
            .Callee -> some_list(self.use_of(f, names, e, UseKind.Call)),
            .Method(subject, name) -> some_list(self.method_ref(f, facts, store, e, subject, name.of)),
            .Record(name) -> some_list(self.named_type_ref(f, names, e, name)),
            .Component(word) -> some_list(self.component_ref(f, names, e, word)),
            .TypeName(name) -> some_list(self.type_name_ref(f, names, e, name)),
        }
    }

    /// An expression's own binding, when it names a DECLARATION —
    /// null for a local (a param, a `mut`, a capture) and for an
    /// expression naming nothing.
    fn use_of(f: FileId, names: NameFacts, e: ExprId, kind: UseKind) -> Ref? {
        let d? = bound_decl_of(names, e) else { return null }
        expr_use(d, f, e, kind)
    }

    /// A method call's own target, read off the ALREADY-SETTLED
    /// method table (`Decls.methods_of`) — the subject's STATIC type
    /// names its declaring type, and the call's own name picks the
    /// member. `folded(f)` (`file_refs`'s own caller) already forced
    /// this file's typing, which forced every type it calls a method
    /// on to be signed; `self.methods(target)` (the QUERY, not the
    /// table) would re-walk that type's whole impl closure per call
    /// site even on a cache hit — the table read never does.
    fn method_ref(
        f: FileId,
        facts: TypeFacts,
        store: SyntaxArena,
        e: ExprId,
        subject: ExprId,
        name: string,
    ) -> Ref? {
        let target? = declaring_decl(self.decls.types.shape_of(facts.type_at(subject))) else { return null }
        let m? = self.decls.methods_of(target).find((d: DeclId) -> self.decls.decl(d).name == name) else { return null }
        Ref { decl: m, file: f, at: At.Expr(e), kind: UseKind.MethodCall }
    }

    /// A struct literal's own construction: its NAME spells a type
    /// directly, resolved through the file's namespace — the one
    /// construction site a name-use scan alone cannot see, since a
    /// literal's name is a text field, never a nested expression.
    fn named_type_ref(f: FileId, names: NameFacts, e: ExprId, name: Nominal) -> Ref? {
        self.type_name_ref(f, names, e, name.of)
    }

    /// An instance's own WORD (`within deadline { }`, `get "/p" { }`):
    /// `Expr.Component`'s component is a plain string, never a nested
    /// expression a name-use scan would see on its own — a component
    /// declares a `DeclKind.Record` (`declared_kind`, core/parts.av),
    /// resolved through the same TYPE namespace a struct literal's
    /// name is.
    fn component_ref(f: FileId, names: NameFacts, e: ExprId, word: string) -> Ref? {
        self.type_name_ref(f, names, e, word)
    }

    /// A type name read directly off a text field, never a nested
    /// expression — `named_type_ref` and `component_ref`'s one door.
    fn type_name_ref(f: FileId, names: NameFacts, e: ExprId, name: string) -> Ref? {
        let d? = names.names.type_decl(name) else { return null }
        Ref { decl: d, file: f, at: At.Expr(e), kind: UseKind.Read }
    }

    /// A statement's own assignment target, when its place is rooted
    /// in a declaration — rare (a declaration is almost never a
    /// writable place), kept for the relation's own symmetry.
    fn write_refs(f: FileId, names: NameFacts, store: SyntaxArena, s: StmtId) -> List<Ref> {
        let t? = store.assign_target(s) else { return [] }
        let root? = store.place_root(t) else { return [] }
        some_list(self.use_of(f, names, root, UseKind.Write))
    }

    /// Every written type on this statement's own signature, one row
    /// per declaration it names — the statement is the site, since a
    /// type has no expression id of its own to point at.
    fn type_use_refs(f: FileId, names: NameFacts, store: SyntaxArena, s: StmtId) -> List<Ref> {
        let tparams = store.decl_tparams(s)
        flatten(
            [[Ref { decl: d, file: f, at: At.Stmt(s), kind: UseKind.TypeUse } for d in type_use_decls(names, tparams, t)] for t in store.type_roots(s)],
        )
    }

    /// Every mark this statement's members carry, read where a fn
    /// answers to that word — the statement is the site, a mark
    /// having no expression id either. A mark is a free name: most
    /// match no fn at all and answer no row, exactly as a mark
    /// nothing claims still parses.
    fn mark_refs(f: FileId, names: NameFacts, store: SyntaxArena, s: StmtId) -> List<Ref> {
        flatten([some_list(self.mark_ref(f, names, s, m)) for m in store.marks_written(s)])
    }

    fn mark_ref(f: FileId, names: NameFacts, s: StmtId, m: Mark) -> Ref? {
        let d? = names.names.fn_decl(m.name) else { return null }
        Ref { decl: d, file: f, at: At.Stmt(s), kind: UseKind.Read }
    }

    /// Every `use` line's own imports, one row per item — the site is
    /// the `use` STATEMENT: several items on one line share it, since
    /// no finer position exists yet for an import specifier.
    fn import_refs(f: FileId) -> List<Ref> {
        let p = self.parsed(f)
        flatten([self.one_use_refs(f, p, u) for u in use_lines(p)])
    }

    fn one_use_refs(f: FileId, p: Parsed, u: UseParts) -> List<Ref> {
        [Ref { decl: i.decl, file: f, at: At.Stmt(u.stmt), kind: UseKind.Import } for i in self.imported_line(p, u).imports]
    }

    /// A FRESH FILE'S OWN OUTGOING REFERENCES, as its record's own
    /// lines — kept beside its declarations so a LATER attempt, holding
    /// this file, answers `references()`'s whole-program fold the same
    /// way this one did. The referenced declaration is named by its
    /// `decl_wire`, the one durable spelling of "which declaration": a
    /// `Ref`'s `decl`/`file` are `@local` (features/decls.av), this
    /// process's own integers. Read back by `restored_refs`, exactly the
    /// shape `declares` (record.av) excludes from a file's own count.
    fn ref_lines(path: string, refs: List<Ref>) -> List<string> {
        ["ref\t${path}\t${self.decls.decl_wire(r.decl)}\t${use_kind_word(r.kind)}" for r in refs]
    }
}

/// A written type's own declarations — recursing through its
/// arguments and its `or` alternatives, so `List<Foo>`, `Map<string,
/// Foo>` and `fn(Foo) -> Bar` are seen the way a bare `Foo` is.
/// Resolved through the file's namespace alone, as `named_type_ref`
/// resolves a struct literal's name — never a second resolver.
fn type_use_decls(names: NameFacts, tparams: List<string>, t: TypeRef) -> List<DeclId> {
    let here = if t.name.is_empty() || tparams.contains(t.name) { [] } else { some_list(names.names.type_decl(t.name)) }
    here
        .concat(flatten([type_use_decls(names, tparams, a) for a in t.type_args()]))
        .concat(flatten([type_use_decls(names, tparams, a) for a in t.alternatives]))
}

/// One row's own fingerprint — what the pass settles the whole
/// relation's answer on.
fn ref_fp(ids: Ids, r: Ref) -> int {
    let by_decl = ids.decl
    let by_file = ids.file
    fp(42, [by_decl(r.decl.index), by_file(r.file.index), kind_ord(r.kind)])
}

fn kind_ord(k: UseKind) -> int {
    match k { .Call -> 0, .MethodCall -> 1, .Read -> 2, .Write -> 3, .Import -> 4, .TypeUse -> 5 }
}

/// `UseKind`'s own wire spelling — one character, kept beside a
/// declaration's own record (`ref_lines`, interface.av's `record_of`)
/// so a held file's outgoing references answer back the same kind a
/// fresh scan would have found.
fn use_kind_word(k: UseKind) -> string {
    match k {
        .Call -> "C",
        .MethodCall -> "M",
        .Read -> "R",
        .Write -> "W",
        .Import -> "I",
        .TypeUse -> "T",
    }
}

/// Whether a record's line is a `ref` line.
fn is_ref_row(p: List<string>) -> bool { p.length >= 4 && p[0] == "ref" }

/// The file a `ref` line's declaration wire names.
fn ref_target(row: List<string>) -> string { wire_fields(row[2], "~")[0] }

/// Whether a `ref` line's use can name a type a signature carries — the one use a
/// reached file's importers inherit. A word no use spells might be one.
fn shapes_signature(word: string) -> bool {
    let k? = use_kind_of_word(word) else { return true }
    match k { .TypeUse -> true, .Call or .MethodCall or .Read or .Write or .Import -> false }
}

/// The inverse, by the one character — an unrecognized word decodes
/// to nothing, the same "a stale row answers no row" law the caller
/// (`file_refs`) already applies to a moved declaration name.
fn use_kind_of_word(w: string) -> UseKind? {
    match w {
        "C" -> UseKind.Call,
        "M" -> UseKind.MethodCall,
        "R" -> UseKind.Read,
        "W" -> UseKind.Write,
        "I" -> UseKind.Import,
        "T" -> UseKind.TypeUse,
        rest -> null,
    }
}

/// A quote's own span, as written — none for any other expression.
fn quote_span(store: SyntaxArena, e: ExprId) -> List<Span> {
    let body? = store.expr(e).body_of() else { return [] }
    match body.view {
        .Verbatim(_, _) -> some_list(store.expr_span(e)),
        .None or .Expanded(_) -> [],
    }
}

/// Whether an expression is written inside one of the quote spans —
/// never the quote itself.
fn spanned_in(store: SyntaxArena, e: ExprId, quotes: List<Span>) -> bool {
    let sp? = store.expr_span(e) else { return false }
    !store.spanned_elsewhere(e) && quotes.any((q: Span) -> q.lo < sp.lo && sp.hi <= q.hi)
}

/// Rows grouped by the index of their declaration, or of their file, in row order.
fn grouped(rows: List<Ref>, by_decl: bool) -> Map<string, Cell<List<Ref>>> {
    mut out: Map<string, Cell<List<Ref>>> = {}
    for r in rows {
        let k = if by_decl { "${r.decl.index}" } else { "${r.file.index}" }
        let held = out.get(k)
        if held == null { out.set(k, Cell.new([r])) } else { held!.push(r) }
    }
    out
}

/// One expression's use of a declaration.
fn expr_use(d: DeclId, f: FileId, e: ExprId, kind: UseKind) -> Ref { Ref { decl: d, file: f, at: At.Expr(e), kind: kind } }

/// Whether a declaration is read as a value anywhere, as the references pass settled it: a
/// consumer of that one bit stands on this answer, so a use of another name leaves it standing.
@query
fn read_found(ws: Workspace, d: DeclId) -> bool { ws.refs_to_now(d).any(it.kind is .Read) }
