//! THE RULES PASS: every node a file's own declarations hold, the
//! table's rules tried where their root-kind index admits (or
//! carries `any_root`) — design §5: nodes touched, never nodes ×
//! rules. `rule_candidates` is the ONE walk — `avra check`'s findings
//! (`rule_findings`) and `avra fix`'s proof both read it, so a
//! rewrite `check` shows is the exact one `fix` proves or refuses,
//! never a second derivation that could disagree.
use core.{At, StmtId, DeclId, SyntaxArena, flatten}
use features.{Code, Fix, Analysed}
use diagnostics.{Diag, warning}
use @std.errors.{Suggestion, Edit, Confidence, Loc}
use compiler.backend.{trimmed}

/// One rule's hit at one node, before any Diag is built.
export type Candidate = { at: At, owner: RuleEntry, fix: Fix }

/// Every rule hit under these statements — each walked from its own
/// root, expressions and nested statements alike (`every_at`), the
/// table's rules tried at every node whose root-kind index admits
/// it.
export fn rule_candidates(a: Analysed, stmts: List<StmtId>) -> List<Candidate> {
    let index = rule_index()
    stale_rules_spoken(a.view.store)
    flatten([stmt_candidates(a, index, s) for s in stmts])
}

fn stmt_candidates(a: Analysed, index: RuleIndex, s: StmtId) -> List<Candidate> {
    flatten([node_candidates(a, index, at) for at in every_at(a.view.store, At.Stmt(s))])
}

/// Every node under (and including) `root`, children before owner —
/// `core.every_expr`'s shape, generalized to every `At` kind, so a
/// rule rooted at a statement reaches it too. A `Pat.Quote`'s own
/// BODY never descends: it is the pattern's TEXT, mirrored into an
/// expr tree so a `quote{ ... }` pattern can be WRITTEN as code —
/// never code a rule should fire ON. Without this guard, a rule's
/// own declaration matches ITSELF: `if_start_raw`'s pattern spells
/// `Ins.IfStart(${c})`, and that reads as a real `Ins.IfStart` call
/// to every rule walking compiler/idioms.av (or any feature's own
/// idioms.av) — a PRECISION bug, not debt to license away.
fn every_at(store: SyntaxArena, root: At) -> List<At> {
    if quote_pattern(store, root) { return [root] }
    flatten([every_at(store, k) for k in store.kids_at(root)]).concat([root])
}

/// Whether `at` is a `Pat.Quote` — the PATTERN position. A rewrite's
/// own `-> quote { ... }` is an ordinary `Expr`, ANSWER position,
/// real code the walk still reaches and rules may still fire on.
fn quote_pattern(store: SyntaxArena, at: At) -> bool {
    match at { .Pat(id) -> store.pat(id) is .Quote, _ -> false }
}

fn node_candidates(a: Analysed, index: RuleIndex, at: At) -> List<Candidate> {
    let store = a.view.store
    flatten(
        [one_candidate(a, at, r) for r in index.at_node(store.shallow_at(at), store.kind_at(at))],
    )
}

fn one_candidate(a: Analysed, at: At, r: RuleEntry) -> List<Candidate> {
    let f? = r.run(code_at(a, at)) else { return [] }
    if site_licenses(a, at, r) { return [] }
    [Candidate { at: at, owner: r, fix: f }]
}

/// Whether the firing rule's own site carries `// LICENSED <id>:
/// <reason>` on the line directly above (`compiler.licenses`'
/// `site_licensed`, CLAUDE.md's exemption law) — a finding never
/// built for a site whose author already decided this IS the law,
/// not a defect.
fn site_licenses(a: Analysed, at: At, r: RuleEntry) -> bool {
    let loc? = code_at(a, at).loc() else { return false }
    site_licensed(a.view.store, a.view.source, a.view.source.linecol(loc.lo).line, rule_id(r))
}

/// The one construction seam: a rule's own subject, one node in one
/// analysis.
export fn code_at(a: Analysed, at: At) -> Code {
    Code { of: a, at: at }
}

/// Every candidate as a `Diag` — `avra check`'s findings. A `Fix.Say`'s
/// voice carries no kind of its own (`features/fix.av`'s `said`); this
/// is the ONE place either fix shape's `Diag` is stamped with the
/// firing rule's own identity (`rule_id`) — a `Fix.Rewrite` wraps in a
/// `Suggestion` over one `Edit` at the matched node's own span besides.
export fn rule_findings(a: Analysed, stmts: List<StmtId>) -> List<Diag> {
    flatten([candidate_diags(a, c) for c in rule_candidates(a, stmts)])
}

fn candidate_diags(a: Analysed, c: Candidate) -> List<Diag> {
    match c.fix {
        .Say(voice) -> [voice with { kind: rule_id(c.owner) }],
        .Rewrite(_) -> rewrite_diags(a, c.at, c.owner, c.fix),
        .Delete(what) -> delete_diags(a, c.at, c.owner, what),
    }
}

fn rewrite_diags(a: Analysed, at: At, r: RuleEntry, f: Fix) -> List<Diag> {
    let d? = rewrite_diag(a, at, r, f) else { return [] }
    [d]
}

/// A REWRITE'S DIAG CARRIES THE PROOF, NOT A CLAIM ABOUT IT: the
/// suggestion's one edit IS the rewrite, at the matched node's own
/// span — a node with no span (synthesized, never real source) has
/// nowhere to point an edit and answers no finding at all.
fn rewrite_diag(a: Analysed, at: At, r: RuleEntry, f: Fix) -> Diag? {
    let raw? = f.rendered() else { return null }
    let text = trimmed(raw)
    let loc? = code_at(a, at).loc() else { return null }
    let edit = Edit { loc: loc, replacement: text }
    let sg = Suggestion {
        confidence: Confidence.High,
        description: "rewrite to `${text}`",
        edits: [edit],
    }
    warning(rule_id(r), loc, "${rule_id(r)} — this is provably `${text}`", "this code", null) with { suggestions: [sg] }
}

fn delete_diags(a: Analysed, at: At, r: RuleEntry, what: List<DeclId>) -> List<Diag> {
    let d? = delete_diag(a, at, r, what) else { return [] }
    [d]
}

/// A DELETE'S DIAG CARRIES THE SAME EDITS `avra fix` would splice —
/// `delete_edits` (`rule_delete.av`) is the ONE builder, so a finding
/// `check` shows is the exact removal `fix` proves or refuses, never
/// a second derivation. `null` when nothing can be placed (no span at
/// the matched node) or nothing survives the References cross-check.
fn delete_diag(a: Analysed, at: At, r: RuleEntry, what: List<DeclId>) -> Diag? {
    let loc? = code_at(a, at).loc() else { return null }
    let edits? = delete_edits(a, a.view.source.text, what) else { return null }
    let sg = Suggestion { confidence: Confidence.High, description: "delete this", edits: edits }
    warning(rule_id(r), loc, "${rule_id(r)} — this is provably dead", "this code", null) with { suggestions: [sg] }
}
