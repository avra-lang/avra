//! WHERE A WRITTEN TYPE IS APPLIED TO WHAT IT DOESN'T TAKE: a type the language owns or one the
//! program declares, written in a statement's own signature, applied to another count of type
//! arguments than it takes — none where it takes none, all where it is generic — and a map keyed by
//! what is no text. Read off a written item's syntax and its file's names, said where the statement
//! stands, as the old path says it.
use core.{
    At,
    INFERRED,
    MAP_KEYS,
    SignedType,
    StmtId,
    SyntaxArena,
    TypeHead,
    TypeRef,
    files_as_key,
    flatten,
    keyed_anywhere,
    headed_type,
    spelled,
}
use compiler.laws.{Found, law}
use compiler.typing.{applied_bare, applied_counted, applied_unappliable, shape_named}
use diagnostics.{Voice}
use features.{self_word, type_row}
use features.maps.{map_keyless, map_unkeyed}
use @std.text.{parse_int}
use @std.program.address.{SourceFileAddress}
use @std.program.query_engine.{QueryEngine}

/// Every type the written item `view` shows writes, statement by statement, applied to what it
/// doesn't take: how, the type's name, then the counts or the key.
fn applied_refused(view: ItemView) -> List<Found> {
    let item = view.item
    if !item.store.refusals().is_empty() { return [] }
    let groups = flatten([keyed_under(view, top) for top in item.stmts])
    let params = flatten([item.store.tparams_in_scope(s) for g in groups for s in g.stmts])
        .concat(flatten([a.params for a in impls_seen(view)]))
    let scope = AppliedScope { engine: view.engine, file: view.file, params: params }
    flatten([misapplied_in(scope.judging(g.keyed), item.store, s) for g in groups for s in g.stmts])
}

/// The statement `s`'s types applied to what they don't take, read where its template wrote it when one
/// did: the scope is copied only for a statement a template wrote.
fn misapplied_in(scope: AppliedScope, store: SyntaxArena, s: StmtId) -> List<Found> {
    let writer = written_by(store, s)
    let read = if writer == null { scope } else { scope with { writer: writer } }
    [Found { at: span_of(kept_at(store.stmt_span(s))), args: words } for words in flatten([read.misapplied(t) for t in store.type_roots(s)])]
}

/// The statements of one declaration, and the type parameters its signature keys a map by.
type KeyedStmts = { stmts: List<StmtId>, keyed: List<string> }

/// The statements `top` holds, grouped by the declaration whose signature says what they key a map
/// by: an impl's methods each under the impl's target's and their own, any other under its own.
fn keyed_under(view: ItemView, top: StmtId) -> List<KeyedStmts> {
    let store = view.item.store
    let outer = store.tparams_in_scope(top)
    let parts? = store.impl_parts(top) else {
        let keyed = keyed_by(view.engine, view.file, outer, store.type_roots(top), [])
        return [judged_under(store, top, keyed)]
    }
    let target = filled_keys(
        view.engine,
        view.file,
        outer,
        parts.target,
        store.impl_target_args(top),
        [],
    )
    [KeyedStmts { stmts: [top], keyed: target }]
        .concat([method_under(view, f, outer, target) for f in parts.fns])
}

/// The statements the method `f` holds, each under what `target` keys of the impl's type parameters
/// `outer` and what the method's own signature keys.
fn method_under(view: ItemView, f: StmtId, outer: List<string>, target: List<string>) -> KeyedStmts {
    let store = view.item.store
    let keyed = target
        .concat(
            keyed_by(
                view.engine,
                view.file,
                outer.concat(store.tparams_in_scope(f)),
                store.type_roots(f),
                [],
            ),
        )
    judged_under(store, f, keyed)
}

/// Every statement under `at`, judged under the type parameters `keyed`.
fn judged_under(store: SyntaxArena, at: StmtId, keyed: List<string>) -> KeyedStmts { KeyedStmts { stmts: stmts_under(store, At.Stmt(at)), keyed: keyed } }

/// The type `written` a body reads, signed as `signed`: unknown where it is applied to another count of
/// type arguments than the type it names takes, its refusal said where it's written.
fn applied_signed(engine: QueryEngine, written: TypeRef, signed: SignedType) -> SignedType {
    if written.arrow || !written.alternatives.is_empty() { return signed }
    let takes? = match signed.head {
        .Owned(name) -> if name == written.name { type_row(avra().rows.types, name)?.arity ?? 0 } else { null },
        .Declared(file, name) -> if name == written.name && !declared_gathered(engine, file, name) { AppliedScope { engine: engine, file: file, params: [] }.takes(name) } else { null },
        rest -> null,
    } else { return signed }
    let spared = match signed.head {
        .Declared(file, name) -> spared_count(type_params_written(engine, file, name)),
        rest -> 0,
    }
    let keyed = written.name != MAP ||
        takes != 2 ||
        signed.args.length != 2 ||
        keys_filed(engine, signed.args[0])
    if fills(takes, spared, written.applied.length) && keyed { signed } else { headed_type(TypeHead.Unnamed(written.name)) }
}

/// Whether `found` type arguments fill a type taking `takes`, the last `spared` of them defaulted.
fn fills(takes: int, spared: int, found: int) -> bool { found <= takes && found >= takes - spared }

/// Whether `file` declares `name` as a gathered enum, whose type parameters are its members' to give:
/// asking them while a member's own record is signed would ask that record of itself, so its count
/// is its declaration's law, never a signing's.
fn declared_gathered(engine: QueryEngine, file: SourceFileAddress, name: string) -> bool { declaring_item(engine, file, name, ItemKind.CollectEnum) != null }

/// Whether a map files `key`s — text or a word, read through its names — or `key` is a name no type
/// stands behind, whose own law says it.
fn keys_filed(engine: QueryEngine, key: SignedType) -> bool {
    match key.head {
        .Unnamed(_) or .Inferred -> true,
        // only a declared key is read through its declaration: a signature asks nothing it needn't
        .Declared(_, _) -> files_as_key(
            named_over(engine, key) ?? key,
            (ty: SignedType) -> enum_shape(engine, ty),
            keyed_anywhere,
        ),
        .Owned(_) or .Parameter(_, _) or .Function or .Union or .Never or .Meta -> files_as_key(key, (_ty: SignedType) -> null, keyed_anywhere),
    }
}

/// Where a statement's written types are read: its file, the file whose template wrote it, the type
/// parameters its item declares, and those its declaration's signature keys a map by.
type AppliedScope = {
    engine: QueryEngine,
    file: SourceFileAddress,
    params: List<string>,
    writer: SourceFileAddress? = null,
    keyed: List<string> = [],
}

/// A map's key as a seat reads it, and where its names are read.
type KeySeen = { scope: AppliedScope, key: TypeRef }

impl AppliedScope {
    /// The declaration a type name names where this statement's template wrote it, else where it stands.
    fn named(name: string) -> DeclaredName? { named_where_written(self.engine, self.writer, self.file, name) }

    /// This scope, judging what a declaration's signature keys a map by, `keyed`.
    fn judging(keyed: List<string>) -> AppliedScope { if keyed.is_empty() { self } else { self with { keyed: keyed } } }

    /// The type `t` and each it holds, where applied to what it doesn't take, outermost first.
    fn misapplied(t: TypeRef) -> List<List<string>> {
        if t.spliced && self.writer != null { return (self with { writer: null }).misapplied(t with { spliced: false }) }
        let own = if t.arrow { [] } else { self.own_misapplied(t) }
        own.concat(flatten([self.misapplied(a) for a in t.type_args().concat(t.alternatives)]))
    }

    /// The type `t` itself applied to what it doesn't take; nothing for a name that names no type
    /// this law knows the parameters of.
    fn own_misapplied(t: TypeRef) -> List<List<string>> {
        let name = t.name
        if name.is_empty() || name == INFERRED || name == self_word || self.params.contains(name) { return [] }
        let takes? = self.takes(name) else { return [] }
        let found = t.applied.length
        if takes == 0 && found > 0 { return [["none", name]] }
        if fills(takes, self.spared(name), found) { return self.keyed_words(t) }
        if found == 0 { return [["bare", name, "${takes}"]] }
        [["count", name, "${found}", "${takes}"]]
    }

    /// Whether `t`, or a type it holds, leaves out type arguments its type's defaults fill: what only the
    /// program layer reads.
    fn written_short(t: TypeRef) -> bool {
        let takes = if t.arrow || self.params.contains(t.name) { null } else { self.takes(t.name) }
        takes != null &&
                t.applied.length < takes! &&
                fills(takes!, self.spared(t.name), t.applied.length) ||
            t.type_args().concat(t.alternatives).any((a) -> self.written_short(a))
    }

    /// Where the map `t`, or a place of the declared type `t` that it keys a map by, is keyed by what
    /// no map files, the words saying so; nothing for any other type.
    fn keyed_words(t: TypeRef) -> List<List<string>> {
        if t.name == MAP { return self.key_words(t.applied[0]) }
        if self.params.contains(t.name) || t.applied.is_empty() { return [] }
        let places = declared_keys(self.engine, self.file, t.name, [])
        flatten([self.key_words(a) for j, a in t.applied if places.contains(j)])
    }

    /// Where `key` keys a map by what no map files, the words saying so: a type parameter the
    /// declaration's signature doesn't key a map by, or any other type a map doesn't file.
    fn key_words(key: TypeRef) -> List<List<string>> {
        if self.params.contains(key.name) && !self.keyed.contains(key.name) && !self.unkeyed(key) { return [["keyless", key.name]] }
        if self.unkeyed(key) { return [["key", spelled(self.keyed_as(key, []).key)]] }
        []
    }

    /// How many of the type `name`'s type parameters, counted from the last, have a default: none for a
    /// type the language owns or a name the file sees no declared type by.
    fn spared(name: string) -> int {
        if type_row(avra().rows.types, name) != null { return 0 }
        let d? = self.named(name) else { return 0 }
        spared_count(type_params_written(self.engine, d.file, d.name))
    }

    /// How many type arguments the type `name` takes: a type the language owns, or a record, an
    /// enum or an alias the file sees; absent for any other.
    fn takes(name: string) -> int? {
        let row = type_row(avra().rows.types, name)
        if row != null { return row!.arity }
        if shape_named(name) != null { return 0 }
        let d? = self.named(name) else { return null }
        match d.kind {
            .Record or .Enum -> declared_params(self.engine, d.file, d.name).length,
            .Alias -> alias_written(self.engine, d.file, d.name)?.tparams?.length,
            .Fn or .Const or .State or .Named or .Trait or .Component or .Syntax or .Collect or .CollectEnum or .Ctx -> null,
        }
    }

    /// Whether a map keyed by `key` is keyed by what no map files: anything but text, a word or a type
    /// parameter, or a name the file sees no type by, whose own law says it. An alias is what it names.
    fn unkeyed(key: TypeRef) -> bool {
        let seen = self.keyed_as(key, [])
        let k = seen.key
        if seen.scope.params.contains(k.name) { return k.arrow || k.optional || !k.alternatives.is_empty() || !k.applied.is_empty() }
        if k.arrow || k.optional || !k.alternatives.is_empty() { return true }
        if MAP_KEYS.contains(k.name) { return !k.applied.is_empty() }
        if k.name == INFERRED || k.name == self_word { return false }
        let d? = seen.scope.named(k.name) else { return seen.scope.takes(k.name) != null }
        match d.kind {
            .Alias -> false,
            .Enum or .Named -> !keys_filed(seen.scope.engine, headed_type(TypeHead.Declared(d.file, d.name))),
            .Record or .Fn or .Const or .State or .Trait or .Component or .Syntax or .Collect or .CollectEnum or .Ctx -> true,
        }
    }

    /// `key` as a seat reads it: an alias taking no type arguments read as what it names, alias by
    /// alias through none among `seen`, where its own file reads it; any other type itself.
    fn keyed_as(key: TypeRef, seen: List<string>) -> KeySeen {
        let own = KeySeen { scope: self, key: key }
        if key.arrow ||
            !key.applied.is_empty() ||
            !key.alternatives.is_empty() ||
            self.params.contains(key.name) { return own }
        let d? = self.named(key.name) else { return own }
        if d.kind != ItemKind.Alias || seen.contains(d.name) { return own }
        let named? = alias_written(self.engine, d.file, d.name) else { return own }
        if !named.tparams.is_empty() { return own }
        let there = (self with { file: d.file, params: [], writer: null })
            .keyed_as(named.of, seen.concat([d.name]))
        there with { key: there.key with { optional: there.key.optional || key.optional } }
    }
}

/// The map type's name, whose first argument keys it.
const MAP: string = "Map"

/// a type is applied to the type arguments it takes, and a map is keyed by text or a word
export law type_applied_as_declared {
    kind: "type.applied"
    reads_view: applied_refused
    voice: applied_words
    witness: "fn f(m: Map<int, int>) -> int { 1 }\n"
}

fn applied_words(a: List<string>) -> Voice {
    match a[0] {
        "none" -> applied_unappliable(a[1]),
        "bare" -> applied_bare(a[1], parse_int(a[2]) ?? 0),
        "count" -> applied_counted(a[1], parse_int(a[2]) ?? 0, parse_int(a[3]) ?? 0),
        "keyless" -> map_keyless(a[1]),
        _ -> map_unkeyed(a[1]),
    }
}
