//! WHERE A `match`'S ARMS MEET AT NO TYPE: an arm answering what the others' answer can't join,
//! judged as the old path's arms law judges them — a `match` standing as a statement against its
//! first arm joined with each arm in turn, one a `void` fn ends on against the seat. A build that let
//! them through would join values of two types, or a value with nothing. Read off the item's typed
//! nodes; an arm typing doesn't know whole, one that leaves, and one of a type the language doesn't
//! own — whose acceptance a declaration's own laws decide — are left alone.
use core.{ExprId, OwnType, SignedType, Span, StmtId, flatten}
use compiler.laws.{Found, FoundFix, law}
use diagnostics.{Voice}
use features.{Conversion, arms_disagreement, interpolation, this_is, value_wanted, wrapped}
use @std.program.address.{SourceFileAddress}
use @std.program.query_engine.{QueryEngine}
use @std.program.source_facts.{source_text}

/// What a `match`'s arms are judged against: its first arm's answer, or the seat's.
type ArmsAnchor = { name: string, want: SignedType }

/// Every arm of a `match` in the written item `at` of `file` that disagrees with its anchor over
/// answering `void`.
fn arms_disagreeing(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<Found> {
    if at >= item_count(engine, file) { return [] }
    let item = read_item(engine, file, at)
    if !item.store.refusals().is_empty() { return [] }
    let void_tails = [b! for s in item.stmts for b in void_fn_bodies(engine, file, item, s) if b != null]
    let text = source_text(engine, file) ?? ""
    flatten([disagreeing_in(t, void_tails, text) for t in item_typed_nodes(engine, file, at, item)])
}

/// The body of the fn `s` declares where it answers `void`; none for any other statement.
fn void_fn_bodies(engine: QueryEngine, file: SourceFileAddress, item: ReadItem, s: StmtId) -> List<
    ExprId?,
> {
    let parts? = item.store.fn_parts(s) else { return [] }
    let sig? = fn_signature(engine, file, parts.name) else { return [] }
    if sig.answer.spelled() == "void" { [parts.body] } else { [] }
}

/// Every disagreeing arm among the nodes `t` reads: of each `match` a block holds as a statement,
/// and of each a `void` fn's body, among `void_tails`, ends on.
fn disagreeing_in(t: TypedNodes, void_tails: List<ExprId>, text: string) -> List<Found> {
    let blocks = [e for i in t.lo..t.hi for e in [ExprId { index: i }] if t.store.home_of(e) == null && t.store.block_stmts(e) != null]
    let stated = [x! for b in blocks for st in [t.store.block_stmts(b)!] if st.length > 1 for s in st.slice(0, st.length - 1) for x in [t.store.answer_of(s)] if x != null]
    let tails = [x! for b in void_tails for x in [t.store.tail_of(b)] if x != null && x!.index >= t.lo && x!.index < t.hi]
    flatten([arms_against(t, m, null, text) for m in stated])
        .concat(flatten([arms_against(t, m, void_seat(t, m), text) for m in tails]))
}

/// The seat a `void` fn's tail `m` is judged against, `void` as `m`'s first arm types it; absent
/// where none of its arms types as `void` to read it from.
fn void_seat(t: TypedNodes, m: ExprId) -> ArmsAnchor? {
    let v? = [ty! for ty in arm_types(t, m) if ty != null && voided(ty!)].first() else { return null }
    ArmsAnchor { name: "the seat", want: v }
}

/// The type each arm of the `match` `m` answers, absent where typing doesn't know it whole or the
/// arm leaves; none where `m` is no `match`.
fn arm_types(t: TypedNodes, m: ExprId) -> List<SignedType?> {
    [settled_arm((t.type_at)(a.value.index)) for a in t.store.match_arms(m) ?? []]
}

/// An arm's type as the law reads it: absent where it leaves or isn't known whole.
fn settled_arm(ty: SignedType?) -> SignedType? {
    let known? = ty else { return null }
    if known.bottom() ||
        known.dynamic ||
        known.generic() ||
        known.inferred() ||
        known.head is .Unnamed { null } else { known }
}

/// The first arm whose type is known, joined with each arm in turn that joins it, as the anchor its
/// fellows are judged against.
fn first_arm(types: List<SignedType?>) -> ArmsAnchor? {
    let known = [ty! for ty in types if ty != null]
    let first? = known.first() else { return null }
    mut want = first
    // LICENSED loops.push_loop: the want is the fold of the arms' joins, each read against the last
    for ty in known.drop(1) {
        let both = want.joined_with(ty)
        if both != null { want = both! }
    }
    ArmsAnchor { name: "the first arm", want: want }
}

/// Whether `ty` answers nothing.
fn voided(ty: SignedType) -> bool { ty.spelled() == "void" }

/// Every arm of the `match` `m` that its anchor — `seat`, or else its first arm joined with the rest —
/// can't join.
fn arms_against(t: TypedNodes, m: ExprId, seat: ArmsAnchor?, text: string) -> List<Found> {
    let arms = t.store.match_arms(m) ?? []
    let types = arm_types(t, m)
    let anchor? = seat ?? first_arm(types) else { return [] }
    if !(anchor.want.head is .Owned) || anchor.want.nullable() { return [] }
    [disagreeing(t, arms[j].value, ty!, anchor, text) for j, ty in types if ty != null && disagrees(ty!, anchor.want)]
}

/// The arm `v` of type `ty` refused against `anchor`, offering the conversion the old path offers
/// where there is one, over the arm's written text.
fn disagreeing(t: TypedNodes, v: ExprId, ty: SignedType, anchor: ArmsAnchor, text: string) -> Found {
    let args = [ty.spelled(), anchor.name, anchor.want.spelled()]
    let span = arm_span(t, v)
    let c? = conversion_of(ty, anchor.want, written(t, v, text)) else { return Found { at: span, args: args.concat([""]) } }
    Found {
        at: span,
        args: args.concat([c.help]),
        fixes: [
            FoundFix {
                description: c.how,
                at: span,
                replacement: c.text,
                sure: c.confidence is .High,
            },
        ],
    }
}

/// The text the arm `v` is written as; absent where a template wrote it.
fn written(t: TypedNodes, v: ExprId, text: string) -> string? {
    if t.store.foreign_of(v) != null { return null }
    let span? = t.store.expr_span(v) else { return null }
    if span.hi > text.length { null } else { text.substring(span.lo, span.hi) }
}

/// The conversion the old path offers of a `ty` written `shown` into a seat wanting `want`: the arm
/// as a list's one element, or a scalar interpolated into text; absent for none, or where the arm's
/// text isn't the file's own.
fn conversion_of(ty: SignedType, want: SignedType, shown: string?) -> Conversion? {
    let s? = shown else { return null }
    let element = want.listed()
    if element != null && element!.joined_with(ty) != null { return wrapped(s) }
    if want.owns(OwnType.Str) && scalar(ty) { interpolation(s) } else { null }
}

/// Whether `ty` is a number or a truth, which interpolation writes as text.
fn scalar(ty: SignedType) -> bool { ty.owns(OwnType.Int) || ty.owns(OwnType.Float) || ty.owns(OwnType.Bool) }

/// Whether an arm of type `ty` meets the want at no type: the language's own, not absence, and no join
/// between them.
fn disagrees(ty: SignedType, want: SignedType) -> bool { ty.head is .Owned && !ty.absence() && want.joined_with(ty) == null }

/// Where an arm's refusal points: its value.
fn arm_span(t: TypedNodes, v: ExprId) -> Span? { t.store.expr_span(v) }

/// a `match`'s arms meet at one type
export law match_arms_agree {
    kind: "type.match"
    reads: arms_disagreeing
    voice: disagreeing_words
    witness: "enum H {\n    A\n    B\n}\n\nfn note(n: int) { }\n\nfn f(h: H) -> int {\n    match h {\n        .A -> note(1),\n        rest -> {}\n    }\n    2\n}\n\nf(H.A)\n"
}

fn disagreeing_words(a: List<string>) -> Voice {
    Voice {
        message: arms_disagreement("a `match`'s arms", a[0], a[1], a[2]),
        label: this_is(a[0]),
        help: if a[3].is_empty() { value_wanted(a[2]) } else { a[3] },
    }
}
