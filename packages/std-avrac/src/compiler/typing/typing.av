//! The type pass: one declaration's body over its own expression
//! range, the signatures it names asked lazily as it reads them.
//! The CONTEXT is the pass's state — the walk's verbs are its
//! methods, and a feature's rule reaches the walk through them;
//! what a NODE's type IS lives in its owning feature's
//! NodeSemantics. Facts stay TOTAL: every expression has a TypeId,
//! never an option and never an Unknown — a hole or unresolved
//! name types as the interned Error, which ABSORBS: the causing
//! pass already spoke, so no diagnostic cascades from it.
use core.{
    StmtId,
    ExprId,
    TypeId,
    Type,
    TypeRef,
    TypeRegistry,
    DeclId,
    Binding,
    same_expr,
    flatten,
    mut_mark,
    Annotation,
}
use core.{SeatMark, FileId, same_type}
use diagnostics.{refusal}
use features.{
    TypeCx,
    NarrowFrame,
    Gathering,
    OpenLoop,
    Dispatch,
    semantics_of,
    stmt_semantics_of,
    post_order,
    FnSig,
    TypeRow,
    type_row,
    Decl,
    new_type_facts,
    TypeFacts,
    NameFacts,
    FileView,
    nothing,
    scalar_named,
    Elsewhere,
    example_marks,
}
use features.structs.{fits_default}
use features.fns.{fits_seat_default}
use features.specs.{fits_case}
use features.annotations.{check_annotation}
use features.closures.{takes_by_name}
use features.impls.{derive_contract}

/// A type context over one expression range of a file, reading the
/// SHARED declaration table — a signature may name any file's
/// types, and asking for one computes it. The table is born total:
/// every slot pre-typed as the hole.
export fn new_type_cx(
    dispatch: Dispatch,
    keywords: List<string>,
    view: FileView,
    names: NameFacts,
    elsewhere: Elsewhere,
    lo: int,
    hi: int,
) -> TypeCx {
    let hole = view.types.intern(Type.Error)
    TypeCx {
        view: view,
        names: names,
        elsewhere: elsewhere,
        writer: null,
        facts: new_type_facts(lo, hi, view.store.stmts.count(), hole),
        error_type: hole,
        dispatch: dispatch,
        keywords: keywords,
        scope: [],
        narrow_defs: [],
        narrow_params: [],
        fn_ret: [],
        lam_bar: [],
        tscope: [],
        pairs: [],
        task_bodies: [],
        starving: false,
        aliased_warned: [],
    }
}

impl TypeCx {
    /// One declaration typed, then its facts: a fn's or method's body
    /// under its signature (asked lazily), a default's under its field,
    /// Main's run-time statements in order, a type's statement-level
    /// law. A trait's and an impl's members are declarations of their
    /// own; a trait's `derive` answers to its contract here.
    mut fn type_decl(x: Decl) -> TypeFacts {
        match x.kind {
            .Main -> {
                self.type_stmts(runtime_stmts(self.view))
                // a top-level declaration's annotations sit ABOVE it,
                // so the entry's body owns them, and types them here —
                // its own `@fixes`/`@keeps` args included, read at
                // lowering by components/lower.av's `augmented`.
                for s in self.view.stmts {
                    if self.view.store.is_declaration(s) {
                        self.type_annotations(s)
                        self.type_example_args(s)
                    }
                }
            },
            // a bodyless fn is an EXTERN, and its declaration has laws
            // of its own — `stmt_semantics_of` already routes it home
            .Fn if x.root == null -> self.type_stmts([x.stmt]),
            .Fn -> self.fn_body(x),
            .Method if x.root == null -> nothing(),
            .Method -> self.method_body(x),
            .Default -> self.default_body(x),
            .Case -> self.case_body(x),
            .Record or .Named or .Alias or .Enum or .Const or .Syntax or .Collect or .CollectEnum or .State -> self.type_stmts([x.stmt]),
            // a trait's members type as methods; the trait holds its
            // `derive` to the contract where it is written
            .Trait -> derive_contract(self, x.stmt),
            .Impl or .Builtin -> nothing(),
        }
        self.speak_hungry()
        self.facts
    }

    /// A fn's body, then its seats' contract — every `mut` seat judged
    /// against what the body does.
    mut fn fn_body(x: Decl) {
        self.type_stmts([x.stmt])
        self.seat_contract(x, 0)
    }

    /// A method's body, then its receiver's contract — the trait's word
    /// and the `mut fn` word judged against what the body does.
    mut fn method_body(x: Decl) {
        self.type_stmts([x.stmt])
        self.receiver_contract(x)
    }

    /// A default walks under its field's or seat's want, in its
    /// owner's type scope, and the field or seat judges it.
    mut fn default_body(x: Decl) {
        let root: ExprId = x.root!
        let want: TypeId = self.view.decls.sig(x.id)?.fn_sig()?.ret ?? self.error_type
        self.enter_tscope(x.stmt)
        self.plant_want(root, want)
        self.walk(root)
        self.leave_tscope()
        match self.view.decls.decl(x.parent!).kind {
            .Record -> fits_default(self, root, x.name, want),
            .Fn or .Method -> fits_seat_default(self, root, x.name, want),
            .Named or .Alias or .Enum or .Trait or .Syntax or .Default or .Impl or .Main or .Case or .Builtin or .Const or .Collect or .CollectEnum or .State -> nothing(),
        }
    }

    /// A test case's body walks under the bool it declared — a
    /// `return` inside answers it — and its feature judges the answer.
    mut fn case_body(x: Decl) {
        let root: ExprId = x.root!
        let want: TypeId = self.view.decls.sig(x.id)?.fn_sig()?.ret ?? self.error_type
        // LICENSED compiler.bracket_ritual: this IS the bracket
        self.fn_ret.push(want)
        let outer_providers = self.providers
        self.providers = []
        self.plant_want(root, want)
        self.walk(root)
        self.providers = outer_providers
        let _ = self.fn_ret.pop()
        fits_case(self, root, want)
    }

    /// THE WALK — the context's own verbs, which every feature's rule
    /// reaches through the contract: statements in order through their
    /// StmtSemantics (the ONE statement loop, top level and blocks
    /// alike), a subtree's nodes in post-order through their
    /// NodeSemantics, and the scoped walks a rule asks for. `scope` is
    /// the seats in force; a fn body sets it for exactly its walk.
    /// Statements in order, each through its own StmtSemantics.
    mut fn type_stmts(stmts: List<StmtId>, value: ExprId? = null) {
        let was = self.starving
        self.starving = false
        let base = self.providers.length
        for s in stmts {
            stmt_semantics_of(self.dispatch, self.view.store.stmt(s)).type_stmt(self, s)
            self.unowned_tasks(s)
            self.type_annotations(s)
            self.open_provider(s)
        }
        // A BLOCK'S VALUE IS INSIDE ITS PROVIDER SCOPE: a tail `env`
        // reads a sibling `provide` of the same block.
        if value != null { let _ = self.walk_type(value!) }
        self.providers = self.providers.slice(0, base)
        self.starving = was
    }

    /// A `provide` statement's type enters the open list, for the rest
    /// of its statement list — the scope `type_stmts` closes.
    mut fn open_provider(s: StmtId) {
        if !self.view.store.is_provide_stmt(s) { return }
        self.providers.push(self.def_type(s))
    }

    /// A fn BODY's walk: the declared answer, the type parameters
    /// and the SEATS are in scope for exactly the walk — `return`
    /// judges where it stands, a body-level `let x: T` resolves the
    /// fn's own Vars, and a param's read answers its seat.
    mut fn walk_under(s: StmtId, body: ExprId) {
        let sig: FnSig? = self.stmt_sig(s)
        let outer = self.scope
        let outer_marks = self.scope_marks
        // A BODY READS NO PROVIDER OF ITS ENCLOSING BODY: the requirement
        // is fulfilled where the body stands, never inherited across a
        // fn floor — lowering's per-body context has no mirror of them.
        let outer_providers = self.providers
        self.providers = []
        // LICENSED compiler.bracket_ritual: this IS the bracket
        self.fn_ret.push(sig?.ret ?? self.error_type)
        self.scope = sig?.params ?? []
        self.scope_marks = self.view.decls.marks_of(self.decl_of(s), self.scope.length)
        self.enter_tscope(s)
        let ret: TypeId? = sig?.ret
        if ret != null { self.plant_want(body, ret!) }
        self.walk(body)
        self.leave_tscope()
        self.scope = outer
        self.scope_marks = outer_marks
        self.providers = outer_providers
        let _ = self.fn_ret.pop()
    }

    /// One subtree's nodes, children before owners. STARVING is the
    /// re-run node's alone: a subtree walked beneath it feeds and
    /// goes hungry as any walk does, so the brackets here and in
    /// `type_stmts` and `feed` clear the word for exactly the
    /// nested work.
    /// A statement's annotations, each typed by the body that OWNS its
    /// expressions: an annotation sits above its declaration, outside
    /// the declaration's own span, so the enclosing body holds it and
    /// a declaration's own context passes it by.
    mut fn type_annotations(s: StmtId) {
        for a in self.view.store.annotations_of(s) {
            // A rule's `@fixes`/`@keeps` are recognised by NAME, like
            // `@derive` — but unlike it, neither resolves to a
            // declared fn at all, so the general call law never
            // reaches them; `rule`'s own `check()` judges their
            // presence. Their ARGS type separately, under MAIN's own
            // wide window (`type_example_args`) — they sit ABOVE the
            // declaration, same as the callee this door already
            // skips, so a declaration's own narrow window passes
            // them by too.
            if !example_marks(a.name) && self.facts.owns(a.callee) {
                self.walk_annotation(a)
                check_annotation(self, s, a)
            }
        }
    }

    /// `@fixes`/`@keeps` args, typed under MAIN's wide window — the
    /// one place their span is inside the window in force, same as
    /// their callee already reads from here.
    mut fn type_example_args(s: StmtId) {
        for a in self.view.store.annotations_of(s) {
            if example_marks(a.name) { for e in a.args { let _ = self.walk_type(e) } }
        }
    }

    /// An annotation's callee types as an expression does. Its
    /// arguments type inside `check_annotation`, where the seats are
    /// known: a declaration's NAME is its meta value there. A callee
    /// naming a generic fn is a rule's, called where a reader splices
    /// it and never worn as a value here.
    mut fn walk_annotation(a: Annotation) {
        let d: DeclId? = self.bound_decl(a.callee)
        if d != null && !self.view.decls.tparams(d!).is_empty() { return }
        self.walk(a.callee)
    }

    mut fn walk(root: ExprId) {
        let was = self.starving
        self.starving = false
        for e in post_order(self.dispatch, self.view.store, root) { self.type_node(e) }
        self.starving = was
    }

    /// A subtree typed on request, answering its own type — what a
    /// CONTROL-OWNING node uses for children it hides from the walk.
    mut fn walk_type(root: ExprId) -> TypeId {
        self.walk(root)
        self.facts.type_at(root)
    }

    /// A block's statements type in order, then its value — which
    /// IS the block's type. A block that LEAVES (no tail — the
    /// builder proved its last statement diverges) answers whatever
    /// the fn it leaves promises: the body check passes exactly, and
    /// a value-position arm joins only where the promise's type fits.
    mut fn block_type(stmts: List<StmtId>, value: ExprId?) -> TypeId {
        if value == null {
            self.type_stmts(stmts)
            return self.valueless_type(stmts)
        }
        self.type_stmts(stmts, value)
        self.type_at(value!)
    }

    /// A block with no value: the fn's promise when its last
    /// statement LEAVES THE FN (nothing reads the tail), void otherwise.
    fn valueless_type(stmts: List<StmtId>) -> TypeId {
        let last: StmtId? = stmts.last()
        if last != null && self.view.store.leaves_fn(last!) { return self.fn_ret.last() ?? self.error_type }
        self.view.decls.types.type(void)
    }

    /// A lambda's body typed under its params, behind the BARRIER —
    /// `return`/`?`/`fail` inside see no enclosing fn. Params and
    /// captures register FIRST so the body's reads answer.
    mut fn lambda_body(lam: ExprId, ptys: List<TypeId>, marks: List<SeatMark>, body: ExprId) -> TypeId {
        self.facts.seat_lambda(lam, ptys, marks)
        self.facts.seat_captures(lam, self.capture_seats(lam))
        // LICENSED compiler.bracket_ritual: this IS the bracket
        self.lam_bar.push(self.fn_ret.length)
        let outer_providers = self.providers
        self.providers = []
        let ret = self.walk_type(body)
        self.providers = outer_providers
        let _ = self.lam_bar.pop()
        ret
    }

    /// A loop's statements, typed as ONE TURN — what a `break` among
    /// them ends.
    mut fn turn_stmts(owner: StmtId, stmts: List<StmtId>) {
        let outer = self.loops
        self.loops = outer.concat([OpenLoop { owner: owner, bars: self.lam_bar.length }])
        self.type_stmts(stmts)
        self.loops = outer
    }

    /// A comprehension typed as a walk no jump ends — its answer.
    mut fn sealed_walk(body: fn(mut TypeCx) -> TypeId) -> TypeId {
        let outer = self.loops
        self.loops = outer.concat([OpenLoop { owner: null, bars: self.lam_bar.length }])
        let ty = body(self)
        self.loops = outer
        ty
    }

    /// A `collect`'s body walked under its own frame: the values its
    /// statements discard, in the order they ran.
    mut fn gathered(body: ExprId) -> List<ExprId> {
        // LICENSED compiler.bracket_ritual: this IS the bracket
        self.gathers.push(Gathering { bars: self.lam_bar.length, values: [] })
        let _ = self.walk_type(body)
        self.gathers.pop().values
    }

    /// A statement's discarded value, kept by the `collect` it stands
    /// in — none keeps it from behind a lambda, and `void` is nothing
    /// to keep.
    mut fn gather(s: StmtId) {
        let v? = self.view.store.stmt_value(s) else { return }
        let top = self.gathers.length - 1
        if top < 0 ||
            self.gathers[top].bars != self.lam_bar.length ||
            !self.view.types.holds_value(self.type_at(v)) {
            return
        }
        self.gathers[top].values.push(v)
        self.facts.mark_kept(v)
    }

    /// What the lambda captured, typed in lane order — each the
    /// captured binding's own type.
    fn capture_seats(lam: ExprId) -> List<TypeId> {
        let cap? = self.names.capture(lam) else { return [] }
        [self.binding_ty(b) for b in cap.sources]
    }

    /// THE RESCUE: a hungry lambda re-types under the seats it lands
    /// in — the judging boundary hands them over, the body walks
    /// once, and every fact (of_expr, lambda_params) converges as if
    /// the annotations had been written. `answer`, when the boundary
    /// knows one, is planted on the body first — the same "THE BODY
    /// HEARS THE ANSWER" door `lambdaed` opens for an annotated
    /// lambda's — so a bare variant, a `dyn` box, or an uncovered
    /// arms-sugar variant under a nullable seat reads it here too. A
    /// boundary with no declared answer (a list walk's predicate,
    /// figured out from the body rather than declared) plants none.
    mut fn retype_seated(
        a: ExprId,
        seats: List<TypeId>,
        marks: List<SeatMark>,
        answer: TypeId? = null,
    ) -> TypeId? {
        if !self.facts.hungry_at(a) { return null }
        let parts? = self.view.store.lambda_parts(a) else { return null }
        if parts.params.length != seats.length || takes_by_name(self, parts.params, seats) { return null }
        self.facts.absorb_hunger(a)
        if answer != null { self.plant_want(parts.body, answer!) }
        let ret = self.lambda_body(a, seats, marks, parts.body)
        let ty = self.view.types.intern(Type.Fn(seats, marks, ret))
        self.facts.set_type(a, ty)
        ty
    }

    /// THE FEED: a hungry expression re-typed under the want the
    /// door hands it — the want planted (it flows to the heirs),
    /// then every hungry node beneath re-run in post-order, each
    /// under the scope it was typed in, and the expression last;
    /// kids that were never hungry keep their types.
    mut fn feed(e: ExprId, want: TypeId) {
        if !self.facts.hungry_at(e) { return }
        self.plant_want(e, want)
        let outer = self.scope
        let was = self.starving
        self.starving = false
        for h in self.beneath(e) {
            if self.facts.hungry_at(h) {
                self.facts.absorb_hunger(h)
                self.scope = self.facts.scope_at(h) ?? outer
                self.type_node(h)
            }
        }
        self.scope = outer
        self.starving = was
    }

    /// A branch typed under a PROVEN-PRESENT binding: when the asked
    /// subject is an effectively-final nullable — a `let` (never a
    /// `mut`) or a param — its reads inside the branch narrow to the
    /// carried type, each read recorded so lowering unwraps it. A
    /// subject that cannot be proven simply walks un-narrowed: the
    /// sugar is never load-bearing (spec 10.4).
    mut fn walk_narrowed(subject: ExprId, branch: ExprId) -> TypeId {
        let b? = self.names.binding(subject) else { return self.walk_type(branch) }
        match b {
            .Def(s) -> self.narrowed_def_walk(s, branch),
            .Param(i) -> self.framed(Narrowing.Params, i, self.seat_type(i), branch),
            // lambda params, captures and the receiver never narrow — walk wide
            .Receiver or .Pattern(_, _) or .LambdaParam(_, _) or .Capture(_, _) or .Index(_) or .Decl(_) -> self.walk_type(branch),
        }
    }

    mut fn narrowed_def_walk(s: StmtId, branch: ExprId) -> TypeId {
        // A `mut` can be reassigned mid-branch — never narrowed.
        if !(self.view.store.stmt(s) is .Let) { return self.walk_type(branch) }
        self.framed(Narrowing.Defs, s.index, self.def_type(s), branch)
    }

    /// The narrow bracket: when `opt` really is a nullable, its frame
    /// lives on the selected stack exactly as long as the branch's
    /// walk; otherwise the walk runs bare.
    mut fn framed(which: Narrowing, key: int, opt: TypeId, branch: ExprId) -> TypeId {
        let inner: TypeId? = self.view.types.carried(opt)
        if inner == null { return self.walk_type(branch) }
        self.push_frame(which, NarrowFrame { key: key, inner: inner!, opt: opt })
        let answer = self.walk_type(branch)
        self.pop_frame(which)
        answer
    }

    /// One node typed by its feature — and HUNGRY when a kid is: the
    /// want that feeds the kid arrives through this node. The scope
    /// it ran under is remembered, for the feed.
    mut fn type_node(e: ExprId) {
        let node = self.view.store.expr(e)
        let sem = semantics_of(self.dispatch, node)
        self.facts.set_type(e, sem.type_of(self, e))
        if self.any_hungry(sem.kids(node).concat(sem.heirs(node))) { self.facts.go_hungry(e) }
        if self.facts.hungry_at(e) { self.facts.remember_scope(e, self.scope) }
    }

    fn any_hungry(ids: List<ExprId>) -> bool {
        for k in ids {
            if self.facts.hungry_at(k) { return true }
        }
        false
    }

    /// Every node beneath `e` — through kids AND heirs, the arms a
    /// control node hides from the walk — in post-order, `e` last.
    fn beneath(e: ExprId) -> List<ExprId> {
        let node = self.view.store.expr(e)
        let sem = semantics_of(self.dispatch, node)
        flatten([self.beneath(k) for k in sem.kids(node).concat(sem.heirs(node))]).concat([e])
    }

    /// Every expression still hungry when typing ends never met the
    /// want it needed — its rule runs once more, STARVING, and
    /// speaks in its own words.
    mut fn speak_hungry() {
        self.starving = true
        for e in self.facts.hungry_ones() {
            self.scope = self.facts.scope_at(e) ?? []
            self.type_node(e)
        }
        self.starving = false
    }

    /// An ident's type, by its binding kind — NARROWED when a
    /// presence test proved this binding present in the branch
    /// being walked (the narrow is recorded for lowering, which
    /// unwraps the read at its one edge). No binding means resolve
    /// already spoke — Error, silently.
    mut fn target_type(e: ExprId) -> TypeId {
        let b? = self.names.binding(e) else { return self.error_type }
        match b {
            .Param(i) -> self.narrowed_param(e, i) ?? self.seat_type(i),
            // the receiver rides seat 0 of a method's sig
            .Receiver -> self.seat_type(0),
            .Def(s) -> self.state_held(s) ?? self.narrowed_def(e, s) ?? self.def_type(s),
            // The arm's OWNER spoke this type before the arm was
            // walked; an absent one means the bind was refused.
            .Pattern(v, j) -> self.facts.pattern_type(v, j) ?? self.error_type,
            .LambdaParam(l, i) -> self.lambda_param_ty(l, i),
            // captures never narrow — the box holds the wide value
            .Capture(l, j) -> self.capture_ty(l, j),
            .Index(_) -> self.type(int),
            .Decl(d) -> self.decl_type_read(e, d),
        }
    }

    /// A SEAT'S TYPE COMES FROM THE SCOPE, AND A BODY WHOSE
    /// DECLARATION RECORDED NO SIGNATURE HAS NO SCOPE. Its seats are
    /// Error, silently: the refusal that kept the signature out was
    /// already spoken (a generic method is one), so every read of a
    /// seat it never declared answers nothing. THE ONE reader for
    /// every seat — a receiver and a parameter are the same
    /// question, and four spellings of it disagreed (the receiver's
    /// three were total, the parameter's four were not) until a
    /// refused method's body read past an empty scope.
    fn seat_type(i: int) -> TypeId {
        if i >= self.scope.length { return self.error_type }
        self.scope[i]
    }

    mut fn push_frame(which: Narrowing, frame: NarrowFrame) {
        match which {
            .Defs -> self.narrow_defs.push(frame),
            .Params -> self.narrow_params.push(frame),
        }
    }

    mut fn pop_frame(which: Narrowing) {
        match which {
            .Defs -> { let _ = self.narrow_defs.pop() },
            .Params -> { let _ = self.narrow_params.pop() },
        }
    }

    /// The narrowed INNER for a def-bound read, when a frame proves
    /// it — recorded so lowering unwraps this very read.
    mut fn narrowed_def(e: ExprId, s: StmtId) -> TypeId? {
        self.narrow_hit(e, self.narrow_defs, s.index)
    }

    mut fn narrowed_param(e: ExprId, i: int) -> TypeId? {
        self.narrow_hit(e, self.narrow_params, i)
    }

    /// One stack's answer: the frame whose key matches, its read
    /// recorded as wearing the frame's OPT.
    mut fn narrow_hit(e: ExprId, frames: List<NarrowFrame>, key: int) -> TypeId? {
        let hit? = frames.find(it.key == key) else { return null }
        self.facts.narrow(e, hit.opt)
        hit.inner
    }

    /// A paired head's subject — where `enumerate` may stand.
    mut fn pair(e: ExprId) {
        self.pairs.push(e)
    }

    /// Whether a subject stands as a paired head.
    fn paired(e: ExprId) -> bool {
        self.pairs.any(same_expr(it, e))
    }

    /// THE EXPECTED-TYPE CHANNEL's write side: a boundary that
    /// knows its slot plants the want BEFORE the value walks — and
    /// the want flows through every HEIR (branch arms, block
    /// values), so a lambda three arms deep still hears it.
    mut fn plant_want(e: ExprId, ty: TypeId) {
        self.facts.set_want(e, ty)
        let node = self.view.store.expr(e)
        for h in semantics_of(self.dispatch, node).heirs(node) {
            self.plant_want(h, ty)
        }
    }

    /// A foreign name read as a value: a type's name, or a fn worn
    /// as a value — the answers a local declaration gives. No read
    /// site is in hand here (a capture's source binding), so a
    /// refusal this reaches falls back to the declaration's own loc.
    mut fn decl_type(d: DeclId) -> TypeId {
        mut voices = self.facts.voices
        let out = self.view.decls.decl_type_of(voices, self.error_type, null, d)
        self.facts.voices = voices
        out
    }

    /// The same answer, AT THE EXPRESSION READING IT — any refusal
    /// points at the read, which is where the mistake is.
    mut fn decl_type_read(e: ExprId, d: DeclId) -> TypeId {
        mut voices = self.facts.voices
        let out = self.view.decls.decl_type_of(voices, self.error_type, self.loc_of(e), d)
        self.facts.voices = voices
        out
    }

    /// A declaring statement's identity in the shared table.
    fn decl_of(s: StmtId) -> DeclId {
        self.view.decls.decl_of(self.view.file, s)!
    }

    /// Inside a lambda body — behind its barrier, no enclosing fn
    /// answers.
    fn behind_lambda() -> bool {
        let bar: int? = self.lam_bar.last()
        bar != null && self.fn_ret.length <= bar!
    }

    /// The enclosing fn's answer — unless a LAMBDA BARRIER stands
    /// between: a lambda body answers itself, so `return`, `?`, and
    /// `fail` inside one see no enclosing fn at all.
    fn enclosing_ret() -> TypeId? {
        if self.behind_lambda() { return null }
        self.fn_ret.last()
    }

    /// Whether a lambda's seat HEARD a `mut` mark from its slot — the
    /// half of `is_mut` only typing can answer.
    fn heard_mut(l: ExprId, i: int) -> bool {
        mut_mark(self.facts.heard_marks(l) ?? [], i)
    }

    /// A lambda param's declared type, by seat.
    fn lambda_param_ty(l: ExprId, i: int) -> TypeId {
        let ps? = self.facts.lambda_seats(l) else { return self.error_type }
        ps[i]
    }

    /// A capture's type — its SOURCE binding's, chained through
    /// nested lambdas.
    fn capture_ty(l: ExprId, j: int) -> TypeId {
        let cap? = self.names.capture(l) else { return self.error_type }
        self.binding_ty(cap.sources[j])
    }

    /// The un-narrowed type a binding wears — the capture law's
    /// projection.
    fn binding_ty(b: Binding) -> TypeId {
        match b {
            .Param(i) -> self.seat_type(i),
            .Receiver -> self.seat_type(0),
            .Def(s) -> self.state_held(s) ?? self.def_type(s),
            .Pattern(v, j) -> self.facts.pattern_type(v, j) ?? self.error_type,
            .LambdaParam(l, i) -> self.lambda_param_ty(l, i),
            .Capture(l, j) -> self.capture_ty(l, j),
            .Index(_) -> self.type(int),
            .Decl(d) -> self.decl_type(d),
        }
    }

    /// An annotated binding's DECLARED type: interned once, recorded
    /// so every later read of the name answers it, and returned for
    /// the value's acceptance check.
    /// A `state` binding's READ answers what its cell HOLDS, never the
    /// cell: the binding is the place, the name is the value.
    fn state_held(s: StmtId) -> TypeId? {
        if !self.view.store.is_state_stmt(s) { return null }
        self.view.types.cell_inner(self.def_type(s))
    }

    mut fn bind_declared(s: StmtId, ann: TypeRef) -> TypeId {
        let ty = self.annotated(s, ann)
        // A `state` binding's PLACE is a Cell; its VALUE is the T it
        // holds. The binding records the Cell so reads and writes go
        // through it, and answers T so the seed is checked as T.
        if self.view.store.is_state_stmt(s) {
            self.record_binding(s, self.view.types.intern(Type.Cell(ty)))
            return ty
        }
        self.record_binding(s, ty)
        ty
    }

    /// The type an annotation WRITES at an expression, resolved in
    /// the scope in force.
    mut fn written(e: ExprId, tr: TypeRef) -> TypeId {
        self.written_by(self.view.spanned_of(e), self.view.loc_of(e), tr)
    }

    /// A declared generic's arity by NAME, for the applied-type path —
    /// null when the name is not a generic declaration.
    fn declared_arity(name: string) -> int? {
        let decl? = self.type_decl_named(name) else { return null }
        let arity = self.view.decls.tparams(decl).length
        if arity == 0 { return null }
        arity
    }
}

/// A file's statements that RUN — everything that declares nothing.
fn runtime_stmts(view: FileView) -> List<StmtId> {
    [s for s in view.stmts if !view.store.is_declaration(s)]
}

/// Which narrowing stack a frame lives on — the defs' or the
/// params'; a selector, so the bracket writes the context's own
/// field and never a copy of it.
enum Narrowing {
    Defs
    Params
}

/// Every name the LANGUAGE owns — a scalar shape or a constructor
/// row. A declaration may take none of them.
export fn builtin_type_name(rows: List<TypeRow>, name: string) -> bool {
    shape_named(name) != null || type_row(rows, name) != null
}

/// The type an annotation names, or null.
fn shape_named(name: string) -> Type? {
    // The scalar half is the ONE spelling (`features.scalar_named`);
    // the language adds the non-settlement shapes beside it.
    match name {
        "void" -> Type.Void,
        "ptr" -> Type.Ptr,
        "Bytes" -> Type.Bytes,
        _ -> scalar_named(name),
    }
}

/// Whether an interned id is the Var wearing this name.
fn var_named(types: TypeRegistry, id: TypeId, name: string) -> bool {
    match types.shape_of(id) { .Var(_, _, n) -> n == name, _ -> false }
}

/// The slot-law help, worded once — every slot that must wait says
/// exactly this.

/// Two method sigs agree seat by seat past the receiver — the
/// trait's wears `Self` there, the signatory's its own type.
/// Two signatures agreeing seat by seat from `from` — `1` past a
/// receiver, `0` for a member that takes none — and in their answer.
fn sigs_agree(want: FnSig, got: FnSig, from: int = 1) -> bool {
    got.params.length == want.params.length &&
        same_type(want.ret, got.ret) &&
        [j for j, w in want.params if j >= from && !same_type(got.params[j], w)].is_empty()
}

/// A package's name in prose.
fn package_word(p: string) -> string {
    if p.is_empty() { return "the root package" }
    "package `${p}`"
}
