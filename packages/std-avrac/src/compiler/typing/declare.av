//! The declaration rounds of typing: every record's and enum's
//! table from its declaration alone, every fn's signature from its
//! annotations, and the laws of the types annotations WRITE — a
//! name, a built-in constructor, a generic application, `dyn`.
//! Bodies never walk here; a sig may name any file's declaration.
use core.{
    Variant,
    binds_type,
    counted,
    flatten,
    StmtId,
    TypeId,
    Type,
    Param,
    TypeRef,
    spelled,
    plain,
    DeclId,
    FnParts,
    StructParts,
    Spread,
    EnumParts,
    widthless,
    width_named,
    width_words,
    qtrace,
    FileId,
    Scoped,
}
use diagnostics.{refusal, Diag}
use features.{
    TypeCx,
    FnSig,
    StructSig,
    Lacked,
    EnumSig,
    NamedSig,
    DeclSig,
    duplicate_names,
    slot_worthy,
    TypeRow,
    Refusal,
    type_row,
    TypeArgs,
    type_named,
    nothing,
    Decl,
    written_seats,
    declared_decl,
    Namespace,
    NameKind,
    AnnotationFact,
}
use compiler.{result_infers}
use compiler.lower.{ordered_collect_members}
use query.{traced}
use @std.errors.{Loc}

impl TypeCx {
    /// A record's table, from its declaration alone.
    fn declare_record(s: StmtId) {
        self.refuse_taken_tparams(s, self.view.store.type_decl_name(s) ?? "this type")
        self.enter_tscope(s)
        let sp: StructParts? = self.view.store.struct_parts(s)
        if sp != null { self.declare_struct_sig(s, sp!.fields, sp!.spreads) }
        self.leave_tscope()
    }

    /// A NAMED TYPE's table: the ONE shape it stands over, judged by
    /// the SLOT LAW — the name travels as a flat record of one
    /// anonymous field, so the shape is a field and obeys a field's
    /// law. The name is marked in the registry, which is what makes
    /// every READ see through it while every SEAT still compares ids.
    fn declare_named(s: StmtId) {
        let parts? = self.view.store.named_parts(s) else { return }
        if !parts.tparams.is_empty() { return self.named_is_generic(s, parts.name) }
        let of = self
            .slot_law(
                s,
                "type.named",
                "a named type cannot stand over nothing",
                "`${parts.name}` stands over `${spelled(parts.of)}`",
                parts.of,
            )
        // interned DIRECTLY, never through `declared_type`: that door
        // forces a named declaration, and this IS that declaration
        let named = self.view.types.intern(Type.Struct(self.decl_of(s), parts.name))
        self.declare(s, DeclSig.Named(NamedSig { of: of }))
        if self.view.types.shape_of(of) is .Error { return }
        if self.view.types.names_itself(named, of) { return self.named_is_circular(s, parts.name) }
        self.view.types.mark_named(named, of)
        self.view.types.mark_flat(named, [of])
    }

    /// An ALIAS's table: the type its name stands for, read under
    /// its own type parameters so an application lands them.
    fn declare_alias(s: StmtId) {
        let parts? = self.view.store.alias_parts(s) else { return }
        self.refuse_taken_tparams(s, parts.name)
        self.enter_tscope(s)
        let of = self.full_type(self.stmt_loc(s), parts.of)
        self.leave_tscope()
        self.declare(s, DeclSig.Alias(of))
    }

    /// An enum's table, from its declaration alone.
    fn declare_enum(s: StmtId) {
        self.refuse_taken_tparams(s, self.view.store.type_decl_name(s) ?? "this type")
        self.enter_tscope(s)
        let ep: EnumParts? = self.view.store.enum_parts(s)
        if ep != null { self.declare_enum_sig(s, ep!.variants) }
        self.leave_tscope()
    }

    /// An enum's variant table — the index IS the runtime tag, and
    /// the payloads ride slots 1.. of the value, in order.
    fn declare_enum_sig(s: StmtId, variants: List<Variant>) {
        let record = self.decl_of(s)
        let ty = self.view.types.intern(Type.Enum(record, self.view.decls.decl(record).name))
        self.view.types.begin_declare(ty)
        defer { self.view.types.end_declare(ty) }
        if !self.view.decls.lacking(record).is_empty() { self.enum_lacks(s) }
        let sig = EnumSig {
            names: [v.name.of for v in variants],
            payloads: [self.payload_types(s, v) for v in variants],
        }
        self.declare(s, DeclSig.Enum(sig))
    }

    /// A collect enum's table: every gathered member, in `by` order,
    /// one payload-free variant each, named by the member's own
    /// declaration name — `declare_enum_sig`'s twin, computed rather
    /// than written. Duplicate names are left in the table as found;
    /// `check_collect_enum` (features/collects/check.av) is where
    /// that refuses, the same split `declare_enum_sig`/`check_enum_decl`
    /// already keep.
    fn declare_collect_enum(s: StmtId) {
        let p? = self.view.store.collect_enum_parts(s) else { return }
        let members = ordered_collect_members(
            self.view.decls,
            p.kind,
            p.scope,
            p.order,
            self.view.file,
        )
        let no_payload: List<TypeId> = []
        let sig = EnumSig {
            names: [m.name for m in members],
            payloads: [no_payload for m in members],
        }
        self.declare(s, DeclSig.Enum(sig))
    }

    /// What a variant carries, in order — each payload judged by the
    /// slot law; a payload the law refuses lands as the Error type.
    fn payload_types(s: StmtId, v: Variant) -> List<TypeId> {
        [self.carried_type(s, v.name.of, p) ?? self.error_type for p in v.payloads]
    }

    /// One payload's type under the slot law — absent when it was
    /// written without one. An unnamed payload is named by its variant.
    fn carried_type(s: StmtId, variant: string, p: Param) -> TypeId? {
        if p.ty == null { return null }
        let who = if p.name.is_empty() { "`.${variant}`" } else { "`${p.name}`" }
        self
            .held_slot(
                s,
                "type.enum_payload",
                "an enum payload cannot hold nothing",
                "${who} carries `${spelled(p.ty!)}`",
                p.ty!,
            )
    }

    /// One declaration's table lands in the ONE dense record.
    fn declare(s: StmtId, d: DeclSig) {
        self.view.decls.declare(self.decl_of(s), d)
    }

    fn declare_struct_sig(s: StmtId, fields: List<Param>, spreads: List<Spread>) {
        let owner: string = self.view.store.type_decl_name(s) ?? "this type"
        let record = self.decl_of(s)
        // THE DECLARATION IS IN FLIGHT while its own fields type: a fact read here
        // answers this declaration's provisional state (see `TypeRegistry.note`).
        let ty = self.view.decls.record_type(record)
        self.view.types.begin_declare(ty)
        defer { self.view.types.end_declare(ty) }
        let lacking = self.view.decls.lacking(record)
        let own = StructSig {
            names: [f.name.of for f in fields],
            types: [self.field_type(s, f) for f in fields],
            defaults: [self.view.decls.default_named(record, f.name.of) for f in fields],
            lacking: lacking,
        }
        let sig = if spreads.is_empty() { own } else { self.spread_into(s, owner, own, spreads) }
        for d in duplicate_names("type.duplicate_field", owner, sig.names, self.stmt_loc(s)) {
            self.emit(d)
        }
        let names = [Scoped(n) for n in sig.names]
        if self.marks_identity(record) { self.identity_law(s, record, names, sig.types) }
        self.lacks_law(s, owner, names, lacking)
        self.declare(s, DeclSig.Record(sig))
    }

    /// A record's own fields with each `..R`'s placed where it was
    /// written: R's names, its types under the written arguments, and
    /// R's OWN defaults, typed in R's scope.
    fn spread_into(s: StmtId, owner: string, own: StructSig, spreads: List<Spread>) -> StructSig {
        let tables = [self.spread_table(s, owner, x) for x in spreads]
        let placed = (k: int) -> [t for j, t in tables if spreads[j].at == k]
        let fields = joined_tables(
            flatten([placed(k).concat([one_field(own, k)]) for k in 0..own.names.length])
                .concat(placed(own.names.length)),
        )
        fields with { lacking: own.lacking }
    }

    /// The fields one `..R` places; none when it is refused.
    fn spread_table(s: StmtId, owner: string, x: Spread) -> StructSig {
        let ty = self.full_type(self.stmt_loc(s), x.of)
        if self.view.types.shape_of(ty) is .Error { return no_fields() }
        if self.names_record(ty, self.decl_of(s)) {
            self.spread_own(s, owner)
            return no_fields()
        }
        if self.record_unsigned(ty) {
            self.spread_cycle(s, x.of)
            return no_fields()
        }
        self.view.decls.fields_of_type(ty) ?? self.spread_refused(s, x.of)
    }

    /// A spread of what is not a record: refused, and it places nothing.
    fn spread_refused(s: StmtId, of: TypeRef) -> StructSig {
        self.spread_no_record(s, of)
        no_fields()
    }

    /// Whether `ty` names a declaration whose signature cannot be
    /// asked from here — it is being signed, so the spread came back.
    fn record_unsigned(ty: TypeId) -> bool {
        match self.view.types.shape_of(ty) {
            .Struct(decl, _) or .App(decl, _, _) -> self.view.decls.sig(decl) == null,
            _ -> false,
        }
    }

    /// Whether `ty` is the record `d` itself, applied or not.
    fn names_record(ty: TypeId, d: DeclId) -> bool {
        match self.view.types.shape_of(ty) {
            // LICENSED structs.index_compared: DECLARATION identity — the spread names the record being declared
            .Struct(decl, _) or .App(decl, _, _) -> decl.index == d.index,
            _ -> false,
        }
    }

    /// AN IDENTITY'S TABLES ARE SHARED BY EVERY COPY: a field a
    /// writing path could open unique — anything but a `Cell`, or
    /// another `@identity` type — would fork them the moment one
    /// copy's write stops reaching the other. A field licensed PLAIN
    /// is read off `record`'s OWN `@plain_field` annotations, so the
    /// license travels with the declaration through any rename.
    fn identity_law(s: StmtId, record: DeclId, names: List<Scoped>, types: List<TypeId>) {
        let plain = self.identity_plain_fields(record)
        for j, ty in types {
            let field = names[j].of
            if !self.identity_field_ok(ty) && !plain.contains(field) {
                self.non_identity_field(s, field, ty)
            }
        }
    }

    /// A `Cell<…>`, or a declared type itself carrying `@identity` —
    /// the two shapes a write through a path can never fork.
    fn identity_field_ok(ty: TypeId) -> bool {
        match self.view.types.shape_of(ty) {
            .Cell(_) -> true,
            .Struct(d, _) or .App(d, _, _) -> self.marks_identity(d),
            rest -> false,
        }
    }

    /// `d`'s own annotations resolving to `@std/meta`'s `word` — by
    /// declaration, never a bare compare of the word: a package's own
    /// fn of the same name answers none.
    fn meta_annotations(d: DeclId, word: string) -> List<AnnotationFact> {
        let decls = self.view.decls
        let file = decls.annotation_home(d)
        [a for a in decls.annotations_of(d) if decls.is_meta_annotation(a, file, word)]
    }

    /// Whether a declaration carries `@std/meta`'s `@identity`.
    fn marks_identity(d: DeclId) -> bool { !self.meta_annotations(d, "identity").is_empty() }

    /// The field names `@std/meta`'s `@plain_field` licenses on `d` —
    /// one annotation per field, beside `@identity`, each its own
    /// arity-checked call (never a member MARK: "EVERY MARK OWES A
    /// READER" governs those, and `@plain_field` is a call like
    /// `@identity` itself, not a field mark that needs a `@derive`
    /// trait to claim it).
    fn identity_plain_fields(d: DeclId) -> List<string> {
        [a.args[0].text for a in self.meta_annotations(d, "plain_field") if a.args.length == 1]
    }

    /// A record lacks each field ONCE, and only a field it does not
    /// declare — a second reason, or a declared field, contradicts it.
    fn lacks_law(s: StmtId, owner: string, names: List<Scoped>, lacking: List<Lacked>) {
        for j, l in lacking {
            if names.any(it.of == l.field) { self.lacks_declared(s, owner, l.field) }
            if lacking.slice(0, j).any(it.field == l.field) { self.lacks_twice(s, owner, l.field) }
        }
    }

    fn enum_lacks(s: StmtId) {
        self
            .emit(
                refusal(
                    "type.lacks",
                    self.stmt_loc(s),
                    "an enum has no fields to lack",
                    "`@lacks` on an enum",
                    "`@lacks` marks a record",
                ),
            )
    }

    fn lacks_twice(s: StmtId, owner: string, field: string) {
        self
            .emit(
                refusal(
                    "type.lacks",
                    self.stmt_loc(s),
                    "`${owner}` lacks `${field}` twice",
                    "a second `@lacks(\"${field}\", …)` here",
                    "keep one reason",
                ),
            )
    }

    fn lacks_declared(s: StmtId, owner: string, field: string) {
        self
            .emit(
                refusal(
                    "type.lacks",
                    self.stmt_loc(s),
                    "`${owner}` cannot lack `${field}` — it declares it",
                    "`@lacks(\"${field}\", …)` here",
                    "drop the field, or the `@lacks`",
                ),
            )
    }

    fn non_identity_field(s: StmtId, field: string, found: TypeId) {
        self
            .emit(
                refusal(
                    "type.identity_field",
                    self.stmt_loc(s),
                    identity_field_law,
                    "field `${field}` is `${self.view.types.name_of(found)}`",
                    "wrap it in `Cell<…>`, mark its own type `@identity`, or license it — `@plain_field(\"${field}\")` beside `@identity`",
                ),
            )
    }

    /// A default's signature: a body of no parameters answering its
    /// field's or seat's declared type — every literal or call that
    /// leaves it unwritten calls it.
    fn declare_default(x: Decl) {
        let ret: TypeId = self.defaulted_type(x.parent!, x.name) ?? self.error_type
        self.view.decls.declare(x.id, DeclSig.Fn(FnSig { params: [], ret: ret }))
    }

    /// The type a default answers: its field's, or its seat's — a
    /// method's receiver leads its seats and is never written.
    fn defaulted_type(owner: DeclId, name: string) -> TypeId? {
        let sig? = self.view.decls.sig(owner) else { return null }
        let rs: StructSig? = sig.record_sig()
        if rs != null {
            let slot? = rs!.slot_of(name) else { return null }
            return rs!.types[slot]
        }
        let fs? = sig.fn_sig() else { return null }
        let seats: List<string> = self.view.decls.facts_of(owner)?.seats ?? []
        let j = seats.index_of(name)
        let at = fs.params.length - seats.length + j
        if j < 0 || at < 0 { return null }
        fs.params[at]
    }

    /// A test case's signature: no parameters, a bool answer.
    fn declare_case(x: Decl) {
        self
            .view
            .decls
            .declare(x.id, DeclSig.Fn(FnSig { params: [], ret: self.view.decls.types.type(bool) }))
    }

    /// A field's type. The grammar always writes one, so absence is
    /// unreachable.
    fn field_type(s: StmtId, f: Param) -> TypeId {
        if f.ty == null { return self.error_type }
        self
            .held_slot(
                s,
                "type.struct_scalar",
                "a struct field cannot hold nothing",
                "field `${f.name}` is `${spelled(f.ty!)}`",
                f.ty!,
            )
    }

    /// THE declared-slot law: a slot inside an aggregate holds a value
    /// — one word and its cell's mark (a nullable scalar's absence);
    /// `void` is no value. A record's field and an enum's payload are
    /// one law. An UNKNOWN name is not this law's business:
    /// the NAME law speaks first, and a second refusal for one
    /// mistake is a cascade.
    fn slot_law(s: StmtId, kind: string, message: string, label: string, ty: TypeRef) -> TypeId {
        let named = self.full_type(self.stmt_loc(s), ty)
        let sh: Type = self.view.types.shape_of(named)
        if sh is .Error { return named }
        if slot_worthy(sh) { return named }
        self.emit(refusal(kind, self.stmt_loc(s), message, label, null))
        self.error_type
    }

    /// A slot inside a record or a payload — which outlives the block,
    /// so a task never rides in one.
    fn held_slot(s: StmtId, kind: string, message: string, label: string, ty: TypeRef) -> TypeId {
        let held = self.slot_law(s, kind, message, label, ty)
        if self.escapes_with_task(self.stmt_loc(s), label, held) { return self.error_type }
        held
    }

    /// A fn's signature, from its annotations alone. A `mut fn` at
    /// the top level declared a receiver it does not have — spoken
    /// once, and the fn still declares, so its calls resolve.
    fn declare_fn(s: StmtId) {
        let parts: FnParts? = self.view.store.fn_parts(s)
        if parts != null {
            let fp = parts!
            if self.view.store.is_mutating(s) { self.stray_mut_fn(s, fp.name) }
            if self.view.store.is_static(s) { self.stray_static_fn(s, fp.name) }
            if self.view.store.is_once(s) { self.once_laws(s, fp) }
            return self.declare_sig(s, fp.params, fp.ret)
        }
        let host? = self.view.store.extern_parts(s) else { return }
        // An extern's seats may name a machine WIDTH; the value that
        // crosses is Avra's one integer, so the width is read off
        // the annotation and the sig declares `int`.
        let c = host
        self.declare_sig(s, widthless_seats(c.params), widthless(c.ret) ?? c.ret)
    }

    fn declare_sig(s: StmtId, fparams: List<Param>, fret: TypeRef) {
        // A parameter declared twice makes the second unreachable —
        // the body sees the first, silently. The same law a record's
        // fields and an enum's variants obey, through the same scan.
        let owner: string = self.view.store.fn_parts(s)?.name ?? "this fn"
        let seats = written_seats(self.keywords, fparams)
        for d in duplicate_names(
            "type.duplicate_param",
            owner,
            [pp.name.of for pp in seats],
            self.stmt_loc(s),
        ) {
            self.emit(d)
        }
        self.refuse_taken_tparams(s, owner)
        self.enter_tscope(s)
        let d = self.decl_of(s)
        self
            .view
            .decls
            .record_bound_args(d, [self.bound_typed(s, p.ty) for p in self.view.store.decl_tbounds(s)])
        // `seat_types_so_far`, never `seats`: this IS the natural signing —
        // triggering the hook here would ask it of an extern too (declare_fn
        // routes both through this one fn), and the hook derives params by
        // walking the STATEMENT structurally, which does not know an
        // extern's shape the way this fn's own `fparams` argument already
        // does (widthless-adjusted, from declare_fn). Reuse failures.av's
        // early ask if it beat this fn here; otherwise type them now, from
        // the argument this fn was handed, and record for that early asker.
        let ptypes = self.view.decls.seat_types_so_far(d) ?? self.typed_seats(s, fparams, null)
        self.view.decls.record_seat_types(d, ptypes)
        let rt = self.answer_type(s, owner, fret)
        self.leave_tscope()
        let sig = FnSig { params: ptypes, ret: rt }
        self.view.decls.record_seats(d, [pp.promises for pp in seats])
        self.declare(s, DeclSig.Fn(sig))
    }

    /// A fn's declared answer — a task never among what it answers.
    fn answer_type(s: StmtId, owner: string, ret: TypeRef) -> TypeId {
        if result_infers(ret) { return self.inferred_answer(s, ret) }
        let rt = self.annotated(s, ret)
        let _ = self
            .escapes_with_task(self.stmt_loc(s), "`${owner}` answers `${self.view.types.name_of(rt)}`", rt)
        rt
    }

    /// `Result<T, _>` — `T` resolves as any written type does; the
    /// error side is whatever this fn's body's `fail`/`?` sites are
    /// found to raise (compiler/failures.av's whole-program fixpoint,
    /// forced here on first ask). Nothing found, or a site the
    /// structural walk cannot resolve, both refuse — `_` never mints
    /// silently from an incomplete answer.
    mut fn inferred_answer(s: StmtId, ret: TypeRef) -> TypeId {
        let ok = self.written_by(self.view.spanned_of_stmt(s), self.stmt_loc(s), ret.args[0])
        if self.view.types.shape_of(ok) is .Error { return ok }
        let d = self.decl_of(s)
        let members = self.view.decls.inferred_errors(d)
        if self.view.decls.inferred_is_unresolved(d) { return self.inferred_site_unresolved(s) }
        if members.is_empty() { return self.no_inferred_failures(s) }
        let err = self.view.types.union_of(members)
        self.view.types.type(Result<ok, err>)
    }

    fn no_inferred_failures(s: StmtId) -> TypeId {
        self
            .emit(
                refusal(
                    "type.infer_result",
                    self.stmt_loc(s),
                    "nothing here can fail — write the fn's true answer type, not `Result<T, _>`",
                    "declared here",
                    "a `fail` or a `?` site is what `_` infers from; with none, spell the answer this fn actually returns",
                ),
            )
        self.error_type
    }

    fn inferred_site_unresolved(s: StmtId) -> TypeId {
        self
            .emit(
                refusal(
                    "type.infer_result",
                    self.stmt_loc(s),
                    "a `fail` or `?` site here raises something this walk cannot structurally name",
                    "declared here",
                    "spell the union by hand — `Result<T, A or B>`",
                ),
            )
        self.error_type
    }

    /// A `mut` SEAT KEEPS ITS BOX — the receiver's law
    /// (typing_impls) at the other seat. A fn WRITES THROUGH a `mut`
    /// seat, and a flat record is a value in a register with no
    /// identity to write through, so a one-field record would break
    /// where a two-field one works. Sealing is sticky, so it holds
    /// however late the record itself is typed — BUT a held record's
    /// own row must land FIRST (`declared_first`), or its "was flat"
    /// belief never reaches `held_flat` and a stale held object (built
    /// before this seat existed) survives unrefused.
    fn keep_boxed(seats: List<Param>, ptypes: List<TypeId>) {
        for j, pp in seats {
            if pp.promises.mutable {
                self.view.decls.declared_first(ptypes[j])
                self.view.types.unflatten(ptypes[j])
            }
        }
    }

    /// Parameters declare their types; the receiver is never among
    /// them (`self` is a keyword, and the impl gives seat 0 its
    /// type — a bare keyword written as a parameter has no seat).
    /// A bound's trait arguments, typed in the fn's own scope — a bound
    /// that is not a trait's bare name, or that names it at the wrong
    /// count, refused.
    fn bound_typed(s: StmtId, bound: TypeRef?) -> List<TypeId> {
        let b? = bound else { return [] }
        if b.optional || b.dynamic || b.arrow {
            self.bound_not_a_trait(s, spelled(b))
            return []
        }
        let args = [self.annotated(s, a) for a in b.args]
        let tr? = self.bound_trait(self.decl_of(s), b.name) else {
            self.bound_not_a_trait(s, spelled(b))
            return []
        }
        let takes = self.view.decls.tparams(tr).length - 1
        if args.length == takes { return args }
        self.bound_miscounted(s, b.name, takes, args.length)
        []
    }

    fn param_type(s: StmtId, pp: Param) -> TypeId {
        if pp.ty != null { return self.annotated(s, pp.ty) }
        self.typeless_param(s, pp.name.of)
    }

    /// A fn's whole SEAT LIST, typed — the receiver's type first when there is
    /// one, then the written parameters in order. The ONE fold every seat-declaring
    /// site (a free fn, an inherent method, a trait member) shares, called before
    /// `answer_type`: an inferred `Result<T, _>` answer may ask any `_`-declared
    /// fn's own seats mid-fixpoint, and they must already be typed by then.
    /// Every `mut` seat's record seals boxed IN the fold, so a method's seat
    /// seals exactly as a free fn's does.
    fn typed_seats(s: StmtId, params: List<Param>, receiver: TypeId?) -> List<TypeId> {
        let seats = written_seats(self.keywords, params)
        let ptypes = [self.param_type(s, pp) for pp in seats]
        self.keep_boxed(seats, ptypes)
        let r? = receiver else { return ptypes }
        [r].concat(ptypes)
    }

    fn typeless_param(s: StmtId, name: string) -> TypeId {
        self
            .emit(
                refusal(
                    "type.mismatch",
                    self.stmt_loc(s),
                    "parameter `${name}` declares no type",
                    "declared here",
                    "write `${name}: <type>`",
                ),
            )
        self.error_type
    }

    /// A `once` FN'S CONTRACT: no arguments — its answer is one
    /// value for the whole process — and an answer the runtime can
    /// KEEP, which a copied scalar is not.
    fn once_laws(s: StmtId, fp: FnParts) {
        if !fp.params.is_empty() { return self.once_takes_arguments(s, fp.name) }
        let answer = self.annotated(s, fp.ret)
        // WHETHER A VALUE RIDES A POINTER IS ITS DECLARATION'S
        // ANSWER: a record of one scalar field is flattened when its
        // own signature is asked, so ask before judging — a law that
        // reads the registry mid-flight answers by declaration order.
        let named: DeclId? = declared_decl(self.view.types.shape_of(answer))
        if named != null { let _ = self.view.decls.sig(named!) }
        if !self.view.types.rides_pointer(answer) &&
            !self.view.types.travels_wide(answer) &&
            !(self.view.types.shape_of(answer) is .Enum) {
            self.once_answers_a_copy(s, fp.name, answer)
        }
    }

    fn once_takes_arguments(s: StmtId, name: string) {
        self
            .emit(
                refusal(
                    "type.once_fn",
                    self.stmt_loc(s),
                    "`once fn ${name}` takes arguments — a `once` answer is one value for the whole process",
                    "declared here",
                    "drop the parameters, or drop `once`",
                ),
            )
    }

    fn once_answers_a_copy(s: StmtId, name: string, answer: TypeId) {
        self
            .emit(
                refusal(
                    "type.once_fn",
                    self.stmt_loc(s),
                    "`once fn ${name}` answers `${self.view.types.name_of(answer)}`, which the runtime cannot keep",
                    "declared here",
                    "a `once` value is one the runtime owns — a string, a list, a map, an enum, or a record wider than one scalar field",
                ),
            )
    }

    fn once_is_a_method(s: StmtId, name: string) {
        self
            .emit(
                refusal(
                    "type.once_fn",
                    self.stmt_loc(s),
                    "`once fn ${name}` is a method — its answer would depend on a receiver",
                    "declared here",
                    "move it to the top level, or drop `once`",
                ),
            )
    }

    fn spread_own(s: StmtId, owner: string) {
        self
            .emit(
                refusal(
                    "type.spread",
                    self.stmt_loc(s),
                    "`${owner}` spreads itself",
                    "declared here",
                    "a spread places ANOTHER record's fields — a record cannot hold its own",
                ),
            )
    }

    fn spread_cycle(s: StmtId, of: TypeRef) {
        self
            .emit(
                refusal(
                    "type.spread",
                    self.stmt_loc(s),
                    "`..${spelled(of)}` spreads a record that spreads this one",
                    "spread here",
                    "spreads cannot form a cycle — the fields would have no first owner",
                ),
            )
    }

    fn spread_no_record(s: StmtId, of: TypeRef) {
        self
            .emit(
                refusal(
                    "type.spread",
                    self.stmt_loc(s),
                    "`..${spelled(of)}` spreads no record",
                    "spread here",
                    "a spread places a record's fields — `${spelled(of)}` is not a record with fields",
                ),
            )
    }

    fn named_is_generic(s: StmtId, name: string) {
        self
            .emit(
                refusal(
                    "type.named",
                    self.stmt_loc(s),
                    "`${name}` is a named type with type parameters, which is recorded, not landed",
                    "declared here",
                    "a named type stands over ONE written shape — write the shape out, or declare a record",
                ),
            )
    }

    fn named_is_circular(s: StmtId, name: string) {
        self
            .emit(
                refusal(
                    "type.named",
                    self.stmt_loc(s),
                    "`${name}` stands over itself",
                    "declared here",
                    "a named type stands over a shape it does not name — following the names from here comes back to `${name}`",
                ),
            )
    }

    fn stray_mut_fn(s: StmtId, name: string) {
        self
            .emit(
                refusal(
                    "type.mut_fn",
                    self.stmt_loc(s),
                    "`mut fn` marks a method that writes its receiver — `${name}` has none",
                    "declared here",
                    "drop `mut`, or move `${name}` into `impl <Type> { … }`",
                ),
            )
    }

    fn stray_static_fn(s: StmtId, name: string) {
        self
            .emit(
                refusal(
                    "type.static_fn",
                    self.stmt_loc(s),
                    "`static fn` marks a method with no receiver — `${name}` is already a plain fn",
                    "declared here",
                    "drop `static`, or move `${name}` into `impl <Type> { … }` and call it `<Type>.${name}(…)`",
                ),
            )
    }

    /// A type parameter cannot take a name the LANGUAGE owns — the
    /// shadow would be unreadable; declared-type shadowing is the
    /// ordinary lexical kind and stands.
    fn refuse_taken_tparams(s: StmtId, owner: string) {
        let tp = self.view.store.decl_tparams(s)
        for d in duplicate_names("type.tparam", owner, tp, self.stmt_loc(s)) {
            self.emit(d)
        }
        for n in tp {
            if builtin_type_name(self.view.lang.types, n) { self.owned_name(s, n) }
            if self.keywords.contains(n) { self.keyword_tparam(s, n) }
        }
    }

    fn keyword_tparam(s: StmtId, n: string) {
        self
            .emit(
                refusal(
                    "resolve.reserved",
                    self.stmt_loc(s),
                    "`${n}` is a keyword",
                    "cannot be a name",
                    fresh_tparam(),
                ),
            )
    }

    fn owned_name(s: StmtId, n: string) {
        self
            .emit(
                refusal(
                    "type.tparam",
                    self.stmt_loc(s),
                    "a type parameter cannot take `${n}`'s name — the language owns it",
                    "declared here",
                    fresh_tparam(),
                ),
            )
    }

    /// A declaration's type parameters as interned Vars — fns and
    /// type declarations alike; the ordinal IS the identity, so
    /// every ask agrees by construction.
    fn tvars_of(s: StmtId) -> List<TypeId> {
        [self.view.types.intern(Type.Var(self.decl_of(s), j, n)) for j, n in self.view.store.decl_tparams(s)]
    }

    /// The type-parameter scope brackets — one fn at a time, no
    /// nesting (the language has no nested fns).
    fn enter_tscope(s: StmtId) {
        // LICENSED loops.push_loop: pushing through the field alias — concat would rebind the local
        for v in self.tvars_of(s) { self.tscope.push(v) }
    }

    fn leave_tscope() {
        while !self.tscope.is_empty() {
            let _ = self.tscope.pop()
        }
    }

    /// An annotation's TypeId: what its NAME stands for, wrapped
    /// once when `?` was written. An absent annotation cannot reach
    /// here from any grammar the language assembles.
    /// A statement's written type.
    mut fn annotated(s: StmtId, ann: TypeRef?) -> TypeId {
        if ann == null { return self.error_type }
        self.written_by(self.view.spanned_of_stmt(s), self.stmt_loc(s), ann!)
    }

    /// A written type, read in the namespace of the file whose TEXT
    /// wrote it — a template's types are its own even when a hole
    /// named their statement; a hole-filled type is `spliced` and
    /// reads where the code lands.
    mut fn written_by(origin: FileId?, at: Loc?, t: TypeRef) -> TypeId {
        let was = self.writer
        self.writer = if origin == null { null } else { self.written_in(origin!) }
        let ty = self.full_type(at, t)
        self.writer = was
        ty
    }

    /// A written type in full — its arguments and its `?` both. The
    /// element of an application comes back through here, so
    /// `List<int?>` and `List<List<int>>` need no rule of their own.
    /// The `?` wraps ANY well-named type: which layout a nullable
    /// takes is values.av's per-shape choice, not a law's business.
    fn full_type(at: Loc?, t: TypeRef) -> TypeId {
        if !t.optional { return self.written_type(at, t) }
        let inner = self.written_type(at, plain(t))
        if self.view.types.shape_of(inner) is .Error { return inner }
        self.type(inner?)
    }

    /// What a written type stands for, arguments included: a bare
    /// name, or an application like `List<int>`.
    mut fn written_type(at: Loc?, t: TypeRef) -> TypeId {
        if t.spliced && self.writer != null { return self.written_by(null, at, t with { spliced: false }) }
        if !t.alternatives.is_empty() { return self.union_written(at, t.alternatives) }
        if t.arrow { return self.fn_written(at, t) }
        if t.dynamic { return self.dyn_type(at, t.name) }
        if t.args.is_empty() { return self.bare_row(t.name) ?? self.named_type(at, t.name) }
        self.applied(at, t)
    }

    /// `A or B` — every alternative its own written type, unioned. A
    /// member that already refused absorbs, as every seat does.
    fn union_written(at: Loc?, alts: List<TypeRef>) -> TypeId {
        mut parts: List<TypeId> = []
        for a in alts {
            let ty = self.full_type(at, a)
            if self.view.types.shape_of(ty) is .Error { return ty }
            parts.push(ty)
        }
        self.view.types.union_of(parts)
    }

    /// A builtin that takes no type arguments — `Tasks` — is its row's
    /// shape, written bare.
    fn bare_row(name: string) -> TypeId? {
        let row? = type_row(self.view.lang.types, name) else { return null }
        if row.arity != 0 { return null }
        self.view.types.intern(row.builds(TypeArgs { parts: [] }))
    }

    /// `fn(a, b) -> r` — the args carry the seats, the LAST is the
    /// return (the builder's pinned contract).
    fn fn_written(at: Loc?, t: TypeRef) -> TypeId {
        mut seats: List<TypeId> = []
        mut answer = self.error_type
        // LICENSED loops.push_loop: the tail is the answer; comprehensions cannot split it off
        for j, a in t.args {
            let ty = self.full_type(at, a)
            if self.view.types.shape_of(ty) is .Error { return ty }
            if j == t.args.length - 1 { answer = ty } else { seats.push(ty) }
        }
        // the written seats' marks ARE the type's: `fn(mut T, U)`
        // says the callee writes through its first seat
        self.view.types.intern(Type.Fn(seats, t.marks, answer))
    }

    /// `dyn Name` wears a declared trait — the contract is the type.
    fn dyn_type(at: Loc?, name: string) -> TypeId {
        let tdecl? = self.trait_decl_named(name) else { return self.undeclared_contract(at, name) }
        self.view.types.intern(Type.Dyn(tdecl, name))
    }

    fn unappliable(at: Loc?, name: string) -> TypeId {
        self
            .emit(
                refusal(
                    "type.applied",
                    at,
                    "`${name}` takes no type arguments",
                    "applied here",
                    "the applied types today are `List<T>` and `Result<T, E>`",
                ),
            )
        self.error_type
    }

    fn arity_wrong(at: Loc?, name: string, found: int, takes: int) -> TypeId {
        self
            .emit(
                refusal(
                    "type.applied",
                    at,
                    "`${name}` is applied to ${found} types; it takes ${takes}",
                    "applied here",
                    "`${name}` needs exactly ${takes}",
                ),
            )
        self.error_type
    }

    fn undeclared_contract(at: Loc?, name: string) -> TypeId {
        self
            .emit(
                refusal(
                    "type.trait",
                    at,
                    "`dyn ${name}` names no trait",
                    "written here",
                    "declare it — `trait ${name} { … }`",
                ),
            )
        self.error_type
    }

    /// A type APPLIED to arguments. `List<T>` is the only one today —
    /// the registry has no shape for another, and inventing one here
    /// would be a type nothing can lower.
    fn applied(at: Loc?, t: TypeRef) -> TypeId {
        let row: TypeRow? = type_row(self.view.lang.types, t.name)
        let takes: int? = row?.arity ?? self.declared_arity(t.name)
        if takes == null {
            // The NAME law speaks first: a constructor that names no
            // type at all is not an arity mistake, and saying so
            // would imply it IS a type that merely takes none.
            if self.view.types.shape_of(self.named_type(at, t.name)) is .Error { return self.error_type }
            return self.unappliable(at, t.name)
        }
        let arity = takes!
        if t.args.length != arity { return self.arity_wrong(at, t.name, t.args.length, arity) }
        let slots: bool = row?.slots ?? false
        mut parts: List<TypeId> = []
        for a in t.args {
            let ty = self.full_type(at, a)
            if self.view.types.shape_of(ty) is .Error { return ty }
            // A constructor's SLOTS are judged by the slot law like
            // any payload. A Var passes here and every INSTANTIATION
            // re-judges.
            if slots && !slot_worthy(self.view.types.shape_of(ty)) { return self.unslottable_slot(at, t.name, ty) }
            parts.push(ty)
        }
        if row == null { return self.applied_decl(at, t.name, parts) }
        let r = row!
        let args = TypeArgs { parts: parts }
        let refused: List<Refusal> = r.judge(self.view.types, args)
        if !refused.is_empty() { return self.applied_refused(at, refused[0]) }
        let sh: Type = r.builds(args)
        // A RESULT'S LAYOUT IS JUDGED WHERE IT IS FIRST INTERNED, from its
        // sides' layouts — so each side's declaration is asked first
        if sh is .Res { for p in parts { self.asked_layout(p) } }
        self.view.types.intern(sh)
    }

    /// A record's layout made by asking its declaration.
    fn asked_layout(ty: TypeId) {
        match self.view.types.shape_of(ty) {
            .Struct(d, _) -> { let _ = self.view.decls.sig(d) },
            rest -> nothing(),
        }
    }

    fn unslottable_slot(at: Loc?, name: string, ty: TypeId) -> TypeId {
        self
            .emit(
                refusal(
                    "type.applied",
                    at,
                    "a `${name}` slot cannot hold `${self.view.types.name_of(ty)}` — it is no value",
                    "this slot",
                    null,
                ),
            )
        self.error_type
    }

    /// A constructor's own law refused its arguments — in the row's
    /// words.
    fn applied_refused(at: Loc?, r: Refusal) -> TypeId {
        self.emit(refusal("type.applied", at, r.message, "this type", r.help))
        self.error_type
    }
    /// A USER generic instantiated: the declaration by name, its
    /// slots RE-JUDGED under the arguments when the sig is already
    /// declared (source order — a construction judges again anyway).
    fn applied_decl(at: Loc?, name: string, parts: List<TypeId>) -> TypeId {
        let target? = self.type_decl_named(name) else { return self.error_type }
        if self.view.decls.is_alias(target) { return self.aliased(at, target, name, parts) }
        if self.refused_app(at, name, target, parts) { return self.error_type }
        self.view.types.intern(Type.App(target, name, parts))
    }

    /// A declared type by name: in the namespace of the file that wrote
    /// the type being read, then where the code lands — generated code
    /// may name the annotated file's neighbours — then among this
    /// file's generated declarations.
    fn type_decl_named(name: string) -> DeclId? {
        let landed = () -> type_named(self.names, name) ?? self.generated_type(name)
        let writer? = self.writer else { return landed() }
        writer.type_decl(name) ?? landed()
    }

    /// A type one of this file's own generators declared — a name the
    /// written namespace never held.
    fn generated_type(name: string) -> DeclId? {
        let generated = self.elsewhere.generated
        let found: DeclId? = generated(name)
        if found != null && binds_type(self.view.decls.decl(found!).kind) { found } else { null }
    }

    /// The namespace of the file that wrote a node.
    fn written_in(origin: FileId) -> Namespace {
        let written_in = self.elsewhere.written_in
        written_in(origin)
    }

    /// Every declared slot of the instantiation, substituted and
    /// judged — a `Pair<string, int>` refuses like the field law.
    fn refused_app(at: Loc?, name: string, decl: DeclId, parts: List<TypeId>) -> bool {
        for ty in self.declared_slots(decl) {
            let landed = self.view.types.substituted(ty, decl, parts)
            if !slot_worthy(self.view.types.shape_of(landed)) {
                self
                    .emit(
                        refusal(
                            "type.applied",
                            at,
                            "`${name}<...>` makes a slot `${self.view.types.name_of(landed)}`, which is no value",
                            "applied here",
                            null,
                        ),
                    )
                return true
            }
            if self
                .escapes_with_task(at, "`${name}<...>` makes a slot `${self.view.types.name_of(landed)}`", landed) {
                return true
            }
        }
        false
    }

    /// A declaration's slot types, whichever kind declares.
    fn declared_slots(decl: DeclId) -> List<TypeId> {
        let rs: StructSig? = self.view.decls.sig(decl)?.record_sig()
        if rs != null { return rs!.types }
        let vs? = self.view.decls.sig(decl)?.enum_sig() else { return [] }
        flatten(vs.payloads)
    }

    /// What a written NAME stands for: the enclosing fn's type
    /// parameter first, then a builtin shape, a declared type, or a
    /// spoken absence.
    fn named_type(at: Loc?, name: string) -> TypeId {
        let tv: TypeId? = self.tscope.find(var_named(self.view.types, it, name))
        if tv != null { return tv! }
        let sh: Type? = shape_named(name)
        if sh != null { return self.view.types.intern(sh!) }
        let decl: DeclId? = self.type_decl_named(name)
        if decl != null { return self.declared_type(at, decl!, name) }
        if width_named(name) != null { return self.width_off_a_seat(at, name) }
        if traced() { qtrace("Q\tnamed_type_fail\t${name}\t${self.view.decls.file(self.view.file).path}\n") }
        let apart: Diag? = self
            .view
            .decls
            .apart_refusal(self.names.names, [NameKind.Type], name, at)
        if apart != null {
            self.emit(apart!)
            return self.error_type
        }
        self
            .emit(
                refusal(
                    "type.unknown",
                    at,
                    "`${name}` names no type",
                    "in this signature",
                    "the types today are `int`, `string`, `bool`, and your declared types",
                ),
            )
        self.error_type
    }

    /// A WIDTH IS A PROPERTY OF A SEAT, NOT OF A VALUE — so a width
    /// word reaching the general type reader is one written where
    /// no C prototype is being described.
    fn width_off_a_seat(at: Loc?, name: string) -> TypeId {
        self
            .emit(
                refusal(
                    "type.unknown",
                    at,
                    "`${name}` is a machine WIDTH, and widths live on an `extern fn`'s seats — this is not one",
                    "written here",
                    "Avra keeps one integer: write `int`. The widths (${width_words}) name what a C prototype declares, directly on an `extern fn`'s parameter or answer — never inside `List<…>`, and never on a value.",
                ),
            )
        self.error_type
    }

    /// A declared name's type: an enum's value shape or a record's —
    /// and a GENERIC declaration needs its arguments.
    fn declared_type(at: Loc?, d: DeclId, name: string) -> TypeId {
        let arity = self.view.decls.tparams(d).length
        if arity > 0 {
            self
                .emit(
                    refusal(
                        "type.applied",
                        at,
                        "`${name}` is generic — it takes ${counted(arity, "type argument")}",
                        "written bare",
                        "write `${name}<...>`",
                    ),
                )
            return self.error_type
        }
        // AN ENUM'S LAYOUT IS MADE AT ITS DECLARATION — a word, a value
        // enum or a box — so it is asked before the id is handed out
        if self.view.decls.is_enum(d) {
            let _ = self.view.decls.sig(d)
            return self.view.types.intern(Type.Enum(d, name))
        }
        if self.view.decls.is_alias(d) { return self.aliased(at, d, name, []) }
        // A NAMED TYPE'S MARK IS MADE AT ITS DECLARATION, so the
        // declaration is ASKED before the id is handed out. Without
        // it the registry answers by declaration ORDER — right under
        // a driver that signs types first, wrong under one that
        // types a body first, and only the first reader is wrong.
        if self.view.decls.is_named(d) { let _ = self.view.decls.sig(d) }
        self.view.types.intern(Type.Struct(d, name))
    }

    /// What an alias stands for, its type parameters landed. An alias
    /// still being read when it is named again names itself.
    fn aliased(at: Loc?, d: DeclId, name: string, args: List<TypeId>) -> TypeId {
        let of? = self.view.decls.alias_of(d) else { return self.alias_names_itself(at, name) }
        let empty = args.find((t) -> !slot_worthy(self.view.types.shape_of(t)))
        if empty != null { return self.alias_takes_values(at, name, empty!) }
        self.view.types.substituted(of, d, args)
    }

    fn alias_takes_values(at: Loc?, name: string, arg: TypeId) -> TypeId {
        self
            .emit(
                refusal(
                    "type.alias",
                    at,
                    "`${name}<...>` is given `${self.view.types.name_of(arg)}`, which is no value",
                    "applied here",
                    "an alias's type arguments are the types of values",
                ),
            )
        self.error_type
    }

    fn alias_names_itself(at: Loc?, name: string) -> TypeId {
        self
            .emit(
                refusal(
                    "type.alias",
                    at,
                    "`${name}` is an alias that names itself",
                    "named again here",
                    "an alias is a shorthand for a type that already exists — a type that holds itself is a `type`",
                ),
            )
        self.error_type
    }

    /// A declaration's signature — the ONE entry the `sig` query runs.
    /// A method declares under its parent: a trait's sig, or an impl's
    /// method (the impl's verdict decides whether it is real or
    /// wreckage); the impl block itself checks its contract.
    mut fn declare_one(x: Decl) {
        match x.kind {
            .Record -> self.declare_record(x.stmt),
            .Named -> self.declare_named(x.stmt),
            .Alias -> self.declare_alias(x.stmt),
            .Enum -> self.declare_enum(x.stmt),
            .Fn -> self.declare_fn(x.stmt),
            .Method -> self.declare_member(x),
            .Default -> self.declare_default(x),
            .Impl -> self.declare_impl_block(x.stmt),
            .Case -> self.declare_case(x),
            .CollectEnum -> self.declare_collect_enum(x.stmt),
            // Const/Collect have no separate signature phase (typing settles
            // them directly); a builtin was signed at admission, from its row
            .Const or .Collect or .Trait or .Syntax or .Main or .Builtin -> nothing(),
        }
    }
}

const identity_field_law: string = "an identity's tables are shared by every copy — its fields are `Cell`s"

/// The remedy for a type parameter whose name is taken.
fn fresh_tparam() -> string { "pick another name — `T`, `E`, `Elem`" }

/// An extern's seats, each width word read as the `int` it carries.
fn widthless_seats(ps: List<Param>) -> List<Param> {
    [pp with { ty: widthless(pp.ty) } for pp in ps]
}

/// The `j`th field of a table, as a table of one.
fn one_field(sig: StructSig, j: int) -> StructSig {
    StructSig { names: [sig.names[j]], types: [sig.types[j]], defaults: [sig.defaults[j]] }
}

/// Tables laid end to end, in order.
fn joined_tables(ts: List<StructSig>) -> StructSig {
    StructSig {
        names: [n for t in ts for n in t.names],
        types: [x for t in ts for x in t.types],
        defaults: [d for t in ts for d in t.defaults],
    }
}

fn no_fields() -> StructSig { StructSig { names: [], types: [], defaults: [] } }

// ── The bound voices ──

impl TypeCx {
    fn bound_not_a_trait(s: StmtId, written: string) {
        self
            .emit(
                refusal(
                    "type.trait",
                    self.stmt_loc(s),
                    "a bound names a trait, and `${written}` is not one",
                    "this bound",
                    "write the trait's name, and its arguments when it takes them",
                ),
            )
    }

    fn bound_miscounted(s: StmtId, of: string, takes: int, gave: int) {
        self
            .emit(
                refusal(
                    "type.trait",
                    self.stmt_loc(s),
                    "`${of}` takes ${counted(takes, "type argument")}, and this bound gives ${gave}",
                    "this bound",
                    "a bound names its trait at every parameter the trait declares",
                ),
            )
    }
}
