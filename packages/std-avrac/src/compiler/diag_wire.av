//! `DiagFacts` (diagnostics/mod.av), on the wire — a durable witness
//! row (avra-8sb5.57.55) carries a file's diagnostics and rule
//! findings as DATA, never a rendered string, so it prints correctly
//! wherever it is later read (diagnostics/render.av's
//! `render_facts_among`). Every field of `DiagFacts`/`Frame`/`Loc`/
//! `Suggestion`/`Edit`/`Confidence` is already plain data; this is
//! the one place that spells their bytes — one `written_`/`read_` pair
//! per shape, folded by `written_list`/a counted comprehension, never by
//! hand at the call site.
//!
//! A `Loc` crosses as its file and the TOKEN PLACE it stands in (`token_place.av`), over
//! that file's stream lexed under its words: a comment or a space added above it moves no
//! byte the row says, and reading it back needs a lex of the text now and nothing more. A
//! place no token holds crosses as none, and reads back refused — never clamped to where it
//! never pointed. A loc with no file keeps its offsets.
use @std.relation.stable.{Writer, Reader, writer, decoded_with, written_list, CodecFault}
use @std.avrac.diagnostics.{DiagFacts, Severity}
use @std.errors.{Loc, Frame, Suggestion, Edit, Confidence}
use core.{hex, unhex}
use compiler.{Workspace}

fn severity_tag(s: Severity) -> int {
    match s { .Error -> 0, .Warning -> 1, .Note -> 2 }
}

fn severity_of(tag: int) -> Result<Severity, CodecFault> {
    match tag {
        0 -> Severity.Error,
        1 -> Severity.Warning,
        2 -> Severity.Note,
        rest -> { fail CodecFault.NotFlag },
    }
}

fn confidence_tag(c: Confidence) -> int {
    match c { .High -> 0, .Medium -> 1, .Low -> 2 }
}

fn confidence_of(tag: int) -> Result<Confidence, CodecFault> {
    match tag {
        0 -> Confidence.High,
        1 -> Confidence.Medium,
        2 -> Confidence.Low,
        rest -> { fail CodecFault.NotFlag },
    }
}

impl Workspace {
    fn written_loc(w: Writer, l: Loc) {
        let path? = l.file else {
            w.present(false)
            w.int(l.lo)
            w.int(l.hi)
            return
        }
        w.present(true)
        w.text(path)
        let tokens? = self.tokens_now(path) else {
            w.present(false)
            return
        }
        match anchored_among(tokens, l) {
            .In(p) -> {
                w.present(true)
                w.int(p.lo_token)
                w.int(p.lo_at)
                w.int(p.hi_token)
                w.int(p.hi_at)
            },
            .NoToken -> w.present(false),
        }
    }

    fn read_loc(r: Reader) -> Result<Loc, CodecFault> {
        if !r.present()? {
            let lo = r.int()?
            let hi = r.int()?
            return Loc { file: null, lo: lo, hi: hi }
        }
        let path = r.text()?
        if !r.present()? { fail CodecFault.NotVariant }
        let lo_token = r.int()?
        let lo_at = r.int()?
        let hi_token = r.int()?
        let kept = TokenPlace {
            lo_token: lo_token,
            lo_at: lo_at,
            hi_token: hi_token,
            hi_at: r.int()?,
        }
        let tokens? = self.tokens_now(path) else { fail CodecFault.NotVariant }
        let at? = placed_among(tokens, Anchored.In(kept)) else { fail CodecFault.NotVariant }
        at with { file: path }
    }

    fn written_frame(w: Writer, f: Frame) {
        let has_label = f.label != null
        w.present(has_label)
        if has_label { w.text(f.label!) }
        let has_loc = f.loc != null
        w.present(has_loc)
        if has_loc { self.written_loc(w, f.loc!) }
    }

    fn read_frame(r: Reader) -> Result<Frame, CodecFault> {
        let has_label = r.present()?
        let label = if has_label { r.text()? } else { null }
        let has_loc = r.present()?
        let loc = if has_loc { self.read_loc(r)? } else { null }
        Frame { label: label, loc: loc }
    }

    fn written_edit(w: Writer, e: Edit) {
        self.written_loc(w, e.loc)
        w.text(e.replacement)
    }

    fn read_edit(r: Reader) -> Result<Edit, CodecFault> {
        let loc = self.read_loc(r)?
        let replacement = r.text()?
        Edit { loc: loc, replacement: replacement }
    }

    fn written_suggestion(w: Writer, s: Suggestion) {
        w.int(confidence_tag(s.confidence))
        w.text(s.description)
        written_list(w, s.edits, (w: Writer, e: Edit) -> self.written_edit(w, e))
    }

    fn read_suggestion(r: Reader) -> Result<Suggestion, CodecFault> {
        let confidence = confidence_of(r.int()?)?
        let description = r.text()?
        let n = r.count()?
        let edits = [self.read_edit(r)? for _k in 0..n]
        Suggestion { confidence: confidence, description: description, edits: edits }
    }

    /// One `DiagFacts` written — the unit `written_list` folds for a
    /// file's whole diagnostics/rule-findings row.
    fn written_diag_facts(w: Writer, d: DiagFacts) {
        w.text(d.kind)
        w.int(severity_tag(d.severity))
        self.written_frame(w, d.primary)
        written_list(w, d.secondary, (w: Writer, f: Frame) -> self.written_frame(w, f))
        written_list(w, d.cause_lines, (w: Writer, l: string) -> w.text(l))
        w.text(d.message)
        let has_help = d.help != null
        w.present(has_help)
        if has_help { w.text(d.help!) }
        written_list(w, d.suggestions, (w: Writer, s: Suggestion) -> self.written_suggestion(w, s))
    }

    /// `written_diag_facts`'s inverse.
    fn read_diag_facts(r: Reader) -> Result<DiagFacts, CodecFault> {
        let kind = r.text()?
        let severity = severity_of(r.int()?)?
        let primary = self.read_frame(r)?
        let secn = r.count()?
        let secondary = [self.read_frame(r)? for _k in 0..secn]
        let causen = r.count()?
        let cause_lines = [r.text()? for _k in 0..causen]
        let message = r.text()?
        let has_help = r.present()?
        let help = if has_help { r.text()? } else { null }
        let sn = r.count()?
        let suggestions = [self.read_suggestion(r)? for _k in 0..sn]
        DiagFacts {
            kind: kind,
            severity: severity,
            primary: primary,
            secondary: secondary,
            cause_lines: cause_lines,
            message: message,
            help: help,
            suggestions: suggestions,
        }
    }

    /// A `Loc` as bytes — the pair `tools/codecs.py` reads by name.
    fn loc_wire(l: Loc) -> Bytes {
        let w = writer()
        self.written_loc(w, l)
        w.bytes()
    }

    /// `loc_wire`'s inverse; a refused span (one no declaration holds)
    /// answers null.
    fn loc_of_wire(b: Bytes) -> Loc? {
        let back = decoded_with(b, (r: Reader) -> self.read_loc(r))
        match back { .Ok(l) -> l, .Err(e) -> null }
    }

    /// A whole diagnostic row as bytes.
    fn diag_facts_wire(d: DiagFacts) -> Bytes {
        let w = writer()
        self.written_diag_facts(w, d)
        w.bytes()
    }

    /// `diag_facts_wire`'s inverse.
    fn diag_facts_of_wire(b: Bytes) -> DiagFacts? {
        let back = decoded_with(b, (r: Reader) -> self.read_diag_facts(r))
        match back { .Ok(d) -> d, .Err(e) -> null }
    }
}

/// A file's diagnostics and its rule findings, as its facts row keeps them — `rules` none
/// where the run that kept the row did not find them anew.
export type FileFacts = { warnings: List<DiagFacts>, rules: List<DiagFacts>? }

impl Workspace {
    fn file_facts_wire(f: FileFacts) -> string {
        let w = writer()
        written_list(w, f.warnings, (w: Writer, d: DiagFacts) -> self.written_diag_facts(w, d))
        w.present(f.rules != null)
        if f.rules != null { written_list(w, f.rules!, (w: Writer, d: DiagFacts) -> self.written_diag_facts(w, d)) }
        hex(w.bytes())
    }

    fn file_facts_of_wire(raw: string) -> FileFacts? {
        let b? = unhex(raw) else { return null }
        match decoded_with(b, (r: Reader) -> self.read_file_facts(r)) {
            .Ok(f) -> f,
            .Err(_) -> null,
        }
    }

    fn read_file_facts(r: Reader) -> Result<FileFacts, CodecFault> {
        let warnings = self.read_facts_list(r)?
        if !r.present()? { return FileFacts { warnings: warnings, rules: null } }
        FileFacts { warnings: warnings, rules: self.read_facts_list(r)? }
    }

    fn read_facts_list(r: Reader) -> Result<List<DiagFacts>, CodecFault> {
        let n = r.count()?
        [self.read_diag_facts(r)? for _k in 0..n]
    }
}
