//! WHERE A FORM ANSWERS A TYPE ITS PROGRAM DOES NOT LOAD: `produce` and `channel` answer
//! `@std/task`'s types, `quote` `@std/meta`'s, so a package that reaches neither cannot write them.
//! Read off the item's nodes and the packages its package reaches.
use core.{At, ExprId, NodeKind, PatId, StmtId, SyntaxArena, body_behavior, some_list}
use compiler.laws.{Found, Reach, law}
use diagnostics.{Voice}
use features.quote.{metaless}
use features.tasks.{taskless}
use @std.program.address.{SourceFileAddress}
use @std.program.query_engine.{QueryEngine}

/// The package whose types `produce` and `channel` answer.
const TASK: string = "@std/task"

/// A form that answers a type of a package the program may not load.
enum Answering {
    Produce
    Channel
    Quote
}

/// The node `at` of `view`'s item where it is `form` and the package its file stands in reaches no
/// `needs`: a component's body aside, which its composing trait reads, and a quote a pattern writes,
/// which matches code rather than answering it.
fn unloaded(view: ItemView, at: At, form: Answering, needs: string) -> List<Found> {
    let store = view.item.store
    let e? = at.expr() else { return [] }
    if store.home_of(e) != null || !is_form(store, e, form) || composed(store).contains(e.index) { return [] }
    if written_by_mark(store, e, marked(store)) { return [] }
    if package_reach(view.engine, view.file.package_name).packages.contains(needs) { return [] }
    [Found { at: store.expr_span(e), args: [] }]
}

/// Every expression of `store` a component's body or a pattern's quote holds.
fn composed(store: SyntaxArena) -> List<int> {
    [x.index for s in 0..store.stmts.count() for b in some_list(store.component_body(StmtId { index: s })) for x in store.every_expr(b)]
        .concat(
            [x.index for i in 0..store.pats.get().length for b in pattern_quote(store, PatId { index: i }) for x in store.every_expr(b)],
        )
}

/// Where each mark a statement of `store` writes stands.
fn marked(store: SyntaxArena) -> List<int> {
    [m.span!.lo for s in 0..store.stmts.count() for m in store.marks_written(StmtId { index: s }) if m.span != null]
}

/// Whether the node `e` is what a mark writes, standing where the mark does: a mark is data a reader
/// claims, and answers nothing.
fn written_by_mark(store: SyntaxArena, e: ExprId, marked: List<int>) -> bool {
    let at? = store.expr_span(e) else { return false }
    marked.contains(at.lo)
}

/// The quote the pattern `p` of `store` is; none for any other pattern.
fn pattern_quote(store: SyntaxArena, p: PatId) -> List<ExprId> {
    match store.pat(p) { .Quote(body) -> [body], rest -> [] }
}

/// Whether the node `e` of `store` is `form`.
fn is_form(store: SyntaxArena, e: ExprId, form: Answering) -> bool {
    match store.expr(e) {
        .Produce(_, _, _) -> form is .Produce,
        .Channel(_, _) -> form is .Channel,
        .Body(word, _, _, _) -> form is .Quote && body_behavior(word) is .Quote,
        rest -> false,
    }
}

fn produces(view: ItemView, at: At) -> List<Found> { unloaded(view, at, Answering.Produce, TASK) }

fn channels(view: ItemView, at: At) -> List<Found> { unloaded(view, at, Answering.Channel, TASK) }

fn quotes(view: ItemView, at: At) -> List<Found> { unloaded(view, at, Answering.Quote, META) }

/// `produce` needs `@std/task`
export law produce_needs_task {
    kind: "flow.produce"
    on: [NodeKind.ExprProduce]
    judge: produces
    reach: Reach.Stored
    judged_if: read_cleanly
    voice: produce_words
    witness: "let s = produce<int>(1) { yield 1 }\n"
}

/// `channel` needs `@std/task`
export law channel_needs_task {
    kind: "flow.channel"
    on: [NodeKind.ExprChannel]
    judge: channels
    reach: Reach.Stored
    judged_if: read_cleanly
    voice: channel_words
    witness: "channel<int>(2)\n"
}

/// `quote` needs `@std/meta`
export law quote_needs_meta {
    kind: "type.quote_meta"
    on: [NodeKind.ExprBody]
    judge: quotes
    reach: Reach.Stored
    judged_if: read_cleanly
    voice: quote_words
    witness: "let q = quote { 1 }\n"
}

fn produce_words(_a: List<string>) -> Voice { taskless("produce", "Source") }

fn channel_words(_a: List<string>) -> Voice { taskless("channel", "Channel") }

fn quote_words(_a: List<string>) -> Voice { metaless("Code") }
