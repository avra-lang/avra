//! The vocabulary a build links with: clang's words for a link, and the binary
//! a source names.
use compiler.backend.{
    unreached_dropped,
    host_export_words,
    table_export_words,
    reactor_entry_words,
    host_kept_words,
    link_named,
}

/// The words a wasm link for `target` starts with: the driver's own target, which names crt1 and a
/// libc; its debug sections stripped unless `debug`; a reactor's entry where `reactor`; the host
/// fns and the function table exported.
export fn wasm_link_head(target: string, reactor: bool, debug: bool) -> List<string> {
    ["-w", "--target=${target}", "-Wno-deprecated"]
        .concat(if debug { [] } else { ["-Wl,--strip-all"] })
        .concat(if reactor { ["-mexec-model=reactor"].concat(reactor_entry_words()) } else { [] })
        .concat(host_export_words())
        .concat(table_export_words())
}

/// The words a wasm link ends with: the wasm runtime archive `runtime`, the libraries WASI emulates
/// and `setjmp`, and the module it writes at `out`.
export fn wasm_link_tail(runtime: string, out: string) -> List<string> {
    [
        runtime,
        "-lwasi-emulated-mman",
        "-lwasi-emulated-signal",
        "-lwasi-emulated-getpid",
        "-lsetjmp",
        "-o",
        out,
    ]
}

/// The words a native link starts with: every symbol in the image's dynamic table where a package's
/// C names the program's own symbols by name (`[link] dynamic_symbols`), else what nothing reaches
/// dropped; the linker the host found; each host fn kept, since its caller is outside the program;
/// and the binary named where it lands.
export fn native_link_head(names_symbols: bool, ld: string, hosted: List<string>, binary: string) -> List<
    string,
> {
    ["-w", if names_symbols { "-rdynamic" } else { unreached_dropped() }]
        .concat(if ld == "" { [] } else { ["--ld-path=${ld}"] })
        .concat(host_kept_words(hosted))
        .concat(link_named(binary))
}

/// `x.av` builds `x`.
export fn binary_name(source: string) -> string {
    let base = if source.ends_with(".ll") { source.substring(0, source.length - 3) } else { source }
    if base.ends_with(".av") { base.substring(0, base.length - 3) } else { base }
}

// ── The voices ──

fn clang_link_failed(code: int) -> string {
    "avra: clang failed linking — exited with code ${code}"
}
