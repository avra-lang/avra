//! The vocabulary a build links with: clang's words for a link, and the binary
//! a source names.
use compiler.backend.{unreached_dropped}

/// clang's words for a link: the objects, the packages' own objects and
/// flags, the runtime, then the binary's path.
/// A PROGRAM CARRIES WHAT IT REACHES: the link drops every fn and object
/// member nothing reaches, so a package imported and not called costs
/// nothing. A program whose packages resolve its own symbols by name keeps
/// them all instead (`-rdynamic`): the evaluator resolves an extern through
/// `dlsym(RTLD_DEFAULT)`, which on ELF reaches the executable only when its
/// globals stand in the dynamic table.
/// THE RUNTIME IS LAST because it is an archive: an ELF linker takes from it
/// only what the words BEFORE it name, so a member only a package object
/// reaches — a row the compiler's host table names — is otherwise dropped.
fn link_objects(objs: List<string>, ws: Workspace, runtime: string, out: string, target: string) -> List<
    string,
> {
    if target != "" {
        // A WASM LINK: the driver's own target names crt1 and a libc, and the
        // runtime archive is the wasm one. A package's native C is NOT linked:
        // the socket, process and thread rows have no wasm body there and are
        // host imports on this target, so an unreached one costs nothing and a
        // reached one refuses rather than links foreign code.
        ["-w", "--target=${target}"]
            .concat(objs)
            .concat(
                [
                    runtime,
                    "-lwasi-emulated-mman",
                    "-lwasi-emulated-signal",
                    "-lwasi-emulated-getpid",
                    "-o",
                    out,
                ],
            )
    } else {
        ["-w", if ws.names_its_symbols() { "-rdynamic" } else { unreached_dropped() }]
            .concat(objs)
            .concat(ws.link_words())
            .concat([runtime, "-o", out])
    }
}

/// `x.av` builds `x`.
export fn binary_name(source: string) -> string {
    let base = if source.ends_with(".ll") { source.substring(0, source.length - 3) } else { source }
    if base.ends_with(".av") { base.substring(0, base.length - 3) } else { base }
}

// ── The voices ──

fn clang_link_failed(code: int) -> string {
    "avra: clang failed linking — exited with code ${code}"
}
