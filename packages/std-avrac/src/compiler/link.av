//! The vocabulary a build links with: clang's words for a link, and the binary
//! a source names.

/// clang's words for a link: the objects, the packages' own objects and
/// flags, the runtime, then the binary's path. `-rdynamic` is not decoration:
/// the evaluator resolves an extern through `dlsym(RTLD_DEFAULT)`, which on ELF
/// reaches the executable only when its globals stand in the dynamic table.
/// THE RUNTIME IS LAST because it is an archive: an ELF linker takes from it
/// only what the words BEFORE it name, so a member only a package object
/// reaches — a row the compiler's host table names — is otherwise dropped.
// LICENSED style.free_state_verb: a pure PROJECTION — the objects, the workspace's link rows and a
// toolchain fact in, clang's words out.
fn link_objects(objs: List<string>, ws: Workspace, runtime: string, out: string) -> List<string> {
    ["-w", "-rdynamic"].concat(objs).concat(ws.link_words()).concat([runtime, "-o", out])
}

/// `x.av` builds `x`.
export fn binary_name(source: string) -> string {
    let base = if source.ends_with(".ll") { source.substring(0, source.length - 3) } else { source }
    if base.ends_with(".av") { base.substring(0, base.length - 3) } else { base }
}

// ── The voices ──

fn clang_link_failed(code: int) -> string {
    "avra: clang failed linking — exited with code ${code}"
}
