//! THE PROOF: a rewrite is SAFE when every declaration it lands
//! inside lowers to the SAME IR before and after, register
//! renumbering aside (`core.alpha_renamed`) — never by trusting the
//! rewrite's own claim, and never by a fingerprint match alone
//! (`core.same_ins_list` walks the actual values — a fingerprint
//! agreeing is a fast pre-filter, never the verdict). `avra fix`
//! applies only what this proves; everything else is SHOWN, never
//! written (design §3).
//!
//! TWO DOORS, ONE COMPARISON: a rule's own `Candidate` carries a node
//! id (`At`) straight from the walk that found it (`ir_proved`); any
//! OTHER `Suggestion` — a spell-check, a dependency line, a named
//! type's wrap — carries only the byte ranges its own `Edit`s point
//! at, since it was built far from any AST walk (`edits_proved`).
//! Both end at `decl_ir_proved`, the one question either door asks:
//! does this declaration answer the same program before and after.
//!
//! A THIRD DOOR TRUSTS INSTEAD OF COMPARING: `law_proved` is for a
//! rewrite the IR proof can never confirm by the GRANULARITY of its
//! own comparison — two arms merged into one lower to fewer
//! instructions than two, a push loop and the comprehension that
//! replaces it call different runtime primitives — even though both
//! forms answer the same program. A rule that DECLARES this
//! (`RuleEntry.law`, its own `@law("...")`) is trusted on that claim
//! rather than asked to also match IR; the type-check safety net
//! every rewrite already stands behind (`after_p.clean()`) still
//! runs, so a law never excuses an UNSOUND splice — only a
//! comparison this proof's own granularity was never going to make.
use core.{At, alpha_renamed, same_fps, same_ins_list, Span, DeclId}
use features.{Analysed, enclosing_decl, FileView}
use compiler.lower.{Body, Lowered}
use compiler.host.{Beneath}
use @std.path.{normalized}
use @std.errors.{Edit}
use diagnostics.{spliced}

impl Program {
    /// Whether the declaration ENCLOSING `at` lowers to the SAME IR
    /// before and after `path`'s own text becomes `after_text` —
    /// `false` for a candidate this cannot even test (a synthesized
    /// node with no enclosing declaration, a declaration that fails
    /// to lower before OR after, a symbol the after-state answers
    /// under a different name). Absence of proof is exactly the
    /// SHOWN tier: it never reads as a refusal of the code, only of
    /// the rewrite.
    fn ir_proved(path: string, a: Analysed, at: At, after_text: string) -> bool {
        let d? = enclosing_decl(a.view, at) else { return false }
        let before_lo = match self.checked_from(null, true) {
            .Ok(l) -> l,
            .Err(_) -> { return false },
        }
        let after_p = self.after_program(path, after_text)
        if !after_p.clean() { return false }
        let after_lo = match after_p.checked_from(null, true) {
            .Ok(l) -> l,
            .Err(_) -> { return false },
        }
        self.decl_ir_proved(before_lo, after_lo, d)
    }

    /// THE LAW DOOR: `law`'s own claim (`RuleEntry.law`), handed back
    /// unchanged once `after_text` still TYPE-CHECKS — `null` for a
    /// rule that declares none, or a law-carrying rewrite whose
    /// splice fails to even compile (F2039's alternatives-bind
    /// mismatch reads exactly this way for `one_body_arms`: a bad
    /// join REFUSES here, it does not fall through to being trusted).
    /// Never asked to also match IR — that comparison is `ir_proved`'s
    /// alone, and this door exists for the rewrites it can never
    /// confirm by construction. THE SAME GATE `ir_proved` TRUSTS:
    /// `clean()` alone answers a program NOTHING has asked a
    /// question of yet — `checked_from` is what actually forces the
    /// parse and the type-check, so a law that only asked `clean()`
    /// waved a genuinely broken splice through (found live: a
    /// `push_loop` rewrite that glued two statements onto one line
    /// with no BREAK between them, `clean()` true, `avra check`
    /// refusing the identical text a breath later).
    fn law_proved(path: string, after_text: string, law: string?) -> string? {
        let claim? = law else { return null }
        let after_p = self.after_program(path, after_text)
        match after_p.checked_from(null, true) { .Ok(_) -> claim, .Err(_) -> null }
    }

    /// `ir_proved`'s question, generalized off a rule's own `At` to
    /// an arbitrary `Suggestion`'s edit set — no node id in hand,
    /// only the byte ranges its `Edit`s already carry. Splices ALL of
    /// `edits` into `path`'s text AT ONCE (so a multi-edit suggestion
    /// is proved as the one rewrite it is, never edit by edit), then
    /// asks the SAME question of every declaration any edit lands in.
    /// `false` for an edit outside `path` (a suggestion editing
    /// another file entirely — `packages.av`'s dependency line lands
    /// in a manifest, which carries no IR to compare), one that lands
    /// outside every declaration, or a splice that overlaps, reaches
    /// outside the text, or does not even lower clean.
    fn edits_proved(path: string, a: Analysed, edits: List<Edit>) -> bool {
        if edits.is_empty() || edits.any(it.loc.file != null && it.loc.file! != path) { return false }
        let ds = [decl_at_span(a.view, Span { lo: e.loc.lo, hi: e.loc.hi }) for e in edits]
        if ds.any(it == null) { return false }
        let after_text? = spliced(a.view.source.text, edits) else { return false }
        let before_lo = match self.checked_from(null, true) {
            .Ok(l) -> l,
            .Err(_) -> { return false },
        }
        let after_p = self.after_program(path, after_text)
        if !after_p.clean() { return false }
        let after_lo = match after_p.checked_from(null, true) {
            .Ok(l) -> l,
            .Err(_) -> { return false },
        }
        [d! for d in ds].all((d: DeclId) -> self.decl_ir_proved(before_lo, after_lo, d))
    }

    /// THE comparison itself: `d`'s own body, looked up by SYMBOL
    /// (never by id — `before_lo`/`after_lo` are two independent
    /// lowerings, so `d` names nothing in the second one) in each
    /// lowering, alpha-fingerprinted and compared.
    fn decl_ir_proved(before_lo: Lowered, after_lo: Lowered, d: DeclId) -> bool {
        let symbol = self.ws.decls.symbol(d)
        // NO entry: `self`'s own entry is whichever ONE file `avra
        // fix` was asked about — every OTHER file in the same
        // workspace (a compiler's own program-test fixtures, each
        // its own tiny entry) would then be judged under "a module
        // file runs nothing" and refused for running the statements
        // it owns, so the proof could never even reach `same_ir` in
        // a package that carries more than one program
        // (avra-8sb5.25.46). `checked_from(null, true)` asks what
        // the WHOLE WORKSPACE'S declared bodies lower to, which is
        // what a symbol's IR means regardless of which file the
        // caller happened to be asked about — `every_body_checked`
        // keeps its own entry-bound meaning for its other caller
        // (specs_test.av's case-refusal checks, which WANT that law
        // enforced).
        let before_body? = before_lo.fns.find(it.name == symbol) else { return false }
        let after_body? = after_lo.fns.find(it.name == symbol) else { return false }
        same_ir(before_body, after_body)
    }

    /// A FRESH program over the same workspace, `path`'s own text
    /// overridden to `text` — every other file read exactly as the
    /// original's host reads it. Never written to disk: the proof is
    /// asked before `avra fix` decides whether to write at all.
    fn after_program(path: string, text: string) -> Program {
        // LICENSED compiler.host_asked_directly: a host built over a host: the overlay asks the one beneath it — a composition, never a query's read
        let host2 = self.ws.host with { peek: (p: string) -> if normalized(p) == normalized(path) { Beneath.Text(text) } else { (self.ws.host.peek)(p) } }
        let ws2 = timed_workspace(host2, self.ws.root, self.ws.lang, self.ws.clock)
        ws2.program(null)
    }
}

/// `enclosing_decl`'s own question (features/code.av), over a byte
/// range rather than a node id — the only anchor an `Edit` outside
/// the rule DSL carries, since it was never minted from a walk over
/// `at`s.
fn decl_at_span(view: FileView, sp: Span) -> DeclId? {
    view.decls.innermost(view.decls.owner_spans(view.file), sp)
}

// A fingerprint agreeing is a fast pre-filter, never the verdict: it
// is an un-keyed rolling hash (core/fp.av) with no collision check,
// so two different instruction lists can share one. `same_ins_list`
// is the actual proof, over the same renamed values the hash folded.
//
// LICENSED compiler.free_state_verb: compares two independent Body VALUES, neither one's own state
fn same_ir(a: Body, b: Body) -> bool {
    let ra = alpha_renamed(a.ins, a.params.length)
    let rb = alpha_renamed(b.ins, b.params.length)
    same_fps([i.fingerprint() for i in ra], [i.fingerprint() for i in rb]) && same_ins_list(ra, rb)
}
