//! The disk form of a settled const. Fields carry their byte length, so text,
//! including newlines and NULs, can round trip without an escape language.
use features.{Settled, MetaVal, MetaHeap, MetaMap}
use core.{is_digit, joined}

fn wire_field(s: string) -> string { "${s.length}:${s}" }

fn wire_value(v: MetaVal) -> string {
    match v {
        .Int(n) -> wire_field("i") + wire_field("${n}"),
        .Float(bits) -> wire_field("f") + wire_field("${bits}"),
        .Text(s) -> wire_field("t") + wire_field(s),
        .Octets(xs) -> wire_field("o") + wire_field(["${x}" for x in xs].join(",")),
        .Bool(b) -> wire_field("b") + wire_field(if b { "1" } else { "0" }),
        .Absent -> wire_field("a"),
        .Gone -> wire_field("g"),
        .Node(i) -> wire_field("n") + wire_field("${i}"),
        .Map(i) -> wire_field("m") + wire_field("${i}"),
    }
}

/// One map's own wire form: its key count, then each key paired with
/// its value — `keys`/`values` are parallel lists, so the walk
/// enumerates the one it names and indexes the other by the same
/// position.
fn wire_map(row: MetaMap) -> string {
    mut out = wire_field("${row.keys.length}")
    for i, k in row.keys.enumerate() { out = out + wire_field(k) + wire_value(row.values[i]) }
    out
}

/// A unit row contains the answer, its heap, embed dependencies, the bodies its
/// run entered, and the value fingerprint that specialization keys use. Heap handles remain indices into
/// these serialized arrays. The bodies a run entered are named as its process named them, so
/// what the store keeps is `kept_wire`.
fn settled_wire(s: Settled) -> string {
    "S2" +
        wire_field("${s.fingerprint}") +
        fields_wire(s.embeds) +
        fields_wire(s.ran) +
        heap_wire(s.heap) +
        wire_value(s.answer)
}

/// A settled value AS THE STORE KEEPS IT: without the bodies its run entered. Those
/// names are the run's own process's, and nothing reads them back — so no
/// process-local id crosses the disk.
fn kept_wire(s: Settled) -> string { settled_wire(s with { ran: [] }) }

type WireReader = { raw: string, pos: int }

/// A counted run of fields: its length, then each one.
fn fields_wire(xs: List<string>) -> string { wire_field("${xs.length}") + joined([wire_field(x) for x in xs], "") }

/// A reader at the head of a wire payload — every wire starts two bytes in.
fn wire_reader(raw: string) -> WireReader { WireReader { raw: raw, pos: 2 } }

/// A map node of a settled heap.
fn meta_map(keys: List<string>, values: List<MetaVal>) -> MetaMap { MetaMap { keys: keys, values: values } }

/// A heap of settled nodes and maps.
fn meta_heap(nodes: List<List<MetaVal>>, maps: List<MetaMap>) -> MetaHeap { MetaHeap { nodes: nodes, maps: maps } }

fn wire_number(s: string) -> int? {
    if s.is_empty() { return null }
    let neg = s.char_code(0) == 45
    let start = if neg { 1 } else { 0 }
    if start == s.length { return null }
    mut n = 0
    for i in start..s.length {
        let c = s.char_code(i)
        if c < 48 || c > 57 { return null }
        n = n * 10 - (c - 48)
    }
    if neg { n } else { 0 - n }
}

impl WireReader {
    mut fn field() -> string? {
        mut at = self.pos
        while at < self.raw.length && is_digit(self.raw.char_code(at)) { at = at + 1 }
        if at == self.pos || at >= self.raw.length || self.raw.char_code(at) != 58 { return null }
        let size? = wire_number(self.raw.substring(self.pos, at)) else { return null }
        if size < 0 || size > self.raw.length - at - 1 { return null }
        let begin = at + 1
        self.pos = begin + size
        self.raw.substring(begin, self.pos)
    }

    /// A counted run of fields, as `fields_wire` writes it.
    mut fn fields() -> List<string>? {
        let count? = self.number() else { return null }
        if count < 0 { return null }
        mut out: List<string> = []
        // LICENSED loops.push_loop: a parse that refuses at the first missing field
        for i in 0..count {
            let f? = self.field() else { return null }
            out.push(f)
        }
        out
    }

    mut fn number() -> int? {
        let s? = self.field() else { return null }
        wire_number(s)
    }

    mut fn value() -> MetaVal? {
        let tag? = self.field() else { return null }
        if tag == "a" { return MetaVal.Absent }
        if tag == "g" { return MetaVal.Gone }
        let data? = self.field() else { return null }
        if tag == "t" { return MetaVal.Text(data) }
        if tag == "o" { return octets_of(data) }
        if tag == "b" { return MetaVal.Bool(data == "1") }
        let n? = wire_number(data) else { return null }
        match tag {
            "i" -> MetaVal.Int(n),
            "f" -> MetaVal.Float(n),
            "n" -> MetaVal.Node(n),
            "m" -> MetaVal.Map(n),
            _ -> null,
        }
    }
}

fn settled_from_wire(raw: string) -> Settled? {
    if !raw.starts_with("S2") { return null }
    mut r = wire_reader(raw)
    let fp? = r.number() else { return null }
    let embeds? = r.fields() else { return null }
    let ran? = r.fields() else { return null }
    let heap? = heap_from_wire(r) else { return null }
    let answer? = r.value() else { return null }
    if r.pos != raw.length { return null }
    Settled { answer: answer, heap: heap, embeds: embeds, fingerprint: fp, ran: ran }
}

/// A CONST THAT STRUCTURALLY REACHES THE WORLD, kept under the same key a
/// settled value would use: the verdict is the fact worth caching, since no
/// amount of re-settling turns a value that reaches the world into one that
/// does not. A stale row is safe — a callee that later stops reaching the
/// world just keeps the const on its runtime `once` path, same answer, one
/// skipped optimization.
fn reach_wire(words: string) -> string { "R1" + wire_field(words) }

fn reach_from_wire(raw: string) -> string? {
    if !raw.starts_with("R1") { return null }
    mut r = wire_reader(raw)
    let words? = r.field() else { return null }
    if r.pos != raw.length { return null }
    words
}

// ── What a file's bodies ASK ──────────────────────────────────────
//
// A held file contributes no body — its machine code is the stored object — but
// it does contribute the instantiations its bodies demand. A type argument rides
// the same wire a record's shape does; `read_type_wire` is its inverse.
use core.{FileId, DeclId, TypeId, wire_fields}
use features.{Wanted, Sub, SeatValue}

fn heap_wire(h: MetaHeap) -> string {
    mut out = wire_field("${h.nodes.length}")
    for slots in h.nodes {
        out = out + wire_field("${slots.length}")
        for v in slots { out = out + wire_value(v) }
    }
    out = out + wire_field("${h.maps.length}")
    for row in h.maps { out = out + wire_map(row) }
    out
}

/// `heap_wire`'s inverse — nodes then maps, each length-prefixed. The
/// one decoder for a shape written from two envelopes (a settlement's
/// own heap, a wanted seat's): a third hand-copy of this walk is the
/// third copy CLAUDE.md's own law refuses.
fn heap_from_wire(mut r: WireReader) -> MetaHeap? {
    let node_count? = r.number() else { return null }
    if node_count < 0 { return null }
    mut nodes: List<List<MetaVal>> = []
    for i in 0..node_count {
        let count? = r.number() else { return null }
        if count < 0 { return null }
        mut slots: List<MetaVal> = []
        for j in 0..count {
            let v? = r.value() else { return null }
            slots.push(v)
        }
        nodes.push(slots)
    }
    let map_count? = r.number() else { return null }
    if map_count < 0 { return null }
    mut maps: List<MetaMap> = []
    for i in 0..map_count {
        let count? = r.number() else { return null }
        if count < 0 { return null }
        mut keys: List<string> = []
        mut values: List<MetaVal> = []
        for j in 0..count {
            let key? = r.field() else { return null }
            let v? = r.value() else { return null }
            keys.push(key)
            values.push(v)
        }
        maps.push(meta_map(keys, values))
    }
    meta_heap(nodes, maps)
}

impl Workspace {

    /// `decl_ref`'s inverse — the whole field is a wire, since a ref is
    /// never nested inside a wider tilde stream the way a type's own is.
    fn decl_from_ref(raw: string) -> DeclId? {
        if raw == "" { return null }
        let wd? = self.decls.wire_decl(raw.split("~"), 0) else { return null }
        wd.id
    }

    fn decl_ref(d: DeclId?) -> string {
        if d == null { return "" }
        self.decls.decl_wire(d!)
    }

    fn file_ref(f: FileId) -> string { self.decls.file(f).path }

    fn seat_wire(s: SeatValue) -> string {
        wire_field("${s.index}") +
            wire_field(s.fp) +
            wire_field(self.type_ref(s.ty)) +
            wire_value(s.value) +
            heap_wire(s.heap)
    }

    fn sub_wire(sub: Sub?) -> string {
        if sub == null { return wire_field("-") }
        let s = sub!
        mut out = wire_field("+") +
            wire_field(self.decl_ref(s.target)) +
            wire_field("${s.args.length}")
        for a in s.args { out = out + wire_field(self.type_ref(a)) }
        out = out + wire_field("${s.consts.length}")
        for c in s.consts { out = out + wire_field(c) }
        out
    }

    /// `type_wire`'s own decoder: split the `~`-joined words, read the
    /// primitive at 0, and require it to consume them all.
    fn read_type_wire_of_wire(raw: string) -> TypeId? {
        if !raw.starts_with("^") { return null }
        let words = wire_fields(raw.substring(1, raw.length), "~")
        let d = self.decls.read_type_wire(words, 0)
        if d == null || d!.next != words.length { return null }
        d!.id
    }

    fn type_from_wire(raw: string) -> TypeId? { self.read_type_wire_of_wire(raw) }

    fn type_ref(t: TypeId) -> string { self.decls.type_wire(t) }

    fn wanted_list_from_wire(raw: string) -> List<Wanted>? {
        if !raw.starts_with("W1") { return null }
        mut r = wire_reader(raw)
        let count? = r.number() else { return null }
        if count < 0 { return null }
        mut out: List<Wanted> = []
        for i in 0..count {
            let name? = r.field() else { return null }
            let file_path? = r.field() else { return null }
            let decl_raw? = r.field() else { return null }
            let sub_mark? = r.field() else { return null }
            let f? = self.decls.known_file_id(file_path) else { return null }
            let decl = self.decl_from_ref(decl_raw)
            let sub: Sub? = if sub_mark == "+" {
                let target_raw? = r.field() else { return null }
                let target? = self.decl_from_ref(target_raw) else { return null }
                let arg_count? = r.number() else { return null }
                if arg_count < 0 { return null }
                mut args: List<TypeId> = []
                for j in 0..arg_count {
                    let tw? = r.field() else { return null }
                    let ty? = self.type_from_wire(tw) else { return null }
                    args.push(ty)
                }
                let const_count? = r.number() else { return null }
                if const_count < 0 { return null }
                mut consts: List<string> = []
                for j in 0..const_count {
                    let c? = r.field() else { return null }
                    consts.push(c)
                }
                Sub { target: target, args: args, consts: consts }
            } else {
                null
            }
            let seat_count? = r.number() else { return null }
            if seat_count < 0 { return null }
            mut seats: List<SeatValue> = []
            for j in 0..seat_count {
                let index? = r.number() else { return null }
                let fp? = r.field() else { return null }
                let tw? = r.field() else { return null }
                let ty = self.type_from_wire(tw)
                if ty == null { return null }
                let value? = r.value() else { return null }
                let heap? = heap_from_wire(r) else { return null }
                seats.push(SeatValue { index: index, fp: fp, ty: ty!, value: value, heap: heap })
            }
            out.push(Wanted { file: f, decl: decl, name: name, sub: sub, seats: seats, root: null })
        }
        if r.pos != raw.length { return null }
        out
    }

    fn wanted_list_wire(xs: List<Wanted>) -> string {
        mut out = "W1" + wire_field("${xs.length}")
        for w in xs { out = out + self.wanted_wire(w) }
        out
    }

    fn wanted_wire(w: Wanted) -> string {
        mut out = wire_field(w.name) +
            wire_field(self.file_ref(w.file)) +
            wire_field(self.decl_ref(w.decl))
        out = out + self.sub_wire(w.sub) + wire_field("${w.seats.length}")
        for s in w.seats { out = out + self.seat_wire(s) }
        out
    }
}

/// A wired octet list — its numbers, comma-joined, the empty text none —
/// or absence when a field is not a number, so the record is rebuilt.
fn octets_of(data: string) -> MetaVal? {
    if data == "" { return MetaVal.Octets([]) }
    mut out: List<int> = []
    // LICENSED loops.push_loop: a parse that refuses at the first field that is not a number
    for x in data.split(",") {
        let n? = wire_number(x) else { return null }
        out.push(n)
    }
    MetaVal.Octets(out)
}
