//! The disk form of a held file's asks, and the length-counted fields every wire is framed in:
//! text, including newlines and NULs, round trips without an escape language.
use features.{Wanted}
use core.{FileId, DeclId, TypeId, wire_fields, is_digit, joined}
use compiler.work.{work_ask_resolved}
use @std.path.{dir_of}

fn wire_field(s: string) -> string { "${s.length}:${s}" }

type WireReader = { raw: string, pos: int }

/// A counted run of fields: its length, then each one.
fn fields_wire(xs: List<string>) -> string { wire_field("${xs.length}") + joined([wire_field(x) for x in xs], "") }

/// A reader at the head of a wire payload — every wire starts two bytes in.
fn wire_reader(raw: string) -> WireReader { WireReader { raw: raw, pos: 2 } }

fn wire_number(s: string) -> int? {
    if s.is_empty() { return null }
    let neg = s.char_code(0) == 45
    let start = if neg { 1 } else { 0 }
    if start == s.length { return null }
    mut n = 0
    for i in start..s.length {
        let c = s.char_code(i)
        if c < 48 || c > 57 { return null }
        n = n * 10 - (c - 48)
    }
    if neg { n } else { 0 - n }
}

impl WireReader {
    mut fn field() -> string? {
        mut at = self.pos
        while at < self.raw.length && is_digit(self.raw.char_code(at)) { at = at + 1 }
        if at == self.pos || at >= self.raw.length || self.raw.char_code(at) != 58 { return null }
        let size? = wire_number(self.raw.substring(self.pos, at)) else { return null }
        if size < 0 || size > self.raw.length - at - 1 { return null }
        let begin = at + 1
        self.pos = begin + size
        self.raw.substring(begin, self.pos)
    }

    /// A counted run of fields, as `fields_wire` writes it.
    mut fn fields() -> List<string>? {
        let count? = self.number() else { return null }
        if count < 0 { return null }
        mut out: List<string> = []
        // LICENSED loops.push_loop: a parse that refuses at the first missing field
        for i in 0..count {
            let f? = self.field() else { return null }
            out.push(f)
        }
        out
    }

    mut fn number() -> int? {
        let s? = self.field() else { return null }
        wire_number(s)
    }

}

// A held file contributes no body — its machine code is the stored object — but it does
// contribute the instantiations its bodies demand, kept as NAMES: each ask's name and home
// readable without resolving a declaration.

impl Workspace {
    /// A held file's asks: each want's own wire kept whole, one field apiece behind its
    /// roaming mark.
    fn held_asks_wire(xs: List<Wanted>) -> string {
        "W4" +
            wire_field("${xs.length}") +
            joined(
                [wire_field(if self.decls.instantiated(w) { "+" } else { "-" } + self.held_wire(w)) for w in xs],
                "",
            )
    }

    /// One want as a held ask keeps it: its name, its home and its codec.
    fn held_wire(w: Wanted) -> string {
        wire_field(w.name) + wire_field(self.file_ref(w.file)) + wire_field(self.wants_text([w]))
    }

    /// `held_asks_wire`, read back for the held file `by`: nothing minted.
    fn held_asks_from_wire(by: string, raw: string) -> List<HeldAsk>? {
        if !raw.starts_with("W4") { return null }
        mut r = wire_reader(raw)
        let count? = r.number() else { return null }
        if count < 0 { return null }
        mut out: List<HeldAsk> = []
        // LICENSED loops.push_loop: a parse that refuses at the first unreadable ask
        for i in 0..count {
            let field? = r.field() else { return null }
            let ask? = held_ask_of(by, field) else { return null }
            out.push(ask)
        }
        if r.pos != raw.length { return null }
        out
    }

    /// A held ask resolved into the want it names; null when its declaration no longer resolves.
    fn held_ask_wanted(h: HeldAsk) -> Wanted? {
        work_ask_resolved()
        mut r = WireReader { raw: h.wire, pos: 0 }
        let _name? = r.field() else { return null }
        let _home? = r.field() else { return null }
        let kept? = r.field() else { return null }
        if r.pos != h.wire.length { return null }
        let wants? = self.wants_of_text(kept) else { return null }
        if wants.length != 1 { return null }
        wants[0]
    }
}

/// One held ask's field: its roaming mark, then the want's own wire, whose first two fields
/// are its name and its home.
fn held_ask_of(by: string, field: string) -> HeldAsk? {
    if field.is_empty() { return null }
    let wire = field.substring(1, field.length)
    mut r = WireReader { raw: wire, pos: 0 }
    let name? = r.field() else { return null }
    let home? = r.field() else { return null }
    HeldAsk { by: by, name: name, home: home, roams: field.starts_with("+"), wire: wire }
}
