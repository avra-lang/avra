//! A DECLARATION'S WIRE AND A TYPE'S SYMBOL, as the program layer's lowering and a declaration's
//! durable fold spell them: the `Decls` verbs that name a declaration or a type the same way in
//! every process, apart from the old Workspace's interface they were written beside.
use core.{
    some_list,
    wire_fields,
    joined,
    flatten,
    distinct,
    sorted_texts,
    sorted_by,
    module_path,
    digest_of,
    same_decl,
    ModulePath,
    DeclKind,
    Type,
    TypeId,
    DeclId,
    FileId,
    StmtId,
    ExprId,
    SeatMark,
    qtrace,
    traced,
}
use @std.text.{text_before}
use features.{
    ItemLine,
    Decl,
    Settlement,
    LANGUAGE_HOME,
    DeclAt,
    FnSig,
    StructSig,
    EnumSig,
    NamedSig,
    Decls,
    SettleRoot,
    Settled,
    kind_word,
    WireIndex,
    CancelReach,
    Signing,
}
use compiler.store.{Store, Stored, node_key}

/// The sentinel wire for a declaration that cannot be named — a tilde in
/// its own text; `wire_decl` reads too few words from it to decode.
const NO_ORDINAL: int = 0 - 1

impl Decls {

    /// A declaration as a wire: its file, kind, owner and name — never a
    /// position. A moved declaration keeps this wire; a declaration reordered
    /// around it never steals it. `owner` is a method's impl target ("" for
    /// anything not one), which is what tells `impl Word { fn one() }`'s `one`
    /// apart from a free `fn one()` sharing its name. A generated declaration
    /// adds its maker, and declarations sharing all of these are told apart by
    /// their place among them — a group that arrives whole, written ones at
    /// the parse and a maker's at its expansion, so its count never depends on
    /// what else is minted yet (`wire_spelled`). A tilde in owner, name or maker
    /// (case labels are sentences) wears NO_ORDINAL rather than corrupt the
    /// tilde stream.
    fn decl_wire(d: DeclId) -> string { self.decl_wire_from(d, (f: FileId) -> self.file(f).path) }

    /// `decl_wire`, its file spelled by `home`.
    fn decl_wire_from(d: DeclId, home: fn(FileId) -> string) -> string {
        let x = self.decl(d)
        let kind = kind_word(x.kind)
        // A BUILTIN SITS IN NO FILE OF THE PROGRAM'S: its wire names the language, so
        // one declaration has one spelling whichever file a process met first.
        if self.is_builtin(d) && !x.owner.contains("~") && !x.name.contains("~") { return "${LANGUAGE_HOME}~${kind}~${field_text(x.owner)}~${field_text(x.name)}" }
        let group = self.wire_siblings(x.file, kind, x.owner, x.name, x.maker)
        let at = [j for j, id in group if same_decl(id, d)].first() ?? 0
        wire_spelled(
            home(x.file),
            WireName { kind: kind, owner: x.owner, name: x.name, maker: x.maker },
            at,
            group.length,
        )
    }

    /// `f`'s declarations of one kind, owner, name and maker, in file order. The
    /// reader owes only the NAME's bucket, so a declaration of another name
    /// never moves it.
    fn wire_siblings(f: FileId, kind: string, owner: string, name: string, maker: string) -> List<
        DeclId,
    > {
        // the rows are minted, and the read is UNRECORDED: the one edge the reader owes is below,
        // so a name's bucket stands in for the whole file
        (self.ensure_file.get())(f)
        let kept = self.wire_index.get().get("${f.index}")
        let by = if kept != null && kept!.count == self.decl_count_of(f) { kept!.by } else { self.wire_indexed(f, self.decls_so_far(f)) }
        let b = self.name_bucket(name)
        if b >= self.cell_names.get().length { self.room_for_cell(b, name) }
        self.bucket_moved(b)
        // a `main` is its own file's: the shared bucket holds one per file
        if kind == kind_word(DeclKind.Main) { self.rows_read(f) } else { self.record_kernel.record_at(self.record_names.get(), b) }
        by.get(wire_key(kind, owner, name, maker)) ?? []
    }

    /// `f`'s declarations indexed by kind, owner and name, kept.
    fn wire_indexed(f: FileId, ids: List<DeclId>) -> Map<string, List<DeclId>> {
        mut by: Map<string, List<DeclId>> = {}
        for id in ids {
            let x = self.raw_decl(id)
            let k = wire_key(kind_word(x.kind), x.owner, x.name, x.maker)
            by.set(k, (by.get(k) ?? []).concat([id]))
        }
        self.wire_index.put("${f.index}", WireIndex { count: ids.length, by: by })
        by
    }

    /// A type as a record writes it.
    fn type_wire(id: TypeId) -> string { "^${self.wire_body(id, (f: FileId) -> self.file(f).path)}" }

    /// A type as a SYMBOL spells it: the record's wire with each file named
    /// by its package and its path within it, never where the building
    /// machine keeps the tree — an object is the same bytes on every machine.
    fn type_symbol(id: TypeId) -> string { "^${self.wire_body(id, (f: FileId) -> self.file(f).name)}" }

    /// The wire without its mark — what a wire nests — each file spelled by `home`.
    fn wire_body(id: TypeId, home: fn(FileId) -> string) -> string {
        match self.types.shape_of(id) {
            .Int -> "i",
            .Float -> "f",
            .Bool -> "b",
            .Str -> "s",
            .Bytes -> "y",
            .Ptr -> "p",
            .Void -> "v",
            .Null -> "n",
            .EmptyList -> "e",
            .EmptyMap -> "h",
            .Error -> "x",
            .Struct(d, _) -> "S~${self.decl_wire_from(d, home)}",
            .Enum(d, _) -> "E~${self.decl_wire_from(d, home)}",
            .Dyn(d, _) -> "D~${self.decl_wire_from(d, home)}",
            .TypeName(d, _) -> "N~${self.decl_wire_from(d, home)}",
            .Var(d, j, _) -> "R~${self.decl_wire_from(d, home)}~${j}",
            .App(d, _, args) -> "A~${self.decl_wire_from(d, home)}~${args.length}~${joined([self.wire_body(a, home) for a in args], "~")}",
            .List(t) -> "L~${self.wire_body(t, home)}",
            .Cell(t) -> "C~${self.wire_body(t, home)}",
            .Task(t) -> "K~${self.wire_body(t, home)}",
            .Tasks -> "T",
            .Opt(t) -> "O~${self.wire_body(t, home)}",
            .Map(k, v) -> "M~${self.wire_body(k, home)}~${self.wire_body(v, home)}",
            .Res(ok, err) -> "Q~${self.wire_body(ok, home)}~${self.wire_body(err, home)}",
            .Fn(params, marks, ret) -> joined(
                ["F", "${params.length}"]
                    .concat([self.wire_body(t, home) for t in params])
                    .concat(
                        [
                            joined(
                                [mark_word(if j < marks.length { marks[j] } else { no_seat_mark }) for j in 0..params.length],
                                "",
                            ),
                            self.wire_body(ret, home),
                        ],
                    ),
                "~",
            ),
            .Union(members) -> joined(
                ["U", "${members.length}"].concat([self.wire_body(m, home) for m in members]),
                "~",
            ),
            .Range -> "g",
        }
    }

}

/// A declaration's place in its file's wire index.
fn wire_key(kind: string, owner: string, name: string, maker: string) -> string { "${kind}\t${owner}\t${name}\t${maker}" }

/// What a declaration's wire names it by, apart from its file and place.
export type WireName = { kind: string, owner: string, name: string, maker: string }

/// The word a generated declaration's maker opens with in its wire.
const MAKER_MARK: string = "="

/// THE ONE SPELLING of a declaration's wire: its file, kind, owner and name, its maker's
/// when one made it, and its place `at` among the `count` that share all of these.
export fn wire_spelled(home: string, n: WireName, at: int, count: int) -> string {
    if [n.owner, n.name, n.maker].any(it.contains("~")) { return "${home}~${NO_ORDINAL}" }
    let base = "${home}~${n.kind}~${field_text(n.owner)}~${field_text(n.name)}"
    let made = if n.maker == "" { base } else { "${base}~${MAKER_MARK}${field_text(n.maker)}" }
    if count <= 1 { made } else { "${made}~${at}" }
}
