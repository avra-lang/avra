//! THE STRUCTURAL TYPE OF AN EXPRESSION — what DECLARED information
//! alone answers about a place or a call's answer, no unification: a
//! receiver's type, a parameter's, a field's declared type, a
//! method's declared return, a construction's own type. Shared by
//! any pass that needs a body's shapes without paying for a full
//! type-check — receivers.av's writer inference, and the error-union
//! fixpoint (failures.av).
use core.{DeclId, ExprId, StmtId, TypeId, Type, Arrow, ResSides, SyntaxArena, MethodParts}
use features.{NameFacts, Decls, bound_decl_of, method_row, declared_decl, state_slot}

/// What a name on a shape calls: the vocabulary's row, a declared
/// method, a contract's member — or nothing this pass can name.
export enum Callee {
    Row(writes: bool, answer: TypeId?)
    Method(d: DeclId)
    /// A `static fn` under a TYPE NAME — no receiver, so its
    /// arguments start at seat 0.
    Static(d: DeclId)
    /// A FN-TYPED FIELD. No declaration to flow into — the contract
    /// rides the TYPE, so its marks are the whole answer.
    FnSeats(held: Arrow)
    Contract(d: DeclId)
    None
}
