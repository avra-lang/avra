//! WHAT A PROGRAM FILE RUNS, AS IR: its top-level statements that run, in written order, one scope
//! lowered as the program's entry, and the value of the last when it's an expression shown as text.
use core.{
    NamesRead,
    BoxKind,
    Expected,
    ExprId,
    Ins,
    Layout,
    Lowering,
    Reg,
    SignedType,
    StmtId,
    SyntaxArena,
    lowering,
    new_node_store,
    owned_type,
    rt_sig_of,
}
use @std.program.address.{SourceFileAddress}
use @std.program.answer_record.{RecordedRead}
use @std.program.query_engine.{QueryEngine}

/// The unit a program file's entry is known by.
const ENTRY: string = "main"

/// The statements an entry runs as one body of no seats answering nothing, its value shown; absent
/// for a file that runs none.
fn entry_signed(read: EntryRead) -> SignedBody? {
    let shown? = read.stmts.last() else { return null }
    SignedBody {
        signature: FnSignature { type_params: [], params: [], answer: owned_type("void"), answer_width: null },
        item: ReadItem { store: read.store, stmts: read.stmts, written: read.store.expr_count() },
        body: read.body ?? read.store.block_over(read.stmts, null),
        stmt: shown,
        want: Expected.Free,
        fnless: true,
    }
}

/// The statements of `file` that run, lowered as its entry, its task tests held: a scope
/// holding them, the value of the last shown as text, the tasks they hold joined, then the entry's
/// exit, which answers the process's status. The names they bind stand in a scope of their own inside
/// the entry's seats, of which it has none. A file that runs none has an entry that only exits.
export fn lowered_entry(engine: QueryEngine, file: SourceFileAddress) -> LoweredFn? {
    let read = entry_read(engine, file, true)
    let signed? = entry_signed(read) else { return idle_entry(engine, file, read) }
    let body = elaborated(engine, file, signed)
    mut cx = lowering(
        body.store,
        lowered_program(engine, file, body.store, ENTRY, [], null) with { literal_symbol: (e: ExprId, ty: SignedType) -> read.literal_symbol(engine, file, body.store, e, ty) },
        body.core,
        body.seats,
        owned_type("int"),
    ) with { names: NamesRead { reads: body.reads } }
    cx.scope_enter()
    cx.opened()
    let value = cx.lowered_open(body.body)
    let shown = shape_shown(cx, body.core[body.body.index])
    let unprojected = answer_unprojected(read, shown)
    if unprojected == null { shown_as_text(cx, shown, value) }
    cx.closed()
    cx.scope_exit(null)
    cx.emit(Ins.Ret(0))
    unit_lowered(cx, 0, Layout.Word) with { refused: body.refused, unread: body.unread, unprojected: unprojected }
}

/// `ty` as an entry's answer is shown: the shape a named type stands over; any other type itself.
fn shape_shown(cx: Lowering, ty: SignedType?) -> SignedType? {
    let t? = ty else { return null }
    cx.named_over(t) ?? t
}

/// The entry of a file that runs no statement: it exits, answering the process's status.
fn idle_entry(engine: QueryEngine, file: SourceFileAddress, read: EntryRead) -> LoweredFn {
    mut cx = lowering(
        read.store,
        lowered_program(engine, file, read.store, ENTRY, [], null),
        [],
        {},
        owned_type("int"),
    )
    cx.scope_enter()
    cx.scope_exit(null)
    cx.emit(Ins.Ret(0))
    unit_lowered(cx, 0, Layout.Word)
}

/// The types an entry's answer is shown as, by the words the language spells them with: a scalar,
/// a text, a list or a map, or nothing at all.
const PROJECTED: List<string> = ["int", "float", "bool", "string", "List", "Map", "void"]

/// The entry's answer of type `shown`, where no text projection spells it: its type and the
/// statement that answers, the last of `read` that holds a value; absent where one spells it,
/// where it never arrives, or where its type names none, refused where it's written. A list that
/// says nothing of what it holds, `[]`'s own type, is spelled by none.
fn answer_unprojected(read: EntryRead, shown: SignedType?) -> Unprojected? {
    let ty? = shown else { return null }
    let spelled = match ty.head {
        .Owned(name) -> PROJECTED.contains(name),
        .Never or .Unnamed(_) -> true,
        rest -> false,
    }
    if spelled && !ty.nullable() && !ty.dynamic && !(ty.listed()?.partial() ?? false) { return null }
    let answering? = read.stmts.filter((s) -> read.store.stmt_value(s) != null).last() else { return null }
    let span? = read.store.stmt_span(answering) else { return null }
    Unprojected { name: ty.spelled(), lo: span.lo, hi: span.hi }
}

/// A file's running statements read back into one store, and where each item's nodes begin in it.
type EntryRead = {
    store: SyntaxArena,
    stmts: List<StmtId>,
    items: List<ItemBase>,
    /// The statements that run as one block, made as the store was read; absent where none runs.
    body: ExprId?,
}

/// An item of the file, by its place, the index its first node has in the entry's store, and the
/// statements of it that run.
type ItemBase = { at: int, base: int, stmts: List<StmtId> }

impl ItemBase {
    /// The node `e` of the entry's store as the item's own store numbers it.
    // LICENSED compiler.hand_sized_index: an item's nodes count from its base, the one place that offset is read
    fn own(e: ExprId) -> ExprId { ExprId { index: e.index - self.base } }

    /// The name the literal at `e` of the entry's store is laid out under where the item stands alone.
    fn sourced(engine: QueryEngine, file: SourceFileAddress, e: ExprId, ty: SignedType) -> string? {
        sourced_symbol(
            engine,
            file,
            read_item(engine, file, self.at).store,
            self.own(e),
            ty,
            self.at,
        )
    }
}

impl EntryRead {
    /// The name the literal at `e`, standing in `store`, is laid out under: the item's own, read where
    /// it stands alone, else the entry's for a literal no source wrote.
    fn literal_symbol(
        engine: QueryEngine,
        file: SourceFileAddress,
        store: SyntaxArena,
        e: ExprId,
        ty: SignedType,
    ) -> string {
        let item = self.items.filter(it.base <= e.index).last()
        let sourced = item?.sourced(engine, file, e, ty)
        sourced ?? made_symbol(file, store, ENTRY, e, ty)
    }
}

/// A file's entry read back for one engine, at its file's places or each item's own, the engine
/// reads that reading made, and each reader they have reached.
type EntryHeld = { engine: int, file: SourceFileAddress, placed: bool, read: EntryRead, reads: List<RecordedRead>, reached: Cell<List<int>> }

/// The entry read back last: a file's laws each read its entry, one after another.
once fn entry_held() -> Cell<EntryHeld?> {
    let held: Cell<EntryHeld?> = Cell.new(null)
    held
}

/// Every item of `file` that runs a statement, read back into one store, and the statements among
/// them that run: the reading held for `file`, its reads made again by a reader they haven't
/// reached, else read and held. The store is read, never written: a body that elaborates forks it.
/// Each item's places are counted from its own start, as its own reading counts them, unless
/// `placed`, which counts them from the file's: what a lowering writes into the binary.
fn entry_read(engine: QueryEngine, file: SourceFileAddress, placed: bool = false) -> EntryRead {
    let held? = entry_held_for(engine, file, placed) else { return entry_read_held(engine, file, placed) }
    let reader = engine.reader()
    if !held.reached.get().contains(reader) {
        engine.reads_made_again(held.reads)
        held.reached.push(reader)
    }
    held.read
}

/// The reading held for `file` in `engine`, at its file's places or each item's own as `placed`
/// says, absent where the one held is another's or none is.
fn entry_held_for(engine: QueryEngine, file: SourceFileAddress, placed: bool) -> EntryHeld? {
    let held? = entry_held().get() else { return null }
    if held.engine == engine.serial &&
        held.placed == placed &&
        held.file.path_in_package == file.path_in_package &&
        held.file.package_name == file.package_name { held } else { null }
}

/// `file`'s entry read back and held with the reads its reading made, in place of the one held.
fn entry_read_held(engine: QueryEngine, file: SourceFileAddress, placed: bool) -> EntryRead {
    engine.reads_begun()
    let read = entry_read_back(engine, file, placed)
    let reads = engine.reads_gathered()
    entry_held()
        .set(
            EntryHeld {
                engine: engine.serial,
                file: file,
                placed: placed,
                read: read,
                reads: reads,
                reached: Cell.new([engine.reader()]),
            },
        )
    read
}

/// Every item of `file` that runs a statement, read back into one store, each query it stands on
/// asked.
fn entry_read_back(engine: QueryEngine, file: SourceFileAddress, placed: bool) -> EntryRead {
    let declaring = [d.item for d in file_declares(engine, file).names]
    let store = new_node_store()
    mut items: List<ItemBase> = []
    mut stmts: List<StmtId> = []
    for at in 0..item_count(engine, file) {
        if declaring.contains(at) && !runs_in(engine, file, at) { continue }
        let base = store.exprs.count()
        let running = read_into(
            engine,
            file,
            store,
            at,
            if placed { item_start(engine, file, at) } else { 0 },
        )
            .filter((s) -> runs(store, s))
        items.push(ItemBase { at: at, base: base, stmts: running })
        stmts = stmts.concat(running)
    }
    EntryRead {
        store: store,
        stmts: stmts,
        items: items,
        body: if stmts.is_empty() { null } else { store.block_over(stmts, null) },
    }
}

/// Whether the item `at` of `file` holds a statement that runs, beside what it declares: a `let`
/// whose value an expansion made declares what the expansion hoists, and still runs.
fn runs_in(engine: QueryEngine, file: SourceFileAddress, at: int) -> bool {
    if generated_at(engine, file, at) != null {
        let item = read_item(engine, file, at)
        return item.stmts.any(runs(item.store, it))
    }
    let said = file_said_of_items(engine, file)
    at < said.length && said[at].runs
}

/// Whether a top-level statement runs: one that declares nothing.
fn runs(store: SyntaxArena, s: StmtId) -> bool { !store.is_declaration(s) }

/// The entry's shown value printed as text, as the type it's typed with spells it: text as itself, a
/// number or a truth by its row, a list of them by the row that joins it. A value of any other type
/// isn't shown yet; a map, and a value of no type, show nothing.
fn shown_as_text(mut cx: Lowering, ty: SignedType?, value: Reg) {
    let shown? = ty else { return }
    if shown.mapped() != null && !shown.nullable() && !shown.dynamic { return }
    let spelled? = spelling_of(cx, shown) else {
        if !(cx.laid_out(shown) is .Void) { cx.missed("a shown `${shown.spelled()}`, which no text spells yet") }
        return
    }
    let text = match spelled {
        .Itself -> value,
        .Row(name) -> cx.call_row(Layout.Boxed(BoxKind.Text), rt_sig_of(name)!, [value]),
    }
    cx.run_row(rt_sig_of("avra_puts")!, [text])
}

/// How a shown value is spelled as text: itself, or by the runtime row that spells it.
enum Spelling {
    Itself
    Row(name: string)
}

/// How a value of `ty` is spelled; absent for a type no row spells.
fn spelling_of(cx: Lowering, ty: SignedType) -> Spelling? {
    if ty.nullable() || ty.dynamic || !(ty.head is .Owned) { return null }
    let l? = cx.program.checked.layout(ty) else { return null }
    match l {
        .Word -> Spelling.Row("avra_int_text"),
        .Real -> Spelling.Row("avra_float_text"),
        .Truth -> Spelling.Row("avra_bool_text"),
        .Boxed(box) -> match box {
            .Text -> Spelling.Itself,
            .List -> list_spelling(cx, ty.args.first()),
            .Bytes or .Map or .Record or .Enum or .Closure or .Cell or .Task or .Dyn or .Union or .Range or .Slot -> null,
        },
        .Void or .Bare or .Fields(_) or .Tagged(_) or .Maybe(_) -> null,
    }
}

/// How a list of `elem` is spelled: by the row that joins its elements as text; absent for an
/// element no row joins.
fn list_spelling(cx: Lowering, elem: SignedType?) -> Spelling? {
    let e? = elem else { return null }
    if e.nullable() || e.dynamic || !(e.head is .Owned) { return null }
    let l? = cx.program.checked.layout(e) else { return null }
    match l {
        .Word -> Spelling.Row("avra_ints_text"),
        .Truth -> Spelling.Row("avra_bools_text"),
        .Boxed(box) -> match box {
            .Text -> Spelling.Row("avra_strs_text"),
            .Bytes or .List or .Map or .Record or .Enum or .Closure or .Cell or .Task or .Dyn or .Union or .Range or .Slot -> null,
        },
        .Void or .Real or .Bare or .Fields(_) or .Tagged(_) or .Maybe(_) -> null,
    }
}
