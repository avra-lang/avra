//! WHICH LAMBDAS CARRY THEIR FRAME OF CONTEXTS, in a program: those whose body reads a context, as
//! the program's survey of what it reads finds it (compiler/item_context_reads.av), each with the
//! frame current where it is made, entered where it runs. The survey reads every body as it is
//! lowered with nothing framed — framing a lambda changes nothing of what it reads — and a body the
//! program frames a lambda of is asked again with those lambdas framed, its own answer apart from the
//! one every other program shares. A body that boxes, calls through or places a box of a placed
//! trait is framed too, so those boxes carry the frame they are placed under. A program that declares
//! no context frames nothing, and reads nothing here but that.
use @std.meta.{derive}
use @std.program.address.{SourceFileAddress}
use @std.program.query_engine.{QueryDefinition, QueryEngine}
use @std.program.saved_derive.{Saved}
use @std.program.saved_query.{ListedQuery, definitions_of, query, query_definition}
use core.{CalledFn, ContextMarks, PLACED_FRAMES, distinct, flatten, some_list}

/// The lambdas of one body a program frames: the body's unit, and the symbol each lambda lifts under.
@derive(Saved)
type UnitFraming = { unit: string, lambdas: List<string> }

/// The lambdas a program frames, by the unit of each body that makes some.
@derive(Saved)
type ProgramFraming = { units: List<UnitFraming> }

/// What the body known by `unit` frames in the program that runs from the files `roots` — a file's
/// statements, and each case it writes: none where the files a root reaches declare no context, or
/// the body makes no lambda that reads one and boxes, calls through or places no placed box.
export fn framed_lambdas(engine: QueryEngine, roots: List<SourceFileAddress>, unit: string) -> List<
    string,
> {
    distinct(
        flatten(
            [u.lambdas for r in roots for u in entry_framing(engine, r).units if u.unit == unit],
        ),
    )
}

/// The unit a file's entry is framed by.
export fn entry_unit(file: SourceFileAddress) -> string { "entry:${file.package_name}:${file.path_in_package}" }

/// What a program run from the file `entry` frames, body by body — from its statements, and from each
/// case it writes, which a suite runs: nothing where the files it reaches declare no context, so a
/// package's other programs pay nothing for one that sets one.
@query
fn entry_framing(engine: QueryEngine, entry: SourceFileAddress) -> ProgramFraming {
    if entry_contexts(engine, entry).is_empty() { return ProgramFraming { units: [] } }
    let survey = read_survey(engine, entry.package_name)
    let statements = [UnitBody { unit: entry_unit(entry), body: b } for b in some_list(entry_plain(engine, entry))]
    let cases = file_cases(engine, entry).cases
    let specs = [UnitBody { unit: case_symbol(entry, k), body: b } for k, c in cases for b in some_list(lowered_case(engine, entry, c.item, c.index, case_symbol(entry, k), []))]
    let bodies = statements.concat(specs)
    for b in bodies { let _ = survey.settled(b.body) }
    let own = [UnitFraming { unit: b.unit, lambdas: framed_in(survey, b.body) } for b in bodies]
    let called = [UnitFraming { unit: c.symbol, lambdas: framed_in(survey, b) } for c in survey.met_calls.get() for b in some_list(reached_body(engine, c))]
    ProgramFraming { units: [u for u in own.concat(called) if !u.lambdas.is_empty()] }
}

/// A body a program runs from, and the unit it is known by.
type UnitBody = { unit: string, body: LoweredFn }

/// What `f` frames: each lambda it lifts whose body reads a context, and its placed boxes where it
/// boxes, calls through or places one.
fn framed_in(survey: ReadSurvey, f: LoweredFn) -> List<string> {
    let placing = [f.marks].concat([l.marks for l in f.lifts]).any((m) -> places(m))
    reading_lifts(survey, f).concat(if placing { [PLACED_FRAMES] } else { [] })
}

/// Whether a body marked `m` boxes, calls through, places or rehomes a box of a placed trait.
fn places(m: ContextMarks) -> bool {
    m.boxes.any(it.placed) ||
        m.dyns.any(it.placed) ||
        !m.placings.is_empty() ||
        !m.rehomes.is_empty()
}

/// The lambdas `f` lifts whose body reads a context, walked from no frame with every box the survey
/// met known.
fn reading_lifts(survey: ReadSurvey, f: LoweredFn) -> List<string> {
    [l.symbol for l in f.lifts if !survey.walk(l.ins, f, l.marks).reads.is_empty()]
}

collect listed_framing_facts: List<ListedQuery> = @query_definition in self as ListedQuery { definition: it } by it.name

/// The queries which lambdas a program frames is read through, for a process to hand its engine.
export fn framing_fact_definitions() -> List<QueryDefinition> { definitions_of(listed_framing_facts) }
