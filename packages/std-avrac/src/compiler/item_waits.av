//! WHETHER A CALL MAY SWITCH THE TASK OUT, READ OFF THE ITEMS' SUMMARIES: each fn, method and
//! record of a written item says, as its text says it, what its body may wait through — a runtime
//! row that waits, a `spawn`, a `select`, a task `.await`ed or held — and what it calls: fns by name,
//! methods by the declared type of their receiver, records whose defaults it leaves to run. A call
//! is judged by walking those summaries, no body lowered; where a summary can't name a callee or a
//! receiver's type, the answer is unknown, and the caller asks the task survey instead.
use core.{
    CompClause,
    ExprId,
    FnParts,
    OwnType,
    Param,
    PatId,
    Span,
    StmtId,
    SyntaxArena,
    TypeRef,
    body_behavior,
    distinct,
    own_type_named,
    rt_index,
    rt_waits,
    some_list,
}
use @std.meta.{derive}
use @std.program.address.{SourceFileAddress}
use @std.program.query_engine.{QueryEngine}
use @std.program.saved_derive.{Saved}
use @std.relation.engine.{map_cell}

/// What a body says of how it may switch the task out, as written: whether it waits itself,
/// whether something in it no summary can name (`unknown`), the fns it calls by name, its method
/// calls, and the records it builds. `hands` says a call of the fn does what no summary says: it
/// answers a type holding tasks, which a caller binding its answer joins, or takes a contract,
/// which a caller makes of what it passes, with every method its type's impl gives.
@derive(Saved)
type BodyWaits = {
    waits: bool,
    unknown: bool,
    hands: bool = false,
    calls: List<string>,
    methods: List<MethodWritten>,
    records: List<string>,
}

/// A method call as written: the path of its receiver's type (`on`) and the method's name, "" for
/// a walk over the receiver. A path starts at a root — `S` the impl's own type, `B` a value of the
/// language's own types, `F:<fn>` the answer of a fn by name, `N:<name>` what a name the body
/// doesn't bind names, or a written type (`type_code`) — then steps: a field by its name,
/// `()<method>` the answer of a method, or `?` what a `Result` or an optional carries.
@derive(Saved)
type MethodWritten = { on: List<string>, name: string }

/// What a record says for its literals: each field's written type (`type_code`, `""` where none can
/// be named), and what its fields' defaults wait through.
@derive(Saved)
type RecordWaits = { fields: List<string>, types: List<string>, defaults: BodyWaits }

/// The summary of a body that waits on nothing and calls nothing.
fn no_waits() -> BodyWaits { BodyWaits { waits: false, unknown: false, calls: [], methods: [], records: [] } }

/// The summary of a body no summary can name.
fn unknown_waits() -> BodyWaits { no_waits() with { unknown: true } }

/// The part of `item_wait_parts` holding the fn `name`'s summary.
fn fn_wait_part(name: string) -> string { "f${name}" }

/// The part of `item_wait_parts` holding the summary of the method `name` the item's `nth` impl
/// gives.
fn method_wait_part(nth: int, name: string) -> string { "m${nth}/${name}" }

/// The part of `item_wait_parts` holding the record `name`'s summary.
fn record_wait_part(name: string) -> string { "r${name}" }

/// Each summary the written item `item` holds, by its part's name: its fns', its externs' — which
/// run no Avra body — and the methods of its impls; of two declarations of one name, the first.
fn wait_parts_of(item: ReadItem) -> List<NamedSummary> {
    let store = item.store
    let fns = [NamedSummary { name: fn_wait_part(p!.name), waits: fn_waits(store, p!, null) } for s in item.stmts for p in [store.fn_parts(s)] if p != null]
    let externs = [NamedSummary {
        name: fn_wait_part(p!.name),
        waits: no_waits() with { hands: tasks_written(p!.ret) || p!.params.any(it.ty != null && contract_written(it.ty!)) },
    } for s in item.stmts for p in [store.extern_parts(s)] if p != null]
    let impls = [p! for s in item.stmts for p in [store.impl_parts(s)] if p != null]
    let methods = [NamedSummary { name: method_wait_part(nth, f!.name), waits: fn_waits(store, f!, i.target) } for nth, i in impls for s in i.fns for f in [store.fn_parts(s)] if f != null]
    let all = fns.concat(externs).concat(methods)
    let names = [n.name for n in all]
    [n for j, n in all if names.index_of(n.name) == j]
}

/// A summary beside the name of its part.
type NamedSummary = { name: string, waits: BodyWaits }

/// Each record the written item `item` declares, by its part's name; of two of one name, the first.
fn record_parts_of(item: ReadItem) -> List<NamedRecord> {
    let all = [NamedRecord { name: record_wait_part(p!.name), waits: fields_waits(item.store, p!.fields) } for s in item.stmts for p in [item.store.struct_parts(s)] if p != null]
    let names = [r.name for r in all]
    [r for j, r in all if names.index_of(r.name) == j]
}

/// A record's summary beside the name of its part.
type NamedRecord = { name: string, waits: RecordWaits }

/// What a record's fields say: their written types, and what their defaults wait through — a
/// field holding a contract makes one of what a literal passes it, which no summary says.
fn fields_waits(store: SyntaxArena, fields: List<Param>) -> RecordWaits {
    RecordWaits {
        fields: [f.name.of for f in fields],
        types: [if f.ty == null { "" } else { type_code(f.ty!) } for f in fields],
        defaults: joined_waits(
            [exprs_waits(store, store.expr_span(d!), [], null) for f in fields for d in [f.default] if d != null]
                .concat([unknown_waits() for f in fields if f.ty != null && contract_written(f.ty!)]),
        ),
    }
}

/// What the fn `f` waits through, as written — its body and its seats' defaults — `target` the
/// type its impl gives it to. A generic fn's body is lowered for each instance a call makes, a
/// seat that takes tasks is joined where the body ends, and an answer that is a contract is made
/// of what the body answers, none of which a summary says.
fn fn_waits(store: SyntaxArena, f: FnParts, target: string?) -> BodyWaits {
    if !f.tparams.is_empty() { return unknown_waits() }
    let own = exprs_waits(store, store.expr_span(f.body), f.params, target)
    let all = joined_waits(
        [own]
            .concat(
                [exprs_waits(store, store.expr_span(d!), [], null) for p in f.params for d in [p.default] if d != null],
            ),
    )
    let unsaid = f.params.any(it.ty != null && tasks_written(it.ty!)) || contract_written(f.ret)
    all with { unknown: all.unknown || unsaid, hands: tasks_written(f.ret) || f.params.any(it.ty != null && contract_written(it.ty!)) }
}

/// Every summary of `all` as one.
fn joined_waits(all: List<BodyWaits>) -> BodyWaits {
    BodyWaits {
        waits: all.any(it.waits),
        unknown: all.any(it.unknown),
        hands: all.any(it.hands),
        calls: distinct([c for w in all for c in w.calls]),
        methods: [m for w in all for m in w.methods],
        records: distinct([r for w in all for r in w.records]),
    }
}

/// What the nodes inside `at` wait through, `params` the seats that bind names there and `target`
/// the type `self` is, past what a quote holds. A binding that writes a type holding tasks is joined where its scope ends,
/// and one that writes a contract makes one of its value, which no summary says.
fn exprs_waits(store: SyntaxArena, at: Span?, params: List<Param>, target: string?) -> BodyWaits {
    let span? = at else { return unknown_waits() }
    let all = [e for i in 0..store.expr_count() for e in [ExprId { index: i }] if store.home_of(e) == null && !store.spanned_elsewhere(e) && inside(store.expr_span(e), span)]
    let quotes = [q! for e in all if quote_node(store, e) for q in [store.expr_span(e)] if q != null]
    let nodes = [e for e in all if quote_node(store, e) || !quotes.any((q) -> inside(store.expr_span(e), q))]
    let stmts = [s for s in store.stmt_ids() if inside(store.stmt_span(s), span) && !quotes.any((q) -> inside(store.stmt_span(s), q))]
    if stmts.any((s) -> written_unsaid(store, s)) { return unknown_waits() }
    let bound = bindings(store, nodes, stmts, params, target)
    joined_waits(
        [node_waits(store, bound, e) for e in nodes]
            .concat([walk_waits(store, bound, s) for s in stmts]),
    )
}

/// What one node waits through, `bound` the names its body binds: a call by name, a method call by
/// its receiver's path, a record built, a task's answer read, or a `select`. A call through a value
/// runs no body its own summary names; a task spawned or produced is joined where what holds it
/// ends, a channel's ends and a `yield` wait as what holds them does, a pipe's callee isn't named,
/// and a quote's nodes are code it makes, not code it runs — none of which a summary says.
fn node_waits(store: SyntaxArena, bound: Bindings, e: ExprId) -> BodyWaits {
    let none = no_waits()
    match store.expr(e) {
        .Call(callee, _, _) -> when {
            rt_index().get(callee.of) != null -> none with { waits: rt_waits(callee.of) }
            bound.names.contains(callee.of) -> none
            _ -> none with { calls: [callee.of] }
        },
        .Ident(n) -> if bound.names.contains(n.of) { none } else { none with { calls: [n.of] } },
        .MethodCall(subject, name, _) -> method_waits_at(bound, path_of(store, subject), name.of),
        .ChainCall(subject, name, _) -> method_waits_at(bound, carried(path_of(store, subject)), name.of),
        .StructLit(name, _, _) -> none with { records: [name.of] },
        .Prop(_, name) or .Chain(_, name) -> none with { waits: name.of == AWAIT },
        .Select(_, _) -> none with { waits: true },
        .Spawn(_) or .Produce(_, _, _) or .Emit(_) or .Channel(_, _) or .Pipe(_, _) -> unknown_waits(),
        .Body(_, _, _, _) -> if quote_node(store, e) { unknown_waits() } else { none },
        rest -> none,
    }
}

/// A method call of `name` on a receiver of the path `raw`, its names read through `bound`.
fn method_waits_at(bound: Bindings, raw: List<string>, name: string) -> BodyWaits {
    let on = bound.expanded(raw)
    if on.is_empty() { unknown_waits() } else { no_waits() with { methods: [MethodWritten { on: on, name: name }] } }
}

/// What the walk `s` waits through, where it is one: a walk over a list, a map, octets or a range
/// runs no Avra body, one over another type may join what supplies it, so its subject is held as a
/// method call named "" its type decides.
fn walk_waits(store: SyntaxArena, bound: Bindings, s: StmtId) -> BodyWaits {
    match store.stmt(s) {
        .ForEach(_, _, subject, _) -> method_waits_at(bound, path_of(store, subject), ""),
        rest -> no_waits(),
    }
}

/// The property a task's answer is read through, joining it.
const AWAIT: string = "await"

/// The names a body binds, and for each bound once by a seat or a `let` the path of its type as
/// written (`path_of`), its own names not yet read through.
type Bindings = { names: List<string>, raw: Map<string, List<string>>, target: string? }

impl Bindings {
    /// The path `raw` with each name it starts from read through what binds it: a name the body
    /// binds once by a seat or a `let`, through that binding, `N:` for a name it doesn't bind, and
    /// none for one it binds otherwise; `S` none outside an impl.
    fn expanded(raw: List<string>) -> List<string> { self.expanded_under(raw, 0) }

    /// `expanded`, `depth` bindings deep.
    fn expanded_under(raw: List<string>, depth: int) -> List<string> {
        if raw.is_empty() || depth > BINDINGS_DEEP { return [] }
        let root = raw[0]
        if root == "S" && self.target == null { return [] }
        if !root.starts_with("V:") { return raw }
        let name = root.substring(2, root.length)
        if !self.names.contains(name) { return ["N:${name}"].concat(raw.drop(1)) }
        let bound? = self.raw.get(name) else { return [] }
        let head = self.expanded_under(bound, depth + 1)
        if head.is_empty() { [] } else { head.concat(raw.drop(1)) }
    }
}

/// How many bindings deep a path is read through before it is left unnamed.
const BINDINGS_DEEP: int = 8

/// The names `nodes` and `stmts` bind, beside `params`, each bound once by a seat or a `let` with
/// the path of its type as written.
fn bindings(
    store: SyntaxArena,
    nodes: List<ExprId>,
    stmts: List<StmtId>,
    params: List<Param>,
    target: string?,
) -> Bindings {
    let seated = [BoundPath { name: p.name.of, path: if p.ty == null { [] } else { code_path(type_code(p.ty!)) } } for p in params]
    let lets = [BoundPath { name: n!, path: let_path(store, s) } for s in stmts for n in [store.let_name(s)] if n != null]
    let lambdas = [unpathed(p.name.of) for e in nodes for l in [store.lambda_parts(e)] if l != null for p in l!.params]
    let pats = [unpathed(n) for i in 0..store.pat_count() for n in [pat_bound(store, i)] if n != ""]
    let heads = [unpathed(n) for e in nodes for c in comp_clauses(store, e) for n in comp_binders(c)]
    let indices = [unpathed(n) for s in stmts for n in walk_index(store, s)]
    let all = seated.concat(lets).concat(lambdas).concat(pats).concat(heads).concat(indices)
    mut raw: Map<string, List<string>> = {}
    for b in all {
        if !b.path.is_empty() && all.filter(it.name == b.name).length == 1 { raw.set(b.name, b.path) }
    }
    Bindings { names: distinct([b.name for b in all]), raw: raw, target: target }
}

/// A name bound, and the path of its type as written; empty where none is.
type BoundPath = { name: string, path: List<string> }

/// The name `name` bound with no path written.
fn unpathed(name: string) -> BoundPath { BoundPath { name: name, path: [] } }

/// The name the pattern `i` binds; "" for one that binds none.
fn pat_bound(store: SyntaxArena, i: int) -> string {
    match store.pat(PatId { index: i }) { .Bind(name) -> name.of, rest -> "" }
}

/// The clauses of the comprehension `e`; none for any other node.
fn comp_clauses(store: SyntaxArena, e: ExprId) -> List<CompClause> {
    match store.expr(e) { .Comp(_, clauses) -> clauses, rest -> [] }
}

/// The names a comprehension's clause binds: a head's element, and its index where it names one.
fn comp_binders(c: CompClause) -> List<string> {
    match c {
        .Head(index, name, _, _) -> [name.of].concat([i.of for i in some_list(index)]),
        .Filter(_) -> [],
    }
}

/// The index the walk `s` binds, where it names one.
fn walk_index(store: SyntaxArena, s: StmtId) -> List<string> {
    match store.stmt(s) { .ForEach(index, _, _, _) -> [i.of for i in some_list(index)], rest -> [] }
}

/// The path of the type the `let` `s` binds: its written type, else its value's.
fn let_path(store: SyntaxArena, s: StmtId) -> List<string> {
    let ty = store.binding_ty(s)
    if ty != null { return code_path(type_code(ty!)) }
    match store.stmt(s) {
        .Let(_, _, value) or .MutLet(_, _, value) -> path_of(store, value),
        rest -> [],
    }
}

/// The path of the type of the value `e`, as written, a name it starts from not yet read through
/// (`V:<name>`): `self`, a name, a field, a method's or a fn's answer, a record built or copied
/// `with` other fields, a literal, or what a `?`, a `!` or a `?.` takes from a `Result` or an
/// optional; empty where none can be named.
fn path_of(store: SyntaxArena, e: ExprId) -> List<string> {
    match store.expr(e) {
        .Receiver -> ["S"],
        .Ident(n) -> ["V:${n.of}"],
        .Prop(subject, name) -> stepped(path_of(store, subject), [name.of]),
        .Chain(subject, name) -> stepped(path_of(store, subject), ["?", name.of]),
        .MethodCall(subject, name, _) -> stepped(path_of(store, subject), ["()${name.of}"]),
        .ChainCall(subject, name, _) -> stepped(path_of(store, subject), ["?", "()${name.of}"]),
        .Propagate(v) or .Force(v) -> carried(path_of(store, v)),
        .With(subject, _, _) -> path_of(store, subject),
        .StructLit(name, _, _) -> ["T:${name.of}"],
        .Call(callee, _, _) -> if rt_index().get(callee.of) != null { ["B"] } else { ["F:${callee.of}"] },
        .IntLit(_) or .StrLit(_) or .BoolLit(_) or .FloatLit(_) -> ["B"],
        rest -> [],
    }
}

/// `on` with `steps` after it; none where `on` is none.
fn stepped(on: List<string>, steps: List<string>) -> List<string> { if on.is_empty() { [] } else { on.concat(steps) } }

/// The path of what the value of the path `on` carries.
fn carried(on: List<string>) -> List<string> { stepped(on, ["?"]) }

/// A written type's code as a path: none for an unnamed one.
fn code_path(code: string) -> List<string> { if code == "" { [] } else { [code] } }

/// The written type `t` as a path's root: `T:<name>`, marked `!` where the language owns it and an
/// argument isn't its own; `?` before what an optional carries, `R` before what a `Result`
/// answers; "" for a fn type, a contract, or anything carrying an unnamed type.
fn type_code(t: TypeRef) -> string {
    if t.arrow || t.dynamic { return "" }
    if t.optional { return wrapped_code("?", type_code(t with { optional: false })) }
    if t.name == RESULT && !t.applied.is_empty() { return wrapped_code("R", type_code(t.applied[0])) }
    if own_type_named(t.name) == null || t.applied.all(owned_whole) { "T:${t.name}" } else { "T:${t.name}!" }
}

/// The type the language answers a fallible call in.
const RESULT: string = "Result"

/// `inner` marked `mark`; "" where `inner` is.
fn wrapped_code(mark: string, inner: string) -> string { if inner == "" { "" } else { "${mark}${inner}" } }

/// Whether `t` and every argument it applies are the language's own.
fn owned_whole(t: TypeRef) -> bool { own_type_named(t.name) != null && t.applied.all(owned_whole) }

/// Whether the written type `t` names a task, or tasks, anywhere in it.
fn tasks_written(t: TypeRef) -> bool {
    let own = own_type_named(t.name)
    own == OwnType.Task ||
        own == OwnType.Tasks ||
        t.applied.any(tasks_written) ||
        t.answer != null && tasks_written(t.answer!)
}

/// Whether the statement `s` writes a type naming tasks or a contract.
fn written_unsaid(store: SyntaxArena, s: StmtId) -> bool {
    let t? = store.binding_ty(s) else { return false }
    tasks_written(t) || contract_written(t)
}

/// Whether the written type `t` names a contract anywhere in it.
fn contract_written(t: TypeRef) -> bool {
    t.dynamic ||
        t.applied.any(contract_written) ||
        t.answer != null && contract_written(t.answer!) ||
        t.seats.any(contract_written(it.ty))
}

/// Whether the node `e` is a `quote`: the nodes inside it are code it makes, never code it runs.
fn quote_node(store: SyntaxArena, e: ExprId) -> bool {
    match store.expr(e) { .Body(word, _, _, _) -> body_behavior(word) is .Quote, rest -> false }
}

/// Whether `inner` stands inside `outer`.
fn inside(inner: Span?, outer: Span) -> bool {
    let held? = inner else { return false }
    outer.lo <= held.lo && held.hi <= outer.hi
}

// ── The walk ────────────────────────────────────────────────────────

/// A walk of the summaries: each body met, by its key, with what it was found to do — `true` where
/// it waits, `false` where all it reaches is known not to — and whether something it reached is
/// unknown.
type WaitWalk = { engine: QueryEngine, met: Cell<Map<string, bool>>, unknown: Cell<bool> }

/// Whether a call of the fn `d` may switch the task out, read off the summaries: absent where
/// something its body reaches has no summary that names it.
fn summary_waits(engine: QueryEngine, d: DeclaredName) -> bool? {
    let walk = WaitWalk { engine: engine, met: map_cell(), unknown: Cell.new(false) }
    if walk.fn_waits(d) { return true }
    if walk.unknown.get() { null } else { false }
}

impl WaitWalk {
    /// Whether the fn `d` waits.
    fn fn_waits(d: DeclaredName) -> bool {
        let w? = self.summary(d.file, d.item, fn_wait_part(d.name)) else { return self.unknown_met() }
        self.body_waits("${file_key(d.file)}#${d.name}", d.file, w, null)
    }

    /// Whether the method `name` the impl `at` gives waits; unknown for a generic type's, whose body
    /// is lowered for each instance a call makes.
    fn method_waits(at: ImplAt, name: string) -> bool {
        if !at.params.is_empty() { return self.unknown_met() }
        let w? = self.summary(at.file, at.item, method_wait_part(at.nth, name)) else { return self.unknown_met() }
        let item = read_item(self.engine, at.file, at.item)
        let target = [p!.target for s in some_list(impl_stmt_at(item, at)) for p in [item.store.impl_parts(s)] if p != null]
            .first()
        self.body_waits("${file_key(at.file)}@${at.item.of}/${at.nth}#${name}", at.file, w, target)
    }

    /// The summary the part `part` of the written item `at` of `file` holds.
    fn summary(file: SourceFileAddress, at: ItemId, part: string) -> BodyWaits? {
        let bytes? = item_wait_parts_part(self.engine, file, at, part) else { return null }
        BodyWaits.from_saved_bytes(bytes)
    }

    /// Whether the body `key` names, summarised `w` and reading its names from `file`, waits: met
    /// once, a body met again on the walk answering what it was found to, or `false` while it is
    /// still walked — what else it reaches answers for it.
    fn body_waits(key: string, file: SourceFileAddress, w: BodyWaits, target: string?) -> bool {
        let known = self.met.get().get(key)
        if known != null { return known! }
        self.met.put(key, false)
        let answer = self.reaches(file, w, target)
        self.met.put(key, answer)
        answer
    }

    /// Whether what `w` says, its names read from `file`, waits.
    fn reaches(file: SourceFileAddress, w: BodyWaits, target: string?) -> bool {
        if w.waits { return true }
        if w.unknown { let _ = self.unknown_met() }
        w.calls.any((c) -> self.called(file, c)) ||
            w.records.any((r) -> self.built(file, r)) ||
            w.methods.any((m) -> self.dispatched(file, m, target))
    }

    /// Whether a call of `name` from `file` waits: a fn's body, or the defaults of a record it
    /// builds; a name bound to no declaration is a value's, and calls none. A fn whose call does
    /// what no summary says (`hands`) is unknown.
    fn called(file: SourceFileAddress, name: string) -> bool {
        let d? = resolved(self.engine, file, Space.Value, name).named() else { return false }
        match d.kind {
            .Fn -> {
                if self.summary(d.file, d.item, fn_wait_part(d.name))?.hands ?? false { let _ = self.unknown_met() }
                self.fn_waits(d)
            },
            .Record -> self.record_waits(d),
            rest -> false,
        }
    }

    /// Whether building the record `name` names from `file` runs a default that waits.
    fn built(file: SourceFileAddress, name: string) -> bool {
        let d? = resolved(self.engine, file, Space.Type, name).named() else { return self.unknown_met() }
        if d.kind != ItemKind.Record { return false }
        self.record_waits(d)
    }

    /// Whether a default of the record `d` waits.
    fn record_waits(d: DeclaredName) -> bool {
        let r? = self.record(d) else { return self.unknown_met() }
        self.body_waits("${file_key(d.file)}${record_wait_part(d.name)}", d.file, r.defaults, null)
    }

    /// The summary of the record `d`.
    fn record(d: DeclaredName) -> RecordWaits? {
        let bytes? = item_wait_parts_part(self.engine, d.file, d.item, record_wait_part(d.name)) else { return null }
        RecordWaits.from_saved_bytes(bytes)
    }

    /// Whether the method call `m`, written in `file`, waits.
    fn dispatched(file: SourceFileAddress, m: MethodWritten, target: string?) -> bool {
        let ty? = self.path_type(file, m.on, target) else { return self.unknown_met() }
        self.method_of(ty, m.name)
    }

    /// Whether the method `name` of `ty` waits: the one method or static an impl gives its type, a
    /// variant built, or a row of the language's own types, which waits only where it joins a task
    /// — and a task's type is never seen. A walk over a declared type may join what supplies it.
    fn method_of(ty: SeenType, name: string) -> bool {
        if ty.wrapped != "" { return self.unknown_met() }
        let d? = ty.declared else { return false }
        if name == "" { return self.unknown_met() }
        let at? = self.given(d, name) else {
            if d.kind == ItemKind.Enum && self.variants(d).contains(name) { return false }
            return self.unknown_met()
        }
        if self.summary(at.file, at.item, method_wait_part(at.nth, name))?.hands ?? false { let _ = self.unknown_met() }
        self.method_waits(at, name)
    }

    /// The one impl giving the type `d` its method or static `name`; absent where none does, or
    /// more than one.
    fn given(d: DeclaredName, name: string) -> ImplAt? {
        let found = impls_given(self.engine, d.file, d.name, name, false, d.file.package_name)
        let ats = if found.is_empty() { impls_given(self.engine, d.file, d.name, name, true, d.file.package_name) } else { found }
        if ats.length == 1 { ats[0] } else { null }
    }

    /// The names of the variants the enum `d` declares.
    fn variants(d: DeclaredName) -> List<string> {
        let item = read_item(self.engine, d.file, d.item)
        [v.name.of for s in item.stmts for p in [item.store.enum_parts(s)] if p != null && p!.name == d.name for v in p!.variants]
    }

    /// The type the receiver path `on` reaches, read from `file`; absent where a step can't be named.
    fn path_type(file: SourceFileAddress, on: List<string>, target: string?) -> SeenType? {
        let root = on[0]
        mut ty = when {
            root == "S" -> self.code_type(file, "T:${target ?? ""}")
            root == "B" -> SeenType { plain: true }
            root.starts_with("F:") -> self.answer_type(file, root.substring(2, root.length))
            root.starts_with("N:") -> self.name_type(file, root.substring(2, root.length))
            _ -> self.code_type(file, root)
        }
        for step in on.drop(1) {
            let at? = ty else { return null }
            ty = when {
                step == "?" -> if at.wrapped == "" { null } else { self.code_type(at.home!, at.wrapped) }
                step.starts_with("()") -> self.method_answer(at, step.substring(2, step.length))
                _ -> self.field_type(at, step)
            }
        }
        ty
    }

    /// The type the written type's code `code` names from `file`: what an optional or a `Result`
    /// carries, held to be read on; one of the language's own, a task's never; or a record or enum
    /// declared.
    fn code_type(file: SourceFileAddress, code: string) -> SeenType? {
        if code == "" { return null }
        if code.starts_with("?") || code.starts_with("R") { return SeenType { wrapped: code.substring(1, code.length), home: file } }
        if !code.starts_with("T:") { return null }
        let marked = code.ends_with("!")
        let name = code.substring(2, if marked { code.length - 1 } else { code.length })
        if name == "" { return null }
        let own = own_type_named(name)
        if own != null {
            if own == OwnType.Task || own == OwnType.Tasks { return null }
            return SeenType { plain: !marked }
        }
        let d? = resolved(self.engine, file, Space.Type, name).named() else { return null }
        if d.kind != ItemKind.Record && d.kind != ItemKind.Enum { return null }
        SeenType { declared: d }
    }

    /// The type a name `file` reads, and the body doesn't bind, names: a const's written type, or
    /// a type itself, whose static or variant the call names; absent for any other value.
    fn name_type(file: SourceFileAddress, name: string) -> SeenType? {
        let v? = resolved(self.engine, file, Space.Value, name).named() else { return self.code_type(file, "T:${name}") }
        if v.kind != ItemKind.Const { return null }
        let item = read_item(self.engine, v.file, v.item)
        let t? = [t! for s in item.stmts if item.store.let_name(s) == v.name for t in [item.store.binding_ty(s)] if t != null]
            .first() else { return null }
        self.code_type(v.file, type_code(t))
    }

    /// The type the fn `name` names from `file` answers.
    fn answer_type(file: SourceFileAddress, name: string) -> SeenType? {
        let d? = resolved(self.engine, file, Space.Value, name).named() else { return null }
        if d.kind == ItemKind.Record { return SeenType { declared: d } }
        if d.kind != ItemKind.Fn { return null }
        let item = read_item(self.engine, d.file, d.item)
        let f? = [p! for s in item.stmts for p in [item.store.fn_parts(s)] if p != null && p!.name == d.name]
            .first() else { return null }
        self.code_type(d.file, type_code(f.ret))
    }

    /// The type of the field `name` of `ty`: what its record writes; a field of the language's own
    /// types over its own is one of them.
    fn field_type(ty: SeenType, name: string) -> SeenType? {
        if ty.wrapped != "" { return null }
        let d? = ty.declared else { return if ty.plain { ty } else { null } }
        let r? = self.record(d) else { return null }
        let j = r.fields.index_of(name)
        if j < 0 { return null }
        self.code_type(d.file, r.types[j])
    }

    /// The type the method `name` of `ty` answers: a row of the language's own types over its own
    /// answers one of them; a method one impl gives answers what it writes.
    fn method_answer(ty: SeenType, name: string) -> SeenType? {
        if ty.wrapped != "" { return null }
        let d? = ty.declared else { return if ty.plain { ty } else { null } }
        let at? = self.given(d, name) else { return null }
        let item = read_item(self.engine, at.file, at.item)
        let f? = [f! for s in some_list(impl_stmt_at(item, at)) for m in item.store.impl_parts(s)!.fns for f in [item.store.fn_parts(m)] if f != null && f!.name == name]
            .first() else { return null }
        self.code_type(at.file, type_code(f.ret))
    }

    /// Marks the walk as reaching something unknown, and answers that it doesn't wait as far as
    /// read.
    fn unknown_met() -> bool {
        self.unknown.set(true)
        false
    }
}

/// A file's key among the bodies a walk meets.
fn file_key(file: SourceFileAddress) -> string { "${file.package_name}:${file.path_in_package}" }

/// A type a receiver path reaches: a record or enum declared, or one the language owns — `plain`
/// where its arguments are all its own too — or what an optional or a `Result` carries, its code
/// (`wrapped`) read from `home`.
type SeenType = { declared: DeclaredName? = null, plain: bool = false, wrapped: string = "", home: SourceFileAddress? = null }

// ── Held to the survey ─────────────────────────────────────────────

/// A fn a file declares, held: what the summaries say of whether a call of it may switch the task
/// out — absent where they can't say — and what the task survey says reading its lowered bodies.
export type WaitsHeld = { name: string, summary: bool?, survey: bool }

/// Each fn the written items of `file` declare, held to the task survey.
export fn waits_held(engine: QueryEngine, file: SourceFileAddress) -> List<WaitsHeld> {
    [WaitsHeld {
        name: d!.name,
        summary: summary_waits(engine, d!),
        survey: surveyed_waits(engine, d!),
    } for at in item_ids(engine, file) for item in [read_item(engine, file, at)] for s in item.stmts for p in [item.store.fn_parts(s)] if p != null for d in [resolved(engine, file, Space.Value, p!.name).named()] if d != null && d!.kind == ItemKind.Fn && d!.item == at && file_key(d!.file) == file_key(file)]
}
