//! WORK, COUNTED. The compiler's own tallies of what a run did: files read from
//! disk, files parsed, modules and files minted from a hold, queries computed,
//! store rows written. Each is exact and the same on every machine, and the
//! ones that grow with the tree are held as RATIOS to the program's size, so a
//! ratchet can hold it where a clock cannot (tools/warm_edit_bench.sh, `check
//! --counts`). A tally is process-wide and only grows.
use @std.relation.engine.{queries_computed, whole_reads, whole_reads_by}
use compiler.store.{store_rows_written}

once fn loaded_tally() -> Cell<int> { Cell.new(0) }

once fn parsed_tally() -> Cell<int> { Cell.new(0) }

once fn modules_tally() -> Cell<int> { Cell.new(0) }

once fn files_tally() -> Cell<int> { Cell.new(0) }

once fn typed_tally() -> Cell<int> { Cell.new(0) }

fn bumped(tally: Cell<int>) { tally.set(tally.get() + 1) }

/// A file's text read from disk.
export fn work_loaded() { bumped(loaded_tally()) }

/// A source parsed from text.
export fn work_parsed() { bumped(parsed_tally()) }

/// A held module minted from its record.
export fn work_module_minted() { bumped(modules_tally()) }

/// A held file's declarations minted from its record lines.
export fn work_file_minted() { bumped(files_tally()) }

/// A body typed afresh, where a kept one did not stand.
export fn work_typed() { bumped(typed_tally()) }

/// The program's size, as the last check that derived it stood on it.
once fn sizes_tally() -> Cell<List<int>> { Cell.new([0, 0, 0]) }

/// The program's files, modules and declarations, noted when a check derives it.
export fn work_sized(files: int, modules: int, decls: int) { sizes_tally().set([files, modules, decls]) }

/// `n` per million of `size`: a count made relative to the program it ran on, so a tree that
/// grows is not refused for doing more work on more program. 0 for no program.
fn per_million(n: int, size: int) -> int { if size > 0 { n * 1000000 / size } else { 0 } }

/// The run's counts as one line. The gated ones — `files_loaded`, `files_parsed`, `whole_reads`, and the
/// `_ppm` ratios of work to program size — come first; `program_*` and the raw counts follow
/// and are only reported (tools/work_ratchet.py).
export fn work_counts() -> string {
    let size = sizes_tally().get()
    let minted_files = files_tally().get()
    let minted_modules = modules_tally().get()
    let queries = queries_computed()
    let rows = store_rows_written()
    "counts: files_loaded=${loaded_tally().get()} files_parsed=${parsed_tally().get()} files_minted_ppm=${per_million(minted_files, size[0])} modules_minted_ppm=${per_million(minted_modules, size[1])} typed_computed_ppm=${per_million(typed_tally().get(), size[0])} queries_computed_ppm=${per_million(queries, size[2])} whole_reads=${whole_reads()} store_rows_ppm=${per_million(rows, size[2])} program_files=${size[0]} program_modules=${size[1]} program_decls=${size[2]} files_minted=${minted_files} modules_minted=${minted_modules} queries_computed=${queries} typed_computed=${typed_tally().get()} store_rows_written=${rows}"
}

/// Who read which whole relation, one line each, counted: the query open at the read (or none),
/// then the relation it read all of, both by name. Reported beside the counts.
export fn work_whole_reads() -> List<string> { whole_reads_by() }
