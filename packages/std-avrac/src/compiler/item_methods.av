//! WHAT A TYPE'S METHODS ARE: every impl in the type's package whose target, resolved from the impl's
//! own file, is that very declaration — never one that only shares its name, and never missing one
//! written under an import's other name — and each method signed under the impl's type parameters.
use core.{SignedSeat, SignedType, TypeHead, headed_type}
use @std.meta.{derive}
use @std.program.address.{SourceFileAddress}
use @std.program.query_engine.{QueryDefinition, QueryEngine}
use @std.program.saved_derive.{Saved}
use @std.program.answer_parts.{AnswerParts, NamedValue, answer_parts}
use @std.program.saved_query.{ListedQuery, definitions_of, parted_query, query, query_definition}

/// Where an impl stands: its file, its item there, and its target's type parameters as it names
/// them.
@derive(Saved)
export type ImplAt = { file: SourceFileAddress, item: int, params: List<string> }

/// An impl filed under the type its target names: where it stands, the file declaring that type,
/// and the methods it gives.
@derive(Saved)
type FiledImpl = { at: ImplAt, of: SourceFileAddress, methods: List<string> }

/// The impls filed under one declared name.
@derive(Saved)
type Filed = { impls: List<FiledImpl> }

/// Every impl in a package, one part per name of the type its target resolves to from the impl's own
/// file, so an import's other name files with the type it names, and a reader of one type's impls
/// stands when another's move.
@parted_query
export fn package_impls(engine: QueryEngine, package: string) -> AnswerParts {
    mut by_type: Map<string, List<FiledImpl>> = {}
    for path in package_sources(engine, package, "src") {
        let f = SourceFileAddress { package_name: package, path_in_package: path }
        for at, held in file_impls(engine, f) {
            for i in held {
                let d? = resolved(engine, f, Space.Type, i.target).named() else { continue }
                let filed = FiledImpl {
                    at: ImplAt { file: f, item: at, params: i.params },
                    of: d.file,
                    methods: i.methods,
                }
                by_type.set(d.name, (by_type.get(d.name) ?? []).concat([filed]))
            }
        }
    }
    answer_parts(
        [NamedValue { name: name, value: Filed { impls: held }.saved_bytes() } for name, held in by_type],
    )
}

/// The impls the type `file` declares as `name` has in its package, each holding `method`.
@query
export fn impls_with(engine: QueryEngine, file: SourceFileAddress, name: string, method: string) -> List<
    ImplAt,
> {
    let part? = package_impls_part(engine, file.package_name, name) else { return [] }
    [i.at for i in Filed.from_saved_bytes(part).impls if i.methods.contains(method) &&
        i.of.path_in_package == file.path_in_package &&
        i.of.package_name == file.package_name]
}

/// The method `name` an impl gives, signed under the impl's type parameters and its own; absent
/// when it gives none.
@query
export fn method_signature(engine: QueryEngine, at: ImplAt, name: string) -> FnSignature? {
    let item = read_item(engine, at.file, at.item)
    let impl_fns = [p!.fns for s in item.stmts for p in [item.store.impl_parts(s)] if p != null]
        .first() ?? []
    let written? = written_fn(item.store, impl_fns, name) else { return null }
    let type_params = at.params.concat(written.type_params)
    let signing = Signing { engine: engine, file: at.file, type_params: type_params }
    FnSignature {
        type_params: type_params,
        params: [signing.param(p) for p in written.params],
        answer: signing.signed(written.ret),
        answer_width: null,
    }
}

/// The type of the method `name` on a value of `subject`'s type, the impl's parameters bound to the
/// subject's arguments: absent for an optional or dynamic subject, a type the program doesn't
/// declare, a method no impl gives, one with type parameters of its own, or a subject that doesn't
/// give the impl every argument it names.
export fn method_type(engine: QueryEngine, subject: SignedType, name: string) -> SignedType? {
    if subject.nullable() || subject.dynamic { return null }
    let at? = declared_at(subject) else { return null }
    let impls = impls_with(engine, at.file, at.name, name)
    if impls.length != 1 { return null }
    let s? = method_signature(engine, impls[0], name) else { return null }
    if s.type_params.length != impls[0].params.length ||
        subject.args.length != impls[0].params.length ||
        s.params.any(it.ty == null) { return null }
    let made = headed_type(TypeHead.Function) with { seats: [SignedSeat { ty: p.ty!.bound(subject.args), mutable: p.mutable, settled: p.settled } for p in s.params], answer: s.answer.bound(subject.args) }
    if made.generic() { null } else { made }
}

collect listed_method_facts: List<ListedQuery> = @query_definition in self as ListedQuery { definition: it } by it.name

/// The queries a type's methods read through, for a process to hand its engine.
export fn method_fact_definitions() -> List<QueryDefinition> { definitions_of(listed_method_facts) }
