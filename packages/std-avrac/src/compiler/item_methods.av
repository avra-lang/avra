//! WHAT A TYPE'S METHODS ARE: every impl in the type's package whose target, resolved from the impl's
//! own file, is that very declaration — never one that only shares its name, and never missing one
//! written under an import's other name — and each method signed under the impl's type parameters.
use core.{
    Annotation,
    ParamsDeclared,
    ComponentParts,
    LandedSeat,
    ExprId,
    MarkedStatic,
    NAMED_FIELD,
    distinct,
    flatten,
    enum_property_named,
    filled,
    SignedSeat,
    SignedType,
    StmtId,
    SyntaxArena,
    TypeHead,
    headed_type,
    own_type_named,
    owned_type,
    some_list,
}
use @std.meta.{derive}
use @std.program.address.{SourceFileAddress, source_file}
use @std.program.query_engine.{QueryDefinition, QueryEngine}
use @std.program.saved_derive.{Saved}
use @std.program.answer_parts.{AnswerParts, NamedValue, answer_parts}
use @std.program.saved_query.{
    cut_parted_query,
    definitions_of,
    ListedQuery,
    parted_query,
    query,
    query_definition,
}

/// Where an impl stands: its file, its item there, which of the item's impls it is (its impls in
/// order, then its components), and its target's type parameters as it names them.
@derive(Saved)
export type ImplAt = { file: SourceFileAddress, item: ItemId, params: List<string>, nth: int = 0 }

/// The impl statement `at` names in `item`; absent for a component's.
fn impl_stmt_at(item: ReadItem, at: ImplAt) -> StmtId? {
    let impls = [s for s in item.stmts if item.store.impl_parts(s) != null]
    if at.nth < impls.length { impls[at.nth] } else { null }
}

/// The component `at` names in `item`, filed after the item's impls; absent for an impl's.
fn impl_component_at(item: ReadItem, at: ImplAt) -> ComponentParts? {
    let impls = [s for s in item.stmts if item.store.impl_parts(s) != null]
    let components = [c! for s in item.stmts for c in [item.store.component_parts(s)] if c != null]
    let k = at.nth - impls.length
    if k >= 0 && k < components.length { components[k] } else { null }
}

/// The fns the impl `at` names writes in `item`: an impl's, or a component's after the item's impls.
fn impl_fns_at(item: ReadItem, at: ImplAt) -> List<StmtId> {
    let blocks = [p!.fns for s in item.stmts for p in [item.store.impl_parts(s)] if p != null]
        .concat([c!.fns for s in item.stmts for c in [item.store.component_parts(s)] if c != null])
    if at.nth < blocks.length { blocks[at.nth] } else { [] }
}

/// An impl filed under the type its target names: where it stands, the file declaring that type,
/// the methods and statics it writes, and the trait it implements, resolved from its own file.
@derive(Saved)
type FiledImpl = { at: ImplAt, of: SourceFileAddress, methods: List<string>, statics: List<string>, implements: TraitAt? }

/// Where a trait is declared: its file and its name there.
@derive(Saved)
export type TraitAt = { file: SourceFileAddress, name: string }

/// The impls filed under one declared name.
@derive(Saved)
type Filed = { impls: List<FiledImpl> }

/// Every impl a package's written items hold, one part per name of the type its target resolves to
/// from the impl's own file, so an import's other name files with the type it names, and a reader of
/// one type's impls stands when another's move.
@cut_parted_query("summary")
export fn package_impls(engine: QueryEngine, package: string) -> AnswerParts { impls_filed(engine, package, false) }

/// Every impl a package's generators made, filed as `package_impls` files the written ones.
@cut_parted_query("summary")
export fn package_generated_impls(engine: QueryEngine, package: string) -> AnswerParts { impls_filed(engine, package, true) }

/// The impls of a package's generated items when `generated`, else of its written ones, one part
/// per name of the type each impl's target resolves to: read where the template that wrote the impl
/// stands first, then from its file. A written impl's names are read as what is written names them,
/// so filing the written impls runs no generator — a generator may ask them; a written impl of a
/// type only a generator declares files with the generated ones, where any generator declares.
fn impls_filed(engine: QueryEngine, package: string, generated: bool) -> AnswerParts {
    mut by_type: Map<string, List<FiledImpl>> = {}
    let generators_declare = generated && generators_declare_any(engine, package)
    for path in package_sources(engine, package, "src") {
        let f = source_file(package, path)
        let by_item = if generated { generated_impls(engine, f) } else { written_impls(engine, f) }
        for k, held in by_item {
            for nth, i in held {
                let d? = impl_target(engine, f, i, !generated) else { continue }
                let filed = filed_impl(
                    engine,
                    f,
                    i,
                    d,
                    nth_item_id(engine, f, generated, k),
                    nth,
                    !generated,
                )
                by_type.set(d.name, (by_type.get(d.name) ?? []).concat([filed]))
            }
        }
        if !generators_declare {
            continue
        }
        for k, held in written_impls(engine, f) {
            for nth, i in held {
                if impl_target(engine, f, i, true) != null { continue }
                let d? = impl_target(engine, f, i, false) else { continue }
                by_type
                    .set(
                        d.name,
                        (by_type.get(d.name) ?? [])
                            .concat(
                                [
                                    filed_impl(
                                        engine,
                                        f,
                                        i,
                                        d,
                                        nth_item_id(engine, f, false, k),
                                        nth,
                                        false,
                                    ),
                                ],
                            ),
                    )
            }
        }
    }
    answer_parts(
        [NamedValue { name: name, value: Filed { impls: held }.saved_bytes() } for name, held in by_type],
    )
}

/// Whether a generator of `package`, or of a package it depends on, declares anything: where none
/// does, no written impl is of a type only a generator declares, and the generated impls read none of
/// the written ones, so an edit to them leaves the generated impls standing.
fn generators_declare_any(engine: QueryEngine, package: string) -> bool {
    depended_on(engine, [package], [])
        .any(
            (p) -> package_sources(engine, p, "src")
                .any((path) -> !generated_declares(engine, source_file(p, path)).names.is_empty()),
        )
}

/// The impl `i` of the item `item` of `f`, filed under the type `d` it's for, its trait named as
/// written names it where `written`.
fn filed_impl(
    engine: QueryEngine,
    f: SourceFileAddress,
    i: ItemImpl,
    d: DeclaredAt,
    item: ItemId,
    nth: int,
    written: bool,
) -> FiledImpl {
    let tr = if i.implements == null { null } else { impl_named(engine, f, i.trait_in, i.implements!, written) }
    FiledImpl {
        at: ImplAt { file: f, item: item, params: impl_params(engine, i, d), nth: nth },
        of: d.file,
        methods: i.methods,
        statics: i.statics,
        implements: if tr == null { null } else { TraitAt { file: tr!.file, name: tr!.name } },
    }
}

/// The type an impl in `file` is for, named `name`: read where the impl lands, then where `home`
/// says its template wrote the name — a generator's impl may be for a neighbour of the declaration
/// it annotates.
fn target_named(
    engine: QueryEngine,
    file: SourceFileAddress,
    home: string?,
    name: string,
    written: bool = false,
) -> DeclaredName? {
    impl_named(engine, file, null, name, written) ?? impl_named(engine, file, home, name, written)
}

/// The type an impl in `file` names `name` in one of its seats: read where `home` says that seat's
/// name was written, then where the impl stands.
fn impl_named(
    engine: QueryEngine,
    file: SourceFileAddress,
    home: string?,
    name: string,
    written: bool = false,
) -> DeclaredName? {
    read_from(engine, file, home)
        .find_map(
            (h) -> if written { resolved_written(engine, h, Space.Type, name) } else { resolved(engine, h, Space.Type, name) }
                .named(),
        )
}

/// Where the language's own type `word` (`Task`, `List`) is declared for an impl of it to be filed
/// under, when no declaration of the word is in reach: its verbs' file in the prelude. Absent for any
/// other word.
export fn own_declared(word: string) -> DeclaredAt? {
    if own_type_named(word) == null { return null }
    DeclaredAt { file: own_verbs_file(word), name: word }
}

/// Where a declared name stands.
export fn declared_of(n: DeclaredName?) -> DeclaredAt? {
    let d? = n else { return null }
    DeclaredAt { file: d.file, name: d.name }
}

/// The prelude file the language's own type `word`'s verbs are written in.
fn own_verbs_file(word: string) -> SourceFileAddress { source_file(PRELUDE, "verbs/${word}.av") }

/// A receiver of the type `file` declares as `name`, over `params`: the language's own type where
/// `file` is its verbs' file, else the declared one.
export fn receiver_over(file: SourceFileAddress, name: string, params: List<string>) -> SignedType {
    let args = [headed_type(TypeHead.Parameter(i, p)) for i, p in params]
    let own = own_declared(name)
    let head = if own != null &&
        own!.file.path_in_package == file.path_in_package &&
        file.package_name == PRELUDE { TypeHead.Owned(name) } else { TypeHead.Declared(file, name) }
    headed_type(head) with { args: args }
}

/// The type the impl `i` in `f` is for, as declared; absent where it names none.
fn impl_target(engine: QueryEngine, f: SourceFileAddress, i: ItemImpl, written: bool = false) -> DeclaredAt? {
    declared_of(target_named(engine, f, i.target_in, i.target, written)) ?? own_declared(i.target)
}

/// The type parameters the impl `i` stands over: those it writes, else those of the type `d` it's for.
fn impl_params(engine: QueryEngine, i: ItemImpl, d: DeclaredAt) -> List<string> {
    if i.params.is_empty() { declared_params(engine, d.file, d.name) } else { i.params }
}

/// The type parameters the type `file` declares as `name` stands over: a record's or a component's,
/// an enum's; none for any other. An impl that names none stands over these. Read as written, so
/// asking them signs no field and asks nothing a generator makes.
fn declared_params(engine: QueryEngine, file: SourceFileAddress, name: string) -> List<string> { written_params(engine, file, name) ?? [] }

/// The impls the type `file` declares as `name` has in its package: the written, then the generated.
fn impls_of(engine: QueryEngine, file: SourceFileAddress, name: string) -> List<FiledImpl> {
    impls_in(package_impls_part(engine, file.package_name, name), file)
        .concat(impls_in(package_generated_impls_part(engine, file.package_name, name), file))
}

/// The impls a part files for the type `file` declares.
fn impls_in(part: Bytes?, file: SourceFileAddress) -> List<FiledImpl> {
    let held? = part else { return [] }
    [i for i in Filed.from_saved_bytes(held).impls if i.of.same_as(file)]
}

/// The impls the type `file` declares as `name` has in its package that write `method`, as a method
/// or, when `statics`, as a static: the written ones that do, and only where none does, the
/// generated; none for a static an enum's variant names. So a generator's own code, which calls
/// what is written and builds variants by name, never asks what generators make.
@query("summary")
export fn impls_with(
    engine: QueryEngine,
    file: SourceFileAddress,
    name: string,
    method: string,
    statics: bool,
) -> List<ImplAt> {
    let written = copies_once(
        engine,
        [i for i in impls_in(package_impls_part(engine, file.package_name, name), file) if gives(i, method, statics)],
    )
    if !written.is_empty() { return written }
    if statics && variant_named(engine, file, name, method) { return [] }
    copies_once(
        engine,
        [i for i in impls_in(package_generated_impls_part(engine, file.package_name, name), file) if gives(i, method, statics)],
    )
}

/// `impls` with each copy of one impl kept once: a declaration items hoist each for themselves (a
/// route's path grammar two routes share) gives the same methods and statics at the same trait,
/// written alike, from each item that hoists it.
fn copies_once(engine: QueryEngine, impls: List<FiledImpl>) -> List<ImplAt> {
    if impls.length < 2 { return [i.at for i in impls] }
    let keys = [impl_key(engine, i) for i in impls]
    [i.at for j, i in impls if keys.index_of(keys[j]) == j]
}

/// What an impl gives, as two copies of one impl give it alike: its methods, its statics, and the
/// trait it implements as it writes it.
fn impl_key(engine: QueryEngine, i: FiledImpl) -> string {
    "${i.methods.join(",")}|${i.statics.join(",")}|${impl_given(engine, i.at) ?? ""}"
}

/// The impls of the type `file` declares as `name` that write `method`, as code of the package
/// `reader` sees them: its own package's, and where none does, those of `reader` itself or the first
/// package it reaches that writes one — a trait's package, where an impl of its trait for another
/// package's type stands, or for one of the language's own.
export fn impls_given(
    engine: QueryEngine,
    file: SourceFileAddress,
    name: string,
    method: string,
    statics: bool,
    reader: string?,
) -> List<ImplAt> {
    let own = impls_with(engine, file, name, method, statics)
    let package? = reader else { return own }
    if !own.is_empty() { return own }
    let reached = package_reach(engine, package).packages
    let others = [p for p in if reached.contains(package) { reached } else { [package].concat(reached) } if p != file.package_name]
    [ats for p in others for ats in [foreign_impls(engine, p, file, name, method, statics)] if !ats.is_empty()]
        .first() ?? []
}

/// Whether an impl a generator made of the type `file` declares as `name` gives it `member`, as a
/// static where `statics`.
export fn generated_gives(
    engine: QueryEngine,
    file: SourceFileAddress,
    name: string,
    member: string,
    statics: bool,
) -> bool {
    impls_in(package_generated_impls_part(engine, file.package_name, name), file)
        .any(gives(it, member, statics))
}

/// The methods the impls of the type `file` declares as `name` give it in its package, written and
/// generated, each once, in the order they are filed: what a call of a method it lacks is offered.
export fn methods_given(engine: QueryEngine, file: SourceFileAddress, name: string) -> List<string> {
    let parts = [
        package_impls_part(engine, file.package_name, name),
        package_generated_impls_part(engine, file.package_name, name),
    ]
    let all = [m for part in parts for i in impls_in(part, file) for m in i.methods]
    [m for j, m in all if all.index_of(m) == j]
}

/// The written impls the package `package` holds of the type `file` declares as `name` that write
/// `method`, impls written alike once, as `impls_with` keeps its own.
fn foreign_impls(
    engine: QueryEngine,
    package: string,
    file: SourceFileAddress,
    name: string,
    method: string,
    statics: bool,
) -> List<ImplAt> {
    copies_once(
        engine,
        [i for i in impls_in(package_impls_part(engine, package, name), file) if gives(i, method, statics)],
    )
}

/// The traits the written impls of the type `file` declares as `name` implement, by name.
fn written_traits(engine: QueryEngine, file: SourceFileAddress, name: string) -> List<string> {
    [i.implements!.name for i in impls_in(package_impls_part(engine, file.package_name, name), file) if i.implements != null]
}

/// Whether the enum `file` declares as `name` has a variant named `variant`.
fn variant_named(engine: QueryEngine, file: SourceFileAddress, name: string, variant: string) -> bool {
    let variants = enum_signature(engine, file, name)?.variants ?? []
    variants.any(it.name == variant)
}

/// Whether an impl writes `method`, as a method or, when `statics`, as a static.
fn gives(i: FiledImpl, method: string, statics: bool) -> bool { if statics { i.statics } else { i.methods }.contains(method) }

/// The method `method` a trait declares, its `Self` standing for `receiver`; absent when it declares
/// none.
@query("summary")
export fn trait_method_signature(
    engine: QueryEngine,
    held: TraitAt,
    method: string,
    receiver: SignedType,
) -> FnSignature? {
    let item? = declaring_item(engine, held.file, held.name, ItemKind.Trait) else { return null }
    let written? = written_fn(
        item.store,
        [m for m in trait_fns(item) if !item.store.is_static(m)],
        method,
    ) else { return null }
    written_signature(
        Signing {
            engine: engine,
            file: held.file,
            type_params: written.type_params,
            self_type: receiver,
            writer: written.writer,
        },
        written,
    )
}

/// What a written fn's signature is under `signing`.
fn written_signature(signing: Signing, written: WrittenFn) -> FnSignature {
    FnSignature {
        type_params: written.type_params,
        params: [signing.param(p) for p in written.params],
        answer: signing.signed(written.ret),
        answer_width: null,
        bounds: signing.bounds(written),
    }
}

/// Every method an impl gives, signed under the impl's type parameters and its own: one part per
/// name, so the impl is read once for every method asked of it.
@parted_query("summary")
export fn impl_signatures(engine: QueryEngine, at: ImplAt) -> AnswerParts {
    let item = read_item(engine, at.file, at.item)
    let impl_fns = impl_fns_at(item, at)
    let names = [n! for s in impl_fns for n in [written_name(item.store, s)] if n != null]
    let implemented = implemented_by(engine, at)
    answer_parts(
        [NamedValue {
            name: n,
            value: impl_signed(engine, at, n, written_fn(item.store, impl_fns, n)!, implemented)
                .saved_bytes(),
        } for i, n in names if names.index_of(n) == i],
    )
}

/// The name the fn or extern `s` declares, absent for any other statement.
fn written_name(store: SyntaxArena, s: StmtId) -> string? { store.fn_parts(s)?.name ?? store.extern_parts(s)?.name }

/// What a method `name`, written as `written` in the impl at `at`, is, signed under the impl's type parameters and its
/// own; a seat it leaves without a default takes the one the trait it implements, `implemented`,
/// writes for it.
fn impl_signed(
    engine: QueryEngine,
    at: ImplAt,
    name: string,
    written: WrittenFn,
    implemented: TraitAt?,
) -> FnSignature {
    let type_params = at.params.concat(written.type_params)
    let signing = Signing {
        engine: engine,
        file: at.file,
        type_params: type_params,
        writer: written.writer,
    }
    FnSignature {
        type_params: type_params,
        params: [signing.param(p) with { defaulted: p.default != null || trait_seat_default(engine, implemented, name, p.name.text()) != null } for p in written.params],
        answer: signing.signed(written.ret),
        answer_width: null,
        bounds: target_bounds(engine, at).concat(signing.bounds(written)),
        defaults: unbound(at.params.length)
            .concat([if d == null { null } else { signing.signed(d!) } for d in written.defaults]),
    }
}

/// What the method `name` on a value of `subject`'s type declares of each type parameter, its impl's
/// then its own: the one impl of a declared type that gives it; nothing for any other.
export fn method_declares(engine: QueryEngine, subject: SignedType, name: string, reader: string?) -> ParamsDeclared {
    let declared? = declared_at(subject) else { return ParamsDeclared {} }
    let impls = impls_given(engine, declared.file, declared.name, name, false, reader)
    if impls.length != 1 { return ParamsDeclared {} }
    let s? = method_signature(engine, impls[0], name) else { return ParamsDeclared {} }
    ParamsDeclared { bounds: s.bounds, defaults: s.defaults }
}

/// The bound each type parameter the impl at `at` stands over carries: the one its type declares it
/// with, where the impl stands over its type's own parameters (it writes none, or a component's own
/// `fn`s stand over the component's); none otherwise.
fn target_bounds(engine: QueryEngine, at: ImplAt) -> List<SignedType?> {
    let impls = impls_of_item(engine, at.file, at.item)
    if at.nth >= impls.length { return unbound(at.params.length) }
    let d? = impl_target(engine, at.file, impls[at.nth]) else { return unbound(at.params.length) }
    let declared? = record_signature(engine, d.file, d.name) else { return unbound(at.params.length) }
    let written = impls[at.nth].params
    if !written.is_empty() && written.join(",") != declared.type_params.join(",") { return unbound(at.params.length) }
    if declared.bounds.length != at.params.length { unbound(at.params.length) } else { declared.bounds }
}

/// The impls the item `at` of `file` holds: a written item's, else, past them, a generated one's.
fn impls_of_item(engine: QueryEngine, file: SourceFileAddress, at: ItemId) -> List<ItemImpl> {
    if item_held(engine, file, at) { return item_impls(engine, file, at) }
    let k? = generated_rank(at) else { return [] }
    let made = generated_impls(engine, file)
    if k < made.length { made[k] } else { [] }
}

/// The trait the impl at `at` implements, read where its file names it; absent for an impl of no
/// trait.
fn implemented_by(engine: QueryEngine, at: ImplAt) -> TraitAt? {
    let item = read_item(engine, at.file, at.item)
    let s? = impl_stmt_at(item, at) else { return null }
    let name? = item.store.impl_parts(s)?.of else { return null }
    let d? = impl_named(engine, at.file, item.store.seat_home(s, LandedSeat.Trait), name) else { return null }
    trait_declared(d)
}

/// The default a trait's own fn writes for one of its seats: the trait's item, the fn, the value.
type TraitDefault = { item: ReadItem, stmt: StmtId, value: ExprId }

/// The default the fn `name` the trait `implemented` declares writes for its seat `seat`; absent
/// for no trait, or a seat it writes none for.
fn trait_seat_default(engine: QueryEngine, implemented: TraitAt?, name: string, seat: string) -> TraitDefault? {
    let t? = implemented else { return null }
    let item? = declaring_item(engine, t.file, t.name, ItemKind.Trait) else { return null }
    let f? = trait_fns(item).find((s) -> item.store.fn_parts(s)?.name == name) else { return null }
    let value? = item.store.fn_parts(f)!.params.find(it.name.spells(seat))?.default else { return null }
    TraitDefault { item: item, stmt: f, value: value }
}

/// `n` type parameters bound by nothing.
fn unbound(n: int) -> List<SignedType?> {
    let none: SignedType? = null
    filled(n, none)
}

/// The method `name` an impl gives, signed under the impl's type parameters and its own; absent
/// when it gives none.
export fn method_signature(engine: QueryEngine, at: ImplAt, name: string) -> FnSignature? {
    let part? = impl_signatures_part(engine, at, name) else { return null }
    FnSignature.from_saved_bytes(part)
}

/// The fn type of the method `name` on a value of `subject`'s type, its receiver the first seat and
/// every type parameter (the impl's, then the method's own) left for the call to fill: an impl's
/// method on a type the program declares, a verb (`@std/prelude`'s `verbs/`) on one the language
/// owns; on a `dyn` value, the method its trait declares. Absent for an optional subject and a
/// method nothing gives.
export fn method_type(
    engine: QueryEngine,
    subject: SignedType,
    name: string,
    reader: string? = null,
) -> SignedType? {
    if subject.nullable() { return null }
    if subject.dynamic { return contract_method(engine, subject, name) }
    match subject.head {
        .Declared(file, declared) -> impl_method(engine, file, declared, name, reader) ?? shape_method(engine, subject, name),
        .Owned(word) -> own_verb(engine, "verbs/${word}.av", name, subject) ?? impl_method(
            engine,
            own_verbs_file(word),
            word,
            name,
            reader,
        ),
        .Parameter(_, _) or .Unnamed(_) or .Inferred or .Function or .Union or .Never or .Meta -> null,
    }
}

/// The static `name` of the type `described`, as a fn of what it's called with: one the language's
/// own type has (`@std/prelude`'s `verbs/statics/`); a trait's own, written in its body, which a
/// generator calls, so asking it never asks what generators make; else an impl's.
export fn static_type(engine: QueryEngine, described: SignedType, name: string) -> SignedType? {
    match described.head {
        .Owned(word) -> own_verb(engine, "verbs/statics/${word}.av", name, null),
        .Declared(file, declared) -> {
            let own = trait_static(engine, file, declared, name, described)
            if own != null { return own }
            let impls = impls_with(engine, file, declared, name, true)
            if impls.is_empty() { return enum_static(engine, described, file, declared, name) }
            if impls.length != 1 { return null }
            let s? = method_signature(engine, impls[0], name) else { return null }
            fn_typed([], s)
        },
        .Parameter(_, _) or .Unnamed(_) or .Inferred or .Function or .Union or .Never or .Meta -> null,
    }
}

/// The method `name` a value of the type parameter `subject` has through the trait it's bound by
/// under `signing`, `Self` the parameter; absent for any other type, or a method the trait doesn't
/// declare.
fn bound_method(engine: QueryEngine, signing: Signing, subject: SignedType, name: string) -> SignedType? {
    let bound? = signing.bound_of(subject) else { return null }
    let at? = declared_at(bound) else { return null }
    let s? = bound_signature(engine, trait_at(at), name, subject, bound.args) else { return null }
    receiver_typed(subject, s)
}

/// The method `name` the trait `held` declares, its own type parameters standing for `args` and
/// `Self` for `receiver`.
fn bound_signature(
    engine: QueryEngine,
    held: TraitAt,
    name: string,
    receiver: SignedType,
    args: List<SignedType>,
) -> FnSignature? {
    if args.is_empty() { trait_method_signature(engine, held, name, receiver) } else { applied_trait_fn(engine, held, name, false, receiver, args) }
}

/// The static `name` the type parameter `described` has through the trait it's bound by under
/// `signing`, `Self` the parameter; absent for any other type, or a static the trait doesn't declare.
fn bound_static(engine: QueryEngine, signing: Signing, described: SignedType, name: string) -> SignedType? {
    let bound? = signing.bound_of(described) else { return null }
    let at? = declared_at(bound) else { return null }
    if bound.args.is_empty() { return trait_static(engine, at.file, at.name, name, described) }
    let s? = applied_trait_fn(engine, trait_at(at), name, true, described, bound.args) else { return null }
    fn_typed([], s)
}

/// The fn `name` the trait `at` declares, a static where `statics`, signed with the trait's own type
/// parameters standing for `args` and `Self` for `receiver`; absent where it declares none, or the
/// fn has type parameters of its own.
fn applied_trait_fn(
    engine: QueryEngine,
    at: TraitAt,
    name: string,
    statics: bool,
    receiver: SignedType,
    args: List<SignedType>,
) -> FnSignature? {
    let item? = declaring_item(engine, at.file, at.name, ItemKind.Trait) else { return null }
    let s? = item.stmts.find((x) -> item.store.trait_parts(x)?.name == at.name) else { return null }
    let fns = item.store.trait_parts(s)!.fns
    let written? = written_fn(
        item.store,
        [f for f in fns if item.store.is_static(f) == statics],
        name,
    ) else { return null }
    if !written.type_params.is_empty() { return null }
    let signed = written_signature(
        Signing {
            engine: engine,
            file: at.file,
            type_params: item.store.decl_tparams(s),
            self_type: receiver,
            writer: written.writer,
        },
        written,
    )
    signed with { type_params: [], params: [p with { ty: p.ty?.bound(args) } for p in signed.params], answer: signed.answer.bound(args) }
}

/// The static every enum whose variants carry nothing has, as a fn of nothing: `all`, its variants in
/// the order declared. Absent for any other type, or name.
fn enum_static(
    engine: QueryEngine,
    described: SignedType,
    file: SourceFileAddress,
    declared: string,
    name: string,
) -> SignedType? {
    if name != ENUM_ALL { return null }
    let shape? = enum_signature(engine, file, declared) else { return null }
    if !shape.type_params.is_empty() ||
        shape.variants.any(!it.payloads.is_empty() || it.name == ENUM_ALL) { return null }
    headed_type(TypeHead.Function) with { answer: owned_type("List") with { args: [described] } }
}

/// The static that answers every variant of an enum whose variants carry nothing, where no variant
/// is named so.
const ENUM_ALL: string = "all"

/// The static fn `name` the trait `file` declares as `declared` writes in its own body, as a fn of what
/// it's called with, `Self` the type `receiver`; absent for a declaration that is no trait, or writes
/// none.
fn trait_static(
    engine: QueryEngine,
    file: SourceFileAddress,
    declared: string,
    name: string,
    receiver: SignedType,
) -> SignedType? {
    let item? = declaring_item(engine, file, declared, ItemKind.Trait) else { return null }
    let written? = written_fn(
        item.store,
        [f for f in trait_fns(item) if item.store.is_static(f)],
        name,
    ) else { return null }
    fn_typed(
        [],
        written_signature(
            Signing {
                engine: engine,
                file: file,
                type_params: written.type_params,
                self_type: receiver,
                writer: written.writer,
            },
            written,
        ),
    )
}

/// The property `name` of a value of `subject`'s type, as a fn of the receiver alone: one the
/// language's own type has (`@std/prelude`'s `verbs/props/`), one every enum has, or the one every
/// named type has.
export fn property_type(engine: QueryEngine, subject: SignedType, name: string) -> SignedType? {
    if subject.nullable() || subject.dynamic { return null }
    match subject.head {
        .Owned(word) -> own_verb(engine, "verbs/props/${word}.av", name, subject),
        .Declared(file, declared) -> enum_property(engine, subject, file, declared, name) ?? named_property(
            engine,
            subject,
            name,
        ) ?? shape_property(engine, subject, name),
        .Parameter(_, _) or .Unnamed(_) or .Inferred or .Function or .Union or .Never or .Meta -> null,
    }
}

/// The property `name` every enum has, as a fn of the receiver: `ordinal`, its variant's place in
/// the declaration, and `name`, its variant's name. Absent for a type that isn't an enum.
fn enum_property(
    engine: QueryEngine,
    subject: SignedType,
    file: SourceFileAddress,
    declared: string,
    name: string,
) -> SignedType? {
    if enum_signature(engine, file, declared) == null { return null }
    let property? = enum_property_named(name) else { return null }
    let answer = match property { .Ordinal -> owned_type("int"), .Name -> owned_type("string") }
    property_typed(subject, answer)
}

/// The method `name` the shape a named type stands over has, read on a value of the name: a read of a
/// name sees its shape. Absent for any other type, or a shape with no such method.
fn shape_method(engine: QueryEngine, subject: SignedType, name: string) -> SignedType? {
    let shape? = named_over(engine, subject) else { return null }
    through_shape(method_type(engine, shape, name), shape, subject)
}

/// The property `name` of the shape a named type stands over, read on a value of the name.
fn shape_property(engine: QueryEngine, subject: SignedType, name: string) -> SignedType? {
    let shape? = named_over(engine, subject) else { return null }
    through_shape(property_type(engine, shape, name), shape, subject)
}

/// A member `m` of `shape`, the shape `subject` names, as `subject` has it: what the receiver fills
/// filled, and the receiver, each seat and the answer that is the shape itself, the name.
fn through_shape(m: SignedType?, shape: SignedType, subject: SignedType) -> SignedType? {
    let member? = m else { return null }
    if member.seats.is_empty() { return null }
    mut found: Map<string, SignedType> = {}
    let _ = member.seats[0].ty.unifies(shape, found)
    let f = member.filled(found)
    let answer = if f.answer != null && wears(f.answer!, {}, shape) { subject } else { f.answer }
    f with { seats: [if at == 0 || wears(s.ty, {}, shape) { s with { ty: subject } } else { s } for at, s in f.seats], answer: answer }
}

/// Whether `ty`, its parameters filled by `found`, is `shape`.
fn wears(ty: SignedType, found: Map<string, SignedType>, shape: SignedType) -> bool { ty.filled(found).spelled() == shape.spelled() }

/// The property every named type has, as a fn of the receiver: `of`, the shape it is written over,
/// one name down. Absent
/// for a type that isn't a named type.
fn named_property(engine: QueryEngine, subject: SignedType, name: string) -> SignedType? {
    if name != NAMED_FIELD { return null }
    let shape? = named_next_over(engine, subject) else { return null }
    property_typed(subject, shape)
}

/// The method `name` the one impl of the type `file` declares as `declared` that gives it, its
/// receiver the type over the impl's own parameters.
fn impl_method(
    engine: QueryEngine,
    file: SourceFileAddress,
    declared: string,
    name: string,
    reader: string?,
) -> SignedType? {
    let impls = impls_given(engine, file, declared, name, false, reader)
    if impls.length > 1 { return null }
    if impls.is_empty() { return trait_method(engine, file, declared, name) }
    let s? = method_signature(engine, impls[0], name) else { return null }
    let receiver = receiver_over(file, declared, impls[0].params)
    receiver_typed(receiver, s)
}

/// An impl giving a method or a static of a name another impl of the same type gives too: where it
/// stands, the trait it implements as it writes it (`From<int>`), and the fn's type, a method's
/// receiver its first seat.
export type GivenImpl = { at: ImplAt, implemented: string, ty: SignedType, by_default: bool = false }

/// The impls of `subject`'s type that each give the method, or when `statics` the static, `name`,
/// where more than one gives it: a call chooses among them by its arguments. Empty where at most one
/// does.
export fn impls_giving(
    engine: QueryEngine,
    subject: SignedType,
    name: string,
    statics: bool,
    reader: string?,
) -> List<GivenImpl> {
    if subject.nullable() || subject.dynamic { return [] }
    let declared? = declared_at(subject) ?? owned_at(subject) else { return [] }
    let impls = impls_given(engine, declared.file, declared.name, name, statics, reader)
    if impls.is_empty() && !statics { return defaults_giving(engine, declared, name) }
    if impls.length < 2 { return [] }
    [g! for at in impls for g in [given_impl(engine, at, declared, name, statics)] if g != null]
}

/// The traits several impls make the type `declared` implement whose own bodies each give the
/// method `name` it never writes, each a candidate; empty where at most one does.
fn defaults_giving(engine: QueryEngine, declared: DeclaredAt, name: string) -> List<GivenImpl> {
    let givers = default_givers(engine, declared.file, declared.name, name)
    if givers.length < 2 { return [] }
    let receiver = headed_type(TypeHead.Declared(declared.file, declared.name))
    [GivenImpl { at: g.at, implemented: g.written, ty: t!, by_default: true } for g in givers for t in [given_typed(engine, g, name, receiver)] if t != null]
}

/// The method `name` the giver `g` gives, as a fn of `receiver` then its seats.
fn given_typed(engine: QueryEngine, g: DefaultGiver, name: string, receiver: SignedType) -> SignedType? {
    let s? = given_signature(engine, g, name, receiver) else { return null }
    receiver_typed(receiver, s)
}

/// The impl at `at` as one of several giving `name` to the type `declared`; absent where its fn
/// doesn't sign, or it implements no trait.
fn given_impl(engine: QueryEngine, at: ImplAt, declared: DeclaredAt, name: string, statics: bool) -> GivenImpl? {
    let s? = method_signature(engine, at, name) else { return null }
    let implemented? = impl_given(engine, at) else { return null }
    let ty? = (if statics { fn_typed([], s) } else { receiver_typed(receiver_over(declared.file, declared.name, at.params), s) }) else {
        return null
    }
    GivenImpl { at: at, implemented: implemented, ty: ty }
}

/// The arguments the impl at `at` applies the trait it implements to, signed where it stands.
export fn impl_trait_args(engine: QueryEngine, at: ImplAt) -> List<SignedType> {
    let item = read_item(engine, at.file, at.item)
    let s? = impl_stmt_at(item, at) else { return [] }
    let signing = signing_in(engine, at.file, at.params)
    [signing.signed(a) for a in item.store.impl_parts(s)!.of_args]
}

/// The trait the impl at `at` implements, as it writes it with its arguments (`From<int>`); absent
/// for an impl of no trait.
export fn impl_given(engine: QueryEngine, at: ImplAt) -> string? {
    let item = read_item(engine, at.file, at.item)
    let s? = impl_stmt_at(item, at) else { return null }
    let parts = item.store.impl_parts(s)!
    let of? = parts.of else { return null }
    let args = [a.text() for a in parts.of_args]
    if args.is_empty() { of } else { "${of}<${args.join(", ")}>" }
}

/// The method `name` the trait a `dyn` value of `subject`'s type holds declares, its receiver the
/// value; absent where `subject` names no trait the program declares, or it declares none.
fn contract_method(engine: QueryEngine, subject: SignedType, name: string) -> SignedType? {
    let at? = match subject.head {
        .Declared(file, declared) -> TraitAt { file: file, name: declared },
        .Owned(_) or .Parameter(_, _) or .Unnamed(_) or .Inferred or .Function or .Union or .Never or .Meta -> null,
    } else { return null }
    let s? = trait_method_signature(engine, at, name, subject) else { return null }
    receiver_typed(subject, s)
}

/// The method `name` the one trait the type implements that declares it gives, `Self` the type and
/// the trait's own parameters what the impl applies it to:
/// what a trait's own body supplies to every impl that doesn't write it, and what a `collect enum`
/// implements over its members. A generic type's trait methods aren't claimed yet.
fn trait_method(engine: QueryEngine, file: SourceFileAddress, declared: string, name: string) -> SignedType? {
    let receiver = headed_type(TypeHead.Declared(file, declared))
    let givers = default_givers(engine, file, declared, name)
    if givers.length == 1 { return given_typed(engine, givers[0], name, receiver) }
    if givers.length > 1 { return null }
    let traits = [i.implements! for i in impls_of(engine, file, declared) if i.at.params.is_empty() && i.implements != null]
        .concat(gathered_traits(engine, file, declared))
    let found = [s! for t in traits for s in [trait_method_signature(engine, t, name, receiver)] if s != null]
    if found.length != 1 { return null }
    receiver_typed(receiver, found[0])
}

/// The traits the `collect enum` `file` declares as `name` implements over its members, each named
/// where the enum is written; none for any other declaration. With `written`, each is read among
/// written names alone: what a generator's own sites ask, since a name nothing writes would ask
/// what generators make.
export fn gathered_traits(
    engine: QueryEngine,
    file: SourceFileAddress,
    name: string,
    written: bool = false,
) -> List<TraitAt> {
    let item? = declaring_item(engine, file, name, ItemKind.CollectEnum) else { return [] }
    let parts? = [p! for s in item.stmts for p in [item.store.collect_enum_parts(s)] if p != null]
        .find(it.name == name) else { return [] }
    [t! for e in parts.traits for t in [trait_written(engine, file, item.store.ident_name(e), written)] if t != null]
}

/// The trait `named` names from `file`, absent for a name naming none; among written names alone
/// where `written`.
fn trait_written(engine: QueryEngine, file: SourceFileAddress, named: string?, written: bool) -> TraitAt? {
    let n? = named else { return null }
    let d? = type_named(engine, file, n, written) else { return null }
    if d.kind == ItemKind.Trait { trait_declared(d) } else { null }
}

/// What `name` names as a type from `file`'s top level; among written names alone where `written`.
fn type_named(engine: QueryEngine, file: SourceFileAddress, name: string, written: bool) -> DeclaredName? {
    if !written { return resolved(engine, file, Space.Type, name).named() }
    written_resolution(engine, file, Space.Type, name).named()
}

/// The trait the declaration `d` is.
fn trait_declared(d: DeclaredName) -> TraitAt { TraitAt { file: d.file, name: d.name } }

/// The verb `name` the file at `path` in `@std/prelude` declares for a receiver of `subject`'s type:
/// the first declared whose receiver seat takes it, or for a static (no subject) the one declared.
fn own_verb(engine: QueryEngine, path: string, name: string, subject: SignedType?) -> SignedType? {
    let file = source_file(PRELUDE, path)
    let typed = [f! for s in fn_signatures(engine, file, name) for f in [fn_typed([], s)] if f != null]
    let s? = subject else { return typed.first() }
    typed.find((f) -> takes_receiver(f, s))
}

/// Whether the language itself gives `owner` the member `name`, a static where `statics`: a verb
/// `@std/prelude` declares on a type the language owns, or what a grammar's declaration gives it.
export fn language_gives(engine: QueryEngine, owner: SignedType, name: string, statics: bool) -> bool {
    match owner.head {
        .Owned(word) -> own_verb(
            engine,
            if statics { "verbs/statics/${word}.av" } else { "verbs/${word}.av" },
            name,
            if statics { null } else { owner },
        ) != null,
        .Declared(file, declared) -> statics && FORMAT_STATICS.contains(name) && format_declared(engine, file, declared),
        .Parameter(_, _) or .Unnamed(_) or .Inferred or .Function or .Union or .Never or .Meta -> false,
    }
}

/// Whether a value of `ty` implements the trait `bound` names, applied as `bound` applies it: as an
/// impl says, written or generated, in the type's own package, in `reader`, or in any package
/// `reader` reaches — the whole program a build of `reader` holds. The written impls are asked
/// first: a type one of them answers for runs no generator to say so, and only a type none does asks
/// what the generators made — which a generator may make for a type it doesn't stand on. Absent where `ty` is no declared
/// or owned type known whole, or `bound` names no declared trait.
export fn implements(engine: QueryEngine, reader: string, ty: SignedType, bound: SignedType) -> bool? {
    if ty.nullable() || ty.dynamic || ty.generic() || ty.inferred() { return null }
    let held? = declared_at(bound) else { return null }
    if declaring_item(engine, held.file, held.name, ItemKind.Trait) == null { return null }
    let d? = declared_at(ty) ?? own_declared(ty.owned() ?? "") else { return null }
    let packages = distinct(
        [d.file.package_name, reader].concat(package_reach(engine, reader).packages),
    )
    let answers = (i: FiledImpl) -> i.implements != null &&
        i.implements!.name == held.name &&
        same_file(i.implements!.file, held.file) &&
        applied_alike(impl_trait_args(engine, i.at), bound.args)
    if packages.any((p) -> impls_in(package_impls_part(engine, p, d.name), d.file).any(answers)) { return true }
    packages
        .any((p) -> impls_in(package_generated_impls_part(engine, p, d.name), d.file).any(answers))
}

/// Whether an impl applying its trait to `written` answers a bound applying it to `asked`: each
/// argument the same type, one either leaves to a parameter aside.
fn applied_alike(written: List<SignedType>, asked: List<SignedType>) -> bool {
    asked.is_empty() ||
        written.length == asked.length &&
            (0..asked.length)
                .all(
                    written[it].generic() ||
                        asked[it].generic() ||
                        asked[it].inferred() ||
                        written[it].spelled() == asked[it].spelled(),
                )
}

/// Whether a verb's receiver seat takes a value of `subject`'s type.
fn takes_receiver(verb: SignedType, subject: SignedType) -> bool {
    if verb.seats.is_empty() { return false }
    mut found: Map<string, SignedType> = {}
    verb.seats[0].ty.unifies(subject, found)
}

collect listed_method_facts: List<ListedQuery> = @query_definition in self as ListedQuery { definition: it } by it.name

/// The queries a type's methods read through, for a process to hand its engine.
export fn method_fact_definitions() -> List<QueryDefinition> { definitions_of(listed_method_facts) }

/// The trait declared at `at`.
fn trait_at(at: DeclaredAt) -> TraitAt { TraitAt { file: at.file, name: at.name } }

/// Whether the trait `at` writes a fn `name`, a static where `statics`, else a method.
fn trait_writes(engine: QueryEngine, at: TraitAt, name: string, statics: bool) -> bool {
    let item? = declaring_item(engine, at.file, at.name, ItemKind.Trait) else { return false }
    written_fn(item.store, [f for f in trait_fns(item) if item.store.is_static(f) == statics], name) != null
}

/// The method `s` as a value of `receiver` reaches it: the receiver read, then its own seats.
fn receiver_typed(receiver: SignedType, s: FnSignature) -> SignedType? { fn_typed([read_seat(receiver)], s) }

/// A property of `subject` answering `answer`, as the fn that reads it.
fn property_typed(subject: SignedType, answer: SignedType) -> SignedType {
    headed_type(TypeHead.Function) with { seats: [read_seat(subject)], answer: answer }
}

/// A seat holding a `ty` it only reads.
fn read_seat(ty: SignedType) -> SignedSeat { SignedSeat { ty: ty, mutable: false, settled: false } }

/// The statics of a type's impls in its package, each with every mark it wears.
@derive(Saved)
type MarkedStatics = { statics: List<MarkedStatic> }

/// The statics the type `ty` names has in its package, each with every mark it wears; none for a
/// type the program doesn't declare.
fn statics_marked(engine: QueryEngine, ty: SignedType) -> List<MarkedStatic> {
    let at? = declared_at(ty) else { return [] }
    marked_statics(engine, at.file, at.name).statics
}

/// The statics the type `file` declares as `name` has in its package, written and generated, each
/// with every mark it wears.
@query("summary")
fn marked_statics(engine: QueryEngine, file: SourceFileAddress, name: string) -> MarkedStatics {
    MarkedStatics {
        statics: flatten([impl_marked(engine, i.at) for i in impls_of(engine, file, name)]),
    }
}

/// The statics the impl at `at` writes, each with every mark it wears.
fn impl_marked(engine: QueryEngine, at: ImplAt) -> List<MarkedStatic> {
    let item = read_item(engine, at.file, at.item)
    let store = item.store
    [static_marked(engine, at, store, m, f!.name, a) for s in some_list(impl_stmt_at(item, at)) for m in store.impl_parts(s)?.fns ?? [] if store.is_static(m) for f in [store.fn_parts(m)] if f != null for a in store.annotations_of(m)]
}

/// The static `name`, written as `m`, wearing `a`: the mark's name read where the mark is written —
/// a template's home for a generated static — so the mark is known by the declaration it names.
fn static_marked(
    engine: QueryEngine,
    at: ImplAt,
    store: SyntaxArena,
    m: StmtId,
    name: string,
    a: Annotation,
) -> MarkedStatic {
    let declared = resolved(engine, written_by(store, m) ?? at.file, Space.Value, a.name).named()
    MarkedStatic {
        name: name,
        mark: declared?.name ?? a.name,
        mark_in: declared?.file,
        arg: first_text(store, a.args),
    }
}

/// The text the first of `args` writes, absent where there is none or it writes no text.
fn first_text(store: SyntaxArena, args: List<ExprId>) -> string? {
    let first? = args.first() else { return null }
    store.valued(first).text_of()
}
