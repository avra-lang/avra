//! The hosts a build can stand beside. A host fn names the host that
//! calls it (`@host(Host.Page)`, `@std/meta`); a build exports a
//! dependency's host fn only when its own hosts include that one.

/// Every host a build can have. Each arm is spelled wherever a host is
/// matched, so a new one breaks every reader.
export enum BuildHost {
    Page
}

/// The hosts, in the order a listing names them.
export fn every_host() -> List<BuildHost> { [BuildHost.Page] }

/// The word `@std/meta`'s `Host` spells the host with.
export fn host_word(h: BuildHost) -> string {
    match h { .Page -> "Page" }
}

/// The hosts a build for `target` stands beside: a wasm module is a page's.
export fn hosts_of(target: string) -> List<BuildHost> {
    if target == "" { [] } else { [BuildHost.Page] }
}

/// The host an `@host(…)` argument names, as `Host.Page` is written.
export fn host_named(written: string) -> BuildHost? {
    let word = written.split(".").last() ?? ""
    every_host().find(host_word(it) == word)
}
