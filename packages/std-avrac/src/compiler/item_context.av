//! WHAT AN AVRA ITEM IS READ UNDER: the shapes of the block words its file stands under, worked out
//! through the program layer's own reads. A word's shape is what a parse needs of it and nothing
//! more: the component it names, where that was declared, whether it's the file's own module's,
//! and whether a named instance of it binds its name; a sublanguage's word, with its grammar's
//! notation. Every declaration this reads is read with no words of its own, so working out one
//! file's words never needs another file's words.
use core.{
    template_home,
    Span,
    ComponentWord,
    ExprId,
    Instancing,
    LandedSeat,
    StmtId,
    SyntaxArena,
    distinct,
    flatten,
    fp_str,
    module_path,
}
use compiler.host.{read_manifest}
use diagnostics.{new_source_file}
use features.{BlockGrammar, BlockWords}
use features.components.{binds_name, instanced, word_of}
use grammar.{avra_known_terminals, parse_grammar}
use @std.grammar.{ready}
use @std.meta.{derive}
use @std.path.{dir_of, under_dir}
use @std.text.{parse_int}
use @std.program.address.{DirectoryAddress, SourceFileAddress}
use @std.program.saved_derive.{Saved}
use @std.program.source_facts.{file_context, item_spans, item_tape_saved, listed, source_text}
use @std.program.syntax_tape.{SyntaxTape, tape_about}
use @std.program.query_engine.{QueryDefinition, QueryEngine}
use @std.program.answer_parts.{AnswerParts, NamedValue, answer_parts}
use @std.program.saved_query.{
    cut_parted_query,
    cut_query,
    definitions_of,
    ListedQuery,
    query,
    query_definition,
}

/// A component word as a parse needs it.
@derive(Saved)
export type WordShape = { word: string, declared: string, home: SourceFileAddress, own: bool, binds_name: bool }

/// A named instance a body may list by its name alone, and the component it instances.
@derive(Saved)
export type NamedInstance = { name: string, declared: string }

/// A sublanguage's word, and the notation of the grammar it reads its blocks by.
@derive(Saved)
export type GrammarWord = { word: string, origin: string, notation: string }

/// A sublanguage's word as a parse needs it: where it's declared, and whether its notation reads —
/// a word whose grammar doesn't is no block word.
@derive(Saved)
export type GrammarShape = { word: string, origin: string, reads: bool }

/// The words a file's items read under.
@derive(Saved)
export type WordShapes = { components: List<WordShape>, grammars: List<GrammarShape> }

/// What reading a file's items depends on besides their text: its words' shapes.
export fn avra_context(engine: QueryEngine, file: SourceFileAddress) -> Bytes { word_shapes(engine, file).saved_bytes() }

/// What reading an item depends on when it depends on nothing but its text.
export fn no_context() -> Bytes { WordShapes { components: [], grammars: [] }.saved_bytes() }

impl WordShapes {
    /// What reading `text` depends on of these words: only those it could name. A word it never
    /// spells can't change how it reads, so an item that spells none reads as one with no words.
    fn named_in(text: string) -> Bytes {
        WordShapes {
            components: [c for c in self.components if text.contains(c.word)],
            grammars: [g for g in self.grammars if text.contains(g.word)],
        }
            .saved_bytes()
    }
}

/// One item of a file, and the context it reads under: its file's words it could name; and its
/// text's print where it was made with its file's items. Where it stands in its file is no part of
/// it (`item_start`): an item an edit above only moved reads as it did, and so does every answer
/// worked out of it, each place it holds counted from the item's own start.
@derive(Saved)
export type ItemUnder = { text: string, context: Bytes, print: int? = null }

/// A file's items, each with the context it reads under.
export fn items_under(engine: QueryEngine, file: SourceFileAddress) -> List<ItemUnder> {
    [item_under(engine, file, at) for at in 0..item_count(engine, file)]
}

/// How many items a file has.
@cut_query
export fn item_count(engine: QueryEngine, file: SourceFileAddress) -> int { file_items(engine, file).length }

/// Whether `file` has an item `at`: what an item added or taken away past it leaves standing.
@cut_query
export fn item_held(engine: QueryEngine, file: SourceFileAddress, at: int) -> bool { at < item_count(engine, file) }

/// A file's item `at`, with the context it reads under; past the file's items, no text. A saved
/// answer is asked again with the place it was asked at, which an edit may have taken away.
@cut_query
export fn item_under(engine: QueryEngine, file: SourceFileAddress, at: int) -> ItemUnder {
    let part = item_parts_part(engine, file, text_part(at))
    let item = if part == null { ItemPart { text: "", print: fp_str("") } } else { ItemPart.from_saved_bytes(part!) }
    ItemUnder {
        text: item.text,
        context: WordShapes.from_saved_bytes(file_context(engine, file)).named_in(item.text),
        print: item.print,
    }
}

/// An item of a file apart from where it stands: its text, and the text's print.
@derive(Saved)
type ItemPart = { text: string, print: int }

/// Where an item of a file stands in the file's text: where it starts, and its length.
@derive(Saved)
type ItemStands = { offset: int, length: int }

/// A file's items as parts: each item's text, and apart from it where it starts, so an edit inside
/// one item moves that item's text and the starts after it, and no other item's text.
@cut_parted_query
fn item_parts(engine: QueryEngine, file: SourceFileAddress) -> AnswerParts {
    let items = file_items(engine, file)
    answer_parts(
        [NamedValue {
            name: text_part(at),
            value: ItemPart { text: i.text, print: i.print }.saved_bytes(),
        } for at, i in items]
            .concat(
                [NamedValue {
                    name: start_part(at),
                    value: ItemStands { offset: i.start, length: i.text.length }.saved_bytes(),
                } for at, i in items],
            ),
    )
}

/// The part of `item_parts` holding the item `at`'s text.
fn text_part(at: int) -> string { "t${at}" }

/// The part of `item_parts` holding where the item `at` starts.
fn start_part(at: int) -> string { "s${at}" }

/// The words a parse under `context` reads by, each known by its shape alone.
export fn context_words(context: Bytes) -> BlockWords {
    let shapes = WordShapes.from_saved_bytes(context)
    BlockWords {
        components: [shaped_word(w) for w in shapes.components],
        grammars: [BlockGrammar { word: g.word, ready: null, origin: g.origin } for g in shapes.grammars if g.reads],
    }
}

fn shaped_word(w: WordShape) -> ComponentWord {
    ComponentWord {
        word: w.word,
        declared: w.declared,
        form: Instancing.Shaped(w.binds_name),
        origin: template_home(w.home),
        own: w.own,
    }
}

/// A grammar readied from its notation; absent for one that doesn't parse, whose library speaks.
export fn readied(w: GrammarWord) -> BlockGrammar? {
    let built? = parse_grammar(w.notation).built else { return null }
    BlockGrammar { word: w.word, ready: ready(built, avra_known_terminals()), origin: w.origin }
}

/// A file's words: every component its own module declares, then what each `use` line imports.
fn word_shapes(engine: QueryEngine, file: SourceFileAddress) -> WordShapes {
    let own = [w.shape with { own: true } for w in own_module_words(engine, file)]
    let lines = [line_shapes(engine, file, u) for u in file_words(engine, file).uses]
    WordShapes {
        components: own.concat(flatten([l.components for l in lines])),
        grammars: [GrammarShape {
            word: g.word,
            origin: g.origin,
            reads: parse_grammar(g.notation).built != null,
        } for g in file_grammars(engine, file)],
    }
}

/// The words that open a block in `file`: a component another module declares, and a sublanguage it
/// imports. One answer a file, cut off where it comes out the same.
@cut_query
export fn file_block_words(engine: QueryEngine, file: SourceFileAddress) -> List<string> {
    [c.word for c in word_shapes(engine, file).components if !c.own]
        .concat([g.word for g in file_grammars(engine, file)])
}

/// The sublanguages a file's `use` lines import, each by the word it's imported as.
@query
export fn file_grammars(engine: QueryEngine, file: SourceFileAddress) -> List<GrammarWord> {
    flatten([line_shapes(engine, file, u).grammars for u in file_words(engine, file).uses])
}

/// What a parse keeps of an item for its file's words and its meaning, read without its nodes: the
/// components it declares, the sublanguages it exports, its top-level named instances, its `use`
/// lines, and what it means by besides its text — the word of each instance it holds and each word
/// its blocks wait to be read by, each once in the order met.
@derive(Saved)
type ItemAbout = {
    components: List<ItemComponent>,
    grammars: List<ItemGrammar>,
    instances: List<ItemInstance>,
    uses: List<UseLine>,
    instance_words: List<string>,
    block_words: List<string>,
    impls: List<ItemImpl>,
    /// Whether a statement of the item runs, beside what it declares.
    runs: bool = false,
    /// What each name the item's statements declare or bind wears, each name once.
    worn: List<NameWorn> = [],
}

/// What an item's statements say of one name they declare or bind, each by the first statement of
/// that name: whether one declares it; whether the first that declares it wears an annotation, and
/// is a component with a body; and whether the first that declares or binds it wears one.
@derive(Saved)
type NameWorn = { name: string, declared: bool, marked_declared: bool, marked: bool, bodied_component: bool }

/// What each name the statements `all` of `store` declare or bind wears, each name once, in the order
/// they're met.
fn names_worn(store: SyntaxArena, all: List<StmtId>) -> List<NameWorn> {
    let named = [n! for s in all for n in [store.declared_name(s) ?? store.let_name(s)] if n != null]
    [name_worn(store, all, n) for i, n in named if !named.take(i).contains(n)]
}

/// What `name` wears among the statements `all` of `store`.
fn name_worn(store: SyntaxArena, all: List<StmtId>, name: string) -> NameWorn {
    let declaring = all.find((s) -> store.declared_name(s) == name)
    let binding = all.find((s) -> store.declared_name(s) ?? store.let_name(s) == name)
    NameWorn {
        name: name,
        declared: declaring != null,
        marked_declared: declaring != null && !store.annotations_of(declaring!).is_empty(),
        marked: binding != null && !store.annotations_of(binding!).is_empty(),
        bodied_component: declaring != null && store.component_body(declaring!) != null,
    }
}

/// What the name the written declaration `d` names wears in its item, as its tape says; absent where
/// no statement of the item declares or binds it. Asked only of a written item.
fn worn_in_item(engine: QueryEngine, d: DeclaredName) -> NameWorn? {
    if !item_held(engine, d.file, d.item) { return null }
    item_said(engine, d.file, d.item).worn.find(it.name == d.name)
}

/// An impl an item holds: the type it's for, as written, that type's parameters as the impl names
/// them, the methods and statics it writes, the trait it implements, as written, and where each of
/// the target's and the trait's names reads, for one a generator made.
@derive(Saved)
export type ItemImpl = { target: string, params: List<string>, methods: List<string>, statics: List<string>, implements: string?, target_in: string? = null, trait_in: string? = null }

/// A component an item declares: its name, whether its instance binds a name, whether it's exported.
@derive(Saved)
type ItemComponent = { declared: string, binds_name: bool, exported: bool }

/// A sublanguage an item exports: its word and its grammar's notation.
@derive(Saved)
type ItemGrammar = { word: string, notation: string }

/// A named instance an item makes, and whether it's exported.
@derive(Saved)
type ItemInstance = { name: string, declared: string, exported: bool }

impl ItemInstance {
    /// The instance as a body lists it by name.
    fn listed() -> NamedInstance { NamedInstance { name: self.name, declared: self.declared } }
}

/// What an item's statements say of its file's words, as its tape keeps it.
export fn item_about(store: SyntaxArena, stmts: List<StmtId>) -> Bytes {
    ItemAbout {
        components: [ItemComponent {
            declared: w!.declared,
            binds_name: binds_name(w!),
            exported: store.is_exported(s),
        } for s in stmts for w in [word_of(store, s, "")] if w != null],
        grammars: [ItemGrammar { word: g!.name, notation: g!.text } for s in stmts if store.is_exported(s) for g in [store.syntax_parts(s)] if g != null],
        instances: [ItemInstance { name: i!.name, declared: i!.declared, exported: store.is_exported(s) } for s in stmts for i in [instanced(store, s)] if i != null],
        uses: [UseLine {
            path: u!.path,
            items: u!.items,
            aliases: u!.aliases,
            exported: store.is_exported(s),
        } for s in stmts for u in [store.use_parts(s)] if u != null],
        instance_words: distinct([w! for e in every_expr(store) for w in [store.instance_word(e)] if w != null]),
        block_words: distinct(
            [w! for e in every_expr(store) if store.deferred_block(e) != null for w in [store.expr(e).body_of()?.word] if w != null],
        ),
        impls: [ItemImpl {
            target: p!.target,
            params: [x.of for x in store.impl_tparams_of(s)?.target ?? []],
            methods: [f!.name for m in p!.fns if !store.is_static(m) for f in [store.fn_parts(m)] if f != null],
            statics: [f!.name for m in p!.fns if store.is_static(m) for f in [store.fn_parts(m)] if f != null],
            implements: p!.of,
            target_in: store.seat_home(s, LandedSeat.Target),
            trait_in: store.seat_home(s, LandedSeat.Trait),
        } for s in stmts for p in [store.impl_parts(s)] if p != null]
            .concat(
                [ItemImpl {
                    target: c!.name,
                    params: c!.tparams,
                    methods: [f!.name for m in c!.fns if !store.is_static(m) for f in [store.fn_parts(m)] if f != null],
                    statics: [f!.name for m in c!.fns if store.is_static(m) for f in [store.fn_parts(m)] if f != null],
                    implements: null,
                } for s in stmts for c in [store.component_parts(s)] if c != null],
            ),
        runs: stmts.any((s) -> !store.is_declaration(s)),
        worn: names_worn(store, stmts.concat(store.hoisted_decls())),
    }
        .saved_bytes()
}

fn every_expr(store: SyntaxArena) -> List<ExprId> { [ExprId { index: at } for at in 0..store.exprs.count()] }

/// One item of a file: where its text starts, the text, and the text's print.
@derive(Saved)
export type ItemText = { start: int, text: string, print: int }

/// Where the item `at` of `file` starts in the file's text; past the file's items, at its start.
@cut_query
export fn item_start(engine: QueryEngine, file: SourceFileAddress, at: int) -> int {
    let part = item_parts_part(engine, file, start_part(at))
    if part == null { 0 } else { ItemStands.from_saved_bytes(part!).offset }
}

/// THE ONE PLACE AN ITEM'S OWN PLACE BECOMES ITS FILE'S: `place`, counted from the start of the
/// item `at` of `file`, counted from the file's start instead. Every answer worked out of an item
/// holds its places counted from the item's start; whatever says one in its file says it through
/// here.
export fn file_placed(engine: QueryEngine, file: SourceFileAddress, at: int, place: FindingAt) -> FindingAt {
    let start = item_start(engine, file, at)
    FindingAt { lo: place.lo + start, hi: place.hi + start }
}

/// A place counted from `file`'s start as the item holding it counts it — `file_placed` undone: that
/// item, and the place counted from its start; absent where no item of the file holds it.
export fn placed_in_item(engine: QueryEngine, file: SourceFileAddress, place: FindingAt) -> PlaceInItem? {
    let held? = (0..item_count(engine, file)).find((i: int) -> holds(engine, file, i, place.lo)) else { return null }
    let start = item_start(engine, file, held)
    PlaceInItem { item: held, at: FindingAt { lo: place.lo - start, hi: place.hi - start } }
}

/// A place in a file as an item counts it: the item, and the place from its start.
export type PlaceInItem = { item: int, at: FindingAt }

/// A place crossed into a compile-time run, as its `Loc` spells its file: the file by package and
/// path, then the item `at` whose start the place counts from. A run handed an item at a new place in
/// its file is handed the same places, and is the same run.
export fn item_spelled(file: SourceFileAddress, at: int) -> string { "${spelled_file(file)}${ITEM_MARK}${at}" }

/// The item of `file` a place a run hands back names, by how `item_spelled` spells it; absent for a
/// place of another file, or one spelled otherwise.
export fn spelled_item(file: SourceFileAddress, spelled: string) -> int? {
    let head = "${spelled_file(file)}${ITEM_MARK}"
    if !spelled.starts_with(head) { return null }
    parse_int(spelled.substring(head.length, spelled.length))
}

/// What parts a crossed place's file from the item it counts from.
const ITEM_MARK: string = "#"

/// Whether the text of the item `i` of `file` holds the offset `lo` of the file.
fn holds(engine: QueryEngine, file: SourceFileAddress, i: int, lo: int) -> bool {
    let start = item_start(engine, file, i)
    start <= lo && lo < start + item_under(engine, file, i).text.length
}

/// A span of `item`, read from `file`, counted from the file's start: through `file_placed` where
/// the item counts its places from its own start.
export fn span_in_file(engine: QueryEngine, file: SourceFileAddress, item: ReadItem, span: Span) -> Span {
    let at? = item.at else { return span }
    let placed = file_placed(engine, file, at, FindingAt { lo: span.lo, hi: span.hi })
    Span { lo: placed.lo, hi: placed.hi }
}

/// A file's items (`item_spans`), each as its text; a file with no text has none. Its text is
/// lexed here alone.
@cut_query
export fn file_items(engine: QueryEngine, file: SourceFileAddress) -> List<ItemText> {
    let text? = source_text(engine, file) else { return [] }
    [ItemText { start: span.start, text: t, print: fp_str(t) } for span in item_spans(avra_columns(text), text.length) for t in [text.substring(span.start, span.end)]]
}

/// What each item of a file keeps for its words, read with no words of its own: what an edit inside
/// a body leaves as it was.
@cut_query
fn file_abouts(engine: QueryEngine, file: SourceFileAddress) -> List<ItemAbout> {
    [about_of(tape_about(item_tape_saved(engine, item.text, no_context()))) for item in file_items(engine, file)]
}

/// What the written item `at` of `file` keeps for its file as its meaning's tape says it, read
/// where the tape lies: nothing of the item is read back.
fn item_tape_about(engine: QueryEngine, file: SourceFileAddress, at: int) -> ItemAbout {
    about_of(tape_about(meant_tape(engine, file, item_under(engine, file, at))))
}

/// What a written item's tape says of it that a reader would else read the item back to learn:
/// whether a statement of it runs, and what each name it declares or binds wears.
@derive(Saved)
type ItemSaid = { runs: bool, worn: List<NameWorn> }

/// The names the `use` lines of `file` bind that nothing answers (`refused_imports`), worked out once
/// for the file however many of its items ask.
@query
export fn imports_refused(engine: QueryEngine, file: SourceFileAddress) -> List<string> { refused_imports(engine, file) }

/// What each written item of `file` says of itself, by place: read from each item's tape where it
/// lies, once for the file.
@query
fn file_said_of_items(engine: QueryEngine, file: SourceFileAddress) -> List<ItemSaid> {
    [item_said(engine, file, at) for at in 0..item_count(engine, file)]
}

/// The contexts a program declares: one answer per program, which an edit declaring no context
/// leaves standing.
@derive(Saved)
type ContextsDeclared = { contexts: List<ContextDeclared> }

/// A context a program declares: its key, its name, and whether it is declared with no default.
@derive(Saved)
type ContextDeclared = { key: int, name: string, required: bool }

/// Each context the files of the program `package` reads declare.
@cut_query
fn contexts_declared(engine: QueryEngine, package: string) -> ContextsDeclared { ContextsDeclared { contexts: contexts_of(engine, package) } }

/// What a written item of a file writes that the items after it read: the names its run statements
/// bind, each with whether a write lands in it, and its `use` lines.
@derive(Saved)
type ItemFront = { binds: List<BoundRun>, uses: List<FrontUse> }

/// A name a run statement binds, and whether a write lands in it.
@derive(Saved)
type BoundRun = { name: string, mutable: bool }

/// A `use` line as its item writes it: where it stands in the item, where it does, the path it
/// names, the items it lists and binds, and whether it re-exports them.
@derive(Saved)
type FrontUse = { placed: bool, lo: int, hi: int, path: List<string>, items: List<string>, bound: List<string>, exported: bool }

/// What the written item `at` of `file` writes that the items after it read: one answer per item,
/// which a new body for a fn leaves standing.
@cut_query
fn item_front(engine: QueryEngine, file: SourceFileAddress, at: int) -> ItemFront {
    let item = read_item(engine, file, at)
    ItemFront {
        binds: [BoundRun { name: r.name, mutable: r.mutable } for r in ran_in(item)],
        uses: [FrontUse {
            placed: u.at != null,
            lo: u.at?.lo ?? 0,
            hi: u.at?.hi ?? 0,
            path: u.path,
            items: u.items,
            bound: u.bound,
            exported: u.exported,
        } for u in uses_written(item)],
    }
}

/// What the written item `at` of `file` says of itself: one answer per item, which an edit to
/// another item leaves standing.
@cut_query
fn item_said(engine: QueryEngine, file: SourceFileAddress, at: int) -> ItemSaid {
    let about = item_tape_about(engine, file, at)
    ItemSaid { runs: about.runs, worn: about.worn }
}

fn about_of(octets: Bytes?) -> ItemAbout {
    let held? = octets else {
        return ItemAbout {
            components: [],
            grammars: [],
            instances: [],
            uses: [],
            instance_words: [],
            block_words: [],
            impls: [],
        }
    }
    ItemAbout.from_saved_bytes(held)
}

/// The impls each item of a file holds, by the item's place, read off their headers: its written
/// items', then its generated items'.
export fn file_impls(engine: QueryEngine, file: SourceFileAddress) -> List<List<ItemImpl>> {
    written_impls(engine, file).concat(generated_impls(engine, file))
}

/// The impls the written item `at` of `file` holds, read off its own header alone.
fn item_impls(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<ItemImpl> {
    about_of(tape_about(item_tape_saved(engine, item_under(engine, file, at).text, no_context())))
        .impls
}

/// The impls each written item of a file holds, by the item's place.
fn written_impls(engine: QueryEngine, file: SourceFileAddress) -> List<List<ItemImpl>> { [a.impls for a in file_abouts(engine, file)] }

/// The impls the written item `at` of `file` holds, read from that item's tape alone; none past the
/// file's items, which a question kept from an older state of the file may name.
fn item_written_impls(engine: QueryEngine, file: SourceFileAddress, at: int) -> List<ItemImpl> {
    if at < 0 || !item_held(engine, file, at) { return [] }
    about_of(tape_about(item_tape_saved(engine, item_under(engine, file, at).text, no_context())))
        .impls
}

/// The impls each generated item of a file holds, in the order made.
fn generated_impls(engine: QueryEngine, file: SourceFileAddress) -> List<List<ItemImpl>> { [a.impls for a in generated_abouts(engine, file)] }

/// What a file declares of block words and imports: every component it declares, each saying
/// whether it's exported, the sublanguages and named instances it exports, and its `use` lines.
@derive(Saved)
type FileWords = { components: List<DeclaredWord>, grammars: List<GrammarWord>, instances: List<NamedInstance>, uses: List<UseLine> }

/// A component a file declares, whether it exports it, and which of the file's items declares it.
@derive(Saved)
export type DeclaredWord = { shape: WordShape, exported: bool, item: int }

/// A `use` line: the module path, the names it imports, each one's alias ("" for none), and whether
/// it re-exports them.
@derive(Saved)
type UseLine = { path: List<string>, items: List<string>, aliases: List<string>, exported: bool = false }

impl UseLine {
    /// The name item `j` is imported under.
    fn bound_as(j: int) -> string { if self.aliases[j].is_empty() { self.items[j] } else { self.aliases[j] } }
}

/// What a file declares of block words and imports, read once, off its items' tapes.
@query
fn file_words(engine: QueryEngine, file: SourceFileAddress) -> FileWords {
    let abouts = file_abouts(engine, file)
    FileWords {
        components: [DeclaredWord {
            shape: WordShape {
                word: c.declared,
                declared: c.declared,
                home: file,
                own: false,
                binds_name: c.binds_name,
            },
            exported: c.exported,
            item: at,
        } for at, a in abouts for c in a.components],
        grammars: [GrammarWord { word: g.word, origin: template_home(file), notation: g.notation } for a in abouts for g in a.grammars],
        instances: [i.listed() for a in abouts for i in a.instances if i.exported],
        uses: [u for a in abouts for u in a.uses],
    }
}

/// The modules a file's `use` lines name, each as written, dotted.
export fn file_imports(engine: QueryEngine, file: SourceFileAddress) -> List<string> { [u.path.join(".") for u in file_words(engine, file).uses] }

/// A file as a component word's origin names it: its package, then its path.
export fn spelled_file(file: SourceFileAddress) -> string { "${file.package_name}/${file.path_in_package}" }

/// What one `use` line imports of block words.
type LineShapes = { components: List<WordShape>, grammars: List<GrammarWord>, instances: List<NamedInstance> }

/// The module a `use` line names, as a file reads it: its package, its path there, and whether it's
/// read as its package's own. Absent for a malformed path, the file's own module, a package the
/// file's doesn't reach, or a module that is both a directory and a file.
type ModuleAt = { package: string, local: List<string>, as_root: bool }

fn imported_module(engine: QueryEngine, file: SourceFileAddress, u: UseLine) -> ModuleAt? {
    let m = module_path(u.path)
    if m.malformed() { return null }
    let provider = m.package() ?? file.package_name
    if provider == file.package_name && m.local().join(".") == module_segments(file).join(".") { return null }
    if !reaches(engine, file.package_name, provider) || two_modules(engine, provider, m.local()) { return null }
    ModuleAt { package: provider, local: m.local(), as_root: provider == file.package_name }
}

/// Whether a module's name is both a directory and a file: a `use` of it names neither.
fn two_modules(engine: QueryEngine, package: string, local: List<string>) -> bool {
    let dir = module_dir(local)
    dir_listed(engine, package, dir) != null && source_text(engine, dir_file(package, dir)) != null
}

fn line_shapes(engine: QueryEngine, file: SourceFileAddress, u: UseLine) -> LineShapes {
    let none = LineShapes { components: [], grammars: [], instances: [] }
    let at? = imported_module(engine, file, u) else { return none }
    let exports = module_exports(engine, at.package, at.local, at.as_root)
    LineShapes {
        components: [c with { word: u.bound_as(j) } for j, item in u.items for c in exports.components.get(item) ?? []],
        grammars: [g with { word: u.bound_as(j) } for j, item in u.items for g in exports.grammars.get(item) ?? []],
        instances: [i with { name: u.bound_as(j) } for j, item in u.items for i in exports.instances.get(item) ?? []],
    }
}

/// The named instances a file's bodies may list by name alone: its own top-level ones, read off its
/// tokens against its words, then those each `use` line imports.
@cut_query
export fn file_instances(engine: QueryEngine, file: SourceFileAddress) -> List<NamedInstance> {
    let own = [i.listed() for item in items_under(engine, file) for i in about_of(tape_about(item_tape_saved(engine, item.text, item.context))).instances]
    own
        .concat([i for u in file_words(engine, file).uses for i in line_shapes(engine, file, u).instances])
}

/// The module a file stands in: its directory's path under its package's `src`.
fn module_segments(file: SourceFileAddress) -> List<string> {
    let dir = dir_of(file.path_in_package)
    if dir == SOURCE_ROOT { return [] }
    if !dir.starts_with("${SOURCE_ROOT}/") { return [dir] }
    dir.substring(SOURCE_ROOT.length + 1, dir.length).split("/")
}

/// Where a package's modules stand.
const SOURCE_ROOT: string = "src"

/// Every component a file's own module declares: its own, then each other file's in its
/// directory, a program's among them.
fn own_module_words(engine: QueryEngine, file: SourceFileAddress) -> List<DeclaredWord> {
    let module = module_declared(engine, file.package_name, module_segments(file))
    file_words(engine, file)
        .components
        .concat([w for w in module.components if w.shape.home.path_in_package != file.path_in_package])
}

/// What a module's files declare of block words, read once, in listing order: every component,
/// and the files that declare them.
@derive(Saved)
type ModuleWords = { files: List<string>, components: List<DeclaredWord> }

@cut_query
fn module_declared(engine: QueryEngine, package: string, local: List<string>) -> ModuleWords {
    let files = module_files(engine, package, local, true)
    ModuleWords {
        files: [f.path_in_package for f in files],
        components: [w for f in files for w in file_words(engine, f).components],
    }
}

/// What a module exports of block words, each kept by the name a `use` line imports it by.
@derive(Saved)
type ModuleExports = {
    components: Map<string, List<WordShape>>,
    grammars: Map<string, List<GrammarWord>>,
    instances: Map<string, List<NamedInstance>>,
}

@query
fn module_exports(engine: QueryEngine, package: string, local: List<string>, as_root: bool) -> ModuleExports {
    let files = module_files(engine, package, local, as_root)
    mut components: Map<string, List<WordShape>> = {}
    mut grammars: Map<string, List<GrammarWord>> = {}
    mut instances: Map<string, List<NamedInstance>> = {}
    for f in files {
        let words = file_words(engine, f)
        for w in words.components {
            if w.exported {
                components
                    .set(w.shape.declared, (components.get(w.shape.declared) ?? []).concat([w.shape]))
            }
        }
        for g in words.grammars { grammars.set(g.word, (grammars.get(g.word) ?? []).concat([g])) }
        for i in words.instances { instances.set(i.name, (instances.get(i.name) ?? []).concat([i])) }
    }
    ModuleExports { components: components, grammars: grammars, instances: instances }
}

/// Every source the package `package` holds as the root of its own program, under `src`: what its
/// manifest excludes left out, a nested package's never reached.
export fn root_sources(engine: QueryEngine, package: string) -> List<string> {
    let manifest = package_facts(engine, package)
    [p for p in package_sources(engine, package, SOURCE_ROOT) if listed_in(manifest, true, p)]
}

/// A module's files: its directory's sources, or the one file named for it, never through a
/// package nested inside, never a file its manifest excludes, and a dependency's own program
/// left out.
fn module_files(engine: QueryEngine, package: string, local: List<string>, as_root: bool) -> List<
    SourceFileAddress,
> {
    if crosses_package(engine, package, local) { return [] }
    let dir = module_dir(local)
    let manifest = package_facts(engine, package)
    let entries = dir_listed(engine, package, dir)
    if entries != null {
        return [SourceFileAddress { package_name: package, path_in_package: "${dir}/${name}" } for name in entries! if name.ends_with(".av") && listed_in(manifest, as_root, "${dir}/${name}")]
    }
    let file = dir_file(package, dir)
    if source_text(engine, file) == null { [] } else { [file] }
}

/// What the directory `dir` of `package` lists; absent where it isn't one.
fn dir_listed(engine: QueryEngine, package: string, dir: string) -> List<string>? {
    listed(engine, DirectoryAddress { package_name: package, path_in_package: dir })
}

/// The file a module named for the directory `dir` of `package` would be.
fn dir_file(package: string, dir: string) -> SourceFileAddress { source_at(package, "${dir}.av") }

fn module_dir(local: List<string>) -> string { if local.is_empty() { SOURCE_ROOT } else { "${SOURCE_ROOT}/${local.join("/")}" } }

/// Whether any directory along a module's path is a package of its own.
fn crosses_package(engine: QueryEngine, package: string, local: List<string>) -> bool {
    (1..local.length + 1).any((j) -> holds_manifest(engine, package, module_dir(local.take(j))))
}

/// Whether a manifest roots `package`: a lone source's package of one holds none.
fn rooted(engine: QueryEngine, package: string) -> bool { holds_manifest(engine, package, "") }

/// Whether the directory `dir` of `package` holds a manifest. A cut: a directory's listing moves
/// whenever a build writes beside its sources — `build/` and `.avra-cache` at a package's root, a
/// program test's binary beside its source — and what reads this asks only whether the manifest
/// stands there.
@cut_query
fn holds_manifest(engine: QueryEngine, package: string, dir: string) -> bool {
    (dir_listed(engine, package, dir) ?? []).contains(MANIFEST)
}

const MANIFEST: string = "avra.toml"

/// Whether a source belongs to its module's listing: not excluded, and not a dependency's own
/// program.
fn listed_in(manifest: PackageFacts, as_root: bool, path: string) -> bool {
    if manifest.excludes.any(under_dir(path, it) || path == it) { return false }
    let bin? = manifest.bin else { return true }
    as_root || path != bin || manifest.lib == bin
}

/// What a package's manifest says of where its modules stand and whom it reads: what it excludes,
/// its program, its library, and the packages it depends on. A package with no manifest says none.
@derive(Saved)
type PackageFacts = { excludes: List<string>, bin: string?, lib: string?, depends_on: List<string> }

@query
fn package_facts(engine: QueryEngine, package: string) -> PackageFacts {
    let text? = source_text(
        engine,
        SourceFileAddress { package_name: package, path_in_package: MANIFEST },
    ) else {
        return PackageFacts { excludes: [], bin: null, lib: null, depends_on: [] }
    }
    let m = read_manifest(new_source_file(MANIFEST, text))
    PackageFacts {
        excludes: m.excludes,
        bin: m.bin,
        lib: m.lib,
        depends_on: [d.key for d in m.deps],
    }
}

/// Whether a package may read another's modules: itself, the toolchain's own, or one its manifest
/// depends on.
fn reaches(engine: QueryEngine, from: string, to: string) -> bool {
    if to == from { return true }
    if to.starts_with("@std/") { return listed(engine, DirectoryAddress { package_name: to, path_in_package: "" }) != null }
    package_facts(engine, from).depends_on.contains(to)
}

collect listed_context_facts: List<ListedQuery> = @query_definition in self as ListedQuery { definition: it } by it.name

/// The queries Avra's context reads through, for a process to hand its engine beside the source
/// facts.
export fn context_fact_definitions() -> List<QueryDefinition> { definitions_of(listed_context_facts) }
