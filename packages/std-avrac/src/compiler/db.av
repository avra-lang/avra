//! THE DB — every heterogeneous durable thing the compiler can answer
//! about a package, addressed by kind and name. An in-memory hit
//! answers within this process at once; a durable hit is re-validated
//! against the package's CURRENT state before it is trusted, so a
//! stale answer is never returned; a miss is the caller's to derive
//! and `insert`.
//!
//! NAMED `DbRow`/`DbKind`, NEVER `Row`/`Kind`: `compiler/record.av`
//! and `compiler/voices.av` already declare their own, unrelated
//! `Row` — `compiler/` is one module, so a same-named export here
//! would silently shadow theirs rather than refuse to compile.
//!
//! DECL CARRIES THE ORIGINAL PHASE 1 WITNESS DESIGN: `avra docs
//! <name>`'s answer validity rests on two witnesses recorded at
//! capture time, the package's FILE LISTING and the CONTENT of every
//! file the answer read — not yet the general recorded-dependency
//! walk a RESOLVED-type answer would need.
//!
//! SIG AND WARN CARRY WHAT `record.av`/`derive.av`'s `checked()` ALREADY
//! PRODUCE, VERBATIM: a module's record and a program's rendered
//! warnings are already-serialized text by the time either reaches
//! here, so their row is the text itself — no codec to write or
//! derive, the wire format IS the value.
use core.{digest_of, joined, sorted_texts, flatten, wire_escape, wire_unescape}
use compiler.store.{Store, Stored, node_key}
use diagnostics.{SourceFile}
use compiler.lower.{Unit}
use @std.io.{list_dir, is_dir, read_text}
use @std.path.{joined_path}
use @std.text.{parse_int}
use @std.meta.{derive}

/// A file an answer's validity rides on: its path, and its content's
/// digest at the moment the answer was captured.
export type FileWitness = { path: string, digest: string }

fn encoded_filewitness(w: FileWitness) -> string {
    joined([wire_escape(w.path), wire_escape(w.digest)], "\n")
}

fn decoded_filewitness(text: string) -> FileWitness? {
    let lines = text.split("\n")
    if lines.length < 2 { return null }
    FileWitness { path: wire_unescape(lines[0]), digest: wire_unescape(lines[1]) }
}

/// `avra docs <name>`'s own answer for one package: the rendered text
/// (a decl's doc and annotations, or the collision message when more
/// than one declaration wears the name), and what says it is still true
/// — the package's own root (`still_valid` has nothing else to re-walk
/// from), its file LISTING at capture time, and every file the answer
/// read.
///
/// EVERY FIELD IS ONE ESCAPED LINE, the list is a count line then that
/// many escaped, doubly-escaped (its own encoding, then the line
/// escape) items — `core/wire.av`'s primitives, so any field, not only
/// a trailing one, may hold embedded newlines safely.
export type DocFacts = {
    root: string,
    listing_digest: string,
    answer: string,
    files: List<FileWitness>,
}

export fn encoded_docfacts(facts: DocFacts) -> string {
    let header = [wire_escape(facts.root), wire_escape(facts.listing_digest), wire_escape(facts.answer), "${facts.files.length}"]
    joined(header.concat([wire_escape(encoded_filewitness(w)) for w in facts.files]), "\n")
}

export fn decoded_docfacts(text: string) -> DocFacts? {
    let lines = text.split("\n")
    if lines.length < 4 { return null }
    let count? = parse_int(lines[3]) else { return null }
    if lines.length < 4 + count { return null }
    let files_opt = [decoded_filewitness(wire_unescape(lines[4 + j])) for j in 0..count]
    if files_opt.any(it == null) { return null }
    DocFacts {
        root: wire_unescape(lines[0]),
        listing_digest: wire_unescape(lines[1]),
        answer: wire_unescape(lines[2]),
        files: [f! for f in files_opt],
    }
}

/// A COMPILE'S OWN IN-MEMORY STAGES — never durable, never string-keyed,
/// dying with the `Workspace` that computed them. `DbRow` (below) answers
/// "give me this fact by NAME, valid across processes"; `Stage` answers
/// "give me this fact by the dense (family, arg) key `Kernel` already
/// tracks" — the value a `Memo<T>` holds, with `T` now ONE shared enum
/// instead of one bespoke type per family, so every stage's cached value
/// is read the same way. Kept a SEPARATE enum from `DbRow` on purpose: a
/// durable row's identity is a string a fresh process can ask for before
/// anything else exists; a stage's identity is a `DeclId`/`FileId` that
/// only exists inside a live compile — forcing them into one enum with
/// one `key() -> string` method would be the same false unification the
/// Obj/Bin file-path shape already refused for the durable side.
///
/// RECORDED TRIGGER: only three of `Workspace`'s families are folded in
/// here (`Source`, `Parsed`, `Lowered`) — proof the pattern holds for an
/// INPUT (`Source`), a plain derived query (`Parsed`), and a RECURSIVE
/// one (`Lowered`, which re-enters itself for specializations). The
/// other ~17 families (`Items`, `Namespace`, `Typed`, `Analysis`, ...)
/// are NOT migrated: several carry extra side-tables beyond a single
/// value (`Methods` has `sig_voices`/`method_clashes` alongside it) and
/// `Sig`'s own in-memory answer already lives in `Decls.sigs`, not a
/// `Memo` at all — each needs its own look before folding in, not a
/// mechanical sweep. `Workspace.db` stays `Kernel`-typed until every
/// family shares `Stage`; renaming it to `Db` is a final, purely
/// mechanical step, not something safe to do with 17 families still
/// on their own bespoke types.
export enum Stage {
    Source(SourceFile)
    Parsed(Parsed)
    Lowered(Unit)
}

extern fn avra_trap(message: string)

/// A `Stage` read as the ONE variant its caller's own family can ever
/// mint — a wrong variant reaching here is a defect the `Memo` layer
/// already prevents by construction (one `Memo<Stage>` per family, one
/// variant minted per family), so this is a belt, never a guess.
fn source_of(s: Stage) -> SourceFile {
    match s {
        .Source(v) -> v,
        _ -> {
            avra_trap("defect: Stage.Source expected")
            source_of(s)
        },
    }
}

fn parsed_of(s: Stage) -> Parsed {
    match s {
        .Parsed(v) -> v,
        _ -> {
            avra_trap("defect: Stage.Parsed expected")
            parsed_of(s)
        },
    }
}

fn lowered_of(s: Stage) -> Unit {
    match s {
        .Lowered(v) -> v,
        _ -> {
            avra_trap("defect: Stage.Lowered expected")
            lowered_of(s)
        },
    }
}

export enum DbKind { Decl, Sig, Warn }

impl DbKind {
    fn tag() -> string {
        match self {
            .Decl -> "Decl",
            .Sig -> "Sig",
            .Warn -> "Warn",
        }
    }
}

@derive(Rows)
export enum DbRow {
    /// `avra docs <name>` — witness-validated, see `DocFacts`.
    Decl(name: string, facts: DocFacts)
    /// A module's interface record (`record.av`) — already flat,
    /// structurally-encoded text; validity is record.av's own
    /// business (a moved-records retry), not this row's.
    Sig(name: string, text: string)
    /// A program's rendered warnings (`derive.av`'s `checked()`) —
    /// already-rendered text, kept under the program's own key.
    Warn(name: string, text: string)
}

impl DbRow {
    fn kind() -> DbKind {
        match self {
            .Decl(_, _) -> DbKind.Decl,
            .Sig(_, _) -> DbKind.Sig,
            .Warn(_, _) -> DbKind.Warn,
        }
    }

    fn key() -> string {
        match self { .Decl(name, _) or .Sig(name, _) or .Warn(name, _) -> name }
    }
}

/// One process's rows, in memory. `once`: every caller in this process
/// shares the same answers, the way every other process-wide table does.
export type Db = { rows: Map<string, DbRow> }

export once fn db() -> Db { Db { rows: {} } }

/// A row's name, over the package it belongs to — every `DbRow` key is
/// one package's alone, and two packages never share a row by
/// coincidence of a bare name colliding.
export fn db_qualified(root: string, name: string) -> string { "${root}::${name}" }

fn index_key(kind: DbKind, name: string) -> string { "${kind.tag()}\t${name}" }

impl Db {
    /// The row under `kind`/`name` — this process's own answer when it has
    /// one, else a durable one once its witnesses still hold, else
    /// nothing.
    fn get(store: Store, kind: DbKind, name: string) -> DbRow? {
        let k = index_key(kind, name)
        let hit: DbRow? = self.rows.get(k)
        if hit != null { return hit }
        let found? = self.recalled(store, kind, name) else { return null }
        self.rows.set(k, found)
        found
    }

    /// A row, remembered for the rest of this process AND for every
    /// process after it.
    fn insert(store: Store, row: DbRow) {
        self.rows.set(index_key(row.kind(), row.key()), row)
        let _ = store.keep(Stored.Rows, durable_key(row.kind(), row.key()), encoded(row), [])
    }

    fn recalled(store: Store, kind: DbKind, name: string) -> DbRow? {
        let text? = store.get(Stored.Rows, durable_key(kind, name)) else { return null }
        let row? = decoded(kind, name, text) else { return null }
        if !still_valid(row) { return null }
        row
    }
}

fn durable_key(kind: DbKind, name: string) -> string { node_key(Stored.Rows, [kind.tag(), name]) }

/// Whether a recalled row's witnesses still hold. `Sig`/`Warn` carry
/// their own validity in the caller's key (a module/program identity
/// that changes when its inputs do) and hold unconditionally here;
/// `Decl` alone has a witness pair to re-check.
fn still_valid(row: DbRow) -> bool {
    match row {
        .Decl(_, facts) -> facts.listing_digest == current_listing_digest(facts.root) && facts.files.all((w: FileWitness) -> current_file_digest(w.path) == w.digest),
        .Sig(_, _) or .Warn(_, _) -> true,
    }
}

/// A package's own `.av` files, sorted and folded to one digest — a file
/// added or removed anywhere moves it, however far from any file a
/// cached answer already read.
export fn current_listing_digest(root: string) -> string {
    let dir = if is_dir(joined_path(root, "src")) { joined_path(root, "src") } else { root }
    digest_of(joined(sorted_texts(av_files(dir)), "\n"))
}

fn av_files(dir: string) -> List<string> {
    flatten([av_files_at(dir, f) for f in list_dir(dir) catch []])
}

fn av_files_at(dir: string, name: string) -> List<string> {
    let full = joined_path(dir, name)
    when {
        is_dir(full) -> av_files(full)
        name.ends_with(".av") -> [full]
        _ -> []
    }
}

/// A file's own current content, digested — absent as "".
export fn current_file_digest(path: string) -> string {
    digest_of(read_text(path) catch "")
}

/// `Decl` folds through `encoded_docfacts` (core/wire.av's escaping
/// primitives); `Sig`/`Warn` are already text, so encoding them is
/// identity — the wire format IS the value, not a second copy of it.
fn encoded(row: DbRow) -> string {
    match row { .Decl(_, facts) -> encoded_docfacts(facts), .Sig(_, text) or .Warn(_, text) -> text }
}

fn decoded(kind: DbKind, name: string, text: string) -> DbRow? {
    match kind {
        .Decl -> {
            let facts? = decoded_docfacts(text) else { return null }
            DbRow.Decl(name, facts)
        },
        .Sig -> DbRow.Sig(name, text),
        .Warn -> DbRow.Warn(name, text),
    }
}
