/// One `Workspace`'s rows, in memory, plus the `Kernel` handle every
/// dense family's `Relation<DbRow>` was built over — held, not merged, so
/// `Workspace.db` reads as one type while the engine still exports the
/// only `Kernel` there is. `rows` is a `Cell`, an IDENTITY: `Db` is a
/// struct a caller may hold in a fresh local, but every copy still
/// writes the same table, so no caller reads a fork of the cache it
/// just inserted into.
///
/// `families` is EVERY dense family's own value table, ONE per
/// registered family, addressed by its ordinal — never a name, never a
/// scan (CLAUDE.md's dense-addressing rule). `Db.family` grows it in
/// lockstep with the Kernel's own verifier list, so a family's ordinal
/// indexes both; a family with no cached value (`Sig`, `Methods`,
/// `Receivers`, `References`, `Failures`, `HeldSig` — their answers
/// live elsewhere, or run through the Kernel's verbs directly) still
/// gets a slot, just an empty one.
@identity
export type Db = { kernel: Kernel, rows: Cell<Map<string, DbRow>>, families: Cell<List<Relation<DbRow>>>, read_by: Cell<Turned?> }

export fn new_db(kernel: Kernel) -> Db {
    let no_families: List<Relation<DbRow>> = []
    let unturned: Turned? = null
    Db {
        kernel: kernel,
        rows: map_cell(),
        families: Cell.new(no_families),
        read_by: Cell.new(unturned),
    }
}

/// A settled cell: its key, and its answer's digest — none for an answer the
/// kernel never digested.
export type CellRow = { key: Key, digest: int? }

/// A key no settled cell stands at.
const UNPLACED: int = 0

/// THE GRAPH, TURNED ROUND: each settled cell's place, one past its rank in
/// key order, and every cell's readers as packed keys in one run — the
/// readers of the cell ranked `i` stand from `from[i]` up to `from[i + 1]`.
type Turned = { place: KeyMarks, from: List<int>, readers: List<int> }

/// Every edge filed under the cell it reads: counted, then placed.
fn turned_round(kernel: Kernel) -> Turned {
    let keys = kernel.settled_keys()
    let place = no_key_marks()
    for i, k in keys { place.mark(k, i + 1) }
    let none: List<int> = []
    let cells = keys.length
    let read = Cell.new([0 for _k in 0..cells])
    for k in keys {
        for e in kernel.edges_of(k) ?? none {
            let at = place.mark_of(key_of(e))
            if at != UNPLACED { read.set_at(at - 1, read.get()[at - 1] + 1) }
        }
    }
    mut from = [0]
    for n in read.get() { from.push((from.last() ?? 0) + n) }
    let next = Cell.new(from)
    let readers = Cell.new([0 for _k in 0..from[cells]])
    for k in keys {
        for e in kernel.edges_of(k) ?? none {
            let at = place.mark_of(key_of(e))
            if at != UNPLACED {
                let seat = next.get()[at - 1]
                readers.set_at(seat, edge_of(k))
                next.set_at(at - 1, seat + 1)
            }
        }
    }
    Turned { place: place, from: from, readers: readers.get() }
}

/// A `Db` for a caller with no `Workspace` to read one from — the
/// docs fast path (`avra docs <name>`) answers from the durable store
/// alone, deliberately before a `Workspace` is built, so it mints its
/// own kernel rather than waiting on one.
export fn fresh_db() -> Db { new_db(watched_kernel()) }

/// A row's name, over the package it belongs to and the compiler that
/// answered it — two packages never share a row by coincidence of a bare
/// name colliding, and two compiler generations never share one by
/// coincidence of a bare package colliding: `avra docs`'s answer is this
/// compiler's rendering of the source, and a later compiler's rendering
/// may disagree with no file having moved at all.
export fn db_qualified(root: string, compiler: string, name: string) -> string { "${root}::${compiler}::${name}" }

fn index_key(kind: DbKind, name: string) -> string { "${kind.tag()}\t${name}" }

impl Db {
    /// The row under `kind`/`name` — this process's own answer when it has
    /// one, else a durable one once its witnesses still hold, else
    /// nothing.
    fn get(store: Store, kind: DbKind, name: string) -> DbRow? {
        let k = index_key(kind, name)
        let hit: DbRow? = self.rows.get().get(k)
        if hit != null { return hit }
        let found? = self.recalled(store, kind, name) else { return null }
        self.rows.put(k, found)
        found
    }

    /// A row, remembered for the rest of this process AND for every
    /// process after it.
    fn insert(store: Store, row: DbRow) {
        self.rows.put(index_key(row.kind(), row.key()), row)
        let _ = store
            .keep(durable_family(row.kind()), durable_key(row.kind(), row.key()), encoded(row), [])
    }

    fn recalled(store: Store, kind: DbKind, name: string) -> DbRow? {
        let found = self.recalled_row(store, kind, name)
        if traced() { qtrace("Q\tdb\t${if found == null { "miss" } else { "hit" }}\t${kind.tag()}\n") }
        found
    }

    fn recalled_row(store: Store, kind: DbKind, name: string) -> DbRow? {
        let text? = store.get(durable_family(kind), durable_key(kind, name)) else { return null }
        let row? = decoded(kind, name, text) else { return null }
        row
    }

    /// The `Kernel` verbs a `Workspace` calls directly (`self.db.ask(...)`
    /// and its siblings) — forwarded verbatim so every such call site
    /// reads `Db` as if it always answered these itself.
    fn ask(key: Key) -> KernelVerdict { self.kernel.ask(key) }

    fn begin(key: Key) { self.kernel.begin(key) }

    fn settle(key: Key, value_hash: int) { self.kernel.settle(key, value_hash) }

    fn abandon(key: Key) { self.kernel.abandon(key) }

    fn record_dep(key: Key) { self.kernel.record_dep(key) }

    // THE GRAPH, READ: the kernel's cells and edges as two relations would
    // answer them — `Cell(key, digest)` by its key and by its family,
    // `Edge(reader, read)` by either end. Every inspection is a fold over
    // these four reads and reaches no further into the kernel.

    /// Cell by key: the settled cell at `key`, none for a key never settled.
    fn cell(key: Key) -> CellRow? {
        if self.kernel.edges_of(key) == null { return null }
        CellRow { key: key, digest: self.kernel.value_hash_of(key) }
    }

    /// Cell by family: every settled cell, family by family, in key order.
    fn cells_by_family() -> List<List<CellRow>> {
        mut families: List<List<CellRow>> = []
        mut run: List<CellRow> = []
        for k in self.kernel.settled_keys() {
            while families.length < k.family {
                families.push(run)
                run = []
            }
            run.push(CellRow { key: k, digest: self.kernel.value_hash_of(k) })
        }
        if run.is_empty() { families } else { families.concat([run]) }
    }

    /// Edge by reader: what `key`'s cell read, in the order it first read them.
    fn edges_by_reader(key: Key) -> List<Key> { self.kernel.deps_of(key) }

    /// Edge by read: the cells that read `key`'s directly, in key order —
    /// over the graph as it stood when this was first asked.
    fn edges_by_read(key: Key) -> List<Key> {
        let turned = self.turned()
        let at = turned.place.mark_of(key)
        if at == UNPLACED { return [] }
        [key_of(e) for e in turned.readers.slice(turned.from[at - 1], turned.from[at])]
    }

    /// The graph turned round, turned once.
    fn turned() -> Turned {
        let known? = self.read_by.get() else {
            let turned = turned_round(self.kernel)
            self.read_by.set(turned)
            return turned
        }
        known
    }

    fn value_hash_of(key: Key) -> int? { self.kernel.value_hash_of(key) }

    /// Registers a new dense family: a Kernel verifier AND its own
    /// value table, minted together so a family's ordinal indexes both
    /// — `families` never grows out of step with the Kernel's own
    /// verifier list. The verifier is set through the kernel's
    /// `by_dispatch` before families register.
    fn family() -> int {
        let ordinal = self.kernel.family()
        self.families.push(new_memo<DbRow>(self.kernel, ordinal))
        ordinal
    }

    /// A registered family's own dense value table — one list index,
    /// never a name and never a scan.
    fn relation(ordinal: int) -> Relation<DbRow> { self.families.get()[ordinal] }

    fn family_active(family: int) -> bool { self.kernel.family_active(family) }

    fn revision() -> int { self.kernel.revision() }

    fn active(key: Key) -> bool { self.kernel.active(key) }

    fn changed_at(key: Key) -> int { self.kernel.changed_at(key) }

    fn disarm() { self.kernel.disarm() }

    fn stats() -> string { self.kernel.stats() }
}

fn durable_key(kind: DbKind, name: string) -> string { node_key(durable_family(kind), [kind.tag(), name]) }

/// The family a durable row is filed in: a module's interface record has a producer of its
/// own, every other kind the compiler's.
fn durable_family(kind: DbKind) -> Stored { match kind { .Sig -> Stored.Sig, rest -> Stored.Rows } }

/// A package's own `.av` files, sorted and folded to one digest — a file
/// added or removed anywhere moves it, however far from any file a
/// cached answer already read.
export fn current_listing_digest(root: string) -> string {
    // LICENSED input.saved_read: the file set a saved answer's witness stands on, asked to judge it
    let dir = if is_dir(joined_path(root, "src")) { joined_path(root, "src") } else { root }
    digest_of(joined(sorted_texts(av_files(dir)), "\n"))
}

fn av_files(dir: string) -> List<string> {
    // LICENSED input.saved_read: the file set a saved answer's witness stands on, listed to judge it
    flatten([av_files_at(dir, f) for f in list_dir(dir) catch []])
}

fn av_files_at(dir: string, name: string) -> List<string> {
    let full = joined_path(dir, name)
    when {
        // LICENSED input.saved_read: the file set a saved answer's witness stands on, judged one entry at a time
        is_dir(full) -> av_files(full)
        name.ends_with(".av") -> [full]
        _ -> []
    }
}

/// The directory holding the manifest that a source file belongs to: the nearest
/// ancestor with an `avra.toml`, absent when none stands above it.
export fn package_root_of(path: string) -> string? { manifest_above(dir_of(path)) }

fn manifest_above(dir: string) -> string? {
    // LICENSED input.saved_read: a manifest's presence, asked to name the package a saved read stands under
    if exists(joined_path(dir, "avra.toml")) { return dir }
    let up = dir_of(dir)
    if up == dir || up.is_empty() { null } else { manifest_above(up) }
}

/// What a saved answer's read stands at now: a directory by its listing, a file by
/// its bytes. A path that cannot be read has no digest.
export fn current_read_digest(path: string) -> string? {
    // LICENSED input.saved_read: what a saved answer's read stands at now, asked to judge it
    if is_dir(path) { current_listing_digest(path) } else { current_file_digest(path) }
}

/// A file's own current content, digested — absent as "".
export fn current_file_digest(path: string) -> string? {
    // LICENSED input.saved_read: a file's bytes, digested to judge a saved answer's read
    match read_text(path) { .Ok(text) -> digest_of(text), .Err(_) -> null }
}

/// Every durable row is already text, so encoding it is
/// identity — the wire format IS the value, not a second copy of it.
/// Only the durable kinds are ever encoded — `insert`'s durable
/// half is never reached for a dense variant.
fn encoded(row: DbRow) -> string {
    match row {
        .Sig(_, text) or .Answer(_, text) -> text,
        rest -> {
            avra_trap("defect: encoded asked of a non-durable DbRow")
            ""
        },
    }
}

fn decoded(kind: DbKind, name: string, text: string) -> DbRow? {
    match kind {
        .Sig -> DbRow.Sig(name, text),
        .Answer -> DbRow.Answer(name, text),
        rest -> {
            avra_trap("defect: decoded asked of a non-durable DbKind")
            null
        },
    }
}
