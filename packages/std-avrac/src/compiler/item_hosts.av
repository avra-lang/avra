//! WHAT A PROGRAM'S HOST FNS OWE IT, read on the program layer: each host fn of each file the
//! program reads, judged by the one decision the old path makes (`host_fn_owed`) — its name no
//! symbol the link already has; a dependency's naming its host, answering no other package's extern,
//! and standing in a package the program's own sources import.
use core.{CalledFn, flatten, some_list, sorted_texts}
use compiler.hosts.{BuildHost, HostFnOwed, host_fn_line, host_fn_owed, host_named, hosts_of}
use @std.meta.{derive}
use @std.program.address.{SourceFileAddress}
use @std.program.query_engine.{QueryDefinition, QueryEngine}
use @std.program.saved_derive.{Saved}
use @std.program.saved_query.{cut_query, definitions_of, ListedQuery, query, query_definition}

/// A host fn that owes the program what it doesn't pay: where it's declared, its name, its package,
/// and what it owes.
@derive(Saved)
export type HostOwedAt = {
    file: SourceFileAddress,
    at: FindingAt?,
    name: string,
    from: string,
    owed: HostFnOwed,
    /// For a host fn defined twice, where the first definition stands.
    first_file: SourceFileAddress? = null,
    first_at: FindingAt? = null,
}

/// Every host fn of a program that owes it.
@derive(Saved)
export type HostsOwed = { rows: List<HostOwedAt> }

/// A fn a read file declares, as a call reaches it.
@derive(Saved)
type ReadFn = { declared: DeclaredName, called: CalledFn }

/// The fns a file declares that C defines or a host answers, each as a call reaches it.
@derive(Saved)
type BoundFns = { fns: List<ReadFn> }

/// Every host fn of the files a build of the package `package` reads, its own tests aside, that owes
/// the program what it doesn't pay.
@query("link")
export fn program_hosts_owed(engine: QueryEngine, package: string) -> HostsOwed {
    let read = [f for f in package_closure(engine, package).files if !(f.package_name == package && in_tests(f.path_in_package))]
    let fns = flatten([file_bound_fns(engine, f).fns for f in read])
    let asked = [m.package for f in read if f.package_name == package for u in file_words(engine, f).uses for m in some_list(imported_module(engine, f, u))]
    let bodiless = [r for r in fns if r.called.external]
    let hosted = [r for r in fns if r.called.hosted]
    HostsOwed {
        rows: [row! for r in hosted for row in [owed_at(engine, r, package, asked, bodiless)] if row != null]
            .concat(
                [twice_at(engine, r, hosted[j]) for k, r in hosted for j in [hosted.find_index(it.called.name == r.called.name)!] if j < k],
            ),
    }
}

/// The host fn `r`, defined again after `first` defined its name.
fn twice_at(engine: QueryEngine, r: ReadFn, first: ReadFn) -> HostOwedAt {
    HostOwedAt {
        file: r.declared.file,
        at: host_stmt_at(engine, r),
        name: r.called.name,
        from: r.declared.file.package_name,
        owed: HostFnOwed.Twice,
        first_file: first.declared.file,
        first_at: host_stmt_at(engine, first),
    }
}

/// Where the host fn `r` is declared in its file.
fn host_stmt_at(engine: QueryEngine, r: ReadFn) -> FindingAt? {
    let item = read_item(engine, r.declared.file, r.declared.item)
    let s = item
        .stmts
        .find((s) -> item.store.is_host_fn(s) && item.store.fn_parts(s)?.name == r.called.name)
    let at? = kept_at(if s == null { null } else { item.store.stmt_span(s!) }) else { return null }
    file_placed(engine, r.declared.file, r.declared.item, at)
}

/// What the host fn `r` owes the program of `package`, whose own sources import `asked`, among the
/// bodiless externs `bodiless` it reads; absent where it owes nothing.
fn owed_at(
    engine: QueryEngine,
    r: ReadFn,
    package: string,
    asked: List<string>,
    bodiless: List<ReadFn>,
) -> HostOwedAt? {
    let from = r.declared.file.package_name
    let item = read_item(engine, r.declared.file, r.declared.item)
    let theirs = bodiless
        .find(it.called.name == r.called.name && it.declared.file.package_name != from)
    let owed? = host_fn_owed(
        host_fn_shadowing(r.called.name),
        from == package,
        host_named(host_mark(item, r.called.name) ?? "") != null,
        theirs?.declared?.file?.package_name,
        asked.contains(from),
    ) else { return null }
    HostOwedAt {
        file: r.declared.file,
        at: host_stmt_at(engine, r),
        name: r.called.name,
        from: from,
        owed: owed,
    }
}

/// The host fns of `file` a program of the package `program` holds as bodies when it reads the file —
/// each a body the host calls by name, though nothing in the program may: every one the program's own
/// package declares there, and every one another package declares there that names its host. Which
/// of them a build exports is its hosts' to say (`speaking_host_fns`). None where no file or no
/// package is named.
export fn hosted_in(engine: QueryEngine, file: SourceFileAddress?, program: string?) -> List<
    CalledFn,
> {
    let f? = file else { return [] }
    let package? = program else { return [] }
    [h.called for h in file_host_fns(engine, f).fns if f.package_name == package || h.host != null]
}

/// THE HOST FNS A PROGRAM ANSWERS FOR ITS HOST, whatever reaches them: every one its own package
/// `program`'s sources declare, its tests aside (`package_host_fns`), for a program whose entry `home`
/// is one of the package's own. A host calls each by name, so the program carries it though none of
/// the program's own code does. A program test is no program a host loads: it carries the host fns it
/// reaches, its own file's among them, and no other.
export fn package_hosted(engine: QueryEngine, program: string?, home: SourceFileAddress?) -> List<
    CalledFn,
> {
    let package? = program else { return [] }
    if home != null && in_tests(home!.path_in_package) { return [] }
    [h.called for h in package_host_fns(engine, package).fns]
}

/// The host fns `package`'s sources declare, its tests aside, each file's read through its own
/// question, over the sources' paths alone (`package_source_paths`): a file that is no source, or a
/// source edited without moving what it declares as a host fn, moves nothing that reads this.
@query("summary")
fn package_host_fns(engine: QueryEngine, package: string) -> HostFns {
    HostFns {
        fns: [h for p in package_source_paths(engine, package).paths for h in file_host_fns(engine, SourceFileAddress { package_name: package, path_in_package: p }).fns],
    }
}

/// The paths of `package`'s sources, its tests aside: its listings settled on the names of its sources,
/// so a name a listing gains that is no source — a binary placed beside them, an asset — moves no reader.
@cut_query("summary")
export fn package_source_paths(engine: QueryEngine, package: string) -> SourcePaths {
    SourcePaths {
        paths: [p for p in package_listed_sources(engine, package).paths if !in_tests(p)],
    }
}

/// The paths of every source of `package`, its tests among them, in listing order: the package's
/// listing read once a process, for every reader that asks what files a package holds — an `in package`
/// gathering, the laws over a package's gatherings and its `use` lines — settled on the names of its
/// sources, so a name a listing gains that is no source moves no reader.
@cut_query("summary")
export fn package_listed_sources(engine: QueryEngine, package: string) -> SourcePaths {
    SourcePaths { paths: package_sources(engine, package, "src") }
}

/// A package's source paths, in listing order.
@derive(Saved)
export type SourcePaths = { paths: List<string> }

/// The host fns a build of the program `file` runs for `target` exports, beside the word that names
/// each one's host: each hosted body its reach holds that its own package declares, and each another
/// package declares naming a host the target stands beside. One answer, which stands where the
/// program's reach and its files' host fns do, so a build reads the reach back only where it moved.
@query("summary")
fn speaking_host_fns(engine: QueryEngine, file: SourceFileAddress, target: string) -> HostFns {
    let reached = match program_reached(engine, file) {
        .Program(p) -> p,
        .Unmade(_why, _at) -> { return HostFns { fns: [] } },
    }
    let hosts = hosts_of(target)
    HostFns {
        fns: [h for u in reached.units if u.called.hosted for h in file_host_fns(engine, u.called.file).fns if h.called.symbol == u.called.symbol &&
            (u.called.file.package_name == file.package_name || named_among(h.host, hosts))],
    }
}

/// Whether the host the `@host(…)` word `written` names is one of `hosts`.
fn named_among(written: string?, hosts: List<BuildHost>) -> bool {
    let named? = host_named(written ?? "") else { return false }
    hosts.contains(named)
}

/// The symbol of each host fn a build of the program `file` for `target` exports, which its link
/// keeps though nothing in the program calls it.
export fn program_host_symbols(engine: QueryEngine, file: SourceFileAddress, target: string) -> List<
    string,
> {
    [h.called.symbol for h in speaking_host_fns(engine, file, target).fns]
}

/// The line a build of the program `file` for `target` says for each host fn it exports, in text
/// order.
export fn program_host_fn_lines(engine: QueryEngine, file: SourceFileAddress, target: string) -> List<
    string,
> {
    sorted_texts(
        [host_fn_line(h.called.file.package_name, h.called.name, host_named(h.host ?? "")) for h in speaking_host_fns(engine, file, target).fns],
    )
}

/// A host fn a file declares: as a call reaches it, and the word its `@host(…)` names its host by,
/// absent where it names none.
@derive(Saved)
type HostFn = { called: CalledFn, host: string? = null }

/// The host fns a file declares.
@derive(Saved)
type HostFns = { fns: List<HostFn> }

/// Every fn `file` declares that C defines or a host answers, read from its own items alone: what a
/// program's host fns are judged against, which an edit to another file, or to a body here, leaves
/// standing.
@cut_query("summary")
fn file_bound_fns(engine: QueryEngine, file: SourceFileAddress) -> BoundFns {
    BoundFns {
        fns: [ReadFn { declared: d, called: c } for d in file_declares(engine, file).names if d.kind == ItemKind.Fn for c in some_list(callee_of(engine, d)) if c.external || c.hosted],
    }
}

/// Every host fn `file` declares, read from its own items alone.
@cut_query("summary")
fn file_host_fns(engine: QueryEngine, file: SourceFileAddress) -> HostFns {
    HostFns {
        fns: [HostFn { called: c!, host: host_mark(read_item(engine, d.file, d.item), d.name) } for d in file_declares(engine, file).names if d.kind == ItemKind.Fn for c in [callee_of(engine, d)] if c?.hosted ?? false],
    }
}

/// The word the `@host(…)` on the host fn `name` of `item` ends in, absent where it names none.
fn host_mark(item: ReadItem, name: string) -> string? {
    let s? = item
        .stmts
        .find((s) -> item.store.is_host_fn(s) && item.store.fn_parts(s)?.name == name) else { return null }
    let mark? = item.store.annotations_of(s).find(it.name == HOST_MARK) else { return null }
    let arg? = mark.args.first() else { return null }
    item.store.prop_parts(arg)?.name ?? item.store.ident_name(arg)
}

/// The mark a host fn names its host by.
const HOST_MARK: string = "host"

/// Whether the package path `path` stands in a directory named `tests`, at any depth under its sources:
/// a test's own, never the package's.
fn in_tests(path: string) -> bool { "/${path}".contains("/tests/") }

collect listed_host_facts: List<ListedQuery> = @query_definition in self as ListedQuery { definition: it } by it.name

/// The queries a program's host fns are judged through, for a process to hand its engine.
export fn host_fact_definitions() -> List<QueryDefinition> { definitions_of(listed_host_facts) }
