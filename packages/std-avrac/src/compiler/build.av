//! THE BUILD — a derivation's objects, linked. An unchanged program costs a
//! hash: its binary is kept under a key over every input's bytes. A changed
//! one makes the objects of the files that moved and links them with the ones
//! the store holds for the rest.
use core.{new_digest, digest_text, digest_bytes, digest_key, digest_of, joined, distinct, sorted_texts, fp_list, FileId, RtSig}
use features.{Wanted}
use @std.path.{joined_path, relative_path, dir_of}
use @std.io.{read_bytes}
use compiler.backend.{emit_object, Owned, emit_closed, home_of, not_closed, program_closed}
use compiler.lower.{Body, Lowered, program_symbol}
use compiler.store.{Stored, node_key, store_at}
use compiler.host.{Host, no_target}
extern fn avra_spawn_status(prog: string, args: List<string>) -> int

/// A build's result: the words that linked it, the binary, the warnings to
/// speak, whether the kept binary was reused, and where a fresh one's time went.
export type BuildOutcome = { words: List<string>, binary: string, warnings: string, reused: bool, key: string, phases: string = "" }

/// clang's `-O<n>` as its number.
fn opt_level(opt: string) -> int { if opt.starts_with("-O") && opt.length == 3 { opt.char_code(2) - 48 } else { 0 } }

/// THE PROGRAM'S OWN MODULE: its entry, and the runtime rows the entry names.
export type ProgramModule = { entry: Body, rows: List<RtSig> = [] }

/// What one build links with: the optimisation level, the runtime object and
/// the linker the host found.
export type Toolchain = { opt: string, runtime: string, linker: string }

/// WHERE A TREE'S ARTIFACTS LIVE — one place for the whole checkout, so a
/// dependency's artifacts serve every package that reaches it, and it dies with
/// the worktree. A STORE IS ONE COMPILER'S: every row is the work of the
/// compiler that wrote it, so the store stands under that compiler's print and
/// a new compiler reads none of an old one's — the build after a pass changed
/// compiles every body with it.
// LICENSED I39: a pure PROJECTION — a workspace in, its store's directory out.
export fn build_cache_root(ws: Workspace) -> string {
    if ws.store_root.get() == "" { ws.store_root.set(joined_path(stores_dir(ws), compiler_print(ws))) }
    ws.store_root.get()
}

/// Where a tree's stores stand, one a compiler.
// LICENSED I39: a pure PROJECTION — a workspace in, a directory out.
fn stores_dir(ws: Workspace) -> string { joined_path(tree_root(ws), ".avra-cache") }

/// How many compilers' stores a tree keeps — the newest.
const STORES_KEPT: int = 4

/// The store of a host that names no compiler: a test's, in memory.
const UNNAMED_STORE: string = "shared"

/// THE RUNNING COMPILER'S PRINT — its binary's bytes as a digest, kept on the
/// tree's ROLL beside the binary's stamp, so an unmoved compiler is not read to
/// be named. The roll lists the stores kept, newest last.
// LICENSED I39: a pure PROJECTION — a workspace in, its compiler's print out.
fn compiler_print(ws: Workspace) -> string {
    let at? = ws.host.compiler else { return UNNAMED_STORE }
    let roll = joined_path(stores_dir(ws), "compilers")
    let lines = [line for line in (if ws.host.exists(roll) { ws.host.read(roll) } else { "" }).split("\n") if !line.is_empty()]
    // a binary that just moved has no stamp: it is read, and its line matches no later ask
    let stamp: int? = ws.host.stamp(at)
    let mark = if stamp == null { "" } else { "${stamp!}" }
    let known: string? = if stamp == null { null } else { lines.find(it.ends_with("\t${at}\t${mark}")) }
    if known != null && lines.last() == known { return print_of(known!) }
    let print = if known != null { print_of(known!) } else { digest_of_binary(at) }
    if print == UNNAMED_STORE { return print }
    rolled(ws, roll, [line for line in lines if print_of(line) != print].concat(["${print}\t${at}\t${mark}"]))
    print
}

/// A roll line's print: the line up to its first tab.
// LICENSED I18: a TEXT SCAN's absence — no tab — is an answer, not a protocol read.
fn print_of(line: string) -> string { line.substring(0, line.index_of("\t") ?? line.length) }

/// A binary's bytes as one digest — unnamed when it cannot be read.
fn digest_of_binary(at: string) -> string {
    match read_bytes(at) {
        .Ok(bytes) -> digest_key(digest_bytes(new_digest(), bytes)),
        .Err(_) -> UNNAMED_STORE,
    }
}

/// The roll written back, cut to the newest stores — and everything else under
/// the stores' directory swept: a store no roll line names is no compiler's.
// LICENSED I39: a pure PROJECTION's write-back — a workspace, a path and the lines in.
fn rolled(ws: Workspace, roll: string, lines: List<string>) {
    let kept = lines.slice(if lines.length > STORES_KEPT { lines.length - STORES_KEPT } else { 0 }, lines.length)
    let _ = ws.host.write(roll, joined(kept, "\n"))
    let named = [print_of(line) for line in kept].concat(["compilers", UNNAMED_STORE])
    for name in ws.host.list(stores_dir(ws)) {
        if !named.contains(name) { let _ = avra_spawn_status("rm", ["-rf", joined_path(stores_dir(ws), name)]) }
    }
}

/// The HIGHEST ancestor that looks like a checkout. A lone file has no tree
/// above it and is its own root.
// LICENSED I39: a pure PROJECTION — a workspace in, the checkout it stands in out.
fn tree_root(ws: Workspace) -> string {
    mut best = ws.root
    mut up = dir_of(ws.root)
    while up != dir_of(up) {
        if looks_like_tree(ws.host, up) { best = up }
        up = dir_of(up)
    }
    best
}

fn looks_like_tree(host: Host, dir: string) -> bool {
    host.is_dir(joined_path(dir, ".git")) || host.exists(joined_path(dir, "avra.toml"))
}

/// What names a kept program: its name among the root's, and the inputs beside
/// its sources.
export type Keyed = { named: string, beside: List<string> }

/// A program built: its kept binary when these exact inputs were built
/// before, else derived, compiled and linked now. A refusal is never kept.
// LICENSED I39: THE ENTRY POINT — the one standard signature.
export fn build_program(mut ws: Workspace, entry: string, tools: Toolchain) -> Result<BuildOutcome, string> {
    let binary = binary_name(entry)
    let kept = ws.kept_binary(ws.program_key(entry, []), binary)
    if kept != null { return .Ok(kept!) }
    let d = ws.derived(entry, Want.Binary)?
    let main = d.program.entry_file()
    if main == null { fail d.program.rendered([no_target(ws.root)]) }
    if main!.view.stmts.is_empty() { fail "the program is empty" }
    d.program.ws.linked(d, ProgramModule { entry: runner_entry(d.lowered.types, program_symbol(entry)) }, Keyed { named: entry, beside: [] }, binary, tools)
}


impl Workspace {
    /// A binary these exact inputs linked before, placed where a fresh one would
    /// be — with the warnings that build spoke.
    fn kept_binary(key: string, binary: string) -> BuildOutcome? {
        let store = store_at(build_cache_root(self))
        if !store.has(Stored.Bin, key) || !store.place(Stored.Bin, key, binary) { return null }
        // a stored binary is bytes, and its mode is not in them
        let _ = avra_spawn_status("chmod", ["+x", binary])
        BuildOutcome { words: [], binary: binary, warnings: store.get(Stored.Warn, key) ?? "", reused: true, key: key }
    }

    /// EVERY PACKAGE A PROGRAM'S KEY COVERS, each as `src<TAB>root`: the admitted
    /// ones, and the ones its last derivation admitted. `@std/*` is admitted only
    /// as a `use` reaches for it and the key is asked before anything is read, so
    /// the closure is REMEMBERED — and it only grows: over-covering costs a
    /// rebuild, under-covering is a silently wrong binary. A `use` that reaches a
    /// package the row has not met is an edit to a file the row covers.
    fn closure(named: string) -> List<string> {
        let kept = remembered(store_at(build_cache_root(self)), self.closure_key(named))
        sorted_texts(distinct(["${p.src}\t${p.root}" for p in self.packages].concat([line for line in kept if !line.is_empty()])))
    }

    /// Where a program's closure is remembered.
    fn closure_key(named: string) -> string { node_key(Stored.Unit, ["closure", self.root, named]) }

    /// The closure as it stands now, remembered for the next key.
    fn keep_closure(named: string) {
        remember(store_at(build_cache_root(self)), self.closure_key(named), ["${p.src}\t${p.root}" for p in self.packages])
    }

    /// The key a finished derivation keeps under: its closure remembered first,
    /// so the next ask — before anything is read — names the same inputs.
    fn kept_key(under: Keyed) -> string {
        self.keep_closure(under.named)
        self.program_key(under.named, under.beside)
    }

    /// THE PROGRAM'S KEY — every input's path, length and digest, under what
    /// names the program: a whitespace-only edit moves it. `beside` are inputs
    /// that are not sources.
    fn program_key(named: string, beside: List<string>) -> string {
        let named_inputs = self.build_inputs(named).concat(beside)
        let inputs = joined([self.input_line(f) for f in named_inputs], "\n")
        self.keep_stamps(named_inputs)
        digest_key(digest_text(digest_text(new_digest(), relative_path(self.root, named)), inputs))
    }

    fn input_line(path: string) -> string { "${relative_path(self.root, path)}\t${self.text_digest(path)}" }

    /// A file's bytes as one digest — walked once a build, whoever asks.
    fn text_digest(path: string) -> string {
        let known: string? = self.text_digests.get(path)
        if known != null { return known! }
        let made = self.kept_digest(path, self.host.stamp(path))
        self.text_digests.set(path, made)
        made
    }

    /// A text's digest, kept beside its file's stamp: one path under one stamp is
    /// the same bytes, so an unmoved file is not read to be named. The stamps are
    /// ONE row for the tree, read once — a row a file costs more than the file.
    fn kept_digest(path: string, stamp: int?) -> string {
        let at? = stamp else { return digest_of_file(self.host.read(path)) }
        let mark = "${at}\t"
        let kept = self.stamps().get(path) ?? ""
        if kept.starts_with(mark) { return kept.substring(mark.length, kept.length) }
        let made = digest_of_file(self.host.read(path))
        self.stamped.set(path, mark + made)
        self.stamps_at.set(stamps_moved)
        made
    }

    /// The tree's stamps, by path: `stamp<TAB>digest`.
    fn stamps() -> Map<string, string> {
        if self.stamps_at.get() != stamps_unread { return self.stamped }
        self.stamps_at.set(stamps_read)
        for line in (store_at(build_cache_root(self)).get(Stored.Fp, stamps_key()) ?? "").split("\n") {
            let at = line.index_of("\t")
            if at > 0 { self.stamped.set(line.substring(0, at), line.substring(at + 1, line.length)) }
        }
        self.stamped
    }

    fn stamp_line(path: string) -> string? {
        let kept? = self.stamped.get(path) else { return null }
        "${path}\t${kept}"
    }

    /// The stamps written back, when a file moved under one.
    fn keep_stamps(paths: List<string>) {
        if self.stamps_at.get() != stamps_moved { return }
        let lines = [line! for line in [self.stamp_line(path) for path in paths] if line != null]
        let _ = store_at(build_cache_root(self)).keep(Stored.Fp, stamps_key(), joined(lines, "\n"), [])
    }

    /// Whether a body's home cannot emit it: the home is held, so its object
    /// is the store's.
    fn homed_in_held(bd: Body) -> bool {
        let home? = home_of(bd) else { return false }
        self.is_held(home)
    }

    /// The derivation as a build links it: a held fn as a declaration alone, and
    /// what ROAMS — an instantiation no file owns, a body whose held home cannot
    /// emit it — owned by no file and weak, in name order, so the program's
    /// module has the same bytes whatever order the walk met them in.
    fn homed(lo: Lowered, m: ProgramModule, unlowered: List<Wanted>) -> Lowered {
        let roams = [bd for bd in lo.fns if home_of(bd) == null || self.homed_in_held(bd)]
        mut by_name: Map<string, Body> = {}
        // with instantiations owed, the program's module is the STORE's: what roams
        // here is already in it, and stands as a declaration alone
        for bd in roams { by_name.set(bd.name, if unlowered.is_empty() { bd with { file: null, weak: true } } else { bd with { file: null, weak: true, ins: [], reg_types: [] } }) }
        let stay = [bd for bd in lo.fns if by_name.get(bd.name) == null]
        let owed = [stub! for stub in [self.decls.unlowered_stub(w) for w in unlowered] if stub != null]
        lo with { entry: m.entry, externs: lo.externs.concat(m.rows), fns: held_stubs(self).concat(owed).concat(stay).concat([by_name.get(n)! for n in sorted_texts(distinct([bd.name for bd in roams]))]) }
    }

    /// THE PROGRAM MODULE'S KEY BY ITS OWN BYTES — written as bitcode at `bc`, and
    /// what compiles them. A module that cannot be read back has no key: an empty
    /// read would key every program alike.
    fn bytes_keyed(full: Lowered, bc: string, tools: Toolchain) -> Result<string, string> {
        let broke = emit_closed(full, bc, Owned.Program)
        if broke != null { fail broke! }
        match read_bytes(bc) {
            .Ok(bytes) -> .Ok(node_key(Stored.Obj, ["entry", digest_key(digest_bytes(new_digest(), bytes)), tools.opt, tools.runtime])),
            .Err(_) -> .Err("avra: the entry's module could not be read back — ${bc}"),
        }
    }

    /// The objects of the files that moved and of the program's module, made and
    /// kept; then every object linked, the store's standing in for the rest.
    fn linked(d: Derived, m: ProgramModule, under: Keyed, binary: string, tools: Toolchain) -> Result<BuildOutcome, string> {
        let store = d.store
        let p = d.program
        // THE PROGRAM'S MODULE BY WHAT IT IS A FUNCTION OF. Instantiations nobody
        // lowered are owed unless a build of these very asks kept them.
        let in_key = node_key(Stored.Obj, ["program", d.asked, "${fp_list([i.fingerprint() for i in m.entry.ins])}", tools.opt, tools.runtime])
        if !d.unlowered.is_empty() && !store.has(Stored.Obj, in_key) {
            let whole = self.whole(d, [])?
            return whole.program.ws.linked(whole, m, under, binary, tools)
        }
        let full = self.homed(d.lowered, m, d.unlowered)
        let root = build_cache_root(self)
        let unclosed: string? = program_closed(full)
        if unclosed != null { fail not_closed(unclosed!) }
        // `source<TAB>object`: the link's order is the SOURCES', never the hold's
        mut made: List<string> = []
        let opt = opt_level(tools.opt)
        let t0 = self.clock()
        // AN OBJECT IS MADE ONE WAY — here, by the compiler that runs — so a tree's
        // objects are the same bytes however many of them a build had to make
        for a in p.files {
            let path = a.view.source.file
            let obj = "${root}/${node_key(Stored.Obj, [digest_of(path)])}.o"
            let okey = self.held_okey(store, path)
            if !store.place(Stored.Obj, okey, obj) {
                let broke = emit_object(full, obj, Owned.File(a.view.file), opt)
                if broke != null { fail broke! }
                let _ = store.keep_file(Stored.Obj, okey, obj, [])
            }
            made.push("${path}\t${obj}")
        }
        // THE PROGRAM'S MODULE is keyed by its own bytes when it was lowered here —
        // written every build, compiled only when they moved, so a home's edit that
        // moves no instantiation compiles nothing — and by its inputs when it was not
        let base = "${root}/${node_key(Stored.Obj, [digest_of(binary)])}"
        let program = "${base}.o"
        let pkey = if d.unlowered.is_empty() { self.bytes_keyed(full, "${base}.bc", tools)? } else { in_key }
        if !store.place(Stored.Obj, pkey, program) {
            if !d.unlowered.is_empty() { fail object_gone(binary) }
            let broke = emit_object(full, program, Owned.Program, opt)
            if broke != null { fail broke! }
            let _ = store.keep_file(Stored.Obj, pkey, program, [])
        }
        if !store.has(Stored.Obj, in_key) { let _ = store.keep_file(Stored.Obj, in_key, program, []) }
        let t1 = self.clock()
        // a held object links in place
        for path in held_paths(self) {
            let okey = self.held_okey(store, path)
            if !store.has(Stored.Obj, okey) { fail object_gone(path) }
            made.push("${path}\t${store.path(Stored.Obj, okey)}")
        }
        let t2 = self.clock()
        let words = link_objects([line.split("\t")[1] for line in sorted_texts(made)].concat([program]), self, tools.runtime, binary)
        let code = avra_spawn_status(tools.linker, words)
        if code != 0 { fail clang_link_failed(code) }
        let t3 = self.clock()
        let key = self.kept_key(under)
        let _ = store.keep_file(Stored.Bin, key, binary, [key])
        let _ = store.keep(Stored.Warn, key, d.warnings, [key])
        let spent = d.timed(["emit ${(t1 - t0) / 1000000}ms", "place ${(t2 - t1) / 1000000}ms", "link ${(t3 - t2) / 1000000}ms"])
        .Ok(BuildOutcome { words: words, binary: binary, warnings: d.warnings, reused: false, key: key, phases: spent })
    }
}

/// Where a run stands with the tree's stamps.
const stamps_unread: int = 0
const stamps_read: int = 1
const stamps_moved: int = 2

/// Where the tree's stamps are kept.
fn stamps_key() -> string { node_key(Stored.Fp, ["stamps"]) }

/// A file's bytes as their length and their digest.
fn digest_of_file(text: string) -> string { "${text.length}.${digest_of(text)}" }

// ── The voices ──

fn object_gone(path: string) -> string {
    "avra: a held object disappeared: ${path}"
}
