//! THE BUILD — a derivation's objects, linked. An unchanged program costs a
//! hash: its binary is kept under a key over every input's bytes. A changed
//! one makes the objects of the files that moved and links them with the ones
//! the store holds for the rest.
use core.{
    EmbedKind,
    new_digest,
    digest_text,
    digest_key,
    digest_of,
    digest_of_octets,
    joined,
    distinct,
    flatten,
    rt_sigs,
    sorted_texts,
    fp_list,
    RtSig,
    TypeRegistry,
    FileId,
    DeclId,
    qtrace,
    traced,
}
use features.{Wanted}
use @std.path.{joined_path, relative_path, dir_of}
use @std.io.{read_bytes, make_dirs, remove}
use @std.text.{parse_int, from_codepoint}
use @std.time.{now_ns}
use compiler.backend.{
    in_symbol_order,
    emit_object,
    emit_index,
    EmitIndex,
    objects_made,
    inlines_runtime,
    Owned,
    emit_closed,
    home_of,
    program_bucket,
    not_closed,
    program_closed,
    unsupported_on_wasm,
    runs_tasks,
}
use compiler.lower.{Body, Lowered, program_symbol}
use compiler.memory.{sound_checked}
use compiler.store.{
    Store,
    Stored,
    StoredName,
    Anchor,
    Keeping,
    Producers,
    node_key,
    store_stamped,
    Reading,
    pack_holding,
}
use compiler.host.{no_target, read_manifest, Stamp, Read}
use compiler.hosts.{BuildHost, hosts_of, host_word}
use @std.errors.{Error, ErrorInfo, info}
use diagnostics.{new_source_file}
use @std.relation.engine.{map_cell}
extern fn avra_spawn_status(prog: string, args: List<string>) -> int
extern fn avra_pid_alive(pid: int) -> int
extern fn avra_own_pid() -> int

/// A BUILD'S OWN DEFECT: what the compiler itself could not do to turn an
/// otherwise-analysed program into a binary. `Diagnosed` is the one variant
/// with no shape of its own — a report already rendered elsewhere (the
/// program's own diagnostics, or a workspace refusal with no line to point
/// at) — carried through verbatim, since nothing here can improve on words
/// already chosen.
export enum BuildError {
    /// The entry file has no statements to run.
    Empty
    /// A module `avra_llvm_*` wrote could not be written, or a worker never
    /// wrote the object it was handed — LLVM's own words, passed through.
    EmitFailed(message: string)
    /// The entry's module was written but its bytes could not be read back.
    ModuleUnreadable(path: string)
    /// `clang` exited non-zero linking the objects into a binary.
    LinkFailed(code: int, unanswered: List<string>)
    /// A held object the store named is no longer where the store put it.
    ObjectGone(path: string)
    /// A body calls a symbol nothing in the program declares.
    NotClosed(missing: string)
    /// The program reaches a row or package this target has no body for.
    UnsupportedOnWasm(names: List<string>)
    /// The program's own analysis, or a workspace-level refusal, already
    /// rendered this.
    Diagnosed(report: string)
    /// The finished binary could not be renamed onto its path.
    Unpublished(path: string)
    /// A reached package's C object is not where its manifest names it.
    ObjectsMissing(paths: List<string>)
}

impl Error for BuildError {
    fn describe() -> ErrorInfo {
        match self {
            .Empty -> info("build.empty", "the program is empty"),
            .EmitFailed(m) -> info("build.emit_failed", m),
            .ModuleUnreadable(p) -> info("build.module_unreadable", module_unreadable(p)),
            .LinkFailed(code, unanswered) -> info("build.link_failed", clang_link_failed(code) + unanswered_note(unanswered)),
            .ObjectGone(p) -> info("build.object_gone", object_gone(p)),
            .NotClosed(missing) -> info("build.not_closed", not_closed(missing)),
            .UnsupportedOnWasm(names) -> info("build.wasm_unsupported", wasm_unsupported(names)),
            .Diagnosed(report) -> info("build.diagnosed", report),
            .Unpublished(p) -> info("build.unpublished", unpublished(p)),
            .ObjectsMissing(paths) -> info("build.objects_missing", objects_missing(paths)),
        }
    }
}

/// A build's result: the words that linked it, the binary, the warnings to
/// speak, whether the kept binary was reused, where a fresh one's time went,
/// and its package's `.refuses` tests — a suite's alone; a lone file's build
/// carries none.
export type BuildOutcome = {
    binary: string,
    warnings: string,
    reused: bool,
    phases: string = "",
    refuses: List<RefusesCall> = [],
    /// The host fns the program defines, each as `package name` — what a
    /// host may call it by, and whose word each is.
    host_fns: List<string> = [],
}

/// THE FEATURES A WASM MODULE BUILT HERE MAY USE: LLVM's baseline for a
/// wasm triple that names no CPU, which is what the backend and the C beside
/// it are built to, and exception handling, which the runtime's guarded run
/// is built with (Makefile, `WASM_SJLJ_avra_runtime.c`). The optimizer is told
/// these and no others: told "every feature it knows" it also writes the
/// encodings no engine ships yet — the compact import section an iPhone's
/// WebKit cannot parse — and a link carries no feature section it could read
/// its own set from.
const WASM_FEATURES = [
    "bulk-memory",
    "bulk-memory-opt",
    "call-indirect-overlong",
    "exception-handling",
    "multivalue",
    "mutable-globals",
    "nontrapping-float-to-int",
    "reference-types",
    "sign-ext",
]

/// The names an older optimizer does not know: it refuses an `--enable` of a
/// feature it has no word for, and the same set without them is the set it knows.
const NEWER_FEATURES = ["bulk-memory-opt", "call-indirect-overlong"]

/// `--enable-<f>` for each of `features`.
fn enabling(features: List<string>) -> List<string> { ["--enable-${f}" for f in features] }

/// The optimizer's words for `shrinking`, the spellings to try in order: the
/// features above, then the ones an older optimizer knows. Never a spelling that
/// lets the optimizer pick.
fn feature_tries(shrinking: List<string>) -> List<List<string>> {
    [
        enabling(WASM_FEATURES).concat(shrinking),
        enabling([f for f in WASM_FEATURES if !NEWER_FEATURES.contains(f)]).concat(shrinking),
    ]
}

/// The optimizer's words to shrink `linked` into `shrunk`, for size.
/// THE FUNCTIONS ARE NUMBERED BY USE, after the size passes: a call spells
/// its callee's index in as many bytes as the index needs, and the runtime's
/// rows — a push, a release, a slot read — are what a program calls most.
fn wasm_opt_tries(linked: string, shrunk: string) -> List<List<string>> {
    feature_tries(["-Oz", "--reorder-functions", linked, "-o", shrunk])
}

/// THE FALLBACK FOR A HOST THAT CANNOT SUSPEND A STACK: the same module with
/// asyncify over the two host imports a hosted scheduler parks through, the
/// spellings to try in the order `wasm_opt_tries` tries them.
const ASYNCIFIED = ["--asyncify", "--pass-arg=asyncify-imports@avra_host.switch,avra_host.idle"]

fn asyncify_tries(shipped: string, out: string) -> List<List<string>> {
    feature_tries(ASYNCIFIED.concat(["-Oz", shipped, "-o", out]))
}

/// A module the optimizer answered, or the words it did not: `path` is null when it made none.
type Shrunk = { path: string?, said: string }

/// Where the fallback of `binary` stands: beside it, `app.wasm` to `app.asyncify.wasm`.
export fn fallback_name(binary: string) -> string {
    if binary.ends_with(".wasm") { "${binary.substring(0, binary.length - 5)}.asyncify.wasm" } else { "${binary}.asyncify" }
}

/// The key the fallback of a kept binary is kept under.
fn fallback_key(key: string) -> string { "${key}.asyncify" }

/// ONE OBJECT OF A BUILD: what it is an object of, the key it is kept under,
/// where it stands for the link, and the source the link orders it by.
type Made = { which: Owned, key: string, obj: string, source: string }

/// clang's `-O<n>` as its number.
/// clang's `-O<n>` as its number, and `-Oz` as the SIZE level — negative, so
/// the object's pipeline is `default<Oz>`.
fn opt_level(opt: string) -> int {
    if opt == "-Oz" { return -1 }
    if opt.starts_with("-O") && opt.length == 3 { return opt.char_code(2) - 48 }
    0
}

/// THE PROGRAM'S OWN MODULE: its entry, and the runtime rows the entry names.
/// WHAT A PROGRAM ADDS TO ITS FILES. `main` is a RECIPE, never a body: a link asked
/// again of the sources is another workspace, with another registry and other file
/// ids, and an entry built over the first one's would read this one's by index.
/// `cases` are the cases it calls, each with the file that holds its body.
export type ProgramModule = { main: fn(TypeRegistry) -> ProgramMain, rows: List<RtSig> = [], cases: List<CaseHome> = [] }

/// A case the entry calls, and the path of the file its body is in.
export type CaseHome = { call: CaseCall, path: string }

/// What one build links with: the optimisation level, the runtime object,
/// the linker the host found, the stamp of the driver of each tool it runs —
/// never what a driver runs in its turn — and the linker that driver is told
/// to run (`ld`, its own choice when empty).
export type Toolchain = { opt: string, runtime: string, linker: string, tools: List<Stamp>, target: string = "", reactor: bool = false, wasm_opt: string = "", debug: bool = false, ld: string = "", fallback: bool = false }

impl Workspace {
    /// THE PRODUCING COMPILER'S OWN IDENTITY — memoized once a workspace, so
    /// every durable key this build folds it into (a module's record, a
    /// canonical-format row, a lex-level scan) pays the roll's cost once,
    /// not once per row. `build_cache_root` is the one caller that turns it
    /// into a directory; every other durable key folds it in directly, so a
    /// row's key still says which compiler wrote it even if its STORE were
    /// ever shared across generations.
    fn compiler_id() -> string {
        if self.keys.compiler_id.get() == "" { self.keys.compiler_id.set(compiler_print(self)) }
        self.keys.compiler_id.get()
    }

    /// LENDS an ALREADY-KNOWN print to a workspace that has not asked
    /// for its own yet — for a caller about to mint MANY workspaces in
    /// one run over a binary it already knows cannot move under it
    /// (fmt.av's tree walk, one Workspace per package): each still
    /// pays its own hash without this, the exact cost a PROCESS-WIDE
    /// cache here once tried to avoid and was refused for (a path is
    /// the same kind of claim a stamp is — compiler_print's own doc).
    /// A no-op once this workspace has already settled its own.
    fn seed_compiler_id(id: string) {
        if self.keys.compiler_id.get() == "" { self.keys.compiler_id.set(id) }
    }

    /// THE STORE THIS WORKSPACE READS AND KEEPS IN — the one door every derivation
    /// opens it by, so where its writes land is decided once.
    fn opened_store() -> Store {
        self
            .keys
            .held_pack
            .set(pack_holding(self.keys.held_pack.get(), build_cache_root(self), self.compiler_id()))
        store_stamped(
            build_cache_root(self),
            self.compiler_id(),
            Producers { sig: self.sig_producer() },
            self.keys.keeping.get(),
            self.store_anchors(),
        )
    }

    /// The directories a kept value names by a word: the tree its cache stands in, and the
    /// toolchain's std packages.
    fn store_anchors() -> List<Anchor> {
        [Anchor { at: tree_root(self), word: "tree" }]
            .concat(
                if self.host.std_root == null { [] } else { [Anchor { at: self.host.std_root!, word: "std" }] },
            )
    }

    /// FROM HERE ON, AN INSPECTION: this workspace and every restart of it derive
    /// as a check does and keep what they learn in this process alone.
    fn inspecting() { self.keys.keeping.set(Keeping.Aside(map_cell())) }
}

/// WHERE A TREE'S ARTIFACTS LIVE — one place for the whole checkout, so a
/// dependency's artifacts serve every package that reaches it, and it dies with
/// the worktree. ONE STORE FOR EVERY COMPILER (S2): the store's own header
/// carries the producing compiler's print, and a record from another print is
/// never read.
// LICENSED compiler.free_state_verb: a pure PROJECTION — a workspace in, its cache's directory out.
export fn build_cache_root(ws: Workspace) -> string {
    if ws.keys.store_root.get() == "" { ws.keys.store_root.set(stores_dir(ws)) }
    ws.keys.store_root.get()
}

/// Where a tree's cache stands.
// LICENSED compiler.free_state_verb: a pure PROJECTION — a workspace in, a directory out.
fn stores_dir(ws: Workspace) -> string { joined_path(tree_root(ws), ".avra-cache") }

/// A SERIAL FOR THIS PROCESS ALONE — `now_ns()`'s own clock cannot be
/// trusted to tell two calls apart (a wall clock's resolution is not a
/// promise), so a name minted from the timestamp is never the timestamp alone.
once fn process_serial() -> Cell<int> { Cell.new(0) }

/// The next serial: never the same twice in this process.
fn next_serial() -> int {
    let serial = process_serial()
    let n = serial.get() + 1
    serial.set(n)
    n
}

/// A path beside `binary` that no other process names. A binary is written
/// and made ready THERE, then renamed onto `binary` whole (`published`), so a
/// reader of `binary` never meets it missing, half-written or not yet
/// executable.
// LICENSED input.scratch_name: a call-unique scratch path, renamed whole onto its target, never an input of what is built
export fn staged_beside(binary: string) -> string { "${binary}.${now_ns()}-${next_serial()}.staged" }

/// `staged` renamed onto `to` in one step: what stands at `to` is the old
/// file or the new one, whole. A failed rename leaves no staged file behind.
export fn published(staged: string, to: string) -> bool {
    if avra_spawn_status("mv", ["-f", staged, to]) == 0 { return true }
    let _ = remove(staged)
    false
}

/// THE PRINT OF A COMPILER THIS PROCESS CANNOT IDENTIFY — a host with no
/// binary to name (a test's, in memory) or one whose binary this process
/// could not read back. NEVER A SHARED CONSTANT: two such runs are two
/// different compilers for all this door knows, so trusting one's rows
/// for the other is exactly the hazard this file exists to refuse — a
/// nonce this process mints once (`compiler_id`'s memoization) and never
/// rolls, so it is never mistaken for a real compiler's print and never
/// read back by a later process either. THE SERIAL, NOT THE CLOCK, IS
/// WHAT MAKES TWO ASKS IN ONE PROCESS DISAGREE: two workspaces built
/// back to back can land in the same tick of a coarse wall clock.
fn unnamed_print() -> string {
    // LICENSED input.scratch_name: a call-unique scratch name, never an input of what is built
    "unnamed-${now_ns()}-${next_serial()}"
}

/// THE RUNNING COMPILER'S PRINT — its binary's bytes as a digest and the mode
/// it emits under (`codegen_mode`), since one binary writes two kinds of
/// object. The digest is the Compiler input's: the binary's bytes, hashed
/// at the door once for the running process. A STAMP-KEYED SHORTCUT STOOD
/// HERE ONCE, trusting a size/time/inode match to skip the hash — the `compiler_id()` memoization already pays that
/// hash at most once a workspace, and the shortcut bought a few milliseconds
/// against a law it could not keep: a rebuilt binary at the SAME path can land
/// on a stamp the roll already holds (an adversarial host proves it outright,
/// and the field's own "index N is out of bounds" traps are what a live
/// two-generation rebuild produces when this exact door lies). A stamp match
/// is a claim about the bytes, never the bytes; only the digest is. The roll
/// still lists the stores kept, newest last, so `rolled`'s sweep still knows
/// what to keep. A PATH IS THE SAME KIND OF CLAIM AS A STAMP: a process-wide
/// cache keyed on `at` was tried and refused here — the compiler_print_
/// adversarial_test's own "two DIFFERENT binary contents at the SAME path
/// still disagree" attacks exactly that shortcut, inside one process, and a
/// path cache fails it the same way a stamp cache would. A caller that KNOWS
/// its own binary cannot move across many workspaces in one run (the fmt
/// command's tree walk) shares one hash by seeding each Workspace's own
/// `keys.compiler_id` instead — see `seed_compiler_id`, below, and
/// fmt.av's `fold_groups`, its one caller.
// LICENSED compiler.free_state_verb: a pure PROJECTION — a workspace in, its compiler's print out.
fn compiler_print(ws: Workspace) -> string {
    let digest? = ws.running_print() else { return unnamed_print() }
    let mode = ws.keys.build_mode.get()
    "${digest}${codegen_mode()}${proof_mode()}${if mode == "" { "" } else { "@${mode}" }}"
}

/// WHERE A KEPT BINARY'S LINK ANSWER STANDS: the host fns it lists, kept with what the link
/// read — the tools that linked it and each file it linked beside its sources (the runtime
/// archive, the package objects), by their digests. A program's key covers what it was
/// COMPILED from; these are what it was LINKED with, and an archive rebuilt from unchanged
/// sources moves no source digest. So the answer stands while every read still has its digest.
fn host_fns_key(key: string) -> string { node_key(Stored.Unit, ["host-fns", key]) }

/// The name of the read that stands for the tools as a set: a link made by other tools is
/// another link, whichever file it read.
const TOOLS_READ: string = "tools"

/// What a link read, as the reads its answer is kept with — none when the host cannot tell
/// a tool, which makes nothing a kept binary can be trusted for.
fn linked_reads(files: List<string>, tools: List<Stamp>) -> List<Reading>? {
    let tooled? = told(tools) else { return null }
    [Reading { name: TOOLS_READ, digest: digest_of(tooled) }]
        .concat([Reading { name: f, digest: linked_now(f, tools) ?? "-" } for f in files])
}

/// A link read's digest now: the tools', or the bytes of a file — `-` for one gone, which no
/// digest equals.
fn linked_now(name: string, tools: List<Stamp>) -> string? {
    if name == TOOLS_READ {
        let tooled? = told(tools) else { return null }
        return digest_of(tooled)
    }
    digest_of_binary(name) ?? "-"
}

/// The tools as their inputs' digests, one per line — none for no tools,
/// and none when the host cannot tell one: a toolchain that names nothing
/// it can tell makes nothing a kept binary can be trusted for.
fn told(tools: List<Stamp>) -> string? {
    if tools.is_empty() || tools.any(it.mark == null) { return null }
    joined([Read.Tool(s.path, s).input().digest.key for s in tools], "\n")
}

/// HOW THIS PROCESS EMITS, as a suffix on the compiler's print: the runtime's
/// hot leaves inlined, or kept as calls.
fn codegen_mode() -> string { if inlines_runtime() { "" } else { "-calls" } }

/// WHAT THIS PROCESS PROVES, as a suffix on the compiler's print: the
/// memory pass's proof adds findings to a check, so a check made with it
/// is kept apart from one made without.
fn proof_mode() -> string { if sound_checked() { "+sound" } else { "" } }

/// A binary's bytes as one digest — null when it cannot be read back. BLAKE3: the
/// content hash that names a kept object and detects a stale one.
export fn digest_of_binary(at: string) -> string? {
    // LICENSED input.object_digest: the bytes are the key itself; a read that fails answers null and keys nothing
    match read_bytes(at) { .Ok(bytes) -> digest_of_octets(bytes), .Err(_) -> null }
}

/// THE CHECKOUT: the NEAREST ancestor holding a `.git` — a worktree's own
/// (`.git` is a file there) or a clone's (a directory), either one the
/// boundary nothing climbs past. Only when NO ancestor carries a `.git` does
/// the walk fall back to the HIGHEST `avra.toml`, for a tree with no git
/// history yet. A lone file has no tree above it and is its own root.
// LICENSED compiler.free_state_verb: a pure PROJECTION — a workspace in, the checkout it stands in out.
fn tree_root(ws: Workspace) -> string {
    mut manifest_root = ws.root
    mut up = dir_of(ws.root)
    while up != dir_of(up) {
        if ws.there(joined_path(up, ".git")) { return up }
        if ws.there(joined_path(up, "avra.toml")) { manifest_root = up }
        up = dir_of(up)
    }
    manifest_root
}

/// What names a kept program: its name among the root's, and the inputs beside
/// its sources.
export type Keyed = { named: string, beside: List<string> }

/// A program built beside its own source: its kept binary when these exact
/// inputs were built before, else derived, compiled and linked now. A
/// refusal is never kept.
// LICENSED compiler.free_state_verb: THE ENTRY POINT — the one standard signature.
export fn build_program(ws: Workspace, entry: string, tools: Toolchain) -> Result<
    BuildOutcome,
    BuildError,
> {
    ws.linked_program(entry, target_binary(entry, tools.target), tools)
}

impl Toolchain {
    /// WHAT THIS TOOLCHAIN'S OUTPUT IS FOR, beside the compiler that makes it:
    /// every word that moves an object's bytes or the linked module's. The
    /// host's own build is the empty mode.
    fn mode() -> string {
        if self.target == "" { return "" }
        "${self.target}${marked(self.reactor, "+reactor")}${marked(self.wasm_opt != "", "+opt")}${marked(self.debug, "+debug")}${marked(self.fallback, "+fallback")}"
    }
}

/// A mode's mark, written only when it holds.
fn marked(holds: bool, mark: string) -> string { if holds { mark } else { "" } }

impl Workspace {
    /// WHAT A BUILD IS FOR IS PART OF THE COMPILER'S OWN IDENTITY. A kept row
    /// is one target's object code and a kept binary one link's answer, so
    /// each mode reads from a store of its own — cold once, then warm. The
    /// mode folds into the compiler's print (and so into `compiler_id`, the
    /// store root and the roll's name for it): ONE mechanism, and no key
    /// spells the target a second time. A print and a root settled under
    /// another mode are forgotten, and a restart carries the mode (`anew`).
    fn built_for(tools: Toolchain) {
        let mode = tools.mode()
        if self.keys.build_mode.get() == mode { return }
        self.keys.build_mode.set(mode)
        self.keys.compiler_id.set("")
        self.keys.store_root.set("")
        self.keys.object_keys.set({})
    }
}

/// A build's output path: a wasm module carries `.wasm`, so a native and a
/// wasm build of one source never stand at one path.
fn target_binary(entry: string, target: string) -> string {
    if target == "" { binary_name(entry) } else { "${binary_name(entry)}.wasm" }
}

impl Workspace {
    /// `build_program`, freed from where its binary lands — a `.refuses` test's
    /// native leg wants its own binary under `build/`, never beside its source.
    fn linked_program(entry: string, binary: string, tools: Toolchain) -> Result<
        BuildOutcome,
        BuildError,
    > {
        self.built_for(tools)
        let kept = self.kept_binary(self.program_key(entry, []), binary, tools)
        if kept != null { return .Ok(kept!) }
        let d = diagnosed(self.derived(entry, Want.Binary))?
        let main? = d.program.entry_file() else { fail BuildError.Diagnosed(d.program.rendered([no_target(self.root)])) }
        if main.view.stmts.is_empty() { fail BuildError.Empty }
        let _ = make_dirs(dir_of(binary))
        d
            .linked(
                runner_module(self.file_name(entry)),
                Keyed { named: entry, beside: [] },
                binary,
                tools,
            )
    }

    /// A binary these exact inputs linked before, placed where a fresh one would
    /// be — with the warnings that build spoke.
    fn kept_binary(key: string, binary: string, tools: Toolchain) -> BuildOutcome? {
        let store = self.opened_store()
        let staged = staged_beside(binary)
        let warnings? = store.get(Stored.Warn, key) else { return null }
        let host_fns? = store
            .get_valid(Stored.Unit, host_fns_key(key), (name: string) -> linked_now(name, tools.tools)) else {
            return null
        }
        if !store.has(Stored.Bin, key) { return null }
        // A binary already standing at its place with the kept bytes is left untouched: replacing
        // a file costs more than the hit it answers.
        let there = digest_of_binary(binary)
        if there == null || there != digest_of_binary(store.path(Stored.Bin, key)) {
            if !store.place(Stored.Bin, key, staged) { return null }
            // a stored binary is bytes, and its mode is not in them
            let _ = avra_spawn_status("chmod", ["+x", staged])
            if !published(staged, binary) { return null }
        }
        self.fallback_kept(store, key, binary, tools)
        BuildOutcome {
            binary: binary,
            warnings: warnings,
            reused: true,
            host_fns: [line for line in host_fns.split("\n") if !line.is_empty()],
        }
    }

    /// The fallback a kept binary was built with, placed beside it; none standing
    /// when the kept build made none.
    fn fallback_kept(store: Store, key: string, binary: string, tools: Toolchain) {
        let place = fallback_name(binary)
        if !tools.fallback || !store.has(Stored.Bin, fallback_key(key)) {
            let _ = remove(place)
            return
        }
        let staged = staged_beside(place)
        if !store.place(Stored.Bin, fallback_key(key), staged) { return }
        // LICENSED input.staged_output: marks the program just placed executable, never an input of what is built
        let _ = avra_spawn_status("chmod", ["+x", staged])
        let _ = published(staged, place)
    }

    /// EVERY PACKAGE A PROGRAM'S KEY COVERS, each as `src<TAB>root`: the admitted
    /// ones, and the ones its last derivation admitted. `@std/*` is admitted only
    /// as a `use` reaches for it and the key is asked before anything is read, so
    /// the closure is REMEMBERED — and it only grows: over-covering costs a
    /// rebuild, under-covering is a silently wrong binary. A `use` that reaches a
    /// package the row has not met is an edit to a file the row covers.
    fn closure(named: string) -> List<string> {
        let kept = remembered(self.opened_store(), self.closure_key(named))
        sorted_texts(
            distinct(self.closure_lines().concat([line for line in kept if !line.is_empty()])),
        )
    }

    /// The admitted packages as closure lines: each one's source and root, by stored name.
    fn closure_lines() -> List<string> { ["${self.stored_name(p.src)}\t${self.stored_name(p.root)}" for p in self.packages()] }

    /// The directories a program's closure covers, each as a path here: its source and its root.
    fn covered_dirs(named: string) -> List<CoveredDir> {
        [CoveredDir {
            src: self.path_named(StoredName(at[0])),
            root: self.path_named(StoredName(at[1])),
        } for at in [line.split("\t") for line in self.closure(named)] if at.length > 1]
    }

    /// Where a program's closure is remembered.
    fn closure_key(named: string) -> string { self.root_key(Stored.Unit, "closure", [named]) }

    /// The closure as it stands now, remembered for the next key.
    fn keep_closure(named: string) {
        remember(self.opened_store(), self.closure_key(named), self.closure_lines())
    }

    /// EVERY FILE A PROGRAM'S COMPILE-TIME RUNS READ THAT IS NOT ONE OF ITS
    /// INPUTS, as each input's record names it: an embedded file is no
    /// source of the program, so no package's listing names it, and its edit
    /// must still move the key.
    fn embeds(inputs: List<string>) -> List<string> {
        let store = self.opened_store()
        sorted_texts(
            distinct(
                [r.path for path in inputs for r in kept_runs(record_places(self, store, self.module_path_of(path)).get(path)) if !inputs.contains(r.path)],
            ),
        )
    }

    /// What an embedded file says now, read as a const reads it: its
    /// text's digest — or why it can no longer be read, which is a
    /// different answer and never a trap.
    fn embed_said(path: string) -> string {
        match self.embed_read(path, EmbedKind.Octets) {
            .Ok(octets) -> "${octets.length}.${digest_of_octets(octets)}",
            .Err(why) -> "!${why}",
        }
    }

    /// An embedded file's line of the key.
    fn embed_line(path: string) -> string { "${self.stored_name(path)}\t${self.embed_said(path)}" }

    /// THE INPUT MANIFEST: what the last derivation of a program read — its closure, each
    /// covered directory's listing, and every input, embed and object with its line of the
    /// key — kept as ONE record beside the key it produced. An unchanged run confirms the
    /// record by recomputing those lines and reads the key off it, instead of rebuilding the
    /// input set (the closure walk, the embeds of every record, the reached objects).
    fn manifest_key(under: Keyed) -> string {
        self.root_key(Stored.Fp, "manifest", [under.named, joined(under.beside, "\t")])
    }

    fn keep_manifest(store: Store, under: Keyed, key: string) {
        let inputs = self.source_inputs(under.named).concat(under.beside)
        let covered = self.closure(under.named)
        let entries = [ManifestEntry.Covered(c) for c in covered]
            .concat(
                [ManifestEntry
                    .Listing(
                        c.split("\t")[0],
                        self.listing_word(self.path_named(StoredName(c.split("\t")[0]))),
                    ) for c in covered],
            )
            .concat([self.input_entry(f) for f in inputs])
            .concat(
                [ManifestEntry.Embed("${self.stored_name(f)}", self.embed_line(f)) for f in self.embeds(inputs)],
            )
            .concat(
                [ManifestEntry.Object("${self.stored_name(o)}", self.object_line(o)) for o in self.reached_objects(under.named)],
            )
        let _ = store
            .keep(
                Stored.Fp,
                self.manifest_key(under),
                joined([key].concat([e.spelled() for e in entries]), "\n"),
                [],
            )
    }

    /// The key of a run: the manifest's, when every line it holds still stands; else folded.
    fn confirmed_key(store: Store, under: Keyed) -> string {
        let reading = self.clock()
        let row = store.get(Stored.Fp, self.manifest_key(under))
        self.timed("manifest read", reading)
        if row != null {
            let parsing = self.clock()
            let lines = row!.split("\n")
            let entries = [read_entry(l) for l in lines.slice(1, lines.length)]
            self.timed("manifest parse", parsing)
            if !entries.any(it == null) && self.manifest_stands(under, [e! for e in entries]) { return lines[0] }
        }
        self.program_key(under.named, under.beside)
    }

    fn manifest_stands(under: Keyed, entries: List<ManifestEntry>) -> bool {
        let closing = self.clock()
        let same = joined(self.closure(under.named), "\n") == joined([c for e in entries for c in e.covered()], "\n")
        self.timed("closure", closing)
        same && entries.all((e) -> self.entry_timed(e))
    }

    /// One entry confirmed, its time kept under what kind of input it is.
    fn entry_timed(e: ManifestEntry) -> bool {
        let confirming = self.clock()
        let stands = self.entry_stands(e)
        self.timed(e.kind_word(), confirming)
        stands
    }

    fn entry_stands(e: ManifestEntry) -> bool {
        match e {
            .Covered(_) -> true,
            .Listing(dir, word) -> self.listing_word(self.path_named(StoredName(dir))) == word,
            .Input(name, line, stamp) -> self.input_stands(self.path_named(StoredName(name)), line, stamp),
            .Embed(name, line) -> self.embed_line(self.path_named(StoredName(name))) == line,
            .Object(name, line) -> self.object_line(self.path_named(StoredName(name))) == line,
        }
    }

    /// An input's manifest entry: the line of the key it stands for, then the
    /// stamp its bytes wore when that line's digest was taken. The line comes
    /// first, because taking the digest is what takes the stamp.
    fn input_entry(path: string) -> ManifestEntry {
        let line = self.input_line(path)
        ManifestEntry.Input("${self.stored_name(path)}", line, self.text_stamp(path))
    }

    /// Whether an input still stands: the stamp it was recorded with, when the
    /// host gives the same one now, and the bytes themselves for every other
    /// answer. A stamp that moved says nothing about the bytes — it only says
    /// they must be read — so only an equal stamp skips the digest.
    fn input_stands(path: string, line: string, stamp: string) -> bool {
        if !stamp.is_empty() && stamp == self.held_stamp(path) { return true }
        self.input_line(path) == line
    }

    /// A file's stamp as it stands now, in the same spelling a record keeps —
    /// empty where the host will not make the claim.
    fn held_stamp(path: string) -> string {
        let mark = self.file_stamp(path)
        if mark == 0 { "" } else { "${mark}" }
    }

    /// A file's stamp: its size, times and inode as the host folds them, and
    /// zero for a file that moved inside the window where two writes can wear
    /// one time.
    fn file_stamp(path: string) -> int { self.host.confirming_stamp(path) }

    /// A directory's files as one word, as a walk lists them now — the files `source_inputs`
    /// reads of it: a dependency's tests are no input, so they are never walked.
    fn listing_word(dir: string) -> string {
        let files = if dir == self.packages()[0].src { self.all_files(dir) } else { self.all_files_no_tests(dir) }
        digest_of(joined(files, "\n"))
    }

    /// The key a finished derivation keeps under: its closure remembered
    /// first, so the next ask — before anything is read — names the same
    /// inputs.
    fn kept_key(under: Keyed) -> string {
        self.keep_closure(under.named)
        self.program_key(under.named, under.beside)
    }

    /// THE PROGRAM'S KEY — every input's path, length and digest, under what
    /// names the program: a whitespace-only edit moves it. `beside` are inputs
    /// that are not sources. THIS COMPILER'S OWN PRINT JOINS FIRST: a kept
    /// binary is this generation's object code and a kept `Warn` row is this
    /// generation's diagnostic wording, so both are keyed by the compiler
    /// that made them, not only by the store root they happen to sit under.
    /// EVERY REACHED PACKAGE'S OWN OBJECTS JOIN LAST: a package's `.av`
    /// files name its C externs, never their bodies, so a C-only edit moves
    /// no `.av` digest — the object's own bytes are the only witness a
    /// kept binary that linked them is still the one these bytes would
    /// produce.
    fn program_key(named: string, beside: List<string>) -> string {
        let named_inputs = self.source_inputs(named).concat(beside)
        let inputs = joined(
            [self.input_line(f) for f in named_inputs]
                .concat([self.embed_line(f) for f in self.embeds(named_inputs)]),
            "\n",
        )
        let objects = joined([self.object_line(o) for o in self.reached_objects(named)], "\n")
        digest_key(
            digest_text(
                digest_text(
                    digest_text(digest_text(new_digest(), self.compiler_id()), named),
                    inputs,
                ),
                objects,
            ),
        )
    }

    fn input_line(path: string) -> string { "${self.stored_name(path)}\t${self.text_digest(path)}" }

    /// Every object every reached package's manifest names — a C-only edit
    /// moves this list's digests though it moves no `.av` file's. Read over
    /// `closure(named)`, never `packages()`: this runs BEFORE the program is
    /// analysed, where nothing has admitted a package yet — `closure` is
    /// what already survives that (its own remembered half), `packages()`
    /// here would answer empty every first ask.
    fn reached_objects(named: string) -> List<string> {
        distinct(flatten([self.manifest_objects(c.root) for c in self.covered_dirs(named)]))
    }

    /// A root's own manifest, read fresh and not through `manifest(i)`'s
    /// ordinal — a closure root has no ordinal before analysis admits it.
    fn manifest_objects(root: string) -> List<string> {
        let path = joined_path(root, "avra.toml")
        if !self.there(path) { return [] }
        let m = read_manifest(new_source_file(path, self.listed_text(path)))
        [joined_path(root, o) for o in self.filled_words(m.objects)]
    }

    /// An object's path paired with its CURRENT bytes' digest, read fresh —
    /// `digest_of_binary`, never `text_digest`: an object is bytes, not text,
    /// and nothing here keeps a memo across the one key this answers.
    fn object_line(path: string) -> string { "${self.stored_name(path)}\t${digest_of_binary(path) ?? "-"}" }

    /// A file's text as one digest, through its Text input: kept per read of
    /// that input, so a turn that reads the file again digests the text it read.
    /// The stamp those bytes wore is kept BESIDE the digest, taken in the same
    /// breath: a stamp on its own is a claim about bytes nobody hashed, and a
    /// digest with no stamp cannot be confirmed without reading.
    fn text_digest(path: string) -> string {
        let octets = self.listed_octets(path)
        let at = "${self.octets_word(path)}\t${path}"
        let known: string? = self.keys.text_digests.get().get(at)
        if known != null { return known! }
        let made = "${octets.length}.${digest_of_octets(octets)}"
        self.keys.text_digests.put(at, made)
        self.keys.text_stamps.put(at, self.file_stamp(path))
        made
    }

    /// What one lex of a file's text answers about its block words, kept while the
    /// text it was read from is the one read now.
    fn text_scan(path: string) -> TextScan {
        let text = self.listed_text(path)
        let known: TextScan? = self.keys.text_scans.get().get(path)
        if known != null && known!.text == text { return known! }
        let made = scan_text(text, self.lang.keywords)
        self.keys.text_scans.put(path, made)
        made
    }

    /// The stamp the digest of `path` was taken with, empty where nothing here
    /// hashed it or the host would not make the claim. Never a stamp on its
    /// own: a stamp is only worth what the bytes it was taken beside.
    fn text_stamp(path: string) -> string {
        let at = "${self.octets_word(path)}\t${path}"
        let mark? = self.keys.text_stamps.get().get(at) else { return "" }
        if mark == 0 { "" } else { "${mark}" }
    }

    /// Whether a body's home cannot emit it: the home is held, so its object
    /// is the store's.
    fn homed_in_held(bd: Body) -> bool {
        let home? = home_of(bd) else { return false }
        self.is_held(home)
    }

    /// The derivation as a build links it: a held fn as a declaration alone, and
    /// what ROAMS — an instantiation no file owns, a body whose held home cannot
    /// emit it — owned by no file and weak, in name order, so the program's
    /// module has the same bytes whatever order the walk met them in.
    fn homed(lo: Lowered, m: ProgramModule, main: ProgramMain, unlowered: List<Wanted>) -> Lowered {
        let roams = [bd for bd in lo.fns if home_of(bd) == null || self.homed_in_held(bd)]
        mut by_name: Map<string, Body> = {}
        // with instantiations owed, the program's module is the STORE's: what roams
        // here is already in it, and stands as a declaration alone
        for bd in roams {
            by_name
                .set(
                    bd.name,
                    if unlowered.is_empty() { bd with { file: null, weak: true } } else { bd with { file: null, weak: true, ins: [], reg_types: [] } },
                )
        }
        let stay = [bd for bd in lo.fns if by_name.get(bd.name) == null]
        let owed = [stub! for stub in [self.decls.unlowered_stub(w) for w in unlowered] if stub != null]
        // a symbol is one body: a held stub stands only where nothing lowered the symbol
        let stand = undeclared(held_stubs(self).concat(owed), lo.fns)
            .concat(stay)
            .concat([by_name.get(n)! for n in sorted_texts(distinct([bd.name for bd in roams]))])
        // a held module nobody read is never minted, so nothing else declares its cases
        let brought = [main.case_stub(c.call, self.file_id(c.path)) for c in m.cases]
        lo with { entry: main.body, types: main.types, externs: lo.externs.concat(m.rows), fns: undeclared(brought, stand).concat(stand) }
    }

    /// THE PROGRAM MODULE'S KEY BY ITS OWN BYTES — written as bitcode at `bc`, and
    /// what compiles them. A module that cannot be read back has no key: an empty
    /// read would key every program alike.
    fn bytes_keyed(full: Lowered, ix: EmitIndex, bc: string, which: Owned, tools: Toolchain) -> Result<
        string,
        BuildError,
    > {
        let broke = emit_closed(full, ix, bc, which, tools.target)
        if broke != null { fail BuildError.EmitFailed(broke!) }
        match read_bytes(bc) {
            .Ok(bytes) -> .Ok(node_key(Stored.Obj, ["entry", digest_of_octets(bytes), tools.opt, tools.runtime])),
            .Err(_) -> .Err(BuildError.ModuleUnreadable(bc)),
        }
    }

    /// THE BUILD: every object the program links — the read files' and the program's
    /// module made or placed, the held ones standing in the store — linked in their
    /// SOURCES' order, and the binary kept under its key.
    fn linked(d: Derived, m: ProgramModule, under: Keyed, binary: string, tools: Toolchain) -> Result<
        BuildOutcome,
        BuildError,
    > {
        let main = m.main(d.lowered.types)
        let asked = program_asked_key(d, main, tools)
        mut clock = self.marking()
        let full = closed(self.homed(d.lowered, m, main, []))?
        if tools.target != "" {
            let missing = unsupported_on_wasm(d.program.reached())
            if !missing.is_empty() { fail BuildError.UnsupportedOnWasm(missing) }
        }
        let programs = self.program_objects(full, tools)?
        let read = [self.object_of(d.store, a) for a in d.program.files]
        self.objects_kept(d, full, read.concat(programs), tools)?
        // the program's buckets stand under what they are a function of, too
        let _ = d.store.keep_once(Stored.Unit, buckets_key(asked), buckets_text(programs))
        clock.mark("emit")
        let held = self.held_objects(d.store)?
        clock.mark("place")
        let absent = self.absent_objects(tools.target)
        if !absent.is_empty() { fail BuildError.ObjectsMissing(absent) }
        let staged = staged_beside(binary)
        let hosted = [self.decls.decl(h).name for h in self.exported_host_fns([a.view.file for a in d.program.files], hosts_of(tools.target))]
        let code = avra_spawn_status(
            tools.linker,
            link_objects(
                [d.store.path(Stored.Obj, o.key) for o in by_source(read.concat(held)).concat(programs)],
                self,
                tools.runtime,
                staged,
                binary,
                tools.target,
                tools.reactor,
                tools.debug,
                tools.ld,
                hosted,
            ),
        )
        if code != 0 {
            fail BuildError
                .LinkFailed(
                    code,
                    if tools.target == "" {
                        unanswered_externs(
                            full,
                            hosted,
                            armap_text(self.listed_octets(tools.runtime)),
                        )
                    } else {
                        []
                    },
                )
        }
        clock.mark("link")
        let shrunk = shipped(staged, tools)
        let ready = shrunk.path ?? staged
        let key = self.kept_key(under)
        let fallback = self.fallback_made(d, full, ready, key, binary, tools)
        let warnings = spoken([d.warnings, shrunk.said, fallback.said])
        let _ = d.store.keep(Stored.Warn, key, warnings, [key])
        let host_fns = self
            .host_fn_lines([a.view.file for a in d.program.files], hosts_of(tools.target))
        let reads = linked_reads(self.linked_files(tools.runtime, tools.target), tools.tools)
        if reads != null {
            let _ = d
                .store
                .keep_reading(Stored.Unit, host_fns_key(key), joined(host_fns, "\n"), reads!)
        }
        let _ = d.store.keep_file(Stored.Bin, key, ready, [key])
        clock.mark("keep binary")
        if !published(ready, binary) { fail BuildError.Unpublished(binary) }
        self.fallback_published(fallback.path, binary)
        clock.mark("publish")
        BuildOutcome {
            binary: binary,
            warnings: warnings,
            reused: false,
            phases: d.timed(clock.spans),
            host_fns: host_fns,
        }
    }

    /// THE FALLBACK, when this build asked for one and the program runs tasks: the
    /// shipped module asyncified, kept beside the binary's own bytes. Null when
    /// none is made — a program that never parks has nothing to unwind.
    fn fallback_made(
        d: Derived,
        full: Lowered,
        shipped_to: string,
        key: string,
        binary: string,
        tools: Toolchain,
    ) -> Shrunk {
        if !tools.fallback || tools.wasm_opt == "" || !runs_tasks(full) { return Shrunk { path: null, said: "" } }
        let out = staged_beside(fallback_name(binary))
        if !asyncify_tries(shipped_to, out).any((words) -> wasm_opt_runs(tools.wasm_opt, words)) {
            let _ = remove(out)
            return Shrunk { path: null, said: no_fallback(tools.wasm_opt) }
        }
        let _ = d.store.keep_file(Stored.Bin, fallback_key(key), out, [key])
        Shrunk { path: out, said: "" }
    }

    /// The fallback onto its place, or what stood there from an earlier build gone.
    fn fallback_published(staged: string?, binary: string) {
        let place = fallback_name(binary)
        let made? = staged else {
            let _ = remove(place)
            return
        }
        let _ = published(made, place)
    }

    /// The program's host fns, each as `package name`, in name order.
    fn host_fn_lines(files: List<FileId>, hosts: List<BuildHost>) -> List<string> {
        sorted_texts([self.host_fn_line(d) for d in self.exported_host_fns(files, hosts)])
    }

    /// `package name`, and `(Host)` after it when the fn names its host.
    fn host_fn_line(d: DeclId) -> string {
        let x = self.decls.decl(d)
        let at = "${self.packages()[self.holder_of_path(self.decls.file(x.file).path)].key} ${x.name}"
        let host? = self.named_host(d) else { return at }
        "${at} (${host_word(host)})"
    }

    /// A read file's object: kept under the file's key, standing beside the store's
    /// for the link. Its scratch path is named by that same content key, so two
    /// builds of one tree share a file only when they would write the same bytes.
    fn object_of(store: Store, a: Analysis) -> Made {
        let path = a.view.source.file
        let key = self.read_okey(store, path)
        Made {
            which: Owned.File(a.view.file),
            key: key,
            obj: "${build_cache_root(self)}/obj/${key}.o",
            source: path,
        }
    }

    /// A read file's object key: its parts, with the sets its collects gather now —
    /// a member that moved what a collect bakes moves the object its collector builds.
    fn read_okey(store: Store, path: string) -> string {
        let parts = self.key_parts_cached(store, self.module_path_of(path), path)
        let now = [self.gathered_set(g, self.file_id(path)) for g in self.gatherings(path)]
        if fields_wire(now) == fields_wire(parts.gathered) { self.held_okey(store, path) } else { object_key_of_parts(self, parts with { gathered: now }) }
    }

    /// THE PROGRAM'S MODULE AS AN OBJECT: keyed by its own bytes when it was lowered
    /// here — written every build, compiled only when they moved, so a home's edit
    /// that moves no instantiation compiles nothing — and by what it is a function
    /// of when it was not. The `.o` is named by its key, as `object_of`'s is; the
    /// `.bc` a key is computed from has no key yet, so its scratch name is call-unique.
    fn program_objects(full: Lowered, tools: Toolchain) -> Result<List<Made>, BuildError> {
        let _ = make_dirs(joined_path(build_cache_root(self), "obj"))
        if traced() {
            for b in full.fns {
                if home_of(b) == null { qtrace("Q\tplaced\t${b.name}\t${program_bucket(b, PROGRAM_BUCKETS)}\n") }
            }
        }
        mut made: List<Made> = []
        let ix = emit_index(full)
        for i in occupied_buckets(full) {
            // LICENSED input.scratch_name: a call-unique scratch name, never an input of what is built
            let bc = "${build_cache_root(self)}/obj/${node_key(Stored.Obj, ["bc-scratch", "${i}", "${now_ns()}"])}.bc"
            let key = self.bytes_keyed(full, ix, bc, Owned.Bucket(i, PROGRAM_BUCKETS), tools)?
            if traced() { qtrace("Q\tbucket\t${i}\t${key}\n") }
            made.push(self.bucket_made(i, key))
        }
        .Ok(made)
    }

    /// One program bucket's object, named by its key as `object_of`'s is.
    fn bucket_made(i: int, key: string) -> Made {
        Made {
            which: Owned.Bucket(i, PROGRAM_BUCKETS),
            key: key,
            obj: "${build_cache_root(self)}/obj/${key}.o",
            source: "",
        }
    }

    /// EVERY OBJECT A BUILD OWES, STANDING AND KEPT. One the store holds is linked where it stands;
    /// the rest are made ONE way — here, by the compiler that runs, a worker each —
    /// so a tree's objects are the same bytes however many a build had to make. The
    /// workers are waited for whatever broke: a module handed over is theirs.
    fn objects_kept(d: Derived, full: Lowered, objects: List<Made>, tools: Toolchain) -> Result<
        int,
        BuildError,
    > {
        let owed = [o for o in objects if !d.store.has(Stored.Obj, o.key)]
        if traced() {
            qtrace(
                "Q\tobjects\t${owed.length}\t${objects.length}\t${owed.filter((o: Made) -> in_bucket(o.which)).length}\t${objects.filter((o: Made) -> in_bucket(o.which)).length}\n",
            )
        }
        let broke = handed(full, owed, opt_level(tools.opt), tools.target)
        let unwritten = objects_made()
        if broke != null || unwritten != null { fail BuildError.EmitFailed(broke ?? unwritten!) }
        for o in owed { let _ = d.store.keep_file(Stored.Obj, o.key, o.obj, []) }
        owed.length
    }

    /// Every held file's object, where the store keeps it: it links in place.
    fn held_objects(store: Store) -> Result<List<Made>, BuildError> {
        let held = [self.held_object(store, path) for path in held_paths(self)]
        let gone = held.find((o: Made) -> !store.has(Stored.Obj, o.key))
        if gone != null { fail BuildError.ObjectGone(gone!.source) }
        held
    }

    fn held_object(store: Store, path: string) -> Made {
        let key = self.held_okey(store, path)
        Made {
            which: Owned.File(self.file_id(path)),
            key: key,
            obj: store.path(Stored.Obj, key),
            source: path,
        }
    }
}

/// A program's own module.
fn runner_module(named: string) -> ProgramModule {
    ProgramModule { main: (types: TypeRegistry) -> runner_entry(types, program_symbol(named)) }
}

/// How many modules the program's own bodies are split into: an edit that moves a few
/// instantiations compiles the few buckets they fall in, on every worker. More buckets cost
/// every module a scan of the program (cli one-edit emit at 16 / 64 / 256: 1.6-2.0 / 1.8-2.2 / 2.6-3.4 s).
const PROGRAM_BUCKETS: int = 32

/// The buckets with a body in them, bucket 0 always (it carries the entry).
fn occupied_buckets(full: Lowered) -> List<int> {
    let used = distinct(
        ["${program_bucket(b, PROGRAM_BUCKETS)}" for b in full.fns if home_of(b) == null],
    )
    [i for i in 0..PROGRAM_BUCKETS if i == 0 || used.contains("${i}")]
}

/// Where the buckets a program's asks were built as are listed.
fn buckets_key(asked: string) -> string { node_key(Stored.Unit, ["program-buckets", asked]) }

/// The list as the store keeps it: a line per bucket, its index and its object's key.
fn buckets_text(made: List<Made>) -> string { joined([bucket_line(o) for o in made], "\n") }

fn bucket_line(o: Made) -> string {
    match o.which { .Bucket(i, _) -> "${i}\t${o.key}", .Whole or .File(_) or .Program -> "" }
}

/// A kept list back as (index, key) pairs.
fn buckets_of(raw: string) -> List<BucketKey> {
    [BucketKey { index: parse_int(l.split("\t")[0]) ?? 0, key: l.split("\t")[1] } for l in raw.split("\n") if l.contains("\t")]
}

type BucketKey = { index: int, key: string }

fn in_bucket(which: Owned) -> bool {
    match which { .Bucket(_, _) -> true, .Whole or .File(_) or .Program -> false }
}

/// WHAT THE PROGRAM'S MODULE IS A FUNCTION OF: the program's asks, its entry, and
/// what compiles it.
fn program_asked_key(d: Derived, main: ProgramMain, tools: Toolchain) -> string {
    node_key(
        Stored.Obj,
        [
            "program",
            d.asked,
            "${fp_list([i.fingerprint() for i in main.body.ins])}",
            joined(d.lowered.code_hashes, "\n"),
            tools.opt,
            tools.runtime,
            tools.mode(),
        ],
    )
}

/// THE EXTERNS NOTHING HERE ANSWERS: no runtime row, no package's
/// library, no host fn of the program, and no symbol the runtime archive
/// defines — what a failed link most likely lacked. A host's own row is one
/// of these on every target but that host's.
// LICENSED compiler.free_state_verb: a pure PROJECTION — a program in, the names nothing in it defines out.
fn unanswered_externs(l: Lowered, defined: List<string>, archive: string) -> List<string> {
    let claimed = flatten([p.externs for p in l.libraries if p.library != ""])
    [row.name for row in l.externs if !rt_sigs().any(it.name == row.name) &&
        !claimed.contains(row.name) &&
        !defined.contains(row.name) &&
        !named_in(archive, row.name)]
}

/// Whether an archive's index text names `name` as a whole symbol: the index ends
/// each name with a NUL, and a mach-o name wears a leading `_`.
fn named_in(archive: string, name: string) -> bool {
    archive.contains(name + from_codepoint(0))
}

/// The text of an `ar` archive's first member when it is the symbol index —
/// GNU's `/` or the BSD `__.SYMDEF` — and none otherwise. A member's header is
/// 60 bytes after the 8-byte magic, its size the ten digits at offset 48.
fn armap_text(archive: Bytes) -> string {
    if archive.length < 68 { return "" }
    let name = archive.slice(8, 24).text_lossy()
    let size = parse_int(archive.slice(56, 66).text_lossy().trim()) ?? 0
    let data = archive
        .slice(68, if 68 + size > archive.length { archive.length } else { 68 + size })
        .text_lossy()
    if name.starts_with("/ ") || name.starts_with("#1/") && data.contains("__.SYMDEF") { data } else { "" }
}

fn unanswered_note(names: List<string>) -> string {
    if names.is_empty() { return "" }
    "\nno package's library and no host fn of this program defines ${["`${n}`" for n in names].join(", ")} — when the linker names one of them, a host answers it: build for that host, or answer it here with `extern fn ${names[0]}(…) { … }`"
}

/// THE LINKED FILE AS IT SHIPS, the one staged file left standing: a wasm
/// module is what a browser downloads, so it is shrunk when the host offers
/// the optimizer and that succeeds — the link's own answer otherwise, and the
/// build says so. What a build keeps and what it publishes are both this file.
fn shipped(staged: string, tools: Toolchain) -> Shrunk {
    if tools.target == "" || tools.wasm_opt == "" { return Shrunk { path: staged, said: "" } }
    let shrunk = staged_beside(staged)
    if !wasm_opt_tries(staged, shrunk).any((words) -> wasm_opt_runs(tools.wasm_opt, words)) {
        let _ = remove(shrunk)
        return Shrunk { path: staged, said: unoptimized(tools.wasm_opt) }
    }
    let _ = remove(staged)
    Shrunk { path: shrunk, said: "" }
}

/// The declarations a program's module brings that nothing standing makes — each once.
fn undeclared(brought: List<Body>, stand: List<Body>) -> List<Body> {
    mut named: Map<string, bool> = {}
    for bd in stand { named.set(bd.name, true) }
    mut out: List<Body> = []
    for c in brought {
        if named.get(c.name) == null { out.push(c) }
        named.set(c.name, true)
    }
    out
}

/// The program lowered whole, in emission order, or the symbol nothing declares.
fn closed(full: Lowered) -> Result<Lowered, BuildError> {
    let missing? = program_closed(full) else { return in_symbol_order(full) }
    fail BuildError.NotClosed(missing)
}

/// A refusal in the derivation's words is the build's own `Diagnosed` refusal.
fn diagnosed<T>(r: Result<T, string>) -> Result<T, BuildError> {
    match r { .Ok(v) -> .Ok(v), .Err(report) -> .Err(BuildError.Diagnosed(report)) }
}

/// Objects in their SOURCES' order: the link's order is never the hold's, so one
/// tree links to one binary however it was reached.
fn by_source(objects: List<Made>) -> List<Made> {
    flatten(
        [[o for o in objects if o.source == source] for source in sorted_texts([o.source for o in objects])],
    )
}

/// A file's bytes as their length and their digest.
fn digest_of_file(text: string) -> string { "${text.length}.${digest_of(text)}" }

/// Every owed object's module built and handed to a worker — the first
/// refusal, or null. `objects_made` waits for them.
fn handed(full: Lowered, owed: List<Made>, opt: int, target: string) -> string? {
    let ix = emit_index(full)
    for o in owed {
        let broke = emit_object(full, ix, o.obj, o.which, opt, target)
        if broke != null { return broke }
    }
    null
}

// ── The voices ──

fn object_gone(path: string) -> string {
    "avra: a held object disappeared: ${path}"
}

fn objects_missing(paths: List<string>) -> string {
    "avra: a package's C is not built: ${paths.join(", ")} — `make libs` builds the package objects of a checkout (`make wasm-packages` for a wasm target)"
}

fn unpublished(path: string) -> string {
    "avra: the built binary could not be moved into place — ${path}"
}

fn module_unreadable(path: string) -> string {
    "avra: the entry's module could not be read back — ${path}"
}

fn unoptimized(tool: string) -> string {
    "warning: `${tool}` refused the linked module under the features its link uses, so it ships unoptimized — a size cost, never another program"
}

fn no_fallback(tool: string) -> string {
    "warning: `${tool}` could not asyncify the module, so none ships for a host that cannot suspend a stack"
}

fn wasm_unsupported(names: List<string>) -> string {
    "avra: a wasm module has no body for ${names.join(", ")} — a fiber, a core and a package's C are not available on this target"
}

/// A directory a program's closure covers: a package's source and its root, as paths here.
type CoveredDir = { src: string, root: string }

/// One line of an input manifest.
enum ManifestEntry {
    Covered(line: string)
    Listing(dir: string, word: string)
    /// An input: its path, the line of the key it stands for, and the stamp its
    /// bytes wore when that line's digest was taken — empty when the host would
    /// not make that claim, and then its bytes are read again.
    Input(path: string, line: string, stamp: string)
    Embed(path: string, line: string)
    Object(path: string, line: string)
}

impl ManifestEntry {
    /// The entry as a manifest spells it: a tag, then its fields, tab-apart.
    fn spelled() -> string {
        match self {
            .Covered(line) -> "C\t${line}",
            .Listing(dir, word) -> "L\t${dir}\t${word}",
            // `S` carries the stamp its digest was taken with; `I` (a record
            // older than stamps, or one whose host would not give one) carries
            // the digest alone and is always read again.
            .Input(path, line, stamp) -> if stamp.is_empty() { "I\t${path}\t${line}" } else { "S\t${path}\t${stamp}\t${line}" },
            .Embed(path, line) -> "E\t${path}\t${line}",
            .Object(path, line) -> "O\t${path}\t${line}",
        }
    }

    /// What kind of input the entry confirms, as a phase's name.
    fn kind_word() -> string {
        match self {
            .Covered(_) -> "covered",
            .Listing(_, _) -> "listings",
            .Input(_, _, _) -> "inputs",
            .Embed(_, _) -> "embeds",
            .Object(_, _) -> "objects",
        }
    }

    /// The closure line this entry stands for, none for any other.
    fn covered() -> List<string> {
        match self {
            .Covered(line) -> [line],
            .Listing(_, _) or .Input(_, _, _) or .Embed(_, _) or .Object(_, _) -> [],
        }
    }
}

/// An entry read back; none for a line that is no entry.
fn read_entry(line: string) -> ManifestEntry? {
    let at = line.index_of("\t")
    if at < 1 { return null }
    let tag = line.substring(0, at)
    let rest = line.substring(at + 1, line.length)
    if tag == "C" { return ManifestEntry.Covered(rest) }
    let cut = rest.index_of("\t")
    if cut < 0 { return null }
    let first = rest.substring(0, cut)
    let second = rest.substring(cut + 1, rest.length)
    when {
        tag == "L" -> ManifestEntry.Listing(first, second)
        tag == "I" -> ManifestEntry.Input(first, second, "")
        tag == "S" -> {
            let mark = second.index_of("\t")
            if mark < 1 {
                null
            } else {
                ManifestEntry
                    .Input(first, second.substring(mark + 1, second.length), second.substring(0, mark))
            }
        }
        tag == "E" -> ManifestEntry.Embed(first, second)
        tag == "O" -> ManifestEntry.Object(first, second)
        _ -> null
    }
}

/// Whether `wasm-opt` ran clean over `words`.
fn wasm_opt_runs(tool: string, words: List<string>) -> bool {
    // LICENSED input.staged_output: post-processes the program just built, never an input of what is built
    avra_spawn_status(tool, words) == 0
}
