//! How `avra cache` names things to a person: a stable name on one
//! line, and a typed query resolved against the names a pack knows. The
//! pack layer (compiler/store/explain.av) never reads a name's meaning;
//! this is where it is read, through `name_parts`, the one decoder.

/// A name's family word — null for a name no family claims (a file's or a
/// module's own stable name).
export fn key_family(name: string) -> string? { name_parts(name)?.family }

/// A name a person can read and type: its family and its argument's own
/// fields on one line, `Analysis(file · /w/src/b.av)`. A name no family
/// claims shows its own fields the same way.
export fn shown_name(name: string) -> string {
    let parts? = name_parts(name) else { return joined_fields(name) }
    "${parts.family}(${joined_fields(parts.arg)})"
}

fn joined_fields(text: string) -> string { text.split("\n").join(" · ") }

/// The names a typed query means: an exact match on the display form
/// alone when there is one, else every name whose display form holds the
/// query.
export fn matching_names(names: List<string>, query: string) -> List<string> {
    let exact = [n for n in names if shown_name(n) == query]
    if exact.is_empty() { [n for n in names if shown_name(n).contains(query)] } else { exact }
}
