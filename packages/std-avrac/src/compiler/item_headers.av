//! THE C HEADERS A PACKAGE NAMES, read on the program layer: each header its manifest's `[link]`
//! row names, read through the engine as a source's text is, and handed to clang on its stdin, so a
//! header in a world that is not on a disk is read the same way as one that is. A system header
//! (`<math.h>`) is clang's to find, read by an empty unit that includes it. What clang declares is
//! read into canonical types (`c_decls`); a header clang refuses, or that no clang reads, is kept
//! with why, never read as one that declares nothing.
//!
//! A DUMP IS HELD BY EVERYTHING CLANG READ TO MAKE IT: the header's text (its argument), clang's
//! own binary, and every header the unit includes, as clang names them (`-H`) — so an edit to a
//! header three includes down, or another clang, reads the header again. An included header is read
//! whole, so where its stamp cannot tell (a file written a moment ago) its text decides.
use compiler.host.{CDecl, c_decls, lp64}
use core.{flatten}
use @std.meta.{derive}
use @std.io.{read_text}
use @std.path.{dir_of, is_absolute, joined_path, normalized}
use @std.process.{Exit, Tool, cmd, tool_from_env}
use @std.program.address.{source_file}
use @std.program.query_engine.{QueryDefinition, QueryEngine, read_stamped}
use @std.program.saved_derive.{Saved}
use @std.program.saved_query.{ListedQuery, definitions_of, input, query, query_definition}
use @std.program.source_facts.{package_lies, source_text}

/// What reading one header found: clang's dump, or why there is none.
@derive(Saved)
export enum HeaderRead {
    Dumped(dump: string)
    /// No file stands where the manifest says the header does.
    Missing
    /// Clang refused it, in its words.
    Refused(why: string)
}

/// A header that declared nothing to read: its word as the manifest wrote it, and why.
@derive(Saved)
export type UnreadHeader = { header: string, why: string }

/// What a package's headers declare, and the headers that could not be read.
@derive(Saved)
export type PackageHeaders = { decls: List<CDecl>, unread: List<UnreadHeader> }

/// Every function the headers `package`'s manifest names declare, in the order the manifest names
/// them; a package naming no headers declares none.
@query("laws")
export fn package_headers(engine: QueryEngine, package: string) -> PackageHeaders {
    let read = [Named { header: h, read: header_read(engine, package, h) } for h in manifest_judged(engine, package).headers]
    PackageHeaders {
        decls: flatten([declared_in(n.read) for n in read]),
        unread: [UnreadHeader { header: n.header, why: why_unread(n.read) } for n in read if !declares(n.read)],
    }
}

/// A header's word beside what reading it found.
type Named = { header: string, read: HeaderRead }

/// What reading the header `word` of `package` finds: a path in the package read through the
/// engine, or a system header clang finds itself.
fn header_read(engine: QueryEngine, package: string, word: string) -> HeaderRead {
    let root = package_lies(package) ?? ""
    let dirs = searched(root, manifest_judged(engine, package).include)
    if word.starts_with("<") {
        return clang_dump(
            engine,
            "",
            root,
            dirs.concat(["-include", word.substring(1, word.length - 1)]),
        )
    }
    let text? = source_text(engine, source_file(package, word)) else { return HeaderRead.Missing }
    let beside = if root.is_empty() { [] } else { ["-I", dir_of(joined_path(root, word))] }
    named_as(clang_dump(engine, text, root, beside.concat(dirs)), word)
}

/// A read whose refusal names the header as the manifest does, where clang names its stdin.
fn named_as(read: HeaderRead, word: string) -> HeaderRead {
    match read {
        .Refused(why) -> HeaderRead.Refused(why.replace("<stdin>", word)),
        .Dumped(_) or .Missing -> read,
    }
}

/// The `-I` flags for a package's `include` rows, each rooted at the package where it lies; none for
/// a package that lies on no disk.
fn searched(root: string, include: List<string>) -> List<string> {
    if root.is_empty() { return [] }
    flatten([["-I", joined_path(root, dir)] for dir in include])
}

/// Clang's dump of a unit whose text is `text`, read from `cwd` with `flags` before it: held by
/// clang's own stamp and by each header the unit includes.
@input("laws")
fn clang_dump(engine: QueryEngine, text: string, cwd: string, flags: List<string>) -> HeaderRead {
    let clang? = clang_tool() else { return HeaderRead.Refused("no clang is found") }
    let ran = read_stamped(engine, clang.path, () -> clang_ran(clang, text, cwd, flags))
    for path in ran.included {
        let at = included_at(cwd, path)
        // LICENSED input.tool_run: a header clang included, read whole under its stamp so its text decides where the stamp cannot
        let _ = read_stamped(engine, at, () -> read_text(at) catch "")
    }
    ran.read
}

/// What one run of clang found: its dump or why there is none, and the headers it included.
type ClangRun = { read: HeaderRead, included: List<string> }

/// Clang run once over `text` on its stdin.
fn clang_ran(clang: Tool, text: string, cwd: string, flags: List<string>) -> ClangRun {
    let args = ["-H", "-fsyntax-only", "-Xclang", "-ast-dump=json"]
        .concat(flags)
        .concat(["-x", "c", "-"])
    let at: string? = if cwd.is_empty() { null } else { cwd }
    // LICENSED input.tool_run: clang reads the header's text on its stdin, and each header it includes is held by its stamp
    match (cmd(clang, args) with { stdin: .Text(text), cwd: at }).outcome() {
        .Ok(o) -> ClangRun {
            read: judged(o.exit, o.out.stdout, o.out.stderr),
            included: included_by(o.out.stderr),
        },
        .Err(_) -> ClangRun { read: HeaderRead.Refused("clang did not run"), included: [] },
    }
}

/// A run's read: its dump where clang exited clean, else clang's first error in its words.
fn judged(exit: Exit, dump: string, said: string) -> HeaderRead {
    match exit {
        .Clean or .Code(0) -> HeaderRead.Dumped(dump),
        .Code(_) or .Signal(_, _) -> HeaderRead.Refused(first_error(said)),
    }
}

/// The first line clang says is an error, or that it refused, where it says none.
fn first_error(said: string) -> string {
    said.split("\n").find(it.contains("error:"))?.trim() ?? "clang refused the header"
}

/// The headers `-H` names on stderr: a line of dots, a space, then the path.
fn included_by(said: string) -> List<string> {
    [line.substring(line.index_of(" ") + 1, line.length) for line in said.split("\n") if line.starts_with(".") && line.contains(" ")]
}

/// A path `-H` names, rooted where clang ran.
fn included_at(cwd: string, path: string) -> string {
    if is_absolute(path) || cwd.is_empty() { return path }
    normalized(joined_path(cwd, path))
}

/// The C compiler `CC` names, else `clang` on the PATH; none where neither stands.
fn clang_tool() -> Tool? {
    // LICENSED input.tool_run: the C compiler a header is read with, found as the link finds its own
    match tool_from_env("CC", "clang") { .Ok(t) -> t, .Err(_) -> null }
}

/// What a read declares: a dump's functions, or none.
fn declared_in(read: HeaderRead) -> List<CDecl> {
    match read { .Dumped(dump) -> c_decls(dump, lp64()) catch [], .Missing or .Refused(_) -> [] }
}

/// Whether a read is one a dump answers, so nothing is said of it.
fn declares(read: HeaderRead) -> bool {
    match read { .Dumped(dump) -> c_decls(dump, lp64()) is .Ok, .Missing or .Refused(_) -> false }
}

/// Why a read declares nothing.
fn why_unread(read: HeaderRead) -> string {
    match read {
        .Dumped(_) -> "clang's dump could not be read",
        .Missing -> "no file stands there",
        .Refused(why) -> why,
    }
}

collect listed_header_facts: List<ListedQuery> = @query_definition in self as ListedQuery { definition: it } by it.name

/// The queries a package's headers are read through, for a process to hand its engine.
export fn header_fact_definitions() -> List<QueryDefinition> { definitions_of(listed_header_facts) }
