//! THE C HEADERS A PACKAGE NAMES, read on the program layer: each header its manifest's `[link]`
//! row names, read through the engine as a source's text is, and handed to clang on its stdin, so a
//! header in a world that is not on a disk is read the same way as one that is. A system header
//! (`<math.h>`) is clang's to find, read by an empty unit that includes it. What clang declares is
//! read into canonical types (`c_decls`) under the build target's data model; a header clang
//! refuses, or that no clang reads, is kept with why, never read as one that declares nothing.
//!
//! ONE HEADER, ONE QUESTION, AND ONE INPUT PER FILE IT READ. Each header is its own question, so an
//! edit re-reads only the header whose files moved. That question reads the header's text, clang
//! (by its stamp and its version), the build target, and every header the unit includes — each its
//! own input, held by its own stamp and answering its text, since an input is held by one stamp.
//!
//! THE DATA MODEL IS THE TARGET'S, AS CLANG SAYS IT: `long`'s width and `char`'s sign are read
//! from clang's own definitions for the build's target (`-dM -E`), never from a table — wasm32's
//! `long` is 32 bits and aarch64 Linux's `char` is unsigned.
use compiler.host.{CDecl, DataModel, c_decls, lp64}
use core.{flatten}
use @std.io.{read_text}
use @std.meta.{derive}
use @std.path.{dir_of, is_absolute, joined_path, normalized}
use @std.process.{Exit, Tool, cmd, tool_from_env}
use @std.program.address.{source_file}
use @std.program.query_engine.{QueryDefinition, QueryEngine, read_stamped}
use @std.program.saved_derive.{Saved}
use @std.program.saved_query.{ListedQuery, definitions_of, input, query, query_definition}
use @std.program.source_facts.{package_lies, source_text}
use @std.text.{parse_int}

/// What one header declares, or why it declares nothing to read.
@derive(Saved)
export enum HeaderDecls {
    Declared(decls: List<CDecl>)
    Unread(why: string)
}

/// A header that declared nothing to read: its word as the manifest wrote it, and why.
@derive(Saved)
export type UnreadHeader = { header: string, why: string }

/// What a package's headers declare, and the headers that could not be read.
@derive(Saved)
export type PackageHeaders = { decls: List<CDecl>, unread: List<UnreadHeader> }

/// Every function the headers `package`'s manifest names declare, in the order the manifest names
/// them; a package naming no headers declares none.
@query("laws")
export fn package_headers(engine: QueryEngine, package: string) -> PackageHeaders {
    let read = [Named { header: h, read: header_decls(engine, package, h) } for h in manifest_judged(engine, package).headers]
    PackageHeaders {
        decls: flatten([declared_in(n.read) for n in read]),
        unread: [UnreadHeader { header: n.header, why: w } for n in read for w in unread_why(n.read)],
    }
}

/// A header's word beside what reading it found.
type Named = { header: string, read: HeaderDecls }

/// What the header `word` of `package` declares under the build target: a path in the package read
/// through the engine, or a system header clang finds itself.
@query("laws")
export fn header_decls(engine: QueryEngine, package: string, word: string) -> HeaderDecls {
    let root = package_lies(package) ?? ""
    let dirs = searched(root, manifest_judged(engine, package).include)
    if word.starts_with("<") {
        return dumped(
            engine,
            "",
            root,
            dirs.concat(["-include", word.substring(1, word.length - 1)]),
            word,
        )
    }
    let text? = source_text(engine, source_file(package, word)) else { return HeaderDecls.Unread("no file stands there") }
    let beside = if root.is_empty() { [] } else { ["-I", dir_of(joined_path(root, word))] }
    dumped(engine, text, root, beside.concat(dirs), word)
}

/// The `-I` flags for a package's `include` rows, each rooted at the package where it lies; none for
/// a package that lies on no disk.
fn searched(root: string, include: List<string>) -> List<string> {
    if root.is_empty() { return [] }
    flatten([["-I", joined_path(root, dir)] for dir in include])
}

/// What clang declares of a unit whose text is `text`, read from `cwd` with `flags` before it, under
/// the build target; its refusal names the header `word` where clang names its stdin. Each header
/// the unit includes is read as an input of its own.
fn dumped(engine: QueryEngine, text: string, cwd: string, flags: List<string>, word: string) -> HeaderDecls {
    if clang_seen(engine).is_empty() { return HeaderDecls.Unread("no clang is found") }
    let clang? = clang_tool() else { return HeaderDecls.Unread("no clang is found") }
    let ran = clang_ran(clang, text, cwd, targeted(build_target(engine)).concat(flags))
    for path in ran.included {
        let _ = included_text(engine, included_at(cwd, path))
    }
    match ran.read {
        .Dumped(dump) -> match c_decls(dump, target_model(engine)) {
            .Ok(decls) -> HeaderDecls.Declared(decls),
            .Err(why) -> HeaderDecls.Unread(why),
        },
        .Refused(why) -> HeaderDecls.Unread(why.replace("<stdin>", word)),
    }
}

/// The flag that names the build's target to clang; none for the host's.
fn targeted(target: string) -> List<string> {
    if target.is_empty() { return [] }
    ["--target=${target}"]
}

/// What a run of clang said: its dump, or its first error.
enum ClangSaid { Dumped(dump: string), Refused(why: string) }

/// What one run of clang found, and the headers it included.
type ClangRun = { read: ClangSaid, included: List<string> }

/// Clang run once over `text` on its stdin.
fn clang_ran(clang: Tool, text: string, cwd: string, flags: List<string>) -> ClangRun {
    let args = ["-H", "-fsyntax-only", "-Xclang", "-skip-function-bodies", "-Xclang", "-ast-dump=json"]
        .concat(flags)
        .concat(["-x", "c", "-"])
    let at: string? = if cwd.is_empty() { null } else { cwd }
    // LICENSED input.tool_run: clang reads the header's text on its stdin; every file it reads besides is an input of its own
    match (cmd(clang, args) with { stdin: .Text(text), cwd: at }).outcome() {
        .Ok(o) -> ClangRun {
            read: judged(o.exit, o.out.stdout, o.out.stderr),
            included: included_by(o.out.stderr),
        },
        .Err(_) -> ClangRun { read: ClangSaid.Refused("clang did not run"), included: [] },
    }
}

/// A run's read: its dump where clang exited clean, else clang's first error in its words.
fn judged(exit: Exit, dump: string, said: string) -> ClangSaid {
    match exit {
        .Clean or .Code(0) -> ClangSaid.Dumped(dump),
        .Code(_) or .Signal(_, _) -> ClangSaid.Refused(first_error(said)),
    }
}

/// The first line clang says is an error, or that it refused, where it says none.
fn first_error(said: string) -> string {
    said.split("\n").find(it.contains("error:"))?.trim() ?? "clang refused the header"
}

/// The headers `-H` names on stderr: a line of dots, a space, then the path.
fn included_by(said: string) -> List<string> {
    [line.substring(line.index_of(" ") + 1, line.length) for line in said.split("\n") if line.starts_with(".") && line.contains(" ")]
}

/// A path `-H` names, rooted where clang ran.
fn included_at(cwd: string, path: string) -> string {
    if is_absolute(path) || cwd.is_empty() { return path }
    normalized(joined_path(cwd, path))
}

/// A header clang included, by its path on the host: its text, held by its stamp, so it decides
/// where the stamp cannot.
@input("laws")
fn included_text(engine: QueryEngine, path: string) -> string {
    // LICENSED input.tool_run: a header clang included, read whole under its stamp
    read_stamped(engine, path, () -> read_text(path) catch "")
}

/// The clang a header is read with, as it says its version, held by the stamp of its binary; empty
/// where none is found.
@input("laws")
fn clang_seen(engine: QueryEngine) -> string {
    let clang? = clang_tool() else { return "" }
    read_stamped(engine, clang.path, () -> clang_version(clang))
}

/// What `clang --version` says.
fn clang_version(clang: Tool) -> string {
    // LICENSED input.tool_run: clang's own version, read under the stamp of its binary
    match cmd(clang, ["--version"]).outcome() { .Ok(o) -> o.out.stdout, .Err(_) -> "" }
}

/// The C compiler `CC` names, else `clang` on the PATH; none where neither stands.
fn clang_tool() -> Tool? {
    // LICENSED input.tool_run: the C compiler a header is read with, found as the link finds its own
    match tool_from_env("CC", "clang") { .Ok(t) -> t, .Err(_) -> null }
}

/// The target a build of this process compiles for, as its triple; empty for the host's.
once fn target_cell() -> Cell<string> { Cell.new("") }

/// Sets the target this process builds for — empty for the host's — before its engine works.
export fn use_build_target(triple: string) { target_cell().set(triple) }

/// The build's target, as an input: a build for another target reads every header again.
@input("laws")
fn build_target(_engine: QueryEngine) -> string { target_cell().get() }

/// The data model of the build's target, as clang defines it; LP64 where clang says nothing.
@query("laws")
fn target_model(engine: QueryEngine) -> DataModel {
    if clang_seen(engine).is_empty() { return lp64() }
    let clang? = clang_tool() else { return lp64() }
    let args = targeted(build_target(engine)).concat(["-dM", "-E", "-x", "c", "-"])
    // LICENSED input.tool_run: clang's own definitions for the target, read under its stamp
    match (cmd(clang, args) with { stdin: .Text("") }).outcome() {
        .Ok(o) -> modelled(o.out.stdout),
        .Err(_) -> lp64(),
    }
}

/// A data model from clang's definitions: `__SIZEOF_LONG__` in octets, `__CHAR_UNSIGNED__` where
/// a plain `char` has no sign.
fn modelled(defined: string) -> DataModel {
    let lines = defined.split("\n")
    DataModel {
        long_bits: long_octets(lines) * 8,
        char_signed: !lines.any(it.starts_with("#define __CHAR_UNSIGNED__")),
    }
}

/// The octets clang says a `long` holds, eight where it says none.
fn long_octets(lines: List<string>) -> int {
    let line? = lines.find(it.starts_with("#define __SIZEOF_LONG__ ")) else { return 8 }
    parse_int(line.substring(24, line.length).trim()) ?? 8
}

/// What a header's read declares: its functions, or none.
fn declared_in(read: HeaderDecls) -> List<CDecl> {
    match read { .Declared(decls) -> decls, .Unread(_) -> [] }
}

/// Why a header's read declares nothing, as a list of none or one.
fn unread_why(read: HeaderDecls) -> List<string> {
    match read { .Declared(_) -> [], .Unread(why) -> [why] }
}

collect listed_header_facts: List<ListedQuery> = @query_definition in self as ListedQuery { definition: it } by it.name

/// The queries a package's headers are read through, for a process to hand its engine.
export fn header_fact_definitions() -> List<QueryDefinition> { definitions_of(listed_header_facts) }
