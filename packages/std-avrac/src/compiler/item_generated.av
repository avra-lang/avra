//! WHAT A FILE'S ANNOTATIONS MAKE: the declarations a generator writes beside an annotated
//! declaration, each an item of its file after the written ones, read back and signed as one. A
//! name a generated item's own file doesn't bind is read where its generator was written.
//!
//! The generator runs behind a door the process sets (`use_generator_door`), so what it makes is an
//! input: asked again in every process, its readers standing when it comes out the same.
use core.{SyntaxArena, StmtId, flatten, new_node_store}
use @std.meta.{derive}
use @std.program.address.{SourceFileAddress}
use @std.program.query_engine.{QueryDefinition, QueryEngine}
use @std.program.saved_derive.{Saved}
use @std.program.saved_query.{ListedQuery, definitions_of, input, query, query_definition}
use @std.program.source_facts.{PlacedTape, item_tape}
use @std.program.syntax_tape.{SyntaxTape}

/// Declarations one generator made, on one tape, and the file its templates were written in.
@derive(Saved)
export type GeneratedItem = { tape: SyntaxTape, home: SourceFileAddress }

/// What generators made, in the order their declarations are written.
@derive(Saved)
export type GeneratedItems = { items: List<GeneratedItem> }

/// What runs a file's generators: the items made over the declaration a file writes under a name.
export type GeneratorDoor = { made: fn(SourceFileAddress, string) -> List<GeneratedItem> }

once fn door_cell() -> Cell<GeneratorDoor?> {
    let no_door: GeneratorDoor? = null
    Cell.new(no_door)
}

/// Sets what runs this process's generators.
export fn use_generator_door(door: GeneratorDoor) { door_cell().set(door) }

/// What the generators of the declaration `file` writes as `name` make, its item written as
/// `item_text`; nothing when no door is set.
@input
fn generated(_engine: QueryEngine, file: SourceFileAddress, item_text: string, name: string) -> GeneratedItems {
    let door? = door_cell().get() else { return GeneratedItems { items: [] } }
    GeneratedItems { items: (door.made)(file, name) }
}

/// What the generators of every annotated declaration a file writes make, in the order written.
@query
export fn file_generated(engine: QueryEngine, file: SourceFileAddress) -> GeneratedItems {
    GeneratedItems {
        items: flatten(
            [made_over(engine, file, item) for item in items_under(engine, file) if item.text.contains("@")],
        ),
    }
}

/// What the generators of an item's annotated declarations make.
fn made_over(engine: QueryEngine, file: SourceFileAddress, item: ItemUnder) -> List<GeneratedItem> {
    let store = new_node_store()
    let stmts = item_read_back(
        store,
        PlacedTape { start: item.start, tape: item_tape(engine, item.text, item.context) },
    )
    flatten(
        [generated(engine, file, item.text, store.declared_name(s)!).items for s in stmts if annotated(store, s)],
    )
}

/// Whether a statement declares a name and wears an annotation.
fn annotated(store: SyntaxArena, s: StmtId) -> bool { store.declared_name(s) != null && !store.annotations_of(s).is_empty() }

/// The generated item `at` names among a file's items, counting past its written ones; absent for
/// a written one.
export fn generated_at(engine: QueryEngine, file: SourceFileAddress, at: int) -> GeneratedItem? {
    let k = at - items_under(engine, file).length
    if k < 0 { return null }
    file_generated(engine, file).items[k]
}

/// What each generated item of a file keeps for its words, in the order made.
fn generated_abouts(engine: QueryEngine, file: SourceFileAddress) -> List<ItemAbout> {
    [about_of(g.tape.about) for g in file_generated(engine, file).items]
}

collect listed_generated_facts: List<ListedQuery> = @query_definition in self as ListedQuery { definition: it } by it.name

/// The queries what annotations make reads through, for a process to hand its engine.
export fn generated_fact_definitions() -> List<QueryDefinition> { definitions_of(listed_generated_facts) }
