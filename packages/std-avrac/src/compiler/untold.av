//! Avra's generated parser, and what holds it to the grammar it was made from.
use @std.grammar.{Ready, UntoldTarget, render_grammar}
use features.{BuilderRow}
use @std.relation.stable.{text_hash}

/// What the generated parser runs by, made once per language: its builders by its own index, the
/// lexer's kind of each class it numbers, and what each kind of token wears of them.
export type UntoldParse = { rows: List<BuilderRow?>, kinds: List<int>, worn: Cell<List<int>> }

/// The print a generated parser is held to: the assembled grammar, as text.
export fn grammar_print(rd: Ready) -> int { text_hash(render_grammar(rd.g)) }

/// What Avra's generated parser is written as: its names, its types, its uses.
export fn avra_untold_target(rd: Ready) -> UntoldTarget {
    UntoldTarget {
        prefix: "avra",
        token: "Token",
        node: "LangNode",
        uses: ["use grammar.{Token}", "use features.{LangNode}"],
        print: grammar_print(rd),
    }
}
