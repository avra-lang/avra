/// A literal an annotation argument reaches, in the file it stands.
export type Spelled = { file: FileId, e: ExprId }

/// A mark and the file that wrote it.
/// A mark, the file that wrote it, and — for a gathered member's — the
/// enum it is held to.
type WornMark = { mark: Mark, file: FileId, gatherer: string? = null }

/// Each of `marks`, worn where `f` wrote it.
fn worn_in(f: FileId, marks: List<Mark>) -> List<WornMark> { [WornMark { mark: m, file: f } for m in marks] }

/// A lifted call's absent answer — nothing crossed, in a heap of
/// its own.
fn absent_lifted() -> Lifted { Lifted { answer: MetaVal.Absent, heap: new_meta_heap() } }

/// An annotation as its source spells it: its name, then each argument's own text.
fn annotation_said(p: Parsed, name: string, args: List<ExprId>) -> string {
    "${name}(${[written(p, e) for e in args].join(", ")})"
}

/// An expression's source text — for one with no place in this file's text
/// (none at all, or a copy spanned in its origin's), its literal's own text.
fn written(p: Parsed, e: ExprId) -> string {
    let here: Span? = if p.store.spanned_elsewhere(e) { null } else { p.store.expr_span(e) }
    let at? = here else { return arg_text(p.store, e) }
    p.source.text.substring(at.lo, at.hi)
}

