//! A SUGAR'S MEANING, MINTED: the node answers `means()` — a `Rewrite`,
//! the template it expands to, its holes the ids of the node's own fields —
//! and the language, which alone can read a template, parses that template
//! once and splices a copy beside the sugar with the holes filled. The
//! template is never run on the program's values: its holes are read, and
//! the scratch parse is kept for the process, keyed by the template's text.
use core.{
    Minting,
    minting,
    SyntaxArena,
    ExprId,
    PatId,
    StmtId,
    HoleKind,
    Filled,
    Means,
    copier,
    hole_runs,
    flatten,
    same_expr,
}
use @std.meta.{Rewrite, Node}
use diagnostics.{new_source_file}
use features.{BlockWords, MeanCx, Meaning}
use @std.relation.engine.{map_cell}

/// One template's parse: the store that holds it and the quote it was
/// written in.
type Scratch = { store: SyntaxArena, body: ExprId }

once fn kept() -> Cell<Map<string, Scratch>> { map_cell() }

/// The door a language opens for the sugars of the stores it parses.
export fn sugar_door(lang: Language) -> Means {
    (store: SyntaxArena, sugar: ExprId) -> minted_means(lang, store, sugar)
}

/// What the sugar means, copied beside it: the nodes the copy minted, the
/// last the root; none when the node is no sugar or its template cannot be
/// read here.
fn minted_means(lang: Language, store: SyntaxArena, sugar: ExprId) -> Result<Minting, string> {
    let node = store.expr(sugar)
    let cx = MeanCx {
        store: store,
        at: sugar,
        span: store.expr_span(sugar),
        provided: store.provided_of(sugar),
        door: sugar_door(lang),
    }
    let said? = node.means(cx) else { return node.minted(cx) }
    match (said?).node {
        .Template(_, _, parts, fills) -> .Ok(minting(spliced(lang, store, sugar, parts, fills, ""))),
        rest -> .Ok(minting([])),
    }
}

/// A rewrite's template copied beside `sugar` with its holes filled and its own names made fresh, so
/// none captures or is captured by a name of the code it lands in: the nodes made, the root last;
/// none when the template can't be read here.
export fn rewritten_beside(store: SyntaxArena, sugar: ExprId, said: Rewrite) -> List<ExprId> {
    match said.node {
        .Template(_, _, parts, fills) -> spliced(avra(), store, sugar, parts, fills, "·e${sugar.index}"),
        rest -> [],
    }
}

/// A rewrite's statements copied in place of the statement `sugar`, holes filled and its own names
/// made fresh: the statements made, in order; none when the template can't be read here.
export fn stmts_rewritten_beside(store: SyntaxArena, sugar: StmtId, said: Rewrite) -> List<StmtId> {
    match said.node {
        .Template(_, _, parts, fills) -> copied_template(avra(), store, parts, fills, "·s${sugar.index}")?.stmts ?? [],
        rest -> [],
    }
}

/// The template's runs with a hole between each, as the quote it was
/// written in.
fn woven_quote(parts: List<string>) -> string {
    let holed = [p + "\${0}" for p in parts.slice(0, parts.length - 1)].join("")
    "quote { ${holed}${parts.last()!} }"
}

fn spliced(
    lang: Language,
    store: SyntaxArena,
    sugar: ExprId,
    parts: List<string>,
    fills: List<Node>,
    fresh: string,
) -> List<ExprId> {
    let copy? = copied_template(lang, store, parts, fills, fresh) else { return [] }
    let last? = copy.stmts.last() else { return [] }
    let root? = store.answer_of(last) else { return [] }
    let at = store.expr_span(sugar)
    if at != null { for m in copy.exprs { store.place_expr(m, at!) } }
    copy.exprs.filter(!same_expr(it, root)).concat([root])
}

/// A template copied into `store`: the statements it is, and every expression the copy made.
type TemplateCopy = { stmts: List<StmtId>, exprs: List<ExprId> }

/// The template's statements copied into `store`, holes filled and its own names marked `fresh`;
/// absent when the template can't be read here.
fn copied_template(
    lang: Language,
    store: SyntaxArena,
    parts: List<string>,
    fills: List<Node>,
    fresh: string,
) -> TemplateCopy? {
    let s? = scratch(lang, woven_quote(parts)) else { return null }
    let body? = s.store.expr(s.body).body_of() else { return null }
    let stmts: List<StmtId> = match body.view { .Verbatim(ss, _) -> ss, rest -> [] }
    if stmts.is_empty() { return null }
    let thunks = [(kind: HoleKind) -> filled(kind, fill) for fill in fills]
    mut rb = copier(s.store, store, thunks, hole_runs(s.store, s.body), sugar_door(lang)) with { fresh: fresh }
    let copied = rb.stmts(stmts)
    TemplateCopy { stmts: copied, exprs: flatten([rb.made_exprs, rb.holed_exprs]) }
}

/// A hole's fill in the seat it stands in: an id, as the seat reads it; a name, as written; a held
/// node, where a node of its arena stands; a run of held nodes, where statements or a run stand;
/// any other a refusal the splice speaks.
fn filled(kind: HoleKind, fill: Node) -> Filled {
    let index = match fill { .Int(i) -> i, rest -> null }
    if index != null { return id_filled(kind, index!) }
    let named = match fill { .Name(text) -> text, rest -> null }
    if named != null { return Filled.Name(named!) }
    let one = held_at(fill)
    if one != null { return held_filled(kind, one!) }
    let run? = held_run(fill) else { return Filled.Unplaceable("a rewrite's hole holds no node") }
    run_filled(kind, run)
}

/// An id in the seat it stands in: an expression or a pattern.
fn id_filled(kind: HoleKind, index: int) -> Filled {
    match kind {
        .Expression or .Tail -> Filled.Expr(ExprId { index: index }),
        .Binder -> Filled.Pat(PatId { index: index }),
        rest -> Filled.Unplaceable("a rewrite's hole stands where an expression or a pattern does"),
    }
}

/// A node of the arena a fill holds: its arena's word and its index.
type Held = { arena: string, index: int }

/// The node a fill holds, absent for a fill that holds one node of no arena.
fn held_at(fill: Node) -> Held? {
    let items? = match fill { .Many(items) -> items, rest -> null } else { return null }
    if items.length != 2 { return null }
    let arena? = match items[0] { .Name(word) -> word, rest -> null } else { return null }
    let index? = match items[1] { .Int(i) -> i, rest -> null } else { return null }
    Held { arena: arena, index: index }
}

/// The nodes a run fill holds, absent when any item holds none.
fn held_run(fill: Node) -> List<Held>? {
    let items? = match fill { .Many(items) -> items, rest -> null } else { return null }
    let held = [held_at(i) for i in items]
    if held.any(it == null) { null } else { [h! for h in held] }
}

/// A held node in the seat it stands in, which must take a node of its arena.
fn held_filled(kind: HoleKind, held: Held) -> Filled {
    match kind {
        .Expression or .Tail -> if held.arena == "expr" { Filled.Expr(ExprId { index: held.index }) } else { misplaced(held.arena, "an expression") },
        .Binder -> if held.arena == "pat" { Filled.Pat(PatId { index: held.index }) } else { misplaced(held.arena, "a pattern") },
        rest -> Filled.Unplaceable("a held node stands where an expression or a pattern does"),
    }
}

/// A run of held nodes in the seat it stands in: statements, or a run of expressions.
fn run_filled(kind: HoleKind, run: List<Held>) -> Filled {
    match kind {
        .Statement or .Tail -> if run.all(it.arena == "stmt") { Filled.Stmts([StmtId { index: h.index } for h in run]) } else { misplaced_run("statements") },
        .Run -> if run.all(it.arena == "expr") { Filled.Exprs([ExprId { index: h.index } for h in run]) } else { misplaced_run("expressions") },
        rest -> Filled.Unplaceable("a run of held nodes stands where statements or a run do"),
    }
}

fn misplaced(arena: string, seat: string) -> Filled {
    Filled.Unplaceable("a held `${arena}` node stands where ${seat} does")
}

fn misplaced_run(seat: string) -> Filled {
    Filled.Unplaceable("a run holding another arena's nodes stands where ${seat} do")
}

/// The template's scratch parse, made once.
fn scratch(lang: Language, source: string) -> Scratch? {
    let held: Scratch? = kept().get().get(source)
    if held != null { return held }
    let p = parse_program(lang, new_source_file("<means>", source), BlockWords {})
    if !p.voices.list.is_empty() { return null }
    let first? = p.stmts.first() else { return null }
    let q? = p.store.answer_of(first) else { return null }
    let made = Scratch { store: p.store, body: q }
    kept().put(source, made)
    made
}
