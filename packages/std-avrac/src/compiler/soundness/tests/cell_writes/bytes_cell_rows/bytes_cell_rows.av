// the C rows that append to a Cell<Bytes> in place, the cell seeded from a static byte string
extern fn avra_cell_bytes_word(cell: Cell<Bytes>, word: int, width: int)
extern fn avra_cell_bytes_run(cell: Cell<Bytes>, run: Bytes)

fn blank() -> Cell<Bytes> { Cell.new(b"") }

fn hello() -> Cell<Bytes> { Cell.new(b"hi") }

let a = blank()
let b = blank()
avra_cell_bytes_word(a, 65, 1)
avra_cell_bytes_run(a, b"BC")
let h = hello()
avra_cell_bytes_word(h, 33, 1)
"${a.get().length} ${b.get().length} ${h.get().length} ${hello().get().length} ${blank().get().length} ${b"hi".length}"
