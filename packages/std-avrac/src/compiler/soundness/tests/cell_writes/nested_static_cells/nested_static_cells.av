// a cell seeded from a static list of static lists: an outer push and an inner rebuild leave the sibling and the literal whole
fn grid() -> Cell<List<List<int>>> { Cell.new([[1], [2]]) }

let a = grid()
let b = grid()
a.set_at(0, a.get()[0].concat([5]))
a.push([7])
"${a.get().length} ${a.get()[0].length} ${b.get().length} ${b.get()[0].length} ${grid().get()[0].length}"
