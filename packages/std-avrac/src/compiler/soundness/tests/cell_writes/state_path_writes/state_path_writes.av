// a state seeded from a static record written along paths — a field, a list push, an index, a map verb — from a lambda and directly, fresh each call
type R = { n: int, xs: List<int>, tags: Map<string, int> }

fn run(k: int) -> string {
    state r: R = R { n: 0, xs: [], tags: {} }
    let bump = () -> {
        r.n = r.n + k
        r.xs.push(k)
        r.tags.set("t${k}", k)
        0
    }
    let _ = bump()
    r.xs[0] = k * 10
    "${r.n} ${r.xs.length} ${r.xs[0]} ${r.tags.length}"
}

fn plain(k: int) -> string {
    state s = R { n: 0, xs: [], tags: {} }
    s.n = k
    s.xs.push(k)
    s.xs.push(7)
    "${s.n} ${s.xs.length} ${s.xs[1]}"
}

[run(1), run(2), run(3), plain(4)].join(" | ")
