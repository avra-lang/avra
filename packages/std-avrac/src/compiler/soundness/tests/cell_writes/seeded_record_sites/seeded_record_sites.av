// a cell seeded from a static record, set whole and through a with, leaves the literal and a sibling as written
type R = { n: int, xs: List<int> }

fn origin() -> Cell<R> { Cell.new(R { n: 0, xs: [] }) }

let a = origin()
a.set(a.get() with { n: 3 })
let b = origin()
b.set(R { n: b.get().n + 1, xs: b.get().xs.concat([8]) })
let c = origin()
"${a.get().n} ${b.get().n} ${b.get().xs.length} ${c.get().n} ${origin().get().n} ${origin().get().xs.length}"
