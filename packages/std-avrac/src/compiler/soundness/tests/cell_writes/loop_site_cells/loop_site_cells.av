// one literal site seeding a cell on every turn: each turn's writes stay its own
fn twice(i: int) -> int {
    let c: Cell<List<int>> = Cell.new([])
    c.push(i)
    c.push(i)
    c.get().length
}

let lens = [twice(i) for i in 0..50]
let last: Cell<List<int>> = Cell.new([])
"${lens.length} ${lens[0]} ${lens[49]} ${last.get().length}"
