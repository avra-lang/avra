// two cells seeded from one literal site each own their list — push, set_at, set — and the literal reads fresh after
fn fresh() -> Cell<List<int>> { Cell.new([]) }

fn three() -> Cell<List<int>> { Cell.new([1, 2, 3]) }

fn lit() -> List<int> { [1, 2, 3] }

let a = fresh()
let b = fresh()
a.push(1)
a.push(2)
b.push(9)
let c = three()
let d = three()
c.set_at(0, 7)
c.push(4)
d.set(d.get().concat([5]))
"${a.get().length} ${b.get().length} ${b.get()[0]} ${c.get()[0]} ${c.get().length} ${d.get().length} ${d.get()[0]} ${fresh().get().length} ${three().get()[0]} ${lit()[0]} ${lit().length}"
