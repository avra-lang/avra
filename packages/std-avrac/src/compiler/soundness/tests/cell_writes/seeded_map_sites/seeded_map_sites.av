// two cells seeded from one map literal site — an empty one and a filled one — each own their map under put
fn empty_counts() -> Cell<Map<string, int>> { Cell.new({}) }

fn seeded_counts() -> Cell<Map<string, int>> { Cell.new({"a": 1}) }

let a = empty_counts()
let b = empty_counts()
a.put("x", 1)
b.put("y", 2)
let s = seeded_counts()
let t = seeded_counts()
s.put("a", 5)
s.put("b", 6)
"${a.get().length} ${a.get().has("y")} ${b.get().length} ${s.get().get("a") ?? 0} ${s.get().length} ${t.get().get("a") ?? 0} ${t.get().length} ${empty_counts().get().length} ${seeded_counts().get().get("a") ?? 0}"
