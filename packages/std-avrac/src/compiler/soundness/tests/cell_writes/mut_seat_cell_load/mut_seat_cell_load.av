// a mut seat handed a state seeded from a static list, and one handed a mut local, each a fresh list per call
fn grow(mut xs: List<int>, v: int) { xs.push(v) }

fn run(k: int) -> string {
    state s: List<int> = []
    grow(s, k)
    grow(s, k + 1)
    mut m: List<int> = []
    grow(m, k)
    "${s.length} ${s[1]} ${m.length}"
}

[run(1), run(5)].join(" ")
