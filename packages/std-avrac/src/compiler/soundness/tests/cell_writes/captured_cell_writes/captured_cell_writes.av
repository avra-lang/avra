// a lambda capturing a cell seeded from a static list writes it; a second closure from the same site owns its own
fn counter() -> fn() -> int {
    let c: Cell<List<int>> = Cell.new([])
    () -> {
        c.push(c.get().length)
        c.get().length
    }
}

let f = counter()
let g = counter()
let _ = f()
let _ = f()
let x = f()
let y = g()
"${x} ${y} ${(counter())()}"
