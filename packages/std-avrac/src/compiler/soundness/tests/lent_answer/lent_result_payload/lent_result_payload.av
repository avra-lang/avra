// a lent payload answered inside an Ok, and a nullable lent answer
type Node = { name: string, kids: List<string> }
type Arena = { nodes: List<Node> }

/// An arena of two run-time-named nodes.
fn arena(tag: string) -> Arena {
    Arena {
        nodes: [
            Node { name: ["${tag}", "0"].join(""), kids: [["k", tag].join("")] },
            Node { name: ["${tag}", "1"].join(""), kids: [] },
        ],
    }
}

/// THE LENT ANSWER: every answer a view rooted at `a`.
fn node_at(a: Arena, i: int) -> Node { a.nodes[i] }

fn node_ok(a: Arena, i: int) -> Result<Node, string> {
    if i >= a.nodes.length { fail "out of range" }
    a.nodes[i]
}

fn node_or_none(a: Arena, i: int) -> Node? {
    if i >= a.nodes.length { return null }
    a.nodes[i]
}

fn run(n: int) -> string {
    let x = match node_ok(arena("o${n}"), 0) { .Ok(v) -> v.name, .Err(e) -> e }
    let y = match node_ok(arena("o${n}"), 5) { .Ok(v) -> v.name, .Err(e) -> e }
    let z = node_or_none(arena("q${n}"), 1)?.name ?? "none"
    [x, y, z].join(" ")
}

run(9)
