// a generic lent answer at a managed, a scalar and a Cell type argument
type Node = { name: string, kids: List<string> }
type Arena = { nodes: List<Node> }

/// An arena of two run-time-named nodes.
fn arena(tag: string) -> Arena {
    Arena {
        nodes: [
            Node { name: ["${tag}", "0"].join(""), kids: [["k", tag].join("")] },
            Node { name: ["${tag}", "1"].join(""), kids: [] },
        ],
    }
}

/// THE LENT ANSWER: every answer a view rooted at `a`.
fn node_at(a: Arena, i: int) -> Node { a.nodes[i] }

fn pick<T>(xs: List<T>, i: int) -> T { xs[i] }

fn same<T>(x: T) -> T { x }

fn run(n: int) -> string {
    let s = pick([["a", "${n}"].join(""), ["b", "${n}"].join("")], 1)
    let nd = pick(arena("g${n}").nodes, 0)
    let k = pick([n, n + 1], 1)
    let c = pick([Cell.new(n)], 0)
    c.set(n * 10)
    let t = same(arena("i${n}")).nodes[1].name
    [s, nd.name, "${k}", "${c.get()}", t].join(" ")
}

run(6)
