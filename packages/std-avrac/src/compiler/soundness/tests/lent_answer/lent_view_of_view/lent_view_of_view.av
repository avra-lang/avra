// a view of a lent answer across two marked fns, the root a temporary
type Node = { name: string, kids: List<string> }
type Arena = { nodes: List<Node> }

/// An arena of two run-time-named nodes.
fn arena(tag: string) -> Arena {
    Arena {
        nodes: [
            Node { name: ["${tag}", "0"].join(""), kids: [["k", tag].join("")] },
            Node { name: ["${tag}", "1"].join(""), kids: [] },
        ],
    }
}

/// THE LENT ANSWER: every answer a view rooted at `a`.
fn node_at(a: Arena, i: int) -> Node { a.nodes[i] }

fn first(a: Arena) -> Node { node_at(a, 0) }

fn label(nd: Node) -> string { nd.name }

fn kept(n: int) -> List<string> { [label(first(arena("v${n}${i}"))) for i in 0..2] }

[label(first(arena("w"))), kept(4).join(",")].join(" ")
