// a mut local's arena rewritten in place and whole while a lent answer of it stands
type Node = { name: string, kids: List<string> }
type Arena = { nodes: List<Node> }

/// An arena of two run-time-named nodes.
fn arena(tag: string) -> Arena {
    Arena {
        nodes: [
            Node { name: ["${tag}", "0"].join(""), kids: [["k", tag].join("")] },
            Node { name: ["${tag}", "1"].join(""), kids: [] },
        ],
    }
}

/// THE LENT ANSWER: every answer a view rooted at `a`.
fn node_at(a: Arena, i: int) -> Node { a.nodes[i] }

fn run(n: int) -> string {
    mut a = arena("m${n}")
    let v = node_at(a, 0)
    a.nodes[0] = Node { name: ["w", "${n}"].join(""), kids: [] }
    let u = node_at(a, 1)
    a.nodes = []
    let t = node_at(Arena { nodes: a.nodes.concat([Node { name: "q${n}", kids: [] }]) }, 0)
    let s = node_at(arena("h${n}"), 1)
    a = arena("x${n}")
    [v.name, u.name, t.name, s.name, a.nodes[0].name].join(" ")
}

run(1)
