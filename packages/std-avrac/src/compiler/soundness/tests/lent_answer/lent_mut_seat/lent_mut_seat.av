// a callee's mut seat writes the arena a lent answer stands on
type Node = { name: string, kids: List<string> }
type Arena = { nodes: List<Node> }

/// An arena of two run-time-named nodes.
fn arena(tag: string) -> Arena {
    Arena {
        nodes: [
            Node { name: ["${tag}", "0"].join(""), kids: [["k", tag].join("")] },
            Node { name: ["${tag}", "1"].join(""), kids: [] },
        ],
    }
}

/// THE LENT ANSWER: every answer a view rooted at `a`.
fn node_at(a: Arena, i: int) -> Node { a.nodes[i] }

fn wipe(mut a: Arena, n: int) {
    a.nodes[0] = Node { name: ["y", "${n}"].join(""), kids: [] }
    a.nodes = a.nodes.concat([Node { name: "more", kids: [] }])
}

fn run(n: int) -> string {
    mut a = arena("p${n}")
    let v = node_at(a, 0)
    wipe(a, n)
    [v.name, a.nodes[0].name, "${a.nodes.length}"].join(" ")
}

run(3)
