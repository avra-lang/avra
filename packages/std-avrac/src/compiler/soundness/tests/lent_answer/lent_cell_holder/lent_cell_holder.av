// the arena a lent answer rides is replaced through a Cell, directly and by a callee
type Node = { name: string, kids: List<string> }
type Arena = { nodes: List<Node> }

/// An arena of two run-time-named nodes.
fn arena(tag: string) -> Arena {
    Arena {
        nodes: [
            Node { name: ["${tag}", "0"].join(""), kids: [["k", tag].join("")] },
            Node { name: ["${tag}", "1"].join(""), kids: [] },
        ],
    }
}

/// THE LENT ANSWER: every answer a view rooted at `a`.
fn node_at(a: Arena, i: int) -> Node { a.nodes[i] }

fn replaced(st: Cell<Arena>, n: int) { st.set(arena("d${n}")) }

fn run(n: int) -> string {
    let st: Cell<Arena> = Cell.new(arena("c${n}"))
    let v = node_at(st.get(), 0)
    st.set(arena("e${n}"))
    let w = node_at(st.get(), 1)
    replaced(st, n)
    [v.name, w.name, st.get().nodes[0].name].join(" ")
}

run(5)
