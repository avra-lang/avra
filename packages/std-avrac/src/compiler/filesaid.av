//! A FILE'S KEPT ANSWERS, AS SAVED ANSWERS: the file's `Said` stands while the answers it
//! was kept on still have the digests they had — its text, each recorded compile-time
//! read's token, what its collects gathered, each module it sees by its interface, and
//! the SETS of those, so a read added or dropped moves the answer. Kept beside the hold's
//! hand-folded key and judged beside it under `AVRA_DB_VERIFY`: the two must agree on
//! which files hold.
use @std.text.{parse_int}
use core.{
    digest_of,
    joined,
    sorted_texts,
    qtrace,
    traced,
    ModulePath,
    module_path,
    distinct,
    flatten,
}
use core.debug.{db_verified_files}
use compiler.{Want}
use compiler.store.{Store, Stored, Reading, node_key, read_name, read_spelled}
use diagnostics.{Diag, DiagFacts, diag_facts_of}
use @std.relation.engine.{list_cell}

use compiler.record.{KeyParts}
use compiler.findings.{findings_read}

/// What a file's kept answer stood on: one named answer each.
enum FileRead {
    Text
    Run(int)
    Runs
    Gathered
    Seen(string)
    SeenSet
    SeenPart(string)
    SeenForms(string)
}

impl FileRead {
    /// The read as its row names it: an input by the path it belongs to, an interface by its module.
    fn name(path: string) -> string {
        match self {
            .Text -> "text ${path}",
            .Run(j) -> "run ${path} ${j}",
            .Runs -> "runs ${path}",
            .Gathered -> "gathered ${path}",
            .Seen(m) -> "seen ${m}",
            .SeenSet -> "seen-set ${path}",
            .SeenPart(m) -> "sp ${m}",
            .SeenForms(m) -> "sf ${m}",
        }
    }
}

/// A read of `path`'s row read back from its name; null for one this compiler never wrote.
fn file_read_of(name: string, path: string) -> FileRead? {
    let run = "run ${path} "
    when {
        name == FileRead.Text.name(path) -> FileRead.Text
        name == FileRead.Runs.name(path) -> FileRead.Runs
        name == FileRead.Gathered.name(path) -> FileRead.Gathered
        name == FileRead.SeenSet.name(path) -> FileRead.SeenSet
        name.starts_with(run) -> match parse_int(name.substring(run.length, name.length)) {
            j? -> FileRead.Run(j)
            null -> null
        }
        name.starts_with("seen ") -> FileRead.Seen(name.substring(5, name.length))
        name.starts_with("sp ") -> FileRead.SeenPart(name.substring(3, name.length))
        name.starts_with("sf ") -> FileRead.SeenForms(name.substring(3, name.length))
        _ -> null
    }
}

/// The digest a read has in these parts; null for a read the parts no longer carry.
fn answer_in(k: KeyParts, r: FileRead) -> string? {
    match r {
        .Text -> digest_of(k.text),
        .Run(j) -> if j < k.runs.length { digest_of(k.runs[j]) } else { null },
        .Runs -> digest_of(fields_wire(k.runs)),
        .Gathered -> digest_of(fields_wire(k.gathered)),
        .Seen(m) -> seen_answer(k, m),
        .SeenSet -> digest_of(seen_digest(k.seen)),
        .SeenPart(_) or .SeenForms(_) -> null,
    }
}

/// What the module `m` is seen as in these parts; null for one not seen.
fn seen_answer(k: KeyParts, m: string) -> string? {
    let s? = k.seen.find(it.module == m) else { return null }
    digest_of(s.bytes_key)
}

/// Every answer these parts stand on, named.
fn reads_of_parts(k: KeyParts) -> List<Reading> {
    let reads = [FileRead.Text, FileRead.Runs, FileRead.Gathered, FileRead.SeenSet]
        .concat([FileRead.Run(j) for j in 0..k.runs.length])
        .concat([FileRead.Seen(s.module) for s in k.seen])
    [Reading { name: r.name(k.path), digest: answer_in(k, r) ?? "" } for r in reads]
}

impl Workspace {
    /// FILE-SAID: what a file said, with the answers it stood on. Rows are the program's own — a
    /// file's answers are spelled in the view of the program that kept them.
    fn said_row(path: string) -> string { node_key(Stored.Warn, ["said-row", self.root, path]) }

    /// FILE-SAID: a file's rule findings, rendered.
    fn rules_row(path: string) -> string { node_key(Stored.Warn, ["rules-row", self.root, path]) }

    /// FILE-SAID: a file's findings rows.
    fn findings_row(path: string) -> string { node_key(Stored.Warn, ["findings-row", self.root, path]) }

    /// A FILE'S WARNINGS AS DATA, the row `render_facts_among` reads: its diagnostics and its
    /// rule findings through `diag_facts_wire`, whose places cross as TOKEN places, so the row
    /// stands while the shape of every file it points into does (`verdict_read_stands`) and reads back
    /// against a lex of their texts now.
    fn warning_facts_row(path: string) -> string { node_key(Stored.Warn, ["facts-row", self.root, path]) }

    /// A read file's facts kept. Rule findings kept from an earlier run are no `Diag`s here
    /// (`rules` null), and the row says they are unknown.
    fn keep_warning_facts(store: Store, path: string, diags: List<Diag>, rules: List<Diag>?) {
        let facts = FileFacts {
            warnings: [diag_facts_of(d) for d in diags],
            rules: if rules == null { null } else { [diag_facts_of(d) for d in rules!] },
        }
        let places = flatten([facts_files(d) for d in facts.warnings.concat(facts.rules ?? [])])
        let pointed = [VerdictRead.Shape(f) for f in distinct([path].concat(places)) if f.ends_with(".av")]
        let _ = store
            .keep_reading(
                Stored.Warn,
                self.warning_facts_row(path),
                self.file_facts_wire(facts),
                self.readings(pointed),
            )
    }

    /// THE FACTS THAT ROW KEEPS, while every shape it points into stands, placed in the texts
    /// as they are now.
    fn facts_standing(store: Store, path: string) -> FileFacts? {
        let moved: Cell<List<string>> = list_cell()
        let row? = store
            .get_standing(
                Stored.Warn,
                self.warning_facts_row(path),
                (r: Reading) -> self.verdict_read_stands(r, moved),
            ) else {
            return null
        }
        self.file_facts_of_wire(row)
    }

    /// A file's kept answer filed under its path with what it stood on.
    fn keep_file_row(store: Store, path: string, family: Stored, key: string, bytes: string) {
        if store.get(family, key) == bytes && self.file_kept(store, path, family, key) { return }
        let k = self.key_parts_cached(store, self.module_path_of(path), path)
        let _ = store
            .keep_reading(family, key, bytes, reads_of_parts(k).concat(self.seen_stamps(store, k)))
    }

    /// What each module a file reads stood as when its answer was kept — its frame and its plain
    /// free fns' forms: the names the judge asks first, so a module whose stamps stand, or whose
    /// moved fns the file never spells, never has its views rebuilt.
    fn seen_stamps(store: Store, k: KeyParts) -> List<Reading> {
        flatten(
            [[
                Reading {
                    name: FileRead.SeenPart(m).name(k.path),
                    digest: self.seen_stamp(store, module_path(m.split("."))),
                },
                Reading {
                    name: FileRead.SeenForms(m).name(k.path),
                    digest: self.forms_stamp(store, module_path(m.split("."))),
                },
            ] for m in distinct([k.module].concat([s.module for s in k.seen]))],
        )
    }

    /// A file's kept answer, while every answer it stood on has its digest.
    fn file_row(store: Store, path: string, family: Stored, key: string) -> string? {
        // ONE PREDICATE FOR A ROW'S STANDING: a row the suspect set does not name stands with
        // nothing judged, exactly as `file_kept` answers — only a row it might name is judged
        // read by read. Asking `get_valid` first judges every read of every held file's row,
        // for rows that were never in doubt.
        if store.unsuspected(family, key, self.suspect_rows(store)) && !db_verified_files() {
            return store.get(family, key)
        }
        let k = self.key_parts_cached(store, self.module_path_of(path), path)
        store.get_valid(family, key, (name) -> self.stood_on(k, name))
    }

    /// Whether a file's kept answer is there and still stands: unsuspected rows stand with
    /// nothing derived, the rest are judged by their reads.
    fn file_kept(store: Store, path: string, family: Stored, key: string) -> bool {
        let unsuspected = store.unsuspected(family, key, self.suspect_rows(store))
        if unsuspected && !db_verified_files() { return true }
        let kept = self.file_judged(store, path, family, key)
        if unsuspected && !kept {
            qtrace(
                "Q\tsuspect-missed\t${path}\t${family.name()}\t${self.moved_read(store, path)}\n",
            )
        }
        kept
    }

    /// WHETHER EVERY ROW THAT STANDS IN FOR A FILE IS PRESENT AND READS NOTHING THAT MOVED. A row
    /// the suspect set names is JUDGED, never cast out on suspicion alone — suspicion is a module's
    /// TEXT having moved, not its narrowed interface, so a bystander fn would otherwise read every
    /// reader of its module. The on-demand load's gate: a file whose rows so stand is never met.
    fn file_rows_stand(store: Store, path: string, want: Want) -> bool {
        let suspects = self.suspect_rows(store)
        let said_key = self.said_row(path)
        let asks_key = self.asks_row(path)
        let codes_key = self.codes_row(path)
        let said = store.unsuspected(Stored.Warn, said_key, suspects) ||
            self.file_judged(store, path, Stored.Warn, said_key)
        let asks = store.unsuspected(Stored.Unit, asks_key, suspects) ||
            self.file_judged(store, path, Stored.Unit, asks_key)
        let codes = store.unsuspected(Stored.Unit, codes_key, suspects) ||
            self.file_judged(store, path, Stored.Unit, codes_key)
        if want is .Diagnostics {
            said && asks && codes && self.file_ruled(store, path)
        } else {
            said && asks && codes && store.has(Stored.Obj, self.held_okey(store, path))
        }
    }

    fn file_judged(store: Store, path: string, family: Stored, key: string) -> bool {
        let lines? = store.reads_of(family, key) else { return false }
        let reads = [read_spelled(l) for l in lines]
        if reads.any(it == null) { return false }
        let m = self.module_path_of(path)
        let stamps = [r! for r in reads if r != null && r!.name.starts_with("sp ")]
        let forms = [r! for r in reads if r != null && r!.name.starts_with("sf ")]
        let cheap = !stamps.is_empty() &&
            stamps.all((r) -> self.stamp_stands(store, r)) &&
            forms.all((r) -> self.forms_stand(store, path, r))
        if !cheap { work_judge_fallback() }
        let judged = reads.all((r) -> self.read_stands(store, m, path, r!, cheap))
        if judged &&
            cheap &&
            db_verified_files() &&
            !reads.all((r) -> self.read_stands(store, m, path, r!, false)) {
            self.defect(cheap_unsound(path))
        }
        judged
    }

    /// Whether a module's plain free fns stand as a row read them: their forms are the ones it
    /// read, or the fns that moved are none the file spells.
    fn forms_stand(store: Store, path: string, r: Reading) -> bool {
        let read? = file_read_of(r.name, "") else { return false }
        match read {
            .SeenForms(m) -> {
                let at = module_path(m.split("."))
                if self.forms_stamp(store, at) == r.digest { return true }
                let moved? = self.moved_forms(store, at, r.digest) else { return false }
                let spelled? = self.spelled_idents(store, path) else { return false }
                !spelled.any((n: string) -> moved.has(n))
            },
            rest -> false,
        }
    }

    /// The names a file mentions, as its module's record spells them; null where it does not say.
    fn spelled_idents(store: Store, path: string) -> List<string>? {
        let pr? = self.producers_for(store, self.module_path_of(path)) else { return null }
        let line? = pr.files.find(it[1] == path) else { return null }
        if line.length < 7 || line[5] == "" { return null }
        line[5].split(",")
    }

    /// Whether a module's stamp still has the digest a row read it at.
    fn stamp_stands(store: Store, r: Reading) -> bool {
        let read? = file_read_of(r.name, "") else { return false }
        match read {
            .SeenPart(m) -> self.seen_stamp(store, module_path(m.split("."))) == r.digest,
            rest -> false,
        }
    }

    /// Whether one read a row stood on still has its digest. A module's whole stamp stands for every
    /// narrowed view of it, so the views are rebuilt only for a row whose stamps moved or were never kept.
    fn read_stands(store: Store, m: ModulePath, path: string, r: Reading, cheap: bool) -> bool {
        let read? = file_read_of(r.name, path) else { return false }
        match read {
            .Text -> digest_of(self.text_digest(path)) == r.digest,
            .SeenPart(_) or .SeenForms(_) -> true,
            .Seen(_) or .SeenSet -> cheap || self.stood_on(self.key_parts_cached(store, m, path), r.name) == r.digest,
            .Run(_) or .Runs or .Gathered -> self.lite_answer(store, m, path, read) == r.digest,
        }
    }

    /// The digest a compile-time-run or collect read has now, off the module's row when it has one.
    fn lite_answer(store: Store, m: ModulePath, path: string, read: FileRead) -> string? {
        let pr? = self.producers_for(store, m) else { return self.stood_on(self.key_parts_cached(store, m, path), read.name(path)) }
        match read {
            .Run(j) -> {
                let runs = self.lite_runs(pr, path)
                if j < runs.length { digest_of(runs[j]) } else { null }
            },
            .Runs -> digest_of(fields_wire(self.lite_runs(pr, path))),
            .Gathered -> digest_of(fields_wire(self.lite_gathered(pr, path))),
            rest -> null,
        }
    }

    /// The digest a named answer has in these parts now.
    fn stood_on(k: KeyParts, name: string) -> string? {
        let r? = file_read_of(name, k.path) else { return null }
        answer_in(k, r)
    }

    /// Whether a file's rule findings were kept, rendered and as rows, and still stand.
    fn file_ruled(store: Store, path: string) -> bool {
        self.file_kept(store, path, Stored.Warn, self.rules_row(path)) &&
            self.file_kept(store, path, Stored.Warn, self.findings_row(path))
    }

    /// A READ FILE'S RULE FINDINGS, WHEN WHAT THEY STOOD ON STILL STANDS: the rules ran over its text
    /// and what its analysis read, both named by the rows' reads, so a file read only because
    /// something it reads re-ran is not walked by the rules again.
    fn kept_ruled(store: Store, path: string) -> Ruled? {
        if !self.file_ruled(store, path) { return null }
        let rendered? = store.get(Stored.Warn, self.rules_row(path)) else { return null }
        let rows? = store.get(Stored.Warn, self.findings_row(path)) else { return null }
        Ruled { rendered: rendered, rows: findings_read(rows) }
    }

    /// A held file's `Said` under `want`: a diagnostics want reads its rule
    /// findings beside it, and `stands_in` held it only where they were kept.
    fn held_said(store: Store, path: string, said: Said, want: Want) -> Said? {
        match want {
            .Diagnostics -> {
                let rules? = self.file_row(store, path, Stored.Warn, self.rules_row(path)) else { return null }
                let rows? = self.file_row(store, path, Stored.Warn, self.findings_row(path)) else { return null }
                said with { warnings: spoken([said.warnings, rules]), findings: findings_read(rows) }
            },
            .Binary -> said,
        }
    }

    /// The first answer a file's kept answer stood on that has moved, in the words of its row;
    /// "no row" for a file never kept.
    fn moved_read(store: Store, path: string) -> string {
        let k = self.key_parts_cached(store, self.module_path_of(path), path)
        let lines? = store.reads_of(Stored.Warn, self.said_row(path)) else { return "no row" }
        let moved = [line for line in lines if self.line_moved(line, k)]
        moved.first() ?? "none"
    }

    fn line_moved(line: string, k: KeyParts) -> bool {
        let at = line.index_of(" ")
        if at <= 0 { return true }
        self.stood_on(k, line.substring(at + 1, line.length)) != line.substring(0, at)
    }

    /// THE ROWS THAT READ AN INPUT THAT MOVED, once per record write and per file admitted: the files whose text
    /// differs from what their row was kept on, then every file seeing a module those sit in,
    /// to a fixpoint. A row outside the set read nothing that moved.
    fn suspect_rows(store: Store) -> Map<string, bool> {
        let paths = self.decls.file_paths()
        if self.keys.suspects.get().files == paths.length { return self.keys.suspects.get().rows }
        mut row_of: Map<string, string> = {}
        for p in paths { row_of.set(store.suspect_key(Stored.Warn, self.said_row(p)), p) }
        let edited = [p for p in paths if self.text_moved(store, p)]
        let readers = store.readers()
        mut moved = [FileRead.Text.name(p) for p in edited]
            .concat([self.seen_name(p) for p in edited])
        mut rows: Map<string, bool> = {}
        mut grown = true
        while grown {
            grown = false
            for r in store.suspects(moved, readers) {
                if rows.get(r) != null { continue }
                rows.set(r, true)
                grown = true
                let p? = row_of.get(r) else { continue }
                moved.push(self.seen_name(p))
            }
        }
        let suspect = distinct([row_of.get(r) ?? "" for r in rows.keys()]).filter(it != "")
        mut suspect_set: Map<string, bool> = {}
        for p in suspect { suspect_set.set(p, true) }
        if traced() {
            qtrace(
                "Q\tsuspects\t${edited.length} edited\t${rows.keys().length} rows\t${suspect.length} suspect files\t${paths.length} files\n",
            )
        }
        self.keys.suspects.set(Suspects { files: paths.length, rows: rows, paths: suspect_set })
        rows
    }

    /// THE FILES THE REVERSE INDEX NAMES: every file with a row that read an input that moved.
    fn suspect_files(store: Store) -> Map<string, bool> {
        let _ = self.suspect_rows(store)
        self.keys.suspects.get().paths
    }

    /// THE HELD SET: the files whose holds a derivation of this program confirmed standing
    /// under this name and want — one line a file, so it is bounded by the program's own
    /// files and rewritten only when the set moves. The name carries no count: a derivation
    /// admits files as it walks, so a count in it is one the writer and the reader disagree
    /// about — measured, it turned `holds 491 asked` into `holds 1276 asked`.
    fn held_set_key(entry: string?, want: Want) -> string {
        node_key(Stored.Fp, ["held-set", self.root, entry ?? "", want_word(want)])
    }

    /// The files the last derivation confirmed standing; null for one never confirmed, which
    /// trusts no file.
    fn held_set(store: Store, entry: string?, want: Want) -> Map<string, bool>? {
        let row? = store.get(Stored.Fp, self.held_set_key(entry, want)) else { return null }
        mut set: Map<string, bool> = {}
        for line in row.split("\n") { if line != "" { set.set(line, true) } }
        set
    }

    /// REMEMBER THE HELD SET. A row that stands on nothing is never suspect, so it is
    /// rewritten only when the set itself moves — never an action frame per derivation.
    fn keep_held_set(store: Store, entry: string?, want: Want, paths: List<string>) {
        // A DERIVATION THAT HELD NOTHING REMEMBERS NOTHING: its row would name every file of
        // the program as untrusted, and an absent row already says that. Writing it erases a
        // set another program of this root confirmed, and the next edit then asks every file.
        if paths.is_empty() { return }
        let text = joined(sorted_texts(distinct(paths)), "\n")
        let key = self.held_set_key(entry, want)
        if store.get(Stored.Fp, key) == text { return }
        let _ = store.keep(Stored.Fp, key, text, [])
    }

    /// WHICH FILES A DERIVATION MUST ASK: every file the held set does not confirm standing,
    /// and every file the reverse index names as having read an input that moved. A file that
    /// is neither asks nothing and stands untouched.
    fn holds_asked(store: Store, entry: string?, want: Want) -> Map<string, bool> {
        let trusted = if want is .Binary { null } else { self.held_set(store, entry, want) }
        let suspects = self.suspect_files(store)
        mut asked: Map<string, bool> = {}
        for fi in self.decls.files_standing() {
            if trusted?.get(fi.path) == null || suspects.get(fi.path) != null { asked.set(fi.path, true) }
        }
        if traced() {
            qtrace(
                "Q\tholds\t${asked.keys().length} asked\t${self.decls.files_standing().length} files\n",
            )
        }
        asked
    }

    /// Whether one file's hold is asked: a file the held set does not confirm standing, or one
    /// the reverse index names, and whose rows do not stand. A file no one asks stands as it was.
    fn hold_asks(
        store: Store,
        path: string,
        want: Want,
        must_read: List<string>,
        asked: Map<string, bool>,
    ) -> bool {
        must_read.contains(path) ||
            asked.get(path) != null && !self.file_rows_stand(store, path, want)
    }

    /// The read a file's module is seen through.
    fn seen_name(path: string) -> string { FileRead.Seen(self.module_of(path)).name(path) }

    /// Whether a file's text differs from what its kept row stood on; a file never kept has moved.
    fn text_moved(store: Store, path: string) -> bool {
        let lines? = store.reads_of(Stored.Warn, self.said_row(path)) else { return true }
        let read = FileRead.Text.name(path)
        let line? = lines.find(read_name(it) == read) else { return true }
        line.substring(0, line.index_of(" ")) != digest_of(self.text_digest(path))
    }
}

/// A want as the word its held set is filed under.
fn want_word(want: Want) -> string {
    match want { .Diagnostics -> "diagnostics", .Binary -> "binary" }
}

fn cheap_unsound(path: string) -> string {
    "the kept rows of `${path}` stood by their modules' stamps and moved fns where its own views say they moved — a stamp stands for a view only while every part of the view is covered by it, so one part of this file's view is not"
}
