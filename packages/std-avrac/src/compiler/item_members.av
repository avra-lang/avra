    witness: "trait From<T> {\n    static fn from(t: T) -> Self\n}\n\ntype C = { d: int }\n\nimpl From<int> for C {\n    static fn from(t: int) -> C { C { d: t } }\n}\n\nimpl From<bool> for C {\n    static fn from(t: bool) -> C { C { d: 0 } }\n}\n\nfn f() -> int { C.from(\"x\").d }\n"
}

