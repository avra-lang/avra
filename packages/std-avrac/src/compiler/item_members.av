    kind: "type.spread_nullable"
    reads_view: spreads_absent
    voice: absent_words
    witness: "type P = { x: int }\n\nfn g(a: P?) -> P { P { ..a, x: 1 } }\n"
}

/// `..` spreads a record
export law spread_spreads_a_record {
    kind: "type.spread_value"
    reads_view: spreads_fieldless
    voice: fieldless_words
    witness: "type P = { x: int }\n\nfn g() -> P { P { ..5, x: 1 } }\n"
}

/// a literal that spreads builds a record that takes no type parameters
export law spread_generic {
    kind: "type.spread_generic"
    reads_view: spreads_generic
    voice: generic_words
    witness: "type G<T> = { v: T }\n\nfn g(a: G<int>) -> G<int> { G { ..a } }\n"
}

/// a literal that spreads still writes every field no default fills
export law spread_leaves_unset {
    kind: "type.spread_missing"
    reads_view: fields_unset
    voice: unset_words
    witness: "type P = { x: int, y: int }\n\ntype X = { x: int }\n\nfn g(a: X) -> int { P { ..a }.x }\n"
}

/// a `?.(…)` call calls what holds a fn when present
export law chain_call_holds_fn {
    kind: "type.lambda"
    reads_view: chain_uncallables
    voice: uncallable_words
    witness: "fn g(n: int?) -> int { n?.(2) ?? 0 }\n"
}

/// a `?.` call reaches into a nullable
export law chain_call_present {
    kind: "type.chain"
    reads_view: chain_calls_present
    voice: chain_call_words
    witness: "fn g(f: fn(int) -> int) -> int { f?.(2) ?? 0 }\n"
}

/// only fns and fn-typed values take arguments
export law value_callable {
    kind: "type.lambda"
    reads_view: uncallables
    voice: uncallable_words
    witness: "fn g(n: int) -> int { n(1) }\n"
}

/// a bare variant literal takes the enum its seat names
export law variant_enumed {
    kind: "type.variant_lit"
    reads_view: variants_unenumed
    voice: unenumed_words
    witness: "fn g() -> int {\n    let x = .foo\n    1\n}\n"
}

/// a bare variant literal names a variant of its seat's enum
export law variant_of_seat_enum {
    kind: "type.variant_lit"
    reads_view: variants_unbuilt
    voice: unbuilt_words
    witness: "enum T {\n    A\n    B\n}\n\nfn g() -> T { .C }\n"
}

/// a bare variant literal stands in a seat of an enum
export law variant_seat_enumed {
    kind: "type.variant_lit"
    reads_view: variants_unwanted
    voice: unwanted_words
    witness: "fn g() -> int {\n    let x: int = .foo\n    x\n}\n"
}

/// a destructuring `let` stands in a block
export law let_in_block {
    kind: "type.let_pattern"
    reads_view: lets_unblocked
    voice: unblocked_words
    witness: "let [q, ..] = [1] else { 1 }\n2\n"
}

/// an enum's name builds a variant it holds
export law enum_builds_its_variant {
    kind: "type.unknown_prop"
    reads_view: variants_uncalled
    voice: variant_uncalled_words
    witness: "enum S {\n    a(int)\n    b\n}\n\nfn g() -> S { S.zz(1) }\n"
}

/// a record's name reads no variant
export law record_reads_no_variant {
    kind: "type.unknown_prop"
    reads_view: records_read
    voice: record_read_words
    witness: "type P = { x: int }\n\nfn g() -> int {\n    let p = P.a\n    1\n}\n"
}

/// a record's name calls a static fn it writes
export law record_calls_its_static {
    kind: "type.unknown_prop"
    reads_view: statics_uncalled
    voice: static_unknown_words
    witness: "type P = { x: int }\n\nfn g() -> int { P.nope().x }\n"
}

/// a grammar's name calls a door it declares
export law grammar_calls_its_door {
    kind: "type.unknown_prop"
    reads_view: doors_uncalled
    voice: door_unknown_words
    witness: "grammar G = \"{a}-{b}\"\n\nfn g() -> int {\n    let x = G.sample(\"x\")\n    1\n}\n"
}

fn door_unknown_words(a: List<string>) -> Voice { door_unknown(a[0], a[1]) }

fn variant_uncalled_words(a: List<string>) -> Voice { variant_uncalled(a[0], a[1], a.drop(2)) }

fn record_read_words(a: List<string>) -> Voice { record_not_enum(a[0]) }

fn static_unknown_words(a: List<string>) -> Voice { static_unknown(a[0], a[1], a.drop(2)) }

/// a static fn is called, never read as a value
export law static_fn_called {
    kind: "type.unknown_prop"
    reads_view: statics_read
    voice: static_unvalued_words
    witness: "type P = { x: int }\n\nimpl P {\n    static fn of(n: int) -> P { P { x: n } }\n}\n\nfn apply(f: fn(int) -> P) -> int { f(1).x }\n\nfn g() -> int { apply(P.of) }\n"
}

fn static_unvalued_words(a: List<string>) -> Voice { static_unvalued(a[0], a[1], a[2]) }

/// a type parameter is no value
export law type_param_no_value {
    kind: "type.type_value"
    reads_view: params_as_values
    voice: param_value_words
    witness: "fn g<T>(x: int) -> int {\n    let y = T\n    x\n}\n"
}

/// a list's or a map's spread source is never null
export law literal_spread_present {
    kind: "type.spread_nullable"
    reads_view: literal_spreads_absent
    voice: literal_absent_words
    witness: "fn f(xs: List<int>?) -> int {\n    let a = [..xs]\n    a.length\n}\n"
}

/// a type is no value
export law type_no_value {
    kind: "type.type_value"
    reads_view: types_as_values
    voice: type_value_words
    witness: "type P = { x: int }\n\nfn g() -> int {\n    mut p = P\n    1\n}\n"
}

/// a record literal writes every field no default fills
export law field_unwritten {
    kind: "type.struct_fields"
    reads_view: fields_unwritten
    voice: unwritten_words
    witness: "type Box = { n: int, m: int }\n\nfn g() -> Box { Box { n: 1 } }\n"
}

/// `[…]` reads a list
export law index_not_list {
    kind: "type.mismatch"
    reads_view: indexes_missed
    voice: index_words
    witness: "fn g(n: int) -> int { n[0] }\n"
}

/// `[…]` names no place in a `string`
export law index_text {
    kind: "type.mismatch"
    reads_view: texts_indexed
    voice: text_words
    witness: "fn g(s: string) -> int { s[0] }\n"
}

fn own_prop_words(a: List<string>) -> Voice { no_property_on(a[0], a[1], a.drop(2)) }

fn uncalled_words(a: List<string>) -> Voice { uncalled_method(a[0], a[1]) }

fn field_words(a: List<string>) -> Voice { no_field_on(a[0], a[1], a.drop(2)) }

fn method_words(a: List<string>) -> Voice { no_method_on(a[0], a[1], a.drop(2)) }

fn own_method_words(a: List<string>) -> Voice {
    let methods = parse_int(a[2]) ?? 0
    methodless(a[0], a[1], a.drop(3).take(methods), a.drop(3 + methods))
}

/// The misses where the list verb `verb` is called on a list whose elements it reads none of: the
/// list's type, then its element's.
fn verbs_unfit(view: ItemView, verb: string) -> List<Found> {
    misses_seen_in(
        view,
        (m: Miss) -> match m {
            .VerbUnfit(v, found, elem) -> if v == verb { [found, elem] } else { [] },
            rest -> [],
        },
    )
}

fn bytes_unfit(view: ItemView) -> List<Found> { verbs_unfit(view, "bytes") }

fn join_unfit(view: ItemView) -> List<Found> { verbs_unfit(view, "join") }

/// `bytes` reads a list of octets or of bytes
export law bytes_reads_octets {
    kind: "type.mismatch"
    reads_view: bytes_unfit
    voice: bytes_unfit_words
    witness: "fn g() -> int {\n    let b = [true].bytes()\n    1\n}\n"
}

fn bytes_unfit_words(a: List<string>) -> Voice { unoctetted(a[0]) }

/// `join` reads a list of text
export law join_reads_text {
    kind: "type.list_element"
    reads_view: join_unfit
    voice: join_unfit_words
    witness: "fn g() -> string { [1, 2].join(\",\") }\n"
}

fn join_unfit_words(a: List<string>) -> Voice { unjoined(a[1]) }

fn variant_read_words(a: List<string>) -> Voice { no_variant_read_of(a[0], a[1], a.drop(2)) }

fn unset_words(a: List<string>) -> Voice { leaves_unset(a[0], a[1]) }

fn unwritten_words(a: List<string>) -> Voice { needs_field(a[0], a[1]) }

/// The count the words `a` hold at `i`.
fn count_at(a: List<string>, i: int) -> int { parse_int(a[i]) ?? 0 }

fn arity_words(a: List<string>) -> Voice { arity_missed(a[0], count_at(a, 1), count_at(a, 2)) }

fn defaulted_words(a: List<string>) -> Voice {
    defaulted_arity_missed(a[0], count_at(a, 1), count_at(a, 2), count_at(a, 3))
}

fn short_words(a: List<string>) -> Voice { variadic_short_of(a[0], count_at(a, 1), count_at(a, 2)) }

fn method_arity_words(a: List<string>) -> Voice { method_arity_missed(a[0], a[1], count_at(a, 2), count_at(a, 3)) }

fn static_arity_words(a: List<string>) -> Voice { static_arity_missed(a[0], a[1], count_at(a, 2), count_at(a, 3)) }

fn with_words(a: List<string>) -> Voice { with_unstructured(a[0]) }

fn chain_words(a: List<string>) -> Voice { chained_present(a[0], a[1]) }

fn chain_absent_words(a: List<string>) -> Voice { chained_absent(a[0]) }

fn untotal_words(_a: List<string>) -> Voice { when_untotal() }

fn twice_words(_a: List<string>) -> Voice { when_total_twice() }

fn absent_words(a: List<string>) -> Voice { spread_absent(a[0]) }

fn literal_absent_words(a: List<string>) -> Voice { if a[0] == "map" { map_spreads_absent(a[1]) } else { list_spreads_absent(a[1]) } }

fn fieldless_words(a: List<string>) -> Voice { spread_fieldless(a[0]) }

fn generic_words(a: List<string>) -> Voice { spread_of_generic(a[0]) }

fn chain_call_words(a: List<string>) -> Voice { chain_called_present(a[0]) }

fn uncallable_words(a: List<string>) -> Voice { uncallable_value(a[0]) }

fn unenumed_words(a: List<string>) -> Voice { variant_unenumed(a[0]) }

fn unwanted_words(a: List<string>) -> Voice { variant_unwanted(a[0], a[1]) }

fn unbuilt_words(a: List<string>) -> Voice { variant_unbuilt(a[0], a[1], a.drop(2)) }

fn unblocked_words(_a: List<string>) -> Voice { let_unblocked() }

fn type_value_words(a: List<string>) -> Voice { if a.length > 1 { owned_as_value(a[0]) } else { type_as_value(a[0]) } }

/// The word a finding is handed for a type the language owns.
const OWNED: string = "owned"

fn param_value_words(a: List<string>) -> Voice { type_param_as_value(a[0]) }

fn index_words(a: List<string>) -> Voice { unindexable(a[0]) }

fn text_words(_a: List<string>) -> Voice { text_unindexable() }

collect listed_miss_facts: List<ListedQuery> = @query_definition in self as ListedQuery { definition: it } by it.name

/// The queries the member laws are read through, for a process to hand its engine.
export fn miss_fact_definitions() -> List<QueryDefinition> { definitions_of(listed_miss_facts) }
