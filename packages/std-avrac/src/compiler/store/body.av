//! THE SEALED BODY — a segment's worth of records folded into one file, read
//! lazily. A body is a RUN: it names the run below it (`below`, 0 for none), and the
//! newest run's chain is the store, newer runs winning. A seal folds the newest runs
//! while what it folds is at least a quarter of the next, so each run is more than four
//! times everything above it: a seal costs what it folds, and a row is folded a
//! logarithmic number of times, so a small write never rewrites the whole store.
//!
//! §6.1's `body-<rev>.pack` is a HEAD, then eight sections: the INDEX, the SLOTS
//! (each referenced value's place in the `.val`), the FAMILIES, the NAMES its rows
//! read, the READS (a name and the digest it was read at), the interned READ SETS
//! (compiler/store/names.av), the HOLDERS of each set, and the ROWS. The head is one
//! commit-marked frame naming the sections' places, so a half-written body is torn and
//! never read. The values are NOT in the file: a row names its value by digest, the
//! slot section places it in `body-<rev>.val`, and a read seeks one value and checks it
//! against its digest.
//!
//! EVERY DIGEST IS ITS OCTETS: a key, a value digest or a read's digest that is a
//! whole BLAKE3 hex spelling is written as its 32 octets, and a row names its family by
//! its place in the body's family table, so a row costs what it says and no spelling.
//!
//! THE INDEX is one fixed-width line a row, sorted by key: the leading octets of the
//! row's action key, then the row's offset and length in the ROWS section, high octet
//! first. A lookup bisects those lines, so it reads O(log n) of them; the line's position
//! is the row's ORDINAL, which the holders section names. An open reads the head and the
//! index and decodes no row: a hit decodes the rows it asks for, each checked against the
//! key it was asked by. THE SLOTS are sorted by digest the same way, and bisected.
//!
//! THE REVERSE IS TWO STEPS OVER WHAT THE BODY ALREADY HOLDS: an input name names the
//! read sets that hold it (the tables), and a set names the rows that hold it (the
//! holders), so a moved input finds its readers with no name spelled twice.
//!
//! NOTHING OF THE FILE IS HELD (`compiler/store/mapped.av`): the body is mapped
//! and every range — an index line, a row, a section — is copied out of the
//! mapping as it is asked for, so an open costs a head and a bounded digest
//! whatever the store's size.
use @std.io.{write_bytes, append_bytes, list_dir, open_beneath, remove}
use @std.path.{joined_path}
use @std.relation.stable.{writer, reader, Writer, Reader}
use @std.relation.engine.{list_cell, map_cell}
use @std.text.{parse_int}
use core.{flatten, sorted_by, digest_of_octets, distinct, hex, unhex}
use @std.text.{text_before}
use compiler.store.mapped.{Mapped, mapped, mapped_at, mapped_check, mapped_close}
use core.debug.{qtrace, traced}

const BODY_MAGIC: string = "AVRABODY"
const BODY_VERSION: int = 8

/// An index line: the action key's leading octets, then the row's offset and length.
const KEY_OCTETS: int = 16
const OFFSET_OCTETS: int = 4
const LENGTH_OCTETS: int = 4
const LINE: int = KEY_OCTETS + OFFSET_OCTETS + LENGTH_OCTETS

/// A slot line: a value's whole digest, then its place in the `.val` — at and length.
const DIGEST_OCTETS: int = 32
const AT_OCTETS: int = 6
const SLOT_LINE: int = DIGEST_OCTETS + AT_OCTETS + LENGTH_OCTETS

/// The sections a head places; the rows are the last, and each row carries its own check.
const SECTIONS: int = 8
const ROWS_AT: int = 7

/// A row's own check: the leading octets of its BLAKE3.
const CHECK_OCTETS: int = 8

/// The path a sealed body stands at.
export fn body_path(dir: string, rev: int) -> string { joined_path(dir, "body-${rev}.pack") }

/// The file name its value bytes stand at, beside the `.pack`.
export fn val_name(rev: int) -> string { "body-${rev}.val" }

/// The path its value bytes stand at.
export fn val_path(dir: string, rev: int) -> string { joined_path(dir, val_name(rev)) }

/// One value's place in the `.val` its body names: its offset and length.
export type ValueSlot = { at: int, len: int }

/// A referenced value and its place in the `.val` the new body will name.
type Placed = { digest: string, at: int, len: int }

/// A seal folds the next run while what it holds is at least this fraction of it.
const RUN_RATIO: int = 4

/// A chain longer than this is folded whole.
const RUNS_KEPT: int = 16

/// A value file is rewritten whole once more than this many bytes of it, past twice
/// what the store references, are garbage — so values are appended, never recopied.
const VAL_SLACK: int = 1048576

fn is_body(name: string) -> bool { name.starts_with("body-") && name.ends_with(".pack") }

fn rev_of(name: string) -> int {
    if !is_body(name) { return 0 - 1 }
    parse_int(name.substring(5, name.length - 5)) ?? 0 - 1
}

/// The newest sealed body's path, or nothing when the store has none.
export fn latest_body(dir: string) -> string? {
    let best = newest_rev(dir)
    if best < 1 { return null }
    body_path(dir, best)
}

/// Every body file's name, whatever its revision.
export fn all_body_names(dir: string) -> List<string> {
    // LICENSED input.store_io: the store's own bodies, listed to seal the next
    let names = match list_dir(dir) { .Ok(ns) -> ns, .Err(_) -> [] }
    [n for n in names if is_body(n)]
}

/// A body file's revision, `body-<rev>.pack`.
export fn body_rev_of(name: string) -> int { rev_of(name) }

/// The highest sealed revision, 0 when the store has none.
fn newest_rev(dir: string) -> int {
    mut best = 0
    for name in all_body_names(dir) {
        if rev_of(name) > best { best = rev_of(name) }
    }
    best
}

/// Every body's file name, newest revision first. Each body holds everything its writer
/// had merged, so the newest whole one is the store.
fn bodies_newest_first(dir: string) -> List<string> {
    let names = all_body_names(dir)
    mut out: List<string> = []
    mut rev = newest_rev(dir)
    while rev >= 1 {
        if [n for n in names if rev_of(n) == rev].length > 0 {
            out = out.concat(["body-${rev}.pack"])
        }
        rev = rev - 1
    }
    out
}

/// A payload behind its commit marker, so a torn body is one `read_frame` away.
fn framed(payload: Bytes) -> Bytes {
    let w = writer()
    w.octets(payload)
    w.text(check_of(payload))
    w.bytes()
}

// ── Sealing ──

/// SEAL what this process holds: a new run over the runs it does not fold, or one whole
/// body when it folds them all. False when there is nothing to seal or the seal cannot be
/// written; the caller then leaves the segments as the store.
export fn seal(pack: Pack) -> bool {
    if newest_rev(pack.dir) > pack.seen_rev.get() { return false }
    let fresh = listed_keys(pack)
    let runs = pack.sealed.get()
    let k = runs_folded(runs, fresh.length)
    if k >= runs.length || runs.length >= RUNS_KEPT || pack.val_rev.get() < 1 || any_withdrawn(pack) {
        return sealed_whole(pack)
    }
    sealed_run(pack, fresh, k)
}

/// How many of the newest runs a seal of `fresh` rows folds: the next is taken while
/// what is folded so far is at least `1 / RUN_RATIO` of it.
fn runs_folded(runs: List<Sealed>, fresh: int) -> int {
    mut held = fresh
    mut k = 0
    while k < runs.length && held * RUN_RATIO >= runs[k].count {
        held = held + runs[k].count
        k = k + 1
    }
    k
}

/// The rows no run carries yet: this process's writes and the segments it read.
fn listed_keys(pack: Pack) -> List<string> { [k for k in pack.pending.get().keys() if !withdrawn(pack, k)] }

/// Whether a key stands withdrawn: a run cannot say absent, so only a whole fold drops it.
fn any_withdrawn(pack: Pack) -> bool { pack.withdrawn.get().values().any(it) }

/// Fold every run and every listed row into one whole `body-<rev>.pack`. The values it
/// references are APPENDED to the value file the last body named, never recopied;
/// the file is rewritten whole only when garbage outgrows what is referenced.
export fn sealed_whole(pack: Pack) -> bool {
    if newest_rev(pack.dir) > pack.seen_rev.get() { return false }
    materialized(pack)
    let keys = [k for k in pack.records.get().keys() if !withdrawn(pack, k)]
    if keys.is_empty() { return false }
    let rev = newest_rev(pack.dir) + 1
    let digests = referenced_digests(pack, keys)
    let size = val_size(pack.dir, pack.val_rev.get())
    let standing = standing_slots(pack, digests)
    let fresh = [d for d in digests if !pack.slots.get().has(d) && value_of(pack, d) != null]
    let live = sum_of([p.len for p in standing]) +
        sum_of([value_of(pack, d)?.length ?? 0 for d in fresh])
    let rewrite = pack.val_rev.get() < 1 || size > 2 * live + VAL_SLACK
    let val_rev = if rewrite { rev } else { pack.val_rev.get() }
    let laid = if rewrite { digests } else { fresh }
    let path = val_path(pack.dir, val_rev)
    if rewrite { let _ = remove(path) }
    let placed? = lay(pack, path, laid, if rewrite { 0 } else { size }) else { return false }
    let slots = if rewrite { placed } else { standing.concat(placed) }
    if !wrote(body_path(pack.dir, rev), body_bytes(pack, keys, rev, val_rev, 0, slots)) { return false }
    pack.rev.set(rev)
    pack.seen_rev.set(rev)
    pack.val_rev.set(val_rev)
    pack.slots.set({})
    placed_into(pack, slots)
    pack.content.set({})
    rechained(pack, rev, [])
    true
}

/// Fold the listed rows and the newest `k` runs into one run over the rest. Its values
/// are appended to the chain's one value file.
fn sealed_run(pack: Pack, fresh: List<string>, k: int) -> bool {
    let runs = pack.sealed.get()
    let keys = distinct(fresh.concat(flatten([run_keys(pack, r) for r in runs.slice(0, k)])))
    if keys.is_empty() { return false }
    let rev = newest_rev(pack.dir) + 1
    let val_rev = pack.val_rev.get()
    let digests = referenced_digests(pack, keys)
    let standing = [p! for d in digests for p in [placed_of(pack, d)] if p != null]
    let unplaced = [d for d in digests if placed_of(pack, d) == null && value_of(pack, d) != null]
    let placed? = lay(pack, val_path(pack.dir, val_rev), unplaced, val_size(pack.dir, val_rev)) else {
        return false
    }
    let slots = standing.concat(placed)
    if !wrote(body_path(pack.dir, rev), body_bytes(pack, keys, rev, val_rev, runs[k].rev, slots)) {
        return false
    }
    pack.rev.set(rev)
    pack.seen_rev.set(rev)
    placed_into(pack, placed)
    rechained(pack, rev, runs.slice(k, runs.length))
    true
}

/// Every record key one run holds, each row decoded once and carried: a newer row already
/// resident stands over the run's, and the seal reads the carried rows, never the run again.
fn run_keys(pack: Pack, s: Sealed) -> List<string> {
    [carried(pack, h!) for k in 0..s.count for h in [sealed_held_at(pack, s, k)] if h != null]
}

fn carried(pack: Pack, h: Held) -> string {
    let at = record_key(h.family, h.key)
    if pack.records.get().get(at) == null { pack.records.put(at, h) }
    at
}

/// Where the open value file holds a digest already, if it does.
fn placed_of(pack: Pack, d: string) -> Placed? {
    let s? = pack.slots.get().get(d) ?? sealed_slot(pack, d) else { return null }
    placed_at(d, s)
}

/// The new run `rev` adopted over the runs `below` it: every pending row now stands in it, and
/// a row held from a run it folded is let go, since its run's ids name nothing now.
fn rechained(pack: Pack, rev: int, below: List<Sealed>) {
    let top? = sealed_open(pack.dir, "body-${rev}.pack") else { return }
    let folded = [s.rev for s in pack.sealed.get() if !below.any(it.rev == s.rev)]
    if !folded.is_empty() {
        pack
            .records
            .set(pack.records.get().filter((e) -> e.value.set < 0 || !folded.contains(e.value.rev)))
        pack.whole.set(false)
    }
    adopted(pack, [top].concat(below))
    pack.pending.set({})
}

/// The shared-store blobs this pack's live rows name: what a collection must keep for it.
export fn pack_cas_refs(pack: Pack) -> List<string> {
    opened_at(pack, true)
    materialized(pack)
    mut refs: List<string> = []
    for k in pack.records.get().keys() {
        if withdrawn(pack, k) { continue }
        let h? = record_of(pack, k) else { continue }
        let v? = content_of(pack, h.digest) else { continue }
        refs = refs.concat(cas_named_in(v))
    }
    distinct(refs)
}

/// The places the open value file already holds for these digests.
fn standing_slots(pack: Pack, digests: List<string>) -> List<Placed> {
    [placed_at(d, s!) for d in digests for s in [pack.slots.get().get(d)] if s != null]
}

/// A value's place, by its digest.
fn placed_at(digest: string, s: ValueSlot) -> Placed { Placed { digest: digest, at: s.at, len: s.len } }

/// Places a seal laid, opened for this process's reads.
fn placed_into(pack: Pack, placed: List<Placed>) {
    for p in placed { pack.slots.put(p.digest, ValueSlot { at: p.at, len: p.len }) }
}

/// The distinct digests the live rows name, in digest order.
fn referenced_digests(pack: Pack, keys: List<string>) -> List<string> {
    mut seen: Map<string, bool> = {}
    for k in keys {
        let h? = record_of(pack, k) else { continue }
        seen.set(h.digest, true)
    }
    sorted_by(seen.keys(), text_before)
}

/// A value's octets are written this many at a time, so a rewrite never holds the
/// whole value file twice.
const LAY_BATCH: int = 8388608

/// The values laid end to end in `path` from offset `from`, each with its place;
/// nothing when a write fails.
fn lay(pack: Pack, path: string, laid: List<string>, from: int) -> List<Placed>? {
    mut placed: List<Placed> = []
    mut batch: List<Bytes> = []
    mut held = 0
    mut at = from
    for d in laid {
        let bytes? = value_of(pack, d) else { continue }
        placed.push(Placed { digest: d, at: at, len: bytes.length })
        batch.push(bytes)
        held = held + bytes.length
        at = at + bytes.length
        if held >= LAY_BATCH {
            if !appended_to(path, batch.bytes()) { return null }
            batch = []
            held = 0
        }
    }
    if !appended_to(path, batch.bytes()) { return null }
    placed
}

fn sum_of(xs: List<int>) -> int { xs.fold(0, (a, b) -> a + b) }

/// A value file's size in octets, 0 when it does not stand.
fn val_size(dir: string, rev: int) -> int {
    // LICENSED input.store_io: the store's own value file, measured to append past it
    match open_beneath(dir, val_name(rev)) {
        .Ok(o) -> {
            let n = o.size
            o.close()
            n
        },
        .Err(_) -> 0,
    }
}

fn appended_to(at: string, bytes: Bytes) -> bool {
    if bytes.length == 0 { return true }
    match append_bytes(at, bytes) { .Ok(_) -> true, .Err(_) -> false }
}

fn wrote(at: string, bytes: Bytes) -> bool {
    match write_bytes(at, bytes) { .Ok(_) -> true, .Err(_) -> false }
}

/// The body's bytes: the head, then the index, slots, families, names, reads, sets,
/// holders and rows.
fn body_bytes(
    pack: Pack,
    keys: List<string>,
    rev: int,
    val_rev: int,
    base: int,
    placed: List<Placed>,
) -> Bytes {
    let lined = indexed(pack, keys)
    let held = [l.held for l in lined]
    let lines = [reads_of(pack, h) for h in held]
    let read = flatten(lines)
    let n = names()
    n.filled([read_part(l).name for l in read])
    let reads_seen = read_table(n, read)
    let s = sets()
    let set_ids = [s.intern([reads_seen.ids.get(l) ?? 0 for l in ls]) for ls in lines]
    let families = sorted_by(distinct([h.family for h in held]), text_before)
    let family_ids = ordinals_of(families)
    let rows = [row_bytes(h, family_ids.get(h.family) ?? 0, set_ids[i]) for i, h in held]
    let sections = [
        index_bytes(lined, rows),
        slot_bytes(placed),
        texts_bytes(families),
        n.encode(),
        reads_bytes(reads_seen),
        s.encode(),
        holders_bytes(set_ids, s.length()),
        rows.bytes(),
    ]
    let head = writer()
    head.text(BODY_MAGIC)
    head.int(BODY_VERSION)
    head.int(rev)
    head.int(val_rev)
    head.int(base)
    head.text(pack.print)
    head.int(held.length)
    mut at = 0
    for i, part in sections {
        head.int(at)
        head.int(part.length)
        head.text(if i == ROWS_AT { "" } else { check_of(part) })
        at = at + part.length
    }
    [framed(head.bytes())].concat(sections).bytes()
}

/// A row and the leading hex of its action key, as its index line spells it.
type Lined = { hex: string, held: Held }

/// The live rows in index order: by the leading hex of their action key, the order a lookup
/// bisects. The hex is made once a row and rides with it.
fn indexed(pack: Pack, keys: List<string>) -> List<Lined> {
    [Lined {
        hex: t.substring(0, 2 * KEY_OCTETS),
        held: record_of(pack, t.substring(2 * KEY_OCTETS, t.length))!,
    } for t in sorted_by(["${index_hex(k)}${k}" for k in keys], text_before)]
}

/// The leading hex of the action key a record key's index line holds.
fn index_hex(at: string) -> string { digest_of_octets(at.bytes()).substring(0, 2 * KEY_OCTETS) }

/// Each text's place in the list, by the text.
fn ordinals_of(texts: List<string>) -> Map<string, int> {
    mut out: Map<string, int> = {}
    for i, t in texts { out.set(t, i) }
    out
}

/// One row as the rows section holds it: its family's place, its key, its value's digest
/// and its read set, behind its own check — what a lookup decodes, and checks against its key.
fn row_bytes(h: Held, family: int, set_id: int) -> Bytes {
    let w = writer()
    w.varint(family)
    wrote_digest(w, h.key)
    wrote_digest(w, h.digest)
    w.varint(set_id)
    let payload = w.bytes()
    let framed_row = writer()
    framed_row.octets(payload)
    wrote_octets(framed_row, row_check(payload))
    framed_row.bytes()
}

/// A row's check: the leading octets of its BLAKE3.
fn row_check(payload: Bytes) -> Bytes { unhex(check_of(payload))! }

/// Text the body spells as octets: a whole BLAKE3 hex digest is its 32 octets behind a 0,
/// any other text itself behind a 1.
fn wrote_digest(w: Writer, s: string) {
    let raw? = digest_octets(s) else {
        w.byte(1)
        w.text(s)
        return
    }
    w.byte(0)
    wrote_octets(w, raw)
}

/// A digest's octets, absent for text that is no whole lowercase hex digest.
fn digest_octets(s: string) -> Bytes? {
    if s.length != 2 * DIGEST_OCTETS { return null }
    unhex(s)
}

/// Octets written as they are, no length before them.
fn wrote_octets(w: Writer, b: Bytes) {
    for i in 0..b.length { w.byte(b.at(i)) }
}

/// `n` as `width` octets, high first.
fn wrote_wide(w: Writer, n: int, width: int) {
    for k in 0..width { w.byte(n >> 8 * (width - 1 - k)) }
}

/// The `width` octets at `at`, high first.
fn wide_at(b: Bytes, at: int, width: int) -> int { (0..width).fold(0, (v, k) -> v * 256 + b.at(at + k)) }

/// `wrote_digest` read back.
fn read_digest(r: Reader) -> string? {
    let tag? = ok(r.byte()) else { return null }
    if tag == 1 { return ok(r.text()) }
    let at = r.at.get()
    if tag != 0 || at + DIGEST_OCTETS > r.b.length { return null }
    r.at.set(at + DIGEST_OCTETS)
    hex(r.b.slice(at, at + DIGEST_OCTETS))
}

/// Where each referenced value stands in the `.val`: one line a digest, sorted by digest.
fn slot_bytes(placed: List<Placed>) -> Bytes {
    let w = writer()
    for p in sorted_by(placed, (a: Placed, b: Placed) -> text_before(a.digest, b.digest)) {
        let raw? = digest_octets(p.digest) else { continue }
        wrote_octets(w, raw)
        wrote_wide(w, p.at, AT_OCTETS)
        wrote_wide(w, p.len, LENGTH_OCTETS)
    }
    w.bytes()
}

/// The index: one line a row, sorted by key — the line's position is the row's ordinal.
fn index_bytes(lined: List<Lined>, rows: List<Bytes>) -> Bytes {
    let w = writer()
    mut at = 0
    for i, l in lined {
        wrote_octets(w, unhex(l.hex)!)
        wrote_wide(w, at, OFFSET_OCTETS)
        wrote_wide(w, rows[i].length, LENGTH_OCTETS)
        at = at + rows[i].length
    }
    w.bytes()
}

/// A list of texts: its count, then each.
fn texts_bytes(texts: List<string>) -> Bytes {
    let w = writer()
    w.count(texts.length)
    for t in texts { w.text(t) }
    w.bytes()
}

/// `texts_bytes` read back.
fn texts_from(b: Bytes) -> List<string>? {
    let r = reader(b)
    let n? = ok(r.count()) else { return null }
    mut out: List<string> = []
    for _i in 0..n {
        let t? = ok(r.text()) else { return null }
        out.push(t)
    }
    if !r.done() { return null }
    out
}

/// One read as the body files it: the name read, and the digest it was read at — empty for
/// a line that carries none.
export type ReadPart = { name: string, digest: string }

/// A read line split at its first space: a line with no digest before its name is all name.
fn read_part(line: string) -> ReadPart {
    let at = line.index_of(" ")
    if at <= 0 { return ReadPart { name: line, digest: "" } }
    ReadPart { name: line.substring(at + 1, line.length), digest: line.substring(0, at) }
}

/// `read_part` spelled back as the line it came from.
fn read_line(p: ReadPart) -> string { if p.digest.is_empty() { p.name } else { "${p.digest} ${p.name}" } }

/// A body's reads, each once, sorted by name then digest — a read's id is its place — with
/// each line's id and each name's.
type ReadTable = { parts: List<ReadPart>, ids: Map<string, int>, names: Map<string, int> }

fn read_table(n: Names, lines: List<string>) -> ReadTable {
    let name_ids = ordinals_of(n.texts.get())
    let parts = sorted_by(
        [read_part(l) for l in distinct(lines)],
        (a: ReadPart, b: ReadPart) -> read_before(name_ids, a, b),
    )
    ReadTable { parts: parts, ids: ordinals_of([read_line(p) for p in parts]), names: name_ids }
}

fn read_before(name_ids: Map<string, int>, a: ReadPart, b: ReadPart) -> bool {
    let x = name_ids.get(a.name) ?? 0
    let y = name_ids.get(b.name) ?? 0
    x < y || x == y && text_before(a.digest, b.digest)
}

/// The reads: each its name's id, rising by delta, then its digest.
fn reads_bytes(seen: ReadTable) -> Bytes {
    let w = writer()
    w.count(seen.parts.length)
    mut prev = 0
    for p in seen.parts {
        let id = seen.names.get(p.name) ?? 0
        w.varint(id - prev)
        wrote_digest(w, p.digest)
        prev = id
    }
    w.bytes()
}

/// `reads_bytes` read back over its names; absent when a read names no name.
fn reads_from(n: Names, b: Bytes) -> List<ReadPart>? {
    let r = reader(b)
    let count? = ok(r.count()) else { return null }
    mut out: List<ReadPart> = []
    mut id = 0
    for _i in 0..count {
        let delta? = ok(r.varint()) else { return null }
        id = id + delta
        if delta < 0 || id >= n.length() { return null }
        let digest? = read_digest(r) else { return null }
        out.push(ReadPart { name: n.text_of(id), digest: digest })
    }
    if !r.done() { return null }
    out
}

/// THE HOLDERS: each read set's rows, by ordinal, rising by delta — the second step of the
/// reverse, a set to the rows that read it.
fn holders_bytes(set_ids: List<int>, sets: int) -> Bytes {
    mut held: List<List<int>> = [[] for _s in 0..sets]
    for ordinal, s in set_ids { held[s].push(ordinal) }
    let w = writer()
    w.count(held.length)
    for ords in held {
        w.count(ords.length)
        mut prev = 0
        for o in ords {
            w.varint(o - prev)
            prev = o
        }
    }
    w.bytes()
}

/// `holders_bytes` read back; absent when it does not decode whole.
fn holders_from(b: Bytes) -> List<List<int>>? {
    let r = reader(b)
    let n? = ok(r.count()) else { return null }
    mut out: List<List<int>> = []
    for _s in 0..n {
        let k? = ok(r.count()) else { return null }
        mut ords: List<int> = []
        mut at = 0
        for _i in 0..k {
            let delta? = ok(r.varint()) else { return null }
            at = at + delta
            ords.push(at)
        }
        out.push(ords)
    }
    if !r.done() { return null }
    out
}

/// Where a section stands in the file, and the check its head holds for it.
type Place = { at: int, len: int, check: string }

/// A sealed body, open and lazy: the file's mapping, the head's facts and where
/// each section stands. No row is decoded until a lookup asks for it.
export type Sealed = {
    m: Mapped,
    rev: int,
    val_rev: int,
    /// The run below this one, 0 when this body is whole.
    below: int,
    print: string,
    count: int,
    /// Where the head's frame ends, so every section's place counts from it.
    base: int,
    slots: Place,
    families: Place,
    names: Place,
    reads: Place,
    sets: Place,
    holders: Place,
    rows: Place,
    /// The slot section, read once by the first value that asks where it stands.
    slot_table: Cell<List<Bytes>>,
    /// The family table, read once by the first row decoded.
    family_table: Cell<List<List<string>>>,
}

/// The record keys of the sealed rows that read any of `moved`: each run's sets that hold a
/// moved name, then the rows that hold those sets. A row since overwritten is left to the
/// live scan.
export fn sealed_readers(pack: Pack, moved: Map<string, bool>) -> List<string> {
    flatten([run_readers(pack, s, moved) for s in pack.sealed.get()])
}

/// `sealed_readers` over one run: a row a newer run or this process overwrote is not its.
fn run_readers(pack: Pack, s: Sealed, moved: Map<string, bool>) -> List<string> {
    let t? = tables_for(pack, s) else { return [] }
    let named = sets_by_name(t)
    mut wanted: Map<string, bool> = {}
    for m in moved.keys() {
        for set in named.get(m) ?? [] { wanted.set("${set}", true) }
    }
    mut out: List<string> = []
    for set, held in t.holders {
        if !wanted.has("${set}") { continue }
        for at in held {
            let h? = sealed_held_at(pack, s, at) else { continue }
            let key = record_key(h.family, h.key)
            if resident_held(pack, key, h) { out.push(key) }
        }
    }
    out
}

/// Each name a run's sets read, with the sets that read it — made on the first ask and kept.
fn sets_by_name(t: Tables) -> Map<string, List<int>> {
    let known = t.named.get().first()
    if known != null { return known }
    mut out: Map<string, List<int>> = {}
    for set in 0..t.sets.length() {
        for id in t.sets.members(set) {
            let name = t.reads[id].name
            out.set(name, (out.get(name) ?? []).concat([set]))
        }
    }
    t.named.set([out])
    out
}

/// Whether a run's row still stands as that run wrote it: no newer run or write over it,
/// not withdrawn.
fn resident_held(pack: Pack, key: string, h: Held) -> bool {
    if withdrawn(pack, key) { return false }
    let mine = pack.records.get().get(key)
    if mine != null { return mine!.set >= 0 && mine!.rev == h.rev }
    !pack.sealed.get().take_while(it.rev != h.rev).any((s) -> sealed_held(pack, s, key) != null)
}

/// A row by its record key: this process's own (a segment, a write) over the runs', the
/// newest run first. A row decoded from a run is kept, so it is decoded once.
fn record_of(pack: Pack, at: string) -> Held? {
    let held = pack.records.get().get(at)
    if held != null { return held }
    for s in pack.sealed.get() {
        let h? = sealed_held(pack, s, at) else { continue }
        pack.records.put(at, h)
        return h
    }
    null
}

/// The sealed body's row under a record key: found in the index, decoded, and held to the
/// key it was asked by — a row that decodes to another key is no answer.
fn sealed_held(pack: Pack, s: Sealed, at: string) -> Held? {
    let want = unhex(index_hex(at))!
    mut ordinal = first_from(pack, s, want)
    while ordinal < s.count && octets_order(index_line_key(pack, s, ordinal), 0, want) == 0 {
        let h? = sealed_held_at(pack, s, ordinal) else { return null }
        if record_key(h.family, h.key) == at { return h }
        ordinal = ordinal + 1
    }
    null
}

/// The first ordinal whose line holds `want` or more: a bisection of the key-sorted index,
/// one line read a step.
fn first_from(pack: Pack, s: Sealed, want: Bytes) -> int {
    mut lo = 0
    mut hi = s.count
    while lo < hi {
        let mid = (lo + hi) / 2
        if octets_order(index_line_key(pack, s, mid), 0, want) < 0 { lo = mid + 1 } else { hi = mid }
    }
    lo
}

/// The leading key octets one index line holds, counted as a probe and read
/// where they lie.
fn index_line_key(pack: Pack, s: Sealed, ordinal: int) -> Bytes {
    let t = pack.traffic.get()
    pack.traffic.set(t with { probes: t.probes + 1 })
    mapped_at(s.m, s.base + ordinal * LINE, KEY_OCTETS) ?? "".bytes()
}

/// How the octets of `b` from `at` order against `want`: negative before, 0 equal,
/// positive after — the first octet that differs decides, so a probe reads one or two.
fn octets_order(b: Bytes, at: int, want: Bytes) -> int {
    if b.length < at + want.length { return 0 - 1 }
    for k in 0..want.length {
        let d = b.at(at + k) - want.at(k)
        if d != 0 { return d }
    }
    0
}

/// One row of the sealed body by ordinal, decoded from its span of the rows section; its
/// value's place joins the open slots. Absent when the row does not decode.
fn sealed_held_at(pack: Pack, s: Sealed, ordinal: int) -> Held? {
    if ordinal < 0 || ordinal >= s.count { return null }
    let line? = mapped_at(s.m, s.base + ordinal * LINE, LINE) else { return null }
    let offset = wide_at(line, KEY_OCTETS, OFFSET_OCTETS)
    let length = wide_at(line, KEY_OCTETS + OFFSET_OCTETS, LENGTH_OCTETS)
    let at = s.base + s.rows.at + offset
    let raw = mapped_at(s.m, at, length)
    let families = families_of(s)
    let h? = decoded_row(reader(raw ?? "".bytes()), families ?? [], s.rev) else {
        // a row the index places and that does not read back whole is damage, said once
        torn_at(pack, at)
        return null
    }
    if traced() { qtrace("Q\tstore\trow\t${ordinal}\n") }
    let t = pack.traffic.get()
    pack.traffic.set(t with { rows: t.rows + 1 })
    h
}

/// A row read back and held to its own check, its family named through the body's table.
fn decoded_row(framed_row: Reader, families: List<string>, rev: int) -> Held? {
    let payload? = ok(framed_row.octets()) else { return null }
    let at = framed_row.at.get()
    if at + CHECK_OCTETS != framed_row.b.length { return null }
    if hex(framed_row.b.slice(at, at + CHECK_OCTETS)) != check_of(payload) { return null }
    let r = reader(payload)
    let family? = ok(r.varint()) else { return null }
    if family < 0 || family >= families.length { return null }
    let key? = read_digest(r) else { return null }
    let digest? = read_digest(r) else { return null }
    let set? = ok(r.varint()) else { return null }
    if !r.done() { return null }
    Held {
        family: families[family],
        key: key,
        digest: digest,
        read: [],
        set: set,
        stamp: 0,
        rev: rev,
    }
}

/// The body's family table, read once.
fn families_of(s: Sealed) -> List<string>? {
    let known = s.family_table.get().first()
    if known != null { return known }
    let families? = texts_from(section_of(s, s.families) ?? "".bytes()) else { return null }
    s.family_table.set([families])
    families
}

/// Where a run keeps a value: found by its digest in the newest slot section that names
/// it, each read on its first ask. A line that does not parse is no answer.
export fn sealed_slot(pack: Pack, digest: string) -> ValueSlot? {
    for s in pack.sealed.get() {
        let slot = run_slot(s, digest)
        if slot != null { return slot }
    }
    null
}

fn run_slot(s: Sealed, digest: string) -> ValueSlot? {
    let want? = digest_octets(digest) else { return null }
    let slot_lines? = slot_table_of(s) else { return null }
    mut lo = 0
    mut hi = slot_lines.length / SLOT_LINE
    while lo < hi {
        let mid = (lo + hi) / 2
        if octets_order(slot_lines, mid * SLOT_LINE, want) < 0 { lo = mid + 1 } else { hi = mid }
    }
    if lo * SLOT_LINE >= slot_lines.length || octets_order(slot_lines, lo * SLOT_LINE, want) != 0 { return null }
    slot_at(slot_lines, lo)
}

fn slot_table_of(s: Sealed) -> Bytes? {
    let known = s.slot_table.get().first()
    if known != null { return known }
    let slot_lines? = section_of(s, s.slots) else { return null }
    s.slot_table.set([slot_lines])
    slot_lines
}

/// The digest the slot section's line `k` names.
fn slot_digest(slot_lines: Bytes, k: int) -> string {
    hex(slot_lines.slice(k * SLOT_LINE, k * SLOT_LINE + DIGEST_OCTETS))
}

/// The place the slot section's line `k` names.
fn slot_at(slot_lines: Bytes, k: int) -> ValueSlot {
    let line = k * SLOT_LINE + DIGEST_OCTETS
    ValueSlot {
        at: wide_at(slot_lines, line, AT_OCTETS),
        len: wide_at(slot_lines, line + AT_OCTETS, LENGTH_OCTETS),
    }
}

/// A section of the sealed body, read whole from its place and held to the check its head
/// holds for it — a damaged section answers absent.
fn section_of(s: Sealed, place: Place) -> Bytes? {
    let bytes? = mapped_at(s.m, s.base + place.at, place.len) else { return null }
    if place.check != "" && check_of(bytes) != place.check { return null }
    bytes
}

/// EVERY SEALED ROW LIFTED INTO THE OPEN INDEX, once: a whole seal folds all the rows, so
/// it reads them all. Rows this process wrote since stand over the runs', a newer run's
/// over an older's.
fn materialized(pack: Pack) {
    if pack.whole.get() { return }
    pack.whole.set(true)
    for s in pack.sealed.get() { lifted(pack, s) }
}

/// One run's rows and slots lifted where nothing newer stands.
fn lifted(pack: Pack, s: Sealed) {
    let _ = tables_for(pack, s)
    for k in 0..s.count {
        let h? = sealed_held_at(pack, s, k) else { return }
        let at = record_key(h.family, h.key)
        if pack.records.get().get(at) == null { pack.records.put(at, h) }
    }
    let slot_lines? = slot_table_of(s) else { return }
    let count = slot_lines.length / SLOT_LINE
    for k in 0..count {
        let digest = slot_digest(slot_lines, k)
        if !pack.slots.get().has(digest) { pack.slots.put(digest, slot_at(slot_lines, k)) }
    }
}

/// The keys a row read: its own list, or its set in its run's tables —
/// decoded on the first ask, since an open reads values and never read sets.
/// A set the tables cannot name reads as none: a read set is a record of
/// edges, and a row stands without them.
fn reads_of(pack: Pack, h: Held) -> List<string> { reads_known(pack, h) ?? [] }

/// A row's read list, absent when its set cannot be named: a row that must
/// prove its reads cannot take a list it could not read for none.
fn reads_known(pack: Pack, h: Held) -> List<string>? {
    if h.set < 0 { return h.read }
    let t? = tables_of_rev(pack, h.rev) else { return null }
    if h.set >= t.sets.length() { return null }
    let ids = t.sets.members(h.set)
    if ids.any(it < 0 || it >= t.reads.length) { return null }
    [read_line(t.reads[id]) for id in ids]
}

/// The tables of the run a row came from, decoded on the first ask and kept.
fn tables_of_rev(pack: Pack, rev: int) -> Tables? {
    let known = pack.tables.get().get("${rev}")
    if known != null { return known }
    let s? = pack.sealed.get().find(it.rev == rev) else { return null }
    tables_for(pack, s)
}

fn tables_for(pack: Pack, s: Sealed) -> Tables? {
    let known = pack.tables.get().get("${s.rev}")
    if known != null { return known }
    let made? = tables_read(s) else {
        // a body whose tables do not read back whole is damage, said once
        torn_at(pack, s.base)
        return null
    }
    pack.tables.put("${s.rev}", made)
    made
}

/// A run's tables read back from its sections, each held to its check; absent when any
/// does not decode whole.
fn tables_read(s: Sealed) -> Tables? {
    let n? = names_from(section_of(s, s.names) ?? "".bytes()) else { return null }
    let reads? = reads_from(n, section_of(s, s.reads) ?? "".bytes()) else { return null }
    let sets? = sets_from(section_of(s, s.sets) ?? "".bytes()) else { return null }
    let holders? = holders_from(section_of(s, s.holders) ?? "".bytes()) else { return null }
    if holders.length != sets.length() || holders.any((ords) -> ords.any(it >= s.count)) { return null }
    Tables { reads: reads, sets: sets, holders: holders, named: list_cell() }
}

// ── Reading ──

/// How much of a body's start is read to find its head: the head is a few hundred octets.
const HEAD_WINDOW: int = 16384

/// A body opened lazily: its head read and its index checked in place, nothing decoded.
/// Absent for a file that is missing, torn, of another version, or whose index does not
/// match what its head says.
fn sealed_open(dir: string, name: string) -> Sealed? {
    let m? = body_mapped(dir, name) else { return null }
    let head? = mapped_at(m, 0, if m.len < HEAD_WINDOW { m.len } else { HEAD_WINDOW }) else {
        mapped_close(m)
        return null
    }
    let framed_head = reader(head)
    let payload? = read_frame(framed_head) else {
        mapped_close(m)
        return null
    }
    let s? = sealed_from(m, payload, framed_head.at.get()) else {
        mapped_close(m)
        return null
    }
    s
}

/// A body's own file, mapped. A name that could leave the store's directory
/// is no body: a mapping row takes a PATH, so the door `open_beneath` held is
/// spelled here instead.
fn body_mapped(dir: string, name: string) -> Mapped? {
    if name.contains("/") || name.contains("..") { return null }
    mapped(joined_path(dir, name))
}

/// A head's leading facts — its revision, the value file and run it names, its print — read
/// off `r`, which then stands at the section places.
fn head_fields(r: Reader) -> BodyHead? {
    let magic? = ok(r.text()) else { return null }
    if magic != BODY_MAGIC { return null }
    let version? = ok(r.int()) else { return null }
    if version != BODY_VERSION { return null }
    let rev? = ok(r.int()) else { return null }
    let val_rev? = ok(r.int()) else { return null }
    let below? = ok(r.int()) else { return null }
    if below < 0 || below >= rev { return null }
    let print? = ok(r.text()) else { return null }
    BodyHead { rev: rev, val_rev: val_rev, below: below, print: print }
}

/// A head decoded and its index checked where it lies.
fn sealed_from(m: Mapped, payload: Bytes, base: int) -> Sealed? {
    let r = reader(payload)
    let head? = head_fields(r) else { return null }
    let rev = head.rev
    let val_rev = head.val_rev
    let below = head.below
    let print = head.print
    let count? = ok(r.int()) else { return null }
    mut places: List<Place> = []
    for _i in 0..SECTIONS {
        let at? = ok(r.int()) else { return null }
        let len? = ok(r.int()) else { return null }
        let check? = ok(r.text()) else { return null }
        places.push(Place { at: at, len: len, check: check })
    }
    if !r.done() { return null }
    let last = places[ROWS_AT]
    if !mapped_holds(m, base + last.at, last.len) { return null }
    let index = places[0]
    if index.len != count * LINE || places[1].len % SLOT_LINE != 0 { return null }
    let marker? = mapped_check(m, base + index.at, index.len) else { return null }
    if marker != index.check { return null }
    Sealed {
        m: m,
        rev: rev,
        val_rev: val_rev,
        below: below,
        print: print,
        count: count,
        base: base,
        slots: places[1],
        families: places[2],
        names: places[3],
        reads: places[4],
        sets: places[5],
        holders: places[6],
        rows: places[ROWS_AT],
        slot_table: list_cell(),
        family_table: list_cell(),
    }
}

/// How many rows the open runs hold, a row two runs carry counted twice.
fn sealed_count(pack: Pack) -> int { pack.sealed.get().fold(0, (n, s) -> n + s.count) }

/// The pack's runs, newest first: the newest names the value file, every row lazy. A run
/// the new chain does not keep has its mapping closed.
fn adopted(pack: Pack, chain: List<Sealed>) {
    for old in pack.sealed.get() {
        if !chain.any(it.rev == old.rev) { mapped_close(old.m) }
    }
    pack.sealed.set(chain)
    let top? = chain.first() else { return }
    pack.rev.set(top.rev)
    pack.val_rev.set(top.val_rev)
}

/// A body and every run below it, newest first — absent when any of them cannot be read,
/// or names a value file other than the newest's.
fn chain_open(dir: string, name: string) -> List<Sealed>? {
    let top? = sealed_open(dir, name) else { return null }
    mut chain = [top]
    mut below = top.below
    while below > 0 {
        let s? = sealed_open(dir, "body-${below}.pack") else {
            closed_all(chain)
            return null
        }
        chain.push(s)
        if s.val_rev != top.val_rev {
            closed_all(chain)
            return null
        }
        below = s.below
    }
    chain
}

fn closed_all(chain: List<Sealed>) {
    for s in chain { mapped_close(s.m) }
}

/// Open ONE sealed revision into the pack — the time-travel read (§6.7). A
/// missing or torn revision answers false; `pack` is reset to hold only this
/// body's rows, so use a fresh pack and leave the live open alone.
export fn body_scan_rev(pack: Pack, rev: int) -> bool {
    let chain? = chain_open(pack.dir, "body-${rev}.pack") else {
        torn_at(pack, 0)
        return false
    }
    pack.records.set({})
    pack.pending.set({})
    pack.slots.set({})
    pack.withdrawn.set({})
    pack.tables.set({})
    pack.whole.set(false)
    adopted(pack, chain)
    true
}

/// Every row the open runs hold, a newer run's over an older's, each run in body order —
/// what `explain` reads to say what changed.
export fn sealed_rows(pack: Pack) -> List<Held> {
    mut seen: Map<string, bool> = {}
    mut out: List<Held> = []
    for s in pack.sealed.get() {
        for k in 0..s.count {
            let h? = sealed_held_at(pack, s, k) else { continue }
            let at = record_key(h.family, h.key)
            if seen.has(at) { continue }
            seen.set(at, true)
            out.push(h)
        }
    }
    out
}

/// The print the newest whole body was made under — what a compaction folds
/// under, so a reclaim does not rename the store's compiler. None when no body
/// stands, and the caller writes its own.
export fn store_print(dir: string) -> string? {
    let newest? = sorted_by(all_body_names(dir), rev_before).last() else { return null }
    body_print_of(dir, newest)
}

/// Open the newest body's chain into the pack, before the segments so a later segment
/// wins. Only that chain is read: it holds everything its writer had merged. A torn or
/// foreign body, or one whose chain is broken, is skipped, and says so once.
export fn body_scan(pack: Pack) {
    for name in bodies_newest_first(pack.dir) {
        let chain? = chain_open(pack.dir, name) else {
            torn_at(pack, 0)
            continue
        }
        if traced() {
            qtrace(
                "Q\tstore\tbody\t${joined_path(pack.dir, name)}\t${chain.length}\t${sealed_rows_held(chain) * LINE}\n",
            )
        }
        adopted(pack, chain)
        return
    }
}

fn sealed_rows_held(chain: List<Sealed>) -> int { chain.fold(0, (n, s) -> n + s.count) }

/// A sealed body's head: its revision, the value revision and run below it names, and the
/// compiler print it was made under.
type BodyHead = { rev: int, val_rev: int, below: int, print: string }

/// A body's head alone — its frame checked, its index never read — so a walk over every
/// body's chain costs a head each: none when the head cannot be read.
fn head_of(dir: string, name: string) -> BodyHead? {
    let m? = body_mapped(dir, name) else { return null }
    let head = mapped_at(m, 0, if m.len < HEAD_WINDOW { m.len } else { HEAD_WINDOW })
    mapped_close(m)
    let payload? = read_frame(reader(head ?? "".bytes())) else { return null }
    head_fields(reader(payload))
}

/// The bodies a body's chain stands on, itself first; empty when a link is missing.
export fn chain_names(dir: string, name: string) -> List<string> {
    mut out = [name]
    mut below = head_of(dir, name)?.below ?? 0 - 1
    while below > 0 {
        let next = "body-${below}.pack"
        let h? = head_of(dir, next) else { return [] }
        out.push(next)
        below = h.below
    }
    if below < 0 { [] } else { out }
}

fn body_print_of(dir: string, name: string) -> string? { head_of(dir, name)?.print }

/// Value files no standing body names are removed; a value file is shared by the
/// bodies appended to it and goes with the last of them.
export fn drop_unreferenced_values(dir: string) {
    // LICENSED input.store_io: the store's own files, listed to drop what no body names
    let names = match list_dir(dir) { .Ok(ns) -> ns, .Err(_) -> [] }
    let named = [head_of(dir, n)?.val_rev for n in names if is_body(n)]
    let wanted = [v! for v in named if v != null]
    for n in names {
        if !(n.starts_with("body-") && n.ends_with(".val")) { continue }
        let rev = parse_int(n.substring(5, n.length - 4)) ?? 0 - 1
        if !wanted.contains(rev) { let _ = remove(joined_path(dir, n)) }
    }
}
