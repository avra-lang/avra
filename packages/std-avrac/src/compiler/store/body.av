//! THE SEALED BODY — a segment's worth of records folded into one file, and
//! its index. §6.1's `body-<rev>.pack`: a header, the body's NAMES and
//! interned READ SETS (compiler/store/names.av), the CONTENT index (value
//! digest -> offset and length in `body-<rev>.val`), then per family its
//! META columns — action key, value digest, set id, revisions. The payload
//! is one commit-marked frame, so a half-written body is torn and never
//! read. The values are NOT in the frame: a read seeks one value and checks
//! it against its own digest, so an open reads the index alone.
//!
//! `body-<rev>.idx` is §6.1's S4 lookup: a 256-entry fan-out over the action
//! keys' first byte, the keys sorted, and a parallel offset per key.
use @std.io.{read_bytes, write_bytes, list_dir}
use @std.path.{joined_path}
use @std.relation.stable.{writer, reader, Writer}
use @std.relation.engine.{list_cell, map_cell}
use @std.text.{parse_int}
use core.{sorted_by, text_before}
use core.debug.{qtrace, traced}

const BODY_MAGIC: string = "AVRABODY"
const IDX_MAGIC: string = "AVRABIDX"
const BODY_VERSION: int = 1

/// §6.1's families, in one fixed order so a body's bytes are deterministic.
const FAMILIES: List<string> = ["sig", "fp", "unit", "warn", "rows"]

/// The path a sealed body stands at.
export fn body_path(dir: string, rev: int) -> string { joined_path(dir, "body-${rev}.pack") }

/// The path its index stands at.
export fn idx_path(dir: string, rev: int) -> string { joined_path(dir, "body-${rev}.idx") }

/// The file name its value bytes stand at, beside the `.pack`.
export fn val_name(rev: int) -> string { "body-${rev}.val" }

/// The path its value bytes stand at.
export fn val_path(dir: string, rev: int) -> string { joined_path(dir, val_name(rev)) }

/// One value's place in its body's `.val`: its digest, offset and length.
export type ValueSlot = { at: int, len: int }

/// A value laid end to end in a body's `.val`, with its place.
type Placed = { digest: string, at: int, len: int, data: Bytes }

fn is_body(name: string) -> bool { name.starts_with("body-") && name.ends_with(".pack") }

fn rev_of(name: string) -> int {
    if !is_body(name) { return 0 - 1 }
    parse_int(name.substring(5, name.length - 5)) ?? 0 - 1
}

/// The newest sealed body's path, or nothing when the store has none.
export fn latest_body(dir: string) -> string? {
    let best = newest_rev(dir)
    if best < 1 { return null }
    body_path(dir, best)
}

/// Every body file's name, whatever its revision.
export fn all_body_names(dir: string) -> List<string> {
    // LICENSED input.store_io: the store's own bodies, listed to seal the next
    let names = match list_dir(dir) { .Ok(ns) -> ns, .Err(_) -> [] }
    [n for n in names if is_body(n)]
}

/// A body file's revision, `body-<rev>.pack`.
export fn body_rev_of(name: string) -> int { rev_of(name) }

/// The highest sealed revision, 0 when the store has none.
fn newest_rev(dir: string) -> int {
    mut best = 0
    for name in all_body_names(dir) {
        if rev_of(name) > best { best = rev_of(name) }
    }
    best
}

/// Every body, newest revision first. Each body holds everything its writer
/// had merged, so the newest whole one is the store.
fn bodies_newest_first(dir: string) -> List<string> {
    let names = all_body_names(dir)
    mut out: List<string> = []
    mut rev = newest_rev(dir)
    while rev >= 1 {
        if [n for n in names if rev_of(n) == rev].length > 0 {
            out = out.concat([body_path(dir, rev)])
        }
        rev = rev - 1
    }
    out
}

/// A payload behind its commit marker, so a torn body is one `read_frame` away.
fn framed(payload: Bytes) -> Bytes {
    let w = writer()
    w.octets(payload)
    w.text(check_of(payload))
    w.bytes()
}

// ── Sealing ──

/// Fold this pack's index into one `body-<rev>.pack` + `.idx`. False when
/// there is nothing to seal or the seal cannot be written; the caller then
/// leaves the segments as the store.
export fn seal(pack: Pack) -> bool {
    let keys = sorted_by(pack.records.get().keys(), text_before)
    if keys.is_empty() { return false }
    let rev = newest_rev(pack.dir) + 1
    let placed = placed_values(all_content(pack).get())
    let payload = body_payload(pack, keys, rev, placed)
    let idx = idx_payload(keys, rev)
    let values = [p.data for p in placed].bytes()
    if !wrote(val_path(pack.dir, rev), values) { return false }
    if !wrote(idx_path(pack.dir, rev), idx) { return false }
    if !wrote(body_path(pack.dir, rev), framed(payload)) { return false }
    pack.rev.set(rev)
    for p in placed { pack.slots.put(p.digest, ValueSlot { at: p.at, len: p.len }) }
    true
}

/// Every value the store holds, in memory or in a sealed body.
fn all_content(pack: Pack) -> Cell<Map<string, string>> {
    let all: Cell<Map<string, string>> = map_cell()
    for d, v in pack.content.get() { all.put(d, v) }
    for d in pack.slots.get().keys() {
        if !all.get().has(d) {
            let v? = spilled(pack, d) else { continue }
            all.put(d, v)
        }
    }
    all
}

/// The values in digest order, each at the offset the one before it ends.
fn placed_values(values: Map<string, string>) -> List<Placed> {
    mut at = 0
    mut out: List<Placed> = []
    for d in sorted_by(values.keys(), text_before) {
        let v? = values.get(d) else { continue }
        let data = v.bytes()
        out = out.concat([Placed { digest: d, at: at, len: data.length, data: data }])
        at = at + data.length
    }
    out
}

fn wrote(at: string, bytes: Bytes) -> bool {
    match write_bytes(at, bytes) { .Ok(_) -> true, .Err(_) -> false }
}

/// The body's bytes: header · names · sets · content · per-family meta.
fn body_payload(pack: Pack, keys: List<string>, rev: int, placed: List<Placed>) -> Bytes {
    let n = names()
    let s = sets()
    for k in keys {
        let h? = record_of(pack, k) else { continue }
        for r in h.read { let _ = n.intern(r) }
    }
    for k in keys {
        let h? = record_of(pack, k) else { continue }
        let _ = s.intern(named_ids(n, h.read))
    }
    let w = writer()
    w.text(BODY_MAGIC)
    w.int(BODY_VERSION)
    w.int(rev)
    w.text(pack.print)
    w.octets(n.encode())
    w.octets(s.encode())
    w.count(placed.length)
    for p in placed {
        w.text(p.digest)
        w.int(p.at)
        w.int(p.len)
    }
    w.count(FAMILIES.length)
    for fam in FAMILIES {
        w.text(fam)
        let mine = [k for k in keys if record_of(pack, k)?.family == fam]
        w.count(mine.length)
        for k in mine {
            let h? = record_of(pack, k) else { continue }
            w.text(h.key)
            w.text(h.digest)
            w.int(s.intern(named_ids(n, h.read)))
            w.int(rev)
            w.int(rev)
        }
    }
    w.bytes()
}

fn record_of(pack: Pack, at: string) -> Held? { pack.records.get().get(at) }

fn named_ids(n: Names, read: List<string>) -> List<int> {
    [n.id_of(r) ?? 0 for r in read]
}

/// The index: a 256 fan-out (cumulative), the action keys sorted, one offset
/// each.
fn idx_payload(keys: List<string>, rev: int) -> Bytes {
    let counts: Cell<List<int>> = list_cell()
    for _k in 0..256 { counts.push(0) }
    for k in keys {
        let b = first_byte(k)
        counts.set_at(b, counts.get()[b] + 1)
    }
    let w = writer()
    w.text(IDX_MAGIC)
    w.int(BODY_VERSION)
    w.int(rev)
    w.int(keys.length)
    mut acc = 0
    for b in 0..256 {
        acc = acc + counts.get()[b]
        w.int(acc)
    }
    for k in keys { w.text(k) }
    for i, k in keys.enumerate() { w.int(i) }
    w.bytes()
}

/// The byte an action key's first two hex characters spell.
fn first_byte(k: string) -> int {
    if k.length < 2 { return 0 }
    hex_val(k.substring(0, 1)) * 16 + hex_val(k.substring(1, 2))
}

fn hex_val(c: string) -> int { "0123456789abcdef".index_of(c) }

// ── Reading ──

/// Read the newest whole body into the pack — before the segments, so a later
/// segment wins. A torn or foreign body is skipped, and says so once.
export fn body_scan(pack: Pack) {
    for at in bodies_newest_first(pack.dir) {
        // LICENSED input.store_io: the store's own body, read to merge it
        let raw = match read_bytes(at) { .Ok(b) -> b, .Err(_) -> "".bytes() }
        let r = reader(raw)
        let payload = read_frame(r)
        if payload == null {
            torn_at(pack, 0)
            continue
        }
        if body_read(pack, payload!) { return }
    }
}

fn body_read(pack: Pack, payload: Bytes) -> bool {
    let r = reader(payload)
    let magic? = ok(r.text()) else { return false }
    if magic != BODY_MAGIC { return false }
    let version? = ok(r.int()) else { return false }
    if version != BODY_VERSION { return false }
    let rev? = ok(r.int()) else { return false }
    let print? = ok(r.text()) else { return false }
    if print != pack.print {
        pack.foreign.set(true)
        if traced() { qtrace("Q\tstore\tforeign\n") }
        return false
    }
    let names_bytes? = ok(r.octets()) else { return false }
    let n? = names_from(names_bytes) else { return false }
    let sets_bytes? = ok(r.octets()) else { return false }
    let s? = sets_from(sets_bytes) else { return false }
    let slots? = ok(r.count()) else { return false }
    for _s in 0..slots {
        let digest? = ok(r.text()) else { return false }
        let at? = ok(r.int()) else { return false }
        let len? = ok(r.int()) else { return false }
        pack.slots.put(digest, ValueSlot { at: at, len: len })
    }
    let families? = ok(r.count()) else { return false }
    for _f in 0..families {
        let fam? = ok(r.text()) else { return false }
        let count? = ok(r.count()) else { return false }
        for _m in 0..count {
            let key? = ok(r.text()) else { return false }
            let digest? = ok(r.text()) else { return false }
            let sid? = ok(r.int()) else { return false }
            let _changed? = ok(r.int()) else { return false }
            let _verified? = ok(r.int()) else { return false }
            held(pack, fam, key, digest, [n.text_of(id) for id in s.members(sid)])
        }
    }
    if !r.done() { return false }
    pack.rev.set(rev)
    true
}
