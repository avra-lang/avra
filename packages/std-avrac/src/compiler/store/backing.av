//! The cache's storage seam. A cache is a family→key→bytes map with a
//! commit protocol; WHERE those bytes live is this: disk is the build's
//! tier, memory is the tier every other command gets for free.
//!
//! An implementation is a VALUE — the trait is the verb set, a struct is
//! the state — so one cache can hold either a `DiskBacking` or a
//! `MemBacking` behind the same verbs.
//!
//! THE COMMIT IS PART OF THE CONTRACT: a row is present only when its
//! edges are, so a write that never finished reads as ABSENT rather than
//! as half a value.

/// The cache's verbs. A family folds into the key first, so two families
/// naming one part stay apart.
export trait Backing {
    fn name() -> string
    fn has(family: Stored, key: string) -> bool
    fn get(family: Stored, key: string) -> string?
    fn put(family: Stored, key: string, value: string, read: List<string>) -> bool
    fn place(family: Stored, key: string, to: string) -> bool
    fn sweep(family: Stored, live: List<string>) -> int
}

/// The disk tier: the content-addressed store the build already keeps.
export type DiskBacking = { store: Store }

export fn disk_backing(store: Store) -> DiskBacking { DiskBacking { store: store } }

impl Backing for DiskBacking {
    fn name() -> string { "disk" }
    fn has(f: Stored, k: string) -> bool { self.store.has(f, k) }
    fn get(f: Stored, k: string) -> string? { self.store.get(f, k) }
    fn put(f: Stored, k: string, value: string, read: List<string>) -> bool { self.store.keep(f, k, value, read) }
    fn place(f: Stored, k: string, to: string) -> bool { self.store.place(f, k, to) }
    fn sweep(f: Stored, live: List<string>) -> int { self.store.sweep(f, live) }
}

/// One in-memory row.
type MemRow = { family: Stored, key: string, value: string }

/// The memory tier — the non-build commands'. No files and no commit
/// window: a row is one list entry.
export type MemBacking = { rows: Cell<List<MemRow>> }

export fn mem_backing() -> MemBacking {
    let none: List<MemRow> = []
    MemBacking { rows: Cell.new(none) }
}

fn mem_row(rows: List<MemRow>, f: Stored, k: string) -> MemRow? {
    rows.find(it.family == f && it.key == k)
}

impl Backing for MemBacking {
    fn name() -> string { "mem" }
    fn has(f: Stored, k: string) -> bool { mem_row(self.rows.get(), f, k) != null }
    fn get(f: Stored, k: string) -> string? { mem_row(self.rows.get(), f, k)?.value }
    fn put(f: Stored, k: string, value: string, read: List<string>) -> bool {
        mut rows = [r for r in self.rows.get() if !(r.family == f && r.key == k)]
        rows.push(MemRow { family: f, key: k, value: value })
        self.rows.set(rows)
        true
    }
    fn place(f: Stored, k: string, to: string) -> bool { false }
    fn sweep(f: Stored, live: List<string>) -> int {
        let rows = self.rows.get()
        let kept = [r for r in rows if r.family != f || live.any(it == r.key)]
        let dropped = rows.length - kept.length
        self.rows.set(kept)
        dropped
    }
}