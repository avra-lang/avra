//! What `avra cache` renders — the pack made visible (P7: the cache
//! is never a black box). Pure reads over `Pack`. What a name MEANS —
//! its family, an edge's hash right now — is asked of a fn the caller
//! passes, so this stays below `compiler/witness.av`, which owns the
//! naming and already imports the pack
//! (docs/2026_09_26_COMPILER_DB_TOWNHALL.md, §7.2 N6).
use core.{distinct, flatten}

/// The four ways a recorded edge can answer once it is re-asked: the
/// hash found now is the one recorded, it moved (a recomputation is
/// owed), nothing can answer for the name (no live check re-derives it
/// and this pack stores no entry under it), or it re-enters a name
/// already on the path, which a sound dependency graph never does.
export enum Held { Matches, Stale, External, Cycle }

export type WitnessNode = {
    name: string,
    held: Held,
    recorded_hash: int,
    found_hash: int,
    children: List<WitnessNode>,
}

/// One recorded edge, re-asked. `current` answers a name's hash NOW by
/// re-deriving it (null when it cannot); failing that the pack's own
/// entry answers with what it stored, and its edges are asked the same
/// way — red-green, all the way down. `seen` is the path here, so a
/// cycle in what should be a DAG is named rather than looped.
export fn witnessed(
    pack: Pack,
    name: string,
    recorded_hash: int,
    seen: List<string>,
    current: fn(string) -> int?,
) -> WitnessNode {
    if seen.contains(name) { return witness_node(name, Held.Cycle, recorded_hash, 0, []) }
    let live? = current(name) else { return stored_witness(pack, name, recorded_hash, seen, current) }
    witness_node(name, judged(live, recorded_hash), recorded_hash, live, [])
}

fn stored_witness(
    pack: Pack,
    name: string,
    recorded_hash: int,
    seen: List<string>,
    current: fn(string) -> int?,
) -> WitnessNode {
    let entry? = pack.get(name) else { return witness_node(name, Held.External, recorded_hash, 0, []) }
    let deeper = seen.concat([name])
    witness_node(
        name,
        judged(entry.hash, recorded_hash),
        recorded_hash,
        entry.hash,
        [witnessed(pack, e.name, e.hash, deeper, current) for e in entry.edges],
    )
}

fn judged(found: int, recorded: int) -> Held { if found == recorded { Held.Matches } else { Held.Stale } }

fn witness_node(
    name: string,
    held: Held,
    recorded_hash: int,
    found_hash: int,
    children: List<WitnessNode>,
) -> WitnessNode {
    WitnessNode {
        name: name,
        held: held,
        recorded_hash: recorded_hash,
        found_hash: found_hash,
        children: children,
    }
}

/// WHAT MOVED UNDER AN ENTRY: one recorded edge whose hash is not what
/// it was, with what moved under it in turn. A change with nothing under
/// it is a LEAF — an input, or a row whose own edges all still match, so
/// the row itself is where the move happened.
export type Change = { name: string, recorded_hash: int, found_hash: int, under: List<Change> }

/// The edges of `name`'s stored entry whose hashes moved, each followed
/// down to the rows that moved themselves. `current` answers a name's
/// hash NOW when it can be re-derived; else the pack's stored entry
/// answers. A name met twice on one path is not followed again.
export fn changed(pack: Pack, name: string, seen: List<string>, current: fn(string) -> int?) -> List<
    Change,
> {
    let entry? = pack.get(name) else { return [] }
    [c for e in entry.edges for c in moved(pack, e, seen.concat([name]), current)]
}

/// One edge, when its hash moved.
fn moved(pack: Pack, e: Edge, seen: List<string>, current: fn(string) -> int?) -> List<Change> {
    if seen.contains(e.name) { return [] }
    let now = current(e.name) ?? pack.get(e.name)?.hash ?? 0
    if now == e.hash { return [] }
    [
        Change {
            name: e.name,
            recorded_hash: e.hash,
            found_hash: now,
            under: changed(pack, e.name, seen, current),
        },
    ]
}

/// The leaves under `cs`, in the order the walk meets them.
export fn moved_leaves(cs: List<Change>) -> List<Change> {
    flatten([if c.under.is_empty() { [c] } else { moved_leaves(c.under) } for c in cs])
}

/// Every name this pack ever interned that also has its own stored
/// entry — an edge-only name (referenced, never `put`) is excluded,
/// since it names a dependency this pack does not hold a row for.
export fn real_entries(pack: Pack) -> List<Entry> {
    let names = pack.names()
    [pack.get(n)! for n in names if pack.get(n) != null]
}

/// Every stored entry a change to `name` would send back to recompute:
/// those with an edge on it, and those with an edge on any of THOSE, until
/// no new entry appears — the reverse of `witnessed`. An entry is listed
/// once, so a cycle in what should be a DAG ends the walk rather than
/// looping it.
export fn dependents(pack: Pack, name: string) -> List<Entry> {
    spread(real_entries(pack), [name], [])
}

fn spread(entries: List<Entry>, frontier: List<string>, found: List<Entry>) -> List<Entry> {
    if frontier.is_empty() { return found }
    let known = [e.name for e in found]
    let next = [e for e in entries if !known.contains(e.name) && leans_on(e, frontier)]
    spread(entries, [e.name for e in next], found.concat(next))
}

fn leans_on(e: Entry, names: List<string>) -> bool { e.edges.any((d: Edge) -> names.contains(d.name)) }

export type FamilyCount = { family: string, entries: int, payload_bytes: int }

export type FamilyNames = { family: string, names: int }

export type PackSummary = {
    entries: int,
    referenced_only: int,
    payload_bytes: int,
    disk_bytes: int,
    live_bytes: int,
    families: List<FamilyCount>,
    referenced: List<FamilyNames>,
}

/// The pack's own shape: the rows it stores and the names it only ever
/// heard of as someone else's dependency, each grouped by the family
/// `family_of` answers (in the order the pack first met them), how many
/// payload bytes the rows hold, and how the file on disk compares to
/// what a fresh compaction would write.
export fn summarized(pack: Pack, family_of: fn(string) -> string?) -> PackSummary {
    let entries = real_entries(pack)
    let only = [n for n in pack.names() if pack.get(n) == null]
    PackSummary {
        entries: entries.length,
        referenced_only: only.length,
        payload_bytes: sum_of([e.payload.length for e in entries]),
        disk_bytes: pack.disk_bytes(),
        live_bytes: pack.live_bytes(),
        families: family_counts(entries, family_of),
        referenced: family_names(only, family_of),
    }
}

/// The family word for a name no family claims — a file's or a
/// module's own stable name, or one this compiler never minted.
fn unkeyed_family() -> string { "(other)" }

fn family_label(family_of: fn(string) -> string?, name: string) -> string {
    family_of(name) ?? unkeyed_family()
}

type Tagged = { family: string, payload_bytes: int }

fn family_counts(entries: List<Entry>, family_of: fn(string) -> string?) -> List<FamilyCount> {
    let tagged = [Tagged { family: family_label(family_of, e.name), payload_bytes: e.payload.length } for e in entries]
    [family_count(f, tagged) for f in distinct([t.family for t in tagged])]
}

fn family_count(family: string, tagged: List<Tagged>) -> FamilyCount {
    let mine = [t.payload_bytes for t in tagged if t.family == family]
    FamilyCount { family: family, entries: mine.length, payload_bytes: sum_of(mine) }
}

fn family_names(names: List<string>, family_of: fn(string) -> string?) -> List<FamilyNames> {
    [FamilyNames { family: g.family, names: g.names.length } for g in family_groups(names, family_of)]
}

export type FamilyGroup = { family: string, names: List<string> }

type Named = { family: string, name: string }

/// `names` filed under the family `family_of` answers for each, families
/// in the order their first name appears, names in the order given.
export fn family_groups(names: List<string>, family_of: fn(string) -> string?) -> List<FamilyGroup> {
    let tagged = [Named { family: family_label(family_of, n), name: n } for n in names]
    [FamilyGroup { family: f, names: [t.name for t in tagged if t.family == f] } for f in distinct([t.family for t in tagged])]
}

fn sum_of(ns: List<int>) -> int {
    mut total = 0
    for n in ns { total = total + n }
    total
}
