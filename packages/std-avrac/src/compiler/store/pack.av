//! THE PACK — the store's durable half, two tiers: an ACTION table (a
//! key to the digest of its value) and a CONTENT store (a value digest
//! to its bytes), REAPI-shaped. A key is content-only: no path, no
//! machine, no time, no store-local id.
//!
//! ONE WRITER, ONE SEGMENT. A process appends to `seg-<writer>.log`;
//! readers merge every segment at open, later bytes winning. Every frame
//! ends with its own COMMIT MARKER — the frame's octets then a truncated
//! BLAKE3 — so a crash between a frame and its marker leaves the frame
//! unread rather than half read, and a torn frame ends that segment's
//! read. Nothing past a torn frame is trusted.
//!
//! `body-<rev>.pack` is the SEALED half (`store/body.av`), folded
//! by compaction under the flock at open: the process that takes the lock
//! seals what it read into one body and retires the dead segments it
//! folded; a process that cannot take the lock says it skipped.
use @std.io.{
    read_bytes,
    make_dirs,
    list_dir,
    remove,
    exists,
    opened_for_append,
    truncate_to,
    env,
    open_beneath,
    Opened,
    AppendFile,
}
use @std.path.{joined_path, dir_of, file_name}
use @std.relation.stable.{writer, reader, Reader, Writer, CodecFault, written_list, read_list}
use @std.relation.engine.{map_cell, list_cell}
use @std.text.{parse_int}
use core.{digest_of_octets, distinct, sorted_by}
use core.debug.{qtrace, traced}
use @std.time.{now_ns, wall_secs}

extern fn avra_pid_alive(pid: int) -> int
extern fn avra_own_pid() -> int
extern fn avra_process_exit(code: int)
extern fn avra_spawn_status(prog: string, args: List<string>) -> int

const MAGIC: string = "AVRAPACK"
const FORMAT_VERSION: int = 4

const CONTENT_TAG: int = 1
const ACTION_TAG: int = 2

/// THE STORE'S LIMITS, in one place (§6.7/S8): the time-travel window — sealed
/// revisions kept beside the newest — a whole-store byte ceiling, and an age for
/// history. Zero on a limit means no limit. The automatic seal and `avra cache clean`
/// reclaim by the same rule, so a store is bounded however it is written.
const REVISIONS_KEPT: int = 10
const MAX_BYTES_KEPT: int = 2147483648

/// What the kept binaries (`bin/`) may hold: each is a whole program, one per program key, so a
/// session of edits would otherwise fill a disk. Oldest out first; the newest always stays.
const BIN_BYTES_KEPT: int = 1073741824

/// What the kept objects (`obj/`) may hold. An object is a cache entry like any row: one the
/// ceiling drops is a MISS, its file read again and its object rebuilt, never a build refusal.
const OBJ_BYTES_KEPT: int = 2147483648
const MAX_AGE_KEPT_NS: int = 0

/// A store's limits, as `avra cache clean` and the automatic seal read them.
export type StoreLimits = { revisions: int, max_bytes: int, max_age_ns: int }

fn env_int(name: string) -> int? {
    // LICENSED input.debug_flag: the store's own limits, never an input of what is built
    let raw? = env(name) else { return null }
    parse_int(raw)
}

/// The limits in force: the design's revision window by default, overridden by
/// `AVRA_STORE_REVISIONS`, `AVRA_STORE_MAX_MB` and `AVRA_STORE_MAX_AGE_S`.
export fn store_limits() -> StoreLimits {
    let mb = env_int("AVRA_STORE_MAX_MB") ?? MAX_BYTES_KEPT / 1048576
    let age = env_int("AVRA_STORE_MAX_AGE_S") ?? 0
    StoreLimits {
        revisions: env_int("AVRA_STORE_REVISIONS") ?? REVISIONS_KEPT,
        max_bytes: mb * 1048576,
        max_age_ns: age * 1000000000,
    }
}

/// What a reclaim did: whether it sealed and could take the lock, the revision
/// count before and after, the revisions it evicted, and the store's bytes.
export type CleanReport = {
    skipped: bool,
    sealed: bool,
    bodies_before: int,
    bodies_after: int,
    evicted: List<int>,
    bytes_before: int,
    bytes_after: int,
}

/// Frames in live segments before a writer seals them into a body.
const SEAL_FRAMES: int = 32
const SEAL_SPARE: int = 64

fn hooked_frames() -> int? {
    // LICENSED input.debug_flag: a test hook that sets the seal threshold, never an input of what is built
    let raw? = env("AVRA_STORE_SEAL_FRAMES") else { return null }
    parse_int(raw)
}

/// The frames a derivation's end lets stand unsealed: SEAL_FRAMES, or in a larger store a
/// sixty-fourth of its sealed records — a one-function edit appends a few dozen frames and
/// must not rewrite the whole body, while the next open reads at most this many.
fn seal_frames(pack: Pack) -> int {
    let spare = sealed_count(pack) / SEAL_SPARE
    hooked_frames() ?? if spare > SEAL_FRAMES { spare } else { SEAL_FRAMES }
}

/// ONE ROW: the family and key it answers, the digest of its value and the
/// keys it read — listed here, or, for a row a sealed body carries, the id of
/// its read set in that body's tables (`set` is -1 when `read` is the list).
/// `stamp` is when its writer appended it (0 for a sealed row): of two segment
/// frames for one key the later stands, whatever order the files merge in.
export type Held = {
    family: string,
    key: string,
    digest: string,
    read: List<string>,
    set: int,
    stamp: int,
}

/// A row whose read list is spelled out, as a segment frame or a write carries it.
fn listed_row(family: string, key: string, digest: string, read: List<string>, stamp: int) -> Held {
    Held { family: family, key: key, digest: digest, read: read, set: 0 - 1, stamp: stamp }
}

/// A sealed body's names and read sets, decoded the first time a read set is asked.
export type Tables = { names: Names, sets: Sets }

/// ONE ANSWER CLAIM for an action key: the value a writer named, and who.
/// A second claim from ANOTHER writer that names a different value is a
/// reproducibility defect — the shared store doubling as a detector of
/// nondeterminism — so it is reported, naming the key, both value digests
/// and both writers. The later claim still stands.
type Claim = { digest: string, writer: string }

/// THE PACK for one store directory. Its maps are CELLS, so every copy
/// of the value shares the one index an open built and a write extends.
export type Pack = {
    dir: string,
    print: string,
    records: Cell<Map<string, Held>>,
    withdrawn: Cell<Map<string, bool>>,
    /// Values this process holds in memory: its own writes and segments.
    content: Cell<Map<string, string>>,
    /// Values the newest sealed body holds, read from its `.val` on demand.
    slots: Cell<Map<string, ValueSlot>>,
    /// The newest sealed body, open and lazy (none or one), whose rows a lookup decodes on
    /// demand, and the tables decoded from its names and sets.
    sealed: Cell<List<Sealed>>,
    tables: Cell<List<Tables>>,
    /// Whether every sealed row has been lifted into `records`, as a seal needs.
    whole: Cell<bool>,
    opened: Cell<bool>,
    /// Whether a WRITER has taken the compaction lock and sealed. An
    /// inspection opens the index and never sets this, so the same pack can
    /// be read by an inspection and written by a check in one process.
    admitted: Cell<bool>,
    torn: Cell<bool>,
    foreign: Cell<bool>,
    skipped: Cell<bool>,
    headed: Cell<bool>,
    folded: Cell<List<string>>,
    /// Frames in segments since the last seal: those read at open and those
    /// this process appended.
    frames: Cell<int>,
    rev: Cell<int>,
    /// The revision of the value file the open body names: bodies share one.
    val_rev: Cell<int>,
    /// The newest body revision that stood when this pack opened: a seal over an
    /// older view would drop the rows of whoever sealed since.
    seen_rev: Cell<int>,
    lock_fd: Cell<int>,
    /// The value file, open once for the revision it was opened at (none or one handle).
    val_open: Cell<List<Opened>>,
    val_open_rev: Cell<int>,
    /// This writer's own segment, open once for the path it was opened at (none or one handle).
    seg_open: Cell<List<AppendFile>>,
    seg_path: Cell<string>,
    traffic: Cell<Traffic>,
}

/// What a process asked of a pack: lookups that found a row and that did not, values read out
/// of the sealed body, and the bytes those reads covered.
export type Traffic = { hits: int, misses: int, values: int, bytes: int, rows: int = 0, probes: int = 0 }

/// THE STORE DIRECTORY a cache root names — ONE projection, so the pack and
/// every tool that measures it (`avra cache log`) agree where it stands.
// LICENSED compiler.free_state_verb: a pure PROJECTION — a root in, its store directory out.
export fn store_dir_of(root: string) -> string { joined_path(root, "store") }

/// One store's pack, empty — nothing read from disk until the first ask.
export fn pack_at(root: string, print: string) -> Pack {
    Pack {
        dir: store_dir_of(root),
        print: print,
        records: map_cell(),
        withdrawn: map_cell(),
        content: map_cell(),
        slots: map_cell(),
        sealed: list_cell(),
        tables: list_cell(),
        whole: Cell.new(false),
        opened: Cell.new(false),
        admitted: Cell.new(false),
        torn: Cell.new(false),
        foreign: Cell.new(false),
        skipped: Cell.new(false),
        headed: Cell.new(false),
        folded: list_cell(),
        frames: Cell.new(0),
        rev: Cell.new(0),
        val_rev: Cell.new(0),
        seen_rev: Cell.new(0),
        lock_fd: Cell.new(0 - 1),
        val_open: list_cell(),
        val_open_rev: Cell.new(0 - 1),
        seg_open: list_cell(),
        seg_path: Cell.new(""),
        traffic: Cell.new(Traffic { hits: 0, misses: 0, values: 0, bytes: 0 }),
    }
}

/// A value's digest as it names content here — BLAKE3, the store's one
/// content hash.
export fn content_digest(value: string) -> string { digest_of_octets(value.bytes()) }

/// The commit marker: the frame's truncated BLAKE3, sixteen hex characters.
export fn check_of(body: Bytes) -> string { digest_of_octets(body).substring(0, 16) }

export fn ok<T>(r: Result<T, CodecFault>) -> T? { match r { .Ok(v) -> v, .Err(_) -> null } }

/// The input a read line names: the text after its digest. None for a line that is no pair.
export fn read_name(line: string) -> string? {
    let at = line.index_of(" ")
    if at <= 0 { return null }
    line.substring(at + 1, line.length)
}

/// THE SUSPECT SET: the record keys of the rows that read any input in `moved` — the sealed
/// body's rows through its reverse section, the live segment rows by their own read lists.
/// Ids only: no value is fetched and no row decoded.
export fn pack_suspects(pack: Pack, moved: List<string>) -> List<string> {
    opened_at(pack, true)
    mut wanted: Map<string, bool> = {}
    for m in moved { wanted.set(m, true) }
    mut out = sealed_readers(pack, wanted)
    for k, h in pack.records.get() {
        if h.set >= 0 || withdrawn(pack, k) { continue }
        if reads_of(pack, h).any((line) -> wanted.get(read_name(line) ?? "") != null) { out.push(k) }
    }
    distinct(out)
}

/// The format a pack and its bodies are written in: a stamp folds it, so rows of another
/// format are never addressed.
export fn pack_format() -> string { "${FORMAT_VERSION}.${BODY_VERSION}" }

/// THE ACTION KEY — BLAKE3 over the family's name, which carries its stamp, and the
/// key, so two families naming the same parts stay apart.
export fn action_key(family: string, key: string) -> string {
    digest_of_octets("${family}\n${key}".bytes())
}

/// A row's place in the open index: the family and key as they stand. The
/// index is never persisted, so its key needs no hash.
export fn record_key(family: string, key: string) -> string { "${family}\n${key}" }

/// A `List<string>` written through the stable codec.
fn wrote_text(w: Writer, s: string) { w.text(s) }

// ── Frames ──

fn head_bytes(print: string) -> Bytes {
    let w = writer()
    w.text(MAGIC)
    w.int(FORMAT_VERSION)
    w.text(print)
    w.bytes()
}

fn content_body(digest: string, value: string) -> Bytes {
    let w = writer()
    w.int(CONTENT_TAG)
    w.text(digest)
    w.text(value)
    w.bytes()
}

fn action_body(family: string, key: string, digest: string, read: List<string>, stamp: int) -> Bytes {
    let w = writer()
    w.int(ACTION_TAG)
    w.text(family)
    w.text(key)
    w.text(digest)
    w.int(stamp)
    written_list(w, read, wrote_text)
    w.bytes()
}

/// The body's octets as the writer lands them first: length-prefixed.
fn octets_only(body: Bytes) -> Bytes {
    let w = writer()
    w.octets(body)
    w.bytes()
}

/// The commit marker's octets alone.
fn marker_of(body: Bytes) -> Bytes {
    let w = writer()
    w.text(check_of(body))
    w.bytes()
}

/// One frame's body, or nothing when the bytes ahead are short or fail
/// their check — the caller stops there.
export fn read_frame(r: Reader) -> Bytes? {
    let body? = ok(r.octets()) else { return null }
    let check? = ok(r.text()) else { return null }
    if check != check_of(body) { return null }
    body
}

// ── Opening: the body first, then every segment ──

/// Whether the process that owns a segment still runs — a torn tail in a
/// LIVE writer's file is a frame still arriving, never a tail to trim.
fn writer_alive(name: string) -> bool {
    let rest = name.substring(4, name.length - 4)
    let dash = rest.index_of("-")
    let pid = parse_int(if dash < 0 { rest } else { rest.substring(0, dash) }) ?? 0
    // LICENSED input.live_process: a segment's writer is asked whether it still runs
    avra_pid_alive(pid) == 1
}

/// A dead writer's torn tail is trimmed to its last whole frame, so the
/// next open reports it once and no run reads past it.
fn trim(path: string, len: int) {
    if len >= 0 { let _ = truncate_to(path, len) }
}

/// Every record in one segment, after its PLAIN header, folded into the pack —
/// answers whether the segment is this compiler's, the only kind a seal may retire.
/// A torn frame ends this segment; a foreign header drops it whole. The
/// header is not framed: a store's own print must be readable, and forgeable,
/// before any frame is trusted.
fn scan_segment(
    pack: Pack,
    path: string,
    raw: Bytes,
    alive: bool,
    claims: Cell<Map<string, Claim>>,
    writer: string,
) -> bool {
    if raw.length == 0 { return false }
    let r = reader(raw)
    let magic? = ok(r.text()) else {
        torn_at(pack, 0)
        if !alive { trim(path, 0) }
        return false
    }
    let version? = ok(r.int()) else {
        torn_at(pack, 0)
        if !alive { trim(path, 0) }
        return false
    }
    let print? = ok(r.text()) else {
        torn_at(pack, 0)
        if !alive { trim(path, 0) }
        return false
    }
    if magic != MAGIC || version != FORMAT_VERSION {
        pack.foreign.set(true)
        if traced() { qtrace("Q\tstore\tforeign\n") }
        return false
    }
    while !r.done() {
        let before = r.at.get()
        let body? = read_frame(r) else {
            torn_at(pack, before)
            if !alive { trim(path, before) }
            return true
        }
        applied(pack, body, claims, writer)
        pack.frames.set(pack.frames.get() + 1)
    }
    true
}

export fn torn_at(pack: Pack, at: int) {
    if pack.torn.get() { return }
    pack.torn.set(true)
    if traced() { qtrace("Q\tstore\ttorn\t${at}\n") }
}

fn applied(pack: Pack, body: Bytes, claims: Cell<Map<string, Claim>>, writer: string) {
    let r = reader(body)
    let tag? = ok(r.int()) else { return }
    if tag == CONTENT_TAG {
        let digest? = ok(r.text()) else { return }
        let value? = ok(r.text()) else { return }
        pack.content.put(digest, value)
        return
    }
    if tag == ACTION_TAG {
        let family? = ok(r.text()) else { return }
        let key? = ok(r.text()) else { return }
        let digest? = ok(r.text()) else { return }
        let stamp? = ok(r.int()) else { return }
        let read? = ok(read_list(r, (q) -> q.text())) else { return }
        claimed(pack, claims, writer, family, key, digest, read, stamp)
    }
}

/// One answer CLAIM, filed and compared against the writer who named the
/// key before — a different writer with a different value is the finding.
fn claimed(
    pack: Pack,
    claims: Cell<Map<string, Claim>>,
    writer: string,
    family: string,
    key: string,
    digest: string,
    read: List<string>,
    stamp: int,
) {
    let at = record_key(family, key)
    let prior = claims.get().get(at)
    if prior != null {
        let was = prior!
        if was.digest != digest && was.writer != writer {
            if traced() {
                qtrace(
                    "Q\tstore\tclaim-conflict\t${family}\t${key}\t${was.digest}\t${digest}\t${was.writer}\t${writer}\n",
                )
            }
        }
    }
    claims.put(at, Claim { digest: digest, writer: writer })
    let standing = pack.records.get().get(at)
    if standing != null && standing!.stamp > stamp { return }
    pack.records.put(at, listed_row(family, key, digest, read, stamp))
}

/// A record folded in without a claim: this process's own writes are the only
/// claim on its own segment, so no cross-writer comparison applies.
export fn held(
    pack: Pack,
    family: string,
    key: string,
    digest: string,
    read: List<string>,
    stamp: int,
) {
    pack.records.put(record_key(family, key), listed_row(family, key, digest, read, stamp))
}

/// THE SEGMENTS OTHER WRITERS APPENDED since this pack opened — each worker's, once it
/// has ended — folded in, so a row they wrote reads as this process's own. Answers how many
/// segments joined. This writer's own segment and one already folded are never read twice.
export fn pack_merged(pack: Pack) -> int {
    opened_at(pack, false)
    let own = file_name(writer_segment(pack))
    let claims: Cell<Map<string, Claim>> = map_cell()
    let fresh = [n for n in segments(pack.dir) if n != own && !pack.folded.get().contains(n)]
    for name in fresh {
        let at = joined_path(pack.dir, name)
        // LICENSED input.store_io: a segment's own bytes, read to merge it
        let raw = match read_bytes(at) { .Ok(b) -> b, .Err(_) -> "".bytes() }
        if scan_segment(pack, at, raw, writer_alive(name), claims, name) {
            pack.folded.set(pack.folded.get().concat([name]))
        }
    }
    fresh.length
}

fn is_segment(name: string) -> bool {
    name.starts_with("seg-") && name.ends_with(".log")
}

fn segments(dir: string) -> List<string> {
    // LICENSED input.store_io: the store's own segments, listed to merge them
    let names = match list_dir(dir) { .Ok(ns) -> ns, .Err(_) -> [] }
    [n for n in names if is_segment(n)]
}

/// Seal under compaction's lock: taken if it is free and then held for the
/// process, so a writer that seals again does not wait on itself. A process
/// that cannot take the lock says it skipped and returns without sealing.
fn admit(pack: Pack) {
    if pack.lock_fd.get() < 0 && !locked(pack) { return }
    if seal(pack) {
        if traced() { qtrace("Q\tstore\tsealed\t${pack.rev.get()}\t${pack.records.get().length}\n") }
        retire(pack)
        enforce_limits(pack)
        emptied(pack)
        pack.frames.set(0)
    }
}

fn locked(pack: Pack) -> bool {
    let at = joined_path(pack.dir, "lock")
    let af? = match opened_for_append(at) { .Ok(f) -> f, .Err(_) -> null } else { return false }
    let won = match af.locked() { .Ok(b) -> b, .Err(_) -> false }
    if !won {
        pack.skipped.set(true)
        if traced() { qtrace("Q\tstore\tskipped\tlock held\n") }
        let _ = af.closed()
        return false
    }
    pack.lock_fd.set(af.fd)
    hold_ms()
    true
}

/// This writer's own segment once a body holds its frames: emptied, so a later
/// open does not read them twice.
fn emptied(pack: Pack) {
    let _ = truncate_to(writer_segment(pack), 0)
    pack.headed.set(false)
}

/// Seals only from a write, once the segments hold SEAL_FRAMES frames — or, in a
/// larger store, half its records, so a cold run's seals sum to a few times its
/// size. A process that appended nothing never reaches here, so it takes no lock
/// and writes no store file.
fn settled(pack: Pack) {
    let half = (pack.records.get().length + sealed_count(pack)) / 2
    let due = hooked_frames() ?? if half > SEAL_FRAMES { half } else { SEAL_FRAMES }
    if pack.frames.get() >= due { admit(pack) }
}

/// A derivation's end: what it left in the segments is folded into a body once it
/// is more than a floor's worth, so the next open reads an index and not a log.
export fn pack_settle(pack: Pack) {
    if pack.opened.get() && pack.frames.get() >= seal_frames(pack) { admit(pack) }
}

/// A test hook: hold the lock so a second process's admission fails.
fn hold_ms() {
    // LICENSED input.debug_flag: a test hook that holds the store lock, never an input of what is built
    let raw? = env("AVRA_STORE_HOLD_MS") else { return }
    let ms = parse_int(raw) ?? 0
    if ms < 1 { return }
    // LICENSED input.debug_flag: a test hook that holds the compaction lock
    let _ = avra_spawn_status("sleep", ["${ms / 1000}.${ms % 1000}"])
}

/// Read the newest body's index and the live segments once; emit the one open
/// line a warm command's trace counts. An open never reads a value: `get`
/// reads one slot at a time. Compaction is a writer's act, so `read_only`
/// never takes the lock or seals.
fn opened_at(pack: Pack, read_only: bool) {
    if !pack.opened.get() {
        pack.opened.set(true)
        if traced() { qtrace("Q\tstore\topen\t${pack.dir}\n") }
        body_scan(pack)
        pack.seen_rev.set(newest_rev(pack.dir))
        let claims: Cell<Map<string, Claim>> = map_cell()
        for name in segments(pack.dir) {
            let at = joined_path(pack.dir, name)
            // LICENSED input.store_io: a segment's own bytes, read to merge it
            let raw = match read_bytes(at) { .Ok(b) -> b, .Err(_) -> "".bytes() }
            if scan_segment(pack, at, raw, writer_alive(name), claims, name) {
                pack.folded.set(pack.folded.get().concat([name]))
            }
        }
    }
    if !read_only && !pack.admitted.get() {
        pack.admitted.set(true)
        let _ = make_dirs(pack.dir)
        let root = dir_of(pack.dir)
        let _ = make_dirs(joined_path(root, "obj"))
        let _ = make_dirs(joined_path(root, "bin"))
    }
}

/// Every segment whose writer is DEAD folded into the new body, so it can
/// go; a LIVE writer's segment stays — it appends without the lock, and
/// unlinking it would silently drop the frames still arriving.
fn retire(pack: Pack) {
    for name in pack.folded.get() {
        if !writer_alive(name) { let _ = remove(joined_path(pack.dir, name)) }
    }
}

/// RECLAIM BY §6.7'S RULE. Compaction IS clean: the reachable rows (the merged
/// index — the latest command's answers, §6.7's roots until DB 08) fold into a
/// fresh sealed body when the segments hold frames, then the limits evict the
/// oldest history. A process that cannot take the compaction lock says it
/// skipped. Answers what it reclaimed.
export fn pack_clean(pack: Pack, limits: StoreLimits) -> CleanReport {
    // LICENSED input.store_io: the store's own directory, asked whether it stands
    if !exists(pack.dir) { return empty_clean() }
    let bytes_before = store_bytes(pack.dir)
    let bodies_before = all_body_names(pack.dir).length
    opened_at(pack, false)
    if !locked(pack) {
        return CleanReport {
            skipped: true,
            sealed: false,
            bodies_before: bodies_before,
            bodies_after: bodies_before,
            evicted: [],
            bytes_before: bytes_before,
            bytes_after: bytes_before,
        }
    }
    mut sealed = false
    if pack.frames.get() > 0 || pack.torn.get() {
        if seal(pack) {
            if traced() { qtrace("Q\tstore\tclean-sealed\t${pack.rev.get()}\n") }
            retire(pack)
            emptied(pack)
            pack.frames.set(0)
            sealed = true
        }
    }
    let evicted = prune_bodies(pack.dir, limits)
    let _ = trim_kept_binaries(dir_of(pack.dir), bin_limit())
    let _ = trim_kept_files(dir_of(pack.dir), "obj", obj_limit())
    CleanReport {
        skipped: false,
        sealed: sealed,
        bodies_before: bodies_before,
        bodies_after: all_body_names(pack.dir).length,
        evicted: evicted,
        bytes_before: bytes_before,
        bytes_after: store_bytes(pack.dir),
    }
}

fn empty_clean() -> CleanReport {
    CleanReport {
        skipped: false,
        sealed: false,
        bodies_before: 0,
        bodies_after: 0,
        evicted: [],
        bytes_before: 0,
        bytes_after: 0,
    }
}

/// The limit rule the automatic seal and `pack_clean` share: evict history the
/// window, the age or the byte ceiling no longer reaches, then values no body names.
fn enforce_limits(pack: Pack) {
    let _ = prune_bodies(pack.dir, store_limits())
    drop_unreferenced_values(pack.dir)
    let _ = trim_kept_binaries(dir_of(pack.dir), bin_limit())
    let _ = trim_kept_files(dir_of(pack.dir), "obj", obj_limit())
}

/// The kept objects' ceiling in bytes: `AVRA_OBJ_MAX_BYTES`, else two gigabytes.
fn obj_limit() -> int { env_int("AVRA_OBJ_MAX_BYTES") ?? OBJ_BYTES_KEPT }

/// The kept binaries' ceiling in bytes: `AVRA_BIN_MAX_BYTES`, else a gigabyte.
fn bin_limit() -> int { env_int("AVRA_BIN_MAX_BYTES") ?? BIN_BYTES_KEPT }

/// One kept binary: where it stands, its edge beside it, its size and its time.
type KeptFile = { path: string, bytes: int, at: int }

/// The binaries under `<root>/bin`, oldest first, past what `limit` allows: each is removed
/// with its edge, so a later ask finds a miss and links again. The newest is never removed.
export fn trim_kept_binaries(root: string, limit: int) -> int { trim_kept_files(root, "bin", limit) }

/// The files of one file family (`bin`, `obj`) under `<root>/<family>`, oldest first, past `limit`.
export fn trim_kept_files(root: string, family: string, limit: int) -> int {
    if limit <= 0 { return 0 }
    let bin = joined_path(root, family)
    let kept = sorted_by(kept_binaries(bin), (a: KeptFile, b: KeptFile) -> a.at < b.at)
    mut held = kept.fold(0, (sum, f) -> sum + f.bytes)
    mut gone = 0
    for f in kept.slice(0, if kept.is_empty() { 0 } else { kept.length - 1 }) {
        if held <= limit { break }
        let _ = remove("${f.path}.deps")
        let _ = remove(f.path)
        held = held - f.bytes
        gone = gone + 1
    }
    if traced() && gone > 0 { qtrace("Q\tstore\t${family}-trimmed\t${gone}\t${held}\n") }
    gone
}

fn kept_binaries(bin: string) -> List<KeptFile> {
    // LICENSED input.store_io: the store's own kept binaries, listed and measured to bound them
    let shards = match list_dir(bin) { .Ok(ns) -> ns, .Err(_) -> [] }
    [f! for shard in shards for name in kept_names(joined_path(bin, shard)) for f in [kept_file(joined_path(joined_path(bin, shard), name))] if f != null]
}

fn kept_names(shard: string) -> List<string> {
    // LICENSED input.store_io: the store's own kept binaries, listed per shard to bound them
    let names = match list_dir(shard) { .Ok(ns) -> ns, .Err(_) -> [] }
    [n for n in names if !n.ends_with(".deps")]
}

fn kept_file(path: string) -> KeptFile? {
    // LICENSED input.store_io: a kept binary, measured and dated for the ceiling
    let o? = match open_beneath(dir_of(path), file_part(path)) { .Ok(o) -> o, .Err(_) -> null } else { return null }
    let f = KeptFile { path: path, bytes: o.size, at: o.mtime }
    o.close()
    f
}

fn file_part(path: string) -> string { path.substring(dir_of(path).length + 1, path.length) }

/// Evict sealed revisions past the time window, past the age, or to fit the byte
/// ceiling — oldest first, and NEVER the newest, so a store always answers. A
/// value file is shared by the bodies that appended to it and goes only when the
/// last of them is evicted. Answers the revisions evicted.
fn prune_bodies(dir: string, limits: StoreLimits) -> List<int> {
    let names = sorted_by(all_body_names(dir), rev_before)
    // THE NEWEST REVISION IS THE ROOTS: it is never doomed, whatever the limit,
    // so a store always answers. Evict the history around it.
    let newest? = names.last() else { return [] }
    let over = if limits.revisions > 0 && names.length > limits.revisions { names.length - limits.revisions } else { 0 }
    let doomed = names
        .slice(0, over)
        .concat(aged_out(dir, names.slice(over, names.length), newest, limits))
    for n in doomed { drop_body(dir, n) }
    drop_unreferenced_values(dir)
    [body_rev_of(n) for n in doomed.concat(trimmed_to_fit(dir, limits))]
}

/// The bodies past the age limit, oldest first, never the newest.
fn aged_out(dir: string, names: List<string>, newest: string, limits: StoreLimits) -> List<string> {
    if limits.max_age_ns <= 0 { return [] }
    // The file's time is WALL seconds, so the clock is read the same way —
    // `now_ns` is monotonic and would never compare to it.
    // LICENSED input.store_clock: the age limit reads the wall clock, never an input of what is built
    let now_s = wall_secs()
    let age_s = limits.max_age_ns / 1000000000
    [n for n in names if n != newest && now_s - (body_mtime_s(dir, n) ?? now_s) > age_s]
}

/// The oldest bodies dropped until the store fits its byte ceiling; the newest stays.
fn trimmed_to_fit(dir: string, limits: StoreLimits) -> List<string> {
    if limits.max_bytes <= 0 { return [] }
    mut gone: List<string> = []
    while store_bytes(dir) > limits.max_bytes {
        let keep = sorted_by(all_body_names(dir), rev_before)
        if keep.length <= 1 { break }
        drop_body(dir, keep.first()!)
        drop_unreferenced_values(dir)
        gone.push(keep.first()!)
    }
    gone
}

fn drop_body(dir: string, name: string) {
    let _ = remove(joined_path(dir, name))
    let _ = remove(joined_path(dir, "${name.substring(0, name.length - 5)}.idx"))
}

fn rev_before(a: string, b: string) -> bool { body_rev_of(a) < body_rev_of(b) }

/// The store directory's own bytes, every body, index, value file and segment.
fn store_bytes(dir: string) -> int {
    // LICENSED input.store_io: the store's own files, listed to measure it
    let names = match list_dir(dir) { .Ok(ns) -> ns, .Err(_) -> [] }
    names.fold(0, (sum, n) -> sum + (store_file_bytes(dir, n) ?? 0))
}

/// ONE STORE FILE'S OWN BYTES — what the byte ceiling and `cache log` both read.
export fn store_file_bytes(dir: string, name: string) -> int? {
    // LICENSED input.store_io: the store's own file, measured for the byte ceiling
    match open_beneath(dir, name) {
        .Ok(o) -> {
            let n = o.size
            let _ = o.close()
            n
        },
        .Err(_) -> null,
    }
}

/// A file's modification time in WHOLE SECONDS, as the age limit reads it.
fn body_mtime_s(dir: string, name: string) -> int? {
    // LICENSED input.store_io: the store's own file, its time read for the age limit
    match open_beneath(dir, name) {
        .Ok(o) -> {
            let m = o.mtime
            let _ = o.close()
            m
        },
        .Err(_) -> null,
    }
}

// ── Reading and writing ──

/// A row is present only when its value can be read back: a record whose value is
/// missing or damaged is absent, so `has` and `get` never disagree.
export fn pack_has(pack: Pack, family: string, key: string, read_only: bool = false) -> bool {
    pack_get(pack, family, key, read_only) != null
}

export fn pack_get(pack: Pack, family: string, key: string, read_only: bool = false) -> string? {
    let found = pack_found(pack, family, key, read_only)
    let t = pack.traffic.get()
    pack
        .traffic
        .set(if found == null { t with { misses: t.misses + 1 } } else { t with { hits: t.hits + 1 } })
    if traced() { qtrace(lookup_line(found != null, family)) }
    found
}

/// One lookup's trace line: whether it hit, and the family it asked, stamp left off.
fn lookup_line(hit: bool, family: string) -> string {
    "Q\tstore\t${if hit { "hit" } else { "miss" }}\t${family.split("@").first() ?? family}\n"
}

fn pack_found(pack: Pack, family: string, key: string, read_only: bool) -> string? {
    opened_at(pack, read_only)
    let at = record_key(family, key)
    if withdrawn(pack, at) { return null }
    let held? = record_of(pack, at) else { return null }
    let stored? = content_of(pack, held.digest) else { return null }
    if cas_is_ref(stored) { cas_value(stored) } else { stored }
}

/// The reads a row was kept with, absent for a row not present or whose
/// read set cannot be named.
export fn pack_reads(pack: Pack, family: string, key: string, inspect: bool) -> List<string>? {
    opened_at(pack, inspect)
    let at = record_key(family, key)
    if withdrawn(pack, at) { return null }
    let held? = record_of(pack, at) else { return null }
    reads_known(pack, held)
}

/// ANSWER ONE ROW FROM AN OLDER REVISION — §6.7's time-travel read (§6.2 step 6:
/// whatever a recomputation needs is loaded by name, on demand). The sealed body
/// is read on its own, so this pack's live open is untouched. Use a fresh pack.
export fn pack_get_rev(pack: Pack, rev: int, family: string, key: string) -> string? {
    if !body_scan_rev(pack, rev) { return null }
    pack.opened.set(true)
    pack_found(pack, family, key, true)
}

/// The rows a sealed revision holds, in body order — what `explain` reads to
/// say what changed between two revisions.
export fn pack_rows_rev(pack: Pack, rev: int) -> List<Held> {
    if !body_scan_rev(pack, rev) { return [] }
    pack.opened.set(true)
    sealed_rows(pack)
}

/// A value by its digest without keeping it: held in memory, else read from the
/// sealed body.
fn value_of(pack: Pack, digest: string) -> string? {
    let here? = pack.content.get().get(digest) else { return spilled(pack, digest) }
    here
}

/// A value by its digest: held in memory, else read from the sealed body and
/// kept in memory, so a value is read and checked once.
fn content_of(pack: Pack, digest: string) -> string? {
    let here? = pack.content.get().get(digest) else {
        let v? = spilled(pack, digest) else { return null }
        pack.content.put(digest, v)
        return v
    }
    here
}

/// A sealed value: `get` seeks its slot in the newest body's `.val` and checks
/// the bytes against the digest, so a missing or damaged value answers absent.
fn spilled(pack: Pack, digest: string) -> string? {
    let slot? = pack.slots.get().get(digest) ?? sealed_slot(pack, digest) else { return null }
    if traced() { qtrace("Q\tstore\tvalue\t${pack.rev.get()}\t${digest}\n") }
    let o? = value_file(pack) else { return null }
    let raw = match o.span(slot.at, slot.len) { .Ok(b) -> b, .Err(_) -> "".bytes() }
    let v? = raw.text() else { return null }
    if content_digest(v) != digest { return null }
    let t = pack.traffic.get()
    pack.traffic.set(t with { values: t.values + 1, bytes: t.bytes + slot.len })
    v
}

/// The value file for the open revision, opened once and kept: a value is a seek and a read,
/// never an open. A revision that moved closes the old handle first.
fn value_file(pack: Pack) -> Opened? {
    let rev = pack.val_rev.get()
    if pack.val_open_rev.get() == rev {
        let held = pack.val_open.get().first()
        if held != null { return held }
    }
    for old in pack.val_open.get() { old.close() }
    // LICENSED input.store_io: the store's own value file, opened once to seek for its values
    let o = match open_beneath(pack.dir, val_name(rev)) { .Ok(o) -> o, .Err(_) -> { return null } }
    pack.val_open.set([o])
    pack.val_open_rev.set(rev)
    o
}

export fn pack_traffic(pack: Pack) -> Traffic { pack.traffic.get() }

/// Whether the open has withdrawn this action key since the index was built.
fn withdrawn(pack: Pack, at: string) -> bool { pack.withdrawn.get().get(at) ?? false }

/// WITHDRAW a key from this open's index: the row reads ABSENT until a later
/// write names it again, so a replaced row's old value cannot answer.
export fn pack_forget(pack: Pack, family: string, key: string) {
    opened_at(pack, false)
    pack.withdrawn.put(record_key(family, key), true)
}

/// The segment this process owns for this compiler's print: one file a print, so a process
/// that holds two prints never writes one header into the middle of the other's frames.
fn writer_segment(pack: Pack) -> string {
    // LICENSED input.live_process: this writer's own pid names its segment
    let name = "seg-${avra_own_pid()}-${digest_of_octets(pack.print.bytes()).substring(0, 8)}.log"
    joined_path(pack.dir, name)
}

/// This writer's own segment, held open across frames so a frame is a write and never
/// an open. A path that moved closes the old handle first; the same path keeps the one.
fn segment_file(pack: Pack, path: string) -> AppendFile? {
    if pack.seg_path.get() == path {
        let held = pack.seg_open.get().first()
        if held != null { return held }
    }
    for old in pack.seg_open.get() { let _ = old.closed() }
    let o = match opened_for_append(path) { .Ok(f) -> f, .Err(_) -> { return null } }
    pack.seg_open.set([o])
    pack.seg_path.set(path)
    // a segment is headed once, and this one is new to the process
    pack.headed.set(false)
    o
}

/// The frames and kept files this process has written to a store. A COUNT, never bytes:
/// a stored row carries absolute paths and clock text, so its size moves with where the
/// tree stands and when it ran.
once fn written_tally() -> Cell<int> { Cell.new(0) }

/// The frames and files written to a store since the process began.
export fn store_rows_written() -> int { written_tally().get() }

/// One more frame or file written to a store.
export fn store_wrote() { written_tally().set(written_tally().get() + 1) }

fn append(pack: Pack, body: Bytes) {
    let _ = make_dirs(pack.dir)
    let af? = segment_file(pack, writer_segment(pack)) else { return }
    if !pack.headed.get() {
        let _ = af.write(head_bytes(pack.print))
        pack.headed.set(true)
    }
    let _ = af.write(octets_only(body))
    store_wrote()
    kill_at_commit()
    let _ = af.write(marker_of(body))
    pack.frames.set(pack.frames.get() + 1)
}

/// A test hook: a writer killed between a frame's octets and its marker.
fn kill_at_commit() {
    // LICENSED input.debug_flag: a test hook that kills a writer between a frame and its marker
    let raw? = env("AVRA_STORE_KILL") else { return }
    if raw == "commit" { avra_process_exit(137) }
}

export fn pack_put(pack: Pack, family: string, key: string, value: string, read: List<string>) {
    opened_at(pack, false)
    pack.withdrawn.put(record_key(family, key), false)
    // a value too big for the frames is stored as a reference to the shared blob
    let stored = cas_put(value, dir_of(pack.dir)) ?? value
    cas_register_if_named(stored, dir_of(pack.dir))
    let digest = content_digest(stored)
    if content_of(pack, digest) == null {
        append(pack, content_body(digest, stored))
        pack.content.put(digest, stored)
    }
    // LICENSED input.store_clock: orders two writers' frames for one key, never an input of what is built
    let stamp = now_ns()
    append(pack, action_body(family, key, digest, read, stamp))
    held(pack, family, key, digest, read, stamp)
    settled(pack)
}
