//! THE PACK — one durable file per package, holding every row `Db`
//! keeps for it.
//!
//! A NAME TABLE (every stable name interned once, densely, in the
//! order it first appears) sits ahead of an APPEND-ONLY log of
//! entries. A commit marker closes a batch; a reader trusts nothing
//! past the last one it can verify, so a crash mid-write leaves the
//! prior committed state exactly as it was — never a partial entry.
//! ATOMICITY, not per-commit DURABILITY: `commit` appends with no
//! `fsync` (this is a cache — a lost commit is only recomputed, never
//! a wrong answer), and `flushed` pays that cost once, for a whole
//! pass's worth of commits.
//!
//! THE FILE, in order:
//!   header: magic, format version, the producing compiler's id
//!   frames: NameDef | Entry | Commit, each tag + a checksummed,
//!           length-prefixed body
//!
//! A pack from another compiler, or another format version, is never
//! read — it answers as empty, and the next write starts a fresh log
//! over it. The whole file is read through `@std/io`'s `read_bytes`
//! (chunked straight into `Bytes` — `drained`'s own doc), never
//! word-at-a-time into a `List<int>`: that shape spends one 8-byte
//! `int` PER BYTE, an 8x-16x blowup measured turning a leaf-edit
//! recheck's pack read into 2.3 GB of the run's 2.9 GB peak
//! (avra-8sb5.57.55's OOM).
use core.{list_cell}
use @std.io.{read_bytes, write_bytes, truncate_to, AppendFile, opened_for_append}
use @std.relation.stable.{writer, reader, Reader, Writer, CodecFault, stable_hasher, written_list}

// ── The header ──

fn magic() -> string { "AVRAPACK" }

fn format_version() -> int { 1 }

fn header_bytes(compiler_id: string) -> Bytes {
    let w = writer()
    w.text(magic())
    w.int(format_version())
    w.text(compiler_id)
    w.bytes()
}

// ── Frames: a tag, a checksummed length-prefixed body ──

fn name_tag() -> int { 0 }

fn entry_tag() -> int { 1 }

fn commit_tag() -> int { 2 }

/// Every frame's checksum is seeded the same way, over its tag and its
/// body — never the raw varint/text codec's own faults, which answer
/// why a FIELD does not decode, not why a FRAME is untrustworthy.
fn frame_checksum(tag: int, body: Bytes) -> int {
    stable_hasher(5289665).int(tag).octets(body).finish()
}

fn write_frame(w: Writer, tag: int, body: Bytes) {
    w.byte(tag)
    w.octets(body)
    w.int(frame_checksum(tag, body))
}

/// The exact on-disk size of a frame carrying `body` — tag, length
/// prefix and checksum included, the same bytes `write_frame` emits.
fn framed_len(tag: int, body: Bytes) -> int {
    let w = writer()
    write_frame(w, tag, body)
    w.bytes().length
}

enum RawFrame { NameDef(string), Entry(Bytes), Commit }

fn ok<T>(r: Result<T, CodecFault>) -> T? {
    match r { .Ok(v) -> v, .Err(_) -> null }
}

/// One frame, or nothing when the bytes ahead cannot be trusted — a
/// short read, a bad checksum, or a tag from a later format. The
/// caller stops there; nothing after an untrustworthy frame is read.
fn read_frame(r: Reader) -> RawFrame? {
    let tag? = ok(r.byte()) else { return null }
    let body? = ok(r.octets()) else { return null }
    let sum? = ok(r.int()) else { return null }
    if sum != frame_checksum(tag, body) { return null }
    if tag == name_tag() {
        let name? = body.text() else { return null }
        return RawFrame.NameDef(name)
    }
    if tag == entry_tag() { return RawFrame.Entry(body) }
    if tag == commit_tag() { return RawFrame.Commit }
    null
}

// ── An entry's body: name id, fingerprint, value hash, edges, payload ──

type EdgeId = { name_id: int, hash: int }

type DecodedBody = { fingerprint: int, hash: int, edges: List<EdgeId>, payload: Bytes }

fn encoded_entry(name_id: int, fingerprint: int, hash: int, edges: List<EdgeId>, payload: Bytes) -> Bytes {
    let w = writer()
    w.int(name_id)
    w.int(fingerprint)
    w.int(hash)
    written_list(w, edges, written_edge)
    w.octets(payload)
    w.bytes()
}

fn written_edge(w: Writer, e: EdgeId) {
    w.int(e.name_id)
    w.int(e.hash)
}

/// Just the name id — the only field the initial scan needs, to file
/// the frame under its name. The rest decodes on `get`.
fn decoded_name_id(body: Bytes) -> int? {
    ok(reader(body).int())
}

fn read_edge(r: Reader) -> Result<EdgeId, CodecFault> {
    let name_id = r.int()?
    let hash = r.int()?
    EdgeId { name_id: name_id, hash: hash }
}

fn read_edges(r: Reader) -> Result<List<EdgeId>, CodecFault> {
    let n = r.count()?
    [read_edge(r)? for _k in 0..n]
}

/// The body past its name id — decoded lazily, once for the frame's
/// life, the first time a caller asks for this name.
fn decoded_rest(r: Reader) -> DecodedBody? {
    ok(decoded_rest_result(r))
}

fn decoded_rest_result(r: Reader) -> Result<DecodedBody, CodecFault> {
    let fingerprint = r.int()?
    let hash = r.int()?
    let edges = read_edges(r)?
    let payload = r.octets()?
    DecodedBody { fingerprint: fingerprint, hash: hash, edges: edges, payload: payload }
}

// ── What a caller reads and writes ──

export type Edge = { name: string, hash: int }

export type Entry = { name: string, fingerprint: int, hash: int, edges: List<Edge>, payload: Bytes }

/// The newest state for one name: already turned into an `Entry`
/// (freshly `put`, or read once already) WITH the on-disk length its
/// current form would free if it dies — carried so a later `put`'s
/// dead-byte accounting never has to re-encode names into ids just
/// to learn a length it already knew at materialization — or still
/// the frame's raw body, untouched since the scan that found it.
enum Slot { Loaded(Entry, int), OnDisk(Bytes) }

fn resolved(name: string, names_by_id: List<string>, d: DecodedBody) -> Entry {
    Entry {
        name: name,
        fingerprint: d.fingerprint,
        hash: d.hash,
        edges: [Edge { name: names_by_id[e.name_id], hash: e.hash } for e in d.edges],
        payload: d.payload,
    }
}

// ── Loading: mmap the file, walk its frames, keep only what committed ──

type StagedEntry = { name: string, body: Bytes }

/// The scan's running answer, folded one frame at a time. Frames since
/// the last `Commit` are staged, separately from what a reader may
/// already trust, so a transaction that never closes leaves no trace.
///
/// `stage_by_id`/`stage_entries` are CELLS, not plain lists: `applied`
/// runs once per NAME and per ROW frame — a pack can carry thousands
/// — and the caller's own `s` (`walked`'s loop) still stands for the
/// argument across the call (CLAUDE.md's borrowing law), so a plain
/// field read into a `mut` local and pushed is never uniquely held —
/// `push` clones the whole list first, same O(n²) a `concat([x])` fold
/// has, just under `avra_cell_unique` instead of `avra_array_concat`.
/// A Cell's identity survives being read: pushing through it mutates
/// the one shared buffer regardless of how many bindings hold `s`.
/// Measured: the dominant cost of a leaf-edit recheck (41% of wall
/// time, all retains under the clone) collapses to noise.
type ScanState = {
    by_id: List<string>,
    slots: Map<string, Slot>,
    stage_by_id: Cell<List<string>>,
    stage_entries: Cell<List<StagedEntry>>,
    committed_len: int,
    broken: bool,
}

fn empty_scan(committed_len: int) -> ScanState {
    let no_by_id: List<string> = []
    let no_slots: Map<string, Slot> = {}
    ScanState {
        by_id: no_by_id,
        slots: no_slots,
        stage_by_id: list_cell(),
        stage_entries: list_cell(),
        committed_len: committed_len,
        broken: false,
    }
}

/// The name a staged or already-committed id answers to — committed
/// ids first, then this transaction's own, in the order they arrived.
fn name_for(s: ScanState, id: int) -> string? {
    if id < s.by_id.length { return s.by_id[id] }
    let j = id - s.by_id.length
    let staged = s.stage_by_id.get()
    if j >= 0 && j < staged.length { return staged[j] }
    null
}

fn applied(s: ScanState, frame: RawFrame, pos_after: int) -> ScanState {
    match frame {
        .NameDef(name) -> {
            s.stage_by_id.push(name)
            s
        },
        .Entry(body) -> staged_entry(s, body),
        .Commit -> committed(s, pos_after),
    }
}

fn staged_entry(s: ScanState, body: Bytes) -> ScanState {
    let id? = decoded_name_id(body) else { return s with { broken: true } }
    let name? = name_for(s, id) else { return s with { broken: true } }
    s.stage_entries.push(StagedEntry { name: name, body: body })
    s
}

/// Once per COMMIT frame, far rarer than a name or a row: batching two
/// already-built lists with `concat` here is the right shape, and
/// fresh cells for the next transaction cost nothing a commit does
/// not already pay.
fn committed(s: ScanState, pos_after: int) -> ScanState {
    mut slots = s.slots
    for se in s.stage_entries.get() { slots.set(se.name, Slot.OnDisk(se.body)) }
    ScanState {
        by_id: s.by_id.concat(s.stage_by_id.get()),
        slots: slots,
        stage_by_id: list_cell(),
        stage_entries: list_cell(),
        committed_len: pos_after,
        broken: false,
    }
}

/// `raw` is the bytes THROUGH the last verified commit — what a
/// reader trusts and what this pack's frame count starts from.
/// `disk_len` is what the FILE actually measured on disk, which may
/// run past `raw` when an earlier writer crashed mid-append: that
/// gap is a torn tail, trimmed away (`readied`) before this process
/// appends past it.
type Loaded = { raw: Bytes, by_id: List<string>, slots: Map<string, Slot>, disk_len: int }

fn empty_loaded() -> Loaded {
    let no_bytes = "".bytes()
    let no_by_id: List<string> = []
    let no_slots: Map<string, Slot> = {}
    Loaded { raw: no_bytes, by_id: no_by_id, slots: no_slots, disk_len: 0 }
}

/// Every frame from `r`'s current position, folded into the state the
/// last valid `Commit` left behind. `raw` is trimmed to that same
/// point — a torn tail is bytes this pack no longer carries at all.
fn walked(r: Reader, raw: Bytes) -> Loaded {
    mut s = empty_scan(r.at.get())
    while !r.done() {
        let f? = read_frame(r) else { break }
        s = applied(s, f, r.at.get())
        if s.broken { break }
    }
    Loaded {
        raw: raw.slice(0, s.committed_len),
        by_id: s.by_id,
        slots: s.slots,
        disk_len: raw.length,
    }
}

fn scanned(compiler_id: string, raw: Bytes) -> Loaded {
    let r = reader(raw)
    let seen_magic? = ok(r.text()) else { return empty_loaded() }
    if seen_magic != magic() { return empty_loaded() }
    let version? = ok(r.int()) else { return empty_loaded() }
    if version != format_version() { return empty_loaded() }
    let id? = ok(r.text()) else { return empty_loaded() }
    if id != compiler_id { return empty_loaded() }
    walked(r, raw)
}

/// The file's whole content, or empty for one that cannot be read —
/// `scanned` reads an empty `Bytes` the same way it reads a missing
/// pack, at the magic-header check.
fn slurped(path: string) -> Bytes {
    match read_bytes(path) { .Ok(b) -> b, .Err(_) -> "".bytes() }
}

fn loaded(path: string, compiler_id: string) -> Loaded {
    scanned(compiler_id, slurped(path))
}

fn reverse_index(names_by_id: List<string>) -> Map<string, int> {
    mut out: Map<string, int> = {}
    for i, name in names_by_id.enumerate() { out.set(name, i) }
    out
}

// ── The pack itself ──

export type Pack = {
    path: string,
    compiler_id: string,
    disk_len: Cell<int>,
    observed_len: Cell<int>,
    ready: Cell<bool>,
    // `dead_bytes` starts at 0 for a pack loaded from a PRIOR process —
    // this session only counts weight ITS OWN overwrites age, so a pack
    // already half garbage from an earlier session waits for this one to
    // age its own share before compacting. A heuristic delay, not a
    // correctness gap: compaction is housekeeping, never owed to a reader.
    dead_bytes: Cell<int>,
    // Whether a commit marker already stands on disk — from a prior
    // process, or from an earlier `commit` this session. A commit
    // marker is superseded by the next one after it (only the LAST
    // matters once a newer exists), so `commit` ages the standing
    // marker into `dead_bytes` before adding its own.
    has_marker: Cell<bool>,
    // The open append descriptor, held across every `commit` this
    // session makes — opened once, lazily, by the first one; a
    // fresh open()/close() pair per commit was a real per-file
    // syscall cost the census cannot see (it counts refcounts and
    // allocations, not kernel calls), invisible in the operation
    // counts but not in the wall clock. `flushed` closes it.
    fd: Cell<AppendFile?>,
    names: Cell<Map<string, int>>,
    by_id: Cell<List<string>>,
    slots: Cell<Map<string, Slot>>,
    pending: Writer,
}

// LICENSED compiler.free_state_verb: a CONSTRUCTOR — the path and this
// compiler's id in, the pack out, exactly `store_at`'s shape. LOADS
// ONLY — a caller that never commits (`avra explain`'s read-only
// inspection, P7) leaves no mark on disk; `ensure_ready` does the
// one-time prep for APPENDING, lazily, at the first real commit.
export fn pack_at(path: string, compiler_id: string) -> Pack {
    let l = loaded(path, compiler_id)
    let no_fd: AppendFile? = null
    Pack {
        path: path,
        compiler_id: compiler_id,
        disk_len: Cell.new(l.raw.length),
        dead_bytes: Cell.new(0),
        has_marker: Cell.new(l.raw.length > header_bytes(compiler_id).length),
        observed_len: Cell.new(l.disk_len),
        ready: Cell.new(false),
        fd: Cell.new(no_fd),
        names: Cell.new(reverse_index(l.by_id)),
        by_id: Cell.new(l.by_id),
        slots: Cell.new(l.slots),
        pending: writer(),
    }
}

impl Pack {
    /// `name`'s dense id, if already assigned — its WHOLE body, so the
    /// map `self.names.get()` answers is never still held by the time
    /// `interned` may go on to write it: a read held across a write
    /// finds the Cell's box shared, and `avra_cell_unique` clones the
    /// whole map — with no index, so the next lookup rebuilds it —
    /// once per new name, which is quadratic in the pack's own names
    /// (measured: 724 files' worth of edges turned a ~46s check into
    /// minutes before this fn existed).
    fn name_id(name: string) -> int? { self.names.get().get(name) }

    /// The next id `by_id` would mint — its own read, ended before
    /// `interned`'s write, the same reason `name_id` is its own fn.
    fn next_id() -> int { self.by_id.get().length }

    /// `name`'s dense id — already assigned, or minted here and staged
    /// as a `NameDef` frame this pack has not yet committed.
    fn interned(name: string) -> int {
        let known? = self.name_id(name) else {
            let id = self.next_id()
            self.by_id.push(name)
            self.names.put(name, id)
            write_frame(self.pending, name_tag(), name.bytes())
            return id
        }
        known
    }

    /// Stage an entry: visible to `get` at once, durable once `commit`
    /// answers `true`.
    fn put(entry: Entry) {
        let old = self.slot_at(entry.name)
        let name_id = self.interned(entry.name)
        let edges = [EdgeId { name_id: self.interned(e.name), hash: e.hash } for e in entry.edges]
        let body = encoded_entry(name_id, entry.fingerprint, entry.hash, edges, entry.payload)
        write_frame(self.pending, entry_tag(), body)
        self.slots.put(entry.name, Slot.Loaded(entry, framed_len(entry_tag(), body)))
        // An OVERWRITE ages the OLD frame into dead weight — its own
        // ON-DISK size (tag, checksum and all, matching what `disk_len`
        // counts), never the new one's, so a shrinking entry (a long
        // payload replaced by a short one) is not read as light. One
        // entry's worth of work, so `garbage_heavy` still answers in
        // O(1) without re-walking the whole pack.
        if old != null {
            self.dead_bytes.set(self.dead_bytes.get() + dead_frame_len(old!))
        }
    }

    /// `name`'s slot, if any — its own fn for the same reason
    /// `name_id` is: `.OnDisk`'s branch below may go on to WRITE
    /// `self.slots` (`materialized`), and a read held across that
    /// write clones the whole map the same way `interned`'s did.
    fn slot_at(name: string) -> Slot? { self.slots.get().get(name) }

    /// The newest entry for `name` — this session's own `put`, or the
    /// pack's own committed state, decoded once and kept.
    fn get(name: string) -> Entry? {
        let slot? = self.slot_at(name) else { return null }
        match slot { .Loaded(e, _) -> e, .OnDisk(body) -> self.materialized(name, body) }
    }

    fn materialized(name: string, body: Bytes) -> Entry? {
        let r = reader(body)
        let _ = r.int()
        let rest? = decoded_rest(r) else { return null }
        let entry = resolved(name, self.by_id.get(), rest)
        self.slots.put(name, Slot.Loaded(entry, framed_len(entry_tag(), body)))
        entry
    }

    /// Every name this pack has ever interned, in the order it first
    /// appeared — an EDGE-only name (referenced by another entry, never
    /// `put` itself) has no `Entry` of its own, so `get` on one answers
    /// null; that is how a caller tells an external dependency apart
    /// from one this pack stores (`avra cache`, P7).
    fn names() -> List<string> { self.by_id.get() }

    /// The bytes this pack occupies on disk right now.
    fn disk_bytes() -> int { self.disk_len.get() }

    /// What this pack would occupy freshly compacted — every live
    /// name's newest entry, nothing else. The gap to `disk_bytes` is
    /// garbage a compaction would reclaim.
    fn live_bytes() -> int { self.fresh_bytes().length }

    /// Everything staged since the last commit, APPENDED after the
    /// file's current end — never a read of what is already there,
    /// so this is O(the batch), not O(the whole pack). `ensure_ready`
    /// pays the one-time prep this needs first. Compacts past it — a
    /// real rewrite-and-rename — only when about half the pack is
    /// dead weight; that check is cheap (two lengths), so it runs
    /// every commit even though compaction itself does not.
    fn commit() -> bool {
        let batch = self.pending.bytes()
        if batch.length == 0 { return true }
        if !self.ensure_ready() { return false }
        // The marker already on disk (a prior process's, or an earlier
        // commit this session's) is superseded the moment this one
        // lands — only the newest matters once it exists, so it ages
        // into dead weight here, before this commit's own marker joins it.
        if self.has_marker.get() { self.dead_bytes.set(self.dead_bytes.get() + commit_frame().length) }
        self.has_marker.set(true)
        let framed = batch.concat(commit_frame())
        if !self.appended(framed) { return false }
        self.pending.out.set([])
        if self.garbage_heavy() { return self.compact() }
        true
    }

    /// Every commit so far made DURABLE — one `fsync`, paid once for
    /// however many `commit` calls came before it. THE PACK IS A
    /// CACHE: what correctness needs is that a reader never sees a
    /// half-written entry as valid, which the commit marker and the
    /// torn-tail trim already guarantee with no `fsync` at all — losing
    /// the last few commits to a crash before this runs just means
    /// recomputing them next time, not a wrong answer. Call once at
    /// the end of a pass, or whenever this `Pack` is done being
    /// written to.
    fn flushed() -> bool {
        let f? = self.fd.get() else { return true }
        let ok = match f.synced() { .Ok(_) -> true, .Err(_) -> false }
        let _ = f.closed()
        self.fd.set(null)
        ok
    }

    /// The file left ready to APPEND to, paid once per `Pack` (never
    /// at `pack_at` — a caller that only ever reads leaves no mark on
    /// disk): a fresh header when nothing usable was on disk (absent,
    /// another compiler's, or a format this one does not read —
    /// `disk_len` is 0 in every such case, per `scanned`), or the
    /// existing file trimmed back to its last verified commit when a
    /// crash left a torn tail past it (`observed_len` — the length
    /// actually seen at load — running ahead of `disk_len`, the
    /// trusted committed length). Otherwise the file already ends
    /// exactly where this pack believes, and nothing more is owed.
    fn ensure_ready() -> bool {
        if self.ready.get() { return true }
        self.ready.set(true)
        if self.disk_len.get() == 0 {
            let header = header_bytes(self.compiler_id)
            return match write_bytes(self.path, header) {
                .Ok(_) -> {
                    self.disk_len.set(header.length)
                    true
                },
                .Err(_) -> false,
            }
        }
        if self.observed_len.get() > self.disk_len.get() {
            return match truncate_to(self.path, self.disk_len.get()) {
                .Ok(_) -> true,
                .Err(_) -> false,
            }
        }
        true
    }

    fn appended(bytes: Bytes) -> bool {
        let f? = self.opened_append() else { return false }
        match f.write(bytes) {
            .Ok(_) -> {
                self.disk_len.set(self.disk_len.get() + bytes.length)
                true
            },
            .Err(_) -> false,
        }
    }

    /// The open append descriptor, opened once and held for every
    /// later `appended` call this session — a fresh open()/close()
    /// pair per commit was a real per-file syscall cost.
    fn opened_append() -> AppendFile? {
        let cached? = self.fd.get() else { return self.reopened() }
        cached
    }

    fn reopened() -> AppendFile? {
        match opened_for_append(self.path) {
            .Ok(f) -> {
                self.fd.set(f)
                f
            },
            .Err(_) -> null,
        }
    }

    fn written(bytes: Bytes) -> bool {
        // A held append FD (`self.fd`) now points at the OLD inode —
        // `write_bytes`'s temp+rename replaces the DIRECTORY ENTRY at
        // `self.path`, not the file a held descriptor still has open,
        // so a write through it after this would land in an orphaned
        // inode nothing reads. Close it; the next `appended` reopens
        // against the file this call just put there.
        self.closed_fd()
        match write_bytes(self.path, bytes) {
            .Ok(_) -> {
                self.disk_len.set(bytes.length)
                self.dead_bytes.set(0)
                true
            },
            .Err(_) -> false,
        }
    }

    fn closed_fd() {
        let f? = self.fd.get() else { return }
        let _ = f.closed()
        self.fd.set(null)
    }

    /// O(1) — `dead_bytes` is aged incrementally by `put`, never
    /// answered by rebuilding `fresh_bytes` to compare two lengths:
    /// that rebuild is exactly what made a per-file `commit` quadratic
    /// before `commit` itself appended instead of rewriting, and a
    /// cheap `append` gains nothing if the heaviness CHECK still walks
    /// the whole pack on every call.
    fn garbage_heavy() -> bool { self.dead_bytes.get() * 2 > self.disk_len.get() }

    /// Rewritten as just the live names and their newest entries, then
    /// renamed over the old file — a whole-file replace, unlike
    /// `commit`'s append; this is what makes it worth gating on
    /// `garbage_heavy` rather than running it every time.
    fn compact() -> bool { self.written(self.fresh_bytes()) }

    fn fresh_bytes() -> Bytes {
        let w = writer()
        let header = header_bytes(self.compiler_id)
        for i in 0..header.length { w.byte(header.at(i)) }
        for name in self.by_id.get() { write_frame(w, name_tag(), name.bytes()) }
        let live = [name for name in self.by_id.get() if self.slots.get().get(name) != null]
        for name in live {
            write_frame(w, entry_tag(), self.entry_body(name, self.slots.get().get(name)!))
        }
        write_frame(w, commit_tag(), "".bytes())
        w.bytes()
    }

    /// The on-disk shape for `name`'s current slot — the same bytes
    /// verbatim for one never re-read, freshly encoded for one this
    /// session decoded or wrote.
    fn entry_body(name: string, slot: Slot) -> Bytes {
        match slot {
            .OnDisk(body) -> body,
            .Loaded(entry, _) -> encoded_entry(
                self.names.get().get(name)!,
                entry.fingerprint,
                entry.hash,
                [EdgeId { name_id: self.names.get().get(e.name)!, hash: e.hash } for e in entry.edges],
                entry.payload,
            ),
        }
    }
}

/// The bytes a slot's CURRENT on-disk form would free if it dies —
/// `OnDisk`'s own length, or `Loaded`'s length AS RECORDED AT
/// MATERIALIZATION, never re-derived: re-deriving it from a `Loaded`
/// entry means resolving every edge's name back to an id through
/// `map_find`, the same cost `interned` already paid once to mint
/// them. `put`'s dead-byte accounting hit exactly this — a file's
/// witness read once for `reused_check`'s validation, materializing
/// its slot, then overwritten by the recompute `put` that follows,
/// paying a full re-encode just to measure a length it already knew.
fn dead_frame_len(slot: Slot) -> int {
    match slot { .OnDisk(body) -> framed_len(entry_tag(), body), .Loaded(_, len) -> len }
}

fn commit_frame() -> Bytes {
    let w = writer()
    write_frame(w, commit_tag(), "".bytes())
    w.bytes()
}
