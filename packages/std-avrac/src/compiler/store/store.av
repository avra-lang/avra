//! THE STORE — every artifact a build keeps, by content.
//!
//! ONE ROW SHAPE (a key, the bytes it names, the keys it read), ONE VERB SET, and a
//! family as a KIND rather than a spelling. The five value families ride the packed
//! store (`store/pack.av`): one index built at open, an append to this writer's own
//! segment per row. `Obj` and `Bin` stay files, named by content.
//!
//! A KEY IS CONTENT — a digest over a STABLE projection, never a per-run id, which is a
//! slot in one process's table and means nothing to the next.
//!
//! A FILE ROW IS PRESENT ONLY WHEN ITS EDGES ARE, so a write that never finished reads
//! as ABSENT rather than as half a value. A packed row is present once its commit
//! marker lands, which is the same law one mechanism over.
use @std.io.{exists, read_text, write_text, read_bytes, write_bytes, make_dirs, remove}
use @std.path.{joined_path}
use @std.relation.engine.{map_cell}
use core.{digest_of, joined}
use core.debug.{qtrace, traced}
use core.runtime_header.{runtime_header}

/// WHAT THE STORE KEEPS, as a KIND — so a family cannot be misspelled and every match
/// over it is exhaustive. Adding one is this enum and a directory name, which is the
/// smallest edit a new family can be.
export enum Stored {
    /// A declaration's interface, stored STRUCTURALLY: a rendered spelling is a lossy
    /// round trip that must REFUSE what it cannot re-render, which is what text did.
    Sig
    /// The tree's stamps: one row, each path with its stamp and its digest.
    Fp
    /// What a derivation remembers that is no artifact: a file's asks, a settled
    /// const, a program's homes and closure, a verdict the evaluator agreed with.
    Unit
    /// Machine code: a file's object, or a program's module.
    Obj
    /// The linked program.
    Bin
    /// A workspace's kept `@query` answers (compiler/answers.av): each record carries
    /// what it stood on, and is filed under its query's durable name and code hash.
    Answer
    /// WHAT THE BUILD SAID about it — the warnings a hit must still speak, and the
    /// reason they are a row rather than a field: a program that is not analysed has no
    /// voice to ask, and a build that quietly stops warning is the silent wrongness this
    /// whole design is arranged against.
    Warn
    /// THE DB's own rows (compiler/db.av) — a heterogeneous answer, keyed by its kind
    /// and name, never an artifact of a build.
    Rows
}

impl Stored {
    /// The directory a family lives in — ONE projection, so the name a row is written
    /// under and the name it is looked up by cannot differ.
    fn name() -> string {
        match self {
            .Sig -> "sig",
            .Fp -> "fp",
            .Unit -> "unit",
            .Obj -> "obj",
            .Bin -> "bin",
            .Warn -> "warn",
            .Answer -> "answer",
            .Rows -> "rows",
        }
    }

    /// Whether this family is a FILE (`Obj`, `Bin`) rather than a packed value.
    fn file_family() -> bool {
        match self {
            .Obj or .Bin -> true,
            .Sig or .Fp or .Unit or .Warn or .Rows or .Answer -> false,
        }
    }
}

/// WHERE A STORE'S WRITES LAND: on disk, or SET ASIDE in this process — read
/// back before the disk and never written to it, so an inspection derives as a
/// check does and leaves the store exactly as it found it (P7).
export enum Keeping {
    Disk
    Aside(Cell<Map<string, string>>)
}

/// THE STORE — one root, the packed index, and where its writes land.
export type Store = { root: string, print: string, keeping: Keeping, pack: Pack, producers: Producers }

/// WHAT STAMPS A FAMILY'S ROWS so a compiler that did not write them may read them: the
/// producing code, its codec and the toolchain, folded to one digest — or the reason there
/// is none, in which case the rows stay the writing compiler's own.
export enum Producer {
    Hashed(stamp: string)
    /// A hash the producer's closure cannot answer.
    Absent
}

/// The producer of each family whose rows can be shared; every other family is the
/// compiler's own.
export type Producers = { sig: Producer }

/// No family shared.
export fn unshared() -> Producers { Producers { sig: Producer.Absent } }

/// What the pack's format and the runtime its values pass through contribute to a stamp.
export fn store_toolchain() -> string { "${pack_format()}.${digest_of(runtime_header())}" }

/// A producer from the parts that make a row what it is — its producing code's hash, its
/// encode and decode — and the toolchain: absent when any part is.
export fn producer_of(parts: List<string?>) -> Producer { producer_under(parts, store_toolchain()) }

/// `producer_of` under a given toolchain.
export fn producer_under(parts: List<string?>, toolchain: string) -> Producer {
    if parts.any(it == null) { return Producer.Absent }
    Producer.Hashed(digest_of(joined([p! for p in parts].concat([toolchain]), "\n")))
}

/// The packs this process has open, one per root and compiler print — so a store
/// is read from disk once however many workspaces ask for it. A pack lives while a
/// workspace holds it (`pack_held`): the last release lets it go, so a process that
/// makes workspaces of its own prints does not keep every index it ever read. An
/// emptied entry is a pack let go; a pack nobody holds is never entered.
once fn packs() -> Cell<Map<string, List<Pack>>> { map_cell() }

/// How many workspaces hold each pack, by its key.
once fn holders() -> Cell<Map<string, int>> { map_cell() }

fn pack_key(root: string, print: string) -> string { "${root}\n${print}" }

fn pack_for(root: string, print: string) -> Pack {
    let at = pack_key(root, print)
    let known: Pack? = packs().get().get(at)?.first()
    known ?? mint_pack(at, root, print)
}

/// A pack is SHARED only while a workspace holds its key; a store made with no holder
/// owns its pack, which goes with it.
fn mint_pack(at: string, root: string, print: string) -> Pack {
    let made = pack_at(root, print)
    if holders().get().get(at) ?? 0 > 0 { packs().put(at, [made]) }
    made
}

/// A workspace's hold, moved to the pack of `root` under `print`: `held` is the key it
/// holds now (empty for none), and the key it holds after is answered. A hold that
/// has not moved costs a compare.
export fn pack_holding(held: string, root: string, print: string) -> string {
    let at = pack_key(root, print)
    if at == held { return held }
    if !held.is_empty() { pack_released(held) }
    holders().put(at, (holders().get().get(at) ?? 0) + 1)
    at
}

/// A workspace lets go of the pack it held; the last one lets the pack go.
export fn pack_released(at: string) {
    let left = (holders().get().get(at) ?? 0) - 1
    holders().put(at, if left > 0 { left } else { 0 })
    if left <= 0 { packs().put(at, []) }
}

/// Whether a store's writes are set aside — an inspection keeps to memory.
fn inspects(keeping: Keeping) -> bool { match keeping { .Disk -> false, .Aside(_) -> true } }

// LICENSED compiler.free_state_verb: a CONSTRUCTOR — the root in, the store out, like `new_kernel`.
export fn store_at(root: string) -> Store { store_with(root, "", Keeping.Disk) }

/// A store with its compiler print and where its writes land — the one place a
/// workspace turns its own identity into a store.
// LICENSED compiler.free_state_verb: a CONSTRUCTOR — a root, a print and a mode in.
export fn store_with(root: string, print: string, keeping: Keeping) -> Store { store_stamped(root, print, unshared(), keeping) }

/// `store_with`, the families it shares named: a row of one is filed under its producer's
/// stamp and read by any compiler of the same stamp; every other row under this compiler's.
// LICENSED compiler.free_state_verb: a CONSTRUCTOR — a root, a print, the producers and a mode in.
export fn store_stamped(root: string, print: string, producers: Producers, keeping: Keeping) -> Store {
    let made = Store {
        root: root,
        print: print,
        keeping: keeping,
        pack: pack_for(root, print),
        producers: producers,
    }
    if traced() { qtrace("Q\tstore\tstamp\tsig\t${stamp_word(producers.sig)}\n") }
    made
}

/// How a producer reads in the trace.
fn stamp_word(p: Producer) -> string { match p { .Hashed(_) -> "shared", .Absent -> "absent" } }

/// ONE READ OF A SAVED ANSWER: what was read, named by its stable name, and the digest
/// of exactly what came back. A name holds no newline; a digest holds no space and is
/// not empty.
export type Reading = { name: string, digest: string }

impl Reading {
    /// The read as the row's list holds it: digest first, since it holds no space and
    /// the name may.
    fn spelled() -> string { "${self.digest} ${self.name}" }

    /// Whether the read can be spelled and read back whole.
    fn writable() -> bool {
        !self.digest.is_empty() && !self.digest.contains(" ") && !self.name.contains("\n")
    }
}

/// A read read back from a row's list; absent for a line that is no pair.
export fn read_spelled(line: string) -> Reading? {
    let name? = read_name(line) else { return null }
    Reading { name: name, digest: line.substring(0, line.length - name.length - 1) }
}

/// A KEY OVER A PROJECTION — the one derivation every family shares, so no family can
/// key itself differently from its neighbours. The family's name is folded first, so two
/// families naming the same parts stay apart.
// LICENSED compiler.free_state_verb: a pure PROJECTION — a family and its parts in, the key out.
export fn node_key(family: Stored, parts: List<string>) -> string {
    let key = digest_of(joined([family.name()].concat(parts), "\n"))
    if traced() { key_words().put(key, parts.first() ?? "") }
    key
}

/// Under a trace, the first word of each key's parts — what kind of row the key names.
once fn key_words() -> Cell<Map<string, string>> { map_cell() }

/// One lookup's trace line by the kind of row it asked, so a family's traffic can be told apart.
fn kind_line(op: string, hit: bool, family: Stored, key: string) -> string {
    "Q\tstore\tkind\t${op}\t${if hit { "hit" } else { "miss" }}\t${family.name()}\t${key_words().get().get(key) ?? "?"}\n"
}

impl Store {
    /// A family's name as the pack files it: with the stamp its rows stand under.
    fn packed(family: Stored) -> string { "${family.name()}@${self.stamp_of(family)}" }

    /// What a family's rows stand under. THE REGISTRY OF WHO MAY READ THEM: a family with a
    /// producer stands under its stamp, every other under the compiler that wrote it.
    fn stamp_of(family: Stored) -> string {
        match family {
            .Sig -> self.shared_or_own(self.producers.sig),
            .Fp or .Unit or .Obj or .Bin or .Warn or .Rows or .Answer -> self.own_stamp(),
        }
    }

    fn shared_or_own(p: Producer) -> string { match p { .Hashed(stamp) -> "shared ${stamp}", .Absent -> self.own_stamp() } }

    fn own_stamp() -> string { "own ${self.print}" }

    /// THE SHARD a key lands in — one projection, because the writer that makes the
    /// directory and the writer that names the file must agree about it. A content key is
    /// uniform, so two characters make 256 buckets and no directory grows unbounded.
    fn shard(family: Stored, key: string) -> string {
        joined_path(joined_path(self.root, family.name()), key.substring(0, 2))
    }

    /// A file family's key path.
    fn path(family: Stored, key: string) -> string { joined_path(self.shard(family, key), key) }

    fn edge_path(family: Stored, key: string) -> string { "${self.path(family, key)}.deps" }

    /// The key an aside row stands under, one shape per family kind.
    fn aside_key(family: Stored, key: string) -> string {
        if family.file_family() { self.path(family, key) } else { "${family.name()}\n${key}" }
    }

    /// Withdraw an earlier commit before replacing its data. If the next
    /// write fails, its old edge cannot make the new data look complete.
    fn uncommit(family: Stored, key: string) -> bool {
        if !family.file_family() {
            pack_forget(self.pack, self.packed(family), key)
            return true
        }
        let edge = self.edge_path(family, key)
        // LICENSED input.store_io: the store's own edge file, asked only to uncommit it
        if !exists(edge) { return true }
        match remove(edge) { .Ok(_) -> true, .Err(_) -> false }
    }

    /// HAS THIS CHANGED? A row set aside, or — for a packed family — the index an
    /// open built; a file family asks two `exists`, reading nothing.
    fn has(family: Stored, key: string) -> bool {
        let found = self.holds_row(family, key)
        if traced() { qtrace(kind_line("has", found, family, key)) }
        found
    }

    fn holds_row(family: Stored, key: string) -> bool {
        if self.aside_row(family, key) != null { return true }
        if family.file_family() {
            self.on_disk(family, key)
        } else {
            pack_has(self.pack, self.packed(family), key, inspects(self.keeping))
        }
    }

    fn on_disk(family: Stored, key: string) -> bool {
        // LICENSED input.store_io: the store's own kept row and its edge, asked to prove the row
        exists(self.path(family, key)) && exists(self.edge_path(family, key))
    }

    /// The row this process set aside under a key — none on a store that keeps to disk.
    fn aside_row(family: Stored, key: string) -> string? {
        match self.keeping {
            .Disk -> null,
            .Aside(rows) -> rows.get().get(self.aside_key(family, key)),
        }
    }

    /// The bytes a key names, or nothing when the row is not committed.
    fn get(family: Stored, key: string) -> string? {
        let found = self.read_row(family, key)
        if traced() { qtrace(kind_line("get", found != null, family, key)) }
        found
    }

    fn read_row(family: Stored, key: string) -> string? {
        let aside = self.aside_row(family, key)
        if aside != null { return aside }
        if family.file_family() {
            self.read_disk(family, key)
        } else {
            pack_get(self.pack, self.packed(family), key, inspects(self.keeping))
        }
    }

    fn read_disk(family: Stored, key: string) -> string? {
        if !self.on_disk(family, key) { return null }
        // LICENSED input.store_io: the store's own kept row, read to answer it
        match read_text(self.path(family, key)) { .Ok(text) -> text, .Err(_) -> null }
    }

    /// REMEMBER A ROW — on disk, or set aside where the store keeps none.
    fn keep(family: Stored, key: string, bytes: string, read: List<string>) -> bool {
        match self.keeping {
            .Disk -> self.disk_kept(family, key, bytes, read),
            .Aside(rows) -> {
                rows.put(self.aside_key(family, key), bytes)
                rows.put(self.reads_key(family, key), joined(read, "\n"))
                true
            },
        }
    }

    fn disk_kept(family: Stored, key: string, bytes: string, read: List<string>) -> bool {
        if family.file_family() { return self.written(family, key, bytes, read) }
        pack_put(self.pack, self.packed(family), key, bytes, read)
        true
    }

    /// A file row on disk: the DATA first, then the EDGES, so the second write is what
    /// makes the row visible and a crash between them leaves nothing rather than half.
    fn written(family: Stored, key: string, bytes: string, read: List<string>) -> bool {
        match make_dirs(self.shard(family, key)) { .Ok(_) -> {}, .Err(_) -> { return false } }
        if !self.uncommit(family, key) { return false }
        match write_text(self.path(family, key), bytes) {
            .Ok(_) -> {},
            .Err(_) -> { return false },
        }
        match write_text(self.edge_path(family, key), joined(read, "\n")) {
            .Ok(_) -> true,
            .Err(_) -> false,
        }
    }

    /// REMEMBER AN ANSWER WITH WHAT IT READ — each read's name and digest. Refused (false)
    /// when a read cannot be spelled whole, so no answer is kept on a list that would
    /// read back as something else.
    fn keep_reading(family: Stored, key: string, bytes: string, reads: List<Reading>) -> bool {
        if reads.any(!it.writable()) { return false }
        self.keep(family, key, bytes, [r.spelled() for r in reads])
    }

    /// THE SAVED-ANSWER RULE, PULLED: the row's bytes only if every read it was kept with
    /// still has the digest it was read at. `now` answers a name's digest at this moment,
    /// absent for a name that cannot be read. A row kept with no pairs, or whose reads
    /// cannot be read back, is a miss — no other check stands in.
    fn get_valid(family: Stored, key: string, now: fn(string) -> string?) -> string? {
        if !self.holds(family, key, now) { return null }
        self.get(family, key)
    }

    /// Whether a row's reads all still have their digests — the rule alone, with no value
    /// fetched. A row not present, or kept with edges that are no pairs, does not hold.
    fn holds(family: Stored, key: string, now: fn(string) -> string?) -> bool {
        let lines? = self.reads_of(family, key) else { return false }
        let reads = [read_spelled(l) for l in lines]
        !reads.any(it == null || now(it!.name) != it!.digest)
    }

    /// THE SUSPECT SET: the record keys of the rows that read any of the inputs in `moved`, by
    /// name. Ids only — no value is fetched, no row decoded. A row not in the set stands.
    fn suspects(moved: List<string>) -> List<string> {
        pack_suspects(self.pack, moved)
    }

    /// THE KEY A ROW IS FILED UNDER, as the pack spells it: the family's name and the stamp it
    /// stands under, then the key — the same spelling `pack_suspects` answers with.
    fn suspect_key(family: Stored, key: string) -> string { record_key(self.packed(family), key) }

    /// What this process has asked of the store so far.
    fn traffic() -> Traffic { pack_traffic(self.pack) }

    /// Whether a packed row is there and reads none of the inputs behind `suspect` (a suspect
    /// set's record keys): it stands with nothing judged. An aside or file row is never so.
    fn unsuspected(family: Stored, key: string, suspect: Map<string, bool>) -> bool {
        !family.file_family() &&
            self.aside_row(family, key) == null &&
            self.has(family, key) &&
            suspect.get(self.suspect_key(family, key)) == null
    }

    /// The lines a row was kept with.
    fn reads_of(family: Stored, key: string) -> List<string>? {
        if self.aside_row(family, key) != null {
            return lines_of(self.aside_reads(family, key))
        }
        if !family.file_family() { return pack_reads(self.pack, self.packed(family), key, inspects(self.keeping)) }
        // LICENSED input.store_io: the store's own edge file, read to prove a row's reads
        match read_text(self.edge_path(family, key)) { .Ok(t) -> lines_of(t), .Err(_) -> null }
    }

    /// An aside row's reads, kept beside its bytes.
    fn aside_reads(family: Stored, key: string) -> string {
        match self.keeping {
            .Aside(rows) -> rows.get().get(self.reads_key(family, key)) ?? "",
            .Disk -> "",
        }
    }

    /// Where an aside row's reads stand beside its bytes.
    fn reads_key(family: Stored, key: string) -> string { "reads\n${self.aside_key(family, key)}" }

    /// A derivation's end: what it appended is folded into a sealed body once there is
    /// enough of it, so the next open reads an index. An inspection keeps nothing to fold.
    fn settle() {
        if !inspects(self.keeping) { pack_settle(self.pack) }
    }

    /// RECLAIM by §6.7's rule: compaction folds the reachable rows into a fresh
    /// sealed body, then the limits evict the oldest history. The time-travel
    /// window is the limits' `revisions`.
    fn clean() -> CleanReport { pack_clean(self.pack, store_limits()) }

    /// ANSWER ONE ROW FROM AN OLDER REVISION — §6.7's time-travel read, over a fresh
    /// index of that body (never this process's live one).
    fn at_revision(rev: int, family: Stored, key: string) -> string? {
        pack_get_rev(pack_at(self.root, self.print), rev, self.packed(family), key)
    }

    /// WHAT THIS STORE HOLDS OVER A BASE, written as one segment under `into`: the rows `base_root`'s
    /// store lacks or answers differently, so a segment is the run's own addition. Answers the count.
    fn exported(base_root: string, into_root: string) -> int {
        pack_export(self.pack, pack_at(base_root, self.print), pack_at(into_root, self.print))
    }

    /// The rows a sealed revision holds, for an `explain` that says what changed.
    fn rows_at(rev: int) -> List<Held> { pack_rows_rev(pack_at(self.root, self.print), rev) }

    /// A ROW WHOSE KEY IS ITS CONTENT is kept once: the same key names the same
    /// bytes, so a second write is skipped.
    fn keep_once(family: Stored, key: string, bytes: string, read: List<string> = []) -> bool {
        self.has(family, key) || self.keep(family, key, bytes, read)
    }

    /// REMEMBER A ROW WHOSE BYTES ARE A FILE — the twinned half of `keep`, because a
    /// linked binary is BYTES and reading it as text is the thing that loses them. A
    /// store that keeps aside keeps no file: only a build makes one.
    fn keep_file(family: Stored, key: string, from: string, read: List<string>) -> bool {
        match self.keeping {
            .Disk -> self.file_written(family, key, from, read),
            .Aside(_) -> false,
        }
    }

    fn file_written(family: Stored, key: string, from: string, read: List<string>) -> bool {
        match make_dirs(self.shard(family, key)) { .Ok(_) -> {}, .Err(_) -> { return false } }
        // LICENSED input.store_io: a file's own bytes, read to keep them for the store
        let bytes = match read_bytes(from) { .Ok(b) -> b, .Err(_) -> { return false } }
        if !self.uncommit(family, key) { return false }
        store_wrote()
        match write_bytes(self.path(family, key), bytes) {
            .Ok(_) -> {},
            .Err(_) -> { return false },
        }
        match write_text(self.edge_path(family, key), joined(read, "\n")) {
            .Ok(_) -> true,
            .Err(_) -> false,
        }
    }

    /// PUT A ROW WHERE A CALLER WANTS IT — what a hit does with a binary: the store has
    /// the bytes and the caller wants them at a path, and neither re-reads the other.
    fn place(family: Stored, key: string, to: string) -> bool {
        if !self.has(family, key) { return false }
        // LICENSED input.store_io: the store's own kept row, read to place it for a caller
        let bytes = match read_bytes(self.path(family, key)) {
            .Ok(b) -> b,
            .Err(_) -> { return false },
        }
        match write_bytes(to, bytes) { .Ok(_) -> true, .Err(_) -> false }
    }
}

/// A row's lines, none for an empty list.
fn lines_of(text: string) -> List<string> { text.split("\n").filter(!it.is_empty()) }
