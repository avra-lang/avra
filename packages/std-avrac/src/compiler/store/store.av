//! THE STORE — every artifact a build keeps, by content.
//!
//! ONE ROW SHAPE (a key, the bytes it names, the keys it read), ONE VERB SET, and a
//! family as a KIND rather than a spelling. The five value families ride the packed
//! store (`store/pack.av`): one index built at open, an append to this writer's own
//! segment per row. `Obj` and `Bin` stay files, named by content.
//!
//! A KEY IS CONTENT — a digest over a STABLE projection, never a per-run id, which is a
//! slot in one process's table and means nothing to the next.
//!
//! A FILE ROW IS PRESENT ONLY WHEN ITS EDGES ARE, so a write that never finished reads
//! as ABSENT rather than as half a value. A packed row is present once its commit
//! marker lands, which is the same law one mechanism over.
use @std.io.{exists, read_text, write_text, read_bytes, write_bytes, make_dirs, remove}
use @std.path.{joined_path}
use @std.relation.engine.{map_cell}
use core.{digest_of, joined}

/// WHAT THE STORE KEEPS, as a KIND — so a family cannot be misspelled and every match
/// over it is exhaustive. Adding one is this enum and a directory name, which is the
/// smallest edit a new family can be.
export enum Stored {
    /// A declaration's interface, stored STRUCTURALLY: a rendered spelling is a lossy
    /// round trip that must REFUSE what it cannot re-render, which is what text did.
    Sig
    /// The tree's stamps: one row, each path with its stamp and its digest.
    Fp
    /// What a derivation remembers that is no artifact: a file's asks, a settled
    /// const, a program's homes and closure, a verdict the evaluator agreed with.
    Unit
    /// Machine code: a file's object, or a program's module.
    Obj
    /// The linked program.
    Bin
    /// WHAT THE BUILD SAID about it — the warnings a hit must still speak, and the
    /// reason they are a row rather than a field: a program that is not analysed has no
    /// voice to ask, and a build that quietly stops warning is the silent wrongness this
    /// whole design is arranged against.
    Warn
    /// THE DB's own rows (compiler/db.av) — a heterogeneous answer, keyed by its kind
    /// and name, never an artifact of a build.
    Rows
}

impl Stored {
    /// The directory a family lives in — ONE projection, so the name a row is written
    /// under and the name it is looked up by cannot differ.
    fn name() -> string {
        match self {
            .Sig -> "sig",
            .Fp -> "fp",
            .Unit -> "unit",
            .Obj -> "obj",
            .Bin -> "bin",
            .Warn -> "warn",
            .Rows -> "rows",
        }
    }

    /// Whether this family is a FILE (`Obj`, `Bin`) rather than a packed value.
    fn file_family() -> bool {
        match self { .Obj or .Bin -> true, .Sig or .Fp or .Unit or .Warn or .Rows -> false }
    }
}

/// WHERE A STORE'S WRITES LAND: on disk, or SET ASIDE in this process — read
/// back before the disk and never written to it, so an inspection derives as a
/// check does and leaves the store exactly as it found it (P7).
export enum Keeping {
    Disk
    Aside(Cell<Map<string, string>>)
}

/// THE STORE — one root, the packed index, and where its writes land.
export type Store = { root: string, print: string, keeping: Keeping, pack: Pack }

/// The packs this process has open, one per root and compiler print — so a store
/// is read from disk once however many workspaces ask for it.
once fn packs() -> Cell<Map<string, Pack>> { map_cell() }

fn pack_for(root: string, print: string) -> Pack {
    let at = "${root}\n${print}"
    let known: Pack? = packs().get().get(at)
    known ?? mint_pack(at, root, print)
}

fn mint_pack(at: string, root: string, print: string) -> Pack {
    let made = pack_at(root, print)
    packs().put(at, made)
    made
}

// LICENSED compiler.free_state_verb: a CONSTRUCTOR — the root in, the store out, like `new_kernel`.
export fn store_at(root: string) -> Store { store_with(root, "", Keeping.Disk) }

/// A store with its compiler print and where its writes land — the one place a
/// workspace turns its own identity into a store.
// LICENSED compiler.free_state_verb: a CONSTRUCTOR — a root, a print and a mode in.
export fn store_with(root: string, print: string, keeping: Keeping) -> Store {
    Store { root: root, print: print, keeping: keeping, pack: pack_for(root, print) }
}

/// A KEY OVER A PROJECTION — the one derivation every family shares, so no family can
/// key itself differently from its neighbours. The family's name is folded first, so two
/// families naming the same parts stay apart.
// LICENSED compiler.free_state_verb: a pure PROJECTION — a family and its parts in, the key out.
export fn node_key(family: Stored, parts: List<string>) -> string {
    digest_of(joined([family.name()].concat(parts), "\n"))
}

impl Store {
    /// THE SHARD a key lands in — one projection, because the writer that makes the
    /// directory and the writer that names the file must agree about it. A content key is
    /// uniform, so two characters make 256 buckets and no directory grows unbounded.
    fn shard(family: Stored, key: string) -> string {
        joined_path(joined_path(self.root, family.name()), key.substring(0, 2))
    }

    /// A file family's key path.
    fn path(family: Stored, key: string) -> string { joined_path(self.shard(family, key), key) }

    fn edge_path(family: Stored, key: string) -> string { "${self.path(family, key)}.deps" }

    /// The key an aside row stands under, one shape per family kind.
    fn aside_key(family: Stored, key: string) -> string {
        if family.file_family() { self.path(family, key) } else { "${family.name()}\n${key}" }
    }

    /// Withdraw an earlier commit before replacing its data. If the next
    /// write fails, its old edge cannot make the new data look complete.
    fn uncommit(family: Stored, key: string) -> bool {
        let edge = self.edge_path(family, key)
        if !exists(edge) { return true }
        match remove(edge) { .Ok(_) -> true, .Err(_) -> false }
    }

    /// HAS THIS CHANGED? A row set aside, or — for a packed family — the index an
    /// open built; a file family asks two `exists`, reading nothing.
    fn has(family: Stored, key: string) -> bool {
        if self.aside_row(family, key) != null { return true }
        if family.file_family() { self.on_disk(family, key) } else { pack_has(self.pack, family.name(), key) }
    }

    fn on_disk(family: Stored, key: string) -> bool {
        exists(self.path(family, key)) && exists(self.edge_path(family, key))
    }

    /// The row this process set aside under a key — none on a store that keeps to disk.
    fn aside_row(family: Stored, key: string) -> string? {
        match self.keeping {
            .Disk -> null,
            .Aside(rows) -> rows.get().get(self.aside_key(family, key)),
        }
    }

    /// The bytes a key names, or nothing when the row is not committed.
    fn get(family: Stored, key: string) -> string? {
        let aside = self.aside_row(family, key)
        if aside != null { return aside }
        if family.file_family() { self.read_disk(family, key) } else { pack_get(self.pack, family.name(), key) }
    }

    fn read_disk(family: Stored, key: string) -> string? {
        if !self.on_disk(family, key) { return null }
        // LICENSED input.store_io: the store's own kept row, read to answer it
        match read_text(self.path(family, key)) { .Ok(text) -> text, .Err(_) -> null }
    }

    /// REMEMBER A ROW — on disk, or set aside where the store keeps none.
    fn keep(family: Stored, key: string, bytes: string, read: List<string>) -> bool {
        match self.keeping {
            .Disk -> self.disk_kept(family, key, bytes, read),
            .Aside(rows) -> {
                rows.put(self.aside_key(family, key), bytes)
                true
            },
        }
    }

    fn disk_kept(family: Stored, key: string, bytes: string, read: List<string>) -> bool {
        if family.file_family() { return self.written(family, key, bytes, read) }
        pack_put(self.pack, family.name(), key, bytes, read)
        true
    }

    /// A file row on disk: the DATA first, then the EDGES, so the second write is what
    /// makes the row visible and a crash between them leaves nothing rather than half.
    fn written(family: Stored, key: string, bytes: string, read: List<string>) -> bool {
        match make_dirs(self.shard(family, key)) { .Ok(_) -> {}, .Err(_) -> { return false } }
        if !self.uncommit(family, key) { return false }
        match write_text(self.path(family, key), bytes) {
            .Ok(_) -> {},
            .Err(_) -> { return false },
        }
        match write_text(self.edge_path(family, key), joined(read, "\n")) {
            .Ok(_) -> true,
            .Err(_) -> false,
        }
    }

    /// A ROW WHOSE KEY IS ITS CONTENT is kept once: the same key names the same
    /// bytes, so a second write is skipped.
    fn keep_once(family: Stored, key: string, bytes: string, read: List<string> = []) -> bool {
        self.has(family, key) || self.keep(family, key, bytes, read)
    }

    /// REMEMBER A ROW WHOSE BYTES ARE A FILE — the twinned half of `keep`, because a
    /// linked binary is BYTES and reading it as text is the thing that loses them. A
    /// store that keeps aside keeps no file: only a build makes one.
    fn keep_file(family: Stored, key: string, from: string, read: List<string>) -> bool {
        match self.keeping {
            .Disk -> self.file_written(family, key, from, read),
            .Aside(_) -> false,
        }
    }

    fn file_written(family: Stored, key: string, from: string, read: List<string>) -> bool {
        match make_dirs(self.shard(family, key)) { .Ok(_) -> {}, .Err(_) -> { return false } }
        // LICENSED input.store_io: a file's own bytes, read to keep them for the store
        let bytes = match read_bytes(from) { .Ok(b) -> b, .Err(_) -> { return false } }
        if !self.uncommit(family, key) { return false }
        match write_bytes(self.path(family, key), bytes) {
            .Ok(_) -> {},
            .Err(_) -> { return false },
        }
        match write_text(self.edge_path(family, key), joined(read, "\n")) {
            .Ok(_) -> true,
            .Err(_) -> false,
        }
    }

    /// PUT A ROW WHERE A CALLER WANTS IT — what a hit does with a binary: the store has
    /// the bytes and the caller wants them at a path, and neither re-reads the other.
    fn place(family: Stored, key: string, to: string) -> bool {
        if !self.has(family, key) { return false }
        let bytes = match read_bytes(self.path(family, key)) {
            .Ok(b) -> b,
            .Err(_) -> { return false },
        }
        match write_bytes(to, bytes) { .Ok(_) -> true, .Err(_) -> false }
    }
}
