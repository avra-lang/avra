// THE PACK's durability contract: a row and its witness settle in one
// write, and a reader trusts nothing past the last commit it can
// verify — a torn tail or a flipped checksum loses the batch that
// wrote it, never the batches before it, and never traps.
use @std.io.{read_bytes, write_bytes, make_dirs, exists, remove}
use @std.text.{from_codepoint}
use @std.time.{now_ns}
use compiler.store.{Pack, Entry, Edge, pack_at}

/// One directory per run, so no earlier run's pack answers for this one.
once fn pack_base() -> string { "/tmp/avra-pack-test/${now_ns()}" }

fn dir(name: string) -> string { "${pack_base()}/${name}" }

/// A path with nothing at it yet. The scratch directory outlives one
/// run, and a pack left over from an earlier run would silently
/// extend this one's instead of starting fresh.
fn fresh(name: string) -> string {
    let _ = make_dirs(dir(name))
    let path = "${dir(name)}/pack.bin"
    if exists(path) { let _ = remove(path) }
    path
}

fn entry(name: string, fp: int, hash: int, edges: List<Edge>, payload: string) -> Entry {
    Entry { name: name, fingerprint: fp, hash: hash, edges: edges, payload: payload.bytes() }
}

fn same(e: Entry?, name: string, fp: int, hash: int, payload: string) -> bool {
    match e {
        v? -> v.name == name &&
            v.fingerprint == fp &&
            v.hash == hash &&
            v.payload == payload.bytes()
        null -> false
    }
}

fn edge_names(e: Entry?) -> List<string> {
    match e {
        v? -> [d.name for d in v.edges]
        null -> []
    }
}

fn raw_of(path: string) -> Bytes {
    match read_bytes(path) { .Ok(b) -> b, .Err(_) -> "".bytes() }
}

fn truncated(from: string, to: string, len: int) {
    let _ = write_bytes(to, raw_of(from).slice(0, len))
}

spec "compiler/store/pack" {
    given "a pack that has seen nothing" {
        then "an absent path answers nothing, for any name" {
            pack_at(fresh("empty") + ".none", "cid").get("x") == null
        }
    }
    given "one entry, put and committed" {
        then "a fresh pack over the same path answers it back" {
            let path = fresh("one")
            let p = pack_at(path, "cid")
            p.put(entry("a.b", 7, 111, [Edge { name: "a.c", hash: 222 }], "the lowered body"))
            p.commit() && same(pack_at(path, "cid").get("a.b"), "a.b", 7, 111, "the lowered body")
        }
        then "its edge resolves back to the name it names" {
            let path = fresh("one_edge")
            let p = pack_at(path, "cid")
            p
                .put(
                    entry(
                        "a.b",
                        7,
                        111,
                        [Edge { name: "a.c", hash: 222 }, Edge { name: "a.d", hash: 333 }],
                        "x",
                    ),
                )
            p.commit()
            let names = edge_names(pack_at(path, "cid").get("a.b"))
            names.length == 2 && names[0] == "a.c" && names[1] == "a.d"
        }
        then "it is visible to `get` before `commit` is even called" {
            let p = pack_at(fresh("uncommitted_read"), "cid")
            p.put(entry("a.b", 1, 2, [], "staged"))
            same(p.get("a.b"), "a.b", 1, 2, "staged")
        }
    }
    given "the same name written twice" {
        then "a fresh pack answers the newer commit, not the older" {
            let path = fresh("overwrite")
            let p1 = pack_at(path, "cid")
            p1.put(entry("a.b", 1, 100, [], "v1"))
            let _ = p1.commit()
            let p2 = pack_at(path, "cid")
            p2.put(entry("a.b", 2, 200, [], "v2"))
            let _ = p2.commit()
            same(pack_at(path, "cid").get("a.b"), "a.b", 2, 200, "v2")
        }
    }
    given "a torn tail" {
        then "every truncation of the last entry answers the commit before it, never a partial one, never a trap" {
            let path = fresh("torn")
            let p1 = pack_at(path, "cid")
            p1.put(entry("a", 1, 10, [], "first"))
            let _ = p1.commit()
            let boundary = raw_of(path).length
            let p2 = pack_at(path, "cid")
            p2.put(entry("b", 2, 20, [], "second"))
            let _ = p2.commit()
            let whole = raw_of(path).length
            [torn_ok(path, whole, n) for n in boundary..whole + 1].all(it)
        }
    }
    given "a checksum flipped in the last committed frame" {
        then "the entry it closed is rejected, not trusted and not a trap" {
            let path = fresh("flip")
            let p = pack_at(path, "cid")
            p.put(entry("a.b", 1, 2, [], "x"))
            let _ = p.commit()
            let raw = raw_of(path)
            let last = raw.at(raw.length - 1)
            let flipped = raw.slice(0, raw.length - 1).concat([(last + 1) % 256].bytes()!)
            let to = "${dir("flip")}/flipped.bin"
            let _ = write_bytes(to, flipped)
            pack_at(to, "cid").get("a.b") == null
        }
    }
    given "a pack written by another compiler" {
        then "it reads as empty, and this compiler's own write starts fresh" {
            let path = fresh("other_compiler")
            let p1 = pack_at(path, "cid-a")
            p1.put(entry("a.b", 1, 2, [], "x"))
            let _ = p1.commit()
            let mismatched = pack_at(path, "cid-b").get("a.b") == null
            let p2 = pack_at(path, "cid-b")
            p2.put(entry("c.d", 3, 4, [], "y"))
            let _ = p2.commit()
            let still_absent = pack_at(path, "cid-b").get("a.b") == null
            mismatched && still_absent && same(pack_at(path, "cid-b").get("c.d"), "c.d", 3, 4, "y")
        }
    }
    given "a pack past half garbage" {
        then "the commit that crosses it compacts on its own, and a later explicit compact stays correct" {
            let path = fresh("compact")
            let p = pack_at(path, "cid")
            p.put(entry("a", 1, 10, [], "v1 of a, long enough to weigh something on disk"))
            let _ = p.commit()
            let heavy = raw_of(path).length
            p.put(entry("a", 2, 20, [], "v2 of a"))
            let _ = p.commit()
            let shrunk_on_commit = raw_of(path).length < heavy
            let explicit = p.compact()
            let live_now = same(p.get("a"), "a", 2, 20, "v2 of a")
            shrunk_on_commit &&
                explicit &&
                live_now &&
                same(pack_at(path, "cid").get("a"), "a", 2, 20, "v2 of a")
        }
    }
    given "a payload carrying a NUL" {
        then "it survives whole, byte for byte" {
            let path = fresh("nul")
            let raw_payload = "ab" + from_codepoint(0) + "cd"
            let p = pack_at(path, "cid")
            p.put(entry("a.b", 1, 2, [], raw_payload))
            let _ = p.commit()
            let got = pack_at(path, "cid").get("a.b")
            match got {
                v? -> v.payload == raw_payload.bytes()
                null -> false
            }
        }
    }
    given "a name table with thousands of names" {
        then "every one of them answers its own entry back" {
            let path = fresh("many")
            let p = pack_at(path, "cid")
            for i in 0..3000 { p.put(entry("n${i}", i, i * 7, [], "v${i}")) }
            let _ = p.commit()
            let reopened = pack_at(path, "cid")
            [same(reopened.get("n${i}"), "n${i}", i, i * 7, "v${i}") for i in [0, 1, 1499, 2998, 2999]]
                .all(it)
        }
    }
}

/// One truncation point of the torn-tail sweep: `a`'s commit always
/// survives (`n` never truncates it); `b`'s answers either absent (a
/// torn write) or its full, correct self (nothing shorter than that).
fn torn_ok(path: string, whole: int, n: int) -> bool {
    let to = "${path}.torn"
    truncated(path, to, n)
    let p = pack_at(to, "cid")
    let a_ok = same(p.get("a"), "a", 1, 10, "first")
    let b = p.get("b")
    let b_ok = if n == whole { same(b, "b", 2, 20, "second") } else { b == null }
    a_ok && b_ok
}
