// `avra cache`'s own logic (compiler/store/explain.av): a witness
// tree over a pack plus a caller-supplied live check, and the pack's own
// shape grouped by a caller-supplied family — built directly against
// `Pack` via `pack_at`/`put`/`commit`, never through the CLI.
use @std.io.{make_dirs, exists, remove}
use compiler.store.{
    Pack,
    Entry,
    Edge,
    pack_at,
    witnessed,
    real_entries,
    summarized,
    dependents,
    family_groups,
    Held,
    FamilyCount,
    changed,
    moved_leaves,
}

fn explain_dir(name: string) -> string { "/tmp/avra-explain-test/${name}" }

fn explain_fresh(name: string) -> string {
    let _ = make_dirs(explain_dir(name))
    let path = "${explain_dir(name)}/pack.bin"
    if exists(path) { let _ = remove(path) }
    path
}

fn witness_entry(name: string, hash: int, edges: List<Edge>) -> Entry {
    Entry { name: name, fingerprint: 0, hash: hash, edges: edges, payload: "p".bytes() }
}

fn witness_edge(name: string, hash: int) -> Edge { Edge { name: name, hash: hash } }

/// No live check answers for anything: every verdict comes from the pack.
fn no_live(_name: string) -> int? { null }

/// Two names re-derive live: one still at 10, one moved to 99.
fn stub_live(name: string) -> int? {
    when {
        name == "live-held" -> 10
        name == "live-moved" -> 99
        _ -> null
    }
}

/// A name's family is its text before the first dot, when it has one.
fn stub_family(name: string) -> string? {
    when {
        name.starts_with("alpha.") -> "alpha"
        name.starts_with("beta.") -> "beta"
        _ -> null
    }
}

fn entries_of(families: List<FamilyCount>, family: string) -> int {
    [f.entries for f in families if f.family == family].first() ?? 0
}

spec "compiler/store/explain — the witness tree" {
    given "an edge whose target's stored hash still matches" {
        then "it holds" {
            let p = pack_at(explain_fresh("holds"), "cid")
            p.put(witness_entry("b", 10, []))
            witnessed(p, "b", 10, ["a"], no_live).held == Held.Matches
        }
    }
    given "an edge whose target's stored hash has moved on" {
        then "it is stale, and names both hashes" {
            let p = pack_at(explain_fresh("stale"), "cid")
            p.put(witness_entry("b", 20, []))
            let w = witnessed(p, "b", 10, ["a"], no_live)
            w.held == Held.Stale && w.found_hash == 20 && w.recorded_hash == 10
        }
    }
    given "an edge naming nothing the pack stores and nothing can re-derive" {
        then "it is external, not a failure" {
            let p = pack_at(explain_fresh("external"), "cid")
            witnessed(p, "ghost", 5, ["a"], no_live).held == Held.External
        }
    }
    given "an edge re-entering a name already on the path" {
        then "a cycle is named, never looped forever" {
            let p = pack_at(explain_fresh("cycle"), "cid")
            p.put(witness_entry("a", 1, [witness_edge("b", 2)]))
            p.put(witness_entry("b", 2, [witness_edge("a", 1)]))
            let w = witnessed(p, "b", 2, ["a"], no_live)
            w.held == Held.Matches && w.children.length == 1 && w.children[0].held == Held.Cycle
        }
    }
    given "an entry with real, held and stale dependencies together" {
        then "the tree carries every child, each judged on its own" {
            let p = pack_at(explain_fresh("mixed"), "cid")
            p.put(witness_entry("held", 1, []))
            p.put(witness_entry("stale", 99, []))
            p
                .put(
                    witness_entry(
                        "root",
                        0,
                        [
                            witness_edge("held", 1),
                            witness_edge("stale", 2),
                            witness_edge("ghost", 3),
                        ],
                    ),
                )
            let root? = p.get("root") else { return false }
            let kids = [witnessed(p, e.name, e.hash, ["root"], no_live) for e in root.edges]
            kids[0].held == Held.Matches &&
                kids[1].held == Held.Stale &&
                kids[2].held == Held.External
        }
    }
    given "an edge a live check can re-derive" {
        then "a live hash equal to the recorded one holds, and is the hash found" {
            let p = pack_at(explain_fresh("live-holds"), "cid")
            let w = witnessed(p, "live-held", 10, ["root"], stub_live)
            w.held == Held.Matches && w.found_hash == 10 && w.children.length == 0
        }
        then "a live hash that moved is stale, naming the recorded and the live hash" {
            let p = pack_at(explain_fresh("live-moves"), "cid")
            let w = witnessed(p, "live-moved", 10, ["root"], stub_live)
            w.held == Held.Stale && w.recorded_hash == 10 && w.found_hash == 99
        }
        then "the live answer decides over a stored entry that disagrees" {
            let p = pack_at(explain_fresh("live-wins"), "cid")
            p.put(witness_entry("live-held", 555, []))
            witnessed(p, "live-held", 10, ["root"], stub_live).held == Held.Matches
        }
    }
}

spec "compiler/store/explain — the pack's own shape" {
    given "a pack holding two entries, one of them naming a third name only as an edge" {
        then "real_entries counts only what was `put`, never an edge-only name" {
            let p = pack_at(explain_fresh("real-entries"), "cid")
            p.put(witness_entry("a", 1, [witness_edge("never-put", 9)]))
            p.put(witness_entry("b", 2, []))
            real_entries(p).length == 2
        }
        then "summarized reports the same count, plus the referenced-only name" {
            let p = pack_at(explain_fresh("summary-counts"), "cid")
            p.put(witness_entry("a", 1, [witness_edge("never-put", 9)]))
            p.put(witness_entry("b", 2, []))
            let s = summarized(p, stub_family)
            s.entries == 2 && s.referenced_only == 1
        }
    }
    given "a pack before and after its first commit" {
        then "nothing is on disk until commit answers true" {
            let p = pack_at(explain_fresh("uncommitted"), "cid")
            p.put(witness_entry("a", 1, []))
            summarized(p, stub_family).disk_bytes == 0
        }
        then "committing writes real bytes, and a fresh pack is no bigger than what is on disk" {
            let p = pack_at(explain_fresh("committed"), "cid")
            p.put(witness_entry("a", 1, []))
            let ok = p.commit()
            let s = summarized(p, stub_family)
            ok && s.disk_bytes > 0 && s.live_bytes <= s.disk_bytes
        }
    }
    given "entries and referenced-only names spread over two families and some no family claims" {
        then "each family counts its own entries, in the order the pack first met them" {
            let p = pack_at(explain_fresh("by-family"), "cid")
            p
                .put(
                    witness_entry(
                        "alpha.x",
                        1,
                        [witness_edge("beta.dep", 5), witness_edge("loose-dep", 6)],
                    ),
                )
            p.put(witness_entry("alpha.y", 2, []))
            p.put(witness_entry("beta.z", 3, []))
            p.put(witness_entry("loose", 4, []))
            let s = summarized(p, stub_family)
            [f.family for f in s.families].join(",") == "alpha,beta,(other)" &&
                entries_of(s.families, "alpha") == 2 &&
                entries_of(s.families, "beta") == 1 &&
                entries_of(s.families, "(other)") == 1
        }
        then "the payload bytes are summed per family, not shared out" {
            let p = pack_at(explain_fresh("by-family-bytes"), "cid")
            p.put(witness_entry("alpha.x", 1, []))
            p.put(witness_entry("alpha.y", 2, []))
            p.put(witness_entry("beta.z", 3, []))
            let s = summarized(p, stub_family)
            ["${f.payload_bytes}" for f in s.families].join(",") == "2,1"
        }
        then "names only ever referenced are grouped by family too" {
            let p = pack_at(explain_fresh("referenced-by-family"), "cid")
            p
                .put(
                    witness_entry(
                        "alpha.x",
                        1,
                        [
                            witness_edge("beta.dep", 5),
                            witness_edge("beta.dep2", 6),
                            witness_edge("loose-dep", 7),
                        ],
                    ),
                )
            let s = summarized(p, stub_family)
            ["${r.family}=${r.names}" for r in s.referenced].join(",") == "beta=2,(other)=1"
        }
    }
}

spec "compiler/store/explain — what depends on a name" {
    given "entries leaning on a name directly and through another entry" {
        then "both are listed, nearest first, and an entry leaning on something else is not" {
            let p = pack_at(explain_fresh("dependents-chain"), "cid")
            p.put(witness_entry("mid", 1, [witness_edge("base", 5)]))
            p.put(witness_entry("top", 2, [witness_edge("mid", 1)]))
            p.put(witness_entry("apart", 3, [witness_edge("elsewhere", 9)]))
            [e.name for e in dependents(p, "base")].join(",") == "mid,top"
        }
    }
    given "two entries that both lean on the name, and one leaning on both of them" {
        then "the shared dependent is listed once" {
            let p = pack_at(explain_fresh("dependents-diamond"), "cid")
            p.put(witness_entry("left", 1, [witness_edge("base", 5)]))
            p.put(witness_entry("right", 2, [witness_edge("base", 5)]))
            p.put(witness_entry("top", 3, [witness_edge("left", 1), witness_edge("right", 2)]))
            [e.name for e in dependents(p, "base")].join(",") == "left,right,top"
        }
    }
    given "a name nothing leans on" {
        then "it has no dependents, whether or not the pack knows it" {
            let p = pack_at(explain_fresh("dependents-none"), "cid")
            p.put(witness_entry("base", 1, [witness_edge("input", 5)]))
            dependents(p, "base").is_empty() && dependents(p, "never-heard-of").is_empty()
        }
    }
    given "two entries that lean on each other" {
        then "the walk ends, each listed once" {
            let p = pack_at(explain_fresh("dependents-cycle"), "cid")
            p.put(witness_entry("a", 1, [witness_edge("b", 2)]))
            p.put(witness_entry("b", 2, [witness_edge("a", 1)]))
            [e.name for e in dependents(p, "a")].join(",") == "b,a"
        }
    }
    given "names of several families and some no family claims" {
        then "family_groups files each name under its family, in first-seen order" {
            let gs = family_groups(["alpha.x", "beta.z", "alpha.y", "loose"], stub_family)
            ["${g.family}=${g.names.join("+")}" for g in gs].join(";") == "alpha=alpha.x+alpha.y;beta=beta.z;(other)=loose"
        }
    }
}

spec "compiler/store/explain — what changed under an entry" {
    given "an entry whose every edge still matches" {
        then "nothing moved" {
            let p = pack_at(explain_fresh("changed_none"), "cid")
            p.put(witness_entry("b", 10, []))
            p.put(witness_entry("root", 0, [witness_edge("b", 10)]))
            changed(p, "root", [], no_live).is_empty()
        }
    }
    given "an input that moved under a row that moved because of it" {
        then "the chain names the row, and the leaf is the input" {
            let p = pack_at(explain_fresh("changed_chain"), "cid")
            p.put(witness_entry("src", 7, []))
            p.put(witness_entry("mid", 20, [witness_edge("src", 5)]))
            p.put(witness_entry("root", 0, [witness_edge("mid", 10)]))
            let found = changed(p, "root", [], no_live)
            let leaves = moved_leaves(found)
            found.length == 1 &&
                found[0].name == "mid" &&
                found[0].recorded_hash == 10 &&
                found[0].found_hash == 20 &&
                leaves.length == 1 &&
                leaves[0].name == "src" &&
                leaves[0].recorded_hash == 5 &&
                leaves[0].found_hash == 7
        }
    }
    given "a row that moved while its own edges all match" {
        then "the row itself is the leaf" {
            let p = pack_at(explain_fresh("changed_self"), "cid")
            p.put(witness_entry("src", 7, []))
            p.put(witness_entry("mid", 20, [witness_edge("src", 7)]))
            p.put(witness_entry("root", 0, [witness_edge("mid", 10)]))
            let leaves = moved_leaves(changed(p, "root", [], no_live))
            leaves.length == 1 && leaves[0].name == "mid"
        }
    }
    given "an edge a live check re-derives" {
        then "the live hash is what it is judged by" {
            let p = pack_at(explain_fresh("changed_live"), "cid")
            p
                .put(
                    witness_entry(
                        "root",
                        0,
                        [witness_edge("live-moved", 10), witness_edge("live-held", 10)],
                    ),
                )
            let found = changed(p, "root", [], stub_live)
            found.length == 1 && found[0].name == "live-moved" && found[0].found_hash == 99
        }
    }
    given "rows that name each other" {
        then "a name already on the path is not followed again" {
            let p = pack_at(explain_fresh("changed_cycle"), "cid")
            p.put(witness_entry("a", 2, [witness_edge("b", 1)]))
            p.put(witness_entry("b", 2, [witness_edge("a", 1)]))
            p.put(witness_entry("root", 0, [witness_edge("a", 1)]))
            let found = changed(p, "root", [], no_live)
            found.length == 1 && found[0].under.length == 1 && found[0].under[0].under.is_empty()
        }
    }
}
