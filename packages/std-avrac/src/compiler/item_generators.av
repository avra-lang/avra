//! A GENERATOR ON THE PROGRAM LAYER: the `static fn derive` a trait's own body writes, or a declaring
//! annotation's own fn, lowered with every body it reaches into a program the evaluator runs over a
//! declaration's meta value: a `Type` for a derive, a `Fn` for an annotation.
use core.{Annotation, SignedType, SyntaxArena, flatten}
use features.{
    Budgets,
    MetaHeap,
    MetaVal,
    arg_lit,
    meta_of_fn,
    meta_of_type,
    new_meta_heap,
    unsettled_label,
}
use @std.meta.{Diagnostic, Directive, derive}
use @std.program.address.{SourceFileAddress}
use @std.program.answer_record.{ContentHash, content_hash}
use @std.program.query_engine.{QueryDefinition, QueryEngine}
use @std.program.saved_derive.{Saved}
use @std.program.saved_query.{ListedQuery, definitions_of, query, query_definition}
use @std.relation.engine.{map_cell}
use compiler.lower.{Lowered}
use compiler.backend.{body_lines, run_lifted, static_block}

/// What a trait's generator is named in its own body.
const GENERATOR: string = "derive"

/// A generator: the fn that writes declarations, the file declaring it, the name it goes by there,
/// and what it's handed.
@derive(Saved)
export type GeneratorAt = { file: SourceFileAddress, name: string, kind: GeneratorKind }

/// Which fn a generator is, and so what it's handed and what it's named by.
@derive(Saved)
export enum GeneratorKind {
    /// A trait's own `static fn derive`, `name` the trait's: handed the `Type` a `@derive` naming the
    /// trait stands on.
    Derive
    /// A declaring annotation's own fn: handed the `Fn` the annotation stands on.
    Annotation
}

impl GeneratorAt {
    /// The unit the generator's body is lowered as in its file.
    fn unit() -> string {
        match self.kind { .Derive -> "${self.name}.${GENERATOR}", .Annotation -> self.name }
    }
}

/// The generator `g`'s body, signed; absent when it writes none.
fn generator_body(engine: QueryEngine, g: GeneratorAt) -> SignedBody? {
    match g.kind {
        .Derive -> trait_generator(engine, TraitAt { file: g.file, name: g.name }),
        .Annotation -> signed_body(engine, g.file, g.name),
    }
}

/// The trait `t`'s own static `derive`, its body signed with no `Self`; absent when it writes none
/// with a body.
fn trait_generator(engine: QueryEngine, t: TraitAt) -> SignedBody? {
    let item? = declaring_item(engine, t.file, t.name, ItemKind.Trait) else { return null }
    let fns = [p!.fns for s in item.stmts for p in [item.store.trait_parts(s)] if p != null].first() ?? []
    let s? = fns
        .find(
            (f) -> item.store.fn_parts(f)?.name == GENERATOR &&
                item.store.is_static(f) &&
                written_body(item, f),
        ) else { return null }
    let written = written_fn(item.store, [s], GENERATOR)!
    SignedBody {
        signature: written_signature(
            Signing {
                engine: engine,
                file: t.file,
                type_params: written.type_params,
                writer: written.writer,
            },
            written,
        ),
        item: item,
        body: item.store.fn_parts(s)!.body,
        stmt: s,
    }
}

/// The symbol a generator runs as.
export fn generator_symbol(g: GeneratorAt) -> string { declared_symbol(g.file, g.unit()) }

/// The generator `g` and every body it reaches, made into a program whose entry is the generator
/// itself, its seat the meta value; with `missed`, each body it reaches that isn't lowered yet filed
/// there. Absent when it writes no body.
export fn made_generator(engine: QueryEngine, g: GeneratorAt, missed: Cell<List<Missed>>? = null) -> MadeProgram? {
    let signed? = generator_body(engine, g) else { return null }
    let root = lowered_signed(engine, g.file, signed, g.unit(), null)
    if !root.whole() { return MadeProgram.Unmade(root.missing[0], "the generator") }
    made_reaching(engine, root, generator_symbol(g), root.params, missed)
}

/// What a trait's generator is: the hash of the program made of it, printed, or why it isn't made.
@derive(Saved)
export type GeneratorPrint = { print: ContentHash?, unmade: string }

/// The generator `g` as the content of the program made of it: the hash of its printed IR, the
/// program kept for this process under that hash.
@query
export fn generator_print(engine: QueryEngine, g: GeneratorAt) -> GeneratorPrint {
    let m? = made_generator(engine, g) else { return GeneratorPrint { print: null, unmade: "`${g.name}` writes no generator" } }
    match m {
        .Made(l) -> GeneratorPrint { print: kept_program(l), unmade: "" },
        .Unmade(why, at) -> GeneratorPrint {
            print: null,
            unmade: "`${g.name}`'s generator isn't made yet: ${why} at ${at}",
        },
    }
}

/// The program the generator `g` is made of, by the hash its print answered: the one this process
/// keeps under it, or made again; absent when made again it prints otherwise.
fn generator_program(engine: QueryEngine, g: GeneratorAt, print: ContentHash) -> Lowered? {
    let kept = made_programs().get().get(print_key(print))
    if kept != null { return kept }
    let m? = made_generator(engine, g) else { return null }
    match m {
        .Made(l) -> if kept_program(l).same_as(print) { l } else { null },
        .Unmade(_, _) -> null,
    }
}

/// The hash of a made program's printed IR, the program kept under it for this process.
fn kept_program(l: Lowered) -> ContentHash {
    let print = content_hash(printed_program(l).bytes())
    made_programs().put(print_key(print), l)
    print
}

/// A made program as text: its entry's and each body's name, the layouts of its seats and its
/// answer, and its instructions; then its statics.
fn printed_program(l: Lowered) -> string {
    flatten(
        [[
            "fn ${b.name}(${[s.spelled() for s in b.seats].join(", ")}) -> ${b.answer?.spelled() ?? "void"}",
        ]
            .concat(body_lines(b.ins)) for b in [l.entry].concat(l.fns)],
    )
        .concat(flatten([static_block(s) for s in l.statics]))
        .join("\n")
}

/// The programs this process has made generators into, by their print.
once fn made_programs() -> Cell<Map<string, Lowered>> { map_cell() }

fn print_key(print: ContentHash) -> string { "${print.high_word}:${print.low_word}" }

/// What a generator made over one declaration: the directives it answered and what it said about
/// the declaration, or why it didn't run.
export enum GeneratorRun {
    Ran(made: List<Directive>, problems: List<Diagnostic>)
    Stopped(why: string)
}

/// The made generator `l` of `g` run under `budgets` over the declaration `file` writes as `name`,
/// handed that declaration as its kind takes it and answering `type_named` from `file`.
export fn generator_run(
    engine: QueryEngine,
    l: Lowered,
    g: GeneratorAt,
    file: SourceFileAddress,
    name: string,
    budgets: Budgets,
) -> GeneratorRun {
    mut heap = new_meta_heap()
    let arg? = meta_handed(engine, g.kind, file, name, heap) else { return GeneratorRun.Stopped(not_handed(g.kind, name)) }
    match run_lifted(
        l,
        generator_symbol(g),
        [arg],
        heap,
        budgets,
        (n: string) -> named_lifted(engine, file, n),
    ) {
        .Ok(lifted) -> GeneratorRun.Ran(lifted.declared_made(), lifted.declared_problems()),
        .Err(why) -> GeneratorRun.Stopped(unsettled_label(g.name, why)),
    }
}

/// The declaration `file` writes as `name`, as the meta value a generator of `kind` is handed, laid
/// out in `heap`; absent when it declares nothing of that kind.
fn meta_handed(
    engine: QueryEngine,
    kind: GeneratorKind,
    file: SourceFileAddress,
    name: string,
    mut heap: MetaHeap,
) -> MetaVal? {
    match kind {
        .Derive -> {
            let t? = meta_of_decl(engine, file, name) else { return null }
            meta_of_type(t, heap)
        },
        .Annotation -> {
            let f? = meta_of_fn_decl(engine, file, name) else { return null }
            meta_of_fn(f, fn_slots(engine), heap)
        },
    }
}

/// How many fields `@std/meta`'s `Fn` declares: the slots a crossed `Fn` is written with.
fn fn_slots(engine: QueryEngine) -> int {
    let d? = declarations_of(engine, META, [], false, META_FN).find(it.kind == ItemKind.Record) else { return 0 }
    let sig? = record_signature(engine, d.file, d.name) else { return 0 }
    sig.fields.length
}

/// A declaration a generator runs over: the name its file declares it as, the item declaring it, and
/// the generator.
export type GeneratorSite = { name: string, item: int, generator: GeneratorAt }

/// Each generator a file's declarations name, in the order written: each trait a `@derive` names,
/// and each declaring annotation a fn wears.
export fn generator_sites(engine: QueryEngine, file: SourceFileAddress) -> List<GeneratorSite> {
    let scope? = file_scope(engine, file) else { return [] }
    flatten([declared_sites(engine, scope, file, d) for d in file_declares(engine, file).names])
}

/// Each generator the declaration `d` names.
export fn declaration_sites(engine: QueryEngine, file: SourceFileAddress, d: DeclaredName) -> List<
    GeneratorSite,
> {
    let scope? = file_scope(engine, file) else { return [] }
    declared_sites(engine, scope, file, d)
}

fn declared_sites(engine: QueryEngine, scope: FileScope, file: SourceFileAddress, d: DeclaredName) -> List<
    GeneratorSite,
> {
    let item = read_item(engine, file, d.item)
    let s? = item.stmts.find((x) -> item.store.declared_name(x) == d.name) else { return [] }
    flatten(
        [annotation_sites(engine, scope, file, d, item.store, a) for a in item.store.annotations_of(s)],
    )
}

/// The generators one annotation on `d` names, its name read among written names alone: each trait
/// a `@derive` names, or the annotation's own fn where it declares over a fn.
fn annotation_sites(
    engine: QueryEngine,
    scope: FileScope,
    file: SourceFileAddress,
    d: DeclaredName,
    store: SyntaxArena,
    a: Annotation,
) -> List<GeneratorSite> {
    let named? = resolved_in(engine, scope, file, Space.Value, a.name).named() else { return [] }
    if named.file.package_name == META && named.name == DERIVE {
        return [GeneratorSite {
            name: d.name,
            item: d.item,
            generator: GeneratorAt { file: t!.file, name: t!.name, kind: GeneratorKind.Derive },
        } for e in a.args for t in [trait_named(engine, scope, file, arg_lit(store, e).text)] if t != null]
    }
    if d.kind != ItemKind.Fn ||
        named.kind != ItemKind.Fn ||
        !declares_over_fn(engine, named.file, named.name) { return [] }
    [
        GeneratorSite {
            name: d.name,
            item: d.item,
            generator: GeneratorAt { file: named.file, name: named.name, kind: GeneratorKind.Annotation },
        },
    ]
}

/// Whether the fn `file` declares as `name` is a declaring annotation over a fn: its first seat takes
/// `@std/meta`'s `Fn` and it answers `Declared`.
export fn declares_over_fn(engine: QueryEngine, file: SourceFileAddress, name: string) -> bool {
    let sig? = fn_signature(engine, file, name) else { return false }
    let first? = sig.params.first()?.ty else { return false }
    meta_named(first, META_FN) && meta_named(sig.answer, DECLARED)
}

/// Whether `ty` is `@std/meta`'s `name`, present.
fn meta_named(ty: SignedType, name: string) -> bool {
    if ty.nulls > 0 { return false }
    match ty.head { .Declared(file, n) -> file.package_name == META && n == name, _ -> false }
}

/// The trait `name` names from `file`, absent for a name naming none.
fn trait_named(engine: QueryEngine, scope: FileScope, file: SourceFileAddress, name: string) -> TraitAt? {
    let d? = resolved_in(engine, scope, file, Space.Type, name).named() else { return null }
    if d.kind == ItemKind.Trait { TraitAt { file: d.file, name: d.name } } else { null }
}

/// The annotation naming the traits whose generators run over a declaration.
const DERIVE: string = "derive"

/// The record a declaring annotation's first seat takes.
const META_FN: string = "Fn"

/// What a declaring annotation answers.
const DECLARED: string = "Declared"

collect listed_generator_facts: List<ListedQuery> = @query_definition in self as ListedQuery { definition: it } by it.name

/// The queries a trait's generator is printed through, for a process to hand its engine.
export fn generator_fact_definitions() -> List<QueryDefinition> { definitions_of(listed_generator_facts) }

fn not_handed(kind: GeneratorKind, name: string) -> string {
    match kind {
        .Derive -> "`${name}` declares no type with fields, variants or a shape",
        .Annotation -> "`${name}` declares no fn",
    }
}
