//! THE KERNEL FAMILIES THAT STAND ON A SAVED ANSWER. A family named here has its answers kept
//! as rows of `Stored.Answer` — value, hash, and the reads it stood on as (name, digest) — by
//! its relation's `keeper`, and a key this process never settled is looked up by `saved_find`,
//! which hands the kernel the answer's reads as keys. The kernel demands each one and compares
//! its hash; the value is read back by `revive` only when something reads it.
//!
//! A read is named by its input: `text <path>`. An answer standing on any other read is not kept.
use @std.text.{parse_int}
use core.{joined}
use compiler.families.{Family}
use compiler.host.{InputName}
use compiler.store.{Stored, Reading, node_key, read_spelled}
use @std.relation.engine.{Key, Saved, SavedRead, Revival}

/// The families kept as saved answers.
const KEPT: List<Family> = [Family.ComponentNames]

impl Workspace {
    /// The kernel's saved lookup and each kept family's hooks, set once at the workspace's making.
    fn arm_saved() {
        self.db.kernel.set_saved((key: Key) -> self.saved_find(key))
        for f in KEPT {
            let rel = self.relation(f)
            rel.revive.set((arg: int) -> self.saved_revived(f, arg))
            rel.keeper.set((arg: int, value: DbRow) -> self.saved_kept(f, arg, value))
        }
    }

    /// The row a kept family's answer at `arg` is filed under: its family and its input's key.
    fn saved_row(f: Family, arg: int) -> string? {
        let at = self.input_names.get()
        if arg < 0 || arg >= at.length { return null }
        node_key(Stored.Answer, [f.name, at[arg].key])
    }

    /// The saved answer at `key`, its reads as keys — each input read named is staged through
    /// the door first, so its cell stands and carries the hash it has now.
    fn saved_find(key: Key) -> Saved? {
        let f? = KEPT.find(it.ordinal == key.family) else { return null }
        let store? = self.store.get() else { return null }
        let row? = self.saved_row(f, key.arg) else { return null }
        let bytes? = store.get(Stored.Answer, row) else { return null }
        let lines = store.reads_of(Stored.Answer, row) ?? []
        let reads = [r for l in lines for r in [self.saved_read(l)]]
        if reads.any(it == null) { return null }
        let hash? = parse_int(bytes.split("\n")[0]) else { return null }
        Saved { reads: [r! for r in reads], value_hash: hash }
    }

    /// One read a row names, as a key and the digest it stood at: absent for a name this
    /// process cannot stage.
    fn saved_read(line: string) -> SavedRead? {
        let r? = read_spelled(line) else { return null }
        let digest? = parse_int(r.digest) else { return null }
        if !r.name.starts_with("text ") { return null }
        let name = InputName { kind: .Text, key: r.name.substring(5, r.name.length) }
        let _ = self.input(name)
        SavedRead {
            key: Key { family: Family.Input.ordinal, arg: self.world_key(name) },
            digest: digest,
        }
    }

    /// The value of a kept family's saved answer.
    fn saved_revived(f: Family, arg: int) -> Revival<DbRow> {
        let store? = self.store.get() else { return Revival.Gone }
        let row? = self.saved_row(f, arg) else { return Revival.Gone }
        let bytes? = store.get(Stored.Answer, row) else { return Revival.Gone }
        let lines = bytes.split("\n")
        Revival.Revived(DbRow.Words(lines.drop(1)))
    }

    /// A kept family's answer settled this run, filed with the reads it stood on.
    fn saved_kept(f: Family, arg: int, value: DbRow) -> bool {
        let store? = self.store.get() else { return false }
        let row? = self.saved_row(f, arg) else { return false }
        let k = Key { family: f.ordinal, arg: arg }
        let reads? = self.db.kernel.saved_reads(k) else { return false }
        let hash? = self.db.kernel.hash_forced(k) else { return false }
        let named = [self.saved_reading(r) for r in reads]
        if named.any(it == null) { return false }
        let words = scan_words(value)
        store
            .keep_reading(Stored.Answer, row, joined(["${hash}"].concat(words), "\n"), [n! for n in named])
    }

    /// A read as a row spells it: an input by its name and the digest its cell holds.
    fn saved_reading(r: SavedRead) -> Reading? {
        if r.key.family != Family.Input.ordinal { return null }
        let at = self.input_names.get()
        if r.key.arg < 0 || r.key.arg >= at.length { return null }
        let name = at[r.key.arg]
        match name.kind {
            .Text -> Reading { name: "text ${name.key}", digest: "${r.digest}" },
            rest -> null,
        }
    }
}
