//! A LOWERED UNIT SAVED BY DECLARATION: a plain fn's or method's lowering is saved as the
//! instantiations it asks and the code facts it hashes, under its symbol. A saved unit stands
//! in for its lowering exactly when it spoke nothing, so serving one can never hide a voice.
use core.{DeclKind, FileId, flatten, distinct, joined}
use features.{Wanted}
use diagnostics.{no_voices}
use compiler.lower.{Unit, CodeFacts, code_facts, code_facts_wire, code_facts_from_wire}

/// A unit served from its saved row: the file it belongs to and the code it stood for.
type Served = { file: FileId, facts: CodeFacts }

impl Workspace {
    /// A unit as its saved row's text: the instantiations it asks, then the code facts it hashes.
    /// Absent for a unit no row can stand for: one that spoke, or is not a plain declaration's.
    fn unit_text(w: Wanted, out: Unit) -> string? {
        if !out.voices.list.is_empty() || !self.unit_saved(w) { return null }
        let facts = code_facts(self.decls, out.bodies, out.statics, out.hashes)
        fields_wire([self.wanted_list_wire(out.wants), code_facts_wire(facts)])
    }

    /// The unit a saved row stands for, its body the declaration's stub: the code is the store's.
    fn unit_from_text(w: Wanted, text: string) -> Unit? {
        if !self.unit_saved(w) { return null }
        mut r = wire_reader(text)
        let parts? = r.fields() else { return null }
        if parts.length != 2 { return null }
        let wants? = self.wanted_list_from_wire(parts[0]) else { return null }
        let facts? = code_facts_from_wire(parts[1]) else { return null }
        let stub? = self.stub_of(self.decls.decl(w.decl!)) else { return null }
        self.hold.served.push(Served { file: w.file, facts: facts })
        Unit { bodies: [stub], wants: wants, voices: no_voices(), statics: [], kept: [facts] }
    }

    /// Whether a unit is a plain declaration's own lowering: no specialization, no seats, no
    /// expression root, no compile-time run lowering, a body this program reads.
    fn unit_saved(w: Wanted) -> bool {
        let d? = w.decl else { return false }
        if w.sub != null || !w.seats.is_empty() || w.root != null || self.comptime_active() { return false }
        let x = self.decls.decl(d)
        plain_unit(x.kind) && !x.external && !self.is_held(x.file)
    }
}

/// Whether a declaration kind lowers as one plain unit a row can stand for.
fn plain_unit(k: DeclKind) -> bool {
    match k {
        .Fn or .Method -> true,
        .Builtin or .Record or .Named or .Alias or .Enum or .Trait or .Syntax or .Default or .Impl or .Main or .Case or .Const or .Collect or .CollectEnum or .State -> false,
    }
}

/// A file's code: what its fresh bodies are and what each served unit stood for.
fn merged_facts(fresh: CodeFacts, served: List<CodeFacts>) -> CodeFacts {
    CodeFacts {
        nodes: fresh.nodes.concat(flatten([f.nodes for f in served])),
        addressed: distinct(fresh.addressed.concat(flatten([f.addressed for f in served]))),
        asked: distinct(fresh.asked.concat(flatten([f.asked for f in served]))),
    }
}
