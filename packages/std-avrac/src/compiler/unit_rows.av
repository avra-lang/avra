//! A LOWERED UNIT KEPT BY DECLARATION. A plain fn's or method's lowering is kept as
//! the instantiations it asks and the code facts it hashes, under its own name, its
//! own syntax and the surface its file shows it. A kept unit stands in for its
//! lowering exactly when it spoke nothing, so serving one can never hide a voice.
use core.{DeclId, DeclKind, FileId, flatten, distinct, fp, fp_str, fp_list, joined}
use features.{Wanted}
use diagnostics.{no_voices}
use compiler.store.{Store, Stored, node_key}
use compiler.lower.{Unit, CodeFacts, code_facts, code_facts_wire, code_facts_from_wire}

/// A unit served from its kept row: the file it belongs to and the code it stood for.
type Served = { file: FileId, facts: CodeFacts }

/// A kept lowering: the unit's name and syntax, the instantiations it asked for and
/// the code facts it hashed, each as the wire that keeps it.
type UnitRow = { key: string, wants: string, facts: string }

impl Workspace {
    /// The unit a kept row stands for, when this derivation may be served one: it
    /// links nothing, it holds files (a cold one has no row to find), no compile-time
    /// run is lowering, and the row's inputs stand.
    fn unit_served(w: Wanted) -> Unit? {
        if !self.hold.serving.get() || !self.hold.warm.get() { return null }
        let s? = self.store.get() else { return null }
        let at? = self.row_place(s, w) else { return null }
        let row? = self.row_file(s, at.path, at.surface).get(at.key) else { return null }
        let wants? = self.wanted_list_from_wire(row.wants) else { return null }
        let facts? = code_facts_from_wire(row.facts) else { return null }
        let stub? = self.stub_of(self.decls.decl(w.decl!)) else { return null }
        self.hold.served.push(Served { file: w.file, facts: facts })
        self.row_lives(at.path, row)
        Unit { bodies: [stub], wants: wants, voices: no_voices(), statics: [], kept: [facts] }
    }

    /// A unit's lowering kept as a row: only one that spoke nothing.
    fn unit_kept(w: Wanted, out: Unit) {
        if !out.voices.list.is_empty() || !self.hold.warm.get() { return }
        let s? = self.store.get() else { return }
        let at? = self.row_place(s, w) else { return }
        let facts = code_facts(self.decls, out.bodies, out.statics, out.hashes)
        self.row_lives(at.path, UnitRow { key: at.key, wants: self.wanted_list_wire(out.wants), facts: code_facts_wire(facts) })
        self.hold.rows_fresh.put(at.path, true)
    }

    /// Every file that lowered a unit afresh keeps its live rows, whole, under the
    /// surface the NEXT derivation will read — its interface records are kept by now
    /// — so a row of a declaration that moved or went is dropped.
    fn keep_unit_rows(s: Store) {
        for path, _fresh in self.hold.rows_fresh.get() {
            let surface? = self.surface_of(s, self.file_id(path)) else { continue }
            let live = self.hold.rows_live.get().get(path) ?? []
            let _ = s.keep(Stored.Unit, rows_key(path, surface), "R1" + fields_wire(flatten([[r.key, r.wants, r.facts] for r in live])), [])
        }
    }

    /// WHAT A ROW IS A FUNCTION OF: the declaration and its own syntax, under what its
    /// file shows it — every sibling's surface, the file's runs and gathers, and the
    /// interface of every module it sees. Absent for a unit no row stands for.
    fn row_place(s: Store, w: Wanted) -> RowPlace? {
        let d? = w.decl else { return null }
        if w.sub != null || !w.seats.is_empty() || w.root != null || self.comptime_active() { return null }
        let x = self.decls.decl(d)
        if !plain_unit(x.kind) || x.external || self.is_held(x.file) { return null }
        let surface? = self.unit_surface(s, x.file) else { return null }
        RowPlace { path: self.decls.file(x.file).path, surface: surface, key: "${self.decl_ref(d)}\t${self.syntax(d)}" }
    }

    /// A file's kept rows by key, read once for the derivation.
    fn row_file(s: Store, path: string, surface: string) -> Map<string, UnitRow> {
        let known = self.hold.rows.get().get(path)
        if known != null { return known! }
        let made = rows_of(s.get(Stored.Unit, rows_key(path, surface)) ?? "")
        self.hold.rows.put(path, made)
        made
    }

    /// A row of this derivation's file, live.
    fn row_lives(path: string, row: UnitRow) {
        self.hold.rows_live.put(path, (self.hold.rows_live.get().get(path) ?? []).concat([row]))
    }

    /// A file's surface, remembered for the derivation.
    fn unit_surface(s: Store, f: FileId) -> string? {
        let path = self.decls.file(f).path
        let known = self.hold.surfaces.get().get(path)
        if known != null { return if known! == "" { null } else { known } }
        let made = self.surface_of(s, f)
        self.hold.surfaces.put(path, made ?? "")
        made
    }

    /// What a body of file `f` can see of it. A key still opening a pending read
    /// shows nothing.
    fn surface_of(s: Store, f: FileId) -> string? {
        let path = self.decls.file(f).path
        let parts = self.key_parts_cached(s, self.module_path_of(path), path)
        if parts.runs.any(it.starts_with("?")) { return null }
        let decls = [self.surface_fp(d) for d in self.decls.decls_of_file(f)]
        "${fp(314, [fp_list(decls), fp_list(self.use_fps(f)), fp_str(joined(parts.runs, ",")), fp_str(joined(parts.gathered, ",")), fp_str(seen_digest(parts.seen))])}"
    }

    /// One declaration as its siblings see it: its record shape, and its syntax too
    /// unless it is a plain body, which a unit answers for.
    fn surface_fp(d: DeclId) -> int {
        let x = self.decls.decl(d)
        fp(315, [fp_str(self.decl_ref(d)), fp_str(self.record_shape(x)), if plain_unit(x.kind) { 0 } else { self.syntax(d) }])
    }
}

/// A unit's place among its file's rows: the file, what the file shows, the row's key.
type RowPlace = { path: string, surface: string, key: string }

/// Where a file's rows live, under what its file shows.
fn rows_key(path: string, surface: string) -> string { node_key(Stored.Unit, ["unit-rows", path, surface]) }

/// A file's rows as the store keeps them; none for text no `keep_unit_rows` wrote.
fn rows_of(raw: string) -> Map<string, UnitRow> {
    mut out: Map<string, UnitRow> = {}
    if !raw.starts_with("R1") { return out }
    mut r = wire_reader(raw)
    let fields? = r.fields() else { return out }
    if fields.length % 3 != 0 { return out }
    for i in 0..fields.length / 3 {
        out.set(fields[3 * i], UnitRow { key: fields[3 * i], wants: fields[3 * i + 1], facts: fields[3 * i + 2] })
    }
    out
}

/// Whether a declaration kind lowers as one plain unit a row can stand for.
fn plain_unit(k: DeclKind) -> bool {
    match k {
        .Fn or .Method -> true,
        .Builtin or .Record or .Named or .Alias or .Enum or .Trait or .Syntax or .Default or .Impl or .Main or .Case or .Const or .Collect or .CollectEnum or .State -> false,
    }
}

/// A file's code: what its fresh bodies are and what each served unit stood for.
fn merged_facts(fresh: CodeFacts, served: List<CodeFacts>) -> CodeFacts {
    CodeFacts {
        nodes: fresh.nodes.concat(flatten([f.nodes for f in served])),
        addressed: distinct(fresh.addressed.concat(flatten([f.addressed for f in served]))),
        asked: distinct(fresh.asked.concat(flatten([f.asked for f in served]))),
    }
}
