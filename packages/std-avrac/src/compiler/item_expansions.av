//! WHAT AN AVRA ITEM MEANS, by the program's own reads. An item's written tape holds what was
//! written, each instance's word known by its shape alone; its expanded tape holds the item again
//! with each instance's meaning, made by the verb a parse uses (`instances_expanded`) under each
//! component handed whole. It's keyed by the written tape's key and the content of every
//! component its instances name, so a template edit re-runs exactly the expansions of its
//! instances and reads no file again.
use core.{
    ArenaMarks,
    StmtId,
    ComponentWord,
    ExprId,
    Instanced,
    Provided,
    Stmt,
    SyntaxArena,
    distinct,
    new_node_store,
}
use features.{BlockWords, instances_expanded}
use features.components.{word_of}
use @std.meta.{derive}
use @std.program.address.{SourceFileAddress}
use @std.program.answer_record.{ContentHash, content_hash}
use @std.program.query_engine.{QueryDefinition, QueryEngine}
use @std.program.saved_derive.{Saved}
use @std.program.saved_query.{ListedQuery, definitions_of, query, query_definition}
use @std.program.source_facts.{
    PlacedTape,
    file_context,
    file_tapes,
    item_spans,
    item_tape,
    source_text,
}
use @std.program.syntax_tape.{SyntaxTape, tape_writer}

/// The components an item's instances name, as its file's words give them, each once, in the
/// order they're met.
@query
fn item_uses(engine: QueryEngine, item_text: string, context: Bytes) -> List<WordShape> {
    let store = new_node_store()
    let _ = item_read_back(
        store,
        PlacedTape { start: 0, tape: item_tape(engine, item_text, context) },
    )
    let shapes = WordShapes.from_saved_bytes(context).components
    let words = distinct(
        [w! for at in 0..store.exprs.count() for w in [store.instance_word(ExprId { index: at })] if w != null],
    )
    [s! for w in words for s in [shapes.find(it.word == w)] if s != null]
}

/// What a component means by of its own: its declaration's text, the context its file reads under,
/// the components its file declares, which its lists take alone, and the components its
/// template's instances name.
@derive(Saved)
type ComponentContent = { item_text: string, context: Bytes, declares: List<string>, uses: List<ComponentAt> }

/// A component, by its file and the name it's declared under.
@derive(Saved)
type ComponentAt = { home: SourceFileAddress, declared: string }

/// Every component a component means by, each once in the order met, itself first.
@derive(Saved)
type ComponentClosure = { contents: List<ComponentContent> }

@query
fn component_content(engine: QueryEngine, home: SourceFileAddress, declared: string) -> ComponentContent {
    let held? = declaration(engine, home, declared) else { return ComponentContent { item_text: "", context: no_context(), declares: [], uses: [] } }
    ComponentContent {
        item_text: held.item_text,
        context: held.context,
        declares: [w.shape.declared for w in file_words(engine, home).components],
        uses: [ComponentAt { home: s.home, declared: s.declared } for s in item_uses(engine, held.item_text, held.context)],
    }
}

/// A component's content and every one it means by, as one hash: components that name each other
/// are one closure, walked once.
@query
fn component_key(engine: QueryEngine, home: SourceFileAddress, declared: string) -> ContentHash {
    mut met: Map<string, bool> = {}
    mut order: List<ComponentAt> = [ComponentAt { home: home, declared: declared }]
    met.set(component_name(order[0]), true)
    mut contents: List<ComponentContent> = []
    mut at = 0
    while at < order.length {
        let content = component_content(engine, order[at].home, order[at].declared)
        contents.push(content)
        for u in content.uses {
            if !met.has(component_name(u)) {
                met.set(component_name(u), true)
                order.push(u)
            }
        }
        at = at + 1
    }
    content_hash(ComponentClosure { contents: contents }.saved_bytes())
}

fn component_name(c: ComponentAt) -> string { "${spelled_file(c.home)}#${c.declared}" }

/// A component's declaring item: its text, which of its file's items it is, and the context its
/// file reads under.
type Declaration = { item_text: string, item: int, context: Bytes }

fn declaration(engine: QueryEngine, home: SourceFileAddress, declared: string) -> Declaration? {
    let word? = file_words(engine, home).components.find(it.shape.declared == declared) else { return null }
    let text? = source_text(engine, home) else { return null }
    let span = item_spans(avra_columns(text), text.length)[word.item]
    Declaration {
        item_text: text.substring(span.start, span.end),
        item: word.item,
        context: file_context(engine, home),
    }
}

/// A component handed whole: its file read back as a parse reads it, each instance its declaring
/// item holds handed its own component, so a copy of the template means what it would there.
/// Absent for a word that names no declaration, or one whose template names itself.
fn component_at(engine: QueryEngine, shape: WordShape, entered: List<string>) -> ComponentWord? {
    let named = component_name(ComponentAt { home: shape.home, declared: shape.declared })
    if entered.contains(named) { return null }
    let held? = declaration(engine, shape.home, shape.declared) else { return null }
    let store = new_node_store(shape.home.path_in_package)
    let items = [item_read_back_marked(store, p) for p in file_tapes(engine, shape.home)]
    let declaring_item = items[held.item]
    let words = WordShapes.from_saved_bytes(held.context).components
    let instances = [Instanced { name: i.name, declared: i.declared } for i in file_instances(engine, shape.home)]
    for at in declaring_item.since.exprs..declaring_item.until.exprs {
        let e = ExprId { index: at }
        let word? = store.instance_word(e) else { continue }
        let nested? = words.find(it.word == word) else { continue }
        let handed? = component_at(engine, nested, entered.concat([named])) else { continue }
        store.provide(e, Provided { word: handed, instances: instances })
    }
    let declaring? = declaring_item
        .stmts
        .find((s) -> store.component_parts(s)?.name == shape.declared) else { return null }
    let whole? = word_of(store, declaring, spelled_file(shape.home)) else { return null }
    whole with { word: shape.word, own: shape.own }
}

/// One item read back, and the run of nodes it made.
type MarkedItem = { stmts: List<StmtId>, since: ArenaMarks, until: ArenaMarks }

fn item_read_back_marked(store: SyntaxArena, p: PlacedTape) -> MarkedItem {
    let since = store.marks()
    let stmts = item_read_back(store, p)
    MarkedItem { stmts: stmts, since: since, until: store.marks() }
}

/// What an item's instances mean by: the content of each component they name, and the named
/// instances its file lists.
@derive(Saved)
type ExpansionInputs = { components: List<ContentHash>, instances: List<NamedInstance> }

/// An item with its instances meaning what their components make of them: its written tape read
/// back, each instance handed its component and given its meaning, and the item written again
/// whole, so each meaning reads back right after its instance, a parse's order.
@query
fn item_expanded(engine: QueryEngine, item_text: string, context: Bytes, inputs: Bytes) -> SyntaxTape {
    let store = new_node_store()
    let stmts = item_read_back(
        store,
        PlacedTape { start: 0, tape: item_tape(engine, item_text, context) },
    )
    let listed = ExpansionInputs.from_saved_bytes(inputs).instances
    let words = BlockWords {
        components: [c! for s in item_uses(engine, item_text, context) for c in [component_at(engine, s, [])] if c != null],
        instances: [Instanced { name: i.name, declared: i.declared } for i in listed],
        door: sugar_door(avra()),
    }
    instances_expanded(
        store,
        item_text,
        words,
        ArenaMarks { exprs: 0, stmts: 0, pats: 0, params: 0 },
    )
    mut tape = tape_writer()
    tape.count(stmts.length)
    for s in stmts { Stmt.taped_id(store, tape, s) }
    SyntaxArena.tape_item_tables(store, tape)
    tape.finished()
}

/// Each item of a file read for what it means: its expanded tape where it names a component, its
/// written tape elsewhere.
@query
export fn file_meant(engine: QueryEngine, file: SourceFileAddress) -> List<PlacedTape> {
    let text? = source_text(engine, file) else { return [] }
    let context = file_context(engine, file)
    [PlacedTape {
        start: span.start,
        tape: meant_tape(engine, file, text.substring(span.start, span.end), context),
    } for span in item_spans(avra_columns(text), text.length)]
}

fn meant_tape(engine: QueryEngine, file: SourceFileAddress, item_text: string, context: Bytes) -> SyntaxTape {
    let uses = item_uses(engine, item_text, context)
    if uses.is_empty() { return item_tape(engine, item_text, context) }
    let inputs = ExpansionInputs {
        components: [component_key(engine, u.home, u.declared) for u in uses],
        instances: file_instances(engine, file),
    }
    item_expanded(engine, item_text, context, inputs.saved_bytes())
}

collect listed_expansion_facts: List<ListedQuery> = @query_definition in self as ListedQuery { definition: it } by it.name

/// The queries an item's meaning reads through, for a process to hand its engine.
export fn expansion_fact_definitions() -> List<QueryDefinition> { definitions_of(listed_expansion_facts) }
