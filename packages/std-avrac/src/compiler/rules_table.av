//! THE RULE TABLE — every rule the compiler carries, NATIVE: a
//! `rule` declares `DeclKind.Rule` (core/parts.av's `rule_parts`),
//! exactly as a `then` declares `DeclKind.Case` — but a rule's
//! `run` is a typed `fn(Code) -> Fix?` VALUE the pass calls
//! in-process, and Avra has no reflection from a declaration's
//! SYMBOL to a value of that type: nothing turns a name found by
//! walking `Decls` into something callable. So this table is the
//! VOCABULARY SEAM RULE's DATA shape (CLAUDE.md) — one row per rule,
//! like `rt_sigs()` — never a dispatch, and the row is HAND-WRITTEN
//! here for that reason alone.
//!
//! WHAT STAYS DISCOVERY, NOT HAND-KEEPING: `avra test
//! packages/std-avrac` — the one build where `self.decls` names
//! EVERY rule this compiler declares, because that IS the program
//! under test — walks them BY KIND (`rule_decls`, whole.av) and
//! REFUSES the suite when this table's name/module/root drift from
//! what is actually declared (rule_examples.av's `rules_checked`).
//! A row landed here without its declaration, or a declaration
//! landed without its row, fails loud, not silently.
use features.{Code, Fix}
use features.nullable.{if_null_ternary}
use features.lists.{last_index}
use features.structs.{index_compared}
// refusal_assembled, str_grown_quadratically, bool_of_defaulted,
// text_of_defaulted, uncounted_refusal, if_start_raw, loop_start_raw,
// scope_enter_raw, interned_int, interned_str, hand_sized_index are
// compiler/idioms.av's own — same module, no `use` needed

/// A root-kind index with no root at all: "any node", tried
/// everywhere — a struct field cannot hold `int?` (the subset
/// today), so this is the seed `root_kind_of` never answers.
export const any_root: int = -1

/// One rule: its identity (`<module>.<name>`, split), the fn the
/// pass calls, and the ROOT-KIND INDEX (`core.root_kind_of`) its
/// first arm's pattern folds to — `any_root` for a rule the index
/// cannot narrow.
export type RuleEntry = { name: string, module: string, run: fn(Code) -> Fix?, root: int }

/// `<module>.<name>` — the identity a finding's kind and `--only`
/// both read.
export fn rule_id(r: RuleEntry) -> string { "${r.module}.${r.name}" }

/// EVERY RULE, NATIVE. Adding one is a row here — `avra test
/// packages/std-avrac` refuses the suite the day it is not (or the
/// day a row here names a rule that moved or was deleted).
export fn rules_table() -> List<RuleEntry> {
    [
        RuleEntry { name: "if_null_ternary", module: "nullable", run: if_null_ternary, root: 890321331 },
        RuleEntry { name: "last_index", module: "lists", run: last_index, root: 330565557 },
        RuleEntry { name: "index_compared", module: "structs", run: index_compared, root: 872388086 },
        RuleEntry { name: "refusal_assembled", module: "compiler", run: refusal_assembled, root: any_root },
        RuleEntry { name: "str_grown_quadratically", module: "compiler", run: str_grown_quadratically, root: any_root },
        RuleEntry { name: "bool_of_defaulted", module: "compiler", run: bool_of_defaulted, root: any_root },
        RuleEntry { name: "text_of_defaulted", module: "compiler", run: text_of_defaulted, root: any_root },
        RuleEntry { name: "uncounted_refusal", module: "compiler", run: uncounted_refusal, root: any_root },
        RuleEntry { name: "if_start_raw", module: "compiler", run: if_start_raw, root: any_root },
        RuleEntry { name: "loop_start_raw", module: "compiler", run: loop_start_raw, root: any_root },
        RuleEntry { name: "scope_enter_raw", module: "compiler", run: scope_enter_raw, root: any_root },
        RuleEntry { name: "interned_int", module: "compiler", run: interned_int, root: any_root },
        RuleEntry { name: "interned_str", module: "compiler", run: interned_str, root: any_root },
        RuleEntry { name: "hand_sized_index", module: "compiler", run: hand_sized_index, root: any_root },
    ]
}

/// The rules whose root-kind index admits `kind` — the ones indexed
/// at it, plus every `any_root` rule, tried everywhere.
export fn rules_at(entries: List<RuleEntry>, kind: int) -> List<RuleEntry> {
    [r for r in entries if r.root == any_root || r.root == kind]
}
