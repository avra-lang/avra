//! THE RULE TABLE — every rule the compiler carries, as a `collect`
//! (docs/2026_09_22_COLLECTIONS.md): `rule name { arms }` is an
//! instance of `features/rule.av`'s `component rule`, and `rules`'
//! body is SYNTHESISED at lowering from every one the workspace
//! admits (compiler/lower/lower.av's `lower_collect`) — `run` the
//! instance's own `fn(Code) -> Fix?` field, `fixes`/`keeps` its
//! `@fixes`/`@keeps`-filled `List` fields, `root` the ROOT-KIND INDEX
//! `it.root_kind` folds from its arms (compiler/lower/lower.av's
//! `component_root_kind` — a general `.Component`-kind field, read
//! off the WRITTEN body rather than the built value, same as
//! `doc`/`name`/`module`/`file`). A rule is an ORDINARY declaration,
//! reached the way any other is: a feature's `mod.av` imports its own
//! `idioms.av`'s rules, and the COMPILER's own (compiler/idioms.av,
//! shapes no single feature owns) are imported here.
use features.{Code, Fix, Fixes, rule}
use compiler.{refusal_assembled, str_grown_quadratically, bool_of_defaulted, text_of_defaulted, int_of_defaulted, bits_of_defaulted, elems_of_defaulted, pairs_of_defaulted, uncounted_refusal, diagnostics_uncounted, diagnostics_length_uncounted, voices_uncounted, if_start_raw, loop_start_raw, arm_end_raw, region_end_raw, loop_cond_raw, loop_end_raw, scope_enter_raw, scope_exit_raw, interned_int, interned_str, interned_opt, interned_list, interned_map, interned_res, hand_sized_index, seen_accumulator, emit_then_error, bracket_ritual, modified_copy_literal, stmt_index_walk, raw_rt_call, raw_rt_call_void, raw_mint_emit_bin, raw_mint_emit_un, raw_mint_emit_pack, raw_mint_emit_call, raw_mint_emit_call_ptr, raw_mint_emit_const_int, raw_mint_emit_const_bool, raw_mint_emit_const_str, raw_mint_emit_load}

/// A root-kind index with no root at all: "any node", tried
/// everywhere — a struct field cannot hold `int?` (the subset
/// today), so this is the seed `root_kind_of` never answers.
export const any_root: int = -1

/// One rule: its identity (`<module>.<name>`, split), the fn the
/// pass calls, the ROOT-KIND INDEX (`core.root_kind_of`) its first
/// arm's pattern folds to — `any_root` for a rule the index cannot
/// narrow — its own `///` SENTENCE, and the examples that prove it
/// (`avra test`'s own suite reads these, never `check` —
/// compiler/rule_examples.av).
export type RuleEntry = { name: string, module: string, run: fn(Code) -> Fix?, root: int, doc: string, fixes: List<Fixes>, keeps: List<string> }

/// `<module>.<name>` — the identity a finding's kind and `--only`
/// both read.
export fn rule_id(r: RuleEntry) -> string { "${r.module}.${r.name}" }

/// EVERY RULE, in module then name order — gathered, never listed by
/// hand: a rule declared in any feature dir joins this with no edit
/// here.
export collect rules: List<RuleEntry> = rule in closure as RuleEntry { name: it.name, module: it.module, run: it.run, root: it.root_kind, doc: it.doc, fixes: it.fixes, keeps: it.keeps } by it.module, it.name

/// The rules whose root-kind index admits `kind` — the ones indexed
/// at it, plus every `any_root` rule, tried everywhere. Design §5:
/// nodes touched, never nodes × rules.
export fn rules_at(entries: List<RuleEntry>, kind: int) -> List<RuleEntry> {
    [r for r in entries if r.root == any_root || r.root == kind]
}
