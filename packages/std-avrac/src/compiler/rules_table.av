//! THE RULE TABLE — every rule the compiler carries, as a `collect`
//! (docs/2026_09_22_COLLECTIONS.md): a `rule` declares `DeclKind.Rule`
//! (core/parts.av's `rule_parts`), exactly as a `then` declares
//! `DeclKind.Case`, and `rules`' body is SYNTHESISED at lowering from
//! every one the workspace admits (compiler/lower/lower.av's
//! `lower_collect`) — `run` a typed `fn(Code) -> Fix?` VALUE the pass
//! calls in-process, `root` the ROOT-KIND INDEX `it.root_kind`
//! answers. A rule written in any feature dir is found with no edit
//! anywhere else — the keyword precedent.
use features.{Code, Fix}

/// A root-kind index with no root at all: "any node", tried
/// everywhere — a struct field cannot hold `int?` (the subset
/// today), so this is the seed `root_kind_of` never answers.
export const any_root: int = -1

/// One rule: its identity (`<module>.<name>`, split), the fn the
/// pass calls, the ROOT-KIND INDEX (`core.root_kind_of`) its first
/// arm's pattern folds to — `any_root` for a rule the index cannot
/// narrow — and its own `///` SENTENCE, its first paragraph.
export type RuleEntry = { name: string, module: string, run: fn(Code) -> Fix?, root: int, doc: string }

/// `<module>.<name>` — the identity a finding's kind and `--only`
/// both read.
export fn rule_id(r: RuleEntry) -> string { "${r.module}.${r.name}" }

/// EVERY RULE, in module then name order — gathered, never listed by
/// hand: a rule declared in any feature dir joins this with no edit
/// here.
export collect rules: List<RuleEntry> = rule in closure as RuleEntry { name: it.name, module: it.module, run: it, root: it.root_kind, doc: it.doc } by it.module, it.name

/// The rules whose root-kind index admits `kind` — the ones indexed
/// at it, plus every `any_root` rule, tried everywhere.
export fn rules_at(entries: List<RuleEntry>, kind: int) -> List<RuleEntry> {
    [r for r in entries if r.root == any_root || r.root == kind]
}
