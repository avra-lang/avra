//! A KEPT SETTLEMENT: a read file's const verdict, remembered across builds
//! beside everything it is a function of, so an edit that moves none of it
//! reuses the verdict without lowering or running its reach.
//!
//! A settlement's VALUE is a function of the bodies its run ENTERED and of the
//! consts it READ; its STRUCTURAL verdict is a function of each reached
//! unit's CALL SHAPE — what the unit asks to be lowered (calls, lifts, a dyn
//! pack's methods) and whether each body reaches the world — never of a
//! literal in a body the run never entered. Each kept line names one of those
//! and how to tell it stands: a unit by its file's key, or, when the file is
//! read, by the interfaces its module sees and its declaration's syntax —
//! or, for a unit only reached, by its call shape lowered again; a const by
//! the verdict it answers now; a file the run embedded by what it says now.
//! AND A KEPT VALUE IS LAID OUT UNDER ITS PROGRAM: a `mut` seat anywhere boxes
//! a flat record, and one store serves programs that seal differently — so a
//! verdict is kept beside the layout of every type its answer reaches, and
//! stands only in a program that lays them out alike.
use core.debug.{db_verified_files}
use core.{
    StmtId,
    ExprId,
    Type,
    TypeId,
    digest_of,
    qtrace,
    traced,
    FileId,
    DeclId,
    DeclKind,
    ModulePath,
    module_path,
    fp,
    fp_list,
    fp_str,
    distinct,
    flatten,
    joined,
    sorted_texts,
}
use features.{Unsettled, Settled, Wanted, SettleRoot, SeatValue, Budgets}
use compiler.backend.{reaches_world}
use compiler.store.{Store, Stored, node_key}
use compiler.work.{work_spell_lookup}
use compiler.lower.{Unit, type_shape_key}
use core.{Type}
use @std.relation.engine.{list_cell}

/// The reader a build's kept-read expansions dedupe under: a read reached by many
/// consts is expanded once, never once per const.
const ASK_READS_READER: string = "kept-ask-reads"

impl Workspace {
    /// A read file's const, settled: its kept verdict when everything it is a
    /// function of stands, else a settlement run, kept when it may be.
    fn const_settlement(ask: SettleAsk, s: StmtId) -> Result<Settled, Unsettled> {
        let id = "${self.settle_id(ask.file, SettleRoot.Const(s), ask.seats)}"
        let at? = self.kept_at(ask, s) else { return self.settle_run(ask, s, id, self.hold.body_asks.get().length, null) }
        let kept = self.kept_verdict(ask.file, at.key, at.layout, id)
        if traced() { qtrace("Q\tconst_verdict\t${ask.name}\t${if kept != null { "stood" } else { "ran" }}\n") }
        if kept != null { return kept! }
        let asked = self.hold.body_asks.get().length
        self.ask_kept_reads(id, at.key)
        self.settle_run(ask, s, id, asked, at)
    }

    /// Where a const's verdict is kept, and under which layout: a declared
    /// const, on no seats, whose answer carries a type.
    fn kept_at(ask: SettleAsk, s: StmtId) -> KeptAt? {
        if !ask.seats.is_empty() { return null }
        let d? = self.decls.decl_of(ask.file, s) else { return null }
        let layout? = self.kept_layout(ask.file, s) else { return null }
        KeptAt { key: self.kept_settle_key(ask.file, d), layout: layout }
    }

    /// A settlement run, its verdict kept at `at` when the run asked no body
    /// a held file has.
    fn settle_run(ask: SettleAsk, s: StmtId, id: string, asked: int, at: KeptAt?) -> Result<
        Settled,
        Unsettled,
    > {
        let fresh: Cell<List<KeptLine>> = list_cell()
        self.hold.settle_frames.push(fresh)
        // this settlement's reads alone, then joined to what its file's runs read before
        let reader = self.decls.file(ask.file).path
        let scope = self.opened_reads(reader)
        let touched_from = self.decls.touched_types.get().length
        let r = self
            .settlement_of(ask.file, self.analysis(ask.file).view.store.const_value(s)!, ask.name, ask.seats)
        self.note_const_types(ask.file, s)
        self.note_touched(touched_from)
        let frame = self.popped_settle_frame()
        let read = self.closed_reads(reader, scope)
        self.hold.settle_reads.put(id, read)
        let kept? = at else { return r }
        if self.hold.body_asks.get().length == asked { self.keep_verdict(kept.key, r, frame, kept.layout, read) }
        r
    }

    /// A const's kept layout line: every declared type its answer reaches, as
    /// this program lays each out — a kept value is laid out under them. None
    /// for a const that carries no type.
    fn kept_layout(f: FileId, s: StmtId) -> string? {
        let ty? = self.decls.type_of_const(f, s) else { return null }
        joined(["l", self.decls.crossing_layout(ty)], "\t")
    }

    /// Where `d`'s kept verdict lives: its file's path and its name.
    fn kept_settle_key(f: FileId, d: DeclId) -> string { kept_key_for(self.decls.file(f).path, self.decls.decl(d).name) }

    /// The files a read file's runs force read: none when its kept const
    /// verdicts will answer without running AND account for every run its
    /// record lists — a run no verdict answers for (a derive's) runs again.
    fn forced_runs(store: Store, path: string) -> List<string> {
        let m = self.module_path_of(path)
        let runs = kept_runs(record_places(self, store, m).get(path))
        let consts = [parts[5] for parts in record_fields(self, store, m) if parts.length > 5 && parts[0] == "const" && parts[1] == path]
        let kept = [kept_reads(store, kept_key_for(path, n)) for n in consts]
        if consts.is_empty() || kept.any(it == null) { return [r.path for r in runs] }
        let read = flatten([r ?? [] for r in kept])
        // A run's membership is a question about PATHS: the union is deduped as
        // paths, so no read's wire is hexed to answer it.
        let asked = distinct(
            [p.path for p in read.concat(flatten([self.ran_by(store, p.path) for p in read]))],
        )
        if runs.all((r) -> asked.contains(r.path)) { [] } else { [r.path for r in runs] }
    }

    /// A KEPT VERDICT THAT DID NOT STAND ASKS ALL IT READ AT ONCE: the run
    /// about to replace it reads the bodies the verdict's run read, so every
    /// held one among them — and what their own runs read — is asked now, and
    /// the attempt turns once, never once per level the run would reach.
    /// A read MANY CONSTS REACH is expanded once, under the open ask generation,
    /// so the whole file's consts ask one read, never one read per const. The
    /// reads already decoded by `kept_verdict` are read back, not decoded twice.
    fn ask_kept_reads(id: string, key: string) {
        let store? = self.store.get() else { return }
        let read = self.hold.settle_reads.get().get(id) ?? kept_reads(store, key) ?? []
        if read.is_empty() { return }
        self.ask_reads_scope()
        let fresh = self.unseen_reads(ASK_READS_READER, read)
        if fresh.is_empty() { return }
        let reached = flatten([self.ran_by(store, p.path) for p in fresh])
        let held = [p.path for p in fresh.concat(reached) if self.held_path(p.path)]
        if !held.is_empty() { self.hold.body_asks.set(self.hold.body_asks.get().concat(held)) }
    }

    /// The ask generation, opened on first use: a unique one, so its reads are
    /// deduped apart from every file's own run scope.
    fn ask_reads_scope() {
        if self.hold.read_gen.get().get(ASK_READS_READER) == null {
            let _ = self.opened_reads(ASK_READS_READER)
        }
    }

    /// Whether `path` is a file this attempt holds.
    fn held_path(path: string) -> bool {
        let f? = self.decls.known_file_id(path) else { return false }
        self.is_held(f)
    }

    /// The innermost open settlement's lines, its frame closed.
    fn popped_settle_frame() -> List<KeptLine> {
        let frames = self.hold.settle_frames.get()
        let top = frames.last()!.get()
        self.hold.settle_frames.set(frames.slice(0, frames.length - 1))
        top
    }

    /// One unit a settlement lowers, noted in the open frame — with every
    /// const its lowering asked for asked again here, so a run that REUSES
    /// the unit reads what the run that lowered it read.
    fn logged_unit(w: Wanted) -> Unit {
        let id = self.spec_id(w)
        let u = self.lowered_for_eval(id)
        let top = self.hold.settle_frames.get().last()
        if top != null { top!.push(self.kept_unit_line(w, u)) }
        let d = w.decl ?? self.root_decl(w)
        if d != null { self.note_decl_types(d!) }
        for ask in self.asks_of(id) { let _ = self.settled_replay(ask.file, ask.root, ask.seats) }
        u
    }

    /// A unit's kept line: its file and that file's text, its declaration
    /// and, when its file is read, that declaration's syntax, its shape, and
    /// the wanted that lowers it again when its name holds no node id.
    fn kept_unit_line(w: Wanted, u: Unit) -> KeptLine {
        let path = self.decls.file(w.file).path
        let d = w.decl ?? self.root_decl(w)
        KeptLine {
            line: joined(
                [
                    "u",
                    path,
                    self.text_digest(path),
                    self.decl_ref(d),
                    if d == null || self.is_held(w.file) { "" } else { "${self.syntax(d!)}" },
                    self.unit_shape(u),
                ],
                "\t",
            ),
            unit: true,
            path: path,
            bodies: [b.name for b in u.bodies],
            wire: if w.decl != null && w.root == null { self.wanted_list_wire([w]) } else { "" },
        }
    }

    /// A const a settlement read, noted in the open frame: by its file and
    /// name and the verdict it answered — or, when it is no keepable const,
    /// a mark that the settlement is not kept.
    fn logged_const_read(
        f: FileId,
        root: SettleRoot,
        seats: List<SeatValue>,
        r: Result<Settled, Unsettled>,
    ) {
        let top? = self.hold.settle_frames.get().last() else { return }
        let s = const_stmt(root)
        let d: DeclId? = if s == null || !seats.is_empty() { null } else { self.decls.decl_of(f, s!) }
        let line = if d == null {
            "x"
        } else {
            joined(
                ["c", self.decls.file(f).path, self.decls.decl(d!).name, "${verdict_fp(r)}"],
                "\t",
            )
        }
        top.push(plain_kept(line))
    }

    /// A settlement's verdict and its lines, kept — a value, or a structural
    /// refusal; a settlement that read what no line can name is not kept.
    fn keep_verdict(
        key: string,
        r: Result<Settled, Unsettled>,
        frame: List<KeptLine>,
        layout: string,
        read: List<RunRead>,
    ) {
        let store? = self.store.get() else { return }
        if frame.any(it.line == "x") { return }
        let value: string? = match r {
            .Ok(v) -> kept_wire(v),
            .Err(why) -> if why.structural() { reach_wire(why.words()) } else { null },
        }
        if value == null { return }
        let ran = match r { .Ok(v) -> v.ran, .Err(_) -> [] }
        let embedded = match r { .Ok(v) -> v.embeds, .Err(_) -> [] }
        let view = self.seen_view(self.viewed_modules(distinct([k.path for k in frame if k.unit])))
        let lines = distinct([finished_line(k, ran) for k in frame])
            .concat(
                [
                    joined(["v", view.id], "\t"),
                    budget_line(self.budgets()),
                    layout,
                    joined(["r"].concat([read_wire(r) for r in read]), "\t"),
                ],
            )
            .concat([joined(["e", path, self.embed_said(path)], "\t") for path in distinct(embedded)])
        self.view_kept(store, view)
        let _ = store.keep(Stored.Unit, key, value!, [])
        let _ = store.keep(Stored.Unit, "${key}#lines", joined(lines, "\n"), [])
    }

    /// The kept verdict for `key`, when it was kept under this `layout` and
    /// every line it was kept with stands. A VERDICT CARRIES THE READS OF THE RUN
    /// THAT MADE IT — its `r` line, there even when the run read nothing — and
    /// standing on it records them for its file and for whoever reads the const.
    fn kept_verdict(f: FileId, key: string, layout: string, id: string) -> Result<
        Settled,
        Unsettled,
    >? {
        let store? = self.store.get() else { return null }
        let value? = store.get(Stored.Unit, key) else { return null }
        let lines? = store.get(Stored.Unit, "${key}#lines") else { return null }
        let said = lines.split("\n")
        if !said.contains(layout) { return null }
        let rows = [l.split("\t") for l in said if !l.is_empty() && l != layout]
        if !rows.all((r: List<string>) -> r[0] != "v" || self.view_stands(store, r)) { return null }
        if !self.rows_stand([r for r in rows if r[0] != "v"]) { return null }
        let reads? = rows.find(it[0] == "r") else { return null }
        let decoded = [read_of_wire(w) for w in reads.slice(1, reads.length)]
        if decoded.any(it == null) { return null }
        let read = [r! for r in decoded]
        self.read_by(self.decls.file(f).path, read)
        self.hold.settle_reads.put(id, read)
        let v = settled_from_wire(value)
        if v != null { return .Ok(v!) }
        let words? = reach_from_wire(value) else { return null }
        .Err(Unsettled.Reach(words))
    }

    /// The named types a const's own expressions carry: the typer resolved them when the file
    /// was typed, before any settlement, so they are read from the typed facts of its range.
    fn note_const_types(f: FileId, s: StmtId) {
        let d? = self.decls.decl_of(f, s) else { return }
        self.note_decl_types(d)
    }

    /// The named types a declaration's own expressions carry, read from its typed facts.
    fn note_decl_types(d: DeclId) {
        let x = self.decls.decl(d)
        if self.is_held(x.file) { return }
        let facts = self.typed(d)
        for i in x.lo..x.hi { self.decls.note_named(facts.type_at(ExprId { index: i })) }
    }

    /// The named types a settlement resolved since `from`, noted in its open frame.
    fn note_touched(from: int) {
        let top? = self.hold.settle_frames.get().last() else { return }
        let all = self.decls.touched_types.get()
        top.set(top.get().concat([self.touched_line(t) for t in all.slice(from, all.length)]))
    }

    /// A named type's kept line: its declaration, and the shape it has now.
    fn touched_line(t: TypeId) -> KeptLine {
        let line = match self.decls.types.shape_of(t) {
            .Struct(d, name) or .Enum(d, name) -> joined(["t", self.decl_ref(d), name, "${type_shape_key(self.decls, t)}"], "\t"),
            rest -> "",
        }
        plain_kept(line)
    }

    fn kept_row_stands(r: List<string>) -> bool {
        match r[0] {
            "u" -> self.kept_unit_stands(r),
            "t" -> self.kept_type_stands(r),
            "c" -> self.kept_const_stands(r),
            "m" -> r.length == 3 && self.module_files(module_path(r[1].split("."))).join(",") == r[2],
            "f" -> self.kept_file_stands(r),
            "b" -> r.length == 2 && budget_line(self.budgets()) == joined(r, "\t"),
            "e" -> r.length == 3 && self.embed_said(r[1]) == r[2],
            "r" or "n" or "s" -> true,
            rest -> false,
        }
    }

    /// A named type's line stands when its declaration still lays out as its shape.
    fn kept_type_stands(r: List<string>) -> bool {
        if r.length != 4 { return false }
        let d? = self.decl_from_ref(r[1]) else { return false }
        let t = if self.decls.is_enum(d) { self.decls.types.intern(Type.Enum(d, r[2])) } else { self.decls.types.intern(Type.Struct(d, r[2])) }
        "${type_shape_key(self.decls, t)}" == r[3]
    }

    /// A unit line stands when its file's text has not moved; or when its
    /// declaration's syntax has not; or, for a unit the run only reached,
    /// when it lowers again to its shape. What the unit sees is the file lines'.
    fn kept_unit_stands(r: List<string>) -> bool {
        if r.length < 7 { return false }
        if self.text_digest(r[1]) == r[2] { return true }
        let d? = self.decl_from_ref(r[3]) else { return false }
        if self.is_held(self.decls.decl(d).file) { return false }
        if "${self.syntax(d)}" == r[4] { return true }
        if r[6] == "1" { return false }
        let wanted? = self.wanted_list_from_wire(joined(r.slice(7, r.length), "\t")) else { return false }
        wanted.length == 1 &&
            self.unit_shape(self.lowered_for_eval(self.spec_id(wanted[0]))) == r[5]
    }

    /// Every module a unit in `paths` sees a type of: each one's own and the
    /// closure of its imports — a read file's from its parse, a held one's
    /// from its kept record.
    fn viewed_modules(paths: List<string>) -> List<ModulePath> {
        let at = "${self.db.revision()}\t${joined(paths, "\n")}"
        let known: List<ModulePath>? = self.keys.viewed.get().get(at)
        if known != null { return known! }
        let made = [module_path(m.split(".")) for m in sorted_texts(self.import_closure(distinct([self.module_of(p) for p in paths])))]
        self.keys.viewed.put(at, made)
        made
    }

    /// What a module set shows its units, built once per revision.
    fn seen_view(modules: List<ModulePath>) -> SeenView {
        let at = "${self.db.revision()}\t${joined([m.text() for m in modules], ",")}"
        let known: SeenView? = self.keys.seen_views.get().get(at)
        if known != null { return known! }
        let states = self.view_states(modules)
        let lines = [self.module_line(m) for m in modules]
            .concat([joined(["n", self.names_digest(modules), states.narrow], "\t")])
            .concat(states.lines)
            .concat(
                [self.file_line(path) for path in distinct(flatten([self.module_files(m) for m in modules]))],
            )
        let made = SeenView { id: digest_of(joined(lines, "\n")), lines: lines }
        self.keys.seen_views.put(at, made)
        made
    }

    /// A view's lines, kept under its digest once per process.
    fn view_kept(store: Store, view: SeenView) {
        let at = "kept\t${view.id}"
        if self.keys.view_marks.get().has(at) { return }
        let _ = store.keep(Stored.Unit, view_key(view.id), joined(view.lines, "\n"), [])
        self.keys.view_marks.put(at, true)
    }

    /// Whether a `v` row's view is kept and every line of it stands, memoized
    /// per view for the attempt: the judgment reads the module and file facts a
    /// build is still building, so it is reused only while the file count and
    /// the body-ask count stand as they did when it was made.
    fn view_stands(store: Store, r: List<string>) -> bool {
        if r.length != 2 { return false }
        let files = self.decls.file_names.get().length
        let asks = self.hold.body_asks.get().length
        let known = self.hold.view_standing.get().get(r[1])
        if known != null {
            let stood = known!
            if stood.files == files && stood.asks == asks { return stood.stands }
        }
        let said? = store.get(Stored.Unit, view_key(r[1])) else {
            self.hold.view_standing.put(r[1], ViewStand { files: files, asks: asks, stands: false })
            return false
        }
        let stands = self.rows_stand(rows_of(said))
        self.hold.view_standing.put(r[1], ViewStand { files: files, asks: asks, stands: stands })
        stands
    }

    /// Whether kept rows all stand, and the names digest agrees with the modules they list.
    fn rows_stand(rows: List<List<string>>) -> bool {
        if !rows.all((r: List<string>) -> self.kept_row_stands(r)) { return false }
        let mods = [module_path(r[1].split(".")) for r in rows if r[0] == "m"]
        rows.all((r: List<string>) -> r[0] != "n" || self.names_stand(r, mods, rows))
    }

    /// Whether a kept row that needs no analysis refuses: a view by its lines, any other by its own.
    fn row_refuses(store: Store, r: List<string>) -> bool {
        if r[0] == "v" { return !self.view_stands(store, r) }
        judged_by_files(r) && !self.kept_row_stands(r)
    }

    /// `seen` and every module it imports, to a fixed point.
    fn import_closure(seen: List<string>) -> List<string> {
        let more = distinct(
            seen.concat(flatten([self.module_imports(module_path(m.split("."))) for m in seen])),
        )
        if more.length == seen.length { seen } else { self.import_closure(more) }
    }

    /// The modules `m` imports: its kept record's, and each read file's own.
    fn module_imports(m: ModulePath) -> List<string> {
        let store = self.store.get()
        let kept = if store == null { [] } else { imports_kept(self, store!, m.text()) }
        let read = [p for p in self.module_files(m) if self.file_is_read(p)]
        distinct(kept.concat(flatten([[i.text() for i in self.imported_by(p)] for p in read])))
    }

    /// Whether `path` is parsed in this build: loaded, and not held.
    fn file_is_read(path: string) -> bool {
        let f? = self.decls.known_file_id(path) else { return false }
        !self.is_held(f)
    }

    /// A module's kept line: its files, so a file added or removed moves it.
    fn module_line(m: ModulePath) -> string { joined(["m", m.text(), self.module_files(m).join(",")], "\t") }

    /// A seen file's kept line: its text, and, when it is read, its outline.
    fn file_line(path: string) -> string {
        joined(
            [
                "f",
                path,
                self.text_digest(path),
                if self.file_is_read(path) { "2${self.outline_values(path)}" } else { "" },
            ],
            "\t",
        )
    }

    /// A file line stands when its text has not moved, or when it is read and
    /// its outline has not.
    fn kept_file_stands(r: List<string>) -> bool {
        if r.length < 3 || r.length > 4 { return false }
        if self.text_digest(r[1]) == r[2] { return true }
        r.length == 4 && r[3] != "" && self.file_is_read(r[1]) && self.outline_matches(r[1], r[3])
    }

    /// A file's `use` lines, each a fingerprint of its path, items and aliases.
    fn use_fps(f: FileId) -> List<int> {
        [fp(312, [texts_fp(u.path), texts_fp(u.items), texts_fp(u.aliases)]) for u in use_lines(self.parsed(f))]
    }

    /// A file's outline as a verdict keeps it: its declarations that are not named types (a
    /// named type is keyed by its shape, in a `t` line) and not reached by name alone (a verdict
    /// stands on the fns and consts its run read, in its own lines) and its `use` lines.
    fn outline_values(path: string) -> string {
        let f? = self.decls.known_file_id(path) else { return "" }
        let decls = [fp_str("${self.outline_syntax(d)}") for d in self.decls.decls_of_file(f) if outlined_value(self.decls.decl(d).kind) && !self.plain_free(d)]
        let uses = self.use_fps(f)
        "${fp(313, [fp_list(decls), fp_list(uses)])}"
    }

    /// A declaration's entry in a file's value outline: an impl block is its trait, target and
    /// members' signatures, since a member's body is the member's own declaration; any other
    /// declaration is its syntax.
    fn outline_syntax(d: DeclId) -> int {
        let x = self.decls.decl(d)
        match x.kind {
            .Impl -> {
                let _ = self.parsed(x.file)
                self.decls.store(d).impl_outline_fp(x.stmt)
            },
            _ -> self.syntax(d),
        }
    }

    /// Whether a kept file outline still stands: a `2` outline is the value outline, any
    /// other is the whole outline an older verdict kept.
    fn outline_matches(path: string, kept: string) -> bool {
        if kept.starts_with("2") { self.outline_values(path) == kept.substring(1, kept.length) } else { self.outline(path) == kept }
    }

    /// The declaration names of the modules a verdict sees, as one digest: a name a
    /// seen module gains or loses moves it.
    fn names_digest(mods: List<ModulePath>) -> string {
        names_digest_of([self.file_bound_digest(p) for m in mods for p in self.module_files(m)])
    }

    /// The digest of the names a file binds: a held file's off its module's producer row, any
    /// other's from its declarations.
    fn file_bound_digest(path: string) -> string { names_digest_of([unmarked(b) for b in self.bound_of(path)]) }

    /// A file's bound names, a plain free fn's marked `*`: off its module's producer row when it is
    /// held, from its declarations otherwise.
    fn bound_of(path: string) -> List<string> {
        let held = self.held_names(path)
        if held != null { return held!.bound }
        let f? = self.decls.known_file_id(path) else { return [] }
        [if self.plain_free(d) { "*${self.decls.decl(d).name}" } else { self.decls.decl(d).name } for d in self.decls.decls_of_file(f) if binds_name(self.decls.decl(d).kind)]
    }

    /// A held file's names off its module's producer row; null for a file no record answers for.
    fn held_names(path: string) -> FileNames? {
        let store? = self.store.get() else { return null }
        if !self.held_path(path) { return null }
        (self.producers_for(store, self.module_path_of(path))?.narrows ?? []).find(it.path == path)
    }

    /// A names line stands when the names are the ones it was kept with, or, for a plain free fn
    /// nothing spells, the narrowed names are.
    fn names_stand(r: List<string>, mods: List<ModulePath>, rows: List<List<string>>) -> bool {
        if r[1] == self.names_digest(mods) { return true }
        if r.length < 3 { return false }
        let moved? = self.narrow_stands(rows, mods) else { return r[2] == self.narrow_names_digest(mods) }
        if moved && db_verified_files() && r[2] != self.narrow_names_digest(mods) { self.defect(narrow_unsound()) }
        moved
    }

    /// THE NARROWED NAMES, JUDGED BY WHAT MOVED: the kept `s` lines hold each file's names by
    /// kind and the names its module's view counted, so only files whose text moved, whose names
    /// drifted, or that bind a name some file stopped or started spelling are judged again.
    /// Null when the kept lines cannot say.
    fn narrow_stands(rows: List<List<string>>, mods: List<ModulePath>) -> bool? {
        let files = distinct(flatten([self.module_files(m) for m in mods]))
        let kept = keyed_rows([r for r in rows if r[0] == "s" && r.length == 4])
        let texts = keyed_rows([r for r in rows if r[0] == "f"])
        if kept.length != files.length || files.any((p: string) -> !kept.has(p) || !texts.has(p)) { return null }
        let changed = [p for p in files if texts.get(p)![2] != self.text_digest(p)]
        let moved? = self.moved_spellings(changed, texts) else { return null }
        let heads = [p for p in files if self.state_head(p) != kept.get(p)![2]]
        if heads
            .any((p: string) -> self.state_head(p).split(".")[0] != kept.get(p)![2].split(".")[0]) {
            return false
        }
        let generated = [p for p in heads if self.has_generated(p) != (kept.get(p)![2].split(".")[1] == "1")]
        let sees: Cell<Map<string, Sight>> = Cell.new({})
        for m in mods {
            let own = self.module_files(m)
            let stem = m.text().split(".").last() ?? ""
            let whole = moved.has(stem) ||
                generated.any((g: string) -> own.contains(g) || self.spells(g, stem))
            for path in own {
                let affected = whole ||
                    changed.contains(path) ||
                    heads.contains(path) ||
                    self.binds_moved(path, moved)
                if affected &&
                    self.sp_digest(path, self.sight_of(sees, m, files)) != kept.get(path)![3] {
                    return false
                }
            }
        }
        true
    }

    /// What a module's view counts: the files that can reach its fns, and whether plain fns are
    /// counted by spelling there.
    fn sight_of(seen: Cell<Map<string, Sight>>, m: ModulePath, files: List<string>) -> Sight {
        let known: Sight? = seen.get().get(m.text())
        if known != null { return known! }
        let sees = self.module_sees(m, files)
        let made = Sight { files: sees, narrow: !sees.any((p: string) -> self.has_generated(p)) }
        seen.put(m.text(), made)
        made
    }

    /// The names some changed file spells now and did not when the lines were kept, or the
    /// reverse; null when a kept spelling is gone.
    fn moved_spellings(changed: List<string>, texts: Map<string, List<string>>) -> Map<string, bool>? {
        let moved: Cell<Map<string, bool>> = Cell.new({})
        for path in changed {
            let kept? = self.store.get()?.get(Stored.Unit, tokens_key(texts.get(path)![2])) else { return null }
            let was = spelling_of(kept).names
            let now = self.spelling(path).names
            for n in now.keys() { if !was.has(n) { moved.put(n, true) } }
            for n in was.keys() { if !now.has(n) { moved.put(n, true) } }
        }
        moved.get()
    }

    /// Whether a file binds a plain free fn whose name moved.
    fn binds_moved(path: string, moved: Map<string, bool>) -> bool {
        !moved.is_empty() &&
            self.bound_of(path).any((b: string) -> b.starts_with("*") && moved.has(unmarked(b)))
    }

    /// The same names with each plain free fn counted only where a file that can see its
    /// module spells it besides its own declaration, and every name when such a file holds
    /// generated code, which spells names its text does not.
    fn narrow_names_digest(mods: List<ModulePath>) -> string {
        let files = distinct(flatten([self.module_files(m) for m in mods]))
        digest_of(
            joined(sorted_texts(flatten([self.narrow_module_names(m, files) for m in mods])), "\n"),
        )
    }

    /// A module's names for the narrowed digest: its files, and the viewed files that spell
    /// the module's last segment, are the ones its fns can reach.
    fn narrow_module_names(m: ModulePath, files: List<string>) -> List<string> {
        let own = self.module_files(m)
        let stem = m.text().split(".").last() ?? ""
        let sees = self.module_sees(m, files)
        let narrow = !sees.any((p: string) -> self.has_generated(p))
        flatten([self.file_decl_names(path, sees, narrow) for path in own])
    }

    /// The files of `files` that can reach a module's fns: its own, and those spelling its last segment.
    fn module_sees(m: ModulePath, files: List<string>) -> List<string> {
        let stem = m.text().split(".").last() ?? ""
        distinct(self.module_files(m).concat([p for p in files if self.spells(p, stem)]))
    }

    /// The digest of a file's plain free fn names a view counts: those spelled beside it, or all
    /// of them where the view's files hold generated code.
    fn sp_digest(path: string, sight: Sight) -> string { names_digest_of(self.counted_plain(path, sight)) }

    /// What a file's `s` line says of its names apart from what a view counts: the non-plain names'
    /// digest, whether it holds generated code, and every bound name's digest.
    fn state_head(path: string) -> string {
        let held = self.held_names(path)
        if held != null { return held!.head }
        head_of(self.bound_of(path), self.has_generated(path))
    }

    /// Each file of the modules, as an `s` line — its path, its head, and what its view counted of
    /// it — with the narrowed names digest the same walk counts.
    fn view_states(modules: List<ModulePath>) -> ViewStates {
        let files = distinct(flatten([self.module_files(m) for m in modules]))
        let found = flatten([self.module_states(m, files) for m in modules])
        ViewStates {
            lines: [f.line for f in found],
            narrow: names_digest_of(flatten([f.counted for f in found])),
        }
    }

    /// One module's files, each with its `s` line and the names its view counts.
    fn module_states(m: ModulePath, files: List<string>) -> List<FileState> {
        let no_sights: Map<string, Sight> = {}
        let sight = self.sight_of(Cell.new(no_sights), m, files)
        [self.file_state(p, sight) for p in self.module_files(m)]
    }

    /// A file's `s` line, and the names a view counts of it: the non-plain ones and the plain ones counted.
    fn file_state(path: string, sight: Sight) -> FileState {
        let plain = self.counted_plain(path, sight)
        FileState {
            line: joined(["s", path, self.state_head(path), names_digest_of(plain)], "\t"),
            counted: [unmarked(b) for b in self.bound_of(path) if !b.starts_with("*")].concat(plain),
        }
    }

    /// The plain free fn names of a file a view counts: those spelled beside it, or all of them
    /// where the view's files hold generated code.
    fn counted_plain(path: string, sight: Sight) -> List<string> {
        [unmarked(b) for b in self.bound_of(path) if b.starts_with("*") && (!sight.narrow || self.spelled_beside(path, unmarked(b), sight.files))]
    }

    /// Whether any declaration of a file was written by an annotation: its code spells names
    /// its text does not.
    fn has_generated(path: string) -> bool {
        let f? = self.decls.known_file_id(path) else { return false }
        let held? = self.held_names(path) else {
            return self
                .decls
                .decls_of_file(f)
                .any((d: DeclId) -> !self.decls.decl(d).maker.is_empty())
        }
        held.generated
    }

    /// A file's declaration names, when the file is known; a plain free fn's only when `files`
    /// spell it beyond its own declaration, or `narrow` is off.
    fn file_decl_names(path: string, files: List<string>, narrow: bool) -> List<string> {
        [unmarked(b) for b in self.bound_of(path) if !narrow || !b.starts_with("*") || self.spelled_beside(path, unmarked(b), files)]
    }

    /// Whether a declaration is a free fn or const nothing generated and no annotation touches.
    fn plain_free(d: DeclId) -> bool {
        let x = self.decls.decl(d)
        reached_by_name(x.kind) &&
            x.owner.is_empty() &&
            x.maker.is_empty() &&
            x.enclosing.is_empty() &&
            x.word == null &&
            x.marks.is_empty()
    }

    /// Whether a name is spelled twice in its own file, or once in another of `files`.
    fn spelled_beside(path: string, name: string, files: List<string>) -> bool {
        self.spelled_twice(path, name) ||
            files.any((p: string) -> p != path && self.spells(p, name))
    }

    /// Whether a file's text spells a name more than once.
    fn spelled_twice(path: string, name: string) -> bool { self.spelling(path).twice.has(name) }

    /// Whether a file's text spells a name.
    fn spells(path: string, name: string) -> bool {
        work_spell_lookup()
        self.spelling(path).names.has(name)
    }

    /// The names a file's text spells, indexed by name: its row is kept under the text's digest,
    /// so a text that did not move is read and never lexed again.
    fn spelling(path: string) -> Spelling {
        let at = "${self.octets_word(path)}\t${path}"
        let known: Spelling? = self.keys.file_tokens.get().get(at)
        if known != null { return known! }
        let key = tokens_key(self.text_digest(path))
        let kept: string? = self.store.get()?.get(Stored.Unit, key)
        let made = spelling_of(kept ?? self.lexed_row(path, key))
        self.keys.file_tokens.put(at, made)
        made
    }

    /// A file's spelled-name row, lexed from its text and kept when a store is open.
    fn lexed_row(path: string, key: string) -> string {
        let counts = token_counts(self.listed_text(path))
        let row = joined(
            [if counts.get(n) ?? 0 > 1 { "+${n}" } else { n } for n in sorted_texts(counts.keys())],
            "\n",
        )
        let _ = self.store.get()?.keep(Stored.Unit, key, row, [])
        row
    }

    /// What a file says to a body it does not hold: every declaration but a
    /// body's own, and every `use` line.
    fn outline(path: string) -> string {
        let f? = self.decls.known_file_id(path) else { return "" }
        let decls = [fp_str("${self.syntax(d)}") for d in self.decls.decls_of_file(f) if outlined(self.decls.decl(d).kind) && !self.plain_free(d)]
        let uses = self.use_fps(f)
        "${fp(311, [fp_list(decls), fp_list(uses)])}"
    }

    /// A unit's CALL SHAPE, the same in every process: what it asks to be
    /// lowered, as the wire a held file's asks are kept in, and whether each
    /// body reaches the world — what a structural verdict reads, and no literal.
    fn unit_shape(u: Unit) -> string {
        "${fp(308, [fp_str(self.wanted_list_wire(u.wants)), fp_list([if reaches_world(b, true) { 1 } else { 0 } for b in u.bodies])])}"
    }

    /// The declaration whose range holds a root-only unit's expression.
    fn root_decl(w: Wanted) -> DeclId? {
        let root? = w.root else { return null }
        [d for d in self.decls.decls_of_file(w.file) if self.decls.decl(d).lo <= root.index && root.index < self.decls.decl(d).hi]
            .first()
    }

    /// A const line stands when the const answers the verdict it answered.
    fn kept_const_stands(r: List<string>) -> bool {
        if r.length < 4 { return false }
        let f? = self.decls.known_file_id(r[1]) else { return false }
        let d? = [x for x in self.decls.decls_of_file(f) if self.decls.decl(x).name == r[2] && settles(self.decls.decl(x).kind)]
            .first() else {
            return false
        }
        "${verdict_fp(self.settled(f, SettleRoot.Const(self.decls.decl(d).stmt), []))}" == r[3]
    }
}

/// What a verdict's units see — module lines, names, file lines — named by the digest of its text.
type SeenView = { id: string, lines: List<string> }

/// The files a module's view counts spellings in, and whether plain free fns are counted by them.
type Sight = { files: List<string>, narrow: bool }

/// A file's kept `s` line, and the names its view counts of it.
type FileState = { line: string, counted: List<string> }

/// What a view keeps of its modules' names: each file's `s` line, and the narrowed names digest.
type ViewStates = { lines: List<string>, narrow: string }

/// Rows by the path they name.
fn keyed_rows(rows: List<List<string>>) -> Map<string, List<string>> {
    let by: Cell<Map<string, List<string>>> = Cell.new({})
    for r in rows { by.put(r[1], r) }
    by.get()
}

fn narrow_unsound() -> string {
    "a kept names line stood by its moved-name judgement where the whole narrowed digest says it moved — the judgement skips files, so one of them was skipped that reads a name that moved"
}

/// The names a text spells, and those it spells more than once.
type Spelling = { names: Map<string, bool>, twice: Map<string, bool> }

/// A spelling read back from its row: one name a line, `+` before a name spelled more than once.
fn spelling_of(row: string) -> Spelling {
    let names: Cell<Map<string, bool>> = Cell.new({})
    let twice: Cell<Map<string, bool>> = Cell.new({})
    for l in row.split("\n") {
        if l.starts_with("+") { twice.put(l.substring(1, l.length), true) }
        names.put(if l.starts_with("+") { l.substring(1, l.length) } else { l }, true)
    }
    Spelling { names: names.get(), twice: twice.get() }
}

/// Where a view's lines are kept.
fn tokens_key(digest: string) -> string { node_key(Stored.Unit, ["tokens", digest]) }

fn view_key(id: string) -> string { node_key(Stored.Unit, ["kept-view", id]) }

/// A kept text's rows, split into fields.
fn rows_of(said: string) -> List<List<string>> { [l.split("\t") for l in said.split("\n") if !l.is_empty()] }

/// Where a const's verdict is kept, and the layout it was kept under.
type KeptAt = { key: string, layout: string }

/// What a kept verdict's run read — its `r` line — or null when none is kept.
fn kept_reads(store: Store, key: string) -> List<RunRead>? {
    let lines? = store.get(Stored.Unit, "${key}#lines") else { return null }
    let reads? = [l.split("\t") for l in lines.split("\n") if !l.is_empty()].find(it[0] == "r") else { return null }
    let xs = [read_of_wire(w) for w in reads.slice(1, reads.length)]
    if xs.any(it == null) { return null }
    [x! for x in xs]
}

/// Where a const's kept verdict lives: its file's path and its name.
fn kept_key_for(path: string, name: string) -> string { node_key(Stored.Unit, ["kept-settle", path, name]) }

/// A frame's line as kept: a unit line marks whether the run entered it, and
/// carries its wanted last, since a wire may hold a tab.
fn finished_line(k: KeptLine, ran: List<string>) -> string {
    if !k.unit { return k.line }
    let entered = if k.bodies.any((b) -> ran.contains(b)) { "1" } else { "0" }
    joined([k.line, entered, k.wire], "\t")
}

/// Whether a declaration of this kind speaks to bodies outside it: all but a
/// body's own statements, which a unit line answers for.
/// A kept line that names no unit, path or body.
fn plain_kept(line: string) -> KeptLine {
    KeptLine { line: line, unit: false, path: "", bodies: [], wire: "" }
}

/// Whether a declaration's name is one a module's namespace binds: not a default, a method,
/// an impl, or a case, whose names a file's other declarations never resolve.
fn binds_name(k: DeclKind) -> bool {
    match k {
        .Default or .Method or .Impl or .Case -> false,
        .Fn or .Main or .Const or .Record or .Named or .Alias or .Enum or .Trait or .Syntax or .Collect or .CollectEnum or .Builtin or .State -> true,
    }
}

/// Whether a declaration kind is in a file's value outline: every kind but a fn-like one
/// (a default is one, reached at its call sites) and a named type, whose shape a `t` line keys.
fn outlined_value(k: DeclKind) -> bool {
    match k {
        .Fn or .Method or .Default or .Main or .Case or .Record or .Named or .Alias or .Enum -> false,
        .Const or .Trait or .Syntax or .Impl or .Collect or .CollectEnum or .Builtin or .State -> true,
    }
}

fn outlined(k: DeclKind) -> bool {
    match k {
        .Fn or .Method or .Main or .Case -> false,
        .Const or .Record or .Named or .Alias or .Enum or .Trait or .Syntax or .Default or .Impl or .Collect or .CollectEnum or .Builtin or .State -> true,
    }
}

/// A list of texts as one number, each text one value.
fn texts_fp(xs: List<string>) -> int { fp_list([fp_str(x) for x in xs]) }

/// The budgets a run spends, as a kept line.
fn budget_line(b: Budgets) -> string { joined(["b", "${b.steps}:${b.bytes}"], "\t") }

/// Whether a declaration of this kind is a const, settled for its value.
fn settles(k: DeclKind) -> bool {
    match k {
        .Const -> true,
        .Fn or .Record or .Named or .Alias or .Enum or .Trait or .Syntax or .Method or .Default or .Impl or .Main or .Case or .Collect or .CollectEnum or .Builtin or .State -> false,
    }
}

/// A verdict as one number: a value's own fingerprint, a refusal's words.
fn verdict_fp(r: Result<Settled, Unsettled>) -> int {
    match r { .Ok(v) -> fp(309, [v.fingerprint]), .Err(why) -> fp(310, [fp_str(why.words())]) }
}
