//! The memory pass: strategy per scope, decided by its LEVEL.
//! Lowering emitted pure semantics; this pass inserts the memory
//! instructions each scope's strategy demands. Today every scope is
//! Application — reference counting, releases in reverse binding
//! order. The calling convention is A PARAMETER IS BORROWED: the
//! caller keeps every managed argument standing for the call and the
//! callee owns none of its params — what it KEEPS (a store, a push, a
//! pack, a yield, its answer) takes a reference of its own, as any
//! value a scope does not own does. A call that only reads costs no
//! count at all. The caller owns the call's result. Systems ownership
//! lands here later as a strategy, touching neither lowering nor the
//! backend.
use core.{
    Ins,
    is_managed,
    Reg,
    Level,
    TypeId,
    TypeRegistry,
    SeatMark,
    consumed_mark,
    Stack,
    new_stack,
    owned_dst,
    viewed_dst,
    dst_of,
    lent_args,
    reads_of,
    reads_reg,
    reads_some,
    same_reg,
    rt_owns,
    rt_lends,
    rt_writes,
    rt_aliases_arg0,
    rt_owned_twin,
    rt_reusing_twin,
    rt_moving_twin,
    reversed,
    flatten,
    opens_region,
}
use compiler.lower.{Lowered, Body}
use compiler.soundness.{checked}
use @std.io.{env}

/// Managed registers bound in one open scope, its tier remembered.
export type Scope = { tier: Level, managed: List<Reg>, cells: List<Reg> }

export fn memory(l: Lowered) -> Lowered {
    // A `.Call`'s callee is a SYMBOL, never a DeclId — mono may give
    // two instantiations of one source fn the same inferred marks
    // under different concrete seats, so the lookup is by the name
    // every `Ins.Call` already carries, built once for the program.
    // A HELD CALLEE carries no body here (`drained`, compiler/lower/
    // lower.av: "never asked for") — only a MARKS-ONLY STUB, `weak`
    // with no `ins`, minted so this lookup can still see its declared
    // `consumed` seats. It answers no instructions of its own, so it
    // is read for `by_name` and dropped before `fns` leaves this pass
    // — `held_stubs` (compiler/record.av) is the declaration a later
    // emission actually links against; a second, empty-bodied one
    // reaching emission is an unterminated LLVM function, not a body.
    let by_name = marks_by_name(l.fns)
    let named = [b for b in l.fns if !(b.weak && b.ins.is_empty())]
    let fns = [b with { ins: body_ins(l.types, b.reg_types, b.ins, b.params.length, b.marks, by_name) } for b in named]
    let entry = l.entry with { ins: body_ins(l.types, l.entry.reg_types, l.entry.ins, 0, l.entry.marks, by_name) }
    let out = l with { fns: fns, entry: entry }
    if !sound_checked() { return out }
    // L2: an independent proof over this pass's OWN output — never a
    // second opinion on the decisions above, only on what they left
    // behind (docs/2026_09_23_REUSE_IN_PLACE.md §30). Measured at
    // ~23% of `avra check packages/cli`'s own instructions retired —
    // too much for every ordinary check or build, so it runs only
    // when asked: `avra test`, a landing's gate, or `AVRA_SOUND_CHECK=1`
    // set by hand.
    out with { diagnostics: out.diagnostics.concat(checked(out, (ty: TypeId) -> is_managed(l.types, ty))) }
}

/// Whether this process runs the memory pass's own proof — it adds
/// findings to a check, so a check is kept under it.
export fn sound_checked() -> bool {
    env("AVRA_SOUND_CHECK") == "1"
}

/// One body's memory instructions: its params are registers 0..`seats`, and
/// every scope's exit names what escapes it. A CONSUMING seat (R3) is the one
/// exception to "a param stands": its whole point is to be scope-owned from
/// entry, so `consuming_seats` seeds it into the entry scope the moment the first
/// bracket opens, and every caller of THIS body reads `marks` by name to
/// decide whether to hand its dying argument over or retain first.
fn body_ins(
    types: TypeRegistry,
    reg_types: List<TypeId>,
    ins: List<Ins>,
    seats: int,
    marks: List<SeatMark>,
    by_name: Map<string, List<SeatMark>>,
) -> List<Ins> {
    let immortal = immortal_regs(reg_types.length, ins)
    [i for i in memory_ins(
        types,
        reg_types,
        ins,
        standing_regs(immortal, ins, seats, marks),
        consuming_seats(seats, marks),
        by_name,
    ) if !immortal_rc_op(i, immortal)]
}

/// THE REGISTERS THAT STAND FOR ANY CALL THEY ARE HANDED TO, whoever owns them: a
/// param (the caller's caller keeps it for this whole body), the binary's own
/// data, and a cell's load — a cell never leaves its body, so no callee changes
/// it. What is left is a VIEW into a box, which a callee may empty. A CONSUMING
/// param (R3) stands for nothing: the caller already handed this body its own
/// reference, seeded owned instead (`consuming_seats`) — never both.
fn standing_regs(immortal: List<bool>, ins: List<Ins>, seats: int, marks: List<SeatMark>) -> List<
    bool,
> {
    mut out = [immortal[j] || j < seats && !consumed_mark(marks, j) for j in 0..immortal.length]
    for i in ins {
        let d: Reg? = loaded_dst(i)
        if d != null { out.set(d!.index, true) }
    }
    out
}

/// The param registers a consuming seat mark names — what the entry
/// scope seeds owned the moment it opens.
fn consuming_seats(seats: int, marks: List<SeatMark>) -> List<Reg> {
    [Reg { index: j } for j in 0..seats if consumed_mark(marks, j)]
}

/// Every body's own marks, by its SYMBOL — a name a caller never
/// declared (a runtime row, an unresolved `.CallPtr` target) simply
/// answers no marks, which every seat there already reads as plain.
fn marks_by_name(fns: List<Body>) -> Map<string, List<SeatMark>> {
    mut out: Map<string, List<SeatMark>> = {}
    for b in fns { out.set(b.name, b.marks) }
    out
}

fn loaded_dst(i: Ins) -> Reg? {
    match i { .Load(d, _) -> d, _ -> null }
}

/// THE REGISTERS THAT HOLD THE BINARY'S OWN DATA — a string constant, a settled
/// aggregate's address. The runtime never counts an immortal box, so a retain
/// or a release of one is a call that does nothing, and neither is placed.
fn immortal_regs(count: int, ins: List<Ins>) -> List<bool> {
    mut out = [false for j in 0..count]
    for i in ins {
        let d: Reg? = immortal_dst(i)
        if d != null { out.set(d!.index, true) }
    }
    out
}

/// A `once fn`'s OWN SLOT joins this set: `OnceRead` answers non-null
/// only once its matching `OnceCommit` has already made that answer
/// immortal (runtime's `avra_once_slot_commit`), and the null case
/// costs nothing either way — retain and release both no-op on it.
fn immortal_dst(i: Ins) -> Reg? {
    match i { .ConstStr(d, _) or .StaticAddr(d, _) or .OnceRead(d, _) -> d, rest -> null }
}

/// A retain or a release naming an immortal register — both no-ops the
/// runtime never counts, dropped as a PAIR: `moved_out`'s borrowed-yield
/// retain and the scope-exit release it balances both name an immortal
/// register the same way, so stripping only the retain leaves the release
/// unmatched — a debt this body never took.
fn immortal_rc_op(i: Ins, immortal: List<bool>) -> bool {
    match i { .Retain(r) or .Release(r) -> immortal[r.index], rest -> false }
}

/// The memory instructions as every scope's strategy places them — the pass's
/// one dispatch over the instruction set. `consuming` is R3's own seed: the
/// registers a consuming param seat names, planted into the OUTERMOST scope —
/// the seats bracket every body opens first (`lower_fn`'s `seats_enter`, always
/// `ins[0]`) — the instant it opens, so `Lives.handover`'s existing reuse and
/// `FnExit`/`ScopeExit`'s existing release-what-the-scope-owns logic apply to
/// it exactly as they do to any other locally-owned value: this pass adds no
/// new rule for WHAT happens to a consuming param, only for WHERE it starts.
fn memory_ins(
    types: TypeRegistry,
    reg_types: List<TypeId>,
    ins: List<Ins>,
    standing: List<bool>,
    consuming: List<Reg>,
    by_name: Map<string, List<SeatMark>>,
) -> List<Ins> {
    mut out: List<Ins> = []
    mut open_scopes: Stack<Scope> = new_stack()
    // each open loop's FLOOR: the scope depth its turn opens at, known
    // from its `LoopCond` on
    mut floors: List<int> = []
    let last = last_reads(reg_types.length, ins)
    let defs = def_sites(reg_types.length, ins)
    let next_barrier = barrier_positions(ins)
    let twins = twin_table(defs, next_barrier, types, reg_types, ins)
    let life = Lives {
        types: types,
        reg_types: reg_types,
        ins: ins,
        last: last,
        defs: defs,
        next_barrier: next_barrier,
        twins: twins,
        viewed: viewed_regs(types, reg_types, ins),
        death: death_points(twins, ins, last),
    }
    for at, raw in ins {
        let i = owned_form(twins, types, reg_types, at, raw)
        match i {
            .ScopeEnter(tier) -> {
                // LICENSED compiler.bracket_ritual: a scope STACK walked by the pass, not a bracket body
                open_scopes.push(Scope { tier: tier, managed: [], cells: [] })
                // `seats_enter` is always `ins[0]`: this IS the seats bracket.
                if at == 0 { for r in consuming { takes(open_scopes, r) } }
                out.push(i)
            },
            // A scope YIELDS like a branch: released never here,
            // adopted by the enclosing scope (ownership moves out
            // one scope; at the outermost it escapes to the caller).
            .ScopeExit(gives) -> {
                let scope = open_scopes.pop() ?? empty_scope()
                // LICENSED loops.push_loop: the pass's OUTPUT is written by one verb, `push`, at every site
                for s in scope.settled(gives) { out.push(s) }
                // SOMETHING ALWAYS RECEIVES A YIELD: an enclosing scope adopts
                // it, or — at the outermost — the caller takes it as the
                // answer. A yield the scope does not own takes its own
                // reference either way: a param answered is the caller's
                // to keep, and the param was never this body's.
                // LICENSED loops.push_loop: the pass's OUTPUT accumulates
                for s in moved_out(types, reg_types, scope, gives) { out.push(s) }
                adopts(types, reg_types, open_scopes, gives)
                out.push(i)
            },
            // A branch is a scope at its enclosing tier. Its yield
            // escapes to the merge: the branch never releases it —
            // the enclosing scope owns `dst`, the merge of both.
            .IfStart(_) or .SwitchStart(_, _) -> {
                // LICENSED compiler.bracket_ritual: a scope STACK walked by the pass, not a bracket body
                open_scopes.push(nested_scope(open_scopes))
                out.push(i)
            },
            .ArmEnd(gives) -> {
                let scope = open_scopes.pop() ?? empty_scope()
                // LICENSED loops.push_loop: the pass's OUTPUT is written by one verb, `push`, at every site
                for s in scope.settled(gives) { out.push(s) }
                // LICENSED loops.push_loop: the pass's OUTPUT accumulates
                for s in moved_out(types, reg_types, scope, gives) { out.push(s) }
                // LICENSED compiler.bracket_ritual: a scope STACK walked by the pass, not a bracket body
                open_scopes.push(nested_scope(open_scopes))
                out.push(i)
            },
            .RegionEnd(_, gives) -> {
                let scope = open_scopes.pop() ?? empty_scope()
                // LICENSED loops.push_loop: the pass's OUTPUT is written by one verb, `push`, at every site
                for s in scope.settled(gives) { out.push(s) }
                // LICENSED loops.push_loop: the pass's OUTPUT accumulates
                for s in moved_out(types, reg_types, scope, gives) { out.push(s) }
                manages(types, reg_types, open_scopes, i)
                out.push(i)
            },
            // THE CALLER KEEPS ITS ARGUMENTS STANDING, and most stand already.
            // A VIEW does not — the callee may empty the box it looks into —
            // so it is held across the call. The indirect call wears the
            // same convention.
            //
            // A CONSUMING SEAT (R3) IS THE ONE EXCEPTION: that seat's own
            // callee will scope-own the argument from its own entry (this
            // same pass, seeded above), so THIS call is the transfer, not a
            // loan — the SAME `dies_at`/`owned_top` question R1 already asks
            // of a `CallRt`'s first seat (`Lives.moves`, the `.Store` arm
            // below), generalized to any owned-seat argument here: a dying,
            // scope-owned argument is handed over with no retain at all
            // (`disowns`, so this scope's own exit never releases it a
            // second time); anything else earns the callee its OWN
            // reference, exactly as `.Store` mints one for a value that does
            // not move. Independent of `lent` above, which exists for VIEWS
            // a standing/scope-owned argument is excluded from either way.
            .Call(_, _, _) or .CallPtr(_, _, _) -> {
                let lent = [ar for ar in lent_args(i) if is_managed(types, reg_types[ar.index]) &&
                    !standing[ar.index] &&
                    !owned_open(open_scopes, ar) &&
                    root_handed(life, i, ar)]
                // LICENSED loops.push_loop: the pass's OUTPUT accumulates
                for r in lent { out.push(Ins.Retain(r)) }
                let marks: List<SeatMark> = callee_marks(types, reg_types, by_name, i)
                for j, ar in lent_args(i) {
                    if consumed_mark(marks, j) && is_managed(types, reg_types[ar.index]) {
                        if life.moves(open_scopes, ar, at) { disowns(open_scopes, ar) } else { out.push(Ins.Retain(ar)) }
                    }
                }
                manages(types, reg_types, open_scopes, i)
                out.push(i)
                // LICENSED loops.push_loop: the pass's OUTPUT accumulates
                for r in lent { out.push(Ins.Release(r)) }
            },
            // An EARLY exit settles EVERY open scope's debts at the
            // site — nothing pops, because other paths continue.
            .FnExit(gives) -> {
                // an answer no scope owns is the caller's to keep: its own reference, first
                if is_managed(types, reg_types[gives.index]) && !owned_open(open_scopes, gives) { out.push(Ins.Retain(gives)) }
                // LICENSED loops.push_loop: the pass's OUTPUT accumulates
                for s in owed_from(open_scopes, 0, gives) { out.push(s) }
                out.push(i)
            },
            // AN EARLY END OF A TURN settles what the turn's own close
            // would: every scope opened since its loop's `LoopCond`.
            .LoopJump(outward, _) -> {
                // LICENSED loops.push_loop: the pass's OUTPUT accumulates
                for s in owed_from(open_scopes, floors[floors.length - 1 - outward], null) { out.push(s) }
                out.push(i)
            },
            // THE MUT-CELL PROTOCOL: the cell owns ONE reference.
            // A store takes the incoming value's reference FIRST — a
            // retain, or the scope's own when the value dies there —
            // then releases what the cell held (a self-store must not
            // free what it is keeping). The cell's own reference
            // settles when its scope does.
            .Alloca(dst) -> {
                if is_managed(types, reg_types[dst.index]) && !open_scopes.is_empty() {
                    holds_cell(open_scopes, dst)
                }
                out.push(i)
            },
            // A STORE SETTLES BY THE CELL'S TYPE, never the value's:
            // `x = null` into a managed cell releases what x held.
            .Store(slot, src) -> {
                if is_managed(types, reg_types[slot.index]) {
                    // a value that dies here MOVES in: the scope's reference becomes the cell's
                    if is_managed(types, reg_types[src.index]) {
                        if life.moves(open_scopes, src, at) { disowns(open_scopes, src) } else { out.push(Ins.Retain(src)) }
                    }
                    // EVERY store settles what the cell held: a fresh
                    // cell holds nothing (the alloca nulls it), and a
                    // store inside a loop runs many times where the
                    // pass sees it once
                    out.push(cell_settle(slot))
                }
                out.push(i)
            },
            // A managed LOAD is a BORROW of the cell's reference —
            // it earns its own +1 only when it must OUTLIVE it.
            // Retain and ownership travel together: a borrow the
            // scope does not own is a release it must not emit.
            .Load(dst, slot) -> {
                out.push(i)
                if is_managed(types, reg_types[dst.index]) &&
                    borrow_outlives(
                        twins,
                        defs,
                        next_barrier,
                        types,
                        reg_types,
                        ins,
                        at,
                        dst,
                        slot,
                        false,
                    ) {
                    out.push(Ins.Retain(dst))
                    manages(types, reg_types, open_scopes, i)
                }
            },
            // THE CONDITION RUNS EVERY TURN: what it mints is settled
            // at each LoopCond, never at the enclosing scope's exit —
            // a release placed after the loop settles one turn's
            // debts for all of them, and every other turn's owned
            // load leaks (and, holding a reference, turns each write
            // in the body into a copy).
            .LoopStart -> {
                // LICENSED compiler.bracket_ritual: a scope STACK walked by the pass, not a bracket body
                open_scopes.push(nested_scope(open_scopes))
                floors.push(0)
                out.push(i)
            },
            .LoopCond(_) -> {
                let scope = open_scopes.pop() ?? empty_scope()
                // LICENSED loops.push_loop: the pass's OUTPUT accumulates
                for s in scope.settled(null) { out.push(s) }
                floors.set(floors.length - 1, open_scopes.depth())
                out.push(i)
            },
            .LoopEnd -> {
                let _ = floors.pop()
                out.push(i)
            },
            // A FLAT RECORD'S PACK IS IDENTITY, so the destination is
            // a SECOND NAME for the part's box and takes its OWN
            // reference — the part keeps the one it had, and the
            // scope settles both. (Every other pack is a scalar
            // pair, which owns nothing.) Its twin `Extract` is a
            // VIEW and owns nothing, which `managed_dst` says.
            .Pack(dst, _) -> {
                out.push(i)
                if is_managed(types, reg_types[dst.index]) { out.push(Ins.Retain(dst)) }
                manages(types, reg_types, open_scopes, i)
            },
            // REUSE IN PLACE: a first seat that dies here is HANDED to the
            // row's reusing twin, which writes a box it holds alone
            .CallRt(dst, callee, args) -> {
                match life.handover(open_scopes, at) {
                    .Kept -> out.push(i),
                    .Owned -> {
                        disowns(open_scopes, args[0])
                        out.push(Ins.CallRt(dst, rt_reusing_twin(callee) ?? callee, args))
                    },
                    .Emptied(slot) -> {
                        out.push(cell_forget(slot))
                        out.push(Ins.CallRt(dst, rt_reusing_twin(callee) ?? callee, args))
                    },
                }
                manages(types, reg_types, open_scopes, i)
            },
            // A STORE MOVES what dies there: the scope's reference goes
            // into the slot, and the scope never releases it
            .CallRtVoid(_, args) -> {
                let moving: string? = life.moved_into(open_scopes, at)
                if moving == null {
                    out.push(i)
                } else {
                    disowns(open_scopes, args.last()!)
                    out.push(Ins.CallRtVoid(moving!, args))
                }
            },
            .ConstInt(_, _) or .ConstFloat(_, _) or .ConstStr(_, _) or .ConstBool(_, _) or .FlagRead(_, _) or .Bin(_, _, _, _) or .Un(_, _, _) or .FnAddr(_, _) or .StaticAddr(_, _) or .OnceRead(_, _) or .OnceCommit(_, _) or .Release(_) or .Extract(_, _, _) or .Retain(_) or .RetVal(_) or .Ret(_) -> {
                manages(types, reg_types, open_scopes, i)
                out.push(i)
            },
        }
        // A VALUE DIES WHERE IT IS LAST READ: a reference held to the
        // scope's close keeps the box shared, and the next write to it
        // copies the whole box.
        for r in life.dead_here(open_scopes, at) {
            out.push(Ins.Release(r))
            disowns(open_scopes, r)
        }
    }
    out
}

/// A managed LOAD is a BORROW: the cell holds one reference and
/// the loaded register rides it. The borrow earns its own +1 only
/// when it must OUTLIVE that reference — it is given UPWARD, or a
/// use of it (or of a borrow taken from it) stands past a step
/// that could change the cell, or past the close of a bracket open
/// at the load. Conservative by construction: what the scan cannot
/// read as safe owns.
///
/// THE +1 IS NOT BOOKKEEPING. `avra_cell_unique` copies only when
/// the count is above one, so a borrow that does NOT retain is
/// exactly what lets a write land in place — the retain was what
/// made a read-then-write clone.
///
/// WHAT THE SCAN DOES NOT ASK, and why it need not: a runtime row
/// handed the borrow. A row BORROWS its arguments, and a C body
/// that KEEPS what it was handed takes its own reference — that
/// law (CLAUDE.md) is what makes a stored borrow safe, and it held
/// before this pass counted uses. A row that keeps without
/// retaining is a dangling store whether the read owns or not.
fn borrow_outlives(
    twins: List<bool>,
    defs: List<int>,
    next_barrier: List<int>,
    types: TypeRegistry,
    reg_types: List<TypeId>,
    ins: List<Ins>,
    at: int,
    dst: Reg,
    slot: Reg,
    identity: bool,
) -> bool {
    mut views: List<Reg> = [dst]
    mut last = at
    mut j = at + 1
    while j < ins.length {
        let i = ins[j]
        if views.any(reads_reg(i, it)) {
            if gives_upward(i) { return true }
            last = j
            let d: Reg? = view_of(i)
            // a child that takes its OWN reference rides nobody's
            if d != null && is_managed(types, reg_types[d!.index]) && !twins[j] {
                views.push(d!)
            }
        }
        j = j + 1
    }
    leaves_or_changes(defs, next_barrier, ins, at, last, slot, identity)
}

/// WHETHER THE CELL'S REFERENCE MAY NOT STAND for the whole stretch a borrow is
/// used: the cell changes, or a bracket open AT the load closes — the cell may
/// be that scope's. A bracket opened since the load nests inside the cell's
/// life and is read through; a LOOP opened since runs again, so its whole body
/// is the stretch — a change after the last use meets that use next turn.
///
/// A REGION ARM THAT LEAVES THE FUNCTION CANNOT REACH `last`: nothing in it
/// stands on any path to a use past its own close, so the scan skips straight
/// there instead of reading what the arm did on its way out.
/// `next_barrier` SKIPS what the scan below can prove boring first: with
/// none between `at + 1` and `last`, the loop below would run to `last`
/// touching neither a bracket nor `slot` and answer false — so that is
/// the answer, with no instruction visited at all.
fn leaves_or_changes(
    defs: List<int>,
    next_barrier: List<int>,
    ins: List<Ins>,
    at: int,
    last: int,
    slot: Reg,
    identity: bool,
) -> bool {
    if next_barrier[at + 1] > last { return false }
    mut depth = 0
    mut loops = 0
    mut k = next_barrier[at + 1]
    while k < ins.length && (k <= last || loops > 0) {
        let i = ins[k]
        if changes_cell(defs, ins, i, slot, identity) { return true }
        if opens(i) {
            depth = depth + 1
            if i is .LoopStart { loops = loops + 1 }
        } else if closes(i) {
            if depth == 0 { return true }
            depth = depth - 1
            if i is .LoopEnd { loops = loops - 1 }
        } else if depth == 0 && turns(i) {
            return true
        }
        k = skip_diverging_arm(ins, k, last) ?? next_barrier[k + 1]
    }
    false
}

/// An arm's own close (`ArmEnd`, or `RegionEnd` for the last arm) and
/// whether that arm's own top level — nothing nested inside a further
/// `if`, `switch`, loop or scope — reaches `.FnExit` before it. A
/// `.FnExit` behind a nested bracket is conditional on THAT bracket, not
/// the arm, so only a top-level one makes the arm leave unconditionally.
type ArmExit = { diverges: bool, boundary: int }

fn arm_exit(ins: List<Ins>, from: int) -> ArmExit {
    mut depth = 0
    mut diverges = false
    mut j = from
    while true {
        let step = ins[j]
        if depth == 0 && (step is .ArmEnd || step is .RegionEnd) { break }
        if depth == 0 && step is .FnExit { diverges = true }
        if opens(step) { depth = depth + 1 }
        if closes(step) { depth = depth - 1 }
        j = j + 1
    }
    ArmExit { diverges: diverges, boundary: j }
}

/// `k` just opened a region (`IfStart`/`SwitchStart`) or closed one arm
/// (`ArmEnd`) — the next arm begins at `k + 1`. When that arm diverges,
/// its interior is dead to everything from its own close onward, so the
/// scan may jump straight to that close — UNLESS `last` itself sits
/// inside the arm, where what happens before that read still matters.
///
/// A NON-diverging arm skips too, on a NARROWER condition (.93): `last`
/// sits in a SIBLING arm of this same region. Arms are mutually
/// exclusive — at most one executes — so a use in one is never on the
/// path a call in another took, whether or not that other arm diverges.
/// This does NOT cover `last` sitting AFTER the whole region (past its
/// own merge): reaching there, this arm's fall-through IS the path, so
/// its own contents still matter — `region_exit` is what tells the two
/// apart from `exit.boundary` (this arm's own close) alone.
fn skip_diverging_arm(ins: List<Ins>, k: int, last: int) -> int? {
    if !(opens_region(ins[k]) || ins[k] is .ArmEnd) { return null }
    let exit = arm_exit(ins, k + 1)
    if exit.diverges && (last <= k || last >= exit.boundary) { return exit.boundary }
    if !exit.diverges && last >= exit.boundary && last < region_exit(ins, k) { return exit.boundary }
    null
}

/// The region's own close (`RegionEnd`) a chain of arms starting at `k`
/// eventually reaches, walking past every `ArmEnd` in between — the
/// merge point sitting PAST a call in one arm is no barrier to a use
/// held in another, sibling arm.
fn region_exit(ins: List<Ins>, k: int) -> int {
    mut at = k
    while true {
        at = arm_exit(ins, at + 1).boundary
        if ins[at] is .RegionEnd { break }
    }
    at
}

/// A step that could CHANGE what the cell holds: a store to it, a
/// runtime row that WRITES THROUGH the seat `slot` fills (the
/// registry's own `writes` column — never "took `slot` as an
/// operand", which an ORDINARY READ also does), or a writing row
/// handed the cell itself under a different register. A second load
/// only reads it.
///
/// A ROW THAT ONLY READS COSTS NOTHING HERE, THE SAME LAW THE
/// CALLING CONVENTION ALREADY STATES FOR USER CALLS. `avra_array_get`
/// reading `self`'s OTHER field a few lines past `slot`'s own read is
/// not a change to `slot` — treating every operand-match as a change
/// forced `self.record_kernel`'s own read to its owned twin merely
/// because `self.record_items` was read afterward, in the same
/// stretch, on the way to a call that never touched `record_kernel`
/// at all (avra-8sb5.57.108). `writes_arg` asks the registry which
/// SEAT a row changes; a row nobody has named there answers false,
/// same polarity as `writes[j]`'s own default.
///
/// EXACT IDENTITY IS COMPLETE ONLY WHEN `slot` IS A STABLE REGISTER —
/// an `Alloca` destination or a param, which the pass never re-mints:
/// every consumer of one in the tree is a `Load`, a `Store`,
/// `avra_cell_unique` or this pass's own `avra_cell_release`, and a
/// cell is never packed, never an argument to a user callee, never
/// aliased into a second register. The `.Load` exemption rests on the
/// other half: a borrow root's write loads the cell and writes
/// THROUGH the box (places.av), so it never re-points the cell.
///
/// A `slot` read off anything else — a field chain, a nested cell, a
/// second `.Load` — has no such guarantee: the SAME source re-run for
/// a `set`/`put`/`push` a few lines on mints a FRESH register for the
/// SAME box (`self.audit.held` evaluated twice is two registers, one
/// pointer), so exact identity goes BLIND exactly where a write is
/// about to free what this borrow rides. There the scan asks CELL_ROOT
/// instead — is the write's own box the SAME STABLE IDENTITY `slot`
/// traces back to, asked whether or not `slot` ITSELF could be
/// re-minted: `slot` may be a param (`self`), stable and never
/// re-derived, while the WRITE still lands through a register `cell_root`
/// must trace back to it — `avra_box_thawed(self)` answers the SAME
/// box `self`'s own field read did, under a different register, and
/// only `aliases_arg0` says so (`owns_result` alone stops the trace,
/// right for an ordinary allocator and wrong for a thaw).
///
/// A user call changes an IDENTITY `slot` (one on a cell's chain,
/// `read_outlives`) whatever it is handed.
fn changes_cell(defs: List<int>, ins: List<Ins>, i: Ins, slot: Reg, identity: bool) -> bool {
    if i is .Load { return false }
    match i {
        .CallRt(_, callee, args) -> writes_arg(callee, args, slot),
        .CallRtVoid(callee, args) -> writes_arg(callee, args, slot) || aliased_write(defs, ins, callee, args, slot),
        .Call(_, _, _) or .CallPtr(_, _, _) -> identity || reads_reg(i, slot),
        rest -> reads_reg(i, slot),
    }
}

/// Whether `callee`'s call writes through `slot` — matched at the
/// SEAT the registry names, never at any other position a register
/// happens to occupy: a row's promise is per-seat (`avra_map_set`
/// writes its map, arg 0, and reads its key and value untouched).
fn writes_arg(callee: string, args: List<Reg>, slot: Reg) -> bool {
    for j, a in args { if same_reg(a, slot) && rt_writes(callee, j) { return true } }
    false
}

/// The re-run-mints-a-fresh-register case: `slot` is not itself an
/// argument, but this call's OWN first seat traces back to the SAME
/// box `slot` does. Every writing row in the registry names its
/// subject at seat 0, so that is the one seat this asks about.
///
/// A WRITE INTO A BOX HELD BELOW `slot` changes that box, never `slot`'s
/// own slots: `c.set_at(i, v)` writes the list the cell holds, and the
/// cell's reference to that list stands through it. What the write
/// releases is the box's OLD ELEMENT, which reaches `slot` only by a
/// cycle — and the chain above `slot` still holds it then.
fn aliased_write(defs: List<int>, ins: List<Ins>, callee: string, args: List<Reg>, slot: Reg) -> bool {
    let box? = args.first() else { return false }
    rt_writes(callee, 0) &&
        same_reg(cell_root(defs, ins, slot), cell_root(defs, ins, box)) &&
        !held_below(defs, ins, box, slot)
}

/// Whether `r` is a box held, at any depth, BELOW `from`: its provenance
/// reaches `from` through at least one step that reads a PART — an
/// `Extract` or a lending row. Every other step may answer the box it was
/// handed (`avra_box_thawed`), so it keeps the depth.
fn held_below(defs: List<int>, ins: List<Ins>, r: Reg, from: Reg) -> bool {
    below_from(defs, ins, r, from, false)
}

fn below_from(defs: List<int>, ins: List<Ins>, r: Reg, from: Reg, deeper: bool) -> bool {
    let d = defs[r.index]
    if d < 0 { return false }
    let src? = view_source(ins[d]) else { return false }
    let lower = deeper || reads_part(ins[d])
    if same_reg(src, from) { return lower }
    below_from(defs, ins, src, from, lower)
}

/// Whether `i` answers a part of its subject's box, never the box itself.
fn reads_part(i: Ins) -> bool {
    match i { .Extract(_, _, _) -> true, .CallRt(_, callee, _) -> rt_lends(callee), rest -> false }
}

/// THE STABLE IDENTITY `r` WAS ULTIMATELY READ FROM: walked through a
/// `.Load` to the `Alloca` it reads (two loads of one `mut` cell are
/// two registers for the one slot) and through a VIEW to ITS source (a
/// field read run twice is two registers for the one box) — down to a
/// param or an `Alloca`, which name themselves. Unlike `Lives.root_of`,
/// never absent: this walk exists to COMPARE two provenances, so it
/// must land somewhere, itself when there is nowhere further to go.
fn cell_root(defs: List<int>, ins: List<Ins>, r: Reg) -> Reg {
    let d = defs[r.index]
    if d < 0 { return r }
    let loaded? = loaded_slot(ins[d]) else {
        let src? = view_source(ins[d]) else { return r }
        return cell_root(defs, ins, src)
    }
    cell_root(defs, ins, loaded)
}

/// THE BRACKETS, by what each does to the nesting: one OPENS a region, one
/// CLOSES it, and one TURNS it — ends a region's part and begins the next.
fn opens(i: Ins) -> bool { i is .ScopeEnter || i is .IfStart || i is .SwitchStart || i is .LoopStart }

fn closes(i: Ins) -> bool { i is .ScopeExit || i is .RegionEnd || i is .LoopEnd }

fn turns(i: Ins) -> bool { i is .ArmEnd || i is .LoopCond }

/// A SUPERSET of every position `leaves_or_changes`'s per-step test can
/// ever answer true for, over ANY slot: a bracket (opens/closes/turns
/// already say so on their own), or a read `changes_cell` could match —
/// which needs a register read at all, and never a `Load`'s (excluded by
/// that law itself, whatever it reads). Over-inclusive is fine, since the
/// exact test still runs at every position this reaches; under-inclusive
/// would skip a real barrier, which `barrier_positions` must never do.
fn barrier_kind(i: Ins) -> bool {
    opens(i) || closes(i) || turns(i) || calls(i) || !(i is .Load) && reads_some(i)
}

/// Whether `i` runs a user callee, which may reach any `Cell`.
fn calls(i: Ins) -> bool {
    match i { .Call(_, _, _) or .CallPtr(_, _, _) -> true, rest -> false }
}

/// THE NEXT BARRIER AT OR AFTER EACH POSITION, once per function body —
/// `ins.length` past the last one. A scan for one fixed `slot` jumps
/// straight to `next_barrier[p]` instead of visiting `p, p+1, p+2, …`:
/// every position skipped is provably neither a bracket nor a possible
/// `changes_cell` match, for ANY slot, so nothing the scan would have
/// found is lost.
fn barrier_positions(ins: List<Ins>) -> List<int> {
    mut out = [ins.length for j in 0..ins.length + 1]
    mut k = ins.length - 1
    while k >= 0 {
        out.set(k, if barrier_kind(ins[k]) { k } else { out[k + 1] })
        k = k - 1
    }
    out
}

/// WHETHER THE STRETCH AFTER `from` AND BEFORE `to` RETURNS TO `from`'s
/// OWN NESTING: every bracket opened in it closes in it, and none open at
/// `from` closes or turns — so `to` runs once for each run of `from`.
fn level_span(ins: List<Ins>, from: int, to: int) -> bool {
    if from < 0 { return false }
    mut depth = 0
    for k in from + 1..to {
        let i = ins[k]
        if opens(i) {
            depth = depth + 1
        } else if closes(i) {
            if depth == 0 { return false }
            depth = depth - 1
        } else if depth == 0 && turns(i) {
            return false
        }
    }
    depth == 0
}

/// Whether `i` reads `r`.
fn touches(i: Ins, r: Reg) -> bool {
    reads_reg(i, r)
}

/// WHETHER A LAST READ AT `i` MAY BE FOLLOWED BY THE RELEASE: not a
/// bracket, whose reader stands in another region, not a step that gives
/// the value upward, and not a count of its own.
fn ends_life(i: Ins) -> bool {
    !opens(i) && !closes(i) && !turns(i) && !gives_upward(i) && !(i is .Retain) && !(i is .Release)
}

/// The uses that give a value UPWARD — out of its scope, into a
/// cell, or into an aggregate. A borrow that escapes must own.
fn gives_upward(i: Ins) -> bool {
    i is .ScopeExit ||
        i is .ArmEnd ||
        i is .RegionEnd ||
        i is .RetVal ||
        i is .FnExit ||
        i is .Store ||
        i is .Pack
}

/// A NON-OWNING read makes ANOTHER borrow of the same box — the
/// child rides the parent's reference, so its uses are the
/// parent's. Only a MANAGED child does: a scalar pulled out of a
/// box is a copied word and holds nothing.
///
/// The IR's `@view` role names the declared views; a LENDING runtime
/// row's answer is the one registry-shaped view (the row still
/// holds the box it answered), so it stays an arm here. A call's
/// answer is the caller's own reference, never a view.
fn view_of(i: Ins) -> Reg? {
    match i {
        .CallRt(d, callee, _) -> if rt_owns(callee) { null } else { d },
        rest -> viewed_dst(i),
    }
}

/// THE INVERSE OF `view_of`: the register a view was taken FROM —
/// Extract's subject, a lending row's first seat, or an ALIASING
/// owned row's first seat (`avra_box_thawed`: owned, yet its answer
/// may be the same box `writes` compares `slot` against) — the same
/// subject `read_outlives` judges by.
fn view_source(i: Ins) -> Reg? {
    extract_source(i) ?? lending_source(i)
}

fn extract_source(i: Ins) -> Reg? {
    match i { .Extract(_, src, _) -> src, rest -> null }
}

fn lending_source(i: Ins) -> Reg? {
    match i {
        .CallRt(_, callee, args) if !rt_owns(callee) || rt_aliases_arg0(callee) -> args.first(),
        rest -> null,
    }
}

/// WHETHER THIS CALL IS HANDED `ar`'s ROOT: a write only ever lands
/// through a seat the call itself receives (THE ROOT OF A PATH
/// DECIDES WHERE A WRITE LANDS), so a view whose root never reaches
/// this call cannot be written through here, let alone emptied — no
/// defensive retain is owed. Conservative at the root itself: `ar`
/// with no view behind it roots at `ar`, which is always among its
/// own call's seats, so it keeps its guard — and conservative at a
/// LOAD too, where `root_of` answers absent and this call is read as
/// reaching it whether or not that is literally the register it was
/// handed.
fn root_handed(life: Lives, i: Ins, ar: Reg) -> bool {
    let root? = life.root_of(ar) else { return true }
    lent_args(i).any(same_reg(it, root))
}

/// What each open scope from `floor` in owes at an early exit: its
/// cells settled, then its releases, innermost first — `kept`, the
/// value the exit answers, excluded.
fn owed_from(open_scopes: Stack<Scope>, floor: int, kept: Reg?) -> List<Ins> {
    [cell_settle(c) for c in exit_cells(open_scopes, floor)]
        .concat([Ins.Release(r) for r in exit_releases(open_scopes, floor, kept)])
}

/// Everything each open scope from `floor` in owes at an early exit,
/// innermost first — the answered value excluded in every one.
fn exit_releases(open_scopes: Stack<Scope>, floor: int, kept: Reg?) -> List<Reg> {
    mut out: List<Reg> = []
    // LICENSED loops.index_walk: a REVERSE walk — innermost debts settle first
    mut j = open_scopes.depth() - 1
    while j >= floor {
        let scope: Scope = open_scopes.at(j)
        out = out.concat(scope.releases_for(kept))
        j = j - 1
    }
    out
}

/// A scope opened INSIDE another: it inherits the enclosing tier
/// and owns nothing yet.
fn nested_scope(open_scopes: Stack<Scope>) -> Scope {
    Scope { tier: enclosing_tier(open_scopes), managed: [], cells: [] }
}

/// The tier a new scope inherits — its innermost open enclosure.
fn enclosing_tier(open_scopes: Stack<Scope>) -> Level {
    let top? = open_scopes.top() else { return Level.Application }
    top.tier
}

/// A YIELD THE SCOPE DOES NOT OWN is BORROWED — a parameter, an
/// enclosing scope's binding, an arm that simply names one. What
/// receives it (the merge's register, or the enclosing scope) will
/// own it and release it, so it takes its own reference here. A
/// yield the scope owns MOVES instead: its release is the one the
/// receiver inherits.
fn moved_out(types: TypeRegistry, reg_types: List<TypeId>, scope: Scope, gives: Reg?) -> List<Ins> {
    if gives == null { return [] }
    let r = gives!
    if !is_managed(types, reg_types[r.index]) { return [] }
    // LICENSED structs.index_compared: register identity, not type agreement
    if scope.managed.any(same_reg(it, r)) { return [] }
    [Ins.Retain(r)]
}

impl Scope {
    /// The strategy: what a scope owes at its exit. `kept` is a value
    /// that escapes the scope and is owned elsewhere.
    fn releases_for(kept: Reg?) -> List<Reg> {
        if counts(self.tier) { kept_out(reversed(self.managed), kept) } else { [] }
    }
}

/// Whether a tier counts references — the one whose scopes release what
/// they own.
fn counts(tier: Level) -> bool {
    match tier { .Application -> true, .Systems or .Bare or .Hardware -> false }
}

/// All but ONE entry for the escaping register: a scope may own the
/// same register twice (a nested scope yielded it back), and each
/// entry stands for one reference — only the one that escapes is
/// spared.
fn kept_out(rs: List<Reg>, kept: Reg?) -> List<Reg> {
    mut out: List<Reg> = []
    mut spared = false
    // LICENSED loops.push_loop: exactly ONE entry is dropped; a filter drops every match
    for r in rs {
        if !spared && !stays(r, kept) { spared = true } else { out.push(r) }
    }
    out
}

/// Held by the scope — not the value escaping through the yield.
fn stays(r: Reg, kept: Reg?) -> bool {
    // LICENSED structs.index_compared: register identity, not type agreement
    kept == null || r.index != kept!.index
}

/// The innermost scope TAKES a register: a scope is a value, so the
/// scope that owns one more is written back over the old top.
fn takes(mut open_scopes: Stack<Scope>, r: Reg) {
    let held? = open_scopes.top() else { return }
    let top = held
    let grown = top with { managed: top.managed.concat([r]) }
    open_scopes.rewrite_top(grown)
}

/// The innermost scope HOLDS a cell — the same rewrite, the other
/// column.
fn holds_cell(mut open_scopes: Stack<Scope>, r: Reg) {
    let held? = open_scopes.top() else { return }
    let top = held
    let grown = top with { cells: top.cells.concat([r]) }
    open_scopes.rewrite_top(grown)
}

/// A scope owning nothing — what an unbalanced stream would pop,
/// which lowering never emits.
fn empty_scope() -> Scope {
    Scope { tier: Level.Application, managed: [], cells: [] }
}

/// A closing scope's yield, adopted by the one outside it: at the
/// OUTERMOST there is none, and the value escapes to the caller.
fn adopts(types: TypeRegistry, reg_types: List<TypeId>, mut open_scopes: Stack<Scope>, gives: Reg?) {
    if gives == null || open_scopes.is_empty() { return }
    if is_managed(types, reg_types[gives!.index]) { takes(open_scopes, gives!) }
}

/// When `i` defines a managed value, the innermost open scope takes
/// ownership of its destination.
fn manages(types: TypeRegistry, reg_types: List<TypeId>, mut open_scopes: Stack<Scope>, i: Ins) {
    let dst: Reg? = managed_dst(types, reg_types, i)
    if dst != null { takes(open_scopes, dst!) }
}

/// A defining instruction's destination when the value is MANAGED
/// (heap-shaped) — the IR's `@owns` role, never a second hand list.
/// Null for a destination that owns nothing: a scalar's word, a cell,
/// an immortal static address (none carries `@owns`), the `@view`
/// destination, and every non-defining instruction.
fn managed_dst(types: TypeRegistry, reg_types: List<TypeId>, i: Ins) -> Reg? {
    let dst: Reg? = owned_dst(i)
    if dst == null { return null }
    if !is_managed(types, reg_types[dst!.index]) { return null }
    // Provenance refines the ROLE: a runtime call's answer is managed
    // only when the REGISTRY says it owns one — a static answer
    // (bool_text) never earns a release. The one variant-specific
    // fact, so the rest delegates to the role the declaration holds.
    match i { .CallRt(_, callee, _) if !rt_owns(callee) -> null, rest -> dst }
}

/// The pack/read REWRITE — where compile-time type knowledge
/// becomes the runtime's ownership plan: a store whose VALUE is
/// managed becomes retain-at-pack, a read whose DESTINATION is
/// managed becomes an owned +1 read — each by the registry's OWNED
/// TWIN column. Lowering never chooses; ownership stays this
/// pass's one concern, and no runtime name is spelled here.
fn owned_form(twins: List<bool>, types: TypeRegistry, reg_types: List<TypeId>, at: int, i: Ins) -> Ins {
    // a pre-filter — the caller's dispatch is exhaustive
    // over Ins; this rewrite touches only the runtime call shapes
    match i {
        .CallRtVoid(callee, args) -> {
            let twin: string? = rt_owned_twin(callee)
            if twin != null && pushes_managed(types, reg_types, args) { Ins.CallRtVoid(twin!, args) } else { i }
        },
        .CallRt(dst, callee, args) if twins[at] -> Ins.CallRt(dst, rt_owned_twin(callee) ?? callee, args),
        rest -> i,
    }
}

/// WHETHER EACH READ TAKES ITS OWNED TWIN, by position, once per body. A
/// read's answer asks only about the reads AFTER it, so a reverse walk has
/// every answer it needs in hand.
fn twin_table(
    defs: List<int>,
    next_barrier: List<int>,
    types: TypeRegistry,
    reg_types: List<TypeId>,
    ins: List<Ins>,
) -> List<bool> {
    mut out = [false for j in 0..ins.length]
    // LICENSED loops.index_walk: a REVERSE walk — a read's answer reads the answers after it
    mut k = ins.length - 1
    while k >= 0 {
        if takes_twin(out, defs, next_barrier, types, reg_types, ins, k, ins[k]) { out.set(k, true) }
        k = k - 1
    }
    out
}

/// WHETHER A READ TAKES ITS OWNED TWIN — its answer its own +1, riding nobody's
/// reference: a managed answer of a row that has a twin, which a LENDING row
/// declines only while the child stays a borrow. `twins` answers every
/// position after `at`.
fn takes_twin(
    twins: List<bool>,
    defs: List<int>,
    next_barrier: List<int>,
    types: TypeRegistry,
    reg_types: List<TypeId>,
    ins: List<Ins>,
    at: int,
    i: Ins,
) -> bool {
    match i {
        .CallRt(dst, callee, args) -> rt_owned_twin(callee) != null &&
            is_managed(types, reg_types[dst.index]) &&
            (!rt_lends(callee) ||
                read_outlives(twins, defs, next_barrier, types, reg_types, ins, at, dst, args)),
        rest -> false,
    }
}

/// A LENDING read's child is a BORROW of the subject's
/// reference unless it must OUTLIVE it — the same question a slot
/// read asks, with the SUBJECT register standing where the cell
/// does. Declining the owned twin is what leaves the count at one,
/// so the write that follows lands IN PLACE instead of cloning.
///
/// A `Cell` IS AN IDENTITY: `set` replaces what it holds and `set_at`,
/// `push` and `put` write the held list or map in place, whatever any
/// count says — so no reference along the way keeps a borrow below the
/// cell standing. A borrow whose chain reaches a cell, read past any user
/// call, owns: the callee may reach that cell, by a seat or a capture.
fn read_outlives(
    twins: List<bool>,
    defs: List<int>,
    next_barrier: List<int>,
    types: TypeRegistry,
    reg_types: List<TypeId>,
    ins: List<Ins>,
    at: int,
    dst: Reg,
    args: List<Reg>,
) -> bool {
    let subject? = args.first() else { return true }
    borrow_outlives(
        twins,
        defs,
        next_barrier,
        types,
        reg_types,
        ins,
        at,
        dst,
        subject,
        crosses_cell(defs, ins, types, reg_types, subject),
    )
}

/// Whether `r` carries a `Cell`, or is a view taken, at any depth, from one.
fn crosses_cell(
    defs: List<int>,
    ins: List<Ins>,
    types: TypeRegistry,
    reg_types: List<TypeId>,
    r: Reg,
) -> bool {
    if is_cell(types, reg_types[r.index]) { return true }
    let d = defs[r.index]
    if d < 0 { return false }
    let src? = view_source(ins[d]) else { return false }
    crosses_cell(defs, ins, types, reg_types, src)
}

/// Whether a value of `ty` carries a `Cell` in its own word: one, a
/// nullable one, or a flat record with one among its fields.
fn is_cell(types: TypeRegistry, ty: TypeId) -> bool {
    match types.shape_of(types.seen_through(ty)) {
        .Cell(_) -> true,
        .Opt(inner) -> is_cell(types, inner),
        rest -> types.flat_fields(ty).any(is_cell(types, it)),
    }
}

/// A push's VALUE seat (arg 1) holds a managed type.
fn pushes_managed(types: TypeRegistry, reg_types: List<TypeId>, args: List<Reg>) -> bool {
    let v: Reg? = args.last()
    v != null && is_managed(types, reg_types[v!.index])
}

/// The cell's held reference, released through the SLOT — the
/// pass mints no registers, so the runtime reads the cell itself.
fn cell_settle(slot: Reg) -> Ins {
    Ins.CallRtVoid("avra_cell_release", [slot])
}

/// The cell's reference MOVED OUT to the value loaded from it: the
/// cell empties without a release.
fn cell_forget(slot: Reg) -> Ins {
    Ins.CallRtVoid("avra_cell_forget", [slot])
}

/// The cells of each open scope from `floor` in, at an early exit,
/// innermost first.
fn exit_cells(open_scopes: Stack<Scope>, floor: int) -> List<Reg> {
    mut out: List<Reg> = []
    // LICENSED loops.index_walk: a REVERSE walk — innermost debts settle first
    mut j = open_scopes.depth() - 1
    while j >= floor {
        let scope: Scope = open_scopes.at(j)
        out = out.concat(reversed(scope.cells))
        j = j - 1
    }
    out
}

impl Scope {
    /// What a closing scope owes: its cells settled, last bound first,
    /// then the releases its yield leaves behind.
    fn settled(gives: Reg?) -> List<Ins> {
        [cell_settle(c) for c in reversed(self.cells)]
            .concat([Ins.Release(r) for r in self.releases_for(gives)])
    }
}

/// Whether an open scope owns the register — its box stands until that scope closes.
fn owned_open(open_scopes: Stack<Scope>, r: Reg) -> bool {
    [open_scopes.at(j) for j in 0..open_scopes.depth()]
        .any((s: Scope) -> s.managed.any(same_reg(it, r)))
}

/// HOW A CALL HANDS ITS FIRST SEAT to a reusing twin: not at all, as
/// the reference its scope owns, or as the reference the cell it was
/// loaded from held — that cell refilled before anything reads it.
enum Handover {
    Kept
    Owned
    Emptied(Reg)
}

/// ONE BODY'S LIVES: where each register is defined and last read.
type Lives = {
    types: TypeRegistry,
    reg_types: List<TypeId>,
    ins: List<Ins>,
    last: List<int>,
    defs: List<int>,
    next_barrier: List<int>,
    twins: List<bool>,
    viewed: List<bool>,
    death: List<int>,
}

impl Lives {
    /// The registers whose reference the innermost scope gives up right
    /// after `at`: each dies there — it and every view riding it read for
    /// the last time — at its own definition's nesting, so the release
    /// runs exactly once for each run of the definition. A register owned
    /// twice, or read last at a bracket or a step that gives it upward,
    /// waits for its scope's close.
    fn dead_here(open_scopes: Stack<Scope>, at: int) -> List<Reg> {
        let top? = open_scopes.top() else { return [] }
        if !counts(top.tier) || !ends_life(self.ins[at]) { return [] }
        [r for r in top.managed if self.death[r.index] == at &&
            owned_once(open_scopes, r) &&
            level_span(self.ins, self.defs[r.index], at)]
    }

    /// Whether the call at `at` hands its first seat over, and how.
    fn handover(open_scopes: Stack<Scope>, at: int) -> Handover {
        let r? = handed_seat(self.ins[at]) else { return Handover.Kept }
        if !is_managed(self.types, self.reg_types[r.index]) || !self.dies_at(r, at) { return Handover.Kept }
        if owned_top(open_scopes, r) { return Handover.Owned }
        let slot? = self.refilled_cell(r, at) else { return Handover.Kept }
        Handover.Emptied(slot)
    }

    /// The MOVING twin a slot write at `at` takes: its row has one, its
    /// value is managed, dies there, and the innermost scope owns it.
    fn moved_into(open_scopes: Stack<Scope>, at: int) -> string? {
        let v? = stored_value(self.ins[at]) else { return null }
        if self.last[v.index] != at { return null }
        let callee? = moving_callee(self.ins[at]) else { return null }
        if !is_managed(self.types, self.reg_types[v.index]) || !self.moves(open_scopes, v, at) { return null }
        rt_moving_twin(callee)
    }

    /// Whether a store's value MOVES into the cell: it dies at the store,
    /// and the innermost scope owns it.
    fn moves(open_scopes: Stack<Scope>, r: Reg, at: int) -> bool {
        // the cheap tests first: the view walk runs for a last read only
        self.last[r.index] == at && owned_top(open_scopes, r) && self.dies_at(r, at)
    }

    /// WHETHER `r` DIES AT `at`: read there once and never after, and
    /// no view taken from it read there or after.
    fn dies_at(r: Reg, at: int) -> bool {
        self.last[r.index] == at &&
            [x for x in reads_of(self.ins[at]) if same_reg(x, r)].length == 1 &&
            self.views(r, at).all(self.last[it.index] < at)
    }

    /// The views taken from `r` before `at`, and the views of those —
    /// every register that rides `r`'s reference. A read that takes its
    /// owned twin holds a reference of its own and rides nobody's.
    fn views(r: Reg, at: int) -> List<Reg> {
        if !self.viewed[r.index] { return [] }
        mut family: List<Reg> = [r]
        mut j = self.defs[r.index] + 1
        while j < at {
            let i = self.ins[j]
            let d: Reg? = view_of(i)
            if d != null &&
                family.any(reads_reg(i, it)) &&
                is_managed(self.types, self.reg_types[d!.index]) &&
                !self.twins[j] {
                family.push(d!)
            }
            j = j + 1
        }
        [v for v in family if !same_reg(v, r)]
    }

    /// `views`' inverse: the register `r`'s view chain was ultimately
    /// taken from, walked back through Extract and a lending row's own
    /// view to whatever defines its reference outright — `r` itself
    /// when it does. ABSENT AT A LOAD, ON PURPOSE: a `mut` cell may be
    /// loaded more than once, each load its own register for the SAME
    /// box, so register identity alone cannot say the call already
    /// holds it — `emptied`'s own witness (features/fns/tests/
    /// borrowed_params) is a second load, thawed for the `mut` seat,
    /// naming the box a first load's view already rides.
    fn root_of(r: Reg) -> Reg? {
        let d = self.defs[r.index]
        if d < 0 { return r }
        if self.ins[d] is .Load { return null }
        let src? = view_source(self.ins[d]) else { return r }
        self.root_of(src)
    }

    /// THE CELL `r` WAS BORROWED FROM, when handing its reference over is
    /// sound: `r` rides the cell's reference, the call runs once per load
    /// (every bracket opened since the load has closed), a store refills
    /// the cell in a straight line after it, nothing else touches the cell
    /// between, and no other borrow of the cell is read from here on.
    fn refilled_cell(r: Reg, at: int) -> Reg? {
        let d = self.defs[r.index]
        if d < 0 { return null }
        let slot? = loaded_slot(self.ins[d]) else { return null }
        if borrow_outlives(
            self.twins,
            self.defs,
            self.next_barrier,
            self.types,
            self.reg_types,
            self.ins,
            d,
            r,
            slot,
            false,
        ) {
            return null
        }
        if !self.level_with(slot, d, at) ||
            !self.refilled(slot, at) ||
            self.borrowed_past(slot, r, at) {
            return null
        }
        slot
    }

    /// Whether the stretch from the load at `d` up to `at` leaves the cell
    /// alone and returns to the load's own nesting — so `at` runs once for
    /// each run of the load, on its path.
    fn level_with(slot: Reg, d: int, at: int) -> bool {
        for k in d + 1..at {
            if touches(self.ins[k], slot) { return false }
        }
        level_span(self.ins, d, at)
    }

    /// Whether, after `at`, the cell is next touched by a store into it,
    /// with no bracket or exit between.
    fn refilled(slot: Reg, at: int) -> bool {
        mut k = at + 1
        while k < self.ins.length {
            let i = self.ins[k]
            if opens(i) || closes(i) || turns(i) || i is .FnExit || i is .LoopJump { return false }
            if reads_reg(i, slot) { return stores_into(i, slot) }
            k = k + 1
        }
        false
    }

    /// Whether another load of the cell before `at` is read at or after it.
    fn borrowed_past(slot: Reg, r: Reg, at: int) -> bool {
        mut j = 0
        while j < at {
            if self.borrow_read_past(j, slot, r, at) { return true }
            j = j + 1
        }
        false
    }

    /// Whether the instruction at `j` loads ANOTHER borrow of the cell,
    /// read — it or a view of it — at or after `at`.
    fn borrow_read_past(j: int, slot: Reg, r: Reg, at: int) -> bool {
        let s? = loaded_slot(self.ins[j]) else { return false }
        let d? = dst_of(self.ins[j]) else { return false }
        same_reg(s, slot) &&
            !same_reg(d, r) &&
            (self.last[d.index] >= at || self.views(d, at).any(self.last[it.index] >= at))
    }
}

/// A `.Call`/`.CallPtr`'s OWN callee's seat marks (R3): a DIRECT call
/// reads them by the SYMBOL every body carries (`Body.marks`), the
/// one currency `consumed` actually rides. An INDIRECT one reads the
/// register's own TYPE instead, which NEVER carries `consumed`
/// (`Decls.seat_mark` never merges it into a fn value's Arrow —
/// features/checks.av's `fn_fits` says why) — so a `.CallPtr`
/// answers plain for every seat, unconditionally, until an adapter
/// closes that gap. Either way, an absent name (a runtime row, an
/// unresolved target) answers plain too.
fn callee_marks(
    types: TypeRegistry,
    reg_types: List<TypeId>,
    by_name: Map<string, List<SeatMark>>,
    i: Ins,
) -> List<SeatMark> {
    match i {
        .Call(_, callee, _) -> by_name.get(callee) ?? [],
        .CallPtr(_, f, _) -> types.arrow_parts(reg_types[f.index])?.marks ?? [],
        rest -> [],
    }
}

/// The first seat of a call whose row has a reusing twin.
fn handed_seat(i: Ins) -> Reg? {
    match i {
        .CallRt(_, callee, args) -> if rt_reusing_twin(callee) != null { args.first() } else { null },
        _ -> null,
    }
}

/// A slot write whose row has a moving twin.
fn moving_callee(i: Ins) -> string? {
    match i {
        .CallRtVoid(callee, _) -> if rt_moving_twin(callee) != null { callee } else { null },
        _ -> null,
    }
}

/// The value a slot write stores — its last seat.
fn stored_value(i: Ins) -> Reg? {
    match i { .CallRtVoid(_, args) -> args.last(), _ -> null }
}

/// The cell a load reads.
fn loaded_slot(i: Ins) -> Reg? {
    match i { .Load(_, slot) -> slot, _ -> null }
}

/// Whether `i` is a store into `slot`.
fn stores_into(i: Ins, slot: Reg) -> bool {
    match i { .Store(s, _) -> same_reg(s, slot), _ -> false }
}

/// THE REGISTERS A VIEW MAY BE TAKEN FROM — read by an instruction that
/// defines a managed view. A superset: `views` still asks which child
/// takes its own reference, and walks the body only for these.
fn viewed_regs(types: TypeRegistry, reg_types: List<TypeId>, ins: List<Ins>) -> List<bool> {
    mut out = [false for j in 0..reg_types.length]
    for i in ins {
        let d: Reg? = view_of(i)
        if d != null && is_managed(types, reg_types[d!.index]) {
            for r in reads_of(i) { out.set(r.index, true) }
        }
    }
    out
}

/// THE LAST INSTRUCTION READING each register; -1 for one never read.
fn last_reads(count: int, ins: List<Ins>) -> List<int> {
    mut out = [-1 for j in 0..count]
    for at, i in ins {
        for r in reads_of(i) { out.set(r.index, at) }
    }
    out
}

/// WHERE EACH REGISTER DIES: its last read, or the last read of a view
/// riding its reference. A view is defined after what it rides, so a
/// reverse walk has folded the view's own riders in before it. A view
/// of ANY type rides: an enum's payload word is typed as a scalar and
/// may still point into the box.
fn death_points(twins: List<bool>, ins: List<Ins>, last: List<int>) -> List<int> {
    mut out = [t for t in last]
    // LICENSED loops.index_walk: a REVERSE walk — a view's riders fold in before it does
    mut j = ins.length - 1
    while j >= 0 {
        let i = ins[j]
        let d: Reg? = view_of(i)
        if d != null && !twins[j] {
            let dies = out[d!.index]
            for r in reads_of(i) {
                if dies > out[r.index] { out.set(r.index, dies) }
            }
        }
        j = j - 1
    }
    out
}

/// THE INSTRUCTION DEFINING each register; -1 for a param.
fn def_sites(count: int, ins: List<Ins>) -> List<int> {
    mut out = [-1 for j in 0..count]
    for at, i in ins {
        let d: Reg? = dst_of(i)
        if d != null { out.set(d!.index, at) }
    }
    out
}

/// Whether the innermost open scope owns `r`.
fn owned_top(open_scopes: Stack<Scope>, r: Reg) -> bool {
    let top? = open_scopes.top() else { return false }
    top.managed.any(same_reg(it, r))
}

/// Whether the open scopes hold exactly one reference to `r`.
fn owned_once(open_scopes: Stack<Scope>, r: Reg) -> bool {
    flatten([open_scopes.at(j).managed for j in 0..open_scopes.depth()])
        .filter(same_reg(it, r))
        .length == 1
}

/// The innermost scope GIVES UP one reference to `r`: it moved on.
fn disowns(mut open_scopes: Stack<Scope>, r: Reg) {
    let top? = open_scopes.top() else { return }
    open_scopes.rewrite_top(top with { managed: kept_out(top.managed, r) })
}
