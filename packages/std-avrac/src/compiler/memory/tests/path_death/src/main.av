// A value read on a path that leaves the fn moves there; every other path still owns it, and
// settles it as before.
type Note = { name: string, tags: List<string> }

fn filed(names: List<string>, name: string, early: bool) -> List<string> {
    mut out = [n for n in names]
    let held = name + "!"
    if early {
        out.push(held)
        return out
    }
    out.push(held + "?")
    out
}

fn first_long(words: List<string>) -> List<Note> {
    mut kept: List<Note> = []
    for w in words {
        let n = Note { name: w + w, tags: [w] }
        if w.length > 3 {
            kept.push(n)
            return kept
        }
        kept.push(n)
    }
    kept
}

fn stored(name: string, early: bool) -> string {
    let held = name + "#"
    let box: Cell<string> = Cell.new("")
    if early {
        box.set(held)
        return box.get()
    }
    "${held}${held}"
}

fn tagged(name: string, early: bool, deep: bool) -> string {
    let held = name + "~"
    if early {
        let joined = held + "!"
        if deep { return "deep" }
        return joined
    }
    held + "?"
}

let a = filed(["x"], "y", true).join(",")
let b = filed(["x"], "y", false).join(",")
let c = [n.name for n in first_long(["ab", "cd", "efgh", "ij"])].join(",")
let d = first_long(["a", "b"]).length
let e = "${tagged("u", true, true)} ${tagged("v", true, false)} ${tagged("w", false, false)}"
"${a} ${b} ${c} ${d} ${stored("s", true)} ${stored("t", false)} ${e}"
