// proves: a borrow read off a cell stays owned across a call that writes that cell, handed only a
// scalar: `emptied` reaches the module `state` through its unit and replaces the list the read rides,
// so a read of it after the call that stayed a borrow would read a freed list.
fn joined(n: int) -> string { ["name", "${n}"].join("-") }

state names: List<string> = [joined(1), joined(2)]

fn emptied(n: int) -> int {
    names = [joined(n)]
    n
}

fn first_across(n: int) -> string {
    let held = names
    mut seen = 0
    mut at = 0
    while at < held.length {
        seen = seen + emptied(n + at)
        at = at + 1
    }
    "${held[0]} ${held[1]} ${held.length} ${seen} ${names[0]}"
}

first_across(7)
