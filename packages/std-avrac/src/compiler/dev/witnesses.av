        },
        CodeWitness {
            code: "type.named_arg",
            witness: Witness.Source("fn sub(a: int, b: int) -> int { a - b }\nsub(a: 1, c: 2)"),
        },
        CodeWitness {
            code: "type.param_default",
            witness: Witness.Source("fn o(a: int = 1, b: int) -> int { b }\no(1, 2)"),
        },
        CodeWitness {
            code: "type.binds_twice",
            witness: Witness
                .Source("enum E {\n    A(n: int, m: int)\n}\nmatch E.A(1, 2) {\n    .A(n, n) -> n\n}"),
        },
        CodeWitness {
            code: "type.alias_copy",
            witness: Witness
