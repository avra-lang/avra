/// The one module body a module witness imports from.
const util_fn: string = "export fn f() -> int { 1 }\n"

/// A lawful manifest, for a witness to add one wrong line to.
export const app_manifest: string = "[package]\nname = \"app\"\nversion = \"0.1.0\"\n"

/// A package witness whose program sees `@std/meta`, vendored in memory.
export fn with_meta(main: string) -> Witness { with_meta_modules(main, {}) }

/// `with_meta`, with more files of the program's own beside the entry.
fn with_meta_modules(main: string, more: Map<string, string>) -> Witness {
    mut files = {
        "/w/avra.toml": app_manifest + "\n[dependencies]\n\"@std/meta\" = { path = \"vendor/meta\" }\n",
        "/w/src/main.av": main,
    }
    for path, text in more { files.set(path, text) }
    Witness.Package(vendored_meta(files))
}

/// A package witness whose program imports from a provider package,
/// `@x/c`, whose one file is `provider` — a component declared elsewhere.
export fn with_provider(main: string, provider: string) -> Witness {
    let meta_dep = "[dependencies]\n\"@std/meta\" = { path = \"vendor/meta\" }\n"
    Witness
        .Package(
            vendored_meta(
                {
                    "/w/avra.toml": app_manifest + "\n" + meta_dep + "\"@x/c\" = { path = \"vendor/c\" }\n",
                    "/w/src/main.av": main,
                    "/w/vendor/c/avra.toml": "[package]\nname = \"@x/c\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@std/meta\" = { path = \"../meta\" }\n",
                    "/w/vendor/c/src/c.av": "use @std.meta.{Code}\n" + provider,
                },
            ),
        )
}

/// A package witness whose toolchain carries the real `@std/task`.
export fn with_task(main: string) -> Witness {
    Witness.Package(vendored_task({"/w/avra.toml": app_manifest, "/w/src/main.av": main}))
}

/// A package witness whose toolchain carries the real `@std/time`.
export fn with_time(main: string) -> Witness {
    Witness.Package(vendored_time({"/w/avra.toml": app_manifest, "/w/src/main.av": main}))
}

/// A package witness whose toolchain carries the real `@std/prelude`, so
/// its program reads `println` as a file in a package does.
fn with_prelude(main: string) -> Witness {
    Witness.Package(vendored_prelude({"/w/avra.toml": app_manifest, "/w/src/main.av": main}))
}

/// A dependency that asks for raw linker options, under an app that names it.
fn borrowed_raw() -> Witness {
    Witness
        .Package(
            {
                "/w/avra.toml": app_manifest + "\n[dependencies]\n\"@acme/dep\" = { path = \"vendor/dep\" }\n",
                "/w/src/main.av": "use @acme.dep.{d}\nd(1)\n",
                "/w/vendor/dep/avra.toml": "[package]\nname = \"@acme/dep\"\nversion = \"0.1.0\"\n\n[link.raw]\nflags = [\"-o\", \"/tmp/x\"]\n",
                "/w/vendor/dep/src/dep.av": "export fn d(n: int) -> int { n }\n",
            },
        )
}

/// A package witness over files laid out as the program at `/w`, beside a
/// lawful manifest.
fn program(files: Map<string, string>) -> Witness {
    mut all = files
    all.set("/w/avra.toml", app_manifest)
    Witness.Package(all)
}

/// A package witness over one manifest and the one-line program beside it.
export fn manifest(toml: string) -> Witness {
    Witness.Package({"/w/avra.toml": toml, "/w/src/main.av": "1\n"})
}

/// Where the planner's refusals are witnessed: a planned relation's marks
/// need `@std/meta`, which a lone source cannot import.
const planned_golden: string = "a planned relation's `@plans` marks come from `@std/meta`, which a lone source cannot import — the golden is features/lists/tests/plan_test.av"

/// Where the identity law's refusal is witnessed: `@identity` is judged
/// by resolving to `@std/meta`'s own declaration, which a lone source
/// cannot import.
const identity_clash_golden: string = "two variant names fold to one 64-bit identity, which no source can be written to produce — the refusal is reached only by a hash collision"
const identity_golden: string = "`@identity` resolves to `@std/meta`'s own declaration, which a lone source cannot import — the golden is features/structs/tests/identity_test.av"
const guard_value_golden: string = "`guarded` is `@std/meta`'s own declaration, which a lone source cannot import — the golden is features/fns/tests/contained_test.av"
const unbroken_golden: string = "`@unbroken` resolves to `@std/meta`'s own declaration, which a lone source cannot import — the golden is compiler/tests/unbroken_test.av"

const never_ends_golden: string = "a `channel` needs `@std/task`'s carrier, which a lone source cannot import — the golden is features/tasks/tests/channel_test.av"
const lacks_golden: string = "`@lacks` resolves to `@std/meta`'s own declaration, which a lone source cannot import — the golden is features/structs/tests/lacks_test.av"

const quiet_never_golden: string = "a timer is `@std/time`'s own declaration, which a lone source cannot import — the golden is features/select_expr/tests/select_expr_test.av"
