            code: "lower.host_fn_unasked",
            witness: near_far_program(
                "use @x.near.{used}\nextern fn page_row(n: int) -> int {\n    n\n}\n\"\${used(1)}\"",
                "use @std.meta.{Host, host}\n@host(Host.Page)\nextern fn far_event(n: int) -> int {\n    n\n}\n",
            ),
        },
        CodeWitness {
            code: "lower.host_fn_unhosted",
            witness: near_far_program(unhosted_main, "extern fn far_event(n: int) -> int {\n    n\n}\n"),
        },
        CodeWitness {
            code: "lower.host_fn_answers",
            witness: near_far_program(
                "use @x.near.{used}\nuse @x.far.{helper}\n\"\${used(helper(1))}\"",
                "use @std.meta.{Host, host}\n@host(Host.Page)\nextern fn page_row(n: int) -> int {\n    0\n}\n",
            ),
