        CodeWitness {
            code: "type.provided_kind",
            witness: Witness
                .Beyond(
                    "`provided` is `@std/meta`'s, which a lone source cannot import — the golden is features/fns/tests/provided_test.av",
                ),
        },
        CodeWitness {
            code: "annotation.receiver",
            witness: Witness.Source("fn tag() { }\n@tag\ntype P = { x: int }\nP { x: 2 }.x"),
        },
        CodeWitness { code: "type.named", witness: Witness.Source("type X = X\n1") },
        CodeWitness {
            code: "annotation.unread_mark",
            witness: Witness.Source("enum E {\n    @nobody A\n}"),
        },
        CodeWitness {
            code: "type.derive_contract",
            witness: Witness.Source("trait T {\n    static fn derive(n: int) -> int { n }\n}\n1"),
        },
        CodeWitness {
            code: "type.extern_value",
            witness: Witness
                .Source(
                    "extern fn avra_host_is_dir(path: string) -> int\nlet f = avra_host_is_dir\nf(\"corpus\")",
                ),
