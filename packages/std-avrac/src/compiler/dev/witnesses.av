                "use near.{used}\nextern fn far_event(n: int) -> int {\n    n\n}\nused(1)\n",
                {
                    "/w/src/near.av": "use far.{helper}\nexport fn used(n: int) -> int {\n    helper(n)\n}\n",
                    "/w/src/far.av": "export fn helper(n: int) -> int {\n    n * 2\n}\nextern fn far_event(n: int) -> int {\n    n + 40\n}\n",
                },
