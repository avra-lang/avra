    rows
}

/// The one module body a module witness imports from.
const util_fn: string = "export fn f() -> int { 1 }\n"

const other_fn: string = "export fn f() -> int { 2 }\n"

const private_h_one: string = "fn h() -> int { 1 }\n"

const private_h_two: string = "fn h() -> int { 2 }\n"

/// A program with `@std/meta` beside it, built — and the modules beside its entry.
fn meta_program(main: string, modules: Map<string, string> = {}) -> Witness {
    mut files = {
        "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@std/meta\" = { path = \"vendor/meta\" }\n",
        "/w/src/main.av": main,
    }
    for path, text in modules { files.set(path, text) }
    Witness.Built(vendored_meta(files))
}

/// A program over one provider package `@x/c` (which sees `@std/meta`), built.
fn provided_program(main: string, provider: string) -> Witness {
    Witness.Built(provided_files(main, provider, real_meta_source()))
}

fn provided_files(main: string, provider: string, meta: string) -> Map<string, string> {
    vendored_meta_as(
        {
            "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@std/meta\" = { path = \"vendor/meta\" }\n\"@x/c\" = { path = \"vendor/c\" }\n",
            "/w/src/main.av": main,
            "/w/vendor/c/avra.toml": "[package]\nname = \"@x/c\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@std/meta\" = { path = \"../meta\" }\n",
            "/w/vendor/c/src/c.av": provider,
        },
        meta,
    )
}

/// The sublanguage provider the block witnesses stand on: a `sql` grammar over a record.
const sql_provider: string = "export type Select = { cols: List<string>, relation: string, cond: Where? }\nexport type Where = { col: string, value: int }\nexport fn query(cols: List<string>, relation: string, cond: Where?) -> Select { Select { cols: cols, relation: relation, cond: cond } }\nexport fn eq(col: string, value: int) -> Where { Where { col: col, value: value } }\nexport grammar sql {\n    select = \"SELECT\" c:NAME ( \",\" c:NAME )* \"FROM\" t:NAME ( \"WHERE\" w:where )? -> query(c, t, w)\n    where = c:NAME \"=\" v:NAME -> eq(c, v)\n}\n"

/// The annotation fns the annotation witnesses stand on.
const annotators: string = "use @std.meta.{Fn, Type, Named, Decls, Diagnostic, Directive, Declared, refuse, refuse_as}\nexport fn plain(f: Fn) -> List<Diagnostic> {\n    [refuse(\"`\${f.name}` is plain\")]\n}\nexport fn badkind(f: Fn) -> List<Diagnostic> {\n    [refuse_as(\"not a word\", \"a refusal under a bad kind\")]\n}\nexport trait Traps {\n    static fn derive(t: Type) -> Declared {\n        let none: List<Directive> = []\n        Declared { made: [none[3]] }\n    }\n}\nexport trait Fields {\n    static fn derive(t: Type) -> List<Directive> {\n        let rows: List<Decls> = [quote { enum E { A } }]\n        [Directive { twin: \"\", name: \"gen\", at: t.at, source: quote { fn gen(..\${rows}) {} } }]\n    }\n}\n"

/// A program over the same provider whose `@std/meta` has a moved shape.
fn moved_meta_program(main: string) -> Witness {
    Witness.Built(provided_files(main, annotators, real_meta_source().replace("message", "msg")))
}

/// A program `app` over two packages: `@x/near`, which names an extern bodiless
/// and imports `@x/far`; and `@x/far`, which declares `far_src` — built.
/// The program the unhosted witness and its remedy row share: it answers `page_row` and imports `@x/far`.
const unhosted_main: string = "use @x.near.{used}\nuse @x.far.{helper}\nextern fn page_row(n: int) -> int {\n    n\n}\n\"\${used(helper(1))}\""

fn near_far_program(main: string, far_src: string) -> Witness {
    Witness
        .Built(
            vendored_meta(
                {
                    "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@std/meta\" = { path = \"vendor/meta\" }\n\"@x/near\" = { path = \"vendor/near\" }\n\"@x/far\" = { path = \"vendor/far\" }\n",
                    "/w/src/main.av": main,
                    "/w/vendor/near/avra.toml": "[package]\nname = \"@x/near\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@x/far\" = { path = \"../far\" }\n",
                    "/w/vendor/near/src/near.av": "use @x.far.{helper}\nextern fn page_row(n: int) -> int\nexport fn used(n: int) -> int {\n    page_row(helper(n))\n}\n",
                    "/w/vendor/far/avra.toml": "[package]\nname = \"@x/far\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@std/meta\" = { path = \"../meta\" }\n",
                    "/w/vendor/far/src/far.av": "export fn helper(n: int) -> int {\n    n * 2\n}\n" + far_src,
                },
            ),
        )
}

/// An annotated fn the `plain` annotation refuses.
const plain_main: string = "use @x.c.{plain}\n@plain\nfn f() -> int { 1 }\nf()"

/// A program of one entry and the files beside it, built.
fn entry_program(main: string, others: Map<string, string>) -> Witness {
    mut files = {"/w/avra.toml": app_manifest, "/w/src/main.av": main}
    for path, text in others { files.set(path, text) }
    Witness.Built(files)
}

/// A lawful manifest, for a witness to add one wrong line to.
export const app_manifest: string = "[package]\nname = \"app\"\nversion = \"0.1.0\"\n"

/// A package witness whose program sees `@std/meta`, vendored in memory.
export fn with_meta(main: string) -> Witness { with_meta_modules(main, {}) }

/// `with_meta`, with more files of the program's own beside the entry.
fn with_meta_modules(main: string, more: Map<string, string>) -> Witness {
    mut files = {
        "/w/avra.toml": app_manifest + "\n[dependencies]\n\"@std/meta\" = { path = \"vendor/meta\" }\n",
        "/w/src/main.av": main,
    }
    for path, text in more { files.set(path, text) }
    Witness.Package(vendored_meta(files))
}

/// A package witness whose program imports from a provider package,
/// `@x/c`, whose one file is `provider` — a component declared elsewhere.
export fn with_provider(main: string, provider: string) -> Witness {
    let meta_dep = "[dependencies]\n\"@std/meta\" = { path = \"vendor/meta\" }\n"
    Witness
        .Package(
            vendored_meta(
                {
                    "/w/avra.toml": app_manifest + "\n" + meta_dep + "\"@x/c\" = { path = \"vendor/c\" }\n",
                    "/w/src/main.av": main,
                    "/w/vendor/c/avra.toml": "[package]\nname = \"@x/c\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@std/meta\" = { path = \"../meta\" }\n",
                    "/w/vendor/c/src/c.av": "use @std.meta.{Code}\n" + provider,
                },
            ),
        )
}

/// A package witness whose toolchain carries the real `@std/task`.
export fn with_task(main: string) -> Witness {
    Witness.Package(vendored_task({"/w/avra.toml": app_manifest, "/w/src/main.av": main}))
}

/// A package witness whose toolchain carries the real `@std/time`.
export fn with_time(main: string) -> Witness {
    Witness.Package(vendored_time({"/w/avra.toml": app_manifest, "/w/src/main.av": main}))
}

/// A package witness whose toolchain carries the real `@std/prelude`, so
/// its program reads `println` as a file in a package does.
fn with_prelude(main: string) -> Witness {
    Witness.Package(vendored_prelude({"/w/avra.toml": app_manifest, "/w/src/main.av": main}))
}

/// A dependency that asks for raw linker options, under an app that names it.
fn borrowed_raw() -> Witness {
    Witness
        .Package(
            {
                "/w/avra.toml": app_manifest + "\n[dependencies]\n\"@acme/dep\" = { path = \"vendor/dep\" }\n",
                "/w/src/main.av": "use @acme.dep.{d}\nd(1)\n",
                "/w/vendor/dep/avra.toml": "[package]\nname = \"@acme/dep\"\nversion = \"0.1.0\"\n\n[link.raw]\nflags = [\"-o\", \"/tmp/x\"]\n",
                "/w/vendor/dep/src/dep.av": "export fn d(n: int) -> int { n }\n",
            },
        )
}

/// A package witness over files laid out as the program at `/w`, beside a
/// lawful manifest.
fn program(files: Map<string, string>) -> Witness {
    mut all = files
    all.set("/w/avra.toml", app_manifest)
    Witness.Package(all)
}

/// A package witness over one manifest and the one-line program beside it.
export fn manifest(toml: string) -> Witness {
    Witness.Package({"/w/avra.toml": toml, "/w/src/main.av": "1\n"})
}

/// A vendored package's manifest.
fn package_toml(name: string, rows: string, scope: string = "@x") -> string {
    "[package]\nname = \"${scope}/${name}\"\nversion = \"1.0.0\"\n${rows}"
}

/// A package that depends on each `vendored` name under `vendor/`, beside the vendored
/// manifests in `more` — what a dependency's own manifest refuses is a property of the graph.
fn dependency_package(vendored: List<string>, more: Map<string, string>) -> Witness {
    mut files: Map<string, string> = {
        "/w/avra.toml": package_toml("root", "\n[dependencies]\n${rows_of(vendored)}"),
        "/w/src/main.av": "1\n",
    }
    for path, text in more { files.set(path, text) }
    Witness.Package(files)
}

/// One `[dependencies]` row a vendored name.
fn rows_of(vendored: List<string>) -> string {
    joined(
        ["\"${if n == "prelude" { "@std" } else { "@x" }}/${n}\" = { path = \"vendor/${n}\" }\n" for n in vendored],
        "",
    )
}

/// Where the planner's refusals are witnessed: a planned relation's marks
/// need `@std/meta`, which a lone source cannot import.
const planned_golden: string = "a planned relation's `@plans` marks come from `@std/meta`, which a lone source cannot import — the golden is features/lists/tests/plan_test.av"

/// Where the identity law's refusal is witnessed: `@identity` is judged
/// by resolving to `@std/meta`'s own declaration, which a lone source
/// cannot import.
const identity_clash_golden: string = "two variant names fold to one 64-bit identity, which no source can be written to produce — the refusal is reached only by a hash collision"
const identity_golden: string = "`@identity` resolves to `@std/meta`'s own declaration, which a lone source cannot import — the golden is features/structs/tests/identity_test.av"
const guard_value_golden: string = "`guarded` is `@std/meta`'s own declaration, which a lone source cannot import — the golden is features/fns/tests/contained_test.av"
const unbroken_golden: string = "`@unbroken` resolves to `@std/meta`'s own declaration, which a lone source cannot import — the golden is compiler/tests/unbroken_test.av"

const never_ends_golden: string = "a `channel` needs `@std/task`'s carrier, which a lone source cannot import — the golden is features/tasks/tests/channel_test.av"
const lacks_golden: string = "`@lacks` resolves to `@std/meta`'s own declaration, which a lone source cannot import — the golden is features/structs/tests/lacks_test.av"

/// Where the code-hash law is witnessed: a const's settlement speaks it, and the
/// user reads it carried in `const.trap`'s words.
const code_hash_golden: string = "the refusal is spoken inside a const's settlement and reaches a program as `const.trap` carrying its words — the golden is compiler/tests/code_hash_test.av"

/// Why the wrap-kind guard has no witness: it speaks for a declaration that
/// carries a body root yet is no fn or method (a seat default, a spec case),
/// and no annotation stands on either.
/// Where the directive-twin refusals are witnessed: the real `@std/meta` deliberately ships no annotator that generates a twin or wraps a fn, so the fixtures are the test's own.
const meta_probes_golden: string = "the real `@std/meta` ships no annotator that generates a twin or wraps a fn, so the fixtures are the suite's own — the golden is features/annotations/tests/annotations_adversarial_test.av"

const wrap_kind_golden: string = "a declaration with a body root that is no fn or method is a seat default or a spec case, and no annotation can stand on either — `@a` before `then` is a parse error"

const quiet_never_golden: string = "a timer is `@std/time`'s own declaration, which a lone source cannot import — the golden is features/select_expr/tests/select_expr_test.av"
