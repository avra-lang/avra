//! WHAT TRIGGERS EACH REFUSAL, as source the compiler runs. A
//! registered code's golden is the compiler over its witness, so the
//! rendering in docs/DIAGNOSTICS.md is MADE rather than written, and
//! a voice whose wording drifts fails there.
//!
//! WHY THE WITNESS AND NOT THE PROSE. A kind keys many LAWS, not one:
//! 45 kinds carry more than one law and `type.mismatch` carries 38,
//! so a row cannot hold the message. Moving the prose into a template
//! would also trade a compiler-checked interpolation for an unchecked
//! hole map, where a mistyped hole name is silent. The witness keeps
//! every voice as it is and makes the golden anyway.
//!
//! A WITNESS THAT NO LONGER TRIGGERS ITS KIND IS A GREEN TEST PROVING
//! NOTHING — the compiler moves under it, it starts producing some
//! other code, and the golden pins that instead. So the run asserts
//! the witness PRODUCED its code, and the count is of the ones that
//! fired.
use core.{joined}
use diagnostics.{DiagCode, new_source_file}
use compiler.{avra}

/// How a code is witnessed. ABSENCE HAS TWO CAUSES and they are named
/// apart: a code nobody has written a witness for is a DEBT, and one
/// no lone source can reach is a FACT — as one nullable they read
/// alike, and only the first is work.
export enum Witness {
    Absent
    Source(text: string)
    Beyond(why: string)
}

impl Witness {
    /// Whether this witness RUNS — the only kind whose silence is a
    /// defect. ASKED AS A MATCH, never `is .Source`: a boolean over
    /// one variant of a registry enum falls through for every variant
    /// added after it, which is a hole in different clothes.
    fn runs() -> bool {
        match self { .Source(_) -> true, .Absent or .Beyond(_) -> false }
    }

    /// Whether this code is still owed a witness — a debt, where an
    /// unreachable one is a fact.
    fn owed() -> bool {
        match self { .Absent -> true, .Source(_) or .Beyond(_) -> false }
    }
}

/// One code's witness, as the registry spells it.
export type CodeWitness = { code: string, witness: Witness }

/// One code's witness, run: what the compiler actually said, and
/// whether the code it claims to show came out.
export type Shown = { code: DiagCode, witness: Witness, rendered: string, fired: bool }

impl Shown {
    /// The source the witness ran, when one ran — empty otherwise, so
    /// a caller showing it prints nothing rather than a placeholder.
    fn witness_source() -> string {
        match self.witness { .Source(text) -> text, .Absent or .Beyond(_) -> "" }
    }
}

/// Every registered code with its witness run, in registry order —
/// which is feature order, which is the language.
export fn shown_codes() -> List<Shown> {
    [shown(c) for c in avra().rows.codes]
}

fn shown(c: DiagCode) -> Shown {
    let w = witness_for(c.kind)
    let out = rendered_over(w)
    Shown { code: c, witness: w, rendered: out, fired: out.contains("[${c.kind}]") }
}

/// The compiler's own words over a witness; nothing where no source
/// reaches the code.
fn rendered_over(w: Witness) -> string {
    match w {
        .Source(text) -> avra().check(new_source_file("witness.av", text)),
        .Absent or .Beyond(_) -> "",
    }
}

/// One code's witness, run — what `avra docs` shows beside the
/// summary: a REAL refusal with its holes filled, never a template.
export fn shown_code(kind: string) -> Shown? {
    let c? = avra().rows.codes.find(it.kind == kind) else { return null }
    shown(c)
}

/// The codes a witness row names that the registry does not — the
/// other direction a registry forgets in.
export fn stray_witnesses() -> List<string> {
    [w.code for w in witnesses() if !avra().rows.codes.any(it.kind == w.code)]
}

/// The codes a SECOND row would shadow — the lookup takes the first
/// match, so a duplicate row silently never runs and its author would
/// see the other one's golden.
export fn shadowed_witnesses() -> List<string> {
    [w.code for w in witnesses() if rows_for(w.code) > 1]
}

fn rows_for(code: string) -> int {
    [w for w in witnesses() if w.code == code].length
}

fn witness_for(code: string) -> Witness {
    witnesses().find(it.code == code)?.witness ?? Witness.Absent
}

/// The codes whose witness no longer produces them — the shape this
/// registry exists to refuse.
export fn silent_witnesses(runs: List<Shown>) -> List<Shown> {
    [s for s in runs if s.witness.runs() && !s.fired]
}

/// The codes no witness reaches yet.
export fn unwitnessed(runs: List<Shown>) -> List<Shown> {
    [s for s in runs if s.witness.owed()]
}

/// THE ERROR INDEX: every registered code, its meaning, the source
/// that triggers it, and what the compiler says. Generated, compared
/// by `make witnesses`, and the golden for every voice it reaches.
export fn diagnostics_index(runs: List<Shown>) -> string {
    joined([index_head()].concat([entry(s) for s in runs]), "\n")
}

/// The index's head: what it is and who makes it — never a running total,
/// which every change adding a code would rewrite (`avra diagnostics` says
/// the totals on stderr).
fn index_head() -> string {
    joined(
        [
            "# The diagnostics index",
            "",
            "GENERATED by `avra diagnostics` from the assembled registry —",
            "`make witnesses` refuses an index the compiler did not make. Each",
            "entry's rendering is the compiler's own words over the witness",
            "beside it, so a voice whose wording drifts shows up here as a diff.",
            "Its totals are `avra diagnostics`' own line on stderr, never this file's.",
        ],
        "\n",
    )
}

fn entry(s: Shown) -> string {
    joined(["", "## ${s.code.kind}", "", s.code.summary, ""].concat(body(s)), "\n")
}

fn body(s: Shown) -> List<string> {
    match s.witness {
        .Source(text) -> ["```avra", text, "```", "", "```", s.rendered, "```"],
        .Beyond(why) -> ["No witness here: ${why}."],
        .Absent -> ["No witness yet."],
    }
}

/// THE WITNESSES. Each is a whole program the compiler runs; a code
/// with no row here is a debt the index names, so forgetting one is
/// visible rather than silent. EACH TRIGGERS ONE CODE where it can:
/// a source that refuses twice puts both refusals in both entries,
/// and the golden then pins another code's wording as this one's.
fn witnesses() -> List<CodeWitness> {
    let rows: List<CodeWitness> = [
        CodeWitness { code: "lex.error", witness: Witness.Source("let a = 1\n\$\nlet b = 2") },
        CodeWitness { code: "parse.expected", witness: Witness.Source("}") },
        CodeWitness {
            code: "lower.no_projection",
            witness: Witness.Source("type P = { x: int }\nP { x: 1 }"),
        },
        CodeWitness { code: "type.mismatch", witness: Witness.Source("!5") },
        CodeWitness {
            code: "type.unknown",
            witness: Witness.Source("fn f(x: decimal) -> int { 1 }\nf(1)"),
        },
        CodeWitness { code: "type.unknown_prop", witness: Witness.Source("let n = 3\nn.x") },
        CodeWitness { code: "type.list_element", witness: Witness.Source("[1, true]\n2") },
        CodeWitness {
            code: "type.list_scalar",
            witness: Witness.Source("let xs = [null, null]\n1"),
        },
        CodeWitness { code: "type.interp_hole", witness: Witness.Source("\"\${[1, 2]}\"") },
        CodeWitness {
            code: "type.struct_scalar",
            witness: Witness.Source("type P = { x: void }\n1"),
        },
        CodeWitness {
            code: "type.duplicate_field",
            witness: Witness.Source("type P = { x: int, x: bool }\nlet p = P { x: 1 }\n2"),
        },
        CodeWitness { code: "type.identity_field", witness: Witness.Beyond(identity_golden) },
        CodeWitness { code: "flow.broken", witness: Witness.Beyond(unbroken_golden) },
        CodeWitness { code: "type.lacks", witness: Witness.Beyond(lacks_golden) },
        CodeWitness {
            code: "type.struct_fields",
            witness: Witness.Source("type P = { x: int }\nlet p = P { x: true }\n2"),
        },
        CodeWitness {
            code: "type.with_struct",
            witness: Witness.Source("let n = 3\nlet m = n with { x: 1 }\n2"),
        },
        CodeWitness { code: "type.enum_decl", witness: Witness.Source("enum E { }\n1") },
        CodeWitness {
            code: "type.match",
            witness: Witness.Source("let n = 3\nmatch n {\n    .a -> 1\n}"),
        },
        CodeWitness {
            code: "type.type_value",
            witness: Witness.Source("type P = { x: int }\nmut p = P\n1"),
        },
        CodeWitness {
            code: "type.variant_arity",
            witness: Witness.Source("enum S {\n    a(int)\n    b\n}\nlet x = S.a()\n2"),
        },
        CodeWitness {
            code: "type.enum_payload",
            witness: Witness.Source("enum E {\n    a(void)\n    b\n}\n1"),
        },
        CodeWitness {
            code: "collect_enum.trait",
            witness: Witness
                .Source(
                    "type Nope = {}\ntype Dot = {}\ncollect enum Shape: Nope = @numbered in self by it.mark.args[0] dense\n1",
                ),
        },
        CodeWitness { code: "type.coalesce", witness: Witness.Source("null ?? 1") },
        CodeWitness {
            code: "type.applied",
            witness: Witness.Source("let m: Map<int, int> = {}\n1"),
        },
        CodeWitness {
            code: "type.duplicate_param",
            witness: Witness.Source("fn f(a: int, a: int) -> int { a }\nf(1, 2)"),
        },
        CodeWitness { code: "type.force", witness: Witness.Source("let n = 1\nn!") },
        CodeWitness {
            code: "type.match_opt",
            witness: Witness.Source("match null {\n    v? -> 1\n    null -> 2\n}"),
        },
        CodeWitness { code: "type.chain", witness: Witness.Source("let n = 1\nn?.x") },
        CodeWitness { code: "type.binding", witness: Witness.Source("let x: int = true\nx") },
        CodeWitness { code: "type.return", witness: Witness.Source("return 1") },
        CodeWitness {
            code: "type.propagate",
            witness: Witness.Source("fn f() -> int {\n    let n = 1\n    n?\n}\nf()"),
        },
        CodeWitness { code: "type.let_else", witness: Witness.Source("let v? = 1 else { 1 }\nv") },
        CodeWitness {
            code: "type.fail",
            witness: Witness.Source("fn f() -> int {\n    fail 1\n}\nf()"),
        },
        CodeWitness { code: "type.catch", witness: Witness.Source("let n = 1 catch 2\nn") },
        CodeWitness { code: "type.method", witness: Witness.Source("[1].reverse()") },
        CodeWitness {
            code: "type.impl",
            witness: Witness.Source("impl Nope {\n    fn f() -> int { 1 }\n}\n1"),
        },
        CodeWitness {
            code: "type.trait",
            witness: Witness
                .Source(
                    "trait T {\n    fn m() -> int\n}\ntype P = { x: int }\nimpl T for P {\n    fn m() -> int { 1 }\n    fn extra() -> int { 2 }\n}\n1",
                ),
        },
        CodeWitness { code: "type.lambda", witness: Witness.Source("null()") },
        CodeWitness {
            code: "type.place",
            witness: Witness.Source("fn grow(xs: List<int>) { xs.push(1) }\nmut v = [1]\ngrow(v)\nv.length"),
        },
        CodeWitness { code: "type.map_key", witness: Witness.Source("let m = {1: 2}\n1") },
        CodeWitness {
            code: "type.map_value",
            witness: Witness.Source("let m = {\"a\": 1, \"b\": true}\n1"),
        },
        CodeWitness {
            code: "type.map_entry",
            witness: Witness.Source("let m = {\"a\": 1}\nm.entries().length"),
        },
        CodeWitness {
            code: "type.member_pattern",
            witness: Witness.Source("enum E {\n    a(int)\n}\nmatch E.a(1) {\n    .a as x -> 1\n}"),
        },
        CodeWitness {
            code: "type.or_binds",
            witness: Witness
                .Source("enum E {\n    a(int)\n    b\n}\nmatch E.a(1) {\n    .a(n) or .b -> n\n}"),
        },
        CodeWitness {
            code: "type.registry_hole",
            witness: Witness
                .Source(
                    "enum Q {\n    A\n    B\n    C\n    D\n}\nmatch Q.B {\n    .A -> 1\n    .B -> 2\n    _ -> 0\n}",
                ),
        },
        CodeWitness {
            code: "type.const_pattern",
            witness: Witness
                .Source(
                    "enum M {\n    A\n    B\n}\nconst a = M.A\nfn f(m: M) -> int {\n    match m {\n        .A -> 1\n        .B -> 2\n        a -> 3\n    }\n}\nf(M.B)",
                ),
        },
        CodeWitness {
            code: "type.unreachable_arm",
            witness: Witness
                .Source(
                    "fn f(c: int) -> int {\n    match c {\n        gone -> 1\n        _ -> 0\n    }\n}\nf(9)",
                ),
        },
        CodeWitness { code: "type.list", witness: Witness.Source("[x for x in 1]") },
        CodeWitness {
            code: "type.case",
            witness: Witness.Source("spec \"s\" {\n    given \"g\" {\n        then \"t\" { 1 }\n    }\n}"),
        },
        CodeWitness { code: "type.variant_lit", witness: Witness.Source("let x = .foo\n1") },
        CodeWitness { code: "type.coalesce_never", witness: Witness.Source("1 ?? 2") },
        CodeWitness { code: "type.mut_fn", witness: Witness.Source("mut fn f() -> int { 1 }\nf()") },
        CodeWitness {
            code: "type.receiver",
            witness: Witness
                .Source(
                    "type B = { xs: List<int> }\nimpl B {\n    fn put(v: int) { self.xs.push(v) }\n}\nlet b = B { xs: [] }\nb.put(1)\nb.xs.length",
                ),
        },
        CodeWitness {
            code: "type.seat",
            witness: Witness.Source("fn f(mut n: int) -> int { n }\nf(1)"),
        },
        CodeWitness {
            code: "type.mut_fn_unused",
            witness: Witness
                .Source(
                    "type C = { n: int }\nimpl C {\n    mut fn get() -> int { self.n }\n}\nmut c = C { n: 1 }\nc.get()",
                ),
        },
        CodeWitness {
            code: "type.seat_unused",
            witness: Witness.Source("fn show(mut n: int) -> int { n }\nmut k = 5\nshow(k)"),
        },
        CodeWitness { code: "type.defer_inert", witness: Witness.Source("errdefer 1") },
        CodeWitness { code: "loop.jump", witness: Witness.Source("break") },
        CodeWitness {
            code: "loop.label",
            witness: Witness.Source("for x in [1] {\n    let y = x\n    break y\n}"),
        },
        CodeWitness {
            code: "type.once_fn",
            witness: Witness.Source("once fn seed() -> int { 7 }\nseed()"),
        },
        CodeWitness { code: "type.shift_count", witness: Witness.Source("1 << 99") },
        CodeWitness {
            code: "type.static_name",
            witness: Witness.Source("enum E {\n    a\n}\nimpl E {\n    static fn a() -> int { 1 }\n}\n1"),
        },
        CodeWitness {
            code: "const.trap",
            witness: Witness
                .Source(
                    "fn boom(n: int) -> int {\n    n / 0\n}\nconst Z: int = boom(1)\nfn twice() -> int {\n    Z + Z\n}\ntwice() + Z",
                ),
        },
        CodeWitness {
            code: "annotation.receiver",
            witness: Witness.Source("fn tag() { }\n@tag\ntype P = { x: int }\nP { x: 2 }.x"),
        },
        CodeWitness { code: "type.named", witness: Witness.Source("type X = X\n1") },
        CodeWitness {
            code: "annotation.unread_mark",
            witness: Witness.Source("enum E {\n    @nobody A\n}"),
        },
        CodeWitness {
            code: "type.derive_contract",
            witness: Witness.Source("trait T {\n    static fn derive(n: int) -> int { n }\n}\n1"),
        },
        CodeWitness {
            code: "type.extern_value",
            witness: Witness
                .Source(
                    "extern fn avra_host_is_dir(path: string) -> int\nlet f = avra_host_is_dir\nf(\"corpus\")",
                ),
        },
        CodeWitness {
            code: "type.named_arg",
            witness: Witness.Source("fn sub(a: int, b: int) -> int { a - b }\nsub(a: 1, c: 2)"),
        },
        CodeWitness {
            code: "type.param_default",
            witness: Witness.Source("fn o(a: int = 1, b: int) -> int { b }\no(1, 2)"),
        },
        CodeWitness {
            code: "type.binds_twice",
            witness: Witness
                .Source("enum E {\n    A(n: int, m: int)\n}\nmatch E.A(1, 2) {\n    .A(n, n) -> n\n}"),
        },
        CodeWitness {
            code: "type.alias_copy",
            witness: Witness
                .Source(
                    "type R = { n: int }\nimpl R {\n    mut fn bump() { self.n = self.n + 1 }\n}\nfn shadow(p: R) {\n    mut q = p\n    q.bump()\n}\n1",
                ),
        },
        CodeWitness {
            code: "type.task_escape",
            witness: Witness.Source("fn start() -> Task<int> {\n    spawn 1\n}\n1"),
        },
        CodeWitness {
            code: "type.component_expand",
            witness: Witness
                .Beyond(
                    "a component's `expand` answers `@std/meta`'s `Code`, which a lone source cannot import — the golden is features/components/tests/components_template_adversarial_test.av",
                ),
        },
        CodeWitness {
            code: "type.component_body",
            witness: Witness.Source("component made {\n    let x = 1\n}\n0"),
        },
        CodeWitness {
            code: "type.component_head",
            witness: Witness
                .Beyond(
                    "an instance's component is another file's, which a lone source cannot import — the golden is features/components/tests/components_head_test.av",
                ),
        },
        CodeWitness {
            code: "type.component_twice",
            witness: Witness
                .Beyond(
                    "a template is a `quote` of `@std/meta`'s `Code`, which a lone source cannot import — the golden is features/components/tests/components_template_adversarial_test.av",
                ),
        },
        CodeWitness {
            code: "type.component_event",
            witness: Witness
                .Beyond(
                    "an instance's component is another file's, which a lone source cannot import — the golden is features/components/tests/components_test.av",
                ),
        },
        CodeWitness { code: "type.plan_residual", witness: Witness.Beyond(planned_golden) },
        CodeWitness { code: "type.plans_mismatch", witness: Witness.Beyond(planned_golden) },
        CodeWitness { code: "type.plan_scan", witness: Witness.Beyond(planned_golden) },
        CodeWitness { code: "resolve.unresolved", witness: Witness.Source("nope(1)") },
        CodeWitness { code: "resolve.use_before_def", witness: Witness.Source("x\nlet x = 1") },
        CodeWitness {
            code: "resolve.hole_bound",
            witness: Witness
                .Beyond(
                    "a binder named through a hole comes from a derive, which a lone source cannot import — the golden is features/quote/tests/seat_hygiene_test.av",
                ),
        },
        CodeWitness { code: "resolve.reserved", witness: Witness.Source("if()") },
        CodeWitness {
            code: "resolve.duplicate_fn",
            witness: Witness.Source("fn f(x: int) -> int { x }\nfn f(y: int) -> int { y }\nf(1)"),
        },
        CodeWitness {
            code: "resolve.nested_fn",
            witness: Witness.Source("fn f() -> int {\n    fn g() -> int { 1 }\n    2\n}\nf()"),
        },
        CodeWitness { code: "resolve.immutable", witness: Witness.Source("let x = 1\nx = 2\nx") },
        CodeWitness {
            code: "resolve.duplicate_type",
            witness: Witness.Source("type P = { x: int }\nenum P {\n    a\n}\n1"),
        },
        CodeWitness {
            code: "resolve.nested_type",
            witness: Witness.Source("fn f() -> int {\n    enum E {\n        a\n    }\n    1\n}\nf()"),
        },
        CodeWitness {
            code: "resolve.builtin_type",
            witness: Witness.Source("enum bool {\n    a\n}"),
        },
        CodeWitness { code: "resolve.place", witness: Witness.Source("1 = 2") },
        CodeWitness {
            code: "resolve.paired",
            witness: Witness.Source("for i, i in [1] {\n    1\n}\n1"),
        },
        CodeWitness { code: "resolve.unpackaged", witness: Witness.Source("use util.{twice}\n1\n") },
        CodeWitness {
            code: "resolve.runtime_binding",
            witness: Witness.Source("let x = 1\nfn f() -> int { x }\nf()"),
        },
        CodeWitness {
            code: "resolve.nested_spec",
            witness: Witness.Source("fn f() -> int {\n    spec \"s\" { }\n    1\n}\nf()"),
        },
        CodeWitness {
            code: "resolve.duplicate_case",
            witness: Witness
                .Source(
                    "spec \"s\" {\n    given \"g\" {\n        then \"t\" { true }\n        then \"t\" { true }\n    }\n}",
                ),
        },
        CodeWitness { code: "resolve.receiver", witness: Witness.Source("let self = 1\nself") },
        CodeWitness {
            code: "resolve.nested_impl",
            witness: Witness
                .Source("fn f() -> int {\n    impl X {\n        fn g() -> int { 1 }\n    }\n    1\n}\nf()"),
        },
        CodeWitness {
            code: "manifest.no_source",
            witness: Witness
                .Beyond(
                    "it names a directory's own shape — no src/ and no direct .av file — which no lone source text can stand in for",
                ),
        },
    ]
    rows
}

/// Where the planner's refusals are witnessed: a planned relation's marks
/// need `@std/meta`, which a lone source cannot import.
const planned_golden: string = "a planned relation's `@plans` marks come from `@std/meta`, which a lone source cannot import — the golden is features/lists/tests/plan_test.av"

/// Where the identity law's refusal is witnessed: `@identity` is judged
/// by resolving to `@std/meta`'s own declaration, which a lone source
/// cannot import.
const identity_golden: string = "`@identity` resolves to `@std/meta`'s own declaration, which a lone source cannot import — the golden is features/structs/tests/identity_test.av"
const unbroken_golden: string = "`@unbroken` resolves to `@std/meta`'s own declaration, which a lone source cannot import — the golden is compiler/tests/unbroken_test.av"
const lacks_golden: string = "`@lacks` resolves to `@std/meta`'s own declaration, which a lone source cannot import — the golden is features/structs/tests/lacks_test.av"
