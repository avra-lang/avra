//! WHAT TRIGGERS EACH REFUSAL, as source the compiler runs. A
//! registered code's golden is the compiler over its witness, so the
//! rendering in docs/DIAGNOSTICS.md is MADE rather than written, and
//! a voice whose wording drifts fails there.
//!
//! WHY THE WITNESS AND NOT THE PROSE. A kind keys many LAWS, not one:
//! 45 kinds carry more than one law and `type.mismatch` carries 38,
//! so a row cannot hold the message. Moving the prose into a template
//! would also trade a compiler-checked interpolation for an unchecked
//! hole map, where a mistyped hole name is silent. The witness keeps
//! every voice as it is and makes the golden anyway.
//!
//! A WITNESS THAT NO LONGER TRIGGERS ITS KIND IS A GREEN TEST PROVING
//! NOTHING — the compiler moves under it, it starts producing some
//! other code, and the golden pins that instead. So the run asserts
//! the witness PRODUCED its code, and the count is of the ones that
//! fired.
use core.{joined}
use diagnostics.{DiagCode, new_source_file}
use compiler.{avra, new_workspace, one_shot_let_go}
use compiler.host.{memory_host}
use testing.{vendored_meta, vendored_prelude, vendored_task, vendored_time}

/// How a code is witnessed. ABSENCE HAS TWO CAUSES and they are named
/// apart: a code nobody has written a witness for is a DEBT, and one
/// no lone source can reach is a FACT — as one nullable they read
/// alike, and only the first is work.
export enum Witness {
    Absent
    Source(text: string)
    /// A program at `/w`, file by file — what a manifest or a module
    /// path refuses is a property of a package, not of a lone source.
    Package(files: Map<string, string>)
    Beyond(why: string)
}

impl Witness {
    /// Whether this witness RUNS — the only kind whose silence is a
    /// defect. ASKED AS A MATCH, never `is .Source`: a boolean over
    /// one variant of a registry enum falls through for every variant
    /// added after it, which is a hole in different clothes.
    fn runs() -> bool {
        match self { .Source(_) or .Package(_) -> true, .Absent or .Beyond(_) -> false }
    }

    /// Whether this code is still owed a witness — a debt, where an
    /// unreachable one is a fact.
    fn owed() -> bool {
        match self { .Absent -> true, .Source(_) or .Package(_) or .Beyond(_) -> false }
    }
}

/// One code's witness, as the registry spells it.
export type CodeWitness = { code: string, witness: Witness }

/// One code's witness, run: what the compiler actually said, and
/// whether the code it claims to show came out.
export type Shown = { code: DiagCode, witness: Witness, rendered: string, fired: bool }

impl Shown {
    /// The source the witness ran, when one ran — empty otherwise, so
    /// a caller showing it prints nothing rather than a placeholder.
    fn witness_source() -> string {
        match self.witness {
            .Source(text) -> text,
            .Package(files) -> package_text(files),
            .Absent or .Beyond(_) -> "",
        }
    }
}

/// Every registered code with its witness run, in registry order —
/// which is feature order, which is the language.
export fn shown_codes() -> List<Shown> {
    [shown(c) for c in avra().rows.codes]
}

fn shown(c: DiagCode) -> Shown {
    let w = witness_for(c.kind)
    let out = rendered_over(w)
    Shown { code: c, witness: w, rendered: out, fired: out.contains("[${c.kind}]") }
}

/// The compiler's own words over a witness; nothing where no source
/// reaches the code.
export fn rendered_over(w: Witness) -> string {
    match w {
        .Source(text) -> avra().check(new_source_file("witness.av", text)),
        .Package(files) -> package_report(files),
        .Absent or .Beyond(_) -> "",
    }
}

/// A package witness's files, each under its path.
fn package_text(files: Map<string, string>) -> string {
    joined(["// ${path}\n${text}" for path, text in files if !is_carried(path)], "\n")
}

/// Whether a package witness's file is the toolchain's, laid out beside the
/// program — never the witness itself, so a golden does not print it.
fn is_carried(path: string) -> bool { path.starts_with("/w/vendor/") || path.starts_with("/std/") }

/// A package witness compiled: its files laid out in memory at `/w`,
/// and what the program there says. One one-shot workspace is alive at a
/// time, so the one before is let go.
fn package_report(files: Map<string, string>) -> string {
    one_shot_let_go()
    let host = memory_host(files, files.keys())
    let ws = new_workspace(
        if files.keys().any(it.starts_with("/std/")) { host with { std_root: "/std" } } else { host },
        "/w",
        avra(),
    )
    ws.alone()
    let entry: string? = if files.has("/w/src/main.av") { "/w/src/main.av" } else { null }
    match ws.program(entry).check() { .Ok(warned) -> warned, .Err(report) -> report }
}

/// One code's witness, run — what `avra docs` shows beside the
/// summary: a REAL refusal with its holes filled, never a template.
export fn shown_code(kind: string) -> Shown? {
    let c? = avra().rows.codes.find(it.kind == kind) else { return null }
    shown(c)
}

/// The codes a witness row names that the registry does not — the
/// other direction a registry forgets in.
export fn stray_witnesses() -> List<string> {
    [w.code for w in witnesses() if !avra().rows.codes.any(it.kind == w.code)]
}

/// The codes a SECOND row would shadow — the lookup takes the first
/// match, so a duplicate row silently never runs and its author would
/// see the other one's golden.
export fn shadowed_witnesses() -> List<string> {
    [w.code for w in witnesses() if rows_for(w.code) > 1]
}

fn rows_for(code: string) -> int {
    [w for w in witnesses() if w.code == code].length
}

fn witness_for(code: string) -> Witness {
    witnesses().find(it.code == code)?.witness ?? Witness.Absent
}

/// The codes whose witness no longer produces them — the shape this
/// registry exists to refuse.
export fn silent_witnesses(runs: List<Shown>) -> List<Shown> {
    [s for s in runs if s.witness.runs() && !s.fired]
}

/// The codes no witness reaches yet.
export fn unwitnessed(runs: List<Shown>) -> List<Shown> {
    [s for s in runs if s.witness.owed()]
}

/// THE ERROR INDEX: every registered code, its meaning, the source
/// that triggers it, and what the compiler says. Generated, compared
/// by `make witnesses`, and the golden for every voice it reaches.
export fn diagnostics_index(runs: List<Shown>) -> string {
    joined([index_head()].concat([entry(s) for s in runs]), "\n")
}

/// The index's head: what it is and who makes it — never a running total,
/// which every change adding a code would rewrite (`avra diagnostics` says
/// the totals on stderr).
fn index_head() -> string {
    joined(
        [
            "# The diagnostics index",
            "",
            "GENERATED by `avra diagnostics` from the assembled registry —",
            "`make witnesses` refuses an index the compiler did not make. Each",
            "entry's rendering is the compiler's own words over the witness",
            "beside it, so a voice whose wording drifts shows up here as a diff.",
            "Its totals are `avra diagnostics`' own line on stderr, never this file's.",
        ],
        "\n",
    )
}

fn entry(s: Shown) -> string {
    joined(["", "## ${s.code.kind}", "", s.code.summary, ""].concat(body(s)), "\n")
}

fn body(s: Shown) -> List<string> {
    match s.witness {
        .Source(text) -> ["```avra", text, "```", "", "```", s.rendered, "```"],
        .Package(files) -> ["```", package_text(files), "```", "", "```", s.rendered, "```"],
        .Beyond(why) -> ["No witness here: ${why}."],
        .Absent -> ["No witness yet."],
    }
}

/// THE WITNESSES. Each is a whole program the compiler runs; a code
/// with no row here is a debt the index names, so forgetting one is
/// visible rather than silent. EACH TRIGGERS ONE CODE where it can:
/// a source that refuses twice puts both refusals in both entries,
/// and the golden then pins another code's wording as this one's.
fn witnesses() -> List<CodeWitness> {
    let rows: List<CodeWitness> = [
        CodeWitness { code: "lex.error", witness: Witness.Source("let a = 1\n\$\nlet b = 2") },
        CodeWitness { code: "parse.expected", witness: Witness.Source("}") },
        CodeWitness {
            code: "lower.no_projection",
            witness: Witness.Source("type P = { x: int }\nP { x: 1 }"),
        },
        CodeWitness {
            code: "type.mismatch",
            witness: Witness.Source("let a = !5\nfn f(n: int) -> int { n }\nlet v: int? = null\nf(v)"),
        },
        CodeWitness {
            code: "type.unknown",
            witness: Witness.Source("fn f(x: decimal) -> int { 1 }\nf(1)"),
        },
        CodeWitness {
            code: "type.unknown_prop",
            witness: Witness.Source("let n = 3\nn.x\nlet xs = [1]\nxs.lengt\nlet ys = [1]\nys.push"),
        },
        CodeWitness { code: "type.list_element", witness: Witness.Source("[1, true]\n2") },
        CodeWitness {
            code: "type.list_scalar",
            witness: Witness.Source("let xs = [null, null]\n1"),
        },
        CodeWitness { code: "type.interp_hole", witness: Witness.Source("\"\${[1, 2]}\"") },
        CodeWitness {
            code: "type.struct_scalar",
            witness: Witness.Source("type P = { x: void }\n1"),
        },
        CodeWitness {
            code: "type.duplicate_field",
            witness: Witness.Source("type P = { x: int, x: bool }\nlet p = P { x: 1 }\n2"),
        },
        CodeWitness { code: "type.identity_field", witness: Witness.Beyond(identity_golden) },
        CodeWitness { code: "shape.identity_clash", witness: Witness.Beyond(identity_clash_golden) },
        CodeWitness { code: "flow.broken", witness: Witness.Beyond(unbroken_golden) },
        CodeWitness {
            code: "flow.select",
            witness: Witness
                .Source(
                    "fn one() -> int {\n    1\n}\nfn hush() {\n}\nlet job = spawn one()\n@fair select {\n    r in job -> hush()\n}",
                ),
        },
        CodeWitness { code: "type.guard_value", witness: Witness.Beyond(guard_value_golden) },
        CodeWitness { code: "flow.arm", witness: Witness.Source("select {\n    1 -> 2\n}") },
        CodeWitness {
            code: "flow.arm_binder",
            witness: Witness
                .Source(
                    "fn one() -> int {\n    1\n}\nlet job = spawn one()\nselect {\n    i, r in job -> r\n}",
                ),
        },
        CodeWitness {
            code: "flow.spent_arm",
            witness: Witness
                .Source(
                    "fn one() -> int {\n    1\n}\nlet jobs = [spawn one()]\nmut n = 0\nwhile n < 1 {\n    n = n + select {\n        r in jobs -> r\n    }\n}",
                ),
        },
        CodeWitness {
            code: "flow.guard_binder",
            witness: Witness
                .Source(
                    "fn one() -> int {\n    1\n}\nlet job = spawn one()\nselect {\n    r in job if r > 0 -> r\n}",
                ),
        },
        CodeWitness { code: "flow.quiet_never", witness: Witness.Beyond(quiet_never_golden) },
        CodeWitness { code: "flow.fresh_deadline", witness: Witness.Beyond(quiet_never_golden) },
        CodeWitness { code: "flow.channel", witness: Witness.Source("channel<int>(2)\n0") },
        CodeWitness { code: "flow.never_ends", witness: Witness.Beyond(never_ends_golden) },
        CodeWitness {
            code: "flow.unbounded_cleanup",
            witness: Witness
                .Source(
                    "extern fn avra_fiber_sleep(ms: int)\nfn clean() {\n    defer avra_fiber_sleep(1)\n}\nclean()",
                ),
        },
        CodeWitness { code: "type.lacks", witness: Witness.Beyond(lacks_golden) },
        CodeWitness {
            code: "type.struct_fields",
            witness: Witness.Source("type P = { x: int, y: string }\nlet p = P { x: true, y: 5 }\n2"),
        },
        CodeWitness {
            code: "type.with_struct",
            witness: Witness.Source("let n = 3\nlet m = n with { x: 1 }\n2"),
        },
        CodeWitness { code: "type.enum_decl", witness: Witness.Source("enum E { }\n1") },
        CodeWitness {
            code: "type.match",
            witness: Witness.Source("let n = 3\nmatch n {\n    .a -> 1\n}"),
        },
        CodeWitness {
            code: "type.type_value",
            witness: Witness.Source("type P = { x: int }\nmut p = P\n1"),
        },
        CodeWitness {
            code: "type.variant_arity",
            witness: Witness.Source("enum S {\n    a(int)\n    b\n}\nlet x = S.a()\n2"),
        },
        CodeWitness {
