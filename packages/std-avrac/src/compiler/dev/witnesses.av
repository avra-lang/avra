        },
        CodeWitness {
            code: "collect_enum.trait",
            witness: Witness
                .Source(
                    "type Nope = {}\ntype Dot = {}\ncollect enum Shape: Nope = @numbered in self by it.mark.args[0] dense\n1",
                ),
        },
        CodeWitness {
            code: "collect_enum.empty",
            witness: Witness.Source("collect enum Shape = @numbered in self by it.name\n1"),
        },
        CodeWitness { code: "type.coalesce", witness: Witness.Source("null ?? 1") },
        CodeWitness {
            code: "type.applied",
            witness: Witness.Source("let m: Map<int, int> = {}\n1"),
        },
        CodeWitness {
            code: "type.duplicate_param",
            witness: Witness.Source("fn f(a: int, a: int) -> int { a }\nf(1, 2)"),
        },
        CodeWitness { code: "type.force", witness: Witness.Source("let n = 1\nn!") },
        CodeWitness {
            code: "type.match_opt",
            witness: Witness.Source("match null {\n    v? -> 1\n    null -> 2\n}"),
        },
        CodeWitness { code: "type.chain", witness: Witness.Source("let n = 1\nn?.x") },
        CodeWitness {
            code: "type.binding",
            witness: Witness.Source("let x: int = true\nlet y: string = 5\nx"),
        },
        CodeWitness { code: "type.return", witness: Witness.Source("return 1") },
        CodeWitness {
            code: "type.propagate",
            witness: Witness.Source("fn f() -> int {\n    let n = 1\n    n?\n}\nf()"),
        },
        CodeWitness { code: "type.let_else", witness: Witness.Source("let v? = 1 else { 1 }\nv") },
        CodeWitness {
            code: "type.fail",
            witness: Witness.Source("fn f() -> int {\n    fail 1\n}\nf()"),
        },
        CodeWitness { code: "type.catch", witness: Witness.Source("let n = 1 catch 2\nn") },
        CodeWitness { code: "type.method", witness: Witness.Source("[1].reverse()\n[1].lenght()") },
        CodeWitness {
            code: "type.impl",
            witness: Witness.Source("impl Nope {\n    fn f() -> int { 1 }\n}\n1"),
        },
        CodeWitness {
            code: "type.trait",
            witness: Witness
                .Source(
                    "trait T {\n    fn m() -> int\n}\ntype P = { x: int }\nimpl T for P {\n    fn m() -> int { 1 }\n    fn extra() -> int { 2 }\n}\n1",
                ),
        },
        CodeWitness { code: "type.lambda", witness: Witness.Source("null()") },
        CodeWitness {
            code: "type.place",
            witness: Witness.Source("fn grow(xs: List<int>) { xs.push(1) }\nmut v = [1]\ngrow(v)\nv.length"),
        },
        CodeWitness { code: "type.map_key", witness: Witness.Source("let m = {1: 2}\n1") },
        CodeWitness {
            code: "type.map_value",
            witness: Witness.Source("let m = {\"a\": 1, \"b\": true}\n1"),
        },
        CodeWitness {
            code: "type.map_entry",
            witness: Witness.Source("let m = {\"a\": 1}\nm.entries().length"),
        },
        CodeWitness {
            code: "type.member_pattern",
            witness: Witness.Source("enum E {\n    a(int)\n}\nmatch E.a(1) {\n    .a as x -> 1\n}"),
        },
        CodeWitness {
            code: "type.or_binds",
            witness: Witness
                .Source("enum E {\n    a(int)\n    b\n}\nmatch E.a(1) {\n    .a(n) or .b -> n\n}"),
        },
        CodeWitness {
            code: "type.registry_hole",
            witness: Witness
                .Source(
                    "enum Q {\n    A\n    B\n    C\n    D\n}\nmatch Q.B {\n    .A -> 1\n    .B -> 2\n    _ -> 0\n}",
                ),
        },
        CodeWitness {
            code: "type.const_pattern",
            witness: Witness
                .Source(
                    "enum M {\n    A\n    B\n}\nconst a = M.A\nfn f(m: M) -> int {\n    match m {\n        .A -> 1\n        .B -> 2\n        a -> 3\n    }\n}\nf(M.B)",
                ),
        },
        CodeWitness {
            code: "type.unreachable_arm",
            witness: Witness
                .Source(
                    "fn f(c: int) -> int {\n    match c {\n        gone -> 1\n        _ -> 0\n    }\n}\nf(9)",
                ),
        },
        CodeWitness { code: "type.list", witness: Witness.Source("[x for x in 1]") },
        CodeWitness {
            code: "type.case",
            witness: Witness.Source("spec \"s\" {\n    given \"g\" {\n        then \"t\" { 1 }\n    }\n}"),
        },
        CodeWitness { code: "type.variant_lit", witness: Witness.Source("let x = .foo\n1") },
        CodeWitness { code: "type.coalesce_never", witness: Witness.Source("1 ?? 2") },
        CodeWitness { code: "type.mut_fn", witness: Witness.Source("mut fn f() -> int { 1 }\nf()") },
        CodeWitness {
            code: "type.receiver",
            witness: Witness
                .Source(
                    "type B = { xs: List<int> }\nimpl B {\n    fn put(v: int) { self.xs.push(v) }\n}\nlet b = B { xs: [] }\nb.put(1)\nb.xs.length",
                ),
        },
        CodeWitness {
            code: "type.seat",
            witness: Witness.Source("fn f(mut n: int) -> int { n }\nf(1)"),
        },
        CodeWitness {
            code: "type.mut_fn_unused",
            witness: Witness
                .Source(
                    "type C = { n: int }\nimpl C {\n    mut fn get() -> int { self.n }\n}\nmut c = C { n: 1 }\nc.get()",
                ),
        },
        CodeWitness {
            code: "type.seat_unused",
            witness: Witness.Source("fn show(mut n: int) -> int { n }\nmut k = 5\nshow(k)"),
        },
        CodeWitness { code: "type.defer_inert", witness: Witness.Source("errdefer 1") },
        CodeWitness { code: "loop.jump", witness: Witness.Source("break") },
        CodeWitness {
            code: "loop.label",
            witness: Witness.Source("for x in [1] {\n    let y = x\n    break y\n}"),
        },
        CodeWitness {
            code: "type.once_fn",
            witness: Witness.Source("once fn seed() -> int { 7 }\nseed()"),
        },
        CodeWitness { code: "type.shift_count", witness: Witness.Source("1 << 99") },
        CodeWitness {
            code: "type.static_name",
            witness: Witness.Source("enum E {\n    a\n}\nimpl E {\n    static fn a() -> int { 1 }\n}\n1"),
        },
        CodeWitness {
            code: "const.trap",
            witness: Witness
                .Source(
                    "fn boom(n: int) -> int {\n    n / 0\n}\nconst Z: int = boom(1)\nfn twice() -> int {\n    Z + Z\n}\ntwice() + Z",
                ),
        },
        CodeWitness {
            code: "annotation.receiver",
            witness: Witness.Source("fn tag() { }\n@tag\ntype P = { x: int }\nP { x: 2 }.x"),
        },
        CodeWitness { code: "type.named", witness: Witness.Source("type X = X\n1") },
        CodeWitness {
            code: "annotation.unread_mark",
            witness: Witness.Source("enum E {\n    @nobody A\n}"),
        },
        CodeWitness {
            code: "type.derive_contract",
            witness: Witness.Source("trait T {\n    static fn derive(n: int) -> int { n }\n}\n1"),
        },
        CodeWitness {
            code: "type.extern_value",
            witness: Witness
                .Source(
                    "extern fn avra_host_is_dir(path: string) -> int\nlet f = avra_host_is_dir\nf(\"corpus\")",
