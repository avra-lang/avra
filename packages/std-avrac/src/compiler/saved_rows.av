//! SAVED ANSWERS, ONE ROW EACH: an answer settled in one process is read back in the next while
//! every answer it stood on has the digest it had. A row is a plain unit per answer, never a
//! family answer, so no reader's read set grows a row per answer it reaches. What spoke, refused
//! or read something with no name is never kept, so a restored answer says nothing it did not
//! say when it ran.
use core.{DeclId, qtrace, traced, wreck, db_verified_typed, flatten, some_list}
use compiler.voices.{type_facts_fp}
use core.digest.{hex, unhex}
use features.{TypeFacts, Decl, Settled, Settlement, Unsettled}
use compiler.store.{Stored, node_key, read_spelled}
use compiler.families.{Family}
use @std.relation.db.{Db as RelDb, Leaf, leaf_read}
use @std.relation.engine.{Key}
use @std.relation.stable.{
    Scope,
    Writer,
    Reader,
    CodecFault,
    encoded_with,
    decoded_with,
    written_list,
    read_list,
}
use @std.text.{parse_int}

impl Workspace {
    /// A saved answer's text, while every read it was kept with still has its digest. Its reads
    /// are read again, so its readers stand where a run would have left them.
    fn saved_text(row: string, what: string) -> string? {
        let store? = self.store.get() else { return null }
        let rdb = self.decls.rows_db.get()
        let text? = store.get_valid(Stored.Unit, row, (n) -> rdb.leaf_digest(n)) else {
            if traced() {
                qtrace(
                    "Q\tsaved\tmissed\t${what}\t${self.first_moved(store, row, (n) -> rdb.leaf_digest(n))}\n",
                )
            }
            return null
        }
        let leaves? = kept_leaves(store.reads_of(Stored.Unit, row) ?? []) else { return null }
        rdb.read_leaves(leaves)
        // asking a signature declares what it declares — methods, impls, the members they
        // answer — which a run does on its way
        for d in self.sigs_read(leaves) { let _ = self.sig(d) }
        if traced() { qtrace("Q\tsaved\trestored\t${what}\n") }
        text
    }

    /// An answer this process settled at `k`, kept under what it stood on; nothing is kept for
    /// one whose read has no name, since it could never be judged again.
    fn saved_keep(row: string, k: Key, text: string, what: string) {
        let store? = self.store.get() else { return }
        let leaves? = self.decls.rows_db.get().leaves_of(self.db.kernel.deps_of(k)) else {
            if traced() { qtrace("Q\tsaved\tunnamed\t${what}\n") }
            return
        }
        let _ = store.keep_reading(Stored.Unit, row, text, saved_reads(leaves))
    }

    /// The declarations whose signatures a run read, among its leaves.
    fn sigs_read(leaves: List<Leaf>) -> List<DeclId> {
        let rdb = self.decls.rows_db.get()
        flatten([some_list(self.sig_leaf(rdb, l)) for l in leaves])
    }

    fn sig_leaf(rdb: RelDb, l: Leaf) -> DeclId? {
        match l {
            .Input(name, spelled, _) -> {
                let owner? = rdb.answer_named(name) else { return null }
                if owner.family_now() != Family.Sig.ordinal { return null }
                let arg? = owner.arg_of(spelled) else { return null }
                DeclId { index: arg }
            },
            .Rows(_, _) -> null,
        }
    }
}

// ── a body's typing ──

impl Workspace {
    /// Where a declaration's kept typing stands.
    fn typed_row(d: DeclId) -> string { node_key(Stored.Unit, ["typed", self.decl_ref(d)]) }

    /// A declaration's typing as kept; absent when it does not stand or read back whole.
    fn typed_restored(x: Decl) -> TypeFacts? {
        // a body reads back only over its own file's parse, while that file is not expanding
        if self.db.active(key(Family.Expanded, x.file.index)) { return null }
        if self.relation(Family.Parsed).values.entry(x.file.index) is .Missing { return null }
        let text? = self.saved_text(self.typed_row(x.id), x.name) else { return null }
        let octets? = unhex(text) else { return null }
        let facts? = facts_read(octets, self.facts_scope(x.lo, x.stmt_lo)) else { return null }
        if db_verified_typed() { self.restore_judged(x, facts) }
        facts
    }

    /// A restored body judged against a fresh typing of it: the two agree, or a read the row
    /// stood on is missing.
    fn restore_judged(x: Decl, kept: TypeFacts) {
        let ids = self.decls.ids()
        if type_facts_fp(kept, ids, true) != type_facts_fp(self.typed_fresh(x), ids, true) {
            wreck(
                "a restored body differs from a fresh typing of `${x.name}`: a read it stood on is missing",
            )
        }
    }

    /// A body this process typed, kept; one that spoke has no wire.
    fn typed_kept(x: Decl, facts: TypeFacts) {
        let octets? = facts_encoded_in(facts, self.facts_scope(x.lo, x.stmt_lo)) else { return }
        self.saved_keep(self.typed_row(x.id), key(Family.Typed, x.id.index), hex(octets), x.name)
    }
}

// ── a const's settlement ──

/// A settlement as its row keeps it: the value, the name buckets its run read together, and
/// the files its run read, which the file's record of runs is owed.
type SettledRow = { value: Settled, buckets: List<string>, reads: List<RunRead> }

impl Workspace {
    /// Where a const's kept settlement stands; none for an ask no row names: a const asked under
    /// seats, an expression root, a held file's const (its record answers it).
    fn settled_row(id: int) -> string? {
        let ask = self.settle_asks.get()[id]
        match ask.root { .Const(_) -> {}, .Expr(_) -> { return null } }
        if !ask.seats.is_empty() || self.is_held(ask.file) { return null }
        let name? = self.spelled_settle(id) else { return null }
        node_key(Stored.Unit, ["settled", name])
    }

    /// A const's settlement as kept; absent when it does not stand or read back whole. Its
    /// name buckets are gathered again first, since the row stands on their digest.
    fn settled_restored(id: int) -> Result<Settled, Unsettled>? {
        let row? = self.settled_row(id) else { return null }
        let store? = self.store.get() else { return null }
        let kept? = settled_row_of(store.get(Stored.Unit, row)) else { return null }
        if !kept.buckets.is_empty() {
            let at = self.group_at(Family.Settled, id)
            self
                .hold
                .groups
                .set_at(
                    at,
                    self.hold.groups.get()[at] with { buckets: [self.decls.name_bucket(n) for n in kept.buckets] },
                )
        }
        let _stood? = self.saved_text(row, self.settle_asks.get()[id].name) else { return null }
        self.read_by(self.decls.file(self.settle_asks.get()[id].file).path, kept.reads)
        self.hold.settle_reads.put("${id}", kept.reads)
        .Ok(kept.value)
    }

    /// A settlement this process ran, kept: only a value, and only from a run that asked no
    /// body a held file has, since that run read what no row can stand on.
    fn settled_kept(id: int, r: Result<Settled, Unsettled>, asked: int) {
        let row? = self.settled_row(id) else { return }
        let value = match r { .Ok(v) -> v, .Err(_) -> { return } }
        if self.hold.body_asks.get().length != asked { return }
        let at = self.hold.group_index.get().get("${Family.Settled.ordinal}:${id}")
        let names = [self.decls.bucket_name(b) for b in if at == null { [] } else { self.hold.groups.get()[at!].buckets }]
        if names.any(it == null) { return }
        let text = settled_row_text(
            SettledRow {
                value: value,
                buckets: [n! for n in names],
                reads: self.hold.settle_reads.get().get("${id}") ?? [],
            },
        )
        self.saved_keep(row, key(Family.Settled, id), text, self.settle_asks.get()[id].name)
    }
}

fn settled_row_text(r: SettledRow) -> string {
    hex(
        encoded_with(
            r,
            (w: Writer, x: SettledRow) -> {
                w.text(settlement_enum_wire(Settlement.Held(x.value)))
                written_list(w, x.buckets, (ww: Writer, n: string) -> ww.text(n))
                written_list(w, x.reads, (ww: Writer, rr: RunRead) -> ww.text(read_wire(rr)))
            },
        ),
    )
}

/// A kept settlement read back; absent for a row that does not read back whole.
fn settled_row_of(text: string?) -> SettledRow? {
    let t? = text else { return null }
    let octets? = unhex(t) else { return null }
    match decoded_with(octets, read_settled_row) { .Ok(r) -> r, .Err(_) -> null }
}

fn read_settled_row(r: Reader) -> Result<SettledRow, CodecFault> {
    let held? = settlement_enum_of_wire(r.text()?) else { fail CodecFault.OtherShape }
    let buckets = read_list(r, (rr: Reader) -> rr.text())?
    let reads = read_list(r, (rr: Reader) -> read_one_run(rr))?
    match held {
        .Held(v) -> .Ok(SettledRow { value: v, buckets: buckets, reads: reads }),
        .Refused(_) -> .Err(CodecFault.OtherShape),
    }
}

fn read_one_run(r: Reader) -> Result<RunRead, CodecFault> {
    let run? = read_of_wire(r.text()?) else { fail CodecFault.OtherShape }
    .Ok(run)
}

/// A table read back under its scope; absent for one that does not read back.
fn facts_read(octets: Bytes, scope: dyn Scope) -> TypeFacts? {
    match facts_decoded_in(octets, scope) { .Ok(facts) -> facts, .Err(_) -> null }
}

/// A row's kept reads as the leaves they were; absent when one is no leaf.
fn kept_leaves(lines: List<string>) -> List<Leaf>? {
    [leaf_read(r.name, parse_int(r.digest)?)? for r in [read_spelled(l)? for l in lines]]
}
