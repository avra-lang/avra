//! THE PER-FILE ANSWERS a file's saved diagnostics are made of, beside `parse_said`.
use core.{FileId}
use @std.relation.{query}
use diagnostics.{Diag}

/// A file's signature diagnostics, in the order the rounds spoke them. Its recorded reads are
/// the signatures of the file's own top-level declarations; their voices are placed by file
/// offsets, never by arena ids.
@query
export fn sig_said(ws: Workspace, f: FileId) -> List<Diag> { ws.sig_diagnostics(f) }
