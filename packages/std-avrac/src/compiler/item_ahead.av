//! A PROGRAM WORKED AHEAD across processes before the walk asks for anything, so the walk finds most
//! answers kept; a program whose last build stands but for a few moved inputs forks nothing: every file the program reads parsed, one wave of imports at a time, then the rest of
//! each package it reaches, whose impls are filed from every file; every such file's generators run;
//! the program's impls filed once; then every body its files declare typed and lowered, a file's
//! bodies in one process, which then finds what every law finds in the file, reached or not, so a
//! build fails on any error. A body the walk never reaches is lowered for nothing,
//! and a generic one waits for the walk, which alone knows its layouts.
use core.settings.{avrac_settings}
use @std.program.pass.{Pass}
use core.{some_list}
use @std.program.address.{SourceFileAddress, source_file}
use @std.program.layered_store.{LayeredStore}
use @std.program.disk_store.{wave_gathers}
use @std.program.query_engine.{QueryDefinition, QueryEngine, query_engine}
use @std.program.query_times.{QueryTimes, TimedSide, query_times}
use @std.program.sorted.{sorted_by}
use @std.program.source_facts.{source_text}
use @std.program.worked_ahead.{
    WorkAhead,
    Worked,
    asked_across,
    asked_beside,
    engine_worked_ahead,
    has_worked_ahead,
}
use @std.io.{env}

/// Where work ahead is kept and how it's done: the store's directory, the queries every process
/// answers, how many processes, whether each says where its time went, whether its engines count
/// what they work out from their first ask, and the program whose frontier its engines read.
type AheadAt = {
    directory: string,
    definitions: List<QueryDefinition>,
    process_count: int,
    timed: bool,
    counted: bool,
    program: string,
}

/// A body as the walk asks for it: a fn by its file and name, or a method by its impl.
enum DeclaredBody {
    Free(file: SourceFileAddress, name: string)
    Method(at: ImplAt, name: string, statics: bool)
}

/// The store at `directory` a program rooted at `package` is made from, and the engine over
/// `definitions` to make it with, worked ahead across `process_count` processes, or by none with
/// fewer than two or where the last build's frontier saw at most `FEW_MOVED` inputs move; with
/// `timed`, each process and each phase says where its time went. A file `vouched` names, read off the
/// first engine, stands on the verdict that vouches for it: no law is asked of it. Every engine
/// reads and keeps `program`'s frontier, counting what it works out from its first ask where
/// `counted`, and `work` says what the last wave works of each file.
export fn program_worked(
    directory: string,
    package: string,
    definitions: List<QueryDefinition>,
    process_count: int,
    timed: bool,
    vouched: fn(QueryEngine) -> List<string>,
    program: string = "",
    work: FileWork = FileWork.Built,
    counted: bool = false,
) -> Worked {
    let at = AheadAt {
        directory: directory,
        definitions: definitions,
        process_count: process_count,
        timed: timed,
        counted: counted,
        program: program,
    }
    wave_gathers(GATHERED)
    let alone = ahead(at, (_engine: QueryEngine) -> [], file_words_is_known, file_parsed)
    if process_count < 2 || few_moved(alone.engine) { return alone }
    let stands = vouched(alone.engine)
    let _ = alone.store.saved()
    let clock = query_times()
    clock.opened("files parsed", TimedSide.Outside, Pass.Tape)
    let parsed = files_parsed(at, package)
    clock.closed()
    clock.opened("generators run", TimedSide.Outside, Pass.Generate)
    let _ = parsed.worked.store.saved()
    let generated = ahead(
        at,
        (_engine: QueryEngine) -> parsed.reached,
        file_generated_is_known,
        generators_run,
    )
    clock.closed()
    clock.opened("impls filed", TimedSide.Outside, Pass.Summary)
    let filed = impls_filed_for(generated.engine, package)
    let _ = generated.store.saved()
    clock.closed()
    clock.opened("bodies lowered", TimedSide.Outside, Pass.Lower)
    let lowered = ahead(
        at,
        (_engine: QueryEngine) -> parsed.program,
        (e, f) -> file_work_is_known(e, f, work, stands.contains(spelled_file(f))),
        (e, f) -> file_work_done(e, f, work, stands.contains(spelled_file(f))),
    )
    clock.closed()
    if at.timed { eprintln(phases_said(clock, filed)) }
    lowered
}

/// EVERY BODY A PROGRAM'S WALK MET, PLACED ACROSS PROCESSES before the program's shape asks for any:
/// the walk, read from the bodies' facts, says which tests each body keeps, and each process
/// places the bodies it takes, reading each one's code once, so the asking process reads no
/// body's code at all. Only a build that worked ahead places ahead; whether any process ran.
export fn program_placed(worked: Worked, entry: SourceFileAddress, process_count: int, timed: bool) -> bool {
    if process_count < 2 || !has_worked_ahead() { return false }
    let walked = match program_walked(worked.engine, entry) {
        .Walked(w) -> w,
        .Unmade(_why, _at) -> { return false },
    }
    asked_across<WalkedUnit, int>(
        worked.store,
        worked.engine,
        WorkAhead {
            items: (_engine: QueryEngine) -> walked.units,
            is_known: unit_placed_is_known,
            ask: unit_placed,
            process_count: process_count,
            timed: timed,
        },
    )
}

/// A PROGRAM'S CODE HASHES ANSWERED BY ONE PROCESS BESIDE THE ASKING ONE, which does `meanwhile`
/// — what a build asks next that reads none of them — and takes them after; `meanwhile` answers
/// whether the build goes on to want them. The program's shape, which both read, is answered
/// before the fork. Only a build that worked ahead forks; whether `meanwhile` was done.
export fn program_shaped_beside(
    worked: Worked,
    entry: SourceFileAddress,
    process_count: int,
    timed: bool,
    meanwhile: fn() -> bool,
) -> bool {
    if process_count < 2 ||
        !has_worked_ahead() ||
        program_code_hashes_is_known(worked.engine, entry) { return false }
    let _ = program_reached(worked.engine, entry)
    asked_beside<SourceFileAddress, int>(
        worked.store,
        worked.engine,
        WorkAhead {
            items: (_engine: QueryEngine) -> [entry],
            is_known: program_code_hashes_is_known,
            ask: (engine: QueryEngine, file: SourceFileAddress) -> program_code_hashes(engine, file)
                .hashes
                .length,
            process_count: 1,
            timed: timed,
        },
        meanwhile,
    )
}

/// Whether anything is kept about the placing of the met body `u`.
fn unit_placed_is_known(engine: QueryEngine, u: WalkedUnit) -> bool {
    placed_names_is_known(engine, u.called, u.kept) &&
        placed_code_is_known(engine, u.called, u.kept)
}

/// The met body `u` placed, and its facts answered as the call that met it reads them: how many
/// names it names.
fn unit_placed(engine: QueryEngine, u: WalkedUnit) -> int {
    let _ = unit_facts(engine, u.called)
    let _ = placed_code(engine, u.called, u.kept)
    placed_names(engine, u.called, u.kept).length
}

/// The queries that gather a package's or a module's answer from its files': a process that needs
/// one while another gathers it gathers it too, each file's part worked by one of them.
const GATHERED: List<string> = [
    "package_gatherings",
    "collect_members",
    "generated_names",
    "module_declares",
    "module_bindings",
    "module_kept",
    "module_winners",
]

/// At most this many moved inputs are walked in this process alone: an edit re-asks a handful of
/// bodies, which a fork costs more than.
const FEW_MOVED: int = 8

/// Whether the last build's frontier stands but for at most `FEW_MOVED` moved inputs.
fn few_moved(engine: QueryEngine) -> bool {
    let moved? = engine.inputs_moved() else { return false }
    if avrac_settings().debug.query_times { eprintln("ahead: ${moved} inputs moved") }
    moved <= FEW_MOVED
}

/// The store `at` names and an engine over it, every item `items` answers that it knows nothing of
/// asked across its processes.
fn ahead<T>(
    at: AheadAt,
    items: fn(QueryEngine) -> List<T>,
    is_known: fn(QueryEngine, T) -> bool,
    ask: fn(QueryEngine, T) -> int,
) -> Worked {
    engine_worked_ahead<T, int>(
        at.directory,
        at.definitions,
        WorkAhead {
            items: items,
            is_known: is_known,
            ask: ask,
            process_count: at.process_count,
            timed: at.timed,
            counted: at.counted,
        },
        at.program,
    )
}

/// What parsing a program's files leaves for the waves after it: the store and engine it ended
/// with, every source file of each package the program reaches, and the files the program reads,
/// the longest first. The engine that worked the listings out names them once; an engine opened
/// after would prove each standing again, read by read.
type FilesParsed = { worked: Worked, reached: List<SourceFileAddress>, program: List<SourceFileAddress> }

/// The store `at` names with every file a program rooted at `package` reads parsed: the
/// package's own sources first, then each wave of files the last one's imports reach.
fn files_parsed(at: AheadAt, package: string) -> FilesParsed {
    mut worked = ahead(
        at,
        (engine: QueryEngine) -> own_sources(engine, package),
        file_words_is_known,
        file_parsed,
    )
    mut wave = own_sources(worked.engine, package)
    mut seen: Map<string, bool> = {}
    for f in wave { seen.set(spelled_file(f), true) }
    while true {
        let reached = worked.engine
        mut fresh: List<SourceFileAddress> = []
        for f in wave {
            for g in imports_of(reached, f) {
                if !seen.has(spelled_file(g)) {
                    seen.set(spelled_file(g), true)
                    fresh.push(g)
                }
            }
        }
        if fresh.is_empty() { return every_file_parsed(at, package, worked, seen) }
        let _ = worked.store.saved()
        let next = fresh
        worked = ahead(at, (_engine: QueryEngine) -> next, file_words_is_known, file_parsed)
        wave = next
    }
    every_file_parsed(at, package, worked, seen)
}

/// The store `at` names with every file of each package a program rooted at `package` reaches
/// parsed, beyond the `seen` files its imports reach: a package's impls are filed from all of them.
fn every_file_parsed(at: AheadAt, package: string, worked: Worked, seen: Map<string, bool>) -> FilesParsed {
    let reached = reached_files(worked.engine, package)
    let program = widest_first(worked.engine, program_files(worked.engine, package))
    let rest = reached.filter((f) -> !seen.has(spelled_file(f)))
    let _ = worked.store.saved()
    FilesParsed {
        worked: ahead(at, (_engine: QueryEngine) -> rest, file_words_is_known, file_parsed),
        reached: reached,
        program: program,
    }
}

/// Every source file of each package a program rooted at `package` reaches.
fn reached_files(engine: QueryEngine, package: string) -> List<SourceFileAddress> {
    [source_file(p, f) for p in package_reach(engine, package).packages for f in package_sources(engine, p, "src")]
}

/// The package's own source files.
fn own_sources(engine: QueryEngine, package: string) -> List<SourceFileAddress> {
    [source_file(package, p) for p in package_sources(engine, package, "src")]
}

/// Each file of every module `file`'s imports name.
fn imports_of(engine: QueryEngine, file: SourceFileAddress) -> List<SourceFileAddress> {
    [g for u in file_words(engine, file).uses for m in some_list(imported_module(engine, file, u)) for g in module_files(engine, m.package, m.local, m.as_root)]
}

/// `file` parsed: how many imports it reads.
fn file_parsed(engine: QueryEngine, file: SourceFileAddress) -> int { file_words(engine, file).uses.length }

/// `file`'s generators run: how many items they made.
fn generators_run(engine: QueryEngine, file: SourceFileAddress) -> int { file_generated(engine, file).items.length }

/// Every impl, written and generated, of each package a program rooted at `package` reaches, filed
/// once: how many packages.
fn impls_filed_for(engine: QueryEngine, package: string) -> int { package_reach(engine, package).packages.filter((p) -> impls_filed_in(engine, p)).length }

/// Every impl, written and generated, the package `package` holds, filed: whether it holds any.
fn impls_filed_in(engine: QueryEngine, package: string) -> bool {
    let written = package_impls(engine, package)
    let generated = package_generated_impls(engine, package)
    !written.parts.is_empty() || !generated.parts.is_empty()
}

/// `files`, the longest first, so processes taking turns share the work about evenly: a file's
/// length is read off its text, which costs nothing a build has not already read.
fn widest_first(engine: QueryEngine, files: List<SourceFileAddress>) -> List<SourceFileAddress> {
    let widths = [source_text(engine, f)?.length ?? 0 for f in files]
    [files[at] for at in sorted_by([at for at in 0..files.length], (a, b) -> widths[a] > widths[b])]
}

/// Where the asking process's time went, phase by phase, and how many packages hold impls.
fn phases_said(clock: QueryTimes, filed: int) -> string { "ahead phases: ${clock.spoken(10)}; impls filed in ${filed} packages" }

/// Whether anything is kept about the lowering of every body `file` declares, asking only what its
/// declarations are.
fn bodies_known(engine: QueryEngine, file: SourceFileAddress) -> bool { declared_bodies(engine, file).all((b) -> body_is_known(engine, b)) }

/// Every body `file` declares lowered: how many lowered.
fn bodies_lowered(engine: QueryEngine, file: SourceFileAddress) -> int { declared_bodies(engine, file).filter((b) -> body_lowered(engine, b)).length }

/// What a program's last wave works of each of its files: what a build of it reads, or what a check
/// of `package` reads, which is what its laws find and, in that package's own files, what they warn
/// of and what its rules find.
export enum FileWork {
    Built
    Checked(package: string)
}

/// Whether what `work` asks of `file` is kept, its laws standing where `vouched`.
fn file_work_is_known(engine: QueryEngine, file: SourceFileAddress, work: FileWork, vouched: bool) -> bool {
    match work {
        .Built -> file_worked_is_known(engine, file, vouched),
        .Checked(package) -> (vouched || file_erring_is_known(engine, file)) &&
            (file.package_name != package || file_rule_rows_is_known(engine, package, file)),
    }
}

/// What `work` asks of `file`, its laws standing where `vouched`: how many bodies it lowered, or
/// how many findings it holds.
fn file_work_done(engine: QueryEngine, file: SourceFileAddress, work: FileWork, vouched: bool) -> int {
    match work {
        .Built -> file_worked(engine, file, vouched),
        .Checked(package) -> file_checked(engine, file, package, vouched),
    }
}

/// What a check of `package` reads of `file`, its laws standing where `vouched`: how many findings
/// fail a build, then, in the package's own files, how many warn and how many rule rows stand.
fn file_checked(engine: QueryEngine, file: SourceFileAddress, package: string, vouched: bool) -> int {
    let erring = if vouched { 0 } else { file_erring(engine, file).errors }
    if file.package_name != package { return erring }
    erring +
        file_warned(engine, file).findings.length +
        file_rule_rows(engine, package, file).rows.length
}

/// Whether anything is kept about the lowering of every body `file` declares and, unless a verdict
/// vouches for it, about what its laws find, asking only what its declarations are.
fn file_worked_is_known(engine: QueryEngine, file: SourceFileAddress, vouched: bool) -> bool {
    (vouched || file_erring_is_known(engine, file)) && bodies_known(engine, file)
}

/// Every body `file` declares lowered, then, unless a verdict vouches for it, what every law finds in
/// its written items, in one process so the laws read the typing the lowering held, then what a
/// program's whole shape reads of the file alone: the host fns it declares, the fns its hosts are
/// judged against, and whether it runs a statement at its top. How many lowered.
fn file_worked(engine: QueryEngine, file: SourceFileAddress, vouched: bool) -> int {
    let lowered = bodies_lowered(engine, file)
    if !vouched { let _ = file_erring(engine, file) }
    let _ = file_host_fns(engine, file)
    let _ = file_bound_fns(engine, file)
    let _ = strays_in(engine, file)
    lowered
}

/// WHAT A PROGRAM OVER `file` READS OF IT, the file's laws aside: every body it declares lowered,
/// what a program's shape reads of it alone, and the names it declares. How many lowered.
export fn dependent_worked(engine: QueryEngine, file: SourceFileAddress) -> int {
    let _ = file_declares(engine, file)
    file_worked(engine, file, true)
}

/// Every body `file` declares, written or generated, that the walk asks for with no layouts.
fn declared_bodies(engine: QueryEngine, file: SourceFileAddress) -> List<DeclaredBody> { free_bodies(engine, file).concat(method_bodies(engine, file)) }

/// The fns `file` declares, written then generated.
fn free_bodies(engine: QueryEngine, file: SourceFileAddress) -> List<DeclaredBody> {
    [DeclaredBody.Free(file, d.name) for d in file_declares(engine, file).names.concat(generated_declares(engine, file).names) if d.kind == ItemKind.Fn]
}

/// The methods and statics of every impl in `file` whose target takes no type parameters, written
/// then generated, each impl where the walk finds it.
fn method_bodies(engine: QueryEngine, file: SourceFileAddress) -> List<DeclaredBody> {
    impl_declared_bodies(engine, file, written_impls(engine, file), false)
        .concat(impl_declared_bodies(engine, file, generated_impls(engine, file), true))
}

/// The methods and statics of `by_item`'s impls, the file's generated items' where `generated`,
/// else its written ones', each item by its id.
fn impl_declared_bodies(
    engine: QueryEngine,
    file: SourceFileAddress,
    by_item: List<List<ItemImpl>>,
    generated: bool,
) -> List<DeclaredBody> {
    [b for k, held in by_item for nth, i in held for d in [impl_target(engine, file, i)] if d != null for b in plain_impl_bodies(
        ImplAt {
            file: file,
            item: nth_item_id(engine, file, generated, k),
            params: impl_params(engine, i, d!),
            nth: nth,
        },
        i,
    )]
}

/// An impl's methods then its statics, none where its target takes type parameters.
fn plain_impl_bodies(at: ImplAt, i: ItemImpl) -> List<DeclaredBody> {
    if !at.params.is_empty() { return [] }
    [DeclaredBody.Method(at, m, false) for m in i.methods]
        .concat([DeclaredBody.Method(at, m, true) for m in i.statics])
}

/// Whether anything is kept about `b`'s lowering, asking nothing; a generic fn, left to the walk,
/// counts as known.
fn body_is_known(engine: QueryEngine, b: DeclaredBody) -> bool {
    match b {
        .Free(file, name) -> is_generic_fn(engine, file, name) || lowered_under_is_known(engine, file, name, null, []),
        .Method(at, name, statics) -> lowered_method_under_is_known(engine, at, name, statics, null, []),
    }
}

/// Whether `b` lowered, its facts asked as the walk asks them, which lowers it, and then those of
/// each body only its calls name; a generic fn is left to the calls that fill it.
fn body_lowered(engine: QueryEngine, b: DeclaredBody) -> bool {
    match b {
        .Free(file, name) -> !is_generic_fn(engine, file, name) &&
            called_units_worked(engine, fn_facts_asked(engine, file, name)),
        .Method(at, name, statics) -> called_units_worked(engine, method_facts_asked(engine, at, name, statics)),
    }
}

/// Whether the fn `file` declares as `name` takes type parameters.
fn is_generic_fn(engine: QueryEngine, file: SourceFileAddress, name: string) -> bool {
    let signature? = fn_signature(engine, file, name) else { return false }
    !signature.type_params.is_empty()
}

/// What process `core` of `of` lowers when a program rooted at `package` is worked ahead, lowered in
/// this one process instead, in the order that process asks: the program's files, widest first,
/// each whose turn is `core`'s and that holds a body a fresh engine over `store` knows nothing of,
/// that engine asking each of their bodies. Answers how many lowered.
export fn share_replayed(
    store: LayeredStore,
    asking: QueryEngine,
    package: string,
    core: int,
    of: int,
) -> int {
    let files = widest_first(asking, program_files(asking, package))
    let _ = store.saved()
    let engine = query_engine(store, avra_fact_definitions(), asking.program)
    [bodies_lowered(engine, f) for at, f in files if at % of == core && !bodies_known(engine, f)]
        .sum()
}
