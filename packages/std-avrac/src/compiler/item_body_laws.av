    )
}

/// a `defer` whose body waits, bounded by no `within` it writes
export law cleanup_unbounded_law {
    kind: "flow.unbounded_cleanup"
    reads_view: cleanups_unbounded
    voice: cleanup_words
    witness: "extern fn avra_fiber_sleep(ms: int)\n\nfn clean() {\n    defer avra_fiber_sleep(1)\n}\n"
}

fn cleanup_words(a: List<string>) -> Voice { cleanup_unbounded(a[0], a[1]) }

collect listed_body_law_facts: List<ListedQuery> = @query_definition in self as ListedQuery { definition: it } by it.name

/// The queries a body's breaches are read through, for a process to hand its engine.
export fn body_law_fact_definitions() -> List<QueryDefinition> { definitions_of(listed_body_law_facts) }
