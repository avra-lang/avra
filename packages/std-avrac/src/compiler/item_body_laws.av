/// Every jump whose label names no `for` around it; a label nothing binds is the naming law's,
/// said where it is read.
fn jumps_unaimed(engine: QueryEngine, file: SourceFileAddress, at: ItemId) -> List<Found> {
    let unaimed = breaches_said(
        engine,
        file,
        at,
        (b) -> match b { .Unaimed(word, name) -> [word, name], rest -> null },
    )
    if unaimed.is_empty() { return [] }
    let unread = [u.at!.lo for u in item_refusals(engine, file, at).unread if u.at != null]
    [f for f in unaimed if !unread.contains(f.at?.lo ?? -1)]
}

/// a jump whose label names no enclosing `for`
export law jump_unaimed_law {
    kind: "loop.label"
    reads: jumps_unaimed
    voice: unaimed_words
    witness: "fn f(xs: List<int>) {\n    let y = 1\n    for x in xs {\n        break y\n    }\n}\n"
}

fn unaimed_words(a: List<string>) -> Voice { jump_unaimed(a[0], a[1]) }

