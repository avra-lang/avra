//! The built-in diagnostic codes, as the table they are. Feature-owned
//! codes register through the LanguageFeature component's `diags`;
//! assembly folds both into one registry and refuses duplicates.

/// Every built-in code, for registry assembly and `avra explain`.
export fn builtin_codes() -> List<DiagCode> {
    let rows: List<DiagCode> = table {
        kind              | id      | summary
        "lex.error"       | "F0001" | "a character or string the lexer cannot accept"
        "parse.expected"  | "F0100" | "the parse needed a token that is not there"
        "parse.trailing"  | "F0101" | "input remains after the program ended"
        "build.failed"    | "F0102" | "a builder rejected its captures"
        "language.defect" | "F0900" | "the language definition itself is defective"
    }
    rows
}
