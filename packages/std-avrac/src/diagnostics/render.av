//! A Diag rendered for the terminal. The structured value is the
//! substrate; this prose is one projection of it (P11).
//!
//!   error[F0100]: expected NAME while parsing `stmt`
//!     ╭─[app.av:2:5]
//!   2 │ let = 3
//!     ·     ┬
//!     ·     ╰── expected NAME
//!   ──╯
//!   help: a `let` names its value
use core.{joined}
use @std.errors.{Loc, Error}
use @std.text.{repeat}

fn severity_word(s: Severity) -> string {
    match s {
        .Error -> "error",
        .Warning -> "warning",
    }
}

/// A label with nowhere to point — its own line under the message,
/// no window. Nothing for an empty label, exactly as an unlabeled
/// mark draws no arrow.
fn unplaced(frame_label: string?) -> List<string> {
    if frame_label == null || frame_label!.is_empty() { return [] }
    ["  ${frame_label!}"]
}

/// The source window for one located frame: location header, the
/// line, and the pointer carrying the frame's label when it has one.
fn window(at_loc: Loc, frame_label: string?, src: SourceFile) -> string {
    let at = src.linecol(at_loc.lo)
    let file = at_loc.file ?? "<source>"
    let num = "${at.line}"
    let gutter = repeat(" ", num.length)
    let indent = repeat(" ", at.col - 1)
    // AN ARROW POINTS AT SOMETHING. A frame with no label drew
    // `╰──` and then stopped, promising a note that was never
    // written — every parse refusal in the tree read that way, since
    // the parse channel carries a message and no label. The caret
    // already marks the span; without a label there is nothing for a
    // second line to say.
    let pointed = if frame_label == null {
        []
    } else {
        ["${gutter} ·${indent} ╰── ${frame_label!}"]
    }
    joined([
        "${gutter} ╭─[${file}:${at.line}:${at.col}]",
        "${num} │ ${src.line_text(at.line)}",
        "${gutter} ·${indent} ┬",
    ].concat(pointed).concat(["${repeat("─", num.length + 1)}╯"]), "\n")
}

const cause_chain_cap = 16

/// A hop's own lines, indented past the first — so a multi-line cause
/// (a pre-rendered report, several diagnostics of its own) never lets
/// a later line's `error[...]:` read as an unrelated, top-level one.
fn continued(msg: string) -> string {
    let lines = msg.split("\n")
    joined([lines[0]].concat(["  ${l}" for l in lines.slice(1, lines.length)]), "\n")
}

/// Every deeper cause, one `caused by:` line per hop, until none
/// remain or the cap — a `cause()` answering itself must not recurse
/// the renderer forever, and a cut that stops silently would read as
/// a complete chain: the last line says so instead.
fn causes_of(e: dyn Error?, depth: int = cause_chain_cap) -> List<string> {
    let cur? = e else { return [] }
    let msg = cur.describe().message
    if depth <= 1 && cur.cause() != null {
        return ["caused by: ${continued(msg)} — the chain continues past ${cause_chain_cap}; an error answering itself as its own cause?"]
    }
    ["caused by: ${continued(msg)}"].concat(causes_of(cur.cause(), depth - 1))
}

/// The whole diagnostic as terminal text. The F-code is the
/// registry's projection of the kind; an unregistered kind renders
/// as itself.
export fn render(d: Diag, codes: List<DiagCode>, src: SourceFile) -> string {
    render_with(d, codes, (l: Loc) -> src)
}

/// The diagnostic rendered over MANY sources — each frame's window
/// comes from the file its Loc names; a file no source answers to
/// falls back to the first.
export fn render_among(d: Diag, codes: List<DiagCode>, sources: List<SourceFile>) -> string {
    render_with(d, codes, (l: Loc) -> source_named(sources, l.file))
}

fn source_named(sources: List<SourceFile>, file: string?) -> SourceFile {
    sources.find(it.file == file) ?? sources[0]
}

/// Every frame windowed from the source its Loc picks.
///
/// THE RENDERER NEVER DROPS A LABEL. A label is what the diagnostic
/// SAYS; a Loc is only where to point while saying it. An unlocated
/// primary label used to vanish — silently, because a label is
/// optional everywhere else — so a voice about a PACKAGE rather than
/// a line (the meta boundary's: the package moved, not a line) lost
/// the one part naming which shape moved, and six suites asserting
/// those words went red with the refusal itself still correct. The
/// workaround is worse than the defect: folding the label into the
/// message at one voice is a copy the next unlocated voice repeats.
fn render_with(d: Diag, codes: List<DiagCode>, pick: fn(Loc) -> SourceFile) -> string {
    let code = code_for(codes, d.kind) ?? d.kind
    mut parts = ["${severity_word(d.severity)}[${code}]: ${d.message}"]
    if d.primary.loc != null {
        parts.push(window(d.primary.loc!, d.primary.label, pick(d.primary.loc!)))
    } else {
        parts = parts.concat(unplaced(d.primary.label))
    }
    parts = parts.concat([window(f.loc!, f.label, pick(f.loc!)) for f in d.secondary if f.loc != null])
    parts = parts.concat(causes_of(d.cause))
    if d.help != null { parts.push("help: ${d.help!}") }
    let sg? = d.suggestions.first() else { return joined(parts, "\n") }
    let ed? = sg.edits.first() else { return joined(parts, "\n") }
    joined(parts.concat(["fix: ${ed.replacement}"]), "\n")
}
