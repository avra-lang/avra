//! The compiler's diagnostic: an @std.errors Error carrying source
//! marks, a severity, and remedies. Structured first (P11); rendering
//! is a projection. A diagnostic names its KIND; the F-code is the
//! registry's projection of that kind (codes.av).
use core.{Span}
use @std.errors.{Loc, Frame, Confidence, Edit, Suggestion, Error, ErrorInfo, info}

export enum Severity { Error, Warning }

/// One diagnostic. The primary frame is always present — absence
/// lives in ONE place: a problem with no source anchor carries a
/// loc-less frame. `secondary` frames hold the supporting positions.
export type Diag = {
    kind: string,
    severity: Severity,
    primary: Frame,
    secondary: List<Frame>,
    message: string,
    help: string?,
    suggestions: List<Suggestion>,
}

impl Error for Diag {
    fn describe(self) -> ErrorInfo {
        info(self.kind, self.message)
    }
}

/// One registry row: a kind, its stable F-code, and its one-line
/// meaning for `avra explain`.
export type DiagCode = { kind: string, id: string, summary: string }

/// The registry's F-code for a kind, when the kind is registered.
export fn code_for(codes: List<DiagCode>, kind: string) -> string? {
    codes.find(it.kind == kind)?.id
}

/// A span as a boundary location; absence passes through, so every
/// caller with a `Span?` in hand maps it in place.
export fn loc_at(file: string?, s: Span?) -> Loc? {
    if s == null { return null }
    Loc { file: file, lo: s!.lo, hi: s!.hi }
}

/// The diagnostic's primary frame, labeled.
export fn pointed(d: Diag, label: string) -> Diag {
    d with { primary: d.primary with { label: label } }
}

/// An error at a source position; the common construction. Extend
/// with `with { help: ..., suggestions: ... }`.
export fn error_at(kind: string, loc: Loc?, message: string) -> Diag {
    Diag {
        kind: kind,
        severity: Severity.Error,
        primary: Frame { label: null, loc: loc },
        secondary: [],
        message: message,
        help: null,
        suggestions: [],
    }
}
