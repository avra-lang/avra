//! The compiler's diagnostic: an @std.errors Error carrying source
//! marks, a severity, and remedies. Structured first (P11); rendering
//! is a projection. A diagnostic names its KIND; the F-code is the
//! registry's projection of that kind (codes.av).
use core.{flatten, Span, inserted}
use @std.errors.{Loc, Frame, Suggestion, Error, ErrorInfo, info}

export enum Severity { Error, Warning }

/// One diagnostic. The primary frame is always present — absence
/// lives in ONE place: a problem with no source anchor carries a
/// loc-less frame. `secondary` frames hold the supporting positions.
export type Diag = {
    kind: string,
    severity: Severity,
    primary: Frame,
    secondary: List<Frame>,
    message: string,
    help: string?,
    suggestions: List<Suggestion>,
}

impl Error for Diag {
    fn describe() -> ErrorInfo {
        info(self.kind, self.message)
    }
}

/// One registry row: a kind, its stable F-code, and its one-line
/// meaning for `avra explain`.
export type DiagCode = { kind: string, id: string, summary: string }

/// The registry's F-code for a kind, when the kind is registered.
export fn code_for(codes: List<DiagCode>, kind: string) -> string? {
    codes.find(it.kind == kind)?.id
}

/// A span as a boundary location; absence passes through, so every
/// caller with a `Span?` in hand maps it in place.
export fn loc_at(file: string?, s: Span?) -> Loc? {
    if s == null { return null }
    Loc { file: file, lo: s!.lo, hi: s!.hi }
}

/// Every query value's diagnostics, one sink; `report` folds sinks.
export type Voices = { list: List<Diag> }

export fn no_voices() -> Voices {
    Voices { list: [] }
}

impl Voices {
    fn speak(d: Diag) {
        self.list.push(d)
    }

    fn heard() -> bool { !self.list.is_empty() }
}

/// Diagnostics in source order — by where each points, the order
/// spoken breaking ties. Bodies typed apart fold back into the
/// order one walk would have spoken.
export fn by_position(ds: List<Diag>) -> List<Diag> {
    mut out: List<Diag> = []
    for d in ds {
        let at = first_after(out, start_of(d))
        out = inserted(out, at, d)
    }
    out
}

/// The first index whose diagnostic starts past `start` — the
/// insertion point that keeps equal starts in spoken order.
fn first_after(ds: List<Diag>, start: int) -> int {
    for i, d in ds {
        if start_of(d) > start { return i }
    }
    ds.length
}

/// Where a diagnostic points; an unanchored one sorts first.
fn start_of(d: Diag) -> int {
    d.primary.loc?.lo ?? 0 - 1
}

/// A refusal in the one shape every voice takes: the kind, where,
/// the message, the label at the site, and the help (or none).
export fn refusal(kind: string, at: Loc?, message: string, label: string, help: string?) -> Diag {
    // LICENSED I28: the one site that spells the shape — every voice calls this
    pointed(error_at(kind, at, message), label) with { help: help }
}

/// A warning in the refusal's shape — rendered, never blocking.
export fn warning(kind: string, at: Loc?, message: string, label: string, help: string?) -> Diag {
    refusal(kind, at, message, label, help) with { severity: Severity.Warning }
}

/// Whether any diagnostic is an error — the one meaning of unclean;
/// warnings render and never block.
export fn has_errors(ds: List<Diag>) -> bool {
    ds.any(is_error(it))
}

export fn is_error(d: Diag) -> bool {
    d.severity is .Error
}

/// A diagnostic's structured fixes as text — one `file: replacement`
/// per edit, in order. The one projection tests and `--json` read.
export fn suggested(d: Diag) -> List<string> {
    flatten([["${e.loc.file ?? ""}: ${e.replacement}" for e in sg.edits] for sg in d.suggestions])
}

/// The diagnostic's primary frame, labeled.
export fn pointed(d: Diag, label: string) -> Diag {
    d with { primary: d.primary with { label: label } }
}

/// THE compiler-blames-itself kind, named once.
export const defect_kind: string = "language.defect"

/// A defect — the compiler's own mistake, never the program's.
export fn defect_at(loc: Loc?, message: string) -> Diag {
    error_at(defect_kind, loc, message)
}

/// An error at a source position; the common construction. Extend
/// with `with { help: ..., suggestions: ... }`.
export fn error_at(kind: string, loc: Loc?, message: string) -> Diag {
    Diag {
        kind: kind,
        severity: Severity.Error,
        primary: Frame { label: null, loc: loc },
        secondary: [],
        message: message,
        help: null,
        suggestions: [],
    }
}
