//! What a feature's nodes DO at each pass — THE contract, and the
//! vocabulary every feature speaks across it.
//!
//! The contract: one capability context per pass (STATE verbs only —
//! walk, look up, record, emit — wired by the driver) and the two
//! semantics traits. Every method is mandatory: a feature that does
//! nothing at a pass says so in its impl, visibly. The passes reach
//! an impl through the semantics map and never match feature nodes.
//!
//! The vocabulary: the FACT shapes the declare phase records
//! (FnSig, StructSig, EnumSig, and the one DeclSig currency that
//! holds them), and the refusals and help PHRASES features share
//! word-for-word, so no two sites drift.
//!
//! Siblings, by concern: checks.av holds the typing LAWS,
//! values.av the runtime VALUE representation, builder.av the
//! parse-time authoring surface. A feature-named fn has no place
//! in any of them.
use core.{NodeStore, Expr, ExprId, StmtId, Param, Type, TypeId, TypeRef, TypeRegistry, Reg, Ins, joined}
use diagnostics.{Diag, error_at, pointed}
use @std.errors.{Loc}

/// Resolve capabilities: an impl reports a name use — as a value
/// (`use_name`) or as a callee (`use_call`); the driver owns scopes,
/// namespaces, suggestions, and diagnostics. `arm_scope` walks one
/// match arm's value under its own bind ("" when the arm names
/// none) — the first scope an EXPRESSION opens.
export type ResolveCx = {
    store: NodeStore,
    use_name: fn(ExprId, string),
    use_call: fn(ExprId, string),
    use_type: fn(ExprId, string),
    block_scope: fn(List<StmtId>, ExprId?),
    arm_scope: fn(string, ExprId),
    lambda_scope: fn(ExprId, List<Param>, ExprId),
}

/// A fn's typed signature, as the type pass computed it.
export type FnSig = { params: List<TypeId>, ret: TypeId }

/// A recorded INSTANTIATION: which generic fn a call targets and
/// what each of its Vars bound to, by ordinal. Typing records it;
/// mono lowers one body per distinct binding.
export type Sub = { target: StmtId, args: List<TypeId> }

/// A recorded PRESENCE TEST: which subject a `== null`/`!= null`
/// asked about, and which branch its truth proves PRESENT. The
/// spine records it as a fact; `if` queries it — features never
/// match each other's nodes.
export type Asked = { subject: ExprId, on_present: bool }

/// A struct's typed field table, in declaration order — the index
/// IS the runtime slot.
export type StructSig = { names: List<string>, types: List<TypeId> }

/// A declared enum's variant table, in declaration order — the
/// index IS the runtime tag, and a payload (when the variant
/// carries one) rides slot 1 of the value.
export type EnumSig = { names: List<string>, payloads: List<TypeId?> }

/// A named member's index in a declaration-ordered table, when it
/// is one — the lookup structs and enums share.
fn index_in(names: List<string>, name: string) -> int? {
    let i = names.index_of(name)
    if i < 0 { null } else { i }
}

/// Names listed for help text — one wording everywhere.
fn named_list(names: List<string>) -> string {
    joined(["`${n}`" for n in names], ", ")
}

impl StructSig {
    /// A named field's slot, when declared — THE lookup every
    /// consumer shares.
    fn slot_of(self, name: string) -> int? {
        index_in(self.names, name)
    }

    /// The fields, listed for help text.
    fn listed(self) -> string {
        named_list(self.names)
    }
}

impl EnumSig {
    /// A named variant's TAG, when declared.
    fn tag_of(self, name: string) -> int? {
        index_in(self.names, name)
    }

    /// What the variant CARRIES, when it carries anything.
    fn payload_of(self, name: string) -> TypeId? {
        let tag: int? = self.tag_of(name)
        if tag == null { return null }
        self.payloads[tag!]
    }

    /// The variants, listed for help text.
    fn listed(self) -> string {
        named_list(self.names)
    }
}

/// The BUILT-IN enum's variant table — Result IS an enum, and this
/// one answer hands its match, exhaustiveness, and binds to the
/// enums machinery whole. The names are the LAW: `.Ok` is tag 0,
/// `.Err` tag 1, each carrying its side.
export fn res_enum_sig(ok: TypeId, err: TypeId) -> EnumSig {
    EnumSig { names: ["Ok", "Err"], payloads: [ok, err] }
}

/// What a DECLARATION declares — the ONE currency the declare
/// phase records and every consumer reads. Three parallel tables
/// (fns, records, enums) became one dense table of this, exactly as
/// the parallel resolve tables became one Binding. A new declared
/// kind is a new VARIANT, and the projections below break at
/// compile time until it is handled.
export enum DeclSig {
    Fn(sig: FnSig)
    Record(sig: StructSig)
    Variants(sig: EnumSig)
}

/// The projections beside the enum — consumers ask, never match.
export fn fn_sig_of(d: DeclSig?) -> FnSig? {
    if d == null { return null }
    match d! {
        .Fn(s) -> s,
        _ -> null,
    }
}

export fn record_sig_of(d: DeclSig?) -> StructSig? {
    if d == null { return null }
    match d! {
        .Record(s) -> s,
        _ -> null,
    }
}

export fn variant_sig_of(d: DeclSig?) -> EnumSig? {
    if d == null { return null }
    match d! {
        .Variants(s) -> s,
        _ -> null,
    }
}

/// Typing capabilities: read children's computed types (post-order —
/// they exist), read an ident's definition type, read a call's
/// target signature, and speak. The impl OWNS its diagnostics
/// wording. `error_type` is the ABSORBING answer, interned once: a
/// site whose operand already refused answers with it and says
/// nothing more. `types` is THE registry, carried whole — shapes,
/// interning, printing, and every carried/pointer query ride the
/// one field instead of a verb per question, so this vocabulary
/// stops growing when the registry does.
export type TypeCx = {
    error_type: TypeId,
    store: NodeStore,
    types: TypeRegistry,
    methods: List<MethodRow>,
    properties: List<PropertyRow>,
    type_at: fn(ExprId) -> TypeId,
    shape_at: fn(ExprId) -> Type,
    target_type: fn(ExprId) -> TypeId,
    sig_of: fn(ExprId) -> FnSig?,
    bound_def: fn(ExprId) -> StmtId?,
    fields_of: fn(TypeId) -> StructSig?,
    variants_of: fn(TypeId) -> EnumSig?,
    block_type: fn(List<StmtId>, ExprId?) -> TypeId,
    walk_type: fn(ExprId) -> TypeId,
    bind_type: fn(ExprId, TypeId),
    widen: fn(ExprId, TypeId),
    record_ask: fn(ExprId, ExprId, bool),
    ask_of: fn(ExprId) -> Asked?,
    walk_narrowed: fn(ExprId, ExprId) -> TypeId,
    enclosing_ret: fn() -> TypeId?,
    record_subst: fn(ExprId, StmtId, List<TypeId>),
    written: fn(StmtId, TypeRef) -> TypeId,
    written_at: fn(ExprId, TypeRef) -> TypeId,
    lambda_body: fn(ExprId, List<TypeId>, ExprId) -> TypeId,
    want_at: fn(ExprId) -> TypeId?,
    plant_want: fn(ExprId, TypeId),
    go_hungry: fn(ExprId),
    absorb_hunger: fn(ExprId),
    starve: fn(ExprId, TypeId) -> bool,
    behind_lambda: fn() -> bool,
    is_mut: fn(ExprId) -> bool,
    retype_seated: fn(ExprId, List<TypeId>) -> TypeId?,
    method_sig: fn(string, string) -> FnSig?,
    trait_sig: fn(string, string) -> FnSig?,
    implements: fn(TypeId, string) -> bool,
    name_at: fn(ExprId) -> string,
    loc_of: fn(ExprId) -> Loc?,
    emit: fn(Diag),
}

/// Lowering capabilities: `reg_of` lowers a child at first request —
/// a region's branches lower inside its brackets. `result` mints the
/// fresh register for a node, typed from the type pass; take every
/// child's register FIRST — registers mint in instruction order —
/// then `emit` the instruction that defines it. `mint` is a fresh
/// SCRATCH register typed like the node, for desugars that need one
/// beyond the node's own.
export type LowerCx = {
    store: NodeStore,
    types: TypeRegistry,
    methods: List<MethodRow>,
    properties: List<PropertyRow>,
    result: fn(ExprId) -> Reg,
    reg_of: fn(ExprId) -> Reg,
    def_reg: fn(ExprId) -> Reg?,
    shape_at: fn(ExprId) -> Type,
    type_at: fn(ExprId) -> TypeId,
    mint: fn(ExprId) -> Reg,
    mint_like: fn(Reg) -> Reg,
    mint_shape: fn(Type) -> Reg,
    mint_ty: fn(TypeId) -> Reg,
    fields_at: fn(ExprId) -> StructSig?,
    fields_of: fn(TypeId) -> StructSig?,
    variants_at: fn(ExprId) -> EnumSig?,
    variants_of: fn(TypeId) -> EnumSig?,
    cell_of: fn(ExprId) -> Reg?,
    bind_pattern: fn(ExprId, Reg),
    emit: fn(Ins),
    lower_block: fn(List<StmtId>, ExprId?) -> Reg,
    enclosing_ret: fn() -> TypeId?,
    callee_of: fn(ExprId, string) -> string,
    trait_methods: fn(StmtId) -> List<string>,
    lift: fn(ExprId) -> string,
    capture_regs: fn(ExprId) -> List<Reg>,
    indirect_callee: fn(ExprId) -> Reg?,
    fail: fn(string),
}

/// The per-pass behavior of one feature's expression nodes.
/// `heirs` are the sub-expressions a planted WANT flows into
/// UNCHANGED — a branch answers its arms' values, everything else
/// answers nothing; the expected-type channel recurses through
/// them before the bottom-up walk begins.
export trait NodeSemantics {
    fn kids(self, e: Expr) -> List<ExprId>
    fn heirs(self, e: Expr) -> List<ExprId>
    fn resolve(self, cx: ResolveCx, e: ExprId)
    fn type_of(self, cx: TypeCx, e: ExprId) -> TypeId
    fn lower(self, cx: LowerCx, e: ExprId) -> Reg
}

/// Statement resolve capabilities — the pass's STATE verbs, never a
/// feature's rule: walk expressions, apply the binding law, look a
/// name up, record an assignment's target, and speak. Rule bodies
/// live in the feature's own directory. `bound_scope` is a fresh
/// scope where the statement's own binding holds: the exprs walk
/// and the statements resolve inside it — a loop variable's home.
export type StmtResolveCx = {
    store: NodeStore,
    in_block: bool,
    walk: fn(ExprId),
    walk_under: fn(List<Param>, ExprId),
    bind_checked: fn(StmtId),
    check_params: fn(List<Param>, StmtId),
    scope_stmts: fn(List<StmtId>),
    bound_scope: fn(StmtId, List<ExprId>, List<StmtId>),
    impl_stmts: fn(List<StmtId>),
    is_param: fn(string) -> bool,
    lookup: fn(string) -> StmtId?,
    loc_of: fn(StmtId) -> Loc?,
    emit: fn(Diag),
}

/// Statement typing capabilities: `expr` is the WHOLE expression
/// vocabulary (types, shapes, interning, diagnostics); the rest are
/// the statement-level state verbs — walks, signatures, and the
/// assignment fact.
export type StmtTypeCx = {
    store: NodeStore,
    expr: TypeCx,
    walk: fn(ExprId),
    walk_under: fn(StmtId, ExprId),
    type_stmts: fn(List<StmtId>),
    sig_of: fn(StmtId) -> FnSig?,
    bind_declared: fn(StmtId, TypeRef) -> TypeId,
    binding_type: fn(StmtId) -> TypeId,
    record_binding: fn(StmtId, TypeId),
    loc_of: fn(StmtId) -> Loc?,
}

/// Statement lowering capabilities: `expr` is the WHOLE expression
/// lowering vocabulary (registers, types, minting, the emit seam) —
/// the typing cx's twin; the rest are the statement-level verbs:
/// statement lists, and the slot a `mut` binding owns — a slot
/// bound through `bind_slot` is a memory CELL: idents load through
/// it, and the driver's value write defers to it.
export type StmtLowerCx = {
    store: NodeStore,
    expr: LowerCx,
    lower_stmts: fn(List<StmtId>),
    slot_of: fn(StmtId) -> Reg?,
    bind_slot: fn(StmtId, Reg),
}

/// The per-pass behavior of one feature's STATEMENT kinds — the
/// stmt-spine's twin of NodeSemantics. Drivers loop statements
/// through `stmt_semantics_of` and never match Stmt kinds; a
/// value-producing statement answers its register (lower) and the
/// DRIVER owns slots and last-value tracking.
export trait StmtSemantics {
    fn resolve_stmt(self, cx: StmtResolveCx, s: StmtId)
    fn type_stmt(self, cx: StmtTypeCx, s: StmtId)
    fn lower_stmt(self, cx: StmtLowerCx, s: StmtId) -> Reg?
}

/// The written-out nothing — a pass method that deliberately does no
/// work says so by calling this.
export fn nothing() {
    let _ = 0
}

/// The impossible-past-the-gate PHRASE, worded once — every rule
/// that meets a recovery hole says exactly this, and `lower_defect`
/// supplies the "defect:" that fronts it.
export fn hole_defect() -> string {
    "a hole survived a clean analysis"
}

/// Every REPEATED name in a declaration, one refusal per extra
/// copy. The FIRST position wins, so `a, a, a` speaks twice — at the
/// second and the third. A record's fields, an enum's variants and a
/// fn's parameters are the same law and must give the same count.
export fn duplicate_names(kind: string, owner: string, names: List<string>, at: Loc?) -> List<Diag> {
    mut out: List<Diag> = []
    for (j, n) in names.enumerate() {
        if names.index_of(n) < j { out.push(duplicate_member(kind, owner, n, at)) }
    }
    out
}

/// A declaration naming the same member twice — one refusal for
/// every declared table (a record's fields, an enum's variants).
export fn duplicate_member(kind: string, owner: string, member: string, at: Loc?) -> Diag {
    pointed(
        error_at(kind, at, "`${owner}` declares `${member}` more than once"),
        "in this declaration")
        with { help: "rename one of them" }
}

/// A lowering defect: record it and stand on a fresh register — the
/// driver refuses the whole build afterward. THE answer when a
/// payload the dispatch GUARANTEES comes back absent; never a
/// plausible default, which would compile a wrong program silently.
export fn lower_defect(cx: LowerCx, e: ExprId, what: string) -> Reg {
    cx.fail("defect: ${what}")
    cx.result(e)
}

/// A declaration that must live at the TOP LEVEL, refused where it
/// was written. The namespaces are gathered from the program's own
/// statements, so a nested declaration is invisible — and blaming
/// the later USE ("`E` is not defined") hides the real mistake.
export fn nested_decl(kind: string, what: string, at: Loc?) -> Diag {
    pointed(error_at(kind, at, "${what} live at the top level"),
        "declared inside a block")
        with { help: "move it out of the block" }
}

/// The parallel-capture mismatch, worded once — every zip builder
/// that finds its lists disagreeing says exactly this. Deliberately
/// says NAMES, not "fields": arms and fields both zip through it.
export fn zip_defect() -> string {
    "names and values disagree in count"
}

/// The help EVERY "no such variant" refusal gives — what there IS.
/// Construction and `match` both name a variant, so both offer the
/// same list, in the same words.
export fn variants_are(sig: EnumSig) -> string {
    "the variants are ${sig.listed()}"
}

/// The same, for a record: a property read and a literal both name
/// a field, so both offer the same list.
export fn fields_are(sig: StructSig) -> string {
    "the fields are ${sig.listed()}"
}

/// What to write when a RECORD name was used where an enum was
/// expected — the two features that can hit it say it alike.
export fn build_a_record(tname: string) -> string {
    "build a record with `${tname} { ... }`"
}

/// A variant that typing accepted and lowering cannot find: the
/// two lowering paths that construct one share the words.
export fn variant_defect() -> string {
    "an undeclared variant survived typing"
}

// ── The statement-value rituals: one verb per shape, so no rule
// ever spells the stmt_value-guard two-step. ──

impl StmtResolveCx {
    /// Walk the statement's value expression, when it carries one.
    fn walk_value(self, s: StmtId) {
        let v: ExprId? = self.store.stmt_value(s)
        if v != null { self.walk(v!) }
    }
}

impl StmtTypeCx {
    /// Walk the statement's value expression, when it carries one —
    /// and refuse a TYPE standing where a value belongs, since
    /// "the statement's value" says it must be one.
    fn walk_value(self, s: StmtId) {
        let v: ExprId? = self.store.stmt_value(s)
        if v == null { return }
        self.walk(v!)
        let _ = refuses_type_value(self.expr, v!)
    }
}

impl StmtLowerCx {
    /// The statement's value, lowered — null when it carries none.
    fn lower_value(self, s: StmtId) -> Reg? {
        let v: ExprId? = self.store.stmt_value(s)
        if v == null { return null }
        self.expr.reg_of(v!)
    }
}

/// A declared sig with the declaration's Vars substituted — how an
/// instantiation answers `variants_of`.
export fn subbed_variants(types: TypeRegistry, sig: EnumSig?, decl: StmtId, args: List<TypeId>) -> EnumSig? {
    if sig == null { return null }
    EnumSig {
        names: sig!.names,
        payloads: [subbed_payload(types, p, decl, args) for p in sig!.payloads],
    }
}

fn subbed_payload(types: TypeRegistry, p: TypeId?, decl: StmtId, args: List<TypeId>) -> TypeId? {
    if p == null { return null }
    types.substituted(p!, decl, args)
}

/// The struct twin.
export fn subbed_fields(types: TypeRegistry, sig: StructSig?, decl: StmtId, args: List<TypeId>) -> StructSig? {
    if sig == null { return null }
    StructSig {
        names: sig!.names,
        types: [types.substituted(t, decl, args) for t in sig!.types],
    }
}

/// The qualified symbol a method lowers under — derived from the
/// receiver's type name at BOTH the fn loop and the call site, so
/// no fact table carries it.
export fn method_symbol(target: string, name: string) -> string {
    "${target}.${name}"
}
