//! What a feature's nodes DO at each pass — THE contract, and the
//! vocabulary every feature speaks across it.
//!
//! The contract: one capability context per pass — the pass's own
//! STATE, whose verbs (walk, look up, record, emit) are its methods,
//! the statement and expression spines sharing it — and the two
//! semantics traits. A pass method a feature has nothing to say at
//! is the trait's DEFAULT (no kids, no heirs, nothing to resolve,
//! nothing to lower); what a node IS at typing and lowering, and
//! what a statement does, every impl states. The passes reach
//! an impl through the semantics map and never match feature nodes.
//!
//! The vocabulary: the FACT shapes the declare phase records
//! (FnSig, StructSig, EnumSig, and the one DeclSig currency that
//! holds them), and the refusals and help PHRASES features share
//! word-for-word, so no two sites drift.
//!
//! Siblings, by concern: checks.av holds the typing LAWS,
//! values.av the runtime VALUE representation, builder.av the
//! parse-time authoring surface. A feature-named fn has no place
//! in any of them.
use core.{Expr, ExprId, StmtId, Param, TypeId, TypeRef, TypeRegistry, Reg, joined, DeclId, found_at, Binding}
use diagnostics.{Diag, refusal}
use @std.errors.{Loc}

/// Resolve capabilities: an impl reports a name use — as a value
/// (`use_name`), a callee (`use_call`), a type (`use_type`) or the
/// receiver (`use_receiver`) — and opens the scopes it owns
/// (`arm_scope` walks one match arm's value under its own binds, the
/// first scope an EXPRESSION opens; `block_scope`; `lambda_scope`).
/// The statement spine walks (`walk`, `walk_under`), applies the
/// binding law (`bind_checked`, `check_params`), opens its scopes
/// (`scope_stmts`, `bound_scope`, `impl_stmts`) and speaks. The
/// context IS the pass's state — the verbs are its methods, written
/// where the walk lives — and the driver owns scopes, namespaces,
/// suggestions, and diagnostics.
export type ResolveCx = {
    view: FileView,
    facts: NameFacts,
    dispatch: Dispatch,
    keywords: List<string>,
    // the file's `let` definitions and their names (the typo
    // candidates), the program scope's bindings, the open overlays
    all_defs: List<Def>,
    def_names: List<string>,
    visible: Map<string, Binding>,
    overlays: List<Map<string, Binding>>,
    // the open lambda frames; the open fn bodies' floors; one entry
    // per open impl or trait body (inside, `self` names the receiver
    // seat and the written params start at seat 1); the open fn
    // body's `mut` seats, by written position
    lframes: List<LFrame>,
    floors: List<int>,
    receivers: List<bool>,
    muts: List<List<bool>>,
    // a name resolves ONCE; a scoped binder never counts as a later
    // definition
    walked: List<bool>,
    scoped: List<bool>,
    // THE WALK'S STATE: the open fn body's seat names, and whether
    // the statement in hand stands inside a block
    scope: List<string>,
    in_block: bool,
}

/// One `let` definition of the program, in order.
export type Def = { name: string, stmt: StmtId }

/// One OPEN lambda during the walk: its params, and the overlay
/// depth at entry — an overlay at or above the floor is
/// lambda-local; below it lies the outer world, reached by capture.
export type LFrame = { lam: ExprId, params: List<string>, floor: int }

/// A fn's typed signature, as the type pass computed it.
export type FnSig = { params: List<TypeId>, ret: TypeId }

/// A recorded INSTANTIATION: which generic fn a call targets and
/// what each of its Vars bound to, by ordinal. Typing records it;
/// mono lowers one body per distinct binding.
export type Sub = { target: DeclId, args: List<TypeId> }

/// A struct's typed field table, in declaration order — the index
/// IS the runtime slot; a default is the declaration whose body
/// fills it.
export type StructSig = { names: List<string>, types: List<TypeId>, defaults: List<DeclId?> }

/// A declared enum's variant table, in declaration order — the
/// index IS the runtime tag, and a payload (when the variant
/// carries one) rides slot 1 of the value.
export type EnumSig = { names: List<string>, payloads: List<List<TypeId>> }

/// Names listed for help text — one wording everywhere.
fn named_list(names: List<string>) -> string {
    joined(["`${n}`" for n in names], ", ")
}

impl StructSig {
    /// A named field's slot, when declared — THE lookup every
    /// consumer shares.
    fn slot_of(name: string) -> int? {
        found_at(self.names, name)
    }

    /// The fields, listed for help text.
    fn listed() -> string {
        named_list(self.names)
    }
}

impl EnumSig {
    /// A named variant's TAG, when declared.
    fn tag_of(name: string) -> int? {
        found_at(self.names, name)
    }

    /// What the variant CARRIES, in order — empty for a unit variant.
    fn payloads_of(name: string) -> List<TypeId> {
        let tag: int? = self.tag_of(name)
        if tag == null { return [] }
        self.payloads[tag!]
    }

    /// The ONE payload of a single-value wrapper — absent for a
    /// unit variant and for a variant carrying several.
    fn payload_of(name: string) -> TypeId? {
        let carried = self.payloads_of(name)
        if carried.length != 1 { return null }
        carried[0]
    }

    /// The variants, listed for help text.
    fn listed() -> string {
        named_list(self.names)
    }
}

/// The BUILT-IN enum's variant table — Result IS an enum, and this
/// one answer hands its match, exhaustiveness, and binds to the
/// enums machinery whole. The names are the LAW: `.Ok` is tag 0,
/// `.Err` tag 1, each carrying its side.
export fn res_enum_sig(ok: TypeId, err: TypeId) -> EnumSig {
    EnumSig { names: ["Ok", "Err"], payloads: [[ok], [err]] }
}

/// What a DECLARATION declares — the ONE currency the declare
/// phase records and every consumer reads. Three parallel tables
/// (fns, records, enums) became one dense table of this, exactly as
/// the parallel resolve tables became one Binding. A new declared
/// kind is a new VARIANT, and the projections below break at
/// compile time until it is handled.
export enum DeclSig {
    Fn(sig: FnSig)
    Record(sig: StructSig)
    Variants(sig: EnumSig)
}

/// The projections beside the enum — consumers ask, never match.
export fn fn_sig_of(d: DeclSig?) -> FnSig? {
    if d == null { return null }
    match d! {
        .Fn(s) -> s,
        _ -> null,
    }
}

export fn record_sig_of(d: DeclSig?) -> StructSig? {
    if d == null { return null }
    match d! {
        .Record(s) -> s,
        _ -> null,
    }
}

export fn variant_sig_of(d: DeclSig?) -> EnumSig? {
    if d == null { return null }
    match d! {
        .Variants(s) -> s,
        _ -> null,
    }
}

/// Typing capabilities: read children's computed types (post-order —
/// they exist), read an ident's definition type, read a call's
/// target signature, and speak. The impl OWNS its diagnostics
/// wording. `error_type` is the ABSORBING answer, interned once: a
/// site whose operand already refused answers with it and says
/// nothing more. `types` is THE registry, carried whole — shapes,
/// interning, printing, and every carried/pointer query ride the
/// one field instead of a verb per question, so this vocabulary
/// stops growing when the registry does.
///
/// The context IS the pass's state: the walk's verbs — a subtree
/// typed under the seats in scope, a block, a narrowed branch, a
/// lambda body behind its barrier, the enclosing fn's promise, the
/// hunger protocol's feed — are its methods, written where the
/// walk lives. THE HUNGER PROTOCOL: a rule that needs a want it
/// lacks goes hungry (silently); the agreement door FEEDS it — the
/// want planted, the rule re-run; at the walk's end every rule
/// still hungry is re-run STARVING, and speaks in its own words.
export type TypeCx = {
    view: FileView,
    names: NameFacts,
    facts: TypeFacts,
    error_type: TypeId,
    // the language's semantics and keywords: the walk dispatches
    // through the one, the seat law reads the other
    dispatch: Dispatch,
    keywords: List<string>,
    // THE WALK'S STATE: the seats in scope; the narrows in force (a
    // def's stmt index, a param's position — two stacks keep the
    // keyspaces apart); the enclosing fns' promises; the lambda
    // barriers; the type parameters in scope; the paired `for`
    // heads' subjects — the one place a pairing word may stand
    scope: List<TypeId>,
    narrow_defs: List<NarrowFrame>,
    narrow_params: List<NarrowFrame>,
    fn_ret: List<TypeId>,
    lam_bar: List<int>,
    tscope: List<TypeId>,
    pairs: List<ExprId>,
    starving: bool,
}

/// One narrow in force: the proven binding's key, the INNER its
/// reads answer, and the OPT each read is recorded as wearing, for
/// lowering.
export type NarrowFrame = { key: int, inner: TypeId, opt: TypeId }

/// Lowering capabilities: `reg_of` lowers a child at first request —
/// a region's branches lower inside its brackets. `result` mints the
/// fresh register for a node, typed from the type pass; take every
/// child's register FIRST — registers mint in instruction order —
/// then `emit` the instruction that defines it. A desugar's SCRATCH
/// register is `mint_ty(cx.type_at(e))` — spelled as what it is,
/// never a second name for the answer.
///
/// The context IS the pass's state — one per BODY: the emitter, the
/// body's registers and slots, the body's instantiation and declared
/// answer (fields, not stacks: a body is lowered whole), the mono
/// worklist every named body enqueues through. The walk's verbs — a
/// child lowered on request, a block, the statement loop, a
/// binding's register (a fn value mints a wrapper), a lambda lifted,
/// captures packed, a declaration's body named as instantiated at a
/// site — are its methods, written where the walk lives.
export type LowerCx = {
    view: FileView,
    names: NameFacts,
    facts: TypeFacts,
    dispatch: Dispatch,
    out: Emitter,
    body: BodyRegs,
    sub: Sub?,
    fn_ret: TypeId?,
    jobs: Jobs,
    // THE FRAMES: every `defer` registered in an open frame — a
    // statement list's — with that frame's depth; a frame's close
    // runs and drops its own, an early exit runs them all
    deferred: List<Deferred>,
    depth: int,
}

/// One registered `defer`: the fn box to call, the depth of the
/// frame that registered it, and whether only a failing exit runs it.
export type Deferred = { box: Reg, depth: int, on_error: bool }

/// The per-pass behavior of one feature's expression nodes.
/// `heirs` are the sub-expressions a planted WANT flows into
/// UNCHANGED — a branch answers its arms' values, everything else
/// answers nothing; the expected-type channel recurses through
/// them before the bottom-up walk begins.
export trait NodeSemantics {
    fn kids(e: Expr) -> List<ExprId> {
        []
    }
    fn heirs(e: Expr) -> List<ExprId> {
        []
    }
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg
}

/// The per-pass behavior of one feature's STATEMENT kinds — the
/// stmt-spine's twin of NodeSemantics. Drivers loop statements
/// through `stmt_semantics_of` and never match Stmt kinds; a
/// value-producing statement answers its register (lower), which the
/// DRIVER records as the statement's slot; what a program SHOWS is
/// its final expression statement's, read through the store.
export trait StmtSemantics {
    fn resolve_stmt(mut cx: ResolveCx, s: StmtId) {
        nothing()
    }
    fn type_stmt(mut cx: TypeCx, s: StmtId) {
        nothing()
    }
    fn lower_stmt(mut cx: LowerCx, s: StmtId) -> Reg? {
        null
    }
}

/// The written-out nothing — a pass method that deliberately does no
/// work says so by calling this.
export fn nothing() {
    let _ = 0
}

/// The impossible-past-the-gate PHRASE, worded once — every rule
/// that meets a recovery hole says exactly this, and `lower_defect`
/// supplies the "defect:" that fronts it.
export fn hole_defect() -> string {
    "a hole survived a clean analysis"
}

/// Every REPEATED name in a declaration, one refusal per extra
/// copy. The FIRST position wins, so `a, a, a` speaks twice — at the
/// second and the third. A record's fields, an enum's variants and a
/// fn's parameters are the same law and must give the same count.
export fn duplicate_names(kind: string, owner: string, names: List<string>, at: Loc?) -> List<Diag> {
    mut out: List<Diag> = []
    for j, n in names {
        if names.index_of(n) < j { out.push(duplicate_member(kind, owner, n, at)) }
    }
    out
}

/// A declaration naming the same member twice — one refusal for
/// every declared table (a record's fields, an enum's variants).
export fn duplicate_member(kind: string, owner: string, member: string, at: Loc?) -> Diag {
    refusal(kind, at, "`${owner}` declares `${member}` more than once", "in this declaration", "rename one of them")
}

/// A lowering defect: record it and stand on a fresh register — the
/// driver refuses the whole build afterward. THE answer when a
/// payload the dispatch GUARANTEES comes back absent; never a
/// plausible default, which would compile a wrong program silently.
export fn lower_defect(mut cx: LowerCx, e: ExprId, what: string) -> Reg {
    cx.defect(what)
    cx.result(e)
}

/// A node another feature owns reached this one's lowering: the
/// dispatch map is wrong, and the answer is a recorded defect on a
/// fresh register — never a silent register with nothing behind it.
export fn foreign_node(mut cx: LowerCx, e: ExprId) -> Reg {
    lower_defect(cx, e, hole_defect())
}

/// A declaration that must live at the TOP LEVEL, refused where it
/// was written. The namespaces are gathered from the program's own
/// statements, so a nested declaration is invisible — and blaming
/// the later USE ("`E` is not defined") hides the real mistake.
export fn nested_decl(kind: string, what: string, at: Loc?) -> Diag {
    refusal(kind, at, "${what} live at the top level", "declared inside a block", "move it out of the block")
}

/// THE nested-declaration guard every declaring statement opens
/// with: inside a block it refuses and answers true, so the rule
/// returns; at the top level it answers false.
export fn refuses_nested(mut cx: ResolveCx, s: StmtId, kind: string, what: string) -> bool {
    if !cx.in_block { return false }
    cx.emit(nested_decl(kind, what, cx.stmt_loc(s)))
    true
}

/// The parallel-capture mismatch, worded once — every zip builder
/// that finds its lists disagreeing says exactly this, naming the
/// two lists it zipped.
export fn zip_defect_of(what: string) -> string {
    "${what} disagree in count"
}

/// The common zip: names against values — arms and fields both.
export fn zip_defect() -> string {
    zip_defect_of("names and values")
}

/// The help EVERY "no such variant" refusal gives — what there IS.
/// Construction and `match` both name a variant, so both offer the
/// same list, in the same words.
export fn variants_are(sig: EnumSig) -> string {
    "the variants are ${sig.listed()}"
}

/// The same, for a record: a property read and a literal both name
/// a field, so both offer the same list.
export fn fields_are(sig: StructSig) -> string {
    "the fields are ${sig.listed()}"
}

/// What to write when a RECORD name was used where an enum was
/// expected — the two features that can hit it say it alike.
export fn build_a_record(tname: string) -> string {
    "build a record with `${tname} { ... }`"
}

/// A variant that typing accepted and lowering cannot find: the
/// two lowering paths that construct one share the words.
export fn variant_defect() -> string {
    "an undeclared variant survived typing"
}

// ── The statement-value rituals: one verb per shape, so no rule
// ever spells the stmt_value-guard two-step. ──

impl ResolveCx {
    /// Walk the statement's value expression, when it carries one.
    mut fn walk_value(s: StmtId) {
        let v: ExprId? = self.view.store.stmt_value(s)
        if v != null { self.walk(v!) }
    }
}

impl TypeCx {
    /// Walk the statement's value expression, when it carries one —
    /// and refuse a TYPE standing where a value belongs, since
    /// "the statement's value" says it must be one.
    mut fn walk_value(s: StmtId) {
        let v: ExprId? = self.view.store.stmt_value(s)
        if v == null { return }
        self.walk(v!)
        let _ = refuses_type_value(self, v!)
    }
}

impl LowerCx {
    /// The statement's value, lowered — null when it carries none.
    mut fn lower_value(s: StmtId) -> Reg? {
        let v: ExprId? = self.view.store.stmt_value(s)
        if v == null { return null }
        self.reg_of(v!)
    }
}

/// One optional bind as an arm's bind list — "" names nothing.
export fn named_bind(b: string) -> List<string> {
    if b == "" { return [] }
    [b]
}

/// A declared sig with the declaration's Vars substituted — how an
/// instantiation answers `variants_of`.
export fn subbed_variants(types: TypeRegistry, sig: EnumSig?, decl: DeclId, args: List<TypeId>) -> EnumSig? {
    if sig == null { return null }
    EnumSig {
        names: sig!.names,
        payloads: [subbed_payloads(types, ps, decl, args) for ps in sig!.payloads],
    }
}

fn subbed_payloads(types: TypeRegistry, ps: List<TypeId>, decl: DeclId, args: List<TypeId>) -> List<TypeId> {
    [types.substituted(p, decl, args) for p in ps]
}

/// The struct twin.
export fn subbed_fields(types: TypeRegistry, sig: StructSig?, decl: DeclId, args: List<TypeId>) -> StructSig? {
    if sig == null { return null }
    let held = sig!
    StructSig {
        names: held.names,
        types: [types.substituted(t, decl, args) for t in held.types],
        defaults: held.defaults,
    }
}

