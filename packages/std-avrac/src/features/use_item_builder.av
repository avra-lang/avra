//! The builder of one `use` item: a rule ending `-> Record.UseItem`
//! labels the name it imports and the name it takes instead, and the
//! item is carried whole by `NUseItem`.
use core.{Scoped, UseItem}
use features.{LangNode, Builder}

impl Builder {
    /// The item a `UseItem` rule wrote.
    fn use_item() -> Result<LangNode, string> {
        .Ok(
            LangNode
                .NUseItem(
                    UseItem {
                        name: Scoped(self.text_of("name")?),
                        rename: self.scoped_opt_of("rename")?,
                    },
                ),
        )
    }
}
