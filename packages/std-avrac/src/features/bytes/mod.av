//! Bytes — octets as a value. Text becomes bytes totally
//! (`s.bytes()`) and bytes become text only when they are UTF-8
//! (`b.text()`); between the two crossings the word is exact: the
//! length is the header's, `==` compares every byte, and `at` and
//! `slice` trap past the end rather than answer short. The scans a
//! parser lives by — `run` over a class table, `eq_at`/`ieq_at`
//! and `index_in` over a span — are one C call each, so a parser asks where a
//! token ends and never what each byte is. The vocabulary is its
//! method rows, each one runtime call.
use features.{
    LanguageFeature,
    MethodRow,
    ReceiverEffect,
    PropertyRow,
    measured_reg,
    lower_is_empty,
    bool_answer,
    int_answer,
    same_answer,
    unknown_answer,
    str_answer,
}

export fn bytes() -> LanguageFeature {
    let methods = table<MethodRow> {
        name          | takes    | check             | lower             | effect              | answers
        "bytes"       | on_str   | check_of_str      | lower_of_str      | ReceiverEffect.Read | unknown_answer
        "bytes"       | on_ints  | check_of_list     | lower_of_list     | ReceiverEffect.Read | unknown_answer
        "text"        | on_bytes | check_text        | lower_text        | ReceiverEffect.Read | unknown_answer
        "text_prefix" | on_bytes | check_text_prefix | lower_text_prefix | ReceiverEffect.Read | str_answer
        "text_lossy"  | on_bytes | check_text_lossy  | lower_text_lossy  | ReceiverEffect.Read | str_answer
        "at"          | on_bytes | check_at          | lower_at          | ReceiverEffect.Read | int_answer
        "slice"       | on_bytes | check_slice       | lower_slice       | ReceiverEffect.Read | same_answer
        "concat"      | on_bytes | check_concat      | lower_concat      | ReceiverEffect.Read | same_answer
        "index_of"    | on_bytes | check_index_of    | lower_index_of    | ReceiverEffect.Read | unknown_answer
        "index_in"    | on_bytes | check_index_in    | lower_index_in    | ReceiverEffect.Read | unknown_answer
        "is_empty"    | on_bytes | check_is_empty    | lower_is_empty    | ReceiverEffect.Read | bool_answer
        "run"         | on_bytes | check_run         | lower_run         | ReceiverEffect.Read | unknown_answer
        "run_back"    | on_bytes | check_run_back    | lower_run_back    | ReceiverEffect.Read | unknown_answer
        "eq_at"       | on_bytes | check_eq_at       | lower_eq_at       | ReceiverEffect.Read | unknown_answer
        "ieq_at"      | on_bytes | check_ieq_at      | lower_ieq_at      | ReceiverEffect.Read | unknown_answer
    }
    let properties = table<PropertyRow> {
        name     | takes    | check        | lower
        "length" | on_bytes | check_length | measured_reg
    }
    LanguageFeature bytes {
        methods: methods
        properties: properties
    }
    bytes
}
