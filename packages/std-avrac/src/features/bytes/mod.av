//! Immutable octets: construction, bounded reads, retained slices,
//! explicit copies, and binary equality. No assignable byte paths.
use features.{LanguageFeature, MethodRow, PropertyRow, measured_reg}

export fn bytes() -> LanguageFeature {
    let methods = table<MethodRow> {
        name       | takes         | check          | lower          | writes
        "bytes"    | on_text       | check_text     | lower_text     | false
        "bytes"    | on_byte_list  | check_list     | lower_list     | false
        "at"       | on_bytes      | check_at       | lower_at       | false
        "slice"    | on_bytes      | check_slice    | lower_slice    | false
        "copy"     | on_bytes      | check_copy     | lower_copy     | false
        "concat"   | on_bytes      | check_concat   | lower_concat   | false
        "is_empty" | on_bytes      | check_empty    | lower_empty    | false
    }
    let properties = table<PropertyRow> {
        name     | takes    | check        | lower
        "length" | on_bytes | check_length | measured_reg
    }
    component LanguageFeature f {
        name = "bytes"
        docs = "Immutable binary data; slices retain their storage, copies detach, and invalid slice bounds answer null."
        methods = methods
        properties = properties
    }
    f
}
