// proves: the scans a parser lives by — `run` ends at the first byte
// a class table refuses (or the length), `eq_at` compares a span
// exactly, `ieq_at` folds ASCII letters and nothing else, `index_in`
// finds a needle only wholly inside its span.
fn digit(i: int) -> int { if i >= 48 && i <= 57 { 1 } else { 0 } }
let digits = [digit(i) for i in 0..256].bytes()!
let line = "Host: 127.0.0.1\r\n".bytes()
let host = "host".bytes()
"${line.run(6, digits)} ${line.run(0, digits)} ${line.run(17, digits)} ${"123".bytes().run(0, digits)} ${line.eq_at(0, 4, "Host".bytes())} ${line.eq_at(0, 4, host)} ${line.ieq_at(0, 4, host)} ${line.ieq_at(0, 4, "hos".bytes())} ${line.eq_at(5, 5, "".bytes())} ${"É".bytes().ieq_at(0, 2, "é".bytes())} ${line.index_in("\r\n".bytes(), 0, 17)} ${line.index_in("\r\n".bytes(), 0, 16)} ${line.index_in(".".bytes(), 10, 17)} ${line.index_in("".bytes(), 5, 5)}"
