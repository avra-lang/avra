// The red team's survivors, by attack class: every slot with every
// wrong type, the surface malformed token by token, the crossings
// into every other feature, names against the built-in's name, and
// the degenerate shapes. Each attack that refused refuses ONCE, in
// its own words; each that ran agrees with its native twin in
// the `bytes_owned` program.
use @std.avrac.testing.{shown, refused_with, refused_at_run, refusals}

/// A one-byte subject.
fn one() -> string { "let b = [1].bytes()!\n" }

spec "features/bytes adversarial" {
    given "degenerate shapes" {
        then "the seven answering words answer over the empty value" {
            shown(
                "let e = \"\".bytes()\nlet f = [].bytes()!\n\"\${e.length} \${e.is_empty()} \${e == f} \${e.text()!.length} \${e.slice(0, 0).length} \${e.concat(f).length} \${e.index_of(f, 0)} \${e.index_of([1].bytes()!, 0)}\"",
            ) == "0 true true 0 0 0 0 -1"
        }
        then "the six answering words answer over one byte" {
            shown(
                "let b = [9].bytes()!\n\"\${b.at(0)} \${b.slice(0, 1) == b} \${b.slice(1, 1).length} \${b.index_of(b, 0)} \${b.index_of(b, 1)} \${b.text() == null}\"",
            ) == "9 true 0 0 -1 false"
        }
        then "all 256 byte values round-trip and are not text" {
            shown(
                "let all = [i for i in 0..256].bytes()!\n\"\${all.length} \${all.at(255)} \${all.text() == null} \${all.slice(0, 128).text()!.length}\"",
            ) == "256 255 true 128"
        }
        then "the whole slice is equal and the end slice is empty" {
            shown(
                "let b = \"hello\".bytes()\n\"\${b.slice(0, 5) == b} \${b.slice(5, 5).is_empty()}\"",
            ) == "true true"
        }
        then "an empty list's bytes are present, not absent" {
            shown("[].bytes() == null") == "false"
        }
        then "every way to make an empty Bytes is present in a Bytes? slot; only null is absent" {
            shown(
                "fn made(k: int) -> Bytes? {\n    match k {\n        0 -> \"\".bytes(),\n        1 -> [].bytes(),\n        2 -> [1].bytes()!.slice(1, 1),\n        3 -> \"\".bytes().concat([].bytes()!),\n        4 -> [7].bytes()!.slice(0, 0),\n        _ -> null,\n    }\n}\ntype Slot = { b: Bytes? }\nlet slots = [Slot { b: made(i) } for i in 0..6]\n[\"\${s.b != null}\" for s in slots].join(\",\")",
            ) == "true,true,true,true,true,false"
        }
    }
    given "wrong types in every slot" {
        then "at wants an int, not text" { refused_with(one() + "b.at(\"0\")", "argument 1 of `at` wants `int`, found `string`") }
        then "at wants an int, not a bool" { refused_with(one() + "b.at(true)", "argument 1 of `at` wants `int`, found `bool`") }
        then "at wants an int, not a list" { refused_with(one() + "b.at([0])", "argument 1 of `at` wants `int`, found `List<int>`") }
        then "at takes one argument, not none" { refused_with(one() + "b.at()", "`at` takes 1 arguments, found 0") }
        then "at takes one argument, not two" { refused_with(one() + "b.at(0, 1)", "`at` takes 1 arguments, found 2") }
        then "slice takes two arguments" { refused_with(one() + "b.slice(0).length", "`slice` takes 2 arguments, found 1") }
        then "slice wants ints" { refused_with(
                one() + "b.slice(\"a\", 1).length",
                "argument 1 of `slice` wants `int`, found `string`",
            ) }
        then "concat wants Bytes, not text" { refused_with(
                one() + "b.concat(\"x\").length",
                "argument 1 of `concat` wants `Bytes`, found `string`",
            ) }
        then "concat wants Bytes, not an int" { refused_with(
                one() + "b.concat(1).length",
                "argument 1 of `concat` wants `Bytes`, found `int`",
            ) }
        then "index_of wants a Bytes needle" { refused_with(
                one() + "b.index_of(\"x\", 0)",
                "argument 1 of `index_of` wants `Bytes`, found `string`",
            ) }
        then "index_of takes its from" { refused_with(one() + "b.index_of(b)", "`index_of` takes 2 arguments, found 1") }
        then "text takes nothing" { refused_with(one() + "b.text(1)", "`text` takes 0 arguments, found 1") }
        then "bytes takes nothing" { refused_with("\"x\".bytes(1).length", "`bytes` takes 0 arguments, found 1") }
        then "a list of bools is not octets" { refused_with(
                "[true].bytes()",
                "`bytes` reads a `List<int>` or a `List<Bytes>`, this is `List<bool>`",
            ) }
        then "a list of lists is not octets" { refused_with(
                "[[1]].bytes()",
                "`bytes` reads a `List<int>` or a `List<Bytes>`, this is `List<List<int>>`",
            ) }
        then "== against an int refuses" { refused_with(one() + "b == 1", "`==` compares matching types, found `Bytes` and `int`") }
        then "+ refuses per operand, as the spine does for text" { refusals(one() + "(b.concat(b)) == b + b") == 2 }
        then "! refuses" { refused_with(one() + "!b", "`!` negates a `bool`, found `Bytes`") }
        then "length is a property, not a method" { refused_with(
                one() + "b.length()",
                "`.length(…)` calls a method, and `Bytes` has none",
            ) }
        then "length is measured, not stored" { refused_with(
                "mut b = [1].bytes()!\nb.length = 3\nb.length",
                "`length` is measured, not stored — `Bytes` has no such slot",
            ) }
        then "no index write, so no path ever clones a Bytes" { refused_with(
                "mut b = [1].bytes()!\nb[0] = 2\nb.length",
                "`[...]` indexes a `List`, found `Bytes`",
            ) }
        then "a Bytes does not fill a string let" { refused_with(
                "let s: string = [1].bytes()!\ns.length",
                "`s` declares `string`, this is `Bytes`",
            ) }
        then "a string does not fill a Bytes let" { refused_with("let b: Bytes = \"x\"\nb.length", "`b` declares `Bytes`, this is `string`") }
        then "a list does not fill a Bytes let" { refused_with(
                "let b: Bytes = [1]\nb.length",
                "`b` declares `Bytes`, this is `List<int>`",
            ) }
        then "== null asks a nullable" { refused_with(one() + "b == null", "`== null` asks a nullable, this is `Bytes`") }
    }
    given "malformed surface" {
        then "the type is spelled Bytes" { refused_with("let b: bytes = \"x\".bytes()\nb.length", "`bytes` names no type") }
        then "Bytes takes no type arguments" { refused_with(
                "let b: Bytes<int> = \"x\".bytes()\nb.length",
                "`Bytes` takes no type arguments",
            ) }
        then "Bytes is not a struct to construct" { refused_with("let b = Bytes { }\nb.length", "no `type Bytes` is declared") }
        then "Bytes is not a value" { refused_with("let x = Bytes\nx", "`Bytes` is not defined") }
        then "bytes is a method, not a property" { refused_with("let b = \"x\".bytes\nb.length", "no property `bytes` on `string`") }
        then "a Bytes? is unwrapped before it is read" { refused_with(
                "let b = [1].bytes()\nb.length",
                "`.length` reads a guarantee, this is `Bytes?`",
            ) }
        then "a user type may not take the built-in's name" { refused_with(
                "type Bytes = { v: int }\nlet b = Bytes { v: 3 }\nb.v",
                "`Bytes` is a built-in type",
            ) }
    }
    given "crossing every feature" {
        then "seats, tails and lists of Bytes" {
            shown(
                "fn tail(b: Bytes) -> Bytes { b.slice(1, b.length) }\nlet b = \"abc\".bytes()\n\"\${tail(b).length} \${tail(tail(b)).at(0)} \${[b, tail(b)].length}\"",
            ) == "2 99 2"
        }
        then "if, match, for and while all carry a Bytes" {
            shown(
                "fn pick(k: int) -> Bytes { if k == 0 { \"a\".bytes() } else { \"bb\".bytes() } }\nfn arm(k: int) -> Bytes { match k { 0 -> \"x\".bytes(), 1 -> \"yy\".bytes(), _ -> \"\".bytes() } }\nmut acc = \"\".bytes()\nfor i in 0..4 { acc = acc.concat(pick(i % 2)) }\nmut n = 0\nwhile n < 3 {\n    acc = acc.concat(arm(n))\n    n = n + 1\n}\nacc.text()!",
            ) == "abbabbxyy"
        }
        then "a struct field holds a Bytes and with replaces it" {
            shown(
                "type Frame = { head: Bytes, body: Bytes }\nlet f = Frame { head: \"GET\".bytes(), body: [0, 1].bytes()! }\nlet g = f with { body: \"\".bytes() }\n\"\${f.body.length} \${g.body.length} \${g.head == f.head}\"",
            ) == "2 0 true"
        }
        then "a list scans Bytes by value, never by pointer" {
            shown(
                "let a = [1, 2].bytes()!\nlet b = [1, 2].bytes()!\nlet xs = [a, [3].bytes()!]\n\"\${xs.contains(b)} \${xs.index_of(b)} \${xs.any(it == b)}\"",
            ) == "true 0 true"
        }
        then "a map holds Bytes values" {
            shown(
                "mut m: Map<string, Bytes> = {}\nm.set(\"k\", \"v\".bytes())\nm.set(\"k\", \"vv\".bytes())\n\"\${m.get(\"k\")!.length} \${m.get(\"z\") == null}\"",
            ) == "2 true"
        }
        then "a closure captures a Bytes" {
            shown(
                "let b = \"abc\".bytes()\nlet f = (i: int) -> b.at(i)\n\"\${f(1)} \${[f(i) for i in 0..3].bytes()!.text()!}\"",
            ) == "98 abc"
        }
        then "a Bytes? flows through ??, if let and ?." {
            shown(
                "fn maybe(k: int) -> Bytes? { if k > 0 { [k].bytes() } else { null } }\nlet none = 0 - 1\nlet seen = if let v? = maybe(7) { v.at(0) } else { 0 }\n\"\${(maybe(0) ?? \"z\".bytes()).at(0)} \${seen} \${maybe(2)?.length ?? none} \${maybe(0)?.length ?? none}\"",
            ) == "122 7 1 -1"
        }
        then "a Result carries a Bytes and ? propagates it" {
            shown(
                "fn parse(b: Bytes) -> Result<Bytes, string> {\n    if b.is_empty() { fail \"empty\" }\n    .Ok(b.slice(0, 1))\n}\nfn first(b: Bytes) -> Result<int, string> {\n    let head = parse(b)?\n    .Ok(head.at(0))\n}\n\"\${parse(\"\".bytes()) is .Err} \${first(\"cd\".bytes()) is .Ok}\"",
            ) == "true true"
        }
        then "a generic seat and a once fn both carry a Bytes" {
            shown(
                "fn same<T>(x: T) -> T { x }\nonce fn seed() -> Bytes { [7, 7].bytes()! }\n\"\${same(\"q\".bytes()).at(0)} \${seed() == seed()} \${same(seed()).at(1)}\"",
            ) == "113 true 7"
        }
        then "a trait method, an impl method and a generic field carry a Bytes" {
            shown(
                "trait Wire { fn wire() -> Bytes }\ntype Ping = { n: int }\nimpl Wire for Ping { fn wire() -> Bytes { [self.n].bytes()! } }\ntype Box<T> = { v: T }\nfn send(w: dyn Wire) -> int { w.wire().length }\n\"\${send(Ping { n: 65 })} \${Box { v: \"boxed\".bytes() }.v.length}\"",
            ) == "1 5"
        }
        then "a match over Bytes? takes null and the present arm" {
            shown(
                "fn describe(b: Bytes?) -> int {\n    match b {\n        null -> 0\n        v? -> v.length + 1\n    }\n}\n\"\${describe(null)} \${describe(\"abc\".bytes())} \${describe([].bytes())}\"",
            ) == "0 4 1"
        }
        then "a table row holds a Bytes" {
            shown(
                "type Row = { name: string, wire: Bytes }\nlet rows = table<Row> {\n    name  | wire\n    \"get\" | \"GET\".bytes()\n    \"put\" | \"PUT\".bytes()\n}\n\"\${rows[1].wire.at(0)} \${rows.length}\"",
            ) == "80 2"
        }
        then "a recursion answers Bytes at every depth" {
            shown(
                "fn rev(b: Bytes) -> Bytes {\n    if b.length <= 1 { return b }\n    rev(b.slice(1, b.length)).concat(b.slice(0, 1))\n}\n\"\${rev(\"abc\".bytes()).text()!} \${rev(\"\".bytes()).length}\"",
            ) == "cba 0"
        }
        then "two lists of Bytes do not compare" { refused_with(
                "let a = [\"a\".bytes()]\nlet b = [\"a\".bytes()]\na == b",
                "`==` compares scalars for now",
            ) }
        then "a program's answer cannot be a Bytes" { refused_at_run(
                "\"ab\".bytes()",
                "the program's answer is a `Bytes`, which has no text projection yet",
            ) }
        then "join reads text, not Bytes" { refused_with(
                "[\"a\".bytes()].join(\",\")",
                "`join` reads a list of text, this one holds `Bytes`",
            ) }
    }
    given "names against names" {
        then "a fn named bytes and the method coexist" { shown("fn bytes() -> int { 4 }\nlet b = \"ab\".bytes()\n\"\${bytes()} \${b.length}\"") == "4 2" }
        then "fields named bytes and at are fields" { shown(
                "type T = { bytes: int, at: int }\nlet t = T { bytes: 5, at: 6 }\n\"\${t.bytes} \${t.at}\"",
            ) == "5 6" }
        then "a binding named at is an argument" { shown("let at = 1\n\"xy\".bytes().at(at)") == "121" }
        then "a variant named Bytes is a variant" { shown("enum K { Bytes, Text }\nlet k = K.Bytes\n\"\${k is .Bytes} \${k == K.Text}\"") == "true false" }
        then "a value named Bytes is a value, as one named string is" { shown("let Bytes = 1\nlet string = 2\n\"\${Bytes} \${string}\"") == "1 2" }
        then "an inner let shadows an outer Bytes" { shown(
                "let b = \"a\".bytes()\nfn f() -> int {\n    let b = \"bcd\".bytes()\n    b.length\n}\n\"\${b.length} \${f()}\"",
            ) == "1 3" }
        then "use before definition refuses" { refused_with(
                "let n = b.length\nlet b = \"a\".bytes()\nn",
                "`b` is used before its definition",
            ) }
    }
}
