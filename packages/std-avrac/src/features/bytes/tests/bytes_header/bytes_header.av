//! THE LENGTH IS THE HEADER'S, through the one door that hands a
//! Bytes to the text length row: an extern over the runtime's own
//! symbol. Empty answers 0 and a NUL inside does not shorten the
//! answer — the row reads the header, never a scan. The spare byte
//! past the length is a NUL, so the scan that never runs would stop
//! at the box's edge anyway: the truncation is bounded, not undefined.
extern fn avra_str_len(b: Bytes) -> int

"${avra_str_len("".bytes())} ${avra_str_len([].bytes()!)} ${avra_str_len("hi".bytes())} ${avra_str_len([104, 0, 105].bytes()!)}"
