//! Every byte verb is one runtime call; `text` and `[ints].bytes()`
//! answer absence through the pointer niche.
use core.{Reg}
use features.{LowerCx, MethodCall}
use features.bytes.{gathers}

fn lower_of_str(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.rt_method(mc, "avra_bytes_of_str", []) }
/// The row follows the element: ints validate, parts gather.
fn lower_of_list(mut cx: LowerCx, mc: MethodCall) -> Reg {
    let word = if gathers(cx.view.types, cx.type_at(mc.subject)) { "avra_bytes_gathered" } else { "avra_bytes_of_list" }
    cx.rt_method(mc, word, [])
}
fn lower_text(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.rt_method(mc, "avra_str_of_bytes", []) }
fn lower_at(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.rt_method(mc, "avra_bytes_at", []) }
fn lower_slice(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.rt_method(mc, "avra_bytes_slice", []) }
fn lower_concat(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.rt_method(mc, "avra_bytes_concat", []) }
fn lower_index_of(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.rt_method(mc, "avra_bytes_index_of", []) }
fn lower_run(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.rt_method(mc, "avra_bytes_run", []) }
fn lower_eq_at(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.rt_method(mc, "avra_bytes_eq_at", []) }
fn lower_ieq_at(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.rt_method(mc, "avra_bytes_ieq_at", []) }
