//! Every byte verb is one runtime call; `text` and `[ints].bytes()`
//! answer absence through the pointer niche.
use core.{Reg}
use features.{LowerCx, MethodCall}
use features.bytes.{gathers}

fn lower_of_str(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.bytes_of_str(cx.shape_at(mc.e), cx.reg_of(mc.subject)) }
/// The row follows the element: ints validate, parts gather.
fn lower_of_list(mut cx: LowerCx, mc: MethodCall) -> Reg {
    let a0 = cx.reg_of(mc.subject)
    let sh = cx.shape_at(mc.e)
    if gathers(cx.view.types, cx.type_at(mc.subject)) { cx.bytes_gathered(sh, a0) } else { cx.bytes_of_list(sh, a0) }
}
fn lower_text(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.str_of_bytes(cx.shape_at(mc.e), cx.reg_of(mc.subject)) }
fn lower_text_prefix(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.str_of_bytes_prefix(cx.shape_at(mc.e), cx.reg_of(mc.subject)) }
fn lower_text_lossy(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.str_of_bytes_lossy(cx.shape_at(mc.e), cx.reg_of(mc.subject)) }
fn lower_at(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.bytes_at(cx.shape_at(mc.e), cx.reg_of(mc.subject), cx.reg_of(mc.args[0])) }
fn lower_slice(mut cx: LowerCx, mc: MethodCall) -> Reg {
    cx
        .bytes_slice(cx.shape_at(mc.e), cx.reg_of(mc.subject), cx.reg_of(mc.args[0]), cx.reg_of(mc.args[1]))
}
fn lower_concat(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.bytes_concat(cx.shape_at(mc.e), cx.reg_of(mc.subject), cx.reg_of(mc.args[0])) }
fn lower_index_of(mut cx: LowerCx, mc: MethodCall) -> Reg {
    cx
        .bytes_index_of(cx.shape_at(mc.e), cx.reg_of(mc.subject), cx.reg_of(mc.args[0]), cx.reg_of(mc.args[1]))
}
fn lower_index_in(mut cx: LowerCx, mc: MethodCall) -> Reg {
    cx
        .bytes_index_in(
            cx.shape_at(mc.e),
            cx.reg_of(mc.subject),
            cx.reg_of(mc.args[0]),
            cx.reg_of(mc.args[1]),
            cx.reg_of(mc.args[2]),
        )
}
fn lower_run(mut cx: LowerCx, mc: MethodCall) -> Reg {
    cx
        .bytes_run(cx.shape_at(mc.e), cx.reg_of(mc.subject), cx.reg_of(mc.args[0]), cx.reg_of(mc.args[1]))
}
fn lower_run_back(mut cx: LowerCx, mc: MethodCall) -> Reg {
    cx
        .bytes_run_back(cx.shape_at(mc.e), cx.reg_of(mc.subject), cx.reg_of(mc.args[0]), cx.reg_of(mc.args[1]))
}
fn lower_eq_at(mut cx: LowerCx, mc: MethodCall) -> Reg {
    cx
        .bytes_eq_at(
            cx.shape_at(mc.e),
            cx.reg_of(mc.subject),
            cx.reg_of(mc.args[0]),
            cx.reg_of(mc.args[1]),
            cx.reg_of(mc.args[2]),
        )
}
fn lower_ieq_at(mut cx: LowerCx, mc: MethodCall) -> Reg {
    cx
        .bytes_ieq_at(
            cx.shape_at(mc.e),
            cx.reg_of(mc.subject),
            cx.reg_of(mc.args[0]),
            cx.reg_of(mc.args[1]),
            cx.reg_of(mc.args[2]),
        )
}
