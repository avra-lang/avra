//! Every byte verb is one runtime call; `text` and `[ints].bytes()`
//! answer absence through the pointer niche.
use core.{Reg}
use features.{LowerCx, MethodCall, rt_method}

fn lower_of_str(mut cx: LowerCx, mc: MethodCall) -> Reg { rt_method(cx, mc, "avra_bytes_of_str", []) }
fn lower_of_list(mut cx: LowerCx, mc: MethodCall) -> Reg { rt_method(cx, mc, "avra_bytes_of_list", []) }
fn lower_text(mut cx: LowerCx, mc: MethodCall) -> Reg { rt_method(cx, mc, "avra_str_of_bytes", []) }
fn lower_at(mut cx: LowerCx, mc: MethodCall) -> Reg { rt_method(cx, mc, "avra_bytes_at", []) }
fn lower_slice(mut cx: LowerCx, mc: MethodCall) -> Reg { rt_method(cx, mc, "avra_bytes_slice", []) }
fn lower_concat(mut cx: LowerCx, mc: MethodCall) -> Reg { rt_method(cx, mc, "avra_bytes_concat", []) }
fn lower_index_of(mut cx: LowerCx, mc: MethodCall) -> Reg { rt_method(cx, mc, "avra_bytes_index_of", []) }
