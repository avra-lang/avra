//! Byte operations are runtime calls with explicit result ownership.
use core.{Reg, Type, Ins, BinOp}
use features.{LowerCx, MethodCall, rt_method, const_int}

fn lower_text(mut cx: LowerCx, mc: MethodCall) -> Reg { rt_method(cx, mc, "avra_bytes_of_str", []) }
fn lower_list(mut cx: LowerCx, mc: MethodCall) -> Reg { rt_method(cx, mc, "avra_bytes_of_list", []) }
fn lower_at(mut cx: LowerCx, mc: MethodCall) -> Reg { rt_method(cx, mc, "avra_bytes_at", []) }
fn lower_slice(mut cx: LowerCx, mc: MethodCall) -> Reg { rt_method(cx, mc, "avra_bytes_slice", []) }
fn lower_copy(mut cx: LowerCx, mc: MethodCall) -> Reg { rt_method(cx, mc, "avra_bytes_copy", []) }
fn lower_concat(mut cx: LowerCx, mc: MethodCall) -> Reg { rt_method(cx, mc, "avra_bytes_concat", []) }

fn lower_empty(mut cx: LowerCx, mc: MethodCall) -> Reg {
    let source = cx.reg_of(mc.subject)
    let length = cx.mint_shape(Type.Int)
    cx.emit(Ins.CallRt(length, "avra_bytes_len", [source]))
    let zero = const_int(cx, 0)
    let dst = cx.result(mc.e)
    cx.emit(Ins.Bin(dst, BinOp.Eq, length, zero))
    dst
}
