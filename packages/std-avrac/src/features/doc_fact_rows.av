//! `DocFact` — a declaration's doc text and its annotations, addressed by
//! the SAME dense slot `Decl`'s own array uses. A `@side` partition is
//! keyed by its own index, never a field, so this carries no `decl:
//! DeclId` column — the slot IS the key. The type stands alone in its
//! file, the reason `decl_rows.av` does: the relation derive types this
//! file while the files that use `DocFact` are still registering.
use core.{SideTable}
use @std.relation.{relation, side}

/// A declaration's own `///` lines (absent where it wrote none) and
/// every `@name(args)` it wears, in written order.
@relation
@side
export type DocFact = { doc: List<string>?, annotations: List<AnnotationFact> }
