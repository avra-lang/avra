//! Assembly: features compose into one grammar — their rules in
//! feature order, the first feature's first rule the start — and the
//! engine's build calls dispatch back through the features' builder
//! tables. Nothing is parsed here: a feature's `grammar { … }` was
//! read when the compiler ran.
use core.{NodeStore, Span}
use grammar.{Captured, Grammar, Rule}

/// The composed grammar, and which feature contributed each RULE —
/// a defect names its feature by the rule it landed in, where the
/// composed TEXT once named it by byte offset.
export type Composed = { built: Grammar, owners: List<RuleOwner> }

/// One rule's home.
export type RuleOwner = { feature: string, rule: string }

/// Every fragment, in feature order — the first feature's first rule
/// is the language's start rule.
export fn compose_grammar(features: List<LanguageFeature>) -> Composed {
    mut rules: List<Rule> = []
    mut owners: List<RuleOwner> = []
    for f in features {
        for r in f.gram.rules {
            rules.push(r)
            owners.push(RuleOwner { feature: f.name, rule: r.name })
        }
    }
    let start = if rules.is_empty() { "" } else { rules[0].name }
    Composed { built: Grammar { name: start, start: start, rules: rules }, owners: owners }
}

impl Composed {
    /// The feature that first contributed a rule of this name.
    fn feature_of(self, rule: string) -> string? {
        self.owners.find(it.rule == rule)?.feature
    }
}

/// The engine-facing dispatch: the first feature registering `name`
/// builds, through a Builder holding this call's world.
export fn dispatch(features: List<LanguageFeature>, store: NodeStore, name: string,
                   args: List<Captured<LangNode>>, span: Span?) -> Result<Captured<LangNode>, string> {
    for f in features {
        let hit: BuilderRow? = f.builders.find(it.name == name)
        if hit != null {
            let b = Builder { store: store, args: args, span: span }
            let got: Result<LangNode, string> = hit!.build(b)
            let built: LangNode = got?
            let out: Result<Captured<LangNode>, string> = .Ok(Captured.Node(built))
            return out
        }
    }
    .Err("no feature owns builder `${name}`")
}
