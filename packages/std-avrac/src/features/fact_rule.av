//! `fact_rule` — a rule that reads what the compiler knows of its code, beside the syntax a `rule`
//! reads alone: its subject is `Code`, and its declaration proves itself by `rule`'s law.
use features.{Code, Fix, Fixes}
use @std.meta.{Diagnostic}

/// A rule that reads what the compiler knows of its code beside its syntax: a binding, a type, a
/// declaration. Its subject is `Code`, and it proves itself by the law of `rule`.
export component fact_rule {
    run: fn(Code) -> Fix?
    doc: string = ""
    fixes: List<Fixes> = []
    keeps: List<string> = []
    law: List<string> = []
    says: List<string> = []

    fn check() -> List<Diagnostic> { rule_judged(self.fixes, self.keeps, self.law, self.says) }
}
