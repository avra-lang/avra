//! FACTS — the values every context and facade reads: the
//! language's registries once (`LanguageRows`), a file's view
//! (`FileView`), and the pass values that are pure data with the
//! verbs that read and write their own columns. The reads that
//! cross values, and the contexts' forwarders, live in contexts.av.
use core.{FileId, DeclId, StmtId, ExprId, TypeId, PatId, Type, NodeStore, TypeRegistry, Binding, Param, filled, Reg, Ins, dst_of, rt_sig_of, package_of_module}
use diagnostics.{SourceFile, DiagCode, Diag, Voices, no_voices, loc_at, refusal, defect_at}
use @std.errors.{Loc}

/// The language's registries, once — never copied into a program.
export type LanguageRows = { methods: List<MethodRow>, types: List<TypeRow>, properties: List<PropertyRow>, codes: List<DiagCode>, remedies: List<KeywordRemedy> }

/// The remedy a feature wrote for its keyword, when one did.
export fn remedy_for(rows: LanguageRows, word: string) -> string? {
    let row: KeywordRemedy? = rows.remedies.find(it.word == word)
    if row == null { return null }
    row!.help
}

/// What every context and facade reads of a file: its identity, its
/// nodes, its text, the declaration table, the type registry, and
/// the language's rows.
export type FileView = { file: FileId, store: NodeStore, stmts: List<StmtId>, source: SourceFile, decls: Decls, types: TypeRegistry, lang: LanguageRows }

impl FileView {
    /// Where an expression is — THE source position, every context
    /// forwards here.
    fn loc_of(e: ExprId) -> Loc? { loc_at(self.source.file, self.store.expr_span(e)) }

    fn pat_loc(p: PatId) -> Loc? { loc_at(self.source.file, self.store.pat_span(p)) }

    fn stmt_loc(s: StmtId) -> Loc? { loc_at(self.source.file, self.store.stmt_span(s)) }

    /// The module this file belongs to.
    fn module() -> string { self.decls.module_name(self.decls.file(self.file).module_id) }
    fn package() -> string { package_of_module(self.module()) }
}

/// A lambda's captures: the names it reached outside itself and the
/// binding each came from — creation packs sources[j] into slot 1+j,
/// and the lifted body reads the same lanes.
export type Cap = { names: List<string>, sources: List<Binding> }

/// A file's names: what each expression's name resolves to, each
/// lambda's captures, the namespace they were resolved in, and the
/// voices resolving earned.
export type NameFacts = { bindings: List<Binding?>, captures: List<Cap?>, mut_reads: List<bool>, names: Namespace, voices: Voices }

impl NameFacts {
    fn binding(e: ExprId) -> Binding? {
        let held: Binding? = self.bindings[e.index]
        held
    }

    /// Whether this parameter read names a `mut` seat — the
    /// resolver marks it as it binds.
    fn reads_mut_seat(e: ExprId) -> bool { self.mut_reads[e.index] }

    fn mark_mut_read(e: ExprId) {
        self.mut_reads.set(e.index, true)
    }

    fn capture(lam: ExprId) -> Cap? {
        let held: Cap? = self.captures[lam.index]
        held
    }
}

/// What a nullable was asked, for lowering: the subject, and whether
/// the branch runs on presence.
export type Asked = { subject: ExprId, on_present: bool }

/// A body's typing facts — columns dense over its expression RANGE
/// [lo, hi) (a declaration's body occupies one), and over the
/// file's statements for what a binding declared. `widens` names the
/// expressions a boundary LIFTED into a nullable; `narrows` the
/// reads a presence test proved; `substs` the instantiations mono
/// specializes; the want columns are the expected-type channel.
/// The enclosing fn's parameter types — a hungry node's typing scope.
type ParamScope = { params: List<TypeId> }

export type TypeFacts = {
    lo: int,
    of_expr: List<TypeId>,
    widens: List<TypeId?>,
    narrows: List<TypeId?>,
    asks: List<Asked?>,
    substs: List<Sub?>,
    lambda_params: List<List<TypeId>?>,
    // the `mut` marks those seats wear — written, or heard from the slot
    lambda_muts: List<List<bool>?>,
    // what each lambda CAPTURED, typed in lane order — the type a
    // capture read wears, wherever the lane is read
    captures: List<List<TypeId>?>,
    wants: List<TypeId?>,
    hungry: List<bool>,
    starved: List<TypeId?>,
    // the parameter scope a hungry node was typed under — what its
    // rule runs under again when fed or starving
    scopes: List<ParamScope?>,
    pattern_types: List<List<TypeId>>,
    binding_types: List<TypeId?>,
    // a `mut` binding that BORROWS a parameter's field (bs2's
    // aliasing, honored until self-host — ROADMAP: the bs2 debt ledger)
    borrows: List<bool>,
    voices: Voices,
}

/// Born total: every expression in the range pre-typed as the hole.
export fn new_type_facts(lo: int, hi: int, stmts: int, hole: TypeId) -> TypeFacts {
    let exprs = hi - lo
    TypeFacts {
        lo: lo,
        of_expr: filled(exprs, hole),
        widens: filled<TypeId?>(exprs, null),
        narrows: filled<TypeId?>(exprs, null),
        asks: filled<Asked?>(exprs, null),
        substs: filled<Sub?>(exprs, null),
        lambda_params: filled<List<TypeId>?>(exprs, null),
        lambda_muts: filled<List<bool>?>(exprs, null),
        captures: filled<List<TypeId>?>(exprs, null),
        wants: filled<TypeId?>(exprs, null),
        hungry: filled(exprs, false),
        starved: filled<TypeId?>(exprs, null),
        scopes: filled<ParamScope?>(exprs, null),
        pattern_types: empty_lists_ty(exprs),
        binding_types: filled<TypeId?>(stmts, null),
        borrows: filled(stmts, false),
        voices: no_voices(),
    }
}

impl TypeFacts {
    fn type_at(e: ExprId) -> TypeId { self.of_expr[e.index - self.lo] }
    /// Whether this table's range holds the expression — an
    /// expression is typed by the body that OWNS it, never another.
    fn owns(e: ExprId) -> bool { e.index >= self.lo && e.index - self.lo < self.of_expr.length }

    fn hungry_at(e: ExprId) -> bool { self.hungry[e.index - self.lo] }

    /// The hungry expressions, in range order.
    fn hungry_ones() -> List<ExprId> {
        mut out: List<ExprId> = []
        for j, h in self.hungry {
            if h { out.push(ExprId { index: self.lo + j }) }
        }
        out
    }

    /// The seat a starved expression wanted, when it was starved.
    fn starved_at(e: ExprId) -> TypeId? {
        let held: TypeId? = self.starved[e.index - self.lo]
        held
    }

    fn set_type(e: ExprId, ty: TypeId) {
        self.of_expr.set(e.index - self.lo, ty)
    }

    fn widen(v: ExprId, ty: TypeId) {
        self.widens.set(v.index - self.lo, ty)
    }

    fn widened_at(e: ExprId) -> TypeId? {
        let held: TypeId? = self.widens[e.index - self.lo]
        held
    }

    fn narrow(e: ExprId, opt: TypeId) {
        self.narrows.set(e.index - self.lo, opt)
    }

    fn narrowed_at(e: ExprId) -> TypeId? {
        let held: TypeId? = self.narrows[e.index - self.lo]
        held
    }

    fn record_ask(e: ExprId, subject: ExprId, on_present: bool) {
        self.asks.set(e.index - self.lo, Asked { subject: subject, on_present: on_present })
    }

    fn ask_of(e: ExprId) -> Asked? {
        let held: Asked? = self.asks[e.index - self.lo]
        held
    }

    fn record_subst(e: ExprId, target: DeclId, targs: List<TypeId>) {
        self.substs.set(e.index - self.lo, Sub { target: target, args: targs })
    }

    fn subst_at(e: ExprId) -> Sub? {
        let held: Sub? = self.substs[e.index - self.lo]
        held
    }

    fn set_want(e: ExprId, ty: TypeId) {
        self.wants.set(e.index - self.lo, ty)
    }

    fn want_at(e: ExprId) -> TypeId? {
        let held: TypeId? = self.wants[e.index - self.lo]
        held
    }

    fn go_hungry(e: ExprId) {
        self.hungry.set(e.index - self.lo, true)
    }

    fn remember_scope(e: ExprId, params: List<TypeId>) {
        self.scopes.set(e.index - self.lo, ParamScope { params: params })
    }

    fn scope_at(e: ExprId) -> List<TypeId>? {
        let held: ParamScope? = self.scopes[e.index - self.lo]
        held?.params
    }

    fn absorb_hunger(e: ExprId) {
        self.hungry.set(e.index - self.lo, false)
    }

    /// A hungry expression starved of the seat it wanted; true when
    /// it was hungry.
    fn starve(e: ExprId, want: TypeId) -> bool {
        if !self.hungry[e.index - self.lo] { return false }
        self.starved.set(e.index - self.lo, want)
        true
    }

    /// An arm's binds, typed in pattern order.
    fn bind_types(v: ExprId, tys: List<TypeId>) {
        self.pattern_types.set(v.index - self.lo, tys)
    }

    /// The arm's Nth bind, when the arm's owner spoke it.
    fn pattern_type(v: ExprId, j: int) -> TypeId? {
        let tys = self.pattern_types[v.index - self.lo]
        if j >= tys.length { return null }
        tys[j]
    }

    fn record_binding(s: StmtId, ty: TypeId) {
        self.binding_types.set(s.index, ty)
    }

    fn mark_borrow(s: StmtId) {
        self.borrows.set(s.index, true)
    }

    fn is_borrow(s: StmtId) -> bool { self.borrows[s.index] }

    /// Another body's facts laid into this table over its range,
    /// and every binding it declared — the per-file fold. The
    /// hunger columns (`hungry`, `starved`) are a body's own
    /// working state, spoken before its facts settle; the voices
    /// fold at the workspace, in source order.
    fn absorb(other: TypeFacts) {
        let at = other.lo - self.lo
        // EACH COLUMN THROUGH ITS FIELD: a fn handed the list could
        // only fill a copy, and the fold runs once per body
        // LICENSED I3: nine named columns, one write each — the walk is the copy
        for (j, v) in other.of_expr.enumerate() { self.of_expr.set(at + j, v) }
        for (j, v) in other.widens.enumerate() { self.widens.set(at + j, v) }
        for (j, v) in other.narrows.enumerate() { self.narrows.set(at + j, v) }
        for (j, v) in other.asks.enumerate() { self.asks.set(at + j, v) }
        for (j, v) in other.substs.enumerate() { self.substs.set(at + j, v) }
        for (j, v) in other.lambda_params.enumerate() { self.lambda_params.set(at + j, v) }
        for (j, v) in other.lambda_muts.enumerate() { self.lambda_muts.set(at + j, v) }
        for (j, v) in other.captures.enumerate() { self.captures.set(at + j, v) }
        for (j, v) in other.wants.enumerate() { self.wants.set(at + j, v) }
        for (j, v) in other.pattern_types.enumerate() { self.pattern_types.set(at + j, v) }
        for j, b in other.borrows {
            if b { self.borrows.set(j, true) }
        }
        for j, b in other.binding_types {
            if b != null { self.binding_types.set(j, b) }
        }
    }

    fn declared_binding(s: StmtId) -> TypeId? {
        let held: TypeId? = self.binding_types[s.index]
        held
    }

    fn seat_lambda(lam: ExprId, tys: List<TypeId>, marks: List<bool>) {
        self.lambda_params.set(lam.index - self.lo, tys)
        self.lambda_muts.set(lam.index - self.lo, marks)
    }

    fn lambda_marks(lam: ExprId) -> List<bool>? {
        let held: List<bool>? = self.lambda_muts[lam.index - self.lo]
        held
    }

    fn lambda_seats(lam: ExprId) -> List<TypeId>? {
        let held: List<TypeId>? = self.lambda_params[lam.index - self.lo]
        held
    }

    fn seat_captures(lam: ExprId, tys: List<TypeId>) {
        self.captures.set(lam.index - self.lo, tys)
    }

    /// The type the lambda's Nth capture wears — the CAPTURED
    /// binding's, never the lambda's or a reading node's.
    fn capture_type(lam: ExprId, j: int) -> TypeId? {
        let held: List<TypeId>? = self.captures[lam.index - self.lo]
        if held == null || j >= held!.length { return null }
        held![j]
    }

    fn speak(d: Diag) { self.voices.speak(d) }

}

impl Decls {
    fn decl_named(f: DeclId, mname: string) -> bool {
        let n: string? = self.fn_name(f)
        n == mname
    }
}

/// A body's instruction list under construction: registers mint in
/// instruction order, `give` is the mint-order law, and a runtime
/// callee must have its row in the registry.
export type Emitter = { ins: List<Ins>, reg_types: List<TypeId>, defined: List<Reg>, voices: Voices, externs: List<string> }

/// An emitter over a program whose externs it may call by name.
export fn new_emitter(externs: List<string>) -> Emitter {
    Emitter { ins: [], reg_types: [], defined: [], voices: no_voices(), externs: externs }
}

impl Emitter {
    /// THE defect phrase, worded once — the compiler blaming itself
    /// for a shape the gate should have refused.
    fn defect(what: string) { self.record("defect: ${what}") }

    fn mint_ty(ty: TypeId) -> Reg {
        self.reg_types.push(ty)
        Reg { index: self.reg_types.length - 1 }
    }

    fn type_of_reg(r: Reg) -> TypeId { self.reg_types[r.index] }

    /// A callee neither the registry nor the program's externs name.
    fn unknown_callee(name: string) -> bool {
        rt_sig_of(name) == null && !self.externs.contains(name)
    }

    fn give(i: Ins) {
        // A new CALLING instruction must decide whether the runtime
        // registry validates it; the arms make that unavoidable.
        let callee: string? = match i {
            .CallRt(_, c, _) -> c,
            .CallRtVoid(c, _) -> c,
            .ConstInt(_, _) or .ConstFloat(_, _) or .ConstStr(_, _) or .ConstBool(_, _) or
            .Bin(_, _, _, _) or .Un(_, _, _) or .Call(_, _, _) or
            .FnAddr(_, _) or .CallPtr(_, _, _) or
            .Pack(_, _) or .Extract(_, _, _) or
            .ScopeEnter(_) or .ScopeExit(_) or .IfStart(_) or
            .SwitchStart(_, _) or .ArmEnd(_) or .RegionEnd(_, _) or
            .Alloca(_) or .Load(_, _) or .Store(_, _) or
            .LoopStart or .LoopCond(_) or .LoopEnd or
            .Retain(_) or .Release(_) or .RetVal(_) or .FnExit(_) or
            .Ret(_) -> null,
        }
        if callee != null && self.unknown_callee(callee!) {
            self.defect("unknown runtime callee `${callee!}` — add its row to runtime_api.av")
        }
        self.defined_in_order(i)
        self.ins.push(i)
    }

    fn defined_in_order(i: Ins) {
        let d: Reg? = dst_of(i)
        if d == null { return }
        let dst = d!
        let expected = self.defined.length
        // LICENSED I9: REGISTER identity — a mint index, not a type
        if dst.index != expected {
            self.defect("register r${dst.index} defines out of mint order — r${expected} is next (mint operands first, the answer last)")
        }
        self.defined.push(dst)
    }

    /// The params are registers 0..N-1, defined before any instruction.
    fn seeded() {
        // LICENSED I3: the register IS its index
        for j in 0..self.reg_types.length { self.defined.push(Reg { index: j }) }
    }

    fn record(msg: string) { self.voices.speak(defect_at(null, msg)) }
}

/// A body's per-node registers: each expression's, each binding's
/// slot (a cell when boxed), each pattern bind's, each pairing
/// loop's index.
export type BodyRegs = { regs: List<Reg?>, slots: List<Reg?>, boxed: List<bool>, pattern_regs: List<List<Reg>>, index_regs: List<Reg?>, test_regs: List<List<Reg>> }

export fn new_body_regs(exprs: int, stmts: int, pats: int) -> BodyRegs {
    BodyRegs {
        regs: filled<Reg?>(exprs, null), slots: filled<Reg?>(stmts, null), boxed: filled(stmts, false),
        pattern_regs: empty_lists_reg(exprs), index_regs: filled<Reg?>(stmts, null),
        test_regs: empty_lists_reg(pats),
    }
}

impl BodyRegs {
    fn reg_at(e: ExprId) -> Reg? {
        let held: Reg? = self.regs[e.index]
        held
    }
    fn set_reg(e: ExprId, r: Reg) {
        self.regs.set(e.index, r)
    }
    fn slot_of(s: StmtId) -> Reg? {
        let held: Reg? = self.slots[s.index]
        held
    }
    fn set_slot(s: StmtId, r: Reg) {
        self.slots.set(s.index, r)
    }
    fn bind_slot(s: StmtId, cell: Reg) {
        self.boxed.set(s.index, true)
        self.set_slot(s, cell)
    }
    fn is_boxed(s: StmtId) -> bool { self.boxed[s.index] }
    fn pattern_reg(v: ExprId, j: int) -> Reg? {
        let regs = self.pattern_regs[v.index]
        if j >= regs.length { return null }
        regs[j]
    }
    fn bind_patterns(v: ExprId, regs: List<Reg>) {
        self.pattern_regs.set(v.index, regs)
    }
    fn index_reg(s: StmtId) -> Reg? {
        let held: Reg? = self.index_regs[s.index]
        held
    }
    /// WHAT A PATTERN'S TEST PRODUCED FOR ITS BINDS. Enums' protocol
    /// is TEST then BIND — the test emits OUTSIDE an arm's region so
    /// an untaken arm reads nothing, the binds inside — and a
    /// pattern whose test IS its bind would otherwise run its scan
    /// twice. Keyed by the PATTERN, so a nested one finds its own
    /// and no caller threads it through the recursion.
    fn test_regs_of(p: PatId) -> List<Reg> {
        self.test_regs[p.index]
    }
    fn bind_test(p: PatId, regs: List<Reg>) {
        self.test_regs.set(p.index, regs)
    }
    fn bind_index(s: StmtId, r: Reg) {
        self.index_regs.set(s.index, r)
    }
}

/// `n` empty type lists — spelled without the generic fill: a test
/// shard instantiating a list-writing generic at a list-of-lists
/// type loses its writes (CLAUDE.md).
fn empty_lists_ty(n: int) -> List<List<TypeId>> {
    mut out: List<List<TypeId>> = []
    mut i = 0
    while i < n {
        out.push([])
        i = i + 1
    }
    out
}

fn empty_lists_reg(n: int) -> List<List<Reg>> {
    mut out: List<List<Reg>> = []
    mut i = 0
    while i < n {
        out.push([])
        i = i + 1
    }
    out
}
