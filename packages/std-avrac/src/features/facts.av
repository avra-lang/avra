//! FACTS — the values every context and facade reads: the
//! language's registries once (`LanguageRows`), a file's view
//! (`FileView`), and the pass values that are pure data with the
//! verbs that read and write their own columns. The reads that
//! cross values, and the contexts' forwarders, live in contexts.av.
use core.{FileId, DeclId, StmtId, ExprId, TypeId, PatId, Type, Span, NodeStore, TypeRegistry, Binding, Param, Reg, Ins, dst_of, rt_sig_of}
use core.{SeatMark, SideTable, side_table, side_table_of}
use diagnostics.{SourceFile, DiagCode, Diag, Voices, no_voices, loc_at, refusal, defect_at}
use @std.errors.{Loc}

/// The language's registries, once — never copied into a program.
export type LanguageRows = { methods: List<MethodRow>, types: List<TypeRow>, properties: List<PropertyRow>, codes: List<DiagCode>, remedies: List<KeywordRemedy> }

/// The remedy a feature wrote for its keyword, when one did.
export fn remedy_for(rows: LanguageRows, word: string) -> string? {
    let row? = rows.remedies.find(it.word == word) else { return null }
    row.help
}

/// What every context and facade reads of a file: its identity, its
/// nodes, its text, the declaration table, the type registry, and
/// the language's rows.
export type FileView = { file: FileId, store: NodeStore, stmts: List<StmtId>, source: SourceFile, decls: Decls, types: TypeRegistry, lang: LanguageRows }

impl FileView {
    /// Where an expression is — THE source position, every context
    /// forwards here. A GENERATED node is homed: a template's run
    /// points into the file that wrote the quote, a hole's at the
    /// annotation that asked for the code.
    fn loc_of(e: ExprId) -> Loc? { self.decls.homed(self.file, self.origin_of(e), self.decls.generation_of(self.file, e), self.store.expr_span(e)) }

    fn pat_loc(p: PatId) -> Loc? { self.decls.homed(self.file, self.origin_of_pat(p), self.decls.generation_of_pat(self.file, p), self.store.pat_span(p)) }

    fn stmt_loc(s: StmtId) -> Loc? { self.decls.homed(self.file, self.origin_of_stmt(s), self.decls.generation_of_stmt(self.file, s), self.store.stmt_span(s)) }

    /// The file a generated node was WRITTEN in, when it is another
    /// than this one — a template's own node. Null for a written node
    /// and for one whose name came through a hole: both resolve here.
    fn origin_of(e: ExprId) -> FileId? { self.decls.origin_of_expr(self.file, e) }

    fn origin_of_stmt(s: StmtId) -> FileId? { self.decls.origin_of_stmt(self.file, s) }

    fn origin_of_pat(p: PatId) -> FileId? { self.decls.origin_of_pat(self.file, p) }

    /// The module this file belongs to.
    fn module() -> string { self.decls.module_name(self.decls.file(self.file).module_id) }
    fn package() -> string { self.decls.package_named(self.module()) }
}

/// A lambda's captures: the names it reached outside itself and the
/// binding each came from — creation packs sources[j] into slot 1+j,
/// and the lifted body reads the same lanes.
export type Cap = { names: List<string>, sources: List<Binding> }

/// A file's names: what each expression's name resolves to, each
/// lambda's captures, the namespace they were resolved in, and the
/// voices resolving earned.
export type NameFacts = { bindings: SideTable<Binding?>, captures: SideTable<Cap?>, mut_reads: SideTable<bool>, settled_reads: SideTable<bool>, names: Namespace, voices: Voices }

/// Born total over the file's expressions: nothing bound, nothing
/// captured, no seat read yet.
export fn new_name_facts(exprs: int, names: Namespace) -> NameFacts {
    NameFacts {
        bindings: side_table<Binding?>("bindings", 0, exprs, null),
        captures: side_table<Cap?>("captures", 0, exprs, null),
        mut_reads: side_table("mut_reads", 0, exprs, false),
        settled_reads: side_table("settled_reads", 0, exprs, false),
        names: names, voices: no_voices(),
    }
}

impl NameFacts {
    fn binding(e: ExprId) -> Binding? { self.bindings.get(e.index) }

    /// Whether this parameter read names a `mut` seat — the
    /// resolver marks it as it binds.
    fn reads_mut_seat(e: ExprId) -> bool { self.mut_reads.get(e.index) }

    fn mark_mut_read(e: ExprId) {
        self.mut_reads.set(e.index, true)
    }

    /// Whether this parameter read names a `const` (settled) seat —
    /// the resolver marks it as it binds, the way it marks `mut`.
    fn reads_settled_seat(e: ExprId) -> bool { self.settled_reads.get(e.index) }

    fn mark_settled_read(e: ExprId) {
        self.settled_reads.set(e.index, true)
    }

    fn capture(lam: ExprId) -> Cap? { self.captures.get(lam.index) }
}

/// What a nullable was asked, for lowering: the subject, and whether
/// the branch runs on presence.
export type Asked = { subject: ExprId, on_present: bool }

/// A body's typing facts — columns dense over its expression RANGE
/// [lo, hi) (a declaration's body occupies one), and over the
/// file's statements for what a binding declared. `widens` names the
/// expressions a boundary LIFTED into a nullable; `narrows` the
/// reads a presence test proved; `substs` the instantiations mono
/// specializes; the want columns are the expected-type channel.
/// The enclosing fn's parameter types — a hungry node's typing scope.
type ParamScope = { params: List<TypeId> }

export type TypeFacts = {
    of_expr: SideTable<TypeId>,
    widens: SideTable<TypeId?>,
    narrows: SideTable<TypeId?>,
    asks: SideTable<Asked?>,
    substs: SideTable<Sub?>,
    lambda_params: SideTable<List<TypeId>?>,
    // the seat CONTRACTS those seats wear — written, or heard from the slot
    lambda_marks: SideTable<List<SeatMark>?>,
    // what each lambda CAPTURED, typed in lane order — the type a
    // capture read wears, wherever the lane is read
    captures: SideTable<List<TypeId>?>,
    wants: SideTable<TypeId?>,
    hungry: SideTable<bool>,
    starved: SideTable<TypeId?>,
    // the parameter scope a hungry node was typed under — what its
    // rule runs under again when fed or starving
    scopes: SideTable<ParamScope?>,
    pattern_types: SideTable<List<TypeId>>,
    binding_types: SideTable<TypeId?>,
    // a `mut` binding that BORROWS a parameter's field (bs2's
    // aliasing, honored until self-host — ROADMAP: the bs2 debt ledger)
    // a use whose declaration's warnings were already spoken — one
    // voice per use, however often the node is typed
    warned: SideTable<bool>,
    // a writing call whose receiver is a bare `mut` local copied from
    // a place (F2096, `alias_copy_law`) — lowering opens its cell unique
    alias_copy_calls: SideTable<bool>,
    voices: Voices,
}

/// Born total: every expression in the range pre-typed as the hole.
/// THE WINDOW IS THE TABLE'S — the expression columns run over
/// [lo, hi) and the statement columns over the whole file, so no
/// reader subtracts anything.
export fn new_type_facts(lo: int, hi: int, stmts: int, hole: TypeId) -> TypeFacts {
    let no_types: List<TypeId> = []
    TypeFacts {
        of_expr: side_table("of_expr", lo, hi, hole),
        widens: side_table<TypeId?>("widens", lo, hi, null),
        narrows: side_table<TypeId?>("narrows", lo, hi, null),
        asks: side_table<Asked?>("asks", lo, hi, null),
        substs: side_table<Sub?>("substs", lo, hi, null),
        lambda_params: side_table<List<TypeId>?>("lambda_params", lo, hi, null),
        lambda_marks: side_table<List<SeatMark>?>("lambda_marks", lo, hi, null),
        captures: side_table<List<TypeId>?>("captures", lo, hi, null),
        wants: side_table<TypeId?>("wants", lo, hi, null),
        hungry: side_table("hungry", lo, hi, false),
        warned: side_table("warned", lo, hi, false),
        alias_copy_calls: side_table("alias_copy_calls", lo, hi, false),
        starved: side_table<TypeId?>("starved", lo, hi, null),
        scopes: side_table<ParamScope?>("scopes", lo, hi, null),
        pattern_types: side_table_of("pattern_types", lo, empty_lists_ty(hi - lo), no_types),
        binding_types: side_table<TypeId?>("binding_types", 0, stmts, null),
        voices: no_voices(),
    }
}

impl TypeFacts {
    fn type_at(e: ExprId) -> TypeId { self.of_expr.get(e.index) }
    /// Whether this table's window holds the expression — an
    /// expression is typed by the body that OWNS it, never another.
    fn owns(e: ExprId) -> bool { self.of_expr.holds(e.index) }

    fn hungry_at(e: ExprId) -> bool { self.hungry.get(e.index) }

    /// The hungry expressions, in window order.
    fn hungry_ones() -> List<ExprId> {
        [ExprId { index: i } for i in self.hungry.ids(is_hungry)]
    }

    /// The seat a starved expression wanted, when it was starved.
    fn starved_at(e: ExprId) -> TypeId? { self.starved.get(e.index) }

    fn set_type(e: ExprId, ty: TypeId) {
        self.of_expr.set(e.index, ty)
    }

    fn widen(v: ExprId, ty: TypeId) {
        self.widens.set(v.index, ty)
    }

    fn widened_at(e: ExprId) -> TypeId? { self.widens.get(e.index) }

    fn narrow(e: ExprId, opt: TypeId) {
        self.narrows.set(e.index, opt)
    }

    fn narrowed_at(e: ExprId) -> TypeId? { self.narrows.get(e.index) }

    fn record_ask(e: ExprId, subject: ExprId, on_present: bool) {
        self.asks.set(e.index, Asked { subject: subject, on_present: on_present })
    }

    fn ask_of(e: ExprId) -> Asked? { self.asks.get(e.index) }

    fn record_subst(e: ExprId, target: DeclId, targs: List<TypeId>, consts: List<string>) {
        self.substs.set(e.index, Sub { target: target, args: targs, consts: consts })
    }

    fn subst_at(e: ExprId) -> Sub? { self.substs.get(e.index) }

    fn set_want(e: ExprId, ty: TypeId) {
        self.wants.set(e.index, ty)
    }

    fn want_at(e: ExprId) -> TypeId? { self.wants.get(e.index) }

    fn go_hungry(e: ExprId) {
        self.hungry.set(e.index, true)
    }

    fn remember_scope(e: ExprId, params: List<TypeId>) {
        self.scopes.set(e.index, ParamScope { params: params })
    }

    fn scope_at(e: ExprId) -> List<TypeId>? { self.scopes.get(e.index)?.params }

    fn absorb_hunger(e: ExprId) {
        self.hungry.set(e.index, false)
    }

    /// A hungry expression starved of the seat it wanted; true when
    /// it was hungry.
    fn starve(e: ExprId, want: TypeId) -> bool {
        if !self.hungry.get(e.index) { return false }
        self.starved.set(e.index, want)
        true
    }

    /// An arm's binds, typed in pattern order.
    fn bind_types(v: ExprId, tys: List<TypeId>) {
        self.pattern_types.set(v.index, tys)
    }

    /// The arm's Nth bind, when the arm's owner spoke it.
    fn pattern_type(v: ExprId, j: int) -> TypeId? {
        let tys = self.pattern_types.get(v.index)
        if j >= tys.length { return null }
        tys[j]
    }

    fn record_binding(s: StmtId, ty: TypeId) {
        self.binding_types.set(s.index, ty)
    }

    /// Whether this use already spoke its declaration's warnings.
    fn spoke_warning(e: ExprId) -> bool { self.warned.get(e.index) }

    fn mark_warned(e: ExprId) {
        self.warned.set(e.index, true)
    }

    /// Whether this writing call's receiver is a bare `mut` local
    /// copied from a place — checking's one answer, lowering's one
    /// read; the derivation lives at `alias_copy_law` alone.
    fn wants_alias_copy(e: ExprId) -> bool { self.alias_copy_calls.get(e.index) }

    fn mark_alias_copy_call(e: ExprId) {
        self.alias_copy_calls.set(e.index, true)
    }

    /// Another body's facts laid into this table over its range,
    /// and every binding it declared — the per-file fold. The
    /// hunger columns (`hungry`, `starved`) are a body's own
    /// working state, spoken before its facts settle; the voices
    /// fold at the workspace, in source order.
    fn absorb(other: TypeFacts) {
        // EACH COLUMN THROUGH ITS FIELD: a fn handed the table could
        // only fill a copy, and the fold runs once per body. The
        // OFFSET is the tables' own — each window knows where it sits.
        // LICENSED I3: twelve named columns, one lay each
        self.of_expr.lay(other.of_expr)
        self.widens.lay(other.widens)
        self.narrows.lay(other.narrows)
        self.asks.lay(other.asks)
        self.substs.lay(other.substs)
        self.lambda_params.lay(other.lambda_params)
        self.lambda_marks.lay(other.lambda_marks)
        self.captures.lay(other.captures)
        self.wants.lay(other.wants)
        self.pattern_types.lay(other.pattern_types)
        self.alias_copy_calls.lay(other.alias_copy_calls)
        self.binding_types.lay_named(other.binding_types, is_typed)
    }

    fn declared_binding(s: StmtId) -> TypeId? { self.binding_types.get(s.index) }

    fn seat_lambda(lam: ExprId, tys: List<TypeId>, marks: List<SeatMark>) {
        self.lambda_params.set(lam.index, tys)
        self.lambda_marks.set(lam.index, marks)
    }

    fn heard_marks(lam: ExprId) -> List<SeatMark>? { self.lambda_marks.get(lam.index) }

    fn lambda_seats(lam: ExprId) -> List<TypeId>? { self.lambda_params.get(lam.index) }

    fn seat_captures(lam: ExprId, tys: List<TypeId>) {
        self.captures.set(lam.index, tys)
    }

    /// The type the lambda's Nth capture wears — the CAPTURED
    /// binding's, never the lambda's or a reading node's.
    fn capture_type(lam: ExprId, j: int) -> TypeId? {
        let held: List<TypeId>? = self.captures.get(lam.index)
        if held == null || j >= held!.length { return null }
        held![j]
    }

    fn speak(d: Diag) { self.voices.speak(d) }

}

impl Decls {
    fn decl_named(f: DeclId, mname: string) -> bool {
        let n: string? = self.fn_name(f)
        n == mname
    }
}

/// A body's instruction list under construction: registers mint in
/// instruction order, `give` is the mint-order law, and a runtime
/// callee must have its row in the registry.
export type Emitter = { ins: List<Ins>, reg_types: List<TypeId>, defined: List<Reg>, voices: Voices, externs: List<string> }

/// An emitter over a program whose externs it may call by name.
export fn new_emitter(externs: List<string>) -> Emitter {
    Emitter { ins: [], reg_types: [], defined: [], voices: no_voices(), externs: externs }
}

impl Emitter {
    /// THE defect phrase, worded once — the compiler blaming itself
    /// for a shape the gate should have refused.
    fn defect(what: string) { self.record("defect: ${what}") }

    fn mint_ty(ty: TypeId) -> Reg {
        self.reg_types.push(ty)
        Reg { index: self.reg_types.length - 1 }
    }

    fn type_of_reg(r: Reg) -> TypeId { self.reg_types[r.index] }

    /// A callee neither the registry nor the program's externs name.
    fn unknown_callee(name: string) -> bool {
        rt_sig_of(name) == null && !self.externs.contains(name)
    }

    fn give(i: Ins) {
        // A new CALLING instruction must decide whether the runtime
        // registry validates it; the arms make that unavoidable.
        let callee: string? = match i {
            .CallRt(_, c, _) or .CallRtVoid(c, _) -> c,
            .ConstInt(_, _) or .ConstFloat(_, _) or .ConstStr(_, _) or .ConstBool(_, _)
                or .Bin(_, _, _, _) or .Un(_, _, _) or .Call(_, _, _)
                or .FnAddr(_, _) or .StaticAddr(_, _) or .CallPtr(_, _, _)
                or .Pack(_, _) or .Extract(_, _, _)
                or .ScopeEnter(_) or .ScopeExit(_) or .IfStart(_)
                or .SwitchStart(_, _) or .ArmEnd(_) or .RegionEnd(_, _)
                or .Alloca(_) or .Load(_, _) or .Store(_, _)
                or .LoopStart or .LoopCond(_) or .LoopEnd
                or .Retain(_) or .Release(_) or .RetVal(_) or .FnExit(_) or .Ret(_) -> null,
        }
        if callee != null && self.unknown_callee(callee!) {
            self.defect("unknown runtime callee `${callee!}` — add its row to runtime_api.av")
        }
        self.defined_in_order(i)
        self.ins.push(i)
    }

    fn defined_in_order(i: Ins) {
        let dst? = dst_of(i) else { return }
        let expected = self.defined.length
        // LICENSED I9: REGISTER identity — a mint index, not a type
        if dst.index != expected {
            self.defect("register r${dst.index} defines out of mint order — r${expected} is next (mint operands first, the answer last)")
        }
        self.defined.push(dst)
    }

    /// The params are registers 0..N-1, defined before any instruction.
    fn seeded() {
        // LICENSED I3: the register IS its index
        for j in 0..self.reg_types.length { self.defined.push(Reg { index: j }) }
    }

    fn record(msg: string) { self.voices.speak(defect_at(null, msg)) }
}

/// A body's per-node registers: each expression's, each binding's
/// slot (a cell when boxed), each pattern bind's, each pairing
/// loop's index.
export type BodyRegs = { regs: SideTable<Reg?>, slots: SideTable<Reg?>, boxed: SideTable<bool>, pattern_regs: SideTable<List<Reg>>, index_regs: SideTable<Reg?>, test_regs: SideTable<List<Reg>> }

export fn new_body_regs(exprs: int, stmts: int, pats: int) -> BodyRegs {
    let no_regs: List<Reg> = []
    BodyRegs {
        regs: side_table<Reg?>("regs", 0, exprs, null),
        slots: side_table<Reg?>("slots", 0, stmts, null),
        boxed: side_table("boxed", 0, stmts, false),
        pattern_regs: side_table_of("pattern_regs", 0, empty_lists_reg(exprs), no_regs),
        index_regs: side_table<Reg?>("index_regs", 0, stmts, null),
        test_regs: side_table_of("test_regs", 0, empty_lists_reg(pats), no_regs),
    }
}

impl BodyRegs {
    fn reg_at(e: ExprId) -> Reg? { self.regs.get(e.index) }
    fn set_reg(e: ExprId, r: Reg) {
        self.regs.set(e.index, r)
    }
    fn slot_of(s: StmtId) -> Reg? { self.slots.get(s.index) }
    fn set_slot(s: StmtId, r: Reg) {
        self.slots.set(s.index, r)
    }
    fn bind_slot(s: StmtId, cell: Reg) {
        self.boxed.set(s.index, true)
        self.set_slot(s, cell)
    }
    fn is_boxed(s: StmtId) -> bool { self.boxed.get(s.index) }
    fn pattern_reg(v: ExprId, j: int) -> Reg? {
        let regs = self.pattern_regs.get(v.index)
        if j >= regs.length { return null }
        regs[j]
    }
    fn bind_patterns(v: ExprId, regs: List<Reg>) {
        self.pattern_regs.set(v.index, regs)
    }
    fn index_reg(s: StmtId) -> Reg? { self.index_regs.get(s.index) }
    /// WHAT A PATTERN'S TEST PRODUCED FOR ITS BINDS. Enums' protocol
    /// is TEST then BIND — the test emits OUTSIDE an arm's region so
    /// an untaken arm reads nothing, the binds inside — and a
    /// pattern whose test IS its bind would otherwise run its scan
    /// twice. Keyed by the PATTERN, so a nested one finds its own
    /// and no caller threads it through the recursion.
    fn test_regs_of(p: PatId) -> List<Reg> { self.test_regs.get(p.index) }
    fn bind_test(p: PatId, regs: List<Reg>) {
        self.test_regs.set(p.index, regs)
    }
    fn bind_index(s: StmtId, r: Reg) {
        self.index_regs.set(s.index, r)
    }
}

/// A column's fold reads only what the body actually recorded.
fn is_typed(t: TypeId?) -> bool { t != null }
fn is_hungry(h: bool) -> bool { h }

/// `n` empty type lists — spelled without the generic fill: a test
/// shard instantiating a list-writing generic at a list-of-lists
/// type loses its writes (CLAUDE.md).
fn empty_lists_ty(n: int) -> List<List<TypeId>> {
    mut out: List<List<TypeId>> = []
    mut i = 0
    while i < n {
        out.push([])
        i = i + 1
    }
    out
}

fn empty_lists_reg(n: int) -> List<List<Reg>> {
    mut out: List<List<Reg>> = []
    mut i = 0
    while i < n {
        out.push([])
        i = i + 1
    }
    out
}
