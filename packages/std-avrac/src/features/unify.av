//! UNIFICATION and the instantiation rituals: a generic
//! declaration's Vars bound against what a call site or literal
//! wrote, the slot law every aggregate obeys, and the three verbs
//! every generic surface runs (refused tparams, the unpinned Var,
//! the closed bindings). Laws only — the voices are the callers'.
use core.{TypeId, Type, filled, DeclId, TypeRegistry}

/// THE PINS a unification fills: a Var's slot per type parameter.
/// A struct, not a bare list, because a fn writes through a
/// PARAMETER'S FIELD — never through a list it was handed.
export type Pins = { slots: List<TypeId?> }

/// Pins with nothing bound yet, one slot per type parameter.
export fn no_pins(n: int) -> Pins {
    Pins { slots: filled<TypeId?>(n, null) }
}

impl Pins {
    /// A slot bound — written through the receiver, which is what
    /// makes the pins a place every unification shares.
    fn pin(j: int, ty: TypeId) {
        self.slots.set(j, ty)
    }
}

impl TypeCx {
    /// UNIFICATION, exact: bind the callee's Vars from an argument's
    /// computed type, recursing through the composites. No widening
    /// rides through a generic param — a lift needs a visible concrete
    /// target (the recorded G1 law). Errors absorb.
    fn unify(want: TypeId, got: TypeId, target: DeclId, mut bound: Pins) -> bool {
        if self.errored_ty(got) { return true }
        if self.errored_ty(want) { return true }
        match self.view.types.shape_of(want) {
            .Var(decl, j, _) -> self.var_binds(decl, j, got, target, bound),
            .List(w) -> self.elem_unifies(w, got, target, bound),
            .Cell(w) -> self.cell_unifies(w, got, target, bound),
            .Task(w) -> self.task_unifies(w, got, target, bound),
            .Map(_, wv) -> self.value_unifies(wv, got, target, bound),
            .Opt(w) -> self.carried_unifies(w, got, target, bound),
            .Res(wo, we) -> self.sides_unify(wo, we, got, target, bound),
            .App(wd, _, wa) -> self.app_unifies(wd, wa, got, target, bound),
            .Fn(wp, _, wr) -> self.fn_unifies(wp, wr, got, target, bound),
            // LICENSED structs.index_compared: type identity — interned ids ARE the agreement
            .Ptr or .Int or .Float or .Bytes or .Str or .Bool or .Struct(_, _) or .Enum(_, _) or .TypeName(_, _) or .Dyn(_, _) or .Null or .EmptyList or .EmptyMap or .Error or .Void or .Tasks or .Union(_) or .Range -> want.index == got.index,
        }
    }

    fn cell_unifies(w: TypeId, got: TypeId, target: DeclId, mut bound: Pins) -> bool {
        let g: TypeId? = self.view.types.cell_inner(got)
        g != null && self.unify(w, g!, target, bound)
    }

    fn task_unifies(w: TypeId, got: TypeId, target: DeclId, mut bound: Pins) -> bool {
        let g? = self.view.types.task_answer(got) else { return false }
        self.unify(w, g, target, bound)
    }

    /// A fn type unifies STRUCTURALLY: seat by seat, then the answer —
    /// `fn(T) -> T` meets `fn(int) -> int` and binds T. Invariant in
    /// every seat (v1 — variance is recorded).
    fn fn_unifies(wp: List<TypeId>, wr: TypeId, got: TypeId, target: DeclId, mut bound: Pins) -> bool {
        let g? = self.view.types.arrow_parts(got) else { return false }
        if g.seats.length != wp.length { return false }
        for j, w in wp {
            if !self.unify(w, g.seats[j], target, bound) { return false }
        }
        self.unify(wr, g.answer, target, bound)
    }

    /// One Var meets one concrete type: first sight binds — through the
    /// PINS, whose field is a place the caller shares — and a second
    /// sight must agree.
    fn var_binds(decl: DeclId, j: int, got: TypeId, target: DeclId, mut bound: Pins) -> bool {
        // a sig speaks only its OWN fn's Vars; anything else is no match
        // LICENSED structs.index_compared: DECLARATION identity, not type agreement — whose Var this is
        if decl.index != target.index { return false }
        // absence never pins a Var — `null` and `[]` have no one type;
        // the pin (or another argument) must land first
        if self.view.types.shape_of(got) is .Null { return false }
        let g = self.view.types.shape_of(got)
        if g is .EmptyList || g is .EmptyMap { return false }
        let seen: TypeId? = bound.slots[j]
        if seen == null {
            bound.pin(j, got)
            return true
        }
        // LICENSED structs.index_compared: type identity — interned ids ARE the agreement
        seen!.index == got.index
    }

    /// `[]` is a list of anything — it unifies without pinning.
    fn elem_unifies(w: TypeId, got: TypeId, target: DeclId, mut bound: Pins) -> bool {
        match self.view.types.shape_of(got) {
            .List(g) -> self.unify(w, g, target, bound),
            .EmptyList -> true,
            .Opt(_) or .Null or .Cell(_) or .Task(_) or .Tasks or .Map(_, _) or .EmptyMap or .Ptr or .Int or .Float or .Bytes or .Str or .Bool or .Struct(_, _) or .Enum(_, _) or .TypeName(_, _) or .Var(_, _, _) or .Dyn(_, _) or .Fn(_, _, _) or .Res(_, _) or .App(_, _, _) or .Union(_) or .Error or .Void or .Range -> false,
        }
    }

    /// `{}` is a map of anything — it unifies without pinning.
    fn value_unifies(w: TypeId, got: TypeId, target: DeclId, mut bound: Pins) -> bool {
        match self.view.types.shape_of(got) {
            .Map(_, g) -> self.unify(w, g, target, bound),
            .EmptyMap -> true,
            .Opt(_) or .Null or .Cell(_) or .Task(_) or .Tasks or .List(_) or .EmptyList or .Ptr or .Int or .Float or .Bytes or .Str or .Bool or .Struct(_, _) or .Enum(_, _) or .TypeName(_, _) or .Var(_, _, _) or .Dyn(_, _) or .Fn(_, _, _) or .Res(_, _) or .App(_, _, _) or .Union(_) or .Error or .Void or .Range -> false,
        }
    }

    /// A nullable seat takes its own nullable, `null` (which inhabits
    /// every CONCRETE nullable — against a Var it cannot pin, and the
    /// caller says so), or a PRESENT value of a CONCRETE carried type —
    /// the niche's identity widen. A value against `T?` pins nothing
    /// here: nested, a widen has no seat to record it (`agreed`'s
    /// `seat_widens` is the seat's own door).
    fn carried_unifies(w: TypeId, got: TypeId, target: DeclId, mut bound: Pins) -> bool {
        match self.view.types.shape_of(got) {
            .Opt(g) -> self.unify(w, g, target, bound),
            .Null -> !(self.view.types.shape_of(w) is .Var),
            .List(_) or .Cell(_) or .Task(_) or .Tasks or .EmptyList or .Map(_, _) or .EmptyMap or .Ptr or .Int or .Float or .Bytes or .Str or .Bool or .Struct(_, _) or .Enum(_, _) or .TypeName(_, _) or .Var(_, _, _) or .Dyn(_, _) or .Fn(_, _, _) or .Res(_, _) or .App(_, _, _) or .Union(_) or .Error or .Void or .Range -> !(self.view.types.shape_of(w) is .Var) && self.unify(w, got, target, bound),
        }
    }

    fn sides_unify(wo: TypeId, we: TypeId, got: TypeId, target: DeclId, mut bound: Pins) -> bool {
        let sides? = self.view.types.res_parts(got) else { return false }
        self.unify(wo, sides.ok, target, bound) && self.unify(we, sides.err, target, bound)
    }

    /// The representation laws, re-judged on a SUBSTITUTED type: every
    /// `Result` side must still be slot-worthy once T is concrete — a
    /// call binding `T` to `int?` cannot smuggle a pair into a box's
    /// word slot. Answers the offending side, or absence when lawful.
    fn unlawful_side(ty: TypeId) -> TypeId? {
        match self.view.types.shape_of(ty) {
            .Res(ok, err) -> self.res_side_unlawful(ok, err),
            .List(elem) -> self.unlawful_side(elem),
            .Cell(inner) or .Opt(inner) or .Task(inner) -> self.unlawful_side(inner),
            .Map(_, v) -> self.unlawful_side(v),
            .EmptyMap -> null,
            .App(_, _, args) -> args.find((a) -> self.unlawful_side(a) != null),
            .Union(members) -> members.find((m) -> self.unlawful_side(m) != null),
            .Ptr or .Int or .Float or .Bytes or .Str or .Bool or .Struct(_, _) or .Enum(_, _) or .TypeName(_, _) or .Var(_, _, _) or .Dyn(_, _) or .Fn(_, _, _) or .Null or .EmptyList or .Error or .Void or .Tasks or .Range -> null,
        }
    }

    fn res_side_unlawful(ok: TypeId, err: TypeId) -> TypeId? {
        if !slot_worthy(self.view.types.shape_of(ok)) { return ok }
        if !slot_worthy(self.view.types.shape_of(err)) { return err }
        self.unlawful_side(ok) ?? self.unlawful_side(err)
    }

    /// Whether every Var of `target` inside `ty` is already bound —
    /// when true, the param is effectively concrete and the ordinary
    /// assignment law (widening included) can judge the argument.
    fn fully_bound(ty: TypeId, target: DeclId, bound: Pins) -> bool {
        match self.view.types.shape_of(ty) {
            // LICENSED structs.index_compared: DECLARATION identity, not type agreement — whose Var this is
            .Var(decl, j, _) -> if decl.index == target.index { bound.slots[j] != null } else { true },
            .List(elem) -> self.fully_bound(elem, target, bound),
            .Cell(inner) or .Task(inner) -> self.fully_bound(inner, target, bound),
            .Map(k, v) -> self.fully_bound(k, target, bound) && self.fully_bound(v, target, bound),
            .EmptyMap -> true,
            .Opt(inner) -> self.fully_bound(inner, target, bound),
            .Res(ok, err) -> self.fully_bound(ok, target, bound) && self.fully_bound(err, target, bound),
            .App(_, _, args) -> args.all((a) -> self.fully_bound(a, target, bound)),
            .Fn(ps, _, ret) -> ps.all((p) -> self.fully_bound(p, target, bound)) &&
                self.fully_bound(ret, target, bound),
            .Union(members) -> members.all((m) -> self.fully_bound(m, target, bound)),
            .Ptr or .Int or .Float or .Bytes or .Str or .Bool or .Struct(_, _) or .Enum(_, _) or .TypeName(_, _) or .Dyn(_, _) or .Null or .EmptyList or .Error or .Void or .Tasks or .Range -> true,
        }
    }

    /// The bound slots as a full substitution — unbound slots absorb.
    fn bound_args(bound: Pins) -> List<TypeId> {
        [b ?? self.error_type for b in bound.slots]
    }

    /// A seat as its bindings make it — itself while a Var stays free.
    fn as_bound(ty: TypeId, decl: DeclId, bound: Pins) -> TypeId {
        if self.fully_bound(ty, decl, bound) { self.view.types.substituted(ty, decl, self.bound_args(bound)) } else { ty }
    }

    /// Two instantiations of the SAME declaration unify argument by
    /// argument; anything else is no match.
    fn app_unifies(wd: DeclId, wa: List<TypeId>, got: TypeId, target: DeclId, mut bound: Pins) -> bool {
        match self.view.types.shape_of(got) {
            // LICENSED structs.index_compared: DECLARATION identity, not type agreement — whose instantiation this is
            .App(gd, _, ga) -> gd.index == wd.index && self.paired_unify(wa, ga, target, bound),
            _ -> false,
        }
    }

    fn paired_unify(want: List<TypeId>, got: List<TypeId>, target: DeclId, mut bound: Pins) -> bool {
        if want.length != got.length { return false }
        mut ok = true
        for j, w in want {
            if !self.unify(w, got[j], target, bound) { ok = false }
        }
        ok
    }

    /// Every binding, closed — ask ONLY after `unpinned_of` answered
    /// absence; an open slot here is the caller's defect.
    fn bound_closed(bound: Pins) -> List<TypeId> {
        [b ?? self.error_type for b in bound.slots]
    }
}

/// A shape a SLOT may hold: a scalar word, or an unmanaged
/// pointer. Managed values and register-pair nullables wait for
/// ownership analysis; Error absorbs (the name law already spoke).
/// A Var passes ABSTRACTLY — each instantiation re-judges it
/// (`instantiation_lawful`), so nothing smuggles past by wearing T.
export fn slot_worthy(sh: Type) -> bool {
    match sh {
        // a nullable POINTER is its own nullable — the slot holds the
        // pointer, absence the null one (the niche); a nullable SCALAR
        // is its word, its absence the cell's mark (runtime/avra_box.h)
        .Ptr or .Int or .Float or .Bytes or .Bool or .Str or .Struct(_, _) or .Enum(_, _) or .Dyn(_, _) or .Res(_, _) or .App(_, _, _) or .TypeName(_, _) or .List(_) or .Cell(_) or .Task(_) or .Tasks or .Var(_, _, _) or .Fn(_, _, _) or .Map(_, _) or .Union(_) or .Opt(_) or .Range -> true,
        .Null or .EmptyList or .Error or .Void or .EmptyMap -> false,
    }
}

/// A declaration naming T twice already refused at the declaration
/// — every use site absorbs instead of echoing.
export fn tparams_refused(tp: List<string>) -> bool {
    for j, n in tp {
        if repeated_at(tp, j) { return true }
    }
    false
}

/// THE position-dup law: the name at `j` was already declared
/// earlier in the list — its FIRST position wins.
export fn repeated_at(names: List<string>, j: int) -> bool {
    names.index_of(names[j]) < j
}

/// The first type parameter the bindings left OPEN — the caller
/// voices it in its own surface's words.
export fn unpinned_of(tp: List<string>, bound: Pins) -> string? {
    for j, n in tp {
        if bound.slots[j] == null { return n }
    }
    null
}
