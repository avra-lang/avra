//! THE SETTLED LAW: a const's value is known when the COMPILER
//! runs — a literal as written, or what the evaluator finishes; the
//! lowering asks it and speaks its refusals. Its type is recorded as
//! a workspace fact; an annotation still holds what it declares.
use core.{
    StmtId,
    ExprId,
    TypeId,
    TypeRef,
    Expr,
    DeclId,
    CollectParts,
    same_type,
    flatten,
    some_list,
}
use features.{TypeCx, declared_decl, bound_decl_of}
use diagnostics.{refusal, Diag}
use @std.errors.{Loc}

/// The value walks under its declaration's want, then records the
/// inferred or declared type where every body can ask for it.
export fn check_const(mut cx: TypeCx, s: StmtId) {
    let held: ExprId? = cx.view.store.stmt_value(s)
    if held == null { return }
    let v = held!
    let ann: TypeRef? = cx.view.store.binding_ty(s)
    // Hold the declaration here: asking the const's shared type while
    // computing that same fact would compare the value against itself.
    let declared: TypeId? = if ann == null { null } else { cx.bind_declared(s, ann!) }
    if declared != null { cx.plant_want(v, declared!) }
    cx.walk_value(s)
    // a value or an annotation the walk already refused is spoken for
    if cx.errored(v) || refused_annotation(cx, declared) { return }
    // A MEMBER CANNOT READ ITS OWN COLLECTION WHILE COMPILING
    // (docs/2026_09_22_COLLECTIONS.md §4.2) — a cycle regardless of
    // scope: the collect's own value is THIS declaration's synthesis,
    // not yet built while this declaration's value is what is being
    // typed. Checked before the closure-fold law below, which would
    // otherwise catch the same read under the wrong, less specific
    // voice — a self-read is refused whether or not the collect that
    // gathers it is closure-scoped.
    let cycled: DeclId? = self_collect_read(cx, s, v)
    if cycled != null {
        let _ = cx
            .spoken(
                self_read_refused(
                    cx,
                    cx.loc_of(v),
                    cx.view.store.let_name(s) ?? "this value",
                    cycled!,
                ),
            )
        return
    }
    // OPEN WORLD CLOSES AT LINK (docs/2026_09_22_COLLECTIONS.md §4.1):
    // a value read straight by NAME, so a helper fn hiding the read is
    // outside what this catches cheaply — the reachable, common case.
    let folded: DeclId? = closure_collect_read(cx, v)
    if folded != null && !cx.view.decls.is_program() {
        let _ = cx.spoken(closure_fold_refused(cx, cx.loc_of(v), folded!))
        return
    }
    if cx.refuses_void_value(v) { return }
    let held = declared ?? cx.type_at(v)
    // a top-level instance is built once per run, so it holds anything
    if !written(cx.view.store.expr(v)) &&
        !materializable(cx, held) &&
        !cx.view.store.is_component_inst(s) {
        unformed(cx, v, cx.view.store.let_name(s) ?? "this const", held)
        return
    }
    if declared != null { cx.declared_binding(v, cx.view.store.let_name(s) ?? "this const", declared!) }
    cx.view.decls.record_const_type(cx.view.file, s, held)
}

/// A value read straight off the page.
fn written(value: Expr) -> bool {
    value.int_of() != null ||
        value.text_of() != null ||
        value.bool_of() != null ||
        value.bits_of() != null
}

/// Whether the annotation's own walk already spoke.
fn refused_annotation(cx: TypeCx, declared: TypeId?) -> bool {
    declared != null && cx.view.types.shape_of(declared!) is .Error
}

/// A scalar is emitted at every read. A managed value is built by
/// the const's guarded unit and kept for the process.
fn materializable(cx: TypeCx, ty: TypeId) -> bool {
    // a WHOLE nullable is static where it rides a pointer, or where
    // it is a WORD ENUM's own — one register, the spare tag its
    // absence, a plain `ConstInt` at every read; inside an aggregate
    // every slot keeps its own presence regardless
    let inner: TypeId? = cx.view.types.carried(ty)
    if inner != null {
        return (cx.view.types.rides_pointer(ty) || cx.view.types.is_word_enum(inner!)) &&
            formed(cx, inner!, [])
    }
    formed(cx, ty, [])
}

/// Every part a settled value HOLDS has a compile-time form: a
/// record's fields, an enum's payloads, a list's elements, a map's
/// values, a result's sides, an option's carried value — each type
/// judged once, so a recursive type ends. A fn or a `dyn` anywhere
/// inside is behaviour, which only a run can build.
fn formed(cx: TypeCx, ty: TypeId, seen: List<TypeId>) -> bool {
    if seen.any(same_type(it, ty)) { return true }
    // Flatness is a declaration fact. Demand it before judging so
    // query order cannot turn the same record from kept into copied.
    let named = declared_decl(cx.view.types.shape_of(ty))
    if named != null { let _ = cx.view.decls.sig(named!) }
    let deeper = seen.concat([ty])
    match cx.view.types.shape_of(ty) {
        .Int or .Float or .Bool or .Str or .Bytes -> true,
        .List(inner) or .Opt(inner) -> formed(cx, inner, deeper),
        .Map(_, value) -> formed(cx, value, deeper),
        .Res(ok, err) -> formed(cx, ok, deeper) && formed(cx, err, deeper),
        .Struct(_, _) or .Enum(_, _) or .App(_, _, _) -> parts_of(cx, ty).all(formed(cx, it, deeper)),
        .Ptr or .Cell(_) or .Task(_) or .Tasks or .TypeName(_, _) or .Var(_, _, _) or .Dyn(_, _) or .Fn(_, _, _) or .Null or .EmptyList or .Error or .Void or .EmptyMap or .Union(_) or .Range -> false,
    }
}

/// The types a record's fields or an enum's payloads hold.
fn parts_of(cx: TypeCx, ty: TypeId) -> List<TypeId> {
    let fields: List<TypeId> = cx.fields_of(ty)?.types ?? []
    fields.concat(flatten(cx.variants_of(ty)?.payloads ?? []))
}

/// A closure-scoped collect this value reads BY NAME, directly.
fn closure_collect_read(cx: TypeCx, root: ExprId) -> DeclId? {
    decl_refs(cx, root).find(closure_collect(cx, it))
}

fn decl_refs(cx: TypeCx, root: ExprId) -> List<DeclId> {
    flatten([some_list(bound_decl_of(cx.names, node)) for node in cx.view.store.every_expr(root)])
}

fn closure_collect(cx: TypeCx, d: DeclId) -> bool {
    let p? = collect_parts_of(cx, d) else { return false }
    p.scope is .Closure
}

/// A collect gathering THIS declaration's own word, read by name —
/// every word `s` itself answers `collect` under: a named
/// instance's OWN component word (`instance_of`, absent for an
/// ordinary const, so nothing here ever matches for one) and every
/// `@name` `s` wears, since an `.Annotated` collect gathers by mark,
/// not by component.
fn self_collect_read(cx: TypeCx, s: StmtId, root: ExprId) -> DeclId? {
    let words = self_collect_words(cx, s)
    if words.is_empty() { return null }
    decl_refs(cx, root).find((d) -> words.any((w) -> gathers(cx, w, d)))
}

fn self_collect_words(cx: TypeCx, s: StmtId) -> List<string> {
    some_list(cx.view.store.instance_of(s))
        .concat([a.name for a in cx.view.store.annotations_of(s)])
}

fn gathers(cx: TypeCx, word: string, d: DeclId) -> bool {
    let p? = collect_parts_of(cx, d) else { return false }
    match p.kind { .Component(w) or .Annotated(w) -> w == word, .UnknownKind(_) -> false }
}

/// `d`'s own `CollectParts`, absent for anything not a `.Collect`
/// declaration.
fn collect_parts_of(cx: TypeCx, d: DeclId) -> CollectParts? {
    let x = cx.view.decls.decl(d)
    if !(x.kind is .Collect) { return null }
    cx.view.decls.store_of(x.file).collect_parts(x.stmt)
}

// ── The voices ──

fn closure_fold_refused(cx: TypeCx, at: Loc?, d: DeclId) -> Diag {
    refusal(
        "collect.closure_fold",
        at,
        "`${cx.view.decls.decl(d).name}` is closed only when a program links — read it at run time",
        "folded here",
        "read it from a fn's body, never from a const's compile-time value",
    )
}

fn self_read_refused(cx: TypeCx, at: Loc?, name: string, d: DeclId) -> Diag {
    let coll = cx.view.decls.decl(d).name
    refusal(
        "collect.self_read",
        at,
        "`${name}` is collected into `${coll}`, so it cannot read `${coll}` while compiling",
        "reads it here",
        "an instance's own body sees what it is given directly, never the collection it joins",
    )
}

/// A computed const needs a compile-time value form: a literal the
/// lowering spells, or a type the materializer can rebuild from the
/// evaluator's crossed tree.
fn unformed(mut cx: TypeCx, v: ExprId, name: string, held: TypeId) {
    let form = "`${cx.view.types.name_of(held)}`"
    let _ = cx
        .spoken(
            refusal(
                "const.form",
                cx.loc_of(v),
                "a computed const needs a compile-time value form",
                "`${name}` declares ${form}",
                "use a scalar, text, octets, list, map, record, enum, result, or an optional over one of them — a value holding behaviour (a fn or `dyn`) is built at run time: answer it from a fn, or export it as a component instance",
            ),
        )
}
