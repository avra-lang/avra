//! THE SETTLED LAW: a const's value is known when the COMPILER
//! runs — a literal as written, or what the evaluator finishes; the
//! lowering asks it and speaks its refusals. And an annotated const
//! holds what it declares, like any binding.
use core.{StmtId, ExprId, TypeId, TypeRef, Expr, int_of, text_of, bool_of, bits_of}
use features.{TypeCx, spelled_type}
use diagnostics.{refusal}

/// The value walks under its declaration's want, then — when
/// annotated — it holds what it declares.
export fn check_const(mut cx: TypeCx, s: StmtId) {
    let held: ExprId? = cx.view.store.stmt_value(s)
    if held == null { return }
    let v = held!
    let ann: TypeRef? = cx.view.store.binding_ty(s)
    // THE DECLARED type, held here rather than asked back: a const's
    // TYPE is its settled value's, so the annotation is the only
    // thing that can disagree with the value — and asking the const
    // for its type would compare the value against itself.
    let declared: TypeId? = if ann == null { null } else { cx.bind_declared(s, ann!) }
    if declared != null { cx.plant_want(v, declared!) }
    cx.walk_value(s)
    // a value or an annotation the walk already refused is spoken for
    if cx.errored(v) || refused_annotation(cx, declared) { return }
    if !written(cx.view.store.expr(v)) {
        if ann == null {
            undeclared(cx, v)
            return
        }
        if spelled_type(cx.view.types, ann) == null {
            unspelled(cx, v, cx.view.store.let_name(s) ?? "this const", declared)
            return
        }
    }
    if cx.refuses_void_value(v) { return }
    if declared == null { return }
    cx.declared_binding(v, cx.view.store.let_name(s) ?? "this const", declared!)
}

/// A value read straight off the page.
fn written(value: Expr) -> bool {
    int_of(value) != null || text_of(value) != null || bool_of(value) != null || bits_of(value) != null
}

/// Whether the annotation's own walk already spoke.
fn refused_annotation(cx: TypeCx, declared: TypeId?) -> bool {
    declared != null && cx.view.types.shape_of(declared!) is .Error
}

// ── The voices ──

/// A computed const is read from every body, and a body's facts hold
/// only its own range — so the const's type is written where every
/// body can read it: on the declaration.
fn undeclared(mut cx: TypeCx, v: ExprId) {
    let _ = cx.spoken(refusal("const.declares", cx.loc_of(v),
                       "a const the compiler computes declares what it settles to",
                       "computed here",
                       "write the type on the const — `const N: int = …` — a scalar or text; a list or a record arrives with the next slice"))
}

/// A computed const's type is read from the STORE, so it is spelled
/// in words the registry knows: a scalar, text, `List<…>`,
/// `Map<string, …>`, or `?` over one that rides a pointer. A declared
/// type's name waits for the query that answers a const's type from
/// typing.
fn unspelled(mut cx: TypeCx, v: ExprId, name: string, declared: TypeId?) {
    let spelled = if declared == null { "that" } else { "`${cx.view.types.name_of(declared!)}`" }
    let _ = cx.spoken(refusal("const.scalar", cx.loc_of(v),
                       "a computed const's type is spelled in words",
                       "`${name}` declares ${spelled}",
                       "a scalar, text, `List<…>`, `Map<string, …>`, or `?` over text, a list or a map — a declared type's name arrives with the const's own query; hold one in a `once fn` today"))
}
