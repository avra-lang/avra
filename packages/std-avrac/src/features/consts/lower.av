//! A const's USE is its VALUE: the declaration emits nothing, and
//! reading the name lowers what the compiler settled — so a const
//! costs a constant, never a load.
use core.{StmtId, ExprId, Reg}
use features.{LowerCx}

/// The expression a const's name stands for.
export fn const_value(cx: LowerCx, s: StmtId) -> ExprId? {
    cx.view.store.stmt_value(s)
}
