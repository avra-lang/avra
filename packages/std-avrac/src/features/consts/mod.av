//! `const` — a value the COMPILER computes, so the program never
//! does. Its initializer is settled at compile time and every use IS
//! that value; nothing the host answers can ride in one, because
//! nothing the host answers is known when the compiler runs.
use features.{LanguageFeature, BuilderRow}
use diagnostics.{DiagCode}

export fn consts() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name         | build
        "const_decl" | build_const
    }
    let codes = table<DiagCode> {
        kind             | id      | summary
        "type.const"     | "F2045" | "a const's value must be known at compile time"
    }
    component LanguageFeature f {
        name = "consts"
        docs = "`const NAME = value` — computed once, at COMPILE time; every use is the value itself, so a const costs nothing to read."
        gram = """
stmt = "const" n:NAME ( ":" t:type )? "=" v:expression END @recover(sync_to: "END") -> const_decl(n, t, v)
"""
        diags = codes
        builders = rows
    }
    f
}
