//! The const's StmtSemantics: the value walks and types like any
//! binding's, the SETTLED law judges it, and the declaration lowers
//! to nothing — a const is not a thing the program does.
use core.{StmtId, Reg}
use features.{StmtSemantics, StmtResolveCx, StmtTypeCx, StmtLowerCx, nothing}

export type ConstSemantics = { }

impl StmtSemantics for ConstSemantics {
    fn resolve_stmt(mut cx: StmtResolveCx, s: StmtId) {
        cx.walk_value(s)
        cx.bind_checked(s)
    }

    fn type_stmt(mut cx: StmtTypeCx, s: StmtId) {
        check_const(cx, s)
    }

    /// NOTHING. The value is the compiler's; a use emits it.
    fn lower_stmt(mut cx: StmtLowerCx, s: StmtId) -> Reg? {
        nothing()
        null
    }
}
