// The module's settled values: none exported, every one visible to
// main.av and to each other, in any order.
fn describe() -> string {
    "${GREETING}:${LIMIT + 1}"
}
const LIMIT: int = 4
const GREETING: string = "hi"
const SIZES: List<int> = [LIMIT, LIMIT * 2]
type Point = { x: int, y: int }
const ORIGIN: Point = Point { x: 7, y: 0 }
