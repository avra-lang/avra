// proves: a PRIVATE top-level `const` is a module declaration like a
// private fn — read from another file of its module, before its
// definition, with no `use` line, and identical in both engines.
fn scaled(const k: int) -> int {
    k * 10
}
"${LIMIT} ${GREETING} ${SIZES.length} ${describe()} ${scaled(LIMIT)} ${ORIGIN.x}"
