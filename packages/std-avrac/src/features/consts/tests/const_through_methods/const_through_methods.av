// proves: a const settles through the methods and statics its value calls, reading the consts
// their bodies read; two types giving one method name are told apart by the receiver's type.
type P = { n: int }
type Q = { n: int }
impl P {
    fn total() -> int { self.n + BASE }
    static fn base() -> int { BASE * 2 }
}
impl Q {
    fn total() -> int { self.n + VIA_P }
}
const BASE: int = 3
const VIA_P: int = P { n: 1 }.total()
const VIA_Q: int = Q { n: 1 }.total()
const VIA_STATIC: int = P.base()
"${VIA_P} ${VIA_Q} ${VIA_STATIC}"
