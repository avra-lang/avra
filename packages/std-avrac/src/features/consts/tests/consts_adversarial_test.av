// The RED TEAM's permanent record for consts (see
// .claude/skills/red-team): every program here was written to BREAK
// the feature, not to use it. Grouped by attack class. A case that
// once produced a wrong answer, a crash, an internal defect, or an
// engine divergence keeps its place here forever.
use @std.avrac.testing.{refused_at_run, shown, refusals, refused_with}
use @std.avrac.language.{analyze_source}

spec "features/consts (adversarial)" {
    given "a lambda's env" {
        // A const has no run-time value to capture. Reading one
        // inside a lambda once answered the CAPTURE SLOT's contents
        // — a value nothing had put there.
        then "a const read inside a lambda is the settled value" {
            shown("const N = 7\nlet f = () -> N\nf()") == "7"
        }
        then "a const beside a real capture keeps both straight" {
            shown("const N = 7\nlet m = 1\nlet f = () -> N + m\nf()") == "8"
        }
        then "a const guards inside a lambda" {
            shown("const READY = true\nlet f = () -> if READY { 1 } else { 0 }\nf()") == "1"
        }
    }
    given "a name a `let` also claims" {
        // The crossing law asked whether the name's FIRST definition
        // was a const, then handed back the binding CURRENTLY
        // visible — a different statement once a `let` shadowed it.
        // The fn read a top-level slot it cannot see: index -1.
        then "a `let` shadowing a const is refused inside a fn, not trapped" {
            refused_with("const N = 1\nlet N = 2\nfn f() -> int {\n    N\n}\nf()", "run-time")
        }
        then "the const still crosses when the shadow comes after the body" {
            shown("const N = 1\nfn f() -> int {\n    N\n}\nlet N = 2\nf()") == "1"
        }
        then "a shadow INSIDE the body wins over the const" {
            shown("const N = 1\nfn f() -> int {\n    let N = 5\n    N\n}\nf()") == "5"
        }
        then "a parameter of the same name wins over the const" {
            shown("const N = 1\nfn f(N: int) -> int {\n    N\n}\nf(9)") == "9"
        }
        then "a later const of the same name is the one that reads" {
            shown("const N = 1\nconst N = 2\nN") == "2"
        }
    }
    given "an annotation that changes the value's SHAPE" {
        // A nullable annotation asks for a presence pair; the
        // settled value is a bare scalar. The declaration emits
        // nothing, so the lift had nowhere to happen and `!` once
        // extracted from a non-pack.
        then "a nullable int const unwraps" {
            shown("const A: int? = 1\nA! + 1") == "2"
        }
        then "a nullable int const answers ??" {
            shown("const A: int? = 1\nA ?? 9") == "1"
        }
        then "a nullable bool const answers ??" {
            shown("const A: bool? = true\nA ?? false") == "true"
        }
        then "a nullable string const unwraps" {
            shown("const A: string? = \"x\"\nA!") == "x"
        }
        then "a nullable const is present, not absent" {
            shown("const A: int? = 1\nif A == null { \"absent\" } else { \"present\" }") == "present"
        }
        then "a nullable const crosses a fn floor still packed" {
            shown("const A: int? = 4\nfn f() -> int {\n    A ?? 9\n}\nf()") == "4"
        }
        then "an annotation the value does not wear is still refused" {
            refusals("const A: List<int> = 1\nA") == 1
        }
        then "a nullable annotation of the WRONG word is refused too" {
            refusals("const A: int? = \"x\"\nA") == 1
        }
        then "a nullable const's type crosses whole, not stripped" {
            shown("const A: int? = 4\nfn f() -> int {\n    A! + 1\n}\nf()") == "5"
        }
    }

    given "a const that never settled" {
        // A computed const without its type is refused (F2063) —
        // but a fn body READING it asked the const for its type,
        // which fell through to the asker's fact table indexed by
        // ANOTHER body's expression: `index -1 is out of bounds`,
        // no diagnostic, no location. A const's type is the
        // program's answer or the hole; it is never a body's.
        then "an unsettled const read in a fn body is refused, not trapped" {
            refused_with("fn g() -> int {\n    3\n}\nconst N = g()\nfn f() -> int {\n    N\n}\nf()", "declares what it settles to")
        }
        then "an unsettled const read in a lambda is refused, not trapped" {
            refused_with("fn g() -> int {\n    3\n}\nconst N = g()\nlet f = () -> N\nf()", "declares what it settles to")
        }
        then "the refusal names the CONSTRUCT, not the value's type" {
            refused_with("const N = g()\nfn g() -> int {\n    3\n}\nN", "computed here")
        }
    }

    // red team, comptime S1: the evaluator settles a computed const
    given "degenerate settlements" {
        then "the evaluator's call depth is the settlement's, and its words say so" {
            refused_at_run("fn d(n: int) -> int { if n == 0 { 0 } else { 1 + d(n - 1) } }\nconst D: int = d(500)\nD", "recursion too deep")
        }
        then "an overflow wraps as the program's would" {
            shown("fn m() -> int { 9223372036854775807 + 1 }\nconst M: int = m()\nM") == "-9223372036854775808"
        }
        then "an empty text settles as empty" {
            shown("fn e() -> string { \"\" }\nconst E: string = e()\nlet t = \"[\${E}]\"\nt") == "[]"
        }
        then "a float settles by its bits" {
            shown("fn h() -> float { 1.5 * 2.0 }\nconst H: float = h()\nH") == "3.0"
        }
    }
    given "what a settlement cannot spell" {
        then "a record's type NAME is refused for the LAW, not for a missing type" {
            refused_with("type P = { x: int }\nfn p() -> P { P { x: 1 } }\nconst X: P = p()\nX.x", "spelled in words")
        }
        then "so is a scalar under `?` — a box the runtime cannot keep" {
            refused_with("fn n() -> int? { null }\nconst X: int? = n()\nX ?? 9", "spelled in words")
        }
        then "a list of a record's name is refused the same way" {
            refused_with("type P = { x: int }\nfn p() -> List<P> { [P { x: 1 }] }\nconst X: List<P> = p()\nX.length", "spelled in words")
        }
        then "a record's SCALAR field settles" {
            shown("type P = { x: int }\nfn p() -> P { P { x: 1 } }\nconst X: int = p().x\nX") == "1"
        }
    }
    // red team, comptime S2: a boxed const is one box, called for
    given "boxed consts" {
        then "a push on a const is refused as on any `let`" {
            refused_with("fn xs() -> List<int> {\n    [1]\n}\nconst XS: List<int> = xs()\nXS.push(4)\nXS.length", "is not `mut`")
        }
        then "so is a map's set" {
            refused_with("fn m() -> Map<string, int> {\n    mut d: Map<string, int> = {}\n    d\n}\nconst M: Map<string, int> = m()\nM.set(\"k\", 1)\nM.length", "is not `mut`")
        }
        then "and a `mut` seat" {
            refused_with("fn xs() -> List<int> {\n    [1]\n}\nconst XS: List<int> = xs()\nfn bump(mut ys: List<int>) -> int {\n    ys.push(9)\n    ys.length\n}\nbump(XS)", "writes through it")
        }
        then "an empty list settles as empty" {
            shown("fn e() -> List<int> {\n    []\n}\nconst E: List<int> = e()\nE.length") == "0"
        }
        then "a boxed const of a boxed const settles" {
            shown("fn xs() -> List<int> {\n    [1, 2, 3]\n}\nconst XS: List<int> = xs()\nfn more() -> List<int> {\n    XS.concat([4])\n}\nconst YS: List<int> = more()\nXS.length + YS.length") == "7"
        }
        then "a lambda reads one" {
            shown("fn xs() -> List<int> {\n    [1, 2, 3]\n}\nconst XS: List<int> = xs()\nlet f = () -> XS.length\nf()") == "3"
        }
    }
    given "cascades" {
        then "a value the walk refused earns no second refusal" {
            refusals("const X =\nX") == 1
        }
        then "a const that trapped is refused ONCE, however many reads" {
            let a = analyze_source("fn boom(n: int) -> int {\n    n / 0\n}\nconst Z: int = boom(1)\nfn twice() -> int {\n    Z + Z\n}\ntwice() + Z")
            match a.run() {
                .Err(msg) -> a.diagnostics.is_empty() && spoken_once(msg, "F2062"),
                .Ok(_) -> false,
            }
        }
        then "nor does an annotation that names no type" {
            refusals("fn f() -> int { 3 }\nconst X: Nope = f()\nX") == 1
        }
        then "a computed const read in a fn body settles there too" {
            shown("fn f() -> int { 3 }\nconst A: int = f()\nfn twice() -> int { A * 2 }\nconst B: int = twice()\nB") == "6"
        }
    }
}

/// The code appears in the report exactly once.
fn spoken_once(report: string, code: string) -> bool {
    let at = report.index_of(code)
    at >= 0 && !report.substring(at + code.length, report.length).contains(code)
}
