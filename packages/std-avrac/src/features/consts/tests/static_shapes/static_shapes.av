// proves: static data at its degenerate shapes — empty, one, nested
// empties, a unit enum, a boxed and a niche nullable element, five
// thousand cells, bools, floats, extreme ints, a Result, odd text.
type Id = { n: int }
enum U {
    a
    b
}
fn e() -> List<int> { [] }
fn one() -> List<int> { [7] }
fn ee() -> List<List<int>> { [[]] }
fn em() -> Map<string, int> { {} }
fn mm() -> Map<string, Map<string, int>> {
    mut m: Map<string, Map<string, int>> = {}
    mut inner: Map<string, int> = {}
    inner.set("k", 1)
    m.set("i", inner)
    m
}
fn u() -> U { U.b }
fn ids() -> List<Id> { [Id { n: 1 }, Id { n: 2 }] }
fn oids() -> List<Id?> { [Id { n: 5 }, null] }
fn ostr() -> List<string?> { ["s", null] }
fn big() -> List<int> { [i for i in 0..5000] }
fn bs() -> List<bool> { [true, false] }
fn fs() -> List<float> { [1.5, 0.0 - 2.25] }
fn negs() -> List<int> { [-1, -9223372036854775807] }
fn res() -> Result<List<int>, string> { .Ok([4, 5]) }
fn strs() -> List<string> { ["", "a\"b", "line\nbreak", "ünï"] }
const E = e()
const ONE = one()
const EE = ee()
const EM = em()
const MM = mm()
const UU = u()
const IDS = ids()
const OIDS = oids()
const OSTR = ostr()
const BIG = big()
const BS = bs()
const FS = fs()
const NEGS = negs()
const RES = res()
const STRS = strs()
let uw = match UU {
    .a -> "a"
    .b -> "b"
}
let oid = match OIDS[1] {
    null -> "none"
    v? -> "${v.n}"
}
let oid0 = match OIDS[0] {
    null -> "none"
    v? -> "${v.n}"
}
let inner = MM.get("i")
let ik = match inner {
    null -> 0
    m? -> m.get("k") ?? 0
}
let rv = match RES {
    .Ok(xs) -> xs[1]
    .Err(_) -> 0
}
let flag = if BS[0] && !BS[1] { "ok" } else { "bad" }
"${E.length} ${ONE[0]} ${EE.length} ${EE[0].length} ${EM.length} ${ik} ${uw} ${IDS[1].n} ${oid0} ${oid} ${OSTR[0] ?? "-"}${OSTR[1] ?? "-"} ${BIG.length} ${BIG[4999]} ${flag} ${FS[1]} ${NEGS[1]} ${rv} ${STRS[0].length} ${STRS[1]} ${STRS[3].length}"
