// proves: a const the compiler COMPUTES — a call, an expression over
// other consts — settles in the evaluator at compile time, and both
// engines read the settled constant; no call runs in the program.
fn fact(n: int) -> int { if n <= 1 { 1 } else { n * fact(n - 1) } }
fn greet(who: string) -> string { "hi " + who }
const F: int = fact(5)
const G: string = greet("const")
const B: bool = F > 100
const H: float = 1.5 * 2.0
const SQ: int = F * F
let shown = "${F} ${G} ${B} ${H} ${SQ}"
shown
