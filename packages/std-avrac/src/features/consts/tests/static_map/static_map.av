// proves: a static map is READ through the runtime's own index, built
// on first lookup whatever the key count — past the first capacity
// too — and a copy grows on its own index.
fn m() -> Map<string, int> {
    mut d: Map<string, int> = {}
    for i in 0..40 { d.set("k${i}", i * i) }
    d
}
const M = m()
mut copy = M
copy.set("k40", 1600)
copy.set("k3", 0)
let k7 = M.get("k7") ?? -1
let k39 = M.get("k39") ?? -1
let miss = M.get("zz") ?? -1
let empty = M.get("") ?? -1
"${M.length} ${k7} ${k39} ${miss} ${empty} ${copy.length} ${copy.get("k40") ?? -1} ${copy.get("k3") ?? -1} ${M.get("k3") ?? -1}"
