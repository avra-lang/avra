// proves: a const whose value RIDES A POINTER — a list, a map, text
// under `?` — settles in the evaluator for the laws, and the program
// CALLS its unit, which answers the value once and the same box after:
// a copy taken from it is a copy, and the const is never written.
fn squares(n: int) -> List<int> { [i * i for i in 0..n] }
fn names() -> List<string> { ["a", "b"].concat(["c"]) }
fn rows() -> Map<string, int> {
    mut m: Map<string, int> = {}
    m.set("x", 7)
    m
}
fn grid() -> List<List<int>> { [[1, 2], [3]] }
fn w() -> string? { "w" }
type Point = { x: int }
fn point() -> Point { Point { x: 9 } }
type Bundle = { name: string, nums: List<int> }
fn bundle() -> Bundle { Bundle { name: "held", nums: [4, 5] } }
enum Choice {
    none
    some(string)
}
fn choice() -> Choice { Choice.some("yes") }
fn result() -> Result<int, string> { .Ok(6) }
const SQ = squares(5)
const NS = names()
const T = rows()
const G = grid()
const W: string? = w()
const P = point()
const BUNDLE = bundle()
const CHOICE = choice()
const RESULT = result()
const EMPTY_LIST: List<int> = []
const EMPTY_MAP: Map<string, int> = {}
fn last() -> int { SQ.last()! }
mut ys = SQ
ys.push(100)
mut total = 0
for i in 0..3 { total = total + SQ[4] }
let choice_value = match CHOICE { .some(v) -> v, .none -> "no" }
let result_value = match RESULT { .Ok(v) -> v, .Err(_) -> 0 }
let shown = "${total} ${SQ.length} ${ys.length} ${last()} ${NS.join("-")} ${T.get("x") ?? 0} ${G[1][0]} ${W ?? "none"} ${P.x} ${BUNDLE.name}${BUNDLE.nums[1]} ${choice_value} ${result_value} ${EMPTY_LIST.length} ${EMPTY_MAP.length}"
shown
