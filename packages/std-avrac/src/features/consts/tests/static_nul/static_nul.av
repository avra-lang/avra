// proves: a settled string HOLDS A NUL all the way into the binary —
// a text constant is laid out at the length its header carries, never
// measured to the first NUL — as a scalar const and as a static slot.
use @std.text.{from_codepoint}
fn z() -> string { "a" + from_codepoint(0) + "b" }
fn zs() -> List<string> { [z(), "c"] }
const Z = z()
const ZS = zs()
"${Z.length} ${ZS[0].length} ${ZS[0] == Z} ${Z.contains("b")}"
