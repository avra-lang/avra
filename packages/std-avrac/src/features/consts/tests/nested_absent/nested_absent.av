// proves: a const keeps a present null apart from an absent slot —
// the crossing carries the absent mark, not the null it reads as
fn listed<T>(x: T) -> List<T?> { [x, null] }
fn ints() -> List<int?> { [1, null, 3] }
fn ns() -> string? { null }
fn words(x: string?) -> string { x ?? "[null]" }
const I = ints()
const D = listed(ns())
let a = match D[0] {
    null -> "absent"
    v? -> words(v)
}
let b = match D[1] {
    null -> "absent"
    v? -> words(v)
}
"${I[0] ?? 0} ${I[1] ?? 9} ${I.contains(null)} | ${a} ${b}"
