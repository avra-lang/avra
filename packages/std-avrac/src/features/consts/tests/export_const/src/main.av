// proves: `export const` is a DECLARATION — a settled value read
// cross-file, every value category included, and identical in both
// engines.
use util.{PIPE_IN, NAME, LONG, ROWS, TABLE, ORIGIN, HUE}
fn total() -> int {
    ROWS.length + (TABLE.get("a") ?? 0)
}
"${PIPE_IN} ${NAME} ${LONG} ${ROWS[2]} ${total()} ${ORIGIN.x},${ORIGIN.y} ${HUE is .green}"
