//! An annotation that generates top-level consts beside a fn.
use @std.meta.{Fn, Directive}

/// `@consts` beside `fn f` generates a written const and one computed
/// from `f` — both declarations of the asking file's module. (A
/// template's names resolve in the file that wrote it, so a generated
/// const cannot read its sibling by name — `G_SUM` spells 5 itself.)
export fn consts(f: Fn) -> List<Directive> {
    [Directive { twin: "", name: f.name, at: f.at, source: quote {
        const G_LIT = 5
        const G_SUM = 5 + ${f}()
    } }]
}
