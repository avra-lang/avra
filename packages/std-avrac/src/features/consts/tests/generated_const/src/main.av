// proves: a GENERATED top-level `const` is a declaration like a
// generated fn — read at the top level, inside a fn, and at a `const`
// seat, computed from the annotated fn, identical in both engines.
use @test.provider.{consts}

@consts
fn base() -> int { 2 }

fn reads() -> int { G_SUM }
fn scaled(const k: int) -> int { k * 10 }
"${G_LIT} ${G_SUM} ${reads()} ${scaled(G_SUM)}"
