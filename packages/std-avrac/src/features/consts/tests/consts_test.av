// `const` — the value the compiler settles. What is proved here:
// the use IS the value (no slot, no load), the evaluator SETTLES a
// computed value at compile time and refuses what traps, runs away
// or reaches the world, an annotation is held to, and a const
// crosses into a fn body where a top-level `let` cannot.
use @std.avrac.testing.{shown, refused_with, refused_at_run, refusals, ir_of}
use @std.avrac.language.{render_ir}

spec "features/consts — a value the compiler settles" {
    given "the value at its uses" {
        then "a const reads as its value" {
            shown("const N = 7\nN + 1") == "8"
        }
        then "a string const interpolates" {
            shown("const WHO = \"world\"\n\"hello \${WHO}\"") == "hello world"
        }
        then "a bool const guards" {
            shown("const READY = true\nif READY { \"yes\" } else { \"no\" }") == "yes"
        }
        then "the DECLARATION emits nothing — the use emits a constant" {
            let l = ir_of("const N = 7\nN + 1")
            let text = render_ir(l)
            !text.contains("slot") && text.contains("int 7")
        }
    }
    given "a fn body" {
        then "a const crosses the floor a run-time binding cannot" {
            shown("const N = 7\nfn plus(x: int) -> int {\n    x + N\n}\nplus(1)") == "8"
        }
        then "a top-level `let` still cannot" {
            refused_with("let n = 7\nfn plus(x: int) -> int {\n    x + n\n}\nplus(1)", "is a run-time binding of the top level")
        }
    }
    given "the settled law" {
        then "a NEGATIVE LITERAL is settled — the parse folds it, so `-1` IS a literal" {
            shown("const N: int = -1\nN") == "-1"
        }
        then "a negated NAME settles — the evaluator folds what the parse cannot" {
            shown("const A: int = 1\nconst B: int = -A\nB") == "-1"
        }
        then "the smallest int stays refused at the lexer, which reads the positive literal first" {
            refused_with("const N: int = -9223372036854775808\nN", "does not fit an `int`")
        }
        then "a CALL settles: the evaluator runs it at compile time" {
            shown("fn f() -> int {\n    3\n}\nconst N: int = f()\nN") == "3"
        }
        then "a const of a const settles" {
            shown("const A: int = 2 + 3\nconst B: int = A * A\nB") == "25"
        }
        then "the settled use is a CONSTANT — no call survives into the program" {
            let text = render_ir(ir_of("fn f() -> int {\n    3\n}\nconst N: int = f()\nN + 1"))
            !text.contains("call f") && text.contains("int 3")
        }
        then "a computed const DECLARES what it settles to" {
            refused_with("fn f() -> int {\n    3\n}\nconst N = f()\nN", "declares what it settles to")
        }
        then "a trap while settling is refused when the const is LOWERED — analysis is clean" {
            refused_at_run("fn boom(n: int) -> int {\n    n / 0\n}\nconst Z: int = boom(1)\nZ", "trapped while settling")
        }
        then "a runaway settlement is refused at its budget" {
            refused_at_run("fn spin() -> int {\n    mut i = 0\n    while i >= 0 { i = i + 1 }\n    i\n}\nconst W: int = spin()\nW", "ran past its budget")
        }
    }
    given "an annotation" {
        then "the const holds what it declares" {
            shown("const N: int = 7\nN") == "7"
        }
        then "and is refused when it does not" {
            refusals("const N: string = 7\nN") == 1
        }
    }
}
