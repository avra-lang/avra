// proves: a nullable const written as `null` settles to its absence, read wherever it is — a
// comprehension fills a list with it, and it compares equal to `null` — in both engines
type Outcome = { code: int, said: string }
const nothing_yet: Outcome? = null
fn slots(n: int) -> int {
    let outs: List<Outcome?> = [nothing_yet for i in 0..n]
    [o for o in outs if o == null].length
}
"${slots(3)} ${nothing_yet == null}"
