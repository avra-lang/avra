// proves: a const that embeds a file beside its source, and one that
// embeds a toolchain package's file by its package path, each settle to
// the file's text.
use @std.meta.{embed}

// LICENSED input.compile_embed: the test's own fixture, read when the test is built
const NOTE: string = embed("note.txt")

// LICENSED input.compile_embed: a toolchain package's file, read when the test is built
const PRELUDE: string = embed("@std/prelude/verbs/Task.av")

"${NOTE.trim()} ${PRELUDE.contains("fn cancel")}"
