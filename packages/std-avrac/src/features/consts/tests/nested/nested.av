// proves: a SETTLED aggregate is STATIC DATA — a nested const (records
// in a list, lists and a boxed nullable in a record, tagged values, a
// map of lists) is laid out before the program runs, both engines read
// the same cells, and a write through a copy never reaches it.
type Pt = { x: int, y: float }
type Id = { n: int }
type Row = { name: string, pts: List<Pt>, tags: List<string>, id: Id?, ok: bool }
enum Shape {
    dot
    line(int, int)
    label(string)
}
fn rows() -> List<Row> {
    [
        Row {
            name: "a",
            pts: [Pt { x: 1, y: 0.5 }, Pt { x: 2, y: 1.5 }],
            tags: ["p", "q"],
            id: Id { n: 7 },
            ok: true,
        },
        Row { name: "b", pts: [], tags: [], id: null, ok: false },
    ]
}
fn shapes() -> List<Shape> { [Shape.dot, Shape.line(3, 4), Shape.label("L")] }
fn groups() -> Map<string, List<int>> {
    mut m: Map<string, List<int>> = {}
    m.set("odd", [1, 3, 5])
    m.set("even", [2, 4])
    m
}
fn results() -> List<Result<int, string>> { [.Ok(1), .Err("no")] }
const ROWS = rows()
const SHAPES = shapes()
const GROUPS = groups()
const RESULTS = results()
fn total_x() -> int {
    mut total = 0
    for r in ROWS {
        for p in r.pts { total = total + p.x }
    }
    total
}
fn shape_word(s: Shape) -> string {
    match s { .dot -> "dot", .line(a, b) -> "line${a + b}", .label(t) -> t }
}
fn err_word(r: Result<int, string>) -> string {
    match r { .Ok(v) -> "${v}", .Err(e) -> e }
}
mut copy = ROWS
copy.push(Row { name: "c", pts: [], tags: [], id: null, ok: true })
let first = ROWS[0]
let id_word = match first.id {
    v? -> "${v.n}"
    null -> "none"
}
let none: List<int> = []
let odd = GROUPS.get("odd") ?? none
let even = GROUPS.get("even") ?? none
"${ROWS.length} ${copy.length} ${total_x()} ${first.pts[1].y} ${first.tags.join("-")} ${id_word} ${ROWS[1].ok} ${[shape_word(s) for s in SHAPES].join(",")} ${odd.length} ${even[1]} ${err_word(RESULTS[1])}"
