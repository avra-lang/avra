// proves: a const's type is its declaration's typing: a const declared in a fn body types for
// the statements after it, and a top-level const types when read across a fn floor.
fn base() -> List<int> { [1, 2, 3] }
const total = base().length
const names = ["a", "b"].concat(["c"])
fn across() -> int { total + names.length }
fn local() -> int {
    const inner = base().concat([4])
    inner.length + total
}
fn nested() -> string {
    const label = names.join("-")
    "${label}${label.length}"
}
"${across()} ${local()} ${nested()}"
