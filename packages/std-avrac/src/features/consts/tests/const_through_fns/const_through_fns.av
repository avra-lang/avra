// proves: a const settles through the fns its value calls, reading the other consts their bodies
// read; a seat or a lambda's parameter that wears a const's name reads no const.
const BASE: int = 3

fn scaled(n: int) -> int { n * BASE }

fn twice(BASE: int) -> int { BASE * 2 }

const SCALED: int = scaled(2)

const TWICE: int = twice(2)

const BUMPED: int = [1, 2].fold(0, (BUMPED, x) -> BUMPED + x)

"${SCALED} ${TWICE} ${BUMPED}"
