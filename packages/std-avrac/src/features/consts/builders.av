//! Parse-time lowering: captures -> the ConstDecl statement.
use core.{Stmt, Scoped}
use features.{LangNode, Builder}

fn build_const(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let t = b.type_refs(1)?
    let v = b.expr(2)?
    b.make_stmt(Stmt.ConstDecl(Scoped(n.text), t.first(), v))
}
