// proves: a format pattern's holes are BINDERS a template owns — the
// generated fn binds `a` and `b` and reads them, and the user's own `a`
// beside the annotation is never touched.
use @test.provider.{split_by}

let a = "outer"

@split_by
fn cut() -> int { 0 }

"${cut_split("x-y")} ${cut_split("nodash")} ${a}"
