//! A template whose body MATCHES A FORMAT: the holes are binders the
//! template owns, renamed like any binder it declares.
use @std.meta.{Fn, Directive, Code}

/// `@split_by(quote { … })` on `fn f` generates `f_split`, which cuts
/// its argument at the dash and binds the two spans.
export fn split_by(f: Fn, body: Code) -> List<Directive> {
    [Directive { twin: "", name: f.name, at: f.at, source: quote {
        fn ${f}_split(s: string) -> string {
            match s {
                "{a}-{b}" -> a + "|" + b
                _ -> "none"
            }
        }
    } }]
}
