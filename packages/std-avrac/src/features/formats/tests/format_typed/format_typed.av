// proves: a format hole written `int` reads its span as an int — over text and over octets, a
// negative one too — and a span that spells no int fails the arm, as a missing piece does, so the
// next arm is tried; a hole written `string` reads text.
fn sized(s: string) -> string {
    match s {
        "{w: int}x{h: int}" -> "area ${w * h}",
        "{w: int}x{rest}" -> "wide ${w + 1} ${rest}",
        "{name: string}={v: int}" -> "${name} is ${v - 1}",
        _ -> "none",
    }
}
fn port(b: Bytes) -> int {
    match b { "{host}:{p: int}" -> p + host.length, _ -> 0 - 1 }
}
println(
    "${sized("3x4")} ${sized("3xq")} ${sized("ax4")} ${sized("k=-7")} ${sized("k=7z")} ${port("ab:80".bytes())} ${port("ab:x".bytes())} ${port([97, 58, 255].bytes()!)}",
)
