// proves: a format pattern over OCTETS — the spans come back as
// `Bytes`, nothing is converted, and the scan is exact over a NUL,
// which is the whole reason it reads the header's length rather than
// a terminator. A scan built on C string calls would stop at the
// first NUL and lose both separators after it.
fn thirds(b: Bytes) -> string {
    match b {
        "{x}|{y}|{z}" -> "${x.length}/${y.length}/${z.length}",
        _ -> "no",
    }
}

fn middle_byte(b: Bytes) -> int {
    match b {
        "{_}|{y}|{_}" -> y.at(0),
        _ -> 0 - 1,
    }
}

// a | NUL b | c — both separators sit PAST the NUL
let holed = [97, 124, 0, 98, 124, 99].bytes()!
let plain = "a|bb|c".bytes()

let request = "GET /index.html HTTP/1.0".bytes()
let line = match request {
    "{method} {path} HTTP/{major}.{minor}" -> "${method.length} ${path.length} ${major.length} ${minor.length}",
    _ -> "no",
}

"${thirds(holed)} ${middle_byte(holed)} ${holed.length} ${thirds(plain)} ${line}"
