// The format reader: what a literal with holes says it is. The empty
// case first, then the escape, the two laws over the holes, and the
// faults a malformed literal earns.
use @std.avrac.features.formats.{read_format, has_holes, Fault}
use @std.avrac.testing.{shown, refused_with}
use @std.avrac.core.{nothing_bound, bound_names, FormatPart}
use @std.avrac.compiler.{analyze_source}

/// A format re-spelled from what the reader made of it: its head,
/// then each hole as `<name:type>` and the literal that follows it.
/// A reader that lost a piece or a type shows it here.
fn shape(text: string) -> string {
    let f = read_format(text)
    if f.fault != null { return why(f.fault!) }
    f.head + [spelled(p) for p in f.parts].join("")
}

fn spelled(p: FormatPart) -> string {
    "<${p.hole.name}${greed(p)}:${p.hole.ty?.name ?? "-"}>${p.piece}"
}

fn greed(p: FormatPart) -> string { if p.hole.greedy { "..." } else { "" } }

/// A fault as one word, its position included — a fault that moved
/// would otherwise read as the same fault.
fn why(f: Fault) -> string {
    match f {
        .Unclosed(at) -> "unclosed@${at}",
        .Stray(at) -> "stray@${at}",
        .Malformed(at, body) -> "malformed@${at}:${body}",
        .Adjacent(a, b) -> "adjacent:${a},${b}",
        .Repeated(n) -> "repeated:${n}",
    }
}

spec "features/formats" {
    given "a literal with no holes" {
        then "empty text is an empty head and no parts" {
            shape("") == "" && read_format("").parts.is_empty()
        }
        then "plain text is its head" {
            shape("abc") == "abc"
        }
        then "a literal with no holes is not a format" {
            !has_holes(read_format("abc")) && has_holes(read_format("{a}"))
        }
        then "a doubled brace is one brace, and no hole" {
            shape("a{{b}}c") == "a{b}c" && !has_holes(read_format("a{{b}}c"))
        }
        then "a doubled brace alone is that brace" {
            shape("{{") == "{" && shape("}}") == "}"
        }
        then "a doubled pair is two braces" {
            shape("{{}}") == "{}"
        }
    }
    given "holes" {

        then "one hole leaves an empty head and one empty piece" {
            shape("{a}") == "<a:->"
        }
        then "the request line reads as four holes with the literals between them" {
            shape("{m} {p} HTTP/{maj: int}.{min: int}") == "<m:-> <p:-> HTTP/<maj:int>.<min:int>"
        }
        then "a typed hole carries the type it names" {
            shape("{n: int}") == "<n:int>"
        }
        then "spaces around a name and a type are not part of them" {
            shape("{ a : int }") == "<a:int>"
        }
        then "a hole that binds nothing still consumes its span" {
            shape("{_}x") == "<_:->x" && bound_names(read_format("{_}x").parts).is_empty()
        }
        then "the word for binding nothing is the language's own" {
            read_format("{_}").parts[0].hole.name == nothing_bound()
        }
        then "a hole that binds nothing may carry a type" {
            shape("{_: int}") == "<_:int>"
        }
        then "the names a format binds are its hole names, without the anonymous" {
            bound_names(read_format("{a}x{_}y{b}").parts).join(",") == "a,b"
        }
        then "a name may hold digits after its first character" {
            shape("{a1}") == "<a1:->"
        }
        then "an escaped brace beside a hole stays a brace" {
            shape("a{{{x}}}c") == "a{<x:->}c"
        }
        then "the head holds everything before the first hole" {
            read_format("abc{x}def").head == "abc"
        }
        then "the last piece holds everything after the last hole" {
            read_format("abc{x}def").parts[0].piece == "def"
        }
    }
    given "the law that two holes need something between them" {

        then "adjacent holes are refused, naming both" {
            shape("{a}{b}") == "adjacent:a,b"
        }
        then "two anonymous holes are adjacent too" {
            shape("{_}{_}") == "adjacent:_,_"
        }
        then "a hole at each END is ordinary, not adjacent" {
            shape("{a}x{b}") == "<a:->x<b:->"
        }
    }
    given "the law that one name binds one span" {

        then "a name written twice is refused" {
            shape("{a} {a}") == "repeated:a"
        }
        then "a repeat is refused whether or not the holes agree on type" {
            shape("{a: int} {a}") == "repeated:a"
        }
        then "the anonymous name may repeat, because it binds nothing" {
            shape("{_} {_}") == "<_:-> <_:->"
        }
    }
    given "a literal that is no format" {

        then "an open brace with no close is refused where it opened" {
            shape("a{b") == "unclosed@1"
        }
        then "a close brace that opens nothing is refused where it sits" {
            shape("a}b") == "stray@1"
        }
        then "a brace at position zero reports position zero" {
            shape("{") == "unclosed@0" && shape("}") == "stray@0"
        }
        then "an empty body is refused" {
            shape("{}") == "malformed@0:"
        }
        then "a body with no name before its colon is refused" {
            shape("{: int}") == "malformed@0:: int"
        }
        then "a colon with no type after it is refused" {
            shape("{a:}") == "malformed@0:a:"
        }
        then "a body that is a phrase, not a name, is refused" {
            shape("{a b}") == "malformed@0:a b"
        }
        then "a name may not start with a digit" {
            shape("{1a}") == "malformed@0:1a"
        }
        then "a name may not hold a dash" {
            shape("{a-b}") == "malformed@0:a-b"
        }
        then "a second colon lands in the type, which is then no name" {
            shape("{a::int}") == "malformed@0:a::int"
        }
        then "a brace inside a body is body text, and no name" {
            shape("{a{b}}") == "malformed@0:a{b"
        }
    }
    given "the refusals, rendered whole" {

        then "a wrong subject names the type it found" {
            analyze_source("match 5 { \"{a}b\" -> 1\n    _ -> 0 }").report().starts_with("error[type.format]: a format pattern reads text, found `int`\n  ╭─[<source>:1:11]\n1 │ match 5 { \"{a}b\" -> 1\n  ·           ┬\n  ·           ╰── this is `int`\n──╯\nhelp: a format matches a `string` or a `Bytes`")
        }
        then "two holes with nothing between them name both" {
            analyze_source("match \"x\" { \"{a}{b}\" -> 1\n    _ -> 0 }").report().starts_with("error[type.format_shape]: `{a}` and `{b}` have nothing between them\n  ╭─[<source>:1:13]\n1 │ match \"x\" { \"{a}{b}\" -> 1\n  ·             ┬\n  ·             ╰── here\n──╯\nhelp: a scan needs a literal to stop at — put one between the holes")
        }
        then "a repeated name says which name" {
            analyze_source("match \"x\" { \"{a}z{a}\" -> 1\n    _ -> 0 }").report().starts_with("error[type.format_repeat]: `a` names two spans of this format\n  ╭─[<source>:1:13]\n1 │ match \"x\" { \"{a}z{a}\" -> 1\n  ·             ┬\n  ·             ╰── written twice\n──╯\nhelp: rename one, or write `{_}` for a span you do not need")
        }
        then "a hole of a type no text reads as names the two it may take" {
            analyze_source("match \"x\" { \"{n: float}z\" -> 1\n    _ -> 0 }").report().starts_with("error[type.format_parse]: `{n: float}` reads its span as `float`, and a hole reads text as `string` or `int`\n  ╭─[<source>:1:13]\n1 │ match \"x\" { \"{n: float}z\" -> 1\n  ·             ┬\n  ·             ╰── here\n──╯\nhelp: take the span as text and convert it in the arm")
        }
    }
    given "a grammar declaration" {

        then "its holes are the fields of a record of its name" {
            shown("grammar Line = \"{method} {path}\"\nlet r = Line { method: \"GET\", path: \"/x\" }\n\"\${r.method}\${r.path}\"") == "GET/x"
        }
        then "the fields keep the holes' order and names" {
            shown("grammar P = \"{a}-{b}-{c}\"\nlet p = P { a: \"1\", b: \"2\", c: \"3\" }\n\"\${p.a}\${p.b}\${p.c}\"") == "123"
        }
        then "a format with no holes names no fields, and is refused" {
            refused_with("grammar Empty = \"no holes here\"\n1", "has no holes")
        }
        then "a hole that binds nothing cannot name a field" {
            refused_with("grammar Anon = \"{a} {_}\"\n1", "has a hole that binds nothing")
        }
        then "an `int` hole is an `int` field, read and printed back" {
            shown("grammar V = \"v{major: int}.{minor: int}\"\nlet v = V.parse(\"v3.14\")!\n\"\${v.major + v.minor} \${V.print(V { major: -1, minor: 0 }) ?? \"?\"}\"") == "17 v-1.0"
        }
        then "a span that is no int reads as nothing" {
            shown("grammar V = \"v{major: int}\"\n\"\${V.parse(\"vx\") == null} \${V.parse(\"v+1\") == null} \${V.parse(\"v\") == null} \${V.parse(\"v99999999999999999999\") == null}\"") == "true true true true"
        }
        then "a hole of a type no text reads as is refused" {
            refused_with("grammar Typed = \"{n: float}z\"\n1", "reads `{n}` as `float`, and a hole reads text as `string` or `int`")
        }
        then "two holes with nothing between them cannot be scanned, so cannot be declared" {
            refused_with("grammar Adj = \"{a}{b}\"\n1", "a scan needs a literal between them")
        }
        then "one name twice is refused by the record's own law" {
            refused_with("grammar Dup = \"{a}z{a}\"\n1", "declares `a` more than once")
        }
        then "a malformed format refuses where the brace is" {
            refused_with("grammar Bad = \"a{b\"\n1", "opens a hole that is never closed")
        }
    }
    given "the parse door a grammar declares" {

        then "a grammar's name parses text into its own record" {
            shown("grammar L = \"{m} {p}\"\nmatch L.parse(\"GET /x\") {\n    r? -> \"\${r.m}|\${r.p}\"\n    null -> \"no\"\n}") == "GET|/x"
        }
        then "text the format does not read answers absence" {
            shown("grammar L = \"{m} {p}\"\nmatch L.parse(\"nope\") {\n    r? -> \"yes\"\n    null -> \"no\"\n}") == "no"
        }
        then "the flagship reads its four holes through the door" {
            shown("grammar R = \"{method} {path} HTTP/{major}.{minor}\"\nmatch R.parse(\"GET /x HTTP/1.1\") {\n    r? -> \"\${r.method} \${r.path} \${r.major}.\${r.minor}\"\n    null -> \"no\"\n}") == "GET /x 1.1"
        }
        then "the name still constructs its record, as any type name does" {
            shown("grammar L = \"{a}-{b}\"\nlet g = L { a: \"1\", b: \"2\" }\ng.a + g.b") == "12"
        }
        then "a door no grammar declares is told about doors, not variants" {
            refused_with("grammar G = \"{a}-{b}\"\nG.sample(\"x\")", "`G` is a `grammar`, not an enum")
        }
        then "the refusal names the door it tried" {
            refused_with("grammar G = \"{a}-{b}\"\nG.sample(\"x\")", "`G.sample` is a call only where the grammar declares a door of that name")
        }
        then "a type name that is no grammar is unchanged" {
            refused_with("type Port = { n: int }\nPort.parse(\"80\")", "`Port` is a record, not an enum")
        }
    }
    given "the declaration's refusals, rendered whole" {

        then "a grammar asked for a door it lacks, rendered whole" {
            analyze_source("grammar G = \"{a}-{b}\"\nG.sample(\"x\")").report().starts_with("error[type.unknown_prop]: `G` is a `grammar`, not an enum\n  ╭─[<source>:2:1]\n2 │ G.sample(\"x\")\n  · ┬\n  · ╰── built here\n──╯\nhelp: `G.sample` is a call only where the grammar declares a door of that name")
        }
        then "a format with no holes, rendered whole" {
            analyze_source("grammar None = \"plain\"\n1").report().starts_with("error[build.failed]: `grammar None` has no holes — a grammar names the fields its holes bind, and this format binds none\n  ╭─[<source>:1:1]\n1 │ grammar None = \"plain\"\n  · ┬\n──╯")
        }
        then "a hole that binds nothing, rendered whole" {
            analyze_source("grammar Anon = \"{a} {_}\"\n1").report().starts_with("error[build.failed]: `grammar Anon` has a hole that binds nothing — every hole of a grammar names a field\n  ╭─[<source>:1:1]\n1 │ grammar Anon = \"{a} {_}\"\n  · ┬\n──╯")
        }
        then "two holes with nothing between them, rendered whole" {
            analyze_source("grammar Adj = \"{a}{b}\"\n1").report().starts_with("error[build.failed]: `grammar Adj` puts `{a}` and `{b}` next to each other — a scan needs a literal between them to stop at\n  ╭─[<source>:1:1]\n1 │ grammar Adj = \"{a}{b}\"\n  · ┬\n──╯")
        }
    }
    given "print, and the round-trip law it keeps" {

        then "a record prints back the text it was read from" {
            shown("grammar L = \"{m} {p}\"\nL.print(L { m: \"GET\", p: \"/x\" }) ?? \"refused\"") == "GET /x"
        }
        then "an interior value that would move its own delimiter is refused" {
            shown("grammar L = \"{a} {b}\"\nL.print(L { a: \"x y\", b: \"z\" }) ?? \"refused\"") == "refused"
        }
        then "a value ENDING IN a proper prefix of its delimiter is refused too" {
            shown("grammar L = \"{a}--{b}\"\nL.print(L { a: \"x-\", b: \"b\" }) ?? \"refused\"") == "refused"
        }
        then "the same value one character shorter prints" {
            shown("grammar L = \"{a}--{b}\"\nL.print(L { a: \"x\", b: \"b\" }) ?? \"refused\"") == "x--b"
        }
        then "the LAST hole carries no condition — the suffix fixes its end" {
            shown("grammar L = \"{a}-{b}\"\nL.print(L { a: \"x\", b: \"y-z\" }) ?? \"refused\"") == "x-y-z"
        }
        then "empty values print the literals alone" {
            shown("grammar L = \"{a}-{b}\"\nL.print(L { a: \"\", b: \"\" }) ?? \"refused\"") == "-"
        }
        then "print then parse recovers every field" {
            shown("grammar L = \"{a}-{b}\"\nlet t = L.print(L { a: \"p\", b: \"q\" })!\nmatch L.parse(t) { r? -> r.a + r.b\n    null -> \"no\" }") == "pq"
        }
    }
    given "a greedy hole" {

        then "the mark is read off the name and does not join it" {
            shape("{a...}-{b}") == "<a...:->-<b:->"
        }
        then "a hole without the mark is not greedy" {
            shape("{a}-{b}") == "<a:->-<b:->"
        }
        then "the mark rides beside a type" {
            shape("{a...: int}-{b}") == "<a...:int>-<b:->"
        }
        then "the mark does not make `_` bind" {
            bound_names(read_format("{_...}-{b}").parts).join(",") == "b"
        }
        then "A GREEDY HOLE TAKES ITS LITERAL AT THE LAST OCCURRENCE" {
            shown("grammar G = \"{a...}-{b}\"\nmatch G.parse(\"1-2-3\") { r? -> r.a + \"|\" + r.b\n    null -> \"no\" }") == "1-2|3"
        }
        then "and its lazy twin takes the first" {
            shown("grammar L = \"{a}-{b}\"\nmatch L.parse(\"1-2-3\") { r? -> r.a + \"|\" + r.b\n    null -> \"no\" }") == "1|2-3"
        }
        then "with one occurrence the two agree" {
            shown("grammar G = \"{a...}-{b}\"\nmatch G.parse(\"1-2\") { r? -> r.a + \"|\" + r.b\n    null -> \"no\" }") == "1|2"
        }
        then "with no occurrence both fail" {
            shown("grammar G = \"{a...}-{b}\"\nmatch G.parse(\"12\") { r? -> \"yes\"\n    null -> \"no\" }") == "no"
        }
        then "an empty capture is still a capture" {
            shown("grammar G = \"{a...}-{b}\"\nmatch G.parse(\"-x\") { r? -> \"[\" + r.a + \"][\" + r.b + \"]\"\n    null -> \"no\" }") == "[][x]"
        }
        then "THERE IS NO BACKTRACKING, so a greedy hole can fail where its lazy twin matches" {
            shown("grammar G = \"{a...}-{b}-{c}\"\nmatch G.parse(\"1-2-3-4\") { r? -> \"yes\"\n    null -> \"no\" }") == "no"
        }
        then "and the lazy twin of that format does match" {
            shown("grammar L = \"{a}-{b}-{c}\"\nmatch L.parse(\"1-2-3-4\") { r? -> \"yes\"\n    null -> \"no\" }") == "yes"
        }
    }
    given "greed on the LAST hole, which is inert" {

        then "a marked last hole answers what an unmarked one does" {
            shown("grammar G = \"/s/{p...}\"\ngrammar P = \"/s/{p}\"\nlet a = G.parse(\"/s/a/b/c\")?.p ?? \"no\"\nlet b = P.parse(\"/s/a/b/c\")?.p ?? \"no\"\na + \"|\" + b") == "a/b/c|a/b/c"
        }
        then "and both refuse the same text" {
            shown("grammar G = \"/s/{p...}\"\ngrammar P = \"/s/{p}\"\nlet a = G.parse(\"/x/y\")?.p ?? \"no\"\nlet b = P.parse(\"/x/y\")?.p ?? \"no\"\na + \"|\" + b") == "no|no"
        }
        then "and both take an empty capture the same way" {
            shown("grammar G = \"/s/{p...}\"\ngrammar P = \"/s/{p}\"\nlet a = G.parse(\"/s/\")?.p ?? \"no\"\nlet b = P.parse(\"/s/\")?.p ?? \"no\"\n\"[\" + a + \"][\" + b + \"]\"") == "[][]"
        }
    }
    given "the round trip, and its greedy mirror" {

        then "A GREEDY PRINT ACCEPTS WHAT ITS LAZY TWIN REFUSES" {
            shown("grammar G = \"{a...}-{b}\"\nG.print(G { a: \"1-2\", b: \"3\" }) ?? \"refused\"") == "1-2-3"
        }
        then "and the lazy twin refuses that very value" {
            shown("grammar L = \"{a}-{b}\"\nL.print(L { a: \"1-2\", b: \"3\" }) ?? \"refused\"") == "refused"
        }
        then "AND REFUSES WHAT ITS LAZY TWIN ACCEPTS — the conditions are mirrors" {
            shown("grammar G = \"{a...}-{b}\"\nG.print(G { a: \"1\", b: \"2-3\" }) ?? \"refused\"") == "refused"
        }
        then "and the lazy twin accepts that one" {
            shown("grammar L = \"{a}-{b}\"\nL.print(L { a: \"1\", b: \"2-3\" }) ?? \"refused\"") == "1-2-3"
        }
        then "THE OVERLAP CASE ROUND-TRIPS UNDER GREED — a value ending in its own delimiter's prefix" {
            shown("grammar G = \"{a...}--{b}\"\nlet t = G.print(G { a: \"x-\", b: \"y\" })!\nmatch G.parse(t) { r? -> \"[\" + r.a + \"][\" + r.b + \"]\"\n    null -> \"no\" }") == "[x-][y]"
        }
        then "and its lazy twin refuses that value, which is why the proof has two clauses" {
            shown("grammar L = \"{a}--{b}\"\nL.print(L { a: \"x-\", b: \"y\" }) ?? \"refused\"") == "refused"
        }
        then "whatever a greedy print answers, parsing it gives the fields back" {
            shown("grammar G = \"{a...}-{b}\"\nlet t = G.print(G { a: \"p-q\", b: \"r\" })!\nmatch G.parse(t) { r? -> r.a + \"|\" + r.b\n    null -> \"no\" }") == "p-q|r"
        }
    }
}
