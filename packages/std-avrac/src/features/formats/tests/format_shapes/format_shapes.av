// proves: a format pattern's greedy hole takes its piece's last place and a lazy one its first; a
// format in an or-pattern binds what either alternative found; a guard reads the holes its pattern
// bound.
fn greedy(s: string) -> string {
    match s { "{a...}.{b}" -> "${a}|${b}", _ -> "none" }
}
fn lazy(s: string) -> string {
    match s { "{a}.{b}" -> "${a}|${b}", _ -> "none" }
}
fn either(s: string) -> string {
    match s { "a:{x}" or "b={x}" -> "got ${x}", _ -> "no" }
}
fn guarded(s: string) -> string {
    match s { "{k}={v}" if k.length > 1 -> "long ${k}", "{k}={v}" -> "short ${v}", _ -> "-" }
}
println(
    "${greedy("x.y.z")} ${lazy("x.y.z")} ${greedy("xyz")} ${either("a:1")} ${either("b=2")} ${either("c")} ${guarded("ab=1")} ${guarded("a=2")} ${guarded("")}",
)
