// proves: a string literal with holes, in pattern position — the
// anchored scan, the first-occurrence rule for an interior hole, the
// suffix anchor for the last one, a hole that binds nothing, the
// escape, and a literal with no holes matching by equality as it
// always did.
fn seen(line: string) -> string {
    match line {
        "{method} {path} HTTP/{major}.{minor}" -> "req ${method} ${path} ${major}.${minor}"
        "{a}.{b}" -> "two ${a}/${b}"
        "GET" -> "literal"
        "a{{b}}c" -> "escaped"
        "x{_}z" -> "skipped"
        "{whole}" -> "whole [${whole}]"
        _ -> "none"
    }
}

let flagship = seen("GET /x HTTP/1.1")
let interior = seen("w.x.y")
let literal = seen("GET")
let escaped = seen("a{b}c")
let skipped = seen("xQz")
let whole = seen("zz")
let empty = seen("")
"${flagship} | ${interior} | ${literal} | ${escaped} | ${skipped} | ${whole} | ${empty}"
