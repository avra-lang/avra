//! The formats semantics: dispatch only. The laws live in check.av,
//! the scan in lower.av. A feature matches its OWN variants and
//! delegates the rest — the seam routes every other pattern to its
//! owner before this is ever reached.
use core.{PatId, TypeId, Reg}
use features.{PatSemantics, TypeCx, LowerCx, const_bool}
use features.formats.{format_types, format_accepts, format_binds}

export type FormatPatSemantics = { }

impl PatSemantics for FormatPatSemantics {
    fn pat_types(mut cx: TypeCx, p: PatId, expected: TypeId) -> List<TypeId> {
        // a feature cannot enumerate OTHER features' variants
        match cx.view.store.pat(p) {
            .Format(_, parts) -> format_types(cx, p, parts, expected),
            rest -> [],
        }
    }

    fn pat_accepts(mut cx: LowerCx, p: PatId, v: Reg, vty: TypeId) -> Reg {
        // a feature cannot enumerate OTHER features' variants
        match cx.view.store.pat(p) {
            .Format(head, parts) -> format_accepts(cx, head, parts, v, vty),
            rest -> reached_wrongly(cx),
        }
    }

    fn pat_binds(mut cx: LowerCx, p: PatId, v: Reg, vty: TypeId) -> List<Reg> {
        // a feature cannot enumerate OTHER features' variants
        match cx.view.store.pat(p) {
            .Format(head, parts) -> format_binds(cx, head, parts, v, vty),
            rest -> {
                cx.defect("a pattern that is no format reached the format binds")
                []
            },
        }
    }
}

/// The seam routes every pattern to its owner, so this cannot
/// arrive; refusing is the honest answer if the seam ever breaks.
fn reached_wrongly(mut cx: LowerCx) -> Reg {
    cx.defect("a pattern that is no format reached the format test")
    const_bool(cx, false)
}
