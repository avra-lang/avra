//! Parse-time lowering: a STRING token in pattern position becomes
//! the FORMAT it spells, or — when it spells no holes — the literal
//! pattern it always was. The three TEXT faults refuse here in the
//! builder's own words, because a literal that cannot be split into
//! head and parts has no node to carry; the two LAWS over the holes
//! are re-derived from the node and spoken by typing, where they
//! carry a span and a code.
use core.{Expr, Pat, Stmt, Param, GrammarSpec, named_ref, binds, bound_names}
use features.{LangNode, Builder}
use features.formats.{read_format, has_holes, Format, Fault}

fn build_format_pat(mut b: Builder) -> Result<LangNode, string> {
    let t = b.token(0)?
    let f = read_format(t.text)
    let text: string? = refusal_of(f.fault)
    if text != null { return .Err(text!) }
    if !has_holes(f) { return b.make_pat(Pat.Lit(b.store.alloc_expr(Expr.StrLit(f.head), b.span))) }
    b.make_pat(Pat.Format(f.head, f.parts))
}

/// The words a TEXT fault earns. The two laws over the holes answer
/// absence here — typing speaks them, with a code and a span.
fn refusal_of(fault: Fault?) -> string? {
    if fault == null { return null }
    match fault! {
        .Unclosed(at) -> "a `{` at ${at} opens a hole that is never closed — write `{{` for a literal brace",
        .Stray(at) -> "a `}` at ${at} closes nothing — write `}}` for a literal brace",
        .Malformed(at, body) -> "`{${body}}` at ${at} is no hole — a hole is `{name}` or `{name: Type}`",
        .Adjacent(_, _) or .Repeated(_) -> null,
    }
}

/// `grammar Name = "…"` — the format's HOLES are a record's fields,
/// declared once so the shape and the text it reads cannot drift.
/// Every fault refuses here: a declaration's format is known whole at
/// build time, so there is no later place that knows more.
fn build_grammar_decl(mut b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let t = b.token(1)?
    let f = read_format(t.text)
    let broken: string? = undeclarable(f, n.text)
    if broken != null { return .Err(broken!) }
    let s = b.store.alloc_stmt(Stmt.StructDecl(n.text, [], [field_of(name) for name in bound_names(f.parts)]), b.span)
    b.store.mark_grammar(s, GrammarSpec { head: f.head, parts: f.parts })
    .Ok(LangNode.NStmt(s))
}

/// Why a format names no record — the FIRST law it breaks. A
/// declaration keeps no format node, so every law speaks here; a
/// pattern hears the last two at check time from its own node.
fn undeclarable(f: Format, name: string) -> string? {
    let malformed: string? = refusal_of(f.fault)
    if malformed != null { return malformed }
    let unscannable: string? = adjacent_words(f.fault, name)
    if unscannable != null { return unscannable }
    if !has_holes(f) { return "`grammar ${name}` has no holes — a grammar names the fields its holes bind, and this format binds none" }
    let anonymous = f.parts.find((p) -> !binds(p.hole))
    if anonymous != null { return "`grammar ${name}` has a hole that binds nothing — every hole of a grammar names a field" }
    let typed = f.parts.find((p) -> p.hole.ty != null)
    if typed != null { return "`grammar ${name}` has a hole that parses its span, and nothing reads text as `${typed!.hole.ty!.name}` yet" }
    null
}

/// Two holes with nothing between them, in a declaration's words.
fn adjacent_words(fault: Fault?, name: string) -> string? {
    if fault == null { return null }
    match fault! {
        .Adjacent(a, b) -> "`grammar ${name}` puts `{${a}}` and `{${b}}` next to each other — a scan needs a literal between them to stop at",
        .Repeated(_) or .Unclosed(_) or .Stray(_) or .Malformed(_, _) -> null,
    }
}

/// One capture as a record field: its name, and the span it takes.
fn field_of(name: string) -> Param {
    Param { name: name, ty: named_ref("string"), default: null, mutable: false }
}


