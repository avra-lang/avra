//! THE SCAN, emitted. One anchored left-to-right pass over the
//! subject's octets: the head is a prefix, the last piece a suffix,
//! and every piece between them is found at the FIRST position at or
//! after the cursor — or at the LAST, when its hole is GREEDY. No
//! backtracking either way, so the emitted code is linear in the
//! subject.
//!
//! AND NO BACKTRACKING IS THE CONSEQUENCE TO KNOW ABOUT GREED. A
//! greedy hole can fail where its lazy twin would have matched,
//! because the occurrence it took may leave a later piece unfindable
//! and nothing goes back to try an earlier one. That is a property of
//! the format the writer chose, not a defect: the two spellings pick
//! different splits and each is exact about which.
//!
//! Every step is a LAZY REGION over the verdict so far, as an enum
//! pattern's payload tests are: a step after a failure never runs,
//! which is what keeps a cursor past the end away from `index_of`,
//! whose `from` traps. The spans land in cells the steps write, and
//! the values are cut from them afterwards.
//!
//! The walk is EMITTED ONCE. `pat_accepts` runs it and leaves the
//! octets and the span cells in the pattern's test slot; `pat_binds`
//! reads them back and cuts the values inside the arm's region, so
//! an untaken arm mints no managed value at all.
use core.{Reg, Ins, PatId, ExprId, Type, TypeId, BinOp, FormatPart, GrammarSpec, binds}
use features.{LowerCx, MethodCall}
use features.formats.{pattern_text, Reads, reads_of}

/// Whether the subject matches. The walk's octets and span cells are
/// left in the pattern's slot for the binds — written once here,
/// read once there.
export fn format_accepts(mut cx: LowerCx, p: PatId, head: string, parts: List<FormatPart>, v: Reg, vty: TypeId) -> Reg {
    let w = walked(cx, head, parts, v, vty)
    cx.bind_test(p, [w.subject].concat(w.spans).concat(w.reads))
    w.ok
}

/// The values the holes bind, in order, skipping the holes that bind
/// nothing — the same order `pattern_binds` answers. The spans were
/// found by the test; only the cutting happens here, which is what
/// keeps an untaken arm free of allocation.
export fn format_binds(mut cx: LowerCx, p: PatId, parts: List<FormatPart>, v: Reg, vty: TypeId) -> List<Reg> {
    let regs = cx.test_regs_of(p)
    if regs.length != 1 + 3 * parts.length { return untested(cx) }
    let w = Walked { ok: regs[0], subject: regs[0], spans: regs.slice(1, 1 + 2 * parts.length), reads: regs.slice(1 + 2 * parts.length, regs.length) }
    mut out: List<Reg> = []
    // LICENSED rule.loops.push_loop: the values must be EMITTED in hole order, each minting its own answer
    for i, part in parts {
        if binds(part.hole) { out.push(held(cx, w, part, i, v, vty)) }
    }
    out
}

/// What one hole binds, the walk done: its span cut, or the value a
/// typed hole already read.
fn held(mut cx: LowerCx, w: Walked, part: FormatPart, i: int, v: Reg, vty: TypeId) -> Reg {
    match reads_of(part.hole)! {
        .Text -> cut(cx, w.subject, w.spans[2 * i], w.spans[2 * i + 1], v, vty),
        .Int -> loaded_from(cx, w.reads[i]),
    }
}

/// The test runs before the binds and leaves the spans behind, so an
/// empty slot means the seam called them out of order.
fn untested(mut cx: LowerCx) -> List<Reg> {
    cx.defect("a format's binds were asked before its test found the spans")
    []
}

/// A walk's result: the verdict, the octets it read, the span cells —
/// a lo and a hi per hole, in hole order — and a cell per hole for
/// the int a typed hole read.
type Walked = { ok: Reg, subject: Reg, spans: List<Reg>, reads: List<Reg> }

fn walked(mut cx: LowerCx, head: string, parts: List<FormatPart>, v: Reg, vty: TypeId) -> Walked {
    let subject = octets(cx, v, vty)
    let len = measured(cx, subject)
    let final? = parts.last() else { return Walked { ok: whole(cx, subject, len, head), subject: subject, spans: [], reads: [] } }
    let int_ty = cx.type(int)
    let last = final.piece
    let stop = cx.seeded_cell(int_ty, minus(cx, len, cx.const_int(byte_length(last))))
    let cur = cx.seeded_cell(int_ty, cx.const_int(byte_length(head)))
    mut spans: List<Reg> = []
    // LICENSED rule.loops.push_loop: a lo and a hi per hole, minted in hole order before any step writes one
    for part in parts {
        spans.push(cx.seeded_cell(int_ty, cx.const_int(0)))
        spans.push(cx.seeded_cell(int_ty, cx.const_int(0)))
    }
    let reads = [cx.seeded_cell(int_ty, cx.const_int(0)) for part in parts]
    let w = Walked { ok: anchored(cx, subject, len, head, last), subject: subject, spans: spans, reads: reads }
    let found = w with { ok: spanned(cx, w, parts, cur, stop, 0) }
    found with { ok: read_through(cx, found, parts, v, vty, 0) }
}

/// EVERY TYPED HOLE READ, after every span is found, inside the
/// verdict so far: a span that does not read as its type fails the
/// match, as a missing literal does.
fn read_through(mut cx: LowerCx, w: Walked, parts: List<FormatPart>, v: Reg, vty: TypeId, i: int) -> Reg {
    if i == parts.length { return w.ok }
    if reads_of(parts[i].hole) != Reads.Int { return read_through(cx, w, parts, v, vty, i + 1) }
    cx.open_region(w.ok)
    cx.arm_end(int_read(cx, w, i, v, vty))
    let no = cx.const_bool(false)
    read_through(cx, w with { ok: cx.close_region_as(cx.type(bool), no) }, parts, v, vty, i + 1)
}

/// Whether hole `i`'s span spells an int, which lands in its cell. A
/// span of octets reads only when it is text.
fn int_read(mut cx: LowerCx, w: Walked, i: int, v: Reg, vty: TypeId) -> Reg {
    let span = cut(cx, w.subject, w.spans[2 * i], w.spans[2 * i + 1], v, vty)
    if !(cx.view.types.seen_shape(vty) is .Bytes) { return parsed_into(cx, span, w.reads[i]) }
    let str_opt = cx.type(string?)
    let text = cx.str_of_bytes(cx.view.types.shape_of(str_opt), span)
    cx.open_presence(text, str_opt)
    cx.arm_end(parsed_into(cx, cx.carried_of(text, str_opt), w.reads[i]))
    let no = cx.const_bool(false)
    cx.close_region_as(cx.type(bool), no)
}

/// Whether `text` spells an int; when it does, the int lands in `cell`.
fn parsed_into(mut cx: LowerCx, text: Reg, cell: Reg) -> Reg {
    cx.open_region(cx.str_parses_int(Type.Bool, text))
    cx.emit(Ins.Store(cell, cx.str_parsed_int(Type.Int, text)))
    cx.arm_end(cx.const_bool(true))
    let no = cx.const_bool(false)
    cx.close_region_as(cx.type(bool), no)
}

/// A format of no holes is its head, matched whole: exactly as long,
/// and the same bytes.
fn whole(mut cx: LowerCx, subject: Reg, len: Reg, head: string) -> Reg {
    let need = cx.const_int(byte_length(head))
    cx.open_region(cx.bin(Type.Bool, BinOp.Eq, len, need))
    let zero = cx.const_int(0)
    cx.arm_end(at_span(cx, subject, zero, need, head))
    let short = cx.const_bool(false)
    cx.close_region_as(cx.type(bool), short)
}

/// THE TWO ANCHORS, before any cursor moves: the value is long
/// enough to hold the head and the last piece without them
/// overlapping, the head is a prefix, and the last piece a suffix.
fn anchored(mut cx: LowerCx, subject: Reg, len: Reg, head: string, last: string) -> Reg {
    let need = cx.const_int(byte_length(head) + byte_length(last))
    cx.open_region(cx.bin(Type.Bool, BinOp.Ge, len, need))
    let zero = cx.const_int(0)
    let hlen = cx.const_int(byte_length(head))
    cx.arm_end(at_span(cx, subject, zero, hlen, head))
    let short = cx.const_bool(false)
    let prefix = cx.close_region_as(cx.type(bool), short)
    cx.open_region(prefix)
    cx.arm_end(tail_span(cx, subject, len, last))
    let no = cx.const_bool(false)
    cx.close_region_as(cx.type(bool), no)
}

/// SPAN I, inside the verdict so far. A skipped step answers false,
/// so the chain short-circuits and no later call reads the cursor.
fn spanned(mut cx: LowerCx, w: Walked, parts: List<FormatPart>, cur: Reg, stop: Reg, i: int) -> Reg {
    if i == parts.length { return w.ok }
    cx.open_region(w.ok)
    cx.arm_end(hole_span(cx, w, parts, i, cur, stop))
    let no = cx.const_bool(false)
    spanned(cx, w with { ok: cx.close_region_as(cx.type(bool), no) }, parts, cur, stop, i + 1)
}

/// WHICH SPAN THIS HOLE TAKES. The last hole runs to the suffix
/// anchor; an interior one ends at its literal, taken at that
/// literal's FIRST occurrence, or its LAST when the hole is greedy.
///
/// GREED IS INERT ON THE LAST HOLE and this is why: that hole's end
/// is fixed by the suffix anchor, not by a search, so first and last
/// are the same position. The mark there STATES what the hole already
/// does, which is what lets a route's pattern carry it and still read
/// exactly as its grammar does.
fn hole_span(mut cx: LowerCx, w: Walked, parts: List<FormatPart>, i: int, cur: Reg, stop: Reg) -> Reg {
    if i == parts.length - 1 { return last_span(cx, w, i, cur, stop) }
    if parts[i].hole.greedy { return greedy_span(cx, w, i, cur, parts[i].piece) }
    next_span(cx, w, i, cur, parts[i].piece)
}

/// A GREEDY interior hole's span: its literal taken at the LAST
/// occurrence at or after the cursor rather than the first — the
/// mirror of its lazy twin, over the same region, choosing the other
/// end of it.
///
/// The search is a forward scan that keeps its last hit, so it is one
/// pass. THERE IS STILL NO BACKTRACKING, which is the consequence to
/// know: a greedy hole can fail where its lazy twin would have
/// matched, because the piece it took may leave a later piece
/// unfindable, and nothing goes back to try the earlier occurrence.
///
/// ONLY CELLS CROSS THE LOOP'S EDGE. The probe is read by the
/// condition and written by the body, and no register minted in one
/// is read in the other.
fn greedy_span(mut cx: LowerCx, w: Walked, i: int, cur: Reg, piece: string) -> Reg {
    let from = loaded_from(cx, cur)
    cx.emit(Ins.Store(w.spans[2 * i], from))
    let int_ty = cx.type(int)
    let needle = literal(cx, piece)
    let first = cx.bytes_index_of(Type.Int, w.subject, needle, from)
    let probe = cx.seeded_cell(int_ty, first)
    let miss = cx.const_int(0 - 1)
    let best = cx.seeded_cell(int_ty, miss)
    farthest(cx, w, best, probe, needle)
    let hi = loaded_from(cx, best)
    cx.emit(Ins.Store(w.spans[2 * i + 1], hi))
    let width = cx.const_int(byte_length(piece))
    cx.emit(Ins.Store(cur, plus(cx, hi, width)))
    let zero = cx.const_int(0)
    cx.bin(Type.Bool, BinOp.Ge, hi, zero)
}

/// While the probe holds a hit, keep it and look one past it.
fn farthest(mut cx: LowerCx, w: Walked, best: Reg, probe: Reg, needle: Reg) {
    cx.loop_start()
    let seen = loaded_from(cx, probe)
    let zero = cx.const_int(0)
    cx.loop_cond(cx.bin(Type.Bool, BinOp.Ge, seen, zero))
    let here = loaded_from(cx, probe)
    cx.emit(Ins.Store(best, here))
    let one = cx.const_int(1)
    let after = plus(cx, here, one)
    let next = cx.bytes_index_of(Type.Int, w.subject, needle, after)
    cx.emit(Ins.Store(probe, next))
    cx.loop_end()
}

/// An INTERIOR hole's span: it begins at the cursor and ends where
/// the literal after it is first found at or after the cursor; the
/// cursor then moves past that literal. Absent, and the arm fails.
fn next_span(mut cx: LowerCx, w: Walked, i: int, cur: Reg, piece: string) -> Reg {
    let from = loaded_from(cx, cur)
    cx.emit(Ins.Store(w.spans[2 * i], from))
    let needle = literal(cx, piece)
    let found = cx.bytes_index_of(Type.Int, w.subject, needle, from)
    cx.emit(Ins.Store(w.spans[2 * i + 1], found))
    let width = cx.const_int(byte_length(piece))
    cx.emit(Ins.Store(cur, plus(cx, found, width)))
    let zero = cx.const_int(0)
    cx.bin(Type.Bool, BinOp.Ge, found, zero)
}

/// The LAST hole's span runs from the cursor to the suffix's start,
/// and the arm fails when the cursor has already passed it.
fn last_span(mut cx: LowerCx, w: Walked, i: int, cur: Reg, stop: Reg) -> Reg {
    let from = loaded_from(cx, cur)
    let upto = loaded_from(cx, stop)
    cx.emit(Ins.Store(w.spans[2 * i], from))
    cx.emit(Ins.Store(w.spans[2 * i + 1], upto))
    cx.bin(Type.Bool, BinOp.Le, from, upto)
}

/// One hole's value: the span, as octets when the subject is octets
/// and as text when it is text. A text span is cut from the ORIGINAL
/// string, whose byte positions the octets share, so nothing is
/// re-validated and no copy is made twice.
fn cut(mut cx: LowerCx, subject: Reg, lo_cell: Reg, hi_cell: Reg, v: Reg, vty: TypeId) -> Reg {
    let lo = loaded_from(cx, lo_cell)
    let hi = loaded_from(cx, hi_cell)
    if cx.view.types.seen_shape(vty) is .Bytes { return cx.bytes_slice(Type.Bytes, subject, lo, hi) }
    cx.str_substring(Type.Str, v, lo, hi)
}

// ── The small verbs ─────────────────────────────────────────────

/// The subject as octets — a `Bytes` already is; a `string` is
/// copied once, which is what buys a NUL-exact scan over text whose
/// C-string primitives are not.
fn octets(mut cx: LowerCx, v: Reg, vty: TypeId) -> Reg {
    if cx.view.types.seen_shape(vty) is .Bytes { return v }
    cx.bytes_of_str(Type.Bytes, v)
}

fn measured(mut cx: LowerCx, subject: Reg) -> Reg {
    cx.bytes_len(Type.Int, subject)
}

/// Whether `lo..hi` of the subject is this literal.
fn at_span(mut cx: LowerCx, subject: Reg, lo: Reg, hi: Reg, text: string) -> Reg {
    let needle = literal(cx, text)
    cx.bytes_eq_at(Type.Bool, subject, lo, hi, needle)
}

/// The last piece sits at the end: `len - |piece|` up to `len`.
fn tail_span(mut cx: LowerCx, subject: Reg, len: Reg, last: string) -> Reg {
    at_span(cx, subject, minus(cx, len, cx.const_int(byte_length(last))), len, last)
}

/// A literal as octets. The conversion runs per attempt: the IR
/// carries no constant of this shape to hoist it into.
fn literal(mut cx: LowerCx, text: string) -> Reg {
    cx.bytes_of_str(Type.Bytes, cx.const_str(text))
}

/// A literal's length in OCTETS, which is what the scan counts.
fn byte_length(text: string) -> int {
    text.bytes().length
}

fn loaded_from(mut cx: LowerCx, cell: Reg) -> Reg {
    cx.loaded_as(cx.type(int), cell)
}

fn plus(mut cx: LowerCx, a: Reg, b: Reg) -> Reg {
    cx.bin(Type.Int, BinOp.Add, a, b)
}

fn minus(mut cx: LowerCx, a: Reg, b: Reg) -> Reg {
    cx.bin(Type.Int, BinOp.Sub, a, b)
}

// ── The doors a grammar declares ────────────────────────────────

/// `Name.parse(text)` — the SAME walk the pattern emits, and then
/// the record its holes name, or absence. No format exists at run
/// time: the declaration's spec is read here, at compile time.
export fn lower_parse(mut cx: LowerCx, mc: MethodCall) -> Reg {
    let read? = grammar_at(cx, mc.subject) else { return doorless(cx, mc.e) }
    let want = cx.type_at(mc.e)
    if cx.seen_at(mc.args[0]) is .Bytes { return from_octets(cx, mc, read, want) }
    read_into(cx, read, cx.reg_of(mc.args[0]), want)
}

/// OCTETS ARE SCANNED AS OCTETS, and become text only on a HIT. A
/// miss allocates nothing: the walk works over the span the framer
/// left, and a route that does not answer pays its literal searches
/// and stops. This is the boundary the arc argued for, kept at the
/// door rather than at the caller.
fn from_octets(mut cx: LowerCx, mc: MethodCall, read: GrammarSpec, want: TypeId) -> Reg {
    let octets = cx.reg_of(mc.args[0])
    let w = walked(cx, read.head, read.parts, octets, cx.type(Bytes))
    cx.open_region(w.ok)
    cx.arm_end(crossed_into(cx, w, read, octets, want))
    let none = cx.absent_of(want)
    cx.close_region(mc.e, none)
}

/// THE CROSSING, PAID ONLY ON A HIT: the spans are found, so the
/// target becomes text once and every capture is cut from it. A span
/// running between two whole literal matches inside valid UTF-8 is
/// itself valid, so validating the target once IS validating every
/// capture — one crossing rather than one per hole, and the same
/// answer.
fn crossed_into(mut cx: LowerCx, w: Walked, read: GrammarSpec, octets: Reg, want: TypeId) -> Reg {
    let str_opt = cx.type(string?)
    let crossed = cx.str_of_bytes(cx.view.types.shape_of(str_opt), octets)
    cx.open_presence(crossed, str_opt)
    let text = cx.carried_of(crossed, str_opt)
    cx.arm_end(cx.adopted(want, false, gathered(cx, w, read.parts, text, want)))
    let none = cx.absent_of(want)
    cx.close_region_as(want, none)
}

/// The scan over text in hand, and the record it fills.
fn read_into(mut cx: LowerCx, read: GrammarSpec, text: Reg, want: TypeId) -> Reg {
    let w = walked(cx, read.head, read.parts, text, cx.type(string))
    cx.open_region(w.ok)
    cx.arm_end(cx.adopted(want, false, gathered(cx, w, read.parts, text, want)))
    let none = cx.absent_of(want)
    cx.close_region_as(want, none)
}

/// The record the holes fill, slot by slot in declaration order —
/// which is hole order, because the fields ARE the holes.
fn gathered(mut cx: LowerCx, w: Walked, parts: List<FormatPart>, text: Reg, want: TypeId) -> Reg {
    mut slots: List<Reg> = []
    // LICENSED rule.loops.push_loop: the values must be EMITTED in hole order, each minting its own answer
    for i, part in parts {
        if binds(part.hole) { slots.push(held(cx, w, part, i, text, cx.type(string))) }
    }
    cx.packed_struct(cx.carried_type(want), slots)
}

/// A door's format lives on its DECLARATION, so a door reached
/// without one is the admission rule broken.
fn doorless(mut cx: LowerCx, e: ExprId) -> Reg {
    cx.lower_defect(e, "a grammar door without its declaration survived typing")
}

/// The grammar a type-name receiver stands for.
fn grammar_at(cx: LowerCx, subject: ExprId) -> GrammarSpec? {
    match cx.view.types.shape_of(cx.type_at(subject)) {
        .TypeName(decl, _) -> cx.view.decls.grammar_of(decl),
        rest -> null,
    }
}

/// `Name.print(r)` — the record's fields woven back between the
/// format's literals, or absence when a value would not survive the
/// round trip. THE DOMAIN, checked here because it is a property of
/// the VALUES and not of the format: an interior hole's text, with
/// its following literal appended, must place that literal at the
/// boundary and nowhere earlier. A value ENDING IN a proper prefix of
/// its delimiter overlaps it and would move its own split; `contains`
/// cannot see that, and the scan can.
export fn lower_print(mut cx: LowerCx, mc: MethodCall) -> Reg {
    let read? = grammar_at(cx, mc.subject) else { return doorless(cx, mc.e) }
    let fields = read_fields(cx, mc.args[0], read.parts)
    let want = cx.type_at(mc.e)
    cx.open_region(survives(cx, read.parts, fields, 0))
    cx.arm_end(cx.adopted(want, false, woven(cx, read, fields)))
    let none = cx.absent_of(want)
    cx.close_region(mc.e, none)
}

/// A grammar's format as text — a constant the declaration fixed.
export fn lower_pattern(mut cx: LowerCx, mc: MethodCall) -> Reg {
    let read? = grammar_at(cx, mc.subject) else { return doorless(cx, mc.e) }
    cx.const_str_at(mc.e, pattern_text(read.head, read.parts))
}

/// Every hole's value, read from the record in hole order — the same
/// order the fields were declared in, because the fields ARE the holes.
fn read_fields(mut cx: LowerCx, subject: ExprId, parts: List<FormatPart>) -> List<Reg> {
    let v = cx.reg_of(subject)
    let vty = cx.type_at(subject)
    mut out: List<Reg> = []
    // LICENSED rule.loops.push_loop: the reads must be EMITTED in slot order, each minting its own answer
    for i, part in parts {
        out.push(printed(cx, v, vty, i, reads_of(part.hole)!))
    }
    out
}

/// One field as the text its hole prints: itself, or an int's digits.
fn printed(mut cx: LowerCx, v: Reg, vty: TypeId, i: int, r: Reads) -> Reg {
    match r {
        .Text -> cx.field_read(v, vty, i, cx.type(string)),
        .Int -> cx.int_text(Type.Str, cx.field_read(v, vty, i, cx.type(int))),
    }
}

/// WHETHER THE VALUES SURVIVE, hole by hole, as a lazy chain: a later
/// check runs only while the earlier ones hold. The LAST hole carries
/// no condition — the suffix anchor fixes its end positionally.
fn survives(mut cx: LowerCx, parts: List<FormatPart>, fields: List<Reg>, i: int) -> Reg {
    if i >= parts.length - 1 { return cx.const_bool(true) }
    let here = holds(cx, parts, fields, i)
    cx.open_region(here)
    cx.arm_end(survives(cx, parts, fields, i + 1))
    let no = cx.const_bool(false)
    cx.close_region_as(cx.type(bool), no)
}

/// WHICH CONDITION THIS HOLE OWES, and they are mirrors: a LAZY hole
/// needs its literal to appear no EARLIER than the boundary, so the
/// test looks LEFT, at the value itself; a GREEDY one needs it to
/// appear no LATER, so the test looks RIGHT, at everything printed
/// after it. Neither condition reaches the other's side, which is why
/// a value one accepts the other may refuse.
fn holds(mut cx: LowerCx, parts: List<FormatPart>, fields: List<Reg>, i: int) -> Reg {
    if parts[i].hole.greedy { return unpassed(cx, parts, fields, i) }
    unmoved(cx, fields[i], parts[i].piece)
}

/// A GREEDY hole's condition: its literal, followed by everything
/// printed after it, must hold NO FURTHER occurrence of that literal.
/// An occurrence straddling the boundary counts, which is why the
/// search runs over the literal and the tail JOINED rather than over
/// the tail alone.
///
/// The value itself is not asked about, and that is the point: a
/// greedy hole may hold its own delimiter as often as it likes,
/// because it takes the LAST one.
fn unpassed(mut cx: LowerCx, parts: List<FormatPart>, fields: List<Reg>, i: int) -> Reg {
    let after = trailing(cx, parts, fields, i)
    let octets = cx.bytes_of_str(Type.Bytes, after)
    let needle = literal(cx, parts[i].piece)
    let one = cx.const_int(1)
    let at = cx.bytes_index_of(Type.Int, octets, needle, one)
    let zero = cx.const_int(0)
    cx.bin(Type.Bool, BinOp.Lt, at, zero)
}

/// This hole's literal, then every later hole's value and literal —
/// the text the scan will still have in front of it when it takes
/// this hole's delimiter.
fn trailing(mut cx: LowerCx, parts: List<FormatPart>, fields: List<Reg>, i: int) -> Reg {
    mut pieces = [cx.const_str(parts[i].piece)]
    // LICENSED rule.loops.push_loop: the pieces must be EMITTED in order, each minting its own register
    for j, part in parts {
        if j > i {
            pieces.push(fields[j])
            pieces.push(cx.const_str(part.piece))
        }
    }
    glued(cx, pieces)
}

/// One hole's value against the literal that follows it: appended,
/// the literal must first appear exactly where the value ends. Asked
/// in OCTETS, because that is what the scan will ask.
fn unmoved(mut cx: LowerCx, value: Reg, piece: string) -> Reg {
    let joined = cx.str_concat(Type.Str, value, cx.const_str(piece))
    let octets = cx.bytes_of_str(Type.Bytes, joined)
    let needle = literal(cx, piece)
    let zero = cx.const_int(0)
    let at = cx.bytes_index_of(Type.Int, octets, needle, zero)
    let width = cx.str_len(Type.Int, value)
    cx.bin(Type.Bool, BinOp.Eq, at, width)
}

/// The literals and the values, alternating, joined once — the head,
/// then each hole's text and the literal that follows it.
fn woven(mut cx: LowerCx, read: GrammarSpec, fields: List<Reg>) -> Reg {
    mut pieces = [cx.const_str(read.head)]
    // LICENSED rule.loops.push_loop: the pieces must be EMITTED in order, each minting its own register
    for i, part in read.parts {
        pieces.push(fields[i])
        pieces.push(cx.const_str(part.piece))
    }
    glued(cx, pieces)
}

/// Text registers joined into one, in the order they were minted.
fn glued(mut cx: LowerCx, pieces: List<Reg>) -> Reg {
    let size = cx.box_size(pieces.length)
    let arr = cx.grown_box(cx.view.types.shape_of(cx.type(List<string>)), size, pieces)
    let sep = cx.const_str("")
    cx.str_join(Type.Str, arr, sep)
}

