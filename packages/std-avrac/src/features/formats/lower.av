//! THE SCAN, emitted. One anchored left-to-right pass over the
//! subject's octets: the head is a prefix, the last piece a suffix,
//! and every piece between them is found at the FIRST position at or
//! after the cursor. No backtracking, so the emitted code is linear
//! in the subject.
//!
//! Every step is a LAZY REGION over the verdict so far, as an enum
//! pattern's payload tests are: a step after a failure never runs,
//! which is what keeps a cursor past the end away from `index_of`,
//! whose `from` traps. The spans land in cells the steps write, and
//! the values are cut from them afterwards.
//!
//! The walk is EMITTED ONCE. `pat_accepts` runs it and leaves the
//! octets and the span cells in the pattern's test slot; `pat_binds`
//! reads them back and cuts the values inside the arm's region, so
//! an untaken arm mints no managed value at all.
use core.{Reg, Ins, PatId, ExprId, Type, TypeId, BinOp, FormatPart, GrammarSpec, binds}
use features.{LowerCx, MethodCall, const_int, const_bool, open_region, arm_end, close_region, close_region_as, seeded_cell, box_size, grown_box, adopted, absent_of, carried_type, carried_of, open_presence, field_read, lower_defect}

/// Whether the subject matches. The walk's octets and span cells are
/// left in the pattern's slot for the binds — written once here,
/// read once there.
export fn format_accepts(mut cx: LowerCx, p: PatId, head: string, parts: List<FormatPart>, v: Reg, vty: TypeId) -> Reg {
    let w = walked(cx, head, parts, v, vty)
    cx.bind_test(p, [w.subject].concat(w.spans))
    w.ok
}

/// The values the holes bind, in order, skipping the holes that bind
/// nothing — the same order `pattern_binds` answers. The spans were
/// found by the test; only the cutting happens here, which is what
/// keeps an untaken arm free of allocation.
export fn format_binds(mut cx: LowerCx, p: PatId, parts: List<FormatPart>, v: Reg, vty: TypeId) -> List<Reg> {
    let regs = cx.test_regs_of(p)
    if regs.length != 1 + 2 * parts.length { return untested(cx) }
    mut out: List<Reg> = []
    // LICENSED I3: the cuts must be EMITTED in hole order, each minting its own answer
    for i, part in parts {
        if binds(part.hole) { out.push(cut(cx, regs[0], regs[1 + 2 * i], regs[2 + 2 * i], v, vty)) }
    }
    out
}

/// The test runs before the binds and leaves the spans behind, so an
/// empty slot means the seam called them out of order.
fn untested(mut cx: LowerCx) -> List<Reg> {
    cx.defect("a format's binds were asked before its test found the spans")
    []
}

/// A walk's result: the verdict, the octets it read, and the span
/// cells — a lo and a hi per hole, in hole order.
type Walked = { ok: Reg, subject: Reg, spans: List<Reg> }

fn walked(mut cx: LowerCx, head: string, parts: List<FormatPart>, v: Reg, vty: TypeId) -> Walked {
    let subject = octets(cx, v, vty)
    let len = measured(cx, subject)
    let int_ty = cx.view.types.intern(Type.Int)
    let last = parts.last()!.piece
    let stop = seeded_cell(cx, int_ty, minus(cx, len, const_int(cx, byte_length(last))))
    let cur = seeded_cell(cx, int_ty, const_int(cx, byte_length(head)))
    mut spans: List<Reg> = []
    // LICENSED I3: a lo and a hi per hole, minted in hole order before any step writes one
    for part in parts {
        spans.push(seeded_cell(cx, int_ty, const_int(cx, 0)))
        spans.push(seeded_cell(cx, int_ty, const_int(cx, 0)))
    }
    let w = Walked { ok: anchored(cx, subject, len, head, last), subject: subject, spans: spans }
    w with { ok: spanned(cx, w, parts, cur, stop, 0) }
}

/// THE TWO ANCHORS, before any cursor moves: the value is long
/// enough to hold the head and the last piece without them
/// overlapping, the head is a prefix, and the last piece a suffix.
fn anchored(mut cx: LowerCx, subject: Reg, len: Reg, head: string, last: string) -> Reg {
    let need = const_int(cx, byte_length(head) + byte_length(last))
    let room = cx.mint_shape(Type.Bool)
    cx.emit(Ins.Bin(room, BinOp.Ge, len, need))
    open_region(cx, room)
    let zero = const_int(cx, 0)
    let hlen = const_int(cx, byte_length(head))
    arm_end(cx, at_span(cx, subject, zero, hlen, head))
    let short = const_bool(cx, false)
    let prefix = close_region_as(cx, cx.view.types.intern(Type.Bool), short)
    open_region(cx, prefix)
    arm_end(cx, tail_span(cx, subject, len, last))
    let no = const_bool(cx, false)
    close_region_as(cx, cx.view.types.intern(Type.Bool), no)
}

/// SPAN I, inside the verdict so far. A skipped step answers false,
/// so the chain short-circuits and no later call reads the cursor.
fn spanned(mut cx: LowerCx, w: Walked, parts: List<FormatPart>, cur: Reg, stop: Reg, i: int) -> Reg {
    if i == parts.length { return w.ok }
    open_region(cx, w.ok)
    arm_end(cx, if i == parts.length - 1 { last_span(cx, w, i, cur, stop) } else { next_span(cx, w, i, cur, parts[i].piece) })
    let no = const_bool(cx, false)
    spanned(cx, w with { ok: close_region_as(cx, cx.view.types.intern(Type.Bool), no) }, parts, cur, stop, i + 1)
}

/// An INTERIOR hole's span: it begins at the cursor and ends where
/// the literal after it is first found at or after the cursor; the
/// cursor then moves past that literal. Absent, and the arm fails.
fn next_span(mut cx: LowerCx, w: Walked, i: int, cur: Reg, piece: string) -> Reg {
    let from = loaded_from(cx, cur)
    cx.emit(Ins.Store(w.spans[2 * i], from))
    let needle = literal(cx, piece)
    let found = cx.mint_shape(Type.Int)
    cx.emit(Ins.CallRt(found, "avra_bytes_index_of", [w.subject, needle, from]))
    cx.emit(Ins.Store(w.spans[2 * i + 1], found))
    let width = const_int(cx, byte_length(piece))
    cx.emit(Ins.Store(cur, plus(cx, found, width)))
    let zero = const_int(cx, 0)
    let hit = cx.mint_shape(Type.Bool)
    cx.emit(Ins.Bin(hit, BinOp.Ge, found, zero))
    hit
}

/// The LAST hole's span runs from the cursor to the suffix's start,
/// and the arm fails when the cursor has already passed it.
fn last_span(mut cx: LowerCx, w: Walked, i: int, cur: Reg, stop: Reg) -> Reg {
    let from = loaded_from(cx, cur)
    let upto = loaded_from(cx, stop)
    cx.emit(Ins.Store(w.spans[2 * i], from))
    cx.emit(Ins.Store(w.spans[2 * i + 1], upto))
    let room = cx.mint_shape(Type.Bool)
    cx.emit(Ins.Bin(room, BinOp.Le, from, upto))
    room
}

/// One hole's value: the span, as octets when the subject is octets
/// and as text when it is text. A text span is cut from the ORIGINAL
/// string, whose byte positions the octets share, so nothing is
/// re-validated and no copy is made twice.
fn cut(mut cx: LowerCx, subject: Reg, lo_cell: Reg, hi_cell: Reg, v: Reg, vty: TypeId) -> Reg {
    let lo = loaded_from(cx, lo_cell)
    let hi = loaded_from(cx, hi_cell)
    if cx.view.types.shape_of(vty) is .Bytes {
        let out = cx.mint_shape(Type.Bytes)
        cx.emit(Ins.CallRt(out, "avra_bytes_slice", [subject, lo, hi]))
        return out
    }
    let out = cx.mint_shape(Type.Str)
    cx.emit(Ins.CallRt(out, "avra_str_substring", [v, lo, hi]))
    out
}

// ── The small verbs ─────────────────────────────────────────────

/// The subject as octets — a `Bytes` already is; a `string` is
/// copied once, which is what buys a NUL-exact scan over text whose
/// C-string primitives are not.
fn octets(mut cx: LowerCx, v: Reg, vty: TypeId) -> Reg {
    if cx.view.types.shape_of(vty) is .Bytes { return v }
    rt1(cx, Type.Bytes, "avra_bytes_of_str", v)
}

fn measured(mut cx: LowerCx, subject: Reg) -> Reg {
    rt1(cx, Type.Int, "avra_bytes_len", subject)
}

/// Whether `lo..hi` of the subject is this literal.
fn at_span(mut cx: LowerCx, subject: Reg, lo: Reg, hi: Reg, text: string) -> Reg {
    let needle = literal(cx, text)
    let same = cx.mint_shape(Type.Bool)
    cx.emit(Ins.CallRt(same, "avra_bytes_eq_at", [subject, lo, hi, needle]))
    same
}

/// The last piece sits at the end: `len - |piece|` up to `len`.
fn tail_span(mut cx: LowerCx, subject: Reg, len: Reg, last: string) -> Reg {
    at_span(cx, subject, minus(cx, len, const_int(cx, byte_length(last))), len, last)
}

/// A literal as octets. The conversion runs per attempt: the IR
/// carries no constant of this shape to hoist it into.
fn literal(mut cx: LowerCx, text: string) -> Reg {
    rt1(cx, Type.Bytes, "avra_bytes_of_str", text_const(cx, text))
}

/// A literal's length in OCTETS, which is what the scan counts.
fn byte_length(text: string) -> int {
    text.bytes().length
}

fn loaded_from(mut cx: LowerCx, cell: Reg) -> Reg {
    let v = cx.mint_shape(Type.Int)
    cx.emit(Ins.Load(v, cell))
    v
}

fn plus(mut cx: LowerCx, a: Reg, b: Reg) -> Reg {
    let r = cx.mint_shape(Type.Int)
    cx.emit(Ins.Bin(r, BinOp.Add, a, b))
    r
}

fn minus(mut cx: LowerCx, a: Reg, b: Reg) -> Reg {
    let r = cx.mint_shape(Type.Int)
    cx.emit(Ins.Bin(r, BinOp.Sub, a, b))
    r
}

// ── The doors a grammar declares ────────────────────────────────

/// `Name.parse(text)` — the SAME walk the pattern emits, and then
/// the record its holes name, or absence. No format exists at run
/// time: the declaration's spec is read here, at compile time.
export fn lower_parse(mut cx: LowerCx, mc: MethodCall) -> Reg {
    let found: GrammarSpec? = grammar_at(cx, mc.subject)
    if found == null { return doorless(cx, mc.e) }
    let read = found!
    let want = cx.type_at(mc.e)
    if cx.view.types.shape_of(cx.type_at(mc.args[0])) is .Bytes { return from_octets(cx, mc, read, want) }
    read_into(cx, read, cx.reg_of(mc.args[0]), want)
}

/// OCTETS become text ONCE, at the door: a span that is not UTF-8
/// cannot fill a record whose fields are text, and validating the
/// whole target beats validating each capture. Absence here means the
/// same thing absence always means — this grammar does not read that.
fn from_octets(mut cx: LowerCx, mc: MethodCall, read: GrammarSpec, want: TypeId) -> Reg {
    let str_opt = cx.view.types.intern(Type.Opt(cx.view.types.intern(Type.Str)))
    // the argument lowers FIRST: `reg_of` may mint, and an answer
    // minted before it would define out of order (I29)
    let octets = cx.reg_of(mc.args[0])
    let crossed = cx.mint_ty(str_opt)
    cx.emit(Ins.CallRt(crossed, "avra_str_of_bytes", [octets]))
    open_presence(cx, crossed, str_opt)
    arm_end(cx, read_into(cx, read, carried_of(cx, crossed, str_opt), want))
    let none = absent_of(cx, want)
    close_region(cx, mc.e, none)
}

/// The scan over text in hand, and the record it fills.
fn read_into(mut cx: LowerCx, read: GrammarSpec, text: Reg, want: TypeId) -> Reg {
    let w = walked(cx, read.head, read.parts, text, cx.view.types.intern(Type.Str))
    open_region(cx, w.ok)
    arm_end(cx, adopted(cx, want, false, gathered(cx, w, read.parts, text, want)))
    let none = absent_of(cx, want)
    close_region_as(cx, want, none)
}

/// The record the holes fill, slot by slot in declaration order —
/// which is hole order, because the fields ARE the holes.
fn gathered(mut cx: LowerCx, w: Walked, parts: List<FormatPart>, text: Reg, want: TypeId) -> Reg {
    let held = carried_type(cx, want)
    mut slots: List<Reg> = []
    // LICENSED I3: the cuts must be EMITTED in hole order, each minting its own answer
    for i, part in parts {
        if binds(part.hole) { slots.push(cut(cx, w.subject, w.spans[2 * i], w.spans[2 * i + 1], text, cx.view.types.intern(Type.Str))) }
    }
    let size = box_size(cx, slots.length)
    let dst = cx.mint_ty(held)
    grown_box(cx, dst, size, slots)
    dst
}

/// A door's format lives on its DECLARATION, so a door reached
/// without one is the admission rule broken.
fn doorless(mut cx: LowerCx, e: ExprId) -> Reg {
    lower_defect(cx, e, "a grammar door without its declaration survived typing")
}

/// The grammar a type-name receiver stands for.
fn grammar_at(cx: LowerCx, subject: ExprId) -> GrammarSpec? {
    match cx.view.types.shape_of(cx.type_at(subject)) {
        .TypeName(decl, _) -> cx.view.decls.grammar_of(decl),
        rest -> null,
    }
}

/// `Name.print(r)` — the record's fields woven back between the
/// format's literals, or absence when a value would not survive the
/// round trip. THE DOMAIN, checked here because it is a property of
/// the VALUES and not of the format: an interior hole's text, with
/// its following literal appended, must place that literal at the
/// boundary and nowhere earlier. A value ENDING IN a proper prefix of
/// its delimiter overlaps it and would move its own split; `contains`
/// cannot see that, and the scan can.
export fn lower_print(mut cx: LowerCx, mc: MethodCall) -> Reg {
    let found: GrammarSpec? = grammar_at(cx, mc.subject)
    if found == null { return doorless(cx, mc.e) }
    let read = found!
    let fields = read_fields(cx, mc.args[0], read.parts)
    let want = cx.type_at(mc.e)
    open_region(cx, survives(cx, read.parts, fields, 0))
    arm_end(cx, adopted(cx, want, false, woven(cx, read, fields)))
    let none = absent_of(cx, want)
    close_region(cx, mc.e, none)
}

/// Every hole's value, read from the record in hole order — the same
/// order the fields were declared in, because the fields ARE the holes.
fn read_fields(mut cx: LowerCx, subject: ExprId, parts: List<FormatPart>) -> List<Reg> {
    let v = cx.reg_of(subject)
    let vty = cx.type_at(subject)
    let str_ty = cx.view.types.intern(Type.Str)
    mut out: List<Reg> = []
    // LICENSED I3: the reads must be EMITTED in slot order, each minting its own answer
    for i, part in parts {
        out.push(field_read(cx, v, vty, i, str_ty))
    }
    out
}

/// WHETHER THE VALUES SURVIVE, hole by hole, as a lazy chain: a later
/// check runs only while the earlier ones hold. The LAST hole carries
/// no condition — the suffix anchor fixes its end positionally.
fn survives(mut cx: LowerCx, parts: List<FormatPart>, fields: List<Reg>, i: int) -> Reg {
    if i >= parts.length - 1 { return const_bool(cx, true) }
    let here = unmoved(cx, fields[i], parts[i].piece)
    open_region(cx, here)
    arm_end(cx, survives(cx, parts, fields, i + 1))
    let no = const_bool(cx, false)
    close_region_as(cx, cx.view.types.intern(Type.Bool), no)
}

/// One hole's value against the literal that follows it: appended,
/// the literal must first appear exactly where the value ends. Asked
/// in OCTETS, because that is what the scan will ask.
fn unmoved(mut cx: LowerCx, value: Reg, piece: string) -> Reg {
    let joined = rt2(cx, Type.Str, "avra_str_concat", value, text_const(cx, piece))
    let octets = rt1(cx, Type.Bytes, "avra_bytes_of_str", joined)
    let needle = literal(cx, piece)
    let zero = const_int(cx, 0)
    let at = cx.mint_shape(Type.Int)
    cx.emit(Ins.CallRt(at, "avra_bytes_index_of", [octets, needle, zero]))
    let width = rt1(cx, Type.Int, "avra_str_len", value)
    let same = cx.mint_shape(Type.Bool)
    cx.emit(Ins.Bin(same, BinOp.Eq, at, width))
    same
}

/// The literals and the values, alternating, joined once — the head,
/// then each hole's text and the literal that follows it.
fn woven(mut cx: LowerCx, read: GrammarSpec, fields: List<Reg>) -> Reg {
    mut pieces = [text_const(cx, read.head)]
    // LICENSED I3: the pieces must be EMITTED in order, each minting its own register
    for i, part in read.parts {
        pieces.push(fields[i])
        pieces.push(text_const(cx, part.piece))
    }
    let size = box_size(cx, pieces.length)
    let arr = cx.mint_ty(cx.view.types.intern(Type.List(cx.view.types.intern(Type.Str))))
    grown_box(cx, arr, size, pieces)
    let sep = text_const(cx, "")
    let dst = cx.mint_shape(Type.Str)
    cx.emit(Ins.CallRt(dst, "avra_str_join", [arr, sep]))
    dst
}

fn text_const(mut cx: LowerCx, text: string) -> Reg {
    let r = cx.mint_shape(Type.Str)
    cx.emit(Ins.ConstStr(r, text))
    r
}

fn rt1(mut cx: LowerCx, sh: Type, callee: string, a: Reg) -> Reg {
    let r = cx.mint_shape(sh)
    cx.emit(Ins.CallRt(r, callee, [a]))
    r
}

fn rt2(mut cx: LowerCx, sh: Type, callee: string, a: Reg, b: Reg) -> Reg {
    let r = cx.mint_shape(sh)
    cx.emit(Ins.CallRt(r, callee, [a, b]))
    r
}
