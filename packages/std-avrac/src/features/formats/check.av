//! The format laws: a format reads TEXT; two holes need a literal
//! between them; one name binds one span; and a typed hole reads its
//! span as a type text reads as — `string` or `int`. The two laws over the holes are
//! re-derived from the node by the reader's own functions, so the
//! literal and the pattern it became are judged once.
use core.{PatId, Type, TypeId, FormatPart, binds}
use features.{TypeCx, MethodCall, this_is}
use features.formats.{adjacent_fault, repeated_fault, Fault, Reads, reads_of}
use diagnostics.{Voice, refusal, said_as}

/// THE FORMAT LAW: the subject is text, the holes are separable and
/// distinctly named, and each hole binds the span it takes — as
/// text over a `string`, as octets over a `Bytes`, or as the `int`
/// a typed hole reads it as.
export fn format_types(mut cx: TypeCx, p: PatId, parts: List<FormatPart>, expected: TypeId) -> List<
    TypeId,
> {
    let span? = span_type(cx, expected) else { return not_text(cx, p, expected) }
    let shape: Fault? = adjacent_fault(parts) ?? repeated_fault(parts)
    if shape != null { return broken(cx, p, shape!) }
    let unread: FormatPart? = parts.find(reads_of(it.hole) == null)
    if unread != null { return unparsed(cx, p, unread!) }
    [bound_type(cx, reads_of(part.hole)!, span) for part in parts if binds(part.hole)]
}

/// What a hole binds: its span, or the int it reads.
fn bound_type(cx: TypeCx, r: Reads, span: TypeId) -> TypeId {
    match r { .Text -> span, .Int -> cx.type(int) }
}

/// What a hole's span IS, by what the subject is made of; absence
/// when the subject is neither.
fn span_type(cx: TypeCx, expected: TypeId) -> TypeId? {
    match cx.view.types.seen_shape(expected) {
        .Str -> cx.type(string),
        .Bytes -> cx.type(Bytes),
        rest -> null,
    }
}

// ── The voices ──────────────────────────────────────────────────

fn not_text(mut cx: TypeCx, p: PatId, expected: TypeId) -> List<TypeId> {
    cx.emit(said_as("type.format", cx.pat_loc(p), format_on(cx.view.types.name_of(expected))))
    []
}

/// A format pattern matching a value of `found`, which is no text.
export fn format_on(found: string) -> Voice {
    Voice {
        message: "a format pattern reads text, found `${found}`",
        label: this_is(found),
        help: "a format matches a `string` or a `Bytes`",
    }
}

/// The two laws over the holes, each in its own words.
fn broken(mut cx: TypeCx, p: PatId, fault: Fault) -> List<TypeId> {
    match fault {
        .Adjacent(a, b) -> adjacent(cx, p, a, b),
        .Repeated(n) -> repeated(cx, p, n),
        .Unclosed(_) or .Stray(_) or .Malformed(_, _) -> [],
    }
}

fn adjacent(mut cx: TypeCx, p: PatId, a: string, b: string) -> List<TypeId> {
    cx.emit(said_as("type.format_shape", cx.pat_loc(p), holes_adjacent(a, b)))
    []
}

fn repeated(mut cx: TypeCx, p: PatId, n: string) -> List<TypeId> {
    cx.emit(said_as("type.format_repeat", cx.pat_loc(p), hole_repeated(n)))
    []
}

/// Two holes of a format with no literal between them.
export fn holes_adjacent(a: string, b: string) -> Voice {
    Voice {
        message: "`{${a}}` and `{${b}}` have nothing between them",
        label: "here",
        help: "a scan needs a literal to stop at — put one between the holes",
    }
}

/// A name a format binds twice.
export fn hole_repeated(n: string) -> Voice {
    Voice {
        message: "`${n}` names two spans of this format",
        label: "written twice",
        help: "rename one, or write `{_}` for a span you do not need",
    }
}

fn unparsed(mut cx: TypeCx, p: PatId, part: FormatPart) -> List<TypeId> {
    cx
        .emit(
            said_as(
                "type.format_parse",
                cx.pat_loc(p),
                hole_unread(part.hole.name, part.hole.ty!.name),
            ),
        )
    []
}

/// A format's hole `name` reading its span as `ty`, which text doesn't read as.
export fn hole_unread(name: string, ty: string) -> Voice {
    Voice {
        message: "`{${name}: ${ty}}` reads its span as `${ty}`, and a hole reads text as `string` or `int`",
        label: "here",
        help: "take the span as text and convert it in the arm",
    }
}

// ── The doors a grammar declares ────────────────────────────────

/// A type name is a CALL only on a grammar, so this row's receiver
/// is the type NAME itself — the admission rule in `callee_of` is
/// what keeps every other type name a construction.
export fn on_grammar(t: Type) -> bool {
    t is .TypeName
}

/// `Name.parse(text)` — the text this grammar reads, or absence. The
/// answer is the RECORD the declaration's holes became.
export fn check_parse(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let named? = record_of(cx, cx.type_at(mc.subject)) else { return cx.error_type }
    cx.worded(mc, "parse", [read_seat(cx, mc)], Type.Opt(named))
}

/// `Name.parse_octets(octets)` — what this grammar reads of octets, or absence; octets that are not
/// UTF-8 answer absence.
export fn check_parse_octets(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let named? = record_of(cx, cx.type_at(mc.subject)) else { return cx.error_type }
    cx.worded(mc, "parse_octets", [Type.Bytes], Type.Opt(named))
}

/// RECORDED TRIGGER: `parse` taking octets is the old path's door alone; every caller in the tree
/// hands octets to `parse_octets`, and this seat goes with the old path.
/// ONE DOOR, TWO SEATS: a grammar reads TEXT, or the OCTETS the text
/// was framed from. A router holds a span and never had a string; a
/// test holds a string and never had a span. The seat follows what
/// the caller has, and octets that are not UTF-8 answer absence like
/// any other target this grammar cannot read.
fn read_seat(mut cx: TypeCx, mc: MethodCall) -> Type {
    if mc.args.length != 1 { return Type.Str }
    if cx.seen_at(mc.args[0]) is .Bytes { return Type.Bytes }
    Type.Str
}

/// The record a type name's declaration stands for.
fn record_of(cx: TypeCx, ty: TypeId) -> TypeId? {
    match cx.view.types.shape_of(ty) {
        .TypeName(decl, tname) -> cx.view.types.intern(Type.Struct(decl, tname)),
        rest -> null,
    }
}

/// `Name.print(r)` — the text this grammar reads back, or absence
/// when a value would not survive the round trip. The seat is the
/// RECORD the declaration's holes became; the answer is its text.
export fn check_print(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let named? = record_of(cx, cx.type_at(mc.subject)) else { return cx.error_type }
    if !cx.seated(mc, "print", [named]) { return cx.error_type }
    cx.type(string?)
}

/// `Name.pattern()` — the format this grammar reads, spelled as it is
/// written: what a router indexes by.
export fn check_pattern(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    if record_of(cx, cx.type_at(mc.subject)) == null { return cx.error_type }
    cx.worded(mc, "pattern", [], Type.Str)
}
