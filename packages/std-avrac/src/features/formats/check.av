//! The format laws: a format reads TEXT; two holes need a literal
//! between them; one name binds one span; and a typed hole parses
//! through a type that reads text. The two laws over the holes are
//! re-derived from the node by the reader's own functions, so the
//! literal and the pattern it became are judged once.
use core.{PatId, Type, TypeId, FormatPart, bound_names}
use features.{TypeCx, MethodCall, this_is}
use features.formats.{adjacent_fault, repeated_fault, Fault}
use diagnostics.{refusal}

/// THE FORMAT LAW: the subject is text, the holes are separable and
/// distinctly named, and each hole binds the span it takes — as
/// text over a `string`, as octets over a `Bytes`.
export fn format_types(mut cx: TypeCx, p: PatId, parts: List<FormatPart>, expected: TypeId) -> List<TypeId> {
    let span? = span_type(cx, expected) else { return not_text(cx, p, expected) }
    let shape: Fault? = adjacent_fault(parts) ?? repeated_fault(parts)
    if shape != null { return broken(cx, p, shape!) }
    let typed: FormatPart? = parts.find(it.hole.ty != null)
    if typed != null { return unparsed(cx, p, typed!) }
    [span for n in bound_names(parts)]
}

/// What a hole's span IS, by what the subject is made of; absence
/// when the subject is neither.
fn span_type(mut cx: TypeCx, expected: TypeId) -> TypeId? {
    match cx.view.types.seen_shape(expected) {
        .Str -> cx.type(string),
        .Bytes -> cx.type(Bytes),
        rest -> null,
    }
}

// ── The voices ──────────────────────────────────────────────────

fn not_text(mut cx: TypeCx, p: PatId, expected: TypeId) -> List<TypeId> {
    let n = cx.view.types.name_of(expected)
    cx.emit(refusal("type.format", cx.pat_loc(p), "a format pattern reads text, found `${n}`", this_is(n), "a format matches a `string` or a `Bytes`"))
    []
}

/// The two laws over the holes, each in its own words.
fn broken(mut cx: TypeCx, p: PatId, fault: Fault) -> List<TypeId> {
    match fault {
        .Adjacent(a, b) -> adjacent(cx, p, a, b),
        .Repeated(n) -> repeated(cx, p, n),
        .Unclosed(_) or .Stray(_) or .Malformed(_, _) -> [],
    }
}

fn adjacent(mut cx: TypeCx, p: PatId, a: string, b: string) -> List<TypeId> {
    cx.emit(refusal("type.format_shape", cx.pat_loc(p), "`{${a}}` and `{${b}}` have nothing between them", "here", "a scan needs a literal to stop at — put one between the holes"))
    []
}

fn repeated(mut cx: TypeCx, p: PatId, n: string) -> List<TypeId> {
    cx.emit(refusal("type.format_repeat", cx.pat_loc(p), "`${n}` names two spans of this format", "written twice", "rename one, or write `{_}` for a span you do not need"))
    []
}

fn unparsed(mut cx: TypeCx, p: PatId, part: FormatPart) -> List<TypeId> {
    let n = part.hole.ty!.name
    cx.emit(refusal("type.format_parse", cx.pat_loc(p), "`{${part.hole.name}: ${n}}` parses its span, and nothing reads text as `${n}` yet", "here", "take the span as text and convert it in the arm — a typed hole waits on a shared decimal reader"))
    []
}

// ── The doors a grammar declares ────────────────────────────────

/// A type name is a CALL only on a grammar, so this row's receiver
/// is the type NAME itself — the admission rule in `callee_of` is
/// what keeps every other type name a construction.
export fn on_grammar(t: Type) -> bool {
    t is .TypeName
}

/// `Name.parse(text)` — the text this grammar reads, or absence. The
/// answer is the RECORD the declaration's holes became.
export fn check_parse(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let named? = record_of(cx, cx.type_at(mc.subject)) else { return cx.error_type }
    cx.worded(mc, "parse", [read_seat(cx, mc)], Type.Opt(named))
}

/// ONE DOOR, TWO SEATS: a grammar reads TEXT, or the OCTETS the text
/// was framed from. A router holds a span and never had a string; a
/// test holds a string and never had a span. The seat follows what
/// the caller has, and octets that are not UTF-8 answer absence like
/// any other target this grammar cannot read.
fn read_seat(mut cx: TypeCx, mc: MethodCall) -> Type {
    if mc.args.length != 1 { return Type.Str }
    if cx.seen_at(mc.args[0]) is .Bytes { return Type.Bytes }
    Type.Str
}

/// The record a type name's declaration stands for.
fn record_of(mut cx: TypeCx, ty: TypeId) -> TypeId? {
    match cx.view.types.shape_of(ty) {
        .TypeName(decl, tname) -> cx.view.types.intern(Type.Struct(decl, tname)),
        rest -> null,
    }
}

/// `Name.print(r)` — the text this grammar reads back, or absence
/// when a value would not survive the round trip. The seat is the
/// RECORD the declaration's holes became; the answer is its text.
export fn check_print(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let named? = record_of(cx, cx.type_at(mc.subject)) else { return cx.error_type }
    if !cx.seated(mc, "print", [named]) { return cx.error_type }
    cx.type(string?)
}
