//! Parse-time lowering: a row's cells ride a list node until the table
//! builder reads them; the node keeps the rows as written, and what it
//! means — a `Row { … }` literal per row, the header supplying the
//! field names — is minted beside it.
use core.{Expr}
use features.{LangNode, Builder}

fn build_table(b: Builder) -> Result<LangNode, string> {
    let named = b.token(0)?
    let row = named.text
    let header = [h.text for h in b.tokens(1)?]
    let rows = b.exprs(2)?
    let cells = [b.store.expr(r).elems_of() for r in rows]
    if cells.any(it == null) { return .Err("defect: a table row that is not a cell list") }
    let short = [j for j in 0..rows.length if cells[j]!.length != header.length].first()
    if short != null {
        return .Err(
            "row ${short! + 1} has ${cells[short!]!.length} cells, and the header names ${header.length} columns",
        )
    }
    let sugar = b.expr_node(Expr.Table(row, header, rows))
    let _ = b.store.mean(sugar, table_means(row), b.words.door)
    b.wrap_expr(sugar)
}

fn table_means(row: string) -> string {
    "`table<${row}>` means a list of `${row} { … }` literals, one per row"
}
