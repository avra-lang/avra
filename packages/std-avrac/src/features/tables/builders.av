//! Parse-time lowering: a row's cells ride a list node until the
//! table builder reads them back and rewrites every row as the row
//! type's struct literal — the header supplying the field names.
use core.{Expr, ExprId}
use features.{LangNode, Builder}

fn build_row(mut b: Builder) -> Result<LangNode, string> {
    b.make_expr(Expr.ListLit(b.exprs(0)?))
}

fn build_table(mut b: Builder) -> Result<LangNode, string> {
    let t = b.token(0)?
    let names = b.tokens(1)?
    let rows = b.exprs(2)?
    let row_type = t.text
    let header = [h.text for h in names]
    mut lits: List<ExprId> = []
    for j, r in rows {
        let held: List<ExprId>? = (b.store.expr(r)).elems_of()
        if held == null { return .Err("defect: a table row that is not a cell list") }
        let cells = held!
        if cells.length != header.length {
            return .Err("row ${j + 1} has ${cells.length} cells, and the header names ${header.length} columns")
        }
        lits.push(b.store.alloc_expr(Expr.StructLit(row_type, header, cells), b.store.expr_span(r)))
    }
    b.make_expr(Expr.ListLit(lits))
}
