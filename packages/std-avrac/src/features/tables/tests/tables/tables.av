// proves: tables — the manifest shape — as pure sugar: the header
// names the fields, every row is the row type's literal, cells are
// expressions (fn names included), and both engines read them back.
type Row = { name: string, n: int, on: bool }
type Op = { k: string, f: fn(int) -> int }
fn dbl(x: int) -> int {
    x * 2
}
fn inc(x: int) -> int {
    x + 1
}
let rows = [Row { name: "a", n: 1, on: true }, Row { name: "bb", n: 2, on: false }, Row { name: "ccc", n: 3, on: true }]
let ops = [Op { k: "dbl", f: dbl }, Op { k: "inc", f: inc }]
let t = 0
for r in rows {
    t = t + r.n + r.name.length
}
"${rows.length} ${rows[1].name} ${rows[2].on} ${t} ${ops[0].f(10)} ${ops[1].f(10)} ${ops.length}"
