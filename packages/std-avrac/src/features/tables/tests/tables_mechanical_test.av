        then "table < x > { \n x | x \n x | x } \n" { tolerates("table < x > { \n x | x \n x | x } \n") }
        then "| x" { tolerates("| x") }
        then "x x" { tolerates("x x") }
        then "x |" { tolerates("x |") }
        then "x x | x" { tolerates("x x | x") }
        then "x | | x" { tolerates("x | | x") }
        then "x | x x" { tolerates("x | x x") }
        then "| x x" { tolerates("| x x") }
        then "x x |" { tolerates("x x |") }
    }
    given "keyword-replace — must be diagnosed or a valid program" {
        then "table < x > { \n x | x \n x | x \n }" { tolerates("table < x > { \n x | x \n x | x \n }") }
        then "table table x > { \n x | x \n x | x \n }" { tolerates("table table x > { \n x | x \n x | x \n }") }
        then "table < table > { \n x | x \n x | x \n }" { tolerates("table < table > { \n x | x \n x | x \n }") }
        then "table < x table { \n x | x \n x | x \n }" { tolerates("table < x table { \n x | x \n x | x \n }") }
        then "table < x > table \n x | x \n x | x \n }" { tolerates("table < x > table \n x | x \n x | x \n }") }
        then "table < x > { table x | x \n x | x \n }" { tolerates("table < x > { table x | x \n x | x \n }") }
        then "table < x > { \n table | x \n x | x \n }" { tolerates("table < x > { \n table | x \n x | x \n }") }
        then "table < x > { \n x table x \n x | x \n }" { tolerates("table < x > { \n x table x \n x | x \n }") }
        then "table < x > { \n x | table \n x | x \n }" { tolerates("table < x > { \n x | table \n x | x \n }") }
        then "table < x > { \n x | x table x | x \n }" { tolerates("table < x > { \n x | x table x | x \n }") }
        then "table < x > { \n x | x \n table | x \n }" { tolerates("table < x > { \n x | x \n table | x \n }") }
