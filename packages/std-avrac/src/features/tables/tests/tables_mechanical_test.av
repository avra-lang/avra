// GENERATED by `avra attack tables` — the mechanical
// classes from the feature's rule and the model. A SEMANTIC
// attack belongs in the feature's hand-written test.
// cap: 500 case(s), 0 dropped.
use @std.avrac.compiler.{analyze_source}
use @std.avrac.diagnostics.{Diag}

/// The SHAPE parses — a canonical sample spells `x` where a name
/// belongs, so a TYPE error is expected and a PARSE error is not.
fn parses(src: string) -> bool {
    !analyze_source(src).diagnostics.any(parse_error)
}

fn parse_error(d: Diag) -> bool {
    d.kind.starts_with("parse.")
}

/// The compiler REACHES A VERDICT on a malformed surface — a
/// deletion can yield a valid program, so this law is tolerance,
/// not refusal; a trap is not a verdict and dies in the call.
fn tolerates(src: string) -> bool {
    let reached = analyze_source(src).diagnostics.length
    reached >= 0
}

spec "features/tables adversarial — mechanical" {
    given "degenerate shapes — a valid surface, and must stay valid" {
        then "table < x > { \n x \n x | x \n }" { parses("table < x > { \n x \n x | x \n }") == parses("table < x > { \n x | x \n x | x \n }") }
        then "table < x > { \n x | x | x \n x | x \n }" { parses("table < x > { \n x | x | x \n x | x \n }") == parses("table < x > { \n x | x \n x | x \n }") }
        then "table < x > { \n x | x \n }" { parses("table < x > { \n x | x \n }") == parses("table < x > { \n x | x \n x | x \n }") }
        then "table < x > { \n x | x \n x | x \n x | x \n }" { parses("table < x > { \n x | x \n x | x \n x | x \n }") == parses("table < x > { \n x | x \n x | x \n }") }
        then "x" { parses("x") == parses("x | x") }
        then "x | x | x" { parses("x | x | x") == parses("x | x") }
    }
    given "malformed surface (delete, duplicate, swap) — must be diagnosed" {
        then "< x > { \n x | x \n x | x \n }" { tolerates("< x > { \n x | x \n x | x \n }") }
        then "table x > { \n x | x \n x | x \n }" { tolerates("table x > { \n x | x \n x | x \n }") }
        then "table < > { \n x | x \n x | x \n }" { tolerates("table < > { \n x | x \n x | x \n }") }
        then "table < x { \n x | x \n x | x \n }" { tolerates("table < x { \n x | x \n x | x \n }") }
        then "table < x > \n x | x \n x | x \n }" { tolerates("table < x > \n x | x \n x | x \n }") }
        then "table < x > { x | x \n x | x \n }" { tolerates("table < x > { x | x \n x | x \n }") }
        then "table < x > { \n | x \n x | x \n }" { tolerates("table < x > { \n | x \n x | x \n }") }
        then "table < x > { \n x x \n x | x \n }" { tolerates("table < x > { \n x x \n x | x \n }") }
        then "table < x > { \n x | \n x | x \n }" { tolerates("table < x > { \n x | \n x | x \n }") }
        then "table < x > { \n x | x x | x \n }" { tolerates("table < x > { \n x | x x | x \n }") }
        then "table < x > { \n x | x \n | x \n }" { tolerates("table < x > { \n x | x \n | x \n }") }
        then "table < x > { \n x | x \n x x \n }" { tolerates("table < x > { \n x | x \n x x \n }") }
        then "table < x > { \n x | x \n x | \n }" { tolerates("table < x > { \n x | x \n x | \n }") }
        then "table < x > { \n x | x \n x | x }" { tolerates("table < x > { \n x | x \n x | x }") }
        then "table < x > { \n x | x \n x | x \n" { tolerates("table < x > { \n x | x \n x | x \n") }
        then "table table < x > { \n x | x \n x | x \n }" { tolerates("table table < x > { \n x | x \n x | x \n }") }
        then "table < < x > { \n x | x \n x | x \n }" { tolerates("table < < x > { \n x | x \n x | x \n }") }
        then "table < x x > { \n x | x \n x | x \n }" { tolerates("table < x x > { \n x | x \n x | x \n }") }
        then "table < x > > { \n x | x \n x | x \n }" { tolerates("table < x > > { \n x | x \n x | x \n }") }
        then "table < x > { { \n x | x \n x | x \n }" { tolerates("table < x > { { \n x | x \n x | x \n }") }
        then "table < x > { \n \n x | x \n x | x \n }" { tolerates("table < x > { \n \n x | x \n x | x \n }") }
        then "table < x > { \n x x | x \n x | x \n }" { tolerates("table < x > { \n x x | x \n x | x \n }") }
