//! Tables — `table<Row> { header | names \n cell | cell … }`: the
//! manifest shape. PURE SUGAR: the header names the row type's
//! fields and every row becomes a `Row { … }` literal, so the struct
//! literal's own laws judge each cell and the list's law the rows.
//! No node, no rule of its own — a builder.
use features.{LanguageFeature, BuilderRow}
use @std.grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
export fn tables() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name        | build
        "table_lit" | build_table
        "table_row" | build_row
    }
    LanguageFeature tables {
        gram: grammar {
            primary = "table" "<" t:NAME ">" "{" BREAK h:NAME ( "|" h:NAME )* BREAK ( r:table_row BREAK )* "}" @expect("}", "expected `}` to close the table, or a cell that stopped early — a cell is a value up to `+`, so `==`, `??`, `|>` and the bitwise operators need parentheses") -> table_lit(t, h, r)
            // A CELL PARSES BELOW THE BITWISE BAND. `|` is this
            // literal's column separator, so a cell that could
            // contain a bare `|` would eat its own row: `"x" | f`
            // read as one bitwise-or is a row of ONE cell where the
            // header names two. `additive` is the first level under
            // the band, and a cell that genuinely wants the whole
            // grammar parenthesises — `primary` takes `( … )`.
            table_row = c:additive ( "|" c:additive )* -> table_row(c)
        }
        builders: rows
    }
    tables
}
