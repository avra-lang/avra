//! A table's Meaning: the list of row literals it means.
use core.{ExprId, TypeId, Reg, Expr, Nominal, Plain, SyntaxArena}
use core.expr.{Table}
use features.{ResolveCx, TypeCx, LowerCx, MeanCx, nothing, Meaning}

impl Meaning for Table {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        let meant? = cx.view.store.meant(e) else { return cx.error_type }
        cx.type_at(meant)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        let meant? = cx.view.store.meant(e) else { return cx.lower_defect(e, "a sugar whose meaning was never minted") }
        cx.reg_of(meant)
    }
    fn minted(cx: MeanCx) -> Result<List<ExprId>, string> {
        let short: int? = self.rows.find_index(cells_of(cx.store, it).length != self.header.length)
        if short != null {
            return .Err(
                short_row_words(
                    short! + 1,
                    cells_of(cx.store, self.rows[short!]).length,
                    self.header.length,
                ),
            )
        }
        let lits = [row_literal(cx.store, self.row, self.header, r) for r in self.rows]
        .Ok(lits.concat([cx.store.alloc_expr(Expr.ListLit(lits), cx.span)]))
    }
}

/// One row as `Row { header: cell, … }`, spanned as the row was.
fn row_literal(store: SyntaxArena, row: string, header: List<string>, cells: ExprId) -> ExprId {
    let made = Expr.StructLit(Nominal(row), [Plain(h) for h in header], cells_of(store, cells))
    store.alloc_expr(made, store.expr_span(cells))
}

/// A row's cells, as the list node they were written in.
fn cells_of(store: SyntaxArena, row: ExprId) -> List<ExprId> {
    match store.expr(row) { .ListLit(cells) -> cells, rest -> [] }
}

// ── voices ──

fn short_row_words(row: int, cells: int, columns: int) -> string {
    "row ${row} has ${cells} cells, and the header names ${columns} columns"
}
