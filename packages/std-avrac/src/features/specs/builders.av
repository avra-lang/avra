//! Parse-time lowering: a `given` names every case under it (a `then`
//! is its rule's `Record.Case`, with no group yet).
use features.{LangNode, Builder, cases_at}

fn build_given(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    .Ok(LangNode.NCases([c with { group: n.text } for c in cases_at(b.args, 1)]))
}
