//! The spec's statement semantics: its cases resolve as bodies under
//! the file's floor, each group naming its cases once; typing and
//! lowering reach the cases as declarations, so the statement itself
//! does nothing there.
use core.{StmtId, Case, distinct, flatten}
use core.stmt.{Spec}
use features.{StmtSemantics, ResolveCx, nothing, duplicate_names}
use diagnostics.{Diag}
use @std.errors.{Loc}

impl StmtSemantics for Spec {
    fn resolve_stmt(mut cx: ResolveCx, s: StmtId) { SpecSemantics {}.resolve_stmt(cx, s) }
}

export type SpecSemantics = {}

impl StmtSemantics for SpecSemantics {
    fn resolve_stmt(mut cx: ResolveCx, s: StmtId) {
        if cx.refuses_nested(s, "resolve.nested_spec", "spec blocks") { return }
        match cx.view.store.stmt(s) {
            .Spec(name, cases) -> {
                for d in repeated_cases(name, cases, cx.stmt_loc(s)) { cx.emit(d) }
                for c in cases { cx.walk_under([], c.body) }
            },
            _ -> nothing(),
        }
    }

}

/// A case named twice within one group — the shared member voice,
/// the group named as the owner.
fn repeated_cases(suite: string, cases: List<Case>, at: Loc?) -> List<Diag> {
    flatten(
        [duplicate_names(
            "resolve.duplicate_case",
            "${suite} / ${g}",
            [c.name for c in cases if c.group == g],
            at,
        ) for g in distinct([c.group for c in cases])],
    )
}
