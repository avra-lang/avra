//! The case law: a `then` answers the bool it declared, judged by
//! the one door every slot uses.
use core.{ExprId, TypeId}
use features.{TypeCx}
use diagnostics.{Diag, refusal}

/// The body's answer agrees with the declared bool.
export fn fits_case(mut cx: TypeCx, root: ExprId, want: TypeId) {
    if cx.accepts(root, want) { return }
    cx.emit(case_answers(cx, root, cx.name_at(root)))
}

// ── voices ──

fn case_answers(cx: TypeCx, root: ExprId, got: string) -> Diag {
    refusal(
        "type.case",
        cx.loc_of(root),
        case_answers_said(got),
        CASE_ANSWER_LABEL,
        CASE_ANSWER_HELP,
    )
}

/// What a `then` whose answer is `got` rather than a `bool` is told.
export fn case_answers_said(got: string) -> string { "a `then` answers a `bool`, this one answers `${got}`" }

/// Where a case's refused answer is pointed at.
export const CASE_ANSWER_LABEL: string = "the case's answer"

/// What a case whose answer isn't a `bool` is helped to.
export const CASE_ANSWER_HELP: string = "end the case with the condition it proves"
