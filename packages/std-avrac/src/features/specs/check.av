//! The case law: a `then` answers the bool it declared, judged by
//! the one door every slot uses.
use core.{ExprId, TypeId}
use features.{TypeCx, accepts}
use diagnostics.{Diag, refusal}

/// The body's answer agrees with the declared bool.
export fn fits_case(mut cx: TypeCx, root: ExprId, want: TypeId) {
    if accepts(cx, root, want) { return }
    cx.emit(case_answers(cx, root, cx.name_at(root)))
}

// ── voices ──

fn case_answers(cx: TypeCx, root: ExprId, got: string) -> Diag {
    refusal("type.case", cx.loc_of(root), "a `then` answers a `bool`, this one answers `${got}`", "the case's answer", "end the case with the condition it proves")
}
