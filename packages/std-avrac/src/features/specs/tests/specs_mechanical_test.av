// GENERATED by `avra attack specs` — the mechanical
// classes from the feature's rule and the model. A SEMANTIC
// attack belongs in the feature's hand-written test.
// cap: 500 case(s), 0 dropped.
use @std.avrac.compiler.{analyze_source}
use @std.avrac.diagnostics.{Diag}

/// The SHAPE parses — a canonical sample spells `x` where a name
/// belongs, so a TYPE error is expected and a PARSE error is not.
fn parses(src: string) -> bool {
    !analyze_source(src).diagnostics.any(parse_error)
}

fn parse_error(d: Diag) -> bool {
    d.kind.starts_with("parse.")
}

/// The compiler REACHES A VERDICT on a malformed surface — a
/// deletion can yield a valid program, so this law is tolerance,
/// not refusal; a trap is not a verdict and dies in the call.
fn tolerates(src: string) -> bool {
    let reached = analyze_source(src).diagnostics.length
    reached >= 0
}

spec "features/specs adversarial — mechanical" {
    given "degenerate shapes — a valid surface, and must stay valid" {
        then "spec \"s\" { } \n" { parses("spec \"s\" { } \n") == parses("spec \"s\" { \n } \n") }
        then "given \"s\" { }" { parses("given \"s\" { }") == parses("given \"s\" { \n }") }
    }
    given "malformed surface — must be diagnosed" {
        then "\"s\" { \n } \n" { tolerates("\"s\" { \n } \n") }
        then "spec { \n } \n" { tolerates("spec { \n } \n") }
        then "spec \"s\" \n } \n" { tolerates("spec \"s\" \n } \n") }
        then "spec \"s\" { \n \n" { tolerates("spec \"s\" { \n \n") }
        then "spec \"s\" { \n }" { tolerates("spec \"s\" { \n }") }
        then "spec spec \"s\" { \n } \n" { tolerates("spec spec \"s\" { \n } \n") }
        then "spec \"s\" \"s\" { \n } \n" { tolerates("spec \"s\" \"s\" { \n } \n") }
        then "spec \"s\" { { \n } \n" { tolerates("spec \"s\" { { \n } \n") }
        then "spec \"s\" { \n \n } \n" { tolerates("spec \"s\" { \n \n } \n") }
        then "spec \"s\" { \n } } \n" { tolerates("spec \"s\" { \n } } \n") }
        then "spec \"s\" { \n } \n \n" { tolerates("spec \"s\" { \n } \n \n") }
        then "\"s\" spec { \n } \n" { tolerates("\"s\" spec { \n } \n") }
        then "spec { \"s\" \n } \n" { tolerates("spec { \"s\" \n } \n") }
        then "spec \"s\" \n { } \n" { tolerates("spec \"s\" \n { } \n") }
        then "spec \"s\" { } \n \n" { tolerates("spec \"s\" { } \n \n") }
        then "spec \"s\" { \n \n }" { tolerates("spec \"s\" { \n \n }") }
        then "\"s\" { \n }" { tolerates("\"s\" { \n }") }
        then "given { \n }" { tolerates("given { \n }") }
        then "given \"s\" \n }" { tolerates("given \"s\" \n }") }
        then "given \"s\" { \n" { tolerates("given \"s\" { \n") }
        then "given given \"s\" { \n }" { tolerates("given given \"s\" { \n }") }
        then "given \"s\" \"s\" { \n }" { tolerates("given \"s\" \"s\" { \n }") }
        then "given \"s\" { { \n }" { tolerates("given \"s\" { { \n }") }
        then "given \"s\" { \n \n }" { tolerates("given \"s\" { \n \n }") }
        then "given \"s\" { \n } }" { tolerates("given \"s\" { \n } }") }
        then "\"s\" given { \n }" { tolerates("\"s\" given { \n }") }
        then "given { \"s\" \n }" { tolerates("given { \"s\" \n }") }
        then "given \"s\" \n { }" { tolerates("given \"s\" \n { }") }
        then "given \"s\" { } \n" { tolerates("given \"s\" { } \n") }
        then "\"s\" x" { tolerates("\"s\" x") }
        then "then x" { tolerates("then x") }
        then "then \"s\"" { tolerates("then \"s\"") }
        then "then then \"s\" x" { tolerates("then then \"s\" x") }
        then "then \"s\" \"s\" x" { tolerates("then \"s\" \"s\" x") }
        then "then \"s\" x x" { tolerates("then \"s\" x x") }
        then "\"s\" then x" { tolerates("\"s\" then x") }
        then "then x \"s\"" { tolerates("then x \"s\"") }
    }
}
