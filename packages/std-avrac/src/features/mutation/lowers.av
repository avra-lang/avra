//! The lowering rules of `mut` and assignment: a `mut` lives in a cell wearing its binding's type,
//! seeded with its value, and keeps whether that value was read from a place; a write to its name
//! stores into the cell, and one along a path lands where the path's opened place says.
use core.{Bound, Lowering, StmtId, StmtLowers}
use core.stmt.{Assign, MutLet}

impl StmtLowers for MutLet {
    fn stmt_lowered(mut cx: Lowering, s: StmtId) {
        if cx.store.is_state_stmt(s) { return cx.stmt_unlowered(s) }
        let v = cx.lower(self.value)
        let ty? = cx.binding_type(self.ty, self.value) else { return cx.missed("an untyped `mut`") }
        if cx.holds_tasks(ty) { return cx.missed("a task a `mut` binding holds") }
        let cell = cx.seeded_cell(cx.laid_out(ty), v)
        cx.seed_kept(cell, cx.read_from_place(self.value))
        cx.bind(self.name.of, Bound.Slot(cell, ty))
    }
}

impl StmtLowers for Assign {
    /// The value first, then the write where its target names.
    fn stmt_lowered(mut cx: Lowering, s: StmtId) {
        let v = cx.lower(self.value)
        cx.written_to(self.target, v)
    }
}
