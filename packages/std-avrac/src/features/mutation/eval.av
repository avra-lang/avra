//! Assignment at runtime: the value lands in the TARGET's slot —
//! the one write that is not the statement's own.
use core.{StmtId, ExprId}
use features.{StmtEvalCx}

export fn run_assign(cx: StmtEvalCx, s: StmtId, v: ExprId) {
    let target: StmtId? = cx.assign_target(s)
    if target == null {
        cx.fail("defect: an unresolved assignment survived a clean analysis")
        return
    }
    cx.write_slot(target!, v)
}
