//! Mutation's typing laws: a mut binding holds UNMANAGED values —
//! scalars and their pairs — and may declare its type like `let`;
//! an assignment must be ACCEPTED by the binding's type, widening
//! recorded like any other slot's.
use core.{StmtId, ExprId, TypeId, TypeRef}
use features.{TypeCx, StmtTypeCx, accepts, declared_binding, this_is, refuses_type_value}
use diagnostics.{error_at, pointed}

export fn check_mut(cx: StmtTypeCx, s: StmtId) {
    let held: ExprId? = cx.store.stmt_value(s)
    if held == null { return }
    let v = held!
    cx.walk(v)
    // The DECLARED type records even when the value refuses, so
    // downstream reads of the name see the declaration, not the
    // wreckage — one mistake, one message.
    let ann: TypeRef? = cx.store.binding_ty(s)
    let declared: TypeId? = if ann == null { null } else { cx.bind_declared(s, ann!) }
    if refuses_type_value(cx.expr, v) { return }
    if declared != null {
        declared_binding(cx.expr, v, cx.store.let_name(s) ?? "this binding", declared!)
    }
    // THE CELL LAW: the slot must hold a value the memory pass need
    // not track. A managed value in a reassignable cell waits for
    // ownership analysis; unmanaged aggregates pass — nothing
    // releases them yet. A scalar PAIR is two unmanaged words and
    // passes; the niche IS its managed pointer and does not.
    let cell = cx.binding_type(s)
    if managed_cell(cx.expr, cell) {
        cx.expr.emit(pointed(
            error_at("type.mut_managed", cx.loc_of(s), "a `mut` binding cannot hold a managed value yet"),
            "this holds a `${cx.expr.types.name_of(cell)}`")
            with { help: "mut managed values arrive with ownership analysis — use `let` and rebind by shadowing" })
    }
}

/// The strategy's managed truth, asked shape-down: a string, or a
/// nullable carrying one (the niche IS its pointer). Every arm
/// spelled: a NEW shape must answer whether the strategy tracks it.
fn managed_cell(cx: TypeCx, cell: TypeId) -> bool {
    match cx.types.shape_of(cell) {
        .Str -> true,
        // CONSERVATIVE: an unconstrained T could be managed — the
        // abstract body is checked once, so the cell law must hold
        // for every instantiation.
        .Var(_, _, _) -> true,
        .Opt(inner) -> managed_cell(cx, inner),
        .Int or .Bool or .List(_) or .Struct(_, _) or .Enum(_, _) or
        .Res(_, _) or .App(_, _, _) or .TypeName(_, _) or .Null or .EmptyList or .Error -> false,
    }
}

export fn check_assign(cx: StmtTypeCx, s: StmtId) {
    let held: ExprId? = cx.store.stmt_value(s)
    if held == null { return }
    let v = held!
    cx.walk(v)
    let found: StmtId? = cx.assign_target(s)
    if found == null { return }
    let target = found!
    // The binding's type is the slot's law — declared when written,
    // inferred otherwise — and acceptance WIDENS like every slot.
    let want = cx.binding_type(target)
    if !accepts(cx.expr, v, want) {
        let gn = cx.expr.types.name_of(cx.expr.type_at(v))
        cx.expr.emit(pointed(
            error_at("type.mismatch", cx.loc_of(s),
                "assignment changes `${cx.store.let_name(target) ?? "this binding"}`: `${cx.expr.types.name_of(want)}` to `${gn}`"),
            this_is(gn)))
    }
}
