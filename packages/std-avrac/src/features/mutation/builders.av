//! Parse-time lowering: captures -> the MutLet and Assign nodes.
use core.{Stmt}
use features.{LangNode, Builder}

fn build_mut(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let v = b.expr(1)?
    b.make_stmt(Stmt.MutLet(n.text, v))
}

fn build_assign(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let v = b.expr(1)?
    b.make_stmt(Stmt.Assign(n.text, v))
}
