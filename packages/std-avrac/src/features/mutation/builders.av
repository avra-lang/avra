//! Parse-time lowering: captures -> the MutLet node. The Assign node
//! is built at the statement floor (expr_stmt) — one parse of the
//! target — and given meaning here.
use core.{Stmt, Scoped}
use features.{LangNode, Builder}

fn build_mut(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let t = b.type_refs(1)?
    let v = b.expr(2)?
    b.make_stmt(Stmt.MutLet(Scoped(n.text), t.first(), v))
}
