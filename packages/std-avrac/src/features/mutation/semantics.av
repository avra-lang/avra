//! Mutation's StmtSemantics — one impl per statement kind, dispatch
//! one-liners: a mut binding walks and binds like a let, then lives
//! in a cell; an assignment writes its target's cell. The rule
//! bodies live beside this file, by concern.
use core.{StmtId, ExprId, Reg}
use features.{StmtSemantics, StmtResolveCx, StmtTypeCx, StmtLowerCx}

export type MutLetSemantics = { }

impl StmtSemantics for MutLetSemantics {
    fn resolve_stmt(self, cx: StmtResolveCx, s: StmtId) {
        cx.walk_value(s)
        cx.bind_checked(s)
    }

    fn type_stmt(self, cx: StmtTypeCx, s: StmtId) {
        check_mut(cx, s)
    }

    fn lower_stmt(self, cx: StmtLowerCx, s: StmtId) -> Reg? {
        let v: ExprId? = cx.store.stmt_value(s)
        if v == null { return null }
        lower_mut(cx, s, v!, cx.lower(v!))
    }
}

export type AssignSemantics = { }

impl StmtSemantics for AssignSemantics {
    fn resolve_stmt(self, cx: StmtResolveCx, s: StmtId) {
        cx.walk_value(s)
        resolve_assign(cx, s)
    }

    fn type_stmt(self, cx: StmtTypeCx, s: StmtId) {
        check_assign(cx, s)
    }

    fn lower_stmt(self, cx: StmtLowerCx, s: StmtId) -> Reg? {
        let v: ExprId? = cx.store.stmt_value(s)
        if v == null { return null }
        lower_assign(cx, s, cx.lower(v!))
        null
    }
}
