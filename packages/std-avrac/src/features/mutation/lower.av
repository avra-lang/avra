//! Mutation in the IR: a mut binding is a memory CELL — allocated,
//! seeded, bound as the statement's slot — and an assignment stores
//! through its target's cell.
use core.{StmtId, ExprId, Reg, Ins}
use features.{StmtLowerCx, Place, opened_place}

/// Declares the cell and answers the VALUE register — the driver's
/// last-value tracking sees the value, never the pointer. The slot
/// wears the STORED register's type: a widened value arrives as
/// its binding's declared shape, not the expression's.
export fn lower_mut(mut cx: StmtLowerCx, s: StmtId, v: Reg) -> Reg {
    let slot = cx.expr.mint_like(v)
    cx.expr.emit(Ins.Alloca(slot))
    cx.expr.emit(Ins.Store(slot, v))
    cx.bind_slot(s, slot)
    v
}

/// The write lands where the opened place says: a cell takes a
/// store (the mut-cell protocol owns the counts), a slot takes the
/// runtime's set (the memory pass marks a managed value owned).
export fn lower_assign(mut cx: StmtLowerCx, s: StmtId, v: Reg) {
    let target: ExprId? = cx.view.store.assign_target(s)
    if target == null { return }
    let place: Place? = opened_place(cx.expr, target!)
    if place == null {
        cx.expr.defect("an assignment to a non-place survived a clean analysis")
        return
    }
    match place! {
        .Cell(slot) -> cx.expr.emit(Ins.Store(slot, v)),
        .Slot(box, at) -> cx.expr.emit(Ins.CallRtVoid("avra_slot_set", [box, at, v])),
    }
}
