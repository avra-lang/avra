//! Mutation in the IR: a mut binding is a memory CELL — allocated,
//! seeded, bound as the statement's slot — and an assignment stores
//! through its target's cell.
use core.{StmtId, Reg, Ins}
use features.{StmtLowerCx}

/// Declares the cell and answers the VALUE register — the driver's
/// last-value tracking sees the value, never the pointer. The slot
/// wears the STORED register's type: a widened value arrives as
/// its binding's declared shape, not the expression's.
export fn lower_mut(cx: StmtLowerCx, s: StmtId, v: Reg) -> Reg {
    let slot = cx.expr.mint_like(v)
    cx.expr.emit(Ins.Alloca(slot))
    cx.expr.emit(Ins.Store(slot, v))
    cx.bind_slot(s, slot)
    v
}

export fn lower_assign(cx: StmtLowerCx, s: StmtId, v: Reg) {
    let target: StmtId? = cx.assign_target(s)
    if target == null {
        cx.expr.fail("defect: an unresolved assignment survived a clean analysis")
        return
    }
    let slot: Reg? = cx.slot_of(target!)
    if slot == null {
        cx.expr.fail("defect: an assignment before its binding survived a clean analysis")
        return
    }
    cx.expr.emit(Ins.Store(slot!, v))
}
