//! Mutation in the IR: a mut binding is a memory CELL — allocated,
//! seeded, bound as the statement's slot — and an assignment stores
//! through its target's cell.
use core.{StmtId, ExprId, Reg, Ins, TypeId}
use features.{LowerCx, Place, opened_place}

/// Declares the cell and answers the VALUE register — the driver's
/// last-value tracking sees the value, never the pointer. THE CELL
/// WEARS ITS BINDING'S DECLARED TYPE, never its first value's: a
/// `null` widened into a boxed `T?` keeps the null's own type (that
/// widen is identity), and a cell typed as null is one the memory
/// pass never settles — whatever it held at the scope's end leaked.
export fn lower_mut(mut cx: LowerCx, s: StmtId, v: Reg) -> Reg {
    let declared: TypeId? = cx.facts.declared_binding(s)
    let slot = if declared == null { cx.mint_like(v) } else { cx.mint_ty(cx.concrete(declared!)) }
    cx.emit(Ins.Alloca(slot))
    cx.emit(Ins.Store(slot, v))
    cx.bind_slot(s, slot)
    v
}

/// The write lands where the opened place says: a cell takes a
/// store (the mut-cell protocol owns the counts), a slot takes the
/// runtime's set (the memory pass marks a managed value owned).
export fn lower_assign(mut cx: LowerCx, s: StmtId, v: Reg) {
    let target: ExprId? = cx.view.store.assign_target(s)
    if target == null { return }
    let place: Place? = opened_place(cx, target!)
    if place == null {
        cx.defect("an assignment to a non-place survived a clean analysis")
        return
    }
    match place! {
        .Cell(slot) -> cx.emit(Ins.Store(slot, v)),
        .Slot(box, at) -> cx.emit(Ins.CallRtVoid("avra_slot_set", [box, at, v])),
    }
}
