// proves: a fn's own `state` is one place however deep the code that writes
// it — a lambda inside a lambda, a task spawned inside a lambda and a lambda
// inside a spawned task each write the cell their fn reads, a field along
// a path included.
type T = { n: int }

fn nested() -> int {
    state k: int = 0
    let outer = () -> {
        let inner = () -> { k = k + 1 }
        inner()
        inner()
    }
    outer()
    k
}

fn spawned_in_lambda() -> int {
    state k: int = 0
    let f = () -> {
        let t = spawn { k = k + 10 }
        t.await
    }
    f()
    k
}

fn lambda_in_spawned() -> int {
    state k: int = 0
    let t = spawn {
        let f = () -> { k = k + 100 }
        f()
    }
    t.await
    k
}

fn field_deep() -> int {
    state t: T = T { n: 0 }
    let outer = () -> {
        let inner = () -> { t.n = t.n + 1000 }
        inner()
    }
    outer()
    t.n
}

"${nested()} ${spawned_in_lambda()} ${lambda_in_spawned()} ${field_deep()}"
