// Mutation, vertically: mut declares, assignment rewrites the slot,
// immutability refuses with the remedy, and types hold still.
use @std.avrac.language.{analyze_source}
use @std.avrac.testing.{shown, refused_with}

spec "features/mutation" {
    given "mut and assignment" {
        then "a mut binding reassigns; the reads see the latest write" {
            shown("mut x = 1\nx = x + 10\nx = x + 100\nx") == "111"
        }
        then "assignment inside a fn body writes the outer-block slot" {
            shown("fn bump(n: int) -> int {\n    mut t = n\n    t = t + 1\n    t\n}\nbump(4)") == "5"
        }
    }
    given "the annotated cell — `mut x: T = v` and the pair unlock" {
        then "a mut nullable SCALAR is a legal cell — the state machine lives" {
            // LICENSED I4: the embedded SOURCE under test IS the nullable cell being proven
            shown("mut best: int? = null\nbest = 5\nbest = null\nbest = 4\nbest ?? 0 - 1") == "4"
        }
        then "assignment WIDENS into the declared cell" {
            shown("fn half(n: int) -> int? { if n % 2 == 0 { n / 2 } else { null } }\n" +
                  // LICENSED I4: the embedded SOURCE under test IS the nullable cell being proven
                  "mut t: int? = half(4)\nt = half(3)\nt ?? 0 - 7") == "-7"
        }
        then "a plain annotated mut declares and reassigns" {
            shown("mut plain: int = 40\nplain = plain + 2\nplain") == "42"
        }
        then "a bool? cell carries present FALSE" {
            // LICENSED I4: the embedded SOURCE under test IS the nullable cell being proven
            shown("mut f: bool? = null\nf = false\nif f ?? true { 1 } else { 0 }") == "0"
        }
        then "a MANAGED niche cell works — the null no-ops by construction" {
            // LICENSED I4: the embedded SOURCE under test IS the nullable cell being proven
            shown("mut s: string? = null\ns ?? \"d\"") == "d"
        }
        then "the declared-binding law reaches mut: `mut x: int = null` refuses" {
            refused_with("mut x: int = null\nx", "`x` declares `int`, this is `null`")
        }
        then "an assignment against the DECLARED type refuses in its words" {
            refused_with("mut x: int? = 5\nx = \"s\"\nx ?? 0", "assignment changes `x`: `int?` to `string`")
        }
        then "an UNANNOTATED mut still infers — null does not fit an int cell" {
            refused_with("mut x = 5\nx = null\nx", "assignment changes `x`: `int` to `null`")
        }
    }
    given "wrong shapes" {
        then "assigning a plain let refuses with the remedy" {
            let a = analyze_source("let x = 1\nx = 2\nx")
            a.diagnostics.length == 1 &&
                a.report().contains("`x` is not `mut`") &&
                a.report().contains("declare it `mut x = ...` to reassign")
        }
        then "assigning a parameter refuses" {
            let a = analyze_source("fn f(x: int) -> int {\n    x = 2\n    x\n}\nf(1)")
            a.diagnostics.length == 1 &&
                a.report().contains("`x` is a parameter — parameters are immutable")
        }
        then "assignment keeps the declared type" {
            let a = analyze_source("mut x = 1\nx = true\nx")
            a.diagnostics.length == 1 &&
                a.report().contains("assignment changes `x`: `int` to `bool`")
        }
        then "a mut string rebinds through the cell — ownership landed" {
            shown("mut s = \"hi\"\ns = \"re ${2}\"\ns") == "re 2"
        }
        then "a mut struct works — reassignment swaps the pointer" {
            shown("type P = { x: int }\nmut p = P { x: 1 }\np = P { x: 2 }\np.x") == "2"
        }
        then "assigning an undefined name says so" {
            let a = analyze_source("ghost = 1\n2")
            a.diagnostics.length == 1 && a.report().contains("`ghost` is not defined")
        }
    }
}
