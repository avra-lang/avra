// proves: a module `state` is one place however deep the code that writes
// it — a lambda inside a lambda, a task spawned inside a lambda and a lambda
// inside a spawned task each write the cell every reader reads, a field
// along a path included.
type T = { n: int }

state k: int = 0

state t: T = T { n: 0 }

let outer = () -> {
    let inner = () -> { k = k + 1 }
    inner()
    inner()
}
outer()
let nested = k
let f = () -> {
    let task = spawn { k = k + 10 }
    task.await
}
f()
let spawned_in_lambda = k
let task = spawn {
    let g = () -> { k = k + 100 }
    g()
}
task.await
let lambda_in_spawned = k
let deep = () -> {
    let inner = () -> { t.n = t.n + 1000 }
    inner()
}
deep()
"${nested} ${spawned_in_lambda} ${lambda_in_spawned} ${t.n}"
