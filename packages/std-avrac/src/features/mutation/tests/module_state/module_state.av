// proves: a module `state` is kept in one box built at its first read —
// a write reaches every later read, and a list it holds is written in place.
state count: int = 0

state seen: List<string> = []

fn bump() -> int {
    count = count + 1
    seen.push("b${count}")
    count
}

let a = bump()
let b = bump()
"${a} ${b} ${count} ${seen.join(",")}"
