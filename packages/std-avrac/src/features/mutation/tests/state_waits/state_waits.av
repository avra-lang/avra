// proves: a module `state` and a context whose start waits on a task answer their box, a `Result`
// held in it as in any other — the start runs once, and every read after takes what it kept
fn made(n: int) -> Result<string, string> {
    let t = spawn n + 1
    let v = t.await
    if v > 1 { .Ok("made ${v}") } else { .Err("none") }
}

state kept: Result<string, string> = made(1)

ctx carried: Result<string, string> = made(0)

fn said(r: Result<string, string>) -> string { match r { .Ok(s) -> s, .Err(e) -> e } }

"${said(kept)} ${said(kept)} ${said(ctx.carried)}"
