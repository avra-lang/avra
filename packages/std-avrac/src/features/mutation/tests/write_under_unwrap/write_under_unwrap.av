// proves: a write along a path under `!` lands where the nullable stands, present: a flat and a
// boxed record a field holds, and one a list's element holds; a copy taken before keeps its own.
type R = { x: int }
type B = { x: int, s: string, t: string }
type H = { r: R?, b: B?, n: int? }
fn f() -> int {
    mut h = H { r: R { x: 1 }, b: B { x: 2, s: "s", t: "t" }, n: 4 }
    let before = h
    h.r!.x = 5
    h.b!.x = 7
    h.b!.s = "z"
    h.r!.x * 1000 + before.r!.x * 100 + h.b!.x * 10 + before.b!.x + h.b!.s.length
}
fn lists() -> int {
    mut hs = [H { r: R { x: 1 }, b: null, n: null }]
    hs[0].r!.x = 9
    hs[0].r!.x
}
"${f()} ${lists()}"
