// The RED TEAM's permanent record for the mutable CELL — annotated
// or inferred, and the assignments into it (see
// .claude/skills/red-team): every program here was written to BREAK
// it. A case that once produced a wrong answer, a crash, an internal
// defect, or an engine divergence keeps its place here forever.
use @std.avrac.compiler.{analyze_source}
use @std.avrac.testing.{shown, refusals, refused_with, refused_at_run, halver}

spec "features/mutation (adversarial)" {
    given "the cell law — every managed shape refused, every unmanaged held" {
        then "all four UNMANAGED cells live: int, bool, and both pairs" {
            // LICENSED style.hand_rolled_scan: the embedded SOURCE under test IS the nullable cell being proven
            shown("mut a: int = 1\nmut b: bool = true\nmut c: int? = null\nmut d: bool? = null\n" + "a = 2\nb = false\nc = 3\nd = true\n" + "a + (c ?? 0) + (if b { 0 } else { 5 }) + (if d ?? false { 7 } else { 0 })") == "17"
        }
        then "a struct cell WORKS — unmanaged aggregates ride the slot" {
            shown("type U = { age: int }\nmut x: U = U { age: 1 }\nx = U { age: 5 }\nx.age") == "5"
        }
        then "a MANAGED niche cell stores present and absent alike" {
            // LICENSED style.hand_rolled_scan: the embedded SOURCE under test IS the nullable cell being proven
            shown("mut x: string? = null\nx = \"got \${1}\"\nx ?? \"-\"") == "got 1"
        }
        then "an UNMANAGED niche cell passes — the pointee owes nothing" {
            // LICENSED style.hand_rolled_scan: the embedded SOURCE under test IS the nullable cell being proven
            shown("mut x: List<int>? = null\nx = [1, 2, 3]\nx?.length ?? 0") == "3"
        }
    }
    given "the assignment law, aimed at the DECLARED cell" {
        then "SELF-assignment round-trips the pair" {
            shown("mut x: int? = 5\nx = x\nx ?? 0") == "5"
        }
        then "a wrong NULLABLE refuses nullable-to-nullable, exactly once" {
            refusals("fn g(b: bool) -> string? { if b { \"x\" } else { null } }\n" + "mut x: int? = 5\nx = g(true)\nx ?? 0") == 1
        }
        then "an optional never widens BACK into a guarantee cell" {
            refused_with("${halver}mut x: int = 1\nx = half(4)\nx", "assignment changes `x`: `int` to `int?`")
        }
    }
    given "the counter, which once typed as the ABSORBING hole" {
        then "a for counter assigned into a pair cell WRAPS — the divergence that found it" {
            // eval defected (extract from a non-pack) while native read
            // a raw int's low bit as the flag; the counter typed as
            // Error and absorbed the widen. Forever pinned.
            // LICENSED style.hand_rolled_scan: the embedded SOURCE under test IS the nullable cell being proven
            shown("mut t: int? = null\nfor i in 0..5 {\n    t = i + (t ?? 0)\n}\nt ?? 0 - 1") == "10"
        }
    }
    given "the cell under attack — types as values, order, names" {
        then "a TYPE as the value speaks ONCE, and later reads see the DECLARATION" {
            let a = analyze_source("type U = { age: int }\nmut x: int = U\nx")
            a.diagnostics.length == 1 && a.report().contains("`U` is a type, not a value")
        }
        then "a use before its cell exists refuses at resolve" {
            refused_with("mut x: int? = x\nx ?? 0", "`x` is used before its definition")
        }
        then "a `let` shadows a cell; the cell's last value survives underneath" {
            // LICENSED style.hand_rolled_scan: the embedded SOURCE under test IS the nullable cell being proven
            shown("mut x: int? = null\nlet got = x ?? 1\nlet x = 50\nx + got") == "51"
        }
        then "a cell named like a fn shadows it for reads" {
            shown("${halver}mut half: int? = half(4)\nhalf ?? 0") == "2"
        }
    }
    given "the two engines refuse alike at the absent cell" {
        then "forcing an absent cell traps in the evaluator's words" {
            // LICENSED style.hand_rolled_scan: the embedded SOURCE under test IS the nullable cell being proven
            refused_at_run("mut x: int? = null\nx!", "unwrapped an absent value")
        }
        then "REASSIGNED to absent then forced — 10.4's scenario traps, never lies" {
            refused_at_run("mut x: int? = 7\nx = null\nx!", "unwrapped an absent value")
        }
    }
    given "places under attack (rt28)" {
        then "four levels deep, the snapshot keeps its value" {
            shown("type D = { v: int }\ntype C = { d: D }\ntype B = { c: C }\ntype A = { b: B }\nmut a = A { b: B { c: C { d: D { v: 1 } } } }\nlet s = a\na.b.c.d.v = 9\n\"" + "\${a.b.c.d.v} " + "\${s.b.c.d.v}\"") == "9 1"
        }
        then "a measured property is not a place" {
            refused_with("mut xs = [1]\nxs.length = 3\n2", "`length` is measured, not stored")
        }
        then "a type is not a place" {
            refused_with("enum Color {\n    red\n}\nColor.red = 1\n2", "`Color` is a type")
        }
        then "a parameter's field refuses as the parameter" {
            refused_with("type P = { x: int }\nfn f(p: P) -> int {\n    p.x = 1\n    p.x\n}\nf(P { x: 0 })", "`p` is a parameter")
        }
        then "`self` is the one parameter a method writes through — the receiver is a place" {
            shown("type P = { x: int }\nimpl P {\n    fn bump() -> int {\n        self.x = self.x + 1\n        self.x\n    }\n}\nP { x: 1 }.bump()") == "2"
        }
        then "null into an int slot" {
            refused_with("type P = { x: int }\nmut p = P { x: 1 }\np.x = null\n2", "`int` to `null`")
        }
        then "a self-store keeps the value — retain first" {
            shown("type U = { name: string, tags: List<string> }\nmut u = U { name: \"ada\", tags: [\"x\"] }\nu.name = u.name\nu.tags[0] = u.tags[0]\nu.tags.push(u.tags[0])\n\"" + "\${u.name} " + "\${u.tags[1]}\"") == "ada x"
        }
        then "a slot aliased into another slot — copy-on-write at the slot" {
            shown("mut g = [[1], [2]]\ng[0] = g[1]\ng[0][0] = 9\n\"" + "\${g[0][0]} " + "\${g[1][0]}\"") == "9 2"
        }
        then "a struct placed into another — both keep their own" {
            shown("type A = { c: string }\ntype B = { a: A, n: int }\nmut a = A { c: \"one\" }\nmut b = B { a: a, n: 1 }\nb.a.c = \"two\"\na.c = \"three\"\n\"" + "\${a.c} " + "\${b.a.c}\"") == "three two"
        }
        then "a push while iterating walks the snapshot" {
            shown("mut xs = [1, 2]\nfor x in xs {\n    xs.push(x * 10)\n}\n\"" + "\${xs.length} " + "\${xs[3]}\"") == "4 20"
        }
        then "an inner `let` shadowing a mut refuses" {
            refused_with("mut x = 1\nfn f() -> int {\n    let x = 2\n    x = 3\n    x\n}\nf()", "`x` is not `mut`")
        }
        then "string slots under churn — a thousand overwrites" {
            shown("type A = { city: string }\ntype U = { name: string, addr: A, tags: List<string> }\nmut u = U { name: \"a\", addr: A { city: \"c\" }, tags: [\"t\"] }\nmut i = 0\nwhile i < 1000 {\n    u.name = \"n" + "\${i}\"\n    u.addr.city = \"c" + "\${i}\"\n    u.tags[0] = \"t" + "\${i}\"\n    i = i + 1\n}\n\"" + "\${u.name} " + "\${u.addr.city} " + "\${u.tags[0]}\"") == "n999 c999 t999"
        }
    }
}
