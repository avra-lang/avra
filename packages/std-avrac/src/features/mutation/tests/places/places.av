// proves: THE PLACE LAW — a mut binding permits mutation at any
// depth (field, nested field, index, push) and `let` is deeply
// immutable; VALUE SEMANTICS by copy-on-write: every alias and
// snapshot keeps what it saw. The interpreter copies always, native
// copies only when shared — agreement is the proof.
type Addr = { city: string }
type U = { name: string, age: int, addr: Addr, tags: List<string> }
mut u = U { name: "ada", age: 36, addr: Addr { city: "SF" }, tags: ["x"] }
let snap = u
u.age = 37
u.name = "ada2"
u.addr.city = "NYC"
u.tags.push("y")
u.tags[0] = "z"
mut xs = [1, 2]
let ys = xs
xs.push(3)
xs[0] = 10
mut grid = [[1, 2], [3]]
let g0 = grid[0]
grid[0][1] = 20
grid[1].push(4)
mut n = 1
n = n + 1
mut i = 0
mut acc: List<int> = []
while i < 5 {
    acc.push(i * i)
    i = i + 1
}
"${u.age} ${u.name} ${u.addr.city} ${u.tags[0]}${u.tags[1]} | ${snap.age} ${snap.name} ${snap.addr.city} ${snap.tags.length} | ${xs[0]} ${xs.length} ${ys[0]} ${ys.length} | ${grid[0][1]} ${grid[1].length} ${g0[1]} | ${n} ${acc[4]} ${acc.length}"
