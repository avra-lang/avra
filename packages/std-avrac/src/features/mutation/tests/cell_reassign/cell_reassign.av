// A `mut` seat writes along a path; a `Cell<T>` REPLACES the value it
// holds, whole, from inside a plain (non-`mut`) parameter — the door
// F3005 names once whole reassignment of a `mut` seat is refused.
// A scalar cell and a struct cell both reassign clean.
type K = { n: int }

fn bump_int(c: Cell<int>) { c.set(c.get() + 1) }

fn bump_k(c: Cell<K>) { c.set(K { n: c.get().n + 1 }) }

let a = Cell.new(1)
bump_int(a)
bump_int(a)

let b = Cell.new(K { n: 10 })
bump_k(b)
bump_k(b)
bump_k(b)

"${a.get()} ${b.get().n}"
