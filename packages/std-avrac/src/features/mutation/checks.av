//! The typing rule of an assignment: the value checks against what its place holds; a place rooted
//! in a type's name holds nothing, which the place law says.
use core.{Checking, Expected, StmtChecks, StmtId}
use core.stmt.{Assign}

impl StmtChecks for Assign {
    fn stmt_checked(mut cx: Checking, s: StmtId) {
        if cx.type_rooted(self.target) != null {
            let _ = cx.check(self.value, Expected.Free)
            return
        }
        let place = cx.check(self.target, Expected.Free)
        cx.wrote(self.target)
        cx.seals_path(self.target, self.target)
        let _ = cx
            .check(self.value, if place == null { Expected.Free } else { Expected.Exactly(place!) })
    }
}
