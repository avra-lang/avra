//! The typing rule of an assignment: the value checks against what its place holds.
use core.{Checking, Expected, StmtChecks, StmtId}
use core.stmt.{Assign}

impl StmtChecks for Assign {
    fn stmt_checked(mut cx: Checking, s: StmtId) {
        let place = cx.check(self.target, Expected.Free)
        let _ = cx
            .check(self.value, if place == null { Expected.Free } else { Expected.Exactly(place!) })
    }
}
