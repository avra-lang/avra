//! The assignment's resolve rule: the target is a PLACE — a path
//! rooted in a name — and that name must land on a `mut` binding;
//! params and plain lets refuse with the remedy. The path itself
//! resolves like any expression.
use core.{StmtId, ExprId, Binding, same_expr}
use features.{StmtResolveCx, nothing}
use diagnostics.{refusal}
use @std.errors.{Loc}

export fn resolve_assign(cx: StmtResolveCx, s: StmtId) {
    let target: ExprId? = match cx.view.store.stmt(s) {
        .Assign(t, _) -> t,
        _ -> null,
    }
    if target == null { return }
    let t = target!
    let at: Loc? = cx.loc_of(s)
    let root: ExprId? = cx.view.store.place_root(t)
    if root == null { return not_a_place(cx, at) }
    let r = root!
    cx.walk(t)
    let n = cx.view.store.ident_name(r) ?? "this name"
    // the walk bound the root: ask THE BINDING, never the name — a
    // name-keyed table holds locals alone and would let a fn's
    // name through as a place
    let b: Binding? = cx.facts.binding(r)
    if b == null { return }
    match b! {
        .Param(_) -> if through_receiver(t, r, n) { nothing() } else { immutable_param(cx, n, at) },
        .Index(_) -> immutable_index(cx, n, at),
        .Def(s) -> mut_or_refused(cx, s, n, at),
        .LambdaParam(_, _) -> immutable_param(cx, n, at),
        .Pattern(_, _) -> immutable_bind(cx, n, at),
        .Capture(_, _) -> captured_copy(cx, n, at),
        // a type's name as a value: the walk already spoke
        .Decl(d) -> if cx.view.decls.fn_name(d) != null { not_a_fn_place(cx, n, at) } else { nothing() },
    }
}

/// A method writes through its receiver: `self.field = v` lands on
/// the box the caller holds — a PATH under `self`, never `self`
/// itself.
fn through_receiver(target: ExprId, root: ExprId, name: string) -> bool {
    name == "self" && !same_expr(target, root)
}

/// A definition is a place only when it was declared `mut`.
fn mut_or_refused(cx: StmtResolveCx, s: StmtId, n: string, at: Loc?) {
    if !(cx.view.store.stmt(s) is .MutLet) { not_mut(cx, n, at) }
}

// ── The voices ──

/// Every refusal here labels the assignment itself.
fn assigned_here() -> string {
    "assigned here"
}

/// The remedy for a name that is read-only by nature: copy it.
fn mut_copy_help(n: string) -> string {
    "bind a `mut` copy to change — `mut k = ${n}`"
}

fn not_a_place(cx: StmtResolveCx, at: Loc?) {
    cx.emit(refusal("resolve.place", at, "a mutation lands on a place — a name, a field, or an index", assigned_here(), "`x = …`, `x.field = …`, `xs[i] = …` — rooted in a `mut` binding"))
}

fn immutable_param(cx: StmtResolveCx, n: string, at: Loc?) {
    cx.emit(refusal("resolve.immutable", at, "`${n}` is a parameter — parameters are immutable", assigned_here(), null))
}

fn immutable_bind(cx: StmtResolveCx, n: string, at: Loc?) {
    cx.emit(refusal("resolve.immutable", at, "`${n}` is a pattern's bind — it names the matched value, it is not assigned", assigned_here(), mut_copy_help(n)))
}

fn captured_copy(cx: StmtResolveCx, n: string, at: Loc?) {
    cx.emit(refusal("resolve.immutable", at, "`${n}` is captured by value — a lambda cannot assign to it", assigned_here(), "a capture is a copy: bind a `mut` inside the lambda, or answer the new value and let the caller keep it"))
}

fn not_a_fn_place(cx: StmtResolveCx, n: string, at: Loc?) {
    cx.emit(refusal("resolve.immutable", at, "`${n}` is a fn — it is not assigned", assigned_here(), "bind a fn value to change it — `mut g = ${n}`"))
}

fn immutable_index(cx: StmtResolveCx, n: string, at: Loc?) {
    cx.emit(refusal("resolve.immutable", at, "`${n}` is a loop index — it counts, it is not assigned", assigned_here(), mut_copy_help(n)))
}

fn not_mut(cx: StmtResolveCx, n: string, at: Loc?) {
    cx.emit(refusal("resolve.immutable", at, "`${n}` is not `mut`", assigned_here(), "declare it `mut ${n} = ...` to mutate it — or build a changed copy with `with`"))
}
