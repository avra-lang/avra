//! The assignment's resolve rule: the target is a PLACE — a path
//! rooted in a name — and that name must land on a `mut` binding;
//! params and plain lets refuse with the remedy. The path itself
//! resolves like any expression.
use core.{StmtId, ExprId}
use features.{StmtResolveCx}
use diagnostics.{refusal}
use @std.errors.{Loc}

export fn resolve_assign(cx: StmtResolveCx, s: StmtId) {
    let target: ExprId? = match cx.store.stmt(s) {
        .Assign(t, _) -> t,
        _ -> null,
    }
    if target == null { return }
    let t = target!
    let at: Loc? = cx.loc_of(s)
    let root: ExprId? = cx.store.place_root(t)
    if root == null { return not_a_place(cx, at) }
    cx.walk(t)
    let n = cx.store.ident_name(root!) ?? "this name"
    if cx.is_param(n) { return immutable_param(cx, n, at) }
    if cx.is_index(n) { return immutable_index(cx, n, at) }
    let found: StmtId? = cx.lookup(n)
    if found == null { return }
    if !(cx.store.stmt(found!) is .MutLet) { not_mut(cx, n, at) }
}

// ── The voices ──

fn not_a_place(cx: StmtResolveCx, at: Loc?) {
    cx.emit(refusal("resolve.place", at, "a mutation lands on a place — a name, a field, or an index", "assigned here", "`x = …`, `x.field = …`, `xs[i] = …` — rooted in a `mut` binding"))
}

fn immutable_param(cx: StmtResolveCx, n: string, at: Loc?) {
    cx.emit(refusal("resolve.immutable", at, "`${n}` is a parameter — parameters are immutable", "assigned here", null))
}

fn immutable_index(cx: StmtResolveCx, n: string, at: Loc?) {
    cx.emit(refusal("resolve.immutable", at, "`${n}` is a loop index — it counts, it is not assigned", "assigned here", "bind a `mut` copy to change — `mut k = ${n}`"))
}

fn not_mut(cx: StmtResolveCx, n: string, at: Loc?) {
    cx.emit(refusal("resolve.immutable", at, "`${n}` is not `mut`", "assigned here", "declare it `mut ${n} = ...` to mutate it — or build a changed copy with `with`"))
}
