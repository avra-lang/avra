//! A block lowers as its expansion — the calls its grammar's actions
//! became; nothing of the sublanguage survives to the IR.
use core.{ExprId, Reg}
use features.{LowerCx}

export fn block_reg(mut cx: LowerCx, e: ExprId) -> Reg {
    let x? = cx.view.store.expansion_of(e) else { return cx.lower_defect(e, "a block that never expanded") }
    cx.reg_of(x)
}
