// GENERATED by `avra attack sublang` — the mechanical
// classes from the feature's rule and the model. A SEMANTIC
// attack belongs in the feature's hand-written test.
// cap: 500 case(s), 0 dropped.
use @std.avrac.compiler.{analyze_source}
use @std.avrac.diagnostics.{Diag}

/// The SHAPE parses — a canonical sample spells `x` where a name
/// belongs, so a TYPE error is expected and a PARSE error is not.
fn parses(src: string) -> bool {
    !analyze_source(src).diagnostics.any(parse_error)
}

fn parse_error(d: Diag) -> bool {
    d.kind.starts_with("parse.")
}

/// The compiler REACHES A VERDICT on a malformed surface — a
/// deletion can yield a valid program, so this law is tolerance,
/// not refusal; a trap is not a verdict and dies in the call.
fn tolerates(src: string) -> bool {
    let reached = analyze_source(src).diagnostics.length
    reached >= 0
}

spec "features/sublang adversarial — mechanical" {
    given "degenerate shapes — a valid surface, and must stay valid" {
        then " {  }" { parses(" {  }") == parses(" {  } \${ x }") }
        then " {  } \${ x } \${ x }" { parses(" {  } \${ x } \${ x }") == parses(" {  } \${ x }") }
    }
    given "malformed surface — must be diagnosed" {
        then "x { \"s\" } \n" { tolerates("x { \"s\" } \n") }
        then "grammar { \"s\" } \n" { tolerates("grammar { \"s\" } \n") }
        then "grammar x \"s\" } \n" { tolerates("grammar x \"s\" } \n") }
        then "grammar x { } \n" { tolerates("grammar x { } \n") }
        then "grammar x { \"s\" \n" { tolerates("grammar x { \"s\" \n") }
        then "grammar x { \"s\" }" { tolerates("grammar x { \"s\" }") }
        then "grammar grammar x { \"s\" } \n" { tolerates("grammar grammar x { \"s\" } \n") }
        then "grammar x x { \"s\" } \n" { tolerates("grammar x x { \"s\" } \n") }
        then "grammar x { { \"s\" } \n" { tolerates("grammar x { { \"s\" } \n") }
        then "grammar x { \"s\" \"s\" } \n" { tolerates("grammar x { \"s\" \"s\" } \n") }
        then "grammar x { \"s\" } } \n" { tolerates("grammar x { \"s\" } } \n") }
        then "grammar x { \"s\" } \n \n" { tolerates("grammar x { \"s\" } \n \n") }
        then "x grammar { \"s\" } \n" { tolerates("x grammar { \"s\" } \n") }
        then "grammar { x \"s\" } \n" { tolerates("grammar { x \"s\" } \n") }
        then "grammar x \"s\" { } \n" { tolerates("grammar x \"s\" { } \n") }
        then "grammar x { } \"s\" \n" { tolerates("grammar x { } \"s\" \n") }
        then "grammar x { \"s\" \n }" { tolerates("grammar x { \"s\" \n }") }
        then "} \${ x }" { tolerates("} \${ x }") }
        then "{ \${ x }" { tolerates("{ \${ x }") }
        then "{ } x }" { tolerates("{ } x }") }
        then "{ } \${ }" { tolerates("{ } \${ }") }
        then "{ } \${ x" { tolerates("{ } \${ x") }
        then "{ { } \${ x }" { tolerates("{ { } \${ x }") }
        then "{ } } \${ x }" { tolerates("{ } } \${ x }") }
        then "{ } \${ \${ x }" { tolerates("{ } \${ \${ x }") }
        then "{ } \${ x x }" { tolerates("{ } \${ x x }") }
        then "{ } \${ x } }" { tolerates("{ } \${ x } }") }
        then "} { \${ x }" { tolerates("} { \${ x }") }
        then "{ \${ } x }" { tolerates("{ \${ } x }") }
        then "{ } x \${ }" { tolerates("{ } x \${ }") }
        then "{ } \${ } x" { tolerates("{ } \${ } x") }
    }
}
