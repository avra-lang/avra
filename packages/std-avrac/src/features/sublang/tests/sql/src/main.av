// proves: a sublanguage block is the calls its grammar's actions name
// — a hole is an argument (`${uid}` fills `eq`'s int seat), a repeated
// capture a list, an absent one null — and two block words from one
// module hold at once
use @test.sql.{sql, kv, Select, Pair}
let uid = 7
let q: Select = sql { SELECT name, age FROM users WHERE id = ${uid} }
let plain: Select = sql { SELECT id FROM t }
let ps: List<Pair> = kv { a = 1, b = 2 }
// N=max: many actions minted in one block, read back through the
// caller's own store — proves the block's expansion is not lost
// past the block (features/sublang/builders.av's `sink` write-back)
let big: List<Pair> = kv { a = 1, b = 2, c = 3, d = 4, e = 5, f = 6, g = 7, h = 8 }
let wide: Select = sql { SELECT a, b, c, d, e, f, g, h, i, j FROM t2 }
"${q.shown()} | ${plain.shown()} | ${ps.length} ${ps[1].key}=${ps[1].value} | ${big.length} ${big[7].key}=${big[7].value} | ${wide.shown()}"
