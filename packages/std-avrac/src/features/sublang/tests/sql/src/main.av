// proves: a sublanguage block is the calls its grammar's actions name
// — a hole is an argument (`${uid}` fills `eq`'s int seat), a repeated
// capture a list, an absent one null — and two block words from one
// module hold at once
use @test.sql.{sql, kv, Select, Pair}
let uid = 7
let q: Select = sql { SELECT name, age FROM users WHERE id = ${uid} }
let plain: Select = sql { SELECT id FROM t }
let ps: List<Pair> = kv { a = 1, b = 2 }
"${q.shown()} | ${plain.shown()} | ${ps.length} ${ps[1].key}=${ps[1].value}"
