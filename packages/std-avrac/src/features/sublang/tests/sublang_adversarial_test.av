// Attacks on sublanguage blocks: every seat of the toy grammar under
// a hole, the block inside other features, the body's lexing limit,
// two imports of one word, mutual imports, and a block inside a template.
use @std.avrac.testing.{test_workspace}
use @std.avrac.compiler.{Program}
use @std.avrac.testing.{vendored_meta, vendored_meta_paths, refused_n}
use compiler.host.{memory_host}

/// A program with TWO providers both exporting a `sql` word, and a
/// provider of derives whose templates hold a block.
fn packaged_wide(main: string, prov: string, other: string, derives: string) -> Program {
    let files = vendored_meta(
        {
            "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@x/sql\" = { path = \"vendor/sql\" }\n\"@y/sql\" = { path = \"vendor/ysql\" }\n\"@std/meta\" = { path = \"vendor/meta\" }\n\"@x/derives\" = { path = \"vendor/derives\" }\n",
            "/w/src/main.av": main,
            "/w/vendor/sql/avra.toml": "[package]\nname = \"@x/sql\"\nversion = \"0.1.0\"\n",
            "/w/vendor/sql/src/sql.av": prov,
            "/w/vendor/ysql/avra.toml": "[package]\nname = \"@y/sql\"\nversion = \"0.1.0\"\n",
            "/w/vendor/ysql/src/sql.av": other,
            "/w/vendor/derives/avra.toml": "[package]\nname = \"@x/derives\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@std/meta\" = { path = \"../meta\" }\n\"@x/sql\" = { path = \"../sql\" }\n",
            "/w/vendor/derives/src/derives.av": derives,
        },
    )
    let ws = test_workspace(
        memory_host(
            files,
            [
                "/w/avra.toml",
                "/w/src/main.av",
                "/w/vendor/sql/avra.toml",
                "/w/vendor/sql/src/sql.av",
                "/w/vendor/ysql/avra.toml",
                "/w/vendor/ysql/src/sql.av",
                "/w/vendor/derives/avra.toml",
                "/w/vendor/derives/src/derives.av",
            ]
                .concat(vendored_meta_paths()),
        ),
        "/w",
    )
    ws.program("/w/src/main.av")
}

/// A derive whose template holds a block of `@x/sql` — the block
/// expands at the library's parse and is copied into the user's file.
fn derives() -> string {
    "use @std.meta.{Type, Directive}\nuse @x.sql.{sql, Select}\nexport trait Queried {\n    static fn derive(t: Type) -> List<Directive> {\n        [Directive { twin: \"\", name: t.name, at: t.at, source: quote { impl \${t} { fn queried() -> Select { sql { SELECT id FROM rows } } } } }]\n    }\n}\n"
}

/// A program of two modules that import each other, one declaring a
/// grammar the other writes a block of.
fn modules(main: string, a: string, b: string) -> Program {
    let files = {
        "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n",
        "/w/src/main.av": main,
        "/w/src/a/a.av": a,
        "/w/src/b/b.av": b,
    }
    let ws = test_workspace(
        memory_host(files, ["/w/avra.toml", "/w/src/main.av", "/w/src/a/a.av", "/w/src/b/b.av"]),
        "/w",
    )
    ws.program("/w/src/main.av")
}

fn other() -> string {
    "export type Other = { n: int }\nexport fn mk(n: int) -> Other { Other { n: n } }\nexport grammar sql {\n    one = \"ONE\" v:NAME -> mk(v)\n}\n"
}

spec "features/sublang — adversarial" {
    given "a hole in every seat of the toy grammar" {
        then "a hole where the grammar wants a name is its argument, typed by the seat" {
            clean(
                packaged(
                    use_sql() +
                        "let t = \"users\"\nlet q: Select = sql { SELECT name FROM \${t} }\nq.relation",
                    provider(),
                ),
            )
        }
        then "a hole where the grammar wants a name refuses a number by the call's seat" {
            refused_n(
                packaged(
                    use_sql() + "let t = 3\nlet q: Select = sql { SELECT name FROM \${t} }\n1",
                    provider(),
                ),
                "argument 2 of `query` wants `string`, found `int`",
                1,
            )
        }
        then "a hole where the grammar wants a keyword is a parse refusal at the block" {
            refused_n(
                packaged(
                    use_sql() + "let k = 1\nlet q: Select = sql { \${k} name FROM users }\n1",
                    provider(),
                ),
                "expected `SELECT`",
                1,
            )
        }
        then "a hole in a repeated seat fills one element" {
            clean(
                packaged(
                    use_sql() +
                        "let c = \"age\"\nlet q: Select = sql { SELECT name, \${c} FROM users }\nq.cols.length",
                    provider(),
                ),
            )
        }
    }
    given "the block among other features" {

        then "a block in a fn body, a list and an interpolation hole" {
            clean(
                packaged(
                    use_sql() +
                        "fn q() -> Select { sql { SELECT a FROM b } }\nlet qs: List<Select> = [sql { SELECT a FROM b }, q()]\n\"\${sql { SELECT a FROM b }.relation} \${qs.length}\"",
                    provider(),
                ),
            )
        }
        then "the word alone, called, and read as a field are what they were" {
            refused_n(packaged(use_sql() + "let n = sql\n1", provider()), "`sql` is not defined", 1)
        }
    }
    given "the body's lexing is Avra's" {

        then "a body character Avra's lexer refuses speaks at the block, in the lexer's words" {
            let p = packaged(
                use_sql() + "let q: Select = sql { SELECT name FROM users WHERE id = 'x' }\n1",
                provider(),
            )
            refused_n(p, "unexpected character", 2) && p.report().contains("main.av:2")
        }
    }
    given "two imports of one word" {

        then "the second import of a word another package already binds refuses at the use, naming the holder" {
            refused_n(
                packaged_wide(
                    "use @x.sql.{sql, Select}\nuse @y.sql.{sql}\n1",
                    provider(),
                    other(),
                    derives(),
                ),
                "`sql` is imported, but `@x.sql` already has it",
                1,
            )
        }
    }
    given "two modules importing each other" {

        then "a module's block of a grammar whose module imports it back parses, each read through the other's words alone" {
            clean(
                modules(
                    "use b.{made}\nuse a.{twice}\nmade().v + twice()",
                    "use b.{size}\nexport type Pair = { k: string, v: int }\nexport fn pair(k: string, v: int) -> Pair { Pair { k: k, v: v } }\nexport fn twice() -> int { size() * 2 }\nexport grammar kv {\n    pair = k:NAME \"=\" v:NUMBER -> pair(k, v)\n}\n",
                    "use a.{kv, Pair}\nexport fn size() -> int { 1 }\nexport fn made() -> Pair { kv { x = 2 } }\n",
                ),
            )
        }
    }
    given "a block inside a template" {

        then "a template's block expands at the library and is copied into the user's file, its calls the library's" {
            let p = packaged_wide(
                "use @std.meta.{derive}\nuse @x.derives.{Queried}\nuse @x.sql.{Select}\n@derive(Queried)\ntype P = { a: int }\nP { a: 1 }.queried().relation",
                provider(),
                other(),
                derives(),
            )
            clean(p)
        }
    }
}
