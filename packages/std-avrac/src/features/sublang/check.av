//! A block types as its expansion; a `syntax` declaration readies its
//! grammar here, in the library, and holds every action to a fn of
//! its own module with the action's arity — before any user exists.
use core.{ExprId, StmtId, TypeId, DeclId, flatten}
use features.{TypeCx, FnSig}
use @std.grammar.{ready, Grammar, Build, Diagnostic}
use grammar.{parse_grammar, avra_known_terminals}
use diagnostics.{refusal, Diag}
use @std.errors.{Loc}

export fn block_type(mut cx: TypeCx, e: ExprId) -> TypeId {
    let x? = cx.view.store.expansion_of(e) else { return cx.error_type }
    cx.type_at(x)
}

fn check_syntax(mut cx: TypeCx, s: StmtId) {
    let parts? = cx.view.store.syntax_parts(s) else { return }
    let gp = parse_grammar(parts.text)
    let at = cx.stmt_loc(s)
    if gp.built == null { return cx.emit(unparsed(at, parts.name, first_defect(gp.diagnostics))) }
    let g = gp.built!
    for d in ready(g, avra_known_terminals()).defects { cx.emit(refusal("type.syntax_action", at, d.message, "in this grammar", null)) }
    for a in actions_of(g) {
        let found: DeclId? = cx.names.names.fn_decl(a.name)
        if found == null {
            cx.emit(no_action(at, parts.name, a.name))
        } else {
            let sig: FnSig? = cx.view.decls.sig(found!)?.fn_sig()
            if sig != null && sig!.params.length != a.arity { cx.emit(wrong_arity(at, a.name, sig!.params.length, a.arity)) }
        }
    }
}

/// Every action of a grammar — the fn each names and the arguments
/// it hands — in rule order. A `Var` action hands one capture on.
fn actions_of(g: Grammar) -> List<Action> {
    flatten([flatten([action_of(s.build) for s in r.body.branches]) for r in g.rules])
}

type Action = { name: string, arity: int }

fn action_of(b: Build?) -> List<Action> {
    if b == null { return [] }
    match b! {
        .Call(name, args) -> [Action { name: name, arity: args.length }],
        .Node(_, _, _, _) or .Var(_) -> [],
    }
}

fn first_defect(ds: List<Diagnostic>) -> string {
    let held? = ds.first() else { return "no rule was built" }
    held.message
}

// ── voices ──

fn unparsed(at: Loc?, word: string, defect: string) -> Diag {
    refusal(
        "type.syntax_action",
        at,
        "`grammar ${word}` does not parse: ${defect}",
        "this grammar",
        "the notation is the grammar DSL's — rules, `|` alternatives, `x:ITEM` captures, `-> action(x)`",
    )
}

fn no_action(at: Loc?, word: string, name: string) -> Diag {
    refusal(
        "type.syntax_action",
        at,
        "`grammar ${word}` names an action `${name}`, and this module declares no fn `${name}`",
        "this grammar",
        "declare `fn ${name}(…)` in this module — an action is one of its own fns",
    )
}

fn wrong_arity(at: Loc?, name: string, takes: int, handed: int) -> Diag {
    refusal(
        "type.syntax_action",
        at,
        "action `${name}` hands ${handed} captures, and `fn ${name}` takes ${takes}",
        "this grammar",
        "capture as many as the fn takes",
    )
}
