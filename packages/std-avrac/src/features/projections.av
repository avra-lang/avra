//! `@derive(Projections)` — the compiler derives its own accessor
//! families: one `<variant>_sig` method per enum variant, each the
//! one-arm projection a hand-written `*_sig_of` free fn spelled.
//!
//! It is the S4 payday: a METHOD-shaped derive rides `Decls.methods`
//! program-wide, so a generated accessor crosses files with no
//! namespace widening and no call-site shape but `d.fn_sig()`.
use @std.meta.{Type, Variant, Directive as MetaDirective}
use @std.text.{from_codepoints}

/// The compiler's own derive: the accessors of the annotated enum,
/// one method per variant, answering the variant's payload or null.
/// The meta `Directive` wears an alias here: `features` holds the
/// compiler's own mirror of that name.
trait Projections {
    static fn derive(t: Type) -> List<MetaDirective> {
        let methods = [projection_of(v) for v in t.variants]
        let body = methods.join("\n")
        [MetaDirective { twin: "", name: t.name, at: t.at, source: quote { impl ${t} {
${body}
} } }]
    }
}

/// One variant's accessor: `<name>_sig`, the payload, or null.
fn projection_of(v: Variant) -> string {
    "fn ${method_name(v.name)}() -> ${v.payload[0]}? { match self { .${v.name}(s) -> s, _ -> null } }"
}

/// `Fn` -> `fn_sig`, `Record` -> `record_sig`, `Enum` -> `enum_sig`.
fn method_name(variant: string) -> string {
    "${lowercase(variant)}_sig"
}

/// A single-word variant name, lowered — `Fn` -> `fn`.
fn lowercase(s: string) -> string {
    from_codepoints([lowered(s.char_code(i)) for i in 0..s.length])
}

fn lowered(c: int) -> int {
    if c >= 65 && c <= 90 { c + 32 } else { c }
}
