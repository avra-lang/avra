//! `grammar { … }` — the grammar DSL, read when the COMPILER runs
//! and not when the program does. The LEXER hands the block's body
//! over whole (its notation is not Avra); PURE SUGAR: the builder
//! parses the text and expands it into the same constructors
//! `seed.av` writes by hand, so a feature contributes a Grammar
//! VALUE and assembly never parses anything.
//! No node, no rule of its own — a builder.
use features.{LanguageFeature, BuilderRow}

export fn grammar_lit() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name          | build
        "grammar_lit" | build_grammar_lit
    }
    component LanguageFeature f {
        name = "grammar_lit"
        docs = "`grammar { … }` — grammar notation read at COMPILE time, expanded to the Grammar it names."
        gram = """
primary = "grammar" "{" s:STRING -> grammar_lit(s)
"""
        builders = rows
    }
    f
}
