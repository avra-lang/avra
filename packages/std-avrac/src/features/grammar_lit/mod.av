//! `grammar { … }` — the grammar DSL, read when the COMPILER runs
//! and not when the program does. The LEXER hands the block's body
//! over whole (its notation is not Avra); the `GrammarLit` node keeps
//! the text and MEANS the same constructors `seed.av` writes by hand,
//! so a feature contributes a Grammar VALUE and assembly never parses
//! anything.
use features.{LanguageFeature}
use features.grammar_lit.{comma_list_open}
use @std.grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}

export fn grammar_lit() -> LanguageFeature {
    LanguageFeature grammar_lit {
        gram: grammar {
            primary = "grammar" "{" source:STRING "}" -> Expr.GrammarLit
        }
    }
    grammar_lit
}
