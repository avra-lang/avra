//! Parse-time lowering: the DSL text READ, and the Grammar it names
//! written back out as the literal that builds it. The parse happens
//! once, while this feature's own file is compiled; assembly then
//! merges values and never parses text.
use core.{Expr, ExprId, Span, Nominal, Plain, Scoped}
use features.{LangNode, Builder}
use @std.grammar.{
    Grammar,
    Rule,
    Alt,
    Seq,
    Item,
    Prim,
    Rep,
    Build,
    Fixed,
    Term,
    Expect,
    Recover,
    Diagnostic,
    Cause,
    Operators,
    Tier,
    Assoc,
    Suffix,
}
use grammar.{parse_grammar}

fn build_grammar_lit(b: Builder) -> Result<LangNode, string> {
    let t = b.token(0)?
    let gp = parse_grammar(t.text)
    // A PARTIAL PARSE IS A TREE WITH TOKENS LEFT. `built` is non-null
    // whenever the start rule hit, so keeping it silently drops every
    // parse diagnostic with it. Coherence defects (`Cause.Defect`, no
    // source anchor) are gated where the assembled grammar validates;
    // everything else here means the text was not read whole.
    if gp.built == null || gp.diagnostics.any(it.cause != Cause.Defect) {
        return .Err(unparsed(gp.diagnostics))
    }
    let writing = b.store.marks()
    let e = b.expr_node(b.store.expr(grammar_expr(b, gp.built!, t.span)))
    b.written_in(writing, "@std.grammar")
    b.store.mark_grammar_lit(e, t.text)
    b.wrap_expr(e)
}

/// The one word a grammar the DSL could not read whole speaks.
fn unparsed(ds: List<Diagnostic>) -> string {
    "the grammar does not parse: ${first_defect(ds)}"
}

/// The first thing wrong with the text, for the builder's one word.
fn first_defect(ds: List<Diagnostic>) -> string {
    let held? = ds.first() else { return "no rule was built" }
    held.message
}

// ── The Grammar, written as the literal that builds it ──

fn grammar_expr(b: Builder, g: Grammar, sp: Span?) -> ExprId {
    let rules = [rule_expr(b, r, sp) for r in g.rules]
    lit_struct(
        b,
        "Grammar",
        ["name", "start", "rules"],
        [text_expr(b, g.name, sp), text_expr(b, g.start, sp), list_expr(b, rules, sp)],
        sp,
    )
}

fn rule_expr(b: Builder, r: Rule, sp: Span?) -> ExprId {
    lit_struct(b, "Rule", ["name", "body"], [text_expr(b, r.name, sp), alt_expr(b, r.body, sp)], sp)
}

fn alt_expr(b: Builder, a: Alt, sp: Span?) -> ExprId {
    let branches = [seq_expr(b, s, sp) for s in a.branches]
    lit_struct(b, "Alt", ["branches"], [list_expr(b, branches, sp)], sp)
}

fn seq_expr(b: Builder, s: Seq, sp: Span?) -> ExprId {
    let items = [item_expr(b, i, sp) for i in s.items]
    lit_struct(
        b,
        "Seq",
        ["items", "build", "recover", "operators", "fold", "seed"],
        [
            list_expr(b, items, sp),
            build_expr(b, s.build, sp),
            recover_expr(b, s.recover, sp),
            operators_expr(b, s.operators, sp),
            text_opt(b, s.fold, sp),
            text_opt(b, s.seed, sp),
        ],
        sp,
    )
}

/// EVERY FIELD IS SPELLED: a field the literal leaves out takes its
/// default, and a mark the notation set then reaches no product —
/// the head marks vanished so, for one generation.
fn item_expr(b: Builder, i: Item, sp: Span?) -> ExprId {
    lit_struct(
        b,
        "Item",
        ["label", "prim", "rep", "expect", "head", "trailer"],
        [
            text_opt(b, i.label, sp),
            prim_expr(b, i.prim, sp),
            rep_expr(b, i.rep, sp),
            expect_expr(b, i.expect, sp),
            bool_expr(b, i.head, sp),
            bool_expr(b, i.trailer, sp),
        ],
        sp,
    )
}

fn prim_expr(b: Builder, p: Prim, sp: Span?) -> ExprId {
    match p {
        .Ref(name) -> variant(b, "Prim", "Ref", [text_expr(b, name, sp)], sp),
        .Lit(text) -> variant(b, "Prim", "Lit", [text_expr(b, text, sp)], sp),
        .Named(term) -> variant(b, "Prim", "Named", [text_expr(b, term, sp)], sp),
        .Group(inner) -> variant(b, "Prim", "Group", [alt_expr(b, inner, sp)], sp),
        .NotChar(inner) -> variant(b, "Prim", "NotChar", [prim_expr(b, inner, sp)], sp),
    }
}

fn rep_expr(b: Builder, r: Rep, sp: Span?) -> ExprId {
    match r {
        .One -> unit(b, "Rep", "One", sp),
        .Star -> unit(b, "Rep", "Star", sp),
        .Plus -> unit(b, "Rep", "Plus", sp),
        .Opt -> unit(b, "Rep", "Opt", sp),
    }
}

fn build_expr(b: Builder, held: Build?, sp: Span?) -> ExprId {
    if held == null { return b.store.alloc_expr(Expr.NullLit, sp) }
    match held! {
        .Var(name) -> variant(b, "Build", "Var", [text_expr(b, name, sp)], sp),
        .Call(name, args) -> variant(
            b,
            "Build",
            "Call",
            [text_expr(b, name, sp), list_expr(b, [text_expr(b, a, sp) for a in args], sp)],
            sp,
        ),
        // SLOTS ARE NOT WRITTEN: binding fills them where the node
        // model lives, and a grammar value carries them unbound.
        .Node(owner, vname, fixed, _) -> variant(
            b,
            "Build",
            "Node",
            [
                text_expr(b, owner, sp),
                text_expr(b, vname, sp),
                list_expr(b, [fixed_expr(b, f, sp) for f in fixed], sp),
                b.store.alloc_expr(Expr.NullLit, sp),
            ],
            sp,
        ),
    }
}

fn fixed_expr(b: Builder, f: Fixed, sp: Span?) -> ExprId {
    let stated? = f.term else {
        return lit_struct(
            b,
            "Fixed",
            ["name", "text"],
            [text_expr(b, f.name, sp), text_expr(b, f.text, sp)],
            sp,
        )
    }
    lit_struct(
        b,
        "Fixed",
        ["name", "text", "term"],
        [text_expr(b, f.name, sp), text_expr(b, f.text, sp), term_expr(b, stated, sp)],
        sp,
    )
}

/// A stated term as the value that builds it: a node's build or a list's
/// items, written whole.
fn term_expr(b: Builder, t: Term, sp: Span?) -> ExprId {
    match t {
        .Text(text) -> variant(b, "Term", "Text", [text_expr(b, text, sp)], sp),
        .Node(built) -> variant(b, "Term", "Node", [build_expr(b, built, sp)], sp),
        .List(items) -> variant(b, "Term", "List", [list_expr(b, [term_expr(b, i, sp) for i in items], sp)], sp),
    }
}

/// An `@operators` block is written as the call that reads its tables
/// off the tiers, so the literal carries only what the notation said.
fn operators_expr(b: Builder, held: Operators?, sp: Span?) -> ExprId {
    if held == null { return b.store.alloc_expr(Expr.NullLit, sp) }
    let tiers = [tier_expr(b, t, sp) for t in held!.tiers]
    b.store.alloc_expr(Expr.Call(Scoped("operators_of"), [], [list_expr(b, tiers, sp)]), sp)
}

fn tier_expr(b: Builder, t: Tier, sp: Span?) -> ExprId {
    let words = [list_expr(b, [text_expr(b, w, sp) for w in word], sp) for word in t.words]
    let suffixes = [suffix_expr(b, x, sp) for x in t.suffixes]
    lit_struct(
        b,
        "Tier",
        ["assoc", "words", "suffixes", "build"],
        [
            assoc_expr(b, t.assoc, sp),
            list_expr(b, words, sp),
            list_expr(b, suffixes, sp),
            build_expr(b, t.build, sp),
        ],
        sp,
    )
}

fn suffix_expr(b: Builder, x: Suffix, sp: Span?) -> ExprId {
    lit_struct(
        b,
        "Suffix",
        ["word", "rule", "build"],
        [text_expr(b, x.word, sp), text_expr(b, x.rule, sp), build_expr(b, x.build, sp)],
        sp,
    )
}

fn assoc_expr(b: Builder, a: Assoc, sp: Span?) -> ExprId {
    match a {
        .Left -> unit(b, "Assoc", "Left", sp),
        .Single -> unit(b, "Assoc", "Single", sp),
        .Unmixed(refusal) -> variant(b, "Assoc", "Unmixed", [text_expr(b, refusal, sp)], sp),
    }
}

fn expect_expr(b: Builder, held: Expect?, sp: Span?) -> ExprId {
    if held == null { return b.store.alloc_expr(Expr.NullLit, sp) }
    lit_struct(b, "Expect", ["message"], [text_expr(b, held!.message, sp)], sp)
}

fn recover_expr(b: Builder, held: Recover?, sp: Span?) -> ExprId {
    if held == null { return b.store.alloc_expr(Expr.NullLit, sp) }
    lit_struct(b, "Recover", ["sync_to"], [text_expr(b, held!.sync_to, sp)], sp)
}

// ── The four shapes every writer above spells ──

fn lit_struct(b: Builder, name: string, fields: List<string>, values: List<ExprId>, sp: Span?) -> ExprId {
    b.store.alloc_expr(Expr.StructLit(Nominal(name), [Plain(t) for t in fields], values), sp)
}

/// A CARRYING variant, built on its own type — what `Prim.Lit` and
/// `Build.Call` are written as.
fn variant(b: Builder, ty: string, name: string, args: List<ExprId>, sp: Span?) -> ExprId {
    let subject = b.store.alloc_expr(Expr.Ident(Scoped(ty)), sp)
    b.store.alloc_expr(Expr.MethodCall(subject, Plain(name), args), sp)
}

/// A variant that CARRIES NOTHING — what `Rep.Star` is written as.
fn unit(b: Builder, ty: string, name: string, sp: Span?) -> ExprId {
    let subject = b.store.alloc_expr(Expr.Ident(Scoped(ty)), sp)
    b.store.alloc_expr(Expr.Prop(subject, Plain(name)), sp)
}

fn bool_expr(b: Builder, v: bool, sp: Span?) -> ExprId {
    b.store.alloc_expr(Expr.BoolLit(v), sp)
}

fn text_expr(b: Builder, s: string, sp: Span?) -> ExprId {
    b.store.alloc_expr(Expr.StrLit(s), sp)
}

fn text_opt(b: Builder, held: string?, sp: Span?) -> ExprId {
    if held == null { return b.store.alloc_expr(Expr.NullLit, sp) }
    text_expr(b, held!, sp)
}

fn list_expr(b: Builder, items: List<ExprId>, sp: Span?) -> ExprId {
    b.store.alloc_expr(Expr.ListLit(items), sp)
}
