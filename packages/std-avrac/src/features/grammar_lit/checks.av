//! The typing rule of a grammar literal: it's the `Grammar` `@std/grammar` declares.
use core.{Checking, Checks, ExprId, Expected, SignedType}

impl Checks for GrammarLit {
    fn checked(mut cx: Checking, e: ExprId, expected: Expected) -> SignedType? { cx.toolchain_type("@std.grammar", "Grammar") }
}
