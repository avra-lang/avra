// `@derive(Fielded)` names a grammar record's authored fields, in order; a
// field marked `@unwritten` is computed later and is no author's. The
// `grammar { }` literal writer takes its names from here.
use @std.grammar.{fields_of_Item, fields_of_Seq, fields_of_Fixed}

spec "features/grammar_lit — the literal writer's field names" {
    given "a record with computed fields" {
        then "an item's authored fields leave out its slot and its listing" {
            fields_of_Item().join(",") == "label,prim,rep,expect,head,trailer"
        }
        then "a branch's authored fields leave out its start" {
            fields_of_Seq().join(",") == "items,build,recover,operators,fold,seed,aliased"
        }
    }
    given "a record with none" {
        then "every field is authored, in order" { fields_of_Fixed().join(",") == "name,text,term" }
    }
}
