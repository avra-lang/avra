//! The select NodeSemantics: dispatch only. A `select`'s arms are its
//! kids. An arm's head is read OUTSIDE the names the arm binds, so it
//! is a kid; its guard and its body are walked by the arm itself, under
//! the scope it opens. The body answers for the arm, and each arm for
//! the `select`, so the seat's want flows down both.
use core.{ExprId, Kids, Heirs}
use features.{ResolveCx}

impl Kids for Select {
    fn kids() -> List<ExprId> { self.arms }
}
impl Kids for WaitArm {
    fn kids() -> List<ExprId> { [self.head] }
}
impl Kids for ElseArm {
    fn kids() -> List<ExprId> { [self.value] }
}
impl Heirs for Select {
    fn heirs() -> List<ExprId> { self.arms }
}
impl Heirs for WaitArm {
    fn heirs() -> List<ExprId> { [self.value] }
}
impl Heirs for ElseArm {
    fn heirs() -> List<ExprId> { [self.value] }
}

/// An arm's guard and its body, each under the names the arm binds. The
/// guard may read none of them — typing refuses one that does — and
/// binding them here keeps that the only word spoken about it.
fn resolve_arm(mut cx: ResolveCx, e: ExprId, names: List<string>, guard: ExprId?, value: ExprId) {
    let binds = cx.bound_at(e, names)
    if guard != null { cx.arm_scope(binds, guard!) }
    cx.arm_scope(binds, value)
}
