//! The lowering rule of a `select` — ONE mechanism: THE SCAN CHOOSES, THE PARK ONLY WAKES. Each guard,
//! then its head, is read once, in written order — a false guard reads no head. Then one loop: a scan
//! begins (where a cancel or a passed limit is heard), the arms are asked top to bottom, and the first
//! that is ready is taken — its answer bound, its body run, the loop left. With none ready an `else`
//! lets the world run and answers; without one each arm is filed and the task rests, and the claim
//! that wakes it is only a hint: the next turn scans again. A head that makes its tasks where it is
//! written is joined as the scope around the `select` ends, as a bound `spawn` is.
use core.{
    BinOp,
    Bound,
    CalledFn,
    ExprId,
    FieldSeat,
    Layout,
    Lowering,
    Lowers,
    NamedValue,
    OwnType,
    Reg,
    SignedType,
    TypeHead,
    WaitProbe,
    flatten,
    headed_type,
    owned_type,
    rt_sig_of,
    some_list,
    supplied,
}
use @std.program.address.{SourceFileAddress}

impl Lowers for Select {
    fn lowered(mut cx: Lowering, e: ExprId) -> Reg {
        if self.fair { return cx.missed_as("a `@fair` `select`") }
        scanned(cx, e, self.arms)
    }
}

impl Lowers for WaitArm {
    fn lowered(mut cx: Lowering, e: ExprId) -> Reg { cx.missed_as(apart()) }
}

impl Lowers for ElseArm {
    fn lowered(mut cx: Lowering, e: ExprId) -> Reg { cx.missed_as(apart()) }
}

/// What an arm lowered apart from its `select` is.
fn apart() -> string { "a `select` arm apart from its `select`" }

/// What an arm's head is, as the scan reads it: a task, a list of them, a running supply, that
/// supply's end, or an instant.
enum Waits {
    Task
    Tasks
    Source
    Ended
    Timer
}

/// One waiting arm as the scan reads it: its place among the arms; its head as written, its
/// register and its type; what one of its tasks answers, or what its supply hands over; its guard's
/// answer when one is written, a false one leaving the arm dead for the whole `select`; for a list,
/// the cell the scan leaves its pick in; the names it binds, index first; its body.
type ArmWait = {
    at: int,
    source: ExprId,
    head: Reg,
    head_ty: SignedType,
    answer: SignedType,
    live: Reg?,
    pick: Reg?,
    index: string,
    bind: string,
    value: ExprId,
    kind: Waits,
}

/// A `select` laid out for its loop: the waiting arms in written order, the `else` body when one
/// stands, and the cell its answer is kept in — none for a `select` answering nothing.
type Scanning = { waits: List<ArmWait>, other: ExprId?, answer: Reg? }

/// The heads, then the loop, then the answer the taken arm left.
fn scanned(mut cx: Lowering, e: ExprId, arms: List<ExprId>) -> Reg {
    let ty? = cx.type_at(e) else { return cx.missed_as("an untyped `select`") }
    let waits = flatten([some_list(arm_of(cx, a, j)) for j, a in arms])
    let other = flatten([some_list(else_body(cx, a)) for a in arms]).first()
    if waits.length + some_list(other).length != arms.length { return answered_none(cx, ty) }
    let answer: Reg? = if ty.holds_value() { cx.seeded_cell(cx.laid_out(ty), cx.hollow_of(ty)) } else { null }
    let site = cx.const_str(wait_site(cx, e))
    let s = Scanning { waits: waits, other: other, answer: answer }
    cx.loop_start()
    cx.unwritten()
    cx.loop_cond(cx.const_bool(true))
    let _ = cx.call_row(Layout.Word, rt_sig_of("avra_wait_enter")!, [site])
    scan_from(cx, s, 0)
    cx.loop_end()
    let kept? = answer else { return answered_none(cx, ty) }
    cx.loaded(cx.laid_out(ty), kept)
}

/// What a `select` of `ty` answers where no arm's value is kept: nothing, for one whose arms all
/// leave.
fn answered_none(mut cx: Lowering, ty: SignedType) -> Reg { cx.hollow_of(if ty.bottom() { owned_type("void") } else { ty }) }

/// Where the `select` was written, its file and its offset there: the task's record keeps this text,
/// so a listing says where a task rests.
fn wait_site(cx: Lowering, e: ExprId) -> string {
    let at? = cx.store.expr_span(e) else { return cx.program.home }
    "${cx.program.home}@${at.lo}"
}

/// A waiting arm read for the scan: its guard and its head lowered here, once. Null for the `else`
/// arm, and for a head no lowering stands for yet, noted.
fn arm_of(mut cx: Lowering, arm: ExprId, at: int) -> ArmWait? {
    // a feature cannot enumerate OTHER features' variants
    match cx.store.expr(arm) {
        .WaitArm(index, bind, head, guard, value) -> arm_wait(
            cx,
            Arm { at: at, index: index.of, bind: bind.of, head: head, guard: guard, value: value },
        ),
        rest -> null,
    }
}

/// An arm as written: its place, the names it binds, its head, its guard and its body.
type Arm = { at: int, index: string, bind: string, head: ExprId, guard: ExprId?, value: ExprId }

/// The body of an `else` arm; null for an arm that waits.
fn else_body(cx: Lowering, arm: ExprId) -> ExprId? {
    // a feature cannot enumerate OTHER features' variants
    match cx.store.expr(arm) { .ElseArm(value) -> value, rest -> null }
}

/// An arm over a task, a list of tasks, a running supply or its `.ended`, or an instant; any other
/// head is noted.
fn arm_wait(mut cx: Lowering, a: Arm) -> ArmWait? {
    let ended? = ended_supply(cx, a.head) else { return typed_wait(cx, a) }
    let ty? = cx.type_at(ended) else { return unwaitable(cx, "an `.ended` arm whose supply is untyped") }
    if supplied(ty) == null { return unwaitable(cx, "an `.ended` arm over no `Source`") }
    head_read(cx, a with { head: ended }, ty, owned_type("bool"), Waits.Ended)
}

/// An arm by the type its head is.
fn typed_wait(mut cx: Lowering, a: Arm) -> ArmWait? {
    let ty? = cx.type_at(a.head) else { return unwaitable(cx, "an arm whose head is untyped") }
    if ty.owns(OwnType.Task) && ty.args.length == 1 { return head_read(cx, a, ty, ty.args[0], Waits.Task) }
    let member = task_answer(ty.listed())
    if member != null { return head_read(cx, a, ty, member!, Waits.Tasks) }
    let item = supplied(ty)
    if item != null { return head_read(cx, a, ty, item!, Waits.Source) }
    if declared_in(ty, "@std/time", "Deadline") != null { return instant_wait(cx, a, deadline_at(cx, ty, cx.lower(a.head))) }
    if declared_in(ty, "@std/time", "Quiet") != null { return instant_wait(cx, a, quiet_at(cx, ty, cx.lower(a.head))) }
    unwaitable(cx, "an arm waiting on `${ty.spelled()}`")
}

/// The file declaring `ty`, where it's the type `package` declares as `name`.
fn declared_in(ty: SignedType, package: string, name: string) -> TypeHead? {
    match ty.head {
        .Declared(file, n) -> if n == name && file.package_name == package && !ty.nullable() { ty.head } else { null },
        rest -> null,
    }
}

/// The supply an `.ended` head names, when the head is written so.
fn ended_supply(cx: Lowering, head: ExprId) -> ExprId? {
    // a feature cannot enumerate OTHER features' variants
    match cx.store.expr(head) {
        .Prop(subject, name) -> if name.of == "ended" { subject } else { null },
        rest -> null,
    }
}

/// A timer arm: its guard read, then its instant, once.
fn instant_wait(mut cx: Lowering, a: Arm, instant: Reg) -> ArmWait {
    ArmWait {
        at: a.at,
        source: a.head,
        head: instant,
        head_ty: owned_type("int"),
        answer: owned_type("int"),
        live: if a.guard == null { null } else { cx.lower(a.guard!) },
        pick: null,
        index: "",
        bind: "",
        value: a.value,
        kind: Waits.Timer,
    }
}

/// A `Deadline`'s own instant.
fn deadline_at(mut cx: Lowering, ty: SignedType, deadline: Reg) -> Reg { field_of(cx, deadline, ty, "at") ?? cx.missed_as("a `Deadline` without its instant") }

/// A `quiet(d)` arm's instant: `d` from this entry, read through `@std/time`'s own `after`, so the
/// span's arithmetic and the clock are the library's, never a second copy.
fn quiet_at(mut cx: Lowering, ty: SignedType, quiet: Reg) -> Reg {
    let span? = field_of(cx, quiet, ty, "span") else { return cx.missed_as("a `Quiet` without its span") }
    let file? = declaring_file(ty) else { return cx.missed_as("a `Quiet` no file declares") }
    let after? = time_after(cx, "${file.package_name}:${file.path_in_package}") else { return cx.missed_as("a `Quiet` without `@std/time`'s `after`") }
    let deadline = headed_type(TypeHead.Declared(file, "Deadline"))
    deadline_at(cx, deadline, cx.call_fn(cx.laid_out(deadline), after, [span]))
}

/// The file declaring `ty`, where a file does.
fn declaring_file(ty: SignedType) -> SourceFileAddress? {
    match ty.head { .Declared(f, _) -> f, rest -> null }
}

/// `@std/time`'s `after`, read in the file `home` names.
fn time_after(cx: Lowering, home: string) -> CalledFn? {
    let named? = (cx.program.named)("after", home) else { return null }
    match named { .Fn(c) -> c, rest -> null }
}

/// The field `name` of the record `v` of `ty`.
fn field_of(mut cx: Lowering, v: Reg, ty: SignedType, name: string) -> Reg? {
    let fields? = cx.fields_of(ty) else { return null }
    let n? = fields.find_index(it.name == name) else { return null }
    let laid? = cx.seat_layouts(fields) else { return null }
    cx.field_read(v, ty, laid, n)
}

/// The arm's guard, then its head, read here; a list's pick cell made; a head that makes its tasks
/// joined where the scope around the `select` ends.
fn head_read(mut cx: Lowering, a: Arm, head_ty: SignedType, answer: SignedType, kind: Waits) -> ArmWait {
    let live: Reg? = if a.guard == null { null } else { cx.lower(a.guard!) }
    let read = head_guarded(cx, live, a.head, head_ty)
    if (kind is .Task || kind is .Tasks) && makes_tasks(cx.store.expr(a.head).wait_probe()) { cx.owns(read, head_ty) }
    ArmWait {
        at: a.at,
        source: a.head,
        head: read,
        head_ty: head_ty,
        answer: answer,
        live: live,
        pick: if kind is .Tasks { cx.seeded_cell(Layout.Word, cx.const_int(-1)) } else { null },
        index: a.index,
        bind: a.bind,
        value: a.value,
        kind: kind,
    }
}

/// Whether a head's tasks are made where it is written, and so owned by no binding: only a head whose
/// node says it makes one — a call, a method, a spawn, a record, a select. A node that says nothing
/// (a plain name among them) reads what a binding owns.
fn makes_tasks(probe: WaitProbe) -> bool {
    match probe {
        .Call or .Method or .Value or .Spawn or .Record or .Select -> true,
        .None or .Read or .Chain -> false,
    }
}

/// A head read under its guard: a false guard reads none.
fn head_guarded(mut cx: Lowering, live: Reg?, head: ExprId, ty: SignedType) -> Reg {
    let open? = live else { return cx.lower(head) }
    cx.region(open, cx.laid_out(ty)) { cx -> cx.lower(head) } else { cx -> cx.hollow_of(ty) }
}

/// THE SCAN, from arm `j` down: the first ready arm is taken; past the last, nothing was.
fn scan_from(mut cx: Lowering, s: Scanning, j: int) {
    if j == s.waits.length { return nothing_ready(cx, s) }
    let w = s.waits[j]
    cx
        .void_branches(arm_ready(cx, w)) { cx -> arm_taken(cx, s, w) } else { cx -> scan_from(cx, s, j + 1) }
}

/// Whether an arm may be taken: it is live, and what it waits on is ready.
fn arm_ready(mut cx: Lowering, w: ArmWait) -> Reg {
    let open? = w.live else { return arm_fired(cx, w) }
    cx.region(open, Layout.Truth) { cx -> arm_fired(cx, w) } else { cx -> cx.const_bool(false) }
}

/// A task is ready when it has ended, a list when a member answered, a supply when it has an item,
/// an `.ended` arm when the supply ended, an instant when the clock passed it.
fn arm_fired(mut cx: Lowering, w: ArmWait) -> Reg {
    match w.kind {
        .Task -> task_ended(cx, w.head),
        .Tasks -> first_stamped(cx, w, w.pick!),
        .Source -> supply_called(cx, w, "ready", []),
        .Ended -> supply_called(cx, w, "ended", []),
        .Timer -> nonzero(cx, cx.call_row(Layout.Word, rt_sig_of("avra_time_since")!, [w.head])),
    }
}

/// Whether a word isn't zero.
fn nonzero(mut cx: Lowering, r: Reg) -> Reg { cx.bin(Layout.Truth, BinOp.Ne, r, cx.const_int(0)) }

/// Whether a task has ended — answered or cancelled, it is ready: the take joins it, and a cancelled
/// one passes its cancel on there.
fn task_ended(mut cx: Lowering, task: Reg) -> Reg { nonzero(cx, cx.call_row(Layout.Word, rt_sig_of("avra_task_done")!, [task])) }

/// A LIST ARM FIRES FOR THE MEMBER THAT ANSWERED FIRST — the least stamp, never the lowest index. A
/// member still running, and one that ended cancelled, reads no stamp and is passed over. The pick is
/// left in its cell: the member's index, or -1.
fn first_stamped(mut cx: Lowering, w: ArmWait, pick: Reg) -> Reg {
    cx.stored(pick, cx.const_int(-1))
    let least = cx.seeded_cell(Layout.Word, cx.const_int(0))
    let member = w.head_ty.listed()!
    let walk = cx.walk_list(w.head, member)
    let at = cx.walk_turn(walk)
    let since = cx
        .call_row(Layout.Word, rt_sig_of("avra_task_since")!, [cx.element_at(walk.elem_layout, w.head, at)])
    cx
        .void_region(stamp_earlier(cx, since, cx.loaded(Layout.Word, least))) { cx ->
            cx.stored(least, since)
            cx.stored(pick, at)
        }
    cx.loop_end()
    cx.bin(Layout.Truth, BinOp.Ge, cx.loaded(Layout.Word, pick), cx.const_int(0))
}

/// Whether a stamp is an answer's, and before the least seen so far.
fn stamp_earlier(mut cx: Lowering, since: Reg, least: Reg) -> Reg {
    cx
        .region(nonzero(cx, since), Layout.Truth) { cx -> stamped_before(cx, since, least) } else { cx -> cx.const_bool(false) }
}

fn stamped_before(mut cx: Lowering, since: Reg, least: Reg) -> Reg {
    let first = cx.bin(Layout.Truth, BinOp.Eq, least, cx.const_int(0))
    cx
        .region(first, Layout.Truth) { cx -> cx.const_bool(true) } else { cx -> cx.bin(Layout.Truth, BinOp.Lt, since, least) }
}

/// One of a supply's verbs called through its box: a supply's verbs are values on the record, so the
/// lowering calls them, never a row.
fn supply_called(mut cx: Lowering, w: ArmWait, name: string, args: List<Reg>) -> Reg {
    let fields? = cx.fields_of(w.head_ty) else { return cx.missed_as("a supply whose fields aren't known") }
    let n? = fields.find_index(it.name == name) else { return cx.missed_as("a supply without its `${name}`") }
    let laid? = cx.seat_layouts(fields) else { return cx.missed_as("a supply whose fields aren't laid out") }
    let f = fields[n].ty!
    let answer = f.answer ?? owned_type("void")
    let box = cx.field_read(w.head, w.head_ty, laid, n)
    cx.called_code(cx.laid_out(answer), cx.code_of(box), box, args, f)
}

/// What a supply's `taken` hands over: its item, the nullable unwrapped because `ready` was already
/// true when the scan chose the arm.
fn supply_item(mut cx: Lowering, w: ArmWait) -> Reg { cx.carried(supply_called(cx, w, "taken", []), w.answer with { nulls: w.answer.nulls + 1 }) }

/// A ready arm taken: the names it binds bound — its task joined, for a list the member the scan
/// picked, for a supply what `taken` hands over — its body run, and the loop left with what it
/// answered.
fn arm_taken(mut cx: Lowering, s: Scanning, w: ArmWait) {
    cx.opened()
    match w.kind {
        .Task -> bound(cx, w.bind, cx.awaited_reg(cx.laid_out(w.answer), w.head), w.answer),
        .Tasks -> picked(cx, w),
        .Source -> bound(cx, w.bind, supply_item(cx, w), w.answer),
        .Ended or .Timer -> nothing_bound(),
    }
    arm_left(cx, s, w.value)
}

/// A list arm's names bound: the place of the member the scan picked, then its answer, joined.
fn picked(mut cx: Lowering, w: ArmWait) {
    let at = cx.loaded(Layout.Word, w.pick!)
    let member = cx.element_at(cx.laid_out(w.head_ty.listed()!), w.head, at)
    bound(cx, w.index, at, owned_type("int"))
    bound(cx, w.bind, cx.awaited_reg(cx.laid_out(w.answer), member), w.answer)
}

/// What an arm handing nothing over binds.
fn nothing_bound() {}

/// `name` bound to `r`, of `ty`, where the arm names it; `_` and an unwritten one bind nothing.
fn bound(mut cx: Lowering, name: string, r: Reg, ty: SignedType) {
    if name == "" || name == "_" { return }
    cx.bind(name, Bound.Value(r, ty))
}

/// Nothing is ready. An `else` lets the world run, then answers; with none, every arm is filed and
/// the task rests until one may be ready.
fn nothing_ready(mut cx: Lowering, s: Scanning) {
    let other? = s.other else { return all_filed(cx, s) }
    cx.run_row(rt_sig_of("avra_fiber_yield")!, [])
    cx.opened()
    arm_left(cx, s, other)
}

fn all_filed(mut cx: Lowering, s: Scanning) {
    for w in s.waits { arm_filed(cx, w) }
    let _ = cx.call_row(Layout.Word, rt_sig_of("avra_wait_rest")!, [])
}

/// A live arm filed for the rest.
fn arm_filed(mut cx: Lowering, w: ArmWait) {
    let open? = w.live else { return filed_wait(cx, w) }
    cx.void_region(open) { cx -> filed_wait(cx, w) }
}

/// What the arm waits on, filed: its task, or each member still running — one that has ended, either
/// way, can wake nobody; a supply files its OWN wake through `arm`, so the row it calls is the
/// library's.
fn filed_wait(mut cx: Lowering, w: ArmWait) {
    match w.kind {
        .Task -> cx.run_row(rt_sig_of("avra_wait_task")!, [w.head, cx.const_int(w.at), cx.const_int(0)]),
        .Source or .Ended -> {
            let _ = supply_called(cx, w, "arm", [cx.const_int(w.at)])
        },
        .Timer -> cx.run_row(rt_sig_of("avra_wait_until")!, [w.head, cx.const_int(w.at), cx.const_int(0)]),
        .Tasks -> {
            let walk = cx.walk_list(w.head, w.head_ty.listed()!)
            let at = cx.walk_turn(walk)
            let member = cx.element_at(walk.elem_layout, w.head, at)
            let runs = cx
                .bin(
                    Layout.Truth,
                    BinOp.Eq,
                    cx.call_row(Layout.Word, rt_sig_of("avra_task_done")!, [member]),
                    cx.const_int(0),
                )
            cx
                .void_region(runs) { cx -> cx.run_row(rt_sig_of("avra_wait_task")!, [member, cx.const_int(w.at), at]) }
            cx.loop_end()
        },
    }
}

/// A body run in the scope its arm opened, as the `select`'s answer, and the loop left; a body that
/// leaves has left already.
fn arm_left(mut cx: Lowering, s: Scanning, value: ExprId) {
    let r = cx.lower(value)
    let leaves = cx.store.leaves(value)
    if s.answer != null && !leaves { cx.stored(s.answer!, r) }
    cx.closed()
    if !leaves { cx.jumped(false) }
}

/// A head no lowering stands for yet, noted, and no wait.
fn unwaitable(mut cx: Lowering, what: string) -> ArmWait? {
    cx.missed(what)
    null
}
