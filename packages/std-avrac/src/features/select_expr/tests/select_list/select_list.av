// proves: a list arm fires for the member that ANSWERED FIRST — the
// last index here — binds its answer and its index, passes over a
// member that ended cancelled, and rests while none has answered — in
// both engines
use @std.task.{open_channel, Sink}
use @std.time.{ms, sleep}

fn after(wait: int, n: int) -> int {
    sleep(ms(wait))
    n
}

fn never(up: Sink<int>) -> int {
    let silent = open_channel<int>(1)
    let _ = up.post(1)
    let _ = silent.source.next()
    0
}

let race = [spawn after(40, 1), spawn after(2, 2)]
let first = select {
    i, r in race -> r * 10 + i
}
let up = open_channel<int>(1)
let cut = [spawn never(up.sink), spawn after(2, 7)]
let _ = up.source.next()
cut[0].cancel()
let kept = select {
    i, r in cut -> r * 10 + i
}
"${first} ${kept} ${cut[0].done}"
