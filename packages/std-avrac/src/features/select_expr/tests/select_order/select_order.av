// proves: ORDER IS PRIORITY — with two arms ready the upper one is
// taken, whichever was written to finish first, in both engines
fn answer(n: int) -> int { n }

let a = spawn answer(1)
let b = spawn answer(2)
let both = a.await + b.await
let upper = select {
    x in b -> x
    y in a -> y
}
let lower = select {
    y in a -> y
    x in b -> x
}
"${both} ${upper} ${lower}"
