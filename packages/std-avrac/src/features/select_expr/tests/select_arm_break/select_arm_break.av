// proves: a `break` or a `continue` written in an arm's body leaves or
// turns the loop the program wrote around the `select`, never the scan's
// own — in both engines
fn answer(n: int) -> int { n }

let t = spawn answer(5)
let _ = t.await
mut n = 0
mut skipped = 0
while true {
    n = n + 1
    select {
        r in t -> {
            if n < 3 {
                skipped = skipped + r
                continue
            }
            break
        }
    }
}
"${n} ${skipped}"
