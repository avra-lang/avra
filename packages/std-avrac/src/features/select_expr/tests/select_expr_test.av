// The front end, vertically: every arm form parses and prints back as
// written, the laws a builder holds are spoken in its words, and a
// `select` that types is refused by name where it is lowered.
use @std.avrac.testing.{
    projected,
    refused_with,
    refused_at_run,
    refusals,
    refused_in,
    floored_beside,
    answered,
    shown,
    ir_of,
    said,
}
use compiler.{Program}
use compiler.backend.{render_ir}

/// Whether `source` is its own canonical form — it parsed, and the
/// printer said it back unchanged.
fn stands(source: string) -> bool {
    projected(source) == source
}

/// Whether each of `marks` stands in `text` past the one before it.
fn in_order(text: string, marks: List<string>) -> bool {
    mut rest = text
    for m in marks {
        let at = rest.index_of(m)
        if at < 0 { return false }
        rest = rest.substring(at + m.length, rest.length)
    }
    true
}

/// One task answering an `int`, one answering nothing, and a list of
/// two — what the typing cases wait on.
fn tasks() -> string {
    "fn one() -> int {\n    1\n}\nfn hush() {\n}\nlet job = spawn one()\nlet mute = spawn hush()\nlet jobs = [spawn one(), spawn one()]\n"
}

/// Whether a `select` over those tasks types clean.
fn types(body: string) -> bool {
    refusals("${tasks()}${body}") == 0
}

/// Whether a `select` over those tasks is refused in typing's words.
fn refuses(body: string, phrase: string) -> bool {
    refused_with("${tasks()}${body}", phrase)
}

/// A stand-in `@std/time`: the three timers by name, and a maker each.
fn timers() -> string {
    "export type Deadline = { at: int }\nexport type Quiet = { span: int }\nexport type Every = { period: int }\nexport fn after(n: int) -> Deadline {\n    Deadline { at: n }\n}\nexport fn quiet(n: int) -> Quiet {\n    Quiet { span: n }\n}\nexport fn every(n: int) -> Every {\n    Every { period: n }\n}\n"
}

/// A program over the stand-in timers.
fn timed(body: string) -> Program {
    floored_beside("use @std.time.{after, quiet, every}\n${body}", "time", timers())
}

/// A stand-in `@std/task`: the two supplies by name, enough for the
/// front end to type against.
fn sources() -> string {
    "export type Source<T> = { ready: fn() -> bool, taken: fn() -> T?, arm: fn(int) -> void, ended: fn() -> bool, lost: fn() -> int }\nexport type Pick<T> = { at: int, item: T }\nexport type AnyOf<T> = { ready: fn() -> bool, taken: fn() -> Pick<T>?, ended: fn() -> bool, lost: fn() -> int }\n"
}

/// A program over the stand-in supplies.
fn supplies(body: string) -> Program {
    floored_beside("use @std.task.{Source, AnyOf}\n${body}", "task", sources())
}

/// Whether a floored program analyzes clean.
fn clean(p: Program) -> bool { said(p).is_empty() }

spec "features/select_expr" {
    given "the arm forms" {
        then "a bare head" { stands("select {\n    stop -> halt()\n}") }
        then "a head whose answer is bound" { stands("select {\n    r in job -> use(r)\n}") }
        then "an index beside the binder" {
            stands("select {\n    i, page in mirrors -> keep(i, page)\n}")
        }
        then "a binder that binds nothing" { stands("select {\n    _ in ts -> done()\n}") }
        then "an index and no value" { stands("select {\n    i, _ in ts -> done(i)\n}") }
        then "a guard before the arrow" { stands("select {\n    r in job if open -> use(r)\n}") }
        then "a guard on a bare head" { stands("select {\n    stop if armed -> halt()\n}") }
        then "a head made where it is written" {
            stands("select {\n    p in spawn fetch(url) -> pages.push(p)\n}")
        }
        then "a block for a body" { stands("select {\n    limit -> {\n        return pages\n    }\n}") }
        then "`else`, last" { stands("select {\n    r in job -> use(r)\n    else -> idle()\n}") }
        then "several arms, in written order" {
            stands("select {\n    stop -> halt()\n    r in job -> use(r)\n    limit -> late()\n}")
        }
    }
    given "its positions" {
        then "a value" { stands("let page = select {\n    page in mirrors -> page\n}") }
        then "one line, commas between arms, prints one arm a line" {
            projected("select { stop -> halt(), r in job -> use(r) }") == "select {\n    stop -> halt()\n    r in job -> use(r)\n}"
        }
        then "a trailing comma" {
            projected("select { stop -> halt(), }") == "select {\n    stop -> halt()\n}"
        }
    }
    given "the `@fair` mark" {
        then "on a statement" { stands("@fair select {\n    a in left -> merge(a)\n}") }
        then "on a value" { stands("let v = @fair select {\n    a in left -> a\n}") }
    }
    given "what a builder refuses" {
        then "a catch-all arm" {
            refused_with(
                "select {\n    _ -> 1\n}",
                "a `select` has no catch-all — `else ->` runs when nothing is ready",
            )
        }
        then "an `else` arm that is not last" {
            refused_with(
                "select {\n    else -> 1\n    stop -> 2\n}",
                "the `else` arm ends a `select` — move it last",
            )
        }
        then "two `else` arms" {
            refused_with(
                "select {\n    stop -> 0\n    else -> 1\n    else -> 2\n}",
                "a `select` has ONE `else` arm",
            )
        }
        then "no arm at all" {
            refused_with("select { }", "a `select` needs an arm to wait on")
        }
        then "`else` alone" {
            refused_with("select {\n    else -> 1\n}", "a `select` needs an arm to wait on")
        }
        then "another mark" {
            refused_with(
                "let v = @slow select {\n    stop -> 1\n}",
                "a `select` reads one mark, `@fair` — `@slow` is not it",
            )
        }
    }
    given "what an arm binds" {
        then "a task arm binds the task's answer" { types("let v: int = select {\n    r in job -> r + 1\n}\nv") }
        then "a bare head binds nothing" { types("let v = select {\n    job -> 1\n}\nv") }
        then "`_` binds nothing, over a task that answers nothing too" {
            types("let v = select {\n    _ in mute -> 1\n}\nv")
        }
        then "a list arm binds the member's answer" {
            types("let v: int = select {\n    r in jobs -> r + 1\n}\nv")
        }
        then "a list arm's index is an int, bound before the answer" {
            types("let v: int = select {\n    i, r in jobs -> i + r\n}\nv")
        }
        then "an index beside `_` is still bound" { types("let v: int = select {\n    i, _ in jobs -> i\n}\nv") }
        then "an index on one task is refused" {
            refuses(
                "select {\n    i, r in job -> r\n}",
                "`i` counts a list's members, and this arm waits on one task",
            )
        }
        then "a name over a task that answers nothing is refused" {
            refuses("select {\n    r in mute -> 1\n}", "a task answering nothing binds nothing")
        }
        then "an index over a list written in the head is refused" {
            refuses(
                "select {\n    i, r in [spawn one()] -> r\n}",
                "`i` counts the members of a list written in the head",
            )
        }
        then "a list written in the head without an index types" {
            types("let v: int = select {\n    r in [spawn one()] -> r\n}\nv")
        }
    }
    given "what an arm waits on" {
        then "a head that is no task, list of tasks, source or timer is refused" {
            refuses(
                "select {\n    1 -> 2\n}",
                "a `select` arm waits on a task, a list of tasks, a source or a timer, and this is `int`",
            )
        }
        then "an awaited head is refused as the value it already is" {
            refuses(
                "select {\n    job.await -> 2\n}",
                "a head ending `.await` has already waited: drop it",
            )
        }
        then "a list arm inside a loop is refused" {
            refuses(
                "mut n = 0\nwhile n < 1 {\n    n = n + select {\n        r in jobs -> r\n    }\n}",
                "a list arm is taken once",
            )
        }
        then "a list arm inside a loop is refused under a guard too" {
            refuses(
                "mut n = 0\nwhile n < 1 {\n    n = n + select {\n        r in jobs if n == 0 -> r\n    }\n}",
                "a list arm is taken once",
            )
        }
        then "a list arm inside a comprehension is refused — it runs once an element" {
            refuses(
                "let all = [select {\n    r in jobs -> r + x\n} for x in [1, 2]]",
                "a list arm is taken once",
            )
        }
        then "a list arm inside a lambda written in a loop types — the lambda's body is its own" {
            types(
                "mut n = 0\nwhile n < 1 {\n    let pick = () -> {\n        let mine = [spawn one()]\n        select {\n            r in mine -> r\n        }\n    }\n    n = n + pick()\n}\nn",
            )
        }
        then "a task arm inside a loop types" {
            types(
                "mut n = 0\nwhile n < 1 {\n    n = n + select {\n        r in job -> r\n    }\n}\nn",
            )
        }
    }
    given "a running source" {
        then "a source arm binds the item it takes" {
            clean(
                supplies(
                    "fn pick(src: Source<int>) -> int {\n    select {\n        x in src -> x\n        src.ended -> 0\n    }\n}\n0",
                ),
            )
        }
        then "a source with no `.ended` arm is refused by name, and the fix is named" {
            refused_in(
                supplies(
                    "fn pick(src: Source<int>) -> int {\n    select {\n        x in src -> x\n    }\n}\n0",
                ),
                "`src` can end and this `select` does not say what then",
            )
        }
        then "a source head that is a call is refused rather than skipped" {
            refused_in(
                supplies(
                    "fn same(src: Source<int>) -> Source<int> {\n    src\n}\nfn pick(src: Source<int>) -> int {\n    select {\n        x in same(src) -> x\n    }\n}\n0",
                ),
                "a supply made by a call cannot be named, so no `.ended` arm can answer for it",
            )
        }
        then "an `.ended` arm behind a guard does not answer for the supply" {
            refused_in(
                supplies(
                    "fn pick(src: Source<int>) -> int {\n    select {\n        x in src -> x\n        src.ended if false -> 0\n    }\n}\n0",
                ),
                "`src` can end and this `select` does not say what then",
            )
        }
        then "the `.ended` arm's subject decides whose end it is" {
            refused_in(
                supplies(
                    "fn pick(a: Source<int>, b: Source<int>) -> int {\n    select {\n        x in a -> x\n        b.ended -> 0\n    }\n}\n0",
                ),
                "`a` can end and this `select` does not say what then",
            )
        }
        then "two fields of one receiver are told apart" {
            refused_in(
                supplies(
                    "type Box = { a: Source<int>, b: Source<int> }\nfn pick(x: Box) -> int {\n    select {\n        v in x.a -> v\n        x.b.ended -> 0\n    }\n}\n0",
                ),
                "`x.a` can end and this `select` does not say what then",
            )
        }
        then "an index on a source is refused" {
            refused_in(
                supplies(
                    "fn pick(src: Source<int>) -> int {\n    select {\n        i, x in src -> x\n        src.ended -> 0\n    }\n}\n0",
                ),
                "counts a list's members, and a source hands one item at a time",
            )
        }
        then "an `.ended` arm binds nothing" {
            refused_in(
                supplies(
                    "fn pick(src: Source<int>) -> int {\n    select {\n        x in src -> x\n        e in src.ended -> 0\n    }\n}\n0",
                ),
                "an `.ended` arm waits on a supply's end and binds nothing",
            )
        }
        then "an `.ended` read off a type that is no supply is no arm at all" {
            refused_in(
                supplies(
                    "type Skin = { ended: bool }\nfn pick(s: Skin) -> int {\n    select {\n        s.ended -> 0\n    }\n}\n0",
                ),
                "a `select` arm waits on a task, a list of tasks, a source or a timer",
            )
        }
        then "an `AnyOf` arm types and its end is required too" {
            refused_in(
                supplies(
                    "fn pick(a: AnyOf<int>) -> int {\n    select {\n        x in a -> x\n    }\n}\n0",
                ),
                "`a` can end and this `select` does not say what then",
            )
        }
    }
    given "a guard" {
        then "a bool read from outside the arm types" {
            types("let open = true\nlet v = select {\n    r in job if open -> r\n}\nv")
        }
        then "one that is no bool is refused" {
            refuses("select {\n    r in job if 1 -> r\n}", "a `select` arm's guard")
        }
        then "one that reads its own arm's binder is refused" {
            refuses(
                "select {\n    r in job if r > 0 -> r\n}",
                "a guard is read before its arm's head, so it reads no name the arm binds",
            )
        }
    }
    given "the answer" {
        then "arms that agree give the `select` their type" {
            types("let v: int = select {\n    r in job -> r\n    else -> 0\n}\nv")
        }
        then "arms that disagree are refused" {
            refuses(
                "let v = select {\n    r in job -> r\n    else -> \"none\"\n}",
                "a `select`'s arms disagree",
            )
        }
        then "a name the arm binds is not read by a later arm" {
            refuses("select {\n    r in job -> r\n    else -> r\n}", "`r` is not defined")
        }
    }
    given "the timers of `@std/time`" {
        then "a `Deadline` head is an arm that fires when it has come" {
            answered(
                timed("let limit = after(5)\nlet v = select {\n    limit -> 1\n}\n\"\${v}\"\n"),
            ) == "1"
        }
        then "a binder on a timer arm is refused" {
            refused_in(
                timed("let limit = after(5)\nselect {\n    r in limit -> 1\n}\n"),
                "a timer arm binds nothing",
            )
        }
        then "a `Quiet` beside `else` is refused — it is never taken" {
            refused_in(
                timed("let calm = quiet(5)\nselect {\n    calm -> 1\n    else -> 2\n}\n"),
                "a `Quiet` beside `else` is never taken",
            )
        }
        then "an `Every` beside `else` types" {
            answered(
                timed(
                    "let tick = every(5)\nlet v = select {\n    tick -> 1\n    else -> 2\n}\nprintln(\"\${v}\")\n",
                ),
            )
                .contains("`select` type-checks but lowers to nothing")
        }
    }
    given "a timer made inside a loop" {
        then "a `Deadline` made in the head beside an arm that fires again is refused" {
            refused_in(
                timed(
                    "let calm = quiet(5)\nmut n = 0\nwhile n < 1 {\n    n = n + select {\n        after(5) -> 1\n        calm -> 2\n    }\n}\n",
                ),
                "a timer made inside a loop starts over each turn",
            )
        }
        then "a `Deadline` bound by the loop's own body is refused the same way" {
            refused_in(
                timed(
                    "let calm = quiet(5)\nmut n = 0\nwhile n < 1 {\n    let limit = after(5)\n    n = n + select {\n        limit -> 1\n        calm -> 2\n    }\n}\n",
                ),
                "a timer made inside a loop starts over each turn",
            )
        }
        then "a `Deadline` bound before the loop runs" {
            answered(
                timed(
                    "let calm = quiet(5)\nlet limit = after(5)\nmut n = 0\nwhile n < 1 {\n    n = n + select {\n        limit -> 1\n        calm -> 2\n    }\n}\n\"\${n}\"\n",
                ),
            ) == "1"
        }
        then "a `Deadline` made each turn beside arms taken once is a limit on each attempt" {
            answered(
                timed(
                    "fn one() -> int {\n    1\n}\nmut n = 0\nwhile n < 1 {\n    n = n + select {\n        r in spawn one() -> r\n        after(5) -> 1\n    }\n}\n\"\${n}\"\n",
                ),
            ) == "1"
        }
        then "an `Every` made inside a loop is refused, whatever stands beside it" {
            refused_in(
                timed(
                    "mut n = 0\nwhile n < 1 {\n    n = n + select {\n        every(5) -> 1\n    }\n}\n",
                ),
                "a timer made inside a loop starts over each turn",
            )
        }
    }
    given "a program that loads no `@std/time`" {
        then "a head no arm waits on is told the timers are that package's" {
            refuses("select {\n    1 -> 2\n}", "use @std.time")
        }
    }
    given "lowering — the scan chooses" {
        then "a task arm binds the answer and its body answers" {
            shown(
                "fn one() -> int {\n    41\n}\nlet job = spawn one()\nlet v = select {\n    r in job -> r + 1\n}\n\"\${v}\"",
            ) == "42"
        }
        then "a bare head waits and binds nothing" {
            shown(
                "fn one() -> int {\n    41\n}\nlet job = spawn one()\nlet v = select {\n    job -> 7\n}\n\"\${v}\"",
            ) == "7"
        }
        then "`else` answers when nothing is ready" {
            shown(
                "fn one() -> int {\n    41\n}\nlet job = spawn one()\nlet v = select {\n    r in job -> r\n    else -> 0 - 1\n}\n\"\${v}\"",
            ) == "-1"
        }
        then "a `select` answering nothing stands as a statement" {
            shown(
                "fn one() -> int {\n    41\n}\nlet seen = Cell.new(0)\nlet job = spawn one()\nselect {\n    r in job -> seen.set(r)\n}\nseen.get()",
            ) == "41"
        }
        then "the loop: a scan begins, the arm is asked, taken and left, or filed and rested on" {
            let text = render_ir(
                ir_of(
                    "fn one() -> int {\n    41\n}\nlet job = spawn one()\nlet v = select {\n    r in job -> r\n}\nv",
                ),
            )
            in_order(
                text,
                [
                    "loop {",
                    "call avra_wait_enter(",
                    "flag unwinding",
                    "call avra_task_done(",
                    "call avra_task_join(",
                    "break 0",
                    "call avra_wait_task(",
                    "call avra_wait_rest(",
                ],
            )
        }
        then "an `else` lets the world run instead of resting" {
            let text = render_ir(
                ir_of(
                    "fn one() -> int {\n    41\n}\nlet job = spawn one()\nlet v = select {\n    r in job -> r\n    else -> 0\n}\nv",
                ),
            )
            in_order(
                    text,
                    ["call avra_wait_enter(", "call avra_task_done(", "call avra_fiber_yield("],
                ) &&
                !text.contains("call avra_wait_rest(")
        }
        then "a false guard leaves its arm dead, and reads no head" {
            shown(
                "fn one() -> int {\n    41\n}\nlet a = spawn one()\nlet b = spawn one()\nlet both = a.await + b.await\nlet v = select {\n    x in a if both > 100 -> 1\n    y in b -> 2\n}\n\"\${v}\"",
            ) == "2"
        }
        then "a list arm binds the member that answered, and its index when asked" {
            shown(
                "fn n(k: int) -> int {\n    k\n}\nlet ts = [spawn n(4), spawn n(5)]\nlet both = ts[0].await + ts[1].await\nlet v = select {\n    i, r in ts -> r * 10 + i\n}\n\"\${both} \${v}\"",
            ) == "9 40"
        }
        then "a shape with no lowering yet is refused by name, once" {
            refused_at_run(
                "${tasks()}@fair select {\n    r in job -> r\n}",
                "`select` type-checks but lowers to nothing",
            )
        }
    }
}
