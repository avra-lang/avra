// proves: when two source arms are both ready the scan takes the first,
// and a loser's body never runs — the arms answer their own bodies, in
// both engines
use @std.task.{Source}

extern fn avra_task_pending() -> ptr
extern fn avra_task_answer(t: ptr, v: ptr)
extern fn avra_task_join(t: ptr) -> ptr
extern fn avra_array_sized(n: int) -> ptr

/// A source that has yielded `v`, with the gate it opens once it has.
fn yielded(v: int, opened: ptr) -> Source<int> {
    produce<int>(4) {
        yield v
        avra_task_answer(opened, avra_array_sized(1))
    }
}

let opened_a = avra_task_pending()
let opened_b = avra_task_pending()
let a: Source<int> = yielded(7, opened_a)
let b: Source<int> = yielded(8, opened_b)
let _ = avra_task_join(opened_a)
let _ = avra_task_join(opened_b)

mut ran_a = false
mut ran_b = false
let v = select {
    x in a -> {
        ran_a = true
        x
    }
    b -> {
        ran_b = true
        0
    }
    a.ended -> 0 - 1
    b.ended -> 0 - 2
}
"${v} ${ran_a} ${ran_b}"
