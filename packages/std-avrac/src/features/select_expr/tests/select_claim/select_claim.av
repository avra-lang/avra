// proves: when two source arms are both ready the scan takes the first,
// and a loser's body never runs — the arms answer their own bodies, in
// both engines
use @std.task.{Source}

let a: Source<int> = produce<int>(4) { yield 7 }
let b: Source<int> = produce<int>(4) { yield 8 }

mut ran_a = false
mut ran_b = false
let v = select {
    x in a -> {
        ran_a = true
        x
    }
    b -> {
        ran_b = true
        0
    }
    a.ended -> 0 - 1
    b.ended -> 0 - 2
}
"${v} ${ran_a} ${ran_b}"
