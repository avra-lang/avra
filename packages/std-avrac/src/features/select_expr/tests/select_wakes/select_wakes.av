// proves: with nothing ready the `select` rests on its arms and wakes
// for the first to end — the lower arm here, whose task is the quick
// one — and binds its answer, in both engines
use @std.time.{ms, secs, sleep}

fn after(wait: int, n: int) -> int {
    sleep(ms(wait))
    n
}

fn never() -> int {
    sleep(secs(60))
    0
}

let slow = spawn never()
let quick = spawn after(2, 7)
let v = select {
    s in slow -> s
    q in quick -> q + 1
}
slow.cancel()
"${v}"
