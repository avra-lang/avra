// proves: cancelling a task cancels the tasks its `select` heads MADE and no
// others — a head that spawns is cancelled, one that only reads a task made
// outside survives its cancelled reader
use @std.time.{ms, secs, sleep}

fn slow(n: int) -> int {
    sleep(secs(30))
    n
}

fn reads(t: Task<int>) -> int {
    select {
        r in t -> r
    }
}

fn makes() -> int {
    select {
        r in spawn slow(2) -> r
    }
}

let outside = spawn slow(9)
let a = spawn reads(outside)
let b = spawn makes()
sleep(ms(2))
a.cancel()
b.cancel()
let _ = a.await catch c -> { 0 }
let _ = b.await catch c -> { 0 }
let alive = !outside.done
outside.cancel()
let _ = outside.await catch c -> { 0 }
"${alive}"
