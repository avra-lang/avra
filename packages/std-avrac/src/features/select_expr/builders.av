//! The select's refusals: a catch-all it has none of, and a mark it
//! does not read. Each arm is its own node, and the `select` holds them
//! in written order; the arm set's laws are typing's, where the arms
//! carry a span.
use features.{RefusalWords}

// ── voices ──

/// `_ -> …` is `match`'s catch-all, and a `select` has none.
fn select_catchall() -> RefusalWords {
    RefusalWords {
        message: "a `select` has no catch-all",
        help: "write `else -> …` — it runs when nothing is ready",
    }
}

/// A mark before `select` other than the one it reads.
fn select_mark() -> RefusalWords {
    RefusalWords {
        message: "a `select` reads one mark, `@fair`",
        help: "drop the mark — `@fair` is the one a `select` reads",
    }
}
