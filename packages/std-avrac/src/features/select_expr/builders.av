//! Parse-time lowering: each arm is its own node, and the `select`
//! holds them in written order. The mark and the catch-all are the
//! builder's to refuse — the arm set's laws are typing's, where the
//! arms carry a span.
use core.{Expr, Stmt}
use grammar.{Token}
use features.{LangNode, Builder, RefusalWords}

fn build_select(b: Builder) -> Result<LangNode, string> {
    b.make_expr(selected(b)?)
}

/// A marked `select` standing as a statement.
fn build_select_stmt(b: Builder) -> Result<LangNode, string> {
    b.make_stmt(Stmt.ExprStmt(b.expr_node(selected(b)?)))
}

/// The `Select` node of a mark and its arms.
fn selected(b: Builder) -> Result<Expr, string> {
    .Ok(Expr.Select(fair_marked(b.tokens(0)?)?, b.exprs(1)?))
}

/// Whether the mark written is `@fair` — the one a `select` reads.
fn fair_marked(marks: List<Token>) -> Result<bool, string> {
    let m? = marks.first() else { return .Ok(false) }
    if m.text == "@fair" { return .Ok(true) }
    .Err("a `select` reads one mark, `@fair` — `${m.text}` is not it")
}

// ── voices ──

/// `_ -> …` is `match`'s catch-all, and a `select` has none.
fn select_catchall() -> RefusalWords {
    RefusalWords {
        message: "a `select` has no catch-all",
        help: "write `else -> …` — it runs when nothing is ready",
    }
}
