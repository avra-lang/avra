//! Parse-time lowering: each arm is its own node, and the `select`
//! holds them in written order. The laws the grammar cannot state are
//! the builders': an arm that waits; one `else`, last; one mark, `@fair`;
//! no catch-all.
use core.{Expr, Stmt, ExprId, Scoped}
use grammar.{Token}
use features.{LangNode, Builder}

fn build_select(b: Builder) -> Result<LangNode, string> {
    b.make_expr(selected(b)?)
}

/// A marked `select` standing as a statement.
fn build_select_stmt(b: Builder) -> Result<LangNode, string> {
    b.make_stmt(Stmt.ExprStmt(b.expr_node(selected(b)?)))
}

/// The `Select` node of a mark and its arms.
fn selected(b: Builder) -> Result<Expr, string> {
    let arms = b.exprs(1)?
    let wrong = arms_wrong(b, arms)
    if wrong != null { return .Err(wrong!) }
    let marks = b.tokens(0)?
    .Ok(Expr.Select(fair_marked(marks)?, arms))
}

/// Whether the mark written is `@fair` — the one a `select` reads.
fn fair_marked(marks: List<Token>) -> Result<bool, string> {
    let m? = marks.first() else { return .Ok(false) }
    if m.text == "@fair" { return .Ok(true) }
    .Err("a `select` reads one mark, `@fair` — `${m.text}` is not it")
}

/// What is wrong with the arms as a set, when anything is: one at least
/// waits, and `else` is written once, last.
fn arms_wrong(b: Builder, arms: List<ExprId>) -> string? {
    let elses = [j for j, a in arms if is_else(b, a)]
    if elses.length == arms.length { return "a `select` needs an arm to wait on" }
    if elses.length > 1 { return "a `select` has ONE `else` arm" }
    let at? = elses.first() else { return null }
    if at != arms.length - 1 { return "the `else` arm ends a `select` — move it last" }
    null
}

fn is_else(b: Builder, arm: ExprId) -> bool {
    // a feature cannot enumerate OTHER features' variants
    match b.store.expr(arm) { .ElseArm(_) -> true, rest -> false }
}

fn build_wait_arm(b: Builder) -> Result<LangNode, string> {
    let index = b.tokens(0)?
    let blank = b.tokens(1)?
    let bind = b.tokens(2)?
    let guard = b.exprs(4)?
    b
        .make_expr(
            Expr
                .WaitArm(written(index), written(blank.concat(bind)), b.expr(3)?, guard.first(), b.expr(5)?),
        )
}

/// The name a token run wrote, empty when it wrote none.
fn written(names: List<Token>) -> Scoped {
    Scoped(names.first()?.text ?? "")
}

/// `_ -> …` is `match`'s catch-all, and a `select` has none.
// LICENSED fns.dead_parameter: a builder wears the row's signature
fn build_any_arm(_b: Builder) -> Result<LangNode, string> {
    .Err("a `select` has no catch-all — `else ->` runs when nothing is ready")
}
