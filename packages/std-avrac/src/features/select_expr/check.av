//! The typing rule: a `select` is parsed and printed, and refused by
//! name until its lowering stands.
use core.{ExprId, TypeId}
use features.{TypeCx}
use diagnostics.{refusal}

// ── The voices ──

fn unlowered(mut cx: TypeCx, e: ExprId) -> TypeId {
    cx
        .spoken(
            refusal(
                "flow.select",
                cx.loc_of(e),
                "`select` is parsed and not yet lowered",
                "this `select`",
                "wait on one task with `t.await`",
            ),
        )
}
