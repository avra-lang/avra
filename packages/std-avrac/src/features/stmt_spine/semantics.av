//! The recovery hole's StmtSemantics: resolve and typing pass it
//! by (its diagnostic already spoke at parse time); reaching it at
//! runtime is the defect the refusal gate exists to prevent.
use core.{StmtId, Reg}
use core.stmt.{Setting, Error}
use features.{StmtSemantics, LowerCx, hole_defect}

impl StmtSemantics for Setting {
    fn lower_stmt(mut cx: LowerCx, s: StmtId) -> Reg? { HoleSemantics {}.lower_stmt(cx, s) }
}

impl StmtSemantics for Error {
    fn lower_stmt(mut cx: LowerCx, s: StmtId) -> Reg? { HoleSemantics {}.lower_stmt(cx, s) }
}

export type HoleSemantics = {}

impl StmtSemantics for HoleSemantics {

    fn lower_stmt(mut cx: LowerCx, s: StmtId) -> Reg? {
        cx.defect(hole_defect)
        null
    }
}
