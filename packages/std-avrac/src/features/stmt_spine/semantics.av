//! The recovery hole's StmtSemantics: resolve and typing pass it
//! by (its diagnostic already spoke at parse time); reaching it at
//! runtime is the defect the refusal gate exists to prevent.
use core.{StmtId, Reg}
use features.{StmtSemantics, StmtResolveCx, StmtTypeCx, StmtLowerCx, nothing, hole_defect}

export type HoleSemantics = { }

impl StmtSemantics for HoleSemantics {
    fn resolve_stmt(cx: StmtResolveCx, s: StmtId) {
        nothing()
    }

    fn type_stmt(cx: StmtTypeCx, s: StmtId) {
        nothing()
    }

    fn lower_stmt(cx: StmtLowerCx, s: StmtId) -> Reg? {
        cx.expr.defect(hole_defect())
        null
    }
}
