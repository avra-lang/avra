//! The recovery hole's StmtSemantics: resolve and typing pass it
//! by (its diagnostic already spoke at parse time); reaching it at
//! runtime is the defect the refusal gate exists to prevent.
use core.{NodeStore, StmtId, ExprId, Reg}
use features.{StmtSemantics, StmtResolveCx, StmtTypeCx, StmtEvalCx, StmtLowerCx, nothing, hole_defect}

export type HoleSemantics = { }

impl StmtSemantics for HoleSemantics {
    fn binds(self, store: NodeStore, s: StmtId) -> string? {
        null
    }

    fn value_of(self, store: NodeStore, s: StmtId) -> ExprId? {
        null
    }

    fn resolve_stmt(self, cx: StmtResolveCx, s: StmtId) {
        nothing()
    }

    fn type_stmt(self, cx: StmtTypeCx, s: StmtId) {
        nothing()
    }

    fn eval_stmt(self, cx: StmtEvalCx, s: StmtId) -> ExprId? {
        cx.fail(hole_defect())
        null
    }

    fn lower_stmt(self, cx: StmtLowerCx, s: StmtId) -> Reg? {
        cx.fail(hole_defect())
        null
    }
}
