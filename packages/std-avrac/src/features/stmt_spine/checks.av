//! The typing rule of a setting: its value checks against what isn't known, since the component
//! that reads it decides.
use core.{Checking, Expected, StmtChecks, StmtId}
use core.stmt.{Setting}

impl StmtChecks for Setting {
    fn stmt_checked(mut cx: Checking, s: StmtId) { let _ = cx.check(self.value, Expected.Unknown) }
}
