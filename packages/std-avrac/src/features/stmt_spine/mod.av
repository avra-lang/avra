//! The statement spine: the program shape every statement feature
//! hangs from. `stmt` is not declared here — it is the merge of the
//! rules statement features declare; this feature owns only what a
//! program IS.
use features.{LanguageFeature}
use grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}

export fn stmt_spine() -> LanguageFeature {
    LanguageFeature stmt_spine {
        gram: grammar {
            program = ( s:stmt | BREAK )* EOF -> s
        }
    }
    stmt_spine
}
