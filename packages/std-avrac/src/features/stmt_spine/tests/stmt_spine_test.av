// The program shape: statements accumulate in order, blank lines are
// noise, end of input is consumed. `stmt` arrives by rule merging from
// a fixture feature — the extension mechanism, exercised as designed.
use @std.avrac.core.{NodeStore, new_node_store, Expr, Stmt, StmtId, Span}
use @std.avrac.grammar.{Captured, run_grammar, lex_source, parse_grammar}
use @std.avrac.features.{
    LangNode, LanguageFeature, Builder, BuilderRow, compose_text, dispatch,
    list_at, stmt_id_at,
}
use @std.avrac.features.stmt_spine.{stmt_spine}

fn build_name_stmt(b: Builder) -> Result<LangNode, string> {
    let t = b.token(0)?
    let e = b.store.alloc_expr(Expr.Ident(t.text), b.span)
    b.make_stmt(Stmt.ExprStmt(e))
}

/// A fixture statement: a bare NAME. Its `stmt` rule merges into the
/// spine's program.
fn name_stmts() -> LanguageFeature {
    let rows: List<BuilderRow> = table {
        name      | build
        "mk_name" | build_name_stmt
    }
    component LanguageFeature f {
        name = "name_stmts"
        gram = "stmt = n:NAME BREAK -> mk_name(n)"
        builders = rows
    }
    f
}

type ParsedProg = { store: NodeStore, stmts: List<StmtId>, diagnostics: int }

fn parse_prog(source: string) -> ParsedProg {
    let feats = [stmt_spine(), name_stmts()]
    let gp = parse_grammar(compose_text(feats).text)
    if gp.grammar == null {
        return ParsedProg { store: new_node_store(), stmts: [], diagnostics: gp.diagnostics.length }
    }
    let store = new_node_store()
    let build = (name: string, args: List<Captured<LangNode>>, span: Span?) -> dispatch(feats, store, name, args, span)
    let o = run_grammar<LangNode>(gp.grammar!.merged(), lex_source(source).tokens, build)
    mut stmts: List<StmtId> = []
    if o.result != null {
        let items = list_at([o.result!], 0)
        for j in 0..items.length {
            let sid: StmtId? = stmt_id_at(items, j)
            if sid != null { stmts.push(sid!) }
        }
    }
    ParsedProg { store: store, stmts: stmts, diagnostics: o.diagnostics.length }
}

spec "features/stmt_spine" {
    given "statements over merged rules" {
        then "statements accumulate in source order" {
            let p = parse_prog("alpha\nbeta")
            let shape_ok = p.diagnostics == 0 && p.stmts.length == 2
            let names_ok = if shape_ok {
                match p.store.stmt(p.stmts[0]) {
                    .ExprStmt(e) -> p.store.expr(e) is .Ident,
                    .Let(_, _) -> false, .Error -> false,
                }
            } else { false }
            shape_ok && names_ok && p.store.stmts.count() == 2
        }
        then "blank lines between statements are noise" {
            let p = parse_prog("alpha\n\n\nbeta")
            p.diagnostics == 0 && p.stmts.length == 2
        }
        then "a leading blank line is noise" {
            let p = parse_prog("\nalpha")
            p.diagnostics == 0 && p.stmts.length == 1
        }
        then "an empty program is zero statements, no complaints" {
            let p = parse_prog("")
            p.diagnostics == 0 && p.stmts.length == 0
        }
    }
}
