// The program shape through the driver: statements accumulate in
// order, blank lines are noise, end of input is consumed. `stmt`
// arrives by rule merging from a fixture feature — the extension
// mechanism, exercised as designed.
use @std.avrac.core.{Expr, Stmt}
use @std.avrac.diagnostics.{new_source_file}
use @std.avrac.language.{assemble, parse_program, ParsedProgram}
use @std.avrac.features.{LangNode, LanguageFeature, Builder, BuilderRow, feature}
use @std.avrac.features.stmt_spine.{stmt_spine}

fn build_name_stmt(b: Builder) -> Result<LangNode, string> {
    let t = b.token(0)?
    let e = b.store.alloc_expr(Expr.Ident(t.text), b.span)
    b.make_stmt(Stmt.ExprStmt(e))
}

/// A fixture statement: a bare NAME. Its `stmt` rule merges into the
/// spine's program.
fn name_stmts() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name      | build
        "mk_name" | build_name_stmt
    }
    feature("name_stmts", "stmt = n:NAME BREAK -> mk_name(n)") with { builders: rows }
}

fn parse_prog(source: string) -> ParsedProgram {
    parse_program(assemble([stmt_spine(), name_stmts()]), new_source_file(null, source))
}

spec "features/stmt_spine" {
    given "statements over merged rules" {
        then "statements accumulate in source order" {
            let p = parse_prog("alpha\nbeta")
            let shape_ok = p.diagnostics.is_empty() && p.stmts.length == 2
            let names_ok = if shape_ok {
                match p.store.stmt(p.stmts[0]) {
                    .ExprStmt(e) -> p.store.expr(e) is .Ident,
                    .Let(_, _) -> false, .Error -> false,
                }
            } else { false }
            shape_ok && names_ok && p.store.stmts.count() == 2
        }
        then "blank lines between statements are noise" {
            let p = parse_prog("alpha\n\n\nbeta")
            p.diagnostics.is_empty() && p.stmts.length == 2
        }
        then "a leading blank line is noise" {
            let p = parse_prog("\nalpha")
            p.diagnostics.is_empty() && p.stmts.length == 1
        }
        then "an empty program is zero statements, no complaints" {
            let p = parse_prog("")
            p.diagnostics.is_empty() && p.stmts.is_empty()
        }
    }
}
