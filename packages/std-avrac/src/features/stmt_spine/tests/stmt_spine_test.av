// The program shape through the driver: statements accumulate in
// order, blank lines are noise, end of input is consumed. `stmt`
// arrives by rule merging from a fixture feature — the extension
// mechanism, exercised as designed.
use @std.avrac.core.{Scoped, Expr, Stmt}
use @std.avrac.grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use @std.avrac.diagnostics.{new_source_file}
use @std.avrac.compiler.{assemble, parse_program, Parsed}
use @std.avrac.features.{LangNode, LanguageFeature, Builder, BuilderRow, feature}
use @std.avrac.features.stmt_spine.{stmt_spine}

fn build_name_stmt(mut b: Builder) -> Result<LangNode, string> {
    let t = b.token(0)?
    let e = b.store.alloc_expr(Expr.Ident(Scoped(t.text)), b.span)
    b.make_stmt(Stmt.ExprStmt(e))
}

/// A fixture statement: a bare NAME. Its `stmt` rule merges into the
/// spine's program.
fn name_stmts() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name      | build
        "mk_name" | build_name_stmt
    }
    feature("name_stmts", name_gram()) with { builders: rows }
}

fn parse_prog(source: string) -> Parsed {
    parse_program(assemble([stmt_spine(), name_stmts()]), new_source_file("<source>", source), [])
}

spec "features/stmt_spine" {
    given "statements over merged rules" {
        then "statements accumulate in source order" {
            let p = parse_prog("alpha\nbeta")
            let shape_ok = p.voices.list.is_empty() && p.stmts.length == 2
            let first = p.store.stmt_value(p.stmts[0])
            let names_ok = shape_ok && p.store.stmt(p.stmts[0]) is .ExprStmt && first != null && p.store.expr(first!) is .Ident
            shape_ok && names_ok && p.store.stmts.count() == 2
        }
        then "blank lines between statements are noise" {
            let p = parse_prog("alpha\n\n\nbeta")
            p.voices.list.is_empty() && p.stmts.length == 2
        }
        then "a leading blank line is noise" {
            let p = parse_prog("\nalpha")
            p.voices.list.is_empty() && p.stmts.length == 1
        }
        then "an empty program is zero statements, no complaints" {
            let p = parse_prog("")
            p.voices.list.is_empty() && p.stmts.is_empty()
        }
    }
}

/// The fixture's own rule, read when the compiler runs.
fn name_gram() -> Grammar {
    grammar {
        stmt = n:NAME BREAK -> mk_name(n)
    }
}
