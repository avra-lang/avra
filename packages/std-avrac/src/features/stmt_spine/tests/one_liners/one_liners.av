// proves: one-line bodies — for, while, if-return, let-else — and a
// nested pair, natively
fn clamp(n: int) -> int {
    if n > 9 { return 9 }
    n
}
fn head(xs: List<int>) -> int? {
    if xs.length == 0 { return null }
    xs[0]
}
fn first_or(xs: List<int>, d: int) -> int {
    let x? = head(xs) else { return d }
    x
}
mut total = 0
for i in 0..5 { total = total + clamp(i * 3) }
mut i = 0
while i < 3 { i = i + 1 }
for x in [1, 2, 3] { if x > 1 { total = total + x } }
total + i + first_or([], 100) + first_or([7], 0)
