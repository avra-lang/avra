//! THE TASK LAW: a task is joined by the block that spawned it, so no
//! value holding one reaches past that block — not an answer, a field,
//! a lambda's capture — and only a task, a nullable task or a list of
//! tasks is an owner that block can join. A write over a task leaves
//! it with no owner at all.
use core.{StmtId, TypeId}
use diagnostics.{refusal}
use @std.errors.{Loc}

impl TypeCx {
    /// Whether `ty` carries a task past its block — spoken when it does.
    mut fn escapes_with_task(at: Loc?, label: string, ty: TypeId) -> bool {
        if !self.view.types.holds_tasks(ty) { return false }
        self.task_escapes(at, label)
        true
    }

    /// A statement's value holding tasks its block cannot join — read
    /// as the binding declares it, where it declares one.
    mut fn unowned_tasks(s: StmtId) {
        let v? = self.view.store.owned_value(s) else { return }
        let ty = self.facts.declared_binding(s) ?? self.type_at(v)
        if !self.view.types.holds_tasks(ty) || self.view.types.owns_tasks(ty) { return }
        self.task_unowned(self.loc_of(v), ty)
    }

    /// Whether a write over a place of `ty` would drop a task — spoken
    /// when it would.
    mut fn drops_task(at: Loc?, ty: TypeId) -> bool {
        if !self.view.types.holds_tasks(ty) { return false }
        self.task_dropped(at)
        true
    }

    // ── The voices ──

    mut fn task_escapes(at: Loc?, label: string) {
        self
            .emit(
                refusal(
                    "type.task_escape",
                    at,
                    "a task cannot outlive the block that spawned it",
                    label,
                    "keep it in a binding or a list of tasks here — its answer can leave: `t.await`",
                ),
            )
    }

    mut fn task_dropped(at: Loc?) {
        self
            .emit(
                refusal(
                    "type.task_escape",
                    at,
                    "this write leaves the task it replaces unjoined",
                    "written here",
                    "keep each task in its own binding, or push it onto a list of tasks",
                ),
            )
    }

    mut fn task_unowned(at: Loc?, ty: TypeId) {
        self
            .emit(
                refusal(
                    "type.task_escape",
                    at,
                    "a `${self.view.types.name_of(ty)}` cannot own a task — nothing joins it where the block ends",
                    "held here",
                    "hold each task in a binding, a nullable binding, or a `List<Task<…>>`",
                ),
            )
    }
}
