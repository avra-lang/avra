//! THE TASK LAW: a task is joined by the block that spawned it, so no
//! value holding one reaches past that block — not an answer, a field,
//! a lambda's capture — and only a task, a nullable task or a list of
//! tasks is an owner that block can join. A write over a task leaves
//! it with no owner at all.
use core.{StmtId, TypeId}
use diagnostics.{Voice, said_as}
use @std.errors.{Loc}

impl TypeCx {
    /// Whether `ty` carries a task past its block — spoken when it does.
    /// A MARKED owner is exempt: a `Source`, or any record a package
    /// marked `@owns`, may be answered and is settled by its receiver.
    mut fn escapes_with_task(at: Loc?, label: string, ty: TypeId) -> bool {
        if !self.view.types.holds_tasks(ty) { return false }
        if self.view.decls.owns_by_mark(ty) { return false }
        self.task_escapes(at, label)
        true
    }

    /// A statement's value holding tasks its block cannot join — read
    /// as the binding declares it, where it declares one.
    mut fn unowned_tasks(s: StmtId) {
        let v? = self.view.store.owned_value(s) else { return }
        let ty = self.facts.declared_binding(s) ?? self.type_at(v)
        if !self.view.types.holds_tasks(ty) || self.view.decls.owns_tasks(ty) { return }
        self.task_unowned(self.loc_of(v), ty)
    }

    /// Whether a write over a place of `ty` would drop a task — spoken
    /// when it would.
    mut fn drops_task(at: Loc?, ty: TypeId) -> bool {
        if !self.view.types.holds_tasks(ty) { return false }
        self.task_dropped(at)
        true
    }

    // ── The voices ──

    mut fn task_escapes(at: Loc?, label: string) { self.emit(said_as("type.task_escape", at, task_outlives(label))) }

    mut fn task_dropped(at: Loc?) { self.emit(said_as("type.task_escape", at, task_overwritten())) }

    mut fn task_unowned(at: Loc?, ty: TypeId) {
        self
            .emit(
                said_as(
                    "type.task_escape",
                    at,
                    task_unheld(self.view.types.name_of(ty), "held here"),
                ),
            )
    }
}

/// A value of a task's, said by `label`, that reaches past the block that spawned it.
export fn task_outlives(label: string) -> Voice {
    Voice {
        message: "a task cannot outlive the block that spawned it",
        label: label,
        help: "keep it in a binding or a list of tasks here — its answer can leave: `t.await`",
    }
}

/// A write over a place holding a task, which leaves it unjoined.
export fn task_overwritten() -> Voice {
    Voice {
        message: "this write leaves the task it replaces unjoined",
        label: "written here",
        help: "keep each task in its own binding, or push it onto a list of tasks",
    }
}

/// A value of `spelled` holding a task, which no block can join, as `label` says where.
export fn task_unheld(spelled: string, label: string) -> Voice {
    Voice {
        message: "a `${spelled}` cannot own a task — nothing joins it where the block ends",
        label: label,
        help: "hold each task in a binding, a nullable binding, or a `List<Task<…>>`",
    }
}
