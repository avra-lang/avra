// The RED TEAM's permanent record for the TYPE SURFACE — the one
// rule every annotation is written in. Attacks on the SPELLING of a
// type live here; attacks on what a nullable MEANS live with the
// nullable feature.
//
// Every program here was written to BREAK the surface, not to use
// it. A case that once produced a wrong answer, a crash, an internal
// defect, or an engine divergence keeps its place here forever.
use @std.avrac.language.{analyze_source}
use @std.avrac.testing.{shown, refusals, refused_with}

spec "features/type_expr (adversarial)" {
    given "the `?` position, mutated" {
        then "a doubled `?` refuses — `??` lexes as ONE token" {
            refusals("fn f(x: int??) -> int { 1 }\nf(1)") == 2
        }
        then "two `?` set apart refuse just the same" {
            refusals("fn f(x: int ? ?) -> int { 1 }\nf(1)") == 2
        }
        then "`?` before the name refuses" {
            refusals("fn f(x: ?int) -> int { 1 }\nf(1)") == 2
        }
        then "`?` with no name refuses" {
            refusals("fn f(x: ?) -> int { 1 }\nf(1)") == 2
        }
        then "a `?` set off by a space is still the type" {
            shown("fn f(x: int ?) -> int { x ?? 41 }\nf(null) + 1") == "42"
        }
        then "a `?` tight against `)` parses" {
            shown("fn f(x: int?) -> int { x ?? 1 }\nf(null)") == "1"
        }
        then "a `?` tight against `{` parses" {
            shown("fn f(b: bool) -> int?{ null }\nf(true) ?? 3") == "3"
        }
        then "a `?` tight against `,` parses" {
            shown("fn f(x: int?, y: int?) -> int { (x ?? 1) + (y ?? 2) }\nf(null, null)") == "3"
        }
    }
    given "an annotation that is missing or malformed" {
        then "a param with no type refuses" {
            refusals("fn f(x) -> int { 1 }\nf(1)") == 2
        }
        then "a param with `:` and no type refuses" {
            refusals("fn f(x: ) -> int { 1 }\nf(1)") == 2
        }
        then "a return with no type refuses" {
            refusals("fn f(x: int) -> { 1 }\nf(1)") == 2
        }
        then "a missing `:` refuses" {
            refusals("fn f(x int) -> int { 1 }\nf(1)") == 2
        }
    }
    given "names in the type position" {
        then "an unknown name names no type" {
            refused_with("fn f(x: Foo) -> int { 1 }\nf(1)", "`Foo` names no type")
        }
        then "an unknown NULLABLE name blames the NAME, not the slot" {
            refused_with("fn f(x: Foo?) -> int { 1 }\nf(1)", "`Foo` names no type")
        }
        then "a keyword names no type" {
            refused_with("fn f(x: if) -> int { 1 }\nf(1)", "names no type")
        }
        then "`null` names no type" {
            refused_with("fn f(x: null) -> int { 1 }\nf(1)", "`null` names no type")
        }
        then "a declared record annotates" {
            shown("type P = { x: int }\nfn f(p: P) -> int { p.x }\nlet q = P { x: 7 }\nf(q)") == "7"
        }
        then "a declared enum annotates" {
            shown("enum E {\n    a\n    b\n}\nfn f(e: E) -> int {\n    match e {\n        .a -> 4\n        .b -> 0\n    }\n}\nf(E.a)") == "4"
        }
    }
    given "a type APPLIED to arguments" {
        then "a name that takes none refuses" {
            refused_with("fn f(x: int<bool>) -> int { 1 }\nf(1)", "`int` takes no type arguments")
        }
        then "an UNKNOWN constructor names the NAME, not the arity" {
            refused_with("fn f(x: Foo<int>) -> int { 1 }\n1", "`Foo` names no type")
        }
        then "a KEYWORD constructor names the keyword, not the arity" {
            refused_with("fn f(x: if<int>) -> int { 1 }\n1", "`if` names no type")
        }
        then "the arity refusal reports the TABLE's arity, never a hardcoded word" {
            refused_with("fn f(xs: List<int, bool>) -> int { 1 }\nf([1])",
                         "applied to 2 types; it takes 1")
        }
        then "zero arguments is not an application" {
            refusals("fn f(xs: List<>) -> int { 1 }\nf([1])") == 2
        }
        then "an unclosed application refuses" {
            refusals("fn f(xs: List<int) -> int { 1 }\nf([1])") == 2
        }
        then "an unknown ELEMENT name is named, not swallowed" {
            refused_with("fn f(xs: List<Foo>) -> int { 1 }\nf([1])", "`Foo` names no type")
        }
        then "a nullable LIST waits for ownership analysis" {
            refused_with("fn f(xs: List<int>?) -> int { 1 }\nf(null)", "a nullable holds scalars for now")
        }
        then "the element may itself be APPLIED — nesting needs no rule" {
            analyze_source("fn f(xs: List<List<int>>) -> int { 1 }\n1").diagnostics.is_empty()
        }
        then "a nested LITERAL still meets the list-element law" {
            refused_with("fn f(xs: List<List<int>>) -> int { 1 }\nf([[1]])", "a list holds scalars for now")
        }
    }
    given "the built-in names, which belong to the language" {
        then "a record cannot be named `int`" {
            refused_with("type int = { x: bool }\n1", "`int` is a built-in type")
        }
        then "an enum cannot be named `bool`" {
            refused_with("enum bool {\n    a\n}\n1", "`bool` is a built-in type")
        }
        then "a record cannot be named `string` either" {
            refused_with("type string = { x: int }\n1", "`string` is a built-in type")
        }
        then "the refusal says what to do instead" {
            refused_with("type int = { x: bool }\n1", "choose another name")
        }
    }
    given "the surface in every position it is written" {
        then "a param, a second param, and a return all take one" {
            shown("fn f(a: int, b: bool) -> int { if b { a } else { 0 } }\nf(42, true)") == "42"
        }
        then "a struct field takes one" {
            shown("type P = { x: int, y: bool }\nlet q = P { x: 5, y: true }\nq.x") == "5"
        }
        then "an enum payload takes one" {
            shown("enum E {\n    a(int)\n    b\n}\nmatch E.a(6) {\n    .a(n) -> n\n    .b -> 0\n}") == "6"
        }
        then "a nullable is refused in a FIELD, in the field's words" {
            refused_with("type P = { x: int? }\nlet q = P { x: 1 }\nq.x ?? 0", "struct fields hold scalars")
        }
        then "a nullable is refused in a PAYLOAD, in the payload's words" {
            refused_with("enum E {\n    a(int?)\n    b\n}\nmatch E.a(1) { .a(n) -> 0, .b -> 0 }", "an enum payload holds scalars")
        }
    }
}
