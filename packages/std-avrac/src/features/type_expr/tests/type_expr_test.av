// The type surface: every annotation is written in ONE rule, so `?`
// works wherever a type is spelled — params, returns — and an
// unknown name still refuses in the words it always did.
use @std.avrac.language.{analyze_source, parse_source}
use @std.avrac.testing.{shown, refused_with}

spec "features/type_expr" {
    given "a written type" {
        then "a plain name annotates as it always did" {
            shown("fn f(x: int) -> int { x + 1 }\nf(41)") == "42"
        }
        then "`?` is part of the type, in a param" {
            let a = analyze_source("fn g(x: int?) -> int { 1 }\ng(1)")
            a.diagnostics.is_empty()
        }
        then "`?` is part of the type, in a return" {
            let a = analyze_source("fn g() -> int? { null }\ng() ?? 0")
            a.diagnostics.is_empty()
        }
        then "a nullable and its value are DIFFERENT types" {
            let a = analyze_source("fn g(x: int?) -> int { 1 }\nfn h(y: int) -> int { g(y) }\nh(1)")
            a.diagnostics.is_empty()
        }
        then "`List<int>` annotates a PARAM — the fn-boundary hole, closed" {
            shown("fn head(xs: List<int>) -> int { xs[0] }\nhead([9, 8])") == "9"
        }
        then "`List<int>` annotates a RETURN" {
            shown("fn pair() -> List<int> { [7, 8] }\npair()[1]") == "8"
        }
        then "a list crosses TWO boundaries, made by one fn and read by another" {
            shown("fn make() -> List<int> { [3, 4] }\nfn take(xs: List<int>) -> int { xs[0] + xs[1] }\ntake(make())") == "7"
        }
        then "the element type is carried, not guessed" {
            shown("fn f(xs: List<bool>) -> bool { xs[0] }\nif f([true]) { 1 } else { 0 }") == "1"
        }
        then "an unknown NULLABLE name refuses once, naming the NAME" {
            refused_with("fn f(x: float?) -> int { 1 }\nf(1)", "`float` names no type")
        }
        then "the surface parses in every annotation position" {
            parse_source("fn f(a: int, b: bool) -> int { 1 }").voices.list.is_empty()
        }
    }
}
