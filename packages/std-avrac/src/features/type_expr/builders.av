//! Parse-time lowering for the type surface: a NAME plus what was
//! written around it.
use core.{TypeRef}
use features.{LangNode, Builder}

fn build_applied_opt_type(mut b: Builder) -> Result<LangNode, string> {
    written(b, b.type_refs(1)?, true)
}

fn build_applied_type(mut b: Builder) -> Result<LangNode, string> {
    written(b, b.type_refs(1)?, false)
}

fn build_opt_type(mut b: Builder) -> Result<LangNode, string> {
    written(b, [], true)
}

fn build_plain_type(mut b: Builder) -> Result<LangNode, string> {
    written(b, [], false)
}

/// `dyn Name` — the contract worn as a type; `dyn Name?` may be
/// absent besides.
fn build_dyn_type(mut b: Builder) -> Result<LangNode, string> {
    dyn_written(b, false)
}

fn build_dyn_opt_type(mut b: Builder) -> Result<LangNode, string> {
    dyn_written(b, true)
}

fn dyn_written(mut b: Builder, optional: bool) -> Result<LangNode, string> {
    let n = b.token(0)?
    b.make_type(TypeRef { name: n.text, args: [], optional: optional, dynamic: true, arrow: false, span: b.span })
}

/// A written type IS three things: the NAME, what it was applied to,
/// and whether a `?` followed. The four branches differ only in the
/// last two, and the arguments are types themselves — so
/// `List<List<int>>` nests with no rule of its own.
fn written(mut b: Builder, args: List<TypeRef>, optional: bool) -> Result<LangNode, string> {
    let n = b.token(0)?
    let t = TypeRef { name: n.text, args: args, optional: optional, dynamic: false, arrow: false, span: b.span }
    b.make_type(t)
}
