//! Parse-time lowering for the type surface: a NAME plus what was
//! written around it.
use core.{TypeRef}
use features.{LangNode, Builder}

/// A written type IS three things: the NAME, what it was applied to,
/// and whether a `?` followed. The two branches differ only in how the
/// NAME is reached, and the arguments are types themselves — so
/// `List<List<int>>` nests with no rule of its own.
export fn build_type_ref(b: Builder) -> Result<LangNode, string> {
    b
        .make_type(
            TypeRef {
                name: b.text_of("name")?,
                args: b.types_of("args")?,
                optional: b.flag_of("optional")?,
                dynamic: b.flag_of("dynamic")?,
                arrow: b.flag_of("arrow")?,
                span: b.span,
            },
        )
}

/// `A or B or ...` — the first atom plus zero or more trailing ones;
/// no `or` written answers the lone atom unchanged, so `Result<T, E>`
/// for a plain `E` parses exactly as it always did.
fn build_union_type(b: Builder) -> Result<LangNode, string> {
    let t = b.type_ref(0)?
    let rest = b.type_refs(1)?
    if rest.is_empty() { return b.make_type(t) }
    b
        .make_type(
            TypeRef {
                name: "",
                args: [],
                optional: false,
                dynamic: false,
                arrow: false,
                span: b.span,
                alternatives: [t].concat(rest),
            },
        )
}
