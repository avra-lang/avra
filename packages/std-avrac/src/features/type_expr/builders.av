//! Parse-time lowering for the type surface: a NAME plus what was
//! written around it.
use core.{TypeRef}
use features.{LangNode, Builder}

fn build_opt_type(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let t = TypeRef { name: n.text, args: [], optional: true, span: b.span }
    b.make_type(t)
}

fn build_plain_type(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let t = TypeRef { name: n.text, args: [], optional: false, span: b.span }
    b.make_type(t)
}
