//! Parse-time lowering for the type surface: a NAME plus what was
//! written around it.
use core.{TypeRef}
use features.{LangNode, Builder}

fn build_applied_opt_type(b: Builder) -> Result<LangNode, string> {
    written(b, b.type_refs(1)?, true)
}

fn build_applied_type(b: Builder) -> Result<LangNode, string> {
    written(b, b.type_refs(1)?, false)
}

fn build_opt_type(b: Builder) -> Result<LangNode, string> {
    written(b, [], true)
}

fn build_plain_type(b: Builder) -> Result<LangNode, string> {
    written(b, [], false)
}

/// A written type IS three things: the NAME, what it was applied to,
/// and whether a `?` followed. The four branches differ only in the
/// last two, and the arguments are types themselves — so
/// `List<List<int>>` nests with no rule of its own.
fn written(b: Builder, args: List<TypeRef>, optional: bool) -> Result<LangNode, string> {
    let n = b.token(0)?
    let t = TypeRef { name: n.text, args: args, optional: optional, span: b.span }
    b.make_type(t)
}
