//! The TYPE SURFACE — the one rule every annotation is written in.
//! A type is a name, optionally applied (`List<int>`) and optionally
//! nullable (`int?`). Ordered choice, LONGEST FIRST: every branch
//! starts with NAME, so a shorter one placed earlier would win and
//! strand the rest — the applied branches precede `?`, which
//! precedes the bare name.
//!
//! This feature owns no node and no semantics — an annotation is
//! DATA a builder hands over, never a node a pass walks. Features
//! that spell a type REFERENCE `type`, the way several already
//! reference `expression`; an assembly that parses annotations must
//! therefore include this feature.
use features.{LanguageFeature, BuilderRow}
use grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use diagnostics.{DiagCode}

export fn type_expr() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name               | build
        "dyn_opt_type"     | build_dyn_opt_type
        "dyn_type"         | build_dyn_type
        "applied_opt_type" | build_applied_opt_type
        "applied_type"     | build_applied_type
        "opt_type"         | build_opt_type
        "plain_type"       | build_plain_type
        "union_type"       | build_union_type
    }
    let codes = table<DiagCode> {
        kind           | summary
        "type.applied" | "a type applied to arguments it does not take"
    }
    LanguageFeature type_expr {
        docs: "A written type: `int`, `int?`, `List<int>`, `A or B` — the surface every annotation shares. `?` binds tighter than `or`, so `A or B?` is `A or (B?)`."
        gram: grammar {
            type = t:type_atom ( "or" a:type_atom )* -> union_type(t, a)
            type_atom = "dyn" n:NAME "?" -> dyn_opt_type(n)
            type_atom = "dyn" n:NAME -> dyn_type(n)
            type_atom = n:NAME "<" a:type ( "," a:type )* ","? ">" "?" -> applied_opt_type(n, a)
            type_atom = n:NAME "<" a:type ( "," a:type )* ","? ">" -> applied_type(n, a)
            type_atom = n:NAME "?" -> opt_type(n)
            type_atom = n:NAME -> plain_type(n)
        }
        builders: rows
        diags: codes
    }
    type_expr
}
