//! `v.type(T)` — a TYPE LITERAL: the type in the language's own
//! spelling, folded to an id by its receiver. Pure sugar at parse
//! time: the receiver's `interned` is called ONCE with the spelling
//! as a `TypeLit` value, so `cx.type(List<string?>)` is
//! `cx.interned(.List(.Opt(.Str)))` and the receiver is read once.
//! The words and the three constructors spell shapes; every other
//! NAME is a hole — a `TypeId` binding in scope
//! (`cx.type(Map<string, want>)`). A declared type has no spelling
//! here: its id is a binding, so the hole is how it is named.
use core.{Expr, ExprId, TypeRef, plain, Scoped, some_list, type_words, type_applieds}
use features.{Builder, LangNode, chained_binder}

/// `subject.type(T)` — the literal over the value so far.
fn build_type_link(b: Builder) -> Result<LangNode, string> {
    b.wrap_expr(type_literal(b, b.expr(0)?, b.type_ref(1)?)?)
}

/// `subject?.type(T)`.
fn build_chained_type_link(b: Builder) -> Result<LangNode, string> {
    b.wrap_expr(chained_type_literal(b, b.expr(0)?, b.type_ref(1)?)?)
}

/// `v.type(T)` keeps what was written; the receiver's `interned` call over
/// the spelling is minted beside it, and a type no literal can spell is
/// refused where it is written.
fn type_literal(b: Builder, subject: ExprId, t: TypeRef) -> Result<ExprId, string> {
    let fault? = unspellable(t) else {
        let sugar = b.expr_node(Expr.TypeLit(subject, t))
        let _ = b.store.mean(sugar, type_means(b.source_of(sugar)), b.words.door)
        return .Ok(sugar)
    }
    .Err(fault)
}

/// `a?.type(T)` IS `match a { null -> null, v? -> v.type(T) }`, the
/// chain every `?.` link lowers to.
fn chained_type_literal(b: Builder, subject: ExprId, t: TypeRef) -> Result<ExprId, string> {
    let carried = b.store.alloc_expr(Expr.Ident(Scoped(chained_binder)), b.span)
    let call = type_literal(b, carried, t)?
    let absent = b.store.alloc_expr(Expr.NullLit, b.span)
    .Ok(b.store.alloc_expr(Expr.MatchOpt(subject, Scoped(chained_binder), call, absent), b.span))
}

/// Why a type has no spelling, when it has none: a `dyn`, a word or a
/// declared name given arguments, a constructor of the wrong arity.
fn unspellable(t: TypeRef) -> string? {
    if t.optional { return unspellable(plain(t)) }
    if t.dynamic { return no_spelling("`dyn ${t.name}`") }
    let inner = [f for a in t.args for f in some_list(unspellable(a))].first()
    if t.arrow { return inner }
    if type_words.any(it.name == t.name) { return if t.args.is_empty() { null } else { "`${t.name}` takes no type arguments" } }
    let applied? = type_applieds.find(it.name == t.name) else { return if t.args.is_empty() { null } else { no_spelling("`${t.name}<…>`") } }
    if t.args.length != applied.arity { return "`${t.name}` is applied to ${t.args.length} types; it takes ${applied.arity}" }
    inner
}

// ── The voices ──

fn no_spelling(what: string) -> string {
    "a type literal spells a structural type — ${what} names a declaration, whose id is a binding: name that binding instead"
}

fn type_means(written: string) -> string {
    "`${written}` folds the type's spelling through the receiver's `interned`"
}
