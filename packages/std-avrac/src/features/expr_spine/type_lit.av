//! `v.type(T)` — a TYPE LITERAL: the type in the language's own
//! spelling, folded to an id by its receiver. Pure sugar at parse
//! time: the receiver's `interned` is called ONCE with the spelling
//! as a `TypeLit` value, so `cx.type(List<string?>)` is
//! `cx.interned(.List(.Opt(.Str)))` and the receiver is read once.
//! The words and the three constructors spell shapes; every other
//! NAME is a hole — a `TypeId` binding in scope
//! (`cx.type(Map<string, want>)`). A declared type has no spelling
//! here: its id is a binding, so the hole is how it is named.
use core.{
    Expr,
    ExprId,
    TypeRef,
    TypeId,
    Reg,
    Span,
    SyntaxArena,
    NodeFacts,
    Minting,
    minting,
    expr_node,
    plain,
    mut_mark,
    settled_mark,
    Plain,
    Scoped,
}
use core.marks.{sequence}
use features.{Meaning, MeanCx, ResolveCx, TypeCx, LowerCx, nothing}

/// A word that spells a shape of its own.
type Word = { name: string, variant: string }

/// A constructor: the shape it spells and the types it takes.
type Applied = { name: string, variant: string, arity: int }

export const words: List<Word> = [
    Word { name: "int", variant: "Int" },
    Word { name: "float", variant: "Float" },
    Word { name: "bool", variant: "Bool" },
    Word { name: "string", variant: "Str" },
    Word { name: "Bytes", variant: "Bytes" },
    Word { name: "ptr", variant: "Ptr" },
    Word { name: "void", variant: "Void" },
]

export const applieds: List<Applied> = [
    Applied { name: "List", variant: "List", arity: 1 },
    Applied { name: "Map", variant: "Map", arity: 2 },
    Applied { name: "Result", variant: "Res", arity: 2 },
]

/// `subject.type(T)` — the literal over the value so far, meaning the
/// receiver's `interned` over the type's spelling.
@expr_node
@sequence
export type TypeLiteral = { subject: ExprId, ty: TypeRef }

impl NodeFacts for TypeLiteral {
    fn says(written: string) -> string? {
        "`${written}` asks the receiver to fold the type, spelled as a value, into its id"
    }
}

impl Meaning for TypeLiteral {
    fn minted(cx: MeanCx) -> Result<Minting, string> {
        let before = cx.store.exprs.count()
        let root = cx.store.type_literal(self.subject, cx.store.spelling(self.ty)?, cx.span)
        .Ok(minting(cx.store.allocated_since(before, root)))
    }
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId { cx.meant_type(e) }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg { cx.meant_reg(e) }
}

impl SyntaxArena {
    /// The literal's call: the receiver's `interned` over the spelling.
    fn type_literal(subject: ExprId, lit: ExprId, span: Span?) -> ExprId {
        self.alloc_expr(Expr.MethodCall(subject, "interned", [lit]), span)
    }

    /// A written type as a `TypeLit` VALUE — bare variants, heard from
    /// the `interned` seat. A hole is marked as the literal's, so a
    /// binding of the wrong type refuses as a hole.
    fn spelling(t: TypeRef) -> Result<ExprId, string> {
        if t.optional { return .Ok(self.spelled(t, "Opt", [self.spelling(plain(t))?])) }
        if t.dynamic { return .Err(no_spelling("`dyn ${t.name}`")) }
        if t.arrow { return self.fn_spelling(t) }
        let word: Word? = words.find(it.name == t.name)
        if word != null {
            if !t.args.is_empty() { return .Err("`${t.name}` takes no type arguments") }
            return .Ok(self.spelled(t, word!.variant, []))
        }
        let found: Applied? = applieds.find(it.name == t.name)
        if found == null {
            if !t.args.is_empty() { return .Err(no_spelling("`${t.name}<…>`")) }
            let hole = self.alloc_expr(Expr.Ident(Scoped(t.name)), t.span)
            self.mark_hole(hole)
            return .Ok(self.spelled(t, "Id", [hole]))
        }
        let applied = found!
        if t.args.length != applied.arity {
            return .Err(
                "`${t.name}` is applied to ${t.args.length} types; it takes ${applied.arity}",
            )
        }
        .Ok(self.spelled(t, applied.variant, [self.spelling(a)? for a in t.args]))
    }

    /// `fn(a, mut b) -> r` — the seats, their marks, the answer: the
    /// LAST written type is the answer, the fn-type builder's contract.
    fn fn_spelling(t: TypeRef) -> Result<ExprId, string> {
        let seats = t.args.length - 1
        let params = [self.spelling(t.args[j])? for j in 0..seats]
        let muts = [self.alloc_expr(Expr.BoolLit(mut_mark(t.marks, j)), t.span) for j in 0..seats]
        let consts = [self.alloc_expr(Expr.BoolLit(settled_mark(t.marks, j)), t.span) for j in 0..seats]
        let ret = self.spelling(t.args[seats])?
        .Ok(
            self
                .spelled(
                    t,
                    "Fn",
                    [
                        self.alloc_expr(Expr.ListLit(params), t.span),
                        self.alloc_expr(Expr.ListLit(muts), t.span),
                        self.alloc_expr(Expr.ListLit(consts), t.span),
                        ret,
                    ],
                ),
        )
    }

    /// One `TypeLit` variant over its parts, at the written type's place.
    fn spelled(t: TypeRef, name: string, args: List<ExprId>) -> ExprId {
        self.alloc_expr(Expr.VariantLit(Plain(name), args), t.span)
    }
}

// ── The voices ──

fn no_spelling(what: string) -> string {
    "a type literal spells a structural type — ${what} names a declaration, whose id is a binding: name that binding instead"
}
