// The type literal: `v.type(T)` is `v.interned(<T as a TypeLit value>)`,
// expanded at parse time — one call, the receiver read once, bare
// variants heard from the seat. What it spells, what it refuses, and
// the words a receiver that cannot answer hears. `parse_expr` is the
// spine suite's, one module over.
use @std.avrac.testing.{shown, refused_with}

/// The receiver every program below folds with: a spelling rendered back.
fn names() -> string {
    "enum Sp { Int, Str, Bool, Opt(inner: Sp), List(elem: Sp), Map(k: Sp, v: Sp), Res(ok: Sp, err: Sp), Fn(ps: List<Sp>, muts: List<bool>, consts: List<bool>, ret: Sp), Id(id: int), Float, Ptr, Void }\ntype N = { held: List<string> }\nimpl N {\n    fn interned(t: Sp) -> string {\n        match t {\n            .Int -> \"int\", .Str -> \"string\", .Bool -> \"bool\", .Float -> \"float\", .Ptr -> \"ptr\", .Void -> \"void\",\n            .Opt(i) -> \"\${self.interned(i)}?\", .List(e) -> \"List<\${self.interned(e)}>\",\n            .Map(k, v) -> \"Map<\${self.interned(k)}, \${self.interned(v)}>\", .Res(a, b) -> \"Result<\${self.interned(a)}, \${self.interned(b)}>\",\n            .Fn(ps, muts, _, r) -> \"fn\${ps.length}\${muts.length} -> \${self.interned(r)}\", .Id(id) -> self.held[id],\n        }\n    }\n}\nlet n = N { held: [\"H\", \"K\"] }\nlet h = 0\n"
}

spec "features/expr_spine (type literal)" {
    given "the expansion" {
        then "`r.type(int?)` is ONE method call, `interned`, over a bare variant tree" {
            let p = parse_expr("r.type(int?)")
            let shape = match p.store.expr(p.root!) {
                .MethodCall(subject, name, args) -> {
                    let inner = match p.store.expr(args[0]) {
                        .VariantLit(v, vargs) -> v == "Opt" &&
                            vargs.length == 1 &&
                            match p.store.expr(vargs[0]) {
                                .VariantLit(w, wargs) -> w == "Int" && wargs.is_empty(),
                                _ -> false,
                            },
                        _ -> false,
                    }
                    p.store.expr(subject) is .Ident &&
                        name == "interned" &&
                        args.length == 1 &&
                        inner
                },
                _ -> false,
            }
            p.diagnostics == 0 && shape
        }
        then "the call carries the literal's mark; a written `r.interned(.Int)` does not" {
            let p = parse_expr("r.type(int)")
            let q = parse_expr("r.interned(.Int)")
            p.store.is_type_lit(p.root!) && !q.store.is_type_lit(q.root!)
        }
        then "the two spellings fingerprint APART — the mark is part of the node" {
            let p = parse_expr("r.type(int)")
            let q = parse_expr("r.interned(.Int)")
            p.store.expr_fingerprint(p.root!) != q.store.expr_fingerprint(q.root!)
        }
        then "a name that spells no shape is a HOLE — an identifier read in scope" {
            let p = parse_expr("r.type(List<held>)")
            let hole = match p.store.expr(p.root!) {
                .MethodCall(_, _, args) -> match p.store.expr(args[0]) {
                    .VariantLit(_, vargs) -> match p.store.expr(vargs[0]) {
                        .VariantLit(v, wargs) -> v == "Id" &&
                            match p.store.expr(wargs[0]) { .Ident(n) -> n == "held", _ -> false },
                        _ -> false,
                    },
                    _ -> false,
                },
                _ -> false,
            }
            p.diagnostics == 0 && hole
        }
        then "the literal is a postfix like the rest: it chains, and a chain reaches it" {
            let p = parse_expr("a.b.type(int).c[0]")
            p.diagnostics == 0 && p.store.expr(p.root!) is .Index
        }
    }
    given "what a literal spells, folded by a receiver" {
        then "the six words" {
            shown(
                names() +
                    "\"\${n.type(int)} \${n.type(string)} \${n.type(bool)} \${n.type(float)} \${n.type(ptr)} \${n.type(void)}\"",
            ) == "int string bool float ptr void"
        }
        then "`?` wraps, at any depth" {
            shown(names() + "\"\${n.type(int?)} \${n.type(List<int?>?)}\"") == "int? List<int?>?"
        }
        then "the three constructors" {
            shown(
                names() +
                    "\"\${n.type(List<bool>)} \${n.type(Map<string, int>)} \${n.type(Result<int, string>)}\"",
            ) == "List<bool> Map<string, int> Result<int, string>"
        }
        then "a fn type carries its seats, their marks and its answer — an unwritten answer is void" {
            shown(names() + "\"\${n.type(fn(int, mut string) -> bool)} \${n.type(fn())}\"") == "fn22 -> bool fn00 -> void"
        }
        then "a hole reads the binding it names" {
            shown(names() + "\"\${n.type(h)} \${n.type(List<h>)}\"") == "H List<H>"
        }
        then "the receiver is read ONCE — a counting receiver counts one" {
            shown(
                "type C = { n: int }\nenum Sp { Int, Opt(inner: Sp), Id(id: int) }\nimpl C {\n    mut fn interned(t: Sp) -> int { self.n = self.n + 1\n        self.n }\n}\nmut c = C { n: 0 }\nlet a = c.type(int?)\n\"\${a} \${c.n}\"",
            ) == "1 1"
        }
    }
    given "what a literal refuses" {
        then "`dyn Show` names a declaration — its id is a binding" {
            refused_with(
                names() + "n.type(dyn Show)",
                "a type literal spells a structural type — `dyn Show` names a declaration",
            )
        }
        then "an applied name that is no constructor" {
            refused_with(names() + "n.type(Box<int>)", "`Box<…>` names a declaration")
        }
        then "a word takes no arguments" {
            refused_with(names() + "n.type(int<bool>)", "`int` takes no type arguments")
        }
        then "a constructor's arity is the type grammar's" {
            refused_with(
                names() + "n.type(List<int, int>)",
                "`List` is applied to 2 types; it takes 1",
            )
        }
        then "an unclosed literal names its closer" {
            refused_with(names() + "n.type(int", "expected `)` to close the type literal")
        }
        then "a receiver with no `interned` refuses in the LITERAL's words, not the expansion's" {
            refused_with(
                "type R = { n: int }\nlet r = R { n: 0 }\nr.type(int)",
                "`.type(…)` interns into its receiver, and `R` has no `interned`",
            )
        }
        then "a scalar receiver refuses in the literal's words too" {
            refused_with(
                "let r = 1\nr.type(int)",
                "`.type(…)` interns into its receiver, and `int` has no `interned`",
            )
        }
        then "a hole that names nothing refuses at the NAME" {
            refused_with(names() + "n.type(List<nothing>)", "`nothing` is not defined")
        }
        then "a hole of the wrong type refuses as a HOLE — the expansion's seat stays behind the words" {
            refused_with(
                names() + "let s = \"x\"\nn.type(List<s>)",
                "`s` is a type literal's hole — it names an id, and this `s` holds `string`",
            )
        }
    }
}
