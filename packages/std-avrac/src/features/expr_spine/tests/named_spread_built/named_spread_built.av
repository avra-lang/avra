// proves: named arguments fill seats past the defaults; a list literal spreads lists into itself.
fn box(w: int, h: int = 2, label: string = "box") -> string { "${label}:${w * h}" }
let xs = [1, 2]
let more = [0, ..xs, 3]
let ys = [..more, ..xs]
"${box(3)} ${box(3, h: 4)} ${box(w: 1, label: "l")} ${more.length} ${ys.length} ${ys[3]}"
