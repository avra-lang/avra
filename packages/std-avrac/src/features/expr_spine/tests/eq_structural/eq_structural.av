// proves: structural `==` over a record holding a list, a nested
// record, a payload enum, a list of records and a map — one law,
// shared with `contains`, `index_of` and a const pattern. eval == native.
type P = { a: int, b: int }
type S = { seen: List<int>, tag: string }
type Outer = { inner: P, s: S }
enum E {
    A(x: int, y: string)
    B
}
let s1 = S { seen: [1, 2], tag: "x" }
let s2 = S { seen: [1, 2], tag: "x" }
let s3 = S { seen: [1, 3], tag: "x" }
let o1 = Outer { inner: P { a: 1, b: 2 }, s: s1 }
let o2 = Outer { inner: P { a: 1, b: 2 }, s: s2 }
let e1 = E.A(1, "a")
let e2 = E.A(1, "a")
let e3 = E.A(1, "b")
let ps = [P { a: 1, b: 2 }, P { a: 3, b: 4 }]
let m1 = {"a": 1, "b": 2}
let m2 = {"b": 2, "a": 1}
let m3 = {"a": 1, "b": 3}
"${s1 == s2} ${s1 == s3} ${o1 == o2} ${e1 == e2} ${e1 == e3} ${e1 == E.B} ${ps.contains(P { a: 3, b: 4 })} ${ps.index_of(P { a: 1, b: 2 })} ${m1 == m2} ${m1 == m3}"
