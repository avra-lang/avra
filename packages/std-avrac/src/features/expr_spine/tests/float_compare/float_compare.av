// proves: each float comparison answers IEEE-754 over NaN, ±0 and ±inf.
// `==` and the ordering compares are ordered (false on a NaN); `!=` is
// unordered, so a NaN is unequal to everything, itself included.
fn row(a: float, b: float) -> string {
    "${a == b} ${a != b} ${a < b} ${a <= b} ${a > b} ${a >= b}"
}

let nan = 0.0 / 0.0
let inf = 1.0 / 0.0
println(row(nan, nan))
println(row(nan, 1.0))
println(row(1.0, nan))
println(row(0.0, -0.0))
println(row(inf, inf))
println(row(inf, 0.0 - inf))
println(row(1.0, 2.0))
