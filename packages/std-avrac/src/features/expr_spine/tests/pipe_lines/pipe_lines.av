//! The pipe's line law, both engines: a line that ENDS in `|>`
//! continues — in a binding, a const, a fn's tail and an argument.
fn doubled_for_the_line_law(n: int) -> int { n * 2 }

fn summed_with_for_the_line_law(a: int, b: int) -> int { a + b }

fn tail(n: int) -> int {
    n |>
        doubled_for_the_line_law |>
        summed_with_for_the_line_law(1) |>
        doubled_for_the_line_law |>
        summed_with_for_the_line_law(2)
}

const settled = 1 |>
    doubled_for_the_line_law |>
    doubled_for_the_line_law |>
    doubled_for_the_line_law |>
    doubled_for_the_line_law

let bound = 2 |>
    summed_with_for_the_line_law(3) |>
    doubled_for_the_line_law |>
    summed_with_for_the_line_law(4) |>
    doubled_for_the_line_law
let seated = summed_with_for_the_line_law(
    1 |>
        doubled_for_the_line_law |>
        doubled_for_the_line_law |>
        doubled_for_the_line_law |>
        doubled_for_the_line_law,
    1,
)
"${settled} ${bound} ${tail(4)} ${seated}"
