//! The pipe's line law, both engines: a line that ENDS in `|>`
//! continues, in a binding, a fn's tail and an argument.
fn dbl(n: int) -> int { n * 2 }

fn add(a: int, b: int) -> int { a + b }

fn tail(n: int) -> int {
    n |>
        dbl |>
        add(1)
}

const settled = 1 |>
    dbl |>
    dbl

let bound = 2 |>
    add(3) |>
    dbl
"${settled} ${bound} ${tail(4)} ${add(1 |>
    dbl, 1)}"
