// proves: one expression tree using a comprehension, a when, a match,
// an if, a block, a nullable match, a chain, a struct literal, a
// property read, a call, a method call and an interpolation answers
// the same in both engines — every node's walk and want reached
// through its record.
type Id = { n: int }
enum Color { Red, Blue, Green }

fn dbl(x: int) -> int { x * 2 }

impl Id {
    fn scaled(k: int) -> int { self.n * k }
}

fn pick(c: Color) -> int {
    match c { .Red -> 1, .Blue -> 2, .Green -> 3 }
}

let c: Color = if true { .Red } else { .Blue }
let xs: List<int> = [x * 2 for x in [1, 2, 3]]
let m = {"a": 1, "b": 2}
let opt: int? = 6
let via = match opt {
    v? -> v
    null -> 0
}
let s: Id? = Id { n: 7 }
let chained = s?.n ?? 0
let w = when {
    true -> 10
    _ -> 20
}
let g = {
    let t = 3
    t + 1
}
"${pick(c)} ${xs.length} ${m.length} ${via} ${chained} ${w} ${g} ${dbl(4)} ${Id { n: 3 }.scaled(2)}"
