// proves: the operator ladder — precedence, grouping, comparisons,
// `!`, string `!=`, and the lazy ops skipping a division that must
// never run — natively
fn is_even(n: int) -> bool {
    n % 2 == 0
}
let a = 2 + 3 * 4 - 10 / 2
let lo = a >= 9 && a <= 9 && a != 8
let danger = a > 0 || 1 / (a - a) == 0
let safe = a < 0 && 1 / (a - a) == 0
let word = if is_even(a) { "even" } else { "odd" }
if lo && danger && !safe && word != "even" { (a + 1) * a } else { 0 - 1 }
