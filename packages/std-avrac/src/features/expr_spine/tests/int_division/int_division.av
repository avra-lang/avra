// proves: `/` and `%` agree across BOTH engines, including the
// guarded path — division routes through a runtime that refuses a
// zero divisor, because a raw sdiv is undefined and printed an
// answer while the interpreter refused
fn half(n: int) -> int {
    n / 2
}

fn rem(n: int, d: int) -> int {
    n % d
}

let a = 100 / 7
let b = 100 % 7
let c = half(9)
let d = rem(0 - 17, 5)
let deep = 1000 / 2 / 5 / 10
"a ${a} b ${b} c ${c} d ${d} deep ${deep}"
