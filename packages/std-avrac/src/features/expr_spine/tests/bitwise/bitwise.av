//! The bitwise band, both engines. Every operator, both shift
//! directions, the sign that arithmetic shift preserves, and the
//! precedence that makes `a & m == v` mean what it looks like.
fn masked(flags: int, mask: int) -> bool {
    flags & mask == mask
}

fn bit(n: int) -> int {
    1 << n
}

let a = 12
let b = 10

let flags = bit(0) | bit(2) | bit(4)
let signed = 0 - 8

"and=${a & b} or=${a | b} xor=${a ^ b} not=${~a}" +
" shl=${a << 2} shr=${a >> 2} asr=${signed >> 1}" +
" flags=${flags} has2=${masked(flags, bit(2))} has1=${masked(flags, bit(1))}" +
" prec=${a & b == 8} roundtrip=${(a << 3) >> 3}"
