// proves: a constant divisor answers what a computed one does in both
// engines — the quotient truncates toward zero, the remainder takes
// the dividend's sign — and -1 on the smallest int wraps to itself
fn by(n: int, d: int) -> int {
    n / d
}

fn rem(n: int, d: int) -> int {
    n % d
}

fn q256(n: int) -> int {
    n / 256
}

fn r256(n: int) -> int {
    n % 256
}

fn qm7(n: int) -> int {
    n / -7
}

fn rm7(n: int) -> int {
    n % -7
}

fn qm1(n: int) -> int {
    n / -1
}

fn rm1(n: int) -> int {
    n % -1
}

fn same(n: int) -> bool {
    q256(n) == by(n, 256) && r256(n) == rem(n, 256) && qm7(n) == by(n, -7) && rm7(n) == rem(n, -7)
}

let smallest = -9223372036854775807 - 1
let agree = [0, 1, 255, 256, 257, 1000, -1, -255, -256, -257, -1000, smallest].all(same(it))
"${q256(1000)} ${r256(1000)} ${q256(-1000)} ${r256(-1000)} ${qm7(1000)} ${rm7(1000)} ${qm7(-1000)} ${rm7(-1000)} ${qm1(5)} ${qm1(smallest)} ${rm1(smallest)} ${by(smallest, -1)} ${rem(smallest, -1)} ${agree}"
