// The first feature, end to end: its grammar text through
// parse_grammar, real source through the executor, builders
// allocating into the arena — asserting structure, spans (cover in
// anger), and the fingerprint invariant across differently-formatted
// sources.
use @std.avrac.core.{NodeStore, new_node_store, Expr, BinOp, ExprId, Span}
use @std.avrac.grammar.{Captured, run_grammar, lex_grammar, parse_grammar, RunOutcome}
use @std.avrac.features.{
    LangNode, LanguageFeature, compose_text, dispatch, expr_id_at,
}
use @std.avrac.features.expr_spine.{expr_spine}

/// A test harness feature: wraps the spine in a BREAK-consuming start
/// rule via a pass-through build, so plain expressions parse whole.
/// Registers no builders — `-> e` is a Var, not a call.
fn harness() -> LanguageFeature {
    component LanguageFeature h {
        name = "harness"
        gram = "prog = e:expression BREAK -> e"
    }
    h
}

type Parsed = { store: NodeStore, root: ExprId?, diagnostics: int }

fn parse_expr(source: string) -> Parsed {
    let feats = [harness(), expr_spine()]
    let composed = compose_text(feats)
    let gp = parse_grammar(composed.text)
    if gp.grammar == null {
        return Parsed { store: new_node_store(), root: null, diagnostics: gp.diagnostics.length }
    }
    let store = new_node_store()
    let build = (name: string, args: List<Captured<LangNode>>, span: Span?) -> dispatch(feats, store, name, args, span)
    let o = run_grammar<LangNode>(gp.grammar!, lex_grammar(source).tokens, build)
    mut root: ExprId? = null
    if o.result != null { root = expr_id_at([o.result!], 0) }
    Parsed { store: store, root: root, diagnostics: o.diagnostics.length }
}

spec "features/expr_spine" {
    given "1 + 2 - x" {
        then "the tree is left-associative with five arena nodes" {
            let p = parse_expr("1 + 2 - x")
            let tree_ok = match p.store.expr(p.root!) {
                .Binary(op, left, right) -> {
                    let inner = match p.store.expr(left) {
                        .Binary(iop, il, ir) -> iop == BinOp.Add &&
                            p.store.expr(il) is .IntLit && p.store.expr(ir) is .IntLit,
                        .IntLit(_) -> false, .Ident(_) -> false, .Error -> false,
                    }
                    op == BinOp.Sub && inner && p.store.expr(right) is .Ident
                }
                .IntLit(_) -> false, .Ident(_) -> false, .Error -> false,
            }
            p.diagnostics == 0 && p.store.exprs.count() == 5 && tree_ok
        }
        then "the root's span covers the whole expression" {
            let p = parse_expr("1 + 2 - x")
            let s = p.store.expr_span(p.root!)
            s?.lo == 0 && s?.hi == 9
        }
        then "a literal's span arrives from the engine, not the builder" {
            let p = parse_expr("40 + 2")
            match p.store.expr(p.root!) {
                .Binary(_, left, _) -> {
                    let s = p.store.expr_span(left)
                    s?.lo == 0 && s?.hi == 2
                }
                .IntLit(_) -> false, .Ident(_) -> false, .Error -> false,
            }
        }
        then "literal payloads parse as integers" {
            let p = parse_expr("40 + 2")
            match p.store.expr(p.root!) {
                .Binary(_, left, _) -> match p.store.expr(left) {
                    .IntLit(v) -> v == 40,
                    .Ident(_) -> false, .Binary(_, _, _) -> false, .Error -> false,
                },
                .IntLit(_) -> false, .Ident(_) -> false, .Error -> false,
            }
        }
    }
    given "the same content formatted differently" {
        then "root fingerprints agree across stores; spans do not intrude" {
            let a = parse_expr("1 + 2 - x")
            let b = parse_expr("1   +   2   -   x")
            a.store.expr_fingerprint(a.root!) == b.store.expr_fingerprint(b.root!)
        }
    }
    given "broken source" {
        then "diagnostics arrive instead of a crash" {
            let p = parse_expr("1 +")
            p.diagnostics >= 1
        }
    }
}
