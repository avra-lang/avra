//! The float, both engines. Arithmetic, the ordered comparisons, the
//! text that round-trips, and the answer IEEE gives rather than the
//! one decimal arithmetic would.
fn area(r: float) -> float {
    3.14159 * r * r
}

fn nearer(a: float, b: float, target: float) -> float {
    let da = if a > target { a - target } else { target - a }
    let db = if b > target { b - target } else { target - b }
    if da < db { a } else { b }
}

let half = 0.5
let quarter = half * half

// EVERY CONTAINER, because the first version of this file had none
// and every one of them was an internal compiler error: a program
// program for a new VALUE proves the value, and the containers are a
// separate obligation.
type PT = { x: float }
enum FK { A(v: float), B }

fn answered() -> Result<float, string> { .Ok(3.5) }

let boxed = PT { x: 2.5 }
let tagged = FK.A(1.25)
let listed = [4.5, 5.5]
let from_enum = match tagged { .A(v) -> v, .B -> 0.0 }
let from_result = match answered() { .Ok(v) -> v, .Err(_) -> 0.0 }

"sum=${1.5 + 0.25} diff=${1.5 - 0.25} prod=${1.5 * 0.25} quot=${1.5 / 0.25}" +
    " field=${boxed.x} payload=${from_enum} ok=${from_result} elem=${listed[1]}" +
    " quarter=${quarter} area=${area(2.0)} nearer=${nearer(1.0, 2.75, 3.0)}" +
    " lt=${0.1 < 0.2} ge=${2.0 >= 2.0} eq=${0.5 == half} ne=${0.5 != 0.25}" +
    " tenths=${0.1 + 0.2} whole=${4.0 / 2.0} neg=${0.0 - 1.5}"
