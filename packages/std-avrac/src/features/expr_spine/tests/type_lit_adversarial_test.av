// The red team on the type literal: every attack class, the
// survivors pinned. `names()` is the vertical suite's fixture, one
// module over: a receiver whose `interned` renders the spelling back.
use @std.avrac.testing.{shown, refused_with, refusals}

/// A receiver whose `interned` COUNTS — the read-once law's witness.
fn counting() -> string {
    "enum Sp { Int, Opt(inner: Sp), List(elem: Sp) }\ntype C = { n: int, seen: List<string> }\nimpl C {\n    mut fn interned(t: Sp) -> string { self.seen.push(\"x\")\n        self.n = self.n + 1\n        \"\${self.n}:\${self.seen.length}\" }\n}\nmut c = C { n: 0, seen: [] }\n"
}

spec "features/expr_spine (type literal) — the red team" {
    given "degenerate shapes" {
        then "a fn type with no seats and no answer" {
            shown(names() + "n.type(fn())") == "fn00 -> void"
        }
        then "nesting closes through `>>` — the type grammar's two tokens, inside a literal" {
            shown(names() + "n.type(List<List<List<int>>>)") == "List<List<List<int>>>"
        }
        then "every constructor inside every other" {
            shown(
                names() +
                    "n.type(Map<List<int>, Result<Map<string, int?>, fn(int) -> List<bool>?>>)",
            ) == "Map<List<int>, Result<Map<string, int?>, fn11 -> List<bool>?>>"
        }
        then "a trailing comma in a constructor's arguments, as everywhere" {
            shown(names() + "n.type(List<int,>)") == "List<int>"
        }
        then "a bare constructor is an arity mistake, named" {
            refused_with(names() + "n.type(List)", "`List` is applied to 0 types; it takes 1")
        }
        then "an empty literal takes a TYPE — and no method wears a keyword's name" {
            refused_with(
                names() + "n.type()",
                "`.type(…)` names no method — `type` is a keyword",
            )
        }
    }
    given "wrong types in every slot" {
        then "a text receiver refuses in the literal's words" {
            refused_with(
                names() + "\"a\".type(int)",
                "`.type(…)` interns into its receiver, and `string` has no `interned`",
            )
        }
        then "a nullable receiver refuses in the literal's words — unwrap or chain" {
            refused_with(
                names() + "let z: N? = n\nz.type(int)",
                "`.type(…)` interns into its receiver, and `N?` has no `interned`",
            )
        }
        then "a type NAME as the receiver refuses in the literal's words, not the variant's" {
            refused_with(
                names() + "N.type(int)",
                "`.type(…)` interns into its receiver, and `N` has no `interned`",
            )
        }
        then "a value in the slot: a number" {
            refused_with(
                names() + "n.type(1)",
                "`.type(…)` names no method — `type` is a keyword",
            )
        }
        then "a value in the slot: a text" {
            refused_with(
                names() + "n.type(\"int\")",
                "`.type(…)` names no method — `type` is a keyword",
            )
        }
        then "a value in the slot: an expression" {
            refused_with(
                names() + "n.type(1 + 1)",
                "`.type(…)` names no method — `type` is a keyword",
            )
        }
        then "a keyword in the slot is the keyword law's, once" {
            refused_with(names() + "n.type(let)", "`let` is a keyword")
        }
        then "a hole naming a TYPE refuses as a hole — it names an id" {
            refused_with(names() + "n.type(N)", "`N` is a type literal's hole")
        }
        then "a hole holding the wrong type refuses as a hole, naming what it holds" {
            refused_with(
                names() + "let s = \"x\"\nn.type(List<s>)",
                "`s` is a type literal's hole — it names an id, and this `s` holds `string`",
            )
        }
        then "a literal's ANSWER in the wrong seat refuses as an argument — the call is no hole" {
            refused_with(
                names() + "fn f(x: int) -> int { x }\nf(n.type(int))",
                "argument 1 of `f` wants `int`, found `string`",
            )
        }
        then "a map's key is the RECEIVER's to judge — the literal spells any" {
            shown(names() + "n.type(Map<int, int>)") == "Map<int, int>"
        }
        then "arity, per constructor" {
            refused_with(
                    names() + "n.type(Result<int>)",
                    "`Result` is applied to 1 types; it takes 2",
                ) &&
                refused_with(
                    names() + "n.type(List<int, int, int>)",
                    "`List` is applied to 3 types; it takes 1",
                )
        }
    }
    given "malformed surface" {
        then "a missing `(` refuses exactly once" {
            refusals(names() + "n.type int)") == 1
        }
        then "a postfix after the literal judges the ANSWER" {
            refused_with(names() + "n.type(int)?", "`?` propagates a nullable, this is `string`")
        }
        then "the parentheses drop breaks, as every paren group does" {
            shown(names() + "n.type(\n    int\n)") == "int"
        }
        then "a leading dot continues the line" {
            shown(names() + "n\n    .type(int)") == "int"
        }
    }
    given "crossing other features" {
        then "a hole from a fn's own parameter" {
            shown(names() + "fn f(x: N, i: int) -> string { x.type(List<i>) }\nf(n, 0)") == "List<H>"
        }
        then "a comprehension element" {
            shown(names() + "[n.type(int) for i in 0..2].join(\"|\")") == "int|int"
        }
        then "a struct field's value" {
            shown(names() + "type W = { t: string }\nlet w = W { t: n.type(Result<int, h>) }\nw.t") == "Result<int, H>"
        }
        then "a lambda's body, over the lambda's seat" {
            shown(names() + "let f = (x: N) -> x.type(List<string>)\nf(n)") == "List<string>"
        }
        then "a trailing block after a literal is refused in the literal's words" {
            refused_with(names() + "n.type(int) { }", "a trailing block follows a type literal")
        }
        then "`?.` chains a literal through a nullable receiver — present" {
            shown(names() + "let z: N? = n\nlet r = z?.type(int)\nr ?? \"none\"") == "int"
        }
        then "`?.` chains a literal through a nullable receiver — absent" {
            shown(names() + "let z: N? = null\nlet r = z?.type(int)\nr ?? \"none\"") == "none"
        }
        then "a forced receiver" {
            shown(names() + "let z: N? = n\nz!.type(int?)") == "int?"
        }
        then "a type PARAMETER is no hole — it is not a binding, and refuses as none" {
            refused_with(
                names() + "fn g<T>(x: N) -> string { x.type(T) }\ng<int>(n)",
                "`T` is not defined",
            )
        }
        then "the answer under a `for` head is judged as what the receiver answered" {
            refused_with(names() + "for c in n.type(int) { }\n1", "names no element without a view")
        }
    }
    given "names against names" {
        then "a local named `interned` is not the method" {
            shown(names() + "let interned = 1\nn.type(int)") == "int"
        }
        then "a FIELD named `interned` is not the method either" {
            refused_with(
                names() + "type R = { interned: int }\nlet r = R { interned: 1 }\nr.type(int)",
                "`.type(…)` interns into its receiver, and `R` has no `interned`",
            )
        }
        then "a hole declared after its use is the order law's" {
            refused_with(
                names() + "n.type(List<later>)\nlet later = 0",
                "`later` is used before its definition",
            )
        }
        then "a hole reads the NEAREST binding of its name" {
            shown(names() + "let h = 1\nn.type(h)") == "K"
        }
        then "an `interned` with a second seat refuses in the method's words" {
            refused_with(
                names() +
                    "type R = { n: int }\nimpl R { fn interned(t: Sp, extra: int) -> string { \"s\" } }\nlet r = R { n: 0 }\nr.type(int)",
                "`R.interned` takes 2 arguments beside `self`, found 1",
            )
        }
        then "an `interned` whose seat is no enum refuses at the variant" {
            refused_with(
                names() +
                    "type R = { n: int }\nimpl R { fn interned(t: int) -> string { \"s\" } }\nlet r = R { n: 0 }\nr.type(int)",
                "`.Int` builds a variant, and `int` has none",
            )
        }
        then "a spelling enum missing a shape names the missing variant" {
            refused_with(
                "enum Q { Int, Opt(inner: Q) }\ntype R = { n: int }\nimpl R { fn interned(t: Q) -> int { 1 } }\nlet r = R { n: 0 }\nr.type(bool)",
                "`Q` has no variant `Bool`",
            )
        }
        then "a hole's type is the RECEIVER's `Id` seat — text here" {
            shown(
                "enum Q { Int, Id(id: string) }\ntype R = { n: int }\nimpl R { fn interned(t: Q) -> string { match t { .Int -> \"i\", .Id(s) -> s } } }\nlet r = R { n: 0 }\nlet w = \"word\"\nr.type(w)",
            ) == "word"
        }
    }
    given "ownership" {
        then "the receiver is read ONCE per literal, however deep the spelling" {
            shown(
                counting() +
                    "let a = c.type(List<List<int?>>)\nlet b = c.type(int)\n\"\${a} \${b} \${c.seen.length}\"",
            ) == "1:1 2:2 2"
        }
        then "a callee-minted receiver lives through the fold" {
            shown(
                names() +
                    "fn make() -> N { N { held: [\"M\"] } }\nlet h0 = 0\nmake().type(List<h0>)",
            ) == "List<M>"
        }
        then "two hundred literals in a loop keep every answer" {
            shown(
                names() +
                    "mut out: List<string> = []\nfor i in 0..200 { out.push(n.type(Map<string, List<int?>>)) }\n\"\${out.length} \${out[199]}\"",
            ) == "200 Map<string, List<int?>>"
        }
    }
}
