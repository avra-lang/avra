//! The lowering rule of `==` and `!=` past the values the language owns: a nullable against `null`
//! is its presence, only the nullable side read, and two sides that hold only null are equal; an enum,
//! a record and a list compare by the derived equality (core/equality.av), all the way down.
use core.{ExprId, Lowering, Reg, SignedType}

/// `l == r`, or `l != r` when `negated`, where one side is `null` or both are one enum or one record
/// of one field; absent, with nothing emitted, for any other operands.
fn compared_beyond(mut cx: Lowering, negated: bool, l: ExprId, r: ExprId) -> Reg? {
    let lt? = cx.type_at(l) else { return null }
    let rt? = cx.type_at(r) else { return null }
    if lt.absence() && rt.absence() { return absences_compared(cx, negated, l, r) }
    let asked = absence_asked(lt, rt, l, r)
    if asked != null {
        let present = cx.present(cx.lower(asked!), cx.type_at(asked!)!)
        return if negated { present } else { cx.not(present) }
    }
    // a scalar the language owns was compared before this; a list of what compares is asked here
    if lt.spelled() != rt.spelled() || !cx.equatable(lt) { return null }
    let a = cx.lower(l)
    let b = cx.lower(r)
    let same = cx.same_value(a, b, lt)
    if negated { cx.not(same) } else { same }
}

/// `l == r` where neither side can hold anything but null: each side run, and the answer fixed.
fn absences_compared(mut cx: Lowering, negated: bool, l: ExprId, r: ExprId) -> Reg {
    let _ = cx.lower(l)
    let _ = cx.lower(r)
    cx.const_bool(!negated)
}

/// The side whose presence `l == r` asks, of types `lt` and `rt`: a nullable against `null`.
fn absence_asked(lt: SignedType, rt: SignedType, l: ExprId, r: ExprId) -> ExprId? {
    if lt.nullable() && !lt.absence() && rt.absence() { return l }
    if rt.nullable() && !rt.absence() && lt.absence() { return r }
    null
}
