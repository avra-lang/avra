//! Parse-time lowering: captures -> expression nodes.
use core.{
    Expr,
    ExprId,
    BinOp,
    Pat,
    PatId,
    want,
    op_symbol,
    all_binops,
    TypeRef,
    pronoun_param,
    Plain,
    Scoped,
    span_of,
}
use features.{
    LangNode,
    Builder,
    token_at,
    pat_ids_at,
    zip_defect,
    aligned_binds,
    between,
    chained_binder,
    marked_seats,
}
use grammar.{Token}

fn build_int_lit(b: Builder) -> Result<LangNode, string> {
    let t = b.token(0)?
    // A FRACTION is a different literal wearing the same token: the
    // scanner joined the point, so the value is bits and not digits.
    if t.is_fraction() { return b.make_expr(Expr.FloatLit(t.float_bits())) }
    // the lexer already refused a literal no `int` holds, so absence
    // here is a defect, not a program's mistake
    b.make_expr(Expr.IntLit(t.int_value() ?? 0))
}

/// `name: value` in an argument list.
fn build_named_arg(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    b.make_expr(Expr.Named(Plain(n.text), b.expr(1)?))
}

fn build_ident(b: Builder) -> Result<LangNode, string> {
    let t = b.token(0)?
    b.make_expr(Expr.Ident(Scoped(t.text)))
}

/// `l (op r)*` folds left: each pair wraps the accumulator, so
/// `1 + 2 - x` is `(1 + 2) - x`.
fn build_fold_binary(b: Builder) -> Result<LangNode, string> {
    mut acc = b.expr(0)?
    let ops = b.tokens(1)?
    let rights = b.exprs(2)?
    for i, t in ops {
        let op = want(binop_of(t.text), "a binary operator")?
        acc = b.store.alloc_expr(Expr.Binary(op, acc, rights[i]), b.cover(acc, rights[i]))
    }
    b.wrap_expr(acc)
}

/// `l (op r)*` over the BITWISE band. One law lives here and it is
/// the reason the band is one rule rather than five: A RUN THAT MIXES
/// TWO DIFFERENT BITWISE OPERATORS IS REFUSED. `a | b & c` has two
/// readings a reader must know a table to choose between, and a
/// generated one is as likely to mean either — so it names both and
/// asks for parentheses instead of picking.
///
/// Only the run is visible here, which is exactly the right reach:
/// `a << 1 + 2` is a DIFFERENT level (the additive arrives already
/// built) and reads as C reads it, because C is arbitrary there
/// rather than wrong. What C gets wrong is `a & b == c`, and the
/// band's PLACE in the ladder — tighter than comparison — fixes that
/// without any law at all.
fn build_fold_bitwise(b: Builder) -> Result<LangNode, string> {
    mut acc = b.expr(0)?
    let ops = b.tokens(1)?
    let rights = b.exprs(2)?
    let mixed: Token? = ops.find(it.text != ops[0].text)
    if mixed != null { return .Err(mixed_bitwise(ops[0].text, mixed!.text)) }
    for i, t in ops {
        let op = want(binop_of(bitwise_symbol(t.text)), "a bitwise operator")?
        acc = b.store.alloc_expr(Expr.Binary(op, acc, rights[i]), b.cover(acc, rights[i]))
    }
    b.wrap_expr(acc)
}

/// A captured operator's SYMBOL. Shift-right arrives as a lone `>`
/// — its twin is matched and dropped by the grammar, because `>>`
/// cannot be one token without closing type arguments wrong — so the
/// one place that knows it names it here rather than at every reader.
fn bitwise_symbol(text: string) -> string {
    if text == ">" { return ">>" }
    text
}

/// The words that law refuses in — one place, so the two operators
/// it names are always the two the reader wrote.
fn mixed_bitwise(first: string, second: string) -> string {
    "`${first}` and `${second}` in one expression have no agreed order — write parentheses to say which binds first"
}

/// `~v` is `v ^ -1`: the parse desugars, so no pass learns a node —
/// the same trick `-v` uses, and for the same reason. Two's
/// complement makes the two exact, and an `Expr` variant would tax
/// every exhaustive match in the tree for a form that is already
/// spellable.
fn build_bitnot(b: Builder) -> Result<LangNode, string> {
    let v = b.expr(0)?
    let ones = b.store.alloc_expr(Expr.IntLit(0 - 1), b.span)
    let xor = want(binop_of("^"), "the xor operator")?
    b.make_expr(Expr.Binary(xor, v, ones))
}

/// `l (op r)?` — at most one comparison, never a chain; or `l is
/// .variant`, the tag test, which enums give meaning.
fn build_fold_cmp(b: Builder) -> Result<LangNode, string> {
    let l = b.expr(0)?
    let asked: Token? = token_at(b.args, 3)
    if asked != null { return asked_expr(b, l, asked!, pat_ids_at(b.args, 4)) }
    let op_tok? = token_at(b.args, 1) else { return b.wrap_expr(l) }
    let r = b.expr(2)?
    let op = want(binop_of(op_tok.text), "a comparison operator")?
    b.make_expr(Expr.Binary(op, l, r))
}

/// One seat of a payload `is` — a bare name or `_`, spelled here so a
/// partial assembly of the spine parses the form without enums. The
/// spellings a match's payload gives special meaning keep it here too,
/// so `is .V(rest)` and `match .V(rest)` mean one thing.
fn build_asked_bind(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    if n.text == "rest" { return b.make_pat(Pat.Rest) }
    if n.text == "null" { return b.make_pat(Pat.Lit(b.store.alloc_expr(Expr.NullLit, b.span))) }
    b.make_pat(Pat.Bind(Scoped(n.text)))
}

fn build_asked_wild(b: Builder) -> Result<LangNode, string> {
    b.make_pat(Pat.Wild)
}

/// `l is .V` — the tag test — and, when a payload list is written,
/// the variant PATTERN that list names, kept beside the node. The
/// `if` that means to bind reads the pattern and desugars to a match;
/// a payload `is` anywhere else has enums name it and refuse.
fn asked_expr(b: Builder, l: ExprId, asked: Token, payload: List<PatId>) -> Result<LangNode, string> {
    let id = b.expr_node(Expr.Is(l, Plain(asked.text)))
    if !payload.is_empty() {
        let pat = b.store.alloc_pat(Pat.Variant(Plain(asked.text), payload), b.span)
        b.store.mark_is_payload(id, pat, true)
    }
    b.wrap_expr(id)
}

fn build_not(b: Builder) -> Result<LangNode, string> {
    let v = b.expr(0)?
    b.make_expr(Expr.Not(v))
}

/// `-v` is `0 - v`: the parse desugars, so no pass learns a node.
/// A LITERAL FOLDS INSTEAD — `-1` and `-1.5` ARE literals, so a const
/// takes them and every reader that asks the value protocol gets
/// one. Only the literal: `-A` needs a general folder, which is a
/// core event because consts cannot match another feature's node.
fn build_neg(b: Builder) -> Result<LangNode, string> {
    let v = b.expr(0)?
    let held: int? = b.store.expr(v).int_of()
    if held != null { return b.make_expr(Expr.IntLit(0 - held!)) }
    let bits: int? = b.store.expr(v).bits_of()
    if bits != null { return b.make_expr(Expr.FloatLit(bits! ^ (1 << 63))) }
    let zero = b.store.alloc_expr(Expr.IntLit(0), b.span)
    let minus = want(binop_of("-"), "the minus operator")?
    b.make_expr(Expr.Binary(minus, zero, v))
}

/// `v (with { f: e, ... })?` — the absent tail is v itself. The
/// ladder owns the PARSE; the node's meaning lives with structs.
fn build_fold_with(b: Builder) -> Result<LangNode, string> {
    let subject = b.expr(0)?
    let wn = b.tokens(1)?
    if wn.is_empty() { return b.wrap_expr(subject) }
    let wv = b.exprs(2)?
    if wn.length != wv.length { return .Err(zip_defect) }
    let names = [k.text for k in wn]
    b.make_expr(Expr.With(subject, [Plain(t) for t in names], wv))
}

/// `v ( ! | ? )*` folds left, each link choosing its node: `!`
/// insists, `?` propagates. `x!!` insists twice, which the TYPE
/// then refuses — the second `!` has nothing left to unwrap. The
/// LADDER owns this parse; both nodes' meaning lives in `nullable`.
/// The node a force-position token names — propagation when `?`.
fn force_link(link: string, value: ExprId) -> Expr {
    if link == "?" { return Expr.Propagate(value) }
    Expr.Force(value)
}

/// `l ( ?? r )*` folds left: `a ?? b ?? c` is `(a ?? b) ?? c`. The
/// LADDER owns this parse; the node's meaning lives in `nullable`.
fn build_fold_coalesce(b: Builder) -> Result<LangNode, string> {
    mut acc = b.expr(0)?
    let rights = b.exprs(1)?
    for r in rights {
        acc = b.store.alloc_expr(Expr.Coalesce(acc, r), b.cover(acc, r))
    }
    b.wrap_expr(acc)
}

/// `v ( .name | .name(args) | ?.name | [i] | (args) | { … } | .type(T) )*`
/// — ONE postfix star: property links, method calls, chains, indexes,
/// applications, trailing blocks and type literals interleave freely, folded left
/// in SOURCE order (a merge over the capture families' spans). The
/// paren WITNESS in a link's window makes a dot a METHOD call; a
/// bare paren group applies the value built so far; a block widens
/// the call built so far by the call protocol, its `else` beside it.
/// The ladder owns the parse; each node's meaning lives with its
/// feature.
fn build_fold_postfix(b: Builder) -> Result<LangNode, string> {
    mut acc = b.expr(0)?
    let links = b.tokens(1)?
    let names = b.tokens(2)?
    let opens = b.tokens(3)?
    let margs = b.exprs(4)?
    let indexes = b.exprs(5)?
    let calls = b.tokens(6)?
    let cargs = b.exprs(7)?
    let forces = b.tokens(8)?
    let blocks = b.exprs(9)?
    let elses = b.exprs(10)?
    let spellings = b.type_refs(11)?
    let chained = b.type_refs(12)?
    if links.length != names.length { return .Err(zip_defect) }
    let whole? = b.span else { return .Err("defect: a postfix chain without a span — the arena and the grammar disagree") }
    let starts = whole.lo
    let ends = whole.hi
    // the five families' cursors — each turn folds the link whose
    // anchor comes first in the source
    mut jn = 0
    mut ji = 0
    mut jc = 0
    mut jf = 0
    mut jb = 0
    mut jt = 0
    mut jq = 0
    // a block after a block is a mistake named, never a third argument;
    // a block after a type literal too — a literal is no call
    mut blocked = false
    mut spelled = false
    while jn < names.length ||
        ji < indexes.length ||
        jc < calls.length ||
        jf < forces.length ||
        jb < blocks.length ||
        jt < spellings.length ||
        jq < chained.length {
        let np = if jn < names.length { names[jn].span.lo } else { ends }
        let ip = if ji < indexes.length { span_lo(b, indexes[ji]) ?? ends } else { ends }
        let cp = if jc < calls.length { calls[jc].span.lo } else { ends }
        let fp = if jf < forces.length { forces[jf].span.lo } else { ends }
        let bp = if jb < blocks.length { span_lo(b, blocks[jb]) ?? ends } else { ends }
        let tp = if jt < spellings.length { spellings[jt].span?.lo ?? ends } else { ends }
        let qp = if jq < chained.length { chained[jq].span?.lo ?? ends } else { ends }
        if tp < np && tp < ip && tp < cp && tp < fp && tp < bp && tp < qp {
            blocked = false
            spelled = true
            acc = type_literal(b, acc, spellings[jt])?
            jt = jt + 1
        } else if qp < np && qp < ip && qp < cp && qp < fp && qp < bp {
            blocked = false
            spelled = true
            acc = chained_type_literal(b, acc, chained[jq])?
            jq = jq + 1
        } else if bp < np && bp < ip && bp < cp && bp < fp {
            if spelled {
                return .Err(
                    "a trailing block follows a type literal — a literal is no call, and a block belongs to one",
                )
            }
            if blocked {
                return .Err(
                    "a second trailing block follows the first — `else { … }` fills the next fn seat, and a block statement starts on its own line",
                )
            }
            let upto = if jb + 1 < blocks.length { span_lo(b, blocks[jb + 1]) ?? ends } else { ends }
            acc = b.trailed(acc, [blocks[jb]].concat(args_between(b, elses, bp, upto)))?
            jb = jb + 1
            blocked = true
        } else {
            blocked = false
            spelled = false
            if fp < np && fp < ip && fp < cp {
                acc = b
                    .store
                    .alloc_expr(force_link(forces[jf].text, acc), span_of(starts, forces[jf].span.hi))
                jf = jf + 1
            } else if np <= ip && np <= cp {
                let upto = next_anchor(b, names, indexes, calls, jn + 1, ji, jc, ends)
                let called = opens.any(between(it.span.lo, np, upto))
                let name = names[jn]
                let link = links[jn].text
                jn = jn + 1
                if called {
                    let margs_here = [b.store.pronouned(a) for a in args_between(b, margs, np, upto)]
                    let hi = if more_links(
                        jn,
                        ji,
                        jc,
                        jf,
                        jb,
                        jt,
                        jq,
                        names,
                        indexes,
                        calls,
                        forces,
                        blocks,
                        spellings,
                        chained,
                    ) {
                        call_hi(b, name, margs_here)
                    } else {
                        ends
                    }
                    acc = if link == "?." {
                        chained_call(b, acc, name.text, margs_here)
                    } else {
                        b
                            .store
                            .alloc_expr(
                                Expr.MethodCall(acc, Plain(name.text), margs_here),
                                span_of(starts, hi),
                            )
                    }
                } else {
                    acc = b
                        .store
                        .alloc_expr(prop_link(link, acc, name.text), span_of(starts, name.span.hi))
                }
            } else if ip <= cp {
                ji = ji + 1
                let hi = if more_links(
                    jn,
                    ji,
                    jc,
                    jf,
                    jb,
                    jt,
                    jq,
                    names,
                    indexes,
                    calls,
                    forces,
                    blocks,
                    spellings,
                    chained,
                ) {
                    span_hi(b, indexes[ji - 1]) ?? ends
                } else {
                    ends
                }
                acc = b.store.alloc_expr(Expr.Index(acc, indexes[ji - 1]), span_of(starts, hi))
            } else {
                let upto = next_anchor(b, names, indexes, calls, jn, ji, jc + 1, ends)
                let args_here = args_between(b, cargs, cp, upto)
                jc = jc + 1
                let hi = if more_links(
                    jn,
                    ji,
                    jc,
                    jf,
                    jb,
                    jt,
                    jq,
                    names,
                    indexes,
                    calls,
                    forces,
                    blocks,
                    spellings,
                    chained,
                ) {
                    call_hi(b, calls[jc - 1], args_here)
                } else {
                    ends
                }
                acc = b.store.alloc_expr(Expr.CallValue(acc, args_here), span_of(starts, hi))
            }
        }
    }
    b.wrap_expr(acc)
}

/// `a?.m(args)` IS `match a { null -> null, v? -> v.m(args) }`: the
/// present arm calls the method on what the nullable carries, the
/// absent arm answers absence, and the match's own typing joins them.
fn chained_call(b: Builder, subject: ExprId, name: string, args: List<ExprId>) -> ExprId {
    let carried = b.store.alloc_expr(Expr.Ident(Scoped(chained_binder)), b.span)
    let call = b.store.alloc_expr(Expr.MethodCall(carried, Plain(name), args), b.span)
    let absent = b.store.alloc_expr(Expr.NullLit, b.span)
    b.store.alloc_expr(Expr.MatchOpt(subject, Scoped(chained_binder), call, absent), b.span)
}

/// The nearest UNCONSUMED anchor past the cursors — the window's
/// end for the link being folded.
fn next_anchor(
    b: Builder,
    names: List<Token>,
    indexes: List<ExprId>,
    calls: List<Token>,
    jn: int,
    ji: int,
    jc: int,
    ends: int,
) -> int {
    mut best = ends
    if jn < names.length && names[jn].span.lo < best { best = names[jn].span.lo }
    if ji < indexes.length {
        let lo: int? = span_lo(b, indexes[ji])
        if lo != null && lo! < best { best = lo! }
    }
    if jc < calls.length && calls[jc].span.lo < best { best = calls[jc].span.lo }
    best
}

/// The argument exprs written inside one link's window.
fn args_between(b: Builder, margs: List<ExprId>, after: int, before: int) -> List<ExprId> {
    mut out: List<ExprId> = []
    for a in margs {
        let lo: int? = span_lo(b, a)
        if lo != null && between(lo!, after, before) { out.push(a) }
    }
    out
}

fn span_lo(b: Builder, e: ExprId) -> int? {
    let sp? = b.store.expr_span(e) else { return null }
    sp.lo
}

fn span_hi(b: Builder, e: ExprId) -> int? {
    let sp? = b.store.expr_span(e) else { return null }
    sp.hi
}

/// A call's own end. Its closing delimiter is a literal, never
/// captured — the last argument's true end is the tightest bound on
/// hand, and an empty argument list falls back to the anchor token
/// (the name, or the bare-call's open paren), narrower than the
/// truth rather than reaching past it into whatever follows.
fn call_hi(b: Builder, anchor: Token, args: List<ExprId>) -> int {
    let last? = args.last() else { return anchor.span.hi }
    span_hi(b, last) ?? anchor.span.hi
}

/// Whether any family still has an unconsumed link past these
/// cursors — the fold's own while-condition, asked again after a
/// step. The LAST link in a chain has no later construct to guess an
/// end from being short of: `ends`, the whole match's real close, is
/// exactly right there, and only an interior link needs the
/// narrower, closing-delimiter-blind estimate.
fn more_links(
    jn: int,
    ji: int,
    jc: int,
    jf: int,
    jb: int,
    jt: int,
    jq: int,
    names: List<Token>,
    indexes: List<ExprId>,
    calls: List<Token>,
    forces: List<Token>,
    blocks: List<ExprId>,
    spellings: List<TypeRef>,
    chained: List<TypeRef>,
) -> bool {
    jn < names.length ||
        ji < indexes.length ||
        jc < calls.length ||
        jf < forces.length ||
        jb < blocks.length ||
        jt < spellings.length ||
        jq < chained.length
}

/// The node a link token names — the chain when absence rides it.
fn prop_link(link: string, subject: ExprId, name: string) -> Expr {
    if link == "?." { return Expr.Chain(subject, Plain(name)) }
    Expr.Prop(subject, Plain(name))
}

/// The operator a source token names — derived from core's roster,
/// so the symbol projection stays the single source.
fn binop_of(text: string) -> BinOp? {
    all_binops.find(op_symbol(it) == text)
}

/// `{ ( mut? x, … -> )? statements }` — a lambda whose body is a
/// block: the written seats, or the pronoun's one seat when no seat
/// is written and the body reads `it`, or none.
fn build_trailing(b: Builder) -> Result<LangNode, string> {
    let consts = b.tokens(0)?
    let muts = b.tokens(1)?
    let ps = b.tokens(2)?
    let body = b.block_of(b.stmts(3)?)
    let from: int = b.span?.lo ?? 0
    let unwritten: List<TypeRef?> = [null for p in ps]
    let seats = if ps.is_empty() && b.store.pronoun_rides(body) { [pronoun_param] } else { marked_seats(b.store, ps, unwritten, muts, consts, from) }
    b.make_expr(Expr.Lambda(seats, body))
}

/// The one catch builder — the six surfaces are alternatives of ONE
/// optional group, so `disjunction` parses once and the form is read
/// off which captures arrived: braced enum arms (cv/cb/ca), braced
/// union arms (tb/tn/ta), one selective enum arm (sv/sb/sa), one
/// union arm (ub/un/ua), a catch-all bind (eb/ea), or a value (rv).
/// No captures at all means no `catch` was written. A union arm's
/// `name: Type` reverses the enum arm's `.Variant(name)` — the bind
/// sits where the dot's variant would, the type where its payload
/// bind would — so both spellings hand `Expr.Catch` the same one
/// shape: a `Plain` naming what to match, a `Scoped` naming the bind.
fn build_catch(b: Builder) -> Result<LangNode, string> {
    let l = b.expr(0)?
    let rv = b.exprs(10)?
    if !rv.is_empty() { return b.make_expr(Expr.Catch(l, [Plain("")], [Scoped("")], [rv[0]])) }
    let eb = b.tokens(8)?
    if !eb.is_empty() {
        let ea = b.expr(9)?
        return b.make_expr(Expr.Catch(l, [Plain("")], [Scoped(eb[0].text)], [ea]))
    }
    let ub = b.tokens(14)?
    if !ub.is_empty() {
        let ua = b.expr(16)?
        let un = b.tokens(15)?
        return b.make_expr(Expr.Catch(l, [Plain(un[0].text)], [Scoped(ub[0].text)], [ua]))
    }
    let sv = b.tokens(5)?
    if !sv.is_empty() {
        let sa = b.expr(7)?
        let sb = b.tokens(6)?
        let bound: Token? = sb.first()
        return b.make_expr(Expr.Catch(l, [Plain(sv[0].text)], [Scoped(bound?.text ?? "")], [sa]))
    }
    let tb = b.tokens(11)?
    if !tb.is_empty() {
        let tn = b.tokens(12)?
        let ta = b.exprs(13)?
        if tb.length != tn.length || tb.length != ta.length { return .Err(zip_defect) }
        return b
            .make_expr(Expr.Catch(l, [Plain(n.text) for n in tn], [Scoped(n.text) for n in tb], ta))
    }
    let cv = b.tokens(2)?
    if cv.is_empty() {
        // the keyword is the witness: `catch { }` wrote a recovery
        // with nothing in it; NO keyword means no catch at all.
        let ck = b.tokens(1)?
        if ck.is_empty() { return b.wrap_expr(l) }
        return .Err("a `catch` needs at least one arm")
    }
    let ca = b.exprs(4)?
    let ends: int? = b.span_end()
    if cv.length != ca.length { return .Err(zip_defect) }
    if ends == null { return .Err("defect: a catch without a span — the arena and the grammar disagree") }
    b
        .make_expr(
            Expr
                .Catch(
                    l,
                    [Plain(v.text) for v in cv],
                    [Scoped(t) for t in aligned_binds(cv, b.tokens(3)?, ends!)],
                    ca,
                ),
        )
}
