//! Parse-time lowering: captures -> expression nodes.
use core.{Expr, ExprId, BinOp, want, op_symbol, all_binops}
use features.{LangNode, Builder, token_at, zip_defect}
use grammar.{Token}

fn build_int_lit(b: Builder) -> Result<LangNode, string> {
    let t = b.token(0)?
    b.make_expr(Expr.IntLit(t.int_value()))
}

fn build_ident(b: Builder) -> Result<LangNode, string> {
    let t = b.token(0)?
    b.make_expr(Expr.Ident(t.text))
}

/// `l (op r)*` folds left: each pair wraps the accumulator, so
/// `1 + 2 - x` is `(1 + 2) - x`.
fn build_fold_binary(b: Builder) -> Result<LangNode, string> {
    mut acc = b.expr(0)?
    let ops = b.tokens(1)?
    let rights = b.exprs(2)?
    for (i, t) in ops.enumerate() {
        let op = want(binop_of(t.text), "a binary operator")?
        acc = b.store.alloc_expr(Expr.Binary(op, acc, rights[i]), b.cover(acc, rights[i]))
    }
    b.wrap_expr(acc)
}

/// `l (op r)?` — at most one comparison, never a chain.
fn build_fold_cmp(b: Builder) -> Result<LangNode, string> {
    let l = b.expr(0)?
    let op_tok: Token? = token_at(b.args, 1)
    if op_tok == null { return b.wrap_expr(l) }
    let r = b.expr(2)?
    let op = want(binop_of(op_tok!.text), "a comparison operator")?
    b.make_expr(Expr.Binary(op, l, r))
}

fn build_not(b: Builder) -> Result<LangNode, string> {
    let v = b.expr(0)?
    b.make_expr(Expr.Not(v))
}

/// `v (with { f: e, ... })?` — the absent tail is v itself. The
/// ladder owns the PARSE; the node's meaning lives with structs.
fn build_fold_with(b: Builder) -> Result<LangNode, string> {
    let subject = b.expr(0)?
    let wn = b.tokens(1)?
    if wn.is_empty() { return b.wrap_expr(subject) }
    let wv = b.exprs(2)?
    if wn.length != wv.length { return Result.Err(zip_defect()) }
    let names = [k.text for k in wn]
    b.make_expr(Expr.With(subject, names, wv))
}

/// `v ( ! )*` folds left: `x!!` insists twice, which the TYPE then
/// refuses — the second `!` has nothing left to unwrap. The LADDER
/// owns this parse; the node's meaning lives in `nullable`.
fn build_fold_force(b: Builder) -> Result<LangNode, string> {
    mut acc = b.expr(0)?
    for _ in b.tokens(1)? {
        acc = b.store.alloc_expr(Expr.Force(acc), b.span)
    }
    b.wrap_expr(acc)
}

/// `l ( ?? r )*` folds left: `a ?? b ?? c` is `(a ?? b) ?? c`. The
/// LADDER owns this parse; the node's meaning lives in `nullable`.
fn build_fold_coalesce(b: Builder) -> Result<LangNode, string> {
    mut acc = b.expr(0)?
    let rights = b.exprs(1)?
    for r in rights {
        acc = b.store.alloc_expr(Expr.Coalesce(acc, r), b.cover(acc, r))
    }
    b.wrap_expr(acc)
}

/// `v ( [i] )*` folds left: `m[i][j]` is `(m[i])[j]`.
fn build_fold_index(b: Builder) -> Result<LangNode, string> {
    mut acc = b.expr(0)?
    let indices = b.exprs(1)?
    for i in indices {
        acc = b.store.alloc_expr(Expr.Index(acc, i), b.cover(acc, i))
    }
    b.wrap_expr(acc)
}

/// `v ( .name | ?.name )*` folds left — the parse takes ANY name
/// (typing refuses the unknown ones), and each LINK chooses its
/// node: `.` reads, `?.` chains through absence. The ladder owns
/// the parse; `Chain`'s meaning lives in `nullable`.
fn build_fold_props(b: Builder) -> Result<LangNode, string> {
    mut acc = b.expr(0)?
    let links = b.tokens(1)?
    let names = b.tokens(2)?
    if links.length != names.length { return Result.Err(zip_defect()) }
    for (i, t) in names.enumerate() {
        acc = b.store.alloc_expr(prop_link(links[i].text, acc, t.text), b.span)
    }
    b.wrap_expr(acc)
}

/// The node a link token names — the chain when absence rides it.
fn prop_link(link: string, subject: ExprId, name: string) -> Expr {
    if link == "?." { return Expr.Chain(subject, name) }
    Expr.Prop(subject, name)
}

/// The operator a source token names — derived from core's roster,
/// so the symbol projection stays the single source.
fn binop_of(text: string) -> BinOp? {
    all_binops().find(op_symbol(it) == text)
}
