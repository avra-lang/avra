//! Parse-time lowering: captures -> expression nodes.
use core.{Expr, BinOp, want, op_symbol, all_binops}
use features.{LangNode, Builder, token_at}
use grammar.{Token}

fn build_int_lit(b: Builder) -> Result<LangNode, string> {
    let t = b.token(0)?
    b.make_expr(Expr.IntLit(t.int_value()))
}

fn build_ident(b: Builder) -> Result<LangNode, string> {
    let t = b.token(0)?
    b.make_expr(Expr.Ident(t.text))
}

/// `l (op r)*` folds left: each pair wraps the accumulator, so
/// `1 + 2 - x` is `(1 + 2) - x`.
fn build_fold_binary(b: Builder) -> Result<LangNode, string> {
    mut acc = b.expr(0)?
    let ops = b.tokens(1)?
    let rights = b.exprs(2)?
    for (i, t) in ops.enumerate() {
        let op = want(binop_of(t.text), "a binary operator")?
        acc = b.store.alloc_expr(Expr.Binary(op, acc, rights[i]), b.cover(acc, rights[i]))
    }
    b.wrap_expr(acc)
}

/// `l (op r)?` — at most one comparison, never a chain.
fn build_fold_cmp(b: Builder) -> Result<LangNode, string> {
    let l = b.expr(0)?
    let op_tok: Token? = token_at(b.args, 1)
    if op_tok == null { return b.wrap_expr(l) }
    let r = b.expr(2)?
    let op = want(binop_of(op_tok!.text), "a comparison operator")?
    b.make_expr(Expr.Binary(op, l, r))
}

fn build_not(b: Builder) -> Result<LangNode, string> {
    let v = b.expr(0)?
    b.make_expr(Expr.Not(v))
}

/// The operator a source token names — derived from core's roster,
/// so the symbol projection stays the single source.
fn binop_of(text: string) -> BinOp? {
    all_binops().find(op_symbol(it) == text)
}
