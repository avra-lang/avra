//! Parse-time lowering: captures -> expression nodes.
use core.{void_ref, Expr, binop_of, Pat, want, pronoun_param, Plain, Scoped, some_list}
use features.{LangNode, Builder, expr_id_at, params_at}

fn build_int_lit(b: Builder) -> Result<LangNode, string> {
    let t = b.token(0)?
    // A FRACTION is a different literal wearing the same token: the
    // scanner joined the point, so the value is bits and not digits.
    if t.is_fraction() { return b.make_expr(Expr.FloatLit(t.float_bits())) }
    // the lexer already refused a literal no `int` holds, so absence
    // here is a defect, not a program's mistake
    b.make_expr(Expr.IntLit(t.int_value() ?? 0))
}
/// THE BITWISE BAND'S ONE LAW, and the reason it is one tier rather
/// than five: A RUN THAT MIXES TWO DIFFERENT BITWISE OPERATORS IS
/// REFUSED. `a | b & c` has two readings a reader must know a table to
/// choose between, and a generated one is as likely to mean either —
/// so it names both and asks for parentheses instead of picking. Only
/// the run is visible there, which is exactly the right reach: `a << 1
/// + 2` is a DIFFERENT level (the additive arrives already built) and
/// reads as C reads it, because C is arbitrary there rather than wrong.
/// What C gets wrong is `a & b == c`, and the band's PLACE in the table
/// — tighter than comparison — fixes that without any law at all.
///
/// A run's agreement: its first operator and the one just taken. The
/// climb reads only a refusal, so agreement answers a placeholder.
fn build_unmixed_bitwise(b: Builder) -> Result<LangNode, string> {
    let first = (b.token(0)?).text
    let second = (b.token(1)?).text
    if first != second { return .Err(mixed_bitwise(first, second)) }
    b.make_type(void_ref)
}

/// The words that law refuses in — one place, so the two operators
/// it names are always the two the reader wrote.
fn mixed_bitwise(first: string, second: string) -> string {
    "`${first}` and `${second}` in one expression have no agreed order — write parentheses to say which binds first"
}

/// A bare name binds — except `rest`, the spec's deliberate
/// remainder, and `null`, a LITERAL never a binder: read as
/// `Pat.Bind` it earns the keyword refusal beside whatever else the
/// arm earns, one mistake wearing two voices.
fn build_bind_pat(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    if n.text == "rest" { return b.make_pat(Pat.Rest) }
    if n.text == "null" { return b.make_pat(Pat.Lit(b.store.alloc_expr(Expr.NullLit, b.span))) }
    b.make_pat(Pat.Bind(Scoped(n.text)))
}

/// `-v` is `0 - v`: the parse desugars, so no pass learns a node.
/// A LITERAL FOLDS INSTEAD — `-1` and `-1.5` ARE literals, so a const
/// takes them and every reader that asks the value protocol gets
/// one. Only the literal: `-A` needs a general folder, which is a
/// core event because consts cannot match another feature's node.
fn build_neg(b: Builder) -> Result<LangNode, string> {
    let v = b.expr(0)?
    let held: int? = b.store.expr(v).int_of()
    if held != null { return b.make_expr(Expr.IntLit(0 - held!)) }
    let bits: int? = b.store.expr(v).bits_of()
    if bits != null { return b.make_expr(Expr.FloatLit(bits! ^ (1 << 63))) }
    let zero = b.store.alloc_expr(Expr.IntLit(0), b.span)
    let minus = want(binop_of("-"), "the minus operator")?
    b.make_expr(Expr.Binary(minus, zero, v))
}

/// `subject.name(args)` — a method call; an argument the pronoun rides
/// becomes a one-seat lambda (`xs.map(it * 2)`).
fn build_method_link(b: Builder) -> Result<LangNode, string> {
    let args = [b.store.pronouned(a) for a in b.exprs(2)?]
    b.make_expr(Expr.MethodCall(b.expr(0)?, Plain((b.token(1)?).text), args))
}

/// `subject { … }` and `subject { … } else { … }` — the call so far
/// takes the blocks as its last arguments. Only a call takes one, and
/// never after a type literal or another block.
fn build_trailed_link(b: Builder) -> Result<LangNode, string> {
    let subject = b.expr(0)?
    if b.store.spells_a_type(subject) { return .Err(block_after_literal()) }
    if b.store.ends_in_block(subject) { return .Err(second_block()) }
    b.wrap_expr(b.trailed(subject, [b.expr(1)?].concat(some_list(expr_id_at(b.args, 2))))?)
}

/// `{ ( mut? x, … -> )? statements }` — a lambda whose body is a
/// block: the written seats, or the pronoun's one seat when no seat
/// is written and the body reads `it`, or none.
fn build_trailing(b: Builder) -> Result<LangNode, string> {
    let written = params_at(b.args, 0)
    let body = b.block_of(b.stmts(1)?)
    let seats = if written.is_empty() && b.store.pronoun_rides(body) { [pronoun_param] } else { written }
    b.make_expr(Expr.Lambda(seats, body))
}

// ── voices ──

fn block_after_literal() -> string {
    "a trailing block follows a type literal — a literal is no call, and a block belongs to one"
}

fn second_block() -> string {
    "a second trailing block follows the first — `else { … }` fills the next fn seat, and a block statement starts on its own line"
}

