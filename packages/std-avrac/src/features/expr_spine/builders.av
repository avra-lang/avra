//! Parse-time lowering: captures -> expression nodes.
use core.{
    void_ref,
    Expr,
    ExprId,
    binop_of,
    Pat,
    PatId,
    want,
    TypeRef,
    pronoun_param,
    Plain,
    Scoped,
    some_list,
    spread_entry,
}
use features.{LangNode, Builder, expr_id_at, zip_defect, aligned_binds, chained_binder, params_at}
use grammar.{Token}

fn build_int_lit(b: Builder) -> Result<LangNode, string> {
    let t = b.token(0)?
    // A FRACTION is a different literal wearing the same token: the
    // scanner joined the point, so the value is bits and not digits.
    if t.is_fraction() { return b.make_expr(Expr.FloatLit(t.float_bits())) }
    // the lexer already refused a literal no `int` holds, so absence
    // here is a defect, not a program's mistake
    b.make_expr(Expr.IntLit(t.int_value() ?? 0))
}
/// THE BITWISE BAND'S ONE LAW, and the reason it is one tier rather
/// than five: A RUN THAT MIXES TWO DIFFERENT BITWISE OPERATORS IS
/// REFUSED. `a | b & c` has two readings a reader must know a table to
/// choose between, and a generated one is as likely to mean either —
/// so it names both and asks for parentheses instead of picking. Only
/// the run is visible there, which is exactly the right reach: `a << 1
/// + 2` is a DIFFERENT level (the additive arrives already built) and
/// reads as C reads it, because C is arbitrary there rather than wrong.
/// What C gets wrong is `a & b == c`, and the band's PLACE in the table
/// — tighter than comparison — fixes that without any law at all.
///
/// A run's agreement: its first operator and the one just taken. The
/// climb reads only a refusal, so agreement answers a placeholder.
fn build_unmixed_bitwise(b: Builder) -> Result<LangNode, string> {
    let first = (b.token(0)?).text
    let second = (b.token(1)?).text
    if first != second { return .Err(mixed_bitwise(first, second)) }
    b.make_type(void_ref)
}

/// `left op right` for the operator whose source symbol is `symbol`.
fn binary_of(b: Builder, symbol: string, what: string) -> Result<LangNode, string> {
    let op = want(binop_of(symbol), what)?
    let l = b.expr(0)?
    let r = b.expr(2)?
    b.wrap_expr(b.store.alloc_expr(Expr.Binary(op, l, r), b.cover(l, r)))
}

/// The words that law refuses in — one place, so the two operators
/// it names are always the two the reader wrote.
fn mixed_bitwise(first: string, second: string) -> string {
    "`${first}` and `${second}` in one expression have no agreed order — write parentheses to say which binds first"
}

/// `~v` keeps its own node; what it MEANS is `v ^ -1`, minted with it
/// and walked in its place, so no pass learns a rule for `~`.
fn build_bitnot(b: Builder) -> Result<LangNode, string> {
    let v = b.expr(0)?
    let sugar = b.expr_node(Expr.Bitnot(v))
    let _ = b.store.mean(sugar, bitnot_means(b.source_of(sugar), b.source_of(v)), b.words.door)
    b.wrap_expr(sugar)
}

fn bitnot_means(written: string, operand: string) -> string {
    "`${written}` means `${operand} ^ -1`"
}

/// `l op r` or `l is …` — at most one, never a chain. The right side
/// says which: a value is a comparison's, and the PATTERN the `is`
/// rule built is a tag test (`.V`, `.V(x)`) or a type test (`c: T`).
fn build_compare(b: Builder) -> Result<LangNode, string> {
    match b.args[2] {
        .Node(.NExpr(_)) -> binary_of(b, (b.token(1)?).text, "a comparison operator"),
        .Node(.NPat(p)) -> asked_expr(b, b.expr(0)?, p),
        rest -> .Err(compare_without_right_side()),
    }
}

/// One seat of a payload `is` — a bare name or `_`, spelled here so a
/// partial assembly of the spine parses the form without enums. The
/// spellings a match's payload gives special meaning keep it here too,
/// so `is .V(rest)` and `match .V(rest)` mean one thing.
fn build_asked_bind(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    if n.text == "rest" { return b.make_pat(Pat.Rest) }
    if n.text == "null" { return b.make_pat(Pat.Lit(b.store.alloc_expr(Expr.NullLit, b.span))) }
    b.make_pat(Pat.Bind(Scoped(n.text)))
}
/// `l is …`, the tag or type test the pattern names. The node keeps
/// the pattern: the `if` that means to bind desugars it to a match,
/// and a payload `is` anywhere else has enums name it and refuse.
fn asked_expr(b: Builder, l: ExprId, asked: PatId) -> Result<LangNode, string> {
    match b.store.pat(asked) {
        .Variant(_, _) or .Typed(_, _) or .Seq(_, _, _) or .Fields(_, _, _, _) -> b.wrap_expr(b.expr_node(Expr.Is(l, asked))),
        rest -> .Err(compare_without_right_side()),
    }
}

/// `-v` is `0 - v`: the parse desugars, so no pass learns a node.
/// A LITERAL FOLDS INSTEAD — `-1` and `-1.5` ARE literals, so a const
/// takes them and every reader that asks the value protocol gets
/// one. Only the literal: `-A` needs a general folder, which is a
/// core event because consts cannot match another feature's node.
fn build_neg(b: Builder) -> Result<LangNode, string> {
    let v = b.expr(0)?
    let held: int? = b.store.expr(v).int_of()
    if held != null { return b.make_expr(Expr.IntLit(0 - held!)) }
    let bits: int? = b.store.expr(v).bits_of()
    if bits != null { return b.make_expr(Expr.FloatLit(bits! ^ (1 << 63))) }
    let zero = b.store.alloc_expr(Expr.IntLit(0), b.span)
    let minus = want(binop_of("-"), "the minus operator")?
    b.make_expr(Expr.Binary(minus, zero, v))
}

/// `subject.name(args)` — a method call; an argument the pronoun rides
/// becomes a one-seat lambda (`xs.map(it * 2)`).
fn build_method_link(b: Builder) -> Result<LangNode, string> {
    let args = [b.store.pronouned(a) for a in b.exprs(2)?]
    b.make_expr(Expr.MethodCall(b.expr(0)?, Plain((b.token(1)?).text), args))
}

fn build_chained_call_link(b: Builder) -> Result<LangNode, string> {
    let args = [b.store.pronouned(a) for a in b.exprs(2)?]
    b.wrap_expr(chained_call(b, b.expr(0)?, (b.token(1)?).text, args))
}

fn build_chained_apply_link(b: Builder) -> Result<LangNode, string> {
    b.wrap_expr(chained_apply(b, b.expr(0)?, b.exprs(1)?))
}

/// `subject { … }` and `subject { … } else { … }` — the call so far
/// takes the blocks as its last arguments. Only a call takes one, and
/// never after a type literal or another block.
fn build_trailed_link(b: Builder) -> Result<LangNode, string> {
    let subject = b.expr(0)?
    if b.store.spells_a_type(subject) { return .Err(block_after_literal()) }
    if b.store.ends_in_block(subject) { return .Err(second_block()) }
    b.wrap_expr(b.trailed(subject, [b.expr(1)?].concat(some_list(expr_id_at(b.args, 2))))?)
}

/// `a?.m(args)` IS `match a { null -> null, v? -> v.m(args) }`: the
/// present arm calls the method on what the nullable carries, the
/// absent arm answers absence, and the match's own typing joins them.
fn chained_call(b: Builder, subject: ExprId, name: string, args: List<ExprId>) -> ExprId {
    let carried = b.store.alloc_expr(Expr.Ident(Scoped(chained_binder)), b.span)
    let call = b.store.alloc_expr(Expr.MethodCall(carried, Plain(name), args), b.span)
    let absent = b.store.alloc_expr(Expr.NullLit, b.span)
    b.store.alloc_expr(Expr.MatchOpt(subject, Scoped(chained_binder), call, absent), b.span)
}

/// `f?.(args)` IS `match f { null -> null, v? -> v(args) }`: the fn
/// that may be absent is called when it is held, and absence answers
/// absence — the chain's law, over an application.
fn chained_apply(b: Builder, subject: ExprId, args: List<ExprId>) -> ExprId {
    let carried = b.store.alloc_expr(Expr.Ident(Scoped(chained_binder)), b.span)
    let call = b.store.alloc_expr(Expr.CallValue(carried, args), b.span)
    let absent = b.store.alloc_expr(Expr.NullLit, b.span)
    b.store.alloc_expr(Expr.MatchOpt(subject, Scoped(chained_binder), call, absent), b.span)
}

fn compare_without_right_side() -> string {
    "a comparison's right side is a value, or the pattern an `is` names"
}

/// `{ ( mut? x, … -> )? statements }` — a lambda whose body is a
/// block: the written seats, or the pronoun's one seat when no seat
/// is written and the body reads `it`, or none.
fn build_trailing(b: Builder) -> Result<LangNode, string> {
    let written = params_at(b.args, 0)
    let body = b.block_of(b.stmts(1)?)
    let seats = if written.is_empty() && b.store.pronoun_rides(body) { [pronoun_param] } else { written }
    b.make_expr(Expr.Lambda(seats, body))
}

/// The one catch builder — the six surfaces are alternatives of ONE
/// optional group, so `disjunction` parses once and the form is read
/// off which captures arrived: braced enum arms (cv/cb/ca), braced
/// union arms (tb/tn/ta), one selective enum arm (sv/sb/sa), one
/// union arm (ub/un/ua), a catch-all bind (eb/ea), or a value (rv).
/// No captures at all means no `catch` was written. A union arm's
/// `name: Type` reverses the enum arm's `.Variant(name)` — the bind
/// sits where the dot's variant would, the type where its payload
/// bind would — so both spellings hand `Expr.Catch` the same one
/// shape: a `Plain` naming what to match, a `Scoped` naming the bind.
fn build_catch(b: Builder) -> Result<LangNode, string> {
    let l = b.expr(0)?
    let rv = b.exprs(10)?
    if !rv.is_empty() { return b.make_expr(Expr.Catch(l, [Plain("")], [Scoped("")], [rv[0]])) }
    let eb = b.tokens(8)?
    if !eb.is_empty() {
        let ea = b.expr(9)?
        return b.make_expr(Expr.Catch(l, [Plain("")], [Scoped(eb[0].text)], [ea]))
    }
    let ub = b.tokens(14)?
    if !ub.is_empty() {
        let ua = b.expr(16)?
        let un = b.tokens(15)?
        return b.make_expr(Expr.Catch(l, [Plain(un[0].text)], [Scoped(ub[0].text)], [ua]))
    }
    let sv = b.tokens(5)?
    if !sv.is_empty() {
        let sa = b.expr(7)?
        let sb = b.tokens(6)?
        let bound: Token? = sb.first()
        return b.make_expr(Expr.Catch(l, [Plain(sv[0].text)], [Scoped(bound?.text ?? "")], [sa]))
    }
    let tb = b.tokens(11)?
    if !tb.is_empty() {
        let tn = b.tokens(12)?
        let ta = b.exprs(13)?
        if tb.length != tn.length || tb.length != ta.length { return .Err(zip_defect) }
        return b
            .make_expr(Expr.Catch(l, [Plain(n.text) for n in tn], [Scoped(n.text) for n in tb], ta))
    }
    let cv = b.tokens(2)?
    if cv.is_empty() {
        // the keyword is the witness: `catch { }` wrote a recovery
        // with nothing in it; NO keyword means no catch at all.
        let ck = b.tokens(1)?
        if ck.is_empty() { return b.wrap_expr(l) }
        return .Err("a `catch` needs at least one arm")
    }
    let ca = b.exprs(4)?
    let ends: int? = b.span_end()
    if cv.length != ca.length { return .Err(zip_defect) }
    if ends == null { return .Err("defect: a catch without a span — the arena and the grammar disagree") }
    b
        .make_expr(
            Expr
                .Catch(
                    l,
                    [Plain(v.text) for v in cv],
                    [Scoped(t) for t in aligned_binds(cv, b.tokens(3)?, ends!)],
                    ca,
                ),
        )
}

// ── voices ──

fn block_after_literal() -> string {
    "a trailing block follows a type literal — a literal is no call, and a block belongs to one"
}

fn second_block() -> string {
    "a second trailing block follows the first — `else { … }` fills the next fn seat, and a block statement starts on its own line"
}

/// `f(..xs)` — an argument that spreads: the `Named` node `..` wearing its
/// operand, which the callee's variadic seat takes whole.
fn build_spread_arg(b: Builder) -> Result<LangNode, string> {
    b.make_expr(Expr.Named(Plain(spread_entry), b.expr(0)?))
}
