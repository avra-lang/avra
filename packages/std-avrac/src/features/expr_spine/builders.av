//! Parse-time lowering: captures -> expression nodes.
use core.{Expr, Slots, Built, pronoun_param, computed, some_list}

/// `subject { … }` and `subject { … } else { … }` — the call so far
/// takes the blocks as its last arguments. Only a call takes one, and
/// never after a type literal or another block.
@computed
fn trailed_written(s: dyn Slots) -> Result<Built, string> {
    let store = s.arena()
    let subject = s.expr_of("subject")?
    if store.spells_a_type(subject) { return .Err(block_after_literal()) }
    if store.ends_in_block(subject) { return .Err(second_block()) }
    let blocks = (s.exprs_of("blocks")?).concat(some_list(s.expr_opt_of("else_block")?))
    .Ok(Built.Expr(store.trailed(subject, blocks, s.built_at())?))
}

/// `{ ( mut? x, … -> )? statements }` — a lambda whose body is a
/// block: the written seats, or the pronoun's one seat when no seat
/// is written and the body reads `it`, or none.
@computed
fn block_lambda_written(s: dyn Slots) -> Result<Built, string> {
    let store = s.arena()
    let written = s.params_of("seats")?
    let body = store.block_over(s.stmts_of("stmts")?, s.built_at())
    let seats = if written.is_empty() && store.pronoun_rides(body) { [pronoun_param] } else { written }
    .Ok(Built.Expr(s.made_expr(Expr.Lambda(seats, body))?))
}

// ── voices ──

fn block_after_literal() -> string {
    "a trailing block follows a type literal — a literal is no call, and a block belongs to one"
}

fn second_block() -> string {
    "a second trailing block follows the first — `else { … }` fills the next fn seat, and a block statement starts on its own line"
}

