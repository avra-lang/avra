//! Parse-time lowering: captures -> expression nodes.
use core.{Expr, ExprId, BinOp, want, op_symbol, all_binops, Span, Param}
use features.{LangNode, Builder, token_at, zip_defect, aligned_binds, within, chained_binder}
use grammar.{Token}

fn build_int_lit(mut b: Builder) -> Result<LangNode, string> {
    let t = b.token(0)?
    // the lexer already refused a literal no `int` holds, so absence
    // here is a defect, not a program's mistake
    b.make_expr(Expr.IntLit(t.int_value() ?? 0))
}

fn build_ident(mut b: Builder) -> Result<LangNode, string> {
    let t = b.token(0)?
    b.make_expr(Expr.Ident(t.text))
}

/// `l (op r)*` folds left: each pair wraps the accumulator, so
/// `1 + 2 - x` is `(1 + 2) - x`.
fn build_fold_binary(mut b: Builder) -> Result<LangNode, string> {
    mut acc = b.expr(0)?
    let ops = b.tokens(1)?
    let rights = b.exprs(2)?
    for i, t in ops {
        let op = want(binop_of(t.text), "a binary operator")?
        acc = b.store.alloc_expr(Expr.Binary(op, acc, rights[i]), b.cover(acc, rights[i]))
    }
    b.wrap_expr(acc)
}

/// `l (op r)?` — at most one comparison, never a chain; or `l is
/// .variant`, the tag test, which enums give meaning.
fn build_fold_cmp(mut b: Builder) -> Result<LangNode, string> {
    let l = b.expr(0)?
    let asked: Token? = token_at(b.args, 3)
    if asked != null { return b.make_expr(Expr.Is(l, asked!.text)) }
    let op_tok: Token? = token_at(b.args, 1)
    if op_tok == null { return b.wrap_expr(l) }
    let r = b.expr(2)?
    let op = want(binop_of(op_tok!.text), "a comparison operator")?
    b.make_expr(Expr.Binary(op, l, r))
}

fn build_not(mut b: Builder) -> Result<LangNode, string> {
    let v = b.expr(0)?
    b.make_expr(Expr.Not(v))
}

/// `-v` is `0 - v`: the parse desugars, so no pass learns a node.
fn build_neg(mut b: Builder) -> Result<LangNode, string> {
    let v = b.expr(0)?
    let zero = b.store.alloc_expr(Expr.IntLit(0), b.span)
    let minus = want(binop_of("-"), "the minus operator")?
    b.make_expr(Expr.Binary(minus, zero, v))
}

/// `v (with { f: e, ... })?` — the absent tail is v itself. The
/// ladder owns the PARSE; the node's meaning lives with structs.
fn build_fold_with(mut b: Builder) -> Result<LangNode, string> {
    let subject = b.expr(0)?
    let wn = b.tokens(1)?
    if wn.is_empty() { return b.wrap_expr(subject) }
    let wv = b.exprs(2)?
    if wn.length != wv.length { return .Err(zip_defect()) }
    let names = [k.text for k in wn]
    b.make_expr(Expr.With(subject, names, wv))
}

/// `v ( ! | ? )*` folds left, each link choosing its node: `!`
/// insists, `?` propagates. `x!!` insists twice, which the TYPE
/// then refuses — the second `!` has nothing left to unwrap. The
/// LADDER owns this parse; both nodes' meaning lives in `nullable`.
/// The node a force-position token names — propagation when `?`.
fn force_link(link: string, value: ExprId) -> Expr {
    if link == "?" { return Expr.Propagate(value) }
    Expr.Force(value)
}

/// `l ( ?? r )*` folds left: `a ?? b ?? c` is `(a ?? b) ?? c`. The
/// LADDER owns this parse; the node's meaning lives in `nullable`.
fn build_fold_coalesce(mut b: Builder) -> Result<LangNode, string> {
    mut acc = b.expr(0)?
    let rights = b.exprs(1)?
    for r in rights {
        acc = b.store.alloc_expr(Expr.Coalesce(acc, r), b.cover(acc, r))
    }
    b.wrap_expr(acc)
}

/// `v ( .name | .name(args) | ?.name | [i] | (args) )*` — ONE
/// postfix star: property links, method calls, chains, indexes,
/// and applications interleave freely, folded left in SOURCE
/// order (a three-way merge over the capture families' spans).
/// The paren WITNESS in a link's window makes a dot a METHOD call;
/// a bare paren group applies the value built so far. The ladder
/// owns the parse; each node's meaning lives with its feature.
fn build_fold_postfix(mut b: Builder) -> Result<LangNode, string> {
    mut acc = b.expr(0)?
    let links = b.tokens(1)?
    let names = b.tokens(2)?
    let opens = b.tokens(3)?
    let margs = b.exprs(4)?
    let indexes = b.exprs(5)?
    let calls = b.tokens(6)?
    let cargs = b.exprs(7)?
    let forces = b.tokens(8)?
    if links.length != names.length { return .Err(zip_defect()) }
    let held: int? = b.span_end()
    if held == null { return .Err("a postfix chain without a span") }
    let ends = held!
    // the four families' cursors — each turn folds the link whose
    // anchor comes first in the source
    mut jn = 0
    mut ji = 0
    mut jc = 0
    mut jf = 0
    while jn < names.length || ji < indexes.length || jc < calls.length || jf < forces.length {
        let np = if jn < names.length { names[jn].span.lo } else { ends }
        let ip = if ji < indexes.length { span_lo(b, indexes[ji]) ?? ends } else { ends }
        let cp = if jc < calls.length { calls[jc].span.lo } else { ends }
        let fp = if jf < forces.length { forces[jf].span.lo } else { ends }
        if fp < np && fp < ip && fp < cp {
            acc = b.store.alloc_expr(force_link(forces[jf].text, acc), b.span)
            jf = jf + 1
        } else if np <= ip && np <= cp {
            let upto = next_anchor(b, names, indexes, calls, jn + 1, ji, jc, ends)
            let called = opens.any(within(it.span.lo, np, upto))
            if called {
                let margs_here = [pronouned(b, a) for a in args_between(b, margs, np, upto)]
                acc = if links[jn].text == "?." { chained_call(b, acc, names[jn].text, margs_here) } else { b.store.alloc_expr(Expr.MethodCall(acc, names[jn].text, margs_here), b.span) }
            } else {
                acc = b.store.alloc_expr(prop_link(links[jn].text, acc, names[jn].text), b.span)
            }
            jn = jn + 1
        } else {
            if ip <= cp {
                acc = b.store.alloc_expr(Expr.Index(acc, indexes[ji]), b.span)
                ji = ji + 1
            } else {
                let upto = next_anchor(b, names, indexes, calls, jn, ji, jc + 1, ends)
                acc = b.store.alloc_expr(
                    Expr.CallValue(acc, args_between(b, cargs, cp, upto)), b.span)
                jc = jc + 1
            }
        }
    }
    b.wrap_expr(acc)
}

/// `a?.m(args)` IS `match a { null -> null, v? -> v.m(args) }`: the
/// present arm calls the method on what the nullable carries, the
/// absent arm answers absence, and the match's own typing joins them.
fn chained_call(mut b: Builder, subject: ExprId, name: string, args: List<ExprId>) -> ExprId {
    let carried = b.store.alloc_expr(Expr.Ident(chained_binder()), b.span)
    let call = b.store.alloc_expr(Expr.MethodCall(carried, name, args), b.span)
    let absent = b.store.alloc_expr(Expr.NullLit, b.span)
    b.store.alloc_expr(Expr.MatchOpt(subject, chained_binder(), call, absent), b.span)
}

/// The nearest UNCONSUMED anchor past the cursors — the window's
/// end for the link being folded.
fn next_anchor(b: Builder, names: List<Token>, indexes: List<ExprId>, calls: List<Token>,
               jn: int, ji: int, jc: int, ends: int) -> int {
    mut best = ends
    if jn < names.length && names[jn].span.lo < best { best = names[jn].span.lo }
    if ji < indexes.length {
        let lo: int? = span_lo(b, indexes[ji])
        if lo != null && lo! < best { best = lo! }
    }
    if jc < calls.length && calls[jc].span.lo < best { best = calls[jc].span.lo }
    best
}

/// The argument exprs written inside one link's window.
fn args_between(b: Builder, margs: List<ExprId>, after: int, before: int) -> List<ExprId> {
    mut out: List<ExprId> = []
    for a in margs {
        let lo: int? = span_lo(b, a)
        if lo != null && within(lo!, after, before) { out.push(a) }
    }
    out
}

fn span_lo(b: Builder, e: ExprId) -> int? {
    let sp: Span? = b.store.expr_span(e)
    if sp == null { return null }
    sp!.lo
}

/// An argument the PRONOUN rides becomes an implicit one-param
/// lambda — `xs.map(it * 2)` is `xs.map((it) -> it * 2)`, and the
/// expected-type channel seats it like any other. The wrap is the
/// pronoun's WHOLE mechanism: nothing downstream knows it exists.
fn pronouned(mut b: Builder, a: ExprId) -> ExprId {
    if !b.store.pronoun_rides(a) { return a }
    b.store.alloc_expr(
        Expr.Lambda([Param { name: "it", ty: null, default: null, mutable: false }], a), b.store.expr_span(a))
}

/// The node a link token names — the chain when absence rides it.
fn prop_link(link: string, subject: ExprId, name: string) -> Expr {
    if link == "?." { return Expr.Chain(subject, name) }
    Expr.Prop(subject, name)
}

/// The operator a source token names — derived from core's roster,
/// so the symbol projection stays the single source.
fn binop_of(text: string) -> BinOp? {
    all_binops().find(op_symbol(it) == text)
}

/// The one catch builder — the four surfaces are alternatives of
/// ONE optional group, so `disjunction` parses once and the form is
/// read off which captures arrived: braces arms (cv/cb/ca), one
/// selective arm (sv/sb/sa), a catch-all bind (eb/ea), or a value
/// (rv). No captures at all means no `catch` was written.
fn build_catch(mut b: Builder) -> Result<LangNode, string> {
    let l = b.expr(0)?
    let rv = b.exprs(10)?
    if !rv.is_empty() { return b.make_expr(Expr.Catch(l, [""], [""], [rv[0]])) }
    let eb = b.tokens(8)?
    if !eb.is_empty() {
        let ea = b.expr(9)?
        return b.make_expr(Expr.Catch(l, [""], [eb[0].text], [ea]))
    }
    let sv = b.tokens(5)?
    if !sv.is_empty() {
        let sa = b.expr(7)?
        let sb = b.tokens(6)?
        let bound: Token? = sb.first()
        return b.make_expr(Expr.Catch(l, [sv[0].text], [bound?.text ?? ""], [sa]))
    }
    let cv = b.tokens(2)?
    if cv.is_empty() {
        // the keyword is the witness: `catch { }` wrote a recovery
        // with nothing in it; NO keyword means no catch at all.
        let ck = b.tokens(1)?
        if ck.is_empty() { return b.wrap_expr(l) }
        return .Err("a `catch` needs at least one arm")
    }
    let ca = b.exprs(4)?
    let ends: int? = b.span_end()
    if cv.length != ca.length { return .Err(zip_defect()) }
    if ends == null { return .Err("a catch without a span") }
    b.make_expr(Expr.Catch(l, [v.text for v in cv], aligned_binds(cv, b.tokens(3)?, ends!), ca))
}
