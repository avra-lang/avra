//! Evaluation rules: literals stand, idents read their definition's
//! slot, arithmetic and comparison reduce over value nodes, and the
//! lazy ops short-circuit — the on-demand walk never touches a side
//! that cannot matter. Division by zero refuses the RUN (the one
//! dynamic refusal; natively it traps — the error spine owns the
//! policy later). Defects are impossible past the refusal gate and
//! recorded, never guessed.
use core.{Expr, ExprId, BinOp}
use features.{EvalCx, hole_defect}

fn spine_eval(cx: EvalCx, e: ExprId) -> ExprId {
    match cx.store.expr(e) {
        .IntLit(_) -> e,
        .Ident(_) -> ident_value(cx, e),
        .Binary(op, l, r) -> match op {
            .Add or .Sub or .Mul or .Div or .Mod or
            .Lt or .Le or .Gt or .Ge -> arith(cx, op, l, r),
            .Eq or .Ne -> equal_values(cx, op, l, r),
            .And or .Or -> lazy_truth(cx, op, l, r),
        },
        .Not(v) -> not_value(cx, v),
        .Index(s, i) -> index_value(cx, s, i),
        .Prop(s, name) -> prop_value(cx, s, name),
        _ -> failed(cx, e, hole_defect()),
    }
}

/// `subject[index]`: the element VALUE node; a bad index refuses
/// the run (natively the runtime traps — recorded divergence).
fn index_value(cx: EvalCx, s: ExprId, i: ExprId) -> ExprId {
    let elems: List<ExprId>? = cx.elems_at(s)
    if elems == null { return failed(cx, s, "defect: a non-list reached `[...]` in a clean program") }
    let iv: int? = cx.int_at(i)
    if iv == null { return failed(cx, i, "defect: a non-int index reached `[...]` in a clean program") }
    let es = elems!
    let at = iv!
    if at < 0 || at >= es.length {
        return failed(cx, i, "index ${at} is out of bounds (length ${es.length})")
    }
    es[at]
}

/// The one property: a list's or a string's length.
fn prop_value(cx: EvalCx, s: ExprId, name: string) -> ExprId {
    let elems: List<ExprId>? = cx.elems_at(s)
    if elems != null { return cx.alloc(Expr.IntLit(elems!.length)) }
    let tv: string? = cx.text_at(s)
    if tv != null { return cx.alloc(Expr.IntLit(tv!.length)) }
    failed(cx, s, "defect: an unmeasurable value reached `${name}` in a clean program")
}

/// Record the defect and stand on the node itself — the driver
/// refuses the whole run afterward.
fn failed(cx: EvalCx, e: ExprId, msg: string) -> ExprId {
    cx.fail(msg)
    e
}

fn ident_value(cx: EvalCx, e: ExprId) -> ExprId {
    let v: ExprId? = cx.def_value(e)
    v ?? failed(cx, e, "defect: an unresolved name survived a clean analysis")
}

fn arith(cx: EvalCx, op: BinOp, l: ExprId, r: ExprId) -> ExprId {
    let lv: int? = cx.int_at(l)
    let rv: int? = cx.int_at(r)
    if lv == null || rv == null {
        return failed(cx, l, "defect: a non-int value reached arithmetic in a clean program")
    }
    let a = lv!
    let b = rv!
    if (op == BinOp.Div || op == BinOp.Mod) && b == 0 {
        return failed(cx, r, "division by zero")
    }
    match op {
        .Add -> cx.alloc(Expr.IntLit(a + b)),
        .Sub -> cx.alloc(Expr.IntLit(a - b)),
        .Mul -> cx.alloc(Expr.IntLit(a * b)),
        .Div -> cx.alloc(Expr.IntLit(a / b)),
        .Mod -> cx.alloc(Expr.IntLit(a % b)),
        .Lt -> cx.alloc(Expr.BoolLit(a < b)),
        .Le -> cx.alloc(Expr.BoolLit(a <= b)),
        .Gt -> cx.alloc(Expr.BoolLit(a > b)),
        .Ge -> cx.alloc(Expr.BoolLit(a >= b)),
        .Eq -> cx.alloc(Expr.BoolLit(a == b)),
        .Ne -> cx.alloc(Expr.BoolLit(a != b)),
        .And or .Or -> failed(cx, l, "defect: a lazy op reached arithmetic"),
    }
}

/// `==`/`!=` over value NODES — core owns literal payload equality.
fn equal_values(cx: EvalCx, op: BinOp, l: ExprId, r: ExprId) -> ExprId {
    let eq: bool? = cx.store.literal_eq(cx.value_at(l), cx.value_at(r))
    if eq == null { return failed(cx, l, "defect: incomparable values reached `==` in a clean program") }
    cx.alloc(Expr.BoolLit(if op == BinOp.Ne { !eq! } else { eq! }))
}

/// `&&`/`||` decide on the LEFT alone when they can — the right side
/// is never evaluated unless it matters.
fn lazy_truth(cx: EvalCx, op: BinOp, l: ExprId, r: ExprId) -> ExprId {
    let lv: bool? = cx.truth_at(l)
    if lv == null { return failed(cx, l, "defect: a non-bool reached a lazy op in a clean program") }
    let decided = if op == BinOp.And { !lv! } else { lv! }
    if decided { return cx.alloc(Expr.BoolLit(lv!)) }
    let rv: bool? = cx.truth_at(r)
    if rv == null { return failed(cx, r, "defect: a non-bool reached a lazy op in a clean program") }
    cx.alloc(Expr.BoolLit(rv!))
}

fn not_value(cx: EvalCx, v: ExprId) -> ExprId {
    let bv: bool? = cx.truth_at(v)
    if bv == null { return failed(cx, v, "defect: a non-bool reached `!` in a clean program") }
    cx.alloc(Expr.BoolLit(!bv!))
}

