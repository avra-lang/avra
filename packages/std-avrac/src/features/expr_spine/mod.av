//! The expression spine: the precedence ladder every expression
//! feature hangs from. Left association comes from folding the
//! repeated tail, exactly as the grammar reads.
use features.{LanguageFeature, BuilderRow}
use grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use diagnostics.{DiagCode}

export fn expr_spine() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name          | build
        "int_lit"     | build_int_lit
        "ident"       | build_ident
        "fold_binary" | build_fold_binary
        "fold_bitwise" | build_fold_bitwise
        "bitnot_expr"  | build_bitnot
        "fold_cmp"    | build_fold_cmp
        "neg_expr"     | build_neg
        "not_expr"    | build_not
        "fold_postfix"      | build_fold_postfix
        "fold_with"   | build_fold_with
        "fold_coalesce" | build_fold_coalesce
        "catch_any"   | build_catch
        "trailing"    | build_trailing
        "named_arg"   | build_named_arg
    }
    let codes = table<DiagCode> {
        kind                | id      | summary
        "type.mismatch"     | "F2000" | "an operand has the wrong type"
        "type.unknown_prop" | "F2003" | "a property name nothing answers to"
        "type.shift_count"  | "F2057" | "a shift count is between 0 and 63"
    }
    component LanguageFeature spine {
        name = "expr_spine"
        docs = "Expressions: literals, identifiers, the operator ladder — `|| && == != < <= > >= + - * / % !` — postfix access (`xs[i]`, `xs.length`, `u?.age`, `v!`, `v?`), the loosest layer, `catch`, and the TRAILING BLOCK, a postfix like the rest: `f(a) { x -> body }` is `f(a, (x) -> body)`, `else { … }` after it fills the next fn seat, `{ … }` with no arrow takes no seat (or `it`, when the body reads it), and a name or a field read takes one as a call with no parentheses (`run { … }`, `db.tx { … }`). A HEAD — what `if`, `while`, `for`, `match` and `let … else` open their brace after — takes none: parenthesise the call there. And the TYPE LITERAL, a postfix too: `v.type(List<string?>)` is `v.interned(.List(.Opt(.Str)))` — the type in its own spelling, folded once by the receiver; a name that spells no shape is a hole, the id it names."
        gram = grammar {
            expression = l:disjunction ( ck:"catch" ( "{" BREAK ( "." cv:NAME ( "(" cb:NAME ")" )? "->" ca:expression BREAK )* "}" | "." sv:NAME ( "(" sb:NAME ")" )? "->" sa:expression | eb:NAME "->" ea:expression | rv:expression ) )? -> catch_any(l, ck, cv, cb, ca, sv, sb, sa, eb, ea, rv)
            argument = n:NAME ":" v:expression -> named_arg(n, v) | expression
            trailing = "{" ( ( tc:"const" )? ( tm:"mut" )? tp:NAME ( "," ( tc:"const" )? ( tm:"mut" )? tp:NAME )* ","? "->" )? ( ts:stmt | BREAK )* "}" @expect("}", "expected `}` to close the trailing block") -> trailing(tc, tm, tp, ts)
            disjunction = l:conjunction ( op:"||" r:conjunction )* -> fold_binary(l, op, r)
            conjunction = l:comparison ( op:"&&" r:comparison )* -> fold_binary(l, op, r)
            comparison = l:coalescing ( op:( "==" | "!=" | "<=" | ">=" | "<" | ">" ) r:coalescing | "is" "." iv:NAME )? -> fold_cmp(l, op, r, iv)
            coalescing = l:bitwise ( "??" r:bitwise )* -> fold_coalesce(l, r)
            bitwise = l:additive ( op:( "|" | "^" | "&" | "<<" ) r:additive | op:">" ">" r:additive )* -> fold_bitwise(l, op, r)
            additive = l:multiplicative ( op:( "+" | "-" ) r:multiplicative )* -> fold_binary(l, op, r)
            multiplicative = l:unary ( op:( "*" | "/" | "%" ) r:unary )* -> fold_binary(l, op, r)
            unary = "!" v:unary -> not_expr(v) | "-" v:unary -> neg_expr(v) | "~" v:unary -> bitnot_expr(v) | withed
            withed = v:postfix ( "with" "{" BREAK? wn:NAME ":" wv:expression ( "," BREAK? wn:NAME ":" wv:expression )* ","? BREAK? "}" )? -> fold_with(v, wn, wv)
            postfix = v:primary ( "." "type" "(" tt:type ")" @expect(")", "expected `)` to close the type literal") | "?." "type" "(" tq:type ")" @expect(")", "expected `)` to close the chained type literal") | q:( "?." | "." ) p:NAME ( mo:"(" ( ma:argument ( "," ma:argument )* ","? )? ")" )? | "[" i:expression "]" @expect("]", "expected `]` to close the index") | co:"(" ( ca:argument ( "," ca:argument )* ","? )? ")" | f:( "!" | "?" ) | tb:trailing ( "else" te:trailing )? @trailer(tb) )* -> fold_postfix(v, q, p, mo, ma, i, co, ca, f, tb, te, tt, tq)
            primary = v:NUMBER -> int_lit(v) | n:NAME -> ident(n) | "(" e:expression ")" @expect(")", "expected `)` to close the group") -> e
        }
        builders = rows
        diags = codes
    }
    spine
}
