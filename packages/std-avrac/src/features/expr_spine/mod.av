//! The expression spine: the operator table every expression
//! feature hangs from. One `@operators` block states the infix band
//! loosest first — the table IS the precedence — and the climb
//! groups each tier to the left. Literals,
//! identifiers, the operators — `|| && == != < <= > >= + -
//! * / % !` — and postfix access (`xs[i]`, `xs.length`,
//! `u?.age`, `v!`, `v?`) live here, at the loosest layer, with
//! `catch`. The TRAILING BLOCK is a postfix like the rest: `f(a) {
//! x -> body }` is `f(a, (x) -> body)`, `else { … }` after it
//! fills the next fn seat, `{ … }` with no arrow takes no seat (or
//! `it`, when the body reads it), and a name or a field read takes
//! one as a call with no parentheses (`run { … }`, `db.tx { … }`).
//! A HEAD — what `if`, `while`, `for`, `match` and `let … else`
//! open their brace after — takes none: parenthesise the call
//! there. THE PIPE is application: `x |> f(a)` IS `f(x, a)`, and
//! pipe.av states its whole law. The TYPE LITERAL is a postfix
//! too: `v.type(List<string?>)` is `v.interned(.List(.Opt(.Str)))`
//! — the type in its own spelling, folded once by the receiver; a
//! name that spells no shape is a hole, the id it names.
use features.{LanguageFeature, BuilderRow, RefusalRow}
// LICENSED modules.unused_import: `Operators`' tables and `Fixed` are named by GENERATED
// code, not by this file — the `grammar { }` expansion writes `Tier`,
// `Assoc`, `Suffix` and the `operators_of` call here for the table, and a
// `Fixed` literal for a stated payload
use @std.grammar.{
    Grammar,
    Rule,
    Alt,
    Seq,
    Item,
    Prim,
    Rep,
    Build,
    Fixed,
    Expect,
    Recover,
    Tier,
    Assoc,
    Suffix,
    operators_of,
}
use diagnostics.{DiagCode, Remedy}

export fn expr_spine() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name           | build
        "method_link"  | build_method_link
        "trailed_link" | build_trailed_link
        "trailing"     | build_trailing
    }
    let codes = table<DiagCode> {
        kind                 | summary                                            | remedy
        "type.mismatch"      | "an operand has the wrong type"                    | Remedy.Fix
        "type.unknown_prop"  | "a property name nothing answers to"               | Remedy.Fix
        "type.shift_count"   | "a shift count is between 0 and 63"                | Remedy.Help
        "type.mixed_bitwise" | "a run of bitwise operators uses one operator"     | Remedy.Help
        "parse.leading_pipe" | "a continuing operator ends the line it continues" | Remedy.Help
    }
    LanguageFeature expr_spine {
        gram: grammar {
            expression = subject:climbed ( "catch" ( "{" BREAK ( arms:catch_enum_arm BREAK )* "}" | "{" BREAK ( arms:catch_union_arm BREAK )+ "}" | arms:catch_enum_arm | arms:catch_union_arm | arms:catch_bind_arm | arms:catch_value ) -> Expr.Catch )? @fold(subject) -> subject
            catch_enum_arm = "." variant:NAME ( "(" bind:NAME ")" )? "->" value:expression -> Record.CatchArm
            catch_union_arm = bind:NAME ":" variant:NAME "->" value:expression -> Record.CatchArm
            catch_bind_arm = bind:NAME "->" value:expression -> Record.CatchArm
            catch_value = value:expression -> Record.CatchArm
            argument = name:NAME ":" value:expression -> Expr.Named | ".." value:postfix -> Expr.Named(name = "..", value = value) | expression
            element = ".." value:postfix -> Expr.Named(name = "..", value = value) | expression
            trailing = "{" ( ps:trailing_seat ( "," ps:trailing_seat )* ","? "->" )? ( ts:stmt | BREAK )* "}" @expect("}", "expected `}` to close the trailing block") -> trailing(ps, ts)
            trailing_seat = ( constant:"const" )? ( mutable:"mut" )? name:NAME -> Record.ParamSyntax
            stmt = "|>" expression END -> Refusal.leading_pipe
            asked = "." name:NAME ( "(" ( args:asked_payload ( "," args:asked_payload )* ","? )? ")" )? -> Pat.Variant | name:NAME ":" ty:type_atom -> Pat.Typed
            asked_payload = "_" -> Pat.Wild | "rest" -> Pat.Rest | "null" -> Pat.Lit(value = Expr.NullLit) | name:NAME -> Pat.Bind
            climbed = left:additive @operators {
                left "||"
                left "&&"
                none "==" "!=" "<=" ">=" "<" ">" suffix "is" asked -> Expr.Is(left = left, right = right)
                left "??" -> Expr.Coalesce
                left "|>" -> Expr.Pipe(value = left, stage = right)
                left "|" "^" "&" "<<" (">" ">")
            } -> Expr.Binary
            additive = left:unary @operators {
                left "+" "-"
                left "*" "/" "%"
            } -> Expr.Binary
            unary = "!" value:unary -> Expr.Not | "-" value:unary -> Expr.Neg | "~" value:unary -> Expr.Bitnot | withed
            withed = subject:postfix "with" "{" BREAK? fields:NAME ":" values:expression ( "," BREAK? fields:NAME ":" values:expression )* ","? BREAK? "}" -> Expr.With | v:postfix
            postfix = subject:primary ( "." "type" "(" ty:type ")" @expect(")", "expected `)` to close the type literal") -> Expr.TypeLiteral | "?." "type" "(" ty:type ")" @expect(")", "expected `)` to close the chained type literal") -> Expr.ChainType | "." name:NAME "(" ( args:argument ( "," args:argument )* ","? )? ")" -> method_link(subject, name, args) | "." name:NAME -> Expr.Prop | "?." name:NAME "(" ( args:argument ( "," args:argument )* ","? )? ")" -> Expr.ChainCall | "?." name:NAME -> Expr.Chain | "?." "(" ( args:argument ( "," args:argument )* ","? )? ")" -> Expr.ChainApply | "(" ( args:argument ( "," args:argument )* ","? )? ")" -> Expr.CallValue | "[" index:expression "]" @expect("]", "expected `]` to close the index") -> Expr.Index | "!" -> Expr.Force | "?" -> Expr.Propagate | blocks:trailing ( "else" else_block:trailing )? @trailer(blocks) -> trailed_link(subject, blocks, else_block) )* @fold(subject) -> subject
            primary = bits:FRACTION -> Expr.FloatLit | value:INTEGER -> Expr.IntLit | name:NAME -> Expr.Ident | "(" e:expression ")" @expect(")", "expected `)` to close the group") -> e
        }
        builders: rows
        diags: codes
        soft_words: ["rest"]
        refusals: [
            RefusalRow { name: "leading_pipe", kind: "parse.leading_pipe", voice: leading_pipe },
        ]
    }
    expr_spine
}
