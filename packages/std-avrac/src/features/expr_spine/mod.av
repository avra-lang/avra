//! The expression spine: the operator table every expression
//! feature hangs from. One `@operators` block states the infix band
//! loosest first — the table IS the precedence — and the climb
//! groups each tier to the left. Literals,
//! identifiers, the operators — `|| && == != < <= > >= + -
//! * / % !` — and postfix access (`xs[i]`, `xs.length`,
//! `u?.age`, `v!`, `v?`) live here, at the loosest layer, with
//! `catch`. The TRAILING BLOCK is a postfix like the rest: `f(a) {
//! x -> body }` is `f(a, (x) -> body)`, `else { … }` after it
//! fills the next fn seat, `{ … }` with no arrow takes no seat (or
//! `it`, when the body reads it), and a name or a field read takes
//! one as a call with no parentheses (`run { … }`, `db.tx { … }`).
//! A HEAD — what `if`, `while`, `for`, `match` and `let … else`
//! open their brace after — takes none: parenthesise the call
//! there. THE PIPE is application: `x |> f(a)` IS `f(x, a)`, and
//! pipe.av states its whole law. The TYPE LITERAL is a postfix
//! too: `v.type(List<string?>)` is `v.interned(.List(.Opt(.Str)))`
//! — the type in its own spelling, folded once by the receiver; a
//! name that spells no shape is a hole, the id it names.
use features.{LanguageFeature, BuilderRow}
// LICENSED modules.unused_import: `Operators`' tables are named by GENERATED
// code, not by this file — the `grammar { }` expansion writes `Tier`,
// `Assoc`, `Suffix` and the `operators_of` call here for the table
use @std.grammar.{
    Grammar,
    Rule,
    Alt,
    Seq,
    Item,
    Prim,
    Rep,
    Build,
    Expect,
    Recover,
    Tier,
    Assoc,
    Suffix,
    operators_of,
}
use diagnostics.{DiagCode}

export fn expr_spine() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name              | build
        "int_lit"         | build_int_lit
        "unmixed_bitwise" | build_unmixed_bitwise
        "bitnot_expr"     | build_bitnot
        "compare"         | build_compare
        "neg_expr"        | build_neg
        "fold_postfix"    | build_fold_postfix
        "pipe"            | build_pipe
        "leading_pipe"    | build_leading_pipe
        "catch_any"       | build_catch
        "trailing"        | build_trailing
        "asked_bind"      | build_asked_bind
    }
    let codes = table<DiagCode> {
        kind                | summary
        "type.mismatch"     | "an operand has the wrong type"
        "type.unknown_prop" | "a property name nothing answers to"
        "type.shift_count"  | "a shift count is between 0 and 63"
    }
    LanguageFeature expr_spine {
        gram: grammar {
            expression = l:climbed ( ck:"catch" ( "{" BREAK ( "." cv:NAME ( "(" cb:NAME ")" )? "->" ca:expression BREAK )* "}" | "{" BREAK ( tb:NAME ":" tn:NAME "->" ta:expression BREAK )+ "}" | "." sv:NAME ( "(" sb:NAME ")" )? "->" sa:expression | ub:NAME ":" un:NAME "->" ua:expression | eb:NAME "->" ea:expression | rv:expression ) )? -> catch_any(l, ck, cv, cb, ca, sv, sb, sa, eb, ea, rv, tb, tn, ta, ub, un, ua)
            argument = name:NAME ":" value:expression -> Expr.Named | expression
            trailing = "{" ( ps:trailing_seat ( "," ps:trailing_seat )* ","? "->" )? ( ts:stmt | BREAK )* "}" @expect("}", "expected `}` to close the trailing block") -> trailing(ps, ts)
            trailing_seat = ( constant:"const" )? ( mutable:"mut" )? name:NAME -> Record.ParamSyntax
            stmt = lp:"|>" -> leading_pipe(lp)
            asked = "." name:NAME ( "(" ( args:asked_payload ( "," args:asked_payload )* ","? )? ")" )? -> Pat.Variant | name:NAME ":" ty:type_atom -> Pat.Typed
            asked_payload = "_" -> Pat.Wild | n:NAME -> asked_bind(n)
            climbed = left:additive @operators {
                left "||"
                left "&&"
                none "==" "!=" "<=" ">=" "<" ">" suffix "is" asked -> compare(left, op, right)
                left "??" -> Expr.Coalesce
                left "|>" -> pipe(left, op, right)
                unmixed(unmixed_bitwise) "|" "^" "&" "<<" (">" ">")
            } -> Expr.Binary
            additive = left:unary @operators {
                left "+" "-"
                left "*" "/" "%"
            } -> Expr.Binary
            unary = "!" value:unary -> Expr.Not | "-" v:unary -> neg_expr(v) | "~" v:unary -> bitnot_expr(v) | withed
            withed = subject:postfix "with" "{" BREAK? fields:NAME ":" values:expression ( "," BREAK? fields:NAME ":" values:expression )* ","? BREAK? "}" -> Expr.With | v:postfix
            postfix = v:primary ( "." "type" "(" tt:type ")" @expect(")", "expected `)` to close the type literal") | "?." "type" "(" tq:type ")" @expect(")", "expected `)` to close the chained type literal") | q:( "?." | "." ) p:NAME ( mo:"(" ( ma:argument ( "," ma:argument )* ","? )? ")" )? | "[" i:expression "]" @expect("]", "expected `]` to close the index") | ( cq:"?." )? co:"(" ( ca:argument ( "," ca:argument )* ","? )? ")" | f:( "!" | "?" ) | tb:trailing ( "else" te:trailing )? @trailer(tb) )* -> fold_postfix(v, q, p, mo, ma, i, co, ca, f, tb, te, tt, tq, cq)
            primary = v:NUMBER -> int_lit(v) | name:NAME -> Expr.Ident | "(" e:expression ")" @expect(")", "expected `)` to close the group") -> e
        }
        builders: rows
        diags: codes
    }
    expr_spine
}
