//! The expression spine: the precedence ladder every expression
//! feature hangs from. Left association comes from folding the
//! repeated tail, exactly as the grammar reads.
use features.{LanguageFeature, BuilderRow}

export fn expr_spine() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name          | build
        "int_lit"     | build_int_lit
        "ident"       | build_ident
        "fold_binary" | build_fold_binary
    }
    component LanguageFeature spine {
        name = "expr_spine"
        docs = "Expressions: integer literals, identifiers, and left-associative `+`/`-`."
        gram = """
expression = additive
additive = l:primary ( op:( "+" | "-" ) r:primary )* -> fold_binary(l, op, r)
primary = v:NUMBER -> int_lit(v) | n:NAME -> ident(n)
"""
        builders = rows
    }
    spine
}
