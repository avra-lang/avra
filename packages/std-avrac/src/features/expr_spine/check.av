//! Typing rules: one homogeneous-operand law (`op_over`) — both
//! sides `want`, or each PRESENT wrong side speaks; `==`/`!=` want
//! MATCHING operands. An Error operand ABSORBS everywhere — its
//! cause was diagnosed where it happened; the wording lives here
//! with the operators.
use core.{ExprId, BinOp, Type, TypeId, op_symbol, DeclId}
use features.{TypeCx, EnumSig, this_is, variants_are, build_a_record, nothing}
use diagnostics.{refusal}

fn spine_type(mut cx: TypeCx, e: ExprId) -> TypeId {
    // a feature cannot enumerate OTHER features' variants
    match cx.view.store.expr(e) {
        .IntLit(_) -> cx.type(int),
        .FloatLit(_) -> cx.type(float),
        .Ident(_) -> {
            cx.warn_use(e)
            cx.target_type(e)
        },
        .Binary(op, l, r) -> binary_type(cx, e, op, l, r),
        .Not(v) -> not_type(cx, v),
        .Index(s, i) -> index_type(cx, s, i),
        .Prop(s, name) -> prop_type(cx, e, s, name.of),
        rest -> cx.error_type,
    }
}

/// `subject[index]`: the subject is a List, the index an int, the
/// answer the element type.
fn index_type(mut cx: TypeCx, subject: ExprId, index: ExprId) -> TypeId {
    let elem: TypeId? = cx.view.types.element(cx.type_at(subject))
    if elem == null {
        if cx.errored(subject) { return cx.error_type }
        return not_indexable(cx, subject)
    }
    let ish = cx.shape_at(index)
    if !(ish is .Int) && !(ish is .Error) { index_not_int(cx, index) }
    elem!
}

/// A property read has THREE owners, asked in order: a TYPE NAME
/// subject constructs a variant, a struct answers its field's type,
/// and `.length` measures. (At self-host this becomes one
/// member-resolution query; today the chain lives with the node.)
fn prop_type(mut cx: TypeCx, e: ExprId, subject: ExprId, name: string) -> TypeId {
    let sh: Type = cx.shape_at(subject)
    if sh is .Error { return cx.error_type }
    match sh {
        .TypeName(decl, tname) -> variant_type(cx, e, decl, tname, name),
        _ -> member_type(cx, e, subject, name),
    }
}

/// A property on a TYPE NAME constructs one of its variants — the
/// answer is the enum's own type.
fn variant_type(mut cx: TypeCx, e: ExprId, decl: DeclId, tname: string, name: string) -> TypeId {
    let tp = cx.tparams(decl)
    if !tp.is_empty() {
        if cx.seals_decl(cx.loc_of(e), decl, "built here") { return cx.error_type }
        return cx.unit_instantiated(e, tname, name, decl, tp)
    }
    let ty = cx.view.types.intern(Type.Enum(decl, tname))
    let declared? = cx.variants_of(ty) else { return record_name_read(cx, e, decl, tname, name) }
    if declared.tag_of(name) == null { return no_variant_read(cx, e, tname, name, declared) }
    if cx.seals_decl(cx.loc_of(e), decl, "built here") { return cx.error_type }
    // A carrying variant named bare would build a value missing its
    // payload — the arity law belongs on both construction paths.
    let carried = declared.payloads_of(name)
    if !carried.is_empty() { return named_without_payload(cx, e, tname, name, carried[0]) }
    ty
}

/// The nullable side of `x == null` / `null != x` — exactly one
/// nullable beside the absence; null otherwise. The lowering keeps
/// a shape-twin of this projection.
fn presence_subject(cx: TypeCx, l: ExprId, r: ExprId) -> ExprId? {
    if cx.seen_at(l) is .Opt && cx.seen_at(r) is .Null { return l }
    if cx.seen_at(r) is .Opt && cx.seen_at(l) is .Null { return r }
    null
}

/// A property on a VALUE — the shared member law (checks.av), the
/// subject shown by its expression's name.
fn member_type(mut cx: TypeCx, e: ExprId, subject: ExprId, name: string) -> TypeId {
    cx.member_type_of(e, cx.name_at(subject), cx.type_at(subject), name)
}

/// THE NAMED OPERAND LAW: a NAME and its bare shape never mix —
/// the name is the whole point — but a LITERAL beside a name adopts
/// it, exactly as a seat's does. Two values of one name answer THAT
/// NAME; a test answers `bool` whatever it compared. The operator's
/// own law still runs over the SHAPE, so `Rows + Rows` refuses in
/// the shape's words.
fn binary_type(mut cx: TypeCx, e: ExprId, op: BinOp, l: ExprId, r: ExprId) -> TypeId {
    let named: TypeId? = named_side(cx, l) ?? named_side(cx, r)
    if named != null && !named_agree(cx, l, r, named!) { return cx.error_type }
    let answer = op_type(cx, e, op, l, r)
    if named == null || cx.errored_ty(answer) { return answer }
    if cx.view.types.shape_of(answer) is .Bool { return answer }
    named!
}

/// The NAME a side wears, when it wears one.
fn named_side(cx: TypeCx, e: ExprId) -> TypeId? {
    let ty = cx.type_at(e)
    if cx.view.types.stands_for(ty) == null { return null }
    ty
}

/// Both sides wear the name — the same name, or a literal that
/// adopts it. A side that does not speaks the name's own remedy.
fn named_agree(mut cx: TypeCx, l: ExprId, r: ExprId, named: TypeId) -> bool {
    named_operand(cx, l, named) && named_operand(cx, r, named)
}

/// THE OTHER SIDE DECIDES WHICH REFUSAL IS TRUE. Its bare shape has
/// a wrap and hears about it; ANOTHER NAME has none, and saying "its
/// shape" would name a type that is not one; anything else is the
/// operator's own law to refuse, in its own words.
fn named_operand(mut cx: TypeCx, e: ExprId, named: TypeId) -> bool {
    if cx.errored(e) || cx.accepts(e, named) { return true }
    let ty = cx.type_at(e)
    if !cx.types_disagree(ty, cx.seen(named)) {
        mixed_with_shape(cx, e, named)
        return false
    }
    if cx.view.types.stands_for(ty) == null { return true }
    two_names(cx, e, named)
    false
}

fn op_type(mut cx: TypeCx, e: ExprId, op: BinOp, l: ExprId, r: ExprId) -> TypeId {
    match op {
        .Add -> added_type(cx, op, l, r),
        .Sub or .Mul or .Div -> arith_type(cx, op, l, r),
        // `%` stays INT-ONLY: a remainder of two reals is `fmod`, a
        // different operation wearing the same symbol, and nobody has
        // asked for it. The refusal names `int` and is the whole law.
        .Mod -> op_over(cx, op, l, r, Type.Int, Type.Int),
        .Lt or .Le or .Gt or .Ge -> ordered_type(cx, op, l, r),
        .And or .Or -> op_over(cx, op, l, r, Type.Bool, Type.Bool),
        .BitAnd or .BitOr or .BitXor -> op_over(cx, op, l, r, Type.Int, Type.Int),
        .Shl or .Shr -> shifted_type(cx, op, l, r),
        .Eq or .Ne -> eq_type(cx, e, op, l, r),
    }
}

/// A shift is an int law with ONE extra rule, and the rule is the
/// compiler holding knowledge no other tool has: a count outside
/// 0..63 has no answer on any machine, so a LITERAL one is refused
/// where it is written rather than trapped when it runs. A count the
/// compiler cannot read traps instead — `avra_int_shl` guards it, and
/// both engines call that same body, so neither can be wrong alone.
fn shifted_type(mut cx: TypeCx, op: BinOp, l: ExprId, r: ExprId) -> TypeId {
    let count? = cx.view.store.expr(r).int_of() else { return op_over(cx, op, l, r, Type.Int, Type.Int) }
    if count < 0 || count > 63 { return bad_shift_count(cx, r, count) }
    op_over(cx, op, l, r, Type.Int, Type.Int)
}

/// `+` joins two texts or adds two ints — the left side decides
/// which law the right must meet.
fn added_type(mut cx: TypeCx, op: BinOp, l: ExprId, r: ExprId) -> TypeId {
    if cx.seen_at(l) is .Str { return op_over(cx, op, l, r, Type.Str, Type.Str) }
    arith_type(cx, op, l, r)
}

/// THE NUMERIC LAW: the LEFT operand names the kind and the right
/// must wear it. `int` and `float` never mix on their own — an
/// implicit widening is a precision decision nobody wrote down, and
/// the two kinds answer differently for the same digits. A mixed
/// expression says which it means by converting.
fn arith_type(mut cx: TypeCx, op: BinOp, l: ExprId, r: ExprId) -> TypeId {
    if cx.seen_at(l) is .Float { return op_over(cx, op, l, r, Type.Float, Type.Float) }
    op_over(cx, op, l, r, Type.Int, Type.Int)
}

/// The ordered comparisons, by the same law, answering a bool.
fn ordered_type(mut cx: TypeCx, op: BinOp, l: ExprId, r: ExprId) -> TypeId {
    if cx.seen_at(l) is .Float { return op_over(cx, op, l, r, Type.Float, Type.Bool) }
    op_over(cx, op, l, r, Type.Int, Type.Bool)
}

/// The homogeneous-operand law: both sides `want`, or each PRESENT
/// wrong side speaks for itself.
fn op_over(mut cx: TypeCx, op: BinOp, l: ExprId, r: ExprId, want: Type, answer: Type) -> TypeId {
    if wears(cx.seen_at(l), want) && wears(cx.seen_at(r), want) {
        return cx.view.types.intern(answer)
    }
    needs(cx, op, l, want)
    needs(cx, op, r, want)
    cx.error_type
}

fn needs(mut cx: TypeCx, op: BinOp, e: ExprId, want: Type) {
    let sh = cx.seen_at(e)
    if wears(sh, want) || sh is .Error { return }
    wrong_operand(cx, op, e, want)
}

/// Whether a shape IS the scalar an operator wants — the three the
/// operators speak.
fn wears(sh: Type, want: Type) -> bool {
    match want {
        .Int -> sh is .Int,
        .Float -> sh is .Float,
        .Bool -> sh is .Bool,
        .Str -> sh is .Str,
        .Ptr or .Bytes or .List(_) or .Cell(_) or .Task(_) or .Tasks or .Struct(_, _) or .Enum(_, _) or .Res(_, _) or .App(_, _, _) or .TypeName(_, _) or .Var(_, _, _) or .Dyn(_, _) or .Fn(_, _, _) or .Opt(_) or .Null or .EmptyList or .Error or .Void or .Map(_, _) or .EmptyMap or .Union(_) or .Range -> false,
    }
}

/// `!` negates a bool; Error absorbs to the answer.
fn not_type(mut cx: TypeCx, v: ExprId) -> TypeId {
    let sh = cx.seen_at(v)
    if sh is .Bool || sh is .Error { return cx.type(bool) }
    not_negatable(cx, v)
}

/// A SIDE WITH NO TYPE OF ITS OWN HEARS THE OTHER SIDE'S: `tone ==
/// .Danger` reads the enum off `tone` — through one `?` when `tone`
/// is nullable — as a typed `let` or an argument seat would say it.
fn heard_across(mut cx: TypeCx, side: ExprId, other: ExprId) {
    if !cx.facts.hungry_at(side) || cx.facts.hungry_at(other) || cx.errored(other) { return }
    cx.feed(side, cx.type_at(other))
}

/// What a nullable comparison compares — the carried type — when
/// one side is a nullable and the other is what it carries, or the
/// same nullable; absence otherwise.
fn nullable_compared(cx: TypeCx, l: ExprId, r: ExprId) -> TypeId? {
    let lc: TypeId? = cx.view.types.carried(cx.type_at(l))
    let rc: TypeId? = cx.view.types.carried(cx.type_at(r))
    if lc == null && rc == null { return null }
    let inner: TypeId = lc ?? rc!
    let other = if lc == null { cx.type_at(l) } else { cx.type_at(r) }
    if !cx.types_disagree(other, inner) { return inner }
    if lc != null && rc != null && !cx.types_disagree(lc!, rc!) { return inner }
    null
}

/// The side that cannot be compared, LEFT first — the one the
/// refusal should point at.
fn uncomparable(cx: TypeCx, l: ExprId, r: ExprId) -> ExprId? {
    if !cx.compares_by_value(cx.seen(cx.type_at(l))) { return l }
    if !cx.compares_by_value(cx.seen(cx.type_at(r))) { return r }
    null
}

/// Where to look instead, by what was offered.
fn compare_help(sh: Type) -> string {
    match sh {
        .List(_) -> "compare an element or the `length` instead",
        .Cell(_) -> "read the cell with `get` before comparing",
        .Task(_) -> "compare what it answers — `.await` it first",
        .Tasks -> "an owner of tasks is not a value to compare",
        .Struct(_, _) -> "compare a field instead",
        .Enum(_, _) or .Res(_, _) -> "match on it instead — only an enum carrying nothing compares, by variant",
        .Opt(_) or .Null -> "answer the absence first — `??` gives it a value",
        .EmptyList -> "an empty list compares with nothing — give it elements or a declared type",
        .Map(_, _) or .EmptyMap -> "maps do not compare — ask `get`",
        .Var(_, _, _) -> "a type parameter cannot compare — operator traits are recorded",
        .Dyn(_, _) -> "a `dyn` compares behind its contract — operator traits are recorded",
        .Fn(_, _, _) -> "fn values do not compare — call them instead",
        .Void -> "nothing compares — a mutation answers no value",
        .App(_, _, _) -> "reach for a member instead — the declaration decides field or `match`",
        .Union(_) -> "`catch` narrows to a member instead — a union carries no value to compare",
        .Range -> "compare a bound instead",
        .Ptr or .Int or .Float or .Bytes or .Bool or .Str or .TypeName(_, _) or .Error -> "compare scalars or strings",
    }
}

fn eq_type(mut cx: TypeCx, e: ExprId, op: BinOp, l: ExprId, r: ExprId) -> TypeId {
    heard_across(cx, l, r)
    heard_across(cx, r, l)
    let ls = cx.seen_at(l)
    let rs = cx.seen_at(r)
    if ls is .Error || rs is .Error { return cx.error_type }
    // THE PRESENCE TEST: a nullable beside `null` asks IS IT THERE —
    // the one comparison absence answers, and the answer is a bool.
    // A NAMED subject records the ask as a fact `if` can query:
    // `!= null` proves the then-branch, `== null` the else.
    let asked: ExprId? = presence_subject(cx, l, r)
    if asked != null {
        if cx.view.store.expr(asked!) is .Ident {
            cx.record_ask(e, asked!, op == BinOp.Ne)
        }
        return cx.type(bool)
    }
    // A GUARANTEE beside `null` is a question with only one answer.
    if ls is .Null && rs is .Null { return both_absent(cx, op, l) }
    if ls is .Null || rs is .Null {
        let solid = if ls is .Null { r } else { l }
        return not_askable(cx, op, solid)
    }
    // A NULLABLE beside its value, or beside its own nullable,
    // compares THROUGH PRESENCE: absent equals nothing but absence.
    let inner: TypeId? = nullable_compared(cx, l, r)
    if inner != null {
        if !cx.compares_by_value(inner!) { return not_comparable(cx, op, l) }
        return cx.type(bool)
    }
    // An AGGREGATE would compare by ADDRESS — never what the writer
    // meant, and the engines disagreed about it: the interpreter
    // refused while the backend quietly answered `false` for two
    // identical values.
    let found: ExprId? = uncomparable(cx, l, r)
    if found != null { return not_comparable(cx, op, found!) }
    // A NAME IS TRANSPARENT AT A READ: the named law already held
    // both sides to one name, so the shapes are what remain to agree.
    if !cx.types_disagree(cx.seen(cx.type_at(l)), cx.seen(cx.type_at(r))) { return cx.type(bool) }
    mismatched_sides(cx, op, l, r)
}

// ── The voices ──

fn not_indexable(mut cx: TypeCx, subject: ExprId) -> TypeId {
    let n = cx.name_at(subject)
    cx
        .spoken(
            refusal(
                "type.mismatch",
                cx.loc_of(subject),
                "`[...]` indexes a `List`, found `${n}`",
                this_is(n),
                null,
            ),
        )
}

fn index_not_int(mut cx: TypeCx, index: ExprId) {
    cx
        .emit(
            refusal(
                "type.mismatch",
                cx.loc_of(index),
                "an index is an `int`, found `${cx.name_at(index)}`",
                "this decides the position",
                null,
            ),
        )
}

/// A record's name read without a call: its own static fn, or nothing.
fn record_name_read(mut cx: TypeCx, e: ExprId, decl: DeclId, tname: string, name: string) -> TypeId {
    let m? = cx.static_named(decl, name) else { return record_read(cx, e, tname) }
    cx.static_not_value(e, tname, name, m)
}

fn record_read(mut cx: TypeCx, e: ExprId, tname: string) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.unknown_prop",
                cx.loc_of(e),
                "`${tname}` is a record, not an enum",
                "read here",
                build_a_record(tname),
            ),
        )
}

fn no_variant_read(mut cx: TypeCx, e: ExprId, tname: string, name: string, sig: EnumSig) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.unknown_prop",
                cx.loc_of(e),
                "`${tname}` has no variant `${name}`",
                "read here",
                variants_are(sig),
            ),
        )
}

fn named_without_payload(mut cx: TypeCx, e: ExprId, tname: string, name: string, carried: TypeId) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.mismatch",
                cx.loc_of(e),
                "`${tname}.${name}` carries `${cx.view.types.name_of(carried)}`",
                "named without it here",
                "write `${tname}.${name}(<value>)`",
            ),
        )
}

fn wrong_operand(mut cx: TypeCx, op: BinOp, e: ExprId, want: Type) {
    let n = cx.name_at(e)
    cx
        .emit(
            refusal(
                "type.mismatch",
                cx.loc_of(e),
                "`${op_symbol(op)}` needs `${cx.view.types.name_of(cx.view.types.intern(want))}` operands, found `${n}`",
                this_is(n),
                null,
            ),
        )
}

fn not_negatable(mut cx: TypeCx, v: ExprId) -> TypeId {
    let n = cx.name_at(v)
    cx
        .spoken(
            refusal(
                "type.mismatch",
                cx.loc_of(v),
                "`!` negates a `bool`, found `${n}`",
                this_is(n),
                null,
            ),
        )
}

fn both_absent(mut cx: TypeCx, op: BinOp, l: ExprId) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.mismatch",
                cx.loc_of(l),
                "both sides are always absent, so `${op_symbol(op)}` always answers",
                "always absent",
                "write the answer alone",
            ),
        )
}

fn not_askable(mut cx: TypeCx, op: BinOp, solid: ExprId) -> TypeId {
    let n = cx.name_at(solid)
    cx
        .spoken(
            refusal(
                "type.mismatch",
                cx.loc_of(solid),
                "`${op_symbol(op)} null` asks a nullable, this is `${n}`",
                this_is(n),
                "`${n}` is a guarantee — it is never absent",
            ),
        )
}

fn not_comparable(mut cx: TypeCx, op: BinOp, offender: ExprId) -> TypeId {
    let n = cx.name_at(offender)
    cx
        .spoken(
            refusal(
                "type.mismatch",
                cx.loc_of(offender),
                "`${op_symbol(op)}` compares by value — a scalar, text, a tagged enum, or a record of one such field",
                this_is(n),
                compare_help(cx.seen_at(offender)),
            ),
        )
}

fn mismatched_sides(mut cx: TypeCx, op: BinOp, l: ExprId, r: ExprId) -> TypeId {
    let rn = cx.name_at(r)
    cx
        .spoken(
            refusal(
                "type.mismatch",
                cx.loc_of(r),
                "`${op_symbol(op)}` compares matching types, found `${cx.name_at(l)}` and `${rn}`",
                this_is(rn),
                null,
            ),
        )
}

/// A NAME MEETS ITS OWN SHAPE — the remedy is the conversion.
fn mixed_with_shape(mut cx: TypeCx, e: ExprId, named: TypeId) {
    let n = cx.name_at(e)
    cx
        .emit(
            cx
                .named_fix(
                    refusal(
                        "type.mismatch",
                        cx.loc_of(e),
                        "an operand of `${cx.view.types.name_of(named)}` meets `${n}` — a named type never mixes with its shape",
                        this_is(n),
                        null,
                    ),
                    named,
                    e,
                ),
        )
}

/// A NAME MEETS ANOTHER NAME. No wrap is honest — neither stands
/// over the other — so the refusal offers none.
fn two_names(mut cx: TypeCx, e: ExprId, named: TypeId) {
    let n = cx.name_at(e)
    cx
        .emit(
            refusal(
                "type.mismatch",
                cx.loc_of(e),
                "`${cx.view.types.name_of(named)}` and `${n}` are two types — a named type never mixes with another",
                this_is(n),
                null,
            ),
        )
}

fn bad_shift_count(mut cx: TypeCx, r: ExprId, count: int) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.shift_count",
                cx.loc_of(r),
                "a shift count must be between 0 and 63, this is ${count}",
                "shifted by this",
                "an `int` is 64 bits, so a wider shift has no answer to give",
            ),
        )
}
