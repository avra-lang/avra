//! Typing rules: arithmetic wants ints and answers int; `<` wants
//! ints and answers bool; `==` wants MATCHING operands and answers
//! bool. An Error operand ABSORBS everywhere — its cause was
//! diagnosed where it happened; a PRESENT wrong type is this
//! feature's own news, and the wording lives here with the operator.
use core.{Expr, ExprId, BinOp, Type, TypeId}
use features.{TypeCx}
use diagnostics.{error_at, pointed}

fn spine_type(cx: TypeCx, e: ExprId) -> TypeId {
    match cx.store.expr(e) {
        .IntLit(_) -> cx.intern(Type.Int),
        .Ident(_) -> cx.target_type(e),
        .Binary(op, l, r) -> binary_type(cx, op, l, r),
        _ -> cx.intern(Type.Error),
    }
}

fn binary_type(cx: TypeCx, op: BinOp, l: ExprId, r: ExprId) -> TypeId {
    match op {
        .Add or .Sub -> int_op_type(cx, op, l, r, Type.Int),
        .Lt -> int_op_type(cx, op, l, r, Type.Bool),
        .Eq -> eq_type(cx, l, r),
    }
}

fn int_op_type(cx: TypeCx, op: BinOp, l: ExprId, r: ExprId, answer: Type) -> TypeId {
    if cx.shape_at(l) is .Int && cx.shape_at(r) is .Int {
        return cx.intern(answer)
    }
    mismatch(cx, op, l)
    mismatch(cx, op, r)
    cx.intern(Type.Error)
}

fn eq_type(cx: TypeCx, l: ExprId, r: ExprId) -> TypeId {
    let ls = cx.shape_at(l)
    let rs = cx.shape_at(r)
    if ls is .Error || rs is .Error { return cx.intern(Type.Error) }
    if ls == rs { return cx.intern(Type.Bool) }
    cx.emit(pointed(
        error_at("type.mismatch", cx.loc_of(r), "`==` compares matching types, found `${cx.name_at(l)}` and `${cx.name_at(r)}`"),
        "this is a `${cx.name_at(r)}`"))
    cx.intern(Type.Error)
}

fn mismatch(cx: TypeCx, op: BinOp, e: ExprId) {
    let sh = cx.shape_at(e)
    if sh is .Int || sh is .Error { return }
    cx.emit(pointed(
        error_at("type.mismatch", cx.loc_of(e), "`${op_text(op)}` needs `int` operands, found `${cx.name_at(e)}`"),
        "this is a `${cx.name_at(e)}`"))
}

fn op_text(op: BinOp) -> string {
    match op {
        .Add -> "+",
        .Sub -> "-",
        .Eq -> "==",
        .Lt -> "<",
    }
}
