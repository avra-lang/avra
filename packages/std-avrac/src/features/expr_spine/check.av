//! Typing rules: one homogeneous-operand law (`op_over`) — both
//! sides `want`, or each PRESENT wrong side speaks; `==`/`!=` want
//! MATCHING operands. An Error operand ABSORBS everywhere — its
//! cause was diagnosed where it happened; the wording lives here
//! with the operators.
use core.{ExprId, StmtId, BinOp, Type, TypeId, op_symbol}
use features.{TypeCx, EnumSig, spoken, this_is, variants_are, build_a_record, member_type_of}
use diagnostics.{error_at, pointed}

fn spine_type(cx: TypeCx, e: ExprId) -> TypeId {
    // LICENSED I22: a feature cannot enumerate OTHER features' variants (the isolation doctrine); its own are listed
    match cx.store.expr(e) {
        .IntLit(_) -> cx.types.intern(Type.Int),
        .Ident(_) -> cx.target_type(e),
        .Binary(op, l, r) -> binary_type(cx, e, op, l, r),
        .Not(v) -> not_type(cx, v),
        .Index(s, i) -> index_type(cx, s, i),
        .Prop(s, name) -> prop_type(cx, e, s, name),
        _ -> cx.error_type,
    }
}

/// `subject[index]`: the subject is a List, the index an int, the
/// answer the element type.
fn index_type(cx: TypeCx, subject: ExprId, index: ExprId) -> TypeId {
    let elem: TypeId? = match cx.shape_at(subject) {
        .List(t) -> t,
        _ -> null,
    }
    if elem == null {
        if cx.shape_at(subject) is .Error { return cx.error_type }
        let n = cx.name_at(subject)
        return spoken(cx, pointed(
            error_at("type.mismatch", cx.loc_of(subject), "`[...]` indexes a `List`, found `${n}`"),
            this_is(n)))
    }
    let ish = cx.shape_at(index)
    if !(ish is .Int) && !(ish is .Error) {
        cx.emit(pointed(
            error_at("type.mismatch", cx.loc_of(index), "an index is an `int`, found `${cx.name_at(index)}`"),
            "this decides the position"))
    }
    elem!
}

/// A property read has THREE owners, asked in order: a TYPE NAME
/// subject constructs a variant, a struct answers its field's type,
/// and `.length` measures. (At self-host this becomes one
/// member-resolution query; today the chain lives with the node.)
fn prop_type(cx: TypeCx, e: ExprId, subject: ExprId, name: string) -> TypeId {
    let sh: Type = cx.shape_at(subject)
    if sh is .Error { return cx.error_type }
    match sh {
        .TypeName(decl, tname) -> variant_type(cx, e, decl, tname, name),
        _ -> member_type(cx, e, subject, name),
    }
}

/// A property on a TYPE NAME constructs one of its variants — the
/// answer is the enum's own type.
fn variant_type(cx: TypeCx, e: ExprId, decl: StmtId, tname: string, name: string) -> TypeId {
    if !cx.store.decl_tparams(decl).is_empty() {
        return spoken(cx, pointed(
            error_at("type.unknown_prop", cx.loc_of(e),
                "`${tname}.${name}` cannot pin `${tname}`'s type — nothing carries it"),
            "read here")
            with { help: "a payload pins the type; the pinned unit surface is recorded" })
    }
    let ty = cx.types.intern(Type.Enum(decl, tname))
    let sig: EnumSig? = cx.variants_of(ty)
    if sig == null {
        return spoken(cx, pointed(
            error_at("type.unknown_prop", cx.loc_of(e), "`${tname}` is a record, not an enum"),
            "read here")
            with { help: build_a_record(tname) })
    }
    let declared = sig!
    let tag: int? = declared.tag_of(name)
    if tag == null {
        return spoken(cx, pointed(
            error_at("type.unknown_prop", cx.loc_of(e), "`${tname}` has no variant `${name}`"),
            "read here")
            with { help: variants_are(declared) })
    }
    // A carrying variant named bare would build a value missing its
    // payload — the arity law belongs on both construction paths.
    let carried: TypeId? = declared.payload_of(name)
    if carried != null {
        return spoken(cx, pointed(
            error_at("type.mismatch", cx.loc_of(e),
                "`${tname}.${name}` carries a `${cx.types.name_of(carried!)}`"),
            "named without it here")
            with { help: "write `${tname}.${name}(<value>)`" })
    }
    ty
}

/// The nullable side of `x == null` / `null != x` — exactly one
/// nullable beside the absence; null otherwise. The lowering keeps
/// a shape-twin of this projection.
fn presence_subject(cx: TypeCx, l: ExprId, r: ExprId) -> ExprId? {
    if cx.shape_at(l) is .Opt && cx.shape_at(r) is .Null { return l }
    if cx.shape_at(r) is .Opt && cx.shape_at(l) is .Null { return r }
    null
}

/// A property on a VALUE — the shared member law (checks.av), the
/// subject shown by its expression's name.
fn member_type(cx: TypeCx, e: ExprId, subject: ExprId, name: string) -> TypeId {
    member_type_of(cx, e, cx.name_at(subject), cx.type_at(subject), name)
}

fn binary_type(cx: TypeCx, e: ExprId, op: BinOp, l: ExprId, r: ExprId) -> TypeId {
    match op {
        .Add or .Sub or .Mul or .Div or .Mod -> op_over(cx, op, l, r, Type.Int, Type.Int),
        .Lt or .Le or .Gt or .Ge -> op_over(cx, op, l, r, Type.Int, Type.Bool),
        .And or .Or -> op_over(cx, op, l, r, Type.Bool, Type.Bool),
        .Eq or .Ne -> eq_type(cx, e, op, l, r),
    }
}

/// The homogeneous-operand law: both sides `want`, or each PRESENT
/// wrong side speaks for itself.
fn op_over(cx: TypeCx, op: BinOp, l: ExprId, r: ExprId, want: Type, answer: Type) -> TypeId {
    if cx.shape_at(l) == want && cx.shape_at(r) == want {
        return cx.types.intern(answer)
    }
    needs(cx, op, l, want)
    needs(cx, op, r, want)
    cx.error_type
}

fn needs(cx: TypeCx, op: BinOp, e: ExprId, want: Type) {
    let sh = cx.shape_at(e)
    if sh == want || sh is .Error { return }
    let n = cx.name_at(e)
    cx.emit(pointed(
        error_at("type.mismatch", cx.loc_of(e),
            "`${op_symbol(op)}` needs `${cx.types.name_of(cx.types.intern(want))}` operands, found `${n}`"),
        this_is(n)))
}

/// `!` negates a bool; Error absorbs to the answer.
fn not_type(cx: TypeCx, v: ExprId) -> TypeId {
    let sh = cx.shape_at(v)
    if sh is .Bool || sh is .Error { return cx.types.intern(Type.Bool) }
    let n = cx.name_at(v)
    spoken(cx, pointed(
        error_at("type.mismatch", cx.loc_of(v), "`!` negates a `bool`, found `${n}`"),
        this_is(n)))
}

/// What `==` can compare TODAY: the values the runtime tests BY
/// VALUE. Everything else holds a pointer, and comparing pointers
/// answers a question nobody asked.
fn comparable(sh: Type) -> bool {
    sh is .Int || sh is .Bool || sh is .Str
}

/// The side that cannot be compared, LEFT first — the one the
/// refusal should point at.
fn uncomparable(cx: TypeCx, l: ExprId, r: ExprId) -> ExprId? {
    if !comparable(cx.shape_at(l)) { return l }
    if !comparable(cx.shape_at(r)) { return r }
    null
}

/// Where to look instead, by what was offered.
fn compare_help(sh: Type) -> string {
    match sh {
        .List(_) -> "compare an element or the `length` instead",
        .Struct(_, _) -> "compare a field instead",
        .Enum(_, _) or .Res(_, _) -> "match on it instead — a `match` is how an enum is asked what it is",
        .Opt(_) or .Null -> "answer the absence first — `??` gives it a value",
        .EmptyList -> "an empty list compares with nothing — give it elements or a declared type",
        .Var(_, _, _) -> "a type parameter cannot compare — operator traits are recorded",
        .Dyn(_, _) -> "a `dyn` compares behind its contract — operator traits are recorded",
        .Fn(_, _) -> "fn values do not compare — call them instead",
        .App(_, _, _) -> "reach for a member instead — the declaration decides field or `match`",
        .Int or .Bool or .Str or .TypeName(_, _) or .Error -> "compare scalars or strings",
    }
}

fn eq_type(cx: TypeCx, e: ExprId, op: BinOp, l: ExprId, r: ExprId) -> TypeId {
    let ls = cx.shape_at(l)
    let rs = cx.shape_at(r)
    if ls is .Error || rs is .Error { return cx.error_type }
    // THE PRESENCE TEST: a nullable beside `null` asks IS IT THERE —
    // the one comparison absence answers, and the answer is a bool.
    // A NAMED subject records the ask as a fact `if` can query:
    // `!= null` proves the then-branch, `== null` the else.
    let asked: ExprId? = presence_subject(cx, l, r)
    if asked != null {
        if cx.store.expr(asked!) is .Ident {
            cx.record_ask(e, asked!, op == BinOp.Ne)
        }
        return cx.types.intern(Type.Bool)
    }
    // A GUARANTEE beside `null` is a question with only one answer.
    if ls is .Null && rs is .Null {
        return spoken(cx, pointed(
            error_at("type.mismatch", cx.loc_of(l), "both sides are always absent, so `${op_symbol(op)}` always answers"),
            "always absent")
            with { help: "write the answer alone" })
    }
    if ls is .Null || rs is .Null {
        let solid = if ls is .Null { r } else { l }
        let n = cx.name_at(solid)
        return spoken(cx, pointed(
            error_at("type.mismatch", cx.loc_of(solid),
                "`${op_symbol(op)} null` asks a nullable, this is `${n}`"),
            this_is(n))
            with { help: "`${n}` is a guarantee — it is never absent" })
    }
    // An AGGREGATE would compare by ADDRESS — never what the writer
    // meant, and the engines disagreed about it: the interpreter
    // refused while the backend quietly answered `false` for two
    // identical values.
    let found: ExprId? = uncomparable(cx, l, r)
    if found != null {
        let offender = found!
        let n = cx.name_at(offender)
        return spoken(cx, pointed(
            error_at("type.mismatch", cx.loc_of(offender), "`${op_symbol(op)}` compares scalars for now"),
            this_is(n))
            with { help: compare_help(cx.shape_at(offender)) })
    }
    if ls == rs { return cx.types.intern(Type.Bool) }
    let rn = cx.name_at(r)
    spoken(cx, pointed(
        error_at("type.mismatch", cx.loc_of(r),
            "`${op_symbol(op)}` compares matching types, found `${cx.name_at(l)}` and `${rn}`"),
        this_is(rn)))
}
