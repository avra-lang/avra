//! Lowering rules: literals become constants, an ident IS its
//! definition's register (the language is SSA by construction), and
//! eager binaries become one instruction — string `==`/`!=` routes
//! to the runtime's value comparison. The LAZY ops (`&&`/`||`)
//! desugar onto the region brackets, so the right side's
//! instructions live inside a branch and short-circuit natively.
use core.{ExprId, BinOp, UnOp, Reg, Ins, Type}
use features.{LowerCx, StructSig, EnumSig, presence_of, hole_defect, lower_defect, variant_defect}

fn spine_lower(cx: LowerCx, e: ExprId) -> Reg {
    // LICENSED I22: a feature cannot enumerate OTHER features' variants (the isolation doctrine); its own are listed
    match cx.store.expr(e) {
        .IntLit(v) -> {
            let dst = cx.result(e)
            cx.emit(Ins.ConstInt(dst, v))
            dst
        }
        .Ident(_) -> ident_reg(cx, e),
        .Binary(op, l, r) -> binary_reg(cx, e, op, l, r),
        .Not(v) -> not_reg(cx, e, v),
        .Index(s, i) -> index_reg(cx, e, s, i),
        .Prop(s, name) -> prop_reg(cx, e, s, name),
        _ -> lower_defect(cx, e, hole_defect()),
    }
}

/// The presence test's subject — the typing projection's shape
/// twin: exactly one nullable beside the absence, for `==`/`!=`.
fn asked_subject(cx: LowerCx, op: BinOp, l: ExprId, r: ExprId) -> ExprId? {
    if op != BinOp.Eq && op != BinOp.Ne { return null }
    if cx.shape_at(l) is .Opt && cx.shape_at(r) is .Null { return l }
    if cx.shape_at(r) is .Opt && cx.shape_at(l) is .Null { return r }
    null
}

/// `x != null` IS the presence bit; `x == null` is its negation.
/// The null side lowers to nothing at all.
fn presence_reg(cx: LowerCx, e: ExprId, op: BinOp, subject: ExprId) -> Reg {
    let p = presence_of(cx, cx.reg_of(subject), cx.type_at(subject))
    if op == BinOp.Ne { return p }
    let dst = cx.result(e)
    cx.emit(Ins.Un(dst, UnOp.Not, p))
    dst
}

fn index_reg(cx: LowerCx, e: ExprId, s: ExprId, i: ExprId) -> Reg {
    let arr = cx.reg_of(s)
    let idx = cx.reg_of(i)
    let dst = cx.result(e)
    cx.emit(Ins.CallRt(dst, "avra_array_get", [arr, idx]))
    dst
}

/// A property read, by the subject's shape: a TYPE NAME builds a
/// variant, a struct reads a slot at its declaration index, and
/// only `length` otherwise survives typing.
fn prop_reg(cx: LowerCx, e: ExprId, s: ExprId, name: string) -> Reg {
    let sh: Type = cx.shape_at(s)
    if sh is .TypeName { return variant_reg(cx, e, name) }
    let sig: StructSig? = cx.fields_at(s)
    if sig == null { return length_reg(cx, e, s) }
    let slot: int? = sig!.slot_of(name)
    if slot == null {
        return lower_defect(cx, e, "a fieldless property on a struct survived typing")
    }
    let subject = cx.reg_of(s)
    let idx = cx.mint_shape(Type.Int)
    cx.emit(Ins.ConstInt(idx, slot!))
    let dst = cx.result(e)
    cx.emit(Ins.CallRt(dst, "avra_array_get", [subject, idx]))
    dst
}

/// Constructing a variant: ONE array carrying the tag at slot 0.
/// The type name itself lowers to nothing — it never was a value.
fn variant_reg(cx: LowerCx, e: ExprId, name: string) -> Reg {
    let sig: EnumSig? = cx.variants_at(e)
    if sig == null {
        return lower_defect(cx, e, "a variant construction without an enum type")
    }
    let which: int? = sig!.tag_of(name)
    if which == null {
        return lower_defect(cx, e, variant_defect())
    }
    let dst = cx.result(e)
    cx.emit(Ins.CallRt(dst, "avra_array_new", []))
    let tag = cx.mint_shape(Type.Int)
    cx.emit(Ins.ConstInt(tag, which!))
    cx.emit(Ins.CallRtVoid("avra_array_push", [dst, tag]))
    dst
}

/// Only `length` survives typing, so the property lowers as one
/// runtime call, by the subject's shape.
fn length_reg(cx: LowerCx, e: ExprId, s: ExprId) -> Reg {
    let subject = cx.reg_of(s)
    let dst = cx.result(e)
    let callee = if cx.shape_at(s) is .Str { "strlen" } else { "avra_array_len" }
    cx.emit(Ins.CallRt(dst, callee, [subject]))
    dst
}

fn ident_reg(cx: LowerCx, e: ExprId) -> Reg {
    let def: Reg? = cx.def_reg(e)
    def ?? lower_defect(cx, e, "an unresolved name survived a clean analysis")
}

fn binary_reg(cx: LowerCx, e: ExprId, op: BinOp, l: ExprId, r: ExprId) -> Reg {
    if op == BinOp.And || op == BinOp.Or { return lazy_reg(cx, e, op, l, r) }
    let asked: ExprId? = asked_subject(cx, op, l, r)
    if asked != null { return presence_reg(cx, e, op, asked!) }
    let a = cx.reg_of(l)
    let b = cx.reg_of(r)
    let stringy = cx.shape_at(l) is .Str
    if op == BinOp.Ne && stringy {
        let same = cx.mint(e)
        cx.emit(Ins.CallRt(same, "avra_streq", [a, b]))
        let dst = cx.result(e)
        cx.emit(Ins.Un(dst, UnOp.Not, same))
        return dst
    }
    let dst = cx.result(e)
    if op == BinOp.Eq && stringy {
        cx.emit(Ins.CallRt(dst, "avra_streq", [a, b]))
    } else {
        cx.emit(Ins.Bin(dst, op, a, b))
    }
    dst
}

/// `a && b` is `if a { b } else { false }`; `a || b` is
/// `if a { true } else { b }` — regions, so the taken side alone
/// runs. Registers mint in instruction order at every step.
fn lazy_reg(cx: LowerCx, e: ExprId, op: BinOp, l: ExprId, r: ExprId) -> Reg {
    let a = cx.reg_of(l)
    cx.emit(Ins.IfStart(a))
    if op == BinOp.And {
        let rb = cx.reg_of(r)
        cx.emit(Ins.ArmEnd(rb))
        let short = cx.mint(e)
        cx.emit(Ins.ConstBool(short, false))
        let dst = cx.result(e)
        cx.emit(Ins.RegionEnd(dst, short))
        return dst
    }
    let short = cx.mint(e)
    cx.emit(Ins.ConstBool(short, true))
    cx.emit(Ins.ArmEnd(short))
    let rb = cx.reg_of(r)
    let dst = cx.result(e)
    cx.emit(Ins.RegionEnd(dst, rb))
    dst
}

fn not_reg(cx: LowerCx, e: ExprId, v: ExprId) -> Reg {
    let rv = cx.reg_of(v)
    let dst = cx.result(e)
    cx.emit(Ins.Un(dst, UnOp.Not, rv))
    dst
}

