//! Lowering rules: literals become constants, an ident IS its
//! definition's register (the language is SSA by construction), and
//! eager binaries become one instruction — string `==`/`!=` routes
//! to the runtime's value comparison. The LAZY ops (`&&`/`||`)
//! desugar onto the if-region brackets, so the right side's
//! instructions live inside a branch and short-circuit natively.
use core.{Expr, ExprId, BinOp, UnOp, Reg, Ins}
use features.{LowerCx, StructSig, hole_defect}

fn spine_lower(cx: LowerCx, e: ExprId) -> Reg {
    match cx.store.expr(e) {
        .IntLit(v) -> {
            let dst = cx.result(e)
            cx.emit(Ins.ConstInt(dst, v))
            dst
        }
        .Ident(_) -> ident_reg(cx, e),
        .Binary(op, l, r) -> binary_reg(cx, e, op, l, r),
        .Not(v) -> not_reg(cx, e, v),
        .Index(s, i) -> index_reg(cx, e, s, i),
        .Prop(s, name) -> prop_reg(cx, e, s, name),
        _ -> lower_failed(cx, e, hole_defect()),
    }
}

fn index_reg(cx: LowerCx, e: ExprId, s: ExprId, i: ExprId) -> Reg {
    let arr = cx.reg_of(s)
    let idx = cx.reg_of(i)
    let dst = cx.result(e)
    cx.emit(Ins.CallRt(dst, "avra_array_get", [arr, idx]))
    dst
}

/// A property read: a struct field is a slot read at its
/// declaration index; only `length` otherwise survives typing.
fn prop_reg(cx: LowerCx, e: ExprId, s: ExprId, name: string) -> Reg {
    let sig: StructSig? = cx.fields_at(s)
    if sig == null { return length_reg(cx, e, s) }
    let slot: int? = sig!.slot_of(name)
    if slot == null {
        return lower_failed(cx, e, "defect: a fieldless property on a struct survived typing")
    }
    let subject = cx.reg_of(s)
    let idx = cx.mint_int()
    cx.emit(Ins.ConstInt(idx, slot!))
    let dst = cx.result(e)
    cx.emit(Ins.CallRt(dst, "avra_array_get", [subject, idx]))
    dst
}

/// Only `length` survives typing, so the property lowers as one
/// runtime call, by the subject's shape.
fn length_reg(cx: LowerCx, e: ExprId, s: ExprId) -> Reg {
    let subject = cx.reg_of(s)
    let dst = cx.result(e)
    let callee = if cx.shape_at(s) is .Str { "strlen" } else { "avra_array_len" }
    cx.emit(Ins.CallRt(dst, callee, [subject]))
    dst
}

fn ident_reg(cx: LowerCx, e: ExprId) -> Reg {
    let def: Reg? = cx.def_reg(e)
    def ?? lower_failed(cx, e, "defect: an unresolved name survived a clean analysis")
}

fn binary_reg(cx: LowerCx, e: ExprId, op: BinOp, l: ExprId, r: ExprId) -> Reg {
    if op == BinOp.And || op == BinOp.Or { return lazy_reg(cx, e, op, l, r) }
    let a = cx.reg_of(l)
    let b = cx.reg_of(r)
    let stringy = cx.shape_at(l) is .Str
    if op == BinOp.Ne && stringy {
        let same = cx.mint(e)
        cx.emit(Ins.CallRt(same, "avra_streq", [a, b]))
        let dst = cx.result(e)
        cx.emit(Ins.Un(dst, UnOp.Not, same))
        return dst
    }
    let dst = cx.result(e)
    if op == BinOp.Eq && stringy {
        cx.emit(Ins.CallRt(dst, "avra_streq", [a, b]))
    } else {
        cx.emit(Ins.Bin(dst, op, a, b))
    }
    dst
}

/// `a && b` is `if a { b } else { false }`; `a || b` is
/// `if a { true } else { b }` — regions, so the taken side alone
/// runs. Registers mint in instruction order at every step.
fn lazy_reg(cx: LowerCx, e: ExprId, op: BinOp, l: ExprId, r: ExprId) -> Reg {
    let a = cx.reg_of(l)
    cx.emit(Ins.IfStart(a))
    if op == BinOp.And {
        let rb = cx.reg_of(r)
        cx.emit(Ins.Else(rb))
        let short = cx.mint(e)
        cx.emit(Ins.ConstBool(short, false))
        let dst = cx.result(e)
        cx.emit(Ins.IfEnd(dst, short))
        return dst
    }
    let short = cx.mint(e)
    cx.emit(Ins.ConstBool(short, true))
    cx.emit(Ins.Else(short))
    let rb = cx.reg_of(r)
    let dst = cx.result(e)
    cx.emit(Ins.IfEnd(dst, rb))
    dst
}

fn not_reg(cx: LowerCx, e: ExprId, v: ExprId) -> Reg {
    let rv = cx.reg_of(v)
    let dst = cx.result(e)
    cx.emit(Ins.Un(dst, UnOp.Not, rv))
    dst
}

/// Record the defect and stand on a fresh register — the driver
/// refuses the whole build afterward.
fn lower_failed(cx: LowerCx, e: ExprId, msg: string) -> Reg {
    cx.fail(msg)
    cx.result(e)
}
