//! A bare name in a pattern, computed from the rule's one label.
use core.{Expr, Pat, Scoped, Slots, Built, computed}

/// A bare name binds — except `rest`, the spec's deliberate remainder,
/// and `null`, a LITERAL never a binder: read as `Pat.Bind` it earns the
/// keyword refusal beside whatever else the arm earns, one mistake
/// wearing two voices.
@computed
fn bind_written(s: dyn Slots) -> Result<Built, string> {
    let store = s.arena()
    let name = s.text_of("name")?
    let pat: Pat = when {
        name == "rest" -> Pat.Rest
        name == "null" -> Pat.Lit(store.alloc_expr(Expr.NullLit, s.built_at()))
        _ -> Pat.Bind(Scoped(name))
    }
    .Ok(Built.Pat(store.alloc_pat(pat, s.built_at())))
}
