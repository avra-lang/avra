//! check.av, lowering rules in lower.av.
use core.{Expr, ExprId, TypeId, Reg}
use features.{NodeSemantics, ResolveCx, TypeCx, LowerCx, nothing}

export type SpineSemantics = { }

impl NodeSemantics for SpineSemantics {
    fn kids(self, e: Expr) -> List<ExprId> {
        // LICENSED I22: a feature cannot enumerate OTHER features' variants (the isolation doctrine); its own are listed
        match e {
            .Binary(_, l, r) -> [l, r],
            .Index(s, i) -> [s, i],
            .Not(v) -> [v],
            .Prop(s, _) -> [s],
            _ -> [],
        }
    }

    fn resolve(self, cx: ResolveCx, e: ExprId) {
        match cx.store.expr(e) {
            .Ident(name) -> cx.use_name(e, name),
            _ -> nothing(),
        }
    }

    fn type_of(self, cx: TypeCx, e: ExprId) -> TypeId {
        spine_type(cx, e)
    }

    fn lower(self, cx: LowerCx, e: ExprId) -> Reg {
        spine_lower(cx, e)
    }

}
