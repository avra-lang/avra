//! The spine's dispatch: typing rules live in check.av, lowering
//! rules in lower.av.
use core.{ExprId, TypeId, Reg, Ins}
use features.{NodeSemantics, ResolveCx, TypeCx, LowerCx, nothing, Meaning}

use core.expr.{IntLit, FloatLit, Ident, Binary, Not, Index, Prop, Error, Env}

impl NodeSemantics for Binary {
    fn kids() -> List<ExprId> { [self.l, self.r] }
}
impl NodeSemantics for Index {
    fn kids() -> List<ExprId> { [self.subject, self.index] }
}
impl NodeSemantics for Not {
    fn kids() -> List<ExprId> { [self.value] }
}
impl NodeSemantics for Prop {
    fn kids() -> List<ExprId> { [self.subject] }
}
impl NodeSemantics for IntLit {}
impl NodeSemantics for FloatLit {}
impl NodeSemantics for Ident {}
impl NodeSemantics for Error {}
impl NodeSemantics for Env {}

impl Meaning for IntLit {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        cx.type(int)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        cx.const_int_at(e, self.value)
    }
}
impl Meaning for FloatLit {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        cx.type(float)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        // A real has its OWN constant: the variant is the type, so an
        // instruction never means one thing here and another there.
        let dst = cx.result(e)
        cx.emit(Ins.ConstFloat(dst, self.bits))
        dst
    }
}
impl Meaning for Ident {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        cx.use_name(e, self.name.of)
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        cx.warn_use(e)
        cx.target_type(e)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        ident_reg(cx, e)
    }
}
impl Meaning for Binary {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        binary_type(cx, e, self.op, self.l, self.r)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        binary_reg(cx, e, self.op, self.l, self.r)
    }
}
impl Meaning for Not {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        not_type(cx, self.value)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        not_reg(cx, e, self.value)
    }
}
impl Meaning for Index {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        index_type(cx, self.subject, self.index)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        index_reg(cx, e, self.subject, self.index)
    }
}
impl Meaning for Prop {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        prop_type(cx, e, self.subject, self.name.of)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        prop_reg(cx, e, self.subject, self.name.of)
    }
}
impl Meaning for Error {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        cx.error_type
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        cx.foreign_node(e)
    }
}
impl Meaning for Env {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        cx.error_type
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        cx.foreign_node(e)
    }
}
