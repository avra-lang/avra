//! The spine's dispatch: typing rules live in check.av, lowering
//! rules in lower.av.
use core.{Minting, minting, ExprId, TypeId, Reg, Ins, Expr, BinOp, Span, SyntaxArena, op_symbol}
use features.{ResolveCx, TypeCx, LowerCx, MeanCx, nothing, Meaning}
use @std.meta.{Rewrite}

use core.expr.{IntLit, FloatLit, Ident, Binary, Not, Bitnot, Neg, Pipe, Index, Prop, Error, Env}

impl Meaning for IntLit {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        cx.type(int)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        cx.const_int_at(e, self.value)
    }
}
impl Meaning for FloatLit {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        cx.type(float)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        // A real has its OWN constant: the variant is the type, so an
        // instruction never means one thing here and another there.
        let dst = cx.result(e)
        cx.emit(Ins.ConstFloat(dst, self.bits))
        dst
    }
}
impl Meaning for Ident {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        cx.use_name(e, self.name.of)
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        cx.warn_use(e)
        cx.target_type(e)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        ident_reg(cx, e)
    }
}
impl Meaning for Binary {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        binary_type(cx, e, self.op, self.left, self.right)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        binary_reg(cx, e, self.op, self.left, self.right)
    }
}
impl Meaning for Not {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        not_type(cx, self.value)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        not_reg(cx, e, self.value)
    }
}
impl Meaning for Bitnot {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        cx.meant_type(e)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        cx.meant_reg(e)
    }
    fn means(cx: MeanCx) -> Result<Rewrite, string>? {
        .Ok(quote { ${self.value} ^ -1 })
    }
}
impl Meaning for Neg {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        cx.meant_type(e)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        cx.meant_reg(e)
    }
    fn minted(cx: MeanCx) -> Result<Minting, string> {
        let before = cx.store.exprs.count()
        let root = cx.store.negated(self.value, cx.span)
        .Ok(minting(cx.store.allocated_since(before, root)))
    }
}
impl Meaning for Pipe {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        cx.meant_type(e)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        cx.meant_reg(e)
    }
    fn minted(cx: MeanCx) -> Result<Minting, string> {
        let piped = cx.store.piped_nodes(self.stage, self.value)
        if !piped.is_empty() { return .Ok(minting(piped)) }
        let op? = stage_operator(cx.store.expr(self.stage)) else { return .Err(stage_is_a_call()) }
        .Err(operator_after_stage(op_symbol(op)))
    }
}

/// The operator a stage is, when the climb grouped one under the pipe.
fn stage_operator(stage: Expr) -> BinOp? {
    match stage { .Binary(op, _, _) -> op, _ -> null }
}

impl Meaning for Index {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        index_type(cx, self.subject, self.index)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        index_reg(cx, e, self.subject, self.index)
    }
}
impl Meaning for Prop {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        prop_type(cx, e, self.subject, self.name.of)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        prop_reg(cx, e, self.subject, self.name.of)
    }
}
impl Meaning for Error {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        cx.error_type
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        cx.foreign_node(e)
    }
}
impl Meaning for Env {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        cx.error_type
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        cx.foreign_node(e)
    }
}

// ── voices ──

fn stage_is_a_call() -> string {
    "a pipe's right side is a call, and the piped value becomes its first argument — `x |> f`, `x |> f(a)`, `x |> a.m(b)`, `x |> ((v) -> …)`; a method on the value itself is `x.m()`"
}

fn operator_after_stage(op: string) -> string {
    "a pipe's right side is a call, and `|>` binds looser than `${op}` — write `(x |> f) ${op} …` to pipe first"
}

impl SyntaxArena {
    /// `-value`: a literal folds — `-1` and `-1.5` ARE literals, so a
    /// const takes them and every reader of the value protocol gets one —
    /// and any other value is `0 - value`.
    fn negated(value: ExprId, span: Span?) -> ExprId {
        let held = self.valued(value)
        let n: int? = held.int_of()
        if n != null { return self.alloc_expr(Expr.IntLit(0 - n!), span) }
        let bits: int? = held.bits_of()
        if bits != null { return self.alloc_expr(Expr.FloatLit(bits! ^ (1 << 63)), span) }
        self.alloc_expr(Expr.Binary(BinOp.Sub, self.alloc_expr(Expr.IntLit(0), span), value), span)
    }
}
