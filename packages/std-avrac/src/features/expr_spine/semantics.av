//! The spine's NodeSemantics: dispatch only. Typing rules live in
//! check.av, evaluation rules in eval.av.
use core.{Expr, ExprId, TypeId, NodeStore}
use features.{NodeSemantics, ResolveCx, TypeCx, EvalCx, nothing}

export type SpineSemantics = { }

impl NodeSemantics for SpineSemantics {
    fn kids(self, e: Expr) -> List<ExprId> {
        match e {
            .Binary(_, l, r) -> [l, r],
            _ -> [],
        }
    }

    fn resolve(self, cx: ResolveCx, e: ExprId) {
        match cx.store.expr(e) {
            .Ident(name) -> cx.use_name(e, name),
            _ -> nothing(),
        }
    }

    fn type_of(self, cx: TypeCx, e: ExprId) -> TypeId {
        spine_type(cx, e)
    }

    fn eval(self, cx: EvalCx, e: ExprId) -> ExprId {
        spine_eval(cx, e)
    }

    fn printed(self, store: NodeStore, e: ExprId) -> string? {
        match store.expr(e) {
            .IntLit(v) -> "${v}",
            _ -> null,
        }
    }
}
