//! `File` and `Module` — the workspace's identity relations. Every file
//! and module the compiler admits gets one row here, minted once at
//! `Decls.file_id`/`module_id`, read everywhere else through the
//! relation's own accessors, never through a hand-kept table. `id` is
//! `@dense`, so it names a slot in this process alone; `File.module`
//! carries the same limit (`ModuleId` is `@dense` too) and is marked
//! `@local` beside its `@index` — the number means nothing to a later
//! process, but the process that minted it asks "which files does this
//! module hold" constantly, which is what the index buys.
use core.{FileId, ModuleId}
use @std.relation.{relation}

@relation
export type File = {
    id: FileId,
    @index path: string,
    /// Its name: its package, then its path within it, as written.
    name: string,
    @local @index module: ModuleId,
    test: bool,
}

@relation
export type Module = {
    id: ModuleId,
    @index name: string,
}
