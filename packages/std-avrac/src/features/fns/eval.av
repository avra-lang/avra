//! The call's evaluation rule: argument values first, then the
//! driver runs the target body under a fresh frame.
use core.{Expr, ExprId}
use features.{EvalCx}

fn call_eval(cx: EvalCx, e: ExprId) -> ExprId {
    match cx.store.expr(e) {
        .Call(_, args) -> {
            let vals = [cx.value_at(a) for a in args]
            cx.invoke(e, vals)
        }
        _ -> e,
    }
}
