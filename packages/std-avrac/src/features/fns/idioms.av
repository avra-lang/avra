//! The formatter's idioms for this feature — `rule`s, reached by
//! this feature's `mod.av`, the way any declaration is.
use features.{Code, Fix, rule, said}

/// A parameter nothing reads — the signature lies about what the fn
/// needs, and every call site carries the lie. `dead_params()`
/// (features/code.av) already exempts a contract-bound member (a
/// `trait` signature or an `impl Trait for` method — the TRAIT owns
/// the seat count) and a bodiless declaration.
///
/// A BARE-HOLE ROOT: a `FnDecl`'s own name is not a seat this
/// matcher can hold open at all (`own_name_at`'s catalog omits it,
/// core/shape.av) — the attempt refuses as `type.quote_pat_seat`,
/// naming a let/for/const binder, a bind pattern, a variant test, a
/// call's callee, a method or a field name as the whole list.
/// `dead_params` reads the signature structurally off `self` instead.
///
/// NO REWRITE: dropping a dead parameter from the signature would
/// leave every call site an arity short — this is a whole-program
/// edit `callers()` (features/code.av, THE REFERENCES RELATION)
/// could drive, not a single node's to make alone.
@keeps("fn f(a: int) -> int { a }")
@keeps("impl S {\n    static fn make(a: int, b: int) -> int { a + b }\n}\ntype S = { n: int }")
export rule dead_parameter { quote { ${f} } if !f.dead_params().is_empty() -> dead_parameter_found(f) }

fn dead_parameter_found(f: Code) -> Fix {
    Fix.Say(said(f.loc(), "never read: ${f.dead_params().join(", ")}", "this signature", null))
}
