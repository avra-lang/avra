//! The call's NodeSemantics: dispatch only. Typing lives in
//! check.av; lowering — the MEANING — in lower.av. The FnDecl
//! STATEMENT's semantics live in stmt.av.
use core.{Expr, ExprId, TypeId, Reg}
use features.{NodeSemantics, ResolveCx, TypeCx, LowerCx, nothing}

export type FnsSemantics = { }

impl NodeSemantics for FnsSemantics {
    fn kids(self, e: Expr) -> List<ExprId> {
        match e {
            .Call(_, _, args) -> args,
            _ -> [],
        }
    }

    fn heirs(self, e: Expr) -> List<ExprId> {
        []
    }

    fn resolve(self, cx: ResolveCx, e: ExprId) {
        match cx.view.store.expr(e) {
            .Call(callee, _, _) -> cx.use_call(e, callee),
            _ -> nothing(),
        }
    }

    fn type_of(self, cx: TypeCx, e: ExprId) -> TypeId {
        call_type(cx, e)
    }

    fn lower(self, cx: LowerCx, e: ExprId) -> Reg {
        call_lower(cx, e)
    }

}
