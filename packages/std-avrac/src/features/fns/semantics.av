//! The call's NodeSemantics: dispatch only. Typing lives in
//! check.av; lowering — the MEANING — in lower.av. The FnDecl
//! STATEMENT's semantics live in stmt.av.
use core.{Expr, ExprId, TypeId, Reg}
use features.{NodeSemantics, ResolveCx, TypeCx, LowerCx, nothing, Meaning}

use core.expr.{Call, Named}

export type FnsSemantics = {}

impl NodeSemantics for FnsSemantics {
    fn kids(e: Expr) -> List<ExprId> {
        match e { .Call(_, _, args) -> args, .Named(_, value) -> [value], rest -> [] }
    }

    // a named argument is its value, so a want planted on it reaches the value
    fn heirs(e: Expr) -> List<ExprId> {
        match e { .Named(_, value) -> [value], _ -> [] }
    }

}

impl Meaning for Call {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        cx.use_call(e, self.callee.of)
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        cx.warn_use(e)
        let sig? = cx.sig_of(e) else {
            return cx
                .settled_call(e, self.args, valued_call(cx, e, self.callee.of, self.pins, self.args))
        }
        cx
            .settled_call(e, self.args, dispatched_call(cx, e, self.callee.of, self.pins, self.args, sig))
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        let host: string? = cx.extern_callee(e)
        if host != null { return extern_call_reg(cx, e, host!, host_regs(cx, e, self.args)) }
        let hashed: Reg? = code_hash_reg(cx, e, self.args)
        if hashed != null { return hashed! }
        let regs = embedded_regs(cx, e, self.args) ?? call_arg_regs(cx, e, self.args)
        let made: Reg? = named_reg(cx, e, regs)
        if made != null { return made! }
        let through: Reg? = cx.indirect_callee(e)
        if through != null { return valued_call_reg(cx, e, through!, regs) }
        // THE MINT LAW: the defaults' registers first, the answer last
        let seated = seated_left(cx, e, self.args, regs)
        cx.call_decl_at(e, cx.callee_of(e, self.callee.of), seated)
    }
}
impl Meaning for Named {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        cx.type_at(self.value)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        cx.reg_of(self.value)
    }
}
