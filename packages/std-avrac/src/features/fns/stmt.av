//! The fn declaration's StmtSemantics: at top level the body walks
//! under its OWN params; inside a block it refuses. Its runtime
//! value is nothing — the body runs at call time, and lowering
//! collects declarations on its own axis.
use core.{StmtId, Reg}
use features.{StmtSemantics, StmtResolveCx, StmtTypeCx, StmtLowerCx, nothing, refuses_nested}

export type FnStmtSemantics = { }

impl StmtSemantics for FnStmtSemantics {
    fn resolve_stmt(cx: StmtResolveCx, s: StmtId) {
        if refuses_nested(cx, s, "resolve.nested_fn", "fn declarations") { return }
        match cx.view.store.stmt(s) {
            .FnDecl(_, _, fparams, _, body) -> {
                cx.check_params(fparams, s)
                cx.walk_under(fparams, body)
            }
            _ -> nothing(),
        }
    }

    fn type_stmt(cx: StmtTypeCx, s: StmtId) {
        check_fn(cx, s)
    }

    fn lower_stmt(cx: StmtLowerCx, s: StmtId) -> Reg? {
        null
    }
}

/// The return statement's semantics: the value walks, the fn's
/// declared answer judges it, lowering exits at the site.
export type ReturnSemantics = { }

impl StmtSemantics for ReturnSemantics {
    fn resolve_stmt(cx: StmtResolveCx, s: StmtId) {
        cx.walk_value(s)
    }

    fn type_stmt(cx: StmtTypeCx, s: StmtId) {
        check_return(cx, s)
    }

    fn lower_stmt(cx: StmtLowerCx, s: StmtId) -> Reg? {
        lower_return(cx, s)
    }
}
