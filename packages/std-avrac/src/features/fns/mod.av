//! Functions — `fn name(a: int) -> int { <expr> }` and direct calls.
//! The decl is a keyword-anchored statement; the call branch merges
//! into `primary` BEFORE the spine's bare NAME, and the executor's
//! backtracking sends `f(x)` here while `f` alone falls through.
use features.{LanguageFeature, BuilderRow}
use grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use diagnostics.{DiagCode}

export fn fns() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name          | build
        "fn_decl"     | build_fn
        "once_fn"     | build_once_fn
        "extern_fn"   | build_extern
        "call"        | build_call
        "pinned_call" | build_pinned_call
        "return_stmt" | build_return
    }
    let codes = table<DiagCode> {
        kind                   | id      | summary
        "type.duplicate_param" | "F2020" | "a fn's parameters have distinct names"
        "type.unknown"         | "F2001" | "a type annotation names no known type"
        "resolve.duplicate_fn" | "F3003" | "two fns share one name"
        "resolve.nested_fn"    | "F3004" | "fn declarations live at the top level"
        "type.return"          | "F2025" | "`return` answers the enclosing fn"
        "type.once_fn"         | "F2055" | "a `once` fn takes no arguments and answers a value the runtime owns"
        "type.const_seat"      | "F2073" | "a `const` seat is filled by a value that settles at compile time"
        "type.host_seat"       | "F2056" | "a `mut` host seat wears a cell C may write, and is handed a local"
        "type.row_shape"       | "F2084" | "an extern that names a runtime row wears the row's shape — its seat count, and the box each pointer seat reads"
        "type.host_absence"    | "F2088" | "a runtime row's seat takes no absence — core's C reads every pointer it is handed"
        "type.extern_value"    | "F2103" | "an extern fn is a C symbol, not a value — wrap it to hand it around"
        "type.named_arg"       | "F2105" | "a named argument writes a seat its callee declares, once — only a declared fn's, method's or static's seats have names"
        "type.param_default"   | "F2104" | "a default fills a plain seat whose type names no type parameter, after every seat without one, and its seat accepts it"
        "type.isolated"        | "F2111" | "an `isolated` seat takes a fn that shares nothing with its caller — a lambda capturing no identity, a declared fn, or an `isolated` parameter"
    }
    LanguageFeature fns {
        gram: grammar {
            stmt = "extern" "fn" n:NAME "(" ( ( ck:"const" )? ( mk:"mut" )? ps:NAME ":" pt:type ( "," ( ck:"const" )? ( mk:"mut" )? ps:NAME ":" pt:type )* ","? )? ")" ( "->" r:type )? END @recover(sync_to: "END") -> extern_fn(n, ck, mk, ps, pt, r)
            stmt = "fn" n:NAME ( "<" tp:NAME ( ":" tb:NAME )? ( "," tp:NAME ( ":" tb:NAME )? )* ","? ">" )? "(" ( ( ck:"const" )? ( mk:"mut" )? ( ik:"isolated" )? ps:NAME ( ":" pt:type )? ( "=" pd:expression )? ( "," ( ck:"const" )? ( mk:"mut" )? ( ik:"isolated" )? ps:NAME ( ":" pt:type )? ( "=" pd:expression )? )* ","? )? ")" ( "->" r:type )? b:block END @recover(sync_to: "END") -> fn_decl(n, tp, tb, ck, mk, ps, pt, pd, r, b, ik)
            stmt = "once" "fn" n:NAME "(" ( ( ck:"const" )? ( mk:"mut" )? ps:NAME ( ":" pt:type )? ( "," ( ck:"const" )? ( mk:"mut" )? ps:NAME ( ":" pt:type )? )* ","? )? ")" ( "->" r:type )? b:block END @recover(sync_to: "END") -> once_fn(n, ck, mk, ps, pt, r, b)
            stmt = "return" ( v:expression )? END @recover(sync_to: "END") -> return_stmt(v)
            primary = c:NAME "<" pin:type ( "," pin:type )* ","? ">" "(" ( as:argument ( "," as:argument )* ","? )? ")" -> pinned_call(c, pin, as)
            primary = c:NAME "(" ( as:argument ( "," as:argument )* ","? )? ")" @expect(")", "expected `)` to close the arguments") -> call(c, as)
        }
        builders: rows
        diags: codes
    }
    fns
}
