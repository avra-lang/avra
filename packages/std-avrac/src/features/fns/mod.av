//! Functions — `fn name(a: int) -> int { <expr> }` and direct calls.
//! The decl is a keyword-anchored statement; the call branch merges
//! into `primary` BEFORE the spine's bare NAME, and the executor's
//! backtracking sends `f(x)` here while `f` alone falls through.
use features.{LanguageFeature, BuilderRow}
use grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use diagnostics.{DiagCode}

export fn fns() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name          | build
        "fn_decl"     | build_fn
        "extern_fn"   | build_extern
        "call"        | build_call
        "pinned_call" | build_pinned_call
        "return_stmt" | build_return
    }
    let codes = table<DiagCode> {
        kind                   | id      | summary
        "type.duplicate_param" | "F2020" | "a fn's parameters have distinct names"
        "type.unknown"         | "F2001" | "a type annotation names no known type"
        "resolve.duplicate_fn" | "F3003" | "two fns share one name"
        "resolve.nested_fn"    | "F3004" | "fn declarations live at the top level"
        "type.return"     | "F2025" | "`return` answers the enclosing fn"
    }
    component LanguageFeature f {
        name = "fns"
        docs = "`fn name(params) -> type { expression }` — generic with `fn name<T>(…)`, one abstract check, one lowering per instantiation; a `mut` parameter is a seat the fn writes through, filled by a `mut` place; calls `name(args)`, `name<int>(args)` pinning what arguments cannot; `return` answers early."
        gram = grammar {
            stmt = "extern" "fn" n:NAME "(" ( ps:NAME ":" pt:type ( "," ps:NAME ":" pt:type )* ","? )? ")" ( "->" r:type )? END @recover(sync_to: "END") -> extern_fn(n, ps, pt, r)
            stmt = "fn" n:NAME ( "<" tp:NAME ( ":" tb:NAME )? ( "," tp:NAME ( ":" tb:NAME )? )* ","? ">" )? "(" ( ( mk:"mut" )? ps:NAME ( ":" pt:type )? ( "," ( mk:"mut" )? ps:NAME ( ":" pt:type )? )* ","? )? ")" ( "->" r:type )? b:block END @recover(sync_to: "END") -> fn_decl(n, tp, tb, mk, ps, pt, r, b)
            stmt = "return" ( v:expression )? END @recover(sync_to: "END") -> return_stmt(v)
            primary = c:NAME "<" pin:type ( "," pin:type )* ","? ">" "(" ( as:expression ( "," as:expression )* ","? )? ")" -> pinned_call(c, pin, as)
            primary = c:NAME "(" ( as:expression ( "," as:expression )* ","? )? ")" @expect(")", "expected `)` to close the arguments") -> call(c, as)
        }
        builders = rows
        diags = codes
    }
    f
}
