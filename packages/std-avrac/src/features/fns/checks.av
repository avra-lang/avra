//! The typing rules of a call and `return`. A call: each argument checks against its seat, and the
//! call is what the fn answers. A declared fn's type parameters are the call's, filled by its
//! arguments (`Checking.fills`); a fn the body holds names the body's own, which nothing fills.
use core.{Checking, Checks, ExprId, Expected, SignedType, StmtChecks, StmtId, TypeHead}
use core.expr.{Call, Named}
use core.stmt.{FnDecl, Return}

impl Checks for Call {
    fn checked(mut cx: Checking, e: ExprId, expected: Expected) -> SignedType? {
        let callee = cx.read(self.callee.of)
        let f? = callee else { return free_args(cx, self.args) }
        if !(f.head is .Function) || cx.seats_filled(f, self.args.length) == null { return free_args(cx, self.args) }
        if cx.local(self.callee.of) != null { return cx.rigidly_called(f, self.args) }
        if self.pins.is_empty() { return cx.called(f, self.args, expected) }
        mut pinned: Map<string, SignedType> = {}
        for at, pin in self.pins { pinned.set("${at}", cx.written(pin)) }
        let found? = cx
            .fills(
                [s.ty for s in cx.seats_filled(f, self.args.length)!],
                self.args,
                pinned,
                f.answer,
                expected,
            ) else { return null }
        let answer? = f.answer else { return null }
        if answer.fills_all(found) { answer.filled(found) } else { null }
    }
}

impl StmtChecks for Return {
    /// `return` checks its value against what the fn answers.
    fn stmt_checked(mut cx: Checking, s: StmtId) {
        let value? = self.value else { return }
        let _ = cx
            .check(value, if cx.answer != null { Expected.Exactly(cx.answer!) } else { Expected.Free })
    }
}

/// Every argument checked against nothing, and the call unchecked.
fn free_args(mut cx: Checking, args: List<ExprId>) -> SignedType? {
    cx.checked_free(args)
    null
}

impl StmtChecks for FnDecl {
    /// A fn declared in a body binds its name there; its own body is typed as its own declaration.
    fn stmt_checked(mut cx: Checking, s: StmtId) { cx.bind(self.name.of, null) }
}

impl Checks for Named {
    /// A named argument is its value, checked against what its seat wants.
    fn checked(mut cx: Checking, e: ExprId, expected: Expected) -> SignedType? { cx.check(self.value, expected) }
}
