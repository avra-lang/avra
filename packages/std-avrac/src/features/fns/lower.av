//! The call's lowering rule: argument registers, then one Call —
//! the memory pass owns the retains the ABI demands.
use core.{ExprId, Reg, Ins, StmtId, DeclId, SeatMark, TypeId, Arrow, mut_mark, state_mark, no_marks}
use features.{LowerCx, bound_decl_of}

fn call_lower(mut cx: LowerCx, e: ExprId) -> Reg {
    match cx.view.store.expr(e) {
        .Named(_, value) -> cx.reg_of(value),
        .Call(callee, _, args) -> {
            let host: string? = cx.extern_callee(e)
            if host != null { return extern_call_reg(cx, e, host!, host_regs(cx, e, args)) }
            let regs = call_arg_regs(cx, e, args)
            let made: Reg? = named_reg(cx, e, regs)
            if made != null { return made! }
            let through: Reg? = cx.indirect_callee(e)
            if through != null { return valued_call_reg(cx, e, through!, regs) }
            // THE MINT LAW: the defaults' registers first, the answer last
            let seated = seated_left(cx, e, args, regs)
            cx.call_decl_at(e, cx.callee_of(e, callee.of), seated)
        },
        rest -> cx.foreign_node(e),
    }
}

/// A call's argument registers, a `state` seat handed its caller's
/// CELL where every other seat is handed a value. The marks come
/// from the DECLARATION when one stands behind the callee, and from
/// the fn value's own type otherwise — the same seats typing judged.
fn call_arg_regs(mut cx: LowerCx, e: ExprId, args: List<ExprId>) -> List<Reg> {
    let marks = call_marks(cx, e, args.length)
    [if state_mark(marks, j) { state_seat_reg(cx, a) } else { cx.reg_of(a) } for j, a in args]
}

/// A `state` seat's argument register: the caller's cell. Typing held
/// the seat to a `state` place, so absence here is a DEFECT — never a
/// value default, which hands the callee a register its body reads as
/// a Cell.
fn state_seat_reg(mut cx: LowerCx, a: ExprId) -> Reg {
    let cell? = cx.state_arg_cell(a) else { return cx.lower_defect(a, "a `state` seat without a place survived typing") }
    cell
}

/// The seat marks a call judges: a declared callee's own, or the fn
/// value's type where none stands behind it.
fn call_marks(cx: LowerCx, e: ExprId, n: int) -> List<SeatMark> {
    let d? = bound_decl_of(cx.names, e) else { return indirect_marks(cx, e, n) }
    cx.view.decls.marks_of(d, n)
}

/// A fn value's marks — the arrow its binding wears. A binding with no
/// arrow has no marked seats.
fn indirect_marks(cx: LowerCx, e: ExprId, n: int) -> List<SeatMark> {
    let b? = cx.names.binding(e) else { return no_marks(n) }
    let fnty: TypeId? = match b {
        .Def(s) -> cx.def_ty(s),
        .Capture(lam, j) -> cx.capture_ty(lam, j),
        .Param(_) or .Receiver or .Pattern(_, _) or .LambdaParam(_, _) or .Index(_) or .Decl(_) -> null,
    }
    if fnty == null { return no_marks(n) }
    let held: Arrow? = cx.view.decls.types.arrow_parts(fnty!)
    held?.marks ?? no_marks(n)
}

/// A direct call's registers in its callee's seat order.
fn seated_left(mut cx: LowerCx, e: ExprId, args: List<ExprId>, regs: List<Reg>) -> List<Reg> {
    let d? = bound_decl_of(cx.names, e) else { return regs }
    cx.seated_regs(e, d, args, regs)
}

/// A NAMED TYPE'S CONSTRUCTION — `UserId(5)`: the name is free at
/// runtime, so the value IS the argument and one Pack gives the
/// register the NAME's type, which each engine renders as identity.
/// Absent when the callee is no named type.
fn named_reg(mut cx: LowerCx, e: ExprId, regs: List<Reg>) -> Reg? {
    let bound? = bound_decl_of(cx.names, e) else { return null }
    let d: DeclId? = cx.view.decls.named_by(bound)
    if d == null || !cx.view.decls.is_named(d!) { return null }
    if regs.length != 1 { return cx.lower_defect(e, "a named type built from no single value survived typing") }
    cx.packed(e, regs)
}

/// A host call's arguments. A `mut` seat takes the ADDRESS of the
/// caller's cell — an Avra `mut` seat writes through the shared box,
/// and a C callee has no box, so the cell IS the mechanism — and
/// every other seat takes the value. The declaration law already
/// held the seat to a shape a cell can wear, and the call law to a
/// LOCAL binding, so the cell is there.
fn host_regs(mut cx: LowerCx, e: ExprId, args: List<ExprId>) -> List<Reg> {
    let marks = host_marks(cx, e, args.length)
    [seat_reg(cx, a, mut_mark(marks, j)) for j, a in args]
}

/// The register a seat is handed. An inout seat takes the CELL, and
/// the two host-seat laws guarantee there is one — so absence here
/// is the compiler's own defect, never the value as a fallback,
/// which would hand C a copy and lose every write it makes.
fn seat_reg(mut cx: LowerCx, a: ExprId, inout: bool) -> Reg {
    if !inout { return cx.reg_of(a) }
    let cell? = cx.cell_of(a) else { return cx.lower_defect(a, "a `mut` host seat with no cell behind it") }
    cell
}

/// The callee's declared marks for this call's seats.
fn host_marks(cx: LowerCx, e: ExprId, n: int) -> List<SeatMark> {
    let d? = bound_decl_of(cx.names, e) else { return [] }
    cx.view.decls.marks_of(d, n)
}

/// The indirect path: through the box, which rides seat 0 —
/// exactly as `self` does.
fn valued_call_reg(mut cx: LowerCx, e: ExprId, box: Reg, regs: List<Reg>) -> Reg {
    cx.called_through(e, box, regs)
}

/// `return v`: the value's register exits the fn HERE — the open
/// frames' `defer`s run first, and the memory pass settles every
/// open scope's debts before the exit. Answers no statement value:
/// the driver's last-value tracking never sees a return.
export fn lower_return(mut cx: LowerCx, s: StmtId) -> Reg? {
    let v: Reg? = cx.lower_value(s)
    cx.leaving(v)
    cx.emit(Ins.FnExit(v ?? cx.hollow_of(cx.type(void))))
    null
}

/// A call across the host seam: the extern's bare symbol as a
/// runtime call — void ones answer nothing.
fn extern_call_reg(mut cx: LowerCx, e: ExprId, symbol: string, regs: List<Reg>) -> Reg {
    if cx.shape_at(e) is .Void {
        cx.emit(Ins.CallRtVoid(symbol, regs))
        return cx.zero(e)
    }
    let dst = cx.result(e)
    cx.emit(Ins.CallRt(dst, symbol, regs))
    dst
}
