//! The call's lowering rule: argument registers, then one Call —
//! the memory pass owns the retains the ABI demands.
use core.{ExprId, Reg, Ins}
use features.{LowerCx, called_through, foreign_node}

fn call_lower(cx: LowerCx, e: ExprId) -> Reg {
    match cx.view.store.expr(e) {
        .Call(callee, _, args) -> {
            let regs = [cx.reg_of(a) for a in args]
            let through: Reg? = cx.indirect_callee(e)
            if through != null { return valued_call_reg(cx, e, through!, regs) }
            let dst = cx.result(e)
            cx.emit(Ins.Call(dst, cx.callee_of(e, callee), regs))
            dst
        }
        _ -> foreign_node(cx, e),
    }
}

/// The indirect path: through the box, which rides seat 0 —
/// exactly as `self` does.
fn valued_call_reg(cx: LowerCx, e: ExprId, box: Reg, regs: List<Reg>) -> Reg {
    called_through(cx, e, box, regs)
}

/// `return v`: the value's register exits the fn HERE — the memory
/// pass settles every open scope's debts before the exit. Answers
/// no statement value: the driver's last-value tracking never sees
/// a return.
export fn lower_return(cx: StmtLowerCx, s: StmtId) -> Reg? {
    let v: Reg? = cx.lower_value(s)
    if v == null { return null }
    cx.expr.emit(Ins.FnExit(v!))
    null
}
