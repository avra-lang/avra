//! The fn feature's typing rules. The call: the target's signature
//! is the law — arity exact, every argument matching its param; the
//! declared return answers either way; Error arguments absorb. The
//! declaration: the body types under its params AND its type
//! parameters — checked ONCE, abstractly (a T can only move). A
//! generic call INSTANTIATES: pins pre-fill, arguments unify, a
//! fully-bound param falls back to the ordinary assignment law, and
//! the representation laws re-judge every substituted slot.
use core.{ExprId, StmtId, TypeId, Arrow, TypeRef, spelled, DeclId, Param, Binding, SeatMark, mut_mark}
use features.{no_pins, Pins, TypeCx, FnSig, nothing, this_is, tparams_refused, unpinned_of, slice_promise, type_name_decl}
use diagnostics.{refusal}

export fn check_fn(mut cx: TypeCx, s: StmtId) {
    match cx.view.store.stmt(s) {
        .FnDecl(fname, _, _, fret, body) -> checked_fn(cx, s, fname.of, fret, body),
        .ExternFn(hname, hparams, _) -> checked_extern(cx, s, hname.of, hparams),
        rest -> nothing(),
    }
}

/// THE HOST INOUT LAW at the DECLARATION: a `mut` seat hands C the
/// ADDRESS of the caller's cell, so the cell's machine shape IS the
/// contract, and only a few shapes line up. A MANAGED value is out —
/// C cannot keep the refcount contract a box demands. A NARROW WIDTH
/// is out — the cell is 64 bits and a 32-bit write through it leaves
/// the top half stale, which is B3's defect wearing the other hat.
fn checked_extern(mut cx: TypeCx, s: StmtId, hname: string, hparams: List<Param>) {
    for j, pp in hparams {
        if pp.promises.mutable && !inout_able(pp.ty) { seat_not_inout_able(cx, s, hname, j, pp) }
    }
}

/// The types a `mut` extern seat may wear, by the word the seat
/// WROTE. A `ptr` cell is a `void**` to C and `ptr?` is its twin
/// with absence; an INTEGER cell must name its WIDTH, and a bare
/// `int` is refused there though it is fine everywhere else.
///
/// THE REASON A BARE `int` IS REFUSED, which is the whole of this
/// law: an integer inout is correct for an `int64_t*` and SILENTLY
/// WRONG for an `int*`, and nothing at the seat distinguishes them.
/// Measured on one C body through both spellings — `int` answers
/// 4294967295 where `i32` answers -1. A seat that is right for three
/// prototypes and wrong for nineteen must make the author say which,
/// and `i64` is how they say "the wide one" out loud.
fn inout_able(t: TypeRef?) -> bool {
    let written: TypeRef? = t
    if written == null { return false }
    ["ptr", "i64", "i32", "u32"].contains(written!.name)
}

fn checked_fn(mut cx: TypeCx, s: StmtId, fname: string, fret: TypeRef, body: ExprId) {
    let sig: FnSig? = cx.stmt_sig(s)
    cx.walk_under(s, body)
    let want: TypeId = sig?.ret ?? cx.error_type
    let got: TypeId = cx.type_at(body)
    // a body that did not parse has spoken already; its answer is
    // whatever the hole left, not a second mistake
    if !cx.accepts(body, want) && !holds_error(cx, body) { body_disagrees(cx, body, fname, fret, got) }
}

/// Whether a body's statements hold a parse recovery.
fn holds_error(cx: TypeCx, body: ExprId) -> bool {
    let stmts: List<StmtId> = match cx.view.store.expr(body) { .Block(ss, _) -> ss, _ -> [] }
    stmts.any((s: StmtId) -> cx.view.store.stmt(s) is .Error)
}

fn call_type(mut cx: TypeCx, e: ExprId) -> TypeId {
    match cx.view.store.expr(e) {
        .Call(callee, pins, args) -> {
            cx.warn_use(e)
            let sig: FnSig? = cx.sig_of(e)
            if sig == null { return cx.settled_call(args, valued_call(cx, e, callee.of, pins, args)) }
            cx.settled_call(args, dispatched_call(cx, e, callee.of, pins, args, sig!))
        }
        _ -> cx.error_type,
    }
}

/// A call through a FN-TYPED VALUE — a lambda, a captured fn, a
/// fn-typed param: the value's own seats judge the arguments.
fn valued_call(mut cx: TypeCx, e: ExprId, callee: string, pins: List<TypeRef>, args: List<ExprId>) -> TypeId {
    if !pins.is_empty() { return value_takes_no_pins(cx, e, callee) }
    let bound = cx.target_type(e)
    let made: TypeId? = named_construction(cx, e, callee, args, bound)
    if made != null { return made! }
    let held: Arrow? = cx.view.types.arrow_parts(bound)
    if held != null {
        let arrow = held!
        return cx.seats_judged(e, callee, arrow.seats, arrow.marks, arrow.answer, args)
    }
    if cx.errored_ty(bound) { return cx.error_type }
    not_callable(cx, e, callee, bound)
}

/// A NAMED TYPE CONSTRUCTS BY CALL — `UserId(5)`. It takes ONE
/// argument of the shape it stands over, judged by the ORDINARY
/// SEAT LAW, so arity and the value refuse in the call's own words
/// and this rule owes no voice of its own. Absent when the callee
/// names no type, or names one that stands over nothing.
fn named_construction(mut cx: TypeCx, e: ExprId, callee: string, args: List<ExprId>, bound: TypeId) -> TypeId? {
    let d: DeclId? = type_name_decl(cx.view.types.shape_of(bound))
    if d == null { return null }
    // the DECLARATION first: the name's mark is made when it is
    let _ = cx.view.decls.sig(d!)
    let named = cx.view.decls.self_type_of(d!)
    let of: TypeId? = cx.view.types.stands_for(named)
    if of == null { return null }
    cx.seats_judged(e, callee, [of!], [], named, args)
}

/// A GENERIC callee unifies; a plain one type-checks directly. The
/// tparams come from the declaration itself — the registry the
/// resolver already found.
fn dispatched_call(mut cx: TypeCx, e: ExprId, callee: string, pins: List<TypeRef>,
                   args: List<ExprId>, s: FnSig) -> TypeId {
    let decl: DeclId? = cx.bound_decl(e)
    if decl == null { return cx.seats_judged(e, callee, s.params, [], s.ret, args) }
    let d = decl!
    if !cx.seat_contracts(e, callee, d, 0, args, null) { return cx.error_type }
    if cx.view.decls.is_extern(d) { inout_args_law(cx, callee, d, args) }
    let tp: List<string> = cx.tparams(d)
    if tp.is_empty() {
        if !pins.is_empty() { takes_no_pins(cx, e, callee) }
        return cx.seats_judged(e, callee, s.params, [], s.ret, args)
    }
    generic_call(cx, e, callee, pins, args, s, d, tp)
}

/// The instantiation: pins pre-fill by position, arguments unify
/// the rest, every Var must land, and the answer is the return with
/// the bindings applied. Recorded for mono.
fn generic_call(mut cx: TypeCx, e: ExprId, callee: string, pins: List<TypeRef>,
                args: List<ExprId>, s: FnSig, decl: DeclId, tp: List<string>) -> TypeId {
    if tparams_refused(tp) { return cx.error_type }
    if args.length != s.params.length {
        cx.wrong_arity(e, callee, s.params.length, args.length)
        return cx.error_type
    }
    mut bound = pinned_slots(cx, e, callee, pins, decl, tp)
    // a pin that failed to name a type already spoke — absorb
    for b in bound.slots {
        if b != null && cx.errored_ty(b!) { return cx.error_type }
    }
    mut spoke = false
    for j, a in args {
        if !generic_argument(cx, callee, j, s.params[j], a, decl, bound) { spoke = true }
    }
    if spoke { return cx.error_type }
    if unpinned_of(tp, bound) != null { pinned_by_answer(cx, e, s.ret, decl, bound) }
    let missing: string? = unpinned_of(tp, bound)
    if missing != null { return if cx.starving { unpinned_by_arguments(cx, e, callee, missing!) } else { cx.hungry(e) } }
    let concrete = cx.bound_closed(bound)
    if !bounds_hold(cx, e, decl, concrete) { return cx.error_type }
    if !lawful_instantiation(cx, e, s, decl, concrete) { return cx.error_type }
    let settled: List<string> = cx.subst_at(e)?.consts ?? []
    cx.record_subst(e, decl, concrete, settled)
    cx.view.types.substituted(s.ret, decl, concrete)
}

/// A Var the arguments leave free is pinned by the ANSWER's seat: the
/// declared return unifies with the want the seat planted (`let xs:
/// List<int> = empty()`, `Store { exprs: new_arena() }`, an argument
/// seat, a fn's declared answer). With no want yet the call goes
/// HUNGRY, like a generic literal, and speaks only when the walk ends
/// starving.
fn pinned_by_answer(cx: TypeCx, e: ExprId, ret: TypeId, decl: DeclId, mut bound: Pins) {
    let wanted: TypeId? = cx.want_at(e)
    if wanted == null { return }
    let _ = cx.unify(ret, wanted!, decl, bound)
}

/// The representation laws re-judge every substituted slot — a
/// binding cannot smuggle past what a declaration would refuse.
fn lawful_instantiation(mut cx: TypeCx, e: ExprId, s: FnSig, decl: DeclId, concrete: List<TypeId>) -> bool {
    for pt in s.params {
        if refused_instantiation(cx, e, pt, decl, concrete) { return false }
    }
    !refused_instantiation(cx, e, s.ret, decl, concrete)
}

/// One substituted type checked against the representation laws.
fn refused_instantiation(mut cx: TypeCx, e: ExprId, raw: TypeId, decl: DeclId, concrete: List<TypeId>) -> bool {
    let offender: TypeId? = cx.unlawful_side(cx.view.types.substituted(raw, decl, concrete))
    if offender == null { return false }
    side_unholdable(cx, e, offender!)
    true
}

/// Explicit pins fill the slots by position — all of them, or none.
fn pinned_slots(mut cx: TypeCx, e: ExprId, callee: string, pins: List<TypeRef>,
                decl: DeclId, tp: List<string>) -> Pins {
    mut bound = no_pins(tp.length)
    if pins.is_empty() { return bound }
    if pins.length != tp.length {
        wrong_pin_count(cx, e, callee, tp.length, pins.length)
        return bound
    }
    for j, tr in pins {
        bound.pin(j, cx.written(e, tr))
    }
    bound
}

/// One generic argument: unification first; when the param's Vars
/// are ALREADY all bound (pins, or earlier arguments), the param is
/// effectively concrete and the ordinary assignment law judges it —
/// which is what lets `null` and widening ride a pinned `T?`.
fn generic_argument(mut cx: TypeCx, callee: string, j: int, param: TypeId, a: ExprId,
                    decl: DeclId, mut bound: Pins) -> bool {
    if cx.agreed(a, param, decl, bound) { return true }
    if cx.shape_at(a) is .Null {
        null_cannot_pin(cx, callee, j, param, a)
        return false
    }
    cx.wrong_argument(callee, j, param, a)
    false
}

/// `return v` — legal only inside a fn, and `v` must be ACCEPTED
/// by the declared answer (widening recorded, like every slot).
export fn check_return(mut cx: TypeCx, s: StmtId) {
    let held: ExprId? = cx.view.store.stmt_value(s)
    if held == null { return bare_return(cx, s) }
    let v = held!
    let early: TypeId? = cx.enclosing_ret()
    if early != null { cx.plant_want(v, early!) }
    cx.walk(v)
    let want: TypeId? = cx.enclosing_ret()
    if want == null {
        no_fn_to_answer(cx, s)
        return
    }
    if cx.errored(v) { return }
    if cx.accepts(v, want!) { return }
    wrong_return(cx, s, v, want!)
}

/// One bound, one binding: implemented, or refused with the remedy.
fn bound_held(mut cx: TypeCx, e: ExprId, tname: string, ty: TypeId) -> bool {
    if cx.implements(ty, tname) { return true }
    bound_unheld(cx, e, tname, ty)
    false
}

/// Every bounded tparam's binding must IMPLEMENT its trait — the
/// instantiation check that makes abstract method calls sound.
fn bounds_hold(mut cx: TypeCx, e: ExprId, decl: DeclId, concrete: List<TypeId>) -> bool {
    let tb = cx.tbounds(decl)
    for j, seat in tb {
        let ann: TypeRef? = seat.ty
        if ann != null {
            if !bound_held(cx, e, ann!.name, concrete[j]) { return false }
        }
    }
    true
}

/// THE HOST INOUT LAW at the CALL: only a LOCAL binding owns a cell,
/// and the cell's address is what the seat hands over. A parameter,
/// a capture, a pattern bind and a receiver are registers with
/// nothing behind them, so handing one over would pass the VALUE and
/// the callee's write would land in a copy nobody reads.
fn inout_args_law(mut cx: TypeCx, callee: string, d: DeclId, args: List<ExprId>) {
    let marks = cx.declared_marks(d, 0, args.length)
    for j, a in args {
        if mut_mark(marks, j) && cellless_place(cx, a) { seat_wants_a_local(cx, a, callee, j) }
    }
}

/// A `mut` PLACE whose root owns no cell — a parameter, a capture, a
/// pattern bind, a receiver. A value and a non-`mut` root are the
/// SEAT LAW's to refuse and it already has, so this law asks only
/// about what that one accepted: one mistake, one message.
fn cellless_place(cx: TypeCx, a: ExprId) -> bool {
    let held: ExprId? = cx.view.store.place_root(a)
    if held == null { return false }
    let root = held!
    let b: Binding? = cx.names.binding(root)
    cx.is_mut(root) && b != null && !(b! is .Def)
}

// ── The voices ──

fn body_disagrees(mut cx: TypeCx, body: ExprId, fname: string, fret: TypeRef, got: TypeId) {
    let gn = cx.view.types.name_of(got)
    cx.emit(refusal("type.mismatch", cx.loc_of(body), "the body answers `${gn}` but `${fname}` declares `${spelled(fret)}`", this_is(gn), null))
}

fn value_takes_no_pins(mut cx: TypeCx, e: ExprId, callee: string) -> TypeId {
    cx.spoken(refusal("type.lambda", cx.loc_of(e), "`${callee}` is a fn VALUE — it takes no type arguments", "pinned here", null))
}

fn not_callable(mut cx: TypeCx, e: ExprId, callee: string, bound: TypeId) -> TypeId {
    cx.spoken(refusal("type.lambda", cx.loc_of(e), "`${callee}` is not callable — it holds a `${cx.view.types.name_of(bound)}`", "called here", "only fns and fn-typed values take arguments"))
}

fn takes_no_pins(mut cx: TypeCx, e: ExprId, callee: string) {
    cx.emit(refusal("type.mismatch", cx.loc_of(e), "`${callee}` takes no type arguments", "pinned here", null))
}

fn unpinned_by_arguments(mut cx: TypeCx, e: ExprId, callee: string, tparam: string) -> TypeId {
    cx.spoken(refusal("type.mismatch", cx.loc_of(e), "`${tparam}` is not pinned by the arguments", "in this call", "write the type explicitly — `${callee}<...>(...)`"))
}

fn side_unholdable(mut cx: TypeCx, e: ExprId, offender: TypeId) {
    cx.emit(refusal("type.mismatch", cx.loc_of(e), "this call makes a `Result` side `${cx.view.types.name_of(offender)}`, which a side cannot hold yet", "in this call", slice_promise("sides")))
}

fn wrong_pin_count(mut cx: TypeCx, e: ExprId, callee: string, want: int, found: int) {
    cx.emit(refusal("type.mismatch", cx.loc_of(e), "`${callee}` takes ${want} type arguments, found ${found}", "pinned here", null))
}

fn null_cannot_pin(mut cx: TypeCx, callee: string, j: int, param: TypeId, a: ExprId) {
    cx.emit(refusal("type.mismatch", cx.loc_of(a), "argument ${j + 1} of `${callee}` wants `${cx.view.types.name_of(param)}`, found `null`", "always absent", "a bare `null` cannot pin `T` — write `${callee}<...>(...)`"))
}

fn no_fn_to_answer(mut cx: TypeCx, s: StmtId) {
    cx.emit(refusal("type.return", cx.stmt_loc(s), "a `return` answers a fn, and there is none enclosing", "returned here", "at the top level the last statement IS the answer"))
}

fn bare_return(mut cx: TypeCx, s: StmtId) {
    let want: TypeId? = cx.enclosing_ret()
    if want == null { return no_fn_to_answer(cx, s) }
    if cx.view.types.shape_of(want!) is .Void { return }
    cx.emit(refusal("type.return", cx.stmt_loc(s), "a bare `return` answers nothing, but this fn declares `${cx.view.types.name_of(want!)}`", "here", "write `return <value>`, or declare no return"))
}

fn wrong_return(mut cx: TypeCx, s: StmtId, v: ExprId, want: TypeId) {
    let gn = cx.name_at(v)
    cx.emit(refusal("type.return", cx.stmt_loc(s), "`return` answers `${cx.view.types.name_of(want)}`, this is `${gn}`", this_is(gn), null))
}

fn bound_unheld(mut cx: TypeCx, e: ExprId, tname: string, ty: TypeId) {
    let tn = cx.view.types.name_of(ty)
    cx.emit(refusal("type.mismatch", cx.loc_of(e), "`${tn}` does not implement `${tname}`", "in this call", "write `impl ${tname} for ${tn} { … }`"))
}

fn seat_not_inout_able(mut cx: TypeCx, s: StmtId, hname: string, j: int, pp: Param) {
    cx.emit(refusal("type.host_seat", cx.stmt_loc(s), "seat ${j + 1} of `${hname}` is `mut` and wears `${spelled(pp.ty ?? void_written)}` — a `mut` host seat hands C the ADDRESS of the caller's cell", "declared here", "a cell C may write is `ptr`, `ptr?`, or an integer at its DECLARED WIDTH — `i32` for a C `int*`, `u32` for `unsigned*`, `i64` for `int64_t*`. A bare `int` is refused here alone, because it is right for `int64_t*` and silently wrong for `int*`, and only the declaration knows which. A managed value (`string`, a list, a map, a record) cannot cross at all — C keeps no refcount for what it writes."))
}

fn seat_wants_a_local(mut cx: TypeCx, a: ExprId, callee: string, j: int) {
    cx.emit(refusal("type.host_seat", cx.loc_of(a), "seat ${j + 1} of `${callee}` is `mut`, and only a LOCAL binding has a cell to hand over", "handed here", "bind it in this body first — `mut x = …` — then hand `x`; a parameter, a capture and a pattern bind are values with no cell behind them"))
}

/// The stand-in when a seat wrote no type at all — the declare pass
/// already refused it; the voice must still name something.
const void_written: TypeRef = TypeRef { name: "void", args: [], optional: false, dynamic: false, arrow: false, span: null }
