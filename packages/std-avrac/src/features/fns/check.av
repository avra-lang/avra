//! The fn feature's typing rules. The call: the target's signature
//! is the law — arity exact, every argument matching its param; the
//! declared return answers either way; Error arguments absorb. The
//! declaration: the body types under its params AND its type
//! parameters — checked ONCE, abstractly (a T can only move). A
//! generic call INSTANTIATES: pins pre-fill, arguments unify, a
//! fully-bound param falls back to the ordinary assignment law, and
//! the representation laws re-judge every substituted slot.
use core.{ExprId, StmtId, TypeId, Arrow, TypeRef, spelled, filled}
use features.{TypeCx, StmtTypeCx, FnSig, nothing, accepts, this_is, spoken, seats_judged, wrong_arity, wrong_argument, unify, unlawful_side, fully_bound, bound_args, tparams_refused, unpinned_of, bound_closed, settled_call, slice_promise}
use diagnostics.{error_at, pointed}

export fn check_fn(cx: StmtTypeCx, s: StmtId) {
    match cx.store.stmt(s) {
        .FnDecl(fname, _, _, fret, body) -> checked_fn(cx, s, fname, fret, body),
        _ -> nothing(),
    }
}

fn checked_fn(cx: StmtTypeCx, s: StmtId, fname: string, fret: TypeRef, body: ExprId) {
    let sig: FnSig? = cx.sig_of(s)
    cx.walk_under(s, body)
    let want: TypeId = sig?.ret ?? cx.expr.error_type
    let got: TypeId = cx.expr.type_at(body)
    if !accepts(cx.expr, body, want) {
        let gn = cx.expr.types.name_of(got)
        cx.expr.emit(pointed(
            error_at("type.mismatch", cx.expr.loc_of(body),
                "the body answers `${gn}` but `${fname}` declares `${spelled(fret)}`"),
            this_is(gn)))
    }
}

fn call_type(cx: TypeCx, e: ExprId) -> TypeId {
    match cx.store.expr(e) {
        .Call(callee, pins, args) -> {
            let sig: FnSig? = cx.sig_of(e)
            if sig == null { return settled_call(cx, args, valued_call(cx, e, callee, pins, args)) }
            settled_call(cx, args, dispatched_call(cx, e, callee, pins, args, sig!))
        }
        _ -> cx.error_type,
    }
}

/// A call through a FN-TYPED VALUE — a lambda, a captured fn, a
/// fn-typed param: the value's own seats judge the arguments.
fn valued_call(cx: TypeCx, e: ExprId, callee: string, pins: List<TypeRef>, args: List<ExprId>) -> TypeId {
    if !pins.is_empty() {
        cx.emit(pointed(
            error_at("type.lambda", cx.loc_of(e), "`${callee}` is a fn VALUE — it takes no type arguments"),
            "pinned here"))
        return cx.error_type
    }
    let bound = cx.target_type(e)
    let held: Arrow? = cx.types.arrow_parts(bound)
    if held != null { return seats_judged(cx, e, callee, held!.seats, held!.answer, args) }
    if cx.types.shape_of(bound) is .Error { return cx.error_type }
    spoken(cx, pointed(
        error_at("type.lambda", cx.loc_of(e), "`${callee}` is not callable — it holds a `${cx.types.name_of(bound)}`"),
        "called here")
        with { help: "only fns and fn-typed values take arguments" })
}



/// A GENERIC callee unifies; a plain one type-checks directly. The
/// tparams come from the declaration itself — the registry the
/// resolver already found.
fn dispatched_call(cx: TypeCx, e: ExprId, callee: string, pins: List<TypeRef>,
                   args: List<ExprId>, s: FnSig) -> TypeId {
    let decl: StmtId? = cx.bound_def(e)
    if decl == null { return seats_judged(cx, e, callee, s.params, s.ret, args) }
    let tp: List<string> = tparams_of(cx, decl!)
    if tp.is_empty() {
        if !pins.is_empty() {
            cx.emit(pointed(
                error_at("type.mismatch", cx.loc_of(e),
                    "`${callee}` takes no type arguments"),
                "pinned here"))
        }
        return seats_judged(cx, e, callee, s.params, s.ret, args)
    }
    generic_call(cx, e, callee, pins, args, s, decl!, tp)
}

fn tparams_of(cx: TypeCx, decl: StmtId) -> List<string> {
    cx.store.decl_tparams(decl)
}

/// The instantiation: pins pre-fill by position, arguments unify
/// the rest, every Var must land, and the answer is the return with
/// the bindings applied. Recorded for mono.
fn generic_call(cx: TypeCx, e: ExprId, callee: string, pins: List<TypeRef>,
                args: List<ExprId>, s: FnSig, decl: StmtId, tp: List<string>) -> TypeId {
    if tparams_refused(tp) { return cx.error_type }
    if args.length != s.params.length {
        wrong_arity(cx, e, callee, s.params.length, args.length)
        return cx.error_type
    }
    let bound: List<TypeId?> = pinned_slots(cx, e, callee, pins, decl, tp)
    // a pin that failed to name a type already spoke — absorb
    for b in bound {
        if b != null && cx.types.shape_of(b!) is .Error { return cx.error_type }
    }
    mut spoke = false
    for (j, a) in args.enumerate() {
        if !generic_argument(cx, callee, j, s.params[j], a, decl, bound) { spoke = true }
    }
    if spoke { return cx.error_type }
    let missing: string? = unpinned_of(tp, bound)
    if missing != null { return unpinned_by_arguments(cx, e, callee, missing!) }
    let concrete = bound_closed(cx, bound)
    if !bounds_hold(cx, e, callee, decl, tp, concrete) { return cx.error_type }
    if !lawful_instantiation(cx, e, callee, s, decl, concrete) { return cx.error_type }
    cx.record_subst(e, decl, concrete)
    cx.types.substituted(s.ret, decl, concrete)
}

fn unpinned_by_arguments(cx: TypeCx, e: ExprId, callee: string, tparam: string) -> TypeId {
    cx.emit(pointed(
        error_at("type.mismatch", cx.loc_of(e), "`${tparam}` is not pinned by the arguments"),
        "in this call")
        with { help: "write the type explicitly — `${callee}<...>(...)`" })
    cx.error_type
}

/// The representation laws re-judge every substituted slot — a
/// binding cannot smuggle past what a declaration would refuse.
fn lawful_instantiation(cx: TypeCx, e: ExprId, callee: string, s: FnSig,
                        decl: StmtId, concrete: List<TypeId>) -> bool {
    for pt in s.params {
        if refused_instantiation(cx, e, callee, pt, decl, concrete) { return false }
    }
    !refused_instantiation(cx, e, callee, s.ret, decl, concrete)
}

/// One substituted type checked against the representation laws.
fn refused_instantiation(cx: TypeCx, e: ExprId, callee: string, raw: TypeId,
                         decl: StmtId, concrete: List<TypeId>) -> bool {
    let offender: TypeId? = unlawful_side(cx, cx.types.substituted(raw, decl, concrete))
    if offender == null { return false }
    cx.emit(pointed(
        error_at("type.mismatch", cx.loc_of(e),
            "this call makes a `Result` side `${cx.types.name_of(offender!)}`, which a side cannot hold yet"),
        "in this call")
        with { help: slice_promise("sides") })
    true
}

/// Explicit pins fill the slots by position — all of them, or none.
fn pinned_slots(cx: TypeCx, e: ExprId, callee: string, pins: List<TypeRef>,
                decl: StmtId, tp: List<string>) -> List<TypeId?> {
    mut bound: List<TypeId?> = filled<TypeId?>(tp.length, null)
    if pins.is_empty() { return bound }
    if pins.length != tp.length {
        cx.emit(pointed(
            error_at("type.mismatch", cx.loc_of(e),
                "`${callee}` takes ${tp.length} type arguments, found ${pins.length}"),
            "pinned here"))
        return bound
    }
    // LICENSED I3: positional fill; comprehensions cannot destructure enumerate
    for (j, tr) in pins.enumerate() {
        bound.set(j, cx.written(decl, tr))
    }
    bound
}

/// One generic argument: unification first; when the param's Vars
/// are ALREADY all bound (pins, or earlier arguments), the param is
/// effectively concrete and the ordinary assignment law judges it —
/// which is what lets `null` and widening ride a pinned `T?`.
fn generic_argument(cx: TypeCx, callee: string, j: int, param: TypeId, a: ExprId,
                    decl: StmtId, bound: List<TypeId?>) -> bool {
    if unify(cx, param, cx.type_at(a), decl, bound) { return true }
    if fully_bound(cx, param, decl, bound) {
        let landed = cx.types.substituted(param, decl, bound_args(cx, bound))
        if accepts(cx, a, landed) { return true }
    }
    if cx.shape_at(a) is .Null {
        cx.emit(pointed(
            error_at("type.mismatch", cx.loc_of(a),
                "argument ${j + 1} of `${callee}` wants `${cx.types.name_of(param)}`, found `null`"),
            "always absent")
            with { help: "a bare `null` cannot pin `T` — write `${callee}<...>(...)`" })
        return false
    }
    wrong_argument(cx, callee, j, param, a)
    false
}

/// THE arity refusal — plain and generic calls share the words.
/// `return v` — legal only inside a fn, and `v` must be ACCEPTED
/// by the declared answer (widening recorded, like every slot).
export fn check_return(cx: StmtTypeCx, s: StmtId) {
    let held: ExprId? = cx.store.stmt_value(s)
    if held == null { return }
    let v = held!
    let early: TypeId? = cx.expr.enclosing_ret()
    if early != null { cx.expr.plant_want(v, early!) }
    cx.walk(v)
    let want: TypeId? = cx.expr.enclosing_ret()
    if want == null {
        cx.expr.emit(pointed(
            error_at("type.return", cx.loc_of(s), "a `return` answers a fn, and there is none enclosing"),
            "returned here")
            with { help: "at the top level the last statement IS the answer" })
        return
    }
    if cx.expr.shape_at(v) is .Error { return }
    if accepts(cx.expr, v, want!) { return }
    let gn = cx.expr.name_at(v)
    cx.expr.emit(pointed(
        error_at("type.return", cx.loc_of(s),
            "`return` answers `${cx.expr.types.name_of(want!)}`, this is `${gn}`"),
        this_is(gn)))
}

/// One bound, one binding: implemented, or refused with the remedy.
fn bound_held(cx: TypeCx, e: ExprId, tname: string, ty: TypeId) -> bool {
    if cx.implements(ty, tname) { return true }
    cx.emit(pointed(
        error_at("type.mismatch", cx.loc_of(e),
            "`${cx.types.name_of(ty)}` does not implement `${tname}`"),
        "in this call")
        with { help: "write `impl ${tname} for ${cx.types.name_of(ty)} { … }`" })
    false
}

/// Every bounded tparam's binding must IMPLEMENT its trait — the
/// instantiation check that makes abstract method calls sound.
fn bounds_hold(cx: TypeCx, e: ExprId, callee: string, decl: StmtId,
               tp: List<string>, concrete: List<TypeId>) -> bool {
    let tb = cx.store.decl_tbounds(decl)
    // LICENSED I3: bounds pair with bindings by ordinal; comprehensions cannot destructure enumerate
    for (j, seat) in tb.enumerate() {
        let ann: TypeRef? = seat.ty
        if ann != null {
            if !bound_held(cx, e, ann!.name, concrete[j]) { return false }
        }
    }
    true
}
