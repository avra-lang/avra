fn seat_wants_a_local(mut cx: TypeCx, a: ExprId, callee: string, j: int) { cx.emit(said_as("type.host_seat", cx.loc_of(a), cellless_seat(callee, j))) }

/// A place handed the `mut` seat `j` of the extern `callee` that is no `mut` binding's own cell, which
/// is what C writes through.
export fn cellless_seat(callee: string, j: int) -> Voice {
    Voice {
        message: "seat ${j + 1} of `${callee}` is `mut`, and only a LOCAL binding has a cell to hand over",
        label: "handed here",
        help: "bind it in this body first — `mut x = …` — then hand `x`; a parameter, a capture and a pattern bind are values with no cell behind them",
    }
}

/// The stand-in when a seat wrote no type at all — the declare pass
/// already refused it; the voice must still name something.
const void_written: TypeRef = TypeRef {
    name: "void",
    applied: [],
    optional: false,
    dynamic: false,
    arrow: false,
    span: null,
}

// ── The extern-declaration voices, one per refusal, shared by both paths ──

/// A callback seat `seat` of `hname` whose answer rides a pointer the C would follow under a cancel.
export fn callback_pointer_voice(hname: string, seat: string) -> Voice {
    Voice {
        message: "seat `${seat}` of `${hname}` is a callback under a cancel, and it answers a pointer the C would follow",
        label: "declared here",
        help: "a callback under a cancel answers zero — answer a word, or read nothing on the C side when it does",
    }
}

/// The runtime row `row`, of `seats` seats, declared with `declared`.
export fn row_arity_voice(row: string, seats: int, declared: int) -> Voice {
    Voice {
        message: "`${row}` is a runtime row of ${seats} seat(s), declared here with ${declared}",
        label: "this extern",
        help: "declare the row's seats, or name a fn the runtime does not carry",
    }
}

/// The runtime row `row`, answering `box` (a box's words), declared to answer `written`.
export fn answer_box_voice(row: string, box: string, written: string, seat: string) -> Voice {
    Voice {
        message: "`${row}` answers ${box}, this declares `${written}`",
        label: "this extern",
        help: "a runtime row answers the box its C body built — declare the answer `${seat}`, or `ptr` for the raw crossing",
    }
}

/// The runtime row `row`, answering in `kind`, declared to answer `written`, which rides `got`.
export fn answer_kind_voice(row: string, kind: string, written: string, got: string) -> Voice {
    Voice {
        message: "`${row}` answers ${kind}, this declares `${written}`, which rides ${got}",
        label: "this extern",
        help: "a runtime row answers what its C body answers — declare the answer the row names, or name a fn the runtime does not carry",
    }
}

/// Seat `j` of the runtime row `row`, which reads `box`, declared `written`.
export fn seat_box_voice(row: string, j: int, box: string, written: string, seat: string) -> Voice {
    Voice {
        message: "seat ${j + 1} of `${row}` reads ${box}, this is `${written}`",
        label: "this extern",
        help: "a runtime row reads the box its header names — declare the seat `${seat}`, or `ptr` for the raw crossing",
    }
}

/// The `mut` seat `j` of `hname`, wearing `written`, which no cell C writes is.
export fn inout_unable_voice(hname: string, j: int, written: string) -> Voice {
    Voice {
        message: "seat ${j + 1} of `${hname}` is `mut` and wears `${written}` — a `mut` host seat hands C the ADDRESS of the caller's cell",
        label: "declared here",
        help: "a cell C writes is `ptr`, `ptr?`, or an integer at its declared width — `i32` for `int*`, `u32` for `unsigned*`, `i64` for `int64_t*`; a bare `int` is refused here alone, as only the declaration knows its width, and a managed value cannot cross: C keeps no refcount for what it writes",
    }
}

/// The host fn `hname`, named as the runtime's own symbol.
export fn host_row_voice(hname: string) -> Voice {
    Voice {
        message: "`${hname}` is the runtime's own symbol — a host fn cannot define it again",
        label: "defined here",
        help: "name the host fn for what the host asks of this program",
    }
}

/// The seat `seat` of the host fn `hname`, marked.
export fn host_promise_voice(hname: string, seat: string) -> Voice {
    Voice {
        message: "seat `${seat}` of the host fn `${hname}` is marked — a host makes no promise about a seat",
        label: "marked here",
        help: "drop the mark: a host fn's seats are plain values",
    }
}

/// The seat `seat` of the host fn `hname`, wearing `ty`, which no host hands over.
export fn host_seat_voice(hname: string, seat: string, ty: string) -> Voice {
    Voice {
        message: "seat `${seat}` of the host fn `${hname}` wears `${ty}`, which no host can hand over",
        label: "declared here",
        help: "a host fn's seat is `int`, `float`, `string`, `Bytes` or `ptr`",
    }
}

/// The host fn `hname`, answering `ty`, which no host takes.
export fn host_answer_voice(hname: string, ty: string) -> Voice {
    Voice {
        message: "the host fn `${hname}` answers `${ty}`, which no host can take",
        label: "declared here",
        help: "a host fn answers `int`, `float`, `string`, `Bytes`, `ptr`, or nothing",
    }
}

/// Seat `j` of `hname`, wearing `ty`, which cannot cross to C.
export fn crossing_voice(hname: string, j: int, ty: string) -> Voice {
    Voice {
        message: "seat ${j + 1} of `${hname}` wears `${ty}`, which cannot cross to C",
        label: "declared here",
        help: "a host seat is a machine word or one pointer C reads — `int`, `float`, `bool`, a width word, `string`, `Bytes`, `ptr`, or a nullable over those; any other box has an address C cannot follow. Pass its parts one at a time, or make the callee a runtime row",
    }
}

/// The answer of `hname`, wearing `ty`, which cannot cross back from C.
export fn answer_crossing_voice(hname: string, ty: string) -> Voice {
    Voice {
        message: "the answer of `${hname}` wears `${ty}`, which cannot cross to C",
        label: "declared here",
        help: "an extern's answer is what ONE frame reads back out of a register: a machine word (`int`, `bool`, a width word), a `float`, a pointer (`ptr`, `ptr?`), text (`string`, `string?`), or nothing at all. Everything else is a box in Avra's layout and a foreign address is not one — the compiled program reads C memory as ours and the evaluator has no arm to make a box from an address. `Bytes` is refused HERE though a seat takes it: a seat hands C a box whose length the caller already knows, and an answer would have to invent one. Answer `ptr` and read the bytes yourself, or make the callee a runtime row, whose arm materialises the box on both sides.",
    }
}

/// Seat `j` of the runtime row `hname`, wearing the nullable `ty`.
export fn absence_voice(hname: string, j: int, ty: string) -> Voice {
    Voice {
        message: "seat ${j + 1} of `${hname}` wears `${ty}`, and a runtime row's seat takes no absence",
        label: "declared here",
        help: "a runtime row reads the pointer it is handed, so its seat takes no absence — spell it without the `?` (a package's own C may take a pointer-or-NULL)",
    }
}
