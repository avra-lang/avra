// proves: `mut` in a FN TYPE — the missing half of the seat law. A
// fn type carries its seats' contract, so a writing fn travels only
// where writing is permitted: through a field, a parameter, a
// return, a `let`, and a call on the value. A non-writing fn fits a
// writing seat (the sound direction); the refusals live in the
// suites, since a program test must run.
type Rows = { grow: fn(mut List<int>, int) -> int }

fn writes(mut xs: List<int>, v: int) -> int {
    xs.push(v)
    xs.length
}

fn reads(xs: List<int>, v: int) -> int {
    xs.length + v
}

fn through(g: fn(mut List<int>, int) -> int, mut xs: List<int>, v: int) -> int {
    g(xs, v)
}

fn picked() -> fn(mut List<int>, int) -> int {
    writes
}

let a = [1]
let b = [1, 2]
let c = [7]
let rows = Rows { grow: writes }
let direct: fn(mut List<int>, int) -> int = writes
let widened: fn(mut List<int>, int) -> int = reads
"${rows.grow(a, 9)} ${a.length} ${through(writes, b, 5)} ${b.length} ${direct(c, 1)} ${widened(c, 4)} ${(picked())(c, 2)} ${c.length}"
