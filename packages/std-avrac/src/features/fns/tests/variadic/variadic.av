// proves: a `..rest: List<T>` seat takes the rest of a call's arguments —
// packed as a list, a `..xs` argument joined in or handed over whole,
// nothing at all an empty list; generic and method seats too
fn total(base: int, ..more: List<int>) -> int {
    let counted = more.length * 100
    base + counted + more.fold(0, (a, x) -> a + x)
}

fn joined(sep: string, ..parts: List<string>) -> string { parts.join(sep) }

fn biggest<T>(_first: T, ..rest: List<T>) -> int { rest.length + 1 }

fn all(..xs: List<int>) -> int { xs.length }

type Acc = { n: int }

impl Acc {
    fn add(..xs: List<int>) -> int { self.n + xs.fold(0, (a, x) -> a + x) }
}

let xs = [10, 20]
let a = total(1)
let b = total(1, 2, 3)
let c = total(1, ..xs)
let d = total(1, 2, ..xs, 3)
let e = joined("-", "a", "b", "c")
let f = joined("-")
let g = biggest(1, 2, 3)
let h = biggest("s", ..["t", "u", "v"])
let i = all(..xs, ..xs)
let j = all()
let k = Acc { n: 5 }.add(1, 2, ..xs)
"${a} ${b} ${c} ${d} ${e} [${f}] ${g} ${h} ${i} ${j} ${k} ${xs.length}"
