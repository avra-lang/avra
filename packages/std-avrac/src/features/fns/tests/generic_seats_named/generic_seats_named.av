// proves: a generic fn's unit takes its arguments by name and leaves a seat
// to its default, as a plain fn's call does; and a static fn called through
// its type takes its arguments by name.
fn framed<T>(value: T, show: fn(T) -> string, left: string = "[", right: string = "]") -> string {
    "${left}${show(value)}${right}"
}

fn shown(n: int) -> string { "${n}" }

type Pair = { a: int, b: int }

impl Pair {
    static fn of(a: int, b: int = 9) -> Pair { Pair { a: a, b: b } }
}

let p = Pair.of(b: 2, a: 1)
let q = Pair.of(a: 5)

"${framed(3, shown)} ${framed(4, right: ">", left: "<", show: shown)} ${framed(value: "x", show: (s: string) -> s)} ${p.a}${p.b} ${q.a}${q.b}"
