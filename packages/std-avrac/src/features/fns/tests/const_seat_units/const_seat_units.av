// proves: a unit per settled value — a `const` in the body that reads a settled seat settles with
// it, two seats keep their order, a generic fn's settled seat splits like a plain one's, a settled
// seat forwards per value, and a const written as a literal shares the literal's unit
fn hashed(p: string) -> int {
    mut n = 0
    for c in p.chars() { n = n * 31 + c }
    n
}

fn pick(const p: string, s: string) -> int {
    const h: int = hashed(p)
    h + s.length
}

fn pair(const a: int, const b: int) -> int { a * 10 + b }

fn first<T>(const x: T, _y: T) -> T { x }

fn inner(const x: int) -> int { x + 1 }

fn outer(const y: int) -> int { inner(y) }

const K: string = "abc"

fn joined(const p: string, s: string) -> string { p + s }

println("${pick("abc", "1") + pick("xyz", "22") + pick(K, "333")}")
println(
    "${pair(1, 2) + pair(2, 1)} ${first(1, 2) + first(1, 3) + first(2, 4)} ${outer(3) + outer(4)}",
)
println("${joined("x", "1")}${joined("y", "2")}${joined(K, "3")}")
