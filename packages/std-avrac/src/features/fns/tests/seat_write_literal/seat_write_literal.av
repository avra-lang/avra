// A WRITE THROUGH A SEAT ITS CALLER DID NOT OPEN copies the binary's own data: a writing method on a
// non-`mut` seat handed a const's literal writes a copy, and the const reads the same after. A `mut`
// seat handed a const's literal is handed the copy its caller opened.
type Bag = { items: List<int> }

impl Bag {
    fn add(v: int) { self.items.push(v) }
}

const base: List<int> = [1, 2]

const full: Bag = Bag { items: [1, 2, 3] }

fn grown(b: Bag) -> int {
    b.add(7)
    b.items.length
}

fn grow(mut xs: List<int>) { xs.push(8) }

let a = grown(full)
let c = grown(full)
mut opened = base
grow(opened)
"${a} ${c} ${full.items.length} ${base.length} ${opened.length} ${opened[2]}"
