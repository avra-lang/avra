// proves: a `const` seat is a COMPILE-TIME promise on the fn type.
// The callee's seat travels with its type — a plain `fn(int)->int`
// value fills a `fn(const int)->int` seat (the sound direction), and
// the runtime ABI is unchanged: a `const` seat is neither a pointer
// nor a cell. Each distinct settled value gets its own unit, and a
// repeated value shares one. Both engines agree.
fn scaled(const n: int, factor: int) -> int {
    n * factor
}

fn tagged(const label: string) -> string {
    "${label}!"
}

fn apply(f: fn(const int) -> int) -> int {
    f(4)
}

fn twice(x: int) -> int {
    x * 2
}

fn compile(p: string) -> string {
    p + "!"
}

fn matches(const pattern: string, s: string) -> string {
    const prog = compile(pattern)
    prog + s
}

const K: int = 7

"${scaled(21, 2)} ${scaled(20, 2)} ${scaled(21, 2)} ${scaled(K, 3)} ${tagged("hi")} ${apply(twice)} ${matches("x", "y")} ${matches("z", "w")}"
