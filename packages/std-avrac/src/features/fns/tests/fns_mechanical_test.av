        then "x ( x , x , ) )" { tolerates("x ( x , x , ) )") }
        then "( x x , x , )" { tolerates("( x x , x , )") }
        then "x x ( , x , )" { tolerates("x x ( , x , )") }
        then "x ( , x x , )" { tolerates("x ( , x x , )") }
        then "x ( x x , , )" { tolerates("x ( x x , , )") }
        then "x ( x , , x )" { tolerates("x ( x , , x )") }
        then "x ( x , x ) ," { tolerates("x ( x , x ) ,") }
    }
}
