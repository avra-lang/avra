// AN EXTERN'S `mut` SEAT HANDS C THE BINDING'S CELL, at every width: C writes through it, and a
// narrow cell reads back extended by the width its seat declares — `i32` signed, `u32` unsigned. A
// box made only to be crossed is held until the call returns.
extern fn frexp(x: float, mut exponent: i32) -> float
extern fn rand_r(mut seed: u32) -> i32
extern fn time(mut t: i64) -> i64
extern fn strtol(s: string, mut end: ptr, base: i32) -> i64
extern fn strtod(s: string, mut end: ptr?) -> float

fn exponent_of(x: float) -> int {
    mut e = 0
    let _ = frexp(x, e)
    e
}

mut e = 7
let half = frexp(0.25, e)
mut seed = 2
let _ = rand_r(seed)
mut t = 0
let now = time(t)
mut wide = 1099511627776
let _ = frexp(8.0, wide)
// LICENSED nullable.nullable_flag_local: the cell is `strtod`'s out-seat, which C fills with a pointer; null is where it starts
mut rest: ptr? = null
let f = strtod("2.5x", rest)
mut end = rest!
let n = strtol("4" + "2tail", end, 10)
let exponents = [exponent_of(x) for x in [0.25, 8.0, 0.0625]]
"${half} ${e} ${wide} ${seed != 2 && seed >= 0} ${now == t} ${t > 1000000} ${n} ${f} ${rest != null} ${exponents[0]},${exponents[1]},${exponents[2]}"
