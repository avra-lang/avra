// proves: a generic fn's type parameters are filled through a fn seat's
// nullable answer and through a generic record a fn seat takes, beside a
// seat that names none, handed a variant.
type Req<R> = { params: R }

type Route = { pattern: string }

enum Verb {
    Get
    Put
}

// LICENSED fns.dead_parameter: this test exercises fn seats typed through the lambdas handed to them, read by nothing
fn nullable_read<R>(pattern: string, read: fn(string) -> R?) -> Route { Route { pattern: pattern } }

// LICENSED fns.dead_parameter: this test exercises fn seats typed through the lambdas handed to them, read by nothing
fn verbed<R>(verb: Verb, read: fn(string) -> R?) -> Route { Route { pattern: "${verb.ordinal}" } }

// LICENSED fns.dead_parameter: this test exercises fn seats typed through the lambdas handed to them, read by nothing
fn record_seat<R>(pattern: string, serve: fn(Req<R>) -> string) -> Route { Route { pattern: pattern } }

let a = nullable_read("a", (s: string) -> if s.is_empty() { null } else { s.length })
let b = record_seat("b", (q: Req<int>) -> "ok")
let c = verbed(Verb.Put, (s: string) -> if s.is_empty() { null } else { s.length })

"${a.pattern} ${b.pattern} ${c.pattern}"
