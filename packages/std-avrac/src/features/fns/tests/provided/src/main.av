// proves: `provided<Picture>("…")` and `asset x: Picture = "…"` read a file
// from the package root into a Picture whose size is its PNG header's
use @std.meta.{provided}
use @std.assets.{Picture}

asset logo: Picture = "art/logo.png"
const same: Picture = provided<Picture>("art/logo.png")

fn drawn(p: Picture) -> string {
    match p { .Bundled(_, w, h, _, _, _) -> "${w}x${h}", .Remote(_, w, h) -> "remote ${w}x${h}" }
}

"${drawn(logo)} ${drawn(same)}"
