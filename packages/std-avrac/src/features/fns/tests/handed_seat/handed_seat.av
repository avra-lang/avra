// proves: a method handing its receiver to a fn its seat holds reads that seat's marks, an alias's
// as its shape's, so a receiver no `mut` mark reaches is read and never written.
alias Step = fn(Box, int) -> int

type Box = { n: int }

impl Box {
    fn stepped(step: Step) -> int { step(self, 2) }
    fn spelled(step: fn(Box, int) -> int) -> int { step(self, 3) }
}

let b = Box { n: 5 }
"${b.stepped((x: Box, k: int) -> x.n * k)} ${b.spelled((x: Box, k: int) -> x.n + k)} ${b.n}"
