// proves: a guard opened before the run was filed as a task still answers when the closure files it — the first
// task row of a program may run inside a `contained` closure — eval == native.
use @std.meta.{contained}

fn one() -> int { 1 }

fn files_the_root() -> bool {
    let t = spawn one()
    t.await == 1
}

fn shown(r: Result<bool, string>) -> string {
    match r { .Ok(b) -> "ok ${b}", .Err(w) -> "failed ${w}" }
}

println(shown(contained(files_the_root)))
println(shown(contained(files_the_root)))
