// proves: a generic fn whose type parameter only its answer names is
// laid out by the type the call's seat wants, in a match arm too.
fn fallback<T>(seed: T, n: int) -> T { if n > 0 { seed } else { fallback(seed, n + 1) } }

fn none_of<T>(n: int) -> T? { if n > 100 { none_of(n - 1) } else { null } }

fn pick(n: int) -> string? {
    match n { 0 -> "zero", _ -> none_of(n) }
}

fn count(n: int) -> int? {
    match n { 1 -> 7, _ -> none_of(n) }
}

"${pick(0) ?? "-"} ${pick(3) ?? "-"} ${count(1) ?? -1} ${count(2) ?? -1} ${fallback("s", 0)}"
