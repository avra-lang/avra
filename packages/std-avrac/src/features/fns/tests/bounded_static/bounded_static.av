// proves: a static fn through a bounded type parameter answers for the type filling it.
trait Named {
    fn name() -> string
    static fn kind() -> string
}

type Cat = { lives: int }

type Dog = { legs: int }

impl Named for Cat {
    fn name() -> string { "cat ${self.lives}" }
    static fn kind() -> string { "feline" }
}

impl Named for Dog {
    fn name() -> string { "dog ${self.legs}" }
    static fn kind() -> string { "canine" }
}

fn kind_of<T: Named>(_x: T) -> string { T.kind() }

"${kind_of(Cat { lives: 1 })} ${kind_of(Dog { legs: 2 })}"
