// proves: a generic fn's `mut` seat, handed a `mut` binding, writes
// through to it, under each layout its type parameter is laid out as.
fn twice_onto<T>(x: T, mut into: List<T>) {
    into.push(x)
    into.push(x)
}

mut ns: List<int> = [1]
twice_onto(7, ns)
mut ws: List<string> = []
twice_onto("a", ws)
twice_onto("b", ws)
"${ns.length} ${ns[2]} ${ws.join("")}"
