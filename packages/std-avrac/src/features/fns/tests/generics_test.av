// Generic fns, vertically: one abstract body checked once, one
// specialization lowered per instantiation (mono, ROADMAP rung 11
// G1). Unification is exact and by direct arguments; pins fill the
// rest; an unconstrained T can only MOVE.
use @std.avrac.testing.{shown, refused_with, refusals}

spec "features/fns/generics" {
    given "one recipe, many types" {
        then "the identity serves int" {
            shown("fn id<T>(x: T) -> T {\n    x\n}\nid(41) + 1") == "42"
        }
        then "the identity serves bool" {
            shown("fn id<T>(x: T) -> T {\n    x\n}\nid(true)") == "true"
        }
        then "the identity serves string" {
            shown("fn id<T>(x: T) -> T {\n    x\n}\nid(\"w\")") == "w"
        }
        then "a generic calls a generic — substitutions compose" {
            shown(
                "fn id<T>(x: T) -> T {\n    x\n}\nfn twice<T>(x: T) -> T {\n    id(id(x))\n}\ntwice(7)",
            ) == "7"
        }
        then "`List<T>` binds from the element" {
            shown(
                "fn head<T>(xs: List<T>, alt: T) -> T {\n    if !xs.is_empty() { xs[0] } else { alt }\n}\nhead([4, 5], 0)",
            ) == "4"
        }
        then "`T?` rides a generic signature" {
            shown(
                "fn or_else<T>(v: T?, alt: T) -> T {\n    v ?? alt\n}\nfn none_int() -> int? { null }\nor_else(none_int(), 9)",
            ) == "9"
        }
        then "`Result<T, E>` rides one too — and `?` inside the body" {
            shown(
                "enum E {\n    empty\n}\nfn head_or<T>(xs: List<T>) -> Result<T, E> {\n    if xs.is_empty() {\n        fail E.empty\n    }\n    xs[0]\n}\nhead_or([5]) catch 0 - 1",
            ) == "5"
        }
        then "an explicit pin fills what arguments cannot" {
            shown("fn id<T>(x: T) -> T {\n    x\n}\nid<int>(8)") == "8"
        }
        then "self-recursion at the same T terminates the worklist" {
            shown(
                "fn burn<T>(x: T, n: int) -> T {\n    if n == 0 {\n        return x\n    }\n    burn(x, n - 1)\n}\nburn(7, 50)",
            ) == "7"
        }
    }
    given "the fully-bound fallback — pins make a param concrete" {
        then "`null` rides a PINNED `T?` — the ordinary law judges it" {
            shown("fn or_else<T>(v: T?, alt: T) -> T {\n    v ?? alt\n}\nor_else<int>(null, 5)") == "5"
        }
        then "a plain value widens into a pinned `T?`" {
            shown("fn f<T>(v: T?, alt: T) -> T {\n    v ?? alt\n}\n2 + f<int>(5, 9)") == "7"
        }
        then "an UNPINNED `null` refuses and names the pin" {
            refused_with(
                "fn or_else<T>(v: T?, alt: T) -> T {\n    v ?? alt\n}\nor_else(null, 5)",
                "a bare `null` cannot pin `T`",
            )
        }
        then "comparisons survive the pinned-call branch everywhere" {
            shown("let a = 3\nlet b = 5\nif a < b { 1 } else { 0 }") == "1"
        }
        then "T binds through nested composites" {
            shown(
                "fn or_else<T>(v: T?, alt: T) -> T {\n    v ?? alt\n}\nfn some_int(v: int) -> int? { v }\nor_else(some_int(4), 0)",
            ) == "4"
        }
    }
    given "the abstract body — T can only move" {
        then "arithmetic on T refuses through the existing law — one voice per operand" {
            refusals("fn bad<T>(x: T) -> T {\n    x + x\n}\nbad(1)") == 2
        }
        then "a mut T cell works — each instantiation's cell is concrete" {
            shown("fn hold<T>(x: T, y: T) -> T {\n    mut c = x\n    c = y\n    c\n}\nhold(1, 9)") == "9"
        }
    }
    given "instantiation, refused in its own words" {
        then "arguments that disagree name the argument, in the type the first one bound" {
            refused_with(
                "fn pick<T>(a: T, b: T) -> T {\n    a\n}\npick(1, \"s\")",
                "argument 2 of `pick` wants `int`, found `string`",
            )
        }
        then "an unpinnable T says how to pin it" {
            refused_with(
                "fn zero<T>(n: int) -> int {\n    n\n}\nzero(5)",
                "`T` is not pinned by the arguments",
            )
        }
        then "a pin against a disagreeing argument refuses" {
            refused_with(
                "fn id<T>(x: T) -> T {\n    x\n}\nid<int>(\"s\")",
                "argument 1 of `id` wants `int`, found `string`",
            )
        }
        then "pins on a plain fn refuse" {
            refused_with(
                "fn plain(x: int) -> int {\n    x\n}\nplain<int>(5)",
                "`plain` takes no type arguments",
            )
        }
        then "a binding carries a nullable into a Result side, absence intact" {
            shown(
                "enum E {\n    empty\n}\nfn wrap<T>(x: T) -> Result<T, E> {\n    x\n}\nfn none_int() -> int? { null }\n(wrap(none_int()) catch _ -> 5) ?? 3",
            ) == "3"
        }
        then "a type parameter cannot take the language's names" {
            refused_with(
                "fn f<int>(x: int) -> int {\n    x\n}\nf(1)",
                "a type parameter cannot take `int`'s name",
            )
        }
        then "printing T waits for traits — MOVE only, conservatively" {
            refused_with(
                "fn tagged<T>(x: T) -> string {\n    \"v=\${x}\"\n}\ntagged(1)",
                "an interpolation hole prints as a scalar or string, found `T`",
            )
        }
        then "an empty list under a pin ADOPTS — the trigger fired at G3" {
            shown(
                "fn head<T>(xs: List<T>, alt: T) -> T {\n    if !xs.is_empty() { xs[0] } else { alt }\n}\nhead<int>([], 9)",
            ) == "9"
        }
    }
    given "a Var the arguments leave free is pinned by the answer's seat" {
        then "a typed let, a struct field, an argument seat and a declared answer each pin it" {
            shown(
                "fn empty<T>() -> List<T> {\n    []\n}\ntype Arena<N> = { nodes: List<N> }\nfn new_arena<N>() -> Arena<N> {\n    Arena { nodes: [] }\n}\ntype Store = { exprs: Arena<int>, names: Arena<string> }\nfn take(xs: List<int>) -> int {\n    xs.length\n}\nfn give() -> List<string> {\n    empty()\n}\nlet xs: List<int> = empty()\nlet st = Store { exprs: new_arena(), names: new_arena() }\nxs.length + st.exprs.nodes.length + take(empty()) + give().length",
            ) == "0"
        }
        then "a branch under a typed let pins it too — the call goes hungry until the seat speaks" {
            shown(
                "fn empty<T>() -> List<T> {\n    []\n}\nlet xs: List<int> = if true { empty() } else { [1] }\nxs.length",
            ) == "0"
        }
        then "with no seat it still says how to pin it" {
            refused_with(
                "fn empty<T>() -> List<T> {\n    []\n}\nlet xs = empty()\nxs.length",
                "`T` is not pinned by the arguments",
            )
        }
        then "a seat that disagrees with the pinned answer refuses as a binding does" {
            refused_with(
                "fn wrap<T>(v: T) -> List<T> {\n    [v]\n}\nlet xs: List<int> = wrap(\"s\")\nxs.length",
                "`xs` declares `List<int>`, this is `List<string>`",
            )
        }
    }
    given "a lambda in a generic seat answers what the seat says" {
        then "a seat its Vars make concrete refuses a lambda answering another type, in the bound type's words" {
            refused_with(
                "fn f<P>(p: P, g: fn(P) -> string) -> string {\n    g(p)\n}\nf(5, (x) -> 7)",
                "argument 2 of `f` wants `fn(int) -> string`, found `fn(int) -> int`",
            )
        }
        then "a trailing block is judged the same" {
            refused_with(
                "type Box<P> = { held: P }\nfn f<P>(p: P, g: fn(Box<P>) -> string) -> string {\n    g(Box { held: p })\n}\nf(5) { b -> b }",
                "the trailing block fills seat 2 of `f`, which takes `fn(Box<int>) -> string`, and the block is `fn(Box<int>) -> Box<int>`",
            )
        }
        then "once its seats are bound, a lambda's answer pins the Var they leave free" {
            shown(
                "type Box<P> = { p: P }\nfn f<P, T>(b: Box<P>, g: fn(Box<P>) -> T) -> T {\n    g(b)\n}\nf(Box { p: 2 }) { b -> b.p + 1 }",
            ) == "3"
        }
        then "a lambda whose body refuses pins nothing, and the call says nothing more" {
            refusals("fn f<P, T>(p: P, g: fn(P) -> T) -> T {\n    g(p)\n}\nf(1) { x -> x.nope }") == 1
        }
        then "a lambda answering the seat's type passes" {
            shown(
                "fn f<P>(p: P, g: fn(P) -> string) -> string {\n    g(p)\n}\nf(5) { x -> \"n\${x}\" }",
            ) == "n5"
        }
    }
}
