// proves: a guard catches a trap on ITS OWN task only — a spawned task
// that traps while the main task holds a guard still ends the process,
// saying so
use @std.meta.{contained}

fn boom() -> int {
    let xs = [1]
    let i = 4
    xs[i]
}

fn slow() -> int {
    let t = spawn boom()
    t.await
}

match contained(slow) {
    .Ok(n) -> println("not reached ${n}"),
    .Err(w) -> println("not reached ${w}"),
}
