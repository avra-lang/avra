// `self` ON A VALUE BUILT FROM STATIC DATA: the receiver's caller opens it, so the write never
// reaches the binary's own data.
type Bag = { items: List<int> }

impl Bag {
    fn add(v: int) { self.items.push(v) }
}

const start: Bag = Bag { items: [1] }

mut b = start
b.add(2)
b.add(3)
"${b.items.length} ${start.items.length} ${b.items[2]}"
