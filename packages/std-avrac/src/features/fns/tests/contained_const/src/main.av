// proves: a const's settlement is the OUTER guard of the machine's one trap path —
// a `contained` inside the const catches its own trap and the const settles on the
// words; both engines
use @std.meta.{contained}

fn bad() -> bool {
    let xs = [1, 2]
    let i = 5
    xs[i] == 3
}

fn worded(r: Result<bool, string>) -> string {
    match r { .Ok(ran) -> "ok ${ran}", .Err(words) -> "err ${words}" }
}

const CAUGHT: string = worded(contained(bad))

CAUGHT
