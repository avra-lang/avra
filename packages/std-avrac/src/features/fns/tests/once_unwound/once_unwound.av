// proves: a `once fn` whose body is unwound by a cancel keeps nothing —
// an unwind answers nothing, so the next call runs the body again and
// keeps what that run answers.
use @std.task.{open_channel, Channel}
use @std.time.{secs, sleep}

once fn ready() -> Channel<int> {
    open_channel<int>(1)
}

once fn gate() -> Cell<int> {
    Cell.new(0)
}

once fn sleepy() -> List<int> {
    println("sleepy")
    let _ = ready().sink.post(1)
    if gate().get() == 0 { sleep(secs(60)) }
    [7]
}

let t = spawn sleepy()
let _ = ready().source.next()
gate().set(1)
t.cancel()
let first = t.await catch c -> [0]
"${first[0]} ${sleepy()[0]} ${sleepy()[0]}"
