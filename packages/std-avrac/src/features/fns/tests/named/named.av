// A CALL MAY NAME ITS SEATS: a named argument fills the seat of its
// name, a positional one the seat at its own position, and a seat no
// argument writes runs its default. Arguments run in WRITTEN order.
type Log = { xs: List<string> }

fn note(mut l: Log, s: string) -> int {
    l.xs.push(s)
    l.xs.length
}

fn sub(a: int, b: int) -> int { a - b }

fn dims(w: int, h: int = 2, d: int = 3) -> string { "${w}x${h}x${d}" }

fn put(n: int, mut xs: List<int>) { xs.push(n) }

type Box = { n: int }

impl Box {
    fn scaled(by: int = 1, plus: int = 0) -> int { self.n * by + plus }

    mut fn bump(by: int = 1) { self.n = self.n + by }

    static fn make(n: int = 1, scale: int = 1) -> Box { Box { n: n * scale } }
}

fn run() -> string {
    mut log = Log { xs: [] }
    let pair = sub(b: note(log, "b"), a: note(log, "a"))
    mut ys: List<int> = []
    put(xs: ys, n: 4)
    mut bx = Box.make(scale: 5)
    bx.bump(by: 2)
    let parts = [
        "${sub(b: 1, a: 5)}", "${sub(5, b: 1)}",
        dims(1, d: 9), dims(d: 7, w: 4), dims(1, 5),
        "${pair} ${log.xs.join(",")}", "${ys[0]}",
        "${bx.n}", "${bx.scaled(plus: 3)}", "${bx.scaled(plus: 1, by: 2)}",
    ]
    parts.join(" ")
}

run()
