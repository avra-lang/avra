// proves: a bounded type parameter boxes as a `dyn` of its bound, each fill with its own methods.
trait Named {
    fn name() -> string
    static fn kind() -> string
}

type Cat = { lives: int }

type Dog = { legs: int }

impl Named for Cat {
    fn name() -> string { "cat ${self.lives}" }
    static fn kind() -> string { "feline" }
}

impl Named for Dog {
    fn name() -> string { "dog ${self.legs}" }
    static fn kind() -> string { "canine" }
}

fn boxed<T: Named>(x: T) -> string {
    let d: dyn Named = x
    d.name()
}

"${boxed(Cat { lives: 1 })} ${boxed(Dog { legs: 2 })}"
