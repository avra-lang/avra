// proves: `Name(value)` crossing into a named type is the value itself,
// in a fn, a method and the entry, over a text and a number.
type Tag = string
type Id = int

type Namer = { prefix: string }

impl Namer {
    fn tagged(word: string) -> Tag { Tag("${self.prefix}${word}") }
}

fn bumped(n: int) -> Id { Id(n + 1) }

fn shown(t: Tag) -> string { "<${t}>" }

let n = Namer { prefix: "x-" }
"${shown(n.tagged("a"))} ${bumped(41)} ${Id(7)} ${shown(Tag("b"))}"
