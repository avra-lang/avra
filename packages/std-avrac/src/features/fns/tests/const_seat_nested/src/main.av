// proves: a plain fn's settled seat makes a body of its own — a `const`
// inside it settles per seat value, read through the call that settled it.
fn fold_inner(const x: int) -> int {
    const z = x + 1
    z
}

fn tagged(const p: string) -> string {
    const t = p + "!"
    t
}

"${fold_inner(3)} ${fold_inner(9)} ${tagged("a")}"
