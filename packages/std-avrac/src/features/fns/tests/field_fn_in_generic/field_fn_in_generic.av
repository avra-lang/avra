// proves: a fn-valued field called in a generic body answers the body's own type
// parameter, as its record names it — whether or not the call stands where a type
// is expected: as an operand, in a `let`, through an index.
type Src<T> = { take: fn() -> T? }

fn has<T>(s: Src<T>) -> bool { s.take() != null }

fn first<T>(xs: List<Src<T>>) -> T? {
    let v = xs[0].take()
    v
}

let a = Src<int> { take: () -> 7 }
let b = Src<int> { take: () -> null }
"${has(a)} ${has(b)} ${first([a]) ?? 0} ${first([b]) ?? 0}"
