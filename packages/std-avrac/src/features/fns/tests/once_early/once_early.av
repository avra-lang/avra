// proves: a `once fn` whose body leaves by an early `return` keeps that
// answer, as it keeps its tail's: each body runs once, and the second
// call answers what the first kept.
once fn early() -> List<int> {
    println("early")
    if true { return [1] }
    [2]
}

once fn tail() -> List<int> {
    println("tail")
    if false { return [0] }
    [2]
}

once fn looped() -> string {
    println("looped")
    mut i = 0
    while i < 5 {
        i = i + 1
        if i == 3 { return "at ${i}" }
    }
    "none"
}

"${early()[0]}${early()[0]} ${tail()[0]}${tail()[0]} ${looped()} ${looped()}"
