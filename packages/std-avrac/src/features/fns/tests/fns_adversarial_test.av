// The RED TEAM's permanent record for fns — declarations, calls,
// params, returns. Every program here was written to BREAK the
// feature, not to use it.
use @std.avrac.compiler.{analyze_source}
use @std.avrac.testing.{refused_with, refused_at_run, shown, refusals, ir_of, halver}

spec "features/fns (adversarial)" {
    given "a seat's default — degenerate shapes" {
        then "every seat defaulted, and none written" {
            shown(
                "fn f(a: int = 1, b: int = 2, c: int = 3) -> int { a * 100 + b * 10 + c }\nf() + f(9)",
            ) == "1046"
        }
        then "a default that answers nothing refuses at its seat" {
            refused_with(
                "fn v() {\n}\nfn f(a: int = v()) -> int { a }\nf()",
                "parameter `a` defaults to `void`, and it is `int`",
            )
        }
        then "an empty aggregate fills its seat's want" {
            shown(
                "fn f(xs: List<string> = [], m: Map<string, int> = {}) -> int { xs.length + m.length }\nf()",
            ) == "0"
        }
    }
    given "a seat's default — every kind of value it may be" {
        then "absence, a bare variant, a lambda and a boxed contract" {
            shown(
                "enum K { A, B }\nfn f(k: K = .B, n: int? = null, g: fn(int) -> int = (x: int) -> x + 1) -> int { match k { .A -> 0, .B -> g(n ?? 1) } }\nf()",
            ) == "2"
        }
        then "`null` at a seat that holds no absence refuses" {
            refused_with(
                "fn f(a: int = null) -> int { a }\nf()",
                "parameter `a` defaults to `null`, and it is `int`",
            )
        }
    }
    given "a seat's default — the positions that take none" {
        then "an extern's seat" {
            refusals("extern fn g(a: int = 1) -> int\n0") == 1
        }
        then "a trait's seat" {
            refusals("trait T { fn m(a: int = 1) -> int }\n0") == 1
        }
        then "a lambda's seat" {
            refusals("let h = (a: int = 1) -> a\n0") == 2
        }
    }
    given "a seat's default — names against names" {
        then "two types' methods of one name keep their own defaults" {
            shown(
                "type P = { x: int }\ntype Q = { x: int }\nimpl P { fn m(k: int = 1) -> int { self.x + k } }\nimpl Q { fn m(k: int = 100) -> int { self.x + k } }\nP { x: 0 }.m() + Q { x: 0 }.m()",
            ) == "101"
        }
        then "a free fn and a method of one name keep their own defaults" {
            shown(
                "fn m(k: int = 5) -> int { k }\ntype P = { x: int }\nimpl P { fn m(k: int = 1) -> int { self.x + k } }\nm() * 10 + P { x: 0 }.m()",
            ) == "51"
        }
        then "a default names a fn declared after it" {
            shown("fn f(a: int = later()) -> int { a }\nfn later() -> int { 11 }\nf()") == "11"
        }
        then "a method's default has no receiver — it is a body of its own" {
            refused_with(
                "type P = { x: int }\nimpl P { fn m(k: int = self.x) -> int { k } }\nP { x: 3 }.m()",
                "`self` names a method's receiver — a default is a body of its own, and has none",
            )
        }
        then "and the remedy it names compiles as written" {
            shown(
                "type P = { x: int }\nimpl P { fn m(k: int? = null) -> int { k ?? self.x } }\nP { x: 3 }.m() * 10 + P { x: 3 }.m(5)",
            ) == "35"
        }
        then "a `static fn` keeps its own words for the same read" {
            refused_with(
                "type P = { x: int }\nimpl P { static fn s() -> int { self.x } }\n0",
                "a `static fn` has none",
            )
        }
    }
    given "a seat's default — crossed with other features" {
        then "a recursive call leaves its accumulator to the default" {
            shown(
                "fn f(n: int, acc: int = 0) -> int { if n == 0 { acc } else { f(n - 1, acc + n) } }\nf(10)",
            ) == "55"
        }
        then "a default beside a `mut` seat and a `const` seat" {
            shown(
                "fn f(const k: int, mut xs: List<int>, n: int = 7) { xs.push(k + n) }\nmut ys: List<int> = []\nf(1, ys)\nf(1, ys, 2)\nys[0] * 10 + ys[1]",
            ) == "83"
        }
        then "a trailing block fills its fn seat, and the seat after it defaults" {
            shown(
                "fn f(x: int, g: fn(int) -> int, k: int = 100) -> int { g(x) + k }\nf(1) { it + 1 }",
            ) == "102"
        }
        then "a trailing block never fills a defaulted non-fn seat" {
            refused_with(
                "fn f(a: int, n: int = 1) -> int { a + n }\nf(1) { 2 }",
                "the trailing block fills seat 2 of `f`, which takes `int`",
            )
        }
        then "a call through `?` leaves a seat to its default" {
            shown(
                "fn f(a: int = 1) -> Result<int, string> { .Ok(a) }\nfn g() -> Result<int, string> {\n    let x = f()?\n    .Ok(x + 1)\n}\ng() catch e -> 0",
            ) == "2"
        }
    }
    given "a seat's default — arity at every call shape" {
        then "a method handed too many" {
            refused_with(
                "type C = { n: int }\nimpl C { fn plus(k: int = 1) -> int { self.n + k } }\nC { n: 1 }.plus(1, 2)",
                "`C.plus` takes 0 to 1 arguments, found 2",
            )
        }
        then "a static handed too many" {
            refused_with(
                "type C = { n: int }\nimpl C { static fn make(n: int = 7) -> C { C { n: n } } }\nC.make(1, 2).n",
                "`C.make` takes 0 to 1 arguments, found 2",
            )
        }
    }
    given "a named argument — every way to write a seat twice or not at all" {
        then "a name and the positional argument at its place" {
            refused_with(
                "fn sub(a: int, b: int) -> int { a - b }\nsub(1, a: 2)",
                "seat `a` of `sub` is written twice",
            )
        }
        then "one name written twice" {
            refused_with(
                "fn sub(a: int, b: int) -> int { a - b }\nsub(a: 1, a: 2)",
                "seat `a` of `sub` is written twice",
            )
        }
        then "a positional argument after a name, landing on the named seat" {
            refused_with(
                "fn sub(a: int, b: int) -> int { a - b }\nsub(b: 1, 5)",
                "seat `b` of `sub` is written twice",
            )
        }
        then "a positional argument past every seat, beside a name" {
            refused_with(
                "fn sub(a: int, b: int) -> int { a - b }\nsub(a: 1, b: 2, 3)",
                "`sub` takes 2 arguments, found 3",
            )
        }
        then "a named value its seat does not accept" {
            refused_with(
                "fn sub(a: int, b: int) -> int { a - b }\nsub(a: \"x\", b: 2)",
                "argument 1 of `sub` wants `int`, found `string`",
            )
        }
    }
    given "a named argument — callees whose seats have no names" {
        then "a runtime method" {
            refused_with(
                "let xs = [1]\nxs.push(v: 2)\n0",
                "`v:` names a seat, and `push`'s seats have no names",
            )
        }
        then "an applied value" {
            refused_with(
                "let f = (x: int) -> x\nf(x: 1)",
                "`x:` names a seat, and `f`'s seats have no names",
            )
        }
        then "an extern" {
            refused_with(
                "extern fn strlen(s: string) -> int\nstrlen(s: \"a\")",
                "`s:` names a seat, and `strlen`'s seats have no names",
            )
        }
        then "an extern handed too few arguments refuses — it names no seat, so none defaults" {
            refused_with(
                "extern fn strlen(s: string) -> int\nstrlen()",
                "`strlen` takes 1 arguments, found 0",
            )
        }
    }
    given "a named argument — crossed with other features" {
        then "a `mut` seat written by name writes through" {
            shown(
                "fn put(mut xs: List<int>, n: int) { xs.push(n) }\nmut ys: List<int> = []\nput(n: 4, xs: ys)\nput(ys, n: 5)\nys[0] * 10 + ys[1]",
            ) == "45"
        }
        then "a `const` seat written by name settles" {
            shown("fn k(const n: int, m: int) -> int { n * m }\nk(m: 3, n: 4)") == "12"
        }
        then "a generic fn's seats take names" {
            shown("fn g<T>(x: T, n: int) -> T { x }\ng(n: 2, x: 7)") == "7"
        }
        then "a trailing block fills its seat beside named ones" {
            shown(
                "fn ap(x: int, f: fn(int) -> int, k: int = 100) -> int { f(x) + k }\nap(x: 1) { it + 1 }",
            ) == "102"
        }
        then "a named call through `?`" {
            shown(
                "fn f(a: int = 1) -> Result<int, string> { .Ok(a) }\nfn g() -> Result<int, string> {\n    let x = f(a: 5)?\n    .Ok(x)\n}\ng() catch e -> 0",
            ) == "5"
        }
        then "the pronoun rides a named argument and keeps its name" {
            shown(
                "type C = { n: int }\nimpl C { fn ap(x: int, f: fn(int) -> int) -> int { f(x) + self.n } }\nC { n: 1 }.ap(f: it * 2, x: 3)",
            ) == "7"
        }
        then "a method handing its field to a `mut` seat by name writes its receiver" {
            refusals(
                "type B = { xs: List<int> }\nfn put(n: int, mut xs: List<int>) { xs.push(n) }\nimpl B {\n    mut fn add(n: int) { put(xs: self.xs, n: n) }\n}\n0",
            ) == 0
        }
    }
    given "`return` under attack — depths, tails, boundaries" {
        then "TWO loop depths unwind at once" {
            shown(
                "fn f(n: int) -> int {\n    mut i = 0\n    while i < n {\n        mut j = 0\n        while j < n {\n            if i * j == 6 {\n                return i * 10 + j\n            }\n            j = j + 1\n        }\n        i = i + 1\n    }\n    0 - 1\n}\nf(5) + f(2)",
            ) == "22"
        }
        then "the tail after a certain return is UNREACHABLE but still typed" {
            shown("fn f() -> int {\n    return 1\n    2\n}\nf()") == "1" &&
                refused_with(
                    "fn f() -> int {\n    return 1\n    \"tail\"\n}\nf()",
                    "the body answers `string` but `f` declares `int`",
                )
        }
        then "the guard-then-bang reads straight: absence answered, then insisted" {
            shown(
                "${halver}fn f(v: int?) -> int {\n    if v == null {\n        return 0 - 1\n    }\n    v!\n}\nf(half(4)) + f(half(3))",
            ) == "1"
        }
        then "a return at the TOP LEVEL is told where answers live" {
            refused_with(
                "mut i = 0\nwhile i < 3 {\n    return 5\n    i = i + 1\n}\ni",
                "a `return` answers a fn, and there is none enclosing",
            )
        }
        then "a return ENDS an expression block — divergence-aware tails" {
            // The trigger fired with the error spine: a block that
            // LEAVES needs no tail, and answers what the fn
            // promises — so it joins only where that type fits.
            shown(
                "${halver}fn f(id: int) -> int {\n    let got = if let v? = half(id) {\n        v\n    } else {\n        return 0 - 1\n    }\n    got * 10\n}\nf(8) + f(3)",
            ) == "39"
        }
    }
    given "the parameter list, at every size" {
        then "zero parameters answer" {
            shown("fn f() -> int { 7 }\nf()") == "7"
        }
        then "eight parameters all arrive, first and last" {
            shown(
                "fn f(a: int, b: int, c: int, d: int, e: int, g: int, h: int, i: int) -> int { a + i }\nf(1, 2, 3, 4, 5, 6, 7, 8)",
            ) == "9"
        }
        then "a name declared TWICE is refused, as a field or variant would be" {
            let a = analyze_source("fn f(a: int, a: int) -> int { a }\nf(1, 2)")
            a.diagnostics.length == 1 && a.report().contains("declares `a` more than once")
        }
        then "each EXTRA copy speaks — the same count a record gives" {
            refusals("fn f(a: int, a: int, a: int) -> int { a }\nf(1, 2, 3)") == refusals("type P = { x: int, x: int, x: int }\n1")
        }
        then "two DIFFERENT names are fine" {
            shown("fn f(a: int, b: int) -> int { a + b }\nf(1, 2)") == "3"
        }
    }
    given "arity at the call" {
        then "too few arguments refuses" {
            refusals("fn f(a: int, b: int) -> int { a }\nf(1)") == 1
        }
        then "too many arguments refuses" {
            refusals("fn f(a: int) -> int { a }\nf(1, 2)") == 1
        }
    }
    given "declarations against each other" {
        then "a duplicate fn is refused once" {
            refusals("fn f() -> int { 1 }\nfn f() -> int { 2 }\nf()") == 1
        }
        then "a call may precede its declaration — fns are program-wide" {
            shown("f()\nfn f() -> int { 1 }") == "1"
        }
        then "mutual recursion terminates" {
            shown(
                "fn a(n: int) -> int { if n <= 0 { 0 } else { b(n - 1) } }\nfn b(n: int) -> int { a(n - 1) }\na(4)",
            ) == "0"
        }
        then "a parameter may shadow a fn name" {
            shown("fn f(f: int) -> int { f }\nf(3)") == "3"
        }
        then "a nested declaration refuses — fns live at the top level" {
            let a = analyze_source("fn f() -> int {\n    fn g() -> int { 1 }\n    g()\n}\nf()")
            a.diagnostics.length == 2 && a.report().contains("live at the top level")
        }
    }
    given "the body against its declared return" {
        then "a disagreeing body refuses" {
            refusals("fn f() -> int { true }\nf()") == 1
        }
        then "an empty body is void — a declared return refuses it" {
            refused_with("fn f() -> int { }\nf()", "the body answers `void` but `f` declares `int`")
        }
    }
    given "the body floor — a fn sees declarations, never the top level's values" {
        then "a read refuses once, naming the remedy" {
            refused_with(
                "let k = 5\nfn f(n: int) -> int {\n    n + k\n}\nf(1)",
                "`k` is a run-time binding of the top level",
            )
        }
        then "an assignment refuses the same way" {
            refused_with(
                "mut k = 1\nfn f() -> int {\n    k = 2\n    3\n}\nf()",
                "`k` is a run-time binding of the top level",
            )
        }
        then "a binding declared AFTER the fn is hidden too — not `used before its definition`" {
            refused_with(
                "fn f() -> int {\n    k\n}\nlet k = 1\nf()",
                "`k` is a run-time binding of the top level",
            )
        }
        then "inside a nested block and a lambda of the body — one refusal" {
            refusals(
                "let k = 1\nfn f() -> int {\n    if true {\n        let g = () -> k\n        g()\n    } else {\n        0\n    }\n}\nf()",
            ) == 1
        }
        then "a param or a local of the same name shadows nothing — it simply binds" {
            shown("let k = 1\nfn f(k: int) -> int {\n    let j = k + 1\n    j\n}\nf(41) + k") == "43"
        }
        then "a METHOD body stands on the same floor" {
            refused_with(
                "type P = { x: int }\nlet k = 3\nimpl P {\n    fn m() -> int {\n        k\n    }\n}\nP { x: 1 }.m()",
                "`k` is a run-time binding of the top level",
            )
        }
    }
    given "`once` under attack — what a settled answer may be" {
        then "arguments refuse: a once answer is one value for the process" {
            refused_with(
                "once fn f(a: int) -> string {\n    \"x\"\n}\nf(1)",
                "`once fn f` takes arguments — a `once` answer is one value for the whole process",
            )
        }
        then "a scalar answer refuses — the runtime keeps no copies" {
            refused_with(
                "once fn n() -> int {\n    1\n}\nn()",
                "`once fn n` answers `int`, which the runtime cannot keep",
            )
        }
        then "a void answer refuses in the same words" {
            refused_with(
                "once fn f() {\n}\n1",
                "`once fn f` answers `void`, which the runtime cannot keep",
            )
        }
        then "a record of one scalar field travels as the field, and refuses" {
            refused_with(
                "type P = { x: int }\nonce fn p() -> P {\n    P { x: 1 }\n}\np().x",
                "`once fn p` answers `P`, which the runtime cannot keep",
            )
        }
        then "a wider record is the runtime's, and settles" {
            shown(
                "type P = { x: int, y: int }\nonce fn p() -> P {\n    P { x: 5, y: 2 }\n}\np().x + p().y",
            ) == "7"
        }
        then "a method cannot be `once` — its answer would depend on a receiver" {
            refused_with(
                "type P = { x: int }\nimpl P {\n    once fn tag() -> string {\n        \"p\"\n    }\n}\nP { x: 1 }.tag()",
                "`once fn tag` is a method — its answer would depend on a receiver",
            )
        }
        then "each refusal speaks once" {
            refusals("once fn f(a: int) -> int {\n    a\n}\nf(1)") == 1
        }
        then "a MARKED parameter loses no law — the same words, not a parse error" {
            refused_with(
                "once fn f(mut x: List<int>) -> string {\n    \"a\"\n}\n1",
                "`once fn f` takes arguments — a `once` answer is one value for the whole process",
            )
        }
        then "an absent answer is honest — it settles nothing and stays absent" {
            shown("once fn t() -> string? {\n    null\n}\nt() ?? \"absent\"") == "absent"
        }
    }
    given "wrong types in every extern slot — the host seat law's third arm" {
        // THE SEAT SIDE WAS HELD AND THE ANSWER SIDE WAS NOT. A
        // record, an enum, a `dyn` or a `Bytes` answered by a non-row
        // extern checked CLEAN, and then the evaluator said `defect:`
        // while the native binary SEGFAULTED — one user mistake, two
        // internal failures, in two different ways.
        then "a record ANSWER refuses — a foreign pointer is not a box in our layout" {
            refused_with(
                "type R = { a: int, b: int }\nextern fn c_get() -> R\nc_get().a",
                "the answer of `c_get` wears `R`, which cannot cross to C",
            )
        }
        then "an enum answer refuses in the same words" {
            refused_with(
                "enum E { A, B }\nextern fn c_get() -> E\nc_get() is .A",
                "the answer of `c_get` wears `E`, which cannot cross to C",
            )
        }
        then "a `dyn` answer refuses" {
            refused_with(
                "trait Show {\n    fn show() -> string\n}\nextern fn c_get() -> dyn Show\nc_get().show()",
                "the answer of `c_get` wears `dyn Show`, which cannot cross to C",
            )
        }
        then "a `Bytes` answer refuses — no length crosses back" {
            refused_with(
                "extern fn c_get() -> Bytes\nc_get().length",
                "the answer of `c_get` wears `Bytes`, which cannot cross to C",
            )
        }
        then "a ROW answering `Bytes` is the exemption, and stands" {
            refusals("extern fn avra_fd_taken(token: int) -> Bytes\n1") == 0
        }
        then "every answer the frame reads back is taken" {
            refusals(
                "extern fn c_w() -> int\nextern fn c_n(x: int) -> i32\nextern fn c_u(x: int) -> u32\n" +
                    "extern fn c_l(x: int) -> i64\nextern fn c_f(x: int) -> f64\nextern fn c_g(x: int) -> float\n" +
                    "extern fn c_b(x: int) -> bool\nextern fn c_s(x: int) -> string\nextern fn c_o(x: int) -> string?\n" +
                    "extern fn c_p(x: int) -> ptr\nextern fn c_q(x: int) -> ptr?\nextern fn c_v(x: int)\n1",
            ) == 0
        }
        then "a `void` SEAT refuses — the frame calls it a defect and LLVM refuses the module" {
            refused_with(
                "extern fn c_take(x: void) -> int\n1",
                "seat 1 of `c_take` wears `void`, which cannot cross to C",
            )
        }
        then "one mistake in the answer earns one message" {
            refusals("type R = { a: int, b: int }\nextern fn c_get() -> R\n1") == 1
        }
        then "a seat and an answer that both refuse speak once each" {
            refusals("type R = { a: int, b: int }\nextern fn c_get(x: R) -> R\n1") == 2
        }
    }
    given "degenerate shapes at the extern frame — N=0, N=1, N=max" {
        // The INTEGER file's bound is pinned in fns_test.av at 11.
        // The FP file has its own, and had no case: the two are
        // counted separately, so a rule that read one for both would
        // pass every test in the tree.
        then "the FP file carries eight seats" {
            shown(
                "extern fn avra_selfhost_argc(a: f64, b: f64, c: f64, d: f64, e: f64, f: f64, g: f64, h: f64) -> int\n" +
                    "avra_selfhost_argc(1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5, 8.5) >= 1",
            ) == "true"
        }
        then "the NINTH is past the file, and says so" {
            refused_at_run(
                "extern fn avra_selfhost_argc(a: f64, b: f64, c: f64, d: f64, e: f64, f: f64, g: f64, h: f64, i: f64) -> int\n" +
                    "avra_selfhost_argc(1.5, 2.5, 3.5, 4.5, 5.5, 6.5, 7.5, 8.5, 9.5) >= 1",
                "takes more seats than one frame carries",
            )
        }
        then "no seats at all is a call, not a special case" {
            shown("extern fn avra_selfhost_argc() -> int\navra_selfhost_argc() >= 1") == "true"
        }
        then "an EMPTY string crosses as itself, not as absence" {
            shown("extern fn avra_str_len(s: string) -> int\navra_str_len(\"\")") == "0"
        }
        then "empty octets cross as themselves" {
            shown(
                "extern fn avra_bytes_len(b: Bytes) -> int\nlet e: Bytes = \"\".bytes()\navra_bytes_len(e)",
            ) == "0"
        }
        then "a one-character symbol is asked for by that name" {
            refused_at_run(
                "extern fn q() -> int\nq() > 0",
                "`q` is extern and this image does not carry it",
            )
        }
        then "an extern DECLARED and never called asks no symbol" {
            shown("extern fn no_such_symbol_anywhere(x: int) -> int\n7") == "7"
        }
    }
    given "the extern host crossed with every other feature" {
        then "a loop calls it every turn — the symbol memo answers the same address" {
            shown(
                "extern fn avra_host_is_dir(p: string) -> int\nmut n = 0\nmut i = 0\nwhile i < 3 {\n    n = n + avra_host_is_dir(\"packages\")\n    i = i + 1\n}\nn",
            ) == "3"
        }
        then "a comprehension over a list of paths" {
            shown(
                "extern fn avra_host_is_dir(p: string) -> int\nlet xs = [avra_host_is_dir(p) for p in [\"packages\", \"no-such-directory\"]]\nxs[0] - xs[1]",
            ) == "1"
        }
        then "recursion reaches it at the floor" {
            shown(
                "extern fn avra_host_is_dir(p: string) -> int\nfn down(n: int) -> int {\n    if n <= 0 {\n        return avra_host_is_dir(\"packages\")\n    }\n    down(n - 1)\n}\ndown(20)",
            ) == "1"
        }
        then "a lambda holds the call" {
            shown(
                "extern fn avra_host_is_dir(p: string) -> int\nlet f = (p: string) -> avra_host_is_dir(p)\nf(\"packages\")",
            ) == "1"
        }
        then "one extern's ANSWER fills another's seat" {
            shown(
                "extern fn avra_selfhost_get_arg_cstr(i: int) -> string\nextern fn avra_str_len(s: string) -> int\navra_str_len(avra_selfhost_get_arg_cstr(0)) > 0",
            ) == "true"
        }
    }
    given "an extern read as a value — under attack" {
        then "a struct field seat reads it bare" {
            refused_with(
                "extern fn avra_host_is_dir(path: string) -> int\ntype Box = { f: fn(string) -> int }\nlet b = Box { f: avra_host_is_dir }\n1",
                "an extern fn is not a value",
            )
        }
        then "a comprehension element reads it bare" {
            refused_with(
                "extern fn avra_host_is_dir(path: string) -> int\nlet xs = [avra_host_is_dir for n in [1, 2]]\n1",
                "an extern fn is not a value",
            )
        }
        then "a `mut`-seat extern is refused the same way — the marks change nothing" {
            refused_with(
                "extern fn avra_selfhost_argc(mut out: i64) -> int\nlet f = avra_selfhost_argc\n1",
                "an extern fn is not a value",
            )
        }
        then "the misuse does not cascade onto an ordinary call of the same symbol" {
            let a = analyze_source(
                "extern fn avra_host_is_dir(path: string) -> int\nlet f = avra_host_is_dir\navra_host_is_dir(\"packages\") > 0",
            )
            a.diagnostics.length == 1
        }
        then "a value read behind a lambda barrier is still caught" {
            refused_with(
                "extern fn avra_host_is_dir(path: string) -> int\nlet g = () -> {\n    let f = avra_host_is_dir\n    1\n}\ng()",
                "an extern fn is not a value",
            )
        }
        then "a runtime-row extern is a value no less than a plain one" {
            refused_with(
                "extern fn avra_now_ns() -> int\nlet f = avra_now_ns\n1",
                "an extern fn is not a value",
            )
        }
        then "a `mut let` holding it is still the declaration's own refusal" {
            refused_with(
                "extern fn avra_host_is_dir(path: string) -> int\nmut f = avra_host_is_dir\n1",
                "an extern fn is not a value",
            )
        }
        then "an assignment reads it bare too, not only a `let`" {
            refused_with(
                "extern fn avra_host_is_dir(path: string) -> int\nfn other(x: string) -> int { 1 }\nmut f = other\nf = avra_host_is_dir\n1",
                "an extern fn is not a value",
            )
        }
        then "a `once fn` body reading it bare is caught the same way" {
            refused_with(
                "extern fn avra_host_is_dir(path: string) -> int\nonce fn seed() -> string {\n    let f = avra_host_is_dir\n    \"x\"\n}\nseed()",
                "an extern fn is not a value",
            )
        }
        then "a fn's own tail — the extern wearing a fn-typed return" {
            refused_with(
                "extern fn avra_host_is_dir(path: string) -> int\nfn make() -> fn(string) -> int { avra_host_is_dir }\n1",
                "an extern fn is not a value",
            )
        }
        then "TWO independent misuses answer TWO diagnostics, each at its own read — not a cascade" {
            let a = analyze_source(
                "extern fn avra_host_is_dir(path: string) -> int\nlet f = if true { avra_host_is_dir } else { avra_host_is_dir }\n1",
            )
            a.diagnostics.length == 2 &&
                a.report().contains(":2:19") &&
                a.report().contains(":2:45")
        }
        then "a LOCAL shadowing the extern's own name is read as the local, not refused" {
            shown(
                "extern fn avra_host_is_dir(path: string) -> int\nfn shadow() -> int {\n    let avra_host_is_dir = 5\n    avra_host_is_dir\n}\nshadow()",
            ) == "5"
        }
    }
    given "ownership across the extern seam — a pointer the callee owns" {
        // A foreign `const char*` answered as `string` is text with
        // no header of ours in front of it. It is BORROWED, so a
        // retain or a release on it would read memory that is not
        // ours — measured clean under AVRA_RC_GUARD and AVRA_MEM_STATS,
        // held, joined, stored and dropped.
        then "a foreign answer survives being held and joined" {
            shown(
                "extern fn avra_selfhost_get_arg_cstr(i: int) -> string\nfn held() -> int {\n    let a = avra_selfhost_get_arg_cstr(0)\n    let b = a + \"!\"\n    b.length - a.length\n}\nheld()",
            ) == "1"
        }
        then "a foreign answer stored in a list outlives the loop that made it" {
            shown(
                "extern fn avra_selfhost_get_arg_cstr(i: int) -> string\nmut xs: List<string> = []\nmut i = 0\nwhile i < 20 {\n    xs.push(avra_selfhost_get_arg_cstr(0))\n    i = i + 1\n}\nxs.length",
            ) == "20"
        }
        then "a foreign answer stored in a record survives the fn that made it" {
            shown(
                "type Held = { text: string }\nextern fn avra_selfhost_get_arg_cstr(i: int) -> string\nfn kept() -> Held {\n    Held { text: avra_selfhost_get_arg_cstr(0) }\n}\nkept().text.length > 0",
            ) == "true"
        }
        then "a cell holding a foreign answer takes an owned box back" {
            shown(
                "extern fn avra_selfhost_get_arg_cstr(i: int) -> string\nmut s = \"an owned box\"\ns = avra_selfhost_get_arg_cstr(0)\ns = \"another\"\ns",
            ) == "another"
        }
        then "octets minted only to be staged outlive the call" {
            shown(
                "extern fn avra_bytes_len(b: Bytes) -> int\navra_bytes_len((\"ab\" + \"cd\").bytes())",
            ) == "4"
        }
    }
    given "the `const` seat under attack" {
        then "N=0 — `fn(const)` marks no name, and refuses" {
            refusals("fn f(const) -> int {\n    0\n}") == 2
        }
        then "a settled seat with NO type is the ordinary missing-type law" {
            refused_with("fn f(const x) -> int {\n    0\n}", "parameter `x` declares no type")
        }
        then "the marks have ONE order — `mut const` is not `const mut`" {
            refusals("fn f(mut const x: int) -> int {\n    x\n}") == 2
        }
        then "`const` is not a TYPE — it cannot stand where one belongs" {
            refused_with("fn f(x: const) -> int {\n    0\n}", "`const` names no type")
        }
        then "a `const mut` seat is a mark AND a write — both laws still speak" {
            refusals("fn f(const mut x: int) -> int {\n    x\n}\nf(1)") == 2
        }
        then "a plain seat refuses a settled callee in a CALL argument too" {
            refused_with(
                "fn takes(f: fn(int) -> int) -> int {\n    f(1)\n}\nfn needs(const x: int) -> int {\n    x\n}\ntakes(needs)",
                "argument 1 of `takes` wants `fn(int) -> int`, found `fn(const int) -> int`",
            )
        }
        then "a `once fn` with a settled seat meets the arity law, not a parse error" {
            refused_with("once fn f(const x: int) -> int {\n    x\n}\n1", "takes arguments")
        }
        then "an extern `const` seat is no INOUT — the ABI stays a plain width" {
            extern_shape("extern fn c_abs(const n: i32) -> i32\nc_abs(1)", "c_abs") == "i32 -> i32"
        }
        then "a settled mark inside a type argument is a parse error, as `mut` is" {
            refusals("let x: List<const int> = []\n0") == 1
        }
        then "a settled seat keys on THE VALUE alone — other arguments do not split it" {
            let src = "fn pick(const pattern: string, s: string) -> string {\n    pattern + s\n}\nlet a = pick(\"x\", \"1\")\nlet b = pick(\"x\", \"2\")\na + b"
            ir_of(src).fns.filter(it.name.starts_with("pick\$@")).length == 1
        }
        then "an aggregate literal settles inline — every field is source-spelled" {
            shown(
                "type P = { x: int, y: int }\nfn take(const p: P) -> int {\n    p.x + p.y\n}\ntake(P { x: 3, y: 4 })",
            ) == "7"
        }
        then "a `const` NESTED in the aggregate settles — a body's own, and a declared one" {
            shown(
                "type P = { x: int, y: int }\nconst N: int = 5\nfn take(const p: P) -> int {\n    p.x + p.y\n}\nfn f() -> int {\n    const m = 2\n    take(P { x: N, y: m })\n}\nf()",
            ) == "7"
        }
        then "a FORWARDED seat nested in the aggregate settles per outer value" {
            shown(
                "type P = { x: int }\nfn take(const p: P) -> int {\n    p.x\n}\nfn outer(const n: int) -> int {\n    take(P { x: n })\n}\nouter(3) + outer(4)",
            ) == "7"
        }
        then "an inline variant literal settles — the seat's want names the enum" {
            shown(
                "enum K { A, B }\nfn take(const k: K) -> int {\n    match k { .A -> 1, .B -> 2 }\n}\ntake(.B)",
            ) == "2"
        }
        then "a qualified variant settles too" {
            shown(
                "enum K { A, B }\nfn take(const k: K) -> int {\n    match k { .A -> 1, .B -> 2 }\n}\ntake(K.B) + take(K.A)",
            ) == "3"
        }
        then "a variant with a PAYLOAD settles, bare and qualified" {
            shown(
                "enum K { A, B(int) }\nfn take(const k: K) -> int {\n    match k { .A -> 1, .B(n) -> n }\n}\ntake(.B(4)) + take(K.B(5))",
            ) == "9"
        }
        then "a variant nested in a record settles" {
            shown(
                "enum K { A, B }\ntype P = { k: K, n: int }\nfn take(const p: P) -> int {\n    match p.k { .A -> p.n, .B -> p.n * 10 }\n}\ntake(P { k: .B, n: 3 })",
            ) == "30"
        }
        then "a field read of a const still refuses — the seat takes what the source spells" {
            refused_with(
                "type P = { x: int }\nconst O: P = P { x: 1 }\nfn take(const n: int) -> int {\n    n\n}\ntake(O.x)",
                "`n` is a `const` seat",
            )
        }
        then "a call nested in the aggregate refuses" {
            refused_with(
                "type P = { x: int }\nfn g() -> int {\n    1\n}\nfn take(const p: P) -> int {\n    p.x\n}\ntake(P { x: g() })",
                "`p` is a `const` seat",
            )
        }
        then "an operator over a const refuses — a const, not an expression of one" {
            refused_with(
                "const N: int = 1\nfn take(const n: int) -> int {\n    n\n}\ntake(N + 1)",
                "`n` is a `const` seat",
            )
        }
        then "an aggregate with a run-time field still refuses" {
            refused_with(
                "type P = { x: int }\nfn take(const p: P) -> int {\n    p.x\n}\nfn f(n: int) -> int {\n    take(P { x: n })\n}\nf(3)",
                "`p` is a `const` seat",
            )
        }
        then "a dyn method's settled seat is enforced too" {
            refused_with(
                "trait T { fn val(const x: int) -> int }\ntype A = { n: int }\nimpl T for A {\n    fn val(const x: int) -> int {\n        x + self.n\n    }\n}\nlet xs: List<dyn T> = [A { n: 1 }]\nlet v = 5\nxs[0].val(v)",
                "`x` is a `const` seat",
            )
        }
        then "an INDIRECT call through a fn VALUE obeys the law too" {
            refused_with(
                "fn takes(const x: int) -> int {\n    x + 1\n}\nlet g: fn(const int) -> int = takes\nlet v = 5\ng(v)",
                "`seat 1` is a `const` seat",
            )
        }
    }
}

spec "an extern that names a runtime row wears the row's shape" {
    given "a text seat" {
        then "a list handed to a text row is refused" {
            refused_with(
                "extern fn avra_str_len(b: List<int>) -> int\nlet xs = [1, 2]\navra_str_len(xs)\n",
                "seat 1 of `avra_str_len` reads a text box, this is `List<int>`",
            )
        }
        then "a map handed to a text row is refused" {
            refused_with(
                "extern fn avra_str_len(b: Map<string, int>) -> int\n1\n",
                "reads a text box, this is `Map<string, int>`",
            )
        }
        then "text is the box" {
            refusals("extern fn avra_str_len(s: string) -> int\navra_str_len(\"abc\")\n") == 0
        }
        then "ptr is the raw crossing and fits" {
            refusals("extern fn avra_str_len(p: ptr) -> int\n1\n") == 0
        }
    }
    given "a list seat and a map seat" {
        then "text handed to a list row is refused" {
            refused_with(
                "extern fn avra_array_len(s: string) -> int\n1\n",
                "seat 1 of `avra_array_len` reads a list box, this is `string`",
            )
        }
        then "a list at a map seat is refused" {
            refused_with(
                "extern fn avra_map_len(m: List<int>) -> int\n1\n",
                "reads a map box, this is `List<int>`",
            )
        }
        then "a seat that takes any box takes a list" {
            refusals("extern fn avra_array_push_owned(xs: List<int>, v: List<int>)\n1\n") == 0
        }
        then "a row with no arm of its own crosses the uniform frame, where a list does not" {
            refused_with(
                "extern fn avra_rc_retain(x: List<int>)\n1\n",
                "seat 1 of `avra_rc_retain` wears `List<int>`, which cannot cross to C",
            )
        }
    }
    given "the row's seat count" {
        then "an extra seat is refused" {
            refused_with(
                "extern fn avra_puts(a: string, b: string)\n1\n",
                "`avra_puts` is a runtime row of 1 seat(s), declared here with 2",
            )
        }
        then "a missing seat is refused" {
            refused_with(
                "extern fn avra_streq(a: string) -> bool\n1\n",
                "is a runtime row of 2 seat(s), declared here with 1",
            )
        }
        then "a name the runtime does not carry escapes the row law — its seats still cross" {
            refusals("extern fn my_own_c(a: int, b: string) -> int\n1\n") == 0
        }
        then "a name the runtime does not carry still meets the crossing law at a list seat" {
            refused_with(
                "extern fn my_own_c(a: List<int>, b: string) -> int\n1\n",
                "seat 1 of `my_own_c` wears `List<int>`, which cannot cross to C",
            )
        }
    }
}

spec "a runtime row's ANSWER is the row's, not the declaration's" {
    given "a pointer-answering row" {
        then "a bool answer is refused" {
            refused_with(
                "extern fn avra_array_new() -> bool\n1\n",
                "`avra_array_new` answers a pointer, this declares `bool`, which rides a word",
            )
        }
        then "an int answer is refused" {
            refused_with(
                "extern fn avra_array_new() -> int\n1\n",
                "answers a pointer, this declares `int`",
            )
        }
        then "a pointer answer is the row's" {
            refusals("extern fn avra_array_new() -> ptr\n1\n") == 0
        }
        then "a text answer rides a pointer and is taken" {
            refusals("extern fn avra_str_concat(a: string, b: string) -> string\n1\n") == 0
        }
    }
    given "a word-answering row" {
        then "a float answer is refused" {
            refused_with(
                "extern fn avra_array_len(xs: List<int>) -> float\n1\n",
                "`avra_array_len` answers a word, this declares `float`, which rides a double",
            )
        }
        then "a pointer answer is refused" {
            refused_with(
                "extern fn avra_array_len(xs: List<int>) -> string\n1\n",
                "answers a word, this declares `string`, which rides a pointer",
            )
        }
        then "a narrow width is not the row's word" {
            refused_with(
                "extern fn avra_array_len(xs: List<int>) -> i32\n1\n",
                "answers a word, this declares `i32`, which rides a 32-bit signed word",
            )
        }
        then "an int answer is the row's" {
            refusals("extern fn avra_array_len(xs: List<int>) -> int\n1\n") == 0
        }
    }
    given "a void-answering row" {
        then "an answer where the row answers nothing is refused" {
            refused_with(
                "extern fn avra_puts(line: string) -> int\n1\n",
                "`avra_puts` answers nothing, this declares `int`, which rides a word",
            )
        }
        then "no answer is the row's" {
            refusals("extern fn avra_puts(line: string)\n1\n") == 0
        }
    }
    given "a name the runtime does not carry" {
        then "any answer is its own business" {
            refusals("extern fn my_own_c(a: int) -> float\n1\n") == 0
        }
    }
}

spec "a pointer answer names the box it hands back" {
    given "a row that builds a list" {
        then "octets are refused" {
            refused_with(
                "extern fn avra_array_new() -> Bytes\n1\n",
                "`avra_array_new` answers a list box, this declares `Bytes`",
            )
        }
        then "text is refused" {
            refused_with(
                "extern fn avra_array_new() -> string\n1\n",
                "answers a list box, this declares `string`",
            )
        }
        then "a list is the box" {
            refusals("extern fn avra_array_new() -> List<int>\n1\n") == 0
        }
        then "ptr is the raw crossing and fits" {
            refusals("extern fn avra_array_new() -> ptr\n1\n") == 0
        }
    }
    given "a row that builds text" {
        then "a list is refused" {
            refused_with(
                "extern fn avra_str_concat(a: string, b: string) -> List<int>\n1\n",
                "answers a text box, this declares `List<int>`",
            )
        }
        then "octets are the same headered box and are taken" {
            refusals("extern fn avra_str_concat(a: string, b: string) -> Bytes\n1\n") == 0
        }
    }
    given "a row that builds a map" {
        then "a list is refused" {
            refused_with(
                "extern fn avra_map_new() -> List<int>\n1\n",
                "answers a map box, this declares `List<int>`",
            )
        }
    }
    given "a row that hands back whatever it was given" {
        then "any box is its own business" {
            refusals("extern fn avra_once_get(k: ptr) -> List<int>\n1\n") == 0
        }
    }
}
