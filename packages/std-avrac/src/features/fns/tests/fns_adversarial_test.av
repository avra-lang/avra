// The RED TEAM's permanent record for fns — declarations, calls,
// params, returns. Every program here was written to BREAK the
// feature, not to use it.
use @std.avrac.language.{analyze_source}
use @std.avrac.testing.{refused_with, shown, refusals, halver}

spec "features/fns (adversarial)" {
    given "`return` under attack — depths, tails, boundaries" {
        then "TWO loop depths unwind at once" {
            shown("fn f(n: int) -> int {\n    mut i = 0\n    while i < n {\n        mut j = 0\n        while j < n {\n            if i * j == 6 {\n                return i * 10 + j\n            }\n            j = j + 1\n        }\n        i = i + 1\n    }\n    0 - 1\n}\nf(5) + f(2)") == "22"
        }
        then "the tail after a certain return is UNREACHABLE but still typed" {
            shown("fn f() -> int {\n    return 1\n    2\n}\nf()") == "1" &&
                refused_with("fn f() -> int {\n    return 1\n    \"tail\"\n}\nf()",
                             "the body answers `string` but `f` declares `int`")
        }
        then "the guard-then-bang reads straight: absence answered, then insisted" {
            shown("${halver()}fn f(v: int?) -> int {\n    if v == null {\n        return 0 - 1\n    }\n    v!\n}\nf(half(4)) + f(half(3))") == "1"
        }
        then "a return at the TOP LEVEL is told where answers live" {
            refused_with("mut i = 0\nwhile i < 3 {\n    return 5\n    i = i + 1\n}\ni",
                         "a `return` answers a fn, and there is none enclosing")
        }
        then "a return ENDS an expression block — divergence-aware tails" {
            // The trigger fired with the error spine: a block that
            // LEAVES needs no tail, and answers what the fn
            // promises — so it joins only where that type fits.
            shown("${halver()}fn f(id: int) -> int {\n    let got = if let v? = half(id) {\n        v\n    } else {\n        return 0 - 1\n    }\n    got * 10\n}\nf(8) + f(3)") == "39"
        }
    }
    given "the parameter list, at every size" {
        then "zero parameters answer" {
            shown("fn f() -> int { 7 }\nf()") == "7"
        }
        then "eight parameters all arrive, first and last" {
            shown("fn f(a: int, b: int, c: int, d: int, e: int, g: int, h: int, i: int) -> int { a + i }\nf(1, 2, 3, 4, 5, 6, 7, 8)") == "9"
        }
        then "a name declared TWICE is refused, as a field or variant would be" {
            let a = analyze_source("fn f(a: int, a: int) -> int { a }\nf(1, 2)")
            a.diagnostics.length == 1 && a.report().contains("declares `a` more than once")
        }
        then "each EXTRA copy speaks — the same count a record gives" {
            refusals("fn f(a: int, a: int, a: int) -> int { a }\nf(1, 2, 3)") ==
                refusals("type P = { x: int, x: int, x: int }\n1")
        }
        then "two DIFFERENT names are fine" {
            shown("fn f(a: int, b: int) -> int { a + b }\nf(1, 2)") == "3"
        }
    }
    given "arity at the call" {
        then "too few arguments refuses" {
            refusals("fn f(a: int, b: int) -> int { a }\nf(1)") == 1
        }
        then "too many arguments refuses" {
            refusals("fn f(a: int) -> int { a }\nf(1, 2)") == 1
        }
    }
    given "declarations against each other" {
        then "a duplicate fn is refused once" {
            refusals("fn f() -> int { 1 }\nfn f() -> int { 2 }\nf()") == 1
        }
        then "a call may precede its declaration — fns are program-wide" {
            shown("f()\nfn f() -> int { 1 }") == "1"
        }
        then "mutual recursion terminates" {
            shown("fn a(n: int) -> int { if n <= 0 { 0 } else { b(n - 1) } }\nfn b(n: int) -> int { a(n - 1) }\na(4)") == "0"
        }
        then "a parameter may shadow a fn name" {
            shown("fn f(f: int) -> int { f }\nf(3)") == "3"
        }
        then "a nested declaration refuses — fns live at the top level" {
            let a = analyze_source("fn f() -> int {\n    fn g() -> int { 1 }\n    g()\n}\nf()")
            a.diagnostics.length == 2 && a.report().contains("live at the top level")
        }
    }
    given "the body against its declared return" {
        then "a disagreeing body refuses" {
            refusals("fn f() -> int { true }\nf()") == 1
        }
        then "an empty body is void — a declared return refuses it" {
            refused_with("fn f() -> int { }\nf()", "the body answers `void` but `f` declares `int`")
        }
    }
    given "the body floor — a fn sees declarations, never the top level's values" {
        then "a read refuses once, naming the remedy" {
            refused_with("let k = 5\nfn f(n: int) -> int {\n    n + k\n}\nf(1)", "`k` is a run-time binding of the top level")
        }
        then "an assignment refuses the same way" {
            refused_with("mut k = 1\nfn f() -> int {\n    k = 2\n    3\n}\nf()", "`k` is a run-time binding of the top level")
        }
        then "a binding declared AFTER the fn is hidden too — not `used before its definition`" {
            refused_with("fn f() -> int {\n    k\n}\nlet k = 1\nf()", "`k` is a run-time binding of the top level")
        }
        then "inside a nested block and a lambda of the body — one refusal" {
            refusals("let k = 1\nfn f() -> int {\n    if true {\n        let g = () -> k\n        g()\n    } else {\n        0\n    }\n}\nf()") == 1
        }
        then "a param or a local of the same name shadows nothing — it simply binds" {
            shown("let k = 1\nfn f(k: int) -> int {\n    let j = k + 1\n    j\n}\nf(41) + k") == "43"
        }
        then "a METHOD body stands on the same floor" {
            refused_with("type P = { x: int }\nlet k = 3\nimpl P {\n    fn m() -> int {\n        k\n    }\n}\nP { x: 1 }.m()",
                         "`k` is a run-time binding of the top level")
        }
    }
    given "`once` under attack — what a settled answer may be" {
        then "arguments refuse: a once answer is one value for the process" {
            refused_with("once fn f(a: int) -> string {\n    \"x\"\n}\nf(1)",
                         "`once fn f` takes arguments — a `once` answer is one value for the whole process")
        }
        then "a scalar answer refuses — the runtime keeps no copies" {
            refused_with("once fn n() -> int {\n    1\n}\nn()", "`once fn n` answers `int`, which the runtime cannot keep")
        }
        then "a void answer refuses in the same words" {
            refused_with("once fn f() {\n}\n1", "`once fn f` answers `void`, which the runtime cannot keep")
        }
        then "a record of one scalar field travels as the field, and refuses" {
            refused_with("type P = { x: int }\nonce fn p() -> P {\n    P { x: 1 }\n}\np().x", "`once fn p` answers `P`, which the runtime cannot keep")
        }
        then "a wider record is the runtime's, and settles" {
            shown("type P = { x: int, y: int }\nonce fn p() -> P {\n    P { x: 5, y: 2 }\n}\np().x + p().y") == "7"
        }
        then "a method cannot be `once` — its answer would depend on a receiver" {
            refused_with("type P = { x: int }\nimpl P {\n    once fn tag() -> string {\n        \"p\"\n    }\n}\nP { x: 1 }.tag()",
                         "`once fn tag` is a method — its answer would depend on a receiver")
        }
        then "each refusal speaks once" {
            refusals("once fn f(a: int) -> int {\n    a\n}\nf(1)") == 1
        }
        then "a MARKED parameter loses no law — the same words, not a parse error" {
            refused_with("once fn f(mut x: List<int>) -> string {\n    \"a\"\n}\n1",
                         "`once fn f` takes arguments — a `once` answer is one value for the whole process")
        }
        then "an absent answer is honest — it settles nothing and stays absent" {
            shown("once fn t() -> string? {\n    null\n}\nt() ?? \"absent\"") == "absent"
        }
    }
}
