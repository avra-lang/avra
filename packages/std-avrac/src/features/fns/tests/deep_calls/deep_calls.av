// A call chain deeper than a host stack holds for the evaluator's
// old recursion: both engines answer it, the evaluator from its own
// stack.
fn depth(n: int) -> int { if n == 0 { 0 } else { 1 + depth(n - 1) } }
fn ping(n: int) -> int { if n == 0 { 0 } else { pong(n - 1) + 1 } }
fn pong(n: int) -> int { if n == 0 { 0 } else { ping(n - 1) + 2 } }
println("${depth(20000)}")
println("${ping(9999)}")
let f = (n: int) -> depth(n) * 2
println("${f(1000)}")
