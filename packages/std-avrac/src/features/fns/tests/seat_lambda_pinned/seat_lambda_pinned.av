// proves: a lambda handed to a seat whose type parameter its call
// already filled is checked against that seat — `compute: fn() -> V?`
// on a `Memo<string>` takes `() -> text(1)`, whose body answers
// `string` where the seat answers `string?`. Only a seat still open
// holds a fn's answer to what it answers as it stands.
type Memo<V> = { held: V? }

impl Memo<V> {
    fn answer(at: int, compute: fn() -> V?) -> V? { if at < 0 { null } else { self.held ?? compute() } }
}

fn text(n: int) -> string { "x${n}" }

fn remembered(memo: Memo<string>) -> string {
    memo.answer(0, () -> text(1)) ?? ""
}

remembered(Memo<string> { held: null })
