// proves: a type parameter only a fn's answer names is pinned through a seat that is itself a
// generic fn type: the seat wants that answer with what its call fills so far, what it leaves open
// fitting anything, so the inner call pins its own parameter and the outer one hears the rest from
// what the inner answers, held to its bound.
trait Answer {
    fn said() -> string
}

impl Answer for string {
    fn said() -> string { self }
}

type Req<P> = { p: P }

fn route<R, T: Answer>(read: fn() -> R, f: fn(Req<R>) -> T) -> string { f(Req { p: read() }).said() }

fn routed<R, T>(read: fn() -> R, f: fn(Req<R>) -> T) -> T { f(Req { p: read() }) }

fn adapt<P>(g: fn(int) -> string) -> fn(Req<P>) -> string { (q: Req<P>) -> g(1) }

fn echoed<P>() -> fn(Req<P>) -> P { (q: Req<P>) -> q.p }

let a = route(() -> "s", adapt((n: int) -> "n${n}"))
let b = routed(() -> 7, echoed())
let c = routed(() -> "x", adapt((n: int) -> "m${n}"))
"${a} ${b + 1} ${c}"
