// A WRITE THROUGH `self` OR A `mut` SEAT rides the seat's count: its caller opened the box, so the
// write lands in it in place and the caller reads it back. A callee that also keeps the box takes
// its own reference.
type Tape = { items: List<int>, tag: string }

impl Tape {
    fn count(value: int) { pushed(self.items, value) }

    fn tagged(t: string) { self.tag = t }
}

fn pushed(mut xs: List<int>, value: int) {
    xs.push(value)
    xs.push(value + 1)
}

fn kept(mut all: List<List<int>>, mut xs: List<int>) {
    xs.push(9)
    all.push(xs)
}

fn fresh(n: int) -> List<int> { [i for i in 0..n] }

mut t = Tape { items: fresh(1), tag: "" }
t.count(5)
t.tagged("x${t.items.length}")
mut all: List<List<int>> = []
mut ys = fresh(2)
kept(all, ys)
ys.push(4)
"${t.items.length} ${t.items[2]} ${t.tag} ${all[0].length} ${all[0][2]} ${ys.length} ${ys[2]}"
