// AN EXTERN'S `mut` SEAT HANDED A PLACE ALONG A PATH from a `mut` local: C writes a cell seeded with
// the place's value, and the cell is written back along the path when the call returns.
extern fn frexp(x: float, mut exponent: i32) -> float
extern fn time(mut t: i64) -> i64

type Stamp = { at: int, exp: int }

mut s = Stamp { at: 0, exp: 7 }
let _ = frexp(0.25, s.exp)
let now = time(s.at)
mut xs = [0, 5]
let _ = frexp(8.0, xs[1])
"${s.exp} ${now == s.at} ${s.at > 1000000} ${xs[0]} ${xs[1]}"
