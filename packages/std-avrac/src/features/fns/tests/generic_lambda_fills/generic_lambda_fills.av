// proves: a generic fn's type parameters are filled by what its lambda
// arguments answer — a bounded parameter among them, and a
// lambda whose seat its parameter's type comes from.
trait Shown {
    fn shown() -> string
}

type Count = { n: int }

impl Shown for Count {
    fn shown() -> string { "count ${self.n}" }
}

type Route = { pattern: string }

// LICENSED fns.dead_parameter: this test exercises fn seats typed through the lambdas handed to them, read by nothing
fn routed<R, T: Shown>(pattern: string, read: fn(string) -> R, serve: fn(R) -> T) -> Route {
    Route { pattern: pattern }
}

let typed = routed("a", (s: string) -> s.length, (n: int) -> Count { n: n })
let seated = routed("b", (s: string) -> s.length, (n) -> Count { n: n })

"${typed.pattern} ${seated.pattern}"
