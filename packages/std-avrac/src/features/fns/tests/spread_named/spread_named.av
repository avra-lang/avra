// proves: `f(..opts)` fills a fn's named seats from a record's fields —
// written order, a later source winning a seat, a default for the seats
// nothing writes, the operand evaluated ONCE however many fields it fills
type Opts = { w: int, h: int }
type Box = { name: string, w: int, h: int = 7 }

fn area(w: int, h: int = 1) -> int { w * h }

fn label(name: string, w: int, h: int) -> string { "${name}:${w}x${h}" }

fn ticked(cell: Cell<int>) -> Opts {
    cell.set(cell.get() + 1)
    Opts { w: 3, h: 4 }
}

type Acc = { n: int }
type G = { by: int, times: int }
type Kx = { x: string }

fn ident<T>(x: T) -> T { x }

impl Acc {
    fn grow(by: int, times: int = 1) -> int { self.n + by * times }
}

let o = Opts { w: 5, h: 6 }
let b = Box { name: "b", w: 2, h: 9 }
let hits = Cell.new(0)
let a1 = area(..o)
let a2 = area(..Opts { w: 9, h: 3 })
let a3 = area(..o, h: 2)
let a4 = area(..Opts { w: 1, h: 1 }, h: 8)
let a5 = area(..ticked(hits))
let l1 = label(..b)
let l2 = label("x", ..o)
let p1 = ident(..Kx { x: "pin" })
let g = Acc { n: 1 }.grow(..G { by: 2, times: 3 })
"${a1} ${a2} ${a3} ${a4} ${a5} ${hits.get()} ${l1} ${l2} ${g} ${p1}"
