//! Parse-time lowering: captured tokens and expressions -> the
//! FnDecl statement and the Call node. A declaration's seats arrive
//! built, one `Record.ParamSyntax` each.
use core.{Expr, Stmt, Scoped}
use features.{LangNode, Builder, expr_id_at, params_at}

fn build_fn(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    b
        .make_stmt(
            Stmt
                .FnDecl(
                    Scoped(n.text),
                    params_at(b.args, 1),
                    params_at(b.args, 2),
                    b.answer(3),
                    b.expr(4)?,
                ),
        )
}

/// `once fn` — a fn plus the mark. Its laws (no arguments, an
/// answer the runtime can keep) are the declare phase's; its
/// guarded body is lowering's.
fn build_once_fn(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let s = b
        .store
        .alloc_stmt(Stmt.FnDecl(Scoped(n.text), [], params_at(b.args, 1), b.answer(2), b.expr(3)?), b.span)
    b.store.mark_once(s)
    .Ok(LangNode.NStmt(s))
}

/// `extern fn name(mut p: T, …) -> R` — every seat typed by the
/// grammar. A `mut` seat is an INOUT: the C prototype takes the address of the caller's cell,
/// which is the only way a callee with no box can write back.
fn build_extern(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let params = params_at(b.args, 1)
    // A BODY MAKES IT A HOST FN: the same seats, and a fn like any other
    // under them — the mark says its name is the symbol it defines.
    let body? = expr_id_at(b.args, 3) else { return b.make_stmt(Stmt.ExternFn(Scoped(n.text), params, b.answer(2))) }
    let s = b.store.alloc_stmt(Stmt.FnDecl(Scoped(n.text), [], params, b.answer(2), body), b.span)
    b.store.mark_host(s)
    .Ok(LangNode.NStmt(s))
}
