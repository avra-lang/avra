//! Parse-time lowering: captured tokens and expressions -> the
//! FnDecl statement and the Call node. Param names and their WRITTEN
//! types arrive as two parallel captures and zip into Params.
use core.{Expr, Stmt, Param, TypeRef}
use grammar.{Token}
use features.{LangNode, Builder, aligned_binds, aligned_param_types, type_ref_at, expr_id_at}

fn build_fn(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let tp = b.tokens(1)?
    let ps = b.tokens(3)?
    let r = type_ref_at(b.args, 5) ?? void_ref()
    let body = b.expr(6)?
    let ends: int? = b.span_end()
    if ends == null { return Result.Err("a fn declaration without a span") }
    // a tparam's BOUND and a param's TYPE are optional in the
    // PARSE; spans re-align both (only `self` may go bare — the
    // declare law enforces it).
    let bounds = aligned_binds(tp, b.tokens(2)?, ends!)
    mut tparams: List<Param> = []
    // LICENSED I3: a ZIP of parallel captures; comprehensions cannot
    for (j, t) in tp.enumerate() {
        tparams.push(Param { name: t.text, ty: bound_ref(bounds[j], t), default: null })
    }
    let tys = aligned_param_types(ps, b.type_refs(4)?, ends!)
    mut params: List<Param> = []
    // LICENSED I3: a ZIP of parallel captures; comprehensions cannot
    for (j, p) in ps.enumerate() {
        params.push(Param { name: p.text, ty: tys[j], default: null })
    }
    b.make_stmt(Stmt.FnDecl(n.text, tparams, params, r, body))
}

/// A bound as a written type — the trait's bare name.
fn bound_ref(bound: string, at: Token) -> TypeRef? {
    if bound == "" { return null }
    TypeRef { name: bound, args: [], optional: false, dynamic: false, arrow: false, span: at.span }
}

fn build_call(b: Builder) -> Result<LangNode, string> {
    let c = b.token(0)?
    let args = b.exprs(1)?
    b.make_expr(Expr.Call(c.text, [], args))
}

/// `f<int>(x)` — the explicit pins. The no-chain comparison law is
/// what makes this branch safe to claim: `a<b>(c)` has no legal
/// comparison reading to steal.
fn build_pinned_call(b: Builder) -> Result<LangNode, string> {
    let c = b.token(0)?
    let pins = b.type_refs(1)?
    let args = b.exprs(2)?
    b.make_expr(Expr.Call(c.text, pins, args))
}

fn build_return(b: Builder) -> Result<LangNode, string> {
    b.make_stmt(Stmt.Return(expr_id_at(b.args, 0)))
}

/// The return a fn declares by writing none: `void`.
export fn void_ref() -> TypeRef {
    TypeRef { name: "void", args: [], optional: false, dynamic: false, arrow: false, span: null }
}
