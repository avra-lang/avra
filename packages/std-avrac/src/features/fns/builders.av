//! Parse-time lowering: captured tokens and expressions -> the
//! FnDecl statement and the Call node. Param names and their WRITTEN
//! types arrive as two parallel captures and zip into Params.
use core.{Expr, Stmt, Param}
use features.{LangNode, Builder}

fn build_fn(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let ps = b.tokens(1)?
    let pt = b.type_refs(2)?
    let r = b.type_ref(3)?
    let body = b.expr(4)?
    if ps.length != pt.length {
        return Result.Err("param names and types disagree in count")
    }
    mut params: List<Param> = []
    // LICENSED I3: a ZIP of parallel captures; comprehensions cannot
    for (j, p) in ps.enumerate() {
        params.push(Param { name: p.text, ty: pt[j] })
    }
    b.make_stmt(Stmt.FnDecl(n.text, params, r, body))
}

fn build_call(b: Builder) -> Result<LangNode, string> {
    let c = b.token(0)?
    let args = b.exprs(1)?
    b.make_expr(Expr.Call(c.text, args))
}

fn build_return(b: Builder) -> Result<LangNode, string> {
    let v = b.expr(0)?
    b.make_stmt(Stmt.Return(v))
}
