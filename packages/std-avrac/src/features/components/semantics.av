//! An instance's semantics: its EXPANSION is the node every pass
//! reads — typing answers its type, lowering its register. Nothing of
//! the component survives to the IR.
use core.{ExprId, StmtId, TypeId, Reg, Kids}
use core.stmt.{ComponentDecl}
use features.{StmtSemantics, ResolveCx, TypeCx, LowerCx, Meaning, nothing}

use core.expr.{Component}

impl Kids for Component {
    fn kids() -> List<ExprId> {
        // a check reads the literal, so walking it walks the expansion once
        match self.view { .Expanded(x) -> [self.check ?? x], rest -> [] }
    }
}

impl StmtSemantics for ComponentDecl {
    fn resolve_stmt(mut cx: ResolveCx, s: StmtId) { resolve_component(cx, s) }

    fn type_stmt(mut cx: TypeCx, s: StmtId) { check_component(cx, s) }
}

impl Meaning for Component {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        let x? = self.view.expansion() else { return cx.error_type }
        if head_law(cx, e) { return cx.error_type }
        event_law(cx, e)
        let typed = cx.type_at(x)
        fate_law(cx, x)
        typed
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        let x? = self.view.expansion() else { return cx.lower_defect(e, "an instance that never expanded") }
        if self.check != null { checked(cx, e, self.check!) }
        augmented(cx, e, x, cx.reg_of(x))
    }
}
