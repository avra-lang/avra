//! Components — a record type with defaults that a block instantiates.
//! `component Name(head: T) { field: T = default … fn … }` declares
//! it: the head's fields are filled by position, the rest by name,
//! and the fns are its methods. A `state` field is a place each
//! instance holds, as a record's is. A component whose `expand` is ONE
//! `quote` reading only `self` is a TEMPLATE: an importing file's
//! `within ms(5) { … }` is that quote, copied where the instance
//! stands. One with no `expand` is a RECORD its instance builds:
//! `grid report { title: "x" … }` — settings by name, the other
//! statements its children (docs/2026_09_23_COMPONENT_EXPANSION.md).
//! A record's own one-seat fn field takes a body of ARMS too, like a
//! trailing block — `Name inst { pattern -> value, … }`, the
//! pronoun's seat implicit.
//! AN EVENT IS A DECLARED MEMBER, written with one word on both sides:
//! `on input(text: string)` in the component, `on input { text -> … }`
//! at its instance. The member is a field holding the handler, absent
//! until an instance hears it; a handler hears all its event says, or
//! none of it. `on input: handler` hands the event a handler that is
//! already a value — how a component passes on one it was given.
//! AN INSTANCE'S HEAD KEEPS ITS BRACE: a name and then a brace after a
//! component's word is that name as the head and the instance's own
//! block — `counter id { key: id }` — never a record literal. A literal
//! as a head stands in parentheses.
use features.{LanguageFeature, BuilderRow}
use @std.grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use diagnostics.{DiagCode}

export fn components() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name                    | build
        "component_decl"        | build_component_decl
        "component_event"       | build_component_event
        "component_keyed"       | build_component_keyed
        "component_braced_head" | build_component_braced_head
        "component_named"       | build_component_named
        "component_named_bare"  | build_component_named_bare
        "on_handler"            | build_on_handler
        "instance_body"         | build_instance_body
    }
    let codes = table<DiagCode> {
        kind                      | summary
        "type.component_expand"   | "a component's `expand` answers the code an instance becomes"
        "type.component_twice"    | "a template reads each of its instance's fields once"
        "type.component_check"    | "a component's `check` answers `List<Diagnostic>`"
        "lower.component_checked" | "a component's `check` judged this instance"
        "type.component_format"   | "a `Format` head is `@std.meta`'s pattern type"
        "type.component_event"    | "an instance hears the events its component declares"
        "type.component_body"     | "a component's body is what one trait says a body is"
        "type.component_head"     | "the brace after an instance's head opens the instance's block"
        "type.component_row"      | "a repeated row that keeps state wears a key"
        "flow.no_fate"            | "a handler that can fail must name a fate for its failure"
    }
    LanguageFeature components {
        gram: grammar {
            stmt = "component" n:NAME ( "<" tp:NAME ( ":" tb:type )? ( "," tp:NAME ( ":" tb:type )? )* ","? ">" )? ( "(" ( head:hseat ( "," head:hseat )* ","? )? ")" )? "{" ( fields:cfield | events:cevent | rs:".." ( dd:"." )? rt:type | m:stmt | BREAK )* "}" END @recover(sync_to: "END") -> component_decl(n, tp, tb, head, fields, events, m, rs, rt, dd)
            hseat = ( marks:mark )* name:NAME ":" ty:type -> Record.ParamSyntax
            cfield = ( marks:mark )* ( state_field:STATE )? name:NAME ":" ty:type ( "=" default:expression )? -> Record.ParamSyntax
            cevent = ( marks:mark )* ON name:NAME ( "(" ( says:eseat ( "," says:eseat )* ","? )? ")" )? -> component_event(marks, name, says)
            eseat = name:NAME ":" ty:type -> Record.ParamSyntax
            stmt = w:COMPONENT ( "<" ta:type ( "," ta:type )* ","? ">" )? n:NAME b:named_inst_body END -> component_named(w, ta, n, b) | w:COMPONENT ( "<" ta:type ( "," ta:type )* ","? ">" )? n:NAME END -> component_named_bare(w, ta, n)
            setting = name:NAME ":" value:expression END -> Stmt.Setting | w:ON kw:NAME "{" BREAK* ( ip:handler_seat ( "," ip:handler_seat )* ","? "->" )? ( s:stmt | BREAK )* "}" -> on_handler(w, kw, ip, s) | on:ON name:NAME ":" value:expression END -> Stmt.Setting
            head_arm = pats:nonbind_pattern ( "if" guard:expression )? "->" value:expression -> Record.Arm
            named_inst_body = "{" BREAK* arms:head_arm ( BREAK | "," | arms:arm | arms:hole_arm )* "}" @expect("}", "expected `}` to close the arms block") -> Expr.ArmsBody
                | b:instance_body -> b
            instance_body = "{" BREAK* ( ip:handler_seat ( "," ip:handler_seat )* ","? "->" )? ( s:setting | s:stmt | BREAK )* "}" @expect("}", "expected `}` to close the instance") -> instance_body(ip, s)
            handler_seat = name:NAME -> Record.ParamSyntax
            primary = w:COMPONENT ( "<" ta:type ( "," ta:type )* ","? ">" )? hn:NAME b:instance_body x:instance_body -> component_braced_head(w, ta, hn) @trailer(x) | word:COMPONENT ( "<" targs:type ( "," targs:type )* ","? ">" )? heads:head_name body:instance_body -> Expr.Component | word:COMPONENT ( "<" targs:type ( "," targs:type )* ","? ">" )? body:instance_body -> Expr.Component | word:COMPONENT ( "<" targs:type ( "," targs:type )* ","? ">" )? heads:expression body:instance_body -> Expr.Component @head(heads) | w:COMPONENT h:expression kw:NAME iw:NAME "." fp:NAME b:instance_body -> component_keyed(w, h, kw, iw, fp, b) @head(h) | word:COMPONENT ( "<" targs:type ( "," targs:type )* ","? ">" )? heads:expression -> Expr.Component @head(heads)
            head_name = name:NAME -> Expr.Ident
        }
        builders: rows
        diags: codes
    }
    components
}
