// A data component — no `expand` — is a record its instance builds:
// the head by position, `key: value` settings by name, and the body's
// other statements `collect`ed into its one `List` field.
use @std.avrac.testing.{provided, answered}
use @std.avrac.compiler.{Program}

/// The provider: a row with a head, a grid of rows named at its
/// statement, a nameable secret, and a card of mixed views.
fn ui() -> string {
    "export component row(id: int) {\n    label: string = \"?\"\n}\n\nexport component grid {\n    name: string\n    title: string = \"\"\n    rows: List<row> = []\n}\n\nexport component secret {\n    name: string\n}\n\nexport trait View {\n    fn text() -> string\n}\n\nexport component note(t: string) {}\n\nexport component badge(n: int) {}\n\nimpl View for note {\n    fn text() -> string { self.t }\n}\n\nimpl View for badge {\n    fn text() -> string { \"#\${self.n}\" }\n}\n\nexport component card {\n    items: List<dyn View> = []\n}\n"
}

fn built(main: string) -> Program {
    provided("use @x.c.{row, grid, secret, note, badge, card}\n" + main, ui())
}

spec "features/components — a record's instance" {
    given "the instance" {
        then "a head value fills the head field, a setting its field" {
            answered(built("let r = row 7 {\n    label: \"seven\"\n}\n\"\${r.id} \${r.label}\"")) == "7 seven"
        }
        then "a field left unset takes its default" {
            answered(built("let r = row 7 { }\nr.label")) == "?"
        }
        then "a record with a head needs no block" {
            answered(built("let r = row 3\nr.id")) == "3"
        }
        then "the body's statements are its children, loops and branches included" {
            answered(built("let orders = [3, 4, 5]\ngrid report {\n    for o in orders {\n        if o != 4 { row o }\n    }\n    row 99\n}\n[\"\${r.id}\" for r in report.rows].join(\",\")")) == "3,5,99"
        }
    }
    given "the named instance" {
        then "a headless record named at a statement binds the name and fills `name`" {
            answered(built("grid report {\n    title: \"Orders\"\n}\n\"\${report.name} \${report.title}\"")) == "report Orders"
        }
        then "a named instance needs no block" {
            answered(built("secret stripe_key\nstripe_key.name")) == "stripe_key"
        }
    }
    given "mixed children" {
        then "a `dyn` slot boxes each child, the trait unimported by the user" {
            answered(built("let c = card {\n    note \"hi\"\n    for i in 0..2 { badge i }\n}\n[v.text() for v in c.items].join(\" \")")) == "hi #0 #1"
        }
    }
    given "comprehensions" {
        then "a comprehension child spreads its rows into the slot" {
            answered(built("let orders = [3, 4, 5]\ngrid g {\n    [row o for o in orders if o != 4]\n    row 9\n}\ng.rows.length")) == "3"
        }
        then "a comprehension of views boxes each into a `dyn` slot" {
            answered(built("let c = card {\n    [badge i for i in 0..3]\n    note \"x\"\n}\n[v.text() for v in c.items].join(\" \")")) == "#0 #1 #2 x"
        }
    }
    given "visible magic" {
        then "`expand` notes the record literal each instance became" {
            let p = built("grid report {\n    title: \"Orders\"\n    row 1\n}\nreport.title")
            let shown = p.expanded_source(p.ws.file_id("/w/src/main.av"))
            shown.contains("grid report {") && shown.contains("name: \"report\",") && shown.contains("rows: collect {")
        }
    }
}
