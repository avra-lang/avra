// proves: a component's own fns are its instances' methods — one reading a field, one under a generic
// component's argument, one writing a `state` field through the instance — in both engines
component tray<T> {
    capacity: int = 1
    held: List<T> = []
    state count: int = 0
    fn doubled() -> int { self.capacity * 2 }
    fn first_or(d: T) -> T { self.held.first() ?? d }
    fn bump() -> int {
        self.count = self.count + 1
        self.count
    }
}

tray<int> t {
    capacity: 4
    held: [7]
}
tray<string> w {}
let a = t.bump()
let b = t.bump()
"${t.doubled()} ${t.first_or(0)} ${w.first_or("none")} ${a} ${b} ${t.count}"
