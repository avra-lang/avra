// proves: an event's field holds its handler as a nullable fn — read, unwrapped and called in a
// generic fn, absent where the instance sets none — in both engines
component tray<T> {
    label: string = "x"
    on took(item: T)
}

fn fed<T>(t: tray<T>, x: T) -> int {
    if t.took != null { (t.took!)(x) }
    1
}

let seen: Cell<int> = Cell.new(0)
tray<int> t {
    label: "y"
    on took { n -> seen.set(seen.get() + n) }
}
tray<int> quiet { label: "q" }
"${fed(t, 4)} ${fed(t, 5)} ${fed(quiet, 6)} ${seen.get()}"
