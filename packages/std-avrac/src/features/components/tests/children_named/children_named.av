// proves: a component's list field is filled by the children its block
// names, each a value standing as a statement, in written order; a child
// written in a branch or a loop joins too, and a list a child names
// joins element by element.
component item {
    @names name: string
    weight: int = 1
}

component shelf {
    @names name: string
    label: string = ""
    items: List<item> = []
}

item apple {
    weight: 3
}

item pear {}

item plum {
    weight: 5
}

const spares = [plum, pear]

shelf fruit {
    label: "fruit"
    apple
    pear
    if apple.weight > 2 { plum }
    for i in 0..2 { apple }
    spares
}

"${fruit.name} ${fruit.label} ${fruit.items.length} ${[i.name for i in fruit.items].join(",")} ${fruit.items.fold(0, (a, i) -> a + i.weight)}"
