// A COMPONENT'S BODY IS WHAT IT IS MADE OF. A component that holds
// statements is derived — with nothing written on it — over the one
// trait wearing `@composes`: the trait's `derive` receives the body as
// `Type.body` and splices it, `self` the instance, and the component
// carries the record the mark names as if it spread it.
use @std.avrac.testing.{provided, answered, refused_in, said, Module}
use @std.avrac.compiler.{Program}

/// The library: a trait that says a body is the words a component
/// `says`, the record every such component carries, and the component
/// a body's statements are gathered in.
fn says() -> string {
    "use @std.meta.{Type, Directive, Declared, composes}\n\nexport type Tagged = { tag: string = \"\" }\n\nexport component words {\n    items: List<string> = []\n}\n\n@composes(Tagged)\nexport trait Says {\n    fn says() -> string\n\n    static fn derive(t: Type) -> Declared {\n        let body? = t.body else { return Declared { made: [] } }\n        Declared {\n            made: [\n                Directive {\n                    twin: \"\",\n                    name: t.name,\n                    at: t.at,\n                    source: quote {\n                        impl Says for \${t} {\n                            fn says() -> string {\n                                words made {\n                                    \${body}\n                                }\n                                made.items.join(\" \")\n                            }\n                        }\n                    },\n                },\n            ],\n        }\n    }\n}\n\nexport fn said_by(s: dyn Says) -> string { s.says() }\n"
}

/// A second library, in the program's own package: a body is what a
/// component `tells`.
fn tells() -> Module {
    Module {
        name: "kit",
        text: "use @std.meta.{Type, Directive, Declared, composes}\n\nexport type Plain = { plain: bool = true }\n\nexport component told {\n    items: List<string> = []\n}\n\n@composes(Plain)\nexport trait Tells {\n    fn tells() -> string\n\n    static fn derive(t: Type) -> Declared {\n        let body? = t.body else { return Declared { made: [] } }\n        Declared {\n            made: [\n                Directive {\n                    twin: \"\",\n                    name: t.name,\n                    at: t.at,\n                    source: quote {\n                        impl Tells for \${t} {\n                            fn tells() -> string {\n                                told made {\n                                    \${body}\n                                }\n                                \"told \" + made.items.join(\" \")\n                            }\n                        }\n                    },\n                },\n            ],\n        }\n    }\n}\n\nexport fn told_by(s: dyn Tells) -> string { s.tells() }\n",
    }
}

fn built(main: string) -> Program { provided("use @x.c.{said_by}\n" + main, says()) }

/// A component made of words, one of them only when it is loud,
/// declared where it is used.
fn greeting() -> string {
    "component greeting(name: string) {\n    loud: bool = false\n    \"hello\"\n    if self.loud { \"LOUD\" }\n    self.name\n}\n"
}

spec "features/components — a body" {
    given "a component that holds statements" {
        then "is what its body makes, in order, `self` the instance" {
            answered(built(greeting() + "let g = greeting \"ann\"\ng.says()")) == "hello ann"
        }
        then "reads its own fields through `self`" {
            answered(built(greeting() + "let g = greeting \"ann\" { loud: true }\ng.says()")) == "hello LOUD ann"
        }
        then "is the trait's, with no `@derive` and no `impl` written" {
            answered(built(greeting() + "said_by(greeting \"bo\")")) == "hello bo"
        }
        then "carries the record its trait names, as a setting and as a field" {
            answered(
                built(
                    greeting() +
                        "let g = greeting \"ann\" {\n    tag: \"t\"\n}\n\"\${g.says()} \${g.tag}\"",
                ),
            ) == "hello ann t"
        }
        then "says nothing of a clean program" { said(built(greeting() + "let g = greeting \"ann\"\ng.says()")).is_empty() }
    }
    given "a file that binds the trait's name to something else" {
        then "is composed by the trait all the same — the impl names its own library's" {
            answered(
                built(
                    "type Says = { n: int }\n" +
                        greeting() +
                        "let s = Says { n: 2 }\n\"\${said_by(greeting \"ann\")} \${s.n}\"",
                ),
            ) == "hello ann 2"
        }
    }
    given "a second trait that composes, in the program's own package" {
        then "composes a component whose file reaches it alone" {
            answered(
                provided(
                    "use kit.{told_by}\ncomponent note(name: string) {\n    self.name\n}\ntold_by(note \"n\")",
                    says(),
                    [tells()],
                ),
            ) == "told n"
        }
        then "is refused beside the first, where one file reaches both" {
            refused_in(
                provided(
                    "use @x.c.{said_by}\nuse kit.{told_by}\n" + greeting() + "0",
                    says(),
                    [tells()],
                ),
                "one trait says what a component's body is, and here `Says` and `Tells` both do",
            )
        }
    }
    given "a component that holds none" {
        then "carries no field of the record the trait names" {
            refused_in(
                built(
                    "component plain(name: string) {\n    x: int = 0\n}\nlet p = plain \"a\"\np.tag",
                ),
                "no field `tag` on `plain`",
            )
        }
    }
    given "a body the trait's derive is handed" {
        then "is typed where it lands — a field it misreads is the component's to lack" {
            refused_in(
                built("component wrong(name: string) {\n    self.nope\n}\n0"),
                "no field `nope` on `wrong`",
            )
        }
    }
}

/// A library whose derive refuses every body, and one whose derive
/// cannot run.
fn refusing(run: string) -> string {
    "use @std.meta.{Type, Directive, Declared, Diagnostic, composes, refuse_as_at}\n\nexport type Tagged = { tag: string = \"\" }\n\n@composes(Tagged)\nexport trait Says {\n    fn says() -> string\n\n    static fn derive(t: Type) -> Declared {\n        ${run}\n    }\n}\n\nexport fn nothing_said() -> int { 0 }\n"
}

const refuses = "Declared { made: [], problems: [refuse_as_at(\"wordless\", t.at, \"a body says words, and `\${t.name}` says none\", \"write one\")] }"
const traps = "let none: List<Directive> = []\n        Declared { made: [none[3]] }"

spec "features/components — a body's refusals, as written" {
    given "a body no trait composes" {
        then "is refused at the component, with the way out" {
            provided("component made {\n    let x = 1\n}\n0", "").report().trim() == "error[type.component_body]: a component is made of what its body holds, and nothing here says what `made`'s is\n  ╭─[/w/src/main.av:1:1]\n1 │ component made {\n  · ┬\n  · ╰── holds statements\n──╯\nhelp: a body is composed by the library whose components it is made of — write one of them in it, or `use` the library; a component of fields and `fn`s holds none"
        }
    }
    given "a body two traits compose" {
        then "is refused naming both, with the way out" {
            provided(
                "use @x.c.{said_by}\nuse kit.{told_by}\n" + greeting() + "0",
                says(),
                [tells()],
            )
                .report()
                .trim() == "error[type.component_body]: one trait says what a component's body is, and here `Says` and `Tells` both do\n  ╭─[/w/src/main.av:3:1]\n3 │ component greeting(name: string) {\n  · ┬\n  · ╰── `greeting` holds statements\n──╯\nhelp: make this file name one library's components alone — move what uses the other into a file of its own"
        }
    }
    given "a body its trait refuses" {
        then "is refused in the trait's words, under the trait's package" {
            provided(
                "use @x.c.{nothing_said}\ncomponent mute(name: string) {\n    self.name\n}\nnothing_said()",
                refusing(refuses),
            )
                .report()
                .trim() == "error[@x/c:wordless]: a body says words, and `mute` says none\n  ╭─[/w/src/main.av:2:1]\n2 │ component mute(name: string) {\n  · ┬\n  · ╰── refused by `Says`\n──╯\nhelp: write one"
        }
    }
    given "a body whose trait's derive cannot run" {
        then "is refused where the derive ran, with what stopped it" {
            provided(
                "use @x.c.{nothing_said}\ncomponent mute(name: string) {\n    self.name\n}\nnothing_said()",
                refusing(traps),
            )
                .report()
                .trim() == "error[annotation.unsettled]: an annotation could not run\n  ╭─[/w/src/main.av:2:1]\n2 │ component mute(name: string) {\n  · ┬\n  · ╰── `derive` index 3 is out of bounds (length 0)\n──╯\nhelp: an annotation runs at compile time from pure computation alone"
        }
    }
    given "a member read bare in a body" {
        then "is told to read it through `self`" {
            built(greeting().replace("self.name", "name") + "0").report().trim() == "error[resolve.unresolved]: `name` is not defined — a member is read through its receiver\n  ╭─[/w/src/main.av:6:5]\n6 │     name\n  ·     ┬\n  ·     ╰── read bare\n──╯\nhelp: write `self.name`"
        }
    }
}
