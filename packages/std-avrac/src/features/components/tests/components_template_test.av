// A template component's instance is its quote, copied where it
// stands: the head and block in its holes, the template's names and
// types resolving in the library, the user's in the user's file.
use @std.avrac.testing.{refused_n, vendored_meta, vendored_meta_paths}
use @std.avrac.compiler.{avra, new_workspace, Program}
use compiler.host.{memory_host}

/// The provider: `limited` narrows a `Span` the way `within` narrows
/// a deadline — its head is a value of the library's own type.
fn provider() -> string {
    "use @std.meta.{Code}\nexport type Span = { n: int }\nexport fn span(n: int) -> Span {\n    Span { n: n }\n}\nexport component limited(limit: Code) {\n    body: Code\n    fn expand() -> Code {\n        quote {\n            {\n                let limit: Span = \${self.limit}\n                let outer = limit.n\n                \${self.body} + outer\n            }\n        }\n    }\n}\n"
}

/// A program with `@std/meta` and the provider package `@x/lim`.
fn packaged(main: string) -> Program {
    let files = vendored_meta({
        "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@std/meta\" = { path = \"vendor/meta\" }\n\"@x/lim\" = { path = \"vendor/lim\" }\n",
        "/w/src/main.av": main,
        "/w/vendor/lim/avra.toml": "[package]\nname = \"@x/lim\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@std/meta\" = { path = \"../meta\" }\n",
        "/w/vendor/lim/src/lim.av": provider(),
    })
    let ws = new_workspace(memory_host(files, ["/w/avra.toml", "/w/src/main.av", "/w/vendor/lim/avra.toml", "/w/vendor/lim/src/lim.av"].concat(vendored_meta_paths())), "/w", avra())
    ws.program("/w/src/main.av")
}

fn ran(p: Program) -> string {
    match p.run() {
        .Ok(v) -> v,
        .Err(why) -> why,
    }
}

spec "features/components — a template's instance" {
    given "the instance" {
        then "answers its template's value, the head and block in their holes" {
            ran(packaged("use @x.lim.{limited, span}\nlimited span(3) { 4 }")) == "7"
        }
        then "the template's types resolve in the library — the user never imports `Span`" {
            ran(packaged("use @x.lim.{limited, span}\nlet v = limited span(1) { 1 }\nv")) == "2"
        }
        then "the template's binders are its own — the user's `outer` is the user's" {
            ran(packaged("use @x.lim.{limited, span}\nlet outer = 100\nlimited span(1) { outer }")) == "101"
        }
        then "an alias opens the instance under its new word" {
            ran(packaged("use @x.lim.{limited as bounded, span}\nbounded span(2) { 2 }")) == "4"
        }
        then "a line only the word can parse does not hide the import that names it" {
            ran(packaged("use @x.lim.{limited, span}\nlet w = match limited span(1) { 1 } {\n    2 -> \"two\",\n    _ -> \"other\",\n}\nw")) == "two"
        }
    }
    given "the laws" {
        then "a head of the wrong type is the template's typed binding, refused at the user's head" {
            let p = packaged("use @x.lim.{limited}\nlet v = limited 5 { 1 }\nv")
            refused_n(p, "`limit` declares `Span`, this is `int`", 1) && p.report().contains("main.av:2")
        }
    }
    given "visible magic" {
        then "`expand` notes what the instance became, and the module its names resolve in" {
            let p = packaged("use @x.lim.{limited, span}\nlet v = limited span(1) { 1 }\nv")
            let shown = p.expanded_source(p.ws.file_id("/w/src/main.av"))
            shown.contains("limited span(1) {") && shown.contains("// `limited` (from @x.lim) expands to:") && shown.contains("let limit: Span = span(1)")
        }
    }
}
