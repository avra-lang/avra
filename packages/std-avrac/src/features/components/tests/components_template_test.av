// A template component's instance is its quote, copied where it
// stands: the head and block in its holes, the template's names and
// types resolving in the library, the user's in the user's file.
use @std.avrac.testing.{refused_n, provided, provided_workspace, answered}
use @std.avrac.compiler.{Program}
use @std.text.{repeat}

/// The provider: `limited` narrows a `Span` the way `within` narrows
/// a deadline — its head is a value of the library's own type.
fn provider() -> string {
    "export type Span = { n: int }\nexport fn span(n: int) -> Span {\n    Span { n: n }\n}\nexport component limited(limit: Code) {\n    body: Code\n    fn expand() -> Code {\n        quote {\n            {\n                let limit: Span = \${self.limit}\n                let outer = limit.n\n                \${self.body} + outer\n            }\n        }\n    }\n}\n"
}

/// A program whose `/// documented` group opens `export fn f` with the
/// copied template's first statement starting, at ITS file's offset,
/// between this file's `export` and `fn` — where a doc that sought the
/// statement by offset alone would land on the template's.
fn doc_over_copy() -> string {
    let header = "use @x.c.{limited, span}\nlet v = limited span(1) { 1 }\n// "
    let copied_at = "use @std.meta.{Code}\n".length + provider().index_of("let limit")
    let pad = copied_at - 3 - header.length - "\n/// documented\n".length
    "${header}${repeat("x", pad)}\n/// documented\nexport fn f() -> int { 1 }\nv\n"
}

/// A program over the provider.
fn packaged(main: string) -> Program {
    provided(main, provider())
}

spec "features/components — a template's instance" {
    given "the instance" {
        then "answers its template's value, the head and block in their holes" {
            answered(packaged("use @x.c.{limited, span}\nlimited span(3) { 4 }")) == "7"
        }
        then "the template's types resolve in the library — the user never imports `Span`" {
            answered(packaged("use @x.c.{limited, span}\nlet v = limited span(1) { 1 }\nv")) == "2"
        }
        then "the template's binders are its own — the user's `outer` is the user's" {
            answered(
                packaged("use @x.c.{limited, span}\nlet outer = 100\nlimited span(1) { outer }"),
            ) == "101"
        }
        then "an alias opens the instance under its new word" {
            answered(packaged("use @x.c.{limited as bounded, span}\nbounded span(2) { 2 }")) == "4"
        }
        then "a line only the word can parse does not hide the import that names it" {
            answered(
                packaged(
                    "use @x.c.{limited, span}\nlet w = match limited span(1) { 1 } {\n    2 -> \"two\",\n    _ -> \"other\",\n}\nw",
                ),
            ) == "two"
        }
    }
    given "the laws" {
        then "a head of the wrong type is the template's typed binding, refused at the user's head" {
            let p = packaged("use @x.c.{limited}\nlet v = limited 5 { 1 }\nv")
            refused_n(p, "`limit` declares `Span`, this is `int`", 1) &&
                p.report().contains("main.av:2")
        }
    }
    given "visible magic" {
        then "`expand` notes what the instance became, and the module its names resolve in" {
            let p = packaged("use @x.c.{limited, span}\nlet v = limited span(1) { 1 }\nv")
            let shown = p.expanded_source(p.ws.file_id("/w/src/main.av"))
            shown.contains("limited span(1) {") &&
                shown.contains("// `limited` (from @x.c) expands to:") &&
                shown.contains("let limit: Span = span(1)")
        }
    }
    given "a doc group beside an instance whose template was copied in" {
        then "the canonical print keeps the group — a copied statement's origin offset claims no doc here" {
            let src = doc_over_copy()
            let ws = provided_workspace(src, provider())
            match ws.write_checked_source(ws.file_id("/w/src/main.av")) {
                .Ok(text) -> text.contains("/// documented\nexport fn f()"),
                .Err(_) -> false,
            }
        }
    }
}
