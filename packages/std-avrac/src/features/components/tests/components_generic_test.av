//! A component's type parameters are its record's: each is pinned by
//! what an instance writes — the head's value or a field's — and one
//! component at two pins is two records. A parameter no value pins is
//! refused by name, a bound on one holds as a fn's does — the
//! component's fns call its methods, and an instance's argument must
//! implement it — and a parameter names no value.
use @std.avrac.testing.{provided, answered, refused_in}
use @std.avrac.compiler.{Program}

fn over(main: string) -> Program { provided(main, "") }

spec "features/components — type parameters" {
    given "a component's type parameter" {
        then "is pinned by the head's value, per instance" {
            answered(
                over(
                    "component hold<T>(head: T) {\n    tag: string = \"h\"\n}\nlet n = hold 7 { }\nlet s = hold \"hi\" { }\n\"\${n.head} \${s.head} \${s.tag}\"",
                ),
            ) == "7 hi h"
        }
        then "is pinned by a field's value, per instance" {
            answered(
                over(
                    "component slot<T> {\n    held: T\n}\nlet n = slot { held: 7 }\nlet s = slot { held: \"hi\" }\n\"\${n.held} \${s.held}\"",
                ),
            ) == "7 hi"
        }
        then "makes two pins two types — an `int` seat refuses a `string` value" {
            refused_in(
                over(
                    "component slot<T> {\n    held: T\n}\nfn first(s: slot<int>) -> int { s.held }\nlet a = slot { held: \"z\" }\nfirst(a)",
                ),
                "`slot<int>`",
            )
        }
    }
    given "a parameter nothing pins" {
        then "is refused by name" {
            over(
                "component marker<T> {\n    held: int\n}\nexport fn main() -> int {\n    let m = marker { held: 7 }\n    m.held\n}",
            )
                .report()
                .trim() == "error[type.struct_fields]: `T` is not pinned by the fields\n  ╭─[/w/src/main.av:5:13]\n5 │     let m = marker { held: 7 }\n  ·             ┬\n  ·             ╰── in this literal\n──╯\nhelp: give `T`'s field a value of a concrete type"
        }
    }
    given "a bound on a parameter" {
        then "lets the component's fns call the bound's methods on the parameter" {
            answered(
                over(
                    "trait Named {\n    fn name() -> string\n}\ntype P = { n: string }\nimpl Named for P {\n    fn name() -> string { self.n }\n}\ncomponent tag<T: Named>(head: T) {\n    fn shown() -> string { self.head.name() }\n}\nlet p = P { n: \"a\" }\nlet t = tag p { }\nt.shown()",
                ),
            ) == "a"
        }
        then "holds across a package — the dependency declares the component and its trait" {
            answered(
                provided(
                    "use @x.c.{Named, tag}\ntype P = { n: string }\nimpl Named for P {\n    fn name() -> string { self.n }\n}\nlet p = P { n: \"b\" }\nlet t = tag p { }\nt.shown()",
                    "export trait Named {\n    fn name() -> string\n}\nexport component tag<T: Named>(head: T) {\n    fn shown() -> string { self.head.name() }\n}\n",
                ),
            ) == "b"
        }
        then "refuses an instance whose type argument does not implement it" {
            refused_in(
                over(
                    "trait Named {\n    fn name() -> string\n}\ncomponent tag<T: Named>(head: T) {\n    fn shown() -> string { self.head.name() }\n}\nlet t = tag 7 { }\nt.shown()",
                ),
                "`int` does not implement `Named`",
            )
        }
        then "refuses a written type argument that does not implement it" {
            refused_in(
                over(
                    "trait Named {\n    fn name() -> string\n}\ncomponent tag<T: Named> {\n    held: List<T> = []\n}\nlet t = tag<int> { }\nt.held.length",
                ),
                "`int` does not implement `Named`",
            )
        }
    }
    given "an unbounded parameter's method call" {
        then "is refused, and the help writes the bound a component takes" {
            refused_in(
                over(
                    "component tag<T>(head: T) {\n    fn shown() -> string { self.head.name() }\n}\nlet t = tag 7 { }\nt.shown()",
                ),
                "help: add a bound — `<T: SomeTrait>`",
            )
        }
    }
    given "a bound naming no trait" {
        then "is refused where it is written" {
            refused_in(
                over(
                    "component tag<T: Nope>(head: T) {\n    label: string = \"x\"\n}\nlet t = tag 7 { }\nt.label",
                ),
                "a bound names a trait, and `Nope` is not one",
            )
        }
    }
    given "a parameter read where a value goes" {
        then "names no value" {
            over(
                "component q<T> {\n    held: T\n}\nexport fn main() -> int {\n    let x = T\n    0\n}",
            )
                .report()
                .trim() == "error[resolve.unresolved]: `T` is not defined\n  ╭─[/w/src/main.av:5:13]\n5 │     let x = T\n  ·             ┬\n  ·             ╰── not defined anywhere in this program\n──╯\nhelp: define it above this use — `let T = …` — or import it — `use module.{T}`"
        }
    }
    given "an instance's written type arguments" {
        then "pin the parameter from the written type" {
            answered(
                over(
                    "component slot<T> {\n    held: T\n}\nlet si = slot<int> { held: 42 }\n\"\${si.held}\"",
                ),
            ) == "42"
        }
        then "seat a named instance's parameter with no field value" {
            answered(
                over(
                    "component queue<T> {\n    capacity: int = 1000\n}\nqueue<int> counts { capacity: 5 }\n\"\${counts.capacity}\"",
                ),
            ) == "5"
        }
        then "a wrong count is refused by name" {
            refused_in(
                over(
                    "component slot<T> {\n    held: T\n}\nlet si = slot<int, int> { held: 1 }\nsi.held",
                ),
                "error[type.struct_targs]",
            )
        }
    }
}
