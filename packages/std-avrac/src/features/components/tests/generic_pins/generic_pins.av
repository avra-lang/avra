// proves: a component's type parameter is pinned by what an instance
// writes — its head or a field — and one component at two pins expands
// to two records, each built for its own
component hold<T>(head: T) {
    tag: string = "h"
}
component slot<T> {
    held: T
}
fn first(s: slot<int>) -> int { s.held }
let n = hold 7 {}
let b = hold 5
let s = hold "hi" {}
let si = slot { held: 42 }
let ss = slot { held: "z" }
"${n.head} ${n.tag} ${b.head} ${s.head} ${s.tag} ${first(si)} ${ss.held}"
