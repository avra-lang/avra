// proves: a template component's instance is its quote, copied where
// it stands — the head evaluated once, the template's binders apart
// from the user's, instances nested, in a fn body, in a match head,
// a `return` in the block leaving the fn it stands in, and the
// instance inside a loop, a list, a lambda, a task and a string hole
use @test.tally.{tally, Tally}

fn tick(runs: Cell<int>, n: int) -> Tally {
    runs.set(runs.get() + 1)
    Tally { n: n }
}
let runs: Cell<int> = Cell.new(0)
let seen = 1000
let hygienic = tally tick(runs, 1) { seen }
let nested = tally (Tally { n: 10 }) { tally (Tally { n: 100 }) { 1 } }
fn inside(x: int) -> int {
    tally (Tally { n: x }) { x * 2 }
}
fn leaves(x: int) -> int {
    let v = tally (Tally { n: 1 }) {
        if x > 5 { return 0 - 1 }
        x
    }
    v * 10
}
mut total = 0
for i in 0..3 {
    total = total + (tally (Tally { n: i }) { i })
}
let listed = [tally (Tally { n: 1 }) { 1 }, tally (Tally { n: 2 }) { 2 }]
let deferred = (x: int) -> tally (Tally { n: x }) { x }
let task = spawn { tally (Tally { n: 40 }) { 1 } }
let crossed = "${total} ${listed[1]} ${deferred(3)} ${task.await} ${"in ${tally (Tally { n: 1 }) { 1 }}"}"
let chosen = match tally (Tally { n: 2 }) { 3 } { 5 -> "five", _ -> "other" }
"${hygienic} ${runs.get()} ${nested} ${inside(4)} ${leaves(2)} ${leaves(9)} ${chosen} ${crossed}"
