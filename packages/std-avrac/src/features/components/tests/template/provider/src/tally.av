//! A toy template component: `tally n { … }` counts its block's runs
//! into a cell it is handed, and answers the block's value plus `n`.
//! Its binders (`seen`, `step`) are the template's own.
use @std.meta.{Code}

export type Tally = { n: int }

export component tally(head: Code) {
    body: Code
    fn expand() -> Code {
        quote {
            {
                let step: Tally = ${self.head}
                let seen = step.n
                ${self.body} + seen
            }
        }
    }
}
