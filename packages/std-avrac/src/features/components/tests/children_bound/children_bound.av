// proves: a named child instance binds its name AND joins its parent's list
// field — one level and two deep, beside a setting, in a branch, and in a
// `collect` with or without a seat naming its element.
component leaf {
    @names name: string
    note: string = ""
}

component twig {
    @names name: string
    label: string = ""
    leaves: List<leaf> = []
}

component tree {
    @names name: string
    twigs: List<twig> = []
}

twig low {
    label: "old"
    leaf acorn {
        note: "small"
    }
    if acorn.note == "small" {
        leaf bud {}
    }
}

tree oak {
    twig high {
        leaf moss {}
        leaf lichen {}
    }
    twig dry {}
}

let seated: List<leaf> = collect {
    leaf a {}
}

let unseated = collect {
    leaf b {}
    leaf c {}
}

"${low.label} ${[l.name for l in low.leaves].join(",")} ${[t.name for t in oak.twigs].join(",")} ${[l.name for l in oak.twigs[0].leaves].join(",")} ${seated.length} ${unseated.length}"
