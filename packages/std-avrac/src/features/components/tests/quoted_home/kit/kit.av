use @std.meta.{Code}

/// A label of `T`, made by a fn the instance's file never imports.
export fn labelled<T>(value: T, show: fn(T) -> string) -> string { "<${show(value)}>" }

fn plain_label(n: int) -> string { "#${n}" }

export component tag(n: int) {
    body: Code
    fn expand() -> Code {
        quote {
            let n = ${self.n}
            labelled(n, ${self.body}) + plain_label(n)
        }
    }
}
