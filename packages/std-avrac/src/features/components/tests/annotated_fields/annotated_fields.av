// proves: an instance's `///` fills its component's `doc`, and each
// annotation sharing a `List` field's name adds one element to it — a
// text from its one argument, a record from its arguments by position,
// the fields it writes none for defaulted — in every engine alike, read
// off the instance or gathered by a `collect`, a component that checks its
// instances among them.
use @std.meta.{Diagnostic}
component told {
    run: fn(int) -> int
    doc: string = ""
    says: List<string> = []
    fixes: List<Pair> = []

    fn check() -> List<Diagnostic> { [] }
}
type Pair = { left: string, right: string = "none" }
/// Doubles what it is given.
@says("first")
@says("second")
@fixes("a", "b")
@fixes("c")
export told twice { n -> n * 2 }
export told plain { n -> n }
type Said = { name: string, doc: string, says: List<string>, fixes: List<Pair> }
collect said: List<Said> = told in self as Said { name: it.name, doc: it.doc, says: it.says, fixes: it.fixes } by it.name
"${twice.run(4)}|${twice.doc}|${twice.says.join(",")}|${[p.left + p.right for p in twice.fixes].join(",")}|${plain.doc}|${plain.says.length}|${plain.fixes.length}|${["${s.name}:${s.doc}:${s.says.join("+")}:${s.fixes.length}" for s in said].join(";")}"
