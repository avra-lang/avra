// proves: a component's `mut fn` writes a plain field of the instance it is handed and pushes into a
// `state` field every copy shares — in both engines
component tray {
    capacity: int = 1
    state seen: List<int> = []
    mut fn grow(by: int) {
        self.capacity = self.capacity + by
        self.seen.push(by)
    }
}

fn grown() -> string {
    tray t { capacity: 2 }
    mut m = t
    m.grow(3)
    m.grow(4)
    "${m.capacity} ${m.seen.length} ${t.seen.length}"
}

grown()
