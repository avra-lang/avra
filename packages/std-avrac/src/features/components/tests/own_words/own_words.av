// proves: a component the program's own module declares takes its
// instance sugar with no `use` — declared above, below, or in a sibling
// file — while its word stays an ordinary name everywhere it names no
// instance (a type, a literal, a parameter, a local).
component folds {
    run: fn(int, int) -> int
}
folds add { a, b -> a + b }
scales twice { n -> n * 2 }
fn applied(f: folds, a: int) -> int { f.run(a, a) }
fn inner() -> int {
    folds mul { a, b -> a * b }
    mul.run(3, 4)
}
fn shadowed(folds: int) -> int { folds + 1 }
let spelled: folds = folds { run: (a: int, b: int) -> a - b }
arms_after picks { 0 -> "zero", n -> "some" }
"${add.run(2, 3)} ${twice.run(5)} ${applied(add, 4)} ${inner()} ${shadowed(1)} ${spelled.run(9, 2)} ${picks.run(0)}"
component arms_after {
    run: fn(int) -> string
}
