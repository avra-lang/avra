// A component marked `@seeded_at_need` holds no cell for an own `state`
// until the state is first needed: a read answers the seed over the
// members the value holds then, a write seeds it and then writes, and
// `seeded` seeds every own place at once. A seed runs at most once per
// instance that is kept.
use @std.avrac.testing.{provided, answered, refused_in}
use @std.avrac.testing.held.{Judged}

/// The provider: a box whose count is seeded at need, every seed counted.
fn parts() -> string {
    "use @std.meta.{seeded_at_need}\nstate seeds: int = 0\nfn counted(v: int) -> int {\n    seeds = seeds + 1\n    v\n}\nexport fn seeds_run() -> int { seeds }\nexport fn made(label: string) -> box { box label }\n@seeded_at_need\nexport component box(label: string) {\n    initial: int = 0\n    state n: int = counted(self.initial)\n    state next: int = self.n + 1\n    fn poke() { self.n = self.n + 1 }\n    fn shown() -> string { \"\${self.label}=\${self.n}\" }\n}\n"
}

fn built(main: string) -> Judged { provided("use @std.meta.{seeded}\nuse @x.c.{box, made, seeds_run}\n" + main, parts()) }

spec "features/components — a state seeded at need" {
    given "a marked component's value that never stood" {
        then "answers its seed over the members it holds when it is read" {
            answered(built("let a = (box \"a\") with { initial: 5 }\n\"\${a.n} \${a.shown()}\"")) == "5 a=5"
        }
        then "runs its seed at each read, and keeps nothing" {
            answered(built("let a = box \"a\"\nlet x = a.n + a.n\n\"\${x} \${seeds_run()}\"")) == "0 2"
        }
        then "builds a thousand values without running one seed" {
            answered(
                built(
                    "let all = [made(\"\${i}\") for i in 0..1000]\n\"\${all.length} \${seeds_run()}\"",
                ),
            ) == "1000 0"
        }
        then "seeds a place another seed reads, first" { answered(built("let a = box \"a\" { initial: 2 }\n\"\${a.n} \${a.next}\"")) == "2 3" }
    }
    given "a marked component's value, written" {
        then "is seeded, then written, and the write stays" {
            answered(
                built(
                    "let a = box \"a\" { initial: 3 }\na.poke()\na.poke()\n\"\${a.shown()} \${seeds_run()}\"",
                ),
            ) == "a=5 1"
        }
    }
    given "a marked component's value, kept" {
        then "runs each seed once however often it is read" {
            answered(
                built(
                    "let a = seeded(box \"a\" { initial: 4 })\nlet x = a.n + a.n + a.n\n\"\${x} \${seeds_run()}\"",
                ),
            ) == "12 1"
        }
    }
    given "a copy of a marked component" {
        then "taken before it stands, seeds its own from its own members" {
            answered(
                built(
                    "let a = box \"a\"\nlet b = a with { initial: 5 }\nb.poke()\n\"\${a.shown()} \${b.shown()}\"",
                ),
            ) == "a=0 a=6"
        }
        then "taken once it stands, shares the cell the stand holds" {
            answered(
                built(
                    "let a = seeded(box \"a\")\nlet b = a with { label: \"b\" }\nb.poke()\na.poke()\n\"\${a.shown()} \${b.shown()}\"",
                ),
            ) == "a=2 b=2"
        }
    }
    given "seeds that read each other" {
        then "are refused where they are declared" {
            refused_in(
                provided(
                    "use @x.c.{loop}\n0",
                    "use @std.meta.{seeded_at_need}\n@seeded_at_need\nexport component loop {\n    state x: int = self.y\n    state y: int = self.x\n}\n",
                ),
                "`loop`'s `state x` and `state y` each start from the other",
            )
        }
    }
}
