// proves: field DEFAULTS — declared once, typed under the field's
// want, filled at every literal that omits the field; a component's
// literal takes them like any record's; a managed default is
// value-semantic across instances; raw strings keep everything.
type P = { x: int, y: int = 7, tags: List<string> = [], label: string = "none" }
fn twice(n: int) -> int {
    n * 2
}
component Cfg {
    name: string
    depth: int = 3
    f: fn(int) -> int = twice
    notes: List<string> = ["a"]
}
let c = Cfg { name: "one" }
let d = Cfg { name: "two", depth: 9 }
let p = P { x: 1 }
let q = P { x: 2, y: 3, label: "set" }
mut a = P { x: 0 }
mut b = P { x: 0 }
a.tags.push("only-a")
mut i = 0
mut made = 0
while i < 300 {
    let e = P { x: i }
    made = made + e.y + e.tags.length + e.label.length
    i = i + 1
}
let raw = """line one "quoted" and ${not a hole}
line two"""
"${p.y} ${p.tags.length} ${p.label} ${q.y} ${q.label} ${a.tags.length} ${b.tags.length} ${c.depth} ${c.f(21)} ${c.notes[0]} ${d.depth} ${d.name} ${raw.length} ${made}"
