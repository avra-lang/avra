//! Components whose head has seats past its first: a record, `tab`, whose
//! second seat is a place and whose third has a default, and a template,
//! `scaled`, whose second seat's default reads a name only this file sees.
use @std.meta.{Code}

export enum Show {
    All
    Active
    Done
}

fn marked() -> string { "*" }

const unit: int = 7

export component tab(label: string, state chosen: Show, mark: string = marked()) {
    shows: Show
    fn pick() { self.chosen = self.shows }
    fn said() -> string { if self.chosen == self.shows { "${self.mark}${self.label}" } else { self.label } }
}

export component scaled(head: Code, by: Code = quote { unit }) {
    body: Code
    fn expand() -> Code { quote { ${self.head} * ${self.by} + ${self.body} } }
}
