// proves: an instance's head value fills its component's first head seat and
// a later seat is set by name in its block, in any order among its settings,
// or left to its default — a `state` seat handed a place, a record's default
// and a template's read where the provider declares them — and means what
// the instance with every head value written in order means; a record's
// settings are evaluated in the order they are written, a head seat's too.
use @test.heads.{tab, scaled, Show}

state filter: Show = .All

let all = tab "All" { chosen: filter, shows: .All }
let done = tab "Done" { shows: .Done, chosen: filter, mark: "+" }
let active = tab "Active" {
    shows: .Active
    chosen: filter
}
let before = "${all.said()} ${done.said()} ${active.said()}"
done.pick()
let after = "${all.said()} ${done.said()} ${active.said()} ${filter == Show.Done}"
fn shown(n: int, s: Show) -> Show {
    println("set ${n}")
    s
}

fn marked(n: int, m: string) -> string {
    println("set ${n}")
    m
}

let ordered = tab "Ordered" { shows: shown(2, .Active), mark: marked(1, "~"), chosen: filter }
let x = 3
let defaulted = scaled 2 { x }
let named = scaled 2 {
    by: 10
    x
}
"${before} | ${after} | ${defaulted} ${named} | ${ordered.mark}${ordered.shows == Show.Active}"
