// proves: a head prop of a stateful component whose type compares by value is a
// cell, as a `state` is: a write through one holder — a `let`, a fn handed it,
// the binder an unwrap names — is read through every other, while a prop that
// does not compare by value stays a plain field, which a `mut` copy writes alone.
component badge(label: string, tags: List<string>) {
    state n: int = 0
}

fn relabel(b: badge) { b.label = "${b.label}!" }

fn held_relabel(b: badge?, to: string) {
    let held? = b else { return }
    held.label = "${held.label} ${to}"
}

let a = badge "first" { tags: ["t"] }
let b = a
b.label = "second"
relabel(a)
held_relabel(b, "held")
held_relabel(null, "none")
mut c = a
c.tags.push("u")
c.n = 3
println("${a.label} | ${b.label} | ${c.label} | ${a.tags.length} ${c.tags.length} | ${a.n} ${b.n}")
