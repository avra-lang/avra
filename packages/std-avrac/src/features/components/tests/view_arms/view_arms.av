// A component body's `match` draws a different component per arm: each
// arm hears the element the children's seat wants, and is boxed into it.
trait View {
    fn text() -> string
}

component note(t: string) {}

component badge(n: int) {}

impl View for note {
    fn text() -> string { self.t }
}

impl View for badge {
    fn text() -> string { "#${self.n}" }
}

component card(title: string) {
    items: List<dyn View> = []
}

enum Kind {
    Word(t: string)
    Count(n: int)
    Pair
}

fn drawn(k: Kind) -> card {
    let c = card "t" {
        match k {
            .Word(t) -> note t,
            .Count(n) -> badge n,
            .Pair -> {
                note "a"
                badge 2
            },
        }
        note "end"
    }
    c
}

fn shown(c: card) -> string { [v.text() for v in c.items].join(" ") }

"${shown(drawn(Kind.Word("w")))} | ${shown(drawn(Kind.Count(3)))} | ${shown(drawn(Kind.Pair))}"
