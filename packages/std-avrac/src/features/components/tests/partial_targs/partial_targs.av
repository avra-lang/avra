// proves: a component instance writes its type arguments as a PREFIX — `queue<int> jobs { … }`
// pins `T` and leaves `E` to the fields (`dead:` names it) or, where no field does, to the default
// its declaration writes (`E = never`), whose nullable holds only `null`; a written argument
// overrides the default.
type Dead<T, E> = { item: T, why: E }

type Sink<X> = { held: List<X> }

component queue<T, E = never> {
    capacity: int = 3
    dead: Sink<Dead<T, E>>? = null
}

let letters = Sink { held: [Dead { item: 1, why: "late" }] }

queue<int> jobs { dead: letters }
queue<int> plain { capacity: 5 }
queue<int, string> pinned { capacity: 2 }

"${jobs.capacity} ${jobs.dead?.held?.length ?? 0} ${plain.capacity} ${plain.dead == null} ${pinned.capacity} ${pinned.dead == null}"
