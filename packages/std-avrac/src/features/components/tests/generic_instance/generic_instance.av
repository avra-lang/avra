// proves: a named component instance writes type arguments after its
// word — `queue<Charge> charges { … }` pins the record's parameter
// from the WRITTEN type, so a queue whose head is a value-less name
// still seats its element type — and its name still lands as a child
// of a parent that lists it.
type Charge = { id: int }

component queue<T> {
    capacity: int = 1000
    dead: T? = null
}

// a parent whose list is of the same component routes the named
// instance to it, so the pre-scan sees past the written type args
component rack {
    qs: List<queue<Charge>> = []
}

queue<Charge> charges { capacity: 5 }
queue<int> counts { capacity: 2 }
rack board { charges }

"${charges.capacity} ${counts.capacity} ${board.qs.length}"
