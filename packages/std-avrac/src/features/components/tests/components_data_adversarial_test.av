// Data instances under attack: every seat holding the wrong thing, the
// body in shapes the record cannot take, and the one-voice law.
use @std.avrac.testing.{provided, answered, refused_in}
use @std.avrac.compiler.{Program}

/// The provider: a headed row, a named grid with one children slot,
/// a record with no `List` field, one with two, and one with two heads.
fn shapes() -> string {
    "export component row(id: int) {\n    label: string = \"?\"\n}\n\nexport component grid {\n    name: string\n    title: string = \"\"\n    rows: List<row> = []\n}\n\nexport component blank {}\n\nexport component two {\n    xs: List<int> = []\n    ys: List<int> = []\n}\n\nexport component pair(a: int, b: int) {}\n"
}

fn attacked(main: string) -> Program {
    provided("use @x.c.{row, grid, blank, two, pair}\n" + main, shapes())
}

spec "features/components — a record's instance, adversarial" {
    given "degenerate shapes" {
        then "an empty record's empty instance stands" {
            answered(attacked("let b = blank { }\n1")) == "1"
        }
        then "a record with two slots and one set by name fills the other" {
            answered(attacked("let t = two {\n    xs: [1]\n    2\n}\nt.ys[0] + t.xs[0]")) == "3"
        }
    }
    given "the wrong thing in every seat" {
        then "a setting of the wrong type is the field's refusal, at the setting" {
            refused_in(attacked("grid g {\n    title: 5\n}\n0"), "field `title` is `string`, this is `int`")
        }
        then "a setting the record lacks names its fields" {
            refused_in(attacked("grid g {\n    nope: 5\n}\n0"), "`grid` has no field `nope`")
        }
        then "a setting written twice refuses the second" {
            refused_in(attacked("grid g {\n    title: \"a\"\n    title: \"b\"\n}\n0"), "field `title` is written more than once")
        }
        then "a child of the wrong type refuses where it stands" {
            let p = attacked("grid g {\n    row 1\n    5\n}\n0")
            refused_in(p, "this list holds `row`, this is `int`") && p.report().contains("main.av:4")
        }
        then "a required field left unwritten is the record's refusal" {
            refused_in(attacked("let v = grid {\n    title: \"a\"\n}\n0"), "`grid` needs field `name`")
        }
    }
    given "bodies the record cannot take" {
        then "children with no `List` field to fill" {
            refused_in(attacked("let v = blank {\n    1\n}\n0"), "`blank` declares no `List` field, so its block holds settings only")
        }
        then "children beside their slot set by name" {
            refused_in(attacked("grid g {\n    rows: []\n    row 1\n}\n0"), "`rows` is set by name, and the block's statements would fill it too")
        }
        then "children with two slots open" {
            refused_in(attacked("let t = two {\n    1\n}\n0"), "`two` has 2 `List` fields its statements could fill — set each by name: `xs: […]`")
        }
    }
    given "heads" {
        then "a missing head counts what was written" {
            refused_in(attacked("let r = row { }\n0"), "`row` takes 1 head value before its block, and this instance writes 0")
        }
        then "two heads cannot be written as one value" {
            refused_in(attacked("let p = pair 1 { }\n0"), "`pair` takes 2 head values before its block, and this instance writes 1")
        }
        then "a headless record refuses a value head and names both forms" {
            refused_in(attacked("let g = grid x { }\n0"), "`grid` takes no head value — name it at a statement (`grid name { … }`), or write `grid { … }`")
        }
        then "an imported word's refusal carries no import remedy" {
            let p = attacked("let v = blank {\n    1\n}\n0")
            refused_in(p, "`blank` declares no `List` field") && !p.report().contains("use @x.c.{blank}")
        }
    }
}
