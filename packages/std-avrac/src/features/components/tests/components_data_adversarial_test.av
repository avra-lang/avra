// Data instances under attack: every seat holding the wrong thing, the
// body in shapes the record cannot take, and the one-voice law.
use @std.avrac.testing.{provided, answered, refused_in}
use @std.avrac.testing.held.{Judged}

/// The provider: a headed row, a named grid with one children slot,
/// a record with no `List` field, one with two, and one with two heads.
fn shapes() -> string {
    "export component row(id: int) {\n    label: string = \"?\"\n}\n\nexport component pairs {\n    left: List<row> = []\n    right: List<row> = []\n}\n\nexport component grid {\n    name: string\n    title: string = \"\"\n    rows: List<row> = []\n}\n\nexport component blank {}\n\nexport component two {\n    xs: List<int> = []\n    ys: List<int> = []\n}\n\nexport component pair(a: int, b: int) {}\n"
}

fn attacked(main: string) -> Judged {
    provided("use @x.c.{row, grid, blank, two, pair, pairs}\n" + main, shapes())
}

spec "features/components — a record's instance, adversarial" {
    given "degenerate shapes" {
        then "an empty record's empty instance stands" {
            answered(attacked("let b = blank { }\n1")) == "1"
        }
        then "a record with two slots and one set by name fills the other" {
            answered(attacked("let t = two {\n    xs: [1]\n    2\n}\nt.ys[0] + t.xs[0]")) == "3"
        }
    }
    given "the wrong thing in every seat" {
        then "a setting of the wrong type is the setting's refusal, at the setting" {
            let p = attacked("grid g {\n    title: 5\n}\n0")
            refused_in(p, "setting `title` takes `string`, this is `int`") &&
                p.report().contains("main.av:3:12")
        }
        then "a setting the record lacks names its fields" {
            refused_in(attacked("grid g {\n    nope: 5\n}\n0"), "`grid` has no field `nope`")
        }
        then "a setting written twice refuses the second" {
            refused_in(
                attacked("grid g {\n    title: \"a\"\n    title: \"b\"\n}\n0"),
                "field `title` is written more than once",
            )
        }
        then "a child of the wrong type refuses where it stands" {
            let p = attacked("grid g {\n    row 1\n    5\n}\n0")
            refused_in(p, "this list holds `row`, this is `int`") &&
                p.report().contains("main.av:4")
        }
        then "a required field left unwritten is the record's refusal" {
            refused_in(
                attacked("let v = grid {\n    title: \"a\"\n}\n0"),
                "`grid` needs field `name`",
            )
        }
    }
    given "bodies the record cannot take" {
        then "children with no `List` field to fill" {
            refused_in(
                attacked("let v = blank {\n    1\n}\n0"),
                "`blank` declares no `List` field, so its block holds settings only",
            )
        }
        then "children beside their slot set by name join after the setting's list" {
            answered(
                attacked(
                    "grid g {\n    rows: [row 1]\n    row 2\n    row 3\n}\n[\"\${r.id}\" for r in g.rows].join(\",\")",
                ),
            ) == "1,2,3"
        }
        then "a child two same-typed fields could take is not guessed into either" {
            refused_in(
                attacked("let p = pairs {\n    row 1\n}\n0"),
                "`pairs` has 2 `List` fields its statements could fill",
            )
        }
        then "children with two slots open" {
            refused_in(
                attacked("let t = two {\n    1\n}\n0"),
                "`two` has 2 `List` fields its statements could fill — fill each by its name, `xs { … }`, or mark the one bare statements fill `@default`",
            )
        }
    }
    given "heads" {
        then "a missing head names the first seat, written before the block" {
            refused_in(
                attacked("let r = row { }\n0"),
                "`row` writes its first head seat, `id`, before its block: `row <id> { … }`",
            )
        }
        then "a later head seat is set by name in the block, in any order among its settings" {
            answered(attacked("let p = pair 1 { b: 2 }\np.a * 10 + p.b")) == "12"
        }
        then "a later head seat no setting names and no default fills is refused by name" {
            refused_in(
                attacked("let p = pair 1 { }\n0"),
                "`pair` takes `b` by name in its block, after its head value — write `b: …`",
            )
        }
        then "the seat the head value filled, set again by name, is refused" {
            refused_in(
                attacked("let p = pair 1 { a: 3, b: 2 }\n0"),
                "`a` is `pair`'s head value here, written before the block — a setting sets it twice",
            )
        }
        then "a later head seat set twice is refused" {
            refused_in(
                attacked("let p = pair 1 {\n    b: 2\n    b: 3\n}\n0"),
                "`pair`'s block sets its head seat `b` twice",
            )
        }
        then "a record literal of a headed component is refused, its first seat moved to the head by the fix" {
            refused_in(
                attacked("let r = row { id: 1 }\n0"),
                "`row`'s first head seat, `id`, is written before its block, never set by name",
            )
        }
        then "the first head seat takes no default" {
            refused_in(
                attacked("component lead(a: int = 1) {}\n0"),
                "a component's first head seat, `a`, is what every instance writes before its block, so it takes no default",
            )
        }
        then "a `state` head seat takes no default" {
            refused_in(
                attacked("component held(a: int, state b: int = 0) {}\n0"),
                "the head seat `b` is `state`: every instance hands it a place of its own, so it takes no default",
            )
        }
        then "a head seat and a field of one name are refused at the declaration" {
            refused_in(
                provided(
                    "use @x.c.{clash}\nlet c = clash 1 { }\n0",
                    "export component clash(x: int) {\n    x: int = 0\n}\n",
                ),
                "`clash` declares `x` more than once",
            )
        }
        then "a headless record refuses a value head and names both forms" {
            refused_in(
                attacked("let g = grid x { }\n0"),
                "`grid` takes no head value — name it at a statement (`grid name { … }`), or write `grid { … }`",
            )
        }
        then "an imported word's refusal carries no import remedy" {
            let p = attacked("let v = blank {\n    1\n}\n0")
            refused_in(p, "`blank` declares no `List` field") &&
                !p.report().contains("use @x.c.{blank}")
        }
    }
}
