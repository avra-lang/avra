//! An instance's compile-time `check`: the record's own method, run
//! over the instance as the compiler settles it, its diagnostics
//! spoken at the instance. An instance only a run can build — one
//! that reads a parameter or the world — is not checked.
use core.{ExprId, StmtId, TypeId, Reg, Annotation, Span, joined, doc_first_paragraph}
use features.{LowerCx, SettleRoot, Unsettled, nothing}
use features.structs.{defaulted_reg}
use @std.meta.{Diagnostic}
use diagnostics.{Diag, refusal, warning}

/// A component instance's `doc`/annotation-fed fields, filled from
/// what only the WRAPPING STATEMENT carries — the `///` above it and
/// its `@name(args)` annotations — since neither exists yet while
/// the instance's own record literal is built (an annotation wraps
/// the statement from OUTSIDE, once the statement already stands:
/// `core/store.av`'s `annotate`/`annotate_before`). A field named
/// `doc` reads the statement's own `///`, first paragraph; any OTHER
/// `List<R>` field whose name an annotation shares gets one `R` per
/// matching annotation, built from its arguments by position — a
/// one-arg annotation into `List<string>` appends the string.
fn augmented(mut cx: LowerCx, e: ExprId, x: ExprId, base: Reg) -> Reg {
    let owner? = cx.view.store.instance_owner(e) else { return base }
    let ty = cx.type_at(x)
    let sig? = cx.fields_of(ty) else { return base }
    for j, name in sig.names {
        if name == "doc" {
            cx.field_written(base, ty, j, cx.const_str(doc_text(cx, owner)))
        } else {
            let anns = [a for a in cx.view.store.annotations_of(owner) if a.name == name]
            if !anns.is_empty() { cx.field_written(base, ty, j, annotation_list_reg(cx, anns, sig.types[j])) }
        }
    }
    base
}

fn doc_text(cx: LowerCx, owner: StmtId) -> string {
    joined(doc_first_paragraph(cx.view.store.doc_comment(owner) ?? []), " ")
}

/// Every matching annotation, one `R` each, packed into the field's
/// own `List<R>`.
fn annotation_list_reg(mut cx: LowerCx, anns: List<Annotation>, list_ty: TypeId) -> Reg {
    let elem_ty: TypeId = cx.view.types.element(list_ty) ?? list_ty
    let regs = [annotation_elem_reg(cx, a, elem_ty) for a in anns]
    let size = cx.box_size(regs.length)
    cx.grown_box(cx.view.types.shape_of(list_ty), size, regs)
}

/// One annotation's own `R`: its arguments packed positionally when
/// `R` is a record — trailing fields it wrote none for default, the
/// same law an omitted struct-literal field takes (`structs/
/// lower.av`'s `defaulted_reg`), so `@fixes("before")` fills `Fixes`'
/// `before` and defaults its `after` — else its ONE written
/// argument, R's own shape.
fn annotation_elem_reg(mut cx: LowerCx, a: Annotation, elem_ty: TypeId) -> Reg {
    let one? = a.args.first() else { return cx.mint_ty(elem_ty) }
    let fsig? = cx.fields_of(elem_ty) else { return cx.reg_of(one) }
    if a.args.length > fsig.names.length { return cx.reg_of(one) }
    cx
        .packed_struct(
            elem_ty,
            [if slot < a.args.length { cx.reg_of(a.args[slot]) } else { defaulted_reg(cx, a.callee, fsig, slot) } for slot in 0..fsig.names.length],
        )
}

fn checked(mut cx: LowerCx, e: ExprId, check: ExprId) {
    if !settleable(cx, e, check) { return }
    match cx.jobs.settle(cx.view.file, SettleRoot.Expr(check), cx.seats) {
        .Ok(x) -> { for d in x.saids() { cx.out.voices.speak(said(cx, e, d)) } },
        .Err(why) -> unchecked(cx, e, why),
    }
}

/// Whether the instance reads only what the compiler knows: literals,
/// declarations, `const`s, and what the instance binds itself. A value
/// from outside it — a local, a parameter, `self`, a capture — exists
/// only in a run.
fn settleable(cx: LowerCx, e: ExprId, check: ExprId) -> bool {
    let at? = cx.view.store.expr_span(e) else { return false }
    cx.view.store.every_expr(check).all(known(cx, at, it))
}

fn known(cx: LowerCx, at: Span, x: ExprId) -> bool {
    let b? = cx.names.binding(x) else { return true }
    match b {
        .Decl(_) -> true,
        .Def(s) or .Index(s) -> cx.view.store.const_value(s) != null || held_in(at, cx.view.store.stmt_span(s)),
        // a pattern's binder stands BEFORE its arm, so an arm that IS the
        // instance was bound outside it
        .Pattern(arm, _) or .LambdaParam(arm, _) -> held_within(at, cx.view.store.expr_span(arm)),
        .Param(_) or .Receiver or .Capture(_, _) -> false,
    }
}

fn held_in(at: Span, inner: Span?) -> bool {
    let sp? = inner else { return false }
    sp.lo >= at.lo && sp.hi <= at.hi
}

/// Held in the instance and smaller than it.
fn held_within(at: Span, inner: Span?) -> bool {
    let sp? = inner else { return false }
    held_in(at, sp) && (sp.lo != at.lo || sp.hi != at.hi)
}

/// A check that could not run: it trapped or ran past its budget —
/// the library's check failed, and says so. One that reads what only
/// a run knows is no failure.
fn unchecked(mut cx: LowerCx, e: ExprId, why: Unsettled) {
    match why {
        .Trap(words) or .Budget(words) -> cx.out.voices.speak(check_failed(cx, e, words)),
        .Reach(_) or .Param(_) or .Spoken or .Recursive -> nothing(),
    }
}

// ── voices ──

fn checked_kind() -> string { "lower.component_checked" }

fn said(cx: LowerCx, e: ExprId, d: Diagnostic) -> Diag {
    let at = d.at ?? cx.view.loc_of(e)
    if d.warning { return warning(checked_kind(), at, d.message, "`check` says so of this instance", d.help) }
    refusal(checked_kind(), at, d.message, "`check` refused this instance", d.help)
}

fn check_failed(cx: LowerCx, e: ExprId, words: string) -> Diag {
    refusal(
        checked_kind(),
        cx.view.loc_of(e),
        "this instance's `check` did not run: ${words}",
        "checked here",
        "a `check` runs at compile time over the settings — what fails there is the component's to fix",
    )
}
