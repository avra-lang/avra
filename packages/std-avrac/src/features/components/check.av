//! A component's declaration: its record takes the record's laws — the
//! naming law over its fields, each default a body of its own — and its
//! methods walk as an impl's. Its own laws are its template's: `expand`
//! answers the code an instance becomes, and a template reads each of
//! its instance's fields once.
use core.{StmtId, ExprId, TypeId, DeclId, ComponentParts, Unheard, same_file, user_kind}
use features.{ResolveCx, TypeCx, Unsettled, unsettled_label}
use @std.meta.{Diagnostic}
use diagnostics.{Diag, refusal}
use @std.errors.{Loc}

fn resolve_component(mut cx: ResolveCx, s: StmtId) {
    if cx.refuses_nested(s, "resolve.nested_type", "type declarations") { return }
    let c? = cx.view.store.component_parts(s) else { return }
    cx.check_params(c.head.concat(c.holders), s)
    for f in c.holders {
        if f.default != null { cx.walk_under([], f.default!) }
    }
    cx.impl_stmts(c.fns)
}

fn check_component(mut cx: TypeCx, s: StmtId) {
    let c? = cx.view.store.component_parts(s) else { return }
    seats_law(cx, c)
    check_body(cx, s)
    check_law(cx, c)
    expand_law(cx, c)
    format_law(cx, s, c)
}

/// THE BODY LAW: a component that holds statements is made of them,
/// and what "made of" means is ONE trait's to say — the one wearing
/// `@composes`. Its `derive` ran over the component during this file's
/// resolve; asking again hits the memo, and what it refused is spoken
/// here, as a written `@derive`'s is.
fn check_body(mut cx: TypeCx, s: StmtId) {
    let body? = cx.view.store.component_body(s) else { return }
    let name = cx.view.store.type_decl_name(s) ?? "this component"
    let traits = cx.view.decls.composing_traits()
    let composer? = traits.first() else { return no_composer(cx, s, name) }
    if traits.length > 1 { return two_composers(cx, s, name, [cx.view.decls.decl(t).name for t in traits]) }
    let m? = cx.view.decls.trait_derive(composer) else { return }
    if same_file(cx.view.decls.decl(m).file, cx.view.file) { return }
    let by = cx.view.decls.decl(composer).name
    match cx.view.decls.lifted(m, cx.view.file, s, body, []) {
        .Ok(crossed) -> { for x in crossed.declared_problems() { if !x.warning { body_refused(cx, m, s, x, by) } } },
        .Err(why) -> body_unsettled(cx, s, by, why),
    }
}

/// An event's seats have distinct names: a handler names each one.
fn seats_law(mut cx: TypeCx, c: ComponentParts) {
    for e in c.events() {
        let names = [s.name.of for s in e.says]
        let twice? = names.find([n for n in names if n == it].length > 1) else { continue }
        let declared? = e.holder.default else { continue }
        cx.emit(seat_twice(cx.loc_of(declared), e.name, twice))
    }
}

/// A `check` takes nothing and answers `List<Diagnostic>` — what the
/// compiler speaks at each instance.
fn check_law(mut cx: TypeCx, c: ComponentParts) {
    let m? = c.fns.find((f: StmtId) -> cx.view.store.fn_parts(f)?.name == "check") else { return }
    let d? = cx.view.decls.decl_of(cx.view.file, m) else { return }
    let sig? = cx.view.decls.sig(d)?.fn_sig() else { return }
    let elem: TypeId? = cx.view.types.element(sig.ret)
    if sig.params.length <= 1 && elem != null && cx.view.decls.meta_type(elem!, "Diagnostic") { return }
    cx.emit(no_diagnostics(cx.stmt_loc(m), cx.view.types.name_of(sig.ret)))
}

fn expand_law(mut cx: TypeCx, c: ComponentParts) {
    let expand? = c.fns.find((m: StmtId) -> cx.view.store.fn_parts(m)?.name == "expand") else { return }
    let d? = cx.view.decls.decl_of(cx.view.file, expand) else { return }
    let answer? = cx.view.decls.sig(d)?.fn_sig()?.ret else { return }
    if !cx.view.decls.meta_type(answer, "Code") && !cx.view.decls.meta_type(answer, "Decls") {
        return cx.emit(no_code(cx.stmt_loc(expand), cx.view.types.name_of(answer)))
    }
    let parts? = expand_of(cx.view.store, c) else { return }
    let body? = template_body(cx.view.store, parts) else { return }
    let twice? = read_twice(cx.view.store, body, formats_of(c)) else { return }
    cx.emit(read_again(cx.stmt_loc(expand), c.name, twice))
}

/// A head spelled `Format` is `@std.meta`'s pattern: the instance read
/// the spelling, so the resolved type must agree.
fn format_law(mut cx: TypeCx, s: StmtId, c: ComponentParts) {
    let d? = cx.view.decls.decl_of(cx.view.file, s) else { return }
    let sig? = cx.view.decls.sig(d)?.record_sig() else { return }
    let formats = formats_of(c)
    for j, n in sig.names {
        if formats.contains(n) && !cx.view.decls.meta_type(sig.types[j], "Format") { cx.emit(foreign_format(cx.stmt_loc(s), n)) }
    }
}

/// An instance hears the events its component declares, each with all
/// its event says or none of it: a handler the component cannot hear is
/// refused by name.
fn event_law(mut cx: TypeCx, e: ExprId) {
    let inst? = cx.view.store.instance_parts(e) else { return }
    let body? = inst.body else { return }
    for s in cx.view.store.block_stmts(body) ?? [] {
        let handler? = cx.view.store.setting_parts(s)?.value else { continue }
        let heard? = cx.view.store.on_handler(handler) else { continue }
        let why? = heard.unheard else { continue }
        cx
            .emit(
                match why {
                    .Undeclared(declared) -> undeclared_event(cx.stmt_loc(s), inst.word, heard.event, declared),
                    .Seats(says) -> misheard_event(cx.stmt_loc(s), heard.event, says),
                    .Twice -> heard_twice(cx.stmt_loc(s), inst.word, heard.event),
                },
            )
    }
}

// ── voices ──

fn no_diagnostics(at: Loc?, found: string) -> Diag {
    refusal(
        "type.component_check",
        at,
        "a component's `check` answers `List<Diagnostic>` and takes nothing — this answers `${found}`",
        "this `check`",
        "`fn check() -> List<Diagnostic> { … }`, with `Diagnostic` from `@std.meta`",
    )
}

fn no_code(at: Loc?, found: string) -> Diag {
    refusal(
        "type.component_expand",
        at,
        "`expand` answers the code an instance becomes — `Code`, or `Decls` for declarations — and this answers `${found}`",
        "this `expand`",
        "answer a template: `fn expand() -> Code { quote { … } }`",
    )
}

fn read_again(at: Loc?, name: string, field: string) -> Diag {
    refusal(
        "type.component_twice",
        at,
        "the template of `${name}` reads `self.${field}` twice — an instance's code runs where the template writes it, once",
        "this `expand`",
        "bind it once — `let v = \${self.${field}}` — and read `v` after",
    )
}

fn foreign_format(at: Loc?, field: string) -> Diag {
    refusal(
        "type.component_format",
        at,
        "a `Format` head is `@std.meta`'s pattern type, and `${field}`'s `Format` names another",
        "this component",
        "`use @std.meta.{Format}`, or rename the other type",
    )
}

fn undeclared_event(at: Loc?, word: string, event: string, declared: List<string>) -> Diag {
    refusal(
        "type.component_event",
        at,
        "`${word}` declares no event `${event}` — an instance hears the events its component declares",
        "heard here",
        if declared.is_empty() { "`${word}` declares no events" } else { "the events of `${word}` are ${ticked(declared)}" },
    )
}

fn misheard_event(at: Loc?, event: string, says: List<string>) -> Diag {
    refusal(
        "type.component_event",
        at,
        "`${event}` says ${if says.is_empty() { "nothing" } else { ticked(says) }} — a handler hears all its event says, or none of it",
        "heard here",
        heard_forms(event, says),
    )
}

/// The ways a handler may hear the event.
fn heard_forms(event: string, says: List<string>) -> string {
    if says.is_empty() { return "`on ${event} { … }`" }
    "`on ${event} { ${says.join(", ")} -> … }`, or `on ${event} { … }`"
}

fn heard_twice(at: Loc?, word: string, event: string) -> Diag {
    refusal(
        "type.component_event",
        at,
        "an instance hears an event once, and this `${word}` hears `${event}` again",
        "heard again here",
        "keep one handler for `${event}`",
    )
}

fn seat_twice(at: Loc?, event: string, seat: string) -> Diag {
    refusal(
        "type.component_event",
        at,
        "an event's seats have distinct names, and `${event}` names `${seat}` twice",
        "declared here",
        "rename one — a handler names each seat it is told",
    )
}

/// Words as a refusal lists them.
fn ticked(words: List<string>) -> string { ["`${w}`" for w in words].join(", ") }

/// What a composing trait refused of a component's body — its own
/// words, under its package's kind.
fn body_refused(mut cx: TypeCx, d: DeclId, s: StmtId, x: Diagnostic, by: string) {
    let kind = user_kind(cx.view.decls.package_of(d), x.kind) ?? body_kind
    let _ = cx
        .spoken(refusal(kind, x.at ?? cx.view.stmt_loc(s), x.message, "refused by `${by}`", x.help))
}

const body_kind = "type.component_body"

fn body_unsettled(mut cx: TypeCx, s: StmtId, by: string, why: Unsettled) {
    let label = unsettled_label(by, why)
    if label.is_empty() { return }
    let _ = cx
        .spoken(
            refusal(
                body_kind,
                cx.view.stmt_loc(s),
                "a component's body could not be composed",
                label,
                "what composes a body runs at compile time from pure computation alone",
            ),
        )
}

fn no_composer(mut cx: TypeCx, s: StmtId, name: string) {
    let _ = cx
        .spoken(
            refusal(
                body_kind,
                cx.view.stmt_loc(s),
                "a component is made of what its body holds, and nothing here says what `${name}`'s is",
                "holds statements",
                "a library says what a body is — a trait wearing `@composes`; a component of fields and `fn`s holds none",
            ),
        )
}

fn two_composers(mut cx: TypeCx, s: StmtId, name: string, by: List<string>) {
    let _ = cx
        .spoken(
            refusal(
                body_kind,
                cx.view.stmt_loc(s),
                "one trait says what a component's body is, and here ${["`${t}`" for t in by].join(" and ")} both do",
                "`${name}` holds statements",
                null,
            ),
        )
}
