//! An instance's body written as a FN: `Name inst { req -> … }` — the seats it
//! takes, then the statements it runs. The node keeps both as written and
//! MEANS the closure over a block of those statements; a fn holds no settings.
use core.{expr_node, Expr, ExprId, TypeId, Reg, Param, StmtId, Minting, minting, NodeFacts}
use core.marks.{apart}
use features.{Meaning, MeanCx, ResolveCx, TypeCx, LowerCx, nothing}

@expr_node
@apart
export type InstanceFn = { seats: List<Param>, stmts: List<StmtId> }

impl NodeFacts for InstanceFn {
    fn says(written: string) -> string? { "" }
}

impl Meaning for InstanceFn {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId { cx.meant_type(e) }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg { cx.meant_reg(e) }
    fn minted(cx: MeanCx) -> Result<Minting, string> {
        if self.stmts.any((s) -> cx.store.setting_parts(s) != null) { return .Err(fn_body_setting()) }
        let before = cx.store.exprs.count()
        let closure = cx
            .store
            .alloc_expr(Expr.Lambda(self.seats, cx.store.block_over(self.stmts, cx.span)), cx.span)
        .Ok(minting(cx.store.allocated_since(before, closure)))
    }
}

// ── voices ──

fn fn_body_setting() -> string {
    "a body with parameters is a fn, and a fn holds no settings — write them in a body without a `name ->` head"
}
