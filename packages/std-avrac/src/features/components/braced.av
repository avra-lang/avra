//! `counter id { … } { … }` — a head's name takes ONE block, so a second is
//! the head law's refusal. The node keeps what was written and means
//! nothing: its meaning is the refusal, in the law's words.
use core.{expr_node, Expr, ExprId, TypeId, Reg, TypeRef, Minting, NodeFacts}
use core.marks.{apart}
use features.{Meaning, MeanCx, ResolveCx, TypeCx, LowerCx, nothing}

@expr_node
@apart
export type BracedHead = { word: string, targs: List<TypeRef> = [], head: string, body: ExprId, second: ExprId }

impl NodeFacts for BracedHead {
    fn says(written: string) -> string? { "" }
}

impl Meaning for BracedHead {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId { cx.error_type }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg { cx.foreign_node(e) }
    fn minted(cx: MeanCx) -> Result<Minting, string> {
        .Err("${braced_head(self.head)} — ${parenthesised_head(self.word, self.head)}")
    }
}
