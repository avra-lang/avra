//! Parse-time lowering. A declaration is its own node — a record the
//! structs semantics type, with methods. `component Name inst { … }`
//! is a `let` of the struct literal built from its `field = value`
//! lines. A value instance is its component's template COPIED where
//! it stands, the head and block in its holes, every copied node
//! wearing the provider's origin — so the expansion's nodes stand
//! right before the instance's, as a parsed child does.
use core.{Expr, Stmt, StmtId, ExprId, Nominal, Plain, Scoped, NodeStore, BodyView, HoleKind, Filled, copier}
use features.{LangNode, Builder, ComponentWord, Template, zip_defect}

fn build_component_decl(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let head = b.fields_zipped(b.tokens(1)?, b.type_refs(2)?, [], [])?
    let fields = b.fields_zipped(b.tokens(3)?, b.type_refs(4)?, b.exprs(5)?, [])?
    let fns = b.stmts(6)?
    if !fns.all(holds_a_member(b.store, it)) { return .Err(foreign_member()) }
    b.make_stmt(Stmt.ComponentDecl(Scoped(n.text), head, fields, fns))
}

/// A member a component may hold besides its fields: a `fn`, or a
/// recovery's hole.
fn holds_a_member(store: NodeStore, s: StmtId) -> bool {
    store.fn_parts(s) != null || store.hole_stmt(s) != null
}

fn build_component_inst(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let inst = b.token(1)?
    let ks = b.tokens(2)?
    let vs = b.exprs(3)?
    if ks.length != vs.length {
        return .Err(zip_defect)
    }
    let lit = b.store.alloc_expr(Expr.StructLit(Nominal(n.text), [Plain(k.text) for k in ks], vs), b.span)
    let s = b.store.alloc_stmt(Stmt.Let(Scoped(inst.text), null, lit), b.span)
    b.store.mark_component_inst(s)
    b.wrap_stmt(s)
}

/// `within ms(5) { … }` — the imported component's template, the head
/// and the block spliced into it.
fn build_component_value(mut b: Builder) -> Result<LangNode, string> {
    let w = b.token(0)?
    let head = b.expr(1)?
    let block = b.expr(2)?
    let word? = b.words.components.find(it.word == w.text) else { return .Err(unimported(w.text)) }
    let template = match word.form {
        .Template(t) -> t,
        .Refused(why) -> { return .Err(why) },
    }
    if template.head.length != 1 { return .Err(head_count(w.text, template.head.length)) }
    let expansion = b.store.instantiated(template, word, [head], block)
    b.make_expr(Expr.Component(w.text, [head], block, BodyView.Expanded(expansion)))
}

/// `within { … }` — a block with no head value before it.
fn build_component_headless(b: Builder) -> Result<LangNode, string> {
    .Err(headless((b.token(0)?).text))
}

/// `within ms(5)` — a head with no block after it.
fn build_component_blockless(b: Builder) -> Result<LangNode, string> {
    .Err(blockless((b.token(0)?).text))
}

impl NodeStore {
    /// A template copied in: each hole filled with the head value or
    /// the block its field names, every node it minted marked as the
    /// provider's.
    fn instantiated(template: Template, word: ComponentWord, heads: List<ExprId>, block: ExprId) -> ExprId {
        let since = self.marks()
        let fills = [field_value(template, read, heads, block) for read in template.reads]
        mut rb = copier(word.store, self, [(kind: HoleKind) -> self.filled(kind, id) for id in fills])
        let root = self.template_value(rb.stmts(template.stmts))
        self.note_copied(since, word.origin)
        root
    }

    /// What a copied template answers: its one expression, or its
    /// statements as a block.
    fn template_value(copied: List<StmtId>) -> ExprId {
        let lone: ExprId? = if copied.length == 1 { self.answer_of(copied[0]) } else { null }
        lone ?? self.branch_value(copied) ?? self.alloc_expr(Expr.Block(copied, null))
    }

    /// A user's node in the seat a hole stands in — as the expression
    /// it is, or as the one statement it makes.
    fn filled(kind: HoleKind, id: ExprId) -> Filled {
        match kind {
            .Expression -> Filled.Expr(id),
            .Statement -> Filled.Stmts([self.alloc_stmt(Stmt.ExprStmt(id), self.expr_span(id))]),
            .Name or .Binder or .Type or .Arm -> Filled.Unplaceable("a component's field is code — it fills an expression or a statement"),
        }
    }
}

/// The user's node a template hole reads: a head value by its field's
/// position, or the block.
fn field_value(template: Template, read: string, heads: List<ExprId>, block: ExprId) -> ExprId {
    let at = template.head.index_of(read)
    if at < 0 { block } else { heads[at] }
}

// ── voices ──

fn unimported(word: string) -> string {
    "the lexer opened an instance with `${word}`, which no import names as a component"
}

fn head_count(word: string, n: int) -> string {
    "`${word}` declares ${n} head fields, and its instance writes one value"
}

fn foreign_member() -> string {
    "a component holds its fields and its `fn`s, and nothing else"
}

fn blockless(word: string) -> string {
    "an instance of `${word}` writes its block after its head — `${word} value { … }`"
}

fn headless(word: string) -> string {
    "`${word}` writes its head value before its block — `${word} value { … }`"
}
