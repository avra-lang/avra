//! Parse-time lowering: a component declaration is the StructDecl
//! (structs give it meaning); an instantiation is a `let` of the
//! struct literal built from its `field = value` lines.
use core.{Expr, Stmt}
use features.{LangNode, Builder, fields_zipped, zip_defect}

fn build_component_decl(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let fs = b.tokens(1)?
    let ft = b.type_refs(2)?
    let fds = b.exprs(3)?
    let fields = fields_zipped(b, fs, ft, fds)?
    b.make_stmt(Stmt.StructDecl(n.text, [], fields))
}

fn build_component_inst(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let inst = b.token(1)?
    let ks = b.tokens(2)?
    let vs = b.exprs(3)?
    if ks.length != vs.length {
        return .Err(zip_defect())
    }
    let lit = b.store.alloc_expr(Expr.StructLit(n.text, [k.text for k in ks], vs), b.span)
    b.make_stmt(Stmt.Let(inst.text, null, lit))
}
