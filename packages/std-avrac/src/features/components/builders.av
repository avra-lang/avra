//! Parse-time lowering: a component declaration is the StructDecl
//! (structs give it meaning); an instantiation is a `let` of the
//! struct literal built from its `field = value` lines.
use core.{Expr, Stmt, Nominal, Plain, Scoped}
use features.{LangNode, Builder, zip_defect}

fn build_component_decl(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let fs = b.tokens(1)?
    let ft = b.type_refs(2)?
    let fds = b.exprs(3)?
    let fields = b.fields_zipped(fs, ft, fds, [])?
    let s = b.store.alloc_stmt(Stmt.StructDecl(Scoped(n.text), [], fields), b.span)
    b.store.mark_component_decl(s)
    b.wrap_stmt(s)
}

fn build_component_inst(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let inst = b.token(1)?
    let ks = b.tokens(2)?
    let vs = b.exprs(3)?
    if ks.length != vs.length {
        return .Err(zip_defect)
    }
    let lit = b.store.alloc_expr(Expr.StructLit(Nominal(n.text), [Plain(k.text) for k in ks], vs), b.span)
    let s = b.store.alloc_stmt(Stmt.Let(Scoped(inst.text), null, lit), b.span)
    b.store.mark_component_inst(s)
    b.wrap_stmt(s)
}
