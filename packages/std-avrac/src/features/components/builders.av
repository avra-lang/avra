//! Parse-time lowering. A declaration is its own node — a record the
//! structs semantics type, with methods. A template's instance is its
//! component's template COPIED where it stands, the head and block in
//! its holes, every copied node wearing the provider's origin; a
//! record's instance is its literal, the body's settings by name and
//! its other statements `collect`ed into its one `List` field.
use core.{
    FnSeat,
    ComponentWord,
    Record,
    Expr,
    Stmt,
    StmtId,
    ExprId,
    Plain,
    Scoped,
    BodyView,
    TypeRef,
    Param,
    Slots,
    Built,
    computed,
    sorted_by,
    same_stmt,
    plain_mark,
    flatten,
    some_list,
}
use features.{three_dots}

/// `component Name(head) { fields, events, body }` — the declaration, its
/// members in written order and its body folded into one quote.
@computed
fn component_decl_written(s: dyn Slots) -> Result<Built, string> {
    let store = s.arena()
    let held = s.stmts_of("body")?
    let made = [m for m in held if !store.holds_a_member(m)]
    if made.any((m) -> store.is_state_stmt(m)) { return .Err(untyped_state()) }
    if made.any((m) -> store.is_declaration(m)) { return .Err(foreign_member()) }
    if s.present_of("third")? { return .Err(three_dots()) }
    let members = sorted_by(
        (s.params_of("fields")?).concat(s.params_of("events")?),
        (x: Param, y: Param) -> store.param_id_span(x.id)?.lo ?? 0 < store.param_id_span(y.id)?.lo ?? 0,
    )
    let written = s.params_of("head")?
    let head = if members.any(it.state) { [propped_param(p) for p in written] } else { written }
    let decl = Stmt
        .ComponentDecl(
            Scoped(s.text_of("name")?),
            s.params_of("tparams")?,
            head,
            members,
            with_body(s, held, made),
            s.types_of("spreads")?,
        )
    .Ok(Built.Stmt(store.alloc_stmt(decl, s.built_at())))
}

/// A head param of a STATEFUL composition marked a prop: the signature makes
/// it a cell its parent writes at every paint where its type compares by value.
fn propped_param(p: Param) -> Param {
    if passed(p) { p } else { p with { prop: true } }
}

/// A member its parent fills by naming it: a projection mark, or an event.
/// Such a member is TOLD, so it is carried at each paint — a cell would make it
/// a place the component keeps, and a kept place is never a projection.
fn passed(p: Param) -> bool { !p.marks.is_empty() || p.says != null }

/// A component's members with its BODY — the statements `made` — folded
/// into one: a quote of them, standing where the first was written.
/// Nothing walks a body where it is written; what reads the declaration
/// splices it where it means something.
fn with_body(s: dyn Slots, held: List<StmtId>, made: List<StmtId>) -> List<StmtId> {
    let store = s.arena()
    let first? = made.first() else { return held }
    let from? = store.stmt_span(first) else { return held }
    let over = from.cover(store.stmt_span(made.last()!) ?? from)
    let q = store
        .alloc_expr(
            Expr
                .Body("quote", [s.source().substring(over.lo, over.hi)], [], BodyView.Verbatim(made, [])),
            over,
        )
    store.mark_quote_at(q)
    let body = store.alloc_stmt(Stmt.ExprStmt(q), over)
    [if same_stmt(m, first) { body } else { m } for m in held if same_stmt(m, first) || !made.any((x) -> same_stmt(x, m))]
}

/// `on name(seat: T, …)` — an event, as the member that holds its
/// handler: a nullable fn over the seats the event says, absent until
/// an instance hears it.
@computed
fn event_written(s: dyn Slots) -> Result<Built, string> {
    let store = s.arena()
    let at = s.at_of("name")?
    let says = s.params_of("says")?
    .Ok(
        Built
            .Seat(
                Param {
                    name: Scoped(s.text_of("name")?),
                    ty: TypeRef {
                        name: "fn",
                        applied: [],
                        seats: [FnSeat { ty: t } for t in flatten([some_list(p.ty) for p in says])],
                        optional: true,
                        dynamic: false,
                        arrow: true,
                        span: at,
                    },
                    default: store.alloc_expr(Expr.NullLit, at),
                    promises: plain_mark,
                    id: store.alloc_param_id(at),
                    marks: s.marks_of("marks")?,
                    says: says,
                },
            ),
    )
}

/// `list visible() by it.id { t -> item { … } }` — a KEYED list. The
/// `by` clause states the element accessor ONCE, and the body maps
/// each element to its child. It desugars to the body the explicit
/// form writes (`list { for t in visible() { item { … } } }`), with
/// the key spliced into the child — so the tree, and the frame, are
/// unchanged — and the instance marked with its key, the fact
/// `read_set`'s `SiteLowering.Keyed` reads.
@computed
fn keyed_written(s: dyn Slots) -> Result<Built, string> {
    let store = s.arena()
    let word = opened(s)?
    let clause = s.text_of("clause")?
    let pronoun = s.text_of("pronoun")?
    if clause != "by" { return .Err(keyed_clause(word.word, clause)) }
    if pronoun != "it" { return .Err(keyed_pronoun(word.word, pronoun)) }
    let body = s.expr_of("body")?
    let lam? = store.body_fn(body) else { return .Err(keyed_body(word.word)) }
    let parts? = store.lambda_parts(lam) else { return .Err(keyed_body(word.word)) }
    let seat? = parts.params.first() else { return .Err(keyed_binder(word.word)) }
    let subject = store.alloc_expr(Expr.Ident(Scoped(seat.name.of)), s.built_at())
    let key = store.alloc_expr(Expr.Prop(subject, Plain(s.text_of("field")?)), s.built_at())
    .Ok(
        Built
            .Expr(s.made_expr(Expr.Component(word.word, [], [s.expr_of("source")?], body, null, key))?),
    )
}

/// `counter id { … } { … }` — a head's name takes ONE block; a second
/// is the head law's refusal, in its words.
@computed
fn braced_head_written(s: dyn Slots) -> Result<Built, string> {
    let head = s.text_of("head")?
    .Err("${braced_head(head)} — ${parenthesised_head(s.text_of("word")?, head)}")
}

/// `table orders { … }` at a statement: a record without a head BINDS
/// the name, and fills its `name` field; any other component reads the
/// name as its head value. `secret stripe_key` is one with no block.
@computed
fn named_written(s: dyn Slots) -> Result<Built, string> {
    let word = opened(s)?
    match word.form {
        .Record(r) -> if r.head.is_empty() { bound(s, word) } else { headed(s, word) },
        .Template(_) or .Refused(_) or .Spoken or .Unread -> headed(s, word),
    }
}

/// The imported component the build's `word` opens.
fn opened(s: dyn Slots) -> Result<ComponentWord, string> {
    let w = s.text_of("word")?
    let word? = s.component_word(w) else { return .Err(unimported(w)) }
    .Ok(word)
}

/// A named instance whose component reads the name as its head value.
fn headed(s: dyn Slots, word: ComponentWord) -> Result<Built, string> {
    let store = s.arena()
    let at = s.at_of("name")?
    let name = store.alloc_expr(Expr.Ident(Scoped(s.text_of("name")?)), at)
    let inst = s
        .made_expr(
            Expr
                .Component(word.word, s.types_of("targs")?, [name], s.expr_opt_of("body")?, null, null),
        )?
    let stmt = store.alloc_stmt(Stmt.ExprStmt(inst), s.built_at())
    store.mark_instance_owner(inst, stmt)
    .Ok(Built.Stmt(stmt))
}

/// A headless record's named instance: `let n =` the instance, which
/// the printer spells back as it was written.
fn bound(s: dyn Slots, word: ComponentWord) -> Result<Built, string> {
    let store = s.arena()
    let name = Scoped(s.text_of("name")?)
    let value = s
        .made_expr(Expr.Component(word.word, s.types_of("targs")?, [], s.expr_opt_of("body")?, name, null))?
    let stmt = store.alloc_stmt(Stmt.Let(name, null, value), s.built_at())
    store.mark_component_inst(stmt, word.declared)
    store.mark_instance_owner(value, stmt)
    .Ok(Built.Stmt(stmt))
}

/// `on <event> { … }` — a handler written where the control is: the
/// body is a LAMBDA closing over its surroundings, and `on <event> { v
/// -> … }` names the seats the event says. The setting fills the
/// event's own member, which the instance's component declares.
/// `on` is a SOFT keyword, tagged by the lexer only where an event
/// follows it — never a reserved word.
@computed
fn on_handler_written(s: dyn Slots) -> Result<Built, string> {
    let store = s.arena()
    let event = s.text_of("event")?
    let lam = store
        .alloc_expr(
            Expr.Lambda(s.params_of("seats")?, store.block_over(s.stmts_of("stmts")?, s.built_at())),
            s.built_at(),
        )
    store.mark_on_handler(lam, event)
    .Ok(Built.Stmt(s.made_stmt(Stmt.Setting(Plain(event), lam))?))
}

// ── voices ──

fn unimported(word: string) -> string {
    "the lexer opened an instance with `${word}`, which no import names as a component"
}

fn keyed_clause(word: string, kw: string) -> string {
    "`${word}`'s keyed head is `by it.<field>` — this clause reads `${kw}`"
}

fn keyed_pronoun(word: string, iw: string) -> string {
    "a keyed `${word}` reads its key on `it` — `by it.<field>`, this reads `${iw}`"
}

fn keyed_body(word: string) -> string {
    "a keyed `${word}` writes its element body as `name -> …` — the binder its key reads"
}

fn keyed_binder(word: string) -> string {
    "a keyed `${word}`'s body binds its element — write `name -> …`"
}

fn head_count(word: string, n: int) -> string {
    "`${word}` declares ${n} head fields, and its instance writes one value"
}

/// A TEMPLATE's instance writing type arguments: a template copies its
/// code, so a written type has no seat — a RECORD component seats one.
fn template_targs(word: string) -> string {
    "a template's instance writes no type arguments — `${word}` copies code, where a written type has no seat; a RECORD component seats one"
}

fn foreign_member() -> string {
    "a component holds its fields, its `fn`s and what it is made of — never a declaration of its own"
}

fn untyped_state() -> string {
    "a component's `state` is a field, and a field says its type — `state n: int = 0`"
}

fn blockless(word: string) -> string {
    "an instance of `${word}` writes its block after its head — `${word} value { … }`"
}

fn headless(word: string) -> string {
    "`${word}` writes its head value before its block — `${word} value { … }`"
}

/// A template's block holding a setting. Under a head that is a bare
/// name, the block is what the author meant as a record literal's
/// fields — an instance's head keeps its brace — so the words write it.
fn template_setting(word: string, head: string?) -> string {
    let named? = head else { return "`${word}`'s block is code it runs — a `key: value` setting fills a record's field" }
    "`${word}`'s block is code it runs — ${braced_head(named)} — ${parenthesised_head(word, named)}"
}

/// THE HEAD LAW's words: an instance's head keeps its brace.
fn braced_head(named: string) -> string {
    "the brace after an instance's head opens the instance's block, so `${named} { … }` is no record literal here"
}

/// The form the head law's refusals write.
fn parenthesised_head(word: string, named: string) -> string {
    "a record literal as the head stands in parentheses: `${word} (${named} { … })`"
}

fn record_heads(word: string, declared: int, written: int) -> string {
    if declared == 0 { return "`${word}` takes no head value — name it at a statement (`${word} name { … }`), or write `${word} { … }`" }
    "`${word}` takes ${counted(declared, "head value")} before its block, and this instance writes ${written}"
}

fn counted(n: int, noun: string) -> string {
    if n == 1 { return "1 ${noun}" }
    "${n} ${noun}s"
}

fn no_slot(word: string) -> string {
    "`${word}` declares no `List` field, so its block holds settings only — `key: value`"
}

fn which_slot(word: string, open: List<string>) -> string {
    "`${word}` has ${open.length} `List` fields its statements could fill — set each by name: `${open[0]}: collect { … }`"
}

fn unplaceable_field() -> string {
    "a component's field is code — it fills an expression or a statement, and a `Format` field a type as well"
}

fn pattern_literal(word: string, field: string) -> string {
    "`${word}`'s `${field}` is a pattern — write it as a string literal"
}

fn unmarked_handler() -> string {
    "defect: an instance refused a handler the `on` sugar never marked — the builder and the store disagree"
}

fn record_fn_body(word: string) -> string {
    "`${word}` builds a record with no one fn field, so its body lists settings and children — a `name ->` head makes a fn, which fills a record's only fn field or a template's block"
}
