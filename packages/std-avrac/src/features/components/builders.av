//! Parse-time lowering. A declaration is its own node — a record the
//! structs semantics type, with methods. A template's instance is its
//! component's template COPIED where it stands, the head and block in
//! its holes, every copied node wearing the provider's origin; a
//! record's instance is its literal, the body's settings by name and
//! its other statements `collect`ed into its one `List` field.
use core.{
    ComponentWord,
    Template,
    Record,
    void_ref,
    Expr,
    Stmt,
    StmtId,
    ExprId,
    Plain,
    Scoped,
    SyntaxArena,
    BodyView,
    TypeRef,
    Param,
    sorted_by,
    same_stmt,
    plain_mark,
    flatten,
    some_list,
}
use features.{LangNode, Builder, marks_at, params_at, record_spreads, three_dots}
use grammar.{Token}

fn build_component_decl(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let tp = b.tokens(1)?
    if !(b.type_refs(2)?).is_empty() { return .Err(component_bound(b.type_refs(2)?)) }
    let held = b.stmts(6)?
    let made = [s for s in held if !holds_a_member(b.store, s)]
    if made.any((s) -> b.store.is_state_stmt(s)) { return .Err(untyped_state()) }
    if made.any((s) -> b.store.is_declaration(s)) { return .Err(foreign_member()) }
    let fns = b.with_body(held, made)
    if !(b.tokens(9)?).is_empty() { return .Err(three_dots()) }
    let members = sorted_by(
        params_at(b.args, 4).concat(params_at(b.args, 5)),
        (x: Param, y: Param) -> b.written_at(x) < b.written_at(y),
    )
    let records = record_spreads([b.written_at(m) for m in members], b.tokens(7)?, b.type_refs(8)?)?
    let head = if members.any(it.state) { [propped_param(p) for p in params_at(b.args, 3)] } else { params_at(b.args, 3) }
    let s = b
        .store
        .alloc_stmt(
            Stmt.ComponentDecl(Scoped(n.text), [Plain(t.text) for t in tp], head, members, fns),
            b.span,
        )
    if !records.is_empty() { b.store.spread_fields(s, records) }
    .Ok(LangNode.NStmt(s))
}

/// A head param of a STATEFUL composition marked a prop: the signature makes
/// it a cell its parent writes at every paint where its type compares by value.
fn propped_param(p: Param) -> Param {
    if passed(p) { p } else { p with { prop: true } }
}

/// A member its parent fills by naming it: a projection mark, or an event.
/// Such a member is TOLD, so it is carried at each paint — a cell would make it
/// a place the component keeps, and a kept place is never a projection.
fn passed(p: Param) -> bool { !p.marks.is_empty() || p.says != null }

/// `on name(seat: T, …)` — an event, as the member that holds its
/// handler: a nullable fn over the seats the event says, absent until
/// an instance hears it.
fn build_component_event(b: Builder) -> Result<LangNode, string> {
    let name = b.token(1)?
    let says = params_at(b.args, 2)
    .Ok(
        LangNode
            .NParam(
                Param {
                    name: Scoped(name.text),
                    ty: TypeRef {
                        name: "fn",
                        args: flatten([some_list(s.ty) for s in says]).concat([void_ref]),
                        optional: true,
                        dynamic: false,
                        arrow: true,
                        span: name.span,
                    },
                    default: b.store.alloc_expr(Expr.NullLit, name.span),
                    promises: plain_mark,
                    id: b.store.alloc_param_id(name.span),
                    marks: marks_at(b.args, 0),
                    says: says,
                },
            ),
    )
}

/// A member a component may hold besides its fields: a `fn`, or a
/// recovery's hole. Any other statement is part of its BODY — what it
/// is made of.
fn holds_a_member(store: SyntaxArena, s: StmtId) -> bool {
    store.fn_parts(s) != null || store.hole_stmt(s) != null
}

/// `list visible() by it.id { t -> item { … } }` — a KEYED list. The
/// `by` clause states the element accessor ONCE, and the body maps
/// each element to its child. It desugars to the body the explicit
/// form writes (`list { for t in visible() { item { … } } }`), with
/// the key spliced into the child — so the tree, and the frame, are
/// unchanged — and the instance marked with its key, the fact
/// `read_set`'s `SiteLowering.Keyed` reads.
fn build_component_keyed(b: Builder) -> Result<LangNode, string> {
    let word = b.word_at(0)?
    let source = b.expr(1)?
    let kw = b.token(2)?
    let iw = b.token(3)?
    let field = b.token(4)?
    let body = b.expr(5)?
    if kw.text != "by" { return .Err(keyed_clause(word.word, kw.text)) }
    if iw.text != "it" { return .Err(keyed_pronoun(word.word, iw.text)) }
    let parts? = b.store.lambda_parts(body) else { return .Err(keyed_body(word.word)) }
    let seat? = parts.params.first() else { return .Err(keyed_binder(word.word)) }
    let subject = b.store.alloc_expr(Expr.Ident(Scoped(seat.name.of)), b.span)
    let key = b.store.alloc_expr(Expr.Prop(subject, Plain(field.text)), b.span)
    b.make_expr(Expr.Component(word.word, [], [source], body, null, key))
}

/// `counter id { … } { … }` — a head's name takes ONE block; a second
/// is the head law's refusal, in its words.
fn build_component_braced_head(b: Builder) -> Result<LangNode, string> {
    let word = (b.token(0)?).text
    let head = (b.token(2)?).text
    .Err("${braced_head(head)} — ${parenthesised_head(word, head)}")
}

/// `table orders { … }` at a statement: a record without a head BINDS
/// the name, and fills its `name` field; any other component reads the
/// name as its head value.
fn build_component_named(b: Builder) -> Result<LangNode, string> {
    b.named(b.word_at(0)?, b.type_refs(1)?, b.token(2)?, b.expr(3)?)
}

/// `secret stripe_key` — a named instance with no block.
fn build_component_named_bare(b: Builder) -> Result<LangNode, string> {
    b.named(b.word_at(0)?, b.type_refs(1)?, b.token(2)?, null)
}

/// An instance's body: its settings and statements as written — the
/// block the printer spells — or, under a `req ->` head, a fn over
/// what the component offers.
fn build_instance_body(b: Builder) -> Result<LangNode, string> {
    let ps = params_at(b.args, 0)
    let stmts = b.stmts(1)?
    if ps.is_empty() { return b.make_expr(Expr.Block(stmts, null)) }
    if stmts.any((s) -> b.store.setting_parts(s) != null) { return .Err(fn_body_setting()) }
    b.make_expr(Expr.Lambda(ps, b.block_of(stmts)))
}

/// `on <event> { … }` — a handler written where the control is: the
/// body is a LAMBDA closing over its surroundings, and `on <event> { v
/// -> … }` names the seats the event says. The setting fills the
/// event's own member, which the instance's component declares.
/// `on` is a SOFT keyword, tagged by the lexer only where an event
/// follows it — never a reserved word.
fn build_on_handler(b: Builder) -> Result<LangNode, string> {
    let event = (b.token(1)?).text
    let stmts = b.stmts(3)?
    let lam = b.expr_node(Expr.Lambda(params_at(b.args, 2), b.block_of(stmts)))
    b.store.mark_on_handler(lam, event)
    b.make_stmt(Stmt.Setting(Plain(event), lam))
}

impl Builder {
    /// A component's members with its BODY — the statements `made` —
    /// folded into one: a quote of them, standing where the first was
    /// written. Nothing walks a body where it is written; what reads the
    /// declaration splices it where it means something.
    fn with_body(held: List<StmtId>, made: List<StmtId>) -> List<StmtId> {
        let first? = made.first() else { return held }
        let last? = made.last() else { return held }
        let from? = self.store.stmt_span(first) else { return held }
        let over = from.cover(self.store.stmt_span(last) ?? from)
        let q = self
            .store
            .alloc_expr(
                Expr
                    .Body(
                        "quote",
                        [self.text.substring(over.lo, over.hi)],
                        [],
                        BodyView.Verbatim(made, []),
                    ),
                over,
            )
        self.store.mark_quote_at(q)
        let body = self.store.alloc_stmt(Stmt.ExprStmt(q), over)
        [if same_stmt(s, first) { body } else { s } for s in held if same_stmt(s, first) || !made.any((m) -> same_stmt(m, s))]
    }

    /// The imported component the word at `args[i]` opens.
    fn word_at(i: int) -> Result<ComponentWord, string> {
        let w = self.token(i)?
        let word? = self.words.component(w.text) else { return .Err(unimported(w.text)) }
        .Ok(word)
    }

    fn named(word: ComponentWord, targs: List<TypeRef>, n: Token, body: ExprId?) -> Result<
        LangNode,
        string,
    > {
        match word.form {
            .Record(r) -> if r.head.is_empty() { self.bound(word, targs, n, body) } else { self.headed(word, targs, n, body) },
            .Template(_) or .Refused(_) or .Spoken or .Unread -> self.headed(word, targs, n, body),
        }
    }

    /// A named instance whose component reads the name as its head value.
    fn headed(word: ComponentWord, targs: List<TypeRef>, n: Token, body: ExprId?) -> Result<
        LangNode,
        string,
    > {
        let inst = Expr.Component(word.word, targs, [self.name_value(n)], body, null, null)
        self.wrap_expr_stmt(self.instance_node(inst)?)
    }

    /// The instance `e` names, its meaning minted beside it.
    fn instance_node(e: Expr) -> Result<ExprId, string> {
        let made = self.make_expr(e)?
        match made {
            .NExpr(id) -> .Ok(id),
            rest -> .Err("defect: an instance was built as something else"),
        }
    }

    /// A headless record's named instance: `let n =` the instance, which
    /// the printer spells back as it was written.
    fn bound(word: ComponentWord, targs: List<TypeRef>, n: Token, body: ExprId?) -> Result<
        LangNode,
        string,
    > {
        let value = self
            .instance_node(Expr.Component(word.word, targs, [], body, Scoped(n.text), null))?
        let s = self.store.alloc_stmt(Stmt.Let(Scoped(n.text), null, value), self.span)
        self.store.mark_component_inst(s, word.declared)
        self.store.mark_instance_owner(value, s)
        self.wrap_stmt(s)
    }

    fn wrap_expr_stmt(e: ExprId) -> Result<LangNode, string> {
        let s = self.store.alloc_stmt(Stmt.ExprStmt(e), self.span)
        self.store.mark_instance_owner(e, s)
        self.wrap_stmt(s)
    }

    /// A name standing where a head value goes — read as the value.
    fn name_value(n: Token) -> ExprId {
        self.store.alloc_expr(Expr.Ident(Scoped(n.text)), n.span)
    }
}

// ── voices ──

fn unimported(word: string) -> string {
    "the lexer opened an instance with `${word}`, which no import names as a component"
}

fn keyed_clause(word: string, kw: string) -> string {
    "`${word}`'s keyed head is `by it.<field>` — this clause reads `${kw}`"
}

fn keyed_pronoun(word: string, iw: string) -> string {
    "a keyed `${word}` reads its key on `it` — `by it.<field>`, this reads `${iw}`"
}

fn keyed_body(word: string) -> string {
    "a keyed `${word}` writes its element body as `name -> …` — the binder its key reads"
}

fn keyed_binder(word: string) -> string {
    "a keyed `${word}`'s body binds its element — write `name -> …`"
}

fn head_count(word: string, n: int) -> string {
    "`${word}` declares ${n} head fields, and its instance writes one value"
}

/// A TEMPLATE's instance writing type arguments: a template copies its
/// code, so a written type has no seat — a RECORD component seats one.
fn template_targs(word: string) -> string {
    "a template's instance writes no type arguments — `${word}` copies code, where a written type has no seat; a RECORD component seats one"
}

fn foreign_member() -> string {
    "a component holds its fields, its `fn`s and what it is made of — never a declaration of its own"
}

fn untyped_state() -> string {
    "a component's `state` is a field, and a field says its type — `state n: int = 0`"
}

/// A component's type parameters are names — no bound is landed on a
/// declaration's parameters, so one written here is refused with the
/// form that does take it.
fn component_bound(bounds: List<TypeRef>) -> string {
    "a component's type parameter takes no bound yet — `${bounds[0].name}` is written as one"
}

fn blockless(word: string) -> string {
    "an instance of `${word}` writes its block after its head — `${word} value { … }`"
}

fn headless(word: string) -> string {
    "`${word}` writes its head value before its block — `${word} value { … }`"
}

/// A template's block holding a setting. Under a head that is a bare
/// name, the block is what the author meant as a record literal's
/// fields — an instance's head keeps its brace — so the words write it.
fn template_setting(word: string, head: string?) -> string {
    let named? = head else { return "`${word}`'s block is code it runs — a `key: value` setting fills a record's field" }
    "`${word}`'s block is code it runs — ${braced_head(named)} — ${parenthesised_head(word, named)}"
}

/// THE HEAD LAW's words: an instance's head keeps its brace.
fn braced_head(named: string) -> string {
    "the brace after an instance's head opens the instance's block, so `${named} { … }` is no record literal here"
}

/// The form the head law's refusals write.
fn parenthesised_head(word: string, named: string) -> string {
    "a record literal as the head stands in parentheses: `${word} (${named} { … })`"
}

fn record_heads(word: string, declared: int, written: int) -> string {
    if declared == 0 { return "`${word}` takes no head value — name it at a statement (`${word} name { … }`), or write `${word} { … }`" }
    "`${word}` takes ${counted(declared, "head value")} before its block, and this instance writes ${written}"
}

fn counted(n: int, noun: string) -> string {
    if n == 1 { return "1 ${noun}" }
    "${n} ${noun}s"
}

fn no_slot(word: string) -> string {
    "`${word}` declares no `List` field, so its block holds settings only — `key: value`"
}

fn which_slot(word: string, open: List<string>) -> string {
    "`${word}` has ${open.length} `List` fields its statements could fill — set each by name: `${open[0]}: collect { … }`"
}

fn unplaceable_field() -> string {
    "a component's field is code — it fills an expression or a statement, and a `Format` field a type as well"
}

fn pattern_literal(word: string, field: string) -> string {
    "`${word}`'s `${field}` is a pattern — write it as a string literal"
}

fn fn_body_setting() -> string {
    "a body with parameters is a fn, and a fn holds no settings — write them in a body without a `name ->` head"
}

fn unmarked_handler() -> string {
    "defect: an instance refused a handler the `on` sugar never marked — the builder and the store disagree"
}

fn record_fn_body(word: string) -> string {
    "`${word}` builds a record with no one fn field, so its body lists settings and children — a `name ->` head makes a fn, which fills a record's only fn field or a template's block"
}
