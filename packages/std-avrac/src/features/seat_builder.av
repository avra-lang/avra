//! The builder of one parameter seat: a rule ending `-> Record.ParamSyntax`
//! labels the words and parts a seat writes, and the seat is made here,
//! its identity minted at its name.
use core.{Param, Scoped, SeatMark}
use features.{LangNode, Builder}

impl Builder {
    /// The seat a `ParamSyntax` rule wrote.
    fn seat() -> Result<LangNode, string> {
        let n = self.token(self.slot_of("name")?)?
        .Ok(
            LangNode
                .NParam(
                    Param {
                        name: Scoped(n.text),
                        ty: self.type_opt_of("ty")?,
                        default: self.expr_opt_of("default")?,
                        promises: SeatMark {
                            mutable: self.present_of("mutable")?,
                            settled: self.present_of("constant")?,
                            state: self.present_of("state")?,
                            unshared: self.present_of("unshared")?,
                        },
                        id: self.store.alloc_param_id(n.span),
                    },
                ),
        )
    }
}
