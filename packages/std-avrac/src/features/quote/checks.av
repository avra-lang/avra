//! The typing rule of a code-shape pattern: each hole binds the code at its seat, which typing
//! doesn't name yet.
use core.{Checking, PatChecks, PatId, SignedType, quote_pat_holes, quote_pat_names}
use core.pat.{Quote}

impl PatChecks for Quote {
    fn pat_checked(mut cx: Checking, p: PatId, subject: SignedType?) {
        for name in quote_pat_names(quote_pat_holes(cx.store, self.body)) { cx.bind(name, null) }
    }
}
