//! The quote's NodeSemantics — dispatch one-liners: a template is a
//! value, and its rule bodies live beside this file, by concern.
use core.{Expr, ExprId, TypeId, Reg, BodyParts}
use features.{NodeSemantics, TypeCx, LowerCx}

export type QuoteSemantics = { }

impl NodeSemantics for QuoteSemantics {
    fn kids(e: Expr) -> List<ExprId> {
        let q: BodyParts? = (e).body_of()
        q?.holes ?? []
    }

    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId { quote_type(cx, e) }

    fn lower(mut cx: LowerCx, e: ExprId) -> Reg { quote_reg(cx, e) }
}
