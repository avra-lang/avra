//! The quote's NodeSemantics and PatSemantics — dispatch one-liners:
//! a template is a value, a template is also a pattern, and both
//! rule bodies live beside this file, by concern.
use core.{Expr, ExprId, PatId, TypeId, Reg, BodyParts}
use features.{NodeSemantics, PatSemantics, TypeCx, LowerCx}

export type QuoteSemantics = {}

impl NodeSemantics for QuoteSemantics {
    fn kids(e: Expr) -> List<ExprId> {
        let q: BodyParts? = e.body_of()
        q?.holes ?? []
    }

}

export type QuotePatSemantics = {}

impl PatSemantics for QuotePatSemantics {
    fn pat_types(mut cx: TypeCx, p: PatId, expected: TypeId) -> List<TypeId> {
        // a feature cannot enumerate OTHER features' variants
        match cx.view.store.pat(p) {
            .Quote(body) -> quote_pat_types(cx, p, body, expected),
            rest -> [],
        }
    }

    fn pat_accepts(mut cx: LowerCx, p: PatId, v: Reg, vty: TypeId) -> Reg {
        // a feature cannot enumerate OTHER features' variants
        match cx.view.store.pat(p) {
            .Quote(body) -> quote_pat_accepts(cx, p, body, v, vty),
            rest -> reached_wrongly(cx),
        }
    }

    fn pat_binds(mut cx: LowerCx, p: PatId, v: Reg, vty: TypeId) -> List<Reg> {
        // a feature cannot enumerate OTHER features' variants
        match cx.view.store.pat(p) {
            .Quote(body) -> quote_pat_binds(cx, p, body, v, vty),
            rest -> {
                cx.defect("a pattern that is no quote reached the quote binds")
                []
            },
        }
    }
}

/// The seam routes every pattern to its owner, so this cannot
/// arrive; refusing is the honest answer if the seam ever breaks.
fn reached_wrongly(mut cx: LowerCx) -> Reg {
    cx.defect("a pattern that is no quote reached the quote test")
    cx.const_bool(false)
}
