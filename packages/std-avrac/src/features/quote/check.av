//! The hole law, by SEAT: a hole takes what its position takes, and
//! the quote answers the meta kind its body parsed as — both judged
//! HERE, in the file that wrote the template, with no user of it.
use core.{ExprId, TypeId, DeclId, StmtId, Type, QuoteParts, HoleKind, hole_kinds, quote_kind}
use features.{Decls}
use features.{TypeCx, this_is}
use diagnostics.{refusal, Diag}
use @std.errors.{Loc}

fn quote_type(mut cx: TypeCx, e: ExprId) -> TypeId {
    let held: QuoteParts? = (cx.view.store.expr(e)).quote_of()
    if held == null { return cx.error_type }
    let q = held!
    // a body that did not parse has spoken already
    if q.stmts.any((s: StmtId) -> cx.view.store.stmt(s) is .Error) { return cx.error_type }
    let kinds = hole_kinds(cx.view.store, q)
    let whole = quote_kind(cx.view.store, q)
    for k, h in q.holes {
        let kind = if whole is .Holes { seat_of(cx.view.decls, cx.type_at(h), cx.shape_at(h)) } else { kinds[k] }
        if !fills(cx, kind, h) { return cx.spoken(hole_refused(cx.loc_of(h), kind, cx.name_at(h), cx.shape_at(h) is .Str)) }
    }
    let answer: string = match whole {
        .Expr -> "Code",
        .Stmts -> "Stmts",
        .Arms -> "Arms",
        .Decls -> "Decls",
        .Holes -> filled_kind(cx, q.holes),
    }
    let d: DeclId? = cx.view.decls.meta_named(answer)
    if d == null { return cx.spoken(no_meta(cx.loc_of(e), answer)) }
    cx.view.decls.self_type_of(d!)
}

/// A quote of nothing but holes answers what fills it: arms when
/// any hole holds arms; one hole's own kind (a list of one kind is
/// that kind's plural, a scalar an expression); several holes are
/// declarations when every one is, statements otherwise.
fn filled_kind(cx: TypeCx, holes: List<ExprId>) -> string {
    let words = [kind_word(cx.view.decls, cx.type_at(h)) for h in holes]
    if words.any((w: string) -> w == "Arms") { return "Arms" }
    if holes.length == 1 { return single_kind(cx.view.decls, cx.type_at(holes[0])) }
    if words.all((w: string) -> w == "Decls") { "Decls" } else { "Stmts" }
}

fn single_kind(decls: Decls, ty: TypeId) -> string {
    let word = kind_word(decls, ty)
    if word == "" { return "Code" }
    if decls.elem_of(ty) != null && word == "Code" { return "Stmts" }
    word
}

/// The template kind a type names, itself or as a list's element —
/// "" for none.
fn kind_word(decls: Decls, ty: TypeId) -> string {
    let kinds = ["Code", "Stmts", "Arms", "Decls"]
    let own: string? = kinds.find((k: string) -> decls.meta_type(ty, k))
    if own != null { return own! }
    let elem: TypeId? = decls.elem_of(ty)
    if elem == null { return "" }
    kinds.find((k: string) -> decls.meta_type(elem!, k)) ?? ""
}

/// The seat a hole takes in a body of nothing but holes: arms as an
/// arm, a scalar or an expression template as an expression, the
/// rest as statements.
export fn seat_of(decls: Decls, ty: TypeId, shape: Type) -> HoleKind {
    match kind_word(decls, ty) {
        "Arms" -> HoleKind.Arm,
        "Code" -> if decls.elem_of(ty) == null { HoleKind.Expression } else { HoleKind.Statement },
        "Stmts" or "Decls" -> HoleKind.Statement,
        _ -> if shape is .Int || shape is .Bool || shape is .Str { HoleKind.Expression } else { HoleKind.Statement },
    }
}

/// WHAT A SEAT TAKES — a REGISTRY over the hole kinds: a new kind
/// must say what fills it.
fn fills(cx: TypeCx, kind: HoleKind, h: ExprId) -> bool {
    let ty = cx.type_at(h)
    let shape = cx.shape_at(h)
    match kind {
        .Expression -> is_meta(cx, ty, "Code") || shape is .Int || shape is .Bool,
        .Name or .Type -> names(cx, h),
        .Binder -> names(cx, h) || elem_is(cx, ty, (t: TypeId) -> cx.view.types.shape_of(t) is .Str),
        .Statement -> statement(cx, ty) || elem_is(cx, ty, (t: TypeId) -> statement(cx, t)),
        .Arm -> is_meta(cx, ty, "Arms") || elem_is(cx, ty, (t: TypeId) -> is_meta(cx, t, "Arms")),
    }
}

/// A name's fills: text, a number's digits, or a named meta value.
fn names(cx: TypeCx, h: ExprId) -> bool {
    let shape = cx.shape_at(h)
    shape is .Str || shape is .Int || cx.view.decls.meta_names_one(cx.type_at(h))
}

/// A statement seat takes any code but arms.
fn statement(cx: TypeCx, ty: TypeId) -> bool {
    is_meta(cx, ty, "Code") || is_meta(cx, ty, "Stmts") || is_meta(cx, ty, "Decls")
}

fn is_meta(cx: TypeCx, ty: TypeId, name: string) -> bool { cx.view.decls.meta_type(ty, name) }

fn elem_is(cx: TypeCx, ty: TypeId, pred: fn(TypeId) -> bool) -> bool {
    let elem: TypeId? = cx.view.decls.elem_of(ty)
    elem != null && pred(elem!)
}

// ── voices ──

fn no_meta(at: Loc?, answer: string) -> Diag {
    refusal("type.quote_meta", at, "a `quote` answers `@std.meta.${answer}`, and this program does not load `@std/meta`", "the quote", "add `\"@std/meta\"` to the package's dependencies")
}

fn hole_refused(at: Loc?, kind: HoleKind, n: string, text: bool) -> Diag {
    if text && kind is .Expression {
        return refusal("type.quote_hole", at, "a string in expression position is ambiguous — `literal(s)` spells a string literal, `name(s)` a name", "this hole", "say which: `\${literal(s)}` or `\${name(s)}`")
    }
    refusal("type.quote_hole", at, "a hole in ${seat_word(kind)} position takes ${takes_word(kind)}, found `${n}`", this_is(n), "fill the hole with what its seat takes")
}

fn seat_word(kind: HoleKind) -> string {
    match kind {
        .Expression -> "expression",
        .Name -> "name",
        .Binder -> "binder",
        .Type -> "type",
        .Statement -> "statement",
        .Arm -> "arm",
    }
}

fn takes_word(kind: HoleKind) -> string {
    match kind {
        .Expression -> "`Code`, an `int` or a `bool`",
        .Name -> "a `string`, an `int` or a named meta value",
        .Binder -> "a name, or a `List<string>` of them",
        .Type -> "a `Type`, a `Field`'s or a `string` spelling",
        .Statement -> "`Code`, `Stmts` or `Decls`, or a list of them",
        .Arm -> "`Arms` or a `List<Arms>`",
    }
}
