//! The hole law, by SEAT: a hole takes what its position takes
//! (`core/holes.av`'s `fits`, the one registry), and the quote answers
//! the meta kind its body parsed as — both judged HERE, in the file
//! that wrote the template, with no user of it.
use core.{
    CodeHandle,
    code_handles,
    ExprId,
    TypeId,
    PatId,
    DeclId,
    StmtId,
    Type,
    BodyParts,
    HoleKind,
    QuoteHole,
    MetaKind,
    FillClass,
    hole_kinds,
    quote_kind,
    fits,
    holes_kind,
    holes_seat,
    meta_name,
    quote_pat_holes,
    quote_pat_names,
    quote_pat_root,
    quote_pat_reached,
    quote_pat_is_text,
    quote_pat_mixed,
    quote_pat_is_run,
    quote_pat_run_mixed,
    quote_pat_is_type,
    quote_pat_adjacent_runs,
    is_run_kid,
    SyntaxArena,
}
use features.{TypeCx, Decls, this_is}
use diagnostics.{Voice, refusal, Diag, said_as}
use @std.errors.{Loc}

export fn quote_type(mut cx: TypeCx, e: ExprId) -> TypeId {
    let q? = cx.view.store.expr(e).body_of() else { return cx.error_type }
    // a body that did not parse has spoken already
    let stmts: List<StmtId> = match q.view { .Verbatim(ss, _) -> ss, rest -> [] }
    if stmts.any((s: StmtId) -> cx.view.store.stmt(s) is .Error) { return cx.error_type }
    // a hole whose own value refused has spoken already
    if q.holes.any((h: ExprId) -> cx.errored(h)) { return cx.error_type }
    let classes = [class_of(cx.view.decls, cx.type_at(h), cx.shape_at(h)) for h in q.holes]
    let whole = quote_kind(cx.view.store, e)
    let kinds = hole_kinds(cx.view.store, e)
    // a value no seat takes refuses in its seat's words where the
    // seat is known; a body of holes has no seat until its kind is
    for k, h in q.holes {
        if classes[k] == null {
            let at = cx.loc_of(h)
            let found = cx.name_at(h)
            return cx
                .spoken(
                    if whole is .Holes { unfillable(at, found) } else { hole_refused(at, kinds[k], found) },
                )
        }
    }
    let fills = [c! for c in classes]
    let rewrites = fills.any(fills_by_node(it))
    let answered: MetaKind? = match whole {
        .Expr -> if rewrites { MetaKind.Rewrite } else { expression_kind(cx, e) },
        .Stmts -> if rewrites { MetaKind.Rewrite } else { MetaKind.Stmts },
        .Arms -> MetaKind.Arms,
        .Decls -> MetaKind.Decls,
        .Holes -> holes_kind(fills),
    }
    if answered == null { return cx.spoken(mixed_holes(cx.loc_of(e))) }
    let answer = answered!
    for k, h in q.holes {
        let kind = if whole is .Holes { holes_seat(answer, q.holes.length) } else { kinds[k] }
        let class = fills[k]
        if class is .Text && (kind is .Expression || kind is .Tail) { return cx.spoken(ambiguous_text(cx.loc_of(h))) }
        if answer == MetaKind.Rewrite && !rewrite_takes(class) { return cx.spoken(rewrite_hole(cx.loc_of(h), cx.name_at(h))) }
        if !fits(class, kind) { return cx.spoken(hole_refused(cx.loc_of(h), kind, cx.name_at(h))) }
    }
    let d? = cx.view.decls.meta_named(meta_name(answer)) else { return cx.spoken(no_meta(cx.loc_of(e), meta_name(answer))) }
    cx.view.decls.self_type_of(d)
}

/// What an expression-only quote answers: `Code`, or `Stmts` where its
/// seat wants statements — an expression is a statement.
fn expression_kind(cx: TypeCx, e: ExprId) -> MetaKind {
    let wants? = cx.want_at(e) else { return MetaKind.Code }
    let kind? = template_kind(cx.view.decls, wants) else { return MetaKind.Code }
    match kind { .Stmts -> MetaKind.Stmts, rest -> MetaKind.Code }
}

/// Whether a fill splices a node of the tree being rewritten, which makes its quote a `Rewrite`.
fn fills_by_node(c: FillClass) -> bool {
    match c {
        .Id or .PatId or .Node or .Nodes -> true,
        .Template(_) or .Templates(_) or .Int or .Bool or .Text or .Texts or .Named or .Held or .Pattern -> false,
    }
}

/// Whether a rewrite's hole may hold this fill: a node of the tree, a run of them, or one name. A
/// number or a template would read as a node's index, and a run of names as a run of nodes.
export fn rewrite_takes(c: FillClass) -> bool {
    match c {
        .Id or .PatId or .Node or .Nodes or .Text or .Named -> true,
        .Template(_) or .Templates(_) or .Int or .Bool or .Texts or .Held or .Pattern -> false,
    }
}

/// The template kind a type names, when it does.
export fn template_kind(decls: Decls, ty: TypeId) -> MetaKind? {
    let kinds = [MetaKind.Code, MetaKind.Stmts, MetaKind.Arms, MetaKind.Decls, MetaKind.Rewrite]
    kinds.find((k: MetaKind) -> decls.meta_type(ty, meta_name(k)))
}

/// What a hole's value IS, as the seat law reads it — null for a
/// value no seat takes.
export fn class_of(decls: Decls, ty: TypeId, shape: Type) -> FillClass? {
    let own: MetaKind? = template_kind(decls, ty)
    if own != null { return FillClass.Template(own!) }
    if decls.avrac_type(ty, "TypedCode") { return FillClass.Node }
    if spliced_handle(decls, ty) != null || decls.meta_type(ty, "Subject") { return FillClass.Held }
    if decls.meta_type(ty, "Format") { return FillClass.Pattern }
    if decls.avrac_type(ty, "ExprId") { return FillClass.Id }
    if decls.avrac_type(ty, "PatId") { return FillClass.PatId }
    let elem: TypeId? = decls.elem_of(ty)
    if elem != null { return listed_class(decls, elem!) }
    if decls.meta_names_one(ty) { return FillClass.Named }
    match shape {
        .Str -> FillClass.Text,
        .Int -> FillClass.Int,
        .Bool -> FillClass.Bool,
        .Ptr or .Bytes or .Float or .List(_) or .Cell(_) or .Task(_) or .Tasks or .Struct(_, _) or .Enum(_, _) or .Res(_, _) or .App(_, _, _) or .TypeName(_, _) or .Var(_, _, _) or .Dyn(_, _) or .Fn(_, _, _) or .Opt(_) or .Null or .EmptyList or .Error or .Void or .Map(_, _) or .EmptyMap or .Union(_) or .Range -> null,
    }
}

/// What a list hole's value is, by its element's type: nodes, templates or texts — null for any
/// other element.
fn listed_class(decls: Decls, elem: TypeId) -> FillClass? {
    if decls.avrac_type(elem, "TypedCode") { return FillClass.Nodes }
    let inner: MetaKind? = template_kind(decls, elem)
    if inner != null { return FillClass.Templates(inner!) }
    if decls.types.shape_of(elem) is .Str { FillClass.Texts } else { null }
}

// ── voices ──

fn no_meta(at: Loc?, answer: string) -> Diag { said_as("type.quote_meta", at, metaless(answer)) }

/// A `quote`, which answers `@std/meta`'s `answer`, in a program that does not load `@std/meta`.
export fn metaless(answer: string) -> Voice {
    Voice {
        message: "a `quote` answers `@std.meta.${answer}`, and this program does not load `@std/meta`",
        label: "the quote",
        help: "add `\"@std/meta\"` to the package's dependencies",
    }
}

fn rewrite_hole(at: Loc?, found: string) -> Diag { said_as("type.quote_hole", at, hole_unnoded(found)) }

/// A rewrite's hole holding `found`, no node of the tree it rewrites nor one name.
export fn hole_unnoded(found: string) -> Voice {
    Voice {
        message: "a rewrite's holes are nodes of the tree it rewrites or one name — an `ExprId`, a `PatId`, a `TypedCode`, a `List<TypedCode>` or a `string` — and this one is `${found}`",
        label: "this hole",
        help: "a hole in a rewrite names the node it stands for — `\${self.value}`, an `ExprId` — or the one name it writes",
    }
}

fn ambiguous_text(at: Loc?) -> Diag { said_as("type.quote_hole", at, hole_ambiguous()) }

/// A string hole where an expression stands, which reads as a literal or a name.
export fn hole_ambiguous() -> Voice {
    Voice {
        message: "a string in expression position is ambiguous — `literal(s)` spells a string literal, `name(s)` a name",
        label: "this hole",
        help: "say which: `\${literal(s)}` or `\${name(s)}`",
    }
}

fn hole_refused(at: Loc?, kind: HoleKind, n: string) -> Diag {
    refusal(
        "type.quote_hole",
        at,
        "a hole in ${kind.position_word()} position takes ${kind.takes_word()}, found `${n}`",
        this_is(n),
        "fill the hole with what its seat takes",
    )
}

fn unfillable(at: Loc?, n: string) -> Diag { said_as("type.quote_hole", at, hole_unfillable(n)) }

/// A hole of a body of holes alone holding `n`, which fills nothing.
export fn hole_unfillable(n: string) -> Voice {
    Voice {
        message: "a hole takes a template, a number, a name, a list of names or of templates, found `${n}`",
        label: this_is(n),
        help: "splice a `quote { … }` of it, or its name",
    }
}

fn mixed_holes(at: Loc?) -> Diag { said_as("type.quote_hole", at, holes_mixed()) }

/// A body of holes alone whose fills disagree in kind.
export fn holes_mixed() -> Voice {
    Voice {
        message: "a quote of nothing but holes takes ONE kind — its first hole's — and these disagree",
        label: "the quote",
        help: "give every hole the first's kind, or write the body around them",
    }
}

// ── the quote AS A PATTERN — a DIFFERENT law: a hole BINDS instead
// of filling, so only a seat whose written text is a CHILD POSITION
// rather than a scalar folded into its owner's identity can be held
// open (core/quote_pat.av). Judged here too, never re-derived. ──

/// The body is one node, no arms; every hole stands at a seat this
/// matcher can hold open — an expression, a statement, or (2b) a
/// LONE name seat — judged FIRST, since a malformed pattern is a
/// defect whatever it is matched against. Then the subject: THIS
/// COMPILER'S OWN `Code` handle. Every binder answers `Code`, unless
/// every one of its occurrences is a name seat, which answers its
/// own written `string` instead — first-occurrence order, and one
/// binder used at seats of both kinds is refused before either type
/// is picked.
export fn quote_pat_types(mut cx: TypeCx, p: PatId, body: ExprId, expected: TypeId) -> List<TypeId> {
    let fault = quote_pat_fault(cx.view.store, body)
    if fault != null {
        cx.emit(said_as(fault_kind(fault!), cx.pat_loc(p), fault_voice(fault!)))
        return []
    }
    let holes = quote_pat_holes(cx.view.store, body)
    subject_types(cx, p, expected, holes, quote_pat_names(holes))
}

/// What makes a quote pattern no pattern this matcher holds, judged on its syntax alone, in order:
/// its shape, a run with nothing around it, two runs side by side, a hole at a seat no fill can be
/// held at, a hole holding no bare name, and a binder used at two kinds of seat. Absent for a sound
/// pattern.
export enum QuotePatFault {
    Shape
    BareRun
    AdjacentRuns
    Seat(kind: HoleKind)
    NotBare
    Mixed(name: string)
    RunMixed(name: string)
}

/// The first fault of the quote pattern over `body`; absent where it has none.
export fn quote_pat_fault(store: SyntaxArena, body: ExprId) -> QuotePatFault? {
    let root? = quote_pat_root(store, body) else { return QuotePatFault.Shape }
    let holes = quote_pat_holes(store, body)
    if is_run_kid(store, root, holes) { return QuotePatFault.BareRun }
    if quote_pat_adjacent_runs(store, root, holes) { return QuotePatFault.AdjacentRuns }
    let reached = quote_pat_reached(store, root)
    let bad = [k for k, h in holes if !reached.contains(k)].first()
    if bad != null { return QuotePatFault.Seat(holes[bad!].kind) }
    if holes.any(it.name == null) { return QuotePatFault.NotBare }
    let names = quote_pat_names(holes)
    let mixed = names.find(quote_pat_mixed(holes, it))
    if mixed != null { return QuotePatFault.Mixed(mixed!) }
    let run_mixed? = names.find(quote_pat_run_mixed(holes, it)) else { return null }
    QuotePatFault.RunMixed(run_mixed)
}

/// The kind a quote pattern's fault is refused as.
export fn fault_kind(f: QuotePatFault) -> string {
    match f {
        .Shape -> "type.quote_pat_shape",
        .BareRun or .AdjacentRuns -> "type.quote_pat_run",
        .Seat(kind) -> seat_fault_kind(kind),
        .NotBare -> "type.quote_pat_hole",
        .Mixed(_) or .RunMixed(_) -> "type.quote_pat_mixed",
    }
}

/// The kind a hole at an unheld seat of `kind` is refused as.
fn seat_fault_kind(kind: HoleKind) -> string {
    match kind {
        .Type -> "type.quote_pat_type",
        .Arm or .Fields or .Inits or .Name or .Binder -> "type.quote_pat_seat",
        .Expression or .Statement or .Run or .Tail -> "type.quote_pat_hole",
    }
}

/// How a quote pattern's fault is worded.
export fn fault_voice(f: QuotePatFault) -> Voice {
    match f {
        .Shape -> shape_voice(),
        .BareRun -> bare_run_voice(),
        .AdjacentRuns -> adjacent_runs_voice(),
        .Seat(kind) -> seat_voice(kind),
        .NotBare -> not_bare_voice(),
        .Mixed(n) -> mixed_voice(n),
        .RunMixed(n) -> run_mixed_voice(n),
    }
}

/// A hole at an unheld seat of `kind`, in its seat's words.
fn seat_voice(kind: HoleKind) -> Voice {
    match kind {
        .Type -> unheld_type_voice(),
        .Arm or .Fields or .Inits -> unheld_seat_voice(kind),
        .Name or .Binder -> unheld_name_voice(),
        .Expression or .Statement or .Run or .Tail -> not_bare_voice(),
    }
}

fn subject_types(
    mut cx: TypeCx,
    p: PatId,
    expected: TypeId,
    holes: List<QuoteHole>,
    names: List<string>,
) -> List<TypeId> {
    if cx.view.decls.meta_type(expected, "Subject") ||
        cx.view.decls.avrac_type(expected, "TypedCode") {
        return subject_binders(cx, p, expected, holes, names)
    }
    if !code_handles().any((h) -> avrac_answer(cx, h.runs) != null) { return no_avrac(cx, p) }
    let handle? = spliced_handle(cx.view.decls, expected) else { return wrong_subject(cx, p, cx.view.types.name_of(expected)) }
    let run_ty? = avrac_answer(cx, handle.runs) else { return no_avrac(cx, p) }
    let code_ty = expected
    let own_ty? = avrac_answer(cx, "own_type_at") else { return no_avrac(cx, p) }
    let type_ty? = present_of(cx, own_ty) else { return no_avrac(cx, p) }
    let string_ty = cx.type(string)
    [binder_type(holes, n, string_ty, run_ty, type_ty, code_ty) for n in names]
}

/// A subject that is no rule's `Code`: `dyn Subject` — a package's rule,
/// where no compiler handle is in hand — or a meaning's `TypedCode`. A
/// code binder answers the subject, a run a list of it, and a name its
/// text. A type binder reads the compiler's own `TypeRef`, which neither
/// holds.
fn subject_binders(
    mut cx: TypeCx,
    p: PatId,
    subject: TypeId,
    holes: List<QuoteHole>,
    names: List<string>,
) -> List<TypeId> {
    if names.any((n) -> quote_pat_is_type(holes, n)) { return typed_in_package(cx, p) }
    let string_ty = cx.type(string)
    [binder_type(holes, n, string_ty, cx.type(List<subject>), subject, subject) for n in names]
}

/// The handle a type is that a held hole splices as its text, absent for any other type.
export fn spliced_handle(decls: Decls, ty: TypeId) -> CodeHandle? { code_handles().find((h) -> h.splices != null && decls.avrac_type(ty, h.handle)) }

/// A `@std/avrac` verb's declared answer — how a quote pattern
/// reaches `Code` (`run_coded`'s `List<Code>`) and `TypeRef`
/// (`own_type_at`'s `TypeRef?`) by declaration, never by name.
fn avrac_answer(cx: TypeCx, verb: string) -> TypeId? {
    let d? = cx.view.decls.avrac_named(verb) else { return null }
    cx.view.decls.sig(d)?.fn_sig()?.ret
}

/// A nullable's present type, or null for any other shape.
fn present_of(cx: TypeCx, ty: TypeId) -> TypeId? {
    match cx.view.types.shape_of(ty) { .Opt(t) -> t, _ -> null }
}

/// One binder's answer: its own written text, a `List<Code>` for a
/// run, its own written `TypeRef`, or `Code` — the four shapes a
/// quote pattern's binder wears.
fn binder_type(
    holes: List<QuoteHole>,
    n: string,
    string_ty: TypeId,
    run_ty: TypeId,
    type_ty: TypeId,
    code_ty: TypeId,
) -> TypeId {
    if quote_pat_is_text(holes, n) { return string_ty }
    if quote_pat_is_run(holes, n) { return run_ty }
    if quote_pat_is_type(holes, n) { return type_ty }
    code_ty
}

// ── voices, the pattern's own ──

fn no_avrac(mut cx: TypeCx, p: PatId) -> List<TypeId> {
    cx.emit(said_as("type.quote_pat_subj", cx.pat_loc(p), avracless_pattern()))
    []
}

/// A quote pattern in a program that loads no `@std/avrac`, whose handle it reads.
export fn avracless_pattern() -> Voice {
    Voice {
        message: "a `quote` pattern reads code — this program does not load `@std/avrac`",
        label: "this pattern",
        help: "the handle arrives with `@std/avrac`",
    }
}

fn typed_in_package(mut cx: TypeCx, p: PatId) -> List<TypeId> {
    cx
        .emit(
            refusal(
                "type.quote_pat_subj",
                cx.pat_loc(p),
                "a type hole reads the compiler's own written type, and a rule over a `Subject` holds none",
                "this pattern",
                "match the code around the type, or write the rule beside the compiler",
            ),
        )
    []
}

fn wrong_subject(mut cx: TypeCx, p: PatId, found: string) -> List<TypeId> {
    cx
        .emit(
            refusal(
                "type.quote_pat_subj",
                cx.pat_loc(p),
                "a `quote` pattern reads code — a `Code`, found `${found}`",
                this_is(found),
                "match over a `Code` — the handle a rule holds",
            ),
        )
    []
}

fn shape_voice() -> Voice {
    Voice {
        message: "a `quote` pattern matches one node — one statement, no arms",
        label: "this pattern",
        help: "write one pattern per node; a run of several arrives with `\${..}` holes",
    }
}

fn unheld_type_voice() -> Voice {
    Voice {
        message: "a hole in type position binds only a lone `\${T}` — at a `let`/`mut`/`const` annotation, a call's one pinned type argument, or a param's own type",
        label: "this pattern",
        help: "write `\${T}` alone at one of those seats, or write the type out",
    }
}

fn unheld_seat_voice(kind: HoleKind) -> Voice {
    Voice {
        message: "a hole in ${kind.position_word()} position binds nothing yet — this matcher has no position for one",
        label: "this pattern",
        help: "write it out whole — a hole cannot bind this position yet",
    }
}

fn unheld_name_voice() -> Voice {
    Voice {
        message: "a hole in name position binds only a lone `\${x}` — at a let/for/const binder, a bind pattern, a variant test, a callee, a method or a field name",
        label: "this pattern",
        help: "write `\${x}` alone at one of those seats, or write the name out",
    }
}

fn mixed_voice(n: string) -> Voice {
    Voice {
        message: "`${n}` binds code once and a name once — one binder answers one type",
        label: "this pattern",
        help: "give it a code seat everywhere, or a name seat everywhere",
    }
}

fn run_mixed_voice(n: string) -> Voice {
    Voice {
        message: "`${n}` binds a run once and one node once — one binder answers one shape",
        label: "this pattern",
        help: "write `\${..${n}}` everywhere, or `\${${n}}` everywhere",
    }
}

fn adjacent_runs_voice() -> Voice {
    Voice {
        message: "two run holes with nothing between them — no scan can split them",
        label: "this pattern",
        help: "put a fixed node between them, or merge them into one run",
    }
}

fn bare_run_voice() -> Voice {
    Voice {
        message: "a run hole binds a span among siblings — this pattern is nothing but the run, with no node around it to hold one",
        label: "this pattern",
        help: "write a run inside a call's arguments, a list literal's elements, or a block's statements",
    }
}

fn not_bare_voice() -> Voice {
    Voice {
        message: "a hole in a pattern names a fresh variable — write a bare name",
        label: "this pattern",
        help: "`\${x}` binds `x`; a written expression has nothing to bind it to",
    }
}
