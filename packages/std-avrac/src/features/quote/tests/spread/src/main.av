// proves: a spread of fields in a type and in a record literal, spliced
// in order with their defaults, in both engines
use @std.meta.{derive}
use @test.spread.{Spread}

@derive(Spread)
type P = { x: int, y: int }

let c = PCopy { x: 1, y: 2 }
let a = PAround { first: 1 }
let d = P { x: 3, y: 4 }.doubled()
"${c.x}${c.y} ${a.first}${a.x}${a.y}${a.last} ${d.x}${d.y}"
