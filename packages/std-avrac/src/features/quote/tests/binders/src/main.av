// proves: EVERY SCOPE-KEYING NAME travels through a hole. A template
// binds `let`, `mut`, `const`, a range loop, a paired loop, a lambda
// seat, a comprehension, a present-bind arm, a `let … else`, a
// payload pattern, a method's own name and a free fn's — each through
// a hole — and reads each one back through a hole of the same name.
// A copier that carried any of them as a PLAIN name would leave the
// binder unfilled and the read undefined.
use @std.meta.{derive}
use @test.attacks.{Binders}

@derive(Binders)
type P = { a: int }

"${P { a: 1 }.binders()}"
