// proves: `quote { … }` is a template parsed here — its body is
// Avra, so braces, quotes and newlines inside need no escaping —
// `${e}` is a hole typed by its seat (a type's name, an expression),
// the value is the kind the body parsed as, and `text()` answers the
// source with the holes filled
use @std.meta.{Decls}
let n = 7
let name = "Point"
let code: Decls = quote { impl ${name} { fn get() -> int { ${n} } } }
code.text()
