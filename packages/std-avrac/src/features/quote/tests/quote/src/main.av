// proves: `quote { … }` is generated source as a `Code` value —
// braces, quotes and newlines inside need no escaping — `${e}`
// splices a value, and `text()` answers the source
use @std.meta.{Code}
let n = 7
let name = "Point"
let code: Code = quote { impl ${name} { fn get() -> int { ${n} } } }
code.text()
