// proves: a seat whose name came through a hole binds where the code
// lands, so a holed read in the body finds it — a spread fn seat, a
// row rebuilt from spread seats, and a lambda param — in both engines
use @std.meta.{derive}
use @test.reads.{Reads}

@derive(Reads)
type P = { a: int, b: int }

"${P.tens(2, 3)} ${P.made(4, 5).b} ${P.doubled(21)}"
