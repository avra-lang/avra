// proves: a quote of nothing but holes is the identity on what
// fills it — of every kind, one hole or two, an empty body included
use @std.meta.{Code, Stmts, Arms, Decls}
let e: Stmts = quote { }
let one: Code = quote { 1 }
let ident: Code = quote { ${one} }
let two: Stmts = quote { ${one}
${one} }
let d: Decls = quote { fn f() -> int { 1 } }
let dd: Decls = quote { ${d} }
let a: Arms = quote { .A -> 1 }
let aa: Arms = quote { ${a} }
"[${e.text()}][${one.text()}][${ident.text()}][${two.text()}][${d.text()}][${dd.text()}][${a.text()}][${aa.text()}]"
