// proves: the copier carries every node shape a template body can
// hold — loops, comprehensions, lambdas, match, if, `it`, a trailing
// block, a nullable, a mut cell, an interpolation with a hole in its
// hole — and the template's private helper resolves in its own file
use @std.meta.{derive}
use @test.attacks.{Kitchen}
@derive(Kitchen)
type P = { a: int, b: string }
P { a: 1, b: "x" }.kitchen()
