//! The red team's templates: every node shape the copier must
//! carry, and the seats a derive fills.
use @std.meta.{Type, Fn, Variant, Directive, Code, Decls, Arms, Stmts, name, literal}

/// A template exercising many node shapes at once.
export trait Kitchen {
    static fn derive(t: Type) -> List<Directive> {
        let n = t.fields.length
        let body = quote {
            impl ${t} {
                fn kitchen() -> string {
                    let xs = [${n}, 2, 3]
                    mut total = 0
                    for x in xs { total = total + x }
                    let doubled = [x * 2 for x in xs if x > 1]
                    let k = if total > 3 { "big" } else { "small" }
                    let m = match xs.length { 3 if total > 100 -> "huge", 3 -> "three", _ -> "other" }
                    let f = (a: int) -> a + total
                    let opt: int? = null
                    let o = opt ?? 7
                    mut i = 0
                    while i < 2 { i = i + 1 }
                    let l = xs.any(it > 2)
                    let s = xs.find { it > 1 } ?? 0
                    let g = helper(total)
                    "${k}-${m}-${f(1)}-${o}-${i}-${l}-${s}-${doubled.length}-${g}-${${n}}"
                }
            }
        }
        [Directive { twin: "", name: t.name, at: t.at, source: body }]
    }
}

/// Private — reached from the template by its bare name.
fn helper(x: int) -> int { x * 10 }

/// `@run_with(quote { … })` on `fn f` generates `f_run`, splicing the
/// user's STATEMENTS before a tail of its own.
export fn run_with(f: Fn, stmts: Stmts) -> List<Directive> {
    [Directive { twin: "", name: f.name, at: f.at, source: quote {
        fn ${f}_run() -> int {
            let acc = 100
            ${stmts}
            acc + ${f}()
        }
    } }]
}

/// Two impls from one directive — a `Many` of declarations.
export trait Twice {
    static fn derive(t: Type) -> List<Directive> {
        let parts: List<Decls> = [quote { impl ${t} { fn one() -> int { 1 } } }, quote { impl ${t} { fn two() -> int { 2 } } }]
        [Directive { twin: "", name: t.name, at: t.at, source: quote { ${parts} } }]
    }
}

/// An enum's arms with `or` alternatives, a wildcard and a payload.
export trait Armed {
    static fn derive(t: Type) -> List<Directive> {
        let arms = [arm_of(v) for v in t.variants]
        [Directive { twin: "", name: t.name, at: t.at, source: quote {
            impl ${t} {
                fn tag() -> string { match self { ${arms} } }
            }
        } }]
    }
}

fn arm_of(v: Variant) -> Arms {
    if v.payload.is_empty() { return quote { .${v} -> ${literal(v.name)} } }
    let ps = ["p${i}" for i in 0..v.payload.length]
    let first = name(ps[0])
    quote { .${v}(${ps}) -> "${${literal(v.name)}}:${${first}}" }
}

/// A generated fn that itself answers a template.
export trait Nested {
    static fn derive(t: Type) -> List<Directive> {
        [Directive { twin: "", name: t.name, at: t.at, source: quote {
            impl ${t} {
                fn q() -> Code { quote { 1 + 1 } }
            }
        } }]
    }
}

/// A template holding a quote WITH A HOLE OF ITS OWN: the inner
/// body's placeholder belongs to the inner quote, and a copier that
/// read it as one of THIS template's holes would fill it with the
/// wrong thing.
export trait NestedHoled {
    static fn derive(t: Type) -> List<Directive> {
        [Directive { twin: "", name: t.name, at: t.at, source: quote {
            impl ${t} {
                fn holed_q(n: int) -> Code { quote { ${name("inner")} + ${n} } }
            }
        } }]
    }
}

/// A template that DECLARES a name and READS it.
export trait SelfRead {
    static fn derive(t: Type) -> List<Directive> {
        [Directive { twin: "", name: t.name, at: t.at, source: quote {
            fn ${t}_base() -> int { 40 }
            impl ${t} {
                fn read() -> int { ${t}_base() + 2 }
            }
        } }]
    }
}

/// A template that DECLARES a name of its own and READS it.
export trait SelfReadPlain {
    static fn derive(t: Type) -> List<Directive> {
        [Directive { twin: "", name: t.name, at: t.at, source: quote {
            fn plain_base() -> int { 40 }
            impl ${t} {
                fn read() -> int { plain_base() + 2 }
            }
        } }]
    }
}

/// Names built from holes: two holes in one name, a hole between
/// runs, a number in a name, and a hole-named binder read by a hole.
export trait Names {
    static fn derive(t: Type) -> List<Directive> {
        let tail = t.fields.length
        let mid = "mid"
        let v = "v"
        [Directive { twin: "", name: t.name, at: t.at, source: quote {
            impl ${t} {
                fn ${t}${mid}() -> int { 1 }
                fn pre${mid}${tail}post() -> int {
                    let ${v}${tail} = 40
                    ${name("v${tail}")} + 2
                }
            }
        } }]
    }
}

/// What a payload pattern needs, declared HERE: a template's names
/// resolve in the file that wrote the quote.
export enum Held { One(v: int) Two }

/// A failing answer the template catches — declared HERE, with the
/// enum, because a template's names resolve where it was written.
export fn sad() -> Result<int, Bad> { fail Bad.Sad("nope") }

/// A failure a `catch` selects by variant — the only payload pair
/// where a PLAIN run and a SCOPED run sit side by side.
export enum Bad { Sad(why: string) }

/// THE BINDER SWEEP: every name payload the node model marks as
/// SCOPE-KEYING, bound through a hole and read through a hole. A
/// copier that carried one of these as a PLAIN name would leave the
/// binder unfilled and the read undefined, or fill one and not the
/// other.
export trait Binders {
    static fn derive(t: Type) -> List<Directive> {
        let q = "q"
        [Directive { twin: "", name: t.name, at: t.at, source: quote {
            fn ${q}free() -> int { 100 }

            impl ${t} {
                fn binders() -> int {
                    let ${q}let = 1
                    mut ${q}mut = 2
                    ${q}mut = ${q}mut + ${name("${q}let")}
                    const ${q}const = 4
                    mut total = ${name("${q}mut")} + ${name("${q}const")}
                    for ${q}range in 0..3 { total = total + ${name("${q}range")} }
                    for ${q}at, ${q}elem in [10, 20] { total = total + ${name("${q}at")} + ${name("${q}elem")} }
                    let ${q}lam = (${q}seat: int) -> ${name("${q}seat")} * 10
                    total = total + ${q}lam(3)
                    total = total + [${name("${q}comp")} for ${q}comp in [1, 2, 3]].length
                    let held: int? = 7
                    total = total + match held {
                        null -> 0
                        ${q}bind? -> ${name("${q}bind")}
                    }
                    let ${q}else? = held else { return 0 - 1 }
                    total = total + ${name("${q}else")}
                    total = total + match Held.One(5) { .One(${q}pat) -> ${name("${q}pat")}, .Two -> 0 }
                    let ${q}sel = sad() catch .Sad(${q}why) -> ${name("${q}why")}.length
                    let ${q}all = sad() catch ${q}any -> 0
                    total + ${name("${q}sel")} + ${name("${q}all")} + self.${q}method() + ${q}free()
                }

                fn ${q}method() -> int { 1000 }
            }
        } }]
    }
}
