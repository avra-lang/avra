// proves: an arms template with `or`-free variant arms, a payload
// binder list expanding to three binders, and a string hole whose
// hole is itself a template hole
use @std.meta.{derive}
use @test.attacks.{Armed}
@derive(Armed)
enum Color { Red, Green, Rgb(int, int, int) }
"${Color.Red.tag()} ${Color.Rgb(7, 8, 9).tag()}"
