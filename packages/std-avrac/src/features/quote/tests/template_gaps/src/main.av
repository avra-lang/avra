// proves: a trailing `List<Stmts>` hole is a block's statements (a void
// fn, and an answering tail), an int splices into an arm as a LITERAL
// pattern, `..${run}` spreads a list into a call's arguments and a
// variant's payload, and an expression-only quote adopts a `Stmts` want
use @std.meta.{derive}
use @test.gaps.{Gaps, Built}

@derive(Gaps)
type T = { x: int }

@derive(Built)
enum E {
    Both(int, int)
}

let out = Cell.new(1)
let t = T { x: 0 }
t.run(out)
let made = match E.made() { .Both(a, b) -> a * 10 + b }
"${out.get()} ${t.pick()} ${t.tagged(2)} ${t.tagged(9)} ${t.summed()} ${t.lone()} ${made}"
