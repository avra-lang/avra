// proves: two hundred templates in one hole, spliced twice, cross and
// print clean (run natively under AVRA_RC_GUARD=1 to see the counting)
use @std.meta.{Code, Stmts}
let ones: List<Code> = [quote { ${i} } for i in 0..200]
let all: Stmts = quote { ${ones} }
let again: Stmts = quote { ${all}
${all} }
"${all.text().length} ${again.text().length}"
