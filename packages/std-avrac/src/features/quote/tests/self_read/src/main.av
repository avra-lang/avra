// proves: a template's reads see the declarations its own template
// wrote — a hole-named fn and a template-named fn alike
use @std.meta.{derive}
use @test.attacks.{SelfRead, SelfReadPlain}
@derive(SelfRead)
type P = { a: int }
@derive(SelfReadPlain)
type Q = { a: int }
"${P { a: 1 }.read()} ${Q { a: 1 }.read()}"
