// A `Rewrite` is a quote whose holes are arena ids: what a sugar
// means, written once as the template it expands to.
use @std.avrac.core.{ExprId, PatId}
use @std.meta.{Rewrite}
use @std.avrac.compiler.{Program}
use @std.avrac.testing.{refused_n, vendored_meta, vendored_meta_paths, test_workspace}
use @std.avrac.compiler.host.{memory_host}

/// `~v`, as the rewrite it means.
fn inverted(v: ExprId) -> Rewrite {
    quote { ${v} ^ -1 }
}

/// A body of one hole.
fn itself(v: ExprId) -> Rewrite {
    quote { ${v} }
}

spec "features/quote — a rewrite" {
    given "a quote whose hole is an `ExprId`" {
        then "it answers a Rewrite, the id read as its index" {
            inverted(ExprId { index: 7 }).text().trim() == "7 ^ -1"
        }
        then "a body of one hole is a Rewrite too" {
            itself(ExprId { index: 3 }).text().trim() == "3"
        }
    }
}

/// A program that names `ExprId` the way the compiler's own source
/// does: from a package called `@std/avrac`.
fn rewriting(body: string) -> Program {
    let files = vendored_meta(
        {
            "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@std/meta\" = { path = \"vendor/meta\" }\n\"@std/avrac\" = { path = \"vendor/avrac\" }\n",
            "/w/src/main.av": "use @std.meta.{Rewrite}\nuse @std.avrac.{ExprId}\nfn f(v: ExprId, n: int) -> Rewrite {\n    ${body}\n}\n1",
            "/w/vendor/avrac/avra.toml": "[package]\nname = \"@std/avrac\"\nversion = \"0.1.0\"\n",
            "/w/vendor/avrac/src/avrac.av": "export type ExprId = { index: int }\n",
        },
    )
    let paths = [
        "/w/avra.toml",
        "/w/src/main.av",
        "/w/vendor/avrac/avra.toml",
        "/w/vendor/avrac/src/avrac.av",
    ]
    test_workspace(memory_host(files, paths.concat(vendored_meta_paths())), "/w")
        .program("/w/src/main.av")
}

spec "features/quote — a rewrite's holes" {
    given "a hole that is no arena id" {
        then "the rewrite refuses it in its own words" {
            refused_n(
                rewriting("quote { \${v} ^ \${n} }"),
                "a rewrite's holes are arena ids — `ExprId` or `PatId`, as `\${self.value}` — and this one is `int`",
                1,
            )
        }
    }
}

/// A match whose arm head is a hole: a pattern id.
fn arm_over(v: ExprId, p: PatId) -> Rewrite {
    quote { match ${v} { ${p} -> 1, _ -> 0 } }
}

spec "features/quote — a rewrite's pattern hole" {
    given "a quote whose hole is a `PatId`" {
        then "it answers a Rewrite, the id read as its index" {
            let shown = arm_over(ExprId { index: 4 }, PatId { index: 9 }).text()
            shown.contains("match 4") && shown.contains("9 ->")
        }
    }
}
