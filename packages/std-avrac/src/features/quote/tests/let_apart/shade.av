use @std.meta.{Type, Directive, beside, name}

/// A derive whose template's own `let` binds `x`, beside a hole that names the field `x`.
export trait Shaded {
    static fn derive(t: Type) -> List<Directive> {
        let field = t.fields[0].name
        [
            beside(
                t,
                quote {
                    impl ${t} {
                        fn picked(${field}: int) -> int {
                            let x = 1
                            ${name(field)} * 10 + x
                        }
                    }
                },
            ),
        ]
    }
}
