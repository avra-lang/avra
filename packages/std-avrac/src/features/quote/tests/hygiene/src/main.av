// proves ORIGIN HYGIENE: a template's own names resolve in the file
// that wrote the quote (a PRIVATE helper, unqualified), and a
// template's `let tmp` never captures the user's `tmp` arriving
// through a hole — the user's `tmp` is the fn, so `picked()` calls it
use @std.meta.{derive}
use @test.provider.{Loud, wrapped}

@derive(Loud)
type Point = { x: int }

fn tmp() -> int { 10 }

@wrapped(quote { tmp })
fn go() -> int { 0 }

"${Point { x: 1 }.loud()} ${go_wrapped()}"
