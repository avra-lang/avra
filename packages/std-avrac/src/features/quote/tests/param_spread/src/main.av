// proves: a run of seats spread into a fn's parameter list — alone,
// beside written seats, under a hole-named fn, empty, with defaults,
// and on a method with a receiver — in both engines
use @std.meta.{derive}
use @test.seated.{Seated}

@derive(Seated)
type P = { a: int, b: int }

"${P.sum(2, 3)} ${P.around(1, 2, 3, 4)} ${P.prod(2, 5)} ${P.zero()} ${P.dflt()} ${P { a: 3, b: 0 }.scaled(2, 9)}"
