// The derives `hole_type_landed` reads. This file imports `@std.meta`'s `Named`, which the
// program also declares for itself; the quotes splice the program's type only through a hole.
use @std.meta.{Type, Directive, Named, beside}

/// `@derive(Made)`: `T.made()`, a `T` of its first field set to 1, the literal's type a lone hole.
export trait Made {
    static fn derive(t: Type) -> List<Directive> {
        let f = t.fields[0].name
        [beside(t, quote { impl ${t} { static fn made() -> ${t} { ${t} { ${f}: 1 } } } })]
    }
}

/// `@derive(Boxed)`: `T.boxed(x)`, a `T` whose first field is `x`, taken at that field's own type.
export trait Boxed {
    static fn derive(t: Type) -> List<Directive> {
        let f = t.fields[0]
        [
            beside(
                t,
                quote { impl ${t} { static fn boxed(x: ${f.ty}) -> ${t} { ${t} { ${f.name}: x } } } },
            ),
        ]
    }
}

/// Holds the import live, as a derive file's own code would.
fn seen(n: Named) -> Named { n }
