// proves: a type a hole splices reads where the code lands — a lone
// `${t}` as a literal's type names the program's own `Named`, never the
// `@std.meta.Named` the derive's file imports, and a field's type
// `Box<Named>` through `${f.ty}` names the program's too
use @std.meta.{derive}

@derive(Made)
type Named = { n: int }

type Box<T> = { v: T }

@derive(Boxed)
type Holder = { b: Box<Named> }

"${Named.made().n} ${Holder.boxed(Box { v: Named { n: 7 } }).b.v.n}"
