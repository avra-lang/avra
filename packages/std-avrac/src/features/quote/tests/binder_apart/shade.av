use @std.meta.{Type, Directive, beside, name}

/// A derive whose template's own lambda binds `x`, beside a hole that names the field `x`.
export trait Shaded {
    static fn derive(t: Type) -> List<Directive> {
        let field = t.fields[0].name
        [
            beside(
                t,
                quote {
                    impl ${t} {
                        fn picked(${field}: int) -> int {
                            let f = (x: int) -> ${name(field)} * 10 + x
                            f(1)
                        }
                    }
                },
            ),
        ]
    }
}
