// proves: A NESTED QUOTE'S BODY IS COPIED VERBATIM. The inner quote
// carries a hole of its OWN, filled when the generated fn runs; a
// copier that read that placeholder as one of the OUTER template's
// holes would fill it with the outer template's value, or leave the
// placeholder standing in the answer.
use @std.meta.{derive, Code, name}
use @test.attacks.{NestedHoled}

@derive(NestedHoled)
type P = { a: int }

P { a: 1 }.holed_q(7).text()
