// proves: a hole in a name is ONE identifier — two holes in one name,
// a hole between runs, a number's digits in a name — and a
// hole-named binder is read by a hole of the same name
use @std.meta.{derive}
use @test.attacks.{Names}
@derive(Names)
type P = { a: int, b: int }
"${P { a: 1, b: 2 }.Pmid()} ${P { a: 1, b: 2 }.premid2post()}"
