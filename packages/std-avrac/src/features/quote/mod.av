//! `quote { … }` — a TEMPLATE: generated code as a value, parsed
//! where it is written. The body is ordinary Avra — statements,
//! declarations, or match arms — and `${e}` is a hole typed by the
//! seat it stands in (`core/holes.av`). The value names this quote
//! and carries its fills: `@std.meta.Code`, `Stmts`, `Arms` or
//! `Decls`, by what the body parsed as. The template's own names
//! resolve here; a name arriving through a hole resolves where the
//! code is spliced.
use features.{LanguageFeature}
use @std.grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use diagnostics.{DiagCode}

export fn quote_lit() -> LanguageFeature {
    let codes = table<DiagCode> {
        kind                   | summary
        "type.quote_hole"      | "a hole takes what its seat takes"
        "type.quote_meta"      | "a `quote` answers a `@std.meta` value, which this program does not load"
        "type.quote_pat_shape" | "a `quote` pattern matches one node — one statement, no arms"
        "type.quote_pat_subj"  | "a `quote` pattern reads code — a `Code`, not this subject's type"
        "type.quote_pat_hole"  | "a `quote` pattern's hole names a fresh variable, not a written expression"
        "type.quote_pat_type"  | "a `quote` pattern takes no hole in type position yet"
        "type.quote_pat_seat"  | "a `quote` pattern's hole cannot bind at this seat — an embedded name/binder hole, or an arm hole"
        "type.quote_pat_mixed" | "a `quote` pattern's binder is used at both a code seat and a name seat"
        "type.quote_pat_run"   | "two run holes with nothing between them — no scan can split them"
    }
    LanguageFeature quote_lit {
        name: "quote"
        gram: grammar {
            primary = q:quote_lit -> q
            quote_lit = "quote" open:"{" ( arms:arm | stmts:stmt | BREAK )* close:"}" ( begins:HOLE_BEGIN ( holes:hole_content )? ends:HOLE_END )* -> Expr.Body by quote_written
            pattern = body:quote_lit -> Pat.Quote
            nonbind_pattern = body:quote_lit -> Pat.Quote
            hole_content = run:".." name:NAME -> Expr.Ident | e:expression -> e
        }
        diags: codes
    }
    quote_lit
}
