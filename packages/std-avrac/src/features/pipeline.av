
//! THE PIPELINE — a walk described as a value, then run through the
//! walk's own verbs. Its clauses run in order: a head opens a walk
//! inside every walk before it, a keep guards every clause after it, a
//! map replaces the element in hand; past the last clause the element
//! reaches the sink. A comprehension is a pipeline whose sink pushes.
use core.{ExprId, DeclId, Reg, TypeId, Ins, Type, BinOp}

/// A head's source: a list, or the range `source..hi`. `index` binds
/// the position before the element; a `lookup` is read in the
/// source's place.
export type Source = { source: ExprId, hi: ExprId?, index: bool, lookup: Lookup? }

/// A relation's narrower read: `lookup(db, value)`, the value written
/// in the filter `cond`.
export type Lookup = { lookup: DeclId, db: ExprId, value: ExprId, cond: ExprId }

/// A fn box asked per element: the box, and the code pointer read
/// from it once — a method chain's adapter, boxed before the loop.
export type FnBox = { box: Reg, code: Reg }

/// How a clause computes: an expression written over the heads'
/// binders, or a fn box applied to the element in hand.
export enum Step {
    Written(e: ExprId)
    Applied(f: FnBox, ret: TypeId)
}

export enum Clause {
    Head(s: Source)
    Keep(s: Step)
    Map(s: Step)
    Take(count: Reg, n: Reg)
    Drop(count: Reg, n: Reg)
}

/// Where each element that passes every clause goes: a pushed list, or
/// a terminal's answer cell — a verdict, the first hit, its place. `ret`
/// is the sink's own answer type; `cell` was seeded before the loop.
export enum Sink {
    Push(dst: Reg)
    Any(ret: TypeId, cell: Reg, pred: FnBox)
    All(ret: TypeId, cell: Reg, pred: FnBox)
    Find(ret: TypeId, cell: Reg, pred: FnBox)
    FindMap(ret: TypeId, cell: Reg, pred: FnBox)
    FindIndex(ret: TypeId, cell: Reg, pred: FnBox)
    Contains(ret: TypeId, cell: Reg, needle: Reg, elem: TypeId)
    IndexOf(ret: TypeId, cell: Reg, needle: Reg, elem: TypeId)
    Count(ret: TypeId, cell: Reg)
    Sum(ret: TypeId, cell: Reg)
    MinMax(ret: TypeId, has: Reg, best: Reg, less: bool)
}

export type Pipeline = { clauses: List<Clause>, sink: Sink }

/// Every head's registers so far, which a written step binds, the
/// element in hand, and this turn's place — a pipeline opens with a
/// head, so a sink has both.
type Turn = { regs: List<Reg>, at: Reg?, value: Reg? }

impl LowerCx {
    /// The pipeline run, answering its sink's value.
    mut fn piped(p: Pipeline) -> Reg {
        self.staged(p, 0, Turn { regs: [], at: null, value: null })
        self.sink_answer(p.sink)
    }

    /// The clause at `at`, every later one inside it.
    mut fn staged(p: Pipeline, at: int, t: Turn) {
        if at >= p.clauses.length { return self.sunk(p.sink, t) }
        match p.clauses[at] {
            .Head(s) -> self.headed(p, at, t, s),
            .Keep(s) -> self.void_region(self.stepped(s, t)) { cx -> cx.staged(p, at + 1, t) },
            .Map(s) -> self.staged(p, at + 1, t with { value: self.stepped(s, t) }),
            .Take(count, n) -> {
                let seen = self.loaded_as(self.type(int), count)
                let keep = self.bin(Type.Bool, BinOp.Lt, seen, n)
                self
                    .void_region(keep) { cx ->
                        cx.count_past(count, seen)
                        cx.staged(p, at + 1, t)
                    }
                self.void_region(self.un(keep)) { cx -> cx.walk_done() }
            },
            .Drop(count, n) -> {
                let seen = self.loaded_as(self.type(int), count)
                self.count_past(count, seen)
                let past = self.bin(Type.Bool, BinOp.Ge, seen, n)
                self.void_region(past) { cx -> cx.staged(p, at + 1, t) }
            },
        }
    }

    /// A head binds its source under the earlier heads' registers — its
    /// range bound shares that anchor — reads its lookup, and opens its
    /// walk with every later clause inside the turn.
    mut fn headed(p: Pipeline, at: int, t: Turn, s: Source) {
        self.bind_patterns(s.source, t.regs)
        self.looked_up(s.source, t.regs, s.lookup)
        let w = if s.hi == null { self.opened(s.source, self.elem_of(s.source)) } else { self.counted(s.source, s.hi!) }
        let here = self.turn_open(w)
        let v = if s.hi == null { self.turn_elem(w, here) } else { here }
        self
            .staged(
                p,
                at + 1,
                Turn {
                    regs: t.regs.concat(if s.index { [here, v] } else { [v] }),
                    at: here,
                    value: v,
                },
            )
        self.loop_end()
    }

    /// The head's source read through its lookup, when one narrows it:
    /// the value, written in a filter, reads only earlier heads'
    /// binders, bound here.
    mut fn looked_up(source: ExprId, regs: List<Reg>, lookup: Lookup?) {
        let l? = lookup else { return }
        self.bind_patterns(l.cond, regs)
        let rows = self
            .call_decl_at(
                source,
                self.method_symbol(l.lookup, source, self.type_at(source)),
                [self.reg_of(l.db), self.reg_of(l.value)],
            )
        self.body.set_reg(source, rows)
    }

    mut fn stepped(s: Step, t: Turn) -> Reg {
        match s {
            .Written(e) -> {
                self.bind_patterns(e, t.regs)
                self.reg_of(e)
            },
            .Applied(f, ret) -> self.call_ptr(ret, f.code, [f.box, t.value!]),
        }
    }

    /// An element reaches the sink: push it, or answer the terminal —
    /// each terminal stores into its cell and ends the walk on its hit.
    mut fn sunk(s: Sink, t: Turn) {
        match s {
            .Push(dst) -> self.push_slot(dst, t.value!),
            .Any(_, cell, pred) -> {
                self
                    .void_region(self.pred_call(pred, t)) { cx -> cx.store_hit(cell, cx.const_bool(true)) }
            },
            .All(_, cell, pred) -> {
                self
                    .void_region(self.un(self.pred_call(pred, t))) { cx ->
                        cx.store_hit(cell, cx.const_bool(false))
                    }
            },
            .Find(ret, cell, pred) -> {
                self
                    .void_region(self.pred_call(pred, t)) { cx ->
                        cx.store_hit(cell, cx.adopted(ret, false, t.value!))
                    }
            },
            .FindMap(ret, cell, pred) -> {
                let ans = self.call_ptr(ret, pred.code, [pred.box, t.value!])
                self
                    .void_region(self.presence_of(ans, ret)) { cx ->
                        cx.store_hit(cell, ans)
                    }
            },
            .FindIndex(ret, cell, pred) -> {
                self
                    .void_region(self.pred_call(pred, t)) { cx ->
                        cx.store_hit(cell, cx.adopted(ret, false, t.at!))
                    }
            },
            .Contains(_, cell, needle, elem) -> {
                self
                    .void_region(self.same_value(t.value!, needle, elem)) { cx ->
                        cx.store_hit(cell, cx.const_bool(true))
                    }
            },
            .IndexOf(_, cell, needle, elem) -> {
                self
                    .void_region(self.same_value(t.value!, needle, elem)) { cx ->
                        cx.store_hit(cell, t.at!)
                    }
            },
            .Count(_, cell) -> self.accumulate(cell, self.const_int(1)),
            .Sum(_, cell) -> self.accumulate(cell, t.value!),
            .MinMax(_, has, best, less) -> {
                let value = t.value!
                let held = self.loaded_as(self.type(int), best)
                let op: BinOp = if less { BinOp.Lt } else { BinOp.Gt }
                let beats = self.bin(Type.Bool, op, value, held)
                let have = self.loaded_as(self.type(bool), has)
                let better = self
                    .region_as(have, self.type(bool)) { _cx -> beats } else { cx -> cx.const_bool(true) }
                self
                    .void_region(better) { cx ->
                        cx.emit(Ins.Store(has, cx.const_bool(true)))
                        cx.emit(Ins.Store(best, value))
                    }
            },
        }
    }

    /// `take`/`drop` count the elements that REACH them — one more past
    /// this one, kept or dropped.
    mut fn count_past(cell: Reg, seen: Reg) {
        self.emit(Ins.Store(cell, self.bin(Type.Int, BinOp.Add, seen, self.const_int(1))))
    }

    /// One more into an accumulator cell — `count` adds one, `sum` adds
    /// the element; the walk runs whole, nothing ends early.
    mut fn accumulate(cell: Reg, v: Reg) {
        let next = self.bin(Type.Int, BinOp.Add, self.loaded_as(self.type(int), cell), v)
        self.emit(Ins.Store(cell, next))
    }

    /// The predicate asked about this element — one CallPtr per turn.
    mut fn pred_call(pred: FnBox, t: Turn) -> Reg {
        self.call_ptr(self.type(bool), pred.code, [pred.box, t.value!])
    }

    /// The terminal's hit: write its cell and end the walk.
    mut fn store_hit(cell: Reg, v: Reg) {
        self.emit(Ins.Store(cell, v))
        self.walk_done()
    }

    mut fn sink_answer(s: Sink) -> Reg {
        match s {
            .Push(dst) -> dst,
            .Any(ret, cell, _) or .All(ret, cell, _) or .Find(ret, cell, _) or .FindMap(ret, cell, _) or .FindIndex(ret, cell, _) or .Contains(ret, cell, _, _) or .IndexOf(ret, cell, _, _) or .Count(ret, cell) or .Sum(ret, cell) -> self.loaded_as(ret, cell),
            .MinMax(ret, has, best, _) -> self
                .region_as(self.loaded_as(self.type(bool), has), ret) { cx ->
                    cx.adopted(ret, false, cx.loaded_as(self.type(int), best))
                } else { cx -> cx.absent_of(ret) },
        }
    }

    /// The source's element type — typing proved it a list.
    fn elem_of(source: ExprId) -> TypeId {
        let held: TypeId? = self.view.types.element(self.type_at(source))
        held ?? self.type_at(source)
    }
}
