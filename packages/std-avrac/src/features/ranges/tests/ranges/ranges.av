// proves: (lo..hi) as a value — map/find/any/all/count/sum over a
// range receiver, half-open bounds, and the absorbing side on an
// empty or backwards range. The vertical story: features/ranges.
let hit = (0..10).find((i: int) -> i * i > 20) ?? -1
let doubled = (0..4).map((i: int) -> i * 2)
let yes = (0..5).any((i: int) -> i == 3)
let no = (0..5).any((i: int) -> i == 9)
let every = (1..4).all((i: int) -> i > 0)
let cnt = (2..5).count()
let total = (0..5).sum()
let empty = (0..0).find((i: int) -> true) ?? -1
let back = (5..2).count()
let vacuous = (0..0).all((i: int) -> false)
"${hit} ${doubled.length} ${doubled[3]} ${yes} ${no} ${every} ${cnt} ${total} ${empty} ${back} ${vacuous}"
