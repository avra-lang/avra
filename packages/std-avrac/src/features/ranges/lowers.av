//! The lowering rule of a range: its bounds, packed — a range is its start and its end, in registers.
use core.{ExprId, Lowering, Lowers, Reg}
use core.expr.{Range}

impl Lowers for Range {
    fn lowered(mut cx: Lowering, e: ExprId) -> Reg {
        let lo = cx.lower(self.lo)
        let hi = cx.lower(self.hi)
        cx.pack(cx.layout_at(e), [lo, hi])
    }
}
