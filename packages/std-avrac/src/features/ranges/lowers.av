//! The lowering rule of a range: its bounds, then a box of two slots holding its start and its end.
use core.{ExprId, Lowering, Lowers, Reg, rt_sig_of}
use core.expr.{Range}

impl Lowers for Range {
    fn lowered(mut cx: Lowering, e: ExprId) -> Reg {
        let lo = cx.lower(self.lo)
        let hi = cx.lower(self.hi)
        let built = cx.call_row(cx.layout_at(e), rt_sig_of("avra_array_sized")!, [cx.const_int(2)])
        cx.push_slot(built, lo)
        cx.push_slot(built, hi)
        built
    }
}
