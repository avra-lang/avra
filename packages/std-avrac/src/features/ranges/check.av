//! The range's typing law: both bounds are `int`s, refused once, at the
//! first bound that is not.
use core.{ExprId}
use features.{TypeCx, this_is}
use diagnostics.{Diag, refusal}

/// A range bound is an `int`; Error absorbs.
fn range_bound(mut cx: TypeCx, e: ExprId, verb: string) -> bool {
    if cx.accepts(e, cx.type(int)) { return true }
    if cx.shape_at(e) is .Error { return false }
    cx.emit(bound_not_int(cx, e, verb))
    false
}

// ── The voices ──

fn bound_not_int(cx: TypeCx, e: ExprId, verb: string) -> Diag {
    let n = cx.name_at(e)
    refusal(
        "type.mismatch",
        cx.loc_of(e),
        "a range ${verb} at an `int`, found `${n}`",
        this_is(n),
        "a range counts between `int`s — `for i in 0..n`; to walk a list, name it directly: `for x in xs`",
    )
}
