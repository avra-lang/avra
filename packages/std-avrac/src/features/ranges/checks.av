//! The typing rule of a range: both ends are `int`s, and it's a `Range`.
use core.{Checking, Checks, ExprId, Expected, SignedType, owned_type}
use core.expr.{Range}

impl Checks for Range {
    fn checked(mut cx: Checking, e: ExprId, expected: Expected) -> SignedType? {
        let _ = cx.check(self.lo, Expected.Exactly(owned_type("int")))
        let _ = cx.check(self.hi, Expected.Exactly(owned_type("int")))
        owned_type("Range")
    }
}
