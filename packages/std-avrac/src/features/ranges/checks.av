//! The typing rule of a range: both ends are `int`s, refused once at the first that is none, and it's
//! a `Range`.
use core.{Checking, Checks, ExprId, Expected, Seating, SignedType, owned_type}
use core.expr.{Range}

impl Checks for Range {
    fn checked(mut cx: Checking, e: ExprId, expected: Expected) -> SignedType? {
        let before = cx.refused.get().length
        let _ = cx.check_seated(self.lo, owned_type("int"), Seating.RangeBound(false))
        let started = cx.refused.get().length == before
        let _ = if started { cx.check_seated(self.hi, owned_type("int"), Seating.RangeBound(true)) } else { cx.check(self.hi, Expected.Unknown) }
        owned_type("Range")
    }
}
