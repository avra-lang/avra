//! The ranges semantics: dispatch only. A range's bounds are ordinary
//! expressions walked in place; the value wears the builtin
//! `Type.Range` — a two-slot box, its own identity so a method row can
//! name a range receiver without a string tag.
use core.{Expr, ExprId, Type, TypeId, Reg}
use features.{NodeSemantics, ResolveCx, TypeCx, LowerCx, nothing, Meaning}

use core.expr.{Range}

export type RangesSemantics = {}

impl NodeSemantics for RangesSemantics {
    fn kids(e: Expr) -> List<ExprId> {
        match e { .Range(lo, hi) -> [lo, hi], rest -> [] }
    }

}

impl Meaning for Range {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        cx.walk(self.lo)
        cx.walk(self.hi)
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        let int = cx.type(int)
        if !cx.accepts(self.lo, int) { return cx.error_type }
        if !cx.accepts(self.hi, int) { return cx.error_type }
        cx.view.types.intern(Type.Range)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        let dst = cx.array_sized(Type.Range, cx.const_int(2))
        cx.push_slot(dst, cx.reg_of(self.lo))
        cx.push_slot(dst, cx.reg_of(self.hi))
        dst
    }
}
