//! Ranges — `(lo..hi)` as a value: a half-open counting range, the
//! two bounds as written. The bounds are `int`s and the value is the
//! `Range` record the prelude names, so a range is a flat two-slot
//! value with no box of its own. The grammar merges its `(` primary
//! BEFORE the spine's group so `(lo..hi)` parses as a range and
//! `(e)` stays a group.
use features.{LanguageFeature, BuilderRow}
use @std.grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Fixed, Expect, Recover}

export fn ranges() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name        | build
        "range_lit" | build_range_lit
    }
    LanguageFeature ranges {
        gram: grammar {
            primary = "(" lo:expression ".." hi:expression ")" @expect(")", "expected `)` to close the range") -> range_lit(lo, hi)
        }
        builders: rows
    }
    ranges
}
