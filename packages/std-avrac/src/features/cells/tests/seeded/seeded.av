// proves: a cell OWNS what it holds — a seed some binding still holds is
// copied at `Cell.new`, so the cell's in-place writes reach neither that
// binding nor a sibling cell seeded from it.
let none: Map<string, bool> = {}
let a = Cell.new(none)
let b = Cell.new(none)
a.put("k", true)
let xs: List<int> = [5]
let c = Cell.new(xs)
c.push(1)
c.set_at(0, 7)
"${b.get().length} ${none.length} ${a.get().length} ${xs.length} ${xs[0]} ${c.get().length} ${c.get()[0]}"
