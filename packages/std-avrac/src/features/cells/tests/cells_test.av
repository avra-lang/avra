use @std.avrac.testing.{shown, refused_with}

spec "features/cells" {
    given "one explicit shared slot" {
        then "copies see replacement through either name" {
            shown("let a = Cell.new(1)\nlet b = a\nb.set(2)\na.get()") == "2"
        }
        then "the binding itself need not be mut" {
            shown("let c: Cell<int> = Cell.new(3)\nc.set(4)\nc.get()") == "4"
        }
        then "get preserves aggregate value semantics" {
            shown("let c = Cell.new([1])\nmut snapshot = c.get()\nsnapshot.push(2)\nc.get().length") == "1"
        }
        then "set accepts the held type" {
            refused_with(
                "let c = Cell.new(1)\nc.set(\"x\")\n0",
                "argument 1 of `set` wants `int`, found `string`",
            )
        }
        then "get takes no arguments" {
            refused_with("let c = Cell.new(1)\nc.get(2)", "`get` takes 0 arguments, found 1")
        }
        then "the type has one argument" {
            refused_with(
                "let c: Cell<int, int> = Cell.new(1)\n0",
                "`Cell` is applied to 2 types; it takes 1",
            )
        }
        then "push appends to the held list, no mut binding needed" {
            shown("let c = Cell.new([1])\nc.push(2)\nlet d = c\nd.push(3)\nc.get().length") == "3"
        }
        then "set_at writes one element of the held list" {
            shown("let c = Cell.new([1, 2])\nc.set_at(1, 9)\nc.get()[1]") == "9"
        }
        then "put inserts into the held map, no mut binding needed" {
            shown(
                "let c = Cell.new({\"a\": 1})\nc.put(\"b\", 2)\nlet d = c\nd.put(\"c\", 3)\n\"\${c.get().get(\"a\") ?? 0} \${c.get().get(\"b\") ?? 0} \${c.get().get(\"c\") ?? 0}\"",
            ) == "1 2 3"
        }
        then "put refuses a non-string key" {
            refused_with(
                "let c = Cell.new({\"a\": 1})\nc.put(2, 3)\n0",
                "argument 1 of `put` wants `string`, found `int`",
            )
        }
        then "put refuses a value that does not match the map's" {
            refused_with(
                "let c = Cell.new({\"a\": 1})\nc.put(\"b\", \"not an int\")\n0",
                "argument 2 of `put` wants `int`, found `string`",
            )
        }
        then "put refuses a cell that does not hold a map" {
            refused_with(
                "let c = Cell.new(1)\nc.put(\"k\", 2)\n0",
                "`put` inserts into the map a cell holds, and this cell holds `int`",
            )
        }
        then "put is not a map's own method — no cell, no put" {
            refused_with(
                "mut m: Map<string, int> = {\"a\": 1}\nm.put(\"b\", 2)\n0",
                "`.put(…)` calls a method, and `Map<string, int>` has none",
            )
        }
    }
    given "a cell seeded from a binding" {
        then "its writes never reach the binding, nor a sibling cell seeded from it" {
            shown(
                "let none: Map<string, bool> = {}\nlet a = Cell.new(none)\nlet b = Cell.new(none)\na.put(\"k\", true)\n\"\${b.get().length} \${none.length} \${a.get().length}\"",
            ) == "0 0 1"
        }
        then "a list seed stays as it was through a push and a set_at" {
            shown(
                "let xs: List<int> = [5]\nlet a = Cell.new(xs)\na.push(1)\na.set_at(0, 7)\n\"\${xs.length} \${xs[0]} \${a.get().length} \${a.get()[0]}\"",
            ) == "1 5 2 7"
        }
        then "a scalar seed needs no copy and reads back" {
            shown("let a = Cell.new(3)\na.set(4)\na.get()") == "4"
        }
    }
    given "the cell a typed let declares" {
        then "`null` fills a declared nullable cell" {
            shown(
                "let c: Cell<int?> = Cell.new(null)\nlet e = c.get() ?? 4\nc.set(2)\n\"\${e} \${c.get() ?? 4}\"",
            ) == "4 2"
        }
        then "a value the declared cell cannot hold refuses, in the cell's words" {
            refused_with(
                "let c: Cell<int?> = Cell.new(\"s\")\n1",
                "this cell holds `int?`, this is `string`",
            )
        }
        then "with nothing declared, `null` names no type" {
            refused_with(
                "let c = Cell.new(null)\n1",
                "a cell takes its type from its value, and `null` has none of its own",
            )
        }
    }
}
