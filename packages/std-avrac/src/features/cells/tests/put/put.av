// proves: push/set_at/put grow the cell's own held list/map in place,
// through any alias, with no mut binding on the cell.
let ints = Cell.new([1])
ints.push(2)
let via_alias = ints
via_alias.push(3)
ints.set_at(0, 9)

let words: Cell<Map<string, int>> = Cell.new({"a": 1})
words.put("b", 2)
let also_words = words
also_words.put("c", 3)

"${ints.get().length} ${ints.get()[0]} ${ints.get()[1]} ${ints.get()[2]} ${words.get().get("a") ?? 0} ${words.get().get("b") ?? 0} ${words.get().get("c") ?? 0}"
