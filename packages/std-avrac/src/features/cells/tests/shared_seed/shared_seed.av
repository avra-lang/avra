// proves: two cells seeded from ONE empty list each own their list — a
// thousand pushes through one never reach the other or the seed, and the
// other's own writes stay its own.
type Pair = { left: Cell<List<int>>, right: Cell<List<int>> }

fn seeded() -> Pair {
    let none: List<int> = []
    Pair { left: Cell.new(none), right: Cell.new(none) }
}

impl Pair {
    fn grow(n: int) {
        for i in 0..n { self.left.push(i) }
    }

    fn stamp(at: int, v: int) {
        while self.right.get().length <= at { self.right.push(0) }
        self.right.set_at(at, v)
    }
}

let none: List<int> = []
let a = Cell.new(none)
let b = Cell.new(none)
for i in 0..1000 { a.push(i) }
let p = seeded()
p.grow(1000)
p.stamp(2, 9)
let l = p.left.get()
let r = p.right.get()
"${a.get().length} ${a.get()[999]} ${b.get().length} ${none.length} ${l.length} ${l[999]} ${r.length} ${r[2]}"
