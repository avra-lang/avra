// proves: a payload-less variant of a GENERIC enum fills a `Cell`
// seat's want — `Cell.new(Slot.Gone)` lands at `Cell<Slot<int>>` and
// reads back `.Gone` — while a payload-carrying variant pins its own
// type, and the same construction fills an argument seat.
enum Slot<T> { Gone, Here(T) }

fn hold(c: Cell<Slot<int>>) -> Slot<int> { c.get() }

fn gone(s: Slot<int>) -> bool {
    match s { .Gone -> true, .Here(_) -> false }
}

let declared: Cell<Slot<int>> = Cell.new(Slot.Gone)
let carried: Cell<Slot<string>> = Cell.new(Slot.Here("x"))
let seated: Slot<int> = hold(Cell.new(Slot.Gone))
"${gone(declared.get())} ${gone(seated)} ${carried.get() is .Here}"
