// proves: a declared field and a cell's slot read by offset alone, across inline, generic and nullable layouts.
type Point = { x: int, y: int }

type Holder<T> = { first: T, tag: string, on: Cell<bool> }

type Row = {
    at: Point,
    name: string,
    flag: Cell<bool>,
    maybe: Cell<int?>,
    items: Cell<List<string>>,
}

impl Row {
    fn probe(i: int) -> string {
        let n = self.name
        if self.flag.get() { self.items.push("t${i}") }
        "${n}:${self.at.y}:${self.maybe.get() ?? -1}:${self.items.get().length}"
    }
}

let absent: Cell<int?> = Cell.new(null)
let r = Row {
    at: Point { x: 3, y: 4 },
    name: "row",
    flag: Cell.new(true),
    maybe: absent,
    items: Cell.new(["a"]),
}
let first = r.probe(1)
r.maybe.set(9)
r.flag.set(false)
let second = r.probe(2)
let h = Holder { first: Point { x: 5, y: 6 }, tag: "h", on: Cell.new(true) }
"${first} ${second} ${h.first.y}${h.tag}${h.on.get()}"
