//! `Cell<T>` — one explicit shared slot. Copies of a cell share its
//! referent; `get` copies the held value and `set` replaces it without
//! requiring the cell binding itself to be `mut`.
use core.{Type, TypeId, ExprId, Reg, Ins}
use features.{LanguageFeature, MethodRow, ReceiverEffect, TypeRow, TypeArgs, MethodCall, TypeCx, LowerCx, no_law, no_variants, slot_worthy}
use diagnostics.{DiagCode, refusal}

export fn cells() -> LanguageFeature {
    let methods = table<MethodRow> {
        name  | takes       | check     | lower     | effect
        "new" | on_cell_type | check_new | lower_new | ReceiverEffect.Read
        "get" | on_cell      | check_get | lower_get | ReceiverEffect.Read
        "set" | on_cell      | check_set | lower_set | ReceiverEffect.Shared
        "push" | on_cell     | check_push | lower_push | ReceiverEffect.Shared
        "set_at" | on_cell   | check_set_at | lower_set_at | ReceiverEffect.Shared
        "put" | on_cell      | check_put | lower_put | ReceiverEffect.Shared
    }
    let types = table<TypeRow> {
        name   | arity | slots | judge  | builds     | variants
        "Cell" | 1     | true  | no_law | cell_shape | no_variants
    }
    let codes = table<DiagCode> {
        kind            | id      | summary
        "type.cell_map" | "F2094" | "`put` needs a cell holding a map"
    }
    component LanguageFeature f {
        name = "cells"
        docs = "`Cell.new(v)` creates an explicit shared `Cell<T>`; copies share one slot, `get()` reads its value, and `set(v)` replaces it through any copy."
        methods = methods
        types = types
        diags = codes
    }
    f
}

fn on_cell_type(t: Type) -> bool {
    match t {
        .TypeName(_, "Cell") -> true,
        _ -> false,
    }
}

fn on_cell(t: Type) -> bool { t is .Cell }

fn check_new(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    if mc.args.length != 1 {
        cx.wrong_arity(mc.e, "Cell.new", 1, mc.args.length)
        return cx.error_type
    }
    let held = cx.type_at(mc.args[0])
    if cx.errored_ty(held) { return cx.error_type }
    if !slot_worthy(cx.view.types, cx.view.types.shape_of(held)) {
        return cx.unslottable(mc.args[0], "a cell")
    }
    cx.view.types.intern(Type.Cell(held))
}

fn held_type(cx: TypeCx, mc: MethodCall) -> TypeId? {
    cx.view.types.cell_inner(cx.type_at(mc.subject))
}

fn check_get(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let held: TypeId? = held_type(cx, mc)
    if held == null || !cx.seated(mc, "get", []) { return cx.error_type }
    held!
}

fn check_set(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let held: TypeId? = held_type(cx, mc)
    if held == null || !cx.seated(mc, "set", [held!]) { return cx.error_type }
    cx.type(void)
}

fn lower_new(mut cx: LowerCx, mc: MethodCall) -> Reg {
    if mc.args.length != 1 { return cx.lower_defect(mc.e, "a Cell.new without one value survived typing") }
    let value = cx.reg_of(mc.args[0])
    let size = cx.box_size(1)
    let dst = cx.result(mc.e)
    cx.grown_box(dst, size, [value])
    dst
}

fn lower_get(mut cx: LowerCx, mc: MethodCall) -> Reg {
    cx.slot_read(cx.reg_of(mc.subject), 0, cx.view.types.cell_inner(cx.type_at(mc.subject)))
}

fn lower_set(mut cx: LowerCx, mc: MethodCall) -> Reg {
    let box = cx.reg_of(mc.subject)
    let at = cx.const_int(0)
    cx.emit(Ins.CallRtVoid("avra_slot_set", [box, at, cx.reg_of(mc.args[0])]))
    cx.hollow_of(cx.type_at(mc.e))
}

/// `c.push(v)` — append to the list the cell HOLDS.
///
/// THE WHOLE POINT: a read-modify-write through `get`/`set` copies the held
/// list once per element, because the value `get` hands back stays shared
/// with the cell. The cell OWNS its list, so this reads slot 0 and pushes —
/// no `unique_box`, no round trip — and the append is in place.
fn check_push(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let held? = held_type(cx, mc) else { return cx.error_type }
    let elem? = cx.view.types.element(held) else { return cx.error_type }
    if !cx.seated(mc, "push", [elem]) { return cx.error_type }
    cx.type(void)
}

fn lower_push(mut cx: LowerCx, mc: MethodCall) -> Reg {
    let first? = mc.args.first() else { return cx.lower_defect(mc.e, "a push without its value survived typing") }
    let held: TypeId? = cx.view.types.cell_inner(cx.type_at(mc.subject))
    if held == null { return cx.lower_defect(mc.e, "a Cell.push whose cell has no held type survived typing") }
    let list = cx.slot_read(cx.reg_of(mc.subject), 0, held)
    cx.emit(Ins.CallRtVoid("avra_array_push", [list, cx.reg_of(first)]))
    cx.hollow_of(cx.type_at(mc.e))
}

/// `c.set_at(i, v)` — write one element of the list the cell HOLDS.
///
/// The indexed twin of `push`, and the same point: `get` then `set` copies
/// the held list, while the cell owns it and a slot write is in place.
fn check_set_at(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let held? = held_type(cx, mc) else { return cx.error_type }
    let elem? = cx.view.types.element(held) else { return cx.error_type }
    if !cx.seated(mc, "set_at", [cx.type(int), elem]) { return cx.error_type }
    cx.type(void)
}

fn lower_set_at(mut cx: LowerCx, mc: MethodCall) -> Reg {
    if mc.args.length != 2 { return cx.lower_defect(mc.e, "a set_at without its index and value survived typing") }
    let held: TypeId? = cx.view.types.cell_inner(cx.type_at(mc.subject))
    if held == null { return cx.lower_defect(mc.e, "a Cell.set_at whose cell has no held type survived typing") }
    let list = cx.slot_read(cx.reg_of(mc.subject), 0, held)
    cx.emit(Ins.CallRtVoid("avra_slot_set", [list, cx.reg_of(mc.args[0]), cx.reg_of(mc.args[1])]))
    cx.hollow_of(cx.type_at(mc.e))
}

/// `c.put(k, v)` — insert into the map the cell HOLDS.
///
/// THE MAP TWIN of `push`: a read-modify-write through `get`/`set`
/// copies the held map once per key, because the value `get` hands
/// back stays shared with the cell. The cell OWNS its map, so this
/// reads slot 0 and inserts — no `unique_box`, no round trip.
fn check_put(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let held? = held_type(cx, mc) else { return cx.error_type }
    let value? = cx.view.types.map_value(held) else { return cell_holds_no_map(cx, mc.e, held) }
    if !cx.seated(mc, "put", [cx.type(string), value]) { return cx.error_type }
    cx.type(void)
}

fn lower_put(mut cx: LowerCx, mc: MethodCall) -> Reg {
    if mc.args.length != 2 { return cx.lower_defect(mc.e, "a put without its key and value survived typing") }
    let held: TypeId? = cx.view.types.cell_inner(cx.type_at(mc.subject))
    if held == null { return cx.lower_defect(mc.e, "a Cell.put whose cell has no held type survived typing") }
    let map = cx.slot_read(cx.reg_of(mc.subject), 0, held)
    cx.emit(Ins.CallRtVoid("avra_map_set", [map, cx.reg_of(mc.args[0]), cx.reg_of(mc.args[1])]))
    cx.hollow_of(cx.type_at(mc.e))
}

fn cell_shape(args: TypeArgs) -> Type { Type.Cell(args.parts[0]) }

// ── The voices ──

/// `put` inserts into the map a cell holds — a cell holding anything
/// else has no map to insert into.
fn cell_holds_no_map(mut cx: TypeCx, e: ExprId, held: TypeId) -> TypeId {
    cx.spoken(refusal("type.cell_map", cx.loc_of(e), "`put` inserts into the map a cell holds, and this cell holds `${cx.view.types.name_of(held)}`", "not a map", "put values in through a `Cell<Map<string, V>>`"))
}
