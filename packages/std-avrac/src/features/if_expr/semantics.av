//! The if-expression's NodeSemantics: dispatch only. The typing rule
//! lives in check.av; lowering — the MEANING — in lower.av.
use core.{Expr, ExprId, StmtId, TypeId, Reg, Ins}
use features.{NodeSemantics, StmtSemantics, ResolveCx, StmtResolveCx, TypeCx, StmtTypeCx, LowerCx, StmtLowerCx, require_bool, nothing, void_arm, void_close}

export type IfSemantics = { }

impl NodeSemantics for IfSemantics {
    fn kids(e: Expr) -> List<ExprId> {
        // the BRANCHES are hidden: each types under the narrow a
        // presence-test condition may prove, so the rule walks them
        match e {
            .If(c, _, _) -> [c],
            _ -> [],
        }
    }

    fn heirs(e: Expr) -> List<ExprId> {
        // LICENSED I22: a feature cannot enumerate OTHER features' variants
        match e {
            .If(_, t, f) -> [t, f],
            _ -> [],
        }
    }

    fn resolve(cx: ResolveCx, e: ExprId) {
        match cx.view.store.expr(e) {
            .If(_, t, f) -> {
                cx.arm_scope([], t)
                cx.arm_scope([], f)
            }
            _ -> nothing(),
        }
    }

    fn type_of(cx: TypeCx, e: ExprId) -> TypeId {
        if_type(cx, e)
    }

    fn lower(cx: LowerCx, e: ExprId) -> Reg {
        if_lower(cx, e)
    }

}

/// The STATEMENT form's semantics: a valueless region — the guard
/// idiom's home. Each branch scopes its own statements.
export type IfStmtSemantics = { }

impl StmtSemantics for IfStmtSemantics {
    fn resolve_stmt(cx: StmtResolveCx, s: StmtId) {
        match cx.view.store.stmt(s) {
            .IfStmt(c, t, e) -> {
                cx.walk(c)
                cx.scope_stmts(t)
                cx.scope_stmts(e)
            }
            _ -> nothing(),
        }
    }

    fn type_stmt(cx: StmtTypeCx, s: StmtId) {
        match cx.view.store.stmt(s) {
            .IfStmt(c, t, e) -> {
                cx.walk(c)
                require_bool(cx.expr, c, "an `if` condition", "this decides the branch")
                cx.type_stmts(t)
                cx.type_stmts(e)
            }
            _ -> nothing(),
        }
    }

    fn lower_stmt(cx: StmtLowerCx, s: StmtId) -> Reg? {
        match cx.view.store.stmt(s) {
            .IfStmt(c, t, e) -> {
                lower_if_stmt(cx, c, t, e)
                null
            }
            _ -> null,
        }
    }
}

/// The valueless region: both arms yield a THROWAWAY zero — the
/// merge register exists because every region merges, and nothing
/// reads it. A branch that RETURNS never reaches its yield.
fn lower_if_stmt(cx: StmtLowerCx, c: ExprId, t: List<StmtId>, e: List<StmtId>) {
    let ex = cx.expr
    ex.emit(Ins.IfStart(ex.reg_of(c)))
    cx.lower_stmts(t)
    void_arm(ex)
    cx.lower_stmts(e)
    void_close(ex)
}
