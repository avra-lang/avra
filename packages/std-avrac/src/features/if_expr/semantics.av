//! The if-expression's NodeSemantics: dispatch only. The typing rule
//! lives in check.av, evaluation in eval.av, lowering in lower.av.
use core.{Expr, ExprId, TypeId, NodeStore, Reg}
use features.{NodeSemantics, ResolveCx, TypeCx, EvalCx, LowerCx, nothing}

export type IfSemantics = { }

impl NodeSemantics for IfSemantics {
    fn kids(self, e: Expr) -> List<ExprId> {
        match e {
            .If(c, t, f) -> [c, t, f],
            _ -> [],
        }
    }

    fn resolve(self, cx: ResolveCx, e: ExprId) {
        nothing()
    }

    fn type_of(self, cx: TypeCx, e: ExprId) -> TypeId {
        if_type(cx, e)
    }

    fn eval(self, cx: EvalCx, e: ExprId) -> ExprId {
        if_eval(cx, e)
    }

    fn lower(self, cx: LowerCx, e: ExprId) -> Reg {
        if_lower(cx, e)
    }

    fn printed(self, store: NodeStore, e: ExprId) -> string? {
        null
    }
}
