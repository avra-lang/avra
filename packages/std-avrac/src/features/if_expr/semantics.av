//! The if-expression's NodeSemantics: dispatch only. The typing rule
//! lives in check.av; lowering — the MEANING — in lower.av.
use core.{Expr, ExprId, StmtId, TypeId, Reg}
use features.{NodeSemantics, StmtSemantics, ResolveCx, TypeCx, LowerCx, nothing, Meaning}

use core.expr.{If}

export type IfSemantics = {}

impl NodeSemantics for IfSemantics {
    fn kids(e: Expr) -> List<ExprId> {
        // the BRANCHES are hidden: each types under the narrow a
        // presence-test condition may prove, so the rule walks them
        match e { .If(c, _, _) -> [c], _ -> [] }
    }

    fn heirs(e: Expr) -> List<ExprId> {
        // a feature cannot enumerate OTHER features' variants
        match e { .If(_, t, f) -> [t, f], _ -> [] }
    }

}

/// The STATEMENT form's semantics: a valueless region — the guard
/// idiom's home. Each branch scopes its own statements.
export type IfStmtSemantics = {}

impl StmtSemantics for IfStmtSemantics {
    fn resolve_stmt(mut cx: ResolveCx, s: StmtId) {
        match cx.view.store.stmt(s) {
            .IfStmt(c, t, e) -> {
                cx.walk(c)
                cx.scope_stmts(t)
                cx.scope_stmts(e)
            },
            _ -> nothing(),
        }
    }

    fn type_stmt(mut cx: TypeCx, s: StmtId) {
        match cx.view.store.stmt(s) {
            .IfStmt(c, t, e) -> {
                cx.walk(c)
                cx.require_bool(c, "an `if` condition", "this decides the branch")
                cx.type_stmts(t)
                cx.type_stmts(e)
            },
            _ -> nothing(),
        }
    }

    fn lower_stmt(mut cx: LowerCx, s: StmtId) -> Reg? {
        match cx.view.store.stmt(s) {
            .IfStmt(c, t, e) -> {
                lower_if_stmt(cx, c, t, e)
                null
            },
            _ -> null,
        }
    }
}

/// The valueless region: both arms yield a THROWAWAY zero — the
/// merge register exists because every region merges, and nothing
/// reads it. A branch that RETURNS never reaches its yield.
fn lower_if_stmt(mut cx: LowerCx, c: ExprId, t: List<StmtId>, e: List<StmtId>) {
    cx.void_branches(cx.reg_of(c)) { cx -> cx.arm_stmts(t) } else { cx -> cx.arm_stmts(e) }
}

impl Meaning for If {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        cx.arm_scope([], self.on_true)
        cx.arm_scope([], self.on_false)
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        if_type(cx, e)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        if_lower(cx, e)
    }
}
