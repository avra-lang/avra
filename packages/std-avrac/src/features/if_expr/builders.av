//! Parse-time lowering: the statement form of `if` — a guard or a chain.
use core.{Expr, ExprId, Stmt, StmtId}
use features.{LangNode, Builder, expr_id_at, stmt_id_at}

/// The STATEMENT form: a guard, or a chain — `else { … }` is a block,
/// `else if …` is the nested `if` itself. In a block's TAIL position
/// the block builder turns a chain whose branches all end in
/// expressions into the if-expression, so a fn may still answer with
/// one.
fn build_if_stmt(b: Builder) -> Result<LangNode, string> {
    let c = b.expr(0)?
    let t = b.expr(1)?
    let blocked: ExprId? = expr_id_at(b.args, 2)
    let chained: StmtId? = stmt_id_at(b.args, 3)
    let linked: ExprId? = if chained == null { null } else { b.store.stmt_value(chained!) }
    let other: ExprId? = blocked ?? linked
    let guard = b.expr_node(Expr.If(c, t, other))
    b.store.mark_statement_if(guard)
    let _ = b.meant(guard)?
    b.make_stmt(Stmt.ExprStmt(guard))
}
