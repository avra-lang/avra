//! Parse-time lowering: three captured expressions -> the If node; a
//! payload `is` condition is the `IfLet` sugar, which means a `match`.
use core.{Expr, ExprId, PatId, Stmt}
use features.{LangNode, Builder}

fn build_if(b: Builder) -> Result<LangNode, string> {
    let c = b.expr(0)?
    let t = b.expr(1)?
    let e = b.expr(2)?
    let pat? = b.store.binding_pat(c) else { return b.make_expr(Expr.If(c, t, e)) }
    b.wrap_expr(if_let(b, c, pat, t, e))
}

/// `if x is .V(p) { A } else { B }` keeps its own node; what it MEANS
/// is `match x { .V(p) -> A, _ -> B }` — the binding law's one meaning,
/// spelled by the machinery that already carries it (spec 10.4:
/// bind-fresh, scoped to the arm).
fn if_let(b: Builder, c: ExprId, pat: PatId, taken: ExprId, other: ExprId) -> ExprId {
    let subject = b.store.is_subject(c) ?? c
    let sugar = b.expr_node(Expr.IfLet(subject, pat, taken, other))
    let _ = b.store.mean(sugar, if_let_means(b.source_of(subject)), b.words.door)
    sugar
}

fn if_let_means(subject: string) -> string {
    "an `if` that binds means `match ${subject} { … -> …, _ -> … }`"
}

/// The STATEMENT form: a guard, or a chain — `else { … }` and
/// `else if …` land in the else list (a chain's tail is one
/// nested statement there). In a block's TAIL position the block
/// builder turns a chain whose branches all end in expressions
/// into the if-expression, so a fn may still answer with one.
fn build_if_stmt(b: Builder) -> Result<LangNode, string> {
    let c = b.expr(0)?
    let t = b.stmts(1)?
    let e = b.stmts(2)?
    let pat? = b.store.binding_pat(c) else { return b.make_stmt(Stmt.IfStmt(c, t, e)) }
    // `block_of` — not a valueless block — so a branch that ANSWERS keeps
    // its value when the whole guard stands in tail position, exactly as
    // `chain_value` promotes a plain `if` statement; a branch whose tail
    // is no value (or leaves) is void either way, and the arms agree.
    b.make_stmt(Stmt.ExprStmt(if_let(b, c, pat, b.block_of(t), b.block_of(e))))
}
