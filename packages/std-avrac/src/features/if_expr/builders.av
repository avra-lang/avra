//! Parse-time lowering: three captured expressions -> the If node.
use core.{Expr, Stmt}
use features.{LangNode, Builder}

fn build_if(b: Builder) -> Result<LangNode, string> {
    let c = b.expr(0)?
    let t = b.expr(1)?
    let e = b.expr(2)?
    b.make_expr(Expr.If(c, t, e))
}

/// The STATEMENT form — ELSELESS by design: an else would collide
/// with the expression form, and the guard idiom needs none. The
/// node keeps an else list for the day a disambiguated form lands.
fn build_if_stmt(b: Builder) -> Result<LangNode, string> {
    let c = b.expr(0)?
    let t = b.stmts(1)?
    b.make_stmt(Stmt.IfStmt(c, t, []))
}
