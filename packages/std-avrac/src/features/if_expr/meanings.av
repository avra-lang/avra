//! What a two-branch `if` means, in the core.
use features.{meaning}

/// `if c { a } else { b }` is a match on the condition.
export meaning if_else {
    quote { if ${c} { ${..taken} } else { ${..other} } } -> quote {
        match ${c} {
            true -> {
                ${taken}
            }
            _ -> {
                ${other}
            }
        }
    },
}
