//! `if cond { a } else { b }` — the expression form: both branches
//! present, both typed, one taken. The `if` keyword anchor merges
//! ahead of the spine's NAME branch, like the boolean literals.
//! ELSELESS `if cond { statements }` is the statement form, on one
//! line or many — the guard idiom's home. Elseless keeps the two
//! forms unambiguous; the opening BREAK keeps single-line
//! expression arms out of the statement parse.
use features.{LanguageFeature}
use features.if_expr.{when_ladder}
use @std.grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}

export fn if_expr() -> LanguageFeature {
    LanguageFeature if_expr {
        gram: grammar {
            stmt = value:if_stmt END -> Stmt.ExprStmt
            // every line a statement, the last included: no tail is promoted
            stmt_block = "{" ( stmts:stmt | BREAK )* "}" -> Expr.Block
            if_stmt = statement:"if" cond:expression on_true:stmt_block ( "else" ( on_false:stmt_block | on_false:if_stmt ) )? -> Expr.If @head(cond)
            primary = "if" cond:expression on_true:block "else" ( on_false:block | on_false:if_expr ) @expect("else", "an `if` expression needs its `else` branch") -> Expr.If @head(cond)
            if_expr = "if" cond:expression on_true:block "else" ( on_false:block | on_false:if_expr ) -> Expr.If @head(cond)
        }
    }
    if_expr
}
