//! `if cond { a } else { b }` — the expression form: both branches
//! present, both typed, one taken. The `if` keyword anchor merges
//! ahead of the spine's NAME branch, like the boolean literals.
use features.{LanguageFeature, BuilderRow}

export fn if_expr() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name      | build
        "if_expr" | build_if
    }
    component LanguageFeature f {
        name = "if_expr"
        docs = "`if <cond> { <expr> } else { <expr> }`; its value is the taken branch's."
        gram = """
primary = "if" c:expression t:block "else" e:block @expect("else", "an `if` expression needs its `else` branch") -> if_expr(c, t, e)
"""
        builders = rows
    }
    f
}
