//! The typing rule of `if`: the condition is a `bool`, both branches check against what the seat
//! wants, each under what the condition proves where it holds (a presence test's narrowed name, an
//! `is`'s pattern), and the value is where the branches meet; an `if` whose value is dropped is
//! `void` once its branches are known.
use core.{Checking, Checks, ExprId, Expected, SignedType, owned_type, Decision, Seating}
use core.expr.{If}

impl Checks for If {
    /// Each branch is checked against the seat; under a seat that wants nothing, a branch whose type
    /// isn't known for want only of a generic call's pin is checked again against the other's.
    fn checked(mut cx: Checking, e: ExprId, expected: Expected) -> SignedType? {
        cx.conditions.push(self.cond.index)
        let _ = cx.check_seated(self.cond, owned_type("bool"), Seating.Condition(Decision.If))
        let before = cx.refused.get().length
        let first = cx.check_proven(self.on_true, expected, cx.proof_when(self.cond, true))
        let between = cx.refused.get().length
        let other? = self.on_false else { return if expected is .Dropped && first != null { owned_type("void") } else { null } }
        let second = cx.check_proven(other, expected, cx.proof_when(self.cond, false))
        let after = cx.refused.get().length
        let again = cx.pinning([first, second], expected)
        let yes = if first == null && again != null && cx.unpinned_only(before, between) { cx.check_proven(self.on_true, Expected.Exactly(again!), cx.proof_when(self.cond, true)) } else { first }
        let no = if second == null && again != null && cx.unpinned_only(between, after) { cx.check_proven(other, Expected.Exactly(again!), cx.proof_when(self.cond, false)) } else { second }
        if !(expected is .Dropped) {
            return cx.branches_whole([self.on_true, other], [yes, no], expected) ?? cx
                .branches_met([self.on_true, other], [yes, no], expected)
        }
        if yes == null || no == null { null } else { owned_type("void") }
    }
}
