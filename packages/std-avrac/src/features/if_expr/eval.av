//! The evaluation rule: the condition decides, ONE branch runs —
//! the on-demand walk never touches the other.
use core.{Expr, ExprId}
use features.{EvalCx}

fn if_eval(cx: EvalCx, e: ExprId) -> ExprId {
    match cx.store.expr(e) {
        .If(c, t, f) -> {
            let cv = cx.value_at(c)
            let taken: bool? = match cx.store.expr(cv) {
                .BoolLit(b) -> b,
                _ -> null,
            }
            if taken == null { cx.fail("defect: a non-bool condition survived a clean analysis") }
            cx.value_at(if taken ?? true { t } else { f })
        }
        _ -> e,
    }
}
