// proves: a payload `is` binds in the then-branch alone — fresh and
// immutable, scoped to that arm — and the else reads the untested
// name. The elseless guard, a full payload list, `_` for an unread
// payload, and a binder shadowing an outer name all land.
enum Shape {
    Circle(int)
    Rect(int, int)
    Dot
}

fn area(s: Shape) -> int {
    if s is .Circle(r) { r * r * 3 } else if s is .Rect(w, h) { w * h } else { 0 }
}

fn rank(s: Shape) -> int {
    if s is .Circle(r) { return r }
    if s is .Rect(w, h) { return w + h }
    0
}

fn tagged(s: Shape) -> int {
    if s is .Rect(_, _) { 7 } else { 1 }
}

fn shadow(s: Shape, r: int) -> int {
    if s is .Circle(r) { r } else { r }
}

let circle = Shape.Circle(4)
let rect = Shape.Rect(3, 5)
let dot = Shape.Dot
"${area(circle)} ${area(rect)} ${area(dot)} ${rank(circle)} ${rank(rect)} ${tagged(rect)} ${tagged(dot)} ${shadow(circle, 100)} ${shadow(dot, 100)}"
