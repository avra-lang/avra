// proves: nested regions, branch-scoped releases, and the phi at every merge
let greeting = if 1 < 2 { "hello" } else { "bye" }
let n = if false { 10 } else { 20 }
// LICENSED if_expr.when_ladder: the nested `if` IS the subject under test, not the ladder
let tag = if n < 15 { "small" } else { if greeting == "hello" { "big-hello" } else { "big" } }
tag
