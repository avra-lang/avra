// proves: an `if` whose `else` is another `if`, as a value and as a statement: each condition read
// only once those before it failed, the first that holds taking the turn, a chain with no last
// `else` doing nothing past its conditions.
fn graded(n: int) -> string {
    if n > 90 { "a" } else if n > 70 { "b" } else if n > 50 { "c" } else { "f" }
}

fn kept(xs: List<int>) -> List<int> {
    mut out: List<int> = []
    for x in xs {
        if x < 0 {
            out.push(0)
        } else if x % 2 == 0 {
            out.push(x)
        } else if x > 10 {
            return out
        }
    }
    out
}

let k = kept([4, -3, 7, 8, 13, 6])
"${graded(95)}${graded(80)}${graded(60)}${graded(10)} ${k.length} ${k[0]} ${k[1]} ${k[2]}"
