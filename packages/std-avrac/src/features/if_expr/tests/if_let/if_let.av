// proves: `if let u? = e { } else { }` — the spec's bind-fresh form
// (Axis 10.4), pure sugar over the asking arms: the present branch
// binds a fresh immutable name, the absent branch answers, and the
// whole thing is an expression. The guard-and-bang ceremony retires.
type User = { age: int }

fn find_user(id: int) -> User? {
    if id == 7 { User { age: 30 } } else { null }
}

fn greeting(b: bool) -> string? {
    if b { "hello" } else { null }
}

let hit = match find_user(7) {
    u? -> { u.age * 2 }
    null -> { 0 - 1 }
}
let miss = match find_user(2) {
    u? -> { u.age }
    null -> { 0 - 5 }
}
let chained = match find_user(7)?.age {
    age? -> { age + 100 }
    null -> { 0 }
}
let worded = match greeting(true) {
    w? -> { w.length }
    null -> { 0 }
}
"hit ${hit} miss ${miss} chained ${chained} worded ${worded}"
