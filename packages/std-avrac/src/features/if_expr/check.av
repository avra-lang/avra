//! The typing rule: the condition is a `bool`; the branches must
//! agree, and their shared type is the expression's. An Error
//! anywhere ABSORBS — its cause was already diagnosed. A condition
//! that is a PRESENCE TEST on an effectively-final name narrows
//! that name inside the branch its truth proves: `!= null` the
//! then, `== null` the else — sugar over bind-fresh, never
//! load-bearing (spec 10.4).
use core.{ExprId, TypeId}
use features.{TypeCx, Asked, require_bool, spoken, types_disagree, join_of, accepts, this_is}
use diagnostics.{refusal}

fn if_type(cx: TypeCx, e: ExprId) -> TypeId {
    match cx.store.expr(e) {
        .If(c, t, f) -> {
            require_bool(cx, c, "an `if` condition", "this decides the branch")
            walk_branches(cx, c, t, f)
            branch_type(cx, t, f)
        }
        _ -> cx.error_type,
    }
}

/// Both branches typed — the PROVEN one under its narrow.
fn walk_branches(cx: TypeCx, c: ExprId, t: ExprId, f: ExprId) {
    let asked: Asked? = cx.ask_of(c)
    if asked == null {
        let _ = cx.walk_type(t)
        let _ = cx.walk_type(f)
        return
    }
    let a = asked!
    if a.on_present {
        let _ = cx.walk_narrowed(a.subject, t)
        let _ = cx.walk_type(f)
        return
    }
    let _ = cx.walk_type(t)
    let _ = cx.walk_narrowed(a.subject, f)
}

fn branch_type(cx: TypeCx, t: ExprId, f: ExprId) -> TypeId {
    if cx.shape_at(t) is .Error || cx.shape_at(f) is .Error { return cx.error_type }
    let joined: TypeId? = join_of(cx, cx.type_at(t), cx.type_at(f))
    if joined != null {
        let both = joined!
        let _ = accepts(cx, t, both)
        let _ = accepts(cx, f, both)
        return both
    }
    if types_disagree(cx, cx.type_at(t), cx.type_at(f)) {
        let n = cx.name_at(f)
        return spoken(cx, refusal("type.mismatch", cx.loc_of(f), "an `if`'s branches disagree: `${cx.name_at(t)}` vs `${n}`", this_is(n), null))
    }
    cx.type_at(t)
}
