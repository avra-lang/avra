//! The typing rule: the condition is a `bool`; the branches must
//! agree, and their shared type is the expression's. An Error
//! anywhere ABSORBS — its cause was already diagnosed. A condition
//! that is a PRESENCE TEST on an effectively-final name narrows
//! that name inside the branch its truth proves: `!= null` the
//! then, `== null` the else — sugar over bind-fresh, never
//! load-bearing (spec 10.4).
use core.{ExprId, TypeId}
use features.{TypeCx, Asked, this_is}
use diagnostics.{refusal}

fn if_type(mut cx: TypeCx, e: ExprId) -> TypeId {
    match cx.view.store.expr(e) {
        .If(c, t, f) -> {
            cx.require_bool(c, "an `if` condition", "this decides the branch")
            walk_branches(cx, c, t, f)
            let other? = f else { return cx.type(void) }
            if cx.view.store.statement_if(e) { return cx.type(void) }
            branch_type(cx, e, t, other)
        },
        _ -> cx.error_type,
    }
}

/// Both branches typed — the PROVEN one under its narrow.
fn walk_branches(mut cx: TypeCx, c: ExprId, t: ExprId, f: ExprId?) {
    let asked: Asked? = cx.ask_of(c)
    if asked == null {
        let _ = cx.walk_type(t)
        walk_other(cx, f, null)
        return
    }
    let a = asked!
    if a.on_present {
        let _ = cx.walk_narrowed(a.subject, t)
        walk_other(cx, f, null)
        return
    }
    let _ = cx.walk_type(t)
    walk_other(cx, f, a.subject)
}

/// The else side, when there is one — under the narrow its subject
/// proves, when it has one.
fn walk_other(mut cx: TypeCx, f: ExprId?, narrowed: ExprId?) {
    let other? = f else { return }
    let at? = narrowed else {
        let _ = cx.walk_type(other)
        return
    }
    let _ = cx.walk_narrowed(at, other)
}

/// The branches' one type. They JOIN when they can, and the seat's own
/// agreement door widens the join into what it wants (`if flag { card }
/// else { null }` answers `Card?` in a `Result<Card?, E>` seat); a
/// planted want judges them only where they cannot join among
/// themselves, which is where it is what each is BOXED into (`dyn
/// View` over a note and a badge). A branch that LEAVES answers nothing
/// and joins with anything, so the other answers for both.
fn branch_type(mut cx: TypeCx, e: ExprId, t: ExprId, f: ExprId) -> TypeId {
    if !cx.stays(t) { return cx.type_at(f) }
    if !cx.stays(f) { return cx.type_at(t) }
    if cx.errored(t) || cx.errored(f) { return cx.error_type }
    let joined: TypeId? = cx.join_of(cx.type_at(t), cx.type_at(f))
    if joined != null {
        let both = joined!
        let _ = cx.accepts(t, both)
        let _ = cx.accepts(f, both)
        return both
    }
    if cx.want_at(e) != null { return cx.arms_agree("type.mismatch", "an `if`'s branches", "the first branch", e, t, [f]) }
    if cx.types_disagree(cx.type_at(t), cx.type_at(f)) {
        let n = cx.name_at(f)
        return cx
            .spoken(
                refusal(
                    "type.mismatch",
                    cx.loc_of(f),
                    "an `if`'s branches disagree: `${cx.name_at(t)}` vs `${n}`",
                    this_is(n),
                    "make both branches answer one type — or declare the seat's type (`let x: T = if …`)",
                ),
            )
    }
    cx.type_at(t)
}
