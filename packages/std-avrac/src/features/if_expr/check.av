//! The typing rule: the condition is a `bool`; the branches must
//! agree, and their shared type is the expression's. An Error
//! anywhere ABSORBS — its cause was already diagnosed.
use core.{Expr, ExprId, Type, TypeId}
use features.{TypeCx, require_bool, spoken, types_disagree}
use diagnostics.{error_at, pointed}

fn if_type(cx: TypeCx, e: ExprId) -> TypeId {
    match cx.store.expr(e) {
        .If(c, t, f) -> {
            require_bool(cx, c, "an `if` condition", "this decides the branch")
            branch_type(cx, t, f)
        }
        _ -> cx.intern(Type.Error),
    }
}

fn branch_type(cx: TypeCx, t: ExprId, f: ExprId) -> TypeId {
    if cx.shape_at(t) is .Error || cx.shape_at(f) is .Error { return cx.intern(Type.Error) }
    if types_disagree(cx, cx.type_at(t), cx.type_at(f)) {
        let n = cx.name_at(f)
        return spoken(cx, pointed(
            error_at("type.mismatch", cx.loc_of(f),
                "an `if`'s branches disagree: `${cx.name_at(t)}` vs `${n}`"),
            "this is a `${n}`"))
    }
    cx.type_at(t)
}
