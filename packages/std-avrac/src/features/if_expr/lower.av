//! The lowering rule: the region as brackets in the flat list — each
//! branch lowers INSIDE them and names the register it yields; the
//! if's own register is the merge.
use core.{ExprId, Reg, Ins}
use features.{LowerCx}

fn if_lower(cx: LowerCx, e: ExprId) -> Reg {
    match cx.store.expr(e) {
        .If(c, t, f) -> {
            let cr = cx.reg_of(c)
            cx.emit(Ins.IfStart(cr))
            let tr = cx.reg_of(t)
            cx.emit(Ins.ArmEnd(tr))
            let fr = cx.reg_of(f)
            let dst = cx.result(e)
            cx.emit(Ins.RegionEnd(dst, fr))
            dst
        }
        _ -> cx.result(e),
    }
}
