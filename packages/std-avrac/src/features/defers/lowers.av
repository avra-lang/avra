//! The lowering rule of `defer` and `errdefer`: a body that is one call, every operand a scalar
//! literal or a name holding no counted reference, is that call lowered where the scope it stands in
//! ends or the fn leaves, each name reading what it held at the statement; any other body is the
//! lambda that is the statement's body boxed where the statement stands, its captures read now, and
//! the box called where that scope ends or the fn leaves.
use core.{
    Bound,
    DeferDecline,
    Declined,
    DeferredRun,
    ExprId,
    HeldName,
    Lowering,
    StmtId,
    StmtLowers,
    owned_type,
}
use core.stmt.{Defer}

impl StmtLowers for Defer {
    fn stmt_lowered(mut cx: Lowering, s: StmtId) {
        let ty? = cx.type_at(self.body) else { return cx.stmt_unlowered(s) }
        let answer = cx.laid_out(ty.answer ?? owned_type("void"))
        let run = in_place(cx, self.body) ?? DeferredRun.Boxed(cx.lower(self.body))
        cx.deferred(run, answer, self.on_error)
        cx.reshaped()
    }
}

/// The lambda `lam` run in place, its call's operands' names held as they stand now; absent where
/// its body is no call `in_place_operands` passes.
fn in_place(mut cx: Lowering, lam: ExprId) -> DeferredRun? {
    let body? = match cx.store.expr(lam) { .Lambda(_, body) -> body, _ -> null } else { return null }
    let operands = match in_place_operands(cx, body) {
        .Ok(o) -> o,
        .Err(why) -> {
            cx.declined(body, Declined.Defer(why))
            return null
        },
    }
    for a in operands {
        let why = moving(cx, a)
        if why != null {
            cx.declined(a, Declined.Defer(why!))
            return null
        }
    }
    mut held: List<HeldName> = []
    for a in operands {
        let name? = cx.store.ident_name(a) else { continue }
        let bound = cx.bound(name)!
        held.push(HeldName { name: name, b: Bound.Value(cx.held(bound), bound.type()) })
    }
    DeferredRun.InPlace(body, held)
}

/// The operands of `body` where it's a call of a fn the program declares, by name, or of a method a
/// type the program declares has: each argument, a method's receiver first. Why not for any other
/// body, and for a callee a seat of which a write reaches the caller through, or that takes a
/// `state` or `const` argument.
fn in_place_operands(cx: Lowering, body: ExprId) -> Result<List<ExprId>, DeferDecline> {
    match cx.store.expr(body) {
        .Call(callee, _, args) -> {
            if cx.bound(callee.text()) != null { return .Err(DeferDecline.NotOneCall) }
            let named? = cx.named(body, callee.text()) else { return .Err(DeferDecline.NotOneCall) }
            let f? = match named { .Fn(c) -> c, rest -> null } else { return .Err(DeferDecline.NotOneCall) }
            if f.params.is_empty() && !args.is_empty() { return .Err(DeferDecline.NotOneCall) }
            if f.params.any(it.mutable) { .Err(DeferDecline.CalleeWrites) } else { .Ok(args) }
        },
        .MethodCall(subject, name, args) -> {
            let ty? = cx.type_at(subject) else { return .Err(DeferDecline.NotOneCall) }
            let m? = cx.method(ty, name.of) else { return .Err(DeferDecline.NotOneCall) }
            if m.params.is_empty() && !args.is_empty() { return .Err(DeferDecline.NotOneCall) }
            if m.writes || m.params.any(it.mutable) { .Err(DeferDecline.CalleeWrites) } else { .Ok([subject].concat(args)) }
        },
        rest -> .Err(DeferDecline.NotOneCall),
    }
}

/// Why the operand `a` may not read at the exit what it read at the `defer` once its name is held;
/// absent for a scalar literal, or a name bound in the body whose value holds no counted reference,
/// so holding it keeps nothing alive. A `state` local is shared, never held.
fn moving(mut cx: Lowering, a: ExprId) -> DeferDecline? {
    match cx.store.expr(a) {
        .IntLit(_) or .BoolLit(_) or .FloatLit(_) -> null,
        .Ident(name) -> {
            let b? = cx.bound(name.text()) else { return DeferDecline.OperandComputed }
            match b {
                .Shared(_, _) or .OuterShared(_, _, _) -> DeferDecline.OperandShared,
                .Value(_, t) or .Const(_, t) or .Slot(_, t) or .Outer(_, t, _) or .Held(_, t) -> if cx.laid_out(t).counted() { DeferDecline.OperandCounted } else { null },
            }
        },
        rest -> DeferDecline.OperandComputed,
    }
}
