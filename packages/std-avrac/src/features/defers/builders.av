//! Parse-time lowering: the captured expression becomes a lambda of
//! no seats — the closure feature owns its captures, its lift and
//! its call convention — and the statement holds the lambda.
use core.{Expr, Stmt}
use features.{LangNode, Builder}

fn build_defer(mut b: Builder) -> Result<LangNode, string> {
    deferred(b, false)
}

fn build_errdefer(mut b: Builder) -> Result<LangNode, string> {
    deferred(b, true)
}

fn deferred(mut b: Builder, on_error: bool) -> Result<LangNode, string> {
    b.make_stmt(Stmt.Defer(b.expr_node(Expr.Lambda([], b.expr(0)?)), on_error))
}
