//! `defer e` — `e` runs when the enclosing scope ends or the fn
//! exits early, last-registered first: cleanup written beside the
//! thing it cleans. `errdefer e` runs only when the fn exits through
//! its failure channel (`fail`, or `?` passing a failure on). The
//! body takes a lambda's law — captures are copies at the statement
//! — and its answer is dropped, so a body answering a `Result` is
//! refused: nobody would hear it fail. A body that only names a
//! value is refused too: deferring it does nothing.
use features.{LanguageFeature}
// LICENSED modules.unused_import: `Fixed` and `Term` are named by GENERATED code, not by this
// file — a rule that states a payload writes a `Fixed` literal, and one that builds a node in
// place writes a `Term`. Resolve needs the names the source never spells.
use @std.grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Fixed, Term, Expect, Recover}
use diagnostics.{DiagCode}

export fn defers() -> LanguageFeature {
    let codes = table<DiagCode> {
        kind                     | summary
        "type.defer"             | "`defer` drops its body's answer — a `Result` there would fail unheard"
        "type.defer_inert"       | "`defer` runs a call or a block — a bare value does nothing"
        "type.errdefer"          | "`errdefer` runs when the enclosing fn fails, so it needs one that can"
        "flow.unbounded_cleanup" | "a waiting `defer` needs its own `within`"
    }
    LanguageFeature defers {
        gram: grammar {
            stmt = "defer" body:expression END @recover(sync_to: "END") -> Stmt.Defer(body = Expr.Lambda(body = body), on_error = false)
            stmt = "errdefer" body:expression END @recover(sync_to: "END") -> Stmt.Defer(body = Expr.Lambda(body = body), on_error = true)
        }
        diags: codes
    }
    defers
}
