// proves: a deferred body whose wait stands under a `within` that
// body writes is accepted and runs, last first.
use @std.time.{ms, secs, sleep}

extern fn avra_puts(s: string)

fn slow(n: int) -> int {
    sleep(ms(1))
    avra_puts("slow ${n}")
    n
}

fn quiet() -> int {
    sleep(ms(1))
    avra_puts("quiet")
    0
}

fn cleaned() -> int {
    defer { let _ = within secs(5) { slow(1) } }
    defer { let _ = within secs(5) { quiet() } }
    avra_puts("work")
    7
}

"${cleaned()}"
