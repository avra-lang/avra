//! The deferred statement's StmtSemantics: dispatch only. The lambda
//! is the statement's value — the closure feature walks and types
//! it; the laws live in check.av, the registration in lower.av.
use core.{StmtId, Reg, SyntaxArena}
use core.stmt.{Defer}
use features.{StmtSemantics, ResolveCx, TypeCx, LowerCx}

impl StmtSemantics for Defer {
    fn resolve_stmt(mut cx: ResolveCx, s: StmtId) { DeferSemantics {}.resolve_stmt(cx, s) }

    fn type_stmt(mut cx: TypeCx, s: StmtId) { DeferSemantics {}.type_stmt(cx, s) }

    fn lower_stmt(mut cx: LowerCx, s: StmtId) -> Reg? { DeferSemantics {}.lower_stmt(cx, s) }
}

export type DeferSemantics = {}

impl StmtSemantics for DeferSemantics {
    fn resolve_stmt(mut cx: ResolveCx, s: StmtId) {
        cx.walk_value(s)
    }

    fn type_stmt(mut cx: TypeCx, s: StmtId) {
        check_defer(cx, s)
    }

    fn lower_stmt(mut cx: LowerCx, s: StmtId) -> Reg? {
        lower_defer(cx, s)
    }
}

/// Whether the statement is an `errdefer` — run only by a failing
/// exit.
fn runs_on_error(store: SyntaxArena, s: StmtId) -> bool {
    // a feature matching its own variants
    match store.stmt(s) { .Defer(_, on_error) -> on_error, _ -> false }
}
