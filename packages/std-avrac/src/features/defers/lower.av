//! The lowering rule — the ONE meaning: the lambda's box is minted
//! where the statement stands (its captures copied now) and joins
//! the walk's frame, which calls it when the scope ends or the fn
//! exits. A body that is ONE call or ONE method call needs no box
//! when every argument, and a method's receiver, is a capture or a
//! scalar literal: they are read now — exactly what the captures
//! would copy — and the callee is called by name at every exit, its
//! answer settled by the frame it stands in like any value the frame
//! never reads again.
use core.{StmtId, ExprId, Reg, Type, TypeId, DeclId, is_literal}
use features.{LowerCx, DirectCall, bound_decl_of}

fn lower_defer(mut cx: LowerCx, s: StmtId) -> Reg? {
    let on_error = runs_on_error(cx.view.store, s)
    let call: DirectCall? = direct_call(cx, s)
    if call != null {
        cx.call_at_exit(call!, on_error)
        return null
    }
    let box? = cx.lower_value(s) else { return null }
    cx.at_exit(box, on_error)
    null
}

/// The deferred body as a call with its arguments in hand — null when
/// the body needs its box.
fn direct_call(mut cx: LowerCx, s: StmtId) -> DirectCall? {
    let lam? = cx.view.store.stmt_value(s) else { return null }
    let body? = cx.view.store.lambda_parts(lam)?.body else { return null }
    direct_free_call(cx, lam, body) ?? direct_method_call(cx, lam, body)
}

/// A FREE call: the callee bound by name, an extern one kept to a
/// void answer (its row's the only shape `run_direct` calls void),
/// a declared one free to answer anything — dropped either way.
fn direct_free_call(mut cx: LowerCx, lam: ExprId, body: ExprId) -> DirectCall? {
    let call? = cx.view.store.call_parts(body) else { return null }
    if !call.args.all(fixed_early(cx, it)) { return null }
    let d? = bound_decl_of(cx.names, body) else { return null }
    let seats? = cx.view.decls.sig(d)?.fn_sig()?.params else { return null }
    if seats.length != call.args.length { return null }
    let host: string? = cx.extern_callee(body)
    if host != null && !(cx.shape_at(body) is .Void) { return null }
    let captured = cx.capture_regs(lam)
    DirectCall { callee: host ?? cx.callee_of(body, call.callee), host: host != null, args: [fixed_now(cx, captured, a) for a in call.args], ret: cx.type_at(body) }
}

/// A METHOD call on the impl table: the receiver a capture, every
/// argument fixed early, its seats — self included — an exact match
/// with the written call, so no default seat is silently skipped.
fn direct_method_call(mut cx: LowerCx, lam: ExprId, body: ExprId) -> DirectCall? {
    let call? = cx.view.store.method_parts(body) else { return null }
    if cx.facts.wants_alias_copy(call.subject) || cx.facts.wants_thaw(call.subject) { return null }
    let j? = captured_at(cx, call.subject) else { return null }
    if !call.args.all(fixed_early(cx, it)) { return null }
    let m? = declared_method(cx, cx.type_at(call.subject), call.name) else { return null }
    let seats? = cx.view.decls.sig(m)?.fn_sig()?.params else { return null }
    if seats.length != 1 + call.args.length { return null }
    let captured = cx.capture_regs(lam)
    DirectCall { callee: cx.method_symbol(m, body, cx.type_at(call.subject)), host: false, args: [captured[j]].concat([fixed_now(cx, captured, a) for a in call.args]), ret: cx.type_at(body) }
}

/// The impl table's method for a concrete receiver — a struct, enum
/// or generic instance — provided no fn-typed FIELD of the same name
/// answers first. A feature cannot reach across for `impls/callee.av`'s
/// own `declared`/`fn_field`, so their one precedence a struct
/// receiver can hit is held here too.
fn declared_method(cx: LowerCx, ty: TypeId, name: string) -> DeclId? {
    let d? = declaring_decl(cx.view.types.shape_of(ty)) else { return null }
    if fn_typed_field(cx, ty, name) { return null }
    cx.view.decls.method(d, name)
}

fn declaring_decl(sh: Type) -> DeclId? {
    match sh {
        .Struct(d, _) or .Enum(d, _) or .App(d, _, _) -> d,
        .TypeName(_, _) or .Var(_, _, _) or .Dyn(_, _) or .Int or .Float or .Bytes or .Bool or .Str or .Ptr or .List(_) or .Cell(_) or .Task(_) or .Tasks or .Map(_, _) or .Res(_, _) or .Fn(_, _, _) or .Opt(_) or .Null or .EmptyList or .EmptyMap or .Error or .Void -> null,
    }
}

fn fn_typed_field(cx: LowerCx, ty: TypeId, name: string) -> bool {
    let sig? = cx.view.decls.fields_of_type(ty) else { return false }
    let slot? = sig.slot_of(name) else { return false }
    cx.view.types.shape_of(sig.types[slot]) is .Fn
}

/// An argument read the same at the `defer` as at the exit: a
/// capture — the value a lambda would copy, MANAGED or not — or a
/// scalar literal; never a place the alias-copy or thaw law would
/// open unique or fresh, since that opening happens where `reg_of`
/// reads it, and this path never calls it.
fn fixed_early(cx: LowerCx, a: ExprId) -> bool {
    if cx.facts.wants_alias_copy(a) || cx.facts.wants_thaw(a) { return false }
    captured_at(cx, a) != null || scalar(cx.shape_at(a)) && is_literal(cx.view.store.expr(a))
}

/// The capture an argument reads, by its place in the lambda's list.
fn captured_at(cx: LowerCx, a: ExprId) -> int? {
    let b? = cx.names.binding(a) else { return null }
    match b {
        .Capture(_, j) -> j,
        _ -> null,
    }
}

fn scalar(t: Type) -> bool {
    match t {
        .Int or .Bool or .Float -> true,
        _ -> false,
    }
}

/// An argument's register at the `defer`: the literal's, or the
/// captured binding's.
fn fixed_now(mut cx: LowerCx, captured: List<Reg>, a: ExprId) -> Reg {
    let j? = captured_at(cx, a) else { return cx.reg_of(a) }
    captured[j]
}
