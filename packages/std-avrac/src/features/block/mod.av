//! `{ statements… value }` — a scope as an expression, defined ONCE
//! and borrowed by every construct with braces. The inline form
//! passes through: a one-expression block costs no node, so every
//! one-line fn and if keeps its exact tree. The multi-line form
//! arrives by deferred commitment.
use features.{LanguageFeature}
use @std.grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
export fn block() -> LanguageFeature {
    LanguageFeature block {
        gram: grammar {
            block = "{" ( stmts:stmt | BREAK )* "}" @expect("}", "expected `}` to close the block") -> Expr.Block by block_written
        }
    }
    // LICENSED compiler.duplicated_message: grammar TEXT — both branches need the message inline
    block
}
