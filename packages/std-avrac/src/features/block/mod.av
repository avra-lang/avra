//! `{ statements… value }` — a scope as an expression, defined ONCE
//! and borrowed by every construct with braces. The inline form
//! passes through: a one-expression block costs no node, so every
//! one-line fn and if keeps its exact tree. The multi-line form
//! arrives by deferred commitment.
use features.{LanguageFeature, BuilderRow}
use grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}

export fn block() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name    | build
        "block" | build_block
    }
    component LanguageFeature f {
        name = "block"
        docs = "`{ <statements> <expression> }`; the last expression is the value."
        gram = grammar {
            block = "{" ( s:stmt | BREAK )* "}" @expect("}", "expected `}` to close the block") -> block(s)
        }
        builders = rows
    }
    // LICENSED I11: grammar TEXT — both branches need the message inline
    f
}
