//! The lowering rule of a block: a scope of its own holding its statements, its value its tail's.
use core.{ExprId, Lowering, Lowers, Reg, owned_type}
use core.expr.{Block}

impl Lowers for Block {
    /// A block's value is lifted where the block stands, so its tail is read as it's born.
    /// A block holding only its value is that value. Any other is a scope: its statements in order,
    /// then its tail's value, or where it ends in a statement, nothing of the type it ends as: where it
    /// leaves, a hollow a region it is an arm of answers in its own layout, else `void`.
    fn lowered(mut cx: Lowering, e: ExprId) -> Reg {
        let lead = cx.store.lead_of(e)
        let tail = cx.store.tail_of(e)
        if lead.is_empty() && tail != null { return cx.born(tail!) }
        cx.scope_enter()
        cx.opened()
        cx.lets_written(lead, e)
        for s in lead { cx.lower_stmt(s) }
        let r = answered(cx, e, tail)
        cx.closed_giving(r)
        cx.scope_exit(r)
        r
    }
}

/// What the block `e` answers past its statements: its tail's value, else a hollow nobody reads — the
/// one a region it is an arm of answers in its own layout where it leaves, else `void`'s.
fn answered(mut cx: Lowering, e: ExprId, tail: ExprId?) -> Reg {
    let t? = tail else {
        return when {
            cx.store.leaves(e) -> cx.left_hollow()
            _ -> cx.hollow_of(owned_type("void"))
        }
    }
    cx.born(t)
}
