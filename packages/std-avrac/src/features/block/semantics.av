//! The block's NodeSemantics: a CONTROL-OWNING node — kids() is
//! empty and every pass recurses through its driver capability, so
//! the scope discipline (binding order, frames, releases) stays
//! with the drivers that own it.
use core.{ExprId, TypeId, Reg, some_list}
use features.{NodeSemantics, ResolveCx, TypeCx, LowerCx, nothing, Meaning}

use core.expr.{Block}

impl NodeSemantics for Block {
    fn heirs() -> List<ExprId> { some_list(self.value) }
}

impl Meaning for Block {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        cx.block_scope(self.stmts, self.value)
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        cx.block_type(self.stmts, self.value)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        cx.lower_block(self.stmts, self.value, cx.type_at(e))
    }
}
