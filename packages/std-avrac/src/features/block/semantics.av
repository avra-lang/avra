//! The block's NodeSemantics: a CONTROL-OWNING node — kids() is
//! empty and every pass recurses through its driver capability, so
//! the scope discipline (binding order, frames, releases) stays
//! with the drivers that own it.
use core.{Expr, ExprId, TypeId, Reg, some_list}
use features.{NodeSemantics, ResolveCx, TypeCx, LowerCx, nothing, foreign_node}

export type BlockSemantics = { }

impl NodeSemantics for BlockSemantics {
    fn kids(self, e: Expr) -> List<ExprId> {
        []
    }

    fn heirs(self, e: Expr) -> List<ExprId> {
        // LICENSED I22: a feature cannot enumerate OTHER features' variants
        match e {
            .Block(_, value) -> some_list(value),
            _ -> [],
        }
    }

    fn resolve(self, cx: ResolveCx, e: ExprId) {
        match cx.view.store.expr(e) {
            .Block(stmts, value) -> cx.block_scope(stmts, value),
            _ -> nothing(),
        }
    }

    fn type_of(self, cx: TypeCx, e: ExprId) -> TypeId {
        match cx.view.store.expr(e) {
            .Block(stmts, value) -> cx.block_type(stmts, value),
            _ -> cx.error_type,
        }
    }

    fn lower(self, cx: LowerCx, e: ExprId) -> Reg {
        match cx.view.store.expr(e) {
            .Block(stmts, value) -> cx.lower_block(stmts, value, cx.type_at(e)),
            _ -> foreign_node(cx, e),
        }
    }

}
