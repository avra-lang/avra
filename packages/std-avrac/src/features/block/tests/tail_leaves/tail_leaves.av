// proves: a block whose tail is a leaving block leaves too — an arm ending in `{ fail … }` merges as the region's own type
type Miss = { at: string }

enum Show { All, Done }

fn pick(tag: string) -> Result<Show, Miss> {
    if tag == "Done" {
        Show.Done
    } else {
        {
            fail Miss { at: tag }
        }
    }
}

fn word(r: Result<Show, Miss>) -> string {
    match r { .Ok(.Done) -> "done", .Ok(_) -> "other", .Err(e) -> "no ${e.at}" }
}

word(pick("Done")) + " " + word(pick("x"))
