//! The typing rule of a block word's body: a text body (an interpolated string) is a `string`, its
//! holes checked for what they are; any other is another language's text, so only its holes are
//! this body's expressions, and what it is isn't named here.
use core.{BodyBehavior, Checking, Checks, ExprId, Expected, SignedType, body_behavior, owned_type}
use core.expr.{Body}

impl Checks for Body {
    fn checked(mut cx: Checking, e: ExprId, expected: Expected) -> SignedType? {
        cx.checked_free(self.holes)
        match body_behavior(self.word) { .Text -> owned_type("string"), .Quote or .Foreign -> null }
    }
}
