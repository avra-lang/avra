//! The typing rule of a block word's body: another language's text, so only its holes are this
//! body's expressions.
use core.{Checking, Checks, ExprId, Expected, SignedType}
use core.expr.{Body}

impl Checks for Body {
    fn checked(mut cx: Checking, e: ExprId, expected: Expected) -> SignedType? {
        cx.checked_free(self.holes)
        null
    }
}
