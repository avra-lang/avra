//! THE READS OVER FACTS — one definition each, crossing values
//! (a type's fields ask the declaration table; a name's declaration
//! asks the namespace) — and the CONTEXTS' vocabularies: every
//! method a feature's rule calls on a TypeCx, LowerCx or statement
//! context forwards from here to the one definition.
use core.{Expr, int_of, text_of, bool_of, FileId, DeclId, StmtId, ExprId, TypeId, PatId, Type, NodeStore, TypeRegistry, Binding, Param, filled, Reg, Ins, dst_of, rt_sig_of, same_stmt, same_expr, same_decl}
use diagnostics.{SourceFile, DiagCode, Diag, Voices, no_voices, loc_at, refusal, defect_at}
use @std.errors.{Loc}

/// A record's fields, the declaration's or the instantiation's.
export fn fields_of_type(decls: Decls, ty: TypeId) -> StructSig? {
    match decls.types.shape_of(ty) {
        .Struct(decl, _) -> record_sig_of(decls.sig(decl)),
        .App(decl, _, args) -> subbed_fields(decls.types, record_sig_of(decls.sig(decl)), decl, args),
        .Ptr or .Int or .Str or .Bool or .List(_) or .Enum(_, _) or .Res(_, _) or
        .TypeName(_, _) or .Var(_, _, _) or .Dyn(_, _) or .Fn(_, _) or .Opt(_) or .Null or .EmptyList or
        .Error or .Void or .Map(_, _) or .EmptyMap -> null,
    }
}

/// An enum's variants, the declaration's, a Result's, or the
/// instantiation's.
export fn variants_of_type(decls: Decls, ty: TypeId) -> EnumSig? {
    match decls.types.shape_of(ty) {
        .Enum(decl, _) -> variant_sig_of(decls.sig(decl)),
        .Res(ok, err) -> res_enum_sig(ok, err),
        .App(decl, _, args) -> subbed_variants(decls.types, variant_sig_of(decls.sig(decl)), decl, args),
        .Ptr or .Int or .Str or .Bool or .List(_) or .Struct(_, _) or
        .TypeName(_, _) or .Var(_, _, _) or .Dyn(_, _) or .Fn(_, _) or .Opt(_) or .Null or .EmptyList or
        .Error or .Void or .Map(_, _) or .EmptyMap -> null,
    }
}

/// The declaration a call's name stands for, when it is one.
export fn bound_decl_of(names: NameFacts, e: ExprId) -> DeclId? {
    let b: Binding? = names.binding(e)
    if b == null { return null }
    match b! {
        .Decl(d) -> d,
        .Def(_) -> null,
        .Param(_) or .Receiver or .Pattern(_, _) or .LambdaParam(_, _) or .Capture(_, _) or .Index(_) -> null,
    }
}

/// A call's declared signature, when its name is a declared fn.
export fn sig_of_at(names: NameFacts, decls: Decls, e: ExprId) -> FnSig? {
    let d: DeclId? = bound_decl_of(names, e)
    if d == null { return null }
    fn_sig_of(decls.sig(d!))
}

/// The seats a fn declares: its written params minus a BARE
/// keyword — the old receiver habit (`fn get()`), refused by
/// the naming law and given no seat, so the one refusal stands
/// alone and the call's arity still counts.
export fn written_seats(keywords: List<string>, params: List<Param>) -> List<Param> {
    [pp for pp in params if takes_a_seat(keywords, pp)]
}

fn takes_a_seat(keywords: List<string>, pp: Param) -> bool {
    pp.ty != null || !keywords.contains(pp.name)
}

/// Whether a name reads a `mut` binding.
export fn is_mut_at(names: NameFacts, store: NodeStore, e: ExprId) -> bool {
    let b: Binding? = names.binding(e)
    if b == null { return false }
    match b! {
        .Def(s) -> store.stmt(s) is .MutLet,
        // a method's receiver is a place: a write through it is what
        // makes the method a writing one (ROADMAP: the inout receiver)
        .Receiver -> true,
        // a `mut` seat is a place the fn was handed to write
        .Param(_) -> names.reads_mut_seat(e),
        .Decl(_) or .Pattern(_, _) or .LambdaParam(_, _) or .Capture(_, _) or .Index(_) -> false,
    }
}

/// The declaration a type name stands for, in the file's namespace.
export fn type_named(names: NameFacts, name: string) -> DeclId? {
    let d: DeclId? = names.names.types.get(name)
    d
}

/// The trait a name stands for, in the file's namespace.
export fn trait_named(decls: Decls, names: NameFacts, name: string) -> DeclId? {
    let d: DeclId? = names.names.types.get(name)
    if d == null || !decls.is_trait(d!) { return null }
    d
}

/// The impl table's answer — a sig whose params[0] is `self`.
export fn method_sig_of(decls: Decls, target: DeclId, mname: string) -> FnSig? {
    let m: DeclId? = decls.method(target, mname)
    if m == null { return null }
    fn_sig_of(decls.sig(m!))
}

/// A trait method's sig — self OMITTED — or absence, the trait by
/// its name in this file's scope.
export fn trait_sig_of(decls: Decls, names: NameFacts, tname: string, mname: string) -> FnSig? {
    let decl: DeclId? = trait_named(decls, names, tname)
    if decl == null { return null }
    trait_sig_under(decls, decl!, mname)
}

/// A trait method's sig under the trait's DECLARATION — what a
/// `dyn` carries, so a contract dispatches wherever it travels.
export fn trait_sig_under(decls: Decls, tdecl: DeclId, mname: string) -> FnSig? {
    let f: DeclId? = trait_member(decls, tdecl, mname)
    if f == null { return null }
    fn_sig_of(decls.sig(f!))
}

/// A trait's member DECLARATION by name — the contract's own word
/// on its receiver and seats lives there.
export fn trait_member(decls: Decls, tdecl: DeclId, mname: string) -> DeclId? {
    let f: DeclId? = decls.trait_fns(tdecl).find(decl_named(decls, it, mname))
    f
}

/// Whether a type registered an impl for the trait — and a `dyn` of
/// the very trait implements it BY CONSTRUCTION.
export fn implements_of(types: TypeRegistry, decls: Decls, names: NameFacts, ty: TypeId, tname: string) -> bool {
    let worn: string? = dyn_contract(types.shape_of(ty))
    if worn != null { return worn! == tname }
    let d: DeclId? = declared_decl(types.shape_of(ty))
    let tr: DeclId? = trait_named(decls, names, tname)
    if d == null || tr == null { return false }
    decls.implements(d!, tr!)
}

export fn dyn_contract(sh: Type) -> string? {
    match sh {
        .Dyn(_, n) -> n,
        _ -> null,
    }
}

/// A declared type's DECLARATION, when its shape carries one —
/// the impl table's key. Generic receivers wait for T2.
export fn declared_decl(sh: Type) -> DeclId? {
    match sh {
        .Struct(d, _) -> d,
        .Enum(d, _) -> d,
        .Ptr or .Int or .Str or .Bool or .List(_) or .Opt(_) or .Null or
        .Res(_, _) or .Var(_, _, _) or .App(_, _, _) or .Dyn(_, _) or .Fn(_, _) or
        .TypeName(_, _) or .EmptyList or .Error or .Void or .Map(_, _) or .EmptyMap -> null,
    }
}

/// A declaration read as a value: a type's name, or a fn worn as a
/// value (a generic fn wears no single signature).
export fn decl_type_of(decls: Decls, voices: Voices, error_type: TypeId, d: DeclId) -> TypeId {
    let tname: string? = decls.type_name(d)
    if tname != null { return decls.types.intern(Type.TypeName(d, tname!)) }
    if !decls.tparams(d).is_empty() {
        voices.speak(not_a_value(decls, d))
        return error_type
    }
    let sig: FnSig? = fn_sig_of(decls.sig(d))
    if sig == null { return error_type }
    decls.types.intern(Type.Fn(sig!.params, sig!.ret))
}

/// What a `let`/`mut` binding holds: its declared type, its value's
/// type, or — for a loop's counter — int.
export fn def_type_of(facts: TypeFacts, store: NodeStore, types: TypeRegistry, error_type: TypeId, s: StmtId) -> TypeId {
    // A CONST FIRST, AND ONLY: it is read from OTHER bodies, and a
    // body's facts hold only its own range — so a const's type is
    // the program's answer or the HOLE. Falling through would index
    // the asker's table with another body's expression (-1).
    if store.const_value(s) != null { return settled_type(store, types, s) ?? error_type }
    let declared: TypeId? = facts.declared_binding(s)
    if declared != null { return declared! }
    if store.stmt(s) is .For { return types.intern(Type.Int) }
    let v: ExprId? = store.stmt_value(s)
    if v == null { return error_type }
    facts.type_at(v!)
}

/// The type a const wears: its settled value's own shape, wrapped
/// when the annotation asks for absence. Read from the store alone
/// — the value and the written type are all a const's type needs,
/// and both are the program's, not a body's.
fn settled_type(store: NodeStore, types: TypeRegistry, s: StmtId) -> TypeId? {
    let v: ExprId? = store.const_value(s)
    if v == null { return null }
    let word: Type? = literal_shape(store.expr(v!))
    if word == null { return null }
    let held = types.intern(word!)
    if store.binding_ty(s)?.optional ?? false { return types.intern(Type.Opt(held)) }
    held
}

/// The shape a literal wears.
fn literal_shape(value: Expr) -> Type? {
    if int_of(value) != null { return Type.Int }
    if text_of(value) != null { return Type.Str }
    if bool_of(value) != null { return Type.Bool }
    null
}

/// A type under a body's instantiation — IDENTITY for a plain body.
export fn viewed(types: TypeRegistry, sub: Sub?, ty: TypeId) -> TypeId {
    if sub == null { return ty }
    types.substituted(ty, sub!.target, sub!.args)
}

// ── The contexts' reads: forwards to the one definition ──

impl TypeCx {
    fn type_at(e: ExprId) -> TypeId { self.facts.type_at(e) }
    fn shape_at(e: ExprId) -> Type { self.view.types.shape_of(self.type_at(e)) }
    fn name_at(e: ExprId) -> string { self.view.types.name_of(self.type_at(e)) }
    fn loc_of(e: ExprId) -> Loc? { self.view.loc_of(e) }
    fn stmt_loc(s: StmtId) -> Loc? { self.view.stmt_loc(s) }
    fn emit(d: Diag) { self.facts.speak(d) }
    fn stmt_sig(s: StmtId) -> FnSig? {
        let d: DeclId? = self.view.decls.decl_of(self.view.file, s)
        if d == null { return null }
        fn_sig_of(self.view.decls.sig(d!))
    }
    fn bound_decl(e: ExprId) -> DeclId? { bound_decl_of(self.names, e) }
    fn tparams(d: DeclId) -> List<string> { self.view.decls.tparams(d) }
    fn tbounds(d: DeclId) -> List<Param> { self.view.decls.tbounds(d) }
    fn sig_of(e: ExprId) -> FnSig? { sig_of_at(self.names, self.view.decls, e) }
    fn fields_of(ty: TypeId) -> StructSig? { fields_of_type(self.view.decls, ty) }
    fn variants_of(ty: TypeId) -> EnumSig? { variants_of_type(self.view.decls, ty) }
    fn method_sig(target: DeclId, mname: string) -> FnSig? { method_sig_of(self.view.decls, target, mname) }
    fn trait_sig(tname: string, mname: string) -> FnSig? { trait_sig_of(self.view.decls, self.names, tname, mname) }
    fn implements(ty: TypeId, tname: string) -> bool { implements_of(self.view.types, self.view.decls, self.names, ty, tname) }
    fn is_mut(e: ExprId) -> bool { is_mut_at(self.names, self.view.store, e) }
    fn def_type(s: StmtId) -> TypeId { def_type_of(self.facts, self.view.store, self.view.types, self.error_type, s) }
    fn bind_types(v: ExprId, tys: List<TypeId>) { self.facts.bind_types(v, tys) }
    fn pat_loc(p: PatId) -> Loc? { self.view.pat_loc(p) }
    fn widen(v: ExprId, ty: TypeId) { self.facts.widen(v, ty) }
    fn record_ask(e: ExprId, subject: ExprId, on_present: bool) { self.facts.record_ask(e, subject, on_present) }
    fn ask_of(e: ExprId) -> Asked? { self.facts.ask_of(e) }
    fn record_subst(e: ExprId, target: DeclId, targs: List<TypeId>) { self.facts.record_subst(e, target, targs) }
    fn record_binding(s: StmtId, ty: TypeId) { self.facts.record_binding(s, ty) }
    fn mark_borrow(s: StmtId) { self.facts.mark_borrow(s) }
    fn want_at(e: ExprId) -> TypeId? { self.facts.want_at(e) }
    fn narrowed_at(e: ExprId) -> TypeId? { self.facts.narrowed_at(e) }
    fn starved_at(e: ExprId) -> TypeId? { self.facts.starved_at(e) }
    fn go_hungry(e: ExprId) { self.facts.go_hungry(e) }
    fn absorb_hunger(e: ExprId) { self.facts.absorb_hunger(e) }
    fn starve(e: ExprId, want: TypeId) -> bool { self.facts.starve(e, want) }
}

impl LowerCx {
    fn viewed(ty: TypeId) -> TypeId { viewed(self.view.types, self.sub, ty) }
    fn type_at(e: ExprId) -> TypeId { self.viewed(self.facts.type_at(e)) }
    fn shape_at(e: ExprId) -> Type { self.view.types.shape_of(self.type_at(e)) }
    fn result(e: ExprId) -> Reg { self.out.mint_ty(self.type_at(e)) }
    fn mint_like(r: Reg) -> Reg { self.out.mint_ty(self.out.type_of_reg(r)) }
    fn mint_shape(sh: Type) -> Reg { self.out.mint_ty(self.view.types.intern(sh)) }
    fn mint_ty(ty: TypeId) -> Reg { self.out.mint_ty(ty) }
    fn emit(i: Ins) { self.out.give(i) }
    fn fail(msg: string) { self.out.record(msg) }
    fn defect(what: string) { self.out.defect(what) }
    fn enclosing_ret() -> TypeId? { self.fn_ret }

    /// A call's target: the bound declaration's body as instantiated
    /// here — or the name itself, a run-time fn's.
    /// The host symbol a call names, when its callee is extern.
    fn extern_callee(e: ExprId) -> string? {
        let d: DeclId? = bound_decl_of(self.names, e)
        if d == null || !self.view.decls.is_extern(d!) { return null }
        self.view.decls.symbol(d!)
    }
    fn callee_of(e: ExprId, name: string) -> string {
        let d: DeclId? = bound_decl_of(self.names, e)
        if d == null { return name }
        self.symbol_at(d!, e)
    }
    fn fields_at(e: ExprId) -> StructSig? { fields_of_type(self.view.decls, self.type_at(e)) }
    fn fields_of(ty: TypeId) -> StructSig? { fields_of_type(self.view.decls, ty) }
    fn variants_at(e: ExprId) -> EnumSig? { variants_of_type(self.view.decls, self.type_at(e)) }
    fn variants_of(ty: TypeId) -> EnumSig? { variants_of_type(self.view.decls, ty) }
    fn bind_patterns(v: ExprId, regs: List<Reg>) { self.body.bind_patterns(v, regs) }
    /// A `mut` binding's cell, when the binding lives in one.
    fn cell_of(e: ExprId) -> Reg? {
        let b: Binding? = self.names.binding(e)
        if b == null { return null }
        match b! {
            .Def(s) -> if self.body.is_boxed(s) { self.body.slot_of(s) } else { null },
            .Decl(_) or .Param(_) or .Receiver or .Pattern(_, _) or .LambdaParam(_, _) or .Capture(_, _) or .Index(_) -> null,
        }
    }
}

impl StmtLowerCx {
    fn bind_slot(s: StmtId, cell: Reg) { self.expr.body.bind_slot(s, cell) }
    fn bind_index(s: StmtId, r: Reg) { self.expr.body.bind_index(s, r) }
}

// ── voices ──

fn not_a_value(decls: Decls, d: DeclId) -> Diag {
    refusal("type.lambda", decls.loc(d), "a generic fn is not a value — no single signature to wear", "declared here", "wrap it — `(x: T0) -> ${decls.fn_name(d) ?? "f"}(x)` with the types pinned")
}

/// Two bindings name the same thing — the identity every seat law
/// compares roots by.
export fn same_binding(a: Binding, b: Binding) -> bool {
    match a {
        .Param(i) -> match b { .Param(k) -> i == k, _ -> false },
        .Receiver -> b is .Receiver,
        .Def(s) -> match b { .Def(t) -> same_stmt(s, t), _ -> false },
        .Pattern(v, j) -> match b { .Pattern(w, k) -> same_expr(v, w) && j == k, _ -> false },
        .LambdaParam(l, i) -> match b { .LambdaParam(m, k) -> same_expr(l, m) && i == k, _ -> false },
        .Capture(l, j) -> match b { .Capture(m, k) -> same_expr(l, m) && j == k, _ -> false },
        .Index(s) -> match b { .Index(t) -> same_stmt(s, t), _ -> false },
        .Decl(d) -> match b { .Decl(e) -> same_decl(d, e), _ -> false },
    }
}

/// A declared type's INSTANCE type — what its impl's receiver wears:
/// the record or enum itself, applied to its own Vars when generic.
export fn self_type_of(decls: Decls, d: DeclId) -> TypeId {
    let name = decls.decl(d).name
    let vars = instance_vars(decls, d)
    if !vars.is_empty() { return decls.types.intern(Type.App(d, name, vars)) }
    if decls.is_enum(d) { return decls.types.intern(Type.Enum(d, name)) }
    decls.types.intern(Type.Struct(d, name))
}

/// A generic declaration's own Vars, under the names it declared —
/// `impl Arena<N>` spells them as `type Arena<N>` did.
export fn instance_vars(decls: Decls, d: DeclId) -> List<TypeId> {
    mut out: List<TypeId> = []
    // LICENSED I3: the ordinal names the Var; a paired comprehension is our own sugar backlog
    for j, n in decls.tparams(d) { out.push(decls.types.intern(Type.Var(d, j, n))) }
    out
}
