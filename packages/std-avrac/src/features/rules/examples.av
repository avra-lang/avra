//! `@fixes("before", "after")` and `@keeps("still")` — a rule's
//! examples: recognised by NAME, like `@derive`, and read straight
//! from their WRITTEN arguments (source-spelled, never lifted — a
//! rule's own annotations are read before this file's names, let
//! alone the evaluator, exist). Never stored: cheap to re-derive
//! from the statement's own annotations, so `avra explain` and the
//! suite's case generator both call `examples_of` directly.
use core.{StmtId, Annotation, NodeStore, flatten}

/// One example a rule's annotations name — `avra test`'s case, and
/// `avra explain`'s before/after.
export enum Example {
    Fixes(before: string, after: string)
    Keeps(before: string)
}

/// Whether an annotation's NAME is one this door recognises — asked
/// before the general call law, since neither name resolves to a
/// declared fn (there is no `fn fixes`, no `fn keeps`).
export fn example_marks(name: string) -> bool {
    name == "fixes" || name == "keeps"
}

/// Every example a rule's `@fixes`/`@keeps` annotations name, in
/// written order — silently skipping one whose shape `checked_examples`
/// already refused, so a caller never sees a malformed example.
export fn examples_of(store: NodeStore, s: StmtId) -> List<Example> {
    flatten([one_example(store, a) for a in store.annotations_of(s) if example_marks(a.name)])
}

fn one_example(store: NodeStore, a: Annotation) -> List<Example> {
    let texts = [store.expr(e).text_of() for e in a.args]
    if texts.any(it == null) { return [] }
    let words = [t! for t in texts]
    match a.name {
        "fixes" if words.length == 2 -> [Example.Fixes(words[0], words[1])],
        "keeps" if words.length == 1 -> [Example.Keeps(words[0])],
        rest -> [],
    }
}
