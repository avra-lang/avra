//! The rule's own laws: at least one written arm, and every arm's
//! value answers the rule's declared `Fix?` — the widen door
//! (`checks.av`'s `other_accepts`) is where a `quote` answering
//! `Code` lifts into `Fix.Rewrite`, exactly as auto-Ok lifts a bare
//! value into its `Result`.
use core.{ExprId, TypeId, StmtId, DeclId, Arm, NodeStore, Annotation, flatten, some_list}
use features.{TypeCx, nothing, bound_decl_of}
use diagnostics.{refusal, Diag}
use @std.errors.{Loc}

export fn check_rule(mut cx: TypeCx, s: StmtId) {
    match cx.view.store.stmt(s) {
        .Rule(name, arms, body) -> checked_rule(cx, s, name.of, arms, body),
        rest -> nothing(),
    }
}

fn checked_rule(mut cx: TypeCx, s: StmtId, rname: string, arms: List<Arm>, body: ExprId) {
    if arms.is_empty() { cx.emit(no_arms(cx.stmt_loc(s), rname)) }
    checked_examples(cx, s, rname)
    let want: TypeId = cx.stmt_sig(s)?.ret ?? cx.error_type
    // The declared `Fix?` plants the want before the arms walk — a
    // rule's synthesized `Match` is otherwise an ordinary one, and an
    // ordinary fn body takes the same channel (fns/check.av's
    // `checked_fn`): each arm is judged, and may WIDEN — a bare
    // `quote` into `.Rewrite` — against the want directly, instead of
    // joining the arms bottom-up and reconciling after.
    cx.plant_want(body, want)
    cx.walk_under(s, body)
    // A MEMBER CANNOT READ ITS OWN COLLECTION WHILE COMPILING
    // (docs/2026_09_22_COLLECTIONS.md §4.2) — a cycle: `rules`'
    // value is this rule's OWN synthesis, not yet built while this
    // rule's own body is what is being typed.
    let cycled: DeclId? = self_collection_read(cx, body)
    if cycled != null { cx.emit(self_read(cx.stmt_loc(s), rname, cx.view.decls.decl(cycled!).name)) }
}

/// A collect keyed to THIS declaration's own kind, read by name.
fn self_collection_read(cx: TypeCx, root: ExprId) -> DeclId? {
    flatten([some_list(bound_decl_of(cx.names, node)) for node in cx.view.store.every_expr(root)]).find(rule_collect(cx, it))
}

fn rule_collect(cx: TypeCx, d: DeclId) -> bool {
    let x = cx.view.decls.decl(d)
    if !(x.kind is .Collect) { return false }
    let p? = cx.view.decls.store_of(x.file).collect_parts(x.stmt) else { return false }
    p.kind is .Rule
}

/// A rule proves itself against at least one `@fixes`/`@keeps`, each
/// exactly the words it claims — two string literals, or one; never
/// a computed argument, since these are read before this file's own
/// names resolve.
fn checked_examples(mut cx: TypeCx, s: StmtId, rname: string) {
    let anns = [a for a in cx.view.store.annotations_of(s) if example_marks(a.name)]
    if anns.is_empty() { cx.emit(no_examples(cx.stmt_loc(s), rname)) }
    for a in anns {
        if !example_shaped(cx.view.store, a) { cx.emit(bad_example_shape(cx.loc_of(a.callee), rname)) }
    }
}

fn example_shaped(store: NodeStore, a: Annotation) -> bool {
    let want = if a.name == "fixes" { 2 } else { 1 }
    a.args.length == want && a.args.all((e: ExprId) -> store.expr(e).text_of() != null)
}

fn arm_answers(mut cx: TypeCx, a: Arm, want: TypeId) -> bool {
    cx.errored(a.value) || cx.accepts(a.value, want)
}

fn rewiden_miss(mut cx: TypeCx, body: ExprId, opt_want: TypeId) {
    let tail? = last_arm_value(cx.view.store, body) else { return }
    let _ = cx.accepts(tail, opt_want)
}

fn last_arm_value(store: NodeStore, body: ExprId) -> ExprId? {
    match store.expr(body) {
        .Match(_, arms) -> arms.last()?.value,
        rest -> null,
    }
}

// ── voices ──

fn no_arms(at: Loc?, rname: string) -> Diag {
    refusal("type.rule_no_arms", at, "`rule ${rname}` declares no arms — it can never answer a fix", "declared here", "write at least one `pattern -> value` arm")
}

fn bad_answer(at: Loc?, rname: string, found: string) -> Diag {
    refusal("type.rule_answer", at, "a `rule ${rname}` arm answers `${found}`, not a `Fix`", "this arm", "answer a `quote { … }` (a rewrite), a named voice fn's `Fix`, or `.Say(…)`")
}

fn no_examples(at: Loc?, rname: string) -> Diag {
    refusal("type.rule_examples", at, "`rule ${rname}` has no `@fixes` or `@keeps` — nothing proves it against real code", "declared here", "add `@fixes(\"before\", \"after\")` or `@keeps(\"still\")`")
}

fn bad_example_shape(at: Loc?, rname: string) -> Diag {
    refusal("type.rule_example_shape", at, "`rule ${rname}`'s example takes string literals, written — never computed", "this example", "`@fixes(\"before\", \"after\")` or `@keeps(\"still\")`, both literal")
}

fn self_read(at: Loc?, rname: string, coll: string) -> Diag {
    refusal("collect.self_read", at, "`${rname}` is collected into `${coll}`, so it cannot read `${coll}` while compiling", "reads it here", "a rule's own body sees the code it is given, never the table it joins")
}
