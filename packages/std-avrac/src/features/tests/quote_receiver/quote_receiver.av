// proves: a method whose quote hands `self` to a call writes nothing — the
// quote's code runs where it lands; only its holes run in the method.
use @std.meta.{Code}

type Maker = { callee: string, calls: int }

impl Maker {
    fn call_code() -> Code {
        quote {
            ${self.callee}(self)
            Kind.${self.callee}(self.${self.callee})
        }
    }
}

let m = Maker { callee: "f", calls: 0 }
let _ = m.call_code()

"${m.callee} ${m.calls}"
