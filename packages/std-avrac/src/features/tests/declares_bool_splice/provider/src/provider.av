// A DECLARES annotation generating SEVERAL top-level statements — a
// fn beside an `impl` block, the shape `@std/relation`'s `@relation`
// derive uses. The fn's body pushes bool literals spliced through a
// run hole into a list literal, the shape a bool-mask generator once
// used (avra-8sb5.57.80).
use @std.meta.{Type, Directive, Declared, Decls, Code}

export fn take_bools(mask: List<bool>) -> int { mask.length }

export fn gen(t: Type) -> Declared {
    Declared {
        made: [Directive { twin: "", name: t.name, at: t.at, source: generated(t) }],
        problems: [],
    }
}

fn generated(t: Type) -> Decls {
    let flags: List<Code> = [quote { false }, quote { false }, quote { true }]
    quote {
        fn ${mask_name(t)}() -> int { take_bools([${..flags}]) }
        impl ${t} {
            static fn first() -> int { 1 }
            static fn second() -> int { 2 }
        }
    }
}

fn mask_name(t: Type) -> string { "${t.name}_mask" }
