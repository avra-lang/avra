// A top-level `state` is a place a body reads: a fn that reads one, directly
// or through a callee, is never constant, so it never hoists into the binary.
use @std.avrac.compiler.{analyze_source, Analysis}
use @std.avrac.core.{ExprId, StmtId, DeclId}
use @std.avrac.features.{SiteLowering}

fn body_of(a: Analysis, name: string) -> ExprId? {
    let s? = a
        .view
        .store
        .stmt_ids()
        .find(
            (k: StmtId) -> match a.view.store.stmt(k) {
                .FnDecl(n, _, _, _, _) -> n.of == name,
                rest -> false,
            },
        ) else {
        return null
    }
    match a.view.store.stmt(s) { .FnDecl(_, _, _, _, body) -> body, rest -> null }
}

fn decl_of(a: Analysis, name: string) -> DeclId {
    [x.id for x in a.view.decls.all_decls() if x.name == name][0]
}

fn hoists(l: SiteLowering) -> bool { match l { .Hoist -> true, rest -> false } }

spec "features/read_set — a top-level state is never constant" {
    given "a fn reading one directly" {
        then "its body does not hoist and the fn reads state" {
            let a = analyze_source("state n: int = 0\nfn f() -> int { n + 1 }")
            let body = body_of(a, "f")!
            !a.hoistable(body) &&
                !hoists(a.site_lowering(body)) &&
                a.decl_reads_state(decl_of(a, "f"))
        }
    }
    given "a caller of a fn reading one" {
        then "its body does not hoist either, and the caller reads state" {
            let a = analyze_source(
                "state n: int = 0\nfn g() -> int { n }\nfn f() -> int { g() + 1 }",
            )
            let body = body_of(a, "f")!
            !a.hoistable(body) &&
                !hoists(a.site_lowering(body)) &&
                a.decl_reads_state(decl_of(a, "f"))
        }
    }
    given "a fn reading no state" {
        then "it still hoists, so the witness separates the two" {
            let a = analyze_source("state n: int = 0\nfn f() -> int { 1 + 2 }")
            hoists(a.site_lowering(body_of(a, "f")!))
        }
    }
}
