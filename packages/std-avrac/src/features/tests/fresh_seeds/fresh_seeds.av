// A `mut` LOCAL IS A COPY, HOWEVER FRESH ITS SEED LOOKS. A fn's answer
// may be a value its argument still holds, so a `mut` seat writing
// through the local must not reach that holder.
type S = { xs: List<int> }

fn add(mut xs: List<int>) { xs.push(7) }

fn inner(s: S) -> List<int> { s.xs }

fn held(i: int) -> string {
    let s = S { xs: [1, i] }
    mut c = inner(s)
    add(c)
    "${s.xs.length}/${c.length}"
}

"${held(0)} ${held(1)}"
