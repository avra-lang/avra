// proves: spec 11.5 — a `mut` local over a NESTED record place (a
// record field two levels down) is a COPY at any depth.
type Leaf = { n: int }
type Mid = { leaf: Leaf }
type Outer = { mid: Mid }
impl Leaf {
    mut fn bump() { self.n = self.n + 1 }
}
fn shadow(o: Outer) {
    mut q = o.mid.leaf
    q.bump()
}
let o = Outer { mid: Mid { leaf: Leaf { n: 0 } } }
shadow(o)
shadow(o)
"${o.mid.leaf.n}"
