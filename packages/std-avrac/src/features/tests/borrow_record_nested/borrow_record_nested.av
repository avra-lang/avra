// MEASURED, not asserted as right: spec 11.5 wants a `mut` local over
// a NESTED record place (a record field two levels down) to be a
// COPY at any depth. The declared-method receiver still ALIASES today
// (F2096 warns at the `mut q = o.mid.leaf` line); this case flips to
// "0" the day that receiver copies.
type Leaf = { n: int }
type Mid = { leaf: Leaf }
type Outer = { mid: Mid }
impl Leaf {
    mut fn bump() { self.n = self.n + 1 }
}
fn shadow(o: Outer) {
    mut q = o.mid.leaf
    q.bump()
}
let o = Outer { mid: Mid { leaf: Leaf { n: 0 } } }
shadow(o)
shadow(o)
"${o.mid.leaf.n}"
