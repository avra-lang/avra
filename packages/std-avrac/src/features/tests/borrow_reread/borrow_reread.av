// proves: spec 11.5 — re-reading an immutable place after a write that
// reached it only through a borrow shows it unchanged: the call's
// answer and the parameter's own size both read the original list.
type Bag = { xs: List<int> }
impl Bag {
    fn sneak(v: int) {
        mut ys = self.xs
        ys.push(v)
    }
    fn size() -> int { self.xs.length }
}
fn touch(b: Bag, v: int) -> int {
    b.sneak(v)
    b.size()
}
let b = Bag { xs: [1] }
let first = touch(b, 2)
"${first} ${b.size()} ${b.xs.length}"
