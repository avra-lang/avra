// A DECLARES annotation generating SEVERAL top-level statements — a
// `once fn` beside an `impl` block, the shape `@std/relation`'s
// `@relation` derive uses. The `once fn`'s generic call is pinned
// only by its OWN declared answer type, never by an argument.
use @std.meta.{Type, Directive, Declared, Decls}

export type Box<R> = { items: List<R> }

export fn boxed<R>(n: int) -> Box<R> {
    let none: List<R> = []
    Box { items: none }
}

export fn gen(t: Type) -> Declared {
    Declared {
        made: [Directive { twin: "", name: t.name, at: t.at, source: generated(t) }],
        problems: [],
    }
}

fn generated(t: Type) -> Decls {
    quote {
        once fn ${box_name(t)}() -> Box<${t}> { boxed(3) }
        impl ${t} {
            static fn first() -> int { 1 }
            static fn second() -> int { 2 }
        }
    }
}

fn box_name(t: Type) -> string { "${t.name}_box" }
