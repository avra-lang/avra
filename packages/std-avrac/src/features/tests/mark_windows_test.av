// A MARK MARKS THE MEMBER IT PRECEDES. `MarkWindows` holds every place
// a mark may land — a variant name AND a payload type — so a mark
// written after a variant name lands on the payload that follows it,
// never on the variant before it. A mark no reader claims is CARRIED,
// never refused: the compiler judges no mark.
use @std.avrac.features.{MarkWindows}
use @std.avrac.core.{Mark, span_of}

fn mark(name: string, lo: int) -> Mark {
    Mark { name: name, args: [], span: span_of(lo, lo + 1) }
}

spec "features/mark_windows" {
    given "a mark belongs to the nearest anchor that follows it" {
        then "a mark before the first anchor lands on it" {
            let w = MarkWindows { anchors: [10, 20], marks: [mark("a", 5)], from: 0 }
            w.at(10).length == 1 && w.at(10)[0].name == "a" && w.at(20).is_empty()
        }
        then "a mark after the first anchor lands on the second" {
            let w = MarkWindows { anchors: [10, 20], marks: [mark("b", 15)], from: 0 }
            w.at(10).is_empty() && w.at(20).length == 1 && w.at(20)[0].name == "b"
        }
        then "a mark before the declaration anchors nothing" {
            let w = MarkWindows { anchors: [10, 20], marks: [mark("x", 1)], from: 8 }
            w.at(10).is_empty() && w.at(20).is_empty()
        }
        then "marks keep source order inside one window" {
            let w = MarkWindows { anchors: [30], marks: [mark("one", 5), mark("two", 6)], from: 0 }
            w.at(30).length == 2 && w.at(30)[0].name == "one" && w.at(30)[1].name == "two"
        }
    }

    given "a variant name and a payload type are both anchors" {
        then "a mark between them is the PAYLOAD's, not the variant's" {
            let w = MarkWindows { anchors: [10, 25], marks: [mark("pm", 15)], from: 0 }
            w.at(10).is_empty() && w.at(25).length == 1
        }
        then "a mark before the variant name is the VARIANT's" {
            let w = MarkWindows { anchors: [10, 25], marks: [mark("vm", 5)], from: 0 }
            w.at(10).length == 1 && w.at(25).is_empty()
        }
        then "the LAST payload's mark does not become the NEXT variant's" {
            // variant at 10, its payloads at 15 and 25, next variant at 40
            let w = MarkWindows { anchors: [10, 15, 25, 40], marks: [mark("last", 20)], from: 0 }
            w.at(25).length == 1 && w.at(25)[0].name == "last" && w.at(40).is_empty()
        }
    }

    given "a mark no reader claims" {
        then "is carried as written, never refused" {
            let w = MarkWindows { anchors: [10], marks: [mark("unclaimed", 5)], from: 0 }
            w.at(10).length == 1 && w.at(10)[0].name == "unclaimed"
        }
    }
}
