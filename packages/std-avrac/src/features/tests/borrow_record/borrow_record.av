// proves: spec 11.5 — a `mut` local over a boxed RECORD is a COPY, so
// a writing declared method called through it (a field write, a list
// push) lands in the copy and the parameter's own record stands
// untouched.
type R = { n: int, xs: List<int> }
impl R {
    mut fn bump() { self.n = self.n + 1 }
    mut fn grow(v: int) { self.xs.push(v) }
}
fn shadow(p: R) {
    mut q = p
    q.bump()
    q.grow(7)
}
let r = R { n: 0, xs: [] }
shadow(r)
shadow(r)
"${r.n} ${r.xs.length}"
