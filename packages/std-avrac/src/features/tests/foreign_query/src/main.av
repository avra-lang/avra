// proves: a fn wearing another package's `@query` or `@input` is that package's, never the
// language's: it keeps no answers, takes no engine's seats, and may read any context.
use @test.foreign.{query, input}

ctx names: List<string> = []

@query
fn counted(n: int) -> int { ctx.names.length + n }

@input
fn doubled(n: int) -> int { n * 2 }

"${counted(1)} ${doubled(2)}"
