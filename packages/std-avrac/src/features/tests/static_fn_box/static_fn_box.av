// proves: R9 — a capture-free closure is static data. The empty case
// first: a captureless lambda answering a constant, called once. Then
// reuse across a loop, storage in a list, a record copied and `with`ed
// (the alias-copy law), a crossing through `dyn`, a named fn as a
// value through a generic fn, recursion through a fn-typed parameter,
// and an early exit that still reads a stored box.

trait Ranker {
    fn rank(v: int) -> int
}

type Scored = { label: string, by: fn(int) -> int }

impl Ranker for Scored {
    fn rank(v: int) -> int { self.by(v) }
}

fn zero(_n: int) -> int { 0 }

fn double(x: int) -> int { x * 2 }

fn apply_n(f: fn(int) -> int, v: int, n: int) -> int {
    if n == 0 { v } else { apply_n(f, f(v), n - 1) }
}

fn first_over(xs: List<int>, f: fn(int) -> bool) -> int {
    for x in xs {
        if f(x) { return x }
    }
    -1
}

fn is_big(n: int) -> bool { n > 5 }

fn apply<T>(f: fn(T) -> T, v: T) -> T { f(v) }

// the empty case: a captureless lambda answering a constant
let empty = () -> 0
let e = empty()

// reuse across a loop — every turn reads the same static box
mut sum = 0
mut i = 0
while i < 20 {
    sum = sum + apply_n(double, 1, 1)
    i = i + 1
}

// stored in a list, read back
let fns: List<fn(int) -> int> = [double, double, double]
let via_list = (fns[1])(3)

// a record holding the box, copied — a write through the copy must
// not reach the original
let scored = Scored { label: "s", by: double }
mut copy = scored
copy.by = zero
let orig_rank = scored.rank(4)
let copy_rank = copy.rank(4)
let via_with = (scored with { by: zero }).rank(4)

// crossing a `dyn` door
let boxed: dyn Ranker = scored
let dyn_rank = boxed.rank(9)

// a named fn as a value, through a generic fn
let generic_rank = apply(double, 6)

// early exit — the fn value is read after a loop that returns from
// the middle of its own scan
let found = first_over([1, 2, 3, 9, 4], is_big)

"${e} ${sum} ${via_list} ${orig_rank} ${copy_rank} ${via_with} ${dyn_rank} ${generic_rank} ${found}"
