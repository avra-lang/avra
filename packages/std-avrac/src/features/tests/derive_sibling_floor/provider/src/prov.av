//! A SIBLING'S FLOOR IS THE ONE BEFORE IT: two top-level declarations
//! admitted from ONE `@derive`d quote each wear their OWN expression
//! range, the second starting where the first ends — never both
//! starting at the batch's own seed. A shared seed gives the second
//! declaration a range wide enough to cover the first's, and folding
//! lays its blanks over the first's real facts.
use @std.meta.{Type, Directive}

export trait MakesCell {
    static fn derive(t: Type) -> List<Directive> {
        [
            Directive {
                twin: "",
                name: t.name,
                at: t.at,
                source: quote {
            fn made_cell() -> Cell<int> { Cell.new(7) }
            impl ${t} { static fn read_cell() -> int {
                let c = made_cell()
                c.get()
            } }
        },
            },
        ]
    }
}
