// proves: spec 11.5 — a `mut` local over a struct FIELD that holds a
// boxed record is a COPY, so a writing declared method through the
// local leaves the field, and its owner, unchanged.
type Inner = { n: int }
type Outer = { r: Inner }
impl Inner {
    mut fn bump() { self.n = self.n + 1 }
}
fn shadow(o: Outer) {
    mut q = o.r
    q.bump()
}
let o = Outer { r: Inner { n: 0 } }
shadow(o)
shadow(o)
"${o.r.n}"
