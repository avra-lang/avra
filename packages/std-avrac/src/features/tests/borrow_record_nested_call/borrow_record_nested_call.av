// proves: spec 11.5 and THE MINT LAW together — a receiver and its
// own argument, both writing methods on the SAME `mut` local in one
// call, read the box the argument left behind: the receiver's own
// cell is read AFTER the argument, never frozen before it.
type R = { n: int, xs: List<int> }
impl R {
    mut fn add(v: int) -> int {
        self.xs.push(v)
        self.xs.length - 1
    }
    fn total(offset: int) -> int { self.xs.length + offset }
}
fn shadow(p: R) -> int {
    mut q = p
    q.total(q.add(5))
}
let r = R { n: 0, xs: [] }
let first = shadow(r)
let second = shadow(r)
"${first} ${second} ${r.xs.length}"
