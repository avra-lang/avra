// proves A TYPE CROSSES AS A SHAPE: every field, payload and seat
// arrives as a `Kind` a rule DISPATCHES on, its own `spelled()`
// agrees with the words the program wrote, and the shapes no field
// can hold (a `Result`, a `mut` seat, a fn type, `void`) arrive
// through a fn's seats.
use @std.meta.{derive}
use @test.kinds.{Shapes, Carried, seated}

type Held = { n: int }

@derive(Shapes)
type Every = {
    i: int,
    f: float,
    b: bool,
    s: string,
    l: List<int>,
    m: Map<string, int>,
    o: string?,
    n: Held,
    d: List<List<string>>,
    a: fn(int) -> bool,
}

@derive(Carried)
enum Carries {
    None
    One(n: int)
    Two(t: string, l: List<Held>)
}

@seated
fn takes(a: int, b: List<string>, c: fn(mut string) -> int) -> Result<Held, string> {
    mut word = "x"
    Result.Ok(Held { n: a + b.length + c(word) })
}

@seated
fn answers_nothing(x: int) {
}

let every = Every { i: 0, f: 0.0, b: false, s: "", l: [], m: {}, o: null, n: Held { n: 1 }, d: [], a: (z: int) -> true }
"${every.shapes()} | ${every.words()} | ${every.written()} | ${Carries.None.carried()} | ${Carries.None.paired()} | ${takes_shape()} | ${answers_nothing_shape()}"
