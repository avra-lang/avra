// A template copy keeps every fact its source statement wore: the
// keywords a declaration was written with and the forms its values were
// spelled in survive the splice.
use @std.avrac.compiler.{parse_source, Parsed}
use @std.avrac.core.{
    SyntaxArena,
    StmtId,
    ExprId,
    Expr,
    Stmt,
    Nominal,
    Plain,
    copier,
    hole_runs,
    no_door,
    OnHandler,
}

/// The statements a `quote { … }` holds, and the program they stand in.
fn quoted(body: string) -> Parsed {
    parse_source("quote { ${body} }")
}

fn held(p: Parsed) -> List<StmtId> {
    let root = p.store.answer_of(p.stmts[0])!
    match p.store.expr(root).body_of()!.view { .Verbatim(ss, _) -> ss, rest -> [] }
}

/// The statements' keyword facts, one word each.
fn worn(store: SyntaxArena, ss: List<StmtId>) -> string {
    [wear(store, s) for s in ss].join(" ")
}

fn wear(store: SyntaxArena, s: StmtId) -> string {
    [
        if store.is_exported(s) { "export" } else { "" },
        if store.is_mutating(s) { "mut" } else { "" },
        if store.is_once(s) { "once" } else { "" },
        if store.is_static(s) { "static" } else { "" },
        if store.is_state_stmt(s) { "state" } else { "" },
        if store.is_host_fn(s) { "host" } else { "" },
        if store.is_collect_dense(s) { "dense" } else { "" },
    ]
        .join(",")
}

/// Whether the copy of `body` wears what its source wore, and wears something.
fn survives(body: string) -> bool {
    let src = quoted(body)
    let dst = parse_source("let x = 1")
    let ss = held(src)
    mut rb = copier(
        src.store,
        dst.store,
        [],
        hole_runs(src.store, src.store.answer_of(src.stmts[0])!),
        no_door,
    )
    let copy = worn(dst.store, rb.stmts(ss))
    worn(src.store, ss) == copy && copy != ","
}

/// The forms an expression tree's nodes were written in, one letter each.
fn forms(store: SyntaxArena, root: ExprId) -> string {
    [form_of(store, e) for e in store.every_expr(root)].join("")
}

fn form_of(store: SyntaxArena, e: ExprId) -> string {
    [
        if store.is_trailing(e) { "t" } else { "" },
        if store.expr(e) is .TypeLiteral { "l" } else { "" },
        if store.is_raw_string(e) { "r" } else { "" },
        if store.is_sugar_match(e) { "m" } else { "" },
        if !store.struct_targs_of(e).is_empty() { "a" } else { "" },
        if store.is_payload(e) != null { "p" } else { "" },
        if store.grammar_lit_of(e) != null { "g" } else { "" },
    ]
        .join("")
}

/// Whether the copy of `body`'s last value is written in the forms its source was, and in some.
fn keeps_forms(body: string) -> bool {
    let src = quoted(body)
    let dst = parse_source("let x = 1")
    let ss = held(src)
    mut rb = copier(
        src.store,
        dst.store,
        [],
        hole_runs(src.store, src.store.answer_of(src.stmts[0])!),
        no_door,
    )
    let copied = rb.stmts(ss)
    let before = forms(src.store, src.store.answer_of(ss.last()!)!)
    before != "" && before == forms(dst.store, dst.store.answer_of(copied.last()!)!)
}

/// What a declaration wrote beside its keywords, one letter each.
fn declared(store: SyntaxArena, s: StmtId) -> string {
    [
        if store.impl_tparams_of(s) != null { "i" } else { "" },
        if !store.trait_args_of(s).is_empty() { "a" } else { "" },
        match store.stmt(s) {
            .TraitDecl(_, tparams, _) -> if tparams.is_empty() { "" } else { "p" },
            rest -> "",
        },
        if !store.spreads_of(s).is_empty() { "s" } else { "" },
        if store.grammar_of(s) != null { "g" } else { "" },
        if store.instance_of(s) != null { "n" } else { "" },
    ]
        .join("")
}

/// Whether the copy of `body`'s statements declare what their sources did, and something.
fn keeps_declared(body: string) -> bool {
    let src = quoted(body)
    let dst = parse_source("let x = 1")
    let ss = held(src)
    mut rb = copier(
        src.store,
        dst.store,
        [],
        hole_runs(src.store, src.store.answer_of(src.stmts[0])!),
        no_door,
    )
    let before = [declared(src.store, s) for s in ss].join(",")
    let after = [declared(dst.store, s) for s in rb.stmts(ss)].join(",")
    before != "," && before == after
}

/// The copy of an expression its source marked as the handler of `press`.
fn handler_copy() -> OnHandler? {
    let src = quoted("1")
    let dst = parse_source("let x = 1")
    let ss = held(src)
    src.store.mark_on_handler(src.store.answer_of(ss.last()!)!, "press")
    mut rb = copier(
        src.store,
        dst.store,
        [],
        hole_runs(src.store, src.store.answer_of(src.stmts[0])!),
        no_door,
    )
    dst.store.on_handler(dst.store.answer_of(rb.stmts(ss).last()!)!)
}

/// What a literal's copy holds in its two fields, where its source held ONE node
/// twice.
fn copied_values(src: SyntaxArena, dst: SyntaxArena, lit: ExprId) -> List<ExprId> {
    mut rb = copier(src, dst, [], [], no_door)
    dst.struct_lit_parts(rb.expr(lit))?.values ?? []
}

/// The source's literal whose two fields are one node.
fn twice_held(src: SyntaxArena) -> ExprId {
    let node = src.alloc_expr(Expr.StrLit("x"))
    src.alloc_expr(Expr.StructLit(Nominal("T"), [Plain("p"), Plain("q")], [node, node]))
}

fn shared_copy() -> List<ExprId> {
    let src = parse_source("let x = 1")
    copied_values(src.store, parse_source("let x = 1").store, twice_held(src.store))
}

/// The nodes two separate copies of one literal hold: each copy is its own.
fn separate_copies() -> List<ExprId> {
    let src = parse_source("let x = 1")
    let dst = parse_source("let x = 1")
    let lit = twice_held(src.store)
    copied_values(src.store, dst.store, lit).concat(copied_values(src.store, dst.store, lit))
}

spec "features/tests — facts a template copy keeps" {
    given "keywords a declaration wears" {
        then "export survives" { survives("export fn a() -> int { 1 }") }
        then "mut survives" { survives("mut fn a() -> int { 1 }") }
        then "once survives" { survives("once fn a() -> int { 1 }") }
        then "static survives" { survives("static fn a() -> int { 1 }") }
        then "state survives" { survives("state n: int = 1") }
        then "host survives" { survives("extern fn a() -> int { 1 }") }
    }
    given "forms an expression was written in" {
        then "a trailing block survives" { keeps_forms("xs.map { it }") }
        then "a type literal stays the node it was written as" { keeps_forms("cx.type(List<int>)") }
        then "a raw string survives" { keeps_forms("\"\"\"x\"\"\"") }
        then "a trailing block of arms survives" { keeps_forms("xs.map { .Ok(v) -> v }") }
        then "a literal's type arguments survive" { keeps_forms("Box<int> { v: 1 }") }
        then "a binding if survives" { keeps_forms("if k is .A(v) { v } else { 0 }") }
    }
    given "what a declaration wrote beside its keywords" {
        then "an impl's own type parameters survive" { keeps_declared("impl Box<T> { fn get() -> int { 1 } }") }
        then "a trait impl's arguments survive" { keeps_declared("impl Show<X> for Box { fn show() -> int { 1 } }") }
        then "a trait's own type parameters survive" { keeps_declared("trait Pair<A, B> { fn first() -> A }") }
        then "a record's spreads survive" { keeps_declared("type P = { ..Q, x: int }") }
    }
    given "the event an expression is a handler of" {
        then "a handler's event survives" { handler_copy()?.event == "press" }
    }
    given "a node its source reaches twice" {
        then "is one node in the copy" { shared_copy().length == 2 && shared_copy()[0] == shared_copy()[1] }
        then "is one node in each of two copies, and the copies share none" {
            let all = separate_copies()
            all.length == 4 && all[0] == all[1] && all[2] == all[3] && all[0] != all[2]
        }
    }
}
