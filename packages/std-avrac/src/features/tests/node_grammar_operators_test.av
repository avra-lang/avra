// AN OPERATOR TABLE NAMES ITS NODE. A tier's build (or the branch's, for
// every tier) is a node build whose slots are the climb's own captures —
// `left`, `op` and `right` — and `op` is the WORD the climb took, whole, so a
// payload that is an operator is filled from the words the table spells.
// Against a node model of made-up variants.
use @std.errors.{Loc}
use @std.grammar.{Grammar, Slot, Diagnostic, Captured, run_grammar, ready}
use @std.avrac.grammar.{parse_grammar, lex_source, Token, avra_known_terminals, avra_lexeme}
use @std.avrac.features.{bind_nodes}
use @std.avrac.core.{PayloadRow, joined}
use @std.meta.{Field}

fn op_rows() -> List<PayloadRow> {
    [
        PayloadRow {
            owner: "E",
            variant: "Bin",
            payloads: [
                Field { name: "op", ty: "BinOp", at: null, kind: .Named("BinOp", []) },
                Field { name: "left", ty: "ExprId", at: null, kind: .Named("ExprId", []) },
                Field { name: "right", ty: "ExprId", at: null, kind: .Named("ExprId", []) },
            ],
        },
        PayloadRow {
            owner: "E",
            variant: "Is",
            payloads: [
                Field { name: "left", ty: "ExprId", at: null, kind: .Named("ExprId", []) },
                Field { name: "right", ty: "ExprId", at: null, kind: .Named("ExprId", []) },
            ],
        },
        PayloadRow {
            owner: "E",
            variant: "Co",
            payloads: [
                Field { name: "left", ty: "ExprId", at: null, kind: .Named("ExprId", []) },
                Field { name: "right", ty: "ExprId", at: null, kind: .Named("ExprId", []) },
            ],
        },
    ]
}

fn op_grammar(src: string) -> Grammar {
    parse_grammar(src).built ?? Grammar { name: "unparsed", start: "unparsed", rules: [] }
}

fn op_refusals(src: string) -> List<Diagnostic> {
    bind_nodes(op_grammar(src), op_rows()).defects
}

fn op_refuses(src: string, words: string) -> bool {
    op_refusals(src).any(it.message.contains(words))
}

fn op_text(v: Captured<Token, string>) -> string {
    match v {
        .Terminal(t) -> t.text,
        .Node(n) -> n,
        .Many(items) -> "[${joined([op_text(x) for x in items], " ")}]",
        .Absent -> "_",
    }
}

fn op_build(name: string, args: List<Captured<Token, string>>, _loc: Loc?) -> Result<
    Captured<Token, string>,
    string,
> {
    let built: Captured<Token, string> = Captured
        .Node("(${name} ${joined([op_text(a) for a in args], " ")})")
    Result.Ok(built)
}

fn op_run(src: string, text: string) -> string {
    let g = bind_nodes(op_grammar(src), op_rows()).g
    let o = run_grammar<Token, string>(
        ready(g, avra_known_terminals()),
        lex_source(text).tokens,
        avra_lexeme(),
        op_build,
    )
    let said = joined([d.message for d in o.diagnostics], " ;; ")
    if o.result == null { return "<none> |${said}" }
    "${op_text(o.result!)} |${said}"
}

const op_table: string = "prog = x:e ( BREAK )* EOF -> x\ne = left:operand @operators { left \"+\" \"-\" left ( \">\" \">\" ) \"<<\" left \"??\" -> E.Co } -> E.Bin\noperand = v:NAME -> lit(v)\n"

spec "features/node_grammar — an operator table's builds" {
    given "a branch build and a tier build over a table" {
        then "name their node, and refuse nothing" { op_refusals(op_table).is_empty() }
        then "the climb hands the node the word it took as `op`" {
            op_run(op_table, "a + b") == "(E.Bin + (lit a) (lit b)) |"
        }
        then "a word spelled with two tokens is one word" {
            op_run(op_table, "a > > b") == "(E.Bin >> (lit a) (lit b)) |"
        }
        then "a tier's own build wins over the branch's" {
            op_run(op_table, "a ?? b") == "(E.Co (lit a) (lit b)) |"
        }
        then "groups left" { op_run(op_table, "a - b + c") == "(E.Bin + (E.Bin - (lit a) (lit b)) (lit c)) |" }
    }
    given "a word that names no operator" {
        then "is refused where the table is assembled" {
            op_refuses(
                "e = left:operand @operators { left \"+=\" } -> E.Bin\noperand = v:NAME -> lit(v)\n",
                "the word `+=`, which spells no operator",
            )
        }
        then "says so in the table's own words" {
            let said = op_refusals(
                "e = left:operand @operators { left \"+=\" } -> E.Bin\noperand = v:NAME -> lit(v)\n",
            )
            said.length == 1 &&
                said[0].message == "rule `e` builds `E.Bin` for the word `+=`, which spells no operator"
        }
        then "but not for a node with no operator payload" {
            !op_refuses(
                "e = left:operand @operators { left \"+=\" -> E.Co }\noperand = v:NAME -> lit(v)\n",
                "spells no operator",
            )
        }
    }
    given "a suffix with its own node build" {
        then "builds its node from the climb's seats, the tier's words from the branch's" {
            let src = "prog = x:e ( BREAK )* EOF -> x\ne = left:operand @operators { none \"==\" suffix \"is\" tag -> E.Is } -> E.Bin\ntag = \".\" n:NAME -> tag(n)\noperand = v:NAME -> lit(v)\n"
            op_run(src, "a is .V") == "(E.Is (lit a) (tag V)) |" &&
                op_run(src, "a == b") == "(E.Bin == (lit a) (lit b)) |"
        }
        then "is refused when the node has an operator seat the suffix word cannot fill" {
            op_refuses(
                "e = left:operand @operators { none \"==\" suffix \"is\" tag -> E.Bin } -> E.Bin\ntag = \".\" n:NAME -> tag(n)\noperand = v:NAME -> lit(v)\n",
                "the word `is`, which spells no operator",
            )
        }
        then "is refused when it names a node that is not there" {
            op_refuses(
                "e = left:operand @operators { none \"==\" suffix \"is\" tag -> E.Nope } -> E.Bin\ntag = \".\" n:NAME -> tag(n)\noperand = v:NAME -> lit(v)\n",
                "no such variant is declared",
            )
        }
    }
    given "a tier build naming a node that is not there" {
        then "is refused like any node build" {
            op_refuses(
                "e = left:operand @operators { left \"+\" -> E.Nope } -> E.Bin\noperand = v:NAME -> lit(v)\n",
                "no such variant is declared",
            )
        }
    }
}
