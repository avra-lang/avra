// proves: a field read by offset alone holds for a static record, a `with` copy, a dyn receiver and a generic subject.
trait Show {
    fn show() -> string
}

type Point = { x: int, y: int }

type Holder<T> = { first: T, tag: string, on: Cell<bool> }

type Named = { at: Point, name: string, n: int }

impl Show for Named {
    fn show() -> string { "${self.name}${self.n}${self.at.x}" }
}

const FIXED = Named { at: Point { x: 7, y: 8 }, name: "k", n: 2 }

fn tag_of<T>(h: Holder<T>) -> string { h.tag }

let moved = FIXED with { n: 5 }
let d: dyn Show = moved
let h = Holder { first: Point { x: 1, y: 2 }, tag: "g", on: Cell.new(false) }
"${FIXED.name}${FIXED.at.y} ${d.show()} ${tag_of(h)}${h.on.get()}"
