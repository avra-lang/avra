// proves: the complete child walk types and lowers a program whose
// nodes take their children from their own record's fields — a
// `with`, a comprehension, a match, a `when`, an `if` and a lambda,
// all in one body, eval == native.
type P = { a: int, b: int }

fn named(p: P) -> int { p.a + p.b }

fn pick(k: int) -> string {
    let p = P { a: k, b: k + 1 }
    let q = p with { a: k * 10 }
    let xs = [p.a, p.b, q.a]
    let doubled = [x * 2 for x in xs]
    mut total = 0
    for x in xs { total = total + x }
    let chosen = match q.a { 0 -> 0, _ -> doubled[0] }
    let w = when {
        p.a > 100 -> 0
        p.b > 0 -> total
        _ -> 0
    }
    let b = if p.a > 100 { false } else { p.b > 0 }
    let lam = (n: int) -> n + chosen
    "${q.a} ${doubled.length} ${w} ${b} ${lam(4)}"
}

pick(3)
