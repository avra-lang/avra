// proves: spec 11.5 — an immutable LOCAL is not aliased by a `mut`
// local borrowed from its field. The writes land in the copy, so the
// local holds no extra element.
type Bag = { xs: List<int> }
impl Bag {
    fn sneak(v: int) {
        mut ys = self.xs
        ys.push(v)
    }
    fn size() -> int { self.xs.length }
}
fn local_case() -> int {
    let b = Bag { xs: [1] }
    let base = b.size()
    b.sneak(2)
    b.sneak(3)
    b.size() - base
}
local_case()
