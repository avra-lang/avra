// proves: spec 11.5 — a `mut` local over a list ELEMENT that holds a
// boxed record is a COPY, so a writing declared method through the
// local leaves the element, and its list, unchanged.
type R = { n: int }
impl R {
    mut fn bump() { self.n = self.n + 1 }
}
fn shadow(xs: List<R>) {
    mut q = xs[0]
    q.bump()
}
let xs = [R { n: 0 }]
shadow(xs)
shadow(xs)
"${xs[0].n}"
