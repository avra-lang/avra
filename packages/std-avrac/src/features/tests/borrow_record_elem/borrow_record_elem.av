// MEASURED, not asserted as right: spec 11.5 wants a `mut` local over
// a list ELEMENT that holds a boxed record to be a COPY, so a writing
// method through the local leaves the element, and its list,
// unchanged. The declared-method receiver still ALIASES today (F2095
// warns at the `mut q = xs[0]` line); this case flips to "0" the day
// that receiver copies.
type R = { n: int }
impl R {
    mut fn bump() { self.n = self.n + 1 }
}
fn shadow(xs: List<R>) {
    mut q = xs[0]
    q.bump()
}
let xs = [R { n: 0 }]
shadow(xs)
shadow(xs)
"${xs[0].n}"
