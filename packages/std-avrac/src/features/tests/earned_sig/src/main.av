// proves a derive's crossing reads an enum's EARNED sig: a payload
// naming a type declared BEFORE the enum, one declared AFTER it (a
// forward reference), a bare primitive, and a nested shape over a
// declared name all answer real kinds — and FIVE stacked derives,
// the node model's own count, agree with one another rather than
// the later ones seeing a smaller, still-resolving view.
use @std.meta.{derive}
use @test.earned_sig.{First, Second, Third, Fourth, Fifth}

type Early = string

@derive(First)
@derive(Second)
@derive(Third)
@derive(Fourth)
@derive(Fifth)
enum Node {
    Prim(x: List<int>)
    Named(x: Early)
    Forward(x: Late)
    Nested(x: Map<string, List<Early>>)
    Absent(x: Late?)
}

enum Late { A, B(n: int) }

let all = [first_kinds(), second_kinds(), third_kinds(), fourth_kinds(), fifth_kinds()]
"${all.all(it == all[0])} | ${all[0]}"
