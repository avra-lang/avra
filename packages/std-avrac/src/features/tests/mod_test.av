// The feature contract: composition gathers every feature's RULES in
// feature order, dispatch walks builder tables through a Builder, and
// coherence cross-checks the tables against the composed grammar's
// build calls.
use @std.avrac.core.{new_node_store, Expr}
use @std.grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use @std.avrac.features.{LangNode, LanguageFeature, BuilderRow, Builder, compose_grammar, dispatch, builder_defects, feature, no_grammar}

fn build_a(mut b: Builder) -> Result<LangNode, string> {
    b.make_expr(Expr.IntLit(b.args.length))
}

// LICENSED I23: conforms to a callback signature — the CONTRACT owns
// the parameter list, not this body
fn build_b(b: Builder) -> Result<LangNode, string> {
    Result.Err("beta cannot build that")
}

fn with_rows(fname: string, fgram: Grammar, rows: List<BuilderRow>) -> LanguageFeature {
    feature(fname, fgram) with { builders: rows }
}

fn alpha_gram() -> Grammar {
    grammar {
        a = x:NAME -> mk_a(x)
    }
}

fn beta_gram() -> Grammar {
    grammar {
        b = x:NUMBER -> mk_b(x)
    }
}

fn ghost_gram() -> Grammar {
    grammar {
        g = x:NAME -> ghost(x)
    }
}

fn bare_gram() -> Grammar {
    grammar {
        b = NUMBER
    }
}

fn uncalled_gram() -> Grammar {
    grammar {
        a = NAME
    }
}

fn grouped_gram() -> Grammar {
    grammar {
        g = x:NAME ( y:NAME -> ghost(y) )? -> mk_a(x)
    }
}

fn alpha_rows() -> List<BuilderRow> {
    let rows = table<BuilderRow> {
        name   | build
        "mk_a" | build_a
    }
    rows
}

fn fixture() -> List<LanguageFeature> {
    let beta_rows = table<BuilderRow> {
        name   | build
        "mk_b" | build_b
    }
    [
        with_rows("alpha", alpha_gram(), alpha_rows()),
        with_rows("beta", beta_gram(), beta_rows),
    ]
}

fn defects_for(feats: List<LanguageFeature>) -> List<string> {
    [d.message for d in builder_defects(feats, compose_grammar(feats).built)]
}

spec "features/mod" {
    given "composition" {
        then "rules gather in feature order, the first naming the start" {
            let c = compose_grammar(fixture())
            let names = [r.name for r in c.built.rules]
            names.length == 2 && names[0] == "a" && names[1] == "b" && c.built.start == "a"
        }
        then "a feature contributing no rules adds none" {
            let c = compose_grammar([with_rows("silent", no_grammar(), alpha_rows())])
            c.built.rules.is_empty() && c.built.start == ""
        }
    }
    given "builder dispatch" {
        then "the registering feature builds, into the shared store" {
            let store = new_node_store()
            let o = dispatch(fixture(), store, "mk_a", [], null)
            o is .Ok && store.exprs.count() == 1
        }
        then "a later feature's table is reached when earlier ones lack the name" {
            let store = new_node_store()
            let o = dispatch(fixture(), store, "mk_b", [], null)
            match o { .Err(m) -> m == "beta cannot build that", .Ok(_) -> false }
        }
        then "an unregistered name is an error naming the gap" {
            let store = new_node_store()
            let o = dispatch(fixture(), store, "ghost", [], null)
            match o { .Err(m) -> m == "no feature owns builder `ghost`", .Ok(_) -> false }
        }
    }
    given "builder coherence" {
        then "a coherent language has no defects" {
            defects_for(fixture()).is_empty()
        }
        then "an unregistered build call names the gap and the search" {
            let no_rows: List<BuilderRow> = []
            let ds = defects_for([with_rows("solo", ghost_gram(), no_rows)])
            ds.length == 1 &&
                ds[0] == "no feature registers builder `ghost` (searched solo)"
        }
        then "a name registered twice names the prior owner" {
            let ds = defects_for([
                with_rows("alpha", alpha_gram(), alpha_rows()),
                with_rows("alpha2", bare_gram(), alpha_rows()),
            ])
            ds.length == 1 &&
                ds[0] == "builder `mk_a` is already registered by `alpha`"
        }
        then "a builder no rule calls is dead" {
            let ds = defects_for([with_rows("alpha", uncalled_gram(), alpha_rows())])
            ds.length == 1 &&
                ds[0] == "builder `mk_a` is never called by any grammar rule"
        }
        then "a build call inside a group is seen" {
            let ds = defects_for([with_rows("alpha", grouped_gram(), alpha_rows())])
            ds.length == 1 &&
                ds[0] == "no feature registers builder `ghost` (searched alpha)"
        }
        then "a name registered twice in one feature is caught" {
            let rows = table<BuilderRow> {
                name   | build
                "mk_a" | build_a
                "mk_a" | build_b
            }
            let ds = defects_for([with_rows("alpha", alpha_gram(), rows)])
            ds.length == 1 &&
                ds[0] == "builder `mk_a` is already registered by `alpha`"
        }
    }
}
