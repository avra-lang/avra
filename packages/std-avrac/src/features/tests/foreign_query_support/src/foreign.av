//! A package's own `query` and `input`: annotations of the same words as `@std/relation`'s and
//! `@std/program`'s, which make nothing and mark nothing.
use @std.meta.{Fn}

/// Marks a fn, and asks nothing of it.
export fn query(_f: Fn) {}

/// Marks a fn, and asks nothing of it.
export fn input(_f: Fn) {}
