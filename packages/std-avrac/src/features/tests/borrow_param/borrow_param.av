// proves: spec 11.5 — `let` is deeply immutable. A `mut` local bound
// to an immutable parameter's field is a COPY: the push lands in the
// copy, so the parameter's list holds no pushed element.
type Bag = { xs: List<int> }
impl Bag {
    fn sneak(v: int) {
        mut ys = self.xs
        ys.push(v)
    }
    fn size() -> int { self.xs.length }
}
fn touch(b: Bag, v: int) -> int {
    b.sneak(v)
    b.size()
}
let b = Bag { xs: [1] }
let base = b.size()
let first = touch(b, 2)
touch(b, 3)
"${base} ${first} ${b.size() - base}"
