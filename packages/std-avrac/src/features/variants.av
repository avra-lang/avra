//! VARIANT CONSTRUCTION — `Type.variant(arg)`, the type-receiver
//! half of the one dot-call surface. Plain or generic, ONE law: the
//! variant must exist; a carrying variant takes exactly its payload
//! (which UNIFIES, pinning a generic declaration's Vars); the answer
//! is the declared type, instantiated when generic.
use core.{ExprId, TypeId, Type, DeclId, same_decl}
use diagnostics.{refusal}

impl TypeCx {
    /// The one law, at the call — the module's header states it.
    mut fn construct_variant(
        e: ExprId,
        decl: DeclId,
        tname: string,
        variant: string,
        args: List<ExprId>,
    ) -> TypeId {
        let sig? = self.variants_declared(decl, tname) else { return self.no_variants_here(e, decl, tname, variant) }
        if sig.tag_of(variant) == null { return self.no_such_variant(e, tname, variant, sig) }
        if self.seals_decl(self.loc_of(e), decl, "built here") { return self.error_type }
        let tp = self.view.decls.tparams(decl)
        if tparams_refused(tp) { return self.error_type }
        let carried = sig.payloads_of(variant)
        if carried.is_empty() { return self.unit_variant(e, tname, variant, tp) }
        if args.is_empty() { return self.given_nothing(e, tname, variant, carried[0]) }
        if args.length != carried.length { return self.wrong_payload_count(e, tname, variant, carried.length, args.length) }
        mut bound = no_pins(tp.length)
        for k, a in args {
            if !self.agreed(a, carried[k], decl, bound) { return self.wrong_payload(a, tname, variant, carried[k]) }
        }
        self.instantiated(e, tname, decl, tp, bound)
    }

    mut fn wrong_payload_count(e: ExprId, tname: string, variant: string, carries: int, found: int) -> TypeId {
        self
            .spoken(
                refusal(
                    "type.variant_arity",
                    self.loc_of(e),
                    "`${tname}.${variant}` carries ${count_word(carries)}, given ${found}",
                    "built here",
                    "a variant's payload is a single value — wrap several in a record",
                ),
            )
    }

    /// A unit variant given an argument list: the plain one carries
    /// nothing; a generic one has nothing to PIN from either.
    mut fn unit_variant(e: ExprId, tname: string, variant: string, tp: List<string>) -> TypeId {
        if !tp.is_empty() { return self.cannot_pin(e, tname, variant, tp[0]) }
        self.carries_nothing(e, tname, variant)
    }

    /// A bare generic unit variant — `Opt.none` — pins from the want
    /// alone; with none, nothing carries the type and it says so.
    mut fn unit_instantiated(
        e: ExprId,
        tname: string,
        variant: string,
        decl: DeclId,
        tp: List<string>,
    ) -> TypeId {
        let pinned = self.pinned_by_want(e, decl, no_pins(tp.length))
        let missing: string? = unpinned_of(tp, pinned)
        if missing != null { return if self.starving { self.cannot_pin(e, tname, variant, missing!) } else { self.hungry(e) } }
        self.instantiated(e, tname, decl, tp, pinned)
    }

    /// The answer: the plain enum, or the App the bindings close into.
    /// A Var no payload pinned is read from the WANT — the type the
    /// site is expected to be, when it is this declaration's — and a
    /// builtin declaration builds its type through its row.
    mut fn instantiated(e: ExprId, tname: string, decl: DeclId, tp: List<string>, bound: Pins) -> TypeId {
        if tp.is_empty() { return self.view.types.intern(Type.Enum(decl, tname)) }
        let pinned = self.pinned_by_want(e, decl, bound)
        let missing: string? = unpinned_of(tp, pinned)
        if missing != null { return if self.starving { self.unpinned_by_payload(e, missing!) } else { self.hungry(e) } }
        let concrete = self.bound_closed(pinned)
        let row: TypeRow? = self.view.decls.row_of(decl)
        let args = TypeArgs { parts: concrete }
        if row != null { return self.view.types.intern(row!.builds(args)) }
        self.record_subst(e, decl, concrete, [])
        self.view.types.intern(Type.App(decl, tname, concrete))
    }

    /// Whether a type is THIS declaration's: an App naming it, or a
    /// builtin's row rebuilt over the type's own arguments.
    fn wants_decl(want: TypeId, decl: DeclId) -> bool {
        let row: TypeRow? = self.view.decls.row_of(decl)
        if row != null {
            let args = TypeArgs { parts: self.view.types.args_of(want) }
            return args.parts.length == row!.arity &&
                !self.types_disagree(self.view.types.intern(row!.builds(args)), want)
        }
        match self.view.types.shape_of(want) {
            .App(d, _, _) -> same_decl(d, decl),
            .Ptr or .Int or .Float or .Bytes or .Str or .Bool or .Struct(_, _) or .Enum(_, _) or .Res(_, _) or .TypeName(_, _) or .Var(_, _, _) or .Dyn(_, _) or .Fn(_, _, _) or .Opt(_) or .Null or .EmptyList or .Error or .Void or .List(_) or .Cell(_) or .Task(_) or .Tasks or .Map(_, _) or .EmptyMap or .Union(_) or .Range -> false,
        }
    }

    /// A construction nothing pinned goes HUNGRY — silently, the hole —
    /// unless the walk is already starving, when the site speaks for
    /// itself.
    mut fn hungry(e: ExprId) -> TypeId {
        self.go_hungry(e)
        self.error_type
    }

    /// The bindings with every empty slot filled from the want's type
    /// arguments, when the want has as many.
    fn pinned_by_want(e: ExprId, decl: DeclId, bound: Pins) -> Pins {
        let wanted? = self.want_at(e) else { return bound }
        let want = self.view.types.carried(wanted) ?? wanted
        if !self.wants_decl(want, decl) { return bound }
        let args = self.view.types.args_of(want)
        if args.length != bound.slots.length { return bound }
        // the typed let plants the nullable slot's want; a field seat does not
        let slots: List<TypeId?> = [b ?? args[j] for j, b in bound.slots]
        Pins { slots: slots }
    }

    /// The raw declared table — Vars intact — or absence when the
    /// declaration is a record. The REAL name interns: the registry
    /// keeps the FIRST shape it sees for a key, so a throwaway name
    /// here would poison every later printing of this enum.
    fn variants_declared(decl: DeclId, tname: string) -> EnumSig? {
        self.variants_of(self.view.types.intern(Type.Enum(decl, tname)))
    }
}

// ── The voices ──

impl TypeCx {
    /// A type name that names no enum: a TRAIT is told about its own
    /// associated fns, a GRAMMAR about its doors, every other record
    /// about records.
    mut fn no_variants_here(e: ExprId, decl: DeclId, tname: string, name: string) -> TypeId {
        if self.view.decls.is_trait(decl) { return self.no_trait_static(e, decl, tname, name) }
        if self.view.decls.grammar_of(decl) == null { return self.no_static_fn(e, tname, name, self.static_names(decl)) }
        self.no_such_door(e, tname, name)
    }

    /// A trait's bare name answers only an associated fn with ONE
    /// body of its own — a signatory's answer lives under the
    /// signatory's name instead.
    mut fn no_trait_static(e: ExprId, decl: DeclId, tname: string, name: string) -> TypeId {
        if self.view.decls.trait_member(decl, name) != null {
            return self
                .spoken(
                    refusal(
                        "type.unknown_prop",
                        self.loc_of(e),
                        "`${tname}.${name}` has no one body — each signatory answers its own",
                        "built here",
                        "call it through the implementing type: `<Type>.${name}(…)`",
                    ),
                )
        }
        self
            .spoken(
                refusal(
                    "type.unknown_prop",
                    self.loc_of(e),
                    "`${tname}` has no associated fn `${name}`",
                    "built here",
                    "declare it — `static fn ${name}(…) -> … { … }` inside the trait",
                ),
            )
    }

    mut fn no_such_door(e: ExprId, tname: string, name: string) -> TypeId {
        self
            .spoken(
                refusal(
                    "type.unknown_prop",
                    self.loc_of(e),
                    "`${tname}` is a `grammar`, not an enum",
                    "built here",
                    "`${tname}.${name}` is a call only where the grammar declares a door of that name",
                ),
            )
    }

    /// The static fn a type declares under `name`, if it declares one.
    fn static_named(decl: DeclId, name: string) -> DeclId? {
        self
            .view
            .decls
            .declared_methods(decl)
            .find(
                (m: DeclId) -> self.view.decls.decl(m).name == name &&
                    self.view.decls.is_static_of(m),
            )
    }

    /// A static fn read without a call: a static fn is not a value yet,
    /// and the help writes the lambda that is one.
    mut fn static_not_value(e: ExprId, tname: string, name: string, m: DeclId) -> TypeId {
        self
            .spoken(
                refusal(
                    "type.unknown_prop",
                    self.loc_of(e),
                    "`${tname}.${name}` is a static fn, and a static fn is not a value yet",
                    "read here",
                    "wrap it in a lambda — `${self.static_wrapper(tname, name, m)}`",
                ),
            )
    }

    /// The lambda that calls a static fn, spelled from its own seats.
    fn static_wrapper(tname: string, name: string, m: DeclId) -> string {
        let seats = self.view.decls.facts_of(m)?.seats ?? []
        let types = self.view.decls.sig(m)?.fn_sig()?.params ?? []
        let typed = ["${s}: ${self.view.types.name_of(types[j])}" for j, s in seats if j < types.length]
        "(${typed.join(", ")}) -> ${tname}.${name}(${seats.join(", ")})"
    }

    /// The static fns a type declares, by name.
    fn static_names(decl: DeclId) -> List<string> {
        [self.view.decls.decl(m).name for m in self.view.decls.declared_methods(decl) if self.view.decls.is_static_of(m)]
    }

    /// A record's name answers only its own static fns: the ones it
    /// declares are the help, and one that declares none is told how a
    /// record is built.
    mut fn no_static_fn(e: ExprId, tname: string, name: string, statics: List<string>) -> TypeId {
        self
            .spoken(
                refusal(
                    "type.unknown_prop",
                    self.loc_of(e),
                    "`${tname}` has no static fn `${name}`",
                    "called here",
                    if statics.is_empty() { build_a_record(tname) } else { "its static fns are ${["`${s}`" for s in statics].join(", ")}" },
                ),
            )
    }

    mut fn no_such_variant(e: ExprId, tname: string, variant: string, sig: EnumSig) -> TypeId {
        self
            .spoken(
                refusal(
                    "type.unknown_prop",
                    self.loc_of(e),
                    "`${tname}` has no variant `${variant}`",
                    "built here",
                    variants_are(sig),
                ),
            )
    }

    mut fn carries_nothing(e: ExprId, tname: string, variant: string) -> TypeId {
        self
            .spoken(
                refusal(
                    "type.variant_arity",
                    self.loc_of(e),
                    "`${tname}.${variant}` carries nothing",
                    "given an argument here",
                    "write `${tname}.${variant}` on its own",
                ),
            )
    }

    mut fn cannot_pin(e: ExprId, tname: string, variant: string, tparam: string) -> TypeId {
        self
            .spoken(
                refusal(
                    "type.unknown_prop",
                    self.loc_of(e),
                    "`${tname}.${variant}` cannot pin `${tparam}` — nothing carries it",
                    "built here",
                    "a payload pins the type; the pinned unit surface is recorded",
                ),
            )
    }

    mut fn wrong_payload(v: ExprId, tname: string, variant: string, carried: TypeId) -> TypeId {
        let n = self.name_at(v)
        self
            .spoken(
                refusal(
                    "type.variant_arity",
                    self.loc_of(v),
                    "`${tname}.${variant}` carries `${self.view.types.name_of(carried)}`, found `${n}`",
                    this_is(n),
                    null,
                ),
            )
    }

    mut fn given_nothing(e: ExprId, tname: string, variant: string, carried: TypeId) -> TypeId {
        self
            .spoken(
                refusal(
                    "type.variant_arity",
                    self.loc_of(e),
                    "`${tname}.${variant}` carries `${self.view.types.name_of(carried)}`, given nothing",
                    "built empty here",
                    "write `${tname}.${variant}(<value>)`",
                ),
            )
    }

    mut fn unpinned_by_payload(e: ExprId, tparam: string) -> TypeId {
        self
            .spoken(
                refusal(
                    "type.unknown_prop",
                    self.loc_of(e),
                    "`${tparam}` is not pinned by the payload",
                    "built here",
                    "the pinned unit surface is recorded — carry `${tparam}` for now",
                ),
            )
    }
}

/// "ONE value" or "N values" — the arity as the refusal spells it.
fn count_word(n: int) -> string {
    if n == 1 { "ONE value" } else { "${n} values" }
}
