//! VARIANT CONSTRUCTION — `Type.variant(arg)`, the type-receiver
//! half of the one dot-call surface. Plain or generic, ONE law: the
//! variant must exist; a carrying variant takes exactly its payload
//! (which UNIFIES, pinning a generic declaration's Vars); the answer
//! is the declared type, instantiated when generic.
use core.{ExprId, TypeId, Type, ResSides, Arrow, TypeRef, filled, PlaceStep, StructSig, DeclId}
use diagnostics.{Diag, refusal}

/// Plain or generic, ONE law: the variant must exist; a carrying
/// variant takes exactly its payload (which UNIFIES, pinning a
/// generic declaration's Vars — with none, the unification IS the
/// plain agreement check); the answer is the declared type,
/// instantiated when generic.
export fn construct_variant(cx: TypeCx, e: ExprId, decl: DeclId, tname: string, variant: string, args: List<ExprId>) -> TypeId {
    let declared: EnumSig? = variants_declared(cx, decl, tname)
    if declared == null { return not_an_enum(cx, e, tname) }
    let sig = declared!
    if sig.tag_of(variant) == null { return no_such_variant(cx, e, tname, variant, sig) }
    let tp = cx.view.decls.tparams(decl)
    if tparams_refused(tp) { return cx.error_type }
    let held: TypeId? = sig.payload_of(variant)
    if held == null { return unit_variant(cx, e, tname, variant, tp) }
    let carried = held!
    let first: ExprId? = args.first()
    if first == null { return given_nothing(cx, e, tname, variant, carried) }
    if args.length > 1 {
        return spoken(cx, refusal("type.variant_arity", cx.loc_of(e), "`${tname}.${variant}` carries ONE value, given ${args.length}", "built here", "a variant's payload is a single value — wrap several in a record"))
    }
    let bound: List<TypeId?> = filled<TypeId?>(tp.length, null)
    if !unify(cx, carried, cx.type_at(first!), decl, bound) {
        return wrong_payload(cx, first!, tname, variant, carried)
    }
    instantiated(cx, e, tname, decl, tp, bound)
}

/// A unit variant given an argument list: the plain one carries
/// nothing; a generic one has nothing to PIN from either.
fn unit_variant(cx: TypeCx, e: ExprId, tname: string, variant: string, tp: List<string>) -> TypeId {
    if !tp.is_empty() { return cannot_pin(cx, e, tname, variant, tp[0]) }
    carries_nothing(cx, e, tname, variant)
}

/// The answer: the plain enum, or the App the bindings close into.
fn instantiated(cx: TypeCx, e: ExprId, tname: string, decl: DeclId,
                tp: List<string>, bound: List<TypeId?>) -> TypeId {
    if tp.is_empty() { return cx.view.types.intern(Type.Enum(decl, tname)) }
    let missing: string? = unpinned_of(tp, bound)
    if missing != null { return unpinned_by_payload(cx, e, missing!) }
    let concrete = bound_closed(cx, bound)
    cx.record_subst(e, decl, concrete)
    cx.view.types.intern(Type.App(decl, tname, concrete))
}

/// The raw declared table — Vars intact — or absence when the
/// declaration is a record. The REAL name interns: the registry
/// keeps the FIRST shape it sees for a key, so a throwaway name
/// here would poison every later printing of this enum.
fn variants_declared(cx: TypeCx, decl: DeclId, tname: string) -> EnumSig? {
    cx.variants_of(cx.view.types.intern(Type.Enum(decl, tname)))
}

// ── The voices ──

fn not_an_enum(cx: TypeCx, e: ExprId, tname: string) -> TypeId {
    spoken(cx, refusal("type.unknown_prop", cx.loc_of(e), "`${tname}` is a record, not an enum", "built here", build_a_record(tname)))
}

fn no_such_variant(cx: TypeCx, e: ExprId, tname: string, variant: string, sig: EnumSig) -> TypeId {
    spoken(cx, refusal("type.unknown_prop", cx.loc_of(e), "`${tname}` has no variant `${variant}`", "built here", variants_are(sig)))
}

fn carries_nothing(cx: TypeCx, e: ExprId, tname: string, variant: string) -> TypeId {
    spoken(cx, refusal("type.variant_arity", cx.loc_of(e), "`${tname}.${variant}` carries nothing", "given an argument here", "write `${tname}.${variant}` on its own"))
}

fn cannot_pin(cx: TypeCx, e: ExprId, tname: string, variant: string, tparam: string) -> TypeId {
    spoken(cx, refusal("type.unknown_prop", cx.loc_of(e), "`${tname}.${variant}` cannot pin `${tparam}` — nothing carries it", "built here", "a payload pins the type; the pinned unit surface is recorded"))
}

fn wrong_payload(cx: TypeCx, v: ExprId, tname: string, variant: string, carried: TypeId) -> TypeId {
    let n = cx.name_at(v)
    spoken(cx, refusal("type.variant_arity", cx.loc_of(v), "`${tname}.${variant}` carries a `${cx.view.types.name_of(carried)}`, found `${n}`", this_is(n), null))
}

fn given_nothing(cx: TypeCx, e: ExprId, tname: string, variant: string, carried: TypeId) -> TypeId {
    spoken(cx, refusal("type.variant_arity", cx.loc_of(e), "`${tname}.${variant}` carries a `${cx.view.types.name_of(carried)}`, given nothing", "built empty here", "write `${tname}.${variant}(<value>)`"))
}

fn unpinned_by_payload(cx: TypeCx, e: ExprId, tparam: string) -> TypeId {
    spoken(cx, refusal("type.unknown_prop", cx.loc_of(e), "`${tparam}` is not pinned by the payload", "built here", "the pinned unit surface is recorded — carry `${tparam}` for now"))
}
