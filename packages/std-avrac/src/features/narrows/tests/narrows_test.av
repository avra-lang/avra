// A type pattern's laws, each refusal rendered whole: its subject is a
// `dyn`, the type it names implements that `dyn`'s trait, and a `match`
// over a `dyn` keeps its catch-all.
use @std.avrac.compiler.{analyze_source, avra, new_workspace}
use @std.avrac.compiler.host.{memory_host}
use @std.avrac.testing.{refused_with}

spec "features/narrows" {
    given "the refusals, rendered whole" {
        then "a subject that is no `dyn` is refused, naming its type" {
            analyze_source(
                "trait Shape {\n    fn area() -> int\n}\ntype Sq = { s: int }\ntype Other = { o: int }\nimpl Shape for Sq {\n    fn area() -> int { self.s }\n}\n\nfn f(x: int) -> int {\n    match x {\n        c: Sq -> 1\n        _ -> 0\n    }\n}\n",
            )
                .report()
                .starts_with(
                    "error[type.narrow]: a type pattern narrows a `dyn` — this is `int`\n   ╭─[<source>:12:9]\n12 │         c: Sq -> 1\n   ·         ┬\n   ·         ╰── this is `int`\n───╯\nhelp: only a `dyn` hides which type it holds; match this value by its own shape",
                )
        }
        then "a `dyn` that may be absent is refused until unwrapped" {
            analyze_source(
                "trait Shape {\n    fn area() -> int\n}\ntype Sq = { s: int }\ntype Other = { o: int }\nimpl Shape for Sq {\n    fn area() -> int { self.s }\n}\n\nfn f(x: dyn Shape?) -> int {\n    match x {\n        c: Sq -> 1\n        _ -> 0\n    }\n}\n",
            )
                .report()
                .starts_with(
                    "error[type.narrow]: a type pattern narrows a `dyn`, and this `dyn Shape?` may be absent\n   ╭─[<source>:12:9]\n12 │         c: Sq -> 1\n   ·         ┬\n   ·         ╰── this is `dyn Shape?`\n───╯\nhelp: unwrap it first — a `v?` arm — then narrow the `dyn` it holds",
                )
        }
        then "a type that does not implement the trait is refused, naming both" {
            analyze_source(
                "trait Shape {\n    fn area() -> int\n}\ntype Sq = { s: int }\ntype Other = { o: int }\nimpl Shape for Sq {\n    fn area() -> int { self.s }\n}\n\nfn f(x: dyn Shape) -> int {\n    match x {\n        c: Other -> 1\n        _ -> 0\n    }\n}\n",
            )
                .report()
                .starts_with(
                    "error[type.narrow]: `Other` does not implement `Shape`, so no `dyn Shape` holds one\n   ╭─[<source>:12:9]\n12 │         c: Other -> 1\n   ·         ┬\n   ·         ╰── narrowed here\n───╯\nhelp: narrow to a type with an `impl Shape for …`",
                )
        }
        then "a match of type tests alone is refused: a `dyn` is open" {
            analyze_source(
                "trait Shape {\n    fn area() -> int\n}\ntype Sq = { s: int }\ntype Other = { o: int }\nimpl Shape for Sq {\n    fn area() -> int { self.s }\n}\n\nfn f(x: dyn Shape) -> int {\n    match x {\n        c: Sq -> 1\n    }\n}\n",
            )
                .report()
                .starts_with(
                    "error[type.match]: a `match` over `dyn Shape` needs a catch-all arm\n   ╭─[<source>:11:5]\n11 │     match x {\n   ·     ┬\n   ·     ╰── this match\n───╯\nhelp: end with `_ -> …` or `rest -> …`",
                )
        }
        then "a `dyn` target is refused: a box never holds a box" {
            analyze_source(
                "trait Shape {\n    fn area() -> int\n}\ntype Sq = { s: int }\ntype Box<T> = { v: T }\nimpl Shape for Sq {\n    fn area() -> int { self.s }\n}\n\nfn f(x: dyn Shape) -> int {\n    match x {\n        c: dyn Shape -> 1\n        _ -> 0\n    }\n}\n",
            )
                .report()
                .starts_with(
                    "error[type.narrow]: a type pattern names what a box holds, and `dyn Shape` is a box itself\n   ╭─[<source>:12:9]\n12 │         c: dyn Shape -> 1\n   ·         ┬\n   ·         ╰── narrowed here\n───╯\nhelp: narrow to a type with an `impl Shape for …`",
                )
        }
        then "a nullable target is refused: a box never holds absence" {
            analyze_source(
                "trait Shape {\n    fn area() -> int\n}\ntype Sq = { s: int }\ntype Box<T> = { v: T }\nimpl Shape for Sq {\n    fn area() -> int { self.s }\n}\n\nfn f(x: dyn Shape) -> int {\n    match x {\n        c: Sq? -> 1\n        _ -> 0\n    }\n}\n",
            )
                .report()
                .starts_with(
                    "error[type.narrow]: a box never holds absence, so no value is a `Sq?` here\n   ╭─[<source>:12:9]\n12 │         c: Sq? -> 1\n   ·         ┬\n   ·         ╰── narrowed here\n───╯\nhelp: narrow to `Sq`",
                )
        }
        then "a generic instance is refused: its instances share one tag" {
            analyze_source(
                "trait Shape {\n    fn area() -> int\n}\ntype Sq = { s: int }\ntype Box<T> = { v: T }\nimpl Shape for Sq {\n    fn area() -> int { self.s }\n}\n\nfn f(x: dyn Shape) -> int {\n    match x {\n        c: Box<int> -> 1\n        _ -> 0\n    }\n}\n",
            )
                .report()
                .starts_with(
                    "error[type.narrow]: a type pattern names one concrete type, and `Box<int>` is one instance of a generic — every instance shares one tag\n   ╭─[<source>:12:9]\n12 │         c: Box<int> -> 1\n   ·         ┬\n   ·         ╰── narrowed here\n───╯\nhelp: narrow to a type of your own that holds it — `type Ints = { held: List<int> }`",
                )
        }
        then "a built-in generic instance is refused the same way" {
            analyze_source(
                "trait Shape {\n    fn area() -> int\n}\ntype Sq = { s: int }\ntype Box<T> = { v: T }\nimpl Shape for Sq {\n    fn area() -> int { self.s }\n}\n\nfn f(x: dyn Shape) -> int {\n    match x {\n        c: List<int> -> 1\n        _ -> 0\n    }\n}\n",
            )
                .report()
                .starts_with(
                    "error[type.narrow]: a type pattern names one concrete type, and `List<int>` is one instance of a generic — every instance shares one tag\n   ╭─[<source>:12:9]\n12 │         c: List<int> -> 1\n   ·         ┬\n   ·         ╰── narrowed here\n───╯\nhelp: narrow to a type of your own that holds it — `type Ints = { held: List<int> }`",
                )
        }
        then "a type parameter target is refused: it names no one type" {
            analyze_source(
                "trait Shape {\n    fn area() -> int\n}\ntype Sq = { s: int }\ntype Box<T> = { v: T }\nimpl Shape for Sq {\n    fn area() -> int { self.s }\n}\n\nfn f<T>(x: dyn Shape, y: T) -> int {\n    match x {\n        c: T -> 1\n        _ -> 0\n    }\n}\n",
            )
                .report()
                .starts_with(
                    "error[type.narrow]: a type pattern names one concrete type, and `T` is a type parameter\n   ╭─[<source>:12:9]\n12 │         c: T -> 1\n   ·         ┬\n   ·         ╰── narrowed here\n───╯\nhelp: narrow to a declared type",
                )
        }
        then "an unknown type in a pattern is refused where it stands" {
            analyze_source(
                "trait Shape {\n    fn area() -> int\n}\ntype Sq = { s: int }\ntype Other = { o: int }\nimpl Shape for Sq {\n    fn area() -> int { self.s }\n}\n\nfn f(x: dyn Shape) -> int {\n    match x {\n        c: Nope -> 1\n        _ -> 0\n    }\n}\n",
            )
                .report()
                .starts_with(
                    "error[type.unknown]: `Nope` names no type\n   ╭─[<source>:12:9]\n12 │         c: Nope -> 1\n   ·         ┬\n   ·         ╰── in this type pattern\n───╯\nhelp: the types today are `int`, `string`, `bool`, and your declared types",
                )
        }
    }
}

spec "features/narrows — a type test under `is`" {
    given "a binding `is` anywhere but an `if` condition" {
        then "an operand of `&&` is refused as a payload `is` is" {
            refused_with(
                "trait Shape {\n    fn area() -> int\n}\ntype Sq = { s: int }\nimpl Shape for Sq {\n    fn area() -> int { self.s }\n}\nfn f(x: dyn Shape) -> int {\n    if x is q: Sq && true { 1 } else { 0 }\n}\n",
                "a payload `is` binds only in an `if` condition",
            )
        }
        then "under `!` it is refused as a payload `is` is" {
            refused_with(
                "trait Shape {\n    fn area() -> int\n}\ntype Sq = { s: int }\nimpl Shape for Sq {\n    fn area() -> int { self.s }\n}\nfn f(x: dyn Shape) -> int {\n    if !(x is q: Sq) { 1 } else { 0 }\n}\n",
                "a payload `is` binds only in an `if` condition",
            )
        }
        then "a `while` condition is refused as a payload `is` is" {
            refused_with(
                "trait Shape {\n    fn area() -> int\n}\ntype Sq = { s: int }\nimpl Shape for Sq {\n    fn area() -> int { self.s }\n}\nfn f(x: dyn Shape) -> int {\n    while x is q: Sq { return 1 }\n    0\n}\n",
                "a payload `is` binds only in an `if` condition",
            )
        }
    }
    given "the formatter" {
        then "prints `if x is q: Sq` back as written" {
            printed(
                    "trait Shape {\n    fn area() -> int\n}\n\ntype Sq = { s: int }\n\nimpl Shape for Sq {\n    fn area() -> int { self.s }\n}\n\nfn f(x: dyn Shape) -> int {\n    if x is q: Sq { q.s } else { 0 }\n}\n\nfn g(x: dyn Shape) -> int {\n    if x is q: Sq {\n        return q.s\n    }\n    1\n}\n",
                ) +
                "\n" == "trait Shape {\n    fn area() -> int\n}\n\ntype Sq = { s: int }\n\nimpl Shape for Sq {\n    fn area() -> int { self.s }\n}\n\nfn f(x: dyn Shape) -> int {\n    if x is q: Sq { q.s } else { 0 }\n}\n\nfn g(x: dyn Shape) -> int {\n    if x is q: Sq {\n        return q.s\n    }\n    1\n}\n"
        }
    }
}

/// A one-file program as the formatter prints it — its last line
/// unterminated, as `formatted_source` answers.
fn printed(src: string) -> string {
    let ws = new_workspace(memory_host({"/w/src/main.av": src}, ["/w/src/main.av"]), "/w", avra())
    match ws.formatted_source(ws.file_id("/w/src/main.av")) {
        .Ok(text) -> text,
        .Err(why) -> "refused: ${why}",
    }
}
