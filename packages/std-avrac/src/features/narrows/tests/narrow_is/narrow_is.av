// A `dyn` narrowed under an `if`: `x is q: Sq` binds for its branch, an
// `else if` chain tries the next type, and a guard needs no `else`.

trait Shape {
    fn area() -> int
}

type Sq = { s: int }

type Rect = { w: int, h: int }

impl Shape for Sq {
    fn area() -> int { self.s * self.s }
}

impl Shape for Rect {
    fn area() -> int { self.w * self.h }
}

fn side(x: dyn Shape) -> int {
    if x is q: Sq { q.s } else if x is r: Rect { r.w + 100 } else { 0 }
}

fn guarded(x: dyn Shape) -> int {
    if x is q: Sq {
        return q.s * 2
    }
    1
}

let a: dyn Shape = Sq { s: 3 }
let b: dyn Shape = Rect { w: 2, h: 5 }
"${side(a)} ${side(b)} ${guarded(a)} ${guarded(b)}"
