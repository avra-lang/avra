// proves: a `dyn` box minted in one package narrows in another — the
// type tag is the type's own, wherever the box was made.
use @test.shapes.{Shape, Sq, boxed, side}

type Tri = { b: int }

impl Shape for Tri {
    fn area() -> int { self.b }
}

fn mine(x: dyn Shape) -> int {
    match x { q: Sq -> q.s + 10, t: Tri -> t.b + 20, _ -> 0 }
}

let made_there = boxed(3)
let made_here: dyn Shape = Sq { s: 4 }
let own: dyn Shape = Tri { b: 5 }
"${mine(made_there)} ${side(made_here)} ${mine(own)} ${side(own)}"
