// The trait, one implementor, a box minted here, and a narrowing here.

export trait Shape {
    fn area() -> int
}

export type Sq = { s: int }

impl Shape for Sq {
    fn area() -> int { self.s * self.s }
}

export fn boxed(s: int) -> dyn Shape { Sq { s: s } }

/// Narrows whatever box it is handed, whichever package minted it.
export fn side(x: dyn Shape) -> int {
    match x { q: Sq -> q.s, _ -> 0 }
}
