//! The formatter's idioms for this feature — `rule`s, found by
//! directory like everything else this feature owns.

/// A null test that picks the value or a default is `??`.
///
/// NOT YET IN `avra test`'s gate (`compiler/rule_suite.av` names
/// why): the quote-pattern matcher cannot yet structurally match a
/// `Stmt.IfStmt` whose `then` and `else` are both non-empty — a
/// pre-existing defect, confirmed on the tree from before this
/// rule existed, both engines. The declaration is correct; its own
/// proof is blocked on that fix.
@fixes("if x == null { 0 } else { x! }", "x ?? 0")
@keeps("if next() == null { 0 } else { next()! }")
export rule if_null_ternary {
    quote { if ${x} == null { ${d} } else { ${x}! } } if x.pure() -> quote { ${x} ?? ${d} }
}
