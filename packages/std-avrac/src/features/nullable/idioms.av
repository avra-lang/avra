//! The formatter's idioms for this feature — `rule`s, found by
//! directory like everything else this feature owns.

/// A null test that picks the value or a default is `??`.
///
/// Written over the EXPRESSION `if` (`Expr.If`), where this idiom's
/// real targets live anyway — an arm's value, a `let`'s. The
/// parenthesised body is what forces the quote's parse to the
/// expression form: a paren group mints no node, so the pattern
/// still roots at the bare `Expr.If`.
@fixes("let v = if x == null { 0 } else { x! }", "x ?? 0")
@keeps("let v = if next() == null { 0 } else { next()! }")
export rule if_null_ternary {
    quote { (if ${x} == null { ${d} } else { ${x}! }) } if x.pure() -> quote { ${x} ?? ${d} },
}
