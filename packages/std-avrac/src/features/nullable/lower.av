//! The lowering rule — the ONE meaning. WHICH layout a nullable
//! takes is values.av's business (`repr_of` and its verbs); this
//! file only says what each consumer MEANS, and every consumer of
//! absence opens the SAME region on presence — so `??`'s right
//! side, the absent arm, and the chain's absence all run only when
//! the value is not there.
use core.{ExprId, StmtId, TypeId, Reg, Ins, Type}
use features.{LowerCx, StmtLowerCx, StructSig, foreign_node, presence_of, carried_of, carried_type,
              adopted, absent_of, insisted, hollow_of, okness_of, payload_of,
              lower_defect, slot_read, length_word}

fn nullable_reg(cx: LowerCx, e: ExprId) -> Reg {
    // LICENSED I22: a feature cannot enumerate OTHER features' variants
    match cx.view.store.expr(e) {
        .NullLit -> null_reg(cx, e),
        .Coalesce(l, r) -> coalesce_reg(cx, e, l, r),
        .Force(v) -> insisted(cx, e, cx.reg_of(v), cx.type_at(v)),
        .Propagate(v) -> propagate_reg(cx, e, v),
        .MatchOpt(s, _, p, a) -> match_opt_reg(cx, e, s, p, a),
        .Chain(s, name) -> chain_reg(cx, e, s, name),
        _ -> foreign_node(cx, e),
    }
}

/// The absence itself: a null constant, typed as absence. It has no
/// carried layout — the ADOPTING edge gives it one (values.av,
/// `adopted`), and for a niche this very value already is it.
fn null_reg(cx: LowerCx, e: ExprId) -> Reg {
    let dst = cx.result(e)
    cx.emit(Ins.ConstInt(dst, 0))
    dst
}

/// ONE region on PRESENCE — the shape every consumer of absence
/// opens: the present arm's value, then the absent arm's, merged
/// into the node's register. Thunks keep each arm's instructions
/// INSIDE its brackets, which is what makes the absent side lazy.
fn presence_region(cx: LowerCx, e: ExprId, v: Reg, held: TypeId,
                   present: fn() -> Reg, absent: fn() -> Reg) -> Reg {
    cx.emit(Ins.IfStart(presence_of(cx, v, held)))
    cx.emit(Ins.ArmEnd(present()))
    let answer = absent()
    let dst = cx.result(e)
    cx.emit(Ins.RegionEnd(dst, answer))
    dst
}

/// `l ?? r` — the present arm unwraps what `l` carries; the absent
/// arm answers with `r`, evaluated only then.
fn coalesce_reg(cx: LowerCx, e: ExprId, l: ExprId, r: ExprId) -> Reg {
    let v = cx.reg_of(l)
    let held = cx.type_at(l)
    presence_region(cx, e, v, held,
        () -> carried_of(cx, v, held),
        () -> cx.reg_of(r))
}

/// `match v { b? -> p, null -> a }` — the bind receives what the
/// nullable carries before the present arm lowers inside its
/// bracket; the absent arm is the other bracket.
fn match_opt_reg(cx: LowerCx, e: ExprId, subject: ExprId,
                 present: ExprId, absent: ExprId) -> Reg {
    let v = cx.reg_of(subject)
    let held = cx.type_at(subject)
    presence_region(cx, e, v, held,
        () -> {
            cx.bind_patterns(present, [carried_of(cx, v, held)])
            cx.reg_of(present)
        },
        () -> cx.reg_of(absent))
}

/// `v?` — the present arm unwraps what the nullable carries; the
/// absent arm makes the FN answer absence right here (`FnExit` —
/// the memory pass settles every open scope at the site) and
/// yields a hollow the merge never reads, since the backend parks
/// everything after the exit in a dead continuation.
fn propagate_reg(cx: LowerCx, e: ExprId, v: ExprId) -> Reg {
    let r = cx.reg_of(v)
    let held = cx.type_at(v)
    if cx.view.types.shape_of(held) is .Res { return propagate_res_reg(cx, e, r) }
    presence_region(cx, e, r, held,
        () -> carried_of(cx, r, held),
        () -> departed(cx, e))
}

/// `v?` on a RESULT: one region on OKNESS. The ok arm unwraps the
/// payload; the failure arm exits with THE SUBJECT'S OWN BOX — an
/// `.Err` of `Result<_, E>` is a valid `.Err` of every `Result<_,
/// E>`, so propagation moves the pointer and repacks nothing.
fn propagate_res_reg(cx: LowerCx, e: ExprId, r: Reg) -> Reg {
    cx.emit(Ins.IfStart(okness_of(cx, r)))
    cx.emit(Ins.ArmEnd(payload_of(cx, r, cx.type_at(e))))
    cx.emit(Ins.FnExit(r))
    let hollow = hollow_of(cx, cx.type_at(e))
    let dst = cx.result(e)
    cx.emit(Ins.RegionEnd(dst, hollow))
    dst
}

/// The absent arm's whole story: the enclosing fn answers absence.
fn departed(cx: LowerCx, e: ExprId) -> Reg {
    let ret: TypeId? = cx.enclosing_ret()
    if ret == null { return lower_defect(cx, e, "a propagation without an enclosing fn survived typing") }
    cx.emit(Ins.FnExit(absent_of(cx, ret!)))
    hollow_of(cx, cx.type_at(e))
}

/// `let v? = e else { ... }` — the same presence region, with the
/// merge REGISTER as the binding: the present arm yields the
/// carried value; the absent arm runs the else, which LEAVES
/// (typing enforced it), and yields a hollow the merge never
/// reads. The driver binds the answered register like any let's.
fn let_else_reg(cx: StmtLowerCx, s: StmtId) -> Reg? {
    let subject: ExprId? = cx.view.store.stmt_value(s)
    if subject == null { return null }
    let ex = cx.expr
    let v = ex.reg_of(subject!)
    let held = ex.type_at(subject!)
    ex.emit(Ins.IfStart(presence_of(ex, v, held)))
    ex.emit(Ins.ArmEnd(carried_of(ex, v, held)))
    cx.lower_stmts(else_stmts_of(cx.view.store.stmt(s)))
    let hollow = hollow_of(ex, carried_type(ex, held))
    let dst = ex.mint_ty(carried_type(ex, held))
    ex.emit(Ins.RegionEnd(dst, hollow))
    dst
}

/// `a?.b` — the member of the CARRIED value on the present arm,
/// lifted into the chain's nullable answer; absence on the other.
fn chain_reg(cx: LowerCx, e: ExprId, subject: ExprId, name: string) -> Reg {
    let v = cx.reg_of(subject)
    let held = cx.type_at(subject)
    let answer = cx.type_at(e)
    presence_region(cx, e, v, held,
        () -> lifted_member(cx, e, v, held, name, answer),
        () -> absent_of(cx, answer))
}

/// The present arm: read the member of what the subject carries,
/// then lift it into the chain's answer.
fn lifted_member(cx: LowerCx, e: ExprId, v: Reg, held: TypeId,
                 name: string, answer: TypeId) -> Reg {
    let member = member_reg(cx, e, carried_of(cx, v, held), carried_type(cx, held),
                            name, carried_type(cx, answer))
    adopted(cx, answer, false, member)
}

/// The member read on the carried value: a field's slot, or the
/// length word for the measurable shapes. `want` is what the CHAIN
/// expects the member to wear — the sig is the truth, and a
/// disagreement means the flatten rule changed without this
/// lowering learning it, which must break loudly, not lift twice.
fn member_reg(cx: LowerCx, e: ExprId, carried: Reg, held: TypeId,
              name: string, want: TypeId) -> Reg {
    let sig: StructSig? = cx.fields_of(held)
    if sig == null { return length_reg(cx, e, carried, held) }
    let slot: int? = sig!.slot_of(name)
    if slot == null { return lower_defect(cx, e, "a memberless chain survived typing") }
    // LICENSED I9: type identity — interned ids ARE the agreement
    if sig!.types[slot!].index != want.index {
        return lower_defect(cx, e, "a chain's member wears a type its lift does not expect")
    }
    slot_read(cx, carried, slot!, want)
}

/// `length` on the carried value — the word the one measure table
/// gives its shape; a shape nothing measures is a defect.
fn length_reg(cx: LowerCx, e: ExprId, carried: Reg, held: TypeId) -> Reg {
    let word: string? = length_word(cx.view.types.shape_of(held))
    if word == null { return lower_defect(cx, e, "a length on an unmeasurable shape survived typing") }
    let dst = cx.mint_shape(Type.Int)
    cx.emit(Ins.CallRt(dst, word!, [carried]))
    dst
}
