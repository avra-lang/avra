//! Parse-time lowering: the `null` keyword IS the node.
use core.{Expr, Scoped}
use features.{LangNode, Builder}

fn build_null(b: Builder) -> Result<LangNode, string> {
    b.make_expr(Expr.NullLit)
}

/// Both arm ORDERS build the same node — which arm is written first
/// is a matter of taste, and the node records the meaning, not the
/// order it was read in.
fn build_match_opt(b: Builder) -> Result<LangNode, string> {
    let subject = b.expr(0)?
    let bind = b.token(1)?
    let present = b.expr(2)?
    let absent = b.expr(3)?
    b.make_expr(Expr.MatchOpt(subject, Scoped(bind.text), present, absent))
}
