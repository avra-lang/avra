//! The nullability laws. `null` IS its own type — it inhabits every
//! `T?` and nothing else. `??` ANSWERS an absence: its left side
//! must be nullable, and the right must be what that nullable
//! carries; the answer is the carried type, never nullable again.
use core.{ExprId, StmtId, Type, TypeId, ResSides}
use features.{TypeCx, this_is, chained_binder}
use diagnostics.{refusal, warning, Diag}
use @std.errors.{Confidence, Edit, Loc, Suggestion}

fn nullable_type(mut cx: TypeCx, e: ExprId) -> TypeId {
    // a feature cannot enumerate OTHER features' variants
    match cx.view.store.expr(e) {
        .NullLit -> cx.view.types.intern(Type.Null),
        .Coalesce(l, r) -> coalesce_type(cx, l, r),
        .Force(v) -> forced_type(cx, v),
        .Propagate(v) -> propagate_type(cx, v),
        .MatchOpt(s, b, p, a) -> match_opt_type(cx, s, b.of, p, a),
        .Chain(s, name) -> chain_type(cx, e, s, name.of),
        rest -> cx.error_type,
    }
}

/// `a?.b` — the member of what the nullable CARRIES, nullable
/// again. The member is the SAME law `a.b` asks (checks.av), shown
/// as the carried type; the answer FLATTENS — a chain over a
/// nullable member is still ONE absence.
fn chain_type(mut cx: TypeCx, e: ExprId, subject: ExprId, name: string) -> TypeId {
    if cx.errored(subject) { return cx.error_type }
    let held? = cx.view.types.carried(cx.type_at(subject)) else { return not_chainable(cx, subject, name) }
    let member = cx.member_type_of(e, cx.view.types.name_of(held), held, name)
    if cx.errored_ty(member) { return cx.error_type }
    // a member that is itself nullable IS the chain's answer — the
    // flatten rule: `a?.b` never nests absence
    if cx.view.types.shape_of(member) is .Opt { return member }
    cx.nullable_over(member)
}

/// `l ?? r`: `l` is nullable and `r` fits what it carries — or is
/// the same nullable, and the chain stays nullable for the next
/// `??`. A left side that is never absent answers itself: silently
/// when a narrowing made it so, with a warning when it was never
/// nullable at all.
fn coalesce_type(mut cx: TypeCx, l: ExprId, r: ExprId) -> TypeId {
    if cx.errored(l) { return cx.error_type }
    let held: TypeId? = cx.view.types.carried(cx.type_at(l))
    if cx.shape_at(l) is .Null {
        return not_absent_able(
            cx,
            l,
            "type.coalesce",
            "`??` answers",
            "`??` always answers with the right side",
            "write the right side alone",
        )
    }
    if held == null { return never_absent(cx, l, r) }
    let carried = held!
    if cx.accepts(r, carried) { return carried }
    let whole = cx.type_at(l)
    if !cx.types_disagree(cx.type_at(r), whole) { return whole }
    wrong_answer(cx, r, carried)
}

/// A value that cannot be absent, asked as if it could: a narrowed
/// read is the carried value already — the ask is redundant and
/// silent; anything else earns a warning and answers itself.
fn never_absent(mut cx: TypeCx, v: ExprId, r: ExprId) -> TypeId {
    if cx.narrowed_at(v) == null { cx.emit(coalesce_never_fires(cx, v, r)) }
    cx.type_at(v)
}

/// The asking arms — `match v { b? -> p, null -> a }` and the
/// `if let b? = v` sugar build the SAME node: the subject must be
/// nullable, the bind carries what it holds, and the two arms JOIN
/// like any other pair of branches. Refusals name the BIND, so
/// both surfaces read their own words.
fn match_opt_type(mut cx: TypeCx, subject: ExprId, bind: string, present: ExprId, absent: ExprId) -> TypeId {
    if cx.errored(subject) { return cx.error_type }
    let held: TypeId? = cx.view.types.carried(cx.type_at(subject))
    if held == null {
        if bind == chained_binder {
            return not_absent_able(
                cx,
                subject,
                "type.chain",
                "`?.` reaches into",
                "`?.` reaches into what is never absent",
                "write `.` — the value is a guarantee",
            )
        }
        return not_absent_able(
            cx,
            subject,
            "type.match_opt",
            "`${bind}?` asks",
            "`${bind}?` can never bind",
            "write the absent arm's answer alone",
        )
    }
    // the bind holds what the nullable carries, spoken BEFORE the
    // arm walks, exactly as an enum arm's payload bind is
    cx.bind_types(present, [held!])
    let pt = cx.walk_type(present)
    let at = cx.walk_type(absent)
    // a chain into a call that answers nothing answers nothing: there
    // is no `void?` — the call runs when its subject is held
    if bind == chained_binder && cx.view.types.shape_of(pt) is .Void { return pt }
    let answer? = cx.join_of(pt, at) else { return arms_disagree(cx, present, absent) }
    let _ = cx.accepts(present, answer)
    let _ = cx.accepts(absent, answer)
    answer
}

/// `v!`: `v` is nullable and the answer is what it carries. A read
/// a narrowing already proved present is the carried value itself
/// — the force is redundant, and silent.
fn forced_type(mut cx: TypeCx, v: ExprId) -> TypeId {
    if cx.errored(v) { return cx.error_type }
    let held: TypeId? = cx.view.types.carried(cx.type_at(v))
    if held != null { return held! }
    if cx.narrowed_at(v) != null { return cx.type_at(v) }
    not_absent_able(
        cx,
        v,
        "type.force",
        "`!` insists on",
        "`!` always fails",
        "there is nothing here to insist on",
    )
}

/// `let v? = e else { ... }` — the bind-fresh form that KEEPS
/// GOING: the subject must be nullable; the bind holds what it
/// carries, recorded for every later read; the else types in its
/// own walk and must LEAVE, or control would reach the bind with
/// nothing bound.
fn check_let_else(mut cx: TypeCx, s: StmtId) {
    let v? = cx.view.store.stmt_value(s) else { return }
    let bind = cx.view.store.let_name(s) ?? "this binding"
    let held: TypeId? = cx.view.types.carried(cx.type_at(v))
    if held == null && !cx.errored(v) {
        let _ = not_absent_able(
            cx,
            v,
            "type.let_else",
            "`${bind}?` asks",
            "`${bind}?` can never bind",
            "the else always runs — write its statements alone",
        )
    }
    cx.record_binding(s, held ?? cx.error_type)
    let stmts = else_stmts_of(cx.view.store.stmt(s))
    cx.type_stmts(stmts)
    let last: StmtId? = stmts.last()
    if last == null || !cx.view.store.diverges(last!) { else_falls_through(cx, s, bind) }
}

/// `v?` PROPAGATES: a present value unwraps to what the nullable
/// carries; an absent one makes the ENCLOSING fn answer `null`
/// right where it stands — so there must BE an enclosing fn, and
/// its promise must itself be nullable.
fn propagate_type(mut cx: TypeCx, v: ExprId) -> TypeId {
    if cx.errored(v) { return cx.error_type }
    let sides: ResSides? = cx.view.types.res_parts(cx.type_at(v))
    if sides != null { return propagate_res_type(cx, v, sides!) }
    let held: TypeId? = cx.view.types.carried(cx.type_at(v))
    if held == null {
        return not_absent_able(
            cx,
            v,
            "type.propagate",
            "`?` propagates",
            "`?` always propagates",
            "write `return null`",
        )
    }
    let ret: TypeId? = cx.enclosing_ret()
    if ret == null {
        return no_caller(
            cx,
            v,
            "absence",
            "answer the absence here — `?? value`, or ask with `== null`",
        )
    }
    let promised = ret!
    if cx.errored_ty(promised) { return cx.error_type }
    if cx.view.types.carried(promised) != null { return held! }
    absence_unpromised(cx, v, promised)
}

/// `v?` on a RESULT — the failure channel: a present answer unwraps
/// to the ok side; a failure makes the enclosing fn answer THE SAME
/// failure, so the fn must promise a Result carrying the same E.
fn propagate_res_type(mut cx: TypeCx, v: ExprId, sides: ResSides) -> TypeId {
    let ret: TypeId? = cx.enclosing_ret()
    if ret == null {
        return no_caller(cx, v, "the failure", "handle it here — `match` the `.Ok`/`.Err`")
    }
    let promised = ret!
    if cx.errored_ty(promised) { return cx.error_type }
    let rsides? = cx.view.types.res_parts(promised) else { return failure_unpromised(cx, v, promised, sides) }
    if !cx.view.types.covers(rsides.err, sides.err) { return failures_disagree(cx, v, sides, rsides) }
    sides.ok
}

// ── The voices ──

/// The family's two mis-aims, worded once: an operator pointed at a
/// GUARANTEE (never absent), or at absence itself (always absent).
/// `asks` is the operator's verb phrase ("`!` insists on"), `so`
/// finishes "this is always absent, so ...", and `remedy` is the
/// always-absent arm's help. The chain refuses on its own words —
/// its guarantee remedy is actionable (`write .name`), not the
/// family's generic line.
fn coalesce_never_fires(cx: TypeCx, v: ExprId, r: ExprId) -> Diag {
    let n = cx.name_at(v)
    let loc = cx.loc_of(v)
    let d = warning(
        "type.coalesce_never",
        loc,
        "`??` never fires — a `${n}` is never absent",
        this_is(n),
        coalesce_never_remedy(),
    )
    let fix? = drop_coalesce_fix(loc, cx.loc_of(r)) else { return d }
    d with { suggestions: [fix] }
}

fn coalesce_never_remedy() -> string { "drop the `??` and its right side" }

/// The edit that turns `l ?? r` into `l`: delete from the left
/// side's own end to the right side's — the `??` and everything it
/// answers, whatever whitespace sits between. Absent when either
/// side carries no span (a synthesized node, never real source).
fn drop_coalesce_fix(lloc: Loc?, rloc: Loc?) -> Suggestion? {
    let l? = lloc else { return null }
    let r? = rloc else { return null }
    Suggestion {
        confidence: Confidence.High,
        description: coalesce_never_remedy(),
        edits: [Edit { loc: Loc { file: l.file, lo: l.hi, hi: r.hi }, replacement: "" }],
    }
}

fn not_absent_able(
    mut cx: TypeCx,
    v: ExprId,
    kind: string,
    asks: string,
    so: string,
    remedy: string,
) -> TypeId {
    if cx.shape_at(v) is .Null {
        return cx
            .spoken(
                refusal(
                    kind,
                    cx.loc_of(v),
                    "this is always absent, so ${so}",
                    "always absent",
                    remedy,
                ),
            )
    }
    let n = cx.name_at(v)
    cx
        .spoken(
            refusal(
                kind,
                cx.loc_of(v),
                "${asks} a nullable, this is `${n}`",
                this_is(n),
                "`${n}` is a guarantee — it is never absent",
            ),
        )
}

/// `?.` on a guarantee, or on absence itself — the same two
/// refusals `!` and `??` give, in the chain's words.
fn not_chainable(mut cx: TypeCx, subject: ExprId, name: string) -> TypeId {
    if cx.shape_at(subject) is .Null {
        return cx
            .spoken(
                refusal(
                    "type.chain",
                    cx.loc_of(subject),
                    "this is always absent, so `?.${name}` never reaches anything",
                    "always absent",
                    "there is nothing here to reach into",
                ),
            )
    }
    let n = cx.name_at(subject)
    cx
        .spoken(
            refusal(
                "type.chain",
                cx.loc_of(subject),
                "`?.` reaches into a nullable, this is `${n}`",
                this_is(n),
                "`${n}` is a guarantee — write `.${name}`",
            ),
        )
}

fn wrong_answer(mut cx: TypeCx, r: ExprId, carried: TypeId) -> TypeId {
    let n = cx.name_at(r)
    cx
        .spoken(
            refusal(
                "type.coalesce",
                cx.loc_of(r),
                "`??` answers with a `${cx.view.types.name_of(carried)}`, this is `${n}`",
                this_is(n),
                "a chain groups to the RIGHT — `a ?? (b ?? c)`",
            ),
        )
}

fn arms_disagree(mut cx: TypeCx, present: ExprId, absent: ExprId) -> TypeId {
    let n = cx.name_at(absent)
    cx
        .spoken(
            refusal(
                "type.match_opt",
                cx.loc_of(absent),
                "the arms disagree: `${cx.name_at(present)}` vs `${n}`",
                this_is(n),
                null,
            ),
        )
}

fn else_falls_through(mut cx: TypeCx, s: StmtId, bind: string) {
    cx
        .emit(
            refusal(
                "type.let_else",
                cx.stmt_loc(s),
                "the `else` must LEAVE — control cannot fall through to `${bind}`",
                "falls through",
                "end the else with `return`",
            ),
        )
}

fn absence_unpromised(mut cx: TypeCx, v: ExprId, promised: TypeId) -> TypeId {
    let promise = cx.view.types.name_of(promised)
    cx
        .spoken(
            refusal(
                "type.propagate",
                cx.loc_of(v),
                "`?` makes this fn answer `null`, but it promises a `${promise}`",
                "propagates here",
                propagate_remedy(cx, promised, promise),
            ),
        )
}

/// The nullable channel's remedy — shape-aware: a fn promising a
/// RESULT wants the failure channel, not a nullable answer.
fn propagate_remedy(cx: TypeCx, ret: TypeId, promise: string) -> string {
    if cx.view.types.shape_of(ret) is .Res {
        return "a nullable propagates `null` — to ride the failure channel, the subject must be a `Result`; answer the absence here with `??`"
    }
    "declare the answer nullable — `-> ${promise}?` — or answer the absence here with `??`"
}

/// `?` with no enclosing fn to pass to — the top level, or a lambda,
/// whose answer is inferred and so promises nothing.
fn no_caller(mut cx: TypeCx, v: ExprId, what: string, help: string) -> TypeId {
    if cx.behind_lambda() {
        return cx
            .spoken(
                refusal(
                    "type.propagate",
                    cx.loc_of(v),
                    "`?` passes ${what} to a caller, and a lambda promises none — its answer is inferred",
                    "inside this lambda",
                    help,
                ),
            )
    }
    cx
        .spoken(
            refusal(
                "type.propagate",
                cx.loc_of(v),
                "`?` passes ${what} to a caller, and the top level has none",
                "at the top level",
                help,
            ),
        )
}

fn failure_unpromised(mut cx: TypeCx, v: ExprId, promised: TypeId, sides: ResSides) -> TypeId {
    let promise = cx.view.types.name_of(promised)
    cx
        .spoken(
            refusal(
                "type.propagate",
                cx.loc_of(v),
                "`?` makes this fn answer the failure, but it promises a `${promise}`",
                "propagates here",
                "declare the answer fallible — `-> Result<${promise}, ${cx.view.types.name_of(sides.err)}>`",
            ),
        )
}

fn failures_disagree(mut cx: TypeCx, v: ExprId, sides: ResSides, promised: ResSides) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.propagate",
                cx.loc_of(v),
                "the failures disagree: this raises `${cx.view.types.name_of(sides.err)}`, the fn promises `${cx.view.types.name_of(promised.err)}`",
                "propagates here",
                "the promise must COVER what this raises — widen it to a union, or `catch` what does not fit",
            ),
        )
}
