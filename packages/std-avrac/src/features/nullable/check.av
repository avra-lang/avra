//! The nullability laws. `null` IS its own type — it inhabits every
//! `T?` and nothing else. `??` ANSWERS an absence: its left side
//! must be nullable, and the right must be what that nullable
//! carries; the answer is the carried type, never nullable again.
use core.{ExprId, Type, TypeId}
use features.{TypeCx, accepts, join_of, spoken, this_is,
              member_type_of, nullable_over}
use diagnostics.{error_at, pointed}

fn nullable_type(cx: TypeCx, e: ExprId) -> TypeId {
    // LICENSED I22: a feature cannot enumerate OTHER features' variants (the isolation doctrine); its own are listed
    match cx.store.expr(e) {
        .NullLit -> cx.types.intern(Type.Null),
        .Coalesce(l, r) -> coalesce_type(cx, l, r),
        .Force(v) -> forced_type(cx, v),
        .MatchOpt(s, b, p, a) -> match_opt_type(cx, s, b, p, a),
        .Chain(s, name) -> chain_type(cx, e, s, name),
        _ -> cx.error_type,
    }
}

/// `a?.b` — the member of what the nullable CARRIES, nullable
/// again. The member is the SAME law `a.b` asks (checks.av), shown
/// as the carried type; the answer FLATTENS — a chain over a
/// nullable member is still ONE absence.
fn chain_type(cx: TypeCx, e: ExprId, subject: ExprId, name: string) -> TypeId {
    if cx.shape_at(subject) is .Error { return cx.error_type }
    let held: TypeId? = cx.types.carried(cx.type_at(subject))
    if held == null { return not_chainable(cx, subject, name) }
    let member = member_type_of(cx, e, cx.types.name_of(held!), held!, name)
    if cx.types.shape_of(member) is .Error { return cx.error_type }
    nullable_over(cx, member)
}

/// `?.` on a guarantee, or on absence itself — the same two
/// refusals `!` and `??` give, in the chain's words.
fn not_chainable(cx: TypeCx, subject: ExprId, name: string) -> TypeId {
    if cx.shape_at(subject) is .Null {
        return spoken(cx, pointed(
            error_at("type.chain", cx.loc_of(subject),
                "this is always absent, so `?.${name}` never reaches anything"),
            "always absent")
            with { help: "there is nothing here to reach into" })
    }
    let n = cx.name_at(subject)
    spoken(cx, pointed(
        error_at("type.chain", cx.loc_of(subject),
            "`?.` reaches into a nullable, this is `${n}`"),
        this_is(n))
        with { help: "`${n}` is a guarantee — write `.${name}`" })
}

fn coalesce_type(cx: TypeCx, l: ExprId, r: ExprId) -> TypeId {
    if cx.shape_at(l) is .Error { return cx.error_type }
    let held: TypeId? = cx.types.carried(cx.type_at(l))
    if held == null { return not_nullable(cx, l) }
    let carried = held!
    if accepts(cx, r, carried) { return carried }
    let n = cx.name_at(r)
    spoken(cx, pointed(
        error_at("type.coalesce", cx.loc_of(r),
            "`??` answers with a `${cx.types.name_of(carried)}`, this is `${n}`"),
        this_is(n))
        with { help: "a chain groups to the RIGHT — `a ?? (b ?? c)`" })
}

/// The asking arms — `match v { b? -> p, null -> a }` and the
/// `if let b? = v` sugar build the SAME node: the subject must be
/// nullable, the bind carries what it holds, and the two arms JOIN
/// like any other pair of branches. Refusals name the BIND, so
/// both surfaces read their own words.
fn match_opt_type(cx: TypeCx, subject: ExprId, bind: string,
                  present: ExprId, absent: ExprId) -> TypeId {
    if cx.shape_at(subject) is .Error { return cx.error_type }
    let held: TypeId? = cx.types.carried(cx.type_at(subject))
    if held == null { return not_asked(cx, subject, bind) }
    // the bind holds what the nullable carries, spoken BEFORE the
    // arm walks, exactly as an enum arm's payload bind is
    cx.bind_type(present, held!)
    let pt = cx.walk_type(present)
    let at = cx.walk_type(absent)
    let both: TypeId? = join_of(cx, pt, at)
    if both != null {
        let answer = both!
        let _ = accepts(cx, present, answer)
        let _ = accepts(cx, absent, answer)
        return answer
    }
    let n = cx.name_at(absent)
    spoken(cx, pointed(
        error_at("type.match_opt", cx.loc_of(absent),
            "the arms disagree: `${cx.name_at(present)}` vs `${n}`"),
        this_is(n)))
}

/// The asking arms over a guarantee, or over absence itself — the
/// same two refusals `!`, `??` and `?.` give, in the arms' words.
fn not_asked(cx: TypeCx, subject: ExprId, bind: string) -> TypeId {
    if cx.shape_at(subject) is .Null {
        return spoken(cx, pointed(
            error_at("type.match_opt", cx.loc_of(subject),
                "this is always absent, so `${bind}?` can never bind"),
            "always absent")
            with { help: "write the absent arm's answer alone" })
    }
    let n = cx.name_at(subject)
    spoken(cx, pointed(
        error_at("type.match_opt", cx.loc_of(subject),
            "`${bind}?` asks a nullable, this is `${n}`"),
        this_is(n))
        with { help: "`${n}` is a guarantee — it is never absent" })
}

/// `v!` INSISTS: the answer is what the nullable carries, and a
/// guarantee has nothing to insist about.
fn forced_type(cx: TypeCx, v: ExprId) -> TypeId {
    if cx.shape_at(v) is .Error { return cx.error_type }
    let held: TypeId? = cx.types.carried(cx.type_at(v))
    if held != null { return held! }
    // A bare `null` is not a guarantee that happens to be absent —
    // it is absence itself, so the insistence can only ever fail.
    if cx.shape_at(v) is .Null {
        return spoken(cx, pointed(
            error_at("type.force", cx.loc_of(v),
                "this is always absent, so `!` always fails"),
            "always absent")
            with { help: "there is nothing here to insist on" })
    }
    let n = cx.name_at(v)
    spoken(cx, pointed(
        error_at("type.force", cx.loc_of(v),
            "`!` insists on a nullable, this is `${n}`"),
        this_is(n))
        with { help: "`${n}` is a guarantee — it is never absent" })
}

/// `??` on a guarantee is a question already answered — and on a
/// bare `null`, a question whose answer was written twice.
fn not_nullable(cx: TypeCx, l: ExprId) -> TypeId {
    if cx.shape_at(l) is .Null {
        return spoken(cx, pointed(
            error_at("type.coalesce", cx.loc_of(l),
                "this is always absent, so `??` always answers with the right side"),
            "always absent")
            with { help: "write the right side alone" })
    }
    let n = cx.name_at(l)
    spoken(cx, pointed(
        error_at("type.coalesce", cx.loc_of(l),
            "`??` answers a nullable, this is `${n}`"),
        this_is(n))
        with { help: "`${n}` is a guarantee — it is never absent" })
}
