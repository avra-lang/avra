//! The nullable semantics: dispatch only. Typing lives in check.av;
//! lowering — the MEANING — in lower.av. `??` is CONTROL-OWNING at
//! lowering (its right side runs only on absence) but plain for the
//! earlier passes: both sides resolve and type in the same scope.
use core.{Expr, ExprId, TypeId, Reg}
use features.{named_bind, NodeSemantics, ResolveCx, TypeCx, LowerCx, nothing, Meaning}

use core.expr.{NullLit, Coalesce, Force, Propagate, MatchOpt, Chain}

export type NullableSemantics = {}

impl NodeSemantics for NullableSemantics {
    fn kids(e: Expr) -> List<ExprId> {
        // a feature cannot enumerate OTHER features' variants
        match e {
            .Coalesce(l, r) -> [l, r],
            .Force(v) or .Propagate(v) -> [v],
            // the arms are hidden: each is typed under its own scope,
            // and the present one lowers INSIDE its region
            .MatchOpt(subject, _, _, _) or .Chain(subject, _) -> [subject],
            rest -> [],
        }
    }

    fn heirs(e: Expr) -> List<ExprId> {
        // a feature cannot enumerate OTHER features' variants
        match e { .MatchOpt(_, _, present, absent) -> [present, absent], _ -> [] }
    }

}

impl Meaning for NullLit {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        nullable_type(cx, e)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        nullable_reg(cx, e)
    }
}
impl Meaning for Coalesce {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        nullable_type(cx, e)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        nullable_reg(cx, e)
    }
}
impl Meaning for Force {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        nullable_type(cx, e)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        nullable_reg(cx, e)
    }
}
impl Meaning for Propagate {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        nullable_type(cx, e)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        nullable_reg(cx, e)
    }
}
impl Meaning for MatchOpt {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        cx.arm_scope(cx.bound_at(e, named_bind(self.bind.of)), self.present)
        cx.arm_scope([], self.absent)
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        nullable_type(cx, e)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        nullable_reg(cx, e)
    }
}
impl Meaning for Chain {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        nullable_type(cx, e)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        nullable_reg(cx, e)
    }
}
