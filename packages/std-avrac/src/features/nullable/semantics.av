//! The nullable semantics: dispatch only. Typing lives in check.av;
//! lowering — the MEANING — in lower.av. `??` is CONTROL-OWNING at
//! lowering (its right side runs only on absence) but plain for the
//! earlier passes: both sides resolve and type in the same scope.
use core.{Expr, ExprId, TypeId, Reg}
use features.{NodeSemantics, ResolveCx, TypeCx, LowerCx, nothing}

export type NullableSemantics = { }

impl NodeSemantics for NullableSemantics {
    fn kids(self, e: Expr) -> List<ExprId> {
        // LICENSED I22: a feature cannot enumerate OTHER features' variants
        match e {
            .Coalesce(l, r) -> [l, r],
            .Force(v) -> [v],
            .Propagate(v) -> [v],
            // the arms are hidden: each is typed under its own scope,
            // and the present one lowers INSIDE its region
            .MatchOpt(subject, _, _, _) -> [subject],
            .Chain(subject, _) -> [subject],
            _ -> [],
        }
    }

    fn heirs(self, e: Expr) -> List<ExprId> {
        // LICENSED I22: a feature cannot enumerate OTHER features' variants
        match e {
            .MatchOpt(_, _, present, absent) -> [present, absent],
            _ -> [],
        }
    }

    fn resolve(self, cx: ResolveCx, e: ExprId) {
        match cx.view.store.expr(e) {
            .MatchOpt(_, bind, present, absent) -> {
                cx.arm_scope(bind, present)
                cx.arm_scope("", absent)
            }
            _ -> nothing(),
        }
    }

    fn type_of(self, cx: TypeCx, e: ExprId) -> TypeId {
        nullable_type(cx, e)
    }

    fn lower(self, cx: LowerCx, e: ExprId) -> Reg {
        nullable_reg(cx, e)
    }
}
