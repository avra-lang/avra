//! The nullable semantics: dispatch only. Typing lives in check.av;
//! lowering — the MEANING — in lower.av. `??` is CONTROL-OWNING at
//! lowering (its right side runs only on absence) but plain for the
//! earlier passes: both sides resolve and type in the same scope.
use core.{ExprId, Type, TypeId, Reg, Kids, Heirs}
use features.{named_bind, ResolveCx, TypeCx, LowerCx, nothing, Meaning}

use core.expr.{NullLit, Coalesce, Force, Propagate, MatchOpt, Chain}

impl Kids for MatchOpt {
    /// The arms are hidden: each is typed under its own scope, and
    /// the present one lowers INSIDE its region.
    fn kids() -> List<ExprId> { [self.subject] }
}
impl Heirs for MatchOpt {
    fn heirs() -> List<ExprId> { [self.present, self.absent] }
}

impl Meaning for NullLit {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        cx.view.types.intern(Type.Null)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        null_reg(cx, e)
    }
}
impl Meaning for Coalesce {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        coalesce_type(cx, self.left, self.right)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        coalesce_reg(cx, e, self.left, self.right)
    }
}
impl Meaning for Force {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        forced_type(cx, self.subject)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        forced_reg(cx, self.subject)
    }
}
impl Meaning for Propagate {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        propagate_type(cx, self.subject)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        propagate_reg(cx, e, self.subject)
    }
}
impl Meaning for MatchOpt {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        cx.arm_scope(cx.bound_at(e, named_bind(self.bind.of)), self.present)
        cx.arm_scope([], self.absent)
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        match_opt_type(cx, self.subject, self.bind.of, self.present, self.absent)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        match_opt_reg(cx, e, self.subject, self.present, self.absent)
    }
}
impl Meaning for Chain {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        chain_type(cx, e, self.subject, self.name.of)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        chain_reg(cx, e, self.subject, self.name.of)
    }
}
