// `!` OF A TEMPORARY: the subject is a call's answer no binding names, so the scope that owns it
// must keep it until the answer's last read, or the answer reads a freed box.
fn fresh(n: int) -> List<string>? { ["s${i}" for i in 0..n] }

fn measured(n: int) -> string {
    let y = fresh(n)!
    let first = y[0]
    let z = fresh(n + 1)!
    "${first}${y.length}${z.length}${y[n - 1]}"
}

measured(3)
