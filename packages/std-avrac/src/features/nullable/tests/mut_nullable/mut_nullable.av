// proves: `mut x: T? = v` — the reassignable NULLABLE cell, the
// state-machine pattern: a pair rides the slot (two unmanaged
// words, so the cell law allows it), null and values assign in any
// order, and every read sees the declared type. Widening happens
// at the assignment, per slot law.
fn half(n: int) -> int? { if n % 2 == 0 { n / 2 } else { null } }

let best: int? = null
let i = 0
while i < 12 {
    best = half(i * 3) ?? (best ?? 0 - 1)
    i = i + 1
}
let latch: bool? = null
latch = true
latch = null
latch = false
let steps: int = 0
steps = steps + i
"best ${best ?? 0 - 9} latch ${if latch ?? true { 1 } else { 0 }} steps ${steps}"
