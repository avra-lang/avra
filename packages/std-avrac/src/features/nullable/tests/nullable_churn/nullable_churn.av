// proves: the niche under CHURN — 500 owned strings made, widened,
// answered and released through `??` and `match`, natively refcounted.
// The evaluator has no refcounts, so only this differential catches a
// wrong release: eval == native here IS the ownership proof.
fn tagged(n: int) -> string? {
    if n % 2 == 0 { "v${n}" } else { null }
}

let total = 0
let i = 0
while i < 500 {
    total = total + (tagged(i) ?? "-").length
    total = total + match tagged(i) {
        s? -> s.length
        null -> 1
    }
    i = i + 1
}
total
