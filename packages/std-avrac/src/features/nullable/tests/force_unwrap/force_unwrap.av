// proves: `!` insists on a nullable and answers what it carries —
// the third way to consume absence, after `??` reads it and the
// join produces it
fn halve(n: int) -> int? {
    if n % 2 == 0 { n / 2 } else { null }
}

fn twice(n: int) -> int {
    n + n
}

// the writer KNOWS 84 is even, and says so with `!`
let half = halve(84)!
let both = twice(halve(20)!)

// `!` and `??` answer the same absence differently
let sure = halve(10)!
let hedged = halve(7) ?? 99
"half ${half} both ${both} sure ${sure} hedged ${hedged}"
