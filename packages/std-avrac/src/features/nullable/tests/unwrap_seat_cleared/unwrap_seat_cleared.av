// `!` OF A FIELD HANDED, WITH ITS ROOT, TO A CALLEE THAT EMPTIES THE FIELD through a `mut` seat: the
// write releases the box the answer looks into, so the answer must hold its own across the call.
type Bag = { items: List<string>?, tag: string }

fn fresh(n: int) -> List<string>? { ["s${i}" for i in 0..n] }

fn emptied(mut b: Bag, xs: List<string>) -> string {
    b.items = null
    b.tag = "gone"
    let _ = fresh(9)
    "${xs.length}${xs[2]}"
}

mut b = Bag { items: fresh(0), tag: "" }
if b.tag == "" { b.items = fresh(4) }
let said = emptied(b, b.items!)
"${said} ${b.tag} ${b.items == null}"
