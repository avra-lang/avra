// proves: `match v { b? -> …, null -> … }` — the absence ASKED
// about, the third way to meet it after `??` reads it and `!`
// insists on it. Two arms exactly, because a nullable has two cases.
fn halve(n: int) -> int? {
    if n % 2 == 0 { n / 2 } else { null }
}

fn describe(n: int) -> int {
    match halve(n) {
        v? -> v * 10
        null -> 0 - 1
    }
}

// the arms may be written in either order
fn other_way(n: int) -> int {
    match halve(n) {
        v? -> v
        null -> 0
    }
}

let even = describe(84)
let odd = describe(7)
let flipped = other_way(20)
"even ${even} odd ${odd} flipped ${flipped}"
