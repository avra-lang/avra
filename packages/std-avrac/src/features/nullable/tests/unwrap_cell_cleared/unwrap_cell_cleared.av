// `!` OF A CELL'S VALUE HANDED TO A CALLEE THAT CLEARS THE CELL: the cell's reference goes with the
// clear, so the answer the callee still reads must hold its own.
fn fresh(n: int) -> List<string>? { ["s${i}" for i in 0..n] }

fn cleared(c: Cell<List<string>?>, xs: List<string>) -> string {
    c.set(null)
    let _ = fresh(9)
    "${xs.length}${xs[2]}"
}

let c: Cell<List<string>?> = Cell.new(fresh(4))
let said = cleared(c, c.get()!)
"${said} ${c.get() == null}"
