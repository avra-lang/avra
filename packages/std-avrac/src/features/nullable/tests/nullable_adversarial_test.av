// The RED TEAM's permanent record for the absence OPERATORS —
// `null`, `??`, `!`, and the two-arm match (see
// .claude/skills/red-team): every program here was written to BREAK
// the feature, not to use it. Grouped by attack class; the
// REPRESENTATION's record (the niche, its ownership, the chain)
// lives in nullable_repr_adversarial_test.av. A case that once
// produced a wrong answer, a crash, an internal defect, or an
// engine divergence keeps its place here forever.
use @std.avrac.language.{analyze_source}
use @std.avrac.testing.{shown, refusals, refused_with}

/// A nullable BOOL maker — the operand `!` meets under a condition.
fn mb() -> string {
    "fn mb(b: bool) -> bool? { b }\n"
}

/// A present-maker and an absent-maker over `int?`.
fn makers() -> string {
    "fn some(v: int) -> int? { v }\nfn none() -> int? { null }\n"
}

/// The spec's headline example — `if let`'s standard subject.
fn finder() -> string {
    "type User = { age: int }\n" +
    "fn find_user(id: int) -> User? { if id == 7 { User { age: 30 } } else { null } }\n"
}

spec "features/nullable (adversarial)" {
    given "degenerate shapes" {
        then "a bare `null` is not a printable answer" {
            match analyze_source("null").run() {
                .Err(msg) -> msg.contains("no text projection yet"),
                .Ok(_) -> false,
            }
        }
        then "`null ?? x` says the left is ALWAYS absent" {
            let a = analyze_source("null ?? 1")
            a.diagnostics.length == 1 && a.report().contains("always absent")
        }
        then "`null ?? null` refuses the same way" {
            refusals("null ?? null") == 1
        }
        then "`??` with nothing on the right refuses" {
            refusals("${makers()}none() ??") >= 1
        }
        then "`??` with nothing on the left refuses" {
            refusals("${makers()}?? 3") >= 1
        }
    }
    given "`!` — degenerate shapes" {
        then "one `!` unwraps" {
            shown("${makers()}some(7)!") == "7"
        }
        then "a second has nothing left to unwrap" {
            refused_with("${makers()}some(7)!!", "`!` insists on a nullable, this is `int`")
        }
        then "five earn ONE refusal, not four" {
            refusals("${makers()}some(7)!!!!!") == 1
        }
        then "no `!` at all leaves the nullable unprintable" {
            // The refusal is LOWERING's, not analysis's — `diagnostics`
            // is empty here, which is why this asks `run()`.
            match analyze_source("${makers()}some(7)").run() {
                .Err(msg) -> msg.contains("no text projection yet"),
                .Ok(_) -> false,
            }
        }
    }
    given "`!` — prefix NOT against postfix FORCE" {
        // `!` is both operators. Postfix binds tighter, so `!x!`
        // negates what was unwrapped, never unwraps a negation.
        then "`!x!` is `!(x!)`" {
            shown("${mb()}if !mb(false)! { 1 } else { 0 }") == "1"
        }
        then "and the true case agrees" {
            shown("${mb()}if !mb(true)! { 1 } else { 0 }") == "0"
        }
        then "`!!b` is still not-not" {
            shown("if !!true { 1 } else { 0 }") == "1"
        }
        then "a parenthesised force negates the same way" {
            shown("${mb()}if !(mb(false)!) { 1 } else { 0 }") == "1"
        }
        then "a `!` set off by a space still forces" {
            shown("${makers()}some(7) ! + 1") == "8"
        }
        then "a SECOND spaced `!` meets a bool" {
            refused_with("${mb()}if mb(true)! ! { 1 } else { 0 }",
                         "`!` insists on a nullable, this is `bool`")
        }
        then "`!` alone does not parse" {
            refusals("!") == 1
        }
    }
    given "`!` — every wrong type in the operand slot" {
        then "an int is a guarantee" {
            refused_with("1!", "`!` insists on a nullable, this is `int`")
        }
        then "a bool is a guarantee" {
            refused_with("true!", "`!` insists on a nullable, this is `bool`")
        }
        then "a string is a guarantee" {
            refused_with("\"s\"!", "`!` insists on a nullable, this is `string`")
        }
        then "a list is a guarantee" {
            refused_with("[1]!", "`!` insists on a nullable, this is `List<int>`")
        }
        then "a record is a guarantee" {
            refused_with("type P = { x: int }\nlet p = P { x: 1 }\np!",
                         "`!` insists on a nullable, this is `P`")
        }
        then "an enum value is a guarantee" {
            refused_with("enum E {\n    a\n    b\n}\nE.a!",
                         "`!` insists on a nullable, this is `E`")
        }
        then "a TYPE NAME is not a value to insist on" {
            refused_with("enum E {\n    a\n    b\n}\nE!", "`!` insists on a nullable")
        }
        then "a bare `null` is absence itself, and says so" {
            refused_with("null!", "this is always absent, so `!` always fails")
        }
    }
    given "`!` — crossing every other feature" {
        then "a fn body" {
            shown("${makers()}fn u(x: int?) -> int { x! }\nu(some(9))") == "9"
        }
        then "a fn return" {
            shown("${makers()}fn u() -> int { some(3)! }\nu()") == "3"
        }
        then "a `while` condition" {
            shown("${mb()}mut i = 0\nwhile mb(i < 2)! {\n    i = i + 1\n}\ni") == "2"
        }
        then "a `for` bound" {
            shown("${makers()}mut t = 0\nfor k in 0..some(3)! {\n    t = t + 1\n}\nt") == "3"
        }
        then "an `if` condition" {
            shown("${mb()}if mb(true)! { 1 } else { 0 }") == "1"
        }
        then "a `when` arm" {
            shown("${makers()}when {\n    1 == 2 -> 0\n    _ -> some(5)!\n}") == "5"
        }
        then "a `match` arm" {
            shown("${makers()}enum E {\n    a\n    b\n}\nmatch E.a {\n    .a -> some(6)!\n    .b -> 0\n}") == "6"
        }
        then "a list element" {
            shown("${makers()}[some(1)!, some(2)!]") == "[1, 2]"
        }
        then "a struct field value" {
            shown("${makers()}type P = { x: int }\nlet q = P { x: some(4)! }\nq.x") == "4"
        }
        then "an index" {
            shown("${makers()}let xs = [9, 8]\nxs[some(1)!]") == "8"
        }
        then "an interpolation hole" {
            shown("${makers()}\"v $" + "{some(7)!}\"") == "v 7"
        }
        then "a recursive call's argument" {
            shown("${makers()}fn d(n: int) -> int { if n <= 0 { 0 } else { n + d(n - 1) } }\nd(some(3)!)") == "6"
        }
        then "a `mut` binding" {
            shown("${makers()}mut x = some(5)!\nx = x + 1\nx") == "6"
        }
        then "beside `??` on the same absence" {
            shown("${makers()}some(5)! + (none() ?? 2)") == "7"
        }
    }
    given "`!` — names against names" {
        then "a shadowed outer binding" {
            shown("${makers()}let x = some(1)\nfn f(x: int) -> int { x }\nf(x!)") == "1"
        }
        then "the same name at two levels" {
            shown("${makers()}fn f(n: int?) -> int {\n    if true {\n        let n = some(3)\n        n!\n    } else { 0 }\n}\nf(some(1))") == "3"
        }
        then "a parameter named after the fn that makes it" {
            shown("${makers()}fn f(some: int?) -> int { some! }\nf(some(4))") == "4"
        }
    }
    given "`!` — ownership, where a mis-managed slot would show" {
        then "forced across two frames" {
            shown("${makers()}fn a(x: int?) -> int { b(x) }\nfn b(x: int?) -> int { x! }\na(some(11))") == "11"
        }
        then "the SAME nullable forced twice" {
            shown("${makers()}let v = some(5)\nv! + v!") == "10"
        }
        then "three hundred forced in a loop" {
            shown("${makers()}mut t = 0\nmut i = 0\nwhile i < 300 {\n    t = t + some(i)!\n    i = i + 1\n}\nt") == "44850"
        }
        then "a managed interpolation result carries the forced value" {
            shown("${mb()}\"r $" + "{mb(true)!}\"") == "r true"
        }
    }
    given "`!` — the refusal itself" {
        then "an ABSENT value refuses at RUNTIME, not compile time" {
            match analyze_source("${makers()}none()!").run() {
                .Err(msg) -> msg.contains("unwrapped an absent value"),
                .Ok(_) -> false,
            }
        }
        then "one mistake earns one message" {
            refusals("let a = 1\na! + 0") == 1
        }
        then "the guarantee refusal says WHY it is a guarantee" {
            refused_with("let x = 1\nx!", "is a guarantee — it is never absent")
        }
    }
    given "the absence in every wrong slot" {
        then "a condition wants a bool, not an absence" {
            refusals("if null { 1 } else { 2 }") == 1
        }
        then "arithmetic refuses an absence" {
            refusals("null + 1") == 1
        }
        then "an index subject refuses a nullable" {
            refusals("${makers()}some(1)[0]") == 1
        }
        then "a property refuses a nullable" {
            refusals("${makers()}some(1).length") == 1
        }
        then "a match subject refuses a nullable" {
            refusals("${makers()}match some(1) { .a -> 1 }") == 1
        }
        then "a nullable is not a printable answer either" {
            match analyze_source("${makers()}some(1)").run() {
                .Err(msg) -> msg.contains("no text projection yet"),
                .Ok(_) -> false,
            }
        }
    }
    given "the declared-slot law, which every slot shares" {
        then "a struct field refuses a nullable, in ITS words" {
            let a = analyze_source("type P = { x: int? }\nlet p = P { x: 1 }\np.x ?? 0")
            a.diagnostics.length == 1 && a.report().contains("a struct field cannot hold this yet")
        }
        then "an enum payload refuses a nullable, in ITS words" {
            let a = analyze_source("enum E {\n    a(int?)\n    b\n}\nmatch E.a(1) { .a(n) -> 0, .b -> 0 }")
            a.diagnostics.length == 1 && a.report().contains("an enum payload cannot hold this yet")
        }
        then "a list element refuses a nullable, in ITS words" {
            let a = analyze_source("${makers()}[some(1), none()]")
            a.diagnostics.length == 1 && a.report().contains("a list element cannot hold this yet")
        }
    }
    given "`if let`, adversarially — the sugar meets every law" {
        then "a KEYWORD bind refuses through the naming law" {
            refused_with("${finder()}if let while? = find_user(7) {\n    1\n} else {\n    0\n}",
                         "`while` is a keyword")
        }
        then "the bind DIES with the branch — no escape to the scope after" {
            refused_with("${finder()}let got = if let u? = find_user(7) {\n    u.age\n} else {\n    0\n}\nu.age",
                         "`u` is not defined")
        }
        then "disagreeing arms refuse through the sugar in the arms' words" {
            refused_with("${finder()}if let u? = find_user(7) {\n    u\n} else {\n    \"stranger\"\n}",
                         "the arms disagree: `User` vs `string`")
        }
        then "a single-line `if let` rides an interpolation hole" {
            shown("${finder()}\"got $" + "{if let u? = find_user(7) { u.age } else { 0 }}\"") == "got 30"
        }
        then "the SUBJECT reads the outer name; the bind shadows only inside" {
            shown("fn half(n: int) -> int? { if n % 2 == 0 { n / 2 } else { null } }\n" +
                  "let v = half(4)\nlet got = if let v? = v {\n    v * 10\n} else {\n    0 - 1\n}\n" +
                  "\"$" + "{got} and $" + "{v ?? 0 - 5}\"") == "20 and 2"
        }
        then "RECORDED FUTURE-FORM: `if let u = e` (no `?`) refuses today" {
            // a plain-binding if-let would be a NEW form — this pin
            // makes landing one a conscious change, not an accident
            refusals("${finder()}if let u = find_user(7) {\n    1\n} else {\n    0\n}") == 2
        }
    }
    given "the asking arms, mis-aimed" {
        then "arms over ABSENCE ITSELF say so — never call `null` a guarantee" {
            let a = analyze_source("match null {\n    v? -> 1\n    null -> 2\n}")
            a.diagnostics.length == 1 &&
                a.report().contains("always absent") &&
                !a.report().contains("guarantee")
        }
        then "arms over a guarantee name the BIND, not the form" {
            refused_with("let x = 1\nmatch x {\n    v? -> v\n    null -> 0\n}",
                         "`v?` asks a nullable, this is `int`")
        }
    }
    given "precedence, which decides what `??` even asks" {
        then "`??` binds TIGHTER than comparison — it asks about the ANSWER" {
            shown("${makers()}if none() ?? 0 == 0 { 1 } else { 2 }") == "1"
        }
        then "`??` binds LOOSER than arithmetic" {
            shown("${makers()}none() ?? 1 + 1") == "2"
        }
        then "`??` binds looser than `*` too" {
            shown("${makers()}none() ?? 2 * 3") == "6"
        }
        then "`&&` sees the answer, not the nullable" {
            shown("fn mb(b: bool) -> bool? { b }\nif mb(false) ?? false && true { 1 } else { 2 }") == "2"
        }
        then "an ungrouped chain refuses and says how to group it" {
            let a = analyze_source("${makers()}none() ?? none() ?? 7")
            a.diagnostics.length == 1 && a.report().contains("groups to the RIGHT")
        }
        then "the grouped chain answers" {
            shown("${makers()}none() ?? (none() ?? 7)") == "7"
        }
    }
    given "the join, where two branches must agree" {
        then "a value beside an absence joins to the nullable" {
            shown("fn f(b: bool) -> int? { if b { null } else { 3 } }\nf(false) ?? 0") == "3"
        }
        then "the absence may come FIRST" {
            shown("fn f(b: bool) -> int? { if b { 3 } else { null } }\nf(true) ?? 0") == "3"
        }
        then "an ALREADY nullable branch joins without lifting twice" {
            shown("fn f(n: int) -> int? { if n > 0 { if n > 5 { n } else { null } } else { null } }\nf(9) ?? 0") == "9"
        }
        then "a `when` arm joins with an absence too" {
            shown("fn f(b: bool) -> int? {\n    when {\n        b -> 1\n        _ -> null\n    }\n}\nf(true) ?? 0") == "1"
        }
        then "a `when` joins when the ABSENCE anchors" {
            shown("fn f(b: bool) -> int? {\n    when {\n        b -> null\n        _ -> 5\n    }\n}\nf(false) ?? 0") == "5"
        }
        then "a `match` arm joins with an absence" {
            shown("enum E {\n    a\n    b\n}\nfn f(e: E) -> int? {\n    match e {\n        .a -> 1\n        .b -> null\n    }\n}\nf(E.a) ?? 0") == "1"
        }
        then "a `match` joins when the absence comes FIRST" {
            shown("enum E {\n    a\n    b\n}\nfn f(e: E) -> int? {\n    match e {\n        .a -> null\n        .b -> 7\n    }\n}\nf(E.b) ?? 0") == "7"
        }
        then "an absent `match` arm answers absent" {
            shown("enum E {\n    a\n    b\n}\nfn f(e: E) -> int? {\n    match e {\n        .a -> null\n        .b -> 7\n    }\n}\nf(E.a) ?? 42") == "42"
        }
        then "an ALREADY nullable arm joins without lifting twice" {
            shown("fn g(v: int) -> int? { v }\nfn f(b: bool) -> int? {\n    when {\n        b -> g(3)\n        _ -> null\n    }\n}\nf(true) ?? 0") == "3"
        }
        then "arms that genuinely disagree STILL refuse" {
            let a = analyze_source("fn f(b: bool) -> int {\n    when {\n        b -> 1\n        _ -> \"s\"\n    }\n}\nf(true)")
            a.diagnostics.length == 1 && a.report().contains("arms disagree")
        }
        then "two disagreeing values still refuse" {
            refusals("fn f(b: bool) -> int { if b { 1 } else { \"s\" } }\nf(true)") == 1
        }
    }
    given "widening, at every boundary that has one" {
        then "an argument widens" {
            shown("fn ans(x: int?) -> int { x ?? 9 }\nans(33) + ans(null)") == "42"
        }
        then "a return widens" {
            shown("fn keep(x: int) -> int? { x }\nkeep(7) ?? 0") == "7"
        }
        then "a widen inside another call still lands" {
            shown("fn ans(x: int?) -> int { x ?? 9 }\nfn t(v: int) -> int { ans(v) }\nt(33)") == "33"
        }
        then "an absence crosses two fns unchanged" {
            shown("fn a() -> int? { null }\nfn b() -> int? { a() }\nb() ?? 5") == "5"
        }
        then "a nullable NEVER widens back" {
            let a = analyze_source("fn f(x: int) -> int { x }\n${makers()}f(some(1))")
            a.diagnostics.length == 1 &&
                a.report().contains("argument 1 of `f` wants `int`, found `int?`")
        }
    }
    given "crossing every other feature" {
        then "a `while` condition takes the answer" {
            shown("fn mb(b: bool) -> bool? { b }\nmut i = 0\nwhile mb(i < 3) ?? false {\n    i = i + 1\n}\ni") == "3"
        }
        then "a `for` bound takes the answer" {
            shown("${makers()}mut t = 0\nfor k in 0..(none() ?? 3) {\n    t = t + 1\n}\nt") == "3"
        }
        then "a list element takes the answer" {
            shown("${makers()}[none() ?? 1, some(2) ?? 0]") == "[1, 2]"
        }
        then "a struct field value takes the answer" {
            shown("type P = { x: int }\n${makers()}let p = P { x: none() ?? 7 }\np.x") == "7"
        }
        then "`with` takes the answer" {
            shown("type P = { x: int, y: int }\n${makers()}let base = P { x: 1, y: 2 }\nlet q = base with { x: none() ?? 9 }\nq.x") == "9"
        }
        then "an index takes the answer" {
            shown("${makers()}let xs = [10, 20, 30]\nxs[none() ?? 1]") == "20"
        }
        then "a variant payload takes the answer" {
            shown("${makers()}enum E {\n    a(int)\n    b\n}\nmatch E.a(none() ?? 7) { .a(n) -> n, .b -> 0 }") == "7"
        }
        then "a `mut` binding takes the answer" {
            shown("${makers()}mut x = none() ?? 1\nx = x + 1\nx") == "2"
        }
        then "an absence crosses five fns unchanged" {
            shown("fn a() -> int? { null }\nfn b() -> int? { a() }\nfn c() -> int? { b() }\nfn d() -> int? { c() }\nd() ?? 5") == "5"
        }
        then "eight grouped coalesces answer the innermost" {
            shown("fn n() -> int? { null }\nn() ?? (n() ?? (n() ?? (n() ?? (n() ?? (n() ?? (n() ?? (n() ?? 8)))))))") == "8"
        }
        then "a thousand nullables allocate and answer" {
            shown("fn some(v: int) -> int? { v }\nmut t = 0\nmut i = 0\nwhile i < 1000 {\n    t = t + (some(i) ?? 0)\n    i = i + 1\n}\nt") == "499500"
        }
    }
    given "the naming law, which reaches the absence" {
        then "`null` cannot be bound" {
            let a = analyze_source("let null = 1\nnull")
            a.diagnostics.length == 1 && a.report().contains("`null` is a keyword")
        }
        then "`null` cannot name a param" {
            let a = analyze_source("fn f(null: int) -> int { 1 }\nf(1)")
            a.diagnostics.length == 1 && a.report().contains("`null` is a keyword")
        }
        then "`null` cannot be CALLED — the literal wins the position" {
            refusals("null()") == 1
        }
        then "`null` cannot name a type" {
            let a = analyze_source("type null = { x: int }\n1")
            a.diagnostics.length == 1 && a.report().contains("`null` is a keyword")
        }
    }
    given "the right side, which must not run early" {
        then "a present left never evaluates the right" {
            shown("fn boom(x: int) -> int { x / 0 }\n${makers()}some(5) ?? boom(1)") == "5"
        }
        then "an absent left DOES evaluate it" {
            shown("fn double(x: int) -> int { x + x }\n${makers()}none() ?? double(21)") == "42"
        }
    }
}
