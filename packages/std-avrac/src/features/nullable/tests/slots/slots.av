// Slots: a nullable pointer rides the null niche in a field, a list
// and a payload; `[]` is adopted; equality reads through presence.
type P = { name: string?, tags: List<string> }
enum W {
    Named(n: string?)
}
fn label(p: P) -> string { p.name ?? "anon" }
fn same(a: string?, b: string?) -> bool { a == b }
let ps = [P { name: null, tags: [] }, P { name: "x", tags: ["t"] }]
let w = match W.Named("w") {
    .Named(n) -> n ?? "-",
}
"${label(ps[0])} ${label(ps[1])} ${ps[0].tags.length} ${ps[1].tags[0]} ${w} ${same(null, null)} ${same("a", null)} ${same("a", "a")} ${ps[1].name == "x"} ${ps[0].name != "x"}"
