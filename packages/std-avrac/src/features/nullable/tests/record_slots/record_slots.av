// proves: nullable scalars in records inside lists, through `with`, in
// payloads, in a const map, and under the scans — absence intact
type R = { id: int, score: int?, ok: bool? }
enum K {
    On(v: float?)
    Off
}
fn tally() -> Map<string, int?> {
    mut m: Map<string, int?> = {}
    m.set("x", null)
    m.set("y", 4)
    m
}
const T = tally()
let rs = [R { id: 1, score: null, ok: false }, R { id: 2, score: 7, ok: null }]
let r2 = rs[0] with { score: 3 }
let r3 = rs[1] with { score: null }
let ks = [K.On(null), K.On(1.5), K.Off]
let bs: List<bool?> = [false, null, true]
let fs: List<float?> = [0.5, null]
let kn = [match k {
    .On(v) -> v ?? 0 - 1.0,
    .Off -> 0.0,
} for k in ks]
"${rs[0].score ?? -1} ${rs[1].score ?? -1} ${rs[0].ok ?? true} ${r2.score ?? -1} ${r3.score ?? -1} ${r3.id} | ${kn[0]} ${kn[1]} ${kn[2]} | ${bs.contains(false)} ${bs.index_of(null)} ${bs.contains(true)} ${fs.contains(null)} ${fs.index_of(0.5)} | ${T.get("x") != null} ${T.get("x") ?? null ?? -1} ${T.get("y") ?? null ?? -1} ${T.length}"
