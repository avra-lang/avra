// proves: the PRESENCE TEST (`x != null` / `x == null` — the one
// comparison absence answers) and EFFECTIVELY-FINAL NARROWING: a
// let or param proven present reads as its carried type inside the
// proven branch — sugar over bind-fresh, and lowering unwraps each
// proven read at the same one edge widening lifts.
type User = { age: int }

fn find_user(id: int) -> User? {
    if id == 7 { User { age: 30 } } else { null }
}

fn half(n: int) -> int? {
    if n % 2 == 0 { n / 2 } else { null }
}

fn describe(u: User?) -> int {
    if u != null { u.age } else { 0 - 1 }
}

fn flipped(v: int?) -> int {
    if v == null { 0 - 5 } else { v * 10 }
}

let bound = find_user(7)
let doubled = if bound != null { bound.age * 2 } else { 0 }
let asked = if half(6) != null { 1 } else { 0 }
let missing = if half(3) == null { 1 } else { 0 }
"doubled ${doubled} hit ${describe(find_user(7))} miss ${describe(find_user(1))} ten ${flipped(half(2))} absent ${flipped(half(5))} asked ${asked} missing ${missing}"
