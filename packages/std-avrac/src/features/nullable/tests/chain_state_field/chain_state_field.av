// proves: a `?.` chain reaching a `state` field answers what its cell holds
// — a scalar and a list, present or absent, and a write through the field
// seen by the next chained read.
type C = { state n: int, state xs: List<string>, tag: string }

fn n_of(c: C?) -> int { c?.n ?? 0 }

fn count(c: C?) -> int { c?.xs?.length ?? 0 }

fn tag_of(c: C?) -> string { c?.tag ?? "-" }

let c = C { n: 5, xs: ["a"], tag: "t" }
let before = "${n_of(c)} ${count(c)} ${tag_of(c)}"
c.n = 7
c.xs.push("b")
"${before} | ${n_of(c)} ${count(c)} | ${n_of(null)} ${count(null)} ${tag_of(null)}"
