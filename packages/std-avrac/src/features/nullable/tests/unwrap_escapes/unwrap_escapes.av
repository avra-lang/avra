// `!` WHOSE ANSWER OUTLIVES ITS SUBJECT owns: returned, stored in a list, a field and a cell, and
// captured by a lambda — every subject dies in a scope that has closed.
type Bag = { items: List<string> }

fn fresh(n: int) -> List<string>? { ["s${i}" for i in 0..n] }

fn returned(n: int) -> List<string> { fresh(n)! }

fn listed(n: int) -> List<List<string>> { [fresh(n)!] }

fn bagged(n: int) -> Bag { Bag { items: fresh(n)! } }

fn celled(n: int) -> List<string> {
    mut held: List<string> = []
    held = fresh(n)!
    held
}

fn captured(n: int) -> fn() -> int {
    let y = fresh(n)!
    () -> y.length
}

let r = returned(2)
let l = listed(3)
let b = bagged(4)
let c = celled(5)
let f = captured(6)
"${r[1]} ${l[0][2]} ${b.items[3]} ${c[4]} ${f()}"
