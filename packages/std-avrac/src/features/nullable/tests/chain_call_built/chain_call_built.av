// proves: a chain reaches into a method and a text's length, absence at the first absent step.
type Leaf = { v: int }
impl Leaf { fn doubled() -> int { self.v * 2 } }
type Node = { leaf: Leaf?, name: string? }
fn f(n: Node?) -> int { n?.leaf?.doubled() ?? -1 }
fn g(n: Node?) -> int { n?.name?.length ?? 0 }
"${f(Node { leaf: Leaf { v: 4 }, name: "ab" })} ${f(Node { leaf: null, name: null })} ${f(null)} ${g(Node { leaf: null, name: "abc" })}"
