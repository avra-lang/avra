// proves: a `T?` seat takes a present value and pins `T` to it — a
// call argument, a struct field and an enum payload alike
type Slot<T> = { held: T? }
enum Maybe<T> {
    Has(T?)
    Nothing
}
fn ask<T>(x: T?) -> bool { x != null }
fn slot<T>(x: T) -> Slot<T> { Slot { held: x } }
fn has<T>(x: T) -> Maybe<T> { Maybe.Has(x) }
let n: int? = null
let s = slot(4)
let h = match has("h") { .Has(v) -> v ?? "-", .Nothing -> "none" }
"${ask(3)} ${ask(n)} ${ask("t")} ${s.held ?? 0} ${h}"
