// `!` WHOSE ANSWER RIDES ITS SUBJECT takes no count: the subject stands past every use of the
// answer, so the box `!` lets through is read under the subject's own reference.
fn fresh(n: int) -> List<string>? { ["s${i}" for i in 0..n] }

fn picked(x: List<string>?) -> string {
    let y = x!
    "${y.length}${y[1]}"
}

fn summed(xs: List<List<string>?>) -> int { [x!.length for x in xs].sum() }

let held = fresh(3)
"${picked(held)} ${picked(fresh(2))} ${summed([fresh(1), fresh(4)])} ${held!.length}"
