// proves: a nullable of a flat record of several fields holds the record in its box: present, each
// field reads back; absent, the fallback.
type Span = { lo: int, hi: int }

fn span_of(lo: int, hi: int) -> Span? {
    if hi < lo { return null }
    Span { lo: lo, hi: hi }
}

fn width(s: Span?) -> int {
    let held? = s else { return -1 }
    held.hi - held.lo
}

let a = span_of(3, 10)
let b = span_of(5, 2)
"${width(a)} ${width(b)} ${a?.lo ?? 0} ${a?.hi ?? 0} ${b?.lo ?? 99}"
