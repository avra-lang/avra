// proves: a nullable scalar rides a slot as its word and the cell's
// absent mark — in a field, a list, a payload, a map value and a cell
type Reading = { at: int, value: float?, ok: bool? }
enum Sample {
    Taken(n: int?)
    Skipped
}
fn show(x: int?) -> string {
    match x {
        v? -> "${v}"
        null -> "-"
    }
}
fn told(s: Sample) -> string {
    match s {
        .Taken(n) -> show(n),
        .Skipped -> "skip",
    }
}
let rs = [Reading { at: 1, value: 2.5, ok: true }, Reading { at: 2, value: null, ok: null }]
mut xs: List<int?> = [4, null]
xs.push(null)
xs.push(6)
xs[0] = null
xs.set(1, 5)
let last = xs.pop()
mut m: Map<string, int?> = {}
m.set("a", null)
m.set("b", 9)
let c: Cell<int?> = Cell.new(null)
c.set(3)
let firsts = "${rs[0].value ?? 0.0} ${rs[1].value ?? 0.0} ${rs[0].ok ?? false} ${rs[1].ok == null}"
let listed = [show(x) for x in xs].join(",")
let mapped = "${m.get("a") != null} ${show(m.get("a") ?? null)} ${show(m.get("b") ?? null)} ${m.get("z") == null}"
"${firsts} | ${listed} ${show(last)} | ${mapped} | ${told(Sample.Taken(null))} ${told(Sample.Taken(7))} | ${show(c.get())}"
