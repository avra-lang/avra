// Nullability, vertically: `T?` opts in to absence, `null` is that
// absence, `??` answers it — and the right side runs ONLY when the
// left is absent. Non-null by default is the law every refusal here
// is defending.
use @std.avrac.language.{analyze_source}
use @std.avrac.testing.{shown, refused_with, refusals}

/// A present-maker and an absent-maker over `int?`.
fn makers() -> string {
    "fn some(v: int) -> int? { v }\nfn none() -> int? { null }\n"
}

spec "features/nullable" {
    given "the absence and the answer" {
        then "a present value unwraps through `??`" {
            shown("${makers()}some(5) ?? 0") == "5"
        }
        then "an absent value takes the right side" {
            shown("${makers()}none() ?? 42") == "42"
        }
        then "a guarantee WIDENS into a nullable at the boundary" {
            shown("fn ans(x: int?) -> int { x ?? 9 }\nans(33) + ans(null)") == "42"
        }
        then "the right side is evaluated ONLY on absence" {
            shown("fn boom(x: int) -> int { x / 0 }\n${makers()}some(5) ?? boom(1)") == "5"
        }
        then "bools are nullable too" {
            shown("fn maybe(b: bool) -> bool? { b }\nif maybe(true) ?? false { 1 } else { 0 }") == "1"
        }
        then "a chain groups to the right" {
            shown("${makers()}none() ?? (none() ?? 7)") == "7"
        }
        then "a nullable param answers either way" {
            shown("fn ans(x: int?) -> int { x ?? 9 }\n${makers()}ans(none()) + ans(some(1))") == "10"
        }
    }
    given "`!` — the absence answered by insisting" {
        then "a present value unwraps" {
            shown("${makers()}some(41)! + 1") == "42"
        }
        then "an ABSENT value refuses at runtime, in both engines' words" {
            match analyze_source("${makers()}none()!").run() {
                .Err(msg) -> msg.contains("unwrapped an absent value"),
                .Ok(_) -> false,
            }
        }
        then "insisting on a GUARANTEE is refused at compile time" {
            refused_with("let x = 1\nx!", "`!` insists on a nullable, this is `int`")
        }
        then "a second `!` has nothing left to unwrap" {
            refused_with("${makers()}some(1)!!", "`!` insists on a nullable")
        }
        then "it composes with arithmetic" {
            shown("${makers()}some(20)! + some(22)!") == "42"
        }
        then "it composes with `??`" {
            shown("${makers()}some(5)! + (none() ?? 2)") == "7"
        }
        then "a bool nullable unwraps to a condition" {
            shown("fn mb(b: bool) -> bool? { b }\nif mb(true)! { 1 } else { 0 }") == "1"
        }
    }
    given "`?` — the absence passed to the caller" {
        then "a present value unwraps in place" {
            shown("fn half(v: int?) -> int? { v? / 2 }\n${makers()}half(some(84)) ?? 0 - 1") == "42"
        }
        then "an absent value makes the enclosing fn answer `null`" {
            shown("fn half(v: int?) -> int? { v? / 2 }\n${makers()}half(none()) ?? 0 - 1") == "-1"
        }
        then "the exit happens where the `?` stands — nothing after it runs" {
            shown("fn boom(x: int) -> int { x / 0 }\nfn f(v: int?) -> int? {\n    let x = v?\n    boom(x)\n}\n${makers()}f(none()) ?? 5") == "5"
        }
        then "the niche propagates too — a string rides its pointer" {
            shown("fn measured(w: string?) -> int? { (w?).length }\nfn word(b: bool) -> string? { if b { \"hey\" } else { null } }\n(measured(word(true)) ?? 0 - 1) + (measured(word(false)) ?? 0 - 1)") == "2"
        }
        then "`w?.length` stays the CHAIN — propagation before a member takes parens" {
            shown("fn a(w: string?) -> int? { w?.length }\nfn word(b: bool) -> string? { if b { \"hey\" } else { null } }\n(a(word(true)) ?? 0 - 1) + (a(word(false)) ?? 0 - 1)") == "2"
        }
        then "propagating a GUARANTEE is refused at compile time" {
            refused_with("fn f(x: int) -> int? { x? }\n${makers()}f(1) ?? 0",
                         "`?` propagates a nullable, this is `int`")
        }
        then "the top level has no caller to pass absence to" {
            refused_with("${makers()}some(1)?",
                         "`?` passes absence to a caller, and the top level has none")
        }
        then "the enclosing fn must promise a nullable" {
            refused_with("fn f(v: int?) -> int { v? }\n${makers()}f(some(1))",
                         "`?` makes this fn answer `null`, but it promises a `int`")
        }
        then "absence itself always propagates — refused as always absent" {
            refused_with("fn f() -> int? { null? }\nf() ?? 0",
                         "this is always absent, so `?` always propagates")
        }
    }
    given "`match` over an absence — the third consumer" {
        then "the present arm binds what the nullable carries" {
            shown("${makers()}match some(7) {\n    v? -> v + 1\n    null -> 0\n}") == "8"
        }
        then "the absent arm answers when it is absent" {
            shown("${makers()}match none() {\n    v? -> v + 1\n    null -> 42\n}") == "42"
        }
        then "`null` may be written FIRST — the node records meaning, not order" {
            shown("${makers()}match none() {\n    null -> 5\n    v? -> v\n}") == "5"
        }
        then "the bind is a value like any other, usable twice" {
            shown("${makers()}match some(4) {\n    v? -> v * v\n    null -> 0\n}") == "16"
        }
        then "it nests, each bind in its own scope" {
            shown("${makers()}match some(1) {\n    v? -> match some(2) {\n        w? -> v + w\n        null -> 0\n    }\n    null -> 0\n}") == "3"
        }
        then "asking a GUARANTEE is refused" {
            refused_with("let x = 1\nmatch x {\n    v? -> v\n    null -> 0\n}",
                         "`v?` asks a nullable, this is `int`")
        }
        then "the arms must agree, like any other pair of branches" {
            refused_with("${makers()}match some(1) {\n    v? -> v\n    null -> \"s\"\n}",
                         "the arms disagree: `int` vs `string`")
        }
        then "an ENUM match is untouched by the new branch" {
            shown("enum E {\n    a\n    b\n}\nmatch E.a {\n    .a -> 1\n    .b -> 0\n}") == "1"
        }
    }
    given "non-null by default" {
        then "`null` is not an `int`" {
            let a = analyze_source("fn f() -> int { null }\nf()")
            a.diagnostics.length == 1 &&
                a.report().contains("the body answers `null` but `f` declares `int`")
        }
        then "a nullable is not its value" {
            let a = analyze_source("${makers()}some(1) + 1")
            a.diagnostics.length == 1 && a.report().contains("`+` needs `int` operands, found `int?`")
        }
        then "a nullable never widens BACK" {
            let a = analyze_source("fn f(x: int) -> int { x }\n${makers()}f(some(1))")
            a.diagnostics.length == 1 &&
                a.report().contains("argument 1 of `f` wants `int`, found `int?`")
        }
    }
    given "`??`'s own law" {
        then "it answers a NULLABLE — a guarantee is already answered" {
            let a = analyze_source("1 ?? 2")
            a.diagnostics.length == 1 &&
                a.report().contains("`??` answers a nullable, this is `int`") &&
                a.report().contains("is a guarantee")
        }
        then "the right side carries the nullable's own type" {
            let a = analyze_source("${makers()}some(1) ?? \"s\"")
            a.diagnostics.length == 1 &&
                a.report().contains("`??` answers with a `int`, this is `string`")
        }
        then "an ungrouped chain says how to group it" {
            let a = analyze_source("${makers()}none() ?? none() ?? 7")
            a.diagnostics.length == 1 && a.report().contains("groups to the RIGHT")
        }
    }
    given "`if let` — the bind-fresh form, sugar over the asking arms" {
        then "the present branch binds what the nullable carries" {
            shown("${finder()}if let u? = find_user(7) {\n    u.age * 2\n} else {\n    0 - 1\n}") == "60"
        }
        then "the absent branch answers when nothing bound" {
            shown("${finder()}if let u? = find_user(3) {\n    u.age\n} else {\n    0 - 5\n}") == "-5"
        }
        then "it IS an expression — a `let` takes it whole" {
            shown("${finder()}let got = if let u? = find_user(7) {\n    u.age\n} else {\n    0\n}\ngot + 1") == "31"
        }
        then "the arms are BLOCKS — statements live inside" {
            shown("${finder()}if let u? = find_user(7) {\n    let doubled = u.age * 2\n    doubled + 1\n} else {\n    0\n}") == "61"
        }
        then "the bind lives in the present branch ONLY" {
            refused_with("${finder()}if let u? = find_user(7) {\n    u.age\n} else {\n    u.age\n}",
                         "`u` is not defined")
        }
        then "a GUARANTEE subject refuses in the BIND's words, not `match`'s" {
            refused_with("if let v? = 5 {\n    v\n} else {\n    0\n}",
                         "`v?` asks a nullable, this is `int`")
        }
        then "a missing `else` refuses for `if let`; plain elseless `if` is a STATEMENT now" {
            // The return arc fixed half the old parity debt: an
            // elseless multiline `if` is the guard statement. An
            // elseless `if let` still refuses — absence must be
            // answered.
            refusals("${finder()}if let u? = find_user(7) {\n    u.age\n}") == 2 &&
                refusals("if true {\n    1\n}") == 0
        }
        then "the chain feeds it — one nullable currency" {
            shown("${finder()}if let age? = find_user(7)?.age {\n    age + 100\n} else {\n    0\n}") == "130"
        }
        then "it nests, each bind in its own scope" {
            shown("${finder()}if let a? = find_user(7) {\n    if let b? = find_user(3) {\n        a.age + b.age\n    } else {\n        a.age\n    }\n} else {\n    0\n}") == "30"
        }
    }
    given "`let v? = e else` — bind through absence, keep going" {
        then "a present subject binds its carried value, enclosing scope" {
            shown("${finder()}fn age(id: int) -> int {\n    let u? = find_user(id) else {\n        return 0 - 1\n    }\n    u.age * 2\n}\nage(7)") == "60"
        }
        then "an absent subject leaves through the else" {
            shown("${finder()}fn age(id: int) -> int {\n    let u? = find_user(id) else {\n        return 0 - 1\n    }\n    u.age\n}\nage(3)") == "-1"
        }
        then "the else is a BLOCK — it works, then leaves" {
            shown("${finder()}fn age(id: int) -> int {\n    let u? = find_user(id) else {\n        let apology = 0 - 9\n        return apology\n    }\n    u.age\n}\nage(3)") == "-9"
        }
        then "a GUARANTEE subject refuses in the bind's words" {
            refused_with("fn f(x: int) -> int {\n    let a? = x else {\n        return 0\n    }\n    a\n}\nf(1)",
                         "`a?` asks a nullable, this is `int`")
        }
        then "an else that could FALL THROUGH refuses — the bind would be hollow" {
            refused_with("fn h(v: int?) -> int {\n    let a? = v else {\n        let x = 1\n    }\n    a\n}\nh(2)",
                         "the `else` must LEAVE — control cannot fall through to `a`")
        }
        then "an empty else refuses the same way" {
            refused_with("fn h(v: int?) -> int {\n    let a? = v else {\n    }\n    a\n}\nh(2)",
                         "the `else` must LEAVE")
        }
        then "the plain `let` is untouched — annotation, value, all of it" {
            shown("let a: int = 4\nlet b = a + 1\nb") == "5"
        }
    }
    given "the presence test and the narrow — `!= null` proves a branch" {
        then "`!= null` and `== null` answer bools, either operand order" {
            shown("${finder()}if find_user(7) != null { 1 } else { 0 }") == "1" &&
                shown("${finder()}if null == find_user(3) { 1 } else { 0 }") == "1"
        }
        then "a PARAM narrows in the proven branch — the ceremony retires" {
            shown("type U = { age: int }\nfn find(b: bool) -> U? { if b { U { age: 30 } } else { null } }\n" +
                  "fn describe(u: U?) -> int {\n    if u != null { u.age } else { 0 - 1 }\n}\n" +
                  "describe(find(true)) + describe(find(false))") == "29"
        }
        then "`== null` proves the ELSE branch" {
            shown("fn h(n: int) -> int? { if n % 2 == 0 { n / 2 } else { null } }\n" +
                  "fn f(v: int?) -> int { if v == null { 0 - 5 } else { v * 10 } }\n" +
                  "f(h(4)) + f(h(3))") == "15"
        }
        then "a LET narrows; the same read outside the branch still refuses" {
            shown("${finder()}let u = find_user(7)\nif u != null { u.age } else { 0 }") == "30" &&
                refused_with("${finder()}let u = find_user(7)\nif u != null { 1 } else { 0 }\nu.age",
                             "`.age` reads a guarantee, this is `User?`")
        }
        then "a MUT never narrows — reassignment could lie" {
            // LICENSED I4: the embedded SOURCE under test IS the nullable cell being proven
            refused_with("mut x: int? = 5\nlet a = if x != null { x + 1 } else { 0 }\na",
                         "`+` needs `int` operands, found `int?`")
        }
        then "the UNPROVEN branch stays wide" {
            refused_with("fn f(v: int?) -> int { if v != null { v } else { v + 1 } }\nf(1)",
                         "`+` needs `int` operands, found `int?`")
        }
        then "`!` under the narrow is told it insists on a GUARANTEE" {
            refused_with("fn f(v: int?) -> int { if v != null { v! } else { 0 } }\nf(1)",
                         "`!` insists on a nullable, this is `int`")
        }
        then "a GUARANTEE beside null refuses toward the family words" {
            refused_with("let n = 5\nif n != null { 1 } else { 0 }",
                         "`!= null` asks a nullable, this is `int`")
        }
        then "`null == null` is a question already answered" {
            refused_with("if null == null { 1 } else { 0 }", "always absent")
        }
        then "a NARROWED branch joins WIDE beside its own nullable" {
            shown("fn f(v: int?) -> int? {\n    if v != null { v } else { v }\n}\nf(4) ?? 9") == "4" &&
                shown("fn f(v: int?) -> int? {\n    if v != null { v } else { v }\n}\nf(null) ?? 9") == "9"
        }
        then "a narrowed read WIDENS back when a nullable slot claims it" {
            shown("fn f(v: int?) -> int {\n    if v != null {\n        let again: int? = v\n        again ?? 9\n    } else {\n        0\n    }\n}\nf(4)") == "4"
        }
    }
    given "the niche — a pointer-shaped nullable IS its value" {
        then "`string?` answers through `??`, present and absent" {
            shown("fn f(b: bool) -> string? { if b { \"x\" } else { null } }\nf(true) ?? \"y\"") == "x" &&
                shown("fn f(b: bool) -> string? { if b { \"x\" } else { null } }\nf(false) ?? \"y\"") == "y"
        }
        then "the spec's headline example types and runs: `find_user -> User?`" {
            shown("type User = { age: int }\n" +
                  "fn find_user(id: int) -> User? { if id == 7 { User { age: 30 } } else { null } }\n" +
                  "match find_user(7) {\n    u? -> u.age\n    null -> 0\n}") == "30"
        }
        then "`List<int>?` rides the same niche" {
            shown("fn f(b: bool) -> List<int>? { if b { [1, 2] } else { null } }\n(f(false) ?? [9]).length") == "1"
        }
        then "`!` insists on a niche nullable, and refuses in the shared words" {
            match analyze_source("fn f(b: bool) -> string? { if b { \"x\" } else { null } }\nf(false)!").run() {
                .Err(msg) -> msg.contains("unwrapped an absent value"),
                .Ok(_) -> false,
            }
        }
        then "a nullable param passes through by IDENTITY — widening is free" {
            shown("fn hand(s: string?) -> string? { s }\nhand(\"kept\") ?? \"lost\"") == "kept"
        }
        then "the present arm binds the CARRIED record, fields reachable" {
            shown("type P = { x: int }\nfn mk(b: bool) -> P? { if b { P { x: 4 } } else { null } }\n" +
                  "match mk(true) {\n    p? -> p.x * p.x\n    null -> 0\n}") == "16"
        }
    }
    given "`?.` — the chain: reach through, or answer absence" {
        then "a present subject answers its member, still nullable" {
            shown("${finder()}find_user(7)?.age ?? 0 - 1") == "30"
        }
        then "an absent subject short-circuits to the fallback" {
            shown("${finder()}find_user(3)?.age ?? 0 - 1") == "-1"
        }
        then "`length` reaches through a `string?` and a `List<int>?` alike" {
            shown("fn g(b: bool) -> string? { if b { \"hello\" } else { null } }\ng(true)?.length ?? 0") == "5" &&
                shown("fn f(b: bool) -> List<int>? { if b { [1, 2, 3] } else { null } }\nf(true)?.length ?? 0") == "3"
        }
        then "the chain's answer takes `!` — present proven, insisted" {
            shown("${finder()}find_user(7)?.age!") == "30"
        }
        then "a chain OVER the chain's nullable answer asks the carried scalar" {
            refused_with("${finder()}find_user(7)?.age?.length ?? 0",
                         "`length` lives on `List` and `string` values, found `int`")
        }
        then "a GUARANTEE subject is refused toward the plain read" {
            refused_with("type P = { x: int }\nlet p = P { x: 1 }\np?.x",
                         "`P` is a guarantee — write `.x`")
        }
        then "absence itself never reaches anything" {
            refused_with("null?.age", "this is always absent, so `?.age` never reaches anything")
        }
        then "an unknown member names the CARRIED type, not the nullable" {
            refused_with("${finder()}find_user(7)?.nope ?? 0", "no field `nope` on `User`")
        }
    }
}

/// The spec's own headline example, as test fixture.
fn finder() -> string {
    "type User = { age: int }\n" +
    "fn find_user(id: int) -> User? { if id == 7 { User { age: 30 } } else { null } }\n"
}
