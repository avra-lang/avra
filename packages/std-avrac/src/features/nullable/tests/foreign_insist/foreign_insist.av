// proves: `!` on a `ptr?` holds no reference to what it points at — a
// foreign pointer has no header to count, so an address with nothing
// mapped below it passes through the insist untouched, where a retain
// would read sixteen bytes that are not there.
extern fn avra_ptr_at(address: int) -> ptr?
fn held(_p: ptr) -> int { 1 }
let page = avra_ptr_at(65536)
let n = held(page!) + held(avra_ptr_at(8192)!)
"${n}"
