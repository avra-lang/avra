// proves: a nullable over a nullable keeps PRESENT-NULL apart from
// ABSENT in every slot — a generic `T?` over `T = string?` rides a
// pair, and `??` unwraps one level at a time
type Box<T> = { held: T? }
fn boxed<T>(x: T) -> Box<T> { Box { held: x } }
fn listed<T>(x: T) -> List<T?> { [x, null] }
fn keyed<T>(x: T) -> Map<string, T?> {
    mut m: Map<string, T?> = {}
    m.set("k", x)
    m.set("gone", null)
    m
}
fn words(x: string?) -> string { x ?? "[null]" }
fn held_word(b: Box<string?>) -> string {
    match b.held {
        null -> "absent"
        v? -> words(v)
    }
}
let none: string? = null
let some: string? = "s"
let l = listed(none)
let m = keyed(none)
let inner = match l[0] {
    null -> "absent"
    v? -> words(v)
}
let tail = match l[1] {
    null -> "absent"
    v? -> words(v)
}
let key = match m.get("k") {
    null -> "missing"
    v? -> match v {
        null -> "absent"
        w? -> words(w)
    }
}
let gone = match m.get("gone") {
    null -> "missing"
    v? -> match v {
        null -> "absent"
        w? -> words(w)
    }
}
let strs: List<string?> = [null]
let edge = match strs.first() {
    null -> "empty"
    v? -> words(v)
}
"${held_word(boxed(none))} ${held_word(boxed(some))} | ${inner} ${tail} | ${key} ${gone} | ${edge} | ${words(strs.first() ?? null)}"
