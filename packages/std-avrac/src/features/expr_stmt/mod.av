//! An expression alone on a line is a statement. Merges after the
//! keyword-led statement features, so their anchors win first.
use features.{LanguageFeature, BuilderRow}

export fn expr_stmt() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name        | build
        "expr_stmt" | build_expr_stmt
    }
    component LanguageFeature f {
        name = "expr_stmt"
        docs = "A bare expression, ended by the line; its value is the statement."
        gram = """
stmt = v:expression BREAK -> expr_stmt(v) @recover(sync_to: "BREAK")
"""
        builders = rows
    }
    f
}
