//! An expression alone on a line is a statement. Merges after the
//! keyword-led statement features, so their anchors win first.
use features.{LanguageFeature}
use @std.grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
export fn expr_stmt() -> LanguageFeature {
    LanguageFeature expr_stmt {
        gram: grammar {
            stmt = target:expression ( "=" value:expression )? END -> Stmt.Assign by expr_stmt_written @recover(sync_to: "END")
        }
    }
    expr_stmt
}
