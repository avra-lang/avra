//! The lowering rules of an expression standing as a statement, whose value is dropped, and of
//! `let _ =`, whose value is made and dropped.
use core.{Lowering, StmtId, StmtLowers}
use core.stmt.{Discard, ExprStmt}

impl StmtLowers for ExprStmt {
    fn stmt_lowered(mut cx: Lowering, s: StmtId) { let _ = cx.dropped(self.value) }
}

impl StmtLowers for Discard {
    fn stmt_lowered(mut cx: Lowering, s: StmtId) { let _ = cx.lower(self.value) }
}
