//! The typing rules of an expression standing as a statement, whose value is dropped, and of
//! `let _ =`, whose value is what it is.
use core.{Checking, Expected, StmtChecks, StmtId}
use core.stmt.{Discard, ExprStmt}

impl StmtChecks for ExprStmt {
    fn stmt_checked(mut cx: Checking, s: StmtId) { let _ = cx.check(self.value, Expected.Dropped) }
}

impl StmtChecks for Discard {
    fn stmt_checked(mut cx: Checking, s: StmtId) { let _ = cx.check(self.value, Expected.Free) }
}
