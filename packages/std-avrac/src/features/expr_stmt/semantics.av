//! The expression statement's StmtSemantics: its value is the
//! statement — walked, typed, evaluated, lowered; nothing binds.
use core.{StmtId, Reg}
use features.{StmtSemantics, StmtResolveCx, StmtTypeCx, StmtLowerCx}

export type ExprStmtSemantics = { }

impl StmtSemantics for ExprStmtSemantics {
    fn resolve_stmt(cx: StmtResolveCx, s: StmtId) {
        cx.walk_value(s)
    }

    fn type_stmt(cx: StmtTypeCx, s: StmtId) {
        cx.walk_value(s)
    }

    fn lower_stmt(cx: StmtLowerCx, s: StmtId) -> Reg? {
        cx.lower_value(s)
    }
}
