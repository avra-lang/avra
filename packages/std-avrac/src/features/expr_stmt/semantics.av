//! The expression statement's StmtSemantics: its value is the
//! statement — walked, typed, evaluated, lowered; nothing binds, and
//! the value is discarded unless a `collect` keeps it.
use core.{StmtId, Reg}
use features.{StmtSemantics, ResolveCx, TypeCx, LowerCx}

export type ExprStmtSemantics = {}

impl StmtSemantics for ExprStmtSemantics {
    fn resolve_stmt(mut cx: ResolveCx, s: StmtId) {
        cx.walk_value(s)
    }

    fn type_stmt(mut cx: TypeCx, s: StmtId) {
        cx.walk_value(s)
        cx.gather(s)
    }

    fn lower_stmt(mut cx: LowerCx, s: StmtId) -> Reg? {
        let r = cx.lower_value(s)
        cx.gather(s)
        r
    }
}
