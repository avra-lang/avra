//! The expression statement's StmtSemantics: its value is the
//! statement — walked, typed, evaluated, lowered; nothing binds.
use core.{StmtId, Reg}
use features.{StmtSemantics, StmtResolveCx, TypeCx, StmtLowerCx}

export type ExprStmtSemantics = { }

impl StmtSemantics for ExprStmtSemantics {
    fn resolve_stmt(mut cx: StmtResolveCx, s: StmtId) {
        cx.walk_value(s)
    }

    fn type_stmt(mut cx: TypeCx, s: StmtId) {
        cx.walk_value(s)
    }

    fn lower_stmt(mut cx: StmtLowerCx, s: StmtId) -> Reg? {
        cx.lower_value(s)
    }
}
