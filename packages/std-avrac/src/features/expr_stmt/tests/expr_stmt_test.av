// Expression statements through the driver, and the merge ORDER doing
// its job: let_stmt's keyword anchor wins before the expression
// branch sees the line.
use @std.avrac.language.{parse_source, Parsed}

fn is_expr_stmt(p: Parsed, i: int) -> bool { p.store.stmt(p.stmts[i]) is .ExprStmt }

fn is_let(p: Parsed, i: int) -> bool { p.store.stmt(p.stmts[i]) is .Let }

spec "features/expr_stmt" {
    given "expressions and lets interleaved" {
        then "each line lands as its own statement kind" {
            let p = parse_source("1 + 2\nlet x = 3\nx")
            p.voices.list.is_empty() && p.stmts.length == 3 &&
                is_expr_stmt(p, 0) && is_let(p, 1) && is_expr_stmt(p, 2)
        }
        then "the let keyword wins over the expression branch" {
            let p = parse_source("let x = 1")
            p.voices.list.is_empty() && p.stmts.length == 1 && is_let(p, 0)
        }
    }
    given "a broken expression line" {
        then "one diagnostic, a visible hole, and the next statement whole" {
            let p = parse_source("1 +\nlet y = 2")
            p.voices.list.length == 1 && p.stmts.length == 2 &&
                p.store.stmt(p.stmts[0]) is .Error && is_let(p, 1)
        }
    }
}
