//! The select NodeSemantics: dispatch only. Its arms are walked by
//! nothing: a `select` is refused where it is typed, so no pass reads
//! inside one.
use core.{Expr, ExprId}
use features.{NodeSemantics}

export type SelectSemantics = {}

impl NodeSemantics for SelectSemantics {
    // LICENSED fns.dead_parameter: the trait owns the seat
    fn kids(_e: Expr) -> List<ExprId> { [] }

    // LICENSED fns.dead_parameter: the trait owns the seat
    fn heirs(_e: Expr) -> List<ExprId> { [] }

}
