//! Typing laws shared across features and drivers — extracted at
//! their third copy, wording passed in so each site keeps its own
//! words. A LAW extracts at its SECOND: a rule copied by hand
//! disagrees with itself the day the copies drift (`member_type_of`
//! serves the bare read and the chain for exactly that reason).
use core.{ExprId, TypeId, Type}
use diagnostics.{Diag, error_at, pointed}

/// Speak and ABSORB: the diagnostic lands and the answer is the
/// interned Error — the standard refusal tail of a typing law.
export fn spoken(cx: TypeCx, d: Diag) -> TypeId {
    // LICENSED I14: this IS `spoken` — the pair's one home
    cx.emit(d)
    cx.error_type
}

/// The condition law: `subject` names the site ("an `if`
/// condition"), `label` points at it ("this decides the branch").
export fn require_bool(cx: TypeCx, e: ExprId, subject: string, label: string) {
    let sh = cx.shape_at(e)
    if !(sh is .Bool) && !(sh is .Error) {
        cx.emit(pointed(
            error_at("type.mismatch", cx.loc_of(e), "${subject} is a `bool`, found `${cx.name_at(e)}`"),
            label))
    }
}

/// The agreement law: an Error on EITHER side absorbs (its cause
/// already spoke); otherwise interned ids must match. True means
/// the site speaks, in its own words.
export fn types_disagree(cx: TypeCx, got: TypeId, want: TypeId) -> bool {
    if cx.shape_of(got) is .Error || cx.shape_of(want) is .Error { return false }
    // LICENSED I9: this IS the agreement law's body
    got.index != want.index
}

/// THE ASSIGNMENT LAW: what a slot of type `want` accepts from the
/// expression `e`. A guarantee widens INTO a nullable — an `int` IS
/// a valid `int?` — and the widening is RECORDED so lowering wraps
/// it. Absence never widens back: `int?` into `int` refuses, which
/// is the whole point of opting in. True means ACCEPTED.
export fn accepts(cx: TypeCx, e: ExprId, want: TypeId) -> bool {
    let got = cx.type_at(e)
    if !types_disagree(cx, got, want) { return true }
    let inner: TypeId? = opt_inner(cx, want)
    if inner == null { return false }
    // `null` inhabits every nullable; a present value must be the
    // carried type. Either way the lift is RECORDED, in this one
    // place — absence has no layout of its own, and lowering's
    // adoption edge mints each form from this record.
    let absent: bool = cx.shape_of(got) is .Null
    if !absent && types_disagree(cx, got, inner!) { return false }
    cx.widen(e, want)
    true
}

/// THE JOIN: the one type two branches can BOTH answer with, or
/// absent when there is none. Equal types join to themselves; a
/// value beside an ABSENCE joins to the nullable covering both.
/// PURE — `accepts` does the recording, so every branching
/// construct joins the same way by asking this and then accepting.
export fn join_of(cx: TypeCx, a: TypeId, b: TypeId) -> TypeId? {
    if !types_disagree(cx, a, b) { return a }
    if cx.shape_of(b) is .Null { return nullable_over(cx, a) }
    if cx.shape_of(a) is .Null { return nullable_over(cx, b) }
    // A guarantee beside ITS OWN nullable joins wide — a narrowed
    // branch meeting the un-narrowed name is the natural case, and
    // `accepts` then lifts the guarantee side.
    if carries(cx, b, a) { return b }
    if carries(cx, a, b) { return a }
    null
}

/// Does the nullable `opt` carry exactly `inner`?
fn carries(cx: TypeCx, opt: TypeId, inner: TypeId) -> bool {
    let held: TypeId? = opt_inner(cx, opt)
    held != null && !types_disagree(cx, held!, inner)
}

/// `T` covered by an absence: `T?`. An already-nullable type
/// stands — nothing is lifted twice, which is also why a chain
/// FLATTENS: `a?.b` over a nullable member answers ONE absence.
export fn nullable_over(cx: TypeCx, ty: TypeId) -> TypeId {
    if opt_inner(cx, ty) != null { return ty }
    cx.intern(Type.Opt(ty))
}

/// THE member law: what a type answers to a property name — a
/// record's field, or `length` on the measurable shapes. The bare
/// read (`a.b`) and the chain (`a?.b`) both ask HERE, so the two
/// spellings can never drift; `shown` is the subject as the caller
/// displays it.
export fn member_type_of(cx: TypeCx, e: ExprId, shown: string, ty: TypeId, name: string) -> TypeId {
    // Members live on GUARANTEES: a nullable subject's remedy is
    // the chain, never a property list it does not have.
    if cx.shape_of(ty) is .Opt {
        return spoken(cx, pointed(
            error_at("type.mismatch", cx.loc_of(e), "`.${name}` reads a guarantee, this is `${shown}`"),
            this_is(shown))
            with { help: "`?.${name}` reaches through the absence — or answer it first with `??`" })
    }
    let sig: StructSig? = cx.fields_of(ty)
    if sig != null { return field_member(cx, e, shown, sig!, name) }
    if name == "length" { return length_member(cx, e, shown, ty) }
    spoken(cx, pointed(
        error_at("type.unknown_prop", cx.loc_of(e), "no property `${name}` on `${shown}`"),
        "read here")
        with { help: "the one property today is `length`" })
}

/// A record's property IS a declared field; a miss names the
/// fields that exist.
fn field_member(cx: TypeCx, e: ExprId, shown: string, sig: StructSig, name: string) -> TypeId {
    let i: int? = sig.slot_of(name)
    if i != null { return sig.types[i!] }
    spoken(cx, pointed(
        error_at("type.unknown_prop", cx.loc_of(e), "no field `${name}` on `${shown}`"),
        "read here")
        with { help: fields_are(sig) })
}

/// `length` measures the shapes with an extent.
fn length_member(cx: TypeCx, e: ExprId, shown: string, ty: TypeId) -> TypeId {
    let sh = cx.shape_of(ty)
    if sh is .List || sh is .Str { return cx.intern(Type.Int) }
    spoken(cx, pointed(
        error_at("type.mismatch", cx.loc_of(e), "`length` lives on `List` and `string` values, found `${shown}`"),
        this_is(shown)))
}

/// THE DECLARED-BINDING LAW: an annotated binding holds what it
/// declares — the value must be ACCEPTED by the written type, its
/// widening recorded like any other slot's. Every annotated
/// binding form asks here, so the wording never drifts.
export fn declared_binding(cx: TypeCx, v: ExprId, name: string, declared: TypeId) {
    if cx.shape_of(declared) is .Error { return }
    if cx.shape_at(v) is .Error { return }
    // A TYPE standing where the value belongs already spoke through
    // the value law — a second refusal would be a cascade.
    if cx.shape_at(v) is .TypeName { return }
    if accepts(cx, v, declared) { return }
    let n = cx.name_at(v)
    cx.emit(pointed(
        error_at("type.binding", cx.loc_of(v),
            "`${name}` declares `${cx.type_name(declared)}`, this is `${n}`"),
        this_is(n)))
}

/// What a nullable carries, or absent when the type is not one.
export fn opt_inner(cx: TypeCx, ty: TypeId) -> TypeId? {
    match cx.shape_of(ty) {
        .Opt(inner) -> inner,
        _ -> null,
    }
}

/// The VALUE law: a type NAME is not a value. `Color` alone is
/// legal only as a property subject (`Color.red`), so anywhere a
/// value is consumed it refuses here — and no type-name shape ever
/// reaches lowering, where it could only be a defect. True means
/// refused.
export fn refuses_type_value(cx: TypeCx, e: ExprId) -> bool {
    let sh: Type = cx.shape_at(e)
    let tname: string? = match sh {
        .TypeName(_, n) -> n,
        _ -> null,
    }
    if tname == null { return false }
    let n = tname!
    cx.emit(pointed(
        error_at("type.type_value", cx.loc_of(e), "`${n}` is a type, not a value"),
        "used as a value here")
        with { help: "name a variant (`${n}.<variant>`) or build a record (`${n} { ... }`)" })
    true
}

/// The ARMS law: every arm agrees with the anchor, or each
/// disagreeing arm speaks for itself; the answer is the anchor's
/// type, or Error when any disagreed. `subject` names the construct
/// and `anchor_name` says where the anchor came from, so each site
/// keeps its own words.
export fn arms_agree(cx: TypeCx, kind: string, subject: string, anchor_name: string,
                     anchor: ExprId, values: List<ExprId>) -> TypeId {
    let want = arms_answer(cx, anchor, values)
    mut agreed = true
    for v in values {
        if !accepts(cx, v, want) {
            let n = cx.name_at(v)
            cx.emit(pointed(
                error_at(kind, cx.loc_of(v),
                    "a `${subject}`'s arms disagree: `${n}` vs ${anchor_name}'s `${cx.type_name(want)}`"),
                this_is(n)))
            agreed = false
        }
    }
    if !agreed { return cx.error_type }
    // The anchor lands in the answer too — it may be the side that
    // lifts when another arm is an absence.
    let _ = accepts(cx, anchor, want)
    want
}

/// The type every arm can answer with: the anchor's, JOINED with
/// each arm in turn. One absent arm makes the whole answer nullable.
fn arms_answer(cx: TypeCx, anchor: ExprId, values: List<ExprId>) -> TypeId {
    mut want = cx.type_at(anchor)
    for v in values {
        let both: TypeId? = join_of(cx, want, cx.type_at(v))
        if both != null { want = both! }
    }
    want
}

/// The pointing label every mismatch uses: the offender, named.
export fn this_is(n: string) -> string {
    "this is a `${n}`"
}
