//! THE SHARED TYPING LAWS: agreement (`accepts`, one door for every
//! slot), the join of branches, member reads, the declared binding,
//! the call's seats, places and void — and the voices they speak.
//! Unification lives in unify.av, variant construction in
//! variants.av; every feature's rule calls in, none re-spells.
use core.{ExprId, TypeId, Type, ResSides, Arrow, TypeRef, filled, PlaceStep, DeclId, Binding, StmtId}
use diagnostics.{Diag, refusal, warning}

/// Speak and ABSORB: the diagnostic lands and the answer is the
/// interned Error — the standard refusal tail of a typing law.
export fn spoken(mut cx: TypeCx, d: Diag) -> TypeId {
    // LICENSED I14: this IS `spoken` — the pair's one home
    cx.emit(d)
    cx.error_type
}

/// The condition law: `subject` names the site ("an `if`
/// condition"), `label` points at it ("this decides the branch").
export fn require_bool(mut cx: TypeCx, e: ExprId, subject: string, label: string) {
    if !(cx.shape_at(e) is .Bool) { require_spoken(cx, e, subject, "bool", label) }
}

/// The counting law, the condition law's twin: a bound or an index
/// is an int.
export fn require_int(mut cx: TypeCx, e: ExprId, subject: string, label: string) {
    if !(cx.shape_at(e) is .Int) { require_spoken(cx, e, subject, "int", label) }
}

fn require_spoken(mut cx: TypeCx, e: ExprId, subject: string, wanted: string, label: string) {
    if cx.errored(e) { return }
    cx.emit(refusal("type.mismatch", cx.loc_of(e), "${subject} is a `${wanted}`, found `${cx.name_at(e)}`", label, null))
}

/// The agreement law: an Error on EITHER side absorbs (its cause
/// already spoke); otherwise interned ids must match. True means
/// the site speaks, in its own words.
export fn types_disagree(cx: TypeCx, got: TypeId, want: TypeId) -> bool {
    if cx.errored_ty(got) || cx.errored_ty(want) { return false }
    // LICENSED I9: this IS the agreement law's body
    got.index != want.index
}

/// THE ONE AGREEMENT DOOR for a UNIFIED seat. `unify` binds the
/// declaration's Vars; `accepts` is what RECORDS the lift lowering
/// mints, and a seat whose Vars are all bound is concrete NOW. A
/// seat still naming a free Var is re-judged at instantiation.
export fn unified_lift(mut cx: TypeCx, e: ExprId, want: TypeId, decl: DeclId, bound: Pins) -> bool {
    if !fully_bound(cx, want, decl, bound) { return false }
    accepts(cx, e, cx.view.types.substituted(want, decl, bound_args(cx, bound)))
}

/// THE SLOT VOICES, shared by every aggregate seat: `what` names the
/// seat ("a list element", "a map value").
export fn unslottable(mut cx: TypeCx, head: ExprId, what: string) -> TypeId {
    if cx.shape_at(head) is .Void {
        return spoken(cx, refusal("type.list_scalar", cx.loc_of(head), "${what} cannot hold nothing — this answers no value", "answers nothing", null))
    }
    spoken(cx, refusal("type.list_scalar", cx.loc_of(head), "${what} cannot hold this yet", this_is(cx.name_at(head)), slice_promise("elements")))
}

export fn unslottable_want(mut cx: TypeCx, e: ExprId, want: TypeId, what: string) -> TypeId {
    spoken(cx, refusal("type.list_scalar", cx.loc_of(e), "${what} cannot hold `${cx.view.types.name_of(want)}` yet", "this slot", slice_promise("elements")))
}

/// A UNIFIED SEAT AGREES, or not — BOTH halves, always: `unify` binds
/// the declaration's Vars and `unified_lift` RECORDS the widen
/// lowering mints. Short-circuit either way and a hit drops its lift,
/// or a miss never binds. The one door for a call argument, a struct
/// field and an enum payload alike.
export fn agreed(mut cx: TypeCx, e: ExprId, want: TypeId, decl: DeclId, bound: Pins) -> bool {
    let matched = unify(cx, want, cx.type_at(e), decl, bound)
    let took = unified_lift(cx, e, want, decl, bound)
    matched || took
}

/// THE ASSIGNMENT LAW: what a slot of type `want` accepts from the
/// expression `e`. A guarantee widens INTO a nullable — an `int` IS
/// a valid `int?` — and the widening is RECORDED so lowering wraps
/// it. Absence never widens back: `int?` into `int` refuses, which
/// is the whole point of opting in. True means ACCEPTED.
export fn accepts(mut cx: TypeCx, e: ExprId, want: TypeId) -> bool {
    heard(cx, e, want)
    // still hungry after the seat had its say: the seat can never
    // feed it. Recorded, and the door closes quietly — the walk's
    // end speaks once, in the seat's words
    if cx.starve(e, want) { return true }
    let got = cx.type_at(e)
    if !types_disagree(cx, got, want) { return true }
    let inner: TypeId? = cx.view.types.carried(want)
    if inner == null { return other_accepts(cx, e, got, want) }
    // `null` inhabits every nullable; a present value must be the
    // carried type. Either way the lift is RECORDED, in this one
    // place — absence has no layout of its own, and lowering's
    // adoption edge mints each form from this record.
    let absent: bool = cx.view.types.shape_of(got) is .Null
    if !absent && types_disagree(cx, got, inner!) { return false }
    cx.widen(e, want)
    true
}

/// A success LIFTS into its Result at the boundary — the auto-Ok
/// wrap (ROADMAP: the error spine). THE GUARD RULE: only a value of
/// exactly the ok side wraps; a value already Result-shaped met the
/// identity case above and never wraps again, so `Ok(Ok(x))` cannot
/// happen silently. Recorded at the same one widening edge as the
/// nullable lift.
fn res_accepts(mut cx: TypeCx, e: ExprId, got: TypeId, want: TypeId) -> bool {
    let sides: ResSides? = cx.view.types.res_parts(want)
    if sides == null { return false }
    let ok = sides!.ok
    // the ONE compound lift whose inner step is identity: `[]` Ok-wraps raw
    if types_disagree(cx, got, ok) && !empty_adopted(cx, got, ok) { return false }
    cx.widen(e, want)
    true
}

/// `[]` is adopted by any list, `{}` by any map — the two identity
/// widens.
export fn empty_adopted(cx: TypeCx, got: TypeId, want: TypeId) -> bool {
    (cx.view.types.shape_of(got) is .EmptyList && cx.view.types.shape_of(want) is .List) ||
        (cx.view.types.shape_of(got) is .EmptyMap && cx.view.types.shape_of(want) is .Map)
}

/// The non-nullable lifts share one door: the auto-Ok wrap, and the
/// empty list adopted by whatever list claims it (`[]` is to List
/// what `null` is to Opt — and the VALUE needs no lift at all).
fn other_accepts(mut cx: TypeCx, e: ExprId, got: TypeId, want: TypeId) -> bool {
    if empty_adopted(cx, got, want) {
        cx.widen(e, want)
        return true
    }
    if dyn_accepts(cx, e, got, want) { return true }
    res_accepts(cx, e, got, want)
}

/// A signatory LIFTS into its contract — the boxing widen, the
/// fourth form at the one edge (nullable, auto-Ok, empty-list,
/// dyn). Only a type that can SIGN boxes; a value already
/// dyn-shaped met the identity case and never re-boxes.
fn dyn_accepts(mut cx: TypeCx, e: ExprId, got: TypeId, want: TypeId) -> bool {
    let tname: string? = dyn_contract(cx.view.types.shape_of(want))
    if tname == null { return false }
    if !boxable(cx, got, tname!) { return false }
    cx.widen(e, want)
    true
}

/// Whether a value can sign the contract: a concrete implementor,
/// or a type parameter whose BOUND is the very trait — each
/// instantiation re-proves the bound, so the abstract body may box
/// (an instantiation that arrives ALREADY dyn lifts by identity).
fn boxable(cx: TypeCx, got: TypeId, tname: string) -> bool {
    if cx.implements(got, tname) { return true }
    match cx.view.types.shape_of(got) {
        .Var(decl, j, _) -> bound_name(cx, decl, j) == tname,
        _ -> false,
    }
}

/// The bound a tparam SEAT declares — "" when unconstrained. The
/// one law both the bounded-call and the boxing widen read.
export fn bound_name(cx: TypeCx, decl: DeclId, j: int) -> string {
    let tb = cx.view.decls.tbounds(decl)
    if j >= tb.length { return "" }
    let ann: TypeRef? = tb[j].ty
    if ann == null { return "" }
    ann!.name
}

/// The channel's RESCUE at the one assignment door: a hungry
/// lambda meeting a fn-shaped slot re-types under its seats — the
/// facts converge as if the annotations had been written — and any
/// other hungry expression is FED the want; the comparison then
/// judges the real type.
fn heard(mut cx: TypeCx, e: ExprId, want: TypeId) {
    let arrow: Arrow? = cx.view.types.arrow_parts(want)
    if arrow != null { let _ = cx.retype_seated(e, arrow!.seats) }
    cx.feed(e, want)
}

/// A WANT THE TYPE LAW ALREADY REFUSED — the value beneath it adds
/// nothing: one mistake, one voice. Every aggregate rule asks this
/// before judging its own parts.
export fn want_refused(cx: TypeCx, e: ExprId) -> bool {
    let w: TypeId? = cx.want_at(e)
    w != null && cx.errored_ty(w!)
}

/// Whether an arm's value stays to answer — every value but a
/// leaving block.
export fn stays(cx: TypeCx, v: ExprId) -> bool {
    !cx.view.store.leaves(v)
}

/// THE JOIN: the one type two branches can BOTH answer with, or
/// absent when there is none. Equal types join to themselves; a
/// value beside an ABSENCE joins to the nullable covering both.
/// PURE — `accepts` does the recording, so every branching
/// construct joins the same way by asking this and then accepting.
export fn join_of(mut cx: TypeCx, a: TypeId, b: TypeId) -> TypeId? {
    if !types_disagree(cx, a, b) { return a }
    if empty_adopted(cx, a, b) { return b }
    if empty_adopted(cx, b, a) { return a }
    if cx.view.types.shape_of(b) is .Null { return nullable_over(cx, a) }
    if cx.view.types.shape_of(a) is .Null { return nullable_over(cx, b) }
    // A guarantee beside ITS OWN nullable joins wide — a narrowed
    // branch meeting the un-narrowed name is the natural case, and
    // `accepts` then lifts the guarantee side.
    if carries(cx, b, a) { return b }
    if carries(cx, a, b) { return a }
    // A value beside ITS OWN Result joins to the Result — a branch
    // that LEAVES answers the fn's promise, and the other branch's
    // guarantee auto-Ok-wraps at the same one edge.
    if answers(cx, b, a) { return b }
    if answers(cx, a, b) { return a }
    null
}

/// Does the Result `res` carry exactly `ok` on its answer side?
fn answers(cx: TypeCx, res: TypeId, ok: TypeId) -> bool {
    let sides: ResSides? = cx.view.types.res_parts(res)
    sides != null && !types_disagree(cx, sides!.ok, ok)
}

/// Does the nullable `opt` carry exactly `inner`?
fn carries(cx: TypeCx, opt: TypeId, inner: TypeId) -> bool {
    let held: TypeId? = cx.view.types.carried(opt)
    held != null && !types_disagree(cx, held!, inner)
}

/// `T` covered by an absence: `T?`. An already-nullable type
/// stands — nothing is lifted twice, which is also why a chain
/// FLATTENS: `a?.b` over a nullable member answers ONE absence.
export fn nullable_over(mut cx: TypeCx, ty: TypeId) -> TypeId {
    if cx.view.types.carried(ty) != null { return ty }
    cx.view.types.intern(Type.Opt(ty))
}

/// THE member law: what a type answers to a property name — a
/// record's field, or `length` on the measurable shapes. The bare
/// read (`a.b`) and the chain (`a?.b`) both ask HERE, so the two
/// spellings can never drift; `shown` is the subject as the caller
/// displays it.
export fn member_type_of(mut cx: TypeCx, e: ExprId, shown: string, ty: TypeId, name: string) -> TypeId {
    // Members live on GUARANTEES: a nullable subject's remedy is
    // the chain, never a property list it does not have.
    if cx.view.types.shape_of(ty) is .Opt {
        return spoken(cx, refusal("type.mismatch", cx.loc_of(e), "`.${name}` reads a guarantee, this is `${shown}`", this_is(shown), "`?.${name}` reaches through the absence — or answer it first with `??`"))
    }
    let sig: StructSig? = cx.fields_of(ty)
    if sig != null { return field_member(cx, e, shown, sig!, name) }
    let row: PropertyRow? = property_row(cx.view.lang.properties, name, cx.view.types.shape_of(ty))
    if row != null {
        let r = row!
        return r.check(cx, e, ty)
    }
    spoken(cx, refusal("type.unknown_prop", cx.loc_of(e), "no property `${name}` on `${shown}`", "read here", "a property is a record's field, or a measure like `length` on the shapes that have one"))
}

/// A record's property IS a declared field; a miss names the
/// fields that exist.
fn field_member(mut cx: TypeCx, e: ExprId, shown: string, sig: StructSig, name: string) -> TypeId {
    let i: int? = sig.slot_of(name)
    if i != null { return sig.types[i!] }
    spoken(cx, refusal("type.unknown_prop", cx.loc_of(e), "no field `${name}` on `${shown}`", "read here", fields_are(sig)))
}

/// THE DECLARED-BINDING LAW: an annotated binding holds what it
/// declares — the value must be ACCEPTED by the written type, its
/// widening recorded like any other slot's. Every annotated
/// binding form asks here, so the wording never drifts.
export fn declared_binding(mut cx: TypeCx, v: ExprId, name: string, declared: TypeId) {
    if cx.errored_ty(declared) { return }
    // a hungry lambda is not yet an error — the seat records itself
    if cx.starve(v, declared) { return }
    if cx.errored(v) { return }
    // A TYPE standing where the value belongs already spoke through
    // the value law — a second refusal would be a cascade.
    if cx.shape_at(v) is .TypeName { return }
    if accepts(cx, v, declared) { return }
    let n = cx.name_at(v)
    cx.emit(refusal("type.binding", cx.loc_of(v), "`${name}` declares `${cx.view.types.name_of(declared)}`, this is `${n}`", this_is(n), null))
}

/// The VALUE law: a type NAME is not a value. `Color` alone is
/// legal only as a property subject (`Color.red`), so anywhere a
/// value is consumed it refuses here — and no type-name shape ever
/// reaches lowering, where it could only be a defect. True means
/// refused.
export fn refuses_type_value(mut cx: TypeCx, e: ExprId) -> bool {
    let sh: Type = cx.shape_at(e)
    let tname: string? = match sh {
        .TypeName(_, n) -> n,
        _ -> null,
    }
    if tname == null { return false }
    let n = tname!
    cx.emit(refusal("type.type_value", cx.loc_of(e), "`${n}` is a type, not a value", "used as a value here", "name a variant (`${n}.<variant>`) or build a record (`${n} { ... }`)"))
    true
}

/// The ARMS law: every arm agrees with the anchor, or each
/// disagreeing arm speaks for itself; the answer is the anchor's
/// type, or Error when any disagreed. `subject` names the construct
/// and `anchor_name` says where the anchor came from, so each site
/// keeps its own words.
export fn arms_agree(mut cx: TypeCx, kind: string, subject: string, anchor_name: string,
                     anchor: ExprId, values: List<ExprId>) -> TypeId {
    // an arm that LEAVES answers nothing and joins with anything
    let answering = [v for v in values if stays(cx, v)]
    let want = arms_answer(cx, anchor, answering)
    mut agreed = true
    for v in answering {
        if !accepts(cx, v, want) {
            let n = cx.name_at(v)
            cx.emit(refusal(kind, cx.loc_of(v), "a `${subject}`'s arms disagree: `${n}` vs ${anchor_name}'s `${cx.view.types.name_of(want)}`", this_is(n), null))
            agreed = false
        }
    }
    if !agreed { return cx.error_type }
    // The anchor lands in the answer too — it may be the side that
    // lifts when another arm is an absence.
    let _ = accepts(cx, anchor, want)
    want
}

/// The type every arm can answer with: the anchor's, JOINED with
/// each arm in turn. One absent arm makes the whole answer nullable.
fn arms_answer(mut cx: TypeCx, anchor: ExprId, values: List<ExprId>) -> TypeId {
    mut want = cx.type_at(anchor)
    for v in values {
        let both: TypeId? = join_of(cx, want, cx.type_at(v))
        if both != null { want = both! }
    }
    want
}

/// The pointing label every mismatch uses: the offender, named.
export fn this_is(n: string) -> string {
    "this is a `${n}`"
}

/// A FN VALUE's seats judge a call — the one law the indirect
/// call, the fn-field call, and the lambda share, refusing in the
/// same words every call does.
export fn seats_judged(mut cx: TypeCx, e: ExprId, callee: string, ps: List<TypeId>, ret: TypeId, args: List<ExprId>) -> TypeId {
    if !seats_fit(cx, e, callee, args, ps) { return cx.error_type }
    ret
}

/// THE SEAT LAW every call shape shares: exactly `wants.length`
/// arguments, each accepted by its seat — a wrong argument speaks
/// and the caller still answers; a wrong count absorbs.
export fn seats_fit(mut cx: TypeCx, e: ExprId, callee: string, args: List<ExprId>, wants: List<TypeId>) -> bool {
    if args.length != wants.length {
        wrong_arity(cx, e, callee, wants.length, args.length)
        return false
    }
    for j, a in args {
        if !accepts(cx, a, wants[j]) { wrong_argument(cx, callee, j, wants[j], a) }
    }
    true
}

/// THE PLACE LAW's structural half: every step of a target is a
/// SLOT — a field a struct declares, an index into a list — rooted
/// in a value binding. A measured property (`length`) and a type
/// name refuse here, in their own words; the target's own typing
/// already refused unknown fields and non-list indexes. True means
/// lawful.
export fn place_lawful(mut cx: TypeCx, e: ExprId) -> bool {
    let step: PlaceStep? = cx.view.store.place_step(e)
    if step == null { return true }
    match step! {
        .Root(name) -> if cx.shape_at(e) is .TypeName { type_not_place(cx, e, name) } else { true },
        .Field(subject, name) -> place_lawful(cx, subject) && field_slot_lawful(cx, e, subject, name),
        .At(subject, _) -> place_lawful(cx, subject),
    }
}

fn field_slot_lawful(mut cx: TypeCx, e: ExprId, subject: ExprId, name: string) -> bool {
    let sig: StructSig? = cx.fields_of(cx.type_at(subject))
    if sig != null && sig!.slot_of(name) != null { return true }
    if cx.errored(subject) { return false }
    measured_not_stored(cx, e, name, cx.name_at(subject))
}

/// THE VOID LAW: a value that is nothing cannot be bound. True
/// means refused.
export fn refuses_void_value(mut cx: TypeCx, e: ExprId) -> bool {
    if !(cx.shape_at(e) is .Void) { return false }
    spoken(cx, refusal("type.mismatch", cx.loc_of(e), "this answers nothing — there is nothing to bind", "answers nothing", "a mutation is a statement; drop the binding"))
    true
}

/// THE SEATS every method row shares: exactly `wants.length`
/// arguments, each accepted by its seat — a wrong argument speaks
/// and the row still answers; a wrong count absorbs.
export fn seated(mut cx: TypeCx, mc: MethodCall, name: string, wants: List<TypeId>) -> bool {
    seats_fit(cx, mc.e, name, mc.args, wants)
}

/// What the runtime tests BY VALUE — what `==` compares and a scan
/// finds. Everything else holds a pointer, and comparing pointers
/// answers a question nobody asked.
export fn comparable(sh: Type) -> bool {
    sh is .Int || sh is .Bool || sh is .Str
}

/// The by-value law over a TYPE: the scalars and text, and an enum
/// whose variants carry nothing — it compares by variant.
export fn compares_by_value(cx: TypeCx, ty: TypeId) -> bool {
    comparable(cx.view.types.shape_of(ty)) || unit_enum(cx, ty)
}

/// An enum every variant of which carries nothing — a tag alone.
fn unit_enum(cx: TypeCx, ty: TypeId) -> bool {
    if !(cx.view.types.shape_of(ty) is .Enum) { return false }
    let sig: EnumSig? = cx.variants_of(ty)
    sig != null && sig!.payloads.all(it.is_empty())
}

// ── The voices: every refusal worded HERE, once ──

/// THE arity refusal — every call shape shares the words.
export fn wrong_arity(mut cx: TypeCx, e: ExprId, callee: string, want: int, found: int) {
    cx.emit(refusal("type.mismatch", cx.loc_of(e), "`${callee}` takes ${want} arguments, found ${found}", "this call", null))
}

/// THE argument refusal — every call shape shares the words.
export fn wrong_argument(mut cx: TypeCx, callee: string, j: int, want: TypeId, a: ExprId) {
    let n = cx.name_at(a)
    cx.emit(refusal("type.mismatch", cx.loc_of(a), "argument ${j + 1} of `${callee}` wants `${cx.view.types.name_of(want)}`, found `${n}`", this_is(n), null))
}

fn type_not_place(mut cx: TypeCx, e: ExprId, name: string) -> bool {
    let _ = spoken(cx, refusal("type.place", cx.loc_of(e), "`${name}` is a type — a mutation lands on a `mut` binding", "a type", null))
    false
}

fn measured_not_stored(mut cx: TypeCx, e: ExprId, name: string, subject: string) -> bool {
    let _ = spoken(cx, refusal("type.place", cx.loc_of(e), "`${name}` is measured, not stored — `${subject}` has no such slot", "not a slot", "a place is a field a struct declares, or an index into a list"))
    false
}

export fn not_a_place_call(mut cx: TypeCx, e: ExprId, name: string) -> TypeId {
    spoken(cx, refusal("type.place", cx.loc_of(e), "`${name}` mutates a place, and this list is a value", "a value", "bind it first — `mut xs = …` — then `xs.${name}(…)`; or build a new list with `concat`"))
}

export fn not_mut_call(mut cx: TypeCx, e: ExprId, name: string, root: string) -> TypeId {
    spoken(cx, refusal("type.place", cx.loc_of(e), "`${root}` is not `mut` — `${name}` mutates it", "mutated here", "declare it `mut ${root} = ...` — or build a changed copy"))
}

// ── THE INOUT SEATS (ROADMAP: the inout receiver) ──

/// Whether an expression is a PLACE rooted in a `mut` binding — what
/// a `mut` seat, and a writing method's receiver, must be handed.
export fn mut_place(cx: TypeCx, e: ExprId) -> bool {
    let root: ExprId? = place_binding_root(cx, e)
    root != null && cx.is_mut(root!)
}

/// A place's root when it is a BINDING — a type name at the root
/// (`G.a`, a variant) makes the whole a value.
fn place_binding_root(cx: TypeCx, e: ExprId) -> ExprId? {
    let root: ExprId? = cx.view.store.place_root(e)
    if root == null || cx.shape_at(root!) is .TypeName { return null }
    root
}

/// THE RECEIVER LAW: a writing method is called on a `mut` place. A
/// WARNING while the tree's own call sites become places; then the
/// refusal `not_mut_call` speaks here (ROADMAP: the inout receiver,
/// S4).
export fn receiver_law(mut cx: TypeCx, e: ExprId, subject: ExprId, name: string, writes: bool) {
    if !writes || mut_place(cx, subject) { return }
    let root: ExprId? = place_binding_root(cx, subject)
    if root == null { return cx.emit(warning("type.receiver", cx.loc_of(e), "`${name}` writes its receiver, and this is a value", "a value", "bind it `mut` first — the receiver becomes the caller's own place")) }
    let n = root_word(cx, root!)
    if captured(cx, root!) { return cx.emit(warning("type.receiver", cx.loc_of(e), "`${n}` is captured by value — `${name}` writes through the lambda's copy", "a copy", "a capture is a copy: write outside the lambda, or answer the new value")) }
    cx.emit(warning("type.receiver", cx.loc_of(e), "`${n}` is not `mut` — `${name}` writes through it", "aliased here", "declare it `mut ${n} = …`"))
}

/// A root's word for a voice: its name, or `self` for the receiver
/// (through any capture of it).
fn root_word(cx: TypeCx, root: ExprId) -> string {
    let named: string? = cx.view.store.ident_name(root)
    named ?? "self"
}

/// Whether a root is a lambda's CAPTURE — a copy, never a place.
fn captured(cx: TypeCx, root: ExprId) -> bool {
    let b: Binding? = cx.names.binding(root)
    b != null && b! is .Capture
}

/// THE SEAT LAW: every `mut` seat of a call is filled by a `mut`
/// place, and no two `mut` seats (the receiver counted) share a
/// root — the exclusivity law. Seats are numbered from `base` (1
/// past a method's receiver seat).
export fn mut_seats_law(mut cx: TypeCx, e: ExprId, callee: string, decl: DeclId, args: List<ExprId>, base: int, receiver: ExprId?) {
    mut roots: List<ExprId> = if receiver == null { [] } else { [receiver!] }
    for j, a in args {
        if cx.view.decls.mut_seat(decl, base + j) { roots = judged_seat(cx, e, callee, a, j, roots) }
    }
}

/// One `mut` seat judged; the roots handed so far, grown by this
/// one when it is lawful.
fn judged_seat(mut cx: TypeCx, e: ExprId, callee: string, a: ExprId, j: int, roots: List<ExprId>) -> List<ExprId> {
    let root: ExprId? = place_binding_root(cx, a)
    if root == null {
        value_in_mut_seat(cx, a, callee, j)
        return roots
    }
    let r = root!
    let n = root_word(cx, r)
    if captured(cx, r) {
        captured_in_mut_seat(cx, a, callee, j, n)
        return roots
    }
    if !cx.is_mut(r) {
        not_mut_seat(cx, a, callee, j, n)
        return roots
    }
    if roots.any(same_root(cx, it, r)) { shared_root(cx, e, callee, n) }
    roots.concat([r])
}

fn same_root(cx: TypeCx, a: ExprId, b: ExprId) -> bool {
    let x: ExprId? = cx.view.store.place_root(a)
    let ba: Binding? = if x == null { null } else { cx.names.binding(x!) }
    let bb: Binding? = cx.names.binding(b)
    ba != null && bb != null && same_binding(ba!, bb!)
}

fn value_in_mut_seat(mut cx: TypeCx, a: ExprId, callee: string, j: int) {
    cx.emit(refusal("type.seat", cx.loc_of(a), "seat ${j + 1} of `${callee}` is `mut`, and this is a value", "a value", "bind it `mut` first — `mut x = …` — then hand `x`"))
}

/// A WARNING while the contexts' closure fields become methods
/// (ROADMAP: the inout receiver, S4b) — 70 sites in the compiler's
/// own source hand a captured driver to a seat; then a refusal.
fn captured_in_mut_seat(mut cx: TypeCx, a: ExprId, callee: string, j: int, root: string) {
    cx.emit(refusal("type.seat", cx.loc_of(a), "`${root}` is captured by value — a lambda's copy cannot fill seat ${j + 1} of `${callee}`", "a copy", "a capture is a copy: call outside the lambda, or answer the new value"))
}

fn not_mut_seat(mut cx: TypeCx, a: ExprId, callee: string, j: int, root: string) {
    cx.emit(refusal("type.seat", cx.loc_of(a), "`${root}` is not `mut` — seat ${j + 1} of `${callee}` writes through it", "handed here", "declare it `mut ${root} = …`"))
}

fn shared_root(mut cx: TypeCx, e: ExprId, callee: string, root: string) {
    cx.emit(refusal("type.seat", cx.loc_of(e), "`${root}` is handed `mut` twice in one call to `${callee}`", "this call", "bind `mut b = ${root}…` first, and write it back after"))
}

/// THE PROMISE every nullable-in-a-slot refusal makes — one fn, so
/// the day the slice lands there is one place to keep it.
export fn slice_promise(what: string) -> string {
    "nullable ${what} arrive with ownership's next slice"
}

/// THE SETTLEMENT LAW: a call refused as a whole absorbs its
/// arguments' hunger — the call spoke, and a hungry lambda's own
/// voice would be a second one for the same mistake. Every call
/// shape (named, valued, method) settles here.
export fn settled_call(mut cx: TypeCx, args: List<ExprId>, answer: TypeId) -> TypeId {
    if cx.errored_ty(answer) {
        for a in args { cx.absorb_hunger(a) }
    }
    answer
}

/// An empty literal has no measure until a declared type adopts
/// it — the shared voice for `[]` and `{}`.
export fn unmeasurable_empty(mut cx: TypeCx, e: ExprId, lit: string, example: string) -> TypeId {
    spoken(cx, refusal("type.mismatch", cx.loc_of(e), "`${lit}` has no length yet — a declared type gives it one", "measured here", "bind it first — `let xs: ${example} = ${lit}`"))
}
