//! Typing laws shared across features and drivers — extracted at
//! their third copy, wording passed in so each site keeps its own
//! words. A LAW extracts at its SECOND: a rule copied by hand
//! disagrees with itself the day the copies drift (`member_type_of`
//! serves the bare read and the chain for exactly that reason).
use core.{ExprId, TypeId, Type, ResSides, StmtId, TypeRef, filled}
use diagnostics.{Diag, error_at, pointed}

/// Speak and ABSORB: the diagnostic lands and the answer is the
/// interned Error — the standard refusal tail of a typing law.
export fn spoken(cx: TypeCx, d: Diag) -> TypeId {
    // LICENSED I14: this IS `spoken` — the pair's one home
    cx.emit(d)
    cx.error_type
}

/// The condition law: `subject` names the site ("an `if`
/// condition"), `label` points at it ("this decides the branch").
export fn require_bool(cx: TypeCx, e: ExprId, subject: string, label: string) {
    let sh = cx.shape_at(e)
    if !(sh is .Bool) && !(sh is .Error) {
        cx.emit(pointed(
            error_at("type.mismatch", cx.loc_of(e), "${subject} is a `bool`, found `${cx.name_at(e)}`"),
            label))
    }
}

/// The agreement law: an Error on EITHER side absorbs (its cause
/// already spoke); otherwise interned ids must match. True means
/// the site speaks, in its own words.
export fn types_disagree(cx: TypeCx, got: TypeId, want: TypeId) -> bool {
    if cx.types.shape_of(got) is .Error || cx.types.shape_of(want) is .Error { return false }
    // LICENSED I9: this IS the agreement law's body
    got.index != want.index
}

/// THE ASSIGNMENT LAW: what a slot of type `want` accepts from the
/// expression `e`. A guarantee widens INTO a nullable — an `int` IS
/// a valid `int?` — and the widening is RECORDED so lowering wraps
/// it. Absence never widens back: `int?` into `int` refuses, which
/// is the whole point of opting in. True means ACCEPTED.
export fn accepts(cx: TypeCx, e: ExprId, want: TypeId) -> bool {
    let got = cx.type_at(e)
    if !types_disagree(cx, got, want) { return true }
    let inner: TypeId? = cx.types.carried(want)
    if inner == null { return other_accepts(cx, e, got, want) }
    // `null` inhabits every nullable; a present value must be the
    // carried type. Either way the lift is RECORDED, in this one
    // place — absence has no layout of its own, and lowering's
    // adoption edge mints each form from this record.
    let absent: bool = cx.types.shape_of(got) is .Null
    if !absent && types_disagree(cx, got, inner!) { return false }
    cx.widen(e, want)
    true
}

/// A success LIFTS into its Result at the boundary — the auto-Ok
/// wrap (ROADMAP: the error spine). THE GUARD RULE: only a value of
/// exactly the ok side wraps; a value already Result-shaped met the
/// identity case above and never wraps again, so `Ok(Ok(x))` cannot
/// happen silently. Recorded at the same one widening edge as the
/// nullable lift.
fn res_accepts(cx: TypeCx, e: ExprId, got: TypeId, want: TypeId) -> bool {
    let sides: ResSides? = cx.types.res_parts(want)
    if sides == null { return false }
    if types_disagree(cx, got, sides!.ok) && !empty_into(cx, got, sides!.ok) { return false }
    cx.widen(e, want)
    true
}

/// The ONE compound lift whose inner step is IDENTITY: an empty
/// array IS a valid list of anything, so `[]` Ok-wraps raw. Every
/// other compound lift (null -> T? -> Ok) stays explicit — its
/// value would need staged minting (recorded).
fn empty_into(cx: TypeCx, got: TypeId, ok: TypeId) -> bool {
    cx.types.shape_of(got) is .EmptyList && cx.types.shape_of(ok) is .List
}

/// The non-nullable lifts share one door: the auto-Ok wrap, and the
/// empty list adopted by whatever list claims it (`[]` is to List
/// what `null` is to Opt — and the VALUE needs no lift at all).
fn other_accepts(cx: TypeCx, e: ExprId, got: TypeId, want: TypeId) -> bool {
    if cx.types.shape_of(got) is .EmptyList && cx.types.shape_of(want) is .List {
        cx.widen(e, want)
        return true
    }
    if dyn_accepts(cx, e, got, want) { return true }
    res_accepts(cx, e, got, want)
}

/// A signatory LIFTS into its contract — the boxing widen, the
/// fourth form at the one edge (nullable, auto-Ok, empty-list,
/// dyn). Only a type that can SIGN boxes; a value already
/// dyn-shaped met the identity case and never re-boxes.
fn dyn_accepts(cx: TypeCx, e: ExprId, got: TypeId, want: TypeId) -> bool {
    let tname: string? = match cx.types.shape_of(want) {
        .Dyn(_, n) -> n,
        _ -> null,
    }
    if tname == null { return false }
    if !boxable(cx, got, tname!) { return false }
    cx.widen(e, want)
    true
}

/// Whether a value can sign the contract: a concrete implementor,
/// or a type parameter whose BOUND is the very trait — each
/// instantiation re-proves the bound, so the abstract body may box
/// (an instantiation that arrives ALREADY dyn lifts by identity).
fn boxable(cx: TypeCx, got: TypeId, tname: string) -> bool {
    if cx.implements(got, tname) { return true }
    match cx.types.shape_of(got) {
        .Var(decl, j, _) -> bound_name(cx, decl, j) == tname,
        _ -> false,
    }
}

/// The bound a tparam SEAT declares — "" when unconstrained. The
/// one law both the bounded-call and the boxing widen read.
export fn bound_name(cx: TypeCx, decl: StmtId, j: int) -> string {
    let tb = cx.store.decl_tbounds(decl)
    if j >= tb.length { return "" }
    let ann: TypeRef? = tb[j].ty
    if ann == null { return "" }
    ann!.name
}

/// THE JOIN: the one type two branches can BOTH answer with, or
/// absent when there is none. Equal types join to themselves; a
/// value beside an ABSENCE joins to the nullable covering both.
/// PURE — `accepts` does the recording, so every branching
/// construct joins the same way by asking this and then accepting.
export fn join_of(cx: TypeCx, a: TypeId, b: TypeId) -> TypeId? {
    if !types_disagree(cx, a, b) { return a }
    if cx.types.shape_of(b) is .Null { return nullable_over(cx, a) }
    if cx.types.shape_of(a) is .Null { return nullable_over(cx, b) }
    // A guarantee beside ITS OWN nullable joins wide — a narrowed
    // branch meeting the un-narrowed name is the natural case, and
    // `accepts` then lifts the guarantee side.
    if carries(cx, b, a) { return b }
    if carries(cx, a, b) { return a }
    null
}

/// Does the nullable `opt` carry exactly `inner`?
fn carries(cx: TypeCx, opt: TypeId, inner: TypeId) -> bool {
    let held: TypeId? = cx.types.carried(opt)
    held != null && !types_disagree(cx, held!, inner)
}

/// `T` covered by an absence: `T?`. An already-nullable type
/// stands — nothing is lifted twice, which is also why a chain
/// FLATTENS: `a?.b` over a nullable member answers ONE absence.
export fn nullable_over(cx: TypeCx, ty: TypeId) -> TypeId {
    if cx.types.carried(ty) != null { return ty }
    cx.types.intern(Type.Opt(ty))
}

/// THE member law: what a type answers to a property name — a
/// record's field, or `length` on the measurable shapes. The bare
/// read (`a.b`) and the chain (`a?.b`) both ask HERE, so the two
/// spellings can never drift; `shown` is the subject as the caller
/// displays it.
export fn member_type_of(cx: TypeCx, e: ExprId, shown: string, ty: TypeId, name: string) -> TypeId {
    // Members live on GUARANTEES: a nullable subject's remedy is
    // the chain, never a property list it does not have.
    if cx.types.shape_of(ty) is .Opt {
        return spoken(cx, pointed(
            error_at("type.mismatch", cx.loc_of(e), "`.${name}` reads a guarantee, this is `${shown}`"),
            this_is(shown))
            with { help: "`?.${name}` reaches through the absence — or answer it first with `??`" })
    }
    let sig: StructSig? = cx.fields_of(ty)
    if sig != null { return field_member(cx, e, shown, sig!, name) }
    if name == "length" { return length_member(cx, e, shown, ty) }
    spoken(cx, pointed(
        error_at("type.unknown_prop", cx.loc_of(e), "no property `${name}` on `${shown}`"),
        "read here")
        with { help: "the one property today is `length`" })
}

/// A record's property IS a declared field; a miss names the
/// fields that exist.
fn field_member(cx: TypeCx, e: ExprId, shown: string, sig: StructSig, name: string) -> TypeId {
    let i: int? = sig.slot_of(name)
    if i != null { return sig.types[i!] }
    spoken(cx, pointed(
        error_at("type.unknown_prop", cx.loc_of(e), "no field `${name}` on `${shown}`"),
        "read here")
        with { help: fields_are(sig) })
}

/// `length` measures the shapes with an extent.
fn length_member(cx: TypeCx, e: ExprId, shown: string, ty: TypeId) -> TypeId {
    let sh = cx.types.shape_of(ty)
    if sh is .List || sh is .Str { return cx.types.intern(Type.Int) }
    spoken(cx, pointed(
        error_at("type.mismatch", cx.loc_of(e), "`length` lives on `List` and `string` values, found `${shown}`"),
        this_is(shown)))
}

/// THE DECLARED-BINDING LAW: an annotated binding holds what it
/// declares — the value must be ACCEPTED by the written type, its
/// widening recorded like any other slot's. Every annotated
/// binding form asks here, so the wording never drifts.
export fn declared_binding(cx: TypeCx, v: ExprId, name: string, declared: TypeId) {
    if cx.types.shape_of(declared) is .Error { return }
    if cx.shape_at(v) is .Error { return }
    // A TYPE standing where the value belongs already spoke through
    // the value law — a second refusal would be a cascade.
    if cx.shape_at(v) is .TypeName { return }
    if accepts(cx, v, declared) { return }
    let n = cx.name_at(v)
    cx.emit(pointed(
        error_at("type.binding", cx.loc_of(v),
            "`${name}` declares `${cx.types.name_of(declared)}`, this is `${n}`"),
        this_is(n)))
}

/// The VALUE law: a type NAME is not a value. `Color` alone is
/// legal only as a property subject (`Color.red`), so anywhere a
/// value is consumed it refuses here — and no type-name shape ever
/// reaches lowering, where it could only be a defect. True means
/// refused.
export fn refuses_type_value(cx: TypeCx, e: ExprId) -> bool {
    let sh: Type = cx.shape_at(e)
    let tname: string? = match sh {
        .TypeName(_, n) -> n,
        _ -> null,
    }
    if tname == null { return false }
    let n = tname!
    cx.emit(pointed(
        error_at("type.type_value", cx.loc_of(e), "`${n}` is a type, not a value"),
        "used as a value here")
        with { help: "name a variant (`${n}.<variant>`) or build a record (`${n} { ... }`)" })
    true
}

/// The ARMS law: every arm agrees with the anchor, or each
/// disagreeing arm speaks for itself; the answer is the anchor's
/// type, or Error when any disagreed. `subject` names the construct
/// and `anchor_name` says where the anchor came from, so each site
/// keeps its own words.
export fn arms_agree(cx: TypeCx, kind: string, subject: string, anchor_name: string,
                     anchor: ExprId, values: List<ExprId>) -> TypeId {
    let want = arms_answer(cx, anchor, values)
    mut agreed = true
    for v in values {
        if !accepts(cx, v, want) {
            let n = cx.name_at(v)
            cx.emit(pointed(
                error_at(kind, cx.loc_of(v),
                    "a `${subject}`'s arms disagree: `${n}` vs ${anchor_name}'s `${cx.types.name_of(want)}`"),
                this_is(n)))
            agreed = false
        }
    }
    if !agreed { return cx.error_type }
    // The anchor lands in the answer too — it may be the side that
    // lifts when another arm is an absence.
    let _ = accepts(cx, anchor, want)
    want
}

/// The type every arm can answer with: the anchor's, JOINED with
/// each arm in turn. One absent arm makes the whole answer nullable.
fn arms_answer(cx: TypeCx, anchor: ExprId, values: List<ExprId>) -> TypeId {
    mut want = cx.type_at(anchor)
    for v in values {
        let both: TypeId? = join_of(cx, want, cx.type_at(v))
        if both != null { want = both! }
    }
    want
}

/// The pointing label every mismatch uses: the offender, named.
export fn this_is(n: string) -> string {
    "this is a `${n}`"
}

/// UNIFICATION, exact: bind the callee's Vars from an argument's
/// computed type, recursing through the composites. No widening
/// rides through a generic param — a lift needs a visible concrete
/// target (the recorded G1 law). Errors absorb.
export fn unify(cx: TypeCx, want: TypeId, got: TypeId, target: StmtId, bound: List<TypeId?>) -> bool {
    if cx.types.shape_of(got) is .Error { return true }
    if cx.types.shape_of(want) is .Error { return true }
    match cx.types.shape_of(want) {
        .Var(decl, j, _) -> var_binds(cx, decl, j, got, target, bound),
        .List(w) -> elem_unifies(cx, w, got, target, bound),
        .Opt(w) -> carried_unifies(cx, w, got, target, bound),
        .Res(wo, we) -> sides_unify(cx, wo, we, got, target, bound),
        .App(wd, _, wa) -> app_unifies(cx, wd, wa, got, target, bound),
        // LICENSED I9: type identity — interned ids ARE the agreement
        .Int or .Str or .Bool or .Struct(_, _) or .Enum(_, _) or
        .TypeName(_, _) or .Dyn(_, _) or .Null or .EmptyList or .Error -> want.index == got.index,
    }
}

/// One Var meets one concrete type: first sight binds (through the
/// caller's slots — an out param), a second must agree.
// LICENSED I3: `bound` is the caller's slot list; set() through the alias IS the answer
fn var_binds(cx: TypeCx, decl: StmtId, j: int, got: TypeId, target: StmtId, bound: List<TypeId?>) -> bool {
    // a sig speaks only its OWN fn's Vars; anything else is no match
    // LICENSED I9: DECLARATION identity, not type agreement — whose Var this is
    if decl.index != target.index { return false }
    // absence never pins a Var — `null` and `[]` have no one type;
    // the pin (or another argument) must land first
    if cx.types.shape_of(got) is .Null { return false }
    if cx.types.shape_of(got) is .EmptyList { return false }
    let seen: TypeId? = bound[j]
    if seen == null {
        // LICENSED I7: rebind-alias — set() needs a mut binding
        mut slots = bound
        slots.set(j, got)
        return true
    }
    // LICENSED I9: type identity — interned ids ARE the agreement
    seen!.index == got.index
}

fn elem_unifies(cx: TypeCx, w: TypeId, got: TypeId, target: StmtId, bound: List<TypeId?>) -> bool {
    match cx.types.shape_of(got) {
        .List(g) -> unify(cx, w, g, target, bound),
        _ -> false,
    }
}

fn carried_unifies(cx: TypeCx, w: TypeId, got: TypeId, target: StmtId, bound: List<TypeId?>) -> bool {
    match cx.types.shape_of(got) {
        .Opt(g) -> unify(cx, w, g, target, bound),
        _ -> false,
    }
}

fn sides_unify(cx: TypeCx, wo: TypeId, we: TypeId, got: TypeId, target: StmtId, bound: List<TypeId?>) -> bool {
    let sides: ResSides? = cx.types.res_parts(got)
    if sides == null { return false }
    unify(cx, wo, sides!.ok, target, bound) && unify(cx, we, sides!.err, target, bound)
}

/// A shape a SLOT may hold: a scalar word, or an unmanaged
/// pointer. Managed values and register-pair nullables wait for
/// ownership analysis; Error absorbs (the name law already spoke).
/// A Var passes ABSTRACTLY — each instantiation re-judges it
/// (`instantiation_lawful`), so nothing smuggles past by wearing T.
export fn slot_worthy(sh: Type) -> bool {
    match sh {
        .Int or .Bool or .Struct(_, _) or .Enum(_, _) or .Dyn(_, _) or
        .Res(_, _) or .App(_, _, _) or .TypeName(_, _) or .List(_) or .Var(_, _, _) -> true,
        .Str or .Opt(_) or .Null or .EmptyList or .Error -> false,
    }
}

/// The representation laws, re-judged on a SUBSTITUTED type: every
/// `Result` side must still be slot-worthy once T is concrete — a
/// call binding `T` to `int?` cannot smuggle a pair into a box's
/// word slot. Answers the offending side, or absence when lawful.
export fn unlawful_side(cx: TypeCx, ty: TypeId) -> TypeId? {
    match cx.types.shape_of(ty) {
        .Res(ok, err) -> res_side_unlawful(cx, ok, err),
        .List(elem) -> unlawful_side(cx, elem),
        .Opt(inner) -> unlawful_side(cx, inner),
        .App(_, _, args) -> args.find(unlawful_side(cx, it) != null),
        .Int or .Str or .Bool or .Struct(_, _) or .Enum(_, _) or
        .TypeName(_, _) or .Var(_, _, _) or .Dyn(_, _) or .Null or .EmptyList or .Error -> null,
    }
}

fn res_side_unlawful(cx: TypeCx, ok: TypeId, err: TypeId) -> TypeId? {
    if !slot_worthy(cx.types.shape_of(ok)) { return ok }
    if !slot_worthy(cx.types.shape_of(err)) { return err }
    unlawful_side(cx, ok) ?? unlawful_side(cx, err)
}

/// Whether every Var of `target` inside `ty` is already bound —
/// when true, the param is effectively concrete and the ordinary
/// assignment law (widening included) can judge the argument.
export fn fully_bound(cx: TypeCx, ty: TypeId, target: StmtId, bound: List<TypeId?>) -> bool {
    match cx.types.shape_of(ty) {
        // LICENSED I9: DECLARATION identity, not type agreement — whose Var this is
        .Var(decl, j, _) ->
            if decl.index == target.index { bound[j] != null } else { true },
        .List(elem) -> fully_bound(cx, elem, target, bound),
        .Opt(inner) -> fully_bound(cx, inner, target, bound),
        .Res(ok, err) -> fully_bound(cx, ok, target, bound) && fully_bound(cx, err, target, bound),
        .App(_, _, args) -> args.all(fully_bound(cx, it, target, bound)),
        .Int or .Str or .Bool or .Struct(_, _) or .Enum(_, _) or
        .TypeName(_, _) or .Dyn(_, _) or .Null or .EmptyList or .Error -> true,
    }
}

/// The bound slots as a full substitution — unbound slots absorb.
export fn bound_args(cx: TypeCx, bound: List<TypeId?>) -> List<TypeId> {
    [b ?? cx.error_type for b in bound]
}

/// Two instantiations of the SAME declaration unify argument by
/// argument; anything else is no match.
fn app_unifies(cx: TypeCx, wd: StmtId, wa: List<TypeId>, got: TypeId,
               target: StmtId, bound: List<TypeId?>) -> bool {
    match cx.types.shape_of(got) {
        // LICENSED I9: DECLARATION identity, not type agreement — whose instantiation this is
        .App(gd, _, ga) ->
            gd.index == wd.index && paired_unify(cx, wa, ga, target, bound),
        _ -> false,
    }
}

fn paired_unify(cx: TypeCx, want: List<TypeId>, got: List<TypeId>,
                target: StmtId, bound: List<TypeId?>) -> bool {
    if want.length != got.length { return false }
    mut ok = true
    // LICENSED I3: pairwise walk; comprehensions cannot destructure enumerate
    for (j, w) in want.enumerate() {
        if !unify(cx, w, got[j], target, bound) { ok = false }
    }
    ok
}

// ── The instantiation rituals: three verbs every generic surface
// (calls, struct lits, variant lits) shares, so no site re-spells
// the absorb loop or the closing walk. ──

/// A declaration naming T twice already refused at the declaration
/// — every use site absorbs instead of echoing.
export fn tparams_refused(tp: List<string>) -> bool {
    mut dup = false
    // LICENSED I3: the dup test needs the index; comprehensions cannot destructure enumerate
    for (j, n) in tp.enumerate() {
        if tp.index_of(n) < j { dup = true }
    }
    dup
}

/// The first type parameter the bindings left OPEN — the caller
/// voices it in its own surface's words.
export fn unpinned_of(tp: List<string>, bound: List<TypeId?>) -> string? {
    // LICENSED I3: names and slots pair by index; comprehensions cannot destructure enumerate
    for (j, n) in tp.enumerate() {
        if bound[j] == null { return n }
    }
    null
}

/// Every binding, closed — ask ONLY after `unpinned_of` answered
/// absence; an open slot here is the caller's defect.
export fn bound_closed(cx: TypeCx, bound: List<TypeId?>) -> List<TypeId> {
    [b ?? cx.error_type for b in bound]
}

// ── VARIANT CONSTRUCTION — `Type.variant(arg)`, the type-receiver
// half of the one dot-call surface. Plain or generic, ONE law: the variant
/// must exist; a carrying variant takes exactly its payload (which
/// UNIFIES, pinning a generic declaration's Vars — with none, the
/// unification IS the plain agreement check); the answer is the
/// declared type, instantiated when generic.
export fn construct_variant(cx: TypeCx, e: ExprId, decl: StmtId, tname: string, variant: string, args: List<ExprId>) -> TypeId {
    let declared: EnumSig? = variants_declared(cx, decl, tname)
    if declared == null { return not_an_enum(cx, e, tname) }
    let sig = declared!
    if sig.tag_of(variant) == null { return no_such_variant(cx, e, tname, variant, sig) }
    let tp = cx.store.decl_tparams(decl)
    if tparams_refused(tp) { return cx.error_type }
    let held: TypeId? = sig.payload_of(variant)
    if held == null { return unit_variant(cx, e, tname, variant, tp) }
    let carried = held!
    let first: ExprId? = args.first()
    if first == null { return given_nothing(cx, e, tname, variant, carried) }
    if args.length > 1 {
        return spoken(cx, pointed(
            error_at("type.variant_arity", cx.loc_of(e),
                "`${tname}.${variant}` carries ONE value, given ${args.length}"),
            "built here")
            with { help: "a variant's payload is a single value — wrap several in a record" })
    }
    let bound: List<TypeId?> = filled<TypeId?>(tp.length, null)
    if !unify(cx, carried, cx.type_at(first!), decl, bound) {
        return wrong_payload(cx, first!, tname, variant, carried)
    }
    instantiated(cx, e, tname, decl, tp, bound)
}

/// A unit variant given an argument list: the plain one carries
/// nothing; a generic one has nothing to PIN from either.
fn unit_variant(cx: TypeCx, e: ExprId, tname: string, variant: string, tp: List<string>) -> TypeId {
    if !tp.is_empty() { return cannot_pin(cx, e, tname, variant, tp[0]) }
    carries_nothing(cx, e, tname, variant)
}

/// The answer: the plain enum, or the App the bindings close into.
fn instantiated(cx: TypeCx, e: ExprId, tname: string, decl: StmtId,
                tp: List<string>, bound: List<TypeId?>) -> TypeId {
    if tp.is_empty() { return cx.types.intern(Type.Enum(decl, tname)) }
    let missing: string? = unpinned_of(tp, bound)
    if missing != null { return unpinned_by_payload(cx, e, missing!) }
    let concrete = bound_closed(cx, bound)
    cx.record_subst(e, decl, concrete)
    cx.types.intern(Type.App(decl, tname, concrete))
}

/// The raw declared table — Vars intact — or absence when the
/// declaration is a record. The REAL name interns: the registry
/// keeps the FIRST shape it sees for a key, so a throwaway name
/// here would poison every later printing of this enum.
fn variants_declared(cx: TypeCx, decl: StmtId, tname: string) -> EnumSig? {
    cx.variants_of(cx.types.intern(Type.Enum(decl, tname)))
}

// ── The voices: every refusal worded HERE, once — the laws above
// call the verb and stay legible. (DOGFOODING: laws call voices.) ──

fn not_an_enum(cx: TypeCx, e: ExprId, tname: string) -> TypeId {
    spoken(cx, pointed(
        error_at("type.unknown_prop", cx.loc_of(e), "`${tname}` is a record, not an enum"),
        "built here")
        with { help: build_a_record(tname) })
}

fn no_such_variant(cx: TypeCx, e: ExprId, tname: string, variant: string, sig: EnumSig) -> TypeId {
    spoken(cx, pointed(
        error_at("type.unknown_prop", cx.loc_of(e), "`${tname}` has no variant `${variant}`"),
        "built here")
        with { help: variants_are(sig) })
}

fn carries_nothing(cx: TypeCx, e: ExprId, tname: string, variant: string) -> TypeId {
    spoken(cx, pointed(
        error_at("type.variant_arity", cx.loc_of(e), "`${tname}.${variant}` carries nothing"),
        "given an argument here")
        with { help: "write `${tname}.${variant}` on its own" })
}

fn cannot_pin(cx: TypeCx, e: ExprId, tname: string, variant: string, tparam: string) -> TypeId {
    spoken(cx, pointed(
        error_at("type.unknown_prop", cx.loc_of(e),
            "`${tname}.${variant}` cannot pin `${tparam}` — nothing carries it"),
        "built here")
        with { help: "a payload pins the type; the pinned unit surface is recorded" })
}

fn wrong_payload(cx: TypeCx, v: ExprId, tname: string, variant: string, carried: TypeId) -> TypeId {
    let n = cx.name_at(v)
    spoken(cx, pointed(
        error_at("type.variant_arity", cx.loc_of(v),
            "`${tname}.${variant}` carries a `${cx.types.name_of(carried)}`, found `${n}`"),
        this_is(n)))
}

fn given_nothing(cx: TypeCx, e: ExprId, tname: string, variant: string, carried: TypeId) -> TypeId {
    spoken(cx, pointed(
        error_at("type.variant_arity", cx.loc_of(e),
            "`${tname}.${variant}` carries a `${cx.types.name_of(carried)}`, given nothing"),
        "built empty here")
        with { help: "write `${tname}.${variant}(<value>)`" })
}

fn unpinned_by_payload(cx: TypeCx, e: ExprId, tparam: string) -> TypeId {
    spoken(cx, pointed(
        error_at("type.unknown_prop", cx.loc_of(e), "`${tparam}` is not pinned by the payload"),
        "built here")
        with { help: "the pinned unit surface is recorded — carry `${tparam}` for now" })
}
