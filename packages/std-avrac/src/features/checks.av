//! Typing laws shared across features and drivers — extracted at
//! their third copy, wording passed in so each site keeps its own
//! words.
use core.{ExprId, TypeId, Type, ptr_shape}
use diagnostics.{Diag, error_at, pointed}

/// Speak and ABSORB: the diagnostic lands and the answer is the
/// interned Error — the standard refusal tail of a typing law.
export fn spoken(cx: TypeCx, d: Diag) -> TypeId {
    // LICENSED I14: this IS `spoken` — the pair's one home
    cx.emit(d)
    cx.intern(Type.Error)
}

/// The condition law: `subject` names the site ("an `if`
/// condition"), `label` points at it ("this decides the branch").
export fn require_bool(cx: TypeCx, e: ExprId, subject: string, label: string) {
    let sh = cx.shape_at(e)
    if !(sh is .Bool) && !(sh is .Error) {
        cx.emit(pointed(
            error_at("type.mismatch", cx.loc_of(e), "${subject} is a `bool`, found `${cx.name_at(e)}`"),
            label))
    }
}

/// The agreement law: an Error on EITHER side absorbs (its cause
/// already spoke); otherwise interned ids must match. True means
/// the site speaks, in its own words.
export fn types_disagree(cx: TypeCx, got: TypeId, want: TypeId) -> bool {
    if cx.shape_of(got) is .Error || cx.shape_of(want) is .Error { return false }
    // LICENSED I9: this IS the agreement law's body
    got.index != want.index
}

/// THE ASSIGNMENT LAW: what a slot of type `want` accepts from the
/// expression `e`. A guarantee widens INTO a nullable — an `int` IS
/// a valid `int?` — and the widening is RECORDED so lowering wraps
/// it. Absence never widens back: `int?` into `int` refuses, which
/// is the whole point of opting in. True means ACCEPTED.
export fn accepts(cx: TypeCx, e: ExprId, want: TypeId) -> bool {
    let got = cx.type_at(e)
    if !types_disagree(cx, got, want) { return true }
    let inner: TypeId? = opt_inner(cx, want)
    if inner == null { return false }
    // `null` already IS the absent value; only a PRESENT value is
    // lifted, so only that one is recorded.
    if cx.shape_of(got) is .Null { return true }
    if types_disagree(cx, got, inner!) { return false }
    cx.widen(e, want)
    true
}

/// THE JOIN: the one type two branches can BOTH answer with. Equal
/// types join to themselves; a value beside an ABSENCE joins to the
/// nullable that covers both, widening the value side. Anything else
/// has no join, and the caller refuses in its own words.
export fn joined_type(cx: TypeCx, a: ExprId, b: ExprId) -> TypeId? {
    let at = cx.type_at(a)
    let bt = cx.type_at(b)
    if !types_disagree(cx, at, bt) { return at }
    if cx.shape_of(bt) is .Null { return nullable_of(cx, a, at) }
    if cx.shape_of(at) is .Null { return nullable_of(cx, b, bt) }
    null
}

/// `T` beside an absence: the answer is `T?`, and the value side is
/// recorded for lowering to lift.
fn nullable_of(cx: TypeCx, value: ExprId, ty: TypeId) -> TypeId? {
    // Already nullable: the absence joins straight in, and a value
    // that is already lifted is never lifted twice.
    if opt_inner(cx, ty) != null { return ty }
    if ptr_shape(cx.shape_of(ty)) { return null }
    let opt = cx.intern(Type.Opt(ty))
    cx.widen(value, opt)
    opt
}

/// What a nullable carries, or absent when the type is not one.
export fn opt_inner(cx: TypeCx, ty: TypeId) -> TypeId? {
    match cx.shape_of(ty) {
        .Opt(inner) -> inner,
        _ -> null,
    }
}

/// The VALUE law: a type NAME is not a value. `Color` alone is
/// legal only as a property subject (`Color.red`), so anywhere a
/// value is consumed it refuses here — and no type-name shape ever
/// reaches lowering, where it could only be a defect. True means
/// refused.
export fn refuses_type_value(cx: TypeCx, e: ExprId) -> bool {
    let sh: Type = cx.shape_at(e)
    let tname: string? = match sh {
        .TypeName(_, n) -> n,
        _ -> null,
    }
    if tname == null { return false }
    let n = tname!
    cx.emit(pointed(
        error_at("type.type_value", cx.loc_of(e), "`${n}` is a type, not a value"),
        "used as a value here")
        with { help: "name a variant (`${n}.<variant>`) or build a record (`${n} { ... }`)" })
    true
}

/// The ARMS law: every arm agrees with the anchor, or each
/// disagreeing arm speaks for itself; the answer is the anchor's
/// type, or Error when any disagreed. `subject` names the construct
/// and `anchor_name` says where the anchor came from, so each site
/// keeps its own words.
export fn arms_agree(cx: TypeCx, kind: string, subject: string, anchor_name: string,
                     anchor: TypeId, values: List<ExprId>) -> TypeId {
    mut agreed = true
    for v in values {
        if types_disagree(cx, cx.type_at(v), anchor) {
            let n = cx.name_at(v)
            cx.emit(pointed(
                error_at(kind, cx.loc_of(v),
                    "a `${subject}`'s arms disagree: `${n}` vs ${anchor_name}'s `${cx.type_name(anchor)}`"),
                this_is(n)))
            agreed = false
        }
    }
    if agreed { anchor } else { cx.intern(Type.Error) }
}

/// The pointing label every mismatch uses: the offender, named.
export fn this_is(n: string) -> string {
    "this is a `${n}`"
}
