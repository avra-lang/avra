//! The catch node's semantics: dispatch only. Typing lives in
//! check.av, lowering in lower.av. The arms are hidden kids — each
//! types and lowers under its own bind, inside its own bracket.
use core.{Expr, ExprId, TypeId, Reg}
use features.{named_bind, NodeSemantics, ResolveCx, TypeCx, LowerCx, nothing, Meaning}

use core.expr.{Catch}

export type CatchSemantics = {}

impl NodeSemantics for CatchSemantics {
    fn kids(e: Expr) -> List<ExprId> {
        // a feature cannot enumerate OTHER features' variants
        match e { .Catch(subject, _, _, _) -> [subject], _ -> [] }
    }

}

impl Meaning for Catch {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        for j, v in self.values { cx.arm_scope(cx.bound_at(e, named_bind(self.binds[j].of)), v) }
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        catch_type(cx, e)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        catch_reg(cx, e)
    }
}
