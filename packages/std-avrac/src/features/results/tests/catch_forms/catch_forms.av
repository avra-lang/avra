// proves: `catch` in every written form, nested and combined — one value each.
enum E {
    boom
    small(n: int)
}
fn f(n: int) -> Result<int, E> {
    if n == 0 { fail E.boom }
    if n == 1 { fail E.small(7) }
    n
}
fn a() -> int { f(0) catch 99 }
fn b() -> int {
    f(1) catch {
        .boom -> 1
        .small(m) -> m
    }
}
fn c() -> int {
    f(1) catch {
        .boom -> 1
        .small(m) -> m + 100
    }
}
fn d() -> int { f(0) catch e -> match e { .boom -> 2, .small(_) -> 3 } }
fn e2() -> int { (f(0) catch 1) + (f(5) catch 2) }
fn g() -> int { f(0) catch (f(0) catch 4) }
fn h() -> int { f(1) catch _ -> 8 }
"${a()} ${b()} ${c()} ${d()} ${e2()} ${g()} ${h()}"
