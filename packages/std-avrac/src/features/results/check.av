//! The catch laws. The subject must be a `Result`; arms are judged
//! against its failure side's variants, and COVERAGE decides the
//! answer: a TOTAL catch (a catch-all arm, or every variant named)
//! recovers to the ok side; a SELECTIVE one stays the Result, and
//! the unmatched keep propagating — which needs the same channel
//! `?` needs.
use core.{ExprId, Type, TypeId, ResSides, TypeRegistry, same_type}
use features.{TypeCx, EnumSig, this_is, variants_are, TypeArgs, res_enum_sig, Refusal}
use diagnostics.{refusal}

fn catch_type(mut cx: TypeCx, e: ExprId) -> TypeId {
    // a feature cannot enumerate OTHER features' variants
    match cx.view.store.expr(e) {
        .Catch(s, vs, bs, arms) -> catched_type(cx, e, s, [t.of for t in vs], [t.of for t in bs], arms),
        _ -> cx.error_type,
    }
}

fn catched_type(
    mut cx: TypeCx,
    e: ExprId,
    subject: ExprId,
    variants: List<string>,
    binds: List<string>,
    values: List<ExprId>,
) -> TypeId {
    if cx.errored(subject) { return cx.error_type }
    let sides? = cx.failure_view(subject) else { return not_a_result(cx, subject) }
    let t = sides.ok
    let err = sides.err
    if cx.view.types.shape_of(err) is .Union && !variants.contains("") {
        return catched_union_type(cx, e, err, t, variants, binds, values)
    }
    for j, vn in variants { arm_bind(cx, e, err, vn, binds[j], values[j]) }
    for v in values { arm_answer(cx, t, v) }
    if covers(cx, err, variants) { return t }
    // SELECTIVE: the answer is STILL the ok side — the matched kinds
    // recover, and the unmatched have already LEFT through the same
    // exit `?` uses. Which is why the channel must exist (§5.6).
    let ret: TypeId? = cx.enclosing_ret()
    if ret != null && cx.errored_ty(ret!) { return cx.error_type }
    let rsides: ResSides? = if ret == null { null } else { cx.view.types.res_parts(ret!) }
    // LICENSED structs.index_compared: type identity — interned ids ARE the agreement
    if rsides == null || rsides!.err.index != err.index { return uncarried_rest(cx, e, err) }
    t
}

/// A UNION catch: each arm names a MEMBER, never a payload — the
/// bind narrows to that member WHOLE (a member IS the error, unlike
/// an enum's projected field). Coverage is MEMBERSHIP: total when
/// the named members cover the whole set, selective otherwise — and
/// the rest is a genuine NARROWER union, which the enclosing fn must
/// itself promise or catch further.
fn catched_union_type(
    mut cx: TypeCx,
    e: ExprId,
    err: TypeId,
    t: TypeId,
    variants: List<string>,
    binds: List<string>,
    values: List<ExprId>,
) -> TypeId {
    let bound: List<TypeId?> = [union_arm_bind(cx, e, err, variants[j], binds[j], values[j]) for j in 0..variants.length]
    mut named: List<TypeId> = []
    for j, member in bound {
        if member != null {
            let m = member!
            if named.any(same_type(it, m)) { duplicate_member(cx, e, variants[j]) } else { named.push(m) }
        }
    }
    for v in values { arm_answer(cx, t, v) }
    if named.is_empty() { return cx.error_type }
    if cx.view.types.covers(cx.view.types.union_of(named), err) { return t }
    let remaining = cx.view.types.union_of(cx.view.types.subtracted(err, named))
    let ret: TypeId? = cx.enclosing_ret()
    if ret != null && cx.errored_ty(ret!) { return cx.error_type }
    let rsides: ResSides? = if ret == null { null } else { cx.view.types.res_parts(ret!) }
    if rsides == null || !cx.view.types.covers(rsides!.err, remaining) { return uncarried_union_rest(cx, e, remaining) }
    t
}

/// One union arm's BIND: `vn` names a MEMBER of the union, checked
/// against its own set — the bind, when written, narrows to that
/// member's own type.
fn union_arm_bind(mut cx: TypeCx, e: ExprId, err: TypeId, vn: string, bind: string, value: ExprId) -> TypeId? {
    let member? = cx.view.types.by_name(vn) else {
        no_such_member(cx, e, err, vn)
        return null
    }
    if !cx.view.types.covers(err, member) {
        no_such_member(cx, e, err, vn)
        return null
    }
    if bind != "" { cx.bind_types(value, [member]) }
    member
}

/// One arm's BIND, spoken before its value walks: a catch-all arm
/// receives the whole error; a variant arm its payload — and a
/// unit variant refuses a bind it cannot fill.
fn arm_bind(mut cx: TypeCx, e: ExprId, err: TypeId, vn: string, bind: string, value: ExprId) {
    if vn == "" {
        if bind != "" { cx.bind_types(value, [err]) }
        return
    }
    let held: EnumSig? = cx.variants_of(err)
    if held == null {
        no_variants_to_name(cx, e, vn, err)
        return
    }
    let sig = held!
    let carried: TypeId? = sig.payload_of(vn)
    if sig.tag_of(vn) == null {
        no_such_failure(cx, e, err, vn, sig)
        return
    }
    if carried == null && bind != "" {
        nothing_to_hold(cx, e, vn, bind)
        return
    }
    if carried != null { cx.bind_types(value, [carried!]) }
}

/// One arm's ANSWER: walked under its bind, accepted by the ok side
/// (widening recorded, like every slot).
fn arm_answer(mut cx: TypeCx, t: TypeId, value: ExprId) {
    let at = cx.walk_type(value)
    if cx.errored_ty(at) { return }
    if cx.accepts(value, t) { return }
    arm_not_ok(cx, value, t)
}

/// TOTAL when a catch-all arm exists, or every variant is named.
fn covers(cx: TypeCx, err: TypeId, variants: List<string>) -> bool {
    if variants.any(it == "") { return true }
    let sig? = cx.variants_of(err) else { return false }
    total(sig, variants)
}

/// The pronoun cannot ride a nested method call — the wrapper can.
/// Shared with lowering's totality test.
fn named_in(variants: List<string>, name: string) -> bool {
    variants.contains(name)
}

/// `Result<T, E>` — the constructor row's shape.
/// A `Result`'s sides hold values: a side of `void` — a verb that
/// answers nothing but may fail — is recorded, not landed.
export fn res_law(types: TypeRegistry, args: TypeArgs) -> List<Refusal> {
    [side_holds_nothing(types, p) for p in args.parts if types.shape_of(p) is .Void]
}

export fn res_shape(args: TypeArgs) -> Type {
    Type.Res(args.parts[0], args.parts[1])
}

/// The variants `.Ok(v)` / `.Err(e)` construct — the
/// bridge's table over the row's two sides.
export fn res_variants(args: TypeArgs) -> EnumSig? {
    res_enum_sig(args.parts[0], args.parts[1])
}

// ── The voices ──

fn not_a_result(mut cx: TypeCx, subject: ExprId) -> TypeId {
    let n = cx.name_at(subject)
    cx
        .spoken(
            refusal(
                "type.catch",
                cx.loc_of(subject),
                "`catch` recovers a `Result`, this is `${n}`",
                this_is(n),
                "only a fallible value has a failure to recover from",
            ),
        )
}

fn uncarried_rest(mut cx: TypeCx, e: ExprId, err: TypeId) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.catch",
                cx.loc_of(e),
                "a selective `catch` lets the other failures pass, and this fn cannot carry them",
                "the rest propagate",
                "name every variant (a total catch), add a catch-all arm `e ->`, or promise `Result<_, ${cx.view.types.name_of(err)}>`",
            ),
        )
}

fn uncarried_union_rest(mut cx: TypeCx, e: ExprId, remaining: TypeId) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.catch",
                cx.loc_of(e),
                "a selective `catch` lets the other members pass, and this fn cannot carry them",
                "the rest propagate",
                "name every member (a total catch), add a catch-all arm `e ->`, or promise `Result<_, ${cx.view.types.name_of(remaining)}>`",
            ),
        )
}

fn no_such_member(mut cx: TypeCx, e: ExprId, err: TypeId, vn: string) {
    cx
        .emit(
            refusal(
                "type.catch",
                cx.loc_of(e),
                "`${vn}` names no member of `${cx.view.types.name_of(err)}`",
                "in this arm",
                "catch by one of its members' own type names",
            ),
        )
}

fn duplicate_member(mut cx: TypeCx, e: ExprId, vn: string) {
    cx
        .emit(
            refusal(
                "type.catch",
                cx.loc_of(e),
                "`${vn}` is named twice in this catch",
                "in this arm",
                "each member answers once",
            ),
        )
}

fn no_variants_to_name(mut cx: TypeCx, e: ExprId, vn: string, err: TypeId) {
    cx
        .emit(
            refusal(
                "type.catch",
                cx.loc_of(e),
                "`.${vn}` names a variant, but `${cx.view.types.name_of(err)}` has none",
                "in this arm",
                "bind the whole error instead — `catch e ->`",
            ),
        )
}

fn no_such_failure(mut cx: TypeCx, e: ExprId, err: TypeId, vn: string, sig: EnumSig) {
    cx
        .emit(
            refusal(
                "type.catch",
                cx.loc_of(e),
                "`${cx.view.types.name_of(err)}` has no variant `${vn}`",
                "in this arm",
                variants_are(sig),
            ),
        )
}

fn nothing_to_hold(mut cx: TypeCx, e: ExprId, vn: string, bind: string) {
    cx
        .emit(
            refusal(
                "type.catch",
                cx.loc_of(e),
                "`.${vn}` carries nothing, so `${bind}` has nothing to hold",
                "in this arm",
                "drop the parentheses",
            ),
        )
}

fn arm_not_ok(mut cx: TypeCx, value: ExprId, t: TypeId) {
    let gn = cx.name_at(value)
    cx
        .emit(
            refusal(
                "type.catch",
                cx.loc_of(value),
                "a `catch` arm answers the ok side: `${cx.view.types.name_of(t)}`, this is `${gn}`",
                this_is(gn),
                null,
            ),
        )
}

fn side_holds_nothing(types: TypeRegistry, side: TypeId) -> Refusal {
    Refusal {
        message: "a `Result` side cannot hold `${types.name_of(side)}` yet",
        help: "a verb that answers nothing but may fail is recorded — answer what it wrote",
    }
}
