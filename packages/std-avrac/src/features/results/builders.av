//! Parse-time lowering: captures -> the Fail statement. The catch
//! surfaces PARSE in the expression ladder (the `?.` precedent —
//! the spine owns precedence, this feature owns the meaning).
use core.{Stmt}
use features.{LangNode, Builder}

fn build_fail(mut b: Builder) -> Result<LangNode, string> {
    let v = b.expr(0)?
    b.make_stmt(Stmt.Fail(v))
}

