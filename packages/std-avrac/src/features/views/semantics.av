//! The `state` statement's StmtSemantics: the seed walks before the
//! name binds, typing reads the place's type, and lowering finds or
//! makes the instance's cell. A `view` is a fn declaration, so its
//! statement's semantics are the fn's.
use core.{StmtId, Reg}
use features.{StmtSemantics, ResolveCx, TypeCx, LowerCx}

export type StateSemantics = {}

impl StmtSemantics for StateSemantics {
    fn resolve_stmt(mut cx: ResolveCx, s: StmtId) {
        let seed? = cx.view.store.state_seed(s) else { return }
        cx.walk(seed)
        cx.bind_checked(s)
    }

    fn type_stmt(mut cx: TypeCx, s: StmtId) {
        check_state(cx, s)
    }

    fn lower_stmt(mut cx: LowerCx, s: StmtId) -> Reg? {
        lower_state(cx, s)
    }
}
