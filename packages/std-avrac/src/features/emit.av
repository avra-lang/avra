//! THE EMISSION VOCABULARY — the IR's control, constant and measure
//! shapes, spoken once, as methods of the lowering context. A
//! feature's lowering says what its VALUES are (values.av) and emits
//! its own value shape; a region, an arm, a constant or a measure it
//! speaks through these verbs, so the two engines read one
//! instruction stream by construction, never by two features
//! happening to emit matching brackets. A two-armed region is ONE
//! expression whose arms are trailing blocks (`cx.region(c, e) { cx
//! -> … } else { cx -> … }`), so a site cannot open a bracket it
//! does not close; the open/arm/close verbs remain for the folds and
//! switches whose arms are not two.
use core.{Reg, Ins, Type, TypeId, ExprId, StmtId, BinOp, UnOp, RtSig, same_type}
use features.{MethodCall, LoopMark}

// ── Constants ───────────────────────────────────────────────────

impl LowerCx {
    mut fn const_int(n: int) -> Reg {
        let r = self.mint_shape(Type.Int)
        self.emit(Ins.ConstInt(r, n))
        r
    }

    mut fn const_bool(b: bool) -> Reg {
        let r = self.mint_shape(Type.Bool)
        self.emit(Ins.ConstBool(r, b))
        r
    }

    mut fn const_str(text: string) -> Reg {
        let r = self.mint_shape(Type.Str)
        self.emit(Ins.ConstStr(r, text))
        r
    }

    // A source literal's OWN node: its answer type may be a NAMED
    // seat's type (a literal fills a named seat directly), never the
    // raw scalar the three verbs above mint at — so a literal's
    // defining register is minted at the node's own answer type.

    mut fn const_int_at(e: ExprId, n: int) -> Reg {
        let r = self.result(e)
        self.emit(Ins.ConstInt(r, n))
        r
    }

    mut fn const_bool_at(e: ExprId, b: bool) -> Reg {
        let r = self.result(e)
        self.emit(Ins.ConstBool(r, b))
        r
    }

    mut fn const_str_at(e: ExprId, s: string) -> Reg {
        let r = self.result(e)
        self.emit(Ins.ConstStr(r, s))
        r
    }

    // ── The once slot ────────────────────────────────────────────
    // A `once fn`'s own persistent slot: `once_read` before the
    // body, `once_commit` after it — the fn's own symbol is the
    // slot's whole address, so neither verb takes a register for it.

    mut fn once_read(sh: Type, sym: string) -> Reg {
        let r = self.mint_shape(sh)
        self.emit(Ins.OnceRead(r, sym))
        r
    }

    mut fn once_commit(sym: string, value: Reg) {
        self.emit(Ins.OnceCommit(sym, value))
    }

    // ── Arithmetic and packing ──────────────────────────────────

    /// A binary op minted at `sh` — internal plumbing whose shape is
    /// fixed (a comparison's `Type.Bool`, an offset's `Type.Int`),
    /// never a source expression's own node.
    mut fn bin(sh: Type, op: BinOp, a: Reg, b: Reg) -> Reg {
        let dst = self.mint_shape(sh)
        self.emit(Ins.Bin(dst, op, a, b))
        dst
    }

    /// The same, minted at an expression's own answer type.
    mut fn bin_at(e: ExprId, op: BinOp, a: Reg, b: Reg) -> Reg {
        let dst = self.result(e)
        self.emit(Ins.Bin(dst, op, a, b))
        dst
    }

    /// `!src`, minted `Type.Bool` — `UnOp` has one variant today, so
    /// the op is never a seat here.
    mut fn un(src: Reg) -> Reg {
        let dst = self.mint_shape(Type.Bool)
        self.emit(Ins.Un(dst, UnOp.Not, src))
        dst
    }

    /// The same, minted at an expression's own answer type.
    mut fn un_at(e: ExprId, src: Reg) -> Reg {
        let dst = self.result(e)
        self.emit(Ins.Un(dst, UnOp.Not, src))
        dst
    }

    /// The slots packed into one register of `ty` — a nullable
    /// scalar's flag-and-word pair, a slot read back whole.
    mut fn pack(ty: TypeId, elems: List<Reg>) -> Reg {
        let dst = self.mint_ty(ty)
        self.emit(Ins.Pack(dst, elems))
        dst
    }

    // ── Direct calls ─────────────────────────────────────────────
    // A declared fn's OWN symbol, called directly — never a runtime
    // row (that is `call`, below).

    mut fn call_decl(ret: TypeId, callee: string, args: List<Reg>) -> Reg {
        let dst = self.mint_ty(ret)
        self.emit(Ins.Call(dst, callee, args))
        dst
    }

    /// The same, minted at an expression's own answer type.
    mut fn call_decl_at(e: ExprId, callee: string, args: List<Reg>) -> Reg {
        let dst = self.result(e)
        self.emit(Ins.Call(dst, callee, args))
        dst
    }

    /// A call THROUGH a register holding code — a closure or a `dyn`
    /// box's method.
    mut fn call_ptr(ret: TypeId, f: Reg, args: List<Reg>) -> Reg {
        let dst = self.mint_ty(ret)
        self.emit(Ins.CallPtr(dst, f, args))
        dst
    }

    /// The same, minted at an expression's own answer type.
    mut fn call_ptr_at(e: ExprId, f: Reg, args: List<Reg>) -> Reg {
        let dst = self.result(e)
        self.emit(Ins.CallPtr(dst, f, args))
        dst
    }

    // ── Runtime calls ───────────────────────────────────────────
    // The one door a row is called through — `rt()`'s generated
    // wrapper fns are the only callers; a feature spells a runtime
    // call as `rt().<name>(cx, ...)`, never `Ins.CallRt` directly.

    /// A row answering a value: minted at `sh`, the row's C symbol
    /// named by `row.name` alone — never a feature's own string.
    mut fn call(sh: Type, row: RtSig, args: List<Reg>) -> Reg {
        self.answered(self.view.types.intern(sh), row, args)
    }

    /// The same, minted at an expression's own answer type — the
    /// call-site already knows it through typing.
    mut fn call_at(e: ExprId, row: RtSig, args: List<Reg>) -> Reg {
        self.answered(self.type_at(e), row, args)
    }

    /// A row answering nothing.
    mut fn call_void(row: RtSig, args: List<Reg>) {
        let seats = [self.crossing(a) for a in args]
        self.emit(Ins.CallRtVoid(row.name, seats))
    }

    /// A row's answer at `ty`. A VALUE RECORD crosses every row BOXED:
    /// a row's seat and answer are one word, so the record goes in as a
    /// box of its fields and comes out read from one.
    mut fn answered(ty: TypeId, row: RtSig, args: List<Reg>) -> Reg {
        let seats = [self.crossing(a) for a in args]
        if !self.view.types.travels_wide(ty) {
            let dst = self.mint_ty(ty)
            self.emit(Ins.CallRt(dst, row.name, seats))
            return dst
        }
        let held = self.mint_ty(self.type(List<int>))
        self.emit(Ins.CallRt(held, row.name, seats))
        self.unboxed(held, ty)
    }

    /// A seat's word: the register itself, a value record's fields in a
    /// fresh box — a name over one opened to it first — or a value
    /// enum's tagged box.
    mut fn crossing(a: Reg) -> Reg {
        let ty = self.out.type_of_reg(a)
        if !self.view.types.travels_wide(ty) { return a }
        if self.valued(ty) {
            let v = self.opened_enum(a)
            return self
                .enum_boxed(
                    self.view.types.shape_of(self.type(List<int>)),
                    self.extracted(v, 0, self.mint_shape(Type.Int)),
                    self.extracted(v, 1, self.mint_shape(Type.Int)),
                    self.const_int(self.view.types.counted_mask(ty)),
                )
        }
        let parts = self.leaves(a)
        let dst = self
            .array_sized(self.view.types.shape_of(self.type(List<int>)), self.box_size(parts.length))
        for r in parts { self.push_slot(dst, r) }
        dst
    }

    /// The words a value occupies in a box: itself, or a value record's
    /// fields — a name over one opened to it first.
    mut fn leaves(a: Reg) -> List<Reg> {
        let ty = self.out.type_of_reg(a)
        if !self.view.types.lays_inline(ty) { return [a] }
        // a value enum is ONE leaf; the slot verbs lay its tag and word
        if self.valued(ty) { return [self.opened_enum(a)] }
        if !self.view.types.is_wide(ty) {
            return self
                .leaves(self.extracted(a, 0, self.mint_ty(self.view.types.flat_fields(ty)[0])))
        }
        [self.extracted(a, j, self.mint_ty(f)) for j, f in self.view.types.flat_fields(ty)]
    }

    /// A value record read back out of the box that carried it — worn
    /// by every name over it.
    mut fn unboxed(held: Reg, ty: TypeId) -> Reg {
        // a value enum crossed a one-word seat as its tagged box
        if self.valued(ty) {
            return self
                .named_over(
                    ty,
                    self
                        .pack(
                            self.view.types.machine_type(ty),
                            [self.enum_tag(Type.Int, held), self.enum_word(Type.Int, held)],
                        ),
                )
        }
        self.unboxed_at(held, 0, ty)
    }

    /// A value record read out of a box from slot `base` on; a value
    /// enum out of its tagged box.
    mut fn unboxed_at(held: Reg, base: int, ty: TypeId) -> Reg {
        if self.valued(ty) {
            let word = self.type(int)
            return self
                .named_over(
                    ty,
                    self
                        .pack(
                            self.view.types.machine_type(ty),
                            [self.slot_read(held, base, word), self.slot_read(held, base + 1, word)],
                        ),
                )
        }
        if !self.view.types.is_wide(ty) { return self.pack(ty, [self.unboxed_at(held, base, self.view.types.flat_fields(ty)[0])]) }
        self
            .pack(ty, [self.slot_read(held, base + j, f) for j, f in self.view.types.flat_fields(ty)])
    }

    /// Whether a value is a VALUE ENUM, seen through names.
    fn valued(ty: TypeId) -> bool { self.view.types.valued_carrier(ty) }

    /// A value enum's own register: a name over one opened to it.
    mut fn opened_enum(a: Reg) -> Reg {
        let ty = self.out.type_of_reg(a)
        let m = self.view.types.machine_type(ty)
        if same_type(m, ty) { return a }
        self.opened_enum(self.extracted(a, 0, self.mint_ty(self.view.types.flat_fields(ty)[0])))
    }

    /// A value worn by the name `ty` stands for: the value itself when
    /// `ty` is no name, else the name's pack over it.
    mut fn named_over(ty: TypeId, v: Reg) -> Reg {
        if same_type(self.view.types.machine_type(ty), ty) { return v }
        self.pack(ty, [self.named_over(self.view.types.flat_fields(ty)[0], v)])
    }

    /// The node's ANSWER register set to integer zero — a void word's
    /// answer, a null niche's, an API's "wrote nothing" answer. The
    /// answer is the only register, written by the constant.
    mut fn zero(e: ExprId) -> Reg {
        let dst = self.result(e)
        self.emit(Ins.ConstInt(dst, 0))
        dst
    }

    // ── Regions ─────────────────────────────────────────────────────
    // `cond.open_region()`, one `value.arm_end()` per arm but the last,
    // then `last.close_region()` — the region's value is the arm taken.
    // The answer register is minted LAST, after every arm's (style.early_answer_mint).
    mut fn open_region(cond: Reg) {
        self.emit(Ins.IfStart(cond))
    }

    mut fn arm_end(value: Reg) {
        self.emit(Ins.ArmEnd(value))
    }

    /// The region closed as the node's own value.
    mut fn close_region(e: ExprId, last: Reg) -> Reg {
        let dst = self.result(e)
        self.emit(Ins.RegionEnd(dst, last))
        dst
    }

    /// The region closed as a value of `ty` — a scratch region inside a
    /// node's lowering, not the node's own answer.
    mut fn close_region_as(ty: TypeId, last: Reg) -> Reg {
        let dst = self.mint_ty(ty)
        self.emit(Ins.RegionEnd(dst, last))
        dst
    }

    // ── Regions as ONE expression: the brackets spoken here, once,
    // so a site cannot open a region it does not close. Each arm is
    // a block handed the context it writes through. ──

    /// A two-armed region as the node's value: `taken` when `cond`
    /// holds, else `other`.
    mut fn region(
        cond: Reg,
        e: ExprId,
        taken: fn(mut LowerCx) -> Reg,
        other: fn(mut LowerCx) -> Reg,
    ) -> Reg {
        self.open_region(cond)
        self.arm_end(taken(self))
        self.close_region(e, other(self))
    }

    /// The same, closed as a value of `ty`.
    mut fn region_as(
        cond: Reg,
        ty: TypeId,
        taken: fn(mut LowerCx) -> Reg,
        other: fn(mut LowerCx) -> Reg,
    ) -> Reg {
        self.open_region(cond)
        self.arm_end(taken(self))
        self.close_region_as(ty, other(self))
    }

    /// A valueless region: `body` runs when `cond` holds, and
    /// nothing reads the merge.
    mut fn void_region(cond: Reg, body: fn(mut LowerCx) -> void) {
        self.open_region(cond)
        body(self)
        self.void_arm()
        self.void_close()
    }

    /// A valueless region with both arms.
    mut fn void_branches(cond: Reg, taken: fn(mut LowerCx) -> void, other: fn(mut LowerCx) -> void) {
        self.open_region(cond)
        taken(self)
        self.void_arm()
        other(self)
        self.void_close()
    }

    // ── Cells ───────────────────────────────────────────────────────
    /// A cell of `ty`, seeded — the seed minted before the cell.
    mut fn seeded_cell(ty: TypeId, seed: Reg) -> Reg {
        let cell = self.mint_ty(ty)
        self.emit(Ins.Alloca(cell))
        self.emit(Ins.Store(cell, seed))
        cell
    }

    /// The node's answer, read out of its cell.
    mut fn loaded(e: ExprId, cell: Reg) -> Reg {
        let dst = self.result(e)
        self.emit(Ins.Load(dst, cell))
        dst
    }

    /// A value of `ty`, read out of its cell.
    mut fn loaded_as(ty: TypeId, cell: Reg) -> Reg {
        let dst = self.mint_ty(ty)
        self.emit(Ins.Load(dst, cell))
        dst
    }

    /// `v` written into its cell.
    mut fn stored(cell: Reg, v: Reg) {
        self.emit(Ins.Store(cell, v))
    }

    // ── Loops ───────────────────────────────────────────────────────
    // `loop_start`, the condition's instructions, `more.loop_cond()` —
    // which opens the turn's scope — the body, then `loop_end`. Every
    // open loop holds a mark, so a jump counts the brackets it crosses;
    // a loop the program wrote names its statement at its condition,
    // where its turn begins and a `break` may first aim at it.
    mut fn loop_start() {
        self.loops.push(LoopMark { owner: null, frame: 0 })
        self.emit(Ins.LoopStart)
    }

    /// The condition, then the turn's scope — a `defer` frame, so the
    /// turn's deferred work runs as the turn ends, and the frame an
    /// early end of the turn runs down to.
    mut fn loop_cond(more: Reg, owner: StmtId? = null) {
        self.emit(Ins.LoopCond(more))
        self.scope_enter()
        self.loops.set(self.loops.length - 1, LoopMark { owner: owner, frame: self.depth })
    }

    mut fn loop_end() {
        self.scope_exit(null)
        self.emit(Ins.LoopEnd)
        let _ = self.loops.pop()
    }

    mut fn opened(subject: ExprId, elem: TypeId) -> Walk {
        self.opened_reg(subject, self.reg_of(subject), self.type_at(subject), elem)
    }

    /// A walk over a list already in a register — `flat_map`'s inner
    /// source, computed per outer element.
    mut fn opened_reg(e: ExprId, xs: Reg, ty: TypeId, elem: TypeId) -> Walk {
        let len = self.measure_of(e, xs, ty)
        let idx = self.seeded_cell(self.type(int), self.const_int(0))
        Walk { xs: xs, len: len, idx: idx, elem: elem, kind: walk_kind(self, ty) }
    }

    /// `lo..hi` — the count starts at `lo` and stops before `hi`.
    mut fn counted(lo: ExprId, hi: ExprId) -> Walk {
        let int = self.type(int)
        Walk {
            xs: null,
            len: self.reg_of(hi),
            idx: self.seeded_cell(int, self.reg_of(lo)),
            elem: int,
            kind: .List,
        }
    }

    /// LoopStart, the condition, the turn's scope, then the STEP — the
    /// count moves on as the turn BEGINS, so the back edge is the whole
    /// of a turn's end and a `continue` needs no latch. Answers this
    /// turn's count.
    mut fn turn_open(w: Walk, owner: StmtId? = null) -> Reg {
        self.loop_start()
        let at = self.mint_shape(Type.Int)
        self.emit(Ins.Load(at, w.idx))
        let more = self.mint_shape(Type.Bool)
        self.emit(Ins.Bin(more, BinOp.Lt, at, w.len))
        self.loop_cond(more, owner)
        let one = self.const_int(1)
        let next = self.mint_shape(Type.Int)
        self.emit(Ins.Bin(next, BinOp.Add, at, one))
        self.emit(Ins.Store(w.idx, next))
        at
    }

    /// This turn's element — a RUNTIME index, so the read stays raw.
    /// Asked of a list's walk only; a range's has no box.
    mut fn turn_elem(w: Walk, here: Reg) -> Reg {
        match w.kind {
            .List -> self.elem_read(w.xs!, here, w.elem),
            .Bytes -> self.bytes_at(Type.Int, w.xs!, here),
        }
    }

    /// The walk ends here: its answer is in hand.
    mut fn walk_done() {
        self.jumped(self.loops.length - 1, false)
    }

    /// The length of a register already in hand, as a scratch int — the
    /// same word, the same defect; `e` locates the defect.
    mut fn measure_of(e: ExprId, r: Reg, ty: TypeId) -> Reg {
        match self.view.types.seen_shape(ty) {
            .Str -> self.str_len(Type.Int, r),
            .Bytes -> self.bytes_len(Type.Int, r),
            .List(_) -> self.array_len(Type.Int, r),
            .Map(_, _) -> self.map_len(Type.Int, r),
            .Ptr or .Int or .Float or .Bool or .Cell(_) or .Task(_) or .Tasks or .Opt(_) or .Null or .Res(_, _) or .Var(_, _, _) or .App(_, _, _) or .Dyn(_, _) or .Fn(_, _, _) or .TypeName(_, _) or .EmptyList or .Error or .Void or .EmptyMap or .Struct(_, _) or .Enum(_, _) or .Union(_) -> self.unmeasurable(e),
        }
    }

    mut fn unmeasurable(e: ExprId) -> Reg {
        self.lower_defect(e, "a length on an unmeasurable shape survived typing")
    }

    /// Whether a measured subject (a `List`, `Map` or string) is
    /// EMPTY — its length against zero. The subject lowers FIRST, the
    /// answer mints last (style.early_answer_mint), as every measure does.
    mut fn measured_zero(e: ExprId, subject: ExprId) -> Reg {
        let len = self.measure_of(subject, self.reg_of(subject), self.type_at(subject))
        let zero = self.const_int(0)
        let dst = self.result(e)
        self.emit(Ins.Bin(dst, BinOp.Eq, len, zero))
        dst
    }
}

/// `x.is_empty()` — its length, by the shape's measure word, is zero.
/// Among the control verbs because it is the ONE method every
/// measurable shape shares — text, lists, bytes.
// LICENSED compiler.free_state_verb: a method ROW holds this fn as a value, and a method is none
export fn lower_is_empty(mut cx: LowerCx, mc: MethodCall) -> Reg {
    cx.measured_zero(mc.e, mc.subject)
}

// ── The walk ────────────────────────────────────────────────────
// One counting loop for every `for` and every list verb: `opened`
// over a list or `counted` over a range, then per turn `turn_open`
// (which answers the count), `turn_elem` (a list's walk only), the
// body, `loop_end`. Both engines read one stream for a comprehension, a
// `for x in xs` and an `xs.map(f)` because there is one skeleton.

/// A walk counts `idx` up to `len`; over a list, `xs` is the box each
/// turn reads at the count, and a range has no box to read.
/// What a walk source reads per turn: a list's element, or a byte of a
/// `Bytes`. The kind is DERIVED from the source's shape (`walk_kind`),
/// so a walk over `s.bytes()` reads octets without a second spelling.
export enum WalkKind {
    List
    Bytes
}

export type Walk = { xs: Reg?, len: Reg, idx: Reg, elem: TypeId, kind: WalkKind }

/// The kind a source of `ty` walks: a `Bytes` reads octets, anything
/// else (a list, a range) reads elements.
fn walk_kind(cx: LowerCx, ty: TypeId) -> WalkKind {
    match cx.view.types.seen_shape(ty) { .Bytes -> .Bytes, _ -> .List }
}

// ── Measures ────────────────────────────────────────────────────

/// `x.length` on a list, a map or a string — the word the one
/// measure table gives the shape; the subject lowers FIRST, the
/// answer mints last. A shape nothing measures is a defect typing
/// let through.
// LICENSED compiler.free_state_verb: a property ROW holds this fn as a value, and a method is none
export fn measured_reg(mut cx: LowerCx, e: ExprId, r: Reg, ty: TypeId) -> Reg {
    cx.measure_of(e, r, ty)
}
