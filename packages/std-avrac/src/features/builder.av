//! The builder-authoring surface: one `Builder` carries a build call's
//! world, and its methods are the whole vocabulary a feature needs.
use core.{NodeStore, Payload, found_at, Expr, Stmt, ExprId, StmtId, Span, TypeRef, named_ref, want, Param, Pat, PatId, Arm, Case, Mark, flatten, some_list, SeatMark, plain_mark, Scoped}
use grammar.{Captured, Token, Ready}

/// One build call's world: the store, the captured arguments in
/// grammar order, the engine-attributed span of the branch that
/// matched, and the source being parsed — a template keeps its
/// runs of source as its printing projection. Builders read
/// arguments and make nodes through this.
export type Builder = { store: NodeStore, args: List<Captured<LangNode>>, span: Span?, text: string = "", blocks: List<BlockGrammar> = [], payloads: List<Payload> = [] }

/// A sublanguage the file imports: its block word, its grammar
/// readied, and the file whose fns its actions name.
export type BlockGrammar = { word: string, ready: Ready, origin: string }

impl Builder {
    /// The token argument at `i`.
    fn token(i: int) -> Result<Token, string> {
        want(token_at(self.args, i), "a token argument")
    }

    /// The expression argument at `i`.
    fn expr(i: int) -> Result<ExprId, string> {
        want(expr_id_at(self.args, i), "an expression argument")
    }

    /// The statement argument at `i`.
    fn stmt(i: int) -> Result<StmtId, string> {
        want(stmt_id_at(self.args, i), "a statement argument")
    }

    /// THE SLOT A PAYLOAD NAME OCCUPIES — declaration order, which is
    /// the order arguments arrive in. Asking by NAME is what keeps two
    /// same-typed payloads from being swapped silently.
    fn slot_of(n: string) -> Result<int, string> {
        let at? = found_at([p.name for p in self.payloads], n) else { return .Err(unknown_payload(self.payloads, n)) }
        .Ok(at)
    }

    /// The text the payload `n` CARRIES — a token's, and a payload the
    /// rule stated alike: what a value means is decided by the payload
    /// it fills, never by how it was spelled.
    fn text_of(n: string) -> Result<string, string> {
        .Ok((self.token(self.slot_of(n)?)?).text)
    }

    /// The truth the payload `n` states. The assembly already refused
    /// any other word for a `bool` payload, so this is the belt.
    fn flag_of(n: string) -> Result<bool, string> {
        let word = self.text_of(n)?
        if word == "true" { return .Ok(true) }
        if word == "false" { return .Ok(false) }
        .Err("`${word}` states no truth — a `bool` payload is `true` or `false`")
    }

    /// The repeated text the payload `n` carries.
    fn texts_of(n: string) -> Result<List<string>, string> {
        .Ok([t.text for t in self.tokens(self.slot_of(n)?)?])
    }

    /// The expressions the payload `n` carries.
    fn exprs_of(n: string) -> Result<List<ExprId>, string> {
        self.exprs(self.slot_of(n)?)
    }

    /// The written-type argument at `i`.
    fn type_ref(i: int) -> Result<TypeRef, string> {
        want(type_ref_at(self.args, i), "a type argument")
    }

    // THE FOUR EXTRACTORS BELOW ARE ONE SHAPE ON PURPOSE. A generic
    // helper taking the per-type reader as a fn argument is the
    // obvious merge and it CORRUPTS: fn-typed arguments carry no
    // T-evidence (F1002), and pinning `<T>` over one mangles scalar
    // payloads through mono. Four copies, deliberately.

    /// The answer written at `i` — `void` when none.
    fn answer(i: int) -> TypeRef {
        type_ref_at(self.args, i) ?? void_ref
    }

    /// The repeated capture at `i`, as written types.
    fn type_refs(i: int) -> Result<List<TypeRef>, string> {
        let items = list_at(self.args, i)
        .Ok([want(type_ref_at(items, j), "a type in a repeated capture")? for j in 0..items.length])
    }

    /// The repeated capture at `i`, as plain tokens.
    fn tokens(i: int) -> Result<List<Token>, string> {
        let items = list_at(self.args, i)
        .Ok([want(token_at(items, j), "a token in a repeated capture")? for j in 0..items.length])
    }

    /// The repeated capture at `i`, as expression ids.
    fn exprs(i: int) -> Result<List<ExprId>, string> {
        let items = list_at(self.args, i)
        .Ok([want(expr_id_at(items, j), "an expression in a repeated capture")? for j in 0..items.length])
    }

    /// The repeated capture at `i`, as statement ids. A recovery hole
    /// becomes an explicit Stmt.Error node, as at the program's top
    /// level — every body survives bad input visibly.
    fn stmts(i: int) -> Result<List<StmtId>, string> {
        let items = list_at(self.args, i)
        mut out: List<StmtId> = []
        // LICENSED I3: the body allocates through `self.store`, which a comprehension element does not
        for j in 0..items.length {
            let sid: StmtId? = stmt_id_at(items, j)
            out.push(sid ?? self.store.alloc_stmt(Stmt.Error, null))
        }
        .Ok(out)
    }

    /// A new pattern node, spanning the matched branch.
    fn make_pat(p: Pat) -> Result<LangNode, string> {
        .Ok(LangNode.NPat(self.store.alloc_pat(p, self.span)))
    }

    /// One match arm, as data.
    fn make_arm(pats: List<PatId>, value: ExprId) -> Result<LangNode, string> {
        .Ok(LangNode.NArm(Arm { pats: pats, value: value }))
    }

    /// A new expression node, spanning the matched branch.
    fn make_expr(e: Expr) -> Result<LangNode, string> {
        .Ok(LangNode.NExpr(self.store.alloc_expr(e, self.span)))
    }

    /// A new statement node, spanning the matched branch.
    fn make_stmt(s: Stmt) -> Result<LangNode, string> {
        .Ok(LangNode.NStmt(self.store.alloc_stmt(s, self.span)))
    }

    /// A new expression node spanning the matched branch, as its id
    /// — for a builder that nests one node inside another.
    fn expr_node(e: Expr) -> ExprId {
        self.store.alloc_expr(e, self.span)
    }

    /// A written type as this build's result — no arena, no id.
    fn make_type(t: TypeRef) -> Result<LangNode, string> {
        .Ok(LangNode.NType(t))
    }

    /// An already-allocated expression as this build's result.
    fn wrap_expr(id: ExprId) -> Result<LangNode, string> {
        .Ok(LangNode.NExpr(id))
    }

    /// A head WIDENED by its trailing blocks — each marked as one,
    /// the call given them as its last arguments through the call
    /// protocol. A head that is no call refuses in the block's words.
    fn trailed(h: ExprId, blocks: List<ExprId>) -> Result<ExprId, string> {
        if blocks.is_empty() { return .Ok(h) }
        for k in blocks { self.store.mark_trailing(k) }
        let widened: Expr? = self.store.called_with(h, blocks)
        if widened == null { return .Err("a trailing block follows this expression, and only a call takes one — `f(…) { … }`, `a.m(…) { … }`, a name, a field read") }
        .Ok(self.expr_node(widened!))
    }

    /// THE BLOCK LAW: statements as a scope answering with its tail.
    /// A block's value is its final expression; one that ends in any
    /// other statement (or is empty) has none, and TYPING says what
    /// that means — void, or the fn's promise when the statement
    /// leaves. A scope holding nothing but its value IS the value: no
    /// node is minted for it.
    fn block_of(stmts: List<StmtId>) -> ExprId {
        if stmts.is_empty() { return self.expr_node(Expr.Block(stmts, null)) }
        let value? = self.store.answer_of(stmts.last()!) else { return self.expr_node(Expr.Block(stmts, null)) }
        if stmts.length == 1 { return value }
        self.expr_node(Expr.Block(stmts.slice(0, stmts.length - 1), value))
    }

    /// Where this build's branch ENDED — the bound a positional
    /// reconstruction measures against. Absent for a synthesized
    /// branch, and a caller that needs it must say so.
    fn span_end() -> int? {
        self.span?.hi
    }

    /// The span containing both expressions, when both are known.
    fn cover(a: ExprId, b: ExprId) -> Span? {
        self.store.cover(a, b)
    }
}

// ── Capture extractors behind the methods. All take the argument LIST
// plus an index: a Captured<LangNode> passed by itself as a fn
// argument misreads in the callee (see the subset note), while
// list-carried values stay intact. ──

/// The expression id at `args[i]`, when that capture is one.
export fn expr_id_at(args: List<Captured<LangNode>>, i: int) -> ExprId? {
    match args[i] {
        .Node(.NExpr(id)) -> id,
        _ -> null,
    }
}

/// The statement id at `args[i]`, when that capture is one.
export fn stmt_id_at(args: List<Captured<LangNode>>, i: int) -> StmtId? {
    match args[i] {
        .Node(.NStmt(id)) -> id,
        _ -> null,
    }
}

/// The written type at `args[i]`, when that capture is one.
export fn type_ref_at(args: List<Captured<LangNode>>, i: int) -> TypeRef? {
    match args[i] {
        .Node(.NType(t)) -> t,
        _ -> null,
    }
}

/// The answer a fn declares by writing none: `void`.
export const void_ref: TypeRef = named_ref("void")

/// The pattern at `args[i]`, when that capture is one.
export fn pat_id_at(args: List<Captured<LangNode>>, i: int) -> PatId? {
    match args[i] {
        .Node(.NPat(id)) -> id,
        _ -> null,
    }
}

/// The repeated pattern capture at `args[i]`, as pattern ids.
export fn pat_ids_at(args: List<Captured<LangNode>>, i: int) -> List<PatId> {
    let items = list_at(args, i)
    flatten([some_list(pat_id_at(items, j)) for j in 0..items.length])
}

/// The repeated mark capture at `args[i]`, as marks — in source
/// order, across every member the rule matched.
export fn marks_at(args: List<Captured<LangNode>>, i: int) -> List<Mark> {
    let items = list_at(args, i)
    flatten([some_list(mark_of(items, j)) for j in 0..items.length])
}

fn mark_of(args: List<Captured<LangNode>>, i: int) -> Mark? {
    match args[i] {
        .Node(.NMark(m)) -> m,
        _ -> null,
    }
}

/// The repeated arm capture at `args[i]`, as arms.
export fn arms_at(args: List<Captured<LangNode>>, i: int) -> List<Arm> {
    let items = list_at(args, i)
    flatten([some_list(arm_at(items, j)) for j in 0..items.length])
}

/// The repeated case capture at `args[i]`, flattened — a `given`
/// group's cases and a lone `then`'s alike.
export fn cases_at(args: List<Captured<LangNode>>, i: int) -> List<Case> {
    let items = list_at(args, i)
    flatten([cases_of(items, j) for j in 0..items.length])
}

fn cases_of(args: List<Captured<LangNode>>, i: int) -> List<Case> {
    match args[i] {
        .Node(.NCases(cs)) -> cs,
        _ -> [],
    }
}

fn arm_at(args: List<Captured<LangNode>>, i: int) -> Arm? {
    match args[i] {
        .Node(.NArm(a)) -> a,
        _ -> null,
    }
}

/// The token at `args[i]`, when that capture is one.
export fn token_at(args: List<Captured<LangNode>>, i: int) -> Token? {
    match args[i] {
        .Terminal(t) -> t,
        _ -> null,
    }
}

/// AN OPTIONAL BINDER: the token's text as a scope-keying name,
/// absent when the token is. An optional name payload arrives from
/// the grammar this way, so the wrap lives here once.
export fn scoped_at(t: Token?) -> Scoped? {
    if t == null { return null }
    Scoped(t!.text)
}

/// List delivery for the repeated capture at `args[i]` (scalar and
/// absent normalize).
export fn list_at(args: List<Captured<LangNode>>, i: int) -> List<Captured<LangNode>> {
    match args[i] {
        .Many(xs) -> xs,
        .Absent -> [],
        .Terminal(t) -> [Captured.Terminal(t)],
        .Node(n) -> [Captured.Node(n)],
    }
}

/// The window an arm's captures live in: from this anchor to the
/// next (or the whole span's end) — how PER-ARM optional captures
/// re-align with their arms after a flat repeated parse.
export fn window_end(anchors: List<Token>, j: int, ends: int) -> int {
    if j + 1 < anchors.length { return anchors[j + 1].span.lo }
    ends
}

/// Each arm's optional bind — "" IS an arm that names nothing.
/// Anchored WINDOW alignment for optional per-anchor TYPES: each
/// anchor's annotation, when one was written inside its window —
/// the third user made this the shared law (fns, trait sigs,
/// lambdas).
export fn aligned_param_types(anchors: List<Token>, optional: List<TypeRef>, ends: int) -> List<TypeRef?> {
    [one_between(optional, a.span.lo, window_end(anchors, j, ends)) for j, a in anchors]
}

fn one_between(types: List<TypeRef>, after: int, before: int) -> TypeRef? {
    types.find(ref_within(it, after, before))
}

/// A MARK MARKS THE MEMBER IT PRECEDES, so it belongs to the nearest
/// anchor that follows it. `anchors` holds EVERY place on the
/// declaration a mark may land — an enum's variant names AND its
/// payload types — in any order; a set short of one anchor reads
/// that member's marks as its successor's. `from` is the
/// declaration's own start: nothing before it is a member's mark.
export type MarkWindows = { anchors: List<int>, marks: List<Mark>, from: int }

impl MarkWindows {
    /// The marks the anchor at `lo` carries.
    fn at(lo: int) -> List<Mark> {
        marks_inside(self.marks, self.opens_before(lo), lo)
    }

    /// Where an anchor's window opens: the nearest anchor before it,
    /// or the declaration's start when nothing precedes it.
    fn opens_before(lo: int) -> int {
        mut open = self.from
        for a in self.anchors {
            if a > open && a < lo { open = a }
        }
        open
    }
}

/// A WRITTEN TYPE'S START — the anchor a payload's marks precede, and
/// the projection two enum sites would otherwise spell twice.
export fn type_lo(t: TypeRef) -> int {
    t.span?.lo ?? 0
}

/// The marks whose `@` stands strictly inside a window.
fn marks_inside(marks: List<Mark>, after: int, before: int) -> List<Mark> {
    [m for m in marks if m.span != null && within(m.span!.lo, after, before)]
}

export fn ref_within(t: TypeRef, after: int, before: int) -> bool {
    let lo? = t.span?.lo else { return false }
    lo > after && lo < before
}

export fn aligned_binds(anchors: List<Token>, optional: List<Token>, ends: int) -> List<string> {
    [token_between(optional, a.span.lo, window_end(anchors, j, ends)) for j, a in anchors]
}

/// The one optional token written between two anchors, or "".
fn token_between(tokens: List<Token>, after: int, before: int) -> string {
    let hit? = tokens.find(within(it.span.lo, after, before)) else { return "" }
    hit.text
}

impl Builder {
    /// Field names, their types, and the DEFAULTS some carry, zipped —
    /// captures arrive per slot, so a default finds its field by
    /// POSITION: the last name that starts before it.
    fn fields_zipped(fs: List<Token>, ft: List<TypeRef>, fds: List<ExprId>, marks: List<Mark>) -> Result<List<Param>, string> {
        if fs.length != ft.length {
            return .Err(zip_defect_of("field names and types"))
        }
        let w = MarkWindows { anchors: [f.span.lo for f in fs], marks: marks, from: self.span?.lo ?? 0 }
        .Ok([Param { name: Scoped(f.text), ty: ft[j], default: self.default_before(fs, fds, j), promises: plain_mark, span: f.span, marks: w.at(f.span.lo) } for j, f in fs])
    }

    /// The default whose position falls between field `j`'s name and
    /// the next field's — null when none does.
    fn default_before(fs: List<Token>, fds: List<ExprId>, j: int) -> ExprId? {
        let lo = fs[j].span.lo
        let hi: int = if j + 1 < fs.length { fs[j + 1].span.lo } else { 1000000000 }
        fds.find((d) -> self.starts_between(d, lo, hi))
    }

    fn starts_between(e: ExprId, lo: int, hi: int) -> bool {
        let sp: Span? = self.store.expr_span(e)
        sp != null && within(sp!.lo, lo, hi)
    }
}

/// Strictly inside the window `after..before`.
export fn within(at: int, after: int, before: int) -> bool {
    at > after && at < before
}

/// Parameter seats from two parallel captures — the names and the
/// types they aligned to — with no defaults: what every fn-shaped
/// declaration zips.
export fn seats(ps: List<Token>, tys: List<TypeRef?>) -> List<Param> {
    marked_seats(ps, tys, [], [], 0)
}

/// Seats with their marks: a `mut` or `const` token between the
/// previous name (or `from`, before the first) and a name marks that
/// seat. ONE window law, so every param list — a fn's, a method's, a
/// lambda's, a fn type's — reads the same marks the same way.
export fn marked_seats(ps: List<Token>, tys: List<TypeRef?>, muts: List<Token>, consts: List<Token>, from: int) -> List<Param> {
    [Param { name: Scoped(p.text), ty: tys[j], default: null, promises: seat_mark_of(muts, consts, seat_since(ps, j, from), p.span.lo), span: p.span } for j, p in ps]
}

/// One seat's contract: the `mut` and `const` tokens written in its
/// window — the window a mark shares with the name it precedes.
fn seat_mark_of(muts: List<Token>, consts: List<Token>, after: int, before: int) -> SeatMark {
    SeatMark {
        mutable: muts.any(mark_within(it, after, before)),
        settled: consts.any(mark_within(it, after, before)),
    }
}

/// Where seat `j`'s mark may start: after the previous name, or `from`.
fn seat_since(ps: List<Token>, j: int, from: int) -> int {
    if j == 0 { from } else { ps[j - 1].span.lo }
}

fn mark_within(t: Token, after: int, before: int) -> bool {
    within(t.span.lo, after, before)
}

/// A build asked for a payload its variant does not declare.
fn unknown_payload(ps: List<Payload>, n: string) -> string {
    if ps.is_empty() { return "no payload `${n}` — this build carries none" }
    "no payload `${n}` — this build carries `${[p.name for p in ps].join("`, `")}`"
}
