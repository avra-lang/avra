//! The builder-authoring surface: one `Builder` carries a build call's
//! world, and its methods are the whole vocabulary a feature needs.
use core.{
    SyntaxArena,
    Spread,
    found_at,
    Expr,
    Stmt,
    ExprId,
    StmtId,
    Span,
    TypeRef,
    named_ref,
    want,
    Param,
    Pat,
    PatId,
    Arm,
    Case,
    Mark,
    Variant,
    CompClause,
    flatten,
    some_list,
    SeatMark,
    plain_mark,
    Scoped,
    facet_table,
}
use core.{Slots}
use @std.meta.{Field}
use @std.grammar.{Captured, Ready}
use grammar.{Token}
/// One build call's world: the store, the captured arguments in
/// grammar order, the engine-attributed span of the branch that
/// matched, and the source being parsed — a template keeps its
/// runs of source as its printing projection. Builders read
/// arguments and make nodes through this.
export type Builder = { store: SyntaxArena, args: List<Captured<Token, LangNode>>, span: Span?, text: string = "", words: BlockWords = BlockWords {}, payloads: List<Field> = [] }

/// A sublanguage the file imports: its block word, its grammar
/// readied, and the file whose fns its actions name.
export type BlockGrammar = { word: string, ready: Ready, origin: string }

/// A component a file stands under: its word, how an instance of it
/// stands in place, the store and file its provider parsed it in, and
/// whether the file's own module declares it — a word that opens an
/// instance only where it names one.
export type ComponentWord = { word: string, declared: string, form: Instancing, store: SyntaxArena, origin: string, own: bool = false }

/// How an instance stands in place: by its TEMPLATE, as a literal of
/// its RECORD, or REFUSED in the library's words, spoken at the
/// instance. UNREAD is a word known by its name alone — its own
/// module's, in the parse its form is read off: the instance parses
/// as one and stands as a hole, with nothing said.
export enum Instancing {
    Template(template: Template)
    Record(record: Record)
    Refused(why: string)
    Unread
}

/// A component with no `expand`: its instance is a literal of the
/// record. The head's fields in order, the fields an instance's
/// statements may fill as children — its `List` fields beside the
/// head — whether a `name` field takes a named instance's name, and
/// whether a `check` judges each instance at compile time, and the
/// field a body written as a fn fills — the record's one fn field,
/// and whether ITS ANSWER is nullable, which decides whether an ARMS
/// body written over it takes an implicit `_ -> null` tail. Its
/// `events` are what an instance may hear.
export type Record = { head: List<string>, slots: List<ChildSlot>, named: bool, checks: bool, fn_field: string? = null, fn_optional: bool = false, events: List<Event> = [] }

/// An event a component declares, and the seats its handler is told.
export type Event = { name: string, says: List<string> }

/// A `List` field children fill, and the name its elements are
/// written with — a child instance of that component lands here.
export type ChildSlot = { name: string, of: string, gathers: bool = true }

/// An `expand` of ONE `quote`: the head's fields in order, the field
/// the block fills, the field each hole reads, the quote's statements,
/// and the head fields that are PATTERNS (`Format`) — each read as its
/// text where a value stands and as its record where a type does.
export type Template = { head: List<string>, block: string, reads: List<string>, stmts: List<StmtId>, formats: List<string> = [] }

/// A named instance a record's body may list by its name alone: the
/// name, and the component it instances.
export type Instanced = { name: string, declared: string }

/// The words a file's imports open blocks with — named grammars and
/// components — and the named instances its bodies may list.
export type BlockWords = { grammars: List<BlockGrammar> = [], components: List<ComponentWord> = [], instances: List<Instanced> = [] }

impl BlockWords {
    fn is_empty() -> bool { self.grammars.is_empty() && self.components.is_empty() }
}

impl Slots for Builder {
    /// The expression the optional payload `label` carries, if any.
    fn expr_opt_of(label: string) -> Result<ExprId?, string> {
        .Ok(expr_id_at(self.args, self.slot_of(label)?))
    }

    /// The repeated text the payload `label` carries.
    fn texts_of(label: string) -> Result<List<string>, string> {
        .Ok([t.text for t in self.tokens(self.slot_of(label)?)?])
    }

    /// The optional name the payload `label` carries, if any.
    fn scoped_opt_of(label: string) -> Result<Scoped?, string> {
        .Ok(scoped_at((self.tokens(self.slot_of(label)?)?).first()))
    }

    /// Whether the word the payload `label` names was written.
    fn present_of(label: string) -> Result<bool, string> {
        .Ok(!(self.tokens(self.slot_of(label)?)?).is_empty())
    }

    /// The seats the payload `label` carries.
    fn params_of(label: string) -> Result<List<Param>, string> {
        .Ok(params_at(self.args, self.slot_of(label)?))
    }

    /// The enum variants the payload `label` carries.
    fn variants_of(label: string) -> Result<List<Variant>, string> {
        .Ok(variants_at(self.args, self.slot_of(label)?))
    }

    /// The marks the payload `label` carries.
    fn marks_of(label: string) -> Result<List<Mark>, string> {
        .Ok(marks_at(self.args, self.slot_of(label)?))
    }

    /// The match arms the payload `label` carries.
    fn arms_of(label: string) -> Result<List<Arm>, string> {
        .Ok(arms_at(self.args, self.slot_of(label)?))
    }

    /// The spec cases the payload `label` carries.
    fn cases_of(label: string) -> Result<List<Case>, string> {
        .Ok(cases_at(self.args, self.slot_of(label)?))
    }

    /// The statements the payload `label` carries.
    fn stmts_of(label: string) -> Result<List<StmtId>, string> {
        self.stmts(self.slot_of(label)?)
    }

    /// The patterns the payload `label` carries.
    fn pats_of(label: string) -> Result<List<PatId>, string> {
        .Ok(pat_ids_at(self.args, self.slot_of(label)?))
    }

    /// The written type the payload `label` carries.
    fn type_of(label: string) -> Result<TypeRef, string> {
        self.type_ref(self.slot_of(label)?)
    }

    /// The written types the payload `label` carries.
    fn types_of(label: string) -> Result<List<TypeRef>, string> {
        self.type_refs(self.slot_of(label)?)
    }

    /// The written type the optional payload `label` carries, if any.
    fn type_opt_of(label: string) -> Result<TypeRef?, string> {
        .Ok((self.type_refs(self.slot_of(label)?)?).first())
    }

    /// The expressions the payload `n` carries.
    fn exprs_of(label: string) -> Result<List<ExprId>, string> {
        self.exprs(self.slot_of(label)?)
    }

    /// The expression the payload `n` carries.
    fn expr_of(label: string) -> Result<ExprId, string> {
        self.expr(self.slot_of(label)?)
    }

    /// The text the payload `n` CARRIES — a token's, and a payload the
    /// rule stated alike: what a value means is decided by the payload
    /// it fills, never by how it was spelled.
    fn text_of(label: string) -> Result<string, string> {
        .Ok((self.token(self.slot_of(label)?)?).text)
    }

    /// The truth the payload `n` states. The assembly already refused
    /// any other word for a `bool` payload, so this is the belt.
    fn flag_of(label: string) -> Result<bool, string> {
        let word = self.text_of(label)?
        if word == "true" { return .Ok(true) }
        if word == "false" { return .Ok(false) }
        .Err("`${word}` states no truth — a `bool` payload is `true` or `false`")
    }
}

impl Builder {
    /// The token argument at `i`.
    fn token(i: int) -> Result<Token, string> {
        want(token_at(self.args, i), "a token argument")
    }

    /// The expression argument at `i`.
    fn expr(i: int) -> Result<ExprId, string> {
        want(expr_id_at(self.args, i), "an expression argument")
    }

    /// The statement argument at `i`.
    fn stmt(i: int) -> Result<StmtId, string> {
        want(stmt_id_at(self.args, i), "a statement argument")
    }

    /// THE SLOT A PAYLOAD NAME OCCUPIES — declaration order, which is
    /// the order arguments arrive in. Asking by NAME is what keeps two
    /// same-typed payloads from being swapped silently.
    fn slot_of(n: string) -> Result<int, string> {
        let at? = found_at([p.name for p in self.payloads], n) else { return .Err(unknown_payload(self.payloads, n)) }
        .Ok(at)
    }

    /// The written-type argument at `i`.
    fn type_ref(i: int) -> Result<TypeRef, string> {
        want(type_ref_at(self.args, i), "a type argument")
    }

    // THE FOUR EXTRACTORS BELOW ARE ONE SHAPE ON PURPOSE. A generic
    // helper taking the per-type reader as a fn argument is the
    // obvious merge and it CORRUPTS: fn-typed arguments carry no
    // T-evidence (F1002), and pinning `<T>` over one mangles scalar
    // payloads through mono. Four copies, deliberately.

    /// The answer written at `i` — `void` when none.
    fn answer(i: int) -> TypeRef {
        type_ref_at(self.args, i) ?? void_ref
    }

    /// The repeated capture at `i`, as written types.
    fn type_refs(i: int) -> Result<List<TypeRef>, string> {
        let items = list_at(self.args, i)
        .Ok([want(type_ref_at(items, j), "a type in a repeated capture")? for j in 0..items.length])
    }

    /// The repeated capture at `i`, as plain tokens.
    fn tokens(i: int) -> Result<List<Token>, string> {
        let items = list_at(self.args, i)
        .Ok([want(token_at(items, j), "a token in a repeated capture")? for j in 0..items.length])
    }

    /// The repeated capture at `i`, as expression ids.
    fn exprs(i: int) -> Result<List<ExprId>, string> {
        let items = list_at(self.args, i)
        .Ok(
            [want(expr_id_at(items, j), "an expression in a repeated capture")? for j in 0..items.length],
        )
    }

    /// The repeated capture at `i`, as statement ids. A recovery hole
    /// becomes an explicit Stmt.Error node, as at the program's top
    /// level — every body survives bad input visibly.
    fn stmts(i: int) -> Result<List<StmtId>, string> {
        let items = list_at(self.args, i)
        .Ok([stmt_id_at(items, j) ?? self.store.alloc_stmt(Stmt.Error) for j in 0..items.length])
    }

    /// A new pattern node, spanning the matched branch. A `@facet`
    /// field has no pattern side table, so it is refused here rather
    /// than silently dropped.
    fn make_pat(p: Pat) -> Result<LangNode, string> {
        self.no_facets_here()?
        .Ok(LangNode.NPat(self.store.alloc_pat(p, self.span)))
    }

    /// One match arm, as data — `guard` null for an unguarded one.
    fn make_arm(pats: List<PatId>, value: ExprId, guard: ExprId?) -> Result<LangNode, string> {
        .Ok(LangNode.NArm(Arm { pats: pats, guard: guard, value: value }))
    }

    /// One comprehension clause, as data.
    fn make_comp_clause(c: CompClause) -> Result<LangNode, string> {
        .Ok(LangNode.NCompClause(c))
    }

    /// A new expression node, spanning the matched branch. A `@facet`
    /// field has no expression side table, so it is refused here
    /// rather than silently dropped.
    fn make_expr(e: Expr) -> Result<LangNode, string> {
        self.no_facets_here()?
        .Ok(LangNode.NExpr(self.store.alloc_expr(e, self.span)))
    }

    /// Refuse a `@facet` field where the arena has no side table for it
    /// — only a statement's facets have a writer.
    fn no_facets_here() -> Result<bool, string> {
        let f? = self.payloads.find(facet_table(it) != null) else { return .Ok(true) }
        .Err(facet_not_a_stmt(f.name))
    }

    /// A new statement node, spanning the matched branch. A `@facet`
    /// field the rule's payload carries is written to its side table
    /// here, keyed by the node just allocated.
    fn make_stmt(s: Stmt) -> Result<LangNode, string> {
        let id = self.store.alloc_stmt(s, self.span)
        self.faceted_stmt(id)
    }

    /// The node `id` names, once every facet field the rule's payload
    /// carries is written into the store table its mark names. A table
    /// no row names is a defect at the mark, never a silent drop.
    fn faceted_stmt(id: StmtId) -> Result<LangNode, string> {
        for f in self.payloads {
            let side? = facet_table(f) else { continue }
            if !self.present_of(f.name)? { continue }
            let row? = facet_rows().find(it.side == side) else { return .Err(facet_table_unknown(f.name, side)) }
            (row.mark)(self.store, id)
        }
        .Ok(LangNode.NStmt(id))
    }

    /// A new expression node spanning the matched branch, as its id
    /// — for a builder that nests one node inside another.
    fn expr_node(e: Expr) -> ExprId {
        self.store.alloc_expr(e, self.span)
    }

    /// A written type as this build's result — no arena, no id.
    fn make_type(t: TypeRef) -> Result<LangNode, string> {
        .Ok(LangNode.NType(t))
    }

    /// An already-allocated expression as this build's result.
    fn wrap_expr(id: ExprId) -> Result<LangNode, string> {
        .Ok(LangNode.NExpr(id))
    }

    /// An already-allocated statement as this build's result — for a
    /// builder that marks the statement between allocating it and
    /// answering it.
    fn wrap_stmt(id: StmtId) -> Result<LangNode, string> {
        .Ok(LangNode.NStmt(id))
    }

    /// A head WIDENED by its trailing blocks — each marked as one,
    /// the call given them as its last arguments through the call
    /// protocol. A head that is no call refuses in the block's words.
    fn trailed(h: ExprId, blocks: List<ExprId>) -> Result<ExprId, string> {
        if blocks.is_empty() { return .Ok(h) }
        for k in blocks { self.store.mark_trailing(k) }
        let widened: Expr? = self.store.called_with(h, blocks)
        if widened == null {
            return .Err(
                "a trailing block follows this expression, and only a call takes one — `f(…) { … }`, `a.m(…) { … }`, a name, a field read",
            )
        }
        .Ok(self.expr_node(widened!))
    }

    /// THE BLOCK LAW: statements as a scope answering with its tail.
    /// A block's value is its final expression; one that ends in any
    /// other statement (or is empty) has none, and TYPING says what
    /// that means — void, or the fn's promise when the statement
    /// leaves. AN EXPLICIT SCOPE IS A NODE, even when its only content
    /// is its value: the braces are the author's form, and returning
    /// the value drops them (the printer cannot keep what the parse
    /// never minted) — `tail_scoped` (core/store.av) is where a found
    /// value gets wrapped back in, shared with `branch_value` so the
    /// two cannot drift.
    fn block_of(stmts: List<StmtId>) -> ExprId {
        if stmts.is_empty() { return self.expr_node(Expr.Block(stmts, null)) }
        let tail = stmts.last()!
        let value? = self.store.answer_of(tail) else { return self.expr_node(Expr.Block(stmts, null)) }
        self.store.tail_scoped(stmts, tail, value, self.span)
    }

    /// Where this build's branch ENDED — the bound a positional
    /// reconstruction measures against. Absent for a synthesized
    /// branch, and a caller that needs it must say so.
    fn span_end() -> int? {
        self.span?.hi
    }

    /// The span containing both expressions, when both are known.
    fn cover(a: ExprId, b: ExprId) -> Span? {
        self.store.cover(a, b)
    }
}

// ── Capture extractors behind the methods. All take the argument LIST
// plus an index: a Captured<Token, LangNode> passed by itself as a fn
// argument misreads in the callee (see the subset note), while
// list-carried values stay intact. ──

/// The expression id at `args[i]`, when that capture is one.
export fn expr_id_at(args: List<Captured<Token, LangNode>>, i: int) -> ExprId? {
    match args[i] { .Node(.NExpr(id)) -> id, _ -> null }
}

/// The statement id at `args[i]`, when that capture is one.
export fn stmt_id_at(args: List<Captured<Token, LangNode>>, i: int) -> StmtId? {
    match args[i] { .Node(.NStmt(id)) -> id, _ -> null }
}

/// The written type at `args[i]`, when that capture is one.
export fn type_ref_at(args: List<Captured<Token, LangNode>>, i: int) -> TypeRef? {
    match args[i] { .Node(.NType(t)) -> t, _ -> null }
}

/// The answer a fn declares by writing none: `void`.
export const void_ref: TypeRef = named_ref("void")

/// The pattern at `args[i]`, when that capture is one.
export fn pat_id_at(args: List<Captured<Token, LangNode>>, i: int) -> PatId? {
    match args[i] { .Node(.NPat(id)) -> id, _ -> null }
}

/// The repeated pattern capture at `args[i]`, as pattern ids.
export fn pat_ids_at(args: List<Captured<Token, LangNode>>, i: int) -> List<PatId> {
    let items = list_at(args, i)
    flatten([some_list(pat_id_at(items, j)) for j in 0..items.length])
}

/// The repeated mark capture at `args[i]`, as marks — in source
/// order, across every member the rule matched.
export fn marks_at(args: List<Captured<Token, LangNode>>, i: int) -> List<Mark> {
    let items = list_at(args, i)
    flatten([some_list(mark_of(items, j)) for j in 0..items.length])
}

fn mark_of(args: List<Captured<Token, LangNode>>, i: int) -> Mark? {
    match args[i] { .Node(.NMark(m)) -> m, _ -> null }
}

/// The repeated seat capture at `args[i]`, as parameters.
export fn params_at(args: List<Captured<Token, LangNode>>, i: int) -> List<Param> {
    let items = list_at(args, i)
    flatten([some_list(param_of(items, j)) for j in 0..items.length])
}

fn param_of(args: List<Captured<Token, LangNode>>, i: int) -> Param? {
    match args[i] { .Node(.NParam(p)) -> p, _ -> null }
}

/// The repeated variant capture at `args[i]`, as variants.
export fn variants_at(args: List<Captured<Token, LangNode>>, i: int) -> List<Variant> {
    let items = list_at(args, i)
    flatten([some_list(variant_of(items, j)) for j in 0..items.length])
}

fn variant_of(args: List<Captured<Token, LangNode>>, i: int) -> Variant? {
    match args[i] { .Node(.NVariant(v)) -> v, _ -> null }
}

/// The repeated arm capture at `args[i]`, as arms.
export fn arms_at(args: List<Captured<Token, LangNode>>, i: int) -> List<Arm> {
    let items = list_at(args, i)
    flatten([some_list(arm_at(items, j)) for j in 0..items.length])
}

/// The repeated case capture at `args[i]`, flattened — a `given`
/// group's cases and a lone `then`'s alike.
export fn cases_at(args: List<Captured<Token, LangNode>>, i: int) -> List<Case> {
    let items = list_at(args, i)
    flatten([cases_of(items, j) for j in 0..items.length])
}

fn cases_of(args: List<Captured<Token, LangNode>>, i: int) -> List<Case> {
    match args[i] { .Node(.NCases(cs)) -> cs, _ -> [] }
}

fn arm_at(args: List<Captured<Token, LangNode>>, i: int) -> Arm? {
    match args[i] { .Node(.NArm(a)) -> a, _ -> null }
}

/// The comprehension clause at `args[i]`, when that capture is one.
export fn comp_clause_at(args: List<Captured<Token, LangNode>>, i: int) -> CompClause? {
    match args[i] { .Node(.NCompClause(c)) -> c, _ -> null }
}

/// The repeated comprehension clause capture at `args[i]`, as clauses.
export fn comp_clauses_at(args: List<Captured<Token, LangNode>>, i: int) -> List<CompClause> {
    let items = list_at(args, i)
    flatten([some_list(comp_clause_at(items, j)) for j in 0..items.length])
}

/// The token at `args[i]`, when that capture is one.
export fn token_at(args: List<Captured<Token, LangNode>>, i: int) -> Token? {
    match args[i] { .Terminal(t) -> t, _ -> null }
}

/// AN OPTIONAL BINDER: the token's text as a scope-keying name,
/// absent when the token is. An optional name payload arrives from
/// the grammar this way, so the wrap lives here once.
export fn scoped_at(t: Token?) -> Scoped? {
    if t == null { return null }
    Scoped(t!.text)
}

/// List delivery for the repeated capture at `args[i]` (scalar and
/// absent normalize).
export fn list_at(args: List<Captured<Token, LangNode>>, i: int) -> List<Captured<Token, LangNode>> {
    match args[i] {
        .Many(xs) -> xs,
        .Absent -> [],
        .Terminal(t) -> [Captured.Terminal(t)],
        .Node(n) -> [Captured.Node(n)],
    }
}

/// The window an arm's captures live in: from this anchor to the
/// next (or the whole span's end) — how PER-ARM optional captures
/// re-align with their arms after a flat repeated parse.
export fn window_end(anchors: List<Token>, j: int, ends: int) -> int {
    if j + 1 < anchors.length { return anchors[j + 1].span.lo }
    ends
}

/// Each arm's optional bind — "" IS an arm that names nothing.
/// Anchored WINDOW alignment for optional per-anchor TYPES: each
/// anchor's annotation, when one was written inside its window —
/// the third user made this the shared law (fns, trait sigs,
/// lambdas).
export fn aligned_param_types(anchors: List<Token>, optional: List<TypeRef>, ends: int) -> List<
    TypeRef?,
> {
    [one_between(optional, a.span.lo, window_end(anchors, j, ends)) for j, a in anchors]
}

fn one_between(types: List<TypeRef>, after: int, before: int) -> TypeRef? {
    types.find(ref_within(it, after, before))
}

/// A MARK MARKS THE MEMBER IT PRECEDES, so it belongs to the nearest
/// anchor that follows it. `anchors` holds EVERY place on the
/// declaration a mark may land — an enum's variant names AND its
/// payload types — in any order; a set short of one anchor reads
/// that member's marks as its successor's. `from` is the
/// declaration's own start: nothing before it is a member's mark.
export type MarkWindows = { anchors: List<int>, marks: List<Mark>, from: int }

impl MarkWindows {
    /// The marks the anchor at `lo` carries.
    fn at(lo: int) -> List<Mark> {
        marks_inside(self.marks, self.opens_before(lo), lo)
    }

    /// Where an anchor's window opens: the nearest anchor before it,
    /// or the declaration's start when nothing precedes it.
    fn opens_before(lo: int) -> int {
        mut open = self.from
        for a in self.anchors {
            if a > open && a < lo { open = a }
        }
        open
    }
}

/// A WRITTEN TYPE'S START — the anchor a payload's marks precede, and
/// the projection two enum sites would otherwise spell twice.
export fn type_lo(t: TypeRef) -> int {
    t.span?.lo ?? 0
}

/// The marks whose `@` stands strictly inside a window.
fn marks_inside(marks: List<Mark>, after: int, before: int) -> List<Mark> {
    [m for m in marks if m.span != null && between(m.span!.lo, after, before)]
}

export fn ref_within(t: TypeRef, after: int, before: int) -> bool {
    let lo? = t.span?.lo else { return false }
    lo > after && lo < before
}

export fn aligned_binds(anchors: List<Token>, optional: List<Token>, ends: int) -> List<string> {
    [token_between(optional, a.span.lo, window_end(anchors, j, ends)) for j, a in anchors]
}

/// The one optional token written between two anchors, or "".
fn token_between(tokens: List<Token>, after: int, before: int) -> string {
    let hit? = tokens.find(between(it.span.lo, after, before)) else { return "" }
    hit.text
}

impl Builder {
    /// Field names, their types, and the DEFAULTS some carry, zipped —
    /// captures arrive per slot, so a default finds its field by
    /// POSITION: the last name that starts before it.
    fn fields_zipped(
        fs: List<Token>,
        ft: List<TypeRef>,
        fds: List<ExprId>,
        marks: List<Mark>,
        states: List<Token> = [],
    ) -> Result<List<Param>, string> {
        let typed = [self.type_after(fs, ft, j) for j, f in fs]
        if [t for t in typed if t != null].length != ft.length {
            return .Err(zip_defect_of("field names and types"))
        }
        let w = MarkWindows {
            anchors: [f.span.lo for f in fs],
            marks: marks,
            from: self.span?.lo ?? 0,
        }
        .Ok(
            [Param {
                name: Scoped(f.text),
                ty: typed[j],
                default: self.default_before(fs, fds, j),
                promises: plain_mark,
                id: self.store.alloc_param_id(f.span),
                marks: w.at(f.span.lo),
                state: state_before(fs, states, j, self.span?.lo ?? 0),
            } for j, f in fs],
        )
    }

    /// The default whose position falls between field `j`'s name and
    /// the next field's — null when none does.
    fn default_before(fs: List<Token>, fds: List<ExprId>, j: int) -> ExprId? {
        let lo = fs[j].span.lo
        let hi: int = if j + 1 < fs.length { fs[j + 1].span.lo } else { 1000000000 }
        fds.find((d) -> self.starts_between(d, lo, hi))
    }

    /// The written type between field `j`'s name and the next field's
    /// — null for a hole standing as the whole field.
    fn type_after(fs: List<Token>, ft: List<TypeRef>, j: int) -> TypeRef? {
        let lo = fs[j].span.lo
        let hi: int = if j + 1 < fs.length { fs[j + 1].span.lo } else { 1000000000 }
        ft.find((t) -> t.span != null && between(t.span!.lo, lo, hi))
    }

    /// The value between field `j`'s name and the next field's — null
    /// for a hole standing as the whole field.
    fn value_after(vn: List<Token>, ve: List<ExprId>, j: int) -> ExprId? {
        let lo = vn[j].span.lo
        let hi: int = if j + 1 < vn.length { vn[j + 1].span.lo } else { 1000000000 }
        ve.find((e) -> self.starts_between(e, lo, hi))
    }

    /// Where a member was written.
    fn written_at(p: Param) -> int { self.store.param_id_span(p.id)?.lo ?? 0 }

    fn starts_between(e: ExprId, lo: int, hi: int) -> bool {
        let sp: Span? = self.store.expr_span(e)
        sp != null && between(sp!.lo, lo, hi)
    }
}

/// An entry's name as written: a hole SPREAD by `..` keeps the `..`,
/// which is how a template tells a run of entries from a name hole.
export fn spread_name(f: Token, spreads: List<Token>, all: List<Token>) -> string {
    if spreads.any((s: Token) -> spread_before(s, f, all)) { "..${f.text}" } else { f.text }
}

/// Whether `..` stands directly before entry `f` — after every entry
/// written before it.
fn spread_before(s: Token, f: Token, all: List<Token>) -> bool {
    s.span.lo < f.span.lo && !all.any((g: Token) -> g.span.lo > s.span.lo && g.span.lo < f.span.lo)
}

/// A spread written with a third dot — the spelling other languages teach.
export fn three_dots() -> string { "a spread is written `..R` — two dots, where other languages write three" }

/// A field list's `..R` entries: each record, placed after the
/// entries written before it — `entries` holds where each began.
export fn record_spreads(entries: List<int>, rs: List<Token>, rt: List<TypeRef>) -> Result<
    List<Spread>,
    string,
> {
    if rs.length != rt.length { return .Err(zip_defect_of("spreads and their records")) }
    .Ok(
        [Spread { at: [lo for lo in entries if lo < r.span.lo].length, of: rt[j], lo: r.span.lo } for j, r in rs],
    )
}

/// Strictly inside the window `after..before`.
export fn between(at: int, after: int, before: int) -> bool {
    at > after && at < before
}

/// Whether the `state` word stands immediately before field `j` — the
/// optional token is captured per field, so it finds its field by
/// POSITION the way a default does.
fn state_before(fs: List<Token>, states: List<Token>, j: int, from: int) -> bool {
    let lo = if j == 0 { from } else { fs[j - 1].span.lo }
    states.any((s) -> between(s.span.lo, lo, fs[j].span.lo))
}

/// Seats with their marks: a `mut` or `const` token between the
/// previous name (or `from`, before the first) and a name marks that
/// seat. ONE window law, so every param list — a fn's, a method's, a
/// lambda's, a fn type's — reads the same marks the same way.
export fn marked_seats(
    store: SyntaxArena,
    ps: List<Token>,
    tys: List<TypeRef?>,
    muts: List<Token>,
    consts: List<Token>,
    from: int,
) -> List<Param> {
    [Param {
        name: Scoped(p.text),
        ty: tys[j],
        default: null,
        promises: seat_mark_of(muts, consts, seat_since(ps, j, from), p.span.lo),
        id: store.alloc_param_id(p.span),
    } for j, p in ps]
}

/// One seat's contract: the `mut` and `const` tokens written in its
/// window — the window a mark shares with the name it precedes.
fn seat_mark_of(muts: List<Token>, consts: List<Token>, after: int, before: int) -> SeatMark {
    SeatMark {
        mutable: muts.any(mark_within(it, after, before)),
        settled: consts.any(mark_within(it, after, before)),
    }
}

/// Where seat `j`'s mark may start: after the previous name, or `from`.
fn seat_since(ps: List<Token>, j: int, from: int) -> int {
    if j == 0 { from } else { ps[j - 1].span.lo }
}

fn mark_within(t: Token, after: int, before: int) -> bool {
    between(t.span.lo, after, before)
}

/// A side table a `@facet` may name: the word, and the store mark it
/// writes, keyed by the node the maker just made.
type FacetRow = { side: string, mark: fn(SyntaxArena, StmtId) -> void }

/// THE ONE REGISTRY of facet side tables. A table no row names is a
/// defect spoken at the mark, never a silent drop.
fn facet_rows() -> List<FacetRow> {
    [
        FacetRow { side: "once", mark: (st, id) -> st.mark_once(id) },
        FacetRow { side: "state", mark: (st, id) -> st.mark_state(id) },
        FacetRow { side: "host", mark: (st, id) -> st.mark_host(id) },
    ]
}

/// A `@facet` field named a side table no row fills.
fn facet_table_unknown(field: string, side: string) -> string {
    "`${field}` is `@facet(${side})`, and no side table is named `${side}`"
}

/// A `@facet` field on a node whose arena has no side table to write.
fn facet_not_a_stmt(field: string) -> string {
    "`${field}` is `@facet`, and only a statement's payload has a side table to write — an expression's or a pattern's does not"
}

/// A build asked for a payload its variant does not declare.
fn unknown_payload(ps: List<Field>, n: string) -> string {
    if ps.is_empty() { return "no payload `${n}` — this build carries none" }
    "no payload `${n}` — this build carries `${[p.name for p in ps].join("`, `")}`"
}
