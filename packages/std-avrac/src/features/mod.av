//! What a language feature IS. The compiler assembles itself from
//! these components — composition concatenates every fragment and the
//! driver parses the whole language once.
//!
//! Siblings: builder.av (the authoring surface), compose.av
//! (assembly + dispatch), coherence.av (feature/grammar agreement).
use core.{ExprId, StmtId}
use diagnostics.{DiagCode}

/// The language client's node wrapper: builders hand the engine typed
/// ids, never nodes.
export enum LangNode {
    NExpr(id: ExprId)
    NStmt(id: StmtId)
}

/// One builder registration: the name grammar text calls, and the fn
/// that answers it.
export type BuilderRow = { name: string, build: fn(Builder) -> Result<LangNode, string> }

/// A language feature: its grammar fragment in DSL text, and the
/// builder table linking the fragment's build names to fns.
export component LanguageFeature {
    config {
        name: string,
        docs: string = "",
        gram: string = "",
        builders: List<BuilderRow> = [],
        diags: List<DiagCode> = [],
    }
}

/// A feature value for consumers that cannot instantiate the
/// component (metadata-compiled tests); extend with `with`.
export fn feature(fname: string, fgram: string) -> LanguageFeature {
    component LanguageFeature f {
        name = fname
        gram = fgram
    }
    f
}
