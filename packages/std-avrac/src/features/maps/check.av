//! The map literal's typing law: every key is accepted by `string`,
//! the values share one type — the head's, or the slot's when a
//! want was planted (heterogeneity boxes, lambdas hear seats) — and
//! a value must be slot-worthy. `{}` wears EmptyMap until a map
//! adopts it.
use core.{ExprId, Type, TypeId, MapEntry, map_keys, map_values, map_spreads, flatten, some_list}
use features.{TypeCx, this_is, slot_worthy, slot_untyped}
use diagnostics.{refusal, said_as, Voice}

fn map_type(mut cx: TypeCx, e: ExprId, entries: List<MapEntry>) -> TypeId {
    if entries.is_empty() { return cx.view.types.intern(Type.EmptyMap) }
    let keys = map_keys(entries)
    let values = map_values(entries)
    let maps = map_spreads(entries)
    if !maps.is_empty() { return spread_map_type(cx, e, keys, values, maps) }
    let key? = literal_key(cx, e, keys, cx.type_at(keys[0])) else { return cx.error_type }
    if cx.want_refused(e) { return cx.error_type }
    let want: TypeId? = wanted_value(cx, e)
    if want != null { return heard_map(cx, e, key, values, want!) }
    let head = cx.led_by(values)
    if cx.errored(head) { return cx.error_type }
    if cx.awaits_seat(e, head) { return cx.error_type }
    if !slot_worthy(cx.shape_at(head)) { return cx.unslottable(head, MAP_VALUE) }
    let v = cx.joined(values, cx.type_at(head))
    for x in values {
        if !cx.accepts(x, v) { return disagreeing_value(cx, x, v) }
    }
    cx.type(Map<key, v>)
}

/// The key type a literal's keys answer to — the want's, else `led`, its first key's or its first
/// spread's — when a map files it and every key stands in it; each refusal speaks once.
fn literal_key(mut cx: TypeCx, e: ExprId, keys: List<ExprId>, led: TypeId) -> TypeId? {
    let key = wanted_key(cx, e) ?? led
    if cx.errored_ty(key) { return null }
    if !cx.view.types.files_keys(key) {
        key_unfiled(cx, keys.first() ?? e, key)
        return null
    }
    for k in keys {
        if !cx.accepts(k, key) {
            key_unfiled(cx, k, cx.type_at(k))
            return null
        }
    }
    key
}

/// A literal with `..` entries: each spread is a map, and the pairs'
/// values and the maps' own values answer to one value type.
fn spread_map_type(
    mut cx: TypeCx,
    e: ExprId,
    keys: List<ExprId>,
    singles: List<ExprId>,
    maps: List<ExprId>,
) -> TypeId {
    for m in maps {
        if !spreads_map(cx, m) { return cx.error_type }
    }
    let led = if keys.is_empty() { spread_key(cx, maps) } else { cx.type_at(keys[0]) }
    let key? = literal_key(cx, e, keys, led) else { return cx.error_type }
    let v? = spread_value(cx, e, singles, maps) else { return cx.view.types.intern(Type.EmptyMap) }
    let held = cx.type(Map<key, v>)
    for m in maps {
        if !cx.accepts(m, held) { return disagreeing_value(cx, m, v) }
    }
    for x in singles {
        if !cx.accepts(x, v) { return disagreeing_value(cx, x, v) }
    }
    held
}

/// The value type: the want's, else the first pair's, else the first
/// map's own. Absent only when every spread is an empty map.
fn spread_value(cx: TypeCx, e: ExprId, singles: List<ExprId>, maps: List<ExprId>) -> TypeId? {
    let held: TypeId? = wanted_value(cx, e)
    if held != null { return held }
    let single: ExprId? = singles.first()
    if single != null { return cx.type_at(single!) }
    flatten([some_list(cx.view.types.map_value(cx.type_at(m))) for m in maps]).first()
}

/// A spread's operand is a map; any other speaks once.
fn spreads_map(mut cx: TypeCx, m: ExprId) -> bool {
    let ty = cx.type_at(m)
    if cx.errored_ty(ty) { return false }
    if cx.view.types.map_value(ty) != null || cx.view.types.seen_shape(ty) is .EmptyMap { return true }
    not_a_map(cx, m)
    false
}

/// The key type a literal of spreads alone takes: its first non-empty map's, else text.
fn spread_key(cx: TypeCx, maps: List<ExprId>) -> TypeId {
    maps.find_map((m) -> cx.view.types.map_key(cx.type_at(m))) ?? cx.type(string)
}

/// The key type the planted want declares, when the slot is a map.
fn wanted_key(cx: TypeCx, e: ExprId) -> TypeId? {
    let w? = cx.want_at(e) else { return null }
    match cx.view.types.shape_of(w) { .Map(k, _) -> k, _ -> null }
}

/// The value type the planted want declares, when the slot is a map.
fn wanted_value(cx: TypeCx, e: ExprId) -> TypeId? {
    let w? = cx.want_at(e) else { return null }
    match cx.view.types.shape_of(w) { .Map(_, v) -> v, _ -> null }
}

/// Every value through `accepts` against the declared value type.
fn heard_map(mut cx: TypeCx, e: ExprId, key: TypeId, values: List<ExprId>, want: TypeId) -> TypeId {
    if !slot_worthy(cx.view.types.shape_of(want)) { return cx.unslottable_want(e, want, MAP_VALUE) }
    for x in values {
        if !cx.accepts(x, want) { return unwanted_value(cx, x, want) }
    }
    cx.type(Map<key, want>)
}

// ── The voices ──

fn not_a_map(mut cx: TypeCx, m: ExprId) {
    let n = cx.name_at(m)
    if cx.shape_at(m) is .Opt {
        return cx.emit(said_as("type.spread_nullable", cx.loc_of(m), map_spreads_absent(n)))
    }
    cx.emit(said_as("type.spread_map", cx.loc_of(m), map_spread_unmapped(n)))
}

/// A spread in a map literal of a value of `found`, which may be null.
export fn map_spreads_absent(found: string) -> Voice {
    Voice {
        message: "`..` spreads `${found}`, which may be null",
        label: "spread here",
        help: "unwrap it first — `..(m ?? {})`",
    }
}

/// A spread in a map literal of a value of `found`, which is no map.
export fn map_spread_unmapped(found: string) -> Voice {
    Voice {
        message: "`..` in a map spreads a map, found `${found}`",
        label: "spread here",
        help: "a map literal spreads maps — `{ ..m, \"k\": v }`; write any other value under a key",
    }
}

/// What a map literal's key of `found` says: a map's keys are one type, and a type of key.
export fn map_keyed(found: string) -> string {
    "a map's keys are one type of key — text, octets, a word, or a record, an enum or a list each part of which is one, never a fraction or an address — this is `${found}`"
}

/// A map literal's key of `found` where the map's keys are `want`.
export fn key_apart(found: string, want: string) -> Voice {
    Voice {
        message: "this map's keys are `${want}`, this is `${found}`",
        label: "this is `${found}`",
        help: "write a `${want}` key here, or change the map's key type",
    }
}

/// How a key no map files is mended.
export const KEY_REMEDY: string = "key by text, a word or a record of them — `Map<string, …>`, `Map<int, …>`"

/// What a map literal's value of `found` says where the map holds `want`.
export fn map_holds(want: string, found: string) -> string { "this map holds `${want}`, this is `${found}`" }

fn key_unfiled(mut cx: TypeCx, k: ExprId, found: TypeId) {
    let n = cx.view.types.name_of(found)
    let _ = cx.spoken(refusal("type.map_key", cx.loc_of(k), map_keyed(n), this_is(n), KEY_REMEDY))
}

fn disagreeing_value(mut cx: TypeCx, x: ExprId, v: TypeId) -> TypeId {
    let n = cx.name_at(x)
    cx
        .spoken(
            cx
                .seat_mismatch("type.map_value", cx.loc_of(x), x, map_holds(cx.view.types.name_of(v), n), v),
        )
}

fn unwanted_value(mut cx: TypeCx, x: ExprId, want: TypeId) -> TypeId {
    let n = cx.name_at(x)
    cx
        .spoken(
            cx
                .seat_mismatch("type.map_value", cx.loc_of(x), x, map_holds(cx.view.types.name_of(want), n), want),
        )
}

/// What a map literal's value is called where its slot is judged.
const MAP_VALUE: string = "a map value"

/// A map literal's first value, of `named`, which gives the map no type.
export fn map_value_untyped(named: string) -> Voice { slot_untyped(MAP_VALUE, named) }
