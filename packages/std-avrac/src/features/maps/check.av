//! The map literal's typing law: every key is accepted by `string`,
//! the values share one type — the head's, or the slot's when a
//! want was planted (heterogeneity boxes, lambdas hear seats) — and
//! a value must be slot-worthy. `{}` wears EmptyMap until a map
//! adopts it.
use core.{ExprId, Type, TypeId, MapEntry, map_keys, map_values, map_spreads, flatten, some_list}
use features.{TypeCx, this_is, slot_worthy}
use diagnostics.{refusal}

fn map_type(mut cx: TypeCx, e: ExprId, entries: List<MapEntry>) -> TypeId {
    if entries.is_empty() { return cx.view.types.intern(Type.EmptyMap) }
    let keys = map_keys(entries)
    let values = map_values(entries)
    let maps = map_spreads(entries)
    if !maps.is_empty() { return spread_map_type(cx, e, keys, values, maps) }
    let str = cx.type(string)
    for k in keys {
        if !cx.accepts(k, str) { return key_not_string(cx, k) }
    }
    if cx.want_refused(e) { return cx.error_type }
    let want: TypeId? = wanted_value(cx, e)
    if want != null { return heard_map(cx, e, values, want!) }
    let head = cx.led_by(values)
    if cx.errored(head) { return cx.error_type }
    if cx.awaits_seat(e, head) { return cx.error_type }
    if !slot_worthy(cx.shape_at(head)) { return cx.unslottable(head, "a map value") }
    let v = cx.joined(values, cx.type_at(head))
    for x in values {
        if !cx.accepts(x, v) { return disagreeing_value(cx, x, v) }
    }
    cx.type(Map<str, v>)
}

/// A literal with `..` entries: each spread is a map, and the pairs'
/// values and the maps' own values answer to one value type.
fn spread_map_type(
    mut cx: TypeCx,
    e: ExprId,
    keys: List<ExprId>,
    singles: List<ExprId>,
    maps: List<ExprId>,
) -> TypeId {
    let str = cx.type(string)
    for k in keys {
        if !cx.accepts(k, str) { return key_not_string(cx, k) }
    }
    for m in maps {
        if !spreads_map(cx, m) { return cx.error_type }
    }
    let v? = spread_value(cx, e, singles, maps) else { return cx.view.types.intern(Type.EmptyMap) }
    let held = cx.type(Map<str, v>)
    for m in maps {
        if !cx.accepts(m, held) { return disagreeing_value(cx, m, v) }
    }
    for x in singles {
        if !cx.accepts(x, v) { return disagreeing_value(cx, x, v) }
    }
    held
}

/// The value type: the want's, else the first pair's, else the first
/// map's own. Absent only when every spread is an empty map.
fn spread_value(cx: TypeCx, e: ExprId, singles: List<ExprId>, maps: List<ExprId>) -> TypeId? {
    let held: TypeId? = wanted_value(cx, e)
    if held != null { return held }
    let single: ExprId? = singles.first()
    if single != null { return cx.type_at(single!) }
    flatten([some_list(cx.view.types.map_value(cx.type_at(m))) for m in maps]).first()
}

/// A spread's operand is a map; any other speaks once.
fn spreads_map(mut cx: TypeCx, m: ExprId) -> bool {
    let ty = cx.type_at(m)
    if cx.errored_ty(ty) { return false }
    if cx.view.types.map_value(ty) != null || cx.view.types.seen_shape(ty) is .EmptyMap { return true }
    not_a_map(cx, m)
    false
}

/// The value type the planted want declares, when the slot is a map.
fn wanted_value(cx: TypeCx, e: ExprId) -> TypeId? {
    let w? = cx.want_at(e) else { return null }
    match cx.view.types.shape_of(w) { .Map(_, v) -> v, _ -> null }
}

/// Every value through `accepts` against the declared value type.
fn heard_map(mut cx: TypeCx, e: ExprId, values: List<ExprId>, want: TypeId) -> TypeId {
    if !slot_worthy(cx.view.types.shape_of(want)) { return cx.unslottable_want(e, want, "a map value") }
    for x in values {
        if !cx.accepts(x, want) { return unwanted_value(cx, x, want) }
    }
    cx.type(Map<string, want>)
}

// ── The voices ──

fn not_a_map(mut cx: TypeCx, m: ExprId) {
    let n = cx.name_at(m)
    if cx.shape_at(m) is .Opt {
        return cx
            .emit(
                refusal(
                    "type.spread_nullable",
                    cx.loc_of(m),
                    "`..` spreads `${n}`, which may be null",
                    "spread here",
                    "unwrap it first — `..(m ?? {})`",
                ),
            )
    }
    cx
        .emit(
            refusal(
                "type.spread_map",
                cx.loc_of(m),
                "`..` in a map spreads a map, found `${n}`",
                "spread here",
                "a map literal spreads maps — `{ ..m, \"k\": v }`; write any other value under a key",
            ),
        )
}

fn key_not_string(mut cx: TypeCx, k: ExprId) -> TypeId {
    let n = cx.name_at(k)
    cx
        .spoken(
            refusal(
                "type.map_key",
                cx.loc_of(k),
                "a map's keys are strings, this is `${n}`",
                this_is(n),
                "key by text",
            ),
        )
}

fn disagreeing_value(mut cx: TypeCx, x: ExprId, v: TypeId) -> TypeId {
    let n = cx.name_at(x)
    cx
        .spoken(
            cx
                .seat_mismatch(
                    "type.map_value",
                    cx.loc_of(x),
                    x,
                    "this map holds `${cx.view.types.name_of(v)}`, this is `${n}`",
                    v,
                ),
        )
}

fn unwanted_value(mut cx: TypeCx, x: ExprId, want: TypeId) -> TypeId {
    let n = cx.name_at(x)
    cx
        .spoken(
            cx
                .seat_mismatch(
                    "type.map_value",
                    cx.loc_of(x),
                    x,
                    "this map holds `${cx.view.types.name_of(want)}`, this is `${n}`",
                    want,
                ),
        )
}

