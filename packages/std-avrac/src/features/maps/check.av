//! The map literal's typing law: every key is accepted by `string`,
//! the values share one type — the head's, or the slot's when a
//! want was planted (heterogeneity boxes, lambdas hear seats) — and
//! a value must be slot-worthy. `{}` wears EmptyMap until a map
//! adopts it.
use core.{ExprId, Type, TypeId}
use features.{TypeCx, this_is, slot_worthy}
use diagnostics.{refusal}

fn map_type(mut cx: TypeCx, e: ExprId, keys: List<ExprId>, values: List<ExprId>) -> TypeId {
    if keys.is_empty() { return cx.view.types.intern(Type.EmptyMap) }
    let str = cx.type(string)
    for k in keys {
        if !cx.accepts(k, str) { return key_not_string(cx, k) }
    }
    if cx.want_refused(e) { return cx.error_type }
    let want: TypeId? = wanted_value(cx, e)
    if want != null { return heard_map(cx, e, values, want!) }
    let head = cx.led_by(values)
    if cx.errored(head) { return cx.error_type }
    if cx.awaits_seat(e, head) { return cx.error_type }
    if !slot_worthy(cx.shape_at(head)) { return cx.unslottable(head, "a map value") }
    let v = cx.joined(values, cx.type_at(head))
    for x in values {
        if !cx.accepts(x, v) { return disagreeing_value(cx, x, v) }
    }
    cx.type(Map<str, v>)
}

/// The value type the planted want declares, when the slot is a map.
fn wanted_value(cx: TypeCx, e: ExprId) -> TypeId? {
    let w? = cx.want_at(e) else { return null }
    match cx.view.types.shape_of(w) { .Map(_, v) -> v, _ -> null }
}

/// Every value through `accepts` against the declared value type.
fn heard_map(mut cx: TypeCx, e: ExprId, values: List<ExprId>, want: TypeId) -> TypeId {
    if !slot_worthy(cx.view.types.shape_of(want)) { return cx.unslottable_want(e, want, "a map value") }
    for x in values {
        if !cx.accepts(x, want) { return unwanted_value(cx, x, want) }
    }
    cx.type(Map<string, want>)
}

// ── The voices ──

fn key_not_string(mut cx: TypeCx, k: ExprId) -> TypeId {
    let n = cx.name_at(k)
    cx
        .spoken(
            refusal(
                "type.map_key",
                cx.loc_of(k),
                "a map's keys are strings, this is `${n}`",
                this_is(n),
                "other key types are recorded — spell the key as text",
            ),
        )
}

fn disagreeing_value(mut cx: TypeCx, x: ExprId, v: TypeId) -> TypeId {
    let n = cx.name_at(x)
    cx
        .spoken(
            refusal(
                "type.map_value",
                cx.loc_of(x),
                "this map holds `${cx.view.types.name_of(v)}`, this is `${n}`",
                this_is(n),
                null,
            ),
        )
}

fn unwanted_value(mut cx: TypeCx, x: ExprId, want: TypeId) -> TypeId {
    let n = cx.name_at(x)
    cx
        .spoken(
            refusal(
                "type.map_value",
                cx.loc_of(x),
                "this map holds `${cx.view.types.name_of(want)}`, this is `${n}`",
                this_is(n),
                null,
            ),
        )
}

