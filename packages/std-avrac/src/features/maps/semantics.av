//! The map literal's NodeSemantics — dispatch one-liners; the rule
//! bodies live beside this file, by concern.
use core.{Expr, ExprId, TypeId, Reg, MapPairs, pairs_of}
use features.{NodeSemantics, TypeCx, LowerCx}

export type MapsSemantics = { }

impl NodeSemantics for MapsSemantics {
    fn kids(e: Expr) -> List<ExprId> {
        let pairs: MapPairs? = pairs_of(e)
        if pairs == null { return [] }
        pairs!.keys.concat(pairs!.values)
    }

    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        let pairs: MapPairs? = pairs_of(cx.view.store.expr(e))
        if pairs == null { return cx.error_type }
        map_type(cx, e, pairs!.keys, pairs!.values)
    }

    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        let pairs: MapPairs? = pairs_of(cx.view.store.expr(e))
        if pairs == null { return cx.lower_defect(e, "a map literal without its pairs") }
        map_reg(cx, e, pairs!.keys, pairs!.values)
    }
}
