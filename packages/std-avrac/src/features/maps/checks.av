//! The typing rule of a map literal: each key is text, and the literal is the map its seat names, or
//! with none the map of its values' join, a spread's values among them. `{}` is its own type
//! wherever it stands but one: in a seat that wants nothing (`void`) it is a block, empty, as an
//! arm's or a lambda's `{}` reads — the seat's want decides, and no map is made to be dropped.
use core.{
    Checking,
    Checks,
    ExprId,
    Expected,
    MapEntry,
    Seating,
    SignedType,
    types_joined,
    owned_type,
    OwnType,
}
use core.expr.{MapLit}

impl Checks for MapLit {
    fn checked(mut cx: Checking, e: ExprId, expected: Expected) -> SignedType? {
        let wanted = match expected { .Exactly(ty) -> ty with { nulls: 0 }, rest -> null }
        if self.entries.is_empty() && wanted != null && wanted!.owns(OwnType.Void) { return wanted }
        let held = types_joined([value_of(cx, entry, wanted?.mapped()) for entry in self.entries])
        if wanted?.mapped() != null && !self.entries.is_empty() { return wanted }
        if held != null { return owned_type("Map") with { args: [owned_type("string"), held!] } }
        let values = [entry_value(entry) for entry in self.entries]
        cx.literal_apart("map", values, [entry is .Spread for entry in self.entries])
        null
    }
}

/// The type one entry brings to the map's values: a pair's value, checked against the value type
/// the seat wants if it wants one, and a spread map's values.
fn value_of(mut cx: Checking, entry: MapEntry, wanted: SignedType?) -> SignedType? {
    match entry {
        .Pair(key, value) -> {
            let _ = cx.check_seated(key, owned_type("string"), Seating.MapKey)
            if wanted == null { cx.check(value, Expected.Free) } else { cx.check_seated(value, wanted, Seating.MapValue) }
        },
        .Spread(from) -> cx.check(from, Expected.Free)?.mapped(),
    }
}

/// The value one entry writes: a pair's value, or the map a spread spreads.
fn entry_value(entry: MapEntry) -> ExprId {
    match entry { .Pair(_, value) -> value, .Spread(from) -> from }
}
