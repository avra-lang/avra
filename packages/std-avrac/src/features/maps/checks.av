//! The typing rule of a map literal: its keys are one type a map files — the seat's, else the first
//! key's — and the literal is the map its seat names, or with none the map of its values' join, a
//! spread's values among them. `{}` is its own type wherever it stands.
use core.{
    Checking,
    Checks,
    ExprId,
    Expected,
    MapEntry,
    Seating,
    SignedType,
    types_joined,
    owned_type,
}
use core.expr.{MapLit}

impl Checks for MapLit {
    fn checked(mut cx: Checking, e: ExprId, expected: Expected) -> SignedType? {
        let wanted = match expected { .Exactly(ty) -> ty with { nulls: 0 }, rest -> null }
        let key = key_of(cx, self.entries, wanted?.map_key())
        // the first key names the key type where no seat does, and is checked once, there
        let named_by = if wanted?.map_key() == null { self.entries.find_index(it is .Pair) ?? -1 } else { -1 }
        let held = types_joined(
            [value_of(cx, entry, if i == named_by { null } else { key }, wanted?.mapped()) for i, entry in self.entries],
        )
        if wanted?.mapped() != null && !self.entries.is_empty() { return wanted }
        if held != null { return owned_type("Map") with { args: [key, held!] } }
        let values = [entry_value(entry) for entry in self.entries]
        cx.literal_apart("map", values, [entry is .Spread for entry in self.entries])
        null
    }
}

/// The key type the literal's keys answer to: the seat's, else the first pair's own — checked here,
/// once — where a map files it. A first key no map files is refused here, and text stands in.
fn key_of(mut cx: Checking, entries: List<MapEntry>, wanted: SignedType?) -> SignedType {
    if wanted != null { return wanted! }
    let first? = entries.find(it is .Pair) else { return owned_type("string") }
    let at = entry_key(first)
    let found? = cx.check(at, Expected.Free) else { return owned_type("string") }
    if cx.program.shapes().map_keyed(found) { return found }
    cx.seat_refused(at, owned_type("string"), found, Seating.KeyUnfiled)
    owned_type("string")
}

/// The type one entry brings to the map's values: a pair's value, checked against the value type
/// the seat wants if it wants one, and a spread map's values. A pair's key is seated at `key`, and
/// one `key_of` already checked is not checked again.
fn value_of(mut cx: Checking, entry: MapEntry, key: SignedType?, wanted: SignedType?) -> SignedType? {
    match entry {
        .Pair(k, value) -> {
            if key != null { let _ = cx.check_seated(k, key!, Seating.MapKey) }
            if wanted == null { cx.check(value, Expected.Free) } else { cx.check_seated(value, wanted, Seating.MapValue) }
        },
        .Spread(from) -> cx.check(from, Expected.Free)?.mapped(),
    }
}

/// A pair's key: a spread names none.
fn entry_key(entry: MapEntry) -> ExprId {
    match entry { .Pair(key, _) -> key, .Spread(from) -> from }
}

/// The value one entry writes: a pair's value, or the map a spread spreads.
fn entry_value(entry: MapEntry) -> ExprId {
    match entry { .Pair(_, value) -> value, .Spread(from) -> from }
}
