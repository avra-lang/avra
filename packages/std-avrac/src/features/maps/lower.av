//! A map lowers as the runtime aggregate: one `avra_map_new`, then
//! a set per pair — the memory pass marks managed values owned; the
//! runtime keeps its own reference to every key.
use core.{ExprId, Reg}
use features.{LowerCx}

fn map_reg(mut cx: LowerCx, e: ExprId, keys: List<ExprId>, values: List<ExprId>) -> Reg {
    let ks = [cx.reg_of(k) for k in keys]
    let vs = [cx.reg_of(v) for v in values]
    let dst = cx.map_new(cx.shape_at(e))
    for j, k in ks {
        cx.map_write(dst, k, vs[j])
    }
    dst
}
