// proves: `m.entries()` answers each key beside its value in the map's
// order, over text, nullable and record values; a comprehension over a
// map binds each key and its value in that order.
type Pt = { name: string, x: int, y: int }

let words: Map<string, string> = {"a": "one", "b": "two"}
let marks: Map<string, int?> = {"p": 1, "q": null}
let pts: Map<string, Pt> = {"o": Pt { name: "o", x: 0, y: 1 }, "u": Pt { name: "u", x: 5, y: 6 }}
let ws = words.entries()
let ms = marks.entries()
let ps = pts.entries()
let pairs = ["${k}=${v}" for k, v in words if k != "z"].join(",")
"${ws.length} ${ws[0].key}=${ws[0].value} ${ws[1].key}=${ws[1].value} ${ms[0].value ?? -1} ${ms[1].value ?? -1} ${ps[1].key} ${ps[1].value.x + ps[1].value.y} ${ps[0].value.y} ${pairs}"
