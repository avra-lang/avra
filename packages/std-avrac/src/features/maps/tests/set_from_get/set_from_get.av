// proves: a `set` whose value reads a `get` of the same map counts up
// from what the map held, and a nullable scalar written into the map a
// cell holds reads back present and absent.
fn tally(words: List<string>) -> Map<string, int> {
    mut counts: Map<string, int> = {}
    for w in words { counts.set(w, (counts.get(w) ?? 0) + 1) }
    counts
}

fn marks() -> Cell<Map<string, int?>> {
    let held: Cell<Map<string, int?>> = Cell.new({})
    held.put("some", 5)
    held.put("none", null)
    held
}

let counts = tally(["a", "b", "a", "c", "a"])
let marked = marks().get().values()
"${counts.get("a") ?? 0} ${counts.get("b") ?? 0} ${counts.length} ${marked.length} ${marked[0] ?? -1} ${marked[1] ?? -1}"
