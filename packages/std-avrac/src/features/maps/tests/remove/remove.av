// proves: `remove` drops one key and answers its value as `V?`, the
// rest keep their insertion order, and `is_empty` is the length
// against zero.
mut m: Map<string, int> = {}
m.set("b", 2)
m.set("a", 1)
m.set("c", 3)
let gone = m.remove("b")
let ks = m.keys()
let zz = m.remove("z")
"${m.length} ${gone ?? 0} ${zz != null} ${m.has("b")} ${ks[0]} ${ks[1]} ${m.is_empty()}"
