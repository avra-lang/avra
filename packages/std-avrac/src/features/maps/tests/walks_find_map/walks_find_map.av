// proves: `find_map` runs over every walk — a map, a range, a list —
// answering the first present projection.
enum Attr { Title(t: string), Open(on: bool) }
let m = {"a": 1, "b": 2}
let attrs = {"x": Attr.Open(true), "y": Attr.Title("T")}
let hit = m.find_map((e: Entry<string, int>) -> if e.value > 1 { e.key } else { null })
let none = m.find_map((e: Entry<string, int>) -> if e.value > 5 { e.key } else { null })
let ranged = (0..5).find_map((i: int) -> if i > 2 { "r${i}" } else { null })
let listed = [1, 2, 3].find_map((i: int) -> if i > 1 { "l${i}" } else { null })
let title = attrs
    .find_map((e: Entry<string, Attr>) -> match e.value { .Title(t) -> t, .Open(_) -> null })
"${hit ?? "-"} ${none ?? "-"} ${ranged ?? "-"} ${listed ?? "-"} ${title ?? "-"}"
