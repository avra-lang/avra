// proves: a file's own `Entry` takes the name and keeps its methods,
// and `entries` still answers the prelude's record.
type Entry = { view: string }

impl Entry {
    fn label() -> string { "mine:${self.view}" }
}

let mine = Entry { view: "v" }
let m = {"a": 1}
let es = m.entries()
"${mine.label()} ${es[0].key} ${es[0].value}"
