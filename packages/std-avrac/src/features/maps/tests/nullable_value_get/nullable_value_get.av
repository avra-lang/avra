// proves: `Map<K, T?>.get()` answers `T??` — present-and-a-value,
// present-and-null, and absent are three different answers, each read
// through the same reassigned cell. A struct-typed cell's fresh alloca
// must read as absent on its own first release, the same law a
// pointer-typed cell's alloca already keeps (backend/llvm_wrapper.c's
// `avra_llvm_build_alloca`) — never whatever the stack held before it.
let m: Map<string, string?> = {"has_value": "hi", "has_null": null}
"${m.get("has_value") ?? null ?? "-"} ${m.get("has_null") ?? null ?? "-"} ${m.get("missing") ?? null ?? "-"} ${m.get("has_null") != null} ${m.get("missing") != null}"
