// proves: a map's entries read back in insertion order, each key
// beside its value — an overwrite keeps its place, a removal drops
// one, an empty map answers none, and the list is a snapshot.
mut m: Map<string, int> = {}
let none = m.entries().length
m.set("b", 2)
m.set("a", 1)
m.set("c", 3)
m.set("b", 20)
let _ = m.remove("a")
let es = m.entries()
m.set("z", 26)
"${none} ${es.length} ${es[0].key}=${es[0].value} ${es[1].key}=${es[1].value} ${m.entries().length}"
