// proves: views of one map stay apart under both engines — a copy
// written after its source moved on, a source written after its copy,
// a copy of a copy, a capture, and a removal each view makes alone.
mut m: Map<string, int> = {}
m.set("a", 1)
m.set("b", 2)
let before = m
m.remove("a")
let mid = m
m.set("a", 3)
m.remove("zz")
mut late = mid
late.set("b", 9)
late.remove("b")
late.remove("b")
mut a: Map<string, int> = {}
a.set("k", 1)
mut b = a
b.set("k", 2)
b.set("j", 5)
a.set("z", 9)
mut c = b
c.set("k", 3)
let held = () -> a.get("k") ?? -1
a.set("k", 7)
let removed = "${m.length} ${before.length} ${mid.length} ${late.length} ${m.get("a") ?? -1} ${before.get("a") ?? -1} ${mid.has("a")} ${late.has("b")} ${mid.get("b") ?? -1}"
"${removed} | ${a.get("k") ?? -1} ${b.get("k") ?? -1} ${c.get("k") ?? -1} ${a.length} ${b.length} ${c.length} ${a.get("j") ?? -1} ${b.get("z") ?? -1} ${held()}"
