// proves: `get`'s one probe hands every kind of value out of its slot —
// a text that outlives the write replacing it and the map holding it,
// a nullable scalar's present null, a record's field map.
type Reg = { ids: Map<string, int> }

fn kept() -> string {
    mut m: Map<string, string> = {"k": "first ${1}"}
    let v = m.get("k") ?? "-"
    m.set("k", "second ${2}")
    v
}

mut counts: Map<string, int?> = {}
counts.set("none", null)
counts.set("one", 1)
mut r = Reg { ids: {} }
r.ids.set("k", 42)
let a = counts.get("none")
let b = counts.get("one")
let c = counts.get("absent")
"${kept()} ${a != null} ${a ?? null ?? 0 - 1} ${b ?? null ?? 0 - 1} ${c != null} ${r.ids.get("k") ?? 0}"
