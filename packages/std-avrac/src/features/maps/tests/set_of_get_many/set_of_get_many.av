// proves: twenty thousand read-then-writes over five thousand keys —
// every miss, every hit and every growth of the index — count right.
mut m: Map<string, int> = {}
for i in 0..20000 {
    let k = "k${i % 5000}"
    m.set(k, (m.get(k) ?? 0) + 1)
}
"${m.length} ${m.get("k7") ?? 0} ${m.keys()[4999]}"
