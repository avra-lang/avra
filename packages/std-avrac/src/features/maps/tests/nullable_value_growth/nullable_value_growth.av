// proves: a nullable scalar written under a key keeps its absence mark when the
// write grows the value list — the mark lands on the written slot, never a stale buffer.
mut m: Map<string, int?> = {}
for i in 0..40 { m.set("k${i}", if i % 4 == 0 { null } else { i }) }
mut absent = 0
mut summed = 0
for i in 0..40 {
    let v = m.get("k${i}") ?? null
    if v == null { absent = absent + 1 } else { summed = summed + (v ?? 0) }
}
"${m.length} ${absent} ${summed}"
