// proves: a map keyed by words that starts empty inside a record, a list or a record of type
// parameters is a map of its own, never the binary's laid-out data, so a write through a path keys
// by the word: a field's map, an element's map and a generic record's map each read back what was
// written, and a map keyed by text beside them still reads its own.
type Holder = { k: int, m: Map<int, int> }

type Keyed<K> = { k: K, m: Map<K, string> }

enum Color {
    Red
    Green
}

mut h = Holder { k: 3, m: {} }
h.m.set(h.k, 30)
h.m.set(-1, 10)
mut rows: List<Map<int, int>> = [{}, {}]
rows[1].set(7, 70)
rows[0].set(0, 1)
mut g = Keyed { k: Color.Green, m: {} }
g.m.set(g.k, "green")
mut t = Keyed { k: "a", m: {} }
t.m.set(t.k, "text")
"${h.m.length} ${h.m.get(3) ?? -1} ${rows[1].get(7) ?? -1} ${rows[0].get(0) ?? -1} ${g.m.get(Color.Green) ?? "?"} ${g.m.has(Color.Red)} ${t.m.get("a") ?? "?"}"
