// proves: a map is a walk source — every walk verb runs over its
// entries in insertion order; a shape-keeping verb answers a Map, an
// element-changing one a List, a terminal its own answer.
let m = {"b": 2, "a": 1, "c": 3}
let big = m.filter(it.value > 1)
let none = m.filter(it.value > 9)
let names = m.map("${it.key}=${it.value}")
let first = m.find(it.value == 1)
let last = m.find_last(it.value < 3)
let at = m.find_index(it.key == "c") ?? -1
let firsts = m.take(2)
let rest = m.drop(1)
let early = m.take_while(it.value > 1)
let late = m.drop_while(it.value > 1)
let chained = m.filter(it.value != 1).filter(it.key != "c")
let mapped = m.filter(it.value > 1).map(it.key)
let total = m.fold(0, (acc, e) -> acc + e.value)
let pres = m.filter_map((e: Entry<string, int>) -> if e.value > 1 { e.key } else { null })
"${big.keys().join(",")} ${big.get("c") ?? 0} ${none.length} ${names.join(" ")} ${first?.key ?? "-"} ${last?.key ?? "-"} ${at} ${firsts.keys().join("")} ${rest.keys().join("")} ${early.keys().join("")} ${late.keys().join("")} ${chained.keys().join("")} ${mapped.join("")} ${total} ${m.any(it.value > 2)} ${m.all(it.value > 2)} ${m.count()} ${pres.join("")} ${m.length}"
