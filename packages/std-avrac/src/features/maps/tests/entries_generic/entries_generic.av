// proves: `entries` under a type parameter, a named map, a nullable
// map, a closure and a const; an `Entry` of other key types, and of
// entries; and an indexed walk over them.
type Scores = Map<string, int>

const fixed = {"a": 1}.entries()

fn total<V>(m: Map<string, V>, f: fn(V) -> int) -> int { m.entries().map(f(it.value)).sum() }

fn pairs<V>(m: Map<string, V>) -> List<Entry<string, V>> { m.entries() }

fn firsts<V>(m: Map<string, V>) -> List<string> { [k for k, _v in m] }

let s: Scores = {"a": 1, "b": 2}
let absent: Map<string, int>? = null
let grab = () -> s.entries().length
let e: Entry<int, int> = Entry { key: 1, value: 2 }
let ee = {"in": Entry { key: "k", value: true }}.entries()
mut placed = 0
for i, x in s.entries() { placed = placed + i * x.value }
"${s.entries().length} ${total({"a": 1, "b": 2}, (v: int) -> v * 2)} ${pairs({"x": "y"})[0].value} ${firsts({"p": 1.5, "q": 2.5}).join("")} ${grab()} ${e.key + e.value} ${ee[0].value.key} ${absent?.entries()?.length ?? -1} ${fixed[0].key} ${placed}"
