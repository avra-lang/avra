// proves: a comprehension's head pairs over a map as `for` does — in
// insertion order, under a filter, nested inside another head, and
// over a snapshot the element cannot disturb.
let m = {"b": 2, "a": 1, "c": 3}
let shown = ["${k}=${v}" for k, v in m]
let big = [k for k, v in m if v > 1]
let crossed = ["${i}${k}" for i in 0..2 for k, v in m if v == i + 1]
let lists = {"x": [1, 2], "y": [3]}
let flat = [n * 10 for _k, ns in lists for n in ns]
"${shown.join(",")} ${big.join("")} ${crossed.join(",")} ${flat.length} ${flat[2]}"
