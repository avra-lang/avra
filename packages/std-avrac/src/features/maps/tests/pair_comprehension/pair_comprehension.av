// proves: a comprehension's head pairs over a map as `for` does — in
// insertion order, under a filter, before and after another head,
// inside a closure, and over an empty map.
let m = {"b": 2, "a": 1, "c": 3}
let shown = ["${k}=${v}" for k, v in m]
let big = [k for k, v in m if v > 1]
let crossed = ["${i}${k}" for i in 0..2 for k, v in m if v == i + 1]
let lists = {"x": [1, 2], "y": [3]}
let flat = [n * 10 for _k, ns in lists for n in ns]
let placed = ["${i}${k}" for i, n in [7, 8] for k, v in m if v == i + 2]
let later = () -> [v for _k, v in m].sum()
let empty: Map<string, int> = {}
"${shown.join(",")} ${big.join("")} ${crossed.join(",")} ${flat.length} ${flat[2]} ${placed.join(",")} ${later()} ${[k for k, _v in empty].length}"
