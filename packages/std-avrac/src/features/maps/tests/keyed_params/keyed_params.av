// proves: a type parameter keys a map where its declaration's signature says so — a seat, the
// answer, a record's field, an impl's target — and each filling by a key runs: an int, an enum whose
// variants carry nothing, text, and a type parameter of a caller whose own signature keys by it.
type Bag<K> = { m: Map<K, int> }

impl Bag<K> {
    mut fn put(k: K) { self.m.set(k, (self.m.get(k) ?? 0) + 1) }
    fn count(k: K) -> int { self.m.get(k) ?? 0 }
}

enum Color {
    Red
    Green
}

fn tally<K>(ks: List<K>) -> Map<K, int> {
    mut m: Map<K, int> = {}
    for k in ks { m.set(k, (m.get(k) ?? 0) + 1) }
    m
}

fn through<T>(xs: List<T>) -> Map<T, int> { tally(xs) }

fn counted<K>(m: Map<K, int>, k: K) -> int { m.get(k) ?? 0 }

let ints = tally([3, 1, 3, 3])
let colors = through([Color.Green, Color.Red, Color.Green])
mut bag = Bag { m: {} }
bag.put("a")
bag.put("a")
bag.put("b")
"${counted(ints, 3)} ${counted(ints, 2)} ${colors.get(Color.Green) ?? 0} ${bag.count("a")} ${bag.count("z")}"
