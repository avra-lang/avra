// proves: an entry lays out whatever a map holds — a scalar nullable,
// a payload enum, a one-field record, a fn, a cell, a float, a bool —
// and `entries` reads a field, a call's answer and a literal alike.
enum Color { Red, Green(n: int) }
type Id = { n: int }
type Holder = { m: Map<string, float> }
impl Holder { fn all() -> string { self.m.entries().map("${it.key}:${it.value}").join(",") } }
fn make() -> Map<string, bool> { {"t": true, "f": false} }
mut opt: Map<string, int?> = {}
opt.set("none", null)
opt.set("some", 7)
let colors = {"r": Color.Red, "g": Color.Green(5)}
let ids = {"one": Id { n: 1 }}
let fns: Map<string, fn(int) -> int> = {"inc": (x: int) -> x + 1}
let cells = {"c": Cell.new(3)}
let h = Holder { m: {"pi": 3.5} }
let oe = opt.entries()
let ce = colors.entries()
let g = match ce[1].value { .Green(n) -> n, .Red -> -1 }
let r = match ce[0].value { .Green(n) -> n, .Red -> -1 }
let lit = {"q": 9}.entries()[0].value
let fe = fns.entries()
let fv = fe[0].value
"${oe[0].value ?? -1} ${oe[1].value ?? -1} ${g} ${r} ${ids.entries()[0].value.n} ${fv(1)} ${cells.entries()[0].value.get()} ${h.all()} ${make().entries().filter(it.value).length} ${lit}"
