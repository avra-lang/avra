// proves: thousands of entries, after removals and an overwrite, read
// back in the order the paired walk reads, key for key.
mut m: Map<string, string> = {}
for i in 0..5000 { m.set("k${i}", "v${i}") }
for i in 0..5000 { if i % 3 == 0 { let _ = m.remove("k${i}") } }
m.set("k1", "over")
let es = m.entries()
mut ok = true
mut at = 0
for k, v in m {
    if es[at].key != k || es[at].value != v { ok = false }
    at = at + 1
}
"${es.length} ${es[0].key}=${es[0].value} ${es[1].key} ${es.last()?.key ?? ""} ${ok}"
