// proves: twenty thousand entries walk in order — a kept Map holds
// every other one, `map` agrees with `entries` pair for pair, and a
// fold and a last hit read the whole walk.
mut m: Map<string, int> = {}
for i in 0..20000 { m.set("k${i}", i) }
let even = m.filter(it.value % 2 == 0)
let same = m.map(it)
let es = m.entries()
mut agree = same.length == es.length
for i, e in same { if e.key != es[i].key || e.value != es[i].value { agree = false } }
"${even.length} ${even.keys()[1]} ${even.get("k19998") ?? -1} ${even.has("k3")} ${agree} ${m.fold(0, (acc, e) -> acc + e.value)} ${m.find_last(it.value < 5)?.key ?? "-"}"
