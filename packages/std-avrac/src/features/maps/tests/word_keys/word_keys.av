// proves: a map keys by words — an int, a bool, an enum whose variants carry nothing, a name over an
// int — as it keys by text: zero and negative keys are keys, a removal leaves the rest in order and a
// key written again after it opens anew at the end, a map grown past its small index through holes
// reads every key it holds, a copy is its own, a read then a write under one key is one probe, and
// the keys, the entries and the walk answer the key's own type.
type UserId = int

enum Color {
    Red
    Green
    Blue
}

mut m: Map<int, string> = {3: "three", 0: "zero", -7: "minus seven"}
m.set(10, "ten")
m.set(0, "nought")
let read = "${m.length} ${m.get(0) ?? "?"} ${m.get(-7) ?? "?"} ${m.get(99) ?? "absent"} ${m.has(3)} ${m.has(4)}"
let gone = m.remove(3)
let after = "${gone ?? "?"} ${m.length} ${m.has(3)}"
m.set(3, "back")
let order = ["${k}=${v}" for k, v in m].join(",")
let snap = m
m.set(42, "forty-two")
m.set(10, (m.get(10) ?? "") + "!")
let copied = "${snap.length} ${m.length} ${snap.get(10) ?? "?"} ${m.get(10) ?? "?"}"
mut big: Map<int, int> = {}
for i in 0..100 { big.set(i * 3, i) }
for i in 0..50 { let _ = big.remove(i * 6) }
let grown = "${big.length} ${big.get(3) ?? -1} ${big.get(6) ?? -1} ${big.keys().fold(0, (a, k) -> a + k)}"
let flags: Map<bool, string> = {true: "yes", false: "no"}
let truth = "${flags.get(false) ?? "?"} ${flags.get(true) ?? "?"} ${flags.length}"
mut paint: Map<Color, int> = {}
paint.set(Color.Green, 2)
paint.set(Color.Red, 1)
paint.set(Color.Green, 20)
let painted = ["${c.ordinal}:${n}" for c, n in paint].join(",")
mut users: Map<UserId, string> = {}
users.set(UserId(7), "ann")
let named = "${users.get(UserId(7)) ?? "?"} ${users.has(UserId(8))}"
let entries = m.entries().map("${it.key}").join(",")
"${read} | ${after} | ${order} | ${copied} | ${grown} | ${truth} | ${painted} | ${named} | ${entries}"
