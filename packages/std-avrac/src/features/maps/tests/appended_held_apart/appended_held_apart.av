// proves: a list taken out of its map for an append in place leaves every other holder its own value —
// a copy of the map made before, a copy held in a record, a list read out of it and kept — read after
// the append, and after a second one.
type Held = { m: Map<string, List<string>> }

fn every_holder() -> string {
    mut by: Map<string, List<string>> = {"a": ["x"]}
    let before = by
    let kept = Held { m: by }
    let read = by.get("a")!
    let k = "a"
    by.set(k, (by.get(k) ?? []).concat(["y"]))
    let first = by.get("a")!.join("")
    by.set(k, (by.get(k) ?? []).concat(["z"]))
    "${first} ${by.get("a")!.join("")} ${before.get("a")!.join("")} ${kept.m.get("a")!.join("")} ${read.join("")}"
}

/// The append on a key the copy made before never had.
fn fresh_key() -> string {
    mut by: Map<string, List<string>> = {"a": ["x"]}
    let before = by
    let k = "b"
    by.set(k, (by.get(k) ?? []).concat(["y"]))
    "${by.length} ${before.length} ${before.get("b") == null}"
}

"${every_holder()} | ${fresh_key()}"
