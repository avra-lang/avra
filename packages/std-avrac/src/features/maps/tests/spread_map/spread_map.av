// proves: a map literal spreads maps — written order, a later entry
// wins, an overwritten key keeps its first place; sources are untouched
type Row = { n: int }

let a = {"x": 1, "y": 2}
let b = {"y": 20, "z": 30}
let c = {..a, ..b}
let d = {"w": 0, ..a, "x": 9}
let e = {..a}
let f: Map<string, int> = {..{}, "k": 5}
let rows = {"r": Row { n: 1 }}
let g = {..rows, "s": Row { n: 2 }}
let h = {"x": 100, ..a}
"${c.keys().join(",")} ${c.get("y")!} ${c.get("z")!} | ${d.keys().join(",")} ${d.get("x")!} | ${e.length} | ${f.get("k")!} | ${g.length} ${g.get("s")!.n} | ${h.keys().join(",")} ${h.get("x")!} | ${a.length} ${a.get("x")!}"
