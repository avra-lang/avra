// proves: walks over a map compose — bounds at and past the ends,
// a terminal after a kept Map, a nested walk of another map, a kept
// Map under a paired `for` and a comprehension head.
let m = {"a": 1, "b": 2, "c": 3, "d": 4}
let other = {"b": 0, "d": 0}
let shared = m
    .filter((e: Entry<string, int>) -> other.any((o: Entry<string, int>) -> o.key == e.key))
mut walked: List<string> = []
for k, v in m.filter(it.value % 2 == 1) { walked.push("${k}${v}") }
let headed = [v for _k, v in m.drop(2)]
let lists = {"x": [1, 2], "y": [3]}
"${m.take(0).length}${m.drop(99).length}${m.take(-1).length}${m.take(99).length} ${m.filter(it.value > 1).any(it.key == "a")}${m.filter(it.value > 1).count()} ${m.take(3).find(it.value > 1)?.key ?? "-"} ${m.take_while(it.value < 4).drop(1).map(it.key).join("")} ${shared.keys().join("")} ${walked.join("")} ${headed.sum()} ${lists.flat_map(it.value).sum()} ${m.drop_while(it.value < 3).keys().join("")} ${m.filter(it.value > 1).filter(it.value < 4).take(1).keys().join("")} ${m.find_last(it.value < 3)?.value ?? 0}${m.find_index(it.value == 3) ?? -1}"
