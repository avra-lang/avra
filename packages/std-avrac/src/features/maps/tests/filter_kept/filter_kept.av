// proves: a map's `filter` keeps each entry its predicate holds of, in
// the map's order, judged by key and by value; the map it read stands.
fn above(m: Map<string, int>, n: int) -> Map<string, int> { m.filter(it.value > n) }

let m = {"a": 1, "b": 5, "c": 3, "d": 9}
let big = above(m, 2)
let named = m.filter(it.key != "b")
"${big.keys().join(",")} ${named.keys().join(",")} ${big.get("d") ?? 0} ${m.length}"
