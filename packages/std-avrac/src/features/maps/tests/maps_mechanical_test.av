// GENERATED by `avra attack maps` — the mechanical
// classes from the feature's rule and the model. A SEMANTIC
// attack belongs in the feature's hand-written test.
// cap: 500 case(s), 0 dropped.
use @std.avrac.language.{analyze_source}
use @std.avrac.diagnostics.{Diag}

/// The SHAPE parses — a canonical sample spells `x` where a name
/// belongs, so a TYPE error is expected and a PARSE error is not.
fn parses(src: string) -> bool {
    !analyze_source(src).diagnostics.any(parse_error)
}

fn parse_error(d: Diag) -> bool {
    d.kind.starts_with("parse.")
}

/// The compiler REACHES A VERDICT on a malformed surface — a
/// deletion can yield a valid program, so this law is tolerance,
/// not refusal; a trap is not a verdict and dies in the call.
fn tolerates(src: string) -> bool {
    let reached = analyze_source(src).diagnostics.length
    reached >= 0
}

spec "features/maps adversarial — mechanical" {
    given "degenerate shapes — a valid surface, and must stay valid" {
        then "{ \n x : x , \n }" { parses("{ \n x : x , \n }") == parses("{ \n x : x , \n x : x , \n }") }
        then "{ \n x : x , \n x : x , \n x : x , \n }" { parses("{ \n x : x , \n x : x , \n x : x , \n }") == parses("{ \n x : x , \n x : x , \n }") }
    }
    given "malformed surface — must be diagnosed" {
        then "\n }" { tolerates("\n }") }
        then "{ }" { tolerates("{ }") }
        then "{ \n" { tolerates("{ \n") }
        then "{ { \n }" { tolerates("{ { \n }") }
        then "{ \n \n }" { tolerates("{ \n \n }") }
        then "{ \n } }" { tolerates("{ \n } }") }
        then "\n { }" { tolerates("\n { }") }
        then "{ } \n" { tolerates("{ } \n") }
        then "\n x : x , \n x : x , \n }" { tolerates("\n x : x , \n x : x , \n }") }
        then "{ x : x , \n x : x , \n }" { tolerates("{ x : x , \n x : x , \n }") }
        then "{ \n : x , \n x : x , \n }" { tolerates("{ \n : x , \n x : x , \n }") }
        then "{ \n x x , \n x : x , \n }" { tolerates("{ \n x x , \n x : x , \n }") }
        then "{ \n x : , \n x : x , \n }" { tolerates("{ \n x : , \n x : x , \n }") }
        then "{ \n x : x \n x : x , \n }" { tolerates("{ \n x : x \n x : x , \n }") }
        then "{ \n x : x , x : x , \n }" { tolerates("{ \n x : x , x : x , \n }") }
        then "{ \n x : x , \n : x , \n }" { tolerates("{ \n x : x , \n : x , \n }") }
        then "{ \n x : x , \n x x , \n }" { tolerates("{ \n x : x , \n x x , \n }") }
        then "{ \n x : x , \n x : , \n }" { tolerates("{ \n x : x , \n x : , \n }") }
        then "{ \n x : x , \n x : x \n }" { tolerates("{ \n x : x , \n x : x \n }") }
        then "{ \n x : x , \n x : x , }" { tolerates("{ \n x : x , \n x : x , }") }
        then "{ \n x : x , \n x : x , \n" { tolerates("{ \n x : x , \n x : x , \n") }
        then "{ { \n x : x , \n x : x , \n }" { tolerates("{ { \n x : x , \n x : x , \n }") }
        then "{ \n \n x : x , \n x : x , \n }" { tolerates("{ \n \n x : x , \n x : x , \n }") }
        then "{ \n x x : x , \n x : x , \n }" { tolerates("{ \n x x : x , \n x : x , \n }") }
        then "{ \n x : : x , \n x : x , \n }" { tolerates("{ \n x : : x , \n x : x , \n }") }
        then "{ \n x : x x , \n x : x , \n }" { tolerates("{ \n x : x x , \n x : x , \n }") }
        then "{ \n x : x , , \n x : x , \n }" { tolerates("{ \n x : x , , \n x : x , \n }") }
        then "{ \n x : x , \n \n x : x , \n }" { tolerates("{ \n x : x , \n \n x : x , \n }") }
        then "{ \n x : x , \n x x : x , \n }" { tolerates("{ \n x : x , \n x x : x , \n }") }
        then "{ \n x : x , \n x : : x , \n }" { tolerates("{ \n x : x , \n x : : x , \n }") }
        then "{ \n x : x , \n x : x x , \n }" { tolerates("{ \n x : x , \n x : x x , \n }") }
        then "{ \n x : x , \n x : x , , \n }" { tolerates("{ \n x : x , \n x : x , , \n }") }
        then "{ \n x : x , \n x : x , \n \n }" { tolerates("{ \n x : x , \n x : x , \n \n }") }
        then "{ \n x : x , \n x : x , \n } }" { tolerates("{ \n x : x , \n x : x , \n } }") }
        then "\n { x : x , \n x : x , \n }" { tolerates("\n { x : x , \n x : x , \n }") }
        then "{ x \n : x , \n x : x , \n }" { tolerates("{ x \n : x , \n x : x , \n }") }
        then "{ \n : x x , \n x : x , \n }" { tolerates("{ \n : x x , \n x : x , \n }") }
        then "{ \n x x : , \n x : x , \n }" { tolerates("{ \n x x : , \n x : x , \n }") }
        then "{ \n x : , x \n x : x , \n }" { tolerates("{ \n x : , x \n x : x , \n }") }
        then "{ \n x : x \n , x : x , \n }" { tolerates("{ \n x : x \n , x : x , \n }") }
        then "{ \n x : x , x \n : x , \n }" { tolerates("{ \n x : x , x \n : x , \n }") }
        then "{ \n x : x , \n : x x , \n }" { tolerates("{ \n x : x , \n : x x , \n }") }
        then "{ \n x : x , \n x x : , \n }" { tolerates("{ \n x : x , \n x x : , \n }") }
        then "{ \n x : x , \n x : , x \n }" { tolerates("{ \n x : x , \n x : , x \n }") }
        then "{ \n x : x , \n x : x \n , }" { tolerates("{ \n x : x , \n x : x \n , }") }
        then "{ \n x : x , \n x : x , } \n" { tolerates("{ \n x : x , \n x : x , } \n") }
        then "x x" { tolerates("x x") }
    }
}
