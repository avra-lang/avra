// proves: an entry is an ordinary element — `for`, a comprehension,
// the walk verbs and the list verbs read it, a fn takes one by its
// name, and a grown copy leaves the entries it came from alone.
fn shown(e: Entry<string, int>) -> string { "${e.key}:${e.value}" }

let m = {"x": 1, "y": 2, "z": 3}
mut total = 0
for e in m.entries() { total = total + e.value }
let big = m.entries().filter(it.value > 1).map(shown(it))
let keys = [e.key for e in m.entries() if e.value != 2]
let first = m.entries().find(it.key == "y")
let made: Entry<string, int> = Entry { key: "w", value: 0 }
let es = m.entries()
let grown = es.concat([made])
let tail = grown.slice(2, 4)
"${total} ${big.join(",")} ${keys.join("")} ${first?.value ?? -1} ${m.entries().any(it.value > 2)} ${shown(made)} ${es.length} ${grown.last()?.key ?? ""} ${tail.map(it.key).join("")} ${es.first()?.key ?? ""}"
