// Maps under attack: degenerate shapes, every wrong type at every
// seat, the malformed literal, every feature crossed, names, and
// ownership through copy-on-write under churn (rt29). The vertical
// story lives in maps_test.av.
use @std.avrac.compiler.{analyze_source}
use @std.avrac.testing.{shown, refused_with, refusals}

spec "features/maps/adversarial" {
    given "degenerate shapes" {
        then "an empty declared map measures zero" {
            shown("mut m: Map<string, int> = {}\nm.length") == "0"
        }
        then "a duplicate key in a literal — the last write wins, one pair" {
            shown("let m = { \"a\": 1, \"a\": 2 }\nlet a = m.get(\"a\") ?? 0\n\"" + "\${m.length} " + "\${a}\"") == "1 2"
        }
        then "the empty string is a key" {
            shown("mut m: Map<string, int> = {}\nm.set(\"\", 7)\nm.get(\"\") ?? 0") == "7"
        }
        then "a thousand keys — the index grows and every key is found" {
            shown("mut m: Map<string, int> = {}\nmut i = 0\nwhile i < 1000 {\n    m.set(\"k" + "\${i}\", i)\n    i = i + 1\n}\nlet z = m.get(\"k999\") ?? 0 - 1\nlet none = m.get(\"k1000\") ?? 0 - 1\n\"" + "\${m.length} " + "\${z} " + "\${none}\"") == "1000 999 -1"
        }
    }
    given "every wrong type at every seat — one refusal each" {
        then "an int key at set" {
            refused_with("mut m: Map<string, int> = {}\nm.set(1, 1)\n2", "argument 1 of `set` wants `string`, found `int`")
        }
        then "indexing a map" {
            refused_with("let m = { \"a\": 1 }\nm[\"a\"]", "`[...]` indexes a `List`, found `Map<string, int>`")
        }
        then "push on a map falls to the method table" {
            refused_with("mut m: Map<string, int> = {}\nm.push(1)\n2", "`Map<string, int>` has none")
        }
        then "length is measured, not stored" {
            refused_with("mut m: Map<string, int> = {}\nm.length = 3\n2", "`length` is measured, not stored")
        }
        then "`{}` is not a list, `[]` is not a map" {
            refusals("let xs: List<int> = {}\n2") == 1 && refusals("let m: Map<string, int> = []\n2") == 1
        }
        then "a null value" {
            refused_with("let m = { \"a\": null }\n2", "a map value takes its type from its value, and `null` has none of its own")
        }
        then "maps do not compare" {
            refusals("let m = { \"a\": 1 } == { \"a\": 1 }\n2") == 1
        }
        then "a bare `{}` has no length yet — a declared type gives it one" {
            refused_with("let m = {}\nm.length", "`{}` has no length yet")
        }
        then "list values, struct values, fn values, nested maps" {
            shown("let m = { \"a\": [1, 2] }\n(m.get(\"a\") ?? []).length") == "2" && shown("type P = { x: int }\nlet m = { \"p\": P { x: 3 } }\n(m.get(\"p\") ?? P { x: 0 }).x") == "3" && shown("let m = { \"f\": (x: int) -> x * 2 }\nlet f = m.get(\"f\")\nif f == null { 0 } else { f(21) }") == "42" && shown("let m = { \"a\": { \"b\": 1 } }\nlet inner = m.get(\"a\")\nif inner == null { 0 } else { inner.get(\"b\") ?? 0 }") == "1"
        }
    }
    given "the malformed literal — a diagnostic every time (the floor's second voice is a recorded parser trigger)" {
        then "missing colon, missing value, missing key, double comma, unclosed" {
            refusals("let m = { \"a\" 1 }\n2") == 2 && refusals("let m = { \"a\": }\n2") == 2 && refusals("let m = { : 1 }\n2") == 2 && refusals("let m = { \"a\": 1,, }\n2") == 2 && refusals("let m = { \"a\": 1\n2") == 2
        }
        then "a trailing comma and a multi-line literal parse" {
            shown("let m = { \"a\": 1, }\nm.length") == "1" && shown("let m = {\n    \"a\": 1,\n    \"b\": 2\n}\nm.length") == "2"
        }
    }
    given "maps across every feature" {
        then "a map parameter and a map return" {
            shown("fn count(m: Map<string, int>) -> int {\n    m.length\n}\ncount({ \"a\": 1, \"b\": 2 })") == "2" && shown("fn made() -> Map<string, int> {\n    mut m: Map<string, int> = {}\n    m.set(\"a\", 1)\n    m\n}\nmade().get(\"a\") ?? 0") == "1"
        }
        then "get under a presence test, `if let`, and `match`" {
            shown("let m = { \"a\": 1 }\nif m.get(\"a\") != null { 1 } else { 0 }") == "1" && shown("let m = { \"a\": 1 }\nif let v? = m.get(\"a\") { v } else { 0 }") == "1" && shown("let m = { \"a\": 1 }\nmatch m.get(\"a\") {\n    w? -> w\n    null -> 0\n}") == "1"
        }
        then "maps in a list, set in a for, get in a lambda" {
            shown("let ms = [{ \"a\": 1 }, { \"a\": 2 }]\nms[1].get(\"a\") ?? 0") == "2" && shown("mut m: Map<string, int> = {}\nfor k in [\"x\", \"y\", \"z\"] {\n    m.set(k, k.length)\n}\nm.length") == "3" && shown("let m = { \"a\": 1, \"b\": 2 }\n[\"a\", \"b\", \"c\"].map((k) -> m.get(k) ?? 0)[1]") == "2"
        }
        then "the pronoun binds to the NEAREST call — two voices, the hint names the outer lambda" {
            let a = analyze_source("let m = { \"a\": 1, \"b\": 2 }\n[\"a\", \"b\"].map(m.get(it) ?? 0)[1]")
            a.diagnostics.length == 2 && a.report().contains("`it` binds to the NEAREST method call")
        }
        then "`with` keeps the map, `?.` reaches a nullable map" {
            shown("type S = { m: Map<string, int>, n: int }\nlet s = S { m: { \"a\": 1 }, n: 0 }\nlet t = s with { n: 5 }\nlet a = t.m.get(\"a\") ?? 0\n\"" + "\${a} " + "\${t.n}\"") == "1 5" && shown("let mm: Map<string, int>? = null\nmm?.length ?? 0 - 1") == "-1"
        }
    }
    given "ownership through copy-on-write" {
        then "a string value overwritten a thousand times" {
            shown("mut m: Map<string, string> = {}\nmut i = 0\nwhile i < 1000 {\n    m.set(\"k\", \"v" + "\${i}\")\n    i = i + 1\n}\n\"" + "\${m.length} " + "\${m.get(\"k\") ?? \"-\"}\"") == "1 v999"
        }
        then "a value read from a map is not a place" {
            refused_with("mut m: Map<string, List<int>> = {}\nm.set(\"a\", [1])\n(m.get(\"a\") ?? []).push(2)\n2", "`push` mutates a place")
        }
        then "a snapshot survives five hundred sets" {
            shown("mut m: Map<string, string> = {}\nm.set(\"a\", \"x\")\nlet snap = m\nmut i = 0\nwhile i < 500 {\n    m.set(\"k" + "\${i}\", \"v\")\n    i = i + 1\n}\n\"" + "\${m.length} " + "\${snap.length}\"") == "501 1"
        }
        then "a struct's map field replaced and grown three hundred times" {
            shown("type S = { m: Map<string, string> }\nmut s = S { m: {} }\nmut i = 0\nwhile i < 300 {\n    s.m = { \"a\": \"v" + "\${i}\" }\n    s.m.set(\"b\", \"w\")\n    i = i + 1\n}\n\"" + "\${s.m.length} " + "\${s.m.get(\"a\") ?? \"-\"}\"") == "2 v299"
        }
    }
}
