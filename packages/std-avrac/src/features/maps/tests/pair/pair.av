// proves: a map walks as key and value, in insertion order, over a
// snapshot — a write inside the body does not change the walk, and
// both binders agree turn by turn.
mut m: Map<string, int> = {}
m.set("b", 2)
m.set("a", 1)
m.set("c", 3)
mut ks: List<string> = []
mut vs: List<int> = []
for k, v in m {
    ks.push(k)
    vs.push(v)
    m.set("z" + k, v)
}
"${ks.join(",")} ${vs[0]} ${vs[1]} ${vs[2]} ${m.length} ${m.has("zb")}"
