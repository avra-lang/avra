// proves: a map's order is its insertion order — `keys` and `values`
// read back in written order, an overwrite keeps the key's place, a
// snapshot keeps the order it had, and `has` asks presence without a
// value read.
mut m: Map<string, int> = {}
m.set("b", 2)
m.set("a", 1)
m.set("c", 3)
m.set("a", 10)
let snap = m
m.set("d", 4)
let ks = snap.keys()
let vs = m.values()
"${m.has("a")} ${m.has("z")} ${snap.has("d")} ${ks.length} ${ks[0]} ${ks[1]} ${ks[2]} ${vs[0]} ${vs[1]} ${vs[2]} ${vs[3]} ${m.get("a") ?? 0}"
