// proves: a comprehension's head walks a map as the `for` statement
// does — key and value, in insertion order — under a filter, beside a
// list head on either side, over a map of managed values, and over an
// empty map; the element may read both binders. A null value is
// absent to the element, to the statement's body and in `values()`.
type Row = { name: string, tags: List<string> }

fn tagged(rows: Map<string, Row>) -> List<string> { ["${k}:${t}" for k, r in rows for t in r.tags] }

mut m: Map<string, int> = {}
m.set("b", 2)
m.set("a", 1)
m.set("c", 3)
m.remove("a")
m.set("a", 4)
let none: Map<string, int> = {}
let opt: Map<string, int?> = {"a": null, "b": 2}
mut seen: List<int> = []
for k, v in opt { seen.push(v ?? -1) }
let rows = {
    "x": Row { name: "ex", tags: ["p", "q"] },
    "y": Row { name: "why", tags: [] },
    "z": Row { name: "zed", tags: ["r"] },
}
let keys = [k for k, v in m]
let big = [k for k, v in m if v > 2]
let pairs = ["${k}=${v}" for k, v in m]
let crossed = ["${n}${k}" for n in [1, 2] for k, v in m if v == n + 1]
let names = [r.name for k, r in rows if k != "y"]
"${keys.join(",")} ${big.join(",")} ${pairs.join(",")} ${crossed.join(",")} | ${names.join(",")} ${tagged(rows).join(",")} ${[v for k, v in none].length} ${[v for k, v in m].sum()} | ${[v ?? -1 for k, v in opt].sum()} ${seen[0]} ${opt.values()[0] ?? -1}"
