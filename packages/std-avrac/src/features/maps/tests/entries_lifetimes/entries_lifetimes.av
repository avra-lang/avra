// proves: entries hold references of their own — they outlive a
// removal and an overwrite, and a write through a copy stays local.
mut m: Map<string, List<string>> = {}
m.set("a", ["x", "y"])
m.set("b", ["z"])
mut es = m.entries()
let _ = m.remove("a")
m.set("b", [])
es[1].value.push("w")
mut e0 = es[0]
e0.value = ["changed"]
let again = es[0] with { key: "A" }
let nested = {"m": m}.entries()
"${es[0].key}${es[0].value.join("")} ${es[1].value.join("")} ${m.get("b")?.length ?? -1} ${e0.value[0]} ${again.key}${again.value.length} ${nested[0].value.length}"
