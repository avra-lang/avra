// proves: a `set` whose value can move the map or the key between
// the read and the write keeps both probes, and stays right.
fn drop_a(mut m: Map<string, int>) -> int {
    let _ = m.remove("a")
    0
}
mut m = {"a": 1, "b": 2}
m.set("b", drop_a(m) + (m.get("b") ?? 0) + 5)
mut k = "a"
mut n = {"a": 1, "z": 9}
n
    .set(
        k,
        {
                k = "z"
                0
            } +
            (n.get(k) ?? 0),
    )
mut o = {"a": 1}
o.set("a", [1, 2].map((o.get("a") ?? 0) + it).sum())
let other = {"a": 100}
mut p = {"a": 1}
p.set("a", (other.get("a") ?? 0) + 1)
mut q = {"a": 1}
q.set("a", (q.get("b") ?? 7) + 1)
"${m.keys().join("")} ${m.get("b") ?? 0} ${n.get("a") ?? 0} ${n.get("z") ?? 0} ${o.get("a") ?? 0} ${p.get("a") ?? 0} ${q.get("a") ?? 0} ${q.has("b")}"
