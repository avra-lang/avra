// proves: an entry holds whatever the map holds — a list, a record,
// a nullable, a map — and a generic fn reads entries of any value.
type Point = { x: int, y: int }

fn keys_of<V>(m: Map<string, V>) -> string { m.entries().map(it.key).join(",") }

let lists = {"a": [1, 2], "b": [3]}
let points = {"p": Point { x: 1, y: 2 }}
mut maybe: Map<string, string?> = {}
maybe.set("n", null)
maybe.set("s", "text")
let nested = {"outer": {"inner": 7}}
let ls = lists.entries()
let ms = maybe.entries()
"${ls[0].value.length}${ls[1].value[0]} ${points.entries()[0].value.y} ${ms[0].value ?? "null"} ${ms[1].value ?? "null"} ${nested.entries()[0].value.get("inner") ?? 0} ${keys_of(lists)} ${keys_of(maybe)}"
