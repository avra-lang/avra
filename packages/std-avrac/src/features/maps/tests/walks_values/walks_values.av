// proves: a walk over a map holds whatever the map holds — lists,
// a scalar nullable, a record, a map — under a type parameter and
// over an empty map; a kept Map is its own value, and writable.
type Point = { x: int, y: int }
fn kept<V>(m: Map<string, V>, k: string) -> Map<string, V> { m.filter(it.key != k) }
fn names<V>(m: Map<string, V>) -> string { m.map(it.key).join("") }
let lists = {"a": [1, 2], "b": [], "c": [3]}
let full = lists.filter(!it.value.is_empty())
mut opt: Map<string, int?> = {}
opt.set("n", null)
opt.set("s", 7)
let present = opt.filter(it.value != null)
let absent = opt.filter(it.value == null)
let points = {"p": Point { x: 1, y: 2 }, "q": Point { x: 3, y: 4 }}
let far = points.filter(it.value.x > 1)
let empty: Map<string, int> = {}
let nested = {"o": {"i": 1}, "e": {}}
let inner = nested.filter(it.value.length > 0).flat_map(it.value.keys())
mut grown = lists.take(1)
grown.set("z", [9])
let ordered = {"b": 1, "a": 2, "c": 3}.filter(it.value != 2)
let total = lists.map(it.value.length).sum()
"${full.keys().join("")} ${present.keys().join("")}${present.get("s") ?? null ?? -1} ${absent.keys().join("")}${absent.has("n")} ${far.get("q")?.y ?? 0} ${empty.filter(it.value > 0).length}${empty.any(it.value > 0)}${empty.all(it.value > 0)} ${inner.join("")} ${grown.keys().join("")}${lists.length} ${ordered.keys().join("")} ${total} ${kept(lists, "b").keys().join("")} ${names(points)} ${lists.find(it.value.length == 1)?.key ?? "-"} ${lists.find_index(it.key == "zz") ?? -1} ${lists.count()}"
