// proves: a present null keeps its absence through every walk of a
// map — `values`, the paired `for`, a comprehension's head and
// `entries` — for a scalar nullable, whose absence is a slot's mark.
mut m: Map<string, int?> = {}
m.set("none", null)
m.set("some", 7)
let vs = m.values()
mut walked: List<bool> = []
for _k, v in m { walked.push(v == null) }
let headed = [v == null for _k, v in m]
let es = m.entries()
mut flags: Map<string, bool?> = {}
flags.set("unset", null)
flags.set("on", true)
let fe = flags.entries()
"${vs[0] == null} ${vs[1] == null} ${walked[0]} ${walked[1]} ${headed[0]} ${headed[1]} ${es[0].value == null} ${es[1].value ?? 0} ${fe[0].value == null} ${fe[1].value ?? false}"
