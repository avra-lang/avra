//! Parse-time lowering: captures -> the map node. No pairs is the
//! empty literal — typing owns its adoption.
use core.{Expr}
use features.{LangNode, Builder}

fn build_map(b: Builder) -> Result<LangNode, string> {
    let keys = b.exprs(0)?
    let values = b.exprs(1)?
    b.make_expr(Expr.MapLit(keys, values))
}
