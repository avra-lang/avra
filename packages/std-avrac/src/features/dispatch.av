//! The semantics dispatch: every feature's node and pattern
//! semantics boxed once, and the exhaustive maps that select a
//! node's. A new node kind breaks the map at compile time, and the
//! impl it names owes every pass, enforced by the traits. The walk
//! order every pass shares lives here too. A statement's own passes
//! are the record's `StmtSemantics`, reached on the `Stmt` value.
use core.{Expr, ExprId, SyntaxArena, flatten, Pat, body_behavior, TypeId, Reg}
use core.expr.{Body}
use features.str_lit.{str_type, str_lower}
use features.quote.{quote_type, quote_reg}
use features.sublang.{block_type, block_reg}

/// Every feature's boxed node and pattern semantics, built ONCE per
/// assembly — the exhaustive maps below only SELECT. The language
/// builds it (the boxing happens under typed lets there); every pass
/// reaches a node's semantics through it, never by matching feature
/// nodes.
export type Dispatch = {
    spine: dyn NodeSemantics,
    strs: dyn NodeSemantics,
    bools: dyn NodeSemantics,
    ifs: dyn NodeSemantics,
    whens: dyn NodeSemantics,
    blocks: dyn NodeSemantics,
    calls: dyn NodeSemantics,
    aggs: dyn NodeSemantics,
    structs: dyn NodeSemantics,
    enums: dyn NodeSemantics,
    nullables: dyn NodeSemantics,
    catches: dyn NodeSemantics,
    quotes: dyn NodeSemantics,
    sublangs: dyn NodeSemantics,
    components: dyn NodeSemantics,
    methods: dyn NodeSemantics,
    lambdas: dyn NodeSemantics,
    tasks: dyn NodeSemantics,
    selects: dyn NodeSemantics,
    ranges: dyn NodeSemantics,
    maps: dyn NodeSemantics,
    enumpats: dyn PatSemantics,
    formatpats: dyn PatSemantics,
    narrowpats: dyn PatSemantics,
    quotepats: dyn PatSemantics,
}

/// The semantics of each expression node — THE exhaustive map,
/// selecting from the once-built Dispatch. A new variant breaks
/// HERE at compile time, and the impl it names owes every pass,
/// enforced by the trait.
/// A body is handled by the feature its WORD names — the one
/// registry in core, asked once.
fn body_semantics(d: Dispatch, word: string) -> dyn NodeSemantics {
    match body_behavior(word) { .Text -> d.strs, .Quote -> d.quotes, .Foreign -> d.sublangs }
}

export fn semantics_of(d: Dispatch, e: Expr) -> dyn NodeSemantics {
    match e {
        .IntLit(_) or .FloatLit(_) or .Ident(_) or .Binary(_, _, _) or .Not(_) or .Index(_, _) or .Prop(_, _) or .Error -> d.spine,
        .ListLit(_) or .Comp(_, _) or .Collect(_) -> d.aggs,
        .MapLit(_, _) -> d.maps,
        .StrLit(_) or .BytesLit(_) -> d.strs,
        .Body(word, _, _, _) -> body_semantics(d, word),
        .Component(_, _, _, _, _) -> d.components,
        .BoolLit(_) -> d.bools,
        .If(_, _, _) -> d.ifs,
        .When(_, _, _) -> d.whens,
        .Block(_, _) -> d.blocks,
        .Call(_, _, _) or .Named(_, _) -> d.calls,
        .StructLit(_, _, _) or .With(_, _, _) -> d.structs,
        .Match(_, _) or .Is(_, _) or .VariantLit(_, _) -> d.enums,
        .NullLit or .Coalesce(_, _) or .Force(_) or .Propagate(_) or .MatchOpt(_, _, _, _) or .Chain(_, _) -> d.nullables,
        .Catch(_, _, _, _) -> d.catches,
        .MethodCall(_, _, _) or .Receiver -> d.methods,
        .Lambda(_, _) or .CallValue(_, _) -> d.lambdas,
        .Spawn(_) or .Within(_, _) or .Emit(_) or .Produce(_, _, _) or .Channel(_, _) -> d.tasks,
        .Select(_, _) or .WaitArm(_, _, _, _, _) or .ElseArm(_) -> d.selects,
        .Range(_, _) -> d.ranges,
        .Env(_) -> d.spine,
    }
}

/// The semantics of each PATTERN kind — the pattern ladder's twin
/// of semantics_of. A new `Pat` variant breaks HERE at compile
/// time, and the impl it names owes all three methods, enforced by
/// the trait. An owner adds its arms here and nowhere else.
export fn pat_semantics_of(d: Dispatch, p: Pat) -> dyn PatSemantics {
    match p {
        .Wild or .Rest or .Bind(_) or .Variant(_, _) or .Lit(_) or .Member(_, _) -> d.enumpats,
        .Format(_, _) -> d.formatpats,
        .Typed(_, _) -> d.narrowpats,
        .Quote(_) -> d.quotepats,
    }
}

/// Every node at and under `root`, children before owners — THE
/// order every pass visits: facts a node reads exist before it
/// speaks. Which nodes are a node's children is each feature's
/// answer, reached through the dispatch.
export fn post_order(d: Dispatch, store: SyntaxArena, root: ExprId) -> List<ExprId> {
    let node = store.expr(root)
    flatten([post_order(d, store, k) for k in semantics_of(d, node).kids(node)]).concat([root])
}

impl Meaning for Body {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        let bp? = cx.view.store.expr(e).body_of() else { return cx.error_type }
        match body_behavior(bp.word) {
            .Text -> str_type(cx, e),
            .Quote -> quote_type(cx, e),
            .Foreign -> block_type(cx, e),
        }
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        let bp? = cx.view.store.expr(e).body_of() else { return cx.lower_defect(e, "a body node without its parts") }
        match body_behavior(bp.word) {
            .Text -> str_lower(cx, e),
            .Quote -> quote_reg(cx, e),
            .Foreign -> block_reg(cx, e),
        }
    }
}
