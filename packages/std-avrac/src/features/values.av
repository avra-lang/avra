//! How a VALUE is represented at runtime, written once for every
//! feature that builds or reads one. The contract next door says
//! what a feature DOES at each pass; this says what its values ARE.
//!
//! Three layouts today, four vocabularies. The tagged slot array
//! behind ENUMS — which RESULT rides too (the built-in enum: Ok
//! tag 0, Err tag 1); and the nullable's two — the NICHE (a
//! pointer-shaped nullable IS its own value, absence is the null
//! pointer) and the PAIR (a scalar rides {present, value} in
//! registers). Which one a nullable takes is this file's
//! `repr_of`, and every consumer asks the verbs below instead of
//! knowing. A new value CATEGORY joins here, beside the readers
//! that make its layout nobody else's business.
use core.{Reg, Ins, BinOp, Type, TypeId, ExprId, ptr_shape}

/// THE TAGGED VALUE: an enum's variant is a slot array holding its
/// TAG at slot 0 and its payload, when it has one, at slot 1.
/// `dst` is minted by the caller, before the first instruction is
/// emitted — registers are numbered in emission order.
export fn tagged_value(cx: LowerCx, dst: Reg, tag: int, payload: Reg?) {
    cx.emit(Ins.CallRt(dst, "avra_array_new", []))
    let slot = cx.mint_shape(Type.Int)
    cx.emit(Ins.ConstInt(slot, tag))
    cx.emit(Ins.CallRtVoid("avra_array_push", [dst, slot]))
    if payload == null { return }
    cx.emit(Ins.CallRtVoid("avra_array_push", [dst, payload!]))
}

/// The TAG a tagged value carries. Slot 0, always an int — asking
/// here is how a consumer avoids knowing the number.
export fn tag_of(cx: LowerCx, v: Reg) -> Reg {
    slot_read(cx, v, 0, null)
}

/// The PAYLOAD a tagged value carries, as the type it was written
/// with. Slot 1 — the other half of `tagged_value`'s shape.
export fn payload_of(cx: LowerCx, v: Reg, ty: TypeId) -> Reg {
    slot_read(cx, v, 1, ty)
}

/// One slot read: the index is a constant, so it is minted and
/// emitted BEFORE the read that uses it — registers are numbered in
/// emission order. An absent type reads as an int.
fn slot_read(cx: LowerCx, v: Reg, n: int, ty: TypeId?) -> Reg {
    let at = cx.mint_shape(Type.Int)
    cx.emit(Ins.ConstInt(at, n))
    let got = if ty == null { cx.mint_shape(Type.Int) } else { cx.mint_ty(ty!) }
    cx.emit(Ins.CallRt(got, "avra_array_get", [v, at]))
    got
}

// ── The Result, behind its verbs ────────────────────────────────
// The built-in enum rides the tagged value above: tag 0 = Ok,
// tag 1 = Err, the live side at slot 1. An `.Err` box is therefore
// a valid `.Err` of EVERY `Result<_, E>` — propagation moves the
// pointer and repacks nothing. (ROADMAP: the error spine.)

/// A success, wrapped — the auto-Ok lift's mint.
export fn okayed(cx: LowerCx, into: TypeId, r: Reg) -> Reg {
    let dst = cx.mint_ty(into)
    tagged_value(cx, dst, 0, r)
    dst
}

/// A failure, wrapped — what `fail` exits with.
export fn failed(cx: LowerCx, into: TypeId, r: Reg) -> Reg {
    let dst = cx.mint_ty(into)
    tagged_value(cx, dst, 1, r)
    dst
}

/// Is the result an ANSWER — its tag read against Ok's, as an i1.
export fn okness_of(cx: LowerCx, v: Reg) -> Reg {
    let tag = tag_of(cx, v)
    let zero = cx.mint_shape(Type.Int)
    cx.emit(Ins.ConstInt(zero, 0))
    let ok = cx.mint_shape(Type.Bool)
    cx.emit(Ins.Bin(ok, BinOp.Eq, tag, zero))
    ok
}

// ── The nullable, behind its verbs ──────────────────────────────
// The surface is ONE (`null`, `??`, `!`, match, `?.`); the layouts
// are two; the seam is here. ROADMAP: the nullable representation.

/// Which layout a nullable takes, decided by what it CARRIES. A
/// pointer-shaped value IS its own nullable — absence is the null
/// pointer, which no legitimate value ever holds — so presence
/// costs nothing and the memory pass sees the value it already
/// manages. A scalar has no impossible bit pattern, so it rides an
/// unboxed {present, value} PAIR in registers — two values the
/// optimizer sees straight through. NULLABILITY NEVER ALLOCATES:
/// that is the law (ROADMAP), and lower_test pins it.
enum Repr { Niche, Pair }

/// The representation of a nullable TYPE — a projection, and the
/// catch-all is honest: a non-`Opt` shape is the absorbing error
/// path, which lowers nothing, so the pair it names is never built.
fn repr_of(cx: LowerCx, opt: TypeId) -> Repr {
    match cx.types.shape_of(opt) {
        .Opt(inner) -> if ptr_shape(cx.types.shape_of(inner)) { Repr.Niche } else { Repr.Pair },
        _ -> Repr.Pair,
    }
}

/// What a nullable type carries — the `Opt`'s inner, with the
/// catch-all pinned to the asker's own type on the error path.
export fn carried_type(cx: LowerCx, opt: TypeId) -> TypeId {
    match cx.types.shape_of(opt) {
        .Opt(inner) -> inner,
        _ -> opt,
    }
}

/// Is the value THERE — an i1: the niche compares itself against
/// the null constant, the pair already CARRIES its answer.
export fn presence_of(cx: LowerCx, v: Reg, opt: TypeId) -> Reg {
    match repr_of(cx, opt) {
        .Niche -> nonzero(cx, v, zeroed(cx, cx.mint_ty(opt))),
        .Pair -> extracted(cx, v, 0, cx.mint_shape(Type.Bool)),
    }
}

/// One element of a packed value, into a caller-typed register.
fn extracted(cx: LowerCx, v: Reg, at: int, dst: Reg) -> Reg {
    cx.emit(Ins.Extract(dst, v, at))
    dst
}

/// The zero of the register's own type, emitted — the null pointer
/// for pointer shapes, the absent tag for ints.
fn zeroed(cx: LowerCx, z: Reg) -> Reg {
    cx.emit(Ins.ConstInt(z, 0))
    z
}

/// `a != z`, as an i1.
fn nonzero(cx: LowerCx, a: Reg, z: Reg) -> Reg {
    let p = cx.mint_shape(Type.Bool)
    cx.emit(Ins.Bin(p, BinOp.Ne, a, z))
    p
}

/// What the nullable CARRIES, once presence is settled: a niche
/// nullable IS its value — identity, no instruction — and a pair
/// holds it beside the flag.
export fn carried_of(cx: LowerCx, v: Reg, opt: TypeId) -> Reg {
    match repr_of(cx, opt) {
        .Niche -> v,
        .Pair -> extracted(cx, v, 1, cx.mint_ty(carried_type(cx, opt))),
    }
}

/// A value ADOPTED by a nullable — the widening edge's runtime
/// form, and the ONE place absence takes a layout: `from_null`
/// marks the null literal, which arrives already absent (a null
/// constant). A niche adoption is IDENTITY both ways — the pointer
/// is the nullable, the null constant is the absence — so widening
/// a pointer costs nothing.
export fn adopted(cx: LowerCx, into: TypeId, from_null: bool, r: Reg) -> Reg {
    match repr_of(cx, into) {
        .Niche -> r,
        .Pair -> pair_adoption(cx, into, from_null, r),
    }
}

fn pair_adoption(cx: LowerCx, into: TypeId, from_null: bool, r: Reg) -> Reg {
    if from_null { return absent_of(cx, into) }
    flagged_pair(cx, into, true, r)
}

/// The ABSENT value of a nullable type, minted fresh — the niche's
/// null constant, or the pair whose flag says no.
export fn absent_of(cx: LowerCx, opt: TypeId) -> Reg {
    match repr_of(cx, opt) {
        .Niche -> zeroed(cx, cx.mint_ty(opt)),
        .Pair -> absent_pair(cx, opt),
    }
}

fn absent_pair(cx: LowerCx, opt: TypeId) -> Reg {
    flagged_pair(cx, opt, false, hollow_of(cx, carried_type(cx, opt)))
}

/// A pair packed under its flag — the ONE builder the present and
/// absent forms share.
fn flagged_pair(cx: LowerCx, opt: TypeId, present: bool, payload: Reg) -> Reg {
    let flag = cx.mint_shape(Type.Bool)
    cx.emit(Ins.ConstBool(flag, present))
    let dst = cx.mint_ty(opt)
    cx.emit(Ins.Pack(dst, [flag, payload]))
    dst
}

/// A slot of a type that will NEVER be read, but must be total:
/// the type's zero. An absent pair's payload rides one, and so
/// does the yield of an arm that already EXITED the fn.
export fn hollow_of(cx: LowerCx, inner: TypeId) -> Reg {
    if cx.types.shape_of(inner) is .Bool {
        let z = cx.mint_ty(inner)
        cx.emit(Ins.ConstBool(z, false))
        return z
    }
    zeroed(cx, cx.mint_ty(inner))
}

/// `v!` — the carried value, with the runtime insisting the value
/// is PRESENT. Each repr asks its own runtime word; both refuse in
/// the same words, and the check cannot be elided — absence is
/// exactly what the writer claimed would not happen.
export fn insisted(cx: LowerCx, e: ExprId, v: Reg, opt: TypeId) -> Reg {
    match repr_of(cx, opt) {
        .Niche -> insisted_niche(cx, e, v),
        .Pair -> insisted_pair(cx, e, v, opt),
    }
}

fn insisted_niche(cx: LowerCx, e: ExprId, v: Reg) -> Reg {
    let dst = cx.mint(e)
    cx.emit(Ins.CallRt(dst, "avra_insist", [v]))
    dst
}

fn insisted_pair(cx: LowerCx, e: ExprId, v: Reg, opt: TypeId) -> Reg {
    let flag = extracted(cx, v, 0, cx.mint_shape(Type.Bool))
    let payload = extracted(cx, v, 1, cx.mint_ty(carried_type(cx, opt)))
    let dst = cx.mint(e)
    cx.emit(Ins.CallRt(dst, "avra_insist_scalar", [flag, payload]))
    dst
}
