//! The evaluated-payload projections and the statement-value
//! rituals: one verb per shape, so no rule ever spells the
//! evaluate-fetch-project chain or the stmt_value-guard two-step.
use core.{NodeStore, ExprId, StmtId, Reg, int_of, truth_of, text_of, elems_of}

/// A scalar VALUE node's text — how it prints and interpolates.
export fn scalar_text(store: NodeStore, e: ExprId) -> string? {
    let node = store.expr(e)
    let tv: string? = text_of(node)
    if tv != null { return tv }
    let iv: int? = int_of(node)
    if iv != null { return "${iv!}" }
    let bv: bool? = truth_of(node)
    if bv != null { return if bv! { "true" } else { "false" } }
    null
}

impl EvalCx {
    /// The evaluated int at `e`, when its value is one.
    fn int_at(self, e: ExprId) -> int? {
        int_of(self.store.expr(self.value_at(e)))
    }

    /// The evaluated truth at `e`, when its value is one.
    fn truth_at(self, e: ExprId) -> bool? {
        truth_of(self.store.expr(self.value_at(e)))
    }

    /// The evaluated text at `e`, when its value is a string.
    fn text_at(self, e: ExprId) -> string? {
        text_of(self.store.expr(self.value_at(e)))
    }

    /// The evaluated elements at `e`, when its value is a list.
    fn elems_at(self, e: ExprId) -> List<ExprId>? {
        elems_of(self.store.expr(self.value_at(e)))
    }
}

impl StmtResolveCx {
    /// Walk the statement's value expression, when it carries one.
    fn walk_value(self, s: StmtId) {
        let v: ExprId? = self.store.stmt_value(s)
        if v != null { self.walk(v!) }
    }
}

impl StmtTypeCx {
    /// Walk the statement's value expression, when it carries one.
    fn walk_value(self, s: StmtId) {
        let v: ExprId? = self.store.stmt_value(s)
        if v != null { self.walk(v!) }
    }
}

impl StmtEvalCx {
    /// The statement's value, evaluated — null when it carries none.
    fn eval_value(self, s: StmtId) -> ExprId? {
        let v: ExprId? = self.store.stmt_value(s)
        if v == null { return null }
        self.eval(v!)
    }
}

impl StmtLowerCx {
    /// The statement's value, lowered — null when it carries none.
    fn lower_value(self, s: StmtId) -> Reg? {
        let v: ExprId? = self.store.stmt_value(s)
        if v == null { return null }
        self.lower(v!)
    }
}
