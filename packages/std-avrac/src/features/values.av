//! How a VALUE is represented at runtime, written once for every
//! feature that builds or reads one. The contract next door says
//! what a feature DOES at each pass; this says what its values ARE.
//!
//! Three layouts today, four vocabularies. The tagged slot array
//! behind ENUMS — which RESULT rides too (the built-in enum: Ok
//! tag 0, Err tag 1); and the nullable's two — the NICHE (a
//! pointer-shaped nullable IS its own value, absence is the null
//! pointer) and the PAIR (a scalar rides {present, value} in
//! registers). Which one a nullable takes is this file's
//! `repr_of`, and every consumer asks the verbs below instead of
//! knowing. A new value CATEGORY joins here, beside the readers
//! that make its layout nobody else's business.
use core.{
    Reg,
    Ins,
    BinOp,
    Type,
    TypeId,
    TypeRegistry,
    ExprId,
    Expr,
    SyntaxArena,
    filled,
    flatten,
    BodyParts,
    Slot,
    StaticBox,
    same_type,
    is_managed,
}
use features.{MetaVal, MetaHeap, TypeFacts, Decls, meta_of_template, new_meta_heap}
use grammar.{byte_string_octets}
use @std.meta.{Node}

// ── The source-spelled value ────────────────────────────────────
// A `const` seat is filled from the SOURCE alone, so its value has a
// form that never needs the evaluator: scalars, and aggregates whose
// every part is spelled. That form IS the crossing tree, built here
// once for typing (does it settle?) and lowering (what is it?).

/// The value the source alone spells at `e`, as the crossing tree
/// every compile-time value already travels as. Null the moment a
/// part needs the evaluator — an omitted default, a call, a name.
export fn literal_meta(
    store: SyntaxArena,
    decls: Decls,
    facts: TypeFacts,
    e: ExprId,
    mut heap: MetaHeap,
) -> MetaVal? {
    let raw: Expr = store.expr(e)
    let n: int? = raw.int_of()
    if n != null { return MetaVal.Int(n!) }
    let bits: int? = raw.bits_of()
    if bits != null { return MetaVal.Float(bits!) }
    let t: string? = raw.text_of()
    if t != null { return MetaVal.Text(t!) }
    let b: bool? = raw.bool_of()
    if b != null { return MetaVal.Bool(b!) }
    match raw {
        .NullLit -> MetaVal.Absent,
        .ListLit(elems) -> {
            let slots? = spelled_all(store, decls, facts, elems, heap) else { return null }
            heap.node(slots)
        },
        .MapLit(keys, values) -> literal_map(store, decls, facts, keys, values, heap),
        .StructLit(_, fields, values) -> literal_record(store, decls, facts, e, [t.of for t in fields], values, heap),
        .VariantLit(name, args) -> literal_variant(store, decls, facts, e, name.of, args, heap),
        .BytesLit(spelled) -> match byte_string_octets(spelled) { .Ok(xs) -> MetaVal.Octets(xs), .Err(_) -> null },
        rest -> null,
    }
}

/// Every element spelled, in order — null when any one is not.
fn spelled_all(
    store: SyntaxArena,
    decls: Decls,
    facts: TypeFacts,
    es: List<ExprId>,
    mut heap: MetaHeap,
) -> List<MetaVal>? {
    mut out: List<MetaVal> = []
    for e in es {
        let v? = literal_meta(store, decls, facts, e, heap) else { return null }
        out.push(v)
    }
    out
}

/// A map literal's ordered key/value rows — keys are text, always.
fn literal_map(
    store: SyntaxArena,
    decls: Decls,
    facts: TypeFacts,
    keys: List<ExprId>,
    values: List<ExprId>,
    mut heap: MetaHeap,
) -> MetaVal? {
    mut ks: List<string> = []
    mut vs: List<MetaVal> = []
    for j, k in keys {
        let kv? = literal_meta(store, decls, facts, k, heap) else { return null }
        let key? = match kv { .Text(s) -> s, rest -> null } else { return null }
        let vv? = literal_meta(store, decls, facts, values[j], heap) else { return null }
        ks.push(key)
        vs.push(vv)
    }
    heap.map(ks, vs)
}

/// A record literal, slots in DECLARATION order. Every field must be
/// written: an omitted one carries a default, and a default is a body
/// the evaluator runs — not something the source alone spells.
fn literal_record(
    store: SyntaxArena,
    decls: Decls,
    facts: TypeFacts,
    e: ExprId,
    fields: List<string>,
    values: List<ExprId>,
    mut heap: MetaHeap,
) -> MetaVal? {
    let ty = facts.type_at(e)
    decls.declared_first(ty)
    let s? = decls.fields_of_type(ty) else { return null }
    if fields.length != s.names.length { return null }
    mut by_slot: List<MetaVal?> = filled<MetaVal?>(s.names.length, null)
    for j, f in fields {
        let slot? = s.slot_of(f) else { return null }
        let v? = literal_meta(store, decls, facts, values[j], heap) else { return null }
        by_slot.set(slot, v)
    }
    mut slots: List<MetaVal> = []
    for x in by_slot {
        if x == null { return null }
        slots.push(x!)
    }
    // A FLAT record of one field travels as that field — the crossing
    // shape `materialized` rebuilds a Pack from; a value record as its
    // fields.
    if decls.types.is_flat(ty) && !decls.types.is_wide(ty) { return slots[0] }
    if decls.types.is_wide(ty) { return heap.node(slots) }
    // a BOXED record crosses as its slots: a value-record field's own
    // fields laid inline, as the box holds them
    heap.node(flatten([inline_slots(s.types[j], x, decls.types, heap) for j, x in slots]))
}

/// A field's crossing value as the slots a box lays it in: a value
/// record's fields, or the value itself.
fn inline_slots(ty: TypeId, v: MetaVal, types: TypeRegistry, heap: MetaHeap) -> List<MetaVal> {
    if types.valued_carrier(ty) { return valued_slots(v, heap) }
    if types.lays_inline(ty) { return heap.slots(v) }
    [v]
}

/// A value enum's two slots: its tag and its word — the absent tag for
/// a nullable's absence, a zero word for a variant carrying nothing.
fn valued_slots(v: MetaVal, heap: MetaHeap) -> List<MetaVal> {
    if v is .Absent || v is .Gone { return [MetaVal.Int(absent_tag), MetaVal.Int(0)] }
    let s = heap.slots(v)
    if s.length >= 2 { return s.slice(0, 2) }
    s.concat([MetaVal.Int(0)])
}

/// A variant literal: the tag first, the payloads after — the tagged
/// slot array both engines already read.
fn literal_variant(
    store: SyntaxArena,
    decls: Decls,
    facts: TypeFacts,
    e: ExprId,
    name: string,
    args: List<ExprId>,
    mut heap: MetaHeap,
) -> MetaVal? {
    let sig? = decls.variants_of_type(facts.type_at(e)) else { return null }
    let tag: int = sig.names.index_of(name)
    if tag < 0 { return null }
    let payloads? = spelled_all(store, decls, facts, args, heap) else { return null }
    // an enum whose variants carry nothing crosses as its tag, a word
    if decls.types.is_flat(facts.type_at(e)) { return MetaVal.Int(tag) }
    // a value-record payload crosses as its slots, as the box holds it
    let carried = sig.payloads[tag]
    heap
        .node(
            [MetaVal.Int(tag)]
                .concat(flatten([inline_slots(carried[j], x, decls.types, heap) for j, x in payloads])),
        )
}

/// A hole-less quote as the crossing tree — a `Template` naming this
/// file and the quote's offset, with nothing to fill. Null for
/// anything else, a quote with holes included: a hole is a body the
/// evaluator runs, and null for a program that loads no `@std/meta`,
/// where a template has no type to be.
export fn quote_meta(store: SyntaxArena, decls: Decls, path: string, e: ExprId, mut heap: MetaHeap) -> MetaVal? {
    let held: BodyParts? = store.expr(e).body_of()
    if held == null || !held!.holes.is_empty() { return null }
    if decls.meta_named("Node") == null { return null }
    let at: int = store.expr_span(e)?.lo ?? 0
    meta_of_template(Node.Template(path, at, held!.parts, []), heap)
}

// ── The slot array, behind its verbs ────────────────────────────
// Every aggregate — a struct, an enum's box, a list, a dyn box, a
// fn box — is ONE runtime shape: the slot array. These verbs are
// the only spellings of its runtime names; a consumer that pushes
// or reads a lane says so in a word.

/// A fresh box, its slots pushed in order. `dst` is minted by the
/// caller, before the first instruction is emitted — registers are
/// numbered in emission order.
use features.{MethodCall}

impl LowerCx {
    /// A value that crossed out of the compile-time evaluator, as a
    /// REGISTER under its static type: a scalar pair packed here, every
    /// other value one slot of the static fold — a word emitted, or the
    /// address of data laid out under `name`. This is the ONE outbound
    /// value codec for consts and settled seats.
    mut fn materialized(v: MetaVal, heap: MetaHeap, ty: TypeId, name: string) -> Reg {
        if self.pair_shaped(ty) { return self.meta_pair(v, heap, ty, name) }
        if self.view.types.travels_wide(ty) { return self.wide_crossed(v, heap, ty, name) }
        mut build = self.static_build()
        let slot? = build.slot_of(v, heap, ty) else { return self.meta_defect(ty) }
        self.crossed_reg(slot, ty, name, build.boxes)
    }

    /// An empty static fold over this program's declarations.
    fn static_build() -> StaticBuild { StaticBuild { decls: self.view.decls } }

    /// A literal the source alone spells, as the binary's own data: an
    /// address, no box made and no count owed. Null for a scalar, a
    /// map, a type still open, or a part the run must compute.
    mut fn spelled_static(e: ExprId) -> Reg? {
        let ty = self.facts.type_at(e)
        if !self.view.types.rides_pointer(ty) ||
            self.view.types.shape_of(ty) is .Map ||
            !same_type(self.concrete(ty), ty) {
            return null
        }
        mut heap = new_meta_heap()
        let v? = literal_meta(self.view.store, self.view.decls, self.facts, e, heap) else { return null }
        mut build = self.static_build()
        let slot? = build.slot_of(v, heap, ty) else { return null }
        if !(slot is .Box) { return null }
        let r = self.mint_ty(ty)
        self.static_read(r, "lit\$${self.view.file.index}\$${e.index}", build.boxes)
        r
    }

    /// A scalar nullable lives in registers as its flag beside its
    /// value — the one crossing shape that is not a slot.
    fn pair_shaped(ty: TypeId) -> bool {
        self.view.types.shape_of(ty) is .Opt && self.repr_of(ty) is .Pair
    }

    /// A value record lives in registers: each field crosses as its
    /// own register, and the record is their pack.
    mut fn wide_crossed(v: MetaVal, heap: MetaHeap, ty: TypeId, name: string) -> Reg {
        if self.valued(ty) {
            return self
                .named_over(ty, self.valued_crossed(v, heap, self.view.types.machine_type(ty), name))
        }
        if !self.view.types.is_wide(ty) {
            return self
                .pack(ty, [self.materialized(v, heap, self.view.types.flat_fields(ty)[0], name)])
        }
        let slots = heap.slots(v)
        let fields = self.view.types.flat_fields(ty)
        if slots.length != fields.length { return self.meta_defect(ty) }
        self.pack(ty, [self.materialized(slots[j], heap, f, name) for j, f in fields])
    }

    /// A value enum crossed as its tag and the word its variant carries.
    mut fn valued_crossed(v: MetaVal, heap: MetaHeap, ty: TypeId, name: string) -> Reg {
        if v is .Absent || v is .Gone { return self.pack(ty, [self.const_int(absent_tag), self.const_int(0)]) }
        let inner: TypeId? = self.view.types.carried(ty)
        if inner != null { return self.valued_crossed(v, heap, self.view.types.machine_type(inner!), name) }
        let slots = heap.slots(v)
        let head? = slots.first() else { return self.meta_defect(ty) }
        let tag? = match head { .Int(n) -> n, rest -> null } else { return self.meta_defect(ty) }
        let sig? = self.variants_of(ty) else { return self.meta_defect(ty) }
        let carried = sig.payloads[tag]
        if carried.is_empty() || slots.length < 2 { return self.pack(ty, [self.const_int(tag), self.const_int(0)]) }
        self.pack(ty, [self.const_int(tag), self.materialized(slots[1], heap, carried[0], name)])
    }

    mut fn meta_pair(v: MetaVal, heap: MetaHeap, ty: TypeId, name: string) -> Reg {
        if v is .Absent { return self.absent_of(ty) }
        let slots = heap.slots(v)
        if slots.length != 2 { return self.meta_defect(ty) }
        match slots[0] {
            .Bool(false) -> self.absent_of(ty),
            .Bool(true) -> self.adopted(ty, false, self.materialized(slots[1], heap, self.carried_type(ty), name)),
            rest -> self.meta_defect(ty),
        }
    }

    /// A slot as a register of `ty`: a word is its constant, a box the
    /// address of the static its boxes make.
    // LICENSED — every arm answers the same minted register — six branches, one identity
    mut fn crossed_reg(c: Slot, ty: TypeId, name: string, boxes: List<StaticBox>) -> Reg {
        let r = self.mint_ty(ty)
        match c {
            .Int(n) -> self.emit(Ins.ConstInt(r, n)),
            .Float(bits) -> self.emit(Ins.ConstFloat(r, bits)),
            .Bool(b) -> self.emit(Ins.ConstBool(r, b)),
            .Text(s) -> self.emit(Ins.ConstStr(r, s)),
            .Null -> self.emit(Ins.ConstInt(r, 0)),
            .Box(_) -> self.static_read(r, name, boxes),
            // a whole nullable scalar is a pair, built by `meta_pair`
            .Absent -> self.defect("an absent scalar reached a register whole — `meta_pair` builds the pair"),
            // no crossing value is a fn — `static_fn_box` lays this slot out directly
            .Code(_) -> self.defect("a code address reached the meta-value crossing, which builds none"),
        }
        r
    }

    mut fn meta_defect(ty: TypeId) -> Reg {
        self.defect("a compile-time value did not cross as `${self.view.types.name_of(ty)}`")
        self.hollow_of(ty)
    }

    /// The slots a box will hold, as a register — minted BEFORE the box
    /// it sizes, so the box's register is minted last. Zero is a
    /// builder's box: it grows.
    mut fn box_size(n: int) -> Reg {
        self.const_int(n)
    }

    /// A box of slots — a list, a cell, a one-slot adoption, a table.
    /// NEVER A RECORD: a record's layout is its type's (a flat record
    /// travels as its one field, a value field lies inline), which only
    /// `packed_struct` knows — a record boxed here reads back as
    /// something else, so asking is a defect said at the door.
    mut fn grown_box(sh: Type, size: Reg, slots: List<Reg>) -> Reg {
        if self.is_record_shape(sh) { self.defect("a record is built by `packed_struct`, never slot by slot") }
        let dst = self.array_sized(sh, size)
        for r in slots { self.push_slot(dst, r) }
        dst
    }

    /// A value's TEXT register, by its shape: a string as it is, a
    /// scalar spelled by the runtime. Only the scalars and strings
    /// pass the hole laws; every other arm stands on the raw register.
    mut fn texted(h: ExprId) -> Reg {
        let v = self.reg_of(h)
        match self.seen_at(h) {
            .Str -> v,
            .Int -> self.int_text(Type.Str, v),
            .Float -> self.float_text(Type.Str, v),
            .Bool -> self.bool_text(Type.Str, v),
            .Ptr or .Bytes or .List(_) or .Cell(_) or .Task(_) or .Tasks or .Struct(_, _) or .Enum(_, _) or .Res(_, _) or .App(_, _, _) or .TypeName(_, _) or .Var(_, _, _) or .Dyn(_, _) or .Fn(_, _, _) or .Opt(_) or .Null or .EmptyList or .Error or .Void or .Map(_, _) or .EmptyMap or .Union(_) or .Range -> v,
        }
    }

    /// One more slot. A nullable scalar is its word and its presence —
    /// the runtime keeps absence in the cell's mark, so no box.
    mut fn push_slot(box: Reg, v: Reg) {
        let ty = self.out.type_of_reg(v)
        if !self.scalar_nullable(ty) { return self.array_push(box, v) }
        self
            .array_push_maybe(
                box,
                self.presence_of(v, ty),
                self.extracted(v, 1, self.mint_ty(self.carried_type(ty))),
            )
    }

    /// A LEAF laid into a record's or a payload's box: a value enum as
    /// its tag and its word, the word owned when its variant carries a
    /// pointer; anything else one slot.
    mut fn push_leaf(box: Reg, v: Reg) {
        let ty = self.out.type_of_reg(v)
        if !self.valued(ty) { return self.push_slot(box, v) }
        let tag = self.extracted(v, 0, self.mint_shape(Type.Int))
        self.array_push(box, tag)
        self
            .array_push_tagged(
                box,
                self.extracted(v, 1, self.mint_shape(Type.Int)),
                tag,
                self.const_int(self.view.types.counted_mask(ty)),
            )
    }

    /// A leaf written over a record's slots from `at` — `push_leaf`'s
    /// write.
    mut fn leaf_write(box: Reg, at: int, v: Reg) {
        let ty = self.out.type_of_reg(v)
        if !self.valued(ty) { return self.slot_write(box, self.const_int(at), v) }
        let tag = self.extracted(v, 0, self.mint_shape(Type.Int))
        self.slot_set(box, self.const_int(at), tag)
        self
            .slot_set_tagged(
                box,
                self.const_int(at + 1),
                self.extracted(v, 1, self.mint_shape(Type.Int)),
                tag,
                self.const_int(self.view.types.counted_mask(ty)),
            )
    }

    /// `v` written into the slot at `at` — a nullable scalar with its
    /// presence, like `push_slot`.
    mut fn slot_write(box: Reg, at: Reg, v: Reg) {
        let ty = self.out.type_of_reg(v)
        if !self.scalar_nullable(ty) { return self.slot_set(box, at, v) }
        self
            .slot_set_maybe(
                box,
                at,
                self.presence_of(v, ty),
                self.extracted(v, 1, self.mint_ty(self.carried_type(ty))),
            )
    }

    /// `v` under key `k` — a nullable scalar with its presence.
    mut fn map_write(m: Reg, k: Reg, v: Reg) {
        let ty = self.out.type_of_reg(v)
        if !self.scalar_nullable(ty) { return self.map_set(m, k, v) }
        self
            .map_set_maybe(
                m,
                k,
                self.presence_of(v, ty),
                self.extracted(v, 1, self.mint_ty(self.carried_type(ty))),
            )
    }

    /// The last slot, removed, as a value of `ty` — a nullable scalar's
    /// presence read before its word leaves.
    mut fn popped(box: Reg, ty: TypeId) -> Reg {
        if !self.scalar_nullable(ty) { return self.array_pop(self.view.types.shape_of(ty), box) }
        let present = self.array_last_present(Type.Bool, box)
        let word = self.array_pop(self.view.types.shape_of(self.carried_type(ty)), box)
        self.pack(ty, [present, word])
    }

    /// The value in a slot `map_slot` named, read as a value of `ty`.
    mut fn map_value(m: Reg, slot: Reg, ty: TypeId) -> Reg {
        if !self.scalar_nullable(ty) { return self.map_value_at(self.view.types.shape_of(ty), m, slot) }
        let present = self.map_present_at(Type.Bool, m, slot)
        let value = self.map_value_at(self.view.types.shape_of(self.carried_type(ty)), m, slot)
        self.pack(ty, [present, value])
    }

    /// The slot at a computed index, read as a value of `ty`.
    mut fn elem_read(v: Reg, at: Reg, ty: TypeId) -> Reg {
        if !self.scalar_nullable(ty) { return self.array_get(self.view.types.shape_of(ty), v, at) }
        self.pair_read(v, at, ty)
    }

    /// `v` in a list of its own — empty when `v` is nothing. How a task
    /// answers: one box, whatever the answer's shape.
    mut fn one_cell(v: Reg, ty: TypeId) -> Reg {
        let elem = if self.view.types.shape_of(ty) is .Void { self.type(int) } else { ty }
        let box_ty = self.type(List<elem>)
        let size = self.box_size(1)
        let dst = self.array_sized(self.view.types.shape_of(box_ty), size)
        if !(self.view.types.shape_of(ty) is .Void) { self.push_slot(dst, v) }
        dst
    }

    /// A nullable SCALAR: a pair in registers, a word and a mark in a
    /// slot.
    fn scalar_nullable(ty: TypeId) -> bool {
        self.view.types.seen_shape(ty) is .Opt && self.repr_of(ty) is .Pair
    }

    /// A slot holding a nullable scalar, read back as its pair.
    mut fn pair_read(v: Reg, at: Reg, ty: TypeId) -> Reg {
        let present = self.slot_present(Type.Bool, v, at)
        let value = self.array_get(self.view.types.shape_of(self.carried_type(ty)), v, at)
        self.pack(ty, [present, value])
    }

    /// Equality of two values of one type as a bool register — an enum
    /// by its tag, text and bytes by their runtime rows, every other
    /// scalar by the Eq operator.
    mut fn same_value(a: Reg, b: Reg, ty: TypeId) -> Reg {
        match self.view.types.seen_shape(ty) {
            .Enum(_, _) -> self.same_tag(a, b),
            .Str -> self.streq(Type.Bool, a, b),
            .Bytes -> self.bytes_eq(Type.Bool, a, b),
            .Opt(_) -> self.same_through(a, ty, b, ty),
            .Struct(_, _) -> self.same_field(a, b, ty),
            .Int or .Float or .Bool or .Ptr or .List(_) or .Cell(_) or .Task(_) or .Tasks or .Map(_, _) or .Null or .Res(_, _) or .Var(_, _, _) or .App(_, _, _) or .Dyn(_, _) or .Fn(_, _, _) or .TypeName(_, _) or .EmptyList or .EmptyMap or .Union(_) or .Error or .Void or .Range -> self.bin(Type.Bool, BinOp.Eq, a, b),
        }
    }

    /// A record of ONE field compared by that field, with the field's own
    /// equality, all the way down — typing admitted no other record.
    mut fn same_field(a: Reg, b: Reg, ty: TypeId) -> Reg {
        let sty = self.seen(ty)
        let sig? = self.fields_of(sty) else {
            self.defect("a compared record with no fields survived typing")
            return self.const_bool(false)
        }
        let field = sig.types[0]
        let fa = self.field_read(a, sty, 0, field)
        let fb = self.field_read(b, sty, 0, field)
        self.same_value(fa, fb, field)
    }

    /// EQUALITY THROUGH PRESENCE, `v` the nullable side: both absent,
    /// or both present with the same value — a plain `w` is present.
    mut fn same_through(v: Reg, vt: TypeId, w: Reg, wt: TypeId) -> Reg {
        let inner = self.view.types.carried(vt) ?? vt
        self
            .region_as(self.presence_of(v, vt), self.type(bool)) { cx -> cx.present_same(cx.carried_of(v, vt), w, wt, inner) } else { cx -> cx.absent_same(w, wt) }
    }

    /// A present value against the other side: the same value when
    /// that side is present too, else false.
    mut fn present_same(av: Reg, w: Reg, wt: TypeId, inner: TypeId) -> Reg {
        if self.view.types.carried(wt) == null { return self.same_value(av, w, inner) }
        self
            .region_as(self.presence_of(w, wt), self.type(bool)) { cx -> cx.same_value(av, cx.carried_of(w, wt), inner) } else { cx -> cx.const_bool(false) }
    }

    /// Absence against the other side: equal only to absence.
    mut fn absent_same(w: Reg, wt: TypeId) -> Reg {
        if self.view.types.carried(wt) == null { return self.const_bool(false) }
        self.un(self.presence_of(w, wt))
    }

    /// Two enum values of one type compare by TAG — what a unit enum's
    /// equality means.
    mut fn same_tag(a: Reg, b: Reg) -> Reg {
        self.bin(Type.Bool, BinOp.Eq, self.tag_of(a), self.tag_of(b))
    }

    /// THE TAGGED VALUE: an enum's variant is a slot array holding its
    /// TAG at slot 0 and its payloads, in order, at slots 1... — a
    /// value-record payload laid inline, its fields as slots.
    mut fn tagged_value(sh: Type, tag: int, payloads: List<Reg>) -> Reg {
        // an enum whose variants carry nothing IS its tag
        let ty = self.view.types.intern(sh)
        if self.view.types.is_flat(ty) { return self.pack(ty, [self.const_int(tag)]) }
        // a value enum is its tag and its one word, in registers
        if self.view.types.is_valued(ty) { return self.pack(ty, [self.const_int(tag), payloads.first() ?? self.const_int(0)]) }
        let words = flatten([self.leaves(p) for p in payloads])
        let dst = self.array_sized(sh, self.box_size(1 + self.width_of(words)))
        self.push_slot(dst, self.const_int(tag))
        for w in words { self.push_leaf(dst, w) }
        dst
    }

    /// The TAG a tagged value carries. Slot 0, always an int — asking
    /// here is how a consumer avoids knowing the number.
    mut fn tag_of(v: Reg) -> Reg {
        if self.valued(self.out.type_of_reg(v)) { return self.extracted(self.opened_enum(v), 0, self.mint_shape(Type.Int)) }
        // a name over an enum is read as the enum it stands over
        let own = self.read_as(v, self.seen(self.out.type_of_reg(v)))
        if self.view.types.word_carrier(self.out.type_of_reg(own)) { return self.extracted(own, 0, self.mint_shape(Type.Int)) }
        self.slot_read(own, 0, null)
    }

    /// The PAYLOAD a tagged value carries, as the type it was written
    /// with. Slot 1 — the other half of `tagged_value`'s shape.
    mut fn payload_of(v: Reg, ty: TypeId) -> Reg {
        self.payload_at(v, 0, [ty])
    }

    /// The Kth of a variant's payloads (`carried`) — past the tag and
    /// the widths of the payloads before it.
    mut fn payload_at(v: Reg, k: int, carried: List<TypeId>) -> Reg {
        if self.valued(self.out.type_of_reg(v)) { return self.extracted(self.opened_enum(v), 1, self.mint_ty(carried[k])) }
        let at = 1 + self.view.types.slot_offset(carried, k)
        if self.view.types.lays_inline(carried[k]) { return self.unboxed_at(v, at, carried[k]) }
        self.slot_read(v, at, carried[k])
    }

    /// Whether the value an expression names IS its one field.
    fn flat_at(e: ExprId) -> bool {
        self.view.types.is_flat(self.type_at(e))
    }

    /// A RECORD's field. A flat record IS its one field, so the read is
    /// the record's own register and costs nothing; a boxed record reads
    /// its slot. The subject's STATIC type decides — a register's
    /// recorded type is the wrong witness under mono, where it may still
    /// name a type parameter.
    mut fn field_read(subject: Reg, subject_ty: TypeId, n: int, ty: TypeId?) -> Reg {
        if !self.view.types.is_flat(subject_ty) { return self.boxed_field(subject, subject_ty, n, ty) }
        self
            .extracted(
                self.read_as(subject, subject_ty),
                n,
                if ty == null { self.mint_shape(Type.Int) } else { self.mint_ty(ty!) },
            )
    }

    /// `subject` in a register of the type being read. A READ WEARS THE
    /// TYPE OF WHAT IS READ: a name's register is BARE, so both engines
    /// read its slot 0 as the whole value, and a slot of the record it
    /// stands over must be read from a register of that record. Each
    /// name unwraps by `Extract` at 0 — the register itself, no work.
    mut fn read_as(subject: Reg, read_ty: TypeId) -> Reg {
        let own = self.out.type_of_reg(subject)
        if own == read_ty { return subject }
        let under? = self.view.types.stands_for(own) else { return subject }
        self.read_as(self.extracted(subject, 0, self.mint_ty(under)), read_ty)
    }

    /// A boxed record's Nth field, from its slot OFFSET: a value-record
    /// field before it takes its own width, and a value-record field is
    /// read back from its slots.
    mut fn boxed_field(subject: Reg, subject_ty: TypeId, n: int, ty: TypeId?) -> Reg {
        let at = self.field_offset(subject_ty, n)
        if ty != null && self.view.types.lays_inline(ty!) { return self.unboxed_at(subject, at, ty!) }
        self.proven_read(subject, at, ty)
    }

    /// `v` written as a boxed record's Nth field: at its offset, a value
    /// record's fields each into its own slot.
    mut fn field_written(box: Reg, record: TypeId, n: int, v: Reg) {
        let base = self.field_offset(record, n)
        mut at = base
        for r in self.leaves(v) {
            self.leaf_write(box, at, r)
            at = at + self.view.types.slot_width(self.out.type_of_reg(r))
        }
    }

    /// Where a boxed record's Nth field starts.
    fn field_offset(record: TypeId, n: int) -> int {
        let sig? = self.view.decls.fields_of_type(record) else { return n }
        self.view.types.slot_offset(sig.types, n)
    }

    /// A RECORD's field, by NAME — the slot asked once, never
    /// assumed. The declaration already promised this field, so
    /// absence here is a DEFECT the compiler's own type moved under
    /// this lowering, never a plausible default: it speaks and
    /// answers a fresh register of the field's own type.
    mut fn field_named(v: Reg, vty: TypeId, name: string, field_ty: TypeId) -> Reg {
        let slot? = self.view.decls.fields_of_type(vty)?.slot_of(name) else { return self.field_missing(vty, name, field_ty) }
        self.field_read(v, vty, slot, field_ty)
    }

    mut fn field_missing(vty: TypeId, name: string, field_ty: TypeId) -> Reg {
        self
            .defect(
                "`${self.view.types.name_of(vty)}` has no field `${name}` — the compiler's own struct moved under this lowering",
            )
        self.hollow_of(field_ty)
    }

    /// One slot read: the index is a constant, so it is minted and
    /// emitted BEFORE the read that uses it — registers are numbered in
    /// emission order. An absent type reads as an int.
    mut fn slot_read(v: Reg, n: int, ty: TypeId?) -> Reg {
        let at = self.const_int(n)
        let held? = ty else { return self.array_get(Type.Int, v, at) }
        self.elem_read(v, at, held)
    }

    /// A slot the box's own type PROVES — a declared field, a cell's one
    /// slot — read with no bounds test. A nullable scalar's pair keeps
    /// the checked read.
    mut fn proven_read(v: Reg, n: int, ty: TypeId?) -> Reg {
        if ty != null && self.scalar_nullable(ty!) { return self.slot_read(v, n, ty) }
        let at = self.const_int(n)
        self.slot_get(if ty == null { Type.Int } else { self.view.types.shape_of(ty!) }, v, at)
    }

    // ── The Result, behind its verbs ────────────────────────────────
    // The built-in enum rides the tagged value above: tag 0 = Ok,
    // tag 1 = Err, the live side at slot 1. An `.Err` box is therefore
    // a valid `.Err` of EVERY `Result<_, E>` — propagation moves the
    // pointer and repacks nothing. (ROADMAP: the error spine.)
    /// A success, wrapped — the auto-Ok lift's mint.
    mut fn okayed(into: TypeId, r: Reg) -> Reg {
        self.tagged_value(self.view.types.shape_of(into), 0, [r])
    }

    /// A failure, wrapped — what `fail` exits with.
    mut fn failed(into: TypeId, r: Reg) -> Reg {
        self.tagged_value(self.view.types.shape_of(into), 1, [r])
    }

    /// A FAILURE LEAVING under the enclosing fn's own Result: the value
    /// itself when both Results are laid out alike — a box moves by its
    /// pointer, a value's Err tag and word mean the same — else its
    /// error wrapped again in the fn's layout. TWO RESULTS AGREE ON
    /// THEIR ERR SIDE'S BITS when the types are identical, or when
    /// BOTH are unions: a union box's discriminant is the live
    /// member's own global type id, so which union claims it never
    /// changes what the box holds — a narrower union widens into a
    /// wider one by pointer move, same as a plain box does today. A
    /// PLAIN member and a UNION are the real mismatch, in both
    /// directions: a plain member has no discriminant of its own, so
    /// meeting a union promise it is LIFTED into the union's tagged
    /// box; a union meeting a plain promise — a selective `catch`
    /// whose remainder is one member — hands over the member its box
    /// holds.
    mut fn propagated(r: Reg) -> Reg {
        let ret? = self.enclosing_ret() else { return r }
        let into = self.concrete(ret)
        let from = self.out.type_of_reg(r)
        let fsides? = self.view.types.res_parts(from) else { return r }
        let isides? = self.view.types.res_parts(into) else { return r }
        let was_union = self.view.types.shape_of(fsides.err) is .Union
        let agrees = same_type(fsides.err, isides.err) ||
            was_union && self.view.types.shape_of(isides.err) is .Union
        if agrees && self.valued(from) == self.valued(into) { return r }
        let payload = self.payload_of(r, fsides.err)
        if agrees { return self.failed(into, payload) }
        self
            .failed(
                into,
                if was_union { self.payload_of(payload, isides.err) } else { self.union_boxed(isides.err, payload) },
            )
    }

    /// The union lift: a member value tagged into its union's own
    /// box — the tag is the member's own GLOBAL type id, which is
    /// what a `catch` (or a wider union) reads back regardless of
    /// which union claims it. A value already union-shaped arrives
    /// through unchanged — a narrower union widening into a wider
    /// one needs no repack, by the same law.
    mut fn union_boxed(into: TypeId, r: Reg) -> Reg {
        let from = self.out.type_of_reg(r)
        if self.view.types.shape_of(from) is .Union { return r }
        self.tagged_value(self.view.types.shape_of(into), from.index, [r])
    }

    /// Is the result an ANSWER — its tag read against Ok's, as an i1.
    mut fn okness_of(v: Reg) -> Reg {
        self.bin(Type.Bool, BinOp.Eq, self.tag_of(v), self.const_int(0))
    }

    // ── The fn value, behind its verbs ──────────────────────────────
    // A closure or boxed fn is a slot array: the CODE ADDRESS at slot
    // 0, captures after. Every call rides CallPtr with the box at seat
    // 0 — the env is `self` by another name. The lanes are this
    // file's business alone. A box with no captures holds nothing a
    // caller could vary, so it is laid out ONCE, as static data —
    // `static_fn_box` — never rebuilt per read.
    /// The box, minted: the code address first, the captures in lane
    /// order — the lifted body reads them back by `capture_lane`.
    mut fn fn_box(sh: Type, size: Reg, sym: string, caps: List<Reg>) -> Reg {
        let dst = self.array_sized(sh, size)
        let ad = self.mint_shape(Type.Int)
        self.emit(Ins.FnAddr(ad, sym))
        self.push_slot(dst, ad)
        for r in caps { self.push_slot(dst, r) }
        dst
    }

    /// A CAPTURE-FREE box: the code address alone, laid out once as
    /// immortal static data (CLAUDE.md "A SETTLED AGGREGATE IS STATIC
    /// DATA") — every use reads the same address, no allocation and
    /// no count owed. A lambda with captures keeps `fn_box`'s box,
    /// since each evaluation's captures differ; a bare symbol never
    /// varies, so a NAMED fn used as a value takes this path always.
    mut fn static_fn_box(sh: Type, sym: string) -> Reg {
        let r = self.mint_shape(sh)
        self.static_read(r, "fn\$${sym}", [StaticBox.Slots([Slot.Code(sym)])])
        r
    }

    /// The call THROUGH a box: slot 0 is the code, the box rides seat
    /// 0, and the arguments follow. The answer register mints LAST —
    /// registers are numbered in emission order.
    mut fn called_through(e: ExprId, box: Reg, args: List<Reg>) -> Reg {
        self.call_ptr_at(e, self.slot_read(box, 0, null), [box].concat(args))
    }

    /// The representation of a nullable TYPE — a projection, and the
    /// catch-all is honest: a non-`Opt` shape is the absorbing error
    /// path, which lowers nothing, so the pair it names is never built.
    fn repr_of(opt: TypeId) -> Repr {
        // A NAME over a nullable IS that nullable — the layout is the
        // shape's, so the read door answers here too.
        match self.view.types.seen_shape(opt) {
            .Opt(inner) -> self.inner_repr(inner),
            _ -> Repr.Pair,
        }
    }

    /// A FLAT record is a machine word with no spare value — index 0 is
    /// a real index — so its nullable cannot be a niche and a pair no
    /// slot holds. It takes a ONE-SLOT BOX, whose null pointer is the
    /// absence: slot-worthy, and sound for every value the field can
    /// take. The registry decides, not the bare shape: `rides_pointer`
    /// sees through an `Opt` to what it carries where `ptr_shape` cannot,
    /// and the machine type asks the same question (`opt_rides_pointer`).
    /// The two answers must never disagree — they are the same layout.
    fn inner_repr(inner: TypeId) -> Repr { inner_repr_of(self.view.types, inner) }

    /// What a nullable type carries — the `Opt`'s inner, with the
    /// catch-all pinned to the asker's own type on the error path.
    fn carried_type(opt: TypeId) -> TypeId {
        match self.view.types.seen_shape(opt) { .Opt(inner) -> inner, _ -> opt }
    }

    /// Is the value THERE — an i1: the niche compares itself against
    /// the null constant, the pair already CARRIES its answer.
    mut fn presence_of(v: Reg, opt: TypeId) -> Reg {
        match self.repr_of(opt) {
            .Niche or .Boxed -> self.nonzero(v, self.zeroed(self.mint_ty(opt))),
            .Pair -> self.extracted(v, 0, self.mint_shape(Type.Bool)),
            .Tagged -> self
                .bin(
                    Type.Bool,
                    BinOp.Ne,
                    self.extracted(v, 0, self.mint_shape(Type.Int)),
                    self.const_int(absent_tag),
                ),
        }
    }

    /// Whether a shape is a RECORD's, declared or applied — never a
    /// named type's, which travels as the shape it names.
    fn is_record_shape(sh: Type) -> bool {
        match sh {
            .Struct(d, _) or .App(d, _, _) -> self.view.decls.decl(d).kind is .Record,
            _ -> false,
        }
    }

    /// A value PACKED into the expression's own register.
    mut fn packed(e: ExprId, parts: List<Reg>) -> Reg {
        self.packed_struct(self.type_at(e), parts)
    }

    /// A struct's fields, already resolved in slot order, packed
    /// into ITS OWN representation: a FLAT (one-field) record is one
    /// `Ins.Pack`, which each engine renders as identity — which is
    /// how a NAMED TYPE costs nothing; any other struct is a slot
    /// array, one push per field. The ONE construction every struct
    /// literal, `with`, and a feature packing a struct of its own
    /// (quote/lower.av's `Code`) shares.
    mut fn packed_struct(ty: TypeId, parts: List<Reg>) -> Reg {
        if self.view.types.is_flat(ty) { return self.pack(ty, parts) }
        // a value-record field is laid INLINE, its fields as slots
        let words = flatten([self.leaves(r) for r in parts])
        let dst = self
            .array_sized(self.view.types.shape_of(ty), self.box_size(self.width_of(words)))
        for r in words { self.push_leaf(dst, r) }
        dst
    }

    /// The slots these leaves take in a box: a value enum's two, one
    /// for every other.
    fn width_of(words: List<Reg>) -> int {
        mut n = 0
        for w in words { n = n + self.view.types.slot_width(self.out.type_of_reg(w)) }
        n
    }

    /// One element of a packed value, into a caller-typed register.
    mut fn extracted(v: Reg, at: int, dst: Reg) -> Reg {
        self.emit(Ins.Extract(dst, v, at))
        dst
    }

    /// The zero of the register's own type, emitted — the null pointer
    /// for pointer shapes, the absent tag for ints.
    mut fn zeroed(z: Reg) -> Reg {
        self.emit(Ins.ConstInt(z, 0))
        z
    }

    /// `a != z`, as an i1.
    mut fn nonzero(a: Reg, z: Reg) -> Reg {
        self.bin(Type.Bool, BinOp.Ne, a, z)
    }

    /// What the nullable CARRIES, once presence is settled: a niche
    /// nullable IS its value — identity, no instruction — and a pair
    /// holds it beside the flag.
    mut fn carried_of(v: Reg, opt: TypeId) -> Reg {
        match self.repr_of(opt) {
            .Niche or .Tagged -> v,
            .Boxed -> self.boxed_carried(v, self.carried_type(opt)),
            .Pair -> self.extracted(v, 1, self.mint_ty(self.carried_type(opt))),
        }
    }

    /// A BOXED nullable's value: the one slot of its one-slot box.
    mut fn boxed_carried(v: Reg, ty: TypeId) -> Reg {
        self.slot_read(v, 0, ty)
    }

    /// A value ADOPTED by a nullable — the widening edge's runtime
    /// form, and the ONE place absence takes a layout: `from_null`
    /// marks the null literal, which arrives already absent (a null
    /// constant). A niche adoption is IDENTITY both ways — the pointer
    /// is the nullable, the null constant is the absence — so widening
    /// a pointer costs nothing.
    mut fn adopted(into: TypeId, from_null: bool, r: Reg) -> Reg {
        match self.repr_of(into) {
            .Niche -> r,
            .Tagged -> if from_null { self.absent_of(into) } else { r },
            .Boxed -> self.boxed_adoption(into, from_null, r),
            .Pair -> self.pair_adoption(into, from_null, r),
        }
    }

    /// A flat value adopted: absence is the null pointer, presence a
    /// one-slot box holding it.
    mut fn boxed_adoption(into: TypeId, from_null: bool, r: Reg) -> Reg {
        if from_null { return self.absent_of(into) }
        let size = self.box_size(1)
        self.grown_box(self.view.types.shape_of(into), size, [r])
    }

    mut fn pair_adoption(into: TypeId, from_null: bool, r: Reg) -> Reg {
        if from_null { return self.absent_of(into) }
        self.flagged_pair(into, true, r)
    }

    /// ONE region on PRESENCE — the shape every consumer of absence
    /// opens: the present arm's value, then the absent arm's, merged
    /// into the node's register. Thunks keep each arm's instructions
    /// INSIDE its brackets, which is what makes the absent side lazy.
    /// A region on PRESENCE opens here; the present arm's register is
    /// given by `present_arm`, the absent arm's by `close_presence`,
    /// which mints the region's answer. Spelled at the site so each
    /// arm's instructions land between the brackets.
    /// A presence region: the arm taken when `v` is present, then the
    /// absent arm — `arm_end` and `close_region` finish it.
    mut fn open_presence(v: Reg, held: TypeId) {
        self.open_region(self.presence_of(v, held))
    }

    /// A region on PRESENCE as the node's value, in one expression:
    /// `present` receives what `v` carries, `absent` answers the
    /// other arm.
    mut fn presence(
        v: Reg,
        held: TypeId,
        e: ExprId,
        present: fn(mut LowerCx, Reg) -> Reg,
        absent: fn(mut LowerCx) -> Reg,
    ) -> Reg {
        self.open_presence(v, held)
        self.arm_end(present(self, self.carried_of(v, held)))
        self.close_region(e, absent(self))
    }

    /// The ABSENT value of a nullable type, minted fresh — the niche's
    /// null constant, or the pair whose flag says no.
    mut fn absent_of(opt: TypeId) -> Reg {
        match self.repr_of(opt) {
            .Niche or .Boxed -> self.zeroed(self.mint_ty(opt)),
            .Pair -> self.absent_pair(opt),
            .Tagged -> self.absent_tagged(opt),
        }
    }

    /// A TAGGED nullable's absence: the spare tag alone for a WORD
    /// ENUM — its tag is its whole value, so absence takes the one
    /// register it already has — the spare tag beside a filler word
    /// for a VALUE ENUM, whose payload rides a second register.
    mut fn absent_tagged(opt: TypeId) -> Reg {
        if self.view.types.is_word_enum(self.carried_type(opt)) { return self.pack(opt, [self.const_int(absent_tag)]) }
        self.pack(opt, [self.const_int(absent_tag), self.const_int(0)])
    }

    mut fn absent_pair(opt: TypeId) -> Reg {
        self.flagged_pair(opt, false, self.hollow_of(self.carried_type(opt)))
    }

    /// A pair packed under its flag — the ONE builder the present and
    /// absent forms share.
    mut fn flagged_pair(opt: TypeId, present: bool, payload: Reg) -> Reg {
        self.pack(opt, [self.const_bool(present), payload])
    }

    /// AN ARM'S YIELD: the register the arm built — or, when the arm
    /// LEFT the fn, a hollow of the region's own type. Nothing reads a
    /// departed arm's value (the exit already happened), and the merge
    /// stays one type across every arm.
    mut fn arm_yield(value: ExprId, r: Reg, want: TypeId) -> Reg {
        if self.view.store.leaves(value) { return self.hollow_of(want) }
        r
    }

    /// A slot of a type that will NEVER be read, but must be total:
    /// the type's zero. An absent pair's payload rides one, and so
    /// does the yield of an arm that already EXITED the fn.
    mut fn hollow_of(inner: TypeId) -> Reg {
        // a value record's hollow is its fields' hollows, packed — and a
        // name over one wears that pack
        if self.valued(inner) {
            return self
                .named_over(
                    inner,
                    self
                        .pack(
                            self.view.types.machine_type(inner),
                            [self.const_int(absent_tag), self.const_int(0)],
                        ),
                )
        }
        // a nullable's hollow is its absence, in its own layout
        if nullable(self.view.types.seen_shape(inner)) { return self.absent_of(inner) }
        if self.view.types.travels_wide(inner) { return self.pack(inner, [self.hollow_of(f) for f in self.view.types.flat_fields(inner)]) }
        if self.view.types.seen_shape(inner) is .Bool {
            // LICENSED — `inner` may be a NAMED bool type — neither the fixed-shape nor the node-tied verb fits
            let z = self.mint_ty(inner)
            self.emit(Ins.ConstBool(z, false))
            return z
        }
        if self.view.types.seen_shape(inner) is .Float {
            // LICENSED — as above — `zeroed`'s ConstInt wears the wrong machine shape for a float register
            let z = self.mint_ty(inner)
            self.emit(Ins.ConstFloat(z, 0))
            return z
        }
        self.zeroed(self.mint_ty(inner))
    }

    /// `v!` — the carried value, with the runtime insisting the value
    /// is PRESENT. Each repr asks its own runtime word; both refuse in
    /// the same words, and the check cannot be elided — absence is
    /// exactly what the writer claimed would not happen. The mint
    /// wears `opt`'s own carried type, never a caller-supplied node's
    /// — a read wears the type of what is read, not of whatever
    /// expression happened to be in hand.
    mut fn insisted(v: Reg, opt: TypeId) -> Reg {
        match self.repr_of(opt) {
            .Niche -> self.insisted_niche(v, opt),
            // the BOX is what must be present; its slot is read after
            .Boxed -> self.insisted_boxed(v, opt),
            .Pair -> self.insisted_pair(v, opt),
            .Tagged -> self.insisted_tagged(v, opt),
        }
    }

    /// A value enum's nullable insisted on: the tag is what must be
    /// present, and the value is the same registers.
    mut fn insisted_tagged(v: Reg, opt: TypeId) -> Reg {
        let _ = self
            .insist_scalar(Type.Int, self.presence_of(v, opt), self.extracted(v, 0, self.mint_shape(Type.Int)))
        v
    }

    /// A BOXED nullable insisted on: the BOX is what must be present,
    /// so its register wears the NULLABLE — the memory pass owns and
    /// releases what `avra_insist` hands back — and the one slot is read
    /// after. A register that wore the CARRIED type would be unmanaged,
    /// and the box would never be released.
    mut fn insisted_boxed(v: Reg, opt: TypeId) -> Reg {
        let box = self.insist(self.view.types.shape_of(opt), v)
        self.boxed_carried(box, self.carried_type(opt))
    }

    /// A NICHE nullable insisted on: a counted box comes back OWNED
    /// through `avra_insist`, and a foreign pointer — no header, so
    /// nothing to count — is its own register past a null test, never
    /// retained.
    mut fn insisted_niche(v: Reg, opt: TypeId) -> Reg {
        let carried = self.carried_type(opt)
        if is_managed(self.view.types, carried) { return self.insist(self.view.types.shape_of(carried), v) }
        let _ = self.insist_scalar(Type.Int, self.presence_of(v, opt), self.const_int(0))
        v
    }

    mut fn insisted_pair(v: Reg, opt: TypeId) -> Reg {
        let flag = self.extracted(v, 0, self.mint_shape(Type.Bool))
        let payload = self.extracted(v, 1, self.mint_ty(self.carried_type(opt)))
        self.insist_scalar(self.view.types.shape_of(self.carried_type(opt)), flag, payload)
    }

    /// An effects-only ARM closes on a throwaway zero — shared with
    /// the statement-if's lowering; every valueless region speaks
    /// these two verbs.
    mut fn void_arm() {
        let td = self.const_int(0)
        self.arm_end(td)
    }

    /// The valueless region's LAST arm and merge — nothing reads dst.
    mut fn void_close() {
        let _ = self.close_region_as(self.type(int), self.const_int(0))
    }
}

/// A capture's slot — lane j lives past the code address.
export fn capture_lane(j: int) -> int {
    1 + j
}

// ── The nullable, behind its verbs ──────────────────────────────
// The surface is ONE (`null`, `??`, `!`, match, `?.`); the layouts
// are two; the seam is here. ROADMAP: the nullable representation.

/// Which layout a nullable takes, decided by what it CARRIES. A
/// How a nullable is laid out. A pointer-shaped value IS its own
/// nullable (the null pointer is absence); a scalar takes a register
/// PAIR beside a flag; and a FLAT record — a machine word that fills
/// its whole range, with no spare value for absence and no slot for a
/// flag — takes a one-slot BOX. That box is the ONE nullable that
/// allocates, and the exception the law "nullability never allocates"
/// carries.
/// Whether a shape is a nullable's.
fn nullable(t: Type) -> bool {
    match t { .Opt(_) -> true, _ -> false }
}

enum Repr {
    Niche
    Pair
    Boxed
    Tagged
}

/// A nullable's inner LAYOUT, decided from the type registry alone —
/// no lowering context needed. `LowerCx.inner_repr` (inside a
/// lowering pass) and `repr_word` below (outside one, for `avra
/// explain repr`) are its two callers; both ask the SAME question.
fn inner_repr_of(types: TypeRegistry, inner: TypeId) -> Repr {
    // a nullable over a nullable: the null pointer is the inner one's
    // absence already, and an encoding never spends one value twice
    if types.seen_shape(inner) is .Opt { return Repr.Pair }
    if types.rides_pointer(inner) { return Repr.Niche }
    // a value enum's absence is its spare tag, so it stays in
    // registers — a WORD ENUM's tag is its whole value, so its spare
    // tag is the SAME register, not a second one
    if types.is_valued(types.machine_type(inner)) || types.is_word_enum(inner) { return Repr.Tagged }
    if types.is_flat(inner) { return Repr.Boxed }
    Repr.Pair
}

/// A value enum's absence: a tag no variant has.
export const absent_tag: int = -1

/// A `Repr`'s own word — the answer's LAST mile, once the layout is decided.
fn nullable_word(r: Repr) -> string {
    match r { .Niche -> "niche", .Boxed -> "one-slot box", .Pair -> "pair", .Tagged -> "tag -1" }
}

/// A declared type's runtime REPRESENTATION, in this file's own
/// words — `avra repr`'s one door in, reachable with no
/// lowering context (P7: a representation the compiler chose is
/// inspectable wherever a tool exists to ask). A nullable answers by
/// what it carries (niche, a one-slot box, or a register pair beside
/// a presence flag); anything else answers by whether it rides a
/// pointer at all (flat, or boxed).
export fn repr_word(types: TypeRegistry, ty: TypeId) -> string {
    match types.seen_shape(ty) {
        .Opt(inner) -> nullable_word(inner_repr_of(types, inner)),
        _ -> if types.rides_pointer(ty) { "boxed" } else { "flat" },
    }
}
