//! The formatter's idioms for this feature — `rule`s, reached by
//! this feature's `mod.av`, the way any declaration is.
use features.{Code, Fix, rule, said}
use @std.meta.{name}

/// A `for` loop whose WHOLE body is one `push` is a MAP — a
/// comprehension, or a `concat` when the pushed list already exists.
/// `${out}.concat([${v} for ${x} in ${xs}])` is sound whether `out`
/// started `[]` or already held content: appending N values one push
/// at a time equals concatenating those same N values at the end,
/// GUARDED to a `v` that never itself reads `out` — a push whose
/// pushed value depends on `out`'s length-so-far (a running index, a
/// running total) is not this shape, and the rewrite refuses it. The
/// matched root is the `for` STATEMENT itself, and a `Fix.Rewrite`'s
/// payload is always `@std.meta.Code` — a single EXPRESSION shape —
/// so the replacement ASSIGNMENT (a statement, not an expression in
/// this language) crosses through `@std/meta`'s raw-text door rather
/// than `quote{}`'s own grammar, the same seam `modified_copy_literal`
/// and `pronoun_lambda` use for a shape `quote{}` cannot hold.
@fixes("for x in xs { out.push(x * 2) }", "out = out.concat([x * 2 for x in xs])")
@keeps("for x in xs { log(x) }")
@keeps("for x in xs { out.push(out.length) }")
@law("pushing a sequence's values one at a time and concatenating that same sequence at the end build the same list")
export rule push_loop {
    // LICENSED loops.push_loop: the pattern's own text names the shape it detects
    quote { for ${x} in ${xs} { ${out}.push(${v}) } } if !v.text().contains(out.text()) -> name("${out.text()} = ${out.text()}.concat([${v.text()} for ${x} in ${xs.text()}])"),
}

/// `push_loop`'s BRANCHED twin: each arm of a per-element `if`/`else`
/// pushes to the SAME accumulator, one shape or the other depending
/// on a condition — `[if ${cond} { a } else { b } for x in xs]` builds
/// the identical list.
///
/// NO REWRITE: the moment either arm is more than a bare name — a
/// computed value, a `with` update — splicing it straight into the
/// comprehension reads WORSE than the loop it replaces (both arms and
/// the `with` crammed onto one line). The sound fix names that logic
/// first, typically an `impl` method on the pushed value's own type
/// (`b.rebound(label, v, acc)`, executor.av) — a judgement call this
/// pattern's bound holes cannot make on their own.
@keeps("for x in xs { if p(x) { out.push(x) } else { log(x) } }")
export rule branched_push_loop {
    quote {
        for ${x} in ${xs} {
            if ${cond} { ${out}.push(${a}) } else { ${out}.push(${b}) }
        }
    } if !cond.text().contains(out.text()) &&
        !a.text().contains(out.text()) &&
        !b.text().contains(out.text()) -> branched_push_loop_found(out, cond, x),
}

fn branched_push_loop_found(out: Code, cond: Code, x: string) -> Fix {
    Fix
        .Say(
            said(
                out.loc(),
                "a per-element branch pushing to `${out.text()}` either way is a conditional map (`[if ${cond.text()} { … } else { … } for ${x} in …]`) — but name any real per-branch logic first, typically an `impl` method on the pushed value's own type; splicing it straight into the comprehension reads worse than this loop",
                "this accumulator",
                null,
            ),
        )
}

/// `for j in 0..xs.length` that then reads `xs[j]` — that walk is
/// `for (j, x) in xs.enumerate()`, which hands over both. The
/// rewrite reads every exact `${xs}[${j}]` inside `body` as bare `x`
/// — the same token-splice `let_else_guard`'s `unforced` and
/// `pronoun_lambda`'s `renamed` already use for a substitution a hole
/// only ever holds as OPAQUE re-splicable text, never as editable
/// structure; a body this pattern cannot walk as structure it can
/// still walk as characters.
///
/// A BARE-HOLE ROOT, structural GUARD: `${lit}.for_range()` reads the
/// range head off the declaration (`Code.for_range`, features/
/// code.av) — a quote pattern cannot hold the loop variable open AND
/// match it again inside the desugared `cond`/`step`, which is what a
/// literal `for ${j} in 0..${xs}.length { … }` pattern would need
/// (avra-8sb5.25.45).
@fixes("for j in 0..xs.length { out.push(xs[j]) }", "for (j, x) in xs.enumerate() { out.push(x) }")
@keeps("for j in 0..xs.length { log(j) }")
@law("indexing a list by a counter from zero and enumerating that same list visit identical elements in identical order")
export rule index_walk { quote { ${lit} } if index_walked(lit) -> index_walk_fix(lit) }

/// Whether `lit` is `for NAME in 0..E.length { …E[NAME]… }`.
fn index_walked(lit: Code) -> bool {
    let r? = lit.for_range() else { return false }
    if r.from.text() != "0" || r.to.prop_name() != "length" { return false }
    let xs? = r.to.kids().first() else { return false }
    indexes(r.body, xs, r.name)
}

/// Whether `body` reads `${xs}[j]` anywhere, `j` the loop's own name.
fn indexes(body: List<Code>, xs: Code, j: string) -> bool {
    body.any(it.text().contains(xs.text() + "[" + j + "]"))
}

fn index_walk_fix(lit: Code) -> Fix {
    let r = lit.for_range()!
    let xs = r.to.kids().first()!
    let needle = xs.text() + "[" + r.name + "]"
    let body_text = [subscript_read_bare(s.text(), needle) for s in r.body].join(" ")
    Fix.Rewrite(name("for (${r.name}, x) in ${xs.text()}.enumerate() { ${body_text} }"))
}

/// Every exact `${needle}` occurrence in `text` read as `x` — never
/// mid a longer subscript (`xxs[j]` left alone) and never after a
/// `.` (a field of the same spelling on some other subject).
fn subscript_read_bare(text: string, needle: string) -> string {
    mut out = ""
    mut i = 0
    while i < text.length {
        let hi = if i + needle.length > text.length { text.length } else { i + needle.length }
        let boundary = i == 0 ||
            !is_subscript_ident_char(text.char_code(i - 1)) && text.char_code(i - 1) != 46
        if text.substring(i, hi) == needle && boundary {
            out = out + "x"
            i = hi
        } else {
            out = out + text.substring(i, i + 1)
            i = i + 1
        }
    }
    out
}

fn is_subscript_ident_char(c: int) -> bool {
    c == 95 || c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122
}

/// A `while` over a flag that only ever turns FALSE to stop it is a
/// loop written around `break`: `mut open = true` / `while open { …
/// open = false … }` is `while true { … break … }`, and the flag, its
/// declaration and the turn it wastes re-reading itself all go. A
/// flag assigned a COMPUTED value is still a condition and stays.
@keeps("mut open = true\nwhile open {\n    open = step()\n}")
export rule flag_loop {
    quote {
        {
            ${..head}
            mut ${f} = true
            while ${cond} { ${..body} }
            ${..rest}
        }
    } if cond.text() == f && body.any(it.text().contains(f + " = false")) -> flag_loop_found(cond),
}

fn flag_loop_found(flag: Code) -> Fix {
    Fix
        .Say(
            said(
                flag.loc(),
                "`${flag.text()}` only ever turns false to stop its loop — that is `break`: `while true { … break … }`",
                "this flag",
                null,
            ),
        )
}
