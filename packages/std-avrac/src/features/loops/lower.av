//! The loop in the IR: the condition's instructions live between
//! LoopStart and LoopCond and re-run each turn; the body is a scope
//! per turn.
use core.{StmtId, ExprId, Ins, Level}
use features.{StmtLowerCx}

export fn lower_while(cx: StmtLowerCx, cond: ExprId, stmts: List<StmtId>) {
    cx.emit(Ins.LoopStart)
    let c = cx.lower(cond)
    cx.emit(Ins.LoopCond(c))
    cx.emit(Ins.ScopeEnter(Level.Application))
    cx.lower_stmts(stmts)
    cx.emit(Ins.ScopeExit(null))
    cx.emit(Ins.LoopEnd)
}
