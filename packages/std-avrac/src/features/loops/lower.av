//! The loops in the IR: the condition's instructions live between
//! LoopStart and LoopCond and re-run each turn; each body is a
//! scope per turn. A step belongs to the CONDITION, never after the
//! body, so a turn ends at its back edge — which is all `continue`
//! is. A `break` or `continue` ends a turn early (`Ins.LoopJump`).
use core.{StmtId, ExprId, Ins, TypeId}
use features.{LowerCx, LoopMark}

export fn lower_while(mut cx: LowerCx, s: StmtId, cond: ExprId, stmts: List<StmtId>) {
    cx.loop_start()
    cx.loop_cond(cx.reg_of(cond), s)
    cx.lower_stmts(stmts)
    cx.loop_end()
}

/// Two cells: the COUNT, stepped in the condition each turn, and the
/// NAME, which holds the turn's own value for every read in the body
/// — bound BEFORE the condition lowers, which reads it.
export fn lower_for(
    mut cx: LowerCx,
    s: StmtId,
    from: ExprId,
    cond: ExprId,
    step: ExprId,
    stmts: List<StmtId>,
) {
    let ty = cx.type_at(from)
    let lo = cx.reg_of(from)
    let count = cx.seeded_cell(ty, lo)
    let slot = cx.seeded_cell(ty, lo)
    cx.bind_slot(s, slot)
    cx.loop_start()
    cx.stored(slot, cx.loaded_as(ty, count))
    let more = cx.reg_of(cond)
    cx.stored(count, cx.reg_of(step))
    cx.loop_cond(more, s)
    cx.lower_stmts(stmts)
    cx.loop_end()
}

/// `for x in xs`: the walk, plus the ELEMENT cell the name binds
/// through — stored fresh each turn, read wherever the body says the
/// name.
export fn lower_for_each(mut cx: LowerCx, s: StmtId, subject: ExprId, stmts: List<StmtId>) {
    let w = cx.opened(subject, elem_of(cx, subject))
    let cell = cx.mint_ty(w.elem)
    cx.emit(Ins.Alloca(cell))
    cx.bind_slot(s, cell)
    let here = cx.turn_open(w, s)
    cx.bind_index(s, here)
    cx.emit(Ins.Store(cell, cx.turn_elem(w, here)))
    cx.lower_stmts(stmts)
    cx.loop_end()
}

/// The subject's element type — typing proved it a List, and the
/// miss answers the subject's own type.
fn elem_of(ex: LowerCx, subject: ExprId) -> TypeId {
    let elem: TypeId? = ex.view.types.element(ex.type_at(subject))
    elem ?? ex.type_at(subject)
}

/// `break`/`continue`: the loop its label binds, or the innermost one
/// the program wrote.
export fn lower_jump(mut cx: LowerCx, label: ExprId?, again: bool) {
    let aimed: StmtId? = if label == null { null } else { label_loop(cx.names, cx.view.store, label!) }
    let at? = [j for j, m in cx.loops if aims_at(m, aimed)].last() else {
        return cx.defect("a `break` with no loop to end survived typing")
    }
    cx.jumped(at, again)
}

/// Whether a jump aimed at `aimed` — or at no name — lands on this
/// open loop: one the program wrote.
fn aims_at(m: LoopMark, aimed: StmtId?) -> bool {
    m.owner != null && (aimed == null || m.owner! == aimed!)
}
