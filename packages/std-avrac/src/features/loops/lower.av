//! The loops in the IR: the condition's instructions live between
//! LoopStart and LoopCond and re-run each turn; each body is a
//! scope per turn. A for adds its counter CELL before the brackets
//! and its step store after the body — nothing the IR does not
//! already say.
use core.{StmtId, ExprId, Ins, TypeId}
use features.{LowerCx}

export fn lower_while(mut cx: LowerCx, cond: ExprId, stmts: List<StmtId>) {
    cx.loop_start()
    cx.loop_cond(cx.reg_of(cond))
    cx.lower_stmts(stmts)
    cx.loop_end()
}

/// The counter is born before the loop, read through its cell each
/// turn, and stepped after the body — bind_slot BEFORE the cond
/// lowers, so the counter's ident loads through the cell.
export fn lower_for(mut cx: LowerCx, s: StmtId, from: ExprId, cond: ExprId, step: ExprId, stmts: List<StmtId>) {
    let slot = cx.seeded_cell(cx.type_at(from), cx.reg_of(from))
    cx.bind_slot(s, slot)
    cx.loop_start()
    cx.loop_cond(cx.reg_of(cond))
    cx.lower_stmts(stmts)
    cx.emit(Ins.Store(slot, cx.reg_of(step)))
    cx.loop_end()
}

/// `for x in xs`: the walk, plus the ELEMENT cell the name binds
/// through — stored fresh each turn, read wherever the body says the
/// name.
export fn lower_for_each(mut cx: LowerCx, s: StmtId, subject: ExprId, stmts: List<StmtId>) {
    let w = cx.opened(subject, elem_of(cx, subject))
    let cell = cx.mint_ty(w.elem)
    cx.emit(Ins.Alloca(cell))
    cx.bind_slot(s, cell)
    cx.turn_open(w)
    let here = cx.turn_index(w)
    cx.bind_index(s, here)
    cx.emit(Ins.Store(cell, cx.turn_elem(w, here)))
    cx.lower_stmts(stmts)
    cx.turn_close(w)
}

/// The subject's element type — typing proved it a List, and the
/// miss answers the subject's own type.
fn elem_of(ex: LowerCx, subject: ExprId) -> TypeId {
    let elem: TypeId? = ex.view.types.element(ex.type_at(subject))
    elem ?? ex.type_at(subject)
}
