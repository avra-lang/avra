//! The loops in the IR: the condition's instructions live between
//! LoopStart and LoopCond and re-run each turn; each body is a
//! scope per turn. A step runs as the turn BEGINS, never after the
//! body, so a turn ends at its back edge — which is all `continue`
//! is. A `break` or `continue` ends a turn early (`Ins.LoopJump`).
use core.{StmtId, ExprId, Ins, Type, TypeId, BinOp}
use features.{LowerCx, LoopMark}

export fn lower_while(mut cx: LowerCx, s: StmtId, cond: ExprId, stmts: List<StmtId>) {
    cx.loop_start()
    cx.loop_cond(cx.reg_of(cond), s)
    cx.lower_stmts(stmts)
    // THE BACK-EDGE IS A CANCEL POINT: its tick check is what lets a
    // spinning task be preempted. An `@unbroken` fn's own `while`
    // carries none — nothing may run in it — and a compile-time run
    // (a const's settlement, a derive) emits none either.
    if cx.checks && !cx.unbroken { cx.checked_back_edge() }
    cx.loop_end()
}

/// Two cells: the COUNT, stepped as each turn begins, and the NAME,
/// which holds the turn's own value for every read in the body —
/// bound BEFORE the condition lowers, which reads it.
export fn lower_for(mut cx: LowerCx, s: StmtId, from: ExprId, to: ExprId, stmts: List<StmtId>) {
    let ty = cx.type_at(from)
    let lo = cx.reg_of(from)
    let hi = cx.reg_of(to)
    let count = cx.seeded_cell(ty, lo)
    let slot = cx.seeded_cell(ty, lo)
    cx.bind_slot(s, slot)
    cx.loop_start()
    cx.stored(slot, cx.loaded_as(ty, count))
    cx.loop_cond(cx.bin(Type.Bool, BinOp.Lt, cx.loaded_as(ty, slot), hi), s)
    cx.stored(count, cx.bin(Type.Int, BinOp.Add, cx.loaded_as(ty, slot), cx.const_int(1)))
    cx.lower_stmts(stmts)
    cx.loop_end()
}

/// `for x in xs`: the walk, plus the ELEMENT cell the name binds
/// through — stored fresh each turn, read wherever the body says the
/// name.
export fn lower_for_each(mut cx: LowerCx, s: StmtId, subject: ExprId, stmts: List<StmtId>) {
    if is_source(cx, subject) { return lower_source_each(cx, s, subject, stmts) }
    match cx.seen_at(subject) {
        .Map(_, v) -> lower_map_each(cx, s, subject, stmts, v),
        _ -> lower_list_each(cx, s, subject, stmts),
    }
}

/// Whether the subject is a running supply — a `@std/task.Source`.
fn is_source(cx: LowerCx, subject: ExprId) -> bool {
    match cx.view.types.seen_shape(cx.type_at(subject)) {
        .App(d, "Source", _) -> cx.view.decls.package_of(d) == "@std.task",
        rest -> false,
    }
}

/// `for x in <Source>`: pull the next item each turn, ending when the
/// source does. The element is bound through a cell, as a list walk's
/// is; absence ends the loop, and the binder reads what the nullable
/// carried.
fn lower_source_each(mut cx: LowerCx, s: StmtId, subject: ExprId, stmts: List<StmtId>) {
    let elem? = source_elem(cx, subject) else {
        return cx.defect("a `for` over a `Source` without its element survived typing")
    }
    // LICENSED compiler.interned_opt: the inner is a computed TypeId — no literal spelling to hand `cx.type(T?)`
    let nullable = cx.view.types.intern(Type.Opt(elem))
    let src_ty = cx.type_at(subject)
    let src = cx.reg_of(subject)
    let sig? = cx.fields_of(src_ty) else { return cx.defect("a `Source` with no fields survived typing") }
    let slot? = sig.slot_of("next") else { return cx.defect("a `Source` with no `next` survived typing") }
    let next = cx.field_named(src, src_ty, "next", sig.types[slot])
    // The pull's answer is OWNED; it is settled into a cell in the
    // condition and read back in the body, because a value minted in
    // the condition is released at `LoopCond` — before a body that
    // stored it would retain it.
    let held = cx.seeded_cell(nullable, cx.hollow_of(nullable))
    let cell = cx.seeded_cell(elem, cx.hollow_of(elem))
    cx.bind_slot(s, cell)
    cx.loop_start()
    let code = cx.slot_read(next, 0, null)
    cx.stored(held, cx.call_ptr(nullable, code, [next]))
    cx.loop_cond(cx.presence_of(cx.loaded_as(nullable, held), nullable))
    cx.stored(cell, cx.carried_of(cx.loaded_as(nullable, held), nullable))
    cx.lower_stmts(stmts)
    cx.loop_end()
}

/// The element a `Source` supplies — its one type argument.
fn source_elem(cx: LowerCx, subject: ExprId) -> TypeId? {
    match cx.view.types.seen_shape(cx.type_at(subject)) {
        .App(_, _, args) -> if args.length == 1 { args[0] } else { null },
        rest -> null,
    }
}

fn lower_list_each(mut cx: LowerCx, s: StmtId, subject: ExprId, stmts: List<StmtId>) {
    let w = cx.opened(subject, cx.elem_of(subject))
    let cell = cx.mint_ty(w.elem)
    cx.emit(Ins.Alloca(cell))
    cx.bind_slot(s, cell)
    let here = cx.turn_open(w, s)
    cx.bind_index(s, if names_index(cx, s) { cx.turn_place(w, here) } else { here })
    cx.emit(Ins.Store(cell, cx.turn_elem(w, here)))
    cx.lower_stmts(stmts)
    cx.loop_end()
}

/// Whether the `for` names its index.
fn names_index(cx: LowerCx, s: StmtId) -> bool {
    match cx.view.store.stmt(s) { .ForEach(index, _, _, _) -> index != null, _ -> false }
}

/// `for k, v in m`: the key rides the index binder, the value the
/// element cell.
fn lower_map_each(mut cx: LowerCx, s: StmtId, subject: ExprId, stmts: List<StmtId>, vty: TypeId) {
    let k = cx.keyed(subject, vty)
    let cell = cx.mint_ty(vty)
    cx.emit(Ins.Alloca(cell))
    cx.bind_slot(s, cell)
    let here = cx.turn_open(k.keys, s)
    cx.bind_index(s, cx.turn_elem(k.keys, here))
    cx.emit(Ins.Store(cell, cx.keyed_value(k, here)))
    cx.lower_stmts(stmts)
    cx.loop_end()
}

/// `break`/`continue`: the loop its label binds, or the innermost one
/// the program wrote.
export fn lower_jump(mut cx: LowerCx, label: ExprId?, again: bool) {
    let aimed: StmtId? = if label == null { null } else { label_loop(cx.names, cx.view.store, label!) }
    let at? = [j for j, m in cx.loops if aims_at(m, aimed)].last() else {
        return cx.defect("a `break` with no loop to end survived typing")
    }
    cx.jumped(at, again)
}

/// Whether a jump aimed at `aimed` — or at no name — lands on this
/// open loop: one the program wrote.
fn aims_at(m: LoopMark, aimed: StmtId?) -> bool {
    m.owner != null && (aimed == null || m.owner! == aimed!)
}
