//! The typing rules of loops: `while`'s condition is a `bool`; `for` binds its element, and its
//! index when it names one, from what its subject is walked as; each body checks in a scope of its
//! own, its values dropped.
use core.{Checking, Expected, StmtChecks, StmtId, owned_type, walk_binds, Decision, Seating}
use core.stmt.{ForEach, Jump, While}

impl StmtChecks for While {
    fn stmt_checked(mut cx: Checking, s: StmtId) {
        let _ = cx.check_seated(self.cond, owned_type("bool"), Seating.Condition(Decision.While))
        cx.loop_opened()
        for st in self.stmts { cx.check_stmt(st) }
        cx.closed()
    }
}

impl StmtChecks for ForEach {
    fn stmt_checked(mut cx: Checking, s: StmtId) {
        let read = cx.check(self.subject, Expected.Free)
        cx.for_walked(self.subject, read, self.index != null)
        let walk = walk_binds(cx.seen(read))
        cx.loop_opened()
        if self.index != null { cx.bind(self.index!.of, walk.index) }
        cx.bind(self.name.of, walk.element)
        for st in self.stmts { cx.check_stmt(st) }
        cx.closed()
    }
}

impl StmtChecks for Jump {
    fn stmt_checked(mut cx: Checking, s: StmtId) { if self.label != null { let _ = cx.check(self.label!, Expected.Free) } }
}
