// proves: a `for` over a range left by its label counts from the start up
// to the end, and `break` or `continue` naming it ends it or its turn,
// from inside an inner loop too.
fn first_pair(n: int) -> string {
    mut found = "none"
    for i in 1..n {
        for j in 1..n {
            if i * j == 6 {
                found = "${i}x${j}"
                break i
            }
        }
    }
    found
}

fn odd_sum(n: int) -> int {
    mut total = 0
    for i in 0..n {
        for j in 0..1 {
            if i % 2 == 0 { continue i }
        }
        total = total + i
    }
    total
}

"${first_pair(5)} ${odd_sum(7)} ${first_pair(2)}"
