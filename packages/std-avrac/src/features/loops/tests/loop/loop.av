// proves: slots, back edges, and a per-turn string born and
// released inside the loop's scope — natively
fn sum_to(n: int) -> int {
    mut total = 0
    mut i = 1
    while i < n + 1 {
        let word = if i < n { "more" } else { "done" }
        total = if word == "done" { total + i + 100 } else { total + i }
        i = i + 1
    }
    total
}
fn label(n: int) -> string { if n < 50 { "small" } else { "big" } }
label(sum_to(10))
