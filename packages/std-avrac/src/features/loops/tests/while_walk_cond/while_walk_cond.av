// proves: a walk that ends early (`any`, `find`, `take` then `contains`) in a `while`'s condition
// leaves its own loop, never the `while` around it, whose turn's scope isn't open yet.
let xs = [3, 5, 8]
mut n = 0
while xs.any(it > n) { n = n + 1 }
mut m = 0
while xs.find(it == m) == null && m < 10 { m = m + 1 }
mut k = 0
while xs.take(2).contains(k + 1) || k < 2 { k = k + 1 }
println("${n} ${m} ${k}")
