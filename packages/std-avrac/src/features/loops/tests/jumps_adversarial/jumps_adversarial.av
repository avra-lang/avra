// proves: jumps out of three-deep nests with managed
// values alive in every scope, a range `continue`, a jump from a
// VALUE `match` arm and `if` branch, the turn's `defer`s on every way
// out, a label read by the nearer of two same-named loops, a task
// joined when its turn is broken, a jump from recursion, and a walk
// whose list grows under it
fn nested_managed(rows: List<List<string>>) -> string {
    mut out = ""
    for r, row in rows {
        let tag = "r${r}:"
        for w in row {
            let up = tag + w
            if w == "skip" { continue }
            match w {
                "stop" -> {
                    let note = up + "!"
                    if note.length > 0 { break row }
                },
                "next" -> { continue row },
                _ -> { out = out + up + " " },
            }
        }
    }
    out
}

fn range_continue(n: int) -> string {
    mut out = ""
    for i in 0..n {
        let s = "<${i}>"
        if i % 3 == 0 { continue }
        out = out + s
    }
    out
}

fn value_break(xs: List<int>) -> int {
    mut total = 0
    for x in xs {
        let v = match x { 0 -> { break }, 1 -> { continue }, _ -> x * 2 }
        let w = if v > 10 { break } else { v }
        total = total + w
    }
    total
}

fn deferred_managed() -> string {
    let log = Cell.new("")
    for w in ["a", "b", "c", "d"] {
        let held = w + w
        defer log.set(log.get() + "[" + held + "]")
        if w == "b" { continue }
        if w == "c" { break }
        log.set(log.get() + held)
    }
    log.get()
}

fn last_statement_jumps(n: int) -> int {
    mut k = 0
    mut guard = 0
    while guard < 100 {
        guard = guard + 1
        k = k + 1
        if k < n { continue }
        break
    }
    k
}

fn shadowed_label() -> int {
    mut t = 0
    for x in [1, 2, 3] {
        for x in [10, 20, 30] {
            if x == 20 { break x }
            t = t + x
        }
        t = t + x
    }
    t
}

fn three_deep() -> int {
    mut t = 0
    for a in [1, 2] {
        for b in [1, 2, 3] {
            mut c = 0
            while c < 5 {
                c = c + 1
                if c == 2 { continue }
                if c == 4 { continue a }
                t = t + a * 100 + b * 10 + c
            }
        }
    }
    t
}

fn tasks_joined() -> int {
    mut seen = 0
    for i in 0..5 {
        let t = spawn { i * 7 }
        if i == 3 { break }
        seen = seen + t.await
    }
    seen
}

fn cond_managed(words: List<string>) -> int {
    mut i = 0
    mut n = 0
    while words[i] + "" != "end" {
        let w = words[i] + "?"
        i = i + 1
        if w == "skip?" { continue }
        if w == "halt?" { break }
        n = n + 1
    }
    n
}

fn index_label(xs: List<string>) -> string {
    mut out = ""
    for i, x in xs {
        for y in [x, x + x] {
            if y.length > 3 { continue i }
            if y == "zz" { break i }
            out = out + y + ","
        }
    }
    out
}

fn empty_and_first() -> int {
    mut n = 0
    let none: List<int> = []
    for x in none { break }
    for x in [5, 6] {
        n = x
        break
    }
    n
}

fn recurse(d: int) -> int {
    if d == 0 { return 0 }
    mut s = 0
    for i in 0..10 {
        if i == d { break }
        s = s + recurse(d - 1) + 1
    }
    s
}

fn pushes_while_walking() -> int {
    mut xs = [1, 2, 3]
    mut n = 0
    for x in xs {
        xs.push(x)
        n = n + 1
        if n > 5 { break }
    }
    n * 100 + xs.length
}

"${nested_managed([["a", "skip", "b"], ["c", "next", "d"], ["e", "stop", "f"], ["g"]])}|${range_continue(7)}|${value_break([2, 1, 3, 9, 4])}|${deferred_managed()}|${last_statement_jumps(4)}|${shadowed_label()}|${three_deep()}|${tasks_joined()}|${cond_managed(["a", "skip", "b", "halt", "c", "end"])}|${index_label(["a", "zz", "longer", "b"])}|${empty_and_first()}|${recurse(3)}|${pushes_while_walking()}"
