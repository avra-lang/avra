// proves: index pairing — `for i, x in xs` and `for (i, x) in xs`
// bind the loop's own counter beside the element: an int, immutable,
// nested loops each their own, captured by value.
let xs = ["a", "bb", "ccc"]
let t = 0
let seen = ""
for i, x in xs {
    t = t + i * x.length
    seen = "${seen}${i}${x}"
}
for j, y in [10, 20] {
    t = t + j + y
}
let grid = 0
for i, row in [[1, 2], [3]] {
    for j, v in row {
        grid = grid + i * 10 + j + v
    }
}
let lambdas: List<fn(int) -> int> = []
for i, v in [1, 2, 3] {
    lambdas.push((k: int) -> k + i)
}
let n = 0
for i, s in ["x", "y"] {
    for k, u in [s, s] {
        n = n + i + k + u.length
    }
}
"${t} ${seen} ${grid} ${(lambdas[2])(100)} ${n}"
