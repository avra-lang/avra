// proves: a `break` or `continue` in a `while`'s condition aims at the loop around it: the
// `while`'s own turn begins only once its condition holds.
fn first_over(xs: List<int>, cap: int) -> int {
    mut n = 0
    mut i = 0
    for x in xs {
        while if x > cap { break } else { i < x } {
            i = i + 1
            n = n + 1
        }
        n = n + x
    }
    n
}
fn skips(xs: List<int>) -> int {
    mut n = 0
    for x in xs {
        mut k = 0
        while if x == 2 { continue } else { k < 1 } {
            k = k + 1
            n = n + x
        }
        n = n + 100
    }
    n
}
fn nested(limit: int) -> int {
    mut n = 0
    mut a = 0
    while a < 5 {
        a = a + 1
        mut b = 0
        while if a == limit { break } else { b < 2 } {
            b = b + 1
            if b == 2 { break }
            n = n + 1
        }
        n = n + 10
    }
    n
}
mut n = 0
for x in [1, 2, 3] {
    while if x == 2 { break } else { false } {
        n = n + 100
    }
    n = n + x
}
"${n} ${first_over([1, 2, 9, 4], 5)} ${skips([1, 2, 3])} ${nested(3)}"
