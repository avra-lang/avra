// THE ANCHOR, witnessed through the node it places: `break row` nests an
// `Expr.Ident` in a wider branch, and the Ident begins where `row` was
// written — never at the `break` that opened the branch, which is the
// span the statement itself still wears.
use @std.avrac.compiler.{Parsed, parse_source}
use core.{Expr, ExprId, StmtId, node_payload_rows, row_for, has_anchor}

/// The label a jump names, absent for a bare one.
fn jump_label(p: Parsed, s: StmtId) -> ExprId? {
    match p.store.stmt(s) { .Jump(label, _) -> label, _ -> null }
}

/// The jump statement a program holds, if it holds one.
fn jump_of(p: Parsed) -> StmtId? {
    [s for s in p.store.stmt_ids() if jump_label(p, s) != null].first()
}

fn is_ident(e: Expr) -> bool { match e { .Ident(_) -> true, _ -> false } }

fn source_at(p: Parsed, id: ExprId) -> string {
    let at? = p.store.expr_span(id) else { return "" }
    p.source.text.substring(at.lo, at.hi)
}

/// The text a jump's label was written as — empty for a bare jump.
fn label_text(source: string) -> string {
    let p = parse_source(source)
    let s? = jump_of(p) else { return "" }
    let label? = jump_label(p, s) else { return "" }
    source_at(p, label)
}

/// The text the jump statement itself was written as.
fn jump_text(source: string) -> string {
    let p = parse_source(source)
    let s? = jump_of(p) else { return "" }
    let at? = p.store.stmt_span(s) else { return "" }
    p.source.text.substring(at.lo, at.hi)
}

/// The text the program's one Ident was written as.
fn first_ident_text(source: string) -> string {
    let p = parse_source(source)
    let e? = [e for e in p.store.expr_ids() if is_ident(p.store.expr(e))].first() else { return "" }
    source_at(p, e)
}

spec "features/loops/anchor" {
    given "the node declares it" {
        then "`Expr.Ident`'s `name` is its anchor, and it is the only one" {
            let anchored = (row_for(node_payload_rows(), "Expr", "Ident")?.payloads ?? [])
                .filter(has_anchor(it))
            anchored.length == 1 && anchored[0].name == "name"
        }
    }
    given "a jump names its loop" {
        then "the label spans the NAME it reads" {
            label_text("for n in [1] {\n    break nope\n}") == "nope"
        }
        then "and `continue` answers the same" {
            label_text("for n in [1] {\n    continue nope\n}") == "nope"
        }
        then "the STATEMENT still spans the line it wrote, break and all" {
            jump_text("for n in [1] {\n    break nope\n}").trim() == "break nope"
        }
        then "a bare jump names no label" {
            label_text("for n in [1] {\n    break\n}") == ""
        }
    }
    given "a name read on its own" {
        then "an Ident's own rule spans its name, which IS its branch" {
            first_ident_text("nope") == "nope"
        }
    }
}
