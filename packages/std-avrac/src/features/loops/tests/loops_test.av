// Loops, vertically: the condition re-evaluates each turn, the body
// scopes its bindings, and the IR carries the third bracket family.
use @std.avrac.compiler.{analyze_source}
use @std.avrac.testing.{refused_with, shown, ir_of}
use compiler.backend.{render_ir}

spec "features/loops" {
    given "the counter's TYPE — an int, never an absorbing hole" {
        then "the counter refuses where an int must: it is NOT Error" {
            refused_with(
                "for i in 0..2 {\n    let s: string = i\n}\n1",
                "`s` declares `string`, this is `int`",
            )
        }
        then "the counter WIDENS into a nullable cell like any int" {
            shown("mut t: int? = null\nfor i in 0..3 {\n    t = i\n}\nt ?? 0 - 1") == "2"
        }
    }
    given "while" {
        then "the loop turns until the condition falls" {
            shown(
                "mut total = 0\nmut i = 1\nwhile i < 5 {\n    total = total + i\n    i = i + 1\n}\ntotal",
            ) == "10"
        }
        then "a while whose condition starts false never turns" {
            shown("mut hits = 0\nwhile 1 < 0 {\n    hits = hits + 1\n}\nhits") == "0"
        }
        then "a loop drives a fn to its answer" {
            shown(
                "fn sum_to(n: int) -> int {\n    mut total = 0\n    mut i = 1\n    while i < n + 1 {\n        total = total + i\n        i = i + 1\n    }\n    total\n}\nsum_to(10)",
            ) == "55"
        }
    }
    given "for" {
        then "the counter walks the range" {
            shown("mut t = 0\nfor i in 0..5 {\n    t = t + i\n}\nt") == "10"
        }
        then "an empty range never turns" {
            shown("mut hits = 0\nfor i in 3..3 {\n    hits = hits + 1\n}\nhits") == "0"
        }
        then "a bound sees the OUTER name, never the counter" {
            shown("let i = 5\nmut t = 0\nfor i in 0..i {\n    t = t + i\n}\nt") == "10"
        }
        then "the counter dies with its loop — and says so exactly once" {
            let a = analyze_source("for i in 0..3 {\n    i\n}\ni")
            a.diagnostics.length == 1 && a.report().contains("`i` is not defined")
        }
    }
    given "wrong shapes" {
        then "a non-bool condition points at itself" {
            let a = analyze_source("while 1 {\n    2\n}\n3")
            a.diagnostics.length == 1 &&
                a.report().contains("a `while` condition is a `bool`, found `int`")
        }
        then "a non-int range bound refuses once, in for's own words" {
            let a = analyze_source("for i in 0..\"x\" {\n    1\n}\n2")
            a.diagnostics.length == 1 &&
                a.report().contains("a `for` range ends at an `int`, found `string`")
        }
    }
    given "the loop in the IR, as `avra ir` prints it" {
        then "slots, the re-run condition, and the back edge" {
            let expected = """scope application {
  r0 = int 0
  r1 = slot
  store r1 <- r0
  loop {
    r2 = load r1
    r3 = int 3
    r4 = r2 < r3
    while r4
    scope application {
      r5 = load r1
      r6 = int 1
      r7 = r5 + r6
      store r1 <- r7
    }
  }
  r8 = load r1
  r9 = call avra_int_text(r8)
  call avra_puts(r9)
  release r9
}
ret 0"""
            render_ir(ir_of("mut x = 0\nwhile x < 3 {\n    x = x + 1\n}\nx")) == expected
        }
        then "a for is mut+while in costume — a count cell stepped in the condition, the name's cell per turn" {
            let expected = """scope application {
  r0 = int 0
  r1 = slot
  store r1 <- r0
  r2 = int 0
  r3 = slot
  store r3 <- r2
  r4 = slot
  store r4 <- r2
  loop {
    r5 = load r3
    store r4 <- r5
    r6 = load r4
    r7 = int 2
    r8 = r6 < r7
    r9 = load r4
    r10 = int 1
    r11 = r9 + r10
    store r3 <- r11
    while r8
    scope application {
      r12 = load r1
      r13 = load r4
      r14 = r12 + r13
      store r1 <- r14
    }
  }
  r15 = load r1
  r16 = call avra_int_text(r15)
  call avra_puts(r16)
  release r16
}
ret 0"""
            render_ir(ir_of("mut t = 0\nfor i in 0..2 {\n    t = t + i\n}\nt")) == expected
        }
    }
    given "index pairing — `for i, x in xs`" {
        then "the index counts from zero, beside the element" {
            shown(
                "let xs = [\"a\", \"bb\"]\nmut t = 0\nfor i, x in xs {\n    t = t + i * 10 + x.length\n}\nt",
            ) == "13"
        }
        then "the parenthesised spelling is the same loop" {
            shown("mut t = 0\nfor (j, y) in [10, 20] {\n    t = t + j + y\n}\nt") == "31"
        }
        then "the index is an int and immutable" {
            refused_with("for i, x in [1] {\n    i = 5\n}\n2", "`i` is a loop index") &&
                refused_with(
                    "for i, x in [1] {\n    let s: string = i\n}\n2",
                    "declares `string`, this is `int`",
                )
        }
        then "nested loops keep their own indexes" {
            shown(
                "mut g = 0\nfor i, row in [[1, 2], [3]] {\n    for j, v in row {\n        g = g + i * 10 + j + v\n    }\n}\ng",
            ) == "17"
        }
        then "a lambda captures the index by value" {
            shown(
                "mut fs: List<fn(int) -> int> = []\nfor i, v in [1, 2, 3] {\n    fs.push(it + i)\n}\nfs[2](100)",
            ) == "102"
        }
        then "the index name obeys the naming law" {
            refused_with("for fn, x in [1] {\n    2\n}\n2", "`fn` is a keyword")
        }
    }
    given "break and continue" {
        then "`break` ends the innermost loop where it stands" {
            shown("mut t = 0\nfor i in 0..10 {\n    if i == 4 { break }\n    t = t + i\n}\nt") == "6"
        }
        then "`continue` ends the turn and the next one begins" {
            shown("mut t = 0\nfor i in 0..5 {\n    if i == 2 { continue }\n    t = t + i\n}\nt") == "8"
        }
        then "a `while` re-reads its condition after `continue`" {
            shown(
                "mut i = 0\nmut hits = 0\nwhile i < 6 {\n    i = i + 1\n    if i < 4 { continue }\n    hits = hits + 1\n}\ni * 10 + hits",
            ) == "63"
        }
        then "a label ends the `for` whose name it reads" {
            shown(
                "mut t = 0\nfor a in [1, 2, 3] {\n    for b in [10, 20] {\n        if a == 2 { break a }\n        t = t + a * b\n    }\n}\nt",
            ) == "30"
        }
        then "an index names its loop as well as the element" {
            shown(
                "mut t = 0\nfor i, a in [1, 2, 3] {\n    for b in [10, 20] {\n        if b == 20 { continue i }\n        t = t + a\n    }\n}\nt",
            ) == "6"
        }
        then "a jump from a `match` arm ends the loop around the match" {
            shown(
                "mut n = 0\nfor w in [\"a\", \"b\", \"stop\", \"c\"] {\n    match w {\n        \"stop\" -> { break },\n        _ -> { n = n + 1 },\n    }\n}\nn",
            ) == "2"
        }
        then "a `let … else` may leave by `continue`" {
            shown(
                "mut s = 0\nfor x in [1, null, 3] {\n    let v? = x else { continue }\n    s = s + v\n}\ns",
            ) == "4"
        }
        then "a jump outside every loop refuses" {
            refused_with(
                "break",
                "`break` ends the turn of a loop around it, and no loop encloses it",
            )
        }
        then "a jump inside a lambda refuses — the lambda runs apart" {
            refused_with(
                "for x in [1] {\n    let f = () -> {\n        break\n    }\n}\n1",
                "a lambda's body runs apart from any loop outside it",
            )
        }
        then "a jump inside a comprehension refuses" {
            refused_with(
                "for x in [1] {\n    let ys = [if y > 1 { continue } else { y } for y in [1, 2]]\n}\n1",
                "a comprehension's walk builds its whole list",
            )
        }
        then "a label that names no `for` refuses at the label" {
            refused_with(
                "for x in [1] {\n    let y = x\n    break y\n}\n1",
                "`y` is no enclosing `for`'s name here",
            )
        }
        then "a `while` has no name to label" {
            refused_with(
                "mut i = 0\nwhile i < 1 {\n    continue i\n}\n1",
                "`i` is no enclosing `for`'s name here",
            )
        }
        then "a jump in a `while` condition ends the loop OUTSIDE it" {
            shown(
                "mut n = 0\nfor x in [1, 2, 3] {\n    while if x == 2 { break } else { false } {\n        n = n + 100\n    }\n    n = n + x\n}\nn",
            ) == "1"
        }
        then "a jump in a condition with no outer loop refuses" {
            refused_with(
                "while if true { break } else { false } {\n    1\n}\n1",
                "no loop encloses it",
            )
        }
        then "`break` and `continue` are words — neither is a name" {
            refused_with("let break = 1\n1", "`break` is a keyword")
        }
    }
}
