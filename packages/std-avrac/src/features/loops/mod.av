//! Loops — `while c { statements }`. A statement, no value; the
//! body is a statement list under its own scope, and the condition
//! re-evaluates each turn.
use features.{LanguageFeature, BuilderRow}

export fn loops() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name         | build
        "while_stmt" | build_while
    }
    component LanguageFeature f {
        name = "loops"
        docs = "`while <cond> { <statements> }`; the body repeats while the condition holds."
        gram = """
stmt = "while" c:expression "{" ( s:stmt | BREAK )* "}" BREAK @recover(sync_to: "BREAK") -> while_stmt(c, s)
"""
        builders = rows
    }
    f
}
