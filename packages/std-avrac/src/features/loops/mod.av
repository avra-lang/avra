//! Loops — `while c { statements }` and `for name in lo..hi
//! { statements }`. Statements, no value; each body is a statement
//! list under its own scope. `for` is mut+while in costume: the
//! BUILDER synthesizes its condition (`name < hi`) and step
//! (`name + 1`) as real nodes, so every pass just walks them and
//! the IR gains nothing.
use features.{LanguageFeature, BuilderRow}
use features.loops.{push_loop, index_walk, branched_push_loop}
use @std.grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}

export fn loops() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name         | build
        "while_stmt" | build_while
        "for_each"   | build_for_each
        "for_stmt"   | build_for
    }
    LanguageFeature loops {
        gram: grammar {
            stmt = "while" c:expression "{" ( s:stmt | BREAK )* "}" END @recover(sync_to: "END") -> while_stmt(c, s) @head(c) | "for" ( "(" ix:NAME "," en:NAME ")" | ix:NAME "," en:NAME | en:NAME ) "in" exs:expression "{" ( es:stmt | BREAK )* "}" END -> for_each(ix, en, exs, es) @head(exs) | "for" n:NAME "in" lo:expression ".." hi:expression "{" ( s:stmt | BREAK )* "}" END @recover(sync_to: "END") -> for_stmt(n, lo, hi, s) @head(lo) @head(hi)
        }
        builders: rows
    }
    loops
}
