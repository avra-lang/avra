//! Parse-time lowering: the condition and body statements -> the
//! While node; a range head -> the For node plus its DESUGARED
//! condition and step (`name < hi`, `name + 1`) as real nodes with
//! null spans. The two Ident references are SEPARATE nodes — each
//! lowering site mints its own load.
use core.{Stmt, Expr, BinOp, Scoped}
use features.{LangNode, Builder}
use grammar.{Token}

fn build_break(b: Builder) -> Result<LangNode, string> {
    labelled(b, false)
}

fn build_continue(b: Builder) -> Result<LangNode, string> {
    labelled(b, true)
}

/// A jump naming its loop: the label a READ of the name the `for`
/// binds, at the name's own span, where a refusal about it points.
fn labelled(b: Builder, again: bool) -> Result<LangNode, string> {
    let n = b.token(0)?
    b.make_stmt(Stmt.Jump(b.store.alloc_expr(Expr.Ident(Scoped(n.text)), n.span), again))
}

fn build_for(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let lo = b.expr(1)?
    let hi = b.expr(2)?
    let stmts = b.stmts(3)?
    let cond_ref = b.store.alloc_expr(Expr.Ident(Scoped(n.text)))
    let cond = b.store.alloc_expr(Expr.Binary(BinOp.Lt, cond_ref, hi))
    let step_ref = b.store.alloc_expr(Expr.Ident(Scoped(n.text)))
    let one = b.store.alloc_expr(Expr.IntLit(1))
    let step = b.store.alloc_expr(Expr.Binary(BinOp.Add, step_ref, one))
    b.make_stmt(Stmt.For(Scoped(n.text), lo, hi, cond, step, stmts))
}
