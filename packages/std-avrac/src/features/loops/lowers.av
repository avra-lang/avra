//! The lowering rules of a loop and of leaving one: `while` tests its condition each turn and runs
//! its body in a scope of its own, its back edge a cancel point; `break` ends the innermost loop, or
//! the one its label names, `continue` starts its next turn. A `for` over a list lowers as what it
//! means, a walk whose back edge is none; one the meaning doesn't take walks by its own rule.
use core.{
    BoxKind,
    Bound,
    Layout,
    ListWalk,
    Lowering,
    Reg,
    SignedType,
    StmtId,
    StmtLowers,
    owned_type,
    rt_sig_of,
    some_list,
}
use core.stmt.{ForEach, Jump, While}

impl StmtLowers for While {
    fn stmt_lowered(mut cx: Lowering, s: StmtId) {
        cx.loop_start()
        cx.loop_cond(cx.lower(self.cond))
        for b in self.stmts { cx.lower_stmt(b) }
        cx.back_edge(s)
        cx.loop_end()
    }
}

impl StmtLowers for Jump {
    fn stmt_lowered(mut cx: Lowering, s: StmtId) {
        if self.label == null { return cx.jumped(self.again) }
        let label? = cx.store.ident_name(self.label!) else { return cx.missed("a jump naming no loop") }
        cx.jumped_to(label, self.again)
    }
}

impl StmtLowers for ForEach {
    /// A walk its meaning doesn't take: over a list naming its index or leaving by a label, over a
    /// map's keys beside its values, or over octets; each turn binds its place, then what stands there. It's shaped
    /// otherwise elsewhere, so it's noted.
    fn stmt_lowered(mut cx: Lowering, s: StmtId) {
        let ty? = cx.type_at(self.subject) else { return cx.stmt_unlowered(s) }
        let elem = ty.listed()
        if elem != null { return listed_each(cx, self, elem!) }
        let value = ty.mapped()
        if value != null { return mapped_each(cx, self, ty.args[0], value!) }
        if ty.spelled() == "Bytes" { return octets_each(cx, self) }
        cx.stmt_unlowered(s)
    }

    /// A walk over a list, as its meaning: one the program's other lowerings may shape otherwise, so
    /// it's noted.
    fn meant_lowered(mut cx: Lowering, s: StmtId, meant: List<StmtId>) {
        cx.reshaped()
        cx.walking(meant)
        for m in meant { cx.lower_stmt(m) }
    }
}

/// `for x in xs` or `for i, x in xs`: the list read once, each turn binding its place and its element.
fn listed_each(mut cx: Lowering, f: ForEach, elem: SignedType) {
    cx.reshaped()
    let w = cx.walk_list(cx.lower(f.subject), elem)
    let here = cx.walk_turn(w)
    if f.index != null { cx.bind(f.index!.of, Bound.Value(here, owned_type("int"))) }
    turned_body(cx, f, cx.element_at(w.elem_layout, w.list!, here), elem)
}

/// `for k, v in m`: its keys and its values read once, side by side, each turn binding a key, then its
/// value.
fn mapped_each(mut cx: Lowering, f: ForEach, key: SignedType, value: SignedType) {
    cx.reshaped()
    let m = cx.lower(f.subject)
    let keys = cx.call_row(Layout.Boxed(BoxKind.List), rt_sig_of("avra_map_keys")!, [m])
    let values = cx.call_row(Layout.Boxed(BoxKind.List), rt_sig_of("avra_map_vals")!, [m])
    let w = cx.walk_list(keys, key)
    let here = cx.walk_turn(w)
    if f.index != null { cx.bind(f.index!.of, Bound.Value(cx.element_at(w.elem_layout, keys, here), key)) }
    turned_body(cx, f, cx.element_at(cx.laid_out(value), values, here), value)
}

/// `for b in bytes`: the octets read once, each turn binding one, an `int`.
fn octets_each(mut cx: Lowering, f: ForEach) {
    cx.reshaped()
    let b = cx.lower(f.subject)
    let octet = owned_type("int")
    let w = ListWalk {
        list: b,
        len: cx.call_row(Layout.Word, rt_sig_of("avra_bytes_len")!, [b]),
        at: cx.seeded_cell(Layout.Word, cx.const_int(0)),
        elem: octet,
        elem_layout: Layout.Word,
    }
    let here = cx.walk_turn(w)
    if f.index != null { cx.bind(f.index!.of, Bound.Value(here, octet)) }
    turned_body(cx, f, cx.call_row(Layout.Word, rt_sig_of("avra_bytes_at")!, [b, here]), octet)
}

/// A turn's body, its loop labelled by the names it binds and the element bound to `v`, then the turn
/// closed.
fn turned_body(mut cx: Lowering, f: ForEach, v: Reg, elem: SignedType) {
    cx.labelled([f.name.of].concat(some_list(f.index?.of)))
    cx.bind(f.name.of, Bound.Value(v, elem))
    for st in f.stmts { cx.lower_stmt(st) }
    cx.loop_end()
}
