//! The while's typing law: the condition is a bool; the body types
//! under this scope.
use core.{StmtId}
use features.{StmtTypeCx, require_bool, nothing}

export fn check_while(cx: StmtTypeCx, s: StmtId) {
    match cx.store.stmt(s) {
        .While(cond, stmts) -> {
            cx.walk(cond)
            require_bool(cx.expr, cond, "a `while` condition", "this decides the loop")
            cx.type_stmts(stmts)
        }
        _ -> nothing(),
    }
}
