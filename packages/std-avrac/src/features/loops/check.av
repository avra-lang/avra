//! The loops' typing laws: a while condition is a bool; a for range
//! is ints. When a bound refuses, the desugared cond/step stay
//! unwalked — the refusal gate stops the program before their
//! (absorbed) types matter.
use core.{StmtId, ExprId}
use features.{StmtTypeCx, require_bool, nothing, this_is}
use diagnostics.{error_at, pointed}

export fn check_while(cx: StmtTypeCx, s: StmtId) {
    match cx.store.stmt(s) {
        .While(cond, stmts) -> {
            cx.walk(cond)
            require_bool(cx.expr, cond, "a `while` condition", "this decides the loop")
            cx.type_stmts(stmts)
        }
        _ -> nothing(),
    }
}

export fn check_for(cx: StmtTypeCx, s: StmtId) {
    match cx.store.stmt(s) {
        .For(_, from, to, cond, step, stmts) -> {
            cx.walk(from)
            cx.walk(to)
            let ok = range_bound(cx, from, "starts") && range_bound(cx, to, "ends")
            if ok {
                cx.walk(cond)
                cx.walk(step)
            }
            cx.type_stmts(stmts)
        }
        _ -> nothing(),
    }
}

/// A range bound is an `int`; Error absorbs.
fn range_bound(cx: StmtTypeCx, e: ExprId, verb: string) -> bool {
    let sh = cx.expr.shape_at(e)
    if sh is .Int { return true }
    if sh is .Error { return false }
    let n = cx.expr.name_at(e)
    cx.expr.emit(pointed(
        error_at("type.mismatch", cx.expr.loc_of(e),
            "a `for` range ${verb} at an `int`, found `${n}`"),
        this_is(n)))
    false
}
