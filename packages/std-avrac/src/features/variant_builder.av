//! The builder of the enum group's variant record: a
//! `Record.VariantSyntax` rule writes one variant with its payloads —
//! seats built by the `ParamSyntax` builder. Data, carried by `Carried.Variant`.
use core.{Carried, Variant, Plain}
use features.{LangNode, Builder}

impl Builder {
    /// The variant a `VariantSyntax` rule wrote.
    fn variant() -> Result<LangNode, string> {
        .Ok(
            LangNode
                .NCarried(
                    Carried
                        .Variant(
                            Variant {
                                name: Plain(self.text_of("name")?),
                                payloads: self.params_of("payloads")?,
                                span: self.span,
                                marks: self.marks_of("marks")?,
                            },
                        ),
                ),
        )
    }
}
