//! The builders of the enum group's records: a `Record.PayloadSyntax`
//! rule writes one payload, a `Record.VariantSyntax` rule one variant
//! with its payloads. Both are data, carried by `NParam` and
//! `NVariant`.
use core.{Param, Variant, Scoped, Plain, plain_mark}
use features.{LangNode, Builder}

impl Builder {
    /// The payload a `PayloadSyntax` rule wrote — a positional payload
    /// names nothing.
    fn payload() -> Result<LangNode, string> {
        let t = self.type_of("ty")?
        .Ok(
            LangNode
                .NParam(
                    Param {
                        name: self.scoped_opt_of("name")? ?? Scoped(""),
                        ty: t,
                        default: null,
                        promises: plain_mark,
                        id: self.store.alloc_param_id(t.span),
                        marks: self.marks_of("marks")?,
                    },
                ),
        )
    }

    /// The variant a `VariantSyntax` rule wrote.
    fn variant() -> Result<LangNode, string> {
        .Ok(
            LangNode
                .NVariant(
                    Variant {
                        name: Plain(self.text_of("name")?),
                        payloads: self.params_of("payloads")?,
                        span: self.span,
                        marks: self.marks_of("marks")?,
                    },
                ),
        )
    }
}
