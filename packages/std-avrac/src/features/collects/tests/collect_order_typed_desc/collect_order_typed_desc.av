// `collect_order_typed_asc`'s twin with the declarations in the
// OPPOSITE source order — 10, 2, 9 — proving the `by` key's int value
// decides the order, and file order never does.
use @std.meta.{Named}

fn migration(_what: Named, _id: int) {}

@migration(10)
fn add_tags() {}

@migration(2)
fn add_users() {}

@migration(9)
fn add_posts() {}

type MarkInfo = { name: string, args: List<string> }
type Entry = { name: string, mark: MarkInfo }
collect steps: List<Entry> = @migration in self as Entry { name: it.name, mark: it.mark } by it.mark.args[0]

[step.mark.args[0] for step in steps].join(" ")
