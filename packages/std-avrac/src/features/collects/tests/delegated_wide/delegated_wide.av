// proves: a `collect enum` delegating a wide trait (30 methods over 40 members) settles
// under the default memory budget — the delegation's cost is linear in methods times members.
use @std.meta.{Named}

fn node(_t: Named, _rank: int) {}

trait Wide {
    fn m0() -> int
    fn m1() -> int
    fn m2() -> int
    fn m3() -> int
    fn m4() -> int
    fn m5() -> int
    fn m6() -> int
    fn m7() -> int
    fn m8() -> int
    fn m9() -> int
    fn m10() -> int
    fn m11() -> int
    fn m12() -> int
    fn m13() -> int
    fn m14() -> int
    fn m15() -> int
    fn m16() -> int
    fn m17() -> int
    fn m18() -> int
    fn m19() -> int
    fn m20() -> int
    fn m21() -> int
    fn m22() -> int
    fn m23() -> int
    fn m24() -> int
    fn m25() -> int
    fn m26() -> int
    fn m27() -> int
    fn m28() -> int
    fn m29() -> int
}

