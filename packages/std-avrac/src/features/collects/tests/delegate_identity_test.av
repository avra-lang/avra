// A refusal `@std/meta`'s `delegate` makes over a `collect enum` is the enum's own; a package's own
// fn named `delegate` is an annotation like any other, and its refusal is said as one.
use @std.avrac.testing.{provided}

/// `@x/c`: a declaring fn of its own named `delegate`, refusing whatever it is worn on.
fn own_delegate() -> string {
    "use @std.meta.{Type, Declared, refuse}\nexport fn delegate(t: Type) -> Declared { Declared { made: [], problems: [refuse(\"`\${t.name}` is refused by its own delegate\")] } }\n"
}

spec "features/collects — `delegate` is the declaration, never the word" {
    given "a package's own fn named `delegate`, worn on a type" {
        then "its refusal is the annotation's, never a delegated enum's" {
            let out = provided(
                "use @x.c.{delegate}\n@delegate\ntype Dot = { at: int }\n1",
                own_delegate(),
            )
                .report()
            out.contains("[annotation.said]") &&
                !out.contains("collect_enum.self") &&
                out.contains("refused by its own delegate")
        }
    }
}
