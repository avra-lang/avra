// proves: a collect over a component's instances in closure projects each instance's own field, its
// name, module and doc, and the kinds its arms are rooted at, ordered by module then name; an
// instance its component judges is valued as what it builds.
use @std.meta.{Diagnostic}

export component widget {
    run: fn(int) -> int?
    doc: string = ""

    fn check() -> List<Diagnostic> { [] }
}

/// The first widget.
export widget a { n -> n + 1 }

/// The second widget.
export widget b { n -> null }

type Entry = { name: string, module: string, run: fn(int) -> int?, doc: string, root: List<int> }

collect xs: List<Entry> = widget in closure as Entry { name: it.name, module: it.module, run: it.run, doc: it.doc, root: it.root_kind } by it.module, it.name

"${xs.length} ${xs[0].name} ${xs[1].name} ${xs[0].run(2) ?? 0} ${xs[0].doc} ${xs[0].root.length}"
