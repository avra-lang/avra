use @std.meta.{Named}

export fn shape(_t: Named, _rank: int) {}

export trait Same {
    fn same(other: Self) -> bool
    fn grown(by: int) -> Self
}

@shape(0)
export type Dot = { at: int }

impl Same for Dot {
    fn same(other: Dot) -> bool { self.at == other.at }
    fn grown(by: int) -> Dot { Dot { at: self.at + by } }
}

@shape(1)
export type Line = { from: int, to: int }

impl Same for Line {
    fn same(other: Line) -> bool { self.from == other.from && self.to == other.to }
    fn grown(by: int) -> Line { Line { from: self.from, to: self.to + by } }
}
