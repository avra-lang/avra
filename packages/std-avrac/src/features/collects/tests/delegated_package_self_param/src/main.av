// proves: `collect enum E: T … in package` over members in OTHER files delegates a
// `Self` parameter and a `Self` answer as `in self` does.
use parts.{shape, Same}

export collect enum Item: Same = @shape in package by it.mark.args[0] dense

let d = Item.Dot(4)
let l = Item.Line(2, 9)
"${d.same(Item.Dot(4))} ${d.same(l)} ${d.grown(1).same(Item.Dot(5))} ${l.grown(1).same(Item.Line(2, 10))}"
