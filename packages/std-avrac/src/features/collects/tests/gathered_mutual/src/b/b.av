use @std.meta.{derive, Named}
use @test.counted.{Counted}
use main.{Leaf}

export fn woody(_t: Named, _rank: int) {}

@woody(0)
export type Stump = {}

@woody(1)
export type Limb = { leaf: Leaf, next: Tree? }

@derive(Counted)
export collect enum Tree = @woody in package by it.mark.args[0] dense

export fn grow(l: Leaf) -> Tree { Tree.Limb(l, null) }
