// proves: two gathered enums whose members name each other settle —
// each derive is handed its own members with their field kinds.
use @std.meta.{derive, Named}
use @test.counted.{Counted}
use b.{Tree, grow}

export fn leafy(_t: Named, _rank: int) {}

@leafy(0)
export type Tip = {}

@leafy(1)
export type Fork = { under: Tree, kids: List<Leaf> }

@derive(Counted)
export collect enum Leaf = @leafy in package by it.mark.args[0] dense

let t = grow(Leaf.Fork(Tree.Stump, [Leaf.Tip]))
let n = match t {
    .Stump -> 0,
    .Limb(l, _) -> match l { .Tip -> 1, .Fork(_, kids) -> 10 + kids.length },
}
"${Leaf.names()} | ${Tree.names()} | ${n}"
