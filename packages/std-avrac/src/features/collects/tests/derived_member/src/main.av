// proves: `collect enum E: T` DERIVES a member that writes no `impl T`
// when the trait declares `derive`, and the enum reaches the derived
// method — a member's own impl still wins.
use @std.meta.{Named}
use @test.counted.{Size}

fn node(_t: Named, _rank: int) {}

@node(0)
type Dot = {}

@node(1)
type Line = { from: int, to: int }

@node(2)
type Given = { n: int }

impl Size for Given {
    fn size() -> int { 100 }
}

collect enum Shape: Size = @node in self by it.mark.args[0] dense

fn shown(s: Shape) -> int { s.size() }

"${shown(Shape.Dot)} ${shown(Shape.Line(1, 2))} ${shown(Shape.Given(7))}"
