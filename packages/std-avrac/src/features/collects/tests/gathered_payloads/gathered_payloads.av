// proves: a gathered variant carries its member record's fields as
// its payload, in field order — an empty record and a member that is
// no record carry nothing — and construction, patterns and the
// ordinal read as a written enum's do.
use @std.meta.{Named}

fn shape(_t: Named, _rank: int) {}

@shape(0)
type Dot = {}

@shape(1)
type Line = { from: int, to: int }

@shape(2)
type Label = { text: string }

@shape(3)
fn origin() {}

collect enum Shape = @shape in self by it.mark.args[0] dense

fn size(s: Shape) -> int {
    match s { .Dot -> 0, .Line(a, b) -> b - a, .Label(t) -> t.length, .origin -> 100 }
}

"${size(Shape.Line(1, 4))} ${size(Shape.Dot)} ${size(Shape.Label("ab"))} ${size(Shape.origin)} ${Shape.Label("x").ordinal}"
