// proves: a `collect enum E: A, B … in package` whose members across files derive BOTH
// traits keeps each trait's impls apart, however often the enum's file is expanded.
use parts.{shape}
use @test.counted.{Size, Twin}

export collect enum Shape: Size, Twin = @shape in package by it.mark.args[0] dense

fn shown(s: Shape) -> string { "${s.size()}/${s.weight()}" }

"${shown(Shape.Dot)} ${shown(Shape.Line(1, 2))} ${shown(Shape.Given(7))}"
