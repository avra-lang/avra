// proves: `collect enum E: A, B` implements each trait over its members, in one file.
use @std.meta.{Named}

fn node(_t: Named, _rank: int) {}

trait Size {
    fn size() -> int
}

trait Weight {
    fn weight(by: int) -> int
}

@node(0)
type Dot = { at: int }

impl Size for Dot {
    fn size() -> int { 1 }
}

impl Weight for Dot {
    fn weight(by: int) -> int { self.at * by }
}

@node(1)
type Line = { from: int, to: int }

impl Size for Line {
    fn size() -> int { self.to - self.from }
}

impl Weight for Line {
    fn weight(by: int) -> int { self.to * by }
}

collect enum Shape: Size, Weight = @node in self by it.mark.args[0] dense

let d = Shape.Dot(4)
let l = Shape.Line(2, 9)
"${d.size()} ${l.size()} ${d.weight(3)} ${l.weight(3)}"
