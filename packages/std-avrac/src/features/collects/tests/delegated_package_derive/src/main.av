// proves: a second derive on a `collect enum E: T … in package` leaves the
// delegation over cross-file members intact — the arms and the derive's
// own method both answer.
use @std.meta.{derive}
use parts.{shape}
use @test.counted.{Size, Counted}

@derive(Counted)
export collect enum Shape: Size = @shape in package by it.mark.args[0] dense

fn shown(s: Shape) -> int { s.size() }

"${shown(Shape.Dot)} ${shown(Shape.Line(1, 2))} ${shown(Shape.Given(7))} ${Shape.count()}"
