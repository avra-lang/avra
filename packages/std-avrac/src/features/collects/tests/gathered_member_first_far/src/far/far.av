use @std.meta.{Named}
use main.{Shape}

export fn shape(_t: Named, _rank: int) {}

@shape(0)
export type Dot = {}

@shape(1)
export type Neg = { inner: Shape? }

@shape(2)
export type Both = { left: Shape, right: List<Shape> }

/// Typed before the entry's own statements ask the enum.
export fn lone() -> Neg { Neg { inner: null } }
