// proves: a member in another file naming the gathered enum carries
// that field — the member's file signs it before the entry's enum.
use far.{shape, lone}

export collect enum Shape = @shape in package by it.mark.args[0] dense

fn depth(s: Shape) -> int {
    match s {
        .Dot -> 0,
        .Neg(inner) -> 1 + if inner == null { 0 } else { depth(inner!) },
        .Both(left, right) -> 1 + depth(left) + right.length,
    }
}

let empty = if lone().inner == null { 1 } else { 0 }
"${depth(Shape.Neg(Shape.Neg(null)))} ${depth(Shape.Both(Shape.Neg(Shape.Dot), [Shape.Dot]))} ${empty}"
