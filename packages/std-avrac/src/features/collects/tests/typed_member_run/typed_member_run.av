// proves: a gathered type read as itself (`it`) is its `Type` carried as the binary's own data — a
// run reads its name and fields natively as a compile-time const does — in both engines
use @std.meta.{Named, Type}

fn tag(_what: Named, _label: string) {}

type Entry = { kind: Type, name: string }

@tag("a")
type Widget = { label: string, size: int }

@tag("b")
type Gadget = { label: string }

collect xs: List<Entry> = @tag in closure as Entry { kind: it, name: it.name } by it.name

fn widths(es: List<Entry>) -> string { ["${e.kind.name}:${e.kind.fields.length}" for e in es].join(",") }

const settled: List<int> = [e.kind.fields.length for e in xs]

"${widths(xs)} ${settled[0]}${settled[1]}"
