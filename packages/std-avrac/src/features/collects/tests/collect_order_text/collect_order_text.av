// A `by` key compares each literal by its OWN kind: a string argument
// orders lexically, so declared cherry, apple, banana comes out
// apple, banana, cherry.
use @std.meta.{Named}

fn tag(_what: Named, _label: string) {}

@tag("cherry")
fn cherry() {}

@tag("apple")
fn apple() {}

@tag("banana")
fn banana() {}

type MarkInfo = { name: string, args: List<string> }
type Entry = { name: string, mark: MarkInfo }
collect fruits: List<Entry> = @tag in self as Entry { name: it.name, mark: it.mark } by it.mark.args[0]

[fruit.mark.args[0] for fruit in fruits].join(" ")
