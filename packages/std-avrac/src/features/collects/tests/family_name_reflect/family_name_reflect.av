// proves: a family is keyed by its NAME, so declaration order is free —
// the collected enum mints in name order whatever order the declarations
// were written in.
use @std.meta.{Named}

fn family(_t: Named, _key: string, _answer: string) {}

// declared Source, Manifest, Syntax — name order is Manifest, Source,
// Syntax, which is NOT declaration order.
@family("FileId", "SourceFile")
type Source = {}

@family("int", "Manifest")
type Manifest = {}

@family("DeclId", "int")
type Syntax = {}

collect enum FamilyNameProbe = @family in self by it.name

[FamilyNameProbe.all()[it].name for it in 0..FamilyNameProbe.all().length].join(",")
