// proves: a `collect` over marked consts reads each member itself as its
// value (`it`), a literal one and a record one, in its `by` order.
use @std.meta.{Named, Marker}

/// The mark the gathered consts wear.
fn tagged(_d: Named) -> Marker { Marker {} }

type Row = { word: string, n: int }

@tagged
const two: Row = Row { word: "b", n: 2 }

@tagged
const one: Row = Row { word: "a", n: 1 }

type Held = { row: Row }

collect held: List<Held> = @tagged in self as Held { row: it } by it.name

[h.row.word + "${h.row.n}" for h in held].join(",")
