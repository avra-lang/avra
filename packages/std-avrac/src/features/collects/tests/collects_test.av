            refused_in(
                built(
                    "type Entry = { name: string }\ncollect xs: List<Entry> = widget in closure as Entry name: it.name } by it.name\n1",
                ),
                "expected `{` to open the projection",
            )
        }
        then "a field without its `:` names the `:`" {
            refused_in(
                built(
                    "type Entry = { name: string }\ncollect xs: List<Entry> = widget in closure as Entry { name it.name } by it.name\n1",
                ),
                "expected `:` after a projection field's name",
            )
        }
        then "a missing `}` names the `}`" {
            refused_in(
                built(
                    "type Entry = { name: string }\ncollect xs: List<Entry> = widget in closure as Entry { name: it.name by it.name\n1",
                ),
                "expected `}` to close the projection",
            )
        }
        then "a stray word inside the projection speaks once" {
            refused_in(
                built(
                    "type Entry = { name: string }\ncollect xs: List<Entry> = widget in closure as Entry { name: it.name extra } by it.name\n1",
                ),
                "expected `}` to close the projection",
            )
        }
        then "a word after the order names the line's end" {
            refused_in(
                built(
                    "type Entry = { name: string }\ncollect xs: List<Entry> = widget in closure as Entry { name: it.name } by it.name extra\n1",
                ),
                "expected the line to end after the collect",
            )
        }
        then "a nameless `collect enum` names the name" {
            refused_in(
                built("collect enum = widget in package by it.name\n1"),
                "expected the collected enum's name",
            )
        }
        then "a `collect enum` missing `=` names it" {
            refused_in(
                built("collect enum K widget in package by it.name\n1"),
                "expected `=` after the collected enum's name",
            )
        }
        then "a `collect enum` missing `in` names the scope" {
            refused_in(
                built("collect enum K = widget package by it.name\n1"),
                "expected `in` and a scope",
            )
        }
        then "a word after a `collect enum`'s order names the line's end" {
            refused_in(
                built("collect enum K = widget in package by it.name extra\n1"),
                "expected the line to end after the collect",
            )
        }
        then "a `collect { … }` expression still parses as one" {
            !refused_in(built("fn f() -> List<int> { collect { 1 } }\nf().length"), "expected")
        }
    }
}
