                "must handle",
            )
        }
        then "two members that would name the same variant refuse, naming the collect and the variant" {
            refused_in(
                provided(
                    tag_decl() + "collect enum Command = @tag in package by it.name\n1",
                    ui(),
                    modules: [
                        Module { name: "a", text: tag_decl() + "@tag(\"one\")\nfn run() {}\n" },
                        Module { name: "b", text: tag_decl() + "@tag(\"two\")\nfn run() {}\n" },
                    ],
                ),
                "`Command` declares `run` more than once",
