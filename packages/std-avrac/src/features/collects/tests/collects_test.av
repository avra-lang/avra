                "`Wrap` takes type parameters",
            )
        }
        then "a member record spreading another's fields refuses" {
            refused_in(
                provided(
                    numbered_decl() +
                        "type Base = { id: int }\n@numbered(0)\ntype Line = { ..Base, to: int }\n" +
                        "collect enum Shape = @numbered in self by it.mark.args[0] dense\n1",
                    ui(),
                ),
                "`Line` spreads another record's",
            )
        }
        then "a record field of the collect enum's own type, and a fn matching it exhaustively, both resolve — written BEFORE the collect enum's own declaration, pinning `sig_rank`'s order" {
            answered(
                provided(
                    "type Holder = { c: Command }\n" +
                        "fn label(h: Holder) -> string { match h.c { .build -> \"build\", .init -> \"init\" } }\n" +
                        tag_decl() +
                        "@tag(\"x\")\nfn build() {}\n@tag(\"y\")\nfn init() {}\n" +
                        "collect enum Command = @tag in self by it.name\n" +
                        "label(Holder { c: Command.build })",
                    ui(),
                ),
            ) == "build"
        }
        then "adding a member the match does not handle refuses — a new member breaks every match, on purpose" {
            refused_in(
                provided(
                    tag_decl() +
                        "@tag(\"x\")\nfn build() {}\n@tag(\"y\")\nfn init() {}\n@tag(\"z\")\nfn clean() {}\n" +
                        "collect enum Command = @tag in self by it.name\n" +
                        "fn describe(c: Command) -> string { match c { .build -> \"build\", .init -> \"init\" } }\n" +
                        "describe(Command.build)",
                    ui(),
