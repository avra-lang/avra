// proves: a `collect` gathers a member a generator made, by the mark the generator wrote on it —
// each `@query` makes a `@query_definition`, and the list names both.
use @std.program.query_engine.{QueryDefinition, QueryEngine}
use @std.program.saved_query.{ListedQuery, definitions_of, query, query_definition}

@query("summary")
fn doubled(engine: QueryEngine, n: int) -> int { n * 2 }

@query("summary")
fn tripled(engine: QueryEngine, n: int) -> int { n * 3 }

collect listed: List<ListedQuery> = @query_definition in self as ListedQuery { definition: it } by it.name

[d.query_name for d in definitions_of(listed)].join(" ")
