use @std.meta.{Type, Directive, Variant, literal}

export trait Counted {
    static fn derive(t: Type) -> List<Directive> {
        [
            Directive {
                twin: "",
                name: t.name,
                at: t.at,
                source: quote {
                    impl ${t} {
                        static fn count() -> int { ${t.variants.length} }
                        static fn names() -> string { ${literal([said(v) for v in t.variants].join(" "))} }
                    }
                },
            },
        ]
    }
}

fn said(v: Variant) -> string {
    v.name +
        "(" +
        [f.name + ":" + f.ty + "/" + f.kind.name for f in v.fields].join(",") +
        ")@" +
        [a.name for a in v.annotations].join("+")
}
