use @std.meta.{Type, Directive}

/// A second deriving trait with the same generated shape as `Size`.
export trait Twin {
    fn weight() -> int
    static fn derive(t: Type) -> List<Directive> {
        [
            Directive {
                twin: "",
                name: t.name,
                at: t.at,
                source: quote {
                    impl Twin for ${t} { fn weight() -> int { ${t.fields.length} } }
                },
            },
        ]
    }
}
