use @std.meta.{Named, Marker, Type, Directive, literal}

/// A mark a collect gathers; it answers a marker, so it is never run.
export fn seat(_d: Named) -> Marker { Marker {} }

/// Derives one marked const per annotated type, named for it.
export trait Seated {
    static fn derive(t: Type) -> List<Directive> {
        let nm = "${t.name}\$press"
        [
            Directive {
                twin: "",
                name: nm,
                at: t.at,
                source: quote { @seat export const ${nm}: string = ${literal(t.name)} },
            },
        ]
    }
}
