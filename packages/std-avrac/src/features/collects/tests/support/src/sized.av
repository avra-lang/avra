use @std.meta.{Type, Directive}

/// A deriving trait whose generated impl is the record's field count.
export trait Size {
    fn size() -> int
    static fn derive(t: Type) -> List<Directive> {
        [
            Directive {
                twin: "",
                name: t.name,
                at: t.at,
                source: quote {
                    impl Size for ${t} { fn size() -> int { ${t.fields.length} } }
                },
            },
        ]
    }
}
