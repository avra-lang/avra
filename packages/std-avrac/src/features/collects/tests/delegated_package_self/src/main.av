// proves: `collect enum E: T … in package` over members in the enum's OWN
// file derives and delegates as `in self` does.
use @std.meta.{Named}
use @test.counted.{Size}

fn shape(_t: Named, _rank: int) {}

@shape(0)
type Dot = {}

@shape(1)
type Line = { from: int, to: int }

@shape(2)
type Given = { n: int }

impl Size for Given {
    fn size() -> int { 100 }
}

collect enum Shape: Size = @shape in package by it.mark.args[0] dense

fn shown(s: Shape) -> int { s.size() }

"${shown(Shape.Dot)} ${shown(Shape.Line(1, 2))} ${shown(Shape.Given(7))}"
