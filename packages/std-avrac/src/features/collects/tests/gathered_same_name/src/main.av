// proves: the MARK says which enum a member joins — one record
// wearing two marks is a variant of both, and two records of one name
// in two modules are each their own enum's `Collect`.
use @std.meta.{derive, Named}
use @test.counted.{Counted}

export fn expr_node(_t: Named, _rank: int) {}
export fn stmt_node(_t: Named, _rank: int) {}

@expr_node(0)
@stmt_node(0)
export type Error = {}

@derive(Counted)
export collect enum Ex = @expr_node in package by it.mark.args[0] dense

@derive(Counted)
export collect enum St = @stmt_node in package by it.mark.args[0] dense

let e = match Ex.Collect(4) { .Error -> 0, .Collect(n) -> n }
let s = match St.Collect("xy", true) { .Error -> 0, .Collect(w, _) -> w.length }
"${Ex.names()} | ${St.names()} | ${e} ${s}"
