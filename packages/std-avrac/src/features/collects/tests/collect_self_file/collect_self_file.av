// A program TEST is itself a file under a package's own test tree —
// its `collect` must still gather its own sibling declarations, not
// read as empty because its file happens to live under `tests/`.
use @std.meta.{Named}

fn tag(what: Named, label: string) {}

type Entry = { name: string }

@tag("a")
type Widget = { label: string }

@tag("b")
type Gadget = { label: string }

collect xs: List<Entry> = @tag in self as Entry { name: it.name } by it.name

xs.length
