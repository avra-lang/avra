use @std.meta.{Type, Named, Marker, Directive}

export fn factory(_d: Named) -> Marker { Marker {} }

export trait Factory {
    static fn derive(t: Type) -> List<Directive> {
        let generated = "${t.name}_factory"
        [
            Directive {
                twin: "",
                name: generated,
                at: t.at,
                source: quote {
                @factory
                export fn ${generated}() -> int { 7 }
            },
            },
        ]
    }
}
