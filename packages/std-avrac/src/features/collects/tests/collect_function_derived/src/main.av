use @std.meta.{derive}
use derive.factory.{factory, Factory}

@derive(Factory)
type First = {}

@derive(Factory)
type Second = {}

type Entry = { name: string, make: fn() -> int }

collect all: List<Entry> = @factory in package as Entry { name: it.name, make: it } by it.name

"${all.length} ${[e.make() for e in all].map("${it}").join(" ")}"
