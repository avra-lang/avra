// proves: `collect enum E: T = … in package` implements `T` over members
// declared in OTHER files — one derived, one written — as `in self` does.
use parts.{shape}
use @test.counted.{Size}

export collect enum Shape: Size = @shape in package by it.mark.args[0] dense

fn shown(s: Shape) -> int { s.size() }

"${shown(Shape.Dot)} ${shown(Shape.Line(1, 2))} ${shown(Shape.Given(7))}"
