// proves: a collect keyed and projected by `it.module` reads a declaration of
// the ROOT module — whose module name is empty — as the empty module, in
// the key's order and in a row's own text.
use @std.meta.{Named}

fn tag(what: Named, label: string) {}

type Entry = { name: string, home: string }

@tag("a")
type Widget = { label: string }

@tag("b")
type Gadget = { label: string }

collect xs: List<Entry> = @tag in self as Entry { name: it.name, home: it.module } by it.module, it.name

"${xs[0].name}[${xs[0].home}] ${xs[1].name}[${xs[1].home}]"
