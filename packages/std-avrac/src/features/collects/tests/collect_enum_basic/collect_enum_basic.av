// proves: `collect enum` mints one payload-free variant per gathered
// member, named by the member's own declaration name, in `by` order —
// an exhaustive `match` over exactly those variants compiles and runs.
use @std.meta.{Named}

fn command(_what: Named) {}

@command
fn build() {}

@command
fn init() {}

collect enum Command = @command in self by it.name

fn describe(c: Command) -> string {
    match c { .build -> "build", .init -> "init" }
}

"${describe(Command.build)} ${describe(Command.init)} ${Command.build.ordinal} ${Command.init.ordinal}"
