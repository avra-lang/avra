use @std.meta.{Type, Directive, Variant, literal, Named, Marker, reads}

export fn key(_d: Named, .._args: List<string>) -> Marker { Marker {} }

export fn span(_d: Named, .._args: List<string>) -> Marker { Marker {} }

@reads(key)
@reads(span)
export trait Marked {
    static fn derive(t: Type) -> List<Directive> {
        [
            Directive {
                twin: "",
                name: t.name,
                at: t.at,
                source: quote {
                    impl ${t} {
                        static fn marked() -> string { ${literal([said(v) for v in t.variants].join(" "))} }
                    }
                },
            },
        ]
    }

}

fn said(v: Variant) -> string {
    v.name +
        "(" +
        [f.name + [":" + m.name + "/" + m.args.join("/") for m in f.marks].join("") for f in v.fields]
            .join(",") +
        ")"
}
