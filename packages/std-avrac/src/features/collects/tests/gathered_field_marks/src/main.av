// proves: a mark on a member record's field reaches a derive on the
// gathered enum, arguments included.
use @std.meta.{derive, Named}
use marked.{Marked}

fn shape(_t: Named, _rank: int) {}

@shape(0)
type Dot = {}

@shape(1)
type Line = { @key from: int, @span(2, wide) to: int }

@derive(Marked)
collect enum Shape = @shape in self by it.mark.args[0] dense

Shape.marked()
