// proves: `collect enum E: T` implements `T` over its members — each
// call reaches the member record's own impl, arguments carried.
use @std.meta.{Named}

fn node(_t: Named, _rank: int) {}

trait Size {
    fn size() -> int
    fn scaled(by: int) -> int
}

@node(0)
type Dot = { at: int }

impl Size for Dot {
    fn size() -> int { 1 }
    fn scaled(by: int) -> int { by }
}

@node(1)
type Line = { from: int, to: int }

impl Size for Line {
    fn size() -> int { self.to - self.from }
    fn scaled(by: int) -> int { (self.to - self.from) * by }
}

collect enum Shape: Size = @node in self by it.mark.args[0] dense

let d = Shape.Dot(4)
let l = Shape.Line(2, 9)
"${d.size()} ${l.size()} ${d.scaled(3)} ${l.scaled(3)}"
