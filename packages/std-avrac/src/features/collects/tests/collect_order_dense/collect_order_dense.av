// `dense` is an order that is DATA: ordinals 0, 1, 2 … every one
// exactly once, so the sorted order IS the data order.
use @std.meta.{Named}

fn migration(_what: Named, _id: int) {}

@migration(2)
fn third() {}

@migration(0)
fn first() {}

@migration(1)
fn second() {}

type MarkInfo = { name: string, args: List<string> }
type Entry = { name: string, mark: MarkInfo }
collect steps: List<Entry> = @migration in self as Entry { name: it.name, mark: it.mark } by it.mark.args[0] dense

[step.mark.args[0] for step in steps].join(" ")
