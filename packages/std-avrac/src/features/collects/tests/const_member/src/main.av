// proves: a bare `it` over a gathered CONST is its settled value, in both
// engines — the collect reads values, a fn member beside it stays a fn value
use @std.meta.{Marker, Named}

type Entry = { picture: int }

export fn bundled(_d: Named) -> Marker { Marker {} }

@bundled
const a: int = 7

@bundled
const b: int = 9

export collect all: List<Entry> = @bundled in closure as Entry { picture: it } by it.name

"${all.length} ${all[0].picture} ${all[1].picture}"
