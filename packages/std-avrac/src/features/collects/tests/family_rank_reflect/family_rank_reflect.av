// proves: a family mark's RANK arg orders the collected enum, so a
// family is APPENDED, never inserted — the rank is the data, and the
// source order of the declarations is not.
use @std.meta.{Named}

fn family(_t: Named, _rank: int, _key: string, _answer: string) {}

// declared Source, Manifest, Syntax — but their ranks are 2, 0, 1, so
// rank order (Manifest, Syntax, Source) is NOT declaration order.
@family(2, "FileId", "SourceFile")
type Source = {}

@family(0, "int", "Manifest")
type Manifest = {}

@family(1, "DeclId", "int")
type Syntax = {}

collect enum FamilyRankProbe = @family in self by it.mark.args[0] dense

FamilyRankProbe.Manifest.ordinal * 100 +
    FamilyRankProbe.Source.ordinal * 10 +
    FamilyRankProbe.Syntax.ordinal
