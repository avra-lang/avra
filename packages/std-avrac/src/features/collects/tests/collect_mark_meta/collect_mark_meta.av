// proves: a collect reads its gathering mark into `@std/meta`'s `Annotation`, its name and its literal
// args
use @std.meta.{Annotation, Named}

fn step(_what: Named, _label: string, _rank: int) {}

@step("first", 1)
fn one() {}

@step("second", 2)
fn two() {}

type Entry = { name: string, mark: Annotation }
collect steps: List<Entry> = @step in self as Entry { name: it.name, mark: it.mark } by it.name

["${s.name}:${s.mark.name}(${s.mark.args.join(",")})" for s in steps].join(" ")
