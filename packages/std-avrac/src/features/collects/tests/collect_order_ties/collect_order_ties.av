// Two members whose `by` keys tie are BOTH collected, in the order
// they were gathered — a tie never reads one member twice.
use @std.meta.{Named}

fn tag(what: Named, label: string) {}

type Entry = { name: string }

@tag("a")
type Widget = { label: string }

@tag("b")
type Gadget = { label: string }

collect xs: List<Entry> = @tag in self as Entry { name: it.name } by it.module

"${xs[0].name} ${xs[1].name}"
