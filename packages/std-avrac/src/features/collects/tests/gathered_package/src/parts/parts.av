use @std.meta.{Named, derive}
use main.{Shape}
use @test.counted.{Counted}

export fn shape(_t: Named, _rank: int) {}

@shape(0)
export type Dot = {}

@shape(1)
@derive(Counted)
export type Line = { from: int, to: int }

impl Line {
    fn span() -> int { self.to - self.from }
}

export fn rank(s: Shape) -> int {
    match s { .Dot -> 10, .Line(_, to) -> 20 + to, .Box(w, _) -> 30 + w.w }
}
