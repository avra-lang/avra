// proves: `in package` gathers a member from a file nothing imports,
// a payload may name the gathered enum itself, a member may carry a
// `@derive` of its own, and a derive on the enum is handed every
// member — while a member file matches the enum exhaustively.
use @std.meta.{derive}
use @test.counted.{Counted}
use parts.{shape, Line, rank}

export type Width = { w: int }

@derive(Counted)
export collect enum Shape = @shape in package by it.mark.args[0] dense

let b = Shape.Box(Width { w: 5 }, [Shape.Dot, Shape.Line(1, 2)])
let d = match b { .Dot -> 0, .Line(a, c) -> c - a, .Box(w, inner) -> w.w * inner.length }
"${Shape.count()} ${Shape.names()} ${d} ${Line.count()} ${Line { from: 1, to: 4 }.span()} ${rank(b)}"
