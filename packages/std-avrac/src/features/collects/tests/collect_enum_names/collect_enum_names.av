// proves: `v.name` on a collected enum answers the gathered member's
// own declaration name, in the enum's `by` order — never the order the
// members were declared in — through `all()`, an index, a nullable and
// a search by word; a member itself named `name` keeps both readings.
use @std.meta.{Named}

fn family(_t: Named, _rank: int) {}

// declared Source, Manifest, Raised — ranked 2, 0, 1
@family(2)
type Source = {}

@family(0)
type Manifest = {}

@family(1)
type Raised = {}

collect enum Family = @family in self by it.mark.args[0] dense

fn command(_what: Named) {}

@command
fn name() {}

@command
fn other() {}

collect enum Command = @command in self by it.name

fn word(i: int) -> string { Family.all().get(i)?.name ?? "Relation ${i}" }

let held: Family? = Family.Raised
let none: Family? = null
let words = [v.name for v in Family.all()].join(",")
let commands = [c.name for c in Command.all()].join(",")
"${words} | ${word(2)} ${word(1)} ${word(7)} | ${held?.name ?? "-"} ${none?.name ?? "-"} ${Family.all().find(it.name == "Source")?.ordinal ?? -1} | ${commands} ${Command.name.name}"
