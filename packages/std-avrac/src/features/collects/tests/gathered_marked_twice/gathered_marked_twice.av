// proves: a member wearing the gathering mark twice is one variant,
// and its FIRST mark is the one `by it.mark…` reads.
use @std.meta.{Named}

fn shape(_t: Named, _rank: int) {}

@shape(0)
@shape(7)
type Dot = {}

@shape(1)
type Line = { to: int }

collect enum Shape = @shape in self by it.mark.args[0] dense

"${Shape.Dot.ordinal} ${Shape.Line(3).ordinal}"
