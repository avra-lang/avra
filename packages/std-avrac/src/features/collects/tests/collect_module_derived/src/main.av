// proves: a collect ordered by `it.module` gathers declarations a derive of
// another package GENERATED — they land in this root module, whose module
// name is empty — beside the ones written here.
use @std.meta.{derive}
use @test.counted.{Seated, seat}

type Row = { owner: string }

@derive(Seated)
export type Button = {}

@derive(Seated)
export type Field = {}

@seat
const mine: string = "App"

export collect all: List<Row> = @seat in closure as Row { owner: it } by it.module, it.name

"${all.length}: ${all.map(it.owner).join(",")}"
