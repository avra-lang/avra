//! A collect's own laws: the kind and scope words are known, the
//! order is declared, the projected type is the annotation's element,
//! every field it declares is filled exactly once, and every `it`
//! path is in the kind's vocabulary. Nothing here walks a value —
//! a collect carries none; its body is synthesised at lowering
//! (compiler/lower/lower.av) from these same recorded parts.
use core.{StmtId, TypeId, FileId, CollectKind, CollectScope, Projection, Plain, OrderKey, OrderSpec, joined, sorted_by}
use features.{TypeCx, Decl, Decls, nothing, duplicate_names}
use diagnostics.{refusal, Diag}
use @std.errors.{Loc}

/// The generic `it` vocabulary every kind answers, beside its own.
/// `it.line` is in the design (docs/2026_09_22_COLLECTIONS.md) and
/// not built: a Loc is a byte range (`@std/errors`'s `Loc`), and no
/// line index is wired to this projection yet.
export const generic_words: List<string> = ["name", "module", "file", "doc"]

export fn check_collect(mut cx: TypeCx, s: StmtId) {
    let p? = cx.view.store.collect_parts(s) else { return }
    let declared: TypeId = cx.annotated(s, p.ty)
    cx.view.decls.record_const_type(cx.view.file, s, declared)
    if cx.view.types.shape_of(declared) is .Error { return }
    checked_kind(cx, s, p.kind)
    checked_scope(cx, s, p.scope)
    let entry_ty: TypeId? = cx.view.types.element(declared)
    if entry_ty == null { return cx.emit(not_a_list(cx.stmt_loc(s), p.name)) }
    checked_projection(cx, s, p.proj, p.kind, entry_ty!)
    checked_order(cx, s, p.kind, p.scope, p.name, p.order)
}

/// `check_collect`'s twin over `collect enum` — no declared type, no
/// projection: the members ARE the variants, so the one extra law is
/// theirs — two members naming the same variant.
export fn check_collect_enum(mut cx: TypeCx, s: StmtId) {
    let p? = cx.view.store.collect_enum_parts(s) else { return }
    checked_kind(cx, s, p.kind)
    checked_scope(cx, s, p.scope)
    checked_order(cx, s, p.kind, p.scope, p.name, p.order)
    let members = gathered_members(cx.view.decls, p.kind, p.scope, cx.view.file)
    for d in duplicate_names(
        "collect_enum.variant",
        p.name,
        [m.name for m in members],
        cx.stmt_loc(s),
    ) {
        cx.emit(d)
    }
}

/// The kind's own gathering door — A REGISTRY, exhaustive over
/// `CollectKind`: `.Component`'s instances read `Decls.gathered`,
/// `.Annotated`'s every declaration wearing that mark reads
/// `Decls.gathered_by_mark`; `.UnknownKind` was already refused at
/// its own check — it gathers nothing, honestly.
export fn gathered_members(decls: Decls, kind: CollectKind, scope: CollectScope, owner: FileId) -> List<
    Decl,
> {
    match kind {
        .Component(w) -> decls.gathered(w, scope, owner),
        .Annotated(w) -> decls.gathered_by_mark(w, scope, owner),
        .UnknownKind(_) -> [],
    }
}

/// A collect's whole order: required, each key in the kind's
/// vocabulary, no key comparing a whole annotation, no column mixing
/// int and string, and -- under `dense` -- exactly one int column,
/// unique and gap-free from 0.
fn checked_order(
    mut cx: TypeCx,
    s: StmtId,
    kind: CollectKind,
    scope: CollectScope,
    name: string,
    order: OrderSpec,
) {
    if order.keys.is_empty() { return cx.emit(order_required(cx.stmt_loc(s), name)) }
    for k in order.keys { checked_order_key(cx, s, kind, k) }
    for k in order.keys { checked_order_mixed(cx, s, kind, scope, k) }
    if order.dense { checked_dense(cx, s, kind, scope, order.keys) }
}

fn checked_order_key(mut cx: TypeCx, s: StmtId, kind: CollectKind, k: OrderKey) {
    if k.path.length == 1 && k.path[0].of == "mark" && k.index == null {
        return cx.emit(order_whole_mark(cx.stmt_loc(s)))
    }
    if !known_order_path(kind, k.path, k.index) { cx.emit(unknown_path(cx.stmt_loc(s), k.path)) }
}

/// A `by`-key's own vocabulary -- narrower than a projection field's:
/// the four generic words (always comparable text) and an
/// `.Annotated` kind's `mark.args[N]` (typed by the literal). Never
/// `mark` alone (checked_order_key's own refusal) and never a
/// component's own field -- no scalar the compiler can order by.
fn known_order_path(kind: CollectKind, path: List<Plain>, index: int?) -> bool {
    if path.length == 1 && index == null { return generic_words.contains(path[0].of) }
    if path.length == 2 && index != null { return path[0].of == "mark" && path[1].of == "args" && kind is .Annotated }
    false
}

/// Every gathered member's typed value for a `mark.args[N]` key --
/// null when the path names no such key, a member's mark is
/// unmatched, or its arg is not a literal: each the caller's own
/// refusal, never a default.
fn order_values(decls: Decls, kind: CollectKind, scope: CollectScope, owner: FileId, k: OrderKey) -> List<
    SortVal,
>? {
    if k.path.length != 2 || k.path[0].of != "mark" || k.path[1].of != "args" || k.index == null { return null }
    let word? = match kind { .Annotated(w) -> w, rest -> null } else { return null }
    let members = gathered_members(decls, kind, scope, owner)
    let vals = [order_value(decls, d, word, k.index!) for d in members]
    if vals.any(it == null) { return null }
    [v! for v in vals]
}

fn checked_order_mixed(mut cx: TypeCx, s: StmtId, kind: CollectKind, scope: CollectScope, k: OrderKey) {
    let vals? = order_values(cx.view.decls, kind, scope, cx.view.file, k) else { return }
    if vals.any(it is .SInt) && vals.any(it is .SStr) { cx.emit(order_mixed(cx.stmt_loc(s))) }
}

fn checked_dense(mut cx: TypeCx, s: StmtId, kind: CollectKind, scope: CollectScope, keys: List<OrderKey>) {
    if keys.length != 1 { return cx.emit(dense_not_int(cx.stmt_loc(s))) }
    let vals? = order_values(cx.view.decls, kind, scope, cx.view.file, keys[0]) else {
        return cx.emit(dense_not_int(cx.stmt_loc(s)))
    }
    let ns = [v.as_int() for v in vals]
    if ns.any(it == null) { return cx.emit(dense_not_int(cx.stmt_loc(s))) }
    checked_dense_sequence(cx, s, [n! for n in ns])
}

fn checked_dense_sequence(mut cx: TypeCx, s: StmtId, ns: List<int>) {
    for i, n in ns { if ns.index_of(n) != i { return cx.emit(dense_duplicate(cx.stmt_loc(s), n)) } }
    let sorted = sorted_by(ns, before_int)
    for i, n in sorted { if n != i { return cx.emit(dense_gap(cx.stmt_loc(s), i)) } }
}

fn before_int(a: int, b: int) -> bool { a < b }

/// A REGISTRY match over `CollectKind` — the next kind (fn, case)
/// answers here, never a string compare.
fn checked_kind(mut cx: TypeCx, s: StmtId, kind: CollectKind) {
    match kind {
        .Component(_) or .Annotated(_) -> nothing(),
        .UnknownKind(w) -> cx.emit(unknown_kind(cx.stmt_loc(s), w)),
    }
}

fn checked_scope(mut cx: TypeCx, s: StmtId, scope: CollectScope) {
    match scope {
        .Self or .Package or .Closure -> nothing(),
        .UnknownScope(w) -> cx.emit(unknown_scope(cx.stmt_loc(s), w)),
    }
}

fn checked_projection(
    mut cx: TypeCx,
    s: StmtId,
    proj: Projection,
    kind: CollectKind,
    entry_ty: TypeId,
) {
    let elem_name = cx.view.types.name_of(entry_ty)
    if proj.ty.name != elem_name { cx.emit(proj_mismatch(cx.stmt_loc(s), proj.ty.name, elem_name)) }
    let fields? = cx.fields_of(entry_ty) else { return cx.emit(not_a_record(cx.stmt_loc(s), proj.ty.name)) }
    let written = [f.field.of for f in proj.fields]
    let missing = [n for n in fields.names if !written.contains(n)]
    let unknown = [n for n in written if !fields.names.contains(n)]
    if !missing.is_empty() || !unknown.is_empty() { cx.emit(field_mismatch(cx.stmt_loc(s), proj.ty.name, missing, unknown)) }
    for f in proj.fields { if !known_path(kind, f.path, f.index) { cx.emit(unknown_path(cx.stmt_loc(s), f.path)) } }
}

/// Whether `path` is in `kind`'s vocabulary — empty (the bare
/// declaration) always is; one generic word always is; a kind's own
/// word is this REGISTRY's, spelled per kind, never a string list
/// grown ad hoc.
fn known_path(kind: CollectKind, path: List<Plain>, index: int?) -> bool {
    if path.is_empty() { return index == null }
    if path.length == 1 { return index == null && (generic_words.contains(path[0].of) || kind_word(kind, path[0].of)) }
    if path.length == 2 { return index != null && path[0].of == "mark" && path[1].of == "args" && kind is .Annotated }
    false
}

/// A kind's OWN word, past the four generic ones — a REGISTRY over
/// `CollectKind`, since each kind's non-generic vocabulary is its
/// own. A `.Component`'s is the instance's OWN field, by name
/// (`rule in closure as RuleEntry { run: it.run }` reads the `rule`
/// component's `run` field off each instance) — not checked against
/// the component's actual fields here (this door has no component
/// signature in hand, only its word): a name that misses is
/// `field_named`'s DEFECT at lowering (features/values.av), loud
/// rather than a plausible default. A `.Annotated`'s is `mark`
/// alone — the matched annotation's own name and literal args
/// (`collect_field_reg`, compiler/lower/lower.av); an annotated
/// declaration has no instance value to read an arbitrary field
/// off, so nothing past `mark` is honest to accept. `UnknownKind`
/// names no declarations at all, so it answers no word.
fn kind_word(kind: CollectKind, word: string) -> bool {
    match kind { .Component(_) -> true, .UnknownKind(_) -> false, .Annotated(_) -> word == "mark" }
}

fn path_word(path: List<Plain>) -> string {
    if path.is_empty() { return "it" }
    "it.${joined([p.of for p in path], ".")}"
}

// ── voices ──

fn unknown_kind(at: Loc?, kind: string) -> Diag {
    refusal(
        "collect.kind",
        at,
        "`${kind}` is not a declaration kind `collect` gathers yet",
        "in this collect",
        "an imported component's own name — `rule` among them — or `@name` for every declaration wearing that annotation",
    )
}

fn unknown_scope(at: Loc?, scope: string) -> Diag {
    refusal(
        "collect.scope",
        at,
        "`${scope}` is not a collect scope",
        "in this collect",
        "the scopes are: self, package, closure",
    )
}

fn order_required(at: Loc?, name: string) -> Diag {
    refusal(
        "collect.order",
        at,
        "a collection declares its order — `by …`",
        "`${name}` has none",
        "add `by it.field, …` — never file order",
    )
}

fn not_a_list(at: Loc?, name: string) -> Diag {
    refusal(
        "collect.not_a_list",
        at,
        "`collect ${name}` must declare a `List<T>`",
        "declared here",
        "write `List<Row>` as the collection's type",
    )
}

fn not_a_record(at: Loc?, ty: string) -> Diag {
    refusal(
        "collect.not_a_record",
        at,
        "`${ty}` has no fields a projection can fill",
        "as this type",
        "project into a record type",
    )
}

fn proj_mismatch(at: Loc?, written: string, elem: string) -> Diag {
    refusal(
        "collect.proj_type",
        at,
        "`as ${written}` disagrees with the declared element `${elem}`",
        "in this collect",
        "project `as ${elem}`, or declare `List<${written}>`",
    )
}

fn field_mismatch(at: Loc?, ty: string, missing: List<string>, unknown: List<string>) -> Diag {
    refusal(
        "collect.fields",
        at,
        "`${ty}`'s fields are not each filled exactly once — ${field_gap_words(missing, unknown)}",
        "in this projection",
        "fill every declared field once, and no other",
    )
}

fn field_gap_words(missing: List<string>, unknown: List<string>) -> string {
    let words: List<string> = some_word("missing", missing).concat(some_word("unknown", unknown))
    words.join("; ")
}

fn some_word(label: string, names: List<string>) -> List<string> {
    if names.is_empty() { [] } else { ["${label} ${names.join(", ")}"] }
}

fn unknown_path(at: Loc?, path: List<Plain>) -> Diag {
    refusal(
        "collect.path",
        at,
        "`${path_word(path)}` is not a field this kind's declarations answer",
        "in this collect",
        "the generic fields are name, module, file, doc — a kind may add its own",
    )
}

fn order_whole_mark(at: Loc?) -> Diag {
    refusal(
        "collect.order_whole_mark",
        at,
        "`by it.mark` compares a whole annotation",
        "in this collect's order",
        "order by one of its args — `by it.mark.args[0]`",
    )
}

fn order_mixed(at: Loc?) -> Diag {
    refusal(
        "collect.order_mixed",
        at,
        "this `by`-key's column holds both int and string literals",
        "across the gathered declarations",
        "an order compares one type — keep every declaration's arg the same kind",
    )
}

fn dense_not_int(at: Loc?) -> Diag {
    refusal(
        "collect.dense_not_int",
        at,
        "`dense` orders a single int column",
        "this order does not name one",
        "`by` exactly one `it.mark.args[N]` whose literal is always an int",
    )
}

fn dense_duplicate(at: Loc?, n: int) -> Diag {
    refusal(
        "collect.dense_duplicate",
        at,
        "`dense`'s order repeats ${n}",
        "two declarations claim the same position",
        "give each declaration its own index",
    )
}

fn dense_gap(at: Loc?, i: int) -> Diag {
    refusal(
        "collect.dense_gap",
        at,
        "`dense`'s order has a gap at ${i}",
        "no declaration claims this position",
        "a dense order is unique and gap-free from 0",
    )
}
