//! A collect's own laws: the kind and scope words are known, the
//! order is declared, the projected type is the annotation's element,
//! every field it declares is filled exactly once, and every `it`
//! path is in the kind's vocabulary. Nothing here walks a value —
//! a collect carries none; its body is synthesised at lowering
//! (compiler/lower/lower.av) from these same recorded parts.
use core.{
    StmtId,
    TypeId,
    FileId,
    CollectKind,
    CollectScope,
    Projection,
    Plain,
    joined,
    sorted_by,
    list_eq,
}
use features.{TypeCx, Decl, Decls, nothing, duplicate_names}
use diagnostics.{refusal, Diag}
use @std.errors.{Loc}

/// The generic `it` vocabulary every kind answers, beside its own.
/// `it.line` is in the design (docs/2026_09_22_COLLECTIONS.md) and
/// not built: a Loc is a byte range (`@std/errors`'s `Loc`), and no
/// line index is wired to this projection yet.
export const generic_words: List<string> = ["name", "module", "file", "doc"]

export fn check_collect(mut cx: TypeCx, s: StmtId) {
    let p? = cx.view.store.collect_parts(s) else { return }
    let declared: TypeId = cx.annotated(s, p.ty)
    cx.view.decls.record_const_type(cx.view.file, s, declared)
    if cx.view.types.shape_of(declared) is .Error { return }
    checked_kind(cx, s, p.kind)
    checked_scope(cx, s, p.scope)
    if p.order.is_empty() { cx.emit(order_required(cx.stmt_loc(s), p.name)) }
    let entry_ty: TypeId? = cx.view.types.element(declared)
    if entry_ty == null { return cx.emit(not_a_list(cx.stmt_loc(s), p.name)) }
    checked_projection(cx, s, p.proj, p.kind, entry_ty!)
    checked_order(cx, s, p.kind, p.scope, p.order, p.dense)
}

/// `check_collect`'s twin over `collect enum` — no declared type, no
/// projection: the members ARE the variants, so the extra laws are
/// theirs — two members naming the same variant, and a member whose
/// record cannot be a payload.
export fn check_collect_enum(mut cx: TypeCx, s: StmtId) {
    let p? = cx.view.store.collect_enum_parts(s) else { return }
    checked_kind(cx, s, p.kind)
    checked_scope(cx, s, p.scope)
    if p.order.is_empty() { cx.emit(order_required(cx.stmt_loc(s), p.name)) }
    checked_order(cx, s, p.kind, p.scope, p.order, p.dense)
    let members = gathered_members(cx.view.decls, p.kind, p.scope, cx.view.file)
    for d in duplicate_names(
        "collect_enum.variant",
        p.name,
        [m.name for m in members],
        cx.stmt_loc(s),
    ) {
        cx.emit(d)
    }
    for m in members { checked_member(cx, s, p.name, m) }
}

/// A gathered variant's payload is the fields its member's record
/// WRITES, at fixed types: a record that takes type parameters or
/// spreads another's fields refuses.
fn checked_member(mut cx: TypeCx, s: StmtId, owner: string, m: Decl) {
    let record? = cx.view.decls.store_of(m.file).struct_parts(m.stmt) else { return }
    if !record.tparams.is_empty() { cx.emit(generic_member(cx.stmt_loc(s), owner, m.name)) }
    if !record.spreads.is_empty() { cx.emit(spread_member(cx.stmt_loc(s), owner, m.name)) }
}

/// The kind's own gathering door — A REGISTRY, exhaustive over
/// `CollectKind`: `.Component`'s instances read `Decls.gathered`,
/// `.Annotated`'s every declaration wearing that mark reads
/// `Decls.gathered_by_mark`; `.UnknownKind` was already refused at
/// its own check — it gathers nothing, honestly.
export fn gathered_members(decls: Decls, kind: CollectKind, scope: CollectScope, owner: FileId) -> List<
    Decl,
> {
    match kind {
        .Component(w) -> decls.gathered(w, scope, owner),
        .Annotated(w) -> decls.gathered_by_mark(w, scope, owner),
        .UnknownKind(_) -> [],
    }
}

/// A REGISTRY match over `CollectKind` — the next kind (fn, case)
/// answers here, never a string compare.
fn checked_kind(mut cx: TypeCx, s: StmtId, kind: CollectKind) {
    match kind {
        .Component(_) or .Annotated(_) -> nothing(),
        .UnknownKind(w) -> cx.emit(unknown_kind(cx.stmt_loc(s), w)),
    }
}

fn checked_scope(mut cx: TypeCx, s: StmtId, scope: CollectScope) {
    match scope {
        .Self or .Package or .Closure -> nothing(),
        .UnknownScope(w) -> cx.emit(unknown_scope(cx.stmt_loc(s), w)),
    }
}

fn checked_projection(
    mut cx: TypeCx,
    s: StmtId,
    proj: Projection,
    kind: CollectKind,
    entry_ty: TypeId,
) {
    let elem_name = cx.view.types.name_of(entry_ty)
    if proj.ty.name != elem_name { cx.emit(proj_mismatch(cx.stmt_loc(s), proj.ty.name, elem_name)) }
    let fields? = cx.fields_of(entry_ty) else { return cx.emit(not_a_record(cx.stmt_loc(s), proj.ty.name)) }
    let written = [f.field.of for f in proj.fields]
    let missing = [n for n in fields.names if !written.contains(n)]
    let unknown = [n for n in written if !fields.names.contains(n)]
    if !missing.is_empty() || !unknown.is_empty() { cx.emit(field_mismatch(cx.stmt_loc(s), proj.ty.name, missing, unknown)) }
    for f in proj.fields { if !known_path(kind, f.path) { cx.emit(unknown_path(cx.stmt_loc(s), f.path)) } }
}

/// Whether `path` is in `kind`'s vocabulary — empty (the bare
/// declaration) always is; one generic word always is; a kind's own
/// word is this REGISTRY's, spelled per kind, never a string list
/// grown ad hoc.
fn known_path(kind: CollectKind, path: List<Plain>) -> bool {
    if path.is_empty() { return true }
    if path.length > 1 { return false }
    generic_words.contains(path[0].of) || kind_word(kind, path[0].of)
}

/// A kind's OWN word, past the four generic ones — a REGISTRY over
/// `CollectKind`, since each kind's non-generic vocabulary is its
/// own. A `.Component`'s is the instance's OWN field, by name
/// (`rule in closure as RuleEntry { run: it.run }` reads the `rule`
/// component's `run` field off each instance) — not checked against
/// the component's actual fields here (this door has no component
/// signature in hand, only its word): a name that misses is
/// `field_named`'s DEFECT at lowering (features/values.av), loud
/// rather than a plausible default. A `.Annotated`'s is `mark`
/// alone — the matched annotation's own name and literal args
/// (`collect_field_reg`, compiler/lower/lower.av); an annotated
/// declaration has no instance value to read an arbitrary field
/// off, so nothing past `mark` is honest to accept. `UnknownKind`
/// names no declarations at all, so it answers no word.
fn kind_word(kind: CollectKind, word: string) -> bool {
    match kind { .Component(_) -> true, .UnknownKind(_) -> false, .Annotated(_) -> word == "mark" }
}

fn path_word(path: List<Plain>) -> string {
    if path.is_empty() { return "it" }
    "it.${joined([p.of for p in path], ".")}"
}

// ── the `by` keys ──

/// Every `by` key must be in the kind's vocabulary AND yield a value a
/// comparison can read; a key it cannot compare is REFUSED, never
/// sorted by file order. A `dense` order is data: unique and gap-free
/// from 0, a duplicate or a gap refused.
fn checked_order(
    mut cx: TypeCx,
    s: StmtId,
    kind: CollectKind,
    scope: CollectScope,
    order: List<Plain>,
    dense: bool,
) {
    for k in order {
        if !order_known(kind, k) { cx.emit(unknown_order(cx.stmt_loc(s), k)) }
    }
    for k in order { if order_known(kind, k) { checked_column(cx, s, kind, scope, k) } }
    if dense && !order.is_empty() { checked_dense(cx, s, kind, scope, order) }
}

/// Whether `text` names a path the kind answers at all — the
/// vocabulary law, beside the comparability one.
fn order_known(kind: CollectKind, text: Plain) -> bool {
    let path = order_path(text)
    if path.index != null { return mark_args_path(kind, path) }
    if path.segs.length == 1 {
        if generic_words.contains(path.segs[0]) { return true }
        match kind {
            .Component(_) -> true,
            .Annotated(_) -> path.segs[0] == "mark",
            .UnknownKind(_) -> false,
        }
    } else if path.segs.length == 2 {
        match kind {
            .Annotated(_) -> path.segs[0] == "mark" && (path.segs[1] == "name" || path.segs[1] == "args"),
            .Component(_) or .UnknownKind(_) -> false,
        }
    } else {
        false
    }
}

fn mark_args_path(kind: CollectKind, path: OrderPath) -> bool {
    match kind {
        .Annotated(_) -> path.segs.length == 2 && path.segs[0] == "mark" && path.segs[1] == "args",
        .Component(_) or .UnknownKind(_) -> false,
    }
}

/// Whether the key yields a COMPARABLE scalar — a generic text word,
/// `mark.name`, or `mark.args[i]`. A whole mark, a whole args list, a
/// component's own field: refused here, never file-ordered.
fn order_comparable(kind: CollectKind, text: Plain) -> bool {
    let path = order_path(text)
    if path.segs.length == 1 && path.index == null { return generic_words.contains(path.segs[0]) }
    if path.segs.length != 2 { return false }
    match kind {
        .Annotated(_) -> path.segs[0] == "mark" &&
            (path.segs[1] == "name" || path.segs[1] == "args" && path.index != null),
        .Component(_) or .UnknownKind(_) -> false,
    }
}

/// One key's COLUMN across every gathered member: a value the compiler
/// cannot compare, or a column mixing int and string, refuses.
fn checked_column(mut cx: TypeCx, s: StmtId, kind: CollectKind, scope: CollectScope, key: Plain) {
    if !order_comparable(kind, key) { return cx.emit(uncomparable_order(cx.stmt_loc(s), key)) }
    let members = gathered_members(cx.view.decls, kind, scope, cx.view.file)
    let values = [sort_value(cx.view.decls, kind, key, d) for d in members]
    if values.any(it is .Other) { return cx.emit(uncomparable_order(cx.stmt_loc(s), key)) }
    if values.any(it is .Int) && values.any(it is .Text) { cx.emit(mixed_order(cx.stmt_loc(s), key)) }
}

/// `dense`: exactly one key, every member an int, and the sorted
/// values exactly `0 … n-1` — a duplicate or a gap refuses.
fn checked_dense(
    mut cx: TypeCx,
    s: StmtId,
    kind: CollectKind,
    scope: CollectScope,
    order: List<Plain>,
) {
    if order.length != 1 { return cx.emit(dense_shape(cx.stmt_loc(s))) }
    if !order_known(kind, order[0]) || !order_comparable(kind, order[0]) { return }
    let members = gathered_members(cx.view.decls, kind, scope, cx.view.file)
    let values = [sort_value(cx.view.decls, kind, order[0], d) for d in members]
    if !values.all(it is .Int) { return cx.emit(dense_int(cx.stmt_loc(s), order[0])) }
    let ns = sorted_by(
        [match v { .Int(n) -> n, rest -> 0 } for v in values],
        (x: int, y: int) -> x < y,
    )
    let want = [i for i in 0..values.length]
    if !list_eq(ns, want, (x: int, y: int) -> x == y) { cx.emit(dense_gap(cx.stmt_loc(s), order[0])) }
}

// ── voices ──

fn unknown_kind(at: Loc?, kind: string) -> Diag {
    refusal(
        "collect.kind",
        at,
        "`${kind}` is not a declaration kind `collect` gathers yet",
        "in this collect",
        "an imported component's own name — `rule` among them — or `@name` for every declaration wearing that annotation",
    )
}

fn unknown_scope(at: Loc?, scope: string) -> Diag {
    refusal(
        "collect.scope",
        at,
        "`${scope}` is not a collect scope",
        "in this collect",
        "the scopes are: self, package, closure",
    )
}

fn order_required(at: Loc?, name: string) -> Diag {
    refusal(
        "collect.order",
        at,
        "a collection declares its order — `by …`",
        "`${name}` has none",
        "add `by it.field, …` — never file order",
    )
}

fn not_a_list(at: Loc?, name: string) -> Diag {
    refusal(
        "collect.not_a_list",
        at,
        "`collect ${name}` must declare a `List<T>`",
        "declared here",
        "write `List<Row>` as the collection's type",
    )
}

fn not_a_record(at: Loc?, ty: string) -> Diag {
    refusal(
        "collect.not_a_record",
        at,
        "`${ty}` has no fields a projection can fill",
        "as this type",
        "project into a record type",
    )
}

fn proj_mismatch(at: Loc?, written: string, elem: string) -> Diag {
    refusal(
        "collect.proj_type",
        at,
        "`as ${written}` disagrees with the declared element `${elem}`",
        "in this collect",
        "project `as ${elem}`, or declare `List<${written}>`",
    )
}

fn field_mismatch(at: Loc?, ty: string, missing: List<string>, unknown: List<string>) -> Diag {
    refusal(
        "collect.fields",
        at,
        "`${ty}`'s fields are not each filled exactly once — ${field_gap_words(missing, unknown)}",
        "in this projection",
        "fill every declared field once, and no other",
    )
}

fn field_gap_words(missing: List<string>, unknown: List<string>) -> string {
    let words: List<string> = some_word("missing", missing).concat(some_word("unknown", unknown))
    words.join("; ")
}

fn some_word(label: string, names: List<string>) -> List<string> {
    if names.is_empty() { [] } else { ["${label} ${names.join(", ")}"] }
}

fn unknown_path(at: Loc?, path: List<Plain>) -> Diag {
    refusal(
        "collect.path",
        at,
        "`${path_word(path)}` is not a field this kind's declarations answer",
        "in this collect",
        "the generic fields are name, module, file, doc — a kind may add its own",
    )
}

fn unknown_order(at: Loc?, key: Plain) -> Diag {
    refusal(
        "collect.order_key",
        at,
        "`it.${key.of}` is not a field this kind's declarations answer",
        order_at(),
        "an annotated kind orders by `it.mark.name` or `it.mark.args[i]`; a component kind by a generic field",
    )
}

fn uncomparable_order(at: Loc?, key: Plain) -> Diag {
    refusal(
        "collect.order_uncomparable",
        at,
        "`it.${key.of}` is not a value a `by` key can compare",
        order_at(),
        "order by a text field, or by an annotation literal — `it.mark.args[i]` reads the literal's own type",
    )
}

fn mixed_order(at: Loc?, key: Plain) -> Diag {
    refusal(
        "collect.order_mixed",
        at,
        "`it.${key.of}` mixes int and string arguments — a `by` column is one kind",
        order_at(),
        "make every member's argument the same kind, or order by a different field",
    )
}

/// The label every `by` key's refusal shares — one spelling for one
/// seat, so the same sentence is not duplicated per voice.
fn order_at() -> string { "in this collect's order" }

fn generic_member(at: Loc?, owner: string, member: string) -> Diag {
    refusal(
        "collect_enum.member",
        at,
        "a gathered variant carries fixed types — `${member}` takes type parameters",
        "`${owner}` gathers it here",
        "write `${member}`'s fields at the types the variant carries",
    )
}

fn spread_member(at: Loc?, owner: string, member: string) -> Diag {
    refusal(
        "collect_enum.member",
        at,
        "a gathered variant carries the fields its record writes — `${member}` spreads another record's",
        "`${owner}` gathers it here",
        "write the fields in `${member}` itself, in payload order",
    )
}

fn dense_shape(at: Loc?) -> Diag {
    refusal(
        "collect.dense",
        at,
        "`dense` orders ONE key",
        "in this collect",
        "write a single `by it.mark.args[i] dense` key",
    )
}

fn dense_int(at: Loc?, key: Plain) -> Diag {
    refusal(
        "collect.dense",
        at,
        "`dense` needs int arguments — `it.${key.of}` is not",
        order_at(),
        "`dense` is gap-free from 0, so its values are ints",
    )
}

fn dense_gap(at: Loc?, key: Plain) -> Diag {
    refusal(
        "collect.dense",
        at,
        "`it.${key.of}` is not unique and gap-free from 0",
        order_at(),
        "every ordinal 0, 1, 2 … appears exactly once",
    )
}
