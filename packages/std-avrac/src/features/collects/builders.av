//! Parse-time lowering: captures -> the Collect statement. `it` and
//! `by` are NEVER grammar keywords — a keyword literal here would
//! reserve the word across the whole language (breaking every
//! lambda's pronoun, `xs.any(it > 0)`, and every `by: int` seat
//! tree-wide). So each reads an ordinary NAME, checked here to carry
//! the right word. A projection field's optional `.path` is an
//! ANCHORED WINDOW read — the field name always arrives, so
//! `aligned_binds` finds the `.NAME` written in its window, or "" for
//! the bare `it`.
use core.{Stmt, Scoped, TypeRef}
use features.{LangNode, Builder, aligned_binds}
use grammar.{Token}

fn build_collect_decl(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let t = b.type_ref(1)?
    let k = b.token(2)?
    let sc = b.token(3)?
    let pt = b.token(4)?
    let ends? = b.span_end() else { return .Err("defect: a collect declaration without a span — the arena and the grammar disagree") }
    let fns = b.tokens(5)?
    let iws = b.tokens(6)?
    let fps = b.tokens(7)?
    let bws = b.tokens(8)?
    let biws = b.tokens(9)?
    let bks = b.tokens(10)?
    let bad_it? = iws.concat(biws).find(not_word("it")) else { return bad_by(b, bws, n, t, k, sc, pt, fns, fps, bks, ends) }
    .Err("a collect's projection reads its declaration through `it` — found `${bad_it.text}`")
}

fn bad_by(b: Builder, bws: List<Token>, n: Token, t: TypeRef, k: Token, sc: Token, pt: Token, fns: List<Token>, fps: List<Token>, bks: List<Token>, ends: int) -> Result<LangNode, string> {
    let bad? = bws.find(not_word("by")) else {
        let proj_paths = aligned_binds(fns, fps, ends)
        return b.make_stmt(Stmt.Collect(Scoped(n.text), t, [k.text, sc.text, pt.text], [f.text for f in fns], proj_paths, [bk.text for bk in bks]))
    }
    .Err("a collect's order is declared with `by` — found `${bad.text}`")
}

fn not_word(word: string) -> fn(Token) -> bool {
    (t: Token) -> t.text != word
}
