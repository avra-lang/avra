//! Parse-time lowering: captures -> the Collect statement. `it` and
//! `by` are NEVER grammar keywords — a keyword literal here would
//! reserve the word across the whole language (breaking every
//! lambda's pronoun, `xs.any(it > 0)`, and every `by: int` seat
//! tree-wide). So each reads an ordinary NAME, checked here to carry
//! the right word. A projection field's optional `.path` is an
//! ANCHORED WINDOW read — the field name always arrives, so
//! `aligned_binds` finds the `.NAME` written in its window, or "" for
//! the bare `it`.
use core.{Stmt, Scoped, Plain, TypeRef, CollectKind, CollectScope, Projection, ProjField, named_ref}
use features.{LangNode, Builder, aligned_binds}
use grammar.{Token}

fn build_collect_decl(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let t = b.type_ref(1)?
    let k = b.token(2)?
    let iks = b.tokens(3)?
    let jks = b.tokens(4)?
    let sc = b.token(5)?
    let pt = b.token(6)?
    let ends? = b.span_end() else { return .Err("defect: a collect declaration without a span — the arena and the grammar disagree") }
    let fns = b.tokens(7)?
    let iws = b.tokens(8)?
    let fps = b.tokens(9)?
    let bws = b.tokens(10)?
    let biws = b.tokens(11)?
    let bks = b.tokens(12)?
    let kind? = kind_of(k, iks, jks) else { return .Err("a collect's kind is a bare word, or `instance of` a component word — found `${k.text} ${joined_words(iks)}`") }
    let bad_it? = iws.concat(biws).find(not_word("it")) else { return bad_by(b, bws, n, t, kind, sc, pt, fns, fps, bks, ends) }
    .Err("a collect's projection reads its declaration through `it` — found `${bad_it.text}`")
}

fn joined_words(ts: List<Token>) -> string {
    [t.text for t in ts].join(" ")
}

fn bad_by(b: Builder, bws: List<Token>, n: Token, t: TypeRef, k: CollectKind, sc: Token, pt: Token, fns: List<Token>, fps: List<Token>, bks: List<Token>, ends: int) -> Result<LangNode, string> {
    let bad? = bws.find(not_word("by")) else {
        let proj = Projection { ty: named_ref(pt.text), fields: proj_fields(fns, fps, ends) }
        return b.make_stmt(Stmt.Collect(Scoped(n.text), t, k, scope_of(sc), proj, [Plain(bk.text) for bk in bks]))
    }
    .Err("a collect's order is declared with `by` — found `${bad.text}`")
}

fn not_word(word: string) -> fn(Token) -> bool {
    (t: Token) -> t.text != word
}

/// A collect's kind: a bare word (`fn`, `case` — not yet gathered,
/// so always `UnknownKind`), or `instance of <component>` — the
/// vocabulary `collect_members` (compiler/lower/lower.av) answers.
/// Absent iff the written `of` is some other word.
fn kind_of(k: Token, iks: List<Token>, jks: List<Token>) -> CollectKind? {
    let of? = iks.first() else { return CollectKind.UnknownKind(k.text) }
    let comp? = jks.first() else { return null }
    if k.text != "instance" || of.text != "of" { return null }
    CollectKind.Instance(comp.text)
}

fn scope_of(sc: Token) -> CollectScope {
    if sc.text == "self" { return CollectScope.Self }
    if sc.text == "package" { return CollectScope.Package }
    if sc.text == "closure" { return CollectScope.Closure }
    CollectScope.UnknownScope(sc.text)
}

/// Each field's fill: the name always arrives, so `aligned_binds`
/// finds the `.NAME` written in its window, or "" for the bare `it`
/// — folded here into the empty path that means the same thing.
fn proj_fields(fns: List<Token>, fps: List<Token>, ends: int) -> List<ProjField> {
    let paths = aligned_binds(fns, fps, ends)
    [ProjField { field: Plain(f.text), path: path_of(paths[j]) } for j, f in fns]
}

fn path_of(word: string) -> List<Plain> {
    if word == "" { [] } else { [Plain(word)] }
}
