//! Parse-time lowering: captures -> the Collect statement. `it`, `by`
//! and `dense` are the feature's SOFT words — matched where its rules
//! write them, never reserved. A projection field's optional `.path` is
//! an ANCHORED WINDOW read — the field name always arrives, so
//! `aligned_binds` finds the `.NAME` written in its window, or "" for
//! the bare `it`.
use core.{Stmt, Expr, Scoped, Plain, CollectKind, CollectScope, Projection, ProjField, named_ref}
use features.{LangNode, Builder, aligned_binds}
use grammar.{Token, TokenKind}

fn build_collect_decl(b: Builder) -> Result<LangNode, string> {
    let ends? = b.span_end() else {
        return .Err(
            "defect: a collect declaration without a span — the arena and the grammar disagree",
        )
    }
    let proj = Projection {
        ty: named_ref((b.token(4)?).text),
        fields: proj_fields(b.tokens(5)?, b.tokens(6)?, ends),
    }
    let gathering = Stmt
        .Collect(
            Scoped((b.token(0)?).text),
            b.type_ref(1)?,
            kind_of(b.token(2)?),
            scope_of(b.token(3)?),
            proj,
            order_paths(b.tokens(7)?, b.tokens(8)?, b.tokens(9)?, ends),
        )
    b.dense_stmt(gathering, b.tokens(10)?)
}

/// `collect enum Name = kind in scope by …` — `build_collect_decl`'s
/// twin with no declared type and no projection.
fn build_collect_enum_decl(b: Builder) -> Result<LangNode, string> {
    let ends? = b.span_end() else {
        return .Err("defect: a collect enum without a span — the arena and the grammar disagree")
    }
    let traits = [b.store.alloc_expr(Expr.Ident(Scoped(t.text)), t.span) for t in b.tokens(7)?]
    let gathering = Stmt
        .CollectEnum(
            Scoped((b.token(0)?).text),
            kind_of(b.token(1)?),
            scope_of(b.token(2)?),
            order_paths(b.tokens(3)?, b.tokens(4)?, b.tokens(5)?, ends),
            traits,
        )
    b.dense_stmt(gathering, b.tokens(6)?)
}

impl Builder {
    /// The collect as this build's statement, marked `dense` when the word
    /// was written.
    fn dense_stmt(gathering: Stmt, dense: List<Token>) -> Result<LangNode, string> {
        let made = self.make_stmt(gathering)?
        if dense.is_empty() { return .Ok(made) }
        let s? = match made { .NStmt(id) -> id, rest -> null } else { return .Ok(made) }
        self.store.mark_collect_dense(s, true)
        .Ok(made)
    }
}

/// Each order entry's `it` path, encoded as ONE text: its segments
/// joined by `.`, and its `[i]` element when one was written. The
/// boundary between entries is the `it` anchor's own position, the
/// same window `aligned_binds` reads for a projection field.
fn order_paths(biws: List<Token>, segs: List<Token>, idxs: List<Token>, ends: int) -> List<Plain> {
    [order_key(biws, segs, idxs, j, ends) for j in 0..biws.length]
}

fn order_key(biws: List<Token>, segs: List<Token>, idxs: List<Token>, j: int, ends: int) -> Plain {
    let lo = biws[j].span.hi
    let hi = if j + 1 < biws.length { biws[j + 1].span.lo } else { ends }
    let mine = [t for t in segs if t.span.lo >= lo && t.span.lo < hi]
    let idx = [t for t in idxs if t.span.lo >= lo && t.span.lo < hi].first()
    Plain(order_key_text(mine, idx))
}

fn order_key_text(segs: List<Token>, idx: Token?) -> string {
    let path = [t.text for t in segs].join(".")
    match idx {
        t? -> "${path}[${t.text}]"
        null -> path
    }
}

/// A collect's kind word: `@name`, the token carrying its `@`, is
/// `Annotated` — every declaration wearing that annotation. A BARE word
/// is a component's own name (`model`, `rule`), as written, for
/// `collect`'s own laws to judge.
fn kind_of(k: Token) -> CollectKind {
    if k.kind == TokenKind.Pkg { return CollectKind.Annotated(k.text.substring(1, k.text.length)) }
    CollectKind.Component(k.text)
}

fn scope_of(sc: Token) -> CollectScope {
    if sc.text == "self" { return CollectScope.Self }
    if sc.text == "package" { return CollectScope.Package }
    if sc.text == "closure" { return CollectScope.Closure }
    CollectScope.UnknownScope(sc.text)
}

/// Each field's fill: the name always arrives, so `aligned_binds`
/// finds the `.NAME` written in its window, or "" for the bare `it`
/// — folded here into the empty path that means the same thing.
fn proj_fields(fns: List<Token>, fps: List<Token>, ends: int) -> List<ProjField> {
    let paths = aligned_binds(fns, fps, ends)
    [ProjField { field: Plain(f.text), path: path_of(paths[j]) } for j, f in fns]
}

fn path_of(word: string) -> List<Plain> {
    if word == "" { [] } else { [Plain(word)] }
}
