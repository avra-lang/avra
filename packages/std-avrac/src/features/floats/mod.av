//! Float to int — the four roundings, each answering `Result<int, ToInt>`.
//! The range is checked on the float before the one conversion runs, so
//! the conversion is defined wherever it is reached; a refused float
//! answers the failure with the float it was. Int to float — `n.float()`,
//! total: every int has a nearest float, exact to 2^53, ties to even above.
use features.{LanguageFeature, MethodRow, ReceiverEffect, unknown_answer}

export fn floats() -> LanguageFeature {
    let methods = table<MethodRow> {
        name    | takes    | check       | lower       | effect              | answers
        "floor" | on_float | check_floor | lower_floor | ReceiverEffect.Read | unknown_answer
        "ceil"  | on_float | check_ceil  | lower_ceil  | ReceiverEffect.Read | unknown_answer
        "round" | on_float | check_round | lower_round | ReceiverEffect.Read | unknown_answer
        "trunc" | on_float | check_trunc | lower_trunc | ReceiverEffect.Read | unknown_answer
        "float" | on_int   | check_float | lower_float | ReceiverEffect.Read | float_answer
    }
    LanguageFeature floats {
        methods: methods
    }
    floats
}
