// proves: each rounding answers the int its name gives, `round` ties
// away from zero, and the range is checked at the exact boundaries of
// an int: NaN, both infinities, 2^63 and the floats around it on each side.
fn show(r: Result<int, ToInt>) -> string {
    match r {
        .Ok(n) -> "${n}",
        .Err(.NotANumber) -> "not a number",
        .Err(.TooLarge(v)) -> "too large",
        .Err(.TooSmall(v)) -> "too small",
    }
}

println(show(2.5.round()))
println(show((-2.5).round()))
println(show(2.7.floor()))
println(show((-2.7).floor()))
println(show(2.2.ceil()))
println(show((-2.7).trunc()))
println(show(2.9.trunc()))
println(show((0.0 / 0.0).floor()))
println(show((1.0 / 0.0).ceil()))
println(show((-1.0 / 0.0).trunc()))
println(show(9223372036854776000.0.trunc()))
println(show(9223372036854775000.0.trunc()))
println(show((-9223372036854776000.0).floor()))
println(show((-9223372036854778000.0).floor()))
