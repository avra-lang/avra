// proves: `n.float()` is an int's nearest float — exact to 2^53, ties to
// even past it, total for every int — and floors back to the int it was.
fn exact(n: int) -> bool { (n.float().floor() catch _ -> 0) == n }

fn floored(f: float) -> int { f.floor() catch _ -> 0 }

fn shown(n: int) -> string { "${n.float()}" }

let big = 9007199254740993
let past = big.float() == 9007199254740992.0
let tie = 9007199254740995.float() == 9007199254740996.0
let widest = (0 - 9223372036854775807 - 1).float() == 0.0 - 9223372036854776000.0
"${shown(3)} ${shown(0 - 7)} ${exact(9007199254740992)} ${past} ${tie} ${widest} ${floored(2.5 + 3.float())}"
