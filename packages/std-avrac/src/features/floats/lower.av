//! Meaning: three range checks, in order, each a region over the float's
//! own comparison. NaN is the one value unequal to itself; a float at or
//! past 2^63 and one below -2^63 are refused. The bit patterns name the
//! exact boundaries: the float just below 2^63 is in range, and so is -2^63.
use core.{Reg, Rounding, BinOp, ExprId, Type}
use features.{LowerCx, MethodCall}

const no_result = "a float method without its Result survived typing"
const TWO_63 = 4890909195324358656
const MINUS_TWO_63 = -4332462841530417152

fn lower_floor(mut cx: LowerCx, mc: MethodCall) -> Reg { rounded_reg(cx, mc, Rounding.Floor) }
fn lower_ceil(mut cx: LowerCx, mc: MethodCall) -> Reg { rounded_reg(cx, mc, Rounding.Ceil) }
fn lower_round(mut cx: LowerCx, mc: MethodCall) -> Reg { rounded_reg(cx, mc, Rounding.Nearest) }
fn lower_trunc(mut cx: LowerCx, mc: MethodCall) -> Reg { rounded_reg(cx, mc, Rounding.Trunc) }

fn lower_float(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.int_float(cx.reg_of(mc.subject)) }

fn rounded_reg(mut cx: LowerCx, mc: MethodCall, mode: Rounding) -> Reg {
    let x = cx.reg_of(mc.subject)
    let nan = cx.bin(Type.Bool, BinOp.Ne, x, x)
    cx
        .region(nan, mc.e) { cx -> refused_reg(cx, mc.e, "NotANumber", []) } else { cx -> too_large_reg(cx, mc.e, mode, x) }
}

fn too_large_reg(mut cx: LowerCx, e: ExprId, mode: Rounding, x: Reg) -> Reg {
    let limit = cx.float_const(TWO_63)
    let high = cx.bin(Type.Bool, BinOp.Ge, x, limit)
    cx
        .region(high, e) { cx -> refused_reg(cx, e, "TooLarge", [x]) } else { cx -> too_small_reg(cx, e, mode, x) }
}

fn too_small_reg(mut cx: LowerCx, e: ExprId, mode: Rounding, x: Reg) -> Reg {
    let limit = cx.float_const(MINUS_TWO_63)
    let low = cx.bin(Type.Bool, BinOp.Lt, x, limit)
    cx
        .region(low, e) { cx -> refused_reg(cx, e, "TooSmall", [x]) } else { cx -> accepted_reg(cx, e, mode, x) }
}

/// The in-range answer: the converted int in the method's `Ok`.
fn accepted_reg(mut cx: LowerCx, e: ExprId, mode: Rounding, x: Reg) -> Reg {
    let answer = cx.float_int(mode, x)
    let sig? = cx.variants_at(e) else { return cx.lower_defect(e, no_result) }
    let ok? = sig.tag_of("Ok") else { return cx.lower_defect(e, "a Result without Ok survived typing") }
    cx.tagged_value(cx.shape_at(e), ok, [answer])
}

/// The refusal: a `ToInt` variant carrying the float, inside the Err of
/// the method's own `Result`. Both are built by the enum verbs ordinary
/// variant literals lower through.
fn refused_reg(mut cx: LowerCx, e: ExprId, which: string, carried: List<Reg>) -> Reg {
    let sides? = cx.view.types.res_parts(cx.type_at(e)) else { return cx.lower_defect(e, no_result) }
    let to_int? = cx.variants_of(sides.err) else { return cx.lower_defect(e, "ToInt without its variants survived typing") }
    let tag? = to_int.tag_of(which) else { return cx.lower_defect(e, "a ToInt variant without its tag survived typing") }
    let inner = cx.tagged_value(cx.view.types.shape_of(sides.err), tag, carried)
    let sig? = cx.variants_at(e) else { return cx.lower_defect(e, no_result) }
    let err? = sig.tag_of("Err") else { return cx.lower_defect(e, "a Result without Err survived typing") }
    cx.tagged_value(cx.shape_at(e), err, [inner])
}
