//! The lowering rule: `when` adds NOTHING to the IR — it desugars
//! onto the region brackets `if` built, one nested region per arm,
//! each later condition lowering INSIDE the previous arm's else.
//! Native short-circuits exactly as eval does.
use core.{ExprId, Reg}
use features.{LowerCx, foreign_node, arm_end, open_region, close_region}

fn when_lower(mut cx: LowerCx, e: ExprId) -> Reg {
    match cx.view.store.expr(e) {
        .When(conds, values, fallback) -> arm_reg(cx, e, conds, values, fallback, 0),
        _ -> foreign_node(cx, e),
    }
}

/// Arm `i` as a region: its condition decides between its value and
/// the rest of the ladder; past the last arm stands the `_` arm.
/// Each level mints its own merge register, typed as the whole
/// `when` — children first, result last, at every depth.
fn arm_reg(mut cx: LowerCx, e: ExprId, conds: List<ExprId>, values: List<ExprId>, fallback: ExprId, i: int) -> Reg {
    if i == conds.length { return cx.reg_of(fallback) }
    let c = cx.reg_of(conds[i])
    open_region(cx, c)
    let t = cx.reg_of(values[i])
    arm_end(cx, t)
    let rest = arm_reg(cx, e, conds, values, fallback, i + 1)
    close_region(cx, e, rest)
}
