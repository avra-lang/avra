//! Parse-time lowering: parallel cond and value captures plus the
//! `_` arms -> the When node. The grammar lets the `_` arm sit in any
//! slot (each slot is an ordered choice, `_` first — a greedy star
//! cannot be told to stop early); the arms' laws are the checker's,
//! where they carry a span — the node keeps every `_` arm written.
use core.{Expr}
use features.{LangNode, Builder, zip_defect_of}

fn build_when(b: Builder) -> Result<LangNode, string> {
    let conds = b.exprs(0)?
    let values = b.exprs(1)?
    if conds.length != values.length {
        return .Err(zip_defect_of("when arms and values"))
    }
    b.make_expr(Expr.When(conds, values, b.exprs(2)?))
}
