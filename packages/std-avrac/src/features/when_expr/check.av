//! The typing rule: every condition is a `bool`; every arm answers
//! the `_` arm's type — the total arm anchors, since it always
//! exists. Error absorbs everywhere.
use core.{ExprId, TypeId}
use features.{TypeCx}

fn when_type(mut cx: TypeCx, e: ExprId) -> TypeId {
    match cx.view.store.expr(e) {
        .When(conds, values, fallback) -> {
            for c in conds { cx.require_bool(c, "a `when` condition", "this decides an arm") }
            arms_type(cx, e, values, fallback)
        }
        _ -> cx.error_type,
    }
}

fn arms_type(mut cx: TypeCx, e: ExprId, values: List<ExprId>, fallback: ExprId) -> TypeId {
    if cx.errored(fallback) { return cx.error_type }
    cx.arms_agree("type.mismatch", "when", "the `_` arm", e, fallback, values)
}
