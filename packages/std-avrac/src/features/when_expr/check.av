//! The typing rule: every condition is a `bool`; every arm answers
//! the `_` arm's type — the total arm anchors, since it always
//! exists. Error absorbs everywhere.
use core.{ExprId, TypeId}
use features.{TypeCx, require_bool, arms_agree}

fn when_type(mut cx: TypeCx, e: ExprId) -> TypeId {
    match cx.view.store.expr(e) {
        .When(conds, values, fallback) -> {
            for c in conds { require_bool(cx, c, "a `when` condition", "this decides an arm") }
            arms_type(cx, values, fallback)
        }
        _ -> cx.error_type,
    }
}

fn arms_type(mut cx: TypeCx, values: List<ExprId>, fallback: ExprId) -> TypeId {
    if cx.shape_at(fallback) is .Error { return cx.error_type }
    arms_agree(cx, "type.mismatch", "when", "the `_` arm", fallback, values)
}
