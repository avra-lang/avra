//! The typing rule of `when`: each condition is a `bool`, each value checks against the seat, and
//! the `when` is where its arms meet, the seat's type first.
use core.{Checking, Checks, ExprId, Expected, Meeting, SignedType, owned_type, Decision, Seating}
use core.expr.{When}

impl Checks for When {
    fn checked(mut cx: Checking, e: ExprId, expected: Expected) -> SignedType? {
        for c in self.conds { let _ = cx.check_seated(c, owned_type("bool"), Seating.Condition(Decision.When)) }
        let arm = if expected is .Dropped { Expected.Free } else { expected }
        let values = self.values.concat(self.defaults)
        let first = [cx.check(v, arm) for v in values]
        cx.arms_named(values, expected, Meeting.When)
        let again? = cx.pinning(first, expected) else { return cx.arms_met(values, first, expected) }
        cx
            .arms_met(
                values,
                [t ?? cx.check(values[at], Expected.Exactly(again)) for at, t in first],
                expected,
            )
    }
}
