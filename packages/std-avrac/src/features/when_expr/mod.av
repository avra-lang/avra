//! `when { c -> a, c -> b, _ -> d }` — multi-way choice as an
//! expression. Subjectless, comma-separated, and TOTAL: the `_` arm
//! is the checker's law, spoken where the arms carry spans, so the
//! node keeps every `_` arm the rule wrote. The `when` keyword anchor
//! merges ahead of the spine's NAME branch.
use features.{LanguageFeature}
use @std.grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use diagnostics.{DiagCode}
export fn when_expr() -> LanguageFeature {
    let codes = table<DiagCode> {
        kind             | summary
        "type.when_arms" | "a `when` ends on its one `_` arm"
    }
    LanguageFeature when_expr {
        gram: grammar {
            primary = "when" "{" ( BREAK | "," | "_" "->" defaults:expression | conds:expression "->" values:expression )* "}" @expect("}", "expected `}` to close the `when`") -> Expr.When
        }
        diags: codes
    }
    when_expr
}
