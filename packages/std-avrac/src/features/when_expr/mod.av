//! `when { c -> a, c -> b, _ -> d }` — multi-way choice as an
//! expression. Subjectless, comma-separated, and TOTAL: the `_` arm
//! is grammar, not convention. The `when` keyword anchor merges
//! ahead of the spine's NAME branch.
use features.{LanguageFeature, BuilderRow}
use grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}

export fn when_expr() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name        | build
        "when_expr" | build_when
    }
    component LanguageFeature f {
        name = "when_expr"
        docs = "`when { <cond> -> <expr>, ..., _ -> <expr> }`; the first true arm answers."
        gram = grammar {
            primary = "when" "{" ( BREAK | "," | "_" "->" d:expression | c:expression "->" v:expression )* "}" @expect("}", "expected `}` to close the `when`") -> when_expr(c, v, d)
        }
        builders = rows
    }
    f
}
