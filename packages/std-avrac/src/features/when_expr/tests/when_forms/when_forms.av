// proves: a `when` bound by a `let`, and a `when` whose arms are statements writing a `mut`.
fn grade(n: int) -> string {
    let g = when {
        n > 90 -> "a"
        n > 50 -> "b"
        _ -> "c"
    }
    g + "!"
}
fn bump(n: int) -> int {
    mut t = n
    when {
        t > 5 -> { t = t - 5 }
        _ -> { t = t + 1 }
    }
    t
}
"${grade(95)} ${grade(60)} ${grade(1)} ${bump(9)} ${bump(2)}"
