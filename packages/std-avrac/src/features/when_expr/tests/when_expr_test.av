// Multi-way choice, vertically: the keyword anchor parses, every
// arm types against the total `_` arm, the first true arm answers
// and nothing after it runs, and the IR is nothing but the regions
// `if` already built.
use @std.avrac.language.{analyze_source, render_ir, Lowered}

/// A program's printed value, or "<refused>".
fn shown(source: string) -> string {
    analyze_source(source).ran() ?? "<refused>"
}

fn ir_of(source: string) -> Lowered {
    analyze_source(source).lowered()
}

spec "features/when_expr" {
    given "the expression" {
        then "the first true arm answers; the `_` arm catches" {
            shown("let n = 75\nwhen { n < 60 -> \"F\", n < 80 -> \"pass\", _ -> \"ace\" }") == "pass" &&
                shown("when { 1 < 2 -> 10, _ -> 20 }") == "10" &&
                shown("when { 2 < 1 -> 10, _ -> 20 }") == "20"
        }
        then "a when rides in a fn body and in arithmetic" {
            shown("fn floor(n: int) -> int { when { n < 0 -> 0, _ -> n } }\nfloor(0 - 5) + floor(7)") == "7"
        }
    }
    given "wrong shapes" {
        then "a non-bool condition points at itself" {
            let a = analyze_source("when { 1 -> 2, _ -> 3 }")
            a.diagnostics.length == 1 &&
                a.report().contains("a `when` condition is a `bool`, found `int`")
        }
        then "a disagreeing arm names itself and the anchor" {
            let a = analyze_source("when { true -> 1, _ -> \"x\" }")
            a.diagnostics.length == 1 &&
                a.report().contains("a `when`'s arms disagree: `int` vs the `_` arm's `string`")
        }
    }
    given "the IR, as `avra ir` prints it" {
        then "a when is nothing but nested regions — no new instructions" {
            let expected = """scope application {
  r0 = int 1
  r1 = int 2
  r2 = r0 < r1
  if r2 {
    r3 = int 10
    yield r3
  } else {
    r4 = int 20
    yield r4
  } -> r5
  r6 = call avra_int_text(r5)
  call avra_puts(r6)
  release r6
}
ret 0"""
            render_ir(ir_of("when { 1 < 2 -> 10, _ -> 20 }")) == expected
        }
    }
}
