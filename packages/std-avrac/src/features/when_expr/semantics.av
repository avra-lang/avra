//! The when NodeSemantics: dispatch only. Typing lives in check.av;
//! lowering — the MEANING — in lower.av.
use core.{ExprId, TypeId, Reg, Heirs}
use features.{TypeCx, LowerCx, Meaning, ResolveCx, nothing}

use core.expr.{When}

impl Heirs for When {
    fn heirs() -> List<ExprId> { self.values.concat(self.defaults) }
}

impl Meaning for When {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        if default_law(cx, e, self.conds, self.values, self.defaults) { return cx.error_type }
        for c in self.conds { cx.require_bool(c, "a `when` condition", "this decides an arm") }
        arms_type(cx, e, self.values, self.defaults)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        let fallback? = self.defaults.first() else {
            return cx.lower_defect(e, "a `when` with no `_` arm survived typing")
        }
        arm_reg(cx, e, self.conds, self.values, fallback, 0)
    }
}
