//! The when NodeSemantics: dispatch only. Typing lives in check.av,
//! evaluation in eval.av, lowering in lower.av.
use core.{Expr, ExprId, TypeId, NodeStore, Reg, concat}
use features.{NodeSemantics, ResolveCx, TypeCx, EvalCx, LowerCx, nothing}

export type WhenSemantics = { }

impl NodeSemantics for WhenSemantics {
    fn kids(self, e: Expr) -> List<ExprId> {
        match e {
            .When(conds, values, fallback) -> concat<ExprId>(concat<ExprId>(conds, values), [fallback]),
            _ -> [],
        }
    }

    fn resolve(self, cx: ResolveCx, e: ExprId) {
        nothing()
    }

    fn type_of(self, cx: TypeCx, e: ExprId) -> TypeId {
        when_type(cx, e)
    }

    fn eval(self, cx: EvalCx, e: ExprId) -> ExprId {
        when_eval(cx, e)
    }

    fn lower(self, cx: LowerCx, e: ExprId) -> Reg {
        when_lower(cx, e)
    }

    fn printed(self, store: NodeStore, e: ExprId) -> string? {
        null
    }
}
