//! Tasks: `spawn e` runs `e` beside the spawner and answers its handle,
//! a `Task<T>`; `t.await` parks until `e` answers and answers it. A task
//! is joined when the last thing holding it ends — a binding, a list —
//! so none outlives the block it was made in.
use features.{LanguageFeature, BuilderRow, PropertyRow, TypeRow, no_law, no_variants, TypeArgs}
use core.{Type}
use grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use diagnostics.{DiagCode}

export fn tasks() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name    | build
        "spawn" | build_spawn
    }
    let properties = table<PropertyRow> {
        name    | takes   | check       | lower
        "await" | on_task | check_await | lower_await
        "done"  | on_task | check_done  | lower_done
    }
    let codes = table<DiagCode> {
        kind               | id      | summary
        "type.task_escape" | "F2101" | "a task is joined by the block that spawned it"
    }
    let types = table<TypeRow> {
        name   | arity | slots | judge  | builds     | variants
        "Task" | 1     | true  | no_law | task_shape | no_variants
    }
    component LanguageFeature f {
        name = "tasks"
        docs = "`spawn e` runs `e` as a task beside the spawner and answers its `Task<T>`; `t.await` parks until it answers; `t.done` asks without parking. A task is joined where the last binding or list holding it ends."
        gram = grammar {
            primary = "spawn" v:expression -> spawn(v)
        }
        builders = rows
        properties = properties
        diags = codes
        types = types
    }
    f
}

fn on_task(t: Type) -> bool { t is .Task }

fn task_shape(args: TypeArgs) -> Type { Type.Task(args.parts[0]) }
