//! WHAT THE UNBROKEN LAW SAYS: an `@unbroken` fn lets no other task run inside it, and each way a
//! node of it may is refused in its own words. Spoken by both paths that judge the law.
use diagnostics.{Voice}

/// A call to a fn that may let another task run.
export fn broken_call_said(owner: string, callee: string) -> Voice {
    Voice {
        message: "`${owner}` is `@unbroken`, and `${callee}` may let another task run",
        label: "called here",
        help: "mark `${callee}` `@unbroken` if nothing in it can wait, or make the call outside `${owner}`",
    }
}

/// A call that leaves a seat to a default that may wait.
export fn broken_default_said(owner: string, seat: string) -> Voice {
    Voice {
        message: "`${owner}` is `@unbroken`, and the default this call leaves to `${seat}` may wait",
        label: "called here",
        help: "pass `${seat}` explicitly, or make the call outside `${owner}`",
    }
}

/// A call through a value, which may be any fn.
export fn broken_value_said(owner: string) -> Voice {
    Voice {
        message: "`${owner}` is `@unbroken`, and a call through a value may be any fn",
        label: "called here",
        help: "call the fn by its name, and mark it `@unbroken`",
    }
}

/// A spawn, whose task is joined where the fn's scope ends.
export fn broken_spawn_said(owner: string) -> Voice {
    Voice {
        message: "`${owner}` is `@unbroken`, and a task it spawns is joined where its scope ends",
        label: "spawned here",
        help: "spawn outside `${owner}`",
    }
}

/// A read or a row that waits.
export fn broken_wait_said(owner: string, what: string) -> Voice {
    Voice {
        message: "`${owner}` is `@unbroken`, and `${what}` waits",
        label: "waits here",
        help: "wait outside `${owner}`",
    }
}
