//! The lowering rule of `spawn`: the runtime is handed a box over the body's task lift, which answers
//! the body's value in a one-cell list, then what the body captures; the scope holding the task joins
//! it as it ends.
use core.{ExprId, Lowering, Lowers, Reg, rt_sig_of}
use core.expr.{Lambda}

impl Lowers for Spawn {
    fn lowered(mut cx: Lowering, e: ExprId) -> Reg {
        let ty? = cx.type_at(self.body) else { return cx.unlowered(e) }
        let parts? = cx.store.lambda_parts(self.body) else { return cx.unlowered(e) }
        let span? = cx.store.expr_span(self.body) else { return cx.missed_as("a spawn no source wrote") }
        let lift = cx.lift(Lambda { params: [], body: parts.body }, ty, span, cx.program, true)
        cx.kept_lift(lift)
        let captures = [cx.held(cx.bound(name)!) for name in lift.lanes]
        if captures.any((c) -> cx.layout_of(c).inline()) { return cx.missed_as("a capture laid inline") }
        let task = cx.fn_box(cx.laid_out(ty), lift.body.symbol, captures)
        cx.call_row(cx.layout_at(e), rt_sig_of("avra_task_spawn")!, [task])
    }
}
