//! Parse-time lowering: `spawn e` is a task over the zero-seat lambda
//! `e` becomes, so its captures are a closure's — copies, taken here.
//! `within limit body` reads the limit's own `ms` field — the span the
//! runtime arms a scope with — so one field read serves typing and
//! lowering alike.
use core.{Expr, Stmt, Plain}
use features.{LangNode, Builder}

fn build_spawn(b: Builder) -> Result<LangNode, string> {
    b.make_expr(Expr.Spawn(b.expr_node(Expr.Lambda([], b.expr(0)?))))
}

fn build_within(b: Builder) -> Result<LangNode, string> {
    let limit = b.expr_node(Expr.Prop(b.expr(0)?, Plain("ms")))
    b.make_expr(Expr.Within(limit, b.expr(1)?))
}

/// `yield x` — a statement, so an expression statement over `Emit`,
/// which answers nothing; the producer in scope supplies the sink.
fn build_yield(b: Builder) -> Result<LangNode, string> {
    b.make_stmt(Stmt.ExprStmt(b.expr_node(Expr.Emit(b.expr(0)?))))
}

/// `produce<T> { … }` — the block as written, at the rendezvous
/// capacity; the sink is the producer's, reached by a `yield` inside
/// rather than by a parameter.
fn build_produce(b: Builder) -> Result<LangNode, string> {
    b.make_expr(Expr.Produce(b.type_ref(0)?, null, b.expr(1)?))
}

/// `produce<T>(cap) { … }` — the same, with a capacity.
fn build_produce_cap(b: Builder) -> Result<LangNode, string> {
    b.make_expr(Expr.Produce(b.type_ref(0)?, b.expr(1)?, b.expr(2)?))
}
