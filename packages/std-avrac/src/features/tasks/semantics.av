//! The tasks NodeSemantics: dispatch only. Typing lives in check.av;
//! lowering — the MEANING — in lower.av. A spawn's body is HIDDEN from
//! the walk: its lambda resolves and types here, and lowers only as the
//! task's own lift — never as a closure nobody calls.
use core.{Expr, ExprId, TypeId, Reg}
use features.{NodeSemantics, ResolveCx, TypeCx, LowerCx, nothing}

export type TasksSemantics = {}

impl NodeSemantics for TasksSemantics {
    fn kids(e: Expr) -> List<ExprId> {
        // a feature cannot enumerate OTHER features' variants
        match e { rest -> [] }
    }

    fn heirs(e: Expr) -> List<ExprId> {
        // a feature cannot enumerate OTHER features' variants
        match e { rest -> [] }
    }

    fn resolve(mut cx: ResolveCx, e: ExprId) {
        // a feature cannot enumerate OTHER features' variants
        match cx.view.store.expr(e) { .Spawn(body) -> cx.walk(body), rest -> nothing() }
    }

    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId { task_expr_type(cx, e) }

    fn lower(mut cx: LowerCx, e: ExprId) -> Reg { task_expr_reg(cx, e) }
}
