//! The tasks NodeSemantics: dispatch only. Typing lives in check.av;
//! lowering — the MEANING — in lower.av. A spawn's body is HIDDEN from
//! the walk: its lambda resolves and types here, and lowers only as the
//! task's own lift — never as a closure nobody calls.
use core.{ExprId, Kids, Heirs}

/// A spawn's body is HIDDEN: the lambda resolves and types here, and
/// lowers only as the task's own lift.
impl Kids for Spawn {
    fn kids() -> List<ExprId> { [] }
}
impl Kids for Produce {
    fn kids() -> List<ExprId> { [] }
}
impl Kids for Channel {
    fn kids() -> List<ExprId> { [] }
}

impl Kids for Within {
    fn kids() -> List<ExprId> { [self.limit] }
}
impl Heirs for Within {
    // the body answers for the expression, so the seat's want flows there
    fn heirs() -> List<ExprId> { [self.body] }
}
