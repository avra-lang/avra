//! The task nodes: variants of `Expr` (core/nodes.av), declared
//! where their meaning is.
use core.{expr_node, At, Control, ExprId, Node, TypeId, Reg}
use core.marks.{apart}

use features.{Meaning, ResolveCx, TypeCx, LowerCx}

/// `spawn e` — `e` runs as a task beside the spawner; the node is
/// its task handle. `body` is the zero-seat lambda `e` became.
@expr_node
@apart
export type Spawn = { body: ExprId }

impl Meaning for Spawn {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        cx.walk(self.body)
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId { task_expr_type(cx, e) }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg { task_expr_reg(cx, e) }
}

/// `within limit { body }` — the body runs with a deadline arming the
/// calling task: every park under it ends by `limit` from now, and
/// the body answers as written. The body stays INLINE, so `return`
/// and `?` leave through the enclosing fn — the reason this is a head
/// keeping its brace and never a lambda. `limit` is the span's own
/// milliseconds, read at the field it is made of.
@expr_node
export type Within = { limit: ExprId, body: ExprId }

impl Meaning for Within {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        cx.walk(self.body)
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId { within_expr_type(cx, e) }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg { task_expr_reg(cx, e) }
}
