//! The lowering rule — the ONE meaning: `spawn e` hands the runtime a
//! closure over `e`'s TASK lift, which answers `e`'s value in a
//! one-cell list — one box for every shape, so the runtime makes one
//! call; `.await` joins and reads that cell.
use core.{ExprId, Reg, Type, TypeId, RtFlag, BinOp, ResSides}
use features.{LowerCx, MethodCall}
use diagnostics.{refusal}

fn task_expr_reg(mut cx: LowerCx, e: ExprId) -> Reg {
    // a feature cannot enumerate OTHER features' variants
    match cx.view.store.expr(e) {
        .Spawn(body) -> cx.task_spawn(cx.shape_at(e), task_box(cx, body)),
        .Within(limit, body) -> within_reg(cx, e, limit, body),
        rest -> cx.lower_defect(e, "a foreign node reached the task lowering"),
    }
}

/// The body lowers in a one-turn loop whose end is the scope's own
/// landing: the scope opens inside the turn and ends through the
/// frame, so a `return` or a `?` out of the body runs it, as a
/// `defer` there would, and an unwind jumps here rather than leaving
/// the fn. The epilogue answers the body, or the deadline.
fn within_reg(mut cx: LowerCx, e: ExprId, limit: ExprId, body: ExprId) -> Reg {
    let sides? = cx.view.types.res_parts(cx.type_at(e)) else { return cx.lower_defect(e, "a `within` without its Result survived typing") }
    let body_ty = cx.type_at(body)
    let limit_reg = cx.reg_of(limit)
    // The body's answer and the scope end's landing, each written on
    // its own path and read after the loop, in the epilogue.
    let answer = cx.seeded_cell(body_ty, cx.hollow_of(body_ty))
    let landing = cx.seeded_cell(cx.type(int), cx.const_int(0))
    cx.loop_start()
    let at = cx.loops.length - 1
    cx.loop_cond(cx.const_bool(true))
    cx.scope_enter()
    let scope = cx.fiber_within(Type.Int, limit_reg)
    cx.open_landing(scope, landing)
    cx.stored(answer, cx.reg_of(body))
    cx.scope_exit(null)
    cx.close_landing()
    cx.jumped(at, false)
    cx.loop_end()
    let landed = cx.bin(Type.Bool, BinOp.Ne, cx.loaded_as(cx.type(int), landing), cx.const_int(0))
    let whole = cx.type_at(e)
    cx
        .region(landed, e) { cx ->
            cx.failed(whole, timed_out(cx, e, sides, limit_reg))
        } else { cx ->
            passed_or_answered(cx, whole, body_ty, answer)
        }
}

/// The landing was another's, or none: still unwinding, the frames
/// above have run and the fn leaves; else the body's own answer stands.
fn passed_or_answered(mut cx: LowerCx, whole: TypeId, body_ty: TypeId, answer: Reg) -> Reg {
    cx
        .region_as(cx.flag_read(RtFlag.Unwinding), whole) { cx ->
            cx.unwinds()
            cx.hollow_of(whole)
        } else { cx ->
            cx.okayed(whole, cx.loaded_as(body_ty, answer))
        }
}

/// The `TimedOut` the scope that asked answers: the span it was given
/// — a `Duration` is its `ms` — and the frames its unwind left.
fn timed_out(mut cx: LowerCx, e: ExprId, sides: ResSides, limit: Reg) -> Reg {
    let fields? = cx.view.decls.fields_of_type(sides.err) else { return cx.lower_defect(e, "a `TimedOut` that is no record survived typing") }
    let frames? = fields.types.last() else { return cx.lower_defect(e, "a `TimedOut` without its frames survived typing") }
    cx.packed_struct(sides.err, [limit, frames_left(cx, frames)])
}

/// The unwind's frame list, read back as the `List<Frame>` it is.
fn frames_left(mut cx: LowerCx, frames: TypeId) -> Reg {
    let sh = cx.view.types.shape_of(frames)
    let frame = match sh { .List(of) -> cx.view.types.shape_of(of), _ -> Type.Ptr }
    let n = cx.unwind_count(Type.Int)
    let out = cx.array_sized(sh, n)
    let w = cx.counted_to(n)
    let here = cx.turn_open(w)
    cx.push_slot(out, cx.unwind_at(frame, here))
    cx.loop_end()
    out
}

/// The closure the task runs: `body`'s captures, and its task lift.
fn task_box(mut cx: LowerCx, body: ExprId) -> Reg {
    let caps = cx.capture_regs(body)
    cx.fn_box(cx.shape_at(body), cx.box_size(1 + caps.length), cx.lift_task(body), caps)
}

fn lower_await(mut cx: LowerCx, _e: ExprId, task: Reg, ty: TypeId) -> Reg {
    cx.awaited(task, ty)
}

/// The caught `.await`: a join that passes no cancel on and answers how
/// the task ended — its `Cancelled`'s two cells, or nothing. `failed`
/// runs over the record when it ended cancelled; else the task is done,
/// and the join that reads its answer is free.
fn caught_await(
    mut cx: LowerCx,
    e: ExprId,
    task: Reg,
    ty: TypeId,
    failed: fn(mut LowerCx, Reg) -> Reg,
) -> Reg {
    let cancelled? = cancelled_of(cx.view) else { return cx.lower_defect(e, "a caught await without `Cancelled` survived typing") }
    let ended = cx.type(List<int>?)
    cx
        .presence(cx.task_join_caught(cx.view.types.shape_of(ended), task), ended, e) { cx, cells -> failed(cx, cx.unboxed_at(cells, 0, cancelled)) } else { cx -> lower_await(cx, e, task, ty) }
}

fn lower_done(mut cx: LowerCx, e: ExprId, task: Reg, _ty: TypeId) -> Reg {
    cx.task_done(cx.shape_at(e), task)
}

fn lower_cancel(mut cx: LowerCx, mc: MethodCall) -> Reg {
    cx.task_cancel(cx.reg_of(mc.subject))
    cx.hollow_of(cx.type_at(mc.e))
}

fn lower_new(mut cx: LowerCx, mc: MethodCall) -> Reg {
    cx.grown_box(cx.shape_at(mc.e), cx.box_size(4), [])
}

fn lower_push(mut cx: LowerCx, mc: MethodCall) -> Reg {
    let first? = mc.args.first() else { return cx.lower_defect(mc.e, "a push without its task survived typing") }
    cx.tasks_push(cx.reg_of(mc.subject), cx.reg_of(first))
    cx.hollow_of(cx.type_at(mc.e))
}

// ── `produce` and `yield`: typed, not yet lowered ──

/// `yield`'s send is TYPED and not yet lowered: the producer's task
/// ownership arrives with FLOW 05 S2, its lowering with S3.
fn emit_reg(mut cx: LowerCx, e: ExprId) -> Reg {
    unlowered(cx, e, "a `yield`")
    cx.result(e)
}

/// `produce` is TYPED and not yet lowered — see `emit_reg`.
fn produce_reg(mut cx: LowerCx, e: ExprId) -> Reg {
    unlowered(cx, e, "a `produce`")
    cx.result(e)
}

/// A shape that types and has no lowering yet, named by `what`.
fn unlowered(mut cx: LowerCx, at: ExprId, what: string) {
    cx
        .out
        .voices
        .speak(
            refusal(
                "flow.produce",
                cx.view.loc_of(at),
                "`produce` and `yield` are typed and not yet lowered",
                "${what} stands here",
                "the carrier's `open_channel` waits until the producer's ownership lands (FLOW 05 S2/S3)",
            ),
        )
}
