// proves: who asked the cancel that ended a task is on its record —
// the asker's id — in both engines
extern fn avra_task_pending() -> ptr
extern fn avra_task_cancel(t: ptr)
extern fn avra_task_ended_by(t: ptr) -> int
extern fn avra_task_id() -> int

let pending = avra_task_pending()
let by = spawn {
    let me = avra_task_id()
    avra_task_cancel(pending)
    avra_task_ended_by(pending) == me
}
"${by.await}"
