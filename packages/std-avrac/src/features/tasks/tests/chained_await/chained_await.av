// proves: `?.await` on a nullable task joins the task it carries and answers what it answered, and
// answers absence where there is none.
let t: Task<int>? = null
let u: Task<int>? = spawn 3
mut ts = [spawn 1]
ts.push(spawn 2)
let f = ts.first()
"${t == null} ${u?.await ?? 0} ${(f?.await ?? 0) + ts.length} ${t?.await ?? -1}"
