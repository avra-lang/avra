// proves: a two-task program passes in every order a schedule picks, and a
// minute's sleep in a test takes a minute of its clock and none of the
// wall — evaluated and compiled alike.
use @std.time.{secs, sleep, now_ms}

let started = now_ms()
let a = spawn {
    sleep(secs(60))
    1
}
let b = spawn {
    sleep(secs(60))
    2
}
"${a.await + b.await} ${now_ms() - started}"
