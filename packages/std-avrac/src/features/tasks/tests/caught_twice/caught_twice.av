// proves: a task is caught as often as it is asked — the second join is
// free, a cancelled task's arm runs each time and an answer reads again
use @std.task.{open_channel, Sink}
use @std.time.{secs, sleep}

fn idle(up: Sink<int>) -> string {
    let _ = up.post(1)
    sleep(secs(60))
    "never"
}

fn said(n: int) -> string { "said ${n}" }

let up = open_channel<int>(1)
let t = spawn idle(up.sink)
let _ = up.source.next()
t.cancel()
let a = t.await catch c -> { "first ${c.by}" }
let b = t.await catch c -> { "second ${c.by}" }
let u = spawn said(7)
let x = u.await catch _ -> { "cut" }
let y = u.await catch _ -> { "cut" }
"${a}, ${b}, ${x}, ${y}"
