// proves: a `within` scope's end answers whether the cancel it met was
// its own — 0 when nothing stands — in both engines
extern fn avra_fiber_within(ms: int) -> int
extern fn avra_fiber_within_end(id: int) -> int

let a = avra_fiber_within(1000)
let b = avra_fiber_within(1000)
"${avra_fiber_within_end(b)} ${avra_fiber_within_end(a)}"
