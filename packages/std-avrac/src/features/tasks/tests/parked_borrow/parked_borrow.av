// proves: a task parked with a box in its stack keeps that box — the
// cell may replace what it holds while the task waits, and the parked
// reader still reads what it borrowed
use @std.task.{open_channel, Sink}
use @std.time.{ms, sleep}

type Holder = { tag: int, items: List<int> }

fn reader(c: Cell<Holder>, up: Sink<int>) -> int {
    let h = c.get()
    let _ = up.post(1)
    sleep(ms(40))
    h.tag + (h.items.first() ?? 0)
}

fn shown() -> int {
    let c = Cell.new(Holder { tag: 5, items: [7, 8] })
    let up = open_channel<int>(1)
    let t = spawn reader(c, up.sink)
    let _ = up.source.next()
    c.set(Holder { tag: 1, items: [] })
    t.await
}

"${shown()}"
