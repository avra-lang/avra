// proves: a `within` whose body answers a managed value — the answer
// rides the loop's cell out of the scope, in both engines
use @std.time.{ms, secs}

fn name(n: int) -> string {
    within ms(50) { "n=${n}" } catch _ -> ""
}

let joined = within secs(1) { ["a", "b"].join("-") } catch _ -> ""
"${name(1)} ${joined}"
