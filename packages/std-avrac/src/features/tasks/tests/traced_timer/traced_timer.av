// proves: a join of a timer's task is traced alike by both engines —
// a task nothing runs, woken by the timer
// (tools/flow_trace_engines.sh reads the trace).
use @std.time.{now_ns}

extern fn avra_task_at(at_ns: int) -> ptr
extern fn avra_task_join(t: ptr) -> ptr
extern fn avra_array_get(a: ptr, i: int) -> int

let t = avra_task_at(now_ns() + 3000000)
"${avra_array_get(avra_task_join(t), 0)}"
