// proves: a cancel met inside a `within` body lands at the scope's own
// landing — the statements after the may-call never run
use @std.time.{ms, secs, sleep}

let after = Cell.new(0)
let t = spawn {
    within secs(10) {
        sleep(ms(50))
        after.set(1)
        7
    }
    after.set(2)
    0
}
t.cancel()
sleep(ms(200))
"${after.get()}"
