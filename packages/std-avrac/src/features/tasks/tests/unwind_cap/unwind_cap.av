//! proves: the unwind's frame list is capped at sixteen, the middle
//! dropped and the newest kept — the same list in both engines
extern fn avra_unwind_push(frame: ptr)
extern fn avra_unwind_count() -> int
extern fn avra_unwind_at(i: int) -> ptr
extern fn avra_array_sized(n: int) -> ptr
extern fn avra_array_push(a: ptr, v: int)
extern fn avra_array_get(a: ptr, i: int) -> int

fn mark(n: int) -> ptr {
    let a = avra_array_sized(1)
    avra_array_push(a, n)
    a
}

let f0 = mark(0)
let f1 = mark(1)
let f2 = mark(2)
let f3 = mark(3)
let f4 = mark(4)
let f5 = mark(5)
let f6 = mark(6)
let f7 = mark(7)
let f8 = mark(8)
let f9 = mark(9)
let f10 = mark(10)
let f11 = mark(11)
let f12 = mark(12)
let f13 = mark(13)
let f14 = mark(14)
let f15 = mark(15)
let f16 = mark(16)
let f17 = mark(17)
let f18 = mark(18)
let f19 = mark(19)

avra_unwind_push(f0)
avra_unwind_push(f1)
avra_unwind_push(f2)
avra_unwind_push(f3)
avra_unwind_push(f4)
avra_unwind_push(f5)
avra_unwind_push(f6)
avra_unwind_push(f7)
avra_unwind_push(f8)
avra_unwind_push(f9)
avra_unwind_push(f10)
avra_unwind_push(f11)
avra_unwind_push(f12)
avra_unwind_push(f13)
avra_unwind_push(f14)
avra_unwind_push(f15)
avra_unwind_push(f16)
avra_unwind_push(f17)
avra_unwind_push(f18)
avra_unwind_push(f19)

"${avra_unwind_count()} ${avra_array_get(avra_unwind_at(8), 0)} ${avra_array_get(avra_unwind_at(15), 0)}"
