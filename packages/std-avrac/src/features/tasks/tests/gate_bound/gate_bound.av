// proves: a gate is let go when the box a program holds dies — made
// and dropped many times over, the process holds no more for it,
// evaluated as compiled.
extern fn avra_gate_new() -> List<int>
extern fn avra_gate_claim(g: List<int>) -> int
extern fn avra_mem_live() -> int

/// `n` gates, each made, asked once and dropped: what the asks answered.
fn churned(n: int) -> int {
    mut claimed = 0
    for _i in 0..n {
        let g = avra_gate_new()
        claimed = claimed + avra_gate_claim(g)
    }
    claimed
}

let warm = churned(10000)
let before = avra_mem_live()
let asked = churned(50000)
let grown = avra_mem_live() - before
"${warm} ${asked} ${grown < 1000000}"
