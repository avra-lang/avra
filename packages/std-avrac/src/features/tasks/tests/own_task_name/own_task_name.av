// proves: a program's own `type Task` is the bare name's meaning, while `Task<T>` is still the spawn handle — both in one file, eval == native
type Task = { id: int, title: string }

fn work() -> int { 40 }

impl Task {
    fn label() -> string { "${self.id}:${self.title}" }
}

let mine = Task { id: 2, title: "own" }
let handle = spawn work()
"${mine.label()} ${handle.await + 2}"
