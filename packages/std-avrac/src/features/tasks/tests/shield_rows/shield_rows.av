// proves: the shield's row pair runs the same in both engines — a frame's
// cold exit brackets its deferred calls on the program's own task and on a
// spawned one, and the bracket nests
extern fn avra_fiber_shield_enter()
extern fn avra_fiber_shield_leave()
extern fn avra_puts(s: string)

fn work() -> int {
    avra_fiber_shield_enter()
    avra_puts("work")
    avra_fiber_shield_leave()
    3
}

fn main_body() -> int {
    avra_fiber_shield_enter()
    avra_puts("outer")
    let t = spawn { work() }
    let v = t.await
    avra_fiber_shield_leave()
    v
}

"${main_body()} done"
