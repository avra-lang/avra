//! proves: under a schedule a spinning `while` yields at a DRAWN turn —
//! the same turn twice running — while schedule 0 never preempts, and
//! both engines draw alike.
extern fn avra_sched_seed(schedule: int)
extern fn avra_sched_settle() -> int
extern fn avra_array_sized(n: int) -> ptr
extern fn avra_array_push(a: ptr, v: int)
extern fn avra_array_get(a: ptr, i: int) -> int

/// A task that spins a `while`, noting its name at every turn.
fn spinner(name: int, log: ptr) -> int {
    mut i = 0
    while i < 300 {
        avra_array_push(log, name)
        i = i + 1
    }
    0
}

/// The order two spinners leave under `schedule`.
fn order(schedule: int) -> string {
    let log = avra_array_sized(640)
    avra_sched_seed(schedule)
    let a = spawn spinner(1, log)
    let b = spawn spinner(2, log)
    let _ = a.await + b.await
    let _ = avra_sched_settle()
    ["${avra_array_get(log, i)}" for i in 0..600].join("")
}

let one = order(7)
let two = order(7)
let zero = order(0)
"${one == two} ${one == zero} ${one.length} ${zero.length}"
