// proves: a join is traced alike by both engines — who waits for whom,
// and whose end wakes them (tools/flow_trace_engines.sh reads the trace).
use @std.time.{ms, sleep}

fn slept(wait: int) -> int {
    sleep(ms(wait))
    wait
}

let a = spawn slept(3)
let b = spawn { a.await + 1 }
"${b.await} ${a.await}"
