// proves: a `break` or a `continue` written in a `within` body leaves or
// turns the loop the program wrote around it, never the `within`'s own —
// in both engines
use @std.time.{ms}

mut n = 0
mut skipped = 0
while true {
    n = n + 1
    let _ = within ms(500) {
        if n < 3 {
            skipped = skipped + 1
            continue
        }
        if n == 3 { break }
        0
    }
}
"${n} ${skipped}"
