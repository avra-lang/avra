// proves: a wait set hears a SPAWNED task's end — while it runs, and
// at once when it is already done — beside a gate nobody claims.
use @std.time.{ms, sleep}

extern fn avra_wait_gate(g: ptr, arm: int, member: int)
extern fn avra_wait_task(t: Task<int>, arm: int, member: int)
extern fn avra_wait_park() -> int
extern fn avra_gate_new() -> ptr

fn said(claim: int) -> string { "${claim >> 32}:${claim & 4294967295}" }

fn slept(wait: int) -> int {
    sleep(ms(wait))
    wait
}

let g = avra_gate_new()
let t = spawn slept(3)
avra_wait_gate(g, 0, 1)
avra_wait_task(t, 1, 2)
let running = said(avra_wait_park())
avra_wait_gate(g, 0, 1)
avra_wait_task(t, 1, 3)
let spent = said(avra_wait_park())
let u = spawn slept(2)
let v = spawn {
    avra_wait_task(u, 2, 4)
    avra_wait_park() & 4294967295
}
"${running} ${spent} ${t.await} ${v.await} ${u.await}"
