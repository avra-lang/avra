//! The typing rules: `spawn e` is a `Task` of what `e` answers, and
//! `.await` answers it back; `.done` is a `bool`.
use core.{ExprId, TypeId, Type, ResSides, TypeRef}
use features.{TypeCx, FileView, FailureView, Refusal, MethodCall, this_is}
use diagnostics.{refusal}

fn task_expr_type(mut cx: TypeCx, e: ExprId) -> TypeId {
    // a feature cannot enumerate OTHER features' variants
    match cx.view.store.expr(e) { .Spawn(body) -> spawned(cx, body), rest -> cx.error_type }
}

/// `within limit { body }` answers `Result<T, TimedOut>`: what the body
/// answers, or the deadline it ran past. The limit is a method read
/// (`Duration.ms()`), typed with the body so a limit that is no span
/// refuses in the member law's own words.
fn within_expr_type(mut cx: TypeCx, e: ExprId) -> TypeId {
    match cx.view.store.expr(e) {
        .Within(limit, body) -> {
            let _ = cx.walk_type(limit)
            if cx.errored(limit) { return cx.error_type }
            let answer = cx.walk_type(body)
            if cx.errored_ty(answer) { return cx.error_type }
            if cx.view.types.shape_of(answer) is .Void { return answers_nothing(cx, body) }
            let late? = timed_out_type(cx) else { return no_timed_out(cx, e) }
            // LICENSED compiler.interned_res: `answer` and `late` are interned ids — a computed pair has no literal spelling
            cx.view.types.intern(Type.Res(answer, late))
        },
        rest -> cx.error_type,
    }
}

/// The `TimedOut` record `@std/time` declares — the span a block was
/// given and the frames its unwind left. Absent when the program loads
/// no `@std/time`.
fn timed_out_type(cx: TypeCx) -> TypeId? {
    let decl? = cx.view.decls.package_decl("@std.time", "TimedOut") else { return null }
    let _ = cx.view.decls.sig(decl)
    cx.view.types.intern(Type.Struct(decl, "TimedOut"))
}

/// The body is hidden from the walk — its lambda lowers only as the
/// task's lift — so it is typed here, and its answer is the task's.
fn spawned(mut cx: TypeCx, body: ExprId) -> TypeId {
    cx.task_bodies.push(body)
    let fty = cx.walk_type(body)
    let _ = cx.task_bodies.pop()
    if cx.errored_ty(fty) { return cx.error_type }
    let arrow? = cx.view.types.arrow_parts(fty) else { return cx.error_type }
    cx.view.types.intern(Type.Task(arrow.answer))
}

fn check_await(cx: TypeCx, _e: ExprId, ty: TypeId) -> TypeId {
    cx.view.types.task_answer(ty) ?? cx.error_type
}

/// A caught `await` recovers the task's answer or, when its end was a
/// cancel, the `Cancelled` record — the failure view `catch` reads.
fn await_view(cx: TypeCx, answer: TypeId) -> FailureView {
    let cancelled? = cancelled_of(cx.view) else { return FailureView.Unloaded(cancelled_unloaded()) }
    FailureView.Sides(ResSides { ok: answer, err: cancelled })
}

/// The prelude's `Cancelled` — who asked, where the cancel was met.
/// Null when the program sees no prelude, as a lone file does not.
fn cancelled_of(view: FileView) -> TypeId? {
    let decl = view.decls.prelude_named("Cancelled")?
    let _ = view.decls.sig(decl)
    view.types.intern(Type.Struct(decl, "Cancelled"))
}

fn check_done(cx: TypeCx, _e: ExprId, _ty: TypeId) -> TypeId { cx.type(bool) }

/// `t.cancel()` — the task ends cancelled at its next cancel point; its
/// answer is nobody's.
fn check_cancel(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    if !cx.seated(mc, "Task.cancel", []) { return cx.error_type }
    cx.type(void)
}

/// `Tasks.new()` — an empty owner.
fn check_new(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    if !cx.seated(mc, "Tasks.new", []) { return cx.error_type }
    cx.view.types.intern(Type.Tasks)
}

/// `owner.push(t)` — any task, whatever it answers: nobody reads it.
fn check_push(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    if mc.args.length != 1 {
        cx.wrong_arity(mc.e, "push", 1, mc.args.length)
        return cx.error_type
    }
    let t = mc.args[0]
    if cx.errored(t) { return cx.error_type }
    if cx.view.types.task_answer(cx.type_at(t)) == null { return not_a_task(cx, t) }
    cx.type(void)
}

/// `yield x` — the enclosing `produce`'s sink takes `x`, and the
/// statement itself answers nothing. A `yield` no producer encloses
/// is refused here, by name.
fn emit_type(mut cx: TypeCx, e: ExprId, value: ExprId) -> TypeId {
    let elem? = cx.sinks.last() else { return yield_without(cx, e) }
    let _ = cx.walk_type(value)
    if cx.errored(value) { return cx.error_type }
    if !cx.accepts(value, elem) { return yield_unfit(cx, value, elem) }
    cx.type(void)
}

/// A `yield` the producer's element does not take.
fn yield_unfit(mut cx: TypeCx, value: ExprId, elem: TypeId) -> TypeId {
    let got = cx.name_at(value)
    let want = cx.view.types.name_of(elem)
    cx
        .spoken(
            refusal(
                "type.mismatch",
                cx.loc_of(value),
                "`yield` sends the producer's element `${want}`, found `${got}`",
                this_is(got),
                "send what the sink takes",
            ),
        )
}

/// `produce<T>(cap) { … }` answers `Source<T>`: the block runs with a
/// `Sink<T>` in scope, and `cap` bounds the channel (0 when unwritten).
fn produce_type(mut cx: TypeCx, e: ExprId, elem: TypeRef, cap: ExprId?, body: ExprId) -> TypeId {
    let t = cx.written(e, elem)
    if cx.errored_ty(t) { return cx.error_type }
    let source? = task_app(cx, "Source", t) else { return no_task(cx, e) }
    if cap != null { capacity(cx, cap!, "a `produce` capacity") }
    cx.sink_enter(t)
    cx.task_bodies.push(body)
    let answered = cx.walk_type(body)
    let _ = cx.task_bodies.pop()
    cx.sink_exit()
    if cx.errored_ty(answered) { return cx.error_type }
    source
}

/// `channel<T>(cap)` answers `Channel<T>`: the manual pair, its two
/// ends read off the one record. No block and no task; `cap` bounds
/// what it holds, and its absence is the rendezvous `produce<T>` takes.
fn channel_type(mut cx: TypeCx, e: ExprId, elem: TypeRef, cap: ExprId?) -> TypeId {
    let t = cx.written(e, elem)
    if cx.errored_ty(t) { return cx.error_type }
    let chan? = task_app(cx, "Channel", t) else { return no_task_chan(cx, e) }
    if cap != null { capacity(cx, cap!, "a `channel` capacity") }
    chan
}

/// A `produce` or `channel` capacity: the one walk and the one counting
/// law both read, so the bound's help is said once.
fn capacity(mut cx: TypeCx, e: ExprId, subject: string) {
    let _ = cx.walk_type(e)
    if cx.errored(e) { return }
    cx.require_int(e, subject, "this bounds the channel")
}

/// A `@std/task` generic record instantiated at `t`, or absent when
/// the program loads no `@std/task`.
fn task_app(cx: TypeCx, name: string, t: TypeId) -> TypeId? {
    let decl = cx.view.decls.package_decl("@std.task", name)?
    let _ = cx.view.decls.sig(decl)
    cx.view.types.intern(Type.App(decl, name, [t]))
}

// ── The voices ──

fn yield_without(mut cx: TypeCx, e: ExprId) -> TypeId {
    cx
        .spoken(
            refusal(
                "flow.yield",
                cx.loc_of(e),
                "`yield` sends into the producer it stands in, and no producer encloses it",
                "no producer here",
                "write `produce<T>(n) { … yield … }` — a `-> Stream<T>` fn will say the same when COLLECTIONS lands",
            ),
        )
}

fn no_task(mut cx: TypeCx, e: ExprId) -> TypeId {
    cx
        .spoken(
            refusal(
                "flow.produce",
                cx.loc_of(e),
                "`produce` answers `@std.task.Source`, and this program loads no `@std/task`",
                "no `@std/task` here",
                "add `use @std.task`",
            ),
        )
}

fn no_task_chan(mut cx: TypeCx, e: ExprId) -> TypeId {
    cx
        .spoken(
            refusal(
                "flow.channel",
                cx.loc_of(e),
                "`channel` answers `@std.task.Channel`, and this program loads no `@std/task`",
                "no `@std/task` here",
                "add `use @std.task`",
            ),
        )
}

fn answers_nothing(mut cx: TypeCx, body: ExprId) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.within",
                cx.loc_of(body),
                "a `within` answers what its block did or the deadline it ran past, and this block answers nothing",
                "answers nothing",
                "answer what the block did — end it on a value",
            ),
        )
}

fn no_timed_out(mut cx: TypeCx, e: ExprId) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.within",
                cx.loc_of(e),
                "a `within` answers `Result<T, TimedOut>`, and `TimedOut` is `@std/time`'s",
                "no `@std/time` here",
                "give the limit as `@std/time`'s span — `use @std.time.{ms}`",
            ),
        )
}

fn cancelled_unloaded() -> Refusal {
    Refusal {
        message: "a caught `await` recovers the prelude's `Cancelled`, and this program sees no `@std/prelude`",
        help: "a file in a package sees the prelude",
    }
}

fn not_a_task(mut cx: TypeCx, t: ExprId) -> TypeId {
    let n = cx.name_at(t)
    cx
        .spoken(
            refusal(
                "type.mismatch",
                cx.loc_of(t),
                "a `Tasks` owner holds tasks, this is `${n}`",
                this_is(n),
                "push what `spawn` answers — `owner.push(spawn f(x))`",
            ),
        )
}
