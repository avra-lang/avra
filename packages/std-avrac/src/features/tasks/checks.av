//! The typing rule of `spawn`: its body is a thunk, and the task carries what the thunk answers.
use core.{Checking, Checks, ExprId, Expected, SignedType, owned_type}

impl Checks for Spawn {
    fn checked(mut cx: Checking, e: ExprId, expected: Expected) -> SignedType? {
        let body? = cx.check(self.body, Expected.Free) else { return null }
        let answer? = (if body.head is .Function && body.seats.is_empty() { body.answer } else { null }) else { return null }
        owned_type("Task") with { args: [answer] }
    }
}
