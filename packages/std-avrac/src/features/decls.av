//! THE DECLARATION TABLE — every declaration of the program, ONCE:
//! its file, its statement, its name and kind; its signature once
//! typing declares it; its methods and the traits it implements.
//! Ids are INTERNED by key (file, kind, name — a method under its
//! owner), so an id is dense, stable across edits, and the same when
//! an edited file is admitted again; a name declared twice in one
//! file is two declarations, the second keyed by its statement, so
//! the namespace law can refuse it. Per-file facts live once, by
//! FileId: the path, the module, the store, and which of its
//! statements declare. The workspace mints; every pass reads.
use core.{
    SideTable,
    side_table,
    DeclId,
    FileId,
    ModuleId,
    DeclKind,
    CollectScope,
    StmtId,
    ExprId,
    PatId,
    ParamId,
    Span,
    SyntaxArena,
    TypeRegistry,
    new_type_registry,
    Param,
    FnParts,
    spelled,
    fp_str,
    same_type,
    module_symbol,
    filled,
    flatten,
    some_list,
    same_decl,
    same_file,
    SpecParts,
    ImplParts,
    TypeId,
    no_stmt,
    Type,
    package_of_module,
    TypeRef,
    named_ref,
    Stmt,
    Expr,
    Scoped,
    GrammarSpec,
    Annotation,
    At,
}
use core.{SeatMark, mark_at, plain_mark, ArenaRuns, wreck}
use @std.relation.db.{Db, new_db}
use @std.relation.rows.{Rows, bool_key, text_key, SideRows, side_rows}
use core.{Fingerprint, Exemplar, fp, fp_list, mix_final, same_type, touch, list_eq, opt_eq}
use @std.path.{stem_of}
use diagnostics.{loc_at, Diag}
use @std.errors.{Loc}
use features.{
    TypeRow,
    TypeArgs,
    Unsettled,
    Lifted,
    Settled,
    MetaHeap,
    MetaVal,
    StructSig,
    EnumSig,
    generated_key,
    Decl,
    DeclAt,
    Origin,
    Origins,
    no_origins,
    Namespace,
    no_names,
}
use @std.meta.{Diagnostic, bracket, derive, identity, plain_field}
use @std.relation.{relation}
use @std.relation.db.{Db as RelDb, new_db}
use @std.relation.engine.{list_cell, map_cell, Table, new_table, Kernel, Key, new_kernel}

/// A file's path facts — known at first mention, before its parse.
/// `test` is the caller's structural fact (the package's own test
/// root, `Workspace.is_test_path`), never recomputed here by
/// matching the path.
export type FileInfo = { id: FileId, path: string, module_id: ModuleId, test: bool }

/// A range-owning declaration and the source span it holds.
type OwnerSpan = { d: DeclId, lo: int, hi: int }

/// `Decl`'s indexes, numbered in field order: its name, a component
/// instance's `word`, every `@name` it wears, its interning key, the
/// file that homes it, and whether it is an `extern fn`. `word` and `marks` are TWO INDEXES, never one —
/// sharing a bucket would let a component named `rule` and an annotation
/// `@rule` answer for each other.
const name_index: int = 0
const word_index: int = 1
const marks_index: int = 2
const key_index: int = 3
const home_index: int = 4
const external_index: int = 5

/// `sigs`, `children`, `methods` and `impls` are dense by
/// DeclId; `stores` and `decl_ids` dense by FileId. The two hooks
/// make the table's reads queries: `ensure` computes a sig on first
/// ask, `ensure_methods` fills a type's method table.
/// EVERY FACT A PASS READS OFF A DECLARATION'S PARSE — captured ONCE, when the file is
/// admitted, and kept beside the declaration. A pass that reads `store(d)` instead reads
/// a file a HELD build never parsed; this is the ONE place that knowledge lives, so a held
/// file is loaded by filling these rows and NOTHING reaches into a store after admission.
/// `@name(args)` recorded as a declaration's own fact: its callee's name, each
/// argument's literal value (its written text AND the kind it was written as —
/// a `by` key compares the kind, never the text), and where it was written.
@derive(Fingerprint)
@derive(Exemplar)
export type AnnotationFact = { name: string, args: List<LitArg>, span: Span? }

impl AnnotationFact {
    /// `@derive(Exemplar)`'s seed.
    static fn codec_zero() -> AnnotationFact { AnnotationFact { name: "", args: [], span: null } }
}

/// The kind a literal annotation argument was WRITTEN as — what a
/// `by it.mark.args[i]` key compares by. `Other` is a computed
/// expression, a float or an identifier: no `by` key may compare it.
@derive(Fingerprint)
@derive(Exemplar)
export enum LitKind { Int, Text, Bool, Other }

/// One literal annotation argument: the text the user-facing
/// `mark.args` projects, and the kind that orders it.
@derive(Fingerprint)
@derive(Exemplar)
export type LitArg = { text: string, kind: LitKind }

impl LitArg {
    /// `@derive(Exemplar)`'s seed.
    static fn codec_zero() -> LitArg { LitArg { text: "", kind: LitKind.Text } }
}

/// An argument's literal text, when it has one — a computed expression answers "".
export fn arg_text(store: SyntaxArena, e: ExprId) -> string {
    let expr = store.expr(e)
    match expr {
        .VariantLit(name, _) -> name.of,
        _ -> {
            let t? = expr.text_of() else { return int_text(expr) ?? bool_text(expr) ?? store.ident_name(e) ?? "" }
            t
        },
    }
}

/// `arg_text`'s typed twin, for the facts `by` orders by: the written
/// text beside the kind it was written as.
export fn arg_lit(store: SyntaxArena, e: ExprId) -> LitArg {
    let expr = store.expr(e)
    let t? = expr.text_of() else { return int_lit(expr) ?? bool_lit(expr) ?? other_lit(store, e) }
    LitArg { text: t, kind: LitKind.Text }
}

fn int_lit(e: Expr) -> LitArg? {
    let n? = e.int_of() else { return null }
    LitArg { text: "${n}", kind: LitKind.Int }
}

fn bool_lit(e: Expr) -> LitArg? {
    let b? = e.bool_of() else { return null }
    LitArg { text: "${b}", kind: LitKind.Bool }
}

fn other_lit(store: SyntaxArena, e: ExprId) -> LitArg {
    match store.expr(e) {
        .VariantLit(name, _) -> LitArg { text: name.of, kind: LitKind.Other },
        _ -> LitArg { text: store.ident_name(e) ?? "", kind: LitKind.Other },
    }
}

fn int_text(e: Expr) -> string? {
    let n? = e.int_of() else { return null }
    "${n}"
}

fn bool_text(e: Expr) -> string? {
    let b? = e.bool_of() else { return null }
    "${b}"
}

/// A parsed `Annotation` as the fact a declaration keeps: its callee's args
/// re-read as typed literals, since the fact outlives the store a held file has none of.
fn annotation_fact(store: SyntaxArena, a: Annotation) -> AnnotationFact {
    AnnotationFact { name: a.name, args: [arg_lit(store, e) for e in a.args], span: a.span }
}

/// THE FINGERPRINT IS THE CODEC'S CHECKSUM: the derived fold covers EVERY field, so the
/// record carries it and the decoder recomputes it — a field added and not encoded makes
/// the two disagree and the module refuses to hold, instead of silently decoding a default.
@derive(Fingerprint)
@derive(Exemplar)
export type DeclFacts = {
    external: bool,
    stat: bool,
    is_grammar: bool,
    /// A RECORD A BLOCK INSTANTIATES — a component. The importing file's
    /// lexer must know the word before anything parses, so a held
    /// provider says it here rather than in a parse the hold skips.
    is_component: bool,
    span: Span?,
    tparams: List<string>,
    bounds: List<string>,
    seats: List<string>,
    /// AN EXTERN'S RAW SEAT WIDTHS — the annotation each seat wrote, the answer last.
    /// A width is a property of a SEAT and lives in the parse alone, so a held extern
    /// must carry it or its runtime row cannot be built without a store.
    host: List<string>,
    /// WHETHER THE DECLARATION CARRIES ANNOTATIONS. A use-site warning is computed from
    /// them, and that computation reads the declaration's PARSE — so a held decl must say
    /// whether it has any, or asking its marks parses a file the hold exists to skip.
    annotated: bool,
    /// THE TRAIT AN `impl … for` BLOCK ANSWERS, empty otherwise. The name lives in the
    /// parse alone, and a held block that cannot say it implements nothing: a `dyn` box
    /// over its type is refused in a file that merely parsed beside it.
    of: string,
    /// A `const` THAT IS A DECLARED INSTANCE — built once per run by its own unit, owned
    /// by its file's object. A reader in another file must know it without a parse the
    /// hold skips.
    instance: bool = false,
    /// THE COMPONENT A DECLARED INSTANCE INSTANCES — the word `collect` gathers it
    /// under, absent for every other declaration.
    word: string? = null,
    /// THE DECLARATION'S OWN `///` LINES, absent where it wrote none — a fact every
    /// tool (`avra docs`, the formatter, `@std/meta`'s crossing) reads the same
    /// way, so a held file answers it without the parse the hold exists to skip.
    doc: List<string>? = null,
    /// EVERY `@name(args)` THE DECLARATION WEARS, in written order — the general
    /// table `annotated` above only flags the presence of.
    annotations: List<AnnotationFact> = [],
    /// THE TYPE NAMES ITS `mut` PARAMETERS WRITE — the seals a `.Fn` puts on a
    /// type's layout, read from the parse at admission and from the record for a
    /// held file, so the seal index never reaches into a store the hold skipped.
    mut_seats: List<string> = [],
    /// THE ARGUMENTS AN `impl X<A> for Y` GIVES ITS TRAIT, as written — two impls
    /// of one generic trait on one type are told apart by them.
    trait_args: List<string> = [],
    /// AN `extern fn` WITH A BODY — a host fn. Its symbol is defined here,
    /// so a held file must say which of its externs a caller links to
    /// and which the target answers.
    hosted: bool = false,
}

impl DeclFacts {
    /// `@derive(Exemplar)`'s seed — every fact at its own zero.
    static fn codec_zero() -> DeclFacts {
        DeclFacts {
            external: false,
            stat: false,
            is_grammar: false,
            is_component: false,
            span: null,
            tparams: [],
            bounds: [],
            seats: [],
            host: [],
            annotated: false,
            of: "",
            instance: false,
            word: null,
            doc: null,
            annotations: [],
            mut_seats: [],
            trait_args: [],
        }
    }
}

/// An extern's raw seat widths: one name per parameter, then the answer's.
fn extern_host(store: SyntaxArena, s: StmtId) -> List<string> {
    let ext? = store.extern_parts(s) else { return [] }
    let seats = [p.ty?.name ?? "" for p in ext.params]
    seats.concat([ext.ret.name])
}

/// The source a declaration occupies: a default's or a case's root, else
/// its statement — and none for a hoisted one, whose nodes lie inside
/// the statement that minted it.
fn occupied(store: SyntaxArena, x: Decl) -> Span? {
    if store.is_hoisted(x.stmt) { return null }
    if !(x.kind is .Default || x.kind is .Case) { return store.stmt_span(x.stmt) }
    let root? = x.root else { return null }
    store.expr_span(root)
}

/// THE ONE CAPTURE — a parsed declaration's facts, read from its store exactly once.
// LICENSED compiler.free_state_verb: a pure PROJECTION — a store and a declaration in, its facts out.
fn capture_facts(store: SyntaxArena, x: Decl) -> DeclFacts {
    // A GENERATED declaration's statement lives in an expanded range the written part
    // tables do not cover — `statics`, `grammars`, the parts tables trap past their end.
    // Absence there is "declares nothing", not a defect.
    let readable = x.stmt.index < store.stmts.count()
    DeclFacts {
        external: readable && x.kind is .Fn && store.extern_parts(x.stmt) != null,
        stat: store.is_static(x.stmt),
        is_grammar: readable && x.kind is .Record && store.grammar_of(x.stmt) != null,
        is_component: readable && x.kind is .Record && store.component_parts(x.stmt) != null,
        span: occupied(store, x),
        tparams: if readable { store.decl_tparams(x.stmt) } else { [] },
        bounds: if readable { [p.ty?.name ?? "" for p in store.decl_tbounds(x.stmt)] } else { [] },
        seats: if readable && !(x.kind is .Default) { [p.name.of for p in store.fn_parts(x.stmt)?.params ?? []] } else { [] },
        host: if readable { extern_host(store, x.stmt) } else { [] },
        annotated: readable && !store.annotations_of(x.stmt).is_empty(),
        of: if readable && x.kind is .Impl { store.impl_parts(x.stmt)?.of ?? "" } else { "" },
        instance: readable && x.kind is .Const && store.is_component_inst(x.stmt),
        word: if x.kind is .Const { store.instance_of(x.stmt) } else { null },
        doc: if readable { store.doc_comment(x.stmt) } else { null },
        annotations: if readable { [annotation_fact(store, a) for a in store.annotations_of(x.stmt)] } else { [] },
        mut_seats: if readable && x.kind is .Fn { mut_seat_names(store, x.stmt) } else { [] },
        trait_args: if readable && x.kind is .Impl { [spelled(a) for a in store.trait_args_of(x.stmt)] } else { [] },
        hosted: readable && x.kind is .Fn && store.is_host_fn(x.stmt),
    }
}

/// What a reader can tell of a declaration past its row's columns — `Decl.told`:
/// its facts with every position nulled, and its home's path.
fn told_of(f: DeclFacts, path: string) -> int {
    fp_list(
        [
            (f with { span: null, annotations: [a with { span: null } for a in f.annotations] })
                .fingerprint(),
            fp_str(path),
        ],
    )
}

/// The type names a fn's own `mut` parameters write, from its parse.
fn mut_seat_names(store: SyntaxArena, s: StmtId) -> List<string> {
    [pp.ty!.name for pp in store.fn_parts(s)?.params ?? [] if pp.promises.mutable && pp.ty != null]
}

/// The facts a declaration minted with no store wears: a synthetic or builtin body has no
/// receiver and declares nothing about the source.
fn no_facts() -> DeclFacts {
    DeclFacts {
        external: false,
        stat: true,
        is_grammar: false,
        is_component: false,
        span: null,
        tparams: [],
        bounds: [],
        seats: [],
        host: [],
        annotated: false,
        of: "",
    }
}

/// THE REFERENCES RELATION's own row: `decl` is named at `at`, in
/// `file`, this way — a call, a method call (resolved through
/// `methods(target)`), a plain read, a write, the `use` line that
/// names it, or a WRITTEN TYPE that names it (a param's, a field's,
/// a `let`'s annotation, a bound, a return — never a nested
/// expression, so no expression-level walk sees these on its own).
/// Never about a LOCAL: a param or a `mut` local is scoped to its
/// own body, which `Code.reads`/`Code.writes` (features/code.av)
/// answer with a bounded walk of their own — this relation only
/// ever answers about a `DeclId`, which is what crosses files.
export enum UseKind { Call, MethodCall, Read, Write, Import, TypeUse }

/// `decl` and `file` are `@dense` ids — their ints mean nothing
/// outside this process, so both are `@local`, indexed for
/// `by_decl`/`by_file`. `at` names a position (an `ExprId`/`StmtId`
/// union), local for the same reason; `kind` alone is stable.
@relation
export type Ref = { @local @index decl: DeclId, @local @index file: FileId, @local at: At, kind: UseKind }

/// A file's declarations by kind, owner and name, and how many it held.
export type WireIndex = { count: int, by: Map<string, List<DeclId>> }

/// ONE IDENTITY: every table is a `Cell`, or itself an `@identity`
/// type, so a copy of `Decls` still reads and writes the tables the
/// workspace built.
@identity
@plain_field("rows")
export type Decls = {
    types: TypeRegistry,
    mains: Cell<List<DeclId?>>,
    stores: Cell<List<SyntaxArena?>>,
    ensure_store: Cell<fn(FileId) -> void>,
    /// A HELD FILE'S DECLARATIONS ARE MINTED WHEN ASKED FOR: the hook the
    /// workspace arms, called before a file's declarations are read.
    ensure_file: Cell<fn(FileId) -> void>,
    /// THE FILE AN `embed` LITERAL NAMES, or why a const may not read
    /// it: the hook the workspace arms — it knows the package a file
    /// stands in and the ones it depends on, and its host is what reads.
    embed_judge: Cell<fn(FileId, string) -> Result<string, EmbedFault>>,
    /// A PACKAGE-SCOPED COLLECT GATHERS THE WHOLE PACKAGE: the hook the
    /// workspace arms, admitting every file of the package a file stands
    /// in — once per package, `scoped` records which.
    ensure_package: Cell<fn(FileId) -> void>,
    scoped: Cell<Map<string, bool>>,
    /// TWO LAYERS SHARED — see `module_files`.
    decl_ids: Cell<List<Cell<SideTable<DeclAt>>>>,
    /// Each file's admission owner in the declaration table's `Db`,
    /// dense by FileId: every row the file homes is that owner's.
    file_owners: Cell<List<int>>,
    /// TWO LAYERS SHARED — see `module_files`. Each expression's owning
    /// declaration, written once per file in `range_bodies` — `expr_owner`'s
    /// O(1) read, never the linear `innermost` rescan.
    expr_owners: Cell<List<Cell<SideTable<DeclAt>>>>,
    /// THE FILES ANSWERED FROM A RECORD — never parsed, so their declarations were
    /// MINTED and their objects come from the store. Keyed by path.
    held: Cell<Map<string, bool>>,
    held_items: Cell<Map<string, List<DeclId>>>,
    /// Each file's declarations by kind, owner and name, keyed by file
    /// index, kept until the file holds more declarations than it was
    /// indexed with.
    wire_index: Cell<Map<string, WireIndex>>,
    /// Lazy expression-range reconstruction is once per held file, even
    /// when dozens of specializations ask for bodies from that file.
    /// THE DECLARATION'S PARSE FACTS, captured at admit and loaded for a held file — the
    /// ONE place a pass reads them, so no pass reaches into a store after admission.
    faces: Cell<List<DeclFacts?>>,
    /// A declaration's doc and annotations, addressed by the same dense
    /// slot as `faces` — a `@side` partition, so a query can reach
    /// it without a `@dense` id ever crossing its boundary (avra-8sb5.57.9.7).
    doc_facts: Cell<SideTable<DocFact>>,
    /// `doc_facts`'s own family and read marks under a Db — its own
    /// `Cell`s already make it an identity, so no outer `Cell` wraps it,
    /// the same reason `Rows<R>` never gets one either.
    doc_facts_side: SideRows<DocFact>,
    /// Settlements restored for declarations whose files were never parsed.
    held_values: Cell<Map<string, Settled>>,
    /// A held declaration's own const, restored as UNFOLDABLE rather than as
    /// a value: the words its settlement reached the world with, so a later
    /// ask answers the same `Unsettled.Reach` a fresh compile would.
    held_reaches: Cell<Map<string, string>>,
    sigs: Cell<List<DeclSig?>>,
    /// A fn's own PARAMETERS, typed once — never inferred, unlike the answer
    /// `sigs` carries, so this memo carries no self-recursion risk. Whichever
    /// caller asks first (`seats`'s hook, or the fn's own natural signing)
    /// types them through the one real signing context; every later ask reuses
    /// the answer.
    seat_types: Cell<List<List<TypeId>?>>,
    /// Each type parameter's bound's trait arguments, per declaration.
    bound_types: Cell<List<List<List<TypeId>>?>>,
    seat_ensure: Cell<fn(DeclId) -> void>,
    /// THE DEPENDENCY AUDIT, in a compiler built with `audit_build`: the hook the workspace
    /// arms hears each read that skipped the Kernel, while `auditing` is on.
    auditing: Cell<bool>,
    audit_hook: Cell<fn(Bypassed) -> void>,
    /// A DECLARATION ROW'S READ RECORDS ITS NAME'S BUCKET: reading a declaration of a
    /// file settled below records the `Named` cell its name files under (a held file's
    /// module record) in the open query — once per query, by the Kernel's own stamp. A
    /// walk of one file's rows records the file's `Items` cell instead.
    /// `rows_state` is dense by FileId: 0 while the file's rows are being minted (the
    /// minter's own reads record nothing), 1 settled, 2 held. The kernel is the
    /// workspace's own, fixed at construction: never a `Cell`, so no callee can
    /// replace what a read of it holds across `record_dep`.
    record_kernel: Kernel,
    /// THE DECLARATION TABLE'S OWN `Db`: every declaration is a `Decl` row under it,
    /// inserted at mint and reseated at every later field write. A `Cell`, never a bare
    /// `Db`: `Decls` is copied somewhere in the pipeline, and a bare `Db` field forked
    /// on that copy — `family()`'s registration landed on one copy's own state while a
    /// later read reached another's, "index 21 is out of bounds (length 0)" in the
    /// whole-package suite.
    decl_rows: Cell<Db>,
    /// `File`/`Module`'s own rows, pinned once at construction — a
    /// `Cell`, `decl_rows`'s own reason: `Rows<T>` is not itself
    /// `@identity`, and an `@identity` type's field must be a `Cell` or
    /// another `@identity` (`type.identity_field`;
    /// compiler/tests/file_module_relation_test.av's pinned-handle spec
    /// is the witness that the pin still sees a row inserted after it
    /// was taken). `file(f)`/`module_name(m)` read through these
    /// directly, unrecorded: the kernel records a query's dependency on
    /// `File`/`Module`, never a by-id fetch, so the hand-table read
    /// this replaces recorded nothing either.
    file_rows: Cell<Rows<File>>,
    module_rows: Cell<Rows<Module>>,
    /// THE DECLARATION TABLE'S REAL STORAGE — pinned the same way, `Decl`'s own row
    /// per DeclId, numerically the same index by construction. `decl(d)` reads it
    /// raw, through `row(d.index)`, never through the generated (recorded) `get`: the
    /// kernel is the one recorder (`rows_read`), so a second door recording again would
    /// pay for an edge the kernel already told. Reachable only inside `Decls` — every
    /// outside reader goes through `decl`/`raw_decl`/`all_decls`/`decl_count`.
    decl_row_rows: Cell<Rows<Decl>>,
    /// The relation's own row storage, pinned: a hot by-id read is one cell
    /// and one index, the shape the dense table had.
    decl_cells: Cell<List<Decl?>>,
    record_items: Cell<int>,
    record_methods: Cell<int>,
    record_names: Cell<int>,
    /// Whether the workspace armed the recording: the rows minted before it — the
    /// language's own — are filed under their cells when it does.
    recording: Cell<bool>,
    /// Each declaration's bucket in the name index, dense by DeclId — what a
    /// re-filing or a removal moves.
    name_buckets: Cell<List<int>>,
    /// The name each name bucket files, dense by bucket — its `Named` cell's label.
    cell_names: Cell<List<string>>,
    rows_state: Cell<List<int>>,
    held_rows: Cell<fn(FileId) -> void>,
    /// The revision each armed relation cell last moved at, by family.

    // a GENERATED declaration's origin — null for every written one
    provenance: Cell<List<Provenance?>>,
    // a file's admitted GENERATIONS, in order — the arena ranges each
    // took and the annotation that asked; dense by FileId
    generations: Cell<List<List<Generation>>>,
    // a generated node's ORIGIN — the file whose template wrote it;
    // `Here` for a written node and for one whose name came through a
    // hole; dense by FileId, then by arena index
    origins: Cell<List<Origins>>,
    // what a file's expansions REFUSED — generated source that did not
    // parse, spoken at the template that wrote it; dense by FileId
    /// TWO LAYERS SHARED — see `module_files`.
    expansion_voices: Cell<List<Cell<List<Diag>>>>,
    // `@std/meta`'s declarations by name, found once each
    meta_ids: Cell<Map<string, DeclId>>,
    // a declaration's WARNINGS: the words it keeps for its users,
    // computed on first ask through `ensure_marks` (null = unasked)
    marks: Cell<List<List<Diagnostic>?>>,
    ensure_marks: Cell<fn(DeclId) -> void>,
    // the ROOT package's manifest name — its modules carry no package
    // prefix, and a kind spoken there still wears the package
    root_name: Cell<string>,
    const_types: Cell<Map<string, TypeId>>,
    /// TWO LAYERS SHARED: members are appended through every copy of the
    /// per-parent slot, so an append cannot copy it (a plain
    /// `List<List<DeclId>>` cloned the whole table per child) — AND the
    /// outer table (one slot per DeclId) is a Cell too, or a NEW
    /// declaration's own slot never reaches a captured hook.
    children: Cell<List<Cell<List<DeclId>>>>,
    /// TWO LAYERS SHARED — see `children`.
    methods: Cell<List<Cell<List<DeclId>>>>,
    /// TWO LAYERS SHARED — see `children`.
    impls: Cell<List<Cell<List<DeclId>>>>,
    ensure: Cell<fn(DeclId) -> void>,
    // the workspace's held-row hook: fills a held declaration's own
    // record row before a fact it fills (an impl's target among them)
    // is read
    ensure_target: Cell<fn(DeclId) -> void>,
    // the workspace's const-type hook: types the const, and answers
    // whether this ask closed a cycle
    ensure_const: Cell<fn(FileId, StmtId) -> bool>,
    // whether THIS compilation is a program (has an entry) or a
    // library — the closure-fold law's door (features/consts/check.av)
    ensure_entry: Cell<fn() -> bool>,
    // the workspace's lifting hook: an annotation fn run over a
    // declaration at compile time, what it said back
    lifter: Cell<fn(DeclId, FileId, StmtId, ExprId, List<ExprId>) -> Result<Lifted, Unsettled>>,
    ensure_methods: Cell<fn(DeclId) -> void>,
    // the workspace's namespace hook: a file's names resolved, what
    // `annotation_callee` reads a captured fact's callee through
    namespace_of: Cell<fn(FileId) -> Namespace>,
    // the workspace's kept-apart hook: the declarations a file's
    // module keeps apart, what a symbol asks whether to carry its file
    apart_of: Cell<fn(FileId) -> List<DeclId>>,
    // the traits that may compose a component of a file — the workspace's to answer
    composers_of: Cell<fn(FileId) -> List<DeclId>>,
    // the language's own type declarations, one per row that is an
    // enum — and the rows they read their parts from
    builtins: Cell<List<DeclId>>,
    // plain for its identity: the language's own builtin rows, built
    // once at workspace construction and never written after
    rows: List<TypeRow>,
    // an impl block's target type, once typing found it — dense by
    // DeclId; a method's instantiation is its target's
    targets: Cell<List<DeclId?>>,
    // THE INOUT SEATS, dense by DeclId: each seat's CONTRACT a fn
    // declared (`mut`, `const`), whether a method DECLARED `mut fn`,
    // and whether the receivers pass found it WRITING through `self`
    // — asked through the armed hook
    seat_marks: Cell<List<List<SeatMark>>>,
    declared_writes: Cell<List<bool>>,
    /// TWO LAYERS SHARED — see `children`.
    written_seats: Cell<List<Cell<List<bool>>>>,
    ensure_writes: Cell<fn(DeclId) -> bool>,
    // WHICH SEATS THE BODY CONSUMES (R3) — computed on first ask
    // through `ensure_consumed`, the same shape as `marks` (null =
    // unasked). No fixpoint: unlike `written_seats`, a seat's
    // evidence is local to its own body alone.
    consumed: Cell<List<List<bool>?>>,
    ensure_consumed: Cell<fn(DeclId) -> void>,
    /// THE REFERENCES RELATION's own rows, under the one Db they
    /// live in — replaced whole (a fresh Db) when `references.av`'s
    /// pass re-settles the program; `Ref.by_decl`/`Ref.by_file` are
    /// the readers, never a hand-kept index.
    refs_db: Cell<RelDb>,
    /// Whether a HELD file stood in the workspace the last time the
    /// pass ran — that file was never surveyed, so the relation
    /// cannot answer "used nowhere" with any confidence.
    refs_incomplete: Cell<bool>,
    ensure_refs: Cell<fn() -> void>,
    /// THE SEAL INDEX — a type name to the `.Fn` decls whose `mut` parameters
    /// write it, kept by `face` as every declaration's facts land, so it covers
    /// a module minted after the first ask as well as one parsed before it.
    mut_seat_index: Cell<Map<string, List<DeclId>>>,
    // an inferred `Result<T, _>`'s growing error set, dense by DeclId
    // — the error-unions Phase 2 fixpoint's own table, settled by the
    // armed hook on first ask
    inferred_errs: Table<List<TypeId>>,
    // whether that fn's own walk hit a site whose type it could not
    // structurally resolve — a refusal, never a silently missing member
    inferred_unresolved: Table<bool>,
    ensure_failures: Cell<fn() -> void>,
}

/// Where no workspace stands behind the table, nothing lifts.
// LICENSED fns.dead_parameter: a fn VALUE filling the lifter seat — its parameters are the seat's contract, and the answer needs none of them
fn no_lifter(d: DeclId, f: FileId, s: StmtId, call: ExprId, args: List<ExprId>) -> Result<
    Lifted,
    Unsettled,
> {
    .Err(Unsettled.Trap("nothing here lifts an annotation"))
}

/// Where no workspace stands behind the table, nothing resolves.
fn no_namespace(_f: FileId) -> Namespace { no_names() }

fn none_apart(_f: FileId) -> List<DeclId> { [] }

// LICENSED fns.dead_parameter: the hook's contract carries the declaration
fn no_marks(d: DeclId) {}

fn no_failures_ensure() {}

/// Why an `embed` literal names no file a const may read: it stands
/// outside the package, it names a package this one does not depend on,
/// it is not there, a link stands on the way to it, it is not UTF-8 (at
/// that byte), or the host would not read it.
export enum EmbedFault { Outside, Undeclared(key: string), Missing, Linked, NotText(at: int), Refused(why: string) }

/// `embed`'s path is read before any analysis runs over the file it
/// names — a declared reach, like a `use` line's — so a computed
/// path can never be found at admit time, and the file it would have
/// named could change invisibly between one compile and the next.
export const embed_literal_law: string = "`embed` reads a file named in the source — its path is a literal"

/// A table no workspace stands behind has no host to read a file with.
fn embed_unjudged(_f: FileId, _rel: string) -> Result<string, EmbedFault> {
    .Err(EmbedFault.Refused("no workspace stands behind this file"))
}

// LICENSED fns.dead_parameter: the hook's contract carries the declaration
fn no_store(f: FileId) {}

fn no_audit(_r: Bypassed) {}

/// Whether a scope gathers from every file of the owner's package.
fn admits_package(scope: CollectScope) -> bool {
    match scope { .Package -> true, .Self or .Closure or .UnknownScope(_) -> false }
}

// LICENSED fns.dead_parameter: a fn VALUE filling the const-ensure seat — its parameters are the seat's contract, and the no-op needs none of them
fn no_const_ensure(f: FileId, s: StmtId) -> bool { false }

// LICENSED fns.dead_parameter: a fn VALUE filling the entry-ensure seat — no program is known before the workspace arms it
fn no_entry_ensure() -> bool { false }

// LICENSED fns.dead_parameter: a fn VALUE filling the references-ensure seat — no pass runs before the workspace arms it
fn no_refs_ensure() {}

/// A const's type as the program answers it — or why it has none:
/// the const REFUSED (spoken at its own value), or its value asks
/// for its own type, which only the asking read can speak.
export enum ConstType {
    Known(TypeId)
    Refused
    Cyclic
}

fn const_type_key(f: FileId, s: StmtId) -> string { "${f.index}/${s.index}" }

export fn new_decls() -> Decls {
    let no_mains: List<DeclId?> = []
    let no_stores: List<SyntaxArena?> = []
    let no_generations: List<List<Generation>> = []
    let no_origins: List<Origins> = []
    let no_faces: List<DeclFacts?> = []
    let no_sigs: List<DeclSig?> = []
    let no_seat_types: List<List<TypeId>?> = []
    let no_bound_types: List<List<List<TypeId>>?> = []
    let no_provenance: List<Provenance?> = []
    let empty_marks: List<List<Diagnostic>?> = []
    let no_targets: List<DeclId?> = []
    let no_seat_marks: List<List<SeatMark>> = []
    let no_declared_writes: List<bool> = []
    let no_decl_ids: List<Cell<SideTable<DeclAt>>> = []
    let no_expr_owners: List<Cell<SideTable<DeclAt>>> = []
    let no_expansion_voices: List<Cell<List<Diag>>> = []
    let no_children: List<Cell<List<DeclId>>> = []
    let no_methods: List<Cell<List<DeclId>>> = []
    let no_impls: List<Cell<List<DeclId>>> = []
    let no_written_seats: List<Cell<List<bool>>> = []
    let empty_consumed: List<List<bool>?> = []
    let db = new_db()
    let d = Decls {
        types: new_type_registry(),
        mains: Cell.new(no_mains),
        // LICENSED compiler.repeated_projection: each `Cell.new` mints its own cell — one binding would make two hooks one slot
        stores: Cell.new(no_stores),
        auditing: Cell.new(false),
        audit_hook: Cell.new(no_audit),
        record_kernel: new_kernel(),
        decl_rows: Cell.new(db),
        file_rows: Cell.new(File.rows_in(db)),
        module_rows: Cell.new(Module.rows_in(db)),
        decl_row_rows: Cell.new(Decl.rows_in(db)),
        decl_cells: Decl.rows_in(db).rows,
        record_items: Cell.new(0),
        record_methods: Cell.new(0),
        record_names: Cell.new(0),
        recording: Cell.new(false),
        name_buckets: list_cell(),
        cell_names: list_cell(),
        rows_state: list_cell(),
        held_rows: Cell.new(no_store),
        ensure_store: Cell.new(no_store),
        ensure_file: Cell.new(no_store),
        embed_judge: Cell.new(embed_unjudged),
        ensure_package: Cell.new(no_store),
        scoped: map_cell(),
        decl_ids: Cell.new(no_decl_ids),
        file_owners: list_cell(),
        expr_owners: Cell.new(no_expr_owners),
        generations: Cell.new(no_generations),
        origins: Cell.new(no_origins),
        expansion_voices: Cell.new(no_expansion_voices),
        meta_ids: map_cell(),
        held: map_cell(),
        held_items: map_cell(),
        wire_index: map_cell(),
        faces: Cell.new(no_faces),
        doc_facts: Cell.new(side_table("doc_facts", 0, 0, DocFact { doc: null, annotations: [] })),
        doc_facts_side: side_rows(),
        held_values: map_cell(),
        held_reaches: map_cell(),
        sigs: Cell.new(no_sigs),
        seat_types: Cell.new(no_seat_types),
        bound_types: Cell.new(no_bound_types),
        seat_ensure: Cell.new(no_ensure),
        provenance: Cell.new(no_provenance),
        marks: Cell.new(empty_marks),
        ensure_marks: Cell.new(no_marks),
        root_name: Cell.new(""),
        const_types: map_cell(),
        children: Cell.new(no_children),
        methods: Cell.new(no_methods),
        impls: Cell.new(no_impls),
        ensure: Cell.new(no_ensure),
        ensure_target: Cell.new(no_ensure),
        ensure_const: Cell.new(no_const_ensure),
        ensure_entry: Cell.new(no_entry_ensure),
        ensure_methods: Cell.new(no_ensure),
        builtins: list_cell(),
        rows: [],
        targets: Cell.new(no_targets),
        seat_marks: Cell.new(no_seat_marks),
        declared_writes: Cell.new(no_declared_writes),
        written_seats: Cell.new(no_written_seats),
        ensure_writes: Cell.new(no_answer),
        inferred_errs: new_table(),
        inferred_unresolved: new_table(),
        ensure_failures: Cell.new(no_failures_ensure),
        consumed: Cell.new(empty_consumed),
        ensure_consumed: Cell.new(no_ensure),
        lifter: Cell.new(no_lifter),
        namespace_of: Cell.new(no_namespace),
        apart_of: Cell.new(none_apart),
        composers_of: Cell.new(none_apart),
        refs_db: Cell.new(new_db()),
        refs_incomplete: Cell.new(false),
        ensure_refs: Cell.new(no_refs_ensure),
        mut_seat_index: map_cell(),
    }
    // the registry cannot reach a declaration on its own — a struct or
    // enum's layout answers the blank default until this runs
    d.types.arm_declare((t: TypeId) -> d.declared_first(t))
    d
}

/// A row's type parameters — `T1`, `T2`, … by arity; the ordinal
/// is the identity, the name only the wording.
fn builtin_tparams(arity: int) -> List<string> {
    mut out: List<string> = []
    mut j = 0
    while j < arity {
        out.push("T${j + 1}")
        j = j + 1
    }
    out
}

/// The table's own reads ask nothing more.
// LICENSED fns.dead_parameter: the hook's contract carries the declaration
fn no_ensure(d: DeclId) {}

fn no_answer(_d: DeclId) -> bool { false }

/// A kind's word — the key's middle, and prose.
export fn kind_word(k: DeclKind) -> string {
    match k {
        .Fn -> "fn",
        .Record or .Named or .Alias -> "type",
        .Enum -> "enum",
        .Trait -> "trait",
        .Syntax -> "syntax",
        .Method -> "method",
        .Default -> "default",
        .Impl -> "impl",
        .Main -> "main",
        .Case -> "case",
        .Const -> "const",
        .Collect -> "collect",
        .CollectEnum -> "collect_enum",
        .Builtin -> "builtin",
        .State -> "state",
    }
}

impl Decls {
    // ── files ──

    /// A declaration's row — THE ONE DOOR every pass reads it through.
    /// Fetched raw off the pinned `Rows<Decl>` handle, `row(d.index)`,
    /// never the generated (recorded) `get`: the kernel is the one
    /// recorder, below, so a second door recording the same edge would
    /// pay for it twice.
    @bracket("decls")
    fn decl(d: DeclId) -> Decl {
        let x = self.decl_cells.get()[d.index] ?? self.removed(d)
        if audit_build && self.auditing.get() { self.audited(Bypassed.Decl(d)) }
        self.row_read(x)
        x
    }

    /// The row as it stands, unrecorded — dep_audit's own reads (which
    /// must not themselves record an edge), and a whole-program pass
    /// walking the table by index as it grows.
    @bracket("decls")
    fn raw_decl(d: DeclId) -> Decl { self.decl_cells.get()[d.index] ?? self.removed(d) }

    /// The row an id names, unrecorded — absent where its file's
    /// re-admission removed it. A walk by index over `decl_count` reads
    /// through here.
    @bracket("decls")
    fn row_at(at: int) -> Decl? { self.decl_cells.get()[at] }

    /// A removed declaration read by id: the compiler's defect, spoken.
    @bracket("decls")
    fn removed(d: DeclId) -> Decl {
        gone_decl(d)
        self.decl_cells.get()[d.index]!
    }

    /// How many declaration ids are minted, a removed one's tombstone
    /// among them — the bound a walk by index runs to. Read unrecorded
    /// as `file_count` is.
    @bracket("decls")
    fn decl_count() -> int { self.decl_row_rows.get().next_id() }

    /// Every live declaration in id order, unrecorded: the relation's own
    /// rows, a removed one never among them.
    fn all_decls() -> List<Decl> { Decl.all(self.decl_rows.get()) }

    /// A declaration's row rewritten in place, its home file's — a row
    /// with no home is no one's.
    /// The row's `@local` columns (file, stmt, parent, root, lo, hi)
    /// carry no stable hash or index, so a write that only moves them
    /// takes `put`'s cheap path — same hash, same keys, the stored value
    /// replaced in place. The row carries the bucket its name files under,
    /// and that bucket's cell follows the write.
    @bracket("decls")
    fn set_decl(idx: int, row: Decl) {
        let rs = self.decl_row_rows.get()
        let db = self.decl_rows.get()
        let b = self.name_bucket(row.name)
        let d = if row.bucket == b { row } else { row with { bucket: b } }
        let home? = d.home else {
            rs.put_in(db, Decl.relation_name(), idx, d, d.stable_hash(), d.index_keys())
            self.filed_by_name(idx, d.name, b)
            return
        }
        rs
            .put_owned(
                db,
                Decl.relation_name(),
                idx,
                d,
                d.stable_hash(),
                d.index_keys(),
                self.file_owners.get()[home.index],
            )
        self.filed_by_name(idx, d.name, b)
    }

    /// The bucket a name files under in the name index, opened when it is the first.
    @bracket("decls")
    fn name_bucket(name: string) -> int {
        let rs = self.decl_row_rows.get()
        let found = rs.bucket_of_text(name_index, name)
        if found >= 0 { found } else { rs.opened_bucket(name_index, text_key(name)) }
    }

    /// Row `idx` filed under bucket `b`: that bucket's cell, and the one it left, follow.
    fn filed_by_name(idx: int, name: string, b: int) {
        while self.name_buckets.get().length <= idx { self.name_buckets.push(0 - 1) }
        let was = self.name_buckets.get()[idx]
        if was != b {
            self.name_buckets.set_at(idx, b)
            self.room_for_cell(b, name)
            if was >= 0 { self.bucket_moved(was) }
        }
        self.bucket_moved(b)
    }

    /// One audited read, told to the hook — which reads the tables itself, so the
    /// audit is off while it runs.
    fn audited(r: Bypassed) {
        self.auditing.set(false)
        (self.audit_hook.get())(r)
        self.auditing.set(true)
    }

    /// The workspace arms the audit once, when `AVRA_DEP_AUDIT` asks.
    fn arm_audit(hook: fn(Bypassed) -> void) {
        self.audit_hook.set(hook)
        self.auditing.set(true)
    }

    /// A read of one row records what the row is a function of in the open query: its
    /// name's bucket when its file's rows are settled — its file's, inside a query that
    /// reads rows whole — its module's record when the file is held, nothing while the
    /// rows are being minted.
    fn row_read(x: Decl) {
        if x.standing == 1 {
            if self.record_kernel.reading_whole() {
                self.record_kernel.record_at(self.record_items.get(), x.file.index)
            } else {
                self.record_kernel.record_at(self.record_names.get(), x.bucket)
            }
        } else if x.standing == 2 {
            (self.held_rows.get())(x.file)
        }
    }

    /// Name bucket `b`'s cell kept at the bucket's hash until a reader reads it — from
    /// then on it holds what its readers saw, and a later write is the verifier's to find.
    @bracket("decls")
    fn bucket_moved(b: int) {
        if !self.recording.get() { return }
        self
            .record_kernel
            .input_unread(self.name_key_at(b), self.decl_row_rows.get().bucket_hash(b))
    }

    /// The `Named` key of a bucket.
    fn name_key_at(b: int) -> Key { Key { family: self.record_names.get(), arg: b } }

    /// The `Named` key of `d`'s bucket.
    fn name_key(d: DeclId) -> Key { self.name_key_at(self.name_buckets.get()[d.index]) }

    /// Every declaration of a name, in id order, its bucket recorded as read — opened
    /// when nothing files there yet, so a declaration of that name arriving later moves
    /// what this read saw.
    @bracket("decls")
    fn named(name: string) -> List<Decl> {
        let b = self.name_bucket(name)
        if b >= self.cell_names.get().length { self.room_for_cell(b, name) }
        self.bucket_moved(b)
        self.record_kernel.record_at(self.record_names.get(), b)
        self.decl_row_rows.get().members(b)
    }

    /// Room for name bucket `b`'s label in the dense table.
    fn room_for_cell(b: int, name: string) {
        while self.cell_names.get().length <= b { self.cell_names.push("") }
        self.cell_names.set_at(b, name)
    }

    /// A name bucket's cell against the bucket as it stands now: its hash moves the
    /// cell, and every reader of it re-runs.
    @bracket("decls")
    fn named_now(b: int) {
        self.record_kernel.set_input(self.name_key_at(b), self.decl_row_rows.get().bucket_hash(b))
    }

    /// How many name buckets stand, emptied ones among them.
    @bracket("decls")
    fn name_bucket_count() -> int { self.decl_row_rows.get().buckets.get().length }

    /// The name a bucket files.
    fn cell_name(b: int) -> string { self.cell_names.get()[b] }

    /// A walk of file `f`'s rows records what they are a function of in the open
    /// query: the file's `Items` cell when its rows are settled, its module's record
    /// when the file is held, nothing while the rows are being minted.
    fn rows_read(f: FileId) {
        let state = self.rows_state.get()
        if f.index >= state.length { return }
        if state[f.index] == 1 {
            self.record_kernel.record_at(self.record_items.get(), f.index)
        } else if state[f.index] == 2 {
            (self.held_rows.get())(f)
        }
    }

    /// The workspace arms the recording once: the family a file's rows settle under,
    /// and what a held file's rows read instead.
    fn arm_recording(items: int, methods: int, names: int, held: fn(FileId) -> void) {
        self.record_items.set(items)
        self.record_methods.set(methods)
        self.record_names.set(names)
        self.recording.set(true)
        for b in 0..self.name_bucket_count() { self.bucket_moved(b) }
        self.held_rows.set(held)
        self.decl_rows.get().given_to(self.record_kernel)
    }

    /// Where a file's rows stand: minting (0), settled (1), held (2).
    fn note_rows(f: FileId, state: int) {
        while self.rows_state.get().length <= f.index { self.rows_state.push(0) }
        self.rows_state.set_at(f.index, state)
        for d in self.decls_so_far(f) { self.restood(d, state) }
    }

    /// Where a home's rows stand now — 0 for no home, and for a file no admission
    /// reached.
    fn home_stand(home: FileId?) -> int {
        let f? = home else { return 0 }
        let state = self.rows_state.get()
        if f.index < state.length { state[f.index] } else { 0 }
    }

    /// A row's own copy of where its file's rows stand, rewritten when it moved.
    @bracket("decls")
    fn restood(d: DeclId, state: int) {
        let x = self.raw_decl(d)
        if x.standing != state { self.decl_row_rows.get().reseat(d.index, x with { standing: state }) }
    }

    /// Every file of a module, once its held rows are minted.
    fn note_module_rows(m: ModuleId, state: int) {
        for f in self.files_of_module(m) { self.note_rows(f, state) }
    }

    /// A generated declaration's origin, or null for a written one.
    fn provenance_of(d: DeclId) -> Provenance? { self.provenance.get()[d.index] }

    /// Record a generated declaration's origin: who asked, what it
    /// wraps or names, and where.
    fn note_provenance(d: DeclId, ann: string, original: string, at: Span?) {
        self.provenance.set_at(d.index, Provenance { ann: ann, original: original, at: at })
    }

    /// The template a generated declaration was copied from — the
    /// quote's file and offset — beside who asked.
    fn note_template(d: DeclId, template: Loc?) {
        let held? = self.provenance.get()[d.index] else { return }
        self.provenance.set_at(d.index, held with { template: template })
    }

    /// One more generation admitted to a file.
    fn note_generation(f: FileId, g: Generation) {
        self.generations.set_at(f.index, self.generations.get()[f.index].concat([g]))
    }

    /// Nodes copied from a template: each wears the file that wrote it.
    /// The tables are `Cell`s, so a grow and a write both land in place —
    /// this runs once per copied node, and each call used to copy the
    /// whole table.
    /// Every node of these runs was written in `origin`.
    fn note_runs(f: FileId, runs: ArenaRuns, origin: FileId) {
        self
            .note_origins(
                f,
                [ExprId { index: i } for i in runs.exprs.lo..runs.exprs.hi],
                [StmtId { index: i } for i in runs.stmts.lo..runs.stmts.hi],
                [PatId { index: i } for i in runs.pats.lo..runs.pats.hi],
                origin,
            )
    }

    /// A generated node's own name resolves at `origin` — the file
    /// whose template wrote it, as an ordinary copied node's does.
    fn note_origins(
        f: FileId,
        exprs: List<ExprId>,
        stmts: List<StmtId>,
        pats: List<PatId>,
        origin: FileId,
    ) {
        self.mark_origin(f, exprs, stmts, pats, [], Origin.Written(origin))
    }

    /// A HOLED node's own name resolves HERE, but its span still
    /// indexes `origin`'s text (`Rebuilder` never rewrites a holed
    /// node's span) — the two questions `note_origins` answers alike
    /// answered differently, so an error about it is homed at the
    /// template without also resolving its name there.
    fn note_spanned(
        f: FileId,
        exprs: List<ExprId>,
        stmts: List<StmtId>,
        pats: List<PatId>,
        params: List<ParamId>,
        origin: FileId,
    ) {
        self.mark_origin(f, exprs, stmts, pats, params, Origin.Spanned(origin))
    }

    fn mark_origin(
        f: FileId,
        exprs: List<ExprId>,
        stmts: List<StmtId>,
        pats: List<PatId>,
        params: List<ParamId>,
        mark: Origin,
    ) {
        let known = self.origins.get()[f.index]
        for e in exprs {
            while known.exprs.get().length <= e.index { known.exprs.push(Origin.Here) }
            known.exprs.set_at(e.index, mark)
        }
        for s in stmts {
            while known.stmts.get().length <= s.index { known.stmts.push(Origin.Here) }
            known.stmts.set_at(s.index, mark)
        }
        for p in pats {
            while known.pats.get().length <= p.index { known.pats.push(Origin.Here) }
            known.pats.set_at(p.index, mark)
        }
        for p in params {
            while known.params.get().length <= p.index { known.params.push(Origin.Here) }
            known.params.set_at(p.index, mark)
        }
    }

    /// The file a generated node's own NAME resolves in, when it is
    /// another than the node's own — null for a written node and for
    /// a holed one alike, both resolving here.
    fn origin_of_expr(f: FileId, e: ExprId) -> FileId? { self.origins.get()[f.index].at(self.origins.get()[f.index].exprs.get(), e.index) }
    fn origin_of_stmt(f: FileId, s: StmtId) -> FileId? { self.origins.get()[f.index].at(self.origins.get()[f.index].stmts.get(), s.index) }
    fn origin_of_pat(f: FileId, p: PatId) -> FileId? { self.origins.get()[f.index].at(self.origins.get()[f.index].pats.get(), p.index) }

    /// Whether a seat's name came through a hole, so it binds where the
    /// code lands rather than where its fn's template was written.
    fn holed_param(f: FileId, p: ParamId) -> bool { self.origins.get()[f.index].holed(self.origins.get()[f.index].params.get(), p.index) }

    /// The file whose TEXT a generated node's span indexes, when it
    /// is another than this one — non-null for a written OR a holed
    /// node alike, both keeping the template's own offset.
    fn spanned_expr_of(f: FileId, e: ExprId) -> FileId? { self.origins.get()[f.index].spanned_at(self.origins.get()[f.index].exprs.get(), e.index) }
    fn spanned_stmt_of(f: FileId, s: StmtId) -> FileId? { self.origins.get()[f.index].spanned_at(self.origins.get()[f.index].stmts.get(), s.index) }
    fn spanned_pat_of(f: FileId, p: PatId) -> FileId? { self.origins.get()[f.index].spanned_at(self.origins.get()[f.index].pats.get(), p.index) }

    /// What a file's expansion refused, kept for its resolve to speak.
    /// IDEMPOTENT, BECAUSE THE EXPANSION RUNS TWICE BY DESIGN.
    /// `expanded` is demanded from INSIDE a resolve's miss, and the
    /// memo kernel turns that cycle into a COMPUTE, not a reuse
    /// (`start_recursive`: `.Cycle -> Compute`) — so every directive
    /// of a file is materialized by the re-entrant run and again by
    /// the outer one. The DECLARATIONS already survive that: minting
    /// is keyed by the generated fingerprint, so a second walk mints
    /// nothing new. The voices had no key — a list that is appended to
    /// — so the same refusal was spoken once per walk. This gives them
    /// the idempotence the declarations have had all along; it is not
    /// a filter over noise, and removing it doubles every refusal the
    /// splice can raise.
    fn speak_expansion(f: FileId, ds: List<Diag>) {
        for d in ds {
            if !self.expansion_voices.get()[f.index].get().any(same_voice(it, d)) { self.expansion_voices.get()[f.index].push(d) }
        }
    }

    /// A file's expansion begins with nothing refused.
    fn hush_expansion(f: FileId) {
        let no_voices: List<Diag> = []
        self.expansion_voices.set_at(f.index, Cell.new(no_voices))
    }

    /// The generation a file's node came from — null for a written one.
    fn generation_of(f: FileId, e: ExprId) -> Generation? {
        self.generations.get()[f.index].find(it.runs.exprs.holds(e.index))
    }

    fn generation_of_stmt(f: FileId, s: StmtId) -> Generation? {
        self.generations.get()[f.index].find(it.runs.stmts.holds(s.index))
    }

    fn generation_of_pat(f: FileId, p: PatId) -> Generation? {
        self.generations.get()[f.index].find(it.runs.pats.holds(p.index))
    }

    /// The declaration a statement of a file makes, when it does.
    fn decl_of(f: FileId, s: StmtId) -> DeclId? { self.decl_ids.get()[f.index].get().get(s.index).decl }

    /// The declaration whose range owns an expression — an O(1) read
    /// of what `range_bodies` already computed, never a rescan.
    /// `?.decl` is safe to fold here, UNLIKE `decl_ids`: `range_bodies`
    /// seeds `owner` at Main and only ever reassigns it a REAL decl
    /// (`innermost(...) ?? main`), never `null` — so a written cell's
    /// `decl` is never absent, and `null` means only "outside the
    /// window" (never written: a held file, or growth past it),
    /// exactly what the caller's `?? enclosing_decl_scanned` fallback
    /// wants. `decl_ids` cannot fold the same way: an ordinary
    /// non-declaring statement writes `decl: null` deliberately, a
    /// DIFFERENT absence than "outside the window" — so it keeps the
    /// trapping `SideTable.get` to tell the two apart.
    fn expr_owner(f: FileId, e: ExprId) -> DeclId? {
        DeclAt.get(self.expr_owners.get()[f.index].get(), e.index)?.decl
    }

    fn store(d: DeclId) -> SyntaxArena { self.store_of(self.decl(d).file) }

    fn module_of(d: DeclId) -> string { self.module_name(self.file(self.decl(d).file).module_id) }

    /// A declaration's module fully qualified, as `use` spells it from
    /// outside the package: a root module gains the root's own name.
    fn qualified_module(d: DeclId) -> string {
        let m = self.module_of(d)
        if !package_of_module(m).is_empty() { return m }
        let root = self.root_name.get()
        when {
            m.is_empty() -> root
            root.is_empty() -> m
            _ -> "${root}.${m}"
        }
    }
    /// A declaration's package — its module's, by `package_named`.
    fn package_of(d: DeclId) -> string { self.package_named(self.module_of(d)) }

    /// A module's package in the DOTTED spelling every package read
    /// compares (`@std.meta`): the prefix a dependency's module carries,
    /// or the root's manifest name for a root module, which none
    /// prefixes — "" for a lone file, which has no package.
    fn package_named(module: string) -> string {
        let named = package_of_module(module)
        if named.is_empty() { self.root_name.get() } else { named }
    }

    /// A declaration's module, package prefix dropped: `nullable`
    /// for one under `features/nullable/`, wherever the package
    /// that carries it sits in a build — a rule's identity
    /// (`rule_id`, compiler/rules_table.av) is named after this, so
    /// it must read the same whether `@std/avrac` is the root being
    /// built or a dependency of the program that carries it.
    fn short_module_of(d: DeclId) -> string { self.module_of(d).split(".").last()! }

    /// Every declaration of `k` admitted so far — a fixture proving
    /// one (`FileInfo.test`) is not the program's own. Admission is
    /// the caller's.
    fn decls_of_kind(k: DeclKind) -> List<Decl> {
        [d for d in self.all_decls() if d.kind == k && !self.file(d.file).test]
    }

    /// Every declaration `collect` gathers under `word` — a declared instance
    /// of that component — in id order.
    fn indexed(word: string) -> List<Decl> { self.filed(word_index, word) }

    /// Every declaration wearing `@name`, in id order.
    fn indexed_by_mark(name: string) -> List<Decl> { self.filed(marks_index, name) }

    /// The rows filed under `v` in `Decl`'s index `i`: the bucket read
    /// unrecorded, each row read through `decl`, which records it.
    @bracket("decls")
    fn filed(i: int, v: string) -> List<Decl> {
        let rs = self.decl_row_rows.get()
        [self.decl(x.id) for x in rs.members(rs.bucket_of_text(i, v))]
    }

    /// Every declaration of `word` admitted so far, less a fixture
    /// (`FileInfo.test`) — unscoped, so it answers alike for every caller.
    fn decls_of_word(word: string) -> List<Decl> { [d for d in self.indexed(word) if !self.file(d.file).test] }

    /// The root package's manifest name, kept in the dotted spelling.
    fn name_root(name: string) { self.root_name.set(name.replace("/", ".")) }

    /// Whether a meta value CARRIES A NAME — a declaration's, a
    /// field's, a variant's, a parameter's — which is what a quote's
    /// hole splices of it.
    fn meta_names_one(ty: TypeId) -> bool {
        self.takes_a_decl(ty) ||
            self.meta_type(ty, "Field") ||
            self.meta_type(ty, "Variant") ||
            self.meta_type(ty, "Param")
    }

    /// A declaration of `@std/meta` by name — the compiler's own door
    /// to the meta vocabulary (`Node`, `template`, `as_decls`); null
    /// when the program does not load the package.
    fn meta_named(name: string) -> DeclId? {
        self.package_decl("@std.meta", name)
    }

    /// A declaration of THIS COMPILER'S OWN library by name — the
    /// door to `Code`, the handle a rule holds; null when the program
    /// does not load `@std/avrac`.
    fn avrac_named(name: string) -> DeclId? {
        self.package_decl("@std.avrac", name)
    }

    /// A declaration of the PRELUDE by name — the door to the names
    /// the compiler's own answers wear (`Entry`); null when the
    /// program sees no prelude, as a lone file does not.
    fn prelude_named(name: string) -> DeclId? {
        self.package_decl("@std.prelude", name)
    }

    /// The prelude's `Entry<string, V>` — what a map's walk hands out
    /// per turn; null when the program sees no prelude.
    fn entry_of(value: TypeId) -> TypeId? {
        let entry? = self.prelude_named("Entry") else { return null }
        // a record's layout is its declaration's answer
        let _ = self.sig(entry)
        self.types.intern(Type.App(entry, "Entry", [self.types.type(string), value]))
    }

    /// Whether a type IS one declaration a package exports, by NAME —
    /// `meta_type`'s door, generalized past `.Struct` to `.Enum` too,
    /// so `@std/avrac`'s `Fix` (an enum) answers through the same
    /// check `Code` (a struct) does.
    fn declared_as(ty: TypeId, pkg: string, name: string) -> bool {
        let d: DeclId? = match self.types.shape_of(ty) {
            .Struct(d, _) or .Enum(d, _) -> d,
            rest -> null,
        }
        d != null && self.decl(d!).name == name && self.package_of(d!) == pkg
    }

    /// A type IS `@std/avrac`'s declaration of this name — the same
    /// door `avrac_named` opens for a value, read back over a type.
    fn avrac_type(ty: TypeId, name: string) -> bool {
        self.declared_as(ty, "@std.avrac", name)
    }

    /// A declaration a PACKAGE exports, by name — the door to a
    /// vocabulary the compiler shares with the programs it compiles;
    /// null when the program does not load the package.
    ///
    /// THE NAME'S OWN BUCKET IS READ: every declaration of the name,
    /// a builtin — no file's, so no package's — never answering.
    ///
    /// EVERY MODULE OF THE PACKAGE IS SEARCHED, not its first: a
    /// package a `use` reaches through ONE submodule (`@std/avrac`'s
    /// `core`, say) admits every OTHER submodule too, so a name in a
    /// DIFFERENT one (`features`'s `Code`) is still the package's —
    /// reading only `ms[0]`'s files answered null for it whenever
    /// that module happened to load first, which depends on `use`
    /// order and so is not a property of the name at all.
    ///
    /// AND THE PACKAGE NAME IS `package_named`'S, never the raw
    /// `package_of_module`: the ROOT package's own modules carry NO
    /// prefix (that is what makes them the root's), so a door asked
    /// for THE PACKAGE BEING COMPILED — `@std/avrac` checking its
    /// own `Code` while typing ITS OWN test suite — answered null
    /// for every one of its modules, `avrac_named` most of all: the
    /// compiler is the one program that always loads its own library.
    ///
    /// AND ONLY AN EXPORTED DECLARATION ANSWERS: searching every
    /// module (above) reaches a package's PRIVATE names too, and a
    /// door built to find the shared vocabulary is not asking about
    /// those — `compiler/record.av`'s own, unexported `enum Shape`
    /// answered for `avrac_named("Shape")` before this line, a
    /// different enum entirely from `core/shape.av`'s exported one,
    /// wrong variants and all, chosen only because ITS module was
    /// searched first.
    fn package_decl(pkg: string, name: string) -> DeclId? {
        let key = "${pkg}.${name}"
        let known: DeclId? = self.meta_ids.get().get(key)
        if known != null { return known }
        let found = [x.id for x in self.named_rows(name) if x.home != null && x.exported && self.package_of(x.id) == pkg]
            .first()
        if found != null { self.meta_ids.put(key, found!) }
        found
    }

    /// A MODULE's export of `name`, the module fully qualified as `use`
    /// spells it from outside its package (`@std.ui.realize`).
    fn module_decl(module: string, name: string) -> DeclId? {
        self
            .named_rows(name)
            .find((x) -> x.home != null && x.exported && self.qualified_module(x.id) == module)?.id
    }

    /// Whether a declaration IS `@std/meta`'s export of `name` — by
    /// DECLARATION, never the word it happens to answer to: the
    /// package and the export name locate the identity without
    /// accepting an equal-shaped user declaration.
    fn is_meta_fn(d: DeclId, name: string) -> bool {
        self.decl(d).name == name && self.package_of(d) == "@std.meta"
    }

    fn arm_embeds(judge: fn(FileId, string) -> Result<string, EmbedFault>) { self.embed_judge.set(judge) }

    /// The path of the file an `embed` literal in `f` names, when a const
    /// may read it — or what is wrong with it.
    fn embed_placed(f: FileId, rel: string) -> Result<string, EmbedFault> { (self.embed_judge.get())(f, rel) }

    /// Whether a type is one declaration exported by `@std/meta` —
    /// `is_meta_fn`'s door, opened over a TYPE's shape rather than a
    /// resolved declaration directly.
    fn meta_type(ty: TypeId, name: string) -> bool {
        match self.types.shape_of(ty) {
            // THE DECLARATION'S name, never the WRITTEN spelling: a
            // `use @std.meta.{Fn as F}` gives the type the alias in its
            // written name, and the boundary must still read `Fn`.
            .Struct(d, _) -> self.is_meta_fn(d, name),
            rest -> false,
        }
    }

    /// Whether slot `j` is a SITE: a field typed `@std/meta`'s `Site`,
    /// which a literal that leaves it unset fills with where it was
    /// written — so it owes no default.
    fn sited_slot(sig: StructSig, j: int) -> bool { self.meta_type(sig.types[j], "Site") }

    /// A declaration's signature — asking it IS the query: the hook
    /// the workspace arms computes it on first ask and records the
    /// dependency; the table only holds.
    fn sig(d: DeclId) -> DeclSig? {
        (self.ensure.get())(d)
        let held: DeclSig? = self.sigs.get()[d.index]
        held
    }

    /// `sig`'s table read alone, NEVER triggering the hook: for a
    /// caller that is itself INSIDE `d`'s own signing (or a fixpoint
    /// `d` itself belongs to) and must not recurse back into it —
    /// null answers "not settled yet," never "not there is an error."
    fn sig_so_far(d: DeclId) -> DeclSig? {
        if audit_build && self.auditing.get() { self.audited(Bypassed.SigSoFar(d)) }
        self.sigs.get()[d.index]
    }

    /// A fn's own PARAMETERS — asking it IS the query, exactly as `sig` is,
    /// with one difference: the answer never depends on inference, so this
    /// carries none of `sig`'s self-recursion hazard. A caller mid-`d`'s-own
    /// answer inference (failures.av's fixpoint) may ask this safely; asking
    /// `sig` there cannot be, since the answer is what it would be computing.
    fn seats(d: DeclId) -> List<TypeId> {
        if self.seat_types.get()[d.index] == null { (self.seat_ensure.get())(d) }
        self.seat_types.get()[d.index] ?? []
    }

    /// `seats`' table read alone, NEVER triggering the hook: for the fn's
    /// own natural signing (`declare_sig`, `seated_answer`), which already
    /// holds the correct `fparams` to type itself — an extern's among them,
    /// which the hook cannot derive (it walks the statement structurally,
    /// and `fn_parts` does not recognize an extern's shape). Null answers
    /// "not yet typed by an early asker," never "there are none."
    fn seat_types_so_far(d: DeclId) -> List<TypeId>? { self.seat_types.get()[d.index] }

    /// Records a fn's own parameters — the receiver's first when it has
    /// one, in the same order `sig`'s own `FnSig.params` wears. Idempotent:
    /// whichever caller's ask lands first (`seats`'s hook, or the fn's own
    /// natural `declare_sig`/`declare_method`/`declare_trait_sig`) records
    /// here, and the other finds it already settled.
    fn record_seat_types(d: DeclId, ts: List<TypeId>) { self.seat_types.set_at(d.index, ts) }

    /// The trait arguments seat `j`'s bound names — `[]` for a bound that takes none.
    fn bound_args(d: DeclId, j: int) -> List<TypeId> {
        let all? = self.bound_types.get()[d.index] else { return [] }
        if j < 0 || j >= all.length { [] } else { all[j] }
    }

    /// Records every type parameter's bound's trait arguments, in seat order.
    fn record_bound_args(d: DeclId, args: List<List<TypeId>>) { self.bound_types.set_at(d.index, args) }

    /// The hooks capture the workspace that holds this table — a
    /// cycle counting never frees. A one-shot workspace disarms them
    /// once every declaration it will ever ask about is signed; a
    /// sig asked after that is held or, loudly, absent. `ensure_consumed`
    /// stays armed, as `ensure_refs` already does: consumption is asked
    /// at LOWERING, after a one-shot's own disarm, so zeroing this hook
    /// here would make every seat read unconsumed forever.
    fn disarm() {
        self.auditing.set(false)
        self.decl_rows.get().released()
        self.held_rows.set(no_store)
        self.ensure.set(no_ensure)
        self.seat_ensure.set(no_ensure)
        self.ensure_const.set(no_const_ensure)
        self.ensure_entry.set(no_entry_ensure)
        self.ensure_methods.set(no_ensure)
        self.ensure_writes.set(no_answer)
        self.ensure_marks.set(no_marks)
        self.ensure_store.set(no_store)
        self.ensure_file.set(no_store)
        self.ensure_package.set(no_store)
        self.ensure_failures.set(no_failures_ensure)
        self.lifter.set(no_lifter)
        self.namespace_of.set(no_namespace)
        self.apart_of.set(none_apart)
        self.composers_of.set(none_apart)
    }

    /// A TABLE NOTHING ASKS AGAIN, LET GO: every hook, the ones a one-shot
    /// keeps armed among them, so it holds no closure back to its workspace —
    /// and its relations closed, since a relation's rows stand in the process
    /// under their Db until it closes. A read after this is refused.
    fn let_go() {
        self.disarm()
        self.ensure_target.set(no_ensure)
        self.ensure_consumed.set(no_ensure)
        self.ensure_refs.set(no_refs_ensure)
        self.embed_judge.set(embed_unjudged)
        self.audit_hook.set(no_audit)
        self.types.disarm_declare()
        self.decl_rows.get().close()
        self.refs_db.get().close()
    }

    /// The workspace arms the sig hook once.
    fn arm(ensure: fn(DeclId) -> void) {
        self.ensure.set(ensure)
    }

    /// The workspace arms the seats hook once.
    fn arm_seats(ensure: fn(DeclId) -> void) {
        self.seat_ensure.set(ensure)
    }

    /// The workspace arms the held-row hook once.
    fn arm_target(ensure: fn(DeclId) -> void) {
        self.ensure_target.set(ensure)
    }

    fn arm_const(ensure: fn(FileId, StmtId) -> bool) { self.ensure_const.set(ensure) }

    /// The workspace arms the entry hook once.
    fn arm_entry(ensure: fn() -> bool) { self.ensure_entry.set(ensure) }

    /// Whether THIS compilation is a program — has an entry the
    /// workspace will run — or a library, read at run time only.
    fn is_program() -> bool { (self.ensure_entry.get())() }

    /// Every declaration `word` names WITHIN `scope`. `package` admits
    /// every file of the owner's package first, so a member in a file
    /// nothing imports is gathered all the same; `closure` gathers what
    /// imports reach (docs/2026_09_22_COLLECTIONS.md §5: contributions
    /// merge exactly where imports merge); `self` the owner's own file.
    /// Read through `Decl`'s `word` bucket, filtered through `collectible`,
    /// which lets a program test's own `collect` see its sibling
    /// declarations and no other file's fixtures.
    fn gathered(word: string, scope: CollectScope, owner: FileId) -> List<Decl> {
        self.admit_scope(scope, owner)
        [d for d in self.indexed(word) if self.collectible(d, scope, owner)]
    }

    /// `gathered`'s mark twin: every declaration wearing `@name`,
    /// filtered to `scope` the same way.
    fn gathered_by_mark(name: string, scope: CollectScope, owner: FileId) -> List<Decl> {
        self.admit_scope(scope, owner)
        [d for d in self.indexed_by_mark(name) if self.collectible(d, scope, owner)]
    }

    /// The files `scope` gathers from, admitted: a package's every file,
    /// once per package. The rest gather what is already admitted.
    fn admit_scope(scope: CollectScope, owner: FileId) {
        let p = self.package_of_file(owner)
        if !admits_package(scope) || self.scoped.get().get(p) != null { return }
        self.scoped.put(p, true)
        (self.ensure_package.get())(owner)
    }

    /// The workspace arms the package hook once.
    fn arm_package(ensure: fn(FileId) -> void) { self.ensure_package.set(ensure) }

    /// Whether `owner`'s collect may gather `d`: `in_scope`'s law,
    /// and — for a declaration a package's own test tree holds — ONLY
    /// when `owner` stands in that SAME FILE. A fixture written to
    /// test the collect mechanism itself must never leak into another
    /// file's collect (`rules`, closure-scoped, gathers no component-
    /// test fixture); a program test's own `collect` gathers its own
    /// sibling declarations all the same, since they share its file.
    fn collectible(d: Decl, scope: CollectScope, owner: FileId) -> bool {
        self.in_scope(d, scope, owner) && (!self.file(d.file).test || same_file(d.file, owner))
    }

    /// A REGISTRY match over `CollectScope`: `self` is the owner's own
    /// file, `package` the owner's own package, `closure` everything
    /// admitted — ACROSS PACKAGES, EXPORTED DECLARATIONS ONLY
    /// (docs/2026_09_22_COLLECTIONS.md §4.4): a declaration in the
    /// owner's OWN package is seen either way, private ones included,
    /// the same as `self`/`package` already see; one a DIFFERENT
    /// package holds must have said `export`, or a dependency could
    /// silently hand a program its own unexported internals. An
    /// unknown scope was already refused at `check_collect` — it
    /// gathers nothing, honestly.
    fn in_scope(d: Decl, scope: CollectScope, owner: FileId) -> bool {
        match scope {
            .Self -> same_file(d.file, owner),
            .Package -> self.package_of_file(d.file) == self.package_of_file(owner),
            .Closure -> d.exported || self.package_of_file(d.file) == self.package_of_file(owner),
            .UnknownScope(_) -> false,
        }
    }

    fn package_of_file(f: FileId) -> string {
        self.package_named(self.module_name(self.file(f).module_id))
    }

    fn const_type(f: FileId, s: StmtId) -> ConstType {
        if (self.ensure_const.get())(f, s) { return ConstType.Cyclic }
        let held? = self.held_const_type(f, s) else { return ConstType.Refused }
        ConstType.Known(held)
    }

    fn held_const_type(f: FileId, s: StmtId) -> TypeId? { self.const_types.get().get(const_type_key(f, s)) }

    fn held_value(d: DeclId) -> Settled? { self.held_values.get().get("${d.index}") }

    fn remember_held_value(d: DeclId, value: Settled) { self.held_values.put("${d.index}", value) }

    fn held_reach(d: DeclId) -> string? { self.held_reaches.get().get("${d.index}") }

    fn remember_held_reach(d: DeclId, words: string) { self.held_reaches.put("${d.index}", words) }

    fn record_const_type(f: FileId, s: StmtId, ty: TypeId) {
        self.const_types.put(const_type_key(f, s), ty)
    }

    /// The workspace arms the lifting hook once.
    fn arm_lifter(
        lift: fn(DeclId, FileId, StmtId, ExprId, List<ExprId>) -> Result<Lifted, Unsettled>,
    ) {
        self.lifter.set(lift)
    }

    /// The workspace arms the namespace hook once.
    fn arm_namespace(ns: fn(FileId) -> Namespace) {
        self.namespace_of.set(ns)
    }

    /// The workspace arms the composers hook once.
    fn arm_composers(composers: fn(FileId) -> List<DeclId>) {
        self.composers_of.set(composers)
    }

    /// The workspace arms the kept-apart hook once.
    fn arm_apart(apart: fn(FileId) -> List<DeclId>) {
        self.apart_of.set(apart)
    }

    /// The workspace arms the marks hook once — a declaration's
    /// use-site warnings are a query of the program, never a table
    /// an earlier walk happened to fill.
    fn arm_marks(ensure: fn(DeclId) -> void) {
        self.ensure_marks.set(ensure)
    }

    /// A declaration's warnings, asked at a use. Asking IS the
    /// computation; the table only holds.
    fn marks(d: DeclId) -> List<Diagnostic> {
        (self.ensure_marks.get())(d)
        let held: List<Diagnostic>? = self.marks.get()[d.index]
        held ?? []
    }

    fn record_marks(d: DeclId, xs: List<Diagnostic>) {
        self.marks.set_at(d.index, xs)
    }

    /// An annotation fn `d` run over the declaration at `s` in file
    /// `f`, with these settled arguments — asking IS the run.
    fn lifted(d: DeclId, f: FileId, s: StmtId, call: ExprId, args: List<ExprId>) -> Result<
        Lifted,
        Unsettled,
    > {
        (self.lifter.get())(d, f, s, call, args)
    }

    /// A list type's element, or null for any other shape.
    fn elem_of(ty: TypeId) -> TypeId? {
        match self.types.shape_of(ty) { .List(e) -> e, _ -> null }
    }

    /// A declaration's signature — and with a record's, its LAYOUT: a
    /// signature typed from source and one read from an interface both
    /// land here, so a layout has one law.
    fn declare(d: DeclId, sig: DeclSig) {
        self.sigs.set_at(d.index, sig)
        let e: EnumSig? = enum_parts(sig)
        if e != null { return self.flatten_enum(d, e!) }
        let r? = sig.record_sig() else { return }
        self.flatten(d, r.types)
        self.types.mark_settled(self.record_type(d))
    }

    /// AN ENUM WHOSE VARIANTS CARRY NOTHING IS ITS TAG — a word, as C
    /// spells an enum: no box to build per variant, nothing to count.
    /// ONE WHOSE VARIANTS EACH CARRY AT MOST ONE WORD is a VALUE ENUM:
    /// its tag and that word ride registers, and a box is made only
    /// where a slot holds it.
    fn flatten_enum(d: DeclId, e: EnumSig) {
        if !self.tparams(d).is_empty() { return }
        let ty = self.types.intern(Type.Enum(d, self.decl(d).name))
        self.laid_out(d, ty, e)
        self.types.mark_settled(ty)
    }

    /// An enum's layout: its tag alone, its tag and one word, or its box.
    fn laid_out(d: DeclId, ty: TypeId, e: EnumSig) {
        if e.payloads.all(it.is_empty()) { return self.types.mark_flat(ty, [self.types.type(int)]) }
        if e.payloads.length > max_valued_variants { return }
        let words = [self.variant_word(d, ps) for ps in e.payloads]
        if words.any(it == null) { return }
        self.types.mark_valued(ty, counted_bits([w! for w in words]))
    }

    /// What one variant's payloads make of its word: absent when it
    /// carries more than one or a payload is not ONE word, 0 when the
    /// word is uncounted (none, or an int), 1 when it is a pointer.
    fn variant_word(d: DeclId, ps: List<TypeId>) -> int? {
        if ps.length > 1 { return null }
        let t? = ps.first() else { return 0 }
        self.payload_word(d, t)
    }

    /// A STRUCT or ENUM's layout answers the blank default — not flat,
    /// not valued, not settled — until its OWN declaration has run;
    /// asking a layout fact of one that has not is asking a different
    /// question from every later ask (CLAUDE.md, "a slot's seed is
    /// computed the same way as its updates"). Force it first: a
    /// registry reader outside the type's own declare pass never
    /// knows whether demand has reached it yet, and the crossing
    /// machinery — `materialized`'s whole family, deep in const and
    /// `@derive` settlement — reads layout facts on exactly the types
    /// demand order has not forced.
    /// AND EVERY SEAL THAT WILL EVER LAND MUST LAND FIRST TOO (R11c,
    /// avra-8sb5.34.21): a flat record's payload word depends on
    /// whether a `mut` seat elsewhere still boxes it, and a seal
    /// discovered after this ask is refused rather than applied
    /// (L1, avra-8sb5.34.30.1) — so a `.Fn` whose PARSED signature
    /// names this type under `mut` is forced here too, before either
    /// declaration's flatness is read.
    fn declared_first(t: TypeId) {
        match self.types.shape_of(t) {
            .Struct(r, _) or .Enum(r, _) -> {
                for sealer in self.mut_seat_sealers(self.decl(r).name) { touch(self.sig(sealer)) }
                let _ = self.sig(r)
            },
            rest -> nothing_asked(),
        }
    }

    /// Every `.Fn` decl whose `mut` parameters seal `name` — a NAME match,
    /// never a type match: two distinct types sharing one name may
    /// over-trigger (an extra `sig()` on an unrelated fn, harmless). A miss
    /// is L1's refusal ("read before a `mut` seat sealed it"), so the index
    /// covers every declaration whose facts have landed, held ones included.
    fn mut_seat_sealers(name: string) -> List<DeclId> {
        self.mut_seat_index.get().get(name) ?? []
    }

    /// A payload's word, asked of its own declaration first so the
    /// answer never depends on which was declared first: 0 an int, a
    /// word enum, or a flat record over one of those (`machine_type`
    /// sees straight through it — R11c, avra-8sb5.34.21, once every
    /// seal that will ever land has already landed: `declared_first`
    /// forces `mut_seat_sealers` before either flatness is read),
    /// 1 a pointer that is counted, absent for anything else — a
    /// float, a bool, a raw pointer, a pair, a wide value record, and
    /// an enum that carries anything. A bool or a float payload stays
    /// OUT here on purpose, unlike `side_word`'s Result side (R15a): a
    /// value-enum PAYLOAD of either broke the compiler's own
    /// settlement of `MetaVal` (features/worklist.av) — a real trap,
    /// cause not yet found. Widening this arm to match needs that
    /// cause found first.
    fn payload_word(d: DeclId, t: TypeId) -> int? {
        self.declared_first(t)
        let m = self.types.machine_type(t)
        match self.types.shape_of(m) {
            .Int -> 0,
            .Enum(e, _) -> if !same_decl(e, d) && self.carries_nothing(e) { 0 } else { null },
            .Struct(_, _) -> if self.types.travels_wide(m) { null } else { 1 },
            .Opt(inner) -> if self.types.opt_rides_pointer(inner) { 1 } else { null },
            .Str or .Bytes or .List(_) or .Map(_, _) or .Cell(_) or .Task(_) or .Tasks or .Res(_, _) or .App(_, _, _) or .Dyn(_, _) or .Fn(_, _, _) or .Union(_) or .Range -> 1,
            .Float or .Bool or .Ptr or .TypeName(_, _) or .Var(_, _, _) or .Null or .EmptyList or .EmptyMap or .Error or .Void -> null,
        }
    }

    /// Whether an enum's own declaration gives none of its variants a
    /// payload — read from its signature, never its layout.
    fn carries_nothing(e: DeclId) -> bool {
        if !self.tparams(e).is_empty() { return false }
        let s? = self.sig(e) else { return false }
        let es? = enum_parts(s) else { return false }
        es.payloads.all(it.is_empty())
    }

    /// THE FLAT LAW: a record of SCALAR fields and no type parameters
    /// IS its fields — one field an id in a register, several a VALUE
    /// RECORD in registers (a span, a line), boxed only where a one-word
    /// seat holds it. A pointer-riding field keeps the box, because that
    /// reference must still be counted.
    fn flatten(record: DeclId, types: List<TypeId>) {
        if types.is_empty() || !self.tparams(record).is_empty() { return }
        if !types.all((t) -> self.scalar_field(t)) { return }
        self.types.mark_flat(self.record_type(record), types)
    }

    /// A SCALAR FIELD: an `int`, a `bool` (the runtime's i64 seams
    /// coerce it by shape), a WORD ENUM — one whose own declaration
    /// carries no payload anywhere, so its tag is its whole value —
    /// or a WORD ENUM's NULLABLE, which spends the spare tag -1 and
    /// so is one register too. Asked of the field's own declaration
    /// through `carries_nothing`, never of the type registry's marks,
    /// so the answer never depends on which of the two was declared
    /// first.
    fn scalar_field(t: TypeId) -> bool {
        match self.types.shape_of(t) {
            .Int or .Bool -> true,
            .Enum(e, _) -> self.carries_nothing(e),
            .Opt(inner) -> match self.types.shape_of(inner) {
                .Enum(e, _) -> self.carries_nothing(e),
                rest -> false,
            },
            rest -> false,
        }
    }

    /// A record declaration's own type.
    fn record_type(record: DeclId) -> TypeId { self.types.intern(Type.Struct(record, self.decl(record).name)) }

    fn tparams(d: DeclId) -> List<string> {
        let x = self.decl(d)
        if x.kind is .Builtin { return builtin_tparams(self.row_of(d)!.arity) }
        if x.kind is .Impl { return self.target_tparams(d) }
        // A TRAIT DECLARES ONE TYPE PARAMETER, `Self` — its
        // implementor — and its members wear it: a default body is
        // a generic method over `Self`, lowered per signatory.
        if x.kind is .Trait { return [self_word].concat(self.facts_of(d)?.tparams ?? []) }
        self.facts_of(d)?.tparams ?? []
    }

    /// An impl block's type parameters are its TARGET's — a method
    /// under `impl Arena<N>` instantiates with `Arena`'s Vars.
    fn target_tparams(impl_decl: DeclId) -> List<string> {
        let t? = self.target_of(impl_decl) else { return [] }
        self.tparams(t)
    }

    // ── the inout seats ──

    /// A declaration's seat CONTRACTS, as declared — a method's seat
    /// 0 is its receiver and is never declared here. The written bits
    /// take the same shape, all false until the pass runs.
    fn record_seats(d: DeclId, marks: List<SeatMark>) {
        self.seat_marks.set_at(d.index, marks)
        self.written_seats.set_at(d.index, Cell.new(filled(marks.length, false)))
    }

    /// How many seats a declaration has — the receiver's included.
    fn seat_count(d: DeclId) -> int { self.seat_marks.get()[d.index].length }

    /// Asking IS the query: the sig hook declares `d` first, so a
    /// callee named before its own declaration answers truly.
    /// A declaration's seats' marks, sized to its seats — the
    /// contract a fn VALUE of it carries.
    fn marks_of(d: DeclId, n: int) -> List<SeatMark> {
        mut out: List<SeatMark> = []
        mut j = 0
        while j < n {
            out.push(self.seat_mark(d, j))
            j = j + 1
        }
        out
    }

    /// Seat `i`'s DECLARED mark — `mut`, `const`, `isolated`, exactly
    /// as written. `consumed` (R3) is asked separately
    /// (`consumed_seat`) and NEVER merged in here: this is the
    /// currency `marks_of` hands a fn VALUE's type, and `consumed`
    /// depends on the whole-program references pass, which runs
    /// AFTER the very sites that read a fn's type (a struct field's
    /// value, `fn_fits`) are typed — merging it in here would bake a
    /// too-early answer into an interned TYPE that never gets
    /// re-asked. `Body.marks` (compiler/lower/lower.av) is where the
    /// two currencies actually meet, read together at lowering, once
    /// the fn's OWN body — never its callers' types — is what needs
    /// the answer.
    fn seat_mark(d: DeclId, i: int) -> SeatMark {
        self.declared_mark(d, i)
    }

    /// Seat `i`'s DECLARED mark ALONE — the same answer `seat_mark`
    /// gives now; kept as its own name for the consumes pass's own
    /// read (`eligible_seat`), which must never ask through a name
    /// that could grow a merge again.
    fn declared_mark(d: DeclId, i: int) -> SeatMark {
        (self.ensure.get())(d)
        mark_at(self.seat_marks.get()[d.index], i)
    }

    /// `mut fn` — the method (or trait sig) declared its receiver
    /// written.
    fn record_declared_writing(d: DeclId) {
        self.declared_writes.set_at(d.index, true)
    }

    fn declares_writing(d: DeclId) -> bool {
        (self.ensure.get())(d)
        self.declared_writes.get()[d.index]
    }

    /// The seats pass found the body writing through seat `i`.
    fn record_seat_written(d: DeclId, i: int) {
        if i < self.written_seats.get()[d.index].get().length { self.written_seats.get()[d.index].set_at(i, true) }
    }

    /// The pass's own reads — hook-free, as the table stands.
    fn seat_written_so_far(d: DeclId, i: int) -> bool {
        if audit_build && self.auditing.get() { self.audited(Bypassed.Written(d)) }
        let row = self.written_seats.get()[d.index].get()
        i < row.length && row[i]
    }

    /// Whether seat `i` is written, declared or found: a method's
    /// receiver by its word, any seat by the pass.
    @bracket("receivers")
    fn seat_writes_so_far(d: DeclId, i: int) -> bool {
        i == 0 && self.declared_writes.get()[d.index] || self.seat_written_so_far(d, i)
    }

    /// The pass starts over: every inferred bit falls, and the
    /// fixpoint re-earns them.
    fn clear_written() {
        // A HELD FILE'S SETTLED BITS ARE THE INTERFACE'S, not this pass's to clear:
        // the receivers pass never surveys a held body, so wiping them loses the
        // writer a caller's retain decision reads. The pass clears what it owns.
        for x in self.all_decls() {
            let j = x.id.index
            if self.held.get().get(self.file(x.file).path) == null {
                self
                    .written_seats
                    .set_at(j, Cell.new(filled(self.written_seats.get()[j].get().length, false)))
            }
        }
    }

    /// A `_`-declared fn's growing error set, as the fixpoint found it
    /// so far — deduped by type identity, the pass's own read, hook-free.
    fn inferred_errors_so_far(d: DeclId) -> List<TypeId> {
        if audit_build && self.auditing.get() { self.audited(Bypassed.Errors(d)) }
        self.inferred_errs.at(d.index) ?? []
    }

    /// One contribution recorded, unless already present.
    @bracket("fail_summary")
    fn record_inferred_error(d: DeclId, ty: TypeId) {
        let cur = self.inferred_errors_so_far(d)
        if !cur.any(same_type(it, ty)) { self.inferred_errs.keep(d.index, cur.concat([ty])) }
    }

    /// Whether `d`'s own walk hit a site it could not structurally
    /// resolve — a real refusal of `_`, never a silently missing member.
    fn inferred_is_unresolved(d: DeclId) -> bool {
        self.inferred_unresolved.at(d.index) ?? false
    }

    fn mark_inferred_unresolved(d: DeclId) {
        self.inferred_unresolved.keep(d.index, true)
    }

    /// The pass starts over: every `_`-declared fn's set falls, and
    /// the fixpoint re-earns it. Held files are exempt for the same
    /// reason `clear_written` exempts them: a held fn's union rode its
    /// interface, never this pass.
    fn clear_inferred() {
        for x in self.all_decls() {
            if self.held.get().get(self.file(x.file).path) == null {
                self.inferred_errs.keep(x.id.index, [])
                self.inferred_unresolved.keep(x.id.index, false)
            }
        }
    }

    /// A `_`-declared fn's SETTLED error set — asking IS the query:
    /// the hook runs the whole-program fixpoint once, and this table
    /// holds every fn's answer after.
    @bracket("fail_summary")
    fn inferred_errors(d: DeclId) -> List<TypeId> {
        (self.ensure_failures.get())()
        self.inferred_errors_so_far(d)
    }

    /// Whether a method WRITES its receiver: declared, or found by the receivers pass.
    /// Asking IS the query: the hook runs the pass and records the dependency. Where the
    /// pass cannot run (inside a resolve) the hook answers false and only what was
    /// declared is read, so every answer is a function of what is recorded.
    @bracket("receivers")
    fn writes_receiver(d: DeclId) -> bool {
        let answered = (self.ensure_writes.get())(d)
        self.declared_writes.get()[d.index] || answered && self.seat_written_so_far(d, 0)
    }

    /// The receiver's bit as the receivers pass found it, or null where the pass could
    /// not be asked: an absence of a finding is no finding of absence.
    @bracket("receivers")
    fn written_found(d: DeclId) -> bool? {
        if !(self.ensure_writes.get())(d) { return null }
        self.seat_written_so_far(d, 0)
    }

    /// Whether the body writes through seat `i` as the pass found it, false where the
    /// pass could not be asked; the declared `mut` is what the caller's law reads.
    @bracket("receivers")
    fn seat_written(d: DeclId, i: int) -> bool {
        let answered = (self.ensure_writes.get())(d)
        answered && self.seat_written_so_far(d, i)
    }

    /// The workspace arms the receivers hook once.
    fn arm_writes(ensure: fn(DeclId) -> bool) {
        self.ensure_writes.set(ensure)
    }

    /// The consumes pass's own record — one seat's evidence, once
    /// computed.
    fn record_consumed(d: DeclId, bits: List<bool>) {
        self.consumed.set_at(d.index, bits)
    }

    /// Whether the body infers seat `i` CONSUMED — asking runs the
    /// pass; a held (precompiled) declaration answers false, since
    /// nothing here re-infers from a body it never stored.
    fn consumed_seat(d: DeclId, i: int) -> bool {
        if self.consumed.get()[d.index] == null { (self.ensure_consumed.get())(d) }
        let row: List<bool>? = self.consumed.get()[d.index]
        row != null && i < row!.length && row![i]
    }

    /// The workspace arms the consumes hook once.
    fn arm_consumed(ensure: fn(DeclId) -> void) {
        self.ensure_consumed.set(ensure)
    }

    /// Every named USE of `d`, of any kind, across the program —
    /// asking runs the references pass.
    fn refs_of(d: DeclId) -> List<Ref> {
        (self.ensure_refs.get())()
        Ref.by_decl(self.refs_db.get(), d)
    }

    /// Every CALL or METHOD CALL naming `d`.
    fn callers(d: DeclId) -> List<Ref> {
        [r for r in self.refs_of(d) if r.kind is .Call || r.kind is .MethodCall]
    }

    /// Every plain read of `d` — never a call, never a write.
    fn readers(d: DeclId) -> List<Ref> {
        [r for r in self.refs_of(d) if r.kind is .Read]
    }

    /// Every place that writes `d` — rare: only a decl a program can
    /// assign to at all answers here.
    fn writers(d: DeclId) -> List<Ref> {
        [r for r in self.refs_of(d) if r.kind is .Write]
    }

    /// Every use OTHER than the `use` line that named it — whether an
    /// import is read at all.
    fn used(d: DeclId) -> List<Ref> {
        [r for r in self.refs_of(d) if !(r.kind is .Import)]
    }

    /// Whether a held file left the relation INCOMPLETE — a decl
    /// `used(d)` calls unused may be read from inside one, so "no use
    /// anywhere" is not an answer a caller may give while this holds.
    fn refs_are_incomplete() -> bool {
        self.refs_incomplete.get()
    }

    fn mark_refs_incomplete(incomplete: bool) {
        self.refs_incomplete.set(incomplete)
    }

    /// One file's own rows, as `references.av`'s pass wrote them.
    fn refs_in_file(f: FileId) -> List<Ref> {
        (self.ensure_refs.get())()
        Ref.by_file(self.refs_db.get(), f)
    }

    /// `references.av`'s own write door: the whole relation, replacing
    /// whatever Db it held with a freshly filled one.
    fn settle_refs(db: RelDb) {
        self.refs_db.set(db)
    }

    /// The workspace arms the references hook once.
    fn arm_references(ensure: fn() -> void) {
        self.ensure_refs.set(ensure)
    }

    /// The workspace arms the failures hook once.
    fn arm_failures(ensure: fn() -> void) {
        self.ensure_failures.set(ensure)
    }

    fn record_target(impl_decl: DeclId, target: DeclId) {
        self.targets.set_at(impl_decl.index, target)
    }

    fn target_of(impl_decl: DeclId) -> DeclId? {
        (self.ensure_target.get())(impl_decl)
        let held: DeclId? = self.targets.get()[impl_decl.index]
        held
    }

    /// The BOUND each type parameter declares, by NAME — `""` for an unconstrained seat.
    /// One accessor for the four sites that read a bound, so the fact lives once.
    fn tbounds(d: DeclId) -> List<string> {
        let x = self.decl(d)
        if x.kind is .Builtin { return [] }
        // `Self` is bounded by the trait itself, so the BOUND'S NAME
        // is the trait's — `Self` is the parameter's name, and a
        // reader asking for a bound wants the trait to judge against.
        if x.kind is .Trait { return [x.name] }
        self.facts_of(d)?.bounds ?? []
    }

    /// The bound a seat declares, by name.
    fn bound_name(d: DeclId, j: int) -> string {
        let tb = self.tbounds(d)
        if j < 0 || j >= tb.length { return "" }
        tb[j]
    }

    fn is_trait(d: DeclId) -> bool { self.decl(d).kind is .Trait }

    fn is_enum(d: DeclId) -> bool { self.decl(d).kind is .Enum || self.decl(d).kind is .CollectEnum }

    fn is_named(d: DeclId) -> bool { self.decl(d).kind is .Named }

    fn is_const(d: DeclId) -> bool {
        match self.decl(d).kind {
            .Const -> true,
            .Fn or .Record or .Named or .Alias or .Enum or .CollectEnum or .Trait or .Syntax or .Method or .Default or .Impl or .Main or .Case or .Builtin or .Collect or .State -> false,
        }
    }

    fn is_alias(d: DeclId) -> bool { self.decl(d).kind is .Alias }

    /// The type an alias stands for — absent while it is still being read.
    fn alias_of(d: DeclId) -> TypeId? { self.sig(d)?.alias_sig() }

    /// The declaration a name stands for as a VALUE — itself, or, for
    /// an alias, the record, enum or named type it names. Absent for
    /// an alias of any other shape.
    fn named_by(d: DeclId) -> DeclId? {
        if !self.is_alias(d) { return d }
        let of? = self.alias_of(d) else { return null }
        match self.types.shape_of(of) { .Struct(t, _) or .Enum(t, _) -> t, _ -> null }
    }

    fn is_builtin(d: DeclId) -> bool { self.decl(d).kind is .Builtin }

    /// Whether a declaration is one a record literal is written of.
    fn is_record(d: DeclId) -> bool {
        match self.decl(d).kind {
            .Record -> true,
            .Fn or .Named or .Alias or .Enum or .Trait or .Syntax or .Method or .Default or .Impl or .Main or .Case or .Const or .Collect or .CollectEnum or .Builtin or .State -> false,
        }
    }

    /// The type a builtin declaration stands for: the shape its row
    /// builds over these arguments.
    fn built_type(d: DeclId, args: List<TypeId>) -> TypeId {
        let row? = type_row(self.rows, self.decl(d).name) else { return self.types.intern(Type.Error) }
        self.types.intern(row.builds(TypeArgs { parts: args }))
    }

    /// The language's own type declarations, minted once from the
    /// type rows. Enum rows also declare their variants; structural
    /// rows still need a value-level name for static vocabulary.
    fn admit_builtins() {
        for r in self.rows { self.admit_builtin(r) }
    }

    fn admit_builtin(r: TypeRow) {
        let id = self
            .mint(
                "builtin::${r.name}",
                FileId { index: 0 },
                no_stmt,
                r.name,
                DeclKind.Builtin,
                true,
                "",
                null,
                false,
                null,
            )
        self.builtins.push(id)
        self.declare_builtin(id, r)
    }

    /// A builtin's signature: its variants over its own Vars — the
    /// ordinal is the identity, `T1`, `T2`, … the wording.
    fn declare_builtin(d: DeclId, r: TypeRow) {
        let vars = TypeArgs {
            parts: [self.types.intern(Type.Var(d, j, n)) for j, n in builtin_tparams(r.arity)],
        }
        let sig: EnumSig? = r.variants(vars)
        if sig != null { self.declare(d, DeclSig.Enum(sig!)) }
    }

    fn builtin_decls() -> List<DeclId> { self.builtins.get() }

    /// The declaration a type's impls are filed under: its own, the
    /// language's for a scalar or a generic built-in, or — for a user
    /// GENERIC INSTANTIATION — its declaration, so one
    /// `impl Show for Box<T>` serves every `Box<...>`.
    fn implementor(ty: TypeId) -> DeclId? {
        declared_decl(self.types.shape_of(ty)) ?? self.builtin_generic_decl(ty) ?? self
            .scalar_decl(ty) ?? self.app_decl(ty)
    }

    /// The built-in declaration a generic built-in shape files under —
    /// `Result`, `List`, `Map`, `Cell`, `Task` — by the row's name.
    /// Absent for every other shape, so a scalar falls through to
    /// `scalar_decl`.
    fn builtin_generic_decl(ty: TypeId) -> DeclId? {
        let name = match self.types.shape_of(ty) {
            .List(_) -> "List",
            .Res(_, _) -> "Result",
            .Map(_, _) -> "Map",
            .Cell(_) -> "Cell",
            .Task(_) -> "Task",
            .Tasks -> "Tasks",
            .Int or .Float or .Bool or .Str or .Bytes or .Ptr or .Struct(_, _) or .Enum(_, _) or .App(_, _, _) or .Dyn(_, _) or .Fn(_, _, _) or .Void or .Opt(_) or .Null or .EmptyList or .EmptyMap or .TypeName(_, _) or .Var(_, _, _) or .Union(_) or .Error or .Range -> "",
        }
        if name == "" { return null }
        self.builtins.get().find((b) -> self.decl(b).name == name)
    }

    /// The user generic declaration an `.App` instantiation files
    /// under — absent for every other shape.
    fn app_decl(ty: TypeId) -> DeclId? {
        match self.types.shape_of(ty) { .App(d, _, _) -> d, _ -> null }
    }

    /// A scalar's builtin declaration: the one that builds it bare.
    fn scalar_decl(ty: TypeId) -> DeclId? {
        self.builtins.get().find((b) -> self.builds_bare(b, ty))
    }

    fn builds_bare(b: DeclId, ty: TypeId) -> bool {
        let row? = type_row(self.rows, self.decl(b).name) else { return false }
        row.arity == 0 && same_type(self.built_type(b, []), ty)
    }

    /// A builtin's row — the parts a store would hold for a
    /// statement; a declaration a program wrote has none.
    fn row_of(d: DeclId) -> TypeRow? {
        let x = self.decl(d)
        if !(x.kind is .Builtin) { return null }
        self.rows.find(it.name == x.name)
    }

    /// Whether a fn is the HOST's — declared `extern`, called by its
    /// bare symbol, never lowered.
    /// The format a declaration's record reads, when a `grammar`
    /// declared it — the one question that admits a type name as a
    /// CALL rather than a construction.
    fn grammar_of(d: DeclId) -> GrammarSpec? {
        let x = self.decl(d)
        if !(x.kind is .Record) { return null }
        // A GRAMMAR SPEC IS ITS OWN PARSE, and only a PARSED file can answer it: the hold
        // refuses a file that declares a grammar record (`grammar_free`), so the store is
        // always here when the answer is not null.
        if self.held.get().get(self.file(x.file).path) != null { return null }
        self.store(d).grammar_of(x.stmt)
    }

    fn is_extern(d: DeclId) -> bool { self.decl(d).kind is .Fn && self.facts_of(d)?.external ?? false }

    /// Whether a declaration is a HOST FN: an `extern fn` with a body,
    /// which defines the symbol its name spells.
    fn is_host_fn(d: DeclId) -> bool { self.is_extern(d) && self.facts_of(d)?.hosted ?? false }

    /// The host fns one file declares.
    fn host_fns_of_file(f: FileId) -> List<DeclId> { [d for d in self.decls_of_file(f) if self.is_host_fn(d)] }

    /// Every `extern fn`, in id order, off the externs' bucket.
    @bracket("decls")
    fn externs() -> List<Decl> {
        let rs = self.decl_row_rows.get()
        [x for x in rs.members(rs.bucket_of(external_index, bool_key(true))) if self.is_extern(x.id)]
    }

    /// THE ONE READING DOOR for a declaration's OWN `///` doc — a held
    /// file answers through the same fact `capture_facts` recorded at
    /// admit. A declaration's doc is its own `///` or nothing; a
    /// file's `//!` is `file_doc_of`'s, never this door's fallback — a
    /// caller that wants an undocumented declaration to read as its
    /// file's header composes both explicitly: `doc_of(d) ??
    /// file_doc_of(file)`. Never `store_of`: a held declaration has no
    /// store to force, and a declaration minted with no facts at all
    /// must still answer null rather than trap.
    fn doc_of(d: DeclId) -> List<string>? { self.facts_of(d)?.doc }

    /// A file's `//!` header when it has a real store, null for a held
    /// file (its record carries no file-level doc) or an out-of-range
    /// one (a declaration minted with no file behind it at all).
    fn file_doc_of(f: FileId) -> List<string>? { self.admitted_store(f)?.file_doc() }

    /// THE ONE READING DOOR for a declaration's `@name(args)` annotations, in
    /// written order — the fact `avra docs`, the formatter's `Code` and
    /// `@std/meta`'s crossing all read, so no reader parses a store of its own.
    fn annotations_of(d: DeclId) -> List<AnnotationFact> { self.facts_of(d)?.annotations ?? [] }

    /// An annotation's callee, resolved as `file`'s own namespace
    /// would read it — the door `compiler/expand.av`'s
    /// `declared_work` opens for a live node, asked here of a fact
    /// captured at admission, before any file's names were resolved.
    fn annotation_callee(a: AnnotationFact, file: FileId) -> DeclId? {
        (self.namespace_of.get())(file).fn_decl(a.name)
    }

    /// Whether an annotation resolves, in `file`'s own namespace, to
    /// `@std/meta`'s declaration of `word` — by DECLARATION, never
    /// by the bare word it happens to spell: a caller's own fn of
    /// the same name answers false. Call with `annotation_home(d)`,
    /// never `decl(d).file`: a generated declaration's annotation is
    /// the TEMPLATE's word, not the landing file's.
    fn is_meta_annotation(a: AnnotationFact, file: FileId, word: string) -> bool {
        let callee? = self.annotation_callee(a, file) else { return false }
        self.is_meta_fn(callee, word)
    }

    /// The file an annotation on `d` resolves in. A COPIED TEMPLATE'S
    /// SPANS ARE ITS ORIGIN FILE'S OFFSETS, and its WORDS are that
    /// file's too: `@plans_all` written inside `@std/relation`'s own
    /// `quote { … }` means what `@std/relation` imports, whichever
    /// user's file the generated accessor lands in — that file may
    /// never import `plans_all` at all. `d`'s own file is right only
    /// for a WRITTEN declaration, where there is no template to ask.
    fn annotation_home(d: DeclId) -> FileId {
        let prov? = self.template_provenance(d) else { return self.decl(d).file }
        let loc? = prov.template else { return self.decl(d).file }
        let path? = loc.file else { return self.decl(d).file }
        self.known_file_id(path) ?? self.decl(d).file
    }

    /// `d`'s own provenance, or its nearest ancestor's. `note_provenance`
    /// runs once per generation, at the declaration a generation
    /// MINTS AT — an impl block, a struct — never at each method or
    /// default it also mints; those carry no provenance of their own
    /// and answer their owner's (`Decl.parent`).
    fn template_provenance(d: DeclId) -> Provenance? {
        let own? = self.provenance_of(d) else {
            let parent? = self.decl(d).parent else { return null }
            return self.template_provenance(parent)
        }
        own
    }

    /// A type's name, read as a value — a receiver for `Type.name(…)`,
    /// never a constructible shape of its own. A trait's Self is not
    /// among its answers here: nothing pins it, so `decl_type_of`
    /// never reaches the generic-fn refusal for a trait's bare name.
    fn type_name(d: DeclId) -> string? {
        let x = self.decl(d)
        match x.kind {
            .Record or .Named or .Alias or .Enum or .Builtin or .Trait or .CollectEnum -> x.name,
            .Fn or .Syntax or .Method or .Default or .Impl or .Main or .Case or .Const or .Collect or .State -> null,
        }
    }

    /// A fn's name — free fns and methods; a named component
    /// instance (a `rule` among them) is a `Const`, read as its own
    /// built value, never called by symbol.
    fn fn_name(d: DeclId) -> string? {
        let x = self.decl(d)
        match x.kind {
            .Fn or .Method -> x.name,
            .Record or .Named or .Alias or .Enum or .Trait or .Syntax or .Default or .Impl or .Main or .Case or .Builtin or .Const or .Collect or .CollectEnum or .State -> null,
        }
    }

    /// Whether a declaration has a body to type and lower.
    fn has_body(d: DeclId) -> bool { self.decl(d).root != null }

    /// A declaration's members, in declaration order: a trait's or
    /// impl's methods, a record's defaults.
    fn children_of(d: DeclId) -> List<DeclId> { self.children.get()[d.index].get() }

    /// Every impl block naming a type by this name, in id order — an impl
    /// files under the name it targets, so a method table finds its impls
    /// before any target resolves.
    fn impls_named(name: string) -> List<DeclId> { [x.id for x in self.named_rows(name) if blocks_impl(x.kind)] }

    /// Every declaration of a name, in id order, off the name's bucket,
    /// unrecorded.
    @bracket("decls")
    fn named_rows(name: string) -> List<Decl> {
        let rs = self.decl_row_rows.get()
        rs.members(rs.bucket_of_text(name_index, name))
    }

    /// A record field's default, when the field declares one.
    fn default_named(record: DeclId, field: string) -> DeclId? {
        self
            .children_of(record)
            .find((c) -> self.decl(c).kind is .Default && self.decl(c).name == field)
    }

    /// THE TRAITS THAT MAY COMPOSE A COMPONENT OF FILE `f`: the nearest
    /// traits wearing `@std/meta`'s `@composes` among what the file can
    /// name. A component that holds statements is one of the one there
    /// is; none, or two, is the typing law's to refuse. Asking IS the
    /// query — the workspace walks what the file names.
    fn composers(f: FileId) -> List<DeclId> { (self.composers_of.get())(f) }

    /// THE trait that composes a component of file `f` — absent when
    /// none does, and when more than one would.
    fn composer(f: FileId) -> DeclId? {
        let all = self.composers(f)
        if all.length == 1 { all[0] } else { null }
    }

    /// Whether a declaration is a trait wearing `@composes`.
    fn composes(d: DeclId) -> bool { self.is_trait(d) && self.composes_mark(d) != null }

    /// A trait's `@composes(Carried)`, read in the trait's own file.
    fn composes_mark(tr: DeclId) -> AnnotationFact? {
        let file = self.annotation_home(tr)
        self
            .annotations_of(tr)
            .find((a) -> a.args.length == 1 && self.is_meta_annotation(a, file, "composes"))
    }

    /// The record every component composed by `tr` carries — the one its
    /// `@composes` names, as the trait's own file reads the name.
    fn carried_by(tr: DeclId) -> DeclId? {
        let mark? = self.composes_mark(tr) else { return null }
        (self.namespace_of.get())(self.annotation_home(tr)).type_decl(mark.args[0].text)
    }

    /// THE TRAIT AN IMPL IS FOR, read where its name was WRITTEN: a
    /// generated impl's in its template's file, a written one's in its
    /// own. None for an inherent impl, and for a name that binds no
    /// trait there.
    fn impl_trait(block: DeclId) -> DeclId? {
        let x = self.decl(block)
        let of = self.facts_of(block)?.of ?? ""
        if of.is_empty() { return null }
        let written = self.origin_of_stmt(x.file, x.stmt) ?? x.file
        let d? = (self.namespace_of.get())(written).type_decl(of) else { return null }
        if self.is_trait(d) { d } else { null }
    }

    /// What a record leaves out on purpose: its `@lacks(field, why)`s.
    fn lacking(record: DeclId) -> List<Lacked> {
        let file = self.annotation_home(record)
        [Lacked { field: a.args[0].text, why: a.args[1].text } for a in self.annotations_of(record) if self.lacks_mark(a, file)]
    }

    /// Whether a type carries `@std/meta`'s `@sealed`.
    fn is_sealed(d: DeclId) -> bool {
        let file = self.annotation_home(d)
        self
            .annotations_of(d)
            .any((a: AnnotationFact) -> self.is_meta_annotation(a, file, "sealed"))
    }

    fn lacks_mark(a: AnnotationFact, file: FileId) -> bool {
        a.args.length == 2 && self.is_meta_annotation(a, file, "lacks")
    }

    /// Each written seat's default body, in seat order — null where
    /// the seat has none.
    fn seat_defaults(d: DeclId) -> List<DeclId?> {
        [self.default_named(d, n) for n in self.facts_of(d)?.seats ?? []]
    }

    /// Whether a fn's body is lowered once for every caller: no type
    /// parameters of its own, nor of the type its impl serves.
    fn lowered_once(d: DeclId) -> bool {
        if !self.tparams(d).is_empty() { return false }
        let block? = self.decl(d).parent else { return true }
        // the DECLARATION first: a member's sig records its impl's target
        let _ = self.sig(d)
        let target? = self.target_of(block) else { return true }
        self.tparams(target).is_empty()
    }

    /// Where a declaration is — a generated one homed at the template
    /// that wrote it, or at the annotation that asked.
    fn loc(d: DeclId) -> Loc? {
        let x = self.decl(d)
        self
            .homed(
                x.file,
                self.spanned_stmt_of(x.file, x.stmt),
                self.generation_of_stmt(x.file, x.stmt),
                self.decl_span(d),
            )
    }

    /// A span of a file homed. A copied template node keeps the span
    /// it was written with, so its place is that span in its origin
    /// file; a generated node of this file's own text is at its span
    /// here; a node minted with no span is at the annotation that
    /// asked for it.
    fn homed(f: FileId, origin: FileId?, g: Generation?, sp: Span?) -> Loc? {
        if origin != null && sp != null { return loc_at(self.file(origin!).path, sp) }
        if g == null || sp != null { return loc_at(self.file(f).path, sp) }
        loc_at(self.file(f).path, g!.at)
    }

    /// THE symbol a declaration lowers to — its name under its
    /// module; a member's under its type's name first; a case's its
    /// file and its body's node, since a stored object outlives every
    /// id a run hands out. Every symbol a body or a call site carries
    /// comes from here.
    fn symbol(d: DeclId) -> string {
        let x = self.decl(d)
        if self.is_extern(d) { return x.name }
        let local_name = match x.kind {
            .Method -> "${x.owner}.${self.method_key(d)}",
            .Default -> "${x.owner}.${x.name}\$default",
            .Case -> "${stem_of(self.file(x.file).path)}\$case${x.root?.index ?? x.stmt.index}",
            .Fn or .Const or .Record or .Named or .Alias or .Enum or .Trait or .Syntax or .Impl or .Main or .Builtin or .Collect or .CollectEnum or .State -> x.name,
        }
        module_symbol(
            self.module_of(d),
            if self.apart_here(d) { "${stem_of(self.file(x.file).path)}/${local_name}" } else { local_name },
        )
    }

    /// Whether a declaration's symbol carries its file: it is kept
    /// apart in its module, or its owner is — so two files' own share
    /// no symbol.
    fn apart_here(d: DeclId) -> bool {
        let x = self.decl(d)
        if x.exported { return false }
        let apart = (self.apart_of.get())(x.file)
        if apart.is_empty() { return false }
        match x.kind {
            .Method or .Default -> apart.any((o) -> self.owns_member(o, x)),
            .Fn or .Const or .Record or .Named or .Alias or .Enum or .Trait or .Syntax or .Impl or .Main or .Case or .Builtin or .Collect or .CollectEnum or .State -> apart.any(same_decl(it, d)),
        }
    }

    /// Whether a type declaration is a member's owner in its own file.
    fn owns_member(owner: DeclId, member: Decl) -> bool {
        let o = self.decl(owner)
        o.name == member.owner &&
            same_file(o.file, member.file) &&
            table_of(o.kind) == NameKind.Type
    }

    /// THE symbol a LIFTED body lowers to. A lambda has no name of
    /// its own, so it takes its FILE's — module and stem — and the
    /// node that wrote it: program-unique, as every body's symbol
    /// must be (a node id is unique in its file alone).
    fn lifted_symbol(f: FileId, e: ExprId) -> string {
        let info = self.file(f)
        module_symbol(self.module_name(info.module_id), "${stem_of(info.path)}\$l${e.index}")
    }

    /// A literal's SITE: its file — module and stem — its own content,
    /// and its turn among the literals written alike in that file,
    /// folded. Content-addressed, so a line added above a literal moves
    /// nothing; two literals written alike are told apart by their turn.
    fn site_of(f: FileId, content: int, turn: int) -> int {
        let info = self.file(f)
        mix_final(
            fp_list(
                [
                    fp_str(self.module_name(info.module_id)),
                    fp_str(stem_of(info.path)),
                    content,
                    turn,
                ],
            ),
        )
    }

    // ── traits and methods ──

    /// A trait's method declarations, in declaration order.
    fn trait_fns(d: DeclId) -> List<DeclId> {
        // A TRAIT'S MEMBERS ARE ITS CHILDREN, minted with it as METHODS — the store's
        // `trait_parts` was a second listing of a relationship the table already holds.
        [m for m in self.children_of(d) if self.decl(m).kind is .Method]
    }

    /// A trait's method names — the vtable's order. A `static fn` has no
    /// receiver, so it rides NO lane: the dyn box's table holds a value's
    /// methods, and a lane for a static would hand the dispatcher a seat
    /// its method does not take (a shim unboxing a receiver that is not
    /// there). Static members stay in `trait_fns` for the checks that
    /// read every member; only the vtable skips them.
    fn trait_method_names(d: DeclId) -> List<string> {
        [self.decl(m).name for m in self.trait_fns(d) if !self.is_static_of(m)]
    }

    /// Every type in the program that implements `tr` — its records,
    /// enums, named types and builtins, each asked through the hook, so
    /// a held module answers from its interface.
    fn implementors_of(tr: DeclId) -> List<DeclId> {
        [x.id for x in self.all_decls() if implements_kind(x.kind) && self.implements(x.id, tr)]
    }

    /// Whether a type answers a generic trait at these arguments: a
    /// parameter by a bound naming the trait there, any other type by a
    /// member for each one the trait leaves to its impls.
    fn implements_at(recv: TypeId, g: DeclId, args: List<TypeId>) -> bool {
        match self.types.shape_of(recv) {
            .Var(d, j, _) -> self.bound_name(d, j) == self.decl(g).name && same_types(self.bound_args(d, j), args),
            _ -> self.implemented_at(recv, g, [recv].concat(args)),
        }
    }

    fn implemented_at(recv: TypeId, g: DeclId, at: List<TypeId>) -> bool {
        let d? = self.implementor(recv) else { return false }
        self.trait_fns(g).all((r) -> self.has_body(r) || self.answered_at(d, r, g, at))
    }

    /// Whether `d` has a method answering trait member `r` at `at`.
    fn answered_at(d: DeclId, r: DeclId, g: DeclId, at: List<TypeId>) -> bool {
        let want? = self.sig(r)?.fn_sig() else { return false }
        let seats = [self.types.substituted(p, g, at) for p in want.params]
        self.methods_named(d, self.decl(r).name).any((m) -> self.same_seats(m, seats))
    }

    /// Whether a method's seats past its receiver are exactly these.
    fn same_seats(m: DeclId, seats: List<TypeId>) -> bool {
        let sig? = self.sig(m)?.fn_sig() else { return false }
        let from = if self.is_static_of(m) { 0 } else { 1 }
        sig.params.length == seats.length &&
            same_types(sig.params.slice(from, seats.length), seats.slice(from, seats.length))
    }

    /// A type's runtime tag in a `dyn` box: its symbol's fingerprint —
    /// the same in every unit and every run, so a held object agrees.
    fn type_tag(d: DeclId) -> int { fp_str(self.symbol(d)) }

    /// A trait's associated `derive` member, or none — the ONE name
    /// the compiler runs for `@derive`.
    fn trait_derive(d: DeclId) -> DeclId? {
        self.trait_fns(d).find((m: DeclId) -> self.fn_name(m) == "derive")
    }

    /// A trait's associated `marks` member, or none — what its
    /// `derive` says it READS off the declaration's members. A derive
    /// that declares none claims none, and every mark written on a
    /// declaration it alone serves is then unread.
    fn trait_marks(d: DeclId) -> DeclId? {
        self.trait_fns(d).find((m: DeclId) -> self.fn_name(m) == "marks")
    }

    /// A type's method by name — asking IS the query: the hook fills
    /// the type's table from every impl that names it, and the ask
    /// records the dependency.
    fn method(target: DeclId, name: string) -> DeclId? {
        (self.ensure_methods.get())(target)
        self.held_method(target, name) ?? self.defaulted(target, name)
    }

    /// A method the type never wrote: the DEFAULT of a trait it
    /// implements, when that trait's member carries a body.
    fn defaulted(target: DeclId, name: string) -> DeclId? {
        for tr in self.impls.get()[target.index].get() {
            let m: DeclId? = self.default_member(tr, name)
            if m != null { return m }
        }
        null
    }

    /// A trait's member by name, when it is a default.
    fn default_member(tr: DeclId, name: string) -> DeclId? {
        for m in self.trait_fns(tr) {
            if self.decl(m).name == name && self.has_body(m) { return m }
        }
        null
    }

    /// The GENERIC trait member a type answers `name` through at several
    /// arguments — the contract every impl of it agrees to — or none.
    fn shared_member(target: DeclId, name: string) -> DeclId? {
        if self.methods_named(target, name).length < 2 { return null }
        for tr in self.impls.get()[target.index].get() {
            if self.tparams(tr).length > 1 {
                let m: DeclId? = self.trait_member(tr, name)
                if m != null { return m }
            }
        }
        null
    }

    /// Every registered method of one name — several only where a
    /// generic trait is implemented at several arguments.
    fn methods_named(target: DeclId, name: string) -> List<DeclId> {
        (self.ensure_methods.get())(target)
        [m for m in self.methods_of(target) if self.decl(m).name == name]
    }

    /// The table as it stands — the registering side's own read.
    @bracket("methods")
    fn held_method(target: DeclId, name: string) -> DeclId? {
        for m in self.registered_methods(target) {
            if self.decl(m).name == name { return m }
        }
        null
    }

    /// A type's registered methods, RECORDED: the door for a reader
    /// that is not making the table, which records the type's
    /// `Methods` cell in the open query so it depends on the impls it
    /// dispatches through, then reads through the table's own raw
    /// cell.
    @bracket("methods")
    fn methods_of(target: DeclId) -> List<DeclId> {
        if audit_build && self.auditing.get() { self.audited(Bypassed.Methods(target)) }
        self.record_kernel.record_at(self.record_methods.get(), target.index)
        self.registered_methods(target)
    }

    /// A read inside `Methods`'s own bracket, or while that bracket cannot open (an impl
    /// still registering, an impl's file resolving): the table as it stands, and it
    /// records nothing. The table's computation waits on the reader, so an edge to it
    /// would be a cycle.
    @bracket("methods")
    fn registered_methods(target: DeclId) -> List<DeclId> { self.methods.get()[target.index].get() }

    /// Every method a type declares, its table filled first: a CONSUMER read, and
    /// `methods_of` is where it records.
    fn declared_methods(target: DeclId) -> List<DeclId> {
        (self.ensure_methods.get())(target)
        self.methods_of(target)
    }

    /// The workspace arms the method-table hook once.
    fn arm_methods(ensure: fn(DeclId) -> void) {
        self.ensure_methods.set(ensure)
    }

    /// A method registered under its type — the same declaration
    /// again (a recomputed sig) is the same entry.
    @bracket("methods")
    fn declare_method(target: DeclId, m: DeclId) {
        let prior: DeclId? = self.held_method(target, self.decl(m).name)
        if prior != null && same_decl(prior!, m) { return }
        self.methods.get()[target.index].push(m)
    }

    fn record_impl(ty: DeclId, tr: DeclId) {
        if self.holds_impl(ty, tr) { return }
        self.impls.get()[ty.index].push(tr)
    }

    /// Whether a type implements a trait — asked through the hook,
    /// like a method.
    fn implements(ty: DeclId, tr: DeclId) -> bool {
        (self.ensure_methods.get())(ty)
        self.holds_impl(ty, tr)
    }

    fn holds_impl(ty: DeclId, tr: DeclId) -> bool {
        self.impls.get()[ty.index].get().any(same_decl(it, tr))
    }
}

/// A key seen already in this admit is a repeated declaration: the
/// repeat is keyed by its statement, so it stays a declaration of
/// its own for the namespace law to refuse.
fn fresh_key(key: string, s: StmtId, seen: List<string>) -> string {
    if seen.contains(key) { return "${key}#${s.index}" }
    key
}

/// A range whose first expression never landed starts at zero.
fn started_at(i: int) -> int {
    if i < 0 { 0 } else { i }
}

/// The name a trait gives its implementor — the one type parameter
/// every trait declares.
export const self_word: string = "Self"

/// A member's body, when it wrote one — a sig's is a HOLE no pass
/// walks, and declares nothing to type.
fn declared_body(store: SyntaxArena, m: StmtId) -> ExprId? {
    let body: ExprId? = store.fn_parts(m)?.body
    if body == null || store.expr(body!) is .Error { return null }
    body
}

/// Two voices identical in every part a reader can see. The place is
/// compared by FILE AND SPAN rather than by identity, because a
/// template's refusal carries the template's own place and two walks
/// of it mint two `Loc` values saying the same thing.
fn same_voice(a: Diag, b: Diag) -> bool {
    a.kind == b.kind &&
        a.message == b.message &&
        a.help ?? "" == b.help ?? "" &&
        a.primary.label ?? "" == b.primary.label ?? "" &&
        same_place(a.primary.loc, b.primary.loc)
}

fn same_place(a: Loc?, b: Loc?) -> bool {
    if a == null || b == null { return a == null && b == null }
    placed(a!, b!)
}

fn placed(a: Loc, b: Loc) -> bool { a.file == b.file && a.lo == b.lo && a.hi == b.hi }

/// An enum's signature, or absence for every other declaration.
/// A value enum's tag must name a bit of its counted mask.
const max_valued_variants: int = 62

/// Each variant's word as a bit, set for a counted one: bit `t` for tag `t`.
fn counted_bits(words: List<int>) -> int {
    mut mask = 0
    mut bit = 1
    for w in words {
        if w == 1 { mask = mask + bit }
        bit = bit * 2
    }
    mask
}

fn nothing_asked() {}

fn enum_parts(sig: DeclSig) -> EnumSig? {
    match sig { .Enum(e) -> e, _ -> null }
}

/// Whether a declaration of this kind may implement a trait.
fn implements_kind(k: DeclKind) -> bool {
    match k {
        .Record or .Enum or .CollectEnum or .Named or .Builtin -> true,
        .Fn or .Alias or .Trait or .Syntax or .Method or .Default or .Impl or .Main or .Case or .Const or .Collect or .State -> false,
    }
}

/// Two type lists naming the same types, place by place.
fn same_types(a: List<TypeId>, b: List<TypeId>) -> bool {
    a.length == b.length && [j for j, t in a if !same_type(t, b[j])].is_empty()
}

/// Whether a declaration of this kind is an impl block.
fn blocks_impl(k: DeclKind) -> bool {
    match k {
        .Impl -> true,
        .Fn or .Record or .Named or .Alias or .Enum or .Trait or .Syntax or .Method or .Default or .Main or .Case or .Const or .Collect or .CollectEnum or .Builtin or .State -> false,
    }
}

// ── voices ──

fn gone_decl(d: DeclId) {
    wreck(
        "declaration ${d.index} was read after its file was admitted again without it — a DeclId lives only as long as the admission that mints it",
    )
}
