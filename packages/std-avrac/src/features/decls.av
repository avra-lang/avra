//! THE DECLARATION TABLE — every declaration of the program, ONCE:
//! its file, its statement, its name and kind; its signature once
//! typing declares it; its methods and the traits it implements.
//! Ids are INTERNED by key (file, kind, name — a method under its
//! owner), so an id is dense, stable across edits, and the same when
//! an edited file is admitted again; a name declared twice in one
//! file is two declarations, the second keyed by its statement, so
//! the namespace law can refuse it. Per-file facts live once, by
//! FileId: the path, the module, the store, and which of its
//! statements declare. The workspace mints; every pass reads.
use core.{SideTable, side_table, DeclId, FileId, ModuleId, DeclKind, CollectScope, StmtId, ExprId, PatId, Span, NodeStore, TypeRegistry, new_type_registry, Param, module_symbol, filled, flatten, some_list, same_decl, same_file, SpecParts, ImplParts, TypeId, no_stmt, Type, package_of_module, TypeRef, named_ref, Stmt, Expr, Scoped, GrammarSpec, Annotation}
use core.{SeatMark, mark_at, plain_mark, ArenaRuns}
use core.{Fingerprint, fp, list_cell, map_cell, same_type}
use @std.path.{stem_of}
use diagnostics.{loc_at, Diag}
use @std.errors.{Loc}
use features.{TypeRow, TypeArgs, Unsettled, Lifted, Settled, MetaHeap, MetaVal, StructSig, EnumSig, generated_key, Decl, Origin, Origins, no_origins}
use @std.meta.{Diagnostic, derive}

/// A file's path facts — known at first mention, before its parse.
export type FileInfo = { id: FileId, path: string, module_id: ModuleId }

/// One declaration: where it lives, what it is, the expression its
/// body IS (a fn's, a default's; absent for the rest), and the
/// expression range [lo, hi) that body occupies in its file's arena
/// — a method or a default also names the type it serves.
export type Decl = { id: DeclId, file: FileId, stmt: StmtId, name: string, kind: DeclKind, exported: bool, owner: string, parent: DeclId?, nested: bool, root: ExprId?, lo: int, hi: int }

/// A range-owning declaration and the source span it holds.
type OwnerSpan = { d: DeclId, lo: int, hi: int }

/// One `collect` INDEX row: a declaration under the word it answers.
type IndexedWord = { word: string, id: DeclId }

/// THE COLLECT INDEX's own state: every word's rows so far, and how
/// far into `decls` it has read — `through` is the index's OWN
/// cursor, never `decls.get().length` read twice at different times.
type CollectIndex = { by_word: Map<string, List<DeclId>>, through: int }

fn no_collect_index() -> CollectIndex {
    let empty: Map<string, List<DeclId>> = {}
    CollectIndex { by_word: empty, through: 0 }
}

/// `decls`, `sigs`, `children`, `methods` and `impls` are dense by
/// DeclId; `stores` and `decl_ids` dense by FileId. The two hooks
/// make the table's reads queries: `ensure` computes a sig on first
/// ask, `ensure_methods` fills a type's method table.
/// EVERY FACT A PASS READS OFF A DECLARATION'S PARSE — captured ONCE, when the file is
/// admitted, and kept beside the declaration. A pass that reads `store(d)` instead reads
/// a file a HELD build never parsed; this is the ONE place that knowledge lives, so a held
/// file is loaded by filling these rows and NOTHING reaches into a store after admission.
/// `@name(args)` recorded as a declaration's own fact: its callee's name, each
/// argument's literal text (a string/int/bool/identifier — anything else reads ""),
/// and where it was written.
@derive(Fingerprint)
export type AnnotationFact = { name: string, args: List<string>, span: Span? }

/// An argument's literal text, when it has one — a computed expression answers "".
fn arg_text(store: NodeStore, e: ExprId) -> string {
    let expr = store.expr(e)
    let t? = expr.text_of() else { return int_text(expr) ?? bool_text(expr) ?? store.ident_name(e) ?? "" }
    t
}

fn int_text(e: Expr) -> string? {
    let n? = e.int_of() else { return null }
    "${n}"
}

fn bool_text(e: Expr) -> string? {
    let b? = e.bool_of() else { return null }
    "${b}"
}

/// A parsed `Annotation` as the fact a declaration keeps: its callee's args
/// re-read as literal text, since the fact outlives the store a held file has none of.
fn annotation_fact(store: NodeStore, a: Annotation) -> AnnotationFact {
    AnnotationFact { name: a.name, args: [arg_text(store, e) for e in a.args], span: a.span }
}

/// THE FINGERPRINT IS THE CODEC'S CHECKSUM: the derived fold covers EVERY field, so the
/// record carries it and the decoder recomputes it — a field added and not encoded makes
/// the two disagree and the module refuses to hold, instead of silently decoding a default.
@derive(Fingerprint)
export type DeclFacts = {
    external: bool,
    stat: bool,
    is_grammar: bool,
    /// A RECORD A BLOCK INSTANTIATES — a component. The importing file's
    /// lexer must know the word before anything parses, so a held
    /// provider says it here rather than in a parse the hold skips.
    is_component: bool,
    span: Span?,
    tparams: List<string>,
    bounds: List<string>,
    seats: List<string>,
    /// AN EXTERN'S RAW SEAT WIDTHS — the annotation each seat wrote, the answer last.
    /// A width is a property of a SEAT and lives in the parse alone, so a held extern
    /// must carry it or its runtime row cannot be built without a store.
    host: List<string>,
    /// WHETHER THE DECLARATION CARRIES ANNOTATIONS. A use-site warning is computed from
    /// them, and that computation reads the declaration's PARSE — so a held decl must say
    /// whether it has any, or asking its marks parses a file the hold exists to skip.
    annotated: bool,
    /// THE TRAIT AN `impl … for` BLOCK ANSWERS, empty otherwise. The name lives in the
    /// parse alone, and a held block that cannot say it implements nothing: a `dyn` box
    /// over its type is refused in a file that merely parsed beside it.
    of: string,
    /// A `const` THAT IS A DECLARED INSTANCE — built once per run by its own unit, owned
    /// by its file's object. A reader in another file must know it without a parse the
    /// hold skips.
    instance: bool = false,
    /// THE DECLARATION'S OWN `///` LINES, absent where it wrote none — a fact every
    /// tool (`avra docs`, the formatter, `@std/meta`'s crossing) reads the same
    /// way, so a held file answers it without the parse the hold exists to skip.
    doc: List<string>? = null,
    /// EVERY `@name(args)` THE DECLARATION WEARS, in written order — the general
    /// table `annotated` above only flags the presence of.
    annotations: List<AnnotationFact> = [],
}

/// An extern's raw seat widths: one name per parameter, then the answer's.
fn extern_host(store: NodeStore, s: StmtId) -> List<string> {
    let ext? = store.extern_parts(s) else { return [] }
    let seats = [p.ty?.name ?? "" for p in ext.params]
    seats.concat([ext.ret.name])
}

/// The source a declaration occupies: a default's or a case's root, else
/// its statement — and none for a hoisted one, whose nodes lie inside
/// the statement that minted it.
fn occupied(store: NodeStore, x: Decl) -> Span? {
    if store.is_hoisted(x.stmt) { return null }
    if !(x.kind is .Default || x.kind is .Case) { return store.stmt_span(x.stmt) }
    let root? = x.root else { return null }
    store.expr_span(root)
}

/// THE ONE CAPTURE — a parsed declaration's facts, read from its store exactly once.
// LICENSED style.free_state_verb: a pure PROJECTION — a store and a declaration in, its facts out.
fn capture_facts(store: NodeStore, x: Decl) -> DeclFacts {
    // A GENERATED declaration's statement lives in an expanded range the written part
    // tables do not cover — `statics`, `grammars`, the parts tables trap past their end.
    // Absence there is "declares nothing", not a defect.
    let readable = x.stmt.index < store.stmts.count()
    DeclFacts {
        external: readable && x.kind is .Fn && store.extern_parts(x.stmt) != null,
        stat: store.is_static(x.stmt),
        is_grammar: readable && x.kind is .Record && store.grammar_of(x.stmt) != null,
        is_component: readable && x.kind is .Record && store.component_parts(x.stmt) != null,
        span: occupied(store, x),
        tparams: if readable { store.decl_tparams(x.stmt) } else { [] },
        bounds: if readable { [p.ty?.name ?? "" for p in store.decl_tbounds(x.stmt)] } else { [] },
        seats: if readable && !(x.kind is .Default) { [p.name.of for p in store.fn_parts(x.stmt)?.params ?? []] } else { [] },
        host: if readable { extern_host(store, x.stmt) } else { [] },
        annotated: readable && !store.annotations_of(x.stmt).is_empty(),
        of: if readable && x.kind is .Impl { store.impl_parts(x.stmt)?.of ?? "" } else { "" },
        instance: readable && x.kind is .Const && store.is_component_inst(x.stmt),
        doc: if readable { store.doc_comment(x.stmt) } else { null },
        annotations: if readable { [annotation_fact(store, a) for a in store.annotations_of(x.stmt)] } else { [] },
    }
}

/// The facts a declaration minted with no store wears: a synthetic or builtin body has no
/// receiver and declares nothing about the source.
fn no_facts() -> DeclFacts { DeclFacts { external: false, stat: true, is_grammar: false, is_component: false, span: null, tparams: [], bounds: [], seats: [], host: [], annotated: false, of: "" } }

export type Decls = {
    types: TypeRegistry,
    /// OUTER-TABLE GROWTH, SHARED: `mint`/`file_id`/`module_id` run
    /// behind captured hooks (`built()`'s registrations), so the
    /// table itself — not only a per-slot Cell inside it — must be a
    /// shared referent, or the append lands in a copy and is lost.
    files: Cell<List<FileInfo>>,
    paths: Cell<Map<string, FileId>>,
    modules: Cell<List<string>>,
    module_ids: Cell<Map<string, ModuleId>>,
    /// TWO LAYERS SHARED: the per-module slot (see `children`) AND the
    /// outer table itself (see `files` above) — appending a MODULE's
    /// slot is outer-table growth exactly as appending a FILE's row is.
    module_files: Cell<List<Cell<List<FileId>>>>,
    mains: Cell<List<DeclId?>>,
    stores: Cell<List<NodeStore?>>,
    ensure_store: Cell<fn(FileId) -> void>,
    /// A HELD FILE'S DECLARATIONS ARE MINTED WHEN ASKED FOR: the hook the
    /// workspace arms, called before a file's declarations are read.
    ensure_file: Cell<fn(FileId) -> void>,
    /// TWO LAYERS SHARED — see `module_files`.
    decl_ids: Cell<List<Cell<SideTable<DeclId?>>>>,
    /// TWO LAYERS SHARED — see `module_files`.
    file_decls: Cell<List<Cell<List<DeclId>>>>,
    decls: Cell<List<Decl>>,
    /// THE COLLECT INDEX — see `indexed`/`collect_word`.
    collect_index: Cell<CollectIndex>,
    /// THE FILES ANSWERED FROM A RECORD — never parsed, so their declarations were
    /// MINTED and their objects come from the store. Keyed by path.
    held: Cell<Map<string, bool>>,
    held_items: Cell<Map<string, List<DeclId>>>,
    /// Lazy expression-range reconstruction is once per held file, even
    /// when dozens of specializations ask for bodies from that file.
    /// THE DECLARATION'S PARSE FACTS, captured at admit and loaded for a held file — the
    /// ONE place a pass reads them, so no pass reaches into a store after admission.
    faces: Cell<List<DeclFacts?>>,
    /// Settlements restored for declarations whose files were never parsed.
    held_values: Cell<Map<string, Settled>>,
    keys: Cell<Map<string, DeclId>>,
    sigs: Cell<List<DeclSig?>>,

    // a GENERATED declaration's origin — null for every written one
    provenance: Cell<List<Provenance?>>,
    // a file's admitted GENERATIONS, in order — the arena ranges each
    // took and the annotation that asked; dense by FileId
    generations: Cell<List<List<Generation>>>,
    // a generated node's ORIGIN — the file whose template wrote it;
    // `Here` for a written node and for one whose name came through a
    // hole; dense by FileId, then by arena index
    origins: Cell<List<Origins>>,
    // what a file's expansions REFUSED — generated source that did not
    // parse, spoken at the template that wrote it; dense by FileId
    /// TWO LAYERS SHARED — see `module_files`.
    expansion_voices: Cell<List<Cell<List<Diag>>>>,
    // `@std/meta`'s declarations by name, found once each
    meta_ids: Cell<Map<string, DeclId>>,
    // a declaration's WARNINGS: the words it keeps for its users,
    // computed on first ask through `ensure_marks` (null = unasked)
    marks: Cell<List<List<Diagnostic>?>>,
    ensure_marks: Cell<fn(DeclId) -> void>,
    // the ROOT package's manifest name — its modules carry no package
    // prefix, and a kind spoken there still wears the package
    root_name: Cell<string>,
    const_types: Cell<Map<string, TypeId>>,
    /// TWO LAYERS SHARED: members are appended through every copy of the
    /// per-parent slot, so an append cannot copy it (a plain
    /// `List<List<DeclId>>` cloned the whole table per child) — AND the
    /// outer table (one slot per DeclId) is a Cell too, or a NEW
    /// declaration's own slot never reaches a captured hook.
    children: Cell<List<Cell<List<DeclId>>>>,
    /// TWO LAYERS SHARED — see `children`.
    methods: Cell<List<Cell<List<DeclId>>>>,
    /// TWO LAYERS SHARED — see `children`.
    impls: Cell<List<Cell<List<DeclId>>>>,
    // every impl block under the NAME it targets — filled at mint,
    // before any target resolves, so a method table finds its impls
    // without walking every declaration in the workspace
    // OUTER-TABLE GROWTH, SHARED — see `files` above: `note_impl` runs
    // inside `mint`, behind the same captured hooks.
    impls_by_name: Cell<Map<string, List<DeclId>>>,
    ensure: Cell<fn(DeclId) -> void>,
    // the workspace's const-type hook: types the const, and answers
    // whether this ask closed a cycle
    ensure_const: Cell<fn(FileId, StmtId) -> bool>,
    // whether THIS compilation is a program (has an entry) or a
    // library — the closure-fold law's door (features/consts/check.av)
    ensure_entry: Cell<fn() -> bool>,
    // the workspace's lifting hook: an annotation fn run over a
    // declaration at compile time, what it said back
    lifter: Cell<fn(DeclId, FileId, StmtId, ExprId, List<ExprId>) -> Result<Lifted, Unsettled>>,
    ensure_methods: Cell<fn(DeclId) -> void>,
    // the language's own type declarations, one per row that is an
    // enum — and the rows they read their parts from
    builtins: Cell<List<DeclId>>,
    rows: List<TypeRow>,
    // an impl block's target type, once typing found it — dense by
    // DeclId; a method's instantiation is its target's
    targets: Cell<List<DeclId?>>,
    // THE INOUT SEATS, dense by DeclId: each seat's CONTRACT a fn
    // declared (`mut`, `const`), whether a method DECLARED `mut fn`,
    // and whether the receivers pass found it WRITING through `self`
    // — asked through the armed hook
    seat_marks: Cell<List<List<SeatMark>>>,
    declared_writes: Cell<List<bool>>,
    /// TWO LAYERS SHARED — see `children`.
    written_seats: Cell<List<Cell<List<bool>>>>,
    ensure_writes: Cell<fn(DeclId) -> void>,
}

/// Where no workspace stands behind the table, nothing lifts.
// LICENSED style.dead_parameter: a fn VALUE filling the lifter seat — its parameters are the seat's contract, and the answer needs none of them
fn no_lifter(d: DeclId, f: FileId, s: StmtId, call: ExprId, args: List<ExprId>) -> Result<Lifted, Unsettled> {
    .Err(Unsettled.Trap("nothing here lifts an annotation"))
}

// LICENSED style.dead_parameter: the hook's contract carries the declaration
fn no_marks(d: DeclId) {}

// LICENSED style.dead_parameter: the hook's contract carries the declaration
fn no_store(f: FileId) {}

// LICENSED style.dead_parameter: a fn VALUE filling the const-ensure seat — its parameters are the seat's contract, and the no-op needs none of them
fn no_const_ensure(f: FileId, s: StmtId) -> bool { false }

// LICENSED style.dead_parameter: a fn VALUE filling the entry-ensure seat — no program is known before the workspace arms it
fn no_entry_ensure() -> bool { false }

/// A const's type as the program answers it — or why it has none:
/// the const REFUSED (spoken at its own value), or its value asks
/// for its own type, which only the asking read can speak.
export enum ConstType {
    Known(TypeId)
    Refused
    Cyclic
}

fn const_type_key(f: FileId, s: StmtId) -> string { "${f.index}/${s.index}" }

export fn new_decls() -> Decls {
    let no_files: List<FileInfo> = []
    let no_paths: Map<string, FileId> = {}
    let no_modules: List<string> = []
    let no_module_ids: Map<string, ModuleId> = {}
    let no_mains: List<DeclId?> = []
    let no_stores: List<NodeStore?> = []
    let no_generations: List<List<Generation>> = []
    let no_origins: List<Origins> = []
    let no_decls: List<Decl> = []
    let no_faces: List<DeclFacts?> = []
    let no_keys: Map<string, DeclId> = {}
    let no_sigs: List<DeclSig?> = []
    let no_provenance: List<Provenance?> = []
    let empty_marks: List<List<Diagnostic>?> = []
    let no_targets: List<DeclId?> = []
    let no_seat_marks: List<List<SeatMark>> = []
    let no_declared_writes: List<bool> = []
    let no_module_files: List<Cell<List<FileId>>> = []
    let no_decl_ids: List<Cell<SideTable<DeclId?>>> = []
    let no_file_decls: List<Cell<List<DeclId>>> = []
    let no_expansion_voices: List<Cell<List<Diag>>> = []
    let no_children: List<Cell<List<DeclId>>> = []
    let no_methods: List<Cell<List<DeclId>>> = []
    let no_impls: List<Cell<List<DeclId>>> = []
    let no_written_seats: List<Cell<List<bool>>> = []
    let no_impls_by_name: Map<string, List<DeclId>> = {}
    Decls {
        types: new_type_registry(),
        files: Cell.new(no_files),
        paths: Cell.new(no_paths),
        modules: Cell.new(no_modules),
        module_ids: Cell.new(no_module_ids),
        module_files: Cell.new(no_module_files),
        mains: Cell.new(no_mains),
        // LICENSED style.repeated_projection: each `Cell.new` mints its own cell — one binding would make two hooks one slot
        stores: Cell.new(no_stores),
        ensure_store: Cell.new(no_store),
        ensure_file: Cell.new(no_store),
        decl_ids: Cell.new(no_decl_ids),
        file_decls: Cell.new(no_file_decls),
        generations: Cell.new(no_generations),
        origins: Cell.new(no_origins),
        expansion_voices: Cell.new(no_expansion_voices),
        meta_ids: map_cell(),
        decls: Cell.new(no_decls),
        collect_index: Cell.new(no_collect_index()),
        held: map_cell(),
        held_items: map_cell(),
        faces: Cell.new(no_faces),
        held_values: map_cell(),
        keys: Cell.new(no_keys),
        sigs: Cell.new(no_sigs),
        provenance: Cell.new(no_provenance),
        marks: Cell.new(empty_marks),
        ensure_marks: Cell.new(no_marks),
        root_name: Cell.new(""),
        const_types: map_cell(),
        children: Cell.new(no_children),
        methods: Cell.new(no_methods),
        impls: Cell.new(no_impls),
        impls_by_name: Cell.new(no_impls_by_name),
        ensure: Cell.new(no_ensure),
        ensure_const: Cell.new(no_const_ensure),
        ensure_entry: Cell.new(no_entry_ensure),
        ensure_methods: Cell.new(no_ensure),
        builtins: list_cell(),
        rows: [],
        targets: Cell.new(no_targets),
        seat_marks: Cell.new(no_seat_marks),
        declared_writes: Cell.new(no_declared_writes),
        written_seats: Cell.new(no_written_seats),
        ensure_writes: Cell.new(no_ensure),
        lifter: Cell.new(no_lifter),
    }
}

/// A row's type parameters — `T1`, `T2`, … by arity; the ordinal
/// is the identity, the name only the wording.
fn builtin_tparams(arity: int) -> List<string> {
    mut out: List<string> = []
    mut j = 0
    while j < arity {
        out.push("T${j + 1}")
        j = j + 1
    }
    out
}

/// The table's own reads ask nothing more.
// LICENSED style.dead_parameter: the hook's contract carries the declaration
fn no_ensure(d: DeclId) {}

/// A kind's word — the key's middle, and prose.
export fn kind_word(k: DeclKind) -> string {
    match k {
        .Fn -> "fn",
        .Record or .Named or .Alias -> "type",
        .Enum -> "enum",
        .Trait -> "trait",
        .Syntax -> "syntax",
        .Method -> "method",
        .Default -> "default",
        .Impl -> "impl",
        .Main -> "main",
        .Case -> "case",
        .Const -> "const",
        .Collect -> "collect",
        .Builtin -> "builtin",
    }
}

impl Decls {
    // ── files ──

    /// A path's identity — minted at first mention.
    fn decl(d: DeclId) -> Decl { self.decls.get()[d.index] }

    /// A generated declaration's origin, or null for a written one.
    fn provenance_of(d: DeclId) -> Provenance? { self.provenance.get()[d.index] }

    /// Record a generated declaration's origin: who asked, what it
    /// wraps or names, and where.
    fn note_provenance(d: DeclId, ann: string, original: string, at: Span?) {
        self.provenance.set_at(d.index, Provenance { ann: ann, original: original, at: at })
    }

    /// The template a generated declaration was copied from — the
    /// quote's file and offset — beside who asked.
    fn note_template(d: DeclId, template: Loc?) {
        let held? = self.provenance.get()[d.index] else { return }
        self.provenance.set_at(d.index, held with { template: template })
    }

    /// One more generation admitted to a file.
    fn note_generation(f: FileId, g: Generation) {
        self.generations.set_at(f.index, self.generations.get()[f.index].concat([g]))
    }

    /// Nodes copied from a template: each wears the file that wrote it.
    /// The tables are `Cell`s, so a grow and a write both land in place —
    /// this runs once per copied node, and each call used to copy the
    /// whole table.
    /// Every node of these runs was written in `origin`.
    fn note_runs(f: FileId, runs: ArenaRuns, origin: FileId) {
        self.note_origins(f, [ExprId { index: i } for i in runs.exprs.lo..runs.exprs.hi], [StmtId { index: i } for i in runs.stmts.lo..runs.stmts.hi], [PatId { index: i } for i in runs.pats.lo..runs.pats.hi], origin)
    }

    fn note_origins(f: FileId, exprs: List<ExprId>, stmts: List<StmtId>, pats: List<PatId>, origin: FileId) {
        let known = self.origins.get()[f.index]
        let wrote = Origin.Written(origin)
        for e in exprs {
            while known.exprs.get().length <= e.index { known.exprs.push(Origin.Here) }
            known.exprs.set_at(e.index, wrote)
        }
        for s in stmts {
            while known.stmts.get().length <= s.index { known.stmts.push(Origin.Here) }
            known.stmts.set_at(s.index, wrote)
        }
        for p in pats {
            while known.pats.get().length <= p.index { known.pats.push(Origin.Here) }
            known.pats.set_at(p.index, wrote)
        }
    }

    /// The file a generated node was WRITTEN in, when it is another
    /// than the node's own.
    fn origin_of_expr(f: FileId, e: ExprId) -> FileId? { self.origins.get()[f.index].at(self.origins.get()[f.index].exprs.get(), e.index) }
    fn origin_of_stmt(f: FileId, s: StmtId) -> FileId? { self.origins.get()[f.index].at(self.origins.get()[f.index].stmts.get(), s.index) }
    fn origin_of_pat(f: FileId, p: PatId) -> FileId? { self.origins.get()[f.index].at(self.origins.get()[f.index].pats.get(), p.index) }

    /// What a file's expansion refused, kept for its resolve to speak.
    /// IDEMPOTENT, BECAUSE THE EXPANSION RUNS TWICE BY DESIGN.
    /// `expanded` is demanded from INSIDE a resolve's miss, and the
    /// memo kernel turns that cycle into a COMPUTE, not a reuse
    /// (`start_recursive`: `.Cycle -> Compute`) — so every directive
    /// of a file is materialized by the re-entrant run and again by
    /// the outer one. The DECLARATIONS already survive that: minting
    /// is keyed by the generated fingerprint, so a second walk mints
    /// nothing new. The voices had no key — a list that is appended to
    /// — so the same refusal was spoken once per walk. This gives them
    /// the idempotence the declarations have had all along; it is not
    /// a filter over noise, and removing it doubles every refusal the
    /// splice can raise.
    fn speak_expansion(f: FileId, ds: List<Diag>) {
        for d in ds {
            if !self.expansion_voices.get()[f.index].get().any(same_voice(it, d)) { self.expansion_voices.get()[f.index].push(d) }
        }
    }

    /// A file's expansion begins with nothing refused.
    fn hush_expansion(f: FileId) {
        let no_voices: List<Diag> = []
        self.expansion_voices.set_at(f.index, Cell.new(no_voices))
    }

    /// The generation a file's node came from — null for a written one.
    fn generation_of(f: FileId, e: ExprId) -> Generation? {
        self.generations.get()[f.index].find(it.runs.exprs.holds(e.index))
    }

    fn generation_of_stmt(f: FileId, s: StmtId) -> Generation? {
        self.generations.get()[f.index].find(it.runs.stmts.holds(s.index))
    }

    fn generation_of_pat(f: FileId, p: PatId) -> Generation? {
        self.generations.get()[f.index].find(it.runs.pats.holds(p.index))
    }

    /// The declaration a statement of a file makes, when it does.
    fn decl_of(f: FileId, s: StmtId) -> DeclId? { self.decl_ids.get()[f.index].get().get(s.index) }

    fn store(d: DeclId) -> NodeStore { self.store_of(self.decl(d).file) }

    fn module_of(d: DeclId) -> string { self.module_name(self.file(self.decl(d).file).module_id) }
    /// A declaration's package — its module's, by `package_named`.
    fn package_of(d: DeclId) -> string { self.package_named(self.module_of(d)) }

    /// A module's package in the DOTTED spelling every package read
    /// compares (`@std.meta`): the prefix a dependency's module carries,
    /// or the root's manifest name for a root module, which none
    /// prefixes — "" for a lone file, which has no package.
    fn package_named(module: string) -> string {
        let named = package_of_module(module)
        if named.is_empty() { self.root_name.get() } else { named }
    }

    /// A declaration's module, package prefix dropped: `nullable`
    /// for one under `features/nullable/`, wherever the package
    /// that carries it sits in a build — a rule's identity
    /// (`rule_id`, compiler/rules_table.av) is named after this, so
    /// it must read the same whether `@std/avrac` is the root being
    /// built or a dependency of the program that carries it.
    fn short_module_of(d: DeclId) -> string { self.module_of(d).split(".").last()! }

    /// Every declaration of `k` admitted so far — a fixture proving
    /// one (`/tests/`) is not the program's own, `is_test_path`'s law
    /// here too. Admission is the caller's: a closure-scoped
    /// `collect` forces its own package's files in first
    /// (`Workspace.collect_admit`, `gathered`'s hook).
    fn decls_of_kind(k: DeclKind) -> List<Decl> {
        [d for d in self.decls.get() if d.kind == k && !self.file(d.file).path.contains("/tests/")]
    }

    /// THE COLLECT INDEX: every declaration `collect` can gather, by
    /// the ONE WORD it answers to — `rule` for a declared `DeclKind`,
    /// or a component's own name for a named instance. Extended past
    /// everything minted since it was last read, O(new rows) never a
    /// rescan — a row's word never changes once minted, so nothing
    /// already indexed is revisited.
    fn indexed(word: string) -> List<DeclId> {
        self.grown_index()
        self.collect_index.get().by_word.get(word) ?? []
    }

    fn grown_index() {
        let idx = self.collect_index.get()
        let all = self.decls.get()
        if idx.through >= all.length { return }
        mut by_word = idx.by_word
        for row in self.collect_rows(idx.through, all) {
            by_word.set(row.word, (by_word.get(row.word) ?? []).concat([row.id]))
        }
        self.collect_index.set(CollectIndex { by_word: by_word, through: all.length })
    }

    /// The new rows' own words, `all[from..]` — a row with none (most
    /// declarations: `collect` gathers by invitation, never by
    /// default) contributes nothing.
    fn collect_rows(from: int, all: List<Decl>) -> List<IndexedWord> {
        flatten([some_list(self.indexed_word(all[i])) for i in from..all.length])
    }

    fn indexed_word(d: Decl) -> IndexedWord? {
        let w? = self.collect_word(d) else { return null }
        IndexedWord { word: w, id: d.id }
    }

    /// The word a declaration answers `collect` under: for a `Const`
    /// (the ONLY kind a named instance promotes to,
    /// `NodeStore.declared_instance`) the component its own statement
    /// instances (`NodeStore.instance_of`, `rule` among them) —
    /// absent for everything else, a `Builtin`'s sentinel file and
    /// stmt among them, which no store carries.
    fn collect_word(d: Decl) -> string? {
        if !(d.kind is .Const) { return null }
        self.store_of(d.file).instance_of(d.stmt)
    }

    /// Every indexed declaration of `word`, admitted so far —
    /// `decls_of_kind`'s law here too: a fixture (`/tests/`) is not
    /// the program's own.
    fn decls_of_word(word: string) -> List<Decl> {
        [d for d in [self.decl(id) for id in self.indexed(word)] if !self.file(d.file).path.contains("/tests/")]
    }

    /// The root package's manifest name, kept in the dotted spelling.
    fn name_root(name: string) { self.root_name.set(name.replace("/", ".")) }

    /// Whether a meta value CARRIES A NAME — a declaration's, a
    /// field's, a variant's, a parameter's — which is what a quote's
    /// hole splices of it.
    fn meta_names_one(ty: TypeId) -> bool {
        self.takes_a_decl(ty) || self.meta_type(ty, "Field") || self.meta_type(ty, "Variant") || self.meta_type(ty, "Param")
    }

    /// A declaration of `@std/meta` by name — the compiler's own door
    /// to the meta vocabulary (`Node`, `template`, `as_decls`); null
    /// when the program does not load the package.
    fn meta_named(name: string) -> DeclId? {
        self.package_decl("@std.meta", name)
    }

    /// A declaration of THIS COMPILER'S OWN library by name — the
    /// door to `Code`, the handle a rule holds; null when the program
    /// does not load `@std/avrac`.
    fn avrac_named(name: string) -> DeclId? {
        self.package_decl("@std.avrac", name)
    }

    /// Whether a type IS one declaration a package exports, by NAME —
    /// `meta_type`'s door, generalized past `.Struct` to `.Enum` too,
    /// so `@std/avrac`'s `Fix` (an enum) answers through the same
    /// check `Code` (a struct) does.
    fn declared_as(ty: TypeId, pkg: string, name: string) -> bool {
        let d: DeclId? = match self.types.shape_of(ty) {
            .Struct(d, _) or .Enum(d, _) -> d,
            rest -> null,
        }
        d != null && self.decl(d!).name == name && self.package_of(d!) == pkg
    }

    /// A type IS `@std/avrac`'s declaration of this name — the same
    /// door `avrac_named` opens for a value, read back over a type.
    fn avrac_type(ty: TypeId, name: string) -> bool {
        self.declared_as(ty, "@std.avrac", name)
    }

    /// A declaration a PACKAGE exports, by name — the door to a
    /// vocabulary the compiler shares with the programs it compiles;
    /// null when the program does not load the package.
    ///
    /// EVERY MODULE OF THE PACKAGE IS SEARCHED, not its first: a
    /// package a `use` reaches through ONE submodule (`@std/avrac`'s
    /// `core`, say) admits every OTHER submodule too, so a name in a
    /// DIFFERENT one (`features`'s `Code`) is still the package's —
    /// reading only `ms[0]`'s files answered null for it whenever
    /// that module happened to load first, which depends on `use`
    /// order and so is not a property of the name at all.
    ///
    /// AND THE PACKAGE NAME IS `package_named`'S, never the raw
    /// `package_of_module`: the ROOT package's own modules carry NO
    /// prefix (that is what makes them the root's), so a door asked
    /// for THE PACKAGE BEING COMPILED — `@std/avrac` checking its
    /// own `Code` while typing ITS OWN test suite — answered null
    /// for every one of its modules, `avrac_named` most of all: the
    /// compiler is the one program that always loads its own library.
    ///
    /// AND ONLY AN EXPORTED DECLARATION ANSWERS: searching every
    /// module (above) reaches a package's PRIVATE names too, and a
    /// door built to find the shared vocabulary is not asking about
    /// those — `compiler/record.av`'s own, unexported `enum Shape`
    /// answered for `avrac_named("Shape")` before this line, a
    /// different enum entirely from `core/shape.av`'s exported one,
    /// wrong variants and all, chosen only because ITS module was
    /// searched first.
    fn package_decl(pkg: string, name: string) -> DeclId? {
        let key = "${pkg}.${name}"
        let known: DeclId? = self.meta_ids.get().get(key)
        if known != null { return known }
        let ms = [ModuleId { index: j } for j, m in self.modules.get() if self.package_named(m) == pkg]
        let ds: List<DeclId> = flatten([self.module_decls(m) for m in ms])
        let found: DeclId? = ds.find((d: DeclId) -> {
            let found_decl = self.decl(d)
            found_decl.exported && found_decl.name == name
        })
        if found != null { self.meta_ids.put(key, found!) }
        found
    }

    /// One module's own declarations, across its files.
    fn module_decls(m: ModuleId) -> List<DeclId> {
        flatten([self.file_decls.get()[f.index].get() for f in self.module_files.get()[m.index].get()])
    }

    /// Whether a type is one declaration exported by `@std/meta`.
    /// The DeclId is the identity; the package and export name locate
    /// that identity without accepting an equal-shaped user record.
    fn meta_type(ty: TypeId, name: string) -> bool {
        match self.types.shape_of(ty) {
            // THE DECLARATION'S name, never the WRITTEN spelling: a
            // `use @std.meta.{Fn as F}` gives the type the alias in its
            // written name, and the boundary must still read `Fn`.
            .Struct(d, _) -> self.decl(d).name == name && self.package_of(d) == "@std.meta",
            rest -> false,
        }
    }

    /// A declaration's signature — asking it IS the query: the hook
    /// the workspace arms computes it on first ask and records the
    /// dependency; the table only holds.
    fn sig(d: DeclId) -> DeclSig? {
        (self.ensure.get())(d)
        let held: DeclSig? = self.sigs.get()[d.index]
        held
    }

    /// The hooks capture the workspace that holds this table — a
    /// cycle counting never frees. A one-shot workspace disarms them
    /// once every declaration it will ever ask about is signed; a
    /// sig asked after that is held or, loudly, absent.
    fn disarm() {
        self.ensure.set(no_ensure)
        self.ensure_const.set(no_const_ensure)
        self.ensure_entry.set(no_entry_ensure)
        self.ensure_methods.set(no_ensure)
        self.ensure_writes.set(no_ensure)
        self.ensure_marks.set(no_marks)
        self.ensure_store.set(no_store)
        self.ensure_file.set(no_store)
        self.lifter.set(no_lifter)
    }

    /// The workspace arms the sig hook once.
    fn arm(ensure: fn(DeclId) -> void) {
        self.ensure.set(ensure)
    }

    fn arm_const(ensure: fn(FileId, StmtId) -> bool) { self.ensure_const.set(ensure) }

    /// The workspace arms the entry hook once.
    fn arm_entry(ensure: fn() -> bool) { self.ensure_entry.set(ensure) }

    /// Whether THIS compilation is a program — has an entry the
    /// workspace will run — or a library, read at run time only.
    fn is_program() -> bool { (self.ensure_entry.get())() }

    /// Every declaration `word` names WITHIN `scope` — a member is
    /// found the way any declaration is, by import reachability
    /// (docs/2026_09_22_COLLECTIONS.md §5: contributions merge
    /// exactly where imports merge). Read through the collect index,
    /// so a second ask over the same word rescans nothing new; the
    /// SCOPE FILTERS what is already reached, it never widens it —
    /// `closure` answers everything the program links, `package`
    /// narrows to the owner's own package, `self` to the owner's own
    /// file.
    fn gathered(word: string, scope: CollectScope, owner: FileId) -> List<Decl> {
        [d for d in self.decls_of_word(word) if self.in_scope(d, scope, owner)]
    }

    /// A REGISTRY match over `CollectScope`: `self` is the owner's own
    /// file, `package` the owner's own package, `closure` everything
    /// admitted. An unknown scope was already refused at
    /// `check_collect` — it gathers nothing, honestly.
    fn in_scope(d: Decl, scope: CollectScope, owner: FileId) -> bool {
        match scope {
            .Self -> same_file(d.file, owner),
            .Package -> self.package_of_file(d.file) == self.package_of_file(owner),
            .Closure -> true,
            .UnknownScope(_) -> false,
        }
    }

    fn package_of_file(f: FileId) -> string {
        self.package_named(self.module_name(self.file(f).module_id))
    }

    fn const_type(f: FileId, s: StmtId) -> ConstType {
        if (self.ensure_const.get())(f, s) { return ConstType.Cyclic }
        let held? = self.held_const_type(f, s) else { return ConstType.Refused }
        ConstType.Known(held)
    }

    fn held_const_type(f: FileId, s: StmtId) -> TypeId? { self.const_types.get().get(const_type_key(f, s)) }

    fn held_value(d: DeclId) -> Settled? { self.held_values.get().get("${d.index}") }

    fn remember_held_value(d: DeclId, value: Settled) { self.held_values.put("${d.index}", value) }

    fn record_const_type(f: FileId, s: StmtId, ty: TypeId) {
        self.const_types.put(const_type_key(f, s), ty)
    }

    /// The workspace arms the lifting hook once.
    fn arm_lifter(lift: fn(DeclId, FileId, StmtId, ExprId, List<ExprId>) -> Result<Lifted, Unsettled>) {
        self.lifter.set(lift)
    }

    /// The workspace arms the marks hook once — a declaration's
    /// use-site warnings are a query of the program, never a table
    /// an earlier walk happened to fill.
    fn arm_marks(ensure: fn(DeclId) -> void) {
        self.ensure_marks.set(ensure)
    }

    /// A declaration's warnings, asked at a use. Asking IS the
    /// computation; the table only holds.
    fn marks(d: DeclId) -> List<Diagnostic> {
        (self.ensure_marks.get())(d)
        let held: List<Diagnostic>? = self.marks.get()[d.index]
        held ?? []
    }

    fn record_marks(d: DeclId, xs: List<Diagnostic>) {
        self.marks.set_at(d.index, xs)
    }

    /// An annotation fn `d` run over the declaration at `s` in file
    /// `f`, with these settled arguments — asking IS the run.
    fn lifted(d: DeclId, f: FileId, s: StmtId, call: ExprId, args: List<ExprId>) -> Result<Lifted, Unsettled> {
        (self.lifter.get())(d, f, s, call, args)
    }

    /// A list type's element, or null for any other shape.
    fn elem_of(ty: TypeId) -> TypeId? {
        match self.types.shape_of(ty) {
            .List(e) -> e,
            _ -> null,
        }
    }

    /// A declaration's signature — and with a record's, its LAYOUT: a
    /// signature typed from source and one read from an interface both
    /// land here, so a layout has one law.
    fn declare(d: DeclId, sig: DeclSig) {
        self.sigs.set_at(d.index, sig)
        let e: EnumSig? = enum_parts(sig)
        if e != null { return self.flatten_enum(d, e!) }
        let r? = sig.record_sig() else { return }
        self.flatten(d, r.types)
        self.types.mark_settled(self.record_type(d))
    }

    /// AN ENUM WHOSE VARIANTS CARRY NOTHING IS ITS TAG — a word, as C
    /// spells an enum: no box to build per variant, nothing to count.
    /// ONE WHOSE VARIANTS EACH CARRY AT MOST ONE WORD is a VALUE ENUM:
    /// its tag and that word ride registers, and a box is made only
    /// where a slot holds it.
    fn flatten_enum(d: DeclId, e: EnumSig) {
        if !self.tparams(d).is_empty() { return }
        let ty = self.types.intern(Type.Enum(d, self.decl(d).name))
        self.laid_out(d, ty, e)
        self.types.mark_settled(ty)
    }

    /// An enum's layout: its tag alone, its tag and one word, or its box.
    fn laid_out(d: DeclId, ty: TypeId, e: EnumSig) {
        if e.payloads.all(it.is_empty()) { return self.types.mark_flat(ty, [self.types.type(int)]) }
        if e.payloads.length > max_valued_variants { return }
        let words = [self.variant_word(d, ps) for ps in e.payloads]
        if words.any(it == null) { return }
        self.types.mark_valued(ty, counted_bits([w! for w in words]))
    }

    /// What one variant's payloads make of its word: absent when it
    /// carries more than one or a payload is not ONE word, 0 when the
    /// word is uncounted (none, or an int), 1 when it is a pointer.
    fn variant_word(d: DeclId, ps: List<TypeId>) -> int? {
        if ps.length > 1 { return null }
        let t? = ps.first() else { return 0 }
        self.payload_word(d, t)
    }

    /// A payload's word, asked of its own declaration first so the
    /// answer never depends on which was declared first: 0 an int or
    /// a word enum, 1 a pointer that is counted, absent for anything
    /// else — a float, a bool, a raw pointer, a pair, a flat record, and
    /// an enum that carries anything.
    fn payload_word(d: DeclId, t: TypeId) -> int? {
        match self.types.shape_of(t) {
            .Struct(r, _) -> { let _ = self.sig(r) },
            rest -> nothing_asked(),
        }
        // a FLAT record is a word a `mut` seat may still box — out
        if self.types.shape_of(t) is .Struct && self.types.is_flat(t) { return null }
        let m = self.types.machine_type(t)
        match self.types.shape_of(m) {
            .Int -> 0,
            .Enum(e, _) -> if !same_decl(e, d) && self.carries_nothing(e) { 0 } else { null },
            .Struct(_, _) -> if self.types.travels_wide(m) { null } else { 1 },
            .Opt(inner) -> if self.types.opt_rides_pointer(inner) { 1 } else { null },
            .Str or .Bytes or .List(_) or .Map(_, _) or .Cell(_) or .Task(_) or .Tasks or .Res(_, _) or .App(_, _, _) or .Dyn(_, _) or .Fn(_, _, _) -> 1,
            .Float or .Bool or .Ptr or .TypeName(_, _) or .Var(_, _, _) or .Null or .EmptyList or .EmptyMap or .Error or .Void -> null,
        }
    }

    /// Whether an enum's own declaration gives none of its variants a
    /// payload — read from its signature, never its layout.
    fn carries_nothing(e: DeclId) -> bool {
        if !self.tparams(e).is_empty() { return false }
        let s? = self.sig(e) else { return false }
        let es? = enum_parts(s) else { return false }
        es.payloads.all(it.is_empty())
    }

    /// THE FLAT LAW: a record of SCALAR fields and no type parameters
    /// IS its fields — one field an id in a register, several a VALUE
    /// RECORD in registers (a span, a line), boxed only where a one-word
    /// seat holds it. A pointer-riding field keeps the box, because that
    /// reference must still be counted.
    fn flatten(record: DeclId, types: List<TypeId>) {
        if types.is_empty() || !self.tparams(record).is_empty() { return }
        if !types.all((t) -> self.scalar_field(t)) { return }
        self.types.mark_flat(self.record_type(record), types)
    }

    /// A SCALAR FIELD: an `int`, a `bool` (the runtime's i64 seams
    /// coerce it by shape), a WORD ENUM — one whose own declaration
    /// carries no payload anywhere, so its tag is its whole value —
    /// or a WORD ENUM's NULLABLE, which spends the spare tag -1 and
    /// so is one register too. Asked of the field's own declaration
    /// through `carries_nothing`, never of the type registry's marks,
    /// so the answer never depends on which of the two was declared
    /// first.
    fn scalar_field(t: TypeId) -> bool {
        match self.types.shape_of(t) {
            .Int or .Bool -> true,
            .Enum(e, _) -> self.carries_nothing(e),
            .Opt(inner) -> match self.types.shape_of(inner) {
                .Enum(e, _) -> self.carries_nothing(e),
                rest -> false,
            },
            rest -> false,
        }
    }

    /// A record declaration's own type.
    fn record_type(record: DeclId) -> TypeId { self.types.intern(Type.Struct(record, self.decl(record).name)) }

    fn tparams(d: DeclId) -> List<string> {
        let x = self.decl(d)
        if x.kind is .Builtin { return builtin_tparams(self.row_of(d)!.arity) }
        if x.kind is .Impl { return self.target_tparams(d) }
        // A TRAIT DECLARES ONE TYPE PARAMETER, `Self` — its
        // implementor — and its members wear it: a default body is
        // a generic method over `Self`, lowered per signatory.
        if x.kind is .Trait { return [self_word] }
        self.facts_of(d)?.tparams ?? []
    }

    /// An impl block's type parameters are its TARGET's — a method
    /// under `impl Arena<N>` instantiates with `Arena`'s Vars.
    fn target_tparams(impl_decl: DeclId) -> List<string> {
        let t? = self.target_of(impl_decl) else { return [] }
        self.tparams(t)
    }

    // ── the inout seats ──

    /// A declaration's seat CONTRACTS, as declared — a method's seat
    /// 0 is its receiver and is never declared here. The written bits
    /// take the same shape, all false until the pass runs.
    fn record_seats(d: DeclId, marks: List<SeatMark>) {
        self.seat_marks.set_at(d.index, marks)
        self.written_seats.set_at(d.index, Cell.new(filled(marks.length, false)))
    }

    /// How many seats a declaration has — the receiver's included.
    fn seat_count(d: DeclId) -> int { self.seat_marks.get()[d.index].length }

    /// Asking IS the query: the sig hook declares `d` first, so a
    /// callee named before its own declaration answers truly.
    /// A declaration's seats' marks, sized to its seats — the
    /// contract a fn VALUE of it carries.
    fn marks_of(d: DeclId, n: int) -> List<SeatMark> {
        mut out: List<SeatMark> = []
        mut j = 0
        while j < n {
            out.push(self.seat_mark(d, j))
            j = j + 1
        }
        out
    }

    fn seat_mark(d: DeclId, i: int) -> SeatMark {
        (self.ensure.get())(d)
        mark_at(self.seat_marks.get()[d.index], i)
    }

    /// `mut fn` — the method (or trait sig) declared its receiver
    /// written.
    fn record_declared_writing(d: DeclId) {
        self.declared_writes.set_at(d.index, true)
    }

    fn declares_writing(d: DeclId) -> bool {
        (self.ensure.get())(d)
        self.declared_writes.get()[d.index]
    }

    /// The seats pass found the body writing through seat `i`.
    fn record_seat_written(d: DeclId, i: int) {
        if i < self.written_seats.get()[d.index].get().length { self.written_seats.get()[d.index].set_at(i, true) }
    }

    /// The pass's own reads — hook-free, as the table stands.
    fn seat_written_so_far(d: DeclId, i: int) -> bool {
        let row = self.written_seats.get()[d.index].get()
        i < row.length && row[i]
    }

    /// Whether seat `i` is written, declared or found: a method's
    /// receiver by its word, any seat by the pass.
    fn seat_writes_so_far(d: DeclId, i: int) -> bool {
        i == 0 && self.declared_writes.get()[d.index] || self.seat_written_so_far(d, i)
    }

    /// The receiver's inferred bit — seat 0 of a method.
    fn written_so_far(d: DeclId) -> bool { self.seat_written_so_far(d, 0) }

    fn writes_so_far(d: DeclId) -> bool { self.seat_writes_so_far(d, 0) }

    /// The pass starts over: every inferred bit falls, and the
    /// fixpoint re-earns them.
    fn clear_written() {
        // A HELD FILE'S SETTLED BITS ARE THE INTERFACE'S, not this pass's to clear:
        // the receivers pass never surveys a held body, so wiping them loses the
        // writer a caller's retain decision reads. The pass clears what it owns.
        for j, x in self.decls.get() {
            if self.held.get().get(self.file(x.file).path) == null { self.written_seats.set_at(j, Cell.new(filled(self.written_seats.get()[j].get().length, false))) }
        }
    }

    /// Whether a method WRITES its receiver: declared, or found by
    /// the receivers pass — asking IS the query; the hook runs the
    /// pass and records the dependency.
    fn writes_receiver(d: DeclId) -> bool {
        (self.ensure_writes.get())(d)
        self.seat_writes_so_far(d, 0)
    }

    /// Whether the body writes through seat `i` — asking runs the
    /// pass; the declared `mut` is what the caller's law reads.
    fn seat_written(d: DeclId, i: int) -> bool {
        (self.ensure_writes.get())(d)
        self.seat_written_so_far(d, i)
    }

    /// The workspace arms the receivers hook once.
    fn arm_writes(ensure: fn(DeclId) -> void) {
        self.ensure_writes.set(ensure)
    }

    fn record_target(impl_decl: DeclId, target: DeclId) {
        self.targets.set_at(impl_decl.index, target)
    }

    fn target_of(impl_decl: DeclId) -> DeclId? {
        let held: DeclId? = self.targets.get()[impl_decl.index]
        held
    }

    /// The BOUND each type parameter declares, by NAME — `""` for an unconstrained seat.
    /// One accessor for the four sites that read a bound, so the fact lives once.
    fn tbounds(d: DeclId) -> List<string> {
        let x = self.decl(d)
        if x.kind is .Builtin { return [] }
        // `Self` is bounded by the trait itself, so the BOUND'S NAME
        // is the trait's — `Self` is the parameter's name, and a
        // reader asking for a bound wants the trait to judge against.
        if x.kind is .Trait { return [x.name] }
        self.facts_of(d)?.bounds ?? []
    }

    /// The bound a seat declares, by name.
    fn bound_name(d: DeclId, j: int) -> string {
        let tb = self.tbounds(d)
        if j < 0 || j >= tb.length { return "" }
        tb[j]
    }

    fn is_trait(d: DeclId) -> bool { self.decl(d).kind is .Trait }

    fn is_enum(d: DeclId) -> bool { self.decl(d).kind is .Enum }

    fn is_named(d: DeclId) -> bool { self.decl(d).kind is .Named }

    fn is_alias(d: DeclId) -> bool { self.decl(d).kind is .Alias }

    /// The type an alias stands for — absent while it is still being read.
    fn alias_of(d: DeclId) -> TypeId? { self.sig(d)?.alias_sig() }

    /// The declaration a name stands for as a VALUE — itself, or, for
    /// an alias, the record, enum or named type it names. Absent for
    /// an alias of any other shape.
    fn named_by(d: DeclId) -> DeclId? {
        if !self.is_alias(d) { return d }
        let of? = self.alias_of(d) else { return null }
        match self.types.shape_of(of) {
            .Struct(t, _) or .Enum(t, _) -> t,
            _ -> null,
        }
    }

    fn is_builtin(d: DeclId) -> bool { self.decl(d).kind is .Builtin }

    /// The type a builtin declaration stands for: the shape its row
    /// builds over these arguments.
    fn built_type(d: DeclId, args: List<TypeId>) -> TypeId {
        let row? = type_row(self.rows, self.decl(d).name) else { return self.types.intern(Type.Error) }
        self.types.intern(row.builds(TypeArgs { parts: args }))
    }

    /// The language's own type declarations, minted once from the
    /// type rows. Enum rows also declare their variants; structural
    /// rows still need a value-level name for static vocabulary.
    fn admit_builtins() {
        for r in self.rows { self.admit_builtin(r) }
    }

    fn admit_builtin(r: TypeRow) {
        let id = self.mint("builtin::${r.name}", FileId { index: 0 }, no_stmt, r.name, DeclKind.Builtin, true, "", null, false, null)
        self.builtins.push(id)
        self.declare_builtin(id, r)
    }

    /// A builtin's signature: its variants over its own Vars — the
    /// ordinal is the identity, `T1`, `T2`, … the wording.
    fn declare_builtin(d: DeclId, r: TypeRow) {
        let vars = TypeArgs { parts: [self.types.intern(Type.Var(d, j, n)) for j, n in builtin_tparams(r.arity)] }
        let sig: EnumSig? = r.variants(vars)
        if sig != null { self.declare(d, DeclSig.Enum(sig!)) }
    }

    fn builtin_decls() -> List<DeclId> { self.builtins.get() }

    /// The declaration a type's impls are filed under: its own, or the
    /// language's for a scalar — absent for every other shape.
    fn implementor(ty: TypeId) -> DeclId? {
        declared_decl(self.types.shape_of(ty)) ?? self.scalar_decl(ty)
    }

    /// A scalar's builtin declaration: the one that builds it bare.
    fn scalar_decl(ty: TypeId) -> DeclId? {
        self.builtins.get().find((b) -> self.builds_bare(b, ty))
    }

    fn builds_bare(b: DeclId, ty: TypeId) -> bool {
        let row? = type_row(self.rows, self.decl(b).name) else { return false }
        row.arity == 0 && same_type(self.built_type(b, []), ty)
    }

    /// A builtin's row — the parts a store would hold for a
    /// statement; a declaration a program wrote has none.
    fn row_of(d: DeclId) -> TypeRow? {
        let x = self.decl(d)
        if !(x.kind is .Builtin) { return null }
        self.rows.find(it.name == x.name)
    }

    /// Whether a fn is the HOST's — declared `extern`, called by its
    /// bare symbol, never lowered.
    /// The format a declaration's record reads, when a `grammar`
    /// declared it — the one question that admits a type name as a
    /// CALL rather than a construction.
    fn grammar_of(d: DeclId) -> GrammarSpec? {
        let x = self.decl(d)
        if !(x.kind is .Record) { return null }
        // A GRAMMAR SPEC IS ITS OWN PARSE, and only a PARSED file can answer it: the hold
        // refuses a file that declares a grammar record (`grammar_free`), so the store is
        // always here when the answer is not null.
        if self.held.get().get(self.file(x.file).path) != null { return null }
        self.store(d).grammar_of(x.stmt)
    }

    fn is_extern(d: DeclId) -> bool { self.decl(d).kind is .Fn && self.facts_of(d)?.external ?? false }

    /// THE ONE READING DOOR for a declaration's `///` doc — a held file answers
    /// through the same fact `capture_facts` recorded at admit. A declaration
    /// with none of its own inherits its FILE's `//!` header: the general
    /// case, not a feature-shaped one — any lightly-documented file with one
    /// clear purpose reads this way, `avra docs enums` included, and nothing
    /// here knows what a "feature" is. Never `store_of`: a held declaration
    /// has no store to force, and a declaration minted with no facts at all
    /// must still answer null rather than trap.
    fn doc_of(d: DeclId) -> List<string>? { self.facts_of(d)?.doc ?? self.file_doc_of(self.decl(d).file) }

    /// A declaration's OWN `///` doc, with NO file fallback —
    /// `doc_of`'s narrower half. A `collect`'s generic `doc` field
    /// (compiler/lower/lower.av's `collect_field_text`) reads THIS,
    /// never `doc_of`: a collect gathers MANY declarations, often
    /// from the SAME file (every `rule` an idioms.av holds), so "no
    /// doc of its own" inheriting the file's `//!` would hand every
    /// undocumented one the SAME borrowed paragraph — the
    /// single-purpose-file assumption `doc_of`'s fallback rests on is
    /// exactly what a collect's own file is not.
    fn own_doc_of(d: DeclId) -> List<string>? { self.facts_of(d)?.doc }

    /// A file's `//!` header when it has a real store, null for a held
    /// file (its record carries no file-level doc) or an out-of-range
    /// one (a declaration minted with no file behind it at all).
    fn file_doc_of(f: FileId) -> List<string>? {
        if f.index >= self.stores.get().length { return null }
        self.stores.get()[f.index]?.file_doc()
    }

    /// THE ONE READING DOOR for a declaration's `@name(args)` annotations, in
    /// written order — the fact `avra docs`, the formatter's `Code` and
    /// `@std/meta`'s crossing all read, so no reader parses a store of its own.
    fn annotations_of(d: DeclId) -> List<AnnotationFact> { self.facts_of(d)?.annotations ?? [] }

    /// A type's name, read as a value — a receiver for `Type.name(…)`,
    /// never a constructible shape of its own. A trait's Self is not
    /// among its answers here: nothing pins it, so `decl_type_of`
    /// never reaches the generic-fn refusal for a trait's bare name.
    fn type_name(d: DeclId) -> string? {
        let x = self.decl(d)
        match x.kind {
            .Record or .Named or .Alias or .Enum or .Builtin or .Trait -> x.name,
            .Fn or .Syntax or .Method or .Default or .Impl or .Main or .Case or .Const or .Collect -> null,
        }
    }

    /// A fn's name — free fns and methods; a named component
    /// instance (a `rule` among them) is a `Const`, read as its own
    /// built value, never called by symbol.
    fn fn_name(d: DeclId) -> string? {
        let x = self.decl(d)
        match x.kind {
            .Fn or .Method -> x.name,
            .Record or .Named or .Alias or .Enum or .Trait or .Syntax or .Default or .Impl or .Main or .Case or .Builtin or .Const or .Collect -> null,
        }
    }

    /// Whether a declaration has a body to type and lower.
    fn has_body(d: DeclId) -> bool { self.decl(d).root != null }

    /// A declaration's members, in declaration order: a trait's or
    /// impl's methods, a record's defaults.
    fn children_of(d: DeclId) -> List<DeclId> { self.children.get()[d.index].get() }

    /// An impl block filed under the name it targets.
    fn note_impl(name: string, id: DeclId) {
        mut under = self.impls_by_name.get().get(name) ?? []
        under.push(id)
        self.impls_by_name.put(name, under)
    }

    /// Every impl block naming a type by this name, in mint order.
    fn impls_named(name: string) -> List<DeclId> {
        self.impls_by_name.get().get(name) ?? []
    }

    /// A record field's default, when the field declares one.
    fn default_named(record: DeclId, field: string) -> DeclId? {
        // LICENSED style.hand_rolled_scan: `it` binds to the NEAREST call, so a self-method predicate is F2033 — the scan is spelled
        for c in self.children_of(record) {
            if self.decl(c).name == field { return c }
        }
        null
    }

    /// Each written seat's default body, in seat order — null where
    /// the seat has none.
    fn seat_defaults(d: DeclId) -> List<DeclId?> {
        [self.default_named(d, n) for n in self.facts_of(d)?.seats ?? []]
    }

    /// Whether a fn's body is lowered once for every caller: no type
    /// parameters of its own, nor of the type its impl serves.
    fn lowered_once(d: DeclId) -> bool {
        if !self.tparams(d).is_empty() { return false }
        let block? = self.decl(d).parent else { return true }
        // the DECLARATION first: a member's sig records its impl's target
        let _ = self.sig(d)
        let target? = self.target_of(block) else { return true }
        self.tparams(target).is_empty()
    }

    /// Where a declaration is — a generated one homed at the template
    /// that wrote it, or at the annotation that asked.
    fn loc(d: DeclId) -> Loc? {
        let x = self.decl(d)
        self.homed(x.file, self.origin_of_stmt(x.file, x.stmt), self.generation_of_stmt(x.file, x.stmt), self.decl_span(d))
    }

    /// A span of a file homed. A copied template node keeps the span
    /// it was written with, so its place is that span in its origin
    /// file; a generated node of this file's own text is at its span
    /// here; a node minted with no span is at the annotation that
    /// asked for it.
    fn homed(f: FileId, origin: FileId?, g: Generation?, sp: Span?) -> Loc? {
        if origin != null && sp != null { return loc_at(self.file(origin!).path, sp) }
        if g == null || sp != null { return loc_at(self.file(f).path, sp) }
        loc_at(self.file(f).path, g!.at)
    }

    /// THE symbol a declaration lowers to — its name under its
    /// module; a member's under its type's name first; a case's its
    /// file and its body's node, since a stored object outlives every
    /// id a run hands out. Every symbol a body or a call site carries
    /// comes from here.
    fn symbol(d: DeclId) -> string {
        let x = self.decl(d)
        if self.is_extern(d) { return x.name }
        let local_name = match x.kind {
            .Method or .Default -> "${x.owner}.${x.name}",
            .Case -> "${stem_of(self.file(x.file).path)}\$case${x.root?.index ?? x.stmt.index}",
            .Fn or .Const or .Record or .Named or .Alias or .Enum or .Trait or .Syntax or .Impl or .Main or .Builtin or .Collect -> x.name,
        }
        module_symbol(self.module_of(d), local_name)
    }

    /// THE symbol a LIFTED body lowers to. A lambda has no name of
    /// its own, so it takes its FILE's — module and stem — and the
    /// node that wrote it: program-unique, as every body's symbol
    /// must be (a node id is unique in its file alone).
    fn lifted_symbol(f: FileId, e: ExprId) -> string {
        let info = self.file(f)
        module_symbol(self.module_name(info.module_id), "${stem_of(info.path)}\$l${e.index}")
    }

    // ── traits and methods ──

    /// A trait's method declarations, in declaration order.
    fn trait_fns(d: DeclId) -> List<DeclId> {
        // A TRAIT'S MEMBERS ARE ITS CHILDREN, minted with it as METHODS — the store's
        // `trait_parts` was a second listing of a relationship the table already holds.
        [m for m in self.children_of(d) if self.decl(m).kind is .Method]
    }

    /// A trait's method names — the vtable's order.
    fn trait_method_names(d: DeclId) -> List<string> {
        [self.decl(m).name for m in self.trait_fns(d)]
    }

    /// A trait's associated `derive` member, or none — the ONE name
    /// the compiler runs for `@derive`.
    fn trait_derive(d: DeclId) -> DeclId? {
        self.trait_fns(d).find((m: DeclId) -> self.fn_name(m) == "derive")
    }

    /// A trait's associated `marks` member, or none — what its
    /// `derive` says it READS off the declaration's members. A derive
    /// that declares none claims none, and every mark written on a
    /// declaration it alone serves is then unread.
    fn trait_marks(d: DeclId) -> DeclId? {
        self.trait_fns(d).find((m: DeclId) -> self.fn_name(m) == "marks")
    }

    /// A type's method by name — asking IS the query: the hook fills
    /// the type's table from every impl that names it, and the ask
    /// records the dependency.
    fn method(target: DeclId, name: string) -> DeclId? {
        (self.ensure_methods.get())(target)
        self.held_method(target, name) ?? self.defaulted(target, name)
    }

    /// A method the type never wrote: the DEFAULT of a trait it
    /// implements, when that trait's member carries a body.
    fn defaulted(target: DeclId, name: string) -> DeclId? {
        // LICENSED style.hand_rolled_scan: `it` binds to the NEAREST call, so a self-method predicate is F2033 — the scan is spelled
        for tr in self.impls.get()[target.index].get() {
            let m: DeclId? = self.default_member(tr, name)
            if m != null { return m }
        }
        null
    }

    /// A trait's member by name, when it is a default.
    fn default_member(tr: DeclId, name: string) -> DeclId? {
        // LICENSED style.hand_rolled_scan: `it` binds to the NEAREST call, so a self-method predicate is F2033 — the scan is spelled
        for m in self.trait_fns(tr) {
            if self.decl(m).name == name && self.has_body(m) { return m }
        }
        null
    }

    /// The table as it stands — the registering side's own read.
    fn held_method(target: DeclId, name: string) -> DeclId? {
        // LICENSED style.hand_rolled_scan: `it` binds to the NEAREST call, so a self-method predicate is F2033 — the scan is spelled
        for m in self.methods_of(target) {
            if self.decl(m).name == name { return m }
        }
        null
    }

    /// A type's registered methods, as they stand — the hook-free read.
    fn methods_of(target: DeclId) -> List<DeclId> { self.methods.get()[target.index].get() }

    /// The workspace arms the method-table hook once.
    fn arm_methods(ensure: fn(DeclId) -> void) {
        self.ensure_methods.set(ensure)
    }

    /// A method registered under its type — the same declaration
    /// again (a recomputed sig) is the same entry.
    fn declare_method(target: DeclId, m: DeclId) {
        let prior: DeclId? = self.held_method(target, self.decl(m).name)
        if prior != null && same_decl(prior!, m) { return }
        self.methods.get()[target.index].push(m)
    }

    fn record_impl(ty: DeclId, tr: DeclId) {
        if self.holds_impl(ty, tr) { return }
        self.impls.get()[ty.index].push(tr)
    }

    /// Whether a type implements a trait — asked through the hook,
    /// like a method.
    fn implements(ty: DeclId, tr: DeclId) -> bool {
        (self.ensure_methods.get())(ty)
        self.holds_impl(ty, tr)
    }

    fn holds_impl(ty: DeclId, tr: DeclId) -> bool {
        self.impls.get()[ty.index].get().any(same_decl(it, tr))
    }
}

/// A key seen already in this admit is a repeated declaration: the
/// repeat is keyed by its statement, so it stays a declaration of
/// its own for the namespace law to refuse.
fn fresh_key(key: string, s: StmtId, seen: List<string>) -> string {
    if seen.contains(key) { return "${key}#${s.index}" }
    key
}

/// A range whose first expression never landed starts at zero.
fn started_at(i: int) -> int {
    if i < 0 { 0 } else { i }
}

/// The name a trait gives its implementor — the one type parameter
/// every trait declares.
export const self_word: string = "Self"

/// A member's body, when it wrote one — a sig's is a HOLE no pass
/// walks, and declares nothing to type.
fn declared_body(store: NodeStore, m: StmtId) -> ExprId? {
    let body: ExprId? = store.fn_parts(m)?.body
    if body == null || store.expr(body!) is .Error { return null }
    body
}

/// Two voices identical in every part a reader can see. The place is
/// compared by FILE AND SPAN rather than by identity, because a
/// template's refusal carries the template's own place and two walks
/// of it mint two `Loc` values saying the same thing.
fn same_voice(a: Diag, b: Diag) -> bool {
    a.kind == b.kind && a.message == b.message && a.help ?? "" == b.help ?? "" && a.primary.label ?? "" == b.primary.label ?? "" && same_place(a.primary.loc, b.primary.loc)
}

fn same_place(a: Loc?, b: Loc?) -> bool {
    if a == null || b == null { return a == null && b == null }
    placed(a!, b!)
}

fn placed(a: Loc, b: Loc) -> bool { a.file == b.file && a.lo == b.lo && a.hi == b.hi }

/// An enum's signature, or absence for every other declaration.
/// A value enum's tag must name a bit of its counted mask.
const max_valued_variants: int = 62

/// Each variant's word as a bit, set for a counted one: bit `t` for tag `t`.
fn counted_bits(words: List<int>) -> int {
    mut mask = 0
    mut bit = 1
    for w in words {
        if w == 1 { mask = mask + bit }
        bit = bit * 2
    }
    mask
}

fn nothing_asked() {}

fn enum_parts(sig: DeclSig) -> EnumSig? {
    match sig {
        .Enum(e) -> e,
        _ -> null,
    }
}
