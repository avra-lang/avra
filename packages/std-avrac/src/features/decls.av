//! THE DECLARATION TABLE — every declaration of the program, ONCE:
//! its file, its statement, its name and kind; its signature once
//! typing declares it; its methods and the traits it implements.
//! Ids are INTERNED by key (file, kind, name — a method under its
//! owner), so an id is dense, stable across edits, and the same when
//! an edited file is admitted again; a name declared twice in one
//! file is two declarations, the second keyed by its statement, so
//! the namespace law can refuse it. Per-file facts live once, by
//! FileId: the path, the module, the store, and which of its
//! statements declare. The workspace mints; every pass reads.
use core.{SideTable, side_table, DeclId, FileId, ModuleId, DeclKind, StmtId, ExprId, PatId, Span, NodeStore, TypeRegistry, new_type_registry, Param, module_symbol, filled, flatten, some_list, same_decl, SpecParts, ImplParts, TypeId, no_stmt, Type, package_of_module, TypeRef, named_ref, Stmt, Expr, Scoped}
use core.{SeatMark, mark_at, plain_mark}
use @std.path.{stem_of}
use diagnostics.{loc_at, Diag}
use @std.errors.{Loc}
use features.{TypeRow, TypeArgs, Unsettled, Lifted, MetaHeap, MetaVal, StructSig, EnumSig, generated_key, Decl, Origin, Origins, no_origins}
use @std.meta.{Diagnostic}

/// A file's path facts — known at first mention, before its parse.
export type FileInfo = { id: FileId, path: string, module_id: ModuleId }

/// One declaration: where it lives, what it is, the expression its
/// body IS (a fn's, a default's; absent for the rest), and the
/// expression range [lo, hi) that body occupies in its file's arena
/// — a method or a default also names the type it serves.
export type Decl = { id: DeclId, file: FileId, stmt: StmtId, name: string, kind: DeclKind, exported: bool, owner: string, parent: DeclId?, nested: bool, root: ExprId?, lo: int, hi: int }

/// A range-owning declaration and the source span it holds.
type OwnerSpan = { d: DeclId, lo: int, hi: int }

/// `decls`, `sigs`, `children`, `methods` and `impls` are dense by
/// DeclId; `stores` and `decl_ids` dense by FileId. The two hooks
/// make the table's reads queries: `ensure` computes a sig on first
/// ask, `ensure_methods` fills a type's method table.
export type Decls = {
    types: TypeRegistry,
    files: List<FileInfo>,
    paths: Map<string, FileId>,
    modules: List<string>,
    module_ids: Map<string, ModuleId>,
    module_files: List<List<FileId>>,
    mains: List<DeclId?>,
    stores: List<NodeStore?>,
    decl_ids: List<SideTable<DeclId?>>,
    file_decls: List<List<DeclId>>,
    decls: List<Decl>,
    keys: Map<string, DeclId>,
    sigs: List<DeclSig?>,
    // a GENERATED declaration's origin — null for every written one
    provenance: List<Provenance?>,
    // a file's admitted GENERATIONS, in order — the arena ranges each
    // took and the annotation that asked; dense by FileId
    generations: List<List<Generation>>,
    // a generated node's ORIGIN — the file whose template wrote it;
    // `Here` for a written node and for one whose name came through a
    // hole; dense by FileId, then by arena index
    origins: List<Origins>,
    // what a file's expansions REFUSED — generated source that did not
    // parse, spoken at the template that wrote it; dense by FileId
    expansion_voices: List<List<Diag>>,
    // `@std/meta`'s declarations by name, found once each
    meta_ids: Map<string, DeclId>,
    // a declaration's WARNINGS: the words it keeps for its users,
    // computed on first ask through `ensure_marks` (null = unasked)
    marks: List<List<Diagnostic>?>,
    ensure_marks: List<fn(DeclId)>,
    // the ROOT package's manifest name — its modules carry no package
    // prefix, and a kind spoken there still wears the package
    root_name: List<string>,
    const_types: Map<string, TypeId>,
    children: List<List<DeclId>>,
    methods: List<List<DeclId>>,
    impls: List<List<DeclId>>,
    // every impl block under the NAME it targets — filled at mint,
    // before any target resolves, so a method table finds its impls
    // without walking every declaration in the workspace
    impls_by_name: Map<string, List<DeclId>>,
    ensure: List<fn(DeclId)>,
    // the workspace's const-type hook: types the const, and answers
    // whether this ask closed a cycle
    ensure_const: List<fn(FileId, StmtId) -> bool>,
    // the workspace's lifting hook: an annotation fn run over a
    // declaration at compile time, what it said back
    lifter: List<fn(DeclId, FileId, StmtId, ExprId, List<ExprId>) -> Result<Lifted, Unsettled>>,
    ensure_methods: List<fn(DeclId)>,
    // the language's own type declarations, one per row that is an
    // enum — and the rows they read their parts from
    builtins: List<DeclId>,
    rows: List<TypeRow>,
    // an impl block's target type, once typing found it — dense by
    // DeclId; a method's instantiation is its target's
    targets: List<DeclId?>,
    // THE INOUT SEATS, dense by DeclId: each seat's CONTRACT a fn
    // declared (`mut`, `const`), whether a method DECLARED `mut fn`,
    // and whether the receivers pass found it WRITING through `self`
    // — asked through the armed hook
    seat_marks: List<List<SeatMark>>,
    declared_writes: List<bool>,
    written_seats: List<List<bool>>,
    ensure_writes: List<fn(DeclId)>,
}

/// Where no workspace stands behind the table, nothing lifts.
// LICENSED I23: a fn VALUE filling the lifter seat — its parameters are the seat's contract, and the answer needs none of them
fn no_lifter(d: DeclId, f: FileId, s: StmtId, call: ExprId, args: List<ExprId>) -> Result<Lifted, Unsettled> {
    .Err(Unsettled.Trap("nothing here lifts an annotation"))
}

// LICENSED I23: the hook's contract carries the declaration
fn no_marks(d: DeclId) {
}

// LICENSED I23: a fn VALUE filling the const-ensure seat — its parameters are the seat's contract, and the no-op needs none of them
fn no_const_ensure(f: FileId, s: StmtId) -> bool { false }

/// A const's type as the program answers it — or why it has none:
/// the const REFUSED (spoken at its own value), or its value asks
/// for its own type, which only the asking read can speak.
export enum ConstType {
    Known(TypeId)
    Refused
    Cyclic
}

fn const_type_key(f: FileId, s: StmtId) -> string { "${f.index}/${s.index}" }

export fn new_decls() -> Decls {
    Decls {
        types: new_type_registry(), files: [], paths: {}, modules: [], module_ids: {}, module_files: [], mains: [],
        stores: [], decl_ids: [], file_decls: [], generations: [], origins: [], expansion_voices: [], meta_ids: {}, decls: [], keys: {}, sigs: [], provenance: [], marks: [], ensure_marks: [no_marks], root_name: [""], const_types: {}, children: [], methods: [], impls: [], impls_by_name: {},
        ensure: [no_ensure], ensure_const: [no_const_ensure], ensure_methods: [no_ensure], builtins: [], rows: [], targets: [],
        seat_marks: [], declared_writes: [], written_seats: [], ensure_writes: [no_ensure],
        lifter: [no_lifter],
    }
}

/// A row's type parameters — `T1`, `T2`, … by arity; the ordinal
/// is the identity, the name only the wording.
fn builtin_tparams(arity: int) -> List<string> {
    mut out: List<string> = []
    mut j = 0
    while j < arity {
        out.push("T${j + 1}")
        j = j + 1
    }
    out
}

/// The table's own reads ask nothing more.
// LICENSED I23: the hook's contract carries the declaration
fn no_ensure(d: DeclId) {
}

/// A kind's word — the key's middle, and prose.
export fn kind_word(k: DeclKind) -> string {
    match k {
        .Fn -> "fn",
        .Record or .Named -> "type",
        .Enum -> "enum",
        .Trait -> "trait",
        .Syntax -> "syntax",
        .Method -> "method",
        .Default -> "default",
        .Impl -> "impl",
        .Main -> "main",
        .Case -> "case",
        .Const -> "const",
        .Builtin -> "builtin",
    }
}

impl Decls {
    // ── files ──

    /// A path's identity — minted at first mention.
    fn file_id(path: string, module: string) -> FileId {
        let known: FileId? = self.paths.get(path)
        if known != null { return known! }
        let id = FileId { index: self.files.length }
        let m = self.module_id(module)
        self.paths.set(path, id)
        self.files.push(FileInfo { id: id, path: path, module_id: m })
        mut mf = self.module_files[m.index]
        mf.push(id)
        self.module_files.set(m.index, mf)
        self.stores.push(null)
        self.decl_ids.push(side_table<DeclId?>("decl_ids", 0, 0, null))
        self.file_decls.push([])
        self.generations.push([])
        self.origins.push(no_origins())
        self.expansion_voices.push([])
        self.mains.push(null)
        id
    }

    /// A module's identity — minted at first mention.
    fn module_id(module: string) -> ModuleId {
        let known: ModuleId? = self.module_ids.get(module)
        if known != null { return known! }
        let m = ModuleId { index: self.modules.length }
        self.module_ids.set(module, m)
        self.modules.push(module)
        self.module_files.push([])
        m
    }

    fn module_name(m: ModuleId) -> string { self.modules[m.index] }

    /// A file's Main: its run-time statements as one declaration.
    fn main_of(f: FileId) -> DeclId? {
        let held: DeclId? = self.mains[f.index]
        held
    }

    fn file(f: FileId) -> FileInfo { self.files[f.index] }

    fn store_of(f: FileId) -> NodeStore { self.stores[f.index]! }

    /// A file admitted with its parse: which statements declare, and
    /// every declaration minted — the top-level ones, then each
    /// trait's and impl's methods under their owner. Answers the
    /// top-level ids, in order.
    fn admit(f: FileId, store: NodeStore, stmts: List<StmtId>) -> List<DeclId> {
        self.stores.set(f.index, store)
        mut by_stmt = side_table<DeclId?>("decl_ids", 0, store.stmts.count(), null)
        mut out: List<DeclId> = []
        mut made: List<DeclId> = []
        mut seen: List<string> = []
        let path = self.file(f).path
        for s in stmts {
            let kind: DeclKind? = store.declared_kind(s)
            if kind != null {
                let k = kind!
                let name = store.declared_name(s) ?? ""
                let key = fresh_key("${path}::${kind_word(k)}::${name}", s, seen)
                seen.push(key)
                let d = self.mint(key, f, s, name, k, store.is_exported(s), "", null, false, store.fn_parts(s)?.body)
                by_stmt.set(s.index, d)
                out.push(d)
                made.push(d)
                self.orphan(d)
                let fns: List<StmtId> = store.trait_parts(s)?.fns ?? []
                for m in fns {
                    let md = self.mint_method(key, f, store, m, name, d, declared_body(store, m))
                    by_stmt.set(m.index, md)
                    made.push(md)
                }
                let fields: List<Param> = store.struct_parts(s)?.fields ?? []
                for fd in fields {
                    if fd.default != null { made.push(self.mint_default(key, f, s, fd, name, d)) }
                }
            }
            // a top-level `const` is a declaration like a fn: module-wide,
            // order-free, exported only when it says so.
            if store.const_value(s) != null {
                let name = store.let_name(s) ?? ""
                let key = fresh_key("${path}::const::${name}", s, seen)
                seen.push(key)
                let d = self.mint(key, f, s, name, DeclKind.Const, store.is_exported(s), "", null, false, null)
                by_stmt.set(s.index, d)
                out.push(d)
                made.push(d)
                self.orphan(d)
            }
            let sp: SpecParts? = store.spec_parts(s)
            if sp != null {
                let suite = sp!
                // LICENSED I3: the pass's OUTPUT accumulates — every branch of this walk pushes into the same list
                for k, c in suite.cases {
                    made.push(self.mint("${path}::case ${s.index}.${k}", f, s, c.name, DeclKind.Case, false, suite.name, null, false, c.body))
                }
            }
            let ip: ImplParts? = store.impl_parts(s)
            if ip != null {
                let block = ip!
                let key = fresh_key("${path}::impl ${block.target}", s, seen)
                seen.push(key)
                let block_decl = self.mint(key, f, s, block.target, DeclKind.Impl, false, "", null, false, null)
                by_stmt.set(s.index, block_decl)
                made.push(block_decl)
                self.orphan(block_decl)
                for m in block.fns {
                    let md = self.mint_method(key, f, store, m, block.target, block_decl, store.fn_parts(m)?.body)
                    by_stmt.set(m.index, md)
                    made.push(md)
                }
            }
        }
        let main = self.mint("${path}::main", f, stmts.first() ?? no_stmt, "main", DeclKind.Main, false, "", null, false, null)
        made.push(main)
        self.mains.set(f.index, main)
        // A declaration NESTED in a body is refused by its feature, but
        // typing still walks it: it gets an identity under a key no
        // module-level name can take, and joins no namespace.
        for i in 0..store.stmts.count() {
            let s = StmtId { index: i }
            let nested: DeclKind? = store.declared_kind(s)
            if by_stmt.get(i) == null && nested != null {
                let name = store.declared_name(s) ?? ""
                let nd = self.mint("${path}::nested ${i}::${name}", f, s, name, nested!, false, "", null, true, null)
                by_stmt.set(i, nd)
                made.push(nd)
            }
        }
        self.decl_ids.set(f.index, by_stmt)
        self.file_decls.set(f.index, made)
        self.range_bodies(f, store, main)
        out
    }

    /// Every declaration's expression range: each expression belongs
    /// to the INNERMOST declaration whose span holds it; the rest —
    /// the run-time statements' — belong to Main.
    fn range_bodies(f: FileId, store: NodeStore, main: DeclId) {
        let owners = self.owner_spans(f)
        // -1 until a first expression lands: an ownerless decl's
        // range is the empty 0..0
        mut lo: List<int> = filled(self.decls.length, 0 - 1)
        mut hi: List<int> = filled(self.decls.length, 0)
        // A SYNTHESIZED NODE HAS NO SPAN, AND A RANGE THAT SKIPS IT
        // STOPS SHORT OF IT. A desugaring is minted where it is used,
        // so source order is ownership order: a span-less expression
        // belongs to whoever owned the one before it. Skipping them
        // left a range-headed `for` — whose condition and step are
        // minted span-less — reaching PAST its own declaration's
        // window, and `type_at` trapped instead of answering. A fn
        // hid it, because its body is a block expression allocated
        // after them and its span carries the range over.
        mut owner = main
        for i in 0..store.exprs.count() {
            let sp: Span? = store.expr_span(ExprId { index: i })
            if sp != null { owner = self.innermost(owners, sp!) ?? main }
            if lo[owner.index] < 0 { lo.set(owner.index, i) }
            hi.set(owner.index, i + 1)
        }
        for d in [o.d for o in owners].concat([main]) {
            let i = d.index
            self.decls.set(i, self.decl(d) with { lo: started_at(lo[i]), hi: hi[i] })
        }
    }

    /// This file's declarations, every kind, in the order admitted:
    /// each top-level one with its members, then Main, then the
    /// nested ones.
    fn decls_of_file(f: FileId) -> List<DeclId> { self.file_decls[f.index] }

    /// A declaration whose body owns its expressions: not Main (it
    /// takes the rest), not nested (its enclosing body walks it).
    fn owns_a_range(d: DeclId) -> bool {
        let x = self.decl(d)
        !(x.kind is .Main) && !x.nested && self.decl_span(d) != null
    }

    /// The source a declaration occupies: its statement's span — a
    /// default's, the default expression's alone.
    fn decl_span(d: DeclId) -> Span? {
        let x = self.decl(d)
        if x.kind is .Builtin { return null }
        if x.kind is .Default || x.kind is .Case { return self.store(d).expr_span(x.root!) }
        self.store(d).stmt_span(x.stmt)
    }

    /// The smallest owner span holding `sp`, or absence. The spans
    /// were read ONCE per file: this runs per expression, and a
    /// store lookup per (expression, owner) pair was the parse's
    /// hottest frame.
    fn innermost(owners: List<OwnerSpan>, sp: Span) -> DeclId? {
        // LICENSED I4: a min-scan keeps the SMALLEST holder, not a membership
        mut best: DeclId? = null
        mut best_size = 0 - 1
        for o in owners {
            if o.lo <= sp.lo && sp.hi <= o.hi && (best_size < 0 || o.hi - o.lo < best_size) {
                best = o.d
                best_size = o.hi - o.lo
            }
        }
        best
    }

    /// Every range-owning declaration of a file with its span, read
    /// once — every owner has one (`owns_a_range` said so).
    fn owner_spans(f: FileId) -> List<OwnerSpan> {
        [self.owner_span(d) for d in self.decls_of_file(f) if self.owns_a_range(d)]
    }

    fn owner_span(d: DeclId) -> OwnerSpan {
        let sp: Span = self.decl_span(d)!
        OwnerSpan { d: d, lo: sp.lo, hi: sp.hi }
    }

    /// A trait's method has no body to lower; an impl's does.
    fn mint_method(owner_key: string, f: FileId, store: NodeStore, m: StmtId, owner: string, parent: DeclId, root: ExprId?) -> DeclId {
        let name = store.fn_parts(m)?.name ?? ""
        self.mint("${owner_key}#${name}", f, m, name, DeclKind.Method, false, owner, parent, false, root)
    }

    /// A field's default: a body under the record, named by the
    /// field, its statement the record's.
    fn mint_default(owner_key: string, f: FileId, s: StmtId, field: Param, owner: string, parent: DeclId) -> DeclId {
        self.mint("${owner_key}#${field.name}", f, s, field.name.of, DeclKind.Default, false, owner, parent, false, field.default)
    }

    /// A parent admitted again lists its members afresh.
    fn orphan(parent: DeclId) {
        self.children.set(parent.index, [])
    }

    /// An id for a key: the existing one (its row refreshed), or the
    /// next; a member joins its parent's children.
    fn mint(key: string, f: FileId, s: StmtId, name: string, kind: DeclKind, exported: bool, owner: string, parent: DeclId?, nested: bool, root: ExprId?) -> DeclId {
        // the read of `keys` ends with `known_id`'s scope, so the write
        // below finds the map unshared — held to this scope's end, it
        // cloned the map per declaration, a tenth of every compile
        let known: DeclId? = self.known_id(key)
        let id: DeclId = if known == null { DeclId { index: self.decls.length } } else { known! }
        let d = Decl { id: id, file: f, stmt: s, name: name, kind: kind, exported: exported, owner: owner, parent: parent, nested: nested, root: root, lo: 0, hi: 0 }
        if known == null {
            self.decls.push(d)
            self.keys.set(key, id)
            self.sigs.push(null)
            self.provenance.push(null)
            self.marks.push(null)
            self.targets.push(null)
            self.seat_marks.push([])
            self.declared_writes.push(false)
            self.written_seats.push([])
            self.children.push([])
            self.methods.push([])
            self.impls.push([])
            if kind is .Impl { self.note_impl(name, id) }
        } else {
            self.decls.set(id.index, d)
        }
        if parent != null {
            mut members = self.children[parent!.index]
            members.push(id)
            self.children.set(parent!.index, members)
        }
        id
    }

    /// The id a key already names — asked in its own scope, so the
    /// table's reference dies before the caller writes.
    fn known_id(key: string) -> DeclId? {
        let held: DeclId? = self.keys.get(key)
        held
    }

    // ── generated source, parsed and admitted ──

    /// Generated SOURCE admitted beside the declaration that asked for
    /// it: the code was parsed INTO this file's store (no copy), so the
    /// declarations mint from the same arena every pass already reads.
    fn mint_generated_code(f: FileId, store: NodeStore, stmts: List<StmtId>, lo: int, tag: string, ann: string, at: Span?) -> List<DeclId> {
        // each statement keys under its place, so two impls of one
        // target in one generation mint two
        let made = flatten([self.mint_code_stmt(f, store, s, "${tag}$${j}", ann, at, lo) for j, s in stmts])
        self.record_generated(f, made)
        made
    }

    /// One generated statement: its declaration and members, or its
    /// impl block and methods.
    fn mint_code_stmt(f: FileId, store: NodeStore, s: StmtId, tag: string, ann: string, at: Span?, lo: int) -> List<DeclId> {
        let kind: DeclKind? = store.declared_kind(s)
        if kind != null { return self.mint_code_decl(f, store, s, kind!, tag, ann, at, lo) }
        if store.const_value(s) != null { return [self.mint_code_const(f, store, s, tag, ann, at, lo)] }
        let ip: ImplParts? = store.impl_parts(s)
        if ip != null { return self.mint_code_impl(f, store, s, ip!, tag, ann, at, lo) }
        []
    }

    /// A generated top-level `const`: a declaration like a written one,
    /// wearing the range of its own value.
    fn mint_code_const(f: FileId, store: NodeStore, s: StmtId, tag: string, ann: string, at: Span?, lo: int) -> DeclId {
        let name = store.let_name(s) ?? ""
        let d = self.mint(generated_key(f, "${tag}$${name}"), f, s, name, DeclKind.Const, false, "", null, false, null)
        self.note_provenance(d, ann, name, at)
        self.decls.set(d.index, self.decl(d) with { lo: lo, hi: store.const_value(s)!.index + 1 })
        d
    }

    /// A generated declaration, under the key no written name can take,
    /// with its trait members beside it. EVERY generated declaration
    /// wears its OWN expression range, not the block's: its body is the
    /// last node of a contiguous subtree (children mint before their
    /// owner), so the range runs from the previous sibling's end to its
    /// own body — exactly the window `range_bodies` gives a written
    /// impl's methods, and the range whose absence left a generated
    /// pattern without its enum.
    fn mint_code_decl(f: FileId, store: NodeStore, s: StmtId, kind: DeclKind, tag: string, ann: string, at: Span?, lo: int) -> List<DeclId> {
        let name = store.declared_name(s) ?? ""
        let key = generated_key(f, "${tag}$${name}")
        let body: ExprId? = store.fn_parts(s)?.body
        let d = self.mint(key, f, s, name, kind, false, "", null, false, body)
        self.note_provenance(d, ann, name, at)
        let fns: List<StmtId> = store.trait_parts(s)?.fns ?? []
        mut cursor = lo
        mut members: List<DeclId> = []
        for m in fns {
            let mb: ExprId? = declared_body(store, m)
            let hi: int = if mb == null { cursor } else { mb!.index + 1 }
            let md = self.mint_method(key, f, store, m, name, d, mb)
            self.decls.set(md.index, self.decl(md) with { lo: cursor, hi: hi })
            members.push(md)
            cursor = hi
        }
        let own_hi: int = if body == null { cursor } else { body!.index + 1 }
        self.decls.set(d.index, self.decl(d) with { lo: lo, hi: own_hi })
        [d].concat(members)
    }

    /// A generated impl block, with its methods under it, each wearing
    /// its own expression range (see `mint_code_decl`).
    fn mint_code_impl(f: FileId, store: NodeStore, s: StmtId, block: ImplParts, tag: string, ann: string, at: Span?, lo: int) -> List<DeclId> {
        let key = generated_key(f, "${tag}$${block.target}$$impl")
        let block_decl = self.mint(key, f, s, block.target, DeclKind.Impl, false, "", null, false, null)
        self.note_provenance(block_decl, ann, block.target, at)
        mut cursor = lo
        mut methods: List<DeclId> = []
        for m in block.fns {
            let mb: ExprId? = store.fn_parts(m)?.body
            let hi: int = if mb == null { cursor } else { mb!.index + 1 }
            let md = self.mint_method(key, f, store, m, block.target, block_decl, mb)
            self.decls.set(md.index, self.decl(md) with { lo: cursor, hi: hi })
            methods.push(md)
            cursor = hi
        }
        self.decls.set(block_decl.index, self.decl(block_decl) with { lo: lo, hi: cursor })
        [block_decl].concat(methods)
    }

    /// A generated declaration joins the file's LIST and its statement
    /// table, so `items`, the namespace, resolve and lowering read it
    /// as written. The statement table is grown to the arena first —
    /// `decl_of` reads it by statement, and a miss reads past its end.
    fn record_generated(f: FileId, made: List<DeclId>) {
        mut by_stmt = self.decl_ids[f.index]
        by_stmt.grow_to(self.store_of(f).stmts.count())
        for d in made { by_stmt.set(self.decl(d).stmt.index, d) }
        self.decl_ids.set(f.index, by_stmt)
        self.file_decls.set(f.index, self.file_decls[f.index].concat(made))
    }

    /// A GENERATED declaration — an annotation's traced twin — minted
    /// into its file's store and decl table under a key no WRITTEN
    /// name can take. The body is the wrap: the original's own call,
    /// bound and answered. The twin carries the original's type
    /// parameters and parameter seats, so it answers like the original,
    /// and its own expression range, so typing, resolution and lowering
    /// read it as written.
    fn mint_generated(f: FileId, name: string, tparams: List<Param>, params: List<Param>, ret: TypeRef, original: string, ann: string, at: Span?) -> DeclId {
        let key = generated_key(f, name)
        let known: DeclId? = self.known_id(key)
        if known != null { return known! }
        mut store = self.store_of(f)
        // THE GENERATED RANGE's LO: the arena's edge BEFORE any of the
        // twin's nodes mint — its subtree is allocated first (children
        // before the block that holds them), then the FnDecl stmt.
        let lo = store.exprs.count()
        // THE WRAP: let v = original(args); v — the twin answers the
        // original's call. The temp's name carries the twin's own
        // mark, which no WRITTEN binding can collide with. (The enter
        // / exit puts wrap is a later directive; v1 proves the seam.)
        let v = "${name}$$v"
        let arg_ids = [store.alloc_expr(Expr.Ident(p.name), at) for p in params]
        let call = store.alloc_expr(Expr.Call(Scoped(original), [], arg_ids), at)
        let bound = store.alloc_expr(Expr.Ident(Scoped(v)), at)
        let l2 = store.alloc_stmt(Stmt.Let(Scoped(v), null, call), at)
        let body = store.alloc_expr(Expr.Block([l2], bound), at)
        let s = store.alloc_stmt(Stmt.FnDecl(Scoped(name), tparams, params, ret, body), at)
        let d = self.mint(key, f, s, name, DeclKind.Fn, false, "", null, false, body)
        // THE GENERATED RANGE: the twin's own nodes, minted last, so
        // its body's exprs sit at the arena's end — lo its first, hi
        // the arena's edge (nothing after it is another's). Typing,
        // resolution and lowering read it exactly as a written fn.
        let hi = store.exprs.count()
        self.decls.set(d.index, self.decl(d) with { lo: lo, hi: hi })
        self.record_generated(f, [d])
        self.note_provenance(d, ann, original, at)
        d
    }

    // ── declarations ──

    fn decl(d: DeclId) -> Decl { self.decls[d.index] }

    /// A generated declaration's origin, or null for a written one.
    fn provenance_of(d: DeclId) -> Provenance? { self.provenance[d.index] }

    /// Record a generated declaration's origin: who asked, what it
    /// wraps or names, and where.
    fn note_provenance(d: DeclId, ann: string, original: string, at: Span?) {
        self.provenance.set(d.index, Provenance { ann: ann, original: original, at: at })
    }

    /// The template a generated declaration was copied from — the
    /// quote's file and offset — beside who asked.
    fn note_template(d: DeclId, template: Loc?) {
        let held: Provenance? = self.provenance[d.index]
        if held == null { return }
        self.provenance.set(d.index, held! with { template: template })
    }

    /// One more generation admitted to a file.
    fn note_generation(f: FileId, g: Generation) {
        self.generations.set(f.index, self.generations[f.index].concat([g]))
    }

    /// Nodes copied from a template: each wears the file that wrote it.
    fn note_origins(f: FileId, exprs: List<ExprId>, stmts: List<StmtId>, pats: List<PatId>, origin: FileId) {
        mut known = self.origins[f.index]
        let wrote = Origin.Written(origin)
        for e in exprs { known.exprs = known.set_at(known.exprs, e.index, wrote) }
        for s in stmts { known.stmts = known.set_at(known.stmts, s.index, wrote) }
        for p in pats { known.pats = known.set_at(known.pats, p.index, wrote) }
        self.origins.set(f.index, known)
    }

    /// The file a generated node was WRITTEN in, when it is another
    /// than the node's own.
    fn origin_of_expr(f: FileId, e: ExprId) -> FileId? { self.origins[f.index].at(self.origins[f.index].exprs, e.index) }
    fn origin_of_stmt(f: FileId, s: StmtId) -> FileId? { self.origins[f.index].at(self.origins[f.index].stmts, s.index) }
    fn origin_of_pat(f: FileId, p: PatId) -> FileId? { self.origins[f.index].at(self.origins[f.index].pats, p.index) }

    /// What a file's expansion refused, kept for its resolve to speak.
    fn speak_expansion(f: FileId, ds: List<Diag>) {
        self.expansion_voices.set(f.index, self.expansion_voices[f.index].concat(ds))
    }

    /// A file's expansion begins with nothing refused.
    fn hush_expansion(f: FileId) {
        self.expansion_voices.set(f.index, [])
    }

    /// The generation a file's node came from — null for a written one.
    fn generation_of(f: FileId, e: ExprId) -> Generation? {
        self.generations[f.index].find(it.exprs.lo <= e.index && e.index < it.exprs.hi)
    }

    fn generation_of_stmt(f: FileId, s: StmtId) -> Generation? {
        self.generations[f.index].find(it.stmts.lo <= s.index && s.index < it.stmts.hi)
    }

    fn generation_of_pat(f: FileId, p: PatId) -> Generation? {
        self.generations[f.index].find(it.pats.lo <= p.index && p.index < it.pats.hi)
    }

    /// The declaration a statement of a file makes, when it does.
    fn decl_of(f: FileId, s: StmtId) -> DeclId? { self.decl_ids[f.index].get(s.index) }

    fn store(d: DeclId) -> NodeStore { self.store_of(self.decl(d).file) }

    fn module_of(d: DeclId) -> string { self.module_name(self.file(self.decl(d).file).module_id) }
    /// A declaration's package — its module's, by `package_named`.
    fn package_of(d: DeclId) -> string { self.package_named(self.module_of(d)) }

    /// A module's package in the DOTTED spelling every package read
    /// compares (`@std.meta`): the prefix a dependency's module carries,
    /// or the root's manifest name for a root module, which none
    /// prefixes — "" for a lone file, which has no package.
    fn package_named(module: string) -> string {
        let named = package_of_module(module)
        if named.is_empty() { self.root_name[0] } else { named }
    }

    /// The root package's manifest name, kept in the dotted spelling.
    fn name_root(name: string) { self.root_name.set(0, name.replace("/", ".")) }

    /// Whether a meta value CARRIES A NAME — a declaration's, a
    /// field's, a variant's, a parameter's — which is what a quote's
    /// hole splices of it.
    fn meta_names_one(ty: TypeId) -> bool {
        self.takes_a_decl(ty) || self.meta_type(ty, "Field") || self.meta_type(ty, "Variant") || self.meta_type(ty, "Param")
    }

    /// A declaration of `@std/meta` by name — the compiler's own door
    /// to the meta vocabulary (`Node`, `template`, `as_decls`); null
    /// when the program does not load the package.
    fn meta_named(name: string) -> DeclId? {
        self.package_decl("@std.meta", name)
    }

    /// A declaration a PACKAGE exports, by name — the door to a
    /// vocabulary the compiler shares with the programs it compiles;
    /// null when the program does not load the package.
    fn package_decl(pkg: string, name: string) -> DeclId? {
        let key = "${pkg}.${name}"
        let known: DeclId? = self.meta_ids.get(key)
        if known != null { return known }
        let ms = [ModuleId { index: j } for j, m in self.modules if package_of_module(m) == pkg]
        if ms.is_empty() { return null }
        let ds: List<DeclId> = flatten([self.file_decls[f.index] for f in self.module_files[ms[0].index]])
        let found: DeclId? = ds.find((d: DeclId) -> self.decl(d).name == name)
        if found != null { self.meta_ids.set(key, found!) }
        found
    }

    /// Whether a type is one declaration exported by `@std/meta`.
    /// The DeclId is the identity; the package and export name locate
    /// that identity without accepting an equal-shaped user record.
    fn meta_type(ty: TypeId, name: string) -> bool {
        match self.types.shape_of(ty) {
            // THE DECLARATION'S name, never the WRITTEN spelling: a
            // `use @std.meta.{Fn as F}` gives the type the alias in its
            // written name, and the boundary must still read `Fn`.
            .Struct(d, _) -> self.decl(d).name == name && self.package_of(d) == "@std.meta",
            rest -> false,
        }
    }

    /// A declaration's signature — asking it IS the query: the hook
    /// the workspace arms computes it on first ask and records the
    /// dependency; the table only holds.
    fn sig(d: DeclId) -> DeclSig? {
        let ensure = self.ensure[0]
        ensure(d)
        let held: DeclSig? = self.sigs[d.index]
        held
    }

    /// The hooks capture the workspace that holds this table — a
    /// cycle counting never frees. A one-shot workspace disarms them
    /// once every declaration it will ever ask about is signed; a
    /// sig asked after that is held or, loudly, absent.
    fn disarm() {
        self.ensure.set(0, no_ensure)
        self.ensure_const.set(0, no_const_ensure)
        self.ensure_methods.set(0, no_ensure)
        self.ensure_writes.set(0, no_ensure)
        self.ensure_marks.set(0, no_marks)
        self.lifter.set(0, no_lifter)
    }

    /// The workspace arms the sig hook once.
    fn arm(ensure: fn(DeclId)) {
        self.ensure.set(0, ensure)
    }

    fn arm_const(ensure: fn(FileId, StmtId) -> bool) { self.ensure_const.set(0, ensure) }

    fn const_type(f: FileId, s: StmtId) -> ConstType {
        let ensure = self.ensure_const[0]
        if ensure(f, s) { return ConstType.Cyclic }
        let held: TypeId? = self.held_const_type(f, s)
        if held == null { return ConstType.Refused }
        ConstType.Known(held!)
    }

    fn held_const_type(f: FileId, s: StmtId) -> TypeId? { self.const_types.get(const_type_key(f, s)) }

    fn record_const_type(f: FileId, s: StmtId, ty: TypeId) {
        self.const_types.set(const_type_key(f, s), ty)
    }

    /// The workspace arms the lifting hook once.
    fn arm_lifter(lift: fn(DeclId, FileId, StmtId, ExprId, List<ExprId>) -> Result<Lifted, Unsettled>) {
        self.lifter.set(0, lift)
    }

    /// The workspace arms the marks hook once — a declaration's
    /// use-site warnings are a query of the program, never a table
    /// an earlier walk happened to fill.
    fn arm_marks(ensure: fn(DeclId)) {
        self.ensure_marks.set(0, ensure)
    }

    /// A declaration's warnings, asked at a use. Asking IS the
    /// computation; the table only holds.
    fn marks(d: DeclId) -> List<Diagnostic> {
        let ensure = self.ensure_marks[0]
        ensure(d)
        let held: List<Diagnostic>? = self.marks[d.index]
        held ?? []
    }

    fn record_marks(d: DeclId, xs: List<Diagnostic>) {
        self.marks.set(d.index, xs)
    }

    /// An annotation fn `d` run over the declaration at `s` in file
    /// `f`, with these settled arguments — asking IS the run.
    fn lifted(d: DeclId, f: FileId, s: StmtId, call: ExprId, args: List<ExprId>) -> Result<Lifted, Unsettled> {
        let lift = self.lifter[0]
        lift(d, f, s, call, args)
    }

    /// A list type's element, or null for any other shape.
    fn elem_of(ty: TypeId) -> TypeId? {
        match self.types.shape_of(ty) {
            .List(e) -> e,
            _ -> null,
        }
    }

    fn declare(d: DeclId, sig: DeclSig) {
        self.sigs.set(d.index, sig)
    }

    fn tparams(d: DeclId) -> List<string> {
        let x = self.decl(d)
        if x.kind is .Builtin { return builtin_tparams(self.row_of(d)!.arity) }
        if x.kind is .Impl { return self.target_tparams(d) }
        // A TRAIT DECLARES ONE TYPE PARAMETER, `Self` — its
        // implementor — and its members wear it: a default body is
        // a generic method over `Self`, lowered per signatory.
        if x.kind is .Trait { return [self_word] }
        self.store(d).decl_tparams(x.stmt)
    }

    /// An impl block's type parameters are its TARGET's — a method
    /// under `impl Arena<N>` instantiates with `Arena`'s Vars.
    fn target_tparams(impl_decl: DeclId) -> List<string> {
        let t: DeclId? = self.target_of(impl_decl)
        if t == null { return [] }
        self.tparams(t!)
    }

    // ── the inout seats ──

    /// A declaration's seat CONTRACTS, as declared — a method's seat
    /// 0 is its receiver and is never declared here. The written bits
    /// take the same shape, all false until the pass runs.
    fn record_seats(d: DeclId, marks: List<SeatMark>) {
        self.seat_marks.set(d.index, marks)
        self.written_seats.set(d.index, filled(marks.length, false))
    }

    /// How many seats a declaration has — the receiver's included.
    fn seat_count(d: DeclId) -> int { self.seat_marks[d.index].length }

    /// Asking IS the query: the sig hook declares `d` first, so a
    /// callee named before its own declaration answers truly.
    /// A declaration's seats' marks, sized to its seats — the
    /// contract a fn VALUE of it carries.
    fn marks_of(d: DeclId, n: int) -> List<SeatMark> {
        mut out: List<SeatMark> = []
        mut j = 0
        while j < n {
            out.push(self.seat_mark(d, j))
            j = j + 1
        }
        out
    }

    fn seat_mark(d: DeclId, i: int) -> SeatMark {
        let ensure = self.ensure[0]
        ensure(d)
        mark_at(self.seat_marks[d.index], i)
    }

    /// `mut fn` — the method (or trait sig) declared its receiver
    /// written.
    fn record_declared_writing(d: DeclId) {
        self.declared_writes.set(d.index, true)
    }

    fn declares_writing(d: DeclId) -> bool {
        let ensure = self.ensure[0]
        ensure(d)
        self.declared_writes[d.index]
    }

    /// The seats pass found the body writing through seat `i`.
    fn record_seat_written(d: DeclId, i: int) {
        mut row = self.written_seats[d.index]
        if i < row.length { row.set(i, true) }
        self.written_seats.set(d.index, row)
    }

    /// The pass's own reads — hook-free, as the table stands.
    fn seat_written_so_far(d: DeclId, i: int) -> bool {
        let row = self.written_seats[d.index]
        i < row.length && row[i]
    }

    /// Whether seat `i` is written, declared or found: a method's
    /// receiver by its word, any seat by the pass.
    fn seat_writes_so_far(d: DeclId, i: int) -> bool {
        (i == 0 && self.declared_writes[d.index]) || self.seat_written_so_far(d, i)
    }

    /// The receiver's inferred bit — seat 0 of a method.
    fn written_so_far(d: DeclId) -> bool { self.seat_written_so_far(d, 0) }

    fn writes_so_far(d: DeclId) -> bool { self.seat_writes_so_far(d, 0) }

    /// The pass starts over: every inferred bit falls, and the
    /// fixpoint re-earns them.
    fn clear_written() {
        mut j = 0
        while j < self.written_seats.length {
            self.written_seats.set(j, filled(self.written_seats[j].length, false))
            j = j + 1
        }
    }

    /// Whether a method WRITES its receiver: declared, or found by
    /// the receivers pass — asking IS the query; the hook runs the
    /// pass and records the dependency.
    fn writes_receiver(d: DeclId) -> bool {
        let ensure = self.ensure_writes[0]
        ensure(d)
        self.seat_writes_so_far(d, 0)
    }

    /// Whether the body writes through seat `i` — asking runs the
    /// pass; the declared `mut` is what the caller's law reads.
    fn seat_written(d: DeclId, i: int) -> bool {
        let ensure = self.ensure_writes[0]
        ensure(d)
        self.seat_written_so_far(d, i)
    }

    /// The workspace arms the receivers hook once.
    fn arm_writes(ensure: fn(DeclId)) {
        self.ensure_writes.set(0, ensure)
    }

    fn record_target(impl_decl: DeclId, target: DeclId) {
        self.targets.set(impl_decl.index, target)
    }

    fn target_of(impl_decl: DeclId) -> DeclId? {
        let held: DeclId? = self.targets[impl_decl.index]
        held
    }

    fn tbounds(d: DeclId) -> List<Param> {
        let x = self.decl(d)
        if x.kind is .Builtin { return [] }
        // `Self` is bounded by the trait itself: inside a default,
        // `self` answers the trait's own members
        if x.kind is .Trait { return [Param { name: Scoped(self_word), ty: named_ref(x.name), default: null, mark: plain_mark, span: null }] }
        self.store(d).decl_tbounds(x.stmt)
    }

    fn is_trait(d: DeclId) -> bool { self.decl(d).kind is .Trait }

    fn is_enum(d: DeclId) -> bool { self.decl(d).kind is .Enum }

    fn is_named(d: DeclId) -> bool { self.decl(d).kind is .Named }

    /// The language's own type declarations, minted once from the
    /// type rows. Enum rows also declare their variants; structural
    /// rows still need a value-level name for static vocabulary.
    fn admit_builtins() {
        for r in self.rows { self.admit_builtin(r) }
    }

    fn admit_builtin(r: TypeRow) {
        let id = self.mint("builtin::${r.name}", FileId { index: 0 }, no_stmt, r.name, DeclKind.Builtin, true, "", null, false, null)
        self.builtins.push(id)
        self.declare_builtin(id, r)
    }

    /// A builtin's signature: its variants over its own Vars — the
    /// ordinal is the identity, `T1`, `T2`, … the wording.
    fn declare_builtin(d: DeclId, r: TypeRow) {
        let vars = TypeArgs { parts: [self.types.intern(Type.Var(d, j, n)) for j, n in builtin_tparams(r.arity)] }
        let sig: EnumSig? = r.variants(vars)
        if sig != null { self.declare(d, DeclSig.Enum(sig!)) }
    }

    fn builtin_decls() -> List<DeclId> { self.builtins }

    /// A builtin's row — the parts a store would hold for a
    /// statement; a declaration a program wrote has none.
    fn row_of(d: DeclId) -> TypeRow? {
        let x = self.decl(d)
        if !(x.kind is .Builtin) { return null }
        self.rows.find(it.name == x.name)
    }

    /// Whether a fn is the HOST's — declared `extern`, called by its
    /// bare symbol, never lowered.
    fn is_extern(d: DeclId) -> bool {
        let x = self.decl(d)
        x.kind is .Fn && self.store(d).extern_parts(x.stmt) != null
    }

    /// A type's name — records and enums.
    fn type_name(d: DeclId) -> string? {
        let x = self.decl(d)
        match x.kind {
            .Record or .Named or .Enum -> x.name,
            .Builtin -> x.name,
            .Fn or .Trait or .Syntax or .Method or .Default or .Impl or .Main or .Case or .Const -> null,
        }
    }

    /// A fn's name — free fns and methods.
    fn fn_name(d: DeclId) -> string? {
        let x = self.decl(d)
        match x.kind {
            .Fn or .Method -> x.name,
            .Record or .Named or .Enum or .Trait or .Syntax or .Default or .Impl or .Main or .Case or .Builtin or .Const -> null,
        }
    }

    /// Whether a declaration has a body to type and lower.
    fn has_body(d: DeclId) -> bool { self.decl(d).root != null }

    /// A declaration's members, in declaration order: a trait's or
    /// impl's methods, a record's defaults.
    fn children_of(d: DeclId) -> List<DeclId> { self.children[d.index] }

    /// An impl block filed under the name it targets.
    fn note_impl(name: string, id: DeclId) {
        mut under = self.impls_by_name.get(name) ?? []
        under.push(id)
        self.impls_by_name.set(name, under)
    }

    /// Every impl block naming a type by this name, in mint order.
    fn impls_named(name: string) -> List<DeclId> {
        self.impls_by_name.get(name) ?? []
    }

    /// A record field's default, when the field declares one.
    fn default_named(record: DeclId, field: string) -> DeclId? {
        // LICENSED I4: `it` binds to the NEAREST call, so a self-method predicate is F2033 — the scan is spelled
        for c in self.children_of(record) {
            if self.decl(c).name == field { return c }
        }
        null
    }

    /// Where a declaration is — a generated one homed at the template
    /// that wrote it, or at the annotation that asked.
    fn loc(d: DeclId) -> Loc? {
        let x = self.decl(d)
        self.homed(x.file, self.origin_of_stmt(x.file, x.stmt), self.generation_of_stmt(x.file, x.stmt), self.decl_span(d))
    }

    /// A span of a file homed. A copied template node keeps the span
    /// it was written with, so its place is that span in its origin
    /// file; a generated node of this file's own text is at its span
    /// here; a node minted with no span is at the annotation that
    /// asked for it.
    fn homed(f: FileId, origin: FileId?, g: Generation?, sp: Span?) -> Loc? {
        if origin != null && sp != null { return loc_at(self.file(origin!).path, sp) }
        if g == null || sp != null { return loc_at(self.file(f).path, sp) }
        loc_at(self.file(f).path, g!.at)
    }

    /// THE symbol a declaration lowers to — its name under its
    /// module; a member's under its type's name first. Every symbol
    /// a body or a call site carries comes from here.
    fn symbol(d: DeclId) -> string {
        let x = self.decl(d)
        if self.is_extern(d) { return x.name }
        let local_name = match x.kind {
            .Method or .Default -> "${x.owner}.${x.name}",
            .Case -> "spec$${x.id.index}",
            .Fn or .Const or .Record or .Named or .Enum or .Trait or .Syntax or .Impl or .Main or .Builtin -> x.name,
        }
        module_symbol(self.module_of(d), local_name)
    }

    /// THE symbol a LIFTED body lowers to. A lambda has no name of
    /// its own, so it takes its FILE's — module and stem — and the
    /// node that wrote it: program-unique, as every body's symbol
    /// must be (a node id is unique in its file alone).
    fn lifted_symbol(f: FileId, e: ExprId) -> string {
        let info = self.file(f)
        module_symbol(self.module_name(info.module_id), "${stem_of(info.path)}$l${e.index}")
    }

    // ── traits and methods ──

    /// A trait's method declarations, in declaration order.
    fn trait_fns(d: DeclId) -> List<DeclId> {
        let x = self.decl(d)
        let fns: List<StmtId> = self.store(d).trait_parts(x.stmt)?.fns ?? []
        mut out: List<DeclId> = []
        for f in fns {
            let m: DeclId? = self.decl_of(x.file, f)
            if m != null { out.push(m!) }
        }
        out
    }

    /// A trait's method names — the vtable's order.
    fn trait_method_names(d: DeclId) -> List<string> {
        [self.decl(m).name for m in self.trait_fns(d)]
    }

    /// A trait's associated `derive` member, or none — the ONE name
    /// the compiler runs for `@derive`.
    fn trait_derive(d: DeclId) -> DeclId? {
        self.trait_fns(d).find((m: DeclId) -> self.fn_name(m) == "derive")
    }

    /// A type's method by name — asking IS the query: the hook fills
    /// the type's table from every impl that names it, and the ask
    /// records the dependency.
    fn method(target: DeclId, name: string) -> DeclId? {
        let ensure = self.ensure_methods[0]
        ensure(target)
        self.held_method(target, name) ?? self.defaulted(target, name)
    }

    /// A method the type never wrote: the DEFAULT of a trait it
    /// implements, when that trait's member carries a body.
    fn defaulted(target: DeclId, name: string) -> DeclId? {
        // LICENSED I4: `it` binds to the NEAREST call, so a self-method predicate is F2033 — the scan is spelled
        for tr in self.impls[target.index] {
            let m: DeclId? = self.default_member(tr, name)
            if m != null { return m }
        }
        null
    }

    /// A trait's member by name, when it is a default.
    fn default_member(tr: DeclId, name: string) -> DeclId? {
        // LICENSED I4: `it` binds to the NEAREST call, so a self-method predicate is F2033 — the scan is spelled
        for m in self.trait_fns(tr) {
            if self.decl(m).name == name && self.has_body(m) { return m }
        }
        null
    }

    /// The table as it stands — the registering side's own read.
    fn held_method(target: DeclId, name: string) -> DeclId? {
        // LICENSED I4: `it` binds to the NEAREST call, so a self-method predicate is F2033 — the scan is spelled
        for m in self.methods_of(target) {
            if self.decl(m).name == name { return m }
        }
        null
    }

    /// A type's registered methods, as they stand — the hook-free read.
    fn methods_of(target: DeclId) -> List<DeclId> { self.methods[target.index] }

    /// The workspace arms the method-table hook once.
    fn arm_methods(ensure: fn(DeclId)) {
        self.ensure_methods.set(0, ensure)
    }

    /// A method registered under its type — the same declaration
    /// again (a recomputed sig) is the same entry.
    fn declare_method(target: DeclId, m: DeclId) {
        let prior: DeclId? = self.held_method(target, self.decl(m).name)
        if prior != null && same_decl(prior!, m) { return }
        mut ms = self.methods[target.index]
        ms.push(m)
        self.methods.set(target.index, ms)
    }

    fn record_impl(ty: DeclId, tr: DeclId) {
        if self.holds_impl(ty, tr) { return }
        mut ts = self.impls[ty.index]
        ts.push(tr)
        self.impls.set(ty.index, ts)
    }

    /// Whether a type implements a trait — asked through the hook,
    /// like a method.
    fn implements(ty: DeclId, tr: DeclId) -> bool {
        let ensure = self.ensure_methods[0]
        ensure(ty)
        self.holds_impl(ty, tr)
    }

    fn holds_impl(ty: DeclId, tr: DeclId) -> bool {
        self.impls[ty.index].any(same_decl(it, tr))
    }
}

/// A key seen already in this admit is a repeated declaration: the
/// repeat is keyed by its statement, so it stays a declaration of
/// its own for the namespace law to refuse.
fn fresh_key(key: string, s: StmtId, seen: List<string>) -> string {
    if seen.contains(key) { return "${key}#${s.index}" }
    key
}

/// A range whose first expression never landed starts at zero.
fn started_at(i: int) -> int {
    if i < 0 { 0 } else { i }
}

/// The name a trait gives its implementor — the one type parameter
/// every trait declares.
export const self_word: string = "Self"

/// A member's body, when it wrote one — a sig's is a HOLE no pass
/// walks, and declares nothing to type.
fn declared_body(store: NodeStore, m: StmtId) -> ExprId? {
    let body: ExprId? = store.fn_parts(m)?.body
    if body == null || store.expr(body!) is .Error { return null }
    body
}
