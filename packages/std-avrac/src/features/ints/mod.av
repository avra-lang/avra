//! Int arithmetic asked for by name: `wrapping_*` answers the low 64 bits
//! of the exact answer, `checked_*` answers it or absence when it has no
//! int. A shift's count is 0..63 either way — `wrapping_shl` refuses one
//! outside it as `<<` does, `checked_shl` answers absence.
use features.{LanguageFeature, MethodRow, ReceiverEffect}

export fn ints() -> LanguageFeature {
    let methods = table<MethodRow> {
        name           | takes  | check              | lower              | effect              | answers
        "wrapping_add" | on_int | check_wrapping_add | lower_wrapping_add | ReceiverEffect.Read | int_answer
        "wrapping_sub" | on_int | check_wrapping_sub | lower_wrapping_sub | ReceiverEffect.Read | int_answer
        "wrapping_mul" | on_int | check_wrapping_mul | lower_wrapping_mul | ReceiverEffect.Read | int_answer
        "wrapping_shl" | on_int | check_wrapping_shl | lower_wrapping_shl | ReceiverEffect.Read | int_answer
        "checked_add"  | on_int | check_checked_add  | lower_checked_add  | ReceiverEffect.Read | opt_int_answer
        "checked_sub"  | on_int | check_checked_sub  | lower_checked_sub  | ReceiverEffect.Read | opt_int_answer
        "checked_mul"  | on_int | check_checked_mul  | lower_checked_mul  | ReceiverEffect.Read | opt_int_answer
        "checked_shl"  | on_int | check_checked_shl  | lower_checked_shl  | ReceiverEffect.Read | opt_int_answer
    }
    LanguageFeature ints {
        methods: methods
    }
    ints
}
