// proves: `wrapping_*` answers the low 64 bits and `checked_*` answers
// the exact answer or absence, at every edge — the largest and smallest
// int, a mul by -1, a shift into and past the sign bit, a count past 63.
fn biggest() -> int { 9223372036854775807 }

fn smallest() -> int { 0 - 9223372036854775807 - 1 }

fn shown(n: int?) -> string { if n == null { "none" } else { "${n!}" } }

let wraps = [
    biggest().wrapping_add(1),
    smallest().wrapping_sub(1),
    (1 << 62).wrapping_mul(2),
    1.wrapping_shl(63),
    3.wrapping_add(4),
]
let checks = [
    shown(biggest().checked_add(1)),
    shown(biggest().checked_add(0)),
    shown(smallest().checked_sub(1)),
    shown(smallest().checked_mul(0 - 1)),
    shown((0 - 1).checked_mul(smallest())),
    shown(3037000499.checked_mul(3037000499)),
    shown(3037000500.checked_mul(3037000500)),
    shown(1.checked_shl(62)),
    shown(1.checked_shl(63)),
    shown((0 - 1).checked_shl(63)),
    shown(1.checked_shl(64)),
    shown(1.checked_shl(0 - 1)),
]
"${["${w}" for w in wraps].join(" ")} | ${checks.join(" ")}"
