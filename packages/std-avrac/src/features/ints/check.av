//! Typing: each verb takes one int beside its receiver; `wrapping_*`
//! answers `int`, `checked_*` answers `int?`.
use features.{MethodCall, TypeCx}
use core.{Type, TypeId, TypeRegistry}

fn on_int(t: Type) -> bool { t is .Int }

fn check_wrapping_add(mut cx: TypeCx, mc: MethodCall) -> TypeId { wrapping(cx, mc, "wrapping_add") }
fn check_wrapping_sub(mut cx: TypeCx, mc: MethodCall) -> TypeId { wrapping(cx, mc, "wrapping_sub") }
fn check_wrapping_mul(mut cx: TypeCx, mc: MethodCall) -> TypeId { wrapping(cx, mc, "wrapping_mul") }
fn check_wrapping_shl(mut cx: TypeCx, mc: MethodCall) -> TypeId { wrapping(cx, mc, "wrapping_shl") }
fn check_checked_add(mut cx: TypeCx, mc: MethodCall) -> TypeId { checked(cx, mc, "checked_add") }
fn check_checked_sub(mut cx: TypeCx, mc: MethodCall) -> TypeId { checked(cx, mc, "checked_sub") }
fn check_checked_mul(mut cx: TypeCx, mc: MethodCall) -> TypeId { checked(cx, mc, "checked_mul") }
fn check_checked_shl(mut cx: TypeCx, mc: MethodCall) -> TypeId { checked(cx, mc, "checked_shl") }

fn wrapping(mut cx: TypeCx, mc: MethodCall, name: string) -> TypeId { cx.worded(mc, name, [Type.Int], Type.Int) }

fn checked(mut cx: TypeCx, mc: MethodCall, name: string) -> TypeId { cx.worded(mc, name, [Type.Int], Type.Opt(cx.view.types.type(int))) }

fn int_answer(types: TypeRegistry, _receiver: TypeId) -> TypeId? { types.type(int) }

fn opt_int_answer(types: TypeRegistry, _receiver: TypeId) -> TypeId? { types.type(int?) }
