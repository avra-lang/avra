//! Parse-time lowering: `provide` builds the `let` it is and marks it
//! a provider; `env` builds the type-keyed read.
use core.{Expr, Stmt, Scoped}
use features.{LangNode, Builder}

fn build_provide(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let t = b.type_ref(1)?
    let v = b.expr(2)?
    let s = b.store.alloc_stmt(Stmt.Let(Scoped(n.text), t, v), b.span)
    b.store.mark_provide(s)
    .Ok(LangNode.NStmt(s))
}

fn build_env(b: Builder) -> Result<LangNode, string> {
    b.make_expr(Expr.Env(b.type_ref(0)?))
}
