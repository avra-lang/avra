//! `env T`'s NodeSemantics: dispatch only. The typing rule is
//! check.av's; lowering reads the register the nearest provider's
//! statement wrote.
use core.{Expr, ExprId, TypeId, Reg, reversed}
use features.{NodeSemantics, TypeCx, LowerCx}

export type EnvSemantics = {}

impl NodeSemantics for EnvSemantics {
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        env_type(cx, e)
    }

    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        env_lower(cx, e)
    }
}

/// The nearest open provider of the read's type, by register — the
/// same scan typing made, over the mirrors lowering recorded, so the
/// two passes agree by construction.
fn env_lower(mut cx: LowerCx, e: ExprId) -> Reg {
    let want = cx.type_at(e)
    // NEAREST WINS: the open list is oldest-first, so the scan reads
    // from the end — the innermost `provide` of this type.
    let hit = reversed(cx.providers).find(it.ty == want)
    if hit == null { return cx.lower_defect(e, "a typed requirement survived typing with no provider to lower") }
    hit!.reg
}
