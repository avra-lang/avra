//! `provide name: T = v` and `ambient T` — TYPED REQUIREMENTS read
//! lexically. `provide` names a value AND makes its type a provider
//! for the rest of its statement list; `ambient T` reads the nearest
//! provider of that type, and a missing one is a compile error, never
//! a runtime lookup. The name is local spelling; THE TYPE IS THE KEY.
//!
//! The read is spelled `ambient`, not the design's `env`: a keyword
//! reserves its word as a name, and `env` is `@std/io`'s fn and
//! `Tool`'s field the tree over, so `env T` would refuse the
//! toolchain's own source.
//!
//! `provide` builds the `let` it is (the binding law, the slot, the
//! scope are the let's) and MARKS the statement a provider, the way
//! `state` marks a `mut let`. `ambient` is its own node: reading a
//! value BY TYPE is not a name read. The `ambient` keyword anchor
//! merges before every NAME-headed primary, like the other keyword
//! primaries.
use features.{LanguageFeature, BuilderRow}
use @std.grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use diagnostics.{DiagCode}

export fn providers() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name           | build
        "provide_stmt" | build_provide
        "ambient_expr" | build_ambient
    }
    let codes = table<DiagCode> {
        kind            | summary
        "type.provider" | "`ambient T` reads the nearest provider of its type — one must stand above it"
    }
    LanguageFeature providers {
        gram: grammar {
            stmt = "provide" n:NAME ":" t:type "=" v:expression END @recover(sync_to: "END") -> provide_stmt(
                n,
                t,
                v,
            )
            primary = "ambient" t:type -> ambient_expr(t)
        }
        diags: codes
        builders: rows
    }
    providers
}
