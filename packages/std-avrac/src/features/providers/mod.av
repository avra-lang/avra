//! `provide name: T = v` and `env T` — TYPED REQUIREMENTS read
//! lexically. `provide` names a value AND makes its type a provider
//! for the rest of its statement list; `env T` reads the nearest
//! provider of that type, and a missing one is a compile error, never
//! a runtime lookup. The name is local spelling; THE TYPE IS THE KEY.
//!
//! Both words are SOFT keywords: the lexer marks `provide` only in
//! `provide NAME :` and `env` only before a written type, so a fn,
//! field or binding spelled `env` — `@std/io`'s and `Tool`'s among
//! them — stays an ordinary name.
//!
//! `provide` builds the `let` it is (the binding law, the slot, the
//! scope are the let's) and MARKS the statement a provider, the way
//! `state` marks a `mut let`. `env` is its own node: reading a
//! value BY TYPE is not a name read. The `env` keyword anchor
//! merges before every NAME-headed primary, like the other keyword
//! primaries.
use features.{LanguageFeature, BuilderRow}
use @std.grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use diagnostics.{DiagCode}

export fn providers() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name           | build
        "provide_stmt" | build_provide
        "env_expr"     | build_env
    }
    let codes = table<DiagCode> {
        kind            | summary
        "type.provider" | "`env T` reads the nearest provider of its type — one must stand above it"
    }
    LanguageFeature providers {
        gram: grammar {
            stmt = w:PROVIDE n:NAME ":" t:type "=" v:expression END @recover(sync_to: "END") -> provide_stmt(
                n,
                t,
                v,
            )
            primary = e:ENV t:type -> env_expr(t)
        }
        diags: codes
        builders: rows
    }
    providers
}
