//! The typing rule: `env T` answers the nearest open provider of
//! type `T`, and REFUSES where none stands — the requirement is met
//! before it runs, never looked up at runtime. The written type
//! resolves as any annotation's does, so it reads a declaration the
//! file can name.
use core.{Expr, ExprId, TypeId}
use features.{TypeCx}
use diagnostics.{refusal}

fn env_type(mut cx: TypeCx, e: ExprId) -> TypeId {
    match cx.view.store.expr(e) {
        .Env(tr) -> {
            let want = cx.written(e, tr)
            if want == cx.error_type { return want }
            let hit = cx.providers.find(it == want)
            if hit != null { return want }
            missing_provider(cx, e, tr.name)
        },
        _ -> cx.error_type,
    }
}

/// The one voice for an unprovided requirement — the law the reader
/// must obey, worded once.
fn missing_provider(mut cx: TypeCx, e: ExprId, name: string) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.provider",
                cx.loc_of(e),
                "no `${name}` is provided above this `env`",
                "`env` reads the nearest provider of its type",
                "add `provide x: ${name} = …` above it",
            ),
        )
}
