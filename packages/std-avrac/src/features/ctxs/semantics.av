//! The shared typer's word on `ctx`: a defect. The program layer checks and builds every `ctx`
//! form before a body is typed, so no typer meets one.
use core.{ExprId, StmtId, TypeId, Reg}
use core.stmt.{CtxDecl, CtxSet}
use core.expr.{CtxRead}
use features.{StmtSemantics, Meaning, ResolveCx, TypeCx, LowerCx}
use diagnostics.{defect_kind, error_at}
use @std.errors.{Loc}

impl StmtSemantics for CtxDecl {
    fn type_stmt(mut cx: TypeCx, s: StmtId) { let _ = refused_here(cx, cx.stmt_loc(s)) }
}

impl StmtSemantics for CtxSet {
    fn type_stmt(mut cx: TypeCx, s: StmtId) { let _ = refused_here(cx, cx.stmt_loc(s)) }
}

impl Meaning for CtxRead {
    fn resolve(mut cx: ResolveCx, e: ExprId) {}
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId { refused_here(cx, cx.loc_of(e)) }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg { cx.lower_defect(e, "a `ctx` read the typer refused was lowered") }
}

/// A `ctx` form met by the shared typer: a defect, never reached. The program layer checks and
/// builds every `ctx` form before a body is typed, so a typer that meets one is the compiler
/// blaming itself.
fn refused_here(mut cx: TypeCx, at: Loc?) -> TypeId { cx.spoken(error_at(defect_kind, at, ctx_typed())) }

/// The defect's words.
fn ctx_typed() -> string {
    "defect: the shared typer met a `ctx` form, which the program layer checks and builds before any body is typed"
}
