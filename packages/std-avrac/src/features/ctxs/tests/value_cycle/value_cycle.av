// proves: fn values that call each other through values — `even` calls the `odd` it is handed,
// which hands itself back — are surveyed once each, as a fixed point over the cycle, so the program
// builds, and the context they read is read where its set is in force, under a guard and a defer
use @std.meta.{contained}

ctx depth: int = 0

fn even(n: int, odd: fn(int) -> int) -> int {
    if n == 0 { ctx.depth } else { odd(n - 1) }
}

fn odd(n: int) -> int {
    if n == 0 { 0 - 1 } else { even(n - 1, odd) }
}

fn deep() -> int {
    defer println("unwound")
    ctx depth = 7
    even(4, odd)
}

match contained(deep) { .Ok(n) -> println("depth ${n}"), .Err(w) -> println("err ${w}") }
