// proves: a call through a fn value runs only a value of its own arity — a declared fn of two seats
// that reads a required context, taken as a value, is no read of a call through a value of one seat
// made where nothing sets it, so the program builds and runs
ctx db: string

fn reads(a: string, b: string) -> string { "${ctx.db}${a}${b}" }

fn shout(s: string) -> string { "${s}!" }

fn applied(f: fn(string) -> string, s: string) -> string { f(s) }

fn joined(f: fn(string, string) -> string) -> string {
    ctx db = "db:"
    f("a", "b")
}

println(applied(shout, "hi"))
println(joined(reads))
