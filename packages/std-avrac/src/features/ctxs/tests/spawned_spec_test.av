// proves: a case is an entry like a program's statements: a task it spawns, or one a helper it calls
// spawns, starts under the frame of its spawn, and a fn value made where nothing is set reads, in
// that task, the contexts set where the task runs; a lambda made under a set and spawned through a
// record, a component's field or a method under a guard reads that set

use @std.meta.{guarded}

ctx db: string

type Store = { n: int, opened: Cell<string> }

impl Store {
    fn run() -> string { "${self.lazy()}:${self.n}" }

    fn lazy() -> string {
        if self.opened.get() == "" { self.opened.set(ctx.db) }
        self.opened.get()
    }
}

type Home = { open: fn() -> string }

fn stored_with() -> Home { Home { open: () -> "home@${ctx.db}" } }

fn named_read() -> string { ctx.db }

fn helper_spawn() -> string {
    ctx db = "C"
    let t = spawn named_read()
    t.await
}

type Holder = { f: fn() -> string }

component box {
    f: fn() -> string
}

type Shift = { f: fn() -> string }

impl Shift {
    fn spawned() -> string {
        let t = spawn (self.f)()
        t.await
    }
    fn guarded_spawn() -> string {
        let f = self.f
        let t = spawn ran(() -> f())
        t.await
    }
}

fn ran(body: fn() -> string) -> string {
    let slot: Cell<string> = Cell.new("unrun")
    let trapped = guarded(
        () -> {
            slot.set(body())
            true
        },
    )
    if trapped != null { "trapped" } else { slot.get() }
}

fn call(f: fn() -> string) -> string { f() }

fn through_record() -> string {
    ctx db = "R"
    let h = Holder { f: () -> ctx.db }
    let t = spawn call(h.f)
    t.await
}

fn through_component_under_guard() -> string {
    ctx db = "K"
    box b {
        f: () -> ctx.db
    }
    Shift { f: b.f }.guarded_spawn()
}

fn in_method() -> string {
    ctx db = "M"
    Shift { f: () -> ctx.db }.spawned()
}

spec "a task a case spawns reads the contexts of its spawn" {
    given "a set in the case's own body" {
        then "a spawned method reads it, through a cell it opens late" {
            ctx db = "B"
            let s = Store { n: 1, opened: Cell.new("") }
            let t = spawn s.run()
            t.await == "B:1"
        }
        then "a fn value made where nothing is set reads it in the task" {
            let home = stored_with()
            ctx db = "B"
            let t = spawn (home.open)()
            t.await == "home@B"
        }
    }
    given "a set in a helper the case calls" {
        then "a named fn it spawns reads it" { helper_spawn() == "C" }
    }
    given "a lambda made under a helper's set, spawned through a value" {
        then "through a record field" { through_record() == "R" }
        then "through a component's field, in a method under a guard" { through_component_under_guard() == "K" }
        then "spawned inside a method" { in_method() == "M" }
    }
}
