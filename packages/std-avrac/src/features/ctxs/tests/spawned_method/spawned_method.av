// proves: a task its block owns, spawned over a method call, starts under the frame of its spawn,
// so a required context set before the spawn is the one the method reads, through a call, a fn
// value and a value a cell opens late
ctx db: string

type Store = { n: int, opened: Cell<string> }

impl Store {
    fn run() -> string { "${ctx.db}:${self.n}" }

    fn lazy() -> string {
        if self.opened.get() == "" { self.opened.set(opened_here()) }
        self.opened.get()
    }
}

fn opened_here() -> string { "q@${ctx.db}" }

fn worker(f: fn() -> string) -> string { f() }

fn go() -> string {
    ctx db = "B"
    let s = Store { n: 1, opened: Cell.new("") }
    let a = spawn s.run()
    let b = spawn s.lazy()
    let c = spawn worker(opened_here)
    "${a.await} ${b.await} ${c.await}"
}

go()
