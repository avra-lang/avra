//! Parse-time lowering: a trait's SIGS mint as BODYLESS FnDecls (the
//! body is a hole no pass walks), so declare and totality reuse the fn
//! machinery whole. A trait's members arrive built, one
//! `trait_member` each.
use core.{Expr, Stmt, Span, Scoped}
use features.{LangNode, Builder, params_at}
/// One trait member: a sig with a HOLE body, or a DEFAULT with the
/// block written under it — spanning name to body's end, so the
/// body's expressions are the member's own range. A sig wears its
/// name's span, so a refusal at it lands on the line.
fn build_trait_member(b: Builder) -> Result<LangNode, string> {
    let name = b.token(2)?
    let body? = (b.exprs(5)?).first() else {
        let hollow = b.store.alloc_expr(Expr.Error)
        return b
            .member(
                Stmt.FnDecl(Scoped(name.text), [], params_at(b.args, 3), b.answer(4), hollow),
                name.span,
            )
    }
    let ends: Span? = b.store.expr_span(body)
    b
        .member(
            Stmt.FnDecl(Scoped(name.text), [], params_at(b.args, 3), b.answer(4), body),
            Span { lo: name.span.lo, hi: ends?.hi ?? name.span.hi },
        )
}

impl Builder {
    /// The member's statement, carrying the `static` and `mut` words
    /// written before its `fn`.
    fn member(d: Stmt, at: Span) -> Result<LangNode, string> {
        let sig = self.store.alloc_stmt(d, at)
        if !(self.tokens(0)?).is_empty() { self.store.mark_static(sig) }
        if !(self.tokens(1)?).is_empty() { self.store.mark_mutating(sig) }
        .Ok(LangNode.NStmt(sig))
    }
}
