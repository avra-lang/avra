//! The impl block's semantics: its fns resolve and type as fns do
//! (their `self` was typed at declare); lowering is the DRIVER's —
//! each contained fn lowers under its qualified name in the fn
//! loop, so this pass answers nothing.
use core.{Stmt, StmtId, Reg}
use features.{StmtSemantics, StmtResolveCx, StmtTypeCx, StmtLowerCx}

export type ImplSemantics = { }

impl StmtSemantics for ImplSemantics {
    fn resolve_stmt(self, cx: StmtResolveCx, s: StmtId) {
        cx.impl_stmts(impl_fns(cx.view.store.stmt(s)))
    }

    fn type_stmt(self, cx: StmtTypeCx, s: StmtId) {
        cx.type_stmts(impl_fns(cx.view.store.stmt(s)))
    }

    fn lower_stmt(self, cx: StmtLowerCx, s: StmtId) -> Reg? {
        null
    }
}

/// This feature's own variant, projected.
fn impl_fns(s: Stmt) -> List<StmtId> {
    // LICENSED I22: a feature matching its own variant
    match s {
        .ImplDecl(_, _, fns) -> fns,
        .TraitDecl(_, fns) -> fns,
        _ -> [],
    }
}
