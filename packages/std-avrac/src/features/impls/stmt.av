//! The impl block's semantics: its fns resolve and type as fns do
//! (their receiver was typed at declare); lowering is the DRIVER's —
//! each contained fn lowers under its qualified name in the fn
//! loop, so this pass answers nothing.
use core.{Stmt, StmtId, SyntaxArena}
use @std.errors.{Loc}
use core.stmt.{ImplDecl, TraitDecl}
use features.{StmtSemantics, ResolveCx, TypeCx}
use diagnostics.{Diag, refusal}

impl StmtSemantics for ImplDecl {
    fn resolve_stmt(mut cx: ResolveCx, s: StmtId) { resolve_block(cx, s) }

    fn type_stmt(mut cx: TypeCx, s: StmtId) { type_block(cx, s) }

}

impl StmtSemantics for TraitDecl {
    fn resolve_stmt(mut cx: ResolveCx, s: StmtId) { resolve_block(cx, s) }

    fn type_stmt(mut cx: TypeCx, s: StmtId) { type_block(cx, s) }

}

/// An `impl` and a `trait` block walk the same way — the shared home is a
/// fn, never an empty object beside the two records.
fn resolve_block(mut cx: ResolveCx, s: StmtId) {
    if cx.refuses_nested(s, "resolve.nested_impl", "impl and trait blocks") { return }
    let fns = impl_fns(cx.view.store.stmt(s))
    let stray? = fns.find((m) -> strays(cx.view.store, m)) else { return cx.impl_stmts(fns) }
    cx.emit(stray_member(cx.stmt_loc(stray)))
}

/// A statement written among the methods that is none: neither a member
/// nor what the parse made of a line it could not read.
fn strays(store: SyntaxArena, s: StmtId) -> bool {
    !store.holds_a_member(s) && !(store.stmt(s) is .Error)
}

fn type_block(mut cx: TypeCx, s: StmtId) {
    cx.type_stmts(impl_fns(cx.view.store.stmt(s)))
}

/// This feature's own variant, projected.
fn impl_fns(s: Stmt) -> List<StmtId> {
    // a feature matching its own variant
    match s { .ImplDecl(_, _, _, _, fns) or .TraitDecl(_, _, fns) -> fns, rest -> [] }
}

// ── voices ──

fn stray_member(at: Loc?) -> Diag {
    refusal(
        "resolve.impl_member",
        at,
        "an `impl` block holds `fn` declarations only",
        "not a `fn`",
        "move it out of the block — an `impl` holds the type's methods",
    )
}
