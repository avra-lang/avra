//! The method call's semantics: dispatch only. Typing lives in
//! check.av, lowering in lower.av. The subject and arguments are
//! ordinary children — nothing is scoped or hidden.
use core.{Expr, ExprId, TypeId, Reg}
use features.{NodeSemantics, ResolveCx, TypeCx, LowerCx, nothing}

export type MethodSemantics = { }

impl NodeSemantics for MethodSemantics {
    fn kids(self, e: Expr) -> List<ExprId> {
        // LICENSED I22: a feature cannot enumerate OTHER features' variants
        match e {
            .MethodCall(subject, _, args) -> [subject].concat(args),
            _ -> [],
        }
    }

    fn resolve(self, cx: ResolveCx, e: ExprId) {
        nothing()
    }

    fn type_of(self, cx: TypeCx, e: ExprId) -> TypeId {
        method_call_type(cx, e)
    }

    fn lower(self, cx: LowerCx, e: ExprId) -> Reg {
        method_call_reg(cx, e)
    }
}
