// proves: a value of a generic type boxed as `dyn` calls the method its type's arguments reach —
// one box per instance, each answering for its own argument.
trait Say {
    fn say() -> string
}

type Held<T> = { v: T, n: int }

impl Say for Held<T> {
    fn say() -> string { "held ${self.n}" }
}

let xs: List<dyn Say> = [
    Held<int> { v: 1, n: 1 },
    Held<string> { v: "a", n: 2 },
    Held<bool> { v: true, n: 3 },
]
[x.say() for x in xs].join(", ")
