// proves: a `dyn` box holds a value of a type the language owns: text built at run time, an int
// and a bool beside a record, each called through its impl and told apart by a typed pattern.
trait Show {
    fn show() -> string
}
type P = { n: int }
impl Show for string {
    fn show() -> string { "<" + self + ">" }
}
impl Show for int {
    fn show() -> string { "#${self}" }
}
impl Show for bool {
    fn show() -> string { if self { "yes" } else { "no" } }
}
impl Show for P {
    fn show() -> string { "P${self.n}" }
}
fn kind(d: dyn Show) -> string {
    match d {
        s: string -> "text ${s.length}",
        n: int -> "int ${n + 1}",
        p: P -> "p ${p.n}",
        _ -> "other",
    }
}
fn all(xs: List<dyn Show>) -> string { xs.map(it.show()).join("") }
let made = "b" + "c"
let xs: List<dyn Show> = ["a", made, 7, true, P { n: 2 }]
"${all(xs)} ${kind(xs[1])} ${kind(xs[2])} ${kind(xs[3])} ${kind(xs[4])}"
