// proves: a static fn a trait writes in its own body is called through the trait's name, from a
// fn and from another of the trait's own statics.
trait Sized {
    fn size() -> int

    static fn unit() -> int { 3 }

    static fn scaled(by: int) -> int { Sized.unit() * by }
}

fn shown(by: int) -> string { "${Sized.unit()} ${Sized.scaled(by)}" }

shown(5)
