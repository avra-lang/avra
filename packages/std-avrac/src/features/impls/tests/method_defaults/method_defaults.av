// proves: a method's seat a call leaves takes its default, by position or past a named argument,
// and a written argument replaces it.
type Counter = { base: int }

impl Counter {
    fn plus(n: int = 4, m: int = 1) -> int { self.base + n * m }
}

let c = Counter { base: 10 }
"${c.plus()} ${c.plus(2)} ${c.plus(2, 3)} ${c.plus(m: 5)}"
