// A derivable trait is held to its contract WHERE IT IS DECLARED, so a
// library's author hears a broken `derive` at their own build, never
// first at a user's `@derive`.
use @std.avrac.testing.{provided, said, refused_with}

/// A program whose main file declares `traits` over `@std.meta`.
fn declaring(traits: string) -> string {
    let p = provided(
        "use @std.meta.{Type, Fn, Named, Directive, Declared}\n\n" + traits + "\n1\n",
        "",
    )
    if said(p).is_empty() { "clean" } else { p.report() }
}

spec "features/impls — the derive contract" {
    given "a trait's `derive`" {
        then "the contract's shape is clean, over each declaration a derive may take" {
            declaring(
                "trait A {\n    static fn derive(t: Type) -> List<Directive> { [] }\n    static fn marks(t: Type) -> List<string> { [] }\n}\ntrait B {\n    static fn derive(f: Fn) -> List<Directive> { [] }\n}\ntrait C {\n    static fn derive(n: Named) -> List<Directive> { [] }\n}",
            ) == "clean"
        }
        then "one that is not `static` is refused at its declaration" {
            declaring("trait A {\n    fn derive(t: Type) -> List<Directive>\n}")
                .contains("type.derive_contract")
        }
        then "`Declared` is the same effect with problems to speak, so it is clean" {
            declaring(
                "trait A {\n    static fn derive(t: Type) -> Declared { Declared { made: [] } }\n}",
            ) == "clean"
        }
        then "one taking no declaration is refused, with no `@std.meta` in sight" {
            refused_with(
                "trait T {\n    static fn derive(n: int) -> int { n }\n}\n1",
                "a trait's `derive` answers the declarations it makes",
            )
        }
        then "one answering anything but declarations is refused" {
            declaring("trait A {\n    static fn derive(t: Type) -> int { 1 }\n}")
                .contains("a trait's `derive` answers the declarations it makes")
        }
        then "a `marks` answering anything but `List<string>` is refused" {
            declaring(
                "trait A {\n    static fn derive(t: Type) -> List<Directive> { [] }\n    static fn marks(t: Type) -> string { \"\" }\n}",
            )
                .contains("a trait's `marks` is `static fn marks(t: Type) -> List<string>`")
        }
        then "a trait that declares no `derive` owes nothing" {
            refused_with(
                "trait T {\n    fn f() -> int\n}\ntrait U {\n    static fn derive(n: int) -> int { n }\n}\n1",
                "a trait's `derive` answers the declarations it makes",
            )
        }
    }
}
