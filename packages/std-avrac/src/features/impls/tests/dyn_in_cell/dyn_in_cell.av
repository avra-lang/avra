// proves: a `dyn` value a `mut` binding holds dispatches as it stands —
// a call that reads it, after the binding was written, reaches the new box.
trait Named {
    fn named() -> string
}

type A = { n: int }
type B = { s: string }

impl Named for A {
    fn named() -> string { "a${self.n}" }
}

impl Named for B {
    fn named() -> string { "b${self.s}" }
}

fn shown() -> string {
    mut held: dyn Named = A { n: 1 }
    let first = held.named()
    held = B { s: "x" }
    "${first} ${held.named()}"
}

shown()
