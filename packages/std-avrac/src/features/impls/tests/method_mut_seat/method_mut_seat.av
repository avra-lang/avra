// proves: a METHOD's own `mut` parameter seals the record it names
// boxed, as a free fn's does — so a one-field record written through
// that seat is written in place, whether or not anything else seals
// it. `Id` is written only by methods here; `Pair` has two fields and
// was boxed all along, the control.
type Id = { index: int }
type Pair = { a: int, b: int }
type Holder = {}
type Unused = { n: int }

impl Holder {
    fn bump(mut i: Id) { i.index = i.index + 1 }
    fn swap(mut p: Pair) {
        let a = p.a
        p.a = p.b
        p.b = a
    }
    static fn reset(mut i: Id) { i.index = 0 }
    fn never(mut u: Unused) { u.n = u.n + 1 }
}

let h = Holder {}
mut id = Id { index: 1 }
h.bump(id)
h.bump(id)
mut pair = Pair { a: 1, b: 2 }
h.swap(pair)
let before = id.index
Holder.reset(id)

"${before} ${id.index} ${pair.a} ${pair.b}"
