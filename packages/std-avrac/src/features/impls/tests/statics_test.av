// STATIC METHODS — `static fn` is the THIRD value of the word `fn`
// and `mut fn` are the first two of: a fn under an impl with no
// receiver, called `Type.name(…)`. The variant WINS that spelling,
// so an enum's variant is never shadowed, and the pair is refused
// where it is written.
use @std.avrac.testing.{shown, refused_with}

/// A type with a static constructor and an ordinary method.
fn pointed() -> string {
    "type P = { x: int, y: int }\nimpl P {\n    static fn origin() -> P { P { x: 0, y: 0 } }\n    fn sum() -> int { self.x + self.y }\n}\n"
}

spec "features/impls/statics" {
    given "a static under an impl" {
        then "it is called through the TYPE, not a value" {
            shown("${pointed()}P.origin().sum()") == "0"
        }
        then "its seats are numbered from zero — no receiver spends one" {
            shown("type P = { x: int }\nimpl P {\n    static fn of(n: int) -> P { P { x: n } }\n}\nP.of(7).x") == "7"
        }
        then "it stands beside ordinary methods on the same type" {
            shown("${pointed()}let p = P { x: 1, y: 2 }\np.sum() + P.origin().sum()") == "3"
        }
        then "a static answers a scalar as readily as its own type" {
            shown("type P = { x: int }\nimpl P {\n    static fn two() -> int { 2 }\n}\nP.two()") == "2"
        }
    }
    given "a static and an enum" {
        then "a variant of the same type still constructs" {
            shown("enum K { a, b }\nimpl K {\n    static fn many() -> int { 2 }\n}\nlet v = K.a\nif v is .a { K.many() } else { 0 }") == "2"
        }
        then "a static NAMED like a variant is refused where it is written" {
            refused_with("enum K { a, b }\nimpl K {\n    static fn a() -> int { 7 }\n}\n1", "`K.a` is already a variant")
        }
    }
    given "the receiver a static does not have" {
        then "`self` inside one refuses, and says why" {
            refused_with("type P = { x: int }\nimpl P {\n    static fn get() -> int { self.x }\n}\n1", "a `static fn` has none")
        }
        then "`static fn` at the top level is a plain fn already" {
            refused_with("static fn f() -> int { 1 }\nf()", "`f` is already a plain fn")
        }
        then "`static fn` in a trait waits on `Self`" {
            refused_with("trait Show {\n    static fn make() -> int\n}\n1", "which has no name in a signature yet")
        }
    }
    given "a call that does not fit" {
        then "the arity refusal names no `self`" {
            refused_with("type P = { x: int }\nimpl P {\n    static fn of(n: int) -> P { P { x: n } }\n}\nP.of(1, 2).x", "takes 1 arguments, found 2")
        }
        then "an unknown name under a type is still the variant law's word" {
            refused_with("type P = { x: int }\nimpl P {\n    static fn of(n: int) -> P { P { x: n } }\n}\nP.nope().x", "`P` is a record, not an enum")
        }
    }
}
