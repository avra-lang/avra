trait Show {
    fn show() -> int
}
type P = { x: int }
enum G {
    hot
    cold
}
impl Show for P {
    fn show() -> int {
        self.x
    }
}
impl Show for G {
    fn show() -> int {
        match self {
            .hot -> 100,
            .cold -> 1,
        }
    }
}
type Holder = { it: dyn Show }
fn speak(v: dyn Show) -> int {
    v.show()
}
fn pick(hot: bool) -> dyn Show {
    if hot {
        let a: dyn Show = G.hot
        return a
    }
    let b: dyn Show = P { x: 7 }
    b
}
let h = Holder { it: P { x: 5 } }
let e1: dyn Show = P { x: 2 }
let e2: dyn Show = G.hot
let e3: dyn Show = G.cold
let xs: List<dyn Show> = [e1, e2, e3]
mut total = 0
for v in xs {
    total = total + v.show()
}
"f ${h.it.show()} s ${speak(P { x: 9 })} p ${pick(true).show() + pick(false).show()} l ${total}"
