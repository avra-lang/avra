// An impl serves its target only where the target's argument meets the
// bound written on it; its body calls that argument's members.
trait Sh {
    fn said() -> string
}

type P = { n: int }

impl Sh for P {
    fn said() -> string { "p${self.n}" }
}

type Box<T> = { v: T }

impl Sh for Box<T: Sh> {
    fn said() -> string { "[${self.v.said()}]" }
}

impl Sh for List<T: Sh> {
    fn said() -> string { [x.said() for x in self].join(",") }
}

fn shown_as<X: Sh>(x: X) -> string { x.said() }

let boxed: dyn Sh = Box { v: [P { n: 1 }, P { n: 2 }] }
"${shown_as([Box { v: P { n: 3 } }])} ${boxed.said()}"
