// proves: a method that writes its receiver, called on a name a pattern binds, writes the value the pattern took
type Counter = { n: int, tags: List<string> }

impl Counter {
    mut fn bump() -> int {
        self.n = self.n + 1
        self.tags.push("b")
        self.n
    }
}

fn made(k: int) -> Result<Counter, string> { if k > 0 { .Ok(Counter { n: k, tags: [] }) } else { .Err("no") } }

let got = match made(3) {
    .Ok(c) -> {
        let x = c.bump()
        "${x} ${c.n} ${c.tags.length}"
    },
    .Err(e) -> e,
}
let held = made(5)
let again = match held {
    .Ok(c) -> {
        let x = c.bump()
        "${x} ${c.n}"
    },
    .Err(e) -> e,
}
"${got} | ${again}"
