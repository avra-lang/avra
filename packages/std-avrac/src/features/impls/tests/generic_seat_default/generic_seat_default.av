// proves: a method of a generic type whose seat has a default takes an
// argument there by position, as any seat does.
type Holder<T> = { held: T, n: int }

impl Holder {
    fn kept(times: int = 2) -> List<T> { [self.held for _i in 0..times * self.n] }
}

let h = Holder { held: "x", n: 2 }

"${h.kept(3).length} ${h.kept(1).join("")}"
