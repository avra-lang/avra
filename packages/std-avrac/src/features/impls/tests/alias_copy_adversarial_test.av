// The RED TEAM's permanent record for the ALIAS COPY (spec 11.5: a
// `mut` local over a place is a copy, and a writing method through it
// lands in the copy). Every answer below was run in both engines; the
// ORDER cases were found by attacking it — a value receiver ran after
// its arguments, and a copied receiver's index operand after the
// argument it precedes.
use @std.avrac.compiler.{analyze_source}
use @std.avrac.testing.{shown}

spec "features/impls (alias copy, adversarial)" {
    given "degenerate shapes" {
        then "a one-field record copied, then written twice" {
            shown("type C = { n: int }\nimpl C { mut fn bump() { self.n = self.n + 1 } }\nfn shadow(p: C) -> int {\n    mut q = p\n    q.bump()\n    q.bump()\n    q.n\n}\nlet c = C { n: 5 }\nlet a = shadow(c)\n\"\${a} \${c.n}\"") == "7 5"
        }
        then "a record of one list, copied per call" {
            shown("type C = { xs: List<int> }\nimpl C { mut fn add(v: int) { self.xs.push(v) } }\nfn shadow(p: C) -> int {\n    mut q = p\n    q.add(1)\n    q.xs.length\n}\nlet c = C { xs: [] }\nlet a = shadow(c)\nlet b = shadow(c)\n\"\${a} \${b} \${c.xs.length}\"") == "1 1 0"
        }
        then "a receiver and four arguments all writing one copied local" {
            shown("type R = { xs: List<int> }\nimpl R {\n    mut fn add(v: int) -> int {\n        self.xs.push(v)\n        self.xs.length\n    }\n    mut fn all(a: int, b: int, c: int, d: int) -> int {\n        self.xs.push(a * 1000 + b * 100 + c * 10 + d)\n        self.xs.length\n    }\n}\nfn shadow(p: R) -> string {\n    mut q = p\n    let n = q.all(q.add(1), q.add(2), q.add(3), q.add(4))\n    \"\${n} \${q.xs[4]}\"\n}\nlet r = R { xs: [] }\n\"\${shadow(r)} \${shadow(r)} \${r.xs.length}\"") == "5 1234 5 1234 0"
        }
    }
    given "the receiver in every kind of place" {
        then "a field of a copy, and a copy of a field" {
            shown("type In = { n: int, xs: List<int> }\ntype Out = { inner: In, k: int }\nimpl In { mut fn bump() { self.n = self.n + 1 } }\nfn shadow(p: Out) -> int {\n    mut q = p\n    q.inner.bump()\n    mut i = p.inner\n    i.bump()\n    i.bump()\n    q.inner.n * 10 + i.n\n}\nlet o = Out { inner: In { n: 0, xs: [] }, k: 1 }\n\"\${shadow(o)} \${o.inner.n}\"") == "12 0"
        }
        then "an element of a copied list" {
            shown("type R = { n: int, s: string }\nimpl R { mut fn bump() { self.n = self.n + 1 } }\nfn shadow(xs: List<R>) -> int {\n    mut q = xs\n    q[0].bump()\n    q[1].bump()\n    q[0].n + q[1].n\n}\nlet rs = [R { n: 0, s: \"a\" }, R { n: 10, s: \"b\" }]\n\"\${shadow(rs)} \${rs[0].n} \${rs[1].n}\"") == "12 0 10"
        }
        then "a copy of a copy" {
            shown("type In = { n: int, xs: List<int> }\ntype Out = { inner: In }\nimpl In { mut fn bump() { self.n = self.n + 1 } }\nfn shadow(o: Out) -> int {\n    mut i = o.inner\n    i.bump()\n    mut j = i\n    j.bump()\n    i.n * 10 + j.n\n}\nlet o = Out { inner: In { n: 0, xs: [] } }\n\"\${shadow(o)} \${o.inner.n}\"") == "12 0"
        }
        then "a generic record" {
            shown("type Box<T> = { held: List<T>, n: int }\nimpl Box<T> { mut fn bump() { self.n = self.n + 1 } }\nfn shadow(p: Box<int>) -> int {\n    mut q = p\n    q.bump()\n    q.n\n}\nlet b: Box<int> = Box { held: [1], n: 0 }\n\"\${shadow(b)} \${b.n}\"") == "1 0"
        }
        then "a name over a list, its own method writing" {
            shown("type Rows = List<int>\nimpl Rows { mut fn add(v: int) { self.push(v) } }\nfn shadow(p: Rows) -> int {\n    mut q = p\n    q.add(1)\n    q.add(2)\n    q.length\n}\nlet r: Rows = [9]\n\"\${shadow(r)} \${shadow(r)} \${r.length}\"") == "3 3 1"
        }
        then "`self` copied inside its own method" {
            shown("type R = { n: int, xs: List<int> }\nimpl R {\n    mut fn bump() { self.n = self.n + 1 }\n    fn tried() -> int {\n        mut q = self\n        q.bump()\n        q.n\n    }\n}\nlet r = R { n: 3, xs: [] }\n\"\${r.tried()} \${r.n}\"") == "4 3"
        }
        then "an unwrapped nullable" {
            shown("type R = { n: int, xs: List<int> }\nimpl R { mut fn bump() { self.n = self.n + 1 } }\nfn shadow(p: R?) -> int {\n    let v? = p else { return -1 }\n    mut q = v\n    q.bump()\n    q.n\n}\nlet r: R? = R { n: 0, xs: [] }\n\"\${shadow(r)} \${r?.n ?? -9}\"") == "1 0"
        }
    }
    given "crossing other features" {
        then "a `for` and a `while` writing one copy" {
            shown("type R = { n: int, xs: List<int> }\nimpl R { mut fn bump() { self.n = self.n + 1 } }\nfn shadow(p: R) -> int {\n    mut q = p\n    for i in 0..5 { q.bump() }\n    mut k = 0\n    while k < 3 {\n        q.bump()\n        k = k + 1\n    }\n    q.n\n}\nlet r = R { n: 0, xs: [] }\n\"\${shadow(r)} \${shadow(r)} \${r.n}\"") == "8 8 0"
        }
        then "a `match` arm" {
            shown("type R = { n: int, xs: List<int> }\nimpl R { mut fn bump() -> int {\n    self.n = self.n + 1\n    self.n\n} }\nfn shadow(p: R, k: int) -> int {\n    mut q = p\n    match k {\n        0 -> q.bump(),\n        _ -> {\n            q.bump()\n            q.bump()\n        },\n    }\n}\nlet r = R { n: 0, xs: [] }\n\"\${shadow(r, 0)} \${shadow(r, 1)} \${r.n}\"") == "1 2 0"
        }
        then "an `if` branch" {
            shown("type R = { n: int, xs: List<int> }\nimpl R { mut fn bump() { self.n = self.n + 1 } }\nfn shadow(p: R, k: bool) -> int {\n    mut q = p\n    if k { q.bump() } else {\n        q.bump()\n        q.bump()\n    }\n    q.n\n}\nlet r = R { n: 0, xs: [] }\n\"\${shadow(r, true)} \${shadow(r, false)} \${r.n}\"") == "1 2 0"
        }
        then "interpolation holes, left to right" {
            shown("type R = { n: int, s: string }\nimpl R { mut fn bump() -> int {\n    self.n = self.n + 1\n    self.n\n} }\nfn shadow(p: R) -> string {\n    mut q = p\n    \"\${q.bump()}-\${q.bump()}-\${p.n}\"\n}\nlet r = R { n: 0, s: \"\" }\n\"\${shadow(r)} \${r.n}\"") == "1-2-0 0"
        }
        then "a loop variable copied per turn" {
            shown("type R = { n: int }\nimpl R { mut fn bump() { self.n = self.n + 1 } }\nfn shadow(rs: List<R>) -> int {\n    mut t = 0\n    for r in rs {\n        mut q = r\n        q.bump()\n        t = t + q.n\n    }\n    t\n}\nlet rs = [R { n: 1 }, R { n: 2 }]\n\"\${shadow(rs)} \${rs[0].n} \${rs[1].n}\"") == "5 1 2"
        }
        then "recursion, a copy per frame" {
            shown("type R = { n: int, xs: List<int> }\nimpl R { mut fn bump() { self.n = self.n + 1 } }\nfn deep(p: R, k: int) -> int {\n    if k == 0 { return p.n }\n    mut q = p\n    q.bump()\n    deep(q, k - 1) + p.n\n}\nlet r = R { n: 0, xs: [] }\n\"\${deep(r, 4)} \${r.n}\"") == "10 0"
        }
        then "a reassigned copy" {
            shown("type R = { n: int, xs: List<int> }\nimpl R { mut fn bump() { self.n = self.n + 1 } }\nfn shadow(p: R, other: R) -> int {\n    mut q = p\n    q.bump()\n    q = other\n    q.bump()\n    q.n\n}\nlet r = R { n: 0, xs: [] }\nlet s = R { n: 10, xs: [] }\n\"\${shadow(r, s)} \${r.n} \${s.n}\"") == "11 0 10"
        }
        then "a top-level `mut` copy" {
            shown("type R = { n: int, xs: List<int> }\nimpl R { mut fn bump() { self.n = self.n + 1 } }\nlet r = R { n: 0, xs: [] }\nmut q = r\nq.bump()\nq.bump()\n\"\${q.n} \${r.n}\"") == "2 0"
        }
        then "managed fields renamed and pushed" {
            shown("type R = { name: string, tags: List<string> }\nimpl R {\n    mut fn tag(t: string) { self.tags.push(\"\${t}-\${self.name}\") }\n    mut fn rename(n: string) { self.name = n }\n}\nfn shadow(p: R) -> string {\n    mut q = p\n    q.tag(\"a\")\n    q.rename(\"\${q.name}\${q.name}\")\n    q.tag(\"b\")\n    q.tags.join(\",\")\n}\nlet r = R { name: \"x\", tags: [\"t0\"] }\nlet a = shadow(r)\nlet b = shadow(r)\n\"\${a} \${b} \${r.name} \${r.tags.length}\"") == "t0,a-x,b-xx t0,a-x,b-xx x 1"
        }
    }
    given "the order a call reads in" {
        then "an argument writing the receiver's own copy" {
            shown("type R = { n: int, xs: List<int> }\nimpl R {\n    mut fn add(v: int) -> int {\n        self.xs.push(v)\n        self.xs.length\n    }\n    mut fn put(v: int) -> int {\n        self.xs.push(v * 100)\n        self.xs.length\n    }\n}\nfn shadow(p: R) -> int {\n    mut q = p\n    let a = q.put(q.add(1))\n    a * 10 + q.xs.length\n}\nlet r = R { n: 0, xs: [] }\n\"\${shadow(r)} \${shadow(r)} \${r.xs.length}\"") == "22 22 0"
        }
        then "two writing calls in one expression" {
            shown("type R = { n: int }\nimpl R {\n    mut fn bump() -> int {\n        self.n = self.n + 1\n        self.n\n    }\n}\nfn shadow(p: R) -> int {\n    mut q = p\n    q.bump() + q.bump() * 10\n}\nlet r = R { n: 0 }\n\"\${shadow(r)} \${r.n}\"") == "21 0"
        }
        then "a VALUE receiver runs before its arguments" {
            shown("type R = { n: int }\nimpl R {\n    fn total(k: int) -> int { self.n + k }\n}\nfn f(log: Cell<List<string>>) -> R {\n    log.set(log.get().concat([\"f\"]))\n    R { n: 1 }\n}\nfn g(log: Cell<List<string>>) -> int {\n    log.set(log.get().concat([\"g\"]))\n    2\n}\nlet none: List<string> = []\nlet log = Cell.new(none)\nlet t = f(log).total(g(log))\n\"\${t} \${log.get().join(\" \")}\"") == "3 f g"
        }
        then "a copied receiver's index operand runs before its argument" {
            shown("type R = { n: int }\nimpl R { mut fn set(v: int) { self.n = v } }\nfn at(log: Cell<List<string>>, i: int) -> int {\n    log.set(log.get().concat([\"i\"]))\n    i\n}\nfn val(log: Cell<List<string>>) -> int {\n    log.set(log.get().concat([\"v\"]))\n    7\n}\nfn shadow(xs: List<R>, log: Cell<List<string>>) -> int {\n    mut q = xs\n    q[at(log, 1)].set(val(log))\n    q[1].n\n}\nlet none: List<string> = []\nlet log = Cell.new(none)\nlet rs = [R { n: 0 }, R { n: 0 }]\nlet a = shadow(rs, log)\n\"\${a} \${rs[1].n} \${log.get().join(\" \")}\"") == "7 0 i v"
        }
        then "two index operands, then the argument" {
            shown("type R = { n: int }\nimpl R { mut fn set(v: int) { self.n = v } }\nfn at(log: Cell<List<string>>, w: string, i: int) -> int {\n    log.set(log.get().concat([w]))\n    i\n}\nfn shadow(xs: List<List<R>>, log: Cell<List<string>>) -> int {\n    mut q = xs\n    q[at(log, \"a\", 1)][at(log, \"b\", 0)].set(at(log, \"v\", 7))\n    q[1][0].n\n}\nlet none: List<string> = []\nlet log = Cell.new(none)\nlet rs = [[R { n: 0 }], [R { n: 0 }]]\nlet a = shadow(rs, log)\n\"\${a} \${rs[1][0].n} \${log.get().join(\" \")}\"") == "7 0 a b v"
        }
    }
    given "a copy of what a place holds" {
        then "a `Cell`'s content" {
            shown("type R = { xs: List<int> }\nimpl R { mut fn add(v: int) { self.xs.push(v) } }\nfn shadow(c: Cell<R>) -> int {\n    mut q = c.get()\n    q.add(1)\n    q.xs.length\n}\nlet c = Cell.new(R { xs: [] })\n\"\${shadow(c)} \${shadow(c)} \${c.get().xs.length}\"") == "1 1 0"
        }
        then "a map's value, nested in a cell" {
            shown("type R = { xs: List<int> }\nimpl R { mut fn add(v: int) { self.xs.push(v) } }\ntype W = { c: Cell<Map<string, R>> }\nfn shadow(w: W) -> int {\n    mut q = w.c.get().get(\"k\") ?? R { xs: [] }\n    q.add(1)\n    q.xs.length\n}\nlet none: Map<string, R> = {}\nlet w = W { c: Cell.new(none) }\nw.c.put(\"k\", R { xs: [] })\n\"\${shadow(w)} \${shadow(w)} \${(w.c.get().get(\"k\") ?? R { xs: [9] }).xs.length}\"") == "1 1 0"
        }
        then "a list's last, through `!`" {
            shown("type R = { xs: List<int> }\nimpl R { mut fn add(v: int) { self.xs.push(v) } }\nfn shadow(rs: List<R>) -> int {\n    mut q = rs.last()!\n    q.add(1)\n    q.xs.length\n}\nlet rs = [R { xs: [] }, R { xs: [] }]\n\"\${shadow(rs)} \${shadow(rs)} \${rs[1].xs.length}\"") == "1 1 0"
        }
        then "a `find` over a field" {
            shown("type R = { n: int, xs: List<int> }\nimpl R { mut fn add(v: int) { self.xs.push(v) } }\ntype O = { rs: List<R> }\nfn shadow(o: O) -> int {\n    mut q = o.rs.find(it.n == 2) ?? R { n: 0, xs: [] }\n    q.add(1)\n    q.xs.length\n}\nlet o = O { rs: [R { n: 1, xs: [] }, R { n: 2, xs: [] }] }\n\"\${shadow(o)} \${shadow(o)} \${o.rs[1].xs.length}\"") == "1 1 0"
        }
        then "the warning names the place that holds what was read" {
            let a = analyze_source("type R = { xs: List<int> }\nimpl R { mut fn add(v: int) { self.xs.push(v) } }\ntype W = { c: Cell<Map<string, R>> }\nfn shadow(w: W) {\n    mut q = w.c.get().get(\"k\") ?? R { xs: [] }\n    q.add(1)\n}\n1")
            a.clean() && a.diagnostics.length == 1 && a.report().contains("`q` is a copy of what `w.c` holds — a write through it will not reach `w.c`") && a.report().contains("store the copy back into `w.c` if the write should reach it")
        }
        then "a fresh seed is no copy, and says nothing" {
            let a = analyze_source("type R = { xs: List<int> }\nimpl R { mut fn add(v: int) { self.xs.push(v) } }\nfn made() -> R { R { xs: [] } }\nfn shadow() -> int {\n    mut q = made()\n    q.add(1)\n    mut s = R { xs: [] }\n    s.add(2)\n    q.xs.length + s.xs.length\n}\nshadow()")
            a.diagnostics.is_empty() && a.ran() == "2"
        }
        then "the fresh side of a `??` is the copy's own" {
            shown("type R = { xs: List<int> }\nimpl R { mut fn add(v: int) { self.xs.push(v) } }\nfn shadow(rs: List<R>) -> int {\n    mut q = rs.first() ?? R { xs: [7] }\n    q.add(1)\n    q.xs.length\n}\nlet none: List<R> = []\n\"\${shadow(none)} \${shadow(none)}\"") == "2 2"
        }
    }
    given "a copy of a `dyn` value" {
        then "the wrapped value is copied with its box" {
            shown("trait Grow { mut fn grow() }\ntype R = { xs: List<int> }\nimpl Grow for R { mut fn grow() { self.xs.push(1) } }\nfn shadow(p: R) -> int {\n    let d: dyn Grow = p\n    mut q = d\n    q.grow()\n    q.grow()\n    p.xs.length\n}\nlet r = R { xs: [] }\n\"\${shadow(r)} \${r.xs.length}\"") == "0 0"
        }
        then "a flat value in the box, copied as a word" {
            shown("trait Grow { mut fn grow()\n    fn size() -> int }\ntype N = { n: int }\nimpl Grow for N {\n    mut fn grow() { self.n = self.n + 1 }\n    fn size() -> int { self.n }\n}\nfn shadow(d: dyn Grow) -> int {\n    mut q = d\n    q.grow()\n    q.size()\n}\nlet d: dyn Grow = N { n: 5 }\n\"\${shadow(d)} \${shadow(d)} \${d.size()}\"") == "6 6 5"
        }
        then "a `dyn` bound `mut` straight from its value" {
            shown("trait Grow { mut fn grow()\n    fn size() -> int }\ntype R = { xs: List<int> }\nimpl Grow for R {\n    mut fn grow() { self.xs.push(1) }\n    fn size() -> int { self.xs.length }\n}\nfn shadow(p: R) -> int {\n    mut d: dyn Grow = p\n    d.grow()\n    d.size()\n}\nlet r = R { xs: [] }\n\"\${shadow(r)} \${shadow(r)} \${r.xs.length}\"") == "1 1 0"
        }
    }
    given "what the copy does not reach yet" {
        // MEASURED, not asserted as right: spec 11.5 wants this a copy. A
        // `mut` SEAT of a free fn writes through the copied local to its
        // source. It flips when its copy lands.
        then "a copy handed to a `mut` seat" {
            shown("type R = { xs: List<int> }\nimpl R { mut fn add(v: int) { self.xs.push(v) } }\nfn grow(mut r: R) { r.add(5) }\nfn shadow(p: R) -> int {\n    mut q = p\n    grow(q)\n    q.xs.length\n}\nlet r = R { xs: [] }\n\"\${shadow(r)} \${r.xs.length}\"") == "1 1"
        }
    }
}
