// A trait impl over a GENERIC user type serves every instantiation.
trait Show {
    fn show() -> string
}

type Box<T> = { v: T }

impl Show for Box<T> {
    fn show() -> string { "box" }
}

type Pair<A, B> = { a: A, b: B }

impl Show for Pair<A, B> {
    fn show() -> string { "pair" }
}

type Tag<T> = { t: T }

impl Show for Tag<T> {
    fn show() -> string { "tag" }
}

// A GENERIC trait over a generic target, its member seated by the
// trait's argument.
type Text = { content: string }

trait Realize<T> {
    fn draw(t: T) -> string
}

impl Realize<Text> for Box<T> {
    fn draw(t: Text) -> string { "drawn" }
}

Box { v: 7 }.show() +
    " " +
    Pair { a: 1, b: "x" }.show() +
    " " +
    Tag { t: true }.show() +
    " " +
    Box { v: 1 }.draw(Text { content: "hi" })
