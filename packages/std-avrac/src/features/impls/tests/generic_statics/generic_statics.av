type Box<T> = { value: T }

impl Box<T> {
    static fn made(value: T) -> Box<T> { Box { value: value } }
    static fn absent() -> Box<T>? { null }
}

type Ref<T> = { id: string }

impl Ref<T> {
    static fn named(id: string) -> Ref<T> { Ref { id: id } }
}

type Person = { name: string }
type Project = { title: string }

fn person(r: Ref<Person>) -> string { r.id }
fn project() -> Ref<Project> { Ref.named("project-1") }

let number = Box.made(value: 7)
let word = Box.made("hello")
let absent: Box<bool>? = Box.absent()
"${number.value} ${word.value} ${absent == null} ${person(Ref.named("person-1"))} ${project().id}"
