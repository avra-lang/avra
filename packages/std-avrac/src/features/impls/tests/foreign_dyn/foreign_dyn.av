// proves: a `dyn` box over a type of another package, its impl written in
// the trait's package, calls the methods that impl gives, and so does a
// bare call on a value of that type.
use @std.time.{Duration, ms}

trait Shown {
    fn shown() -> string
    fn weight() -> int
}

impl Shown for Duration {
    fn shown() -> string { "${self.ms()} ms" }
    fn weight() -> int { self.ms() * 2 }
}

fn boxed(d: Duration) -> dyn Shown { d }

let views = [boxed(ms(5)), boxed(ms(40))]
"${[v.shown() for v in views].join(", ")} ${views.fold(0, (a, v) -> a + v.weight())} ${ms(3).shown()} ${ms(4).weight()}"
