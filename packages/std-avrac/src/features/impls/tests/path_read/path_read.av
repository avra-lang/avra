// proves: a method that only reads its receiver, called along a path
// from a `mut` binding, reads what the binding holds when it's called.
type Inner = { n: int }

impl Inner {
    fn plus(k: int) -> int { self.n + k }
}

type Outer = { inner: Inner, tag: string }

mut o = Outer { inner: Inner { n: 1 }, tag: "t" }
let a = o.inner.plus(2)
o.inner = Inner { n: 10 }
let b = o.inner.plus(5)
"${a} ${b} ${o.tag}"
