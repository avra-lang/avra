// proves: a place handed to a seat that writes runs each index operand along its path once: the
// value is read from it, then written back, through the registers the operands were lowered into,
// for a declared fn's `mut` seat, a writing method's receiver and a path of two indexes.
type R = { n: int }
impl R { mut fn set(v: int) { self.n = v } }
fn at(log: Cell<List<string>>, w: string, i: int) -> int {
    log.set(log.get().concat([w]))
    i
}
fn bump(mut r: R) -> int {
    r.n = r.n + 1
    r.n
}
let none: List<string> = []
let log = Cell.new(none)
mut q = [R { n: 0 }, R { n: 0 }]
q[at(log, "a", 1)].n = at(log, "v", 3)
let k = bump(q[at(log, "c", 0)])
q[at(log, "d", 0)].set(at(log, "w", 9))
mut qq = [[R { n: 0 }], [R { n: 0 }]]
qq[at(log, "e", 1)][at(log, "f", 0)].n = 2
qq[at(log, "g", 1)][at(log, "h", 0)].set(5)
"${q[0].n} ${q[1].n} ${k} ${qq[1][0].n} ${log.get().join(" ")}"
