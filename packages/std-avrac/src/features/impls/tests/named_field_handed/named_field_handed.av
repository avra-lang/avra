// proves: a method reading a method of a named field's own value
// (`self.tag.of.is_empty()`) reads its receiver, never writes it.
type Tag = string

type Item = { tag: Tag }

type Log = { lines: List<string> }

impl Log {
    mut fn add(line: string) { self.lines.push(line) }
}

impl Item {
    fn told(mut log: Log) { if !self.tag.of.is_empty() { log.add(self.tag.of) } }
}

fn shown() -> string {
    let item = Item { tag: Tag("t") }
    mut log = Log { lines: [] }
    item.told(log)
    log.lines.join(",")
}

shown()
