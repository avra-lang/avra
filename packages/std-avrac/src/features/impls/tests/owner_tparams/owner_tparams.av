// proves: a method's body reads its owner's type parameters — a local
// annotation naming an impl's `T`, at two instantiations

type Box<T> = { rows: List<T> }

impl Box<T> {
    fn at_or(i: int, fallback: T) -> T {
        let held: T? = if i < self.rows.length { self.rows[i] } else { null }
        held ?? fallback
    }
}

let ints = Box { rows: [1, 2] }
let words = Box { rows: ["a"] }
"${ints.at_or(1, 0)} ${ints.at_or(5, 9)} ${words.at_or(0, "z")} ${words.at_or(3, "z")}"
