// A TYPE WITH AN IMPL WHOSE OWN MEMBER NAMES NO TYPE: the impl stands over the type's parameters as
// they're written, so the member's unknown type is refused once and nothing asks what generators
// make while the type's own signature is being read.
use @std.avrac.testing.{refused_with}

spec "features/impls (a member naming no type)" {
    given "a type with an impl" {
        then "a record's field naming no type refuses" {
            refused_with(
                "type R = { x: Missing }\nimpl R { fn f() -> int { 1 } }\n1",
                "`Missing` names no type",
            )
        }
        then "an enum's payload naming no type refuses" {
            refused_with(
                "enum E { A(Missing), B }\nimpl E { fn f() -> int { 1 } }\n1",
                "`Missing` names no type",
            )
        }
        then "a component's seat naming no type refuses" {
            refused_with("component C(x: Missing) {\n}\n1", "`Missing` names no type")
        }
    }
}
