// A trait impl over a BUILT-IN generic serves every instantiation.
trait Show {
    fn show() -> string
}

impl Show for Result<T, E> {
    fn show() -> string { "result" }
}

impl Show for List<T> {
    fn show() -> string { "list" }
}

type Text = { content: string }

trait Realize<X> {
    fn draw(x: X) -> string
}

impl Realize<Text> for Result<T, E> {
    fn draw(x: Text) -> string { "drawn" }
}

let ok: Result<int, string> = .Ok(1)
let xs: List<int> = [1, 2]

ok.show() + " " + xs.show() + " " + ok.draw(Text { content: "hi" })
