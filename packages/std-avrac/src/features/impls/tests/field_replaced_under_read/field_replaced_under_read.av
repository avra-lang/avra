// proves: a field read stays its own while the method replaces that field through self.
type Holder = { items: List<string>, tag: int }

impl Holder {
    mut fn swapped(next: List<string>) -> int {
        let old = self.items
        self.items = next
        old.length + old[0].length
    }
}

mut h = Holder { items: ["a" + "bc", "d"], tag: 1 }
let n = h.swapped(["x" + "y"])
"${n} ${h.items[0]}"
