// proves: a method handing its receiver to a fn its seat holds writes the
// receiver only where that fn's own seat is `mut` — read off the seat's
// written type, an alias's included.
alias Reader = fn(Counter, int) -> int

type Counter = { n: int }

impl Counter {
    fn through(f: Reader) -> int { f(self, 2) }
}

fn times(c: Counter, k: int) -> int { c.n * k }

let c = Counter { n: 5 }
"${c.through(times)}"
