// proves: STATIC METHODS — a receiverless fn under an impl, called
// `Type.name(…)`; a constructor answering its own type; several
// seats; statics beside ordinary methods on one type; and an enum's
// static, where the VARIANT still wins the spelling

type Point = { x: int, y: int }

impl Point {
    static fn origin() -> Point { Point { x: 0, y: 0 } }
    static fn at(x: int, y: int) -> Point { Point { x: x, y: y } }
    fn sum() -> int { self.x + self.y }
}

enum Suit { clubs, hearts }

impl Suit {
    static fn how_many() -> int { 2 }
    fn word() -> string {
        match self {
            .clubs -> "clubs"
            .hearts -> "hearts"
        }
    }
}

let o = Point.origin()
let p = Point.at(3, 4)
let h = Suit.hearts
"origin ${o.sum()} at ${p.sum()} suits ${Suit.how_many()} suit ${h.word()}"
