// One generic trait implemented at several arguments on one type: a
// call picks the member whose seats fit its arguments.
type Text = { content: string }

type Button = { label: string }

type Html = { tag: string = "" }

trait Realize<T> {
    fn draw(t: T) -> string
}

impl Realize<Text> for Html {
    fn draw(t: Text) -> string { "<p>${t.content}</p>" }
}

impl Realize<Button> for Html {
    fn draw(t: Button) -> string { "<button>${t.label}</button>" }
}

impl Realize<List<int>> for Html {
    fn draw(t: List<int>) -> string { "<ol>${t.length}</ol>" }
}

fn page(h: Html) -> string { h.draw(Text { content: "hi" }) + h.draw(Button { label: "go" }) }

page(Html {}) + Html {}.draw([1, 2, 3])
