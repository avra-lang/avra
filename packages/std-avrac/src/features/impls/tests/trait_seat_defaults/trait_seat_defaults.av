// proves: a trait member's seat default fills an unwritten seat through
// the type, a bound and a contract value, in both engines

trait Grows {
    fn grown(by: int = 10) -> int
    static fn scaled(n: int, by: int = 2) -> int
}

type P = { n: int }

impl Grows for P {
    fn grown(by: int) -> int { self.n + by }
    static fn scaled(n: int, by: int) -> int { n * by }
}

fn through<T: Grows>(x: T) -> int { x.grown() }

let d: dyn Grows = P { n: 2 }
"${P.scaled(3)} ${P { n: 1 }.grown()} ${through(P { n: 5 })} ${d.grown()} ${P.scaled(4, 3)}"
