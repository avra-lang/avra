//! Methods and behavior contracts. An `impl Target { fns… }` block
//! gives a declared type its methods: every fn under it is a method,
//! `self` — a keyword, never written in the parameter list — is its
//! receiver, typed as the target and riding seat 0; the fn LOWERS
//! under a qualified name (`Target.method`), and a call `v.name(args)`
//! — parsed in the ladder, the paren witness telling it from a
//! property — resolves PROVABLY at typing through the receiver's
//! type. Never a runtime lookup (spec 4.5). `mut fn` DECLARES that a
//! method writes its receiver: a trait sig's contract, an inherent
//! method's documentation (ROADMAP: the inout receiver).
use features.{LanguageFeature, BuilderRow, KeywordRemedy}
use grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use diagnostics.{DiagCode}

export fn impls() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name             | build
        "impl_decl"      | build_impl
        "trait_decl"     | build_trait
        "mut_fn_decl"    | build_mut_fn
        "static_fn_decl" | build_static_fn
        "receiver"       | build_receiver
    }
    let codes = table<DiagCode> {
        kind                  | id      | summary
        "type.method"         | "F2030" | "a method call resolves through the receiver's impl"
        "type.impl"           | "F2031" | "an impl block serves one declared type"
        "type.orphan"         | "F2037" | "an impl lives in its type's package, or its trait's"
        "type.trait"          | "F2032" | "an impl-for answers every trait method, exactly"
        "type.mut_fn"         | "F2046" | "`mut fn` marks a method — it lives in an impl or a trait"
        "resolve.receiver"    | "F3024" | "`self` names a method's receiver"
        "resolve.nested_impl" | "F3025" | "impl and trait blocks live at the top level"
        "type.receiver"       | "F2047" | "a writing method is called on a `mut` place"
        "type.seat"           | "F2048" | "a `mut` seat is handed a `mut` place, one root per seat"
        "type.contract_write" | "F2049" | "a method writes only under a `mut fn` contract"
        "type.mut_fn_unused"  | "F2050" | "`mut fn` on a method that never writes"
        "type.seat_unused"    | "F2051" | "a `mut` seat the fn never writes through"
        "type.static_name"    | "F2059" | "a `static fn` and a variant of the same type cannot share a name"
    }
    let words = table<KeywordRemedy> {
        word     | help
        "self"   | "`self` is implicit in a method — drop it from the parameter list"
        "static" | "`static fn` declares a method with no receiver — in an `impl`, or a trait's associated fn"
    }
    component LanguageFeature f {
        name = "impls"
        docs = "`impl Target { … }`, `trait Show { fn sigs }`, `impl Show for Target { … }`, and `value.m(…)` — methods and behavior contracts, statically dispatched; `self` is the receiver, implicit; `mut fn` declares a method that writes it, and `static fn` declares one that has none — called `Type.name(…)`."
        gram = grammar {
            stmt = "impl" it:NAME ( "<" tp:NAME ( "," tp:NAME )* ","? ">" )? ( "for" ib:NAME ( "<" tp2:NAME ( "," tp2:NAME )* ","? ">" )? )? "{" ( fs:stmt | BREAK )* "}" END @recover(sync_to: "END") -> impl_decl(it, tp, ib, tp2, fs)
            stmt = "trait" tn:NAME "{" ( BREAK | ( sk:"static" )? ( mk:"mut" )? "fn" mn:NAME "(" ( ( pc:"const" )? ( pm:"mut" )? tps:NAME ( ":" tpt:type )? ( "," ( pc:"const" )? ( pm:"mut" )? tps:NAME ( ":" tpt:type )? )* ","? )? ")" ( "->" mr:type )? ( mb:block )? )* "}" END @recover(sync_to: "END") -> trait_decl(tn, sk, mk, mn, pc, pm, tps, tpt, mr, mb)
            stmt = "static" "fn" n:NAME ( "<" tp:NAME ( ":" tb:NAME )? ( "," tp:NAME ( ":" tb:NAME )? )* ","? ">" )? "(" ( ( ck:"const" )? ( mk:"mut" )? ps:NAME ( ":" pt:type )? ( "=" pd:expression )? ( "," ( ck:"const" )? ( mk:"mut" )? ps:NAME ( ":" pt:type )? ( "=" pd:expression )? )* ","? )? ")" ( "->" r:type )? b:block END -> static_fn_decl(n, tp, ck, mk, ps, pt, pd, r, b)
            stmt = "mut" "fn" n:NAME ( "<" tp:NAME ( ":" tb:NAME )? ( "," tp:NAME ( ":" tb:NAME )? )* ","? ">" )? "(" ( ( ck:"const" )? ( mk:"mut" )? ps:NAME ( ":" pt:type )? ( "=" pd:expression )? ( "," ( ck:"const" )? ( mk:"mut" )? ps:NAME ( ":" pt:type )? ( "=" pd:expression )? )* ","? )? ")" ( "->" r:type )? b:block END -> mut_fn_decl(n, tp, ck, mk, ps, pt, pd, r, b)
            primary = "self" -> receiver()
        }
        diags = codes
        builders = rows
        remedies = words
    }
    f
}
