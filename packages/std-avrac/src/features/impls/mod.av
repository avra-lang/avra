//! Methods and behavior contracts. An `impl Target { fns… }` block
//! gives a declared type its methods: every fn under it is a method,
//! `self` — a keyword, never written in the parameter list — is its
//! receiver, typed as the target and riding seat 0; the fn LOWERS
//! under a qualified name (`Target.method`), and a call `v.name(args)`
//! — parsed in the ladder, the paren witness telling it from a
//! property — resolves PROVABLY at typing through the receiver's
//! type. Never a runtime lookup (spec 4.5). `mut fn` DECLARES that a
//! method writes its receiver: a trait sig's contract, an inherent
//! method's documentation (ROADMAP: the inout receiver).
use features.{LanguageFeature, BuilderRow, KeywordRemedy}
use features.impls.{default_override}
use @std.grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use diagnostics.{DiagCode}

export fn impls() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name             | build
        "impl_decl"      | build_impl
        "trait_decl"     | build_trait
        "mut_fn_decl"    | build_mut_fn
        "static_fn_decl" | build_static_fn
        "receiver"       | build_receiver
    }
    let codes = table<DiagCode> {
        kind                   | summary
        "type.method"          | "a method call resolves through the receiver's impl"
        "type.impl"            | "an impl block serves one declared type"
        "type.orphan"          | "an impl lives in its type's package, or its trait's"
        "type.builtin_name"    | "an impl on a builtin type adds names, never changes one"
        "type.trait"           | "an impl-for answers every trait method, exactly"
        "type.trait_member"    | "a trait names each member once"
        "type.mut_fn"          | "`mut fn` marks a method — it lives in an impl or a trait"
        "resolve.receiver"     | "`self` names a method's receiver"
        "resolve.nested_impl"  | "impl and trait blocks live at the top level"
        "type.receiver"        | "a writing method is called on a `mut` place"
        "type.alias_copy"      | "a `mut` local copies a place — a write through it will not reach the place"
        "type.seat"            | "a `mut` seat is handed a `mut` place, one root per seat"
        "type.contract_write"  | "a method writes only under a `mut fn` contract"
        "type.mut_fn_unused"   | "`mut fn` on a method that never writes"
        "type.state_seat"      | "a `state` seat is a free fn's — a method has no caller's cell to reach"
        "type.seat_unused"     | "a `mut` seat the fn never writes through"
        "type.static_name"     | "a `static fn` and a variant of the same type cannot share a name"
        "type.derive_contract" | "a trait's `derive` takes one declaration and answers `List<Directive>`"
    }
    let words = table<KeywordRemedy> {
        word     | help
        "self"   | "`self` is implicit in a method — drop it from the parameter list"
        "static" | "`static fn` declares a method with no receiver — in an `impl`, or a trait's associated fn"
    }
    LanguageFeature impls {
        gram: grammar {
            stmt = "impl" it:NAME ( "<" tp:type ( "," tp:type )* ","? ">" )? ( "for" ib:NAME ( "<" tp2:NAME ( "," tp2:NAME )* ","? ">" )? )? "{" ( fs:stmt | BREAK )* "}" END @recover(sync_to: "END") -> impl_decl(it, tp, ib, tp2, fs)
            stmt = "trait" tn:NAME ( "<" tt:NAME ( "," tt:NAME )* ","? ">" )? "{" ( BREAK | ( sk:"static" )? ( mk:"mut" )? "fn" mn:NAME "(" ( ( pc:"const" )? ( pm:"mut" )? tps:NAME ( ":" tpt:type )? ( "," ( pc:"const" )? ( pm:"mut" )? tps:NAME ( ":" tpt:type )? )* ","? )? ")" ( "->" mr:type )? ( mb:block )? )* "}" END @recover(sync_to: "END") -> trait_decl(tn, sk, mk, mn, pc, pm, tps, tpt, mr, mb, tt)
            stmt = "static" "fn" n:NAME ( "<" tp:NAME ( ":" tb:NAME )? ( "," tp:NAME ( ":" tb:NAME )? )* ","? ">" )? "(" ( ( ( ck:"const" )? ( mk:"mut" )? ( ik:"isolated" )? ps:NAME ( ":" pt:type )? ( "=" pd:expression )? | sp:".." ps:HOLE ) ( "," ( ( ck:"const" )? ( mk:"mut" )? ( ik:"isolated" )? ps:NAME ( ":" pt:type )? ( "=" pd:expression )? | sp:".." ps:HOLE ) )* ","? )? ")" ( "->" r:type )? b:block END -> static_fn_decl(n, tp, ck, mk, ps, pt, pd, r, b, ik, sp)
            stmt = "mut" "fn" n:NAME ( "<" tp:NAME ( ":" tb:NAME )? ( "," tp:NAME ( ":" tb:NAME )? )* ","? ">" )? "(" ( ( ( ck:"const" )? ( mk:"mut" )? ( ik:"isolated" )? ps:NAME ( ":" pt:type )? ( "=" pd:expression )? | sp:".." ps:HOLE ) ( "," ( ( ck:"const" )? ( mk:"mut" )? ( ik:"isolated" )? ps:NAME ( ":" pt:type )? ( "=" pd:expression )? | sp:".." ps:HOLE ) )* ","? )? ")" ( "->" r:type )? b:block END -> mut_fn_decl(n, tp, ck, mk, ps, pt, pd, r, b, ik, sp)
            primary = "self" -> receiver()
        }
        diags: codes
        builders: rows
        remedies: words
    }
    impls
}
