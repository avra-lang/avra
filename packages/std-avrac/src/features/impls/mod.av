//! Methods (ROADMAP: rung 12 T1). An `impl Target { fns… }` block
//! gives a declared type its methods: each fn's bare `self` first
//! param types as the target, the fn LOWERS under a qualified name
//! (`Target.method`), and a call `v.name(args)` — parsed in the
//! ladder, the paren witness telling it from a property — resolves
//! PROVABLY at typing through the receiver's type. Never a runtime
//! lookup (spec 4.5).
use features.{LanguageFeature, BuilderRow}
use diagnostics.{DiagCode}

export fn impls() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name         | build
        "impl_decl"  | build_impl
        "trait_decl" | build_trait
    }
    let codes = table<DiagCode> {
        kind          | id      | summary
        "type.method" | "F2030" | "a method call resolves through the receiver's impl"
        "type.impl"   | "F2031" | "an impl block serves one declared type"
        "type.orphan" | "F2037" | "an impl lives in its type's module, or its trait's"
        "type.trait"  | "F2032" | "an impl-for answers every trait method, exactly"
    }
    component LanguageFeature f {
        name = "impls"
        docs = "`impl Target { … }`, `trait Show { fn sigs }`, `impl Show for Target { … }`, and `value.m(…)` — methods and behavior contracts, statically dispatched."
        gram = """
stmt = "impl" it:NAME ( "for" ib:NAME )? "{" ( fs:stmt | BREAK )* "}" BREAK @recover(sync_to: "BREAK") -> impl_decl(it, ib, fs)
stmt = "trait" tn:NAME "{" ( BREAK | "fn" mn:NAME "(" ( tps:NAME ( ":" tpt:type )? ( "," tps:NAME ( ":" tpt:type )? )* )? ")" "->" mr:type )* "}" BREAK @recover(sync_to: "BREAK") -> trait_decl(tn, mn, tps, tpt, mr)
"""
        diags = codes
        builders = rows
    }
    f
}
