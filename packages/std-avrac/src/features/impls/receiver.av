//! The rules of `self`: the receiver is what its body binds it to, typed and lowered as a name is.
use core.{Checking, Checks, ExprId, Expected, Lowering, Lowers, ReadAs, RECEIVER, Reg, SignedType}
use core.expr.{Receiver}

impl Checks for Receiver {
    /// `self` is the receiver's type; where no method binds one — a statement naming a binding
    /// `self` binds none — it is noted as a receiver nothing binds.
    fn checked(mut cx: Checking, e: ExprId, expected: Expected) -> SignedType? {
        if !cx.receiver_stands() { cx.unbound_read(e, RECEIVER, ReadAs.Receiver) }
        cx.read(e, RECEIVER)
    }
}

impl Lowers for Receiver {
    /// `self` is the receiver's seat, or its lane where a lambda reads it.
    fn lowered(mut cx: Lowering, e: ExprId) -> Reg {
        let b? = cx.bound(RECEIVER) else { return cx.unlowered(e) }
        cx.read(e, b)
    }
}
