//! The typing rule of a method call: the method's first seat takes the subject and each argument its
//! own seat, as a call's do, and the call is what the method answers.
use core.{Checking, Checks, ExprId, Expected, SignedType}
use core.expr.{MethodCall}

impl Checks for MethodCall {
    fn checked(mut cx: Checking, e: ExprId, expected: Expected) -> SignedType? {
        let subject = cx.check(self.subject, Expected.Free)
        let described = subject?.described()
        if described != null { return cx.variant_built(described!, self.name.of, self.args, expected) }
        let method = if subject == null { null } else { cx.method_of(subject!, self.name.of) }
        if method == null {
            cx.checked_free(self.args)
            return null
        }
        cx.applied(method!, subject!, self.args, expected)
    }
}
