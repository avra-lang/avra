//! The method laws. A call resolves through the RECEIVER'S TYPE —
//! its name keys the impl table — and the found sig judges the
//! arguments exactly as a fn call's does, `self` excluded (the
//! subject rides that seat).
use core.{ExprId, Type, TypeId, Arrow, StmtId, TypeRef, StructSig}
use features.{TypeCx, FnSig, spoken, this_is, accepts, construct_variant, bound_name, seats_judged}
use diagnostics.{error_at, pointed}

fn method_call_type(cx: TypeCx, e: ExprId) -> TypeId {
    // LICENSED I22: a feature cannot enumerate OTHER features' variants
    match cx.store.expr(e) {
        .MethodCall(subject, name, args) -> methoded(cx, e, subject, name, args),
        _ -> cx.error_type,
    }
}

fn methoded(cx: TypeCx, e: ExprId, subject: ExprId, name: string, args: List<ExprId>) -> TypeId {
    let sh: Type = cx.shape_at(subject)
    if sh is .Error { return cx.error_type }
    // the TYPE-receiver half of the one dot-call surface: a call
    // on a type NAME constructs its variant
    let built: TypeId? = type_receiver(cx, e, subject, name, args)
    if built != null { return built! }
    let bound: TypeId? = bounded_call(cx, e, subject, name, args)
    if bound != null { return bound! }
    let contracted: TypeId? = dyn_call(cx, e, subject, name, args)
    if contracted != null { return contracted! }
    let fielded: TypeId? = fn_field_call(cx, e, subject, name, args)
    if fielded != null { return fielded! }
    let named: string? = receiver_name(cx, subject)
    if named == null { return no_methods_here(cx, subject, name) }
    let target = named!
    let found: FnSig? = cx.method_sig(target, name)
    if found == null { return no_such_method(cx, e, target, name) }
    let sig = found!
    let wants = sig.params.length - 1
    if args.length != wants {
        return wrong_method_arity(cx, e, target, name, wants, args.length)
    }
    // LICENSED I3: params offset by the self seat; comprehensions cannot destructure enumerate
    for (j, a) in args.enumerate() {
        if !accepts(cx, a, sig.params[j + 1]) { wrong_method_argument(cx, target, name, j, sig.params[j + 1], a) }
    }
    sig.ret
}

/// The name a receiver's type answers to — the impl table's key.
/// Generic receivers wait for T2 (the impl's own tparams).
fn receiver_name(cx: TypeCx, subject: ExprId) -> string? {
    // the annotated bind RESTORES exhaustiveness checking (the
    // closure-field-call discipline) — matched directly, a new
    // Type variant would abort at runtime instead of failing here
    let sh: Type = cx.shape_at(subject)
    match sh {
        .Struct(_, n) -> n,
        .Enum(_, n) -> n,
        .Int or .Str or .Bool or .List(_) or .Res(_, _) or .App(_, _, _) or
        .TypeName(_, _) or .Var(_, _, _) or .Dyn(_, _) or .Fn(_, _) or .Opt(_) or .Null or
        .EmptyList or .Error -> null,
    }
}

// ── The voices ──

fn no_methods_here(cx: TypeCx, subject: ExprId, name: string) -> TypeId {
    let n = cx.name_at(subject)
    spoken(cx, pointed(
        error_at("type.method", cx.loc_of(subject), "`.${name}(…)` calls a method, and `${n}` has none"),
        this_is(n))
        with { help: "methods live on declared types — builtin vocabularies are recorded" })
}

fn no_such_method(cx: TypeCx, e: ExprId, target: string, name: string) -> TypeId {
    spoken(cx, pointed(
        error_at("type.method", cx.loc_of(e), "`${target}` has no method `${name}`"),
        "called here")
        with { help: "declare it — `impl ${target} { fn ${name}(self, …) -> … }`" })
}

fn wrong_method_arity(cx: TypeCx, e: ExprId, target: string, name: string, wants: int, found: int) -> TypeId {
    spoken(cx, pointed(
        error_at("type.method", cx.loc_of(e),
            "`${target}.${name}` takes ${wants} arguments beside `self`, found ${found}"),
        "this call"))
}

fn no_trait_method(cx: TypeCx, e: ExprId, trait_name: string, name: string, tname: string) -> TypeId {
    spoken(cx, pointed(
        error_at("type.method", cx.loc_of(e), "`${trait_name}` has no method `${name}`"),
        "called here")
        with { help: "the bound decides what `${tname}` can do" })
}

fn no_dyn_method(cx: TypeCx, e: ExprId, tname: string, name: string) -> TypeId {
    spoken(cx, pointed(
        error_at("type.method", cx.loc_of(e), "`${tname}` has no method `${name}`"),
        "called here")
        with { help: "the contract decides what a `dyn ${tname}` can do" })
}

fn wrong_method_argument(cx: TypeCx, target: string, name: string, j: int, want: TypeId, a: ExprId) {
    let n = cx.name_at(a)
    cx.emit(pointed(
        error_at("type.method", cx.loc_of(a),
            "argument ${j + 1} of `${target}.${name}` wants `${cx.types.name_of(want)}`, found `${n}`"),
        this_is(n)))
}

/// A dot-call on a FN-TYPED FIELD — the capability-record pattern:
/// `cx.walk(v)` calls the value the field holds. Absent when the
/// receiver has no such field or it is not fn-typed; the impl
/// table then gets its turn.
fn fn_field_call(cx: TypeCx, e: ExprId, subject: ExprId, name: string, args: List<ExprId>) -> TypeId? {
    let sig: StructSig? = cx.fields_of(cx.type_at(subject))
    if sig == null { return null }
    let slot: int? = sig!.slot_of(name)
    if slot == null { return null }
    let held: Arrow? = cx.types.arrow_parts(sig!.types[slot!])
    if held == null { return null }
    seats_judged(cx, e, name, held!.seats, held!.answer, args)
}

/// A dot-call whose receiver is a TYPE NAME — variant construction
/// through the shared law; absent for every value receiver.
fn type_receiver(cx: TypeCx, e: ExprId, subject: ExprId, name: string, args: List<ExprId>) -> TypeId? {
    match cx.shape_at(subject) {
        .TypeName(decl, tname) -> construct_variant(cx, e, decl, tname, name, args),
        _ -> null,
    }
}

/// A method on a BOUNDED type parameter: the bound's trait supplies
/// the sig (self omitted — the receiver fills that seat trivially);
/// mono resolves the concrete impl per specialization. Absent for
/// every non-Var receiver; an UNBOUNDED T refuses with the spec's
/// own remedy.
fn bounded_call(cx: TypeCx, e: ExprId, subject: ExprId, name: string, args: List<ExprId>) -> TypeId? {
    let seat: BoundSeat? = var_bound(cx, subject)
    if seat == null { return null }
    let tname = seat!.tparam
    let trait_name = seat!.bound
    if trait_name == "" {
        return spoken(cx, pointed(
            error_at("type.method", cx.loc_of(e),
                "`${tname}` has no known methods"),
            "called here")
            with { help: "add a bound — `<${tname}: SomeTrait>`" })
    }
    trait_judged(cx, e, trait_name, name, args) ?? no_trait_method(cx, e, trait_name, name, tname)
}

/// A method on a CONTRACT value: the trait's sig judges (self
/// omitted — the boxed value fills that seat at dispatch); the
/// runtime answers through the box. Absent for every non-dyn
/// receiver.
fn dyn_call(cx: TypeCx, e: ExprId, subject: ExprId, name: string, args: List<ExprId>) -> TypeId? {
    let sh: Type = cx.shape_at(subject)
    let tname: string? = match sh {
        .Dyn(_, n) -> n,
        _ -> null,
    }
    if tname == null { return null }
    trait_judged(cx, e, tname!, name, args) ?? no_dyn_method(cx, e, tname!, name)
}

/// The contract's judgment, shared by the bound and dyn halves:
/// the trait's sig judges arity and every seat — or absence when
/// the trait lacks the method (each caller speaks its own remedy).
fn trait_judged(cx: TypeCx, e: ExprId, trait_name: string, name: string, args: List<ExprId>) -> TypeId? {
    let found: FnSig? = cx.trait_sig(trait_name, name)
    if found == null { return null }
    let sig = found!
    if args.length != sig.params.length {
        return wrong_method_arity(cx, e, trait_name, name, sig.params.length, args.length)
    }
    // LICENSED I3: seat-by-seat; comprehensions cannot destructure enumerate
    for (j, a) in args.enumerate() {
        if !accepts(cx, a, sig.params[j]) { wrong_method_argument(cx, trait_name, name, j, sig.params[j], a) }
    }
    sig.ret
}

/// The subject's tparam name and its bound ("" unbounded), when the
/// subject is a Var.
type BoundSeat = { tparam: string, bound: string }

fn var_bound(cx: TypeCx, subject: ExprId) -> BoundSeat? {
    match cx.shape_at(subject) {
        .Var(decl, j, tname) -> BoundSeat { tparam: tname, bound: bound_name(cx, decl, j) },
        _ -> null,
    }
}

