//! The method laws. A call resolves through the RECEIVER'S TYPE —
//! its name keys the impl table — and the found sig judges the
//! arguments exactly as a fn call's does, `self` excluded (the
//! subject rides that seat).
use core.{ExprId, StmtId, TypeId, DeclId, DeclKind, same_type}
use features.{TypeCx, FnSig, this_is, MethodCall, RunChoice}
use diagnostics.{refusal}
use @std.errors.{Loc}

fn method_call_type(mut cx: TypeCx, e: ExprId) -> TypeId {
    // a feature cannot enumerate OTHER features' variants
    match cx.view.store.expr(e) {
        .MethodCall(subject, name, args) -> methoded(cx, e, subject, name.of, args),
        _ -> cx.error_type,
    }
}

fn methoded(mut cx: TypeCx, e: ExprId, subject: ExprId, name: string, args: List<ExprId>) -> TypeId {
    cx.settled_call(args, method_answer(cx, e, subject, name, args))
}

/// THE ONE DOT-CALL SURFACE: who answers is decided once (callee.av)
/// and every kind judges the call in its own law.
fn method_answer(mut cx: TypeCx, e: ExprId, subject: ExprId, name: string, args: List<ExprId>) -> TypeId {
    if cx.errored(subject) { return cx.error_type }
    let callee = callee_of(cx.view, cx.type_at(subject), name)
    if !seats_named(callee) && !cx.nameless(name, args) { return cx.error_type }
    match callee {
        .Variant(decl, tname) -> if cx.view.store.is_type_lit(e) { no_interned(cx, e, tname) } else { cx.construct_variant(e, decl, tname, name, args) },
        .Static(m, tname) -> static_call(cx, e, m, tname, name, args),
        .Bounded(decl, j, tname) -> bounded_call(cx, e, subject, decl, tname, cx.bound_name(decl, j), name, args),
        .Contract(tdecl, tname) -> dyn_call(cx, e, subject, tdecl, tname, name, args),
        .FnField(_, fty) -> fielded_call(cx, e, name, fty, args),
        .Row(r) -> r.check(cx, MethodCall { e: e, subject: subject, args: args }),
        .Declared(decl, tname) -> declared_call(cx, e, subject, decl, tname, name, args),
        .Nameless -> form_refusal(cx, e, cx.name_at(subject), name) ?? no_methods_here(cx, subject, name),
    }
}

/// Whether a dot-call's callee names its seats: a declared method's
/// and a static's do; a variant's payload, a contract's member, a fn
/// field and a runtime row take arguments by position.
fn seats_named(c: Callee) -> bool {
    match c {
        .Static(_, _) or .Declared(_, _) -> true,
        .Variant(_, _) or .Bounded(_, _, _) or .Contract(_, _) or .FnField(_, _) or .Row(_) or .Nameless -> false,
    }
}

/// The impl table's judgment: the found sig, instantiated for the
/// receiver, judges arity and every seat; the inout laws follow.
fn declared_call(
    mut cx: TypeCx,
    e: ExprId,
    subject: ExprId,
    decl: DeclId,
    target: string,
    name: string,
    args: List<ExprId>,
) -> TypeId {
    let many = cx.view.decls.methods_named(decl, name)
    let choosing = distinct_keys(cx, many) > 1
    let picked = if choosing { chosen_member(cx, e, target, name, many, args) } else { cx.view.decls.method(decl, name) }
    let m? = picked else {
        if choosing { return cx.error_type }
        return form_refusal(cx, e, target, name) ?? no_such_method(cx, e, target, name)
    }
    let found? = cx.view.decls.sig(m)?.fn_sig() else {
        return form_refusal(cx, e, target, name) ?? no_such_method(cx, e, target, name)
    }
    // a member chosen at run answers what every member answers; its
    // arguments are judged as any call's, the `dyn` one as itself
    let run = if choosing { cx.facts.dispatch_at(e) } else { null }
    if run != null { return dispatched_answer(cx, target, name, run!, found, args) }
    let at = generic_default_at(cx, e, subject, m, found, args)
    if at.refused { return cx.error_type }
    let sig = selfed_sig(cx, subject, m, instantiated_sig(cx, e, subject, decl, found), at.args)
    let placed? = cx.placed(e, "${target}.${name}", m, args, seats_of(sig).params) else { return cx.error_type }
    if placed.args.length != placed.wants.length {
        return wrong_method_arity(cx, e, target, name, placed.wants.length, placed.args.length)
    }
    for j, a in placed.args {
        if !cx.accepts(a, placed.wants[j]) { wrong_method_argument(cx, target, name, j, placed.wants[j], a) }
    }
    if !seat_laws(cx, e, subject, "${target}.${name}", name, m, placed.args, 1) { return cx.error_type }
    sig.ret
}

/// A STATIC's call: a plain fn call under a type's name. No
/// receiver rides a seat, so every argument judges against the sig
/// exactly as written and the seats are numbered from zero.
fn static_call(
    mut cx: TypeCx,
    e: ExprId,
    m: DeclId,
    target: string,
    name: string,
    args: List<ExprId>,
) -> TypeId {
    let found? = cx.view.decls.sig(m)?.fn_sig() else { return form_refusal(cx, e, target, name) ?? no_such_method(cx, e, target, name) }
    let placed? = cx.placed(e, "${target}.${name}", m, args, found.params) else { return cx.error_type }
    if placed.args.length != placed.wants.length { return wrong_static_arity(cx, e, target, name, placed.wants.length, placed.args.length) }
    for j, a in placed.args {
        if !cx.accepts(a, placed.wants[j]) { wrong_method_argument(cx, target, name, j, placed.wants[j], a) }
    }
    if !cx.seat_contracts(e, "${target}.${name}", m, 0, placed.args, null) { return cx.error_type }
    found.ret
}

/// A trait member's sig on THIS receiver: the trait's `Self` is the
/// receiver's type — in every seat and the answer. A signatory's
/// own method names no `Self`, so it passes through.
fn selfed_sig(cx: TypeCx, subject: ExprId, m: DeclId?, sig: FnSig, trait_args: List<TypeId> = []) -> FnSig {
    if m == null { return sig }
    let contract? = cx.view.decls.decl(m!).parent else { return sig }
    if !cx.view.decls.is_trait(contract) { return sig }
    // a trait's own parameters stand for themselves where no call supplies them —
    // inside its default bodies, typed once over the trait
    let own = cx.view.decls.instance_vars(contract).slice(1, cx.view.decls.tparams(contract).length)
    let args = [cx.type_at(subject)].concat(if trait_args.is_empty() { own } else { trait_args })
    FnSig {
        params: [cx.view.types.substituted(p, contract, args) for p in sig.params],
        ret: cx.view.types.substituted(sig.ret, contract, args),
    }
}

/// A generic trait's DEFAULT at one call: its parameters read off the
/// call's arguments (then the wanted answer), and the receiver shown to
/// implement the trait there — the instantiation recorded for lowering.
/// Any other callee passes through with no arguments.
fn generic_default_at(
    mut cx: TypeCx,
    e: ExprId,
    subject: ExprId,
    m: DeclId,
    sig: FnSig,
    args: List<ExprId>,
) -> DefaultAt {
    let contract? = cx.view.decls.decl(m).parent else { return plain_at() }
    if !cx.view.decls.is_trait(contract) { return plain_at() }
    let takes = cx.view.decls.tparams(contract).length - 1
    if takes == 0 { return plain_at() }
    let unbound: List<TypeId?> = [null for _j in 0..takes]
    let by_seats = folded_binds(
        cx,
        contract,
        [sig.params[j + 1] for j, _a in args if j + 1 < sig.params.length],
        [cx.type_at(a) for a in args],
        unbound,
    )
    let want = cx.want_at(e)
    let binds = if want == null { by_seats } else { bound(cx, contract, sig.ret, want!, by_seats) }
    let name = cx.view.decls.decl(contract).name
    if binds.any(it == null) {
        default_unbound(cx, e, name)
        return refused_at()
    }
    let trait_args = [b! for b in binds]
    let recv = cx.type_at(subject)
    if !implements_at_args(cx, contract, recv, trait_args) {
        default_unimplemented(
            cx,
            e,
            name,
            cx.view.types.name_of(recv),
            [cx.view.types.name_of(t) for t in trait_args],
        )
        return refused_at()
    }
    cx.record_subst(e, contract, [recv].concat(trait_args), [])
    DefaultAt { args: trait_args, refused: false }
}

/// A generic trait's arguments at one call, or its refusal.
type DefaultAt = { args: List<TypeId>, refused: bool }

fn plain_at() -> DefaultAt { DefaultAt { args: [], refused: false } }

fn refused_at() -> DefaultAt { DefaultAt { args: [], refused: true } }

/// Each seat's type bound against its argument's, in order.
fn folded_binds(
    cx: TypeCx,
    g: DeclId,
    params: List<TypeId>,
    got: List<TypeId>,
    binds: List<TypeId?>,
) -> List<TypeId?> {
    mut out = binds
    for j, p in params { out = bound(cx, g, p, got[j], out) }
    out
}

/// `binds` with every parameter of `g` that `param` names bound to the
/// matching part of `arg` — the first binding wins.
fn bound(cx: TypeCx, g: DeclId, param: TypeId, arg: TypeId, binds: List<TypeId?>) -> List<TypeId?> {
    let types = cx.view.types
    match types.shape_of(param) {
        // LICENSED structs.index_compared: DECLARATION identity — whose Var this is
        .Var(d, j, _) -> if d.index == g.index && j > 0 && binds[j - 1] == null { [if k == j - 1 { arg } else { b } for k, b in binds] } else { binds },
        .List(p) -> match types.shape_of(arg) { .List(a) -> bound(cx, g, p, a, binds), _ -> binds },
        .Opt(p) -> match types.shape_of(arg) {
            .Opt(a) -> bound(cx, g, p, a, binds),
            _ -> bound(cx, g, p, arg, binds),
        },
        .Cell(p) -> match types.shape_of(arg) { .Cell(a) -> bound(cx, g, p, a, binds), _ -> binds },
        .Map(pk, pv) -> match types.shape_of(arg) {
            .Map(ak, av) -> bound(cx, g, pv, av, bound(cx, g, pk, ak, binds)),
            _ -> binds,
        },
        .Res(po, pe) -> match types.shape_of(arg) {
            .Res(ao, ae) -> bound(cx, g, pe, ae, bound(cx, g, po, ao, binds)),
            _ -> binds,
        },
        _ -> binds,
    }
}

/// Whether the receiver answers the trait at these arguments: each
/// member the trait leaves to its impls has a method whose seats are
/// the trait's, instantiated there.
fn implements_at_args(cx: TypeCx, g: DeclId, recv: TypeId, trait_args: List<TypeId>) -> bool {
    let d? = cx.view.decls.implementor(recv) else { return false }
    let at = [recv].concat(trait_args)
    cx.view.decls.trait_fns(g).all((r) -> cx.view.decls.has_body(r) || answered_at(cx, d, r, g, at))
}

fn answered_at(cx: TypeCx, d: DeclId, r: DeclId, g: DeclId, at: List<TypeId>) -> bool {
    let want? = cx.view.decls.sig(r)?.fn_sig() else { return false }
    let seats = [cx.view.types.substituted(p, g, at) for p in want.params]
    cx.view.decls.methods_named(d, cx.view.decls.decl(r).name).any((m) -> same_seats(cx, m, seats))
}

fn same_seats(cx: TypeCx, m: DeclId, seats: List<TypeId>) -> bool {
    let sig? = cx.view.decls.sig(m)?.fn_sig() else { return false }
    sig.params.length == seats.length &&
        [j for j, p in sig.params if j > 0 && !same_type(p, seats[j])].is_empty()
}

/// THE INOUT LAWS at a call: a writing callee needs a `mut` place
/// receiver, and its `mut` seats need `mut` places, no two on one
/// root. Seats count from `base` (1 past a method's own receiver).
fn seat_laws(
    mut cx: TypeCx,
    e: ExprId,
    subject: ExprId,
    callee: string,
    name: string,
    m: DeclId,
    args: List<ExprId>,
    base: int,
) -> bool {
    let writes = cx.view.decls.writes_receiver(m)
    cx.receiver_law(e, subject, name, writes)
    cx.seat_contracts(e, callee, m, base, args, if writes { subject } else { null })
}

/// Among a type's same-named members — one generic trait implemented
/// at several arguments — the ONE whose seats fit the arguments,
/// recorded for lowering. None, or several, is refused.
fn chosen_member(
    mut cx: TypeCx,
    e: ExprId,
    target: string,
    name: string,
    many: List<DeclId>,
    args: List<ExprId>,
) -> DeclId? {
    let by_args = [m for m in many if seats_fit(cx, m, args)]
    if by_args.is_empty() {
        let d? = dispatch_of(cx, many, args) else {
            no_member_fits(cx, e, target, name, [cx.view.decls.method_key(m) for m in many])
            return null
        }
        let unmet = unrealized(cx, d, args)
        if !unmet.is_empty() {
            members_incomplete(cx, e, target, name, unmet)
            return null
        }
        cx.record_dispatch(e, d)
        return d.members[0]
    }
    let want = cx.want_at(e)
    let fits = if by_args.length > 1 && want != null { [m for m in by_args if answers_fit(cx, m, want!)] } else { by_args }
    if fits.length == 1 {
        cx.record_chosen(e, fits[0])
        return fits[0]
    }
    let keys = (ms: List<DeclId>) -> [cx.view.decls.method_key(m) for m in ms]
    if fits.is_empty() { no_member_fits(cx, e, target, name, keys(many)) } else { members_ambiguous(cx, e, target, name, keys(fits)) }
    null
}

/// A run-time-chosen call's judgment: every argument but the `dyn`
/// one fills its seat; the `dyn` one is accepted as what it is.
fn dispatched_answer(
    mut cx: TypeCx,
    target: string,
    name: string,
    run: RunChoice,
    found: FnSig,
    args: List<ExprId>,
) -> TypeId {
    for j, a in args {
        let want = if j == run.seat { cx.type_at(a) } else { found.params[j + 1] }
        if !cx.accepts(a, want) { wrong_method_argument(cx, target, name, j, want, a) }
    }
    found.ret
}

/// The members one `dyn` argument's run-time type chooses among: that
/// argument is the only `dyn`, every other fits every member, each
/// member's seat there implements its trait, and all answer one type.
fn dispatch_of(cx: TypeCx, many: List<DeclId>, args: List<ExprId>) -> RunChoice? {
    let dyns = [j for j, a in args if dyn_trait(cx, cx.type_at(a)) != null]
    if dyns.length != 1 { return null }
    let k = dyns[0]
    let tr = dyn_trait(cx, cx.type_at(args[k]))!
    let sigs = [cx.view.decls.sig(m)?.fn_sig() for m in many]
    if !sigs.all((s) -> s != null && takes_dispatched(cx, s!, args, k, tr)) { return null }
    let answer = sigs[0]!.ret
    if sigs.any(!same_type(it!.ret, answer)) { return null }
    RunChoice { seat: k, members: many }
}

/// Whether a member takes the call with its `k`th seat an implementor
/// of `tr`, every other seat fitting its argument.
fn takes_dispatched(cx: TypeCx, s: FnSig, args: List<ExprId>, k: int, tr: DeclId) -> bool {
    s.params.length == args.length + 1 &&
        [j for j, a in args if j != k && cx.types_disagree(cx.type_at(a), s.params[j + 1])]
            .is_empty() &&
        implements_at(cx, s.params[k + 1], tr)
}

/// THE COMPLETENESS LAW: every type in the program that implements the
/// `dyn` argument's trait has a member here — so a value that reaches
/// this call is one some member takes, and the run-time choice never
/// misses. Answers the names of the types left without one.
fn unrealized(cx: TypeCx, d: RunChoice, args: List<ExprId>) -> List<string> {
    let tr = dyn_trait(cx, cx.type_at(args[d.seat]))!
    let taken = [seat_decl(cx, m, d.seat) for m in d.members]
    [cx.view.decls.decl(t).name for t in cx.view.decls.implementors_of(tr) if !taken.any((x) -> same_decl_as(t, x))]
}

/// The declaration of the type a member takes at a seat.
fn seat_decl(cx: TypeCx, m: DeclId, seat: int) -> DeclId? {
    let sig? = cx.view.decls.sig(m)?.fn_sig() else { return null }
    cx.view.decls.implementor(sig.params[seat + 1])
}

fn same_decl_as(t: DeclId, d: DeclId?) -> bool {
    // LICENSED structs.index_compared: DECLARATION identity
    d != null && d!.index == t.index
}

fn implements_at(cx: TypeCx, ty: TypeId, tr: DeclId) -> bool {
    let d? = cx.view.decls.implementor(ty) else { return false }
    cx.view.decls.implements(d, tr)
}

/// The trait a `dyn` type is over, or none.
fn dyn_trait(cx: TypeCx, ty: TypeId) -> DeclId? {
    match cx.view.types.shape_of(ty) { .Dyn(d, _) -> d, _ -> null }
}

/// How many members the names share, a generic trait's arguments
/// telling them apart — one when a name is simply declared twice.
fn distinct_keys(cx: TypeCx, many: List<DeclId>) -> int {
    let keys = [cx.view.decls.method_key(m) for m in many]
    [k for j, k in keys if keys.index_of(k) == j].length
}

/// Whether the member's answer fits what the call's seat wants.
fn answers_fit(cx: TypeCx, m: DeclId, want: TypeId) -> bool {
    let sig? = cx.view.decls.sig(m)?.fn_sig() else { return false }
    !cx.types_disagree(sig.ret, want)
}

/// Whether every argument's type fits the member's seat — seat 0 is
/// the receiver.
fn seats_fit(cx: TypeCx, m: DeclId, args: List<ExprId>) -> bool {
    let sig? = cx.view.decls.sig(m)?.fn_sig() else { return false }
    sig.params.length == args.length + 1 &&
        [j for j, a in args if cx.types_disagree(cx.type_at(a), sig.params[j + 1])].is_empty()
}

/// The declared type a receiver answers to, or absence. Generic
/// receivers wait for T2 (the impl's own tparams).
/// A method's sig on THIS receiver: a generic type's Vars replaced
/// by the receiver's arguments, the instantiation recorded so the
/// call names the body lowered for it.
fn instantiated_sig(mut cx: TypeCx, e: ExprId, subject: ExprId, decl: DeclId, sig: FnSig) -> FnSig {
    let args = cx.view.types.args_of(cx.type_at(subject))
    if args.is_empty() { return sig }
    cx.record_subst(e, decl, args, [])
    FnSig {
        params: [cx.view.types.substituted(p, decl, args) for p in sig.params],
        ret: cx.view.types.substituted(sig.ret, decl, args),
    }
}

/// An unanswered dot-call that is a grammar FORM refuses in the
/// form's words — a type literal's, or a keyword-named call's, the
/// form it failed to be. Null for an ordinary call: the caller's
/// own words apply.
fn form_refusal(mut cx: TypeCx, e: ExprId, target: string, name: string) -> TypeId? {
    if cx.view.store.is_type_lit(e) { return no_interned(cx, e, target) }
    if cx.keywords.contains(name) { return keyword_form(cx, e, name) }
    null
}

// ── The voices ──

fn no_methods_here(mut cx: TypeCx, subject: ExprId, name: string) -> TypeId {
    let n = cx.name_at(subject)
    cx
        .spoken(
            refusal(
                "type.method",
                cx.loc_of(subject),
                "`.${name}(…)` calls a method, and `${n}` has none",
                this_is(n),
                "methods live on lists, maps, and declared types with an `impl`",
            ),
        )
}

fn no_such_method(mut cx: TypeCx, e: ExprId, target: string, name: string) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.method",
                cx.loc_of(e),
                "`${target}` has no method `${name}`",
                "called here",
                "declare it — `impl ${target} { fn ${name}(…) -> … }`",
            ),
        )
}

/// A dot-call named by a KEYWORD is a grammar form that did not match
/// — no method can wear the name, so the remedy is the form's.
fn keyword_form(mut cx: TypeCx, e: ExprId, name: string) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.method",
                cx.loc_of(e),
                "`.${name}(…)` names no method — `${name}` is a keyword, and the grammar's form did not match",
                "written here",
                "a type literal is `.type(T)` over a TYPE: `int?`, `List<T>`, `fn(int) -> bool`, or a name holding an id",
            ),
        )
}

fn no_interned(mut cx: TypeCx, e: ExprId, target: string) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.method",
                cx.loc_of(e),
                "`.type(…)` interns into its receiver, and `${target}` has no `interned`",
                "written here",
                "declare `interned` on `${target}` — its seat is the enum the literal spells, its answer the id — or name a table that has one: `cx.type(…)`",
            ),
        )
}

fn wrong_method_arity(
    mut cx: TypeCx,
    e: ExprId,
    target: string,
    name: string,
    wants: int,
    found: int,
) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.method",
                cx.loc_of(e),
                "`${target}.${name}` takes ${wants} arguments beside `self`, found ${found}",
                "this call",
                null,
            ),
        )
}

fn no_trait_method(mut cx: TypeCx, e: ExprId, trait_name: string, name: string, tname: string) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.method",
                cx.loc_of(e),
                "`${trait_name}` has no method `${name}`",
                "called here",
                "the bound decides what `${tname}` can do",
            ),
        )
}

fn no_dyn_method(mut cx: TypeCx, e: ExprId, tname: string, name: string) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.method",
                cx.loc_of(e),
                "`${tname}` has no method `${name}`",
                "called here",
                "the contract decides what a `dyn ${tname}` can do",
            ),
        )
}

fn wrong_static_arity(
    mut cx: TypeCx,
    e: ExprId,
    target: string,
    name: string,
    wants: int,
    found: int,
) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.method",
                cx.loc_of(e),
                "`${target}.${name}` takes ${seat_word(wants)}, found ${found}",
                "this call",
                "a `static fn` has no receiver — every seat is written",
            ),
        )
}

fn seat_word(n: int) -> string {
    if n == 1 { "1 argument" } else { "${n} arguments" }
}

fn wrong_method_argument(
    mut cx: TypeCx,
    target: string,
    name: string,
    j: int,
    want: TypeId,
    a: ExprId,
) {
    let n = cx.name_at(a)
    cx
        .emit(
            cx
                .named_fix(
                    refusal(
                        "type.method",
                        cx.loc_of(a),
                        "argument ${j + 1} of `${target}.${name}` wants `${cx.view.types.name_of(want)}`, found `${n}`",
                        this_is(n),
                        null,
                    ),
                    want,
                    a,
                ),
        )
}

/// A dot-call on a FN-TYPED FIELD — the capability-record pattern:
/// `cx.walk(v)` calls the value the field holds; the field's arrow
/// judges the seats.
fn fielded_call(mut cx: TypeCx, e: ExprId, name: string, fty: TypeId, args: List<ExprId>) -> TypeId {
    let arrow? = cx.view.types.arrow_parts(fty) else { return cx.error_type }
    cx.seats_judged(e, name, arrow.seats, arrow.marks, arrow.answer, args)
}

/// A method on a BOUNDED type parameter: the bound's trait supplies
/// the sig (no receiver seat — the receiver fills it trivially);
/// mono resolves the concrete impl per specialization. An UNBOUNDED
/// T refuses with the spec's own remedy.
fn bounded_call(
    mut cx: TypeCx,
    e: ExprId,
    subject: ExprId,
    decl: DeclId,
    tname: string,
    trait_name: string,
    name: string,
    args: List<ExprId>,
) -> TypeId {
    if trait_name == "" {
        return cx
            .spoken(
                refusal(
                    "type.method",
                    cx.loc_of(e),
                    "`${tname}` has no known methods",
                    "called here",
                    bound_remedy(cx.view.decls.decl(decl).kind, tname),
                ),
            )
    }
    trait_judged(cx, e, subject, trait_name, name, args) ?? no_trait_method(
        cx,
        e,
        trait_name,
        name,
        tname,
    )
}

/// A REMEDY NAMES A FORM THAT PARSES. A bound is written on a fn's
/// type parameters and nowhere else — a type's and an impl's refuse
/// it at the `<` — so telling every unbounded parameter to add one
/// sends half of them at a form the grammar has no rule for.
fn bound_remedy(kind: DeclKind, tname: string) -> string {
    match kind {
        .Record or .Named or .Alias or .Enum or .Impl or .CollectEnum -> "a type's and an impl's parameters take no bound yet — a bounded generic is a free `fn<${tname}: SomeTrait>` for now",
        .Fn or .Method or .Trait or .Default or .Case or .Main or .Const or .Syntax or .Builtin or .Collect -> "add a bound — `<${tname}: SomeTrait>`",
    }
}

/// A method on a CONTRACT value: the trait's sig judges (self
/// omitted — the boxed value fills that seat at dispatch); the
/// runtime answers through the box.
fn dyn_call(
    mut cx: TypeCx,
    e: ExprId,
    subject: ExprId,
    tdecl: DeclId,
    tname: string,
    name: string,
    args: List<ExprId>,
) -> TypeId {
    let member? = cx.view.decls.trait_member(tdecl, name) else { return no_dyn_method(cx, e, tname, name) }
    contract_judged(cx, e, subject, tname, name, args, member)
}

/// The contract's own laws, then its judgment: the member's word
/// decides the receiver and the seats for every signatory.
fn contract_judged(
    mut cx: TypeCx,
    e: ExprId,
    subject: ExprId,
    trait_name: string,
    name: string,
    args: List<ExprId>,
    member: DeclId,
) -> TypeId {
    let found? = cx.view.decls.sig(member)?.fn_sig() else { return cx.error_type }
    let writes = cx.view.decls.declares_writing(member)
    cx.receiver_law(e, subject, name, writes)
    if !cx
        .seat_contracts(e, "${trait_name}.${name}", member, 1, args, if writes { subject } else { null }) {
        return cx.error_type
    }
    sig_judged(cx, e, trait_name, name, args, seats_of(selfed_sig(cx, subject, member, found)))
}

/// A method sig past its receiver — what the arguments fill.
fn seats_of(sig: FnSig) -> FnSig {
    FnSig { params: sig.params.slice(1, sig.params.length), ret: sig.ret }
}

/// The contract's judgment, shared by the bound and dyn halves:
/// the trait's sig judges arity and every seat — or absence when
/// the trait lacks the method (each caller speaks its own remedy).
fn trait_judged(
    mut cx: TypeCx,
    e: ExprId,
    subject: ExprId,
    trait_name: string,
    name: string,
    args: List<ExprId>,
) -> TypeId? {
    let tdecl? = cx.view.decls.trait_named(cx.names, trait_name) else { return null }
    let member? = cx.view.decls.trait_member(tdecl, name) else { return null }
    contract_judged(cx, e, subject, trait_name, name, args, member)
}

/// A method sig's judgment — its seats past the receiver — over the
/// arguments.
fn sig_judged(
    mut cx: TypeCx,
    e: ExprId,
    trait_name: string,
    name: string,
    args: List<ExprId>,
    sig: FnSig,
) -> TypeId {
    if args.length != sig.params.length {
        return wrong_method_arity(cx, e, trait_name, name, sig.params.length, args.length)
    }
    for j, a in args {
        if !cx.accepts(a, sig.params[j]) { wrong_method_argument(cx, trait_name, name, j, sig.params[j], a) }
    }
    sig.ret
}

/// The subject's tparam name and its bound ("" unbounded), when the
/// subject is a Var.

// ── The derive contract, where a trait declares it ──

/// A TRAIT'S `derive` IS HELD TO ITS CONTRACT WHERE IT IS WRITTEN —
/// `static fn derive(t: Type) -> List<Directive>`, and a `marks`
/// beside it `static fn marks(t: Type) -> List<string>` — so the
/// library's author hears it at their own build, never first at a
/// user's `@derive`. `Fn` or `Named` may stand for `Type`.
export fn derive_contract(mut cx: TypeCx, s: StmtId) {
    let tr? = cx.view.decls.decl_of(cx.view.file, s) else { return }
    if !(cx.view.decls.decl(tr).kind is .Trait) { return }
    let derive? = cx.view.decls.trait_derive(tr) else { return }
    if !member_fits(cx, derive, (ret: TypeId) -> directives(cx, ret)) { derive_shape(cx, derive) }
    let marks? = cx.view.decls.trait_marks(tr) else { return }
    if !member_fits(cx, marks, (ret: TypeId) -> same_type(ret, cx.type(List<string>))) { marks_shape(cx, marks) }
}

/// Whether a trait member is static, takes one declaration, and
/// answers what `answers` accepts.
fn member_fits(cx: TypeCx, m: DeclId, answers: fn(TypeId) -> bool) -> bool {
    let sig? = cx.view.decls.sig(m)?.fn_sig() else { return true }
    let x = cx.view.decls.decl(m)
    cx.view.decls.store_of(x.file).is_static(x.stmt) &&
        sig.params.length == 1 &&
        cx.view.decls.takes_a_decl(sig.params[0]) &&
        answers(sig.ret)
}

/// Whether an answer is `@std.meta`'s `List<Directive>`.
fn directives(cx: TypeCx, ret: TypeId) -> bool {
    match cx.view.types.shape_of(ret) {
        .List(e) -> cx.view.decls.meta_type(e, "Directive"),
        _ -> false,
    }
}

fn derive_shape(mut cx: TypeCx, m: DeclId) {
    cx
        .emit(
            refusal(
                "type.derive_contract",
                member_loc(cx, m),
                "a trait's `derive` is `static fn derive(t: Type) -> List<Directive>`",
                "declared here",
                "take the declaration (`t: Type`, `f: Fn` or `n: Named`) and answer `List<Directive>` from `@std.meta`, as a `static fn`",
            ),
        )
}

fn marks_shape(mut cx: TypeCx, m: DeclId) {
    cx
        .emit(
            refusal(
                "type.derive_contract",
                member_loc(cx, m),
                "a trait's `marks` is `static fn marks(t: Type) -> List<string>`",
                "declared here",
                "take the same declaration its `derive` takes, and answer the mark names it reads",
            ),
        )
}

fn member_loc(cx: TypeCx, m: DeclId) -> Loc? {
    cx.view.stmt_loc(cx.view.decls.decl(m).stmt)
}

fn no_member_fits(mut cx: TypeCx, e: ExprId, target: string, name: string, keys: List<string>) {
    cx
        .emit(
            refusal(
                "type.method",
                cx.loc_of(e),
                "no `${target}.${name}` takes these arguments",
                "called here",
                "`${target}` declares ${keys.join(", ")} — pass an argument one of them takes",
            ),
        )
}

fn members_ambiguous(mut cx: TypeCx, e: ExprId, target: string, name: string, keys: List<string>) {
    cx
        .emit(
            refusal(
                "type.method",
                cx.loc_of(e),
                "`${target}.${name}` fits these arguments as ${keys.join(" and as ")}",
                "called here",
                "a call names one member — make an argument's type, or the answer's wanted type, say which",
            ),
        )
}

fn members_incomplete(mut cx: TypeCx, e: ExprId, target: string, name: string, unmet: List<string>) {
    cx
        .emit(
            refusal(
                "type.method",
                cx.loc_of(e),
                "`${target}.${name}` is chosen by a `dyn` argument's type, and no member takes ${unmet.join(", ")}",
                "called here",
                "every type that can reach this call needs a member — implement it for ${unmet.join(", ")}",
            ),
        )
}

fn default_unbound(mut cx: TypeCx, e: ExprId, trait_name: string) {
    cx
        .emit(
            refusal(
                "type.method",
                cx.loc_of(e),
                "this call to a `${trait_name}` default does not say what its type parameters are",
                "called here",
                "pass an argument whose type names them, or bind the answer to a typed `let`",
            ),
        )
}

fn default_unimplemented(
    mut cx: TypeCx,
    e: ExprId,
    trait_name: string,
    recv: string,
    args: List<string>,
) {
    cx
        .emit(
            refusal(
                "type.method",
                cx.loc_of(e),
                "`${recv}` does not implement `${trait_name}<${args.join(", ")}>`",
                "called here",
                "a default runs through the impl at its arguments — implement `${trait_name}<${args.join(", ")}>` for `${recv}`",
            ),
        )
}
