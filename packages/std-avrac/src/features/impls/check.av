//! The method laws. A call resolves through the RECEIVER'S TYPE —
//! its name keys the impl table — and the found sig judges the
//! arguments exactly as a fn call's does, `self` excluded (the
//! subject rides that seat).
use core.{ExprId, TypeId, Arrow, DeclId}
use features.{TypeCx, FnSig, spoken, this_is, accepts, construct_variant, bound_name, seats_judged, settled_call, trait_member, trait_named, MethodCall, receiver_law, mut_seats_law, fn_sig_of}
use diagnostics.{refusal}

fn method_call_type(mut cx: TypeCx, e: ExprId) -> TypeId {
    // LICENSED I22: a feature cannot enumerate OTHER features' variants
    match cx.view.store.expr(e) {
        .MethodCall(subject, name, args) -> methoded(cx, e, subject, name, args),
        _ -> cx.error_type,
    }
}

fn methoded(mut cx: TypeCx, e: ExprId, subject: ExprId, name: string, args: List<ExprId>) -> TypeId {
    settled_call(cx, args, method_answer(cx, e, subject, name, args))
}

/// THE ONE DOT-CALL SURFACE: who answers is decided once (callee.av)
/// and every kind judges the call in its own law.
fn method_answer(mut cx: TypeCx, e: ExprId, subject: ExprId, name: string, args: List<ExprId>) -> TypeId {
    if cx.errored(subject) { return cx.error_type }
    match callee_of(cx.view, cx.type_at(subject), name) {
        .Variant(decl, tname) -> construct_variant(cx, e, decl, tname, name, args),
        .Bounded(decl, j, tname) -> bounded_call(cx, e, subject, tname, bound_name(cx, decl, j), name, args),
        .Contract(tdecl, tname) -> dyn_call(cx, e, subject, tdecl, tname, name, args),
        .FnField(_, fty) -> fielded_call(cx, e, name, fty, args),
        .Row(r) -> r.check(cx, MethodCall { e: e, subject: subject, args: args }),
        .Declared(decl, tname) -> declared_call(cx, e, subject, decl, tname, name, args),
        .Nameless -> no_methods_here(cx, subject, name),
    }
}

/// The impl table's judgment: the found sig, instantiated for the
/// receiver, judges arity and every seat; the inout laws follow.
fn declared_call(mut cx: TypeCx, e: ExprId, subject: ExprId, decl: DeclId, target: string, name: string, args: List<ExprId>) -> TypeId {
    let found: FnSig? = cx.method_sig(decl, name)
    if found == null { return no_such_method(cx, e, target, name) }
    let m: DeclId? = cx.view.decls.method(decl, name)
    let sig = selfed_sig(cx, subject, m, instantiated_sig(cx, e, subject, decl, found!))
    let wants = sig.params.length - 1
    if args.length != wants {
        return wrong_method_arity(cx, e, target, name, wants, args.length)
    }
    for j, a in args {
        if !accepts(cx, a, sig.params[j + 1]) { wrong_method_argument(cx, target, name, j, sig.params[j + 1], a) }
    }
    if m != null { seat_laws(cx, e, subject, "${target}.${name}", name, m!, args, 1) }
    sig.ret
}

/// A trait member's sig on THIS receiver: the trait's `Self` is the
/// receiver's type — in every seat and the answer. A signatory's
/// own method names no `Self`, so it passes through.
fn selfed_sig(mut cx: TypeCx, subject: ExprId, m: DeclId?, sig: FnSig) -> FnSig {
    if m == null { return sig }
    let parent: DeclId? = cx.view.decls.decl(m!).parent
    if parent == null { return sig }
    let contract = parent!
    if !cx.view.decls.is_trait(contract) { return sig }
    let recv = cx.type_at(subject)
    FnSig {
        params: [cx.view.types.substituted(p, contract, [recv]) for p in sig.params],
        ret: cx.view.types.substituted(sig.ret, contract, [recv]),
    }
}

/// THE INOUT LAWS at a call: a writing callee needs a `mut` place
/// receiver, and its `mut` seats need `mut` places, no two on one
/// root. Seats count from `base` (1 past a method's own receiver).
fn seat_laws(mut cx: TypeCx, e: ExprId, subject: ExprId, callee: string, name: string, m: DeclId, args: List<ExprId>, base: int) {
    let writes = cx.view.decls.writes_receiver(m)
    receiver_law(cx, e, subject, name, writes)
    mut_seats_law(cx, e, callee, m, args, base, if writes { subject } else { null })
}

/// The declared type a receiver answers to, or absence. Generic
/// receivers wait for T2 (the impl's own tparams).
/// A method's sig on THIS receiver: a generic type's Vars replaced
/// by the receiver's arguments, the instantiation recorded so the
/// call names the body lowered for it.
fn instantiated_sig(mut cx: TypeCx, e: ExprId, subject: ExprId, decl: DeclId, sig: FnSig) -> FnSig {
    let args = cx.view.types.args_of(cx.type_at(subject))
    if args.is_empty() { return sig }
    cx.record_subst(e, decl, args)
    FnSig {
        params: [cx.view.types.substituted(p, decl, args) for p in sig.params],
        ret: cx.view.types.substituted(sig.ret, decl, args),
    }
}

// ── The voices ──

fn no_methods_here(mut cx: TypeCx, subject: ExprId, name: string) -> TypeId {
    let n = cx.name_at(subject)
    spoken(cx, refusal("type.method", cx.loc_of(subject), "`.${name}(…)` calls a method, and `${n}` has none", this_is(n), "methods live on lists, maps, and declared types with an `impl`"))
}

fn no_such_method(mut cx: TypeCx, e: ExprId, target: string, name: string) -> TypeId {
    spoken(cx, refusal("type.method", cx.loc_of(e), "`${target}` has no method `${name}`", "called here", "declare it — `impl ${target} { fn ${name}(…) -> … }`"))
}

fn wrong_method_arity(mut cx: TypeCx, e: ExprId, target: string, name: string, wants: int, found: int) -> TypeId {
    spoken(cx, refusal("type.method", cx.loc_of(e), "`${target}.${name}` takes ${wants} arguments beside `self`, found ${found}", "this call", null))
}

fn no_trait_method(mut cx: TypeCx, e: ExprId, trait_name: string, name: string, tname: string) -> TypeId {
    spoken(cx, refusal("type.method", cx.loc_of(e), "`${trait_name}` has no method `${name}`", "called here", "the bound decides what `${tname}` can do"))
}

fn no_dyn_method(mut cx: TypeCx, e: ExprId, tname: string, name: string) -> TypeId {
    spoken(cx, refusal("type.method", cx.loc_of(e), "`${tname}` has no method `${name}`", "called here", "the contract decides what a `dyn ${tname}` can do"))
}

fn wrong_method_argument(mut cx: TypeCx, target: string, name: string, j: int, want: TypeId, a: ExprId) {
    let n = cx.name_at(a)
    cx.emit(refusal("type.method", cx.loc_of(a), "argument ${j + 1} of `${target}.${name}` wants `${cx.view.types.name_of(want)}`, found `${n}`", this_is(n), null))
}

/// A dot-call on a FN-TYPED FIELD — the capability-record pattern:
/// `cx.walk(v)` calls the value the field holds; the field's arrow
/// judges the seats.
fn fielded_call(mut cx: TypeCx, e: ExprId, name: string, fty: TypeId, args: List<ExprId>) -> TypeId {
    let held: Arrow? = cx.view.types.arrow_parts(fty)
    if held == null { return cx.error_type }
    seats_judged(cx, e, name, held!.seats, held!.answer, args)
}

/// A method on a BOUNDED type parameter: the bound's trait supplies
/// the sig (no receiver seat — the receiver fills it trivially);
/// mono resolves the concrete impl per specialization. An UNBOUNDED
/// T refuses with the spec's own remedy.
fn bounded_call(mut cx: TypeCx, e: ExprId, subject: ExprId, tname: string, trait_name: string, name: string, args: List<ExprId>) -> TypeId {
    if trait_name == "" {
        return spoken(cx, refusal("type.method", cx.loc_of(e), "`${tname}` has no known methods", "called here", "add a bound — `<${tname}: SomeTrait>`"))
    }
    trait_judged(cx, e, subject, trait_name, name, args) ?? no_trait_method(cx, e, trait_name, name, tname)
}

/// A method on a CONTRACT value: the trait's sig judges (self
/// omitted — the boxed value fills that seat at dispatch); the
/// runtime answers through the box.
fn dyn_call(mut cx: TypeCx, e: ExprId, subject: ExprId, tdecl: DeclId, tname: string, name: string, args: List<ExprId>) -> TypeId {
    let member: DeclId? = trait_member(cx.view.decls, tdecl, name)
    if member == null { return no_dyn_method(cx, e, tname, name) }
    contract_judged(cx, e, subject, tname, name, args, member!)
}

/// The contract's own laws, then its judgment: the member's word
/// decides the receiver and the seats for every signatory.
fn contract_judged(mut cx: TypeCx, e: ExprId, subject: ExprId, trait_name: string, name: string, args: List<ExprId>, member: DeclId) -> TypeId {
    let found: FnSig? = fn_sig_of(cx.view.decls.sig(member))
    if found == null { return cx.error_type }
    let writes = cx.view.decls.declares_writing(member)
    receiver_law(cx, e, subject, name, writes)
    mut_seats_law(cx, e, "${trait_name}.${name}", member, args, 1, if writes { subject } else { null })
    sig_judged(cx, e, trait_name, name, args, seats_of(selfed_sig(cx, subject, member, found!)))
}

/// A method sig past its receiver — what the arguments fill.
fn seats_of(sig: FnSig) -> FnSig {
    FnSig { params: sig.params.slice(1, sig.params.length), ret: sig.ret }
}

/// The contract's judgment, shared by the bound and dyn halves:
/// the trait's sig judges arity and every seat — or absence when
/// the trait lacks the method (each caller speaks its own remedy).
fn trait_judged(mut cx: TypeCx, e: ExprId, subject: ExprId, trait_name: string, name: string, args: List<ExprId>) -> TypeId? {
    let tdecl: DeclId? = trait_named(cx.view.decls, cx.names, trait_name)
    if tdecl == null { return null }
    let member: DeclId? = trait_member(cx.view.decls, tdecl!, name)
    if member == null { return null }
    contract_judged(cx, e, subject, trait_name, name, args, member!)
}

/// A method sig's judgment — its seats past the receiver — over the
/// arguments.
fn sig_judged(mut cx: TypeCx, e: ExprId, trait_name: string, name: string, args: List<ExprId>, sig: FnSig) -> TypeId {
    if args.length != sig.params.length {
        return wrong_method_arity(cx, e, trait_name, name, sig.params.length, args.length)
    }
    for j, a in args {
        if !accepts(cx, a, sig.params[j]) { wrong_method_argument(cx, trait_name, name, j, sig.params[j], a) }
    }
    sig.ret
}

/// The subject's tparam name and its bound ("" unbounded), when the
/// subject is a Var.

