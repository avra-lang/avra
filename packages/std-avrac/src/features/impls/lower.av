//! The method call's lowering — the ONE meaning: a direct Call to
//! the QUALIFIED name, the subject riding the self seat. The name
//! derives from the receiver's type both here and at the fn loop,
//! so no fact table carries it.
use core.{ExprId, Reg, Ins, DeclId, TypeId}
use features.{LowerCx, MethodCall}

/// The receiver's value: seat 0 of the body, as its binding says.
fn receiver_reg(mut cx: LowerCx, e: ExprId) -> Reg {
    cx.def_reg(e) ?? cx.lower_defect(e, "a receiver outside a method survived resolve")
}

fn method_call_reg(mut cx: LowerCx, e: ExprId) -> Reg {
    // a feature cannot enumerate OTHER features' variants
    match cx.view.store.expr(e) {
        .MethodCall(subject, name, args) -> match callee_of(cx.view, cx.type_at(subject), name.of) {
            .Variant(_, _) -> built_variant(cx, e, name.of, args),
            .Static(m, _) -> static_dispatch(cx, e, m, args),
            .Bounded(_, _, _) -> cx.lower_defect(e, "a bounded receiver survived mono"),
            .Contract(tdecl, _) -> dyn_dispatch(cx, e, subject, tdecl, name.of, args),
            .FnField(slot, fty) -> fielded_dispatch(cx, e, subject, slot, fty, args),
            .Row(r) -> r.lower(cx, MethodCall { e: e, subject: subject, args: args }),
            .Declared(decl, _) -> declared_dispatch(cx, e, subject, decl, name.of, args),
            .Nameless -> cx.lower_defect(e, "a method on a nameless receiver survived typing"),
        },
        _ -> cx.foreign_node(e),
    }
}

/// The contract's dispatch: the box carries [value, methods…] in
/// trait-declaration order — slot 0 rides the self seat, slot
/// 1+ordinal holds the code pointer.
fn dyn_dispatch(mut cx: LowerCx, e: ExprId, subject: ExprId, tdecl: DeclId, name: string, args: List<ExprId>) -> Reg {
    let ordinal = cx.view.decls.trait_method_names(tdecl).index_of(name)
    if ordinal < 0 { return cx.lower_defect(e, "a dyn method outside its trait survived typing") }
    let s = seated(cx, e, subject, args)
    let data = boxed_value(cx, e, subject, s.recv)
    let fp = cx.slot_read(s.recv, 1 + ordinal, null)
    let dst = cx.result(e)
    cx.emit(Ins.CallPtr(dst, fp, [data].concat(s.args)))
    dst
}

/// A contract box's value, the method's `self`. A copied receiver's box
/// was opened unique, and its value is opened with it — the box alone
/// would still share the value it wraps.
fn boxed_value(mut cx: LowerCx, e: ExprId, subject: ExprId, box: Reg) -> Reg {
    if !cx.facts.wants_alias_copy(e) { return cx.slot_read(box, 0, cx.type_at(subject)) }
    cx.owned_slot_unique(cx.shape_at(subject), box, cx.const_int(0))
}

/// A call's receiver register and its argument registers.
type Seated = { recv: Reg, args: List<Reg> }

/// Evaluation is left to right, but a receiver rooted in a `mut` CELL is
/// READ after its arguments: an argument writing through the same cell
/// may re-point it (a copy opened unique), and a receiver read first
/// would be the box left behind. Its path's index operands still run
/// first, in order.
fn seated(mut cx: LowerCx, e: ExprId, subject: ExprId, args: List<ExprId>) -> Seated {
    if !in_cell(cx, subject) {
        let recv = cx.reg_of(subject)
        return Seated { recv: recv, args: [cx.reg_of(a) for a in args] }
    }
    for i in path_indexes(cx, subject) { let _ = cx.reg_of(i) }
    let regs = [cx.reg_of(a) for a in args]
    Seated { recv: receiver_reg_of(cx, e, subject), args: regs }
}

/// The index operands on a place's path, in written order.
fn path_indexes(cx: LowerCx, e: ExprId) -> List<ExprId> {
    let step? = cx.view.store.place_step(e) else { return [] }
    match step {
        .Root(_) -> [],
        .Field(subject, _) -> path_indexes(cx, subject),
        .At(subject, index) -> path_indexes(cx, subject).concat([index]),
    }
}

/// Whether a receiver is a place rooted in a `mut` binding's cell.
fn in_cell(cx: LowerCx, subject: ExprId) -> bool {
    let root? = cx.view.store.place_root(subject) else { return false }
    cx.cell_of(root) != null
}

/// A writing call's receiver register: the alias-copy law's predicate
/// (features/checks.av's `alias_copy_law`), recorded as a fact at
/// checking and read here — a bare `mut` local copied from a place, or
/// from what a place holds, opens its cell unique before the call, so the
/// write lands in the copy; every other receiver (self, a parameter, a
/// construction, a fn's answer) stays shared, by design. Copy-on-write: a
/// cell already unique is returned as-is.
fn receiver_reg_of(mut cx: LowerCx, e: ExprId, subject: ExprId) -> Reg {
    if cx.facts.wants_alias_copy(e) { return cx.unique_box(subject) }
    cx.reg_of(subject)
}

/// The fn-FIELD call's lowering: read the field's box, then the
/// box's slot 0 — the code address — and go through the pointer,
/// the box riding seat 0.
fn fielded_dispatch(mut cx: LowerCx, e: ExprId, subject: ExprId, slot: int, fty: TypeId, args: List<ExprId>) -> Reg {
    let box = cx.slot_read(cx.reg_of(subject), slot, fty)
    cx.called_through(e, box, [cx.reg_of(a) for a in args])
}

/// The impl table's dispatch: a direct Call to the method's
/// qualified symbol, the subject riding the self seat.
fn declared_dispatch(mut cx: LowerCx, e: ExprId, subject: ExprId, decl: DeclId, name: string, args: List<ExprId>) -> Reg {
    let s = seated(cx, e, subject, args)
    let m? = cx.view.decls.method(decl, name) else { return cx.lower_defect(e, "a method with no symbol survived typing") }
    let dst = cx.result(e)
    cx.emit(Ins.Call(dst, cx.method_symbol(m, e, cx.type_at(subject)), [s.recv].concat(s.args)))
    dst
}

/// A STATIC's dispatch: a direct Call to the method's qualified
/// symbol with NO receiver — the seats are the written ones.
fn static_dispatch(mut cx: LowerCx, e: ExprId, m: DeclId, args: List<ExprId>) -> Reg {
    // THE MINT LAW: the operands' registers first, the answer last
    let regs = [cx.reg_of(a) for a in args]
    let dst = cx.result(e)
    cx.emit(Ins.Call(dst, cx.method_symbol(m, e, cx.type_at(e)), regs))
    dst
}

/// The type-receiver half lowered: the variant's tagged box — the
/// same shape enums' own lowering mints, through the same verbs.
fn built_variant(mut cx: LowerCx, e: ExprId, name: string, args: List<ExprId>) -> Reg {
    let sig? = cx.variants_at(e) else { return cx.lower_defect(e, "a variant built without an enum type") }
    let which: int? = sig.tag_of(name)
    if which == null || args.is_empty() { return cx.lower_defect(e, "an undeclared variant survived typing") }
    let carried = [cx.reg_of(a) for a in args]
    let size = cx.box_size(1 + carried.length)
    cx.tagged_value(cx.shape_at(e), size, which!, carried)
}
