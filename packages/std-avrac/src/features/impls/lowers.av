//! The lowering rule of a method call: a verb the language owns that is one runtime row is that row,
//! handed the receiver then each argument, and one that is a shape of rows is that shape; a method a
//! type the program declares has in one impl is a call of the method's own symbol, the receiver its
//! first seat. A call through a type builds the variant it names, or calls the type's static fn. Any
//! other method call isn't lowered yet, and says what it is.
use core.{
    BinOp,
    ExprId,
    Layout,
    Lowering,
    Lowers,
    Reg,
    RtSig,
    SignedType,
    OwnRow,
    own_row_of,
    own_shape,
    rt_sig_of,
}
use core.expr.{MethodCall}

impl Lowers for MethodCall {
    fn lowered(mut cx: Lowering, e: ExprId) -> Reg {
        let subject? = cx.type_at(self.subject) else { return cx.unlowered(e) }
        let described = subject.described()
        if described != null { return through_type(cx, self, e, described!) }
        if subject.dynamic { return dyn_dispatched(cx, self, e, subject) }
        if subject.nullable() { return cx.unlowered(e) }
        match subject.head {
            .Owned(word) -> owned_verb(cx, self, e, subject, word),
            .Declared(_, _) -> declared_method(cx, self, e, subject),
            .Parameter(_, _) -> cx.missed_as("a method of a type parameter, which only a witness answers"),
            .Unnamed(_) or .Inferred or .Function or .Never or .Meta -> cx.unlowered(e),
        }
    }
}

/// A call through a type: the variant of that name the type has, built of the arguments; a verb the
/// language owns on its own type (`Cell.new`); or a static fn of a type the program declares.
fn through_type(mut cx: Lowering, m: MethodCall, e: ExprId, ty: SignedType) -> Reg {
    if m.args.any((a) -> cx.store.arg_label(a) != null) { return cx.missed_as("a call through a type naming an argument") }
    let made? = cx.type_at(e) else { return cx.missed_as("an untyped call through a type") }
    let tag = if made.names_as(ty) { cx.variants_of(made)?.find_index(it.name == m.name.of) } else { null }
    if tag != null { return cx.tagged_value(cx.laid_out(made), tag!, [cx.lower(a) for a in m.args]) }
    match ty.head {
        .Owned(word) -> {
            let shape? = own_shape(word, m.name.of) else { return cx.missed_as(verb_unlowered(word, m.name.of)) }
            if !shape.on_the_type() { return cx.missed_as(verb_unlowered(word, m.name.of)) }
            cx.own_verb_lowered(shape, e, m.subject, m.args)
        },
        .Declared(_, _) -> static_called(cx, m, e, ty),
        .Parameter(_, _) -> cx.missed_as("a static fn or variant of a type parameter, which only a witness answers"),
        .Unnamed(_) or .Inferred or .Function or .Never or .Meta -> cx.missed_as("a call through a type"),
    }
}

/// A static fn of a type the program declares applied to nothing: a call of its symbol, handed each
/// argument.
fn static_called(mut cx: Lowering, m: MethodCall, e: ExprId, ty: SignedType) -> Reg {
    if cx.generic_declared(ty) { return cx.missed_as("a static fn of the generic `${ty.spelled()}`") }
    let callee? = cx.static_fn(ty, m.name.of) else { return cx.missed_as(static_unlowered(ty, m.name.of)) }
    if !callee.plain { return cx.missed_as(static_unlowered(ty, m.name.of)) }
    cx.call_fn(cx.layout_at(e), callee, [cx.lower(a) for a in m.args])
}

/// A verb on a type the language owns: its row, handed the receiver then each argument, or the shape
/// of rows it is.
fn owned_verb(mut cx: Lowering, m: MethodCall, e: ExprId, subject: SignedType, word: string) -> Reg {
    let own? = own_row_of(subject, m.name.of) else { return shaped_verb(cx, m, e, word) }
    owned_row(cx, m, e, word, own)
}

/// A verb on a type the language owns that is a shape of rows.
fn shaped_verb(mut cx: Lowering, m: MethodCall, e: ExprId, word: string) -> Reg {
    let shape? = own_shape(word, m.name.of) else {
        return cx.list_walked(m, e, word) ?? cx.int_wrapped(m, e, word) ?? cx
            .missed_as(verb_unlowered(word, m.name.of))
    }
    if shape.on_the_type() || m.args.any((a) -> cx.store.arg_label(a) != null) { return cx.missed_as(verb_unlowered(word, m.name.of)) }
    cx.own_verb_lowered(shape, e, m.subject, m.args)
}

/// A verb on a type the language owns that is one row.
fn owned_row(mut cx: Lowering, m: MethodCall, e: ExprId, word: string, own: OwnRow) -> Reg {
    let row? = rt_sig_of(own.row) else { return cx.missed_as(verb_unlowered(word, m.name.of)) }
    match own.answer {
        .Answer -> row_called(cx, m, e, row),
        .Zero -> cx
            .bin(
                Layout.Truth,
                BinOp.Eq,
                cx.call_words(Layout.Word, row, [cx.lower(m.subject)]),
                cx.const_int(0),
            ),
        .Folds -> {
            let code = folded_code(cx, m)
            if code == null { row_called(cx, m, e, row) } else { cx.const_int(code!) }
        },
    }
}

/// The row handed the receiver then each argument, answering the call's value.
fn row_called(mut cx: Lowering, m: MethodCall, e: ExprId, row: RtSig) -> Reg {
    cx.call_words(cx.layout_at(e), row, [cx.lower(m.subject)].concat([cx.lower(a) for a in m.args]))
}

/// The code a literal receiver holds at a literal index inside it, absent for any other.
fn folded_code(cx: Lowering, m: MethodCall) -> int? {
    let s? = cx.store.expr(m.subject).text_of() else { return null }
    let index = if m.args.is_empty() { 0 } else { cx.store.valued(m.args[0]).int_of() }
    let at? = index else { return null }
    if at < 0 || at >= s.length { null } else { s.char_code(at) }
}

/// A method a type the program declares has: a call of its symbol, the receiver its first seat. One
/// that writes its receiver is handed it as `written_seats` opens it.
fn declared_method(mut cx: Lowering, m: MethodCall, e: ExprId, subject: SignedType) -> Reg {
    if !subject.args.is_empty() { return cx.missed_as("a method of the generic `${subject.spelled()}`") }
    let callee? = cx.method(subject, m.name.of) else { return cx.missed_as(method_unlowered(subject, m.name.of)) }
    if !callee.plain || m.args.any((a) -> cx.store.arg_label(a) != null) { return cx.missed_as(method_unlowered(subject, m.name.of)) }
    if callee.unproved != null { return cx.missed_as(write_unproved(callee.unproved!)) }
    let seats = if callee.writes { written_seats(cx, m) } else { seated(cx, m) }
    if seats == null { return cx.missed_as(written_unlowered(cx, m.subject, callee.writes)) }
    cx.call_fn(cx.layout_at(e), callee, seats!)
}

/// The receiver a method writes, then each argument: a `mut` binding's own cell holding a value that
/// rides no pointer, or a `mut` seat itself, read as it is; a value, or one a seat holds, that rides
/// a pointer thawed once, here. Absent for any other receiver.
fn written_seats(mut cx: Lowering, m: MethodCall) -> List<Reg>? {
    if cell_rooted(cx, m.subject) || mut_seat_rooted(cx, m.subject) { return seated(cx, m) }
    if !thawed_here(cx, m.subject) { return null }
    let ty = cx.type_at(m.subject)!
    let thawed = cx.call_row(cx.laid_out(ty), rt_sig_of("avra_box_thawed")!, [cx.lower(m.subject)])
    [thawed].concat([cx.lower(a) for a in m.args])
}

/// Whether a written receiver is thawed at the call: it rides a pointer, and it's a value or a place
/// rooted in one of the fn's seats that isn't `mut`, which the write reaches through.
fn thawed_here(cx: Lowering, subject: ExprId) -> bool {
    let ty? = cx.type_at(subject) else { return false }
    let l? = cx.program.checked.layout(ty) else { return false }
    if !l.pointer() { return false }
    if cx.store.place_root(subject) == null { return true }
    let name? = root_name(cx, subject) else { return false }
    let b? = cx.bound(name) else { return false }
    match b {
        .Value(_, _) -> cx.seat_named(name) && !mut_seat(cx, name),
        .Slot(_, _) or .Outer(_, _, _) -> false,
    }
}

/// Whether a receiver is a `mut` seat's own name, which the write reaches through.
fn mut_seat_rooted(cx: Lowering, subject: ExprId) -> bool {
    let name? = root_name(cx, subject) else { return false }
    let b? = cx.bound(name) else { return false }
    let seat = match b {
        .Value(_, _) -> cx.seat_named(name),
        .Slot(_, _) or .Outer(_, _, _) -> false,
    }
    seat && cx.store.place_root(subject)?.index == subject.index && mut_seat(cx, name)
}

/// Whether a fn the body's item declares has a `mut` seat named `name`.
fn mut_seat(cx: Lowering, name: string) -> bool {
    cx
        .store
        .stmt_ids()
        .any(
            (s) -> (cx.store.fn_parts(s)?.params ?? [])
                .any(it.name.of == name && it.promises.mutable),
        )
}

/// A call through the `dyn` box `subject` is of: the receiver then each argument lowered, the value
/// read from the box's first slot and the code from the method's own. A method that may write its
/// receiver, or one handed its arguments by name or into seats that promise, isn't lowered yet.
fn dyn_dispatched(mut cx: Lowering, m: MethodCall, e: ExprId, subject: SignedType) -> Reg {
    if subject.nullable() { return cx.unlowered(e) }
    let members? = (cx.program.traits)(subject) else { return cx.missed_as("a `dyn` dispatch on `${subject.spelled()}`") }
    let at? = members.find_index(it.name == m.name.of) else { return cx.missed_as(method_unlowered(subject, m.name.of)) }
    if members[at].writes || in_cell(cx, m.subject) { return cx.missed_as("a method that may write its receiver") }
    if !members[at].plain || m.args.any((a) -> cx.store.arg_label(a) != null) { return cx.missed_as(method_unlowered(subject, m.name.of)) }
    let seats? = seated(cx, m) else { return cx.missed_as("a receiver on a path through a cell") }
    let value = cx.slot_read(cx.laid_out(subject), seats[0], 0)
    let code = cx.slot_read(Layout.Word, seats[0], 1 + at)
    cx.called_code(cx.layout_at(e), code, value, seats.drop(1))
}

/// The receiver then each argument, lowered left to right; a receiver read out of a `mut` binding's
/// cell is read after the arguments, which may write the cell. Absent for a receiver on a path that
/// starts in a cell.
fn seated(mut cx: Lowering, m: MethodCall) -> List<Reg>? {
    if !in_cell(cx, m.subject) { return [cx.lower(m.subject)].concat([cx.lower(a) for a in m.args]) }
    if cx.store.place_root(m.subject)?.index != m.subject.index { return null }
    let args = [cx.lower(a) for a in m.args]
    [cx.lower(m.subject)].concat(args)
}

/// Whether a receiver a method writes is read out of its cell as it is: a `mut` binding's own name,
/// its cell holding a value that rides no pointer.
fn cell_rooted(cx: Lowering, subject: ExprId) -> bool {
    let ty? = cx.type_at(subject) else { return false }
    let l? = cx.program.checked.layout(ty) else { return false }
    !l.pointer() && cx.store.place_root(subject)?.index == subject.index && in_cell(cx, subject)
}

/// Whether a receiver is a place whose root a `mut` binding's cell holds.
fn in_cell(cx: Lowering, subject: ExprId) -> bool {
    let name? = root_name(cx, subject) else { return false }
    let b? = cx.bound(name) else { return false }
    match b { .Slot(_, _) -> true, rest -> false }
}

/// The name a place is rooted in, absent for a value.
fn root_name(cx: Lowering, subject: ExprId) -> string? {
    let root? = cx.store.place_root(subject) else { return null }
    let step? = cx.store.place_step(root) else { return null }
    match step { .Root(n) -> n.of, rest -> null }
}

// ── Voices ──────────────────────────────────────────────────────────

fn verb_unlowered(word: string, name: string) -> string { "`${word}.${name}`" }

fn method_unlowered(subject: SignedType, name: string) -> string { "the method `${name}` of `${subject.spelled()}`" }

fn static_unlowered(ty: SignedType, name: string) -> string { "the static fn `${name}` of `${ty.spelled()}`" }

fn write_unproved(why: string) -> string { "a method that may write its receiver: ${why}" }

/// Why a receiver isn't lowered: a written one by where it's held, a read one on a path through a
/// cell.
fn written_unlowered(cx: Lowering, subject: ExprId, writes: bool) -> string {
    if !writes { return "a receiver on a path through a cell" }
    let name? = root_name(cx, subject) else { return "a written receiver that rides no pointer" }
    let b? = cx.bound(name) else { return "a written receiver the body doesn't bind" }
    match b {
        .Value(_, _) -> if cx.seat_named(name) { "a written receiver a seat holds that rides no pointer, or on a `mut` seat's path" } else { "a written receiver a `let` holds, its seed boxed" },
        .Slot(_, _) -> "a written receiver in a `mut` binding's cell, opened or thawed by where its seed came from",
        .Outer(_, _, _) -> "a written receiver a lambda captures",
    }
}
