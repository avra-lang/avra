//! A rule's answer: a REWRITE — a template, proven equivalent or
//! merely tested, `avra fix`'s tier the difference — or a SAY, a
//! finding with no rewrite, the rule's own diagnostic. A `quote {
//! … }` under a `Fix` want widens to `.Rewrite`, exactly as a bare
//! value auto-Ok-wraps into its `Result` (`checks.av`'s `fix_accepts`).
use @std.meta.{Code as MetaCode}
use diagnostics.{Diag}

export enum Fix {
    Rewrite(to: MetaCode)
    Say(voice: Diag)
}

impl Fix {
    /// The rewrite's own text, span-blind — `null` for a `Say`,
    /// which carries no code to splice.
    fn rendered() -> string? {
        match self {
            .Rewrite(to) -> to.text(),
            .Say(_) -> null,
        }
    }
}
