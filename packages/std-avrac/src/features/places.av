//! PLACES — where a mutation lands. A path from a mut binding's
//! cell through fields and indexes opens for writing by COPY-ON-
//! WRITE, top-down: each box along the way is returned as-is when
//! its count is one and cloned into its holder otherwise, so the
//! write is in place when nothing shares and aliasing is never
//! observed. The runtime clones by its own owned-map; the
//! interpreter clones every time (the executable spec). Mutation
//! and the list vocabulary's `push` both land here.
use core.{ExprId, Reg, Ins, Type, PlaceStep, Binding}

/// An opened place: a cell (a bare mut name) or a slot of a box
/// already made unique.
export enum Place {
    Cell(slot: Reg)
    Slot(box: Reg, at: Reg)
}

/// The place an expression names, opened for one write — null for
/// a value (resolve refuses those before lowering).
export fn opened_place(cx: LowerCx, e: ExprId) -> Place? {
    let step: PlaceStep? = cx.view.store.place_step(e)
    if step == null { return null }
    match step! {
        .Root(_) -> cell_place(cx, e),
        .Field(subject, name) -> Place.Slot(unique_box(cx, subject), field_slot(cx, subject, name)),
        .At(subject, index) -> Place.Slot(unique_box(cx, subject), cx.reg_of(index)),
    }
}

fn cell_place(cx: LowerCx, e: ExprId) -> Place? {
    let cell: Reg? = cx.cell_of(e)
    if cell == null { return null }
    Place.Cell(cell!)
}

/// The box a path's subject holds, UNIQUE for writing. Operands
/// first, the destination last — registers define in mint order.
export fn unique_box(cx: LowerCx, s: ExprId) -> Reg {
    let step: PlaceStep? = cx.view.store.place_step(s)
    if step == null { return lower_defect(cx, s, "a mutation through a value survived resolve") }
    match step! {
        .Root(_) -> {
            let cell: Reg? = cx.cell_of(s)
            if cell != null {
                let dst = cx.mint_ty(cx.type_at(s))
                // a BORROW of a parameter's field writes through to the
                // field (bs2's aliasing, honored until self-host); any
                // other cell opens unique — copy-on-write
                if borrows(cx, s) { cx.emit(Ins.Load(dst, cell!)) } else { cx.emit(Ins.CallRt(dst, "avra_cell_unique", [cell!])) }
                return dst
            }
            // a method's receiver: `self` is the box itself — shared
            // by design, so no uniqueness is asked of it
            cx.def_reg(s) ?? lower_defect(cx, s, "a mutation rooted outside a mut cell survived resolve")
        }
        .Field(subject, name) -> slot_opened(cx, s, unique_box(cx, subject), field_slot(cx, subject, name)),
        .At(subject, index) -> slot_opened(cx, s, unique_box(cx, subject), cx.reg_of(index)),
    }
}

/// Whether a root name is a `mut` binding that borrows a parameter's
/// field.
fn borrows(cx: LowerCx, root: ExprId) -> bool {
    let b: Binding? = cx.names.binding(root)
    if b == null { return false }
    match b! {
        .Def(s) -> cx.facts.is_borrow(s),
        .Param(_) or .Decl(_) or .Pattern(_, _) or .LambdaParam(_, _) or .Capture(_, _) or .Index(_) -> false,
    }
}

fn slot_opened(cx: LowerCx, s: ExprId, parent: Reg, at: Reg) -> Reg {
    let dst = cx.mint_ty(cx.type_at(s))
    cx.emit(Ins.CallRt(dst, "avra_slot_unique", [parent, at]))
    dst
}

/// A field's declaration index as a register — the slot it lives in.
fn field_slot(cx: LowerCx, subject: ExprId, name: string) -> Reg {
    let sig: StructSig? = cx.fields_at(subject)
    let slot: int? = if sig == null { null } else { sig!.slot_of(name) }
    let idx = cx.mint_shape(Type.Int)
    if slot == null {
        let _ = lower_defect(cx, subject, "a fieldless place survived typing")
        return idx
    }
    cx.emit(Ins.ConstInt(idx, slot!))
    idx
}
