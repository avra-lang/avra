//! PLACES — where a mutation lands. A path from a mut binding's
//! cell through fields and indexes opens for writing by COPY-ON-
//! WRITE, top-down: each box along the way is returned as-is when
//! its count is one and cloned into its holder otherwise, so the
//! write is in place when nothing shares and aliasing is never
//! observed. The runtime clones by its own owned-map; the
//! interpreter clones every time (the executable spec). Mutation
//! and the list vocabulary's `push` both land here.
use core.{ExprId, Reg, Ins, Type}

/// An opened place: a cell (a bare mut name) or a slot of a box
/// already made unique.
export enum Place {
    Cell(slot: Reg)
    Slot(box: Reg, at: Reg)
}

impl LowerCx {
    /// The place an expression names, opened for one write — null for
    /// a value (resolve refuses those before lowering).
    mut fn opened_place(e: ExprId) -> Place? {
        let step? = self.view.store.place_step(e) else { return null }
        match step {
            .Root(_) -> self.cell_place(e),
            .Field(subject, name) -> self.field_place(subject, name.of),
            .At(subject, index) -> Place.Slot(self.unique_box(subject), self.reg_of(index)),
        }
    }

    /// A field's place. A FLAT record IS its one field, so writing that
    /// field writes the RECORD — the subject's own place, not a slot in
    /// a box the record does not have.
    mut fn field_place(subject: ExprId, name: string) -> Place? {
        if self.flat_at(subject) { return self.opened_place(subject) }
        Place.Slot(self.unique_box(subject), self.field_slot(subject, name))
    }

    fn cell_place(e: ExprId) -> Place? {
        let cell? = self.cell_of(e) else { return null }
        Place.Cell(cell)
    }

    /// The box a path's subject holds, UNIQUE for writing. Operands
    /// first, the destination last — registers define in mint order.
    mut fn unique_box(s: ExprId) -> Reg {
        let step? = self.view.store.place_step(s) else { return self.lower_defect(s, "a mutation through a value survived resolve") }
        match step {
            .Root(_) -> {
                let cell: Reg? = self.cell_of(s)
                if cell != null {
                    // a cell opens unique — copy-on-write
                    return self.cell_unique(self.shape_at(s), cell!)
                }
                // a method's receiver: `self` is the box itself — shared
                // by design, so no uniqueness is asked of it
                self.def_reg(s) ?? self.lower_defect(s, "a mutation rooted outside a mut cell survived resolve")
            },
            .Field(subject, name) -> self.slot_opened(s, self.unique_box(subject), self.field_slot(subject, name.of)),
            .At(subject, index) -> self.slot_opened(s, self.unique_box(subject), self.reg_of(index)),
        }
    }

    mut fn slot_opened(s: ExprId, parent: Reg, at: Reg) -> Reg {
        self.slot_unique(self.shape_at(s), parent, at)
    }

    /// A field's declaration index as a register — the slot it lives in.
    mut fn field_slot(subject: ExprId, name: string) -> Reg {
        let sig: StructSig? = self.fields_at(subject)
        let slot: int? = sig?.slot_of(name)
        let idx = self.mint_shape(Type.Int)
        if slot == null {
            let _ = self.lower_defect(subject, "a fieldless place survived typing")
            return idx
        }
        self.emit(Ins.ConstInt(idx, slot!))
        idx
    }
}
