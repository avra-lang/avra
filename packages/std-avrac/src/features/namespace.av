//! A FILE'S NAMESPACE — what its top level sees, under ONE law: a
//! name binds once. A MODULE's names are bound once, every file's
//! declarations in file then declaration order: the first binder of
//! a name wins and every later binder is a CLASH, filed under the
//! file whose declaration lost. A file's namespace is those bindings
//! plus its imports; an import of a name already visible clashes —
//! unless it is the very declaration, which is redundant, not wrong.
//! Fns and types are namespaces apart, as the language keeps them.
use core.{
    DeclId,
    FileId,
    DeclKind,
    same_decl,
    same_file,
    text_before,
    inserted,
    qtrace,
    map_cell,
    list_cell,
    flatten,
}
use diagnostics.{Diag, refusal, Voices, no_voices}
use query.{traced}
use @std.errors.{Loc}
use @std.meta.{bracket}

/// A file's namespace: the bindings, the names in declaration order
/// (for suggestions), and the diagnostics building it earned.
export type BoundNames = {
    fns: Map<string, DeclId>,
    types: Map<string, DeclId>,
    syntaxes: Map<string, DeclId>,
    syntax_names: List<string>,
    fn_names: List<string>,
    type_names: List<string>,
}

/// Which of a namespace's three tables a name was asked of.
export enum NameKind { Fn, Type, Syntax }

/// A kind's own word, the spelling a durable witness names it by.
export fn name_kind_word(k: NameKind) -> string {
    match k { .Fn -> "fn", .Type -> "type", .Syntax -> "syntax" }
}

/// `name_kind_word`'s inverse.
export fn name_kind_of(word: string) -> NameKind? {
    [NameKind.Fn, NameKind.Type, NameKind.Syntax].find((k: NameKind) -> name_kind_word(k) == word)
}

/// One name a namespace was asked: what, the name, and the declaration
/// that answered it — none when nothing did, which is a read too: an
/// absent name resolves differently the day a file defines it.
export type NameRead = { kind: NameKind, name: string, answer: DeclId? }

/// What a namespace was asked, kept only while a durable witness is being
/// made (`on`). `suggested` holds once the name lists were read to
/// suggest — then the WHOLE scope is a dependency, since a suggestion
/// reads every name.
export type NameReads = {
    on: bool,
    asked: Cell<Map<string, bool>>,
    found: Cell<List<NameRead>>,
    suggested: Cell<bool>,
}

export fn new_reads(on: bool) -> NameReads {
    NameReads { on: on, asked: map_cell(), found: list_cell(), suggested: Cell.new(false) }
}

export type Namespace = {
    // The module's winners are shared by every file. These fields hold
    // only imports, prelude exports, and builtins added for this file.
    base: BoundNames?,
    fns: Map<string, DeclId>,
    types: Map<string, DeclId>,
    syntaxes: Map<string, DeclId>,
    syntax_names: List<string>,
    fn_names: List<string>,
    type_names: List<string>,
    voices: Voices,
    reads: NameReads,
}

impl Namespace {
    fn fn_decl(name: string) -> DeclId? {
        let local: DeclId? = self.fns.get(name)
        let answer: DeclId? = if local != null || self.base == null { local } else { self.base!.fns.get(name) }
        self.noted(NameKind.Fn, name, answer)
        answer
    }

    fn type_decl(name: string) -> DeclId? {
        let local: DeclId? = self.types.get(name)
        let answer: DeclId? = if local != null || self.base == null { local } else { self.base!.types.get(name) }
        self.noted(NameKind.Type, name, answer)
        answer
    }

    fn syntax_decl(name: string) -> DeclId? {
        let local: DeclId? = self.syntaxes.get(name)
        let answer: DeclId? = if local != null || self.base == null { local } else { self.base!.syntaxes.get(name) }
        self.noted(NameKind.Syntax, name, answer)
        answer
    }

    /// Whether `key` was already asked — its own fn, ended before
    /// `noted` may go on to WRITE `reads.asked`: a read held across
    /// that write finds the Cell's box shared, and `avra_cell_unique`
    /// clones the whole map (with no index, so the next lookup
    /// rebuilds it) — once per DISTINCT name this namespace resolves,
    /// which is every name resolution in the file while a pack is
    /// attached (CLAUDE.md: "A READ-MODIFY-WRITE THROUGH get IS A
    /// COPY").
    fn already_asked(key: string) -> bool { self.reads.asked.get().get(key) != null }

    /// Keeps one ask for a durable witness, a name once.
    fn noted(kind: NameKind, name: string, answer: DeclId?) {
        if !self.reads.on { return }
        let key = "${name_kind_word(kind)}\n${name}"
        if self.already_asked(key) { return }
        self.reads.asked.put(key, true)
        self.reads.found.push(NameRead { kind: kind, name: name, answer: answer })
    }

    /// Reading the name lists is reading every name in scope.
    fn suggested() {
        if self.reads.on { self.reads.suggested.set(true) }
    }

    fn fn_suggestions() -> List<string> {
        self.suggested()
        if self.base == null { return self.fn_names }
        self.base!.fn_names.concat(self.fn_names)
    }

    fn type_suggestions() -> List<string> {
        self.suggested()
        if self.base == null { return self.type_names }
        self.base!.type_names.concat(self.type_names)
    }

    /// Every name in scope, of all three tables — what a suggestion can
    /// read, and so what an absent name depends on.
    fn scope_words() -> List<string> {
        flatten(
            [
                self.fn_names,
                self.type_names,
                self.syntax_names,
                self.base?.fn_names ?? [],
                self.base?.type_names ?? [],
                self.base?.syntax_names ?? [],
            ],
        )
    }

    /// Whether either namespace holds the name.
    fn names(name: string) -> bool {
        self.fn_decl(name) != null || self.type_decl(name) != null
    }
}

export fn no_names() -> Namespace {
    Namespace {
        base: null,
        fns: {},
        types: {},
        syntaxes: {},
        syntax_names: [],
        fn_names: [],
        type_names: [],
        voices: no_voices(),
        reads: new_reads(false),
    }
}

/// A module's names, bound once: the declarations that won, in
/// order, and every clash — filed under the losing file.
export type ModuleNames = { bound: List<DeclId>, clashes: List<Clash>, base: BoundNames }

export type Clash = { file: FileId, diag: Diag }

/// One imported declaration: what, where the `use` stands, and the
/// module it came from.
export type Import = { decl: DeclId, at: Loc?, renamed: string }

impl Decls {
    /// A module's declarations bound, in the order given. `shown`
    /// renders a path for prose.
    fn module_names(ordered: List<DeclId>, shown: fn(string) -> string) -> ModuleNames {
        mut b = self.binder(shown)
        for d in ordered { b.declare(d) }
        let names = b.names
        ModuleNames {
            bound: b.bound,
            clashes: b.clashes,
            base: BoundNames {
                fns: names.fns,
                types: names.types,
                syntaxes: names.syntaxes,
                fn_names: names.fn_names,
                type_names: names.type_names,
                syntax_names: names.syntax_names,
            },
        }
    }

    /// A file adds imports, prelude exports, and builtins over its
    /// module's shared winners. The module's clashes remain filed at
    /// the declaration in this file that lost.
    fn file_names(
        file: FileId,
        module: ModuleNames,
        imports: List<Import>,
        prelude: List<Import>,
        shown: fn(string) -> string,
        recording: bool,
    ) -> Namespace {
        mut fns: Map<string, DeclId> = {}
        mut types: Map<string, DeclId> = {}
        mut syntaxes: Map<string, DeclId> = {}
        mut fn_names: List<string> = []
        mut type_names: List<string> = []
        mut syntax_names: List<string> = []
        mut spoken: List<Diag> = []
        for i in imports {
            let x = self.decl(i.decl)
            let name = if i.renamed.is_empty() { x.name } else { i.renamed }
            let mine: DeclId? = match x.kind {
                .Fn or .Const or .Collect -> fns.get(name),
                .Record or .Named or .Alias or .Enum or .Trait or .Builtin or .CollectEnum -> types.get(name),
                .Syntax -> syntaxes.get(name),
                .Method or .Default or .Impl or .Main or .Case -> null,
            }
            let shared: DeclId? = match x.kind {
                .Fn or .Const or .Collect -> module.base.fns.get(name),
                .Record or .Named or .Alias or .Enum or .Trait or .Builtin or .CollectEnum -> module.base.types.get(name),
                .Syntax -> module.base.syntaxes.get(name),
                .Method or .Default or .Impl or .Main or .Case -> null,
            }
            let prior: DeclId? = mine ?? shared
            if prior == null {
                match x.kind {
                    .Fn or .Const or .Collect -> {
                        fns.set(name, i.decl)
                        fn_names.push(name)
                    },
                    .Record or .Named or .Alias or .Enum or .Trait or .Builtin or .CollectEnum -> {
                        types.set(name, i.decl)
                        type_names.push(name)
                    },
                    .Syntax -> {
                        syntaxes.set(name, i.decl)
                        syntax_names.push(name)
                    },
                    .Method or .Default or .Impl or .Main or .Case -> not_bound(),
                }
            } else if !same_decl(prior!, i.decl) { spoken.push(import_clash(i.at, name, self.holder_of(prior!, file, shown))) }
        }
        for i in prelude
            .concat([Import { decl: d, at: null, renamed: "" } for d in self.builtin_decls()]) {
            let x = self.decl(i.decl)
            let prior: DeclId? = match x.kind {
                .Fn or .Const or .Collect -> fns.get(x.name) ?? module.base.fns.get(x.name),
                .Record or .Named or .Alias or .Enum or .Trait or .Builtin or .CollectEnum -> types.get(x.name) ?? module.base.types.get(x.name),
                .Syntax -> syntaxes.get(x.name) ?? module.base.syntaxes.get(x.name),
                .Method or .Default or .Impl or .Main or .Case -> null,
            }
            if prior == null {
                match x.kind {
                    .Fn or .Const or .Collect -> {
                        fns.set(x.name, i.decl)
                        fn_names.push(x.name)
                    },
                    .Record or .Named or .Alias or .Enum or .Trait or .Builtin or .CollectEnum -> {
                        types.set(x.name, i.decl)
                        type_names.push(x.name)
                    },
                    .Syntax -> {
                        syntaxes.set(x.name, i.decl)
                        syntax_names.push(x.name)
                    },
                    .Method or .Default or .Impl or .Main or .Case -> not_bound(),
                }
            }
        }
        let own = [c.diag for c in module.clashes if in_file(c, file)]
        Namespace {
            base: module.base,
            fns: fns,
            types: types,
            syntaxes: syntaxes,
            syntax_names: syntax_names,
            fn_names: fn_names,
            type_names: type_names,
            voices: Voices { list: own.concat(spoken) },
            reads: new_reads(recording),
        }
    }

    /// Who holds a name already: this module (by file), or a module.
    fn holder_of(prior: DeclId, file: FileId, shown: fn(string) -> string) -> string {
        let p = self.decl(prior)
        if self.module_of(prior) == self.module_name(self.file(file).module_id) {
            return "this module (`${shown(self.file(p.file).path)}`)"
        }
        "`${self.module_of(prior)}`"
    }

    fn binder(shown: fn(string) -> string) -> Binder {
        Binder { decls: self, shown: shown, names: no_names(), bound: [], clashes: [] }
    }
}

fn in_file(c: Clash, f: FileId) -> bool {
    same_file(c.file, f)
}

/// A namespace under construction.
type Binder = { decls: Decls, shown: fn(string) -> string, names: Namespace, bound: List<DeclId>, clashes: List<Clash> }

impl Binder {
    /// A module declaration binds; a taken name is a clash at the
    /// LATER declaration, filed under its file.
    fn declare(d: DeclId) {
        let x = self.decls.decl(d)
        if traced() { qtrace("Q\tdeclare\t${x.name}\t${self.decls.file(x.file).path}\n") }
        let prior: DeclId? = self.held(x.kind, x.name)
        if prior == null {
            self.bind(x.kind, x.name, d)
            self.bound.push(d)
            return
        }
        if same_decl(prior!, d) { return }
        let p = self.decls.decl(prior!)
        let at = self.decls.loc(d)
        let diag = if same_file(p.file, x.file) { defined_twice(at, x.kind, x.name) } else { declared_twice(at, x.name, self.shown(self.decls.file(p.file).path)) }
        self.clashes.push(Clash { file: x.file, diag: diag })
    }

    /// A winner bound without a law: the module already applied it.
    fn bind_decl(d: DeclId) {
        let x = self.decls.decl(d)
        self.bind(x.kind, x.name, d)
    }

    /// A prelude export binds where nothing else took the name — a
    /// file's own `println`, or one it imports, wins silently.
    fn bind_prelude(i: Import) {
        let x = self.decls.decl(i.decl)
        if self.held(x.kind, x.name) == null { self.bind(x.kind, x.name, i.decl) }
    }

    /// The language's own declaration binds where nothing else
    /// took the name — a program's `Result` wins silently.
    fn bind_builtin(d: DeclId) {
        let x = self.decls.decl(d)
        if self.held(x.kind, x.name) == null { self.bind(x.kind, x.name, d) }
    }

    /// An import binds in the file's namespace; a name already
    /// visible refuses — unless it is the very same declaration.
    fn import(i: Import, file: FileId) {
        let x = self.decls.decl(i.decl)
        // A `use` item's ALIAS is the name it binds under; the empty
        // alias is the declaration's own name.
        let name = if i.renamed.is_empty() { x.name } else { i.renamed }
        let prior? = self.held(x.kind, name) else { return self.bind(x.kind, name, i.decl) }
        if same_decl(prior, i.decl) { return }
        self.speak(import_clash(i.at, name, self.holder(prior, file)))
    }

    /// Who holds a name already: this module (by file), or a module.
    fn holder(prior: DeclId, file: FileId) -> string {
        let p = self.decls.decl(prior)
        if self.decls.module_of(prior) == self.decls.module_name(self.decls.file(file).module_id) {
            return "this module (`${self.shown(self.decls.file(p.file).path)}`)"
        }
        "`${self.decls.module_of(prior)}`"
    }

    fn held(kind: DeclKind, name: string) -> DeclId? {
        let as_fn: DeclId? = self.names.fns.get(name)
        let as_type: DeclId? = self.names.types.get(name)
        match kind {
            .Fn or .Const or .Collect -> as_fn,
            .Record or .Named or .Alias or .Enum or .Trait or .Builtin or .CollectEnum -> as_type,
            .Syntax -> self.names.syntaxes.get(name),
            .Method or .Default or .Impl or .Main or .Case -> null,
        }
    }

    fn bind(kind: DeclKind, name: string, d: DeclId) {
        match kind {
            .Fn or .Const or .Collect -> self.bind_fn(name, d),
            .Record or .Named or .Alias or .Enum or .Trait or .Builtin or .CollectEnum -> self.bind_type(name, d),
            .Syntax -> self.bind_syntax(name, d),
            .Method or .Default or .Impl or .Main or .Case -> not_bound(),
        }
    }

    fn bind_fn(name: string, d: DeclId) {
        self.names.fns.set(name, d)
        self.names.fn_names.push(name)
    }

    fn bind_syntax(name: string, d: DeclId) {
        self.names.syntaxes.set(name, d)
        self.names.syntax_names.push(name)
    }

    fn bind_type(name: string, d: DeclId) {
        self.names.types.set(name, d)
        self.names.type_names.push(name)
    }

    fn speak(d: Diag) { self.names.voices.speak(d) }
}

/// A member, an impl and a Main never enter a namespace.
fn not_bound() {}

// ── voices ──

impl Decls {
    /// THE METHOD-TABLE LAW: a type's methods are a namespace — one
    /// impl owns each name, and a second declaration (any block, any
    /// file, whichever registered first) is a clash spoken at the
    /// later one, in declaration order.
    @bracket("methods")
    fn method_clashes(target: DeclId) -> List<Clash> {
        mut out: List<Clash> = []
        mut taken: List<string> = []
        mut plain: List<string> = []
        mut instanced: List<string> = []
        for m in self.by_declaration(self.registered_methods(target)) {
            let x = self.decl(m)
            let key = self.method_key(m)
            let generic = self.impl_trait_args(m).length > 0
            if taken.contains(key) {
                out.push(Clash { file: x.file, diag: method_taken(self.loc(m), x.owner, key) })
            } else if generic && plain.contains(x.name) || !generic && instanced.contains(x.name) {
                out.push(Clash { file: x.file, diag: method_shared(self.loc(m), x.owner, x.name) })
            }
            taken.push(key)
            if generic { instanced.push(x.name) } else { plain.push(x.name) }
        }
        out
    }

    /// What a method's name owns in its type's namespace: the name, or,
    /// for a member of a generic trait's impl, the name AT the trait's
    /// arguments — `draw<Text>` and `draw<Button>` are two members.
    fn method_key(m: DeclId) -> string {
        let x = self.decl(m)
        let args = self.impl_trait_args(m)
        if args.is_empty() { x.name } else { "${x.name}<${args.join(", ")}>" }
    }

    /// The trait arguments of the impl a method was declared in.
    fn impl_trait_args(m: DeclId) -> List<string> {
        let block? = self.decl(m).parent else { return [] }
        self.facts_of(block)?.trait_args ?? []
    }

    /// Methods in declaration order — file, then statement — whatever
    /// order they registered in.
    fn by_declaration(methods: List<DeclId>) -> List<DeclId> {
        mut out: List<DeclId> = []
        for m in methods {
            let at = self.first_later(out, self.decl(m))
            out = inserted(out, at, m)
        }
        out
    }

    /// The first index whose declaration comes after `x`.
    fn first_later(methods: List<DeclId>, x: Decl) -> int {
        for i, m in methods {
            if self.declared_after(self.decl(m), x) { return i }
        }
        methods.length
    }

    /// Source order: by path (a FileId is minted in ASK order, which
    /// is nobody's source order), then by statement.
    fn declared_after(a: Decl, b: Decl) -> bool {
        if same_file(a.file, b.file) { return a.stmt.index > b.stmt.index }
        text_before(self.file(b.file).path, self.file(a.file).path)
    }
}

fn method_taken(at: Loc?, target: string, name: string) -> Diag {
    refusal(
        "type.impl",
        at,
        "`${target}.${name}` is declared twice",
        "declared again here",
        "one `impl` block owns each method name — rename or merge",
    )
}

fn method_shared(at: Loc?, target: string, name: string) -> Diag {
    refusal(
        "type.impl",
        at,
        "`${target}.${name}` is a generic trait's member and a method of its own",
        "declared again here",
        "a generic trait's members own their name on a type — rename the other method",
    )
}

fn defined_twice(at: Loc?, kind: DeclKind, name: string) -> Diag {
    match kind {
        .Fn or .Const or .Collect -> refusal(
            "resolve.duplicate_fn",
            at,
            "`${name}` is defined more than once",
            "redefined here",
            "rename one of them",
        ),
        .Record or .Named or .Alias or .Enum or .Trait or .Syntax or .Method or .Default or .Impl or .Main or .Case or .Builtin or .CollectEnum -> refusal(
            "resolve.duplicate_type",
            at,
            "`${name}` is declared more than once",
            "redeclared here",
            "rename one of them",
        ),
    }
}

fn declared_twice(at: Loc?, name: string, other: string) -> Diag {
    refusal(
        "resolve.duplicate_in_module",
        at,
        "`${name}` is declared twice in this module — here and in `${other}`",
        "declared here",
        "a module is its directory, so its files share one namespace — rename one, or move one into a directory of its own",
    )
}

fn import_clash(at: Loc?, item: string, holder: string) -> Diag {
    refusal(
        "resolve.import_clash",
        at,
        "`${item}` is imported, but ${holder} already has it",
        "in this use",
        "drop the import, or rename the local declaration",
    )
}
