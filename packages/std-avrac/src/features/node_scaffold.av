//! THE NODE BUILDERS THE MODEL ANSWERS: one per flat variant of `Expr`,
//! `Pat` and `Stmt`, each maker read off its enum by `@derive(Makes)`
//! (core/makers_derive.av), and each comprehension clause's the same
//! way. A variant with a payload no `Slots` accessor reads has no maker,
//! and keeps its own builder. A record that is no node is made the same
//! way (`make_<Record>`) and carried by its own `LangNode` variant;
//! `Record.ParamSyntax` and `Record.VariantSyntax` still name a builder.
//! A node a rule COMPUTES (`-> Owner.Variant by fn`) is built by its
//! `@computed` fn, every one gathered here — one door, no table.
use core.{
    expr_makers,
    pat_makers,
    stmt_makers,
    comp_clause_makers,
    map_entry_makers,
    make_TypeRef,
    make_Arm,
    make_Case,
    make_UseItem,
    make_FieldPat,
    make_ProjField,
    make_OrderKey,
    make_Given,
    make_FnSeat,
    make_CatchArm,
    Slots,
    Built,
}
use features.{BuilderRow, LangNode}

/// A fn that computes a node from its rule's labels: the name a rule's
/// `by` names it by, and the fn.
export type ComputeRow = { name: string, make: fn(dyn Slots) -> Result<Built, string> }

/// Every `@computed` fn of the compiler, by name.
export collect computes: List<ComputeRow> = @computed in package as ComputeRow { name: it.name, make: it } by it.name

/// Each flat variant's builder: its maker, then the node it makes.
export fn node_builders() -> List<BuilderRow> {
    [BuilderRow {
        name: "Expr.${m.name}",
        build: (b) -> match (m.make)(b) { .Ok(e) -> b.make_expr(e), .Err(msg) -> .Err(msg) },
    } for m in expr_makers()]
        .concat(
            [BuilderRow {
                name: "Pat.${m.name}",
                build: (b) -> match (m.make)(b) { .Ok(p) -> b.make_pat(p), .Err(msg) -> .Err(msg) },
            } for m in pat_makers()],
        )
        .concat(
            [BuilderRow {
                name: "Stmt.${m.name}",
                build: (b) -> match (m.make)(b) { .Ok(s) -> b.make_stmt(s), .Err(msg) -> .Err(msg) },
            } for m in stmt_makers()],
        )
        .concat(
            [BuilderRow {
                name: "CompClause.${m.name}",
                build: (b) -> match (m.make)(b) { .Ok(c) -> b.make_comp_clause(c), .Err(msg) -> .Err(msg) },
            } for m in comp_clause_makers()],
        )
        .concat(
            [BuilderRow {
                name: "MapEntry.${m.name}",
                build: (b) -> match (m.make)(b) { .Ok(x) -> b.make_map_entry(x), .Err(msg) -> .Err(msg) },
            } for m in map_entry_makers()],
        )
        .concat([BuilderRow { name: "Record.ParamSyntax", build: (b) -> b.seat() }])
        .concat([BuilderRow { name: "Record.VariantSyntax", build: (b) -> b.variant() }])
        .concat(
            [
                BuilderRow {
                    name: "Record.TypeRef",
                    build: (b) -> carried(make_TypeRef(b), (t) -> LangNode.NType(t)),
                },
            ],
        )
        .concat(
            [
                BuilderRow {
                    name: "Record.Arm",
                    build: (b) -> carried(make_Arm(b), (a) -> LangNode.NArm(a)),
                },
            ],
        )
        .concat(
            [
                BuilderRow {
                    name: "Record.Case",
                    build: (b) -> carried(make_Case(b), (c) -> LangNode.NCases([c])),
                },
            ],
        )
        .concat(
            [
                BuilderRow {
                    name: "Record.UseItem",
                    build: (b) -> carried(make_UseItem(b), (u) -> LangNode.NUseItem(u)),
                },
            ],
        )
        .concat(
            [
                BuilderRow {
                    name: "Record.FieldPat",
                    build: (b) -> carried(make_FieldPat(b), (f) -> LangNode.NFieldPat(f)),
                },
            ],
        )
        .concat(
            [
                BuilderRow {
                    name: "Record.ProjField",
                    build: (b) -> carried(make_ProjField(b), (f) -> LangNode.NProjField(f)),
                },
            ],
        )
        .concat(
            [
                BuilderRow {
                    name: "Record.OrderKey",
                    build: (b) -> carried(make_OrderKey(b), (k) -> LangNode.NOrderKey(k)),
                },
            ],
        )
        .concat(
            [
                BuilderRow {
                    name: "Record.Given",
                    build: (b) -> carried(make_Given(b), (g) -> LangNode.NGiven(g)),
                },
            ],
        )
        .concat(
            [
                BuilderRow {
                    name: "Record.FnSeat",
                    build: (b) -> carried(make_FnSeat(b), (r) -> LangNode.NFnSeat(r)),
                },
            ],
        )
        .concat(
            [
                BuilderRow {
                    name: "Record.CatchArm",
                    build: (b) -> carried(make_CatchArm(b), (a) -> LangNode.NCatchArm(a)),
                },
            ],
        )
        .concat(
            [BuilderRow { name: c.name, build: (b) -> carried((c.make)(b), carried_built) } for c in computes],
        )
}

/// A made record in the `LangNode` variant that carries it.
fn carried<R>(made: Result<R, string>, carrier: fn(R) -> LangNode) -> Result<LangNode, string> {
    match made { .Ok(r) -> .Ok(carrier(r)), .Err(m) -> .Err(m) }
}

/// A computed node in the `LangNode` variant its kind rides.
fn carried_built(n: Built) -> LangNode {
    match n {
        .Expr(id) -> LangNode.NExpr(id),
        .Stmt(id) -> LangNode.NStmt(id),
        .Pat(id) -> LangNode.NPat(id),
        .Seat(param) -> LangNode.NParam(param),
        .Marked(mark) -> LangNode.NMark(mark),
    }
}
