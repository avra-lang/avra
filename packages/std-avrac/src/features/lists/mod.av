//! Lists — the first aggregate. `[e, e, e]` builds one; access
//! (`xs[i]`, `xs.length`) is the spine's postfix ladder; the walks,
//! the scans, the growth words and the copies are this feature's
//! method rows. A comprehension builds one by walking another:
//! `[e for x in xs if p]`, naming the index too with `[e for i, x
//! in xs]`, or by counting with `[e for i in lo..hi]` — the head is
//! the `for` statement's. `collect { for o in xs { if o.ok { o.id
//! } } }` gathers every value its statements would discard.
use features.{LanguageFeature, BuilderRow, MethodRow, ReceiverEffect, TypeRow, PropertyRow, no_law, no_variants, measured_reg, lower_is_empty}
use grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use diagnostics.{DiagCode}

export fn lists() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name                | build
        "list_lit"          | build_list
        "comp"              | build_comp
        "collect"           | build_collect
        "collect_blockless" | build_collect_blockless
    }
    let codes = table<DiagCode> {
        kind                | id      | summary
        "type.list_empty"   | "F2004" | "an empty list has no element type to infer"
        "type.list_element" | "F2005" | "a list's elements share one type"
        "type.list_scalar"  | "F2006" | "a list holds scalars for now"
        "type.place"        | "F2034" | "a mutation needs a mut place"
        "type.list"         | "F2041" | "a comprehension walks a list"
    }
    let methods = table<MethodRow> {
        name         | takes   | check            | lower            | effect
        "map"        | on_list | check_map        | lower_map        | ReceiverEffect.Read
        "filter"     | on_list | check_filter     | lower_filter     | ReceiverEffect.Read
        "find"       | on_list | check_find       | lower_find       | ReceiverEffect.Lends
        "find_index" | on_list | check_find_index | lower_find_index | ReceiverEffect.Read
        "any"        | on_list | check_any        | lower_any        | ReceiverEffect.Read
        "all"        | on_list | check_all        | lower_all        | ReceiverEffect.Read
        "contains"   | on_list | check_contains   | lower_contains   | ReceiverEffect.Read
        "index_of"   | on_list | check_index_of   | lower_index_of   | ReceiverEffect.Read
        "push"       | on_list | check_push       | lower_push       | ReceiverEffect.Write
        "pop"        | on_list | check_pop        | lower_pop        | ReceiverEffect.Write
        "set"        | on_list | check_set        | lower_set        | ReceiverEffect.Write
        "is_empty"   | on_list | check_is_empty   | lower_is_empty   | ReceiverEffect.Read
        "first"      | on_list | check_first      | lower_first      | ReceiverEffect.Lends
        "last"       | on_list | check_last       | lower_last       | ReceiverEffect.Lends
        "concat"     | on_list | check_concat     | lower_concat     | ReceiverEffect.Read
        "slice"      | on_list | check_slice      | lower_slice      | ReceiverEffect.Read
        "enumerate"  | on_list | check_enumerate  | lower_enumerate  | ReceiverEffect.Read
        "join"       | on_list | check_join       | lower_join       | ReceiverEffect.Read
    }
    let types = table<TypeRow> {
        name   | arity | slots | judge  | builds     | variants
        "List" | 1     | true  | no_law | list_shape | no_variants
    }
    let properties = table<PropertyRow> {
        name     | takes   | check        | lower
        "length" | on_list | check_length | measured_reg
    }
    LanguageFeature lists {
        gram: grammar {
            primary = "[" v:expression "for" ( "(" ix:NAME "," en:NAME ")" | ix:NAME "," en:NAME | en:NAME ) "in" src:expression ( ".." hi:expression )? ( "if" c:expression )? "]" @expect("]", "expected `]` to close the comprehension") -> comp(v, ix, en, src, hi, c) | "[" BREAK? ( first:expression ( "," BREAK? rest:expression )* ","? BREAK? )? "]" @expect("]", "expected `]` to close the list") -> list_lit(first, rest) | "collect" "{" ( s:stmt | BREAK )* "}" @expect("}", "expected `}` to close the `collect`") -> collect(s) | "collect" v:expression -> collect_blockless(v)
        }
        builders: rows
        diags: codes
        methods: methods
        types: types
        properties: properties
    }
    lists
}
