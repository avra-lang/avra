//! Lists — the first aggregate. `[e, e, e]` builds one; access
//! (`xs[i]`, `xs.length`) is the spine's postfix ladder; the walks,
//! the scans, the growth words and the copies are this feature's
//! method rows. A comprehension builds one by walking another:
//! `[e for x in xs if p]`, naming the index too with `[e for i, x
//! in xs]`, or by counting with `[e for i in lo..hi]` — each head is
//! the `for` statement's. A comprehension nests any number of heads,
//! left outermost, each reading every earlier one's binder — `[a + b
//! for a in xs for b in a.children if p(a, b)]` — with an `if`
//! filter after any head, in written order. `collect { for o in xs {
//! if o.ok { o.id } } }` gathers every value its statements would
//! discard.
use features.{
    LanguageFeature,
    BuilderRow,
    MethodRow,
    ReceiverEffect,
    TypeRow,
    PropertyRow,
    no_law,
    no_variants,
    measured_reg,
    lower_is_empty,
    bool_answer,
    held_element_answer,
    same_answer,
    str_answer,
    unknown_answer,
    void_answer,
}
use features.lists.{last_index, bool_comprehension_list, bool_comprehension_range}
use @std.grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use diagnostics.{DiagCode}

export fn lists() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name                | build
        "list_lit"          | build_list
        "comp"              | build_comp
        "comp_head"         | build_comp_head
        "comp_filter"       | build_comp_filter
        "collect"           | build_collect
        "collect_blockless" | build_collect_blockless
    }
    let codes = table<DiagCode> {
        kind                  | summary
        "type.list_empty"     | "an empty list has no element type to infer"
        "type.list_element"   | "a list's elements share one type"
        "type.list_scalar"    | "a list holds scalars for now"
        "type.place"          | "a mutation needs a mut place"
        "type.list"           | "a comprehension walks a list"
        "type.plan_residual"  | "a filter over a whole relation hands its rows to a call with no index narrowing it"
        "type.plans_mismatch" | "a planned lookup files by its field's own type"
        "type.plan_scan"      | "a relation a census counts past the floor is scanned whole for a compare no index answers"
    }
    let methods = table<MethodRow> {
        name         | takes   | check            | lower            | effect               | answers
        "map"        | on_walk | check_map        | lower_map        | ReceiverEffect.Read  | unknown_answer
        "filter"     | on_walk | check_filter     | lower_filter     | ReceiverEffect.Read  | same_answer
        "filter_map" | on_walk | check_filter_map | lower_filter_map | ReceiverEffect.Read  | unknown_answer
        "flat_map"   | on_walk | check_flat_map   | lower_flat_map   | ReceiverEffect.Read  | unknown_answer
        "flatten"    | on_walk | check_flatten    | lower_flatten    | ReceiverEffect.Read  | unknown_answer
        "take"       | on_walk | check_take       | lower_take       | ReceiverEffect.Read  | same_answer
        "drop"       | on_walk | check_drop       | lower_drop       | ReceiverEffect.Read  | same_answer
        "take_while" | on_walk | check_take_while | lower_take_while | ReceiverEffect.Read  | same_answer
        "drop_while" | on_walk | check_drop_while | lower_drop_while | ReceiverEffect.Read  | same_answer
        "find"       | on_walk | check_find       | lower_find       | ReceiverEffect.Lends | held_element_answer
        "find_last"  | on_walk | check_find_last  | lower_find_last  | ReceiverEffect.Lends | held_element_answer
        "find_map"   | on_list | check_find_map   | lower_find_map   | ReceiverEffect.Read  | unknown_answer
        "find_index" | on_walk | check_find_index | lower_find_index | ReceiverEffect.Read  | unknown_answer
        "any"        | on_walk | check_any        | lower_any        | ReceiverEffect.Read  | bool_answer
        "all"        | on_walk | check_all        | lower_all        | ReceiverEffect.Read  | bool_answer
        "contains"   | on_walk | check_contains   | lower_contains   | ReceiverEffect.Read  | bool_answer
        "index_of"   | on_walk | check_index_of   | lower_index_of   | ReceiverEffect.Read  | unknown_answer
        "count"      | on_walk | check_count      | lower_count      | ReceiverEffect.Read  | unknown_answer
        "sum"        | on_walk | check_sum        | lower_sum        | ReceiverEffect.Read  | unknown_answer
        "min"        | on_walk | check_min        | lower_min        | ReceiverEffect.Read  | unknown_answer
        "max"        | on_walk | check_max        | lower_max        | ReceiverEffect.Read  | unknown_answer
        "min_by"     | on_walk | check_min_by     | lower_min_by     | ReceiverEffect.Read  | unknown_answer
        "max_by"     | on_walk | check_max_by     | lower_max_by     | ReceiverEffect.Read  | unknown_answer
        "push"       | on_list | check_push       | lower_push       | ReceiverEffect.Write | void_answer
        "pop"        | on_list | check_pop        | lower_pop        | ReceiverEffect.Write | unknown_answer
        "set"        | on_list | check_set        | lower_set        | ReceiverEffect.Write | void_answer
        "is_empty"   | on_list | check_is_empty   | lower_is_empty   | ReceiverEffect.Read  | bool_answer
        "first"      | on_list | check_first      | lower_first      | ReceiverEffect.Lends | held_element_answer
        "last"       | on_list | check_last       | lower_last       | ReceiverEffect.Lends | held_element_answer
        "concat"     | on_list | check_concat     | lower_concat     | ReceiverEffect.Read  | same_answer
        "slice"      | on_list | check_slice      | lower_slice      | ReceiverEffect.Read  | same_answer
        "enumerate"  | on_list | check_enumerate  | lower_enumerate  | ReceiverEffect.Read  | unknown_answer
        "join"       | on_list | check_join       | lower_join       | ReceiverEffect.Read  | str_answer
    }
    let types = table<TypeRow> {
        name   | arity | slots | judge  | builds     | variants
        "List" | 1     | true  | no_law | list_shape | no_variants
    }
    let properties = table<PropertyRow> {
        name     | takes   | check        | lower
        "length" | on_list | check_length | measured_reg
    }
    LanguageFeature lists {
        gram: grammar {
            primary = "[" v:expression h:comp_head ( c:comp_head | c:comp_filter )* "]" @expect("]", "expected `]` to close the comprehension") -> comp(v, h, c) | "[" BREAK? ( first:expression ( "," BREAK? rest:expression )* ","? BREAK? )? "]" @expect("]", "expected `]` to close the list") -> list_lit(first, rest) | "collect" "{" ( s:stmt | BREAK )* "}" @expect("}", "expected `}` to close the `collect`") -> collect(s) | "collect" v:expression -> collect_blockless(v)
            comp_head = "for" ( "(" ix:NAME "," en:NAME ")" | ix:NAME "," en:NAME | en:NAME ) "in" src:expression ( ".." hi:expression )? -> comp_head(ix, en, src, hi)
            comp_filter = "if" c:expression -> comp_filter(c)
        }
        builders: rows
        diags: codes
        methods: methods
        types: types
        properties: properties
    }
    lists
}
