//! Lists — the first aggregate. `[e, e, e]` builds one; access
//! (`xs[i]`, `xs.length`) is the spine's postfix ladder; the walks,
//! the scans, the growth words and the copies are this feature's
//! method rows.
use features.{LanguageFeature, BuilderRow, MethodRow, TypeRow, PropertyRow, no_law, no_variants}
use diagnostics.{DiagCode}

export fn lists() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name       | build
        "list_lit" | build_list
        "comp"     | build_comp
    }
    let codes = table<DiagCode> {
        kind                | id      | summary
        "type.list_empty"   | "F2004" | "an empty list has no element type to infer"
        "type.list_element" | "F2005" | "a list's elements share one type"
        "type.list_scalar"  | "F2006" | "a list holds scalars for now"
        "type.place"        | "F2034" | "a mutation needs a mut place"
        "type.list"         | "F2041" | "a comprehension walks a list"
    }
    let methods = table<MethodRow> {
        name        | takes   | check           | lower
        "map"       | on_list | check_map       | lower_map
        "filter"    | on_list | check_filter    | lower_filter
        "find"      | on_list | check_find      | lower_find
        "any"       | on_list | check_any       | lower_any
        "all"       | on_list | check_all       | lower_all
        "contains"  | on_list | check_contains  | lower_contains
        "index_of"  | on_list | check_index_of  | lower_index_of
        "push"      | on_list | check_push      | lower_push
        "pop"       | on_list | check_pop       | lower_pop
        "set"       | on_list | check_set       | lower_set
        "is_empty"  | on_list | check_is_empty  | lower_is_empty
        "first"     | on_list | check_first     | lower_first
        "last"      | on_list | check_last      | lower_last
        "concat"    | on_list | check_concat    | lower_concat
        "slice"     | on_list | check_slice     | lower_slice
        "enumerate" | on_list | check_enumerate | lower_enumerate
        "join"      | on_list | check_join      | lower_join
    }
    let types = table<TypeRow> {
        name   | arity | slots | judge  | builds     | variants
        "List" | 1     | true  | no_law | list_shape | no_variants
    }
    let properties = table<PropertyRow> {
        name     | takes   | check        | lower
        "length" | on_list | check_length | lower_length
    }
    component LanguageFeature f {
        name = "lists"
        docs = "`[e for x in xs if p]` builds a list by walking another (`(i, x)` names the index too); `[first, second, third]` — a homogeneous aggregate; index with `xs[i]`, measure with `xs.length`."
        gram = """
primary = "[" v:expression "for" ( "(" ix:NAME "," en:NAME ")" | en:NAME ) "in" src:expression ( "if" c:expression )? "]" @expect("]", "expected `]` to close the comprehension") -> comp(v, ix, en, src, c) | "[" BREAK? ( first:expression ( "," BREAK? rest:expression )* ","? BREAK? )? "]" @expect("]", "expected `]` to close the list") -> list_lit(first, rest)
"""
        builders = rows
        diags = codes
        methods = methods
        types = types
        properties = properties
    }
    f
}
