//! The list vocabulary's LOWERING — the five walks (map, filter,
//! find, any, all: one loop skeleton, five aftermaths), the scans
//! (contains, index_of: the same skeleton, no fn box), the growth
//! words (push, pop, set), the edges (first, last), the measure
//! (is_empty) and the copies (concat, slice, join — one runtime
//! call each), each a row's rule. A walk emits the same brackets
//! `for` does, calls the fn box once per element, and lets the
//! memory pass own every count (owned element reads, retain-at-pack
//! pushes, cell settlement — nothing here spells a retain).
//! Early exit is the BREAK IDIOM: store the index past the length
//! and the condition ends the loop.
use core.{ExprId, Reg, Ins, Type, TypeId, BinOp, UnOp, Level}
use features.{LowerCx, MethodCall, lower_defect, grown_box, push_slot, slot_read, absent_of, adopted, carried_type, same_value, void_arm, void_close, unique_box, length_word}

// ── The rows' rules ──

export fn lower_map(cx: LowerCx, mc: MethodCall) -> Reg {
    let seat: Seat? = seat_of(cx, mc)
    if seat == null { return seatless(cx, mc) }
    mapped(cx, mc, seat!)
}

export fn lower_filter(cx: LowerCx, mc: MethodCall) -> Reg {
    let seat: Seat? = seat_of(cx, mc)
    if seat == null { return seatless(cx, mc) }
    kept(cx, mc, seat!)
}

export fn lower_find(cx: LowerCx, mc: MethodCall) -> Reg {
    let seat: Seat? = seat_of(cx, mc)
    if seat == null { return seatless(cx, mc) }
    found(cx, mc, seat!)
}

export fn lower_any(cx: LowerCx, mc: MethodCall) -> Reg {
    let seat: Seat? = seat_of(cx, mc)
    if seat == null { return seatless(cx, mc) }
    judged(cx, mc, seat!, false)
}

export fn lower_all(cx: LowerCx, mc: MethodCall) -> Reg {
    let seat: Seat? = seat_of(cx, mc)
    if seat == null { return seatless(cx, mc) }
    judged(cx, mc, seat!, true)
}

export fn lower_contains(cx: LowerCx, mc: MethodCall) -> Reg {
    let seat: Seat? = seat_of(cx, mc)
    if seat == null { return seatless(cx, mc) }
    held(cx, mc, seat!)
}

export fn lower_index_of(cx: LowerCx, mc: MethodCall) -> Reg {
    let seat: Seat? = seat_of(cx, mc)
    if seat == null { return seatless(cx, mc) }
    position(cx, mc, seat!)
}

export fn lower_push(cx: LowerCx, mc: MethodCall) -> Reg {
    let first: ExprId? = mc.args.first()
    if first == null { return lower_defect(cx, mc.e, "a push without its value survived typing") }
    let box = unique_box(cx, mc.subject)
    cx.emit(Ins.CallRtVoid("avra_array_push", [box, cx.reg_of(first!)]))
    nothing_reg(cx, mc.e)
}

/// `xs.pop()` — the place opens unique, the runtime removes the
/// last slot (the memory pass hands a managed one over as owned).
export fn lower_pop(cx: LowerCx, mc: MethodCall) -> Reg {
    let box = unique_box(cx, mc.subject)
    let dst = cx.result(mc.e)
    cx.emit(Ins.CallRt(dst, "avra_array_pop", [box]))
    dst
}

/// `xs.set(i, v)` — the place opens unique, the runtime rewrites
/// the slot (retain-at-pack is the memory pass's).
export fn lower_set(cx: LowerCx, mc: MethodCall) -> Reg {
    let box = unique_box(cx, mc.subject)
    cx.emit(Ins.CallRtVoid("avra_slot_set", [box, cx.reg_of(mc.args[0]), cx.reg_of(mc.args[1])]))
    nothing_reg(cx, mc.e)
}

/// `xs.is_empty()` — the length against zero.
export fn lower_is_empty(cx: LowerCx, mc: MethodCall) -> Reg {
    let len = measured(cx, mc.subject)
    let zero = const_int(cx, 0)
    let dst = cx.result(mc.e)
    cx.emit(Ins.Bin(dst, BinOp.Eq, len, zero))
    dst
}

export fn lower_first(cx: LowerCx, mc: MethodCall) -> Reg { edge(cx, mc, false) }
export fn lower_last(cx: LowerCx, mc: MethodCall) -> Reg { edge(cx, mc, true) }

export fn lower_concat(cx: LowerCx, mc: MethodCall) -> Reg { copied(cx, mc, "avra_array_concat") }
export fn lower_slice(cx: LowerCx, mc: MethodCall) -> Reg { copied(cx, mc, "avra_array_slice") }
export fn lower_join(cx: LowerCx, mc: MethodCall) -> Reg { copied(cx, mc, "avra_str_join") }

/// `xs.enumerate()` is the list — the paired `for` head does the
/// pairing.
export fn lower_enumerate(cx: LowerCx, mc: MethodCall) -> Reg {
    cx.reg_of(mc.subject)
}

/// `xs.length` — the word the one measure table gives the list's
/// shape.
export fn lower_length(cx: LowerCx, e: ExprId, subject: ExprId) -> Reg {
    let xs = cx.reg_of(subject)
    let word: string? = length_word(cx.view.types.shape_of(cx.type_at(subject)))
    if word == null { return lower_defect(cx, e, "a length on an unmeasurable shape survived typing") }
    let dst = cx.result(e)
    cx.emit(Ins.CallRt(dst, word!, [xs]))
    dst
}

/// What typing seated a row with: the element the receiver holds
/// and the first argument — a walk's fn, a scan's needle. Absent
/// only when a seatless row survived typing — a defect.
type Seat = { elem: TypeId, arg: ExprId }

fn seat_of(cx: LowerCx, mc: MethodCall) -> Seat? {
    let elem: TypeId? = cx.view.types.element(cx.type_at(mc.subject))
    let first: ExprId? = mc.args.first()
    if elem == null || first == null { return null }
    let seat = Seat { elem: elem!, arg: first! }
    seat
}

fn seatless(cx: LowerCx, mc: MethodCall) -> Reg {
    lower_defect(cx, mc.e, "a row without its seat survived typing")
}

// ── The walks ──

/// One walk's fixtures: subject, bounds, the index cell the loop
/// steps, and the element type each turn reads.
type Walk = { xs: Reg, len: Reg, idx: Reg, elem: TypeId }

/// A walk's fn: the box and its code pointer (read once —
/// loop-invariant).
type Box = { f: Reg, fp: Reg }

/// `xs.map(f)` — a fresh box, one pushed answer per element.
fn mapped(cx: LowerCx, mc: MethodCall, s: Seat) -> Reg {
    let out = cx.result(mc.e)
    grown_box(cx, out, [])
    let f = boxed(cx, s.arg)
    let w = opened(cx, mc.subject, s.elem)
    turn_open(cx, w)
    let v = turn_elem(cx, w)
    push_slot(cx, out, turn_call(cx, f, v, mapped_to(cx, mc.e)))
    turn_close(cx, w)
    out
}

/// `xs.filter(p)` — the same box, the elements the predicate keeps.
fn kept(cx: LowerCx, mc: MethodCall, s: Seat) -> Reg {
    let out = cx.result(mc.e)
    grown_box(cx, out, [])
    let f = boxed(cx, s.arg)
    let w = opened(cx, mc.subject, s.elem)
    turn_open(cx, w)
    let v = turn_elem(cx, w)
    cx.emit(Ins.IfStart(turn_call(cx, f, v, bool_ty(cx))))
    push_slot(cx, out, v)
    void_arm(cx)
    void_close(cx)
    turn_close(cx, w)
    out
}

/// `xs.find(p)` — an Opt cell, absent until the first hit, which
/// also ends the walk.
fn found(cx: LowerCx, mc: MethodCall, s: Seat) -> Reg {
    let opt = cx.type_at(mc.e)
    let cell = absent_cell(cx, opt)
    let f = boxed(cx, s.arg)
    let w = opened(cx, mc.subject, s.elem)
    turn_open(cx, w)
    let v = turn_elem(cx, w)
    cx.emit(Ins.IfStart(turn_call(cx, f, v, bool_ty(cx))))
    cx.emit(Ins.Store(cell, adopted(cx, opt, false, v)))
    early_exit(cx, w)
    void_arm(cx)
    void_close(cx)
    turn_close(cx, w)
    loaded(cx, mc.e, cell)
}

/// `xs.any(p)` / `xs.all(p)` — a bool cell seeded with the verdict
/// an EMPTY walk gives; the first counterexample flips it and ends
/// the walk.
fn judged(cx: LowerCx, mc: MethodCall, s: Seat, all: bool) -> Reg {
    let cell = bool_cell(cx, all)
    let f = boxed(cx, s.arg)
    let w = opened(cx, mc.subject, s.elem)
    turn_open(cx, w)
    let v = turn_elem(cx, w)
    let p = turn_call(cx, f, v, bool_ty(cx))
    cx.emit(Ins.IfStart(flipping(cx, p, all)))
    store_bool(cx, cell, !all)
    early_exit(cx, w)
    void_arm(cx)
    void_close(cx)
    turn_close(cx, w)
    loaded(cx, mc.e, cell)
}

/// `xs.contains(v)` — a bool cell seeded false; the first equal
/// element flips it and ends the walk.
fn held(cx: LowerCx, mc: MethodCall, s: Seat) -> Reg {
    let cell = bool_cell(cx, false)
    let needle = cx.reg_of(s.arg)
    let w = opened(cx, mc.subject, s.elem)
    turn_open(cx, w)
    let v = turn_elem(cx, w)
    cx.emit(Ins.IfStart(same_value(cx, v, needle, s.elem)))
    store_bool(cx, cell, true)
    early_exit(cx, w)
    void_arm(cx)
    void_close(cx)
    turn_close(cx, w)
    loaded(cx, mc.e, cell)
}

/// `xs.index_of(v)` — an int cell seeded -1; the first equal
/// element stores its index and ends the walk.
fn position(cx: LowerCx, mc: MethodCall, s: Seat) -> Reg {
    let miss = const_int(cx, 0 - 1)
    let cell = cx.mint_shape(Type.Int)
    cx.emit(Ins.Alloca(cell))
    cx.emit(Ins.Store(cell, miss))
    let needle = cx.reg_of(s.arg)
    let w = opened(cx, mc.subject, s.elem)
    turn_open(cx, w)
    let v = turn_elem(cx, w)
    cx.emit(Ins.IfStart(same_value(cx, v, needle, s.elem)))
    let here = cx.mint_shape(Type.Int)
    cx.emit(Ins.Load(here, w.idx))
    cx.emit(Ins.Store(cell, here))
    early_exit(cx, w)
    void_arm(cx)
    void_close(cx)
    turn_close(cx, w)
    loaded(cx, mc.e, cell)
}

/// `xs.first()` / `xs.last()` — an Opt cell seeded absent, the edge
/// slot adopted when the list has one.
fn edge(cx: LowerCx, mc: MethodCall, last: bool) -> Reg {
    let opt = cx.type_at(mc.e)
    let xs = cx.reg_of(mc.subject)
    let cell = absent_cell(cx, opt)
    let len = measured(cx, mc.subject)
    let zero = const_int(cx, 0)
    let some = cx.mint_shape(Type.Bool)
    cx.emit(Ins.Bin(some, BinOp.Lt, zero, len))
    cx.emit(Ins.IfStart(some))
    let at = if last { decremented(cx, len) } else { zero }
    let raw = cx.mint_ty(carried_type(cx, opt))
    cx.emit(Ins.CallRt(raw, "avra_array_get", [xs, at]))
    cx.emit(Ins.Store(cell, adopted(cx, opt, false, raw)))
    void_arm(cx)
    void_close(cx)
    loaded(cx, mc.e, cell)
}

/// A copy the runtime makes: the receiver and the arguments, one
/// call, an owned answer.
fn copied(cx: LowerCx, mc: MethodCall, callee: string) -> Reg {
    let args = [cx.reg_of(mc.subject)].concat([cx.reg_of(a) for a in mc.args])
    let dst = cx.result(mc.e)
    cx.emit(Ins.CallRt(dst, callee, args))
    dst
}

// ── The skeleton ────────────────────────────────────────────────

/// The fn box and its code pointer, minted before the walk opens.
fn boxed(cx: LowerCx, f: ExprId) -> Box {
    let box = cx.reg_of(f)
    Box { f: box, fp: slot_read(cx, box, 0, null) }
}

/// The fixtures, minted before the brackets open.
fn opened(cx: LowerCx, subject: ExprId, elem: TypeId) -> Walk {
    let xs = cx.reg_of(subject)
    let len = measured(cx, subject)
    let zero = const_int(cx, 0)
    let idx = cx.mint_shape(Type.Int)
    cx.emit(Ins.Alloca(idx))
    cx.emit(Ins.Store(idx, zero))
    Walk { xs: xs, len: len, idx: idx, elem: elem }
}

/// LoopStart, the condition, and the turn's scope.
fn turn_open(cx: LowerCx, w: Walk) {
    cx.emit(Ins.LoopStart)
    let at = cx.mint_shape(Type.Int)
    cx.emit(Ins.Load(at, w.idx))
    let more = cx.mint_shape(Type.Bool)
    cx.emit(Ins.Bin(more, BinOp.Lt, at, w.len))
    cx.emit(Ins.LoopCond(more))
    cx.emit(Ins.ScopeEnter(Level.Application))
}

/// This turn's element — a RUNTIME index, so the read stays raw.
fn turn_elem(cx: LowerCx, w: Walk) -> Reg {
    let here = cx.mint_shape(Type.Int)
    cx.emit(Ins.Load(here, w.idx))
    let v = cx.mint_ty(w.elem)
    cx.emit(Ins.CallRt(v, "avra_array_get", [w.xs, here]))
    v
}

/// The fn box asked about this element.
fn turn_call(cx: LowerCx, f: Box, v: Reg, ret: TypeId) -> Reg {
    let r = cx.mint_ty(ret)
    cx.emit(Ins.CallPtr(r, f.fp, [f.f, v]))
    r
}

/// Step, settle the turn's scope, close the back edge.
fn turn_close(cx: LowerCx, w: Walk) {
    let again = cx.mint_shape(Type.Int)
    cx.emit(Ins.Load(again, w.idx))
    let one = const_int(cx, 1)
    let next = cx.mint_shape(Type.Int)
    cx.emit(Ins.Bin(next, BinOp.Add, again, one))
    cx.emit(Ins.Store(w.idx, next))
    cx.emit(Ins.ScopeExit(null))
    cx.emit(Ins.LoopEnd)
}

/// The BREAK idiom: an index past the length ends the walk.
fn early_exit(cx: LowerCx, w: Walk) {
    cx.emit(Ins.Store(w.idx, w.len))
}

/// `any` fires ON the predicate; `all` fires on its failure.
fn flipping(cx: LowerCx, p: Reg, all: bool) -> Reg {
    if !all { return p }
    let np = cx.mint_shape(Type.Bool)
    cx.emit(Ins.Un(np, UnOp.Not, p))
    np
}

/// What `map` answers per element — the result list's own element,
/// or the node's own type on the absorbing path.
fn mapped_to(cx: LowerCx, e: ExprId) -> TypeId {
    let elem: TypeId? = cx.view.types.element(cx.type_at(e))
    elem ?? cx.type_at(e)
}

fn bool_ty(cx: LowerCx) -> TypeId {
    cx.view.types.intern(Type.Bool)
}

// ── The small mints ─────────────────────────────────────────────

/// The receiver's length, asked of the runtime.
fn measured(cx: LowerCx, subject: ExprId) -> Reg {
    let xs = cx.reg_of(subject)
    let len = cx.mint_shape(Type.Int)
    cx.emit(Ins.CallRt(len, "avra_array_len", [xs]))
    len
}

fn const_int(cx: LowerCx, n: int) -> Reg {
    let r = cx.mint_shape(Type.Int)
    cx.emit(Ins.ConstInt(r, n))
    r
}

fn decremented(cx: LowerCx, n: Reg) -> Reg {
    let one = const_int(cx, 1)
    let r = cx.mint_shape(Type.Int)
    cx.emit(Ins.Bin(r, BinOp.Sub, n, one))
    r
}

/// A bool cell seeded with `seed`.
fn bool_cell(cx: LowerCx, seed: bool) -> Reg {
    let v = cx.mint_shape(Type.Bool)
    cx.emit(Ins.ConstBool(v, seed))
    let cell = cx.mint_shape(Type.Bool)
    cx.emit(Ins.Alloca(cell))
    cx.emit(Ins.Store(cell, v))
    cell
}

fn store_bool(cx: LowerCx, cell: Reg, b: bool) {
    let v = cx.mint_shape(Type.Bool)
    cx.emit(Ins.ConstBool(v, b))
    cx.emit(Ins.Store(cell, v))
}

/// An Opt cell seeded absent.
fn absent_cell(cx: LowerCx, opt: TypeId) -> Reg {
    let seed = absent_of(cx, opt)
    let cell = cx.mint_ty(opt)
    cx.emit(Ins.Alloca(cell))
    cx.emit(Ins.Store(cell, seed))
    cell
}

/// The node's answer, read out of its cell.
fn loaded(cx: LowerCx, e: ExprId, cell: Reg) -> Reg {
    let dst = cx.result(e)
    cx.emit(Ins.Load(dst, cell))
    dst
}

/// The answer of a word that answers nothing.
fn nothing_reg(cx: LowerCx, e: ExprId) -> Reg {
    let dst = cx.result(e)
    cx.emit(Ins.ConstInt(dst, 0))
    dst
}
