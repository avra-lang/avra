//! The list vocabulary's LOWERING — the walks (find, any, all: one
//! loop skeleton, three aftermaths; `map`/`filter` fold through
//! `chain.av` and the pipeline instead), the scans
//! (contains, index_of: the same skeleton, no fn box), the growth
//! words (push, pop, set), the edges (first, last), the measure
//! (is_empty) and the copies (concat, slice, join — one runtime
//! call each), each a row's rule. A walk emits the same brackets
//! `for` does, calls the fn box once per element, and lets the
//! memory pass own every count (owned element reads, retain-at-pack
//! pushes, cell settlement — nothing here spells a retain).
//! Early exit is the BREAK IDIOM: store the index past the length
//! and the condition ends the loop.
use core.{ExprId, Reg, Ins, Type, TypeId, BinOp}
use features.{LowerCx, MethodCall}

// ── The rows' rules ──

export fn lower_map(mut cx: LowerCx, mc: MethodCall) -> Reg { chained(cx, mc) }

export fn lower_filter(mut cx: LowerCx, mc: MethodCall) -> Reg { chained(cx, mc) }

export fn lower_find(mut cx: LowerCx, mc: MethodCall) -> Reg {
    let seat? = seat_of(cx, mc) else { return seatless(cx, mc) }
    found(cx, mc, seat)
}

export fn lower_find_index(mut cx: LowerCx, mc: MethodCall) -> Reg {
    let seat? = seat_of(cx, mc) else { return seatless(cx, mc) }
    found_at(cx, mc, seat)
}

export fn lower_any(mut cx: LowerCx, mc: MethodCall) -> Reg {
    let seat? = seat_of(cx, mc) else { return seatless(cx, mc) }
    judged(cx, mc, seat, false)
}

export fn lower_all(mut cx: LowerCx, mc: MethodCall) -> Reg {
    let seat? = seat_of(cx, mc) else { return seatless(cx, mc) }
    judged(cx, mc, seat, true)
}

export fn lower_contains(mut cx: LowerCx, mc: MethodCall) -> Reg {
    let seat? = seat_of(cx, mc) else { return seatless(cx, mc) }
    held(cx, mc, seat)
}

export fn lower_index_of(mut cx: LowerCx, mc: MethodCall) -> Reg {
    let seat? = seat_of(cx, mc) else { return seatless(cx, mc) }
    position(cx, mc, seat)
}

export fn lower_push(mut cx: LowerCx, mc: MethodCall) -> Reg {
    let first? = mc.args.first() else { return cx.lower_defect(mc.e, "a push without its value survived typing") }
    let box = cx.unique_box(mc.subject)
    cx.push_slot(box, cx.reg_of(first))
    nothing_reg(cx, mc.e)
}

/// `xs.pop()` — the place opens unique, the runtime removes the
/// last slot (the memory pass hands a managed one over as owned).
export fn lower_pop(mut cx: LowerCx, mc: MethodCall) -> Reg {
    let box = cx.unique_box(mc.subject)
    cx.popped(box, cx.type_at(mc.e))
}

/// `xs.set(i, v)` — the place opens unique, the runtime rewrites
/// the slot (retain-at-pack is the memory pass's).
export fn lower_set(mut cx: LowerCx, mc: MethodCall) -> Reg {
    let box = cx.unique_box(mc.subject)
    cx.slot_write(box, cx.reg_of(mc.args[0]), cx.reg_of(mc.args[1]))
    nothing_reg(cx, mc.e)
}

/// `xs.is_empty()` — the length against zero.
export fn lower_first(mut cx: LowerCx, mc: MethodCall) -> Reg { edge(cx, mc, false) }
export fn lower_last(mut cx: LowerCx, mc: MethodCall) -> Reg { edge(cx, mc, true) }

export fn lower_concat(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.array_concat(cx.shape_at(mc.e), cx.reg_of(mc.subject), cx.reg_of(mc.args[0])) }
export fn lower_slice(mut cx: LowerCx, mc: MethodCall) -> Reg {
    cx
        .array_slice(cx.shape_at(mc.e), cx.reg_of(mc.subject), cx.reg_of(mc.args[0]), cx.reg_of(mc.args[1]))
}
export fn lower_join(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.str_join(cx.shape_at(mc.e), cx.reg_of(mc.subject), cx.reg_of(mc.args[0])) }

/// `xs.enumerate()` is the list — the paired `for` head does the
/// pairing.
export fn lower_enumerate(mut cx: LowerCx, mc: MethodCall) -> Reg {
    cx.reg_of(mc.subject)
}

/// What typing seated a row with: the element the receiver holds
/// and the first argument — a walk's fn, a scan's needle. Absent
/// only when a seatless row survived typing — a defect.
type Seat = { elem: TypeId, arg: ExprId }

fn seat_of(cx: LowerCx, mc: MethodCall) -> Seat? {
    let elem: TypeId? = cx.view.types.element(cx.type_at(mc.subject))
    let first: ExprId? = mc.args.first()
    if elem == null || first == null { return null }
    let seat = Seat { elem: elem!, arg: first! }
    seat
}

fn seatless(mut cx: LowerCx, mc: MethodCall) -> Reg {
    cx.lower_defect(mc.e, "a row without its seat survived typing")
}

// ── The walks ──

/// A walk's fn: the box and its code pointer (read once —
/// loop-invariant).
type Box = { f: Reg, fp: Reg }

/// `xs.find(p)` — an Opt cell, absent until the first hit, which
/// also ends the walk.
fn found(mut cx: LowerCx, mc: MethodCall, s: Seat) -> Reg {
    let opt = cx.type_at(mc.e)
    let cell = absent_cell(cx, opt)
    let f = boxed(cx, s.arg)
    let w = cx.opened(mc.subject, s.elem)
    let v = cx.turn_elem(w, cx.turn_open(w))
    cx
        .void_region(turn_call(cx, f, v, bool_ty(cx))) { cx ->
            cx.emit(Ins.Store(cell, cx.adopted(opt, false, v)))
            cx.walk_done()
        }
    cx.loop_end()
    cx.loaded(mc.e, cell)
}

/// `xs.find_index(p)` — an `int?` cell seeded absent; the first element
/// `p` blesses writes its index there and ends the walk.
fn found_at(mut cx: LowerCx, mc: MethodCall, s: Seat) -> Reg {
    let opt = cx.type_at(mc.e)
    let cell = absent_cell(cx, opt)
    let f = boxed(cx, s.arg)
    let w = cx.opened(mc.subject, s.elem)
    let here = cx.turn_open(w)
    let v = cx.turn_elem(w, here)
    cx
        .void_region(turn_call(cx, f, v, bool_ty(cx))) { cx ->
            cx.emit(Ins.Store(cell, cx.adopted(opt, false, here)))
            cx.walk_done()
        }
    cx.loop_end()
    cx.loaded(mc.e, cell)
}

/// `xs.any(p)` / `xs.all(p)` — a bool cell seeded with the verdict
/// an EMPTY walk gives; the first counterexample flips it and ends
/// the walk.
fn judged(mut cx: LowerCx, mc: MethodCall, s: Seat, all: bool) -> Reg {
    let cell = bool_cell(cx, all)
    let f = boxed(cx, s.arg)
    let w = cx.opened(mc.subject, s.elem)
    let v = cx.turn_elem(w, cx.turn_open(w))
    let p = turn_call(cx, f, v, bool_ty(cx))
    cx
        .void_region(flipping(cx, p, all)) { cx ->
            store_bool(cx, cell, !all)
            cx.walk_done()
        }
    cx.loop_end()
    cx.loaded(mc.e, cell)
}

/// `xs.contains(v)` — a bool cell seeded false; the first equal
/// element flips it and ends the walk.
fn held(mut cx: LowerCx, mc: MethodCall, s: Seat) -> Reg {
    let cell = bool_cell(cx, false)
    let needle = cx.reg_of(s.arg)
    let w = cx.opened(mc.subject, s.elem)
    let v = cx.turn_elem(w, cx.turn_open(w))
    cx
        .void_region(cx.same_value(v, needle, s.elem)) { cx ->
            store_bool(cx, cell, true)
            cx.walk_done()
        }
    cx.loop_end()
    cx.loaded(mc.e, cell)
}

/// `xs.index_of(v)` — an int cell seeded -1; the first equal
/// element stores its index and ends the walk.
fn position(mut cx: LowerCx, mc: MethodCall, s: Seat) -> Reg {
    let cell = cx.seeded_cell(cx.type(int), cx.const_int(-1))
    let needle = cx.reg_of(s.arg)
    let w = cx.opened(mc.subject, s.elem)
    let here = cx.turn_open(w)
    let v = cx.turn_elem(w, here)
    cx
        .void_region(cx.same_value(v, needle, s.elem)) { cx ->
            cx.emit(Ins.Store(cell, here))
            cx.walk_done()
        }
    cx.loop_end()
    cx.loaded(mc.e, cell)
}

/// `xs.first()` / `xs.last()` — an Opt cell seeded absent, the edge
/// slot adopted when the list has one.
fn edge(mut cx: LowerCx, mc: MethodCall, last: bool) -> Reg {
    let opt = cx.type_at(mc.e)
    let xs = cx.reg_of(mc.subject)
    let cell = absent_cell(cx, opt)
    let len = cx.measure_of(mc.subject, cx.reg_of(mc.subject), cx.type_at(mc.subject))
    let zero = cx.const_int(0)
    cx
        .void_region(cx.bin(Type.Bool, BinOp.Lt, zero, len)) { cx ->
            let at = if last { decremented(cx, len) } else { zero }
            let raw = cx.elem_read(xs, at, cx.carried_type(opt))
            cx.emit(Ins.Store(cell, cx.adopted(opt, false, raw)))
        }
    cx.loaded(mc.e, cell)
}

// ── The skeleton ────────────────────────────────────────────────

/// The fn box and its code pointer, minted before the walk opens.
fn boxed(mut cx: LowerCx, f: ExprId) -> Box {
    let box = cx.reg_of(f)
    Box { f: box, fp: cx.slot_read(box, 0, null) }
}

/// The fn box asked about this element.
fn turn_call(mut cx: LowerCx, f: Box, v: Reg, ret: TypeId) -> Reg {
    cx.call_ptr(ret, f.fp, [f.f, v])
}

/// Step, settle the turn's scope, close the back edge.
/// `any` fires ON the predicate; `all` fires on its failure.
fn flipping(mut cx: LowerCx, p: Reg, all: bool) -> Reg {
    if !all { return p }
    cx.un(p)
}

/// What `map` answers per element — the result list's own element,
/// or the node's own type on the absorbing path.
fn mapped_to(cx: LowerCx, e: ExprId) -> TypeId {
    let elem: TypeId? = cx.view.types.element(cx.type_at(e))
    elem ?? cx.type_at(e)
}

fn bool_ty(cx: LowerCx) -> TypeId {
    cx.type(bool)
}

// ── The small mints ─────────────────────────────────────────────

fn decremented(mut cx: LowerCx, n: Reg) -> Reg {
    cx.bin(Type.Int, BinOp.Sub, n, cx.const_int(1))
}

fn bool_cell(mut cx: LowerCx, seed: bool) -> Reg {
    cx.seeded_cell(bool_ty(cx), cx.const_bool(seed))
}

fn store_bool(mut cx: LowerCx, cell: Reg, b: bool) {
    cx.emit(Ins.Store(cell, cx.const_bool(b)))
}

fn absent_cell(mut cx: LowerCx, opt: TypeId) -> Reg {
    cx.seeded_cell(opt, cx.absent_of(opt))
}

/// The answer of a word that answers nothing.
fn nothing_reg(mut cx: LowerCx, e: ExprId) -> Reg {
    cx.zero(e)
}
