//! The literal's typing law: elements share ONE type and each must
//! ride a slot (the SAME law every aggregate slot obeys — R0's
//! widening reached lists at G3); the empty literal is the
//! absence-of-elements value, adopted by whatever list claims it.
use core.{ExprId, Type, TypeId}
use features.{TypeCx, spoken, types_disagree, this_is, slot_worthy, accepts}
use diagnostics.{error_at, pointed}

fn list_type(cx: TypeCx, e: ExprId, elems: List<ExprId>) -> TypeId {
    if elems.is_empty() { return cx.types.intern(Type.EmptyList) }
    // a slot that KNOWS its elements judges each by the one
    // assignment door — heterogeneity boxes, lambdas hear seats
    let want: TypeId? = wanted_elem(cx, e)
    if want != null { return heard_list(cx, elems, want!) }
    let head = elems[0]
    let elem = cx.type_at(head)
    if cx.shape_at(head) is .Error { return cx.error_type }
    if !slot_worthy(cx.shape_at(head)) { return unslottable_element(cx, head) }
    for k in elems {
        if types_disagree(cx, cx.type_at(k), elem) { return disagreeing_element(cx, k, elem) }
    }
    cx.types.intern(Type.List(elem))
}

/// The element the planted want declares, when the slot is a list.
fn wanted_elem(cx: TypeCx, e: ExprId) -> TypeId? {
    let w: TypeId? = cx.want_at(e)
    if w == null { return null }
    match cx.types.shape_of(w!) {
        .List(t) -> t,
        _ -> null,
    }
}

/// Every element through `accepts` against the declared element —
/// widens record (dyn boxes, auto-Ok), and the refusals speak the
/// slot's words, not the head's.
fn heard_list(cx: TypeCx, elems: List<ExprId>, want: TypeId) -> TypeId {
    for k in elems {
        if !accepts(cx, k, want) { return unwanted_element(cx, k, want) }
    }
    cx.types.intern(Type.List(want))
}

// ── The voices ──

fn unslottable_element(cx: TypeCx, head: ExprId) -> TypeId {
    spoken(cx, pointed(
        error_at("type.list_scalar", cx.loc_of(head), "a list element cannot hold this yet"),
        this_is(cx.name_at(head)))
        with { help: "nullable elements arrive with ownership's next slice" })
}

fn disagreeing_element(cx: TypeCx, k: ExprId, elem: TypeId) -> TypeId {
    let n = cx.name_at(k)
    spoken(cx, pointed(
        error_at("type.list_element", cx.loc_of(k),
            "a list's elements share one type — the first is `${cx.types.name_of(elem)}`, this is `${n}`"),
        this_is(n)))
}

fn unwanted_element(cx: TypeCx, k: ExprId, want: TypeId) -> TypeId {
    let n = cx.name_at(k)
    spoken(cx, pointed(
        error_at("type.list_element", cx.loc_of(k),
            "this list holds `${cx.types.name_of(want)}`, this is `${n}`"),
        this_is(n)))
}
