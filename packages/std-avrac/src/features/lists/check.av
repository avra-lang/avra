//! The literal's typing law: elements share ONE type and each must
//! ride a slot (the SAME law every aggregate slot obeys — R0's
//! widening reached lists at G3); the empty literal is the
//! absence-of-elements value, adopted by whatever list claims it.
use core.{ExprId, Type, TypeId}
use features.{TypeCx, spoken, this_is, slot_worthy, want_refused, accepts, slice_promise, require_bool}
use diagnostics.{refusal}

fn list_type(mut cx: TypeCx, e: ExprId, elems: List<ExprId>) -> TypeId {
    if elems.is_empty() { return cx.view.types.intern(Type.EmptyList) }
    if want_refused(cx, e) { return cx.error_type }
    // a slot that KNOWS its elements judges each by the one
    // assignment door — heterogeneity boxes, lambdas hear seats
    let want: TypeId? = wanted_elem(cx, e)
    if want != null { return heard_list(cx, e, elems, want!) }
    let head = leading_element(cx, elems)
    let elem = cx.type_at(head)
    if cx.shape_at(head) is .Error { return cx.error_type }
    if !slot_worthy(cx.view.types, cx.shape_at(head)) { return unslottable_element(cx, head) }
    for k in elems {
        if !accepts(cx, k, elem) { return disagreeing_element(cx, k, elem) }
    }
    cx.view.types.intern(Type.List(elem))
}

/// The element that names the list's type: the first that is not
/// an empty literal — `[]` is adopted by whatever its siblings are
/// — nor a hungry one, which its siblings' type will feed.
fn leading_element(cx: TypeCx, elems: List<ExprId>) -> ExprId {
    for k in elems {
        let sh: Type = cx.shape_at(k)
        if !(sh is .EmptyList) && !(sh is .Error) { return k }
    }
    elems[0]
}

/// The element the planted want declares, when the slot is a list.
fn wanted_elem(cx: TypeCx, e: ExprId) -> TypeId? {
    let w: TypeId? = cx.want_at(e)
    if w == null { return null }
    let elem: TypeId? = cx.view.types.element(w!)
    elem
}

/// Every element through `accepts` against the declared element —
/// widens record (dyn boxes, auto-Ok), and the refusals speak the
/// slot's words, not the head's.
fn heard_list(mut cx: TypeCx, e: ExprId, elems: List<ExprId>, want: TypeId) -> TypeId {
    if !slot_worthy(cx.view.types, cx.view.types.shape_of(want)) { return unslottable_want(cx, e, want) }
    for k in elems {
        if !accepts(cx, k, want) { return unwanted_element(cx, k, want) }
    }
    cx.view.types.intern(Type.List(want))
}

// ── The voices ──

fn unslottable_element(mut cx: TypeCx, head: ExprId) -> TypeId {
    if cx.shape_at(head) is .Void {
        return spoken(cx, refusal("type.list_scalar", cx.loc_of(head), "a list element cannot hold nothing — this answers no value", "answers nothing", null))
    }
    spoken(cx, refusal("type.list_scalar", cx.loc_of(head), "a list element cannot hold this yet", this_is(cx.name_at(head)), slice_promise("elements")))
}

fn unslottable_want(mut cx: TypeCx, e: ExprId, want: TypeId) -> TypeId {
    spoken(cx, refusal("type.list_scalar", cx.loc_of(e), "a list element cannot hold `${cx.view.types.name_of(want)}` yet", "this list", slice_promise("elements")))
}

fn disagreeing_element(mut cx: TypeCx, k: ExprId, elem: TypeId) -> TypeId {
    let n = cx.name_at(k)
    spoken(cx, refusal("type.list_element", cx.loc_of(k), "a list's elements share one type — the first is `${cx.view.types.name_of(elem)}`, this is `${n}`", this_is(n), null))
}

fn unwanted_element(mut cx: TypeCx, k: ExprId, want: TypeId) -> TypeId {
    let n = cx.name_at(k)
    spoken(cx, refusal("type.list_element", cx.loc_of(k), "this list holds `${cx.view.types.name_of(want)}`, this is `${n}`", this_is(n), null))
}

/// THE COMPREHENSION LAW: the source is a list, its element type is
/// the name's (and the index is an int); the filter is a bool; the
/// answer is a list of the element expression's type.
fn comp_type(mut cx: TypeCx, e: ExprId, elem: ExprId, index: string, source: ExprId, cond: ExprId?) -> TypeId {
    let st = cx.walk_type(source)
    if cx.shape_at(source) is .Error { return cx.error_type }
    let held: TypeId? = cx.view.types.element(st)
    if held == null { return not_walkable(cx, source) }
    let tys = comp_types(cx, index, held!)
    cx.bind_types(elem, tys)
    if cond != null { filter_checks(cx, cond!, tys) }
    let ety = cx.walk_type(elem)
    if cx.shape_at(elem) is .Error || want_refused(cx, e) { return cx.error_type }
    if !slot_worthy(cx.view.types, cx.shape_at(elem)) { return unslottable_element(cx, elem) }
    cx.view.types.intern(Type.List(ety))
}

/// The filter, under the binders: a bool.
fn filter_checks(mut cx: TypeCx, cond: ExprId, tys: List<TypeId>) {
    cx.bind_types(cond, tys)
    let _ = cx.walk_type(cond)
    require_bool(cx, cond, "a comprehension's filter", "this decides the element")
}

/// The binders' types in pre-order: the index's int first when named.
fn comp_types(mut cx: TypeCx, index: string, elem: TypeId) -> List<TypeId> {
    if index == "" { return [elem] }
    [cx.view.types.intern(Type.Int), elem]
}

fn not_walkable(mut cx: TypeCx, source: ExprId) -> TypeId {
    let n = cx.name_at(source)
    spoken(cx, refusal("type.list", cx.loc_of(source), "a comprehension walks a list, found `${n}`", this_is(n), "`for x in xs` needs a `List<T>` — an empty `[]` has no element yet"))
}
