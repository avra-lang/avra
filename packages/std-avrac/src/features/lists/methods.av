//! The list vocabulary's TYPING — the five walks (each judging its
//! fn argument's seats and answer before any loop exists), the
//! scans, the growth words and the copies, each a row's rule; the
//! receiver is always a list because the row's `takes` said so.
use core.{ExprId, TypeId, Type, Arrow, LambdaParts, no_marks}
use features.{TypeCx, MethodCall, this_is, slot_worthy, TypeArgs, PipeStage}
use diagnostics.{refusal}

/// The empty literal takes the rows too — each rule refuses it in
/// the walk's own words.
export fn on_list(t: Type) -> bool {
    t is .List || t is .EmptyList
}

/// The pipeline verbs' receivers: a list (or the empty literal), or a
/// `(lo..hi)` range, which walks as its own counter.
export fn on_walk(t: Type) -> bool {
    t is .List || t is .EmptyList || t is .Range
}

// ── The rows' rules ──

/// `xs.map(f)` — a list of what the fn answers, which must fit a
/// slot.
export fn check_map(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let seat? = walk_seat(cx, mc, "map") else { return cx.error_type }
    let answer = seat.answer
    if !slot_worthy(cx.view.types.shape_of(answer)) { return uncollectable(cx, mc.e, answer) }
    cx.facts.mark_stage(mc.e, .Map)
    cx.type(List<answer>)
}

/// `xs.filter_map(f)` — the fn answers `T?`; present answers join the
/// list, absent ones drop.
export fn check_filter_map(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let seat? = walk_seat(cx, mc, "filter_map") else { return cx.error_type }
    let held: TypeId? = match cx.view.types.seen_shape(seat.answer) {
        .Opt(inner) -> inner,
        _ -> null,
    }
    if held == null { return filter_map_needs_opt(cx, mc.e, seat.answer) }
    let inner = held!
    if !slot_worthy(cx.view.types.shape_of(inner)) { return uncollectable(cx, mc.e, inner) }
    cx.facts.mark_stage(mc.e, .FilterMap)
    cx.type(List<inner>)
}

fn filter_map_needs_opt(mut cx: TypeCx, e: ExprId, answer: TypeId) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.list_element",
                cx.loc_of(e),
                "`filter_map`'s fn answers an optional, and this one answers `${cx.view.types.name_of(answer)}`",
                "filter_map here",
                "answer `T?` — null drops the element",
            ),
        )
}

/// `xs.flat_map(f)` — the fn answers a LIST per element; every inner
/// element carries on, so the answer is the list of them.
export fn check_flat_map(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let seat? = walk_seat(cx, mc, "flat_map") else { return cx.error_type }
    let inner: TypeId? = match cx.view.types.seen_shape(seat.answer) { .List(i) -> i, _ -> null }
    if inner == null { return flat_map_needs_list(cx, mc.e, seat.answer) }
    let held = inner!
    if !slot_worthy(cx.view.types.shape_of(held)) { return uncollectable(cx, mc.e, held) }
    cx.facts.mark_stage(mc.e, .FlatMap)
    cx.type(List<held>)
}

fn flat_map_needs_list(mut cx: TypeCx, e: ExprId, answer: TypeId) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.list_element",
                cx.loc_of(e),
                "`flat_map`'s fn answers a list, and this one answers `${cx.view.types.name_of(answer)}`",
                "flat_map here",
                "answer `List<T>` — each inner element carries on",
            ),
        )
}

/// `xs.flatten()` — a list of lists becomes their elements, walked in
/// one inner loop.
export fn check_flatten(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let outer: TypeId? = elem_held(cx, mc, "flatten")
    if outer == null { return cx.error_type }
    let held: TypeId? = cx.view.types.element(outer!)
    if held == null { return flatten_needs_list(cx, mc.e, outer!) }
    let inner = held!
    if !cx.seated(mc, "flatten", []) { return cx.error_type }
    if !slot_worthy(cx.view.types.shape_of(inner)) { return uncollectable(cx, mc.e, inner) }
    cx.facts.mark_stage(mc.e, .Flatten)
    cx.type(List<inner>)
}

fn flatten_needs_list(mut cx: TypeCx, e: ExprId, outer: TypeId) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.list_element",
                cx.loc_of(e),
                "`flatten` needs a list of lists, and this holds `${cx.view.types.name_of(outer)}`",
                "flatten here",
                "map to a list first, or use `flat_map`",
            ),
        )
}

/// `xs.filter(p)` — the receiver's own type.
export fn check_filter(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let seat: WalkSeat? = predicate_seat(cx, mc, "filter")
    if seat == null { return cx.error_type }
    cx.facts.mark_stage(mc.e, .Keep)
    cx.type_at(mc.subject)
}

/// `xs.take(n)` / `xs.drop(n)` — the receiver's own type; the bound
/// is an int, read once before the walk.
export fn check_take(mut cx: TypeCx, mc: MethodCall) -> TypeId { limited(cx, mc, "take", .Take) }
export fn check_drop(mut cx: TypeCx, mc: MethodCall) -> TypeId { limited(cx, mc, "drop", .Drop) }

fn limited(mut cx: TypeCx, mc: MethodCall, name: string, stage: PipeStage) -> TypeId {
    if elem_held(cx, mc, name) == null || !cx.seated(mc, name, [int_type(cx)]) { return cx.error_type }
    cx.facts.mark_stage(mc.e, stage)
    cx.type_at(mc.subject)
}

/// `xs.take_while(p)` / `xs.drop_while(p)` — the receiver's own type;
/// the predicate is judged by `filter`'s own seat law.
export fn check_take_while(mut cx: TypeCx, mc: MethodCall) -> TypeId { while_seat(cx, mc, "take_while", .TakeWhile) }
export fn check_drop_while(mut cx: TypeCx, mc: MethodCall) -> TypeId { while_seat(cx, mc, "drop_while", .DropWhile) }

fn while_seat(mut cx: TypeCx, mc: MethodCall, name: string, stage: PipeStage) -> TypeId {
    let seat: WalkSeat? = predicate_seat(cx, mc, name)
    if seat == null { return cx.error_type }
    cx.facts.mark_stage(mc.e, stage)
    cx.type_at(mc.subject)
}

/// `xs.find(p)` — the element, nullable.
export fn check_find(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let seat? = predicate_seat(cx, mc, "find") else { return cx.error_type }
    cx.view.types.intern(Type.Opt(seat.elem))
}

/// `xs.find_last(p)` — the LAST element `p` blesses, or absence.
export fn check_find_last(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let seat? = predicate_seat(cx, mc, "find_last") else { return cx.error_type }
    cx.view.types.intern(Type.Opt(seat.elem))
}

/// `xs.find_map(f)` — the value of the first element `f` answers
/// PRESENT, or absence: `find`'s question through `map`'s projection.
/// The fn's answer must itself be nullable, and that same nullable is
/// the row's.
export fn check_find_map(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let seat? = walk_seat(cx, mc, "find_map") else { return cx.error_type }
    if cx.view.types.carried(seat.answer) == null { return unprojected(cx, mc.e, seat.answer) }
    seat.answer
}

/// `xs.find_index(p)` — where the first element `p` blesses stands, or
/// absence: `find`'s question, answered with the place.
export fn check_find_index(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let _seat? = predicate_seat(cx, mc, "find_index") else { return cx.error_type }
    cx.type(int?)
}

/// `xs.any(p)` / `xs.all(p)` — a verdict.
export fn check_any(mut cx: TypeCx, mc: MethodCall) -> TypeId { judged_type(cx, mc, "any") }
export fn check_all(mut cx: TypeCx, mc: MethodCall) -> TypeId { judged_type(cx, mc, "all") }

fn judged_type(mut cx: TypeCx, mc: MethodCall, name: string) -> TypeId {
    let seat: WalkSeat? = predicate_seat(cx, mc, name)
    if seat == null { return cx.error_type }
    cx.type(bool)
}

/// THE GROWTH WORD: `xs.push(v)` mutates a PLACE — the receiver is
/// rooted in a mut binding, the argument is accepted by the
/// element, and the answer is nothing. The empty literal has no
/// element to accept and answers the absorbing type.
export fn check_push(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let elem: TypeId? = elem_held(cx, mc, "push")
    if elem == null || !opened_place(cx, mc, "push") || !cx.seated(mc, "push", [elem!]) { return cx.error_type }
    cx.type(void)
}

/// `xs.pop()` — the last element, removed; the list is a mut place.
export fn check_pop(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let elem: TypeId? = elem_held(cx, mc, "pop")
    if elem == null || !opened_place(cx, mc, "pop") || !cx.seated(mc, "pop", []) { return cx.error_type }
    elem!
}

/// `xs.set(i, v)` — one slot rewritten; the list is a mut place.
export fn check_set(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let elem: TypeId? = elem_held(cx, mc, "set")
    if elem == null || !opened_place(cx, mc, "set") || !cx.seated(mc, "set", [int_type(cx), elem!]) { return cx.error_type }
    if cx.drops_task(cx.loc_of(mc.e), elem!) { return cx.error_type }
    cx.type(void)
}

/// `xs.contains(v)` — whether some element is `v`.
export fn check_contains(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let elem: TypeId? = scanned(cx, mc, "contains")
    if elem == null || !cx.seated(mc, "contains", [elem!]) { return cx.error_type }
    cx.type(bool)
}

/// `xs.index_of(v)` — the first position of `v`, or -1.
export fn check_index_of(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let elem: TypeId? = scanned(cx, mc, "index_of")
    if elem == null || !cx.seated(mc, "index_of", [elem!]) { return cx.error_type }
    int_type(cx)
}

/// `xs.count()` — how many elements reach it, no list minted.
export fn check_count(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    if elem_held(cx, mc, "count") == null || !cx.seated(mc, "count", []) { return cx.error_type }
    cx.type(int)
}

/// `xs.sum()` — the int elements added; a non-int element is refused
/// in `sum`'s own words.
export fn check_sum(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let elem: TypeId? = elem_held(cx, mc, "sum")
    if elem == null || !cx.seated(mc, "sum", []) { return cx.error_type }
    if !(cx.view.types.seen_shape(elem!) is .Int) { return ints_only(cx, mc.e, elem!, "sum") }
    cx.type(int)
}

/// `xs.min()` / `xs.max()` — the extreme of the int elements, absent
/// when nothing arrived.
export fn check_min(mut cx: TypeCx, mc: MethodCall) -> TypeId { extremes(cx, mc, "min") }
export fn check_max(mut cx: TypeCx, mc: MethodCall) -> TypeId { extremes(cx, mc, "max") }

fn extremes(mut cx: TypeCx, mc: MethodCall, name: string) -> TypeId {
    let elem: TypeId? = elem_held(cx, mc, name)
    if elem == null || !cx.seated(mc, name, []) { return cx.error_type }
    if !(cx.view.types.seen_shape(elem!) is .Int) { return ints_only(cx, mc.e, elem!, name) }
    cx.type(int?)
}

/// `xs.min_by(k)` / `xs.max_by(k)` — the element whose int key is the
/// extreme, absent when nothing arrived.
export fn check_min_by(mut cx: TypeCx, mc: MethodCall) -> TypeId { keyed_extreme(cx, mc, "min_by") }
export fn check_max_by(mut cx: TypeCx, mc: MethodCall) -> TypeId { keyed_extreme(cx, mc, "max_by") }

fn keyed_extreme(mut cx: TypeCx, mc: MethodCall, name: string) -> TypeId {
    let seat? = walk_seat(cx, mc, name) else { return cx.error_type }
    if !(cx.view.types.seen_shape(seat.elem) is .Int) { return ints_only(cx, mc.e, seat.elem, name) }
    if !(cx.view.types.seen_shape(seat.answer) is .Int) { return ints_only(cx, mc.e, seat.answer, name) }
    cx.type(int?)
}

/// A verb that adds or ranks numbers, refused on a list of something
/// else in its own words.
fn ints_only(mut cx: TypeCx, e: ExprId, elem: TypeId, name: string) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.list_element",
                cx.loc_of(e),
                "`${name}` needs numbers, and this list holds `${cx.view.types.name_of(elem)}`",
                "${name} here",
                "map to `int` first",
            ),
        )
}

/// A scan's element: held, and tested by value — the `==` law.
fn scanned(mut cx: TypeCx, mc: MethodCall, name: string) -> TypeId? {
    let elem: TypeId? = elem_held(cx, mc, name)
    if elem == null { return null }
    if cx.compares_by_value(elem!) { return elem }
    let _ = scans_by_value(cx, mc.e, name, elem!)
    null
}

/// `xs.is_empty()` — measured, like `length`.
export fn check_is_empty(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    if cx.seen_at(mc.subject) is .EmptyList { return cx.unmeasurable_empty(mc.e, "[]", "List<int>") }
    if !cx.seated(mc, "is_empty", []) { return cx.error_type }
    cx.type(bool)
}

/// `xs.first()` / `xs.last()` — the edge element, nullable.
export fn check_first(mut cx: TypeCx, mc: MethodCall) -> TypeId { edge_type(cx, mc, "first") }
export fn check_last(mut cx: TypeCx, mc: MethodCall) -> TypeId { edge_type(cx, mc, "last") }

fn edge_type(mut cx: TypeCx, mc: MethodCall, name: string) -> TypeId {
    let elem: TypeId? = elem_held(cx, mc, name)
    if elem == null || !cx.seated(mc, name, []) { return cx.error_type }
    cx.view.types.intern(Type.Opt(elem!))
}

/// `xs.concat(ys)` — a fresh list of both, the same type.
export fn check_concat(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    if elem_held(cx, mc, "concat") == null || !cx.seated(mc, "concat", [cx.type_at(mc.subject)]) { return cx.error_type }
    cx.type_at(mc.subject)
}

/// `xs.slice(lo, hi)` — a fresh list of a range, the same type.
export fn check_slice(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    if elem_held(cx, mc, "slice") == null || !cx.seated(mc, "slice", [int_type(cx), int_type(cx)]) { return cx.error_type }
    cx.type_at(mc.subject)
}

/// `xs.enumerate()` — the list itself, under a paired `for` head
/// that reads the index beside the element; anywhere else it would
/// promise pairs the language has no values for, so it refuses.
export fn check_enumerate(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    if elem_held(cx, mc, "enumerate") == null || !cx.seated(mc, "enumerate", []) { return cx.error_type }
    if !cx.paired(mc.e) { return unpaired_enumerate(cx, mc.e) }
    cx.type_at(mc.subject)
}

/// `xs.join(sep)` — text from a list of text.
export fn check_join(mut cx: TypeCx, mc: MethodCall) -> TypeId {
    let elem? = elem_held(cx, mc, "join") else { return cx.error_type }
    if !(cx.view.types.shape_of(elem) is .Str) { return joins_text(cx, mc.e, elem) }
    if !cx.seated(mc, "join", [cx.type(string)]) { return cx.error_type }
    cx.type(string)
}

/// THE PRELUDE the plain rows share: the element the receiver
/// holds. The empty literal refuses in the row's words and absorbs.
fn elem_held(mut cx: TypeCx, mc: MethodCall, name: string) -> TypeId? {
    let elem: TypeId? = match cx.view.types.seen_shape(cx.type_at(mc.subject)) {
        .Range -> cx.type(int),
        _ -> cx.view.types.element(cx.type_at(mc.subject)),
    }
    if elem == null && cx.seen_at(mc.subject) is .EmptyList { let _ = unknowable_walk(cx, mc.e, name) }
    elem
}

/// The mutation prelude: the receiver is a mut place — or a `state`
/// field, whose cell owns what it holds and writes with no `mut` root.
fn opened_place(mut cx: TypeCx, mc: MethodCall, name: string) -> bool {
    if cx.state_field_slot(mc.subject) != null { return true }
    let root? = cx.view.store.place_root(mc.subject) else {
        let _ = cx.not_a_place_call(mc.e, name)
        return false
    }
    if cx.is_mut(root) {
        cx.alias_copy_law(mc.e, mc.subject, root)
        return true
    }
    let _ = cx.not_mut_call(mc.e, name, cx.view.store.ident_name(root) ?? "this name")
    false
}

fn int_type(cx: TypeCx) -> TypeId {
    cx.type(int)
}

// ── The walk prelude ──

/// What a walk's fn was seated with: the element it takes and the
/// answer it gives.
type WalkSeat = { elem: TypeId, answer: TypeId }

/// THE PRELUDE every walk shares: the receiver's element (the empty
/// literal refuses in the walk's words), then the one fn argument
/// judged against it — absent when either refused, or when the fn's
/// own body already spoke.
fn walk_seat(mut cx: TypeCx, mc: MethodCall, name: string) -> WalkSeat? {
    let elem: TypeId? = elem_held(cx, mc, name)
    if elem == null { return null }
    let held? = walk_arg(cx, mc.e, name, elem!, mc.args) else { return null }
    // a body that erred already spoke — its answer absorbs here
    if cx.errored_ty(held.answer) { return null }
    let seat = WalkSeat { elem: elem!, answer: held.answer }
    seat
}

/// A predicate walk's prelude: the shared one, and the fn must
/// answer `bool`.
fn predicate_seat(mut cx: TypeCx, mc: MethodCall, name: string) -> WalkSeat? {
    let seat: WalkSeat? = walk_seat(cx, mc, name)
    if seat == null { return null }
    if cx.view.types.shape_of(seat!.answer) is .Bool { return seat }
    let _ = unpredicated(cx, mc.e, name, seat!.answer)
    null
}

/// A walk takes exactly ONE fn, whose single seat IS the element.
fn walk_arg(mut cx: TypeCx, e: ExprId, name: string, elem: TypeId, args: List<ExprId>) -> Arrow? {
    if args.length != 1 {
        let _ = one_fn_wanted(cx, e, name, args.length)
        return null
    }
    let rescued: TypeId? = cx.retype_seated(args[0], [elem], no_marks(1))
    let fnty: TypeId = rescued ?? cx.type_at(args[0])
    if cx.errored_ty(fnty) {
        // a lambda with the wrong seat count could never be fed —
        // the walk says so; any other error already spoke
        let parts: LambdaParts? = cx.view.store.lambda_parts(args[0])
        if parts != null && parts!.params.length != 1 {
            let _ = misseated_walk(cx, name, args[0], parts!.params.length)
        }
        return null
    }
    let held: Arrow? = cx.view.types.arrow_parts(fnty)
    if held == null {
        let _ = fnless_walk(cx, name, args[0])
        return null
    }
    let arrow = held!
    // LICENSED structs.index_compared: type identity — the seat IS the element, exactly
    if arrow.seats.length != 1 || arrow.seats[0].index != elem.index {
        let _ = seat_not_element(cx, e, name, elem, fnty)
        return null
    }
    held
}

// ── The constructor and property rows' rules ──

export fn list_shape(args: TypeArgs) -> Type {
    Type.List(args.parts[0])
}

/// `xs.length` — an int; the empty literal has no length until a
/// declared type adopts it.
export fn check_length(mut cx: TypeCx, e: ExprId, ty: TypeId) -> TypeId {
    if cx.view.types.shape_of(ty) is .EmptyList { return cx.unmeasurable_empty(e, "[]", "List<int>") }
    cx.type(int)
}

// ── The voices ──

fn unpaired_enumerate(mut cx: TypeCx, e: ExprId) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.list_element",
                cx.loc_of(e),
                "`enumerate` pairs only under a paired `for` head — pairs as values arrive with tuples",
                "enumerated here",
                "pair at the head — `for i, x in xs { … }`, or `[… for i, x in xs]`",
            ),
        )
}

fn scans_by_value(mut cx: TypeCx, e: ExprId, name: string, elem: TypeId) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.list_element",
                cx.loc_of(e),
                "`${name}` scans by value — a scalar, text, a tagged enum, or a record of one such field — and this list holds `${cx.view.types.name_of(elem)}`",
                "scanned here",
                "spell the scan — `xs.any(same(it))` with the fields you mean",
            ),
        )
}

fn joins_text(mut cx: TypeCx, e: ExprId, elem: TypeId) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.list_element",
                cx.loc_of(e),
                "`join` reads a list of text, this one holds `${cx.view.types.name_of(elem)}`",
                "joined here",
                "map the elements to strings first",
            ),
        )
}

/// A walk on `[]` cannot know its elements.
fn unknowable_walk(mut cx: TypeCx, e: ExprId, name: string) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.list_element",
                cx.loc_of(e),
                "`[].${name}` cannot know its elements",
                "walked here",
                "bind the list under a typed let first — `let xs: List<int> = []`",
            ),
        )
}

fn misseated_walk(mut cx: TypeCx, name: string, a: ExprId, seats: int) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.mismatch",
                cx.loc_of(a),
                "`${name}` seats one param — the element — and this lambda takes ${seats}",
                "this lambda",
                null,
            ),
        )
}

fn uncollectable(mut cx: TypeCx, e: ExprId, answer: TypeId) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.list_scalar",
                cx.loc_of(e),
                "`map` collects what its fn answers, and `${cx.view.types.name_of(answer)}` is no value",
                "this walk",
                "answer a value from the fn, or walk with `for`",
            ),
        )
}

fn fnless_walk(mut cx: TypeCx, name: string, a: ExprId) -> TypeId {
    let n = cx.name_at(a)
    cx
        .spoken(
            refusal(
                "type.mismatch",
                cx.loc_of(a),
                "`${name}` wants a fn taking the element, found `${n}`",
                this_is(n),
                null,
            ),
        )
}

fn seat_not_element(mut cx: TypeCx, e: ExprId, name: string, elem: TypeId, fnty: TypeId) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.mismatch",
                cx.loc_of(e),
                "`${name}`'s fn takes the element `${cx.view.types.name_of(elem)}` — this one is `${cx.view.types.name_of(fnty)}`",
                "this call",
                null,
            ),
        )
}

/// `find_map`'s fn must answer a nullable — there is no absence to
/// answer otherwise.
fn unprojected(mut cx: TypeCx, e: ExprId, got: TypeId) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.mismatch",
                cx.loc_of(e),
                "`find_map` seeks the value its fn answers, nullable — this answers `${cx.view.types.name_of(got)}`",
                "this call",
                "answer `null` when there is nothing to seek",
            ),
        )
}

/// A predicate walk's fn must answer bool.
fn unpredicated(mut cx: TypeCx, e: ExprId, name: string, got: TypeId) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.mismatch",
                cx.loc_of(e),
                "`${name}`'s fn must answer `bool`, this one answers `${cx.view.types.name_of(got)}`",
                "this call",
                null,
            ),
        )
}

fn one_fn_wanted(mut cx: TypeCx, e: ExprId, name: string, found: int) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.mismatch",
                cx.loc_of(e),
                "`${name}` takes one fn, found ${found} arguments",
                "this call",
                null,
            ),
        )
}
