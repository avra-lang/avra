//! The blockless `collect` refusal's words.
use features.{RefusalWords}

// ── voices ──

/// `collect` with no block: the gathering needs statements to run.
fn blockless_collect() -> RefusalWords {
    RefusalWords {
        message: "`collect` gathers the values its block's statements leave",
        help: "give it its block — `collect { … }`",
    }
}
