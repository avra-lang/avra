//! Parse-time lowering: captures -> the list node. An absent first
//! element is the empty literal — typing owns its refusal.
use core.{Expr, Scoped}
use features.{token_at, expr_id_at, scoped_at, LangNode, Builder}
use grammar.{Token}
fn build_list(mut b: Builder) -> Result<LangNode, string> {
    let first? = expr_id_at(b.args, 0) else { return b.make_expr(Expr.ListLit([])) }
    b.make_expr(Expr.ListLit([first].concat(b.exprs(1)?)))
}

/// `[v for ix, en in src if c]` — the head is the `for` statement's:
/// the index name is absent when the binder is a bare name, `hi` is
/// present when the source is a range `lo..hi`, and the filter is
/// absent when unwritten.
fn build_comp(mut b: Builder) -> Result<LangNode, string> {
    let v = b.expr(0)?
    let ix: Token? = token_at(b.args, 1)
    let en = b.token(2)?
    let src = b.expr(3)?
    b.make_expr(Expr.Comp(v, scoped_at(ix), Scoped(en.text), src, expr_id_at(b.args, 4), expr_id_at(b.args, 5)))
}
