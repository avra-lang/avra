//! The lowering rule of a list literal: one box sized for every plain element and every spread's
//! length, then each plain element pushed and each spread's slots appended, in written order. A list
//! every element of which is written as a literal is laid out as static data, which isn't lowered yet.
use core.{BinOp, ExprId, Layout, Lowering, Lowers, Reg, rt_sig_of}
use core.expr.{ListLit}

impl Lowers for ListLit {
    /// The elements first, then the size, then the box, then what fills it; an element wider than a
    /// word isn't lowered yet.
    fn lowered(mut cx: Lowering, e: ExprId) -> Reg {
        if !self.elems.is_empty() && cx.held_as_data(e) { return cx.missed_as("a literal the binary holds as data") }
        let spread = [cx.store.spread_operand(k) != null for k in self.elems]
        let regs = [cx.lower(cx.store.spread_operand(k) ?? k) for k in self.elems]
        mut size = cx.const_int([s for s in spread if !s].length)
        for at, r in regs {
            if spread[at] {
                size = cx
                    .bin(
                        Layout.Word,
                        BinOp.Add,
                        size,
                        cx.call_row(Layout.Word, rt_sig_of("avra_array_len")!, [r]),
                    )
            }
        }
        let dst = cx.call_row(cx.layout_at(e), rt_sig_of("avra_array_sized")!, [size])
        for at, r in regs {
            cx
                .run_words(
                    rt_sig_of(if spread[at] { "avra_array_extend" } else { "avra_array_push" })!,
                    [dst, r],
                )
        }
        dst
    }
}
