// proves: `set`, `pop`, `index_of` and `find_index` on a list, a comprehension over a method's answer read
// through `self`, and a walk over a walk, run as one: each element through the stages before it, a place
// counted among the elements that pass them.
type Bag = { xs: List<int> }

impl Bag {
    fn doubled() -> List<int> { [x * 2 for x in self.xs] }

    fn tripled() -> List<int> { [x * 3 for x in self.doubled()] }
}

mut xs = [5, 8, 13, 21]
xs.set(1, 9)
let last = xs.pop()
mut names = ["a", "b"]
names.set(0, "z")
let popped = names.pop()
let bag = Bag { xs: xs }
let evens = [1, 2, 3, 4, 5, 6].filter(it % 2 == 0).map(it * 10)
let big = [1, 2, 3].map(it * 5).any(it > 12)
let parts = ["a", "b", "c"]
let at_b = parts.find_index(it == "b") ?? -1
let at_q = parts.find_index(it == "q") ?? -1
let staged_sum = [1, 2, 3, 4, 5].filter(it > 1).take(2).sum()
let staged_at = [1, 2, 3, 4].drop(1).filter(it % 2 == 0).index_of(4)
let mapped_at = [5, 6, 7].map(it * 2).find_index(it == 14) ?? -1
let joined = parts.drop(1).fold(parts[0], (at: string, p: string) -> at + "-" + p)
"${xs[0]} ${xs[1]} ${xs[2]} ${xs.length} ${last} ${names[0]} ${popped} ${xs.index_of(9)} ${xs.index_of(7)} ${names.index_of("z")} ${bag.tripled().length} ${bag.tripled()[2]} ${evens.length} ${evens[2]} ${big} ${joined} ${at_b} ${at_q} ${staged_sum} ${staged_at} ${mapped_at}"
