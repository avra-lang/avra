// `fold` and `get` under attack: the seed that names no type, the fn
// that is not the accumulator's, the seat counts, and the index that
// stands outside the list.
use @std.avrac.testing.{shown, refused_with}

spec "features/lists/fold — the seats under attack" {
    given "the seed" {
        then "an empty literal with no declared answer names no type" {
            refused_with(
                "[1].fold([], (acc, x) -> acc)",
                "`fold`'s seed names what it accumulates, and `[]` names no type",
            )
        }
        then "a null with no declared answer names no type" {
            refused_with(
                "[1].fold(null, (acc, x) -> acc)",
                "`fold`'s seed names what it accumulates, and `null` names no type",
            )
        }
        then "an empty literal takes the fold's declared answer" {
            shown("let ys: List<int> = [1, 2].fold([], (acc, x) -> [x].concat(acc))\nys[0]") == "2"
        }
        then "a null takes the fold's declared answer, and the fn's present answer widens" {
            shown("let last: int? = [1, 2].fold(null, (acc, x) -> x)\nlast ?? 0") == "2"
        }
        then "a present seed under a nullable want stays its own type" {
            shown("let n: int? = [1, 2].fold(0, (acc, x) -> acc + x)\nn ?? -1") == "3"
        }
    }
    given "the fn" {
        then "an answer that is not the accumulator refuses" {
            refused_with(
                "[1].fold(0, (acc, x) -> \"s\")",
                "`fn(int, int) -> int` — and this is `fn(int, int) -> string`",
            )
        }
        then "a one-seat lambda refuses in the verb's words" {
            refused_with(
                "[1].fold(0, (x) -> x)",
                "`fold` seats two params — the accumulator, then the element — and this lambda takes 1",
            )
        }
        then "a non-fn refuses" {
            refused_with("[1].fold(0, 5)", "and this is `int`")
        }
        then "a named fn whose seats are swapped refuses" {
            refused_with(
                "fn f(x: string, acc: int) -> int { acc }\n[\"a\"].fold(0, f)",
                "`fn(int, string) -> int` — and this is `fn(string, int) -> int`",
            )
        }
    }
    given "the arguments" {
        then "a seed alone" {
            refused_with("[1].fold(0)", "`fold` takes a seed and a fn, found 1 arguments")
        }
        then "an empty receiver cannot know its element" {
            refused_with("[].fold(0, (acc, x) -> acc)", "`[].fold` cannot know its elements")
        }
    }
    given "the walk" {
        then "an empty list answers the seed" {
            shown("let none: List<int> = []\nnone.fold(7, (acc, x) -> acc + x)") == "7"
        }
        then "the order is the list's" {
            shown("[\"a\", \"b\", \"c\"].fold(\"\", (acc, w) -> acc + w)") == "abc"
        }
        then "a large fold runs in place" {
            shown("[i for i in 0..200000].fold(0, (acc, i) -> acc + i)") == "19999900000"
        }
    }
}

spec "features/lists/get — the index under attack" {
    given "an index" {
        then "inside the list answers the element" {
            shown("[4, 5].get(1) ?? -1") == "5"
        }
        then "at the length answers absence" {
            shown("[4, 5].get(2) ?? -1") == "-1"
        }
        then "below zero answers absence" {
            shown("[4, 5].get(-1) ?? -1") == "-1"
        }
        then "a non-int refuses at the seat" {
            refused_with("[1].get(\"a\")", "argument 1 of `get` wants `int`, found `string`")
        }
        then "no index refuses" {
            refused_with("[1].get()", "`get`")
        }
    }
    given "the receiver" {
        then "an empty literal cannot know its element" {
            refused_with("[].get(0)", "`[].get` cannot know its elements")
        }
        then "a named list reads through its name" {
            shown("type Rows = List<int>\nlet rows: Rows = [7, 8]\nrows.get(1) ?? 0") == "8"
        }
    }
}
