// proves: take and drop are clauses in one loop — count the elements
// that reach them, not the source index
let xs = [1, 2, 3, 4, 5, 6]
let evens = xs.filter((x: int) -> x % 2 == 0)
println("A ${evens.take(2).sum()} ${evens.drop(1).sum()}")
println("B ${xs.filter((x: int) -> x % 2 == 0).take(2).count()}")
println("C ${xs.take(3).sum()} ${xs.drop(4).sum()} ${xs.take(0).count()} ${xs.drop(0).count()}")
