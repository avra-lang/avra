// proves: take, drop, take_while, drop_while and filter_map are clauses
// in one loop
let xs = [1, 2, 3, 4, 5, 6]
let evens = xs.filter((x: int) -> x % 2 == 0)
println("A ${evens.take(2).sum()} ${evens.drop(1).sum()}")
println("B ${xs.filter((x: int) -> x % 2 == 0).take(2).count()}")
println("C ${xs.take(3).sum()} ${xs.drop(4).sum()} ${xs.take(0).count()} ${xs.drop(0).count()}")
println("D ${xs.take_while((x: int) -> x < 4).count()} ${xs.drop_while((x: int) -> x < 3).sum()}")
println("E ${xs.map((x: int) -> x * 2).take_while((x: int) -> x < 7).count()}")
println("F ${xs.filter_map((x: int) -> if x % 2 == 0 { x * 10 } else { null }).sum()}")
println("G ${xs.filter_map((x: int) -> if x % 2 == 0 { x * 10 } else { null }).take(2).sum()}")
