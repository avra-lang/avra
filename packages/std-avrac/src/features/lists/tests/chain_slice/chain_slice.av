// proves: take and drop are clauses in one loop — no intermediate list
let xs = [1, 2, 3, 4, 5, 6]
let head = xs.take(3).sum()
let tail = xs.drop(4).sum()
let mixed = xs.filter((x: int) -> x % 2 == 0).take(2).sum()
let all = xs.take(99).count()
let none = xs.take(0).count()
let rest = xs.drop(0).count()
let gone = xs.drop(99).count()
println("${head} ${tail} ${mixed} ${all} ${none} ${rest} ${gone}")
