// proves: a scan READS, so a list of a NAMED type scans by the shape
// the name stands over — text, a number, a float, a unit enum, a
// one-field record, a name over a name, a nullable of a name — while
// the needle's SEAT still wants the name. A NUL in the text is a
// character like any other. And a literal of nothing but `null`
// takes the element its seat names: an argument, a field, an answer.
use @std.text.{from_codepoint}

type NodeId = string
type Deep = NodeId
type Names = List<string>
type P = { x: int }
type Pid = P

enum Kind {
    A
    B
}

type K = Kind
type Ratio = float
type Holder = { xs: List<int?>, m: Map<string, int?> }

fn count(xs: List<string?>) -> int { xs.length }

fn nested(xs: List<List<int?>>) -> int { xs[1].length }

fn back() -> List<int?> { [null, null] }

fn sized(m: Map<string, int?>) -> int { m.length }

fn paired<T>(_x: T, xs: List<T?>) -> int { xs.length }

let nul = "ab" + from_codepoint(0) + "cd"
let a: NodeId = "a"
let ids: List<NodeId> = [a, NodeId(nul), "lit"]
let deep: List<Deep> = [Deep(a)]
let names: Names = ["x", "y"]
let pids: List<Pid> = [Pid(P { x: 1 }), Pid(P { x: 2 })]
let ks: List<K> = [K(Kind.A), K(Kind.B)]
let rs: List<Ratio> = [1.5, 2.5]
let opt: List<NodeId?> = [null, a]
let none: NodeId? = null
let h = Holder { xs: [null, null], m: {"k": null} }
let text = "${ids.contains("lit")} ${ids.index_of(NodeId(nul))} ${ids.contains("ab")} ${deep.contains(Deep(a))} ${names.index_of("y")}"
let shapes = "${pids.index_of(Pid(P { x: 2 }))} ${ks.index_of(K(Kind.B))} ${K(Kind.A) == K(Kind.B)} ${rs.contains(2.5)} ${opt.index_of(a)} ${opt.index_of(none)}"
"${text} | ${shapes} | ${count([null, null, null])} ${nested([[null], [null, null]])} ${back().length} ${h.xs.length} ${h.m.length} ${sized({"a": null})} ${paired(1, [null])}"
