// proves: `xs.fold(seed, f)` carries the seed through every element —
// a lambda, a trailing block, a named fn and a capturing lambda are one
// seat; a chain and a range fold without an intermediate list; an
// empty list answers the seed; a seed with no type of its own (`[]`,
// `null`) takes the fold's declared answer.
type Said = { n: int, t: string }

fn heard(s: Said, a: string) -> Said { Said { n: s.n + 1, t: s.t + a } }

fn doubled(xs: List<int>) -> List<int> { xs.fold([], (acc, x) -> acc.concat([x * 2])) }

fn largest(xs: List<int>) -> int? { xs.fold(null, (acc, x) -> if acc ?? x > x { acc } else { x }) }

fn scaled(xs: List<int>, by: int) -> int { xs.fold(0, (acc, x) -> acc + x * by) }

let xs = [3, 9, 4]
let ws = ["a", "b", "c"]
let none: List<int> = []
let s = ws.fold(Said { n: 0, t: "" }, heard)
let joined = ws.fold("", (acc, w) -> acc + w + ".")
let chained = xs.filter(it > 3).fold(10) { acc, x -> acc * x }
let counted = (0..5).fold(0, (acc, i) -> acc + i)
let ds = doubled(xs)
"${xs.fold(0, (acc, x) -> acc + x)} ${s.n}${s.t} ${joined} ${chained} ${counted} ${none.fold(7, (acc, x) -> acc + x)} | ${ds.length} ${ds[2]} ${largest(xs) ?? -1} ${largest(none) ?? -1} ${scaled(xs, 10)}"
