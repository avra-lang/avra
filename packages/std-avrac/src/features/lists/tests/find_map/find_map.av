// proves: `find_map` answers the first PRESENT projection and the
// walk stops there — a later element whose projection would trap is
// never read. This is the short-circuit `map(...).first()` cannot
// spell: `map` builds every projection before `first` chooses.
enum Attribute {
    Level(int)
    Text(string)
    Label(string)
}

fn level_of(attrs: List<Attribute>) -> int {
    attrs.find_map(match it { .Level(r) -> r, rest -> null }) ?? 1
}

fn doubled(attrs: List<Attribute>) -> int? {
    attrs.find_map() { match it { .Level(r) -> 100 / r, rest -> null } }
}

let some = [Attribute.Text("a"), Attribute.Level(3), Attribute.Label("b")]
let none = [Attribute.Text("a"), Attribute.Label("b")]
let trap = [Attribute.Level(2), Attribute.Level(0)]
"${level_of(some)} ${level_of(none)} ${doubled(trap) ?? 0}"
