// proves: a list's element read by its place, absent past either end; a
// map's value taken out under its key, the rest kept in written order; a
// range's integers walked by `any`, `all`, `find` and `fold`; a name over
// text compared with a literal; nullables found by `contains` and
// `index_of`, an absence among them too; a chain into a list's length and
// into a name's own field.
type Tag = string

fn tag_is(t: Tag) -> bool { t == "it" }

let xs = [10, 20, 30]
let first = xs.get(0) ?? -1
let past = xs.get(3) ?? -1
let before = xs.get(0 - 1) ?? -1
mut m = {"a": 1, "b": 2, "c": 3}
let took = m.remove("b") ?? 0
let none = m.remove("z") ?? 0
let some = (0..4).any(it == 2)
let every = (1..5).all(it > 0)
let found = (1..5).find(it * it > 5) ?? 0
let total = (0..5).fold(0, (a, i) -> a + i)
let ms: List<int?> = [1, null, 3]
let held: List<int>? = xs
let gone: List<int>? = null
let named: Tag? = Tag("q")
"${first} ${past} ${before} ${took} ${none} ${m.keys().join(",")} ${some} ${every} ${found} ${total} ${tag_is(Tag("it"))} ${tag_is(Tag("no"))} ${ms.contains(3)} ${ms.contains(null)} ${ms.contains(2)} ${ms.index_of(null)} ${held?.length ?? 0} ${gone?.length ?? -1} ${named?.of ?? ""}"
