// `collect` gathers what its statements leave: through loops, branches,
// a `while` and a `match`; never through a lambda; managed values too.
type Row = { id: int, name: string }
fn rows(n: int) -> List<Row> {
    collect {
        for i in 0..n {
            if i % 2 == 0 { Row { id: i, name: "r${i}" } }
        }
        Row { id: 99, name: "tail" }
    }
}
fn nested() -> List<int> {
    collect {
        let inner = collect {
            1
            2
        }
        inner.length
        let f = (x: int) -> {
            x + 1
            x + 2
        }
        f(10)
        mut k = 0
        while k < 2 {
            k = k + 1
            k * 100
        }
        match k { 2 -> 7, _ -> 8 }
    }
}
let empty: List<string> = collect {}
let words = collect {
    for w in ["a", "b"] { "${w}!" }
}
let rs = rows(5)
"${[r.name for r in rs].join(",")} ${["${n}" for n in nested()].join(",")} ${empty.length} ${words.join("")}"
