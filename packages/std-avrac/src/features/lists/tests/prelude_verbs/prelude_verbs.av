// proves: the list and map verbs the prelude writes as bodies answer as the
// language says — prefixes by a test, a keyed minimum and maximum (the
// first on a tie, none of nothing), a mapped filter, an insertion, and a map's entries walked.
let xs = [3, 1, 4, 1, 5, 9, 2, 6]

let kept = xs.take_while(it < 5)
let left = xs.drop_while(it < 5)
let farthest = xs.min_by(0 - it) ?? -1
let nearest = xs.max_by(0 - it) ?? -1
let tied = xs.min_by(it % 2) ?? -1
let tied_high = xs.max_by(it % 2) ?? -1
let none: List<int> = []
let halves = xs.filter_map(if it % 2 == 0 { it / 2 } else { null })
let put = xs.inserted(2, 7)
let spread = xs.flat_map(if it > 4 { [it, it] } else { [] })

mut m: Map<string, int> = {}
m.set("a", 1)
m.set("b", 2)
m.set("c", 3)

let names = m.map(it.key + "${it.value}")
let big = m.any(it.value > 2)
let found = m.find_map(if it.value == 2 { it.key } else { null }) ?? "-"
let doubled = m.flat_map([it.value, it.value])

"${kept.length} ${left.length} ${farthest} ${nearest} ${tied} ${tied_high} ${none.min_by(it) ?? -1} ${halves.length} ${put[2]} ${put.length} ${spread.length} ${names.join(",")} ${big} ${found} ${doubled.length}"
