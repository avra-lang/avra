// proves: a named type is transparent at a read inside a fn — its shape's
// property, method and walk answer through the name.
type Rows = List<int>

fn summed(rows: Rows) -> int { rows.fold(0, (a, b) -> a + b) }

fn shown(rows: Rows) -> string {
    let doubled = rows.map(it * 2)
    "${rows.length} ${join_ints_of(doubled)} ${rows.first() ?? -1} ${summed(rows)}"
}

fn join_ints_of(xs: List<int>) -> string { xs.map("${it}").join(",") }

let r: Rows = [1, 2, 3]
shown(r)
