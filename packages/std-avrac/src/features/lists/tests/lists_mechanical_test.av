// GENERATED by `avra attack lists` — the mechanical
// classes from the feature's rule and the model. A SEMANTIC
// attack belongs in the feature's hand-written test.
use @std.avrac.language.{analyze_source}
use @std.avrac.diagnostics.{Diag}
use @std.avrac.testing.{refusals}

/// The SHAPE parses — a canonical sample spells `x` where a name
/// belongs, so a TYPE error is expected and a PARSE error is not.
fn parses(src: string) -> bool {
    !analyze_source(src).diagnostics.any(parse_error)
}

fn parse_error(d: Diag) -> bool {
    d.kind.starts_with("parse.")
}

spec "features/lists adversarial — mechanical" {
    given "degenerate shapes — a valid surface, and must stay valid" {
        then "[ \n x , \n ]" { parses("[ \n x , \n ]") }
        then "[ \n x , \n x , \n x , \n ]" { parses("[ \n x , \n x , \n x , \n ]") }
    }
    given "malformed surface — must be diagnosed" {
        then "x for ( x , x ) in x .. x if x ]" { refusals("x for ( x , x ) in x .. x if x ]") > 0 }
        then "[ for ( x , x ) in x .. x if x ]" { refusals("[ for ( x , x ) in x .. x if x ]") > 0 }
        then "[ x ( x , x ) in x .. x if x ]" { refusals("[ x ( x , x ) in x .. x if x ]") > 0 }
        then "[ x for x , x ) in x .. x if x ]" { refusals("[ x for x , x ) in x .. x if x ]") > 0 }
        then "[ x for ( , x ) in x .. x if x ]" { refusals("[ x for ( , x ) in x .. x if x ]") > 0 }
        then "[ x for ( x x ) in x .. x if x ]" { refusals("[ x for ( x x ) in x .. x if x ]") > 0 }
        then "[ x for ( x , ) in x .. x if x ]" { refusals("[ x for ( x , ) in x .. x if x ]") > 0 }
        then "[ x for ( x , x in x .. x if x ]" { refusals("[ x for ( x , x in x .. x if x ]") > 0 }
        then "[ x for ( x , x ) x .. x if x ]" { refusals("[ x for ( x , x ) x .. x if x ]") > 0 }
        then "[ x for ( x , x ) in .. x if x ]" { refusals("[ x for ( x , x ) in .. x if x ]") > 0 }
        then "[ x for ( x , x ) in x x if x ]" { refusals("[ x for ( x , x ) in x x if x ]") > 0 }
        then "[ x for ( x , x ) in x .. if x ]" { refusals("[ x for ( x , x ) in x .. if x ]") > 0 }
        then "[ x for ( x , x ) in x .. x x ]" { refusals("[ x for ( x , x ) in x .. x x ]") > 0 }
        then "[ x for ( x , x ) in x .. x if ]" { refusals("[ x for ( x , x ) in x .. x if ]") > 0 }
        then "[ x for ( x , x ) in x .. x if x" { refusals("[ x for ( x , x ) in x .. x if x") > 0 }
        then "[ [ x for ( x , x ) in x .. x if x ]" { refusals("[ [ x for ( x , x ) in x .. x if x ]") > 0 }
        then "[ x x for ( x , x ) in x .. x if x ]" { refusals("[ x x for ( x , x ) in x .. x if x ]") > 0 }
        then "[ x for for ( x , x ) in x .. x if x ]" { refusals("[ x for for ( x , x ) in x .. x if x ]") > 0 }
        then "[ x for ( ( x , x ) in x .. x if x ]" { refusals("[ x for ( ( x , x ) in x .. x if x ]") > 0 }
        then "[ x for ( x x , x ) in x .. x if x ]" { refusals("[ x for ( x x , x ) in x .. x if x ]") > 0 }
        then "[ x for ( x , , x ) in x .. x if x ]" { refusals("[ x for ( x , , x ) in x .. x if x ]") > 0 }
        then "[ x for ( x , x x ) in x .. x if x ]" { refusals("[ x for ( x , x x ) in x .. x if x ]") > 0 }
        then "[ x for ( x , x ) ) in x .. x if x ]" { refusals("[ x for ( x , x ) ) in x .. x if x ]") > 0 }
        then "[ x for ( x , x ) in in x .. x if x ]" { refusals("[ x for ( x , x ) in in x .. x if x ]") > 0 }
        then "[ x for ( x , x ) in x x .. x if x ]" { refusals("[ x for ( x , x ) in x x .. x if x ]") > 0 }
