        then "[ x for ( x , x ) in x .. x if x x ]" { refusals("[ x for ( x , x ) in x .. x if x x ]") > 0 }
        then "[ x for ( x , x ) in x .. x if x ] ]" { refusals("[ x for ( x , x ) in x .. x if x ] ]") > 0 }
        then "x [ for ( x , x ) in x .. x if x ]" { refusals("x [ for ( x , x ) in x .. x if x ]") > 0 }
        then "[ for x ( x , x ) in x .. x if x ]" { refusals("[ for x ( x , x ) in x .. x if x ]") > 0 }
