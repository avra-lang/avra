        then "\n [ x , \n x , \n ]" { tolerates("\n [ x , \n x , \n ]") }
        then "[ x \n , \n x , \n ]" { tolerates("[ x \n , \n x , \n ]") }
        then "[ \n , x \n x , \n ]" { tolerates("[ \n , x \n x , \n ]") }
        then "[ \n x \n , x , \n ]" { tolerates("[ \n x \n , x , \n ]") }
        then "[ \n x , x \n , \n ]" { tolerates("[ \n x , x \n , \n ]") }
        then "[ \n x , \n , x \n ]" { tolerates("[ \n x , \n , x \n ]") }
        then "[ \n x , \n x \n , ]" { tolerates("[ \n x , \n x \n , ]") }
        then "[ \n x , \n x , ] \n" { tolerates("[ \n x , \n x , ] \n") }
    }
}
