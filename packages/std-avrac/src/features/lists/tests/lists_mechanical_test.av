        then "[ x for ( x , x ) in x .. x x if ]" { refusals("[ x for ( x , x ) in x .. x x if ]") > 0 }
        then "[ x for ( x , x ) in x .. x if ] x" { refusals("[ x for ( x , x ) in x .. x if ] x") > 0 }
        then "\n x , \n x , \n ]" { refusals("\n x , \n x , \n ]") > 0 }
        then "[ x , \n x , \n ]" { refusals("[ x , \n x , \n ]") > 0 }
        then "[ \n , \n x , \n ]" { refusals("[ \n , \n x , \n ]") > 0 }
        then "[ \n x \n x , \n ]" { refusals("[ \n x \n x , \n ]") > 0 }
