        then "[ \n x , \n x , \n \n ]" { refusals("[ \n x , \n x , \n \n ]") > 0 }
        then "[ \n x , \n x , \n ] ]" { refusals("[ \n x , \n x , \n ] ]") > 0 }
        then "\n [ x , \n x , \n ]" { refusals("\n [ x , \n x , \n ]") > 0 }
        then "[ x \n , \n x , \n ]" { refusals("[ x \n , \n x , \n ]") > 0 }
        then "[ \n , x \n x , \n ]" { refusals("[ \n , x \n x , \n ]") > 0 }
        then "[ \n x \n , x , \n ]" { refusals("[ \n x \n , x , \n ]") > 0 }
        then "[ \n x , x \n , \n ]" { refusals("[ \n x , x \n , \n ]") > 0 }
        then "[ \n x , \n , x \n ]" { refusals("[ \n x , \n , x \n ]") > 0 }
        then "[ \n x , \n x \n , ]" { refusals("[ \n x , \n x \n , ]") > 0 }
        then "[ \n x , \n x , ] \n" { refusals("[ \n x , \n x , ] \n") > 0 }
    }
}
