        then "[ x for ( x , x ) in x .. x if ] x" { tolerates("[ x for ( x , x ) in x .. x if ] x") }
        then "\n x , \n x , \n ]" { tolerates("\n x , \n x , \n ]") }
        then "[ x , \n x , \n ]" { tolerates("[ x , \n x , \n ]") }
        then "[ \n , \n x , \n ]" { tolerates("[ \n , \n x , \n ]") }
        then "[ \n x \n x , \n ]" { tolerates("[ \n x \n x , \n ]") }
        then "[ \n x , x , \n ]" { tolerates("[ \n x , x , \n ]") }
        then "[ \n x , \n , \n ]" { tolerates("[ \n x , \n , \n ]") }
        then "[ \n x , \n x \n ]" { tolerates("[ \n x , \n x \n ]") }
        then "[ \n x , \n x , ]" { tolerates("[ \n x , \n x , ]") }
        then "[ \n x , \n x , \n" { tolerates("[ \n x , \n x , \n") }
        then "[ [ \n x , \n x , \n ]" { tolerates("[ [ \n x , \n x , \n ]") }
        then "[ \n \n x , \n x , \n ]" { tolerates("[ \n \n x , \n x , \n ]") }
