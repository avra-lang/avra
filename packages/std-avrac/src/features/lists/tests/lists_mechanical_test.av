// GENERATED by `avra attack lists` — the mechanical
// classes from the feature's rule and the model. A SEMANTIC
// attack belongs in the feature's hand-written test.
// cap: 500 case(s), 0 dropped.
use @std.avrac.compiler.{analyze_source}
use @std.avrac.diagnostics.{Diag}

/// The SHAPE parses — a canonical sample spells `x` where a name
/// belongs, so a TYPE error is expected and a PARSE error is not.
fn parses(src: string) -> bool {
    !analyze_source(src).diagnostics.any(parse_error)
}

fn parse_error(d: Diag) -> bool {
    d.kind.starts_with("parse.")
}

/// The compiler REACHES A VERDICT on a malformed surface — a
/// deletion can yield a valid program, so this law is tolerance,
/// not refusal; a trap is not a verdict and dies in the call.
fn tolerates(src: string) -> bool {
    let reached = analyze_source(src).diagnostics.length
    reached >= 0
}

spec "features/lists adversarial — mechanical" {
    given "degenerate shapes — a valid surface, and must stay valid" {
        then "[ \n x , \n ]" { parses("[ \n x , \n ]") == parses("[ \n x , \n x , \n ]") }
        then "[ \n x , \n x , \n x , \n ]" { parses("[ \n x , \n x , \n x , \n ]") == parses("[ \n x , \n x , \n ]") }
    }
    given "malformed surface (delete, duplicate, swap) — must be diagnosed" {
        then "x for ( x , x ) in x .. x if x ]" { tolerates("x for ( x , x ) in x .. x if x ]") }
        then "[ for ( x , x ) in x .. x if x ]" { tolerates("[ for ( x , x ) in x .. x if x ]") }
        then "[ x ( x , x ) in x .. x if x ]" { tolerates("[ x ( x , x ) in x .. x if x ]") }
        then "[ x for x , x ) in x .. x if x ]" { tolerates("[ x for x , x ) in x .. x if x ]") }
        then "[ x for ( , x ) in x .. x if x ]" { tolerates("[ x for ( , x ) in x .. x if x ]") }
        then "[ x for ( x x ) in x .. x if x ]" { tolerates("[ x for ( x x ) in x .. x if x ]") }
        then "[ x for ( x , ) in x .. x if x ]" { tolerates("[ x for ( x , ) in x .. x if x ]") }
        then "[ x for ( x , x in x .. x if x ]" { tolerates("[ x for ( x , x in x .. x if x ]") }
        then "[ x for ( x , x ) x .. x if x ]" { tolerates("[ x for ( x , x ) x .. x if x ]") }
        then "[ x for ( x , x ) in .. x if x ]" { tolerates("[ x for ( x , x ) in .. x if x ]") }
        then "[ x for ( x , x ) in x x if x ]" { tolerates("[ x for ( x , x ) in x x if x ]") }
        then "[ x for ( x , x ) in x .. if x ]" { tolerates("[ x for ( x , x ) in x .. if x ]") }
        then "[ x for ( x , x ) in x .. x x ]" { tolerates("[ x for ( x , x ) in x .. x x ]") }
        then "[ x for ( x , x ) in x .. x if ]" { tolerates("[ x for ( x , x ) in x .. x if ]") }
        then "[ x for ( x , x ) in x .. x if x" { tolerates("[ x for ( x , x ) in x .. x if x") }
        then "[ [ x for ( x , x ) in x .. x if x ]" { tolerates("[ [ x for ( x , x ) in x .. x if x ]") }
        then "[ x x for ( x , x ) in x .. x if x ]" { tolerates("[ x x for ( x , x ) in x .. x if x ]") }
        then "[ x for for ( x , x ) in x .. x if x ]" { tolerates("[ x for for ( x , x ) in x .. x if x ]") }
        then "[ x for ( ( x , x ) in x .. x if x ]" { tolerates("[ x for ( ( x , x ) in x .. x if x ]") }
        then "[ x for ( x x , x ) in x .. x if x ]" { tolerates("[ x for ( x x , x ) in x .. x if x ]") }
        then "[ x for ( x , , x ) in x .. x if x ]" { tolerates("[ x for ( x , , x ) in x .. x if x ]") }
        then "[ x for ( x , x x ) in x .. x if x ]" { tolerates("[ x for ( x , x x ) in x .. x if x ]") }
        then "[ x for ( x , x ) ) in x .. x if x ]" { tolerates("[ x for ( x , x ) ) in x .. x if x ]") }
        then "[ x for ( x , x ) in in x .. x if x ]" { tolerates("[ x for ( x , x ) in in x .. x if x ]") }
        then "[ x for ( x , x ) in x x .. x if x ]" { tolerates("[ x for ( x , x ) in x x .. x if x ]") }
        then "[ x for ( x , x ) in x .. .. x if x ]" { tolerates("[ x for ( x , x ) in x .. .. x if x ]") }
        then "[ x for ( x , x ) in x .. x x if x ]" { tolerates("[ x for ( x , x ) in x .. x x if x ]") }
        then "[ x for ( x , x ) in x .. x if if x ]" { tolerates("[ x for ( x , x ) in x .. x if if x ]") }
        then "[ x for ( x , x ) in x .. x if x x ]" { tolerates("[ x for ( x , x ) in x .. x if x x ]") }
        then "[ x for ( x , x ) in x .. x if x ] ]" { tolerates("[ x for ( x , x ) in x .. x if x ] ]") }
        then "x [ for ( x , x ) in x .. x if x ]" { tolerates("x [ for ( x , x ) in x .. x if x ]") }
        then "[ for x ( x , x ) in x .. x if x ]" { tolerates("[ for x ( x , x ) in x .. x if x ]") }
        then "[ x ( for x , x ) in x .. x if x ]" { tolerates("[ x ( for x , x ) in x .. x if x ]") }
        then "[ x for x ( , x ) in x .. x if x ]" { tolerates("[ x for x ( , x ) in x .. x if x ]") }
        then "[ x for ( , x x ) in x .. x if x ]" { tolerates("[ x for ( , x x ) in x .. x if x ]") }
        then "[ x for ( x x , ) in x .. x if x ]" { tolerates("[ x for ( x x , ) in x .. x if x ]") }
        then "[ x for ( x , ) x in x .. x if x ]" { tolerates("[ x for ( x , ) x in x .. x if x ]") }
        then "[ x for ( x , x in ) x .. x if x ]" { tolerates("[ x for ( x , x in ) x .. x if x ]") }
        then "[ x for ( x , x ) x in .. x if x ]" { tolerates("[ x for ( x , x ) x in .. x if x ]") }
        then "[ x for ( x , x ) in .. x x if x ]" { tolerates("[ x for ( x , x ) in .. x x if x ]") }
        then "[ x for ( x , x ) in x x .. if x ]" { tolerates("[ x for ( x , x ) in x x .. if x ]") }
        then "[ x for ( x , x ) in x .. if x x ]" { tolerates("[ x for ( x , x ) in x .. if x x ]") }
        then "[ x for ( x , x ) in x .. x x if ]" { tolerates("[ x for ( x , x ) in x .. x x if ]") }
        then "[ x for ( x , x ) in x .. x if ] x" { tolerates("[ x for ( x , x ) in x .. x if ] x") }
        then "\n x , \n x , \n ]" { tolerates("\n x , \n x , \n ]") }
        then "[ x , \n x , \n ]" { tolerates("[ x , \n x , \n ]") }
        then "[ \n , \n x , \n ]" { tolerates("[ \n , \n x , \n ]") }
        then "[ \n x \n x , \n ]" { tolerates("[ \n x \n x , \n ]") }
        then "[ \n x , x , \n ]" { tolerates("[ \n x , x , \n ]") }
        then "[ \n x , \n , \n ]" { tolerates("[ \n x , \n , \n ]") }
        then "[ \n x , \n x \n ]" { tolerates("[ \n x , \n x \n ]") }
        then "[ \n x , \n x , ]" { tolerates("[ \n x , \n x , ]") }
        then "[ \n x , \n x , \n" { tolerates("[ \n x , \n x , \n") }
        then "[ [ \n x , \n x , \n ]" { tolerates("[ [ \n x , \n x , \n ]") }
        then "[ \n \n x , \n x , \n ]" { tolerates("[ \n \n x , \n x , \n ]") }
        then "[ \n x x , \n x , \n ]" { tolerates("[ \n x x , \n x , \n ]") }
        then "[ \n x , , \n x , \n ]" { tolerates("[ \n x , , \n x , \n ]") }
        then "[ \n x , \n \n x , \n ]" { tolerates("[ \n x , \n \n x , \n ]") }
        then "[ \n x , \n x x , \n ]" { tolerates("[ \n x , \n x x , \n ]") }
        then "[ \n x , \n x , , \n ]" { tolerates("[ \n x , \n x , , \n ]") }
        then "[ \n x , \n x , \n \n ]" { tolerates("[ \n x , \n x , \n \n ]") }
        then "[ \n x , \n x , \n ] ]" { tolerates("[ \n x , \n x , \n ] ]") }
        then "\n [ x , \n x , \n ]" { tolerates("\n [ x , \n x , \n ]") }
        then "[ x \n , \n x , \n ]" { tolerates("[ x \n , \n x , \n ]") }
        then "[ \n , x \n x , \n ]" { tolerates("[ \n , x \n x , \n ]") }
        then "[ \n x \n , x , \n ]" { tolerates("[ \n x \n , x , \n ]") }
        then "[ \n x , x \n , \n ]" { tolerates("[ \n x , x \n , \n ]") }
        then "[ \n x , \n , x \n ]" { tolerates("[ \n x , \n , x \n ]") }
        then "[ \n x , \n x \n , ]" { tolerates("[ \n x , \n x \n , ]") }
        then "[ \n x , \n x , ] \n" { tolerates("[ \n x , \n x , ] \n") }
    }
    given "keyword-replace — must be diagnosed or a valid program" {
        then "for x for ( x , x ) in x .. x if x ]" { tolerates("for x for ( x , x ) in x .. x if x ]") }
        then "[ for for ( x , x ) in x .. x if x ]" { tolerates("[ for for ( x , x ) in x .. x if x ]") }
        then "[ x in ( x , x ) in x .. x if x ]" { tolerates("[ x in ( x , x ) in x .. x if x ]") }
        then "[ x for for x , x ) in x .. x if x ]" { tolerates("[ x for for x , x ) in x .. x if x ]") }
        then "[ x for ( for , x ) in x .. x if x ]" { tolerates("[ x for ( for , x ) in x .. x if x ]") }
        then "[ x for ( x for x ) in x .. x if x ]" { tolerates("[ x for ( x for x ) in x .. x if x ]") }
        then "[ x for ( x , for ) in x .. x if x ]" { tolerates("[ x for ( x , for ) in x .. x if x ]") }
        then "[ x for ( x , x for in x .. x if x ]" { tolerates("[ x for ( x , x for in x .. x if x ]") }
        then "[ x for ( x , x ) for x .. x if x ]" { tolerates("[ x for ( x , x ) for x .. x if x ]") }
        then "[ x for ( x , x ) in for .. x if x ]" { tolerates("[ x for ( x , x ) in for .. x if x ]") }
        then "[ x for ( x , x ) in x for x if x ]" { tolerates("[ x for ( x , x ) in x for x if x ]") }
        then "[ x for ( x , x ) in x .. for if x ]" { tolerates("[ x for ( x , x ) in x .. for if x ]") }
        then "[ x for ( x , x ) in x .. x for x ]" { tolerates("[ x for ( x , x ) in x .. x for x ]") }
        then "[ x for ( x , x ) in x .. x if for ]" { tolerates("[ x for ( x , x ) in x .. x if for ]") }
        then "[ x for ( x , x ) in x .. x if x for" { tolerates("[ x for ( x , x ) in x .. x if x for") }
        then "for \n x , \n x , \n ]" { tolerates("for \n x , \n x , \n ]") }
        then "[ for x , \n x , \n ]" { tolerates("[ for x , \n x , \n ]") }
        then "[ \n for , \n x , \n ]" { tolerates("[ \n for , \n x , \n ]") }
        then "[ \n x for \n x , \n ]" { tolerates("[ \n x for \n x , \n ]") }
        then "[ \n x , for x , \n ]" { tolerates("[ \n x , for x , \n ]") }
        then "[ \n x , \n for , \n ]" { tolerates("[ \n x , \n for , \n ]") }
        then "[ \n x , \n x for \n ]" { tolerates("[ \n x , \n x for \n ]") }
        then "[ \n x , \n x , for ]" { tolerates("[ \n x , \n x , for ]") }
        then "[ \n x , \n x , \n for" { tolerates("[ \n x , \n x , \n for") }
    }
}
