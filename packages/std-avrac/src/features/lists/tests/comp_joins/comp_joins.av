// proves: comprehensions with more than one `for` head — nesting (two
// and three heads), a filter between heads, a later head reading an
// earlier one's binder, a paired head beside a range head, an empty
// inner list, and a name shadowed across heads — natively
let pairs = [a + b for a in [1, 2] for b in [10, 20]]
let triples = [a + b + c for a in [1, 2] for b in [10, 20] for c in [100, 200]]
let mid_filter = [a + b for a in [1, 2, 3] if a % 2 == 1 for b in [10, 20]]
let tail_filter = [a + b for a in [1, 2] for b in [10, 20, 30] if b > 10]
let nested_read = [c for a in [[1, 2], [3]] for c in a]
let paired_and_range = [i * 100 + b for i, a in [5, 6] for b in 0..a]
let none: List<int> = []
let empty_inner = [b for a in [1, 2] for b in none]
let shadowed = [a for a in [1, 2] for a in [10, 20]]
pairs[3] +
    triples[7] +
    mid_filter[2] +
    tail_filter[3] +
    nested_read[2] +
    paired_and_range.length +
    paired_and_range[5] +
    empty_inner.length +
    shadowed[3]
