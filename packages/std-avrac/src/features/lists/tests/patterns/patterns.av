// proves: list patterns `[first, ..rest]`, `[..init, last]`, `[a, ..]`,
// exact `[a, b]` and `[]`, and record patterns `P { x, y: 0, .. }` —
// the elements read only once the length agreed
type P = { x: int, y: int, name: string }

fn sum(xs: List<int>) -> int {
    match xs { [] -> 0, [h, ..t] -> h + sum(t) }
}

fn ends(xs: List<int>) -> string {
    match xs {
        [] -> "none",
        [only] -> "one ${only}",
        [first, ..mid, last] -> "${first}..${last} over ${mid.length}",
    }
}

fn last_of(xs: List<string>) -> string {
    match xs { [..init, last] -> "${last} after ${init.length}", _ -> "empty" }
}

fn head_pair(xs: List<int>) -> int {
    match xs { [a, b] -> a * 10 + b, [a, ..] -> a, _ -> -1 }
}

fn where_is(p: P) -> string {
    match p {
        P { x: 0, y: 0, .. } -> "origin",
        P { x, y: 0, .. } -> "on x ${x}",
        P { name, .. } -> "at ${name}",
    }
}

fn nested(ps: List<P>) -> int {
    match ps { [P { x, .. }, ..rest] -> x + rest.length, [] -> 0 }
}

let a = [1, 2, 3, 4]
"${sum(a)} ${ends([])} ${ends([7])} ${ends(a)} ${last_of(["a", "b", "c"])} ${last_of([])} ${head_pair([4, 5])} ${head_pair([6, 7, 8])} ${head_pair([])} ${where_is(P { x: 0, y: 0, name: "o" })} ${where_is(P { x: 5, y: 0, name: "p" })} ${where_is(P { x: 1, y: 2, name: "q" })} ${nested([P { x: 3, y: 0, name: "n" }, P { x: 1, y: 1, name: "m" }])}"
