// proves: `let` takes a value apart by a pattern — records and lists —
// with `else` for the shapes it may refuse; `is` asks the same patterns
// in a condition and binds on the taken side
type P = { x: int, y: int, name: string }

fn norm(p: P) -> int {
    let P { x, y, .. } = p
    x * 10 + y
}

fn first_two(xs: List<int>) -> int {
    let [a, b, ..] = xs else { return -1 }
    a * 10 + b
}

fn tail_len(xs: List<int>) -> int {
    let [_, ..rest] = xs else { return 0 }
    rest.length
}

fn named(p: P) -> string {
    let P { name, x: 0, .. } = p else { return "off" }
    name
}

fn nested(ps: List<P>) -> int {
    let [P { x, .. }, ..more] = ps else { return -1 }
    let total = x + more.length
    total * 2
}

fn asked(xs: List<int>) -> string {
    if xs is [h, ..t] {
        return "head ${h} tail ${t.length}"
    }
    "empty"
}

fn at_origin(p: P) -> string {
    if p is P { x: 0, y: 0, .. } { return "origin" }
    if p is P { x, .. } { return "x ${x}" }
    "never"
}

let p = P { x: 3, y: 4, name: "p" }
"${norm(p)} ${first_two([7, 8, 9])} ${first_two([1])} ${tail_len([1, 2, 3])} ${tail_len([])} ${named(P { x: 0, y: 1, name: "z" })} ${named(p)} ${nested([P { x: 4, y: 0, name: "a" }, p])} ${nested([])} ${asked([5, 6, 7])} ${asked([])} ${at_origin(P { x: 0, y: 0, name: "o" })} ${at_origin(p)}"
