// proves: `xs.concat([…])` answers what a concat of a made list answers — words and boxes, a
// nullable element widened, the binary's own data as the receiver, an empty literal, a receiver
// another binding holds, a chain whose middle list nobody else holds, a literal that spreads, and
// a record element.
type P = { x: int, tag: string }

fn made(xs: List<int>, ys: List<int>) -> List<int> { xs.concat(ys) }

fn words() -> string {
    let a = [1, 2]
    let b = a.concat([3, 4])
    let c = made(a, [3, 4])
    "${a.length} ${b.length} ${b == c}"
}

fn texts() -> string {
    let a = ["x"]
    let b = a.concat(["y", "z"])
    "${a.join("")} ${b.join("")}"
}

fn widened() -> string {
    let a: List<int?> = [null]
    let b = a.concat([5])
    "${b.length} ${b[0] == null} ${b[1] ?? 0}"
}

fn literal_receiver() -> string { "${[1, 2].concat([3]).length}" }

fn nothing_added() -> string {
    let a = [1]
    let b = a.concat([])
    "${a.length} ${b.length}"
}

fn chained() -> string {
    let a = [0]
    let b = a.concat([1]).concat([2]).concat([3, 4])
    "${a.length} ${b.length} ${b[4]}"
}

fn spread() -> string {
    let a = [1]
    let ys = [2, 3]
    "${a.concat([..ys, 4]).length}"
}

fn records() -> string {
    let a = [P { x: 1, tag: "a" }]
    let b = a.concat([P { x: 2, tag: "b" }])
    "${a.length} ${b.length} ${b[1].tag}"
}

fn nested() -> string {
    let a = [[1]]
    let b = a.concat([[2, 3]])
    "${a.length} ${b.length} ${b[1].length}"
}

"${words()} | ${texts()} | ${widened()} | ${literal_receiver()} | ${nothing_added()} | ${chained()} | ${spread()} | ${records()} | ${nested()}"
