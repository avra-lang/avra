// Comprehensions: the element, the binders, the filter, `?` inside,
// nesting — and the laws they must obey.
use @std.avrac.testing.{shown, refused_with}

fn halver() -> string {
    "enum Oddness {\n    odd\n}\nfn half(n: int) -> Result<int, Oddness> {\n    if n % 2 == 0 { n / 2 } else { fail Oddness.odd }\n}\n"
}

spec "features/lists (comprehensions)" {
    given "the shape" {
        then "an element expression over every source element" {
            shown("let xs = [x * 2 for x in [1, 2, 3]]\nxs[0] + xs[1] + xs[2]") == "12"
        }
        then "a filter keeps what holds" {
            shown("let xs = [x for x in [1, 2, 3, 4, 5, 6] if x % 2 == 0]\nxs.length * 10 + xs[2]") == "36"
        }
        then "an index binder walks beside the element" {
            shown("let xs = [i * 100 + x for (i, x) in [7, 8, 9]]\nxs[2]") == "209"
        }
        then "the source may be any list expression" {
            shown("fn seed() -> List<int> {\n    [3, 1]\n}\n[x + 1 for x in seed()][1]") == "2"
        }
        then "a comprehension nests" {
            shown("let grid = [[x * y for y in [1, 2]] for x in [10, 20]]\ngrid[1][1]") == "40"
        }
        then "the binder dies with its comprehension" {
            refused_with("let xs = [x for x in [1]]\nx", "`x` is not defined")
        }
        then "strings ride the slots — the element may be text" {
            shown("let words = [\"\${x}!\" for x in [\"a\", \"b\"]]\nwords[1]") == "b!"
        }
    }
    given "propagation inside" {
        then "`?` in the element leaves the fn on the first failure" {
            shown(
                    "${halver()}fn halves(xs: List<int>) -> Result<List<int>, Oddness> {\n    [half(x)? for x in xs]\n}\nmatch halves([2, 4]) {\n    .Ok(v) -> v[1]\n    .Err(_) -> -1\n}",
                ) == "2" &&
                shown(
                    "${halver()}fn halves(xs: List<int>) -> Result<List<int>, Oddness> {\n    [half(x)? for x in xs]\n}\nmatch halves([2, 3]) {\n    .Ok(v) -> v[1]\n    .Err(_) -> -1\n}",
                ) == "-1"
        }
    }
    given "the laws" {
        then "the source must be a list" {
            refused_with("[x for x in 5]", "a comprehension walks a list, found `int`")
        }
        then "a `string` source names its view" {
            refused_with("[c for c in \"abc\"]", "names no element without a view")
        }
        then "the filter must be a bool" {
            refused_with("[x for x in [1] if x]", "a comprehension's filter is a `bool`")
        }
        then "an element of `null` alone names no type" {
            refused_with(
                "[x for x in [1] if true][0] + [null for x in [1]][0]",
                "a list element takes its type from its value, and `null` has none of its own",
            )
        }
    }
    given "the head is the `for` statement's" {
        then "a bare pair binds the index and the element" {
            shown("let xs = [i * 100 + x for i, x in [7, 8, 9]]\nxs[2]") == "209"
        }
        then "a range counts, the name is the count" {
            shown("let sq = [i * i for i in 0..5]\nsq.length * 100 + sq[4]") == "516"
        }
        then "a range filters and nests" {
            shown(
                "let ev = [i for i in 0..10 if i % 2 == 0]\nlet grid = [[x * 10 + y for y in 0..2] for x in 1..3]\nev.length * 1000 + ev[4] * 100 + grid[1][1]",
            ) == "5821"
        }
        then "an empty range is an empty list" {
            shown("[i for i in 3..3].length") == "0"
        }
        then "a range has no index" {
            refused_with(
                "[i for j, i in 0..3]",
                "a range has no index — the counter IS the position",
            )
        }
        then "a range's bounds are ints" {
            refused_with(
                    "[i for i in \"a\"..3]",
                    "a range's low bound is a `int`, found `string`",
                ) &&
                refused_with(
                    "[i for i in 0..true]",
                    "a range's high bound is a `int`, found `bool`",
                )
        }
    }
    given "the element hears the list's want" {
        then "a free Var in the element is pinned by the declared list" {
            shown(
                "fn empty<T>() -> List<T> {\n    []\n}\nlet xs: List<List<int>> = [empty() for i in 0..2]\nxs.length * 10 + xs[1].length",
            ) == "20"
        }
        then "an element that disagrees with the declared list keeps its own — the seat speaks" {
            refused_with(
                "let xs: List<string> = [i for i in 0..3]\nxs.length",
                "`xs` declares `List<string>`, this is `List<int>`",
            )
        }
        then "a struct element boxes into a declared dyn list" {
            shown(
                "trait Show {\n    fn show() -> int\n}\ntype P = { x: int }\nimpl Show for P {\n    fn show() -> int { self.x }\n}\nlet boxes: List<dyn Show> = [P { x: i } for i in 0..3]\nboxes[2].show()",
            ) == "2"
        }
    }
    given "several `for` heads" {
        then "a second head nests inside the first" {
            shown("[a + b for a in [1, 2] for b in [10, 20]][2]") == "12"
        }
        then "a third head nests inside the second" {
            shown("[a + b + c for a in [1] for b in [10] for c in [100, 200]][1]") == "211"
        }
        then "a filter may sit between two heads" {
            shown("[a + b for a in [1, 2, 3] if a % 2 == 1 for b in [10, 20]].length") == "4"
        }
        then "a later head reads an earlier one's binder" {
            shown("[c for a in [[1, 2], [3]] for c in a][2]") == "3"
        }
        then "a paired head and a range head mix" {
            shown("[i * 100 + b for i, a in [5, 6] for b in 0..a][5]") == "100"
        }
        then "an empty inner list contributes nothing" {
            shown("let none: List<int> = []\n[b for a in [1, 2] for b in none].length") == "0"
        }
        then "a later head's binder shadows an earlier one of the same name" {
            shown("[a for a in [1, 2] for a in [10, 20]][3]") == "20"
        }
        then "each head's own binder still dies with the comprehension" {
            refused_with("[a + b for a in [1] for b in [1]]\nb", "`b` is not defined")
        }
    }
}
