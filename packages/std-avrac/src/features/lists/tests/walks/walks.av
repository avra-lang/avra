// proves: rung 13 L2 — the list vocabulary. map/filter/find/any/
// all as the builtin fork of the dot-call, walks chaining, walks
// inside lambdas and generic bodies, managed elements through
// walks under ownership, the unified postfix (calls, indexes, and
// props interleaving), and multiline struct literals.
type U = {
    name: string,
    age: int,
}
fn grown<T>(xs: List<T>, p: fn(T) -> bool) -> List<T> {
    xs.filter(p)
}
fn double(x: int) -> int {
    x * 2
}
let us = [
    U { name: "ada", age: 36 },
    U { name: "bo", age: 7 },
    U { name: "cy", age: 60 },
]
let xs = [1, 2, 3, 4, 5]
let sizes = [[1, 2], [3, 4, 5]].map((r: List<int>) -> r.length)
let counter: fn(int) -> int = (floor: int) -> xs.filter((x: int) -> x > floor).length
let churn = 0
let i = 0
while i < 100 {
    let tags = us.map((u: U) -> "${u.name}#${i}")
    churn = churn + tags.length + us.filter((u: U) -> u.age > i).length
    i = i + 1
}
let hit = us.find((u: U) -> u.age < 10) ?? U { name: "-", age: 0 }
"m ${xs.map(double)[4]} f ${us.filter((u: U) -> u.age > 17).length} h ${hit.name} a ${xs.any((x: int) -> x > 4)} ${xs.all((x: int) -> x > 0)} s ${sizes[0]}${sizes[1]} c ${counter(2)} g ${grown(us, (u: U) -> u.age > 30).length} w ${churn}"
