// proves: G3 — List<T> becomes real. The element walk (structs,
// enums, nested lists, early return through it), the widened
// element law, `[]` adopted by claims (a let, a Result's ok side),
// and the range form intact beside it all.
type Box<T> = { v: T }

enum E {
    boom
}

fn hunt(xs: List<int>, want: int) -> int {
    mut at = 0
    for x in xs {
        if x == want {
            return at
        }
        at = at + 1
    }
    0 - 1
}

fn make(b: bool) -> Result<List<int>, E> {
    if b {
        fail E.boom
    }
    []
}

let none: List<int> = []
let m = [[1, 2], [3, 4, 5]]
let t = 0
for row in m {
    for v in row {
        t = t + v
    }
}
for b in [Box { v: 3 }, Box { v: 4 }] {
    t = t + b.v
}
for i in 0..3 {
    t = t + i
}
let got = match make(false) {
    .Ok(xs) -> xs.length,
    .Err(e) -> 0 - 1,
}
"t ${t} h ${hunt([5, 8, 13], 8)} ${hunt(none, 9)} e ${none.length} r ${got}"
