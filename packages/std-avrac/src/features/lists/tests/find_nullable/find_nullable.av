// proves: `find` over nullable elements keeps its two absences apart —
// no element found, and an element found that is itself `null`.
fn missing<T>(hit: T?) -> bool { hit == null }

let xs: List<string?> = [null, "a"]
let ys: List<string?> = [null, null]
let named = xs.find(it != null)
let none = ys.find(it != null)
let blank = xs.find(it == null)

"${missing(named)} ${named! ?? "-"} ${missing(none)} ${missing(blank)} ${blank! ?? "a null"}"
