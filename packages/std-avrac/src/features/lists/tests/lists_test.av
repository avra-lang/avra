// Lists, vertically: the literal, indexing, length, iteration
// through range-for, and every law refusing in its own words.
use @std.avrac.language.{analyze_source, lower, memory}
use @std.avrac.testing.{shown}

spec "features/lists" {
    given "the aggregate" {
        then "a literal prints as itself" {
            shown("[1, 2, 3]") == "[1, 2, 3]"
        }
        then "indexing reads an element" {
            shown("let xs = [10, 20, 30]\nxs[1]") == "20"
        }
        then "a literal indexes directly" {
            shown("[9, 8][1]") == "8"
        }
        then "length measures" {
            shown("let xs = [4, 5]\nxs.length") == "2"
        }
        then "bools aggregate too" {
            shown("let flags = [true, false]\nflags[0]") == "true"
        }
        then "a range-for folds a list" {
            shown("let xs = [3, 4, 5]\nmut total = 0\nfor i in 0..xs.length {\n    total = total + xs[i]\n}\ntotal") == "12"
        }
    }
    given "wrong shapes" {
        then "an empty list has nothing to infer" {
            let a = analyze_source("[]\n1")
            a.diagnostics.length == 1 &&
                a.report().contains("an empty list has no element type to infer")
        }
        then "elements share one type" {
            let a = analyze_source("[1, true]\n2")
            a.diagnostics.length == 1 &&
                a.report().contains("a list's elements share one type")
        }
        then "managed elements wait for ownership analysis" {
            let a = analyze_source("[\"a\"]\n2")
            a.diagnostics.length == 1 &&
                a.report().contains("a list holds scalars for now")
        }
        then "indexing a non-list points at the subject" {
            let a = analyze_source("1[0]\n2")
            a.diagnostics.length == 1 &&
                a.report().contains("`[...]` indexes a `List`, found `int`")
        }
        then "a non-int index points at the position" {
            let a = analyze_source("let xs = [1]\nxs[true]\n2")
            a.diagnostics.length == 1 &&
                a.report().contains("an index is an `int`, found `bool`")
        }
        then "an unknown property is named" {
            let a = analyze_source("let xs = [1]\nxs.size\n2")
            a.diagnostics.length == 1 &&
                a.report().contains("no property `size` on `List<int>`") &&
                a.report().contains("the one property today is `length`")
        }
        then "`==` on lists offers the alternatives" {
            let a = analyze_source("let xs = [1]\nlet ys = [1]\nxs == ys\n2")
            a.diagnostics.length == 1 &&
                a.report().contains("`==` compares scalars for now")
        }
    }
    given "the run's own refusals" {
        then "out of bounds refuses the run" {
            shown("let xs = [1]\nxs[5]") == "<refused>"
        }
        then "a list answer prints — no refusal anywhere" {
            let l = memory(lower(analyze_source("[1, 2]")))
            l.diagnostics.is_empty() && shown("[1, 2]") == "[1, 2]"
        }
    }
}
