// Lists, vertically: the literal, indexing, length, iteration
// through range-for, and every law refusing in its own words.
use @std.avrac.compiler.{analyze_source, lower, memory}
use @std.avrac.testing.{shown, refused_with, refused_at_run}

spec "features/lists" {
    given "the aggregate" {
        then "a literal prints as itself" {
            shown("[1, 2, 3]") == "[1, 2, 3]"
        }
        then "indexing reads an element" {
            shown("let xs = [10, 20, 30]\nxs[1]") == "20"
        }
        then "a literal indexes directly" {
            shown("[9, 8][1]") == "8"
        }
        then "length measures" {
            shown("let xs = [4, 5]\nxs.length") == "2"
        }
        then "bools aggregate too" {
            shown("let flags = [true, false]\nflags[0]") == "true"
        }
        then "a range-for folds a list" {
            shown("let xs = [3, 4, 5]\nmut total = 0\nfor i in 0..xs.length {\n    total = total + xs[i]\n}\ntotal") == "12"
        }
    }
    given "wrong shapes" {
        then "an empty list is ADOPTED by whatever list claims it" {
            shown("let xs: List<int> = []\nxs.length") == "0"
        }
        then "elements share one type" {
            let a = analyze_source("[1, true]\n2")
            a.diagnostics.length == 1 &&
                a.report().contains("a list's elements share one type")
        }
        then "managed elements ride the slot — ownership landed" {
            analyze_source("[\"a\"]\n2").diagnostics.is_empty()
        }
        then "indexing a non-list points at the subject" {
            let a = analyze_source("1[0]\n2")
            a.diagnostics.length == 1 &&
                a.report().contains("`[...]` indexes a `List`, found `int`")
        }
        then "a non-int index points at the position" {
            let a = analyze_source("let xs = [1]\nxs[true]\n2")
            a.diagnostics.length == 1 &&
                a.report().contains("an index is an `int`, found `bool`")
        }
        then "an unknown property is named" {
            let a = analyze_source("let xs = [1]\nxs.size\n2")
            a.diagnostics.length == 1 &&
                a.report().contains("no property `size` on `List<int>`") &&
                a.report().contains("a property is a record's field, or a measure like `length`")
        }
        then "`==` on lists offers the alternatives" {
            let a = analyze_source("let xs = [1]\nlet ys = [1]\nxs == ys\n2")
            a.diagnostics.length == 1 &&
                a.report().contains("`==` compares scalars for now")
        }
    }
    given "the run's own refusals" {
        then "out of bounds refuses the run" {
            shown("let xs = [1]\nxs[5]") == "<refused>"
        }
        then "a list answer prints — no refusal anywhere" {
            let l = memory(lower(analyze_source("[1, 2]")))
            l.diagnostics.is_empty() && shown("[1, 2]") == "[1, 2]"
        }
    }
    given "G3 — the element walk and the widened law" {
        then "`for x in xs` binds each element" {
            shown("mut t = 0\nfor x in [4, 5, 6] {\n    t = t + x\n}\nt") == "15"
        }
        then "struct elements ride the widened slot law" {
            shown("type P = { x: int }\nmut t = 0\nfor p in [P { x: 2 }, P { x: 3 }] {\n    t = t + p.x\n}\nt") == "5"
        }
        then "nested lists nest their walks" {
            shown("mut t = 0\nfor row in [[1], [2, 3]] {\n    t = t + row.length\n}\nt") == "3"
        }
        then "the RANGE form is untouched beside it" {
            shown("mut t = 0\nfor i in 1..4 {\n    t = t + i\n}\nt") == "6"
        }
        then "walking a non-list refuses and names the range spelling" {
            refused_with("mut t = 0\nfor x in 5 {\n    t = t + x\n}\nt",
                         "`for … in` walks a `List`, this is `int`")
        }
        then "walking `[]` refuses — the loop would never run" {
            refused_with("mut t = 0\nfor x in [] {\n    t = t + x\n}\nt",
                         "`for` walks an empty literal — nothing to bind")
        }
        then "`[]` Ok-wraps raw — the identity compound lift" {
            shown("enum E {\n    boom\n}\nfn f() -> Result<List<int>, E> {\n    []\n}\nmatch f() {\n    .Ok(xs) -> xs.length\n    .Err(e) -> 0 - 1\n}") == "0"
        }
    }
    given "the walk vocabulary (L2)" {
        then "map answers a fresh list of the fn's answers" {
            shown("[1, 2, 3].map((x: int) -> x * 2)[2]") == "6"
        }
        then "filter keeps what the predicate blesses" {
            shown("[1, 2, 3, 4].filter((x: int) -> x % 2 == 0).length") == "2"
        }
        then "find answers the first hit" {
            shown("[3, 8, 5].find((x: int) -> x > 4) ?? 0 - 1") == "8"
        }
        then "find answers absence on a miss" {
            shown("[3, 8, 5].find((x: int) -> x > 9) ?? 0 - 1") == "-1"
        }
        then "any gives the empty walk's verdict" {
            shown("let none: List<int> = []\nnone.any((x: int) -> true)") == "false"
        }
        then "all gives the empty walk's verdict" {
            shown("let none: List<int> = []\nnone.all((x: int) -> false)") == "true"
        }
        then "walks chain, and the unified postfix indexes the answer" {
            shown("[1, 2, 3].filter((x: int) -> x > 1).map((x: int) -> x * 10)[1]") == "30"
        }
        then "the pronoun IS the element at the nearest method call" {
            shown("[1, 2, 3].map(it * 10)[2]") == "30"
        }
        then "the pronoun survives a free-fn wrapper" {
            shown("fn odd(n: int) -> bool {\n    n % 2 == 1\n}\n[1, 2, 3].filter(odd(it)).length") == "2"
        }
        then "an unbound pronoun names its home" {
            refused_with("let x = it + 1\n2", "`it` rides a METHOD call's arguments")
        }
        then "a walk's fn seat must BE the element" {
            refused_with("[1, 2].filter((s: string) -> true)\n2",
                         "`filter`'s fn takes the element `int`")
        }
        then "a predicate answers bool or refuses" {
            refused_with("[1, 2].filter((x: int) -> x + 1)\n2",
                         "`filter`'s fn must answer `bool`")
        }
        then "the empty literal cannot be walked" {
            refused_with("[].map((x: int) -> x)\n2",
                         "`[].map` cannot know its elements")
        }
    }
    given "growth — `push` mutates a place" {
        then "a mut list grows in place" {
            shown("mut xs = [1]\nxs.push(2)\nxs.push(3)\n\"" + "\${xs.length}" + " " + "\${xs[2]}" + "\"") == "3 3"
        }
        then "an alias taken before the push keeps its length" {
            shown("mut xs = [1]\nlet ys = xs\nxs.push(2)\n\"" + "\${xs.length}" + " " + "\${ys.length}" + "\"") == "2 1"
        }
        then "a `let` list refuses — push mutates it" {
            refused_with("let xs = [1]\nxs.push(2)\n2", "`xs` is not `mut` — `push` mutates it")
        }
        then "a literal is a value, not a place" {
            refused_with("[1].push(2)\n2", "`push` mutates a place, and this list is a value")
        }
        then "the element seat judges the argument" {
            refused_with("mut xs = [1]\nxs.push(\"s\")\n2", "argument 1 of `push` wants `int`, found `string`")
        }
        then "push answers nothing — it cannot be bound" {
            refused_with("mut xs = [1]\nlet n = xs.push(2)\n2", "answers nothing")
        }
        then "a nested list grows through its path" {
            shown("mut g = [[1], [2]]\ng[1].push(3)\n\"" + "\${g[1].length}" + " " + "\${g[0].length}" + "\"") == "2 1"
        }
    }
    given "the empty literal, adopted" {
        then "`[]` beside its siblings takes their type" {
            shown("let xs = [[1], [], [2]]\n\"" + "\${xs.length} " + "\${xs[1].length}\"") == "3 0"
        }
        then "`[]` fits a variant's list payload" {
            shown("enum W {\n    Many(xs: List<int>)\n}\nmatch W.Many([]) {\n    .Many(xs) -> xs.length\n}") == "0"
        }
        then "an if joins a list with `[]`" {
            shown("fn f(b: bool) -> List<int> { if b { [7] } else { [] } }\n\"" + "\${f(true).length} " + "\${f(false).length}\"") == "1 0"
        }
    }
    given "the vocabulary" {
        then "contains and index_of scan by value — strings by text, scalars by value" {
            shown("let xs = [\"a\", \"b\"]\nlet ns = [4, 5, 6]\n\"" + "\${xs.contains(\"b\")} " + "\${xs.index_of(\"b\")} " + "\${ns.contains(7)} " + "\${ns.index_of(7)}\"") == "true 1 false -1"
        }
        then "pop removes the last element and answers it" {
            shown("mut xs = [1, 2, 3]\nlet last = xs.pop()\n\"" + "\${last} " + "\${xs.length}\"") == "3 2"
        }
        then "set rewrites one slot" {
            shown("mut xs = [1, 2, 3]\nxs.set(1, 9)\n\"" + "\${xs[0]} " + "\${xs[1]} " + "\${xs[2]}\"") == "1 9 3"
        }
        then "is_empty, first and last read the edges" {
            shown("let xs = [7, 8]\nlet none: List<int> = []\n\"" + "\${xs.is_empty()} " + "\${none.is_empty()} " + "\${xs.first() ?? 0} " + "\${xs.last() ?? 0} " + "\${none.first() ?? 0}\"") == "false true 7 8 0"
        }
        then "concat and slice are fresh copies" {
            shown("let xs = [1, 2]\nlet ys = xs.concat([3, 4])\nlet mid = ys.slice(1, 3)\n\"" + "\${ys.length} " + "\${ys[3]} " + "\${mid.length} " + "\${mid[1]} " + "\${xs.length} " + "\${ys.slice(3, 9).length}\"") == "4 4 2 3 2 1"
        }
        then "join makes text of text" {
            shown("[\"a\", \"b\", \"c\"].join(\"-\")") == "a-b-c"
        }
        then "enumerate is the list, walked by a paired head" {
            shown("let xs = [5, 6]\nmut total = 0\nfor i, x in xs {\n    total = total + i * x\n}\ntotal") == "6"
        }
        then "the copies hold strings too" {
            shown("let xs = [\"p\", \"q\"]\nxs.concat([\"r\"]).slice(1, 3).join(\"\")") == "qr"
        }
    }
    given "the vocabulary's laws" {
        then "pop and set need a mut place" {
            refused_with("let xs = [1]\nxs.pop()", "`xs` is not `mut` — `pop` mutates it")
        }
        then "a wrong argument speaks in the seat's words" {
            refused_with("let xs = [1]\nxs.contains(\"a\")", "argument 1 of `contains` wants `int`, found `string`")
        }
        then "the count is the row's" {
            refused_with("let xs = [1]\nxs.slice(1)", "`slice` takes 2 arguments, found 1")
        }
        then "a scan reads by value — a list of records refuses like `==` does" {
            refused_with("type P = { n: int }\nlet ps = [P { n: 1 }]\nps.contains(P { n: 1 })", "`contains` scans by value — scalars and text for now, this list holds `P`")
        }
        then "enumerate stands only under a paired head" {
            refused_with("let xs = [1]\nlet ys = xs.enumerate()\n2", "`enumerate` pairs only under a paired `for` head")
        }
        then "pop answers the LAST element" {
            shown("mut ss = [\"p\", \"q\", \"r\"]\nss.pop()") == "r"
        }
        then "pop on an empty list is the trap" {
            refused_at_run("mut xs: List<int> = []\nxs.pop()", "pop on an empty list")
        }
        then "join reads text only" {
            refused_with("[1, 2].join(\",\")", "`join` reads a list of text, this one holds `int`")
        }
    }
}
