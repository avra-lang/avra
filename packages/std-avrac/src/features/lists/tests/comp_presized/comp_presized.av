// proves: a comprehension with one head is made with room for every turn it takes, and one with a
// filter as well holds what it kept — over a list, a count, a map and an index binder, a nested
// comprehension beside them, and a kept list that grows after — natively
let xs = [3, 1, 4, 1, 5, 9, 2, 6]
let doubled = [x * 2 for x in xs]
let names = ["n${x}" for x in xs]
let counted = [i * i for i in 2..6]
let reversed = [i for i in 6..2]
let empty = [i for i in 4..4]
let sparse = [x for x in 0..1000 if x % 250 == 0]
let kept_all = [x for x in xs if x > 0]
let none_kept = [x for x in xs if x > 100]
let words = [w for w in ["a", "bb", "ccc", "dddd"] if w.length > 2]
let placed = [i + x for i, x in xs]
let ages = {"ann": 3, "bo": 5}
let summed = [k.length + v for k, v in ages]
let grid = [[x * y for y in 1..3] for x in 1..3]
mut grown = [x for x in 0..10 if x == 3]
grown.push(7)
grown.push(8)
mut refilled = [x for x in 0..10 if x > 99]
refilled.push(5)
doubled[7] +
    names[2].length +
    counted[3] +
    reversed.length +
    empty.length +
    sparse[3] +
    sparse.length +
    kept_all.length +
    none_kept.length +
    words[1].length +
    words.length +
    placed[7] +
    summed[1] +
    grid[1][1] +
    grown.length +
    grown[2] +
    refilled[0]
