// proves: every value a statement of a `collect` leaves joins it, whichever statement it is: a
// `match` and an `if` before the last, a list element by element, `[]` nothing, and a collection
// no seat typed is typed by what its arms answer.
enum E { A, B }
fn pick(e: E, k: int) -> List<int> {
    collect {
        match e { .A -> 7, .B -> 8 }
        [k * 10, k * 10 + 1]
        if k > 1 { 3 } else { 4 }
        []
        k
    }
}
fn only(k: int) -> List<string> {
    let xs = collect {
        match k { 1 -> "one", _ -> "many" }
    }
    xs
}
fn sum(xs: List<int>) -> int { xs.fold(0, (a, x) -> a + x) }
let b = pick(E.B, 2)
let a = pick(E.A, 0)
"${b.length} ${b[0]} ${sum(b)} ${a.length} ${a[0]} ${sum(a)} ${only(1)[0]} ${only(5)[0]}"
