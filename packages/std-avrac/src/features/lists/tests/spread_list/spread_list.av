// proves: a list literal spreads lists — written order, one element
// type; the sources are untouched
type Row = { id: int, tags: List<string> }

let xs = [1, 2, 3]
let ys = [10, 20]
let a = [0, ..xs, 4]
let b = [..xs, ..ys]
let c = [..xs]
let d = [..ys, 7, ..xs, 8, 9]
let e: List<int> = [..[], 5]
let ss = ["a", "b"]
let f = [..ss, "c"]
let r = Row { id: 1, tags: ss }
let g = [..r.tags, ..f]
let rows = [Row { id: 1, tags: [] }]
let h = [..rows, Row { id: 2, tags: ["x"] }]
let n = [..xs, 4]
"${a.sum()} ${a.length} ${b.length} ${b[3]} ${c.length} ${d[2]}${d[5]}${d.length} ${e.length} ${e[0]} ${f.join(",")} ${g.join(",")} ${h.length} ${h[1].tags[0]} ${n.length} ${xs.length} ${ys.length}"
