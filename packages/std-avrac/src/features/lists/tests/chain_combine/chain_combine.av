// proves: removed_at and inserted copy a list with one change
let xs = [1, 2, 3, 4]
// LICENSED lists.removed_at_front: this test proves removed_at's own front boundary, never a queue's head
let front = xs.removed_at(0)
println(
    "${xs.removed_at(1).sum()} ${xs.inserted(2, 9).sum()} ${front.sum()} ${xs.inserted(0, 7).sum()}",
)
