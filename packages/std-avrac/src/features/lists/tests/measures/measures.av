// proves: `.length` on FRESH expressions — a walk's answer, a
// map literal, an interpolated string — lowers with its operands
// first (registers define in mint order); the gate now holds the
// class the red team caught.
let xs = [1, 2, 3, 4]
let words = { "a": "x", "b": "yy" }
mut n = 0
mut i = 0
while i < 50 {
    n = n + xs.filter(it > 2).length + [i, i].length + "w${i}".length + { "k": i }.length + (words.get("b") ?? "").length
    i = i + 1
}
"${xs.map(it * 2).length} ${words.length} ${"abc".length} ${n}"
