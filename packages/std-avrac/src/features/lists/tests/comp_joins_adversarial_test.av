// Several `for` heads under attack: the want channel's heir
// contamination (the one real bug this round found), names against
// names, and cross-feature interaction with `?` and `dyn`. The
// vertical story lives in comprehensions_test.av.
use @std.avrac.testing.{shown, refused_with}

fn show_decls() -> string {
    "trait Show {\n    fn show() -> int\n}\ntype P = { x: int, y: int }\nimpl Show for P {\n    fn show() -> int { self.x * 10 + self.y }\n}\n"
}

spec "features/lists/comp_joins/adversarial" {
    given "a head's own source or range bound that is refused" {
        then "the first head's source speaks once" {
            refused_with(
                "enum E { A, B }\nlet x = [1 for c in E.A(1)]\nx.length",
                "`E.A` carries nothing",
            )
        }
        then "a variant spelled `all`, called as the list, speaks once" {
            refused_with(
                "enum E { all, B }\nlet x = [c.ordinal for c in E.all()]\nx.length",
                "`E.all` carries nothing",
            )
        }
        then "the first head's range bound speaks once" {
            refused_with(
                "enum E { A, B }\nlet x = [1 for i in E.A(1)..3]\nx.length",
                "`E.A` carries nothing",
            )
        }
        then "a later head's source speaks once" {
            refused_with(
                "enum E { A, B }\nlet x = [1 for a in [1] for c in E.A(1)]\nx.length",
                "`E.A` carries nothing",
            )
        }
        then "a later head's range bound is typed, and speaks once" {
            refused_with(
                "enum E { A, B }\nlet x = [1 for a in [1] for i in 0..E.A(1)]\nx.length",
                "`E.A` carries nothing",
            )
        }
        then "a later head's range bound that is no int is refused" {
            refused_with(
                "let x = [a + i for a in [10] for i in 0..\"s\"]\nx.length",
                "a range's high bound is a `int`",
            )
        }
        then "a later head's range bound reads the names bound before it" {
            shown(
                "fn two() -> int { 2 }\nlet x = [a + i for a in [10] for i in 0..(two() + a - 10)]\n\"\${x.length} \${x[1]}\"",
            ) == "2 11"
        }
    }
    given "the expected-type channel" {
        then "a dyn want on the whole list does not leak into a later head's own source" {
            shown(
                "${show_decls()}let boxes: List<dyn Show> = [P { x: a, y: b } for a in [1, 2] for b in [3, 4]]\nboxes.length * 100 + boxes[3].show()",
            ) == "424"
        }
        then "nor into a later head's range bound" {
            shown(
                "${show_decls()}let boxes: List<dyn Show> = [P { x: i, y: hi } for i in 0..2 for hi in 0..(i + 3)]\nboxes.length",
            ) == "7"
        }
        then "nor into a filter's condition" {
            shown(
                "${show_decls()}let boxes: List<dyn Show> = [P { x: a, y: 0 } for a in [1, 2, 3] if a % 2 == 1]\nboxes.length",
            ) == "2"
        }
    }
    given "names against names" {
        then "a keyword as a later head's binder" {
            refused_with("[a for a in [1, 2] for mut in [3, 4]]", "`mut` is a keyword")
        }
        then "the index and the element paired alike in a later head" {
            refused_with(
                "[x for a in [1, 2] for x, x in [3, 4]]",
                "`x` names both the index and the element",
            )
        }
        then "a filter reading a name its own head has not bound yet" {
            refused_with(
                "[c for a in [1, 2] if b > 0 for b in [3, 4] for c in [5, 6]]",
                "`b` is not defined",
            )
        }
        then "a later head shadows an earlier one, and the element reads the shadow" {
            shown("[a for a in [1, 2] for a in [10, 20]][3]") == "20"
        }
        then "a later head's source reads the PRE-shadow value, even though its own head rebinds the same name" {
            shown("[a + b for a in [1, 2] for b in [a, a + 1] for i, a in [10, 20]][3]") == "22"
        }
    }
    given "crossed with `?` propagation" {
        then "a filter and a second head both sit between a `?` and the fn it leaves" {
            shown(
                "${halver()}fn f(xs: List<int>, ys: List<int>) -> Result<List<int>, Oddness> {\n    [half(x)? + y for x in xs if x > 0 for y in ys]\n}\nmatch f([2, 3], [10]) {\n    .Ok(_) -> -1,\n    .Err(_) -> 9,\n}",
            ) == "9"
        }
    }
}
