// proves: a list crosses a FUNCTION BOUNDARY — `List<int>` as a
// param and as a return, which the type surface could not spell
// before annotations became type expressions
fn total(xs: List<int>) -> int {
    mut t = 0
    mut i = 0
    while i < xs.length {
        t = t + xs[i]
        i = i + 1
    }
    t
}

fn evens() -> List<int> {
    [2, 4, 6, 8]
}

fn widest(xs: List<int>) -> int {
    mut best = xs[0]
    mut i = 1
    while i < xs.length {
        best = if xs[i] > best { xs[i] } else { best }
        i = i + 1
    }
    best
}

fn flags() -> List<bool> {
    [true, false, true]
}

fn any_set(bs: List<bool>) -> bool {
    bs[0] || bs[1] || bs[2]
}

// a returned list, handed straight into another fn
let sum = total(evens())
"sum ${sum} max ${widest(evens())} len ${evens().length} any ${any_set(flags())}"
