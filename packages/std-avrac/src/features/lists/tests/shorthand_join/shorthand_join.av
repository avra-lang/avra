// proves: a list written with no type takes its elements' joined type, and a variant written by its
// name alone takes that type wherever it stands — first, after, carrying a payload, in a `const` a
// comprehension walks — in both engines
enum Font { Body, Heading, Mono }
enum Shape { Dot, Circle(r: int), Square(side: int) }

const fonts = [Font.Body, .Heading, .Mono]

fn area(s: Shape) -> int {
    match s { .Dot -> 0, .Circle(r) -> 3 * r * r, .Square(side) -> side * side }
}

fn faces() -> string { ["${f.ordinal}" for f in fonts].join(",") }

fn shapes() -> int {
    let all = [.Dot, Shape.Circle(2), .Square(3)]
    [area(s) for s in all].sum()
}

"${faces()} ${shapes()} ${[.Mono, Font.Body].length}"
