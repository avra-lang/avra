// proves: a literal holding `null` is a list of the nullable, and the
// scans compare through presence — text by its content
fn show(x: int?) -> string {
    match x {
        null -> "-"
        v? -> "${v}"
    }
}
let xs = [null, 7, null, 3]
let ws = ["a" + "b", null]
let m = {"x": null, "y": "why"}
"${[show(x) for x in xs].join(",")} ${xs.contains(null)} ${xs.contains(3)} ${xs.contains(4)} ${xs.index_of(7)} ${xs.index_of(null)} ${ws.contains("ab")} ${ws.index_of(null)} ${m.get("x") != null} ${(m.get("y") ?? null) ?? "-"}"
