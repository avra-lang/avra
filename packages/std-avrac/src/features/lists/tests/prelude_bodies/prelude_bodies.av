// proves: a verb the prelude writes a body for runs that body — a list's
// copy without one place, at either edge and between; each owned type's
// emptiness; a map's entries in insertion order, each key beside its value.
let xs = [1, 2, 3, 4]
let mid = xs.removed_at(1)
// LICENSED lists.removed_at_front: this test exercises `removed_at` at the front edge
let head = xs.removed_at(0)
let tail = xs.removed_at(3)
let words = ["a", "b"].removed_at(1)
mut m: Map<string, string> = {}
let blank = m.is_empty()
m.set("b", "2")
m.set("a", "1")
let es = m.entries()
let none: List<int> = []
"${mid.length}:${mid[1]} ${head[0]} ${tail.length}:${tail[2]} ${words.length}:${words[0]} ${xs.length} ${none.is_empty()} ${xs.is_empty()} ${"".is_empty()} ${"x".is_empty()} ${"".bytes().is_empty()} ${blank} ${m.is_empty()} ${es.length} ${es[0].key}=${es[0].value} ${es[1].key}=${es[1].value}"
