// proves: a place a chain answers is a place in the stream its sink
// sees — past a filter, a drop, a flatten and a string's code points —
// never the source's own count.
let xs = [5, 6, 7]
let kept = xs.filter(it > 5).find_index(it == 7) ?? -1
let kept_of = xs.filter(it > 5).index_of(7)
let dropped = xs.drop(1).find_index(it == 7) ?? -1
let flat = [[1], [2, 3]].flatten().index_of(3)
let plain = xs.index_of(7) * 10 + (xs.find_index(it == 6) ?? -1)
let wide = "h€y".chars().find_index(it == 121) ?? -1
let wide_of = "h€y".chars().index_of(121)
let mapped = "h€y".chars().map(it + 1).find_index(it == 122) ?? -1
let none = xs.filter(it > 9).index_of(7)
"${kept} ${kept_of} ${dropped} ${flat} ${plain} ${wide} ${wide_of} ${mapped} ${none}"
