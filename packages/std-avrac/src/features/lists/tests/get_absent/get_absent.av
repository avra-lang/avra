// proves: `xs.get(i)` answers the element inside the list and absence
// outside it — past the end, before the start, and on an empty list —
// where `xs[i]` traps. A PRESENT null in a `List<int?>` stays apart
// from the absence past its end.
fn nth(xs: List<string>, i: int) -> string { xs.get(i) ?? "-" }

fn word(v: int?) -> string { if v == null { "null" } else { "present" } }

fn told(xs: List<int?>, i: int) -> string {
    match xs.get(i) {
        held? -> word(held)
        null -> "gone"
    }
}

let xs = [1, 2, 3]
let ws = ["a", "b", "c"]
let none: List<int> = []
let opts: List<int?> = [null, 4]
let nested = [[1], [2, 3]]
let ints = "${xs.get(0) ?? -1} ${xs.get(2) ?? -1} ${xs.get(3) ?? -1} ${xs.get(-1) ?? -1} ${none.get(0) ?? -1}"
let texts = "${nth(ws, 1)} ${nth(ws, 3)} ${nth(ws, -9223372036854775807)}"
let holes = "${told(opts, 0)} ${told(opts, 1)} ${told(opts, 2)}"
"${ints} | ${texts} | ${holes} | ${nested.get(1)?.length ?? 0} ${nested.get(2)?.length ?? 0} ${xs.filter(it > 1).get(1) ?? -1}"
