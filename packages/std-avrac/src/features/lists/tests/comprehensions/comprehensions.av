// proves: comprehensions — element, filter, index binder, a call as
// the source, nesting, and text elements — natively
fn seed() -> List<int> {
    [4, 5, 6]
}
let doubled = [x * 2 for x in [1, 2, 3]]
let evens = [x for x in [1, 2, 3, 4, 5, 6] if x % 2 == 0]
let indexed = [i * 100 + x for i, x in seed()]
let grid = [[x * y for y in [1, 2]] for x in [10, 20]]
let words = ["${x}!" for x in ["a", "bc"]]
let paired = [i * 100 + x for i, x in seed()]
let squares = [i * i for i in 0..5]
let odds = [i for i in 0..10 if i % 2 == 1]
let cells = [[x * 10 + y for y in 0..2] for x in 1..3]
let none = [i for i in 3..3]
let blanks = ["", "x", "".substring(0, 0)]
doubled[2] + evens.length + indexed[1] + grid[1][1] + words[1].length + paired[2] + squares[4] + odds[4] + cells[1][1] + none.length + [b for b in blanks if b.is_empty()].length
