// proves: count, sum, min and max fold over a chain — one loop, no list
let xs = [1, 2, 3, 4, 5, 6]
let evens = xs.filter((x: int) -> x % 2 == 0).map((x: int) -> x * 10).sum()
let over = xs.filter((x: int) -> x > 3).count()
let squares = xs.map((x: int) -> x * x).sum()
let lo = xs.min()
let hi = xs.max()
let none = xs.filter((x: int) -> x > 100).min()
println("${evens} ${over} ${squares} ${lo ?? -1} ${hi ?? -1} ${none ?? -1}")
println(
    "L ${xs.min_by((x: int) -> x) ?? -1} ${xs.max_by((x: int) -> x) ?? -1} ${xs.filter((x: int) -> x > 100).min_by((x: int) -> x) ?? -1}",
)
println("M ${xs.find_last((x: int) -> x < 5) ?? -1} ${xs.find_last((x: int) -> x > 100) ?? -1}")
