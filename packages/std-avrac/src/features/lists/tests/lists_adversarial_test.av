// The list vocabulary's GROWTH word under attack: `push` at every
// wrong seat, its void answer in every value position, and
// ownership through copy-on-write under churn (rt28). The vertical
// story lives in lists_test.av.
use @std.avrac.testing.{shown, refused_with, refusals}

spec "features/lists/adversarial" {
    given "push at every wrong seat" {
        then "two arguments" {
            refused_with("mut xs = [1]\nxs.push(1, 2)\n2", "`push` takes 1 arguments, found 2")
        }
        then "no argument" {
            refused_with("mut xs = [1]\nxs.push()\n2", "found 0")
        }
        then "a non-list receiver falls to the method table" {
            refused_with("mut n = 1\nn.push(2)\n2", "`int` has none")
        }
        then "an empty declared list grows" {
            shown("mut xs: List<int> = []\nxs.push(1)\nxs[0]") == "1"
        }
        then "an empty nested list grows through its path" {
            shown("mut g: List<List<int>> = [[]]\ng[0].push(7)\ng[0][0]") == "7"
        }
    }
    given "void in every value position — one refusal each" {
        then "an interpolation hole" {
            refusals("mut xs = [1]\n\"" + "\${xs.push(1)}\"") == 1
        }
        then "an operand" {
            refused_with("mut xs = [1]\nxs.push(1) + 1", "found `void`")
        }
        then "a condition" {
            refused_with("mut xs = [1]\nif xs.push(1) { 1 } else { 2 }", "found `void`")
        }
        then "a list element" {
            refused_with("mut xs = [1]\n[xs.push(1)]\n2", "cannot hold nothing")
        }
        then "an argument" {
            refused_with(
                "mut xs = [1]\nfn f(k: int) -> int {\n    k\n}\nf(xs.push(1))",
                "found `void`",
            )
        }
        then "a fn tail" {
            refused_with(
                "fn f() -> int {\n    mut xs = [1]\n    xs.push(1)\n}\nf()",
                "answers `void`",
            )
        }
        then "a mut binding" {
            refused_with("mut xs = [1]\nmut m = xs.push(1)\n2", "answers nothing")
        }
    }
    given "ownership through growth" {
        then "two thousand pushed strings" {
            shown(
                "mut xs: List<string> = []\nmut i = 0\nwhile i < 2000 {\n    xs.push(\"s" +
                    "\${i}\")\n    i = i + 1\n}\n\"" +
                    "\${xs.length} " +
                    "\${xs[1999]}\"",
            ) == "2000 s1999"
        }
        then "a snapshot survives three hundred copy-on-write pushes" {
            shown(
                "mut g: List<List<string>> = [[\"a\"]]\nlet snap = g\nmut i = 0\nwhile i < 300 {\n    g[0].push(\"x" +
                    "\${i}\")\n    i = i + 1\n}\n\"" +
                    "\${g[0].length} " +
                    "\${snap[0].length}\"",
            ) == "301 1"
        }
        then "a list slot overwritten five hundred times releases each old list" {
            shown(
                "type Q = { xs: List<string> }\nmut q = Q { xs: [\"a\"] }\nmut i = 0\nwhile i < 500 {\n    q.xs = [\"b" +
                    "\${i}\", \"c\"]\n    i = i + 1\n}\n\"" +
                    "\${q.xs[0]} " +
                    "\${q.xs.length}\"",
            ) == "b499 2"
        }
    }
    given "names against names — the comprehension's head" {
        then "a pair names two distinct binders, as the for statement's does" {
            refused_with("[i for i, i in [1, 2]]", "`i` names both the index and the element") &&
                refused_with("[i for (i, i) in [1, 2]]", "`i` names both the index and the element")
        }
    }
}
