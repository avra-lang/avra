// proves: a method chain is ONE loop, per element in order — the
// receiver lowers first, then each element runs keep and map before
// the next enters (not all keeps, then all maps)
fn rows() -> List<int> {
    println("recv")
    [1, 2, 3]
}

fn keep(x: int) -> bool {
    println("keep ${x}")
    x > 1
}

fn double(x: int) -> int {
    println("map ${x}")
    x * 2
}

let out = rows().filter(keep).map(double)
println("len ${out.length}")
