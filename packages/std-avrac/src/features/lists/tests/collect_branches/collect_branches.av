// pins: `collect` gathers every statement a branch of an `if` leaves —
// each of an else-less guard, an if/else and an else-if chain, a binding
// `if` over an enum, and an `if` that stands last in the body.
enum Shape {
    Dot(int)
    Gone
}

fn joined(xs: List<int>) -> string { xs.map("${it}").join(",") }

fn plain(n: int) -> List<int> {
    collect {
        if n > 0 {
            1
            2
        } else {
            3
        }
        if n > 5 {
            10
        } else if n > 2 {
            20
        } else {
            30
        }
        if n > 100 {
            99
        }
        for i in 0..2 {
            if i == 1 {
                i * 7
            }
        }
    }
}

fn bound(s: Shape) -> List<int> {
    collect {
        if s is .Dot(v) {
            v
            v + 1
        } else {
            5
        }
    }
}

fn last(n: int) -> List<int> {
    collect {
        4
        if n > 0 {
            40
            41
        } else {
            42
        }
    }
}

"${joined(plain(3))} | ${joined(plain(0))} | ${joined(bound(.Dot(2)))} | ${joined(bound(.Gone))} | ${joined(last(1))} | ${joined(last(0))}"
