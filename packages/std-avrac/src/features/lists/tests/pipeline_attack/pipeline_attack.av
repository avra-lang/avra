// proves: a comprehension's pipeline under the shapes that stress its
// nesting — a comprehension in a head's source, in a filter and in the
// element; a lambda element capturing two heads' binders; empty and
// backwards sources at every depth; managed elements built per turn;
// an index head below a range head; a comprehension inside a lambda
// inside a comprehension; and one feeding `any`
let none: List<int> = []
let words = ["ab", "c", "def"]
let in_source = [y * 10 for y in [x + 1 for x in [1, 2]]]
let in_filter = [x for x in [1, 2, 3, 4] if [y for y in [2, 4] if y == x].length > 0]
let in_elem = [[y for y in 0..x] for x in [0, 1, 2, 3]]
let fns = [(z: int) -> z + x * 10 + k for x in [1, 2] for k in 0..2]
let applied = [f(100) for f in fns]
let empty_outer = [x + y for x in none for y in [1, 2]]
let empty_inner = [x + y for x in [1, 2] for y in none]
let backwards = [k for k in 5..2]
let empty_mid = [x for x in [1, 2] for k in 0..0 for y in [7]]
let texts = ["${w}${i}" for i, w in words if w.length > 1]
let nested_texts = [[w + v for v in words] for w in words]
let below_range = [k * 100 + i * 10 + x for k in 0..2 for i, x in [5, 6]]
let lifted = [((n: int) -> [m * n for m in 0..n])(x).length for x in [1, 3]]
let found = [x * 2 for x in [1, 2, 3] if x > 1].any(it == 6)
let shadow = [x for x in [1, 2] for x in [x * 10, x * 100]]
fn ints(xs: List<int>) -> string {
    ["${v}" for v in xs].join(",")
}
[
    ints(in_source),
    ints([n.length for n in in_elem]),
    ints(in_filter),
    ints(applied),
    "${empty_outer.length} ${empty_inner.length} ${backwards.length} ${empty_mid.length}",
    texts.join(","),
    [n.join("+") for n in nested_texts].join(","),
    ints(below_range),
    ints(lifted),
    "${found}",
    ints(shadow),
]
    .join("|")
