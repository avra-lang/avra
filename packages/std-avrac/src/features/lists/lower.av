//! A list lowers as the runtime aggregate: one `avra_array_new`,
//! then a push per element — the CallRt escape hatch carrying the
//! whole feature, zero new instructions.
use core.{ExprId, Reg, Ins, TypeId}
use features.{void_arm, void_close, push_slot, LowerCx, grown_box}

fn list_reg(mut cx: LowerCx, e: ExprId, elems: List<ExprId>) -> Reg {
    let regs = [cx.reg_of(k) for k in elems]
    let dst = cx.result(e)
    grown_box(cx, dst, regs)
    dst
}

/// THE COMPREHENSION LOWERED: a fresh box, then the walks' loop
/// over the source — each turn binds the element (and its index)
/// for the element expression and the filter, and pushes the
/// element when the filter holds.
fn comp_reg(mut cx: LowerCx, e: ExprId, elem: ExprId, index: string, source: ExprId, cond: ExprId?) -> Reg {
    let dst = cx.result(e)
    grown_box(cx, dst, [])
    let w = opened(cx, source, elem_type(cx, source))
    turn_open(cx, w)
    let here = turn_index(cx, w)
    let v = turn_elem(cx, w, here)
    let regs = if index == "" { [v] } else { [here, v] }
    cx.bind_patterns(elem, regs)
    if cond != null {
        cx.bind_patterns(cond!, regs)
        cx.emit(Ins.IfStart(cx.reg_of(cond!)))
        push_slot(cx, dst, cx.reg_of(elem))
        void_arm(cx)
        void_close(cx)
    } else {
        push_slot(cx, dst, cx.reg_of(elem))
    }
    turn_close(cx, w)
    dst
}

/// The source's element type — typing proved it a list.
fn elem_type(mut cx: LowerCx, source: ExprId) -> TypeId {
    let held: TypeId? = cx.view.types.element(cx.type_at(source))
    held ?? cx.type_at(source)
}
