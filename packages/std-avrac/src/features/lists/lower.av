//! A list lowers as the runtime aggregate: one `avra_array_new`,
//! then a push per element — the CallRt escape hatch carrying the
//! whole feature, zero new instructions.
use core.{ExprId, Reg, TypeId}
use features.{void_arm, void_close, push_slot, LowerCx, grown_box, open_region, opened, counted, turn_open, turn_index, turn_elem, turn_close, box_size}

fn list_reg(mut cx: LowerCx, e: ExprId, elems: List<ExprId>) -> Reg {
    let regs = [cx.reg_of(k) for k in elems]
    let size = box_size(cx, regs.length)
    let dst = cx.result(e)
    grown_box(cx, dst, size, regs)
    dst
}

/// THE COMPREHENSION LOWERED: a fresh box, then the walks' loop —
/// over the source list, or counting the range — each turn binds
/// the element (and its index) for the element expression and the
/// filter, and pushes the element when the filter holds.
fn comp_reg(mut cx: LowerCx, e: ExprId, elem: ExprId, index: string?, source: ExprId, hi: ExprId?, cond: ExprId?) -> Reg {
    let size = box_size(cx, 0)
    let dst = cx.result(e)
    grown_box(cx, dst, size, [])
    let w = if hi == null { opened(cx, source, elem_type(cx, source)) } else { counted(cx, source, hi!) }
    turn_open(cx, w)
    let here = turn_index(cx, w)
    let v = if hi == null { turn_elem(cx, w, here) } else { here }
    let regs = if index == null { [v] } else { [here, v] }
    cx.bind_patterns(elem, regs)
    if cond != null {
        cx.bind_patterns(cond!, regs)
        open_region(cx, cx.reg_of(cond!))
        push_slot(cx, dst, cx.reg_of(elem))
        void_arm(cx)
        void_close(cx)
    } else {
        push_slot(cx, dst, cx.reg_of(elem))
    }
    turn_close(cx, w)
    dst
}

/// The source's element type — typing proved it a list.
fn elem_type(cx: LowerCx, source: ExprId) -> TypeId {
    let held: TypeId? = cx.view.types.element(cx.type_at(source))
    held ?? cx.type_at(source)
}
