//! The list literal's NodeSemantics — dispatch one-liners; the rule
//! bodies live beside this file, by concern.
use core.{Expr, ExprId, TypeId, NodeStore, Reg, Type, elems_of, joined}
use features.{NodeSemantics, ResolveCx, TypeCx, LowerCx, nothing, scalar_text}

export type ListSemantics = { }

impl NodeSemantics for ListSemantics {
    fn kids(self, e: Expr) -> List<ExprId> {
        let elems: List<ExprId> = elems_of(e) ?? []
        elems
    }

    fn resolve(self, cx: ResolveCx, e: ExprId) {
        nothing()
    }

    fn type_of(self, cx: TypeCx, e: ExprId) -> TypeId {
        let elems: List<ExprId>? = elems_of(cx.store.expr(e))
        if elems == null { return cx.intern(Type.Error) }
        list_type(cx, e, elems!)
    }

    fn lower(self, cx: LowerCx, e: ExprId) -> Reg {
        let elems: List<ExprId>? = elems_of(cx.store.expr(e))
        list_reg(cx, e, elems ?? [])
    }

}
