//! The list literal's NodeSemantics — dispatch one-liners; the rule
//! bodies live beside this file, by concern.
use core.{Expr, ExprId, TypeId, Reg, elems_of}
use features.{NodeSemantics, ResolveCx, TypeCx, LowerCx, nothing}
use diagnostics.{refusal}

export type ListSemantics = { }

impl NodeSemantics for ListSemantics {
    /// A literal's elements are kids; a comprehension's SOURCE and
    /// range bound are — they resolve outside the binders — while
    /// its element and filter are heirs, walked under them.
    fn kids(e: Expr) -> List<ExprId> {
        // a feature cannot enumerate OTHER features' variants
        match e {
            .Comp(_, _, _, source, hi, _) -> if hi == null { [source] } else { [source, hi!] },
            // LICENSED I18: kids() has no failure channel; [] is the right answer for a node that is not a list
            _ -> elems_of(e) ?? [],
        }
    }

    fn heirs(e: Expr) -> List<ExprId> {
        // a feature cannot enumerate OTHER features' variants
        match e {
            .Comp(elem, _, _, _, _, cond) -> if cond == null { [elem] } else { [elem, cond!] },
            _ -> [],
        }
    }

    fn resolve(mut cx: ResolveCx, e: ExprId) {
        // a feature cannot enumerate OTHER features' variants
        match cx.view.store.expr(e) {
            .Comp(elem, index, name, _, _, cond) -> resolve_comp(cx, e, elem, index, name, cond),
            _ -> nothing(),
        }
    }

    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        // a feature cannot enumerate OTHER features' variants
        match cx.view.store.expr(e) {
            .Comp(elem, index, _, source, hi, cond) -> comp_type(cx, e, elem, index, source, hi, cond),
            _ -> literal_type(cx, e),
        }
    }

    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        // a feature cannot enumerate OTHER features' variants
        match cx.view.store.expr(e) {
            .Comp(elem, index, _, source, hi, cond) -> comp_reg(cx, e, elem, index, source, hi, cond),
            _ -> literal_reg(cx, e),
        }
    }

}

/// The binders — `index, name` in that order, or the name alone —
/// hold for the element and the filter, each under its own scope.
/// A pair names them apart, as the `for` statement's does.
fn resolve_comp(mut cx: ResolveCx, e: ExprId, elem: ExprId, index: string?, name: string, cond: ExprId?) {
    if index == name { paired_alike(cx, e, name) }
    let names = comp_binds(index, name)
    cx.arm_scope(names, elem)
    if cond != null { cx.arm_scope(names, cond!) }
}

/// The binder names in pre-order: the index first when written.
export fn comp_binds(index: string?, name: string) -> List<string> {
    if index == null { return [name] }
    [index!, name]
}

fn paired_alike(mut cx: ResolveCx, e: ExprId, name: string) {
    cx.emit(refusal("resolve.paired", cx.view.loc_of(e), "`${name}` names both the index and the element", "bound here", "give the index its own name — `for i, ${name} in …`"))
}

fn literal_type(mut cx: TypeCx, e: ExprId) -> TypeId {
    let elems: List<ExprId>? = elems_of(cx.view.store.expr(e))
    if elems == null { return cx.error_type }
    list_type(cx, e, elems!)
}

fn literal_reg(mut cx: LowerCx, e: ExprId) -> Reg {
    let elems: List<ExprId>? = elems_of(cx.view.store.expr(e))
    if elems == null { return cx.lower_defect(e, "a list literal without its elements") }
    list_reg(cx, e, elems!)
}
