// proves: a derive's fn NAMED through a hole still reads its signature's
// types where the template was written (`Rows`, imported by the
// template alone), where the code lands (`Tag`, declared here alone),
// and among the declarations the same expansion generated (`PKey`).
use @std.meta.{derive}
use @test.keyed.{Keyed}
use @test.keyed.rows.{rows_of}

type Tag = { of: string }

@derive(Keyed)
type P = { a: string, n: int }

let rs = rows_of([P { a: "x", n: 1 }, P { a: "y", n: 2 }])
let hit = P.by_a(rs, "y")?.n ?? 0
let key = P.by_a_key(P { a: "x", n: 1 })?.a ?? "none"
let tag = P.by_a_tag(P { a: "z", n: 3 }).of
"${hit}|${key}|${tag}"
