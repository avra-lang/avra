use @std.meta.{Type, Directive}

export trait Tr {
    fn pick(arena: Arena) -> int

    static fn derive(t: Type) -> List<Directive> {
        [
            Directive {
                twin: "",
                name: t.name,
                at: t.at,
                source: quote {
                    impl Tr for ${t} {
                        fn pick(arena: Arena) -> int { arena.n }
                    }
                },
            },
        ]
    }
}

/// Unreached by `derive`: it calls methods of the very type being annotated.
export fn unrelated(a: Arena) -> int { a.double() + a.triple() }
