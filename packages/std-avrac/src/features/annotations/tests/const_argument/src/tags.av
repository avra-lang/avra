use @std.meta.{Fn, Directive}

/// A twin named by the text argument.
export fn tag(f: Fn, label: string) -> List<Directive> {
    [Directive { twin: "${f.name}_${label}", name: f.name, at: f.at }]
}

/// A twin named by the int argument.
export fn tag_n(f: Fn, n: int) -> List<Directive> {
    [Directive { twin: "${f.name}_n${n}", name: f.name, at: f.at }]
}

/// A twin named by the bool argument.
export fn tag_b(f: Fn, b: bool) -> List<Directive> {
    [Directive { twin: if b { "${f.name}_yes" } else { "${f.name}_no" }, name: f.name, at: f.at }]
}

/// A twin named by the float argument's side of one.
export fn tag_f(f: Fn, x: float) -> List<Directive> {
    [Directive { twin: if x > 1.0 { "${f.name}_big" } else { "${f.name}_small" }, name: f.name, at: f.at }]
}
