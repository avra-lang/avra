// proves: a declaring annotation's argument may name a const whose
// value is a literal — of every scalar kind, through a chain of
// consts, declared after its use, or imported from another module —
// and the generated twin carries that value in its name.
use far.{Far}

const Label = "s"
const Count = 7
const On = true
const Scale = 2.5
const Deep = "deep"
const Middle = Deep
const Top = Middle

@tag(Label)
@tag_n(Count)
@tag_b(On)
@tag_f(Scale)
fn one() -> int { 1 }

@tag(Top)
fn two() -> int { 2 }

@tag(Late)
fn three() -> int { 3 }

@tag(Far)
fn four() -> int { 4 }

const Late = "late"

one_s() + one_n7() + one_yes() + one_big() + two_deep() + three_late() + four_far()
