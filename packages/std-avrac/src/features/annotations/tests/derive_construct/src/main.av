// proves: a CROSS-PACKAGE derive can build a FULL STRUCT LITERAL of
// its annotated type (`${t} { field: value, ... }`, every field named)
// — the struct literal's head resolves against the ANNOTATED type's
// own file, never the derive's. Also proves a cross-package `with{}`
// copy-update and a SAME-PACKAGE full struct literal still work — the
// fix must not narrow either.
use @std.meta.{derive}
use @test.ctor.{Ctor}
use local_ctor.{LocalCtor}

@derive(Ctor)
type Pair = { a: int, b: string }

@derive(LocalCtor)
type Local = { a: int, b: string }

let made = Pair.made(Pair { a: 1, b: "x" })
let moved = made.moved("y")
let local = Local.made(Local { a: 2, b: "z" })
"${made.a}|${made.b}|${moved.a}|${moved.b}|${local.a}|${local.b}"
