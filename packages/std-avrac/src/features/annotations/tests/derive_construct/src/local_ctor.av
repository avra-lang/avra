use @std.meta.{Type, Directive}

/// The SAME shape as `@test.ctor.Ctor`, declared in this package's own
/// (other) file — the same-package sibling this test's cross-package
/// case must not narrow.
export trait LocalCtor {
    static fn derive(t: Type) -> List<Directive> {
        let fs = t.fields
        [Directive { twin: "", name: t.name, at: t.at, source: quote { impl ${t} { static fn made(x: ${t}) -> ${t} { ${t} { ${fs[0].name}: x.${fs[0].name}, ${fs[1].name}: x.${fs[1].name} } } } } }]
    }
}
