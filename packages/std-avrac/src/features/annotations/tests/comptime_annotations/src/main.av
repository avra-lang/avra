use @std.meta.{Fn, Type, Diagnostic, refuse}

fn named(f: Fn, want: string) -> List<Diagnostic> {
    if f.name == want && f.params.length == 2 && f.params[0].name == "left" &&
       f.params[0].ty == "int" && f.params[1].name == "right" && f.answer == "int" {
        []
    } else {
        [refuse("wrong fn metadata for `${f.name}`")]
    }
}

fn two_fields(t: Type) -> List<Diagnostic> {
    if t.name == "Pair" && t.fields.length == 2 && t.fields[0].name == "left" &&
       t.fields[0].ty == "int" && t.fields[1].ty == "string" {
        []
    } else {
        [refuse("wrong type metadata for `${t.name}`")]
    }
}

fn two_variants(t: Type) -> List<Diagnostic> {
    if t.name == "Choice" && t.variants.length == 2 && t.variants[0].name == "None" &&
       t.variants[1].name == "Some" && t.variants[1].payload.length == 2 {
        []
    } else {
        [refuse("wrong enum metadata for `${t.name}`")]
    }
}

fn deprecated(f: Fn, note: string) {
}

fn threshold(f: Fn, value: float) -> List<Diagnostic> {
    if value > 1.4 { [] } else { [refuse("float argument did not cross")] }
}

type Bounds = { low: int, high: int }
type Policy = {
    bounds: Bounds,
    labels: List<string>,
    weights: Map<string, int>,
    note: string?,
}

fn configured(f: Fn, p: Policy) -> List<Diagnostic> {
    let hot = p.weights.get("hot") ?? 0
    if f.name == "sum" && p.bounds.low == 2 && p.bounds.high == 9 &&
       p.labels.length == 2 && p.labels[1] == "right" && hot == 7 && p.note == null {
        []
    } else {
        [refuse("aggregate argument did not cross")]
    }
}

@named("sum")
@deprecated("use add")
@threshold(1.5)
@configured(Policy {
    bounds: Bounds { low: 2, high: 9 },
    labels: ["left", "right"],
    weights: { "hot": 7 },
    note: null,
})
fn sum(left: int, right: int) -> int {
    left + right
}

@two_fields
type Pair = { left: int, right: string }

@two_variants
enum Choice {
    None
    Some(int, string)
}

"${sum(2, 3)} ${Pair { left: 7, right: "ok" }.right}"
