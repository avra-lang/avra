// proves: an annotation carries the identity of the fn it names, `decl` builds that fn as a `Fn` when
// asked, and `marks` asks which fn by its declaration: the provider's `once` worn under another name
// is it, a local fn of the same name is not, and a pair annotated by each other reads one by one.
use @std.meta.{derive}
use @test.declreader.{DeclReader, once as single, ping}

fn yes(n: int) -> bool { n == 0 }

fn once(v: int) -> int { v + 1 }

@derive(DeclReader)
type T = { @yes n: int, @single m: int, @once k: int, @ping p: int }

let t = T { n: 0, m: 1, k: 2, p: 3 }
t.crossed()
