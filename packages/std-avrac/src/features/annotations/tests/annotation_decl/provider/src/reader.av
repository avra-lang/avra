//! Reads the fn each field annotation names, and asks whether it is this package's `once`, so the
//! program shows what crossed.
use @std.meta.{Type, Field, Annotation, Directive, literal, marks, decl, reads_rules}

/// A rule this package declares, asked after by identity.
export fn once(v: int) -> int { v }

/// Two rules each annotated with the other: a mark read through a mark is built only as it is asked.
@pong
export fn ping(v: int) -> int { v }

@ping
export fn pong(v: int) -> int { v }

@reads_rules
export trait DeclReader {
    static fn derive(t: Type) -> List<Directive> {
        let shown = [field_shown(f) for f in t.fields].join(" | ")
        [
            Directive {
                twin: "",
                name: t.name,
                at: t.at,
                source: quote { impl ${t} { fn crossed() -> string { ${literal(shown)} } } },
            },
        ]
    }

}

fn field_shown(f: Field) -> string { [shown(f.name, a) for a in f.annotations].join(" | ") }

/// A field's annotation as `field.name: answer once? inner`: its fn's answer, whether it is `once`,
/// and its fn's own first annotation with that one's fn's answer, each fn built as it is asked for.
fn shown(field: string, a: Annotation) -> string {
    let d? = decl(a) else { return "${field}.${a.name}: none" }
    let inner = d.annotations.first()
    let held = if inner == null { "-" } else { "${inner!.name}:${decl(inner!)?.answer ?? "none"}" }
    "${field}.${a.name}: ${d.answer} ${marks(a, once)} ${held}"
}
