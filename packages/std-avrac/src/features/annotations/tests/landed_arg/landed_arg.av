// proves: a type argument a generator's hole names is the one where the code lands, even where the
// template's own module declares a type of that name.
use @std.meta.{derive}
use features.annotations.tests.landed_arg.gen.{ArgNamed}

@derive(ArgNamed)
type Slot = { n: int }

"${counted([Slot { n: 2 }, Slot { n: 5 }])}"
