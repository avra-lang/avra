use @std.meta.{Type, Directive, beside}

/// The template module's own `Slot`, which no hole's type is.
type Slot = { hidden: string }

/// A fn whose seat's type argument a hole names.
export trait ArgNamed {
    static fn derive(t: Type) -> List<Directive> { [beside(t, quote { fn counted(vs: List<${t}>) -> int { vs.fold(0, (a, v) -> a + v.n) } })] }
}
