// proves: an arm's binder a hole names never captures a read the template wrote — the payload `r`
// and the seat `r` are two names, so `holds(Op.Ret(3), 5)` compares 3 with 5.
use @std.meta.{derive}

@derive(Holds)
enum Op {
    Ret(r: int)
    Other(r: int)
}

"${holds(Op.Ret(3), 5)} ${holds(Op.Ret(5), 5)} ${holds(Op.Other(4), 5)}"
