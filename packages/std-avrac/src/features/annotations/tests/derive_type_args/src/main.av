// proves: a derive's template names ITS OWN package's generic around
// the annotated type — `Rows<${t}>`, `List<${t}>`, `${t}?`,
// `Map<string, ${t}>`, in parameter and return seats — and the head
// resolves where the template was written, so this file imports the
// trait alone, never `Rows`.
use @std.meta.{derive}
use @test.rows.{Stored}

@derive(Stored)
type Item = { a: string, n: int }

let rows = Item.store([Item { a: "x", n: 1 }, Item { a: "y", n: 2 }])
let hit = Item.by_a(rows, "y")?.n ?? 0
let miss = Item.by_a(rows, "z")?.n ?? 0
let keyed = Item.keyed(rows).get("x")?.n ?? 0
"${hit}|${miss}|${keyed}"
