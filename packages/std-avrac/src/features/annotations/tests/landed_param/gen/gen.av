use @std.meta.{Type, Directive, beside}

/// The template module's own `Slot`, which no hole's type is.
type Slot = { hidden: string }

/// A fn whose seat's type a hole names.
export trait SeatNamed {
    static fn derive(t: Type) -> List<Directive> { [beside(t, quote { fn seated(v: ${t}) -> int { v.n * 10 } })] }
}
