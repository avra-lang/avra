// proves: a seat's type a generator's hole names is the one where the code lands, even where the
// template's own module declares a type of that name.
use @std.meta.{derive}
use features.annotations.tests.landed_param.gen.{SeatNamed}

@derive(SeatNamed)
type Slot = { n: int }

"${seated(Slot { n: 4 })}"
