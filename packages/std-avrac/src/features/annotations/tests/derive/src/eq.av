// `Eq` rides the same mechanism: one trait, one associated `derive`,
// generated source admitted beside the type.
use @std.meta.{Type, Directive}

trait Eq {
    static fn derive(t: Type) -> List<Directive> {
        let checks = ["self.${f.name} == other.${f.name}" for f in t.fields]
        [Directive { twin: "", name: t.name, at: t.at,
                     code: quote { impl ${t.name} { fn eq(other: ${t.name}) -> bool { ${checks.join(" && ")} } } } }]
    }
}
