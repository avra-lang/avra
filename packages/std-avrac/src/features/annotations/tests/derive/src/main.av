// proves: `@derive(Show, Eq)` from @std/derive generates impls on a
// struct AND an enum (payloads included), parses the source the traits
// answer into this file's store, and runs them
use @std.meta.{derive}
use @std.derive.{Show, Eq}

@derive(Show)
@derive(Eq)
type Point = { x: int, y: string }

@derive(Show)
@derive(Eq)
enum Color { Red, Green, Rgb(int, int, int) }

let a = Point { x: 1, y: "hi" }
let b = Point { x: 1, y: "hi" }
"${a.show()} / ${Color.Green.show()} / ${a.eq(b)} / ${Color.Rgb(1, 2, 3).eq(Color.Rgb(1, 2, 3))} / ${Color.Rgb(1, 2, 3).eq(Color.Red)}"
