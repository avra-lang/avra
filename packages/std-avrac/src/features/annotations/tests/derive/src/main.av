// proves: `@derive(Show)` generates an impl on a struct AND an enum,
// parses the source the trait answers into this file's store, and runs
use @std.meta.{derive}

@derive(Show)
type Point = { x: int, y: string }

@derive(Show)
enum Color { Red, Green }

Point { x: 1, y: "hi" }.show() + " / " + Color.Green.show()
