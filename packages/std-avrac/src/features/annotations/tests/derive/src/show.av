// A trait ships its own derive: the compiler runs this over the
// annotated declaration and admits the SOURCE it answers beside it.
use @std.meta.{Named, Directive}

trait Show {
    static fn derive(what: Named) -> List<Directive> {
        [Directive { twin: "", name: what.name, at: what.at,
                     code: "impl " + what.name + " { fn show() -> string { \"shown " + what.name + "\" } }" }]
    }
}
