// A MARK on a declared MEMBER — a variant, a payload — is DATA: it is
// recorded on the member it precedes and nothing runs. The compiler
// judges no mark's MEANING, but a mark still owes a READER: a word no
// reader on that declaration claims is refused where it was written.
use @std.avrac.compiler.{analyze_source}

spec "features/annotations — marks" {
    given "a mark lands on the member it precedes" {
        then "a variant mark is the variant's" {
            let a = analyze_source(
                "type Reg = { index: int }\nenum Ins {\n    @frozen Quote(parts: List<string>)\n}\n1\n",
            )
            let vs = a.view.store.enum_parts(a.view.stmts[1])?.variants ?? []
            vs.length == 1 && vs[0].marks.length == 1 && vs[0].marks[0].name == "frozen"
        }
        then "a payload mark is the payload's, not the variant's" {
            let a = analyze_source(
                "type Reg = { index: int }\nenum Ins {\n    Const(@dst dst: Reg, v: int)\n}\n1\n",
            )
            let vs = a.view.store.enum_parts(a.view.stmts[1])?.variants ?? []
            vs[0].marks.is_empty() &&
                vs[0].payloads[0].marks[0].name == "dst" &&
                vs[0].payloads[1].marks.is_empty()
        }
        then "a mark on the SECOND payload stays there" {
            let a = analyze_source(
                "type Reg = { index: int }\nenum Ins {\n    Pair(a: Reg, @second b: Reg)\n}\n1\n",
            )
            let vs = a.view.store.enum_parts(a.view.stmts[1])?.variants ?? []
            vs[0].payloads[0].marks.is_empty() && vs[0].payloads[1].marks[0].name == "second"
        }
        then "a variant mark and a payload mark do not trade places" {
            let a = analyze_source(
                "type Reg = { index: int }\nenum Ins {\n    @vm V(@pm p: Reg)\n}\n1\n",
            )
            let vs = a.view.store.enum_parts(a.view.stmts[1])?.variants ?? []
            vs[0].marks[0].name == "vm" && vs[0].payloads[0].marks[0].name == "pm"
        }
        then "a mark with arguments keeps its words" {
            let a = analyze_source(
                "type Reg = { index: int }\nenum Ins {\n    @widened(wide) S(word: string)\n}\n1\n",
            )
            let vs = a.view.store.enum_parts(a.view.stmts[1])?.variants ?? []
            vs[0].marks[0].name == "widened" &&
                vs[0].marks[0].args.length == 1 &&
                vs[0].marks[0].args[0] == "wide"
        }
        then "a mark no reader claims is refused where it was written" {
            let a = analyze_source(
                "type Reg = { index: int }\nenum Ins {\n    @nobody_reads_this Const(v: int)\n}\n1\n",
            )
            a.diagnostics.length == 1 && a.report().contains("annotation.unread_mark")
        }
    }
    given "a component field's mark" {
        then "lands on the field it precedes, on the same line" {
            let a = analyze_source(
                "component widget {\n    @attribute(.Label) content: string\n}\n1\n",
            )
            let fs = a.view.store.struct_parts(a.view.stmts[0])?.fields ?? []
            fs.length == 1 &&
                fs[0].marks.length == 1 &&
                fs[0].marks[0].name == "attribute" &&
                fs[0].marks[0].args[0] == "Label"
        }
    }
}
