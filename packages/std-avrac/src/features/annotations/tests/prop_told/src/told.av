//! A reader for the project marks a component's head may carry: it claims
//! their words and reports what the signature made of each member.
use @std.meta.{Type, Field, Directive, Declared, derive, literal}

export trait Sees {
    fn facts() -> string

    static fn derive(t: Type) -> Declared {
        let said = [member_line(f).join(" ") for f in t.fields].join(" · ")
        Declared {
            made: [
                Directive {
                    twin: "",
                    name: t.name,
                    at: t.at,
                    source: quote {
                        fn ${"told_" + t.name}() -> string { ${literal(said)} }
                    },
                },
            ],
        }
    }

    static fn marks(t: Type) -> List<string> { ["attr", "children", "style"] }
}

/// One member as the signature made it: its name, whether it is a prop or a
/// `state`, and the type it wears.
fn member_line(f: Field) -> List<string> {
    ["${f.name}", "prop=${f.prop}", "state=${f.state}", "kind=${f.kind.spelled()}"]
}
