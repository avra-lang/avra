// proves: a head param the parent fills by naming it — a projection mark
// (`@attr`, `@children`, `@style`) — is TOLD, never kept: the signature makes
// it no prop and no cell, so its type is what the author wrote. A comparable
// head prop the parent fills by VALUE is the cell #1086 claims, which is what
// makes the observation tell a told member from a prop cell and from an
// authored `state`.
use @std.meta.{derive}
use told.{Sees}

@derive(Sees)
component gauge(
    @attr(.Title) title: string,
    @children kids: List<string>,
    @style(color) tone: string,
) {
    state held: int = 0
}

@derive(Sees)
component meter(label: string) {
    state held: int = 0
}

println(told_gauge())
println(told_meter())
