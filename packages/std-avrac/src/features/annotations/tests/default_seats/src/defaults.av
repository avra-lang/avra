use @std.meta.{Type, Fn, Code, Declared, Directive}

export fn projected(t: Type, value: Code = quote { 7 }) -> Declared {
    Declared {
        made: [
            Directive {
                twin: "",
                name: t.name,
                at: t.at,
                source: quote { impl ${t} { static fn configured() -> int { ${value} } } },
            },
        ],
    }
}

fn base() -> int { 40 }

export fn calculated(t: Type, n: int = base() + 2) -> Declared {
    Declared {
        made: [
            Directive {
                twin: "",
                name: t.name,
                at: t.at,
                source: quote { impl ${t} { static fn calculated() -> int { ${n} } } },
            },
        ],
    }
}

export fn tagged(f: Fn, label: string = "default") -> List<Directive> {
    [Directive { twin: "${f.name}_${label}", name: f.name, at: f.at }]
}
