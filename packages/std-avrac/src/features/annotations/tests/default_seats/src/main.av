use defaults.{projected, calculated, tagged}

type Settings = { n: int }

@projected
@calculated
type Bare = { value: int }

@projected(quote { Settings { n: 11 }.n })
type Explicit = { value: int }

@tagged
fn two() -> int { 2 }

"${Bare.configured()} ${Explicit.configured()} ${Bare.calculated()} ${two_default()}"
