//! Three ways a WRAP directive refuses, each its own kind.
use @std.meta.{Fn, Directive, Decls}

/// `source` names no fn matching the annotated one.
export fn wrap_missing_ann(f: Fn) -> List<Directive> {
    [
        Directive {
            twin: "",
            name: f.name,
            at: f.at,
            wraps: true,
            source: quote { fn not_the_right_name() -> int { 0 } },
        },
    ]
}

/// The annotated declaration has no body to move.
export fn wrap_bodiless_ann(f: Fn) -> List<Directive> {
    [
        Directive {
            twin: "",
            name: f.name,
            at: f.at,
            wraps: true,
            source: quote { fn ${f.name}() -> int { 0 } },
        },
    ]
}

/// The wrapper's own signature does not match the annotated fn's.
export fn wrap_mismatch_ann(f: Fn) -> List<Directive> {
    [
        Directive {
            twin: "",
            name: f.name,
            at: f.at,
            wraps: true,
            source: quote { fn ${f.name}(x: string) -> int { 0 } },
        },
    ]
}
