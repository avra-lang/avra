// proves: a WRAP directive refuses three ways, each its own kind —
// `source` naming no matching fn (annotation.wrap_missing), the
// annotated declaration having no body (annotation.wrap_bodiless,
// an extern here), and the wrapper's signature disagreeing with the
// one it wraps (annotation.wrap_mismatch).
use @test.badwrap.{wrap_missing_ann, wrap_bodiless_ann, wrap_mismatch_ann}

@wrap_missing_ann
fn missing_target() -> int { 1 }

@wrap_bodiless_ann
extern fn bodiless_target() -> int

@wrap_mismatch_ann
fn mismatched_target(n: int) -> int { n }

1
