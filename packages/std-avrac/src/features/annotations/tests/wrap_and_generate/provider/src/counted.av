//! Two annotations over one free fn: a WRAP that moves the written body
//! behind a wrapper adding 1, and a generator that declares a second fn
//! calling the written name.
use @std.meta.{Fn, Directive, Decls, wrapped}

export fn counted(f: Fn) -> List<Directive> {
    [
        Directive {
            twin: "",
            name: f.name,
            at: f.at,
            wraps: true,
            source: quote { fn ${f.name}(n: int) -> int { ${wrapped(f)}(n) + 1 } },
        },
    ]
}

export fn echoed(f: Fn) -> List<Directive> {
    [
        Directive {
            twin: "",
            name: f.name,
            at: f.at,
            source: quote { fn ${f}_echo(n: int) -> int { ${f}(n) } },
        },
    ]
}
