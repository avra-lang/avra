// `@name(args)` — the compiler's call over a declaration. What is
// proved here: the annotation is a fact of the declaration it
// crosses, its callee resolves like any name, its arguments type
// like any expression, and the declaration stands unchanged.
use @std.avrac.testing.{shown, refused_with, refusals}
use @std.avrac.language.{analyze_source}

spec "features/annotations — a call over a declaration" {
    given "the surface" {
        then "an annotated fn is the fn" {
            shown("type Fn = {}\nfn tag(f: Fn, n: int) { }\n@tag(3)\nfn answer() -> int {\n    1\n}\nanswer()") == "1"
        }
        then "a bare annotation takes no parentheses" {
            shown("type Type = {}\nfn tag(t: Type) { }\n@tag\ntype P = { x: int }\nP { x: 2 }.x") == "2"
        }
        then "annotations stack" {
            shown("type Fn = {}\nfn a(f: Fn) { }\nfn b(f: Fn, n: int) { }\n@a\n@b(1)\nfn answer() -> int {\n    3\n}\nanswer()") == "3"
        }
        then "the annotation is recorded on the declaration, in written order" {
            let a = analyze_source("fn a() -> int {\n    0\n}\nfn b(n: int) -> int {\n    n\n}\n@a\n@b(1)\nfn f() -> int {\n    3\n}\nf()")
            let marks = [a.view.store.annotations_of(s).length for s in a.view.stmts]
            ["${n}" for n in marks].join(",") == "0,0,2,0"
        }
    }
    given "the callee and the arguments are expressions" {
        then "an unknown name is refused as any name is" {
            refused_with("@nope\nfn f() -> int {\n    1\n}\nf()", "not defined")
        }
        then "an argument that does not type is refused as any expression is" {
            refused_with("type Fn = {}\nfn tag(f: Fn, x: int) { }\n@tag(zzz)\nfn answer() -> int {\n    1\n}\nanswer()", "not defined")
        }
        then "one mistake, one message" {
            refusals("@nope\nfn f() -> int {\n    1\n}\nf()") == 1
        }
    }
}
