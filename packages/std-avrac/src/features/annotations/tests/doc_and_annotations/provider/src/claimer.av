//! Claims the marks this test's fields and variants carry, so
//! `@important`/`@frozen` stand rather than being refused as unread —
//! the law every mark owes a reader (features/annotations/tests/marks).
use @std.meta.{Type, Directive}

export trait FactsClaimer {
    static fn derive(t: Type) -> List<Directive> {
        [Directive { twin: "", name: t.name, at: t.at, source: quote { impl ${t} { fn claimed() -> int { 1 } } } }]
    }

    /// The words this derive reads off a variant or a field.
    static fn marks(t: Type) -> List<string> { ["important", "frozen"] }
}
