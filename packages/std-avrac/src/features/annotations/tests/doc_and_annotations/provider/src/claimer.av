//! Claims the marks this test's fields and variants carry, so
//! `@important`/`@frozen` stand rather than being refused as unread —
//! the law every mark owes a reader (features/annotations/tests/marks).
use @std.meta.{Type, Directive, Named, Marker, reads}

export fn important(_d: Named, .._args: List<string>) -> Marker { Marker {} }

export fn frozen(_d: Named, .._args: List<string>) -> Marker { Marker {} }

@reads(important)
@reads(frozen)
export trait FactsClaimer {
    static fn derive(t: Type) -> List<Directive> {
        [
            Directive {
                twin: "",
                name: t.name,
                at: t.at,
                source: quote { impl ${t} { fn claimed() -> int { 1 } } },
            },
        ]
    }

}
