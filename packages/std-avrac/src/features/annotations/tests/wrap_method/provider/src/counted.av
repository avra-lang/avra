//! WRAP directives over methods: the written body moves behind a
//! wrapper that adds 1, spliced as a method of the same owner — a
//! static one reaches the body through its owner's name, an instance
//! one through `self`.
use @std.meta.{Fn, Directive, Decls, wrapped, name}

export fn counted_static(f: Fn) -> List<Directive> {
    [
        Directive {
            twin: "",
            name: f.name,
            at: f.at,
            wraps: true,
            source: quote { static fn ${f.name}(n: int) -> int { ${name(f.owner!)}.${wrapped(f)}(n) + 1 } },
        },
    ]
}

export fn counted(f: Fn) -> List<Directive> {
    [
        Directive {
            twin: "",
            name: f.name,
            at: f.at,
            wraps: true,
            source: quote { fn ${f.name}(n: int) -> int { self.${wrapped(f)}(n) + 1 } },
        },
    ]
}
