// proves: a name a derive's template writes that its own file doesn't declare is read where the
// generated code lands — `Thing` and `Width` are the annotated module's, not the template's.
use @std.meta.{derive}
use measure.{Measured}

type Width = { n: int }

@derive(Measured)
type Thing = { k: int }

"${Thing { k: 1 }.measured(Width { n: 7 })}"
