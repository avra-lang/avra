use @std.meta.{Type, Directive, beside}

/// A derive whose template names `Thing` and `Width`, which only the file it lands in declares.
export trait Measured {
    static fn derive(t: Type) -> List<Directive> {
        [beside(t, quote { impl Thing { fn measured(w: Width) -> int { w.n + self.k } } })]
    }
}
