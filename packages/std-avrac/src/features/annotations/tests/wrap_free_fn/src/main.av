// proves: a WRAP directive on a free fn moves the written body
// behind a generated wrapper (`+1`) spliced under the written name —
// every caller reaches the wrapper, and a self-call inside the
// written body ALSO reaches the wrapper (recursion re-enters through
// it): a plain call answers `doubled + 1`, and `fact(3)` under the
// wrapper at every recursive level answers 16, not 7 (the value a
// wrapper applied only at the outer call would give).
use @test.counter.{counted}

@counted
fn doubled(n: int) -> int { n * 2 }

@counted
fn fact(n: int) -> int {
    if n <= 1 { 1 } else { n * fact(n - 1) }
}

"${doubled(5)} ${fact(3)}"
