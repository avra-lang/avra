//! A WRAP directive over a free fn: the written body moves behind a
//! wrapper that adds 1 to whatever it answers, spliced under the
//! written name — every caller, including the body's own recursive
//! self-call, reaches the wrapper first.
use @std.meta.{Fn, Directive, Decls, wrapped}

export fn counted(f: Fn) -> List<Directive> {
    [
        Directive {
            twin: "",
            name: f.name,
            at: f.at,
            wraps: true,
            source: quote { fn ${f.name}(n: int) -> int { ${wrapped(f)}(n) + 1 } },
        },
    ]
}
