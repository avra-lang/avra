        then "@std ( x x , )" { tolerates("@std ( x x , )") }
        then "@std ( x , , )" { tolerates("@std ( x , , )") }
        then "@std ( x , x )" { tolerates("@std ( x , x )") }
        then "@std ( x , x ," { tolerates("@std ( x , x ,") }
        then "@std @std ( x , x , )" { tolerates("@std @std ( x , x , )") }
