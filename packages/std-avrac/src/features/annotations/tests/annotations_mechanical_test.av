        then "@std ( x , x , ) \n x x" { tolerates("@std ( x , x , ) \n x x") }
        then "( @std x , x , ) \n x" { tolerates("( @std x , x , ) \n x") }
        then "@std x ( , x , ) \n x" { tolerates("@std x ( , x , ) \n x") }
        then "@std ( , x x , ) \n x" { tolerates("@std ( , x x , ) \n x") }
        then "@std ( x x , , ) \n x" { tolerates("@std ( x x , , ) \n x") }
        then "@std ( x , , x ) \n x" { tolerates("@std ( x , , x ) \n x") }
        then "@std ( x , x ) , \n x" { tolerates("@std ( x , x ) , \n x") }
