// proves: `@word` and `@word(a, b)` before a VARIANT or a FIELD is a
// MARK — data the member carries, never a call — and that a derive
// which CLAIMS those words lets them stand. A mark no reader claims
// is refused where it is written (F2092, the spec cases); a claimed
// one compiles and the derive's own declarations land beside it.
use @std.meta.{derive}
use @test.claimer.{Claimer}

@derive(Claimer)
enum Shape {
    @frozen Quote(parts: List<string>, body: string)
    @widened(body) Sub(word: string, body: int)
    Plain(x: int)
}

@derive(Claimer)
type Row = {
    @frozen held: string,
    plain: int,
}

let boxed = Shape.Quote(["a", "b"], "one" + "two")
let row = Row { held: "h", plain: 1 }
"${boxed.claimed() + Shape.Plain(1).claimed() + row.claimed()}"
