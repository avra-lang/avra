//! A derive whose generated fns answer literals no source wrote: a list, a record of a list, and a
//! text, each the binary's own data.
use @std.meta.{Directive, Type}

export trait Listed {
    static fn derive(t: Type) -> List<Directive> {
        [
            Directive {
                twin: "",
                name: t.name,
                at: t.at,
                source: quote {
                    fn digits() -> List<int> { [3, 1, 4] }
                    fn again() -> List<int> { [3, 1, 4] }
                    fn spans() -> List<Span> { [Span { lo: 1, hi: 2 }, Span { lo: 5, hi: 9 }] }
                },
            },
        ]
    }
}

export type Span = { lo: int, hi: int }
