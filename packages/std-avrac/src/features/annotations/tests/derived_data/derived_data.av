// proves: literals a derive generates are laid out as data under names
// of their own: two fns answering one list each read it, and a list of
// records reads back field by field.
use @std.meta.{derive}

@derive(Listed)
type Marked = { n: int }

let ds = digits()
let ss = spans()
"${ds.length} ${ds[0]}${ds[1]}${ds[2]} ${again()[2]} ${ss.length} ${ss[0].lo} ${ss[1].hi}"
