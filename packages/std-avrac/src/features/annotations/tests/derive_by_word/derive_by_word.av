// proves: a trait's word is its derive. `@Counted` runs `Counted`'s derive as `@derive(Counted)`
// does, and the derive asks which annotation is its own by the trait, never by a word.
use @std.meta.{derive}

@Counted
type ByWord = { n: int }

@derive(Counted)
type ByDerive = { n: int }

"${ByWord.worn()}, ${ByDerive.worn()}"
