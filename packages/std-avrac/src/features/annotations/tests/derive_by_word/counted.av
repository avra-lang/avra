//! A derive that says how many of a type's annotations are its own, asked by identity: `marks(a,
//! Counted)` holds of `@Counted` and of `@derive(Counted)` alike, and of no other annotation.
use @std.meta.{Directive, Type, literal, marks}

export trait Counted {
    static fn derive(t: Type) -> List<Directive> {
        let n = t.annotations.filter(marks(it, Counted)).length
        [
            Directive {
                twin: "",
                name: t.name,
                at: t.at,
                source: quote {
                    impl Worn for ${t.name} {
                        static fn worn() -> string { ${literal("${t.name} ${n} of ${t.annotations.length}")} }
                    }
                },
            },
        ]
    }
}

export trait Worn {
    static fn worn() -> string
}
