// The annotation boundary: its callee, receiver, remaining seats,
// answer effect, execution, and one-message discipline.
use @std.avrac.language.{avra, new_workspace, memory_host, Program}
use @std.avrac.core.{flatten}

fn meta_use() -> string {
    "use @std.meta.{Fn, Type, Diagnostic}\n"
}

fn fn_use() -> string {
    "use @std.meta.{Fn}\n"
}

fn directive_use() -> string {
    "use @std.meta.{Fn, Directive, traced}\n"
}

fn collect_use() -> string {
    "use @std.meta.{Fn, Directive, collect}\n"
}

fn packaged(source: string) -> Program {
    let files = {
        "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@std/meta\" = { path = \"vendor/meta\" }\n",
        "/w/src/main.av": source,
        "/w/vendor/meta/avra.toml": "[package]\nname = \"@std/meta\"\nversion = \"0.1.0\"\n",
        "/w/vendor/meta/src/meta.av": "export type Loc = { file: string?, lo: int, hi: int }\nexport type Param = { name: string, ty: string, mutable: bool, at: Loc? }\nexport type Fn = { name: string, params: List<Param>, answer: string, at: Loc? }\nexport type Field = { name: string, ty: string, at: Loc? }\nexport type Variant = { name: string, payload: List<string>, at: Loc? }\nexport type Type = { name: string, fields: List<Field>, variants: List<Variant>, at: Loc? }\nexport type Diagnostic = { message: string, help: string?, at: Loc? }\nexport type Decl = { twin: string, name: string, at: Loc? }\nexport type Directive = { twin: string, name: string, at: Loc? }\nexport fn traced(f: Fn, label: string) -> List<Directive> { [Directive { twin: \"\${f.name}_traced\", name: f.name, at: null }] }\nexport fn collect(f: Fn, xs: List<int>) -> List<Directive> { [] }\n",
    }
    mut ws = new_workspace(memory_host(files, ["/w/avra.toml", "/w/src/main.av", "/w/vendor/meta/avra.toml", "/w/vendor/meta/src/meta.av"]), "/w", avra())
    ws.program("/w/src/main.av")
}

fn refused(source: string, phrase: string) -> bool {
    let p = packaged(source)
    let ds = flatten([a.diagnostics for a in p.files]).concat(p.voices).concat(p.defects)
    ds.length == 1 && p.report().contains(phrase)
}

fn refused_at(source: string, phrase: string, line: int) -> bool {
    let p = packaged(source)
    let ds = flatten([a.diagnostics for a in p.files]).concat(p.voices).concat(p.defects)
    let report = p.report()
    ds.length == 1 && report.contains(phrase) && report.contains("main.av:${line}")
}

/// `refused`, with a pinned COUNT — a refusal test proves both the
/// words and that a cascade did not hide behind them.
fn refused_n(source: string, phrase: string, n: int) -> bool {
    let p = packaged(source)
    let ds = flatten([a.diagnostics for a in p.files]).concat(p.voices).concat(p.defects)
    ds.length == n && p.report().contains(phrase)
}

spec "features/annotations — the compile-time call's laws" {
    given "the callee and receiver" {
        then "a value is not an annotation fn" {
            refused("let mark = 1\n@mark\nfn answer() -> int { 1 }\nanswer()", "an annotation names a fn")
        }
        then "the fn's first seat must take this declaration" {
            refused(meta_use() + "fn mark(f: Fn) { }\n@mark\ntype P = { x: int }\n1", "takes `Fn`, and this is a type")
        }
        then "the fn must take the declaration" {
            refused("fn mark() { }\n@mark\nfn answer() -> int { 1 }\nanswer()", "takes nothing")
        }
        then "a same-named user record cannot counterfeit the meta receiver" {
            refused("type Fn = {}\nfn mark(f: Fn) { }\n@mark\nfn answer() -> int { 1 }\nanswer()", "not `@std.meta.Fn`")
        }
    }
    given "the remaining seats and answer" {
        then "written arguments fill every remaining seat" {
            refused(meta_use() + "fn mark(f: Fn, n: int) { }\n@mark\nfn answer() -> int { 1 }\nanswer()", "takes 1 after the declaration, this writes 0")
        }
        then "each argument has its seat's type" {
            refused(meta_use() + "fn mark(f: Fn, n: int) { }\n@mark(\"three\")\nfn answer() -> int { 1 }\nanswer()", "this seat of `mark` takes `int`")
        }
        then "the answer declares the effect" {
            refused(meta_use() + "fn mark(f: Fn) -> int { 1 }\n@mark\nfn answer() -> int { 1 }\nanswer()", "answers `int`")
        }
        then "a same-named user record cannot counterfeit diagnostics" {
            let src = fn_use() + "type Diagnostic = { message: string }\n" +
                      "fn mark(f: Fn) -> List<Diagnostic> { [] }\n" +
                      "@mark\nfn answer() -> int { 1 }\nanswer()"
            refused(src, "not `List<@std.meta.Diagnostic>`")
        }
        then "a lookalike answer does not declare — only `Directive` does" {
            refused_n(meta_use() + "fn mark(f: Fn) -> List<Decl> { [] }\n@mark\nfn answer() -> int { 1 }\nanswer()",
                      "answers an effect", 2)
        }
    }
    given "declaration generation" {
        then "an annotation fn's signature IS its effect — `explain @name`" {
            let p = packaged(directive_use() + "@traced(\"sum\")\nfn sum(a: int, b: int) -> int { a + b }\nsum(1, 2)")
            p.explain_annotation("traced") == "fn traced(Fn, string) -> List<Directive>"
        }
        then "a generated twin lists with its provenance" {
            let p = packaged(directive_use() + "@traced(\"x\")\nfn sum(a: int, b: int) -> int { a + b }\nsum(1, 2)")
            let lines = p.generated_lines(p.entry_file()!.view.file)
            lines.length == 1 && lines[0].contains("sum_traced") && lines[0].contains("@traced")
        }
        then "a declaration-making annotation fn in the same file is refused, not ignored" {
            refused_n(directive_use() +
                      "fn gen(f: Fn) -> List<Directive> { [] }\n" +
                      "@gen\nfn sum() -> int { 1 }\nsum()",
                      "generates declarations and stands in this file", 1)
        }
        then "an undeclared annotation name explains to nothing" {
            let p = packaged(directive_use() + "1")
            p.explain_annotation("ghost") == null
        }
        then "a declaration-making annotation reaches only literals" {
            refused_n(collect_use() + "@collect([1, 2])\nfn answer() -> int { 1 }\nanswer()",
                      "generates declarations, so its arguments come from the source alone", 1)
        }
    }
    given "validation" {
        then "a returned Diagnostic speaks once at the declaration" {
            let src = meta_use() +
                      "fn reject(f: Fn) -> List<Diagnostic> { [Diagnostic { message: \"`\${f.name}` is forbidden\", help: null, at: null }] }\n" +
                      "@reject\nfn forbidden() -> int { 1 }\nforbidden()"
            refused(src, "`forbidden` is forbidden")
        }
        then "a diagnostic can point at the field that caused it" {
            let src = meta_use() +
                      "fn reject(t: Type) -> List<Diagnostic> { [Diagnostic { message: \"bad field\", help: null, at: t.fields[0].at }] }\n" +
                      "@reject\ntype P = {\n    x: int\n}\n1"
            refused_at(src, "bad field", 5)
        }
    }
    given "argument evaluation" {
        then "an argument that reaches the world is refused before it runs" {
            let src = meta_use() +
                      "extern fn avra_puts(s: string)\n" +
                      "fn noisy() -> int { avra_puts(\"x\")\n1 }\n" +
                      "fn mark(f: Fn, n: int) { }\n" +
                      "@mark(noisy())\nfn answer() -> int { 1 }\nanswer()"
            refused(src, "reaches `avra_puts`")
        }
        then "an argument trap is reported once at its annotation" {
            let src = meta_use() +
                      "fn boom() -> int { 1 / 0 }\n" +
                      "fn mark(f: Fn, n: int) { }\n" +
                      "@mark(boom())\nfn answer() -> int { 1 }\nanswer()"
            refused(src, "division by zero")
        }
    }
}
