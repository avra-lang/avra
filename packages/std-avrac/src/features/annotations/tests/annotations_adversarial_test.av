// The annotation boundary: its callee, receiver, remaining seats,
// answer effect, execution, and one-message discipline.
use @std.avrac.testing.{test_workspace}
use @std.avrac.compiler.{parse_source, analyze_source, Program, Workspace}
use @std.avrac.testing.{
    said,
    refused_n,
    refused_in,
    refused_with,
    refusals,
    vendored_meta,
    vendored_meta_paths,
}
use compiler.host.{memory_host}
use compiler.format.{render_source}
use compiler.{rule_findings, analysed}

fn meta_use() -> string {
    "use @std.meta.{Fn, Type, Diagnostic}\n"
}

fn fn_use() -> string {
    "use @std.meta.{Fn}\n"
}

fn directive_use() -> string {
    "use @std.meta.{Fn, Directive, traced}\n"
}

fn deprecation_use() -> string {
    "use @std.meta.{deprecated}\n"
}

fn sampled_use() -> string {
    "use @std.meta.{Fn, Directive, sampled}\n"
}

/// The fixtures the REAL `@std/meta` deliberately has not: a `Decl`
/// LOOKALIKE (the real package refuses that name — a collision would
/// arm a counterfeit), a trait whose `derive` makes a twin, one that
/// declares none, an annotation taking a list, two twins that
/// name a seat no written binding can take: its OWN annotated fn, and
/// an unrelated one already in the file — and a trait whose `derive`
/// generates a TYPE (a key record) alongside a fn, for the door a
/// struct literal reads a generated declaration through — and a
/// trait whose `derive` generates an `impl` over the annotated type
/// itself, its ONE method's own NAME a hole, for the door a method
/// call reads a generated declaration through.
fn meta_probes() -> string {
    "use @std.errors.{Loc}\nexport type Decl = { twin: string, name: string, at: Loc? }\nexport trait Show {\n    static fn derive(what: Named) -> List<Directive> { [Directive { twin: \"gen_\" + what.name, name: what.name, at: what.at }] }\n}\nexport trait Empty {\n    fn mark() -> int\n}\nexport trait Tagged {\n    static fn derive(t: Type) -> List<Directive> { [] }\n    static fn marks(t: Type) -> List<string> { [\"frozen\", \"widened\"] }\n}\nexport trait Plainly {\n    static fn derive(t: Type) -> List<Directive> { [] }\n}\nexport fn sampled(f: Fn, xs: List<int>) -> List<Directive> { [] }\nexport fn same_twin(f: Fn) -> List<Directive> { [Directive { twin: f.name, name: f.name, at: f.at }] }\nexport fn other_twin(f: Fn) -> List<Directive> { [Directive { twin: \"already\", name: f.name, at: f.at }] }\nexport trait Keyed {\n    static fn derive(t: Type) -> List<Directive> {\n        [Directive { twin: \"\", name: t.name, at: t.at, source: quote {\n            type DeclKey = { module: string, x: int }\n            fn decl_probe() -> int { 41 }\n        } }]\n    }\n}\nexport trait MethodNamed {\n    static fn derive(t: Type) -> List<Directive> {\n        [Directive { twin: \"\", name: t.name, at: t.at, source: quote {\n            impl T {\n                fn \${method_hole_name()}() -> int { 7 }\n            }\n        } }]\n    }\n}\nfn method_hole_name() -> string { \"probed\" }\nexport trait Spanner {\n    static fn derive(t: Type) -> List<Directive> {\n        [Directive { twin: \"\", name: t.name, at: t.at, source: quote { fn spanned_probe() -> int { 1 } } }]\n    }\n}\nexport fn wrap_missing(f: Fn) -> List<Directive> { [Directive { twin: \"\", name: f.name, at: f.at, wraps: true, source: quote { fn not_it() -> int { 0 } } }] }\nexport fn wrap_bodiless(f: Fn) -> List<Directive> { [Directive { twin: \"\", name: f.name, at: f.at, wraps: true, source: quote { fn \${f.name}() -> int { 0 } } }] }\nexport fn wrap_mismatch(f: Fn) -> List<Directive> { [Directive { twin: \"\", name: f.name, at: f.at, wraps: true, source: quote { fn \${f.name}(x: string) -> int { 0 } } }] }\nexport fn wrap_unstatic(f: Fn) -> List<Directive> { [Directive { twin: \"\", name: f.name, at: f.at, wraps: true, source: quote { fn \${f.name}(n: int) -> int { n } } }] }\nexport fn wrap_mutating(f: Fn) -> List<Directive> { [Directive { twin: \"\", name: f.name, at: f.at, wraps: true, source: quote { mut fn \${f.name}(n: int) -> int { n } } }] }\n"
}

/// A file whose `uses(p)` puts `p` at the very offsets `Spanner`'s
/// generated fn spans in the template file — where a generated
/// declaration's span, read as this file's, would claim `p`.
fn spanned_consumer() -> string {
    let head = "use @std.meta.{derive, Spanner}\n@derive(Spanner)\ntype T = { a: int }\n"
    let body = "fn uses(p: int) -> int { p + p + p + p + p + p + p + p + p + p + p + p + p + p + p + p }\nuses(1) + spanned_probe()"
    let pad = meta_probes().index_of("fn spanned_probe") + 3 - head.length - body.index_of("p: int") - 3
    head + "//" + ["x" for i in 0..pad].join("") + "\n" + body
}

/// A source through the printer — the parse read back, so a mark's
/// ALIGNMENT is visible as the member it came out attached to.
fn formatted(source: string) -> string {
    let a = analyze_source(source)
    render_source(a.view.store, a.view.stmts)
}

fn packaged(source: string) -> Program {
    let files = vendored_meta(
        {
            "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@std/meta\" = { path = \"vendor/meta\" }\n",
            "/w/src/main.av": source,
            "/w/vendor/meta/src/probes.av": meta_probes(),
        },
    )
    let ws = test_workspace(
        memory_host(
            files,
            ["/w/avra.toml", "/w/src/main.av", "/w/vendor/meta/src/probes.av"]
                .concat(vendored_meta_paths()),
        ),
        "/w",
    )
    ws.program("/w/src/main.av")
}

/// An annotation package of its own, refusing under its OWN kind.
fn audit_source() -> string {
    "use @std.meta.{Fn, Diagnostic, refuse_as, refuse}\nexport fn audited(f: Fn) -> List<Diagnostic> {\n    [refuse_as(\"E1\", \"`\${f.name}` is audited\")]\n}\nexport fn plain(f: Fn) -> List<Diagnostic> {\n    [refuse(\"`\${f.name}` is plain\")]\n}\nexport fn quiet(f: Fn) -> List<Diagnostic> {\n    if f.name == \"never\" { [refuse_as(\"E2\", \"a quiet fn\")] } else { [] }\n}\nexport fn blank(f: Fn) -> List<Diagnostic> {\n    [refuse_as(\"\", \"`\${f.name}` is blank\")]\n}\nexport fn old(f: Fn) -> List<Diagnostic> {\n    [Diagnostic { message: \"`\${f.name}` is old\", help: null, at: null, warning: true, kind: \"W1\" }]\n}\n"
}

/// The workspace with a second dependency, `@acme/audit`.
fn audit_workspace(source: string) -> Workspace {
    let files = vendored_meta(
        {
            "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@std/meta\" = { path = \"vendor/meta\" }\n\"@acme/audit\" = { path = \"vendor/audit\" }\n",
            "/w/src/main.av": source,
            "/w/vendor/audit/avra.toml": "[package]\nname = \"@acme/audit\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@std/meta\" = { path = \"../meta\" }\n",
            "/w/vendor/audit/src/audit.av": audit_source(),
        },
    )
    test_workspace(
        memory_host(
            files,
            [
                "/w/avra.toml",
                "/w/src/main.av",
                "/w/vendor/audit/avra.toml",
                "/w/vendor/audit/src/audit.av",
            ]
                .concat(vendored_meta_paths()),
        ),
        "/w",
    )
}

fn audited(source: string) -> Program {
    let ws = audit_workspace(source)
    ws.program("/w/src/main.av")
}

fn audit_use() -> string {
    "use @acme.audit.{audited, plain, quiet, blank, old}\n"
}

fn refused(source: string, phrase: string) -> bool {
    refused_in(packaged(source), phrase)
}

fn refused_at(source: string, phrase: string, line: int) -> bool {
    let p = packaged(source)
    refused_in(p, phrase) && p.report().contains("main.av:${line}")
}

/// A clean program's warnings, rendered; a refusal's report when it
/// refused — the whole check, whichever side.
fn checked(p: Program) -> string {
    match p.check() { .Ok(warned) -> warned, .Err(report) -> report }
}

/// `refused`, with a pinned COUNT — a refusal test proves both the
/// words and that a cascade did not hide behind them.
spec "features/annotations — the compile-time call's laws" {
    given "the callee and receiver" {
        then "a value is not an annotation fn" {
            refused(
                "let mark = 1\n@mark\nfn answer() -> int { 1 }\nanswer()",
                "an annotation names a fn",
            )
        }
        then "the fn's first seat must take this declaration" {
            refused(
                meta_use() + "fn mark(f: Fn) { }\n@mark\ntype P = { x: int }\n1",
                "takes `Fn`, and this is a type",
            )
        }
        then "the fn must take the declaration" {
            refused("fn mark() { }\n@mark\nfn answer() -> int { 1 }\nanswer()", "takes nothing")
        }
        then "a same-named user record cannot counterfeit the meta receiver" {
            refused(
                "type Fn = {}\nfn mark(f: Fn) { }\n@mark\nfn answer() -> int { 1 }\nanswer()",
                "not `@std.meta.Fn`",
            )
        }
    }
    given "a declaring annotation the laws refuse never runs" {
        then "one argument too many is one refusal — the lift does not read past its seats" {
            refused_n(
                packaged(
                    directive_use() +
                        "@traced(\"a\", \"b\")\nfn sum(a: int, b: int) -> int { a + b }\nsum(1, 2)",
                ),
                "takes 1 after the declaration, this writes 2",
                1,
            )
        }
        then "a receiver its seat refuses is one refusal — nothing is generated over it" {
            refused_n(
                packaged(directive_use() + "@traced(\"a\")\ntype P = { x: int }\n1"),
                "takes `Fn`, and this is a type",
                1,
            )
        }
    }
    given "the remaining seats and answer" {
        then "written arguments fill every remaining seat" {
            refused(
                meta_use() + "fn mark(f: Fn, n: int) { }\n@mark\nfn answer() -> int { 1 }\nanswer()",
                "takes 1 after the declaration, this writes 0",
            )
        }
        then "each argument has its seat's type" {
            refused(
                meta_use() +
                    "fn mark(f: Fn, n: int) { }\n@mark(\"three\")\nfn answer() -> int { 1 }\nanswer()",
                "this seat of `mark` takes `int`",
            )
        }
        then "the answer declares the effect" {
            refused(
                meta_use() +
                    "fn mark(f: Fn) -> int { 1 }\n@mark\nfn answer() -> int { 1 }\nanswer()",
                "answers `int`",
            )
        }
        then "a same-named user record cannot counterfeit diagnostics" {
            let src = fn_use() +
                "type Diagnostic = { message: string }\n" +
                "fn mark(f: Fn) -> List<Diagnostic> { [] }\n" +
                "@mark\nfn answer() -> int { 1 }\nanswer()"
            refused(src, "not `List<@std.meta.Diagnostic>`")
        }
        then "a lookalike answer does not declare — only `Directive` does" {
            refused_n(
                packaged(
                    meta_use() +
                        "fn mark(f: Fn) -> List<Decl> { [] }\n@mark\nfn answer() -> int { 1 }\nanswer()",
                ),
                "answers an effect",
                2,
            )
        }
    }
    given "declaration generation" {
        then "an annotation fn's signature IS its effect — `explain @name`" {
            let p = packaged(
                directive_use() +
                    "@traced(\"sum\")\nfn sum(a: int, b: int) -> int { a + b }\nsum(1, 2)",
            )
            p.explain_annotation("traced") == "fn traced(Fn, string) -> List<Directive>\n\nThe trace directive's decoder: `@traced(\"label\")` on `fn sum`\nasks for a sibling named `sum_traced`."
        }
        then "a generated twin lists with its provenance" {
            mut p = packaged(
                directive_use() +
                    "@traced(\"x\")\nfn sum(a: int, b: int) -> int { a + b }\nsum(1, 2)",
            )
            let lines = p.generated_lines(p.entry_file()!.view.file)
            lines.length == 1 &&
                lines[0] == "fn sum_traced(a: int, b: int) -> int {\n    let sum_traced__v = sum(a, b)\n    sum_traced__v\n}   // from @traced on sum"
        }
        then "the expanded file inlines the generated body after its origin" {
            mut p = packaged(
                directive_use() +
                    "@traced(\"x\")\nfn sum(a: int, b: int) -> int { a + b }\nsum(1, 2)",
            )
            let source = p.expanded_source(p.entry_file()!.view.file)
            source == "use @std.meta.{Fn, Directive, traced}\n\n@traced(\"x\")\nfn sum(a: int, b: int) -> int {\n    a + b\n}\n\n// from @traced on sum\nfn sum_traced(a: int, b: int) -> int {\n    let sum_traced__v = sum(a, b)\n    sum_traced__v\n}\n\nsum(1, 2)"
        }
        then "the expanded file parses" {
            mut p = packaged(
                directive_use() +
                    "@traced(\"x\")\nfn sum(a: int, b: int) -> int { a + b }\nsum(1, 2)",
            )
            parse_source(p.expanded_source(p.entry_file()!.view.file)).voices.list.is_empty()
        }
        then "a declaration-making annotation fn in the same file is refused, not ignored" {
            refused_n(
                packaged(
                    directive_use() +
                        "fn gen(f: Fn) -> List<Directive> { [] }\n" +
                        "@gen\nfn sum() -> int { 1 }\nsum()",
                ),
                "generates declarations and stands in this file",
                1,
            )
        }
        then "an undeclared annotation name explains to nothing" {
            let p = packaged(directive_use() + "1")
            p.explain_annotation("ghost") == null
        }
        then "a declaration-making annotation reaches only literals" {
            refused_n(
                packaged(sampled_use() + "@sampled([1, 2])\nfn answer() -> int { 1 }\nanswer()"),
                "generates declarations, so its arguments come from the source alone",
                1,
            )
        }
        then "a declaring annotation reads a const whose value is a literal" {
            mut p = packaged(
                directive_use() +
                    "const Label = \"x\"\n@traced(Label)\nfn sum(a: int, b: int) -> int { a + b }\nsum_traced(1, 2)",
            )
            said(p).is_empty() && p.generated_lines(p.entry_file()!.view.file).length == 1
        }
        then "a const computed from more than a literal is refused at the argument" {
            refused_in(
                packaged(
                    directive_use() +
                        "const Label = \"a\" + \"b\"\n@traced(Label)\nfn sum() -> int { 1 }\nsum()",
                ),
                "`@traced` generates declarations, so `Label` must name a literal",
            )
        }
        then "a const holding an aggregate is refused at the argument" {
            refused_in(
                packaged(
                    sampled_use() +
                        "const Picks = [1, 2]\n@sampled(Picks)\nfn answer() -> int { 1 }\nanswer()",
                ),
                "`@sampled` generates declarations, so `Picks` must name a literal",
            )
        }
        then "a declaring annotation's argument that CALLS a fn is refused" {
            refused_in(
                packaged(
                    directive_use() +
                        "fn label() -> string { \"x\" }\n@traced(label())\nfn sum() -> int { 1 }\nsum()",
                ),
                "generates declarations, so its arguments come from the source alone",
            )
        }
        then "a twin naming the annotated fn's OWN name is refused, not silently doubled" {
            refused_n(
                packaged(
                    directive_use() +
                        "use @std.meta.{same_twin}\n@same_twin\nfn raised_by(n: int) -> int { n }\nraised_by(1)",
                ),
                "`@same_twin` generates `raised_by`, which this file already declares",
                1,
            )
        }
        then "a WRAP whose source declares no fn of the annotated name is refused" {
            refused_n(
                packaged(
                    directive_use() +
                        "use @std.meta.{wrap_missing}\n@wrap_missing\nfn f() -> int { 1 }\nf()",
                ),
                "`@wrap_missing` asks to wrap `f`, and its `source` declares no fn of that name",
                1,
            )
        }
        then "a WRAP over a declaration with no body is refused" {
            refused_n(
                packaged(
                    directive_use() +
                        "use @std.meta.{wrap_bodiless}\n@wrap_bodiless\nextern fn f() -> int\n1",
                ),
                "`@wrap_bodiless` asks to wrap `f`, which has no body to move",
                1,
            )
        }
        then "a WRAP whose wrapper redeclares a different signature is refused" {
            refused_n(
                packaged(
                    directive_use() +
                        "use @std.meta.{wrap_mismatch}\n@wrap_mismatch\nfn f(n: int) -> int { n }\nf(1)",
                ),
                "`@wrap_mismatch`'s wrapper for `f` does not redeclare its exact signature",
                1,
            )
        }
        then "a WRAP whose wrapper drops a static method's `static` is refused" {
            refused_n(
                packaged(
                    directive_use() +
                        "use @std.meta.{wrap_unstatic}\ntype P = { a: int }\nimpl P {\n    @wrap_unstatic\n    static fn m(n: int) -> int { n }\n}\nP.m(1)",
                ),
                "`@wrap_unstatic`'s wrapper for `m` does not redeclare its exact signature",
                1,
            )
        }
        then "a WRAP whose wrapper adds `mut fn` to a reading method is refused" {
            refused_n(
                packaged(
                    directive_use() +
                        "use @std.meta.{wrap_mutating}\ntype P = { a: int }\nimpl P {\n    @wrap_mutating\n    fn m(n: int) -> int { n }\n}\nP { a: 1 }.m(1)",
                ),
                "`@wrap_mutating`'s wrapper for `m` does not redeclare its exact signature",
                1,
            )
        }
        then "a twin naming ANY OTHER written binding is refused the same way" {
            refused_n(
                packaged(
                    directive_use() +
                        "use @std.meta.{other_twin}\nfn already() -> int { 0 }\n@other_twin\nfn raised_by(n: int) -> int { n }\nraised_by(1) + already()",
                ),
                "`@other_twin` generates `already`, which this file already declares",
                1,
            )
        }
        then "a generated declaration spanned in its template never owns this file's code" {
            let p = packaged(spanned_consumer())
            let main = p.files.find(it.view.source.file == "/w/src/main.av")
            match main {
                a? -> {
                    let findings = rule_findings(analysed(a), a.view.stmts)
                    findings.all(it.kind != "fns.dead_parameter") &&
                        match p.run() { .Ok(out) -> out == "17", .Err(_) -> false }
                }
                null -> false
            }
        }
        then "a derive's generated TYPE resolves from a struct literal, not just a generated fn from a call" {
            let p = packaged(
                "use @std.meta.{derive, Keyed}\n@derive(Keyed)\ntype T = { a: int }\nDeclKey { module: \"m\", x: 1 }.x + decl_probe()",
            )
            match p.run() { .Ok(out) -> out == "42", .Err(_) -> false }
        }
        then "a derive's generated `impl`'s own METHOD NAME is a hole" {
            let p = packaged(
                "use @std.meta.{derive, MethodNamed}\n@derive(MethodNamed)\ntype T = { a: int }\nT { a: 0 }.probed()",
            )
            match p.run() { .Ok(out) -> out == "7", .Err(_) -> false }
        }
    }
    given "validation" {
        then "a returned Diagnostic speaks once at the declaration" {
            let src = meta_use() +
                "fn reject(f: Fn) -> List<Diagnostic> { [Diagnostic { message: \"`\${f.name}` is forbidden\", help: null, at: null }] }\n" +
                "@reject\nfn forbidden() -> int { 1 }\nforbidden()"
            refused(src, "`forbidden` is forbidden")
        }
        then "a diagnostic can point at the field that caused it" {
            let src = meta_use() +
                "fn reject(t: Type) -> List<Diagnostic> { [Diagnostic { message: \"bad field\", help: null, at: t.fields[0].at }] }\n" +
                "@reject\ntype P = {\n    x: int\n}\n1"
            refused_at(src, "bad field", 5)
        }
        then "a declaration's NAME in an argument list is its meta value" {
            let src = "use @std.meta.{Type, Trait, Diagnostic}\n" +
                "trait Show {\n    fn show() -> int\n}\n" +
                "fn uses(t: Type, tr: Trait) -> List<Diagnostic> {\n    if t.name == \"P\" && tr.name == \"Show\" { [] } else { [Diagnostic { message: \"wrong pair\", help: null, at: null }] }\n}\n" +
                "@uses(Show)\ntype P = { x: int }\n1"
            packaged(src).clean()
        }
        then "a TYPE name in an argument seat crosses the same way" {
            let src = "use @std.meta.{Type, Diagnostic}\n" +
                "fn pair(t: Type, u: Type) -> List<Diagnostic> {\n    if t.name == \"P\" && u.name == \"Q\" { [] } else { [Diagnostic { message: \"wrong pair\", help: null, at: null }] }\n}\n" +
                "@pair(Q)\ntype P = { x: int }\ntype Q = { y: int }\n1"
            packaged(src).clean()
        }
    }
    given "warnings" {
        then "a deprecation warns at the use, not the declaration" {
            let p = packaged(
                deprecation_use() +
                    "@deprecated(\"use add\")\nfn sum(a: int, b: int) -> int { a + b }\nsum(1, 2)",
            )
            let out = checked(p)
            p.clean() &&
                out.contains("annotation.warning") &&
                out.contains("`sum` is deprecated — use add") &&
                out.contains("main.av:4") &&
                out.contains("used here")
        }
        then "a use before the declaration still warns — the marks are a query" {
            let p = packaged(
                deprecation_use() +
                    "fn call() -> int { sum(1, 2) }\n@deprecated(\"use add\")\nfn sum(a: int, b: int) -> int { a + b }\ncall()",
            )
            checked(p).contains("main.av:2")
        }
        then "a type deprecation reaches its uses too" {
            let p = packaged(
                deprecation_use() + "@deprecated(\"use Pt\")\ntype Old = { x: int }\nOld { x: 1 }.x",
            )
            checked(p).contains("`Old` is deprecated")
        }
    }
    given "argument evaluation" {
        then "an argument that reaches the world is refused before it runs" {
            let src = meta_use() +
                "extern fn avra_puts(s: string)\n" +
                "fn noisy() -> int { avra_puts(\"x\")\n1 }\n" +
                "fn mark(f: Fn, n: int) { }\n" +
                "@mark(noisy())\nfn answer() -> int { 1 }\nanswer()"
            refused(src, "reaches `avra_puts`")
        }
        then "an argument trap is reported once at its annotation" {
            let src = meta_use() +
                "fn boom() -> int { 1 / 0 }\n" +
                "fn mark(f: Fn, n: int) { }\n" +
                "@mark(boom())\nfn answer() -> int { 1 }\nanswer()"
            refused(src, "division by zero")
        }
    }
    given "@derive" {
        then "a trait's associated derive runs and its twin exists" {
            packaged(
                "use @std.meta.{derive, Show}\n@derive(Show)\nfn sum(a: int, b: int) -> int { a + b }\nsum(1, 2) + gen_sum(1, 2)",
            )
                .clean()
        }
        then "an argument that is not a trait refuses" {
            refused(
                "use @std.meta.{derive}\n@derive(Point)\ntype Point = { x: int }\n1",
                "`Point` is not a trait",
            )
        }
        then "a trait that declares no derive refuses" {
            refused(
                "use @std.meta.{derive, Empty}\n@derive(Empty)\nfn f() -> int { 1 }\nf()",
                "declares no `derive`",
            )
        }
    }
    given "every mark owes a reader" {
        then "a mark nothing reads is refused where it was written, once" {
            refused(
                "enum E {\n    @typo A(x: int)\n}\nfn f() -> int { 1 }\nf()",
                "`@typo` — nothing on this declaration reads it",
            )
        }
        then "a mark a derive claims stands" {
            packaged(
                "use @std.meta.{derive, Tagged}\n@derive(Tagged)\nenum E {\n    @frozen A(x: int)\n}\nfn f() -> int { 1 }\nf()",
            )
                .clean()
        }
        then "the unclaimed word alone is refused, and the help names the claims" {
            let p = packaged(
                "use @std.meta.{derive, Tagged}\n@derive(Tagged)\nenum E {\n    @frozen A(x: int)\n    @typo B(y: int)\n}\nfn f() -> int { 1 }\nf()",
            )
            refused_in(p, "`@typo` — nothing on this declaration reads it") &&
                p.report().contains("the marks read here are `@frozen`, `@widened`")
        }
        then "a derive that declares no `marks` claims nothing" {
            refused(
                "use @std.meta.{derive, Plainly}\n@derive(Plainly)\nenum E {\n    @frozen A(x: int)\n}\nfn f() -> int { 1 }\nf()",
                "`@frozen` — nothing on this declaration reads it",
            )
        }
        then "a FIELD WITH A DEFAULT is asked once, not twice — its default is a declaration of its own on the same statement" {
            packaged(
                "use @std.meta.{derive, Tagged}\n@derive(Tagged)\ntype R = {\n    @frozen a: int = 1,\n    b: int,\n}\nfn f() -> int { 1 }\nf()",
            )
                .clean()
        }
    }
    given "marks — degenerate shapes" {
        then "FIVE marks on one variant are five mistakes, not one" {
            refusals("enum E { @a @b @c @d @e A(x: int) }\n0") == 5
        }
        then "a mark with no member after it refuses at the mark" {
            refused_with("enum E { @m }\n0", "expected `}`")
        }
        then "a field's only mark still reaches the reader" {
            refused_with(
                "type R = { @m a: int }\n0",
                "`@m` — nothing on this declaration reads it",
            )
        }
    }
    given "marks — every expression in the argument slot" {
        // A MARK'S ARGUMENTS ARE EXPRESSIONS, never typed where they are
        // written: a reader splices the mark's call where it reads the
        // value. So each of these parses, and the one law left to speak
        // is the claim law — nothing on the declaration reads the mark.
        then "a NUMBER is an argument" {
            refused_with(
                "enum E { @m(1) A(x: int) }\n0",
                "`@m` — nothing on this declaration reads it",
            )
        }
        then "a STRING is an argument" {
            refused_with(
                "enum E { @m(\"a\") A(x: int) }\n0",
                "`@m` — nothing on this declaration reads it",
            )
        }
        then "a CALL is an argument" {
            refused_with(
                "enum E { @m(f()) A(x: int) }\n0",
                "`@m` — nothing on this declaration reads it",
            )
        }
        then "a DOTTED PATH is an argument" {
            refused_with(
                "enum E { @m(a.b) A(x: int) }\n0",
                "`@m` — nothing on this declaration reads it",
            )
        }
        then "a NAMED argument is an argument" {
            refused_with(
                "enum E { @m(most: 3) A(x: int) }\n0",
                "`@m` — nothing on this declaration reads it",
            )
        }
    }
    given "marks — malformed surface" {
        then "`@` with no name never becomes a mark — the lexer refuses it" {
            refused_with("enum E {\n    @ A(x: int)\n}\n0", "expected a name after `@`")
        }
        then "a doubled `@` says BOTH true things — the bad one, and the mark behind it" {
            refusals("enum E { @@m A(x: int) }\n0") == 2
        }
        then "a mark AFTER its member is not a mark" {
            refused_with("enum E { A(x: int) @m }\n0", "expected `}`")
        }
    }
    given "payload marks — alignment" {
        // A PAYLOAD IS A MEMBER TOO, and its marks are aligned by the same
        // windows. These attack the seam where a payload's mark could be
        // read as its SUCCESSOR's — the last payload of one variant
        // against the next variant's name, a middle payload against the
        // one after it — which is what a mark set short of the payload
        // anchors would do.
        then "the LAST payload's mark is not the NEXT variant's" {
            let src = formatted("enum E {\n    A(x: int, @m y: int)\n    B(z: int)\n}\n0")
            src.contains("A(x: int, @m y: int)") && !src.contains("@m B")
        }
        then "a MIDDLE payload's mark is not the next payload's" {
            let src = formatted("enum E {\n    A(@m x: int, y: int)\n}\n0")
            src.contains("A(@m x: int, y: int)") && !src.contains("@m y")
        }
        then "a variant's mark and its first payload's are told apart" {
            formatted("enum E {\n    @outer A(@inner x: int)\n}\n0")
                .contains("@outer A(@inner x: int)")
        }
        then "a payload-free variant between two marked ones takes neither" {
            let src = formatted("enum E {\n    @a A(x: int)\n    B\n    @c C(@d y: int)\n}\n0")
            src.contains("@a A(x: int)") &&
                src.contains("@c C(@d y: int)") &&
                !src.contains("@a B") &&
                !src.contains("@c B")
        }
        then "a one-line declaration aligns as the spread one does" {
            let src = formatted("enum E { @a A(@b x: int) @c C(@d y: int) }\n0")
            src.contains("@a A(@b x: int)") && src.contains("@c C(@d y: int)")
        }
        then "a payload's ANGLE BRACKETS do not move the window" {
            formatted("enum E {\n    A(@m x: Map<string, int>, @n y: List<int>)\n}\n0")
                .contains("A(@m x: Map<string, int>, @n y: List<int>)")
        }
    }
    given "payload marks — malformed surface" {
        // ONE LINE EACH, DELIBERATELY: spread over three lines every one
        // of these refuses TWICE — the member list ends at the stray `@`
        // and the enum's brace then goes missing, so "expected EOF"
        // follows. That cascade is the variant-level surface's too
        // (`@m(1) A(x: int)` says both), so it is pinned where the word
        // slot's wording is and not re-litigated here.
        then "a mark AFTER the payload name is not a mark" {
            refused_with("enum E { A(x @m: int) }\n0", "expected `}`")
        }
        then "a mark AFTER the colon is not a mark" {
            refused_with("enum E { A(x: @m int) }\n0", "expected `}`")
        }
        then "a mark AFTER the type is not a mark" {
            refused_with("enum E { A(x: int @m) }\n0", "expected `}`")
        }
        then "a mark with no payload behind it refuses" {
            refused_with("enum E { A(x: int, @m) }\n0", "expected `}`")
        }
        then "a mark inside a TYPE ARGUMENT is not a mark" {
            refused_with("enum E { A(x: List<@m int>) }\n0", "expected `}`")
        }
        then "FIVE marks on one payload are five mistakes, not one" {
            refusals("enum E { A(@a @b @c @d @e x: int) }\n0") == 5
        }
        then "a POSITIONAL payload carries one" {
            refused_with("enum E { A(@m int) }\n0", "`@m` — nothing on this declaration reads it")
        }
    }
    given "a derive's own seat" {
        then "a trait whose `derive` takes a `Type` refuses a fn, at the annotation" {
            refused(
                "use @std.meta.{derive, Tagged}\n@derive(Tagged)\nfn g() -> int { 2 }\nfn f() -> int { 1 }\nf()",
                "`Tagged`'s `derive` takes `Type`, and this is a fn",
            )
        }
        then "a trait whose `derive` takes `Named` still crosses anything" {
            packaged(
                "use @std.meta.{derive, Show}\n@derive(Show)\nfn sum(a: int, b: int) -> int { a + b }\nsum(1, 2) + gen_sum(1, 2)",
            )
                .clean()
        }
    }
    given "a package-namespaced kind" {
        then "a kinded refusal renders under the annotation's package, and is the one diagnostic" {
            let p = audited(audit_use() + "@audited\nfn f() -> int {\n    1\n}\nf()\n")
            let diagnostics = said(p)
            diagnostics.length == 1 &&
                diagnostics[0].kind == "@acme/audit:E1" &&
                p.report().starts_with("error[@acme/audit:E1]: `f` is audited\n")
        }
        then "a kind-less refusal stays annotation.said" {
            let p = audited(audit_use() + "@plain\nfn f() -> int {\n    1\n}\nf()\n")
            let diagnostics = said(p)
            diagnostics.length == 1 &&
                diagnostics[0].kind == "annotation.said" &&
                p.report().starts_with("error[annotation.said]: `f` is plain\n")
        }
        then "a root program's kind wears its own manifest name" {
            let p = packaged(
                "use @std.meta.{Fn, Diagnostic, refuse_as}\nfn check(f: Fn) -> List<Diagnostic> { [refuse_as(\"E7\", \"`\${f.name}` is bare\")] }\n@check\nfn f() -> int {\n    1\n}\nf()\n",
            )
            p.report().starts_with("error[app:E7]: `f` is bare\n")
        }
        then "`explain` finds every kind the package's source spells, in a branch too, spoken or not — and misses one it does not" {
            let p = audited(audit_use() + "fn f() -> int {\n    1\n}\nf()\n")
            let rows = p.kind_rows()
            let e1 = rows.find(it.kind == "@acme/audit:E1")
            let e2 = rows.find(it.kind == "@acme/audit:E2")
            p.clean() &&
                e1 != null &&
                e1!.summary == "spoken by `@audited`" &&
                e2 != null &&
                e2!.summary == "a quiet fn" &&
                rows.find(it.kind == "@acme/audit:E9") == null
        }
        then "a kind that is not a word is the annotation's mistake, spoken in place of its verdict" {
            let p = audited(audit_use() + "@blank\nfn f() -> int {\n    1\n}\nf()\n")
            let diagnostics = said(p)
            diagnostics.length == 1 &&
                p.report().starts_with("error[annotation.kind]: an annotation's kind is a word\n") &&
                p.report().contains("`@blank` named ``, saying: `f` is blank")
        }
        then "a kinded WARNING wears its package at the use" {
            let p = audited(audit_use() + "@old\nfn f() -> int {\n    1\n}\nf()\n")
            let diagnostics = said(p)
            p.clean() &&
                diagnostics.length == 1 &&
                diagnostics[0].kind == "@acme/audit:W1" &&
                p.warnings().starts_with("warning[@acme/audit:W1]: `f` is old\n")
        }
        then "the registry reaches a dependency through the package's own entry, as `avra docs` does" {
            mut ws = audit_workspace(audit_use() + "fn f() -> int {\n    1\n}\nf()\n")
            let p = ws.program(ws.entry_of())
            p.clean() && p.kind_rows().find(it.kind == "@acme/audit:E1") != null
        }
        then "a kind an annotation SPOKE is registered under its message" {
            let p = audited(audit_use() + "@quiet\nfn never() -> int {\n    1\n}\nnever()\n")
            let rows = p.kind_rows()
            let e2 = rows.find(it.kind == "@acme/audit:E2")
            !p.clean() &&
                e2 != null &&
                e2!.summary == "a quiet fn" &&
                p.report().starts_with("error[@acme/audit:E2]: a quiet fn\n")
        }
    }
}
