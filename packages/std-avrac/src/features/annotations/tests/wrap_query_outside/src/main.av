// proves: a WRAP annotation from another package holds when the file's
// expansion re-runs to settle — `@relation` beside `@query` makes it
// re-run, and the moved body is never wrapped a second time.
use @std.relation.{relation, query}
use @std.relation.db.{Db, new_db}

@relation
type Note = { @index tag: string }

@query
fn tagged(db: Db, tag: string) -> int { Note.by_tag(db, tag).length }

let db = new_db()
let _ = Note.insert(db, tag: "x")
let _ = Note.insert(db, tag: "y")
let _ = Note.insert(db, tag: "x")
"${tagged(db, "x")} ${tagged(db, "z")}"
