//! THE `@` SURFACE, both halves. `@name(args)` before a DECLARATION
//! is an ANNOTATION — a call the compiler makes over the declaration
//! at compile time. It is a fact of the declaration it crosses (the
//! store's `annotations_of`), never a node of its own: its callee is
//! an ident and its arguments are expressions, so every pass reads
//! them as it reads any expression.
//!
//! `@word` or `@word(a, b)` before a declared MEMBER — a variant, a
//! field — is a MARK, and A MARK IS DATA WHERE AN ANNOTATION IS A
//! CALL. It is recorded on the member and handed to whoever reads it;
//! nothing runs. That is why its arguments are WORDS and not
//! expressions: a mark is read while the file's names are still
//! resolving, so it can reach only what the parse holds — the same
//! law that makes a Declares annotation's argument a literal, one
//! notch stricter. The `mark` rule lives here because the `@` surface
//! is one feature's; the members that may carry one are spelled by
//! the features that declare them.
use features.{LanguageFeature, BuilderRow}
use diagnostics.{DiagCode}
use grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}

export fn annotations() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name        | build
        "annotated" | build_annotated
        "mark"      | build_mark
    }
    let codes = table<DiagCode> {
        kind                    | id      | summary
        "annotation.callee"     | "F2065" | "an annotation names a fn over a declaration"
        "annotation.receiver"   | "F2066" | "an annotation's first seat says what it takes"
        "annotation.seats"      | "F2067" | "an annotation's arguments fill its seats"
        "annotation.answer"     | "F2068" | "an annotation answers an effect"
        "annotation.said"       | "F2069" | "an annotation refused this declaration"
        "annotation.kind"       | "F2079" | "an annotation's kind is a word — `[A-Za-z0-9_-]+`, like `E1`"
        "annotation.generated_taken" | "F2077" | "an annotation generates a name the file already declares"
        "annotation.warning"    | "F2071" | "a declaration's warning, spoken at a use"
        "annotation.derive"     | "F2072" | "`@derive` names a trait that declares `derive`"
        "annotation.unsettled"  | "F2070" | "an annotation could not run"
        "annotation.meta"       | "F2084" | "the compiler crosses `@std/meta`'s own shapes"
        "annotation.unplaceable" | "F2085" | "a hole was filled with something no seat can hold"
        "annotation.unread_mark" | "F2086" | "every mark is read by something that claims it"
    }
    component LanguageFeature f {
        name = "annotations"
        docs = "`@name(args)` above a declaration — the compiler calls `name` over the declaration at compile time."
        gram = grammar {
            stmt = a:PKG ( "(" ( e:expression ( "," e:expression )* ","? )? ")" )? BREAK? d:stmt -> annotated(a, e, d)
            mark = m:PKG ( "(" ( g:NAME ( "," g:NAME )* ","? )? ")" )? -> mark(m, g)
        }
        diags = codes
        builders = rows
    }
    f
}
