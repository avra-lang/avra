//! Parse-time lowering: the annotation lands on the declaration it
//! crosses, as a fact; the declaration itself is the node answered.
use core.{Expr, Annotation}
use features.{LangNode, Builder}

fn build_annotated(mut b: Builder) -> Result<LangNode, string> {
    let name = b.token(0)?
    let args = b.exprs(1)?
    let d = b.stmt(2)?
    // the token carries its `@`; the callee is the name behind it
    let callee = b.store.alloc_expr(Expr.Ident(name.text.substring(1, name.text.length)), name.span)
    b.store.annotate(d, Annotation { callee: callee, args: args, span: b.span })
    .Ok(LangNode.NStmt(d))
}
