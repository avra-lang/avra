//! Parse-time lowering: the annotation lands on the declaration it
//! crosses, as a fact; the declaration itself is the node answered.
use core.{
    Expr,
    Stmt,
    ExprId,
    Span,
    Annotation,
    Mark,
    MarkArg,
    Scoped,
    BodyView,
    SyntaxArena,
    Slots,
    Built,
    computed,
    flatten,
    some_list,
}
use features.{arg_text}

/// `@name(args)` before a declaration: the annotation filed on it, the
/// declaration answered.
@computed
fn annotated_written(s: dyn Slots) -> Result<Built, string> {
    let store = s.arena()
    let d? = (s.stmts_of("decl")?).first() else { return .Err(no_declaration()) }
    let word = mark_word(s.text_of("name")?)
    let named_at? = s.at_of("name")? else { return .Err(no_place()) }
    let args = s.exprs_of("args")?
    let callee = store.alloc_expr(Expr.Ident(Scoped(word)), named_at)
    let _ = applied(store, word, args, s.built_at() ?? named_at)
    store
        .annotate_before(d, Annotation { name: word, callee: callee, args: args, span: s.built_at() })
    .Ok(Built.Stmt(d))
}

/// A MARK on a declared member: the word behind the `@`, each
/// argument's words, and the call a reader may splice. Nothing here
/// is walked where it is written.
@computed
fn mark_written(s: dyn Slots) -> Result<Built, string> {
    let store = s.arena()
    let name = mark_word(s.text_of("name")?)
    let named_at? = s.at_of("name")? else { return .Err(no_place()) }
    let args = s.exprs_of("args")?
    let at = s.built_at() ?? named_at
    .Ok(
        Built
            .Marked(
                Mark {
                    name: name,
                    args: [arg_text(store, e) for e in args if store.arg_label(e) == null],
                    named: flatten([some_list(named_arg(store, e)) for e in args]),
                    span: at,
                    call: applied(store, name, args, at),
                },
            ),
    )
}

/// The word behind a `@`: the token carries it.
fn mark_word(written: string) -> string { written.substring(1, written.length) }

/// An argument written `label: value`, as the pair a mark carries.
fn named_arg(store: SyntaxArena, e: ExprId) -> MarkArg? {
    let label? = store.arg_label(e) else { return null }
    MarkArg { label: label, value: arg_text(store, store.unnamed(e)) }
}

/// `@name(args)` as the TEMPLATE `quote { name(${0}, args) }`, marked
/// where the `@` stands: a reader fills the hole with the value the
/// annotation judges and splices the call where it reads it, so the
/// call is typed there and its refusals point here.
fn applied(store: SyntaxArena, name: string, args: List<ExprId>, at: Span) -> ExprId {
    let value = store.alloc_expr(Expr.Ident(Scoped("value")), at)
    let hole = store.alloc_expr(Expr.Ident(Scoped("\${0}")), at)
    store.mark_hole(hole)
    let call = store.alloc_expr(Expr.Call(Scoped(name), [], [hole].concat(args)), at)
    // placeless, so no doc comment takes it for the declaration it wraps
    let body = [store.alloc_stmt(Stmt.ExprStmt(call))]
    let q = store
        .alloc_expr(Expr.Body("quote", ["${name}(", ")"], [value], BodyView.Verbatim(body, [])), at)
    store.mark_quote_at(q)
    q
}

// ── voices ──

fn no_declaration() -> string {
    "defect: an annotation's rule built no declaration — the grammar and the door disagree"
}

fn no_place() -> string { "defect: an `@` word with no place — the arena and the grammar disagree" }
