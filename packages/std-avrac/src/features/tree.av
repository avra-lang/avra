//! THE PROCESS'S TREE: every path a durable spelling or a generated place names is spelled
//! from the checkout the process's workspace stands in, so two checkouts of one tree write the
//! same bytes.
use @std.relation.stable.{saved_in, unsaved_in}

/// The tree the process's workspace stands in: a key spells every path under it from the
/// tree, so the same tree checked out elsewhere names the same rows. Set where a workspace is
/// made, before any key is.
once fn keyed_tree() -> Cell<string> { Cell.new("") }

/// The process's keys are spelled from `tree` from now on.
export fn keys_spelled_from(tree: string) { keyed_tree().set(tree) }

/// A hand-written wire's text as a saved row spells it: every path under the process's tree
/// spelled from it.
export fn tree_saved(text: string) -> string { saved_in(keyed_tree().get(), text) }

/// A saved wire's text read under the tree the process stands in now.
export fn tree_unsaved(text: string) -> string { unsaved_in(keyed_tree().get(), text) }
