//! The lowering rule of `let`: the value lowered, and its name bound to the register that holds it;
//! a task it holds is joined where its scope ends.
use core.{Bound, Lowering, StmtId, StmtLowers}
use core.stmt.{Let}

impl StmtLowers for Let {
    fn stmt_lowered(mut cx: Lowering, s: StmtId) {
        let r = cx.lower(self.value)
        let ty? = cx.binding_type(self.ty, self.value) else { return cx.missed("an untyped `let`") }
        cx.bind(self.name.of, Bound.Value(r, ty))
        cx.owns(r, ty)
    }
}
