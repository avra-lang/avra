// proves: a `let` takes a list apart past its head, refused to an `else`, and a record into its
// fields.
type P = { x: int, y: int }
fn f(xs: List<int>) -> int {
    let [a, ..rest] = xs else { return 0 }
    a + rest.length
}
fn g(p: P) -> int {
    let P { x, y } = p
    x * y
}
"${f([5, 6, 7])} ${g(P { x: 2, y: 3 })}"
