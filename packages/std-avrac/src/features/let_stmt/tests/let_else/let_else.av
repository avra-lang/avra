// proves: `let v? = e else { ... }` — bind through absence, keep
// going. A present subject binds its carried value in the ENCLOSING
// scope; an absent one leaves through the else, debts settled at
// the exit (the owned string proves it). Both reprs: the niche's
// pointer and the scalar pair.
type User = { age: int }

fn find_user(id: int) -> User? {
    if id == 7 { User { age: 36 } } else { null }
}

fn age_of(id: int) -> int {
    let u? = find_user(id) else {
        return 0 - 1
    }
    u.age
}

fn word(b: bool) -> string? { if b { "hey" } else { null } }

fn shouted(b: bool) -> string {
    let w? = word(b) else {
        return "quiet"
    }
    "${w}!"
}

fn pair_sum(a: int?, b: int?) -> int {
    let x? = a else {
        return 0 - 9
    }
    let y? = b else {
        return 0 - 9
    }
    x + y
}

fn churn(id: int) -> int {
    let held = "kept ${id}"
    let u? = find_user(id) else {
        return 0 - held.length
    }
    u.age + held.length
}

"a ${age_of(7)} ${age_of(3)} s ${shouted(true)} ${shouted(false)} p ${pair_sum(4, 2)} ${pair_sum(4, null)} c ${churn(7)} ${churn(3)}"
