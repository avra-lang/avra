// The first real statement, end to end through the driver: `let x =
// 1 + y` into the arena, spans engine-attributed, and a broken
// statement costing one diagnostic while its neighbors parse around
// the visible hole.
use @std.avrac.core.{Expr, BinOp}
use @std.avrac.language.{assemble, parse_program, ParsedProgram}
use @std.avrac.features.stmt_spine.{stmt_spine}
use @std.avrac.features.let_stmt.{let_stmt}
use @std.avrac.features.expr_spine.{expr_spine}

/// This feature subset: programs of lets only.
fn parse_prog(source: string) -> ParsedProgram {
    parse_program(assemble([stmt_spine(), let_stmt(), expr_spine()]), null, source)
}

spec "features/let_stmt" {
    given "let x = 1 + y" {
        then "one Let lands in the arena with the expression tree under it" {
            let p = parse_prog("let x = 1 + y")
            let shape_ok = p.diagnostics.length == 0 && p.stmts.length == 1
            let tree_ok = if shape_ok {
                match p.store.stmt(p.stmts[0]) {
                    .Let(name, value) -> name == "x" && match p.store.expr(value) {
                        .Binary(op, l, r) -> op == BinOp.Add &&
                            p.store.expr(l) is .IntLit && p.store.expr(r) is .Ident,
                        .IntLit(_) -> false, .Ident(_) -> false, .Error -> false,
                    },
                    .ExprStmt(_) -> false, .Error -> false,
                }
            } else { false }
            shape_ok && tree_ok
        }
        then "the statement's span covers the whole line, engine-attributed" {
            let p = parse_prog("let x = 1 + y")
            let s = p.store.stmt_span(p.stmts[0])
            s?.lo == 0 && s?.hi == 13
        }
    }
    given "several statements" {
        then "lets accumulate in source order" {
            let p = parse_prog("let a = 1\nlet b = 2")
            let names_ok = if p.stmts.length == 2 {
                let a_ok = match p.store.stmt(p.stmts[0]) {
                    .Let(name, _) -> name == "a",
                    .ExprStmt(_) -> false, .Error -> false,
                }
                let b_ok = match p.store.stmt(p.stmts[1]) {
                    .Let(name, _) -> name == "b",
                    .ExprStmt(_) -> false, .Error -> false,
                }
                a_ok && b_ok
            } else { false }
            p.diagnostics.length == 0 && names_ok
        }
    }
    given "a broken statement between good ones" {
        then "one diagnostic, a visible hole, and whole neighbors" {
            let p = parse_prog("let a = 1\nlet = 3\nlet y = 2")
            let hole_ok = p.stmts.length == 3 && p.store.stmt(p.stmts[1]) is .Error
            let tail_ok = if p.stmts.length == 3 {
                match p.store.stmt(p.stmts[2]) {
                    .Let(name, _) -> name == "y",
                    .ExprStmt(_) -> false, .Error -> false,
                }
            } else { false }
            p.diagnostics.length == 1 && hole_ok && tail_ok
        }
    }
}
