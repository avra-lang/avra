// proves: a `let` takes a list's first two, its last, and a record's fields by name, each on the
// program layer.
type P = { x: int, y: int }
fn heads(xs: List<string>) -> string {
    let [first, second, ..] = xs else { return "-" }
    first + second
}
fn tail_sum(xs: List<int>) -> int {
    let [.., last] = xs else { return 0 }
    last
}
fn swap(p: P) -> P {
    let P { x, y } = p
    P { x: y, y: x }
}
"${heads(["a", "b", "c"])} ${heads(["z"])} ${tail_sum([1, 2, 3])} ${swap(P { x: 1, y: 2 }).x}"
