//! The typing rules of `let` and `mut`: a value checked against its annotation, or read as it is,
//! and its name bound to the type.
use core.{Checking, Checks, ExprId, Expected, SignedType, StmtChecks, StmtId, TypeRef}
use core.expr.{LetPattern}
use core.stmt.{Let, MutLet}

impl StmtChecks for Let {
    fn stmt_checked(mut cx: Checking, s: StmtId) { bound_to(cx, self.name.of, self.ty, self.value, true) }
}

impl StmtChecks for MutLet {
    fn stmt_checked(mut cx: Checking, s: StmtId) { bound_to(cx, self.name.of, self.ty, self.value, false) }
}

/// `value` checked against `annotation` when one is written, and `name` bound to the annotation's
/// type, else to the value's; a `let` narrows, a `mut` can be written again and doesn't.
fn bound_to(mut cx: Checking, name: string, annotation: TypeRef?, value: ExprId, narrowable: bool) {
    let declared: SignedType? = if annotation == null { null } else { cx.written(annotation!) }
    let read = cx
        .check(value, if declared == null { Expected.Free } else { Expected.Exactly(declared!) })
    cx.bind(name, declared ?? read, narrowable)
}

impl Checks for LetPattern {
    /// `let P = v else { … }` and what follows it: the pattern binds against `v` for the rest, which is
    /// the value; the else checks as a dropped value.
    fn checked(mut cx: Checking, e: ExprId, expected: Expected) -> SignedType? {
        let subject = cx.check(self.subject, Expected.Free)
        if self.otherwise != null { let _ = cx.check(self.otherwise!, Expected.Dropped) }
        cx.opened()
        cx.check_pat(self.pat, subject)
        let rest = if self.rest == null { null } else { cx.check(self.rest!, expected) }
        cx.closed()
        rest
    }
}
