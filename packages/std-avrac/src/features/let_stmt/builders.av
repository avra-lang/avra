//! Parse-time lowering: captures -> the Let statement.
use core.{Stmt, Expr, ExprId, some_list, Scoped}
use features.{LangNode, Builder, expr_id_at, pat_ids_at}
/// `let b? = s else { ... }` — this feature owns the PARSE (the
/// branch must try before the recovering plain-let); nullability
/// gives the node meaning.
/// `let x? = subject { … } else { … }` — the subject may take ONE
/// trailing block; the `else` is the let's own, never a second seat.
fn build_let_else(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let s = b.trailed(b.expr(1)?, some_list(expr_id_at(b.args, 2)))?
    let e = b.stmts(3)?
    b.make_stmt(Stmt.LetElse(Scoped(n.text), s, e))
}

/// `let pattern = subject [else { … }]` — a node still waiting for its
/// block, wrapped in the statement that evaluates the subject; the block
/// this statement ends up in folds the statements after it into the node
/// (`Builder.folded_lets`).
fn build_let_pattern(b: Builder) -> Result<LangNode, string> {
    let pats = pat_ids_at(b.args, 0)
    let subject = b.expr(1)?
    let else_stmts = b.stmts(2)?
    let otherwise: ExprId? = if else_stmts.is_empty() { null } else { b.block_at(else_stmts, b.extent_of(else_stmts)) }
    b
        .wrap_stmt(
            b
                .store
                .alloc_stmt(
                    Stmt.ExprStmt(b.expr_node(Expr.LetPattern(pats[0], subject, otherwise, null))),
                    b.span,
                ),
        )
}
