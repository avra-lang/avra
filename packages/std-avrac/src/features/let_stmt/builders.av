//! Parse-time lowering: captures -> the Let statement.
use core.{Stmt, some_list, Scoped}
use features.{LangNode, Builder, expr_id_at}

/// `let _ = v` — the value asked for its effect; the expression
/// statement's meaning, never a block's answer.
fn build_discard(b: Builder) -> Result<LangNode, string> {
    b.make_stmt(Stmt.Discard(b.expr(0)?))
}

/// `state n: T = v` — a PLACE: the binding holds a Cell the body owns, a
/// read answers the `T` it holds, and a write assigns it. The builder
/// spells the LET and MARKS it; typing gives the binding its Cell and
/// lowering mints it, so reads and writes go through the one place.
fn build_state(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let t = b.type_refs(1)?
    let v = b.expr(2)?
    let s = b.store.alloc_stmt(Stmt.MutLet(Scoped(n.text), t.first(), v), b.span)
    b.store.mark_state(s)
    .Ok(LangNode.NStmt(s))
}

fn build_let(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let t = b.type_refs(1)?
    let v = b.expr(2)?
    b.make_stmt(Stmt.Let(Scoped(n.text), t.first(), v))
}

/// `let b? = s else { ... }` — this feature owns the PARSE (the
/// branch must try before the recovering plain-let); nullability
/// gives the node meaning.
/// `let x? = subject { … } else { … }` — the subject may take ONE
/// trailing block; the `else` is the let's own, never a second seat.
fn build_let_else(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let s = b.trailed(b.expr(1)?, some_list(expr_id_at(b.args, 2)))?
    let e = b.stmts(3)?
    b.make_stmt(Stmt.LetElse(Scoped(n.text), s, e))
}
