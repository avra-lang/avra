//! The let statement's StmtSemantics: walk the value, then bind —
//! the driver owns the binding law, the slot, and the scope. A NAMED
//! INSTANCE (`secret api`) is a statement of its own that binds AND
//! leaves its value, so a `collect` around it keeps it as a child.
use core.{StmtId, ExprId, TypeId, Reg}
use core.stmt.{Let}
use core.expr.{LetPattern}
use features.{StmtSemantics, Meaning, ResolveCx, TypeCx, LowerCx, nothing}

impl StmtSemantics for Let {
    fn resolve_stmt(mut cx: ResolveCx, s: StmtId) {
        cx.walk_value(s)
        cx.bind_checked(s)
    }

    fn type_stmt(mut cx: TypeCx, s: StmtId) {
        plant_let(cx, s)
        cx.walk_value(s)
        check_let(cx, s)
        if cx.view.store.is_component_inst(s) { cx.gather(s) }
    }

    fn lower_stmt(mut cx: LowerCx, s: StmtId) -> Reg? {
        let r = cx.lower_value(s)
        if cx.view.store.is_component_inst(s) { cx.gather(s) }
        r
    }
}

/// A destructuring `let` types and lowers as the match it means.
impl Meaning for LetPattern {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        if self.rest == null { return unfolded_let(cx, e) }
        cx.meant_type(e)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        cx.meant_reg(e)
    }
}
