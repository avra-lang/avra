//! The let statement's StmtSemantics: walk the value, then bind —
//! the driver owns the binding law, the slot, and the scope.
use core.{NodeStore, StmtId, ExprId, Reg}
use features.{StmtSemantics, StmtResolveCx, StmtTypeCx, StmtEvalCx, StmtLowerCx}

export type LetStmtSemantics = { }

impl StmtSemantics for LetStmtSemantics {
    fn binds(self, store: NodeStore, s: StmtId) -> string? {
        match store.stmt(s) {
            .Let(name, _) -> name,
            _ -> null,
        }
    }

    fn value_of(self, store: NodeStore, s: StmtId) -> ExprId? {
        match store.stmt(s) {
            .Let(_, v) -> v,
            _ -> null,
        }
    }

    fn resolve_stmt(self, cx: StmtResolveCx, s: StmtId) {
        let v: ExprId? = cx.store.stmt_value(s)
        if v != null { cx.walk(v!) }
        cx.bind_checked(s)
    }

    fn type_stmt(self, cx: StmtTypeCx, s: StmtId) {
        let v: ExprId? = cx.store.stmt_value(s)
        if v != null { cx.walk(v!) }
    }

    fn eval_stmt(self, cx: StmtEvalCx, s: StmtId) -> ExprId? {
        let v: ExprId? = cx.store.stmt_value(s)
        if v == null { return null }
        cx.eval(v!)
    }

    fn lower_stmt(self, cx: StmtLowerCx, s: StmtId) -> Reg? {
        let v: ExprId? = cx.store.stmt_value(s)
        if v == null { return null }
        cx.lower(v!)
    }
}
