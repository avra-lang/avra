//! The let statement's StmtSemantics: walk the value, then bind —
//! the driver owns the binding law, the slot, and the scope.
use core.{StmtId, Reg}
use features.{StmtSemantics, StmtResolveCx, StmtTypeCx, StmtLowerCx}

export type LetStmtSemantics = { }

impl StmtSemantics for LetStmtSemantics {
    fn resolve_stmt(mut cx: StmtResolveCx, s: StmtId) {
        cx.walk_value(s)
        cx.bind_checked(s)
    }

    fn type_stmt(mut cx: StmtTypeCx, s: StmtId) {
        plant_let(cx, s)
        cx.walk_value(s)
        check_let(cx, s)
    }

    fn lower_stmt(mut cx: StmtLowerCx, s: StmtId) -> Reg? {
        cx.lower_value(s)
    }
}
