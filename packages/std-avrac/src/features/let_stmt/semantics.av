//! The let statement's StmtSemantics: walk the value, then bind —
//! the driver owns the binding law, the slot, and the scope. A NAMED
//! INSTANCE (`secret api`) is a statement of its own that binds AND
//! leaves its value, so a `collect` around it keeps it as a child.
use core.{StmtId, Reg}
use core.stmt.{Let}
use features.{StmtSemantics, ResolveCx, TypeCx, LowerCx}

impl StmtSemantics for Let {
    fn resolve_stmt(mut cx: ResolveCx, s: StmtId) { LetStmtSemantics {}.resolve_stmt(cx, s) }

    fn type_stmt(mut cx: TypeCx, s: StmtId) { LetStmtSemantics {}.type_stmt(cx, s) }

    fn lower_stmt(mut cx: LowerCx, s: StmtId) -> Reg? { LetStmtSemantics {}.lower_stmt(cx, s) }
}

export type LetStmtSemantics = {}

impl StmtSemantics for LetStmtSemantics {
    fn resolve_stmt(mut cx: ResolveCx, s: StmtId) {
        cx.walk_value(s)
        cx.bind_checked(s)
    }

    fn type_stmt(mut cx: TypeCx, s: StmtId) {
        plant_let(cx, s)
        cx.walk_value(s)
        check_let(cx, s)
        if cx.view.store.is_component_inst(s) { cx.gather(s) }
    }

    fn lower_stmt(mut cx: LowerCx, s: StmtId) -> Reg? {
        let r = cx.lower_value(s)
        if cx.view.store.is_component_inst(s) { cx.gather(s) }
        r
    }
}
