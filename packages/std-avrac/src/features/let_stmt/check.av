//! The let's typing law: an ANNOTATED binding holds what it
//! declares — the shared declared-binding law, aimed by name. An
//! unannotated let keeps inferring from its value.
use core.{StmtId, ExprId, TypeRef}
use features.{TypeCx}

/// BEFORE the value walks: the declaration records, and the want
/// plants — a lambda or literal underneath hears its slot.
export fn plant_let(mut cx: TypeCx, s: StmtId) {
    let ann: TypeRef? = cx.view.store.binding_ty(s)
    if ann == null { return }
    let declared = cx.bind_declared(s, ann!)
    let v: ExprId? = cx.view.store.stmt_value(s)
    if v != null { cx.plant_want(v!, declared) }
}

/// AFTER: the walked value must be what the name declared.
export fn check_let(mut cx: TypeCx, s: StmtId) {
    let v: ExprId? = cx.view.store.stmt_value(s)
    if v == null { return }
    if cx.refuses_void_value(v!) { return }
    if cx.view.store.binding_ty(s) == null { return }
    cx.declared_binding(v!, cx.view.store.let_name(s) ?? "this binding", cx.def_type(s))
}
