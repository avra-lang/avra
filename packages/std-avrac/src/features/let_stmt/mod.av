//! `let` — name a value. The first statement feature: its `stmt`
//! branch merges into the spine's program, and its recovery point
//! makes a broken statement cost one diagnostic, not the parse.
use features.{LanguageFeature, BuilderRow}
use diagnostics.{DiagCode}

export fn let_stmt() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name       | build
        "let_stmt" | build_let
        "let_else" | build_let_else
    }
    let codes = table<DiagCode> {
        kind           | id      | summary
        "type.binding" | "F2024" | "an annotated binding holds what it declares"
    }
    component LanguageFeature f {
        name = "let_stmt"
        docs = "`let <name> = <expression>` — or `let <name>: <type> = <expression>`, the binding holding what it declares; `let <name>? = <e> else { ... }` binds through absence."
        gram = """
stmt = "let" b:NAME "?" "=" s:expression "else" "{" BREAK ( e:stmt | BREAK )* "}" BREAK -> let_else(b, s, e)
stmt = "let" n:NAME ( ":" t:type )? "=" v:expression BREAK @recover(sync_to: "BREAK") -> let_stmt(n, t, v)
"""
        diags = codes
        builders = rows
    }
    f
}
