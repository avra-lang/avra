//! `let` — name a value. The first statement feature: its `stmt`
//! branch merges into the spine's program, and its recovery point
//! makes a broken statement cost one diagnostic, not the parse.
//! `let name = expression`, or `let name: type = expression`, the
//! binding holding what it declares; `let name? = e else { … }`
//! binds through absence; `let _ = expression` runs it and keeps
//! nothing. `let [a, ..rest] = xs` and `let P { x, y } = p` take a value
//! apart by a pattern, `else { … }` for the shapes it may refuse; the
//! pattern scopes over the rest of the block as a `match` arm's does.
use features.{LanguageFeature}
use features.let_stmt.{unmutated_mut}
use @std.grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use diagnostics.{DiagCode, Remedy}

export fn let_stmt() -> LanguageFeature {
    let codes = table<DiagCode> {
        kind               | summary                                       | remedy
        "type.binding"     | "an annotated binding holds what it declares" | Remedy.Fix
        "type.let_pattern" | "a destructuring `let` stands inside a block" | Remedy.Help
    }
    LanguageFeature let_stmt {
        gram: grammar {
            stmt = "let" "_" "=" value:expression END -> Stmt.Discard
            stmt = "let" name:NAME "?" "=" subject:expression ( trailing:trailing )? "else" "{" ( stmts:stmt | BREAK )* "}" END -> Stmt.LetElse by let_else_written @head(subject)
            stmt = "let" pat:destructure "=" subject:expression ( "else" "{" ( otherwise:stmt | BREAK )* "}" )? END -> Expr.LetPattern by let_pattern_written
            stmt = "let" name:NAME ( ":" ty:type )? "=" value:expression END @recover(sync_to: "END") -> Stmt.Let
            stmt = is_state:STATE name:NAME ( ":" ty:type )? "=" value:expression END -> Stmt.MutLet
        }
        diags: codes
    }
    let_stmt
}
