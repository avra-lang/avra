//! Strings — `"hello"` and `"a ${x} b"`. The literal's branch
//! merges into the spine's `primary`; interpolation is this
//! feature GROWING: the lexer hands it ISTR pieces and the holes
//! are ordinary expressions. The text vocabulary is its method
//! rows, each one runtime call.
//!
//! Both rules NAME their node, so this feature has no builders: the
//! repeated `parts` and `holes` labels each fill one list in source
//! order, which is also what retired interpolation's hand-written
//! check that the two lists agree — the payload's arity IS the
//! grammar's.
use features.{LanguageFeature, PropertyRow, MethodRow, ReceiverEffect, measured_reg, lower_is_empty, BuilderRow}
use grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use diagnostics.{DiagCode}

export fn str_lit() -> LanguageFeature {
    let builders = table<BuilderRow> {
        name        | build
        "body_text" | build_body_text
        "str_lit"   | build_str_lit
    }
    let codes = table<DiagCode> {
        kind               | id      | summary
        "type.interp_hole" | "F2007" | "an interpolation hole prints as a scalar or string"
    }
    let methods = table<MethodRow> {
        name          | takes  | check             | lower | effect
        "contains"    | on_str | check_contains    | lower_contains | ReceiverEffect.Read
        "starts_with" | on_str | check_starts_with | lower_starts_with | ReceiverEffect.Read
        "ends_with"   | on_str | check_ends_with   | lower_ends_with | ReceiverEffect.Read
        "index_of"    | on_str | check_index_of    | lower_index_of | ReceiverEffect.Read
        "substring"   | on_str | check_substring   | lower_substring | ReceiverEffect.Read
        "split"       | on_str | check_split       | lower_split | ReceiverEffect.Read
        "replace"     | on_str | check_replace     | lower_replace | ReceiverEffect.Read
        "char_code"   | on_str | check_char_code   | lower_char_code | ReceiverEffect.Read
        "trim"        | on_str | check_trim        | lower_trim | ReceiverEffect.Read
        "is_empty"    | on_str | check_is_empty    | lower_is_empty | ReceiverEffect.Read
    }
    let properties = table<PropertyRow> {
        name     | takes  | check            | lower
        "length" | on_str | check_str_length | measured_reg
    }
    component LanguageFeature f {
        name = "str_lit"
        docs = "Double-quoted strings, with dollar-brace interpolation holes; the text vocabulary — `contains`, `starts_with`, `ends_with`, `index_of`, `substring`, `split`, `replace`, `char_code`, `trim`, `is_empty` — is this feature's method rows."
        gram = grammar {
            primary = value:STRING -> str_lit(value) | parts:ISTR_BEGIN holes:expression ( parts:ISTR_MID holes:expression )* parts:ISTR_END -> body_text(parts, holes)
        }
        builders = builders
        diags = codes
        methods = methods
        properties = properties
    }
    f
}
