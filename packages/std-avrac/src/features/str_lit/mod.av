//! String literals — `"hello"`. The first widening feature: its one
//! branch merges into the spine's `primary`, and the STRING first
//! token keeps it clear of the gate.
use features.{LanguageFeature, BuilderRow, NodeSemantics}

export fn str_lit() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name      | build
        "str_lit" | build_str_lit
    }
    let sem: dyn NodeSemantics = StrSemantics { }
    component LanguageFeature f {
        name = "str_lit"
        docs = "A double-quoted string literal; its value is the unquoted text."
        gram = """
primary = s:STRING -> str_lit(s)
"""
        builders = rows
        hooks = [sem]
    }
    f
}
