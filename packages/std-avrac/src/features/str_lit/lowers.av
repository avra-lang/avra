//! The lowering rules of a string literal, a byte string and an interpolated one: a literal is its
//! text, a byte string its octets, each the binary's own; an interpolated string builds its runs and
//! its holes' text in one box, a text hole standing alone as itself.
use core.{
    BoxKind,
    ExprId,
    Layout,
    Lowering,
    Lowers,
    Reg,
    StaticBox,
    body_behavior,
    flatten,
    rt_sig_of,
    unbounded_asked,
}
use core.expr.{Body, BytesLit, StrLit}
use grammar.{byte_string_octets}

impl Lowers for StrLit {
    fn lowered(mut cx: Lowering, e: ExprId) -> Reg { cx.const_str(self.value) }
}

impl Lowers for BytesLit {
    /// The octets the spelling holds, laid out once as the binary's own box.
    fn lowered(mut cx: Lowering, e: ExprId) -> Reg {
        let ty? = cx.type_at(e) else { return cx.untyped(e) }
        let octets? = match byte_string_octets(self.spelled) {
            .Ok(xs) -> xs.bytes(),
            .Err(_) -> null,
        } else { return cx.missed_as(octets_undecoded()) }
        cx
            .laid_static(cx.laid_out(ty), (cx.program.literal_symbol)(e, ty), [StaticBox.Octets(octets)])
    }
}

impl Lowers for Body {
    /// A text body's pieces, joined; a quote, the template it builds; another language's body, the
    /// calls its expansion is. One its grammar didn't expand isn't lowered yet.
    fn lowered(mut cx: Lowering, e: ExprId) -> Reg {
        match body_behavior(self.word) {
            .Text -> text_lowered(cx, e, self),
            .Quote -> quote_lowered(cx, e, self),
            .Foreign -> match self.view {
                .Expanded(x) -> cx.lower(x),
                .None or .Verbatim(_, _) -> cx.missed_as("another language's body"),
            },
        }
    }
}

/// An interpolated string: each run that holds text, and each hole as text, in written order, built
/// in one box — a text hole standing alone is itself. A hole whose text the runtime doesn't spell
/// isn't lowered yet.
fn text_lowered(mut cx: Lowering, e: ExprId, b: Body) -> Reg {
    if b.holes.any((h) -> cx.type_at(h)?.generic() ?? false) { return cx.missed_as(unbounded_asked("a type parameter's value as text")) }
    if b.holes.any((h) -> added_as(cx, h) == null) { return cx.missed_as("a hole that isn't a number, a truth or text") }
    if b.holes.is_empty() { return cx.const_str(b.parts[0]) }
    let values = [cx.lower(h) for h in b.holes]
    if values.length == 1 && b.parts.all(it == "") && added_as(cx, b.holes[0]) == Added.Text { return values[0] }
    cx.run_row(rt_sig_of("avra_text_begin")!, [])
    added_run(cx, b.parts[0])
    for j, h in b.holes {
        cx.run_row(rt_sig_of(added_row(added_as(cx, h)!))!, [values[j]])
        added_run(cx, b.parts[j + 1])
    }
    cx.call_row(cx.layout_at(e), rt_sig_of("avra_text_end")!, [])
}

/// A run of text between holes appended to the text being built; an empty run appends nothing.
fn added_run(mut cx: Lowering, s: string) { if s != "" { cx.run_row(rt_sig_of(added_row(Added.Text))!, [cx.const_str(s)]) } }

/// How a hole's value is appended to the text being built: as text, or as a number's or a truth's
/// spelling.
enum Added {
    Text
    Int
    Float
    Bool
}

/// The row appending a value added as `a`.
fn added_row(a: Added) -> string {
    match a {
        .Text -> "avra_text_add",
        .Int -> "avra_text_add_int",
        .Float -> "avra_text_add_float",
        .Bool -> "avra_text_add_bool",
    }
}

/// How the hole `h` is appended: a string as text, an `int`, a `float` or a `bool` by its spelling,
/// a named type as its shape; absent for any other type, or one the language doesn't own.
fn added_as(cx: Lowering, h: ExprId) -> Added? {
    let read? = cx.type_at(h) else { return null }
    let ty = cx.program.checked.named_shape(read) ?? read
    if ty.nullable() || ty.dynamic || !ty.args.is_empty() { return null }
    let own? = match ty.head { .Owned(_) -> ty, rest -> null } else { return null }
    let l? = cx.program.checked.layout(own) else { return null }
    match l {
        .Word -> Added.Int,
        .Real -> Added.Float,
        .Truth -> Added.Bool,
        .Boxed(box) -> match box {
            .Text -> Added.Text,
            .Bytes or .List or .Map or .Record or .Enum or .Closure or .Cell or .Task or .Dyn or .Union or .Range or .Slot -> null,
        },
        .Void or .Bare or .Fields(_) or .Tagged(_) or .Maybe(_) -> null,
    }
}

/// Why a byte string the lexer admitted, whose spelling doesn't decode, isn't lowered.
fn octets_undecoded() -> string { "a byte string the lexer admitted that doesn't decode" }
