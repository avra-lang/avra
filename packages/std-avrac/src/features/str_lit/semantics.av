//! A string literal IS its value: no children, no names, types as
//! string, evaluates to itself, prints its text.
use core.{Expr, ExprId, Type, TypeId, NodeStore, Reg, Ins, text_of}
use features.{NodeSemantics, ResolveCx, TypeCx, EvalCx, LowerCx, nothing}

export type StrSemantics = { }

impl NodeSemantics for StrSemantics {
    fn kids(self, e: Expr) -> List<ExprId> {
        []
    }

    fn resolve(self, cx: ResolveCx, e: ExprId) {
        nothing()
    }

    fn type_of(self, cx: TypeCx, e: ExprId) -> TypeId {
        cx.intern(Type.Str)
    }

    fn eval(self, cx: EvalCx, e: ExprId) -> ExprId {
        e
    }

    fn lower(self, cx: LowerCx, e: ExprId) -> Reg {
        let dst = cx.result(e)
        cx.emit(Ins.ConstStr(dst, text_of(cx.store.expr(e)) ?? ""))
        dst
    }

    fn printed(self, store: NodeStore, e: ExprId) -> string? {
        text_of(store.expr(e))
    }
}
