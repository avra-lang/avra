//! The strings' NodeSemantics — dispatch one-liners: a literal IS
//! its value; an interpolation's rule bodies live beside this file,
//! by concern.
use core.{Expr, ExprId, Type, TypeId, Reg, Ins, text_of}
use features.{NodeSemantics, ResolveCx, TypeCx, LowerCx, nothing, lower_defect}

export type StrSemantics = { }

impl NodeSemantics for StrSemantics {
    fn kids(e: Expr) -> List<ExprId> {
        match e {
            .Interp(_, holes) -> holes,
            _ -> [],
        }
    }

    fn heirs(e: Expr) -> List<ExprId> {
        []
    }

    fn resolve(cx: ResolveCx, e: ExprId) {
        nothing()
    }

    fn type_of(cx: TypeCx, e: ExprId) -> TypeId {
        match cx.view.store.expr(e) {
            .Interp(_, holes) -> interp_type(cx, holes),
            _ -> cx.view.types.intern(Type.Str),
        }
    }

    fn lower(cx: LowerCx, e: ExprId) -> Reg {
        match cx.view.store.expr(e) {
            .Interp(parts, holes) -> interp_reg(cx, e, parts, holes),
            _ -> str_reg(cx, e),
        }
    }

}

/// A string literal IS its text; absence would mean the dispatch
/// lied about this node.
fn str_reg(cx: LowerCx, e: ExprId) -> Reg {
    let t: string? = text_of(cx.view.store.expr(e))
    if t == null { return lower_defect(cx, e, "a string literal without its text") }
    let dst = cx.result(e)
    cx.emit(Ins.ConstStr(dst, t!))
    dst
}
