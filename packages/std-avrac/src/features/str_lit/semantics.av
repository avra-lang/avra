//! The strings' NodeSemantics — dispatch one-liners: a literal IS
//! its value; an interpolation's rule bodies live beside this file,
//! by concern.
use core.{Expr, ExprId, Type, TypeId, NodeStore, Reg, Ins, text_of}
use features.{NodeSemantics, ResolveCx, TypeCx, LowerCx, nothing}

export type StrSemantics = { }

impl NodeSemantics for StrSemantics {
    fn kids(self, e: Expr) -> List<ExprId> {
        match e {
            .Interp(_, holes) -> holes,
            _ -> [],
        }
    }

    fn resolve(self, cx: ResolveCx, e: ExprId) {
        nothing()
    }

    fn type_of(self, cx: TypeCx, e: ExprId) -> TypeId {
        match cx.store.expr(e) {
            .Interp(_, holes) -> interp_type(cx, holes),
            _ -> cx.intern(Type.Str),
        }
    }

    fn lower(self, cx: LowerCx, e: ExprId) -> Reg {
        match cx.store.expr(e) {
            .Interp(parts, holes) -> interp_reg(cx, e, parts, holes),
            _ -> {
                let dst = cx.result(e)
                cx.emit(Ins.ConstStr(dst, text_of(cx.store.expr(e)) ?? ""))
                dst
            }
        }
    }

}
