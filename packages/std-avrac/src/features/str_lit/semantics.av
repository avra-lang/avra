//! The strings' NodeSemantics — dispatch one-liners: a literal IS
//! its value; an interpolation's rule bodies live beside this file,
//! by concern.
use core.{Expr, ExprId, Type, TypeId, Reg, Ins}
use features.{NodeSemantics, TypeCx, LowerCx}

export type StrSemantics = { }

impl NodeSemantics for StrSemantics {
    fn kids(e: Expr) -> List<ExprId> {
        match e {
            .Interp(_, holes) -> holes,
            _ -> [],
        }
    }

    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        match cx.view.store.expr(e) {
            .Interp(_, holes) -> interp_type(cx, holes),
            _ -> cx.type(string),
        }
    }

    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        match cx.view.store.expr(e) {
            .Interp(parts, holes) -> interp_reg(cx, e, parts, holes),
            _ -> str_reg(cx, e),
        }
    }

}

/// A string literal IS its text; absence would mean the dispatch
/// lied about this node.
fn str_reg(mut cx: LowerCx, e: ExprId) -> Reg {
    let t: string? = (cx.view.store.expr(e)).text_of()
    if t == null { return cx.lower_defect(e, "a string literal without its text") }
    let dst = cx.result(e)
    cx.emit(Ins.ConstStr(dst, t!))
    dst
}
