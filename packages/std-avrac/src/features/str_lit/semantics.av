//! The strings' NodeSemantics — dispatch one-liners: a literal IS
//! its value; an interpolation's rule bodies live beside this file,
//! by concern.
use core.{Expr, ExprId, TypeId, Reg}
use features.{NodeSemantics, TypeCx, LowerCx, Meaning, ResolveCx, nothing}

use core.expr.{StrLit, BytesLit}

export type StrSemantics = {}

impl NodeSemantics for StrSemantics {
    fn kids(e: Expr) -> List<ExprId> {
        match e { .Body(_, _, holes, _) -> holes, _ -> [] }
    }

}

/// A string literal IS its text; absence would mean the dispatch
/// lied about this node.
fn str_reg(mut cx: LowerCx, e: ExprId) -> Reg {
    let t? = cx.view.store.expr(e).text_of() else { return cx.lower_defect(e, "a string literal without its text") }
    cx.const_str_at(e, t)
}

impl Meaning for StrLit {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        cx.type(string)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        str_reg(cx, e)
    }
}
impl Meaning for BytesLit {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        cx.type(Bytes)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        cx.spelled_static(e) ?? undecoded_bytes(cx, e)
    }
}

export fn str_type(mut cx: TypeCx, e: ExprId) -> TypeId {
    match cx.view.store.expr(e) {
        .Body(_, _, holes, _) -> interp_type(cx, holes),
        .BytesLit(_) -> cx.type(Bytes),
        _ -> cx.type(string),
    }
}

export fn str_lower(mut cx: LowerCx, e: ExprId) -> Reg {
    match cx.view.store.expr(e) {
        .Body(_, parts, holes, _) -> interp_reg(cx, e, parts, holes),
        .BytesLit(_) -> cx.spelled_static(e) ?? undecoded_bytes(cx, e),
        _ -> str_reg(cx, e),
    }
}

/// A byte literal the lexer admitted that did not decode to octets.
fn undecoded_bytes(mut cx: LowerCx, e: ExprId) -> Reg {
    cx.lower_defect(e, "a byte string the lexer admitted did not decode")
}
