//! An interpolation's value: parts and stringified hole values,
//! folded into a fresh StrLit node.
use core.{Expr, ExprId}
use features.{EvalCx, scalar_text}

fn interp_value(cx: EvalCx, parts: List<string>, holes: List<ExprId>) -> ExprId {
    mut text = parts[0]
    for (j, h) in holes.enumerate() {
        let piece: string? = scalar_text(cx.store, cx.value_at(h))
        if piece == null {
            cx.fail("defect: an unprintable value reached interpolation in a clean program")
        }
        text = "${text}${piece ?? ""}${parts[j + 1]}"
    }
    cx.alloc(Expr.StrLit(text))
}
