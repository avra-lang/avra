//! An interpolation lowers as its PIECES — each non-empty part and
//! each stringified hole, in order: one piece is itself, two are one
//! concat, and more push into an array that ONE str_join answers.
//! Zero new instructions, the escape hatch carrying the feature again.
use core.{ExprId, Reg}
use features.{LowerCx, MethodCall}

fn interp_reg(mut cx: LowerCx, e: ExprId, parts: List<string>, holes: List<ExprId>) -> Reg {
    mut pieces: List<Reg> = []
    if parts[0] != "" { pieces.push(cx.const_str(parts[0])) }
    for j, h in holes {
        pieces.push(cx.texted(h))
        if parts[j + 1] != "" { pieces.push(cx.const_str(parts[j + 1])) }
    }
    if pieces.is_empty() { return cx.const_str("") }
    if pieces.length == 1 { return pieces[0] }
    if pieces.length == 2 { return cx.str_concat(cx.shape_at(e), pieces[0], pieces[1]) }
    let size = cx.box_size(pieces.length)
    let arr = cx.grown_box(cx.view.types.shape_of(cx.type_at(e)), size, pieces)
    let sep = cx.const_str("")
    cx.str_join(cx.shape_at(e), arr, sep)
}

// ── The method rows' rules: one runtime call each ──

export fn lower_contains(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.str_contains(cx.shape_at(mc.e), cx.reg_of(mc.subject), cx.reg_of(mc.args[0])) }
export fn lower_starts_with(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.str_starts_with(cx.shape_at(mc.e), cx.reg_of(mc.subject), cx.reg_of(mc.args[0])) }
export fn lower_ends_with(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.str_ends_with(cx.shape_at(mc.e), cx.reg_of(mc.subject), cx.reg_of(mc.args[0])) }
export fn lower_index_of(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.str_index_of(cx.shape_at(mc.e), cx.reg_of(mc.subject), cx.reg_of(mc.args[0])) }
export fn lower_substring(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.str_substring(cx.shape_at(mc.e), cx.reg_of(mc.subject), cx.reg_of(mc.args[0]), cx.reg_of(mc.args[1])) }
export fn lower_split(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.str_split(cx.shape_at(mc.e), cx.reg_of(mc.subject), cx.reg_of(mc.args[0])) }
export fn lower_replace(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.str_replace(cx.shape_at(mc.e), cx.reg_of(mc.subject), cx.reg_of(mc.args[0]), cx.reg_of(mc.args[1])) }
export fn lower_trim(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.str_trim(cx.shape_at(mc.e), cx.reg_of(mc.subject)) }

/// `s.char_code()` reads the start; `s.char_code(i)` the byte at `i`.
export fn lower_char_code(mut cx: LowerCx, mc: MethodCall) -> Reg {
    let at = if mc.args.is_empty() { cx.const_int(0) } else { cx.reg_of(mc.args[0]) }
    cx.str_char_code(cx.shape_at(mc.e), cx.reg_of(mc.subject), at)
}
