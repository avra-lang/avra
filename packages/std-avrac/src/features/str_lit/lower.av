//! An interpolation lowers as the runtime aggregate: every piece
//! (part or stringified hole) pushes into an array, and ONE
//! str_join answers — zero new instructions, the escape hatch
//! carrying the feature again.
use core.{ExprId, Reg, Ins}
use features.{LowerCx, MethodCall}

fn interp_reg(mut cx: LowerCx, e: ExprId, parts: List<string>, holes: List<ExprId>) -> Reg {
    mut pieces = [cx.const_str(parts[0])]
    for j, h in holes {
        pieces.push(cx.texted(h))
        pieces.push(cx.const_str(parts[j + 1]))
    }
    let size = cx.box_size(pieces.length)
    let arr = cx.mint_ty(cx.type_at(e))
    cx.grown_box(arr, size, pieces)
    let sep = cx.const_str("")
    let dst = cx.result(e)
    cx.emit(Ins.CallRt(dst, "avra_str_join", [arr, sep]))
    dst
}

// ── The method rows' rules: one runtime call each ──

export fn lower_contains(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.rt_method(mc, "avra_str_contains", []) }
export fn lower_starts_with(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.rt_method(mc, "avra_str_starts_with", []) }
export fn lower_ends_with(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.rt_method(mc, "avra_str_ends_with", []) }
export fn lower_index_of(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.rt_method(mc, "avra_str_index_of", []) }
export fn lower_substring(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.rt_method(mc, "avra_str_substring", []) }
export fn lower_split(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.rt_method(mc, "avra_str_split", []) }
export fn lower_replace(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.rt_method(mc, "avra_str_replace", []) }
export fn lower_trim(mut cx: LowerCx, mc: MethodCall) -> Reg { cx.rt_method(mc, "avra_str_trim", []) }

/// `s.is_empty()` — its length, by the shape's measure word, is zero.
/// The subject lowers FIRST: `reg_of` may mint, and the answer is
/// minted last (I29).
export fn lower_is_empty(mut cx: LowerCx, mc: MethodCall) -> Reg {
    cx.measured_zero(mc.e, mc.subject)
}

/// `s.char_code()` reads the start; `s.char_code(i)` the byte at `i`.
export fn lower_char_code(mut cx: LowerCx, mc: MethodCall) -> Reg {
    if !mc.args.is_empty() { return cx.rt_method(mc, "avra_str_char_code", []) }
    let start = cx.const_int(0)
    cx.rt_method(mc, "avra_str_char_code", [start])
}

fn rt1(mut cx: LowerCx, e: ExprId, callee: string, v: Reg) -> Reg {
    let dst = cx.result(e)
    cx.emit(Ins.CallRt(dst, callee, [v]))
    dst
}
