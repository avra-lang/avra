//! An interpolation lowers as the runtime aggregate: every piece
//! (part or stringified hole) pushes into an array, and ONE
//! str_join answers — zero new instructions, the escape hatch
//! carrying the feature again.
use core.{ExprId, Reg, Ins, Type}
use features.{LowerCx}

fn interp_reg(cx: LowerCx, e: ExprId, parts: List<string>, holes: List<ExprId>) -> Reg {
    mut pieces = [part_reg(cx, e, parts[0])]
    for (j, h) in holes.enumerate() {
        pieces.push(hole_reg(cx, e, h))
        pieces.push(part_reg(cx, e, parts[j + 1]))
    }
    let arr = cx.mint(e)
    cx.emit(Ins.CallRt(arr, "avra_array_new", []))
    for r in pieces { cx.emit(Ins.CallRtVoid("avra_array_push", [arr, r])) }
    let sep = part_reg(cx, e, "")
    let dst = cx.result(e)
    cx.emit(Ins.CallRt(dst, "avra_str_join", [arr, sep]))
    dst
}

/// A literal piece as a fresh Str register.
fn part_reg(cx: LowerCx, e: ExprId, text: string) -> Reg {
    let r = cx.mint(e)
    cx.emit(Ins.ConstStr(r, text))
    r
}

/// A hole's value as a string register, by its shape. List, Struct,
/// and Error never pass typing; their arms stand on the raw
/// register. The shape binds under a TYPED let — a match on a
/// cx-verb call skips the exhaustiveness check (subset note).
fn hole_reg(cx: LowerCx, e: ExprId, h: ExprId) -> Reg {
    let v = cx.reg_of(h)
    let sh: Type = cx.shape_at(h)
    match sh {
        .Str -> v,
        .Int -> rt1(cx, e, "avra_int_text", v),
        .Bool -> rt1(cx, e, "avra_bool_text", v),
        .List(_) or .Struct(_, _) or .Error -> v,
    }
}

fn rt1(cx: LowerCx, e: ExprId, callee: string, v: Reg) -> Reg {
    let dst = cx.mint(e)
    cx.emit(Ins.CallRt(dst, callee, [v]))
    dst
}
