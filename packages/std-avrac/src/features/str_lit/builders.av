//! The text body's builder: an interpolated string is a `Body` whose
//! word is `text` and whose view is the honest empty.
use core.{Expr, BodyView}
use features.{LangNode, Builder}

// LICENSED I39: a builder is a registry ROW's fn, not a verb on `Builder` —
// the shape every `features/*/builders.av` carries, exempt there by path alone
fn build_body_text(b: Builder) -> Result<LangNode, string> {
    b.make_expr(Expr.Body("text", [t.text for t in b.tokens(0)?], b.exprs(1)?, BodyView.None))
}
