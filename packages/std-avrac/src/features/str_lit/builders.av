//! Parse-time lowering: a captured STRING token -> the StrLit node;
//! ISTR pieces and hole expressions -> the Interp node.
use core.{Expr}
use features.{LangNode, Builder, zip_defect_of}

fn build_str_lit(mut b: Builder) -> Result<LangNode, string> {
    let t = b.token(0)?
    b.make_expr(Expr.StrLit(t.text))
}

fn build_interp(mut b: Builder) -> Result<LangNode, string> {
    let head = b.token(0)?
    let first = b.expr(1)?
    let mids = b.tokens(2)?
    let rest = b.exprs(3)?
    let tail = b.token(4)?
    if mids.length != rest.length {
        return .Err(zip_defect_of("interpolation pieces"))
    }
    let parts = [head.text].concat([m.text for m in mids].concat([tail.text]))
    b.make_expr(Expr.Interp(parts, [first].concat(rest)))
}
