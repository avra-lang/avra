// A LITERAL'S BYTE AT A LITERAL INDEX folds before the program runs,
// and must read exactly what the runtime reads: an escape, a byte
// past the first, a multi-byte character's lead and continuation, and
// a computed index beside a written one.
fn at(s: string, i: int) -> int { s.char_code(i) }

let folded = [":".char_code(), "\t".char_code(), "ab".char_code(1), "é".char_code(), "é".char_code(1), "\\".char_code()]
let read = [at(":", 0), at("\t", 0), at("ab", 1), at("é", 0), at("é", 1), at("\\", 0)]
"${[x == read[j] for j, x in folded].all(it)} ${folded.length}"
