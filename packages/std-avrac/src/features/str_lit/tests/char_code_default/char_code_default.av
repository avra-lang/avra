// proves: `s.char_code()` reads the code at the start, as `s.char_code(0)`
// does, in a comparison and in arithmetic, of a literal and of a value.
fn is_upper(c: int) -> bool { c >= "A".char_code() && c <= "Z".char_code() }

fn digit_of(c: int) -> int { c - "0".char_code() }

let word = "hello"
"${is_upper(72)} ${is_upper(104)} ${digit_of(55)} ${word.char_code(0)} ${word.char_code(1)}"
