// proves: a byte string `b"…"` is one `Bytes` value, octet for octet —
// a NUL, an octet past 0x7F, every escape and the empty one — laid out
// as the binary's own data, a const of one included, and equal to the
// same octets built any other way.
const nul_path: Bytes = b"PA\x00TH"
let high = b"\xff\xFE\x80"
let escaped = b"q\"b\\s\n\t\r\0"
let built = [80, 65, 0, 84, 72].bytes()!
let parts = [b"", nul_path, b"é"].bytes()
"${nul_path.length} ${nul_path.at(2)} ${nul_path == built} ${high.at(0)} ${high.at(2)} ${high.text() ?? "not text"} ${escaped.length} ${escaped.at(8)} ${b"".length} ${parts.length} ${b"é".text() ?? "?"}"
