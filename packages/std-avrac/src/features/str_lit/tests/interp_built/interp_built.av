// proves: an interpolation is one text, its runs and its holes in written order — an int, a float,
// a truth, a text and a named number each spelled as alone, a lone text hole itself, and a hole that
// builds a text of its own taken whole before the text that holds it
type Count = int

fn tag(n: int) -> string { "<${n}:${n * 2}>" }

let n = -42
let x = 2.5
let ok = true
let name = "avra"
let c: Count = 7
let alone = "${name}"
let nested = "[${tag(3)}|${"${n}${ok}"}]"
let many = "${n} ${x} ${ok} ${name} ${c}${c}${c} ${tag(7)}"
let blank = "${""}${""}"
"${alone}/${nested}/${many}/${blank.length}/${"" == "${""}"}/${0.1}/${-0.0}"
