// proves: a string's length is carried by its box and set by every
// producer — the empty string, a literal, a concatenation, an int's
// text, a churned build, split's pieces, join, replace growing and
// shrinking, trim, a clamped substring — and a byte read at each
// edge answers the same in both engines.
let e = ""
let one = "x"
let cat = e + e
let least = "${0 - 9223372036854775807 - 1}"
mut grown = ""
mut i = 0
while i < 2000 {
    grown = grown + "ab"
    i = i + 1
}
let parts = "a,b,,c".split(",")
let joined = ["p", "", "q"].join("-")
let rep = "aaa".replace("a", "bbb")
let shrunk = "aaa".replace("a", "")
let t = "  \t x \n ".trim()
let sub = "hello".substring(1, 99)
let sub2 = "hello".substring(3, 2)
let s = "héllo"
"${e.length} ${one.length} ${cat.length} ${least} ${least.length} ${grown.length} ${parts.length} ${parts[2].length} ${joined} ${joined.length} ${rep.length} ${shrunk.length} ${t} ${t.length} ${sub} ${sub2.length} ${"".starts_with("")} ${"ab".ends_with("")} ${"".ends_with("x")} ${s.char_code(0)} ${s.char_code(s.length - 1)} ${s.length}"
