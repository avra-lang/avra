// proves: a chars view heads every chain a list does — nested heads,
// an indexed walk counting code points, the bounded and the flattening
// links, and a `for` that leaves early.
fn j(xs: List<int>) -> string { ["${x}" for x in xs].join(",") }

fn first_wide(s: string) -> int {
    for c in s.chars() { if c > 127 { return c } }
    0
}

let a = "h€y"
let pairs = [x * 100000 + y for x in a.chars() for y in "é!".chars()]
let idx = [i * 10000 + c for i, c in a.chars()]
let t = a.chars().take(2)
let d = a.chars().drop(1)
let tw = a.chars().take_while(it < 200)
let fm = ["ab", "é"].flat_map((s) -> s.chars())
let fmc = "aé".chars().flat_map((c) -> [c, c])
let all = a.chars().all(it > 0)
let big = "😀".chars()[0]
"${j(pairs)} | ${j(idx)} | ${j(t)} | ${j(d)} | ${j(tw)} | ${j(fm)} | ${j(fmc)} | ${all} ${big} ${first_wide(a)} ${a.chars().length}"
