// proves: THE LIST LAW at the interpolation rule — `parts` and
// `holes` collect at every arity, the star's boundary included. A
// trailing capture that REPLACED its label left ONE part beside one
// hole, and lowering read past the end.
fn none() -> string { "plain" }
fn one(a: int) -> string { "<${a}>" }
fn two(a: int, b: int) -> string { "<${a}|${b}>" }
fn ends(a: int, b: int, c: int) -> string { "${a}-${b}-${c}" }
fn adjacent(a: int, b: int) -> string { "${a}${b}" }
fn flags() -> string { "${true}/${false}" }
let shapes = [none(), one(1), two(2, 3), ends(4, 5, 6), adjacent(7, 8), flags()]
shapes.join(" ")
