// The first widening, vertically complete: the branch merges into
// `primary` under the dead-branch gate, strings type as string, and
// mixing them into arithmetic renders the first type.mismatch.
use @std.avrac.core.{ExprId}
use @std.avrac.compiler.{analyze_source, avra, Analysis}
use @std.avrac.testing.{shown, refused_with, refused_at_run}
use @std.avrac.diagnostics.{new_source_file}

/// Statement `i`'s value expression.
fn value_of(a: Analysis, i: int) -> ExprId {
    a.view.store.stmt_value(a.view.stmts[i])!
}

spec "features/str_lit" {
    given "a string in a program" {
        then "it parses, types as string, and nothing is wrong" {
            let a = analyze_source("let s = \"hi\"\ns")
            a.clean() &&
                a.type_name(value_of(a, 0)) == "string" &&
                a.type_name(value_of(a, 1)) == "string"
        }
    }
    given "a string fed to arithmetic" {
        then "the mismatch names the operator, the type, and the place" {
            let lang = avra()
            let expected = """error[type.mismatch]: `+` needs `int` operands, found `string`
  ╭─[app.av:1:13]
1 │ let x = 1 + "a"
  ·             ┬
  ·             ╰── this is `string`
──╯"""
            lang.check(new_source_file("app.av", "let x = 1 + \"a\"")) == expected
        }
        then "each wrong operand reports once; Error never echoes" {
            let both = analyze_source("let x = \"a\" - \"b\"")
            let broken = analyze_source("let x = 1 + y + \"a\"")
            both.diagnostics.length == 2 && broken.diagnostics.length == 2
        }
        then "a mismatch types as Error and absorbs downstream" {
            let a = analyze_source("let x = 1 + \"a\"\nlet y = x - 1")
            a.diagnostics.length == 1 && a.type_name(value_of(a, 1)) == "<error>"
        }
    }
    given "interpolation" {
        then "an int hole computes and prints" {
            shown("\"x \${1 + 2} y\"") == "x 3 y"
        }
        then "string and bool holes print as themselves" {
            shown("let who = \"world\"\n\"hi \${who}, \${2 > 1}\"") == "hi world, true"
        }
        then "holes nest braces — an if inside a hole" {
            shown("\"pick \${if 1 < 2 { 10 } else { 20 }}\"") == "pick 10"
        }
        then "an escaped dollar stays text" {
            shown("\"a \\\${x} b\"") == "a \${x} b"
        }
        then "a list hole refuses with the remedy" {
            let a = analyze_source("let xs = [1]\n\"\${xs}\"")
            a.diagnostics.length == 1 &&
                a
                    .report()
                    .contains("an interpolation hole prints as a scalar or string, found `List<int>`")
        }
    }
    given "string length" {
        then "`.length` measures bytes" {
            shown("\"hello\".length") == "5"
        }
        then "length composes with interpolation" {
            shown("let s = \"ab\"\n\"\${s.length}\${s}\"") == "2ab"
        }
    }
    given "raw strings — three quotes to three quotes" {
        then "quotes and holes inside stay raw" {
            shown("let r = \"\"\"say \"hi\" and \${not a hole}\"\"\"\nr.length") == "26"
        }
        then "newlines are kept" {
            shown("let r = \"\"\"a\nb\"\"\"\nr.length") == "3"
        }
        then "an unterminated raw string is a lex error" {
            refused_with("let r = \"\"\"never closed\n2", "unterminated string")
        }
    }
    given "the vocabulary" {
        then "the scans" {
            shown(
                "let s = \"hello world\"\n\"" +
                    "\${s.contains(\"lo w\")} " +
                    "\${s.starts_with(\"hell\")} " +
                    "\${s.ends_with(\"d\")} " +
                    "\${s.index_of(\"o\")} " +
                    "\${s.index_of(\"z\")}\"",
            ) == "true true true 4 -1"
        }
        then "substring clamps and answers empty past its bounds" {
            shown(
                "let s = \"hello\"\n\"" +
                    "\${s.substring(1, 3)}|" +
                    "\${s.substring(3, 99)}|" +
                    "\${s.substring(4, 2)}|\"",
            ) == "el|lo||"
        }
        then "split keeps a leading empty piece, drops one trailing, and splits nothing from empty text" {
            shown(
                "let a = \"a.b\".split(\".\")\nlet b = \".a\".split(\".\")\nlet c = \"a.\".split(\".\")\n\"" +
                    "\${a.join(\"|\")} " +
                    "\${a.length} " +
                    "\${b.join(\"|\")} " +
                    "\${b.length} " +
                    "\${c.join(\"|\")} " +
                    "\${c.length} " +
                    "\${\"\".split(\".\").length}\"",
            ) == "a|b 2 |a 2 a 1 0"
        }
        then "replace changes every occurrence" {
            shown("\"a/b/c\".replace(\"/\", \".\")") == "a.b.c"
        }
        then "char_code reads a byte, at the start or at an index" {
            shown("let s = \"hello\"\n\"" + "\${s.char_code()} " + "\${s.char_code(1)}\"") == "104 101"
        }
        then "trim strips surrounding blanks, and an empty `from` replaces nothing" {
            shown(
                "\"" +
                    "\${\"  x y \".trim()}|" +
                    "\${\"ab\".replace(\"\", \"-\")}|" +
                    "\${\"a..b\".replace(\".\", \"\")}\"",
            ) == "x y|ab|ab"
        }
    }
    given "the vocabulary's laws" {
        then "a wrong argument speaks in the seat's words" {
            refused_with(
                "\"a\".substring(\"b\", 2)",
                "argument 1 of `substring` wants `int`, found `string`",
            )
        }
        then "the count is the row's" {
            refused_with("\"a\".contains()", "`contains` takes 1 arguments, found 0")
        }
        then "char_code past the text is the bounds trap" {
            refused_at_run("\"ab\".char_code(5)", "index 5 is out of bounds (length 2)")
        }
    }
    given "the char and byte lenses" {
        then "chars() gives the code points, decoded, as ints" {
            shown("let s = \"héllo\"\n\"" + "\${s.chars().length} " + "\${s.chars()[1]}\"") == "5 233"
        }
        then "chars() takes no argument" {
            refused_with("\"a\".chars(1)", "`chars` takes 0 arguments, found 1")
        }
        then "a bare string walk names both views" {
            refused_with("for c in \"ab\" { }\n1", "s.chars()")
        }
    }
    given "is_empty — a string knows when it holds nothing" {
        then "empty and not, the same word a list answers" {
            shown(
                "let a = \"\"\nlet b = \"x\"\n\"\${a.is_empty()} \${b.is_empty()} \${\"ab\".substring(2, 2).is_empty()}\"",
            ) == "true false true"
        }
        then "it takes no argument" {
            refused_with("\"x\".is_empty(1)", "`is_empty` takes 0 arguments, found 1")
        }
    }
}
