// The first widening, vertically complete: the branch merges into
// `primary` under the dead-branch gate, strings type as string, and
// mixing them into arithmetic renders the first type.mismatch.
use @std.avrac.core.{ExprId}
use @std.avrac.language.{analyze_source, avra, Analysis}
use @std.avrac.testing.{shown}
use @std.avrac.diagnostics.{new_source_file}


/// Statement `i`'s value expression.
fn value_of(a: Analysis, i: int) -> ExprId {
    a.store.stmt_value(a.stmts[i])!
}

spec "features/str_lit" {
    given "a string in a program" {
        then "it parses, types as string, and nothing is wrong" {
            let a = analyze_source("let s = \"hi\"\ns")
            a.clean() && a.type_name(value_of(a, 0)) == "string" &&
                a.type_name(value_of(a, 1)) == "string"
        }
    }
    given "a string fed to arithmetic" {
        then "the mismatch names the operator, the type, and the place" {
            let lang = avra()
            let expected = """error[F2000]: `+` needs `int` operands, found `string`
  ╭─[app.av:1:13]
1 │ let x = 1 + "a"
  ·             ┬
  ·             ╰── this is a `string`
──╯"""
            lang.check(new_source_file("app.av", "let x = 1 + \"a\"")) == expected
        }
        then "each wrong operand reports once; Error never echoes" {
            let both = analyze_source("let x = \"a\" - \"b\"")
            let broken = analyze_source("let x = 1 + y + \"a\"")
            both.diagnostics.length == 2 && broken.diagnostics.length == 2
        }
        then "a mismatch types as Error and absorbs downstream" {
            let a = analyze_source("let x = 1 + \"a\"\nlet y = x - 1")
            a.diagnostics.length == 1 && a.type_name(value_of(a, 1)) == "<error>"
        }
    }
    given "interpolation" {
        then "an int hole computes and prints" {
            shown("\"x $" + "{1 + 2} y\"") == "x 3 y"
        }
        then "string and bool holes print as themselves" {
            shown("let who = \"world\"\n\"hi $" + "{who}, $" + "{2 > 1}\"") == "hi world, true"
        }
        then "holes nest braces — an if inside a hole" {
            shown("\"pick $" + "{if 1 < 2 { 10 } else { 20 }}\"") == "pick 10"
        }
        then "an escaped dollar stays text" {
            shown("\"a \\$" + "{x} b\"") == "a $" + "{x} b"
        }
        then "a list hole refuses with the remedy" {
            let a = analyze_source("let xs = [1]\n\"$" + "{xs}\"")
            a.diagnostics.length == 1 &&
                a.report().contains("an interpolation hole prints as a scalar or string, found `List<int>`")
        }
    }
    given "string length" {
        then "`.length` measures bytes" {
            shown("\"hello\".length") == "5"
        }
        then "length composes with interpolation" {
            shown("let s = \"ab\"\n\"$" + "{s.length}$" + "{s}\"") == "2ab"
        }
    }
}
