//! The typing rules of the literals this feature reads.
use core.{Checking, Checks, ExprId, SignedType, Expected, owned_type}
use core.expr.{StrLit}

impl Checks for StrLit {
    /// A text literal is a `string`.
    fn checked(mut cx: Checking, e: ExprId, expected: Expected) -> SignedType? { owned_type("string") }
}
