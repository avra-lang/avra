//! The Use statement's StmtSemantics: every pass answers nothing —
//! the workspace resolved the import before the file's own names
//! were walked, and a `use` lowers to no instruction.
use core.{StmtId, Reg}
use features.{StmtSemantics, StmtResolveCx, StmtTypeCx, StmtLowerCx, nothing, nested_decl}

export type UseSemantics = { }

impl StmtSemantics for UseSemantics {
    fn resolve_stmt(self, cx: StmtResolveCx, s: StmtId) {
        if cx.in_block { cx.emit(nested_decl("resolve.nested_use", "use lines", cx.loc_of(s))) }
    }

    fn type_stmt(self, cx: StmtTypeCx, s: StmtId) {
        nothing()
    }

    fn lower_stmt(self, cx: StmtLowerCx, s: StmtId) -> Reg? {
        null
    }
}
