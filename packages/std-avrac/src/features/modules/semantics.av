//! The Use statement's StmtSemantics: every pass answers nothing —
//! the workspace resolved the import before the file's own names
//! were walked, and a `use` lowers to no instruction.
use core.{StmtId, Reg}
use features.{StmtSemantics, StmtResolveCx, StmtTypeCx, StmtLowerCx, nothing, refuses_nested}

export type UseSemantics = { }

impl StmtSemantics for UseSemantics {
    fn resolve_stmt(cx: StmtResolveCx, s: StmtId) {
        let _ = refuses_nested(cx, s, "resolve.nested_use", "use lines")
    }

    fn type_stmt(cx: StmtTypeCx, s: StmtId) {
        nothing()
    }

    fn lower_stmt(cx: StmtLowerCx, s: StmtId) -> Reg? {
        null
    }
}
