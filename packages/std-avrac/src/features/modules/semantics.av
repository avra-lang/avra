//! The Use statement's StmtSemantics: every pass answers nothing —
//! the workspace resolved the import before the file's own names
//! were walked, and a `use` lowers to no instruction.
use core.{StmtId}
use core.stmt.{Use}
use features.{StmtSemantics, ResolveCx}

impl StmtSemantics for Use {
    fn resolve_stmt(mut cx: ResolveCx, s: StmtId) {
        let _ = cx.refuses_nested(s, "resolve.nested_use", "use lines")
    }

}
