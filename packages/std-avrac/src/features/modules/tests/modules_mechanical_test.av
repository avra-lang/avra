// GENERATED by `avra attack modules` — the mechanical
// classes from the feature's rule and the model. A SEMANTIC
// attack belongs in the feature's hand-written test.
// cap: 500 case(s), 0 dropped.
use @std.avrac.language.{analyze_source}
use @std.avrac.diagnostics.{Diag}

/// The SHAPE parses — a canonical sample spells `x` where a name
/// belongs, so a TYPE error is expected and a PARSE error is not.
fn parses(src: string) -> bool {
    !analyze_source(src).diagnostics.any(parse_error)
}

fn parse_error(d: Diag) -> bool {
    d.kind.starts_with("parse.")
}

/// The compiler REACHES A VERDICT on a malformed surface — a
/// deletion can yield a valid program, so this law is tolerance,
/// not refusal; a trap is not a verdict and dies in the call.
fn tolerates(src: string) -> bool {
    let reached = analyze_source(src).diagnostics.length
    reached >= 0
}

spec "features/modules adversarial — mechanical" {
    given "degenerate shapes — a valid surface, and must stay valid" {
        then "use @std . { \n x as x , \n x as x , \n } \n" { parses("use @std . { \n x as x , \n x as x , \n } \n") == parses("use @std . x . { \n x as x , \n x as x , \n } \n") }
        then "use @std . x . x . { \n x as x , \n x as x , \n } \n" { parses("use @std . x . x . { \n x as x , \n x as x , \n } \n") == parses("use @std . x . { \n x as x , \n x as x , \n } \n") }
        then "use @std . x . { \n x as x , \n } \n" { parses("use @std . x . { \n x as x , \n } \n") == parses("use @std . x . { \n x as x , \n x as x , \n } \n") }
        then "use @std . x . { \n x as x , \n x as x , \n x as x , \n } \n" { parses("use @std . x . { \n x as x , \n x as x , \n x as x , \n } \n") == parses("use @std . x . { \n x as x , \n x as x , \n } \n") }
    }
    given "malformed surface — must be diagnosed" {
        then "@std . x . { \n x as x , \n x as x , \n } \n" { tolerates("@std . x . { \n x as x , \n x as x , \n } \n") }
        then "use . x . { \n x as x , \n x as x , \n } \n" { tolerates("use . x . { \n x as x , \n x as x , \n } \n") }
        then "use @std x . { \n x as x , \n x as x , \n } \n" { tolerates("use @std x . { \n x as x , \n x as x , \n } \n") }
        then "use @std . . { \n x as x , \n x as x , \n } \n" { tolerates("use @std . . { \n x as x , \n x as x , \n } \n") }
        then "use @std . x { \n x as x , \n x as x , \n } \n" { tolerates("use @std . x { \n x as x , \n x as x , \n } \n") }
        then "use @std . x . \n x as x , \n x as x , \n } \n" { tolerates("use @std . x . \n x as x , \n x as x , \n } \n") }
        then "use @std . x . { x as x , \n x as x , \n } \n" { tolerates("use @std . x . { x as x , \n x as x , \n } \n") }
        then "use @std . x . { \n as x , \n x as x , \n } \n" { tolerates("use @std . x . { \n as x , \n x as x , \n } \n") }
        then "use @std . x . { \n x x , \n x as x , \n } \n" { tolerates("use @std . x . { \n x x , \n x as x , \n } \n") }
        then "use @std . x . { \n x as , \n x as x , \n } \n" { tolerates("use @std . x . { \n x as , \n x as x , \n } \n") }
        then "use @std . x . { \n x as x \n x as x , \n } \n" { tolerates("use @std . x . { \n x as x \n x as x , \n } \n") }
        then "use @std . x . { \n x as x , x as x , \n } \n" { tolerates("use @std . x . { \n x as x , x as x , \n } \n") }
        then "use @std . x . { \n x as x , \n as x , \n } \n" { tolerates("use @std . x . { \n x as x , \n as x , \n } \n") }
        then "use @std . x . { \n x as x , \n x x , \n } \n" { tolerates("use @std . x . { \n x as x , \n x x , \n } \n") }
        then "use @std . x . { \n x as x , \n x as , \n } \n" { tolerates("use @std . x . { \n x as x , \n x as , \n } \n") }
        then "use @std . x . { \n x as x , \n x as x \n } \n" { tolerates("use @std . x . { \n x as x , \n x as x \n } \n") }
        then "use @std . x . { \n x as x , \n x as x , } \n" { tolerates("use @std . x . { \n x as x , \n x as x , } \n") }
        then "use @std . x . { \n x as x , \n x as x , \n \n" { tolerates("use @std . x . { \n x as x , \n x as x , \n \n") }
        then "use @std . x . { \n x as x , \n x as x , \n }" { tolerates("use @std . x . { \n x as x , \n x as x , \n }") }
        then "use use @std . x . { \n x as x , \n x as x , \n } \n" { tolerates("use use @std . x . { \n x as x , \n x as x , \n } \n") }
        then "use @std @std . x . { \n x as x , \n x as x , \n } \n" { tolerates("use @std @std . x . { \n x as x , \n x as x , \n } \n") }
