        then "use @std . x . { { \n x as x , \n x as x , \n } \n" { tolerates("use @std . x . { { \n x as x , \n x as x , \n } \n") }
        then "use @std . x . { \n \n x as x , \n x as x , \n } \n" { tolerates("use @std . x . { \n \n x as x , \n x as x , \n } \n") }
