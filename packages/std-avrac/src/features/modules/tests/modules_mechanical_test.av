        then "@std use . x . { \n x as x , \n x as x , \n } \n" { tolerates("@std use . x . { \n x as x , \n x as x , \n } \n") }
        then "use . @std x . { \n x as x , \n x as x , \n } \n" { tolerates("use . @std x . { \n x as x , \n x as x , \n } \n") }
        then "use @std x . . { \n x as x , \n x as x , \n } \n" { tolerates("use @std x . . { \n x as x , \n x as x , \n } \n") }
        then "use @std . . x { \n x as x , \n x as x , \n } \n" { tolerates("use @std . . x { \n x as x , \n x as x , \n } \n") }
        then "use @std . x { . \n x as x , \n x as x , \n } \n" { tolerates("use @std . x { . \n x as x , \n x as x , \n } \n") }
        then "use @std . x . \n { x as x , \n x as x , \n } \n" { tolerates("use @std . x . \n { x as x , \n x as x , \n } \n") }
        then "use @std . x . { x \n as x , \n x as x , \n } \n" { tolerates("use @std . x . { x \n as x , \n x as x , \n } \n") }
        then "use @std . x . { \n as x x , \n x as x , \n } \n" { tolerates("use @std . x . { \n as x x , \n x as x , \n } \n") }
        then "use @std . x . { \n x x as , \n x as x , \n } \n" { tolerates("use @std . x . { \n x x as , \n x as x , \n } \n") }
