//! Parse-time lowering: a `use` line -> the Use node; `export` marks
//! the declaration it heads and answers that same node.
use core.{Stmt}
use features.{LangNode, Builder}

fn build_use(mut b: Builder) -> Result<LangNode, string> {
    let head = b.token(0)?
    let rest = b.tokens(1)?
    let items = b.tokens(2)?
    b.make_stmt(Stmt.Use([head.text].concat([t.text for t in rest]), [t.text for t in items]))
}

/// `mod x` — bs2's stub for a module the directory already IS: the
/// module named, nothing imported (ROADMAP: the bs2 debt ledger).
fn build_mod(mut b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    b.make_stmt(Stmt.Use([n.text], []))
}

fn build_export(mut b: Builder) -> Result<LangNode, string> {
    let d = b.stmt(0)?
    if b.store.is_exported(d) { return .Err("`export` written twice") }
    b.store.mark_exported(d)
    .Ok(LangNode.NStmt(d))
}
