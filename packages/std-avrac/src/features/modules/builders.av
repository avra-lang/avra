//! Parse-time lowering: `export` marks the declaration it heads and
//! answers that same node.
use features.{LangNode, Builder}

fn build_export(b: Builder) -> Result<LangNode, string> {
    let d = b.stmt(0)?
    if b.store.is_exported(d) { return .Err("`export` written twice") }
    b.store.mark_exported(d)
    .Ok(LangNode.NStmt(d))
}
