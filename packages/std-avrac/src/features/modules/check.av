//! The module law: what `export` may mark — a declaration, or a `use`
//! line, whose items then join the module's surface.
use core.{SyntaxArena, StmtId, flatten}
use diagnostics.{Diag, Voice, loc_at, said_as}
use @std.errors.{Loc}

/// Every top-level statement's verdict.
export fn module_laws(store: SyntaxArena, file: string?, stmts: List<StmtId>) -> List<Diag> {
    flatten([law_of(store, file, s) for s in stmts])
}

fn law_of(store: SyntaxArena, file: string?, s: StmtId) -> List<Diag> {
    let at = loc_at(file, store.stmt_span(s))
    if wrongly_exported(store, s) {
        return [unexportable(at, store, s)]
    }
    []
}

// ── voices ──

fn unexportable(at: Loc?, store: SyntaxArena, s: StmtId) -> Diag {
    said_as(
        "resolve.export_kind",
        at,
        if store.impl_parts(s) != null { impl_unexported() } else { statement_unexported() },
    )
}

/// `export` on an impl.
export fn impl_unexported() -> Voice {
    Voice {
        message: "an impl is not exported — its methods travel with their type",
        label: "this impl",
        help: "export the type instead",
    }
}

/// `export` on a statement that declares nothing a module's surface holds.
export fn statement_unexported() -> Voice {
    Voice {
        message: "`export` marks a fn, type, enum or trait — not this statement",
        label: "marked here",
        help: "drop the `export`, or declare the value as a fn",
    }
}

/// Whether `export` marks `s` where it may not: on no declaration, const or `use` line.
export fn wrongly_exported(store: SyntaxArena, s: StmtId) -> bool {
    store.is_exported(s) &&
        store.declared_kind(s) == null &&
        store.const_value(s) == null &&
        store.use_parts(s) == null
}
