//! The module law: what `export` may mark — a declaration, or a `use`
//! line, whose items then join the module's surface.
use core.{SyntaxArena, StmtId, flatten}
use diagnostics.{Diag, loc_at, refusal}
use @std.errors.{Loc}

/// Every top-level statement's verdict.
export fn module_laws(store: SyntaxArena, file: string?, stmts: List<StmtId>) -> List<Diag> {
    flatten([law_of(store, file, s) for s in stmts])
}

fn law_of(store: SyntaxArena, file: string?, s: StmtId) -> List<Diag> {
    let at = loc_at(file, store.stmt_span(s))
    if store.is_exported(s) &&
        store.declared_kind(s) == null &&
        store.const_value(s) == null &&
        store.use_parts(s) == null {
        return [unexportable(at, store, s)]
    }
    []
}

// ── voices ──

fn unexportable(at: Loc?, store: SyntaxArena, s: StmtId) -> Diag {
    if store.impl_parts(s) != null {
        return refusal(
            "resolve.export_kind",
            at,
            "an impl is not exported — its methods travel with their type",
            "this impl",
            "export the type instead",
        )
    }
    refusal(
        "resolve.export_kind",
        at,
        "`export` marks a fn, type, enum or trait — not this statement",
        "marked here",
        "drop the `export`, or declare the value as a fn",
    )
}

