//! The module laws: what `export` may mark, and what a `use` line
//! needs.
use core.{NodeStore, StmtId, flatten}
use diagnostics.{Diag, loc_at, refusal}
use @std.errors.{Loc}

/// Every top-level statement's verdict.
export fn module_laws(store: NodeStore, file: string?, stmts: List<StmtId>) -> List<Diag> {
    flatten([law_of(store, file, s) for s in stmts])
}

fn law_of(store: NodeStore, file: string?, s: StmtId) -> List<Diag> {
    let at = loc_at(file, store.stmt_span(s))
    if store.is_exported(s) && store.declared_kind(s) == null { return [unexportable(at, store, s)] }
    []
}

// ── voices ──

fn unexportable(at: Loc?, store: NodeStore, s: StmtId) -> Diag {
    if store.use_parts(s) != null {
        return refusal("resolve.export_kind", at, "`export use` — a re-export — arrives with slice 15c", "this line", null)
    }
    if store.impl_parts(s) != null {
        return refusal("resolve.export_kind", at, "an impl is not exported — its methods travel with their type", "this impl", "export the type instead")
    }
    refusal("resolve.export_kind", at, "`export` marks a fn, type, enum or trait — not this statement", "marked here", "drop the `export`, or declare the value as a fn")
}

/// A `use` in a file outside any package — the lone namespace's voice.
export fn unpackaged_use(at: Loc?) -> Diag {
    refusal("resolve.unpackaged", at, "this file is not in a package — `use` needs a root", "this use", "put an `avra.toml` at the package root above this file; modules are named from there")
}
