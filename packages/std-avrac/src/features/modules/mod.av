//! Modules — `use a.b.{x, y as z}` brings a module's exported items
//! into scope, from a path absolute from the package's source root,
//! `.`-separated; `use @scope.name.a.{x}` reaches a dependency's
//! module the same way. `export` marks the declarations a module's
//! surface carries. Both are keyword anchors: `use` builds the Use
//! node the workspace resolves before any file's names do; `export`
//! is a prefix that marks the declaration it heads — no node of its
//! own.
use features.{LanguageFeature, BuilderRow}
use features.modules.{unused_import}
use @std.grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use diagnostics.{DiagCode}

export fn modules() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name          | build
        "use_stmt"    | build_use
        "export_stmt" | build_export
    }
    let codes = table<DiagCode> {
        kind                              | summary
        "resolve.no_module"               | "a `use` names a module the package does not have"
        "resolve.not_exported"            | "a `use` names an item the module does not export"
        "resolve.not_a_dependency"        | "a `use` names a package this package's manifest does not depend on"
        "resolve.export_kind"             | "`export` marks a declaration — a fn, type, enum or trait"
        "resolve.unpackaged"              | "a `use` line needs a package root (an `avra.toml` above the file)"
        "resolve.module_ambiguous"        | "a module is a directory OR a file, never both"
        "resolve.duplicate_in_module"     | "an exported name declares once in its module"
        "resolve.kept_apart"              | "a private name two files declare is each file's own"
        "resolve.import_clash"            | "an imported name clashes with one already visible"
        "resolve.reexport_twice"          | "a module's surface names each name once"
        "resolve.reexport_unreached"      | "a re-export names a declaration"
        "resolve.reexport_cycle"          | "a re-export never closes a package cycle"
        "resolve.nested_use"              | "use lines live at the top level"
        "resolve.package_form"            | "a package is `@scope.name` — two segments"
        "manifest.no_package"             | "a manifest declares `[package]`"
        "manifest.no_name"                | "`[package]` names the package"
        "manifest.no_version"             | "`[package]` gives a version"
        "manifest.bad_version"            | "a version is semver: `MAJOR.MINOR.PATCH`"
        "manifest.bad_name"               | "a package name is `@scope/name`, or one bare word for a program"
        "manifest.lib_name"               | "a `[lib] name` is the stem its package's name derives"
        "manifest.no_target"              | "running a package needs a `[bin]` or `src/main.av`"
        "manifest.no_source"              | "checking a root needs a `src/` directory or a program file directly in it"
        "manifest.self_dependency"        | "a package does not depend on itself"
        "manifest.bad_path"               | "a path dependency points at a package directory"
        "manifest.bad_opt_level"          | "`opt_level` is 0–3, s or z"
        "manifest.bad_profile"            | "a profile name is `[a-z0-9_-]+`"
        "manifest.unscoped_dependency"    | "a dependency is named `@scope/name`"
        "manifest.unsupported_dependency" | "only path dependencies resolve; registry and git forms wait on their transports"
        "manifest.name_mismatch"          | "a dependency calls itself what it was keyed as"
        "manifest.cycle"                  | "packages do not depend in a cycle"
        "manifest.duplicate_package"      | "one package name is one directory"
        "manifest.prelude_floor"          | "the prelude depends on nothing"
        "manifest.link_option"            | "a `[link]` row names an object, a directory or a library — the option letter is the compiler's to write"
        "manifest.link_flag"              | "a `[link]` flag is `true` or `false`"
        "manifest.borrowed_raw"           | "`[link.raw]` is the program's own — a dependency names what it needs, never how to link it"
        "manifest.bad_budget"             | "a `[lifted]` row is a count of at least 1 — `steps` in instructions, `memory` in MiB"
        "manifest.syntax"                 | "the manifest is TOML the compiler reads"
        "manifest.unknown_section"        | "an unknown section is ignored with a warning"
        "manifest.unknown_key"            | "an unknown key is ignored with a warning"
    }
    LanguageFeature modules {
        gram: grammar {
            stmt = "use" ( h:PKG | h:NAME ) ( "." p:NAME )* "." "{" BREAK? i:NAME ( "as" q:NAME )? ( ( "," | BREAK ) BREAK? i:NAME ( "as" q:NAME )? )* ","? BREAK? "}" END @recover(sync_to: "END") -> use_stmt(h, p, i, q) | "export" d:stmt -> export_stmt(d)
        }
        builders: rows
        diags: codes
    }
    modules
}
