//! `rule` — a COMPONENT (docs/2026_09_23_COMPONENT_EXPANSION.md) any
//! feature dir may instance: `run` its one seat over the code in
//! hand, `doc` its `///`, `fixes`/`keeps` its `@fixes`/`@keeps`
//! examples. Declared directly under `features/`, in the shared
//! namespace every feature dir already reaches (`Code`, `Fix`) —
//! never inside one nested feature dir, so no other reaches UP into
//! it: THE RULE TABLE that gathers every instance is a `collect`,
//! a compiler-level concern, and lives at compiler/rules_table.av.
use features.{Code, Fix}

/// One example an `@fixes("before", "after")` annotation builds —
/// its two written arguments, one `Fixes` per matching annotation
/// (features/components' annotation-fed `List<R>` fields).
export type Fixes = { before: string, after: string }

/// `rule name { pattern if cond -> value, ... }` — its `run` is the
/// arms, the pronoun's one seat implicit, `_ -> null` filled in for
/// the nullable `Fix?` it answers.
export component rule {
    run: fn(Code) -> Fix?
    doc: string = ""
    fixes: List<Fixes> = []
    keeps: List<string> = []
}
