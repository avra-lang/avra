//! THE GRAMMAR NAMES THE NODE. A rule that maps its captures into a
//! node's payloads says so — `primary = value:STRING -> Expr.StrLit`
//! — and the builder is derived from the node model. A capture LABEL
//! is a PAYLOAD NAME; a payload the rule STATES rather than captures
//! is written `value = true`.
//!
//! Binding happens ONCE, at assembly: every `Build.Node` is resolved
//! into the `Build.Call` the engine already runs, its arguments in
//! PAYLOAD ORDER, so no parse pays for the join and the engine never
//! learns what a node is.
//!
//! THE ARITY LAW, which is what makes an unnamed payload honest: a
//! `List<X>` payload nothing names is `[]`, an `X?` payload nothing
//! names is `null`, and any other unnamed payload REFUSES THE
//! ASSEMBLY. That is what lets one rule cover `{ }` and `{ k: v }`.
//!
//! A PAYLOAD'S SHAPE, NEVER ITS SPELLING, decides what may fill it —
//! `Field.kind` answers "is this a list", "is this text-filled"
//! structurally, so the answer holds under renaming and cannot forget
//! the next declared type the way a string table would.
use core.{flatten, joined, PayloadRow, row_for, binop_of, facet_table, has_anchor, anchor_word}
use @std.meta.{Field, Kind}
use @std.grammar.{
    Grammar,
    Alt,
    Seq,
    Item,
    Prim,
    Build,
    Slot,
    Fixed,
    Term,
    Operators,
    Tier,
    Diagnostic,
    defect,
}

/// A grammar with every node build bound, and what binding refused.
export type NodeBinding = { g: Grammar, defects: List<Diagnostic> }

/// Every node build in `g` resolved against the node model.
export fn bind_nodes(g: Grammar, rows: List<PayloadRow>) -> NodeBinding {
    NodeBinding {
        g: g with { rules: [r with { body: bound_alt(r.name, r.body, rows) } for r in g.rules] },
        defects: flatten([alt_defects(r.name, r.body, rows) for r in g.rules])
            .concat(flatten([anchor_defects(r) for r in rows])),
    }
}

/// A node's ANCHOR, judged where it is declared: ONE payload is the
/// place a node begins, and only a payload that carries a written place
/// at all — a `bool` is a presence, never a span.
fn anchor_defects(row: PayloadRow) -> List<Diagnostic> {
    let anchored = [p for p in row.payloads if has_anchor(p)]
    [anchor_takes_nothing(row) for p in anchored if argued(p)]
        .concat([two_anchors(row, anchored[0].name, p.name) for p in anchored.drop(1)])
        .concat([anchor_is_presence(row, p) for p in anchored if is_bool(p.kind)])
}

/// Whether the mark was written with an argument.
fn argued(p: Field) -> bool {
    let m? = p.marks.find(it.name == anchor_word) else { return false }
    !m.args.is_empty()
}

/// A rule body's branches, each judged by ITS OWN labels — the top of
/// every scope a capture can reach.
fn bound_alt(rname: string, a: Alt, rows: List<PayloadRow>) -> Alt {
    a with { branches: [bound_seq(rname, s, s, rows) for s in a.branches] }
}

/// One branch bound, and every branch nested in its groups — all of
/// them against `visible`, the ENCLOSING branch's labels (a fold's turn is
/// its own enclosing branch). A capture
/// escapes its group into that branch, so a nested build reads the
/// same names the engine will hand it.
fn bound_seq(rname: string, s: Seq, outer: Seq, rows: List<PayloadRow>) -> Seq {
    s with { items: [m with { prim: bound_prim(rname, m.prim, outer, rows) } for m in s.items], build: bound_build(s.build, outer, rows), operators: bound_operators(s.operators, outer, rows) }
}

/// An `@operators` branch's tiers, each build bound against the
/// branch's labels — `left`, `op` and `right`, which the climb hands
/// every build.
fn bound_operators(ops: Operators?, outer: Seq, rows: List<PayloadRow>) -> Operators? {
    let held? = ops else { return null }
    held with { tiers: [bound_tier(t, outer, rows) for t in held.tiers] }
}

/// A tier with its own build and each suffix's bound.
fn bound_tier(t: Tier, outer: Seq, rows: List<PayloadRow>) -> Tier {
    t with { build: bound_build(t.build, outer, rows), suffixes: [x with { build: bound_build(x.build, outer, rows) } for x in t.suffixes] }
}

fn bound_prim(rname: string, p: Prim, outer: Seq, rows: List<PayloadRow>) -> Prim {
    match p {
        .Group(inner) -> Prim
            .Group(
                inner with { branches: [bound_seq(rname, b, b.scope(outer), rows) for b in inner.branches] },
            ),
        .Ref(_) or .Lit(_) or .Named(_) or .NotChar(_) -> p,
    }
}

/// The branch's build with its node build's slots filled. A variant
/// the model does not answer keeps its empty slots: the defects below
/// refuse the assembly, so no parse ever reaches it.
fn bound_build(held: Build?, outer: Seq, rows: List<PayloadRow>) -> Build? {
    let b? = held else { return null }
    match b {
        .Node(owner, variant, fixed, _) -> Build.Node(owner, variant, fixed, filled_slots(outer, owner, variant, fixed, rows)),
        .Call(_, _) or .Var(_) -> b,
    }
}

fn filled_slots(
    outer: Seq,
    owner: string,
    variant: string,
    fixed: List<Fixed>,
    rows: List<PayloadRow>,
) -> List<Slot>? {
    let row? = row_for(rows, owner, variant) else { return null }
    [filling(p, outer, fixed, rows) for p in row.payloads]
}

/// One payload's slot: the label that captures it, the value the rule
/// states, or nothing — which the arity law permits only for a list
/// or a nullable.
fn filling(p: Field, outer: Seq, fixed: List<Fixed>, rows: List<PayloadRow>) -> Slot {
    let stated: Fixed? = fixed.find(it.name == p.name)
    if stated != null { return slot_of(stated!.stated(), outer, rows) }
    if outer.labels().contains(p.name) { return Slot.Label(p.name) }
    Slot.Empty
}

/// A stated term as the slot it fills: a word that is a capture's label
/// reads as that capture, any other word and every literal is stated, a
/// node is built in place from the same labels, a list is its items.
fn slot_of(t: Term, outer: Seq, rows: List<PayloadRow>) -> Slot {
    match t {
        .Text(text) -> if outer.labels().contains(text) { Slot.Label(text) } else { Slot.Fixed(text) },
        .Node(b) -> Slot.Nested(bound_build(b, outer, rows) ?? b),
        .List(items) -> Slot.Items([slot_of(i, outer, rows) for i in items]),
    }
}

// ── The refusals. A node build is checked against the DECLARATION,
// so a grammar that would build a wrong tree never runs. ──

fn alt_defects(rname: string, a: Alt, rows: List<PayloadRow>) -> List<Diagnostic> {
    flatten([branch_defects(rname, s, rows) for s in a.branches])
}

/// One branch and every branch nested in it, all judged by THIS
/// branch's labels — the set the engine binds into.
fn branch_defects(rname: string, s: Seq, rows: List<PayloadRow>) -> List<Diagnostic> {
    flatten([seq_defects(rname, j.seq, j.scope, rows) for j in judged_seqs(s, s)])
}

/// A branch with the scope its labels are judged by.
type Judged = { seq: Seq, scope: Seq }

/// A branch and every branch nested in its groups, each with the
/// scope it is judged by: the enclosing branch's, except a fold's
/// turn, which is its own (a turn reads its seed and its own labels,
/// never a sibling turn's).
fn judged_seqs(s: Seq, scope: Seq) -> List<Judged> {
    [Judged { seq: s, scope: scope }]
        .concat(
            flatten(
                [judged_seqs(b, b.scope(scope)) for m in s.items for b in m.prim.group_alt()?.branches ?? []],
            ),
        )
}

fn seq_defects(rname: string, s: Seq, outer: Seq, rows: List<PayloadRow>) -> List<Diagnostic> {
    let tiers = s.operators?.tiers ?? []
    build_defects(
        rname,
        s.build,
        outer,
        rows,
        flatten([t.served_words() for t in tiers if t.build == null]),
    )
        .concat(flatten([tier_build_defects(rname, t, outer, rows) for t in tiers]))
}

/// A tier's own build, and each of its suffixes', judged for the
/// operators each builds.
fn tier_build_defects(rname: string, t: Tier, outer: Seq, rows: List<PayloadRow>) -> List<
    Diagnostic,
> {
    build_defects(rname, t.build, outer, rows, t.served_words())
        .concat(flatten([build_defects(rname, x.build, outer, rows, [[x.word]]) for x in t.suffixes]))
}

/// One build judged against the node it names; `words` are the operator
/// words it is built for: a tier's own, or every word of the tiers the
/// branch's build serves.
fn build_defects(
    rname: string,
    held: Build?,
    outer: Seq,
    rows: List<PayloadRow>,
    words: List<List<string>>,
) -> List<Diagnostic> {
    let b? = held else { return [] }
    match b {
        .Node(owner, variant, fixed, _) -> node_defects(rname, outer, owner, variant, fixed, rows, words),
        .Call(_, _) or .Var(_) -> [],
    }
}

fn node_defects(
    rname: string,
    outer: Seq,
    owner: string,
    variant: string,
    fixed: List<Fixed>,
    rows: List<PayloadRow>,
    words: List<List<string>>,
    top: bool = true,
) -> List<Diagnostic> {
    let row? = row_for(rows, owner, variant) else { return [node_refusal(rname, no_such_variant(owner, variant))] }
    judged(rname, outer, row, fixed, rows, top).concat(operator_words_defects(rname, row, words))
}

/// A payload that is an operator (`BinOp`) is filled from the word the
/// climb took, so every word its tier spells must name one — a word
/// that names none is refused where the grammar is assembled.
fn operator_words_defects(rname: string, row: PayloadRow, words: List<List<string>>) -> List<
    Diagnostic,
> {
    if !row.payloads.any(is_operator(it)) { return [] }
    [node_refusal(rname, names_no_operator(row, w.join(""))) for w in words if binop_of(w.join("")) == null]
}

fn is_operator(p: Field) -> bool {
    match p.kind { .Named(name, _) -> name == "BinOp", _ -> false }
}

/// The branch against a variant that EXISTS: what it names, what it
/// leaves unfilled, and what it fills with the wrong shape.
fn judged(
    rname: string,
    s: Seq,
    row: PayloadRow,
    fixed: List<Fixed>,
    rows: List<PayloadRow>,
    top: bool,
) -> List<Diagnostic> {
    stranger_defects(rname, s, row, fixed, top)
        .concat(anchor_stated_defects(rname, s, row, fixed))
        .concat(unfilled_defects(rname, s, row, fixed))
        .concat(shape_defects(rname, s, row, fixed))
        .concat(truth_defects(rname, s, row, fixed))
        .concat(nested_defects(rname, s, row, fixed, rows))
}

/// An anchor names a payload the rule CAPTURES: a term the rule states
/// was never written, so it has no place for the node to begin at — a
/// stated word that IS the branch's own label is that capture, not a
/// value.
fn anchor_stated_defects(rname: string, s: Seq, row: PayloadRow, fixed: List<Fixed>) -> List<
    Diagnostic,
> {
    let anchor? = row.payloads.find(has_anchor(it)) else { return [] }
    let held? = fixed.find(it.name == anchor.name) else { return [] }
    if reads_a_capture(held.stated(), s) { return [] }
    [node_refusal(rname, anchor_stated(row, anchor.name))]
}

/// Whether a stated term is the branch's own capture — a word the
/// branch labels reads as that label's value.
fn reads_a_capture(t: Term, s: Seq) -> bool {
    match t { .Text(text) -> s.labels().contains(text), .Node(_) or .List(_) -> false }
}

/// Each node a stated payload builds in place: it must be the kind of value
/// the payload holds, and it is judged as any build is — against its own
/// declaration, by the labels of the branch that holds it.
fn nested_defects(
    rname: string,
    s: Seq,
    row: PayloadRow,
    fixed: List<Fixed>,
    rows: List<PayloadRow>,
) -> List<Diagnostic> {
    flatten([nested_judged(rname, s, row, f, n, rows) for f in fixed for n in nodes_in(f.stated())])
}

fn nested_judged(rname: string, s: Seq, row: PayloadRow, f: Fixed, n: Build, rows: List<PayloadRow>) -> List<
    Diagnostic,
> {
    let held? = row.payloads.find(it.name == f.name) else { return [] }
    match n {
        .Node(owner, variant, inner, _) -> nested_fit(rname, row, held, owner, variant)
            .concat(node_defects(rname, s, owner, variant, inner, rows, [], false)),
        .Call(_, _) or .Var(_) -> [],
    }
}

/// A nested node fills a payload that holds nodes, of the kind it builds.
fn nested_fit(rname: string, row: PayloadRow, p: Field, owner: string, variant: string) -> List<
    Diagnostic,
> {
    if texted(p.kind) { return [node_refusal(rname, node_fills_text(row, p, owner, variant))] }
    let built = built_type(owner, variant)
    if named_of(p.kind) == built { return [] }
    [node_refusal(rname, node_of_another_kind(row, p, owner, variant, built))]
}

/// The nodes a term builds in place, in order.
fn nodes_in(t: Term) -> List<Build> {
    match t {
        .Text(_) -> [],
        .Node(b) -> [b],
        .List(items) -> flatten([nodes_in(i) for i in items]),
    }
}

/// The declared type a build answers: a node row answers its enum's id
/// (`Expr` answers `ExprId`), a record row the record, and any other
/// enum's row that enum.
fn built_type(owner: string, variant: string) -> string {
    match owner {
        "Expr" -> "ExprId",
        "Pat" -> "PatId",
        "Stmt" -> "StmtId",
        "Record" -> variant,
        rest -> owner,
    }
}

/// The declared type a payload holds, through its list and its nullable.
fn named_of(k: Kind) -> string? {
    match k {
        .Named(name, _) -> name,
        .List(elem) -> named_of(elem),
        .Opt(inner) -> named_of(inner),
        .Int or .Float or .Bool or .Str or .Ptr or .Void or .Cell(_) or .Map(_, _) or .Result(_, _) or .Fn(_, _) or .Dyn(_) or .Var(_) or .Unspelled(_) -> null,
    }
}

/// Names the rule uses — captured or stated — that the variant has no
/// payload for. A climb's own `op` and `right` are offered to every build, so a
/// build that reads neither is no stranger to them.
/// A node built in place is judged by what it states alone: the branch's own
/// labels belong to the build that holds it.
fn stranger_defects(rname: string, s: Seq, row: PayloadRow, fixed: List<Fixed>, top: bool) -> List<
    Diagnostic,
> {
    let names = [p.name for p in row.payloads]
    let spoken = flatten([words_in(f.stated()) for f in fixed])
    let used = if top { s.written_labels().filter((l) -> !spoken.contains(l)).concat([f.name for f in fixed]) } else { [f.name for f in fixed] }
    [node_refusal(rname, no_such_payload(row, n, names)) for n in used if !names.contains(n)]
}

/// The words a stated term reads, through the nodes it builds in place: a
/// capture it names is spoken for, whichever payload takes it.
fn words_in(t: Term) -> List<string> {
    match t {
        .Text(text) -> [text],
        .Node(b) -> match b {
            .Node(_, _, inner, _) -> flatten([words_in(f.stated()) for f in inner]),
            .Call(_, _) or .Var(_) -> [],
        },
        .List(items) -> flatten([words_in(i) for i in items]),
    }
}

/// Payloads nothing fills, and whose type does not answer absence.
fn unfilled_defects(rname: string, s: Seq, row: PayloadRow, fixed: List<Fixed>) -> List<Diagnostic> {
    let labels = s.labels()
    [node_refusal(rname, nothing_fills(row, p)) for p in row.payloads if !labels.contains(p.name) &&
        !fixed.any(it.name == p.name) &&
        !p.defaulted &&
        !absence_is_a_value(p.kind)]
}

/// A LIST holds nothing and a NULLABLE is absent; every other payload
/// must be filled. Two answering arms over our own enum is a
/// REGISTRY: every `Kind` is spelled, so the next variant a rule
/// could ask about is a compile error here, not a silent `false`.
fn absence_is_a_value(k: Kind) -> bool {
    match k {
        .List(_) or .Opt(_) -> true,
        .Int or .Float or .Bool or .Str or .Ptr or .Void or .Cell(_) or .Map(_, _) or .Result(_, _) or .Named(_, _) or .Fn(_, _) or .Dyn(_) or .Var(_) or .Unspelled(_) -> false,
    }
}

/// Each payload's SHAPE against what its label matches: a node payload
/// is built by a rule, text is carried by a terminal. A `@facet` payload
/// is judged by nothing — its label is read by PRESENCE, and its shape
/// does not cross. Refused only
/// where the branch PROVES the mismatch — a literal captures nothing
/// and a group may answer either, so neither is judged.
fn shape_defects(rname: string, s: Seq, row: PayloadRow, fixed: List<Fixed>) -> List<Diagnostic> {
    flatten(
        [payload_shape(rname, s, row, p, label_of(p, fixed, s)) for p in row.payloads if facet_table(p) == null],
    )
}

/// The label a payload is filled from: the capture a stated word names, the
/// payload's own name when nothing is stated, and none for a literal or a node.
fn label_of(p: Field, fixed: List<Fixed>, s: Seq) -> string? {
    let stated: Fixed? = fixed.find(it.name == p.name)
    if stated == null { return p.name }
    match stated!.stated() {
        .Text(text) -> if s.labels().contains(text) { text } else { null },
        .Node(_) or .List(_) -> null,
    }
}

fn payload_shape(rname: string, s: Seq, row: PayloadRow, p: Field, label: string?) -> List<
    Diagnostic,
> {
    let named? = label else { return [] }
    let hit? = s.deep_items().find(labelled(it, named)) else { return [] }
    let carried: Carrier? = carrier_of(hit.prim)
    if carried == null || carried! == wanted_carrier(p.kind) { return [] }
    [node_refusal(rname, wrong_shape(row, p, carried!))]
}

/// A `bool` payload is stated `true` or `false`, or is the presence of a
/// terminal the rule captured under its label. Any other word, and a built
/// node, states no truth.
fn truth_defects(rname: string, s: Seq, row: PayloadRow, fixed: List<Fixed>) -> List<Diagnostic> {
    flatten([truth_defect(rname, s, row, p, fixed) for p in row.payloads if is_bool(p.kind)])
}

fn is_bool(k: Kind) -> bool {
    match k { .Bool -> true, rest -> false }
}

fn truth_defect(rname: string, s: Seq, row: PayloadRow, p: Field, fixed: List<Fixed>) -> List<
    Diagnostic,
> {
    let label? = label_of(p, fixed, s) else { return stated_truth(rname, row, p, fixed.find(it.name == p.name)) }
    let hit? = s.deep_items().find(labelled(it, label)) else { return [] }
    if presence_item(hit.prim) { return [] }
    [node_refusal(rname, truth_from_node(row, p))]
}

/// A stated word that is no truth; a node or a list is the nesting's own to judge.
fn stated_truth(rname: string, row: PayloadRow, p: Field, stated: Fixed?) -> List<Diagnostic> {
    let f? = stated else { return [] }
    match f.stated() {
        .Text(text) -> if text == "true" || text == "false" { [] } else { [node_refusal(rname, states_no_truth(row, p, text))] },
        .Node(_) or .List(_) -> [],
    }
}

/// Whether an item's presence can be read as a truth: a terminal, literal or
/// named (`state:STATE`), or a group, which may answer either. A rule's built
/// node is a value, and holds no truth.
fn presence_item(p: Prim) -> bool {
    match p { .Lit(_) or .Named(_) or .Group(_) -> true, .Ref(_) or .NotChar(_) -> false }
}

/// What a grammar atom answers with: a built node, or a token's text.
enum Carrier { Built, Text }

/// What a payload's declared type must be filled from.
fn wanted_carrier(k: Kind) -> Carrier {
    if texted(k) { return Carrier.Text }
    Carrier.Built
}

/// The payload shapes a TOKEN fills — every other is a built node. A
/// list or a nullable is asked about its ELEMENT, which `Kind`'s own
/// nesting answers directly: no string is sliced to find it.
fn texted(k: Kind) -> bool {
    match k {
        .Str or .Int or .Bool -> true,
        .List(elem) -> texted(elem),
        .Opt(inner) -> texted(inner),
        .Named(name, _) -> flat_named(name),
        .Float or .Ptr or .Void or .Cell(_) or .Map(_, _) or .Result(_, _) or .Fn(_, _) or .Dyn(_) or .Var(_) or .Unspelled(_) -> false,
    }
}

/// THE ONE GAP `Kind` LEAVES OPEN: `Scoped`, `Plain` and `Nominal` are
/// each `type X = string` — free at runtime, one scalar field, so a
/// rule fills them from a token exactly as it fills a bare `string`.
/// `Kind.Named(name, args)` carries the same shape for these as for a
/// real record or enum (`Arm`, `BodyView`) — the crossing does not
/// carry a declaration's REPRESENTATION, only its name and arguments
/// — so there is no `Kind` arm to dispatch on here; the three names
/// ARE the fact. A node payload never names a fourth free named type
/// without this list learning it by hand.
fn flat_named(name: string) -> bool {
    name == "Scoped" || name == "Plain" || name == "Nominal"
}

/// The item this label names.
fn labelled(m: Item, name: string) -> bool {
    m.label != null && m.label! == name
}

fn carrier_of(p: Prim) -> Carrier? {
    match p {
        .Ref(_) -> Carrier.Built,
        .Named(_) -> Carrier.Text,
        // A literal captures nothing a payload wants, and a group may
        // answer either — neither proves a mismatch. A lexicon's own
        // atom never reaches a node build either.
        .Lit(_) or .Group(_) or .NotChar(_) -> null,
    }
}

// ── Voices. Each states the law the grammar broke. ──

fn no_such_variant(owner: string, variant: string) -> string {
    "builds `${owner}.${variant}`, and no such variant is declared"
}

fn no_such_payload(row: PayloadRow, name: string, names: List<string>) -> string {
    "names `${name}`, and `${row.owner}.${row.variant}` has no such payload — it carries ${listed(names)}"
}

fn nothing_fills(row: PayloadRow, p: Field) -> string {
    "builds `${row.owner}.${row.variant}` and nothing fills `${p.name}: ${p.ty}` — only a list or a nullable payload may go unnamed"
}

fn wrong_shape(row: PayloadRow, p: Field, got: Carrier) -> string {
    "gives `${row.owner}.${row.variant}`'s `${p.name}: ${p.ty}` ${carrier_word(got)}, and it holds ${carrier_word(wanted_carrier(p.kind))}"
}

fn carrier_word(c: Carrier) -> string {
    match c { .Built -> "a built node", .Text -> "a token's text" }
}

fn listed(names: List<string>) -> string {
    if names.is_empty() { return "nothing" }
    "`${joined(names, "`, `")}`"
}

fn node_fills_text(row: PayloadRow, p: Field, owner: string, variant: string) -> string {
    "builds `${owner}.${variant}` in `${row.owner}.${row.variant}`'s `${p.name}: ${p.ty}`, and it holds a token's text"
}

fn node_of_another_kind(row: PayloadRow, p: Field, owner: string, variant: string, built: string) -> string {
    "builds `${owner}.${variant}` in `${row.owner}.${row.variant}`'s `${p.name}: ${p.ty}`, and it builds a `${built}`"
}

fn states_no_truth(row: PayloadRow, p: Field, text: string) -> string {
    "states `${row.owner}.${row.variant}`'s `${p.name}: ${p.ty}` as `${text}` — a `bool` payload is stated `true` or `false`, or is the presence of a terminal"
}

fn truth_from_node(row: PayloadRow, p: Field) -> string {
    "fills `${row.owner}.${row.variant}`'s `${p.name}: ${p.ty}` from a built node — a `bool` payload is a terminal's presence, or stated `true` or `false`"
}

fn names_no_operator(row: PayloadRow, word: string) -> string {
    "builds `${row.owner}.${row.variant}` for the word `${word}`, which spells no operator"
}

fn anchor_stated(row: PayloadRow, name: string) -> string {
    "states `${name}`, which anchors `${node_name(row)}` — an anchor names a payload the rule CAPTURES"
}

fn anchor_takes_nothing(row: PayloadRow) -> Diagnostic {
    defect(
        node_name(row),
        "`@anchor` takes no argument — the payload it marks IS the place a node begins",
    )
}

fn two_anchors(row: PayloadRow, first: string, second: string) -> Diagnostic {
    defect(node_name(row), "anchored at `${first}` and `${second}` — a node begins in ONE place")
}

fn anchor_is_presence(row: PayloadRow, p: Field) -> Diagnostic {
    defect(node_name(row), "anchored at `${p.name}: ${p.ty}` — a presence is no place to begin")
}

fn node_name(row: PayloadRow) -> string { "${row.owner}.${row.variant}" }

fn node_refusal(rname: string, message: string) -> Diagnostic {
    defect(rname, "rule `${rname}` ${message}")
}
