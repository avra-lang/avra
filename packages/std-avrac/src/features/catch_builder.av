//! The builder of one `catch` arm: a rule ending `-> Record.CatchArm`
//! labels the variant it names, the name it binds and the value it
//! recovers to. Data, carried by `NCatchArm`.
use core.{CatchArm, Plain, Scoped}
use features.{LangNode, Builder}

impl Builder {
    /// The arm a `CatchArm` rule wrote — a name it does not write is `""`.
    fn catch_arm() -> Result<LangNode, string> {
        .Ok(
            LangNode
                .NCatchArm(
                    CatchArm {
                        variant: Plain((self.texts_of("variant")?).first() ?? ""),
                        bind: Scoped((self.texts_of("bind")?).first() ?? ""),
                        value: self.expr_of("value")?,
                    },
                ),
        )
    }
}
