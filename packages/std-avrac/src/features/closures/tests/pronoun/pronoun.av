// proves: the `it` pronoun — an implicit one-param lambda at the
// nearest METHOD call, seated by the expected-type channel.
// Wrappers, field reads, interpolation holes, nested scopes, and
// the shadowing law (the pronoun wins inside the call).
type U = { name: string, age: int }
fn is_even(n: int) -> bool {
    n % 2 == 0
}
let xs = [1, 2, 3, 4, 5]
let us = [U { name: "ada", age: 36 }, U { name: "bo", age: 7 }]
let it = 1000
let m = [[1, 2, 3], [4]]
let t = 0
let i = 0
while i < 100 {
    t = t + us.filter(it.age > i).length
    i = i + 1
}
"${xs.map(it * 2)[4]} ${xs.filter(is_even(it)).length} ${us.map(it.name)[1]} ${us.map("${it.name}#${it.age}")[0]} ${(us.find(it.age > 17) ?? U { name: "-", age: 0 }).name} ${xs.any(it > 4)} ${m.map(m.filter(it.length > 1).length + it.length)[0]} ${it} ${t}"
