// proves: a lambda in a seat that answers nothing answers nothing, whatever its body's tail: `{}` is an
// empty block there, never a map, and a value written last — made, borrowed, or an instance — is the
// body's to drop at its close, never the fn's answer, which every target's verifier holds to the fn type.
type Tally = { taps: string, n: int }

fn run(f: fn() -> void) { f() }

fn each(f: fn(int) -> void, n: int) { f(n) }

fn made() -> List<int> { [1, 2, 3] }

let kept = [4, 5]
run(() -> {})
run(() -> made())
run(() -> "text ${kept.length}")
run(() -> kept)
run(() -> Tally { taps: "taps", n: 2 })
each((n: int) -> match n { 0 -> {}, _ -> println("many") }, 0)
each((n: int) -> match n { 0 -> {}, _ -> println("many ${n}") }, 3)
"ok ${kept.length} ${kept[1]}"
