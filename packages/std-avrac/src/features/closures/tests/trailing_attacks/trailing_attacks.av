// proves: the red team's accepted attacks answer alike on both engines — nesting, seats, `else`, text, `mut` seats, chains
fn run(f: fn() -> int) -> int { f() }
fn apply(v: int, f: fn(int) -> int) -> int { f(v) }
fn both(a: int, b: int, f: fn(int, int) -> int) -> int { f(a, b) }
fn pick(c: bool, a: fn() -> int, b: fn() -> int) -> int { if c { a() } else { b() } }
fn noop(f: fn() -> void) -> int {
    f()
    7
}
fn text(f: fn() -> string) -> string { f() }
fn twice(f: fn() -> string) -> string { "${f()}${f()}" }
fn grow(mut xs: List<string>, f: fn(mut List<string>) -> int) -> int { f(xs) }
fn deep(n: int) -> int { if n == 0 { 0 } else { run() { deep(n - 1) + 1 } } }
type P = { x: int }
type B = { xs: List<string> }
fn fill(mut b: B, f: fn(mut B) -> void) -> int {
    f(b)
    b.xs.length
}
let nested = run() { run() { run() { 1 } } }
let seats = both(1, 2) { a, b -> a + b }
let inner = apply(1) { x -> apply(2) { x -> x } + x }
let shadow = apply(1) { apply -> apply }
let pron = [[1], [2, 3]].map() { it.map() { it * 2 }.length }[1]
let chosen = pick(false) { 1 } else { 2 }
let ladder = run() { 1 } + run() { 2 } * run() { 3 }
let hole = "v=${run() { 6 }}"
let s = "ab"
let doubled = twice() { "${s}-" }
let xs = ["a"]
let grown = grow(xs) { xs ->
    xs.push("b")
    xs.length
}
let b = B { xs: [] }
let filled = fill(b) { b -> b.xs.push("s") }
let chain = [1, 2, 3].filter() { it > 1 }.map() { x -> x * 10 }.length
let found = [1, 2, 3].find() { it > 1 } ?? 0
let empty = noop() {}
"${nested} ${seats} ${inner} ${shadow} ${pron} ${chosen} ${ladder} ${hole} ${doubled} ${grown} ${xs[1]} ${filled} ${b.xs.length} ${chain} ${found} ${empty} ${deep(5)} ${P { x: run() { 3 } }.x}"
