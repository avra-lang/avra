// proves: a block of match arms in a trailing block is a fn body, on
// both engines — a filter and a map over an enum, a guard, a literal
// arm, exhaustiveness still required, and a lone bind arm still the
// ordinary lambda it always was
enum R {
    Ok(v: int)
    Bad
}
let rs = [R.Ok(1), R.Ok(-1), R.Ok(20), R.Bad]
let kept = rs.filter() { .Ok(v) -> v > 0, _ -> false }.length
let big = rs.filter() { .Ok(v) if v > 10 -> true, .Ok(_) -> false, .Bad -> false }.length
let mapped = rs.map() { .Ok(v) -> v, _ -> 0 }
let lits = [1, 2, 3].filter() { 2 -> true, _ -> false }.length
let bound = [1, -2, 3].filter() { x -> x > 0 }.length
"${kept} ${big} ${mapped[0]} ${mapped[3]} ${lits} ${bound}"
