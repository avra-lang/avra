// proves: a lambda of no parameters in a seat that says its answer promises that answer: a `?`
// inside passes the failure to whoever called it and a `return` answers the lambda, in an argument
// seat and a field seat alike
type Source = { run: fn() -> Result<int, string> }

fn checked(n: int) -> Result<int, string> {
    if n < 0 { fail "negative" }
    n
}

fn source(n: int) -> Source {
    Source {
        run: () -> {
            let v = checked(n)?
            v + 1
        },
    }
}

fn ran(f: fn() -> Result<int, string>) -> Result<int, string> { f() }

fn first(f: fn() -> int) -> int { f() }

fn picked(x: bool) -> int {
    first(
        () -> {
            if x { return 1 }
            2
        },
    )
}

fn said(r: Result<int, string>) -> string {
    match r { .Ok(v) -> "ok ${v}", .Err(e) -> e }
}

"${said(source(1).run())} ${said(source(-1).run())} ${said(ran(() -> checked(4)? * 2))} ${said(ran(() -> checked(-4)? * 2))} ${picked(true)} ${picked(false)}"
