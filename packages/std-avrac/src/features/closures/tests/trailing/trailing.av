// proves: a trailing block is the call's last argument, on both engines — named, method, applied, paren-less, `else`, `it`, `mut` seats
type Counter = { n: int }
impl Counter {
    mut fn bump() { self.n = self.n + 1 }
}
fn twice(f: fn() -> int) -> int { f() + f() }
fn apply(v: int, f: fn(int) -> int) -> int { f(v) }
fn pick(c: bool, a: fn() -> int, b: fn() -> int) -> int { if c { a() } else { b() } }
fn touched(mut c: Counter, f: fn(mut Counter) -> int) -> int { f(c) }
fn adder(n: int) -> fn(int) -> int { (x: int) -> x + n }
fn run(f: fn() -> string) -> string { f() }
let xs = [1, 2, 3]
let doubled = xs.map() { x -> x * 2 }
let found = xs.find() { it > 1 } ?? 0
let sum = xs.map() { x ->
    let y = x * 10
    y + 1
}
let stmts = xs.map() {
    let y = it * 10
    y + it
}
let c = Counter { n: 1 }
let bumped = touched(c) { c ->
    c.bump()
    c.n
}
let written = touched(c) { mut c ->
    c.n = c.n + 10
    c.n
}
let kept = xs.filter() { it > 1 }.length
"${doubled[1]} ${found} ${twice() { 21 }} ${apply(20) { n -> n + 1 }} ${pick(false) { 1 } else { 2 }} ${pick(true) { 1 } else { 2 }} ${sum[2]} ${stmts[0]} ${bumped} ${written} ${c.n} ${kept} ${(adder(40))(2)} ${run() { "ran" }}"
