// proves: a lambda's `mut` seat is written through: each call's write reaches the place the caller
// handed it, the lambda reading what earlier calls wrote.
type Cx = { log: List<int> }

fn twice(mut cx: Cx, f: fn(mut Cx) -> int) -> int { f(cx) + f(cx) }

mut c = Cx { log: [] }
let n = twice(c) { cx ->
    cx.log.push(cx.log.length + 7)
    cx.log.length
}
"${n} ${c.log.length} ${c.log[0]} ${c.log[1]}"
