// proves: a call's own answer, a list's element and a record's field, each a fn value, is called in
// place.
fn adder(n: int) -> fn(int) -> int { (x: int) -> x + n }
type H = { run: fn(int) -> int }
let fs = [adder(1), adder(10)]
let h = H { run: adder(100) }
let direct = (adder(5))(1)
let held = (fs[1])(2)
let field = h.run(3)
"${direct} ${held} ${field}"
