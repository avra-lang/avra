// proves: a call through a nullable fn binding a test proved present calls the fn it carries: a
// seat's, and a map's `get`.
alias F = fn(int) -> int
fn run(f: F?, v: int) -> int {
    if f == null { 0 } else { f(v) }
}
let m = {"f": (x: int) -> x * 2}
let g = m.get("f")
let a = if g == null { 0 } else { g(21) }
"${run((x) -> x + 1, 1)} ${run(null, 1)} ${a}"
