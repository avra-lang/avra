// `?` in a lambda, by seat law: a lambda whose seat says what it answers
// promises that answer, and the failure it passes must fit it; a lambda
// whose seat says nothing still promises none.
use @std.avrac.testing.{shown, refused_with}

const OK: string = "fn ok(n: int) -> Result<int, string> { n }\n"

spec "features/closures — `?` in a lambda" {
    given "a seat that says the answer" {
        then "a good run is auto-Ok'd and a failure passes to the caller" {
            shown(
                "${OK}fn run(f: fn(int) -> Result<int, string>, n: int) -> Result<int, string> { f(n) }\nmatch run((m) -> ok(m)? + 1, 4) {\n    .Ok(v) -> \"ok \${v}\"\n    .Err(e) -> e\n}",
            ) == "ok 5"
        }
        then "a promise that is no Result refuses the failure in the promise's words" {
            refused_with(
                "${OK}fn run(f: fn(int) -> int, n: int) -> int { f(n) }\nrun((m) -> ok(m)?, 1)",
                "`?` makes this fn answer the failure, but it promises `int`",
            )
        }
        then "a failure the promise does not cover is refused" {
            refused_with(
                "${OK}fn run(f: fn(int) -> Result<int, int>, n: int) -> Result<int, int> { f(n) }\nrun((m) -> ok(m)?, 1)",
                "the failures disagree",
            )
        }
    }
    given "a lambda of no parameters in a seat that says the answer" {
        then "a `?` in an argument's lambda passes the failure to the caller" {
            shown(
                "${OK}fn run(f: fn() -> Result<int, string>) -> Result<int, string> { f() }\nfn go(n: int) -> Result<int, string> { run(() -> ok(n)? + 1) }\nmatch go(4) {\n    .Ok(v) -> \"ok \${v}\"\n    .Err(e) -> e\n}",
            ) == "ok 5"
        }
        then "a `?` in a field's lambda passes the failure to the caller" {
            shown(
                "fn ok(n: int) -> Result<int, string> {\n    if n < 0 { fail \"neg\" }\n    n\n}\ntype Source = { run: fn() -> Result<int, string> }\nfn source(n: int) -> Source {\n    Source {\n        run: () -> {\n            let v = ok(n)?\n            v + 1\n        },\n    }\n}\nmatch source(-1).run() {\n    .Ok(v) -> \"ok \${v}\"\n    .Err(e) -> e\n}",
            ) == "neg"
        }
        then "a `return` answers the lambda" {
            shown(
                "fn run(f: fn() -> int) -> int { f() }\nfn go(x: bool) -> int {\n    run(() -> {\n        if x { return 1 }\n        2\n    })\n}\ngo(true) + go(false) * 10",
            ) == "21"
        }
    }
    given "a generic seat whose answer is a `Result` failing with a known type" {
        then "a `fail` in the lambda raises to its caller, and the value is inferred" {
            shown(
                "fn run<T>(f: fn(int) -> Result<T, string>) -> string {\n    match f(3) {\n        .Ok(_) -> \"ok\"\n        .Err(e) -> e\n    }\n}\nrun((n: int) -> {\n    if n > 1 { fail \"too big\" }\n    n\n})",
            ) == "too big"
        }
        then "a `?` in the lambda passes the failure to its caller" {
            shown(
                "${OK}fn run<T>(f: fn(int) -> Result<T, string>, n: int) -> Result<T, string> { f(n) }\nmatch run((m) -> ok(m)? + 1, 4) {\n    .Ok(v) -> \"ok \${v}\"\n    .Err(e) -> e\n}",
            ) == "ok 5"
        }
    }
    given "a seat that says nothing" {
        then "the lambda still promises none" {
            refused_with("${OK}let g = (m: int) -> ok(m)?\n1", "a lambda promises none")
        }
    }
}
