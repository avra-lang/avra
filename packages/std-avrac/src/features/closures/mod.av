//! Closures: `(x: int) -> x * 2` — a fn as a VALUE. The body
//! captures outer names BY VALUE into the closure's box; the box
//! is `[code address, captures…]` and a call rides CallPtr with
//! the box at seat 0, exactly as `self` rides a method call.
//! `fn(int) -> bool` is the type a fn value wears.
use features.{LanguageFeature, BuilderRow}
use grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use diagnostics.{DiagCode}

export fn closures() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name      | build
        "lambda"  | build_lambda
        "fn_type" | build_fn_type
    }
    let codes = table<DiagCode> {
        kind          | id      | summary
        "type.lambda" | "F2033" | "a lambda's parameters, body, and captures obey the closure laws"
    }
    component LanguageFeature f {
        name = "closures"
        docs = "`(x: int) -> x * 2` closures capturing outer names by value; `fn(int) -> bool` fn-value types (`fn(int)` answers nothing); calls dispatch through fn-typed bindings. A seat written `mut` is one the lambda writes through, and an unannotated seat HEARS its slot's mark as it hears its type — so a trailing block on `fn(mut Cx) -> R` writes through the context it is handed."
        gram = grammar {
            type = "fn" "(" ( ( fc:"const" )? ( fm:"mut" )? ft:type ( "," ( fc:"const" )? ( fm:"mut" )? ft:type )* ","? )? ")" ( "->" fr:type )? -> fn_type(fc, fm, ft, fr)
            primary = "(" ( ( lc:"const" )? ( lm:"mut" )? lp:NAME ( ":" lt:type )? ( "," ( lc:"const" )? ( lm:"mut" )? lp:NAME ( ":" lt:type )? )* ","? )? ")" "->" lb:expression -> lambda(lc, lm, lp, lt, lb)
        }
        diags = codes
        builders = rows
    }
    f
}
