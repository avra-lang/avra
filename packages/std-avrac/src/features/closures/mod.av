//! Closures: `(x: int) -> x * 2` — a fn as a VALUE. The body
//! captures outer names BY VALUE into the closure's box; the box
//! is `[code address, captures…]` and a call rides CallPtr with
//! the box at seat 0, exactly as `self` rides a method call.
//! `fn(int) -> bool` is the type a fn value wears (`fn(int)`
//! answers nothing). An unannotated seat HEARS its slot's mark as
//! it hears its type, so a trailing block on `fn(mut Cx) -> R`
//! writes through the context it is handed. A trailing block of
//! MATCH ARMS is a fn body too: `xs.filter { .Ok(v) -> v > 0, _ ->
//! false }` is `xs.filter((it) -> match it { .Ok(v) -> v > 0, _ ->
//! false })` — the first arm's pattern anchors the parse away from
//! a lone bind (`{ x -> body }` stays the ordinary one-seat
//! lambda, unchanged, both spellings one node).
use features.{LanguageFeature, BuilderRow}
use features.closures.{pronoun_lambda}
use @std.grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use diagnostics.{DiagCode}

export fn closures() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name            | build
        "lambda"        | build_lambda
        "fn_type"       | build_fn_type
        "trailing_arms" | build_trailing_arms
    }
    let codes = table<DiagCode> {
        kind               | summary
        "type.lambda"      | "a lambda's parameters, body, and captures obey the closure laws"
        "type.not_offered" | "a lambda takes a record seat's fields by name, and only the fields it offers"
    }
    LanguageFeature closures {
        gram: grammar {
            type = "fn" "(" ( ( fc:"const" )? ( fm:"mut" )? ft:type ( "," ( fc:"const" )? ( fm:"mut" )? ft:type )* ","? )? ")" ( "->" fr:type )? -> fn_type(fc, fm, ft, fr)
            primary = "(" ( ( lc:"const" )? ( lm:"mut" )? lp:NAME ( ":" lt:type )? ( "," ( lc:"const" )? ( lm:"mut" )? lp:NAME ( ":" lt:type )? )* ","? )? ")" "->" lb:expression -> lambda(lc, lm, lp, lt, lb)
            trailing = "{" BREAK* hp:nonbind_pattern ( "if" hg:expression )? "->" hv:expression ( BREAK | "," | a:arm | a:hole_arm )* "}" @expect("}", "expected `}` to close the arms block") -> trailing_arms(hp, hg, hv, a)
            nonbind_pattern = "." vn:NAME "as" r:NAME -> member_pat(vn, r) | "." vn:NAME ( "(" sub:pattern ( "," sub:pattern )* ","? ")" )? -> variant_pat(vn, sub) | "_" -> wild_pat() | "true" -> true_pat() | "false" -> false_pat() | v:NUMBER -> num_pat(v)
        }
        diags: codes
        builders: rows
    }
    closures
}
