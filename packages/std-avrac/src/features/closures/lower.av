//! The lambda's lowering — the ONE meaning: creation mints the fn
//! box through values.av's verbs (the memory pass owns
//! retain-at-pack for managed captures); the LIFT itself is the
//! driver's worklist job.
use core.{ExprId, Reg}
use features.{LowerCx}

fn call_value_reg(mut cx: LowerCx, e: ExprId, subject: ExprId, args: List<ExprId>) -> Reg {
    cx.called_through(e, cx.reg_of(subject), [cx.reg_of(a) for a in args])
}

fn lambda_reg(mut cx: LowerCx, e: ExprId) -> Reg {
    let name = cx.lift(e)
    let caps = cx.capture_regs(e)
    let size = cx.box_size(1 + caps.length)
    let dst = cx.result(e)
    cx.fn_box(dst, size, name, caps)
    dst
}
