//! The lambda's lowering — the ONE meaning: creation mints the fn
//! box through values.av's verbs (the memory pass owns
//! retain-at-pack for managed captures); the LIFT itself is the
//! driver's worklist job.
use core.{ExprId, Reg}
use features.{LowerCx, fn_box, called_through}

fn call_value_reg(cx: LowerCx, e: ExprId, subject: ExprId, args: List<ExprId>) -> Reg {
    called_through(cx, e, cx.reg_of(subject), [cx.reg_of(a) for a in args])
}

fn lambda_reg(cx: LowerCx, e: ExprId) -> Reg {
    let name = cx.lift(e)
    let caps = cx.capture_regs(e)
    let dst = cx.result(e)
    fn_box(cx, dst, name, caps)
    dst
}
