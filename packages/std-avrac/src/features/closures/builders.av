//! A block of arms after a call: a one-seat lambda that matches its seat.
use core.{Expr, Scoped, Slots, Built, pronoun_param, computed}

/// `f { pattern -> value, … }` — the call's last argument is `it ->
/// match it { … }`, the match marked as the sugar's own (its implicit
/// tail is the arms block's, never a program's).
@computed
fn arms_lambda_written(s: dyn Slots) -> Result<Built, string> {
    let store = s.arena()
    let subject = store.alloc_expr(Expr.Ident(Scoped("it")), s.built_at())
    let matched = store.alloc_expr(Expr.Match(subject, s.arms_of("arms")?), s.built_at())
    store.mark_sugar_match(matched)
    .Ok(Built.Expr(s.made_expr(Expr.Lambda([pronoun_param], matched))?))
}
