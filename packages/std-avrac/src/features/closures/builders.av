//! Parse-time lowering: captures -> the Lambda node and the fn
//! TYPE. A param's annotation is optional in the PARSE (the typing
//! law demands it until the expected-type channel lands). A fn type's
//! seats arrive built, one `Record.ParamSyntax` each.
use core.{Expr, Arm, TypeRef, Scoped, pronoun_param, flatten, some_list}
use features.{LangNode, Builder, params_at, pat_id_at, expr_id_at, arms_at}

/// `fn(mut int, bool) -> bool` — the LAST arg is the return
/// (`arrow` is the pinned witness of that contract), and a seat's
/// `mut` says the callee WRITES THROUGH it.
fn build_fn_type(b: Builder) -> Result<LangNode, string> {
    let seats = params_at(b.args, 0)
    b
        .make_type(
            TypeRef {
                name: "fn",
                args: flatten([some_list(s.ty) for s in seats]).concat([b.answer(1)]),
                optional: false,
                dynamic: false,
                arrow: true,
                span: b.span,
                marks: [s.promises for s in seats],
            },
        )
}

fn build_trailing_arms(b: Builder) -> Result<LangNode, string> {
    let hp? = pat_id_at(b.args, 0) else {
        return .Err(
            "defect: an arms block's first pattern is missing — the arena and the grammar disagree",
        )
    }
    let hg = expr_id_at(b.args, 1)
    let hv = b.expr(2)?
    let rest = arms_at(b.args, 3)
    let arms = [Arm { pats: [hp], guard: hg, value: hv }].concat(rest)
    let subject = b.expr_node(Expr.Ident(Scoped("it")))
    let matched = b.expr_node(Expr.Match(subject, arms))
    b.store.mark_sugar_match(matched)
    b.make_expr(Expr.Lambda([pronoun_param], matched))
}
