//! The lambda's semantics: dispatch only. CONTROL-OWNING — the
//! body hides from `kids` and walks under the lambda's own frame
//! (resolve) and law (typing); the lift owns its lowering.
use core.{ExprId, TypeId, Reg, Kids}
use features.{ResolveCx, TypeCx, LowerCx, nothing, Meaning, meant_type, meant_reg}

use core.expr.{Lambda, CallValue, ArmsMatch}

/// The LAMBDA's body hides (control-owning).
impl Kids for Lambda {
    fn kids() -> List<ExprId> { [] }
}

impl Meaning for Lambda {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        cx.lambda_scope(e, self.params, self.body)
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        lambdaed(cx, e, self.params, self.body)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        lambda_reg(cx, e)
    }
}
impl Meaning for ArmsMatch {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        meant_type(cx, e)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        meant_reg(cx, e)
    }
}
impl Meaning for CallValue {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        call_value_type(cx, e, self.subject, self.args)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        call_value_reg(cx, e, self.subject, self.args)
    }
}
