//! The lambda's semantics: dispatch only. CONTROL-OWNING — the
//! body hides from `kids` and walks under the lambda's own frame
//! (resolve) and law (typing); the lift owns its lowering.
use core.{Expr, ExprId, TypeId, Reg}
use features.{NodeSemantics, ResolveCx, TypeCx, LowerCx, nothing}

export type ClosureSemantics = { }

impl NodeSemantics for ClosureSemantics {
    fn kids(e: Expr) -> List<ExprId> {
        // the LAMBDA's body hides (control-owning); a CallValue's
        // subject and arguments are ordinary children
        // a feature cannot enumerate OTHER features' variants
        match e {
            .CallValue(subject, args) -> [subject].concat(args),
            _ -> [],
        }
    }

    fn resolve(mut cx: ResolveCx, e: ExprId) {
        // a feature cannot enumerate OTHER features' variants
        match cx.view.store.expr(e) {
            .Lambda(params, body) -> cx.lambda_scope(e, params, body),
            _ -> nothing(),
        }
    }

    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        // a feature cannot enumerate OTHER features' variants
        match cx.view.store.expr(e) {
            .CallValue(subject, args) -> call_value_type(cx, e, subject, args),
            _ -> lambda_type(cx, e),
        }
    }

    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        // a feature cannot enumerate OTHER features' variants
        match cx.view.store.expr(e) {
            .CallValue(subject, args) -> call_value_reg(cx, e, subject, args),
            _ -> lambda_reg(cx, e),
        }
    }
}
