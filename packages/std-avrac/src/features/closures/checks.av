//! The typing rule of a lambda: each parameter is its written type, or else its seat's when the
//! lambda checks into a fn type, and makes the promises either makes; its body checks in a scope of its own against the seat's answer,
//! which is the lambda's answer, the body's widening into it; and the lambda is the fn type it makes
//! once all of that is known, and where it stands is: a seat it can't see may widen it. A name from
//! further out reads in the body as it may be when the lambda runs, never narrowed by a test around
//! it.
use core.{Checking, Checks, ExprId, Expected, SignedSeat, SignedType, TypeHead, headed_type}
use core.expr.{Lambda}

impl Checks for Lambda {
    fn checked(mut cx: Checking, e: ExprId, expected: Expected) -> SignedType? {
        let seat = seat_fn(expected, self.params.length)
        let seated = !(expected is .Unknown)
        let params = [if p.ty != null { cx.written(p.ty!) } else { seat?.seats?.get(at)?.ty } for at, p in self.params]
        cx.fenced()
        for at, p in self.params { cx.bind(p.name.of, params[at]) }
        let wanted = seat?.answer
        let read = cx
            .check(self.body, if wanted != null { Expected.Exactly(wanted!) } else { Expected.Free })
        let answer = wanted ?? read
        cx.closed()
        if !seated || answer == null || params.any(it == null) { return null }
        headed_type(TypeHead.Function) with { seats: [SignedSeat {
            ty: params[at]!,
            mutable: p.promises.mutable || seat?.seats?.get(at)?.mutable ?? false,
            settled: p.promises.settled || seat?.seats?.get(at)?.settled ?? false,
        } for at, p in self.params], answer: answer }
    }
}

/// The fn type a lambda's seat wants, when it wants one of `arity` seats.
fn seat_fn(expected: Expected, arity: int) -> SignedType? {
    let wanted? = match expected { .Exactly(ty) -> ty, rest -> null } else { return null }
    if wanted.head is .Function && wanted.seats.length == arity && !wanted.nullable() { wanted } else { null }
}
