//! The lambda's typing law: every parameter ANNOTATED (inference
//! rides the recorded expected-type channel), the body typed under
//! the params behind the return barrier, the whole wearing
//! `fn(params) -> body`.
use core.{ExprId, Type, TypeId, Arrow, Param, LambdaParts}
use features.{TypeCx, spoken, seats_judged, this_is, settled_call}
use diagnostics.{refusal}

fn lambda_type(cx: TypeCx, e: ExprId) -> TypeId {
    // LICENSED I22: a feature cannot enumerate OTHER features' variants
    match cx.view.store.expr(e) {
        .Lambda(params, body) -> lambdaed(cx, e, params, body),
        _ -> cx.error_type,
    }
}

fn lambdaed(cx: TypeCx, e: ExprId, params: List<Param>, body: ExprId) -> TypeId {
    let heard: List<TypeId>? = heard_seats(cx, e, params)
    if heard == null {
        // no annotations, no want: DEFER — the first judging seat
        // rescues, or the walk's end refuses
        if cx.starving() {
            unfed_lambda(cx, e, cx.starved_at(e))
            return cx.error_type
        }
        cx.go_hungry(e)
        return cx.error_type
    }
    let ptys = heard!
    if ptys.any(erred(cx, it)) { return cx.error_type }
    let ret = cx.lambda_body(e, ptys, body)
    if cx.view.types.shape_of(ret) is .Error { return cx.error_type }
    cx.view.types.intern(Type.Fn(ptys, ret))
}

/// The seats a lambda's params wear: each annotation speaks for
/// itself; an unannotated param hears the WANT's matching seat.
/// Null when a seat stays silent.
fn heard_seats(cx: TypeCx, e: ExprId, params: List<Param>) -> List<TypeId>? {
    let arrow: Arrow? = wanted_arrow(cx, e, params.length)
    mut ptys: List<TypeId> = []
    // LICENSED I3: seat by ordinal; comprehensions cannot destructure enumerate
    for (j, pp) in params.enumerate() {
        if pp.ty != null {
            ptys.push(cx.written_at(e, pp.ty!))
        } else {
            if arrow == null { return null }
            ptys.push(arrow!.seats[j])
        }
    }
    ptys
}

/// The want's arrow, when one was planted and its arity fits.
fn wanted_arrow(cx: TypeCx, e: ExprId, arity: int) -> Arrow? {
    let w: TypeId? = cx.want_at(e)
    if w == null { return null }
    let arrow: Arrow? = cx.view.types.arrow_parts(w!)
    if arrow == null { return null }
    if arrow!.seats.length != arity { return null }
    arrow
}

fn erred(cx: TypeCx, ty: TypeId) -> bool {
    cx.view.types.shape_of(ty) is .Error
}

/// A call on an EXPRESSION: whatever fn value the subject holds,
/// its seats judge — the same one law every call shape shares.
fn call_value_type(cx: TypeCx, e: ExprId, subject: ExprId, args: List<ExprId>) -> TypeId {
    settled_call(cx, args, valued(cx, e, subject, args))
}

fn valued(cx: TypeCx, e: ExprId, subject: ExprId, args: List<ExprId>) -> TypeId {
    let held: Arrow? = cx.view.types.arrow_parts(cx.type_at(subject))
    if held != null { return seats_judged(cx, e, cx.name_at(subject), held!.seats, held!.answer, args) }
    if cx.shape_at(subject) is .Error { return cx.error_type }
    uncallable(cx, e, subject)
}

/// THE WALK-END VOICE: a lambda no seat ever fed speaks once —
/// the driver brings each hungry lambda here with the seat that
/// starved it, if one did.
export fn unfed_lambda(cx: TypeCx, e: ExprId, seat: TypeId?) {
    let name = first_param_name(cx, e)
    if seat == null { return never_heard(cx, e, name) }
    let at = seat!
    if name == "it" { return pronoun_starved(cx, e, at) }
    if cx.view.types.arrow_parts(at) != null { return misfit_lambda(cx, e, at) }
    lambda_at_scalar(cx, e, at)
}

fn first_param_name(cx: TypeCx, e: ExprId) -> string {
    let parts: LambdaParts? = cx.view.store.lambda_parts(e)
    if parts == null { return "the parameter" }
    parts!.params.first()?.name ?? "the parameter"
}

// ── The voices ──

fn never_heard(cx: TypeCx, e: ExprId, name: string) {
    cx.emit(refusal("type.lambda", cx.loc_of(e), "`${name}` needs a type — this lambda's slot tells it nothing", "in this lambda", "annotate — `(${name}: int) -> …` — or hand the lambda to a slot that knows its seats"))
}

fn pronoun_starved(cx: TypeCx, e: ExprId, seat: TypeId) {
    cx.emit(refusal("type.lambda", cx.loc_of(e), "`it` has no element here — this seat takes `${cx.view.types.name_of(seat)}`, not a fn", "the pronoun", "`it` binds to the NEAREST method call — inside another call's argument, write the outer lambda out: `(k) -> …`"))
}

fn misfit_lambda(cx: TypeCx, e: ExprId, seat: TypeId) {
    cx.emit(refusal("type.lambda", cx.loc_of(e), "this lambda does not fit its seat, `${cx.view.types.name_of(seat)}`", "in this lambda", "match the seat's params, or annotate them"))
}

fn lambda_at_scalar(cx: TypeCx, e: ExprId, seat: TypeId) {
    cx.emit(refusal("type.lambda", cx.loc_of(e), "a lambda cannot sit here — this seat takes `${cx.view.types.name_of(seat)}`", "in this lambda", "hand it to a fn-typed slot, or call it"))
}

fn uncallable(cx: TypeCx, e: ExprId, subject: ExprId) -> TypeId {
    let n = cx.name_at(subject)
    spoken(cx, refusal("type.lambda", cx.loc_of(e), "this is not callable — it holds a `${n}`", this_is(n), "only fns and fn-typed values take arguments"))
}
