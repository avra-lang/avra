//! The lowering rules of a lambda and a call through a fn value: a lambda is its body lifted as its
//! own unit and the box holding that body's code then what it captures, read where it stands; a call
//! through a value reads the code from the box and hands it the box, then each argument.
use core.{ExprId, Lowering, Lowers, Reg, lift_refusal}
use core.expr.{CallValue, Lambda}

impl Lowers for Lambda {
    /// A lambda the source wrote: its box, or where it captures nothing, its code laid out once as data.
    fn lowered(mut cx: Lowering, e: ExprId) -> Reg {
        let ty? = cx.type_at(e) else { return cx.unlowered(e) }
        if cx.store.expr_span(e) == null { return cx.missed_as("a lambda no source wrote") }
        let refused = lift_refusal(self, ty, cx.offered_record(self, ty) != null)
        if refused != null { return cx.missed_as(refused!) }
        let lift = cx.lift(self, ty, e, cx.program)
        cx.kept_lift(lift)
        if lift.lanes.is_empty() { return cx.fn_static(cx.laid_out(ty), lift.body.symbol, ty) }
        cx.fn_box(cx.laid_out(ty), lift.body.symbol, [cx.lane_of(name) for name in lift.lanes], ty)
    }
}

impl Lowers for CallValue {
    /// The fn value, then each argument into its seat, then the code read from its box, then the call,
    /// then each place a `mut` seat was handed written back.
    fn lowered(mut cx: Lowering, e: ExprId) -> Reg {
        let held? = cx.type_at(self.subject) else { return cx.unlowered(e) }
        let f? = cx.program.checked.called_as(held) else { return cx.unlowered(e) }
        let box = cx.lower(self.subject)
        let mark = cx.handing_mark()
        let args? = cx.value_seated(f, self.args) else { return cx.missed_as("a call through a fn value whose seat promises") }
        let r = cx.called_code(cx.layout_at(e), cx.code_of(box), box, args, f)
        cx.handed_back(mark)
        r
    }
}
