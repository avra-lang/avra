//! Parse-time lowering: the statement becomes the const that reads the
//! file through its kind — `provided<Kind>("path")`, whose literal the
//! embed law judges and whose kind the checker holds to `Provider`.
use core.{Expr, Stmt, Scoped}
use features.{LangNode, Builder}

fn build_asset(b: Builder) -> Result<LangNode, string> {
    let name = b.token(0)?
    let kinds = b.type_refs(1)?
    let kind? = kinds.first() else { return .Err(unpinned_asset(name.text)) }
    let path = b.token(2)?
    let read = b
        .expr_node(
            Expr
                .Call(
                    Scoped("provided"),
                    [kind],
                    [b.store.alloc_expr(Expr.StrLit(path.text), path.span)],
                ),
        )
    b.make_stmt(Stmt.ConstDecl(Scoped(name.text), kind, read))
}

// ── voices ──────────────────────────────────────────────────────

/// An asset's type is written; the file's bytes do not choose it.
fn unpinned_asset(name: string) -> string {
    "an asset names its kind — `asset ${name}: Picture = \"…\"` — the file's octets do not choose it"
}
