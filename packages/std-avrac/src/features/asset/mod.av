//! `asset NAME: Kind = "path"` — a file the build has, as a const of
//! the kind it is pinned to. PURE SUGAR: the statement is the const
//! `NAME: Kind = provided<Kind>("path")`, so the
//! embed law judges the path and the const law settles the handle —
//! a missing file is refused at the literal, and a kind that reads
//! other octets than the file holds is a const that refused to settle.
use features.{LanguageFeature}
use @std.grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}

export fn asset_files() -> LanguageFeature {
    LanguageFeature asset_files {
        gram: grammar {
            stmt = "asset" name:NAME ( ":" ty:type )? "=" path:STRING END @recover(sync_to: "END") -> Stmt.ConstDecl by asset_written
        }
    }
    asset_files
}
