// proves: an `asset` statement's names are written where their libraries declare
// them — this file's own `provided` and `bundled` are neither called nor taken for the mark
use @std.assets.{Picture}

fn provided(path: string) -> int { 99 }

fn bundled() -> int { 98 }

asset logo: Picture = "art/logo.png"

fn drawn(p: Picture) -> string {
    match p { .Bundled(_, w, h, _) -> "${w}x${h}", .Remote(_, w, h) -> "remote ${w}x${h}" }
}

"${drawn(logo)} ${provided("x")} ${bundled()}"
