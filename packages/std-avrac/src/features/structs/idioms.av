//! The formatter's idioms for this feature — `rule`s, found by
//! directory like everything else this feature owns.
use features.{Code, Fix}
use diagnostics.{warning}

/// A hand-rolled identity comparison — every typed id (`TypeId`,
/// `ExprId`, a struct wrapping one field) is compared by `.index`
/// pervasively in this compiler's own source (every site LICENSED
/// I9), but the SHAPE that makes the comparison honest — one word,
/// nothing more — is a property of the type, not of the site that
/// wrote it. `avra fix` names no mechanical rewrite here: a
/// `.index` comparison names no verb the type doesn't already
/// carry, so this rule only SAYS, never rewrites.
@keeps("a.name == b.name")
export rule index_compared {
    // LICENSED I9: this pattern IS what the idiom names — a rule
    // matches the shape it warns about, never performs it
    quote { ${a}.index == ${b}.index } -> hand_rolled_identity(a, b)
    // LICENSED I9: this pattern IS what the idiom names — a rule
    // matches the shape it warns about, never performs it
    quote { ${a}.index != ${b}.index } -> hand_rolled_identity(a, b)
}

fn hand_rolled_identity(a: Code, b: Code) -> Fix {
    Fix.Say(warning("type.index_compared", a.loc(), "a hand-rolled identity comparison between `${a.text()}` and `${b.text()}` — LICENSED I9 sites read `.index` because the agreement law already does, not because a program should", "this comparison", "compare the values the type itself agrees by, or license this site if it IS that law"))
}
