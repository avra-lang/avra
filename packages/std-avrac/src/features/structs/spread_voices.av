//! The words a field spread written against its form is refused in:
//! the grammar's own refusals, each a rule over the form it names.
use features.{RefusalWords, three_dots, one_dot, valued_spread, typed_spread, bare_spread}

// ── voices ──

fn spread_three_dots() -> RefusalWords { RefusalWords { message: three_dots(), help: spread_form() } }

fn spread_one_dot() -> RefusalWords { RefusalWords { message: one_dot(), help: spread_form() } }

fn spread_valued() -> RefusalWords { RefusalWords { message: valued_spread(), help: spread_form() } }

fn spread_typed() -> RefusalWords { RefusalWords { message: typed_spread(), help: spread_form() } }

fn spread_bare() -> RefusalWords { RefusalWords { message: bare_spread(), help: spread_form() } }

/// The one form every spread refusal points to.
fn spread_form() -> string { "write the record whose fields it places — `..R`" }
