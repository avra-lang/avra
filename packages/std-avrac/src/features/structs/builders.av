//! Parse-time lowering: captured tokens and expressions -> the
//! StructDecl statement and the StructLit node. Names and their
//! types (or values) arrive as parallel capture lists and zip.
use core.{Expr, Stmt}
use features.{LangNode, Builder, zip_defect, fields_zipped}

fn build_struct_decl(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let tp = b.tokens(1)?
    let fs = b.tokens(2)?
    let ft = b.type_refs(3)?
    let fds = b.exprs(4)?
    let fields = fields_zipped(b, fs, ft, fds)?
    b.make_stmt(Stmt.StructDecl(n.text, [t.text for t in tp], fields))
}

fn build_struct_lit(b: Builder) -> Result<LangNode, string> {
    let t = b.token(0)?
    let vn = b.tokens(1)?
    let ve = b.exprs(2)?
    if vn.length != ve.length { return Result.Err(zip_defect()) }
    let names = [k.text for k in vn]
    b.make_expr(Expr.StructLit(t.text, names, ve))
}
