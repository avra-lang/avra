// proves: `.of` on a NAMED type over a RECORD answers the record, as
// it does over a scalar — the name's own property is asked before the
// shape it stands over, in lowering as in typing. A field read still
// sees through the name, and a record whose own field is `of` keeps it.
type Span = { lo: int, hi: int }
type Spanned = Span
type Deep = Spanned
type Wrap = { of: int }
type Wrapped = Wrap

fn width(s: Spanned) -> int {
    s.of.hi - s.of.lo
}

let s: Spanned = Spanned(Span { lo: 1, hi: 2 })
let d: Deep = Deep(s)
let w = Wrap { of: 7 }
let n: Wrapped = Wrapped(w)

"${s.of.hi} ${s.lo} ${d.of.of.hi} ${d.hi} ${w.of} ${n.of.of} ${width(Spanned(Span { lo: 3, hi: 10 }))}"
