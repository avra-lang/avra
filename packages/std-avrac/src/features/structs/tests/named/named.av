// proves: NAMED TYPES — `type N = <shape>` is its own type over a
// shape. A literal fills it, `N(value)` converts, every read
// forwards to the shape, and two values of one name add to that
// name. The name is FREE at runtime: each value IS its shape.
type UserId = int
type Celsius = float
type Ready = bool
type Tag = string
type Rows = List<int>
type Counts = Map<string, int>

fn label(t: Tag) -> string {
    "tag:${t}"
}

fn sum_of(rows: Rows) -> int {
    mut total = 0
    for v in rows { total = total + v }
    total
}

fn next(id: UserId) -> UserId {
    id + UserId(1)
}

let id: UserId = 5
let warm: Celsius = 1.5
let on: Ready = true
let t: Tag = "hello"
let rows: Rows = [1, 2, 3]
let counts: Counts = { "a": 1 }

mut grow: Rows = [1]
grow.push(9)

"${id} ${next(id)} ${id == UserId(5)} ${warm} ${on} ${t} ${t.length} ${t.contains("ell")} ${label(t)} ${rows.length} ${rows[0]} ${sum_of(rows)} ${grow.length} ${grow[1]} ${counts.get("a") ?? 0} ${UserId(7)}"
