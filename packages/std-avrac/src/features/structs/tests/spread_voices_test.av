// Each malformed field spread is refused by a voice that states its law.
use @std.avrac.testing.{refused_with}

spec "features/structs — a malformed field spread names its form" {
    given "a spread written against the form" {
        then "a bare spread names no record" {
            refused_with(
                "type C = { a: int }\ntype A = { x: int, .. }\n1",
                "a spread names the record it places: `..R`",
            )
        }
        then "one dot is not a spread" {
            refused_with(
                "type C = { a: int }\ntype A = { x: int, .C }\n1",
                "a spread is written `..R` — two dots, not one",
            )
        }
        then "a spread takes no value" {
            refused_with(
                "type C = { a: int }\ntype A = { x: int, ..C = 1 }\n1",
                "a spread places a record's fields and takes no value",
            )
        }
        then "a spread names a record, not a field type" {
            refused_with(
                "type C = { a: int }\ntype A = { x: int, ..C: int }\n1",
                "a spread names a record, not a field type",
            )
        }
        then "three dots keep their own voice" {
            refused_with(
                "type C = { a: int }\ntype A = { x: int, ...C }\n1",
                "a spread is written `..R` — two dots, where other languages write three",
            )
        }
    }
}
