// proves: a field a record takes from one it spreads is left to the
// default that record writes — through two spreads, and in a component.
type Stand = { key: string = "k", depth: int = 2 }

type Placed = { at: int = 1, ..Stand }

type Box = { label: string = "box", ..Placed }

component card {
    title: string
    ..Box
}

let b = Box {}
let c = Box { key: "own" }

card hello {
    title: "hi"
}

"${b.label} ${b.at} ${b.key} ${b.depth} ${c.key} ${hello.title} ${hello.key} ${hello.depth}"
