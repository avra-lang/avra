// proves: a generic record's literal leaving out a field whose type names its type parameters calls
// that field's default as the record's type arguments lay it out — inferred from the seat, written
// on the literal, or under a generic fn's own parameter — in both engines
type Tray<T> = { label: string = "x", held: List<T> = [], first: T? = null }

fn made() -> Tray<int> { Tray { label: "y", held: [1] } }

fn left() -> Tray<int> { Tray { label: "z" } }

fn words() -> Tray<string> { Tray {} }

fn under<T>(x: T) -> int {
    let t: Tray<T> = Tray { first: x }
    t.held.length + if t.first == null { 0 } else { 1 }
}

let pinned = Tray<float> { label: "p" }
"${made().held.length} ${left().held.length} ${left().first == null} ${words().label} ${pinned.label} ${pinned.held.length} ${under(4)} ${under("s")}"
