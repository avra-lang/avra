// proves: a field wearing `@std/meta`'s `Words` under another name says its head's text again, as `Words` does
use @std.meta.{Words as Said}

fn quiet() -> string { "(default)" }

component said(message: string) {
    words: Said = Said(quiet)
}

state n: int = 3

let held = said "n is ${n}"
let plain = said "no holes"
let before = (held.words)()
n = 4
"${held.message} / ${before} / ${(held.words)()} / ${(plain.words)()}"
