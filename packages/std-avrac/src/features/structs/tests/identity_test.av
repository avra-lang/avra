// `@identity`: every field of a marked type is a `Cell<…>`, or
// another `@identity` type — the law compiler/typing/declare.av
// holds over the compiler's own shared structures, judged by
// DECLARATION: the annotation must resolve to `@std/meta`'s own
// `identity`, never a bare compare of the word. Packaged rather than
// a lone source, since a lone source cannot import `@std/meta`
// (compiler/dev/witnesses.av's `identity_golden`) — `provided`
// vendors the real package so the annotation genuinely resolves.
//
// A PLAIN field is licensed by `@plain_field("name")` beside
// `@identity`, read off the record's own declaration and nothing
// else — no type name licenses anything.
use @std.avrac.testing.{provided, said}
use @std.avrac.compiler.{Program}

fn checked(main: string) -> string {
    provided("use @std.meta.{identity}\n" + main, "").report()
}

fn checked_plain(main: string) -> string {
    provided("use @std.meta.{identity, plain_field}\n" + main, "").report()
}

/// Whether the program spoke `type.alias_copy` — a `mut` local's
/// path was opened.
fn copies(p: Program) -> bool { said(p).any(it.kind == "type.alias_copy") }

fn opened(main: string) -> bool { copies(provided("use @std.meta.{identity, plain_field}\n" + main, "")) }

spec "features/structs (identity)" {
    given "a type marked `@identity`, resolved to `@std/meta`'s own" {
        then "a `Cell` field is accepted — no field of `G` is refused" {
            !checked("@identity\ntype G = { a: Cell<int> }\n1").contains("field `a`")
        }
        then "a field naming another `@identity` type is accepted" {
            !checked(
                "@identity\ntype Inner = { a: Cell<int> }\n@identity\ntype Outer = { inner: Inner }\n1",
            )
                .contains("field `inner`")
        }
        then "a bare, non-`Cell` field is refused, naming the field and its type" {
            let out = checked("@identity\ntype Bad = { a: Cell<int>, b: int }\n1")
            out.contains("[type.identity_field]") &&
                out.contains("field `b` is `int`") &&
                !out.contains("field `a`")
        }
        then "a field naming an UNMARKED declared type is refused the same way" {
            checked("type Plain = { a: int }\n@identity\ntype Bad = { p: Plain }\n1")
                .contains("field `p` is `Plain`")
        }
    }
    given "a type with no `@identity` mark" {
        then "a bare field is ordinary — the law never fires" {
            !checked("type P = { a: int, b: string }\n1").contains("type.identity_field")
        }
    }
    given "a package's OWN fn named `identity`, never `@std/meta`'s" {
        then "the law never fires — identity is a DECLARATION, not a word" {
            !provided(
                "fn identity(x: int) -> int { x }\n@identity\ntype Bad = { a: Cell<int>, b: int }\n1",
                "",
            )
                .report()
                .contains("type.identity_field")
        }
    }
    given "a plain field licensed AT THE TYPE's own site, `@plain_field(\"name\")`" {
        then "the licensed field is accepted, no table entry anywhere" {
            !checked_plain(
                "@identity\n@plain_field(\"b\")\ntype Licensed = { a: Cell<int>, b: int }\n1",
            )
                .contains("field `b`")
        }
        then "the license is scoped to its OWN type's annotation, never a shared table" {
            let out = checked_plain(
                "@identity\n@plain_field(\"b\")\ntype Licensed = { a: Cell<int>, b: int }\n@identity\ntype Unlicensed = { c: Cell<int>, b: int }\n1",
            )
            out.contains("[type.identity_field]") && out.contains("field `b` is `int`")
        }
        then "the remedy names `@plain_field(\"b\")` and no table" {
            let out = checked("@identity\ntype Bad = { a: Cell<int>, b: int }\n1")
            out.contains("@plain_field(\"b\")") && !out.contains("identity_plain")
        }
        then "a type named `Workspace` with an unmarked plain `host` is refused" {
            checked("@identity\ntype Workspace = { a: Cell<int>, host: int }\n1")
                .contains("field `host` is `int`")
        }
    }
    given "a write through a `mut` local's path to an `@identity`" {
        then "replacing a slot of an all-`Cell` identity opens it — a copy does not share its slots" {
            opened(
                "@identity\ntype T = { rows: Cell<List<int>> }\nimpl T {\n    fn reset() {\n        let none: List<int> = []\n        self.rows = Cell.new(none)\n    }\n}\ntype H = { t: T }\nlet seed: List<int> = []\nmut h = H { t: T { rows: Cell.new(seed) } }\nh.t.reset()\n1",
            )
        }
        then "an `@identity` holding a plain field is opened" {
            opened(
                "@identity\n@plain_field(\"log\")\ntype T = { rows: Cell<List<int>>, log: List<int> }\nimpl T { fn note(v: int) { self.log.push(v) } }\ntype H = { t: T }\nlet seed: List<int> = []\nmut h = H { t: T { rows: Cell.new(seed), log: [] } }\nh.t.note(1)\n1",
            )
        }
        then "an `@identity` nesting one that holds a plain field is opened" {
            opened(
                "@identity\n@plain_field(\"log\")\ntype In = { rows: Cell<List<int>>, log: List<int> }\nimpl In { fn note(v: int) { self.log.push(v) } }\n@identity\ntype Out = { i: In }\nimpl Out { fn poke() { self.i.note(1) } }\ntype H = { o: Out }\nlet seed: List<int> = []\nmut h = H { o: Out { i: In { rows: Cell.new(seed), log: [] } } }\nh.o.poke()\n1",
            )
        }
        then "a write through a cell alone opens nothing" {
            !opened(
                "@identity\ntype T = { rows: Cell<List<int>> }\nimpl T { fn add(v: int) { self.rows.push(v) } }\ntype H = { t: T }\nlet seed: List<int> = []\nmut h = H { t: T { rows: Cell.new(seed) } }\nh.t.add(1)\n1",
            )
        }
    }
}
