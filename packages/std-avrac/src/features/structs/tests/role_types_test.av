// A role is a TYPE, and the type is `@std/meta`'s own: a program's `Cells`,
// `Structural`, `Opaque` or `Words` is a different type that happens to be
// spelled alike, and a record literal that leaves a field of it unset is
// refused like any other missing field — the compiler fills only the slots
// whose type is the meta one.
use @std.avrac.testing.{refused_with}

spec "features/structs — a role is the meta type, never a spelling" {
    given "a program's own type spelled like a role" {
        then "a field of a user's `Cells` is not filled" {
            refused_with(
                "type Cells = List<int>\ntype R = { cells: Cells }\nlet r = R {}\n1",
                "needs field `cells`",
            )
        }
        then "nor a user's `Structural`" {
            refused_with(
                "type Structural = List<int>\ntype R = { s: Structural }\nlet r = R {}\n1",
                "needs field `s`",
            )
        }
        then "nor a user's `Opaque`" {
            refused_with(
                "type Opaque = bool\ntype R = { o: Opaque }\nlet r = R {}\n1",
                "needs field `o`",
            )
        }
        then "nor a user's `Words`" {
            refused_with(
                "type Words = fn() -> string\ntype R = { w: Words }\nlet r = R {}\n1",
                "needs field `w`",
            )
        }
    }
}
