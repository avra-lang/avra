// proves: a record literal spreads records — written order, later wins;
// `P { ..a, x: v }` is `a with { x: v }`
type Point = { x: int, y: int, z: int }
type Flat = { n: int }
type Tagged = { name: string, tags: List<string>, n: int }
type Xy = { x: int, y: int }

let a = Point { x: 1, y: 2, z: 3 }
let b = Point { ..a, x: 9 }
let c = Point { x: 0, y: 0, z: 0 }
let d = Point { ..a, ..c, z: 7 }
let e = Point { z: 5, ..Xy { x: 4, y: 6 } }
let f = Flat { ..Flat { n: 3 } }
let t = Tagged { name: "t", tags: ["a", "b"], n: 1 }
let u = Tagged { ..t, n: 2 }
let w = a with { x: 9 }
"${b.x}${b.y}${b.z} ${d.x}${d.y}${d.z} ${e.x}${e.y}${e.z} ${f.n} ${u.name} ${u.tags.length} ${u.n} ${t.n} ${w.x == b.x} ${a.x}"
