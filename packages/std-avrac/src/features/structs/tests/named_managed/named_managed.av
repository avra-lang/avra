// proves: a NAMED TYPE over a MANAGED shape owns nothing extra. The
// value IS the list (the pack is identity), so it crosses fn
// boundaries, rides a cell, grows in a loop and is rebuilt many
// times with the ordinary reference counting — no box of its own to
// leak and none to free twice.
type Rows = List<int>
type Tag = string

fn widened(rows: Rows) -> Rows {
    rows.concat([0])
}

fn joined_up(t: Tag, u: Tag) -> Tag {
    Tag("${t}-${u}")
}

fn churn(turns: int) -> int {
    mut held: Rows = []
    mut i = 0
    while i < turns {
        held = widened(held)
        i = i + 1
    }
    held.length
}

let base: Rows = [1, 2]
let wide = widened(base)
let name = joined_up(Tag("a"), Tag("b"))
mut bag: Rows = []
for v in wide { bag.push(v) }

"${base.length} ${wide.length} ${wide[2]} ${name} ${name.length} ${churn(200)} ${bag.length} ${bag[0]}"
