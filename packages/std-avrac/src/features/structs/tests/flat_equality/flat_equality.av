// proves: two values of one record type of ONE field compare by that
// field — `==`, `!=`, a string field by its text, a nested one-field
// record through, a list's `contains`/`index_of`, and a nullable
// against a present value — in both engines
type Id = { index: int }

type Name = { text: string }

type Outer = { inner: Id }

let a = Id { index: 3 }
let b = Id { index: 3 }
let c = Id { index: 4 }
let n1 = Name { text: "ab" }
let n2 = Name { text: "a" + "b" }
let o1 = Outer { inner: a }
let o2 = Outer { inner: b }
let ids = [c, a]
let maybe: Id? = a
"${a == b} ${a != c} ${a == c} ${n1 == n2} ${o1 == o2} ${ids.contains(b)} ${ids.index_of(b)} ${maybe == b}"
