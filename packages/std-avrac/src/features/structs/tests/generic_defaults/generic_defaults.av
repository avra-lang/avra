// proves: a generic record's literal leaving out a field whose type names
// none of its type parameters calls that field's one default, whatever
// the record is applied to, and each literal gets a fresh cell.
type Bag<T> = { item: T, count: int = 2, label: string = "bag", seen: Cell<int> = Cell.new(0) }

fn made<T>(x: T) -> Bag<T> { Bag { item: x } }

let a = made(5)
let b: Bag<string> = Bag { item: "s", count: 7 }
b.seen.set(3)
"${a.item} ${a.count} ${a.label} ${b.item} ${b.count} ${b.label} ${b.seen.get()} ${a.seen.get()}"
