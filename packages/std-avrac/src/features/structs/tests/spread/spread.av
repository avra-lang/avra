// `..R` places a record's fields: nested, generic, into a component,
// its defaults typed where they were written.
type Look = { tone: string = "calm" }

type Common = { ..Look, style: string = "plain", pad: int = 0 }

type Page<T> = { items: List<T>, next: string? = null }

type Card = {
    ..Common,
    title: string,
}

type Orders = { ..Page<int>, total: int }

let c = Card { title: "hi", pad: 2 }
let o = Orders { items: [1, 2], total: 3 }
let d = c with { tone: "loud" }
"${c.tone} ${c.style} ${c.pad} ${c.title} | ${o.items.length} ${o.next ?? "none"} ${o.total} | ${d.tone}"
