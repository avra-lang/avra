// proves: a `state` field holds its value in a cell every copy of the record shares — a literal mints
// the cell, a default seeds it, a write through any copy lands where each reads it, a list held there
// grows in place — in both engines
type Counter = { name: string, state n: int = 0, state seen: List<string> = [] }

fn bumped(c: Counter) -> int {
    c.n = c.n + 1
    c.seen.push(c.name)
    c.n
}

let a = Counter { name: "a" }
let b = Counter { name: "b", n: 5 }
let c = a
let first = bumped(a)
let again = bumped(c)
"${first} ${again} ${a.n} ${c.n} ${bumped(b)} ${b.n} ${a.seen.length} ${b.seen.join(",")}"
