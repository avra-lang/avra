// proves: a generic record's literal writes its TYPE ARGUMENTS —
// `Box<float> { held: 1.25 }` pins the record's parameters from the
// written types, so seating `T` no longer needs an annotated `let`.
// A nested application closes on `>>`, and two parameters seat in
// order.
type Box<T> = { held: T }

type Pair<K, V> = { left: K, right: V }

let b = Box<float> { held: 1.25 }
let p = Pair<int, string> { left: 3, right: "hi" }
let nested = Box<Box<int>> { held: Box { held: 7 } }
let rows = Box<List<string>> { held: ["a", "b"] }

"${b.held} ${p.left} ${p.right} ${nested.held.held} ${rows.held[1]}"
