// proves: `.of` answers what a name stands over for every shape of
// record beneath it — flat (one field), value (scalars), boxed with a
// managed field, and nullable — and a name's value crosses a list, a
// match and an interpolation hole intact.
type Id = { n: int }
type Tag = Id
type Pt = { x: int, y: int }
type At = Pt
type Named = { name: string, rank: int }
type Who = Named

fn rank_of(w: Who) -> int { w.of.rank }

let t: Tag = Tag(Id { n: 7 })
let a: At = At(Pt { x: 3, y: 4 })
let w: Who = Who(Named { name: "ann", rank: 2 })
let ws = [w, Who(Named { name: "bo", rank: 5 })]
let maybe: Who? = w
let picked = match maybe {
    v? -> v.of.name
    null -> "none"
}

"${t.of.n} ${t.n} ${a.of.x + a.of.y} ${a.y} ${w.of.name} ${w.name} ${rank_of(ws[1])} ${ws[0].of.name} ${picked}"
