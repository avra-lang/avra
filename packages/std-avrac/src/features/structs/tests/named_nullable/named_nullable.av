// proves: a name over a nullable is as absent as its shape: `null` fills it, `??`, `!`, `?.`,
// `== null` and a presence match ask it, a present value of it is its shape's, and a scalar one
// travels as its shape's pair through a seat, a field, a list and a `mut`.
type Count = int?
type Name = string?
type Row = { n: Count, tag: Name }
fn pick(c: Count) -> int { c ?? 7 }
fn first(xs: List<Count>) -> int { xs[0] ?? -1 }
fn twice(c: Count?) -> int { if c == null { -2 } else { c ?? -3 } }
fn label(r: Row) -> string { "${r.n ?? 0}${r.tag ?? "-"}" }
fn shown(n: Name) -> string {
    match n {
        s? -> "<${s}>"
        null -> "<>"
    }
}
let a: Count = 3
let b: Count = null
mut c: Count = null
c = 4
let n: Name = "nm"
let len = n?.length ?? 0
let forced = a! + 1
"${pick(a)} ${pick(b)} ${first([b, a])} ${first([a])} ${twice(a)} ${twice(null)} ${label(Row { n: 5, tag: null })} ${label(Row { n: null, tag: "t" })} ${shown(n)} ${shown(null)} ${c ?? 0} ${len} ${forced} ${a == null} ${b == null}"
