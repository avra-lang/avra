// proves: a literal fills a named seat where arms meet and under a `?`: `??` over a named left
// side keeps the name, and a literal lifts into a nullable of a named type as its shape takes it.
type T = string
type N = int
fn pick(m: Map<string, T>, k: string) -> T { m.get(k) ?? "?" }
fn count(n: N?) -> N { n ?? 7 }
let m: Map<string, T> = {"k": "v"}
let none: N? = null
"${pick(m, "k")} ${pick(m, "z")} ${count(3)} ${count(none)}"
