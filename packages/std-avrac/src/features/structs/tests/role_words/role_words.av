// proves: a `Words` field an instance leaves out holds a closure saying its head's text again from the state as it stands; a head with no hole keeps the field's default
use @std.meta.{Words}

fn quiet() -> string { "(default)" }

component said(message: string) {
    words: Words = Words(quiet)
}

state n: int = 3

let held = said "n is ${n}"
let plain = said "no holes"
let before = (held.words)()
n = 4
"${held.message} / ${before} / ${(held.words)()} / ${(plain.words)()}"
