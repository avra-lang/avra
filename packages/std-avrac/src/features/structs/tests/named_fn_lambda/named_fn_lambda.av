// proves: a lambda written into a seat of a name over a fn type is typed by the shape the name
// stands over: its seats, their marks and its answer, a capture and a trailing seat alike.
type F = fn(int) -> int
type G = fn(mut List<int>) -> int
fn twice(f: F, v: int) -> int { f(f(v)) }
let f: F = (n) -> n * 2
let g: G = (xs) -> {
    xs.push(1)
    xs.length
}
mut ys = [0]
let k = 3
let h: F = (n) -> n + k
"${f(3)} ${twice(f, 1)} ${g(ys)} ${ys.length} ${twice(h, 1)} ${twice((n) -> n - 1, 5)}"
