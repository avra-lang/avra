// proves: a `Site` field a literal leaves out holds the literal's own site — the same each time it is built, told apart from a literal written elsewhere and from one written alike
use @std.meta.{Site}

type Spot = { name: string, site: Site }

fn spot(n: string) -> Spot { Spot { name: n } }

fn first() -> Spot { Spot { name: "b" } }

fn second() -> Spot { Spot { name: "b" } }

let a = spot("x")
let b = spot("y")
"${a.site == b.site} ${a.site == first().site} ${first().site == second().site} ${first().site} ${second().site}"
