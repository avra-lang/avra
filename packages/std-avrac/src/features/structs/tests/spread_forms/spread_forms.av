// proves: a record literal spreads a call's answer, a seat, and a whole record unchanged.
type P = { x: int, y: int, tag: string }
fn base() -> P { P { x: 1, y: 2, tag: "b" } }
fn moved(p: P, dx: int) -> P { P { ..p, x: p.x + dx } }
let a = P { ..base(), tag: "c" }
let b = moved(a, 10)
let c = P { ..b }
"${a.x} ${a.tag} ${b.x} ${b.y} ${c.tag}"
