// proves: `with` over a record answered by a call, and over a boxed field rebuilt by its own
// `with`.
type In = { xs: List<int>, n: int }
type Out = { inner: In, name: string }
fn renamed(o: Out, s: string) -> Out { o with { name: s } }
let o = Out { inner: In { xs: [1, 2], n: 3 }, name: "a" }
let p = renamed(o, "b") with { inner: o.inner with { n: 9 } }
"${p.name} ${p.inner.n} ${p.inner.xs.length} ${o.inner.n} ${o.name}"
