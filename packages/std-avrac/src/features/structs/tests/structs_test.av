// Structs, vertically: declaration, literals (any field order),
// field reads, fn boundaries, and every law refusing in its own
// words.
use @std.avrac.language.{analyze_source}

/// A program's printed value, or "<refused>".
fn shown(source: string) -> string {
    analyze_source(source).ran() ?? "<refused>"
}

spec "features/structs" {
    given "the record" {
        then "a literal's field reads back" {
            shown("type P = { x: int, y: int }\nlet p = P { x: 3, y: 4 }\np.x + p.y") == "7"
        }
        then "written order is free — slots follow the declaration" {
            shown("type P = { x: int, y: int }\nlet p = P { y: 4, x: 3 }\np.x") == "3"
        }
        then "a struct crosses a fn boundary, both ways" {
            shown("type P = { x: int, y: int }\nfn mk(n: int) -> P { P { x: n, y: 1 } }\nfn getx(p: P) -> int { p.x }\ngetx(mk(9))") == "9"
        }
        then "a bool field carries" {
            shown("type F = { on: bool }\nlet f = F { on: true }\nf.on") == "true"
        }
        then "fields ride interpolation" {
            let src = "type P = { x: int, y: int }\nlet p = P { x: 1, y: 2 }\n\"$" + "{p.x}-$" + "{p.y}\""
            shown(src) == "1-2"
        }
    }
    given "wrong shapes" {
        then "an unknown type refuses by name" {
            let a = analyze_source("let p = Q { x: 1 }\n2")
            a.report().contains("no `type Q` is declared")
        }
        then "a missing field refuses" {
            let a = analyze_source("type P = { x: int, y: int }\nlet p = P { x: 1 }\n2")
            a.diagnostics.length == 1 &&
                a.report().contains("`P` needs field `y`")
        }
        then "an unknown field names the real ones" {
            let a = analyze_source("type P = { x: int, y: int }\nlet p = P { x: 1, y: 2, z: 3 }\n2")
            a.diagnostics.length == 1 &&
                a.report().contains("`P` has no field `z`") &&
                a.report().contains("the fields are `x`, `y`")
        }
        then "a wrong-typed field refuses" {
            let a = analyze_source("type P = { x: int }\nlet p = P { x: true }\n2")
            a.diagnostics.length == 1 &&
                a.report().contains("field `x` is `int`, this is `bool`")
        }
        then "a repeated field refuses" {
            let a = analyze_source("type P = { x: int }\nlet p = P { x: 1, x: 2 }\n2")
            a.diagnostics.length == 1 &&
                a.report().contains("field `x` is written more than once")
        }
        then "a managed field waits for ownership" {
            let a = analyze_source("type P = { name: string }\nlet p = P { name: \"hi\" }\n2")
            a.diagnostics.length == 1 &&
                a.report().contains("struct fields hold scalars for now")
        }
        then "a duplicate declaration refuses" {
            let a = analyze_source("type P = { x: int }\ntype P = { y: int }\n3")
            a.diagnostics.length == 1 &&
                a.report().contains("`P` is declared more than once")
        }
        then "a field read off a non-struct still refuses" {
            let a = analyze_source("let n = 3\nn.x")
            a.diagnostics.length == 1 &&
                a.report().contains("no property `x` on `int`")
        }
        then "a field miss on a struct names the fields" {
            let a = analyze_source("type P = { x: int }\nlet p = P { x: 1 }\np.z")
            a.diagnostics.length == 1 &&
                a.report().contains("no field `z` on `P`")
        }
    }
    given "the condition ambiguity" {
        then "`if x { ... }` stays a condition, not a literal" {
            shown("let x = true\nif x { 1 } else { 2 }") == "1"
        }
    }
}
