// The RED TEAM's permanent record for records (see
// .claude/skills/red-team). Every program here was written to break
// the feature, not to use it.
use @std.avrac.compiler.{analyze_source}
use @std.avrac.testing.{shown, refusals, refused_with}

/// THE subject under attack: the smallest record there is.
fn p1() -> string {
    "type P = { x: int }\n"
}

/// That record, built and bound to `a`.
fn p1_bound() -> string {
    "type P = { x: int }\nlet a = P { x: 1 }\n"
}

spec "features/structs (adversarial)" {
    given "the slot law vs the name law" {
        then "an unknown FIELD type names the NAME, not the slot law" {
            let a = analyze_source("type P = { x: Foo }\nlet q = P { x: 1 }\nq.x")
            a.diagnostics.length == 1 && a.report().contains("`Foo` names no type")
        }
    }
    given "operators against a record VALUE" {
        // FOUND BY RED-TEAMING enums, and it was a RECORD bug too:
        // `==` typed clean on two records, then the interpreter
        // refused with an internal defect while the backend quietly
        // answered `false` for two IDENTICAL records — an engine
        // divergence and a silently wrong native answer.
        then "a record of two fields refuses equality, and says to compare a field" {
            let a = analyze_source(
                "type Q = { x: int, y: int }\nlet a = Q { x: 1, y: 2 }\nlet b = Q { x: 1, y: 2 }\na == b",
            )
            a.diagnostics.length == 1 &&
                a
                    .report()
                    .contains(
                        "`==` compares by value — a scalar, text, a tagged enum, or a record of one such field",
                    ) &&
                a.report().contains("compare a field instead")
        }
        then "inequality over two fields refuses the same way" {
            refusals("type Q = { x: int, y: int }\nlet a = Q { x: 1, y: 2 }\na != a") == 1
        }
        then "a record of ONE field compares by it" {
            shown("${p1_bound()}let b = P { x: 1 }\nlet c = P { x: 2 }\n\"\${a == b} \${a != c}\"") == "true true"
        }
        then "a record of one field whose field does not compare refuses" {
            refusals("type L = { xs: List<int> }\nL { xs: [1] } == L { xs: [1] }") == 1
        }
        then "two different one-field types are two types" {
            refused_with(
                "type A = { n: int }\ntype B = { n: int }\nA { n: 1 } == B { n: 1 }",
                "`==` compares matching types, found `A` and `B`",
            )
        }
        then "a one-field record against its own field's scalar is two types" {
            refused_with("${p1_bound()}a == 1", "`==` compares matching types, found `P` and `int`")
        }
        then "arithmetic on a record refuses" {
            refused_with("${p1_bound()}a + 1", "`+` needs `int` operands, found `P`")
        }
        then "indexing a record refuses" {
            refusals("${p1_bound()}a[0]") == 1
        }
        then "matching over a record refuses" {
            refusals("${p1_bound()}match a {\n    .x -> 1\n}") == 1
        }
    }
    given "degenerate shapes" {
        then "a one-field record round-trips" {
            shown("${p1()}let p = P { x: 9 }\np.x") == "9"
        }
        then "a record with no fields declares and constructs" {
            shown("type P = { }\nlet p = P { }\n1") == "1"
        }
        then "a field named like its type still reads" {
            shown("type P = { P: int }\nlet p = P { P: 4 }\np.P") == "4"
        }
    }
    given "crossing other features" {
        then "a record survives a fn boundary both ways" {
            shown(
                "${p1()}fn mk(n: int) -> P { P { x: n } }\nfn get(p: P) -> int { p.x }\nget(mk(6))",
            ) == "6"
        }
        then "a record built inside a loop reads back" {
            shown("${p1()}mut t = 0\nfor i in 0..3 {\n    t = t + P { x: 2 }.x\n}\nt") == "6"
        }
        then "a copy of a copy keeps the untouched fields" {
            shown(
                "type P = { x: int, y: int }\nlet p = P { x: 1, y: 2 }\nlet q = (p with { x: 5 }) with { y: 6 }\nq.x + q.y",
            ) == "11"
        }
        then "a record declared inside a block refuses AT the declaration" {
            let a = analyze_source("fn f() -> int {\n    ${p1()}    1\n}\nf()")
            a.diagnostics.length == 1 &&
                a.report().contains("type declarations live at the top level")
        }
        then "a record in an interpolation hole refuses" {
            let src = "${p1()}let p = P { x: 1 }\n\"v=\${p}\""
            refused_with(src, "an interpolation hole prints as a scalar or string, found `P`")
        }
    }
    given "a field written twice is one mistake" {
        then "a repeat whose value needs the field's enum speaks once" {
            refused_with(
                "enum Tone { Muted, Danger }\ntype T = { tone: Tone }\nlet t = T { tone: .Muted, tone: .Danger }\n0",
                "field `tone` is written more than once",
            )
        }
        then "a third write adds no voice" {
            refused_with(
                "enum Tone { Muted, Danger, Text }\ntype T = { tone: Tone }\nlet t = T { tone: .Muted, tone: .Danger, tone: .Text }\n0",
                "field `tone` is written more than once",
            )
        }
        then "a repeat's value is not judged against the field" {
            refused_with(
                "type P = { x: int }\nlet p = P { x: 1, x: true }\n0",
                "field `x` is written more than once",
            )
        }
        then "each repeated field speaks for itself" {
            refusals(
                "enum Tone { Muted, Danger }\ntype T = { tone: Tone, n: int }\nlet t = T { tone: .Muted, tone: .Danger, n: 1, n: 2 }\n0",
            ) == 2
        }
        then "a repeat through `with` speaks once" {
            refused_with(
                "enum Tone { Muted, Danger }\ntype T = { tone: Tone }\nlet t = T { tone: .Muted }\nlet u = t with { tone: .Muted, tone: .Danger }\n0",
                "field `tone` is written more than once",
            )
        }
        then "an unknown field's value is not asked for its enum" {
            refused_with(
                "enum Tone { Muted, Danger }\ntype T = { tone: Tone }\nlet t = T { tone: .Muted, hue: .Danger }\n0",
                "`T` has no field `hue`",
            )
        }
        then "nothing nested in a repeat's value speaks" {
            refused_with(
                "enum Tone { Muted, Danger }\ntype T = { tone: Tone }\nlet t = T { tone: .Muted, tone: if true { .Danger } else { .Muted } }\n0",
                "field `tone` is written more than once",
            )
        }
        then "a generic record's repeat speaks once" {
            refused_with(
                "enum Tone { Muted, Danger }\ntype B<X> = { v: X, n: int }\nlet b = B { v: 1, n: 1, n: .Danger }\n0",
                "field `n` is written more than once",
            )
        }
        then "a repeat in a fn's answer speaks once" {
            refused_with(
                "enum Tone { Muted, Danger }\ntype T = { tone: Tone }\nfn f() -> T { T { tone: .Muted, tone: .Danger } }\n0",
                "field `tone` is written more than once",
            )
        }
    }
    given "the field carrier — a field's own record" {
        then "field order is the declaration's, defaults riding their own field" {
            shown(
                "type Q = { a: int = 1, b: int, c: int = 3 }\nlet q = Q { b: 2 }\nq.a * 100 + q.b * 10 + q.c",
            ) == "123"
        }
        then "a record spread lands after the fields written before it" {
            shown(
                "type A = { x: int, y: int }\ntype B = { p: int, ..A, q: int }\nlet b = B { p: 1, x: 2, y: 3, q: 4 }\nb.p * 1000 + b.x * 100 + b.y * 10 + b.q",
            ) == "1234"
        }
        then "a leading record spread places its fields first" {
            shown(
                "type A = { x: int }\ntype B = { ..A, q: int }\nlet b = B { x: 5, q: 6 }\nb.x * 10 + b.q",
            ) == "56"
        }
        then "a record of only a spread declares" {
            shown("type A = { x: int }\ntype B = { ..A }\nB { x: 8 }.x") == "8"
        }
        then "a trailing comma after the last field parses" {
            shown("type Q = { a: int, b: int, }\nlet q = Q { a: 1, b: 2 }\nq.a + q.b") == "3"
        }
        then "line-separated fields parse beside comma-separated ones" {
            shown(
                "type Q = {\n    a: int, b: int\n    c: int\n}\nlet q = Q { a: 1, b: 2, c: 3 }\nq.c",
            ) == "3"
        }
        then "a state field keeps its place among plain ones" {
            shown(
                "type Q = {\n    a: int = 1\n    state n: int = 2\n    c: int = 3\n}\nlet q = Q { }\nq.n = 5\nq.a + q.n * 10 + q.c * 100",
            ) == "351"
        }
        then "a field naming no type refuses" {
            refusals("type Q = { a: }\n1") == 1
        }
        then "a field with no colon refuses" {
            refusals("type Q = { a int }\n1") == 1
        }
        then "a three-dot spread says the two-dot spelling" {
            refused_with("type A = { x: int }\ntype B = { ...A }\n1", "a spread is written `..R`")
        }
        then "a `state` mark after the name refuses" {
            refusals("type Q = { a state: int }\n1") == 1
        }
    }
    given "a default is a body of its own" {
        then "it cannot read the top level's run-time bindings — one refusal, the floor's" {
            refused_with(
                "let k = 3\ntype Q = { y: int = k }\nQ {}.y",
                "`k` is a run-time binding of the top level",
            )
        }
        then "a top-level `mut` is hidden the same way" {
            refused_with(
                "mut k = 3\ntype Q = { y: int = k }\nQ {}.y",
                "`k` is a run-time binding of the top level",
            )
        }
        then "it may call a fn, and a fn value, declared anywhere in the file" {
            shown(
                "type Q = { y: int = twice(4), f: fn(int) -> int = twice }\nfn twice(n: int) -> int {\n    n * 2\n}\nlet q = Q {}\nq.y + q.f(1)",
            ) == "10"
        }
        then "a method reached only through a default lowers — the program reaches it" {
            shown(
                "type P = { x: int }\nimpl P {\n    fn m() -> int {\n        self.x * 2\n    }\n}\ntype Q = { v: int = P { x: 4 }.m() }\nQ {}.v",
            ) == "8"
        }
        then "every literal calls the one body — a managed default is fresh per instance" {
            shown(
                "type Q = { tags: List<string> = [] }\nmut a = Q {}\nlet b = Q {}\na.tags.push(\"x\")\na.tags.length * 10 + b.tags.length",
            ) == "10"
        }
    }
}
