//! The literal's typing law: the name resolved to a declaration
//! (resolve spoke otherwise), and the written fields match it —
//! each declared field exactly once, each value the field's type.
use core.{ExprId, StmtId, Type, TypeId, StructParts, DeclId}
use features.{no_pins, Pins, TypeCx, StructSig, spoken, this_is, fields_are, repeated_at, accepts, slot_worthy, tparams_refused, unpinned_of, bound_closed, slice_promise, pinned_by_want, hungry, agreed}
use diagnostics.{refusal}

fn structs_type(mut cx: TypeCx, e: ExprId) -> TypeId {
    // LICENSED I22: a feature cannot enumerate OTHER features' variants
    match cx.view.store.expr(e) {
        .StructLit(name, fields, values) -> lit_type(cx, e, name, fields, values),
        .With(subject, fields, values) -> with_type(cx, e, subject, fields, values),
        _ -> cx.error_type,
    }
}

/// `with` copies a STRUCT: the written fields obey the field law,
/// and the answer IS the subject's type.
fn with_type(mut cx: TypeCx, e: ExprId, subject: ExprId, fields: List<string>, values: List<ExprId>) -> TypeId {
    let ty = cx.type_at(subject)
    if cx.errored_ty(ty) { return cx.error_type }
    let sig: StructSig? = cx.fields_of(ty)
    if sig == null {
        let n = cx.name_at(subject)
        return spoken(cx, refusal("type.with_struct", cx.loc_of(e), "`with` copies a struct, found `${n}`", this_is(n), null))
    }
    written_checks(cx, cx.view.types.name_of(ty), fields, values, sig!)
    ty
}

fn lit_type(mut cx: TypeCx, e: ExprId, name: string, fields: List<string>, values: List<ExprId>) -> TypeId {
    let decl: DeclId? = cx.bound_decl(e)
    if decl == null { return cx.error_type }
    let target = decl!
    let ty = cx.view.types.intern(Type.Struct(target, name))
    let sig: StructSig? = cx.fields_of(ty)
    if sig == null { return not_a_record(cx, e, name) }
    if !cx.tparams(target).is_empty() {
        return generic_lit(cx, e, name, fields, values, target, sig!)
    }
    check_fields(cx, e, name, fields, values, sig!)
    ty
}

/// A GENERIC record's literal INSTANTIATES: the declared field
/// types unify against the written values — the call-site law,
/// field-worded — every Var must land, and the slots re-judge
/// under the bindings before the instantiation interns.
fn generic_lit(mut cx: TypeCx, e: ExprId, name: string, fields: List<string>,
               values: List<ExprId>, decl: DeclId, sig: StructSig) -> TypeId {
    let tp = cx.tparams(decl)
    if tparams_refused(tp) { return cx.error_type }
    mut bound = no_pins(tp.length)
    mut spoke = false
    for j, f in fields {
        if !generic_field(cx, name, sig, f, values[j], repeated_at(fields, j), decl, bound) {
            spoke = true
        }
    }
    for j, n in sig.names {
        if !fields.contains(n) && sig.defaults[j] == null {
            missing_field(cx, e, name, n)
            spoke = true
        }
    }
    if spoke { return cx.error_type }
    let pinned = pinned_by_want(cx, e, decl, bound)
    let missing: string? = unpinned_of(tp, pinned)
    if missing != null { return if cx.starving { unpinned_by_fields(cx, e, missing!) } else { hungry(cx, e) } }
    let concrete = bound_closed(cx, pinned)
    for ft in sig.types {
        let landed = cx.view.types.substituted(ft, decl, concrete)
        if !slot_worthy(cx.view.types, cx.view.types.shape_of(landed)) {
            return spoken(cx, refusal("type.struct_fields", cx.loc_of(e), "this literal makes a slot `${cx.view.types.name_of(landed)}`, which a slot cannot hold yet", "in this literal", slice_promise("slots")))
        }
    }
    cx.record_subst(e, decl, concrete)
    cx.view.types.intern(Type.App(decl, name, concrete))
}

/// One written field of a generic literal: declared, written once,
/// and its declared type UNIFIES with the value — a fully-bound
/// field falls back to the ordinary law, so widening still rides.
fn generic_field(mut cx: TypeCx, name: string, sig: StructSig, f: string, v: ExprId,
                 dup: bool, decl: DeclId, mut bound: Pins) -> bool {
    let slot: int? = sig.slot_of(f)
    if slot == null {
        unknown_field(cx, v, name, f, sig)
        return false
    }
    if dup {
        repeated_field(cx, v, f)
        return false
    }
    let want = sig.types[slot!]
    if agreed(cx, v, want, decl, bound) { return true }
    let n = cx.name_at(v)
    let _ = spoken(cx, refusal("type.struct_fields", cx.loc_of(v), "field `${f}` is `${cx.view.types.name_of(want)}`, this is `${n}`", this_is(n), null))
    false
}

/// Every written field checks against the table; every declared
/// field must ALSO be written — the literal's completeness half.
fn check_fields(mut cx: TypeCx, e: ExprId, name: string, fields: List<string>, values: List<ExprId>, sig: StructSig) {
    written_checks(cx, name, fields, values, sig)
    for j, n in sig.names {
        if !fields.contains(n) && sig.defaults[j] == null { missing_field(cx, e, name, n) }
    }
}

/// The written-field half of the law, shared by literal and
/// `with`. A dup is a name whose FIRST position is earlier.
fn written_checks(mut cx: TypeCx, name: string, fields: List<string>, values: List<ExprId>, sig: StructSig) {
    for j, f in fields {
        field_check(cx, name, sig, f, values[j], repeated_at(fields, j))
    }
}

/// One written field's law: declared, written once, right type.
fn field_check(mut cx: TypeCx, name: string, sig: StructSig, f: string, v: ExprId, dup: bool) {
    let slot: int? = sig.slot_of(f)
    if slot == null {
        unknown_field(cx, v, name, f, sig)
        return
    }
    if dup {
        repeated_field(cx, v, f)
        return
    }
    // the ONE assignment door — a field slot lifts like any other
    // (auto-Ok, dyn boxing), and the lift is recorded for lowering
    if !accepts(cx, v, sig.types[slot!]) {
        let n = cx.name_at(v)
        cx.emit(refusal("type.struct_fields", cx.loc_of(v), "field `${f}` is `${cx.view.types.name_of(sig.types[slot!])}`, this is `${n}`", this_is(n), null))
    }
}

// ── The field-law voices, worded once for both paths ──

fn missing_field(mut cx: TypeCx, e: ExprId, name: string, n: string) {
    cx.emit(refusal("type.struct_fields", cx.loc_of(e), "`${name}` needs field `${n}`", "this literal", "every declared field appears exactly once"))
}

fn unknown_field(mut cx: TypeCx, v: ExprId, name: string, f: string, sig: StructSig) {
    cx.emit(refusal("type.struct_fields", cx.loc_of(v), "`${name}` has no field `${f}`", "written here", fields_are(sig)))
}

fn repeated_field(mut cx: TypeCx, v: ExprId, f: string) {
    cx.emit(refusal("type.struct_fields", cx.loc_of(v), "field `${f}` is written more than once", "written again here", null))
}

fn unpinned_by_fields(mut cx: TypeCx, e: ExprId, tparam: string) -> TypeId {
    spoken(cx, refusal("type.struct_fields", cx.loc_of(e), "`${tparam}` is not pinned by the fields", "in this literal", "give `${tparam}`'s field a value of a concrete type"))
}

/// A literal under a name that declares no fields — an enum's.
fn not_a_record(mut cx: TypeCx, e: ExprId, name: string) -> TypeId {
    spoken(cx, refusal("type.struct_fields", cx.loc_of(e), "`${name}` is an enum, not a record — it has no fields to fill", "built here", "construct a variant instead — `${name}.<variant>`"))
}

/// THE DEFAULT LAW, at the declaration: a field's default (walked
/// under the field's want) is accepted by the field — every literal
/// that omits the field then calls it without judging it again.
export fn fits_default(mut cx: TypeCx, d: ExprId, name: string, want: TypeId) {
    if accepts(cx, d, want) { return }
    let n = cx.name_at(d)
    cx.emit(refusal("type.struct_fields", cx.loc_of(d), "field `${name}` defaults to `${n}`, and it is `${cx.view.types.name_of(want)}`", this_is(n), null))
}
