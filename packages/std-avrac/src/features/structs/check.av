//! The literal's typing law: the name resolved to a declaration
//! (resolve spoke otherwise), and the written fields match it —
//! each declared field exactly once, each value the field's type.
use core.{ExprId, StmtId, Type, TypeId, filled}
use features.{TypeCx, StructSig, spoken, types_disagree, this_is, fields_are,
              unify, fully_bound, bound_args, accepts, slot_worthy, tparams_refused, unpinned_of, bound_closed}
use diagnostics.{error_at, pointed}

fn structs_type(cx: TypeCx, e: ExprId) -> TypeId {
    // LICENSED I22: a feature cannot enumerate OTHER features' variants (the isolation doctrine); its own are listed
    match cx.store.expr(e) {
        .StructLit(name, fields, values) -> lit_type(cx, e, name, fields, values),
        .With(subject, fields, values) -> with_type(cx, e, subject, fields, values),
        _ -> cx.error_type,
    }
}

/// `with` copies a STRUCT: the written fields obey the field law,
/// and the answer IS the subject's type.
fn with_type(cx: TypeCx, e: ExprId, subject: ExprId, fields: List<string>, values: List<ExprId>) -> TypeId {
    let ty = cx.type_at(subject)
    if cx.types.shape_of(ty) is .Error { return cx.error_type }
    let sig: StructSig? = cx.fields_of(ty)
    if sig == null {
        let n = cx.name_at(subject)
        return spoken(cx, pointed(
            error_at("type.with_struct", cx.loc_of(e), "`with` copies a struct, found `${n}`"),
            this_is(n)))
    }
    written_checks(cx, cx.types.name_of(ty), fields, values, sig!)
    ty
}

fn lit_type(cx: TypeCx, e: ExprId, name: string, fields: List<string>, values: List<ExprId>) -> TypeId {
    let decl: StmtId? = cx.bound_def(e)
    if decl == null { return cx.error_type }
    let target = decl!
    let ty = cx.types.intern(Type.Struct(target, name))
    let sig: StructSig? = cx.fields_of(ty)
    if sig == null { return cx.error_type }
    if !cx.store.decl_tparams(target).is_empty() {
        return generic_lit(cx, e, name, fields, values, target, sig!)
    }
    check_fields(cx, e, name, fields, values, sig!)
    ty
}

/// A GENERIC record's literal INSTANTIATES: the declared field
/// types unify against the written values — the call-site law,
/// field-worded — every Var must land, and the slots re-judge
/// under the bindings before the instantiation interns.
fn generic_lit(cx: TypeCx, e: ExprId, name: string, fields: List<string>,
               values: List<ExprId>, decl: StmtId, sig: StructSig) -> TypeId {
    let tp = cx.store.decl_tparams(decl)
    if tparams_refused(tp) { return cx.error_type }
    let bound: List<TypeId?> = filled<TypeId?>(tp.length, null)
    mut spoke = false
    // LICENSED I3: a ZIP of parallel captures; comprehensions cannot destructure enumerate
    for (j, f) in fields.enumerate() {
        if !generic_field(cx, name, sig, f, values[j], fields.index_of(f) < j, decl, bound) {
            spoke = true
        }
    }
    for n in sig.names {
        if !fields.contains(n) {
            missing_field(cx, e, name, n)
            spoke = true
        }
    }
    if spoke { return cx.error_type }
    let missing: string? = unpinned_of(tp, bound)
    if missing != null { return unpinned_by_fields(cx, e, missing!) }
    let concrete = bound_closed(cx, bound)
    for ft in sig.types {
        let landed = cx.types.substituted(ft, decl, concrete)
        if !slot_worthy(cx.types.shape_of(landed)) {
            return spoken(cx, pointed(
                error_at("type.struct_fields", cx.loc_of(e),
                    "this literal makes a slot `${cx.types.name_of(landed)}`, which a slot cannot hold yet"),
                "in this literal")
                with { help: "nullable slots arrive with ownership's next slice" })
        }
    }
    cx.record_subst(e, decl, concrete)
    cx.types.intern(Type.App(decl, name, concrete))
}

/// One written field of a generic literal: declared, written once,
/// and its declared type UNIFIES with the value — a fully-bound
/// field falls back to the ordinary law, so widening still rides.
fn generic_field(cx: TypeCx, name: string, sig: StructSig, f: string, v: ExprId,
                 dup: bool, decl: StmtId, bound: List<TypeId?>) -> bool {
    let slot: int? = sig.slot_of(f)
    if slot == null {
        unknown_field(cx, v, name, f, sig)
        return false
    }
    if dup {
        repeated_field(cx, v, f)
        return false
    }
    let want = sig.types[slot!]
    if unify(cx, want, cx.type_at(v), decl, bound) { return true }
    if fully_bound(cx, want, decl, bound) {
        let landed = cx.types.substituted(want, decl, bound_args(cx, bound))
        if accepts(cx, v, landed) { return true }
    }
    let n = cx.name_at(v)
    let _ = spoken(cx, pointed(
        error_at("type.struct_fields", cx.loc_of(v),
            "field `${f}` is `${cx.types.name_of(want)}`, this is `${n}`"),
        this_is(n)))
    false
}

/// Every written field checks against the table; every declared
/// field must ALSO be written — the literal's completeness half.
fn check_fields(cx: TypeCx, e: ExprId, name: string, fields: List<string>, values: List<ExprId>, sig: StructSig) {
    written_checks(cx, name, fields, values, sig)
    for n in sig.names {
        if !fields.contains(n) { missing_field(cx, e, name, n) }
    }
}

/// The written-field half of the law, shared by literal and
/// `with`. A dup is a name whose FIRST position is earlier.
fn written_checks(cx: TypeCx, name: string, fields: List<string>, values: List<ExprId>, sig: StructSig) {
    for (j, f) in fields.enumerate() {
        field_check(cx, name, sig, f, values[j], fields.index_of(f) < j)
    }
}

/// One written field's law: declared, written once, right type.
fn field_check(cx: TypeCx, name: string, sig: StructSig, f: string, v: ExprId, dup: bool) {
    let slot: int? = sig.slot_of(f)
    if slot == null {
        unknown_field(cx, v, name, f, sig)
        return
    }
    if dup {
        repeated_field(cx, v, f)
        return
    }
    // the ONE assignment door — a field slot lifts like any other
    // (auto-Ok, dyn boxing), and the lift is recorded for lowering
    if !accepts(cx, v, sig.types[slot!]) {
        let n = cx.name_at(v)
        cx.emit(pointed(
            error_at("type.struct_fields", cx.loc_of(v),
                "field `${f}` is `${cx.types.name_of(sig.types[slot!])}`, this is `${n}`"),
            this_is(n)))
    }
}

// ── The field-law voices, worded once for both paths ──

fn missing_field(cx: TypeCx, e: ExprId, name: string, n: string) {
    cx.emit(pointed(
        error_at("type.struct_fields", cx.loc_of(e), "`${name}` needs field `${n}`"),
        "this literal")
        with { help: "every declared field appears exactly once" })
}

fn unknown_field(cx: TypeCx, v: ExprId, name: string, f: string, sig: StructSig) {
    cx.emit(pointed(
        error_at("type.struct_fields", cx.loc_of(v), "`${name}` has no field `${f}`"),
        "written here")
        with { help: fields_are(sig) })
}

fn repeated_field(cx: TypeCx, v: ExprId, f: string) {
    cx.emit(pointed(
        error_at("type.struct_fields", cx.loc_of(v), "field `${f}` is written more than once"),
        "written again here"))
}

fn unpinned_by_fields(cx: TypeCx, e: ExprId, tparam: string) -> TypeId {
    spoken(cx, pointed(
        error_at("type.struct_fields", cx.loc_of(e), "`${tparam}` is not pinned by the fields"),
        "in this literal")
        with { help: "give `${tparam}`'s field a value of a concrete type" })
}
