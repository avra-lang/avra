//! The literal's typing law: the name resolved to a declaration
//! (resolve spoke otherwise), and the written fields match it —
//! each declared field exactly once, each value the field's type.
use core.{ExprId, Type, TypeId, DeclId}
use features.{
    no_pins,
    Pins,
    TypeCx,
    StructSig,
    this_is,
    fields_are,
    lacks_voice,
    slot_worthy,
    slot_want,
    tparams_refused,
    unpinned_of,
}
use diagnostics.{refusal}

fn structs_type(mut cx: TypeCx, e: ExprId) -> TypeId {
    // a feature cannot enumerate OTHER features' variants
    match cx.view.store.expr(e) {
        .StructLit(name, fields, values) -> lit_type(cx, e, name.of, [t.of for t in fields], values),
        .With(subject, fields, values) -> with_type(cx, e, subject, [t.of for t in fields], values),
        rest -> cx.error_type,
    }
}

/// `with` copies a STRUCT: the written fields obey the field law,
/// and the answer IS the subject's type.
fn with_type(mut cx: TypeCx, e: ExprId, subject: ExprId, fields: List<string>, values: List<ExprId>) -> TypeId {
    let ty = cx.type_at(subject)
    if cx.errored_ty(ty) { return cx.error_type }
    let sig? = cx.fields_of(ty) else { return not_a_struct(cx, e, subject) }
    let _ = cx.seals(cx.loc_of(e), ty, "copied with new fields here")
    written_checks(cx, cx.view.types.name_of(ty), fields, values, sig)
    ty
}

fn lit_type(mut cx: TypeCx, e: ExprId, name: string, fields: List<string>, values: List<ExprId>) -> TypeId {
    cx.warn_use(e)
    let bound? = cx.bound_decl(e) else { return cx.error_type }
    let target? = cx.view.decls.named_by(bound) else { return fieldless_alias(cx, e, name, bound) }
    let ty = cx.view.types.intern(Type.Struct(target, cx.view.decls.decl(target).name))
    let sig? = cx.fields_of(ty) else { return not_a_record(cx, e, name) }
    let _ = cx.seals(cx.loc_of(e), ty, "built here")
    if !cx.tparams(target).is_empty() {
        return generic_lit(cx, e, name, fields, values, target, sig)
    }
    check_fields(cx, e, name, fields, values, sig)
    ty
}

/// A GENERIC record's literal INSTANTIATES: the declared field
/// types unify against the written values — the call-site law,
/// field-worded — every Var must land, and the slots re-judge
/// under the bindings before the instantiation interns.
fn generic_lit(
    mut cx: TypeCx,
    e: ExprId,
    name: string,
    fields: List<string>,
    values: List<ExprId>,
    decl: DeclId,
    sig: StructSig,
) -> TypeId {
    let tp = cx.tparams(decl)
    if tparams_refused(tp) { return cx.error_type }
    mut bound = no_pins(tp.length)
    mut spoke = false
    for j, f in fields {
        if !generic_field(cx, name, sig, f, values[j], written_at(fields, j), decl, bound) {
            spoke = true
        }
    }
    if missing_fields(cx, e, name, fields, sig) || spoke { return cx.error_type }
    let pinned = cx.pinned_by_want(e, decl, bound)
    let missing: string? = unpinned_of(tp, pinned)
    if missing != null { return if cx.starving { unpinned_by_fields(cx, e, missing!) } else { cx.hungry(e) } }
    let concrete = cx.bound_closed(pinned)
    for ft in sig.types {
        let landed = cx.view.types.substituted(ft, decl, concrete)
        if !slot_worthy(cx.view.types.shape_of(landed)) { return unslottable_literal(cx, e, landed) }
    }
    cx.record_subst(e, decl, concrete, [])
    cx.view.types.intern(Type.App(decl, name, concrete))
}

/// One written field of a generic literal: declared, written once,
/// and its declared type UNIFIES with the value — a fully-bound
/// field falls back to the ordinary law, so widening still rides.
fn generic_field(
    mut cx: TypeCx,
    name: string,
    sig: StructSig,
    f: string,
    v: ExprId,
    w: Written,
    decl: DeclId,
    mut bound: Pins,
) -> bool {
    let slot? = field_slot(cx, name, sig, f, v, w) else { return false }
    let want = slot_want(cx.view.types, sig, slot)
    if cx.agreed(v, want, decl, bound) { return true }
    wrong_field_type(cx, v, f, want)
    false
}

/// How often a written field's name stood before it.
enum Written { Once, Twice, Again }

fn written_at(fields: List<string>, j: int) -> Written {
    match [i for i in 0..j if fields[i] == fields[j]].length {
        0 -> .Once,
        1 -> .Twice,
        _ -> .Again,
    }
}

/// The field's slot, once the name is declared and written once —
/// the half of the field law both paths share. A refused write's
/// value is settled unjudged, and a field written twice speaks once
/// however often it repeats: one mistake, one voice.
fn field_slot(mut cx: TypeCx, name: string, sig: StructSig, f: string, v: ExprId, w: Written) -> int? {
    let slot? = sig.slot_of(f) else {
        cx.settled_value(v)
        let why? = sig.lacked(f) else {
            unknown_field(cx, v, name, f, sig)
            return null
        }
        lacked_field(cx, v, name, f, sig, why)
        return null
    }
    match w {
        .Once -> slot,
        .Twice -> {
            cx.settled_value(v)
            repeated_field(cx, v, f)
            null
        },
        .Again -> {
            cx.settled_value(v)
            null
        },
    }
}

/// Every declared field without a default is written — the
/// literal's completeness half. True when one spoke.
fn missing_fields(mut cx: TypeCx, e: ExprId, name: string, fields: List<string>, sig: StructSig) -> bool {
    mut spoke = false
    for j, n in sig.names {
        if !fields.contains(n) && sig.defaults[j] == null && !cx.view.decls.sited_slot(sig, j) {
            missing_field(cx, e, name, n)
            spoke = true
        }
    }
    spoke
}

/// Every written field checks against the table; every declared
/// field must ALSO be written — the literal's completeness half.
fn check_fields(
    mut cx: TypeCx,
    e: ExprId,
    name: string,
    fields: List<string>,
    values: List<ExprId>,
    sig: StructSig,
) {
    written_checks(cx, name, fields, values, sig)
    let _ = missing_fields(cx, e, name, fields, sig)
}

/// The written-field half of the law, shared by literal and
/// `with`.
fn written_checks(
    mut cx: TypeCx,
    name: string,
    fields: List<string>,
    values: List<ExprId>,
    sig: StructSig,
) {
    for j, f in fields {
        field_check(cx, name, sig, f, values[j], written_at(fields, j))
    }
}

/// One written field's law: declared, written once, right type.
fn field_check(mut cx: TypeCx, name: string, sig: StructSig, f: string, v: ExprId, w: Written) {
    if cx.view.store.refused_elsewhere(v) {
        let _ = cx.type_at(v)
        return
    }
    let slot: int? = field_slot(cx, name, sig, f, v, w)
    if slot == null { return }
    // the ONE assignment door — a field slot lifts like any other
    // (auto-Ok, dyn boxing), and the lift is recorded for lowering
    let want = slot_want(cx.view.types, sig, slot!)
    if !cx.accepts(v, want) { wrong_field_type(cx, v, f, want) }
}

// ── The field-law voices, worded once for both paths ──

fn missing_field(mut cx: TypeCx, e: ExprId, name: string, n: string) {
    cx
        .emit(
            refusal(
                "type.struct_fields",
                cx.loc_of(e),
                "`${name}` needs field `${n}`",
                "this literal",
                "every declared field appears exactly once",
            ),
        )
}

fn unknown_field(mut cx: TypeCx, v: ExprId, name: string, f: string, sig: StructSig) {
    cx
        .emit(
            refusal(
                "type.struct_fields",
                cx.loc_of(v),
                "`${name}` has no field `${f}`",
                "written here",
                fields_are(sig),
            ),
        )
}

fn lacked_field(mut cx: TypeCx, v: ExprId, name: string, f: string, sig: StructSig, why: string) {
    cx
        .emit(
            refusal(
                "type.struct_fields",
                cx.loc_of(v),
                lacks_voice(name, f, why),
                "written here",
                fields_are(sig),
            ),
        )
}

fn wrong_field_type(mut cx: TypeCx, v: ExprId, f: string, want: TypeId) {
    let n = cx.name_at(v)
    cx
        .emit(
            cx
                .named_fix(
                    refusal(
                        "type.struct_fields",
                        cx.loc_of(v),
                        "field `${f}` is `${cx.view.types.name_of(want)}`, this is `${n}`",
                        this_is(n),
                        null,
                    ),
                    want,
                    v,
                ),
        )
}

fn not_a_struct(mut cx: TypeCx, e: ExprId, subject: ExprId) -> TypeId {
    let n = cx.name_at(subject)
    cx
        .spoken(
            refusal(
                "type.with_struct",
                cx.loc_of(e),
                "`with` copies a struct, found `${n}`",
                this_is(n),
                null,
            ),
        )
}

fn unslottable_literal(mut cx: TypeCx, e: ExprId, landed: TypeId) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.struct_fields",
                cx.loc_of(e),
                "this literal makes a slot `${cx.view.types.name_of(landed)}`, which is no value",
                "in this literal",
                null,
            ),
        )
}

fn repeated_field(mut cx: TypeCx, v: ExprId, f: string) {
    cx
        .emit(
            refusal(
                "type.struct_fields",
                cx.loc_of(v),
                "field `${f}` is written more than once",
                "written again here",
                null,
            ),
        )
}

fn unpinned_by_fields(mut cx: TypeCx, e: ExprId, tparam: string) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.struct_fields",
                cx.loc_of(e),
                "`${tparam}` is not pinned by the fields",
                "in this literal",
                "give `${tparam}`'s field a value of a concrete type",
            ),
        )
}

/// A literal under a name that declares no fields — an enum's.
fn not_a_record(mut cx: TypeCx, e: ExprId, name: string) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.struct_fields",
                cx.loc_of(e),
                "`${name}` is an enum, not a record — it has no fields to fill",
                "built here",
                "construct a variant instead — `${name}.<variant>`",
            ),
        )
}

/// A literal under an alias of a shape that declares no fields.
fn fieldless_alias(mut cx: TypeCx, e: ExprId, name: string, d: DeclId) -> TypeId {
    let of = cx.view.types.name_of(cx.view.decls.alias_of(d) ?? cx.error_type)
    cx
        .spoken(
            refusal(
                "type.struct_fields",
                cx.loc_of(e),
                "`${name}` names `${of}`, which has no fields to fill",
                "built here",
                "a literal `${name} { … }` builds the record an alias names",
            ),
        )
}

/// THE DEFAULT LAW, at the declaration: a field's default (walked
/// under the field's want) is accepted by the field — every literal
/// that omits the field then calls it without judging it again.
export fn fits_default(mut cx: TypeCx, d: ExprId, name: string, want: TypeId) {
    if cx.accepts(d, want) { return }
    let n = cx.name_at(d)
    cx
        .emit(
            refusal(
                "type.struct_fields",
                cx.loc_of(d),
                "field `${name}` defaults to `${n}`, and it is `${cx.view.types.name_of(want)}`",
                this_is(n),
                null,
            ),
        )
}

// ── A NAME'S SHAPE ──

/// A NAME IS OPAQUE AT A SEAT, so a named value reaching a seat of
/// its shape needs a word for the crossing — `id.of` is that word,
/// the declaration read backwards (`type Name = <of>`). The row takes
/// every NOMINAL shape, which is a record's and a name's alike; a
/// record answers its FIELDS first, so only a name reaches here.
export fn on_nominal(t: Type) -> bool {
    t is .Struct
}

/// `x.of` answers the shape the name stands over.
export fn check_named_of(mut cx: TypeCx, e: ExprId, ty: TypeId) -> TypeId {
    let of? = cx.view.types.stands_for(ty) else { return not_a_name(cx, e, ty) }
    of
}

fn not_a_name(mut cx: TypeCx, e: ExprId, ty: TypeId) -> TypeId {
    cx
        .spoken(
            refusal(
                "type.named",
                cx.loc_of(e),
                "`.of` reads a named type's shape, this is `${cx.view.types.name_of(ty)}`",
                "read here",
                "`of` is the shape after `=` in `type Name = <shape>`",
            ),
        )
}
