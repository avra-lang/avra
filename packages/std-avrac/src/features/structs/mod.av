//! Structs — the first user-defined type. `type Name = { field: ty,
//! ... }` declares a nominal record; `Name { field: value, ... }`
//! builds one; reads ride the spine's postfix ladder (`p.x`).
//! `type Name = <type>` declares a NAMED TYPE over a shape — always
//! DISTINCT from it, never an alias; `Name(v)` wraps and `v.of`
//! reads the shape back, free at runtime. ONE `stmt` rule carries both
//! forms as an ordered choice, so one keyword claim and one
//! recovery stand where two branches on `type` could not.
//! Fields are scalars until ownership analysis covers managed
//! values. The literal branch merges into `primary` BEFORE the
//! spine's bare NAME; a non-literal brace falls through by
//! backtracking, so conditions like `if x { ... }` stay whole.
use features.{LanguageFeature, BuilderRow, PropertyRow}
use grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use diagnostics.{DiagCode}

export fn structs() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name         | build
        "type_decl"  | build_type_decl
        "struct_lit" | build_struct_lit
    }
    let codes = table<DiagCode> {
        kind                     | id      | summary
        "resolve.duplicate_type" | "F3006" | "two types share one name"
        "type.struct_scalar"     | "F2008" | "a struct field holds a value"
        "type.duplicate_field"   | "F2009" | "a struct's fields have distinct names"
        "type.struct_fields"     | "F2010" | "a literal provides each declared field exactly once"
        "type.with_struct"       | "F2011" | "`with` copies a struct value"
        "type.named"             | "F2083" | "a named type stands over one written shape"
    }
    let properties = table<PropertyRow> {
        name | takes      | check          | lower
        "of" | on_nominal | check_named_of | lower_named_of
    }
    component LanguageFeature f {
        name = "structs"
        docs = "`type Name = { field: ty, ... }` declares a record; `Name { field: value, ... }` builds; `value.field` reads; `value with { field: v }` copies. `type Name = <type>` declares a NAMED TYPE — its own type over that shape, never an alias: a literal fills it, the shape answers its reads, `Name(value)` wraps, and `value.of` reads the shape back."
        gram = grammar {
            stmt = "type" n:NAME ( "<" tp:NAME ( "," tp:NAME )* ","? ">" )? "=" ( "{" BREAK? ( ( fm:mark )* fs:NAME ":" ft:type ( "=" fd:expression )? ( "," BREAK? ( fm:mark )* fs:NAME ":" ft:type ( "=" fd:expression )? )* ","? BREAK? )? "}" | nt:type ) END @recover(sync_to: "END") -> type_decl(n, tp, fs, ft, fd, nt, fm)
            primary = t:NAME "{" BREAK? ( vn:NAME ":" ve:expression ( "," BREAK? vn:NAME ":" ve:expression )* ","? BREAK? )? "}" -> struct_lit(t, vn, ve)
        }
        builders = rows
        diags = codes
        properties = properties
    }
    f
}
