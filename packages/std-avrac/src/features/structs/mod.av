//! Structs — the first user-defined type. `type Name = { field: ty,
//! ... }` declares a nominal record; `Name { field: value, ... }`
//! builds one; reads ride the spine's postfix ladder (`p.x`).
//! `type Name = <type>` declares a NAMED TYPE over a shape — always
//! DISTINCT from it, never an alias; `Name(v)` wraps and `v.of`
//! reads the shape back, free at runtime. `alias Name = <type>` is
//! the other door: a SHORTHAND, the same type under a second name. ONE `stmt` rule carries both
//! forms as an ordered choice, so one keyword claim and one
//! recovery stand where two branches on `type` could not.
//! Fields are scalars until ownership analysis covers managed
//! values. The literal branch merges into `primary` BEFORE the
//! spine's bare NAME; a non-literal brace falls through by
//! backtracking, so conditions like `if x { ... }` stay whole.
use features.{LanguageFeature, BuilderRow, PropertyRow}
use features.structs.{index_compared}
use @std.grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use diagnostics.{DiagCode}

export fn structs() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name         | build
        "type_decl"  | build_type_decl
        "struct_lit" | build_struct_lit
    }
    let codes = table<DiagCode> {
        kind                     | summary
        "resolve.duplicate_type" | "two types share one name"
        "type.struct_scalar"     | "a struct field holds a value"
        "type.duplicate_field"   | "a struct's fields have distinct names"
        "type.spread"            | "a spread places another record's fields"
        "type.struct_fields"     | "a literal provides each declared field exactly once"
        "type.struct_targs"      | "a literal's written type arguments pin the record's parameters"
        "type.with_struct"       | "`with` copies a struct value"
        "type.named"             | "a named type stands over one written shape"
        "type.alias"             | "an alias names one type that is not itself"
        "type.tparam"            | "a declaration's type parameters are fresh, distinct names"
        "type.identity_field"    | "an identity's field is a Cell, or another identity"
        "type.lacks"             | "only a record lacks a field — each once, and none it declares"
        "type.sealed"            | "a sealed type is built and rewritten in the module that declares it"
    }
    let properties = table<PropertyRow> {
        name | takes      | check          | lower
        "of" | on_nominal | check_named_of | lower_named_of
    }
    LanguageFeature structs {
        gram: grammar {
            stmt = "type" n:NAME ( "<" tp:NAME ( "," tp:NAME )* ","? ">" )? "=" ( "{" BREAK? ( ( fields:field | rs:".." ( dd:"." )? rt:type ) ( ( "," | BREAK ) BREAK? ( fields:field | rs:".." ( dd:"." )? rt:type ) )* ","? BREAK? )? "}" | nt:type ) END @recover(sync_to: "END") -> type_decl(n, tp, fields, nt, rs, rt, dd)
            field = ( marks:mark )* ( state_field:STATE )? name:NAME ":" ty:type ( "=" default:expression )? -> Record.ParamSyntax | spread:".." name:HOLE -> Record.ParamSyntax
            stmt = "alias" name:NAME ( "<" tparams:NAME ( "," tparams:NAME )* ","? ">" )? "=" of:type END @recover(sync_to: "END") -> Stmt.Alias
            primary = t:NAME ( "<" ta:type ( "," ta:type )* ","? ">" )? "{" BREAK? ( ( vn:NAME ":" ve:expression | sp:".." vn:HOLE ) ( ( "," | BREAK ) BREAK? ( vn:NAME ":" ve:expression | sp:".." vn:HOLE ) )* ","? BREAK? )? "}" -> struct_lit(t, ta, vn, ve, sp)
        }
        builders: rows
        diags: codes
        properties: properties
    }
    structs
}
