//! The lowering rule — the ONE meaning: a struct value IS a fixed
//! slot array. The literal is one array_new plus a push per field
//! in DECLARATION order; values evaluate in WRITTEN order first.
//! Reads are the spine's property ladder (a slot read at the
//! field's compile-time index) — zero new instructions anywhere.
use core.{ExprId, Reg, Ins, TypeId, filled, DeclId}
use features.{LowerCx, StructSig}

fn structs_reg(mut cx: LowerCx, e: ExprId) -> Reg {
    // a feature cannot enumerate OTHER features' variants
    match cx.view.store.expr(e) {
        .StructLit(_, fields, values) -> lit_reg(cx, e, [t.of for t in fields], values),
        .With(subject, fields, values) -> with_reg(cx, e, subject, [t.of for t in fields], values),
        rest -> cx.foreign_node(e),
    }
}

/// The copy: values evaluate in written order, then one push per
/// declaration slot — the written register, or the subject's own
/// field read back. The subject is untouched.
fn with_reg(mut cx: LowerCx, e: ExprId, subject: ExprId, fields: List<string>, values: List<ExprId>) -> Reg {
    let src = cx.reg_of(subject)
    let regs = [cx.reg_of(v) for v in values]
    let held: StructSig? = cx.fields_at(e)
    if held == null {
        cx.defect("a `with` on a non-struct survived typing")
        return cx.result(e)
    }
    let sig = held!
    let subject_ty = cx.type_at(subject)
    mut by_slot: List<Reg?> = []
    for slot, n in sig.names {
        let j = fields.index_of(n)
        if j >= 0 { by_slot.push(regs[j]) }
        else { by_slot.push(cx.field_read(src, subject_ty, slot, sig.types[slot])) }
    }
    if cx.flat_at(e) { return packed_lit(cx, e, sig, by_slot) }
    let size = cx.box_size(by_slot.length)
    let dst = cx.result(e)
    cx.emit(Ins.CallRt(dst, "avra_array_sized", [size]))
    for r in by_slot { cx.push_slot(dst, r!) }
    dst
}

fn lit_reg(mut cx: LowerCx, e: ExprId, fields: List<string>, values: List<ExprId>) -> Reg {
    let regs = [cx.reg_of(v) for v in values]
    let sig? = cx.fields_at(e) else { return cx.lower_defect(e, "a field-less literal survived typing") }
    mut by_slot: List<Reg?> = filled<Reg?>(sig.names.length, null)
    for j, f in fields {
        let slot: int? = sig.slot_of(f)
        if slot != null {
            let r: Reg? = regs[j]
            by_slot.set(slot!, r)
        }
    }
    if cx.flat_at(e) { return packed_lit(cx, e, sig, by_slot) }
    let size = cx.box_size(by_slot.length)
    let dst = cx.result(e)
    cx.emit(Ins.CallRt(dst, "avra_array_sized", [size]))
    for slot, r in by_slot {
        if r != null { cx.push_slot(dst, r!) } else { cx.push_slot(dst, defaulted_reg(cx, e, sig, slot)) }
    }
    dst
}

/// A FLAT record's literal: ONE Pack over its one field, which each
/// engine renders as identity. The instruction earns its place by
/// giving the register the RECORD's type — a reader that asks a
/// register what it holds must not be told the field.
fn packed_lit(mut cx: LowerCx, e: ExprId, sig: StructSig, by_slot: List<Reg?>) -> Reg {
    let held: Reg? = by_slot[0]
    let one = held ?? defaulted_reg(cx, e, sig, 0)
    // THE MINT LAW, and the record's own TYPE: the Pack says "this
    // value IS its fields", and each engine renders it — for a flat
    // record, identity. The register must still wear the RECORD, or
    // every reader that asks a register its type sees the field.
    cx.packed(e, [one])
}

/// The default an omitted slot lowers to — typing guaranteed one:
/// a call to the field's own body, as instantiated at this literal.
fn defaulted_reg(mut cx: LowerCx, e: ExprId, sig: StructSig, slot: int) -> Reg {
    let d? = sig.defaults[slot] else { return cx.lower_defect(e, "a literal missing a field without a default survived typing") }
    let dst = cx.mint_ty(cx.viewed(sig.types[slot]))
    cx.emit(Ins.Call(dst, cx.symbol_at(d, e), []))
    dst
}

/// `x.of` — the shape a name stands over. A named value IS its
/// shape, so the read is the SUBJECT'S OWN REGISTER: no instruction,
/// no reference, nothing to settle. An `Extract` would read the
/// REGISTER's recorded type, and a literal filling a named seat
/// records no lift — so the register wears the shape and the extract
/// would have nothing to open.
// LICENSED I23: a row's rule wears the row's signature
export fn lower_named_of(mut cx: LowerCx, e: ExprId, r: Reg, ty: TypeId) -> Reg {
    r
}
