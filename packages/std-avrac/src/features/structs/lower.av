//! The lowering rule — the ONE meaning: a struct value IS a fixed
//! slot array (or, for a FLAT one-field record, its field's own
//! register — `cx.packed_struct`, features/values.av, the ONE
//! construction every struct here and elsewhere shares). Values
//! evaluate in WRITTEN order first, then every slot is resolved —
//! written, read back from a `with` subject, or defaulted — before
//! the pack itself runs. Reads are the spine's property ladder (a
//! slot read at the field's compile-time index) — zero new
//! instructions anywhere.
use core.{ExprId, StmtId, Reg, TypeId, Binding, filled}
use features.{
    LowerCx,
    StructSig,
    slot_want,
    StatePlace,
    site_places_of,
    structural_places_of,
    role_cells,
    role_opaque,
    role_structural,
}
use features.cells.{cell_holding}

/// The copy: values evaluate in written order, then the record whole
/// with the written slots replaced — a flat one packed afresh, a boxed
/// one sliced and rewritten. No holder of the subject sees it change.
fn with_reg(mut cx: LowerCx, e: ExprId, subject: ExprId, fields: List<string>, values: List<ExprId>) -> Reg {
    let src = cx.reg_of(subject)
    let held: StructSig? = cx.fields_at(e)
    if held == null {
        cx.defect("a `with` on a non-struct survived typing")
        return cx.result(e)
    }
    let sig = held!
    let regs = [slot_written(cx, sig, fields[j], cx.reg_of(v)) for j, v in values]
    let subject_ty = cx.type_at(subject)
    if cx.view.types.is_flat(cx.type_at(e)) {
        let parts = [if fields.contains(n) { regs[fields.index_of(n)] } else { cx.field_read(src, subject_ty, slot, sig.types[slot]) } for slot, n in sig.names]
        return cx.packed_struct(cx.type_at(e), parts)
    }
    rewritten(cx, cx.type_at(e), src, sig.names, fields, regs)
}

/// A BOXED record with some slots rewritten: the whole record sliced —
/// a copy, or the box itself when the subject dies here — then each
/// named slot written.
fn rewritten(
    mut cx: LowerCx,
    ty: TypeId,
    src: Reg,
    names: List<string>,
    fields: List<string>,
    regs: List<Reg>,
) -> Reg {
    let lo = cx.const_int(0)
    let hi = cx.const_int(cx.field_offset(ty, names.length))
    let dst = cx.array_slice(cx.view.types.shape_of(ty), src, lo, hi)
    for slot, n in names {
        if fields.contains(n) { cx.field_written(dst, ty, slot, regs[fields.index_of(n)]) }
    }
    dst
}

fn lit_reg(mut cx: LowerCx, e: ExprId, fields: List<string>, values: List<ExprId>) -> Reg {
    let regs = [cx.reg_of(v) for v in values]
    let sig? = cx.fields_at(e) else { return cx.lower_defect(e, "a field-less literal survived typing") }
    mut by_slot: List<Reg?> = filled<Reg?>(sig.names.length, null)
    for j, f in fields {
        let slot: int? = sig.slot_of(f)
        if slot != null {
            let r: Reg? = regs[j]
            by_slot.set(slot!, r)
        }
    }
    cx.packed_struct(cx.type_at(e), [slot_filled(cx, e, sig, slot, r) for slot, r in by_slot])
}

/// What an omitted slot lowers to: a SITE is the literal's own, and
/// any other slot its default — typing guaranteed one — a call to the
/// field's own body, as instantiated at this literal.
export fn defaulted_reg(mut cx: LowerCx, e: ExprId, sig: StructSig, slot: int) -> Reg {
    if cx.view.decls.cells_slot(sig, slot) { return watched_reg(cx, e, sig, slot) }
    if sig.role_at(slot) == role_opaque { return cx.const_bool(opaque_frame(cx)) }
    if cx.view.decls.sited_slot(sig, slot) {
        return cx
            .const_int_as(
                cx.viewed(sig.types[slot]),
                cx
                    .view
                    .decls
                    .site_of(cx.view.file, cx.view.store.expr_fingerprint(e), cx.view.store.literal_turn(e)),
            )
    }
    let d? = sig.defaults[slot] else { return cx.lower_defect(e, "a literal missing a field without a default survived typing") }
    cx.call_decl(cx.viewed(slot_want(cx.view.types, sig, slot)), cx.symbol_at(d, e), [])
}

/// A value written to slot `slot`: unchanged for a plain field, the
/// cell that holds it for a `state` field, or the field's default when
/// nothing was written. THE one wrap a state slot's seed takes —
/// `defaulted_reg` answers the raw value.
fn slot_filled(mut cx: LowerCx, e: ExprId, sig: StructSig, slot: int, held: Reg?) -> Reg {
    let v: Reg = held ?? defaulted_reg(cx, e, sig, slot)
    if !sig.state_at(slot) { return v }
    cell_holding(cx, slot_want(cx.view.types, sig, slot), v)
}

/// A value written to the field named `name` by a `with`: unchanged for
/// a plain field, the cell that holds it for a `state` field.
fn slot_written(mut cx: LowerCx, sig: StructSig, name: string, v: Reg) -> Reg {
    let j? = sig.slot_of(name) else { return v }
    if !sig.state_at(j) { return v }
    cell_holding(cx, slot_want(cx.view.types, sig, j), v)
}

/// `x.of` — the shape a name stands over. A named value IS its
/// shape, so the read is the SUBJECT'S OWN REGISTER: no instruction,
/// no reference, nothing to settle. An `Extract` would read the
/// REGISTER's recorded type, and a literal filling a named seat
/// records no lift — so the register wears the shape and the extract
/// would have nothing to open.
// LICENSED fns.dead_parameter: a row's rule wears the row's signature
export fn lower_named_of(mut cx: LowerCx, e: ExprId, r: Reg, ty: TypeId) -> Reg {
    r
}

/// The `Cells` an omitted slot holds, by the role its field wears: the cells
/// the literal's minted closure reads, or the cells its frame reads at paint
/// time that no reading answers for. A role no one reads here holds none.
fn watched_reg(mut cx: LowerCx, e: ExprId, sig: StructSig, slot: int) -> Reg {
    let regs = match sig.role_at(slot) {
        role_cells -> placed_cells(cx, e),
        role_structural -> structural_cells(cx, e),
        rest -> [],
    }
    let size = cx.box_size(regs.length)
    cx.grown_box(cx.view.types.shape_of(cx.viewed(sig.types[slot])), size, regs)
}

/// The cell of each place the literal's closure reads, or none at all when any
/// place has no cell to hand over here.
fn placed_cells(mut cx: LowerCx, e: ExprId) -> List<Reg> {
    let lam? = minted_closure(cx, e) else { return [] }
    let parts? = cx.view.store.lambda_parts(lam) else { return [] }
    let places = site_places_of(cx.view, cx.names, parts.body, cx.decl_places)
    let regs: List<Reg?> = [cell_of_place(cx, lam, p) for p in places]
    if regs.any(it == null) { return [] }
    [r! for r in regs]
}

/// The places this frame reads at paint time that no reading answers for, or
/// none when it cannot say (an opaque frame is judged by `opaque_frame`).
fn structural_set(cx: LowerCx) -> List<StatePlace> {
    let roots? = cx.roots else { return [StatePlace.Unknown] }
    [p for r in roots for p in structural_places_of(cx.view, cx.names, r, cx.decl_structural)]
}

/// The cells of the frame's structural places, when every one can be handed
/// over here.
fn structural_cells(mut cx: LowerCx, e: ExprId) -> List<Reg> {
    if opaque_frame(cx) { return [] }
    let regs: List<Reg?> = [local_cell(cx, e, p) for p in structural_set(cx)]
    [r! for r in regs]
}

/// Whether a page cannot place this frame's structural reads: one of them is a
/// place with no name, or has no cell to hand over here. Such a subtree is
/// always painted whole.
fn opaque_frame(cx: LowerCx) -> bool {
    !structural_set(cx).all((p) -> placeable(cx, p))
}

/// Whether a place has a cell in THIS body: a top-level state always, a local
/// only when the body itself defines it.
fn placeable(cx: LowerCx, p: StatePlace) -> bool {
    match p {
        .Global(_) -> true,
        .Local(f, s) -> f == cx.view.file && cx.body.slot_of(s) != null,
        .Unknown -> false,
    }
}

/// The cell a placeable place has in this body.
fn local_cell(mut cx: LowerCx, e: ExprId, p: StatePlace) -> Reg? {
    match p {
        .Global(d) -> cx.state_decl_cell(d),
        .Local(_, s) -> cx.state_cell_of(e, Binding.Def(s)),
        .Unknown -> null,
    }
}

/// The closure the builder minted into a literal: the field value whose node
/// answers for an instance and is a lambda.
fn minted_closure(cx: LowerCx, e: ExprId) -> ExprId? {
    match cx.view.store.expr(e) {
        .StructLit(_, _, values) -> values.find((v) -> closes(cx, v)),
        rest -> null,
    }
}

/// Whether a node is a closure the builder minted for an instance.
fn closes(cx: LowerCx, v: ExprId) -> bool {
    cx.view.store.minted_for(v) != null && cx.view.store.lambda_parts(v) != null
}

/// Whether a binding is the definition `s`.
fn is_def(b: Binding, s: StmtId) -> bool {
    match b { .Def(t) -> t == s, rest -> false }
}

/// The cell a place names in this body: a top-level state's, or a local
/// that the closure captured.
fn cell_of_place(mut cx: LowerCx, lam: ExprId, p: StatePlace) -> Reg? {
    match p {
        .Global(d) -> cx.state_decl_cell(d),
        .Local(_, s) -> {
            let cap? = cx.names.capture(lam) else { return null }
            let src? = cap.sources.find((b) -> is_def(b, s)) else { return null }
            cx.state_cell_of(lam, src)
        },
        .Unknown -> null,
    }
}
