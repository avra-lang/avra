//! The lowering rule — the ONE meaning: a struct value IS a fixed
//! slot array (or, for a FLAT one-field record, its field's own
//! register — `cx.packed_struct`, features/values.av, the ONE
//! construction every struct here and elsewhere shares). Values
//! evaluate in WRITTEN order first, then every slot is resolved —
//! written, read back from a `with` subject, or defaulted — before
//! the pack itself runs. Reads are the spine's property ladder (a
//! slot read at the field's compile-time index) — zero new
//! instructions anywhere.
use core.{ExprId, StmtId, Reg, TypeId, Binding, filled, flatten, spread_entry}
use features.{
    LowerCx,
    StructSig,
    slot_want,
    StatePlace,
    site_places_of,
    structural_places_answering,
    bound_to_receiver,
}
use features.cells.{cell_holding}

/// The copy: values evaluate in written order, then the record whole
/// with the written slots replaced. No holder of the subject sees it
/// change.
fn with_reg(mut cx: LowerCx, e: ExprId, subject: ExprId, fields: List<string>, values: List<ExprId>) -> Reg {
    let src = cx.reg_of(subject)
    let held: StructSig? = cx.fields_at(e)
    if held == null {
        cx.defect("a `with` on a non-struct survived typing")
        return cx.result(e)
    }
    let sig = held!
    let regs = [slot_written(cx, sig, fields[j], cx.reg_of(v)) for j, v in values]
    copied(cx, cx.type_at(e), src, cx.type_at(subject), sig, fields, regs)
}

/// A record copied with some slots written: a flat one packed afresh,
/// a boxed one sliced and rewritten.
fn copied(
    mut cx: LowerCx,
    ty: TypeId,
    src: Reg,
    subject_ty: TypeId,
    sig: StructSig,
    fields: List<string>,
    regs: List<Reg>,
) -> Reg {
    if cx.view.types.is_flat(ty) {
        let parts = [if fields.contains(n) { regs[fields.index_of(n)] } else { cx.field_read(src, subject_ty, slot, sig.types[slot]) } for slot, n in sig.names]
        return cx.packed_struct(ty, parts)
    }
    rewritten(cx, ty, src, sig.names, fields, regs)
}

/// A BOXED record with some slots rewritten: the whole record sliced —
/// a copy, or the box itself when the subject dies here — then each
/// named slot written.
fn rewritten(
    mut cx: LowerCx,
    ty: TypeId,
    src: Reg,
    names: List<string>,
    fields: List<string>,
    regs: List<Reg>,
) -> Reg {
    let lo = cx.const_int(0)
    let hi = cx.const_int(cx.field_offset(ty, names.length))
    let dst = cx.array_slice(cx.view.types.shape_of(ty), src, lo, hi)
    for slot, n in names {
        if fields.contains(n) { cx.field_written(dst, ty, slot, regs[fields.index_of(n)]) }
    }
    dst
}

fn lit_reg(mut cx: LowerCx, e: ExprId, fields: List<string>, values: List<ExprId>) -> Reg {
    let regs = [cx.reg_of(v) for v in values]
    let sig? = cx.fields_at(e) else { return cx.lower_defect(e, "a field-less literal survived typing") }
    if fields.contains(spread_entry) { return merged_reg(cx, e, sig, fields, values, regs) }
    mut by_slot: List<Reg?> = filled<Reg?>(sig.names.length, null)
    for j, f in fields {
        let slot: int? = sig.slot_of(f)
        if slot != null {
            let r: Reg? = regs[j]
            by_slot.set(slot!, r)
        }
    }
    cx.packed_struct(cx.type_at(e), [slot_filled(cx, e, sig, slot, r) for slot, r in by_slot])
}

/// A literal that spreads. `P { ..a, x: 1 }` over a `P` is the copy
/// `a with { x: 1 }`, lowered as one; any other mix reads each slot
/// from the LAST entry that provides it.
fn merged_reg(
    mut cx: LowerCx,
    e: ExprId,
    sig: StructSig,
    fields: List<string>,
    values: List<ExprId>,
    regs: List<Reg>,
) -> Reg {
    let ty = cx.type_at(e)
    if copies_whole(cx, ty, fields, values) {
        let written = fields.drop(1)
        let wrapped = [slot_written(cx, sig, f, regs[j + 1]) for j, f in written]
        return copied(cx, ty, regs[0], ty, sig, written, wrapped)
    }
    mut from: List<int?> = filled<int?>(sig.names.length, null)
    mut at: List<int> = filled<int>(sig.names.length, 0)
    for j, f in fields {
        let carried: List<string> = if f == spread_entry { cx.fields_at(values[j])?.names ?? [] } else { [f] }
        for i, n in carried {
            let slot: int? = sig.slot_of(n)
            if slot != null {
                from.set(slot!, j)
                at.set(slot!, i)
            }
        }
    }
    cx
        .packed_struct(
            ty,
            [slot_merged(cx, e, sig, fields, values, regs, slot, from[slot], at[slot]) for slot in 0..sig.names.length],
        )
}

/// Whether the literal is one spread of its own type followed by
/// plain fields — exactly a `with`.
fn copies_whole(cx: LowerCx, ty: TypeId, fields: List<string>, values: List<ExprId>) -> bool {
    fields[0] == spread_entry &&
        cx.type_at(values[0]) == ty &&
        !fields.drop(1).contains(spread_entry)
}

/// One slot of a merged literal: read from the spread that won it,
/// the written value of the field that won it, or its default.
fn slot_merged(
    mut cx: LowerCx,
    e: ExprId,
    sig: StructSig,
    fields: List<string>,
    values: List<ExprId>,
    regs: List<Reg>,
    slot: int,
    winner: int?,
    carried_at: int,
) -> Reg {
    let j? = winner else { return slot_filled(cx, e, sig, slot, null) }
    if fields[j] != spread_entry { return slot_filled(cx, e, sig, slot, regs[j]) }
    cx.field_read(regs[j], cx.type_at(values[j]), carried_at, sig.types[slot])
}

/// What an omitted slot lowers to: a SITE is the literal's own, and
/// any other slot its default — typing guaranteed one — a call to the
/// field's own body, as instantiated at this literal.
export fn defaulted_reg(mut cx: LowerCx, e: ExprId, sig: StructSig, slot: int) -> Reg {
    if cx.view.decls.sited_slot(sig, slot) {
        return cx
            .const_int_as(
                cx.viewed(sig.types[slot]),
                cx
                    .view
                    .decls
                    .site_of(cx.view.file, cx.view.store.site_fingerprint(e), cx.view.store.literal_turn(e)),
            )
    }
    if cx.view.decls.words_slot(sig, slot) {
        let lam? = minted_closure(cx, e) else { return default_reg(cx, e, sig, slot) }
        return cx.reg_of(lam)
    }
    if cx.view.decls.cells_slot(sig, slot) { return cells_reg(cx, sig.types[slot], placed_cells(cx, e)) }
    if cx.view.decls.structural_slot(sig, slot) { return cells_reg(cx, sig.types[slot], structural_cells(cx, e)) }
    if cx.view.decls.opaque_slot(sig, slot) { return cx.const_bool(opaque_frame(cx)) }
    default_reg(cx, e, sig, slot)
}

/// A value written to slot `slot`: unchanged for a plain field, the
/// cell that holds it for a `state` field, or the field's default when
/// nothing was written. THE one wrap a state slot's seed takes —
/// `defaulted_reg` answers the raw value.
fn slot_filled(mut cx: LowerCx, e: ExprId, sig: StructSig, slot: int, held: Reg?) -> Reg {
    let v: Reg = held ?? defaulted_reg(cx, e, sig, slot)
    if !sig.state_at(slot) { return v }
    cell_holding(cx, slot_want(cx.view.types, sig, slot), v)
}

/// A value written to the field named `name` by a `with`: unchanged for
/// a plain field, the cell that holds it for a `state` field.
fn slot_written(mut cx: LowerCx, sig: StructSig, name: string, v: Reg) -> Reg {
    let j? = sig.slot_of(name) else { return v }
    if !sig.state_at(j) { return v }
    cell_holding(cx, slot_want(cx.view.types, sig, j), v)
}

/// `x.of` — the shape a name stands over. A named value IS its
/// shape, so the read is the SUBJECT'S OWN REGISTER: no instruction,
/// no reference, nothing to settle. An `Extract` would read the
/// REGISTER's recorded type, and a literal filling a named seat
/// records no lift — so the register wears the shape and the extract
/// would have nothing to open.
// LICENSED fns.dead_parameter: a row's rule wears the row's signature
export fn lower_named_of(mut cx: LowerCx, e: ExprId, r: Reg, ty: TypeId) -> Reg {
    r
}

/// A list of cells packed into the slot's own type.
fn cells_reg(mut cx: LowerCx, ty: TypeId, regs: List<Reg>) -> Reg {
    let size = cx.box_size(regs.length)
    cx.grown_box(cx.view.types.shape_of(cx.viewed(ty)), size, regs)
}

/// The cell of each place the literal's closure reads, then the cell of each
/// `state` field of the receiver it reads, or none at all when any read has no
/// cell to hand over here.
fn placed_cells(mut cx: LowerCx, e: ExprId) -> List<Reg> {
    let lam? = minted_closure(cx, e) else { return [] }
    let parts? = cx.view.store.lambda_parts(lam) else { return [] }
    let places = site_places_of(cx.view, cx.names, parts.body, cx.decl_places)
    let regs: List<Reg?> = [cell_of_place(cx, lam, p) for p in places]
    let selves? = receiver_cells(cx, lam, parts.body) else { return [] }
    if regs.any(it == null) { return [] }
    [r! for r in regs].concat(selves)
}

/// One use of the receiver a minted closure captured: a field read through it,
/// or any other use.
enum SelfUse {
    Field(name: string)
    Bare
}

/// The capture of `lam`'s env that is the method's own receiver, held directly
/// or through the captures of the closures around it.
fn receiver_capture(cx: LowerCx, lam: ExprId) -> int? {
    let cap? = cx.names.capture(lam) else { return null }
    [j for j, b in cap.sources if bound_to_receiver(cx.names, b)].first()
}

/// Every use of the capture `j` of `lam` in the subtree, outermost first.
fn self_uses(cx: LowerCx, lam: ExprId, j: int, e: ExprId) -> List<SelfUse> {
    match cx.view.store.expr(e) {
        .Prop(sub, name) if reads_capture(cx, lam, j, sub) -> [SelfUse.Field(name.of)],
        .Receiver -> if reads_capture(cx, lam, j, e) { [SelfUse.Bare] } else { [] },
        rest -> flatten([self_uses(cx, lam, j, k) for k in cx.view.store.reached(e)]),
    }
}

/// Whether the expression is a read of the capture `j` of `lam`.
fn reads_capture(cx: LowerCx, lam: ExprId, j: int, e: ExprId) -> bool {
    let b? = cx.names.binding(e) else { return false }
    match b { .Capture(l, i) -> l == lam && i == j, rest -> false }
}

/// The `state` slots of the receiver a closure reads, in first-read order:
/// none when it does not capture the receiver; null when any use of the
/// receiver is not a read of such a slot, or it is captured another way.
fn receiver_slots(mut cx: LowerCx, lam: ExprId, body: ExprId) -> List<int>? {
    let captured = (cx.names.capture(lam)?.sources ?? []).any((b) -> bound_to_receiver(cx.names, b))
    if !captured { return [] }
    let j? = receiver_capture(cx, lam) else { return null }
    let sig? = cx.fields_of(cx.seen(cx.capture_ty(lam, j))) else { return null }
    let names: List<string?> = [match u { .Field(n) -> n, .Bare -> null } for u in self_uses(cx, lam, j, body)]
    if names.any(it == null) { return null }
    let slots: List<int?> = [sig.slot_of(n!) for n in names]
    if slots.any((s) -> s == null || !sig.state_at(s!)) { return null }
    deduped_slots([s! for s in slots])
}

/// The cells those slots hold in the receiver, read in this body.
fn receiver_cells(mut cx: LowerCx, lam: ExprId, body: ExprId) -> List<Reg>? {
    let slots? = receiver_slots(cx, lam, body) else { return null }
    if slots.is_empty() { return [] }
    let j? = receiver_capture(cx, lam) else { return null }
    let ty = cx.seen(cx.capture_ty(lam, j))
    let sig? = cx.fields_of(ty) else { return null }
    let at? = cx.capture_reg(lam, j) else { return null }
    [cx.field_read(at, ty, s, sig.types[s]) for s in slots]
}

/// Each slot once, in first-read order.
fn deduped_slots(slots: List<int>) -> List<int> {
    mut out: List<int> = []
    for s in slots { if !out.contains(s) { out.push(s) } }
    out
}

/// The closure the builder minted beside a literal: the node that extends it
/// and is a lambda.
fn minted_closure(cx: LowerCx, e: ExprId) -> ExprId? {
    cx.view.store.extended_by(e).find((v) -> closes(cx, v))
}

/// Whether a node is a closure the builder minted for an instance.
fn closes(cx: LowerCx, v: ExprId) -> bool {
    cx.view.store.minted_for(v) != null && cx.view.store.lambda_parts(v) != null
}

/// Whether a binding is the definition `s`.
fn is_def(b: Binding, s: StmtId) -> bool {
    match b { .Def(t) -> t == s, rest -> false }
}

/// The cell a place names in this body: a top-level state's, or a local
/// that the closure captured.
fn cell_of_place(mut cx: LowerCx, lam: ExprId, p: StatePlace) -> Reg? {
    match p {
        .Global(d) -> cx.state_decl_cell(d),
        .Local(_, s) -> {
            let cap? = cx.names.capture(lam) else { return null }
            let src? = cap.sources.find((b) -> is_def(b, s)) else { return null }
            cx.state_cell_of(lam, src)
        },
        .Unknown -> null,
    }
}

/// The places this frame reads at paint time that no reading answers for;
/// `Unknown` for a frame whose code is not one expression.
fn structural_set(cx: LowerCx) -> List<StatePlace> {
    let roots? = cx.roots else { return [StatePlace.Unknown] }
    [p for r in roots for p in structural_places_answering(cx.view, cx.names, r, cx.decl_structural, (e) -> prop_heads(cx, e))]
}

/// The heads of an instance a cell of the instance takes: those whose field its
/// signature made a `state` — each is written into the cell at every paint.
fn prop_heads(cx: LowerCx, e: ExprId) -> List<ExprId> {
    match cx.view.store.expr(e) {
        .Component(_, _, heads, _, _, _) -> {
            let lit? = cx.view.store.expansion_of(e) else { return [] }
            let sig? = cx.fields_at(lit) else { return [] }
            let parts? = cx.view.store.struct_lit_parts(lit) else { return [] }
            [h for j, h in heads if j < parts.fields.length && is_state_field(sig, parts.fields[j])]
        },
        rest -> [],
    }
}

/// Whether the signature makes the named field a `state` cell.
fn is_state_field(sig: StructSig, name: string) -> bool {
    let slot? = sig.slot_of(name) else { return false }
    sig.state_at(slot)
}

/// The cells of the frame's structural places, when every one can be handed
/// over here.
fn structural_cells(mut cx: LowerCx, e: ExprId) -> List<Reg> {
    if opaque_frame(cx) { return [] }
    let regs: List<Reg?> = [local_cell(cx, e, p) for p in structural_set(cx)]
    [r! for r in regs]
}

/// Whether a page cannot place this frame's structural reads: one is a place
/// with no name, or has no cell to hand over here. Such a subtree is always
/// painted whole.
fn opaque_frame(mut cx: LowerCx) -> bool {
    !structural_set(cx).all((p) -> placeable(cx, p)) || unplaced_selves(cx)
}

/// Whether a text the frame says again reads its receiver in a way no cell
/// answers for: the page could not know when it changed.
fn unplaced_selves(mut cx: LowerCx) -> bool {
    let roots? = cx.roots else { return false }
    ![r for r in roots if says_unplaced(cx, r)].is_empty()
}

fn says_unplaced(mut cx: LowerCx, e: ExprId) -> bool {
    let lit = if cx.view.store.instance_word(e) == null { null } else { cx.view.store.expansion_of(e) }
    let own = if lit == null { false } else { unplaced_closure(cx, lit!) }
    own || ![k for k in cx.view.store.walked(e) if says_unplaced(cx, k)].is_empty()
}

fn unplaced_closure(mut cx: LowerCx, lit: ExprId) -> bool {
    let lam? = minted_closure(cx, lit) else { return false }
    let parts? = cx.view.store.lambda_parts(lam) else { return false }
    receiver_slots(cx, lam, parts.body) == null
}

/// Whether a place has a cell in THIS body: a top-level state always, a local
/// only when the body itself defines it.
fn placeable(cx: LowerCx, p: StatePlace) -> bool {
    match p {
        .Global(_) -> true,
        .Local(f, s) -> f == cx.view.file && cx.body.slot_of(s) != null,
        .Unknown -> false,
    }
}

/// The cell a placeable place has in this body.
fn local_cell(mut cx: LowerCx, e: ExprId, p: StatePlace) -> Reg? {
    match p {
        .Global(d) -> cx.state_decl_cell(d),
        .Local(_, s) -> cx.state_cell_of(e, Binding.Def(s)),
        .Unknown -> null,
    }
}

/// What an omitted slot with no role holds: the literal's own site for a
/// `Site`, else its default.
fn default_reg(mut cx: LowerCx, e: ExprId, sig: StructSig, slot: int) -> Reg {
    if cx.view.decls.sited_slot(sig, slot) {
        return cx
            .const_int_as(
                cx.viewed(sig.types[slot]),
                cx
                    .view
                    .decls
                    .site_of(cx.view.file, cx.view.store.expr_fingerprint(e), cx.view.store.literal_turn(e)),
            )
    }
    let d? = sig.defaults[slot] else { return cx.lower_defect(e, "a literal missing a field without a default survived typing") }
    cx.call_decl(cx.viewed(slot_want(cx.view.types, sig, slot)), cx.symbol_at(d, e), [])
}
