//! The lowering rule — the ONE meaning: a struct value IS a fixed
//! slot array. The literal is one array_new plus a push per field
//! in DECLARATION order; values evaluate in WRITTEN order first.
//! Reads are the spine's property ladder (a slot read at the
//! field's compile-time index) — zero new instructions anywhere.
use core.{ExprId, Reg, Ins, Type, filled}
use features.{LowerCx, StructSig, hole_defect, lower_defect, push_slot, slot_read}

fn structs_reg(cx: LowerCx, e: ExprId) -> Reg {
    // LICENSED I22: a feature cannot enumerate OTHER features' variants (the isolation doctrine); its own are listed
    match cx.store.expr(e) {
        .StructLit(_, fields, values) -> lit_reg(cx, e, fields, values),
        .With(subject, fields, values) -> with_reg(cx, e, subject, fields, values),
        _ -> lower_defect(cx, e, hole_defect()),
    }
}

/// The copy: values evaluate in written order, then one push per
/// declaration slot — the written register, or the subject's own
/// field read back. The subject is untouched.
fn with_reg(cx: LowerCx, e: ExprId, subject: ExprId, fields: List<string>, values: List<ExprId>) -> Reg {
    let src = cx.reg_of(subject)
    let regs = [cx.reg_of(v) for v in values]
    let sig: StructSig? = cx.fields_at(e)
    if sig == null {
        cx.fail("defect: a `with` on a non-struct survived typing")
        return cx.result(e)
    }
    let dst = cx.result(e)
    cx.emit(Ins.CallRt(dst, "avra_array_new", []))
    for (slot, n) in sig!.names.enumerate() {
        let j = fields.index_of(n)
        if j >= 0 {
            push_slot(cx, dst, regs[j])
        } else {
            push_slot(cx, dst, slot_read(cx, src, slot, sig!.types[slot]))
        }
    }
    dst
}

fn lit_reg(cx: LowerCx, e: ExprId, fields: List<string>, values: List<ExprId>) -> Reg {
    let regs = [cx.reg_of(v) for v in values]
    let sig: StructSig? = cx.fields_at(e)
    if sig == null { return lower_defect(cx, e, "a field-less literal survived typing") }
    let dst = cx.result(e)
    cx.emit(Ins.CallRt(dst, "avra_array_new", []))
    mut by_slot: List<Reg?> = filled<Reg?>(fields.length, null)
    for (j, f) in fields.enumerate() {
        let slot: int? = if sig == null { null } else { sig!.slot_of(f) }
        if slot != null {
            let r: Reg? = regs[j]
            by_slot.set(slot!, r)
        }
    }
    for r in by_slot {
        if r != null { push_slot(cx, dst, r!) }
    }
    dst
}
