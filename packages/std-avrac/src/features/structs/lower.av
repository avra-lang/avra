//! The lowering rule — the ONE meaning: a struct value IS a fixed
//! slot array. The literal is one array_new plus a push per field
//! in DECLARATION order; values evaluate in WRITTEN order first.
//! Reads are the spine's property ladder (a slot read at the
//! field's compile-time index) — zero new instructions anywhere.
use core.{ExprId, Reg, Ins, filled, DeclId}
use features.{LowerCx, StructSig, lower_defect, foreign_node, push_slot, slot_read}

fn structs_reg(cx: LowerCx, e: ExprId) -> Reg {
    // LICENSED I22: a feature cannot enumerate OTHER features' variants
    match cx.view.store.expr(e) {
        .StructLit(_, fields, values) -> lit_reg(cx, e, fields, values),
        .With(subject, fields, values) -> with_reg(cx, e, subject, fields, values),
        _ -> foreign_node(cx, e),
    }
}

/// The copy: values evaluate in written order, then one push per
/// declaration slot — the written register, or the subject's own
/// field read back. The subject is untouched.
fn with_reg(cx: LowerCx, e: ExprId, subject: ExprId, fields: List<string>, values: List<ExprId>) -> Reg {
    let src = cx.reg_of(subject)
    let regs = [cx.reg_of(v) for v in values]
    let sig: StructSig? = cx.fields_at(e)
    if sig == null {
        cx.defect("a `with` on a non-struct survived typing")
        return cx.result(e)
    }
    mut by_slot: List<Reg?> = []
    for (slot, n) in sig!.names.enumerate() {
        let j = fields.index_of(n)
        if j >= 0 { by_slot.push(regs[j]) } else { by_slot.push(slot_read(cx, src, slot, sig!.types[slot])) }
    }
    if cx.view.types.is_flat(cx.viewed(cx.type_at(e))) { return packed_lit(cx, e, sig!, by_slot) }
    let dst = cx.result(e)
    cx.emit(Ins.CallRt(dst, "avra_array_new", []))
    for r in by_slot { push_slot(cx, dst, r!) }
    dst
}

fn lit_reg(cx: LowerCx, e: ExprId, fields: List<string>, values: List<ExprId>) -> Reg {
    let regs = [cx.reg_of(v) for v in values]
    let held: StructSig? = cx.fields_at(e)
    if held == null { return lower_defect(cx, e, "a field-less literal survived typing") }
    let sig = held!
    mut by_slot: List<Reg?> = filled<Reg?>(sig.names.length, null)
    for (j, f) in fields.enumerate() {
        let slot: int? = sig.slot_of(f)
        if slot != null {
            let r: Reg? = regs[j]
            by_slot.set(slot!, r)
        }
    }
    if cx.view.types.is_flat(cx.viewed(cx.type_at(e))) { return packed_lit(cx, e, sig, by_slot) }
    let dst = cx.result(e)
    cx.emit(Ins.CallRt(dst, "avra_array_new", []))
    // LICENSED I3: the slot's ORDINAL finds its default
    for (slot, r) in by_slot.enumerate() {
        if r != null { push_slot(cx, dst, r!) } else { push_slot(cx, dst, defaulted_reg(cx, e, sig, slot)) }
    }
    dst
}

/// A FLAT record's literal: NO instruction at all. The record is
/// its one field, so the field's register IS the record's.
fn packed_lit(cx: LowerCx, e: ExprId, sig: StructSig, by_slot: List<Reg?>) -> Reg {
    let held: Reg? = by_slot[0]
    if held != null { return held! }
    defaulted_reg(cx, e, sig, 0)
}

/// The default an omitted slot lowers to — typing guaranteed one:
/// a call to the field's own body, as instantiated at this literal.
fn defaulted_reg(cx: LowerCx, e: ExprId, sig: StructSig, slot: int) -> Reg {
    let d: DeclId? = sig.defaults[slot]
    if d == null { return lower_defect(cx, e, "a literal missing a field without a default survived typing") }
    let dst = cx.mint_ty(cx.viewed(sig.types[slot]))
    cx.emit(Ins.Call(dst, cx.symbol_at(d!, e), []))
    dst
}
