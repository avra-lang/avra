//! `DeclFacts`'s fold: the digest of its codec's bytes, so it covers every field.

use core.{fp_str, digest_of_octets}
use @std.relation.stable.{Writer, encoded_with, indexed_scope}
use features.{DeclFacts}

impl DeclFacts {
    fn fingerprint() -> int {
        fp_str(
            digest_of_octets(
                encoded_with(
                    self,
                    (w: Writer, v: DeclFacts) -> DeclFacts.written_by(w, indexed_scope(), v),
                ),
            ),
        )
    }
}
