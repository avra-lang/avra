//! A boolean literal IS its value: no children, no names, types as
//! bool, lowers as its constant.
use core.{Expr, ExprId, Type, TypeId, Reg, Ins, truth_of}
use features.{NodeSemantics, ResolveCx, TypeCx, LowerCx, nothing, lower_defect}

export type BoolSemantics = { }

impl NodeSemantics for BoolSemantics {
    fn kids(self, e: Expr) -> List<ExprId> {
        []
    }

    fn heirs(self, e: Expr) -> List<ExprId> {
        []
    }

    fn resolve(self, cx: ResolveCx, e: ExprId) {
        nothing()
    }

    fn type_of(self, cx: TypeCx, e: ExprId) -> TypeId {
        cx.types.intern(Type.Bool)
    }

    fn lower(self, cx: LowerCx, e: ExprId) -> Reg {
        let v: bool? = truth_of(cx.store.expr(e))
        if v == null { return lower_defect(cx, e, "a bool literal without its value") }
        let dst = cx.result(e)
        cx.emit(Ins.ConstBool(dst, v!))
        dst
    }

}
