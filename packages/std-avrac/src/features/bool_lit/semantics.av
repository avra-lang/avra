//! A boolean literal IS its value: no children, no names, types as
//! bool, lowers as its constant.
use core.{ExprId, TypeId, Reg}
use features.{NodeSemantics, TypeCx, LowerCx, Meaning, ResolveCx, nothing}

use core.expr.{BoolLit}

export type BoolSemantics = {}

impl NodeSemantics for BoolSemantics {

}

impl Meaning for BoolLit {
    fn resolve(mut cx: ResolveCx, e: ExprId) {
        nothing()
    }
    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        cx.type(bool)
    }
    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        let v? = cx.view.store.expr(e).bool_of() else { return cx.lower_defect(e, "a bool literal without its value") }
        cx.const_bool_at(e, v)
    }
}
