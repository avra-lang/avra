//! A boolean literal IS its value: no children, no names, types as
//! bool, lowers as its constant.
use core.{Expr, ExprId, TypeId, Reg, Ins}
use features.{NodeSemantics, TypeCx, LowerCx}

export type BoolSemantics = { }

impl NodeSemantics for BoolSemantics {

    fn type_of(mut cx: TypeCx, e: ExprId) -> TypeId {
        cx.type(bool)
    }

    fn lower(mut cx: LowerCx, e: ExprId) -> Reg {
        let v: bool? = (cx.view.store.expr(e)).bool_of()
        if v == null { return cx.lower_defect(e, "a bool literal without its value") }
        let dst = cx.result(e)
        cx.emit(Ins.ConstBool(dst, v!))
        dst
    }

}
