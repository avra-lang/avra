//! A boolean literal IS its value: no children, no names, types as
//! bool, evaluates to itself, prints its keyword.
use core.{Expr, ExprId, Type, TypeId, NodeStore}
use features.{NodeSemantics, ResolveCx, TypeCx, EvalCx, nothing}

export type BoolSemantics = { }

impl NodeSemantics for BoolSemantics {
    fn kids(self, e: Expr) -> List<ExprId> {
        []
    }

    fn resolve(self, cx: ResolveCx, e: ExprId) {
        nothing()
    }

    fn type_of(self, cx: TypeCx, e: ExprId) -> TypeId {
        cx.intern(Type.Bool)
    }

    fn eval(self, cx: EvalCx, e: ExprId) -> ExprId {
        e
    }

    fn printed(self, store: NodeStore, e: ExprId) -> string? {
        match store.expr(e) {
            .BoolLit(v) -> if v { "true" } else { "false" },
            _ -> null,
        }
    }
}
