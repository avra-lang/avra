//! Parse-time lowering: the keyword tokens -> BoolLit nodes.
use core.{Expr}
use features.{LangNode, Builder}

fn build_true(mut b: Builder) -> Result<LangNode, string> {
    b.make_expr(Expr.BoolLit(true))
}

fn build_false(mut b: Builder) -> Result<LangNode, string> {
    b.make_expr(Expr.BoolLit(false))
}
