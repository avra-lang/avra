//! Boolean literals — `true` and `false`. Keyword ANCHORS: they
//! merge into `primary` BEFORE the spine's NAME branch, which is the
//! one overlap the dead-branch gate sanctions.
//!
//! The word IS the value, so each rule STATES its payload rather than
//! capturing one — and this feature has no builders.
use features.{LanguageFeature}
// LICENSED style.unused_import: `Fixed` is named by GENERATED code, not by this file —
// the `grammar { }` expansion writes a `Fixed` literal here for the
// stated payload, and resolve needs the name the source never spells
use grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Fixed, Expect, Recover}

export fn bool_lit() -> LanguageFeature {
    LanguageFeature bool_lit {
        docs: "`true` and `false`; their value is themselves."
        gram: grammar {
            primary = "true" -> Expr.BoolLit(value = true) | "false" -> Expr.BoolLit(value = false)
        }
    }
    bool_lit
}
