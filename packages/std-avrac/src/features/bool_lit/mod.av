//! Boolean literals — `true` and `false`. Keyword ANCHORS: they
//! merge into `primary` BEFORE the spine's NAME branch, which is the
//! one overlap the dead-branch gate sanctions.
use features.{LanguageFeature, BuilderRow}
use grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}

export fn bool_lit() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name        | build
        "true_lit"  | build_true
        "false_lit" | build_false
    }
    component LanguageFeature f {
        name = "bool_lit"
        docs = "`true` and `false`; their value is themselves."
        gram = grammar {
            primary = "true" -> true_lit() | "false" -> false_lit()
        }
        builders = rows
    }
    f
}
