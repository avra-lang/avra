//! The typing rules of the literals this feature reads.
use core.{Checking, Checks, ExprId, SignedType, Expected, owned_type}
use core.expr.{BoolLit}

impl Checks for BoolLit {
    /// `true` and `false` are `bool`s.
    fn checked(mut cx: Checking, e: ExprId, expected: Expected) -> SignedType? { owned_type("bool") }
}
