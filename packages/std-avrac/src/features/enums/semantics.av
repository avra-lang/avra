//! The enums semantics: dispatch only. Typing lives in check.av;
//! lowering — the MEANING — in lower.av. The declaration is a
//! STATEMENT kind whose name the driver declares program-wide in
//! the type namespace, so its own passes do nothing. A match is
//! CONTROL-OWNING: its arms are hidden from `kids` and walked
//! through the driver, each under its own bind.
use core.{Expr, ExprId, StmtId, TypeId, Reg}
use features.{NodeSemantics, StmtSemantics, ResolveCx, TypeCx, LowerCx,
              StmtResolveCx, StmtTypeCx, StmtLowerCx, nothing, nested_decl, ArmScope}

export type EnumsSemantics = { }

impl NodeSemantics for EnumsSemantics {
    fn kids(self, e: Expr) -> List<ExprId> {
        // LICENSED I22: a feature cannot enumerate OTHER features' variants (the isolation doctrine); its own are listed
        match e {
            .Match(subject, _, _, _) -> [subject],
            .VariantLit(_, _, args) -> args,
            _ -> [],
        }
    }

    fn resolve(self, cx: ResolveCx, e: ExprId) {
        // LICENSED I22: a feature cannot enumerate OTHER features' variants
        match cx.store.expr(e) {
            .VariantLit(tname, _, _) -> cx.use_type(e, tname),
            .Match(_, _, binds, values) -> resolve_arms(cx, e, binds, values),
            _ -> nothing(),
        }
    }

    fn type_of(self, cx: TypeCx, e: ExprId) -> TypeId {
        enums_type(cx, e)
    }

    fn lower(self, cx: LowerCx, e: ExprId) -> Reg {
        enums_reg(cx, e)
    }
}

export type EnumDeclSemantics = { }

impl StmtSemantics for EnumDeclSemantics {
    fn resolve_stmt(self, cx: StmtResolveCx, s: StmtId) {
        if cx.in_block {
            cx.emit(nested_decl("resolve.nested_type", "type declarations", cx.loc_of(s)))
        }
    }

    fn type_stmt(self, cx: StmtTypeCx, s: StmtId) {
        check_enum_decl(cx, s)
    }

    fn lower_stmt(self, cx: StmtLowerCx, s: StmtId) -> Reg? {
        null
    }
}

/// Each arm walks under its OWN bind — a match is a CONTROL-OWNING
/// node, so `kids` hides the arm values and this walks them instead.
fn resolve_arms(cx: ResolveCx, at: ExprId, binds: List<string>, values: List<ExprId>) {
    for (j, v) in values.enumerate() {
        let arm = ArmScope { bind: binds[j], at: at, arm: j, value: v }
        cx.arm_scope(arm)
    }
}
