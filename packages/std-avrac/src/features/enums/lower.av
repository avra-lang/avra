//! The lowering rule — the ONE meaning: an enum value is a slot
//! array carrying its TAG at slot 0 and its payloads at slots 1..;
//! a match whose arms each test one variant whole is ONE N-arm
//! region over the tag — a jump table natively, not a walk down a
//! chain of comparisons; any other match is a CHAIN of tests in arm
//! order, each arm's binds read inside its own region.
use core.{ExprId, Reg, Ins, TypeId, Type, BinOp, Arm, PatId}
use features.{LowerCx, EnumSig, pat_semantics_of}
use features.enums.{all_irrefutable, binders}

fn enums_reg(mut cx: LowerCx, e: ExprId) -> Reg {
    // a feature cannot enumerate OTHER features' variants
    match cx.view.store.expr(e) {
        .Match(subject, arms) -> matched_reg(cx, e, subject, arms),
        .Is(subject, variant) -> asked_reg(cx, e, subject, variant.of),
        .VariantLit(name, args) -> literal_reg(cx, e, name.of, args),
        rest -> cx.foreign_node(e),
    }
}

/// `v.ordinal` — the tag IS the declaration order.
// LICENSED fns.dead_parameter: a property row's lowering names the node; the tag needs only the subject
export fn lower_ordinal(mut cx: LowerCx, e: ExprId, r: Reg, ty: TypeId) -> Reg {
    cx.tag_of(r)
}

/// `subject is .variant`: the tag read once, compared to the
/// variant's ordinal — one instruction, no region.
fn asked_reg(mut cx: LowerCx, e: ExprId, subject: ExprId, variant: string) -> Reg {
    let declared: EnumSig? = cx.variants_at(subject)
    let which: int? = declared?.tag_of(variant)
    if which == null {
        cx.defect("an `is` without an enum variant survived typing")
        return cx.result(e)
    }
    cx.bin_at(e, BinOp.Eq, cx.tag_of(cx.reg_of(subject)), cx.const_int(which!))
}

/// The subject is evaluated either way; its TAG is only read when
/// something chooses on it.
fn matched_reg(mut cx: LowerCx, e: ExprId, subject: ExprId, arms: List<Arm>) -> Reg {
    if arms.is_empty() {
        cx.defect("a `match` without arms survived typing")
        return cx.result(e)
    }
    let v = cx.reg_of(subject)
    let vty = cx.type_at(subject)
    if cx.facts.has_null_tail(e) { return matched_with_default(cx, e, subject, v, vty, arms) }
    if arms.length == 1 { return arm_reg(cx, v, vty, arms[0], cx.type_at(e)) }
    let declared: EnumSig? = cx.variants_at(subject)
    if declared != null && switchable(cx, arms, arms.length - 1) {
        return switched_reg(cx, e, v, vty, declared!, arms)
    }
    chained_reg(cx, e, v, vty, arms, 0)
}

/// A trailing-arms-sugar match's uncovered variants: no arm is the
/// unconditional default (there may be none written for the tag that
/// arrives), so every WRITTEN arm is its own case and the tail
/// answers `want`'s own absence — `absent_of`, the NULLABLE type's
/// own absent value (its repr's flag or niche), never `hollow_of`'s
/// don't-care bits: this value is actually READ, unlike a leaving
/// arm's.
fn matched_with_default(
    mut cx: LowerCx,
    e: ExprId,
    subject: ExprId,
    v: Reg,
    vty: TypeId,
    arms: List<Arm>,
) -> Reg {
    let want = cx.type_at(e)
    let declared: EnumSig? = cx.variants_at(subject)
    if declared != null && switchable(cx, arms, arms.length) {
        return switched_reg_with_default(cx, e, v, vty, declared!, arms, want)
    }
    chained_reg_with_default(cx, v, vty, arms, 0, want)
}

/// Every arm but the last tests ONE variant whole: the jump table.
fn switchable(cx: LowerCx, arms: List<Arm>, count: int) -> bool {
    for j in 0..count {
        if whole_test(cx, arms[j]) == null { return false }
    }
    true
}

/// The one variant an arm tests whole, when that is all it does. A
/// guarded arm never qualifies — its acceptance depends on a value no
/// jump table can read, so it falls to the chain.
fn whole_test(cx: LowerCx, a: Arm) -> string? {
    if a.guard != null || a.pats.length != 1 { return null }
    match cx.view.store.pat(a.pats[0]) {
        .Variant(name, args) if all_irrefutable(cx.view.store, cx.names, args) -> name.of,
        .Variant(_, _) or .Wild or .Rest or .Bind(_) or .Lit(_) or .Format(_, _) or .Quote(_) -> null,
    }
}

/// The jump table: every arm but the last is a CASE on its tag; the
/// last is the default.
fn switched_reg(mut cx: LowerCx, e: ExprId, v: Reg, vty: TypeId, sig: EnumSig, arms: List<Arm>) -> Reg {
    let want = cx.type_at(e)
    let last_arm = arms.length - 1
    let cases = arm_cases(cx, sig, arms, last_arm)
    if cases.length != last_arm { return short_cases(cx, e) }
    cx.emit(Ins.SwitchStart(cx.tag_of(v), cases))
    for j, a in arms {
        if j < last_arm { cx.arm_end(arm_reg(cx, v, vty, a, want)) }
    }
    let last = arm_reg(cx, v, vty, arms[last_arm], want)
    cx.close_region(e, last)
}

/// The jump table's twin for an implicit tail: EVERY written arm is
/// a case (none is exempted as "the last, taken unconditionally"),
/// and the tag that matches none of them answers the tail's `want`
/// absent.
fn switched_reg_with_default(
    mut cx: LowerCx,
    e: ExprId,
    v: Reg,
    vty: TypeId,
    sig: EnumSig,
    arms: List<Arm>,
    want: TypeId,
) -> Reg {
    let cases = arm_cases(cx, sig, arms, arms.length)
    if cases.length != arms.length { return short_cases(cx, e) }
    cx.emit(Ins.SwitchStart(cx.tag_of(v), cases))
    for a in arms { cx.arm_end(arm_reg(cx, v, vty, a, want)) }
    cx.close_region(e, tail_reg(cx, want))
}

/// What an implicit tail answers: `false` at a predicate's seat, the
/// nullable's own absence anywhere else.
fn tail_reg(mut cx: LowerCx, want: TypeId) -> Reg {
    if cx.view.types.seen_shape(want) is .Bool { cx.const_bool(false) } else { cx.absent_of(want) }
}

/// `arm_cases` answering short of what it was asked for — an arm
/// naming no variant, which typing refused — spoken once for both
/// jump tables.
fn short_cases(mut cx: LowerCx, e: ExprId) -> Reg {
    cx.defect("an arm naming no variant survived typing")
    cx.result(e)
}

/// The first `count` arms' selector values, in arm order. A SHORT
/// answer means an arm named no variant, which typing refused.
fn arm_cases(cx: LowerCx, sig: EnumSig, arms: List<Arm>, count: int) -> List<int> {
    mut cases: List<int> = []
    for j, a in arms {
        let name: string? = whole_test(cx, a)
        let which: int? = if name == null { null } else { sig.tag_of(name!) }
        if j < count && which != null { cases.push(which!) }
    }
    cases
}

/// THE CHAIN: arm k tests, answers inside its region when it
/// accepts, and the rest of the arms are its else — the last arm
/// answers unconditionally (coverage proved it).
fn chained_reg(mut cx: LowerCx, e: ExprId, v: Reg, vty: TypeId, arms: List<Arm>, k: int) -> Reg {
    let a = arms[k]
    let want = cx.type_at(e)
    if k == arms.length - 1 { return arm_reg(cx, v, vty, a, want) }
    cx
        .region_as(accepts_reg(cx, v, vty, a), want) { cx -> arm_reg(cx, v, vty, a, want) } else { cx -> chained_reg(cx, e, v, vty, arms, k + 1) }
}

/// The chain's twin for an implicit tail: arm k tests, same as the
/// chain, but NONE answers unconditionally — a subject none of the
/// written arms accepted falls past the last one to `want`'s own
/// absence.
fn chained_reg_with_default(
    mut cx: LowerCx,
    v: Reg,
    vty: TypeId,
    arms: List<Arm>,
    k: int,
    want: TypeId,
) -> Reg {
    if k == arms.length { return tail_reg(cx, want) }
    let a = arms[k]
    cx
        .region_as(accepts_reg(cx, v, vty, a), want) { cx -> arm_reg(cx, v, vty, a, want) } else { cx -> chained_reg_with_default(cx, v, vty, arms, k + 1, want) }
}

/// One arm taken: its binds read from the subject (inside the arm's
/// region, so an untaken arm's payloads are never read), then its
/// value.
fn arm_reg(mut cx: LowerCx, v: Reg, vty: TypeId, a: Arm, want: TypeId) -> Reg {
    let regs: List<Reg> = if a.pats.length == 1 { pat_binds_of(cx, a.pats[0], v, vty) } else { or_binds_regs(cx, v, vty, a) }
    cx.bind_patterns(a.value, regs)
    cx.arm_yield(a.value, cx.reg_of(a.value), want)
}

/// An `or` arm's binds: a cell per name the first alternative binds,
/// filled by whichever alternative took the value — each read under
/// its own test, since each variant lays its payloads out its own way
/// — then read out in the first alternative's order.
fn or_binds_regs(mut cx: LowerCx, v: Reg, vty: TypeId, a: Arm) -> List<Reg> {
    let names = [b.name for b in binders(cx.view.store, cx.names, a.pats[0])]
    if names.is_empty() { return [] }
    let types? = spoken_types(cx, a.value, names.length) else {
        cx.defect("an `or` arm's binds reached lowering without their types")
        return []
    }
    let cells = [cx.seeded_cell(ty, cx.hollow_of(ty)) for ty in types]
    or_filled(cx, v, vty, a.pats, 0, names, cells)
    [cx.loaded_as(types[j], c) for j, c in cells]
}

/// The types typing spoke for an arm's `n` binds, or null when any is
/// missing — which a clean program never is.
fn spoken_types(cx: LowerCx, v: ExprId, n: int) -> List<TypeId>? {
    let tys = [cx.bind_type(v, j) for j in 0..n]
    if tys.any(it == null) { return null }
    [ty! for ty in tys]
}

/// Alternative `k` onward: the first that accepts writes its binds.
/// The last is taken unconditionally — the arm already accepted.
fn or_filled(
    mut cx: LowerCx,
    v: Reg,
    vty: TypeId,
    pats: List<PatId>,
    k: int,
    names: List<string>,
    cells: List<Reg>,
) {
    let took = pat_accepts_of(cx, pats[k], v, vty)
    if k == pats.length - 1 { return stored_binds(cx, pats[k], v, vty, names, cells) }
    cx
        .void_branches(took) { cx -> stored_binds(cx, pats[k], v, vty, names, cells) } else { cx -> or_filled(cx, v, vty, pats, k + 1, names, cells) }
}

/// One alternative's binds, each written into the cell of its name.
fn stored_binds(
    mut cx: LowerCx,
    p: PatId,
    v: Reg,
    vty: TypeId,
    names: List<string>,
    cells: List<Reg>,
) {
    let regs = pat_binds_of(cx, p, v, vty)
    let own = [b.name for b in binders(cx.view.store, cx.names, p)]
    for j, n in names { cx.stored(cells[j], regs[own.index_of(n)]) }
}

/// The registers an arm's binds read, in pattern order — each
/// payload read at its path.
/// THE SEAM, lowering's half: a nested pattern is accepted and
/// bound by ITS OWNER. The recursion travels through here, which is
/// what lets one feature's pattern sit inside another's.
export fn pat_accepts_of(mut cx: LowerCx, p: PatId, v: Reg, vty: TypeId) -> Reg {
    pat_semantics_of(cx.dispatch, cx.view.store.pat(p)).pat_accepts(cx, p, v, vty)
}

export fn pat_binds_of(mut cx: LowerCx, p: PatId, v: Reg, vty: TypeId) -> List<Reg> {
    pat_semantics_of(cx.dispatch, cx.view.store.pat(p)).pat_binds(cx, p, v, vty)
}

export fn bind_regs(mut cx: LowerCx, p: PatId, v: Reg, vty: TypeId) -> List<Reg> {
    match cx.view.store.pat(p) {
        // a name that compares to a const binds nothing
        .Bind(_) -> if cx.names.compared(cx.view.store, p) == null { [v] } else { [] },
        .Variant(name, args) -> payload_binds(cx, name.of, args, v, vty),
        .Format(_, _) -> {
            cx.defect("a format pattern reached the enum lowering's binds")
            []
        },
        .Quote(_) -> {
            cx.defect("a quote pattern reached the enum lowering's binds")
            []
        },
        .Wild or .Rest or .Lit(_) -> [],
    }
}

/// Whether a sub-pattern LOOKS at its payload: a name binds it, a
/// nested variant tests inside it. A wildcard and a literal never
/// look — and reading a payload nothing looks at is how an arm over
/// a SHORTER variant read past its end.
fn looks_inside(cx: LowerCx, p: PatId) -> bool {
    match cx.view.store.pat(p) {
        .Bind(_) or .Variant(_, _) or .Format(_, _) or .Quote(_) -> true,
        .Wild or .Rest or .Lit(_) -> false,
    }
}

fn payload_binds(mut cx: LowerCx, name: string, args: List<PatId>, v: Reg, vty: TypeId) -> List<Reg> {
    let declared? = cx.variants_of(vty) else { return [] }
    let carried = declared.payloads_of(name)
    mut out: List<Reg> = []
    // LICENSED loops.push_loop: the payload reads must be EMITTED in pattern order — a fold, not a map
    for k, a in args {
        if k < carried.length && looks_inside(cx, a) {
            out = out.concat(pat_binds_of(cx, a, cx.payload_at(v, k, carried), carried[k]))
        }
    }
    out
}

/// Whether the arm accepts the subject: any alternative does —
/// `a || b` as the lazy region, so a later alternative is tested
/// only when the earlier ones refused — AND, when the arm carries
/// one, its guard: read only once a pattern already accepted, so an
/// untaken arm's payloads are never read to evaluate it.
fn accepts_reg(mut cx: LowerCx, v: Reg, vty: TypeId, a: Arm) -> Reg {
    mut acc = pat_accepts_of(cx, a.pats[0], v, vty)
    mut j = 1
    while j < a.pats.length {
        let p = a.pats[j]
        acc = cx
            .region_as(acc, cx.type(bool)) { cx -> cx.const_bool(true) } else { cx -> pat_accepts_of(cx, p, v, vty) }
        j = j + 1
    }
    let g? = a.guard else { return acc }
    cx
        .region_as(acc, cx.type(bool)) { cx -> guard_reg(cx, v, vty, a, g) } else { cx -> cx.const_bool(false) }
}

/// The guard itself, once its arm's pattern already accepted — its
/// binds read fresh, here, so the guard sees them and an untaken
/// arm's payloads are never touched.
fn guard_reg(mut cx: LowerCx, v: Reg, vty: TypeId, a: Arm, g: ExprId) -> Reg {
    let regs: List<Reg> = if a.pats.length == 1 { pat_binds_of(cx, a.pats[0], v, vty) } else { [] }
    cx.bind_patterns(a.value, regs)
    cx.reg_of(g)
}

/// Whether one pattern accepts the value: a hole or a name always;
/// a literal when equal; a variant when the tag agrees AND its
/// payload patterns accept — read only under the tag test, so a
/// missing payload is never touched.
export fn pat_reg(mut cx: LowerCx, p: PatId, v: Reg, vty: TypeId) -> Reg {
    match cx.view.store.pat(p) {
        .Wild or .Rest -> cx.const_bool(true),
        .Bind(_) -> named_pat_reg(cx, p, v, vty),
        .Lit(lit) -> literal_pat_reg(cx, lit, v, vty),
        .Variant(name, args) -> variant_reg(cx, name.of, args, v, vty),
        .Format(_, _) -> {
            cx.defect("a format pattern reached the enum lowering's test")
            cx.const_bool(false)
        },
        .Quote(_) -> {
            cx.defect("a quote pattern reached the enum lowering's test")
            cx.const_bool(false)
        },
    }
}

/// A LITERAL PATTERN: `null` asks the subject's own PRESENCE,
/// directly — never through equality. `null_reg`'s register has no
/// repr of its own ("the ADOPTING edge gives it one"), and a bare
/// `null` pattern is never adopted, so comparing it by VALUE reads a
/// TAGGED subject's spare tag against an unrelated zero. Any other
/// literal still compares by value.
/// A bare name: a const's compares as a literal does; any other binds
/// and accepts whatever arrives.
fn named_pat_reg(mut cx: LowerCx, p: PatId, v: Reg, vty: TypeId) -> Reg {
    let read? = cx.names.compared(cx.view.store, p) else { return cx.const_bool(true) }
    literal_pat_reg(cx, read, v, vty)
}

fn literal_pat_reg(mut cx: LowerCx, lit: ExprId, v: Reg, vty: TypeId) -> Reg {
    if cx.view.store.null_literal(lit) { return cx.un(cx.presence_of(v, vty)) }
    cx.same_value(v, cx.reg_of(lit), vty)
}

fn variant_reg(mut cx: LowerCx, name: string, args: List<PatId>, v: Reg, vty: TypeId) -> Reg {
    let declared: EnumSig? = cx.variants_of(vty)
    let which: int? = declared?.tag_of(name)
    if which == null {
        cx.defect("a variant pattern without its enum survived typing")
        return cx.const_bool(false)
    }
    let tagged = cx.bin(Type.Bool, BinOp.Eq, cx.tag_of(v), cx.const_int(which!))
    if all_irrefutable(cx.view.store, cx.names, args) { return tagged }
    let carried = declared!.payloads_of(name)
    cx
        .region_as(tagged, cx.type(bool)) { cx -> payloads_reg(cx, carried, args, v) } else { cx -> cx.const_bool(false) }
}

/// Every payload pattern accepts its payload — `a && b` as the lazy
/// region, so a later payload is read only when the earlier ones
/// accepted.
fn payloads_reg(mut cx: LowerCx, carried: List<TypeId>, args: List<PatId>, v: Reg) -> Reg {
    mut acc = cx.const_bool(true)
    for k, a in args {
        if k < carried.length {
            acc = cx
                .region_as(acc, cx.type(bool)) { cx -> pat_accepts_of(cx, a, cx.payload_at(v, k, carried), carried[k]) } else { cx -> cx.const_bool(false) }
        }
    }
    acc
}

/// `.name(args)` — the tagged value of the enum typing chose.
fn literal_reg(mut cx: LowerCx, e: ExprId, name: string, args: List<ExprId>) -> Reg {
    let sig: EnumSig? = cx.variants_at(e)
    let which? = sig?.tag_of(name) else { return cx.lower_defect(e, "a variant literal without its enum survived typing") }
    let carried = [cx.reg_of(a) for a in args]
    cx.tagged_value(cx.shape_at(e), which, carried)
}
