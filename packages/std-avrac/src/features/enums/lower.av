//! The lowering rule — the ONE meaning: an enum value is a slot
//! array carrying its TAG at slot 0, and a `match` is ONE N-arm
//! region over that tag — a jump table natively, not a walk down a
//! chain of comparisons. Exhaustiveness makes the last arm the
//! region's default, so nothing falls through.
use core.{ExprId, Reg, Ins, TypeId, Type, BinOp}
use features.{LowerCx, EnumSig, tag_of, payload_of, foreign_node}

fn enums_reg(cx: LowerCx, e: ExprId) -> Reg {
    // LICENSED I22: a feature cannot enumerate OTHER features' variants
    match cx.view.store.expr(e) {
        .Match(subject, variants, binds, values) -> matched_reg(cx, e, subject, variants, binds, values),
        .Is(subject, variant) -> asked_reg(cx, e, subject, variant),
        _ -> foreign_node(cx, e),
    }
}


/// `subject is .variant`: the tag read once, compared to the
/// variant's ordinal — one instruction, no region.
fn asked_reg(cx: LowerCx, e: ExprId, subject: ExprId, variant: string) -> Reg {
    let declared: EnumSig? = cx.variants_at(subject)
    let which: int? = if declared == null { null } else { declared!.tag_of(variant) }
    if which == null {
        cx.defect("an `is` without an enum variant survived typing")
        return cx.result(e)
    }
    let tag = tag_of(cx, cx.reg_of(subject))
    let k = cx.mint_shape(Type.Int)
    cx.emit(Ins.ConstInt(k, which!))
    let dst = cx.result(e)
    cx.emit(Ins.Bin(dst, BinOp.Eq, tag, k))
    dst
}

fn matched_reg(cx: LowerCx, e: ExprId, subject: ExprId, variants: List<string>,
               binds: List<string>, values: List<ExprId>) -> Reg {
    let declared: EnumSig? = cx.variants_at(subject)
    if declared == null || values.is_empty() {
        cx.defect("a `match` without an enum subject survived typing")
        return cx.result(e)
    }
    // The subject is evaluated either way; its TAG is only read
    // when something chooses on it.
    let sig = declared!
    let v = cx.reg_of(subject)
    if values.length == 1 { return arm_reg(cx, sig, v, variants[0], binds[0], values[0]) }
    // Every arm but the last is a CASE; the last is the default.
    let last_arm = values.length - 1
    let cases = arm_cases(sig, variants, last_arm)
    if cases.length != last_arm {
        cx.defect("an arm naming no variant survived typing")
        return cx.result(e)
    }
    let tag = tag_of(cx, v)
    cx.emit(Ins.SwitchStart(tag, cases))
    for (j, av) in values.enumerate() {
        if j < last_arm { cx.emit(Ins.ArmEnd(arm_reg(cx, sig, v, variants[j], binds[j], av))) }
    }
    let last = arm_reg(cx, sig, v, variants[last_arm], binds[last_arm], values[last_arm])
    let dst = cx.result(e)
    cx.emit(Ins.RegionEnd(dst, last))
    dst
}

/// One arm: its bind, then its value — in that order, so a name
/// inside the value finds the payload.
fn arm_reg(cx: LowerCx, sig: EnumSig, subject: Reg, variant: string,
           bind: string, value: ExprId) -> Reg {
    bind_arm(cx, sig, subject, variant, bind, value)
    cx.reg_of(value)
}

/// The first `count` arms' selector values, in arm order — the last
/// arm is the region's default and needs none. A SHORT answer means
/// an arm named no variant, which typing already refuses.
fn arm_cases(sig: EnumSig, variants: List<string>, count: int) -> List<int> {
    mut cases: List<int> = []
    for (j, v) in variants.enumerate() {
        let which: int? = sig.tag_of(v)
        if j < count && which != null { cases.push(which!) }
    }
    cases
}

/// The bind reads slot 1 of the subject — emitted INSIDE the arm's
/// region, so the payload is only read when that arm is taken.
/// A variant carrying nothing binds nothing: typing refused it.
fn bind_arm(cx: LowerCx, sig: EnumSig, subject: Reg, variant: string, bind: string, value: ExprId) {
    if bind == "" { return }
    let carried: TypeId? = sig.payload_of(variant)
    if carried == null { return }
    cx.bind_pattern(value, payload_of(cx, subject, carried!))
}

