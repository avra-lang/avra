//! Parse-time lowering: captures -> the EnumDecl statement and the
//! Match node. Variant names and arm values arrive as parallel
//! capture lists and zip.
use core.{Expr, Stmt}
use features.{LangNode, Builder, zip_defect}

fn build_enum_decl(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let vs = b.tokens(1)?
    b.make_stmt(Stmt.EnumDecl(n.text, [v.text for v in vs]))
}

fn build_match(b: Builder) -> Result<LangNode, string> {
    let subject = b.expr(0)?
    let vn = b.tokens(1)?
    let av = b.exprs(2)?
    if vn.length != av.length { return Result.Err(zip_defect()) }
    b.make_expr(Expr.Match(subject, [v.text for v in vn], av))
}
