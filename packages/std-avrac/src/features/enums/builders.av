//! Parse-time lowering: captures -> the EnumDecl statement, the
//! Match node with its arms, and the pattern nodes. Arms and
//! values ZIP (both are written every time); a declaration's
//! payloads cannot, because they are optional — spans restore the
//! truth: a payload belongs to the variant whose name precedes it
//! and whose successor follows it, and a payload's NAME, when
//! written, precedes its type inside that window.
use core.{Expr, Stmt, Param, Pat, Variant, TypeRef, plain_mark}
use features.{LangNode, Builder, window_end, pat_ids_at, arms_at, ref_within, within}
use grammar.{Token}

fn build_enum_decl(mut b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let tp = b.tokens(1)?
    let ends: int? = b.span_end()
    if ends == null { return .Err("defect: an enum declaration without a span — the arena and the grammar disagree") }
    let vs = b.tokens(2)?
    let names = b.tokens(4)?
    let tys = b.type_refs(5)?
    mut variants: List<Variant> = []
    for j, v in vs {
        let upto = window_end(vs, j, ends!)
        variants.push(Variant { name: v.text, payloads: payloads_between(names, tys, v.span.lo, upto), span: v.span })
    }
    b.make_stmt(Stmt.EnumDecl(n.text, [t.text for t in tp], variants))
}

/// One variant's payloads: the types inside its window, each named
/// by the field name written just before it, or "" when positional.
fn payloads_between(names: List<Token>, tys: List<TypeRef>, after: int, before: int) -> List<Param> {
    [Param { name: name_before(names, t, after), ty: t, default: null, mark: plain_mark, span: t.span } for t in tys if ref_within(t, after, before)]
}

/// The field name written between the variant's name and this
/// payload type, when one was.
fn name_before(names: List<Token>, t: TypeRef, after: int) -> string {
    let lo: int = t.span?.lo ?? after
    mut best = ""
    for n in names {
        if within(n.span.lo, after, lo) { best = n.text }
    }
    best
}

fn build_match(mut b: Builder) -> Result<LangNode, string> {
    let subject = b.expr(0)?
    b.make_expr(Expr.Match(subject, arms_at(b.args, 1)))
}

fn build_arm(b: Builder) -> Result<LangNode, string> {
    let value = b.expr(1)?
    b.make_arm(pat_ids_at(b.args, 0), value)
}

/// A template's hole standing as a whole arm: the one hole as the
/// arm's pattern and its value, so the walk that classifies holes
/// reads it as an ARM seat.
fn build_hole_arm(mut b: Builder) -> Result<LangNode, string> {
    let h = b.token(0)?
    let value = b.expr_node(Expr.Ident(h.text))
    b.make_arm([b.store.alloc_pat(Pat.Bind(h.text), b.span)], value)
}

fn build_variant_pat(mut b: Builder) -> Result<LangNode, string> {
    let name = b.token(0)?
    b.make_pat(Pat.Variant(name.text, pat_ids_at(b.args, 1)))
}

fn build_wild_pat(mut b: Builder) -> Result<LangNode, string> {
    b.make_pat(Pat.Wild)
}

/// A bare name binds — except `rest`, the spec's deliberate
/// remainder, which binds nothing and answers the lint.
fn build_bind_pat(mut b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    if n.text == "rest" { return b.make_pat(Pat.Rest) }
    b.make_pat(Pat.Bind(n.text))
}

fn build_str_pat(mut b: Builder) -> Result<LangNode, string> {
    let t = b.token(0)?
    b.make_pat(Pat.Lit(b.store.alloc_expr(Expr.StrLit(t.text), b.span)))
}

fn build_num_pat(mut b: Builder) -> Result<LangNode, string> {
    let t = b.token(0)?
    b.make_pat(Pat.Lit(b.store.alloc_expr(Expr.IntLit(t.int_value() ?? 0), b.span)))
}

fn build_true_pat(mut b: Builder) -> Result<LangNode, string> {
    b.make_pat(Pat.Lit(b.store.alloc_expr(Expr.BoolLit(true), b.span)))
}

fn build_false_pat(mut b: Builder) -> Result<LangNode, string> {
    b.make_pat(Pat.Lit(b.store.alloc_expr(Expr.BoolLit(false), b.span)))
}

/// `.name(args)` — the variant the expected type will name.
fn build_variant_lit(mut b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    b.make_expr(Expr.VariantLit(n.text, b.exprs(1)?))
}
