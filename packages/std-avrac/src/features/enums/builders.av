//! Parse-time lowering: captures -> the EnumDecl statement, the
//! Match node, and a carrying variant's construction. Arm names and
//! values ZIP (both are written every time); a declaration's
//! payloads cannot, because they are optional — see below.
use core.{Expr, ExprId, Stmt, Param, some_list}
use features.{LangNode, Builder, expr_id_at, zip_defect}
use grammar.{Token}

/// A variant's payload is POSITIONAL (the spec's style rule: the
/// type IS the field for a single-value wrapper), so nothing the
/// source wrote is dropped on the way into the node.
///
/// Names and their OPTIONAL payload arrive as parallel captures that
/// do NOT align: a repetition accumulates only the payloads that
/// were written, so index j means nothing. Spans restore the truth —
/// a payload belongs to the variant whose name precedes it and whose
/// successor follows it.
fn build_enum_decl(b: Builder) -> Result<LangNode, string> {
    let n = b.token(0)?
    let ends: int? = b.span_end()
    if ends == null { return Result.Err("an enum declaration without a span") }
    let vs = b.tokens(1)?
    let tys = aligned(vs, b.tokens(2)?, ends!)
    mut variants: List<Param> = []
    for (j, v) in vs.enumerate() { variants.push(Param { name: v.text, ty: tys[j] }) }
    b.make_stmt(Stmt.EnumDecl(n.text, variants))
}

/// THE alignment law for a capture a repetition may SKIP: each
/// anchor's one optional token, in anchor order. An anchor's window
/// runs to the next anchor, or to the construct's end.
fn aligned(anchors: List<Token>, optional: List<Token>, ends: int) -> List<string> {
    mut found: List<string> = []
    for (j, a) in anchors.enumerate() {
        let upto = if j + 1 < anchors.length { anchors[j + 1].span.lo } else { ends }
        found.push(token_between(optional, a.span.lo, upto))
    }
    found
}

/// The one optional token written between two anchors, or "" — an
/// empty answer is the absence itself: no payload, no bind.
fn token_between(tokens: List<Token>, after: int, before: int) -> string {
    let hit: Token? = tokens.find(it.span.lo > after && it.span.lo < before)
    if hit == null { return "" }
    hit!.text
}

/// The argument is OPTIONAL in the grammar so the parse stays
/// generous and typing can say precisely what is missing.
fn build_variant_lit(b: Builder) -> Result<LangNode, string> {
    let t = b.token(0)?
    let v = b.token(1)?
    let arg: ExprId? = expr_id_at(b.args, 2)
    b.make_expr(Expr.VariantLit(t.text, v.text, some_list(arg)))
}

/// Arm names and values ZIP; a BIND is optional, so it aligns by
/// span like a declaration's payload does.
fn build_match(b: Builder) -> Result<LangNode, string> {
    let subject = b.expr(0)?
    let vn = b.tokens(1)?
    let av = b.exprs(3)?
    let ends: int? = b.span_end()
    if vn.length != av.length { return Result.Err(zip_defect()) }
    if ends == null { return Result.Err("a match without a span") }
    b.make_expr(Expr.Match(subject, [v.text for v in vn], aligned(vn, b.tokens(2)?, ends!), av))
}
