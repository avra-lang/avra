//! The formatter's idioms for this feature — `rule`s, found by
//! directory like everything else this feature owns.
use features.{Code, Fix}
use diagnostics.{warning}

/// A `match` answering only true/false, one arm a bare variant and
/// the other the wildcard, is `is` — `x is .Ready`. THE ONE MATCH
/// THAT STAYS: an `or`-run on the untested side (`.Narrow or .Ptr ->
/// false`) spells a REGISTRY's remaining variants by NAME, so folding
/// it to a boolean forgets the next one exactly as a catch-all
/// would — the pattern's own WILDCARD seat (`_`, never an `or`-run)
/// refuses that shape structurally, before any guard is asked.
@keeps("match k { .Wide -> true, .Narrow or .Ptr -> false }")
@keeps("match n { 1 -> true, _ -> false }")
export rule bool_variant_match {
    quote { match ${e} { .${v} -> true, _ -> false } } -> bool_variant_match_found(e, v, true),
}

/// The arms-swapped twin: the bare variant answers `false`, the
/// wildcard `true` — `!(x is .Ready)`.
@keeps("match k { .Wide -> false, .Narrow or .Ptr -> true }")
export rule bool_variant_match_negated {
    quote { match ${e} { .${v} -> false, _ -> true } } -> bool_variant_match_found(e, v, false),
}

fn bool_variant_match_found(e: Code, v: string, positive: bool) -> Fix {
    let form = if positive { "${e.text()} is .${v}" } else { "!(${e.text()} is .${v})" }
    Fix.Say(warning("style.bool_variant_match", e.loc(), "a `match` answering only true/false is `${form}`", "this match", null))
}
