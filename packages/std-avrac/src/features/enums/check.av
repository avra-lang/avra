//! The enum laws: a declaration names at least one variant; a
//! `match` chooses by patterns that fit the subject, COVERS it —
//! every variant whole, or a catch-all — and its arms agree on one
//! type. Coverage is the point: adding a variant breaks every match
//! that spelled them, and a hole that hides several is warned.
use core.{ExprId, StmtId, Type, TypeId, Arm, PatId, Variant, joined, filled}
use features.{TypeCx, EnumSig, spoken, this_is, nothing, duplicate_names, arms_agree, variants_are, types_disagree, seats_fit, stays}
use features.enums.{all_irrefutable, hole_of}
use diagnostics.{refusal, warning}

/// The declaration's own law.
export fn check_enum_decl(mut cx: TypeCx, s: StmtId) {
    match cx.view.store.stmt(s) {
        .EnumDecl(name, _, variants) -> decl_checks(cx, s, name, variants),
        _ -> nothing(),
    }
}

/// An enum names at least one variant, each of them once. A dup is
/// a name whose FIRST position is earlier than this one.
fn decl_checks(mut cx: TypeCx, s: StmtId, name: string, variants: List<Variant>) {
    if variants.is_empty() { no_variants(cx, s, name) }
    for d in duplicate_names("type.enum_decl", name, [v.name for v in variants], cx.stmt_loc(s)) {
        cx.emit(d)
    }
}

fn enums_type(mut cx: TypeCx, e: ExprId) -> TypeId {
    // LICENSED I22: a feature cannot enumerate OTHER features' variants
    match cx.view.store.expr(e) {
        .Match(subject, arms) -> matched_type(cx, e, subject, arms),
        .Is(subject, variant) -> asked_type(cx, e, subject, variant),
        .VariantLit(name, args) -> literal_type(cx, e, name, args),
        _ -> cx.error_type,
    }
}

/// `subject is .variant` — the subject is an enum that names the
/// variant; the answer is a bool either way once the subject is.
fn asked_type(mut cx: TypeCx, e: ExprId, subject: ExprId, variant: string) -> TypeId {
    let sh: Type = cx.shape_at(subject)
    if sh is .Error { return cx.error_type }
    let declared: EnumSig? = cx.variants_of(cx.type_at(subject))
    if declared == null { return not_askable(cx, subject) }
    if declared!.tag_of(variant) == null { no_variant_asked(cx, e, cx.name_at(subject), variant, declared!) }
    cx.view.types.intern(Type.Bool)
}

/// THE LITERAL LAW: `.name(args)` is the variant of the enum the
/// site EXPECTS — the want names the enum (a Result's sides
/// included), the variant must be its, and it takes exactly its
/// payloads, each accepted; the answer is the want itself.
fn literal_type(mut cx: TypeCx, e: ExprId, name: string, args: List<ExprId>) -> TypeId {
    let wanted: TypeId? = cx.want_at(e)
    if wanted == null { return unfed_literal(cx, e, name) }
    let want = cx.view.types.carried(wanted!) ?? wanted!
    let declared: EnumSig? = cx.variants_of(want)
    if declared == null { return unenumerated_want(cx, e, name, want) }
    let sig = declared!
    if sig.tag_of(name) == null { return no_variant_wanted(cx, e, cx.view.types.name_of(want), name, sig) }
    if !seats_fit(cx, e, ".${name}", args, sig.payloads_of(name)) { return cx.error_type }
    want
}

/// No want yet: the literal goes hungry for the door to feed it,
/// and speaks only when the walk ends and it is still starving.
fn unfed_literal(mut cx: TypeCx, e: ExprId, name: string) -> TypeId {
    if cx.starving { return unwanted_literal(cx, e, name) }
    cx.go_hungry(e)
    cx.error_type
}

/// THE MATCH LAW: every arm's patterns fit the subject; each arm's
/// binds are spoken (from its first pattern) before its value is
/// walked; the arms COVER the subject — every variant fully, or a
/// catch-all — and agree on one type.
fn matched_type(mut cx: TypeCx, e: ExprId, subject: ExprId, arms: List<Arm>) -> TypeId {
    let sh: Type = cx.shape_at(subject)
    if sh is .Error { return cx.error_type }
    let subject_ty = cx.type_at(subject)
    if cx.variants_of(subject_ty) == null && arms.any(tests_variant(cx, it)) { return not_matchable(cx, subject) }
    for a in arms { arm_checks(cx, subject_ty, a) }
    // The arms are hidden from the walk, so type them HERE — their
    // binds are spoken above, in time for the names inside.
    for a in arms { let _ = cx.walk_type(a.value) }
    coverage_checks(cx, e, subject, subject_ty, arms)
    arms_type(cx, [a.value for a in arms])
}

/// One arm: each alternative fits the subject; the binds come from
/// the first pattern, and an `or` arm may bind nothing.
fn arm_checks(mut cx: TypeCx, subject_ty: TypeId, a: Arm) {
    let typed = [pat_types(cx, p, subject_ty) for p in a.pats]
    let first: List<TypeId> = typed.first() ?? []
    if a.pats.length > 1 && typed.any(!it.is_empty()) {
        or_binds(cx, a.value)
        return cx.bind_types(a.value, [])
    }
    cx.bind_types(a.value, first)
}

/// A pattern against the type it must accept, answering the types
/// of the names it binds, in pre-order. A variant test names a
/// variant of the enum and takes exactly its payloads, each
/// pattern against its payload; a literal's type agrees; a name
/// binds the value at its path.
fn pat_types(mut cx: TypeCx, p: PatId, expected: TypeId) -> List<TypeId> {
    match cx.view.store.pat(p) {
        .Wild or .Rest -> [],
        .Bind(_) -> [expected],
        .Variant(name, args) -> variant_types(cx, p, name, args, expected),
        .Lit(v) -> lit_types(cx, p, v, expected),
    }
}

fn variant_types(mut cx: TypeCx, p: PatId, name: string, args: List<PatId>, expected: TypeId) -> List<TypeId> {
    let declared: EnumSig? = cx.variants_of(expected)
    if declared == null { return not_variant_shaped(cx, p, name, expected) }
    let sig = declared!
    if sig.tag_of(name) == null { return unknown_arm(cx, p, cx.view.types.name_of(expected), name, sig) }
    let carried = sig.payloads_of(name)
    if carried.is_empty() && !args.is_empty() { return nothing_to_bind(cx, p, cx.view.types.name_of(expected), name) }
    // a bare `.V` accepts the variant whole, payloads unread
    if args.is_empty() { return [] }
    if carried.length != args.length { return pattern_arity(cx, p, name, carried.length, args.length) }
    mut out: List<TypeId> = []
    // LICENSED I3: the binds must be SPOKEN in pattern order — a fold, not a map
    for (k, a) in args.enumerate() { out = out.concat(pat_types(cx, a, carried[k])) }
    out
}

/// A literal in a pattern is typed like any literal, then judged
/// against the subject: a string never matches an int.
fn lit_types(mut cx: TypeCx, p: PatId, v: ExprId, expected: TypeId) -> List<TypeId> {
    let got = cx.walk_type(v)
    if types_disagree(cx, got, expected) { literal_mismatch(cx, p, got, expected) }
    []
}

/// THE COVERAGE LAW: arms are tried in order, so the subject is
/// covered when a catch-all arrives or when the arms' patterns,
/// taken together, accept every value — judged column by column
/// over the payloads, so nested arms that split a variant between
/// them cover it. A variant accepted whole twice is a repeat. A
/// catch-all that hides more than two variants WARNS — unless it
/// is `rest`, the deliberate remainder.
fn coverage_checks(mut cx: TypeCx, e: ExprId, subject: ExprId, subject_ty: TypeId, arms: List<Arm>) {
    let declared: EnumSig? = cx.variants_of(subject_ty)
    let sname = cx.name_at(subject)
    mut covered: List<string> = []
    mut before: List<PatId> = []
    for a in arms {
        for n in covers(cx, a) {
            if covered.contains(n) { repeated_arm(cx, a.value, n) } else { covered.push(n) }
        }
        let hole: PatId? = hole_of(cx.view.store, a.pats)
        if hole != null {
            if declared != null {
                let sig = declared!
                hidden_checks(cx, hole!, uncovered(cx, before, sig))
            }
            return
        }
        before = before.concat(a.pats)
    }
    if declared == null { return needs_catch_all(cx, e, sname) }
    let sig = declared!
    for n in uncovered(cx, before, sig) { unhandled_variant(cx, e, sname, n) }
}

/// The variants these patterns, as one row each, leave uncovered.
fn uncovered(cx: TypeCx, pats: List<PatId>, sig: EnumSig) -> List<string> {
    let rows = [[p] for p in pats]
    mut out: List<string> = []
    for k, n in sig.names {
        if !covered_variant(cx, rows, sig, k) { out.push(n) }
    }
    out
}

/// A row of patterns against a row of types — one pattern per
/// column, absence standing for `_` (a payload an arm left unread).
type Row = { pats: List<PatId?> }

/// Whether the rows accept every value of the column types:
/// nothing left to test means any row does. In the first column,
/// the rows that test a variant cover it when their payloads,
/// joined to the remaining columns, are covered; every variant no
/// row tests — and a column nothing tests at all — falls to the
/// hole rows over the remaining columns. Each step consumes a
/// written pattern, so a recursive enum terminates.
fn covered(cx: TypeCx, rows: List<Row>, tys: List<TypeId>) -> bool {
    if tys.is_empty() { return !rows.is_empty() }
    let rest = tys.slice(1, tys.length)
    let defaults = [rest_of(r) for r in rows if hole_first(cx, r)]
    let declared: EnumSig? = cx.variants_of(tys[0])
    if declared == null { return covered(cx, defaults, rest) }
    let sig = declared!
    let tested = [n for n in sig.names if tests_first(cx, rows, n)]
    if tested.is_empty() { return covered(cx, defaults, rest) }
    for k, n in sig.names {
        let ok = if tested.contains(n) { covered(cx, specialized(cx, rows, sig, k), sig.payloads[k].concat(rest)) } else { covered(cx, defaults, rest) }
        if !ok { return false }
    }
    true
}

/// Whether some row's first pattern tests this variant.
fn tests_first(cx: TypeCx, rows: List<Row>, name: string) -> bool {
    for r in rows {
        let head: PatId? = r.pats[0]
        if head != null && names_variant(cx, head!, name) { return true }
    }
    false
}

fn names_variant(cx: TypeCx, p: PatId, name: string) -> bool {
    match cx.view.store.pat(p) {
        .Variant(n, _) -> n == name,
        .Wild or .Rest or .Bind(_) or .Lit(_) -> false,
    }
}

/// The rows that test variant K of the first column, each with the
/// variant's payload patterns spread into the columns; a hole in
/// the first column tests every variant, its payloads unread.
fn specialized(cx: TypeCx, rows: List<Row>, sig: EnumSig, k: int) -> List<Row> {
    mut out: List<Row> = []
    // LICENSED I3: two shapes of row join one list
    for r in rows {
        let head: PatId? = r.pats[0]
        if head == null || cx.view.store.irrefutable(head!) {
            out.push(Row { pats: blanks(sig.payloads[k].length).concat(rest_of(r).pats) })
        } else {
            let args: List<PatId?>? = variant_args(cx, head!, sig.names[k], sig.payloads[k].length)
            if args != null { out.push(Row { pats: args!.concat(rest_of(r).pats) }) }
        }
    }
    out
}

/// Whether variant K is covered: the rows testing it, over its
/// payloads alone.
fn covered_variant(cx: TypeCx, rows: List<List<PatId>>, sig: EnumSig, k: int) -> bool {
    let shaped = [Row { pats: [held(p) for p in r] } for r in rows]
    covered(cx, specialized(cx, shaped, sig, k), sig.payloads[k])
}

fn held(p: PatId) -> PatId? {
    p
}

/// The pattern's payload patterns when it tests THIS variant —
/// a bare `.V` reads none — else absence.
fn variant_args(cx: TypeCx, p: PatId, name: string, arity: int) -> List<PatId?>? {
    match cx.view.store.pat(p) {
        .Variant(n, args) -> if n == name { padded(args, arity) } else { null },
        .Wild or .Rest or .Bind(_) or .Lit(_) -> null,
    }
}

/// The written payload patterns, ONE PER PAYLOAD: a bare `.V` reads
/// none, and a miscounted pattern (the arm law refused it) is padded
/// with holes or cut — a row always has one pattern per column.
fn padded(args: List<PatId>, arity: int) -> List<PatId?> {
    let read = if args.length < arity { args.length } else { arity }
    [held(a) for a in args.slice(0, read)].concat(blanks(arity - read))
}

fn blanks(n: int) -> List<PatId?> {
    let holes: List<PatId?> = filled<PatId?>(n, null)
    holes
}

fn hole_first(cx: TypeCx, r: Row) -> bool {
    let head: PatId? = r.pats[0]
    head == null || cx.view.store.irrefutable(head!)
}

fn rest_of(r: Row) -> Row {
    Row { pats: r.pats.slice(1, r.pats.length) }
}

/// Whether any of the arm's alternatives is a variant test.
fn tests_variant(cx: TypeCx, a: Arm) -> bool {
    for p in a.pats {
        if cx.view.store.pat(p) is .Variant { return true }
    }
    false
}

/// The variants an arm accepts WHOLE: each alternative that tests a
/// variant and refuses none of its payloads.
fn covers(cx: TypeCx, a: Arm) -> List<string> {
    mut out: List<string> = []
    for p in a.pats {
        let n: string? = whole_variant(cx, p)
        if n != null { out.push(n!) }
    }
    out
}

/// The variant a pattern accepts whole — a test whose payload
/// patterns are all irrefutable — or absence.
fn whole_variant(cx: TypeCx, p: PatId) -> string? {
    match cx.view.store.pat(p) {
        .Variant(name, args) -> if all_irrefutable(cx.view.store, args) { name } else { null },
        .Wild or .Rest or .Bind(_) or .Lit(_) -> null,
    }
}

/// The hole's lint: the variants it hides are the ones no earlier
/// arm covered; more than two speak, unless it is `rest`.
fn hidden_checks(mut cx: TypeCx, hole: PatId, hidden: List<string>) {
    if cx.view.store.pat(hole) is .Rest { return }
    if hidden.length > 2 { wildcard_hides(cx, hole, hidden) }
}

fn arms_type(mut cx: TypeCx, values: List<ExprId>) -> TypeId {
    let head: ExprId? = values.find(stays(cx, it))
    if head == null { return cx.error_type }
    if cx.shape_at(head!) is .Error { return cx.error_type }
    arms_agree(cx, "type.match", "match", "the first arm", head!, values)
}

// ── The voices ──

fn no_variants(mut cx: TypeCx, s: StmtId, name: string) {
    cx.emit(refusal("type.enum_decl", cx.stmt_loc(s), "`${name}` declares no variants", "this enum is empty", "an enum names at least one variant"))
}

fn not_askable(mut cx: TypeCx, subject: ExprId) -> TypeId {
    let n = cx.name_at(subject)
    spoken(cx, refusal("type.match", cx.loc_of(subject), "`is` asks an enum for its variant, found `${n}`", this_is(n), null))
}

fn no_variant_asked(mut cx: TypeCx, e: ExprId, sname: string, v: string, sig: EnumSig) {
    cx.emit(refusal("type.match", cx.loc_of(e), "`${sname}` has no variant `${v}`", "asked here", variants_are(sig)))
}

fn not_matchable(mut cx: TypeCx, subject: ExprId) -> TypeId {
    let n = cx.name_at(subject)
    spoken(cx, refusal("type.match", cx.loc_of(subject), "`match` chooses over an enum, found `${n}`", this_is(n), null))
}

fn unwanted_literal(mut cx: TypeCx, e: ExprId, name: string) -> TypeId {
    spoken(cx, refusal("type.variant_lit", cx.loc_of(e), "`.${name}` needs a known enum — nothing here says which", "built here", "annotate the binding, return it from a fn that declares the type, or write `Type.${name}`"))
}

fn unenumerated_want(mut cx: TypeCx, e: ExprId, name: string, want: TypeId) -> TypeId {
    let n = cx.view.types.name_of(want)
    spoken(cx, refusal("type.variant_lit", cx.loc_of(e), "`.${name}` builds a variant, and `${n}` has none", this_is(n), null))
}

fn no_variant_wanted(mut cx: TypeCx, e: ExprId, tname: string, name: string, sig: EnumSig) -> TypeId {
    spoken(cx, refusal("type.variant_lit", cx.loc_of(e), "`${tname}` has no variant `${name}`", "built here", variants_are(sig)))
}

fn unknown_arm(mut cx: TypeCx, p: PatId, sname: string, v: string, sig: EnumSig) -> List<TypeId> {
    cx.emit(refusal("type.match", cx.pat_loc(p), "`${sname}` has no variant `${v}`", "matched here", variants_are(sig)))
    []
}

fn repeated_arm(mut cx: TypeCx, value: ExprId, v: string) {
    cx.emit(refusal("type.match", cx.loc_of(value), "variant `${v}` is matched more than once", "matched again here", null))
}

fn nothing_to_bind(mut cx: TypeCx, p: PatId, sname: string, variant: string) -> List<TypeId> {
    cx.emit(refusal("type.variant_arity", cx.pat_loc(p), "`${sname}.${variant}` carries nothing to bind", "bound here", "write `.${variant} ->` — only a carrying variant binds"))
    []
}

fn pattern_arity(mut cx: TypeCx, p: PatId, variant: string, carried: int, named: int) -> List<TypeId> {
    cx.emit(refusal("type.variant_arity", cx.pat_loc(p), "`.${variant}` carries ${carried}, the pattern names ${named}", "here", "one pattern per payload, in order — `_` for one you do not need"))
    []
}

fn not_variant_shaped(mut cx: TypeCx, p: PatId, name: string, expected: TypeId) -> List<TypeId> {
    let n = cx.view.types.name_of(expected)
    cx.emit(refusal("type.pattern", cx.pat_loc(p), "`.${name}` tests a variant, but this is `${n}`", this_is(n), null))
    []
}

fn literal_mismatch(mut cx: TypeCx, p: PatId, got: TypeId, expected: TypeId) {
    let g = cx.view.types.name_of(got)
    cx.emit(refusal("type.pattern", cx.pat_loc(p), "a `${g}` never matches `${cx.view.types.name_of(expected)}`", this_is(g), null))
}

fn or_binds(mut cx: TypeCx, value: ExprId) {
    cx.emit(refusal("type.or_binds", cx.loc_of(value), "an `or` arm binds nothing — its alternatives take wildcards only", "this arm", "split the arm, or write `_` where a name was"))
}

fn needs_catch_all(mut cx: TypeCx, e: ExprId, sname: string) {
    cx.emit(refusal("type.match", cx.loc_of(e), "a `match` over `${sname}` needs a catch-all arm", "this match", "end with `_ -> …` or `rest -> …`"))
}

fn wildcard_hides(mut cx: TypeCx, hole: PatId, hidden: List<string>) {
    cx.emit(warning("type.wildcard_hides", cx.pat_loc(hole), "this hole hides ${hidden.length} variants: ${joined([".${n}" for n in hidden], ", ")}", "matches them all", "handle each, or write `rest ->` to say the remainder is deliberate"))
}

fn unhandled_variant(mut cx: TypeCx, e: ExprId, sname: string, n: string) {
    cx.emit(refusal("type.match", cx.loc_of(e), "`match` on `${sname}` must handle `.${n}`", "this match", "every variant exactly once — adding a variant breaks every match, on purpose"))
}
