//! The enum laws: a declaration names at least one variant; a
//! `match` chooses over an ENUM, handles every variant exactly
//! once, and its arms agree on one type. Totality is the point —
//! adding a variant must break every match, so no catch-all exists.
use core.{ExprId, StmtId, Param, Type, TypeId, filled}
use features.{TypeCx, StmtTypeCx, EnumSig, spoken, this_is, nothing, duplicate_names,
              arms_agree, types_disagree, variants_are, build_a_record, unify}
use diagnostics.{error_at, pointed}

/// The declaration's own law.
export fn check_enum_decl(cx: StmtTypeCx, s: StmtId) {
    match cx.store.stmt(s) {
        .EnumDecl(name, _, variants) -> decl_checks(cx, s, name, variants),
        _ -> nothing(),
    }
}

/// An enum names at least one variant, each of them once. A dup is
/// a name whose FIRST position is earlier than this one.
fn decl_checks(cx: StmtTypeCx, s: StmtId, name: string, variants: List<Param>) {
    if variants.is_empty() {
        cx.expr.emit(pointed(
            error_at("type.enum_decl", cx.loc_of(s), "`${name}` declares no variants"),
            "this enum is empty")
            with { help: "an enum names at least one variant" })
    }
    for d in duplicate_names("type.enum_decl", name, [v.name for v in variants], cx.loc_of(s)) {
        cx.expr.emit(d)
    }
}

fn enums_type(cx: TypeCx, e: ExprId) -> TypeId {
    // LICENSED I22: a feature cannot enumerate OTHER features' variants
    match cx.store.expr(e) {
        .Match(subject, variants, binds, values) -> matched_type(cx, e, subject, variants, binds, values),
        .VariantLit(tname, variant, args) -> variant_lit_type(cx, e, tname, variant, args),
        _ -> cx.error_type,
    }
}

/// `Name.variant(arg)`: the variant must exist, must CARRY
/// something, and the argument must be what it carries.
fn variant_lit_type(cx: TypeCx, e: ExprId, tname: string, variant: string, args: List<ExprId>) -> TypeId {
    let found: StmtId? = cx.bound_def(e)
    if found == null { return cx.error_type }
    let decl = found!
    if !cx.store.decl_tparams(decl).is_empty() {
        return generic_variant_lit(cx, e, tname, variant, args, decl)
    }
    let ty = cx.types.intern(Type.Enum(decl, tname))
    let declared: EnumSig? = cx.variants_of(ty)
    if declared == null { return not_an_enum(cx, e, tname) }
    let sig = declared!
    if sig.tag_of(variant) == null { return no_such_variant(cx, e, tname, variant, sig) }
    let held: TypeId? = sig.payload_of(variant)
    if held == null { return carries_nothing(cx, e, tname, variant) }
    arg_checks(cx, e, tname, variant, args, held!)
    ty
}

/// Exactly one argument, of the declared type. Nothing given is a
/// refusal in its own words, not a silent pass.
fn arg_checks(cx: TypeCx, e: ExprId, tname: string, variant: string, args: List<ExprId>, carried: TypeId) {
    let first: ExprId? = args.first()
    if first == null {
        cx.emit(pointed(
            error_at("type.variant_arity", cx.loc_of(e),
                "`${tname}.${variant}` carries a `${cx.types.name_of(carried)}`, given nothing"),
            "built empty here")
            with { help: "write `${tname}.${variant}(<value>)`" })
        return
    }
    let arg = first!
    if types_disagree(cx, cx.type_at(arg), carried) {
        let n = cx.name_at(arg)
        cx.emit(pointed(
            error_at("type.variant_arity", cx.loc_of(arg),
                "`${tname}.${variant}` carries a `${cx.types.name_of(carried)}`, found `${n}`"),
            this_is(n)))
    }
}

fn matched_type(cx: TypeCx, e: ExprId, subject: ExprId, variants: List<string>,
                binds: List<string>, values: List<ExprId>) -> TypeId {
    let sh: Type = cx.shape_at(subject)
    if sh is .Error { return cx.error_type }
    let declared: EnumSig? = cx.variants_of(cx.type_at(subject))
    if declared == null {
        let n = cx.name_at(subject)
        return spoken(cx, pointed(
            error_at("type.match", cx.loc_of(subject), "`match` chooses over an enum, found `${n}`"),
            this_is(n)))
    }
    let sig = declared!
    let sname = cx.name_at(subject)
    bind_checks(cx, sname, variants, binds, values, sig)
    // The arms are hidden from the walk, so type them HERE — their
    // binds are spoken above, in time for the names inside.
    for v in values { let _ = cx.walk_type(v) }
    arm_checks(cx, sname, variants, values, sig)
    coverage_checks(cx, e, sname, variants, sig)
    arms_type(cx, values)
}

/// Every written arm names a variant, and names it once. A dup is
/// a name whose FIRST position is earlier than this one.
fn arm_checks(cx: TypeCx, sname: string, variants: List<string>, values: List<ExprId>, sig: EnumSig) {
    for (j, v) in variants.enumerate() {
        let tag: int? = sig.tag_of(v)
        if tag == null {
            cx.emit(pointed(
                error_at("type.match", cx.loc_of(values[j]), "`${sname}` has no variant `${v}`"),
                "matched here")
                with { help: variants_are(sig) })
        }
        if variants.index_of(v) < j {
            cx.emit(pointed(
                error_at("type.match", cx.loc_of(values[j]), "variant `${v}` is matched more than once"),
                "matched again here"))
        }
    }
}

/// The bind law, arm by arm: a bind names the payload its variant
/// carries, so the type is SPOKEN for the arm — typing reads it
/// wherever the name is used — and a variant carrying NOTHING has
/// nothing to name. An UNKNOWN variant is not this law's business:
/// `arm_checks` speaks there, and a second refusal for one arm is
/// a cascade.
fn bind_checks(cx: TypeCx, sname: string, variants: List<string>, binds: List<string>,
               values: List<ExprId>, sig: EnumSig) {
    for (j, b) in binds.enumerate() { bind_law(cx, sname, variants[j], b, values[j], sig) }
}

fn bind_law(cx: TypeCx, sname: string, variant: string, bind: string, value: ExprId, sig: EnumSig) {
    if bind == "" || sig.tag_of(variant) == null { return }
    let carried: TypeId? = sig.payload_of(variant)
    if carried == null {
        cx.emit(pointed(
            error_at("type.variant_arity", cx.loc_of(value),
                "`${sname}.${variant}` carries nothing to bind"),
            "bound here")
            with { help: "write `.${variant} ->` — only a carrying variant binds" })
        return
    }
    cx.bind_type(value, carried!)
}

/// Every declared variant is written — the totality half.
fn coverage_checks(cx: TypeCx, e: ExprId, sname: string, variants: List<string>, sig: EnumSig) {
    for n in sig.names {
        if !variants.contains(n) {
            cx.emit(pointed(
                error_at("type.match", cx.loc_of(e), "`match` on `${sname}` must handle `.${n}`"),
                "this match")
                with { help: "every variant exactly once — adding a variant breaks every match, on purpose" })
        }
    }
}

/// The arms agree on one type: the FIRST arm anchors.
fn arms_type(cx: TypeCx, values: List<ExprId>) -> TypeId {
    let head: ExprId? = values.first()
    if head == null { return cx.error_type }
    if cx.shape_at(head!) is .Error { return cx.error_type }
    arms_agree(cx, "type.match", "match", "the first arm", head!, values)
}

/// A GENERIC enum's variant INSTANTIATES from its payload — the
/// unification law, payload-worded. A unit variant has nothing to
/// bind from, so it waits for the pinned surface (recorded).
fn generic_variant_lit(cx: TypeCx, e: ExprId, tname: string, variant: string,
                       args: List<ExprId>, decl: StmtId) -> TypeId {
    let declared: EnumSig? = variants_declared(cx, decl)
    if declared == null { return cx.error_type }
    let sig = declared!
    if sig.tag_of(variant) == null { return no_such_variant(cx, e, tname, variant, sig) }
    let held: TypeId? = sig.payload_of(variant)
    let tp = cx.store.decl_tparams(decl)
    // a declaration naming T twice already refused — absorb
    for (j, n) in tp.enumerate() {
        if tp.index_of(n) < j { return cx.error_type }
    }
    if held == null || args.is_empty() { return cannot_pin(cx, e, tname, variant, tp[0]) }
    let bound: List<TypeId?> = filled<TypeId?>(tp.length, null)
    let v = args[0]
    if !unify(cx, held!, cx.type_at(v), decl, bound) {
        return wrong_payload(cx, v, tname, variant, held!)
    }
    mut concrete: List<TypeId> = []
    // LICENSED I3: a ZIP with the name list; comprehensions cannot destructure enumerate
    for (j, n) in tp.enumerate() {
        let b: TypeId? = bound[j]
        if b == null { return unpinned_by_payload(cx, e, n) }
        concrete.push(b!)
    }
    cx.record_subst(e, decl, concrete)
    cx.types.intern(Type.App(decl, tname, concrete))
}

/// The raw declared table — Vars intact — or the record refusal.
fn variants_declared(cx: TypeCx, decl: StmtId) -> EnumSig? {
    cx.variants_of(cx.types.intern(Type.Enum(decl, "")))
}

// ── The voices: every refusal worded HERE, once — the laws above
// call the verb and stay legible. (DOGFOODING: laws call voices.) ──

fn not_an_enum(cx: TypeCx, e: ExprId, tname: string) -> TypeId {
    spoken(cx, pointed(
        error_at("type.unknown_prop", cx.loc_of(e), "`${tname}` is a record, not an enum"),
        "built here")
        with { help: build_a_record(tname) })
}

fn no_such_variant(cx: TypeCx, e: ExprId, tname: string, variant: string, sig: EnumSig) -> TypeId {
    spoken(cx, pointed(
        error_at("type.unknown_prop", cx.loc_of(e), "`${tname}` has no variant `${variant}`"),
        "built here")
        with { help: variants_are(sig) })
}

fn carries_nothing(cx: TypeCx, e: ExprId, tname: string, variant: string) -> TypeId {
    spoken(cx, pointed(
        error_at("type.variant_arity", cx.loc_of(e), "`${tname}.${variant}` carries nothing"),
        "given an argument here")
        with { help: "write `${tname}.${variant}` on its own" })
}

fn cannot_pin(cx: TypeCx, e: ExprId, tname: string, variant: string, tparam: string) -> TypeId {
    spoken(cx, pointed(
        error_at("type.unknown_prop", cx.loc_of(e),
            "`${tname}.${variant}` cannot pin `${tparam}` — nothing carries it"),
        "built here")
        with { help: "a payload pins the type; the pinned unit surface is recorded" })
}

fn wrong_payload(cx: TypeCx, v: ExprId, tname: string, variant: string, carried: TypeId) -> TypeId {
    let n = cx.name_at(v)
    spoken(cx, pointed(
        error_at("type.unknown_prop", cx.loc_of(v),
            "`${tname}.${variant}` carries a `${cx.types.name_of(carried)}`, found `${n}`"),
        this_is(n)))
}

fn unpinned_by_payload(cx: TypeCx, e: ExprId, tparam: string) -> TypeId {
    spoken(cx, pointed(
        error_at("type.unknown_prop", cx.loc_of(e), "`${tparam}` is not pinned by the payload"),
        "built here")
        with { help: "the pinned unit surface is recorded — carry `${tparam}` for now" })
}
