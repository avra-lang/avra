// proves: a match's arm may compare its subject with several consts at
// once (`a or b`), beside an arm comparing with one and a binder taking
// the rest — in a fn and in a method.
const web_label = "web"
const prevent_label = "prevent"
const always_label = "always"

fn kind(label: string) -> string {
    match label {
        web_label -> "event",
        prevent_label or always_label -> "flag",
        other -> "unknown ${other}",
    }
}

type Reader = { n: int }

impl Reader {
    fn kind(label: string) -> string {
        match label {
            web_label -> "event",
            prevent_label or always_label -> "flag",
            other -> "unknown ${other}",
        }
    }
}

let r = Reader { n: 0 }

"${kind("web")} ${kind("always")} ${kind("x")} ${r.kind("prevent")} ${r.kind("y")}"
