// proves: a bare `.Variant` takes its enum from the seat it fills: a binding's, a list element's.
enum Color { Red, Green, Blue }
fn name(c: Color) -> string { match c { .Red -> "r", .Green -> "g", .Blue -> "b" } }
let c: Color = .Green
let all: List<Color> = [.Red, .Blue]
"${name(c)} ${name(all[1])}"
