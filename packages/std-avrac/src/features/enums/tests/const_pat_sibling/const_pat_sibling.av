// proves: a bare name in a pattern compares only to a const its own
// file names — a sibling file's private `text` (words.av) never turns
// `.Text(text)` or a last-arm `text` into a comparison; both bind.
enum Piece {
    Text(string)
    Gap
}

fn shown(p: Piece) -> string {
    match p { .Text(text) -> "text ${text}", .Gap -> "gap" }
}

fn named(s: string) -> string {
    match s { "gap" -> "a gap", text -> "bound ${text}" }
}

"${shown(Piece.Text("a"))} ${shown(Piece.Gap)} ${named("b")} ${word()}"
