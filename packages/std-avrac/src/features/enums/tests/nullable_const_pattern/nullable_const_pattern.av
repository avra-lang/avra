// proves: a const's name in a match on a nullable compares the subject with the value the const
// is, beside `null` and a catch-all; a nullable const reads present where it is.
const one: int? = 1
const yes: bool? = true
const word: string? = "x"
fn f(o: int?) -> int {
    match o { one -> 1, null -> 0, _ -> 2 }
}
fn g(o: int?) -> int { (o ?? 10) + (one ?? 20) }
"${f(1)}${f(null)}${f(3)} ${one! + 1} ${g(5)} ${yes ?? false} ${word!}"
