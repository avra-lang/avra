// proves: a match on a nullable whose first arm takes `null` and whose
// second takes the rest binds the rest to the subject, still nullable,
// for a scalar and a managed value.
fn shown(x: int?) -> string {
    match x { null -> "none", n -> "${n! + 1}" }
}

fn named(s: string?) -> int {
    match s { null -> 0, _ -> 1 }
}

fn echoed(s: string?) -> string {
    match s { null -> "-", t -> t! + t! }
}

"${shown(null)} ${shown(4)} ${named(null)} ${named("a")} ${echoed(null)} ${echoed("ab")}"
