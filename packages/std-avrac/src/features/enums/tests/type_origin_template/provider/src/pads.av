//! A template that names its own PRIVATE type, and a hole that fills
//! the landing file's type of the same name.
use @std.meta.{Type, Directive}

/// Private — the template names it literally.
type Pad = { n: int }

/// `@derive(Padded)` gives a type `fn both() -> int`.
export trait Padded {
    static fn derive(t: Type) -> List<Directive> {
        [
            Directive {
                twin: "",
                name: t.name,
                at: t.at,
                source: quote {
        impl ${t} {
            fn both() -> int {
                let mine = ${t} { n: 1, m: 2 }
                let theirs: Pad = Pad { n: 5 }
                mine.m + theirs.n
            }
        }
    },
            },
        ]
    }
}
