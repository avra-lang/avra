// proves ORIGIN HYGIENE for a TYPE's name in a template: a type the
// template names literally (`Pad`, private to its provider) is the
// provider's, and a hole's type (`${t}`) is the landing file's own
// `Pad` — two types of one name, each read where its name was written.
use @std.meta.{derive}
use @test.pads.{Padded}

@derive(Padded)
type Pad = { n: int, m: int }

Pad { n: 0, m: 3 }.both()
