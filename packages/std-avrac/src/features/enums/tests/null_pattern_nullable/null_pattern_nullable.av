// proves: a `null` pattern arm matches a nullable enum subject when
// no variant arm forces the unwrap-first law, and a `null` pattern
// tests an optional payload the same way — natively and evaluated
enum K { A, B }
fn absence(k: K?) -> int {
    match k { null -> 100, _ -> 200 }
}
enum Node { Leaf(string?) }
fn describe(n: Node) -> string {
    match n { .Leaf(null) -> "empty", .Leaf(v) -> v ?? "?" }
}
absence(null) +
    absence(K.A) +
    absence(K.B) +
    describe(Node.Leaf(null)).length +
    describe(Node.Leaf("hi")).length
