// proves: a match whose arms take a variant only through patterns over its payload — `.Err(.A(x))`
// and `.Err(.B(y))` together — takes every value, its last arm answering the rest.
enum Turn {
    Again(int)
    Refused(string)
}

fn answered(r: Result<int, Turn>) -> int {
    match r { .Ok(d) -> d, .Err(.Again(n)) -> n * 10, .Err(.Refused(why)) -> why.length }
}

"${answered(.Ok(3))} ${answered(.Err(Turn.Again(4)))} ${answered(.Err(Turn.Refused("five!")))}"
