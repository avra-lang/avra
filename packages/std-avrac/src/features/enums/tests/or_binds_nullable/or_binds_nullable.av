// proves: an `or` arm binds a name at the one nullable type every alternative carries, a managed
// record or a scalar, present or absent, and the value read is the one the matched variant holds.
type Id = { index: int }

enum Seen {
    Named(id: Id?, tag: string)
    Unnamed(id: Id?)
    Counted(n: int?, tag: string)
    Tallied(n: int?)
}

fn id_of(s: Seen) -> string {
    match s {
        .Named(id, _) or .Unnamed(id) -> if id == null { "no id" } else { "id ${id!.index}" },
        .Counted(n, _) or .Tallied(n) -> "count ${n ?? -1}",
    }
}

let seen = [
    Seen.Named(Id { index: 3 }, "a"),
    Seen.Unnamed(null),
    Seen.Unnamed(Id { index: 7 }),
    Seen.Counted(null, "b"),
    Seen.Tallied(5),
]
for s in seen { println(id_of(s)) }
