// proves: an `or` arm binds what every alternative binds — by name,
// wherever the name stands in each variant, managed payloads included,
// and through a nested pattern.
enum Msg {
    Text(from: string, body: string)
    Reply(body: string, to: string, from: string)
    Ping(from: string)
    Quit
}

enum Wrapped {
    One(m: Msg)
    Two(n: int, m: Msg)
}

fn who(m: Msg) -> string {
    match m { .Text(from, _) or .Reply(_, _, from) or .Ping(from) -> from, .Quit -> "nobody" }
}

fn said(m: Msg) -> string {
    match m { .Text(f, b) or .Reply(b, _, f) -> "${f}: ${b}", .Ping(_) or .Quit -> "-" }
}

fn inner(w: Wrapped) -> string {
    match w { .One(.Ping(f)) or .Two(_, .Ping(f)) -> "ping from ${f}", _ -> "other" }
}

let ms = [Msg.Text("ann", "hi"), Msg.Reply("yo", "ann", "bob"), Msg.Ping("cy"), Msg.Quit]
for m in ms { println("${who(m)} | ${said(m)}") }
println(inner(Wrapped.Two(1, Msg.Ping("dee"))))
println(inner(Wrapped.One(Msg.Quit)))
