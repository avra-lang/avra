// AN ENUM WHOSE VARIANTS CARRY NOTHING IS ITS TAG — a word, no box.
// Each attack puts one where a box, a slot, a const or a dispatch
// meets it, and reads it back.
enum Dir { North, East, South, West }
enum Shape {
    Dot
    Line(len: int)
}
type Step = { dir: Dir, n: int }

trait Named {
    fn name() -> string
}

impl Named for Dir {
    fn name() -> string {
        match self {
            .North -> "N",
            .East -> "E",
            .South -> "S",
            .West -> "W",
        }
    }
}

const HOME: Dir = Dir.South
const ALL: List<Dir> = [Dir.North, Dir.East, Dir.South, Dir.West]

once fn favourite() -> List<Dir> { [Dir.West] }

fn turned(d: Dir) -> Dir {
    match d {
        .North -> .East,
        .East -> .South,
        .South -> .West,
        .West -> .North,
    }
}

fn first<T>(xs: List<T>) -> T { xs[0] }

fn found(k: int) -> Dir? { if k > 0 { Dir.East } else { null } }

fn name_or(k: int) -> string {
    let d? = found(k) else { return "-" }
    d.name()
}

fn run() -> string {
    let d = Dir.North
    let xs = [d, turned(d), turned(turned(d))]
    let s = Step { dir: xs[2], n: 3 }
    mut m: Map<string, Dir> = {}
    m.set("k", Dir.West)
    let c = Cell.new(Dir.East)
    c.set(turned(c.get()))
    let f = () -> turned(s.dir).name()
    let named: dyn Named = Dir.West
    let sh = Shape.Line(4)
    let same = d == Dir.North
    let is_e = turned(d) is .East
    let ws = [turned(w) for w in ALL]
    "${[x.name() for x in xs].join("")} ${s.dir.name()} ${(m.get("k") ?? Dir.North).name()} ${c.get().name()} ${f()} ${named.name()} ${same} ${is_e} ${HOME.name()} ${ws.length}${ws[3].name()} ${favourite()[0].name()} ${first(xs).name()} ${name_or(1)}${name_or(0)} ${(found(0) ?? Dir.South).name()} ${match sh { .Dot -> 0, .Line(n) -> n }}"
}

run()
