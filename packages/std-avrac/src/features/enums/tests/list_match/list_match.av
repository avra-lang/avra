// proves: a match on a list takes it by its patterns — exactly so many
// elements, at least so many with the ones between bound, its last
// elements counted from the end — and a list's own `bytes` on an empty
// literal takes the first verb that names it.
fn sum(xs: List<int>) -> int {
    match xs { [] -> 0, [h, ..t] -> h + sum(t) }
}

fn ends(xs: List<int>) -> string {
    match xs {
        [] -> "none",
        [only] -> "one ${only}",
        [first, ..mid, last] -> "${first}..${last} over ${mid.length}",
    }
}

"${sum([1, 2, 3])} ${ends([])} ${ends([4])} ${ends([1, 2, 3, 4])} ${[].bytes() != null}"
