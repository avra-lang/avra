// proves: `v.name` answers the word a variant was declared with —
// for a payload-free enum, an enum whose variants carry payloads, a
// one-variant enum, a name over an enum and every element of `all()`
// — and `E.all()` on a type name and on a value are one list.
enum Phase {
    Idle
    Running
    Done
}

enum Shape {
    Dot
    Circle(r: int)
    Rect(w: int, h: int)
}

enum Only {
    One
}

type Stage = Phase

fn words(ps: List<Phase>) -> string { [p.name for p in ps].join(",") }

let shapes = [Shape.Dot, Shape.Circle(2), Shape.Rect(1, 2)]
let st: Stage = Stage(Phase.Running)
"${words(Phase.all())} ${words(Phase.Done.all())} | ${[s.name for s in shapes].join(",")} ${Only.One.name} ${st.name} ${Phase.all().find(it.name == "Done")?.ordinal ?? -1}"
