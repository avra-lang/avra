// proves: a `.Variant` shorthand with payloads, in a return, an `if`'s arms and a list literal.
enum Tok { Num(n: int), Word(w: string), End }
fn describe(t: Tok) -> string { match t { .Num(n) -> "n${n}", .Word(w) -> w, .End -> "." } }
fn make(k: int) -> Tok {
    if k == 0 { return .End }
    if k < 0 { .Word("neg") } else { .Num(k) }
}
let ts: List<Tok> = [.Num(1), .Word("x"), make(0), make(-2), make(7)]
"${[describe(t) for t in ts].join(",")}"
