// proves ORIGIN HYGIENE for a const's name in a pattern: a template's
// bare name compares to the const the file that WROTE the template
// sees (`mark`, private there), a template's binder stays a binder
// though the landing file declares a const of that name (`lone`), and
// the landing file's own match binds a name that is a const only in
// the template's file.
use @std.meta.{derive}
use @test.classes.{Classed}

const lone = 99

@derive(Classed)
type Point = { x: int }

fn here(n: int) -> string {
    match n { mark -> "bound ${mark}" }
}

let p = Point { x: 1 }
"${p.class(7)} ${p.class(99)} ${p.class(3)} | ${here(7)}"
