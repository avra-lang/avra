//! A template whose match names this file's OWN private const, and
//! binds a name the landing file happens to give a const.
use @std.meta.{Type, Directive}

/// Private — the template compares to it by its bare name.
const mark = 7

/// `@derive(Classed)` gives a type `fn class(n: int) -> string`.
export trait Classed {
    static fn derive(t: Type) -> List<Directive> {
        [
            Directive {
                twin: "",
                name: t.name,
                at: t.at,
                source: quote {
        impl ${t} {
            fn class(n: int) -> string {
                match n {
                    mark -> "marked",
                    lone -> "bound ${lone}",
                }
            }
        }
    },
            },
        ]
    }
}
