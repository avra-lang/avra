// proves: every spelling of `is` — a bare tag, a payload bind in an
// `if`, and a payload bind with `_` — answers the same in both engines.
enum Shape {
    Dot
    Line(int)
    Pair(int, string)
}

fn is_dot(s: Shape) -> bool { s is .Dot }

fn named(s: Shape) -> string {
    if s is .Line(n) {
        "line ${n}"
    } else if s is .Pair(a, _) {
        "pair ${a}"
    } else {
        "dot"
    }
}

let dot: Shape = .Dot
let line: Shape = .Line(3)
let pair: Shape = .Pair(4, "x")
"${is_dot(dot)} ${is_dot(line)} ${named(dot)} ${named(line)} ${named(pair)}"
