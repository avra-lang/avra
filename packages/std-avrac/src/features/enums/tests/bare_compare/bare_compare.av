// proves: a bare variant beside `==`/`!=` reads its enum off the other
// side — on either side of the operator, through one `?` when the
// other side is nullable.
enum Tone {
    Danger
    Calm
}

type Style = { color: Tone? }

fn word(b: bool) -> string { if b { "y" } else { "n" } }

let t = Tone.Calm
let o: Tone? = Tone.Danger
let none: Tone? = null
let s = Style { color: Tone.Danger }
let plain = "${word(t == .Calm)}${word(t == .Danger)}${word(.Calm == t)}${word(t != .Danger)}"
let through = "${word(o == .Danger)}${word(o == .Calm)}${word(.Danger != o)}${word(none == .Danger)}${word(none != .Calm)}"
"${plain} ${through} ${word(s.color == .Danger)}"
