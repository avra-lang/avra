// proves ORIGIN HYGIENE for a TYPE name: a template spells `Mark` and `Tone`
// where its own file imports them, and lands in a file that imports neither.
use @std.meta.{derive}
use @test.kinds.{Kinded}

@derive(Kinded)
type Box = { size: int }

let b = Box { size: 2 }
let c = Box { size: 1 }
"${b.mark().n} ${b.named()} ${c.named()} ${b.picked(.Is(3))} ${b.picked(.Any)} ${b.pair().length} ${b.annotated()}"
