// `E.all` — every variant of a payload-free enum, in DECLARATION
// order, generated from the enum's own signature: nothing re-lists
// the variants, and a new variant joins the answer the day it lands.
enum Phase { Idle, Running, Done }

fn phases() -> List<Phase> { Phase.all() }

"${phases().length} ${phases()[0].ordinal} ${phases()[1].ordinal} ${phases()[2].ordinal} ${Phase.all()[2].ordinal}"
