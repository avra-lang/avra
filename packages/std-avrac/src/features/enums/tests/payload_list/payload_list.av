// proves: a list pattern stands as a payload's own pattern — a list of exactly
// its many elements, each taken by its own pattern, a name binding one whole.
enum Part {
    Num(n: int)
    Word(w: string)
}

enum Held {
    Many(items: List<Part>)
    One(p: Part)
}

fn shown(h: Held) -> string {
    match h {
        .Many([.Word(w), .Num(n)]) -> "pair ${w} ${n}",
        .Many([only]) -> match only { .Num(n) -> "one ${n}", .Word(w) -> "one ${w}" },
        .Many(items) -> "many ${items.length}",
        .One(_) -> "one",
    }
}

"${shown(Held.Many([Part.Word("a"), Part.Num(2)]))}, ${shown(Held.Many([Part.Num(3)]))}, ${shown(Held.Many([Part.Num(1), Part.Word("b")]))}, ${shown(Held.One(Part.Num(0)))}"
