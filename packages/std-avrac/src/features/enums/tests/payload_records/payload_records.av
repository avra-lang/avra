// proves: a record pattern stands for a variant's payload — a field by a
// literal, a field by a name, the rest discarded — and a record subject
// whose every field pattern binds takes every record.
type Pos = { x: int, y: int, tag: string }

enum Event {
    Hit(at: Pos)
    Miss
}

fn said(e: Event) -> string {
    match e {
        .Hit(Pos { x: 0, y, .. }) -> "edge ${y}",
        .Hit(Pos { tag, .. }) -> "hit ${tag}",
        .Miss -> "miss",
    }
}

fn whole(p: Pos) -> string {
    match p { Pos { x, y, tag } -> "${tag}${x + y}" }
}

let a = said(Event.Hit(Pos { x: 0, y: 4, tag: "a" }))
let b = said(Event.Hit(Pos { x: 2, y: 4, tag: "b" }))
let c = said(Event.Miss)

"${a} ${b} ${c} ${whole(Pos { x: 1, y: 2, tag: "w" })}"
