// proves: a variant's payload a literal stands for is compared with it: the arm takes the variant
// only where each such payload is that value, and binds the rest.
enum Shape {
    Named(id: int, name: string)
    Sized(w: int, h: int)
    Empty
}

fn said(s: Shape) -> string {
    match s {
        .Named(_, "Tasks") -> "tasks",
        .Named(7, n) -> "seven ${n}",
        .Sized(0, h) -> "flat ${h}",
        .Sized(w, 0) -> "thin ${w}",
        .Sized(2, 3) -> "two by three",
        .Named(id, n) -> "${n} ${id}",
        rest -> "other",
    }
}

let shapes = [
    Shape.Named(1, "Tasks"),
    Shape.Named(7, "x"),
    Shape.Named(9, "y"),
    Shape.Sized(0, 4),
    Shape.Sized(5, 0),
    Shape.Sized(2, 3),
    Shape.Sized(2, 4),
    Shape.Empty,
]
[said(s) for s in shapes].join(",")
