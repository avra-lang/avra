// proves: named payloads, nested patterns, alternatives, holes and a
// string match — natively, the jump table and the chain both
enum Leaf {
    Num(int)
    Word(string)
}
enum Node {
    Empty
    One(Leaf)
    Two(left: Leaf, right: Leaf)
}
fn weight(n: Node) -> int {
    match n {
        .Empty -> 0,
        .One(.Num(v)) -> v,
        .One(.Word(w)) -> w.length,
        .Two(.Num(a), .Num(b)) -> a + b,
        .Two(_, _) -> 100,
    }
}
fn code(s: string) -> int {
    match s { "add" -> 1, "sub" or "neg" -> 2, _ -> 9 }
}
fn flat(n: Node) -> int {
    match n { .Empty -> 1, .One(_) -> 2, .Two(_, _) -> 3 }
}
weight(Node.Empty) +
    weight(Node.One(Leaf.Num(4))) +
    weight(Node.One(Leaf.Word("abc"))) +
    weight(Node.Two(Leaf.Num(5), Leaf.Num(6))) +
    weight(Node.Two(Leaf.Word("q"), Leaf.Num(1))) +
    code("neg") * 10 +
    code("zzz") +
    flat(Node.Two(Leaf.Num(0), Leaf.Num(0)))
