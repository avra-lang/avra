// proves: a `null` standing as a payload's own pattern takes that variant only where the payload is
// absent, beside an arm taking the rest and one taking a present payload.
type Scoped = { of: string }

enum S {
    Each(index: Scoped?, name: Scoped)
    Other(n: int)
}

fn plain(s: S) -> string {
    match s { .Each(null, name) -> "plain ${name.of}", _ -> "-" }
}

fn which(s: S) -> string {
    match s {
        .Each(null, name) -> name.of,
        .Each(i, name) -> "${i?.of ?? "?"}.${name.of}",
        .Other(n) -> "${n}",
    }
}

let a = S.Each(null, Scoped { of: "x" })
let b = S.Each(Scoped { of: "i" }, Scoped { of: "y" })
"${plain(a)} ${plain(b)} ${plain(S.Other(1))} ${which(a)} ${which(b)} ${which(S.Other(7))}"
