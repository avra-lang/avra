// proves: `null` in a variant's nullable payload tests its absence, so an
// arm takes the variant only where the payload is absent, and the next
// arm takes it present.
enum Slot {
    Empty
    Held(n: int?, label: string?)
}

fn shown(s: Slot) -> string {
    match s {
        .Held(null, _) -> "held nothing",
        .Held(n, null) -> "held ${n!}",
        .Held(n, l) -> "${l!} ${n!}",
        .Empty -> "empty",
    }
}

"${shown(Slot.Held(null, "x"))}, ${shown(Slot.Held(3, null))}, ${shown(Slot.Held(4, "four"))}, ${shown(Slot.Empty)}"
