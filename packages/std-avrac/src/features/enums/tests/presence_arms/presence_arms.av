// pins: a match on a nullable takes its arms in order — a `null` arm
// anywhere, guards on either side, and more than two arms — each value
// reaching the first arm that takes it.
enum Light {
    Red
    Green
}

fn sized(x: int?) -> string {
    match x { v if v ?? 0 > 10 -> "big", null -> "none", v if v ?? 0 > 3 -> "mid", _ -> "small" }
}

fn named(s: string?) -> string {
    match s { null -> "-", v if v == "hi" -> "greeting", v -> v ?? "" }
}

fn lit(l: Light?) -> int {
    match l { v if v == Light.Red -> 1, null -> 0, _ -> 2 }
}

"${sized(20)} ${sized(null)} ${sized(5)} ${sized(1)} | ${named(null)} ${named("hi")} ${named("yo")} | ${lit(Light.Red)} ${lit(null)} ${lit(Light.Green)}"
