// proves: a pattern's `name` reads a const ANOTHER module exports,
// one whose value is another const, and a module's own private const
// from inside that module — the same answer in both engines.
use codes.{TAB, ESCAPE, INDENT, is_hidden}
fn word(c: int) -> string {
    match c { ESCAPE -> "escape", INDENT -> "indent", TAB -> "unreached", _ -> "other" }
}
"${word(27)} ${word(9)} ${word(1)} ${is_hidden(13)} ${is_hidden(9)}"
