// proves: an OR-RUN arm reads nothing — its variants carry different
// payloads, and the arm binds none of them; and a wildcard payload is
// never read, so an arm may name a variant longer than the value it
// meets. The shape every registry match takes.
enum Step {
    Bind(name: string, ann: string, value: string)
    Call(callee: string, args: string)
    Answer(value: string)
    Halt
}

fn named(s: Step) -> string? {
    match s { .Bind(name, _, _) -> name, .Call(_, _) or .Answer(_) or .Halt -> null }
}

fn spoken(s: Step) -> string {
    named(s) ?? "anonymous"
}

let steps = [Step.Bind("x", "int", "1"), Step.Call("f", "y"), Step.Answer("v"), Step.Halt]
"${spoken(steps[0])} ${spoken(steps[1])} ${spoken(steps[2])} ${spoken(steps[3])}"
