// Enums, vertically: declaration, construction through the type
// name, total match (as a value and in a fn), and every law
// refusing in its own words.
use @std.avrac.language.{analyze_source}
use @std.avrac.testing.{shown, refused_with, refused_at_run}

/// A three-variant enum, newline-separated.
fn colors() -> string {
    "enum C {\n    red\n    green\n    blue\n}\n"
}

/// One carrying variant and one unit — the bind fixture.
fn pair() -> string {
    "enum E {\n    a(int)\n    b\n}\n"
}

spec "features/enums" {
    given "the bare variant literal" {
        then "an annotated binding names the enum" {
            shown("${colors()}let c: C = .green\nmatch c {\n    .red -> 1\n    .green -> 2\n    .blue -> 3\n}") == "2"
        }
        then "a fn's answer names it, through an if's branches" {
            shown("${colors()}fn pick(b: bool) -> C {\n    if b { .red } else { .blue }\n}\nmatch pick(false) {\n    .red -> 1\n    .green -> 2\n    .blue -> 3\n}") == "3"
        }
        then "a payload rides the literal" {
            shown("${pair()}fn mk(n: int) -> E { .a(n) }\nmatch mk(7) {\n    .a(v) -> v\n    .b -> 0\n}") == "7"
        }
        then "a list of unit variants scans by variant" {
            shown("${colors()}let cs = [C.red, C.blue]\n\"" + "$" + "{cs.contains(C.blue)} " + "$" + "{cs.index_of(C.green)}\"") == "true -1"
        }
        then "a generic unit variant reads the want" {
            shown("enum Maybe<T> {\n    some(v: T)\n    none\n}\nlet m: Maybe<int> = Maybe.none\nmatch m {\n    .some(v) -> v\n    .none -> 0\n}") == "0"
        }
        then "a non-enum expectation refuses" {
            refused_with("fn f() -> int { .red }\n2", "`.red` builds a variant, and `int` has none")
        }
    }
    given "the closed set" {
        then "a match chooses by variant" {
            shown("${colors()}let c = C.green\nmatch c {\n    .red -> 1\n    .green -> 2\n    .blue -> 3\n}") == "2"
        }
        then "the first variant tags zero — order is the tag" {
            shown("${colors()}match C.red {\n    .red -> 10\n    .green -> 20\n    .blue -> 30\n}") == "10"
        }
        then "the last variant is the chain's final else" {
            shown("${colors()}match C.blue {\n    .red -> 1\n    .green -> 2\n    .blue -> 99\n}") == "99"
        }
        then "arms may be comma-separated on one line" {
            shown("enum B {\n    yes\n    no\n}\nmatch B.no { .yes -> 1, .no -> 0 }") == "0"
        }
        then "variants declare comma-separated too" {
            shown("enum B { yes, no }\nmatch B.yes { .yes -> 1, .no -> 0 }") == "1"
        }
        then "a variant crosses a fn boundary, both ways" {
            shown("${colors()}fn mk() -> C { C.blue }\nfn n(c: C) -> int { match c {\n    .red -> 1\n    .green -> 2\n    .blue -> 3\n} }\nn(mk())") == "3"
        }
        then "arms answer strings too" {
            shown("${colors()}match C.green {\n    .red -> \"r\"\n    .green -> \"g\"\n    .blue -> \"b\"\n}") == "g"
        }
        then "a match nests inside a match" {
            shown("enum B {\n    yes\n    no\n}\nmatch B.yes {\n    .yes -> match B.no { .yes -> 1, .no -> 2 }\n    .no -> 3\n}") == "2"
        }
    }
    given "variants that carry" {
        then "a payload variant constructs and matches" {
            shown("enum S {\n    circle(int)\n    point\n}\nmatch S.circle(5) {\n    .circle -> 1\n    .point -> 0\n}") == "1"
        }
        then "unit and carrying variants share one enum" {
            shown("enum S {\n    a(int)\n    b\n    c(int)\n}\nmatch S.c(9) {\n    .a -> 1\n    .b -> 2\n    .c -> 3\n}") == "3"
        }
        then "a carried value crosses a fn boundary" {
            shown("enum S {\n    one(int)\n    none\n}\nfn mk(v: int) -> S { S.one(v) }\nmatch mk(7) {\n    .one -> 1\n    .none -> 0\n}") == "1"
        }
        then "a unit variant refuses an argument" {
            let a = analyze_source("enum S {\n    a(int)\n    b\n}\nlet x = S.b(1)\n2")
            a.diagnostics.length == 1 &&
                a.report().contains("`S.b` carries nothing")
        }
        then "a carrying variant refuses being named bare" {
            let a = analyze_source("enum S {\n    a(int)\n    b\n}\nlet x = S.a\n2")
            a.diagnostics.length == 1 &&
                a.report().contains("`S.a` carries a `int`") &&
                a.report().contains("write `S.a(<value>)`")
        }
        then "a wrong-typed argument refuses" {
            let a = analyze_source("enum S {\n    a(int)\n    b\n}\nlet x = S.a(true)\n2")
            a.diagnostics.length == 1 &&
                a.report().contains("`S.a` carries a `int`, found `bool`")
        }
        then "a carrying variant refuses being built empty" {
            let a = analyze_source("enum S {\n    a(int)\n    b\n}\nlet x = S.a()\n2")
            a.diagnostics.length == 1 &&
                a.report().contains("`S.a` carries a `int`, given nothing")
        }
        then "a managed payload rides the slot — ownership landed" {
            analyze_source("enum S {\n    s(string)\n    n\n}\n1").diagnostics.is_empty()
        }
        then "an unknown carrying variant names the real ones" {
            let a = analyze_source("enum S {\n    a(int)\n    b\n}\nlet x = S.zz(1)\n2")
            a.diagnostics.length == 1 &&
                a.report().contains("`S` has no variant `zz`")
        }
    }
    given "pattern binds" {
        then "an arm's bind names the payload it carries" {
            shown("${pair()}match E.a(21) {\n    .a(n) -> n * 2\n    .b -> 0\n}") == "42"
        }
        then "the bind is the payload's type, not the enum's" {
            shown("enum E {\n    on(bool)\n    off\n}\nmatch E.on(false) {\n    .on(f) -> if f { 1 } else { 42 }\n    .off -> 0\n}") == "42"
        }
        then "a bind reaches a call, like any other name" {
            shown("fn twice(v: int) -> int { v + v }\n${pair()}match E.a(21) {\n    .a(n) -> twice(n)\n    .b -> 0\n}") == "42"
        }
        then "the only arm may bind — nothing chooses, the payload still lands" {
            shown("enum One {\n    only(int)\n}\nmatch One.only(21) {\n    .only(n) -> n + n\n}") == "42"
        }
        then "an untaken arm's payload is never read" {
            shown("${pair()}match E.b {\n    .a(n) -> n\n    .b -> 42\n}") == "42"
        }
        then "a bind dies with its arm" {
            let a = analyze_source("${pair()}match E.a(1) {\n    .a(n) -> n\n    .b -> n\n}")
            a.diagnostics.length == 1 && a.report().contains("`n` is not defined")
        }
        then "a unit variant has nothing to bind" {
            let a = analyze_source("${pair()}match E.a(1) {\n    .a(n) -> n\n    .b(x) -> 0\n}")
            a.diagnostics.length == 1 &&
                a.report().contains("`E.b` carries nothing to bind")
        }
    }

    given "wrong shapes" {
        then "a missing variant refuses, naming it" {
            let a = analyze_source("${colors()}match C.red {\n    .red -> 1\n    .green -> 2\n}")
            a.diagnostics.length == 1 &&
                a.report().contains("`match` on `C` must handle `.blue`")
        }
        then "a repeated arm refuses" {
            let a = analyze_source("${colors()}match C.red {\n    .red -> 1\n    .red -> 2\n    .green -> 3\n    .blue -> 4\n}")
            a.diagnostics.length == 1 &&
                a.report().contains("variant `red` is matched more than once")
        }
        then "an unknown arm names the real variants" {
            let a = analyze_source("${colors()}match C.red {\n    .red -> 1\n    .green -> 2\n    .blue -> 3\n    .mauve -> 4\n}")
            a.diagnostics.length == 1 &&
                a.report().contains("`C` has no variant `mauve`") &&
                a.report().contains("the variants are `red`, `green`, `blue`")
        }
        then "arms must agree on one type" {
            let a = analyze_source("${colors()}match C.red {\n    .red -> 1\n    .green -> true\n    .blue -> 3\n}")
            a.diagnostics.length == 1 &&
                a.report().contains("a `match`'s arms disagree")
        }
        then "a non-enum subject refuses" {
            let a = analyze_source("let n = 3\nmatch n {\n    .a -> 1\n}")
            a.diagnostics.length == 1 &&
                a.report().contains("`match` chooses over an enum, found `int`")
        }
        then "an unknown variant construction refuses" {
            let a = analyze_source("${colors()}C.mauve")
            a.diagnostics.length == 1 &&
                a.report().contains("`C` has no variant `mauve`")
        }
        then "an empty enum refuses" {
            let a = analyze_source("enum E { }\n1")
            a.diagnostics.length == 1 &&
                a.report().contains("`E` declares no variants")
        }
        then "a repeated variant declaration refuses" {
            let a = analyze_source("enum E {\n    a\n    a\n}\n1")
            a.diagnostics.length == 1 &&
                a.report().contains("`E` declares `a` more than once")
        }
        then "a duplicate type name refuses across kinds" {
            let a = analyze_source("type P = { x: int }\nenum P {\n    a\n}\n1")
            a.diagnostics.length == 1 &&
                a.report().contains("`P` is declared more than once")
        }
        then "a record used as an enum refuses" {
            let a = analyze_source("type P = { x: int }\nP.a")
            a.diagnostics.length == 1 &&
                a.report().contains("`P` is a record, not an enum")
        }
        then "a bare type name is not a value" {
            let a = analyze_source("${colors()}let c = C\n1")
            a.diagnostics.length == 1 &&
                a.report().contains("`C` is a type, not a value") &&
                a.report().contains("name a variant")
        }
        then "a single-variant match reads no tag — nothing chooses" {
            shown("enum One {\n    only\n}\nmatch One.only {\n    .only -> 7\n}") == "7"
        }
        then "an enum answer has no text projection" {
            refused_at_run("${colors()}C.red", "no text projection yet")
        }
    }
    given "generic enums — instantiation from the payload" {
        then "a variant lit pins T and match rides the substituted sig" {
            shown("enum Opt2<T> {\n    some(T)\n    nope\n}\nmatch Opt2.some(41) {\n    .some(x) -> x + 1\n    .nope -> 0\n}") == "42"
        }
        then "recursion rides the box — a generic tree" {
            shown("enum Tree<T> {\n    leaf(T)\n    wrap(Tree<T>)\n}\nfn depth<T>(t: Tree<T>) -> int {\n    match t {\n        .leaf(v) -> 0\n        .wrap(inner) -> 1 + depth(inner)\n    }\n}\ndepth(Tree.wrap(Tree.leaf(false)))") == "1"
        }
        then "a bare unit variant with no want cannot pin — nothing carries the type" {
            refused_with("enum Opt2<T> {\n    some(T)\n    nope\n}\nmatch Opt2.nope {\n    .some(x) -> x\n    .nope -> 0\n}",
                         "`Opt2.nope` cannot pin `T` — nothing carries it")
        }
        then "a type parameter cannot take the language's names — types too" {
            refused_with("enum Bad<int> {\n    a(int)\n}\n1",
                         "a type parameter cannot take `int`'s name")
        }
    }
}
