// proves: a match whose arms meet only as a nullable joins them there
// whether its value is bound or dropped where it stands — a statement
// match lowers as the bound one does, and both run.
enum H { A, B }

fn stated(h: H) -> int {
    match h { .A -> 1, rest -> null }
    7
}

fn bound(h: H) -> int? {
    let x = match h { .A -> 1, rest -> null }
    x
}

"${stated(H.A)} ${stated(H.B)} ${bound(H.A) ?? 0} ${bound(H.B) ?? 0}"
