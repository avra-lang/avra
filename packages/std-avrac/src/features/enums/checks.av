//! The typing rules of enums: a variant pattern binds its payloads, each typed by the variant's
//! payload on the subject's enum; `match` checks each arm against its seat and is their join; `is`
//! proves its pattern's names in the branch where it holds; a variant literal is the enum its seat
//! names.
use core.{
    Arm,
    Checking,
    Checks,
    ExprId,
    Expected,
    PatChecks,
    PatId,
    Proof,
    SignedType,
    SyntaxArena,
    all_known,
    owned_type,
}
use core.expr.{Is, Match, VariantLit}
use core.pat.{Bind, Lit, Member, Rest, Variant, Wild}

impl PatChecks for Wild {
    fn pat_checked(mut cx: Checking, p: PatId, subject: SignedType?) {}
}

impl PatChecks for Rest {
    fn pat_checked(mut cx: Checking, p: PatId, subject: SignedType?) {}
}

impl PatChecks for Bind {
    /// A name binds the whole subject.
    fn pat_checked(mut cx: Checking, p: PatId, subject: SignedType?) { cx.bind(self.name.of, subject) }
}

impl PatChecks for Variant {
    /// `.V(a, b)` binds each payload's pattern against that payload.
    fn pat_checked(mut cx: Checking, p: PatId, subject: SignedType?) {
        let payloads = cx.payloads_of(subject, self.name.of)
        for at, a in self.args {
            cx
                .check_pat(a, if payloads != null && at < payloads!.length { payloads![at] } else { null })
        }
    }
}

impl PatChecks for Lit {
    /// A literal binds nothing; it checks as the value it compares.
    fn pat_checked(mut cx: Checking, p: PatId, subject: SignedType?) { let _ = cx.check(self.value, Expected.Free) }
}

impl PatChecks for Member {
    /// `.V as r` binds `r` as the member's record, which typing doesn't name yet.
    fn pat_checked(mut cx: Checking, p: PatId, subject: SignedType?) { cx.bind(self.bind.of, null) }
}

impl Checks for Match {
    fn checked(mut cx: Checking, e: ExprId, expected: Expected) -> SignedType? {
        let subject = cx.check(self.subject, Expected.Free)
        let truths = arm_truths(cx.store, self.arms)
        cx
            .arms_met(
                [cx
                    .arm_checked(
                        a,
                        subject,
                        expected,
                        if truths[at] == null { null } else { cx.proof_when(self.subject, truths[at]!) },
                    ) for at, a in self.arms],
                expected,
            )
    }
}

/// The truth of its subject each arm of a match stands under, so a match on a condition proves
/// what an `if` on it does: a `true` or `false` arm its own literal, a catch-all after one literal
/// the other; none for any other arm.
fn arm_truths(store: SyntaxArena, arms: List<Arm>) -> List<bool?> {
    let said = [said_truth(store, a) for a in arms]
    [when {
        said[at] != null -> said[at]
        catches_all(store, a) -> the_other(said.take(at))
        _ -> null
    } for at, a in arms]
}

/// The literal truth an arm's one pattern names, absent for any other arm.
fn said_truth(store: SyntaxArena, a: Arm) -> bool? {
    if a.pats.length != 1 || a.guard != null { return null }
    match store.pat(a.pats[0]) { .Lit(v) -> store.expr(v).bool_of(), rest -> null }
}

/// Whether an arm takes every subject: one pattern, no guard, that binds or discards it.
fn catches_all(store: SyntaxArena, a: Arm) -> bool {
    if a.pats.length != 1 || a.guard != null { return false }
    match store.pat(a.pats[0]) { .Wild or .Rest or .Bind(_) -> true, rest -> false }
}

/// The truth no arm before took, when exactly one literal arm stands before.
fn the_other(before: List<bool?>) -> bool? {
    let told = [t! for t in before if t != null]
    if told.length == 1 { !told[0] } else { null }
}

impl Checks for Is {
    fn checked(mut cx: Checking, e: ExprId, expected: Expected) -> SignedType? {
        let subject = cx.check(self.left, Expected.Free)
        cx.proved(e, Proof { names: cx.pattern_binds(self.right, subject), truth: true })
        owned_type("bool")
    }
}

impl Checks for VariantLit {
    fn checked(mut cx: Checking, e: ExprId, expected: Expected) -> SignedType? {
        let wanted = match expected { .Exactly(ty) -> ty with { nulls: 0 }, rest -> null }
        let payloads? = all_known(cx.payloads_of(wanted, self.name.of), self.args.length) else {
            cx.checked_free(self.args)
            return null
        }
        for at, a in self.args { let _ = cx.check(a, Expected.Exactly(payloads[at])) }
        wanted
    }
}
