//! Enums — the second user-defined type and the first closed set.
//! `enum Name { A B(int) C(x: int, y: string) }` declares (variants
//! newline- or comma-separated; a wrapper's one payload positional,
//! several named); `Name.variant(args)` constructs through the
//! spine's property ladder (a TYPE NAME is the subject); `match
//! subject { pattern -> value }` chooses by the FIRST accepting arm.
//! A pattern is a tree: `.V(p, q)` nests, `a or b` alternates, a
//! name binds the value at its path for that arm alone, a literal
//! equals, `_` is the hole and `rest` the deliberate remainder.
//! Typing proves coverage — every variant, or a catch-all — and
//! warns when a hole sits under two or more answering arms.
use features.{LanguageFeature, BuilderRow, PropertyRow}
use core.{Type}
use grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}
use diagnostics.{DiagCode}

export fn enums() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name          | build
        "enum_decl"   | build_enum_decl
        "match_expr"  | build_match
        "match_arm"   | build_arm
        "variant_pat" | build_variant_pat
        "wild_pat"    | build_wild_pat
        "bind_pat"    | build_bind_pat
        "str_pat"     | build_str_pat
        "num_pat"     | build_num_pat
        "true_pat"    | build_true_pat
        "false_pat"   | build_false_pat
        "variant_lit" | build_variant_lit
    }
    let codes = table<DiagCode> {
        kind                 | id      | summary
        "type.enum_decl"     | "F2012" | "an enum declares at least one variant, each named once"
        "type.match"         | "F2013" | "`match` chooses over an enum, every variant exactly once"
        "type.variant_arity" | "F2015" | "a variant carries exactly what it declares"
        "type.enum_payload"  | "F2016" | "an enum payload holds an unmanaged word"
        "type.pattern"       | "F2038" | "a pattern fits the shape it tests: a variant of the enum, with exactly its payloads, or a literal of the type"
        "type.or_binds"      | "F2039" | "an `or` arm binds nothing — wildcards only"
        "type.registry_hole" | "F2040" | "a hole under two or more answering arms forgets the next variant — spell them, or write `rest`"
        "type.variant_lit"   | "F2043" | "a `.variant` literal builds the enum the site expects"
    }
    let properties = table<PropertyRow> {
        name      | takes   | check         | lower
        "ordinal" | on_enum | check_ordinal | lower_ordinal
    }
    component LanguageFeature f {
        name = "enums"
        docs = "`enum Suit { clubs hearts }` declares a closed set; `Suit.clubs` constructs; `v.ordinal` is the variant's place in the declaration; `match` chooses by patterns — `.V(p, q)` nests, `a or b` alternates, a name binds, a literal equals, `_` is the hole, `rest` the deliberate remainder — and must cover the subject."
        gram = grammar {
            stmt = "enum" n:NAME ( "<" tp:NAME ( "," tp:NAME )* ","? ">" )? "{" ( BREAK | "," | vs:NAME ( po:"(" ( pn:NAME ":" )? pt:type ( "," ( pn:NAME ":" )? pt:type )* ","? ")" )? )* "}" END @recover(sync_to: "END") -> enum_decl(n, tp, vs, po, pn, pt)
            primary = "." vn:NAME ( "(" ( a:expression ( "," a:expression )* ","? )? ")" )? -> variant_lit(vn, a)
            primary = "match" subj:expression "{" ( BREAK | "," | a:arm )* "}" @expect("}", "expected `}` to close the `match`") -> match_expr(subj, a)
            arm = p:pattern ( "or" p:pattern )* "->" v:expression -> match_arm(p, v)
            pattern = "." vn:NAME ( "(" sub:pattern ( "," sub:pattern )* ")" )? -> variant_pat(vn, sub) | "_" -> wild_pat() | "true" -> true_pat() | "false" -> false_pat() | s:STRING -> str_pat(s) | v:NUMBER -> num_pat(v) | n:NAME -> bind_pat(n)
        }
        builders = rows
        diags = codes
        properties = properties
    }
    f
}

/// The property row's receiver: an enum value, plain or instantiated.
fn on_enum(sh: Type) -> bool {
    match sh {
        .Enum(_, _) or .App(_, _, _) -> true,
        .Struct(_, _) or .Int or .Float or .Bytes or .Bool or .Str or .Ptr or .List(_) or .Map(_, _) or .Res(_, _) or
        .Fn(_, _, _) or .Opt(_) or .Null or .EmptyList or .EmptyMap or .TypeName(_, _) or
        .Var(_, _, _) or .Dyn(_, _) or .Error or .Void -> false,
    }
}
