//! Enums — the second user-defined type and the first closed set.
//! `enum Name { A B(int) C(x: int, y: string) }` declares (variants
//! newline- or comma-separated; a wrapper's one payload positional,
//! several named); `Name.variant(args)` constructs through the
//! spine's property ladder (a TYPE NAME is the subject); `match
//! subject { pattern -> value }` chooses by the FIRST accepting arm.
//! A pattern is a tree: `.V(p, q)` nests, `a or b` alternates, a
//! name binds the value at its path for that arm alone, a literal
//! equals, `_` is the hole and `rest` the deliberate remainder. An
//! arm may take a guard — `pattern if cond -> value` — tried only
//! once its pattern accepts; a false guard tries the next arm, and a
//! guarded arm covers nothing towards coverage.
//! Typing proves coverage — every variant, or a catch-all — and
//! warns when a hole sits under two or more answering arms.
use features.{LanguageFeature, MethodRow, PropertyRow, ReceiverEffect, unknown_answer}
use features.enums.{bool_variant_match, bool_variant_match_negated}
use core.{Type}
// LICENSED modules.unused_import: `Fixed` and `Term` are named by GENERATED code, not by this
// file — a rule that states a payload writes a `Fixed` literal, and one that builds a node in
// place writes a `Term`. Resolve needs the names the source never spells.
use @std.grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Fixed, Term, Expect, Recover}
use diagnostics.{DiagCode}

export fn enums() -> LanguageFeature {
    let codes = table<DiagCode> {
        kind                   | summary
        "type.enum_decl"       | "an enum declares at least one variant, each named once"
        "type.match"           | "`match` chooses over an enum, every variant exactly once"
        "type.variant_arity"   | "a variant carries exactly what it declares"
        "type.is_bind"         | "a payload `is` binds only in an `if` condition"
        "type.enum_payload"    | "an enum payload holds a value"
        "type.pattern"         | "a pattern fits the shape it tests: a variant of the enum, with exactly its payloads, or a literal of the type"
        "type.member_pattern"  | "`.V as r` takes a gathered variant whole, as its member's record"
        "type.or_binds"        | "every alternative of an `or` arm binds the same names at the same types"
        "type.binds_twice"     | "a pattern binds each name once"
        "type.const_pattern"   | "a bare name in a pattern compares to a const of that name — and says so where it ends a match"
        "type.unreachable_arm" | "an arm after one that takes every value never runs"
        "type.registry_hole"   | "a hole under two or more answering arms forgets the next variant — spell them, or write `rest`"
        "type.variant_lit"     | "a `.variant` literal builds the enum the site expects"
        "type.enum_all"        | "`all` lists an enum whose variants carry nothing"
    }
    let properties = table<PropertyRow> {
        name      | takes   | check              | lower
        "ordinal" | on_enum | check_ordinal      | lower_ordinal
        "name"    | on_enum | check_variant_name | lower_variant_name
    }
    let methods = table<MethodRow> {
        name  | takes         | check          | lower          | effect              | answers
        "all" | on_plain_enum | check_enum_all | lower_enum_all | ReceiverEffect.Read | unknown_answer
    }
    LanguageFeature enums {
        gram: grammar {
            stmt = "enum" name:NAME ( "<" tparams:NAME ( "," tparams:NAME )* ","? ">" )? "{" ( BREAK | "," | variants:variant )* "}" END @recover(sync_to: "END") -> Stmt.EnumDecl
            payload = ( marks:mark )* ( name:NAME ":" )? ty:type -> Record.ParamSyntax
            variant = ( marks:mark )* name:NAME ( "(" payloads:payload ( "," payloads:payload )* ","? ")" )? -> Record.VariantSyntax
            primary = "." name:NAME ( "(" ( args:element ( "," args:element )* ","? )? ")" )? -> Expr.VariantLit
            primary = "match" subject:expression "{" ( BREAK | "," | arms:arm | arms:hole_arm )* "}" @expect("}", "expected `}` to close the `match`") -> Expr.Match @head(subject)
            arm = pats:pattern ( "or" pats:pattern )* ( "if" guard:expression )? "->" value:expression -> Record.Arm
            hole_arm = h:HOLE -> Record.Arm(pats = [Pat.Bind(name = h)], value = Expr.Ident(name = h))
            pattern = "." name:NAME "as" bind:NAME -> Pat.Member | "." name:NAME ( "(" args:pattern ( "," args:pattern )* ","? ")" )? -> Pat.Variant | "_" -> Pat.Wild | "true" -> Pat.Lit(value = Expr.BoolLit(value = true)) | "false" -> Pat.Lit(value = Expr.BoolLit(value = false)) | value:INTEGER -> Pat.Lit(value = Expr.IntLit(value = value)) | n:NAME -> bind_pat(n)
        }
        diags: codes
        properties: properties
        methods: methods
    }
    enums
}

/// The `all` method row's receiver: a PLAIN enum VALUE. `.App` is a
/// generic instance that is a struct OR an enum, and `takes` reads a
/// shape alone, so the row is offered to plain enums only; the static
/// gate (features/impls/callee.av) passes this shape for a
/// non-generic enum's TYPE NAME too.
fn on_plain_enum(t: Type) -> bool {
    match t { .Enum(_, _) -> true, rest -> false }
}

/// The property row's receiver: an enum value, plain or instantiated.
fn on_enum(sh: Type) -> bool {
    match sh {
        .Enum(_, _) or .App(_, _, _) -> true,
        .Struct(_, _) or .Int or .Float or .Bytes or .Bool or .Str or .Ptr or .List(_) or .Cell(_) or .Task(_) or .Tasks or .Map(_, _) or .Res(_, _) or .Fn(_, _, _) or .Opt(_) or .Null or .EmptyList or .EmptyMap or .TypeName(_, _) or .Var(_, _, _) or .Dyn(_, _) or .Union(_) or .Error or .Void or .Range -> false,
    }
}
