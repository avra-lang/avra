//! The mono worklist: one body's lowering enqueues the bodies it
//! reaches — a declaration under an instantiation, a lambda lifted,
//! a fn value's wrapper — and the unit drains. Every body OWNS its
//! worklist (a fresh value in its context, handed back with the
//! body), so an enqueue is a write in place, never through a shared
//! box; `seen` keys by mangled name, once per body.
use core.{ExprId, TypeId, DeclId, FileId, StmtId, Expr}
use @std.errors.{Loc}

/// One body WANTED — the unit of lowering: a declaration's body (or
/// a file's main, when `decl` is absent), under concrete Vars when
/// it is generic, named by its symbol or mangling, in its file.
export type Wanted = { file: FileId, decl: DeclId?, name: string, sub: Sub?, root: ExprId? = null }

/// Why a const did not SETTLE — three laws, each its own voice: the
/// value reached the world, ran past its budget, or trapped. And
/// `Spoken`: an earlier read already said so, and this one is silent.
export enum Unsettled { Reach(string), Budget(string), Trap(string), Spoken }

/// A const that settled: the literal a use lowers — or none, when the
/// value rides a pointer and a use CALLS its unit, which answers once.
export type Settled = { spelled: Expr?, embeds: List<string> = [] }

/// Where a const's settlement stands: running now (a const asking for
/// itself is refused as the cycle it is), held, or refused — spoken
/// at the first read, silent at every later one.
export enum Settlement { Settling, Held(Settled), Refused(Unsettled) }

/// The unit a const's initializer lowers as, named for its statement.
export fn const_symbol(f: FileId, s: StmtId) -> string {
    "const$${f.index}$${s.index}"
}

/// The unit an expression lowers as on its own — an annotation's
/// argument, settled like a const's value.
export fn expr_symbol(f: FileId, e: ExprId) -> string {
    "expr$${f.index}$${e.index}"
}

/// A value CROSSING between the compiler and a lifted call: scalar,
/// text and absence by value; records and lists as NODEs; maps as
/// ordered key/value rows. A record's slots and a list's elements
/// share one shape because the evaluator represents both alike.
export enum MetaVal { Int(int), Float(int), Text(string), Bool(bool), Absent, Node(int), Map(int) }

export type MetaMap = { keys: List<string>, values: List<MetaVal> }

export type MetaHeap = { nodes: List<List<MetaVal>>, maps: List<MetaMap> }

export fn new_meta_heap() -> MetaHeap { MetaHeap { nodes: [], maps: [] } }

impl MetaHeap {
    /// A record or list of these values, as the node that names it.
    fn node(slots: List<MetaVal>) -> MetaVal {
        self.nodes.push(slots)
        MetaVal.Node(self.nodes.length - 1)
    }

    fn map(keys: List<string>, values: List<MetaVal>) -> MetaVal {
        self.maps.push(MetaMap { keys: keys, values: values })
        MetaVal.Map(self.maps.length - 1)
    }

    /// A value from another crossing heap copied into this one,
    /// rebasing every nested handle as it crosses.
    fn adopt(from: MetaHeap, v: MetaVal) -> MetaVal {
        match v {
            .Node(id) -> self.node([self.adopt(from, x) for x in from.nodes[id]]),
            .Map(id) -> {
                let row = from.maps[id]
                self.map(row.keys, [self.adopt(from, x) for x in row.values])
            },
            .Int(_) or .Float(_) or .Text(_) or .Bool(_) or .Absent -> v,
        }
    }

    fn slots(v: MetaVal) -> List<MetaVal> {
        match v {
            .Node(id) -> self.nodes[id],
            .Int(_) or .Float(_) or .Text(_) or .Bool(_) or .Absent or .Map(_) -> [],
        }
    }
}

/// What a lifted call SAID about a declaration: one diagnostic, in
/// the annotation's own words, at the place it chose.
export type Said = { message: string, help: string?, at: Loc? }

/// One body's worklist: the bodies it wants, the lambdas it lifted,
/// the wrappers it minted, and the names it has already asked for.
export type Jobs = { pending: List<Wanted>, seen: Map<string, bool>, lifts: List<Lift>, wraps: List<Wrap>, externs: List<string>, settle: fn(FileId, StmtId) -> Result<Settled, Unsettled> }

/// A fresh worklist over the program's extern symbols — what every
/// body's emitter refuses an unknown callee against.
export fn new_jobs(externs: List<string>, settle: fn(FileId, StmtId) -> Result<Settled, Unsettled>) -> Jobs {
    Jobs { pending: [], seen: {}, lifts: [], wraps: [], externs: externs, settle: settle }
}

/// A NAMED fn boxed as a value calls through a generated WRAPPER
/// that wears the uniform convention: env at seat 0, forwarded.
export type Wrap = { target: string, seats: List<TypeId>, ret: TypeId, name: string }

/// One lambda awaiting its LIFT: the body lowers as a top-level fn
/// taking (env, params…) under the enclosing body's view — in the
/// enclosing body's own file, like every job a unit mints.
export type Lift = { lam: ExprId, name: string, sub: Sub? }
