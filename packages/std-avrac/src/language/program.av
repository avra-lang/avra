//! One parsed program: the tree, its source, and the owner map —
//! which feature speaks for which node. Parsing and the statement
//! spine live here; analysis stacks on top in analysis.av.
use core.{NodeStore, new_node_store, Expr, Stmt, StmtId, ExprId, Span, Param, concat, flatten}
use grammar.{Captured, RunOutcome, run_grammar, lex_source, lex_diagnostic}
use features.{LangNode, LanguageFeature, NodeSemantics, StmtSemantics, dispatch, list_at, stmt_id_at}
use features.expr_spine.{SpineSemantics}
use features.str_lit.{StrSemantics}
use features.bool_lit.{BoolSemantics}
use features.if_expr.{IfSemantics}
use features.when_expr.{WhenSemantics}
use features.block.{BlockSemantics}
use features.fns.{FnsSemantics, FnStmtSemantics}
use features.let_stmt.{LetStmtSemantics}
use features.expr_stmt.{ExprStmtSemantics}
use features.stmt_spine.{HoleSemantics}
use features.lists.{ListSemantics}
use features.mutation.{MutLetSemantics, AssignSemantics}
use features.loops.{WhileSemantics, ForSemantics}
use diagnostics.{Diag, SourceFile, new_source_file}

/// One parsed source: the tree (holes included), the SourceFile it
/// came from, and every diagnostic from lexing and parsing, in
/// source order. THE value every later pass takes first.
export type ParsedProgram = {
    store: NodeStore,
    stmts: List<StmtId>,
    source: SourceFile,
    keywords: List<string>,
    diagnostics: List<Diag>,
}

/// The semantics of each expression node — THE exhaustive map. A new
/// variant breaks HERE at compile time, and the impl it names owes
/// every pass, enforced by the trait. (Typed lets first: a dyn boxed
/// in a match ARM mis-dispatches — subset note.)
export fn semantics_of(e: Expr) -> dyn NodeSemantics {
    let spine: dyn NodeSemantics = SpineSemantics { }
    let strs: dyn NodeSemantics = StrSemantics { }
    let bools: dyn NodeSemantics = BoolSemantics { }
    let ifs: dyn NodeSemantics = IfSemantics { }
    let whens: dyn NodeSemantics = WhenSemantics { }
    let blocks: dyn NodeSemantics = BlockSemantics { }
    let calls: dyn NodeSemantics = FnsSemantics { }
    let aggs: dyn NodeSemantics = ListSemantics { }
    match e {
        .IntLit(_) or .Ident(_) or .Binary(_, _, _) or .Not(_) or
        .Index(_, _) or .Prop(_, _) or .Error -> spine,
        .ListLit(_) -> aggs,
        .StrLit(_) or .Interp(_, _) -> strs,
        .BoolLit(_) -> bools,
        .If(_, _, _) -> ifs,
        .When(_, _, _) -> whens,
        .Block(_, _) -> blocks,
        .Call(_, _) -> calls,
    }
}

/// The semantics of each STATEMENT kind — the stmt-spine's twin of
/// semantics_of. A new statement kind breaks HERE at compile time,
/// and the impl it names owes every pass, enforced by the trait.
export fn stmt_semantics_of(s: Stmt) -> dyn StmtSemantics {
    let lets: dyn StmtSemantics = LetStmtSemantics { }
    let exprs: dyn StmtSemantics = ExprStmtSemantics { }
    let decls: dyn StmtSemantics = FnStmtSemantics { }
    let holes: dyn StmtSemantics = HoleSemantics { }
    let mutlets: dyn StmtSemantics = MutLetSemantics { }
    let assigns: dyn StmtSemantics = AssignSemantics { }
    let whiles: dyn StmtSemantics = WhileSemantics { }
    let fors: dyn StmtSemantics = ForSemantics { }
    match s {
        .Let(_, _) -> lets,
        .MutLet(_, _) -> mutlets,
        .Assign(_, _) -> assigns,
        .ExprStmt(_) -> exprs,
        .FnDecl(_, _, _, _) -> decls,
        .While(_, _) -> whiles,
        .For(_, _, _, _, _, _) -> fors,
        .Error -> holes,
    }
}

/// The store's language-level vocabulary: the walk and the
/// stmt-spine questions every pass asks, grouped where they read as
/// prose — `store.post_order(v)`, `store.stmt_value(s)`.
impl NodeStore {
    /// Every node at and under `root`, children before owners — THE
    /// order every pass visits: facts a node reads exist before it
    /// speaks.
    fn post_order(self, root: ExprId) -> List<ExprId> {
        let node = self.expr(root)
        concat(flatten([self.post_order(k) for k in semantics_of(node).kids(node)]), [root])
    }

    /// A statement's bound name, when it binds one — the owner's
    /// answer, through the map.
    fn let_name(self, s: StmtId) -> string? {
        stmt_semantics_of(self.stmt(s)).binds(self, s)
    }

    /// A statement's value expression at its OWN position — the
    /// owner's answer, through the map. A body that runs later,
    /// under a frame, is NOT a value.
    fn stmt_value(self, s: StmtId) -> ExprId? {
        stmt_semantics_of(self.stmt(s)).value_of(self, s)
    }

    /// A fn declaration's pieces, when the statement is one — ONE
    /// projection for the whole variant; callers pick fields.
    fn fn_parts(self, s: StmtId) -> FnParts? {
        match self.stmt(s) {
            .FnDecl(name, params, ret, body) ->
                FnParts { name: name, params: params, ret: ret, body: body },
            _ -> null,
        }
    }
}

/// What a fn declaration carries, projected once.
export type FnParts = { name: string, params: List<Param>, ret: string, body: ExprId }

export fn parse_program(lang: Language, src: SourceFile) -> ParsedProgram {
    if lang.grammar == null {
        return ParsedProgram {
            store: new_node_store(), stmts: [], source: src,
            keywords: [], diagnostics: lang.diagnostics,
        }
    }
    let lexed = lex_source(src.text)
    let store = new_node_store()
    let build = (name: string, args: List<Captured<LangNode>>, span: Span?) -> dispatch(lang.features, store, name, args, span)
    let o = run_grammar<LangNode>(lang.grammar!, lexed.tokens, build)
    let engine = concat([lex_diagnostic(e) for e in lexed.errors], o.diagnostics)
    ParsedProgram {
        store: store,
        stmts: program_stmts(store, o),
        source: src,
        keywords: lang.keywords,
        diagnostics: project_all(engine, src.file, lang.codes),
    }
}

/// The program's statements in order. A recovery hole becomes an
/// explicit Stmt.Error node — the tree survives bad input visibly.
fn program_stmts(store: NodeStore, o: RunOutcome<LangNode>) -> List<StmtId> {
    mut out: List<StmtId> = []
    if o.result == null { return out }
    let items = list_at([o.result!], 0)
    for j in 0..items.length {
        let sid: StmtId? = stmt_id_at(items, j)
        if sid == null {
            out.push(store.alloc_stmt(Stmt.Error, null))
        } else {
            out.push(sid!)
        }
    }
    out
}
