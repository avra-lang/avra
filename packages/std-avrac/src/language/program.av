//! One parsed program: the tree, its source, and the owner map —
//! which feature speaks for which node. Parsing and the statement
//! spine live here; analysis stacks on top in analysis.av.
use core.{NodeStore, new_node_store, Expr, Stmt, StmtId, ExprId, Span, Param, Variant, Case, TypeRef, flatten}
use grammar.{Captured, RunOutcome, run_grammar, lex_source, lex_diagnostic}
use features.{LangNode, NodeSemantics, StmtSemantics, dispatch, list_at, stmt_id_at}
use features.expr_spine.{SpineSemantics}
use features.str_lit.{StrSemantics}
use features.bool_lit.{BoolSemantics}
use features.if_expr.{IfSemantics, IfStmtSemantics}
use features.when_expr.{WhenSemantics}
use features.block.{BlockSemantics}
use features.fns.{FnsSemantics, FnStmtSemantics, ReturnSemantics}
use features.let_stmt.{LetStmtSemantics}
use features.expr_stmt.{ExprStmtSemantics}
use features.stmt_spine.{HoleSemantics}
use features.lists.{ListSemantics}
use features.maps.{MapsSemantics}
use features.modules.{UseSemantics}
use features.specs.{SpecSemantics}
use features.nullable.{NullableSemantics, LetElseSemantics}
use features.results.{FailSemantics, CatchSemantics}
use features.impls.{ImplSemantics, MethodSemantics}
use features.closures.{ClosureSemantics}
use features.mutation.{MutLetSemantics, AssignSemantics}
use features.loops.{WhileSemantics, ForSemantics, ForEachSemantics}
use features.structs.{StructsSemantics, StructDeclSemantics}
use features.enums.{EnumsSemantics, EnumDeclSemantics}
use diagnostics.{SourceFile, Voices}

/// One parsed source: the tree (holes included), the SourceFile it
/// came from, and every diagnostic from lexing and parsing, in
/// source order. THE value every later pass takes first.
export type Parsed = {
    store: NodeStore,
    stmts: List<StmtId>,
    source: SourceFile,
    voices: Voices,
}

/// Every feature's boxed semantics, built ONCE per parse — the
/// exhaustive maps below only SELECT. (Boxing happens under the
/// typed lets in new_dispatch; per-node construction died with the
/// dispatch-built-once decision.)
export type Dispatch = {
    spine: dyn NodeSemantics,
    strs: dyn NodeSemantics,
    bools: dyn NodeSemantics,
    ifs: dyn NodeSemantics,
    whens: dyn NodeSemantics,
    blocks: dyn NodeSemantics,
    calls: dyn NodeSemantics,
    aggs: dyn NodeSemantics,
    structs: dyn NodeSemantics,
    enums: dyn NodeSemantics,
    nullables: dyn NodeSemantics,
    catches: dyn NodeSemantics,
    lets: dyn StmtSemantics,
    exprs: dyn StmtSemantics,
    decls: dyn StmtSemantics,
    holes: dyn StmtSemantics,
    mutlets: dyn StmtSemantics,
    assigns: dyn StmtSemantics,
    whiles: dyn StmtSemantics,
    fors: dyn StmtSemantics,
    structdecls: dyn StmtSemantics,
    enumdecls: dyn StmtSemantics,
    ifstmts: dyn StmtSemantics,
    returns: dyn StmtSemantics,
    letelses: dyn StmtSemantics,
    fails: dyn StmtSemantics,
    foreaches: dyn StmtSemantics,
    implds: dyn StmtSemantics,
    methods: dyn NodeSemantics,
    lambdas: dyn NodeSemantics,
    maps: dyn NodeSemantics,
    uses: dyn StmtSemantics,
    specs: dyn StmtSemantics,
}

export fn new_dispatch() -> Dispatch {
    let spine: dyn NodeSemantics = SpineSemantics { }
    let strs: dyn NodeSemantics = StrSemantics { }
    let bools: dyn NodeSemantics = BoolSemantics { }
    let ifs: dyn NodeSemantics = IfSemantics { }
    let whens: dyn NodeSemantics = WhenSemantics { }
    let blocks: dyn NodeSemantics = BlockSemantics { }
    let calls: dyn NodeSemantics = FnsSemantics { }
    let aggs: dyn NodeSemantics = ListSemantics { }
    let mapping: dyn NodeSemantics = MapsSemantics { }
    let lets: dyn StmtSemantics = LetStmtSemantics { }
    let exprs: dyn StmtSemantics = ExprStmtSemantics { }
    let decls: dyn StmtSemantics = FnStmtSemantics { }
    let holes: dyn StmtSemantics = HoleSemantics { }
    let mutlets: dyn StmtSemantics = MutLetSemantics { }
    let assigns: dyn StmtSemantics = AssignSemantics { }
    let whiles: dyn StmtSemantics = WhileSemantics { }
    let fors: dyn StmtSemantics = ForSemantics { }
    let structs: dyn NodeSemantics = StructsSemantics { }
    let structdecls: dyn StmtSemantics = StructDeclSemantics { }
    let enums: dyn NodeSemantics = EnumsSemantics { }
    let enumdecls: dyn StmtSemantics = EnumDeclSemantics { }
    let ifstmts: dyn StmtSemantics = IfStmtSemantics { }
    let returns: dyn StmtSemantics = ReturnSemantics { }
    let nullables: dyn NodeSemantics = NullableSemantics { }
    let letelses: dyn StmtSemantics = LetElseSemantics { }
    let fails: dyn StmtSemantics = FailSemantics { }
    let foreaches: dyn StmtSemantics = ForEachSemantics { }
    let implds: dyn StmtSemantics = ImplSemantics { }
    let methods: dyn NodeSemantics = MethodSemantics { }
    let lambdas: dyn NodeSemantics = ClosureSemantics { }
    let catches: dyn NodeSemantics = CatchSemantics { }
    let uses: dyn StmtSemantics = UseSemantics { }
    let specs: dyn StmtSemantics = SpecSemantics { }
    Dispatch {
        spine: spine, strs: strs, bools: bools, ifs: ifs, whens: whens,
        blocks: blocks, calls: calls, aggs: aggs, structs: structs, enums: enums,
        nullables: nullables, catches: catches,
        lets: lets, exprs: exprs, decls: decls, holes: holes,
        mutlets: mutlets, assigns: assigns, whiles: whiles, fors: fors,
        structdecls: structdecls, enumdecls: enumdecls,
        ifstmts: ifstmts, returns: returns, letelses: letelses, fails: fails,
        foreaches: foreaches, implds: implds, methods: methods,
        lambdas: lambdas, maps: mapping, uses: uses, specs: specs,
    }
}

/// The semantics of each expression node — THE exhaustive map,
/// selecting from the once-built Dispatch. A new variant breaks
/// HERE at compile time, and the impl it names owes every pass,
/// enforced by the trait.
export fn semantics_of(d: Dispatch, e: Expr) -> dyn NodeSemantics {
    match e {
        .IntLit(_) or .Ident(_) or .Binary(_, _, _) or .Not(_) or
        .Index(_, _) or .Prop(_, _) or .Error -> d.spine,
        .ListLit(_) or .Comp(_, _, _, _, _) -> d.aggs,
        .MapLit(_, _) -> d.maps,
        .StrLit(_) or .Interp(_, _) -> d.strs,
        .BoolLit(_) -> d.bools,
        .If(_, _, _) -> d.ifs,
        .When(_, _, _) -> d.whens,
        .Block(_, _) -> d.blocks,
        .Call(_, _, _) -> d.calls,
        .StructLit(_, _, _) or .With(_, _, _) -> d.structs,
        .Match(_, _) or .Is(_, _) or .VariantLit(_, _) -> d.enums,
        .NullLit or .Coalesce(_, _) or .Force(_) or .Propagate(_) or
        .MatchOpt(_, _, _, _) or .Chain(_, _) -> d.nullables,
        .Catch(_, _, _, _) -> d.catches,
        .MethodCall(_, _, _) -> d.methods,
        .Lambda(_, _) or .CallValue(_, _) -> d.lambdas,
    }
}

/// The semantics of each STATEMENT kind — the stmt-spine's twin of
/// semantics_of. A new statement kind breaks HERE at compile time,
/// and the impl it names owes every pass, enforced by the trait.
export fn stmt_semantics_of(d: Dispatch, s: Stmt) -> dyn StmtSemantics {
    match s {
        .Let(_, _, _) -> d.lets,
        .MutLet(_, _, _) -> d.mutlets,
        .Assign(_, _) -> d.assigns,
        .ExprStmt(_) or .Discard(_) -> d.exprs,
        .FnDecl(_, _, _, _, _) or .ExternFn(_, _, _) -> d.decls,
        .While(_, _) -> d.whiles,
        .For(_, _, _, _, _, _) -> d.fors,
        .StructDecl(_, _, _) -> d.structdecls,
        .EnumDecl(_, _, _) -> d.enumdecls,
        .IfStmt(_, _, _) -> d.ifstmts,
        .Return(_) -> d.returns,
        .LetElse(_, _, _) -> d.letelses,
        .Fail(_) -> d.fails,
        .ForEach(_, _, _, _) -> d.foreaches,
        .ImplDecl(_, _, _) or .TraitDecl(_, _) -> d.implds,
        .Use(_, _) -> d.uses,
        .Spec(_, _) -> d.specs,
        .Error -> d.holes,
    }
}

/// The walk is the LANGUAGE's: which nodes are a node's children
/// is each feature's answer, reached through the dispatch.
impl Language {
    /// Every node at and under `root`, children before owners — THE
    /// order every pass visits: facts a node reads exist before it
    /// speaks.
    fn post_order(self, store: NodeStore, root: ExprId) -> List<ExprId> {
        let node = store.expr(root)
        flatten([self.post_order(store, k) for k in semantics_of(self.dispatch, node).kids(node)]).concat([root])
    }
}

export fn parse_program(lang: Language, src: SourceFile) -> Parsed {
    if lang.grammar == null {
        return Parsed { store: new_node_store(), stmts: [], source: src, voices: Voices { list: lang.diagnostics } }
    }
    let lexed = lex_source(src.text)
    let store = new_node_store()
    let build = (name: string, args: List<Captured<LangNode>>, span: Span?) -> dispatch(lang.features, store, name, args, span)
    let o = run_grammar<LangNode>(lang.grammar!, lexed.tokens, build)
    let engine = [lex_diagnostic(e) for e in lexed.errors].concat(o.diagnostics)
    Parsed {
        store: store,
        stmts: program_stmts(store, o),
        source: src,
        voices: Voices { list: project_all(engine, src.file, lang.rows.codes) },
    }
}

/// The program's statements in order. A recovery hole becomes an
/// explicit Stmt.Error node — the tree survives bad input visibly.
fn program_stmts(store: NodeStore, o: RunOutcome<LangNode>) -> List<StmtId> {
    mut out: List<StmtId> = []
    if o.result == null { return out }
    let items = list_at([o.result!], 0)
    for j in 0..items.length {
        let sid: StmtId? = stmt_id_at(items, j)
        if sid == null {
            out.push(store.alloc_stmt(Stmt.Error, null))
        } else {
            out.push(sid!)
        }
    }
    store.answered(out)
}
