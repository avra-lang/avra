//! THE BUILD CACHE — a program's inputs hashed, and the module a
//! previous build of those exact inputs produced reused, so an unchanged
//! program costs a hash rather than an analysis.
//!
//! THE LAW IT EXISTS UNDER: an early-cutoff hash must cover the WHOLE
//! value it certifies. `parsed` cuts off on structural fingerprints while
//! its value carries the source text and every span, so a reindent leaves
//! later spans stale and certified fresh. Here every byte of every input
//! is absorbed, so a whitespace-only edit moves the key and a wrong reuse
//! is impossible by construction rather than by discipline.
//!
//! The key and the names its artifacts are stored under are ONE
//! derivation (`key`), so the store and the lookup cannot fall out of
//! step.
use core.{new_digest, digest_text, digest_key, digest_of, DeclId, DeclKind, no_stmt, joined, flatten, sorted_texts, module_path, FileId, TypeId, TypeRegistry, ModulePath, same_file}
use features.{Namespace, DeclSig, FnSig}
use @std.path.{joined_path, relative_path, dir_of}
use @std.io.{read_text, write_text, make_dirs, exists}

/// The compiler's format identity, folded first into every key. The
/// compiler's own sources, its backend and its runtime are already key
/// inputs (`Workspace.build_inputs`); this covers only what those files
/// cannot say — a change to how the key itself is derived.
const CACHE_FORMAT: string = "avra-build-cache-3"

/// A build's result: the words that link it, the binary they produce,
/// the warnings to speak, and whether a held artifact was reused.
export type BuildOutcome = { words: List<string>, binary: string, warnings: string, reused: bool, key: string, emitted: int = 0, reused_files: int = 0 }

/// Where a program's artifacts are kept — beside the program, so a
/// worktree's cache dies with the worktree.
export type BuildCache = { ws: Workspace, root: string, disk: Host }

// LICENSED I39: a CONSTRUCTOR — the workspace in, the cache out. The
// standard shape, like `new_db`.
/// Where a program's artifacts are kept — beside the program, so a
/// worktree's cache dies with the worktree. ONE derivation: the library
/// and the command that keeps the linked binary both name it here.
// LICENSED I39: a pure projection — a workspace in, the directory its artifacts live in out.
export fn build_cache_root(ws: Workspace) -> string { joined_path(tree_root(ws), ".avra-cache") }

/// WHERE A TREE'S ARTIFACTS LIVE — ONE store for the whole CHECKOUT.
///
/// THE LOCATION IS NOT A CORRECTNESS QUESTION, and that is what frees it to be
/// decided on blast radius and sharing instead. Every artifact is named by a key
/// over the whole input tuple AND the tuple is checked before the artifact is
/// believed, so a store in the wrong place costs a rebuild and can never hand
/// back a wrong answer.
///
/// AND BOTH CONSIDERATIONS POINT THE SAME WAY. A store beside each PROGRAM wrote
/// one gitignored directory per package INSIDE `packages/`, where every walker
/// that trusts a `.gitignore`-blind `find` will meet it — that cost two timed-out
/// uploads before the archive learned to exclude it. A store at the TREE root is
/// ONE directory, in the place a checkout already keeps its `.git`; and it is
/// SHARED, so `std-avrac`'s artifacts serve `cli`'s build instead of being
/// re-derived once per package. It still dies with the worktree, which is the
/// only thing the beside-the-program rule was ever for.
///
/// The tree is the HIGHEST ancestor that still looks like a checkout — a `.git`,
/// or a manifest at that root. A lone file has no tree above it and is its own
/// root, which is also the safe answer for an in-memory host: it answers no for
/// every directory it cannot see.
// LICENSED I39: a pure PROJECTION — a workspace in, the checkout it stands in out.
fn tree_root(ws: Workspace) -> string {
    // ALL THE WAY UP, keeping the HIGHEST that looks like a tree. Requiring every
    // ancestor to be one stops at the first plain directory — and a real checkout
    // has them: `packages/` holds no `.git` and no manifest, so the walk stopped
    // at `packages/cli` and wrote the store exactly where this change exists to
    // keep it from going.
    mut best = ws.root
    mut up = dir_of(ws.root)
    while up != dir_of(up) {
        if looks_like_tree(ws.host, up) { best = up }
        up = dir_of(up)
    }
    best
}

/// Whether a directory is a CHECKOUT ROOT rather than a directory inside one.
fn looks_like_tree(host: Host, dir: string) -> bool {
    host.is_dir(joined_path(dir, ".git")) || host.exists(joined_path(dir, "avra.toml"))
}

/// ARTIFACTS GO TO THE `disk` HOST, never to the source host. They are
/// different things and a LONE FILE is exactly where they diverge: its
/// workspace host is in memory, so routing the module through it wrote the
/// .ll/.plan/.warn into a map that died with the process while the binary
/// reached the real disk.
// LICENSED I39: a CONSTRUCTOR — the workspace and the artifact host in, the cache out.
export fn build_cache(ws: Workspace, disk: Host) -> BuildCache {
    BuildCache { ws: ws, root: build_cache_root(ws), disk: disk }
}

impl BuildCache {
    /// The key these inputs and this mode are stored under.
    /// THE KEY, from the TUPLE — one pass over the inputs, and a fold over
    /// everything the tuple carries: each path, each LENGTH, and each content
    /// digest. The tuple is computed once and used twice, for the key and for the
    /// check, because reading every input twice to answer one question is how a
    /// 250ms no-op becomes an 890ms one.
    fn key(entry: string, mode: string, inputs: string) -> string {
        mut d = new_digest()
        d = digest_text(d, CACHE_FORMAT)
        d = digest_text(d, mode)
        d = digest_text(d, self.rooted(entry))
        d = digest_text(d, inputs)
        digest_key(d)
    }

    /// A path as the key spells it: relative to the program's root, so
    /// two checkouts of one source share their artifacts.
    fn rooted(path: string) -> string { relative_path(self.ws.root, path) }

    /// THE INPUT TUPLE — every input the key absorbed, one line each: the
    /// relative path, the byte LENGTH, and a digest of the bytes.
    ///
    /// THE KEY IS A DIGEST OF THIS, SO THE KEY CAN LOSE IT. A hundred-and-twenty
    /// bit key names an artifact; it cannot separate two input SETS that
    /// digested to one value, and that residue is the whole of the collision
    /// risk. So the tuple is kept BESIDE the artifact and CHECKED before the
    /// artifact is believed — and path and length are recorded EXACTLY rather
    /// than digested, which is what makes the check able to fail. AN ENTRY
    /// FOUND BY A COLLIDING KEY FAILS THE CHECK AND IS REPORTED AS A MISS:
    /// the failure mode of a collision is a rebuild, never a wrong binary.
    fn inputs() -> string {
        joined([self.input_line(f) for f in self.ws.build_inputs()], "\n")
    }

    /// One input's line. The length is kept as well as the digest because it is
    /// the field a digest cannot lie about.
    fn input_line(path: string) -> string {
        let text = self.ws.host.read(path)
        "${self.rooted(path)}\t${text.length}\t${digest_of(text)}"
    }

    /// One artifact, or null — `exists` first, because a host that
    /// refuses a missing read is entitled to say so loudly.
    fn held(key: string, suffix: string) -> string? {
        let path = joined_path(self.root, "${key}${suffix}")
        if !self.disk.exists(path) { return null }
        self.disk.read(path)
    }

    /// A held build put where a fresh one would have written it, or null
    /// when nothing is held or the module cannot be placed — so a partial
    /// entry self-heals into a miss rather than a wrong link.
    fn reuse(entry: string, key: string, inputs: string) -> BuildOutcome? {
        let plan = self.held(key, ".plan")
        if plan == null { return null }
        // THE TUPLE IS THE TRUST, the key only the lookup.
        let held_inputs = self.held(key, ".inputs")
        if held_inputs == null || held_inputs! != inputs { return null }
        // NO SINGLE MODULE IS REQUIRED ANY MORE, and requiring one is how the
        // no-op went from 0.25s to 15.8s: the modules are per FILE now and live on
        // disk under their own `unit_key`s, so a hit re-links nothing and re-emits
        // nothing — it places the BINARY the plan already named.
        let ll = "${entry}.ll"
        BuildOutcome { words: plan!.split("\n"), binary: binary_name(ll), warnings: self.held(key, ".warn") ?? "", reused: true, key: key }
    }

    /// Keep a fresh build's module, plan and warnings under its key.
    fn keep(key: string, inputs: string, words: List<string>, warnings: string) {
        // THE MODULES ARE NOT KEPT HERE: they are per file, already on disk under
        // their own keys, and copying them into this key would be a second store
        // of the same bytes.
        let _ = self.disk.write(joined_path(self.root, "${key}.plan"), joined(words, "\n"))
        let _ = self.disk.write(joined_path(self.root, "${key}.warn"), warnings)
        let _ = self.disk.write(joined_path(self.root, "${key}.inputs"), inputs)
    }
}

/// A program built: the words that link it, reused when these exact
/// inputs were built before, else analyzed, lowered and emitted now.
/// `.Err` is the refusal to report, and A REFUSAL IS NEVER KEPT — a bad
/// program is reported on every run and cached never.
// LICENSED I39: THE ENTRY POINT, which I39 exempts by name — the one
// standard signature `build_program(ws, entry, …)`. `disk` is the artifact host.
// LICENSED I39: THE ENTRY POINT, which I39 exempts by name.
export fn build_program(mut ws: Workspace, entry: string, mode: string, opt: string, runtime: string, disk: Host) -> Result<BuildOutcome, string> {
    let cache = build_cache(ws, disk)
    let inputs = cache.inputs()
    let key = cache.key(entry, mode, inputs)
    let held = cache.reuse(entry, key, inputs)
    if held != null { return .Ok(held!) }
    // THE WALK IS CONSULTED HERE, once the answer is known to be needed: every
    // module whose record still holds contributes its exported signatures WITHOUT
    // being parsed, and the rest are left to the ordinary path.
    let _ = mint_held_modules(ws, build_cache_root(ws))
    emitted(cache, ws.program(entry), key, inputs, opt, runtime)
}

// LICENSED I39: the build's TWO PHASES, not a pass's vocabulary —
// `build_program` is the entry point and keeps the one standard signature
// (I39's own exemption), and this is its split at the phase boundary.
fn emitted(cache: BuildCache, p: Program, key: string, inputs: string, opt: string, runtime: string) -> Result<BuildOutcome, string> {
    if !p.clean() { return .Err(p.report()) }
    let view = p.entry_file()
    if view == null { return .Err(p.rendered([no_target(p.ws.root)])) }
    if view!.view.stmts.is_empty() { return .Err("the program is empty") }
    let lo = p.lowered_checked()?
    // THE WHOLE-PROGRAM MODULE, and the per-file split is NOT the build path yet:
    // a file's `unit_key` does not cover what a MONO-GENERATED body depends on —
    // WHICH OTHER FILES INSTANTIATE IT — so a reused module can be missing a
    // specialization another file asked for. MEASURED, NOT FEARED: the split
    // linked `_av_commands.TestCmd.run` "not found" after an edit elsewhere in the
    // tree. `emit_units` stands beside this, measured at 2 of 276 modules
    // re-emitted, waiting on a key that covers instantiation.
    let ll = "${view!.view.source.file}.ll"
    let failure = emit_ll(lo, ll)
    if failure != null { return .Err(failure!) }
    let binary = binary_name(ll)
    let words = link_words(ll, p.ws, opt, runtime)
    let warnings = p.warnings()
    cache.keep(key, inputs, words, warnings)
    .Ok(BuildOutcome { words: words, binary: binary, warnings: warnings, reused: false, key: key })
}

/// clang's words for a module: the level, the runtime, the packages' own
/// objects and flags, then the binary's path. The runtime object is passed
/// in — it is a TOOLCHAIN fact found from the binary's own directory, and a
/// lone file's host is in memory and knows nothing of a disk.
// LICENSED I39: a pure PROJECTION — a path, an opt level and a toolchain
// fact in, clang's words out. It owns no state and takes the workspace
// second, because the module's path is what it is about.
fn link_words(ll_path: string, ws: Workspace, opt: string, runtime: string) -> List<string> {
    ["-w", opt, "-rdynamic", ll_path, runtime].concat(ws.link_words()).concat(["-o", binary_name(ll_path)])
}

/// The same, over EVERY module the build emitted — one per file, plus the entry.
/// The output's name comes from the FIRST module's file, because a binary is named
/// for the program rather than for whichever file happened to be linked last.
fn link_modules(mods: List<string>, ws: Workspace, opt: string, runtime: string) -> List<string> {
    ["-w", opt, "-rdynamic"].concat(mods).concat([runtime]).concat(ws.link_words()).concat(["-o", binary_name(mods.first() ?? "")])
}

/// `x.av.ll` builds `x`.
export fn binary_name(ll_path: string) -> string {
    let base = if ll_path.ends_with(".ll") { ll_path.substring(0, ll_path.length - 3) } else { ll_path }
    if base.ends_with(".av") { base.substring(0, base.length - 3) } else { base }
}

// ── THE PER-UNIT KEY ────────────────────────────────────────────────

// ── THE MODULE INTERFACE'S IDENTITY ──────

/// WHAT ANOTHER MODULE SEES of this one, as one key.
///
/// THE INTERFACE IS THE CONTRACT, so its key names the WHOLE contract, and it
/// names it the SOUND way: the module's own sources AND the fingerprints of
/// everything those sources can SEE. The second half is not padding — a
/// signature can name a type from an import, so `fn f(x: util.Pair)` must move
/// when `util.Pair` changes, and a key over the module's own bytes alone misses
/// exactly that. THE OVER-APPROXIMATION IS DELIBERATE and it is the safe
/// direction: it can invalidate a dependent that did not need it, never certify
/// one that did.
///
/// It folds `stable_sig`, never `sig_hash` — an interface outlives one run, and
/// a key over interned ordinals moves whenever any new type is interned
/// anywhere, which would invalidate every dependent on an unrelated edit.
// LICENSED I39: a KEY DERIVATION — a pure projection of one module's sources and what they can see.
export fn module_surface(mut ws: Workspace, m: ModulePath) -> string {
    mut d = new_digest()
    d = digest_text(d, CACHE_FORMAT)
    for path in ws.module_files(m) {
        let f = ws.file_id(path)
        d = digest_text(d, ws.source(f).text)
        for line in interface_lines(ws, f) { d = digest_text(d, line) }
    }
    digest_key(d)
}

/// THE INTERFACE ENTRIES — what a file exports, one line each: the name, a tab,
/// and its stable signature (whose own prefix says which KIND it is, so a kind
/// field would be a second copy of what the signature already carries).
///
/// ONE DEFINITION, TWO USES: `module_surface` FOLDS these into the contract's
/// key, and a record KEEPS them so a driver can mint a held module's
/// declarations without parsing it. Two spellings of "what does this file
/// export" would let the key and the entries describe different modules, which
/// is the defect where the cache validates one thing and serves another.
// LICENSED I39: a pure PROJECTION — a workspace and a file in, the names it exports out.
fn interface_lines(mut ws: Workspace, f: FileId) -> List<string> {
    let ns: Namespace = ws.visible(f)
    [entry_line(n, sig_of(ws, ns.fns.get(n))) for n in ns.fn_names].concat(
        [entry_line(n, sig_of(ws, ns.types.get(n))) for n in ns.type_names])
}

/// ONE ENTRY: a name and its signature, or `builtin` and the name.
///
/// THE EMPTY CASE IS SPELLED, NOT LEFT EMPTY. A builtin has no `DeclSig` to
/// render — `List`, `Map` — so its entry would otherwise read COMPLETE WHILE
/// CARRYING NOTHING, and a loader could not tell "there is nothing to mint, the
/// compiler provides this name" from "there is something to mint that the writer
/// failed to write". THE TWO CAUSES GET TWO SPELLINGS, which is the only thing
/// that makes an absent signature safe to skip.
fn entry_line(name: string, sig: string) -> string {
    if sig.is_empty() { "builtin\t${name}" } else { "${name}\t${sig}" }
}

/// THE MODULE'S ENTRIES, its files' in order — what a record writes and what a
/// driver reads back.
// LICENSED I39: a pure PROJECTION — a workspace and a module in, the entries it exports out.
fn module_entries(mut ws: Workspace, m: ModulePath) -> List<string> {
    flatten([interface_lines(ws, ws.file_id(path)) for path in ws.module_files(m)])
}

// ── A STABLE IDENTITY ───────────────────────────────────────────────

/// A TYPE'S STABLE IDENTITY — its spelled SHAPE, never its interned ordinal.
///
/// A `TypeId` is a dense index into the workspace's registry, so introducing a
/// type anywhere shifts the ordinals and every signature that mentions a type
/// shifts with them. A key over such a number is a function of the GLOBAL
/// INTERNING ORDER, and an unrelated edit then invalidates every file — the DUAL
/// of the whole-value law, and just as much a key defect.
// LICENSED I39: a pure PROJECTION — a registry and a type in, its spelling out.
fn stable_type(types: TypeRegistry, id: TypeId) -> string { types.name_of(id) }

/// A SIGNATURE'S STABLE TEXT — the whole signature, every type by its spelling.
/// `sig_hash` stays exactly right for the memo kernel's IN-PROCESS cutoff, where
/// the ordinals are fixed for the run; a key that OUTLIVES the run may not fold
/// them. A default is folded as its PRESENCE, never its `DeclId` ordinal.
// LICENSED I39: a pure PROJECTION — a registry and a signature in, its stable text out.
fn stable_sig(types: TypeRegistry, s: DeclSig?) -> string {
    if s == null { return "" }
    match s! {
        .Fn(f) -> "fn(${joined([stable_type(types, t) for t in f.params], ",")})${stable_type(types, f.ret)}",
        .Record(r) -> "rec(${joined(r.names, ",")}|${joined([stable_type(types, t) for t in r.types], ",")}|${joined([if d == null { "_" } else { "d" } for d in r.defaults], "")})",
        .Enum(e) -> "enum(${joined(e.names, ",")}|${joined([joined([stable_type(types, t) for t in payload], ",") for payload in e.payloads], ";")})",
        .Named(n) -> "named(${stable_type(types, n.of)})",
    }
}

/// A name's signature, ASKED (the table fills only when asked) and rendered by
/// its STABLE spelling.
/// THE SIG IS ASKED, NOT READ OUT OF THE TABLE: `decls.sigs` fills only when a
/// signature is computed, so reading it directly answers nothing for every name
/// whose sig has not happened to be needed yet — a key blind to exactly the
/// change it exists to see.
// LICENSED I39: a pure PROJECTION — a workspace and a name in, the signature's stable text out.
fn sig_of(mut ws: Workspace, id: DeclId?) -> string {
    if id == null { return "" }
    stable_sig(ws.decls.types, ws.sig(id!))
}

/// THE UNIT KEY — one declaration's file's bytes, and the fingerprints of
/// every signature that file can SEE.
///
/// The sigs a unit READ are found by EXECUTION (the kernel records them on
/// the cell), and a cache LOOKUP may not execute — so the key takes the
/// file's VISIBLE namespace instead. That over-approximates what was read,
/// and the direction is the sound one: it can invalidate a unit that did
/// not need it, never certify one that did.
///
/// THE LAW IT EXISTS TO HOLD is the whole design's assumption, and it is
/// WITNESSED beside the whitespace and comment rows: a unit whose SEAT
/// changed while its own body did not must MISS. A key over the file's
/// bytes alone would be blind to exactly that change — which is why the
/// visible signatures are folded in below.
// LICENSED I39: a KEY DERIVATION — a pure projection of one file's bytes and the signatures it can see, called from `avra keys` and the cache alone.
export fn unit_key(mut ws: Workspace, f: FileId) -> string {
    mut d = new_digest()
    d = digest_text(d, CACHE_FORMAT)
    d = digest_text(d, ws.source(f).text)
    let ns: Namespace = ws.visible(f)
    for n in ns.fn_names { d = digest_text(d, sig_of(ws, ns.fns.get(n))) }
    for n in ns.type_names { d = digest_text(d, sig_of(ws, ns.types.get(n))) }
    digest_key(d)
}

// ── RUNG 2: THE INTERFACE RECORD ────────────────────────────────────
//
// The surface key above is the CONTRACT. What makes it usable across runs is
// that it can be VALIDATED WITHOUT PARSING, and that needs two things the
// surface key alone cannot give:
//
//   bytes_key(m)  — a digest of m's own files' BYTES, and nothing else. The
//                   bytes are on disk, so this costs a read and a hash: NO
//                   PARSE. It is the LOOKUP key, and it is why a record can
//                   be found at all before deciding whether to parse.
//
//   the record    — stored UNDER bytes_key, holding the surface key the
//                   module HAD and the modules it imported with the surface
//                   key each had at that moment.
//
// Validation is then: compute bytes_key (parse-free) -> the record is either
// there or not -> for each recorded import, recompute its surface_key
// (memoized, recursively) and compare. All equal means the contract this
// module was built against is the contract it faces now, so its surface is
// reused with NO PARSE AND NO RESOLVE. Any inequality means re-parse.

/// THE LOOKUP KEY: a module's own files' bytes. No parse, no namespace, no
/// signature — the cheapest question a cache can ask, and the one that decides
/// whether anything else is asked at all.
// LICENSED I39: a KEY DERIVATION — the bytes of one module's files, digested.
export fn bytes_key(mut ws: Workspace, m: ModulePath) -> string {
    mut d = new_digest()
    d = digest_text(d, CACHE_FORMAT)
    for path in sorted_texts(ws.module_files(m)) {
        d = digest_text(d, relative_path(ws.root, path))
        d = digest_text(d, ws.source(ws.file_id(path)).text)
    }
    digest_key(d)
}

/// THE INTERFACE RECORD, as text — one line per entry, so a reader can see it
/// and a diff of two records reads as a diff of two contracts.
///
///   surface <key>
///   import <module> <the surface key it had>
///
/// The imports are RECORDED because they are what makes validation parse-free:
/// a module's own `use` lines live in its source, so reading them costs a parse
/// — but reading them once, when the record is written, and keeping them here,
/// makes every later question free.
export fn surface_record(surface: string, imports: List<string>, had: List<string>, entries: List<string>) -> string {
    let head = "surface ${surface}\n" + joined(flatten([["import ${imports[i]} ${had[i]}"] for i in 0..imports.length]), "\n")
    if entries.is_empty() { return head }
    "${head}\nentry\n" + joined(entries, "\n")
}

/// THE ENTRIES a record carries — one per exported name, after its `entry`
/// marker. A driver MINTS a held module's declarations from these; validation
/// never reads them, which is why they sat unwritten while the walk was the only
/// consumer and why the driver's design found them missing.
export fn recorded_entries(text: string) -> List<string> {
    mut out: List<string> = []
    mut inside = false
    for line in text.split("\n") {
        if line == "entry" { inside = true }
        else { if inside && !line.is_empty() { out.push(line) } }
    }
    out
}

/// The record's surface key, or "" when the text is empty — the field the
/// validation compares first, because a record for a DIFFERENT contract is no
/// record at all.
export fn recorded_surface(text: string) -> string {
    for line in text.split("\n") {
        if line.starts_with("surface ") { return line.substring(8, line.length) }
    }
    ""
}

/// The imported modules a record names, in the order they were written.
export fn recorded_imports(text: string) -> List<string> {
    mut out: List<string> = []
    for line in text.split("\n") {
        if line.starts_with("import ") {
            let words = line.split(" ")
            if words.length >= 2 { out.push(words[1]) }
        }
    }
    out
}

/// The surface key each recorded import HAD — the other half of the pair the
/// validation compares, and the reason the record is a contract rather than a
/// cache: it says what it was built AGAINST, not merely what it produces.
export fn recorded_had(text: string) -> List<string> {
    mut out: List<string> = []
    for line in text.split("\n") {
        if line.starts_with("import ") {
            let words = line.split(" ")
            if words.length >= 3 { out.push(words[2]) }
        }
    }
    out
}

/// THE VALIDATION WALK — what a module's RECORD is still worth.
///
/// IT EXECUTES NOTHING OF THE MODULE. Every question it asks is answered from
/// the record: the module's own bytes decide WHICH record to read (the key is
/// content, so finding one means the bytes are unchanged), and the imports come
/// from the record rather than from the source — which is the whole reason the
/// record keeps them, because a module's `use` lines otherwise cost a parse.
///
/// THE MEMO IS THE BOUND. Without it, validating one module would walk its
/// imports' closure and validating every module would cost the residue of the
/// resolve time the interface exists to save. With it each surface is computed
/// once, however many dependents ask. `live` is the VISIT MARK and the ORDER the
/// cycle key folds, and it is a LIST rather than a map because a map cannot be
/// iterated and its order would reach the digest.
///
/// THE ANSWER IS "" WHEN THE RECORD IS NOT WORTH REUSING — a miss, which costs
/// a parse and is always sound. An interface key can only ever be too eager to
/// say "unknown"; it can never say "unchanged" about something that moved.
// LICENSED I39: a KEY DERIVATION — the record's worth, over one module's sources and what they can see.
fn surface_of(mut known: Map<string, string>, mut live: List<string>, mut ws: Workspace, dir: string, m: ModulePath) -> string {
    let name = m.text()
    let held = known.get(name)
    if held != null { return held! }
    if live.contains(name) { return cycle_key(ws, live) }
    // LICENSED I15: not a scope bracket — the VISIT MARK `cycle_key` READS while a
    // module is in flight, so a thunk would hide the state the algorithm inspects.
    live.push(name)
    let s = validated(known, live, ws, dir, m)
    known.set(name, s)
    let _ = live.pop()
    s
}

/// A record's worth: the surface key it claims, when every module it names still
/// has the surface it was built against; "" when any does not.
// LICENSED I39: a KEY DERIVATION — one record read, and the surface it is worth.
fn validated(mut known: Map<string, string>, mut live: List<string>, mut ws: Workspace, dir: string, m: ModulePath) -> string {
    let text = read_text(record_path(dir, bytes_key(ws, m))) catch ""
    if text == "" { return "" }
    let deps = recorded_imports(text)
    let had = recorded_had(text)
    for i, dep in deps.enumerate() {
        if surface_of(known, live, ws, dir, module_path(dep.split("."))) != had[i] { return "" }
    }
    recorded_surface(text)
}

/// THE CYCLE'S KEY: a digest of EVERY module in flight, which is a SUPERSET of
/// the cycle and is what makes it sound — a change to any byte of any member
/// moves every member's key, so nothing on the cycle is reused across a real
/// change. Over-invalidation is the price, and it is paid only for a graph shape
/// the language tolerates rather than encourages; the modules are folded in
/// SORTED order so two walks of one graph agree on one key.
// LICENSED I39: a KEY DERIVATION — the bytes of the modules currently in flight.
fn cycle_key(mut ws: Workspace, live: List<string>) -> string {
    mut d = new_digest()
    d = digest_text(d, CACHE_FORMAT)
    d = digest_text(d, "cycle")
    for name in sorted_texts(live) { d = digest_text(d, bytes_key(ws, module_path(name.split(".")))) }
    digest_key(d)
}

/// Where a module's record lives: under its BYTES key, in the cache directory,
/// because the record is the cache's and the source tree stays the source tree.
export fn record_path(dir: string, bytes: string) -> string { joined_path(dir, "${bytes}.surface") }

/// A MODULE'S WARNINGS, rendered — the ones its OWN files spoke. A fresh
/// module's warnings are produced while it is analysed; a HELD one is never
/// analysed, so they are kept here or they are lost.
fn module_warnings(p: Program, ws: Workspace, m: ModulePath) -> string {
    let files = ws.module_files(m)
    let spoken = flatten([a.diagnostics for a in p.files if files.contains(a.view.source.file)])
    p.rendered([d for d in spoken if is_warning(d)])
}

/// A HELD MODULE'S WARNINGS, beside its record. A fresh module's warnings are
/// computed while it is analysed, so a module that is NOT analysed has none
/// unless they were kept — and a build that quietly drops a warning is the exact
/// silent wrongness this design is arranged against.
export fn record_warn_path(dir: string, bytes: string) -> string { joined_path(dir, "${bytes}.warn") }

// ── WRITE TIME: THE SAME RECURSION, FROM THE SOURCE ─────────────────
//
// THE SURFACE A RECORD STORES AND THE SURFACE VALIDATION RECOMPUTES MUST BE
// ONE FUNCTION. They are reached differently — one walks the SOURCE, the other
// walks RECORDS — so the only thing keeping them equal is that they share this
// recursion's every decision: the same memo, the same cycle key, and therefore
// one key per graph. TWO SPELLINGS WOULD DISAGREE ON A CYCLE and a record would
// never validate, which is the kind of defect that shows up as a cache that
// mysteriously never hits rather than as a wrong answer.

/// A module's surface key, computed FROM THE SOURCE — bytes, plus each import's
/// surface computed the same way. Write time only: it is the one time a parse is
/// already paid for, so it is the one time the import list is free.
// LICENSED I39: a KEY DERIVATION — the module's bytes and its imports' surfaces, from a parse.
fn source_surface(mut known: Map<string, string>, mut live: List<string>, mut ws: Workspace, m: ModulePath) -> string {
    let name = m.text()
    let held = known.get(name)
    if held != null { return held! }
    if live.contains(name) { return cycle_key(ws, live) }
    // LICENSED I15: the same visit mark, for the same reason.
    live.push(name)
    mut d = new_digest()
    d = digest_text(d, CACHE_FORMAT)
    d = digest_text(d, bytes_key(ws, m))
    for dep in ws.imports_of(m) { d = digest_text(d, source_surface(known, live, ws, dep)) }
    let s = digest_key(d)
    known.set(name, s)
    let _ = live.pop()
    s
}

/// WRITE A MODULE'S INTERFACE RECORD, under the BYTES key its own files hash to.
///
/// The record is written the only moment its imports are cheap — while the parse
/// is in hand — and it stores what this module WAS BUILT AGAINST: the surface
/// each import had at that moment. That is what makes the record a CONTRACT
/// rather than a cache entry, and what a later run compares against.
// LICENSED I39: a KEY DERIVATION — one module's record written under its bytes key.
export fn write_surface(p: Program, mut ws: Workspace, dir: string, m: ModulePath) -> string {
    mut known: Map<string, string> = {}
    mut live: List<string> = []
    let imports = ws.imports_of(m)
    let names = [d.text() for d in imports]
    let hads = [source_surface(known, live, ws, d) for d in imports]
    let text = surface_record(source_surface(known, live, ws, m), names, hads, module_entries(ws, m))
    let key = bytes_key(ws, m)
    let _ = make_dirs(dir)
    let _ = write_text(record_path(dir, key), text) catch ""
    let _ = write_text(record_warn_path(dir, key), module_warnings(p, ws, m)) catch ""
    text
}

/// THE WHOLE PROGRAM'S RECORDS, one per module — sorted, so two runs write in
/// one order and a diff of two cache directories reads as a diff of two
/// contracts.
// LICENSED I39: a DRIVER — the module list in, the count written out; `avra records` is its only caller.
export fn write_surfaces(p: Program, mut ws: Workspace, dir: string, modules: List<ModulePath>) -> int {
    mut written = 0
    for m in modules {
        let _ = write_surface(p, ws, dir, m)
        written = written + 1
    }
    written
}

/// DOES THIS MODULE'S RECORD STILL HOLD — the question a driver asks before
/// deciding whether to parse a module at all, and the whole point of rung 2.
///
/// Its answer is parse-free: the record's location is content (the bytes are
/// hashed, not parsed) and its imports are remembered rather than read. A
/// `false` is a MISS and costs a parse; it is never a reuse of something that
/// moved.
// LICENSED I39: THE QUESTION A DRIVER ASKS — a workspace-and-directory question with one boolean answer.
export fn surface_holds(mut ws: Workspace, dir: string, m: ModulePath) -> bool {
    mut known: Map<string, string> = {}
    mut live: List<string> = []
    surface_of(known, live, ws, dir, m) != ""
}

// ── MINTING: A RECORD ENTRY BECOMES A SIGNATURE ─────────────────────

/// A record entry decoded: the name a declaration has, and the signature it
/// wears.
export type Minted = { name: string, sig: DeclSig }

/// DECODE ONE ENTRY, and REFUSE anything that does not round-trip.
///
/// A seat is written as a SPELLING, and a spelling becomes a `TypeId` through
/// `by_name` — which answers the FIRST type that ever rendered that text and
/// cannot know whether it is the one this record meant. SO THE SIGNATURE IS
/// RENDERED BACK AND COMPARED WITH THE LINE IT CAME FROM: a disagreement is a
/// refusal, never a wrong type, and that is the only direction this may fail in.
///
/// A FN IS WHAT A HELD MODULE'S CALLERS NEED — a call site reads a callee's
/// parameters and its answer, and nothing else about it. Every other kind is
/// REFUSED BY NAME rather than answered with something plausible, because a
/// declaration whose shape was GUESSED is worse than one that is missing: a
/// missing one is a diagnostic and a guessed one is a wrong program.
// LICENSED I39: a DECODER — a registry and a record line in, the signature they spell out.
export fn minted_entry(mut types: TypeRegistry, line: string) -> Minted? {
    let words = line.split("\t")
    if words.length != 2 { return null }
    let spelling = words[1]
    if !spelling.starts_with("fn(") { return null }
    let sig = fn_spelling(types, spelling)
    if sig == null { return null }
    if stable_sig(types, sig) != spelling { return null }
    Minted { name: words[0], sig: sig! }
}

/// A fn's spelling back into its seats. A NESTED SEAT is refused rather than
/// mis-split: `fn(fn(int)int)void` has a `)` inside its parameters, and a decoder
/// that split on the first one would silently take half a signature.
// LICENSED I39: a KEY DECODER — a registry and one spelling in, the seats out.
fn fn_spelling(mut types: TypeRegistry, spelling: string) -> DeclSig? {
    let close = spelling.index_of(")")
    if close < 0 { return null }
    let inside = spelling.substring(3, close)
    if inside.contains("(") { return null }
    let seats = if inside.is_empty() { [] } else { inside.split(",") }
    mut params: List<TypeId> = []
    for s in seats {
        let t = types.by_name(s)
        if t == null { return null }
        params.push(t!)
    }
    let ret = types.by_name(spelling.substring(close + 1, spelling.length))
    if ret == null { return null }
    .Fn(FnSig { params: params, ret: ret! })
}

/// REGISTER A HELD MODULE'S EXPORTED SIGNATURES — what makes `surface(m)`,
/// `exported_decls(m)` and `sig(id)` answer as a parse would.
///
/// SIGNATURES ONLY, AND THE BOUNDARY IS LOAD-BEARING: a held module is never
/// LOWERED, so its declarations never reach a pass that walks a tree. That is
/// what makes `no_stmt` and a null root safe here — a CONTRACT, not a
/// convenience, and the tree already mints tree-less declarations exactly so (a
/// `.Builtin`). The day something lowers a held module, these rows are lies.
///
/// THE RECORD IS PER MODULE AND THE MINTED TABLE IS PER FILE, because `items(f)`
/// is asked per file — so EVERY file of the module answers from one set. A mint
/// registered for one file and not its sibling would make half a module visible
/// and half parsed, which is the worst of both.
///
/// AND THE CELL IS WRITTEN, NOT ONLY THE TABLE: `sig` consults `db.ask` first, so
/// a filled row whose cell still reads `.Compute` would recompute the signature
/// FROM A TREE THAT IS NOT THERE — a plausible wrong signature, and the failure
/// no gate would catch.
// LICENSED I39: the MINTING — a workspace, a module and its entries in, the count registered out.
export fn mint_held(mut ws: Workspace, m: ModulePath, entries: List<Minted>) -> int {
    let paths = ws.module_files(m)
    let head = paths.first()
    let f = ws.file_id(head ?? "")
    mut made = 0
    for e in entries {
        // The kind follows the signature TODAY because the decoder accepts fns
        // alone; it must follow the decoder the day the decoder widens.
        let id = ws.decls.mint("held::${m.text()}::${e.name}", f, no_stmt, e.name, DeclKind.Fn, true, "", null, false, null)
        ws.decls.declare(id, e.sig)
        ws.db.set_input(key(Family.Sig, id.index), sig_hash(e.sig))
        for path in paths { ws.decls.minted.set(path, (ws.decls.minted.get(path) ?? []).concat([id])) }
        made = made + 1
    }
    made
}

/// MINT A HELD MODULE from its record — decode its entries and register them.
///
/// IT REFUSES PER ENTRY, not per record: an entry that does not round-trip is
/// dropped and the rest stand, because a record with one bad spelling is a record
/// whose other spellings are still good.
// LICENSED I39: the MINTING'S ENTRY POINT — a record's text and the module it belongs to in, the count registered out.
export fn mint_record(mut ws: Workspace, m: ModulePath, text: string) -> int {
    let lines = recorded_entries(text)
    let decoded = [minted_entry(ws.decls.types, line) for line in lines]
    let entries = [e for e in decoded if e != null]
    mint_held(ws, m, [e! for e in entries])
}

// ── (c): THE WALK, CONSULTED ────────────────────────────────────────

/// MINT EVERY MODULE WHOSE RECORD STILL HOLDS, before the program is analysed.
///
/// This is where the walk stops being an identity and starts being a saving: a
/// module whose record validates contributes its EXPORTED SIGNATURES from the
/// record, and nothing else in the program can tell the difference.
///
/// THE ONLY THING IT CAN GET WRONG IS SILENCE, so it is deliberately boring: a
/// module with no record, or with a record that does not validate, is left exactly
/// as it was. There is no path here that makes a program faster by assuming
/// something — only one that declines to.
// LICENSED I39: THE DRIVER'S OPENING MOVE — a workspace and its cache directory in, the count minted out.
export fn mint_held_modules(mut ws: Workspace, dir: string) -> int {
    mut made = 0
    for path in ws.root_files() {
        let m = module_path(ws.module_of(path).split("."))
        if surface_holds(ws, dir, m) {
            let text = read_text(record_path(dir, bytes_key(ws, m))) catch ""
            made = made + mint_record(ws, m, text)
        }
    }
    made
}

// ── THE BODY HALF: PER-FILE IR ──────────────────────────────────────

/// WHAT A BUILD EMITTED, and HOW MUCH OF IT IT REUSED.
///
/// THE COUNT IS THE POINT AND IT IS TAKEN BY THE MECHANISM ITSELF. A differential
/// proves the output is right; it cannot see whether any work was skipped, and the
/// failure that hides there is a rung that is CORRECT AND NOT FASTER — green
/// everywhere, and worth nothing. So the number is produced where the decision is
/// made rather than reconstructed later by someone who wonders.
export type Emitted = { modules: List<string>, reused: int, emitted: int }

/// EMIT THE PROGRAM AS ONE MODULE PER FILE, reusing what each file's `unit_key`
/// already holds.
///
/// A FILE'S MODULE IS NAMED BY ITS OWN KEY, so a file whose content and visible
/// signatures are unchanged finds its module and emits nothing. The ENTRY is its
/// own module — `with_entry` decides who defines `main`, and exactly one module
/// may — WHICH IS WHY THE ENTRY FILE GETS NO SEPARATE ONE: emitting its bodies
/// twice is a duplicate symbol at the link.
// LICENSED I39: THE EMISSION DRIVER — a workspace, a lowered program and a directory in, the modules and the counts out.
export fn emit_units(mut ws: Workspace, l: Lowered, dir: string, files: List<FileId>, entry_file: FileId) -> Emitted {
    let _ = make_dirs(dir)
    mut mods: List<string> = []
    mut reused = 0
    mut emitted = 0
    for f in files {
        if !same_file(f, entry_file) {
            let path = joined_path(dir, "${unit_key(ws, f)}.ll")
            if exists(path) { reused = reused + 1 }
            else {
                let failure = emit_module(l, path, false, f)
                if failure == null { emitted = emitted + 1 }
            }
            mods.push(path)
        }
    }
    // THE ENTRY, alone, because it defines `main`.
    let entry_path = joined_path(dir, "${unit_key(ws, entry_file)}.entry.ll")
    let broke = emit_module(l, entry_path, true, entry_file)
    if broke == null { emitted = emitted + 1 }
    mods.push(entry_path)
    Emitted { modules: mods, reused: reused, emitted: emitted }
}
