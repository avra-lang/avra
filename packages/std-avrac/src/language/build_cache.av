//! THE BUILD CACHE — a program's inputs hashed, and the module a
//! previous build of those exact inputs produced reused, so an unchanged
//! program costs a hash rather than an analysis.
//!
//! THE LAW IT EXISTS UNDER: an early-cutoff hash must cover the WHOLE
//! value it certifies. `parsed` cuts off on structural fingerprints while
//! its value carries the source text and every span, so a reindent leaves
//! later spans stale and certified fresh. Here every byte of every input
//! is absorbed, so a whitespace-only edit moves the key and a wrong reuse
//! is impossible by construction rather than by discipline.
//!
//! The key and the names its artifacts are stored under are ONE
//! derivation (`key`), so the store and the lookup cannot fall out of
//! step.
use core.{new_digest, digest_text, digest_key, joined, DeclId, FileId, TypeId, TypeRegistry, ModulePath}
use features.{Namespace, DeclSig}
use @std.path.{joined_path, relative_path}

/// The compiler's format identity, folded first into every key. The
/// compiler's own sources, its backend and its runtime are already key
/// inputs (`Workspace.build_inputs`); this covers only what those files
/// cannot say — a change to how the key itself is derived.
const CACHE_FORMAT: string = "avra-build-cache-1"

/// A build's result: the words that link it, the binary they produce,
/// the warnings to speak, and whether a held artifact was reused.
export type BuildOutcome = { words: List<string>, binary: string, warnings: string, reused: bool, key: string }

/// Where a program's artifacts are kept — beside the program, so a
/// worktree's cache dies with the worktree.
export type BuildCache = { ws: Workspace, root: string, disk: Host }

// LICENSED I39: a CONSTRUCTOR — the workspace in, the cache out. The
// standard shape, like `new_db`.
/// Where a program's artifacts are kept — beside the program, so a
/// worktree's cache dies with the worktree. ONE derivation: the library
/// and the command that keeps the linked binary both name it here.
// LICENSED I39: a pure projection — a workspace in, the directory its artifacts live in out.
export fn build_cache_root(ws: Workspace) -> string { joined_path(ws.root, ".avra-cache") }

/// ARTIFACTS GO TO THE `disk` HOST, never to the source host. They are
/// different things and a LONE FILE is exactly where they diverge: its
/// workspace host is in memory, so routing the module through it wrote the
/// .ll/.plan/.warn into a map that died with the process while the binary
/// reached the real disk.
// LICENSED I39: a CONSTRUCTOR — the workspace and the artifact host in, the cache out.
export fn build_cache(ws: Workspace, disk: Host) -> BuildCache {
    BuildCache { ws: ws, root: build_cache_root(ws), disk: disk }
}

impl BuildCache {
    /// The key these inputs and this mode are stored under.
    fn key(entry: string, mode: string) -> string {
        mut d = new_digest()
        d = digest_text(d, CACHE_FORMAT)
        d = digest_text(d, mode)
        d = digest_text(d, self.rooted(entry))
        for f in self.ws.build_inputs() {
            d = digest_text(d, self.rooted(f))
            d = digest_text(d, self.ws.host.read(f))
        }
        digest_key(d)
    }

    /// A path as the key spells it: relative to the program's root, so
    /// two checkouts of one source share their artifacts.
    fn rooted(path: string) -> string { relative_path(self.ws.root, path) }

    /// One artifact, or null — `exists` first, because a host that
    /// refuses a missing read is entitled to say so loudly.
    fn held(key: string, suffix: string) -> string? {
        let path = joined_path(self.root, "${key}${suffix}")
        if !self.disk.exists(path) { return null }
        self.disk.read(path)
    }

    /// A held build put where a fresh one would have written it, or null
    /// when nothing is held or the module cannot be placed — so a partial
    /// entry self-heals into a miss rather than a wrong link.
    fn reuse(entry: string, key: string) -> BuildOutcome? {
        let module = self.held(key, ".ll")
        if module == null { return null }
        let plan = self.held(key, ".plan")
        if plan == null { return null }
        let ll = "${entry}.ll"
        if self.disk.write(ll, module!) != null { return null }
        BuildOutcome { words: plan!.split("\n"), binary: binary_name(ll), warnings: self.held(key, ".warn") ?? "", reused: true, key: key }
    }

    /// Keep a fresh build's module, plan and warnings under its key.
    fn keep(entry: string, key: string, words: List<string>, warnings: string) {
        let _ = self.disk.write(joined_path(self.root, "${key}.ll"), self.disk.read("${entry}.ll"))
        let _ = self.disk.write(joined_path(self.root, "${key}.plan"), joined(words, "\n"))
        let _ = self.disk.write(joined_path(self.root, "${key}.warn"), warnings)
    }
}

/// A program built: the words that link it, reused when these exact
/// inputs were built before, else analyzed, lowered and emitted now.
/// `.Err` is the refusal to report, and A REFUSAL IS NEVER KEPT — a bad
/// program is reported on every run and cached never.
// LICENSED I39: THE ENTRY POINT, which I39 exempts by name — the one
// standard signature `build_program(ws, entry, …)`. `disk` is the artifact host.
// LICENSED I39: THE ENTRY POINT, which I39 exempts by name.
export fn build_program(ws: Workspace, entry: string, mode: string, opt: string, runtime: string, disk: Host) -> Result<BuildOutcome, string> {
    let cache = build_cache(ws, disk)
    let key = cache.key(entry, mode)
    let held = cache.reuse(entry, key)
    if held != null { return .Ok(held!) }
    emitted(cache, ws.program(entry), entry, key, opt, runtime)
}

// LICENSED I39: the build's TWO PHASES, not a pass's vocabulary —
// `build_program` is the entry point and keeps the one standard signature
// (I39's own exemption), and this is its split at the phase boundary.
fn emitted(cache: BuildCache, p: Program, entry: string, key: string, opt: string, runtime: string) -> Result<BuildOutcome, string> {
    if !p.clean() { return .Err(p.report()) }
    let view = p.entry_file()
    if view == null { return .Err(p.rendered([no_target(p.ws.root)])) }
    if view!.view.stmts.is_empty() { return .Err("the program is empty") }
    let lo = p.lowered_checked()?
    let ll = "${view!.view.source.file}.ll"
    let failure = emit_ll(lo, ll)
    if failure != null { return .Err(failure!) }
    let words = link_words(ll, p.ws, opt, runtime)
    let warnings = p.warnings()
    cache.keep(entry, key, words, warnings)
    .Ok(BuildOutcome { words: words, binary: binary_name(ll), warnings: warnings, reused: false, key: key })
}

/// clang's words for a module: the level, the runtime, the packages' own
/// objects and flags, then the binary's path. The runtime object is passed
/// in — it is a TOOLCHAIN fact found from the binary's own directory, and a
/// lone file's host is in memory and knows nothing of a disk.
// LICENSED I39: a pure PROJECTION — a path, an opt level and a toolchain
// fact in, clang's words out. It owns no state and takes the workspace
// second, because the module's path is what it is about.
fn link_words(ll_path: string, ws: Workspace, opt: string, runtime: string) -> List<string> {
    ["-w", opt, "-rdynamic", ll_path, runtime].concat(ws.link_words()).concat(["-o", binary_name(ll_path)])
}

/// `x.av.ll` builds `x`.
export fn binary_name(ll_path: string) -> string {
    let base = if ll_path.ends_with(".ll") { ll_path.substring(0, ll_path.length - 3) } else { ll_path }
    if base.ends_with(".av") { base.substring(0, base.length - 3) } else { base }
}

// ── THE PER-UNIT KEY ────────────────────────────────────────────────

// ── THE MODULE INTERFACE'S IDENTITY ──────

/// WHAT ANOTHER MODULE SEES of this one, as one key.
///
/// THE INTERFACE IS THE CONTRACT, so its key names the WHOLE contract, and it
/// names it the SOUND way: the module's own sources AND the fingerprints of
/// everything those sources can SEE. The second half is not padding — a
/// signature can name a type from an import, so `fn f(x: util.Pair)` must move
/// when `util.Pair` changes, and a key over the module's own bytes alone misses
/// exactly that. THE OVER-APPROXIMATION IS DELIBERATE and it is the safe
/// direction: it can invalidate a dependent that did not need it, never certify
/// one that did.
///
/// It folds `stable_sig`, never `sig_hash` — an interface outlives one run, and
/// a key over interned ordinals moves whenever any new type is interned
/// anywhere, which would invalidate every dependent on an unrelated edit.
// LICENSED I39: a KEY DERIVATION — a pure projection of one module's sources and what they can see.
export fn module_surface(mut ws: Workspace, m: ModulePath) -> string {
    mut d = new_digest()
    d = digest_text(d, CACHE_FORMAT)
    for path in ws.module_files(m) {
        let f = ws.file_id(path)
        d = digest_text(d, ws.source(f).text)
        let ns: Namespace = ws.visible(f)
        for n in ns.fn_names { d = digest_text(d, sig_of(ws, ns.fns.get(n))) }
        for n in ns.type_names { d = digest_text(d, sig_of(ws, ns.types.get(n))) }
    }
    digest_key(d)
}

// ── A STABLE IDENTITY ───────────────────────────────────────────────

/// A TYPE'S STABLE IDENTITY — its spelled SHAPE, never its interned ordinal.
///
/// A `TypeId` is a dense index into the workspace's registry, so introducing a
/// type anywhere shifts the ordinals and every signature that mentions a type
/// shifts with them. A key over such a number is a function of the GLOBAL
/// INTERNING ORDER, and an unrelated edit then invalidates every file — the DUAL
/// of the whole-value law, and just as much a key defect.
// LICENSED I39: a pure PROJECTION — a registry and a type in, its spelling out.
fn stable_type(types: TypeRegistry, id: TypeId) -> string { types.name_of(id) }

/// A SIGNATURE'S STABLE TEXT — the whole signature, every type by its spelling.
/// `sig_hash` stays exactly right for the memo kernel's IN-PROCESS cutoff, where
/// the ordinals are fixed for the run; a key that OUTLIVES the run may not fold
/// them. A default is folded as its PRESENCE, never its `DeclId` ordinal.
// LICENSED I39: a pure PROJECTION — a registry and a signature in, its stable text out.
fn stable_sig(types: TypeRegistry, s: DeclSig?) -> string {
    if s == null { return "" }
    match s! {
        .Fn(f) -> "fn(${joined([stable_type(types, t) for t in f.params], ",")})${stable_type(types, f.ret)}",
        .Record(r) -> "rec(${joined(r.names, ",")}|${joined([stable_type(types, t) for t in r.types], ",")}|${joined([if d == null { "_" } else { "d" } for d in r.defaults], "")})",
        .Enum(e) -> "enum(${joined(e.names, ",")}|${joined([joined([stable_type(types, t) for t in payload], ",") for payload in e.payloads], ";")})",
        .Named(n) -> "named(${stable_type(types, n.of)})",
    }
}

/// A name's signature, ASKED (the table fills only when asked) and rendered by
/// its STABLE spelling.
/// THE SIG IS ASKED, NOT READ OUT OF THE TABLE: `decls.sigs` fills only when a
/// signature is computed, so reading it directly answers nothing for every name
/// whose sig has not happened to be needed yet — a key blind to exactly the
/// change it exists to see.
// LICENSED I39: a pure PROJECTION — a workspace and a name in, the signature's stable text out.
fn sig_of(mut ws: Workspace, id: DeclId?) -> string {
    if id == null { return "" }
    stable_sig(ws.decls.types, ws.sig(id!))
}

/// THE UNIT KEY — one declaration's file's bytes, and the fingerprints of
/// every signature that file can SEE.
///
/// The sigs a unit READ are found by EXECUTION (the kernel records them on
/// the cell), and a cache LOOKUP may not execute — so the key takes the
/// file's VISIBLE namespace instead. That over-approximates what was read,
/// and the direction is the sound one: it can invalidate a unit that did
/// not need it, never certify one that did.
///
/// THE LAW IT EXISTS TO HOLD is the whole design's assumption, and it is
/// WITNESSED beside the whitespace and comment rows: a unit whose SEAT
/// changed while its own body did not must MISS. A key over the file's
/// bytes alone would be blind to exactly that change — which is why the
/// visible signatures are folded in below.
// LICENSED I39: a KEY DERIVATION — a pure projection of one file's bytes and the signatures it can see, called from `avra keys` and the cache alone.
export fn unit_key(mut ws: Workspace, f: FileId) -> string {
    mut d = new_digest()
    d = digest_text(d, CACHE_FORMAT)
    d = digest_text(d, ws.source(f).text)
    let ns: Namespace = ws.visible(f)
    for n in ns.fn_names { d = digest_text(d, sig_of(ws, ns.fns.get(n))) }
    for n in ns.type_names { d = digest_text(d, sig_of(ws, ns.types.get(n))) }
    digest_key(d)
}
