//! The memory pass: strategy per scope, decided by its LEVEL.
//! Lowering emitted pure semantics; this pass inserts the memory
//! instructions each scope's strategy demands. Today every scope is
//! Application — reference counting, releases in reverse binding
//! order. The calling convention is CALLEE-CLEANS: the caller
//! retains each managed argument (ownership transfers in), the
//! callee's params arrive owned and release at its exit minus what
//! RetVal keeps, and the caller owns the call's result. Systems
//! ownership lands here later as a strategy, touching neither
//! lowering nor the backend.
use core.{Ins, Reg, Level, TypeId, TypeRegistry, Stack, new_stack, dst_of, reads_of, same_reg, rt_owns, rt_lends, rt_owned_twin, reversed}

/// Managed registers bound in one open scope, its tier remembered.
export type Scope = { tier: Level, managed: List<Reg>, cells: List<Reg> }

export fn memory(l: Lowered) -> Lowered {
    let fns = [b with { ins: memory_ins(l.types, b.reg_types, b.ins, managed_params(l.types, b)) }
               for b in l.fns]
    let entry = l.entry with { ins: memory_ins(l.types, l.entry.reg_types, l.entry.ins, []) }
    l with { fns: fns, entry: entry }
}

/// THE strategy's managed law: strings AND the aggregate shapes —
/// the ownership milestone. `Opt` is INVISIBLE here: a niche
/// nullable IS its carried value, and the runtime's rc ops no-op
/// on the null pointer by construction. Distinct from core's
/// ptr_shape (what RIDES pointers): TypeName/Var never mint
/// registers, and scalars have nothing to reclaim.
export fn is_managed(types: TypeRegistry, ty: TypeId) -> bool {
    match types.shape_of(ty) {
        .Str -> true,
        // A FLAT RECORD IS ITS FIELD: a record of words holds no
        // reference, a NAME over a list holds the list's.
        .Struct(_, _) -> flat_managed(types, ty),
        // EmptyList is the one identity widen whose pointer is a
        // REAL box: the callee's List param releases it, so the
        // caller must own it too, or the seam frees a live name.
        .List(_) or .Cell(_) or .Enum(_, _) or .EmptyList or .Map(_, _) or .EmptyMap or
        .Res(_, _) or .App(_, _, _) or .Dyn(_, _) or .Fn(_, _, _) -> true,
        // a FLAT record's nullable is a one-slot BOX — counted,
        // though the bare record never is
        .Opt(inner) -> types.is_flat(inner) || is_managed(types, inner),
        .Ptr or .Int or .Float or .Bool or .TypeName(_, _) or .Var(_, _, _) or .Null or
        .Error or .Void -> false,
    }
}

/// A RECORD's own answer: a flat one IS its one field, so it is
/// managed exactly when the field is; a boxed one always counts.
fn flat_managed(types: TypeRegistry, ty: TypeId) -> bool {
    if !types.is_flat(ty) { return true }
    is_managed(types, types.flat_fields(ty)[0])
}

/// A fn's managed params — they arrive owned, so its first scope
/// owns them from birth.
fn managed_params(types: TypeRegistry, b: Body) -> List<Reg> {
    mut out: List<Reg> = []
    for j, pt in b.params {
        if is_managed(types, pt) { out.push(Reg { index: j }) }
    }
    out
}

/// One body's memory instructions. `seed` joins the outermost scope
/// at its open; every scope's exit names what escapes it.
fn memory_ins(types: TypeRegistry, reg_types: List<TypeId>, ins: List<Ins>, seed: List<Reg>) -> List<Ins> {
    mut out: List<Ins> = []
    mut open_scopes: Stack<Scope> = new_stack()
    for at, raw in ins {
        let i = owned_form(types, reg_types, ins, at, raw)
        match i {
            .ScopeEnter(tier) -> {
                // LICENSED I15: a scope STACK walked by the pass, not a bracket body
                open_scopes.push(Scope { tier: tier, managed: [], cells: [] })
                if open_scopes.depth() == 1 {
                    for r in seed { takes(open_scopes, r) }
                }
                out.push(i)
            }
            // A scope YIELDS like a branch: released never here,
            // adopted by the enclosing scope (ownership moves out
            // one scope; at the outermost it escapes to the caller).
            .ScopeExit(gives) -> {
                let scope = open_scopes.pop() ?? empty_scope()
                // LICENSED I3: the pass's OUTPUT accumulates; `.concat()` per scope copies it all
                for s in scope.settled(gives) { out.push(s) }
                // a yield is retained only where something RECEIVES
                // it: an enclosing scope adopts, or — at the
                // outermost — the CALLER takes it as the answer, and
                // the reference it carries is the one already held
                if !open_scopes.is_empty() {
                    // LICENSED I3: the pass's OUTPUT accumulates
                    for s in moved_out(types, reg_types, scope, gives) { out.push(s) }
                    adopts(types, reg_types, open_scopes, gives)
                }
                out.push(i)
            }
            // A branch is a scope at its enclosing tier. Its yield
            // escapes to the merge: the branch never releases it —
            // the enclosing scope owns `dst`, the merge of both.
            .IfStart(_) or .SwitchStart(_, _) -> {
                // LICENSED I15: a scope STACK walked by the pass, not a bracket body
                open_scopes.push(nested_scope(open_scopes))
                out.push(i)
            }
            .ArmEnd(gives) -> {
                let scope = open_scopes.pop() ?? empty_scope()
                // LICENSED I3: the pass's OUTPUT accumulates; `.concat()` per scope copies it all
                for s in scope.settled(gives) { out.push(s) }
                // LICENSED I3: the pass's OUTPUT accumulates
                for s in moved_out(types, reg_types, scope, gives) { out.push(s) }
                // LICENSED I15: a scope STACK walked by the pass, not a bracket body
                open_scopes.push(nested_scope(open_scopes))
                out.push(i)
            }
            .RegionEnd(_, gives) -> {
                let scope = open_scopes.pop() ?? empty_scope()
                // LICENSED I3: the pass's OUTPUT accumulates; `.concat()` per scope copies it all
                for s in scope.settled(gives) { out.push(s) }
                // LICENSED I3: the pass's OUTPUT accumulates
                for s in moved_out(types, reg_types, scope, gives) { out.push(s) }
                manages(types, reg_types, open_scopes, i)
                out.push(i)
            }
            // The caller's half of callee-cleans: retain what the
            // callee will release. The indirect call wears the same
            // ABI — a binding cannot ride an or-arm, so the arm is
            // spelled twice; the law once.
            .Call(_, _, args) -> {
                // LICENSED I3: the pass's OUTPUT accumulates
                for r in retained_args(types, reg_types, args) { out.push(r) }
                manages(types, reg_types, open_scopes, i)
                out.push(i)
            }
            .CallPtr(_, _, args) -> {
                // LICENSED I3: the pass's OUTPUT accumulates
                for r in retained_args(types, reg_types, args) { out.push(r) }
                manages(types, reg_types, open_scopes, i)
                out.push(i)
            }
            // An EARLY exit settles EVERY open scope's debts at the
            // site — nothing pops, because other paths continue.
            .FnExit(gives) -> {
                // LICENSED I3: the pass's OUTPUT accumulates
                for c in exit_cells(open_scopes) { out.push(cell_settle(c)) }
                for r in exit_releases(open_scopes, gives) { out.push(Ins.Release(r)) }
                out.push(i)
            }
            // THE MUT-CELL PROTOCOL: the cell owns ONE reference.
            // A store RETAINS the incoming value FIRST (a self-store
            // must not free what it is keeping), then releases what
            // the cell held. The cell's own reference settles when
            // its scope does.
            .Alloca(dst) -> {
                if is_managed(types, reg_types[dst.index]) && !open_scopes.is_empty() {
                    holds_cell(open_scopes, dst)
                }
                out.push(i)
            }
            // A STORE SETTLES BY THE CELL'S TYPE, never the value's:
            // `x = null` into a managed cell releases what x held.
            .Store(slot, src) -> {
                if is_managed(types, reg_types[slot.index]) {
                    if is_managed(types, reg_types[src.index]) { out.push(Ins.Retain(src)) }
                    // EVERY store settles what the cell held: a fresh
                    // cell holds nothing (the alloca nulls it), and a
                    // store inside a loop runs many times where the
                    // pass sees it once
                    out.push(cell_settle(slot))
                }
                out.push(i)
            }
            // A managed LOAD is a BORROW of the cell's reference —
            // it earns its own +1 only when it must OUTLIVE it.
            // Retain and ownership travel together: a borrow the
            // scope does not own is a release it must not emit.
            .Load(dst, slot) -> {
                out.push(i)
                if is_managed(types, reg_types[dst.index]) && borrow_outlives(types, reg_types, ins, at, dst, slot) {
                    out.push(Ins.Retain(dst))
                    manages(types, reg_types, open_scopes, i)
                }
            }
            // THE CONDITION RUNS EVERY TURN: what it mints is settled
            // at each LoopCond, never at the enclosing scope's exit —
            // a release placed after the loop settles one turn's
            // debts for all of them, and every other turn's owned
            // load leaks (and, holding a reference, turns each write
            // in the body into a copy).
            .LoopStart -> {
                // LICENSED I15: a scope STACK walked by the pass, not a bracket body
                open_scopes.push(nested_scope(open_scopes))
                out.push(i)
            }
            .LoopCond(_) -> {
                let scope = open_scopes.pop() ?? empty_scope()
                // LICENSED I3: the pass's OUTPUT accumulates
                for s in scope.settled(null) { out.push(s) }
                out.push(i)
            }
            // A FLAT RECORD'S PACK IS IDENTITY, so the destination is
            // a SECOND NAME for the part's box and takes its OWN
            // reference — the part keeps the one it had, and the
            // scope settles both. (Every other pack is a scalar
            // pair, which owns nothing.) Its twin `Extract` is a
            // VIEW and owns nothing, which `managed_dst` says.
            .Pack(dst, _) -> {
                out.push(i)
                if is_managed(types, reg_types[dst.index]) { out.push(Ins.Retain(dst)) }
                manages(types, reg_types, open_scopes, i)
            }
            .ConstInt(_, _) or .ConstFloat(_, _) or .ConstStr(_, _) or .ConstBool(_, _) or
            .Bin(_, _, _, _) or .Un(_, _, _) or .FnAddr(_, _) or .StaticAddr(_, _) or
            .CallRt(_, _, _) or .CallRtVoid(_, _) or .Release(_) or
            .Extract(_, _, _) or .LoopEnd or
            .Retain(_) or .RetVal(_) or .Ret(_) -> {
                manages(types, reg_types, open_scopes, i)
                out.push(i)
            }
        }
    }
    out
}

/// A managed LOAD is a BORROW: the cell holds one reference and
/// the loaded register rides it. The borrow earns its own +1 only
/// when it must OUTLIVE that reference — it is given UPWARD, or a
/// use of it (or of a borrow taken from it) stands past a step
/// that could change the cell, or past a bracket. Conservative by
/// construction: what the scan cannot read as safe owns.
///
/// THE +1 IS NOT BOOKKEEPING. `avra_cell_unique` copies only when
/// the count is above one, so a borrow that does NOT retain is
/// exactly what lets a write land in place — the retain was what
/// made a read-then-write clone.
///
/// WHAT THE SCAN DOES NOT ASK, and why it need not: a runtime row
/// handed the borrow. A row BORROWS its arguments, and a C body
/// that KEEPS what it was handed takes its own reference — that
/// law (CLAUDE.md) is what makes a stored borrow safe, and it held
/// before this pass counted uses. A row that keeps without
/// retaining is a dangling store whether the read owns or not.
fn borrow_outlives(types: TypeRegistry, reg_types: List<TypeId>, ins: List<Ins>, at: int, dst: Reg, slot: Reg) -> bool {
    mut views: List<Reg> = [dst]
    mut last = at
    mut j = at + 1
    while j < ins.length {
        let i = ins[j]
        if reads_of(i).any(held_by(views, it)) {
            if gives_upward(i) { return true }
            last = j
            let d: Reg? = view_of(i)
            if d != null && is_managed(types, reg_types[d!.index]) { views.push(d!) }
        }
        j = j + 1
    }
    mut k = at + 1
    while k <= last {
        if brackets(ins[k]) || changes_cell(ins[k], slot) { return true }
        k = k + 1
    }
    false
}

/// One of the borrows taken from the load.
fn held_by(views: List<Reg>, r: Reg) -> bool {
    views.any(same_reg(it, r))
}

/// A step that could CHANGE what the cell holds: a store to it, or
/// any step handed the cell itself — a writing callee opens it
/// there. A second load only reads it.
///
/// COMPLETE, not merely conservative, and that is what the scan
/// rests on. A cell register is an `Alloca` destination, and every
/// consumer of one in the tree is a `Load`, a `Store`,
/// `avra_cell_unique` or this pass's own `avra_cell_release`: a
/// cell is never packed, never an argument to a user callee, never
/// aliased into a second register. The day one escapes, this test
/// goes BLIND and the scan is unsound rather than pessimistic.
/// The `.Load` exemption rests on the second half: a borrow root's
/// write loads the cell and writes THROUGH the box (places.av), so
/// it never re-points the cell. Widen that and the exemption goes
/// with it.
fn changes_cell(i: Ins, slot: Reg) -> bool {
    if i is .Load { return false }
    reads_of(i).any(same_reg(it, slot))
}

/// Every BRACKET in the stream. A borrow whose use stands across
/// one may outlive the cell, so the scan refuses to reason past it.
fn brackets(i: Ins) -> bool {
    i is .ScopeEnter || i is .ScopeExit || i is .IfStart || i is .SwitchStart ||
        i is .ArmEnd || i is .RegionEnd || i is .LoopStart || i is .LoopCond || i is .LoopEnd
}

/// The uses that give a value UPWARD — out of its scope, into a
/// cell, or into an aggregate. A borrow that escapes must own.
fn gives_upward(i: Ins) -> bool {
    i is .ScopeExit || i is .ArmEnd || i is .RegionEnd || i is .RetVal ||
        i is .FnExit || i is .Store || i is .Pack
}

/// A NON-OWNING read makes ANOTHER borrow of the same box — the
/// child rides the parent's reference, so its uses are the
/// parent's. Only a MANAGED child does: a scalar pulled out of a
/// box is a copied word and holds nothing.
fn view_of(i: Ins) -> Reg? {
    match i {
        .Extract(d, _, _) -> d,
        .CallRt(d, callee, _) -> if rt_owns(callee) { null } else { d },
        // A REGISTRY: every arm is spelled, so the day a
        // value-carrying instruction lands the build refuses until
        // this answers for it. A call's answer is the caller's own
        // reference, never a view of an argument.
        .ConstInt(_, _) or .ConstFloat(_, _) or .ConstStr(_, _) or .ConstBool(_, _) or
        .Bin(_, _, _, _) or .Un(_, _, _) or .CallRtVoid(_, _) or
        .Pack(_, _) or .FnAddr(_, _) or .StaticAddr(_, _) or .ScopeEnter(_) or
        .ScopeExit(_) or .IfStart(_) or .SwitchStart(_, _) or
        .ArmEnd(_) or .RegionEnd(_, _) or .Call(_, _, _) or
        .CallPtr(_, _, _) or .RetVal(_) or .FnExit(_) or
        .Alloca(_) or .Load(_, _) or .Store(_, _) or .LoopStart or
        .LoopCond(_) or .LoopEnd or .Retain(_) or .Release(_) or
        .Ret(_) -> null,
    }
}

/// Everything EVERY open scope owes at an early exit, innermost
/// first — the returned value excluded in every open scope.
fn exit_releases(open_scopes: Stack<Scope>, kept: Reg) -> List<Reg> {
    mut out: List<Reg> = []
    // LICENSED I19: a REVERSE walk — innermost debts settle first
    mut j = open_scopes.depth() - 1
    while j >= 0 {
        let scope: Scope = open_scopes.at(j)
        out = out.concat(scope.releases_for(kept))
        j = j - 1
    }
    out
}

/// A scope opened INSIDE another: it inherits the enclosing tier
/// and owns nothing yet.
fn nested_scope(open_scopes: Stack<Scope>) -> Scope {
    Scope { tier: enclosing_tier(open_scopes), managed: [], cells: [] }
}

/// The tier a new scope inherits — its innermost open enclosure.
fn enclosing_tier(open_scopes: Stack<Scope>) -> Level {
    let top: Scope? = open_scopes.top()
    if top == null { return Level.Application }
    top!.tier
}

/// A YIELD THE SCOPE DOES NOT OWN is BORROWED — a parameter, an
/// enclosing scope's binding, an arm that simply names one. What
/// receives it (the merge's register, or the enclosing scope) will
/// own it and release it, so it takes its own reference here. A
/// yield the scope owns MOVES instead: its release is the one the
/// receiver inherits.
fn moved_out(types: TypeRegistry, reg_types: List<TypeId>, scope: Scope, gives: Reg?) -> List<Ins> {
    if gives == null { return [] }
    let r = gives!
    if !is_managed(types, reg_types[r.index]) { return [] }
    // LICENSED I9: register identity, not type agreement
    if scope.managed.any(same_reg(it, r)) { return [] }
    [Ins.Retain(r)]
}

impl Scope {
    /// The strategy: what a scope owes at its exit. `kept` is a value
    /// that escapes the scope and is owned elsewhere.
    fn releases_for(kept: Reg?) -> List<Reg> {
        match self.tier {
            .Application -> kept_out(reversed(self.managed), kept),
            .Systems or .Bare or .Hardware -> [],
        }
    }
}

/// All but ONE entry for the escaping register: a scope may own the
/// same register twice (a nested scope yielded it back), and each
/// entry stands for one reference — only the one that escapes is
/// spared.
fn kept_out(rs: List<Reg>, kept: Reg?) -> List<Reg> {
    mut out: List<Reg> = []
    mut spared = false
    // LICENSED I3: exactly ONE entry is dropped; a filter drops every match
    for r in rs {
        if !spared && !stays(r, kept) { spared = true } else { out.push(r) }
    }
    out
}

/// Held by the scope — not the value escaping through the yield.
fn stays(r: Reg, kept: Reg?) -> bool {
    // LICENSED I9: register identity, not type agreement
    kept == null || r.index != kept!.index
}

/// The innermost scope TAKES a register: a scope is a value, so the
/// scope that owns one more is written back over the old top.
fn takes(mut open_scopes: Stack<Scope>, r: Reg) {
    let held: Scope? = open_scopes.top()
    if held == null { return }
    let top = held!
    let grown = Scope { tier: top.tier, managed: top.managed.concat([r]), cells: top.cells }
    open_scopes.rewrite_top(grown)
}

/// The innermost scope HOLDS a cell — the same rewrite, the other
/// column.
fn holds_cell(mut open_scopes: Stack<Scope>, r: Reg) {
    let held: Scope? = open_scopes.top()
    if held == null { return }
    let top = held!
    let grown = Scope { tier: top.tier, managed: top.managed, cells: top.cells.concat([r]) }
    open_scopes.rewrite_top(grown)
}

/// A scope owning nothing — what an unbalanced stream would pop,
/// which lowering never emits.
fn empty_scope() -> Scope {
    Scope { tier: Level.Application, managed: [], cells: [] }
}

/// A closing scope's yield, adopted by the one outside it: at the
/// OUTERMOST there is none, and the value escapes to the caller.
fn adopts(types: TypeRegistry, reg_types: List<TypeId>, mut open_scopes: Stack<Scope>, gives: Reg?) {
    if gives == null || open_scopes.is_empty() { return }
    if is_managed(types, reg_types[gives!.index]) { takes(open_scopes, gives!) }
}

/// When `i` defines a managed value, the innermost open scope takes
/// ownership of its destination.
fn manages(types: TypeRegistry, reg_types: List<TypeId>, mut open_scopes: Stack<Scope>, i: Ins) {
    let dst: Reg? = managed_dst(types, reg_types, i)
    if dst != null { takes(open_scopes, dst!) }
}

/// A defining instruction's destination when the value is MANAGED
/// (heap-shaped); null for scalars and non-defining instructions.
fn managed_dst(types: TypeRegistry, reg_types: List<TypeId>, i: Ins) -> Reg? {
    let dst: Reg? = dst_of(i)
    if dst == null { return null }
    if !is_managed(types, reg_types[dst!.index]) { return null }
    // Provenance refines the type: a runtime call's result is
    // managed only when the REGISTRY says it owns one — a static
    // answer (bool_text) never earns a release.
    match i {
        .CallRt(_, callee, _) -> if rt_owns(callee) { dst } else { null },
        // static data is immortal: nothing to release, ever
        .StaticAddr(_, _) -> null,
        // A FLAT RECORD'S EXTRACT IS IDENTITY — the register IS its
        // field's — so it is a VIEW of a box somebody else already
        // owns, never a reference of its own (`view_of` says the
        // same; this arm used to disagree, invisibly, while no flat
        // record was managed). A PACK owns, because its arm above
        // retains: the destination is a second holder.
        .Extract(_, _, _) -> null,
        .ConstInt(_, _) or .ConstFloat(_, _) or .ConstStr(_, _) or .ConstBool(_, _) or
        .Bin(_, _, _, _) or .Un(_, _, _) or .Pack(_, _) or
        .FnAddr(_, _) or .Call(_, _, _) or .CallPtr(_, _, _) or .RegionEnd(_, _) or
        .Alloca(_) or .Load(_, _) -> dst,
        .CallRtVoid(_, _) or .ScopeEnter(_) or .ScopeExit(_) or .IfStart(_) or
        .SwitchStart(_, _) or .ArmEnd(_) or .Store(_, _) or .LoopStart or
        .LoopCond(_) or .LoopEnd or .Release(_) or .Retain(_) or .RetVal(_) or
        .FnExit(_) or .Ret(_) -> null,
    }
}

/// The pack/read REWRITE — where compile-time type knowledge
/// becomes the runtime's ownership plan: a store whose VALUE is
/// managed becomes retain-at-pack, a read whose DESTINATION is
/// managed becomes an owned +1 read — each by the registry's OWNED
/// TWIN column. Lowering never chooses; ownership stays this
/// pass's one concern, and no runtime name is spelled here.
fn owned_form(types: TypeRegistry, reg_types: List<TypeId>, ins: List<Ins>, at: int, i: Ins) -> Ins {
    // a pre-filter — the caller's dispatch is exhaustive
    // over Ins; this rewrite touches only the runtime call shapes
    match i {
        .CallRtVoid(callee, args) -> {
            let twin: string? = rt_owned_twin(callee)
            if twin != null && pushes_managed(types, reg_types, args) { Ins.CallRtVoid(twin!, args) } else { i }
        }
        .CallRt(dst, callee, args) -> {
            let twin: string? = rt_owned_twin(callee)
            if twin != null && is_managed(types, reg_types[dst.index]) && (!rt_lends(callee) || read_outlives(types, reg_types, ins, at, dst, args)) { Ins.CallRt(dst, twin!, args) } else { i }
        }
        rest -> i,
    }
}

/// A LENDING read's child is a BORROW of the subject's
/// reference unless it must OUTLIVE it — the same question a slot
/// read asks, with the SUBJECT register standing where the cell
/// does. Declining the owned twin is what leaves the count at one,
/// so the write that follows lands IN PLACE instead of cloning.
fn read_outlives(types: TypeRegistry, reg_types: List<TypeId>, ins: List<Ins>, at: int, dst: Reg, args: List<Reg>) -> bool {
    if args.is_empty() { return true }
    borrow_outlives(types, reg_types, ins, at, dst, args[0])
}

/// A push's VALUE seat (arg 1) holds a managed type.
fn pushes_managed(types: TypeRegistry, reg_types: List<TypeId>, args: List<Reg>) -> bool {
    let v: Reg? = args.last()
    v != null && is_managed(types, reg_types[v!.index])
}

/// The cell's held reference, released through the SLOT — the
/// pass mints no registers, so the runtime reads the cell itself.
fn cell_settle(slot: Reg) -> Ins {
    Ins.CallRtVoid("avra_cell_release", [slot])
}

/// Every open scope's cells at an early exit, innermost first.
fn exit_cells(open_scopes: Stack<Scope>) -> List<Reg> {
    mut out: List<Reg> = []
    // LICENSED I19: a REVERSE walk — innermost debts settle first
    mut j = open_scopes.depth() - 1
    while j >= 0 {
        let scope: Scope = open_scopes.at(j)
        out = out.concat(reversed(scope.cells))
        j = j - 1
    }
    out
}

impl Scope {
    /// What a closing scope owes: its cells settled, last bound first,
    /// then the releases its yield leaves behind.
    fn settled(gives: Reg?) -> List<Ins> {
        [cell_settle(c) for c in reversed(self.cells)].concat([Ins.Release(r) for r in self.releases_for(gives)])
    }
}

/// The caller's retains for a call's managed arguments.
export fn retained_args(types: TypeRegistry, reg_types: List<TypeId>, args: List<Reg>) -> List<Ins> {
    [Ins.Retain(ar) for ar in args if is_managed(types, reg_types[ar.index])]
}
