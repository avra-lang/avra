//! THE QUALIFYING SHARE — how many managed seats have a callee that
//! only READS them. Callee-cleans makes the caller retain every
//! managed argument and the callee release it, so a seat the callee
//! never keeps costs a retain AND its paired release for nothing;
//! that pair is what a conditional ABI would stop spending.
//!
//! IT IS A FLOOR, and the floor is what makes it decidable: a seat
//! handed to another Avra fn counts as escaping, because a callee's
//! own disposition needs a fixpoint over the call graph. So the true
//! share is at least this, and the fixpoint changes the size, never
//! the sign.
//!
//! IT WAS A BRACKET UNTIL `RtSig.keeps` LANDED. A runtime row borrows
//! its arguments, but the `_owned` twins take their own reference and
//! nothing declared which — so every row seat had to be counted both
//! ways, and the answer spanned 8.6% to 47.8%. One column collapsed
//! it to a number.
use core.{Ins, Reg, TypeId, TypeRegistry, escapes_in, seat_regs, call_symbol, flatten, joined}

/// A body's managed seats, and which of them the body only reads.
type BodySeats = { name: string, managed: List<int>, reads: List<int> }

/// The whole program's seats: how many are managed, and how many a
/// callee only reads.
export type SeatCensus = { bodies: int, seats: int, reads: int, lines: List<string> }

export fn seat_census(l: Lowered) -> SeatCensus {
    let rows = [body_seats(l.types, b) for b in l.fns]
    SeatCensus {
        bodies: l.fns.length,
        seats: flatten([r.managed for r in rows]).length,
        reads: flatten([r.reads for r in rows]).length,
        lines: [seat_line(r) for r in rows if !r.managed.is_empty()],
    }
}

/// The census as text — the share first, the bodies under it.
export fn render_census(c: SeatCensus) -> string {
    joined([
        "seats: ${c.seats} managed, across ${c.bodies} bodies",
        "read-only: ${c.reads} — a FLOOR: a seat handed to another fn counts as escaping",
    ].concat(c.lines), "\n")
}

fn body_seats(types: TypeRegistry, b: Body) -> BodySeats {
    let managed = managed_seats(types, b)
    BodySeats {
        name: b.name,
        managed: managed,
        reads: [j for j in managed if !escapes(b.ins, seat_reg(j))],
    }
}

/// The seat indexes at which a body's params hold managed values —
/// the params ARE registers 0..N-1, in order.
fn managed_seats(types: TypeRegistry, b: Body) -> List<int> {
    [j for j, pt in b.params if is_managed(types, pt)]
}

/// A seat's register: the params ARE registers 0..N-1, in order.
fn seat_reg(j: int) -> Reg {
    Reg { index: j }
}

/// Does any instruction let `r` outlive the body?
fn escapes(ins: List<Ins>, r: Reg) -> bool {
    ins.any(escapes_in(it, r))
}

fn seat_line(r: BodySeats) -> string {
    "  ${r.name}: ${r.reads.length}/${r.managed.length} read-only"
}

// ── THE RETAIN HISTOGRAM ───────────────────────────────────────────
//
// WHY EACH RETAIN WAS EMITTED, over the whole program. The memory
// pass has FOUR emitters and they answer different questions: a CALL
// SEAT is the conditional ABI's only target, while a cell store, an
// owned load and a scope's yield are state-shaped and no ABI reaches
// them. So THE SEAT SHARE BOUNDS THE ABI BEFORE ANY WEIGHTING — if
// seats are a small fraction of emissions, the ceiling is small
// however the traffic is distributed, and the dynamic join never has
// to exist.
//
// COUNTED THROUGH THE PASS'S OWN RULES, never a copy: `is_managed` is
// the rule its store and seat arms apply, reached through registries
// in core that spell every instruction. THE REMAINDER IS ONE BUCKET,
// deliberately: an owned load's retain needs `borrow_outlives` and
// the PRE-pass index, and a yield's needs the open scope, so they are
// reported together as `state` rather than split by guessing from
// position — a count that reads the layout is the mistake this tree
// keeps paying for.

/// Retain emissions by REASON. `state` is the owned loads and scope
/// yields together — both state-shaped, neither an ABI target.
export type RetainTally = { total: int, seat: int, store: int, state: int, seat_reads: int }

export fn retain_tally(l: Lowered) -> RetainTally {
    let reads = read_only_seats(l)
    let rows = [body_tally(l.types, reads, b) for b in l.fns.concat([l.entry])]
    RetainTally {
        total: summed([r.total for r in rows]),
        seat: summed([r.seat for r in rows]),
        store: summed([r.store for r in rows]),
        state: summed([r.state for r in rows]),
        seat_reads: summed([r.seat_reads for r in rows]),
    }
}

export fn render_tally(t: RetainTally) -> string {
    joined([
        "retains: ${t.total} emitted",
        "  seat:  ${t.seat} — a call's managed argument, the ABI's ONLY target",
        "  store: ${t.store} — a managed value into a managed cell",
        "  state: ${t.state} — an owned load or a scope's yield, together",
        "of the ${t.seat} seat retains, ${t.seat_reads} are handed to a callee that only READS",
    ], "\n")
}

/// Every body's read-only seat indexes, by symbol — the callee-side
/// answer a caller cannot compute for itself.
fn read_only_seats(l: Lowered) -> Map<string, List<int>> {
    mut out: Map<string, List<int>> = {}
    for b in l.fns { out.set(b.name, body_seats(l.types, b).reads) }
    out
}

fn body_tally(types: TypeRegistry, reads: Map<string, List<int>>, b: Body) -> RetainTally {
    let store = [i for i in b.ins if retains_a_store(types, b.reg_types, i)].length
    let total = [i for i in b.ins if i is .Retain].length
    let seat = summed([managed_args(types, b.reg_types, i).length for i in b.ins])
    RetainTally {
        total: total, seat: seat, store: store, state: total - seat - store,
        seat_reads: summed([reading_seats(types, b.reg_types, reads, i) for i in b.ins]),
    }
}

/// The managed arguments of an Avra call — exactly what the pass
/// retains, by the same `is_managed` rule.
fn managed_args(types: TypeRegistry, reg_types: List<TypeId>, i: Ins) -> List<Reg> {
    [a for a in seat_regs(i) if is_managed(types, reg_types[a.index])]
}

/// How many of this call's managed seats the CALLEE only reads. A
/// `CallPtr` names no body, so its seats never count — the caller-side
/// floor, and the right one: a fn value may be anything.
fn reading_seats(types: TypeRegistry, reg_types: List<TypeId>, reads: Map<string, List<int>>, i: Ins) -> int {
    let sym: string? = call_symbol(i)
    if sym == null { return 0 }
    let seats: List<int>? = reads.get(sym!)
    if seats == null { return 0 }
    [j for j, a in seat_regs(i) if is_managed(types, reg_types[a.index]) && seats!.contains(j)].length
}

/// The pass's store rule through the same `is_managed`: a store
/// retains when BOTH the cell and the value are managed. ONE arm
/// answers, so the catch-all is the projection's and it pins the
/// answer for instructions that do not exist yet — nothing but a
/// store retains as one. The rule lives HERE, with the pass that
/// holds it, and not beside the instruction it asks about.
fn retains_a_store(types: TypeRegistry, reg_types: List<TypeId>, i: Ins) -> bool {
    match i {
        .Store(slot, src) -> [slot, src].all(is_managed(types, reg_types[it.index])),
        _ -> false,
    }
}

fn summed(xs: List<int>) -> int {
    mut n = 0
    for x in xs { n = n + x }
    n
}
