//! Traits, impls and methods: a trait's method sigs (self omitted),
//! an impl's methods under their target (self typed as the target),
//! the impl-for contract (every trait method, exactly, nothing
//! beyond), the orphan rule, and the voices these laws speak.
use core.{StmtId, TypeId, DeclId, FnParts, ImplParts, Type}
use diagnostics.{refusal}
use features.{FnSig, DeclSig, fn_sig_of, trait_named, method_sig_of, Decl}

impl Typer {
    fn declare_trait_sig(self, f: StmtId) {
        let parts: FnParts? = self.view.store.fn_parts(f)
        if parts == null { return }
        let fp = parts!
        if !selfed(fp.params) { return self.selfless_sig(f, fp.name) }
        self.declare(f, DeclSig.Fn(FnSig {
            params: self.seatless_params(f, fp),
            ret: self.annotated(f, fp.ret),
        }))
    }

    /// The params BEYOND the self seat, annotated — what a trait
    /// sig declares, and what a method's sig appends to its target.
    fn seatless_params(self, f: StmtId, fp: FnParts) -> List<TypeId> {
        mut ptypes: List<TypeId> = []
        // LICENSED I3: the self seat is skipped; comprehensions cannot skip the head
        for j, pp in fp.params {
            if j > 0 { ptypes.push(self.annotated(f, pp.ty)) }
        }
        ptypes
    }

    /// The trait a name stands for, in this file's scope.
    fn trait_decl_named(self, name: string) -> DeclId? { trait_named(self.view.decls, self.names, name) }

    /// A member's sig under its parent: a trait's method declares
    /// its contract; an impl's method declares under the impl's
    /// verdict — real when the block is lawful, wreckage otherwise.
    fn declare_member(self, x: Decl) {
        if x.parent == null { return self.declare_wreckage(x.stmt) }
        let parent = self.view.decls.decl(x.parent!)
        match parent.kind {
            .Trait -> self.declare_trait_sig(x.stmt),
            .Impl -> self.declare_under_impl(parent.stmt, x.stmt),
            .Fn or .Record or .Enum or .Method or .Default or .Main or .Case or .Builtin -> self.declare_wreckage(x.stmt),
        }
    }

    fn declare_under_impl(self, block: StmtId, f: StmtId) {
        let ip: ImplParts? = self.view.store.impl_parts(block)
        if ip == null { return self.declare_wreckage(f) }
        let parts = ip!
        let target: DeclId? = self.impl_target(block, parts, false)
        if target == null { return self.declare_wreckage(f) }
        let d = target!
        self.view.decls.record_target(self.decl_of(block), d)
        self.enter_target_scope(d)
        self.declare_method(self.impl_self_type(d, parts.target), f)
        self.leave_tscope()
    }

    /// The type an impl's `self` wears: the declared type, or — for
    /// a generic target — its application to its own Vars.
    fn impl_self_type(self, d: DeclId, name: string) -> TypeId {
        if self.view.decls.tparams(d).is_empty() { return self.declared_type(d, name) }
        self.view.types.intern(Type.App(d, name, self.target_vars(d)))
    }

    /// A generic target's Vars, in scope for its impl's signatures
    /// under the names the TYPE declared — `impl Arena<N>` spells
    /// them as `type Arena<N>` did.
    fn target_vars(self, d: DeclId) -> List<TypeId> {
        mut out: List<TypeId> = []
        // LICENSED I3: the ordinal needs the index; comprehensions cannot destructure enumerate
        for (j, n) in self.view.decls.tparams(d).enumerate() { out.push(self.view.types.intern(Type.Var(d, j, n))) }
        out
    }

    fn enter_target_scope(self, d: DeclId) {
        // LICENSED I3: pushing through the field alias — concat would rebind the local
        for v in self.target_vars(d) { self.tscope.push(v) }
    }

    /// The impl block's law: its target is declared, plain, and
    /// this module's (or the trait is); its methods' sigs are asked
    /// and REGISTERED under the target (a name taken twice is the
    /// method table's clash, spoken once per type); then the
    /// contract.
    fn declare_impl_block(self, s: StmtId) {
        let ip: ImplParts? = self.view.store.impl_parts(s)
        if ip == null { return }
        let parts = ip!
        let target: DeclId? = self.impl_target(s, parts, true)
        if target == null { return }
        let d = target!
        self.view.decls.record_target(self.decl_of(s), d)
        // A METHOD MAY WRITE THROUGH `self`. A flat record is a value
        // in a register with no identity, so behaviour would turn on
        // a field count — it keeps its box while receivers alias
        // (ROADMAP: RECEIVER ALIASING).
        self.view.types.unflatten(self.impl_self_type(d, parts.target))
        for f in parts.fns {
            let m = self.decl_of(f)
            let _ = self.view.decls.sig(m)
            if self.registrable(f) { self.view.decls.declare_method(d, m) }
        }
        if parts.of != "" { self.check_trait_impl(s, parts.of, d, parts.target, parts.fns) }
    }

    /// A method the table can serve: plain, and riding `self`.
    fn registrable(self, f: StmtId) -> bool {
        let parts: FnParts? = self.view.store.fn_parts(f)
        parts != null && parts!.tparams.is_empty() && selfed(parts!.params)
    }

    /// The impl's verdict: the target's declaration when the block
    /// is lawful, else absence — spoken only when `loud`.
    fn impl_target(self, s: StmtId, parts: ImplParts, loud: bool) -> DeclId? {
        let target = parts.target
        let decl: DeclId? = self.type_decl_named(target)
        if decl == null {
            if loud { self.no_such_target(s, target) }
            return null
        }
        let d = decl!
        // a generic target lands for an INHERENT impl; a trait impl
        // over one is recorded
        if parts.of != "" && !self.view.decls.tparams(d).is_empty() {
            if loud { self.generic_target(s, target) }
            return null
        }
        if self.orphaned(s, d, parts.of, target, loud) { return null }
        d
    }

    fn declare_wreckage(self, f: StmtId) {
        let parts: FnParts? = self.view.store.fn_parts(f)
        if parts == null { return }
        self.declare(f, DeclSig.Fn(FnSig {
            params: [self.error_type for pp in parts!.params],
            ret: self.error_type,
        }))
    }

    /// THE ORPHAN RULE: an impl lives in its type's module — or in
    /// its trait's, when the trait is this module's.
    fn orphaned(self, s: StmtId, d: DeclId, of: string, target: string, loud: bool) -> bool {
        let owner = self.view.decls.module_of(d)
        if owner == self.view.module() { return false }
        let tr: DeclId? = if of == "" { null } else { self.trait_decl_named(of) }
        if tr != null && self.view.decls.module_of(tr!) == self.view.module() { return false }
        if loud { self.orphan_impl(s, target, owner) }
        true
    }

    /// An impl-for answers EVERY trait method, exactly — name,
    /// arity, param types, and return — and nothing beyond them
    /// (the recorded bs2 law, now ours).
    fn check_trait_impl(self, s: StmtId, of: string, target: DeclId, tname: string, fns: List<StmtId>) {
        let tdecl: DeclId? = self.trait_decl_named(of)
        if tdecl == null { return self.no_such_trait(s, of) }
        let members = self.view.decls.trait_fns(tdecl!)
        let wanted = [self.view.decls.fn_name(m) ?? "" for m in members]
        for m in members { self.check_trait_member(s, of, target, tname, m) }
        for f in fns {
            let mn = self.fn_named(f)
            if !wanted.contains(mn) { self.beyond_the_trait(f, of, tname, mn) }
        }
        self.view.decls.record_impl(target, tdecl!)
    }

    fn check_trait_member(self, s: StmtId, of: string, target: DeclId, tname: string, m: DeclId) {
        let mn = self.view.decls.fn_name(m) ?? ""
        let want: FnSig? = fn_sig_of(self.view.decls.sig(m))
        let got: FnSig? = self.method_sig(target, mn)
        if got == null { return self.unanswered(s, of, tname, mn) }
        if want != null && !sigs_agree(want!, got!) { self.sig_unworn(s, of, tname, mn) }
    }

    fn declare_method(self, ty: TypeId, f: StmtId) {
        let parts: FnParts? = self.view.store.fn_parts(f)
        if parts == null { return }
        let fp = parts!
        if !fp.tparams.is_empty() { return self.generic_method(f, fp.name) }
        if !selfed(fp.params) {
            self.selfless_method(f, fp.name)
            self.declare_wreckage(f)
            return
        }
        self.declare(f, DeclSig.Fn(FnSig {
            params: [ty].concat(self.seatless_params(f, fp)),
            ret: self.annotated(f, fp.ret),
        }))
    }

    // ── The declare voices — each refusal worded once, at its name ──

    fn selfless_sig(self, f: StmtId, name: string) {
        self.speak(refusal("type.trait", self.stmt_loc(f), "a trait method's first parameter is `self`", "declared here", self_first(name)))
    }

    /// A declared fn's name, or the empty word — the totality laws
    /// compare names, and a nameless decl matches nothing.
    fn fn_named(self, f: StmtId) -> string {
        self.view.store.fn_parts(f)?.name ?? ""
    }

    fn no_such_target(self, s: StmtId, target: string) {
        self.speak(refusal("type.impl", self.stmt_loc(s), "`impl ${target}` serves no declared type", "this impl", "declare `${target}` first — `type` or `enum`"))
    }

    fn generic_target(self, s: StmtId, target: string) {
        self.speak(refusal("type.impl", self.stmt_loc(s), "`${target}` is generic — a trait impl over a generic type is recorded, not landed", "this impl", null))
    }

    fn no_such_trait(self, s: StmtId, of: string) {
        self.speak(refusal("type.trait", self.stmt_loc(s), "`impl ${of} for` names no trait", "this impl", "declare it — `trait ${of} { … }`"))
    }

    fn beyond_the_trait(self, f: StmtId, of: string, target: string, mn: string) {
        self.speak(refusal("type.trait", self.stmt_loc(f), "`${mn}` is not part of `${of}` — an impl-for holds only the trait's methods", "declared here", "move it to a separate `impl ${target} { … }` block"))
    }

    fn unanswered(self, s: StmtId, of: string, target: string, mn: string) {
        self.speak(refusal("type.trait", self.stmt_loc(s), "`impl ${of} for ${target}` must answer `${mn}`", "this impl", "add `fn ${mn}(self, …)`"))
    }

    fn sig_unworn(self, s: StmtId, of: string, target: string, mn: string) {
        self.speak(refusal("type.trait", self.stmt_loc(s), "`${target}.${mn}` does not wear `${of}.${mn}`'s signature", "this impl", "match the trait's parameters and return exactly"))
    }

    fn generic_method(self, f: StmtId, name: string) {
        self.speak(refusal("type.impl", self.stmt_loc(f), "`${name}` is generic — generic methods are recorded, not landed", "this method", null))
    }

    fn selfless_method(self, f: StmtId, name: string) {
        self.speak(refusal("type.impl", self.stmt_loc(f), "a method's first parameter is `self`", "declared here", self_first(name)))
    }

    fn orphan_impl(self, s: StmtId, target: string, owner: string) {
        self.speak(refusal("type.orphan", self.stmt_loc(s), "`impl ${target}` belongs in ${module_word(owner)}, where `${target}` is declared", "this impl", "an impl lives with its type — or with its trait, when the trait is this module's"))
    }

    /// The impl table's answer — a sig whose params[0] is `self`.
    fn method_sig(self, target: DeclId, mname: string) -> FnSig? { method_sig_of(self.view.decls, target, mname) }
}
