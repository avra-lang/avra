//! A FILE'S NAMESPACE — what its top level sees, under ONE law: a
//! name binds once. A module's NAMESPACE is every declaration of
//! every file in it (fns and types apart, as the language keeps
//! them); a file's SCOPE is that namespace plus its imports. The
//! second binder of a taken name refuses — in its own words for the
//! same file, a sibling file, or an import — and an import of the
//! very declaration already visible is redundant, not a clash. A
//! file's scope carries only the refusals whose site is its own.
use core.{DeclId, FileId, DeclKind, same_decl, same_file}
use diagnostics.{Diag, error_at, pointed, loc_at, refusal}
use features.{nothing, Decls}
use features.modules.{unpackaged_use}
use @std.errors.{Loc}

/// A file's namespace: the bindings, the names in declaration order
/// (for suggestions), and the diagnostics building it earned.
export type Namespace = {
    fns: Map<string, DeclId>,
    types: Map<string, DeclId>,
    fn_names: List<string>,
    type_names: List<string>,
    diagnostics: List<Diag>,
}

export fn no_names() -> Namespace {
    Namespace { fns: {}, types: {}, fn_names: [], type_names: [], diagnostics: [] }
}

/// One imported declaration: what, where the `use` stands, and the
/// module it came from.
export type Import = { decl: DeclId, at: Loc?, from: string }

/// A file's namespace from its module's declarations (its own included,
/// in file then declaration order) and its imports. `shown` renders
/// a path for prose.
export fn namespace_of(decls: Decls, file: FileId, module: List<DeclId>, imports: List<Import>, shown: fn(string) -> string) -> Namespace {
    let b = Binder { decls: decls, file: file, shown: shown, names: no_names() }
    for d in module { b.declare(d) }
    for i in imports { b.import(i) }
    b.names
}

/// A lone file's namespace: its own declarations, and every `use` line
/// refused — there is no package to import from.
export fn lone_namespace(decls: Decls, file: FileId, own: List<DeclId>, p: ParsedProgram) -> Namespace {
    let names = namespace_of(decls, file, own, [], (path: string) -> path)
    let refused = [unpackaged_use(loc_at(p.source.file, p.store.stmt_span(s))) for s in p.stmts if is_use(p, s)]
    names with { diagnostics: names.diagnostics.concat(refused) }
}

fn is_use(p: ParsedProgram, s: StmtId) -> bool {
    p.store.use_parts(s) != null
}

/// A namespace under construction for one file.
type Binder = { decls: Decls, file: FileId, shown: fn(string) -> string, names: Namespace }

impl Binder {
    /// A module declaration binds in its namespace; a taken name
    /// refuses at the LATER declaration, which speaks only when it
    /// is this file's.
    fn declare(self, d: DeclId) {
        let x = self.decls.decl(d)
        let prior: DeclId? = self.held(x.kind, x.name)
        if prior == null { return self.bind(x.kind, x.name, d) }
        if same_decl(prior!, d) || !same_file(x.file, self.file) { return }
        let p = self.decls.decl(prior!)
        if same_file(p.file, x.file) {
            self.speak(defined_twice(self.decls.loc(d), x.kind, x.name))
        } else {
            self.speak(declared_twice(self.decls.loc(d), x.name, self.shown(self.decls.file(p.file).path)))
        }
    }

    /// An import binds in the file's namespace; a name already visible
    /// refuses — unless it is the very same declaration.
    fn import(self, i: Import) {
        let x = self.decls.decl(i.decl)
        let prior: DeclId? = self.held(x.kind, x.name)
        if prior == null { return self.bind(x.kind, x.name, i.decl) }
        if same_decl(prior!, i.decl) { return }
        self.speak(import_clash(i.at, x.name, self.holder(prior!)))
    }

    /// Who holds a name already: this module (by file), or a module.
    fn holder(self, prior: DeclId) -> string {
        let p = self.decls.decl(prior)
        if self.decls.module_of(prior) == self.decls.file(self.file).module {
            return "this module (`${self.shown(self.decls.file(p.file).path)}`)"
        }
        "`${self.decls.module_of(prior)}`"
    }

    fn held(self, kind: DeclKind, name: string) -> DeclId? {
        let as_fn: DeclId? = self.names.fns.get(name)
        let as_type: DeclId? = self.names.types.get(name)
        match kind {
            .Fn -> as_fn,
            .Record or .Enum or .Trait -> as_type,
            .Method -> null,
        }
    }

    fn bind(self, kind: DeclKind, name: string, d: DeclId) {
        match kind {
            .Fn -> self.bind_fn(name, d),
            .Record or .Enum or .Trait -> self.bind_type(name, d),
            .Method -> nothing(),
        }
    }

    fn bind_fn(self, name: string, d: DeclId) {
        mut m = self.names.fns
        m.set(name, d)
        mut ns = self.names.fn_names
        ns.push(name)
    }

    fn bind_type(self, name: string, d: DeclId) {
        mut m = self.names.types
        m.set(name, d)
        mut ns = self.names.type_names
        ns.push(name)
    }

    fn speak(self, d: Diag) {
        mut ds = self.names.diagnostics
        ds.push(d)
    }
}

// ── voices ──

fn defined_twice(at: Loc?, kind: DeclKind, name: string) -> Diag {
    match kind {
        .Fn -> refusal("resolve.duplicate_fn", at, "`${name}` is defined more than once", "redefined here", "rename one of them"),
        .Record or .Enum or .Trait or .Method ->
            refusal("resolve.duplicate_type", at, "`${name}` is declared more than once", "redeclared here", "rename one of them"),
    }
}

fn declared_twice(at: Loc?, name: string, other: string) -> Diag {
    refusal("resolve.duplicate_in_module", at, "`${name}` is declared twice in this module — here and in `${other}`", "declared here", "a module's files share one namespace — rename one, or move it to another module")
}

fn import_clash(at: Loc?, item: string, holder: string) -> Diag {
    refusal("resolve.import_clash", at, "`${item}` is imported, but ${holder} already has it", "in this use", "drop the import, or rename the local declaration")
}
