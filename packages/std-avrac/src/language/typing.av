//! The type pass — the second pure query. The driver owns the
//! registry, the dense table, the fn signatures, and the walk; what
//! a NODE's type IS lives in its owning feature's NodeSemantics.
//! Facts stay TOTAL: every expression has a TypeId, never an option
//! and never an Unknown — a hole or unresolved name types as the
//! interned Error, which ABSORBS: the causing pass already spoke,
//! so no diagnostic cascades from it. Signatures come first, from
//! the annotations alone, so a call may name a fn declared later.
use core.{StmtId, ExprId, TypeId, Type, Param, TypeRef, spelled, TypeRegistry, new_type_registry, filled, plain}
use diagnostics.{Diag, loc_at, error_at, pointed}
use features.{TypeCx, StmtTypeCx, FnSig, StructSig, EnumSig, DeclSig, Asked,
              fn_sig_of, record_sig_of, variant_sig_of, duplicate_names}
use @std.errors.{Loc}

/// The pass's facts: the registry, a dense expression table, and a
/// dense signature table indexed by StmtId — total, O(1) reads for
/// every later pass. `widens` names the expressions the assignment
/// law LIFTED into a nullable: recorded here, wrapped by lowering.
export type Typing = {
    types: TypeRegistry,
    of_expr: List<TypeId>,
    widens: List<TypeId?>,
    narrows: List<TypeId?>,
    decls: List<DeclSig?>,
    diagnostics: List<Diag>,
}

/// The type of a typed expression.
export fn type_of(t: Typing, e: ExprId) -> TypeId {
    t.of_expr[e.index]
}

/// One narrow in force: the proven binding (a def's stmt index in
/// `narrow_defs`, a param's position in `narrow_params` — the two
/// stacks keep the keyspaces apart), the INNER its reads answer,
/// and the OPT each read is recorded as wearing, for lowering.
type NarrowFrame = { key: int, inner: TypeId, opt: TypeId }

/// The pass's working state. `pattern_types` holds what each
/// match arm's bind carries — spoken by the arm's OWNER before the
/// arm is walked, and pass-internal: no later pass asks.
type Typer = {
    error_type: TypeId,
    p: ParsedProgram,
    resolution: Resolution,
    types: TypeRegistry,
    of_expr: List<TypeId>,
    widens: List<TypeId?>,
    narrows: List<TypeId?>,
    asks: List<Asked?>,
    pattern_types: List<TypeId?>,
    binding_types: List<TypeId?>,
    narrow_defs: List<NarrowFrame>,
    narrow_params: List<NarrowFrame>,
    decls: List<DeclSig?>,
    diagnostics: List<Diag>,
}

export fn type_check(p: ParsedProgram, r: Resolution) -> Typing {
    let registry = new_type_registry()
    // The table is born total: every slot pre-typed as the hole.
    let hole = registry.intern(Type.Error)
    let t = Typer {
        error_type: hole,
        p: p, resolution: r, types: registry,
        of_expr: filled(p.store.exprs.count(), hole),
        widens: filled<TypeId?>(p.store.exprs.count(), null),
        narrows: filled<TypeId?>(p.store.exprs.count(), null),
        asks: filled<Asked?>(p.store.exprs.count(), null),
        pattern_types: filled<TypeId?>(p.store.exprs.count(), null),
        binding_types: filled<TypeId?>(p.store.stmts.count(), null),
        narrow_defs: [], narrow_params: [],
        decls: filled<DeclSig?>(p.store.stmts.count(), null),
        diagnostics: [],
    }
    t.declare_type_sigs()
    t.declare_sigs()
    type_stmts(t, [], p.stmts)
    Typing {
        types: t.types, of_expr: t.of_expr, widens: t.widens,
        narrows: t.narrows, decls: t.decls,
        diagnostics: t.diagnostics,
    }
}

/// Statements in order, each through its own StmtSemantics — the
/// ONE statement loop, top level and blocks alike. The context is
/// state verbs plus the whole expression vocabulary; the rules live
/// with their features.
fn type_stmts(t: Typer, param_types: List<TypeId>, stmts: List<StmtId>) {
    let ecx = expr_cx(t, param_types)
    let cx = StmtTypeCx {
        store: t.p.store,
        expr: ecx,
        walk: (v: ExprId) -> type_walk(t, param_types, v),
        walk_under: (pts: List<TypeId>, body: ExprId) -> type_walk(t, pts, body),
        type_stmts: (body: List<StmtId>) -> type_stmts(t, param_types, body),
        sig_of: (s: StmtId) -> fn_sig_of(t.decls[s.index]),
        assign_target: (s: StmtId) -> assign_target_of(t.resolution, s),
        bind_declared: (s: StmtId, ann: TypeRef) -> t.bind_declared(s, ann),
        binding_type: (s: StmtId) -> t.def_type(s),
        loc_of: (s: StmtId) -> t.stmt_loc(s),
    }
    for s in stmts { stmt_semantics_of(t.p.dispatch, t.p.store.stmt(s)).type_stmt(cx, s) }
}

/// One subtree's types, under the given param types.
fn type_walk(t: Typer, param_types: List<TypeId>, root: ExprId) {
    let cx = expr_cx(t, param_types)
    for e in t.p.post_order(root) { type_node(t, cx, e) }
}

/// The expression capabilities, wired once for a given param scope.
fn expr_cx(t: Typer, param_types: List<TypeId>) -> TypeCx {
    let cx = TypeCx {
        error_type: t.error_type,
        store: t.p.store,
        type_at: (e: ExprId) -> t.of_expr[e.index],
        shape_at: (e: ExprId) -> t.types.shape_of(t.of_expr[e.index]),
        shape_of: (ty: TypeId) -> t.types.shape_of(ty),
        intern: (sh: Type) -> t.types.intern(sh),
        target_type: (e: ExprId) -> t.target_type(e, param_types),
        sig_of: (e: ExprId) -> t.sig_at(e),
        bound_def: (e: ExprId) -> t.def_of(e),
        fields_of: (ty: TypeId) -> t.fields_of(ty),
        variants_of: (ty: TypeId) -> t.variants_of(ty),
        block_type: (stmts: List<StmtId>, value: ExprId) -> block_type(t, param_types, stmts, value),
        walk_type: (v: ExprId) -> typed_subtree(t, param_types, v),
        bind_type: (v: ExprId, ty: TypeId) -> t.record_bind(v, ty),
        widen: (v: ExprId, ty: TypeId) -> t.record_widen(v, ty),
        rides_pointer: (ty: TypeId) -> t.types.rides_pointer(ty),
        record_ask: (e: ExprId, subject: ExprId, on_present: bool) -> t.record_ask(e, subject, on_present),
        ask_of: (e: ExprId) -> t.asks[e.index],
        walk_narrowed: (subject: ExprId, branch: ExprId) -> narrowed_subtree(t, param_types, subject, branch),
        name_at: (e: ExprId) -> t.types.name_of(t.of_expr[e.index]),
        type_name: (ty: TypeId) -> t.types.name_of(ty),
        loc_of: (e: ExprId) -> loc_at(t.p.source.file, t.p.store.expr_span(e)),
        emit: (d: Diag) -> t.speak(d),
    }
    cx
}

/// A block's statements type in order, then its value — which IS
/// the block's type.
fn block_type(t: Typer, param_types: List<TypeId>, stmts: List<StmtId>, value: ExprId) -> TypeId {
    type_stmts(t, param_types, stmts)
    type_walk(t, param_types, value)
    t.of_expr[value.index]
}

/// A subtree typed on request, answering its own type — what a
/// CONTROL-OWNING node uses for children it hides from the walk.
fn typed_subtree(t: Typer, param_types: List<TypeId>, root: ExprId) -> TypeId {
    type_walk(t, param_types, root)
    t.of_expr[root.index]
}

/// A branch typed under a PROVEN-PRESENT binding: when the asked
/// subject is an effectively-final nullable — a `let` (never a
/// `mut`) or a param — its reads inside the branch narrow to the
/// carried type, each read recorded so lowering unwraps it. A
/// subject that cannot be proven simply walks un-narrowed: the
/// sugar is never load-bearing (spec 10.4).
fn narrowed_subtree(t: Typer, param_types: List<TypeId>, subject: ExprId, branch: ExprId) -> TypeId {
    let b: Binding? = binding_of(t.resolution, subject)
    if b == null { return typed_subtree(t, param_types, branch) }
    match b! {
        .Def(s) -> narrowed_def_walk(t, param_types, s, branch),
        .Param(i) -> narrowed_param_walk(t, param_types, i, branch),
        .Pattern(_) -> typed_subtree(t, param_types, branch),
    }
}

fn narrowed_def_walk(t: Typer, param_types: List<TypeId>, s: StmtId, branch: ExprId) -> TypeId {
    // A `mut` can be reassigned mid-branch — never narrowed.
    if !(t.p.store.stmt(s) is .Let) { return typed_subtree(t, param_types, branch) }
    framed(t, t.narrow_defs, s.index, t.def_type(s),
           () -> typed_subtree(t, param_types, branch))
}

fn narrowed_param_walk(t: Typer, param_types: List<TypeId>, i: int, branch: ExprId) -> TypeId {
    framed(t, t.narrow_params, i, param_types[i],
           () -> typed_subtree(t, param_types, branch))
}

/// The narrow bracket: when `opt` really is a nullable, its frame
/// lives on the given stack exactly as long as the thunk's walk;
/// otherwise the walk runs bare. The stack ALIASES the Typer's own
/// list, so the push is seen by every nested read.
fn framed(t: Typer, frames: List<NarrowFrame>, key: int, opt: TypeId, walk: fn() -> TypeId) -> TypeId {
    let inner: TypeId? = t.types.carried(opt)
    if inner == null { return walk() }
    // LICENSED I15: this IS the bracket
    mut fs = frames
    fs.push(NarrowFrame { key: key, inner: inner!, opt: opt })
    let answer = walk()
    let _ = fs.pop()
    answer
}

/// One node's fact: the owner speaks, the table records.
fn type_node(t: Typer, cx: TypeCx, e: ExprId) {
    mut facts = t.of_expr
    facts.set(e.index, semantics_of(t.p.dispatch, t.p.store.expr(e)).type_of(cx, e))
}

/// A type CONSTRUCTOR the language owns, and how many arguments it
/// takes — absent when the name is not one. THE definition, with
/// THREE consumers: `builtin_type_name` (so resolve refuses the name
/// at a declaration), `applied`'s arity check, and `applied`'s
/// INTERNING, which is hardcoded to `Type.List` — a new row here
/// needs a shape there, or the constructor silently builds a list.
/// `List` is alone because the registry has no shape for another.
fn applied_arity(name: string) -> int? {
    match name {
        "List" -> 1,
        _ -> null,
    }
}

/// Every name the LANGUAGE owns — a scalar shape or a constructor.
/// A declaration may take none of them.
fn builtin_type_name(name: string) -> bool {
    shape_named(name) != null || applied_arity(name) != null
}

/// The type an annotation names, or null.
fn shape_named(name: string) -> Type? {
    match name {
        "int" -> Type.Int,
        "string" -> Type.Str,
        "bool" -> Type.Bool,
        _ -> null,
    }
}

impl Typer {
    /// Every declared type's table, from its declaration alone —
    /// BEFORE fn sigs, whose annotations may name these types.
    fn declare_type_sigs(self) {
        for s in self.p.stmts {
            let sp: StructParts? = self.p.store.struct_parts(s)
            if sp != null { self.declare_struct_sig(s, sp!.fields) }
            let ep: EnumParts? = self.p.store.enum_parts(s)
            if ep != null { self.declare_enum_sig(s, ep!.variants) }
        }
    }

    /// An enum's variant table — the index IS the runtime tag, and
    /// a payload rides slot 1 of the value.
    fn declare_enum_sig(self, s: StmtId, variants: List<Param>) {
        let sig = EnumSig {
            names: [v.name for v in variants],
            payloads: [self.carried_type(s, v) for v in variants],
        }
        self.declare(s, DeclSig.Variants(sig))
    }

    /// What a variant carries — an ABSENT annotation IS a unit
    /// variant, and carries nothing.
    fn carried_type(self, s: StmtId, v: Param) -> TypeId? {
        if v.ty == null { return null }
        self.scalar_slot(s, "type.enum_payload", "an enum payload holds scalars for now",
                         "`${v.name}` carries a `${spelled(v.ty!)}`", v.ty!)
    }

    /// One declaration's table lands in the ONE dense record.
    fn declare(self, s: StmtId, d: DeclSig) {
        mut sig_table = self.decls
        sig_table.set(s.index, d)
    }

    fn declare_struct_sig(self, s: StmtId, fields: List<Param>) {
        let names = [f.name for f in fields]
        let owner: string = self.p.store.type_decl_name(s) ?? "this type"
        for d in duplicate_names("type.duplicate_field", owner, names, self.stmt_loc(s)) {
            self.speak(d)
        }
        let types = [self.field_type(s, f) for f in fields]
        let sig = StructSig { names: names, types: types }
        self.declare(s, DeclSig.Record(sig))
    }

    /// A field's type — scalars only, until ownership analysis. The
    /// grammar always writes one, so absence is unreachable.
    fn field_type(self, s: StmtId, f: Param) -> TypeId {
        if f.ty == null { return self.error_type }
        self.scalar_slot(s, "type.struct_scalar", "struct fields hold scalars for now",
                         "field `${f.name}` is `${spelled(f.ty!)}`", f.ty!)
    }

    /// THE declared-slot law: a slot inside an aggregate holds a
    /// SCALAR until ownership analysis covers managed values — a
    /// record's field and an enum's payload alike, since both are
    /// slots of an array the pass does not yet track. (A nullable
    /// is NOT a container: its representation is values.av's
    /// per-shape choice, so no law speaks there.) An UNKNOWN name
    /// is not this law's business: the NAME law speaks first, and
    /// a second refusal for one mistake is a cascade.
    fn scalar_slot(self, s: StmtId, kind: string, message: string,
                   label: string, ty: TypeRef) -> TypeId {
        let named = self.written_type(s, ty)
        let sh: Type = self.types.shape_of(named)
        if sh is .Error { return named }
        if !ty.optional && (sh is .Int || sh is .Bool) { return named }
        self.speak(pointed(error_at(kind, self.stmt_loc(s), message), label)
            with { help: "`int` and `bool` today — managed slots arrive with ownership analysis" })
        self.error_type
    }

    /// Every fn's signature, from its annotations alone — before any
    /// body walks, so calls resolve signatures program-wide.
    fn declare_sigs(self) {
        for s in self.p.stmts {
            let parts: FnParts? = self.p.store.fn_parts(s)
            if parts != null { self.declare_sig(s, parts!.params, parts!.ret) }
        }
    }

    fn declare_sig(self, s: StmtId, fparams: List<Param>, fret: TypeRef) {
        // A parameter declared twice makes the second unreachable —
        // the body sees the first, silently. The same law a record's
        // fields and an enum's variants obey, through the same scan.
        let owner: string = self.p.store.fn_parts(s)?.name ?? "this fn"
        for d in duplicate_names("type.duplicate_param", owner, [pp.name for pp in fparams], self.stmt_loc(s)) {
            self.speak(d)
        }
        let ptypes = [self.annotated(s, pp.ty) for pp in fparams]
        let rt = self.annotated(s, fret)
        let sig = FnSig { params: ptypes, ret: rt }
        self.declare(s, DeclSig.Fn(sig))
    }

    /// An annotation's TypeId: what its NAME stands for, wrapped
    /// once when `?` was written. An absent annotation cannot reach
    /// here from any grammar the language assembles.
    fn annotated(self, s: StmtId, ann: TypeRef?) -> TypeId {
        if ann == null { return self.error_type }
        self.full_type(s, ann!)
    }

    /// A written type in full — its arguments and its `?` both. The
    /// element of an application comes back through here, so
    /// `List<int?>` and `List<List<int>>` need no rule of their own.
    /// The `?` wraps ANY well-named type: which layout a nullable
    /// takes is values.av's per-shape choice, not a law's business.
    fn full_type(self, s: StmtId, t: TypeRef) -> TypeId {
        if !t.optional { return self.written_type(s, t) }
        let inner = self.written_type(s, plain(t))
        if self.types.shape_of(inner) is .Error { return inner }
        self.types.intern(Type.Opt(inner))
    }

    /// What a written type stands for, arguments included: a bare
    /// name, or an application like `List<int>`.
    fn written_type(self, s: StmtId, t: TypeRef) -> TypeId {
        if t.args.is_empty() { return self.named_type(s, t.name) }
        self.applied(s, t)
    }

    /// A type APPLIED to arguments. `List<T>` is the only one today —
    /// the registry has no shape for another, and inventing one here
    /// would be a type nothing can lower.
    fn applied(self, s: StmtId, t: TypeRef) -> TypeId {
        let takes: int? = applied_arity(t.name)
        if takes == null {
            // The NAME law speaks first: a constructor that names no
            // type at all is not an arity mistake, and saying so
            // would imply it IS a type that merely takes none.
            if self.types.shape_of(self.named_type(s, t.name)) is .Error { return self.error_type }
            self.speak(pointed(
                error_at("type.applied", self.stmt_loc(s),
                    "`${t.name}` takes no type arguments"),
                "applied here")
                with { help: "`List<T>` is the one applied type today" })
            return self.error_type
        }
        let arity = takes!
        if t.args.length != arity {
            self.speak(pointed(
                error_at("type.applied", self.stmt_loc(s),
                    "`${t.name}` is applied to ${t.args.length} types; it takes ${arity}"),
                "applied here")
                with { help: "`${t.name}` needs exactly ${arity}" })
            return self.error_type
        }
        let elem = self.full_type(s, t.args[0])
        if self.types.shape_of(elem) is .Error { return elem }
        self.types.intern(Type.List(elem))
    }

    /// What a written NAME stands for: a builtin shape, a declared
    /// type, or a spoken absence.
    fn named_type(self, s: StmtId, name: string) -> TypeId {
        let sh: Type? = shape_named(name)
        if sh != null { return self.types.intern(sh!) }
        let decl: StmtId? = self.resolution.type_defs.get(name)
        if decl != null { return self.declared_type(decl!, name) }
        self.speak(pointed(
            error_at("type.unknown", self.stmt_loc(s), "`${name}` names no type"),
            "in this signature")
            with { help: "the types today are `int`, `string`, `bool`, and your declared types" })
        self.error_type
    }

    /// A declared name's type: an enum's value shape or a record's.
    fn declared_type(self, s: StmtId, name: string) -> TypeId {
        let ep: EnumParts? = self.p.store.enum_parts(s)
        if ep != null { return self.types.intern(Type.Enum(s, name)) }
        self.types.intern(Type.Struct(s, name))
    }

    fn stmt_loc(self, s: StmtId) -> Loc? {
        loc_at(self.p.source.file, self.p.store.stmt_span(s))
    }

    /// An ident's type, by its binding kind — NARROWED when a
    /// presence test proved this binding present in the branch
    /// being walked (the narrow is recorded for lowering, which
    /// unwraps the read at its one edge). No binding means resolve
    /// already spoke — Error, silently.
    fn target_type(self, e: ExprId, param_types: List<TypeId>) -> TypeId {
        let b: Binding? = binding_of(self.resolution, e)
        if b == null { return self.error_type }
        match b! {
            .Param(i) -> self.narrowed_param(e, i) ?? param_types[i],
            .Def(s) -> self.narrowed_def(e, s) ?? self.def_type(s),
            // The arm's OWNER spoke this type before the arm was
            // walked; an absent one means the bind was refused.
            .Pattern(v) -> self.pattern_types[v.index] ?? self.error_type,
        }
    }

    /// The narrowed INNER for a def-bound read, when a frame proves
    /// it — recorded so lowering unwraps this very read.
    fn narrowed_def(self, e: ExprId, s: StmtId) -> TypeId? {
        self.narrow_hit(e, self.narrow_defs, s.index)
    }

    fn narrowed_param(self, e: ExprId, i: int) -> TypeId? {
        self.narrow_hit(e, self.narrow_params, i)
    }

    /// One stack's answer: the frame whose key matches, its read
    /// recorded as wearing the frame's OPT.
    fn narrow_hit(self, e: ExprId, frames: List<NarrowFrame>, key: int) -> TypeId? {
        let hit: NarrowFrame? = frames.find(it.key == key)
        if hit == null { return null }
        self.record_narrow(e, hit!.opt)
        hit!.inner
    }

    /// This READ is proven present: lowering unwraps it from the
    /// recorded nullable.
    fn record_narrow(self, e: ExprId, opt: TypeId) {
        mut ns = self.narrows
        ns.set(e.index, opt)
    }

    /// A presence test's fact: the spine records, `if` queries.
    fn record_ask(self, e: ExprId, subject: ExprId, on_present: bool) {
        mut aa = self.asks
        aa.set(e.index, Asked { subject: subject, on_present: on_present })
    }

    /// What an arm's bind holds, as the arm's owner declared it.
    fn record_bind(self, v: ExprId, ty: TypeId) {
        mut ps = self.pattern_types
        ps.set(v.index, ty)
    }

    /// This expression is lifted into a nullable before it lands.
    fn record_widen(self, v: ExprId, ty: TypeId) {
        mut ws = self.widens
        ws.set(v.index, ty)
    }

    /// A definition statement's value type. An ANNOTATED binding
    /// answers what it DECLARED (recorded by `bind_declared` when
    /// the statement typed); a TYPE declaration used as a value is
    /// the compile-only TypeName; everything else infers from its
    /// value.
    fn def_type(self, s: StmtId) -> TypeId {
        let declared: TypeId? = self.binding_types[s.index]
        if declared != null { return declared! }
        let tname: string? = self.p.store.type_decl_name(s)
        if tname != null { return self.types.intern(Type.TypeName(s, tname!)) }
        // A for's COUNTER binds no value expression of its own —
        // the range law already pinned what it IS. Without this
        // arm the counter typed as the absorbing Error and every
        // law silently forgave it.
        if self.p.store.stmt(s) is .For { return self.types.intern(Type.Int) }
        let v: ExprId? = self.p.store.stmt_value(s)
        if v == null { return self.error_type }
        self.of_expr[v!.index]
    }

    /// An annotated binding's DECLARED type: interned once, recorded
    /// so every later read of the name answers it, and returned for
    /// the value's acceptance check.
    fn bind_declared(self, s: StmtId, ann: TypeRef) -> TypeId {
        let ty = self.full_type(s, ann)
        mut bs = self.binding_types
        bs.set(s.index, ty)
        ty
    }

    /// A call's target signature, when resolve found one.
    fn sig_at(self, e: ExprId) -> FnSig? {
        let b: Binding? = binding_of(self.resolution, e)
        if b == null { return null }
        match b! {
            .Def(s) -> fn_sig_of(self.decls[s.index]),
            .Param(_) or .Pattern(_) -> null,
        }
    }

    /// The definition statement an expression's binding names.
    fn def_of(self, e: ExprId) -> StmtId? {
        let b: Binding? = binding_of(self.resolution, e)
        if b == null { return null }
        match b! {
            .Def(s) -> s,
            .Param(_) or .Pattern(_) -> null,
        }
    }

    /// A struct type's field table; null for every other shape.
    fn fields_of(self, ty: TypeId) -> StructSig? {
        match self.types.shape_of(ty) {
            .Struct(decl, _) -> record_sig_of(self.decls[decl.index]),
            _ -> null,
        }
    }

    /// An enum type's variant table; null for every other shape.
    fn variants_of(self, ty: TypeId) -> EnumSig? {
        match self.types.shape_of(ty) {
            .Enum(decl, _) -> variant_sig_of(self.decls[decl.index]),
            _ -> null,
        }
    }

    fn speak(self, d: Diag) {
        mut ds = self.diagnostics
        ds.push(d)
    }
}
