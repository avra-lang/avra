//! The type pass — the second pure query. The driver owns the
//! registry, the dense table, and the walk; what a NODE's type IS
//! lives in its owning feature's NodeSemantics. Facts stay TOTAL:
//! every expression has a TypeId, never an option and never an
//! Unknown — a hole or unresolved name types as the interned Error,
//! which ABSORBS: the causing pass already spoke, so no diagnostic
//! cascades from it.
use core.{Expr, Stmt, StmtId, ExprId, TypeId, Type, TypeRegistry, new_type_registry, filled}
use diagnostics.{Diag, loc_at}
use features.{TypeCx}

/// The pass's facts: the registry and a dense table indexed by
/// ExprId — total, O(1) reads for every later pass.
export type Typing = {
    types: TypeRegistry,
    of_expr: List<TypeId>,
    diagnostics: List<Diag>,
}

/// The type of a typed expression.
export fn type_of(t: Typing, e: ExprId) -> TypeId {
    t.of_expr[e.index]
}

type Typer = {
    p: ParsedProgram,
    resolution: Resolution,
    types: TypeRegistry,
    of_expr: List<TypeId>,
    diagnostics: List<Diag>,
}

export fn type_check(p: ParsedProgram, r: Resolution) -> Typing {
    mut registry = new_type_registry()
    // The table is born total: every slot pre-typed as the hole.
    let hole = registry.intern(Type.Error)
    let t = Typer {
        p: p, resolution: r, types: registry,
        of_expr: filled(p.store.exprs.count(), hole), diagnostics: [],
    }
    let cx = TypeCx {
        store: p.store,
        type_at: (e: ExprId) -> t.of_expr[e.index],
        shape_at: (e: ExprId) -> t.types.shape_of(t.of_expr[e.index]),
        intern: (sh: Type) -> t.types.intern(sh),
        target_type: (e: ExprId) -> t.target_type(e),
        loc_of: (e: ExprId) -> loc_at(t.p.source.file, t.p.store.expr_span(e)),
        emit: (d: Diag) -> t.speak(d),
    }
    for s in p.stmts {
        let value: ExprId? = stmt_value(p.store, s)
        if value != null { type_visit(t, cx, value!) }
    }
    Typing { types: t.types, of_expr: t.of_expr, diagnostics: t.diagnostics }
}

/// Post-order: children typed first, so the owner combines reads.
fn type_visit(t: Typer, cx: TypeCx, e: ExprId) {
    let node = t.p.store.expr(e)
    let sems = semantics_of(t.p.features, node)
    if sems.is_empty() {
        t.speak(no_semantics(node))
        return
    }
    for k in sems[0].kids(node) { type_visit(t, cx, k) }
    let ty = sems[0].type_of(cx, e)
    mut facts = t.of_expr
    facts.set(e.index, ty)
}

impl Typer {
    /// An ident's type is its definition's value type. No target
    /// means resolve already spoke — Error, silently.
    fn target_type(self, e: ExprId) -> TypeId {
        let target: StmtId? = target_of(self.resolution, e)
        match target {
            null -> self.types.intern(Type.Error),
            let s -> match self.p.store.stmt(s) {
                .Let(_, v) -> self.of_expr[v.index],
                _ -> self.types.intern(Type.Error),
            },
        }
    }

    fn speak(self, d: Diag) {
        mut ds = self.diagnostics
        ds.push(d)
    }

}
