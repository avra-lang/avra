//! The type pass: one declaration's body over its own expression
//! range, the signatures it names asked lazily as it reads them.
//! The driver owns the table and the walk; what a NODE's type IS
//! lives in its owning feature's NodeSemantics. Facts stay TOTAL:
//! every expression has a TypeId, never an option and never an
//! Unknown — a hole or unresolved name types as the interned Error,
//! which ABSORBS: the causing pass already spoke, so no diagnostic
//! cascades from it.
use core.{StmtId, ExprId, TypeId, Type, Param, TypeRef, TypeRegistry, NodeStore, FileId, DeclId, FnParts, Binding, same_expr}
use diagnostics.{Diag, loc_at, refusal}
use features.{TypeCx, StmtTypeCx, FnSig, DeclSig, fn_sig_of, TypeRow, type_row, Decls, Decl, Cap, new_type_facts, decl_type_of, def_type_of, type_named, TypeFacts, NameFacts, FileView, nothing}
use features.structs.{fits_default}
use features.specs.{fits_case}
use @std.errors.{Loc}

/// One narrow in force: the proven binding (a def's stmt index in
/// `narrow_defs`, a param's position in `narrow_params` — the two
/// stacks keep the keyspaces apart), the INNER its reads answer,
/// and the OPT each read is recorded as wearing, for lowering.
type NarrowFrame = { key: int, inner: TypeId, opt: TypeId }

/// The pass's working state. `pattern_types` holds what each
/// match arm's bind carries — spoken by the arm's OWNER before the
/// arm is walked, and pass-internal: no later pass asks.
export type Typer = {
    error_type: TypeId,
    lang: Language,
    view: FileView,
    names: NameFacts,
    facts: TypeFacts,
    narrow_defs: List<NarrowFrame>,
    narrow_params: List<NarrowFrame>,
    fn_ret: List<TypeId>,
    lam_bar: List<int>,
    tscope: List<TypeId>,
    paired: List<ExprId>,
}

/// A typer over one expression range of a file, reading the SHARED
/// declaration table — a signature may name any file's types, and
/// asking for one computes it.
export fn typer(lang: Language, view: FileView, names: NameFacts, lo: int, hi: int) -> Typer {
    // The table is born total: every slot pre-typed as the hole.
    let hole = view.types.intern(Type.Error)
    Typer {
        error_type: hole,
        lang: lang, view: view, names: names,
        facts: new_type_facts(lo, hi, view.store.stmts.count(), hole),
        narrow_defs: [], narrow_params: [], fn_ret: [], lam_bar: [], tscope: [], paired: [],
    }
}

/// One declaration typed, then its facts: a fn's or method's body
/// under its signature (asked lazily), a default's under its field,
/// Main's run-time statements in order, a type's statement-level
/// law. A trait's and an impl's members are declarations of their
/// own.
export fn type_decl(t: Typer, x: Decl) -> TypeFacts {
    match x.kind {
        .Main -> type_stmts(t, [], runtime_stmts(t.view)),
        .Fn or .Method -> if x.root == null { nothing() } else { type_stmts(t, [], [x.stmt]) },
        .Default -> default_body(t, x),
        .Case -> case_body(t, x),
        .Record or .Enum -> type_stmts(t, [], [x.stmt]),
        .Trait or .Impl or .Builtin -> nothing(),
    }
    t.speak_hungry()
    t.facts
}

/// A file's statements that RUN — everything that declares nothing.
fn runtime_stmts(view: FileView) -> List<StmtId> {
    [s for s in view.stmts if !view.store.is_declaration(s)]
}

/// A default walks under its field's want, in the record's type
/// scope, and the field judges it.
fn default_body(t: Typer, x: Decl) {
    let root: ExprId = x.root!
    let want: TypeId = fn_sig_of(t.view.decls.sig(x.id))?.ret ?? t.error_type
    t.enter_tscope(x.stmt)
    t.plant_want(root, want)
    type_walk(t, [], root)
    t.leave_tscope()
    fits_default(expr_cx(t, []), root, x.name, want)
}

/// A test case's body walks under the bool it declared — a
/// `return` inside answers it — and its feature judges the answer.
fn case_body(t: Typer, x: Decl) {
    let root: ExprId = x.root!
    let want: TypeId = fn_sig_of(t.view.decls.sig(x.id))?.ret ?? t.error_type
    answering(t, want, () -> {
        t.plant_want(root, want)
        type_walk(t, [], root)
    })
    fits_case(expr_cx(t, []), root, want)
}

/// Statements in order, each through its own StmtSemantics — the
/// ONE statement loop, top level and blocks alike. The context is
/// state verbs plus the whole expression vocabulary; the rules live
/// with their features.
fn type_stmts(t: Typer, param_types: List<TypeId>, stmts: List<StmtId>) {
    let ecx = expr_cx(t, param_types)
    let cx = StmtTypeCx {
        view: t.view,
        expr: ecx,
        walk: (v: ExprId) -> type_walk(t, param_types, v),
        walk_under: (s: StmtId, body: ExprId) -> walk_fn_body(t, s, body),
        type_stmts: (body: List<StmtId>) -> type_stmts(t, param_types, body),
        bind_declared: (s: StmtId, ann: TypeRef) -> t.bind_declared(s, ann),
    }
    for s in stmts { stmt_semantics_of(t.lang.dispatch, t.view.store.stmt(s)).type_stmt(cx, s) }
}

/// A fn BODY's walk: the declared answer AND the type parameters
/// are in scope for exactly the walk — `return` judges where it
/// stands, and a body-level `let x: T` resolves the fn's own Vars.
fn walk_fn_body(t: Typer, s: StmtId, body: ExprId) {
    let sig: FnSig? = fn_sig_of(t.stmt_sig(s))
    answering(t, sig?.ret ?? t.error_type, () -> {
        t.enter_tscope(s)
        let ret: TypeId? = sig?.ret
        if ret != null { t.plant_want(body, ret!) }
        type_walk(t, sig?.params ?? [], body)
        t.leave_tscope()
    })
}

/// The declared answer in scope for exactly the walk.
fn answering(t: Typer, want: TypeId, walk: fn()) {
    // LICENSED I15: this IS the bracket
    mut rs = t.fn_ret
    rs.push(want)
    walk()
    let _ = rs.pop()
}

/// One subtree's types, under the given param types.
fn type_walk(t: Typer, param_types: List<TypeId>, root: ExprId) {
    let cx = expr_cx(t, param_types)
    for e in t.lang.post_order(t.view.store, root) { type_node(t, cx, e) }
}

/// The expression capabilities, wired once for a given param scope.
fn expr_cx(t: Typer, param_types: List<TypeId>) -> TypeCx {
    TypeCx {
        view: t.view, names: t.names, facts: t.facts, error_type: t.error_type,
        walk_type: (v: ExprId) -> typed_subtree(t, param_types, v),
        block_type: (stmts: List<StmtId>, value: ExprId?) -> block_type(t, param_types, stmts, value),
        walk_narrowed: (subject: ExprId, branch: ExprId) -> narrowed_subtree(t, param_types, subject, branch),
        lambda_body: (lam: ExprId, ptys: List<TypeId>, body: ExprId) -> lambda_walked(t, param_types, lam, ptys, body),
        retype_seated: (a: ExprId, seats: List<TypeId>) -> reseated(t, param_types, a, seats),
        target_type: (e: ExprId) -> t.target_type(e, param_types),
        enclosing_ret: () -> t.reachable_ret(),
        behind_lambda: () -> t.behind_lambda(),
        written: (e: ExprId, tr: TypeRef) -> t.full_type(t.view.loc_of(e), tr),
        written_at: (e: ExprId, tr: TypeRef) -> t.full_type(loc_at(t.view.source.file, t.view.store.expr_span(e)), tr),
        plant_want: (e: ExprId, ty: TypeId) -> t.plant_want(e, ty),
        want_at: (e: ExprId) -> t.facts.want_at(e),
        feed: (e: ExprId, want: TypeId) -> fed(t, param_types, e, want),
        starving: () -> false,
        starved_at: (e: ExprId) -> t.facts.starved_at(e),
        pair: (e: ExprId) -> t.pair(e),
        paired: (e: ExprId) -> t.paired.any(same_expr(it, e)),
    }
}

/// A block's statements type in order, then its value — which IS
/// the block's type. A block that LEAVES (no tail — the builder
/// proved its last statement diverges) answers whatever the fn it
/// leaves promises: the body check passes exactly, and a
/// value-position arm joins only where the promise's type fits.
fn block_type(t: Typer, param_types: List<TypeId>, stmts: List<StmtId>, value: ExprId?) -> TypeId {
    type_stmts(t, param_types, stmts)
    if value == null { return valueless_type(t, stmts) }
    type_walk(t, param_types, value!)
    t.facts.type_at(value!)
}

/// A block with no value: the fn's promise when its last statement
/// LEAVES (nothing reads the tail), void otherwise.
fn valueless_type(t: Typer, stmts: List<StmtId>) -> TypeId {
    let last: StmtId? = stmts.last()
    if last != null && t.view.store.diverges(last!) { return t.fn_ret.last() ?? t.error_type }
    t.view.decls.types.intern(Type.Void)
}

/// A subtree typed on request, answering its own type — what a
/// CONTROL-OWNING node uses for children it hides from the walk.
fn typed_subtree(t: Typer, param_types: List<TypeId>, root: ExprId) -> TypeId {
    type_walk(t, param_types, root)
    t.facts.type_at(root)
}

/// A lambda's body typed under its params, behind the BARRIER —
/// `return`/`?`/`fail` inside see no enclosing fn. Params register
/// FIRST so the body's reads answer.
fn lambda_walked(t: Typer, param_types: List<TypeId>, lam: ExprId, ptys: List<TypeId>, body: ExprId) -> TypeId {
    t.facts.seat_lambda(lam, ptys)
    mut bar = t.lam_bar
    // LICENSED I15: this IS the bracket fn
    bar.push(t.fn_ret.length)
    let ret = typed_subtree(t, param_types, body)
    let _ = bar.pop()
    ret
}

/// THE RESCUE: a hungry lambda re-types under the seats it lands
/// in — the judging boundary hands them over, the body walks once,
/// and every fact (of_expr, lambda_params) converges as if the
/// annotations had been written.
fn reseated(t: Typer, param_types: List<TypeId>, a: ExprId, seats: List<TypeId>) -> TypeId? {
    if !t.facts.hungry_at(a) { return null }
    let parts: LambdaParts? = t.view.store.lambda_parts(a)
    if parts == null { return null }
    if parts!.params.length != seats.length { return null }
    t.facts.absorb_hunger(a)
    let ret = lambda_walked(t, param_types, a, seats, parts!.body)
    let ty = t.view.types.intern(Type.Fn(seats, ret))
    t.facts.set_type(a, ty)
    ty
}

/// THE FEED: a hungry expression re-typed under the want the door
/// hands it — the want planted, its rule run once more (its kids
/// were typed already), its type set.
fn fed(t: Typer, param_types: List<TypeId>, e: ExprId, want: TypeId) -> TypeId? {
    if !t.facts.hungry_at(e) { return null }
    t.facts.absorb_hunger(e)
    t.plant_want(e, want)
    type_node(t, expr_cx(t, param_types), e)
    t.facts.type_at(e)
}

/// A branch typed under a PROVEN-PRESENT binding: when the asked
/// subject is an effectively-final nullable — a `let` (never a
/// `mut`) or a param — its reads inside the branch narrow to the
/// carried type, each read recorded so lowering unwraps it. A
/// subject that cannot be proven simply walks un-narrowed: the
/// sugar is never load-bearing (spec 10.4).
fn narrowed_subtree(t: Typer, param_types: List<TypeId>, subject: ExprId, branch: ExprId) -> TypeId {
    let b: Binding? = t.names.binding(subject)
    if b == null { return typed_subtree(t, param_types, branch) }
    match b! {
        .Def(s) -> narrowed_def_walk(t, param_types, s, branch),
        .Param(i) -> narrowed_param_walk(t, param_types, i, branch),
        // lambda params and captures never narrow — walk wide
        .Pattern(_, _) or .LambdaParam(_, _) or .Capture(_, _) or .Index(_) or .Decl(_) -> typed_subtree(t, param_types, branch),
    }
}

fn narrowed_def_walk(t: Typer, param_types: List<TypeId>, s: StmtId, branch: ExprId) -> TypeId {
    // A `mut` can be reassigned mid-branch — never narrowed.
    if !(t.view.store.stmt(s) is .Let) { return typed_subtree(t, param_types, branch) }
    framed(t, t.narrow_defs, s.index, t.def_type(s),
           () -> typed_subtree(t, param_types, branch))
}

fn narrowed_param_walk(t: Typer, param_types: List<TypeId>, i: int, branch: ExprId) -> TypeId {
    framed(t, t.narrow_params, i, param_types[i],
           () -> typed_subtree(t, param_types, branch))
}

/// The narrow bracket: when `opt` really is a nullable, its frame
/// lives on the given stack exactly as long as the thunk's walk;
/// otherwise the walk runs bare. The stack ALIASES the Typer's own
/// list, so the push is seen by every nested read.
fn framed(t: Typer, frames: List<NarrowFrame>, key: int, opt: TypeId, walk: fn() -> TypeId) -> TypeId {
    let inner: TypeId? = t.view.types.carried(opt)
    if inner == null { return walk() }
    // LICENSED I15: this IS the bracket
    mut fs = frames
    fs.push(NarrowFrame { key: key, inner: inner!, opt: opt })
    let answer = walk()
    let _ = fs.pop()
    answer
}

/// One node's fact: the owner speaks, the table records.
fn type_node(t: Typer, cx: TypeCx, e: ExprId) {
    t.facts.set_type(e, semantics_of(t.lang.dispatch, t.view.store.expr(e)).type_of(cx, e))
}
/// Every name the LANGUAGE owns — a scalar shape or a constructor
/// row. A declaration may take none of them.
export fn builtin_type_name(rows: List<TypeRow>, name: string) -> bool {
    shape_named(name) != null || type_row(rows, name) != null
}

/// The type an annotation names, or null.
fn shape_named(name: string) -> Type? {
    match name {
        "int" -> Type.Int,
        "string" -> Type.Str,
        "bool" -> Type.Bool,
        "void" -> Type.Void,
        _ -> null,
    }
}

impl Typer {
    fn stmt_loc(self, s: StmtId) -> Loc? {
        loc_at(self.view.source.file, self.view.store.stmt_span(s))
    }

    /// An ident's type, by its binding kind — NARROWED when a
    /// presence test proved this binding present in the branch
    /// being walked (the narrow is recorded for lowering, which
    /// unwraps the read at its one edge). No binding means resolve
    /// already spoke — Error, silently.
    fn target_type(self, e: ExprId, param_types: List<TypeId>) -> TypeId {
        let b: Binding? = self.names.binding(e)
        if b == null { return self.error_type }
        match b! {
            .Param(i) -> self.narrowed_param(e, i) ?? param_types[i],
            .Def(s) -> self.narrowed_def(e, s) ?? self.def_type(s),
            // The arm's OWNER spoke this type before the arm was
            // walked; an absent one means the bind was refused.
            .Pattern(v, j) -> self.facts.pattern_type(v, j) ?? self.error_type,
            .LambdaParam(l, i) -> self.lambda_param_ty(l, i),
            // captures never narrow — the box holds the wide value
            .Capture(l, j) -> self.capture_ty(l, j, param_types),
            .Index(_) -> self.view.types.intern(Type.Int),
            .Decl(d) -> self.decl_type(d),
        }
    }

    /// The narrowed INNER for a def-bound read, when a frame proves
    /// it — recorded so lowering unwraps this very read.
    fn narrowed_def(self, e: ExprId, s: StmtId) -> TypeId? {
        self.narrow_hit(e, self.narrow_defs, s.index)
    }

    fn narrowed_param(self, e: ExprId, i: int) -> TypeId? {
        self.narrow_hit(e, self.narrow_params, i)
    }

    /// One stack's answer: the frame whose key matches, its read
    /// recorded as wearing the frame's OPT.
    fn narrow_hit(self, e: ExprId, frames: List<NarrowFrame>, key: int) -> TypeId? {
        let hit: NarrowFrame? = frames.find(it.key == key)
        if hit == null { return null }
        self.facts.narrow(e, hit!.opt)
        hit!.inner
    }

    /// THE EXPECTED-TYPE CHANNEL's write side: a boundary that
    /// knows its slot plants the want BEFORE the value walks — and
    /// the want flows through every HEIR (branch arms, block
    /// values), so a lambda three arms deep still hears it.
    /// A paired head's subject — where `enumerate` may stand.
    fn pair(self, e: ExprId) {
        mut ps = self.paired
        ps.push(e)
    }

    fn plant_want(self, e: ExprId, ty: TypeId) {
        self.facts.set_want(e, ty)
        let node = self.view.store.expr(e)
        for h in semantics_of(self.lang.dispatch, node).heirs(node) {
            self.plant_want(h, ty)
        }
    }

    /// A foreign name read as a value: a type's name, or a fn worn
    /// as a value — the answers a local declaration gives.
    fn decl_type(self, d: DeclId) -> TypeId {
        decl_type_of(self.view.decls, self.facts.voices, self.error_type, d)
    }

    /// A declaring statement's identity in the shared table.
    fn decl_of(self, s: StmtId) -> DeclId {
        self.view.decls.decl_of(self.view.file, s)!
    }

    /// A statement's declared signature — absent for a statement that
    /// declares nothing (a `let` bound to a value).
    fn stmt_sig(self, s: StmtId) -> DeclSig? {
        let d: DeclId? = self.view.decls.decl_of(self.view.file, s)
        if d == null { return null }
        self.view.decls.sig(d!)
    }

    /// Inside a lambda body — behind its barrier, no enclosing fn
    /// answers.
    fn behind_lambda(self) -> bool {
        let bar: int? = self.lam_bar.last()
        bar != null && self.fn_ret.length <= bar!
    }

    /// Every expression still hungry when typing ends never met the
    /// want it needed — its rule runs once more, STARVING, and
    /// speaks in its own words.
    fn speak_hungry(self) {
        let cx = expr_cx(self, []) with { starving: () -> true }
        for e in self.facts.hungry_ones() { type_node(self, cx, e) }
    }

    /// The enclosing fn's answer — unless a LAMBDA BARRIER stands
    /// between: a lambda body answers itself, so `return`, `?`, and
    /// `fail` inside one see no enclosing fn at all.
    fn reachable_ret(self) -> TypeId? {
        let bar: int? = self.lam_bar.last()
        if bar != null && self.fn_ret.length <= bar! { return null }
        self.fn_ret.last()
    }

    /// A lambda param's declared type, by seat.
    fn lambda_param_ty(self, l: ExprId, i: int) -> TypeId {
        let ps: List<TypeId>? = self.facts.lambda_seats(l)
        if ps == null { return self.error_type }
        ps![i]
    }

    /// A capture's type — its SOURCE binding's, chained through
    /// nested lambdas.
    fn capture_ty(self, l: ExprId, j: int, param_types: List<TypeId>) -> TypeId {
        let cap: Cap? = self.names.capture(l)
        if cap == null { return self.error_type }
        self.binding_ty(cap!.sources[j], param_types)
    }

    /// The un-narrowed type a binding wears — the capture law's
    /// projection.
    fn binding_ty(self, b: Binding, param_types: List<TypeId>) -> TypeId {
        match b {
            .Param(i) -> param_types[i],
            .Def(s) -> self.def_type(s),
            .Pattern(v, j) -> self.facts.pattern_type(v, j) ?? self.error_type,
            .LambdaParam(l, i) -> self.lambda_param_ty(l, i),
            .Capture(l, j) -> self.capture_ty(l, j, param_types),
            .Index(_) -> self.view.types.intern(Type.Int),
            .Decl(d) -> self.decl_type(d),
        }
    }

    fn def_type(self, s: StmtId) -> TypeId {
        def_type_of(self.facts, self.view.store, self.view.types, self.error_type, s)
    }

    /// An annotated binding's DECLARED type: interned once, recorded
    /// so every later read of the name answers it, and returned for
    /// the value's acceptance check.
    fn bind_declared(self, s: StmtId, ann: TypeRef) -> TypeId {
        let ty = self.full_type(self.stmt_loc(s), ann)
        self.record_binding(s, ty)
        ty
    }

    /// A binding's COMPUTED type, recorded by the rule that knows it
    /// (a `let v? =` bind holds what the subject carries) — the same
    /// table the annotated law writes.
    fn record_binding(self, s: StmtId, ty: TypeId) { self.facts.record_binding(s, ty) }

    fn speak(self, d: Diag) { self.facts.speak(d) }
}

/// Whether an interned id is the Var wearing this name.
fn var_named(types: TypeRegistry, id: TypeId, name: string) -> bool {
    match types.shape_of(id) {
        .Var(_, _, n) -> n == name,
        _ -> false,
    }
}

/// A declared generic's arity by NAME, for the applied-type path —
/// null when the name is not a generic declaration.
fn declared_arity(t: Typer, name: string) -> int? {
    let decl: DeclId? = type_named(t.names, name)
    if decl == null { return null }
    let arity = t.view.decls.tparams(decl!).length
    if arity == 0 { return null }
    arity
}

/// The slot-law help, worded once — every slot that must wait says
/// exactly this.
fn slots_await_ownership() -> string {
    "nullable slots arrive with ownership's next slice"
}

/// The first parameter is the bare `self` seat.
fn selfed(params: List<Param>) -> bool {
    let head: Param? = params.first()
    if head == null { return false }
    head!.name == "self" && head!.ty == null
}

/// Two sigs agree seat by seat — the trait's has no self, the
/// method's does, so the method's params offset by one.
fn sigs_agree(want: FnSig, got: FnSig) -> bool {
    if got.params.length != want.params.length + 1 { return false }
    // LICENSED I9: type identity — interned ids ARE the agreement
    if want.ret.index != got.ret.index { return false }
    // LICENSED I3: the offset ZIP; comprehensions cannot destructure enumerate
    for (j, w) in want.params.enumerate() {
        // LICENSED I9: type identity — interned ids ARE the agreement
        if got.params[j + 1].index != w.index { return false }
    }
    true
}

/// The self-first help, worded once.
fn self_first(name: string) -> string {
    "write `fn ${name}(self, …)`"
}

/// A module's name in prose.
fn module_word(m: string) -> string {
    if m.length == 0 { return "the root module" }
    "module `${m}`"
}
