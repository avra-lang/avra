//! The type pass — the second pure query. The driver owns the
//! registry, the dense table, the fn signatures, and the walk; what
//! a NODE's type IS lives in its owning feature's NodeSemantics.
//! Facts stay TOTAL: every expression has a TypeId, never an option
//! and never an Unknown — a hole or unresolved name types as the
//! interned Error, which ABSORBS: the causing pass already spoke,
//! so no diagnostic cascades from it. Signatures come first, from
//! the annotations alone, so a call may name a fn declared later.
use core.{StmtId, ExprId, TypeId, Type, Param, TypeRegistry, new_type_registry, filled}
use diagnostics.{Diag, loc_at, error_at, pointed}
use features.{TypeCx, StmtTypeCx, FnSig, StructSig, EnumSig, DeclSig,
              fn_sig_of, record_sig_of, variant_sig_of, duplicate_member}
use @std.errors.{Loc}

/// The pass's facts: the registry, a dense expression table, and a
/// dense signature table indexed by StmtId — total, O(1) reads for
/// every later pass.
export type Typing = {
    types: TypeRegistry,
    of_expr: List<TypeId>,
    decls: List<DeclSig?>,
    diagnostics: List<Diag>,
}

/// The type of a typed expression.
export fn type_of(t: Typing, e: ExprId) -> TypeId {
    t.of_expr[e.index]
}

type Typer = {
    p: ParsedProgram,
    resolution: Resolution,
    types: TypeRegistry,
    of_expr: List<TypeId>,
    decls: List<DeclSig?>,
    diagnostics: List<Diag>,
}

export fn type_check(p: ParsedProgram, r: Resolution) -> Typing {
    let registry = new_type_registry()
    // The table is born total: every slot pre-typed as the hole.
    let hole = registry.intern(Type.Error)
    let t = Typer {
        p: p, resolution: r, types: registry,
        of_expr: filled(p.store.exprs.count(), hole),
        decls: filled<DeclSig?>(p.store.stmts.count(), null),
        diagnostics: [],
    }
    t.declare_type_sigs()
    t.declare_sigs()
    type_stmts(t, [], p.stmts)
    Typing {
        types: t.types, of_expr: t.of_expr, decls: t.decls,
        diagnostics: t.diagnostics,
    }
}

/// Statements in order, each through its own StmtSemantics — the
/// ONE statement loop, top level and blocks alike. The context is
/// state verbs plus the whole expression vocabulary; the rules live
/// with their features.
fn type_stmts(t: Typer, param_types: List<TypeId>, stmts: List<StmtId>) {
    let ecx = expr_cx(t, param_types)
    let cx = StmtTypeCx {
        store: t.p.store,
        expr: ecx,
        walk: (v: ExprId) -> type_walk(t, param_types, v),
        walk_under: (pts: List<TypeId>, body: ExprId) -> type_walk(t, pts, body),
        type_stmts: (body: List<StmtId>) -> type_stmts(t, param_types, body),
        sig_of: (s: StmtId) -> fn_sig_of(t.decls[s.index]),
        assign_target: (s: StmtId) -> assign_target_of(t.resolution, s),
        loc_of: (s: StmtId) -> t.stmt_loc(s),
    }
    for s in stmts { stmt_semantics_of(t.p.dispatch, t.p.store.stmt(s)).type_stmt(cx, s) }
}

/// One subtree's types, under the given param types.
fn type_walk(t: Typer, param_types: List<TypeId>, root: ExprId) {
    let cx = expr_cx(t, param_types)
    for e in t.p.post_order(root) { type_node(t, cx, e) }
}

/// The expression capabilities, wired once for a given param scope.
fn expr_cx(t: Typer, param_types: List<TypeId>) -> TypeCx {
    let cx = TypeCx {
        store: t.p.store,
        type_at: (e: ExprId) -> t.of_expr[e.index],
        shape_at: (e: ExprId) -> t.types.shape_of(t.of_expr[e.index]),
        shape_of: (ty: TypeId) -> t.types.shape_of(ty),
        intern: (sh: Type) -> t.types.intern(sh),
        target_type: (e: ExprId) -> t.target_type(e, param_types),
        sig_of: (e: ExprId) -> t.sig_at(e),
        bound_def: (e: ExprId) -> t.def_of(e),
        fields_of: (ty: TypeId) -> t.fields_of(ty),
        variants_of: (ty: TypeId) -> t.variants_of(ty),
        block_type: (stmts: List<StmtId>, value: ExprId) -> block_type(t, param_types, stmts, value),
        name_at: (e: ExprId) -> t.types.name_of(t.of_expr[e.index]),
        type_name: (ty: TypeId) -> t.types.name_of(ty),
        loc_of: (e: ExprId) -> loc_at(t.p.source.file, t.p.store.expr_span(e)),
        emit: (d: Diag) -> t.speak(d),
    }
    cx
}

/// A block's statements type in order, then its value — which IS
/// the block's type.
fn block_type(t: Typer, param_types: List<TypeId>, stmts: List<StmtId>, value: ExprId) -> TypeId {
    type_stmts(t, param_types, stmts)
    type_walk(t, param_types, value)
    t.of_expr[value.index]
}

/// One node's fact: the owner speaks, the table records.
fn type_node(t: Typer, cx: TypeCx, e: ExprId) {
    mut facts = t.of_expr
    facts.set(e.index, semantics_of(t.p.dispatch, t.p.store.expr(e)).type_of(cx, e))
}

/// The type an annotation names, or null.
fn shape_named(name: string) -> Type? {
    match name {
        "int" -> Type.Int,
        "string" -> Type.Str,
        "bool" -> Type.Bool,
        _ -> null,
    }
}

impl Typer {
    /// Every declared type's table, from its declaration alone —
    /// BEFORE fn sigs, whose annotations may name these types.
    fn declare_type_sigs(self) {
        for s in self.p.stmts {
            let sp: StructParts? = self.p.store.struct_parts(s)
            if sp != null { self.declare_struct_sig(s, sp!.fields) }
            let ep: EnumParts? = self.p.store.enum_parts(s)
            if ep != null { self.declare_enum_sig(s, ep!.variants) }
        }
    }

    /// An enum's variant table — the index IS the runtime tag.
    fn declare_enum_sig(self, s: StmtId, variants: List<string>) {
        let sig = EnumSig { names: variants }
        self.declare(s, DeclSig.Variants(sig))
    }

    /// One declaration's table lands in the ONE dense record.
    fn declare(self, s: StmtId, d: DeclSig) {
        mut sig_table = self.decls
        sig_table.set(s.index, d)
    }

    fn declare_struct_sig(self, s: StmtId, fields: List<Param>) {
        let names = [f.name for f in fields]
        let owner: string = self.p.store.type_decl_name(s) ?? "this type"
        for (j, f) in fields.enumerate() {
            if names.index_of(f.name) < j {
                self.speak(duplicate_member("type.duplicate_field", owner, f.name, self.stmt_loc(s)))
            }
        }
        let types = [self.field_type(s, f) for f in fields]
        let sig = StructSig { names: names, types: types }
        self.declare(s, DeclSig.Record(sig))
    }

    /// A field's type — scalars only, until ownership analysis.
    fn field_type(self, s: StmtId, f: Param) -> TypeId {
        let sh: Type? = shape_named(f.ty)
        if sh != null {
            if sh! is .Int || sh! is .Bool { return self.types.intern(sh!) }
        }
        self.speak(pointed(
            error_at("type.struct_scalar", self.stmt_loc(s), "struct fields hold scalars for now"),
            "field `${f.name}` is `${f.ty}`")
            with { help: "`int` and `bool` fields today — managed fields arrive with ownership analysis" })
        self.types.intern(Type.Error)
    }

    /// Every fn's signature, from its annotations alone — before any
    /// body walks, so calls resolve signatures program-wide.
    fn declare_sigs(self) {
        for s in self.p.stmts {
            let parts: FnParts? = self.p.store.fn_parts(s)
            if parts != null { self.declare_sig(s, parts!.params, parts!.ret) }
        }
    }

    fn declare_sig(self, s: StmtId, fparams: List<Param>, fret: string) {
        let ptypes = [self.annotated(s, pp.ty) for pp in fparams]
        let rt = self.annotated(s, fret)
        let sig = FnSig { params: ptypes, ret: rt }
        self.declare(s, DeclSig.Fn(sig))
    }

    /// An annotation's TypeId: a builtin shape, a declared type, or
    /// a spoken absence.
    fn annotated(self, s: StmtId, name: string) -> TypeId {
        let sh: Type? = shape_named(name)
        if sh != null { return self.types.intern(sh!) }
        let decl: StmtId? = self.resolution.type_defs.get(name)
        if decl != null { return self.declared_type(decl!, name) }
        self.speak(pointed(
            error_at("type.unknown", self.stmt_loc(s), "`${name}` names no type"),
            "in this signature")
            with { help: "the types today are `int`, `string`, `bool`, and your declared types" })
        self.types.intern(Type.Error)
    }

    /// A declared name's type: an enum's value shape or a record's.
    fn declared_type(self, s: StmtId, name: string) -> TypeId {
        let ep: EnumParts? = self.p.store.enum_parts(s)
        if ep != null { return self.types.intern(Type.Enum(s, name)) }
        self.types.intern(Type.Struct(s, name))
    }

    fn stmt_loc(self, s: StmtId) -> Loc? {
        loc_at(self.p.source.file, self.p.store.stmt_span(s))
    }

    /// An ident's type, by its binding kind. No binding means
    /// resolve already spoke — Error, silently.
    fn target_type(self, e: ExprId, param_types: List<TypeId>) -> TypeId {
        let b: Binding? = binding_of(self.resolution, e)
        if b == null { return self.types.intern(Type.Error) }
        match b! {
            .Param(i) -> param_types[i],
            .Def(s) -> self.def_type(s),
        }
    }

    /// A definition statement's value type. A TYPE declaration used
    /// as a value is the compile-only TypeName — the shape variant
    /// construction reads and nothing else accepts.
    fn def_type(self, s: StmtId) -> TypeId {
        let tname: string? = self.p.store.type_decl_name(s)
        if tname != null { return self.types.intern(Type.TypeName(s, tname!)) }
        let v: ExprId? = self.p.store.stmt_value(s)
        if v == null { return self.types.intern(Type.Error) }
        self.of_expr[v!.index]
    }

    /// A call's target signature, when resolve found one.
    fn sig_at(self, e: ExprId) -> FnSig? {
        let b: Binding? = binding_of(self.resolution, e)
        if b == null { return null }
        match b! {
            .Def(s) -> fn_sig_of(self.decls[s.index]),
            .Param(_) -> null,
        }
    }

    /// The definition statement an expression's binding names.
    fn def_of(self, e: ExprId) -> StmtId? {
        let b: Binding? = binding_of(self.resolution, e)
        if b == null { return null }
        match b! {
            .Def(s) -> s,
            .Param(_) -> null,
        }
    }

    /// A struct type's field table; null for every other shape.
    fn fields_of(self, ty: TypeId) -> StructSig? {
        match self.types.shape_of(ty) {
            .Struct(decl, _) -> record_sig_of(self.decls[decl.index]),
            _ -> null,
        }
    }

    /// An enum type's variant table; null for every other shape.
    fn variants_of(self, ty: TypeId) -> EnumSig? {
        match self.types.shape_of(ty) {
            .Enum(decl, _) -> variant_sig_of(self.decls[decl.index]),
            _ -> null,
        }
    }

    fn speak(self, d: Diag) {
        mut ds = self.diagnostics
        ds.push(d)
    }
}
