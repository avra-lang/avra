//! THE MANIFEST — `avra.toml` read into facts: the package's name and
//! version, its targets, its dependencies, and every voice the
//! manifest's rules speak (`manifest.*`, F4000–F4099). Pure in the
//! text; what needs the disk — a dependency's directory, the name it
//! calls itself, the cycle — is the workspace's to judge, in this
//! file's words.
use core.{span_of, joined, is_package_key, is_name_word, is_digit, code_at, Span}
use @std.toml.{TomlDoc, TomlValue, TomlEntry, TomlHeader, parse_toml, toml_text, toml_field}
use diagnostics.{SourceFile, Diag, refusal, warning, loc_at}
use @std.errors.{Loc}

/// A dependency as the manifest names it: its key (`@scope/name`),
/// its path when it is a path dependency, whether it serves tests
/// only, and where its line is.
export type Dependency = { key: string, path: string?, dev: bool, at: Loc? }

/// A manifest's facts. `bin` and `lib` are entry files relative to
/// the package root — the written path, or the section's default.
/// `deps_at` is where a new dependency line goes: after the last
/// one, else after the `[dependencies]` header, else absent (the
/// file has no such section yet).
export type Manifest = { name: string, version: string, bin: string?, lib: string?, deps: List<Dependency>, deps_at: Span?, excludes: List<string>, voices: List<Diag> }

/// A reader over one document: the source for positions, the
/// document, and what it has said so far.
type Reader = { src: SourceFile, doc: TomlDoc, voices: List<Diag> }

export fn read_manifest(src: SourceFile) -> Manifest {
    let r = Reader { src: src, doc: parse_toml(src.text), voices: [] }
    for e in r.doc.errors { r.speak(refusal("manifest.syntax", r.at(e.lo, e.hi), e.message, "here", null)) }
    r.unknowns()
    if !r.doc.has_section("package") {
        r.speak(refusal("manifest.no_package", r.at(0, 0), "a manifest declares its package — `[package]` is missing", "this manifest", "add `[package]` with `name` and `version`"))
        return Manifest { name: "", version: "", bin: null, lib: null, deps: [], deps_at: null, excludes: [], voices: r.voices }
    }
    let name = r.word("name", "manifest.no_name", "a name — `name = \"@scope/name\"`")
    let version = r.word("version", "manifest.no_version", "a version — `version = \"0.1.0\"`")
    if name != "" && !lawful_name(name) { r.speak(r.bad_name(name)) }
    if version != "" && !is_semver(version) { r.speak(r.bad_version(version)) }
    r.profiles()
    Manifest {
        name: name, version: version,
        bin: r.target("bin", "src/main.av"), lib: r.target("lib", "src/lib.av"), excludes: r.excludes(),
        deps: r.dependencies("dependencies", false, name).concat(r.dependencies("dev-dependencies", true, name)),
        deps_at: r.deps_at(),
        voices: r.voices,
    }
}

/// A package name: `@scope/name`, or one bare word for a program
/// that nothing imports.
fn lawful_name(name: string) -> bool {
    is_package_key(name) || is_name_word(name)
}

/// `MAJOR.MINOR.PATCH`, an optional `-` suffix after.
fn is_semver(v: string) -> bool {
    let cut = v.index_of("-")
    let core = if cut < 0 { v } else { v.substring(0, cut) }
    let parts = core.split(".")
    parts.length == 3 && parts.all(is_number(it))
}

fn is_number(s: string) -> bool {
    let n = s.length
    if n == 0 { return false }
    mut i = 0
    while i < n {
        if !is_digit(code_at(s, i)) { return false }
        i = i + 1
    }
    true
}

/// The sections a manifest may hold, and the keys each takes.
fn known_section(name: string) -> bool {
    name == "package" || name == "bin" || name == "lib" || name == "dependencies" || name == "dev-dependencies" ||
        name == "features" || name == "build" || name.starts_with("profile.")
}

fn known_key(section: string, key: string) -> bool {
    if section == "package" { return ["name", "version", "edition", "authors", "license", "description", "repository", "exclude"].contains(key) }
    if section == "bin" || section == "lib" { return key == "path" || key == "name" }
    if section.starts_with("profile.") { return ["opt_level", "debug", "overflow_checks", "incremental", "coverage"].contains(key) }
    true
}

/// The opt levels the spec names.
fn lawful_opt_level(v: TomlValue) -> bool {
    match v {
        .Int(n) -> n >= 0 && n <= 3,
        .Str(s) -> s == "s" || s == "z",
        .Bool(_) or .Strs(_) or .Table(_) -> false,
    }
}

impl Reader {
    fn speak(self, d: Diag) {
        self.voices.push(d)
    }

    fn at(self, lo: int, hi: int) -> Loc? {
        loc_at(self.src.file, span_of(lo, hi))
    }

    fn entry_at(self, e: TomlEntry) -> Loc? {
        self.at(e.lo, e.hi)
    }

    /// A required `[package]` word; "" when missing or empty — the
    /// voice speaks, the caller judges nothing further.
    fn word(self, key: string, kind: string, wanted: string) -> string {
        let e: TomlEntry? = self.doc.entry("package", key)
        let text: string? = if e == null { null } else { toml_text(e!.value) }
        if text != null && text!.length > 0 { return text! }
        let at: Loc? = if e == null { self.header_at("package") } else { self.entry_at(e!) }
        self.speak(refusal(kind, at, "`[package]` needs ${wanted}", "here", null))
        ""
    }

    fn header_at(self, section: string) -> Loc? {
        let h: TomlHeader? = self.doc.headers.find(it.name == section)
        if h == null { return self.at(0, 0) }
        self.at(h!.lo, h!.hi)
    }

    /// Unknown sections and keys warn — a newer manifest loads on
    /// an older compiler, degraded and said so.
    fn unknowns(self) {
        for s in self.doc.sections() {
            if !known_section(s) {
                self.speak(warning("manifest.unknown_section", self.header_at(s), "`[${s}]` is not a section this compiler reads", "ignored", null))
            } else {
                for e in self.doc.entries_of(s) {
                    if !known_key(s, e.key) { self.speak(warning("manifest.unknown_key", self.entry_at(e), "`${e.key}` is not a key of `[${s}]`", "ignored", null)) }
                }
            }
        }
    }

    /// A target's entry path: the written one, the section's
    /// default when the section is declared bare, absence when it
    /// is not declared.
    fn target(self, section: string, default_path: string) -> string? {
        if !self.doc.has_section(section) { return null }
        let v: TomlValue? = self.doc.get(section, "path")
        if v == null { return default_path }
        toml_text(v!) ?? default_path
    }

    /// Every profile's name is a word, and its opt level is one the
    /// spec names.
    fn profiles(self) {
        for s in self.doc.sections() {
            if s.starts_with("profile.") {
                let pname = s.substring(8, s.length)
                if !is_name_word(pname) { self.speak(refusal("manifest.bad_profile", self.header_at(s), "a profile name is `[a-z0-9_-]+` — `${pname}` is not", "this profile", null)) }
                let opt_level: TomlEntry? = self.doc.entry(s, "opt_level")
                if opt_level != null && !lawful_opt_level(opt_level!.value) {
                    self.speak(refusal("manifest.bad_opt_level", self.entry_at(opt_level!), "`opt_level` is 0, 1, 2, 3, \"s\" or \"z\"", "here", null))
                }
            }
        }
    }

    /// The path dependencies of a section; every other form speaks
    /// and is not a dependency.
    fn dependencies(self, section: string, dev: bool, own: string) -> List<Dependency> {
        mut out: List<Dependency> = []
        for e in self.doc.entries_of(section) {
            let d: Dependency? = self.dependency(e, dev, own)
            if d != null { out.push(d!) }
        }
        out
    }

    fn dependency(self, e: TomlEntry, dev: bool, own: string) -> Dependency? {
        let at = self.entry_at(e)
        if e.key == own { return self.spoken(self.self_dependency(at, e.key)) }
        if !is_package_key(e.key) { return self.spoken(self.unscoped(at, e.key)) }
        let path: string? = path_of(e.value)
        if path == null { return self.spoken(self.unsupported(at, e.key)) }
        Dependency { key: e.key, path: path, dev: dev, at: at }
    }

    /// Speak, and answer no dependency.
    fn spoken(self, d: Diag) -> Dependency? {
        self.speak(d)
        null
    }

    /// Source paths the package EXCLUDES — vendored code another
    /// toolchain reads from inside `src/`; the compiler never sees it.
    fn excludes(self) -> List<string> {
        let e: TomlEntry? = self.doc.entry("package", "exclude")
        if e == null { return [] }
        match e!.value {
            .Strs(items) -> items,
            _ -> [],
        }
    }

    /// Where the next dependency line goes.
    fn deps_at(self) -> Span? {
        let last: TomlEntry? = self.doc.entries_of("dependencies").last()
        if last != null { return after(last!.hi) }
        let h: TomlHeader? = self.doc.headers.find(it.name == "dependencies")
        if h == null { return null }
        after(h!.hi)
    }

    // ── voices ──

    fn bad_name(self, name: string) -> Diag {
        refusal("manifest.bad_name", self.entry_at(self.doc.entry("package", "name")!), "a package is named `@scope/name` — `${name}` is not", "here", "scope and name are words of `[a-z0-9_-]`")
    }

    fn bad_version(self, version: string) -> Diag {
        refusal("manifest.bad_version", self.entry_at(self.doc.entry("package", "version")!), "a version is `MAJOR.MINOR.PATCH` — `${version}` is not", "here", null)
    }

    fn self_dependency(self, at: Loc?, key: string) -> Diag {
        refusal("manifest.self_dependency", at, "`${key}` is this package — a package does not depend on itself", "here", null)
    }

    fn unscoped(self, at: Loc?, key: string) -> Diag {
        refusal("manifest.unscoped_dependency", at, "a dependency is named `@scope/name` — `${key}` has no scope", "here", "name it as its own manifest does, `\"@scope/${key}\"`")
    }

    fn unsupported(self, at: Loc?, key: string) -> Diag {
        refusal("manifest.unsupported_dependency", at, "`${key}` is not a path dependency — only `{ path = \"…\" }` resolves; registry and git forms arrive with their transports", "here", null)
    }
}

/// The `path` of a `{ path = "…" }` value; absence for every other
/// form.
fn path_of(v: TomlValue) -> string? {
    let p: TomlValue? = toml_field(v, "path")
    if p == null { return null }
    toml_text(p!)
}

// ── The workspace's voices, in the manifest's words ──

export fn bad_dependency_path(at: Loc?, key: string, dir: string) -> Diag {
    refusal("manifest.bad_path", at, "`${key}` points at `${dir}`, which holds no `avra.toml`", "this dependency", "a path dependency is a package directory")
}

export fn name_mismatch(at: Loc?, key: string, found: string, dir: string) -> Diag {
    refusal("manifest.name_mismatch", at, "the package at `${dir}` calls itself `${found}`, not `${key}`", "this dependency", "key it as `\"${found}\"`")
}

export fn dependency_cycle(at: Loc?, chain: List<string>) -> Diag {
    refusal("manifest.cycle", at, "packages depend in a cycle: ${joined(chain, " -> ")}", "closes the cycle here", "a package graph is acyclic — cut one edge")
}

export fn duplicate_package(at: Loc?, key: string, first: string, second: string) -> Diag {
    refusal("manifest.duplicate_package", at, "`${key}` is claimed by two directories: `${first}` and `${second}`", "this dependency", "one name is one package — point both at one directory")
}

export fn no_target(root: string) -> Diag {
    refusal("manifest.no_target", null, "`${root}/avra.toml` declares no `[bin]`, and `src/main.av` does not exist — nothing to run", "", "add `[bin]` with `path`, or `src/main.av`")
}

/// Where a new dependency line goes, as an offset — what the fix
/// and its tests read.
export fn deps_offset(m: Manifest) -> int? {
    m.deps_at?.hi
}

/// The empty span at an offset — where a line goes.
fn after(at: int) -> Span {
    Span { lo: at, hi: at }
}
