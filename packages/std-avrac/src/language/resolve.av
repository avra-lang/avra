//! Name resolution — the first pure query. The driver owns scopes,
//! statement order, and the naming law; what a NODE means for names
//! lives in its owning feature's NodeSemantics, and a feature's own
//! rules speak their diagnostics through the context. Facts land in a Resolution the pass owns.
//! A symbol's identity is its definition site. Two namespaces, one
//! pass: `let` visibility is sequential and a later `let` shadows an
//! earlier one; `fn` names are program-wide, so recursion and mutual
//! recursion are free. Inside a body, params bind innermost.
use core.{StmtId, ExprId, Param, closest, Closest, some_list, filled}
use diagnostics.{Diag, error_at, loc_at, pointed}
use features.{ResolveCx, StmtResolveCx}
use @std.errors.{Loc, Frame, Confidence, Edit, Suggestion}

/// What a name USE resolves to — the ONE binding currency every
/// consumer dispatches on. A new binding kind (a captured upvalue,
/// a loop's counter) is a new VARIANT here, and every consumer's
/// match breaks loudly.
///
/// EVERY VARIANT OWES TWO FACTS, one per pass — the passes cannot
/// share a table, so each keeps its own and the shapes MIRROR:
///
///   variant    TYPE fact (typing)     REGISTER fact (lowering)
///   Param      param_types[i]         the index IS the register
///   Def        decls[stmt]            slots[stmt]
///   Pattern    pattern_types[arm]     pattern_regs[arm]
///
/// A new variant answers both columns or the build refuses.
export enum Binding {
    /// The enclosing fn's Nth parameter — params ARE registers.
    Param(index: int)
    /// A binding statement (`let`, `mut`, `fn`) — the definition
    /// site is the identity.
    Def(stmt: StmtId)
    /// A PATTERN's payload, bound for the ONE arm whose value this
    /// is — the first binding in the language that is not a
    /// statement. The arm's value IS the identity, so both later
    /// passes key their fact by it like any other node fact.
    Pattern(arm: ExprId)
    /// A LAMBDA's Nth parameter — in the LIFTED body, register N+1
    /// (the env box rides seat 0). Type fact: the lambda's own
    /// annotation table.
    LambdaParam(lam: ExprId, index: int)
    /// A name a lambda CAPTURED — slot 1+index of its env box. The
    /// lambda's capture fact names the underlying outer binding;
    /// nesting chains Capture through Capture.
    Capture(lam: ExprId, index: int)
}

/// One lambda's capture set, in first-use order — the box's lane
/// assignment: creation packs sources[j] into slot 1+j, and the
/// lifted body reads the same lanes.
export type Cap = { names: List<string>, sources: List<Binding> }

/// The pass's facts: ONE dense binding table indexed by ExprId
/// (O(1) reads for every later pass), the assignment fact keyed by
/// the assigning STATEMENT, and the program-wide TYPE namespace.
export type Resolution = {
    bindings: List<Binding?>,
    assign_targets: List<StmtId?>,
    type_defs: Map<string, StmtId>,
    captures: List<Cap?>,
    diagnostics: List<Diag>,
}

/// A lambda's capture set, when resolve recorded one.
export fn captures_of(r: Resolution, lam: ExprId) -> Cap? {
    r.captures[lam.index]
}

/// The binding a resolved expression names, when it does.
export fn binding_of(r: Resolution, e: ExprId) -> Binding? {
    r.bindings[e.index]
}

/// The mut binding an assignment writes, when resolve accepted it.
export fn assign_target_of(r: Resolution, s: StmtId) -> StmtId? {
    r.assign_targets[s.index]
}

/// Words the spec reserves for future levels, memory, and
/// concurrency: refusing them as names today means they become
/// keywords tomorrow without breaking any program. (Today's ACTUAL
/// keywords derive from the grammar — `p.keywords` — never a list
/// kept by hand.)
fn reserved() -> List<string> {
    ["systems", "bare", "hardware", "owned", "borrow", "move",
     "level", "unsafe", "extern", "async", "spawn", "await",
     "channel", "select"]
}

type Def = { name: string, stmt: StmtId }

/// One OPEN lambda during the walk: its params, and the overlay
/// depth at entry — an overlay at or above the floor is
/// lambda-local; below it lies the outer world, reached by capture.
type LFrame = { lam: ExprId, params: List<string>, floor: int }

type Resolver = {
    p: ParsedProgram,
    all_defs: List<Def>,
    def_names: List<string>,
    visible: Map<string, Binding>,
    overlays: List<Map<string, Binding>>,
    lframes: List<LFrame>,
    captures: List<Cap?>,
    fn_defs: Map<string, StmtId>,
    fn_names: List<string>,
    type_defs: Map<string, StmtId>,
    type_names: List<string>,
    bindings: List<Binding?>,
    assign_targets: List<StmtId?>,
    walked: List<bool>,
    scoped: List<bool>,
    diagnostics: List<Diag>,
}

export fn resolve(p: ParsedProgram) -> Resolution {
    let defs = defs_of(p.store, p.stmts)
    let r = Resolver {
        p: p, all_defs: defs,
        def_names: [d.name for d in defs],
        visible: {}, overlays: [], lframes: [],
        captures: filled<Cap?>(p.store.exprs.count(), null),
        fn_defs: {}, fn_names: [],
        type_defs: {}, type_names: [],
        bindings: filled<Binding?>(p.store.exprs.count(), null),
        assign_targets: filled<StmtId?>(p.store.stmts.count(), null),
        walked: filled(p.store.exprs.count(), false),
        scoped: filled(p.store.stmts.count(), false),
        diagnostics: [],
    }
    r.declare_fns()
    r.declare_types()
    resolve_stmts(r, [], false, p.stmts)
    Resolution {
        bindings: r.bindings, assign_targets: r.assign_targets,
        type_defs: r.type_defs, captures: r.captures,
        diagnostics: r.diagnostics,
    }
}

/// Statements in order, each through its own StmtSemantics — the
/// ONE statement loop, top level and blocks alike.
fn resolve_stmts(r: Resolver, param_names: List<string>, in_block: bool, stmts: List<StmtId>) {
    let cx = StmtResolveCx {
        store: r.p.store,
        in_block: in_block,
        walk: (v: ExprId) -> resolve_walk(r, param_names, v),
        walk_under: (ps: List<Param>, body: ExprId) -> resolve_walk(r, [pp.name for pp in ps], body),
        bind_checked: (s: StmtId) -> r.bind_checked(s),
        check_params: (ps: List<Param>, s: StmtId) -> r.check_params(ps, s),
        scope_stmts: (body: List<StmtId>) -> scoped_stmts(r, param_names, body),
        impl_stmts: (body: List<StmtId>) -> resolve_stmts(r, param_names, false, body),
        bound_scope: (s: StmtId, exprs: List<ExprId>, body: List<StmtId>) ->
            bound_scope(r, param_names, s, exprs, body),
        is_param: (name: string) -> index_of_name(param_names, name) != null,
        lookup: (name: string) -> r.definition_of(name),
        record_assign: (s: StmtId, target: StmtId) -> r.record_assign(s, target),
        loc_of: (s: StmtId) -> r.stmt_loc(s),
        emit: (d: Diag) -> r.speak(d),
    }
    for s in stmts { stmt_semantics_of(r.p.dispatch, r.p.store.stmt(s)).resolve_stmt(cx, s) }
}

/// A fresh overlay scope around `run`: binds made inside are
/// visible onward and die at exit — the ONE scope ritual.
fn under_overlay(r: Resolver, run: fn()) {
    mut ov = r.overlays
    let fresh: Map<string, Binding> = {}
    // LICENSED I15: this IS the bracket fn
    ov.push(fresh)
    run()
    let _ = ov.pop()
}

/// A statement list under its own overlay scope — a loop body.
fn scoped_stmts(r: Resolver, param_names: List<string>, stmts: List<StmtId>) {
    under_overlay(r, () -> resolve_stmts(r, param_names, true, stmts))
}

/// A fresh scope where `s`'s own binding holds: the exprs walk and
/// the statements resolve inside it, and the binding dies at exit —
/// a loop variable's home. A scoped binder never counts as a
/// later definition: its name outside the scope is plainly unknown.
fn bound_scope(r: Resolver, param_names: List<string>, s: StmtId, exprs: List<ExprId>, stmts: List<StmtId>) {
    mut sc = r.scoped
    sc.set(s.index, true)
    under_overlay(r, () -> bound_body(r, param_names, s, exprs, stmts))
}

/// Inside the bound scope: the binder holds, the exprs walk, the
/// statements resolve.
fn bound_body(r: Resolver, param_names: List<string>, s: StmtId, exprs: List<ExprId>, stmts: List<StmtId>) {
    r.bind_checked(s)
    for e in exprs { resolve_walk(r, param_names, e) }
    resolve_stmts(r, param_names, true, stmts)
}

/// A block's statements under a fresh overlay scope: binds are
/// visible onward and restored at exit.
fn block_scope(r: Resolver, param_names: List<string>, stmts: List<StmtId>, value: ExprId?) {
    under_overlay(r, () -> block_body(r, param_names, stmts, value))
}

/// Inside a block's scope: the statements, then the value — absent
/// when the block leaves instead of answering.
fn block_body(r: Resolver, param_names: List<string>, stmts: List<StmtId>, value: ExprId?) {
    resolve_stmts(r, param_names, true, stmts)
    if value != null { resolve_walk(r, param_names, value!) }
}

/// One match arm's scope: its bind (when it names one) holds for
/// the arm's value and dies with it — the first scope in the
/// language opened by an EXPRESSION rather than a statement.
fn arm_scope(r: Resolver, param_names: List<string>, bind: string, value: ExprId) {
    under_overlay(r, () -> arm_body(r, param_names, bind, value))
}

fn arm_body(r: Resolver, param_names: List<string>, bind: string, value: ExprId) {
    if bind != "" && !r.refused_name(bind, r.loc_of(value)) {
        r.bind(bind, Binding.Pattern(value))
    }
    resolve_walk(r, param_names, value)
}

// ── The lambda frames ───────────────────────────────────────────
// A lambda opens a FRAME: its params, and the overlay depth at
// entry. A name inside resolves innermost-out — frame params and
// frame-local overlays first, then the outer world, and every
// frame crossed on the way out records a CAPTURE. Nesting chains
// Capture through Capture; the stack lives on the Resolver, so
// blocks and arms inside a body need no threading at all.

/// The topmost overlay INDEX holding `name`, or null.
fn overlay_index(overlays: List<Map<string, Binding>>, name: string) -> int? {
    // LICENSED I19: a REVERSE scan — the nearest scope wins
    mut j = overlays.length - 1
    while j >= 0 {
        if overlays[j].get(name) != null { return j }
        j = j - 1
    }
    null
}

/// The binding an overlay index holds for `name`.
fn overlay_at(overlays: List<Map<string, Binding>>, at: int, name: string) -> Binding? {
    let held: Binding? = overlays[at].get(name)
    held
}

/// The home of a name that lives OUTSIDE every lambda frame.
fn no_frame() -> int {
    0 - 1
}

/// The innermost frame whose FLOOR admits the overlay — the frame
/// the overlay was opened inside.
fn overlay_home(lframes: List<LFrame>, ohit: int) -> int {
    // LICENSED I19: a REVERSE scan — innermost frame first
    mut k = lframes.length - 1
    while k >= 0 {
        if lframes[k].floor <= ohit { return k }
        k = k - 1
    }
    no_frame()
}

/// The innermost frame whose PARAMS hold `name`, or null.
fn frame_param_hit(lframes: List<LFrame>, name: string) -> int? {
    // LICENSED I19: a REVERSE scan — innermost frame first
    mut k = lframes.length - 1
    while k >= 0 {
        if index_of_name(lframes[k].params, name) != null { return k }
        k = k - 1
    }
    null
}

/// A lambda's body under its own frame: params bind, outer names
/// capture, and the frame dies with the walk.
fn lambda_scope(r: Resolver, param_names: List<string>, lam: ExprId, params: List<Param>, body: ExprId) {
    // a refused param name still BINDS (declare the wreckage) — the
    // body resolves quietly and the one refusal stands alone
    for pp in params {
        let _ = r.refused_name(pp.name, r.loc_of(lam))
    }
    mut fs = r.lframes
    // LICENSED I15: this IS the bracket fn
    fs.push(LFrame { lam: lam, params: [pp.name for pp in params], floor: r.overlays.length })
    resolve_walk(r, param_names, body)
    let _ = fs.pop()
}

/// The innermost overlay holding `name`, or null — the scan stops
/// at the first hit, which IS the shadowing rule: the nearest
/// scope wins and the outer ones are never consulted.
fn overlay_hit(overlays: List<Map<string, Binding>>, name: string) -> Binding? {
    mut k = overlays.length - 1
    while k >= 0 {
        let found: Binding? = overlays[k].get(name)
        if found != null { return found }
        k = k - 1
    }
    null
}

/// One subtree's resolution, under the given param names.
fn resolve_walk(r: Resolver, param_names: List<string>, root: ExprId) {
    let cx = ResolveCx {
        store: r.p.store,
        use_name: (e: ExprId, name: string) -> r.resolve_name(e, name, param_names),
        use_call: (e: ExprId, name: string) -> r.resolve_call(e, name, param_names),
        use_type: (e: ExprId, name: string) -> r.resolve_type_use(e, name),
        arm_scope: (bind: string, v: ExprId) -> arm_scope(r, param_names, bind, v),
        block_scope: (stmts: List<StmtId>, value: ExprId?) -> block_scope(r, param_names, stmts, value),
        lambda_scope: (lam: ExprId, ps: List<Param>, body: ExprId) -> lambda_scope(r, param_names, lam, ps, body),
    }
    for e in r.p.post_order(root) { semantics_of(r.p.dispatch, r.p.store.expr(e)).resolve(cx, e) }
}

/// Every let definition in the program, in order.
fn defs_of(store: NodeStore, stmts: List<StmtId>) -> List<Def> {
    // LICENSED I13: a comprehension's filter and element cannot share a
    // binding — comprehension bindings are on the sugar backlog
    [Def { name: store.let_name(s)!, stmt: s } for s in stmts if store.let_name(s) != null]
}

/// First index of `name`, or null.
fn index_of_name(names: List<string>, name: string) -> int? {
    let i = names.index_of(name)
    if i < 0 { null } else { i }
}

impl Resolver {
    /// The program-wide fn namespace, gathered before any body walks
    /// — a call may name a fn declared later.
    fn declare_fns(self) {
        for s in self.p.stmts {
            let name: string? = self.p.store.fn_parts(s)?.name
            if name != null { self.declare_fn(name!, s) }
        }
    }

    /// The naming law, in one place: keywords and reserved words
    /// refuse as names. True means refused — the site keeps its
    /// hands off the name.
    fn refused_name(self, name: string, at: Loc?) -> bool {
        if self.p.keywords.contains(name) {
            self.refuse_keyword(name, at)
            return true
        }
        if reserved().contains(name) {
            self.refuse_reserved(name, at)
            return true
        }
        false
    }

    fn declare_fn(self, name: string, s: StmtId) {
        let at = self.stmt_loc(s)
        if self.refused_name(name, at) { return }
        let prior: StmtId? = self.fn_defs.get(name)
        if prior == null {
            mut m = self.fn_defs
            m.set(name, s)
            mut ns = self.fn_names
            ns.push(name)
        } else {
            self.speak(pointed(
                error_at("resolve.duplicate_fn", at, "`${name}` is defined more than once"),
                "redefined here")
                with { help: "rename one of them" })
        }
    }

    fn check_params(self, fparams: List<Param>, s: StmtId) {
        let at = self.stmt_loc(s)
        for pp in fparams {
            let _ = self.refused_name(pp.name, at)
        }
    }

    fn resolve_name(self, e: ExprId, name: string, param_names: List<string>) {
        if self.once(e) { return }
        // The SAME naming law every other site runs: a keyword can
        // never be a name, so "not defined" would send the reader
        // hunting for a definition that could not exist.
        if self.refused_name(name, self.loc_of(e)) { return }
        let found: Binding? = self.value_binding(name, param_names)
        if found != null {
            self.bind_use(e, found!)
            return
        }
        let at = self.loc_of(e)
        if name == "it" { return self.unbound_pronoun(at) }
        let later: StmtId? = self.later_def(name)
        if later != null {
            // A loc-less frame renders no window — absence stays quiet.
            let defined = [Frame { label: "defined here", loc: self.stmt_loc(later!) }]
            self.speak(pointed(
                error_at("resolve.use_before_def", at, "`${name}` is used before its definition"),
                "used here")
                with { secondary: defined, help: "move the definition above this use" })
            return
        }
        self.speak(self.suggested(
            pointed(error_at("resolve.unresolved", at, "`${name}` is not defined"),
                "not defined anywhere in this program"),
            e, name, self.def_names))
    }

    /// A name resolves ONCE — the first walk wins, diagnostics
    /// included. A bound scope re-walking a bound's subtree can
    /// neither re-scope nor re-diagnose it.
    fn once(self, e: ExprId) -> bool {
        if self.walked[e.index] { return true }
        mut w = self.walked
        w.set(e.index, true)
        false
    }

    /// The program-wide TYPE namespace, gathered like fns — an
    /// annotation or literal may name a type declared later.
    fn declare_types(self) {
        for s in self.p.stmts {
            let name: string? = self.p.store.type_decl_name(s)
            if name != null { self.declare_type(name!, s) }
        }
    }

    fn declare_type(self, name: string, s: StmtId) {
        let at = self.stmt_loc(s)
        if self.refused_name(name, at) { return }
        // A built-in name resolves to its SHAPE in annotations and
        // to the declaration everywhere else — one name, two
        // meanings, and no error. It is refused at the declaration.
        if builtin_type_name(name) {
            self.speak(pointed(
                error_at("resolve.builtin_type", at, "`${name}` is a built-in type"),
                "declared here")
                with { help: "choose another name — `int`, `string` and `bool` are the language's" })
            return
        }
        let prior: StmtId? = self.type_defs.get(name)
        if prior == null {
            mut m = self.type_defs
            m.set(name, s)
            mut ns = self.type_names
            ns.push(name)
        } else {
            self.speak(pointed(
                error_at("resolve.duplicate_type", at, "`${name}` is declared more than once"),
                "redeclared here")
                with { help: "rename one of them" })
        }
    }

    /// A literal's type name resolves in the type namespace alone.
    fn resolve_type_use(self, e: ExprId, name: string) {
        if self.once(e) { return }
        let found: StmtId? = self.type_defs.get(name)
        if found != null {
            self.bind_use(e, Binding.Def(found!))
            return
        }
        self.speak(self.suggested(
            pointed(error_at("resolve.unresolved", self.loc_of(e), "no `type ${name}` is declared"), "used here"),
            e, name, self.type_names))
    }

    /// A callee resolves in the fn namespace alone.
    fn resolve_call(self, e: ExprId, name: string, param_names: List<string>) {
        if self.once(e) { return }
        // A keyword can never NAME a fn, so "no `fn if` is defined"
        // would offer a remedy the naming law itself forbids.
        if self.refused_name(name, self.loc_of(e)) { return }
        let found: StmtId? = self.fn_defs.get(name)
        if found != null {
            self.bind_use(e, Binding.Def(found!))
            return
        }
        // no declared fn wears the name: the call may go through a
        // fn-typed LOCAL value (typing judges its shape). Declared
        // fns stay first — a pattern bind shadows READS, never the
        // call (the pinned arm law).
        let local: Binding? = self.local_binding(name, param_names)
        if local != null {
            self.bind_use(e, local!)
            return
        }
        self.speak(self.suggested(
            pointed(error_at("resolve.unresolved", self.loc_of(e), "no `fn ${name}` is defined"), "called here"),
            e, name, self.fn_names))
    }

    /// One use's resolved binding lands in the fact table.
    fn bind_use(self, e: ExprId, b: Binding) {
        mut bs = self.bindings
        bs.set(e.index, b)
    }

    /// What `name` names, INNERMOST SCOPE OUTWARD — the order IS
    /// the shadowing law: arm and block overlays, then the fn's
    /// params, then the program scope, then a TYPE used as a value
    /// (`Color` in `Color.red`, which typing gives the compile-only
    /// TypeName shape).
    fn value_binding(self, name: string, param_names: List<string>) -> Binding? {
        let local: Binding? = self.local_binding(name, param_names)
        if local != null { return local }
        let named_type: StmtId? = self.type_defs.get(name)
        if named_type != null { return Binding.Def(named_type!) }
        // a NAMED FN is a value too — global, so no capture chains
        let f: StmtId? = self.fn_defs.get(name)
        if f == null { return null }
        Binding.Def(f!)
    }

    /// The LOCAL half of the name chain, lambda-aware: the
    /// innermost hit wins — a lambda param or an overlay inside a
    /// frame is frame-local; anything below the innermost floor is
    /// the outer world, and every frame between records a CAPTURE
    /// (nesting chains Capture through Capture).
    fn local_binding(self, name: string, param_names: List<string>) -> Binding? {
        let ohit: int? = overlay_index(self.overlays, name)
        let fhit: int? = frame_param_hit(self.lframes, name)
        let ohome = if ohit == null { no_frame() } else { overlay_home(self.lframes, ohit!) }
        let fhome = fhit ?? no_frame()
        // the deeper home wins; a tie is the overlay's — a `let`
        // after the params shadows them
        if ohit != null && ohome >= fhome {
            return self.chained(ohome + 1, name, overlay_at(self.overlays, ohit!, name)!)
        }
        if fhit != null {
            let f = self.lframes[fhit!]
            return self.chained(fhit! + 1, name,
                Binding.LambdaParam(f.lam, index_of_name(f.params, name)!))
        }
        let idx: int? = index_of_name(param_names, name)
        if idx != null { return self.chained(0, name, Binding.Param(idx!)) }
        let outer: Binding? = self.visible.get(name)
        if outer == null { return null }
        self.chained(0, name, outer!)
    }

    /// Wrap a binding in Capture links for every frame from
    /// `from_k` inward — each lambda between the name's home and
    /// the use captures it (or finds it already captured).
    fn chained(self, from_k: int, name: string, b: Binding) -> Binding {
        mut wrapped = b
        mut k = from_k
        while k < self.lframes.length {
            let lam = self.lframes[k].lam
            wrapped = Binding.Capture(lam, self.captured(lam, name, wrapped))
            k = k + 1
        }
        wrapped
    }

    /// The capture's lane in the lambda's set — found, or minted at
    /// the tail. The set's order IS the box's slot order.
    fn captured(self, lam: ExprId, name: string, source: Binding) -> int {
        let held: Cap? = self.captures[lam.index]
        if held == null {
            mut cs = self.captures
            cs.set(lam.index, Cap { names: [name], sources: [source] })
            return 0
        }
        let cap = held!
        let at = cap.names.index_of(name)
        if at >= 0 { return at }
        mut ns = cap.names
        ns.push(name)
        mut ss = cap.sources
        ss.push(source)
        ns.length - 1
    }

    /// The chain's STATEMENT-shaped half — overlays, then the
    /// program scope. Params are not definitions, so assignment
    /// refuses them through `is_param` instead.
    fn binding_of(self, name: string) -> Binding? {
        let inner: Binding? = overlay_hit(self.overlays, name)
        if inner != null { return inner }
        let outer: Binding? = self.visible.get(name)
        outer
    }

    /// The DEFINITION `name` stands for, when it stands for one —
    /// what assignment needs, and what a pattern bind refuses to be.
    fn definition_of(self, name: string) -> StmtId? {
        let b: Binding? = self.binding_of(name)
        if b == null { return null }
        match b! {
            .Def(s) -> s,
            .Param(_) or .Pattern(_) or .LambdaParam(_, _) or .Capture(_, _) -> null,
        }
    }

    fn record_assign(self, s: StmtId, target: StmtId) {
        mut ts = self.assign_targets
        ts.set(s.index, target)
    }

    fn unbound_pronoun(self, at: Loc) {
        self.speak(pointed(
            error_at("resolve.unresolved", at, "`it` rides a METHOD call's arguments — nothing binds it here"),
            "the pronoun")
            with { help: "inside `xs.map(…)` and friends `it` is the element; elsewhere, name the value" })
    }

    fn refuse_reserved(self, name: string, at: Loc?) {
        self.speak(pointed(
            error_at("resolve.reserved", at, "`${name}` is reserved for a future Avra feature"),
            "cannot be a name")
            with { help: "pick another name — `${name}` becomes a keyword" })
    }

    fn refuse_keyword(self, name: string, at: Loc?) {
        self.speak(pointed(error_at("resolve.reserved", at, "`${name}` is a keyword"), "cannot be a name")
            with { help: "pick another name" })
    }

    fn speak(self, d: Diag) {
        mut ds = self.diagnostics
        ds.push(d)
    }

    /// The first PROGRAM-SCOPE definition of `name` anywhere — a
    /// scoped binder (a loop counter) is not one.
    fn later_def(self, name: string) -> StmtId? {
        self.all_defs.find(it.name == name && !self.scoped[it.stmt.index])?.stmt
    }

    /// A statement's binding, run through the naming law — the one
    /// rule for top level and blocks alike.
    fn bind_checked(self, s: StmtId) {
        let binds: string? = self.p.store.let_name(s)
        if binds == null { return }
        if !self.refused_name(binds!, self.stmt_loc(s)) { self.bind(binds!, Binding.Def(s)) }
    }

    /// Latest binding wins — Map.set IS shadowing. Inside a block,
    /// the binding lives in the innermost overlay and dies with it.
    fn bind(self, name: string, b: Binding) {
        if self.overlays.is_empty() {
            mut v = self.visible
            v.set(name, b)
        } else {
            mut top = self.overlays.last()!
            top.set(name, b)
        }
    }

    fn loc_of(self, e: ExprId) -> Loc? {
        loc_at(self.p.source.file, self.p.store.expr_span(e))
    }

    fn stmt_loc(self, s: StmtId) -> Loc? {
        loc_at(self.p.source.file, self.p.store.stmt_span(s))
    }

    /// A "did you mean" from the given candidates — later and
    /// shadowed names are honest candidates for a typo.
    fn suggested(self, d: Diag, e: ExprId, name: string, candidates: List<string>) -> Diag {
        let near: Closest? = closest(name, candidates)
        if near == null { return d }
        let n = near!
        let at: Loc? = self.loc_of(e)
        let edits = [Edit { loc: l, replacement: n.name } for l in some_list(at)]
        let s = Suggestion {
            confidence: if n.distance == 1 { Confidence.High } else { Confidence.Medium },
            description: "replace `${name}` with `${n.name}`",
            edits: edits,
        }
        d with { help: "did you mean `${n.name}`?", suggestions: [s] }
    }
}
