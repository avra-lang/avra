//! Name resolution — one file's names, a query value (`NameFacts`).
//! The driver owns scopes, statement order, and the naming law;
//! what a NODE means for names lives in its owning feature's
//! NodeSemantics, and a feature's own rules speak their
//! diagnostics through the context.
//! A symbol's identity is its definition site. Two namespaces, one
//! pass: `let` visibility is sequential and a later `let` shadows an
//! earlier one; `fn` names are program-wide, so recursion and mutual
//! recursion are free. Inside a body, params bind innermost.
use core.{StmtId, ExprId, Param, closest, Closest, some_list, filled, DeclId, flatten, Binding, found_at, NodeStore}
use diagnostics.{Diag, error_at, loc_at, pointed, refusal, Voices, no_voices}
use features.modules.{module_laws}
use features.{ResolveCx, StmtResolveCx, Cap, Namespace, NameFacts, FileView, remedy_for, written_seats, nothing, semantics_of, stmt_semantics_of, post_order}
use @std.errors.{Loc, Frame, Confidence, Edit, Suggestion}

/// Words the spec reserves for future levels, memory, and
/// concurrency: refusing them as names today means they become
/// keywords tomorrow without breaking any program. (Today's ACTUAL
/// keywords derive from the grammar — `p.keywords` — never a list
/// kept by hand.)
fn reserved() -> List<string> {
    ["systems", "bare", "hardware", "owned", "borrow", "move",
     "level", "unsafe", "extern", "async", "spawn", "await",
     "channel", "select"]
}

type Def = { name: string, stmt: StmtId }

/// One OPEN lambda during the walk: its params, and the overlay
/// depth at entry — an overlay at or above the floor is
/// lambda-local; below it lies the outer world, reached by capture.
type LFrame = { lam: ExprId, params: List<string>, floor: int }

type Resolver = {
    lang: Language,
    view: FileView,
    facts: NameFacts,
    all_defs: List<Def>,
    def_names: List<string>,
    visible: Map<string, Binding>,
    overlays: List<Map<string, Binding>>,
    lframes: List<LFrame>,
    floors: List<int>,
    // one entry per open impl or trait body: inside, `self` names
    // the receiver seat and the written params start at seat 1
    receivers: List<bool>,
    // the open fn body's `mut` seats, by written position
    muts: List<List<bool>>,
    walked: List<bool>,
    scoped: List<bool>,
}

export fn resolve(lang: Language, view: FileView, scope: Namespace) -> NameFacts {
    let defs = defs_of(view.store, view.stmts)
    mut r = Resolver {
        lang: lang, view: view, all_defs: defs,
        facts: NameFacts {
            bindings: filled<Binding?>(view.store.exprs.count(), null),
            captures: filled<Cap?>(view.store.exprs.count(), null),
            mut_reads: filled(view.store.exprs.count(), false),
            names: scope, voices: no_voices(),
        },
        def_names: [d.name for d in defs],
        visible: {}, overlays: [], lframes: [], floors: [], receivers: [], muts: [],
        walked: filled(view.store.exprs.count(), false),
        scoped: filled(view.store.stmts.count(), false),
    }
    r.name_laws()
    resolve_stmts(r, [], false, view.stmts)
    r.facts with { voices: Voices { list: flatten([scope.voices.list, module_laws(view.store, view.source.file, view.stmts), r.facts.voices.list]) } }
}

/// Statements in order, each through its own StmtSemantics — the
/// ONE statement loop, top level and blocks alike.
fn resolve_stmts(r: Resolver, param_names: List<string>, in_block: bool, stmts: List<StmtId>) {
    mut cx = StmtResolveCx {
        view: r.view,
        facts: r.facts,
        in_block: in_block,
        walk: (v: ExprId) -> resolve_walk(r, param_names, v),
        walk_under: (ps: List<Param>, body: ExprId) -> resolve_body(r, written_seats(r.lang.keywords, ps), body),
        bind_checked: (s: StmtId) -> r.bind_checked(s),
        check_params: (ps: List<Param>, s: StmtId) -> r.check_params(ps, s),
        scope_stmts: (body: List<StmtId>) -> scoped_stmts(r, param_names, body),
        impl_stmts: (body: List<StmtId>) -> impl_stmts(r, param_names, body),
        bound_scope: (s: StmtId, exprs: List<ExprId>, body: List<StmtId>) ->
            bound_scope(r, param_names, s, exprs, body),
    }
    for s in stmts { stmt_semantics_of(r.lang.dispatch, r.view.store.stmt(s)).resolve_stmt(cx, s) }
}

/// A statement list under its own overlay scope — a loop body.
fn scoped_stmts(mut r: Resolver, param_names: List<string>, stmts: List<StmtId>) {
    r.open_overlay()
    resolve_stmts(r, param_names, true, stmts)
    r.close_overlay()
}

/// A fresh scope where `s`'s own binding holds: the exprs walk and
/// the statements resolve inside it, and the binding dies at exit —
/// a loop variable's home. A scoped binder never counts as a
/// later definition: its name outside the scope is plainly unknown.
fn bound_scope(mut r: Resolver, param_names: List<string>, s: StmtId, exprs: List<ExprId>, stmts: List<StmtId>) {
    r.scoped.set(s.index, true)
    r.open_overlay()
    bound_body(r, param_names, s, exprs, stmts)
    r.close_overlay()
}

/// Inside the bound scope: the binder holds, the exprs walk, the
/// statements resolve.
fn bound_body(mut r: Resolver, param_names: List<string>, s: StmtId, exprs: List<ExprId>, stmts: List<StmtId>) {
    r.bind_checked(s)
    r.bind_index(s)
    for e in exprs { resolve_walk(r, param_names, e) }
    resolve_stmts(r, param_names, true, stmts)
}

/// A block's statements under a fresh overlay scope: binds are
/// visible onward and restored at exit.
fn block_scope(mut r: Resolver, param_names: List<string>, stmts: List<StmtId>, value: ExprId?) {
    r.open_overlay()
    block_body(r, param_names, stmts, value)
    r.close_overlay()
}

/// Inside a block's scope: the statements, then the value — absent
/// when the block leaves instead of answering.
fn block_body(r: Resolver, param_names: List<string>, stmts: List<StmtId>, value: ExprId?) {
    resolve_stmts(r, param_names, true, stmts)
    if value != null { resolve_walk(r, param_names, value!) }
}

/// One match arm's scope: its binds (in pattern order) hold for
/// the arm's value and die with it — the first scope in the
/// language opened by an EXPRESSION rather than a statement.
fn arm_scope(mut r: Resolver, param_names: List<string>, binds: List<string>, value: ExprId) {
    r.open_overlay()
    arm_body(r, param_names, binds, value)
    r.close_overlay()
}

fn arm_body(mut r: Resolver, param_names: List<string>, binds: List<string>, value: ExprId) {
    for j, b in binds {
        if !r.refused_name(b, r.loc_of(value)) { r.bind(b, Binding.Pattern(value, j)) }
    }
    resolve_walk(r, param_names, value)
}

// ── The lambda frames ───────────────────────────────────────────
// A lambda opens a FRAME: its params, and the overlay depth at
// entry. A name inside resolves innermost-out — frame params and
// frame-local overlays first, then the outer world, and every
// frame crossed on the way out records a CAPTURE. Nesting chains
// Capture through Capture; the stack lives on the Resolver, so
// blocks and arms inside a body need no threading at all.

/// The topmost overlay INDEX holding `name`, or null.
fn overlay_index(overlays: List<Map<string, Binding>>, name: string) -> int? {
    // LICENSED I19: a REVERSE scan — the nearest scope wins
    mut j = overlays.length - 1
    while j >= 0 {
        if overlays[j].get(name) != null { return j }
        j = j - 1
    }
    null
}

/// The binding an overlay index holds for `name`.
fn overlay_at(overlays: List<Map<string, Binding>>, at: int, name: string) -> Binding? {
    let held: Binding? = overlays[at].get(name)
    held
}

/// The home of a name that lives OUTSIDE every lambda frame.
fn no_frame() -> int {
    0 - 1
}

/// The innermost frame whose FLOOR admits the overlay — the frame
/// the overlay was opened inside.
fn overlay_home(lframes: List<LFrame>, ohit: int) -> int {
    // LICENSED I19: a REVERSE scan — innermost frame first
    mut k = lframes.length - 1
    while k >= 0 {
        if lframes[k].floor <= ohit { return k }
        k = k - 1
    }
    no_frame()
}

/// The innermost frame whose PARAMS hold `name`, or null.
fn frame_param_hit(lframes: List<LFrame>, name: string) -> int? {
    // LICENSED I19: a REVERSE scan — innermost frame first
    mut k = lframes.length - 1
    while k >= 0 {
        if found_at(lframes[k].params, name) != null { return k }
        k = k - 1
    }
    null
}

/// A lambda's body under its own frame: params bind, outer names
/// capture, and the frame dies with the walk.
fn lambda_scope(mut r: Resolver, param_names: List<string>, lam: ExprId, params: List<Param>, body: ExprId) {
    // a refused param name still BINDS (declare the wreckage) — the
    // body resolves quietly and the one refusal stands alone
    for pp in params {
        let _ = r.refused_name(pp.name, r.loc_of(lam))
    }
    mut fs = r.lframes
    // LICENSED I15: this IS the bracket fn
    fs.push(LFrame { lam: lam, params: [pp.name for pp in params], floor: r.overlays.length })
    resolve_walk(r, param_names, body)
    let _ = fs.pop()
}

/// The innermost overlay holding `name`, or null — the scan stops
/// at the first hit, which IS the shadowing rule: the nearest
/// scope wins and the outer ones are never consulted.
fn overlay_hit(overlays: List<Map<string, Binding>>, name: string) -> Binding? {
    mut k = overlays.length - 1
    while k >= 0 {
        let found: Binding? = overlays[k].get(name)
        if found != null { return found }
        k = k - 1
    }
    null
}

/// One subtree's resolution, under the given param names.
fn resolve_walk(r: Resolver, param_names: List<string>, root: ExprId) {
    mut cx = ResolveCx {
        view: r.view,
        use_name: (e: ExprId, name: string) -> r.resolve_name(e, name, param_names),
        use_call: (e: ExprId, name: string) -> r.resolve_call(e, name, param_names),
        use_type: (e: ExprId, name: string) -> r.resolve_type_use(e, name),
        use_receiver: (e: ExprId) -> r.resolve_receiver(e),
        arm_scope: (binds: List<string>, v: ExprId) -> arm_scope(r, param_names, binds, v),
        block_scope: (stmts: List<StmtId>, value: ExprId?) -> block_scope(r, param_names, stmts, value),
        lambda_scope: (lam: ExprId, ps: List<Param>, body: ExprId) -> lambda_scope(r, param_names, lam, ps, body),
    }
    for e in post_order(r.lang.dispatch, r.view.store, root) { semantics_of(r.lang.dispatch, r.view.store.expr(e)).resolve(cx, e) }
}

/// An impl's or a trait's fns: every fn inside is a method, and
/// `self` names its receiver for exactly their resolution.
fn impl_stmts(mut r: Resolver, param_names: List<string>, body: List<StmtId>) {
    r.receivers.push(true)
    resolve_stmts(r, param_names, false, body)
    let _ = r.receivers.pop()
}

/// A fn's body walks behind a FLOOR: the overlay depth at entry.
/// Bindings below it are the top level's run-time values, which no
/// body can see — a body sees declarations and its own bindings.
/// The seats' `mut` marks are in scope for the walk, so a read of a
/// `mut` seat is recorded as one.
fn resolve_body(r: Resolver, seats: List<Param>, body: ExprId) {
    mut fs = r.floors
    mut ms = r.muts
    // LICENSED I15: this IS the bracket
    fs.push(r.overlays.length)
    ms.push([pp.mutable for pp in seats])
    resolve_walk(r, [pp.name for pp in seats], body)
    let _ = ms.pop()
    let _ = fs.pop()
}

/// Every let definition in the program, in order.
fn defs_of(store: NodeStore, stmts: List<StmtId>) -> List<Def> {
    // LICENSED I13: a comprehension's filter and element cannot share a
    // binding — comprehension bindings are on the sugar backlog
    [Def { name: store.let_name(s)!, stmt: s } for s in stmts if store.let_name(s) != null]
}

impl Resolver {
    /// A scoped name, whichever namespace holds it — a fn's before
    /// a type's.
    fn scope_named(name: string) -> DeclId? {
        let as_fn: DeclId? = self.facts.names.fns.get(name)
        if as_fn != null { return as_fn }
        let as_type: DeclId? = self.facts.names.types.get(name)
        as_type
    }

    /// The naming law over this file's declarations: keywords and
    /// reserved words refuse as names, and a built-in type name
    /// refuses at its declaration — it resolves to its SHAPE in
    /// annotations and to the declaration everywhere else, one name
    /// with two meanings. The scope already bound the names.
    fn name_laws() {
        for s in self.view.stmts {
            let fname: string? = self.view.store.fn_parts(s)?.name
            if fname != null { let _ = self.refused_name(fname!, self.stmt_loc(s)) }
            let tname: string? = self.view.store.type_decl_name(s)
            if tname != null { self.type_name_law(tname!, s) }
        }
    }

    fn type_name_law(name: string, s: StmtId) {
        let at = self.stmt_loc(s)
        if self.refused_name(name, at) { return }
        if builtin_type_name(self.lang.rows.types, name) {
            self.speak(refusal("resolve.builtin_type", at, "`${name}` is a built-in type", "declared here", "choose another name — `int`, `string` and `bool` are the language's"))
        }
    }

    /// The naming law, in one place: keywords and reserved words
    /// refuse as names. True means refused — the site keeps its
    /// hands off the name.
    fn refused_name(name: string, at: Loc?) -> bool {
        if self.lang.keywords.contains(name) {
            self.refuse_keyword(name, at, null)
            return true
        }
        if reserved().contains(name) {
            self.refuse_reserved(name, at)
            return true
        }
        false
    }

    /// Parameters obey the naming law, and a keyword written as one
    /// gets the word's own remedy (`self` in a list — the receiver
    /// habit — says to drop it).
    fn check_params(fparams: List<Param>, s: StmtId) {
        let at = self.stmt_loc(s)
        for pp in fparams {
            if self.lang.keywords.contains(pp.name) {
                self.refuse_keyword(pp.name, at, remedy_for(self.lang.rows, pp.name))
            } else {
                let _ = self.refused_name(pp.name, at)
            }
        }
    }

    fn resolve_name(e: ExprId, name: string, param_names: List<string>) {
        if self.once(e) { return }
        // The SAME naming law every other site runs: a keyword can
        // never be a name, so "not defined" would send the reader
        // hunting for a definition that could not exist.
        if self.refused_name(name, self.loc_of(e)) { return }
        let found: Binding? = self.value_binding(name, param_names)
        if found != null {
            self.bind_use(e, found!)
            self.note_mut_seat(e, found!)
            return
        }
        let at = self.loc_of(e)
        if name == "it" { return self.unbound_pronoun(at) }
        if self.hidden_def(name) { return self.runtime_binding(name, at) }
        let later: StmtId? = self.later_def(name)
        if later != null {
            // A loc-less frame renders no window — absence stays quiet.
            let defined = [Frame { label: "defined here", loc: self.stmt_loc(later!) }]
            // LICENSED I28: the one voice with a SECOND frame — the definition's
            self.speak(pointed(
                error_at("resolve.use_before_def", at, "`${name}` is used before its definition"),
                "used here")
                with { secondary: defined, help: "move the definition above this use" })
            return
        }
        self.speak(self.suggested(
            refusal("resolve.unresolved", at, "`${name}` is not defined", "not defined anywhere in this program", null),
            e, name, self.def_names))
    }

    /// THE ONE SCOPE RITUAL: a fresh overlay opens, binds made inside
    /// are visible onward, and it closes with them.
    fn open_overlay() {
        let fresh: Map<string, Binding> = {}
        self.overlays.push(fresh)
    }

    fn close_overlay() {
        let _ = self.overlays.pop()
    }

    /// `self` — the receiver of the innermost enclosing method,
    /// captured through every open lambda like any binding; outside
    /// a method there is no receiver to name.
    fn resolve_receiver(e: ExprId) {
        if self.once(e) { return }
        if self.receivers.is_empty() { return self.no_receiver(self.loc_of(e)) }
        self.bind_use(e, self.chained(0, receiver_key(), Binding.Receiver))
    }

    /// The seat the written parameters start at: after the
    /// receiver's, inside a method.
    fn seat_base() -> int {
        if self.receivers.is_empty() { 0 } else { 1 }
    }

    /// A parameter read of a `mut` seat is marked as one — the
    /// place law asks the read, never the name.
    fn note_mut_seat(e: ExprId, b: Binding) {
        // LICENSED I22: one arm answers — a projection; every other binding is not a seat
        let seat: int? = match b {
            .Param(i) -> i,
            _ -> null,
        }
        if seat != null && self.seat_is_mut(seat!) { self.facts.mark_mut_read(e) }
    }

    fn seat_is_mut(i: int) -> bool {
        let open: List<bool>? = self.muts.last()
        if open == null { return false }
        let at = i - self.seat_base()
        at >= 0 && at < open!.length && open![at]
    }

    /// A name resolves ONCE — the first walk wins, diagnostics
    /// included. A bound scope re-walking a bound's subtree can
    /// neither re-scope nor re-diagnose it.
    fn once(e: ExprId) -> bool {
        if self.walked[e.index] { return true }
        self.walked.set(e.index, true)
        false
    }

    /// A literal's type name resolves in the type namespace alone.
    fn resolve_type_use(e: ExprId, name: string) {
        if self.once(e) { return }
        let found: DeclId? = self.facts.names.types.get(name)
        if found != null {
            self.bind_use(e, Binding.Decl(found!))
            return
        }
        self.speak(self.suggested(
            refusal("resolve.unresolved", self.loc_of(e), "no `type ${name}` is declared", "used here", null),
            e, name, self.facts.names.type_names))
    }

    /// A callee resolves in the fn namespace alone.
    fn resolve_call(e: ExprId, name: string, param_names: List<string>) {
        if self.once(e) { return }
        // A keyword can never NAME a fn, so "no `fn if` is defined"
        // would offer a remedy the naming law itself forbids.
        if self.refused_name(name, self.loc_of(e)) { return }
        let found: DeclId? = self.facts.names.fns.get(name)
        if found != null {
            self.bind_use(e, Binding.Decl(found!))
            return
        }
        // no declared fn wears the name: the call may go through a
        // fn-typed LOCAL value (typing judges its shape). Declared
        // fns stay first — a pattern bind shadows READS, never the
        // call (the pinned arm law).
        let local: Binding? = self.local_binding(name, param_names)
        if local != null {
            self.bind_use(e, local!)
            return
        }
        if self.hidden_def(name) { return self.runtime_binding(name, self.loc_of(e)) }
        self.speak(self.suggested(
            refusal("resolve.unresolved", self.loc_of(e), "no `fn ${name}` is defined", "called here", null),
            e, name, self.facts.names.fn_names))
    }

    /// One use's resolved binding lands in the fact table.
    fn bind_use(e: ExprId, b: Binding) {
        mut bs = self.facts.bindings
        bs.set(e.index, b)
    }

    /// What `name` names, INNERMOST SCOPE OUTWARD — the order IS
    /// the shadowing law: arm and block overlays, then the fn's
    /// params, then the program scope, then a TYPE used as a value
    /// (`Color` in `Color.red`, which typing gives the compile-only
    /// TypeName shape).
    fn value_binding(name: string, param_names: List<string>) -> Binding? {
        let local: Binding? = self.local_binding(name, param_names)
        if local != null { return local }
        // a type's name, then a NAMED FN as a value — both global,
        // so no capture chains
        let named_type: DeclId? = self.facts.names.types.get(name)
        if named_type != null { return Binding.Decl(named_type!) }
        let f: DeclId? = self.facts.names.fns.get(name)
        if f == null { return null }
        Binding.Decl(f!)
    }

    /// The LOCAL half of the name chain, lambda-aware: the
    /// innermost hit wins — a lambda param or an overlay inside a
    /// frame is frame-local; anything below the innermost floor is
    /// the outer world, and every frame between records a CAPTURE
    /// (nesting chains Capture through Capture).
    fn local_binding(name: string, param_names: List<string>) -> Binding? {
        let ohit: int? = overlay_index(self.overlays, name)
        let fhit: int? = frame_param_hit(self.lframes, name)
        let ohome = if ohit == null { no_frame() } else { overlay_home(self.lframes, ohit!) }
        let fhome = fhit ?? no_frame()
        // the deeper home wins; a tie is the overlay's — a `let`
        // after the params shadows them
        if ohit != null && ohome >= fhome {
            return self.chained(ohome + 1, name, overlay_at(self.overlays, ohit!, name)!)
        }
        if fhit != null {
            let f = self.lframes[fhit!]
            return self.chained(fhit! + 1, name,
                Binding.LambdaParam(f.lam, found_at(f.params, name)!))
        }
        let idx: int? = found_at(param_names, name)
        if idx != null { return self.chained(0, name, Binding.Param(idx! + self.seat_base())) }
        let outer: Binding? = self.outer_binding(name)
        if outer == null { return null }
        // A CONST IS NEVER CAPTURED: a lambda's env holds run-time
        // values, and a const has none to hold — its use emits the
        // value the compiler settled, inside a lambda as anywhere.
        if self.settled_binding(outer!) { return outer }
        self.chained(0, name, outer!)
    }

    /// The top level's binding for a name — unless a fn body is
    /// asking: its floor hides the run-time values around it.
    /// The world OUTSIDE the innermost body: a fn sees no run-time
    /// binding of the top level — but a CONST is not one. The
    /// compiler settled it, so it crosses the floor like a
    /// declaration does.
    fn outer_binding(name: string) -> Binding? {
        let held: Binding? = self.visible.get(name)
        if self.floors.is_empty() { return held }
        if held == null { return null }
        if self.settled_binding(held!) { return held }
        null
    }

    /// Whether a binding is a CONST's — asked of the BINDING IN
    /// HAND, never of the name: a `let` may shadow a const, and then
    /// the name's first definition and the binding in hand are
    /// different statements. Every other binding kind is a run-time
    /// value — a parameter, a pattern's bind, a capture — and any
    /// kind added later will be one too.
    fn settled_binding(b: Binding) -> bool {
        match b {
            .Def(s) -> settled_stmt(self.view.store, s),
            _ -> false,
        }
    }

    /// A name a body cannot see: the top level's RUN-TIME binding —
    /// declared before the body or after it, all the same. A const
    /// is not one; the compiler settled it, so it crosses.
    fn hidden_def(name: string) -> bool {
        if self.floors.is_empty() { return false }
        let store = self.view.store
        self.all_defs.any(it.name == name && !settled_stmt(store, it.stmt))
    }

    /// Wrap a binding in Capture links for every frame from
    /// `from_k` inward — each lambda between the name's home and
    /// the use captures it (or finds it already captured).
    fn chained(from_k: int, name: string, b: Binding) -> Binding {
        mut wrapped = b
        mut k = from_k
        while k < self.lframes.length {
            let lam = self.lframes[k].lam
            wrapped = Binding.Capture(lam, self.captured(lam, name, wrapped))
            k = k + 1
        }
        wrapped
    }

    /// The capture's lane in the lambda's set — found, or minted at
    /// the tail. The set's order IS the box's slot order.
    fn captured(lam: ExprId, name: string, source: Binding) -> int {
        let held: Cap? = self.facts.captures[lam.index]
        if held == null {
            mut cs = self.facts.captures
            cs.set(lam.index, Cap { names: [name], sources: [source] })
            return 0
        }
        let cap = held!
        let at = cap.names.index_of(name)
        if at >= 0 { return at }
        mut cs = self.facts.captures
        cs.set(lam.index, cap with { names: cap.names.concat([name]), sources: cap.sources.concat([source]) })
        cap.names.length
    }

    /// The chain's STATEMENT-shaped half — overlays, then the
    /// program scope. Params are not definitions, so assignment
    /// refuses them through `is_param` instead.
    fn binding_of(name: string) -> Binding? {
        let inner: Binding? = overlay_hit(self.overlays, name)
        if inner != null { return inner }
        let outer: Binding? = self.outer_binding(name)
        outer
    }

    fn unbound_pronoun(at: Loc?) {
        self.speak(refusal("resolve.unresolved", at, "`it` rides a METHOD call's arguments — nothing binds it here", "the pronoun", "inside `xs.map(…)` and friends `it` is the element; elsewhere, name the value"))
    }

    fn runtime_binding(name: string, at: Loc?) {
        self.speak(refusal("resolve.runtime_binding", at, "`${name}` is a run-time binding of the top level — a fn body sees declarations, not the values around it", "read here", "pass `${name}` in as a parameter, or make it a fn"))
    }

    fn refuse_reserved(name: string, at: Loc?) {
        self.speak(refusal("resolve.reserved", at, "`${name}` is reserved for a future Avra feature", "cannot be a name", "pick another name — `${name}` becomes a keyword"))
    }

    fn refuse_keyword(name: string, at: Loc?, remedy: string?) {
        self.speak(refusal("resolve.reserved", at, "`${name}` is a keyword", "cannot be a name", remedy ?? "pick another name"))
    }

    fn no_receiver(at: Loc?) {
        self.speak(refusal("resolve.receiver", at, "`self` names a method's receiver — this is not a method", "no receiver here", "move this into `impl <Type> { … }`"))
    }

    fn speak(d: Diag) { self.facts.voices.speak(d) }

    /// The first PROGRAM-SCOPE definition of `name` anywhere — a
    /// scoped binder (a loop counter) is not one.
    fn later_def(name: string) -> StmtId? {
        self.all_defs.find(it.name == name && !self.scoped[it.stmt.index])?.stmt
    }

    /// A statement's binding, run through the naming law — the one
    /// rule for top level and blocks alike.
    /// Is the name a pairing loop's index — the counter no
    /// assignment may touch.
    /// The index a pairing loop names, bound beside its element
    /// under the same naming law.
    fn bind_index(s: StmtId) {
        let ix: string? = self.view.store.loop_index(s)
        if ix == null { return }
        let name = ix!
        if self.refused_name(name, self.stmt_loc(s)) { return }
        if name == (self.view.store.let_name(s) ?? "") { return self.paired_alike(s, name) }
        self.bind(name, Binding.Index(s))
    }

    /// A pairing loop names its index and its element apart — one
    /// name for both would shadow one of them silently.
    fn paired_alike(s: StmtId, name: string) {
        self.speak(refusal("resolve.paired", self.stmt_loc(s), "`${name}` names both the index and the element", "bound here", "give the index its own name — `for i, ${name} in …`"))
    }

    fn bind_checked(s: StmtId) {
        let binds: string? = self.view.store.let_name(s)
        if binds == null { return }
        if !self.refused_name(binds!, self.stmt_loc(s)) { self.bind(binds!, Binding.Def(s)) }
    }

    /// Latest binding wins — Map.set IS shadowing. Inside a block,
    /// the binding lives in the innermost overlay and dies with it.
    fn bind(name: string, b: Binding) {
        if self.overlays.is_empty() {
            self.visible.set(name, b)
        } else {
            mut ovs = self.overlays
            let at = ovs.length - 1
            mut top = ovs[at]
            top.set(name, b)
            ovs.set(at, top)
        }
    }

    fn loc_of(e: ExprId) -> Loc? {
        loc_at(self.view.source.file, self.view.store.expr_span(e))
    }

    fn stmt_loc(s: StmtId) -> Loc? {
        loc_at(self.view.source.file, self.view.store.stmt_span(s))
    }

    /// A "did you mean" from the given candidates — later and
    /// shadowed names are honest candidates for a typo.
    fn suggested(d: Diag, e: ExprId, name: string, candidates: List<string>) -> Diag {
        let near: Closest? = closest(name, candidates)
        if near == null { return d }
        let n = near!
        let at: Loc? = self.loc_of(e)
        let edits = [Edit { loc: l, replacement: n.name } for l in some_list(at)]
        let s = Suggestion {
            confidence: if n.distance == 1 { Confidence.High } else { Confidence.Medium },
            description: "replace `${name}` with `${n.name}`",
            edits: edits,
        }
        d with { help: "did you mean `${n.name}`?", suggestions: [s] }
    }
}

/// Whether a program-scope definition is a const's — the one
/// question both the crossing law and the hiding law ask.
/// The capture table's key for the receiver — a word no NAME can
/// spell, `self` being a keyword, so it collides with nothing.
fn receiver_key() -> string {
    "self"
}

fn settled_stmt(store: NodeStore, s: StmtId) -> bool {
    store.const_value(s) != null
}
