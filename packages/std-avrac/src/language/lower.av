//! Lowers a program to IR. The driver owns refusal, statement order,
//! registers, and the slot tables; HOW a statement or node lowers —
//! brackets included — lives in its owning feature. Lowering emits
//! PURE semantics — the memory pass owns every Retain and Release.
//! A definition's register is its slot (a mut binding's is a CELL,
//! loaded at each read), a param IS its register (params mint
//! first), so names cost nothing.
//! Each fn lowers to its OWN body with its own registers; `main` is
//! the statement list.
use core.{StmtId, ExprId, TypeId, Type, Reg, Ins, Level, TypeRegistry, joined, flatten, stem_of, NodeStore, DeclId, FileId, Arrow, RtSig, rt_kind_of, extern_row}
use diagnostics.{Diag, defect_at, loc_at, refusal, Voices, no_voices}
use features.{LowerCx, FnSig, fn_sig_of, Sub, new_emitter, new_body_regs, viewed, Decl, Decls, Jobs, new_jobs, Wanted, Lift, Wrap}

/// One lowered body: instructions in order and each register's type
/// (dense by Reg). For a fn, the first `params.length` registers ARE
/// the params, and `gives` is the register RetVal answers with.
export type Body = {
    name: string,
    params: List<TypeId>,
    ret: TypeId,
    gives: Reg?,
    ins: List<Ins>,
    reg_types: List<TypeId>,
}

/// The lowering facts: every fn body, the entry body (`main` — its
/// specialness is explicit: no params, the answer's puts, exit 0), the
/// registry that names the types, and any defects.
export type Lowered = {
    fns: List<Body>,
    entry: Body,
    types: TypeRegistry,
    diagnostics: List<Diag>,
    // the host fns the program declares `extern` — rows the backend
    // declares and the evaluator refuses
    externs: List<RtSig>,
}

/// The program's extern fns by symbol — what every emitter refuses
/// an unknown callee against. A whole-table walk: gathered once per
/// lowering, never per body.
export fn extern_names(decls: Decls) -> List<string> {
    [decls.symbol(d.id) for d in decls.decls if decls.is_extern(d.id)]
}

/// The program's extern fns as registry rows.
fn extern_rows(decls: Decls) -> List<RtSig> {
    [extern_row_of(decls, d) for d in decls.decls if decls.is_extern(d.id)]
}

fn extern_row_of(decls: Decls, d: Decl) -> RtSig {
    let sig: FnSig? = fn_sig_of(decls.sig(d.id))
    let params: List<TypeId> = sig?.params ?? []
    extern_row(decls.symbol(d.id), rt_kind_of(decls.types, sig?.ret ?? decls.types.intern(Type.Void)), [rt_kind_of(decls.types, p) for p in params])
}

/// One lowering per BODY — `fn_ret` is that body's declared answer
/// (null for main) and `sub` its instantiation (null when the body
/// is not a specialization), which is why they are fields, not
/// stacks.
fn new_lower_cx(a: Analysis, fn_ret: TypeId?, sub: Sub?, jobs: Jobs) -> LowerCx {
    LowerCx {
        view: a.view, names: a.names, facts: a.facts, dispatch: a.lang.dispatch,
        out: new_emitter(jobs.externs),
        body: new_body_regs(a.view.store.exprs.count(), a.view.store.stmts.count()),
        sub: sub, fn_ret: fn_ret, jobs: jobs, deferred: [], depth: 0,
    }
}

/// A lone file's program, lowered without a memo — the tests' seam.
export fn lower(a: Analysis) -> Lowered {
    let externs = extern_names(a.view.decls)
    union(a.view.decls, [a], 0, false, false, (w: Wanted) -> lower_unit(a, externs, w))
}

/// One unit LOWERED: its body with the lambdas it lifted and the
/// wrappers it minted (they never escape it), the bodies of OTHER
/// declarations it wants — the program asks for those, and asking
/// twice reuses — and every voice lowering earned.
export type Unit = { bodies: List<Body>, wants: List<Wanted>, voices: Voices }

/// A unit lowered in its file's analysis: the body, then its own
/// lifts and wrappers drained locally — a lambda's body may mint
/// more of each. `externs` is the program's extern symbols, gathered
/// once per program by the workspace: every body's emitter refuses
/// a callee it does not know against it.
export fn lower_unit(a: Analysis, externs: List<string>, w: Wanted) -> Unit {
    mut jobs = new_jobs(externs)
    if w.decl != null && !a.view.decls.has_body(w.decl!) {
        mut out = new_emitter(externs)
        out.defect("a unit without a body was asked for — `${w.name}`")
        return Unit { bodies: [], wants: [], voices: out.voices }
    }
    let first = if w.decl == null { lower_main(a, w.name, jobs) } else { lower_fn(a, a.view.decls.decl(w.decl!), w.name, w.sub, jobs) }
    mut bodies: List<Body> = [first.body]
    mut spoken: List<Diag> = first.voices.list
    while jobs.waiting() {
        let lj: Lift? = jobs.take_lift()
        if lj == null {
            let wj: Wrap? = jobs.take_wrap()
            if wj != null { bodies.push(wrapped_body(a, wj!)) }
        } else {
            let lf = lower_lambda(a, lj!, jobs)
            bodies.push(lf.body)
            spoken = spoken.concat(lf.voices.list)
        }
    }
    Unit { bodies: bodies, wants: jobs.pending, voices: Voices { list: spoken } }
}

/// The whole program as IR: the entry's main and every body it
/// reaches, transitively — each unit through `unit_of`, which the
/// workspace memoizes. A program only CHECKED has no entry: every
/// declared body lowers instead, so each speaks its refusals; a
/// test run asks for `every` declared body under its entry, whose
/// laws (a module file runs nothing) still hold. A unit is asked
/// once per symbol; the guard is the polymorphic-recursion refusal.
export fn union(decls: Decls, files: List<Analysis>, entry: int?, every: bool, programs: bool, unit_of: fn(Wanted) -> Unit) -> Lowered {
    mut fns: List<Body> = []
    mut spoken: List<Diag> = []
    let at: int = entry ?? 0
    let bodies: List<Wanted> = if entry == null || every { flatten([declared(a) for a in files]) } else { [] }
    // EVERY FILE A PROGRAM: each file's run-time statements lower as
    // a body under the program's own symbol, for a runner's entry to
    // call in turn — the corpus in one binary
    mut wants: List<Wanted> = if programs { bodies.concat([program_main(a) for a in files]) } else { bodies }
    for i, a in files {
        if entry != null && i != at { spoken = spoken.concat(entry_only(a, files[at])) }
    }
    let main_unit: Unit? = if entry == null { null } else { unit_of(Wanted { file: files[at].view.file, decl: null, name: "main", sub: null }) }
    mut entry_body: Body = empty_main(decls.types).body
    if main_unit != null {
        let mu = main_unit!
        entry_body = mu.bodies.first() ?? entry_body
        fns = fns.concat(mu.bodies.slice(1, mu.bodies.length))
        spoken = spoken.concat(mu.voices.list)
        wants = wants.concat(mu.wants)
    }
    mut seen: Map<string, bool> = {}
    mut minted = 0
    while !wants.is_empty() && minted < unit_ceiling() {
        let w = wants.pop()
        if seen.get(w.name) == null {
            seen.set(w.name, true)
            minted = minted + 1
            let u = unit_of(w)
            fns = fns.concat(u.bodies)
            spoken = spoken.concat(u.voices.list)
            wants = wants.concat(u.wants)
        }
    }
    if !wants.is_empty() {
        spoken.push(defect_at(null, "specializations exploded past ${unit_ceiling()} — polymorphic recursion is not supported"))
    }
    Lowered { fns: fns, entry: entry_body, types: decls.types, diagnostics: spoken, externs: extern_rows(decls) }
}

/// The ceiling on DISTINCT bodies one program mints. A source
/// bounds its own count; only polymorphic recursion — each turn a
/// wider substitution, none ever repeated — climbs forever.
fn unit_ceiling() -> int { 100000 }

/// A file's declared bodies to ask for, plain — a generic one waits
/// for an instantiation to want it.
/// A file's main as a wanted body, named for the program it is.
fn program_main(a: Analysis) -> Wanted {
    Wanted { file: a.view.file, decl: null, name: program_symbol(a.view.decls.file(a.view.file).path), sub: null }
}

/// The symbol a program's body wears in a corpus binary: its file's
/// stem, so two programs never collide and a wreck names its file.
export fn program_symbol(path: string) -> string {
    "program\$${stem_of(path)}"
}

fn declared(a: Analysis) -> List<Wanted> {
    [Wanted { file: a.view.file, decl: d, name: a.view.decls.symbol(d), sub: null } for d in a.view.decls.decls_of_file(a.view.file) if lowers_plain(a, d)]
}

/// A body lowered without an instantiation: one that has no type
/// parameters of its own or its type's.
fn lowers_plain(a: Analysis, d: DeclId) -> bool {
    let x = a.view.decls.decl(d)
    x.root != null && a.view.decls.tparams(d).is_empty() && a.view.decls.tparams(x.parent ?? d).is_empty()
}

/// A module file holds declarations; run-time statements belong to
/// the entry alone.
fn entry_only(a: Analysis, entry: Analysis) -> List<Diag> {
    [runs_outside_entry(a, s, entry) for s in a.view.stmts if runs_at_top(a.view.store, s)]
}

fn runs_at_top(store: NodeStore, s: StmtId) -> bool {
    !store.is_declaration(s)
}

type LoweredBody = { body: Body, voices: Voices }

/// One body — a fn's, a method's, a default's: params pre-minted as
/// registers 0..N-1, the body inside one scope, the answer after
/// the scope settles.
fn lower_fn(a: Analysis, x: Decl, fname: string, sub: Sub?, jobs: Jobs) -> LoweredBody {
    let root: ExprId = x.root!
    let sig: FnSig? = fn_sig_of(a.view.decls.sig(x.id))
    let raw: List<TypeId> = sig?.params ?? []
    let rt: TypeId = viewed(a.view.decls.types, sub, sig?.ret ?? a.view.decls.types.intern(Type.Error))
    let ptypes = [viewed(a.view.decls.types, sub, pt) for pt in raw]
    mut lo = new_lower_cx(a, rt, sub, jobs)
    // the params ARE registers 0..N-1, minted in order
    for pt in ptypes { let _ = lo.out.mint_ty(pt) }
    lo.out.seeded()
    lo.scope_enter()
    let r = lo.reg_of(root)
    lo.scope_exit(r)
    lo.out.give(Ins.RetVal(r))
    LoweredBody {
        body: Body { name: fname, params: ptypes, ret: rt, gives: r, ins: lo.out.ins, reg_types: lo.out.reg_types },
        voices: lo.out.voices,
    }
}

/// One LIFTED lambda: register 0 is the env box (typed as the
/// lambda's own fn type — a pointer, managed, released by the
/// callee per the ABI), registers 1..N its params; the body reads
/// captures through slot 1+j of the env.
fn lower_lambda(a: Analysis, lj: Lift, jobs: Jobs) -> LoweredBody {
    let lam_ty = viewed(a.view.decls.types, lj.sub, a.facts.type_at(lj.lam))
    let held: Arrow? = a.view.decls.types.arrow_parts(lam_ty)
    let seats: List<TypeId> = held?.seats ?? []
    let rt: TypeId = held?.answer ?? a.view.decls.types.intern(Type.Error)
    let body: ExprId? = a.view.store.lambda_parts(lj.lam)?.body
    mut lo = new_lower_cx(a, rt, lj.sub, jobs)
    // register 0 is the env box, 1..N the seats
    let _ = lo.out.mint_ty(lam_ty)
    for pt in seats { let _ = lo.out.mint_ty(pt) }
    lo.out.seeded()
    lo.scope_enter()
    if body == null {
        lo.out.defect("a lift without a lambda survived typing")
    }
    let r = lo.reg_of(body ?? lj.lam)
    lo.scope_exit(r)
    lo.out.give(Ins.RetVal(r))
    LoweredBody {
        body: Body { name: lj.name, params: [lam_ty].concat(seats), ret: rt, gives: r, ins: lo.out.ins, reg_types: lo.out.reg_types },
        voices: lo.out.voices,
    }
}

/// The wrapper, built directly in IR — no AST exists for it: env
/// ignored at seat 0, the target called with the forwarded seats.
fn wrapped_body(a: Analysis, w: Wrap) -> Body {
    let fnty = a.view.decls.types.intern(Type.Fn(w.seats, w.ret))
    mut tys: List<TypeId> = [fnty]
    mut args: List<Reg> = []
    for j, st in w.seats {
        tys.push(st)
        args.push(Reg { index: j + 1 })
    }
    let dst = Reg { index: tys.length }
    tys.push(w.ret)
    let ins: List<Ins> = [
        Ins.ScopeEnter(Level.Application),
        Ins.Call(dst, w.target, args),
        Ins.ScopeExit(dst),
        Ins.RetVal(dst),
    ]
    Body { name: w.name, params: [fnty].concat(w.seats), ret: w.ret, gives: dst, ins: ins, reg_types: tys }
}

/// A file's run-time statements as a body under `name` — `main` for
/// the entry, a program's own symbol when every file is a program.
fn lower_main(a: Analysis, name: string, jobs: Jobs) -> LoweredBody {
    mut lo = new_lower_cx(a, null, null, jobs)
    lo.scope_enter()
    lo.lower_stmts(a.view.stmts)
    let shown: ExprId? = program_answer(a)
    let refusal: Diag? = if shown == null { null } else { lo.print_lowering(lo.reg_of(shown!)) }
    if refusal != null { lo.out.voices.speak(refusal!) }
    lo.scope_exit(null)
    lo.out.give(Ins.Ret(0))
    LoweredBody {
        body: Body {
            name: name, params: [], ret: a.view.decls.types.intern(Type.Int),
            gives: null, ins: lo.out.ins, reg_types: lo.out.reg_types,
        },
        voices: lo.out.voices,
    }
}

/// What a program shows: the expression of its FINAL statement that
/// RUNS, when that statement is an expression — declarations after
/// it do not run; a binding, a loop or an assignment last shows
/// nothing.
fn program_answer(a: Analysis) -> ExprId? {
    let last: StmtId? = [s for s in a.view.stmts if runs_at_top(a.view.store, s)].last()
    if last == null { return null }
    a.view.store.shown_value(last!)
}

/// The entry of a program that is only checked: nothing runs.
fn empty_main(types: TypeRegistry) -> LoweredBody {
    let ins: List<Ins> = [Ins.ScopeEnter(Level.Application), Ins.ScopeExit(null), Ins.Ret(0)]
    LoweredBody {
        body: Body { name: "main", params: [], ret: types.intern(Type.Int), gives: null, ins: ins, reg_types: [] },
        voices: no_voices(),
    }
}

/// The specialization's name: uncollidable (`$` is unwritable) and
/// stable per run — interned ids in ordinal order.
fn mangle(name: string, sub: Sub) -> string {
    "${name}$${joined(["${a.index}" for a in sub.args], "_")}"
}

// ── voices ──

fn runs_outside_entry(a: Analysis, s: StmtId, entry: Analysis) -> Diag {
    refusal("lower.entry_only", loc_at(a.view.source.file, a.view.store.stmt_span(s)), "a module file holds declarations — only the entry `${entry.view.source.file ?? "the entry"}` runs statements", "runs here", "move it into the entry, or wrap it in a fn the entry calls")
}
