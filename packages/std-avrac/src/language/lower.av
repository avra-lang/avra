//! Lowers a program to IR. The driver owns refusal, statement order,
//! registers, and the slot tables; HOW a statement or node lowers —
//! brackets included — lives in its owning feature. Lowering emits
//! PURE semantics — the memory pass owns every Retain and Release.
//! A definition's register is its slot (a mut binding's is a CELL,
//! loaded at each read), a param IS its register (params mint
//! first), so names cost nothing.
//! Each fn lowers to its OWN body with its own registers; `main` is
//! the statement list.
use core.{StmtId, ExprId, TypeId, Type, Reg, Ins, Level, TypeRegistry, filled, concat}
use diagnostics.{Diag, error_at}
use features.{LowerCx, StmtLowerCx, FnSig, StructSig}

/// One lowered body: instructions in order and each register's type
/// (dense by Reg). For a fn, the first `params.length` registers ARE
/// the params, and `gives` is the register RetVal answers with.
export type Body = {
    name: string,
    params: List<TypeId>,
    ret: TypeId,
    gives: Reg?,
    ins: List<Ins>,
    reg_types: List<TypeId>,
}

/// The lowering facts: every fn body, the entry body (`main` — its
/// specialness is explicit: no params, the answer's puts, exit 0), the
/// registry that names the types, and any defects.
export type Lowered = {
    fns: List<Body>,
    entry: Body,
    types: TypeRegistry,
    diagnostics: List<Diag>,
}

type Lower = {
    a: Analysis,
    ins: List<Ins>,
    reg_types: List<TypeId>,
    regs: List<Reg?>,
    slots: List<Reg?>,
    boxed: List<bool>,
    failures: List<string>,
}

fn new_lower(a: Analysis) -> Lower {
    Lower {
        a: a, ins: [], reg_types: [],
        regs: filled<Reg?>(a.store.exprs.count(), null),
        slots: filled<Reg?>(a.store.stmts.count(), null),
        boxed: filled(a.store.stmts.count(), false),
        failures: [],
    }
}

/// The whole program as IR: every fn body, then main — one
/// Application scope each, main printing its last statement.
export fn lower(a: Analysis) -> Lowered {
    mut fns: List<Body> = []
    mut failures: List<string> = []
    for s in a.stmts {
        let parts: FnParts? = a.store.fn_parts(s)
        if parts != null {
            let lf = lower_fn(a, s, parts!.name, parts!.body)
            fns.push(lf.body)
            for m in lf.failures { failures.push(m) }
        }
    }
    let lm = lower_main(a)
    for m in lm.failures { failures.push(m) }
    Lowered {
        fns: fns, entry: lm.body, types: a.typing.types,
        diagnostics: concat(lm.refusals, [error_at("language.defect", null, m) for m in failures]),
    }
}

type LoweredBody = { body: Body, failures: List<string>, refusals: List<Diag> }

/// One fn: params pre-minted as registers 0..N-1, the body inside
/// one scope, the answer after the scope settles.
fn lower_fn(a: Analysis, s: StmtId, fname: string, root: ExprId) -> LoweredBody {
    let sig: FnSig? = a.typing.sigs[s.index]
    let ptypes: List<TypeId> = sig?.params ?? []
    let rt: TypeId = sig?.ret ?? a.typing.types.intern(Type.Error)
    let lo = new_lower(a)
    mut tys = lo.reg_types
    for pt in ptypes { tys.push(pt) }
    lo.give(Ins.ScopeEnter(Level.Application))
    let r = lower_subtree(lo, root)
    lo.give(Ins.ScopeExit(r))
    lo.give(Ins.RetVal(r))
    LoweredBody {
        body: Body { name: fname, params: ptypes, ret: rt, gives: r, ins: lo.ins, reg_types: lo.reg_types },
        failures: lo.failures,
        refusals: [],
    }
}

fn lower_main(a: Analysis) -> LoweredBody {
    let lo = new_lower(a)
    lo.give(Ins.ScopeEnter(Level.Application))
    let last: Reg? = lower_stmts(lo, a.stmts)
    if last != null { print_lowering(lo, last!) }
    lo.give(Ins.ScopeExit(null))
    lo.give(Ins.Ret(0))
    LoweredBody {
        body: Body {
            name: "main", params: [], ret: a.typing.types.intern(Type.Int),
            gives: null, ins: lo.ins, reg_types: lo.reg_types,
        },
        failures: lo.failures,
        refusals: [],
    }
}

/// One subtree's register, lowered at first request and memoized.
/// The recursion IS the walk: an impl asking for a child's register
/// lands back here — so a region's branches lower INSIDE it.
fn lower_subtree(lo: Lower, e: ExprId) -> Reg {
    let seen: Reg? = lo.regs[e.index]
    if seen != null { return seen! }
    let cx = LowerCx {
        store: lo.a.store,
        result: (k: ExprId) -> lo.mint(k),
        reg_of: (k: ExprId) -> lower_subtree(lo, k),
        def_reg: (k: ExprId) -> lo.def_reg(k),
        shape_at: (k: ExprId) -> lo.a.typing.types.shape_of(lo.a.type_at(k)),
        mint: (k: ExprId) -> lo.mint(k),
        mint_int: () -> lo.mint_ty(lo.a.typing.types.intern(Type.Int)),
        field_slot: (k: ExprId, fname: string) -> lo.field_slot(k, fname),
        emit: (i: Ins) -> lo.give(i),
        lower_block: (stmts: List<StmtId>, value: ExprId) -> block_reg(lo, stmts, value),
        fail: (msg: string) -> lo.record(msg),
    }
    let r = semantics_of(lo.a.dispatch, lo.a.store.expr(e)).lower(cx, e)
    mut rs = lo.regs
    rs.set(e.index, r)
    r
}

/// Statements in order, each through its own StmtSemantics — the
/// ONE statement loop, top level and blocks alike. The driver owns
/// slots and the running last register.
fn lower_stmts(lo: Lower, stmts: List<StmtId>) -> Reg? {
    let cx = StmtLowerCx {
        store: lo.a.store,
        lower: (v: ExprId) -> lower_subtree(lo, v),
        lower_stmts: (body: List<StmtId>) -> lower_stmt_list(lo, body),
        mint: (k: ExprId) -> lo.mint(k),
        emit: (i: Ins) -> lo.give(i),
        slot_of: (s: StmtId) -> lo.slots[s.index],
        bind_slot: (s: StmtId, slot: Reg) -> lo.bind_slot(s, slot),
        assign_target: (s: StmtId) -> lo.a.assign_target(s),
        fail: (msg: string) -> lo.record(msg),
    }
    mut last: Reg? = null
    for s in stmts {
        let r: Reg? = stmt_semantics_of(lo.a.dispatch, lo.a.store.stmt(s)).lower_stmt(cx, s)
        if r != null {
            if lo.slots[s.index] == null { lo.set_slot(s, r!) }
            last = r
        }
    }
    last
}

/// A statement list lowered for its instructions alone — a loop
/// body's turn.
fn lower_stmt_list(lo: Lower, stmts: List<StmtId>) {
    let _ = lower_stmts(lo, stmts)
}

/// The program's answer, shown — printing IS lowering: the text
/// projection for the answer's shape, then one puts. No Print
/// instruction exists; both engines just run these calls.
fn print_lowering(lo: Lower, last: Reg) {
    let text: Reg? = match lo.a.typing.types.shape_of(lo.reg_types[last.index]) {
        .Str -> last,
        .Int -> text_call(lo, "avra_int_text", last),
        .Bool -> text_call(lo, "avra_bool_text", last),
        .List(elem) -> text_call(lo, list_text_callee(lo, elem), last),
        // A struct answer has no text projection yet — it arrives
        // with derived show; project a field instead.
        .Struct(_, _) -> null,
        .Error -> null,
    }
    if text != null { lo.give(Ins.CallRtVoid("avra_puts", [text!])) }
}

fn text_call(lo: Lower, callee: string, v: Reg) -> Reg {
    let t = lo.mint_ty(lo.a.typing.types.intern(Type.Str))
    lo.give(Ins.CallRt(t, callee, [v]))
    t
}

/// The runtime printer for a list, by its element shape.
fn list_text_callee(lo: Lower, elem: TypeId) -> string {
    if lo.a.typing.types.shape_of(elem) is .Bool { "avra_bools_text" } else { "avra_ints_text" }
}

/// A block is a scope: statements lower in order into it, and the
/// value register escapes as the scope's yield.
fn block_reg(lo: Lower, stmts: List<StmtId>, value: ExprId) -> Reg {
    lo.give(Ins.ScopeEnter(Level.Application))
    let _ = lower_stmts(lo, stmts)
    let r = lower_subtree(lo, value)
    lo.give(Ins.ScopeExit(r))
    r
}

impl Lower {
    /// The fresh register for a node, typed by the type pass.
    fn mint(self, e: ExprId) -> Reg {
        self.mint_ty(self.a.type_at(e))
    }

    /// A fresh register of an explicit type — for values no
    /// expression names (the answer's printed text).
    fn mint_ty(self, ty: TypeId) -> Reg {
        mut tys = self.reg_types
        tys.push(ty)
        Reg { index: tys.length - 1 }
    }

    /// Every instruction lands here — and a runtime callee the
    /// registry does not know refuses the BUILD, loudly, instead of
    /// crashing the backend.
    fn give(self, i: Ins) {
        let callee: string? = match i {
            .CallRt(_, c, _) -> c,
            .CallRtVoid(c, _) -> c,
            _ -> null,
        }
        if callee != null && rt_sig_of(callee!) == null {
            self.record("defect: unknown runtime callee `${callee!}` — add its row to runtime_api.av")
        }
        mut ins = self.ins
        ins.push(i)
    }

    /// An ident's register: its param's (params ARE registers
    /// 0..N-1), or its definition's slot — LOADED first when the
    /// slot is a memory cell, so the ident rule stays dumb.
    fn def_reg(self, e: ExprId) -> Reg? {
        let b: Binding? = self.a.binding(e)
        if b == null { return null }
        match b! {
            .Param(i) -> Reg { index: i },
            .Def(s) -> self.slot_reg(e, s),
        }
    }

    /// A definition's register: its slot — LOADED first when the
    /// slot is a memory cell, so the ident rule stays dumb.
    fn slot_reg(self, e: ExprId, target: StmtId) -> Reg? {
        let slot: Reg? = self.slots[target.index]
        if slot == null { return null }
        if self.boxed[target.index] {
            let ld = self.mint(e)
            self.give(Ins.Load(ld, slot!))
            return ld
        }
        slot
    }

    /// A field's runtime slot on a struct-typed expression — the
    /// declaration index IS the array index.
    fn field_slot(self, e: ExprId, fname: string) -> int? {
        let sig: StructSig? = match self.a.typing.types.shape_of(self.a.type_at(e)) {
            .Struct(decl, _) -> self.a.typing.struct_sigs[decl.index],
            _ -> null,
        }
        if sig == null { return null }
        sig!.slot_of(fname)
    }

    fn record(self, msg: string) {
        mut fs = self.failures
        fs.push(msg)
    }

    /// A statement's slot entry — the driver's value write; a bound
    /// CELL wins over it.
    fn set_slot(self, s: StmtId, r: Reg) {
        mut written = self.slots
        written.set(s.index, r)
    }

    /// Binds a statement's slot as a memory CELL: idents load
    /// through it, and the driver's value write defers to it.
    fn bind_slot(self, s: StmtId, slot: Reg) {
        mut cells = self.boxed
        cells.set(s.index, true)
        self.set_slot(s, slot)
    }
}
