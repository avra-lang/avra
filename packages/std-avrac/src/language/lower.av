//! Lowers a program to IR. The driver owns refusal, statement order,
//! registers, and the slot tables; HOW a statement or node lowers —
//! brackets included — lives in its owning feature. Lowering emits
//! PURE semantics — the memory pass owns every Retain and Release.
//! A definition's register is its slot (a mut binding's is a CELL,
//! loaded at each read), a param IS its register (params mint
//! first), so names cost nothing.
//! Each fn lowers to its OWN body with its own registers; `main` is
//! the statement list.
use core.{StmtId, ExprId, TypeId, Type, Reg, Ins, Level, TypeRegistry, filled, some_list, joined}
use diagnostics.{Diag, error_at, pointed, loc_at}
use features.{LowerCx, StmtLowerCx, FnSig, StructSig, EnumSig,
              fn_sig_of, record_sig_of, variant_sig_of, res_enum_sig,
              adopted, carried_of, okayed, hollow_of, Sub,
              subbed_variants, subbed_fields}
use @std.errors.{Loc}

/// One lowered body: instructions in order and each register's type
/// (dense by Reg). For a fn, the first `params.length` registers ARE
/// the params, and `gives` is the register RetVal answers with.
export type Body = {
    name: string,
    params: List<TypeId>,
    ret: TypeId,
    gives: Reg?,
    ins: List<Ins>,
    reg_types: List<TypeId>,
}

/// The lowering facts: every fn body, the entry body (`main` — its
/// specialness is explicit: no params, the answer's puts, exit 0), the
/// registry that names the types, and any defects.
export type Lowered = {
    fns: List<Body>,
    entry: Body,
    types: TypeRegistry,
    diagnostics: List<Diag>,
}

type Lower = {
    a: Analysis,
    fn_ret: TypeId?,
    sub: Sub?,
    jobs: Jobs,
    ins: List<Ins>,
    reg_types: List<TypeId>,
    regs: List<Reg?>,
    slots: List<Reg?>,
    boxed: List<bool>,
    pattern_regs: List<Reg?>,
    failures: List<string>,
}

/// One SPECIALIZATION to lower: a generic fn under concrete Vars,
/// named by its mangling.
type Spec = { name: string, sub: Sub }

/// The mono worklist, ONE instance threaded through every body's
/// lowering (lists and maps alias): call sites enqueue, the driver
/// drains. `seen` keys by mangled name.
type Jobs = { pending: List<Spec>, seen: Map<string, bool> }

/// One lowering per BODY — `fn_ret` is that body's declared answer
/// (null for main) and `sub` its instantiation (null when the body
/// is not a specialization), which is why they are fields, not
/// stacks.
fn new_lower(a: Analysis, fn_ret: TypeId?, sub: Sub?, jobs: Jobs) -> Lower {
    Lower {
        a: a, fn_ret: fn_ret, sub: sub, jobs: jobs, ins: [], reg_types: [],
        regs: filled<Reg?>(a.store.exprs.count(), null),
        slots: filled<Reg?>(a.store.stmts.count(), null),
        boxed: filled(a.store.stmts.count(), false),
        pattern_regs: filled<Reg?>(a.store.exprs.count(), null),
        failures: [],
    }
}

/// The whole program as IR: every plain fn body, then main, then
/// the mono worklist drained — each generic fn lowered ONCE per
/// distinct instantiation its call sites recorded, under a
/// substitution VIEW that makes every register concrete. The guard
/// is the polymorphic-recursion refusal.
export fn lower(a: Analysis) -> Lowered {
    let jobs = Jobs { pending: [], seen: {} }
    mut fns: List<Body> = []
    mut failures: List<string> = []
    for s in a.stmts {
        let parts: FnParts? = a.store.fn_parts(s)
        let p: FnParts? = directly_lowered(parts)
        if p != null {
            let lf = lower_fn(a, s, p!.name, p!.body, null, jobs)
            fns.push(lf.body)
            failures = failures.concat(lf.failures)
        }
    }
    let lm = lower_main(a, jobs)
    mut pending = jobs.pending
    mut drained = 0
    while !pending.is_empty() && drained < 1000 {
        let job = pending.pop()
        let body: ExprId? = fn_body_of(a, job.sub.target)
        if body != null {
            let lf = lower_fn(a, job.sub.target, job.name, body!, job.sub, jobs)
            fns.push(lf.body)
            failures = failures.concat(lf.failures)
        }
        drained = drained + 1
    }
    if !pending.is_empty() {
        failures.push("specializations exploded past 1000 — polymorphic recursion is not supported")
    }
    failures = failures.concat(lm.failures)
    Lowered {
        fns: fns, entry: lm.body, types: a.typing.types,
        diagnostics: lm.refusals.concat([error_at("language.defect", null, m) for m in failures]),
    }
}

type LoweredBody = { body: Body, failures: List<string>, refusals: List<Diag> }

/// One fn: params pre-minted as registers 0..N-1, the body inside
/// one scope, the answer after the scope settles.
fn lower_fn(a: Analysis, s: StmtId, fname: string, root: ExprId, sub: Sub?, jobs: Jobs) -> LoweredBody {
    let sig: FnSig? = fn_sig_of(a.decl_sig(s))
    let raw: List<TypeId> = sig?.params ?? []
    let rt: TypeId = viewed_ty(a, sub, sig?.ret ?? a.typing.types.intern(Type.Error))
    let ptypes = [viewed_ty(a, sub, pt) for pt in raw]
    let lo = new_lower(a, rt, sub, jobs)
    mut tys = lo.reg_types
    // LICENSED I3: `tys` ALIASES lo.reg_types — `concat` would rebind
    // the local and the registers would never reach the body
    for pt in ptypes { tys.push(pt) }
    lo.give(Ins.ScopeEnter(Level.Application))
    let r = lower_subtree(lo, root)
    lo.give(Ins.ScopeExit(r))
    lo.give(Ins.RetVal(r))
    LoweredBody {
        body: Body { name: fname, params: ptypes, ret: rt, gives: r, ins: lo.ins, reg_types: lo.reg_types },
        failures: lo.failures,
        refusals: [],
    }
}

fn lower_main(a: Analysis, jobs: Jobs) -> LoweredBody {
    let lo = new_lower(a, null, null, jobs)
    lo.give(Ins.ScopeEnter(Level.Application))
    let last: Reg? = lower_stmts(lo, a.stmts)
    let refusal: Diag? = if last == null { null } else { print_lowering(lo, last!) }
    lo.give(Ins.ScopeExit(null))
    lo.give(Ins.Ret(0))
    LoweredBody {
        body: Body {
            name: "main", params: [], ret: a.typing.types.intern(Type.Int),
            gives: null, ins: lo.ins, reg_types: lo.reg_types,
        },
        failures: lo.failures,
        refusals: some_list(refusal),
    }
}

/// One subtree's register, lowered at first request and memoized.
/// The recursion IS the walk: an impl asking for a child's register
/// lands back here — so a region's branches lower INSIDE it.
fn lower_subtree(lo: Lower, e: ExprId) -> Reg {
    let seen: Reg? = lo.regs[e.index]
    if seen != null { return seen! }
    let cx = expr_lower_cx(lo)
    let born = semantics_of(lo.a.dispatch, lo.a.store.expr(e)).lower(cx, e)
    let r = widened(cx, lo, e, narrowed(cx, lo, e, born))
    mut rs = lo.regs
    rs.set(e.index, r)
    r
}

/// A type under the body's instantiation — IDENTITY for a plain
/// body; the substitution for a specialization. Every type and
/// fact read in lowering passes through here, which is what makes
/// every minted register concrete.
fn viewed_ty(a: Analysis, sub: Sub?, ty: TypeId) -> TypeId {
    if sub == null { return ty }
    a.typing.types.substituted(ty, sub!.target, sub!.args)
}

/// The expression capabilities, wired once per request — what
/// lower_subtree runs and StmtLowerCx nests as `expr`.
fn expr_lower_cx(lo: Lower) -> LowerCx {
    LowerCx {
        store: lo.a.store,
        types: lo.a.typing.types,
        result: (k: ExprId) -> lo.mint(k),
        reg_of: (k: ExprId) -> lower_subtree(lo, k),
        def_reg: (k: ExprId) -> lo.def_reg(k),
        shape_at: (k: ExprId) -> lo.a.typing.types.shape_of(lo.view(lo.a.type_at(k))),
        type_at: (k: ExprId) -> lo.view(lo.a.type_at(k)),
        mint: (k: ExprId) -> lo.mint(k),
        mint_like: (r: Reg) -> lo.mint_ty(lo.reg_types[r.index]),
        mint_shape: (sh: Type) -> lo.mint_ty(lo.a.typing.types.intern(sh)),
        mint_ty: (ty: TypeId) -> lo.mint_ty(ty),
        fields_at: (k: ExprId) -> lo.fields_at(k),
        fields_of: (ty: TypeId) -> lo.fields_of(ty),
        bind_pattern: (k: ExprId, r: Reg) -> lo.bind_pattern(k, r),
        variants_at: (k: ExprId) -> lo.variants_at(k),
        variants_of: (ty: TypeId) -> lo.variants_ty(ty),
        emit: (i: Ins) -> lo.give(i),
        lower_block: (stmts: List<StmtId>, value: ExprId?) -> block_reg(lo, stmts, value),
        enclosing_ret: () -> lo.fn_ret,
        callee_of: (k: ExprId, name: string) -> lo.callee_of(k, name),
        fail: (msg: string) -> lo.record(msg),
    }
}

/// A read a presence test PROVED — typing recorded the nullable it
/// wears; the read unwraps here, at the same one edge widening
/// lifts. Narrow first, widen after: a proven read may itself be
/// lifted into a fresh nullable.
fn narrowed(cx: LowerCx, lo: Lower, e: ExprId, r: Reg) -> Reg {
    let worn: TypeId? = lo.a.typing.narrows[e.index]
    if worn == null { return r }
    carried_of(cx, r, lo.view(worn!))
}

/// A value a boundary LIFTED — into a nullable, or into a Result's
/// success (the auto-Ok wrap). Recorded by typing, minted here —
/// the one place every expression passes through, so a lift takes
/// its layout at exactly one edge; the target's shape decides
/// which: the null literal arrives already absent and `adopted`
/// knows; anything else lifting into a Res is a success.
fn widened(cx: LowerCx, lo: Lower, e: ExprId, r: Reg) -> Reg {
    let worn: TypeId? = lo.a.typing.widens[e.index]
    if worn == null { return r }
    let into = lo.view(worn!)
    if lo.a.typing.types.shape_of(into) is .Res { return okayed(cx, into, r) }
    // an empty array IS a valid list of anything — identity lift
    if lo.a.typing.types.shape_of(into) is .List { return r }
    adopted(cx, into, cx.shape_at(e) is .Null, r)
}

/// Statements in order, each through its own StmtSemantics — the
/// ONE statement loop, top level and blocks alike. The driver owns
/// slots and the running last register.
fn lower_stmts(lo: Lower, stmts: List<StmtId>) -> Reg? {
    let cx = StmtLowerCx {
        store: lo.a.store,
        expr: expr_lower_cx(lo),
        lower_stmts: (body: List<StmtId>) -> lower_stmt_list(lo, body),
        slot_of: (s: StmtId) -> lo.slots[s.index],
        bind_slot: (s: StmtId, slot: Reg) -> lo.bind_slot(s, slot),
        assign_target: (s: StmtId) -> lo.a.assign_target(s),
    }
    // LICENSED I4: the running last register, not a scan
    mut last: Reg? = null
    for s in stmts {
        let r: Reg? = stmt_semantics_of(lo.a.dispatch, lo.a.store.stmt(s)).lower_stmt(cx, s)
        if r != null {
            if lo.slots[s.index] == null { lo.set_slot(s, r!) }
            last = r
        }
    }
    last
}

/// A statement list lowered for its instructions alone — a loop
/// body's turn.
fn lower_stmt_list(lo: Lower, stmts: List<StmtId>) {
    let _ = lower_stmts(lo, stmts)
}

/// The program's answer, shown — printing IS lowering: the text
/// projection for the answer's shape, then one puts. No Print
/// instruction exists; both engines just run these calls. An
/// answer with NO projection refuses HERE, before either engine —
/// so eval and native cannot diverge on it.
fn print_lowering(lo: Lower, last: Reg) -> Diag? {
    let sh = lo.a.typing.types.shape_of(lo.reg_types[last.index])
    let unprintable: string? = match sh {
        .Struct(_, n) -> n,
        .Enum(_, n) -> n,
        .Res(_, _) -> lo.a.typing.types.name_of(lo.reg_types[last.index]),
        .App(_, _, _) -> lo.a.typing.types.name_of(lo.reg_types[last.index]),
        .TypeName(_, n) -> n,
        .Var(_, _, n) -> n,
        .EmptyList -> "[]",
        .Opt(_) or .Null -> lo.a.typing.types.name_of(lo.reg_types[last.index]),
        .Int or .Str or .Bool or .List(_) or .Error -> null,
    }
    if unprintable != null { return no_projection(lo, unprintable!) }
    let text: Reg? = match sh {
        .Str -> last,
        .Int -> text_call(lo, "avra_int_text", last),
        .Bool -> text_call(lo, "avra_bool_text", last),
        .List(elem) -> text_call(lo, list_text_callee(lo, elem), last),
        .Struct(_, _) or .Enum(_, _) or .Res(_, _) or .App(_, _, _) or
        .TypeName(_, _) or .Var(_, _, _) -> null,
        .Opt(_) or .Null or .EmptyList -> null,
        .Error -> null,
    }
    if text != null { lo.give(Ins.CallRtVoid("avra_puts", [text!])) }
    null
}

/// The refusal: an answer without a text projection names its type
/// and the remedy.
fn no_projection(lo: Lower, tname: string) -> Diag {
    pointed(
        error_at("lower.no_projection", lo.answer_loc(),
            "the program's answer is a `${tname}`, which has no text projection yet"),
        "this is the answer")
        with { help: "project a field instead — `p.x` prints" }
}

fn text_call(lo: Lower, callee: string, v: Reg) -> Reg {
    let t = lo.mint_ty(lo.a.typing.types.intern(Type.Str))
    lo.give(Ins.CallRt(t, callee, [v]))
    t
}

/// The runtime printer for a list, by its element shape.
fn list_text_callee(lo: Lower, elem: TypeId) -> string {
    if lo.a.typing.types.shape_of(elem) is .Bool { "avra_bools_text" } else { "avra_ints_text" }
}

/// A block is a scope: statements lower in order into it, and the
/// value register escapes as the scope's yield. A block that
/// LEAVES yields a hollow typed as the fn's promise — the exit
/// already happened, and everything after it is the backend's dead
/// continuation.
fn block_reg(lo: Lower, stmts: List<StmtId>, value: ExprId?) -> Reg {
    lo.give(Ins.ScopeEnter(Level.Application))
    let _ = lower_stmts(lo, stmts)
    let r = if value == null { departed_tail(lo) } else { lower_subtree(lo, value!) }
    lo.give(Ins.ScopeExit(r))
    r
}

/// The never-read yield of a block that left — typed as the fn's
/// promise, so every merge it feeds stays type-consistent.
fn departed_tail(lo: Lower) -> Reg {
    hollow_of(expr_lower_cx(lo), lo.fn_ret ?? lo.a.typing.types.intern(Type.Error))
}

impl Lower {
    /// The fresh register for a node, typed by the type pass.
    fn mint(self, e: ExprId) -> Reg {
        self.mint_ty(self.view(self.a.type_at(e)))
    }

    /// The body's substitution view — identity for plain bodies.
    fn view(self, ty: TypeId) -> TypeId {
        viewed_ty(self.a, self.sub, ty)
    }

    /// The name a call site targets: the plain name, or — when
    /// typing recorded an instantiation — the mangling of that
    /// instantiation COMPOSED with this body's own view, enqueued
    /// for the worklist on first sight.
    fn callee_of(self, e: ExprId, name: string) -> string {
        let held: Sub? = self.a.typing.substs[e.index]
        if held == null { return name }
        let composed = Sub { target: held!.target, args: [self.view(t) for t in held!.args] }
        let mangled = mangle(name, composed)
        let met: bool? = self.jobs.seen.get(mangled)
        if met == null {
            mut seen = self.jobs.seen
            seen.set(mangled, true)
            mut pending = self.jobs.pending
            pending.push(Spec { name: mangled, sub: composed })
        }
        mangled
    }

    /// A fresh register of an explicit type — for values no
    /// expression names (the answer's printed text).
    fn mint_ty(self, ty: TypeId) -> Reg {
        mut tys = self.reg_types
        tys.push(ty)
        Reg { index: tys.length - 1 }
    }

    /// Every instruction lands here — and a runtime callee the
    /// registry does not know refuses the BUILD, loudly, instead of
    /// crashing the backend.
    fn give(self, i: Ins) {
        // A new CALLING instruction must decide whether the runtime
        // registry validates it; the arms make that unavoidable.
        let callee: string? = match i {
            .CallRt(_, c, _) -> c,
            .CallRtVoid(c, _) -> c,
            .ConstInt(_, _) or .ConstStr(_, _) or .ConstBool(_, _) or
            .Bin(_, _, _, _) or .Un(_, _, _) or .Call(_, _, _) or
            .Pack(_, _) or .Extract(_, _, _) or
            .ScopeEnter(_) or .ScopeExit(_) or .IfStart(_) or
            .SwitchStart(_, _) or .ArmEnd(_) or .RegionEnd(_, _) or
            .Alloca(_) or .Load(_, _) or .Store(_, _) or
            .LoopStart or .LoopCond(_) or .LoopEnd or
            .Retain(_) or .Release(_) or .RetVal(_) or .FnExit(_) or
            .Ret(_) -> null,
        }
        if callee != null && rt_sig_of(callee!) == null {
            self.record("defect: unknown runtime callee `${callee!}` — add its row to runtime_api.av")
        }
        mut ins = self.ins
        ins.push(i)
    }

    /// An ident's register: its param's (params ARE registers
    /// 0..N-1), or its definition's slot — LOADED first when the
    /// slot is a memory cell, so the ident rule stays dumb.
    fn def_reg(self, e: ExprId) -> Reg? {
        let b: Binding? = self.a.binding(e)
        if b == null { return null }
        match b! {
            .Param(i) -> Reg { index: i },
            .Def(s) -> self.slot_reg(e, s),
            .Pattern(v) -> self.pattern_regs[v.index],
        }
    }

    /// A definition's register: its slot — LOADED first when the
    /// slot is a memory cell, so the ident rule stays dumb.
    fn slot_reg(self, e: ExprId, target: StmtId) -> Reg? {
        let slot: Reg? = self.slots[target.index]
        if slot == null { return null }
        if self.boxed[target.index] {
            let ld = self.mint(e)
            self.give(Ins.Load(ld, slot!))
            return ld
        }
        slot
    }

    /// A struct-typed expression's field table; null for every
    /// other shape. The declaration index IS the array index.
    fn fields_at(self, e: ExprId) -> StructSig? {
        self.fields_of(self.view(self.a.type_at(e)))
    }

    /// A struct TYPE's field table — `fields_at`'s TypeId-keyed
    /// twin, for members read on a type no expression wears (what
    /// a nullable carries).
    fn fields_of(self, ty: TypeId) -> StructSig? {
        match self.a.typing.types.shape_of(ty) {
            .Struct(decl, _) -> record_sig_of(self.a.decl_sig(decl)),
            .App(decl, _, args) ->
                subbed_fields(self.a.typing.types, record_sig_of(self.a.decl_sig(decl)), decl, args),
            .Int or .Str or .Bool or .List(_) or .Enum(_, _) or .Res(_, _) or
            .TypeName(_, _) or .Var(_, _, _) or .Opt(_) or .Null or .EmptyList or
            .Error -> null,
        }
    }

    /// An enum-typed expression's variant table; null otherwise.
    /// The declaration index IS the runtime tag.
    fn variants_at(self, e: ExprId) -> EnumSig? {
        self.variants_ty(self.view(self.a.type_at(e)))
    }

    /// The variant table by TYPE — Result IS an enum, the built-in
    /// one; same bridge as the typing side.
    fn variants_ty(self, ty: TypeId) -> EnumSig? {
        match self.a.typing.types.shape_of(ty) {
            .Enum(decl, _) -> variant_sig_of(self.a.decl_sig(decl)),
            .Res(ok, err) -> res_enum_sig(ok, err),
            .App(decl, _, args) ->
                subbed_variants(self.a.typing.types, variant_sig_of(self.a.decl_sig(decl)), decl, args),
            .Int or .Str or .Bool or .List(_) or .Struct(_, _) or
            .TypeName(_, _) or .Var(_, _, _) or .Opt(_) or .Null or .EmptyList or
            .Error -> null,
        }
    }

    /// The register an arm's bind reads — recorded as that arm
    /// lowers, so an ident inside it finds the payload.
    fn bind_pattern(self, v: ExprId, r: Reg) {
        mut ps = self.pattern_regs
        ps.set(v.index, r)
    }

    fn record(self, msg: string) {
        mut fs = self.failures
        fs.push(msg)
    }

    /// Where the program's answer lives: the last value-bearing
    /// statement's location.
    fn answer_loc(self) -> Loc? {
        let valued = self.a.stmts.filter((s: StmtId) -> self.a.store.stmt_value(s) != null)
        let speaker: StmtId? = valued.last()
        if speaker == null { return null }
        loc_at(self.a.source.file, self.a.store.stmt_span(speaker!))
    }

    /// A statement's slot entry — the driver's value write; a bound
    /// CELL wins over it.
    fn set_slot(self, s: StmtId, r: Reg) {
        mut written = self.slots
        written.set(s.index, r)
    }

    /// Binds a statement's slot as a memory CELL: idents load
    /// through it, and the driver's value write defers to it.
    fn bind_slot(self, s: StmtId, slot: Reg) {
        mut cells = self.boxed
        cells.set(s.index, true)
        self.set_slot(s, slot)
    }
}

/// A fn the driver lowers DIRECTLY — generic ones wait for their
/// instantiations to arrive on the worklist.
fn directly_lowered(parts: FnParts?) -> FnParts? {
    if parts != null && parts!.tparams.is_empty() { parts } else { null }
}

/// The specialization's name: uncollidable (`$` is unwritable) and
/// stable per run — interned ids in ordinal order.
fn mangle(name: string, sub: Sub) -> string {
    "${name}$${joined(["${a.index}" for a in sub.args], "_")}"
}

/// A declaration's body, when the statement is a fn.
fn fn_body_of(a: Analysis, s: StmtId) -> ExprId? {
    let parts: FnParts? = a.store.fn_parts(s)
    if parts == null { return null }
    parts!.body
}
