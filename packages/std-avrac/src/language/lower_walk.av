//! One body's walk — the context's own verbs: a subtree lowered at
//! first request (the recursion IS the walk), the narrow/widen edge
//! every expression passes through, the dyn lift, the statement
//! loop, a block's scope, and the entry's printed answer.
use core.{StmtId, ExprId, TypeId, Type, Reg, Ins, Level, DeclId}
use diagnostics.{Diag, refusal}
use features.{LowerCx, push_slot, adopted, carried_of, okayed, hollow_of, semantics_of, stmt_semantics_of}

impl LowerCx {
    /// One subtree's register, lowered at first request and
    /// memoized. The recursion IS the walk: an impl asking for a
    /// child's register lands back here — so a region's branches
    /// lower INSIDE it.
    mut fn reg_of(e: ExprId) -> Reg {
        let seen: Reg? = self.body.reg_at(e)
        if seen != null { return seen! }
        let born = semantics_of(self.dispatch, self.view.store.expr(e)).lower(self, e)
        let r = self.widened(e, self.narrowed(e, born))
        self.body.set_reg(e, r)
        r
    }

    /// A read a presence test PROVED — typing recorded the nullable
    /// it wears; the read unwraps here, at the same one edge
    /// widening lifts. Narrow first, widen after: a proven read may
    /// itself be lifted into a fresh nullable.
    mut fn narrowed(e: ExprId, r: Reg) -> Reg {
        let worn: TypeId? = self.facts.narrowed_at(e)
        if worn == null { return r }
        carried_of(self, r, self.concrete(worn!))
    }

    /// A value a boundary LIFTED — into a nullable, or into a
    /// Result's success (the auto-Ok wrap). Recorded by typing,
    /// minted here — the one place every expression passes through,
    /// so a lift takes its layout at exactly one edge; the target's
    /// shape decides which: the null literal arrives already absent
    /// and `adopted` knows; anything else lifting into a Res is a
    /// success.
    mut fn widened(e: ExprId, r: Reg) -> Reg {
        let worn: TypeId? = self.facts.widened_at(e)
        if worn == null { return r }
        let into = self.concrete(worn!)
        let sh: Type = self.view.decls.types.shape_of(into)
        if sh is .Res { return okayed(self, into, r) }
        // an empty array IS a valid list of anything, an empty map a
        // valid map of anything — identity lifts
        if sh is .List || sh is .Map { return r }
        if sh is .Dyn { return self.boxed_into(into, r) }
        adopted(self, into, self.shape_at(e) is .Null, r)
    }

    /// The dyn lift: the box is [value, methods…] in trait order — an
    /// ordinary slot array, minted here at the one widening edge.
    /// The value's own declared name picks whose methods ride along;
    /// dispatch reads the same lanes by the same list.
    mut fn boxed_into(into: TypeId, r: Reg) -> Reg {
        let tdecl: DeclId? = match self.view.decls.types.shape_of(into) {
            .Dyn(d, _) -> d,
            _ -> null,
        }
        // an instantiation may arrive already boxed — identity lift
        if self.view.decls.types.shape_of(self.out.reg_types[r.index]) is .Dyn { return r }
        let target: DeclId? = self.boxed_decl(r)
        if tdecl == null || target == null {
            self.defect("a dyn lift from an unnamed shape survived typing")
            return r
        }
        let dst = self.out.mint_ty(into)
        self.out.give(Ins.CallRt(dst, "avra_array_new", []))
        push_slot(self, dst, r)
        for mn in self.view.decls.trait_method_names(tdecl!) {
            let m: DeclId? = self.view.decls.method(target!, mn)
            if m == null {
                self.defect("an unanswered trait method survived typing")
                return r
            }
            let addr = self.out.mint_ty(self.view.decls.types.intern(Type.Int))
            self.out.give(Ins.FnAddr(addr, self.wanted(m!, null)))
            push_slot(self, dst, addr)
        }
        dst
    }

    /// The lifted value's declared name — whose impl the box carries.
    fn boxed_decl(r: Reg) -> DeclId? {
        match self.view.decls.types.shape_of(self.out.reg_types[r.index]) {
            .Struct(d, _) -> d,
            .Enum(d, _) -> d,
            .Int or .Ptr or .Str or .Bool or .List(_) or .Opt(_) or .Null or
            .Res(_, _) or .Var(_, _, _) or .App(_, _, _) or .Dyn(_, _) or .Fn(_, _) or
            .TypeName(_, _) or .EmptyList or .Error or .Void or .Map(_, _) or .EmptyMap -> null,
        }
    }

    /// Statements in order, each through its own StmtSemantics — the
    /// ONE statement loop, top level and blocks alike. The driver
    /// owns slots and the running last register.
    mut fn lower_stmts(stmts: List<StmtId>) {
        for s in stmts {
            let r: Reg? = stmt_semantics_of(self.dispatch, self.view.store.stmt(s)).lower_stmt(self, s)
            if r != null && self.body.slot_of(s) == null { self.body.set_slot(s, r!) }
        }
    }

    /// The program's answer, shown — printing IS lowering: the text
    /// projection for the answer's shape, then one puts. No Print
    /// instruction exists; both engines just run these calls. An
    /// answer with NO projection refuses HERE, before either engine —
    /// so eval and native cannot diverge on it.
    mut fn print_lowering(last: Reg) -> Diag? {
        let sh = self.view.decls.types.shape_of(self.out.reg_types[last.index])
        let unprintable: string? = match sh {
            .Struct(_, n) -> n,
            .Enum(_, n) -> n,
            .Res(_, _) -> self.view.decls.types.name_of(self.out.reg_types[last.index]),
            .App(_, _, _) -> self.view.decls.types.name_of(self.out.reg_types[last.index]),
            .TypeName(_, n) -> n,
            .Var(_, _, n) -> n,
            .EmptyList -> "[]",
            .Opt(_) or .Null or .Dyn(_, _) or .Fn(_, _) or .Ptr -> self.view.decls.types.name_of(self.out.reg_types[last.index]),
            .Int or .Str or .Bool or .List(_) or .Error or .Void or .Map(_, _) or .EmptyMap -> null,
        }
        if unprintable != null { return self.no_projection(unprintable!) }
        let text: Reg? = match sh {
            .Str -> last,
            .Int -> self.text_call("avra_int_text", last),
            .Bool -> self.text_call("avra_bool_text", last),
            .List(elem) -> self.text_call(self.list_text_callee(elem), last),
            .Ptr or .Struct(_, _) or .Enum(_, _) or .Res(_, _) or .App(_, _, _) or
            .TypeName(_, _) or .Var(_, _, _) or .Dyn(_, _) or .Fn(_, _) -> null,
            .Opt(_) or .Null or .EmptyList -> null,
            .Error or .Void or .Map(_, _) or .EmptyMap -> null,
        }
        if text != null { self.out.give(Ins.CallRtVoid("avra_puts", [text!])) }
        null
    }

    /// The refusal: an answer without a text projection names its
    /// type and the remedy.
    fn no_projection(tname: string) -> Diag {
        refusal("lower.no_projection", self.answer_loc(), "the program's answer is a `${tname}`, which has no text projection yet", "this is the answer", "project a field instead — `p.x` prints")
    }

    mut fn text_call(callee: string, v: Reg) -> Reg {
        let t = self.out.mint_ty(self.view.decls.types.intern(Type.Str))
        self.out.give(Ins.CallRt(t, callee, [v]))
        t
    }

    /// The runtime printer for a list, by its element shape.
    fn list_text_callee(elem: TypeId) -> string {
        if self.view.decls.types.shape_of(elem) is .Bool { return "avra_bools_text" }
        if self.view.decls.types.shape_of(elem) is .Str { return "avra_strs_text" }
        "avra_ints_text"
    }

    /// A block is a scope: statements lower in order into it, and
    /// the value register escapes as the scope's yield. A block that
    /// LEAVES — or simply ends in a statement — yields a hollow of
    /// the block's OWN type, which typing already settled: the fn's
    /// promise for a block that departed, void for one that merely
    /// ended. Every merge it feeds is typed by that same answer.
    mut fn lower_block(stmts: List<StmtId>, value: ExprId?, ty: TypeId) -> Reg {
        self.out.give(Ins.ScopeEnter(Level.Application))
        self.lower_stmts(stmts)
        let r = if value == null { hollow_of(self, ty) } else { self.reg_of(value!) }
        self.out.give(Ins.ScopeExit(r))
        r
    }
}
