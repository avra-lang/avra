//! THE WORKSPACE — many files, one program, driven by the query
//! kernel. Every step is a family of queries: `source`, `parsed`,
//! `items` by FileId; `namespace` by ModuleId; `visible`, `resolved`
//! by FileId; `sig`, `methods`, `typed` by DeclId; `folded` and
//! `analysis` by FileId; `lowered` by unit. A declaration's
//! signature and a type's method table are asked LAZILY — the
//! table's own reads are the queries, armed here — so declaration
//! order stops mattering, a cycle speaks, and a body depends on
//! exactly what it read. `program` composes the files for lowering.
//! The host is a record of fns, so tests hand in memory and the CLI
//! hands in the disk. A workspace holds PACKAGES: the root's (its
//! `avra.toml`, or none) and, transitively, every path dependency a
//! manifest names; each is its own module tree under its `src/`,
//! and a `use @scope.name.a` reaches a dependency's module only when
//! the asking package's manifest declares it. A lone file is a
//! package of one rooted at its directory.
use core.{Table, new_table, NodeStore, ModulePath, module_path, key_spelled, DeclId, FileId, ModuleId, UseParts, ExprId, Case, fp, fp_str, joined, flatten, dir_of, sorted_texts, first_slash, under_dir, joined_path, normalized, relative_path, TypeId, Type, some_list, same_file, touch, SpecParts}
use features.{Decls, new_decls, kind_word, Decl, Namespace, Import, ModuleNames, module_names, file_names, Clash, method_clashes, NameFacts, TypeFacts, new_type_facts, DeclSig, fn_sig_of, record_sig_of, variant_sig_of, FnSig, StructSig, EnumSig}
use diagnostics.{SourceFile, new_source_file, Diag, Voices, no_voices, error_at, loc_at, render_among, refusal, by_position, has_errors, is_error}
use query.{Db, new_db, Key}
use @std.errors.{Loc, Suggestion, Edit, Confidence}
use @std.testing.{CaseRef, words}

/// The host's environment — what a `${NAME}` hole in a link row fills from.
extern fn avra_host_env(name: string) -> string

/// The filesystem, as four questions.
export type Host = { exists: fn(string) -> bool, read: fn(string) -> string, list: fn(string) -> List<string>, is_dir: fn(string) -> bool }

/// A host over an in-memory file table — the tests' host, and a
/// lone file's.
export fn memory_host(files: Map<string, string>, names: List<string>) -> Host {
    Host {
        exists: (p: string) -> files.get(p) != null,
        read: (p: string) -> files.get(p) ?? "",
        list: (dir: string) -> children_of(names, dir),
        is_dir: (dir: string) -> names.any(under_dir(it, dir)),
    }
}

/// The direct children of `dir` among `names` — the base names, in
/// byte order like the disk host's.
fn children_of(names: List<string>, dir: string) -> List<string> {
    mut out: List<string> = []
    for n in names {
        if under_dir(n, dir) {
            let rest = if dir.length == 0 { n } else { n.substring(dir.length + 1, n.length) }
            let cut: int = first_slash(rest)
            let child = if cut < 0 { rest } else { rest.substring(0, cut) }
            if child.length > 0 && !out.contains(child) { out.push(child) }
        }
    }
    sorted_texts(out)
}

/// The families' value tables, sparse by their keys and grown as
/// values are placed; `sigs` and `methods` live in the declaration
/// table itself.
export type Workspace = {
    host: Host,
    root: string,
    lang: Language,
    db: Db,
    decls: Decls,
    // ONE RUN'S VIEW of each file and each manifest: read,
    // fingerprinted and indexed once. A host that changes under a
    // running workspace (Era IV's live editing) invalidates these
    // with the revision; today no host does.
    sources: Table<SourceFile>,
    manifests: Table<Manifest>,
    // the program's extern symbols, gathered once at the first
    // lowering (index 0)
    externs: Table<List<string>>,
    programs: Table<Parsed>,
    file_items: Table<List<DeclId>>,
    module_names: Table<ModuleNames>,
    visibles: Table<Namespace>,
    name_facts: Table<NameFacts>,
    sig_voices: Table<Voices>,
    decl_facts: Table<TypeFacts>,
    method_clashes: Table<List<Clash>>,
    folds: Table<TypeFacts>,
    analyses: Table<Analysis>,
    specs: Map<string, int>,
    asks: List<Wanted>,
    units: Table<Unit>,
    defects: List<Diag>,
    packages: List<Package>,
    package_voices: List<Diag>,
    lone: bool,
    clock: fn() -> int,
    phases: List<Phase>,
}

/// One package of the workspace: its key (the manifest's name; ""
/// for a root without one), its root and source directories, its
/// ordinal (the manifest query's key), and where it was named —
/// absent for the root.
export type Package = { key: string, root: string, src: string, ordinal: int, at: Loc? }

/// One timed phase, in nanoseconds of the workspace's clock.
export type Phase = { name: string, ns: int }

/// THE FAMILIES — the compiler's query vocabulary, in pipeline
/// order. Keys by FileId (`Source` … `Resolved`, `Folded`,
/// `Analysis`), ModuleId (`Namespace`), DeclId (`Sig`, `Methods`,
/// `Typed`) or unit (`Lowered`). `ordinal` is the kernel's number
/// for each; `refetched` re-asks any of them — both exhaustive, so
/// a new family cannot ship half-registered.
enum Family {
    Source
    Parsed
    Items
    Namespace
    Visible
    Resolved
    Sig
    Methods
    Typed
    Folded
    Analysis
    Lowered
    Manifest
    Receivers
}

fn key(f: Family, arg: int) -> Key {
    Key { family: ordinal(f), arg: arg }
}

fn ordinal(f: Family) -> int {
    match f {
        .Source -> 0,
        .Parsed -> 1,
        .Items -> 2,
        .Namespace -> 3,
        .Visible -> 4,
        .Resolved -> 5,
        .Sig -> 6,
        .Methods -> 7,
        .Typed -> 8,
        .Folded -> 9,
        .Analysis -> 10,
        .Lowered -> 11,
        .Manifest -> 12,
        .Receivers -> 13,
    }
}

/// The families in ordinal order — the kernel registers them so.
fn families() -> List<Family> {
    let all: List<Family> = [Family.Source, Family.Parsed, Family.Items, Family.Namespace, Family.Visible, Family.Resolved,
                             Family.Sig, Family.Methods, Family.Typed, Family.Folded, Family.Analysis, Family.Lowered, Family.Manifest,
                             Family.Receivers]
    all
}

export fn new_workspace(host: Host, root: string, lang: Language) -> Workspace {
    timed_workspace(host, root, lang, () -> 0)
}

/// A lone file as a package of one: a memory host holding just it,
/// rooted at its directory — root and source root alike — with no
/// modules to import from.
export fn lone_workspace(path: string, text: string, lang: Language) -> Workspace {
    mut files: Map<string, string> = {}
    files.set(path, text)
    built(memory_host(files, [path]), dir_of(path), dir_of(path), lang, () -> 0, true)
}

/// A workspace that times its phases by the given clock (nanoseconds).
export fn timed_workspace(host: Host, root: string, lang: Language, clock: fn() -> int) -> Workspace {
    built(host, root, joined_path(root, "src"), lang, clock, false)
}

/// The declaration table with the language's own declarations in it.
fn language_decls(lang: Language) -> Decls {
    let decls = new_decls() with { rows: lang.rows.types }
    decls.admit_builtins()
    decls
}

/// The workspace with its families registered, its table armed,
/// and its packages loaded from the root's manifest outward.
fn built(host: Host, root: string, src: string, lang: Language, clock: fn() -> int, lone: bool) -> Workspace {
    let ws = Workspace {
        host: host, root: root, lang: lang, db: new_db(), decls: language_decls(lang),
        sources: new_table<SourceFile>(), manifests: new_table<Manifest>(), externs: new_table<List<string>>(), programs: new_table<Parsed>(), file_items: new_table<List<DeclId>>(), module_names: new_table<ModuleNames>(),
        visibles: new_table<Namespace>(), name_facts: new_table<NameFacts>(), sig_voices: new_table<Voices>(),
        decl_facts: new_table<TypeFacts>(), method_clashes: new_table<List<Clash>>(), folds: new_table<TypeFacts>(),
        analyses: new_table<Analysis>(), units: new_table<Unit>(), specs: {}, asks: [], defects: [],
        packages: [], package_voices: [], lone: lone,
        clock: clock, phases: [],
    }
    for f in families() {
        if ws.db.family((arg: int) -> refetched(ws, f, arg)) != ordinal(f) { ws.defect("defect: the families registered out of ordinal order") }
    }
    // the table's reads ARE the queries
    ws.decls.arm((d: DeclId) -> ensured(ws, d))
    ws.decls.arm_methods((d: DeclId) -> methods_ensured(ws, d))
    ws.decls.arm_writes((d: DeclId) -> writes_ensured(ws))
    load_packages(ws, src)
    ws
}

fn ensured(ws: Workspace, d: DeclId) {
    let _ = sig(ws, d)
}

fn methods_ensured(ws: Workspace, d: DeclId) {
    let _ = methods(ws, d)
}

fn writes_ensured(ws: Workspace) {
    let _ = receivers(ws)
}

/// A family's arg, as the file, module or declaration it keys by.
fn file_at(arg: int) -> FileId { FileId { index: arg } }
fn module_at(arg: int) -> ModuleId { ModuleId { index: arg } }
fn decl_at_arg(arg: int) -> DeclId { DeclId { index: arg } }

/// The kernel's verifier for every family: the key re-asked through
/// its own query, then the cell's changed_at.
fn refetched(ws: Workspace, f: Family, arg: int) -> int {
    match f {
        .Source -> touch(source(ws, file_at(arg))),
        .Parsed -> touch(parsed(ws, file_at(arg))),
        .Items -> touch(items(ws, file_at(arg))),
        .Namespace -> touch(namespace(ws, module_at(arg))),
        .Visible -> touch(visible(ws, file_at(arg))),
        .Resolved -> touch(resolved(ws, file_at(arg))),
        .Sig -> touch(sig(ws, decl_at_arg(arg))),
        .Methods -> touch(methods(ws, decl_at_arg(arg))),
        .Typed -> touch(typed(ws, decl_at_arg(arg))),
        .Folded -> touch(folded(ws, file_at(arg))),
        .Analysis -> touch(analysis(ws, file_at(arg))),
        .Lowered -> touch(lowered(ws, arg)),
        .Manifest -> touch(manifest(ws, arg)),
        .Receivers -> touch(receivers(ws)),
    }
    ws.db.changed_at(key(f, arg))
}

impl Workspace {
    fn timed(name: string, ns: int) {
        self.phases.push(Phase { name: name, ns: ns })
    }

    fn defect(message: string) {
        self.defects.push(error_at("language.defect", null, message))
    }

}

// ── The families ──

/// A path's identity — the table mints it at first mention.
export fn file_id(ws: Workspace, path: string) -> FileId {
    ws.decls.file_id(path, module_of(ws, path))
}

/// An INPUT: the file's text, hashed; the revision moves only when
/// the text did.
export fn source(ws: Workspace, f: FileId) -> SourceFile {
    let k = key(Family.Source, f.index)
    let held: SourceFile? = ws.sources.at(f.index)
    if held != null {
        ws.db.record_dep(k)
        return held!
    }
    let path = ws.decls.file(f).path
    let text = ws.host.read(path)
    ws.db.set_input(k, fp_str(text))
    ws.db.record_dep(k)
    let src = new_source_file(path, text)
    ws.sources.keep(f.index, src)
    src
}

/// The file parsed — pure in its text.
export fn parsed(ws: Workspace, f: FileId) -> Parsed {
    let k = key(Family.Parsed, f.index)
    if ws.db.ask(k) is .Reuse { return ws.programs.at(f.index)! }
    ws.db.begin(k)
    let p = parse_program(ws.lang, source(ws, f))
    ws.db.settle(k, program_hash(p))
    ws.programs.keep(f.index, p)
    p
}

/// A program's fingerprint — the fold of its statements'.
fn program_hash(p: Parsed) -> int {
    fp(17, [p.store.stmt_fingerprint(s) for s in p.stmts])
}

/// The declarations a file MINTS into the one table; the answer's
/// hash is the item tree's — names and kinds.
export fn items(ws: Workspace, f: FileId) -> List<DeclId> {
    let k = key(Family.Items, f.index)
    if ws.db.ask(k) is .Reuse {
        let held: List<DeclId> = ws.file_items.at(f.index) ?? []
        return held
    }
    ws.db.begin(k)
    let p = parsed(ws, f)
    let ids = ws.decls.admit(f, p.store, p.stmts)
    ws.db.settle(k, fp(7, [item_print(ws, d) for d in ids]))
    ws.file_items.keep(f.index, ids)
    ids
}

/// The declaration behind an id.
export fn decl_at(ws: Workspace, d: DeclId) -> Decl {
    ws.decls.decl(d)
}

/// An item's print in the item tree's hash: its name, kind and
/// visibility.
fn item_print(ws: Workspace, d: DeclId) -> int {
    let x = decl_at(ws, d)
    fp_str("${x.name}/${kind_word(x.kind)}/${x.exported}")
}

/// A module's names, bound ONCE: every file's declarations in file
/// then declaration order.
export fn namespace(ws: Workspace, m: ModuleId) -> ModuleNames {
    let k = key(Family.Namespace, m.index)
    if ws.db.ask(k) is .Reuse { return ws.module_names.at(m.index)! }
    ws.db.begin(k)
    let paths = module_files(ws, module_path(segments_of(ws.decls.module_name(m))))
    let ordered: List<DeclId> = flatten([items(ws, file_id(ws, path)) for path in paths])
    let names = module_names(ws.decls, ordered, (path: string) -> shown(ws, path))
    ws.db.settle(k, fp(3, [d.index for d in names.bound].concat([names.clashes.length])))
    ws.module_names.keep(m.index, names)
    names
}

/// What a file's top level sees: its module's names, then its
/// imports — with what the `use` lines earned.
export fn visible(ws: Workspace, f: FileId) -> Namespace {
    let k = key(Family.Visible, f.index)
    if ws.db.ask(k) is .Reuse { return ws.visibles.at(f.index)! }
    ws.db.begin(k)
    let p = parsed(ws, f)
    mut imports: List<Import> = []
    mut diags: List<Diag> = []
    for u in use_lines(p) {
        let line = imported_line(ws, p, u)
        imports = imports.concat(line.imports)
        diags = diags.concat(line.diagnostics)
    }
    let names = file_names(ws.decls, f, namespace(ws, ws.decls.file(f).module_id), imports, (path: string) -> shown(ws, path))
    let out = names with { voices: Voices { list: diags.concat(names.voices.list) } }
    ws.db.settle(k, ws.db.revision())
    ws.visibles.keep(f.index, out)
    out
}

/// A file's names resolved.
export fn resolved(ws: Workspace, f: FileId) -> NameFacts {
    let k = key(Family.Resolved, f.index)
    if ws.db.ask(k) is .Reuse { return ws.name_facts.at(f.index)! }
    ws.db.begin(k)
    touch(items(ws, f))
    let p = parsed(ws, f)
    let out = resolve(ws.lang, file_view(ws.lang, p, ws.decls, f), visible(ws, f))
    ws.db.settle(k, ws.db.revision())
    ws.name_facts.keep(f.index, out)
    out
}

/// A declaration's signature, computed on first ask: the ONE place
/// declaration order stops mattering — a sig asks the sigs it names
/// lazily through the table. A sig reached from inside its own
/// computation (a recursive payload re-judging its slots) is
/// simply not there yet.
export fn sig(ws: Workspace, d: DeclId) -> DeclSig? {
    let k = key(Family.Sig, d.index)
    let x = ws.decls.decl(d)
    // the language's own declarations were signed at admission
    if !(ws.db.ask(k) is .Compute) || x.kind is .Builtin {
        let held: DeclSig? = ws.decls.sigs[d.index]
        return held
    }
    ws.db.begin(k)
    let t = typer_for(ws, x)
    declare_one(t, x)
    ws.sig_voices.keep(d.index, t.facts.voices)
    let out: DeclSig? = ws.decls.sigs[d.index]
    ws.db.settle(k, sig_hash(out))
    out
}

/// A signature's fingerprint — interned type ids and member names,
/// so an unchanged sig cuts the wave at every caller.
fn sig_hash(s: DeclSig?) -> int {
    if s == null { return 0 }
    let f: FnSig? = fn_sig_of(s)
    if f != null { return fp(11, [t.index for t in [f!.ret].concat(f!.params)]) }
    let r: StructSig? = record_sig_of(s)
    if r != null { return fp(13, [t.index for t in r!.types].concat([fp_str(joined(r!.names, ","))])) }
    let v: EnumSig? = variant_sig_of(s)
    if v == null { return 1 }
    fp(5, [t.index for t in flatten(v!.payloads)].concat([fp_str(joined(v!.names, ","))]))
}

/// A type's method table, filled from its own members and every
/// impl block that names it — asked through the table's read, so a
/// body depends on exactly the impls it dispatches through. Asked
/// again from inside one of those impls' own registration, it
/// answers what stands.
export fn methods(ws: Workspace, target: DeclId) -> List<DeclId> {
    let blocks = ws.decls.children_of(target).concat(ws.decls.impls_named(ws.decls.decl(target).name))
    // asked while one of its impls registers: the table so far,
    // remembered by nobody
    if blocks.any(registering(ws, it)) { return ws.decls.methods_of(target) }
    let k = key(Family.Methods, target.index)
    if !(ws.db.ask(k) is .Compute) { return ws.decls.methods_of(target) }
    ws.db.begin(k)
    for b in blocks { touch(sig(ws, b)) }
    let out = ws.decls.methods_of(target)
    ws.method_clashes.keep(target.index, method_clashes(ws.decls, target))
    ws.db.settle(k, fp_str(joined([ws.decls.decl(m).name for m in out], ",")))
    out
}

/// Whether a declaration's signature is being computed right now.
fn registering(ws: Workspace, d: DeclId) -> bool {
    ws.db.active(key(Family.Sig, d.index))
}

/// A typer over one declaration's expression range, in its file.
fn typer_for(ws: Workspace, x: Decl) -> Typer {
    let p = parsed(ws, x.file)
    typer(ws.lang, file_view(ws.lang, p, ws.decls, x.file), resolved(ws, x.file), x.lo, x.hi)
}

/// One declaration's body typed — a table over its own expression
/// range, the sigs it names asked as it reads them.
export fn typed(ws: Workspace, d: DeclId) -> TypeFacts {
    let k = key(Family.Typed, d.index)
    if ws.db.ask(k) is .Reuse { return ws.decl_facts.at(d.index)! }
    ws.db.begin(k)
    let x = ws.decls.decl(d)
    let out = type_decl(typer_for(ws, x), x)
    ws.db.settle(k, ws.db.revision())
    ws.decl_facts.keep(d.index, out)
    out
}

/// A file's bodies as one table: Main's facts first (its range
/// spans the file), each declaration's laid over its own range,
/// their voices in source order — what the facade and lowering
/// read by expression.
export fn folded(ws: Workspace, f: FileId) -> TypeFacts {
    let k = key(Family.Folded, f.index)
    if ws.db.ask(k) is .Reuse { return ws.folds.at(f.index)! }
    ws.db.begin(k)
    let p = parsed(ws, f)
    let hole = ws.decls.types.intern(Type.Error)
    let out = new_type_facts(0, p.store.exprs.count(), p.store.stmts.count(), hole)
    mut spoken: List<Diag> = []
    for d in bodies_of(ws, f) {
        let facts = typed(ws, d)
        out.absorb(facts)
        spoken = spoken.concat(facts.voices.list)
    }
    let folded_facts = out with { voices: Voices { list: by_position(spoken) } }
    ws.db.settle(k, ws.db.revision())
    ws.folds.keep(f.index, folded_facts)
    folded_facts
}

/// A file's bodies to type: Main, then every declaration owning a
/// range, in declaration order.
fn bodies_of(ws: Workspace, f: FileId) -> List<DeclId> {
    some_list(ws.decls.main_of(f)).concat([d for d in ws.decls.decls_of_file(f) if ws.decls.owns_a_range(d)])
}

/// A file's signature diagnostics, in the order the rounds spoke
/// them: types, then traits' members, then fns, then impls.
fn sig_diagnostics(ws: Workspace, f: FileId) -> List<Diag> {
    let own = top_level_decls(ws, f)
    mut out: List<Diag> = []
    for rank in 0..4 {
        for d in own {
            if sig_rank(ws.decls, ws.decls.decl(d)) == rank {
                touch(sig(ws, d))
                let v: Voices? = ws.sig_voices.at(d.index)
                if v != null { out = out.concat(v!.list) }
            }
        }
    }
    out
}

fn sig_rank(decls: Decls, x: Decl) -> int {
    match x.kind {
        .Record or .Enum or .Builtin -> 0,
        .Method -> if x.parent != null && decls.decl(x.parent!).kind is .Trait { 1 } else { 3 },
        .Fn -> 2,
        .Impl -> 3,
        .Trait or .Default or .Main or .Case -> 4,
    }
}

/// The method-table clashes spoken in a file: every type's table
/// asked, the clashes whose later declaration lives here.
fn method_diagnostics(ws: Workspace, f: FileId) -> List<Diag> {
    mut out: List<Diag> = []
    for t in typed_decls(ws) {
        touch(methods(ws, t))
        let held: List<Clash> = ws.method_clashes.at(t.index) ?? []
        out = out.concat([c.diag for c in held if same_file(c.file, f)])
    }
    out
}

/// Every record and enum of the program, in id order.
fn typed_decls(ws: Workspace) -> List<DeclId> {
    [x.id for x in ws.decls.decls if is_type_decl(x)]
}

fn is_type_decl(x: Decl) -> bool {
    x.kind is .Record || x.kind is .Enum
}

/// One file's analysis: the snapshot every facade reads.
export fn analysis(ws: Workspace, f: FileId) -> Analysis {
    let k = key(Family.Analysis, f.index)
    if ws.db.ask(k) is .Reuse { return ws.analyses.at(f.index)! }
    ws.db.begin(k)
    let p = parsed(ws, f)
    let names = resolved(ws, f)
    let facts = folded(ws, f)
    let path = ws.decls.file(f).path
    let out = Analysis {
        view: file_view(ws.lang, p, ws.decls, f), names: names, facts: facts, lang: ws.lang,
        diagnostics: flatten([p.voices.list, names.voices.list, sig_diagnostics(ws, f), method_diagnostics(ws, f), facts.voices.list]),
        program: () -> program(ws, path),
    }
    ws.db.settle(k, ws.db.revision())
    ws.analyses.keep(f.index, out)
    out
}

/// A unit's identity: its symbol, interned.
fn spec_id(ws: Workspace, w: Wanted) -> int {
    let known: int? = ws.specs.get(w.name)
    if known != null { return known! }
    let id = ws.asks.length
    mut ss = ws.specs
    ss.set(w.name, id)
    mut as_ = ws.asks
    as_.push(w)
    id
}

/// The program's extern fns by symbol, gathered ONCE per run — every
/// file is admitted before the first unit lowers, and the emitters
/// asked per body where each walked every declaration.
fn extern_symbols(ws: Workspace) -> List<string> {
    let held: List<string>? = ws.externs.at(0)
    if held != null { return held! }
    let names = extern_names(ws.decls)
    ws.externs.keep(0, names)
    names
}

/// One unit lowered and remembered: a body edit re-lowers its own
/// unit; the specializations it wants are other units.
export fn lowered(ws: Workspace, id: int) -> Unit {
    let k = key(Family.Lowered, id)
    if ws.db.ask(k) is .Reuse { return ws.units.at(id)! }
    ws.db.begin(k)
    let w = ws.asks[id]
    let out = lower_unit(analysis(ws, w.file), extern_symbols(ws), w)
    ws.db.settle(k, ws.db.revision())
    ws.units.keep(id, out)
    out
}

// ── Modules ──

/// A path as a diagnostic shows it: under its package's source root.
fn shown(ws: Workspace, path: string) -> string {
    below(path, ws.packages[holder_of_path(ws, path)].src)
}

/// The module a file belongs to: its directory under its package's
/// source root, `.`-joined — "" for a file at the root package's
/// source root, `@scope.name.a` for a dependency's.
export fn module_of(ws: Workspace, path: string) -> string {
    let pkg = ws.packages[holder_of_path(ws, path)]
    let local = dir_of(below(path, pkg.src)).replace("/", ".")
    if pkg.ordinal == 0 { return local }
    if local.length == 0 { return key_spelled(pkg.key) }
    "${key_spelled(pkg.key)}.${local}"
}

/// A path's tail under a directory — the path itself when it is
/// not under it.
fn below(path: string, dir: string) -> string {
    if dir.length == 0 || !under_dir(path, dir) { return path }
    path.substring(dir.length + 1, path.length)
}

/// The files a module path names: a directory's `.av` files, else
/// the one file, else nothing (the module does not exist). A
/// directory holding its own `avra.toml` is a package, never a
/// module of the one above it.
export fn module_files(ws: Workspace, m: ModulePath) -> List<string> {
    let pkg: Package? = holder(ws, m)
    if pkg == null { return [] }
    let src = pkg!.src
    if crosses_package(ws, src, m.local()) { return [] }
    let dir = m.dir_under(src)
    if ws.host.is_dir(dir) {
        return [ joined_path(dir, f) for f in ws.host.list(dir) if listed_source(ws, dir, f) ]
    }
    let file = m.file_under(src)
    if ws.host.exists(file) { return [file] }
    []
}

/// Whether a path — a directory or a file — is one its package's
/// manifest EXCLUDES.
fn excluded(ws: Workspace, path: string) -> bool {
    let pkg = ws.packages[holder_of_path(ws, path)]
    manifest(ws, pkg.ordinal).excludes.any(under_dir(path, joined_path(pkg.root, it)) || path == joined_path(pkg.root, it))
}

/// A source file the package lists — `.av`, and not excluded.
fn listed_source(ws: Workspace, dir: string, f: string) -> bool {
    is_source(f, dir) && !excluded(ws, joined_path(dir, f))
}

/// Whether a directory is a package root of its own.
fn is_package_dir(ws: Workspace, dir: string) -> bool {
    ws.host.exists(joined_path(dir, "avra.toml"))
}

/// Whether a module path passes through a nested package — any
/// directory along it holding its own manifest.
fn crosses_package(ws: Workspace, src: string, local: List<string>) -> bool {
    mut j = 1
    while j <= local.length {
        if is_package_dir(ws, joined_path(src, joined(local.slice(0, j), "/"))) { return true }
        j = j + 1
    }
    false
}

/// A source file: `.av`, or anything at all under the empty root —
/// a lone file's package of one holds exactly what it was given.
fn is_source(name: string, dir: string) -> bool {
    name.ends_with(".av") || dir.length == 0
}

/// A file's declarations that speak for themselves — a NESTED one
/// (refused by its feature, or an orphan of a failed parse) is
/// asked only if a walk reaches it.
fn top_level_decls(ws: Workspace, f: FileId) -> List<DeclId> {
    [d for d in ws.decls.decls_of_file(f) if is_top_level(ws, d)]
}

fn is_top_level(ws: Workspace, d: DeclId) -> bool {
    !ws.decls.decl(d).nested
}

/// Every `.av` file under a directory, recursively, stopping at a
/// nested package — `check <root>`. The empty root is a lone file's
/// package of one: every name it was given is a file of it,
/// whatever the name.
export fn all_files(ws: Workspace, dir: string) -> List<string> {
    mut out: List<string> = []
    for f in ws.host.list(dir) {
        let full = joined_path(dir, f)
        if ws.host.is_dir(full) {
            if !is_package_dir(ws, full) && !excluded(ws, full) { out = out.concat(all_files(ws, full)) }
        } else if listed_source(ws, dir, f) {
            out.push(full)
        }
    }
    out
}

/// The root package's source files — what `check <root>` analyzes.
export fn root_files(ws: Workspace) -> List<string> {
    all_files(ws, ws.packages[0].src)
}

/// A module's exported declarations, in file and declaration order.
fn exported_decls(ws: Workspace, m: ModulePath) -> List<Decl> {
    [decl_at(ws, id) for id in flatten([items(ws, file_id(ws, f)) for f in module_files(ws, m)]) if is_exported(ws, id)]
}

fn is_exported(ws: Workspace, id: DeclId) -> bool {
    decl_at(ws, id).exported
}

/// A module's exported names.
export fn surface(ws: Workspace, m: ModulePath) -> Map<string, DeclId> {
    mut out: Map<string, DeclId> = {}
    for d in exported_decls(ws, m) { out.set(d.name, d.id) }
    out
}

fn use_lines(p: Parsed) -> List<UseParts> {
    mut out: List<UseParts> = []
    for s in p.stmts {
        let u: UseParts? = p.store.use_parts(s)
        if u != null { out.push(u!) }
    }
    out
}

/// What one `use` line brought in, and what it earned.
type Imported = { imports: List<Import>, diagnostics: List<Diag> }

/// One `use a.b.{x, y}`: a package root must exist, a named package
/// must be one the asking package's manifest declares, the module
/// must exist and be one thing, each item must be exported by it
/// and listed once.
fn imported_line(ws: Workspace, p: Parsed, u: UseParts) -> Imported {
    let at = loc_at(p.source.file, p.store.stmt_span(u.stmt))
    let from = ws.packages[holder_of_path(ws, p.source.file)]
    let m = qualified(module_path(u.path), from)
    if ws.lone { return Imported { imports: [], diagnostics: [unpackaged_use(at)] } }
    if m.malformed() { return Imported { imports: [], diagnostics: [package_form(at, m)] } }
    if m.package() != null && !reaches(ws, from, m.package()!) {
        return Imported { imports: [], diagnostics: [not_a_dependency(ws, at, from, m.package()!)] }
    }
    if ambiguous_module(ws, m) { return Imported { imports: [], diagnostics: [module_ambiguous(at, m)] } }
    if module_files(ws, m).is_empty() { return Imported { imports: [], diagnostics: [no_module(at, m)] } }
    let surf = surface(ws, m)
    mut imports: List<Import> = []
    mut diags: List<Diag> = []
    mut listed: List<string> = []
    for item in u.items {
        let id: DeclId? = surf.get(item)
        if listed.contains(item) {
            diags.push(listed_twice(at, item))
        } else if id == null {
            diags.push(not_exported(at, m, item, exported_names(ws, m)))
        } else {
            imports.push(Import { decl: id!, at: at })
        }
        listed.push(item)
    }
    Imported { imports: imports, diagnostics: diags }
}

/// A name that is both a directory and a file under the source root.
fn ambiguous_module(ws: Workspace, m: ModulePath) -> bool {
    let pkg: Package? = holder(ws, m)
    pkg != null && ws.host.is_dir(m.dir_under(pkg!.src)) && ws.host.exists(m.file_under(pkg!.src))
}

fn exported_names(ws: Workspace, m: ModulePath) -> List<string> {
    [d.name for d in exported_decls(ws, m)]
}

fn segments_of(dotted_text: string) -> List<string> {
    if dotted_text.length == 0 { return [] }
    dotted_text.split(".")
}

// ── The whole program ──

/// Every file under the root analyzed, in FileId order — each step
/// asked for every file before the next, so the phases time apart.
export fn analyze_all(ws: Workspace) -> List<Analysis> {
    let t0 = ws.clock()
    for path in root_files(ws) { let _ = items(ws, file_id(ws, path)) }
    ws.timed("parse", ws.clock() - t0)
    let t1 = ws.clock()
    for fi in ws.decls.files { let _ = resolved(ws, fi.id) }
    ws.timed("resolve", ws.clock() - t1)
    let t2 = ws.clock()
    for fi in ws.decls.files { let _ = sig_diagnostics(ws, fi.id) }
    ws.timed("sigs", ws.clock() - t2)
    let t3 = ws.clock()
    let out = [analysis(ws, fi.id) for fi in ws.decls.files]
    ws.timed("bodies", ws.clock() - t3)
    out
}

/// One file's analysis by path.
export fn analyze_file(ws: Workspace, path: string) -> Analysis {
    analysis(ws, file_id(ws, path))
}

/// A whole program: every file analyzed together, and the entry
/// among them (none when the program is only checked). It answers
/// as a lone Analysis does — report, lowered, run — so every engine
/// takes either.
export type Program = { ws: Workspace, files: List<Analysis>, entry: Entry?, phases: List<Phase>, cache: string, defects: List<Diag>, voices: List<Diag>, manifests: List<SourceFile> }

/// The entry's seat among the program's files.
type Entry = { at: int }

/// The program rooted at `ws.root`, entered at one of its files.
export fn program(ws: Workspace, entry: string?) -> Program {
    let files = analyze_all(ws)
    let at: int? = if entry == null { null } else { index_of_file(files, entry!) }
    let seat: Entry? = if at == null { null } else { Entry { at: at! } }
    Program {
        ws: ws, files: files, entry: seat, phases: ws.phases, cache: ws.db.stats(), defects: ws.defects,
        voices: package_voices(ws), manifests: [manifest_source(ws, pkg) for pkg in ws.packages if has_manifest(ws, pkg)],
    }
}

/// One test case as the runner sees it: the library's reference —
/// its three names and its place — and the symbol that runs it.
export type TestCase = { at: CaseRef, symbol: string }

/// The case in one line — what a listing prints, and what a test
/// of the listing reads.
export fn case_words(c: TestCase) -> string {
    words(c.at)
}

/// Every case of every file, in file and declaration order.
export fn cases(ws: Workspace) -> List<TestCase> {
    flatten([file_cases(ws, fi.id) for fi in ws.decls.files])
}

/// The cases of ONE file, named by the path it MEANS: both sides
/// normalized, so `./` and a doubled slash select what the listing
/// spelled cleanly.
export fn cases_at(ws: Workspace, path: string) -> List<TestCase> {
    let wanted = normalized(path)
    [c for c in cases(ws) if normalized(c.at.file) == wanted]
}

fn file_cases(ws: Workspace, f: FileId) -> List<TestCase> {
    let src = source(ws, f)
    let store = ws.decls.store_of(f)
    [test_case(ws, src, store, decl_at(ws, d)) for d in ws.decls.decls_of_file(f) if is_case(ws, d)]
}

fn is_case(ws: Workspace, d: DeclId) -> bool {
    decl_at(ws, d).kind is .Case
}

/// The case's group from its spec's own list — its body is the key
/// — and its line from the source.
fn test_case(ws: Workspace, src: SourceFile, store: NodeStore, x: Decl) -> TestCase {
    let parts: SpecParts? = store.spec_parts(x.stmt)
    let written: Case = parts!.cases.find(same_body(it, x.root!))!
    let lo = ws.decls.decl_span(x.id)!.lo
    TestCase {
        at: CaseRef { suite: x.owner, group: written.group, name: x.name, file: src.file, line: src.linecol(lo).line },
        symbol: ws.decls.symbol(x.id),
    }
}

fn same_body(c: Case, body: ExprId) -> bool {
    // LICENSED I9: node identity — ids compare by index
    c.body.index == body.index
}

/// WHAT THE PROGRAM LINKS: every package's `[link]` promise, in
/// package order — the objects it names (under its own root) and
/// the flags it asks for. A package that declares `extern fn` says
/// here who keeps the promise.
export fn link_inputs(ws: Workspace) -> List<string> {
    flatten([package_link(ws, pkg) for pkg in ws.packages])
}

fn package_link(ws: Workspace, pkg: Package) -> List<string> {
    let m = manifest(ws, pkg.ordinal)
    [joined_path(pkg.root, o) for o in m.objects].concat(m.flags)
}

/// THE PROMISES AS WORDS: every package's `[link]` row with its
/// `${NAME}` holes filled from the environment — one argv element
/// each, so no character in any of them means anything to a shell,
/// and a hole that names nothing leaves no empty word. The driver
/// puts them on clang's line.
export fn link_words(ws: Workspace) -> List<string> {
    let promised = [expanded(f) for f in link_inputs(ws)]
    [w for w in promised if w.length > 0]
}

/// A link input with its `${NAME}` holes filled from the
/// environment: a machine's own paths belong to the machine, not to
/// a checked-in manifest.
fn expanded(flag: string) -> string {
    let opens = flag.index_of("\${")
    if opens < 0 { return flag }
    let closes = closing_brace(flag, opens)
    if closes < opens { return flag }
    let head = flag.substring(0, opens)
    let name = flag.substring(opens + 2, closes)
    let tail = flag.substring(closes + 1, flag.length)
    expanded("${head}${avra_host_env(name)}${tail}")
}

/// Where the hole closes, or -1.
fn closing_brace(s: string, from: int) -> int {
    let at = s.substring(from, s.length).index_of("}")
    if at < 0 { return 0 - 1 }
    from + at
}

/// The root package's entry file: its `[bin]` path, else
/// `src/main.av` when that exists, else absence.
export fn entry_of(ws: Workspace) -> string? {
    let pkg = ws.packages[0]
    let bin: string? = manifest(ws, 0).bin
    let path = joined_path(pkg.root, bin ?? "src/main.av")
    if bin == null && !ws.host.exists(path) { return null }
    path
}

fn index_of_file(files: List<Analysis>, path: string) -> int? {
    for i, a in files {
        if a.view.source.file == path { return i }
    }
    null
}

fn unclean(a: Analysis) -> bool {
    !a.clean()
}

impl Program {
    /// The entry file's analysis — absent for a program only checked.
    fn entry_file() -> Analysis? {
        if self.entry == null { return null }
        self.files[self.entry!.at]
    }

    fn clean() -> bool { self.defects.is_empty() && !has_errors(self.voices) && !self.files.any(unclean(it)) }

    /// The packages' voices first (a manifest's trouble explains
    /// the rest), then every file's diagnostics, the workspace's
    /// defects last; "" means clean.
    fn report() -> string {
        let files = [a.report() for a in self.files if unclean(a)]
        let heads: List<string> = if self.voices.is_empty() { [] } else { [self.rendered(self.voices)] }
        let tails: List<string> = if self.defects.is_empty() { [] } else { [self.rendered(self.defects)] }
        joined(heads.concat(files).concat(tails), "\n\n")
    }

    /// Diagnostics rendered over every source — a frame's window
    /// comes from the file its Loc names, manifests included.
    fn rendered(ds: List<Diag>) -> string {
        let sources = self.manifests.concat([a.view.source for a in self.files])
        joined([render_among(d, self.ws.lang.rows.codes, sources) for d in ds], "\n\n")
    }

    /// The program as IR, memory strategy applied — every unit
    /// through the workspace's memo.
    fn lowered() -> Lowered { self.lowered_from(self.entry?.at, false) }

    /// The program lowered from `entry`: its main and what it
    /// reaches — or, with no entry, every declared body; `every`
    /// asks for every declared body under an entry too.
    fn lowered_from(entry: int?, every: bool) -> Lowered {
        let ws = self.ws
        memory(union(self.ws.decls, self.files, entry, every, (w: Wanted) -> lowered(ws, spec_id(ws, w))))
    }

    /// The lowered program, CHECKED — every file's analysis first,
    /// then lowering's own refusals.
    fn lowered_checked() -> Result<Lowered, string> { self.checked_from(self.entry?.at, false) }

    /// The program lowered for its cases, CHECKED: a case is a
    /// declaration nothing reaches, so every declared body lowers —
    /// under the entry's laws all the same.
    fn cases_checked() -> Result<Lowered, string> { self.checked_from(self.entry?.at, true) }

    fn checked_from(entry: int?, every: bool) -> Result<Lowered, string> {
        if !self.clean() { return .Err(self.report()) }
        let lo = self.lowered_from(entry, every)
        if !lo.diagnostics.is_empty() { return .Err(self.rendered(lo.diagnostics)) }
        .Ok(lo)
    }

    fn run() -> Result<string, string> {
        if self.entry == null { return .Err(self.rendered([no_target(self.ws.root)])) }
        run_lowered(self.lowered_checked()?)
    }

    /// Every test case the program declares.
    fn cases() -> List<TestCase> { cases(self.ws) }
    fn cases_at(path: string) -> List<TestCase> { cases_at(self.ws, path) }

    /// Everything wrong, rendered, as the refusal; or what merely
    /// warned, rendered, as the answer — "" when nothing spoke.
    fn check() -> Result<string, string> {
        if !self.clean() { return .Err(self.report()) }
        let lowered = self.lowered().diagnostics
        if has_errors(lowered) { return .Err(self.rendered(lowered)) }
        .Ok(self.warnings())
    }

    /// The warnings alone, rendered — what a clean program still
    /// says.
    fn warnings() -> string {
        let spoken = self.voices.concat(flatten([a.diagnostics for a in self.files]))
        self.rendered([d for d in spoken if is_warning(d)])
    }
}

fn is_warning(d: Diag) -> bool {
    !is_error(d)
}

// ── The packages ──

/// A package's manifest, read from its `avra.toml` — an INPUT: the
/// revision moves only when the text did. A root without a manifest
/// reads as an empty one, quietly.
export fn manifest(ws: Workspace, i: int) -> Manifest {
    let pkg = ws.packages[i]
    let path = joined_path(pkg.root, "avra.toml")
    let k = key(Family.Manifest, i)
    if !has_manifest(ws, pkg) {
        ws.db.set_input(k, 0)
        ws.db.record_dep(k)
        return Manifest { name: "", version: "", bin: null, lib: null, deps: [], deps_at: null, excludes: [], objects: [], flags: [], voices: [] }
    }
    let held: Manifest? = ws.manifests.at(i)
    if held != null {
        ws.db.record_dep(k)
        return held!
    }
    let text = ws.host.read(path)
    ws.db.set_input(k, fp_str(text))
    ws.db.record_dep(k)
    let m = read_manifest(new_source_file(path, text))
    ws.manifests.keep(i, m)
    m
}

fn has_manifest(ws: Workspace, pkg: Package) -> bool {
    ws.host.exists(joined_path(pkg.root, "avra.toml"))
}

fn manifest_source(ws: Workspace, pkg: Package) -> SourceFile {
    let path = joined_path(pkg.root, "avra.toml")
    new_source_file(path, ws.host.read(path))
}

/// The root package, then every path dependency reachable from its
/// manifest: each admitted once by key, each judged — the directory
/// holds a manifest, the manifest calls itself the keyed name, one
/// key is one directory, and no cycle closes.
fn load_packages(ws: Workspace, src: string) {
    mut ps = ws.packages
    let unnamed = Package { key: "", root: ws.root, src: src, ordinal: 0, at: null }
    ps.push(unnamed)
    let m = manifest(ws, 0)
    let named = unnamed with { key: m.name }
    ps.set(0, named)
    admit_dependencies(ws, 0, m, true, [m.name])
}

/// A package's dependencies admitted — tests' dependencies only for
/// the root, since they never travel.
fn admit_dependencies(ws: Workspace, i: int, m: Manifest, root: bool, chain: List<string>) {
    for d in m.deps {
        if !d.dev || root { admitted(ws, d.key, normalized(joined_path(ws.packages[i].root, d.path!)), d.at, chain) }
    }
}

fn admitted(ws: Workspace, key: string, dir: string, at: Loc?, chain: List<string>) {
    if chain.contains(key) { return speak_package(ws, dependency_cycle(at, chain.concat([key]))) }
    let known: Package? = ws.packages.find(it.key == key)
    if known != null {
        if known!.root != dir { speak_package(ws, duplicate_package(at, key, known!.root, dir)) }
        return
    }
    if !ws.host.exists(joined_path(dir, "avra.toml")) { return speak_package(ws, bad_dependency_path(at, key, dir)) }
    mut ps = ws.packages
    let i = ps.length
    let pkg = Package { key: key, root: dir, src: joined_path(dir, "src"), ordinal: i, at: at }
    ps.push(pkg)
    let m = manifest(ws, i)
    if m.name != key { speak_package(ws, name_mismatch(at, key, m.name, dir)) }
    admit_dependencies(ws, i, m, false, chain.concat([key]))
}

fn speak_package(ws: Workspace, d: Diag) {
    mut vs = ws.package_voices
    vs.push(d)
}

/// Everything the packages said: each manifest's own voices, then
/// the graph's.
fn package_voices(ws: Workspace) -> List<Diag> {
    flatten([manifest(ws, pkg.ordinal).voices for pkg in ws.packages]).concat(ws.package_voices)
}

/// The package a file belongs to — the one whose source root holds
/// it, the deepest when nested; the root package otherwise.
fn holder_of_path(ws: Workspace, path: string) -> int {
    // the DEEPEST package whose source root holds the path — a
    // nested package wins over the one around it; a path no package
    // holds is the root's (a lone file)
    // LICENSED I4: a max-by fold (the deepest holder), not a scan
    mut best: int? = null
    for pkg in ws.packages {
        if under_dir(path, pkg.src) && (best == null || pkg.src.length > ws.packages[best!].src.length) { best = pkg.ordinal }
    }
    best ?? 0
}

/// The package a module path names: the root package for a local
/// path, a dependency by key, absence when no package has the key.
fn holder(ws: Workspace, m: ModulePath) -> Package? {
    let k: string? = m.package()
    if k == null { return ws.packages[0] }
    let found: Package? = ws.packages.find(it.key == k!)
    found
}

/// A package reaches itself — its own files `use` it by name — and
/// every package its manifest declares.
fn reaches(ws: Workspace, from: Package, k: string) -> bool {
    k == from.key || depends_on(ws, from, k)
}

/// A module path as the whole workspace names it: a dependency's
/// own local path carries its package's head, so `use core.{…}`
/// inside `@std/avrac` names `@std.avrac.core` from anywhere.
fn qualified(m: ModulePath, from: Package) -> ModulePath {
    if m.packaged() || from.ordinal == 0 { return m }
    ModulePath { segments: key_spelled(from.key).split(".").concat(m.segments) }
}

/// Whether a package's manifest declares the key.
fn depends_on(ws: Workspace, from: Package, k: string) -> bool {
    manifest(ws, from.ordinal).deps.any(it.key == k)
}

/// The dependency line a manifest lacks, as a structured fix when
/// the package is already in the workspace (reached through
/// another package's manifest): the path relative to the asking
/// package's root after its last dependency.
fn dependency_fix(ws: Workspace, from: Package, k: string) -> List<Suggestion> {
    let known: Package? = ws.packages.find(it.key == k)
    if known == null { return [] }
    let m = manifest(ws, from.ordinal)
    let line = "\"${k}\" = { path = \"${relative_path(from.root, known!.root)}\" }"
    let manifest_path = joined_path(from.root, "avra.toml")
    let text = if m.deps_at == null { "\n[dependencies]\n${line}\n" } else { "\n${line}" }
    let at = deps_offset(m) ?? ws.host.read(manifest_path).length
    [Suggestion { confidence: Confidence.High, description: "add `${line}` under `[dependencies]` in `${manifest_path}`", edits: [Edit { loc: Loc { file: manifest_path, lo: at, hi: at }, replacement: text }] }]
}

// ── voices ──

fn not_a_dependency(ws: Workspace, at: Loc?, from: Package, k: string) -> Diag {
    let fixes = dependency_fix(ws, from, k)
    let at_file = joined_path(from.root, "avra.toml")
    refusal("resolve.not_a_dependency", at, "`${k}` is not a dependency of this package", "in this use", "declare it under `[dependencies]` in `${at_file}` — `\"${k}\" = { path = \"…\" }`") with { suggestions: fixes }
}

fn package_form(at: Loc?, m: ModulePath) -> Diag {
    refusal("resolve.package_form", at, "`${m.text()}` names no package — a package is `@scope.name`", "in this use", "write the scope and the name, then the module: `@scope.name.a.{x}`")
}

fn no_module(at: Loc?, m: ModulePath) -> Diag {
    refusal("resolve.no_module", at, "no module `${m.text()}` under the package's source root", "in this use", "a module is a directory of `.av` files or one `.av` file, named from `src/` — `${m.dir_under("")}` was looked for")
}

fn not_exported(at: Loc?, m: ModulePath, item: string, exports: List<string>) -> Diag {
    refusal("resolve.not_exported", at, "`${m.text()}` does not export `${item}`", "in this use", "its exports: ${joined(exports, ", ")}")
}

fn module_ambiguous(at: Loc?, m: ModulePath) -> Diag {
    refusal("resolve.module_ambiguous", at, "`${m.text()}` is both a directory and a file under the root", "in this use", "a module is one or the other — keep `${m.dir_under("")}/` or `${m.dir_under("")}.av`")
}


fn listed_twice(at: Loc?, item: string) -> Diag {
    refusal("resolve.import_clash", at, "`${item}` is listed twice", "in this use", null)
}

fn unpackaged_use(at: Loc?) -> Diag {
    refusal("resolve.unpackaged", at, "this file is not in a package — `use` needs a root", "this use", "put an `avra.toml` at the package root, with this file under its `src/` — modules are named from there")
}
