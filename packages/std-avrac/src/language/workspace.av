//! THE WORKSPACE — many files, one program, driven by the query
//! kernel. Every step is a family of queries: `source`, `parsed`,
//! `items` by FileId; `namespace` by ModuleId; `visible`, `resolved`
//! by FileId; `sig`, `methods`, `typed` by DeclId; `folded` and
//! `analysis` by FileId; `lowered` by unit. A declaration's
//! signature and a type's method table are asked LAZILY — the
//! table's own reads are the queries, armed here — so declaration
//! order stops mattering, a cycle speaks, and a body depends on
//! exactly what it read. `program` composes the files for lowering.
//! The host is a record of fns, so tests hand in memory and the CLI
//! hands in the disk. A workspace holds PACKAGES: the root's (its
//! `avra.toml`, or none) and, transitively, every path dependency a
//! manifest names; each is its own module tree under its `src/`,
//! and a `use @scope.name.a` reaches a dependency's module only when
//! the asking package's manifest declares it. A lone file is a
//! package of one rooted at its directory.
use core.{Table, new_table, Expr, StmtId, Span, Param, Variant, Mark, same_stmt, same_decl, TypeRegistry, NodeStore, ModulePath, module_path, key_spelled, DeclId, FileId, ModuleId, UseParts, ExprId, Case, fp, fp_list, fp_str, joined, flatten, sorted_texts, TypeId, Type, some_list, same_file, touch, SpecParts, FnParts, TypeRef, source_spelled, Annotation, Binding, named_ref, spelled, user_kind, is_user_kind, is_kind_word, Scoped}
use @std.path.{dir_of, head_segment, under_dir, joined_path, normalized, relative_path}
use features.{Unsettled, unsettled_label, Settled, Settlement, const_symbol, expr_symbol, MetaVal, MetaHeap, new_meta_heap, TypeCx, Decls, new_decls, kind_word, Decl, Namespace, Import, ModuleNames, Clash, NameFacts, TypeFacts, new_type_facts, DeclSig, FnSig, StructSig, EnumSig, Wanted, nothing, FileView, spelled_type, Lifted, DeclareWork, bound_decl_of, SeatValue, settled_symbol, Generation, ArenaMarks, quote_meta, Elsewhere, SettleRoot, Budgets, budgets_of, BlockGrammar}
use features.{meta_of_fn, meta_of_type, meta_of_named, meta_of_trait, kind_of, no_kind}
use @std.meta.{Diagnostic, Directive, Node, Fn as MetaFn, Type as MetaType, Named, Trait as MetaTrait, Param as MetaParam, Field as MetaField, Variant as MetaVariant, Mark as MetaMark, Decls as MetaDecls, Kind}
use core.{Stmt, StmtId, Arm, BodyParts, BodyView, HoleKind, Filled, Unplaced, copier, quote_kind, all_codes, is_name_cont, SyntaxParts, ForeignRange}
use grammar.{parse_grammar, ready}
use diagnostics.{defect_at}
use diagnostics.{SourceFile, new_source_file, Diag, Voices, no_voices, error_at, loc_at, render_among, refusal, by_position, has_errors, is_error, user_code, DiagCode}
use query.{Db, new_db, Key, Memo, Loaded, new_memo}
use core.{debug}
use @std.errors.{Loc, Suggestion, Edit, Confidence}
use @std.testing.{CaseRef, words}

/// The host's environment — what a `${NAME}` hole in a link row fills from.
extern fn avra_host_env(name: string) -> string

/// The filesystem, as four questions.
export type Host = { exists: fn(string) -> bool, read: fn(string) -> string, write: fn(string, string) -> string?, list: fn(string) -> List<string>, is_dir: fn(string) -> bool, std_root: string? = null, cwd: string = "" }

impl Host {
    /// One spelling for one directory: a relative path rooted at the
    /// host's cwd, normalized — the identity two package roots are
    /// compared by, never the strings as typed.
    fn absolute(path: string) -> string {
        normalized(joined_path(self.cwd, path))
    }

    /// The directory the toolchain's copy of a std package would
    /// stand in, when the host names a std root: `@std/text` is
    /// `<std_root>/std-text`.
    fn std_dir(key: string) -> string? {
        let root? = self.std_root else { return null }
        if !key.starts_with("@std/") { return null }
        joined_path(root, key.substring(1, key.length).replace("/", "-"))
    }
}

/// A host over an in-memory file table — the tests' host, and a
/// lone file's.
export fn memory_host(files: Map<string, string>, names: List<string>) -> Host {
    memory_host_at(files, names, "")
}

/// An in-memory host standing in a directory: a relative path is
/// looked up under `cwd`, as the disk would.
export fn memory_host_at(files: Map<string, string>, names: List<string>, cwd: string) -> Host {
    let held = Cell.new(files)
    Host {
        exists: (p: string) -> held.get().get(normalized(joined_path(cwd, p))) != null,
        read: (p: string) -> held.get().get(normalized(joined_path(cwd, p))) ?? "",
        write: (p: string, text: string) -> memory_put(held, normalized(joined_path(cwd, p)), text),
        list: (dir: string) -> children_of(names, normalized(joined_path(cwd, dir))),
        is_dir: (dir: string) -> names.any(under_dir(it, normalized(joined_path(cwd, dir)))),
        cwd: cwd,
    }
}

/// A write through the in-memory table — a named fn because the field's answer is
/// `string?` and a lambda ending in `null` answers `null` alone.
fn memory_put(held: Cell<Map<string, string>>, path: string, text: string) -> string? {
    mut files = held.get()
    files.set(path, text)
    held.set(files)
    null
}

/// The direct children of `dir` among `names` — the base names, in
/// byte order like the disk host's.
fn children_of(names: List<string>, dir: string) -> List<string> {
    mut out: List<string> = []
    for n in names {
        if under_dir(n, dir) {
            let rest = if dir.is_empty() { n } else { n.substring(dir.length + 1, n.length) }
            let child = head_segment(rest)
            if !child.is_empty() && !out.contains(child) { out.push(child) }
        }
    }
    sorted_texts(out)
}

/// Method clashes grouped in one pass, then read by the losing file.
/// A new revision or declaration invalidates the grouping.
type MethodDiagIndex = { revision: int, decl_count: int, by_file: List<List<Diag>> }

/// The families' value tables, sparse by their keys and grown as
/// values are placed; `sigs` and `methods` live in the declaration
/// table itself.
export type Workspace = {
    host: Host,
    root: string,
    lang: Language,
    db: Db,
    decls: Decls,
    // ONE RUN'S VIEW of each file and each manifest: read,
    // fingerprinted and indexed once. A host that changes under a
    // running workspace (Era IV's live editing) invalidates these
    // with the revision; today no host does.
    sources: Memo<SourceFile>,
    manifests: Memo<Manifest>,
    // the program's extern symbols, gathered once at the first
    // lowering (index 0)
    externs: Table<List<string>>,
    programs: Memo<Parsed>,
    plain: Memo<Parsed>,
    file_items: Memo<List<DeclId>>,
    module_names: Memo<ModuleNames>,
    visibles: Memo<Namespace>,
    name_facts: Memo<NameFacts>,
    sig_voices: Table<Voices>,
    decl_facts: Memo<TypeFacts>,
    const_type_facts: Memo<TypeId>,
    method_clashes: Table<List<Clash>>,
    method_diags: List<MethodDiagIndex>,
    folds: Memo<TypeFacts>,
    analyses: Memo<Analysis>,
    specs: Map<string, int>,
    asks: List<Wanted>,
    units: Memo<Unit>,
    lift_specs: Map<string, int>,
    lift_asks: List<LiftAsk>,
    lift_results: Memo<LiftResult>,
    generated: Memo<List<DeclId>>,
    settle_specs: Map<string, int>,
    settle_asks: List<SettleAsk>,
    settlements: Memo<Settlement>,
    loaded_records: Map<string, bool>,
    /// THE MODULES A HELD LOAD TOUCHED, in order — phase one mints and INTERNS every name;
    /// phase two FILLS every shape. A mutual import (language <-> features <-> core) is a
    /// cycle, and one module's shapes cannot be filled until every other module's NAMES are
    /// interned, so the two passes must be GLOBAL, not per module.
    held_order: List<ModulePath>,
    defects: List<Diag>,
    packages: List<Package>,
    package_voices: List<Diag>,
    lone: bool,
    // a directory of programs: every file its own module
    per_file: bool,
    // one-shot, its captures ended: nothing it hands out is kept
    closed: bool,
    clock: fn() -> int,
    phases: List<Phase>,
}

/// One annotation query's stable inputs. Its dense list position is
/// the `Lifted` family's key; the call expression mints that identity.
type LiftAsk = { decl: DeclId, file: FileId, stmt: StmtId, args: List<ExprId> }

/// A const site's stable inputs. The dense list position is the
/// `Settled` family's key; its initializer is read inside the query.
type SettleAsk = { file: FileId, root: SettleRoot, name: string, seats: List<SeatValue> }

/// The const a settlement is for — none for an expression's.
fn const_stmt(root: SettleRoot) -> StmtId? {
    match root {
        .Const(s) -> s,
        .Expr(_) -> null,
    }
}

fn lift_ask(d: DeclId, f: FileId, s: StmtId, args: List<ExprId>) -> LiftAsk {
    LiftAsk { decl: d, file: f, stmt: s, args: args }
}

/// The query family's held value. A refusal remains here in full so a
/// new revision can compare it, while a repeated read speaks nothing.
/// The query family's held value. A refusal remains here in full so a
/// new revision can compare it, while a repeated read speaks nothing.
/// A SUCCESS holds the crossing itself — saids and the materializer
/// read the same rows through the field protocol.
enum LiftResult { Crossed(Lifted), Refused(Unsettled) }

fn reused_lift(held: LiftResult) -> Result<Lifted, Unsettled> {
    match held {
        .Crossed(crossed) -> .Ok(crossed),
        .Refused(_) -> .Err(Unsettled.Spoken),
    }
}

fn reused_settlement(held: Settlement) -> Result<Settled, Unsettled> {
    match held {
        .Held(value) -> .Ok(value),
        .Refused(_) -> .Err(Unsettled.Spoken),
    }
}

/// One package of the workspace: its key (the manifest's name; ""
/// for a root without one), its root and source directories, its
/// ordinal (the manifest query's key), and where it was named —
/// absent for the root.
export type Package = { key: string, root: string, src: string, ordinal: int, at: Loc?, origin: Origin }

/// How a package entered the workspace: the root it was opened at, a
/// manifest row (`at` is that row), or the toolchain's std root.
export enum Origin {
    Root
    Declared
    Toolchain
}

/// One timed phase, in nanoseconds of the workspace's clock.
export type Phase = { name: string, ns: int }

/// THE FAMILIES — the compiler's query vocabulary, in pipeline
/// order. Keys by FileId (`Source` … `Resolved`, `Folded`,
/// `Analysis`), ModuleId (`Namespace`), DeclId (`Sig`, `Methods`,
/// `Typed`), unit (`Lowered`) or annotation call (`Lifted`). `ordinal` is the kernel's number
/// for each; `refetched` re-asks any of them — both exhaustive, so
/// a new family cannot ship half-registered.
enum Family {
    Source
    Parsed
    Items
    Namespace
    Visible
    Resolved
    Sig
    Methods
    Typed
    ConstTyped
    Folded
    Analysis
    Settled
    Lowered
    Lifted
    Manifest
    Receivers
    Expanded
    /// a file parsed under NO sublanguage words — what the block
    /// pre-scan reads of a provider, depending on its source alone
    Plain
}

fn key(f: Family, arg: int) -> Key {
    Key { family: ordinal(f), arg: arg }
}

fn ordinal(f: Family) -> int {
    match f {
        .Source -> 0,
        .Parsed -> 1,
        .Items -> 2,
        .Namespace -> 3,
        .Visible -> 4,
        .Resolved -> 5,
        .Sig -> 6,
        .Methods -> 7,
        .Typed -> 8,
        .ConstTyped -> 9,
        .Folded -> 10,
        .Analysis -> 11,
        .Settled -> 12,
        .Lowered -> 13,
        .Lifted -> 14,
        .Manifest -> 15,
        .Receivers -> 16,
        .Expanded -> 17,
        .Plain -> 18,
    }
}

/// The families in ordinal order — the kernel registers them so.
fn families() -> List<Family> {
    let all: List<Family> = [Family.Source, Family.Parsed, Family.Items, Family.Namespace, Family.Visible, Family.Resolved,
                             Family.Sig, Family.Methods, Family.Typed, Family.ConstTyped, Family.Folded, Family.Analysis, Family.Settled, Family.Lowered, Family.Lifted, Family.Manifest,
                             Family.Receivers, Family.Expanded, Family.Plain]
    all
}

export fn new_workspace(host: Host, root: string, lang: Language) -> Workspace {
    timed_workspace(host, root, lang, () -> 0)
}

/// A lone file as a package of one: a memory host holding just it,
/// rooted at its directory — root and source root alike — with no
/// modules to import from.
export fn lone_workspace(path: string, text: string, lang: Language) -> Workspace {
    mut files: Map<string, string> = {}
    files.set(path, text)
    built(memory_host(files, [path]), dir_of(path), dir_of(path), lang, () -> 0, true, false)
}

/// A workspace that times its phases by the given clock (nanoseconds).
export fn timed_workspace(host: Host, root: string, lang: Language, clock: fn() -> int) -> Workspace {
    built(host, root, joined_path(root, "src"), lang, clock, false, false)
}

/// A DIRECTORY OF PROGRAMS as one workspace: root and source root
/// alike, every `.av` under it a module — a program test's own root,
/// where a package's sources would sit under `src/`.
export fn programs_workspace(host: Host, dir: string, lang: Language, clock: fn() -> int) -> Workspace {
    built(host, dir, dir, lang, clock, false, true)
}

/// The declaration table with the language's own declarations in it.
fn language_decls(lang: Language) -> Decls {
    mut decls = new_decls() with { rows: lang.rows.types }
    decls.admit_builtins()
    decls
}

/// The workspace with its families registered, its table armed,
/// and its packages loaded from the root's manifest outward.
fn built(host: Host, root: string, src: string, lang: Language, clock: fn() -> int, lone: bool, per_file: bool) -> Workspace {
    let db = new_db()
    mut ws = Workspace {
        host: host, root: root, lang: lang, db: db, decls: language_decls(lang),
        sources: new_memo<SourceFile>(db, ordinal(Family.Source)), manifests: new_memo<Manifest>(db, ordinal(Family.Manifest)), externs: new_table(),
        programs: new_memo<Parsed>(db, ordinal(Family.Parsed)),
        plain: new_memo<Parsed>(db, ordinal(Family.Plain)),
        file_items: new_memo<List<DeclId>>(db, ordinal(Family.Items)),
        module_names: new_memo<ModuleNames>(db, ordinal(Family.Namespace)),
        visibles: new_memo<Namespace>(db, ordinal(Family.Visible)),
        name_facts: new_memo<NameFacts>(db, ordinal(Family.Resolved)), sig_voices: new_table(),
        decl_facts: new_memo<TypeFacts>(db, ordinal(Family.Typed)), const_type_facts: new_memo<TypeId>(db, ordinal(Family.ConstTyped)), method_clashes: new_table(), method_diags: [],
        folds: new_memo<TypeFacts>(db, ordinal(Family.Folded)),
        analyses: new_memo<Analysis>(db, ordinal(Family.Analysis)), units: new_memo<Unit>(db, ordinal(Family.Lowered)), specs: {}, asks: [],
        lift_specs: {}, lift_asks: [], lift_results: new_memo<LiftResult>(db, ordinal(Family.Lifted)),
        generated: new_memo<List<DeclId>>(db, ordinal(Family.Expanded)),
        settle_specs: {}, settle_asks: [], settlements: new_memo<Settlement>(db, ordinal(Family.Settled)), loaded_records: {}, held_order: [], defects: [],
        packages: [], package_voices: [], lone: lone, per_file: per_file, closed: false,
        clock: clock, phases: [],
    }
    for f in families() {
        if ws.db.family((arg: int) -> ws.refetched(f, arg)) != ordinal(f) { ws.defect("defect: the families registered out of ordinal order") }
    }
    // the table's reads ARE the queries
    ws.decls.arm((d: DeclId) -> ws.ensured(d))
    ws.decls.arm_store((f: FileId) -> ws.store_ensured(f))
    ws.decls.arm_const((f: FileId, s: StmtId) -> ws.const_type_ensured(f, s))
    ws.decls.arm_methods((d: DeclId) -> ws.methods_ensured(d))
    ws.decls.arm_writes((d: DeclId) -> ws.writes_ensured())
    ws.decls.arm_marks((d: DeclId) -> ws.marks_ensured(d))
    let lift: fn(DeclId, FileId, StmtId, ExprId, List<ExprId>) -> Result<Lifted, Unsettled> = (d: DeclId, f: FileId, s: StmtId, call: ExprId, args: List<ExprId>) -> ws.lifted(d, f, s, call, args)
    ws.decls.arm_lifter(lift)
    ws.load_packages(src)
    ws
}

impl Workspace {
    /// A ONE-SHOT WORKSPACE ENDS ITS OWN CYCLE: the families and the
    /// table's hooks capture `ws`, so `ws` could never die — 1674 spec
    /// cases kept 1674 workspaces, 922 MB. Once the analysis it was made
    /// for has run, nothing re-verifies (the revision never moves) and
    /// every sig it will ask for is held, so the captures go; the
    /// workspace then dies with its last holder.
    mut fn disarmed() {
        // An Analysis holds the program closure back to this workspace.
        // Evict its typed values and kernel cells as one operation.
        self.analyses.evict()
        self.db.disarm()
        self.decls.disarm()
        self.closed = true
    }

    fn ensured(d: DeclId) {
        let _ = self.sig(d)
    }

    /// A held declaration may need syntax-only facts that were not part of
    /// its signature. Parse that file on first such read; the declaration
    /// identities and object reuse still come from the stored interface.
    fn store_ensured(f: FileId) {
        self.decls.remember_store(f, self.parsed(f).store)
    }

    fn methods_ensured(d: DeclId) {
        let _ = self.methods(d)
    }

    fn const_type_ensured(f: FileId, s: StmtId) -> bool { self.const_type_at(self.settle_id(f, SettleRoot.Const(s), [])) }

    fn writes_ensured() {
        let _ = self.receivers()
    }

    fn marks_ensured(d: DeclId) {
        let _ = self.computed_marks(d)
    }

    /// A declaration's use-site warnings: each `List<Diagnostic>`
    /// annotation run and its WARNINGS kept (errors speak at the
    /// declaration). Runs inside the armed hook, so a use finds a
    /// later declaration's warnings however the files are ordered.
    fn computed_marks(d: DeclId) -> List<Diagnostic> {
        let x = self.decls.decl(d)
        // A HELD DECLARATION WITH NO ANNOTATIONS HAS NO WARNINGS, and asking must not
        // PARSE its file to learn that: the fact was captured once, at admission. This is
        // the door that made typing an entry re-parse every held fn it calls.
        if self.is_held(x.file) && !(self.decls.facts_of(d)?.annotated ?? false) {
            self.decls.record_marks(d, [])
            return []
        }
        let p = self.parsed(x.file)
        // A builtin or synthetic declaration has no statement record;
        // nothing annotates it, so there is nothing to keep.
        if x.stmt.index >= p.store.annotations.length { return [] }
        let vis = self.visible(x.file)
        let out = flatten([self.annotation_warnings(x, p, vis, a) for a in p.store.annotations_of(x.stmt)])
        self.decls.record_marks(d, out)
        out
    }

    /// One annotation's WARNING diagnostics, empty for an annotation
    /// that answers something other than `List<Diagnostic>`.
    fn annotation_warnings(x: Decl, p: Parsed, vis: Namespace, a: Annotation) -> List<Diagnostic> {
        let found: DeclId? = self.named_arg(p, vis, a.callee)
        if found == null { return [] }
        let callee = found!
        let sig: FnSig? = (self.decls.sig(callee))?.fn_sig()
        if sig == null { return [] }
        let s = sig!
        if s.params.is_empty() { return [] }
        let elem: TypeId? = elem_of(self.decls.types, s.ret)
        if elem == null { return [] }
        if !self.decls.meta_type(elem!, "Diagnostic") { return [] }
        // a warning's kind wears the annotation fn's package here, where
        // that fn is known; a use speaks it under that kind
        match self.lifted(callee, x.file, x.stmt, a.callee, a.args) {
            .Ok(crossed) -> [w with { kind: worded_kind(self.decls.package_of(callee), w.kind) } for w in crossed.saids() if w.warning],
            .Err(_) -> [],
        }
    }

    /// The kernel's verifier for every family: the key re-asked through
    /// its own query, then the cell's changed_at.
    fn refetched(f: Family, arg: int) -> int {
        match f {
            .Source -> touch(self.source(file_at(arg))),
            .Parsed -> touch(self.parsed(file_at(arg))),
            .Items -> touch(self.items(file_at(arg))),
            .Namespace -> touch(self.namespace(module_at(arg))),
            .Visible -> touch(self.visible(file_at(arg))),
            .Resolved -> touch(self.resolved(file_at(arg))),
            .Sig -> touch(self.sig(decl_at_arg(arg))),
            .Methods -> touch(self.methods(decl_at_arg(arg))),
            .Typed -> touch(self.typed(decl_at_arg(arg))),
            .ConstTyped -> touch(self.const_type_at(arg)),
            .Folded -> touch(self.folded(file_at(arg))),
            .Analysis -> touch(self.analysis(file_at(arg))),
            .Settled -> touch(self.settled_at(arg)),
            .Lowered -> touch(self.lowered(arg)),
            .Lifted -> touch(self.lifted_at(arg)),
            .Manifest -> touch(self.manifest(arg)),
            .Receivers -> touch(self.receivers()),
            .Expanded -> touch(self.expanded(file_at(arg))),
            .Plain -> touch(self.plain_parsed(file_at(arg))),
        }
        self.db.changed_at(key(f, arg))
    }

    fn timed(name: string, ns: int) {
        self.phases.push(Phase { name: name, ns: ns })
    }

    fn defect(message: string) {
        self.defects.push(error_at("language.defect", null, message))
    }

    // ── The families ──
    /// A path's identity — the table mints it at first mention.
    fn file_id(path: string) -> FileId {
        self.decls.file_id(path, self.module_of(path))
    }

    /// THE FILE AS WRITTEN, canonically printed — from a PARSE, never
    /// an analysis.
    ///
    /// FORMATTING MOVES NO TOKEN THAT TYPING DECIDES, so a formatter
    /// that waits for a package to type is paying for an answer it
    /// never reads: one file cost 2.5 MINUTES through the analyzed
    /// path (`entry_file` forces the whole package) and milliseconds
    /// through this one. It is also what makes the tree-wide receipt
    /// possible at all — `fmt(x) == x` over every file is minutes, not
    /// days.
    ///
    /// It renders the file AS WRITTEN and never the EXPANDED source: a
    /// generated declaration is the COMPILER's, and writing one back
    /// would make it the author's, to be expanded again next build.
    ///
    /// AND IT REFUSES A FILE WITH PARSE ERRORS. The parser is
    /// error-tolerant, so a broken file still answers a tree with
    /// HOLES, and rendering it puts those regions back as nothing —
    /// deleting exactly what the author most wants kept. TYPE errors
    /// are no bar: a formatter is most wanted on code that does not
    /// check yet.
    fn formatted_source(f: FileId) -> Result<string, string> {
        let parsed = self.parsed(f)
        if !has_errors(parsed.voices.list) { return .Ok(render_source_of(parsed.store, parsed.stmts, self.source(f).text)) }
        .Err(joined([render_among(d, self.lang.rows.codes, [self.source(f)]) for d in parsed.voices.list], "\n\n"))
    }

    /// An INPUT: the file's text, hashed; the revision moves only when
    /// the text did.
    fn source(f: FileId) -> SourceFile {
        self.sources.input(f.index, () -> {
            let path = self.decls.file(f).path
            new_source_file(path, self.host.read(path))
        }, (src: SourceFile) -> fp_str(src.text))
    }

    /// The file parsed — pure in its text.
    /// A file parsed — under the sublanguages it imports: a first parse
    /// names its `use` items, and a file that imports a named grammar
    /// is parsed again with those words as block words and their
    /// grammars readied, so every block expands at the parse. The
    /// hash folds the words in, so a dependency's grammar appearing
    /// re-parses; the nodes a block's actions minted wear the
    /// library's origin.
    fn parsed(f: FileId) -> Parsed {
        self.programs.demand(f.index,
            () -> self.parsed_under_blocks(f),
            (p: Parsed) -> fp(121, [program_hash(p), fp_str(joined(sorted_texts(p.store.sublang_words()), ","))]))
    }

    /// A file parsed under NO block words — its own words alone. The
    /// block pre-scan reads a provider through this, so a file's parse
    /// never depends on a provider's parse depending back on it (two
    /// files importing each other were a memo cycle otherwise).
    fn plain_parsed(f: FileId) -> Parsed {
        self.plain.demand(f.index,
            () -> parse_program(self.lang, self.source(f), []),
            (p: Parsed) -> program_hash(p))
    }

    fn parsed_under_blocks(f: FileId) -> Parsed {
        let first = self.plain_parsed(f)
        let blocks = self.block_grammars(f, first)
        if blocks.is_empty() { return first }
        let p = parse_program(self.lang, self.source(f), blocks)
        for r in p.store.foreign {
            let origin = self.file_id(r.path)
            if !same_file(origin, f) { self.decls.note_origins(f, [ExprId { index: i } for i in r.lo..r.hi], [], [], origin) }
        }
        p
    }

    /// The sublanguages a file's `use` lines bring in: each item that a
    /// provider module declares as a named grammar, readied, under its
    /// alias. A module's own grammars are not block words in its own
    /// files.
    fn block_grammars(f: FileId, p: Parsed) -> List<BlockGrammar> {
        if self.lone { return [] }
        let from = self.packages[self.holder_of_path(p.source.file)]
        let own = self.decls.module_name(self.decls.file(f).module_id)
        flatten([self.line_grammars(from, own, u) for u in use_lines(p)])
    }

    /// One `use` line's sublanguages — none from a module that is not
    /// reachable, ambiguous, absent, or the file's own. A provider is
    /// read through its PLAIN parse: an exported named grammar whose
    /// name the line imports.
    fn line_grammars(from: Package, own: string, u: UseParts) -> List<BlockGrammar> {
        let m = qualified(module_path(u.path), from)
        if m.malformed() || m.text() == own { return [] }
        if m.package() != null && !self.reaches(from, m.package()!) { return [] }
        if self.ambiguous_module(m) || self.module_files(m).is_empty() { return [] }
        let declared = flatten([self.plain_grammars(path) for path in self.module_files(m)])
        mut blocks: List<BlockGrammar> = []
        for j, item in u.items {
            let alias = if j < u.aliases.length { u.aliases[j] } else { "" }
            let found: BlockGrammar? = declared.find((g: BlockGrammar) -> g.word == item)
            if found != null { blocks.push(found! with { word: if alias.is_empty() { item } else { alias } }) }
        }
        blocks
    }

    /// The exported named grammars a provider file declares, readied,
    /// each under its own name; one whose notation does not parse is
    /// left out (the library speaks).
    fn plain_grammars(path: string) -> List<BlockGrammar> {
        let p = self.plain_parsed(self.file_id(path))
        flatten([some_list(readied_grammar(p, s, path)) for s in p.stmts if p.store.is_exported(s)])
    }

    /// The declarations a file MINTS into the one table; the answer's
    /// hash is the item tree's — names and kinds.
    fn items(f: FileId) -> List<DeclId> {
        // A HELD FILE ANSWERS FROM ITS RECORD, before anything reaches for a parse: its
        // declarations were MINTED, and `file_items` is a memo over a paree it never had.
        if self.is_held(f) { return self.decls.held_items_of_file(f) }
        match self.file_items.start(f.index) { .Reuse(value) -> { return value }, .Compute -> nothing() }
        let p = self.parsed(f)
        let ids = self.decls.admit(f, p.store, p.stmts)
        self.file_items.finish(f.index, ids, fp(7, [self.item_print(d) for d in ids]))
    }

    /// The declaration behind an id.
    fn decl_at(d: DeclId) -> Decl {
        self.decls.decl(d)
    }

    /// An item's print in the item tree's hash: its name, kind and
    /// visibility.
    fn item_print(d: DeclId) -> int {
        let x = self.decl_at(d)
        fp_str("${x.name}/${kind_word(x.kind)}/${x.exported}")
    }

    /// A module's names, bound ONCE: every file's declarations in file
    /// then declaration order.
    fn namespace(m: ModuleId) -> ModuleNames {
        match self.module_names.start(m.index) { .Reuse(value) -> { return value }, .Compute -> nothing() }
        let paths = self.module_files(module_path(segments_of(self.decls.module_name(m))))
        let ordered: List<DeclId> = flatten([self.items(self.file_id(path)) for path in paths])
        let names = self.decls.module_names(ordered, (path: string) -> self.shown(path))
        self.module_names.finish(m.index, names, fp(3, [fp_list([d.index for d in names.bound]), names.clashes.length]))
    }

    /// What a file's top level sees: its module's names, then its
    /// imports — with what the `use` lines earned.
    fn visible(f: FileId) -> Namespace {
        match self.visibles.start(f.index) { .Reuse(value) -> { return value }, .Compute -> nothing() }
        let p = self.parsed(f)
        mut imports: List<Import> = []
        mut diags: List<Diag> = []
        for u in use_lines(p) {
            let line = self.imported_line(p, u)
            imports = imports.concat(line.imports)
            diags = diags.concat(line.diagnostics)
        }
        let names = self.decls.file_names(f, self.namespace(self.decls.file(f).module_id), imports, self.prelude_imports(f), (path: string) -> self.shown(path))
        let out = names with { voices: Voices { list: diags.concat(names.voices.list) } }
        self.visibles.finish(f.index, out, self.db.revision())
    }

    /// THE PRELUDE'S EXPORTS, as every file's implicit imports: the
    /// toolchain's `@std/prelude`, when the host carries one, seen by
    /// every file outside the prelude itself. Bound weakly — a file's
    /// own names and its `use` lines win.
    fn prelude_imports(f: FileId) -> List<Import> {
        let from = self.packages[self.holder_of_path(self.decls.file(f).path)]
        if from.key == prelude_key || !self.std_admitted(prelude_key) { return [] }
        [Import { decl: d.id, at: null, alias: "" } for d in self.exported_decls(ModulePath { segments: key_spelled(prelude_key).split(".") })]
    }

    /// A file's names resolved. RECURSIVE: a whole-program pass asks
    /// for a signature from inside typing (the receiver pass), which
    /// asks for a resolve, and a re-entry is a SMALLER view of the file
    /// in flight — the acyclic `start` answers a cycle with a defect,
    /// and one file's resolve may be demanded while another is served.
    fn resolved(f: FileId) -> NameFacts {
        match self.name_facts.start_recursive(f.index) { .Reuse(value) -> { return value }, .Compute -> nothing() }
        touch(self.items(f))
        // THE ARENA IS COMPLETE BEFORE ANY TABLE IS SIZED. An
        // expansion MINTS the twin's nodes, and the resolver's
        // per-expression tables are sized to the arena as it stands —
        // so the expansions run here, ahead of them, and their
        // statements join the walk. (The second-tier LOOKUP still
        // happens on a miss, below.)
        let made = if self.has_declares(f) || self.has_marks(f) { self.expanded(f) } else { [] }
        let p = self.parsed(f)
        // THE TWO LOOKS PAST THE FILE: a name missing from the written
        // namespace asks the file's generated declarations, which
        // materialize on demand through `expanded`; a template's own
        // name asks the namespace of the file that wrote the quote.
        let elsewhere = Elsewhere {
            generated: (name: string) -> self.generated_named(f, name),
            written_in: (origin: FileId) -> self.visible(origin),
        }
        // A generated body's statement stands in the arena, never in
        // the parse tree — resolve it after the written bodies.
        let generated = [self.decls.decl(d).stmt for d in made]
        let resolved = resolve(self.lang.dispatch, self.lang.keywords, file_view(self.lang, p, self.decls, f), self.visible(f), elsewhere, generated)
        // What the expansions REFUSED speaks with the file's names:
        // generated source that did not parse, homed at its template.
        let out = resolved with { voices: Voices { list: resolved.voices.list.concat(self.decls.expansion_voices[f.index]) } }
        self.name_facts.finish(f.index, out, self.db.revision())
    }

    /// A generated declaration's id by its NAME, or none — demanded
    /// lazily, so a program names a twin only if that name exists.
    fn generated_named(f: FileId, name: string) -> DeclId? {
        if !self.has_declares(f) { return null }
        let made = self.expanded(f)
        let found: DeclId? = made.find((d: DeclId) -> self.decls.decl(d).name == name)
        found
    }

    /// Whether the file has ANY Declares annotation — the parse-level
    /// prefilter that keeps the two-tier second look off the common
    /// path: a file with no generator never demands `expanded` (and
    /// never re-enters the namespace from inside a resolve).
    fn has_declares(f: FileId) -> bool {
        let p = self.parsed(f)
        p.stmts.any((s: StmtId) -> !p.store.annotations_of(s).is_empty())
    }

    /// Whether any declaration carries a MARK — the same prefilter for
    /// the other half of the `@` surface. A file with marks and no
    /// annotation still walks the expansion, because that is where
    /// every mark is held to a reader, and such a file is about to be
    /// refused anyway: nothing claims its marks.
    fn has_marks(f: FileId) -> bool {
        let p = self.parsed(f)
        p.stmts.any((s: StmtId) -> !p.store.marks_written(s).is_empty())
    }

    /// A declaration's signature, computed on first ask: the ONE place
    /// declaration order stops mattering — a sig asks the sigs it names
    /// lazily through the table. A sig reached from inside its own
    /// computation (a recursive payload re-judging its slots) is
    /// simply not there yet.
    fn sig(d: DeclId) -> DeclSig? {
        let k = key(Family.Sig, d.index)
        let x = self.decls.decl(d)
        if self.is_held(x.file) { return self.decls.sigs[d.index] }
        // the language's own declarations were signed at admission
        if !(self.db.ask(k) is .Compute) || x.kind is .Builtin {
            return self.decls.sigs[d.index]
        }
        self.db.begin(k)
        // A sig signed WHILE ITS FILE RESOLVES is signed from a smaller
        // view — legitimate for the two-tier re-entry, and the first
        // thing to look at when a generated impl's methods go missing.
        if self.db.active(key(Family.Resolved, x.file.index)) { debug("sig mid-resolve: ${x.name} in ${self.decls.file(x.file).path}") }
        mut t = self.type_cx_for(x)
        t.declare_one(x)
        self.sig_voices.keep(d.index, t.facts.voices)
        let out: DeclSig? = self.decls.sigs[d.index]
        self.db.settle(k, sig_hash(out))
        out
    }

    /// A type's method table, filled from its own members and every
    /// impl block that names it — asked through the table's read, so a
    /// body depends on exactly the impls it dispatches through. Asked
    /// again from inside one of those impls' own registration, it
    /// answers what stands.
    fn methods(target: DeclId) -> List<DeclId> {
        let blocks = self.decls.children_of(target).concat([b for b in self.decls.impls_named(self.decls.decl(target).name) if self.aims_at(b, target)])
        // A table that cannot be COMPLETED is not the table, and must
        // not be memoized: an impl still registering, or an impl in a
        // file whose resolve is in flight (a lifted call runs inside
        // one, and the generated impl it is minting is not signed yet).
        if blocks.any((b) -> self.registering(b)) { return self.decls.methods_of(target) }
        if blocks.any((b) -> self.db.active(key(Family.Resolved, self.decls.decl(b).file.index))) { return self.decls.methods_of(target) }
        let k = key(Family.Methods, target.index)
        if !(self.db.ask(k) is .Compute) { return self.decls.methods_of(target) }
        self.db.begin(k)
        for b in blocks {
            if self.is_held(self.decls.decl(b).file) { self.held_methods(target, b) } else { touch(self.sig(b)) }
        }
        let out = self.decls.methods_of(target)
        self.method_clashes.keep(target.index, self.decls.method_clashes(target))
        self.db.settle(k, fp_str(joined([self.decls.decl(m).name for m in out], ",")))
        out
    }

    /// Whether an impl block written under the target's NAME can mean
    /// the target: its file's namespace must name that declaration. A
    /// like-named type in another module is not this one, and signing
    /// its impl would drag that module's files into whatever resolve
    /// is asking — `@std.meta.Code` and the compiler's own `Code` met
    /// so, inside a derive, and poisoned a sig computed mid-resolve.
    fn aims_at(b: DeclId, target: DeclId) -> bool {
        // A HELD IMPL HAS NO NAMESPACE TO ASK — its file was never parsed, so the
        // record's own name is the identity: the impl was filed under the target's
        // name and its file was admitted to the same package.
        if self.is_held(self.decls.decl(b).file) { return self.decls.decl(b).name == self.decls.decl(target).name }
        let seen: DeclId? = self.visible(self.decls.decl(b).file).type_decl(self.decls.decl(target).name)
        seen != null && same_decl(seen!, target)
    }

    /// A HELD IMPL'S METHODS, registered from the interface. The typer SIGNS an
    /// impl to fill the table; a held impl has no body to sign, so its RECORD's
    /// children are the table's entries.
    fn held_methods(target: DeclId, block: DeclId) {
        for m in self.decls.children_of(block) { self.decls.declare_method(target, m) }
    }

    /// Whether a declaration's signature is being computed right now.
    fn registering(d: DeclId) -> bool {
        self.db.active(key(Family.Sig, d.index))
    }

    /// A type context over one declaration's expression range, in its
    /// file.
    fn type_cx_for(x: Decl) -> TypeCx {
        let p = self.parsed(x.file)
        new_type_cx(self.lang.dispatch, self.lang.keywords, file_view(self.lang, p, self.decls, x.file), self.resolved(x.file), x.lo, x.hi)
    }

    /// One declaration's body typed — a table over its own expression
    /// range, the sigs it names asked as it reads them.
    fn typed(d: DeclId) -> TypeFacts {
        // Annotation evaluation re-types the declaration after hiding
        // the active annotation, so this family also has a smaller
        // recursive view.
        match self.decl_facts.start_recursive(d.index) { .Reuse(value) -> { return value }, .Compute -> nothing() }
        let x = self.decls.decl(d)
        mut t = self.type_cx_for(x)
        let out = t.type_decl(x)
        self.decl_facts.finish(d.index, out, self.db.revision())
    }

    /// A file's bodies as one table: Main's facts first (its range
    /// spans the file), each declaration's laid over its own range,
    /// their voices in source order — what the facade and lowering
    /// read by expression.
    fn folded(f: FileId) -> TypeFacts {
        // Annotation evaluation re-enters the file after the active
        // annotation has been hidden; that recursive view is smaller.
        match self.folds.start_recursive(f.index) { .Reuse(value) -> { return value }, .Compute -> nothing() }
        let p = self.parsed(f)
        let hole = self.decls.types.intern(Type.Error)
        mut out = new_type_facts(0, p.store.exprs.count(), p.store.stmts.count(), hole)
        mut spoken: List<Diag> = []
        for d in self.bodies_of(f) {
            let facts = self.typed(d)
            out.absorb(facts)
            spoken = spoken.concat(facts.voices.list)
        }
        let folded_facts = out with { voices: Voices { list: by_position(spoken) } }
        self.folds.finish(f.index, folded_facts, self.db.revision())
    }

    /// A file's bodies to type: Main, then every declaration owning a
    /// range, in declaration order.
    fn bodies_of(f: FileId) -> List<DeclId> {
        some_list(self.decls.main_of(f)).concat([d for d in self.decls.decls_of_file(f) if self.decls.owns_a_range(d)])
    }

    /// A file's signature diagnostics, in the order the rounds spoke
    /// them: types, then traits' members, then fns, then impls.
    fn sig_diagnostics(f: FileId) -> List<Diag> {
        let own = self.top_level_decls(f)
        mut out: List<Diag> = []
        for rank in 0..4 {
            for d in own {
                if self.decls.sig_rank(self.decls.decl(d)) == rank {
                    touch(self.sig(d))
                    let v: Voices? = self.sig_voices.at(d.index)
                    if v != null { out = out.concat(v!.list) }
                }
            }
        }
        out
    }
}

/// A family's arg, as the file, module or declaration it keys by.
fn file_at(arg: int) -> FileId { FileId { index: arg } }
fn module_at(arg: int) -> ModuleId { ModuleId { index: arg } }
fn decl_at_arg(arg: int) -> DeclId { DeclId { index: arg } }

/// A program's fingerprint — the fold of its statements'.
fn program_hash(p: Parsed) -> int {
    fp(17, [p.store.stmt_fingerprint(s) for s in p.stmts])
}

/// A signature's fingerprint — everything the signature SAYS, so an
/// unchanged sig cuts the wave at every caller and a changed one never
/// can. DERIVED: the fold is a reading of the declaration's own
/// shape, so a field added to a sig reaches the hash on the day it
/// lands rather than whenever someone diffs the parts list against
/// the record. That diff is what found seven forgotten payloads here,
/// and every one of them was a field added after its hash was
/// written. Exported because the shapes that once collided are pinned
/// as cases.
export fn sig_hash(s: DeclSig?) -> int {
    if s == null { return 0 }
    s!.fingerprint()
}

impl Decls {
    fn sig_rank(x: Decl) -> int {
        match x.kind {
            .Record or .Named or .Enum or .Builtin -> 0,
            .Method -> if x.parent != null && self.decl(x.parent!).kind is .Trait { 1 } else { 3 },
            .Fn -> 2,
            .Impl -> 3,
            .Trait or .Syntax or .Default or .Main or .Case or .Const -> 4,
        }
    }
}

impl Workspace {
    /// The method-table clashes spoken in a file. Build the index once:
    /// scanning every type for every file made this a whole-program
    /// pass repeated for each file.
    fn method_diagnostics(f: FileId) -> List<Diag> {
        // A LIFTED CALL RUNS INSIDE A RESOLVE: computing the provider's
        // analysis must not force ANOTHER file's resolve (a re-entrant
        // `resolved` is a defect, not a smaller view). The provider's
        // real diagnostics come from the normal analyze pass.
        if self.db.family_active(ordinal(Family.Resolved)) { return [] }
        let previous: MethodDiagIndex? = self.method_diags.first()
        if previous != null {
            let held = previous!
            if held.revision == self.db.revision() && held.decl_count == self.decls.decls.length && f.index < held.by_file.length {
                return held.by_file[f.index]
            }
        }
        mut by_file: List<List<Diag>> = []
        mut at = 0
        // Signing an impl may admit another declaration, so walk the
        // growing table until every type has had its method query.
        while at < self.decls.decls.length {
            let x = self.decls.decls[at]
            at = at + 1
            if is_type_decl(x) {
                touch(self.methods(x.id))
                let held: List<Clash> = self.method_clashes.at(x.id.index) ?? []
                for c in held {
                    while by_file.length <= c.file.index { by_file.push([]) }
                    mut row = by_file[c.file.index]
                    row.push(c.diag)
                    by_file.set(c.file.index, row)
                }
            }
        }
        while by_file.length < self.decls.files.length { by_file.push([]) }
        let current = MethodDiagIndex { revision: self.db.revision(), decl_count: self.decls.decls.length, by_file: by_file }
        if self.method_diags.is_empty() { self.method_diags.push(current) } else { self.method_diags.set(0, current) }
        by_file[f.index]
    }

    /// One file's analysis: the snapshot every facade reads.
    fn analysis(f: FileId) -> Analysis {
        // A closed one-shot workspace retains no Analysis because its
        // program closure points back here.
        if self.closed { return self.analyzed(f) }
        match self.analyses.start_recursive(f.index) { .Reuse(value) -> { return value }, .Compute -> nothing() }
        let out = self.analyzed(f)
        self.analyses.finish(f.index, out, self.db.revision())
    }

    /// The record itself: every pass's facts for the file, and the way
    /// to its program.
    fn analyzed(f: FileId) -> Analysis {
        let p = self.parsed(f)
        let names = self.resolved(f)
        let facts = self.folded(f)
        let path = self.decls.file(f).path
        Analysis {
            view: file_view(self.lang, p, self.decls, f), names: names, facts: facts, lang: self.lang,
            diagnostics: flatten([p.voices.list, names.voices.list, self.sig_diagnostics(f), self.method_diagnostics(f), facts.voices.list]),
            program: () -> self.program(path),
        }
    }

    /// A unit's identity: its symbol, interned.
    mut fn spec_id(w: Wanted) -> int {
        let known: int? = self.specs.get(w.name)
        if known != null { return known! }
        let id = self.asks.length
        self.specs.set(w.name, id)
        self.asks.push(w)
        id
    }

    /// The program's extern fns by symbol, gathered ONCE per run — every
    /// file is admitted before the first unit lowers, and the emitters
    /// asked per body where each walked every declaration.
    fn extern_symbols() -> List<string> {
        let held: List<string>? = self.externs.at(0)
        if held != null { return held! }
        let names = self.decls.extern_names()
        self.externs.keep(0, names)
        names
    }

    /// One unit lowered and remembered: a body edit re-lowers its own
    /// unit; the specializations it wants are other units.
    fn lowered(id: int) -> Unit {
        match self.units.start_recursive(id) { .Reuse(value) -> { return value }, .Compute -> nothing() }
        let w = self.asks[id]
        if w.decl != null && self.is_held(w.file) && w.sub == null {
            let empty = Unit { bodies: [], wants: [], voices: no_voices(), statics: [] }
            return self.units.finish(id, empty, self.db.revision())
        }
        let out = self.lower_requested(w)
        self.units.finish(id, out, self.db.revision())
    }

    /// The one lowering path for a body requested from a held source. A
    /// specialization may be absent from its cached object, and compile-time
    /// evaluation also needs the real body.
    fn lower_requested(w: Wanted) -> Unit {
        if self.is_held(w.file) {
            let path = self.decls.file(w.file).path
            if self.decls.ranged.get(path) == null {
                let main = self.decls.main_of(w.file)
                if main != null {
                    let p = self.parsed(w.file)
                    self.decls.range_bodies(w.file, p.store, main!)
                }
                self.decls.ranged.set(path, true)
            }
        }
        let ws = self
        let settle: fn(FileId, SettleRoot, List<SeatValue>) -> Result<Settled, Unsettled> = (f: FileId, root: SettleRoot, seats: List<SeatValue>) -> ws.settled(f, root, seats)
        lower_unit(self.analysis(w.file), self.extern_symbols(), w, settle)
    }

    /// An isolated compile-time run needs the body of every function it
    /// reaches, including one whose machine-code object is held. Parse and
    /// lower that source on demand; ordinary program lowering still reuses
    /// the held object through `lowered` above.
    fn lowered_for_eval(id: int) -> Unit {
        let w = self.asks[id]
        if w.decl == null || !self.is_held(w.file) { return self.lowered(id) }
        self.lower_requested(w)
    }

    /// A const's value, settled ONCE per workspace: its initializer
    /// lowered as a program of its own — the units it reaches are the
    /// program's, memoized — then run in the evaluator. A const whose
    /// value asks for itself is refused as the cycle it is.
    fn settled(f: FileId, root: SettleRoot, seats: List<SeatValue>) -> Result<Settled, Unsettled> {
        self.settled_at(self.settle_id(f, root, seats))
    }

    fn settle_id(f: FileId, root: SettleRoot, seats: List<SeatValue>) -> int {
        let name = self.settle_symbol(f, root, seats)
        let known: int? = self.settle_specs.get(name)
        if known != null { return known! }
        let id = self.settle_asks.length
        self.settle_specs.set(name, id)
        self.settle_asks.push(SettleAsk { file: f, root: root, name: name, seats: seats })
        id
    }

    /// A settlement's key: the const's statement or the expression,
    /// plus the settled seats' fingerprints when a unit fixes them —
    /// so two units of one body settle their own values.
    fn settle_symbol(f: FileId, root: SettleRoot, seats: List<SeatValue>) -> string {
        let own = match root {
            .Const(s) -> const_symbol(f, s),
            .Expr(e) -> expr_symbol(f, e),
        }
        settled_symbol(own, seats)
    }

    /// A const's inferred type is a program fact, like a signature:
    /// type its declaration on demand and publish the answer through
    /// Decls so every other body reads the same identity. Answers
    /// whether THIS ask closed a cycle — a const's value asking for
    /// the const's own type.
    fn const_type_at(id: int) -> bool {
        let error = self.decls.types.intern(Type.Error)
        match self.const_type_facts.ask(id) {
            .Cycle -> { return true },
            .Reuse(_) -> { return false },
            .Compute -> self.const_type_facts.begin(id),
        }
        let ask = self.settle_asks[id]
        // only a const's statement has a type to publish
        let held: StmtId? = const_stmt(ask.root)
        if held == null {
            let _ = self.const_type_facts.finish(id, error, error.index)
            return false
        }
        let s = held!
        touch(self.items(ask.file))
        // a top-level const is a declaration: typing it records the
        // value's type; a nested one is recorded by the body it is in.
        // Its typing already OPEN is the same cycle seen from the
        // other side — the value is asking for the const's own type.
        let d: DeclId? = self.decls.decl_of(ask.file, s)
        let cyclic = d != null && self.decl_facts.open(d!.index)
        if d != null && !cyclic { touch(self.typed(d!)) }
        let ty = self.decls.held_const_type(ask.file, s) ?? error
        let _ = self.const_type_facts.finish(id, ty, ty.index)
        cyclic
    }

    fn settled_at(id: int) -> Result<Settled, Unsettled> {
        match self.settlements.ask(id) {
            .Cycle -> { return .Err(Unsettled.Trap("asks for its own value while settling")) },
            .Reuse(held) -> { return reused_settlement(held) },
            .Compute -> self.settlements.begin(id),
        }
        let ask = self.settle_asks[id]
        let root: ExprId = match ask.root {
            .Const(s) -> self.analysis(ask.file).view.store.const_value(s)!,
            .Expr(e) -> e,
        }
        let r = self.settlement_of(ask.file, root, ask.name, ask.seats)
        // `embed` is the one permitted build-world read. Make every
        // file it opened a source input dependency before this query
        // closes, so its content participates in revalidation.
        match r {
            .Ok(value) -> { for path in value.embeds { touch(self.source(self.file_id(path))) } },
            .Err(_) -> { let _ = 0 },
        }
        let held = match r {
            .Ok(x) -> Settlement.Held(x),
            .Err(why) -> Settlement.Refused(why),
        }
        let _ = self.settlements.finish(id, held, settlement_hash(held))
        r
    }

    /// One settlement run: the initializer lowered as a program, its
    /// laws checked, its value spelled when the type spells one.
    fn settlement_of(f: FileId, root: ExprId, name: string, seats: List<SeatValue>) -> Result<Settled, Unsettled> {
        // The evaluator's source unit and the program's materialized
        // const unit are different IR under different symbols. The
        // Lowered memo keys by symbol, so sharing one would make query
        // order choose which body survives.
        let l = self.isolated(f, root, "settling$${name}", seats)
        if has_errors(l.diagnostics) { return .Err(Unsettled.Trap(l.diagnostics.first()!.message)) }
        run_settle(l, self.budgets(), dir_of(self.decls.file(f).path))
    }

    /// One expression lowered as a program of its own, while every
    /// body it reaches remains a shared `Lowered` query.
    fn isolated(f: FileId, root: ExprId, name: string, seats: List<SeatValue>) -> Lowered {
        let ws = self
        memory(self.decls.settlement(Wanted { file: f, decl: null, name: name, sub: null, seats: seats, root: root }, (w: Wanted) -> ws.lowered_for_eval(ws.spec_id(w))))
    }

    /// An annotation argument evaluated directly into the crossing
    /// transport, including every nested aggregate.
    fn crossed_expr(f: FileId, e: ExprId, mut heap: MetaHeap) -> Result<MetaVal, Unsettled> {
        let l = self.isolated(f, e, expr_symbol(f, e), [])
        if has_errors(l.diagnostics) { return .Err(Unsettled.Trap(l.diagnostics.first()!.message)) }
        match run_crossed(l, self.budgets(), dir_of(self.decls.file(f).path)) {
            .Ok(x) -> .Ok(heap.adopt(x.heap, x.answer)),
            .Err(why) -> .Err(why),
        }
    }

    /// An annotation fn run over a declaration: the fn's own program
    /// lowered and checked for reach, the declaration crossed in as
    /// the fn's first seat asks (from the PARSE view, so generating
    /// an expanded sibling needs no typed answers of this file), each
    /// argument settled and crossed, and what the fn answered read
    /// back as what it SAID.
    fn lifted(d: DeclId, f: FileId, s: StmtId, call: ExprId, args: List<ExprId>) -> Result<Lifted, Unsettled> {
        let name = "lift$${f.index}$${call.index}$${d.index}"
        let known: int? = self.lift_specs.get(name)
        if known != null {
            self.lift_asks.set(known!, lift_ask(d, f, s, args))
            return self.lifted_at(known!)
        }
        let id = self.lift_asks.length
        self.lift_specs.set(name, id)
        self.lift_asks.push(lift_ask(d, f, s, args))
        self.lifted_at(id)
    }

    /// One annotation query. The kernel's cycle verdict is the
    /// lowering pass seeing the annotation it is currently proving,
    /// so that recursive view contributes nothing.
    fn lifted_at(id: int) -> Result<Lifted, Unsettled> {
        match self.lift_results.ask(id) {
            .Cycle -> { return .Err(Unsettled.Recursive) },
            .Reuse(held) -> { return reused_lift(held) },
            .Compute -> self.lift_results.begin(id),
        }
        let ask = self.lift_asks[id]
        let r = self.lifted_once(ask.decl, ask.file, ask.stmt, ask.args)
        let held = match r {
            .Ok(crossed) -> LiftResult.Crossed(crossed),
            .Err(why) -> LiftResult.Refused(why),
        }
        let _ = self.lift_results.finish(id, held, lift_hash(held))
        r
    }

    /// One annotation call after its recursion guard is standing.
    fn lifted_once(d: DeclId, f: FileId, s: StmtId, args: List<ExprId>) -> Result<Lifted, Unsettled> {
        let x = self.decls.decl(d)
        let ws = self
        let l = memory(self.decls.settlement(Wanted { file: x.file, decl: d, name: self.decls.symbol(d), sub: null, seats: [], root: null }, (w: Wanted) -> ws.lowered_for_eval(ws.spec_id(w))))
        if has_errors(l.diagnostics) { return .Err(Unsettled.Trap(l.diagnostics.first()!.message)) }
        let sig = (self.decls.sig(d))?.fn_sig()
        if sig == null { return .Err(Unsettled.Trap("`${x.name}` has no signature")) }
        let shape = sig!
        if shape.params.is_empty() { return .Err(Unsettled.Trap("`${x.name}` takes no declaration to lift")) }
        mut heap = new_meta_heap()
        mut vals: List<MetaVal> = [self.crossed_decl(f, s, shape.params.first()!, heap)]
        for j, e in args {
            match self.crossed_arg(f, e, shape.params[j + 1], heap) {
                .Ok(v) -> vals.push(v),
                .Err(why) -> { return .Err(why) },
            }
        }
        match run_lifted(l, self.decls.symbol(d), vals, heap, self.budgets()) {
            .Ok(r2) -> .Ok(r2),
            .Err(why) -> .Err(why),
        }
    }

    /// An annotation argument crossed — a LITERAL straight off the
    /// parse tree (an isolated run needs this file's analysis, which
    /// is the very resolve the two-tier miss is serving: a cycle),
    /// anything else through the isolated evaluator.
    fn crossed_arg(f: FileId, e: ExprId, want: TypeId, mut heap: MetaHeap) -> Result<MetaVal, Unsettled> {
        let named: DeclId? = if self.decls.takes_a_decl(want) { bound_decl_of(self.resolved(f), e) } else { null }
        if named != null { return .Ok(self.crossed_decl_of(named!, want, heap)) }
        let p = self.parsed(f)
        let raw = p.store.expr(e)
        let n: int? = (raw).int_of()
        if n != null { return .Ok(MetaVal.Int(n!)) }
        let t: string? = (raw).text_of()
        if t != null { return .Ok(MetaVal.Text(t!)) }
        let b: bool? = (raw).bool_of()
        if b != null { return .Ok(MetaVal.Bool(b!)) }
        let bits: int? = (raw).bits_of()
        if bits != null { return .Ok(MetaVal.Float(bits!)) }
        let code: MetaVal? = quote_meta(p.store, self.decls, self.decls.file(f).path, e, heap)
        if code != null { return .Ok(code!) }
        self.crossed_expr(f, e, heap)
    }

    /// A file's GENERATED declarations: every Declares-annotated
    /// WRITTEN fn's directives materialized as real twins in the file's
    /// store and decl table — the two-tier namespace's second tier.
    /// Memoized per file; minting is idempotent by the generated key,
    /// so a re-run after invalidation mints nothing new.
    fn expanded(f: FileId) -> List<DeclId> {
        // RECURSIVE: `expanded` is demanded from INSIDE a resolve's
        // miss — a two-tier lookup — and the namespace the materializer
        // walks is itself a dependency of that resolve. The kernel's
        // recursion guard makes the re-entry a SMALLER view (an empty
        // expansion for the resolve in flight), never a trap.
        match self.generated.start_recursive(f.index) { .Reuse(value) -> { return value }, .Compute -> nothing() }
        self.decls.hush_expansion(f)
        let p = self.parsed(f)
        let vis = self.visible(f)
        mut made: List<DeclId> = []
        for d in self.decls.decls_of_file(f) {
            for w in self.declared_work(f, d, p, vis) {
                made = made.concat(self.materialized(f, w, p, vis))
            }
        }
        self.hold_marks_to_a_reader(f, p, vis)
        self.generated.finish(f.index, made, fp(31, [d.index for d in made]))
        made
    }

    /// One annotation's declarations materialized. A DECLARES or
    /// DERIVES annotation RUNS INSIDE THE RESOLVE IT SERVES, so its
    /// arguments must be SOURCE-KNOWN — a literal or a declaration's
    /// name — never a computed value that needs this file's typed
    /// answers, which do not exist yet.
    fn materialized(f: FileId, w: DeclareWork, p: Parsed, vis: Namespace) -> List<DeclId> {
        if !w.args.all((e: ExprId) -> source_spelled(p.store.expr(e)) || p.store.ident_name(e) != null) { return [] }
        // a loaded `@std/meta` the crossing cannot read generates
        // nothing; the annotation law speaks it
        if self.decls.meta_disagreement() != null { return [] }
        let directives = if self.is_derived(w.ret) { self.derive_directives(w, f, p, vis) } else { self.lifted_directives(w.ann, f, w.stmt, w.callee, w.args, w.at) }
        flatten([self.materialized_directive(f, w, directive, vis) for directive in directives])
    }

    /// One directive: a `source` is generated CODE parsed and admitted
    /// beside the original, and a `twin` mints a fn beside it.
    fn materialized_directive(f: FileId, w: DeclareWork, directive: Directive, vis: Namespace) -> List<DeclId> {
        let ann = self.decls.decl(w.ann).name
        let source: MetaDecls? = directive.source
        if source == null { return self.twinned(f, w, directive, ann) }
        self.admit_code(f, source!.node, ann, w.at, vis)
    }

    /// The fn a directive asks for beside the original, when it asks.
    fn twinned(f: FileId, w: DeclareWork, directive: Directive, ann: string) -> List<DeclId> {
        if directive.twin.is_empty() { return [] }
        [self.decls.mint_generated(f, directive.twin, w.tparams, w.params, w.answer, w.original, ann, w.at)]
    }

    /// A written fn's Declares annotation, as the materializer's
    /// inputs — nothing when the annotation is not a generator.
    fn declared_work(f: FileId, d: DeclId, p: Parsed, vis: Namespace) -> List<DeclareWork> {
        let x = self.decls.decl(d)
        let anns = p.store.annotations_of(x.stmt)
        if anns.is_empty() { return [] }
        // A code directive needs no declaration shape; a twin walks a
        // FN, so a type's twin reads empty seats and a `void` answer.
        let parts: FnParts? = p.store.fn_parts(x.stmt)
        let params = if parts == null { [] } else { p.store.declared_params(x.stmt) }
        let tparams: List<Param> = parts?.tparams ?? []
        let answer: TypeRef = parts?.ret ?? named_ref("void")
        mut out: List<DeclareWork> = []
        for a in anns {
            let callee_name: string? = p.store.ident_name(a.callee)
            if callee_name != null {
                let found: DeclId? = vis.fn_decl(callee_name!)
                if found != null {
                    let ann_decl = found!
                    // A callee from the SAME FILE would need this very
                    // file's resolved names to sign — the cycle the kernel
                    // trips on. The two-tier expansion is for PROVIDER
                    // annotations (std-meta's `traced`), whose sig lives
                    // in another, computable file.
                    if !same_file(self.decls.decl(ann_decl).file, f) {
                        let asig: FnSig? = (self.decls.sig(ann_decl))?.fn_sig()
                        if asig != null {
                            let sig = asig!
                            if self.is_declares(sig.ret) || self.is_derived(sig.ret) {
                                out.push(DeclareWork {
                                    ann: ann_decl, stmt: x.stmt, callee: a.callee, args: a.args,
                                    ret: sig.ret, tparams: tparams, params: params, answer: answer, original: x.name,
                                    at: a.span ?? p.store.stmt_span(x.stmt),
                                })
                            }
                        }
                    }
                }
            }
        }
        out
    }

    /// Whether a return type is `List<Directive>` — the Declares cue.
    fn is_declares(ret: TypeId) -> bool {
        let elem: TypeId? = elem_of(self.decls.types, ret)
        if elem == null { return false }
        match self.decls.types.shape_of(elem!) { .Struct(d, _) -> self.decls.decl(d).name == "Directive", rest -> false }
    }

    /// Whether a return type is `@std.meta.Derived` — the `@derive`
    /// cue: the compiler runs each named trait's associated `derive`.
    fn is_derived(ret: TypeId) -> bool { self.decls.meta_type(ret, "Derived") }

    /// EVERY MARK OWES A READER. The compiler judges no mark — its
    /// meaning lives with whoever reads it — so the only law it can
    /// hold is that SOMEONE reads it: each `@derive` on the
    /// declaration says which marks it takes (the trait's `marks`),
    /// and a word in no claim is refused where it was written. Without
    /// this a misspelled mark sits there doing nothing, forever and
    /// silently, which is the whole class this seam exists to kill.
    ///
    /// ASKED PER DECLARING STATEMENT, never per declaration: a field's
    /// default is a declaration of its own standing on its OWNER's
    /// statement, so a per-decl walk asks the same marks twice — once
    /// with the owner's claims and once with none, and the second run
    /// refuses what the first allowed.
    fn hold_marks_to_a_reader(f: FileId, p: Parsed, vis: Namespace) {
        for s in p.stmts {
            self.hold_the_marks_of(f, s, p.store.marks_written(s), p, vis)
        }
    }

    fn hold_the_marks_of(f: FileId, s: StmtId, written: List<Mark>, p: Parsed, vis: Namespace) {
        if written.is_empty() { return }
        let owner: DeclId? = self.decls.decls_of_file(f).find((c: DeclId) -> same_stmt(self.decls.decl(c).stmt, s))
        if owner == null { return }
        let asked: List<string>? = self.claimed_marks(f, owner!, p, vis)
        if asked == null { return }
        let claimed = asked!
        // LICENSED — matching a mark by its WORD: a mark crosses a
        // package boundary, where a foreign enum has no typed id, so
        // the word is the currency. The doctrine's mitigation is this
        // very line — the unknown speaks instead of falling through.
        let unread = [m for m in written if !claimed.contains(m.name)]
        if unread.is_empty() { return }
        self.decls.speak_expansion(f, [unclaimed_mark(m, claimed, loc_at(self.decls.file(f).path, m.span)) for m in unread])
    }

    /// THE CLAIM SET, OR ABSENCE WHEN IT CANNOT BE KNOWN — and the two
    /// are DIFFERENT VALUES. An empty claim set refuses every mark; an
    /// unanswerable one must refuse none, or a declaration whose
    /// annotations the compiler has not read yet loses every mark it
    /// legitimately carries. Knowable exactly twice: a declaration
    /// carrying NO annotation claims nothing, and one whose every
    /// derive answered claims their union.
    fn claimed_marks(f: FileId, d: DeclId, p: Parsed, vis: Namespace) -> List<string>? {
        if p.store.annotations_of(self.decls.decl(d).stmt).is_empty() { return claims_nothing() }
        let each: List<List<string>?> = [self.derive_claims(w, f, p, vis) for w in self.declared_work(f, d, p, vis) if self.is_derived(w.ret)]
        if each.is_empty() { return null }
        all_claims(each)
    }

    fn derive_claims(w: DeclareWork, f: FileId, p: Parsed, vis: Namespace) -> List<string>? {
        let each: List<List<string>?> = [self.trait_claims(self.named_arg(p, vis, e), w, f) for e in w.args]
        all_claims(each)
    }

    /// One trait's claim — its associated `marks` run over the
    /// declaration, exactly as its `derive` is and under the same
    /// provider guard. A trait that declares no `marks` claims
    /// nothing, knowably; everything the compiler could not reach
    /// answers absence.
    fn trait_claims(tr: DeclId?, w: DeclareWork, f: FileId) -> List<string>? {
        if tr == null { return null }
        let member: DeclId? = self.decls.trait_marks(tr!)
        if member == null { return claims_nothing() }
        let m = member!
        if same_file(self.decls.decl(m).file, f) { return null }
        if (self.decls.sig(m))?.fn_sig() == null { return null }
        match self.lifted(m, f, w.stmt, w.callee, []) {
            .Ok(crossed) -> crossed.claims(),
            .Err(_) -> null,
        }
    }

    /// A directive's generated DECLARATIONS spliced into this file's
    /// store — every template copied from the store that parsed it,
    /// its holes filled, each copied node wearing the file that wrote
    /// it — and their GENERATION recorded: the arena ranges the nodes
    /// took and the annotation that asked.
    fn admit_code(f: FileId, code: Node, ann: string, at: Span?, vis: Namespace) -> List<DeclId> {
        let store = self.decls.store_of(f)
        let before = arena_marks(store)
        let stmts = self.spliced_stmts(f, code)
        let took = before.until(arena_marks(store))
        // A GENERATED NAME THE FILE ALREADY DECLARES would lose to the
        // written one in silence — the two-tier lookup asks the written
        // namespace first. It speaks at the asking annotation instead.
        let taken = [n for n in [store.declared_name(s) ?? "" for s in stmts] if vis.names(n)]
        if !taken.is_empty() {
            self.decls.speak_expansion(f, [generated_taken(ann, n, loc_at(self.decls.file(f).path, at)) for n in taken])
            return []
        }
        self.decls.note_generation(f, Generation { exprs: took[0], stmts: took[1], pats: took[2], at: at })
        // The tag is the declarations' fingerprint, so two derives that
        // answer different impls mint two, and a re-run of one mints
        // nothing new.
        let tag = fp(117, [store.stmt_fingerprint(s) for s in stmts])
        let made = self.decls.mint_generated_code(f, store, stmts, before.exprs, "${tag}", ann, at)
        for d in made { self.decls.note_template(d, template_site(code)) }
        made
    }

    // ── The splice: a Node materialized in a SEAT of file f's store.
    // A template is copied from the store that parsed it; the other
    // shapes are minted. ──

    /// A LIST OF TEMPLATES HAS NO EXPRESSION POSITION. Every other
    /// seat joins a run — statements, arms and binders each flatten a
    /// `Many` — but an expression seat holds ONE value and no
    /// separator between two of them is the compiler's to choose. The
    /// arm that answered an Error node here spliced that choice
    /// silently and let the typer complain about the SEAT, which
    /// names neither the mistake nor its exits.
    fn spliced(f: FileId, node: Node, kind: HoleKind) -> Filled {
        if kind is .Expression && node is .Many { return Filled.Unplaceable(many_in_expression()) }
        match kind {
            .Expression -> Filled.Expr(self.spliced_expr(f, node)),
            .Name -> Filled.Name(self.spliced_names(node).first() ?? ""),
            .Binder -> Filled.Names(self.spliced_names(node)),
            .Type -> Filled.Type(self.spliced_type(node)),
            .Statement -> Filled.Stmts(self.spliced_stmts(f, node)),
            .Arm -> Filled.Arms(self.spliced_arms(f, node)),
        }
    }

    fn spliced_stmts(f: FileId, node: Node) -> List<StmtId> {
        match node {
            .Template(file, at, _, fills) -> self.copied(f, file, at, fills, HoleKind.Statement).stmts,
            .Many(items) -> flatten([self.spliced_stmts(f, i) for i in items]),
            .Name(_) or .Text(_) or .Int(_) or .Float(_) or .Bool(_) or .Interp(_, _) -> {
                let e = self.spliced_expr(f, node)
                mut store = self.decls.store_of(f)
                [store.alloc_stmt(Stmt.ExprStmt(e), null)]
            },
        }
    }

    fn spliced_expr(f: FileId, node: Node) -> ExprId {
        mut store = self.decls.store_of(f)
        match node {
            .Template(file, at, _, fills) -> self.copied_expr(f, file, at, fills),
            .Name(t) -> store.alloc_expr(Expr.Ident(Scoped(t)), null),
            .Text(t) -> store.alloc_expr(Expr.StrLit(t), null),
            .Int(v) -> store.alloc_expr(Expr.IntLit(v), null),
            .Float(bits) -> store.alloc_expr(Expr.FloatLit(bits), null),
            .Bool(b) -> store.alloc_expr(Expr.BoolLit(b), null),
            .Interp(parts, holes) -> {
                let hs = [self.spliced_expr(f, h) for h in holes]
                store.alloc_expr(Expr.Body("text", parts, hs, BodyView.None), null)
            },
            .Many(_) -> store.alloc_expr(Expr.Error, null),
        }
    }

    fn spliced_arms(f: FileId, node: Node) -> List<Arm> {
        match node {
            .Template(file, at, _, fills) -> self.copied(f, file, at, fills, HoleKind.Arm).arms,
            .Many(items) -> flatten([self.spliced_arms(f, i) for i in items]),
            .Name(_) or .Text(_) or .Int(_) or .Float(_) or .Bool(_) or .Interp(_, _) -> [],
        }
    }

    /// The names a fill spells: one, or several for a binder list.
    fn spliced_names(node: Node) -> List<string> {
        match node {
            .Name(t) -> [t],
            .Text(t) -> [t],
            .Int(v) -> ["${v}"],
            .Many(items) -> flatten([self.spliced_names(i) for i in items]),
            .Template(_, _, _, _) or .Float(_) or .Bool(_) or .Interp(_, _) -> [],
        }
    }

    /// A type fill: a name as the type it names, a SPELLING read with
    /// the language's `type` rule — the meta contract carries types as
    /// their spellings until a type value carries its own shape.
    fn spliced_type(node: Node) -> TypeRef {
        let text = self.spliced_names(node).first() ?? ""
        if all_codes(text, is_name_cont) { return named_ref(text) }
        parse_type_ref(self.lang, text) ?? named_ref(text)
    }

    /// A template as an expression: its one statement's value, or a
    /// block of its statements around the last one's.
    fn copied_expr(f: FileId, file: string, at: int, fills: List<Node>) -> ExprId {
        let stmts = self.copied(f, file, at, fills, HoleKind.Expression).stmts
        mut store = self.decls.store_of(f)
        let last: StmtId? = stmts.last()
        if last == null { return store.alloc_expr(Expr.Error, null) }
        let value: ExprId? = store.answer_of(last!)
        if value == null { return store.alloc_expr(Expr.Block(stmts, null), null) }
        if stmts.length == 1 { return value! }
        store.alloc_expr(Expr.Block(stmts.slice(0, stmts.length - 1), value!), null)
    }

    /// A template's body copied into file f's store, each hole filled
    /// AT ITS SEAT by the seat's kind — so a fill's nodes mint just
    /// before the node holding them, and every generated declaration
    /// keeps a contiguous range. A body of nothing but holes is its
    /// fills in the seat asked for. Each copied node records the file
    /// that wrote it, unless that is f itself.
    fn copied(f: FileId, file: string, at: int, fills: List<Node>, seat: HoleKind) -> Copied {
        let held: FileId? = self.decls.paths.get(file)
        if held == null { return nothing_copied() }
        let origin = held!
        let src = self.decls.store_of(origin)
        let q: ExprId? = src.quote_at(at)
        if q == null { return nothing_copied() }
        let parts: BodyParts? = (src.expr(q!)).body_of()
        if parts == null { return nothing_copied() }
        let body = parts!
        if quote_kind(src, q!) is .Holes { return self.holes_copied(f, fills, seat) }
        let ws = self
        let thunks = [(kind: HoleKind) -> ws.spliced(f, fill, kind) for fill in fills]
        mut rb = copier(src, self.decls.store_of(f), thunks)
        let copied_stmts: List<StmtId> = match body.view { .Verbatim(ss, _) -> ss, .None -> [], .Expanded(_) -> [] }
        let copied_arms: List<Arm> = match body.view { .Verbatim(_, arms) -> arms, .None -> [], .Expanded(_) -> [] }
        let stmts = rb.stmts(copied_stmts)
        let arms = rb.arms(copied_arms)
        if !same_file(origin, f) { self.decls.note_origins(f, rb.made_exprs, rb.made_stmts, rb.made_pats, origin) }
        // a node the template's own sublanguage minted keeps THAT
        // library as its origin, not the template's file
        for j, id in rb.made_exprs { self.note_foreign_origin(f, src, rb.made_from[j], id) }
        // A fill that did not fit its seat is the compiler's own
        // disagreement with its typing — spoken, never spliced quietly.
        self.decls.speak_expansion(f, [misfit_defect(self.decls.file(origin).path, at, k) for k in rb.misfits])
        self.decls.speak_expansion(f, [unplaceable_fill(self.decls.file(origin).path, at, u) for u in rb.unplaceable])
        Copied { stmts: stmts, arms: arms }
    }

    /// A lifted call's directives, or none when it refused — the ONE
    /// read of a `List<Directive>` answer.
    /// A DECLARING ANNOTATION THAT COULD NOT RUN SPEAKS, in the
    /// VALIDATING path's own words. This arm answered `[]` and said
    /// nothing, so a lift that trapped generated no declarations and
    /// the only evidence was F3000 at the USE SITE of a name nobody
    /// minted — one mechanism with a loud door and a mute one, and
    /// the mute one is the door every `@derive` takes.
    fn lifted_directives(d: DeclId, f: FileId, stmt: StmtId, call: ExprId, args: List<ExprId>, at: Span?) -> List<Directive> {
        match self.lifted(d, f, stmt, call, args) {
            .Ok(crossed) -> crossed.directives(),
            .Err(why) -> self.mute_lift(d, f, at, why),
        }
    }

    /// What the annotation could not do, at the annotation.
    fn mute_lift(d: DeclId, f: FileId, at: Span?, why: Unsettled) -> List<Directive> {
        let label = unsettled_label(self.decls.decl(d).name, why)
        if label.is_empty() { return [] }
        self.decls.speak_expansion(f, [lift_failed(label, loc_at(self.decls.file(f).path, at))])
        []
    }

    /// A `@derive`'s directives: each named trait's associated
    /// `derive` run over the annotated declaration, concatenated.
    fn derive_directives(w: DeclareWork, f: FileId, p: Parsed, vis: Namespace) -> List<Directive> {
        flatten([self.trait_directives(self.named_arg(p, vis, e), w, f) for e in w.args])
    }

    /// A declaration's NAME in an annotation's argument list, in this
    /// file's scope — a fn, a type, or a trait.
    fn named_arg(p: Parsed, vis: Namespace, e: ExprId) -> DeclId? {
        let name: string? = p.store.ident_name(e)
        if name == null { return null }
        vis.fn_decl(name!) ?? vis.type_decl(name!)
    }

    /// One trait's associated `derive` over the declaration — its
    /// directives, or none when the trait declares no `derive`.
    fn trait_directives(tr: DeclId?, w: DeclareWork, f: FileId) -> List<Directive> {
        if tr == null { return [] }
        let trait_id = tr!
        let member: DeclId? = self.decls.trait_derive(trait_id)
        if member == null { return [] }
        let m = member!
        // The provider guard: a same-file derive would need this file's
        // names while they are still being made. `check_annotation` speaks.
        if same_file(self.decls.decl(m).file, f) { return [] }
        if (self.decls.sig(m))?.fn_sig() == null { return [] }
        self.lifted_directives(m, f, w.stmt, w.callee, [], w.at)
    }

    /// The declaration at `s` as the value the fn's first seat asks
    /// for. Reads the PARSE store only: an expanded sibling is
    /// generated before this file's typed facts exist.
    fn crossed_decl(f: FileId, s: StmtId, want: TypeId, mut heap: MetaHeap) -> MetaVal {
        let found: DeclId? = self.decls.decls_of_file(f).find((c: DeclId) -> same_stmt(self.decls.decl(c).stmt, s))
        if found == null { return MetaVal.Absent }
        self.crossed_decl_of(found!, want, heap)
    }

    /// A declaration as the meta value its seat names — the receiver
    /// and an argument's NAME both cross here. The compiler builds
    /// `@std/meta`'s OWN record and the crossing lays out its slots,
    /// so a field that moves in the package breaks this build. The
    /// decl's own file supplies the parse it reads.
    fn crossed_decl_of(d: DeclId, want: TypeId, mut heap: MetaHeap) -> MetaVal {
        let x = self.decls.decl(d)
        let v = file_view(self.lang, self.parsed(x.file), self.decls, x.file)
        let at = placed(v, v.store.stmt_span(x.stmt))
        match self.decls.meta_seat(want) {
            .Fn -> meta_of_fn(MetaFn { name: x.name, params: self.crossed_params(v, x.stmt, d), answer: self.crossed_answer(v, x.stmt), at: at, answers: self.answer_kind(d) }, heap),
            .Type -> meta_of_type(MetaType { name: x.name, fields: self.crossed_fields(v, x.stmt, d), variants: self.crossed_variants(v, x.stmt, d), at: at }, heap),
            .Named -> meta_of_named(Named { name: x.name, at: at }, heap),
            .Trait -> meta_of_trait(MetaTrait { name: x.name, at: at }, heap),
            .Other -> MetaVal.Absent,
        }
    }

    /// A fn's parameters as `Param` values: name, the type's spelling
    /// AND ITS SHAPE, its `mut` and `const` marks.
    fn crossed_params(v: FileView, s: StmtId, d: DeclId) -> List<MetaParam> {
        let kinds = self.seat_kinds(d)
        [self.crossed_param(v, p, kind_at(kinds, j)) for j, p in v.store.declared_params(s)]
    }

    fn crossed_param(v: FileView, p: Param, k: Kind) -> MetaParam {
        MetaParam { name: p.name.of, ty: typed_text(self.decls.types, p.ty), mutable: p.promises.mutable, settled: p.promises.settled, at: placed(v, p.span), kind: k }
    }

    /// A fn's answer, spelled from its declared TypeRef — a store read
    /// alone, so crossing a declaration needs no typed facts.
    fn crossed_answer(v: FileView, s: StmtId) -> string {
        typed_text(self.decls.types, v.store.fn_parts(s)?.ret)
    }

    /// A record's fields as `Field` values: the spelling the program
    /// WROTE, and the shape its signature resolved it to.
    fn crossed_fields(v: FileView, s: StmtId, d: DeclId) -> List<MetaField> {
        let kinds = self.field_kinds(d)
        [crossed_field(v, p, kind_at(kinds, j)) for j, p in v.store.declared_fields(s)]
    }

    /// An enum's variants: name, payload spellings, and the payload
    /// as FIELDS — one writer, so a payload's name and its spelling
    /// cannot come from two places and disagree.
    fn crossed_variants(v: FileView, s: StmtId, d: DeclId) -> List<MetaVariant> {
        let rows = self.payload_kinds(d)
        [self.crossed_variant(v, va, kinds_at(rows, j)) for j, va in v.store.declared_variants(s)]
    }

    fn crossed_variant(v: FileView, va: Variant, kinds: List<Kind>) -> MetaVariant {
        MetaVariant { name: va.name.of, payload: [written_spelling(p.ty) for p in va.payloads], at: placed(v, va.span),
                      fields: [crossed_field(v, p, kind_at(kinds, j)) for j, p in va.payloads],
                      marks: crossed_marks(v, va.marks) }
    }

    /// A variant's payload shapes, variant by variant — the enum's
    /// own signature, positionally.
    fn payload_kinds(d: DeclId) -> List<List<Kind>> {
        let sig: EnumSig? = (self.decls.sig(d))?.enum_sig()
        if sig == null { return [] }
        [[kind_of(self.decls.types, t) for t in ps] for ps in sig!.payloads]
    }

    /// THE SHAPE COMES FROM THE SIGNATURE, NEVER FROM THE SPELLING.
    /// A written `TypeRef` resolves only the SCALAR words on its own
    /// (`spelled_type`), so a declared name read that way is no shape
    /// at all — which is exactly why the string seat beside this one
    /// answers "" for every declared type and always has. The
    /// declaration's own signature holds the TypeIds the compiler
    /// resolved, positionally; a declaration whose signature is not
    /// earned yet leaves every shape unspelled rather than guessing.
    fn seat_kinds(d: DeclId) -> List<Kind> {
        let sig: FnSig? = (self.decls.sig(d))?.fn_sig()
        if sig == null { return [] }
        [kind_of(self.decls.types, t) for t in sig!.params]
    }

    fn answer_kind(d: DeclId) -> Kind {
        let sig: FnSig? = (self.decls.sig(d))?.fn_sig()
        if sig == null { return no_kind() }
        kind_of(self.decls.types, sig!.ret)
    }

    fn field_kinds(d: DeclId) -> List<Kind> {
        let sig: StructSig? = (self.decls.sig(d))?.record_sig()
        if sig == null { return [] }
        [kind_of(self.decls.types, t) for t in sig!.types]
    }



    // ── Modules ──
    /// A path as a diagnostic shows it: under its package's source root.
    fn shown(path: string) -> string {
        below(path, self.packages[self.holder_of_path(path)].src)
    }

    /// The module a file belongs to: its directory under its package's
    /// source root, `.`-joined — "" for a file at the root package's
    /// source root, `@scope.name.a` for a dependency's.
    fn module_of(path: string) -> string {
        let pkg = self.packages[self.holder_of_path(path)]
        // EVERY FILE ITS OWN MODULE in a directory of programs: the
        // module is the file's path under the root, stem included, so
        // seventy programs' `P`s never share a namespace
        let rel = below(path, pkg.src)
        let local = if self.per_file { own_module(rel) } else { dir_of(rel).replace("/", ".") }
        if pkg.ordinal == 0 { return local }
        if local.is_empty() { return key_spelled(pkg.key) }
        "${key_spelled(pkg.key)}.${local}"
    }

    /// The files a module path names: a directory's `.av` files, else
    /// the one file, else nothing (the module does not exist). A
    /// directory holding its own `avra.toml` is a package, never a
    /// module of the one above it.
    fn module_files(m: ModulePath) -> List<string> {
        let pkg: Package? = self.holder(m)
        if pkg == null { return [] }
        let src = pkg!.src
        if self.crosses_package(src, m.local()) { return [] }
        let dir = m.dir_under(src)
        if self.host.is_dir(dir) {
            return [ joined_path(dir, f) for f in self.host.list(dir) if self.listed_source(dir, f) ]
        }
        let file = m.file_under(src)
        if self.host.exists(file) { return [file] }
        []
    }

    /// THE MODULES A MODULE IMPORTS — read from the PARSE, which is the ONE time
    /// they are free. The interface record keeps them so that every later
    /// question about them costs nothing, which is what lets validation decide
    /// whether to re-parse WITHOUT parsing.
    ///
    /// A file's `use` lines name paths qualified against the file's own package,
    /// which is exactly what the resolver does — the record must agree with the
    /// resolver about what an import MEANS, or it would validate a module
    /// against a contract it never had.
    fn imports_of(m: ModulePath) -> List<ModulePath> {
        flatten([self.imported_by(path) for path in self.module_files(m)])
    }

    /// The modules ONE file imports, each path qualified against the file's own
    /// package — the spelling the resolver uses, so the record cannot mean a
    /// different module than the compiler does.
    fn imported_by(path: string) -> List<ModulePath> {
        let from = self.packages[self.holder_of_path(path)]
        [qualified(module_path(u.path), from) for u in use_lines(self.parsed(self.file_id(path)))]
    }

    /// Whether a path — a directory or a file — is one its package's
    /// manifest EXCLUDES.
    fn excluded(path: string) -> bool {
        let pkg = self.packages[self.holder_of_path(path)]
        self.manifest(pkg.ordinal).excludes.any(under_dir(path, joined_path(pkg.root, it)) || path == joined_path(pkg.root, it))
    }

    /// A source file the package lists — `.av`, and not excluded.
    fn listed_source(dir: string, f: string) -> bool {
        is_source(f, dir) && !self.excluded(joined_path(dir, f))
    }

    /// Whether a directory is a package root of its own.
    fn is_package_dir(dir: string) -> bool {
        self.host.exists(joined_path(dir, "avra.toml"))
    }

    /// Whether a module path passes through a nested package — any
    /// directory along it holding its own manifest.
    fn crosses_package(src: string, local: List<string>) -> bool {
        mut j = 1
        while j <= local.length {
            if self.is_package_dir(joined_path(src, joined(local.slice(0, j), "/"))) { return true }
            j = j + 1
        }
        false
    }

    /// A file's declarations that speak for themselves — a NESTED one
    /// (refused by its feature, or an orphan of a failed parse) is
    /// asked only if a walk reaches it.
    fn top_level_decls(f: FileId) -> List<DeclId> {
        [d for d in self.decls.decls_of_file(f) if self.is_top_level(d)]
    }

    fn is_top_level(d: DeclId) -> bool {
        !self.decls.decl(d).nested
    }

    /// Every `.av` file under a directory, recursively, stopping at a
    /// nested package — `check <root>`. The empty root is a lone file's
    /// package of one: every name it was given is a file of it,
    /// whatever the name.
    fn all_files(dir: string) -> List<string> {
        mut out: List<string> = []
        for f in self.host.list(dir) {
            let full = joined_path(dir, f)
            if self.host.is_dir(full) {
                // a directory of programs holds only its own files
                if !self.per_file && !self.is_package_dir(full) && !self.excluded(full) { out = out.concat(self.all_files(full)) }
            } else if self.listed_source(dir, f) {
                out.push(full)
            }
        }
        out
    }

    /// The root package's source files — what `check <root>` analyzes.
    /// EVERY package's sources — the build's input set, from the DISK rather than from
    /// what resolution happened to load. This is what lets a held file be known without
    /// being resolved.
    fn every_source() -> List<string> {
        // A TEST IS NOT PROGRAM CODE. `all_files` walks every `.av` under a package's
        // source root, tests included, and analysing one as a program fails in its own
        // words — "a module file holds declarations, only the entry runs statements" —
        // which is a diagnostic about the TEST rather than about the build.
        [f for f in flatten([self.all_files(pkg.src) for pkg in self.packages]) if !self.is_test_path(f)]
    }

    /// Whether a source path is a package's TEST tree rather than its code.
    fn is_test_path(path: string) -> bool { path.contains("/tests/") }

    fn root_files() -> List<string> {
        self.all_files(self.packages[0].src)
    }

    /// The tree the toolchain's packages stand in: `<tree>/packages`
    /// when the host was given a std root, else nothing.
    fn toolchain_root() -> string {
        let std = self.host.std_root ?? ""
        if std == "" { "" } else { dir_of(std) }
    }

    /// Every directory a build reads: each admitted package's source
    /// root, and each of the toolchain's packages. Deliberately wide —
    /// `@std/*` is admitted only when a `use` first reaches for one, so
    /// a key over `self.packages` alone would miss the toolchain and
    /// reuse a stale artifact. Over-covering costs a rebuild; UNDER-
    /// covering is a silently wrong binary.
    fn closure_roots() -> List<string> {
        let std = self.host.std_root ?? ""
        let toolchain: List<string> = if std == "" { [] } else { [joined_path(std, d) for d in self.host.list(std) if self.host.is_dir(joined_path(std, d))] }
        sorted_texts([p.src for p in self.packages].concat(toolchain))
    }

    /// Every source file under a directory, `.av` alone — the same
    /// filter `all_files` applies, without its package boundary: the
    /// backend's and runtime's own trees hold no packages.
    fn engine_sources(dir: string) -> List<string> {
        mut out: List<string> = []
        for f in self.host.list(dir) {
            let full = joined_path(dir, f)
            if self.host.is_dir(full) { out = out.concat(self.engine_sources(full)) }
            else if f.ends_with(".c") || f.ends_with(".h") { out.push(full) }
        }
        out
    }

    /// Everything a whole-program build reads, ordered: the closure's
    /// `.av` files, the manifests, and the compiler's own non-package
    /// sources — the backend, the runtime, the Makefile. No `use`
    /// reaches for the last group, so nothing else would put them in
    /// the key, and a code-generator change must invalidate every
    /// module it could have emitted.
    export fn build_inputs() -> List<string> {
        let tree = self.toolchain_root()
        let engine: List<string> = if tree == "" { [] } else { [joined_path(tree, "Makefile")].concat(self.engine_sources(joined_path(tree, "backend"))).concat(self.engine_sources(joined_path(tree, "runtime"))) }
        sorted_texts(flatten([self.all_files(r) for r in self.closure_roots()]).concat(self.manifest_paths()).concat(engine))
    }

    /// Each closure root's manifest, where it has one.
    fn manifest_paths() -> List<string> {
        let at = [joined_path(r, "avra.toml") for r in self.closure_roots()]
        [p for p in at if self.host.exists(p)]
    }

    /// A module's exported declarations, in file and declaration order.
    fn exported_decls(m: ModulePath) -> List<Decl> {
        [self.decl_at(id) for id in flatten([self.items(self.file_id(f)) for f in self.module_files(m)]) if self.is_exported(id)]
    }

    fn is_exported(id: DeclId) -> bool {
        self.decl_at(id).exported
    }

    /// A module's exported names.
    fn surface(m: ModulePath) -> Map<string, DeclId> {
        mut out: Map<string, DeclId> = {}
        for d in self.exported_decls(m) { out.set(d.name, d.id) }
        out
    }

    /// One `use a.b.{x, y}`: a package root must exist, a named package
    /// must be one the asking package's manifest declares, the module
    /// must exist and be one thing, each item must be exported by it
    /// and listed once.
    fn imported_line(p: Parsed, u: UseParts) -> Imported {
        let at = loc_at(p.source.file, p.store.stmt_span(u.stmt))
        let from = self.packages[self.holder_of_path(p.source.file)]
        let m = qualified(module_path(u.path), from)
        if self.lone { return Imported { imports: [], diagnostics: [unpackaged_use(at)] } }
        if m.malformed() { return Imported { imports: [], diagnostics: [package_form(at, m)] } }
        if m.package() != null && !self.reaches(from, m.package()!) {
            return Imported { imports: [], diagnostics: [self.not_a_dependency(at, from, m.package()!)] }
        }
        if self.ambiguous_module(m) { return Imported { imports: [], diagnostics: [module_ambiguous(at, m)] } }
        if self.module_files(m).is_empty() { return Imported { imports: [], diagnostics: [no_module(at, m)] } }
        let surf = self.surface(m)
        mut imports: List<Import> = []
        mut diags: List<Diag> = []
        mut listed: List<string> = []
        for j, item in u.items {
            let alias = if j < u.aliases.length { u.aliases[j] } else { "" }
            let id: DeclId? = surf.get(item)
            if listed.contains(item) {
                diags.push(listed_twice(at, item))
            } else if id == null {
                diags.push(not_exported(at, m, item, self.exported_names(m)))
            } else {
                imports.push(Import { decl: id!, at: at, alias: alias })
            }
            listed.push(item)
        }
        Imported { imports: imports, diagnostics: diags }
    }

    /// A name that is both a directory and a file under the source root.
    fn ambiguous_module(m: ModulePath) -> bool {
        let pkg: Package? = self.holder(m)
        pkg != null && self.host.is_dir(m.dir_under(pkg!.src)) && self.host.exists(m.file_under(pkg!.src))
    }

    fn exported_names(m: ModulePath) -> List<string> {
        [d.name for d in self.exported_decls(m)]
    }

    // ── The whole program ──
    /// Every file under the root analyzed, in FileId order — each step
    /// asked for every file before the next, so the phases time apart.
    fn analyze_all() -> List<Analysis> {
        let t0 = self.clock()
        for path in self.root_files() { let _ = self.items(self.file_id(path)) }
        self.timed("parse", self.clock() - t0)
        // A HELD FILE IS NOT RESOLVED, NOT SIGNED AND NOT ANALYSED. Its declarations are
        // MINTED from its record, so every consumer sees the interface it had — and its
        // BODY is not wanted, because its object comes from the store. THIS IS WHERE THE
        // SUB-SECOND EDIT LIVES: one file read, 199 answered from what a previous build
        // wrote down.
        let t1 = self.clock()
        for fi in self.decls.files { if !self.is_held(fi.id) { let _ = self.resolved(fi.id) } }
        self.timed("resolve", self.clock() - t1)
        let t2 = self.clock()
        for fi in self.decls.files { if !self.is_held(fi.id) { let _ = self.sig_diagnostics(fi.id) } }
        self.timed("sigs", self.clock() - t2)
        let t3 = self.clock()
        let out = [self.analysis(fi.id) for fi in self.decls.files if !self.is_held(fi.id)]
        self.timed("bodies", self.clock() - t3)
        out
    }


    /// One file's analysis by path.
    fn analyze_file(path: string) -> Analysis {
        self.analysis(self.file_id(path))
    }

    /// The program rooted at `ws.root`, entered at one of its files.
    fn program(entry: string?) -> Program {
        let files = self.analyze_all()
        let at: int? = if entry == null { null } else { index_of_file(files, entry!) }
        let seat: Entry? = if at == null { null } else { Entry { at: at! } }
        Program {
            ws: self, files: files, entry: seat, phases: self.phases, cache: self.db.stats(), defects: self.defects,
            voices: self.packages_voiced(), manifests: [self.manifest_source(pkg) for pkg in self.packages if self.has_manifest(pkg)],
        }
    }

    /// Every case of every file, in file and declaration order.
    fn cases() -> List<TestCase> {
        flatten([self.file_cases(fi.id) for fi in self.decls.files])
    }

    /// The cases a workspace holds, known from PARSING alone: every
    /// file's items minted, nothing typed — so a package without cases
    /// says so before its dependencies are analyzed.
    mut fn parsed_cases() -> List<TestCase> {
        // the file table fills as files are first asked for — the root's
        // sources are entered here, each one's items minted; the parse
        // is timed as the parse phase it is
        let t0 = self.clock()
        for path in self.root_files() { let _ = self.items(self.file_id(path)) }
        self.timed("parse", self.clock() - t0)
        self.cases()
    }

    /// Whether every root source PARSED clean. A package that parsed to
    /// no cases has none only when nothing refused to parse — a broken
    /// spec file parses to nothing, and saying "no cases" of it would
    /// be a green over a red.
    /// WHETHER A FILE IS HELD — answered from a record rather than read. The one
    /// question the analysis asks before it does anything at all.
    fn is_held(f: FileId) -> bool { self.decls.held.get(self.decls.file(f).path) != null }

    /// WHETHER ONE FILE IS HELD — the hold is per FILE, because a module with fifty files
    /// holds forty-nine.
    mut fn hold_only(path: string) { self.decls.held.set(path, true) }

    /// ADMIT EVERY FILE — parse and mint the whole closure, which GROWS as a file's `use`
    /// lines admit packages. Held sigs are rebuilt from records and may name a PARSED
    /// module's type, so every name must exist before any held shape is filled.
    mut fn admit_all() {
        mut i = 0
        while i < self.decls.files.length {
            let _ = self.items(self.decls.files[i].id)
            i = i + 1
        }
    }

    /// HOLD A FILE: from here it contributes its MINTED declarations and its stored
    /// object, and nothing reads it.
    mut fn hold_file(path: string) { self.decls.held.set(path, true) }

    /// ADMIT THE PACKAGE A MODULE NAMES. A held file's `use` lines are never
    /// resolved, so a package they would have admitted is admitted here instead:
    /// the import graph is part of the interface, not a side effect of the parse.
    fn ensure_package(key: string) {
        let _ = self.std_admitted(key)
    }

    fn parse_clean() -> bool {
        self.root_files().all((f) -> !has_errors(self.parsed(self.file_id(f)).voices.list))
    }

    /// The cases of ONE file, named by the path it MEANS: both sides
    /// normalized, so `./` and a doubled slash select what the listing
    /// spelled cleanly.
    fn cases_at(path: string) -> List<TestCase> {
        let wanted = normalized(path)
        [c for c in self.cases() if normalized(c.at.file) == wanted]
    }

    /// A file's cases, its items minted first: a file enters the table
    /// at first mention, and a mention alone mints nothing.
    fn file_cases(f: FileId) -> List<TestCase> {
        let _ = self.items(f)
        let src = self.source(f)
        let store = self.decls.store_of(f)
        [self.test_case(src, store, self.decl_at(d)) for d in self.decls.decls_of_file(f) if self.is_case(d)]
    }

    fn is_case(d: DeclId) -> bool {
        self.decl_at(d).kind is .Case
    }

    /// The case's group from its spec's own list — its body is the key
    /// — and its line from the source.
    fn test_case(src: SourceFile, store: NodeStore, x: Decl) -> TestCase {
        let parts: SpecParts? = store.spec_parts(x.stmt)
        let written: Case = parts!.cases.find(same_body(it, x.root!))!
        let lo = self.decls.decl_span(x.id)!.lo
        TestCase {
            at: CaseRef { suite: x.owner, group: written.group, name: x.name, file: src.file, line: src.linecol(lo).line },
            symbol: self.decls.symbol(x.id),
        }
    }

    /// WHAT THE PROGRAM LINKS: every package's `[link]` promise, in
    /// package order — the objects it names under its own root, the
    /// directories it searches, the libraries it needs. A package that
    /// declares `extern fn` says here who keeps the promise.
    ///
    /// THE ROWS ARE TYPED AND THE OPTION LETTER IS OURS. A dependency
    /// names a directory or a library; `-L` and `-l` are written here,
    /// so no word a package spells can BECOME an option — the linker
    /// reads what it was told to read. `[link.raw]` carries an option
    /// verbatim and is heard from the program's own manifest alone.
    /// Each word is ONE argv element, so nothing in any of them means
    /// anything to a shell.
    fn link_words() -> List<string> {
        flatten([self.package_link(pkg) for pkg in self.packages])
    }

    fn package_link(pkg: Package) -> List<string> {
        let m = self.manifest(pkg.ordinal)
        [joined_path(pkg.root, o) for o in filled_words(m.objects)]
            .concat(["-L${d}" for d in filled_words(m.search)])
            .concat(["-l${l}" for l in filled_words(m.libs)])
            .concat(if pkg.ordinal == 0 { filled_words(m.raw) } else { [] })
    }

    /// THE PROGRAM'S OWN CLOSURE AS LIBRARIES the evaluator may open —
    /// one per package that owns native code, derived from the package's
    /// manifest NAME and never from a path a manifest wrote: a manifest
    /// path the toolchain OPENS is a load primitive, which is the
    /// write-primitive law at the same force.
    ///
    /// THE STEM CARRIES NO SUFFIX, so the platform question never enters
    /// the compiler: the evaluator tries the ones it knows and the
    /// refusal names the PACKAGE rather than a path only one machine has.
    /// A disagreement with `tools/libs.py`, which derives the same stem
    /// on the build side, is LOUD: nothing opens and the refusal names
    /// the package.
    fn linked_packages() -> List<LinkedPackage> {
        [self.linked_of(pkg) for pkg in self.packages if self.owns_native(pkg)]
    }

    fn owns_native(pkg: Package) -> bool {
        !self.manifest(pkg.ordinal).objects.is_empty()
    }

    fn linked_of(pkg: Package) -> LinkedPackage {
        let named = self.manifest(pkg.ordinal).name
        LinkedPackage { name: named, library: "build/lib${library_stem(named)}" }
    }

    /// The root package's entry file: its `[bin]` path, else
    /// `src/main.av` when that exists, else absence.
    fn entry_of() -> string? {
        let pkg = self.packages[0]
        let bin: string? = self.manifest(0).bin
        let path = joined_path(pkg.root, bin ?? "src/main.av")
        if bin == null && !self.host.exists(path) { return null }
        path
    }
}

fn is_type_decl(x: Decl) -> bool {
    x.kind is .Record || x.kind is .Named || x.kind is .Enum
}

/// A file's own module name: its path with `.av` dropped and `/`
/// as `.`.
fn own_module(rel: string) -> string {
    let stemmed = if rel.ends_with(".av") { rel.substring(0, rel.length - 3) } else { rel }
    stemmed.replace("/", ".")
}

/// A path's tail under a directory — the path itself when it is
/// not under it.
fn below(path: string, dir: string) -> string {
    if dir.is_empty() || !under_dir(path, dir) { return path }
    path.substring(dir.length + 1, path.length)
}

/// A source file: `.av`, or anything at all under the empty root —
/// a lone file's package of one holds exactly what it was given.
fn is_source(name: string, dir: string) -> bool {
    name.ends_with(".av") || dir.is_empty()
}

fn use_lines(p: Parsed) -> List<UseParts> {
    mut out: List<UseParts> = []
    for s in p.stmts {
        let u: UseParts? = p.store.use_parts(s)
        if u != null { out.push(u!) }
    }
    out
}

/// What one `use` line brought in, and what it earned.
type Imported = { imports: List<Import>, diagnostics: List<Diag> }

fn segments_of(dotted_text: string) -> List<string> {
    if dotted_text.is_empty() { return [] }
    dotted_text.split(".")
}

/// A whole program: every file analyzed together, and the entry
/// among them (none when the program is only checked). It answers
/// as a lone Analysis does — report, lowered, run — so every engine
/// takes either.
export type Program = { ws: Workspace, files: List<Analysis>, entry: Entry?, phases: List<Phase>, cache: string, defects: List<Diag>, voices: List<Diag>, manifests: List<SourceFile> }

/// A warning's kind under its package when it is a word; a kind
/// that is not one is dropped — the warning speaks kind-less.
fn worded_kind(package: string, kind: string?) -> string? {
    if kind == null || !is_kind_word(kind!) { return null }
    user_kind(package, kind)
}

/// Each kind once, the first row of a name kept.
fn distinct_codes(rows: List<DiagCode>) -> List<DiagCode> {
    mut seen: Map<string, bool> = {}
    mut out: List<DiagCode> = []
    for r in rows {
        if seen.get(r.kind) == null {
            seen.set(r.kind, true)
            out.push(r)
        }
    }
    out
}

/// A kinded constructor call as its source spells it: the kind
/// literal, and the message when that is a literal too.
type Kinded = { kind: string, message: string? }

impl Decls {
    /// A call to one of `@std/meta`'s KINDED constructors (`refuse_as`,
    /// `refuse_as_at`) whose kind is a literal; null for any other
    /// expression — the callee is judged by its DECLARATION's package,
    /// never by its written name.
    fn kinded_call(names: NameFacts, store: NodeStore, e: ExprId) -> Kinded? {
        let held: List<ExprId>? = match store.expr(e) { .Call(_, _, xs) -> xs, rest -> null }
        if held == null { return null }
        let args = held!
        let d: DeclId? = bound_decl_of(names, e)
        if d == null || self.package_of(d!) != "@std.meta" { return null }
        let message_at: int? = match self.decl(d!).name { "refuse_as" -> 1, "refuse_as_at" -> 2, _ -> null }
        if message_at == null || args.length <= message_at! { return null }
        let kind: string? = (store.expr(args[0])).text_of()
        if kind == null { return null }
        Kinded { kind: kind!, message: (store.expr(args[message_at!])).text_of() }
    }
}

/// The entry's seat among the program's files.
type Entry = { at: int }

/// One test case as the runner sees it: the library's reference —
/// its three names and its place — and the symbol that runs it.
export type TestCase = { at: CaseRef, symbol: string }

/// The case in one line — what a listing prints, and what a test
/// of the listing reads.
export fn case_words(c: TestCase) -> string {
    words(c.at)
}

fn same_body(c: Case, body: ExprId) -> bool {
    // LICENSED I9: node identity — ids compare by index
    c.body.index == body.index
}

/// A row's words with their `${NAME}` holes filled, dropping any
/// that fill to nothing. A hole naming nothing asks for NO WORD:
/// an empty one would be an argument the linker still counts, and a
/// bare `-L` eats the word after it.
/// A package's manifest name as a library stem: `@std/sqlite` becomes
/// `std-sqlite` — ONE leading `@` dropped, every `/` a `-`. The rule
/// is spelled twice, here and in `tools/libs.py`, and the halves must
/// be copyable into each other: "strip one leading `@`" is,
/// "strip every `@`" is not.
fn library_stem(named: string) -> string {
    let stripped = if named.starts_with("@") { named.substring(1, named.length) } else { named }
    stripped.replace("/", "-")
}

fn filled_words(words: List<string>) -> List<string> {
    [w for w in [expanded(x) for x in words] if !w.is_empty()]
}

/// A link input with its `${NAME}` holes filled from the
/// environment: a machine's own paths belong to the machine, not to
/// a checked-in manifest.
fn expanded(flag: string) -> string {
    let opens = flag.index_of("\${")
    if opens < 0 { return flag }
    let closes = closing_brace(flag, opens)
    if closes < opens { return flag }
    let head = flag.substring(0, opens)
    let name = flag.substring(opens + 2, closes)
    let tail = flag.substring(closes + 1, flag.length)
    expanded("${head}${avra_host_env(name)}${tail}")
}

/// Where the hole closes, or -1.
fn closing_brace(s: string, from: int) -> int {
    let at = s.substring(from, s.length).index_of("}")
    if at < 0 { return 0 - 1 }
    from + at
}

fn index_of_file(files: List<Analysis>, path: string) -> int? {
    for i, a in files {
        if a.view.source.file == path { return i }
    }
    null
}

fn unclean(a: Analysis) -> bool {
    !a.clean()
}

impl Program {
    /// The entry file's analysis — absent for a program only checked.
    fn entry_file() -> Analysis? {
        if self.entry == null { return null }
        self.files[self.entry!.at]
    }

    /// An annotation fn's signature, which IS its effect — `avra
    /// explain @name`. Null when no declared fn wears the name.
    fn explain_annotation(name: string) -> string? {
        let decls = self.ws.decls
        let hit = decls.decls.find((d: Decl) -> d.name == name && decls.fn_name(d.id) != null)
        if hit == null { return null }
        let decl = hit!
        let sig: FnSig? = (decls.sig(decl.id))?.fn_sig()
        if sig == null { return null }
        let holes = [decls.types.name_of(pt) for pt in sig!.params]
        let signature = "fn ${name}(${holes.join(", ")}) -> ${decls.types.name_of(sig!.ret)}"
        let doc = decls.store(decl.id).doc_comment(decl.stmt)
        if doc == null { signature } else { "${signature}\n\n${doc!.join("\n")}" }
    }

    /// A file's generated declarations, each in canonical source
    /// with its origin — the compact listing API retained for tools
    /// that want only generated declarations.
    fn generated_lines(f: FileId) -> List<string> {
        [self.decl_line(d) for d in self.ws.expanded(f)]
    }

    /// A file as compiled: written nodes in source order, with every
    /// generated declaration immediately after the declaration its
    /// annotation wrapped.
    fn expanded_source(f: FileId) -> string {
        let made = self.ws.expanded(f)
        let parsed = self.ws.parsed(f)
        mut chunks: List<string> = []
        mut attached: List<DeclId> = []
        for s in parsed.stmts {
            chunks.push(render_statement(parsed.store, s))
            let written: DeclId? = self.ws.decls.decl_of(f, s)
            if written != null {
                let name = self.ws.decls.decl(written!).name
                for d in made {
                    let provenance = self.ws.decls.provenance_of(d)
                    if provenance != null && provenance!.original == name {
                        chunks.push(self.decl_block(d))
                        attached.push(d)
                    }
                }
            }
        }
        // A malformed declaration table must not make a generated
        // node invisible. Clean programs attach every declaration;
        // recovery output keeps any orphan at the end.
        for d in made {
            if !attached.any(same_decl(it, d)) { chunks.push(self.decl_block(d)) }
        }
        joined(chunks, "\n\n")
    }

    /// One generated declaration as source with provenance appended.
    fn decl_line(d: DeclId) -> string {
        let source = render_statement(self.ws.decls.store(d), self.ws.decls.decl(d).stmt)
        let provenance = self.provenance_line(d)
        if provenance.is_empty() { source } else { "${source}   ${provenance}" }
    }

    fn decl_block(d: DeclId) -> string {
        let source = render_statement(self.ws.decls.store(d), self.ws.decls.decl(d).stmt)
        let provenance = self.provenance_line(d)
        if provenance.is_empty() { source } else { "${provenance}\n${source}" }
    }

    /// `// from @derive on Point — template …/derive.av:24`: who asked,
    /// what it names, and the quote the declaration was copied from.
    fn provenance_line(d: DeclId) -> string {
        let held = self.ws.decls.provenance_of(d)
        if held == null { return "" }
        let provenance = held!
        let template: string? = self.template_word(provenance.template)
        "// from @${provenance.ann} on ${provenance.original}${template ?? ""}"
    }

    /// The template's file and line, when the file is loaded.
    fn template_word(template: Loc?) -> string? {
        if template == null || template!.file == null { return null }
        let site = template!
        let path = site.file!
        let f: FileId? = self.ws.decls.paths.get(path)
        if f == null { return null }
        " — template ${path}:${self.ws.source(f!).linecol(site.lo).line}"
    }

    fn clean() -> bool { self.defects.is_empty() && !has_errors(self.voices) && !self.files.any(unclean(it)) }

    /// The packages' voices first (a manifest's trouble explains
    /// the rest), then every file's diagnostics, the workspace's
    /// defects last; "" means clean.
    ///
    /// THE BOUNDARY SPEAKS FIRST, AND ALONE. A refused `@std/meta`
    /// makes every expansion generate nothing, so every USE of a
    /// derived accessor refuses — a cascade of "no method" that names
    /// the boundary NOWHERE. Three build failures in one day read
    /// exactly that way, from three different causes, and the word
    /// "boundary" appeared in none of them. When the door refused,
    /// its refusal IS the report. The VERDICT still counts every
    /// diagnostic (`clean` is untouched): only the rendering stops
    /// explaining the wrong thing.
    fn report() -> string {
        let moved: string? = self.ws.decls.meta_disagreement()
        if moved != null { return self.rendered([foreign_package(moved!)]) }
        let files = [self.rendered(a.diagnostics) for a in self.files if unclean(a)]
        let heads: List<string> = if self.voices.is_empty() { [] } else { [self.rendered(self.voices)] }
        let tails: List<string> = if self.defects.is_empty() { [] } else { [self.rendered(self.defects)] }
        joined(heads.concat(files).concat(tails), "\n\n")
    }

    /// Diagnostics rendered over EVERY loaded source — a frame's
    /// window comes from the file its Loc names: a manifest, a file
    /// of this package, or the dependency file that wrote a template.
    fn rendered(ds: List<Diag>) -> string {
        let sources = self.manifests.concat([self.ws.source(f.id) for f in self.ws.decls.files])
        let codes = self.ws.lang.rows.codes.concat(self.spoken_codes(ds))
        joined([render_among(d, codes, sources) for d in ds], "\n\n")
    }

    /// The rows the PACKAGE kinds among `ds` render under — one per
    /// diagnostic that wears one, its message the summary. A kind
    /// spoken is registered by being spoken; `kind_rows` is the
    /// registry `avra explain` walks without a diagnostic in hand.
    fn spoken_codes(ds: List<Diag>) -> List<DiagCode> {
        [user_code(d.kind, d.message) for d in ds if is_user_kind(d.kind)]
    }

    /// THE PACKAGE KINDS `avra explain @scope/name:E1` answers from:
    /// every `refuse_as("E1", "…")` with a literal kind in the
    /// annotation fns the workspace holds (the complete walk — a
    /// dependency's fns are where a package's kinds are spelled, and
    /// `files` is the root's alone), and every kind an annotation in
    /// this program SPOKE, which is how a kind computed at run time
    /// registers.
    fn kind_rows() -> List<DiagCode> {
        let spoken = self.spoken_codes(flatten([a.diagnostics for a in self.files]).concat(self.voices))
        distinct_codes(spoken.concat(flatten([self.kind_rows_of(fi.id) for fi in self.ws.decls.files])))
    }

    fn kind_rows_of(f: FileId) -> List<DiagCode> {
        let decls = self.ws.decls
        let names = self.ws.resolved(f)
        flatten([self.kind_rows_in(names, d) for d in decls.decls_of_file(f) if decls.decl(d).root != null])
    }

    /// The kinds one declaration's body spells, hidden branches
    /// included: every call bound to `@std/meta`'s kinded constructors
    /// with a literal kind.
    fn kind_rows_in(names: NameFacts, d: DeclId) -> List<DiagCode> {
        let decls = self.ws.decls
        let x = decls.decl(d)
        let package = decls.package_of(d)
        let store = decls.store(d)
        mut rows: List<DiagCode> = []
        for e in store.every_expr(x.root!) {
            let spoken: Kinded? = decls.kinded_call(names, store, e)
            if spoken != null {
                let k = spoken!
                let kind: string? = user_kind(package, k.kind)
                if kind != null { rows.push(user_code(kind!, k.message ?? "spoken by `@${x.name}`")) }
            }
        }
        rows
    }

    /// The program as IR, memory strategy applied — every unit
    /// through the workspace's memo.
    fn lowered() -> Lowered { self.lowered_from(self.entry?.at, false) }

    /// The program lowered from `entry`: its main and what it
    /// reaches — or, with no entry, every declared body; `every`
    /// asks for every declared body under an entry too.
    fn lowered_from(entry: int?, every: bool) -> Lowered {
        self.lowered_as(entry, every, false)
    }

    /// The program lowered with EVERY FILE A PROGRAM: each file's main
    /// under its program symbol, beside every declared body — what a
    /// programs binary's entry calls in turn.
    fn programs_checked() -> Result<Lowered, string> {
        if !self.clean() { return .Err(self.report()) }
        let lo = self.lowered_as(null, true, true)
        if !lo.diagnostics.is_empty() { return .Err(self.rendered(lo.diagnostics)) }
        .Ok(lo)
    }

    fn lowered_as(entry: int?, every: bool, programs: bool) -> Lowered {
        let ws = self.ws
        memory(self.ws.decls.union(self.files, entry, every, programs, (w: Wanted) -> ws.lowered(ws.spec_id(w)))) with { libraries: ws.linked_packages() }
    }

    /// The lowered program, CHECKED — every file's analysis first,
    /// then lowering's own refusals.
    fn lowered_checked() -> Result<Lowered, string> { self.checked_from(self.entry?.at, false) }

    /// The program lowered for its cases, CHECKED: a case is a
    /// declaration nothing reaches, so every declared body lowers —
    /// under the entry's laws all the same.
    fn cases_checked() -> Result<Lowered, string> { self.checked_from(self.entry?.at, true) }

    fn checked_from(entry: int?, every: bool) -> Result<Lowered, string> {
        if !self.clean() { return .Err(self.report()) }
        let lo = self.lowered_from(entry, every)
        if !lo.diagnostics.is_empty() { return .Err(self.rendered(lo.diagnostics)) }
        .Ok(lo)
    }

    fn run() -> Result<string, string> {
        if self.entry == null { return .Err(self.rendered([no_target(self.ws.root)])) }
        run_lowered(self.lowered_checked()?)
    }

    /// Every test case the program declares.
    fn cases() -> List<TestCase> { self.ws.cases() }
    fn cases_at(path: string) -> List<TestCase> { self.ws.cases_at(path) }

    /// Everything wrong, rendered, as the refusal; or what merely
    /// warned, rendered, as the answer — "" when nothing spoke.
    fn check() -> Result<string, string> { self.check_bodies(false) }

    /// `check` over EVERY declared body, as `avra test` lowers them —
    /// a body nothing reaches from the entry is checked all the same.
    fn check_every() -> Result<string, string> { self.check_bodies(true) }

    fn check_bodies(every: bool) -> Result<string, string> {
        if !self.clean() { return .Err(self.report()) }
        let lowered = self.lowered_from(self.entry?.at, every).diagnostics
        if has_errors(lowered) { return .Err(self.rendered(lowered)) }
        .Ok(self.warnings())
    }

    /// The warnings alone, rendered — what a clean program still
    /// says.
    fn warnings() -> string {
        let spoken = self.voices.concat(flatten([a.diagnostics for a in self.files]))
        self.rendered([d for d in spoken if is_warning(d)])
    }
}

fn is_warning(d: Diag) -> bool {
    !is_error(d)
}

// ── The packages ──

fn empty_manifest() -> Manifest {
    Manifest { budgets: budgets_of(null, null), name: "", version: "", bin: null, lib: null, deps: [], deps_at: null, excludes: [], objects: [], search: [], libs: [], raw: [], tools: [], voices: [] }
}

impl Workspace {
    /// A package's manifest, read from its `avra.toml` — an INPUT: the
    /// revision moves only when the text did. A root without a manifest
    /// reads as an empty one, quietly.
    fn manifest(i: int) -> Manifest {
        let pkg = self.packages[i]
        let path = joined_path(pkg.root, "avra.toml")
        if !self.has_manifest(pkg) {
            return self.manifests.input(i, () -> empty_manifest(), (m: Manifest) -> 0)
        }
        self.manifests.input_loaded(i, () -> {
            let text = self.host.read(path)
            Loaded { value: read_manifest(new_source_file(path, text)), fingerprint: fp_str(text) }
        })
    }

    /// What a settlement may spend: the ROOT package's `[lifted]` rows,
    /// the measured defaults where it writes none.
    fn budgets() -> Budgets {
        self.manifest(0).budgets
    }

    fn has_manifest(pkg: Package) -> bool {
        self.host.exists(joined_path(pkg.root, "avra.toml"))
    }

    fn manifest_source(pkg: Package) -> SourceFile {
        let path = joined_path(pkg.root, "avra.toml")
        new_source_file(path, self.host.read(path))
    }

    /// The root package, then every path dependency reachable from its
    /// manifest: each admitted once by key, each judged — the directory
    /// holds a manifest, the manifest calls itself the keyed name, one
    /// key is one directory, and no cycle closes.
    mut fn load_packages(src: string) {
        let unnamed = Package { key: "", root: self.root, src: src, ordinal: 0, at: null, origin: Origin.Root }
        self.packages.push(unnamed)
        let m = self.manifest(0)
        self.decls.name_root(m.name)
        let named = unnamed with { key: m.name }
        self.packages.set(0, named)
        self.admit_dependencies(0, m, true, [m.name])
    }

    /// A package's dependencies admitted — tests' dependencies only for
    /// the root, since they never travel.
    fn admit_dependencies(i: int, m: Manifest, root: bool, chain: List<string>) {
        for d in m.deps {
            if !d.dev || root { self.admitted(d.key, normalized(joined_path(self.packages[i].root, d.path!)), d.at, dep_chain(d, chain)) }
        }
    }

    mut fn admitted(key: string, dir: string, at: Loc?, chain: List<string>) {
        if chain.contains(key) { return self.speak_package(dependency_cycle(at, chain.concat([key]))) }
        let known: Package? = self.packages.find(it.key == key)
        if known != null {
            if self.host.absolute(known!.root) != self.host.absolute(dir) { self.speak_package(duplicate_package(at, key, known!.root, dir)) }
            return
        }
        if !self.host.exists(joined_path(dir, "avra.toml")) { return self.speak_package(bad_dependency_path(at, key, dir)) }
        self.entered(key, dir, at, Origin.Declared, chain)
    }

    /// A std package the toolchain carries, admitted the first time a
    /// `use` names it: no manifest row, the std root's directory, its
    /// own dependencies admitted as any package's. A key the toolchain
    /// carries is EVERY package's to reach, whichever copy is held — a
    /// declared row pins or overrides the toolchain's, for the whole
    /// graph. A key the toolchain does not carry is nobody's here.
    fn std_admitted(key: string) -> bool {
        let dir? = self.host.std_dir(key) else { return false }
        if !self.host.exists(joined_path(dir, "avra.toml")) { return false }
        if self.packages.any(it.key == key) { return true }
        self.entered(key, dir, null, Origin.Toolchain, [])
        true
    }

    /// One package entered under a key: listed, its manifest read and
    /// held to the key, its dependencies admitted. THE FLOOR: the
    /// prelude declares no dependency, so the layering has a bottom.
    mut fn entered(key: string, dir: string, at: Loc?, origin: Origin, chain: List<string>) {
        let i = self.packages.length
        let pkg = Package { key: key, root: dir, src: joined_path(dir, "src"), ordinal: i, at: at, origin: origin }
        self.packages.push(pkg)
        let m = self.manifest(i)
        if m.name != key { self.speak_package(name_mismatch(at, key, m.name, dir)) }
        if key == prelude_key && !m.deps.is_empty() { return self.speak_package(prelude_depends(m.deps[0].at)) }
        self.admit_dependencies(i, m, false, chain.concat([key]))
    }

    mut fn speak_package(d: Diag) {
        self.package_voices.push(d)
    }

    /// Everything the packages said: each manifest's own voices, then
    /// the graph's.
    fn packages_voiced() -> List<Diag> {
        flatten([self.manifest(pkg.ordinal).voices for pkg in self.packages])
            .concat([borrowed_raw(pkg) for pkg in self.packages if self.raw_from_dependency(pkg)])
            .concat(self.package_voices)
    }

    /// A dependency asking for raw linker options: `[link.raw]` is the
    /// PROGRAM's hatch, so only ordinal 0 is heard.
    fn raw_from_dependency(pkg: Package) -> bool {
        pkg.ordinal != 0 && !self.manifest(pkg.ordinal).raw.is_empty()
    }

    /// The package a file belongs to — the one whose source root holds
    /// it, the deepest when nested; the root package otherwise.
    fn holder_of_path(path: string) -> int {
        // the DEEPEST package whose source root holds the path — a
        // nested package wins over the one around it; a path no package
        // holds is the root's (a lone file)
        // LICENSED I4: a max-by fold (the deepest holder), not a scan
        mut best: int? = null
        for pkg in self.packages {
            if under_dir(path, pkg.src) && (best == null || pkg.src.length > self.packages[best!].src.length) { best = pkg.ordinal }
        }
        best ?? 0
    }

    /// The package a module path names: the root package for a local
    /// path, a dependency by key, absence when no package has the key.
    fn holder(m: ModulePath) -> Package? {
        let k: string? = m.package()
        if k == null { return self.packages[0] }
        self.packages.find(it.key == k!)
    }

    /// A package reaches itself — its own files `use` it by name —
    /// every package its manifest declares, and every std package the
    /// toolchain carries, admitted on the first ask. The std packages
    /// are the toolchain's: no manifest row names them, and a row that
    /// does is a pin.
    fn reaches(from: Package, k: string) -> bool {
        k == from.key || self.depends_on(from, k) || self.std_admitted(k)
    }

    /// Whether a package's manifest declares the key.
    fn depends_on(from: Package, k: string) -> bool {
        self.manifest(from.ordinal).deps.any(it.key == k)
    }

    /// The dependency line a manifest lacks, as a structured fix when
    /// the package is already in the workspace (reached through
    /// another package's manifest): the path relative to the asking
    /// package's root after its last dependency.
    fn dependency_fix(from: Package, k: string) -> List<Suggestion> {
        let known: Package? = self.packages.find(it.key == k)
        if known == null { return [] }
        let m = self.manifest(from.ordinal)
        let line = "\"${k}\" = { path = \"${relative_path(from.root, known!.root)}\" }"
        let manifest_path = joined_path(from.root, "avra.toml")
        let text = if m.deps_at == null { "\n[dependencies]\n${line}\n" } else { "\n${line}" }
        let at = deps_offset(m) ?? self.host.read(manifest_path).length
        [Suggestion { confidence: Confidence.High, description: "add `${line}` under `[dependencies]` in `${manifest_path}`", edits: [Edit { loc: Loc { file: manifest_path, lo: at, hi: at }, replacement: text }] }]
    }

    fn not_a_dependency(at: Loc?, from: Package, k: string) -> Diag {
        let fixes = self.dependency_fix(from, k)
        let at_file = joined_path(from.root, "avra.toml")
        refusal("resolve.not_a_dependency", at, "`${k}` is not a dependency of this package", "in this use", "declare it under `[dependencies]` in `${at_file}` — `\"${k}\" = { path = \"…\" }`") with { suggestions: fixes }
    }
}

/// The one package every file sees without a `use`.
const prelude_key = "@std/prelude"

/// The chain a dependency's admission extends. A DEV EDGE STARTS ITS
/// OWN: the tests are the consumer and nothing depends on them, so a
/// package's test reaching a library that depends BACK on it closes no
/// cycle — `@std/text`'s program prints through `@std/io`, which reads
/// `@std/text`. A library edge carries the chain it came by.
fn dep_chain(d: Dependency, chain: List<string>) -> List<string> {
    if d.dev { return [] }
    chain
}

/// A module path as the whole workspace names it: a dependency's
/// own local path carries its package's head, so `use core.{…}`
/// inside `@std/avrac` names `@std.avrac.core` from anywhere.
fn qualified(m: ModulePath, from: Package) -> ModulePath {
    if m.packaged() || from.ordinal == 0 { return m }
    ModulePath { segments: key_spelled(from.key).split(".").concat(m.segments) }
}

// ── voices ──

/// A dependency's `[link.raw]`, refused. The whole point of the
/// typed rows is that a package nobody read cannot put an option on
/// the linker's line; the hatch is the program's own.
fn borrowed_raw(pkg: Package) -> Diag {
    refusal("manifest.borrowed_raw", pkg.at,
        "`${pkg.key}` asks for raw linker options, and `[link.raw]` is the program's own", "this dependency",
        "a dependency names what it needs — `objects`, `search`, `libs` under `[link]`; a raw option belongs in the manifest of the program being built")
}

fn package_form(at: Loc?, m: ModulePath) -> Diag {
    refusal("resolve.package_form", at, "`${m.text()}` names no package — a package is `@scope.name`", "in this use", "write the scope and the name, then the module: `@scope.name.a.{x}`")
}

fn no_module(at: Loc?, m: ModulePath) -> Diag {
    refusal("resolve.no_module", at, "no module `${m.text()}` under the package's source root", "in this use", "a module is a directory of `.av` files or one `.av` file, named from `src/` — `${m.dir_under("")}` was looked for")
}

fn not_exported(at: Loc?, m: ModulePath, item: string, exports: List<string>) -> Diag {
    refusal("resolve.not_exported", at, "`${m.text()}` does not export `${item}`", "in this use", "its exports: ${joined(exports, ", ")}")
}

fn module_ambiguous(at: Loc?, m: ModulePath) -> Diag {
    refusal("resolve.module_ambiguous", at, "`${m.text()}` is both a directory and a file under the root", "in this use", "a module is one or the other — keep `${m.dir_under("")}/` or `${m.dir_under("")}.av`")
}

fn listed_twice(at: Loc?, item: string) -> Diag {
    refusal("resolve.import_clash", at, "`${item}` is listed twice", "in this use", null)
}

fn unpackaged_use(at: Loc?) -> Diag {
    refusal("resolve.unpackaged", at, "this file is not in a package — `use` needs a root", "this use", "put an `avra.toml` at the package root, with this file under its `src/` — modules are named from there")
}

/// The instructions one settlement may run before it is refused.

/// An annotation answer's structural fingerprint for early cutoff.
fn lift_hash(r: LiftResult) -> int {
    match r {
        .Crossed(c) -> fp(77, [meta_hash(c.heap, c.answer)]),
        .Refused(why) -> fp(47, [unsettled_hash(why)]),
    }
}

/// A crossed value's structural fingerprint, the heap followed — what
/// the evaluator's fingerprinting is to a recalculation's early cutoff.
fn meta_hash(heap: MetaHeap, v: MetaVal) -> int {
    match v {
        .Int(n) -> fp(74, [n]),
        .Float(bits) -> fp(75, [bits]),
        .Bool(b) -> fp(76, [if b { 1 } else { 0 }]),
        .Text(s) -> fp(78, [fp_str(s)]),
        .Node(id) -> fp(79, [meta_hash(heap, x) for x in heap.nodes[id]]),
        .Map(id) -> fp(81, [fp_list([fp_str(k) for k in heap.maps[id].keys]), fp_list([meta_hash(heap, x) for x in heap.maps[id].values])]),
        .Absent -> fp(83, []),
    }
}

fn settlement_hash(s: Settlement) -> int {
    match s {
        .Held(value) -> fp(41, [value.fingerprint]),
        .Refused(why) -> fp(73, [unsettled_hash(why)]),
    }
}

fn unsettled_hash(why: Unsettled) -> int {
    match why {
        .Reach(words) -> fp(59, [fp_str(words)]),
        .Budget(words) -> fp(61, [fp_str(words)]),
        .Trap(words) -> fp(67, [fp_str(words)]),
        .Param(words) -> fp(84, [fp_str(words)]),
        .Spoken -> fp(71, []),
        .Recursive -> fp(123, []),
    }
}

/// A declared TypeRef as the crossing's text — parsed from the STORE
/// alone, "" when the word names a type only the namespace knows.
fn typed_text(types: TypeRegistry, ann: TypeRef?) -> string {
    let held: TypeId? = spelled_type(types, ann)
    if held == null { return "" }
    types.name_of(held!)
}

/// A shape by position — unspelled past the signature's end, which
/// is a declaration the crossing reached before its own sig.
fn kinds_at(rows: List<List<Kind>>, j: int) -> List<Kind> {
    if j >= rows.length { return [] }
    rows[j]
}

fn kind_at(kinds: List<Kind>, j: int) -> Kind {
    if j >= kinds.length { return no_kind() }
    kinds[j]
}

/// A DECLARED PARAMETER AS A `Field`. A record's field and an enum
/// payload are the SAME shape crossing, so one writer makes both —
/// a payload's name, its spelling and its shape cannot come from two
/// places and disagree, which is the property the crossing suite
/// asserts positionally.
fn crossed_field(v: FileView, p: Param, kind: Kind) -> MetaField {
    MetaField { name: p.name.of, ty: written_spelling(p.ty), at: placed(v, p.span), kind: kind, marks: crossed_marks(v, p.marks) }
}

/// A member's marks as the derive reads them — the word, its words,
/// and where it stands.
fn crossed_marks(v: FileView, ms: List<Mark>) -> List<MetaMark> {
    [MetaMark { name: m.name, args: m.args, at: placed(v, m.span) } for m in ms]
}

/// A source span as the place a meta value names.
fn placed(v: FileView, sp: Span?) -> Loc? {
    if sp == null { return null }
    Loc { file: v.source.file, lo: sp!.lo, hi: sp!.hi }
}

/// A type reference as the program WROTE it, "" for a written absence.
fn written_spelling(t: TypeRef?) -> string {
    if t == null { return "" }
    spelled(t!)
}

/// A claim set that is KNOWN and EMPTY, which is not the same value
/// as an unknown one — and the empty literal does not adopt a
/// nullable aggregate's want, so it is bound at its own type here and
/// the two answers read as the two facts they are.
fn claims_nothing() -> List<string> {
    let none: List<string> = []
    none
}

/// EVERY PART OR NONE — claim sets folded into one union, absent when
/// any part is absent. An unanswerable claim set POISONS the union
/// rather than shrinking it: shrinking would say "nothing reads this"
/// where the truth is "we cannot say yet", and refuse a mark that is
/// perfectly well claimed.
fn all_claims(each: List<List<string>?>) -> List<string>? {
    if each.any(it == null) { return null }
    flatten([c! for c in each])
}

/// A list type's element, or null for any other shape.
fn elem_of(types: TypeRegistry, ty: TypeId) -> TypeId? {
    match types.shape_of(ty) {
        .List(e) -> e,
        _ -> null,
    }
}

/// The arenas' counts now.
/// A named grammar statement readied for its block word, with the
/// file whose fns its actions name; null for any other statement or a
/// notation that does not parse.
fn readied_grammar(p: Parsed, s: StmtId, path: string) -> BlockGrammar? {
    let notation: SyntaxParts? = p.store.syntax_parts(s)
    if notation == null { return null }
    let gp = parse_grammar(notation!.text)
    if gp.built == null { return null }
    BlockGrammar { word: notation!.name, ready: ready(gp.built!), origin: path }
}

/// A template's body copied: its statements, or its arms.
type Copied = { stmts: List<StmtId>, arms: List<Arm> }

impl Workspace {
    /// A copied node whose source a sublanguage minted wears that
    /// sublanguage's library.
    fn note_foreign_origin(f: FileId, src: NodeStore, from: ExprId, id: ExprId) {
        let range: ForeignRange? = src.foreign.find((r: ForeignRange) -> r.lo <= from.index && from.index < r.hi)
        if range == null { return }
        let origin = self.file_id(range!.path)
        if !same_file(origin, f) { self.decls.note_origins(f, [id], [], [], origin) }
    }
}

impl Workspace {
    /// A body of nothing but holes, in the seat it is put in.
    fn holes_copied(f: FileId, fills: List<Node>, seat: HoleKind) -> Copied {
        match seat {
            .Arm -> Copied { stmts: [], arms: flatten([self.spliced_arms(f, x) for x in fills]) },
            .Expression or .Statement or .Name or .Binder or .Type -> Copied { stmts: flatten([self.spliced_stmts(f, x) for x in fills]), arms: [] },
        }
    }
}

/// Where a directive's code was written: its first template's file
/// and offset — the outer template when templates nest.
fn template_site(node: Node) -> Loc? {
    match node {
        .Template(file, at, _, _) -> Loc { file: file, lo: at, hi: at },
        .Many(items) -> { let first: Node? = items.first()
            if first == null { null } else { template_site(first!) } },
        .Name(_) or .Text(_) or .Int(_) or .Float(_) or .Bool(_) or .Interp(_, _) -> null,
    }
}

fn nothing_copied() -> Copied { Copied { stmts: [], arms: [] } }

fn misfit_defect(template: string, at: int, k: int) -> Diag {
    defect_at(at_template(template, at), "defect: hole ${k} of the template at offset ${at} was filled with a shape its seat does not take")
}

/// A template's own offset as a place — a template has no line.
fn at_template(template: string, at: int) -> Loc {
    Loc { file: template, lo: at, hi: at }
}

/// The words for a fill no seat can hold — the FILL's own, since the
/// splice cannot re-derive why a shape had nowhere to go.
fn unplaceable_fill(template: string, at: int, u: Unplaced) -> Diag {
    refusal("annotation.unplaceable", at_template(template, at),
            "a hole was filled with something no seat can hold", u.why,
            "a fill the compiler cannot place is spoken, never spliced")
}

/// A `List<Code>` — a run of templates — in a seat that holds ONE
/// value.
fn many_in_expression() -> string {
    "a list of templates has no expression position — splice it where a run belongs (statements, arms, binders), or fold the list into one template before the hole"
}

fn arena_marks(store: NodeStore) -> ArenaMarks {
    ArenaMarks { exprs: store.exprs.count(), stmts: store.stmts.count(), pats: store.pats.length }
}

/// A generated declaration's name is already the file's — the
/// annotation is asked to choose another.
/// An annotation that could not run — the DECLARING path's voice,
/// the validating path's words.
/// A mark no reader on this declaration claims. THE LAW LINE
/// OUTLIVES ITS MECHANISM: it says a mark is read by something that
/// CLAIMS it, never "by a derive" — a derive is who claims today, and
/// a law worded after its implementation goes stale the moment the
/// implementation moves. The mechanism belongs in the HELP, beside
/// the claims that ARE standing, so a typo reads as a typo.
fn unclaimed_mark(m: Mark, claimed: List<string>, at: Loc?) -> Diag {
    refusal("annotation.unread_mark", at, "every mark is read by something that claims it",
            "`@${m.name}` — nothing on this declaration reads it",
            claims_help(claimed))
}

fn claims_help(claimed: List<string>) -> string {
    if claimed.is_empty() { return "a mark is read by a `@derive` whose trait declares `marks`" }
    "the marks read here are ${joined(["`@${c}`" for c in sorted_texts(claimed)], ", ")}"
}

fn lift_failed(label: string, at: Loc?) -> Diag {
    refusal("annotation.unsettled", at, "an annotation could not run", label, "an annotation runs at compile time from pure computation alone")
}

/// THE PACKAGE'S OWN VOICE for a moved `@std/meta` — spoken whether
/// or not any annotation was reached, because the cascade that
/// follows a refused boundary can reach a file the crossing never
/// touched. The words are the annotation door's, so a reader who has
/// seen one has seen both.
fn foreign_package(moved: string) -> Diag {
    refusal("annotation.meta", null, "the compiler crosses `@std/meta`'s own shapes",
            "the compiler was built against another `@std/meta` — ${moved}",
            "build against the `@std/meta` this compiler ships")
}

fn generated_taken(ann: string, name: string, at: Loc?) -> Diag {
    refusal("annotation.generated_taken", at, "`@${ann}` generates `${name}`, which this file already declares", "asked here", "rename the written declaration, or the generated one")
}
