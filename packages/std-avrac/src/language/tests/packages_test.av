// Packages over an in-memory host: a root manifest names a path
// dependency, `use @scope.name.a.{x}` reaches its module, the graph's
// laws refuse in their own words, and the entry is the manifest's.
use @std.avrac.language.{avra, new_workspace, memory_host, analyze_file, program, module_of, root_files, entry_of}
use @std.avrac.diagnostics.{suggested}

/// A program (`app`) with a vendored dependency (`@corpus/greet`)
/// that itself depends on a second one (`@corpus/words`), and a
/// nested package under the root's own sources.
fn files() -> Map<string, string> {
    {
        "/w/avra.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@corpus/greet\" = { path = \"vendor/greet\" }\n",
        "/w/src/main.av": "use @corpus.greet.{greet}\ngreet(2)\n",
        "/w/src/tools/avra.toml": "[package]\nname = \"@corpus/tools\"\nversion = \"0.1.0\"\n",
        "/w/src/tools/src/t.av": "export fn t() -> int {\n    1\n}\n",
        "/w/vendor/greet/avra.toml": "[package]\nname = \"@corpus/greet\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@corpus/words\" = { path = \"../words\" }\n",
        "/w/vendor/greet/src/greet.av": "use @corpus.words.{word}\nexport fn greet(n: int) -> int {\n    n + word()\n}\n",
        "/w/vendor/words/avra.toml": "[package]\nname = \"@corpus/words\"\nversion = \"0.1.0\"\n",
        "/w/vendor/words/src/words.av": "export fn word() -> int {\n    40\n}\n",
    }
}

fn names() -> List<string> {
    ["/w/avra.toml", "/w/src/main.av", "/w/src/tools/avra.toml", "/w/src/tools/src/t.av",
     "/w/vendor/greet/avra.toml", "/w/vendor/greet/src/greet.av", "/w/vendor/words/avra.toml", "/w/vendor/words/src/words.av"]
}

fn workspace() -> Workspace {
    new_workspace(memory_host(files(), names()), "/w", avra())
}

/// The package with one file replaced.
fn with_file(path: string, text: string) -> Workspace {
    mut fs = files()
    fs.set(path, text)
    new_workspace(memory_host(fs, names()), "/w", avra())
}

/// The package with two files replaced or added.
fn with_two(p1: string, t1: string, p2: string, t2: string) -> Workspace {
    mut fs = files()
    fs.set(p1, t1)
    fs.set(p2, t2)
    new_workspace(memory_host(fs, names().concat([p1, p2])), "/w", avra())
}

fn both_deps() -> string {
    root_manifest("\"@corpus/greet\" = { path = \"vendor/greet\" }\n\"@corpus/words\" = { path = \"vendor/words\" }")
}

fn root_manifest(deps: string) -> string {
    "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\n${deps}\n"
}

fn ran(ws: Workspace) -> string? {
    match program(ws, "/w/src/main.av").run() {
        .Ok(text) -> text,
        .Err(_) -> null,
    }
}

/// The root file's ONE diagnostic.
fn main_diag(ws: Workspace) -> Diag? {
    let a = analyze_file(ws, "/w/src/main.av")
    if a.diagnostics.length != 1 { return null }
    a.diagnostics[0]
}

/// The root file's structured fixes as text; empty without a
/// diagnostic.
fn fixes(ws: Workspace) -> List<string> {
    let d: Diag? = main_diag(ws)
    if d == null { return [] }
    suggested(d!)
}

/// The packages' ONE voice, saying this.
fn package_voice(ws: Workspace, saying: string) -> bool {
    let p = program(ws, "/w/src/main.av")
    p.voices.length == 1 && p.rendered(p.voices).contains(saying)
}

spec "language/packages" {
    given "a dependency's module resolves through the manifests" {
        then "the entry runs through two packages" {
            let out: string? = ran(workspace())
            out == "42"
        }
        then "a package's own files reach it by its name" {
            ran(with_two("/w/vendor/greet/src/twice.av", "use @corpus.greet.greet.{greet}\nexport fn twice(n: int) -> int {\n    greet(n) * 2\n}\n",
                         "/w/src/main.av", "use @corpus.greet.twice.{twice}\ntwice(2)\n")) == "84"
        }
        then "a dependency file's module carries its package" {
            let ws = workspace()
            module_of(ws, "/w/vendor/greet/src/greet.av") == "@corpus.greet" &&
                module_of(ws, "/w/vendor/greet/src/deep/x.av") == "@corpus.greet.deep" &&
                module_of(ws, "/w/src/main.av") == ""
        }
        then "a nested package is not a module of the package above it" {
            let ws = workspace()
            let kind: string? = main_diag(with_file("/w/src/main.av", "use tools.src.t.{t}\n1\n"))?.kind
            root_files(ws).length == 1 && kind == "resolve.no_module"
        }
    }
    given "a package sees only what its manifest declares" {
        then "a transitive dependency is invisible, and the fix writes the line" {
            let ws = with_file("/w/src/main.av", "use @corpus.words.{word}\n1\n")
            let kind: string? = main_diag(ws)?.kind
            let fix = fixes(ws)
            kind == "resolve.not_a_dependency" && fix.length == 1 &&
                fix[0] == "/w/avra.toml: \n\"@corpus/words\" = { path = \"vendor/words\" }"
        }
        then "an unknown package has no fix to offer" {
            let d: Diag? = main_diag(with_file("/w/src/main.av", "use @nope.thing.{x}\n1\n"))
            d != null && d!.kind == "resolve.not_a_dependency" && fixes(with_file("/w/src/main.av", "use @nope.thing.{x}\n1\n")).is_empty()
        }
        then "a package is two segments" {
            let kind: string? = main_diag(with_file("/w/src/main.av", "use @corpus.{greet}\n1\n"))?.kind
            kind == "resolve.package_form"
        }
        then "a diamond over one directory is one package" {
            let ws = with_two("/w/avra.toml", both_deps(), "/w/src/main.av", "use @corpus.greet.{greet}\nuse @corpus.words.{word}\ngreet(1) + word()\n")
            let out: string? = ran(ws)
            program(ws, "/w/src/main.av").voices.is_empty() && out == "81"
        }
    }
    given "the graph's laws" {
        then "a cycle refuses naming it" {
            package_voice(with_file("/w/vendor/words/avra.toml", "[package]\nname = \"@corpus/words\"\nversion = \"0.1.0\"\n\n[dependencies]\n\"@corpus/greet\" = { path = \"../greet\" }\n"),
                          "packages depend in a cycle: app -> @corpus/greet -> @corpus/words -> @corpus/greet")
        }
        then "a dependency calls itself what it was keyed as" {
            package_voice(with_file("/w/vendor/greet/avra.toml", "[package]\nname = \"@corpus/greeting\"\nversion = \"0.1.0\"\n"),
                          "calls itself `@corpus/greeting`, not `@corpus/greet`")
        }
        then "a path dependency points at a package directory" {
            package_voice(with_file("/w/avra.toml", root_manifest("\"@corpus/greet\" = { path = \"vendor/nothing\" }")), "holds no `avra.toml`")
        }
        then "one key is one directory" {
            let ws = with_two("/w/avra.toml", root_manifest("\"@corpus/greet\" = { path = \"vendor/greet\" }\n\"@corpus/words\" = { path = \"vendor/words2\" }"),
                              "/w/vendor/words2/avra.toml", "[package]\nname = \"@corpus/words\"\nversion = \"0.1.0\"\n")
            package_voice(ws, "`@corpus/words` is claimed by two directories: `/w/vendor/words` and `/w/vendor/words2`")
        }
    }
    given "the entry and the warnings" {
        then "the entry is `[bin]`, else src/main.av" {
            let plain: string? = entry_of(workspace())
            let binned: string? = entry_of(with_file("/w/avra.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[bin]\npath = \"src/app.av\"\n"))
            plain == "/w/src/main.av" && binned == "/w/src/app.av"
        }
        then "an unknown section warns and never blocks" {
            let p = program(with_file("/w/avra.toml", root_manifest("\"@corpus/greet\" = { path = \"vendor/greet\" }") + "\n[grants]\nnetwork = []\n"), "/w/src/main.av")
            p.voices.length == 1 && p.voices[0].severity is .Warning && p.clean() && p.report().contains("warning[F4030]")
        }
    }
}
