// Doc comments: what attaches, what detaches, and where a group may
// not drift. Each row is an attack the red team ran against the
// lexer's anchor and the source projection.
use @std.avrac.language.{parse_source, render_source}

fn projected(source: string) -> string {
    let parsed = parse_source(source)
    if !parsed.voices.list.is_empty() { return "<parse refused>" }
    render_source(parsed.store, parsed.stmts)
}

spec "docs — the declaration-leading `///` surface" {
    given "what detaches a group" {
        then "an ordinary comment between a doc group and its declaration does not detach it" {
            projected("/// kept\n// note\nfn a() -> int { 1 }") == "/// kept\nfn a() -> int {\n    1\n}"
        }
        then "a blank line detaches a doc group" {
            projected("/// lost\n\nfn a() -> int { 1 }") == "fn a() -> int {\n    1\n}"
        }
        then "an orphan before a closing brace cannot drift to the next declaration" {
            !projected("fn a() -> int {\n    /// lost\n    1\n}\n\nfn b() -> int { 2 }").contains("lost")
        }
        then "a trailing doc cannot attach" {
            !projected("let x = 1 /// lost\nlet y = 2\nx + y").contains("lost")
        }
    }

    given "docs with no table are dropped" {
        // A module's `//!` and a variant's or field's `///` have no
        // table: they are not declaration-leading comments, and the
        // printer walks statements. ROADMAP records the ask; this row
        // must fail the day the tables land.
        then "a module, enum variant, or struct field doc is not retained" {
            !projected("//! module doc\nfn a() -> int { 1 }").contains("module doc") &&
                !projected("type S = {\n    /// lost\n    v: int,\n}").contains("lost") &&
                !projected("enum E {\n    /// lost\n    A,\n}").contains("lost")
        }
    }

    given "where a group lands" {
        then "a doc lands on the nested declaration it precedes, not its owner" {
            projected("fn outer() -> int {\n    /// inner\n    fn b() -> int { 2 }\n    b()\n}\nouter()") ==
                "fn outer() -> int {\n    /// inner\n    fn b() -> int {\n        2\n    }\n    b()\n}\n\nouter()"
        }
        then "a doc on the first declaration cannot bleed onto the second" {
            projected("/// one\nfn a() -> int { 1 }\nfn b() -> int { 2 }") ==
                "/// one\nfn a() -> int {\n    1\n}\n\nfn b() -> int {\n    2\n}"
        }
        then "a doc survives each declaration prefix the lexer accepts" {
            let out = projected("/// k\nconst K: int = 3\n\n/// e\nextern fn puts(s: string) -> int\n\n/// o\nonce fn seed() -> string { \"x\" }")
            out.contains("/// k\nconst K: int = 3") &&
                out.contains("/// e\nextern fn puts(s: string) -> int") &&
                out.contains("/// o\nonce fn seed() -> string")
        }
    }
}
