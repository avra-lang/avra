// The staged run's two pure parts: the plan's binary, and what a
// status means. Attacked at the edges: no `-o`, `-o` last, the
// statuses a trap, a signal and a missing binary produce.
use @std.avrac.language.{plan_binary, verdict_of}

spec "the link plan" {
    given "clang's words" {
        then "the binary is the word after -o" {
            plan_binary(["-w", "-O0", "m.ll", "-o", "build/m"]) == "build/m"
        }
        then "a plan without -o names no binary" {
            plan_binary(["-w", "-O0", "m.ll"]) == null
        }
        then "-o as the last word names no binary" {
            plan_binary(["-w", "m.ll", "-o"]) == null
        }
        then "an empty plan names no binary" {
            plan_binary([]) == null
        }
    }
}

spec "the verdict" {
    given "a status" {
        then "0 is green" { verdict_of(0) is .Green }
        then "1 is red" { verdict_of(1) is .Red }
        then "127 is a binary that could not start" { verdict_of(127) is .CouldNotStart }
        then "a trap's 2 is a death" { verdict_of(2) is .Died }
        then "a signal's 128+9 is a death" { verdict_of(137) is .Died }
    }
}
