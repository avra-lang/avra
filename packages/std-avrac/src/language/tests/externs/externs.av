// The host seam, natively: externs declared by their bare symbol,
// called through the runtime's own bodies.
extern fn avra_now_ns() -> int
extern fn avra_selfhost_file_exists(path: string) -> int
extern fn avra_host_is_dir(path: string) -> int
extern fn println(s: string)
extern fn avra_host_env(name: string) -> string
extern fn avra_selfhost_argc() -> int
extern fn avra_selfhost_get_arg_cstr(i: int) -> string
extern fn avra_proc_run(file: string, argv: List<string>, envp: List<string>, cwd: string, flags: int, stdin_text: string, timeout_ms: int, grace_ms: int, max_bytes: int) -> int
extern fn avra_proc_status(h: int) -> int
extern fn avra_proc_close(h: int)
extern fn avra_ptr_at(address: int) -> ptr?

/// An address as a pointer, told apart by its NICHE alone — the one
/// thing observable about a `ptr` is whether it is null, which is
/// exactly what a C sentinel of 0 means.
fn minted(p: ptr?) -> string {
    if p == null {
        "null"
    } else {
        "some"
    }
}

/// A child run to its end through the seam — stdin from /dev/null,
/// both streams captured, an empty environment — and its status
/// word as `tag:payload`, or the spawn's negated errno.
fn verdict(file: string, args: List<string>) -> string {
    let h = avra_proc_run(file, args, [], "", 16 + 2 + 4, "", 5000, 500, 0)
    if h < 0 { return "${h}" }
    let w = avra_proc_status(h)
    avra_proc_close(h)
    "${w / 4294967296}:${w - (w / 4294967296) * 4294967296}"
}

println("from the host")
// the host's own words — argv and the environment — are immortal
// text the program may hold, compare and pass but never owns
let env = avra_host_env("PATH")
let missing = avra_host_env("AVRA_NO_SUCH_VARIABLE_")
let arg0 = avra_selfhost_get_arg_cstr(0)
// a program run with its arguments as WORDS: the status is a TAGGED
// word (1 exited, 2 signalled — never a small code), a program that
// cannot start is a negated errno and no handle, and a word that would
// be a shell command means only itself
let exit3 = verdict("/bin/sh", ["-c", "exit 3"])
let absent = verdict("/definitely/no/such/program", [])
let killed = verdict("/bin/sh", ["-c", "kill -9 $$"])
let literal = verdict("/bin/sh", ["-c", "test \"$1\" = '; touch /tmp/PWNED ;'", "x", "; touch /tmp/PWNED ;"])
// AN ADDRESS BECOMES A POINTER, and only through this one named
// door: no cast, no widening seat. Zero IS the null pointer, so the
// niche carries the C sentinel with no extra word — SQLITE_STATIC is
// 0 and SQLITE_TRANSIENT is -1, and they differ by presence alone.
let at_zero = minted(avra_ptr_at(0))
let at_one = minted(avra_ptr_at(1))
let at_transient = minted(avra_ptr_at(0 - 1))
// what we printed before the child runs comes out BEFORE the child's
// words — a buffered stdout is flushed at the seam, or a pipe reorders
println("before the child")
let inherited = avra_proc_run("/bin/sh", ["-c", "echo from the child"], [], "", 128 + 256 + 512, "", 5000, 500, 0)
avra_proc_close(inherited)
println("after the child")
"${avra_now_ns() > 0} ${avra_selfhost_file_exists("/definitely/not/here")} ${avra_host_is_dir("packages/std-avrac/src/language/tests/externs")} ${avra_selfhost_file_exists("packages/std-avrac/src/language/tests/externs/externs.av")} ${env.length > 0} ${missing.length} ${avra_selfhost_argc() >= 1} ${arg0.length > 0} ${arg0 == avra_selfhost_get_arg_cstr(0)} ${exit3} ${absent} ${killed} ${literal} ${at_zero} ${at_one} ${at_transient}"
