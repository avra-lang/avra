// The first pass: uses resolve to definition sites, shadowing takes
// the latest, and an unresolved name earns the milestone error —
// kind, code, window, pointer, and a graded suggestion.
use @std.avrac.language.{avra, analyze_source, parse_source, resolve, binding_of, Binding, Resolution}
use @std.errors.{Confidence}
use @std.avrac.diagnostics.{new_source_file}
use @std.avrac.core.{ExprId}

/// A program's printed value, or "<refused>".
fn shown(source: string) -> string {
    analyze_source(source).ran() ?? "<refused>"
}

/// The statement index a use's Def binding names; -1 otherwise.
fn defined_at(r: Resolution, e: ExprId) -> int {
    let b: Binding? = binding_of(r, e)
    if b == null { return -1 }
    match b! {
        .Def(s) -> s.index,
        .Param(_) or .Pattern(_) -> -1,
    }
}

spec "language/resolve" {
    given "resolution facts" {
        then "a use resolves to its definition site" {
            let p = parse_source("let x = 1\nx")
            let r = resolve(p)
            let use_expr = p.store.stmt_value(p.stmts[1])!
            r.diagnostics.is_empty() && defined_at(r, use_expr) == 0
        }
        then "a later let shadows an earlier one" {
            let p = parse_source("let x = 1\nlet x = 2\nx")
            let r = resolve(p)
            defined_at(r, p.store.stmt_value(p.stmts[2])!) == 1
        }
    }
    given "the shadowing chain — the lookup ORDER is the law" {
        then "innermost outward: an inner scope beats a param beats the top level" {
            shown("let n = 1\nfn f(n: int) -> int {\n    if true {\n        let n = 100\n        n\n    } else { n }\n}\nf(10) + n") == "101"
        }
        then "a param beats the top level when no inner scope speaks" {
            shown("let n = 1\nfn f(n: int) -> int { n }\nf(41) + n") == "42"
        }
        then "each scope's name dies at its exit" {
            shown("let n = 1\nfn f(n: int) -> int {\n    if true {\n        let n = 100\n        n\n    } else { 0 } + n\n}\nf(41)") == "141"
        }
    }
    given "unresolved names" {
        then "a use before its definition names the remedy" {
            let p = parse_source("x\nlet x = 1")
            let r = resolve(p)
            r.diagnostics.length == 1 &&
                r.diagnostics[0].kind == "resolve.use_before_def" &&
                r.diagnostics[0].help != null
        }
        then "a typo one edit away suggests with High confidence" {
            let p = parse_source("let value = 1 + valu")
            let r = resolve(p)
            r.diagnostics.length == 1 &&
                r.diagnostics[0].kind == "resolve.unresolved" &&
                r.diagnostics[0].suggestions.length == 1 &&
                r.diagnostics[0].suggestions[0].confidence == Confidence.High &&
                r.diagnostics[0].suggestions[0].edits.length == 1 &&
                r.diagnostics[0].suggestions[0].edits[0].replacement == "value"
        }
        then "two edits away is Medium; far away is silent" {
            let near = parse_source("let value = 1\nvlaue")
            let rn = resolve(near)
            let far = parse_source("let alpha = 1\nzz")
            let rf = resolve(far)
            rn.diagnostics[0].suggestions[0].confidence == Confidence.Medium &&
                rf.diagnostics[0].suggestions.is_empty() && rf.diagnostics[0].help == null
        }
    }
    given "reserved words" {
        then "binding one is refused as reserved" {
            let r = resolve(parse_source("let systems = 1"))
            r.diagnostics.length == 1 && r.diagnostics[0].kind == "resolve.reserved"
        }
        then "binding a grammar keyword refuses — the list derives from the grammar" {
            let r = resolve(parse_source("let while = 1"))
            r.diagnostics.length == 1 &&
                r.diagnostics[0].message == "`while` is a keyword"
        }
        then "using one is reserved, never a typo hunt" {
            let r = resolve(parse_source("spawn"))
            r.diagnostics.length == 1 && r.diagnostics[0].kind == "resolve.reserved"
        }
        then "the rendering names the future keyword" {
            let lang = avra()
            let expected = """error[F3002]: `bare` is reserved for a future Avra feature
  ╭─[app.av:1:1]
1 │ let bare = 1
  · ┬
  · ╰── cannot be a name
──╯
help: pick another name — `bare` becomes a keyword"""
            lang.check(new_source_file("app.av", "let bare = 1")) == expected
        }
    }
    given "use before definition, rendered" {
        then "both places show: the use and the definition" {
            let lang = avra()
            let expected = """error[F3001]: `x` is used before its definition
  ╭─[app.av:1:1]
1 │ x
  · ┬
  · ╰── used here
──╯
  ╭─[app.av:2:1]
2 │ let x = 1
  · ┬
  · ╰── defined here
──╯
help: move the definition above this use"""
            lang.check(new_source_file("app.av", "x\nlet x = 1")) == expected
        }
    }
    given "the milestone gate" {
        then "avra check renders the world-class error" {
            let lang = avra()
            let expected = """error[F3000]: `y` is not defined
  ╭─[app.av:1:13]
1 │ let x = 1 + y
  ·             ┬
  ·             ╰── not defined anywhere in this program
──╯
help: did you mean `x`?"""
            lang.check(new_source_file("app.av", "let x = 1 + y")) == expected
        }
    }
}
