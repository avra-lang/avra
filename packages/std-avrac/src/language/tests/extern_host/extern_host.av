// proves: the extern host — the evaluator calling a linked C fn by
// name through one fully applied frame, answering what the native
// binary answers. Every seat class and every answer kind the frame
// carries: a text seat, a word seat, no seats at all, an FP seat, and
// answers that are a word, a pointer, absence, and foreign text.
extern fn avra_selfhost_file_exists(path: string) -> int
extern fn avra_host_is_dir(path: string) -> int
extern fn avra_selfhost_argc() -> int
extern fn avra_selfhost_get_arg_cstr(i: int) -> string
extern fn avra_ptr_at(address: int) -> ptr?
extern fn avra_float_text(d: float) -> string

/// A pointer told apart by its niche alone — the one thing
/// observable about a `ptr`.
fn minted(p: ptr?) -> string {
    if p == null { "null" } else { "some" }
}

let here = avra_host_is_dir("packages/std-avrac/src/language/tests/extern_host")
let missing = avra_selfhost_file_exists("/definitely/not/here")
let standing = avra_selfhost_file_exists("packages/std-avrac/src/language/tests/extern_host/extern_host.av")
let arg0 = avra_selfhost_get_arg_cstr(0)
"${here} ${missing} ${standing} ${avra_selfhost_argc() >= 1} ${arg0.length > 0} ${minted(avra_ptr_at(0))} ${minted(avra_ptr_at(1))} ${avra_float_text(1.5)} ${avra_float_text(0.0 - 2.25)}"
