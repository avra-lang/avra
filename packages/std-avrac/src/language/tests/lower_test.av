// The IR half of compilation: lowering is pure and SSA (an ident IS
// its definition's register), scopes are structure, and the memory
// pass releases a scope's managed values at its exit — Application
// strategy, reverse binding order.
use @std.avrac.core.{Ins, RtSig, distinct}
use @std.avrac.language.{analyze_source, Lowered, rt_sigs, rt_sig_of, rt_owns, render_ir}

fn ir_of(source: string) -> Lowered {
    analyze_source(source).lowered()
}

fn count_releases(l: Lowered) -> int {
    l.entry.ins.filter((i: Ins) -> i is .Release).length
}

/// Every box a program builds, across all bodies — the counting
/// probe behind the never-allocates law (ROADMAP: the nullable
/// representation).
fn boxes_built(l: Lowered) -> int {
    mut n = 0
    for b in l.fns.concat([l.entry]) {
        n = n + b.ins.filter(is_box_call(it)).length
    }
    n
}

fn is_box_call(i: Ins) -> bool {
    match i {
        .CallRt(_, callee, _) -> callee == "avra_array_new",
        _ -> false,
    }
}

/// The dyn subject: one contract, one signatory, one boxed call.
fn dyn_read() -> string {
    "trait Show {\n    fn show(self) -> int\n}\ntype P = { x: int }\nimpl Show for P {\n    fn show(self) -> int {\n        self.x\n    }\n}\nlet d: dyn Show = P { x: 3 }\nd.show()"
}

fn addr_syms(l: Lowered) -> List<string> {
    mut out: List<string> = []
    for i in l.entry.ins {
        match i {
            .FnAddr(_, sym) -> out.push(sym),
            _ -> {}
        }
    }
    out
}

fn call_ptrs(l: Lowered) -> int {
    l.entry.ins.filter((i: Ins) -> i is .CallPtr).length
}

/// A `string?` made and read through `??` — the niche subject.
fn niche_read() -> string {
    "fn f(b: bool) -> string? { if b { \"x\" } else { null } }\nf(true) ?? \"y\""
}

/// An `int?` made and read — the pair subject.
fn pair_read() -> string {
    "fn f(v: int) -> int? { v }\nf(1) ?? 0"
}

/// Every consumer of absence in one program — the law's witness.
/// Deliberately aggregate-free: a struct literal's box is a STRUCT
/// cost, and this law speaks only for the nullable's own lowering.
fn every_consumer() -> string {
    "fn g(b: bool) -> string? { if b { \"hi\" } else { null } }\n" +
    "fn half(n: int) -> int? { if n % 2 == 0 { n / 2 } else { null } }\n" +
    "fn fwd(v: int?) -> int? { v? + 1 }\n" +
    "let a = half(4) ?? 0\n" +
    "let b = half(4)!\n" +
    "let c = match half(3) {\n    v? -> v\n    null -> 0\n}\n" +
    "let d = g(true)?.length ?? 0\n" +
    "let e = fwd(half(4)) ?? 0\n" +
    "a + b + c + d + e"
}

/// The identity fn whose tail WIDENS into a nullable…
fn lifting_id_fn() -> string {
    "fn f(s: string) -> string? { s }\nf(\"a\") ?? \"b\""
}

/// …and its guarantee twin, instruction-for-instruction.
fn plain_id_fn() -> string {
    "fn f(s: string) -> string { s }\nf(\"a\")"
}

spec "language/lower" {
    given "arithmetic" {
        then "one scope, constants, one Bin, the answer's puts, exit 0" {
            let l = ir_of("1 + 2")
            l.diagnostics.is_empty() &&
                l.entry.ins[0] is .ScopeEnter && l.entry.ins.last()! is .Ret &&
                l.entry.ins.filter((i: Ins) -> i is .Bin).length == 1 &&
                l.entry.ins.filter((i: Ins) -> i is .ConstInt).length == 2 &&
                l.entry.ins.filter((i: Ins) -> i is .CallRtVoid).length == 1
        }
        then "an ident adds NO instruction — SSA by construction" {
            let direct = ir_of("1 + 2")
            let named = ir_of("let x = 1 + 2\nx")
            named.entry.ins.length == direct.entry.ins.length
        }
    }
    given "strings under the Application strategy" {
        then "each managed binding releases once, at scope exit" {
            let l = ir_of("let a = \"x\"\nlet b = \"y\"\nb")
            count_releases(l) == 2
        }
        then "scalars never release" {
            count_releases(ir_of("let n = 1 + 2\nn < 4")) == 0
        }
        then "string == lowers through the runtime" {
            ir_of("let t = \"a\" == \"b\"\n\"done\"").entry.ins.filter((i: Ins) -> i is .CallRt).length == 1
        }
    }
    given "THE LAW: nullability never allocates" {
        then "a pointer nullable builds NO box anywhere — the niche is free" {
            boxes_built(ir_of(niche_read())) == 0
        }
        then "a scalar nullable builds NO box either — the pair rides registers" {
            boxes_built(ir_of(pair_read())) == 0
        }
        then "widening a pointer into its nullable adds NO instruction" {
            let lifted = ir_of(lifting_id_fn())
            let plain = ir_of(plain_id_fn())
            lifted.fns[0].ins.length == plain.fns[0].ins.length
        }
        then "the whole nullable surface at once — still not one box" {
            boxes_built(ir_of(every_consumer())) == 0
        }
        then "`avra ir` SHOWS the pair — the pack and its element reads" {
            let text = render_ir(ir_of(pair_read()))
            text.contains("= pack ") && text.contains(".0") && text.contains(".1")
        }
    }
    given "the runtime registry" {
        then "a known callee answers its contract; an unknown answers null" {
            let known: RtSig? = rt_sig_of("avra_puts")
            let unknown: RtSig? = rt_sig_of("nonsense")
            known != null && unknown == null
        }
        then "ownership is provenance: fresh text owns, static text does not" {
            rt_owns("avra_int_text") && !rt_owns("avra_bool_text") && !rt_owns("nonsense")
        }
        then "every row names a distinct contract" {
            let names = [s.name for s in rt_sigs()]
            distinct(names).length == names.length
        }
    }
    given "the dyn box and its indirect call (T3)" {
        then "boxing writes one address per trait method, qualified" {
            let syms = addr_syms(ir_of(dyn_read()))
            syms.length == 1 && syms[0] == "P.show"
        }
        then "the call goes through the pointer, not a name" {
            call_ptrs(ir_of(dyn_read())) == 1
        }
        then "a boxed empty contract carries the value alone" {
            addr_syms(ir_of("trait Mark {\n}\ntype P = { x: int }\nimpl Mark for P {\n}\nlet d: dyn Mark = P { x: 1 }\n2")).length == 0
        }
    }
    given "the mut-cell protocol (ownership 11.5)" {
        then "seed retains; overwrite retains FIRST, releases old, stores; the scope settles the cell" {
            let expected = """scope application {
  r0 = int 1
  r1 = call avra_array_new()
  call avra_array_push(r1, r0)
  r2 = slot
  retain r1
  store r2 <- r1
  r3 = int 2
  r4 = call avra_array_new()
  call avra_array_push(r4, r3)
  retain r4
  call avra_cell_release(r2)
  store r2 <- r4
  r5 = load r2
  retain r5
  r6 = int 0
  r7 = call avra_array_get(r5, r6)
  r8 = call avra_int_text(r7)
  call avra_puts(r8)
  call avra_cell_release(r2)
  release r8
  release r5
  release r4
  release r1
}
ret 0"""
            render_ir(ir_of("type P = { x: int }\nmut a = P { x: 1 }\na = P { x: 2 }\na.x")) == expected
        }
    }
}
