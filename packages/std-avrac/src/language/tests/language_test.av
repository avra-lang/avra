// The driver seam: the canonical language assembles clean, programs
// parse through one fn, recovery holes are VISIBLE Stmt.Error nodes,
// and lex errors ride the same diagnostics list.
use @std.avrac.language.{assemble, language_features, parse_source, parse_program}
use @std.avrac.diagnostics.{DiagCode}
use @std.avrac.features.{LanguageFeature, feature}

/// A feature whose registered code collides with a built-in kind.
fn clashing() -> LanguageFeature {
    let rows = table<DiagCode> {
        kind        | id      | summary
        "lex.error" | "F9998" | "collides with the builtin kind"
    }
    feature("clash", "clash_rule = NAME") with { diags: rows }
}

spec "language" {
    given "the canonical language" {
        then "it assembles with no defects and the builtin registry" {
            let lang = assemble(language_features())
            lang.grammar != null && lang.diagnostics.length == 0 &&
                lang.codes.length == 5 && lang.codes[1].kind == "parse.expected" &&
                lang.codes[1].id == "F0100"
        }
        then "a feature registering a taken kind refuses assembly" {
            mut feats = [f for f in language_features()]
            feats.push(clashing())
            let lang = assemble(feats)
            lang.grammar == null && lang.diagnostics.length == 1 &&
                lang.diagnostics[0].kind == "language.defect" &&
                lang.diagnostics[0].message == "`lex.error`: diagnostic kind is registered more than once"
        }
        then "a real parse error checks end to end" {
            let lang = assemble(language_features())
            let expected = """error[F0100]: expected NAME while parsing `stmt`
  ╭─[app.av:2:5]
2 │ let = 3
  ·     ┬
  ·     ╰──
──╯"""
            lang.check("app.av", "let a = 1\nlet = 3") == expected &&
                lang.check(null, "let a = 1") == ""
        }
    }
    given "a well-formed program" {
        then "lets and expression statements land in order" {
            let p = parse_source("let x = 1 + y\nx")
            let let_ok = match p.store.stmt(p.stmts[0]) {
                .Let(name, _) -> name == "x",
                .ExprStmt(_) -> false, .Error -> false,
            }
            p.diagnostics.length == 0 && p.stmts.length == 2 && let_ok &&
                p.store.stmt(p.stmts[1]) is .ExprStmt
        }
    }
    given "a broken statement between good ones" {
        then "the hole is an explicit Error node, the neighbors are whole" {
            let p = parse_source("let a = 1\nlet = 3\nlet y = 2")
            let hole_ok = p.stmts.length == 3 && p.store.stmt(p.stmts[1]) is .Error
            let tail_ok = if p.stmts.length == 3 {
                match p.store.stmt(p.stmts[2]) {
                    .Let(name, _) -> name == "y",
                    .ExprStmt(_) -> false, .Error -> false,
                }
            } else { false }
            p.diagnostics.length == 1 && hole_ok && tail_ok
        }
    }
    given "a lex error" {
        then "it joins the diagnostics and parsing continues" {
            let p = parse_source("let a = 1\n$\nlet b = 2")
            let lets = [s for s in p.stmts if p.store.stmt(s) is .Let]
            p.diagnostics.length >= 1 && lets.length == 2
        }
    }
}
