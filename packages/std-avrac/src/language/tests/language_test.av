// The driver seam: the canonical language assembles clean, programs
// parse through one fn, recovery holes are VISIBLE Stmt.Error nodes,
// and lex errors ride the same diagnostics list.
use @std.avrac.core.{concat}
use @std.avrac.language.{avra, assemble, language_features, parse_source, project, builtin_codes}
use @std.avrac.grammar.{Diagnostic, Cause}
use @std.avrac.diagnostics.{code_for, new_source_file}
use @std.avrac.diagnostics.{DiagCode}
use @std.avrac.features.{LanguageFeature, feature}

/// True when a cause's projected kind is in the built-in registry.
fn cause_registered(c: Cause) -> bool {
    let d = Diagnostic { cause: c, message: "m", span: null, expected: [], in_rule: "r" }
    code_for(builtin_codes(), project(d, null).kind) != null
}

/// A feature whose registered code collides with a built-in kind.
fn clashing() -> LanguageFeature {
    let rows = table<DiagCode> {
        kind        | id      | summary
        "lex.error" | "F9998" | "collides with the builtin kind"
    }
    feature("clash", "clash_rule = NAME") with { diags: rows }
}

/// A feature whose registered F-code collides with a built-in id.
fn clashing_id() -> LanguageFeature {
    let rows = table<DiagCode> {
        kind         | id      | summary
        "clash.kind" | "F0001" | "collides with the builtin F-code"
    }
    feature("clashid", "clashid_rule = NAME") with { diags: rows }
}

spec "language" {
    given "the canonical language" {
        then "it assembles with no defects and the builtin registry" {
            let lang = avra()
            lang.grammar != null && lang.diagnostics.is_empty() &&
                code_for(lang.codes, "parse.expected") == "F0100" &&
                code_for(lang.codes, "resolve.unresolved") == "F3000" &&
                code_for(lang.codes, "type.mismatch") == "F2000"
        }
        then "a feature registering a taken kind refuses assembly" {
            let lang = assemble(language_features().concat([clashing()]))
            lang.grammar == null && lang.diagnostics.length == 1 &&
                lang.diagnostics[0].kind == "language.defect" &&
                lang.diagnostics[0].message == "`lex.error`: diagnostic kind is registered more than once"
        }
        then "a reused F-code refuses assembly — codes are API" {
            let lang = assemble(language_features().concat([clashing_id()]))
            lang.grammar == null && lang.diagnostics.length == 1 &&
                lang.diagnostics[0].message == "`F0001`: diagnostic code is registered more than once"
        }
        then "a real parse error checks end to end" {
            let lang = avra()
            let expected = """error[F0100]: expected NAME while parsing `stmt`
  ╭─[app.av:2:5]
2 │ let = 3
  ·     ┬
  ·     ╰──
──╯"""
            lang.check(new_source_file("app.av", "let a = 1\nlet = 3")) == expected &&
                lang.check(new_source_file(null, "let a = 1")) == ""
        }
    }
    given "the code table" {
        then "every engine cause projects to a registered kind" {
            let causes = [Cause.Lex, Cause.Expected, Cause.Trailing, Cause.Builder, Cause.Defect]
            causes.all(cause_registered(it))
        }
    }
    given "a commented program" {
        then "comments vanish; the program is untouched" {
            let p = parse_source("// leading\nlet x = 1 // trailing\n// alone\nx")
            p.diagnostics.is_empty() && p.stmts.length == 2
        }
    }
    given "a well-formed program" {
        then "lets and expression statements land in order" {
            let p = parse_source("let x = 1 + y\nx")
            let let_ok = match p.store.stmt(p.stmts[0]) { .Let(name, _) -> name == "x", _ -> false }
            p.diagnostics.is_empty() && p.stmts.length == 2 && let_ok &&
                p.store.stmt(p.stmts[1]) is .ExprStmt
        }
    }
    given "a broken statement between good ones" {
        then "the hole is an explicit Error node, the neighbors are whole" {
            let p = parse_source("let a = 1\nlet = 3\nlet y = 2")
            let hole_ok = p.stmts.length == 3 && p.store.stmt(p.stmts[1]) is .Error
            let tail_ok = match p.store.stmt(p.stmts[2]) { .Let(name, _) -> name == "y", _ -> false }
            p.diagnostics.length == 1 && hole_ok && tail_ok
        }
    }
    given "a lex error" {
        then "it joins the diagnostics and parsing continues" {
            let p = parse_source("let a = 1\n$\nlet b = 2")
            let lets = [s for s in p.stmts if p.store.stmt(s) is .Let]
            p.diagnostics.length >= 1 && lets.length == 2
        }
    }
}
