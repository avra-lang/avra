//! Runs a program. The driver owns refusal, statement order, the
//! slots, and the frames; HOW a node evaluates lives in its owning
//! feature's NodeSemantics. A VALUE IS A LITERAL NODE — `1 + 2`
//! reduces to a synthesized `IntLit(3)` — so a feature's literal is
//! its value representation, and this same reduction is tomorrow's
//! `@comptime` fold. A program with any diagnostic refuses to run:
//! past that gate there are no dynamic checks. Names cost nothing
//! at runtime — an ident reads its definition's slot through the
//! resolve target, a param reads its frame slot by index, and a
//! call is a fresh frame over the target's body.
use core.{Expr, StmtId, ExprId, filled}
use features.{EvalCx, StmtEvalCx}

type Evaluator = {
    a: Analysis,
    slots: List<ExprId?>,
    failures: List<string>,
}

/// The program's value node, or the report that made it unrunnable.
fn run_analysis(a: Analysis) -> Result<ExprId, string> {
    if !a.clean() { return Result.Err(a.report()) }
    let ev = Evaluator {
        a: a,
        slots: filled<ExprId?>(a.store.stmts.count(), null),
        failures: [],
    }
    let last: ExprId? = eval_stmts(ev, [], a.stmts)
    if !ev.failures.is_empty() { return Result.Err(ev.failures[0]) }
    if last == null { return Result.Err("the program is empty") }
    Result.Ok(last!)
}

/// Statements in order, each through its own StmtSemantics — the
/// ONE statement loop, top level and blocks alike. The driver owns
/// slots and the running last value.
fn eval_stmts(ev: Evaluator, frame: List<ExprId>, stmts: List<StmtId>) -> ExprId? {
    let cx = StmtEvalCx {
        store: ev.a.store,
        eval: (v: ExprId) -> eval_subtree(ev, frame, v),
        run_stmts: (body: List<StmtId>) -> run_stmt_list(ev, frame, body),
        write_slot: (target: StmtId, v: ExprId) -> ev.write_slot(target, v),
        assign_target: (s: StmtId) -> ev.a.assign_target(s),
        fail: (msg: string) -> ev.record(msg),
    }
    mut last: ExprId? = null
    for s in stmts {
        let v: ExprId? = stmt_semantics_of(ev.a.store.stmt(s)).eval_stmt(cx, s)
        if v != null {
            ev.write_slot(s, v!)
            last = v
        }
    }
    last
}

/// A statement list run for its effects alone — a loop body's turn.
fn run_stmt_list(ev: Evaluator, frame: List<ExprId>, stmts: List<StmtId>) {
    let _ = eval_stmts(ev, frame, stmts)
}

/// One subtree's value under one frame. The recursion IS the walk:
/// an impl asking for a child's value lands back here — so only the
/// branches an impl asks for ever run, and each call re-runs its
/// body under its own frame.
fn eval_subtree(ev: Evaluator, frame: List<ExprId>, e: ExprId) -> ExprId {
    let cx = EvalCx {
        store: ev.a.store,
        value_at: (k: ExprId) -> eval_subtree(ev, frame, k),
        def_value: (k: ExprId) -> def_value_of(ev, frame, k),
        alloc: (node: Expr) -> ev.a.store.alloc_expr(node, null),
        invoke: (call_e: ExprId, args: List<ExprId>) -> invoke_fn(ev, call_e, args),
        run_block: (stmts: List<StmtId>, value: ExprId) -> exec_block(ev, frame, stmts, value),
        fail: (msg: string) -> ev.record(msg),
    }
    semantics_of(ev.a.store.expr(e)).eval(cx, e)
}

/// A block's statements execute in order under the CURRENT frame,
/// slots landing as at top level; the value is the block's answer.
fn exec_block(ev: Evaluator, frame: List<ExprId>, stmts: List<StmtId>, value: ExprId) -> ExprId {
    let _ = eval_stmts(ev, frame, stmts)
    eval_subtree(ev, frame, value)
}

/// An ident's value: its param's frame slot, or its definition's
/// statement slot — resolution already paid for the lookup.
fn def_value_of(ev: Evaluator, frame: List<ExprId>, e: ExprId) -> ExprId? {
    let pi: int? = ev.a.param_at(e)
    if pi != null { return frame[pi!] }
    let target: StmtId? = ev.a.target(e)
    if target == null { return null }
    ev.slots[target!.index]
}

/// A call: the target's body under a fresh frame of the argument
/// values.
fn invoke_fn(ev: Evaluator, call_e: ExprId, args: List<ExprId>) -> ExprId {
    let target: StmtId? = ev.a.target(call_e)
    let body: ExprId? = if target == null { null } else { ev.a.store.fn_parts(target!)?.body }
    if body == null {
        ev.record("defect: a call without a fn target survived a clean analysis")
        return call_e
    }
    eval_subtree(ev, args, body!)
}

impl Evaluator {
    fn record(self, msg: string) {
        mut fs = self.failures
        fs.push(msg)
    }

    fn write_slot(self, s: StmtId, v: ExprId) {
        mut written = self.slots
        written.set(s.index, v)
    }
}

/// A value node as `avra run` prints it — the owner's projection.
fn print_value(a: Analysis, v: ExprId) -> string {
    semantics_of(a.store.expr(v)).printed(a.store, v) ?? "<unprintable>"
}
