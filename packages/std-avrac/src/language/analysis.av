//! The one artifact consumers hold: every pass's facts, every
//! diagnostic, and every question — analyze, report, run — as
//! methods. `analyze` is the only place pass order exists.
use core.{NodeStore, Expr, Stmt, StmtId, ExprId, TypeId, flatten, joined, DeclId, FileId, same_file}
use diagnostics.{Diag, DiagCode, SourceFile, render, new_source_file}
use features.{DeclSig, Decls, new_decls}

/// One source, fully analyzed: the tree, every pass's facts, every
/// diagnostic in pipeline order, and the code registry to render
/// them — the ONE self-sufficient artifact consumers hold. Passes
/// stay pure queries with ONE standard shape —
/// `pass(p, ...upstream facts) -> Facts` — and `analyze` is the
/// only place that knows their order.
export type Analysis = {
    p: ParsedProgram,
    resolution: Resolution,
    typing: Typing,
    decls: Decls,
    file: FileId,
    codes: List<DiagCode>,
    diagnostics: List<Diag>,
}

impl Analysis {
    /// Nothing is wrong.
    fn clean(self) -> bool { self.diagnostics.is_empty() }

    /// Every diagnostic rendered for the terminal; "" means clean.
    fn report(self) -> string {
        self.rendered(self.diagnostics)
    }

    /// Any diagnostics rendered for the terminal — analysis's or a
    /// later stage's, one look everywhere.
    fn rendered(self, ds: List<Diag>) -> string {
        joined([render(d, self.codes, self.p.source) for d in ds], "\n\n")
    }

    fn expr(self, e: ExprId) -> Expr { self.p.store.expr(e) }
    fn stmt(self, s: StmtId) -> Stmt { self.p.store.stmt(s) }

    /// What an expression's name resolves to, when it does — the
    /// ONE binding currency.
    fn binding(self, e: ExprId) -> Binding? { binding_of(self.resolution, e) }

    /// The mut binding an assignment writes, when resolve accepted it.

    /// What a statement DECLARED, when it declares — the fn's
    /// signature, the record's fields, the enum's variants.
    /// A declaring statement of this file, as its declaration.
    fn decl_of(self, s: StmtId) -> DeclId { self.decls.decl_of(self.file, s)! }

    /// Whether a declaration is this file's own.
    fn is_local(self, d: DeclId) -> bool { same_file(self.decls.decl(d).file, self.file) }

    /// This file's module.
    fn module(self) -> string { self.decls.file(self.file).module }

    /// An expression's type — total: every expression has one.
    fn type_at(self, e: ExprId) -> TypeId { type_of(self.typing, e) }

    /// An expression's type as text (the printing projection).
    fn type_name(self, e: ExprId) -> string {
        self.typing.types.name_of(self.type_at(e))
    }

    /// The program's printed answer, or the report/refusal that
    /// stopped it — the ONE semantics, interpreted over the SAME
    /// post-memory stream the backend compiles: every instruction,
    /// Retain and Release included, shared to the last bracket. A
    /// lone file is a program of one; the Program owns the law.
    fn run(self) -> Result<string, string> {
        lone_program(self).run()
    }

    /// The program as IR, memory strategy applied — what `avra
    /// build` compiles.
    fn lowered(self) -> Lowered {
        lone_program(self).lowered()
    }

    /// The lowered program, CHECKED — analysis diagnostics first,
    /// then lowering's own refusals, rendered the same way. THE
    /// seam every engine takes: run, emit, and build refuse
    /// identically or proceed identically.
    fn lowered_checked(self) -> Result<Lowered, string> {
        lone_program(self).lowered_checked()
    }

    /// The program's printed answer, or null when it refused.
    fn ran(self) -> string? {
        match self.run() {
            .Ok(text) -> text,
            .Err(_) -> null,
        }
    }
}

/// A file between its passes: parsed, resolved, its typer on the
/// shared table — waiting for the rounds.
export type Staged = { p: ParsedProgram, r: Resolution, t: Typer }

/// THE ROUNDS — the only place pass order exists past resolution:
/// every file's types, then traits, then fns, then impls, across
/// all files; only then each file's bodies. A signature may name
/// any file's declaration.
export fn typed_together(lang: Language, staged: List<Staged>, decls: Decls) -> List<Analysis> {
    for x in staged { x.t.declare_types() }
    for x in staged { x.t.declare_traits() }
    for x in staged { x.t.declare_fns() }
    for x in staged { x.t.declare_impls() }
    [lang.assembled(x.p, x.r, type_bodies(x.t), decls, x.t.file) for x in staged]
}

impl Language {
    /// The whole pipeline over ONE file — a program of one: its own
    /// declarations are its scope, and a `use` has no package to
    /// reach.
    fn analyze(self, src: SourceFile) -> Analysis {
        let p = parse_program(self, src)
        let decls = new_decls()
        let f = decls.file_id(src.file, "")
        let r = resolve(p, lone_namespace(decls, f, decls.admit(f, p.store, p.stmts), p))
        typed_together(self, [Staged { p: p, r: r, t: typer(p, r, decls, f) }], decls)[0]
    }

    /// The artifact from its passes' facts.
    fn assembled(self, p: ParsedProgram, r: Resolution, t: Typing, decls: Decls, f: FileId) -> Analysis {
        Analysis {
            p: p, resolution: r, typing: t, decls: decls, file: f, codes: self.codes,
            diagnostics: flatten([p.diagnostics, r.diagnostics, t.diagnostics]),
        }
    }

    /// Everything wrong with one source, rendered; "" means clean.
    /// EVERYTHING: analysis diagnostics first, and when those are
    /// clean, lowering's refusals too — check agrees with run and
    /// build about what is wrong.
    fn check(self, src: SourceFile) -> string {
        lone_program(self.analyze(src)).check()
    }
}
