//! The language driver: features -> one assembled grammar -> parsed
//! programs. The single seam every consumer parses through — tests
//! and `avra check` alike.
//!
//! The module, as the query graph asks it (workspace.av's
//! `Family` is the order):
//!   mod.av       assemble features; THE language (`avra()`)
//!   program.av   parse: text -> Parsed; the two semantics
//!                maps; the store's walk vocabulary
//!   resolve.av   names -> bindings, one file (NameFacts)
//!   typing.av    one declaration's body -> types (the walk, the facts)
//!   typing_declare.av   a declaration's signature; the types annotations write
//!   typing_impls.av     traits, impls, methods, the orphan rule
//!   analysis.av  every fact of one file in ONE artifact (Analysis)
//!   workspace.av the twelve families over the query kernel
//!                (query/db.av) and the Program facade. THE tables
//!                live in features/: decls.av (declarations),
//!                facts.av (the pass values and the contexts'
//!                reads), namespace.av (the binding and method-table
//!                laws).
//!   lower.av     one body -> IR (a unit), the program its entry's
//!                closure — THE semantics
//!   lower_walk.av       one body's walk; the contexts; the entry's answer
//!   lower_state.av      the lowering state's verbs: registers, slots, values
//!   interp.av    run: the IR interpreted, backend-identical
//!   memory.av    the memory strategy, per scope level
//!   llvm.av      the native backend (llvm_api.av: the C surface)
//!   ir_text.av   the IR's human projection (`avra ir`)
//!   codes.av     the built-in diagnostic registry
use core.{flatten}
use grammar.{Diagnostic, Ready, ready}
use features.{LanguageFeature, compose_grammar, builder_defects, code_defects, LanguageRows}
use diagnostics.{Diag, DiagCode, new_source_file}
use features.type_expr.{type_expr}
use features.stmt_spine.{stmt_spine}
use features.block.{block}
use features.let_stmt.{let_stmt}
use features.consts.{consts}
use features.consts.{consts}
use features.mutation.{mutation}
use features.loops.{loops}
use features.fns.{fns}
use features.expr_stmt.{expr_stmt}
use features.bool_lit.{bool_lit}
use features.if_expr.{if_expr}
use features.when_expr.{when_expr}
use features.structs.{structs}
use features.enums.{enums}
use features.nullable.{nullable}
use features.results.{results}
use features.impls.{impls}
use features.closures.{closures}
use features.expr_spine.{expr_spine}
use features.lists.{lists}
use features.maps.{maps}
use features.tables.{tables}
use features.grammar_lit.{grammar_lit}
use features.components.{components}
use features.modules.{modules}
use features.specs.{specs}
use features.str_lit.{str_lit}

/// A feature set assembled once: composed, parsed, merged, and gated
/// on grammar + builder coherence. `grammar` is null when assembly
/// found defects — they are the diagnostics. `keywords` derive from
/// the grammar's own literals — the features' fragments ARE the
/// keyword list.
export type Language = {
    features: List<LanguageFeature>,
    syntax: Ready?,
    keywords: List<string>,
    rows: LanguageRows,
    dispatch: Dispatch,
    diagnostics: List<Diag>,
}

export fn assemble(features: List<LanguageFeature>) -> Language {
    // NOTHING IS PARSED HERE. Each feature read its own
    // `grammar { … }` when the compiler ran; assembly is a merge.
    let g = compose_grammar(features).built.merged()
    // PREPARED ONCE: validated and indexed here, so a parse pays for
    // neither — and the defects the assembly gates on ARE that
    // validation, asked a single time.
    let rd = ready(g)
    let codes = code_registry(features)
    let defects = flatten([rd.defects, builder_defects(features, g), code_defects(codes)])
    if !defects.is_empty() { return unassembled(features, defects) }
    Language { features: features, syntax: rd, keywords: g.keywords(), rows: rows_of(features, codes), dispatch: new_dispatch(), diagnostics: [] }
}

/// The language's registries, gathered once from its features.
fn rows_of(features: List<LanguageFeature>, codes: List<DiagCode>) -> LanguageRows {
    LanguageRows {
        methods: flatten([f.methods for f in features]), types: flatten([f.types for f in features]),
        properties: flatten([f.properties for f in features]), codes: codes,
    }
}

/// Assembly refused: the defects, projected, are the language's
/// diagnostics.
fn unassembled(features: List<LanguageFeature>, defects: List<Diagnostic>) -> Language {
    Language { features: features, syntax: null, keywords: [], rows: rows_of(features, []), dispatch: new_dispatch(), diagnostics: as_defects(defects) }
}

/// Built-in codes plus every feature's registered codes, in feature
/// order — the registry `avra explain` walks.
fn code_registry(features: List<LanguageFeature>) -> List<DiagCode> {
    flatten([builtin_codes()].concat([f.diags for f in features]))
}

/// The Avra language: its features, in the order that defines it —
/// feature order is branch order is the language.
export fn language_features() -> List<LanguageFeature> {
    [
        stmt_spine(),   // a program IS statements — and the START rule
        closures(),     // `fn(int) -> bool` types and `(x: int) -> e`
                        // lambdas — BOTH keyword/paren-anchored, so they
                        // merge before type_expr's bare NAME and before
                        // the paren group in the primary ladder
        type_expr(),    // `int`, `int?` — the surface annotations share
        block(),        // { statements… value } — braces, defined once
        modules(),      // `use a.b.{x}` and the `export` prefix
        specs(),        // `spec "…" { given "…" { then "…" { … } } }` — keyword-anchored
        let_stmt(),
        consts(),      // `const NAME = v` — settled by the compiler,
                       // so a use is the value and never a load     // `let` names a value
        mutation(),     // `mut` declares; `name = e` reassigns
        loops(),        // `while c { statements }`
        bool_lit(),     // `true` and `false`
        if_expr(),      // `if c { a } else { b }`, an expression
        when_expr(),    // `when { c -> a, ..., _ -> d }`, total
        structs(),      // `type N = { f: t = d }`; literals BEFORE the bare NAME
        components(),   // `component N { config { … } }` and `component N inst { … }`
        nullable(),     // `null`, `a ?? b`, `v!`, and `match v { b? -> }`
                        // — its `match` arms are MORE SPECIFIC than an
                        // enum's, and enums' branch @expects its `}`, so
                        // this one must be tried first
        enums(),        // `enum N { A B }`; `match v { .A -> x }`, total
        impls(),        // `impl Target { … }` — methods, keyword-anchored
        results(),      // `fail` raises on the Result channel; keyword-
                        // anchored, so it merges with the statements
        fns(),          // `fn` declares a body; a call applies it — the
                        // call branch is NAME-HEADED, so it lands AFTER
                        // every keyword anchor: `if (c)` would otherwise
                        // parse as a call to a fn named `if`
        tables(),       // table<Row> { … } — a keyword anchor, before NAME
        grammar_lit(),  // grammar """ … """ — a keyword anchor, before NAME
        expr_spine(),   // literals, names, the operator ladder, postfix
        lists(),        // [e, e, e] — the first aggregate
        maps(),         // { "k": v } — string-keyed, insertion-ordered
        str_lit(),      // "text"
        expr_stmt(),    // the stmt FLOOR: a bare expression line, and it
                        // RECOVERS — every keyword statement merges first
    ]
}

/// THE language, assembled — one word to hold Avra.
export fn avra() -> Language {
    assemble(language_features())
}

/// The canonical language over one nameless source.
export fn parse_source(text: string) -> Parsed {
    parse_program(avra(), new_source_file("<source>", text))
}

/// The canonical language's whole pipeline over one nameless source.
export fn analyze_source(text: string) -> Analysis {
    avra().analyze(new_source_file("<source>", text))
}
