//! The LLVM projection of Lowered IR. The module is built through
//! the LLVM C API (the same wrapper every binary here already
//! links), verified function-by-function, and written as `.ll` text
//! for clang. Every fn body becomes its own function (declared
//! first, so call order never matters); `main` is the statement
//! list. Programs link OUR runtime (runtime/avra_runtime.c) —
//! printing, string equality, aggregates, and ownership — and
//! nothing else.
use core.{Ins, Reg, body_symbol, hosted_symbol, BinOp, UnOp, TypeId, TypeRegistry, RtKind, RtSig, rt_sigs, rt_sig_of}
use features.{nothing}

/// One body's emission world: the LLVM handles, this body's register
/// types, the growing register value table (dense by Reg — registers
/// mint in instruction order, params first), and the open regions,
/// innermost last.
type Emit = {
    lc: ptr,
    m: ptr,
    b: ptr,
    fn_val: ptr,
    types: TypeRegistry,
    tys: List<TypeId>,
    vals: List<ptr>,
    frames: List<Region>,
    loops: List<LoopFrame>,
    externs: List<RtSig>,
}

/// One open loop: where the back edge returns and where false exits.
type LoopFrame = { header: ptr, exit: ptr }

/// One open region: N arms merging into ONE value. `arms` holds
/// every arm's block in order and `next` the one to build when the
/// current arm ends; `ended`/`gives` accumulate each finished arm's
/// exit block and yielded register, which the merge phis together.
/// An `if` is the TWO-arm case of exactly this.
type Region = {
    arms: List<ptr>,
    next: int,
    merge_bb: ptr,
    ended: List<ptr>,
    gives: List<Reg>,
}

/// A user fn's symbol — prefixed clear of the runtime and `main`.
fn mangled(name: string) -> string {
    "av_${name}"
}

/// Write the program as verified `.ll` text; null means written, a
/// string is the failure.
export fn emit_ll(l: Lowered, path: string) -> string? {
    let lc = avra_llvm_context_create()
    let m = avra_llvm_module_create("avra", lc)
    let b = avra_llvm_create_builder(lc)
    let missing: string? = unheld_name(l)
    if missing != null { return "internal compiler error: nothing declares `${missing!}` — the program is not closed" }
    declare_runtime(lc, m)
    declare_externs(lc, m, l.externs)
    for bd in l.fns { declare_user(lc, m, l.types, bd) }
    for bd in l.fns {
        let f = avra_llvm_get_named_function(m, mangled(bd.name))
        let failure: string? = emit_body(lc, m, b, l.types, l.externs, bd, f)
        if failure != null { return wreck(m, path, failure!) }
    }
    let failure: string? = emit_entry(lc, m, b, l)
    if failure != null { return wreck(m, path, failure!) }
    if avra_llvm_print_module_to_file(m, path) != 0 {
        return "cannot write `${path}`"
    }
    avra_llvm_dispose_builder(b)
    avra_llvm_context_dispose(lc)
    null
}

/// THE CLOSURE LAW: every name a program's steps call is one the
/// module will declare — a body the program lowered, a runtime row,
/// or one of its own externs. The first that is not, named, instead
/// of a null function at emission.
fn unheld_name(l: Lowered) -> string? {
    let bodies = [bd.name for bd in l.fns].concat([l.entry.name])
    let hosted = [s.name for s in rt_sigs()].concat([s.name for s in l.externs])
    for bd in l.fns.concat([l.entry]) {
        for i in bd.ins {
            let body: string? = body_symbol(i)
            if body != null && !bodies.contains(body!) { return body }
            let host: string? = hosted_symbol(i)
            if host != null && !hosted.contains(host!) { return host }
        }
    }
    null
}

/// THE ENTRY. The program's own statements become `av_entry`; C's
/// `main` hands the runtime its arguments and answers what the
/// entry answered. The argument pair crosses the seam exactly here
/// — a program reads it through the host from then on.
fn emit_entry(lc: ptr, m: ptr, b: ptr, l: Lowered) -> string? {
    declare(m, "avra_args_init", avra_llvm_void_type(lc),
            [avra_llvm_int64_type(lc), avra_llvm_pointer_type(lc)], false)
    declare(m, "av_entry", avra_llvm_int32_type(lc), [], false)
    let entry = avra_llvm_get_named_function(m, "av_entry")
    let failure: string? = emit_body(lc, m, b, l.types, l.externs, l.entry, entry)
    if failure != null { return failure }
    open_main(lc, m, b, entry)
}

/// `int main(int argc, char** argv)`: the arguments handed over,
/// then the entry.
fn open_main(lc: ptr, m: ptr, b: ptr, entry: ptr) -> string? {
    declare(m, "main", avra_llvm_int32_type(lc),
            [avra_llvm_int32_type(lc), avra_llvm_pointer_type(lc)], false)
    let f = avra_llvm_get_named_function(m, "main")
    avra_llvm_position_at_end(b, avra_llvm_append_basic_block(lc, f, "entry"))
    let init = avra_llvm_get_named_function(m, "avra_args_init")
    let args = avra_llvm_value_array_new(2)
    avra_llvm_value_array_set(args, 0, avra_llvm_cast_to_type(b, avra_llvm_get_param(f, 0), avra_llvm_int64_type(lc)))
    avra_llvm_value_array_set(args, 1, avra_llvm_get_param(f, 1))
    avra_llvm_build_call(b, avra_llvm_fn_type_of(init), init, args, 2, "")
    avra_llvm_value_array_free(args)
    let seatless = avra_llvm_value_array_new(0)
    let answer = avra_llvm_build_call(b, avra_llvm_fn_type_of(entry), entry, seatless, 0, "code")
    avra_llvm_value_array_free(seatless)
    let _ = avra_llvm_build_ret(b, answer)
    if avra_llvm_verify_function(f) != 0 { return "internal compiler error: LLVM verification failed for main" }
    null
}

/// One body into one function: params seed the value table, every
/// instruction emits, the verifier gates.
fn emit_body(lc: ptr, m: ptr, b: ptr, types: TypeRegistry, externs: List<RtSig>, bd: Body, f: ptr) -> string? {
    mut vals: List<ptr> = []
    // LICENSED I3: a RANGE walk — comprehensions iterate lists only
    for j in 0..bd.params.length { vals.push(avra_llvm_get_param(f, j)) }
    let em = Emit {
        lc: lc, m: m, b: b, fn_val: f, types: types,
        tys: bd.reg_types, vals: vals, frames: [], loops: [], externs: externs,
    }
    avra_llvm_position_at_end(b, avra_llvm_append_basic_block(lc, f, "entry"))
    for i in bd.ins { emit_ins(em, i) }
    if avra_llvm_verify_function(f) != 0 {
        return "internal compiler error: LLVM verification failed for ${bd.name}"
    }
    null
}

/// The verifier's own report goes to stderr; the module still writes
/// so the wreck is inspectable.
fn wreck(m: ptr, path: string, failure: string) -> string {
    let _ = avra_llvm_verify_module_print(m)
    let _ = avra_llvm_print_module_to_file(m, path)
    "${failure} (module at ${path})"
}

/// The runtime surface, declared straight from the registry —
/// runtime_api.av is the one definition, runtime/avra_runtime.c
/// its implementation twin.
fn declare_runtime(lc: ptr, m: ptr) {
    for s in rt_sigs() {
        declare(m, s.name, ll_rt_kind(lc, s.ret), [ll_rt_kind(lc, k) for k in s.params], false)
    }
}

/// The program's own host fns, declared like the runtime's rows.
fn declare_externs(lc: ptr, m: ptr, rows: List<RtSig>) {
    for s in rows {
        declare(m, s.name, ll_rt_kind(lc, s.ret), [ll_rt_kind(lc, k) for k in s.params], false)
    }
}

fn ll_rt_kind(lc: ptr, k: RtKind) -> ptr {
    match k {
        .I64 -> avra_llvm_int64_type(lc),
        .Ptr -> avra_llvm_pointer_type(lc),
        .Void -> avra_llvm_void_type(lc),
    }
}

/// One user fn's declaration, typed from its signature's shapes.
fn declare_user(lc: ptr, m: ptr, types: TypeRegistry, bd: Body) {
    declare(m, mangled(bd.name), ll_type_of(lc, types, bd.ret),
            [ll_type_of(lc, types, pt) for pt in bd.params], false)
}

fn declare(m: ptr, name: string, ret: ptr, params: List<ptr>, variadic: bool) {
    let arr = avra_llvm_type_array_new(params.length)
    for (i, p) in params.enumerate() { avra_llvm_type_array_set(arr, i, p) }
    let vararg = if variadic { 1 } else { 0 }
    avra_llvm_add_function(m, name, avra_llvm_function_type(ret, arr, params.length, vararg))
    avra_llvm_type_array_free(arr)
}

/// A shape's LLVM type.
fn ll_type_of(lc: ptr, types: TypeRegistry, ty: TypeId) -> ptr {
    match types.shape_of(ty) {
        // TypeName never materializes: no value ever has it — nor
        // does Var: mono substitutes before any register minted.
        .Int or .Error or .TypeName(_, _) or .Var(_, _, _) or .Void -> avra_llvm_int64_type(lc),
        .Bool -> avra_llvm_int1_type(lc),
        .Opt(inner) -> opt_ll_type(lc, types, inner),
        .Str or .Ptr or .List(_) or .Struct(_, _) or .Enum(_, _) or .Dyn(_, _) or .Fn(_, _) or
        .Res(_, _) or .App(_, _, _) or .Null or .EmptyList or .Map(_, _) or .EmptyMap -> avra_llvm_pointer_type(lc),
    }
}

/// A nullable's machine type: the niche IS its value's pointer; a
/// scalar pair is a first-class {present: i1, value} aggregate that
/// lives in registers and never touches memory.
fn opt_ll_type(lc: ptr, types: TypeRegistry, inner: TypeId) -> ptr {
    if types.rides_pointer(inner) { return avra_llvm_pointer_type(lc) }
    let arr = avra_llvm_type_array_new(2)
    avra_llvm_type_array_set(arr, 0, avra_llvm_int1_type(lc))
    avra_llvm_type_array_set(arr, 1, ll_type_of(lc, types, inner))
    let st = avra_llvm_struct_type(lc, arr, 2)
    avra_llvm_type_array_free(arr)
    st
}

/// A register's LLVM type.
fn reg_type(em: Emit, r: Reg) -> ptr {
    ll_type_of(em.lc, em.types, em.tys[r.index])
}

/// The indirect call: the fn TYPE derives from the site's own
/// registers (ret from dst, params from args), so the built type
/// matches the callee that boxing named — every seat is cast to
/// its register's declared shape on the way in.
fn call_ptr_value(em: Emit, d: Reg, f: Reg, args: List<Reg>) -> ptr {
    let ptys = avra_llvm_type_array_new(args.length)
    for (j, a) in args.enumerate() {
        avra_llvm_type_array_set(ptys, j, ll_type_of(em.lc, em.types, em.tys[a.index]))
    }
    let fty = avra_llvm_function_type(ll_type_of(em.lc, em.types, em.tys[d.index]), ptys, args.length, 0)
    avra_llvm_type_array_free(ptys)
    let vargs = avra_llvm_value_array_new(args.length)
    for (j, a) in args.enumerate() {
        avra_llvm_value_array_set(vargs, j,
            avra_llvm_cast_to_type(em.b, em.vals[a.index], ll_type_of(em.lc, em.types, em.tys[a.index])))
    }
    let fp = avra_llvm_cast_to_type(em.b, em.vals[f.index], avra_llvm_pointer_type(em.lc))
    avra_llvm_build_call(em.b, fty, fp, vargs, args.length, "")
}

fn call(em: Emit, name: string, args: List<ptr>) -> ptr {
    let f = avra_llvm_get_named_function(em.m, name)
    let arr = avra_llvm_value_array_new(args.length)
    for (i, a) in args.enumerate() { avra_llvm_value_array_set(arr, i, a) }
    avra_llvm_build_call(em.b, avra_llvm_fn_type_of(f), f, arr, args.length, "")
}

fn emit_ins(em: Emit, i: Ins) {
    match i {
        .ConstInt(dst, v) -> define(em, const_int_value(em, dst, v)),
        .ConstBool(_, v) -> define(em, avra_llvm_const_int(avra_llvm_int1_type(em.lc), if v { 1 } else { 0 }, 0)),
        .ConstStr(_, s) -> define(em, avra_llvm_build_global_string_ptr(em.b, s, ".str")),
        .Bin(_, op, a, x) -> define(em, bin_value(em, op, em.vals[a.index], em.vals[x.index])),
        .Un(_, op, src) -> define(em, un_value(em, op, em.vals[src.index])),
        .CallRtVoid(callee, args) -> void_rt_call(em, callee, args),
        .CallRt(dst, callee, args) -> define(em, call_rt_value(em, dst, callee, args)),
        .Pack(dst, elems) -> define(em, pack_value(em, dst, elems)),
        .Extract(_, src, at) -> define(em, avra_llvm_build_extract_value(em.b, em.vals[src.index], at, "x")),
        .Call(_, callee, args) -> define(em, call(em, mangled(callee), [em.vals[a.index] for a in args])),
        .FnAddr(_, sym) -> define(em, avra_llvm_cast_to_type(em.b,
            avra_llvm_get_named_function(em.m, mangled(sym)), avra_llvm_int64_type(em.lc))),
        .CallPtr(d, f, args) -> define(em, call_ptr_value(em, d, f, args)),
        .Release(r) -> released(em, r),
        .Retain(r) -> retained(em, r),
        .RetVal(r) -> ret_value(em, r),
        .FnExit(r) -> fn_exit(em, r),
        .Ret(code) -> ret_code(em, code),
        .IfStart(c) -> if_start(em, c),
        .SwitchStart(sel, cases) -> switch_start(em, sel, cases),
        .ArmEnd(gives) -> arm_end(em, gives),
        .RegionEnd(dst, gives) -> region_end(em, dst, gives),
        .Alloca(dst) -> define(em, avra_llvm_build_alloca(em.b, reg_type(em, dst), "slot")),
        .Load(dst, slot) -> define(em, avra_llvm_build_load(em.b, reg_type(em, dst), em.vals[slot.index], "ld")),
        .Store(slot, src) -> stored(em, slot, src),
        .LoopStart -> loop_start(em),
        .LoopCond(c) -> loop_cond(em, c),
        .LoopEnd -> loop_end(em),
        .ScopeEnter(_) or .ScopeExit(_) -> nothing(),
    }
}

/// An int constant — or the NULL POINTER when the destination
/// rides one: absence is the zero of its type, and the only
/// ConstInt lowering ever aims at a pointer register is 0. The
/// interpreter's const_int_val is this rule's twin.
fn const_int_value(em: Emit, dst: Reg, v: int) -> ptr {
    if em.types.rides_pointer(em.tys[dst.index]) {
        return avra_llvm_const_pointer_null(avra_llvm_pointer_type(em.lc))
    }
    avra_llvm_const_int(avra_llvm_int64_type(em.lc), v, 1)
}

/// A packed value: element by element into an undef aggregate —
/// registers all the way, which is what lets SROA see through it.
fn pack_value(em: Emit, dst: Reg, elems: List<Reg>) -> ptr {
    mut agg = avra_llvm_get_undef(reg_type(em, dst))
    // LICENSED I4: the running aggregate, not a scan
    for (j, r) in elems.enumerate() {
        agg = avra_llvm_build_insert_value(em.b, agg, em.vals[r.index], j, "pack")
    }
    agg
}

/// The next register's value — registers mint in instruction order.
fn define(em: Emit, v: ptr) {
    mut vs = em.vals
    vs.push(v)
}

/// icmp predicates by number: 32 eq, 33 ne, 38 sgt, 39 sge, 40 slt,
/// 41 sle. The lazy ops lower as regions and never reach a Bin; the
/// arms stay honest (eager i1 and/or) for exhaustiveness.
fn bin_value(em: Emit, op: BinOp, a: ptr, b: ptr) -> ptr {
    match op {
        .Add -> avra_llvm_build_add(em.b, a, b, "add"),
        .Sub -> avra_llvm_build_sub(em.b, a, b, "sub"),
        .Mul -> avra_llvm_build_mul(em.b, a, b, "mul"),
        // Guarded: sdiv/srem by zero is undefined, and the
        // interpreter refuses, so the two engines must agree.
        .Div -> call(em, "avra_int_div", [a, b]),
        .Mod -> call(em, "avra_int_mod", [a, b]),
        .Eq -> avra_llvm_build_icmp(em.b, 32, a, b, "cmp"),
        .Ne -> avra_llvm_build_icmp(em.b, 33, a, b, "cmp"),
        .Lt -> avra_llvm_build_icmp(em.b, 40, a, b, "cmp"),
        .Le -> avra_llvm_build_icmp(em.b, 41, a, b, "cmp"),
        .Gt -> avra_llvm_build_icmp(em.b, 38, a, b, "cmp"),
        .Ge -> avra_llvm_build_icmp(em.b, 39, a, b, "cmp"),
        .And -> avra_llvm_build_and(em.b, a, b, "and"),
        .Or -> avra_llvm_build_or(em.b, a, b, "or"),
    }
}

fn un_value(em: Emit, op: UnOp, v: ptr) -> ptr {
    match op {
        .Not -> avra_llvm_build_not(em.b, v, "not"),
    }
}

/// A runtime call, generic over every callee declare_runtime names.
/// The runtime speaks i64 for truth; a bool-shaped register narrows
/// to i1 (icmp 33, ne 0).
fn call_rt_value(em: Emit, dst: Reg, callee: string, args: List<Reg>) -> ptr {
    let raw = call(em, callee, rt_args(em, callee, args))
    if em.types.shape_of(em.tys[dst.index]) is .Bool {
        return avra_llvm_build_icmp(em.b, 33, raw, avra_llvm_const_int(avra_llvm_int64_type(em.lc), 0, 0), "b")
    }
    // The result coercion, rt_arg's mirror: an I64 answer is a WORD,
    // and a pointer-shaped destination rides back out of it.
    if em.types.rides_pointer(em.tys[dst.index]) && answers_word(em, callee) {
        return avra_llvm_build_int_to_ptr(em.b, raw, avra_llvm_pointer_type(em.lc), "boxed")
    }
    raw
}

/// Whether the registry declares an I64 answer for this callee.
fn answers_word(em: Emit, callee: string) -> bool {
    let sig: RtSig? = callee_sig(em, callee)
    if sig == null { return false }
    sig!.ret is .I64
}

/// A callee's row: the runtime's, or one of the program's externs.
fn callee_sig(em: Emit, callee: string) -> RtSig? {
    // LICENSED I18: two registries asked in turn — the second answers when the first has no row
    rt_sig_of(callee) ?? em.externs.find(it.name == callee)
}

fn void_rt_call(em: Emit, callee: string, args: List<Reg>) {
    let _ = call(em, callee, rt_args(em, callee, args))
}

/// Runtime-call arguments, each coerced to its declared param —
/// the runtime's int64 slots carry pointers too, so a
/// pointer-shaped register entering `avra_array_push`'s element
/// slot casts down.
fn rt_args(em: Emit, callee: string, args: List<Reg>) -> List<ptr> {
    mut out: List<ptr> = []
    // LICENSED I3: the coercion needs the param INDEX; comprehensions
    // cannot destructure enumerate
    for (j, r) in args.enumerate() { out.push(rt_arg(em, callee, j, r)) }
    out
}

/// A registry I64 param is a SLOT — every value category rides it,
/// so pointer-riding registers cast down and bools widen in.
fn rt_arg(em: Emit, callee: string, j: int, r: Reg) -> ptr {
    let v = em.vals[r.index]
    let sig: RtSig? = callee_sig(em, callee)
    if sig == null { return v }
    if j >= sig!.params.length { return v }
    if !(sig!.params[j] is .I64) { return v }
    let i64t = avra_llvm_int64_type(em.lc)
    if em.types.rides_pointer(em.tys[r.index]) {
        return avra_llvm_build_ptr_to_int(em.b, v, i64t, "slot")
    }
    if em.types.shape_of(em.tys[r.index]) is .Bool {
        return avra_llvm_build_zext(em.b, v, i64t, "slot")
    }
    v
}

fn released(em: Emit, r: Reg) {
    let _ = call(em, "avra_rc_release", [em.vals[r.index]])
}

fn retained(em: Emit, r: Reg) {
    let _ = call(em, "avra_rc_retain", [em.vals[r.index]])
}

fn ret_value(em: Emit, r: Reg) {
    let _ = avra_llvm_build_ret(em.b, em.vals[r.index])
}

/// An early return: ret RIGHT HERE, then open a dead block so the
/// arm's unreachable tail (its yield, the region's br) lands
/// somewhere harmless.
fn fn_exit(em: Emit, r: Reg) {
    let _ = avra_llvm_build_ret(em.b, em.vals[r.index])
    let dead = avra_llvm_append_basic_block(em.lc, em.fn_val, "postret")
    avra_llvm_position_at_end(em.b, dead)
}

fn ret_code(em: Emit, code: int) {
    let _ = avra_llvm_build_ret(em.b, avra_llvm_const_int(avra_llvm_int32_type(em.lc), code, 0))
}

fn stored(em: Emit, slot: Reg, src: Reg) {
    let _ = avra_llvm_build_store(em.b, em.vals[src.index], em.vals[slot.index])
}

/// Open the loop: fall into the header, where the condition's
/// instructions re-run each turn.
fn loop_start(em: Emit) {
    let header = avra_llvm_append_basic_block(em.lc, em.fn_val, "lhead")
    let exit = avra_llvm_append_basic_block(em.lc, em.fn_val, "lexit")
    let _ = avra_llvm_build_br(em.b, header)
    avra_llvm_position_at_end(em.b, header)
    mut ls = em.loops
    ls.push(LoopFrame { header: header, exit: exit })
}

/// The condition decides: true falls into the body, false exits.
fn loop_cond(em: Emit, c: Reg) {
    let f = em.loops.last()!
    let body = avra_llvm_append_basic_block(em.lc, em.fn_val, "lbody")
    let _ = avra_llvm_build_cond_br(em.b, em.vals[c.index], body, f.exit)
    avra_llvm_position_at_end(em.b, body)
}

/// Close the back edge and stand at the exit.
fn loop_end(em: Emit) {
    mut ls = em.loops
    let f = ls.pop()
    let _ = avra_llvm_build_br(em.b, f.header)
    avra_llvm_position_at_end(em.b, f.exit)
}

/// Open a two-arm region: branch on the condition, build into the
/// first arm.
fn if_start(em: Emit, c: Reg) {
    let then_bb = avra_llvm_append_basic_block(em.lc, em.fn_val, "then")
    let else_bb = avra_llvm_append_basic_block(em.lc, em.fn_val, "else")
    let merge_bb = avra_llvm_append_basic_block(em.lc, em.fn_val, "endif")
    let _ = avra_llvm_build_cond_br(em.b, em.vals[c.index], then_bb, else_bb)
    avra_llvm_position_at_end(em.b, then_bb)
    open_region(em, [then_bb, else_bb], merge_bb)
}

/// Open an N-arm region: ONE jump table over the selector, the last
/// arm its default — which is why a total match needs no
/// fallthrough. This is the whole point of the instruction: the
/// machine indexes, it does not walk.
fn switch_start(em: Emit, sel: Reg, cases: List<int>) {
    // One block per case, plus the default's — the last arm.
    let arms = [avra_llvm_append_basic_block(em.lc, em.fn_val, "arm") for c in cases].concat([avra_llvm_append_basic_block(em.lc, em.fn_val, "arm")])
    let merge_bb = avra_llvm_append_basic_block(em.lc, em.fn_val, "endswitch")
    let sw = avra_llvm_build_switch(em.b, em.vals[sel.index], arms[cases.length], cases.length)
    let i64t = avra_llvm_int64_type(em.lc)
    for (j, v) in cases.enumerate() {
        avra_llvm_add_case(sw, avra_llvm_const_int(i64t, v, 1), arms[j])
    }
    avra_llvm_position_at_end(em.b, arms[0])
    open_region(em, arms, merge_bb)
}

/// The region stack's push — arm 0 is already being built.
fn open_region(em: Emit, arms: List<ptr>, merge_bb: ptr) {
    mut fs = em.frames
    let r = Region { arms: arms, next: 1, merge_bb: merge_bb, ended: [], gives: [] }
    // LICENSED I15: a region STACK across fns, not a bracket body
    fs.push(r)
}

/// End this arm — where it ended, what it yields — and build into
/// the next. Nested regions moved the insert block; ask, never
/// assume.
fn arm_end(em: Emit, gives: Reg) {
    mut fs = em.frames
    let f = fs.pop()
    let here = avra_llvm_get_insert_block(em.b)
    let _ = avra_llvm_build_br(em.b, f.merge_bb)
    avra_llvm_position_at_end(em.b, f.arms[f.next])
    let advanced = f with {
        ended: f.ended.concat([here]), gives: f.gives.concat([gives]), next: f.next + 1,
    }
    // LICENSED I15: a region STACK across fns, not a bracket body
    fs.push(advanced)
}

/// End the LAST arm and merge: one phi over every arm's yield is
/// the region's register.
fn region_end(em: Emit, dst: Reg, gives: Reg) {
    mut fs = em.frames
    let f = fs.pop()
    let ended = f.ended.concat([avra_llvm_get_insert_block(em.b)])
    let gs = f.gives.concat([gives])
    let _ = avra_llvm_build_br(em.b, f.merge_bb)
    avra_llvm_position_at_end(em.b, f.merge_bb)
    let phi = avra_llvm_build_phi(em.b, reg_type(em, dst), "regval")
    for (j, bb) in ended.enumerate() { avra_llvm_add_incoming(phi, em.vals[gs[j].index], bb) }
    define(em, phi)
}
