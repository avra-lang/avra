//! The LLVM projection of Lowered IR. The module is built through
//! the LLVM C API (the same wrapper every binary here already
//! links), verified function-by-function, and written as `.ll` text
//! for clang. Every fn body becomes its own function (declared
//! first, so call order never matters); `main` is the statement
//! list. Programs link OUR runtime (runtime/avra_runtime.c) —
//! printing, string equality, aggregates, and ownership — and
//! nothing else.
use core.{Ins, Reg, body_symbol, hosted_symbol, BinOp, UnOp, TypeId, TypeRegistry, RtKind, RtSig, rt_sigs, rt_index}
use features.{nothing}

// The runtime's wreck. The backend has no diagnostic channel — by the
// time IR is emitted the program has been judged — so an IR shape the
// compiler's own law forbids exits 2 and is never read as a
// disagreement with the program.
extern fn avra_trap(message: string)

/// One body's emission world: the LLVM handles, this body's register
/// types, the growing register value table (dense by Reg — registers
/// mint in instruction order, params first), and the open regions,
/// innermost last.
type Emit = {
    lc: ptr,
    m: ptr,
    b: ptr,
    fn_val: ptr,
    types: TypeRegistry,
    tys: List<TypeId>,
    vals: List<ptr>,
    frames: List<Region>,
    loops: List<LoopFrame>,
    externs: List<RtSig>,
    // the runtime's rows by name, built once per module
    rt: Map<string, RtSig>,
}

/// One open loop: where the back edge returns and where false exits.
type LoopFrame = { header: ptr, exit: ptr }

/// One open region: N arms merging into ONE value. `arms` holds
/// every arm's block in order and `next` the one to build when the
/// current arm ends; `ended`/`gives` accumulate each finished arm's
/// exit block and yielded register, which the merge phis together.
/// An `if` is the TWO-arm case of exactly this.
type Region = {
    arms: List<ptr>,
    next: int,
    merge_bb: ptr,
    ended: List<ptr>,
    gives: List<Reg>,
}

/// A user fn's symbol — prefixed clear of the runtime and `main`.
fn mangled(name: string) -> string {
    "av_${name}"
}

/// Write the program as verified `.ll` text; null means written, a
/// string is the failure.
export fn emit_ll(l: Lowered, path: string) -> string? {
    let lc = avra_llvm_context_create()
    let m = avra_llvm_module_create("avra", lc)
    let b = avra_llvm_create_builder(lc)
    let missing: string? = unheld_name(l)
    if missing != null { return "internal compiler error: nothing declares `${missing!}` — the program is not closed" }
    declare_runtime(lc, m)
    declare_externs(lc, m, l.externs)
    for bd in l.fns { declare_user(lc, m, l.types, bd) }
    let rt = rt_index()
    for bd in l.fns {
        let f = avra_llvm_get_named_function(m, mangled(bd.name))
        let failure: string? = emit_body(lc, m, b, l.types, l.externs, rt, bd, f)
        if failure != null { return wreck(m, path, failure!) }
    }
    let failure: string? = emit_entry(lc, m, b, l, rt)
    if failure != null { return wreck(m, path, failure!) }
    if avra_llvm_print_module_to_file(m, path) != 0 {
        return "cannot write `${path}`"
    }
    avra_llvm_dispose_builder(b)
    avra_llvm_context_dispose(lc)
    null
}

/// THE CLOSURE LAW: every name a program's steps call is one the
/// module will declare — a body the program lowered, a runtime row,
/// or one of its own externs. The first that is not, named, instead
/// of a null function at emission.
fn unheld_name(l: Lowered) -> string? {
    mut declared: Map<string, bool> = {}
    for bd in l.fns.concat([l.entry]) { declared.set(bd.name, true) }
    for row in rt_sigs().concat(l.externs) { declared.set(row.name, true) }
    for bd in l.fns.concat([l.entry]) {
        for i in bd.ins {
            let body: string? = body_symbol(i)
            if body != null && declared.get(body!) == null { return body }
            let host: string? = hosted_symbol(i)
            if host != null && declared.get(host!) == null { return host }
        }
    }
    null
}

/// THE ENTRY. The program's own statements become `av_entry`; C's
/// `main` hands the runtime its arguments and answers what the
/// entry answered. The argument pair crosses the seam exactly here
/// — a program reads it through the host from then on.
fn emit_entry(lc: ptr, m: ptr, b: ptr, l: Lowered, rt: Map<string, RtSig>) -> string? {
    declare(m, "avra_args_init", avra_llvm_void_type(lc),
            [avra_llvm_int64_type(lc), avra_llvm_pointer_type(lc)], false)
    declare(m, "av_entry", avra_llvm_int32_type(lc), [], false)
    let entry = avra_llvm_get_named_function(m, "av_entry")
    let failure: string? = emit_body(lc, m, b, l.types, l.externs, rt, l.entry, entry)
    if failure != null { return failure }
    open_main(lc, m, b, entry)
}

/// `int main(int argc, char** argv)`: the arguments handed over,
/// then the entry.
fn open_main(lc: ptr, m: ptr, b: ptr, entry: ptr) -> string? {
    declare(m, "main", avra_llvm_int32_type(lc),
            [avra_llvm_int32_type(lc), avra_llvm_pointer_type(lc)], false)
    let f = avra_llvm_get_named_function(m, "main")
    avra_llvm_position_at_end(b, avra_llvm_append_basic_block(lc, f, "entry"))
    let init = avra_llvm_get_named_function(m, "avra_args_init")
    let args = avra_llvm_value_array_new(2)
    // argc is C's `int` and is never negative, so the widening is a
    // ZERO extend — said here because only this site knows the sign
    avra_llvm_value_array_set(args, 0, avra_llvm_build_zext(b, avra_llvm_get_param(f, 0), avra_llvm_int64_type(lc), "argc"))
    avra_llvm_value_array_set(args, 1, avra_llvm_get_param(f, 1))
    avra_llvm_build_call(b, avra_llvm_fn_type_of(init), init, args, 2, "")
    avra_llvm_value_array_free(args)
    let seatless = avra_llvm_value_array_new(0)
    let answer = avra_llvm_build_call(b, avra_llvm_fn_type_of(entry), entry, seatless, 0, "code")
    avra_llvm_value_array_free(seatless)
    let _ = avra_llvm_build_ret(b, answer)
    if avra_llvm_verify_function(f) != 0 { return "internal compiler error: LLVM verification failed for main" }
    null
}

/// One body into one function: params seed the value table, every
/// instruction emits, the verifier gates.
fn emit_body(lc: ptr, m: ptr, b: ptr, types: TypeRegistry, externs: List<RtSig>, rt: Map<string, RtSig>, bd: Body, f: ptr) -> string? {
    mut vals: List<ptr> = []
    // LICENSED I3: a RANGE walk — comprehensions iterate lists only
    for j in 0..bd.params.length { vals.push(avra_llvm_get_param(f, j)) }
    mut em = Emit {
        lc: lc, m: m, b: b, fn_val: f, types: types,
        tys: bd.reg_types, vals: vals, frames: [], loops: [], externs: externs, rt: rt,
    }
    avra_llvm_position_at_end(b, avra_llvm_append_basic_block(lc, f, "entry"))
    for i in bd.ins { em.emit_ins(i) }
    if avra_llvm_verify_function(f) != 0 {
        return "internal compiler error: LLVM verification failed for ${bd.name}"
    }
    null
}

/// The verifier's own report goes to stderr; the module still writes
/// so the wreck is inspectable.
fn wreck(m: ptr, path: string, failure: string) -> string {
    let _ = avra_llvm_verify_module_print(m)
    let _ = avra_llvm_print_module_to_file(m, path)
    "${failure} (module at ${path})"
}

/// The runtime surface, declared straight from the registry —
/// runtime_api.av is the one definition, runtime/avra_runtime.c
/// its implementation twin.
fn declare_runtime(lc: ptr, m: ptr) {
    for s in rt_sigs() {
        declare(m, s.name, ll_rt_kind(lc, s.ret), [ll_rt_kind(lc, k) for k in s.params], false)
    }
}

/// The program's own host fns, declared like the runtime's rows.
fn declare_externs(lc: ptr, m: ptr, rows: List<RtSig>) {
    for s in rows {
        declare(m, s.name, ll_rt_kind(lc, s.ret), [ll_rt_kind(lc, k) for k in s.params], false)
    }
}

/// A runtime slot's machine type. The WIDTHS belong to an extern
/// seat alone — the registry's own rows are all words and pointers.
/// `.F64`/`.F32` land here as the double and float types the day a
/// float VALUE exists to construct them.
fn ll_rt_kind(lc: ptr, k: RtKind) -> ptr {
    match k {
        .I64 -> avra_llvm_int64_type(lc),
        .I32 or .U32 -> avra_llvm_int32_type(lc),
        .F64 -> avra_llvm_double_type(lc),
        .Ptr -> avra_llvm_pointer_type(lc),
        .Void -> avra_llvm_void_type(lc),
    }
}

/// One user fn's declaration, typed from its signature's shapes.
fn declare_user(lc: ptr, m: ptr, types: TypeRegistry, bd: Body) {
    declare(m, mangled(bd.name), ll_type_of(lc, types, bd.ret),
            [ll_type_of(lc, types, pt) for pt in bd.params], false)
}

fn declare(m: ptr, name: string, ret: ptr, params: List<ptr>, variadic: bool) {
    let arr = avra_llvm_type_array_new(params.length)
    for i, p in params { avra_llvm_type_array_set(arr, i, p) }
    let vararg = if variadic { 1 } else { 0 }
    avra_llvm_add_function(m, name, avra_llvm_function_type(ret, arr, params.length, vararg))
    avra_llvm_type_array_free(arr)
}

/// A shape's LLVM type.
fn ll_type_of(lc: ptr, types: TypeRegistry, ty: TypeId) -> ptr {
    match types.shape_of(ty) {
        // TypeName never materializes: no value ever has it — nor
        // does Var: mono substitutes before any register minted.
        .Float -> avra_llvm_double_type(lc),
        .Int or .Error or .TypeName(_, _) or .Var(_, _, _) or .Void -> avra_llvm_int64_type(lc),
        .Bool -> avra_llvm_int1_type(lc),
        .Opt(inner) -> opt_ll_type(lc, types, inner),
        .Struct(_, _) -> flat_or_pointer(lc, types, ty),
        .Str or .Ptr or .List(_) or .Enum(_, _) or .Dyn(_, _) or .Fn(_, _, _) or
        .Res(_, _) or .App(_, _, _) or .Null or .EmptyList or .Map(_, _) or .EmptyMap -> avra_llvm_pointer_type(lc),
    }
}

/// A record's machine type: a FLAT record IS its one field — a
/// newtype over `int` is an `int`, so it rides every seat the field
/// rides; every other record is the pointer to its box.
fn flat_or_pointer(lc: ptr, types: TypeRegistry, ty: TypeId) -> ptr {
    if !types.is_flat(ty) { return avra_llvm_pointer_type(lc) }
    ll_type_of(lc, types, types.flat_fields(ty)[0])
}

/// A nullable's machine type: the niche IS its value's pointer; a
/// scalar pair is a first-class {present: i1, value} aggregate that
/// lives in registers and never touches memory.
fn opt_ll_type(lc: ptr, types: TypeRegistry, inner: TypeId) -> ptr {
    if types.opt_rides_pointer(inner) { return avra_llvm_pointer_type(lc) }
    let arr = avra_llvm_type_array_new(2)
    avra_llvm_type_array_set(arr, 0, avra_llvm_int1_type(lc))
    avra_llvm_type_array_set(arr, 1, ll_type_of(lc, types, inner))
    let st = avra_llvm_struct_type(lc, arr, 2)
    avra_llvm_type_array_free(arr)
    st
}

impl Emit {
    /// A register's LLVM type.
    fn reg_type(r: Reg) -> ptr {
        ll_type_of(self.lc, self.types, self.tys[r.index])
    }

    /// The indirect call: the fn TYPE derives from the site's own
    /// registers (ret from dst, params from args), so the built type
    /// matches the callee that boxing named — every seat is cast to
    /// its register's declared shape on the way in.
    fn call_ptr_value(d: Reg, f: Reg, args: List<Reg>) -> ptr {
        let ptys = avra_llvm_type_array_new(args.length)
        for j, a in args {
            avra_llvm_type_array_set(ptys, j, ll_type_of(self.lc, self.types, self.tys[a.index]))
        }
        let fty = avra_llvm_function_type(ll_type_of(self.lc, self.types, self.tys[d.index]), ptys, args.length, 0)
        avra_llvm_type_array_free(ptys)
        let vargs = avra_llvm_value_array_new(args.length)
        for j, a in args {
            avra_llvm_value_array_set(vargs, j,
                avra_llvm_cast_to_type(self.b, self.vals[a.index], ll_type_of(self.lc, self.types, self.tys[a.index])))
        }
        let fp = avra_llvm_cast_to_type(self.b, self.vals[f.index], avra_llvm_pointer_type(self.lc))
        avra_llvm_build_call(self.b, fty, fp, vargs, args.length, "")
    }

    fn call(name: string, args: List<ptr>) -> ptr {
        let f = avra_llvm_get_named_function(self.m, name)
        let arr = avra_llvm_value_array_new(args.length)
        for i, a in args { avra_llvm_value_array_set(arr, i, a) }
        avra_llvm_build_call(self.b, avra_llvm_fn_type_of(f), f, arr, args.length, "")
    }

    fn emit_ins(i: Ins) {
        match i {
            .ConstInt(dst, v) -> self.define(self.const_int_value(dst, v)),
            .ConstFloat(_, bits) -> self.define(avra_llvm_const_double_bits(self.lc, bits)),
            .ConstBool(_, v) -> self.define(avra_llvm_const_int(avra_llvm_int1_type(self.lc), if v { 1 } else { 0 }, 0)),
            .ConstStr(_, s) -> self.define(avra_llvm_build_global_string_ptr(self.b, s, ".str")),
            .Bin(_, op, a, x) -> self.define(self.binary_value(op, a, x)),
            .Un(_, op, src) -> self.define(self.un_value(op, self.vals[src.index])),
            .CallRtVoid(callee, args) -> self.void_rt_call(callee, args),
            .CallRt(dst, callee, args) -> self.define(self.call_rt_value(dst, callee, args)),
            .Pack(dst, elems) -> self.define(self.pack_value(dst, elems)),
            .Extract(_, src, at) -> self.define(self.extract_value(src, at)),
            .Call(_, callee, args) -> self.define(self.call(mangled(callee), [self.vals[a.index] for a in args])),
            .FnAddr(_, sym) -> self.define(avra_llvm_cast_to_type(self.b,
                avra_llvm_get_named_function(self.m, mangled(sym)), avra_llvm_int64_type(self.lc))),
            .CallPtr(d, f, args) -> self.define(self.call_ptr_value(d, f, args)),
            .Release(r) -> self.released(r),
            .Retain(r) -> self.retained(r),
            .RetVal(r) -> self.ret_value(r),
            .FnExit(r) -> self.fn_exit(r),
            .Ret(code) -> self.ret_code(code),
            .IfStart(c) -> self.if_start(c),
            .SwitchStart(sel, cases) -> self.switch_start(sel, cases),
            .ArmEnd(gives) -> self.arm_end(gives),
            .RegionEnd(dst, gives) -> self.region_end(dst, gives),
            .Alloca(dst) -> self.define(avra_llvm_build_alloca(self.b, self.reg_type(dst), "slot")),
            .Load(dst, slot) -> self.define(avra_llvm_build_load(self.b, self.reg_type(dst), self.vals[slot.index], "ld")),
            .Store(slot, src) -> self.stored(slot, src),
            .LoopStart -> self.loop_start(),
            .LoopCond(c) -> self.loop_cond(c),
            .LoopEnd -> self.loop_end(),
            .ScopeEnter(_) or .ScopeExit(_) -> nothing(),
        }
    }

    /// An int constant — or the NULL POINTER when the destination
    /// rides one: absence is the zero of its type, and the only
    /// ConstInt lowering ever aims at a pointer register is 0. The
    /// interpreter's const_int_val is this rule's twin.
    fn const_int_value(dst: Reg, v: int) -> ptr {
        if self.types.rides_pointer(self.tys[dst.index]) {
            return avra_llvm_const_pointer_null(avra_llvm_pointer_type(self.lc))
        }
        avra_llvm_const_int(avra_llvm_int64_type(self.lc), v, 1)
    }

    /// Whether a register holds a FLAT record — one that IS its field.
    fn flat_value(r: Reg) -> bool {
        self.types.is_flat(self.tys[r.index])
    }

    /// One element out of an aggregate — or the value itself, when the
    /// aggregate is a FLAT record and IS that element.
    fn extract_value(src: Reg, at: int) -> ptr {
        if self.flat_value(src) { return self.vals[src.index] }
        avra_llvm_build_extract_value(self.b, self.vals[src.index], at, "x")
    }

    /// A packed value: element by element into an undef aggregate —
    /// registers all the way, which is what lets SROA see through it.
    fn pack_value(dst: Reg, elems: List<Reg>) -> ptr {
        // A FLAT record IS its one field — the pack is the value itself.
        if self.flat_value(dst) { return self.vals[elems[0].index] }
        mut agg = avra_llvm_get_undef(self.reg_type(dst))
        // LICENSED I4: the running aggregate, not a scan
        for j, r in elems {
            agg = avra_llvm_build_insert_value(self.b, agg, self.vals[r.index], j, "pack")
        }
        agg
    }

    /// The next register's value — registers mint in instruction order.
    fn define(v: ptr) {
        self.vals.push(v)
    }

    /// icmp predicates by number: 32 eq, 33 ne, 38 sgt, 39 sge, 40 slt,
    /// 41 sle. `And`/`Or` are the LAZY ops: they lower as regions and
    /// a `Bin` carrying one is the IR's bool law broken, which both
    /// engines say in the same words — an eager `and` here would be a
    /// plausible answer to an impossible question, in the exact arms a
    /// bitwise operator would be tempted to reuse.
    /// An IR shape the compiler's own law forbids. `unreached` is the
    /// answer the subset demands and the trap never lets it give.
    fn wrecked(what: string, unreached: ptr) -> ptr {
        avra_trap("compiler defect: ${what}")
        unreached
    }

    /// A binary operation, by the OPERANDS' kind. A double lives in
    /// its own register file, so the float ops are a separate table
    /// and not a flag on the integer one — mixing them is not a
    /// wrong answer, it is a wrong instruction.
    fn binary_value(op: BinOp, a: Reg, x: Reg) -> ptr {
        let l = self.vals[a.index]
        let r = self.vals[x.index]
        if self.types.shape_of(self.tys[a.index]) is .Float { return self.float_value(op, l, r) }
        self.bin_value(op, l, r)
    }

    /// IEEE-754 arithmetic and ORDERED comparison. NaN answers false
    /// to every ordered question, which is the standard's rule.
    fn float_value(op: BinOp, a: ptr, b: ptr) -> ptr {
        match op {
            .Add -> avra_llvm_build_fadd(self.b, a, b, "fadd"),
            .Sub -> avra_llvm_build_fsub(self.b, a, b, "fsub"),
            .Mul -> avra_llvm_build_fmul(self.b, a, b, "fmul"),
            .Div -> avra_llvm_build_fdiv(self.b, a, b, "fdiv"),
            // LLVMRealPredicate: OEQ 1, OGT 2, OGE 3, OLT 4, OLE 5, ONE 6
            .Eq -> avra_llvm_build_fcmp(self.b, 1, a, b, "fcmp"),
            .Ne -> avra_llvm_build_fcmp(self.b, 6, a, b, "fcmp"),
            .Gt -> avra_llvm_build_fcmp(self.b, 2, a, b, "fcmp"),
            .Ge -> avra_llvm_build_fcmp(self.b, 3, a, b, "fcmp"),
            .Lt -> avra_llvm_build_fcmp(self.b, 4, a, b, "fcmp"),
            .Le -> avra_llvm_build_fcmp(self.b, 5, a, b, "fcmp"),
            .Mod or .BitAnd or .BitOr or .BitXor or .Shl or .Shr ->
                self.wrecked(int_only_on_floats(), a),
            .And or .Or -> self.wrecked(lazy_in_eager(), a),
        }
    }

    fn bin_value(op: BinOp, a: ptr, b: ptr) -> ptr {
        match op {
            .Add -> avra_llvm_build_add(self.b, a, b, "add"),
            .Sub -> avra_llvm_build_sub(self.b, a, b, "sub"),
            .Mul -> avra_llvm_build_mul(self.b, a, b, "mul"),
            // Guarded: sdiv/srem by zero is undefined, and the
            // interpreter refuses, so the two engines must agree.
            .Div -> self.call("avra_int_div", [a, b]),
            .Mod -> self.call("avra_int_mod", [a, b]),
            .Eq -> avra_llvm_build_icmp(self.b, 32, a, b, "cmp"),
            .Ne -> avra_llvm_build_icmp(self.b, 33, a, b, "cmp"),
            .Lt -> avra_llvm_build_icmp(self.b, 40, a, b, "cmp"),
            .Le -> avra_llvm_build_icmp(self.b, 41, a, b, "cmp"),
            .Gt -> avra_llvm_build_icmp(self.b, 38, a, b, "cmp"),
            .Ge -> avra_llvm_build_icmp(self.b, 39, a, b, "cmp"),
            .And or .Or -> self.wrecked(lazy_in_eager(), a),
            .BitAnd -> avra_llvm_build_and(self.b, a, b, "band"),
            .BitOr -> avra_llvm_build_or(self.b, a, b, "bor"),
            .BitXor -> avra_llvm_build_xor(self.b, a, b, "bxor"),
            // Guarded like Div/Mod: a shift past the width is POISON
            // in LLVM and undefined in C, so one C body decides where
            // the edge is and both engines call it.
            .Shl -> self.call("avra_int_shl", [a, b]),
            .Shr -> self.call("avra_int_shr", [a, b]),
        }
    }

    fn un_value(op: UnOp, v: ptr) -> ptr {
        match op {
            .Not -> avra_llvm_build_not(self.b, v, "not"),
        }
    }

    /// A runtime call, generic over every callee declare_runtime names.
    /// The runtime speaks i64 for truth; a bool-shaped register narrows
    /// to i1 (icmp 33, ne 0).
    fn call_rt_value(dst: Reg, callee: string, args: List<Reg>) -> ptr {
        let called = self.call(callee, self.rt_args(callee, args))
        self.normalized_cells(callee, args)
        let raw = self.answered(callee, called)
        if self.types.shape_of(self.tys[dst.index]) is .Bool {
            return avra_llvm_build_icmp(self.b, 33, raw, avra_llvm_const_int(avra_llvm_int64_type(self.lc), 0, 0), "b")
        }
        // The result coercion, rt_arg's mirror: an I64 answer is a WORD,
        // and a pointer-shaped destination rides back out of it.
        if self.types.rides_pointer(self.tys[dst.index]) && self.answers_word(callee) {
            return avra_llvm_build_int_to_ptr(self.b, raw, avra_llvm_pointer_type(self.lc), "boxed")
        }
        // A DOUBLE IS NOT A WORD. Every container keeps its elements in
        // an i64 slot, so a float coming back out of one is
        // REINTERPRETED, not converted. `worded` is the twin.
        if self.types.shape_of(self.tys[dst.index]) is .Float && self.answers_word(callee) {
            return avra_llvm_build_bitcast(self.b, raw, avra_llvm_double_type(self.lc), "unslotted")
        }
        raw
    }

    /// Whether the registry declares an I64 answer for this callee.
    /// A MATCH, never `is .I64`: this decides what crosses the extern
    /// boundary, so a new RtKind must state its answer here or the
    /// build fails — an `is` test would silently answer "not a word".
    fn answers_word(callee: string) -> bool {
        let sig: RtSig? = self.callee_sig(callee)
        if sig == null { return false }
        match sig!.ret {
            .I64 -> true,
            // a width answers an Avra `int`, never a pointer's word
            // a width answers an Avra `int`, and a double answers in
            // its own register file — neither is a pointer's word
            .I32 or .U32 or .F64 or .Ptr or .Void -> false,
        }
    }

    /// A NARROW ANSWER IS WIDENED WITH THE SIGN ITS WIDTH NAMES, and
    /// this match is where the author must say which: `i32` and `u32`
    /// differ in nothing else. Reading a narrow answer at 64 bits is
    /// the silent wrong answer — a C `int` of -1 reads 4294967295 —
    /// because the bits above the declared width are the callee's
    /// business and only the declaration says how to read them.
    /// NOT `avra_llvm_cast_to_type`: it TRAPS on a widening rather
    /// than guess a sign, and names these two builders when it does.
    /// This match is the caller it means — the row already said which.
    fn answered(callee: string, raw: ptr) -> ptr {
        let sig: RtSig? = self.callee_sig(callee)
        if sig == null { return raw }
        let wide = avra_llvm_int64_type(self.lc)
        match sig!.ret {
            .I32 -> avra_llvm_build_sext(self.b, raw, wide, "wide"),
            .U32 -> avra_llvm_build_zext(self.b, raw, wide, "wide"),
            // a double is already the width its seat declared
            .I64 or .F64 or .Ptr or .Void -> raw,
        }
    }

    /// A callee's row: the runtime's, or one of the program's externs.
    fn callee_sig(callee: string) -> RtSig? {
        // LICENSED I18: two registries asked in turn — the second answers when the first has no row
        self.rt.get(callee) ?? self.externs.find(it.name == callee)
    }

    fn void_rt_call(callee: string, args: List<Reg>) {
        let _ = self.call(callee, self.rt_args(callee, args))
        self.normalized_cells(callee, args)
    }

    /// A NARROW INOUT CELL IS NORMALISED AFTER THE CALL. An Avra cell
    /// is eight bytes; a C `int*` out-parameter writes FOUR of them,
    /// and the other four keep whatever the cell held — so
    /// `wal_checkpoint_v2` writing -1 reads back 4294967295 until the
    /// low half is extended over the high one.
    ///
    /// LITTLE-ENDIAN: the four bytes C writes are the LOW four of the
    /// slot. True on arm64 and x86-64, which is the only reason a
    /// shared cell works at all — say it rather than assume it.
    ///
    /// The SIGN comes from the WIDTH WORD the seat declared, never
    /// from the value: `i32` sign-extends, `u32` zero-extends, and
    /// they differ in nothing else. Lane C's rule holds — the cell
    /// register went to the call DIRECTLY and this reads the SAME
    /// register, so the memory pass still sees one slot.
    ///
    /// The interpreter needs this too the day it hosts an extern
    /// (it traps on every one today), and it must read the width
    /// from the same `cells` column.
    fn normalized_cells(callee: string, args: List<Reg>) {
        let sig: RtSig? = self.callee_sig(callee)
        if sig == null { return }
        let cells = sig!.cells
        for j, r in args {
            if j < cells.length { self.normalized_cell(cells[j], r) }
        }
    }

    /// One cell re-read at its declared width. DECIDE BEFORE EMITTING:
    /// a seat that is not a narrow inout gets no instructions at all,
    /// and its register is not a cell to load from — the first draft
    /// built the load before asking, and emitted `load i64, i64 %1`
    /// against an ordinary argument.
    fn normalized_cell(width: RtKind, slot: Reg) {
        let signed: bool? = self.narrow_sign(width)
        if signed == null { return }
        let wide = avra_llvm_int64_type(self.lc)
        let cell = self.vals[slot.index]
        let low = avra_llvm_build_trunc(self.b, avra_llvm_build_load(self.b, wide, cell, "cell"),
                                        avra_llvm_int32_type(self.lc), "low")
        let full = if signed! { avra_llvm_build_sext(self.b, low, wide, "signed") }
                   else { avra_llvm_build_zext(self.b, low, wide, "unsigned") }
        let _ = avra_llvm_build_store(self.b, full, cell)
    }

    /// Whether a cell's width extends SIGNED, or absence when the
    /// width is not a narrow one and the cell needs nothing.
    fn narrow_sign(width: RtKind) -> bool? {
        match width {
            .I32 -> true,
            .U32 -> false,
            // a double cell is whole — nothing to sign-extend
            .I64 or .F64 or .Ptr or .Void -> null,
        }
    }

    /// Runtime-call arguments, each coerced to its declared param —
    /// the runtime's int64 slots carry pointers too, so a
    /// pointer-shaped register entering `avra_array_push`'s element
    /// slot casts down.
    fn rt_args(callee: string, args: List<Reg>) -> List<ptr> {
        mut out: List<ptr> = []
        // LICENSED I3: the coercion needs the param INDEX; comprehensions
        // cannot destructure enumerate
        for j, r in args { out.push(self.rt_arg(callee, j, r)) }
        out
    }

    /// A registry I64 param is a SLOT — every value category rides it,
    /// so pointer-riding registers cast down and bools widen in. A
    /// MATCH, never `is .I64`: this decides what crosses the extern
    /// boundary, and an `is` test would pass a NEW kind's argument
    /// UNCONVERTED — the conversions all live in the branch it skips.
    fn rt_arg(callee: string, j: int, r: Reg) -> ptr {
        let v = self.vals[r.index]
        let sig: RtSig? = self.callee_sig(callee)
        if sig == null { return v }
        if j >= sig!.params.length { return v }
        match sig!.params[j] {
            .I64 -> self.worded(r, v),
            // the low bits are what a narrow C seat reads; the
            // SIGN of an argument is the callee's to interpret
            .I32 or .U32 -> avra_llvm_build_trunc(self.b, v, avra_llvm_int32_type(self.lc), "narrow"),
            .F64 -> v,
            .Ptr or .Void -> v,
        }
    }

    /// A value cast into the I64 slot every category rides.
    fn worded(r: Reg, v: ptr) -> ptr {
        let i64t = avra_llvm_int64_type(self.lc)
        if self.types.rides_pointer(self.tys[r.index]) {
            return avra_llvm_build_ptr_to_int(self.b, v, i64t, "slot")
        }
        if self.types.shape_of(self.tys[r.index]) is .Bool {
            return avra_llvm_build_zext(self.b, v, i64t, "slot")
        }
        // Its twin in `call_rt_value`: the bits go in as they come out.
        if self.types.shape_of(self.tys[r.index]) is .Float {
            return avra_llvm_build_bitcast(self.b, v, i64t, "slot")
        }
        v
    }

    fn released(r: Reg) {
        let _ = self.call("avra_rc_release", [self.vals[r.index]])
    }

    fn retained(r: Reg) {
        let _ = self.call("avra_rc_retain", [self.vals[r.index]])
    }

    fn ret_value(r: Reg) {
        let _ = avra_llvm_build_ret(self.b, self.vals[r.index])
    }

    /// An early return: ret RIGHT HERE, then open a dead block so the
    /// arm's unreachable tail (its yield, the region's br) lands
    /// somewhere harmless.
    fn fn_exit(r: Reg) {
        let _ = avra_llvm_build_ret(self.b, self.vals[r.index])
        let dead = avra_llvm_append_basic_block(self.lc, self.fn_val, "postret")
        avra_llvm_position_at_end(self.b, dead)
    }

    /// A process code wears the answer type the fn was declared with:
    /// C's `int` at the entry, the IR's `int` in a program body.
    fn ret_code(code: int) {
        let _ = avra_llvm_build_ret(self.b, avra_llvm_const_int(avra_llvm_return_type_of(self.fn_val), code, 0))
    }

    fn stored(slot: Reg, src: Reg) {
        let _ = avra_llvm_build_store(self.b, self.vals[src.index], self.vals[slot.index])
    }

    /// Open the loop: fall into the header, where the condition's
    /// instructions re-run each turn.
    fn loop_start() {
        let header = avra_llvm_append_basic_block(self.lc, self.fn_val, "lhead")
        let exit = avra_llvm_append_basic_block(self.lc, self.fn_val, "lexit")
        let _ = avra_llvm_build_br(self.b, header)
        avra_llvm_position_at_end(self.b, header)
        self.loops.push(LoopFrame { header: header, exit: exit })
    }

    /// The condition decides: true falls into the body, false exits.
    fn loop_cond(c: Reg) {
        let f = self.loops.last()!
        let body = avra_llvm_append_basic_block(self.lc, self.fn_val, "lbody")
        let _ = avra_llvm_build_cond_br(self.b, self.vals[c.index], body, f.exit)
        avra_llvm_position_at_end(self.b, body)
    }

    /// Close the back edge and stand at the exit.
    fn loop_end() {
        let f = self.loops.pop()
        let _ = avra_llvm_build_br(self.b, f.header)
        avra_llvm_position_at_end(self.b, f.exit)
    }

    /// Open a two-arm region: branch on the condition, build into the
    /// first arm.
    fn if_start(c: Reg) {
        let then_bb = avra_llvm_append_basic_block(self.lc, self.fn_val, "then")
        let else_bb = avra_llvm_append_basic_block(self.lc, self.fn_val, "else")
        let merge_bb = avra_llvm_append_basic_block(self.lc, self.fn_val, "endif")
        let _ = avra_llvm_build_cond_br(self.b, self.vals[c.index], then_bb, else_bb)
        avra_llvm_position_at_end(self.b, then_bb)
        self.open_region([then_bb, else_bb], merge_bb)
    }

    /// Open an N-arm region: ONE jump table over the selector, the last
    /// arm its default — which is why a total match needs no
    /// fallthrough. This is the whole point of the instruction: the
    /// machine indexes, it does not walk.
    fn switch_start(sel: Reg, cases: List<int>) {
        // One block per case, plus the default's — the last arm.
        let arms = [avra_llvm_append_basic_block(self.lc, self.fn_val, "arm") for c in cases].concat([avra_llvm_append_basic_block(self.lc, self.fn_val, "arm")])
        let merge_bb = avra_llvm_append_basic_block(self.lc, self.fn_val, "endswitch")
        let sw = avra_llvm_build_switch(self.b, self.vals[sel.index], arms[cases.length], cases.length)
        let i64t = avra_llvm_int64_type(self.lc)
        for j, v in cases {
            avra_llvm_add_case(sw, avra_llvm_const_int(i64t, v, 1), arms[j])
        }
        avra_llvm_position_at_end(self.b, arms[0])
        self.open_region(arms, merge_bb)
    }

    /// The region stack's push — arm 0 is already being built.
    fn open_region(arms: List<ptr>, merge_bb: ptr) {
        let r = Region { arms: arms, next: 1, merge_bb: merge_bb, ended: [], gives: [] }
        // LICENSED I15: a region STACK across fns, not a bracket body
        self.frames.push(r)
    }

    /// End this arm — where it ended, what it yields — and build into
    /// the next. Nested regions moved the insert block; ask, never
    /// assume.
    fn arm_end(gives: Reg) {
        let f = self.frames.pop()
        let here = avra_llvm_get_insert_block(self.b)
        let _ = avra_llvm_build_br(self.b, f.merge_bb)
        avra_llvm_position_at_end(self.b, f.arms[f.next])
        let advanced = f with {
            ended: f.ended.concat([here]), gives: f.gives.concat([gives]), next: f.next + 1,
        }
        // LICENSED I15: a region STACK across fns, not a bracket body
        self.frames.push(advanced)
    }

    /// End the LAST arm and merge: one phi over every arm's yield is
    /// the region's register.
    fn region_end(dst: Reg, gives: Reg) {
        let f = self.frames.pop()
        let ended = f.ended.concat([avra_llvm_get_insert_block(self.b)])
        let gs = f.gives.concat([gives])
        let _ = avra_llvm_build_br(self.b, f.merge_bb)
        avra_llvm_position_at_end(self.b, f.merge_bb)
        let phi = avra_llvm_build_phi(self.b, self.reg_type(dst), "regval")
        for j, bb in ended { avra_llvm_add_incoming(phi, self.vals[gs[j].index], bb) }
        self.define(phi)
    }
}

/// `&&`/`||` are LAZY REGIONS — lowering diverts them before any
/// `Bin` is emitted, so one reaching an eager table is the
/// compiler's own defect. ONE definition for the whole `language`
/// module, so the two engines cannot word it differently.
fn lazy_in_eager() -> string { "a lazy op reached the eager path" }

/// The integer-only operations, met by a double.
fn int_only_on_floats() -> string { "an integer-only op reached float operands" }
