//! The ONE semantics, executed — the IR interpreter. Features
//! define meaning once (lowering); this walks the SAME instruction
//! stream the backend compiles, so eval and native cannot disagree
//! by construction. Every CallRt row in runtime_api.av has its host
//! implementation here, contract-matched to runtime/avra_runtime.c
//! — the registry's fifth consumer, refusal wording included.
//!
//! The IR is brackets, not jumps: control flow is a program counter
//! plus depth-matched skips (regions — two-arm ifs and N-arm
//! switches alike — and loop back edges). Values
//! are a tiny closed enum; arrays, mut cells, and register frames
//! live in machine tables addressed by handle.
use core.{copied, Ins, Reg, BinOp, UnOp, RtSig, opens_region, closes_region, filled, joined, rt_sig_of, code_at}

/// A runtime value: the interpreter's whole vocabulary.
enum Val {
    I(v: int)
    B(v: bool)
    S(v: string)
    /// An aggregate — a handle into the machine's array table.
    A(id: int)
    /// A mut binding's cell — a handle into the cell table.
    C(id: int)
    /// A map — a handle into the map table.
    M(id: int)
    /// The null pointer — a niche nullable's absence.
    N
}

/// The machine: the program, its heaps, the register frame stack
/// (innermost last — mutated through element aliases), its output,
/// and its refusal.
type Machine = {
    l: Lowered,
    frames: List<List<Val?>>,
    arrays: List<List<Val>>,
    maps: List<MapVal>,
    cells: List<Val>,
    out: List<string>,
    failures: List<string>,
}

/// A machine at rest over a program: no frames, no heap, nothing said.
fn fresh_machine(l: Lowered) -> Machine {
    Machine { l: l, frames: [], arrays: [], maps: [], cells: [], out: [], failures: [] }
}

/// Run a lowered program: its printed output, or the refusal.
export fn run_lowered(l: Lowered) -> Result<string, string> {
    let m = fresh_machine(l)
    let _ = run_body(m, l.entry, [])
    if !m.failures.is_empty() { return .Err(m.failures.first()!) }
    if m.out.is_empty() { return .Err("the program is empty") }
    .Ok(joined(m.out, "\n"))
}

/// One fn run by its symbol under no arguments, its bool answer —
/// how a test case runs. A failure inside answers as the refusal.
export fn run_symbol(l: Lowered, symbol: string) -> Result<bool, string> {
    let m = fresh_machine(l)
    let target: Body? = body_named(l, symbol)
    if target == null { return .Err("no body named `${symbol}`") }
    let answer: Val? = run_body(m, target!, [])
    if !m.failures.is_empty() { return .Err(m.failures.first()!) }
    if answer == null { return .Err("`${symbol}` answered nothing") }
    truth_of(symbol, answer!)
}

fn body_named(l: Lowered, name: string) -> Body? {
    l.fns.find(it.name == name)
}

fn truth_of(symbol: string, v: Val) -> Result<bool, string> {
    match v {
        .B(b) -> .Ok(b),
        _ -> .Err("`${symbol}` answered no bool"),
    }
}

/// The deepest call the machine runs before it refuses: the machine
/// recurses on the host's stack, and a runaway recursion must answer
/// as a trap naming its case, never as a crash of the run. The bound
/// is what a test worker's thread stack holds with margin (its
/// ceiling measured between 600 and 700 nested calls); a machine
/// with a frame stack of its own lifts it.
fn call_limit() -> int {
    400
}

/// One body under its argument values; params ARE registers 0..N-1.
/// The answer is RetVal's register, when one fires.
fn run_body(m: Machine, b: Body, args: List<Val>) -> Val? {
    mut frames = m.frames
    if frames.length >= call_limit() {
        trapped(m, "recursion too deep — ${call_limit()} nested calls")
        return null
    }
    frames.push(filled<Val?>(b.reg_types.length, null))
    for (j, a) in args.enumerate() { put(m, Reg { index: j }, a) }
    // LICENSED I4: the run loop's answer, not a scan
    mut answer: Val? = null
    mut pc = 0
    while pc < b.ins.length && m.failures.is_empty() {
        // LICENSED I22: everything else DELEGATES to `step`, which is exhaustive
        match b.ins[pc] {
            .RetVal(r) -> {
                answer = at(m, r)
                pc = b.ins.length
            }
            .FnExit(r) -> {
                answer = at(m, r)
                pc = b.ins.length
            }
            .Ret(_) -> {
                pc = b.ins.length
            }
            _ -> {
                pc = step(m, b, pc)
            }
        }
    }
    let _ = frames.pop()
    answer
}

/// One instruction: mutate the machine, answer the next pc.
fn step(m: Machine, b: Body, pc: int) -> int {
    match b.ins[pc] {
        .ConstInt(d, v) -> put_at(m, d, const_int_val(m, b, d, v), pc),
        .ConstBool(d, v) -> put_at(m, d, Val.B(v), pc),
        .ConstStr(d, s) -> put_at(m, d, Val.S(s), pc),
        .Bin(d, op, a, x) -> put_at(m, d, bin_val(m, op, a, x), pc),
        .Un(d, op, src) -> put_at(m, d, un_val(m, op, src), pc),
        .CallRt(d, callee, args) -> put_at(m, d, rt_val(m, b, d, callee, args), pc),
        .Pack(d, elems) -> put_at(m, d, pack_val(m, b, d, elems), pc),
        .Extract(d, src, at) -> put_at(m, d, extract_val(m, b, src, at), pc),
        .CallRtVoid(callee, args) -> rt_void(m, callee, args, pc),
        .Call(d, callee, args) -> put_at(m, d, call_val(m, callee, args), pc),
        .FnAddr(d, sym) -> put_at(m, d, fn_addr_val(m, sym), pc),
        .CallPtr(d, f, args) -> put_at(m, d, call_ptr_val(m, f, args), pc),
        .IfStart(c) -> if truth(m, c) { pc + 1 } else { past_else(b, pc) },
        .SwitchStart(sel, cases) -> arm_start(b, pc, chosen_arm(m, sel, cases)),
        .ArmEnd(gives) -> merge_then(m, b, gives, pc),
        .RegionEnd(d, gives) -> put_at(m, d, at(m, gives) ?? Val.I(0), pc),
        .LoopStart -> pc + 1,
        .LoopCond(c) -> if truth(m, c) { pc + 1 } else { past_loop(b, pc) },
        .LoopEnd -> loop_header(b, pc) + 1,
        .Alloca(d) -> put_at(m, d, fresh_cell(m), pc),
        .Load(d, slot) -> put_at(m, d, cell_read(m, slot), pc),
        .Store(slot, src) -> store_step(m, slot, src, pc),
        .ScopeEnter(_) or .ScopeExit(_) or .Retain(_) or .Release(_) or
        .RetVal(_) or .FnExit(_) or .Ret(_) -> pc + 1,
    }
}

/// The backend's twin rule: a POINTER-RIDING destination makes the
/// constant the null pointer — the absence value. The two engines
/// must read one instruction alike.
fn const_int_val(m: Machine, b: Body, d: Reg, v: int) -> Val {
    if m.l.types.rides_pointer(b.reg_types[d.index]) { return Val.N }
    Val.I(v)
}

/// A packed value rides the same table an aggregate does — the
/// interpreter's bookkeeping, not the machine's layout.
/// A FLAT record IS its one field — the pack is the value itself;
/// every other aggregate is a fresh array. The backend renders the
/// same instruction the same way.
fn pack_val(m: Machine, b: Body, d: Reg, elems: List<Reg>) -> Val {
    if flat_reg(m, b, d) { return value(m, elems[0]) }
    fresh_array(m, [value(m, r) for r in elems])
}

fn flat_reg(m: Machine, b: Body, r: Reg) -> bool {
    m.l.types.is_flat(b.reg_types[r.index])
}

fn extract_val(m: Machine, b: Body, src: Reg, at: int) -> Val {
    if flat_reg(m, b, src) { return value(m, src) }
    let id: int? = match value(m, src) {
        .A(x) -> x,
        _ -> null,
    }
    if id == null { return defect_val(m, "an extract from a non-pack") }
    let arr = m.arrays[id!]
    if at < 0 || at >= arr.length { return defect_val(m, "an extract past a pack's end") }
    arr[at]
}

// ── Registers (the innermost frame, rewritten in place) ─────────

/// A register written in the TOP frame — the frame is a value, so
/// the frame that holds the write is stored back over the old one.
fn put(m: Machine, d: Reg, v: Val) {
    mut frames = m.frames
    let at = frames.length - 1
    mut regs = frames[at]
    regs.set(d.index, v)
    frames.set(at, regs)
}

fn put_at(m: Machine, d: Reg, v: Val, pc: int) -> int {
    put(m, d, v)
    pc + 1
}

fn at(m: Machine, r: Reg) -> Val? {
    m.frames.last()![r.index]
}

fn trapped(m: Machine, msg: string) {
    mut fs = m.failures
    fs.push(msg)
}

/// A register's value, which a clean program guarantees present.
fn value(m: Machine, r: Reg) -> Val {
    let v: Val? = at(m, r)
    if v == null {
        defect(m, "an undefined register was read")
        return Val.I(0)
    }
    v!
}

fn truth(m: Machine, r: Reg) -> bool {
    match value(m, r) {
        .B(v) -> v,
        _ -> {
            defect(m, "a non-bool decided a branch")
            false
        }
    }
}

fn int_val(m: Machine, r: Reg) -> int {
    whole(m, value(m, r))
}

fn text_val(m: Machine, v: Val) -> string {
    match v {
        .S(s) -> s,
        _ -> {
            defect(m, "a non-string reached text")
            ""
        }
    }
}

// ── Operations ──────────────────────────────────────────────────

fn bin_val(m: Machine, op: BinOp, a: Reg, x: Reg) -> Val {
    let nulls: bool = value(m, a) is .N || value(m, x) is .N
    if nulls { return null_eq_val(m, op, a, x) }
    let bools: bool = value(m, a) is .B && value(m, x) is .B
    if bools { return bool_eq_val(m, op, a, x) }
    let l = int_val(m, a)
    let r = int_val(m, x)
    if (op == BinOp.Div || op == BinOp.Mod) && r == 0 {
        trapped(m, "division by zero")
        return Val.I(0)
    }
    match op {
        .Add -> Val.I(l + r),
        .Sub -> Val.I(l - r),
        .Mul -> Val.I(l * r),
        .Div -> Val.I(l / r),
        .Mod -> Val.I(l % r),
        .Lt -> Val.B(l < r),
        .Le -> Val.B(l <= r),
        .Gt -> Val.B(l > r),
        .Ge -> Val.B(l >= r),
        .Eq -> Val.B(l == r),
        .Ne -> Val.B(l != r),
        .And or .Or -> defect_val(m, "a lazy op reached the eager path"),
    }
}

/// `==`/`!=` where an operand is the ABSENCE — the presence test a
/// niche nullable lowers to. Two absences agree; an absence and a
/// present value never do.
fn null_eq_val(m: Machine, op: BinOp, a: Reg, x: Reg) -> Val {
    let same: bool = value(m, a) is .N && value(m, x) is .N
    match op {
        .Eq -> Val.B(same),
        .Ne -> Val.B(!same),
        .Add or .Sub or .Mul or .Div or .Mod or .Lt or .Le or .Gt or
        .Ge or .And or .Or -> defect_val(m, "a non-equality op reached an absence"),
    }
}

/// `==`/`!=` over two bool registers — the one non-int Bin.
fn bool_eq_val(m: Machine, op: BinOp, a: Reg, x: Reg) -> Val {
    let l = truth(m, a)
    let r = truth(m, x)
    match op {
        .Eq -> Val.B(l == r),
        .Ne -> Val.B(l != r),
        .Add or .Sub or .Mul or .Div or .Mod or .Lt or .Le or .Gt or
        .Ge or .And or .Or -> defect_val(m, "a non-equality op reached bool operands"),
    }
}

fn un_val(m: Machine, op: UnOp, src: Reg) -> Val {
    match op {
        .Not -> Val.B(!truth(m, src)),
    }
}

/// THE defect phrase, worded once: everything here is impossible
/// past the gate, so each site says only what it saw.
fn defect(m: Machine, what: string) {
    trapped(m, "defect: ${what} in a clean program")
}

fn defect_val(m: Machine, what: string) -> Val {
    defect(m, what)
    Val.I(0)
}

// ── Control-flow bracket scans ──────────────────────────────────

/// Which arm the selector chooses: the case that matches, else the
/// LAST arm (the default). A semantic scan — `index_of` compares
/// non-string elements by identity (subset note).
fn chosen_arm(m: Machine, sel: Reg, cases: List<int>) -> int {
    let v = int_val(m, sel)
    for j, c in cases {
        if c == v { return j }
    }
    cases.length
}

/// Where arm `k` of the region opened at `from` begins: just past
/// the k-th arm separator at depth 0.
fn arm_start(b: Body, from: int, k: int) -> int {
    mut at = from
    for j in 0..k { at = ahead(b, at, opens_region, closes_region, (i: Ins) -> i is .ArmEnd) }
    at + 1
}

/// Forward from `from`+1: the pc of the first `target` at depth 0,
/// with `opens`/`closes` tracking nesting. Target wins over close
/// at depth 0, so a closer can BE the target.
fn ahead(b: Body, from: int, opens: fn(Ins) -> bool, closes: fn(Ins) -> bool, target: fn(Ins) -> bool) -> int {
    mut depth = 0
    mut j = from + 1
    while j < b.ins.length {
        let i = b.ins[j]
        if depth == 0 && target(i) { return j }
        if opens(i) { depth = depth + 1 }
        if closes(i) { depth = depth - 1 }
        j = j + 1
    }
    b.ins.length
}

/// From an IfStart: the pc just past its matching ArmEnd.
fn past_else(b: Body, from: int) -> int {
    ahead(b, from, opens_region, closes_region, (i: Ins) -> i is .ArmEnd) + 1
}

/// At an ArmEnd after the then-branch ran: seal the merge at the
/// matching RegionEnd with the then-value and continue past it.
fn merge_then(m: Machine, b: Body, gives: Reg, pc: int) -> int {
    let v: Val? = at(m, gives)
    let end = ahead(b, pc, opens_region, closes_region, closes_region)
    if end < b.ins.length {
        let d: Reg? = match b.ins[end] {
            .RegionEnd(dst, _) -> dst,
            _ -> null,
        }
        if d != null { put(m, d!, v ?? Val.I(0)) }
    }
    end + 1
}

/// From a false LoopCond: the pc just past the matching LoopEnd.
fn past_loop(b: Body, from: int) -> int {
    ahead(b, from, (i: Ins) -> i is .LoopStart, (i: Ins) -> i is .LoopEnd, (i: Ins) -> i is .LoopEnd) + 1
}

/// From a LoopEnd: its matching LoopStart — the back edge. The
/// one backward scan, shaped exactly as `ahead`: target first at
/// depth 0, then the open/close bookkeeping.
fn loop_header(b: Body, from: int) -> int {
    mut depth = 0
    mut j = from - 1
    while j >= 0 {
        let i = b.ins[j]
        if depth == 0 && i is .LoopStart { return j }
        if i is .LoopEnd { depth = depth + 1 }
        if i is .LoopStart { depth = depth - 1 }
        j = j - 1
    }
    0
}

// ── Calls ───────────────────────────────────────────────────────

/// A fn address in EVAL-land is the body's index — opaque, like
/// the machine address it stands in for.
fn fn_addr_val(m: Machine, sym: string) -> Val {
    for j, b in m.l.fns {
        if b.name == sym { return Val.I(j) }
    }
    defect_val(m, "a fn address without a body survived lowering")
}

fn call_ptr_val(m: Machine, f: Reg, args: List<Reg>) -> Val {
    let held: Val = value(m, f)
    let idx: int? = match held {
        .I(j) -> j,
        _ -> null,
    }
    if idx == null { return non_address(m) }
    let at = idx!
    if at < 0 || at >= m.l.fns.length { return non_address(m) }
    run_call(m, m.l.fns[at], args)
}

fn non_address(m: Machine) -> Val {
    defect_val(m, "an indirect call through a non-address")
}

fn call_val(m: Machine, callee: string, args: List<Reg>) -> Val {
    let target: Body? = body_named(m.l, callee)
    if target == null { return defect_val(m, "a call without a body survived lowering") }
    run_call(m, target!, args)
}

/// Both call shapes land here: arguments read, the body run, an
/// answerless body a defect.
fn run_call(m: Machine, target: Body, args: List<Reg>) -> Val {
    let answer: Val? = run_body(m, target, [value(m, r) for r in args])
    answer ?? defect_val(m, "a fn body answered nothing")
}

// ── Mut cells ───────────────────────────────────────────────────

fn fresh_cell(m: Machine) -> Val {
    mut cs = m.cells
    cs.push(Val.I(0))
    Val.C(cs.length - 1)
}

fn cell_read(m: Machine, slot: Reg) -> Val {
    match value(m, slot) {
        .C(id) -> m.cells[id],
        _ -> defect_val(m, "a load through a non-cell"),
    }
}

fn store_step(m: Machine, slot: Reg, src: Reg, pc: int) -> int {
    let v = value(m, src)
    match value(m, slot) {
        .C(id) -> {
            mut cs = m.cells
            cs.set(id, v)
        }
        _ -> defect(m, "a store through a non-cell"),
    }
    pc + 1
}

// ── Text projections ────────────────────────────────────────────

/// A value's printed text — the twin of the runtime's projections.
fn val_text(m: Machine, v: Val) -> string {
    match v {
        .I(n) -> "${n}",
        .B(t) -> if t { "true" } else { "false" },
        .S(s) -> s,
        .A(id) -> "[${joined([val_text(m, e) for e in m.arrays[id]], ", ")}]",
        .C(_) -> "<cell>",
        .M(_) -> "<map>",
        .N -> "null",
    }
}

// ── The runtime surface, hosted — runtime_api.av's fifth consumer ─

fn rt_void(m: Machine, callee: string, args: List<Reg>, pc: int) -> int {
    let _ = rt_dispatch(m, callee, [value(m, r) for r in args])
    pc + 1
}

/// A value-producing runtime call; a Bool-typed destination narrows
/// the runtime's i64 answer, exactly as the backend does.
fn rt_val(m: Machine, b: Body, d: Reg, callee: string, args: List<Reg>) -> Val {
    let raw = rt_dispatch(m, callee, [value(m, r) for r in args])
    if m.l.types.shape_of(b.reg_types[d.index]) is .Bool {
        return match raw {
            .I(n) -> Val.B(n != 0),
            _ -> raw,
        }
    }
    raw
}

/// The registry's host column, hosted — exhaustive over RtHost, so
/// a row with a new host demands its arm here.
fn rt_dispatch(m: Machine, callee: string, vals: List<Val>) -> Val {
    let sig: RtSig? = rt_sig_of(callee)
    if sig == null {
        if m.l.externs.any(it.name == callee) { return unhosted_extern(m, callee) }
        return defect_val(m, "an unknown runtime callee `${callee}` survived lowering")
    }
    let host = sig!.host
    match host {
        .Puts -> puts_val(m, vals),
        .Streq -> streq_val(m, vals),
        .ArrayNew -> array_new_val(m),
        .ArrayPush -> array_push_val(m, vals),
        .ArrayGet -> array_get_val(m, vals),
        .ArrayLen -> array_len_val(m, vals),
        .CellRelease -> Val.I(0),
        .CellUnique -> cell_unique_val(m, vals),
        .SlotUnique -> slot_unique_val(m, vals),
        .SlotSet -> slot_set_val(m, vals),
        .MapNew -> map_new_val(m),
        .MapLen -> map_len_val(m, vals),
        .MapHas -> map_has_val(m, vals),
        .MapGet -> map_get_val(m, vals),
        .MapSet -> map_set_val(m, vals),
        .StrJoin -> str_join_val(m, vals),
        .Insist -> insist_val(m, vals),
        .InsistScalar -> insist_scalar_val(m, vals),
        .Text -> Val.S(val_text(m, vals[0])),
        .Strlen -> Val.I(text_val(m, vals[0]).length),
        .ArrayPop -> array_pop_val(m, vals),
        .ArrayConcat -> array_concat_val(m, vals),
        .ArraySlice -> array_slice_val(m, vals),
        .StrContains -> verdict(text_val(m, vals[0]).contains(text_val(m, vals[1]))),
        .StrStartsWith -> verdict(text_val(m, vals[0]).starts_with(text_val(m, vals[1]))),
        .StrEndsWith -> verdict(text_val(m, vals[0]).ends_with(text_val(m, vals[1]))),
        .StrIndexOf -> Val.I(text_val(m, vals[0]).index_of(text_val(m, vals[1]))),
        .StrSubstring -> str_substring_val(m, vals),
        .StrSplit -> fresh_array(m, [Val.S(piece) for piece in pieces_of(text_val(m, vals[0]), text_val(m, vals[1]))]),
        .StrReplace -> Val.S(replaced(text_val(m, vals[0]), text_val(m, vals[1]), text_val(m, vals[2]))),
        .StrCharCode -> str_char_code_val(m, vals),
        .StrTrim -> Val.S(trimmed(text_val(m, vals[0]))),
        .StrConcat -> Val.S(text_val(m, vals[0]) + text_val(m, vals[1])),
        .Unhosted -> defect_val(m, "a runtime callee the interpreter does not host: `${callee}`"),
    }
}

/// An extern fn is the host's — the evaluator has no body for it.
fn unhosted_extern(m: Machine, callee: string) -> Val {
    trapped(m, "`${callee}` is extern — the evaluator cannot host it; build natively")
    Val.I(0)
}

fn array_new_val(m: Machine) -> Val {
    fresh_array(m, [])
}

/// A new array in the table, holding these values.
fn fresh_array(m: Machine, elems: List<Val>) -> Val {
    mut arrs = m.arrays
    arrs.push(elems)
    Val.A(arrs.length - 1)
}

fn array_id(v: Val) -> int? {
    match v {
        .A(id) -> id,
        _ -> null,
    }
}

/// The array a value names, handed to `f` — or the defect.
fn with_array(m: Machine, v: Val, what: string, f: fn(int) -> Val) -> Val {
    let id: int? = array_id(v)
    if id == null { return defect_val(m, what) }
    f(id!)
}

/// An int argument's value — a defect answers zero.
fn whole(m: Machine, v: Val) -> int {
    match v {
        .I(n) -> n,
        _ -> {
            defect(m, "a non-int reached a runtime seat")
            0
        }
    }
}

/// A bool answer as the runtime words it — a word, which the
/// register's type reads back as a bool.
fn verdict(b: bool) -> Val {
    Val.I(if b { 1 } else { 0 })
}

/// `n` held within [lo, hi].
fn clamped(n: int, lo: int, hi: int) -> int {
    if n < lo { return lo }
    if n > hi { return hi }
    n
}

fn array_pop_val(m: Machine, vals: List<Val>) -> Val {
    with_array(m, vals[0], "a pop from a non-array", (id: int) -> popped(m, id))
}

fn popped(m: Machine, id: int) -> Val {
    mut arrays = m.arrays
    mut arr = arrays[id]
    if arr.is_empty() {
        trapped(m, "pop on an empty list")
        return Val.I(0)
    }
    let last = arr.pop()
    arrays.set(id, arr)
    last
}

fn array_concat_val(m: Machine, vals: List<Val>) -> Val {
    let a: int? = array_id(vals[0])
    let b: int? = array_id(vals[1])
    if a == null || b == null { return defect_val(m, "a concat over a non-array") }
    fresh_array(m, m.arrays[a!].concat(m.arrays[b!]))
}

/// The slots from lo up to hi, clamped — worded like the runtime's.
fn array_slice_val(m: Machine, vals: List<Val>) -> Val {
    with_array(m, vals[0], "a slice of a non-array", (id: int) -> sliced(m, id, whole(m, vals[1]), whole(m, vals[2])))
}

fn sliced(m: Machine, id: int, from: int, to: int) -> Val {
    let xs = m.arrays[id]
    let lo = clamped(from, 0, xs.length)
    let hi = clamped(to, 0, xs.length)
    fresh_array(m, if lo < hi { xs.slice(lo, hi) } else { [] })
}

/// The bytes from lo up to hi, clamped — worded like the runtime's.
fn str_substring_val(m: Machine, vals: List<Val>) -> Val {
    let s = text_val(m, vals[0])
    let n = s.length
    let lo = clamped(whole(m, vals[1]), 0, n)
    let hi = clamped(whole(m, vals[2]), 0, n)
    Val.S(if lo < hi { s.substring(lo, hi) } else { "" })
}

/// The pieces between separators, cut as the runtime cuts them: a
/// leading empty piece stays, one trailing is dropped, empty text
/// splits to nothing, and an empty separator keeps the text whole.
fn pieces_of(s: string, sep: string) -> List<string> {
    if s.length == 0 { return [] }
    if sep.length == 0 { return [s] }
    mut out: List<string> = []
    mut rest = s
    mut at = rest.index_of(sep)
    while at >= 0 {
        out.push(rest.substring(0, at))
        rest = rest.substring(at + sep.length, rest.length)
        at = rest.index_of(sep)
    }
    if rest.length > 0 { out.push(rest) }
    out
}

/// Every occurrence of `from` as `to`, cut as the runtime cuts:
/// an empty `from` changes nothing.
fn replaced(s: string, from: string, to: string) -> string {
    if from.length == 0 { return s }
    pieces_of_all(s, from).join(to)
}

/// The pieces between EVERY separator — a trailing empty piece
/// kept, unlike `split` — so a join with `to` is the replacement.
fn pieces_of_all(s: string, sep: string) -> List<string> {
    mut out: List<string> = []
    mut rest = s
    mut at = rest.index_of(sep)
    while at >= 0 {
        out.push(rest.substring(0, at))
        rest = rest.substring(at + sep.length, rest.length)
        at = rest.index_of(sep)
    }
    out.push(rest)
    out
}

/// The text without its surrounding blanks — space, tab, newline
/// and return, the runtime's set.
fn trimmed(s: string) -> string {
    let n = s.length
    mut lo = 0
    while lo < n && is_blank(code_at(s, lo)) { lo = lo + 1 }
    mut hi = n
    while hi > lo && is_blank(code_at(s, hi - 1)) { hi = hi - 1 }
    s.substring(lo, hi)
}

fn is_blank(c: int) -> bool {
    c == 32 || c == 9 || c == 10 || c == 13
}

/// The byte at `i` as a code; past the text, the runtime's trap.
fn str_char_code_val(m: Machine, vals: List<Val>) -> Val {
    let s = text_val(m, vals[0])
    let i = whole(m, vals[1])
    let n = s.length
    if i < 0 || i >= n { return out_of_bounds(m, i, n) }
    Val.I(code_at(s, i))
}

/// VALUE SEMANTICS, spelled as the spec: the interpreter has no
/// counts, so opening a place for writing ALWAYS copies the box —
/// native copies only when shared, and the differential proves
/// the two agree.
fn cloned_val(m: Machine, v: Val) -> Val {
    match v {
        .A(id) -> {
            mut arrs = m.arrays
            arrs.push([x for x in m.arrays[id]])
            Val.A(arrs.length - 1)
        }
        .M(id) -> {
            mut ms = m.maps
            ms.push(MapVal { keys: [k for k in m.maps[id].keys], vals: [x for x in m.maps[id].vals] })
            Val.M(ms.length - 1)
        }
        .I(_) or .B(_) or .S(_) or .C(_) or .N -> v,
    }
}

/// A map's keys and values in written order — the spec's map,
/// found by a scan.
type MapVal = { keys: List<string>, vals: List<Val> }

fn map_new_val(m: Machine) -> Val {
    mut ms = m.maps
    ms.push(MapVal { keys: [], vals: [] })
    Val.M(ms.length - 1)
}

fn map_id(v: Val) -> int? {
    match v {
        .M(id) -> id,
        _ -> null,
    }
}

fn map_slot(m: Machine, id: int, key: string) -> int {
    m.maps[id].keys.index_of(key)
}

/// The map a handle names, or the defect for a value that is none —
/// the guard every map primitive opens with.
fn with_map(m: Machine, v: Val, what: string, f: fn(int) -> Val) -> Val {
    let id: int? = map_id(v)
    if id == null { return defect_val(m, what) }
    f(id!)
}

fn map_len_val(m: Machine, vals: List<Val>) -> Val {
    with_map(m, vals[0], "a length of a non-map", (id: int) -> Val.I(m.maps[id].keys.length))
}

fn map_has_val(m: Machine, vals: List<Val>) -> Val {
    with_map(m, vals[0], "a lookup in a non-map", (id: int) -> Val.B(map_slot(m, id, text_val(m, vals[1])) >= 0))
}

fn map_get_val(m: Machine, vals: List<Val>) -> Val {
    with_map(m, vals[0], "a read from a non-map", (id: int) -> map_read(m, id, text_val(m, vals[1])))
}

fn map_read(m: Machine, id: int, key: string) -> Val {
    let s = map_slot(m, id, key)
    if s < 0 { return Val.N }
    m.maps[id].vals[s]
}

fn map_set_val(m: Machine, vals: List<Val>) -> Val {
    with_map(m, vals[0], "a write into a non-map", (id: int) -> map_write(m, id, text_val(m, vals[1]), vals[2]))
}

fn map_write(m: Machine, id: int, key: string, v: Val) -> Val {
    let s = map_slot(m, id, key)
    mut maps = m.maps
    let entry = maps[id]
    let written = if s >= 0 { entry with { vals: copied(entry.vals, [v], s) } }
                  else { entry with { keys: entry.keys.concat([key]), vals: entry.vals.concat([v]) } }
    maps.set(id, written)
    Val.I(0)
}

fn cell_unique_val(m: Machine, vals: List<Val>) -> Val {
    match vals[0] {
        .C(id) -> {
            let fresh = cloned_val(m, m.cells[id])
            mut cs = m.cells
            cs.set(id, fresh)
            fresh
        }
        _ -> defect_val(m, "a place opened through a non-cell"),
    }
}

fn slot_unique_val(m: Machine, vals: List<Val>) -> Val {
    let held = array_get_val(m, vals)
    let fresh = cloned_val(m, held)
    let _ = slot_set_val(m, [vals[0], vals[1], fresh])
    fresh
}

fn slot_set_val(m: Machine, vals: List<Val>) -> Val {
    with_array(m, vals[0], "a non-array slot write", (id: int) -> slot_written(m, id, whole(m, vals[1]), vals[2]))
}

fn slot_written(m: Machine, id: int, at: int, v: Val) -> Val {
    mut arrays = m.arrays
    mut arr = arrays[id]
    if at < 0 || at >= arr.length { return out_of_bounds(m, at, arr.length) }
    arr.set(at, v)
    arrays.set(id, arr)
    Val.I(0)
}

/// The bounds refusal, worded exactly like the runtime's — the
/// divergence registry pins both.
fn out_of_bounds(m: Machine, at: int, len: int) -> Val {
    trapped(m, "index ${at} is out of bounds (length ${len})")
    Val.I(0)
}

fn array_push_val(m: Machine, vals: List<Val>) -> Val {
    with_array(m, vals[0], "a push into a non-array", (id: int) -> pushed(m, id, vals[1]))
}

fn pushed(m: Machine, id: int, v: Val) -> Val {
    mut arrays = m.arrays
    mut arr = arrays[id]
    arr.push(v)
    arrays.set(id, arr)
    Val.I(0)
}

/// `!` met an absence — the ONE refusal both repr paths give, its
/// wording matched to the runtime's: the two engines must refuse
/// alike, and the divergence registry pins all of them.
fn absent_refused(m: Machine) -> Val {
    trapped(m, "unwrapped an absent value")
    Val.I(0)
}

/// `v!` on a NICHE nullable — identity through the presence guard.
fn insist_val(m: Machine, vals: List<Val>) -> Val {
    if vals[0] is .N { return absent_refused(m) }
    vals[0]
}

/// `v!` on a PAIR nullable — the flag guards, the value passes.
fn insist_scalar_val(m: Machine, vals: List<Val>) -> Val {
    let present: bool = match vals[0] {
        .B(t) -> t,
        _ -> false,
    }
    if !present { return absent_refused(m) }
    vals[1]
}

fn array_get_val(m: Machine, vals: List<Val>) -> Val {
    with_array(m, vals[0], "a read from a non-array", (id: int) -> slot_read_val(m, id, whole(m, vals[1])))
}

fn slot_read_val(m: Machine, id: int, at: int) -> Val {
    let arr = m.arrays[id]
    if at < 0 || at >= arr.length { return out_of_bounds(m, at, arr.length) }
    arr[at]
}

fn array_len_val(m: Machine, vals: List<Val>) -> Val {
    with_array(m, vals[0], "a length of a non-array", (id: int) -> Val.I(m.arrays[id].length))
}

fn str_join_val(m: Machine, vals: List<Val>) -> Val {
    with_array(m, vals[0], "a join over a non-array", (id: int) -> Val.S(joined([text_val(m, e) for e in m.arrays[id]], text_val(m, vals[1]))))
}

/// One printed line lands in the machine's output.
fn puts_val(m: Machine, vals: List<Val>) -> Val {
    let line = text_val(m, vals[0])
    mut o = m.out
    o.push(line)
    Val.I(0)
}

fn streq_val(m: Machine, vals: List<Val>) -> Val {
    verdict(text_val(m, vals[0]) == text_val(m, vals[1]))
}
