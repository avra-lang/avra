//! The ONE semantics, executed — the IR interpreter. Features
//! define meaning once (lowering); this walks the SAME instruction
//! stream the backend compiles, so eval and native cannot disagree
//! by construction. Every CallRt row in runtime_api.av has its host
//! implementation here, contract-matched to runtime/avra_runtime.c
//! — the registry's fifth consumer, refusal wording included.
//!
//! The IR is brackets, not jumps: control flow is a program counter
//! plus depth-matched skips (regions — two-arm ifs and N-arm
//! switches alike — and loop back edges). Values
//! are a tiny closed enum; arrays, mut cells, and register frames
//! live in machine tables addressed by handle.
use core.{copied, Ins, Reg, BinOp, UnOp, RtSig, opens_region, closes_region, filled, joined, rt_index}

/// A runtime value: the interpreter's whole vocabulary.
enum Val {
    I(v: int)
    B(v: bool)
    S(v: string)
    /// An aggregate — a handle into the machine's array table.
    A(id: int)
    /// A mut binding's cell — a handle into the cell table.
    C(id: int)
    /// A map — a handle into the map table.
    M(id: int)
    /// The null pointer — a niche nullable's absence.
    N
}

/// The machine: the program, its heaps, the register frame stack
/// (innermost last — mutated through element aliases), its output,
/// and its refusal.
type Machine = {
    l: Lowered,
    // the runtime's rows by name, built once per machine — the
    // evaluator asks per runtime call executed
    rt: Map<string, RtSig>,
    frames: List<List<Val?>>,
    arrays: List<List<Val>>,
    maps: List<MapVal>,
    cells: List<Val>,
    // a `once fn`'s answer, settled for this run under its symbol
    onces: Map<string, Val>,
    out: List<string>,
    failures: List<string>,
}

/// A machine at rest over a program: no frames, no heap, nothing said.
fn fresh_machine(l: Lowered) -> Machine {
    Machine { l: l, rt: rt_index(), frames: [], arrays: [], maps: [], cells: [], onces: {}, out: [], failures: [] }
}

/// Run a lowered program: its printed output, or the refusal.
export fn run_lowered(l: Lowered) -> Result<string, string> {
    .Ok(printed(ran(l, l.entry)?))
}

/// One PROGRAM of a corpus binary, run in the evaluator: its body by
/// symbol, its printed lines as the answer — what `run_lowered` does
/// for the entry.
export fn run_program(l: Lowered, symbol: string) -> Result<string, string> {
    let body = named_body(l, symbol)?
    .Ok(printed(ran(l, body)?))
}

/// One fn run by its symbol under no arguments, its bool answer —
/// how a test case runs. A failure inside answers as the refusal.
export fn run_symbol(l: Lowered, symbol: string) -> Result<bool, string> {
    let body = named_body(l, symbol)?
    let r = ran(l, body)?
    if r.answer == null { return .Err("`${symbol}` answered nothing") }
    truth_of(symbol, r.answer!)
}

/// A body run to its end under no arguments: the machine after, with
/// what the body answered — or the first failure inside.
type Ran = { m: Machine, answer: Val? }

fn ran(l: Lowered, target: Body) -> Result<Ran, string> {
    mut m = fresh_machine(l)
    let answer: Val? = m.run_body(target, [])
    if !m.failures.is_empty() { return .Err(m.failures.first()!) }
    .Ok(Ran { m: m, answer: answer })
}

/// The body a symbol names, or the refusal.
fn named_body(l: Lowered, symbol: string) -> Result<Body, string> {
    let target: Body? = body_named(l, symbol)
    if target == null { return .Err("no body named `${symbol}`") }
    .Ok(target!)
}

/// What a run printed, one line per puts.
fn printed(r: Ran) -> string {
    joined(r.m.out, "\n")
}

fn body_named(l: Lowered, name: string) -> Body? {
    l.fns.find(it.name == name)
}

fn truth_of(symbol: string, v: Val) -> Result<bool, string> {
    match v {
        .B(b) -> .Ok(b),
        _ -> .Err("`${symbol}` answered no bool"),
    }
}

/// The deepest call the machine runs before it refuses: the machine
/// recurses on the host's stack, and a runaway recursion must answer
/// as a trap naming its case, never as a crash of the run. The bound
/// is what a test worker's thread stack holds with margin (its
/// ceiling measured between 600 and 700 nested calls); a machine
/// with a frame stack of its own lifts it.
fn call_limit() -> int {
    400
}

impl Machine {
    /// One body under its argument values; params ARE registers 0..N-1.
    /// The answer is RetVal's register, when one fires.
    fn run_body(b: Body, args: List<Val>) -> Val? {
        // LICENSED I34: a BORROW — a read holds the table to the scope's end, so a path write after it would CLONE it (liveness, S3, retires this)
        mut frames = self.frames
        if frames.length >= call_limit() {
            self.trapped("recursion too deep — ${call_limit()} nested calls")
            return null
        }
        frames.push(filled<Val?>(b.reg_types.length, null))
        for (j, a) in args.enumerate() { self.put(Reg { index: j }, a) }
        // LICENSED I4: the run loop's answer, not a scan
        mut answer: Val? = null
        mut pc = 0
        while pc < b.ins.length && self.failures.is_empty() {
            // everything else DELEGATES to `step`, which is exhaustive
            match b.ins[pc] {
                .RetVal(r) -> {
                    answer = self.at(r)
                    pc = b.ins.length
                }
                .FnExit(r) -> {
                    answer = self.at(r)
                    pc = b.ins.length
                }
                .Ret(_) -> {
                    pc = b.ins.length
                }
                rest -> {
                    pc = self.step(b, pc)
                }
            }
        }
        let _ = frames.pop()
        answer
    }

    fn step(b: Body, pc: int) -> int {
        match b.ins[pc] {
            .ConstInt(d, v) -> self.put_at(d, self.const_int_val(b, d, v), pc),
            .ConstBool(d, v) -> self.put_at(d, Val.B(v), pc),
            .ConstStr(d, s) -> self.put_at(d, Val.S(s), pc),
            .Bin(d, op, a, x) -> self.put_at(d, self.bin_val(op, a, x), pc),
            .Un(d, op, src) -> self.put_at(d, self.un_val(op, src), pc),
            .CallRt(d, callee, args) -> self.put_at(d, self.rt_val(b, d, callee, args), pc),
            .Pack(d, elems) -> self.put_at(d, self.pack_val(b, d, elems), pc),
            .Extract(d, src, at) -> self.put_at(d, self.extract_val(b, src, at), pc),
            .CallRtVoid(callee, args) -> self.rt_void(callee, args, pc),
            .Call(d, callee, args) -> self.put_at(d, self.call_val(callee, args), pc),
            .FnAddr(d, sym) -> self.put_at(d, self.fn_addr_val(sym), pc),
            .CallPtr(d, f, args) -> self.put_at(d, self.call_ptr_val(f, args), pc),
            .IfStart(c) -> if self.truth(c) { pc + 1 } else { past_else(b, pc) },
            .SwitchStart(sel, cases) -> arm_start(b, pc, self.chosen_arm(sel, cases)),
            .ArmEnd(gives) -> self.merge_then(b, gives, pc),
            .RegionEnd(d, gives) -> self.put_at(d, self.at(gives) ?? Val.I(0), pc),
            .LoopStart -> pc + 1,
            .LoopCond(c) -> if self.truth(c) { pc + 1 } else { past_loop(b, pc) },
            .LoopEnd -> loop_header(b, pc) + 1,
            .Alloca(d) -> self.put_at(d, self.fresh_cell(), pc),
            .Load(d, slot) -> self.put_at(d, self.cell_read(slot), pc),
            .Store(slot, src) -> self.store_step(slot, src, pc),
            .ScopeEnter(_) or .ScopeExit(_) or .Retain(_) or .Release(_) or
            .RetVal(_) or .FnExit(_) or .Ret(_) -> pc + 1,
        }
    }


    /// The backend's twin rule: a POINTER-RIDING destination makes the
    /// constant the null pointer — the absence value. The two engines
    /// must read one instruction alike.
    fn const_int_val(b: Body, d: Reg, v: int) -> Val {
        if self.l.types.rides_pointer(b.reg_types[d.index]) { return Val.N }
        Val.I(v)
    }


    /// A packed value rides the same table an aggregate does — the
    /// interpreter's bookkeeping, not the machine's layout.
    /// A FLAT record IS its one field — the pack is the value itself;
    /// every other aggregate is a fresh array. The backend renders the
    /// same instruction the same way.
    fn pack_val(b: Body, d: Reg, elems: List<Reg>) -> Val {
        if self.flat_reg(b, d) { return self.value(elems[0]) }
        self.fresh_array([self.value(r) for r in elems])
    }


    fn flat_reg(b: Body, r: Reg) -> bool {
        self.l.types.is_flat(b.reg_types[r.index])
    }


    fn extract_val(b: Body, src: Reg, at: int) -> Val {
        if self.flat_reg(b, src) { return self.value(src) }
        let id: int? = match self.value(src) {
            .A(x) -> x,
            _ -> null,
        }
        if id == null { return self.defect_val("an extract from a non-pack") }
        let arr = self.arrays[id!]
        if at < 0 || at >= arr.length { return self.defect_val("an extract past a pack's end") }
        arr[at]
    }


    /// A register written in the TOP frame — the frame is a value, so
    /// the frame that holds the write is stored back over the old one.
    fn put(d: Reg, v: Val) {
        // LICENSED I34: a BORROW — a read holds the table to the scope's end, so a path write after it would CLONE it (liveness, S3, retires this)
        mut frames = self.frames
        let at = frames.length - 1
        mut regs = frames[at]
        regs.set(d.index, v)
        frames.set(at, regs)


    }

    fn put_at(d: Reg, v: Val, pc: int) -> int {
        self.put(d, v)
        pc + 1
    }


    fn at(r: Reg) -> Val? {
        self.frames.last()![r.index]
    }


    fn trapped(msg: string) {
        self.failures.push(msg)
    }


    /// A register's value, which a clean program guarantees present.
    fn value(r: Reg) -> Val {
        let v: Val? = self.at(r)
        if v == null {
            self.defect("an undefined register was read")
            return Val.I(0)
        }
        v!
    }


    fn truth(r: Reg) -> bool {
        match self.value(r) {
            .B(v) -> v,
            _ -> {
                self.defect("a non-bool decided a branch")
                false
            }
        }
    }


    fn int_val(r: Reg) -> int {
        self.whole(self.value(r))
    }


    fn text_val(v: Val) -> string {
        match v {
            .S(s) -> s,
            _ -> {
                self.defect("a non-string reached text")
                ""
            }
        }
    }


    fn bin_val(op: BinOp, a: Reg, x: Reg) -> Val {
        let nulls: bool = self.value(a) is .N || self.value(x) is .N
        if nulls { return self.null_eq_val(op, a, x) }
        let bools: bool = self.value(a) is .B && self.value(x) is .B
        if bools { return self.bool_eq_val(op, a, x) }
        let l = self.int_val(a)
        let r = self.int_val(x)
        if (op == BinOp.Div || op == BinOp.Mod) && r == 0 {
            self.trapped("division by zero")
            return Val.I(0)
        }
        match op {
            .Add -> Val.I(l + r),
            .Sub -> Val.I(l - r),
            .Mul -> Val.I(l * r),
            .Div -> Val.I(l / r),
            .Mod -> Val.I(l % r),
            .Lt -> Val.B(l < r),
            .Le -> Val.B(l <= r),
            .Gt -> Val.B(l > r),
            .Ge -> Val.B(l >= r),
            .Eq -> Val.B(l == r),
            .Ne -> Val.B(l != r),
            .And or .Or -> self.defect_val("a lazy op reached the eager path"),
        }
    }


    /// `==`/`!=` where an operand is the ABSENCE — the presence test a
    /// niche nullable lowers to. Two absences agree; an absence and a
    /// present value never do.
    fn null_eq_val(op: BinOp, a: Reg, x: Reg) -> Val {
        let same: bool = self.value(a) is .N && self.value(x) is .N
        match op {
            .Eq -> Val.B(same),
            .Ne -> Val.B(!same),
            .Add or .Sub or .Mul or .Div or .Mod or .Lt or .Le or .Gt or
            .Ge or .And or .Or -> self.defect_val("a non-equality op reached an absence"),
        }
    }


    /// `==`/`!=` over two bool registers — the one non-int Bin.
    fn bool_eq_val(op: BinOp, a: Reg, x: Reg) -> Val {
        let l = self.truth(a)
        let r = self.truth(x)
        match op {
            .Eq -> Val.B(l == r),
            .Ne -> Val.B(l != r),
            .Add or .Sub or .Mul or .Div or .Mod or .Lt or .Le or .Gt or
            .Ge or .And or .Or -> self.defect_val("a non-equality op reached bool operands"),
        }
    }


    fn un_val(op: UnOp, src: Reg) -> Val {
        match op {
            .Not -> Val.B(!self.truth(src)),
        }
    }


    /// THE defect phrase, worded once: everything here is impossible
    /// past the gate, so each site says only what it saw.
    fn defect(what: string) {
        self.trapped("defect: ${what} in a clean program")
    }


    fn defect_val(what: string) -> Val {
        self.defect(what)
        Val.I(0)
    }


    /// Which arm the selector chooses: the case that matches, else the
    /// LAST arm (the default). A semantic scan — `index_of` compares
    /// non-string elements by identity (subset note).
    fn chosen_arm(sel: Reg, cases: List<int>) -> int {
        let v = self.int_val(sel)
        for j, c in cases {
            if c == v { return j }
        }
        cases.length
    }


    /// At an ArmEnd after the then-branch ran: seal the merge at the
    /// matching RegionEnd with the then-value and continue past it.
    fn merge_then(b: Body, gives: Reg, pc: int) -> int {
        let v: Val? = self.at(gives)
        let end = ahead(b, pc, opens_region, closes_region, closes_region)
        if end < b.ins.length {
            let d: Reg? = match b.ins[end] {
                .RegionEnd(dst, _) -> dst,
                _ -> null,
            }
            if d != null { self.put(d!, v ?? Val.I(0)) }
        }
        end + 1
    }


    /// A fn address in EVAL-land is the body's index — opaque, like
    /// the machine address it stands in for.
    fn fn_addr_val(sym: string) -> Val {
        for j, b in self.l.fns {
            if b.name == sym { return Val.I(j) }
        }
        self.defect_val("a fn address without a body survived lowering")
    }


    fn call_ptr_val(f: Reg, args: List<Reg>) -> Val {
        let held: Val = self.value(f)
        let idx: int? = match held {
            .I(j) -> j,
            _ -> null,
        }
        if idx == null { return self.non_address() }
        let at = idx!
        if at < 0 || at >= self.l.fns.length { return self.non_address() }
        self.run_call(self.l.fns[at], args)
    }


    fn non_address() -> Val {
        self.defect_val("an indirect call through a non-address")
    }


    fn call_val(callee: string, args: List<Reg>) -> Val {
        let target: Body? = body_named(self.l, callee)
        if target == null { return self.defect_val("a call without a body survived lowering") }
        self.run_call(target!, args)
    }


    /// Both call shapes land here: arguments read, the body run, an
    /// answerless body a defect.
    fn run_call(target: Body, args: List<Reg>) -> Val {
        let answer: Val? = self.run_body(target, [self.value(r) for r in args])
        answer ?? self.defect_val("a fn body answered nothing")
    }


    fn fresh_cell() -> Val {
        self.cells.push(Val.I(0))
        Val.C(self.cells.length - 1)
    }


    fn cell_read(slot: Reg) -> Val {
        match self.value(slot) {
            .C(id) -> self.cells[id],
            _ -> self.defect_val("a load through a non-cell"),
        }
    }


    fn store_step(slot: Reg, src: Reg, pc: int) -> int {
        let v = self.value(src)
        match self.value(slot) {
            .C(id) -> {
                self.cells.set(id, v)
            }
            _ -> self.defect("a store through a non-cell"),
        }
        pc + 1
    }


    /// A value's printed text — the twin of the runtime's projections.
    fn val_text(v: Val) -> string {
        match v {
            .I(n) -> "${n}",
            .B(t) -> if t { "true" } else { "false" },
            .S(s) -> s,
            .A(id) -> "[${joined([self.val_text(e) for e in self.arrays[id]], ", ")}]",
            .C(_) -> "<cell>",
            .M(_) -> "<map>",
            .N -> "null",
        }
    }


    fn rt_void(callee: string, args: List<Reg>, pc: int) -> int {
        let _ = self.rt_dispatch(callee, [self.value(r) for r in args])
        pc + 1
    }


    /// A value-producing runtime call; a Bool-typed destination narrows
    /// the runtime's i64 answer, exactly as the backend does.
    fn rt_val(b: Body, d: Reg, callee: string, args: List<Reg>) -> Val {
        let raw = self.rt_dispatch(callee, [self.value(r) for r in args])
        if self.l.types.shape_of(b.reg_types[d.index]) is .Bool {
            return match raw {
                .I(n) -> Val.B(n != 0),
                _ -> raw,
            }
        }
        raw
    }


    /// The registry's host column, hosted — exhaustive over RtHost, so
    /// a row with a new host demands its arm here.
    fn rt_dispatch(callee: string, vals: List<Val>) -> Val {
        let sig: RtSig? = self.rt.get(callee)
        if sig == null {
            if self.l.externs.any(it.name == callee) { return self.unhosted_extern(callee) }
            return self.defect_val("an unknown runtime callee `${callee}` survived lowering")
        }
        let host = sig!.host
        match host {
            .Puts -> self.puts_val(vals),
            .Streq -> self.streq_val(vals),
            .ArrayNew -> self.array_new_val(),
            .ArrayPush -> self.array_push_val(vals),
            .ArrayGet -> self.array_get_val(vals),
            .ArrayLen -> self.array_len_val(vals),
            .CellRelease -> Val.I(0),
            .CellUnique -> self.cell_unique_val(vals),
            .SlotUnique -> self.slot_unique_val(vals),
            .SlotSet -> self.slot_set_val(vals),
            .MapNew -> self.map_new_val(),
            .MapLen -> self.map_len_val(vals),
            .MapHas -> self.map_has_val(vals),
            .MapGet -> self.map_get_val(vals),
            .MapSet -> self.map_set_val(vals),
            .StrJoin -> self.str_join_val(vals),
            .OnceGet -> self.once_get_val(vals),
            .OnceSet -> self.once_set_val(vals),
            .Insist -> self.insist_val(vals),
            .InsistScalar -> self.insist_scalar_val(vals),
            .Text -> Val.S(self.val_text(vals[0])),
            .Strlen -> Val.I(self.text_val(vals[0]).length),
            .ArrayPop -> self.array_pop_val(vals),
            .ArrayConcat -> self.array_concat_val(vals),
            .ArraySlice -> self.array_slice_val(vals),
            .StrContains -> verdict(self.text_val(vals[0]).contains(self.text_val(vals[1]))),
            .StrStartsWith -> verdict(self.text_val(vals[0]).starts_with(self.text_val(vals[1]))),
            .StrEndsWith -> verdict(self.text_val(vals[0]).ends_with(self.text_val(vals[1]))),
            .StrIndexOf -> Val.I(self.text_val(vals[0]).index_of(self.text_val(vals[1]))),
            .StrSubstring -> self.str_substring_val(vals),
            .StrSplit -> self.fresh_array([Val.S(piece) for piece in pieces_of(self.text_val(vals[0]), self.text_val(vals[1]))]),
            .StrReplace -> Val.S(replaced(self.text_val(vals[0]), self.text_val(vals[1]), self.text_val(vals[2]))),
            .StrCharCode -> self.str_char_code_val(vals),
            .StrTrim -> Val.S(trimmed(self.text_val(vals[0]))),
            .StrConcat -> Val.S(self.text_val(vals[0]) + self.text_val(vals[1])),
            .ProcSpawn -> Val.I(avra_proc_spawn(self.text_val(vals[0]), self.texts_of(vals[1]), self.texts_of(vals[2]), self.text_val(vals[3]), self.whole(vals[4]), self.whole(vals[5]), self.whole(vals[6]))),
            .ProcRun -> Val.I(avra_proc_run(self.text_val(vals[0]), self.texts_of(vals[1]), self.texts_of(vals[2]), self.text_val(vals[3]), self.whole(vals[4]), self.text_val(vals[5]), self.whole(vals[6]), self.whole(vals[7]), self.whole(vals[8]))),
            .ProcPoll -> Val.I(avra_proc_poll(self.whole(vals[0]), self.whole(vals[1]))),
            .ProcWrite -> Val.I(avra_proc_write(self.whole(vals[0]), self.text_val(vals[1]))),
            .ProcStdinClose -> Val.I(avra_proc_stdin_close(self.whole(vals[0]))),
            .ProcTake -> Val.S(avra_proc_take(self.whole(vals[0]), self.whole(vals[1]))),
            .ProcSignal -> Val.I(avra_proc_signal(self.whole(vals[0]), self.whole(vals[1]), self.whole(vals[2]))),
            .ProcStatus -> Val.I(avra_proc_status(self.whole(vals[0]))),
            .ProcPid -> Val.I(avra_proc_pid(self.whole(vals[0]))),
            .ProcClose -> proc_close_val(self.whole(vals[0])),
            .ProcWhich -> Val.S(avra_proc_which(self.text_val(vals[0]), self.text_val(vals[1]))),
            .ErrnoText -> Val.S(avra_errno_text(self.whole(vals[0]))),
            .NowNs -> Val.I(avra_now_ns()),
            .HostEnv -> Val.S(avra_host_env(self.text_val(vals[0]))),
            .Eputs -> eputs_val(self.text_val(vals[0])),
            .IoKind -> Val.I(avra_io_kind(self.text_val(vals[0]))),
            .IoRead -> Val.I(avra_io_read(self.text_val(vals[0]))),
            .IoWrite -> Val.I(avra_io_write(self.text_val(vals[0]), self.text_val(vals[1]))),
            .IoList -> Val.I(avra_io_list(self.text_val(vals[0]))),
            .IoMkdir -> Val.I(avra_io_mkdir(self.text_val(vals[0]))),
            .IoRemove -> Val.I(avra_io_remove(self.text_val(vals[0]))),
            .IoEnv -> Val.I(avra_io_env(self.text_val(vals[0]))),
            .IoTaken -> Val.S(avra_io_taken()),
            .StrFromCodepoint -> Val.S(avra_str_from_codepoint(self.whole(vals[0]))),
            .Unhosted -> self.defect_val("a runtime callee the interpreter does not host: `${callee}`"),
        }
    }


    /// An extern fn is the host's — the evaluator has no body for it.
    fn unhosted_extern(callee: string) -> Val {
        self.trapped("`${callee}` is extern — the evaluator cannot host it; build natively")
        Val.I(0)
    }


    fn array_new_val() -> Val {
        self.fresh_array([])
    }


    /// A new array in the table, holding these values.
    fn fresh_array(elems: List<Val>) -> Val {
        self.arrays.push(elems)
        Val.A(self.arrays.length - 1)
    }

    /// An int argument's value — a defect answers zero.
    fn whole(v: Val) -> int {
        match v {
            .I(n) -> n,
            _ -> {
                self.defect("a non-int reached a runtime seat")
                0
            }
        }
    }


    fn array_pop_val(vals: List<Val>) -> Val {
        let id? = array_id(vals[0]) else { return self.defect_val("a pop from a non-array") }
        self.popped(id)
    }


    fn popped(id: int) -> Val {
        // LICENSED I34: a BORROW — a read holds the table to the scope's end, so a path write after it would CLONE it (liveness, S3, retires this)
        mut arrays = self.arrays
        mut arr = arrays[id]
        if arr.is_empty() {
            self.trapped("pop on an empty list")
            return Val.I(0)
        }
        let last = arr.pop()
        arrays.set(id, arr)
        last


    }

    fn array_concat_val(vals: List<Val>) -> Val {
        let a: int? = array_id(vals[0])
        let b: int? = array_id(vals[1])
        if a == null || b == null { return self.defect_val("a concat over a non-array") }
        self.fresh_array(self.arrays[a!].concat(self.arrays[b!]))
    }


    /// The slots from lo up to hi, clamped — worded like the runtime's.
    fn array_slice_val(vals: List<Val>) -> Val {
        let id? = array_id(vals[0]) else { return self.defect_val("a slice of a non-array") }
        self.sliced(id, self.whole(vals[1]), self.whole(vals[2]))
    }


    fn sliced(id: int, from: int, to: int) -> Val {
        let xs = self.arrays[id]
        let lo = clamped(from, 0, xs.length)
        let hi = clamped(to, 0, xs.length)
        self.fresh_array(if lo < hi { xs.slice(lo, hi) } else { [] })
    }


    /// The bytes from lo up to hi, clamped — worded like the runtime's.
    fn str_substring_val(vals: List<Val>) -> Val {
        let s = self.text_val(vals[0])
        let n = s.length
        let lo = clamped(self.whole(vals[1]), 0, n)
        let hi = clamped(self.whole(vals[2]), 0, n)
        Val.S(if lo < hi { s.substring(lo, hi) } else { "" })
    }


    /// The byte at `i` as a code; past the text, the runtime's trap.
    fn str_char_code_val(vals: List<Val>) -> Val {
        let s = self.text_val(vals[0])
        let i = self.whole(vals[1])
        let n = s.length
        if i < 0 || i >= n { return self.out_of_bounds(i, n) }
        Val.I(s.char_code(i))
    }


    /// VALUE SEMANTICS, spelled as the spec: the interpreter has no
    /// counts, so opening a place for writing ALWAYS copies the box —
    /// native copies only when shared, and the differential proves
    /// the two agree.
    fn cloned_val(v: Val) -> Val {
        match v {
            .A(id) -> {
                self.arrays.push([x for x in self.arrays[id]])
                Val.A(self.arrays.length - 1)
            }
            .M(id) -> {
                self.maps.push(MapVal { keys: [k for k in self.maps[id].keys], vals: [x for x in self.maps[id].vals] })
                Val.M(self.maps.length - 1)
            }
            .I(_) or .B(_) or .S(_) or .C(_) or .N -> v,
        }
    }


    fn map_new_val() -> Val {
        self.maps.push(MapVal { keys: [], vals: [] })
        Val.M(self.maps.length - 1)
    }


    fn map_slot(id: int, key: string) -> int {
        self.maps[id].keys.index_of(key)
    }

    fn map_len_val(vals: List<Val>) -> Val {
        let id? = map_id(vals[0]) else { return self.defect_val("a length of a non-map") }
        Val.I(self.maps[id].keys.length)
    }


    fn map_has_val(vals: List<Val>) -> Val {
        let id? = map_id(vals[0]) else { return self.defect_val("a lookup in a non-map") }
        Val.B(self.map_slot(id, self.text_val(vals[1])) >= 0)
    }


    fn map_get_val(vals: List<Val>) -> Val {
        let id? = map_id(vals[0]) else { return self.defect_val("a read from a non-map") }
        self.map_read(id, self.text_val(vals[1]))
    }


    fn map_read(id: int, key: string) -> Val {
        let s = self.map_slot(id, key)
        if s < 0 { return Val.N }
        self.maps[id].vals[s]
    }


    fn map_set_val(vals: List<Val>) -> Val {
        let id? = map_id(vals[0]) else { return self.defect_val("a write into a non-map") }
        self.map_write(id, self.text_val(vals[1]), vals[2])
    }


    fn map_write(id: int, key: string, v: Val) -> Val {
        // LICENSED I34: a BORROW — a read holds the table to the scope's end, so a path write after it would CLONE it (liveness, S3, retires this)
        let s = self.map_slot(id, key)
        mut maps = self.maps
        let entry = maps[id]
        let written = if s >= 0 { entry with { vals: copied(entry.vals, [v], s) } }
                      else { entry with { keys: entry.keys.concat([key]), vals: entry.vals.concat([v]) } }
        maps.set(id, written)
        Val.I(0)


    }

    fn cell_unique_val(vals: List<Val>) -> Val {
        // LICENSED I34: a BORROW — a read holds the table to the scope's end, so a path write after it would CLONE it (liveness, S3, retires this)
        match vals[0] {
            .C(id) -> {
                let fresh = self.cloned_val(self.cells[id])
                mut cs = self.cells
                cs.set(id, fresh)
                fresh
            }
            _ -> self.defect_val("a place opened through a non-cell"),
        }


    }

    fn slot_unique_val(vals: List<Val>) -> Val {
        let held = self.array_get_val(vals)
        let fresh = self.cloned_val(held)
        let _ = self.slot_set_val([vals[0], vals[1], fresh])
        fresh
    }


    fn slot_set_val(vals: List<Val>) -> Val {
        let id? = array_id(vals[0]) else { return self.defect_val("a non-array slot write") }
        self.slot_written(id, self.whole(vals[1]), vals[2])
    }


    fn slot_written(id: int, at: int, v: Val) -> Val {
        // LICENSED I34: a BORROW — a read holds the table to the scope's end, so a path write after it would CLONE it (liveness, S3, retires this)
        mut arrays = self.arrays
        mut arr = arrays[id]
        if at < 0 || at >= arr.length { return self.out_of_bounds(at, arr.length) }
        arr.set(at, v)
        arrays.set(id, arr)
        Val.I(0)
    }

    fn out_of_bounds(at: int, len: int) -> Val {
        self.trapped("index ${at} is out of bounds (length ${len})")
        Val.I(0)
    }


    fn array_push_val(vals: List<Val>) -> Val {
        let id? = array_id(vals[0]) else { return self.defect_val("a push into a non-array") }
        self.pushed(id, vals[1])
    }


    fn pushed(id: int, v: Val) -> Val {
        // LICENSED I34: a BORROW — a read holds the table to the scope's end, so a path write after it would CLONE it (liveness, S3, retires this)
        mut arrays = self.arrays
        mut arr = arrays[id]
        arr.push(v)
        arrays.set(id, arr)
        Val.I(0)
    }

    fn absent_refused() -> Val {
        self.trapped("unwrapped an absent value")
        Val.I(0)
    }


    /// `v!` on a NICHE nullable — identity through the presence guard.
    /// The once cache asked: this run's answer for the symbol, or
    /// the null pointer when the fn has not run yet.
    fn once_get_val(vals: List<Val>) -> Val {
        let held: Val? = self.onces.get(self.text_val(vals[0]))
        held ?? Val.N
    }

    /// The once cache kept: the first answer wins for the run.
    fn once_set_val(vals: List<Val>) -> Val {
        self.onces.set(self.text_val(vals[0]), vals[1])
        Val.I(0)
    }

    fn insist_val(vals: List<Val>) -> Val {
        if vals[0] is .N { return self.absent_refused() }
        vals[0]
    }


    /// `v!` on a PAIR nullable — the flag guards, the value passes.
    fn insist_scalar_val(vals: List<Val>) -> Val {
        let present: bool = match vals[0] {
            .B(t) -> t,
            _ -> false,
        }
        if !present { return self.absent_refused() }
        vals[1]
    }


    fn array_get_val(vals: List<Val>) -> Val {
        let id? = array_id(vals[0]) else { return self.defect_val("a read from a non-array") }
        self.slot_read_val(id, self.whole(vals[1]))
    }


    fn slot_read_val(id: int, at: int) -> Val {
        let arr = self.arrays[id]
        if at < 0 || at >= arr.length { return self.out_of_bounds(at, arr.length) }
        arr[at]
    }


    fn array_len_val(vals: List<Val>) -> Val {
        let id? = array_id(vals[0]) else { return self.defect_val("a length of a non-array") }
        Val.I(self.arrays[id].length)
    }


    fn str_join_val(vals: List<Val>) -> Val {
        let id? = array_id(vals[0]) else { return self.defect_val("a join over a non-array") }
        Val.S(joined([self.text_val(e) for e in self.arrays[id]], self.text_val(vals[1])))
    }


    /// One printed line lands in the machine's output.
    fn puts_val(vals: List<Val>) -> Val {
        let line = self.text_val(vals[0])
        self.out.push(line)
        Val.I(0)
    }

    /// A word list the host can hold, from an array of texts.
    fn texts_of(v: Val) -> List<string> {
        match v {
            .A(id) -> [self.text_val(e) for e in self.arrays[id]],
            _ -> {
                self.defect("a non-array reached the host's word list")
                []
            },
        }
    }


    fn streq_val(vals: List<Val>) -> Val {
        verdict(self.text_val(vals[0]) == self.text_val(vals[1]))
    }
}
// ── The host seam the evaluator reaches through ─────────────────
// The process substrate, the io rows and the clock are the runtime's
// own C; the evaluator calls the same functions the native program
// does, so there is one implementation, not two that agree.
extern fn avra_proc_spawn(file: string, argv: List<string>, envp: List<string>, cwd: string, flags: int, max_bytes: int, from_h: int) -> int
extern fn avra_proc_run(file: string, argv: List<string>, envp: List<string>, cwd: string, flags: int, stdin_text: string, timeout_ms: int, grace_ms: int, max_bytes: int) -> int
extern fn avra_proc_poll(h: int, timeout_ms: int) -> int
extern fn avra_proc_write(h: int, text: string) -> int
extern fn avra_proc_stdin_close(h: int) -> int
extern fn avra_proc_take(h: int, stream: int) -> string
extern fn avra_proc_signal(h: int, sig: int, to_group: int) -> int
extern fn avra_proc_status(h: int) -> int
extern fn avra_proc_pid(h: int) -> int
extern fn avra_proc_close(h: int)
extern fn avra_proc_which(file: string, path: string) -> string
extern fn avra_errno_text(err: int) -> string
extern fn avra_now_ns() -> int
extern fn avra_eputs(line: string)
extern fn avra_io_kind(path: string) -> int
extern fn avra_io_read(path: string) -> int
extern fn avra_io_write(path: string, text: string) -> int
extern fn avra_io_list(path: string) -> int
extern fn avra_io_mkdir(path: string) -> int
extern fn avra_io_remove(path: string) -> int
extern fn avra_io_env(name: string) -> int
extern fn avra_io_taken() -> string
extern fn avra_str_from_codepoint(code: int) -> string
// `avra_host_env` is the module's already — workspace.av declares it.

/// A void host call answers the placeholder every void call does.
fn proc_close_val(h: int) -> Val {
    avra_proc_close(h)
    Val.I(0)
}

/// A line to the evaluator's own stderr — never the program's answer.
fn eputs_val(line: string) -> Val {
    avra_eputs(line)
    Val.I(0)
}

// ── Registers (the innermost frame, rewritten in place) ─────────

// ── Operations ──────────────────────────────────────────────────

// ── Control-flow bracket scans ──────────────────────────────────

/// Where arm `k` of the region opened at `from` begins: just past
/// the k-th arm separator at depth 0.
fn arm_start(b: Body, from: int, k: int) -> int {
    mut at = from
    for j in 0..k { at = ahead(b, at, opens_region, closes_region, (i: Ins) -> i is .ArmEnd) }
    at + 1
}

/// Forward from `from`+1: the pc of the first `target` at depth 0,
/// with `opens`/`closes` tracking nesting. Target wins over close
/// at depth 0, so a closer can BE the target.
fn ahead(b: Body, from: int, opens: fn(Ins) -> bool, closes: fn(Ins) -> bool, target: fn(Ins) -> bool) -> int {
    mut depth = 0
    mut j = from + 1
    while j < b.ins.length {
        let i = b.ins[j]
        if depth == 0 && target(i) { return j }
        if opens(i) { depth = depth + 1 }
        if closes(i) { depth = depth - 1 }
        j = j + 1
    }
    b.ins.length
}

/// From an IfStart: the pc just past its matching ArmEnd.
fn past_else(b: Body, from: int) -> int {
    ahead(b, from, opens_region, closes_region, (i: Ins) -> i is .ArmEnd) + 1
}

/// From a false LoopCond: the pc just past the matching LoopEnd.
fn past_loop(b: Body, from: int) -> int {
    ahead(b, from, (i: Ins) -> i is .LoopStart, (i: Ins) -> i is .LoopEnd, (i: Ins) -> i is .LoopEnd) + 1
}

/// From a LoopEnd: its matching LoopStart — the back edge. The
/// one backward scan, shaped exactly as `ahead`: target first at
/// depth 0, then the open/close bookkeeping.
fn loop_header(b: Body, from: int) -> int {
    mut depth = 0
    mut j = from - 1
    while j >= 0 {
        let i = b.ins[j]
        if depth == 0 && i is .LoopStart { return j }
        if i is .LoopEnd { depth = depth + 1 }
        if i is .LoopStart { depth = depth - 1 }
        j = j - 1
    }
    0
}

// ── Calls ───────────────────────────────────────────────────────

// ── Mut cells ───────────────────────────────────────────────────

// ── Text projections ────────────────────────────────────────────

// ── The runtime surface, hosted — runtime_api.av's fifth consumer ─

fn array_id(v: Val) -> int? {
    match v {
        .A(id) -> id,
        _ -> null,
    }
}

/// A bool answer as the runtime words it — a word, which the
/// register's type reads back as a bool.
fn verdict(b: bool) -> Val {
    Val.I(if b { 1 } else { 0 })
}

/// `n` held within [lo, hi].
fn clamped(n: int, lo: int, hi: int) -> int {
    if n < lo { return lo }
    if n > hi { return hi }
    n
}

/// The pieces between separators, cut as the runtime cuts them: a
/// leading empty piece stays, one trailing is dropped, empty text
/// splits to nothing, and an empty separator keeps the text whole.
fn pieces_of(s: string, sep: string) -> List<string> {
    if s.length == 0 { return [] }
    if sep.length == 0 { return [s] }
    mut out: List<string> = []
    mut rest = s
    mut at = rest.index_of(sep)
    while at >= 0 {
        out.push(rest.substring(0, at))
        rest = rest.substring(at + sep.length, rest.length)
        at = rest.index_of(sep)
    }
    if rest.length > 0 { out.push(rest) }
    out
}

/// Every occurrence of `from` as `to`, cut as the runtime cuts:
/// an empty `from` changes nothing.
fn replaced(s: string, from: string, to: string) -> string {
    if from.length == 0 { return s }
    pieces_of_all(s, from).join(to)
}

/// The pieces between EVERY separator — a trailing empty piece
/// kept, unlike `split` — so a join with `to` is the replacement.
fn pieces_of_all(s: string, sep: string) -> List<string> {
    mut out: List<string> = []
    mut rest = s
    mut at = rest.index_of(sep)
    while at >= 0 {
        out.push(rest.substring(0, at))
        rest = rest.substring(at + sep.length, rest.length)
        at = rest.index_of(sep)
    }
    out.push(rest)
    out
}

/// The text without its surrounding blanks — space, tab, newline
/// and return, the runtime's set.
fn trimmed(s: string) -> string {
    let n = s.length
    mut lo = 0
    while lo < n && is_blank(s.char_code(lo)) { lo = lo + 1 }
    mut hi = n
    while hi > lo && is_blank(s.char_code(hi - 1)) { hi = hi - 1 }
    s.substring(lo, hi)
}

fn is_blank(c: int) -> bool {
    c == 32 || c == 9 || c == 10 || c == 13
}

/// A map's keys and values in written order — the spec's map,
/// found by a scan.
type MapVal = { keys: List<string>, vals: List<Val> }

fn map_id(v: Val) -> int? {
    match v {
        .M(id) -> id,
        _ -> null,
    }
}
