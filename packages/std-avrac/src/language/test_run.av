//! THE TEST BINARY'S ENTRY, built in IR. No source declares it: the
//! cases are declarations the program already holds, and this entry
//! calls each one by its symbol, prints its verdict and its tally,
//! and leaves a VERDICT in the exit status — 0 all passed, 1 some
//! failed. Running the cases NATIVELY is what keeps a suite of a
//! thousand cases in seconds instead of an hour.
use core.{Ins, Reg, TypeId, Type, TypeRegistry, BinOp, Level, RtKind, RtSig, extern_row}

/// One case as the entry needs it: the symbol that runs it and the
/// line its verdict prints.
export type CaseCall = { symbol: string, label: string }

/// The host fns the test binary declares: the status it leaves by,
/// and the marker naming the case in flight — a suite runs in ONE
/// process, so a trap kills every case after it, and the marker is
/// how the wreck says which case it was running.
export fn runner_rows() -> List<RtSig> {
    [
        extern_row("avra_process_exit", RtKind.Void, [RtKind.I64]),
        extern_row("avra_case_begin", RtKind.Void, [RtKind.Ptr]),
    ]
}

/// The entry: a cell counts failures, each case decides which line
/// prints, and the verdict leaves through the exit status.
export fn cases_entry(types: TypeRegistry, cases: List<CaseCall>) -> Body {
    let e = new_entry(types)
    let tally = e.mint(types.intern(Type.Int))
    e.give(Ins.Alloca(tally))
    e.give(Ins.Store(tally, e.constant(0)))
    for c in cases { one_case(e, c, tally) }
    let failed = e.mint(types.intern(Type.Int))
    e.give(Ins.Load(failed, tally))
    e.tally(cases.length, failed)
    // THE STATUS IS A VERDICT, never a count: a status is eight bits,
    // and 256 failures would read as success.
    e.give(Ins.IfStart(e.zero_test(failed)))
    e.give(Ins.CallRtVoid("avra_process_exit", [e.constant(0)]))
    e.give(Ins.ArmEnd(e.constant(0)))
    e.give(Ins.CallRtVoid("avra_process_exit", [e.constant(1)]))
    let gives = e.constant(0)
    let merged = e.mint(types.intern(Type.Int))
    e.give(Ins.RegionEnd(merged, gives))
    e.give(Ins.ScopeExit(null))
    e.give(Ins.Ret(0))
    e.built()
}

/// The suite's own line: `N/M tests passed`, printed by the binary
/// that ran them — the runner reads a VERDICT from the exit code,
/// never a number it could truncate.
fn tally_line(e: EntryBuild, total: int, failed: Reg) {
    // THE MINT LAW: every operand minted before the answer that reads it
    let count = e.constant(total)
    let passed = e.mint(e.types.intern(Type.Int))
    e.give(Ins.Bin(passed, BinOp.Sub, count, failed))
    let text = e.mint(e.types.intern(Type.Str))
    e.give(Ins.CallRt(text, "avra_int_text", [passed]))
    let tail = e.text("/${total} tests passed")
    let line = e.mint(e.types.intern(Type.Str))
    e.give(Ins.CallRt(line, "avra_str_concat", [text, tail]))
    e.give(Ins.CallRtVoid("avra_puts", [line]))
}

/// One case: called, judged, and counted when it fails.
fn one_case(e: EntryBuild, c: CaseCall, tally: Reg) {
    e.give(Ins.CallRtVoid("avra_case_begin", [e.text(c.label)]))
    let ok = e.mint(e.types.intern(Type.Bool))
    e.give(Ins.Call(ok, c.symbol, []))
    e.give(Ins.IfStart(ok))
    e.give(Ins.ArmEnd(e.constant(0)))
    // only a FAILURE speaks — a green case is the tally's business
    e.say("    ✗ ${c.label}")
    let held = e.mint(e.types.intern(Type.Int))
    e.give(Ins.Load(held, tally))
    // THE MINT LAW: operands first, the answer last
    let one = e.constant(1)
    let more = e.mint(e.types.intern(Type.Int))
    e.give(Ins.Bin(more, BinOp.Add, held, one))
    e.give(Ins.Store(tally, more))
    let gives = e.constant(0)
    let merged = e.mint(e.types.intern(Type.Int))
    e.give(Ins.RegionEnd(merged, gives))
}

/// A body under construction: registers minted in instruction order,
/// which is the law every consumer reads back.
type EntryBuild = { types: TypeRegistry, ins: List<Ins>, tys: List<TypeId> }

fn new_entry(types: TypeRegistry) -> EntryBuild {
    let empty_ins: List<Ins> = []
    let empty_tys: List<TypeId> = []
    let e = EntryBuild { types: types, ins: empty_ins, tys: empty_tys }
    e.give(Ins.ScopeEnter(Level.Application))
    e
}

impl EntryBuild {
    fn give(i: Ins) { self.ins.push(i) }

    fn mint(ty: TypeId) -> Reg {
        self.tys.push(ty)
        Reg { index: self.tys.length - 1 }
    }

    /// An int constant in a fresh register.
    fn constant(v: int) -> Reg {
        let r = self.mint(self.types.intern(Type.Int))
        self.give(Ins.ConstInt(r, v))
        r
    }

    /// A string literal in a fresh register.
    fn text(s: string) -> Reg {
        let r = self.mint(self.types.intern(Type.Str))
        self.give(Ins.ConstStr(r, s))
        r
    }

    /// One line to standard output.
    fn say(s: string) {
        self.give(Ins.CallRtVoid("avra_puts", [self.text(s)]))
    }

    /// The suite's closing line.
    fn tally(total: int, failed: Reg) { tally_line(self, total, failed) }

    /// Whether the tally is zero — the suite's verdict.
    fn zero_test(failed: Reg) -> Reg {
        let zero = self.constant(0)
        let same = self.mint(self.types.intern(Type.Bool))
        self.give(Ins.Bin(same, BinOp.Eq, failed, zero))
        same
    }

    fn built() -> Body {
        Body { name: "main", params: [], ret: self.types.intern(Type.Int),
               gives: null, ins: self.ins, reg_types: self.tys }
    }
}
