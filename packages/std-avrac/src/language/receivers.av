//! THE SEATS PASS — which seats a fn WRITES THROUGH: a method's
//! receiver (seat 0), and every `mut` parameter. A seat is written
//! when the body assigns to a place rooted in it, calls a mutating
//! vocabulary method on one, hands one to a written seat of another
//! fn, or calls a writing method on one — the last two make this a
//! WHOLE-PROGRAM FIXPOINT over per-fn summaries. A summary reads the
//! RESOLVED body and the DECLARATIONS alone: every seat-rooted place
//! has a declared type along its whole path, so no body is typed to
//! learn it. Asked through the declaration table's hook, remembered
//! by the kernel (ROADMAP: the inout receiver).
use core.{DeclId, ExprId, StmtId, TypeId, Type, NodeStore, Binding, MethodParts, PlaceStep, fp, touch, filled, flatten}
use features.{NameFacts, Decls, Decl, StructSig, fields_of_type, bound_decl_of, row_writes, trait_named, trait_member, self_type_of, fn_sig_of, FnSig, nothing, property_row}

/// One fn's own evidence: which of its seats the body writes
/// directly, and the flows from its seats into other fns' seats —
/// the fixpoint's edges.
type Summary = { own: List<bool>, edges: List<Flow> }

/// A place rooted in seat `from` fills seat `to` of `callee`.
type Flow = { from: int, callee: DeclId, to: int }

/// The pass: every fn's written seats, settled once per program
/// state. Declared bits (`mut fn`, a `mut` seat, a trait's word)
/// are recorded at declare; this pass adds the INFERRED ones.
export fn receivers(ws: Workspace) -> int {
    let k = key(Family.Receivers, 0)
    if !(ws.db.ask(k) is .Compute) { return 0 }
    ws.db.begin(k)
    let fns = [x.id for x in ws.decls.decls if seated(x)]
    for d in fns { touch(sig(ws, d)) }
    ws.decls.clear_written()
    let sums = [summary(ws, d) for d in fns]
    settle_writers(ws.decls, fns, sums)
    ws.db.settle(k, fp(17, flatten([written_bits(ws.decls, d) for d in fns])))
    fns.length
}

/// The declarations with seats to write through.
fn seated(x: Decl) -> bool {
    x.kind is .Fn || x.kind is .Method
}

/// A fn's written seats for the fingerprint — one digit per seat,
/// in seat order, so no two states share a word.
fn written_bits(decls: Decls, d: DeclId) -> List<int> {
    mut bits: List<int> = []
    mut i = 0
    let n = decls.seat_count(d)
    // LICENSED I3: a comprehension over a RANGE is our own sugar backlog
    while i < n {
        bits.push(if decls.seat_written_so_far(d, i) { 1 } else { 0 })
        i = i + 1
    }
    bits
}

/// Kleene iteration: a seat is written when its fn writes it, or
/// hands it to a seat another fn writes — until no bit moves.
/// Deterministic and order-free; cycles resolve to the least
/// answer, which is the true one.
fn settle_writers(decls: Decls, fns: List<DeclId>, sums: List<Summary>) {
    mut changed = true
    while changed {
        changed = false
        for j, d in fns {
            if settle_one(decls, d, sums[j]) { changed = true }
        }
    }
}

/// One fn's seats settled against its summary — true when a bit
/// moved.
fn settle_one(decls: Decls, d: DeclId, s: Summary) -> bool {
    mut moved = false
    for i, own in s.own {
        if !decls.seat_written_so_far(d, i) && (own || flows_write(decls, s, i)) {
            decls.record_seat_written(d, i)
            moved = true
        }
    }
    moved
}

fn flows_write(decls: Decls, s: Summary, i: int) -> bool {
    s.edges.any((f: Flow) -> f.from == i && decls.seat_writes_so_far(f.callee, f.to))
}

/// A fn's own evidence, read from its resolved body and the
/// declarations its seat-rooted places name.
fn summary(ws: Workspace, d: DeclId) -> Summary {
    let x = ws.decls.decl(d)
    let n = ws.decls.seat_count(d)
    if x.root == null { return Summary { own: filled(n, false), edges: [] } }
    let receiver: TypeId? = receiver_type(ws, x)
    let seats: List<TypeId> = fn_sig_of(ws.decls.sig(d))?.params ?? []
    mut cx = Survey { ws: ws, decls: ws.decls, store: ws.decls.store(d), names: resolved(ws, x.file), receiver: receiver, seats: seats, lo: x.lo, hi: x.hi, own: filled(n, false), edges: [] }
    assigns(cx)
    mut i = x.lo
    // LICENSED I3: a comprehension over a RANGE is our own sugar backlog
    while i < x.hi {
        site_evidence(cx, ExprId { index: i })
        i = i + 1
    }
    Summary { own: cx.own, edges: cx.edges }
}

/// What one fn's summary reads and gathers: the body's file, its
/// seats' types (the receiver's when it has one), its expression
/// range — and the evidence as it accrues.
type Survey = { ws: Workspace, decls: Decls, store: NodeStore, names: NameFacts, receiver: TypeId?, seats: List<TypeId>, lo: int, hi: int, own: List<bool>, edges: List<Flow> }

/// Every assignment in the range rooted in a seat writes it.
fn assigns(mut cx: Survey) {
    mut i = 0
    let n = cx.store.stmts.count()
    while i < n {
        let t: ExprId? = cx.store.assign_target(StmtId { index: i })
        if t != null && in_range(cx, t!) { mark(cx, seat_of(cx, t!)) }
        i = i + 1
    }
}

fn in_range(cx: Survey, e: ExprId) -> bool {
    e.index >= cx.lo && e.index < cx.hi
}

/// The seat a place is rooted in — asked of the BINDING: the
/// receiver is seat 0, a parameter its own seat; null for a value
/// and for every other binding.
fn seat_of(cx: Survey, e: ExprId) -> int? {
    let root: ExprId? = cx.store.place_root(e)
    if root == null { return null }
    let b: Binding? = cx.names.binding(root!)
    if b == null { return null }
    match b! {
        .Receiver -> 0,
        .Param(i) -> i,
        .Def(_) or .Pattern(_, _) or .LambdaParam(_, _) or .Capture(_, _) or .Index(_) or .Decl(_) -> null,
    }
}

fn mark(mut cx: Survey, seat: int?) {
    if seat != null && seat! < cx.own.length { cx.own.set(seat!, true) }
}

fn flow(mut cx: Survey, seat: int?, callee: DeclId, to: int) {
    if seat != null { cx.edges.push(Flow { from: seat!, callee: callee, to: to }) }
}

/// One expression's evidence: a method call on a seat-rooted place
/// (a mutating row, a declared method's edge, a contract's word),
/// and any call handing a seat-rooted place to a callee's seat.
fn site_evidence(mut cx: Survey, e: ExprId) {
    let mp: MethodParts? = cx.store.method_parts(e)
    if mp != null { return method_evidence(cx, mp!) }
    let callee: DeclId? = bound_decl_of(cx.names, e)
    if callee != null { feed(cx, callee!, call_args(cx, e), 0) }
}

/// A named call's arguments; empty for every other node.
fn call_args(cx: Survey, e: ExprId) -> List<ExprId> {
    // LICENSED I22: one arm answers — a projection over the core node
    match cx.store.expr(e) {
        .Call(_, _, args) -> args,
        _ -> [],
    }
}

fn method_evidence(mut cx: Survey, mp: MethodParts) {
    let seat: int? = seat_of(cx, mp.subject)
    let ty: TypeId? = place_type(cx, mp.subject)
    // A SUBJECT THIS PASS CANNOT TYPE: every seat-rooted argument is
    // taken as written — the conservative side, so the never-written
    // warning never contradicts the seat law at a call. A subject it
    // CAN type names its callee, or has none with a seat to write
    // (a fn-typed field's seats are never `mut`).
    if ty == null {
        for a in mp.args { if writable(cx, a) { mark(cx, seat_of(cx, a)) } }
        return
    }
    match callee_of(cx, ty!, mp.name) {
        .Row(writes) -> if writes { mark(cx, seat) } else { nothing() },
        .Method(d) -> {
            flow(cx, seat, d, 0)
            feed(cx, d, mp.args, 1)
        }
        .Contract(d) -> {
            if cx.decls.declares_writing(d) { mark(cx, seat) }
            feed(cx, d, mp.args, 0)
        }
        .None -> nothing(),
    }
}

/// Whether a handed place could be written through by a callee: a
/// scalar is copied at the seat, so only a managed value — or one
/// this pass cannot type — can carry a write back.
fn writable(cx: Survey, a: ExprId) -> bool {
    if measured(cx, a) { return false }
    let ty: TypeId? = place_type(cx, a)
    if ty == null { return true }
    match cx.decls.types.shape_of(ty!) {
        .Int or .Bool or .Str or .Null or .Void or .Ptr -> false,
        _ -> true,
    }
}

/// A MEASURED property (`xs.length`) — a scalar the vocabulary
/// answers, never a slot: copied at any seat.
fn measured(cx: Survey, a: ExprId) -> bool {
    let step: PlaceStep? = cx.store.place_step(a)
    if step == null { return false }
    match step! {
        .Field(subject, name) -> {
            let holder: TypeId? = place_type(cx, subject)
            holder != null && property_row(cx.ws.lang.rows.properties, name, cx.decls.types.shape_of(holder!)) != null
        }
        .Root(_) or .At(_, _) -> false,
    }
}

/// Every argument rooted in a seat flows into the callee's seat it
/// fills, the callee's seats numbered from `base` (1 past a
/// method's own receiver seat). A CONTRACT's seat has no body to
/// infer from: its declared `mut` is the write, by permission.
fn feed(mut cx: Survey, callee: DeclId, args: List<ExprId>, base: int) {
    let contract = under_trait(cx, callee)
    for j, a in args {
        if cx.decls.mut_seat(callee, base + j) {
            if contract { mark(cx, seat_of(cx, a)) } else { flow(cx, seat_of(cx, a), callee, base + j) }
        }
    }
}

/// Whether a declaration is a trait's own member — a sig, not a body.
fn under_trait(cx: Survey, d: DeclId) -> bool {
    let parent: DeclId? = cx.decls.decl(d).parent
    parent != null && cx.decls.is_trait(parent!)
}

/// What a name on a shape calls: the vocabulary's row, a declared
/// method, a contract's member — or nothing this pass can name.
enum Callee {
    Row(writes: bool)
    Method(d: DeclId)
    Contract(d: DeclId)
    None
}

fn callee_of(cx: Survey, ty: TypeId, name: string) -> Callee {
    let sh: Type = cx.decls.types.shape_of(ty)
    match sh {
        .List(_) or .Map(_, _) or .Str -> Callee.Row(row_writes(cx.ws.lang.rows.methods, name, sh)),
        .Struct(d, _) -> declared_method(cx, d, name),
        .Enum(d, _) -> declared_method(cx, d, name),
        .App(d, _, _) -> declared_method(cx, d, name),
        .Var(d, j, _) -> bounded_member(cx, d, j, name),
        .Dyn(d, _) -> contract_member(cx, d, name),
        .Ptr or .Int or .Bool or .Res(_, _) or .TypeName(_, _) or .Fn(_, _) or .Opt(_) or .Null or
        .EmptyList or .Error or .Void or .EmptyMap -> Callee.None,
    }
}

fn declared_method(cx: Survey, d: DeclId, name: string) -> Callee {
    let m: DeclId? = cx.decls.method(d, name)
    if m == null { return Callee.None }
    Callee.Method(m!)
}

/// A method on a BOUNDED type parameter: the bound's trait's member.
fn bounded_member(cx: Survey, d: DeclId, j: int, name: string) -> Callee {
    let tb = cx.decls.tbounds(d)
    if j >= tb.length || tb[j].ty == null { return Callee.None }
    let tdecl: DeclId? = trait_named(cx.decls, cx.names, tb[j].ty!.name)
    if tdecl == null { return Callee.None }
    contract_member(cx, tdecl!, name)
}

fn contract_member(cx: Survey, tdecl: DeclId, name: string) -> Callee {
    let member: DeclId? = trait_member(cx.decls, tdecl, name)
    if member == null { return Callee.None }
    Callee.Contract(member!)
}

/// The declared type along a seat-rooted place: the seat's type at
/// the root, a field's declared type per field step, the element
/// per index step — null when a step names nothing declared.
fn place_type(cx: Survey, e: ExprId) -> TypeId? {
    let step: PlaceStep? = cx.store.place_step(e)
    if step == null { return null }
    match step! {
        .Root(_) -> root_type(cx, e),
        .Field(subject, name) -> field_type(cx, place_type(cx, subject), name),
        .At(subject, _) -> element_type(cx, place_type(cx, subject)),
    }
}

/// A root's declared type: the receiver's for `self`, the seat's
/// for a parameter, a local's from what it was bound to — when that
/// is a named call's answer, a construction, or a place — nothing
/// for any other binding.
fn root_type(cx: Survey, e: ExprId) -> TypeId? {
    let b: Binding? = cx.names.binding(e)
    if b == null { return null }
    match b! {
        .Receiver -> cx.receiver,
        .Param(i) -> if i < cx.seats.length { cx.seats[i] } else { null },
        .Def(s) -> bound_type(cx, s),
        .Pattern(_, _) or .LambdaParam(_, _) or .Capture(_, _) or .Index(_) or .Decl(_) -> null,
    }
}

/// What a `let`/`mut` holds, by its value's declared answer.
fn bound_type(cx: Survey, s: StmtId) -> TypeId? {
    let v: ExprId? = cx.store.stmt_value(s)
    if v == null { return null }
    let value = v!
    let placed: TypeId? = place_type(cx, value)
    if placed != null { return placed }
    let callee: DeclId? = bound_decl_of(cx.names, value)
    if callee != null { return fn_sig_of(cx.decls.sig(callee!))?.ret }
    let mp: MethodParts? = cx.store.method_parts(value)
    if mp == null { return constructed_type(cx, value) }
    let m = mp!
    let subject: TypeId? = place_type(cx, m.subject)
    if subject == null { return null }
    match callee_of(cx, subject!, m.name) {
        .Method(d) -> fn_sig_of(cx.decls.sig(d))?.ret,
        .Contract(d) -> fn_sig_of(cx.decls.sig(d))?.ret,
        .Row(_) or .None -> null,
    }
}

/// A construction's type — the record it names, in the file's
/// namespace.
fn constructed_type(cx: Survey, v: ExprId) -> TypeId? {
    let name: string? = cx.store.struct_lit_name(v)
    if name == null { return null }
    let d: DeclId? = cx.names.names.types.get(name!)
    if d == null { return null }
    self_type_of(cx.decls, d!)
}

fn field_type(cx: Survey, holder: TypeId?, name: string) -> TypeId? {
    if holder == null { return null }
    let sig: StructSig? = fields_of_type(cx.decls, holder!)
    if sig == null { return null }
    let slot: int? = sig!.slot_of(name)
    if slot == null { return null }
    sig!.types[slot!]
}

fn element_type(cx: Survey, holder: TypeId?) -> TypeId? {
    if holder == null { return null }
    match cx.decls.types.shape_of(holder!) {
        .List(elem) -> elem,
        _ -> null,
    }
}

/// A method's receiver type: its impl's target's instance type —
/// null for a free fn, a trait's sig, and a method whose impl was
/// refused.
fn receiver_type(ws: Workspace, x: Decl) -> TypeId? {
    if x.parent == null { return null }
    let target: DeclId? = ws.decls.target_of(x.parent!)
    if target == null { return null }
    self_type_of(ws.decls, target!)
}
