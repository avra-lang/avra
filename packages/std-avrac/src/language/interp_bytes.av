//! The byte rows, hosted: the evaluator's twin of the runtime's
//! Bytes section over integer octets, refusal wording included.
use core.{joined, flatten}

impl Machine {
    fn octets(v: Val) -> List<int> {
        match v {
            .Y(data) -> data,
            _ -> {
                self.defect("a non-Bytes value reached a byte operation")
                []
            },
        }
    }

    fn bytes_at_val(vals: List<Val>) -> Val {
        let data = self.octets(vals[0])
        let at = self.whole(vals[1])
        if at < 0 || at >= data.length { return self.out_of_bounds(at, data.length) }
        Val.I(data[at])
    }

    fn bytes_slice_val(vals: List<Val>) -> Val {
        let data = self.octets(vals[0])
        let lo = self.whole(vals[1])
        let hi = self.whole(vals[2])
        if lo < 0 || hi < lo || hi > data.length { return self.slice_out_of_bounds(lo, hi, data.length, Val.Y([])) }
        Val.Y(data.slice(lo, hi))
    }

    /// The runtime's `trap_slice`, worded the same; `answer` stands in
    /// for the value the trapped row would have produced.
    fn slice_out_of_bounds(lo: int, hi: int, len: int, answer: Val) -> Val {
        self.trapped("slice ${lo}..${hi} is out of bounds (length ${len})")
        answer
    }

    fn bytes_index_of_val(vals: List<Val>) -> Val {
        let data = self.octets(vals[0])
        let from = self.whole(vals[2])
        if from < 0 || from > data.length { return self.out_of_bounds(from, data.length) }
        Val.I(index_of_octets(data, self.octets(vals[1]), from))
    }

    fn bytes_run_val(vals: List<Val>) -> Val {
        let data = self.octets(vals[0])
        let from = self.whole(vals[1])
        let admits = self.octets(vals[2])
        if from < 0 || from > data.length { return self.out_of_bounds(from, data.length) }
        if admits.length != 256 {
            self.trapped("a class table holds 256 bytes (length ${admits.length})")
            return Val.I(0)
        }
        Val.I([i for i in from..data.length].find((i) -> admits[data[i]] == 0) ?? data.length)
    }

    fn bytes_eq_at_val(vals: List<Val>, folded: bool) -> Val {
        let data = self.octets(vals[0])
        let lo = self.whole(vals[1])
        let hi = self.whole(vals[2])
        if lo < 0 || hi < lo || hi > data.length { return self.slice_out_of_bounds(lo, hi, data.length, Val.I(0)) }
        let needle = self.octets(vals[3])
        verdict(hi - lo == needle.length && [same_byte(data[lo + k], needle[k], folded) for k in 0..needle.length].all(it))
    }

    fn bytes_gathered_val(v: Val) -> Val {
        let id? = array_id(v) else { return self.defect_val("a non-list reached a gather") }
        Val.Y(flatten([self.octets(x) for x in self.arrays[id]]))
    }

    fn bytes_of_list_val(v: Val) -> Val {
        let id? = array_id(v) else { return self.defect_val("a non-list reached byte construction") }
        let data = [self.whole(x) for x in self.arrays[id]]
        if data.any(it < 0 || it > 255) { return Val.N }
        Val.Y(data)
    }
}

fn same_byte(a: int, b: int, folded: bool) -> bool {
    if folded { ascii_lower(a) == ascii_lower(b) } else { a == b }
}

fn ascii_lower(c: int) -> int {
    if c >= 65 && c <= 90 { c + 32 } else { c }
}

fn same_octets(a: List<int>, b: List<int>) -> bool {
    a.length == b.length && [a[i] == b[i] for i in 0..a.length].all(it)
}

/// A native box's octets — a row the host answers in kind.
fn octets_of_box(b: Bytes) -> List<int> {
    [b.at(i) for i in 0..b.length]
}

/// A text's bytes — `char_code` reads one byte.
fn octets_of(text: string) -> List<int> {
    [text.char_code(i) for i in 0..text.length]
}

/// Where `needle` first begins at or after `from`, or -1.
fn index_of_octets(data: List<int>, needle: List<int>, from: int) -> int {
    let last = data.length - needle.length + 1
    [i for i in from..last].find((i) -> begins_at(data, needle, i)) ?? -1
}

fn begins_at(data: List<int>, needle: List<int>, at: int) -> bool {
    [data[at + k] == needle[k] for k in 0..needle.length].all(it)
}

/// Text from octets, or null when they are not UTF-8.
fn utf8_text(xs: List<int>) -> string? {
    if utf8_bad_at(xs) >= 0 { return null }
    joined([avra_str_from_codepoint(cp) for cp in codepoints(xs)], "")
}

/// The same as the `StrOfBytes` row answers it: absence is the null
/// pointer.
fn text_of_octets(xs: List<int>) -> Val {
    let s? = utf8_text(xs) else { return Val.N }
    Val.S(s)
}

/// The first offset that is not UTF-8, or -1: the runtime validator's
/// twin, row for row. The lead byte's range decides how many
/// continuations follow and the range the first must fall in.
fn utf8_bad_at(xs: List<int>) -> int {
    mut i = 0
    while i < xs.length {
        let need = lead_need(xs[i])
        if need < 0 || i + need >= xs.length || !continues(xs, i, need) { return i }
        i = i + need + 1
    }
    -1
}

/// How many continuation bytes follow a lead, or -1 for a byte that
/// leads nothing.
fn lead_need(c: int) -> int {
    when {
        c < 128 -> 0
        c >= 194 && c <= 223 -> 1
        c >= 224 && c <= 239 -> 2
        c >= 240 && c <= 244 -> 3
        _ -> -1
    }
}

/// The first continuation's range refuses overlongs and surrogates;
/// every later one is 128..191.
fn continues(xs: List<int>, i: int, need: int) -> bool {
    if need == 0 { return true }
    let first = xs[i + 1]
    first >= first_lo(xs[i]) && first <= first_hi(xs[i]) &&
        [xs[i + k + 1] >= 128 && xs[i + k + 1] <= 191 for k in 1..need].all(it)
}

fn first_lo(lead: int) -> int {
    when {
        lead == 224 -> 160
        lead == 240 -> 144
        _ -> 128
    }
}

fn first_hi(lead: int) -> int {
    when {
        lead == 237 -> 159
        lead == 244 -> 143
        _ -> 191
    }
}

/// The code points of octets already known to be UTF-8.
fn codepoints(xs: List<int>) -> List<int> {
    mut out: List<int> = []
    mut i = 0
    while i < xs.length {
        let need = lead_need(xs[i])
        out.push(codepoint_at(xs, i, need))
        i = i + need + 1
    }
    out
}

fn codepoint_at(xs: List<int>, i: int, need: int) -> int {
    if need == 0 { return xs[i] }
    mut cp = xs[i] & (255 >> (need + 2))
    for k in 0..need { cp = (cp << 6) | (xs[i + k + 1] & 63) }
    cp
}
