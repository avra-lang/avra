//! THE OLD PATH'S OWN ASKS, for the specs that still read what only it answers — a workspace's
//! state, a file's analysis, a program's expanded source. Each is the old pipeline's; a spec that
//! imports this module is one the program layer doesn't answer yet.
use compiler.{
    analyze_source,
    Language,
    Program,
    Workspace,
    avra,
    formatted_under,
    new_workspace,
    one_shot_let_go,
    write_checked_under,
}
use compiler.host.{Host, memory_host}
use compiler.lower.{Lowered}
use core.{FileId, flatten}
use diagnostics.{Diag}
use testing.{Judged, Module, provided_files}

/// A workspace a test makes — ONE ONE-SHOT WORKSPACE IS ALIVE AT A TIME,
/// so the one made before it is let go: read what a workspace answers
/// before making the next.
export fn test_workspace(host: Host, root: string, lang: Language = avra()) -> Workspace {
    one_shot_let_go()
    let ws = new_workspace(host, root, lang)
    ws.alone()
    ws
}

/// A workspace's file as the formatter prints it, read under the words the workspace gives it.
export fn formatted_in(ws: Workspace, f: FileId) -> Result<string, string> {
    formatted_under(ws.source(f), ws.block_words(f, ws.parsed(f)))
}

/// A workspace's file as the formatter would write it, its receipts held.
export fn write_checked_in(ws: Workspace, f: FileId) -> Result<string, string> {
    write_checked_under(ws.source(f), ws.block_words(f, ws.parsed(f)))
}

/// The workspace of the program `testing.provided` holds.
export fn provided_workspace(main: string, provider: string, modules: List<Module> = []) -> Workspace {
    let files = provided_files(main, provider, modules)
    test_workspace(memory_host(files, files.keys()), "/w")
}

/// The program `testing.provided` holds, as the old path reads it.
export fn provided(main: string, provider: string, modules: List<Module> = []) -> Program {
    provided_workspace(main, provider, modules).program("/w/src/main.av")
}

/// The program a judged one holds, as the old path reads it: the same files, the same root, the
/// same entry — for an ask only the old path answers.
export fn program_of(j: Judged) -> Program {
    j.held.old_program(j.held.standing(j.entry.package_name, j.entry.path_in_package))
}

/// One source's IR as the old path lowers it: its registers typed through the program's own
/// registry, which the program layer's IR does not carry.
export fn typed_ir_of(source: string) -> Lowered {
    analyze_source(source).lowered()
}

/// Everything a program said: its files' diagnostics, the workspace's voices and its defects.
export fn said(p: Program) -> List<Diag> {
    flatten([a.diagnostics for a in p.files]).concat(p.voices).concat(p.defects)
}

/// A program refused in `n` diagnostics, saying `phrase`.
export fn refused_n(p: Program, phrase: string, n: int) -> bool {
    said(p).length == n && p.report().contains(phrase)
}

/// A program refused exactly once, saying `phrase`.
export fn refused_in(p: Program, phrase: string) -> bool { refused_n(p, phrase, 1) }

/// What a program answers when run, or the words it stopped with.
export fn answered(p: Program) -> string {
    match p.run() { .Ok(v) -> v, .Err(why) -> why }
}
