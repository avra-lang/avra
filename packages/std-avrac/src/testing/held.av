    fn_reaches,
    fn_reads,
    item_rule_file,
    file_law_diags,
    program_erring,
    LinkRead,
    LinkWorld,
    program_link_words,
    program_packages,
    file_formatted,
    file_write_checked,
    file_expanded,
    file_compiled_items,
    program_hosts_owed,
    made_suite,
    MadeSuite,
    CompiledItem,
    Finding,
    file_rule_rows,
    program_files,
    avra,
    AdmittedSaid,
    GraphHeld,
    GraphRoot,
    MadeProgram,
    NOTHING_ADMITTED,
    ProgramFile,
    manifest_voices,
    manifests_voiced,
    package_stands,
    avra_fact_definitions,
    avra_source_world,
    file_refusals,
    finding_diag,
    made_program,
    program_refused,
    program_warned,
    body_at,
    task_survey,
    CancelFact,
    declared_symbol,
}
