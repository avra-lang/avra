/// A body of two statements.
export fn two(xs: List<int>) -> int {
    mut total = 0
    for x in xs {
        let y = x * 2
        total = total + y
    }
    total
}

/// A body declaring the names its meaning uses, beside the user's own of the same names.
export fn named_alike(xs: List<int>) -> int {
    mut at = 10
    for x in xs {
        let items = [x, x]
        at = at + items.length
    }
    at
}

/// A body that leaves early, both ways.
export fn leaving(xs: List<int>) -> int {
    mut total = 0
    for x in xs {
        if x < 0 { continue }
        if x > 100 { break }
        total = total + x
    }
    total
}

/// A body naming its loop, which stays its own.
export fn labelled(xs: List<List<int>>) -> int {
    mut total = 0
    for row in xs {
        for x in row {
            if x < 0 { break row }
            total = total + x
        }
    }
    total
}
