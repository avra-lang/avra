// proves: `list_of` builds a list literal of ANY length — zero through
// seven here — from a `List<Code>` a derive computed at compile time.
// The length is the type's field count, never a fixed arity, and the
// suite runs the program under the evaluator and native alike.
use @std.meta.{derive}
use @test.lister.{Labels}

@derive(Labels)
type E0 = {}

@derive(Labels)
type E1 = { a: string }

@derive(Labels)
type E2 = { a: string, b: string }

@derive(Labels)
type E3 = { a: string, b: string, c: string }

@derive(Labels)
type E4 = { a: string, b: string, c: string, d: string }

@derive(Labels)
type E5 = { a: string, b: string, c: string, d: string, e: string }

@derive(Labels)
type E6 = { a: string, b: string, c: string, d: string, e: string, f: string }

@derive(Labels)
type E7 = { a: string, b: string, c: string, d: string, e: string, f: string, g: string }

fn show(label: string, xs: List<string>) {
    println("${label}: ${xs.length} [${xs.join(",")}]")
}

show("E0", E0 {}.labels())
show("E1", E1 { a: "1" }.labels())
show("E2", E2 { a: "1", b: "2" }.labels())
show("E3", E3 { a: "1", b: "2", c: "3" }.labels())
show("E4", E4 { a: "1", b: "2", c: "3", d: "4" }.labels())
show("E5", E5 { a: "1", b: "2", c: "3", d: "4", e: "5" }.labels())
show("E6", E6 { a: "1", b: "2", c: "3", d: "4", e: "5", f: "6" }.labels())
show("E7", E7 { a: "1", b: "2", c: "3", d: "4", e: "5", f: "6", g: "7" }.labels())
"done"
