//! A derive whose generated list literal's LENGTH is the type's field
//! count: `list_of` splices a `List<Code>` into a list literal's
//! element run, so no arity is baked into the template.
use @std.meta.{Type, Directive, Decls, Code, list_of}

export trait Labels {
    static fn derive(t: Type) -> List<Directive> {
        let elems: List<Code> = [quote { self.${f.name} } for f in t.fields]
        let body = list_of(elems)
        let source: Decls = quote { impl ${t} { fn labels() -> List<string> { ${body} } } }
        [Directive { twin: "", name: t.name, at: t.at, source: source }]
    }
}
