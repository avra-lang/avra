// proves: `embed` reads a file beside the source at COMPILE time,
// into a const the program reads as a constant — both engines see
// the same text, and nothing reads the file at run time.
use @std.meta.{embed}
const GREETING: string = embed("hello.txt")
const LINES: int = GREETING.split("\n").length
"${GREETING.trim()} ${LINES} ${GREETING.length}"
