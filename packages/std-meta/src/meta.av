//! `@std/meta` — what a program says TO THE COMPILER, and what the
//! compiler hands back. Every verb here runs at compile time.
//!
//!     use @std.meta.{embed}
//!     const SCHEMA: string = embed("schema.sql")
//!
//! `embed` answers a file's text, read beside the source file that
//! writes the call, and the build records the file as an input. THE
//! FILE STAYS INSIDE THE PACKAGE: an absolute path, a `..` that climbs
//! past the package's root and a symlink on the way all refuse, at
//! the literal — a build bakes in what the package holds and nothing
//! of the machine it ran on. A dependency's file is named by its
//! package, `embed("@std/meta/src/meta.av")`, read from that
//! package's root. A program reaching `embed` at run time traps: the
//! file sits beside the SOURCE, and a running program has none.
//!
//!     use @std.meta.{Fn, Diagnostic, refuse}
//!     export fn short(f: Fn) -> List<Diagnostic> {
//!         if f.params.length <= 3 { [] } else { [refuse("`${f.name}` takes ${f.params.length} seats — three is the most")] }
//!     }
//!
//! An ANNOTATION `@short` above a fn calls `short` over that fn at
//! compile time: the fn's first seat says what it takes (`Fn`, `Type`,
//! or `Named` for any declaration), and what it answers is its effect —
//! `List<Diagnostic>` validates (a warning is the declaration's word
//! for its USES), `void` records, `List<Directive>` OR `Declared`
//! generates declarations beside the annotated one — `Declared` is the
//! same effect with room to also speak problems about the shape it
//! generated from, exactly where a Validates annotation's own answer
//! is spoken — and `Derived` runs a named trait's associated `derive`
//! (`@derive(Show)`). A `quote { … }` is
//! a TEMPLATE, parsed where it is written: it answers `Code` (an
//! expression), `Stmts`, `Arms` or `Decls` by what its body is, and
//! `${e}` is a hole typed by the seat it stands in — a name, a type,
//! an expression, a statement, an arm. A template's names resolve
//! where it was written; a hole's where the code is spliced.

use @std.errors.{Loc}

extern fn avra_embed(path: string) -> string

extern fn avra_type_named(name: string) -> Type?

/// A TYPE AS A SHAPE, beside the spelling every seat has always
/// carried. A rule that DISPATCHES on a type asks this; a rule that
/// PRINTS one asks `spelled()`, which answers the same words the
/// string seats do. Every shape the compiler can hand over has a
/// variant, so a rule over `Kind` is a registry the build checks —
/// a string seat is a registry nothing checks, and telling
/// `List<int>` from a type named `Listen` was a substring test
/// before this.
export enum Kind {
    Int
    Float
    Bool
    Str
    /// an opaque host pointer — what an extern seat carries
    Ptr
    Void
    List(elem: Kind)
    /// explicit shared interior mutability
    Cell(inner: Kind)
    Map(key: Kind, value: Kind)
    /// `T?` — a value that may be absent
    Opt(inner: Kind)
    Result(ok: Kind, err: Kind)
    /// a DECLARED name — a record or an enum, with its arguments
    /// when it is generic (`Box<int>` is `Named("Box", [Int])`)
    Named(name: string, args: List<Kind>)
    /// `fn(seats) -> answer`. THE SEATS CARRY THEIR OWN CONTRACTS:
    /// a seat is ONE value holding its shape and its promises, never
    /// a `List<Kind>` beside a parallel list of marks — a promise
    /// added as a second list drops silently wherever a site forgets
    /// it.
    Fn(seats: List<Seat>, answer: Kind)
    /// `dyn Trait` — a value known only by its contract
    Dyn(name: string)
    /// a generic declaration's own type parameter, by its name
    Var(name: string)
    /// A SHAPE THIS VOCABULARY HAS NO WORD FOR, as the compiler
    /// spells it — a literal's own type, a type used as a value, the
    /// error absorber. Never a silent absence: a rule over `Kind`
    /// that meets one must SAY so.
    Unspelled(text: string)
}

/// A fn seat: what it carries, and what the callee may do through
/// it. `mutable` lets the callee write through the seat; `settled`
/// demands the caller settle its value at compile time.
export type Seat = { kind: Kind, mutable: bool, settled: bool }

/// What a seat promises, ONE value wherever a seat is written: `mutable` lets
/// the callee write through it, `settled` demands the caller settle its value.
export type SeatMark = { mutable: bool = false, settled: bool = false }

impl Kind {
    /// The words the compiler spells this shape with — exactly what
    /// the string seat beside it carries.
    fn spelled() -> string {
        match self {
            .Int -> "int",
            .Float -> "float",
            .Bool -> "bool",
            .Str -> "string",
            .Ptr -> "ptr",
            .Void -> "void",
            .List(elem) -> "List<${elem.spelled()}>",
            .Cell(inner) -> "Cell<${inner.spelled()}>",
            .Map(key, value) -> "Map<${key.spelled()}, ${value.spelled()}>",
            .Opt(inner) -> "${inner.spelled()}?",
            .Result(ok, err) -> "Result<${ok.spelled()}, ${err.spelled()}>",
            .Named(name, args) -> named_spelling(name, args),
            .Fn(seats, answer) -> "fn(${[s.spelled() for s in seats].join(", ")})${answer_spelling(answer)}",
            .Dyn(name) -> "dyn ${name}",
            .Var(name) -> name,
            .Unspelled(text) -> text,
        }
    }
}

impl Seat {
    /// A seat as a fn type spells it — its marks in front when it
    /// carries any.
    fn spelled() -> string {
        if self.settled { return if self.mutable { "const mut ${self.kind.spelled()}" } else { "const ${self.kind.spelled()}" } }
        if self.mutable { return "mut ${self.kind.spelled()}" }
        self.kind.spelled()
    }
}

/// A declared name, with its arguments when it has any.
fn named_spelling(name: string, args: List<Kind>) -> string {
    if args.is_empty() { return name }
    "${name}<${[a.spelled() for a in args].join(", ")}>"
}

/// A fn's written answer — nothing when it answers `void`.
fn answer_spelling(answer: Kind) -> string {
    if answer is .Void { return "" }
    " -> ${answer.spelled()}"
}

/// A fn's parameter as an annotation sees it: its name, its type's
/// spelling and its SHAPE, whether it is a `mut` seat, and whether
/// it is a `const` seat — settled at compile time.
export type Param = { name: string, ty: string, mutable: bool, settled: bool, at: Loc?, kind: Kind = Kind.Unspelled("") }

/// A fn declaration as an annotation's first seat receives it. Types
/// are SPELLED here and SHAPED beside the spelling: `answer` is the
/// words, `answers` the shape a rule dispatches on. `doc` is its own
/// `///` lines joined by a newline, absent where it wrote none;
/// `annotations` is every `@name(args)` it wears, in written order.
/// `owner` is the type or trait a method belongs to, as its block
/// spells it — absent for a free fn; `${name(f.owner!)}` names it in
/// a template.
export type Fn = { name: string, params: List<Param>, answer: string, at: Loc?, answers: Kind = Kind.Unspelled(""), doc: string? = null, annotations: List<Annotation> = [], owner: string? = null }

/// A MARK a declared member carries — `@frozen`, `@widened(body)`
/// written before a variant or a field. A MARK IS DATA WHERE AN
/// ANNOTATION IS A CALL: the compiler records it and hands it here,
/// and its arguments are WORDS because a mark is read while the
/// file's names are still resolving.
///
/// A READER SAYS WHICH MARKS IT CLAIMS. A trait's `marks` answers the
/// words its `derive` reads, and a mark no reader on the declaration
/// claims is refused where it was written — so a misspelled mark
/// cannot sit there doing nothing.
export type Mark = { name: string, args: List<string>, at: Loc?, named: List<MarkArg> = [] }

/// An argument a mark names — `web: .Click` is `{ label: "web", value: "Click" }`.
/// A mark's `args` hold its positional arguments only.
export type MarkArg = { label: string, value: string }

/// `@name(args)` as a DECLARATION's own annotation, never a member's
/// mark — `Mark`'s twin at the `Fn`/`Type` level: the call's name,
/// each argument's literal text, and where it was written. `call` is
/// the annotation as the template `name(${value}, args)`: `applied`
/// fills the value, and the call is typed where it is spliced, its
/// refusals pointing here. `args` holds the positional arguments and
/// `named` each `label: value`, as a `Mark`'s do; a list argument's
/// text is its source spelling (`["open", "done"]`).
export type Annotation = { name: string, args: List<string>, at: Loc?, call: Code? = null, named: List<MarkArg> = [] }

/// The annotation called over a value — `@range(13, 130)` over `v`
/// is `range(v, 13, 130)`. Absent when the compiler handed no call.
export fn applied(a: Annotation, value: Code) -> Code? {
    let call? = a.call else { return null }
    match call.node {
        .Template(file, at, parts, _) -> Code { node: Node.Template(file, at, parts, [value.node]) },
        rest -> null,
    }
}

/// WHERE A LITERAL WAS WRITTEN. A field of this type that a record
/// literal leaves unset holds that literal's own site: one number a
/// literal, the same each time it is built, so a value can be told by
/// where it was made. Two literals written alike in one file are told
/// apart by their turn among them.
export type Site = int

/// THE STATE CELLS A TEXT READS. A field of this type that a record literal
/// leaves unset holds the cells its sibling closure reads (the places the
/// compiler found in the closure's body, fixed for the literal's life).
export type Cells = List<ptr>

/// THE STATE CELLS A PAGE READS AT PAINT TIME that no text says again: a label,
/// a conditional, a loop, a helper's read. A field of this type that a record
/// literal leaves unset holds the cells of the frame the literal stands in; a
/// write to one of them takes the full paint.
export type Structural = List<ptr>

/// WHETHER A SUBTREE CANNOT BE PLACED: a read of a place no cell can be handed
/// over for here. A field of this type that a record literal leaves unset
/// holds whether the frame it stands in has such a read; a page that holds one
/// is always painted whole.
export type Opaque = bool

/// THE WORDS A COMPONENT SAYS AGAIN: a closure over its head's text that
/// recomputes it from the state as it stands. The instance's builder fills a
/// field of this type with a closure over a copy of the head, so the compiler
/// knows which field holds it by its type.
export type Words = fn() -> string

/// A written type, whole: its name, the module declaring that name as `use`
/// spells it (absent for a builtin or a name nothing declares), its arguments,
/// and the seat mark it was written with, as a fn type's parameter.
export type Spelled = {
    name: string,
    module: string?,
    args: List<Spelled> = [],
    optional: bool = false,
    dynamic: bool = false,
    arrow: bool = false,
    alternatives: List<Spelled> = [],
    mark: SeatMark = SeatMark {},
}

/// A record's field: its name, its type's spelling, its shape, and
/// the marks written before it. `doc`/`annotations` read as `Fn`'s.
/// `defaulted` says it declares a default a literal may leave out.
/// `default` is that default's own expression, absent when it declares
/// none — a rule may omit the field's label and the default fills it.
/// `state` says it is a place its record holds — a comparable head prop of a
/// stateful component is one too. `spelled` is `ty` whole.
/// `says` makes the field an EVENT its component declares (`on
/// input(text: string)`): the seats its handler is told, none for an
/// event that says nothing — and absent on a field that is no event.
export type Field = { name: string, ty: string, at: Loc?, kind: Kind = Kind.Unspelled(""), marks: List<Mark> = [], doc: string? = null, annotations: List<Annotation> = [], defaulted: bool = false, says: List<Param>? = null, state: bool = false, default: Code? = null, spelled: Spelled? = null, prop: bool = false }

/// An enum's variant: its name, its payload's spellings, and the
/// payload as FIELDS — each carrying the name a grammar rule's
/// capture label binds to, beside its spelling and its shape. A
/// payload IS a parameter compiler-side, so `fields` runs with
/// `payload` and says what `payload` cannot. `doc`/`annotations`
/// read as `Fn`'s. `impls` is the traits a GATHERED variant's member
/// record implements by an `impl … for` it can see — empty for a
/// written variant.
export type Variant = { name: string, payload: List<string>, at: Loc?, fields: List<Field> = [], marks: List<Mark> = [], doc: string? = null, annotations: List<Annotation> = [], impls: List<string> = [] }

/// A type declaration as an annotation's first seat receives it: a
/// record has fields, an enum has variants. `doc`/`annotations` read
/// as `Fn`'s. `module` is the declaring module fully qualified, as
/// `use` spells it from outside its package (`@std.avrac.compiler`).
/// `over` is a NAMED type's shape — `type Code = string` stands over
/// `string` — and `Unspelled` for a record or an enum. `spreads` is
/// each record it spreads in (`..Box`), as written; `fields` holds the
/// fields it wrote itself, never the ones a spread placed. `body` is
/// the statements a component is MADE OF, as the template a reader
/// splices where they mean something — absent for a declaration that
/// holds none.
export type Type = { name: string, fields: List<Field>, variants: List<Variant>, at: Loc?, doc: string? = null, annotations: List<Annotation> = [], module: string = "", over: Kind = Kind.Unspelled(""), spreads: List<string> = [], body: Stmts? = null }

/// What an annotation says back about a declaration. A fn answering
/// `List<Diagnostic>` VALIDATES: an empty list passes, each ERROR is
/// spoken at the place it names (the declaration when it names none),
/// and each WARNING is kept for the declaration's USES (`warn`).
/// `kind` names the diagnostic for `avra docs` and the report's
/// header, under the annotation's PACKAGE (`error[@acme/audit:E1]`);
/// a kind-less refusal wears the annotation feature's own kind.
export type Diagnostic = { message: string, help: string?, at: Loc?, warning: bool = false, kind: string? = null }

/// A refusal at the declaration itself.
export fn refuse(message: string) -> Diagnostic {
    Diagnostic { message: message, help: null, at: null }
}

/// A refusal under the package's own kind — `refuse_as("E1", …)`
/// renders `error[@scope/name:E1]` and `avra docs @scope/name:E1`
/// finds it when the kind is spelled as a literal.
export fn refuse_as(kind: string, message: string) -> Diagnostic {
    Diagnostic { message: message, help: null, at: null, kind: kind }
}

/// A kinded refusal at a place, with its remedy.
export fn refuse_as_at(kind: string, at: Loc?, message: string, help: string?) -> Diagnostic {
    Diagnostic { message: message, help: help, at: at, kind: kind }
}

/// A refusal at a place — a field's, a parameter's — with its remedy.
export fn refuse_at(at: Loc?, message: string, help: string?) -> Diagnostic {
    Diagnostic { message: message, help: help, at: at }
}

/// A declaration's word for its USERS: not spoken where the
/// declaration stands, but at every use of it. `@deprecated` is the
/// one shipped today.
export fn warn(message: string) -> Diagnostic {
    Diagnostic { message: message, help: null, at: null, warning: true }
}

/// Any declaration, for an annotation that only needs to NAME it.
export type Named = { name: string, at: Loc? }

/// A trait as an annotation's argument sees it (`@derive(Show)`):
/// `fns` is its instance methods, as a `Fn` each.
export type Trait = { name: string, at: Loc?, fns: List<Fn> = [] }

/// The declaration is out of favour; every use is warned with the
/// note. A warning, so the build still runs.
export fn deprecated(what: Named, note: string) -> List<Diagnostic> {
    [warn("`${what.name}` is deprecated — ${note}")]
}

/// The fn answers every row of a relation — a comprehension scanning
/// its answer may be narrowed to a sibling `@plans` lookup. A marker the
/// compiler's planner reads.
export fn plans_all(_f: Fn) {}

/// The fn answers the rows whose `field` holds a value — `by_f(db, v)`
/// for `@index f`. The planner lowers `[r for r in T.all(db) if r.f ==
/// v]` to it, and holds the field's type to the lookup's argument.
export fn plans(_f: Fn, _field: string) {}

/// The fn answers the one row whose `field` holds a value — a `@unique`
/// field's lookup. The planner does not narrow to it, so a scan
/// comparing that field is no missing index.
export fn looks_up(_f: Fn, _field: string) {}

/// The relation holds about `rows` rows, as a census counted them. Past
/// the planner's floor, a comprehension scanning every row for a compare
/// no index answers is warned with the index to add.
export fn census(_t: Type, _rows: int) {}

/// The type is a PROCESS-LOCAL DENSE ID — a record of one int, minted
/// in order and meaningful in no other process. A marker the derives
/// read (`type_named(n)?.annotations`): nothing durable may hash or
/// encode one.
export fn dense(_t: Type) {}

/// A COMPONENT WITH A BODY IS ONE OF THESE. `@composes(Carried)` on a
/// trait: a component whose declaration holds statements — what it is
/// made of — is derived over this trait, with nothing written on the
/// component: the trait's own `derive` receives it, its `Type.body` the
/// statements, and makes the impl. The component CARRIES the record
/// `Carried` as if it spread it, so what the trait reads of every such
/// component — where it stands, say — is a field the author never
/// writes. One trait a program composes by; two is refused.
export fn composes(_tr: Trait, _carried: Named) {}

/// The type is an IDENTITY: every copy of it must go on reading and
/// writing the same tables, so a field a writing path could open
/// unique would fork them. A marker the compiler's own checker reads
/// (`compiler/typing/declare.av`): every field of a type carrying
/// `@identity` is a `Cell<…>`, or another `@identity` type.
export fn identity(_t: Type) {}

/// The fn is a member of the named fixpoint or table BRACKET: it may
/// read that bracket's own hook-free accessors — the table as it
/// stands, mid-computation — because it IS the computation trusted to
/// see them that way. A marker the compiler's own checker reads
/// (`compiler/idioms.av`): a hook-free read from any fn not carrying
/// `@bracket` with the matching name is a missing dependency.
export fn bracket(_f: Fn, _name: string) {}

/// The fn is UNBROKEN: no other task runs inside it, so a test and the
/// park it decides, or a claim and the append it owes, stand together.
/// Its `while`s carry no preemption check, and every call it makes is
/// to C (a runtime row or an extern — a park row is where it may switch
/// out, and nowhere else), to a vocabulary row that does not wait, to
/// a constructor, or to another `@unbroken` fn. A marker the compiler's
/// own checker reads (`compiler/typing/unbroken.av`).
export fn unbroken(_f: Fn) {}

/// `_field`, on an `@identity` type, is licensed PLAIN: a scalar or a
/// fn value set once at construction and never reassigned, so no
/// writing path ever reaches it to fork it. Written once per plain
/// field, beside `@identity`. A marker the same checker reads
/// (`compiler/typing/declare.av`).
export fn plain_field(_t: Type, _field: string) {}

/// The type is SEALED: only the module that declares it builds or
/// rewrites one — no literal fill, `Name(value)`, record literal, `with`,
/// field write or variant outside it — while every read stays open. A
/// checked constructor the module exports is then the type's one door.
/// A marker the compiler's checker reads (`features/sealed.av`).
export fn sealed(_t: Type) {}

/// The record LACKS `field` on purpose, and `why` says so: a read or a
/// literal naming it refuses in those words. A marker the compiler's
/// checker reads; a record cannot lack a field it declares.
export fn lacks(_t: Type, _field: string, _why: string) {}

/// The type OWNS the running tasks it holds, so a binding of it is
/// settled where its block ends: each task it carries is cancelled then
/// joined, and a TASK field it declares is a producer handle — the one
/// seat the task law otherwise refuses. A marker the compiler's checker
/// reads (`core/types.av`'s owner predicates, `features/task_law.av`,
/// `compiler/lower/walk.av`'s settle): a fn may answer a marked owner,
/// and its receiver settles it.
export fn owns(_t: Type) {}

/// A file's text, read at compile time beside the source that calls
/// this — or, for `@scope/name/…`, from the root of that dependency.
/// The path is a literal, the file is UTF-8 and stands inside the
/// package, reached through no link.
export fn embed(path: string) -> string {
    avra_embed(path)
}

/// A TYPE THE COMPILER READS FROM A BUILD INPUT. A kind implements
/// `Provider` once; a declaration marked as provided asks every kind to
/// `provide` from the octets of the file it names, and takes the type of
/// the one that answers. The compiler does the placed read (inside the
/// package, through no link) and hands the octets over with their BLAKE3
/// digest in hex, so a provider is pure and calls no C: its answer is a
/// function of the file. `path` is package-relative.
/// Absent is "this kind does not read this file".
export trait Provider {
    static fn provide(path: string, octets: Bytes, digest: string) -> Self?
}

/// A value of the kind `T`, read from a file of this package at compile
/// time. The path is a literal, read from the PACKAGE'S ROOT (never beside
/// the source), inside the package and through no link; the kind is
/// written — `provided<Picture>("art/logo.svg")` — and must implement
/// `Provider`. The compiler lowers every call itself: the file's octets go
/// to `T.provide` with the package-relative path, and a kind that answers
/// absent refuses the file by name. `asset` is this call written as a
/// declaration.
export fn provided<T: Provider>(path: string) -> T {
    unreached<T>(path)
}

/// A body that only types: the compiler lowers every call of `provided`
/// itself, so this one is never run.
fn unreached<T>(path: string) -> T {
    unreached<T>(path)
}

/// THE HASH OF `f`'S CODE: a key that moves when what `f` does moves,
/// and only then. It folds `f`'s lowered code and everything it can
/// reach — what it calls, a closure it makes, a value of a const it
/// reads, and, when it calls through a fn value or `dyn`, every fn
/// whose address the program takes — and leaves out every name,
/// comment and span, so a rename moves nothing. A C fn it calls — a
/// package's extern or a runtime row — is folded by its name alone, so
/// an edit to C moves nothing. The compiler answers it; `f` is a
/// declared fn, named. ABSENT when the compiler cannot compute it — it
/// reaches a body held from an earlier build, or no compiler answered
/// the call — so whatever is keyed by it is never kept, never read stale.
export fn code_hash<F>(_f: F) -> string? { null }

/// RUNS `body` UNDER A CATCH POINT: absent when it ran to its end, the
/// trap's words when a trap on this task ended it. Whatever the body wrote
/// stands, and only the trap's own task is caught — a trap on another
/// task, a stack overflow and an unguarded trap still end the process.
/// The compiler lowers a DIRECT CALL of this fn to the runtime's guarded
/// run, and refuses it handed on as a value (`type.guard_value`).
export fn guarded(_body: fn() -> bool) -> string? { null }

/// RUNS `body` UNDER A CATCH POINT and brings back what it answered, of
/// any type: `.Ok(answer)`, or `.Err(words)` when a trap on this task ended
/// it. The answer travels through a slot this fn owns, so the runtime reads
/// no answer and every type crosses the same way.
export fn contained<T>(body: fn() -> T) -> Result<T, string> {
    let slot: Cell<List<T>> = Cell.new([])
    let ended = guarded(
        () -> {
            slot.set([body()])
            true
        },
    )
    match ended {
        words? -> .Err(words)
        null -> .Ok(slot.get()[0])
    }
}

/// The whole `Type` a name resolves to from where the CALLER stands
/// — this file, its imports included, through the same resolution
/// an ordinary type reference goes through. Absent for a name
/// nothing declares there, or one that names a fn or a trait, not a
/// type. Into an annotation processor's own compile-time run only:
/// a program reaching it at run time has no declaration table.
///
/// `name` is ONE WORD, as a type reference spells it. A dotted text is
/// no name and answers absence: a module's export is asked for by
/// `type_exported`, so no text is read two ways.
export fn type_named(name: string) -> Type? {
    if name.contains(".") { return null }
    avra_type_named(name)
}

/// The one scalar a named record stores as, or null for any other kind. A record of
/// exactly one scalar field and no `@model` is flat at runtime, so its field travels
/// alone; the structure decides it, not the name.
/// Whether a kind is one scalar a flat record can store as.
export fn scalar_kind(k: Kind) -> bool {
    match k {
        .Int or .Float or .Bool or .Str -> true,
        .Opt(inner) -> scalar_kind(inner),
        rest -> false,
    }
}

/// Whether a named record stores as one scalar: its kind is a scalar, so the
/// consumers ask one question instead of matching the nullable themselves.
export fn flat(name: string) -> bool {
    let k? = stored_scalar(name) else { return false }
    scalar_kind(k)
}

export fn flat_field(name: string) -> string {
    let t? = type_named(name) else { return "" }
    t.fields[0].name
}

export fn stored_scalar(name: string) -> Kind? {
    let t? = type_named(name) else { return null }
    if t.annotations.any(it.name == "model") || t.fields.length != 1 { return null }
    t.fields[0].kind
}

/// The `Type` a MODULE exports under `name`, wherever the caller stands
/// — `type_exported("@std.ui.realize", "Attribute")`, the module as
/// `Type.module` spells it. A derive reads its own library's
/// declarations so: the file it runs over need not import them. Absent
/// when the module exports no such type.
export fn type_exported(module: string, name: string) -> Type? {
    if name.contains(".") { return null }
    avra_type_named("${module}.${name}")
}

/// What a declared payload type is made of, read off its declaration.
export enum Held {
    /// a record: its fields, in declaration order
    Record(fields: List<Field>)
    /// an enum: its variants, each with its own payload fields
    Enum(variants: List<Variant>)
}

/// What a DECLARATION holds: a record's fields or an enum's variants.
/// A NAMED type holds neither — `type Code = string` declares no
/// fields, and its shape is `Type.over`'s, the door to read it.
export fn held_of(t: Type) -> Held {
    if t.variants.is_empty() { return Held.Record(t.fields) }
    Held.Enum(t.variants)
}

/// What the type `name` holds, for a derive that reads a payload
/// type's declaration instead of keeping a row for it. `owner` is the
/// type being derived: the lookup is that type's MODULE's export of
/// `name` (`type_exported`), so a type only a member's own file
/// imported is not readable here — absence, which the derive answers
/// by refusing the payload loudly. Absent for a name no module export
/// declares.
export fn payload_of(owner: Type, name: string) -> Held? {
    let t? = type_exported(owner.module, name) else { return null }
    held_of(t)
}

/// Whether a payload kind's declaration graph holds a type `atom`
/// names — a derive prunes a payload that cannot reach what it walks
/// for (an arena id), so a type it has no row for contributes nothing
/// without being listed. Cycles end: a declaration is entered once.
export fn holds(owner: Type, k: Kind, atom: fn(string) -> bool) -> bool {
    holds_under(owner, k, atom, [])
}

fn holds_under(owner: Type, k: Kind, atom: fn(string) -> bool, seen: List<string>) -> bool {
    match k {
        .List(inner) or .Opt(inner) -> holds_under(owner, inner, atom, seen),
        .Named(name, _) -> {
            if atom(name) { return true }
            if seen.contains(name) { return false }
            let held? = payload_of(owner, name) else { return false }
            let entered = seen.concat([name])
            match held {
                .Record(fields) -> fields.any(holds_under(owner, it.kind, atom, entered)),
                .Enum(variants) -> variants.any(it.fields.any(holds_under(owner, it.kind, atom, entered))),
            }
        },
        .Int or .Float or .Bool or .Str or .Ptr or .Void or .Cell(_) or .Map(_, _) or .Result(_, _) or .Fn(_, _) or .Dyn(_) or .Var(_) or .Unspelled(_) -> false,
    }
}

/// Generated code as a TREE. A `quote { … }` names its own template
/// — the file that wrote it and where — and carries what fills its
/// holes; the compiler splices the template's parsed body, so a
/// template's names resolve where it was written and a hole's where
/// the code lands. The other shapes are what a hole may be filled
/// with besides another template.
export enum Node {
    Template(file: string, at: int, parts: List<string>, fills: List<Node>)
    /// an identifier
    Name(text: string)
    /// a string literal
    Text(text: string)
    Int(value: int)
    Float(bits: int)
    Bool(value: bool)
    /// a generated interpolation: its literal runs and the code in
    /// its holes
    Interp(parts: List<string>, holes: List<Node>)
    /// several in one seat — arms, declarations, statements, binders
    Many(items: List<Node>)
}

impl Node {
    /// The source as text — a projection for printing, never what
    /// the compiler reads: several in one seat print one per line,
    /// whatever seat the splice puts them in.
    fn text() -> string {
        match self {
            .Template(_, _, parts, fills) -> woven(parts, [f.text() for f in fills]),
            .Name(t) -> t,
            .Text(t) -> "\"${t.replace("\\", "\\\\").replace("\"", "\\\"")}\"",
            .Int(v) -> "${v}",
            .Float(bits) -> "${bits}",
            .Bool(b) -> "${b}",
            .Interp(parts, holes) -> "\"${woven(parts, ["\${${h.text()}}" for h in holes])}\"",
            .Many(items) -> [i.text() for i in items].join("\n"),
        }
    }
}

/// Runs with a fill between each pair — the parts are one longer.
fn woven(parts: List<string>, fills: List<string>) -> string {
    [parts[j] + f for j, f in fills].join("") + parts[fills.length]
}

/// An EXPRESSION template — what `quote { a + b }` answers.
export type Code = { node: Node }
/// A STATEMENT template — `quote { let a = 1 }`.
export type Stmts = { node: Node }
/// One or more MATCH ARMS — `quote { .A(x) -> x }`.
export type Arms = { node: Node }
/// One or more DECLARATIONS — `quote { impl T { … } }`; what a
/// `Directive` carries.
export type Decls = { node: Node }
/// What a SUGAR means — `quote { ${self.value} ^ -1 }` in a `means()`.
/// Its holes are arena ids, which no `Node` carries, so a `Rewrite` is
/// read where it is written and never run.
export type Rewrite = { node: Node }
/// A PATTERN head — a component field whose instance writes a string
/// literal (`"/robots/{id}"`), minted as a `grammar` declaration; the
/// template's hole names that record.
export type Format = { node: Node }

impl Code { fn text() -> string { self.node.text() } }
impl Stmts { fn text() -> string { self.node.text() } }
impl Rewrite { fn text() -> string { self.node.text() } }
impl Arms { fn text() -> string { self.node.text() } }
impl Decls { fn text() -> string { self.node.text() } }

/// An identifier as code — a read of the name, where a bare string
/// would be ambiguous.
export fn name(text: string) -> Code { Code { node: Node.Name(text) } }

/// Text as a STRING LITERAL of the generated program.
export fn literal(text: string) -> Code { Code { node: Node.Text(text) } }

/// A generated interpolation: `interpolated(["x: ", ""], [quote { self.x }])`
/// reads `"x: ${self.x}"` in the generated program.
export fn interpolated(parts: List<string>, holes: List<Code>) -> Code {
    Code { node: Node.Interp(parts, [h.node for h in holes]) }
}

/// A generated LIST LITERAL of `items`, one element each, in order —
/// whatever its length, `[]` included. A list literal's element run is
/// a run seat (`${..}`), so one template splices a whole `List<Code>`
/// where a fixed-arity helper would bake in a length.
export fn list_of(items: List<Code>) -> Code { quote { [${..items}] } }

// ── What the compiler's lowering of a quote calls — one row per
// seat and fill shape; never spelled by a program. ──

export fn template(file: string, at: int, parts: List<string>, fills: List<Node>) -> Node {
    Node.Template(file, at, parts, fills)
}
/// Already-generated CODE, spliced verbatim — a held handle's own
/// text, parenthesised at its own call site when it needs it. Never
/// an identifier's name (`name_node`) and never a quoted literal
/// (`Text`): this text IS a program already, not a word to escape.
export fn text_node(text: string) -> Node { Node.Name(text) }
export fn as_code(n: Node) -> Code { Code { node: n } }
export fn as_stmts(n: Node) -> Stmts { Stmts { node: n } }
export fn as_arms(n: Node) -> Arms { Arms { node: n } }
export fn as_decls(n: Node) -> Decls { Decls { node: n } }
export fn as_rewrite(n: Node) -> Rewrite { Rewrite { node: n } }
export fn int_node(v: int) -> Node { Node.Int(v) }
export fn bool_node(b: bool) -> Node { Node.Bool(b) }
export fn name_node(text: string) -> Node { Node.Name(text) }
export fn int_name(v: int) -> Node { Node.Name("${v}") }
export fn names_node(texts: List<string>) -> Node { Node.Many([Node.Name(t) for t in texts]) }
export fn code_nodes(xs: List<Code>) -> Node { Node.Many([x.node for x in xs]) }
export fn stmts_nodes(xs: List<Stmts>) -> Node { Node.Many([x.node for x in xs]) }
export fn arms_nodes(xs: List<Arms>) -> Node { Node.Many([x.node for x in xs]) }
export fn decls_nodes(xs: List<Decls>) -> Node { Node.Many([x.node for x in xs]) }
export fn rewrite_nodes(xs: List<Rewrite>) -> Node { Node.Many([x.node for x in xs]) }

/// A DIRECTIVE the COMPILER is asked to fulfil. A `twin` mints a fn
/// beside the original under a name no written binding can take
/// (`@traced("sum")` makes `sum_traced`); a `source` is generated
/// DECLARATIONS the compiler splices into this file's store and
/// admits (`@derive`), each template resolved in the file that wrote
/// it. A twin's name must be SPELLABLE — never a `$`-mangle. (NOT
/// `Decl`: that name is the compiler's own declaration — a collision
/// would arm a counterfeit.)
///
/// `wraps: true` asks for the OTHER shape: `source` declares a fn
/// under the annotated fn's OWN written name — the WRAPPER, written
/// by the derive author — and the compiler moves the WRITTEN body to
/// a private sibling (`wrapped`, below) so the written name resolves
/// to the wrapper from every caller, itself included. Over a METHOD
/// the wrapper is written as a bare fn wearing the method's own
/// `static`/`mut fn` word, and lands as a method of its owner.
/// `@query`'s
/// memoization wants this, and so does tracing and timing — never
/// both `wraps` and a `twin` in one directive.
export type Directive = { twin: string, name: string, at: Loc?, source: Decls? = null, wraps: bool = false }

/// The private sibling `wraps: true` moved the written body to, as a
/// callable reference the wrapper's own template splices at a NAME
/// seat: `${wrapped(f)}(args)` for a free fn, `self.${wrapped(f)}(args)`
/// for a method, `${name(f.owner!)}.${wrapped(f)}(args)` for a static
/// one — the receiver is the wrapper's own to write, since a
/// bound method is never a value (only its NAME crosses a `.Name`
/// seat). The mangling is the one both sides agree on; a `Code` answer
/// cannot fill a `.Name` seat, which is why this hands back a `Fn`.
export fn wrapped(f: Fn) -> Fn { f with { name: "${f.name}\$body" } }

/// The OTHER answer a Declares-effect fn may give, beside a bare
/// `List<Directive>` — the same effect, a second shape, for an
/// annotation that also wants to speak refusals about the shape it
/// generates from. `problems` are spoken exactly where a Validates
/// annotation's own answer is; a plain `List<Directive>` answer never
/// had problems to speak and stays exactly as it was. This is NOT
/// `Derived`: `Derived` is `@derive`'s own multi-trait mechanism, and
/// a fn answering it is never called for its body at all — the
/// compiler reads its ARGUMENTS as trait names instead. `Declared` is
/// an ordinary value a Declares-effect fn builds and returns itself.
export type Declared = { made: List<Directive>, problems: List<Diagnostic> = [] }

/// The trace directive's decoder: `@traced("label")` on `fn sum`
/// asks for a sibling named `sum_traced`.
// LICENSED fns.dead_parameter: an annotation's decoder wears the annotation's argument list
export fn traced(f: Fn, label: string) -> List<Directive> {
    [Directive { twin: "${f.name}_traced", name: f.name, at: f.at }]
}

/// What `@derive` answers: the declarations each trait's associated
/// `derive` made. The compiler dispatches; the signature is the law.
export type Derived = { made: List<Directive> }

/// `@derive(Show)` runs `Show`'s associated `derive` over the
/// annotated declaration. Stack the annotation to derive more traits.
///
/// THE CONTRACT a derivable trait keeps, held where the trait is
/// declared (F2134) and again at each `@derive` (F2072, F2066):
///
///     trait Show {
///         static fn derive(t: Type) -> List<Directive> { … }
///         static fn marks(t: Type) -> List<string> { … }   // optional
///     }
///
/// `derive` takes the declaration (`Type` for a record or enum, `Fn`
/// for a fn, `Named` for any) and answers the code to splice beside
/// it. `marks` names the field and variant marks it reads, and a mark
/// no derive claims is refused (F2092). The trait stands in its own
/// file: its `derive` is typed while the annotated file is still
/// being made.
// LICENSED fns.dead_parameter: an annotation's decoder wears the annotation's argument list
export fn derive(what: Named, tr: Trait) -> Derived {
    Derived { made: [] }
}

/// A MARK's answer. An annotation fn answering `Marker` is never run:
/// its word is data for a reader that claims it — a `@derive` whose
/// trait declares `marks` — on a gathered member as on a written variant.
export type Marker = {}

// ── `collect enum E: T` — `T` implemented over a gathered enum ──

/// The impl of `tr` over `what`: each instance method matches the
/// variant and calls the member record's own. A `Self` parameter is
/// matched to the same variant, and `Self` as the answer wraps the
/// member's answer back in it. Parameters of differing variants answer
/// `false`, so only a `bool` method may take one; any other is refused
/// at the trait, and still made, so one mistake is one refusal.
export fn delegate(what: Type, tr: Trait) -> Declared {
    Declared {
        made: [
            Directive {
                twin: "",
                name: what.name,
                at: what.at,
                source: quote {
                    impl ${tr} for ${what} {
                        ${[delegated(what, tr, f) for f in tr.fns]}
                    }
                },
            },
        ],
        problems: [unanswerable_pairing(tr, f) for f in tr.fns if pairs_selves(f) && !answers_bool(f)],
    }
}

/// The impl of `tr` over `over`, written on the trait: a trait whose
/// methods name what the enum's own layer cannot (`@delegates(Expr)`).
/// A gathered member with no impl of `tr` is refused, naming it; the
/// impl is still made, so the enum keeps the method and one mistake
/// is one refusal.
export fn delegates(tr: Trait, over: Type) -> Declared {
    let made = delegate(over, tr)
    let unimplemented = [unimplemented_member(tr, over, v) for v in over.variants if !v.impls.contains(tr.name)]
    Declared { made: made.made, problems: made.problems.concat(unimplemented) }
}

fn unimplemented_member(tr: Trait, over: Type, v: Variant) -> Diagnostic {
    refuse_as_at(
        "delegates-member",
        v.at,
        "`${v.name}` is gathered into `${over.name}` and has no `impl ${tr.name} for ${v.name}`",
        "write `impl ${tr.name} for ${v.name}` beside the record",
    )
}

fn unanswerable_pairing(tr: Trait, f: Fn) -> Diagnostic {
    refuse_as_at(
        "delegates-self",
        tr.at,
        "`${tr.name}.${f.name}` takes `Self` and answers `${f.answer}` — members of different variants have no such answer",
        "only a `bool` answer may take `Self`: differing variants answer `false`",
    )
}

/// Whether a method takes `Self` beside the receiver.
fn pairs_selves(f: Fn) -> bool { f.params.any(it.ty == self_word) }

const self_word: string = "Self"

fn answers_bool(f: Fn) -> bool { f.answer == "bool" }

fn delegated(t: Type, tr: Trait, f: Fn) -> Decls {
    let seats = [seat(t, p) for p in f.params]
    let args = [name(p.name) for p in f.params]
    let ways = Ways {
        called: quote { member.${f.name}(${..args}) },
        recurred: quote { self.${f.name}(${..args}) },
        selves: [p.name for p in f.params if p.ty == self_word],
        wraps: f.answer == self_word,
        bool_answer: answers_bool(f),
    }
    quote {
        fn ${f.name}(..${seats}) -> ${standing(t, f.answer)} {
            match self { ${[delegated_arm(tr, ways, v) for v in t.variants]} }
        }
    }
}

/// What every arm of one delegated method shares: the member's call,
/// the call on the enum itself, the `Self` parameters and the answer's kind.
type Ways = { called: Code, recurred: Code, selves: List<string>, wraps: bool, bool_answer: bool }

/// One parameter of a delegated method, keeping its `mut` mark.
fn seat(t: Type, p: Param) -> Decls {
    let ty = standing(t, p.ty)
    if p.mutable { return quote { fn _(mut ${p.name}: ${ty}) {} } }
    quote { fn _(${p.name}: ${ty}) {} }
}

/// A spelled type, with the trait's `Self` standing as the enum.
fn standing(t: Type, spelled: string) -> string {
    if spelled == self_word { t.name } else { spelled }
}

/// One variant's arm. A member with no impl of `tr` is refused where it
/// is declared (`collect_enum.trait`), so its arm exists only in
/// a build already refused, and never runs.
fn delegated_arm(tr: Trait, ways: Ways, v: Variant) -> Arms {
    if !v.impls.contains(tr.name) { return quote { .${v} -> ${ways.recurred} } }
    let call = if ways.wraps { rewrapped(v, ways.called) } else { ways.called }
    if ways.selves.is_empty() { return quote { .${v} as member -> ${call} } }
    let other = if ways.bool_answer { quote { false } } else { ways.recurred }
    quote { .${v} as member -> ${paired(v, ways.selves, call, other)} }
}

/// A member record `made` rebuilt as variant `v`: its fields are the payload.
fn rewrapped(v: Variant, made: Code) -> Code {
    if v.fields.is_empty() { return quote { .${v} } }
    let payload = [quote { made.${f.name} } for f in v.fields]
    quote { match ${made} { made -> .${v}(${..payload}) } }
}

/// `call` where every `Self` parameter in `names` holds the same variant
/// `v` (rebound to its member), `other` where one does not.
fn paired(v: Variant, names: List<string>, call: Code, other: Code) -> Code {
    let first? = names.first() else { return call }
    let inner = paired(v, names.drop(1), call, other)
    quote { match ${name(first)} { .${v} as ${first} -> ${inner}, rest -> ${other} } }
}
