// proves: @std/compress end to end, evaluated and native alike — each
// format reads another implementation's output, round-trips its own,
// and stops a bomb at its ceiling.
use @std.compress.{Format, CompressError, encoded, decoded_x}
use @std.text.{from_base64}

fn said(r: Result<Bytes, CompressError>) -> string {
    match r { .Ok(b) -> b.text() ?? "octets ${b.length}", .Err(e) -> e.describe().message }
}

println(
    said(decoded_x(from_base64("H4sIAAAAAAACA8tIzcnJ11Eozy/KSQEAOnKr/wwAAAA=")!, Format.Gzip, 100)),
)
println(said(decoded_x(from_base64("eJzLSM3JyddRKM8vykkBAB1UBIk=")!, Format.Zlib, 100)))
println(said(decoded_x(from_base64("jwWAaGVsbG8sIHdvcmxkAw==")!, Format.Brotli, 100)))
mut zeros = "0".bytes()
for _i in 0..20 {
    zeros = zeros.concat(zeros)
}
for f in [Format.Gzip, Format.Zlib, Format.Brotli] {
    let packed = encoded(zeros, f) catch "".bytes()
    println(
        "${packed.length < 5000} ${said(decoded_x(packed, f, 4096))} ${(decoded_x(packed, f, 2000000) catch "".bytes()).length}",
    )
}
said(decoded_x("junk".bytes(), Format.Gzip, 10))
