// proves: what every case std-ui's stories tell SAYS on each target — the web's HTML, the headless
// outline, the terminal's drawing — and the sheet each dial wears, as one digest a line. A line that
// moves names the case a change reached; `changed` over two runs says the same.
use @std.ui.tree.viewed.{views}
use @std.ui.tree.story.{stories}
use @std.ui_gallery.{Snapshot, changed, shelves, shelf_snapshots, sheet_snapshots}

let now = shelf_snapshots(shelves(views, stories)).concat(sheet_snapshots())
let again = shelf_snapshots(shelves(views, stories)).concat(sheet_snapshots())
let lines = ["${s.view}/${s.case} ${s.digest}" for s in now]
"${lines.join("\n")}\n${now.length} snapshots, ${changed(now, again).length} moved between two runs"
