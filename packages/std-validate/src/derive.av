//! `@derive(Decode)` — a type's annotations, read into its decoder.
//!
//!     @derive(Decode)
//!     type Signup = {
//!         @email email: string
//!         @range(13, 130) age: int
//!     }
//!
//!     let s = Signup.decode(value)?          // Result<Signup, Issues>
//!     let s = Signup.from_json(text)?        // the same, straight from JSON text
//!
//! Each field is read at its slot by its kind, then each annotation
//! is CALLED over what was read — `@range(13, 130)` is
//! `range(age, 13, 130)` — so a rule on the wrong type is refused
//! where the annotation is written, and a rule naming a sibling field
//! reads that field's value. A rule on the record itself reads the
//! whole value once every field has passed — the cross-field rules.
//! A `type Name = shape` carrying rules reads its shape, then wraps
//! it: a `Username` is proof it passed. `@secret` on a field is no
//! rule: no issue about it ever shows what it received.
//!
//! `from_json` reads the text directly (json.av): a record takes its
//! keys in the order the text writes them, matched by length then by
//! bytes, reads each field's value where it stands, then settles the
//! fields in declaration order — absence, then each rule — so a rule
//! naming a sibling reads it as the tree path does.
use @std.text.{admits}
use @std.meta.{
    Type,
    Field,
    Kind,
    Annotation,
    Directive,
    Code,
    Decls,
    Stmts,
    name,
    literal,
    applied,
    implements,
}
use decode.{
    Decoding,
    Slot,
    Coercion,
    Limits,
    decode,
    ruled,
    formed,
    list,
    read_text,
    read_int,
    read_float,
    read_bool,
}
use json.{
    decode_json,
    not_yet,
    json_list,
    json_formed,
    json_by_tree,
    ruled_json,
    json_read_text,
    json_read_int,
    json_read_float,
    json_read_bool,
}
use value.{Value, Entry}
use issue.{Issues, root}
use check.{Checking, filed}

export trait Decode {
    static fn derive(t: Type) -> List<Directive> {
        if generic(t) { return [] }
        [Directive { twin: "", name: t.name, at: t.at, source: decoder(t) }]
    }

    /// A record's supplied fields, without defaults or record-level rules.
    /// `projection` writes a Value.Map from the nullable field bindings;
    /// the decoder retains only keys present in the input.
    static fn fields(t: Type, projection: Code) -> List<Directive> {
        [Directive { twin: "", name: t.name, at: t.at, source: field_decoder(t, projection) }]
    }

    /// Every annotation on a field is a rule this derive calls.
    static fn marks(t: Type) -> List<string> {
        flatten([[a.name for a in f.annotations] for f in t.fields])
    }
}

/// `@derive(Checked)` — the type's rules run over a value of it. A
/// generic type, a named shape and an enum have no value to judge
/// field by field, so they derive nothing and `checked` refuses them
/// where it is called.
export trait Checked {
    /// Every issue the value's rules find, each at its field's path.
    fn check() -> Issues

    static fn derive(t: Type) -> List<Directive> {
        if generic(t) || names_a_shape(t) || !t.variants.is_empty() { return [] }
        [Directive { twin: "", name: t.name, at: t.at, source: checker(t) }]
    }

    /// Every annotation on a field is a rule this derive calls.
    static fn marks(t: Type) -> List<string> {
        flatten([[a.name for a in f.annotations] for f in t.fields])
    }
}

/// The `check` of a record: each field's rules over the field as
/// held, then the record's own rules over the whole value. An
/// annotation the compiler handed no call for is no rule — a storage
/// constraint like `@unique` is read by its own derive.
export fn checker(t: Type) -> Decls {
    quote {
        impl Checked for ${t} {
            fn check() -> Issues {
                mut c = Checking {}
                ${[field_check(f) for f in t.fields]}
                let at = root()
                let seen: Value? = null
                let got: ${t}? = self
                ${[judging(a, checking_ruling) for a in rules(t)]}
                c.issues()
            }
        }
    }
}

/// Field decoding shares the complete reader's shapes, rules, and issue paths.
fn field_decoder(t: Type, projection: Code) -> Decls {
    let fields = literal_list([literal(f.name) for f in t.fields])
    quote {
        impl ${t} {
            static fn decode_fields(v: Value, coercion: Coercion = Coercion.Strict, limits: Limits = Limits {}) -> Result<Value, Issues> {
                decode(v, (mut d: Decoding, s: Slot) -> ${name(t.name)}.fields_decoded(d, s), coercion, limits)
            }

            static fn fields_decoded(mut d: Decoding, s: Slot) -> Value? {
                let o? = d.object(s) else { return null }
                ${[field_at(f, projection_slot(f)) for f in t.fields]}
                if !d.closed(o, ${fields}) { return null }
                let projected: Value = ${projection}
                Value.Map([e for e in projected.entries() if o.entries.any(it.key == e.key)])
            }
        }
    }
}

/// A field's rules over its value as held; a nullable field that is
/// null has nothing to judge. What a rule refuses shows what the field
/// held unless it is secret.
fn field_check(f: Field) -> Stmts {
    quote {
        let ${f.name} = {
            let at = root().field(${literal(f.name)})
            let got: ${inner(f.kind).spelled()}? = self.${f.name}
            let seen: Value? = ${shown(f, inner(f.kind))}
            ${[judging(a, checking_ruling) for a in field_rules(f)]}
            got
        }
    }
}

/// The field's value as a `Value`, when it is a scalar a person can
/// read in a report; null for a secret and for any shape that is not.
fn shown(f: Field, k: Kind) -> Code {
    if f.annotations.any(is_secret(it)) { return quote { null } }
    match k {
        .Str -> quote { if got == null { null } else { Value.Text(got!) } },
        .Int -> quote { if got == null { null } else { Value.Int(got!) } },
        .Float -> quote { if got == null { null } else { Value.Float(got!) } },
        .Bool -> quote { if got == null { null } else { Value.Bool(got!) } },
        .Ptr or .Void or .List(_) or .Cell(_) or .Map(_, _) or .Opt(_) or .Result(_, _) or .Fn(_, _) or .Dyn(_) or .Named(_, _) or .Var(_) or .Unspelled(_) -> quote { null },
    }
}

/// A verdict filed at the place the check judged.
fn checking_ruling(rule: Code, call: Code) -> Code { quote { filed(c, at, seen, ${rule}, ${call}) } }

/// The type as another derive reads it: without the annotations that
/// derive CLAIMS (its `marks`) — a storage constraint like `@unique` is
/// no rule, and a derive that bundles this one passes what it owns.
export fn stripped(t: Type, apart: List<string>) -> Type {
    t with { annotations: [a for a in t.annotations if !apart.contains(a.name)], fields: [f with { annotations: [a for a in f.annotations if !apart.contains(a.name)] } for f in t.fields] }
}

/// The type's `decode`/`decoded` over a `Value` and its
/// `from_json`/`read_json` over JSON text, the two shapes every kind
/// of type answers with its own bodies.
export fn decoder(t: Type) -> Decls {
    let b = body(t)
    let j = direct(t)
    quote {
        impl ${t} {
            /// The value read as this type: it, or every issue.
            static fn decode(v: Value, coercion: Coercion = Coercion.Strict, limits: Limits = Limits {}) -> Result<
                ${t},
                Issues,
            > {
                decode(v, (mut d: Decoding, s: Slot) -> ${name(t.name)}.decoded(d, s), coercion, limits)
            }

            /// JSON text read as this type: it, or every issue — what
            /// `decode` answers over the text's `Value`.
            static fn from_json(text: string, coercion: Coercion = Coercion.Strict, limits: Limits = Limits {}) -> Result<
                ${t},
                Issues,
            > {
                decode_json(
                    text,
                    (mut d: Decoding, depth: int, required: bool, secret: bool) -> ${name(t.name)}.read_json(d, depth, required, secret),
                    (mut d: Decoding, s: Slot) -> ${name(t.name)}.decoded(d, s),
                    coercion,
                    limits,
                )
            }

            static fn decoded(mut d: Decoding, s: Slot) -> ${t}? {
                ${b.lines}
                ${b.answer}
            }

            static fn read_json(mut d: Decoding, depth: int, required: bool, secret: bool) -> ${t}? {
                let ${hidden} = secret
                ${j.lines}
                ${j.answer}
            }

            ${keys(t)}
        }
    }
}

/// A decoder's body: what it runs, then what it answers.
type Body = { lines: Stmts, answer: Code }

fn body(t: Type) -> Body {
    if names_a_shape(t) { return named_body(t) }
    if !t.variants.is_empty() { return union_body(t) }
    record_body(t)
}

/// Each field read in its own block, then the record whole.
fn record_body(t: Type) -> Body {
    let fields = literal_list([literal(f.name) for f in t.fields])
    let lines = quote {
        let o? = d.object(s) else { return null }
        ${[field_read(f) for f in t.fields]}
        if !d.closed(o, ${fields}) { return null }
    }
    whole(t, lines, quote { s }, tree_ruling)
}

/// An enum: a union no reader takes yet, one issue naming it.
fn union_body(t: Type) -> Body {
    let answer = quote {
        {
            d.unread(s, ${literal("enum ${t.name}")})
            null
        }
    }
    Body { lines: quote { }, answer: answer }
}

/// A named type: its shape read at the slot, then wrapped.
fn named_body(t: Type) -> Body { wrapping(t, quote { s }, reader(t.over), tree_ruling) }

/// A record once its fields are read: built once, then its own rules
/// over the whole value read from `at`, answering it.
fn whole(t: Type, fields: Stmts, at: Code, ruling: fn(Code, Code) -> Code) -> Body {
    let lines = quote {
        ${fields}
        ${built(t)}
        let at = ${at}
        let got: ${t}? = made
        ${[judging(a, ruling) for a in rules(t)]}
    }
    Body { lines: lines, answer: quote { got } }
}

/// A named type's shape, read from `at` by `read`, its own rules run
/// over it, and the value wrapped in its name.
fn wrapping(t: Type, at: Code, read: Code, ruling: fn(Code, Code) -> Code) -> Body {
    let lines = quote {
        let at = ${at}
        let got: ${t.over.spelled()}? = ${read}
        ${[judging(a, ruling) for a in rules(t)]}
    }
    Body { lines: lines, answer: wrapped(t) }
}

/// A named type's value wrapped in its name, once it passed.
fn wrapped(t: Type) -> Code {
    quote { if got == null { null } else { ${t.name}(got!) } }
}

/// A generic type reads no value until its parameters are known — a
/// decoder over one waits for generic impls to carry it.
fn generic(t: Type) -> bool {
    t.fields.any(mentions_a_parameter(it.kind))
}

fn mentions_a_parameter(k: Kind) -> bool {
    match k {
        .Var(_) -> true,
        .List(inner) or .Opt(inner) or .Cell(inner) -> mentions_a_parameter(inner),
        .Map(key, value) or .Result(key, value) -> mentions_a_parameter(key) || mentions_a_parameter(value),
        .Named(_, args) -> args.any(mentions_a_parameter(it)),
        .Int or .Float or .Bool or .Str or .Ptr or .Void or .Fn(_, _) or .Dyn(_) or .Unspelled(_) -> false,
    }
}

/// A `type Name = shape` — a record or an enum stands over nothing.
fn names_a_shape(t: Type) -> bool {
    match t.over { .Unspelled(_) -> false, rest -> true }
}

/// The type's own rules: every annotation it wears that is called over a
/// value. One run at compile time — a derive, a model — carries no call.
fn rules(t: Type) -> List<Annotation> {
    [a for a in t.annotations if a.call != null]
}

/// `let email = { … }` — the field read at its slot and each of its
/// rules run over what the last one answered.
fn field_read(f: Field) -> Stmts {
    field_at(f, slot(f))
}

fn field_at(f: Field, where: Code) -> Stmts {
    quote {
        let ${f.name} = {
            let at = ${where}
            let got: ${inner(f.kind).spelled()}? = ${reader(inner(f.kind))}
            ${[judging(a, tree_ruling) for a in field_rules(f)]}
            got
        }
    }
}

/// Where a field is read: optional when absent is no issue, secret
/// when an issue must never show what it received.
fn slot(f: Field) -> Code {
    let at = quote { o.field(${literal(f.name)}) }
    let loose = if optional(f) { quote { ${at}.optional() } } else { at }
    hidden_slot(f, loose)
}

/// Missing is permitted; explicit null follows the declared type, not its default.
fn projection_slot(f: Field) -> Code {
    let at = quote { o.field(${literal(f.name)}) }
    let loose = if f.kind is .Opt {
        quote { ${at}.optional() }
    } else {
        quote {
            {
                let at = ${at}
                if at.value == null { at.optional() } else { at }
            }
        }
    }
    hidden_slot(f, loose)
}

fn hidden_slot(f: Field, at: Code) -> Code {
    if f.annotations.any(is_secret(it)) { quote { ${at}.secret() } } else { at }
}

/// `@secret` is no rule: it hides what the field received.
fn is_secret(a: Annotation) -> bool { a.name == "secret" }

/// One rule over the value read so far, recorded where it refuses.
/// The value is bound where the rule's call lands, under a name no
/// program can spell, so the call reads it and every refusal about it
/// points at the annotation.
fn judging(a: Annotation, ruling: fn(Code, Code) -> Code) -> Stmts {
    let call? = applied(a, name(judged)) else { return quote { let got = got } }
    quote {
        let got = if got == null {
            null
        } else {
            let ${judged} = got!
            ${ruling(literal(a.name), call)}
        }
    }
}

/// A verdict recorded at the slot `at` the tree read.
fn tree_ruling(rule: Code, call: Code) -> Code { quote { ruled(d, at, ${rule}, ${call}) } }

/// A verdict recorded at the text position `at` the direct reader
/// read, secret when the value is.
fn json_ruling(rule: Code, call: Code) -> Code { quote { ruled_json(d, at, ${name(hidden)}, ${rule}, ${call}) } }

/// The value a rule judges, as its call reads it.
const judged: string = "judged\$"

/// Whether no issue may show what the value being read received.
const hidden: string = "hidden\$"

/// The reader for a shape at `at`.
fn reader(k: Kind) -> Code {
    match k {
        .Str -> quote { d.text(at) },
        .Int -> quote { d.int(at) },
        .Float -> quote { d.float(at) },
        .Bool -> quote { d.bool(at) },
        .List(elem) -> {
            let each? = element(elem) else { return unread(k) }
            quote { list(d, at, ${each}) }
        },
        .Named(n, _) -> if texted(n) { form_read(n, quote { at }) } else { quote { ${name(n)}.decoded(d, at) } },
        .Opt(k2) -> reader(k2),
        .Ptr or .Void or .Cell(_) or .Map(_, _) or .Result(_, _) or .Fn(_, _) or .Dyn(_) or .Var(_) or .Unspelled(_) -> unread(k),
    }
}

/// A shape no reader takes yet: one issue, and no value.
fn unread(k: Kind) -> Code {
    quote {
        {
            d.unread(at, ${literal(k.spelled())})
            null
        }
    }
}

/// A list element's decoder, as a fn value — absent for an element
/// no reader takes yet.
fn element(k: Kind) -> Code? {
    match k {
        .Str -> quote { read_text },
        .Int -> quote { read_int },
        .Float -> quote { read_float },
        .Bool -> quote { read_bool },
        .Named(n, _) -> if texted(n) {
            quote { (mut d: Decoding, s: Slot) -> ${form_read(n, quote { s })} }
        } else {
            quote {
                (mut d: Decoding, s: Slot) -> {
                    let got: ${k.spelled()}? = ${name(n)}.decoded(d, s)
                    got
                }
            }
        },
        .List(elem) -> {
            let each? = element(elem) else { return null }
            quote { (mut d: Decoding, s: Slot) -> list(d, s, ${each}) }
        },
        .Ptr or .Void or .Cell(_) or .Map(_, _) or .Opt(_) or .Result(_, _) or .Fn(_, _) or .Dyn(_) or .Var(_) or .Unspelled(_) -> null,
    }
}

/// A field a literal must write: its value, present or unwrapped.
fn init(f: Field) -> Code {
    if f.kind is .Opt { return quote { Init { ${f.name}: ${name(f.name)} } } }
    quote { Init { ${f.name}: ${name(f.name)}! } }
}

/// The record, built once: each field as read, and a defaulted field
/// its default when the input left it out — read from a record built
/// without the defaulted fields, when there are any.
fn built(t: Type) -> Stmts {
    let written = [init(f) for f in t.fields if !f.defaulted]
    if written.length == t.fields.length { return quote { let made = ${t} { ..${written} } } }
    quote {
        let ${own("base")} = ${t} { ..${written} }
        let made = ${t} { ..${[if f.defaulted { defaulted(f) } else { init(f) } for f in t.fields]} }
    }
}

/// A defaulted field: what the input held, or the base's default.
fn defaulted(f: Field) -> Code {
    quote { Init { ${f.name}: if ${name(f.name)} == null { ${mine("base")}.${f.name} } else { ${name(f.name)}! } } }
}

/// Absent is no issue: the field is nullable or declares a default.
fn optional(f: Field) -> bool { f.defaulted || f.kind is .Opt }

fn inner(k: Kind) -> Kind {
    match k { .Opt(k2) -> k2, rest -> k }
}

// ── the direct reader ───────────────────────────────────────────

fn direct(t: Type) -> Body {
    if names_a_shape(t) { return named_direct(t) }
    if !t.variants.is_empty() { return union_direct(t) }
    record_direct(t)
}

/// A named type: its shape read where it stands, then wrapped.
fn named_direct(t: Type) -> Body {
    wrapping(
        t,
        quote { d.json.pos },
        reading(t.over, quote { depth }, quote { required }, name(hidden)),
        json_ruling,
    )
}

/// An enum: read the tree's way, which names the one issue.
fn union_direct(t: Type) -> Body {
    let tree = quote { (mut d: Decoding, s: Slot) -> ${name(t.name)}.decoded(d, s) }
    Body {
        lines: quote { },
        answer: quote { json_by_tree(d, depth, required, ${name(hidden)}, ${tree}) },
    }
}

/// A record: each key the text writes matched to its field and the
/// value read where it stands; then every field settled in
/// declaration order, the issues filed in that order, and the
/// record's own rules over the whole value.
fn record_direct(t: Type) -> Body {
    let lines = quote {
        let ${own("start")} = d.json.pos
        if !d.json_object(depth, required, ${name(hidden)}) { return null }
        let ${own("before")} = d.count()
        ${[unread_yet(f) for f in t.fields]}
        mut ${own("entry")} = 0
        mut ${own("more")} = d.json_first(125)
        while ${mine("more")} {
            let ${own("key")} = d.json.pos
            let ${own("key_end")} = d.json_key()
            let ${own("mark")} = d.count()
            let ${own("field")} = ${name(t.name)}.field_at(d, ${mine("key")}, ${mine("key_end")})
            ${taken(t)}
            ${mine("entry")} = ${mine("entry")} + 1
            ${mine("more")} = d.json_next(125)
        }
        if d.json.pos < 0 { return null }
        ${[settled(t, f, i) for i, f in t.fields]}
        d.sorted(${mine("before")})
        if d.count() > ${mine("before")} { return null }
    }
    whole(t, lines, mine("start"), json_ruling)
}

/// A generated local's name, which no program can spell.
fn own(word: string) -> string { "${word}\$" }

/// A generated local, read.
fn mine(word: string) -> Code { name(own(word)) }

/// Where a field's value was read, and what was read: -1 and null
/// until its key is met.
fn unread_yet(f: Field) -> Stmts {
    quote {
        // LICENSED let_stmt.unmutated_mut: `take`'s template writes it, beyond this one's sight
        mut ${own("${f.name}_at")} = -1
        // LICENSED let_stmt.unmutated_mut: `take`'s template writes it, beyond this one's sight
        mut ${own("${f.name}_read")}: ${inner(f.kind).spelled()}? = not_yet()
    }
}

/// The key just read dispatched to its field — each field tried in
/// turn, a key the record does not name last.
fn taken(t: Type) -> Code {
    let entry = quote { ${t.fields.length} + ${mine("entry")} }
    mut chain = quote { d.json_stray(${mine("key")}, ${mine("key_end")}, ${entry}, depth + 1, ${name(t.name)}.field_names()) }
    for i in reversed([i for i in 0..t.fields.length]) {
        chain = quote { if ${mine("field")} == ${i} { ${take(t, t.fields[i], i, entry)} } else { ${chain} } }
    }
    chain
}

/// Field `i` read where its key stands and its rules run over it at
/// once, up to the first that reads a sibling — or a second copy of
/// it refused.
fn take(t: Type, f: Field, i: int, entry: Code) -> Code {
    let at = own("${f.name}_at")
    quote {
        if ${name(at)} >= 0 {
            d.json_repeated(${mine("key")}, ${mine("key_end")}, ${entry}, depth + 1)
        } else {
            let at = d.json.pos
            ${name(at)} = at
            let ${hidden} = ${secret_code(f)}
            let got: ${inner(f.kind).spelled()}? = ${reading(inner(f.kind), quote { depth + 1 }, required_code(f), name(hidden))}
            ${[judging(a, json_ruling) for a in early(t, f)]}
            ${mine("${f.name}_read")} = got
            d.filed(${mine("mark")}, ${i}, ${literal(f.name)})
        }
    }
}

/// `let email = …` — the field as the tree path would have it: absent
/// read the tree's way, present taken as read, then each rule that
/// reads a sibling, all of them settled — every issue filed at the
/// field's place.
fn settled(t: Type, f: Field, i: int) -> Stmts {
    let at = mine("${f.name}_at")
    let rest = late(t, f)
    if rest.is_empty() {
        return quote {
            let ${f.name}: ${inner(f.kind).spelled()}? = if ${at} < 0 {
                let ${own("mark")} = d.count()
                let ${hidden} = ${secret_code(f)}
                let got: ${inner(f.kind).spelled()}? = ${absent(f)}
                d.filed(${mine("mark")}, ${i}, ${literal(f.name)})
                got
            } else {
                ${mine("${f.name}_read")}
            }
        }
    }
    quote {
        let ${f.name} = {
            let ${own("mark")} = d.count()
            let at = ${at}
            let ${hidden} = ${secret_code(f)}
            let got: ${inner(f.kind).spelled()}? = if at < 0 { ${absent(f)} } else { ${mine("${f.name}_read")} }
            ${[judging(a, json_ruling) for a in rest]}
            d.filed(${mine("mark")}, ${i}, ${literal(f.name)})
            got
        }
    }
}

/// A field's rules run where it is read: each up to the first that
/// names a sibling, which must wait until every field is read.
fn early(t: Type, f: Field) -> List<Annotation> {
    [a for j, a in field_rules(f) if j < waits_from(t, field_rules(f))]
}

/// The rest, run once every field is read.
fn late(t: Type, f: Field) -> List<Annotation> {
    [a for j, a in field_rules(f) if j >= waits_from(t, field_rules(f))]
}

/// A field's rules, in the order they run: every annotation it wears
/// but `@secret`.
fn field_rules(f: Field) -> List<Annotation> { [a for a in f.annotations if !is_secret(a)] }

/// Where a field's rules first read a sibling: the index of the first
/// rule an argument of which names a field of `t`.
fn waits_from(t: Type, rules: List<Annotation>) -> int {
    [j for j, a in rules if a.args.any(names_a_field(t, it))].first() ?? rules.length
}

/// Whether an argument's text names a field — the name, standing as a
/// word of its own.
fn names_a_field(t: Type, arg: string) -> bool {
    t.fields.any(mentions(arg, it.name))
}

fn mentions(text: string, word: string) -> bool {
    let b = text.bytes()
    let w = word.bytes()
    mut at = b.index_of(w, 0)
    while at >= 0 {
        let end = at + w.length
        if (at == 0 || b.run(at - 1, word_char) == at - 1) && b.run(end, word_char) == end { return true }
        at = b.index_of(w, at + 1)
    }
    false
}

/// The bytes an identifier is spelled with.
const word_char: Bytes = admits(
    (c) -> c >= 48 && c <= 57 || c >= 65 && c <= 90 || c >= 97 && c <= 122 || c == 95,
)

/// An absent field read the tree's way, so absence says what it says
/// there — required, or nothing.
fn absent(f: Field) -> Code {
    quote {
        {
            let at = Slot { value: null, at: root(), required: ${required_code(f)}, hidden: ${name(hidden)} }
            ${reader(inner(f.kind))}
        }
    }
}

fn required_code(f: Field) -> Code { if optional(f) { quote { false } } else { quote { true } } }

fn secret_code(f: Field) -> Code { if f.annotations.any(is_secret(it)) { quote { true } } else { name(hidden) } }

/// The direct reader for a shape, at `depth`.
fn reading(k: Kind, depth: Code, required: Code, secret: Code) -> Code {
    match k {
        .Str -> quote { d.json_text(${depth}, ${required}, ${secret}) },
        .Int -> quote { d.json_int(${depth}, ${required}, ${secret}) },
        .Float -> quote { d.json_float(${depth}, ${required}, ${secret}) },
        .Bool -> quote { d.json_bool(${depth}, ${required}, ${secret}) },
        .List(elem) -> {
            let each? = json_element(elem) else { return unread_json(k, depth) }
            quote { json_list(d, ${depth}, ${required}, ${secret}, ${each}) }
        },
        .Named(n, _) -> if texted(n) {
            form_read_json(n, depth, required, secret)
        } else {
            quote { ${name(n)}.read_json(d, ${depth}, ${required}, ${secret}) }
        },
        .Opt(k2) -> reading(k2, depth, required, secret),
        .Ptr or .Void or .Cell(_) or .Map(_, _) or .Result(_, _) or .Fn(_, _) or .Dyn(_) or .Var(_) or .Unspelled(_) -> unread_json(k, depth),
    }
}

/// A shape no reader takes yet: the value skipped, one issue, and no
/// value.
fn unread_json(k: Kind, depth: Code) -> Code {
    quote {
        {
            d.json_unread(${depth}, ${literal(k.spelled())})
            null
        }
    }
}

/// Whether a named type crosses as one string: it implements `@std/text`'s `TextForm`.
fn texted(n: string) -> bool { implements(n, "TextForm") }

/// A text-form type read from the tree slot `s`.
fn form_read(n: string, s: Code) -> Code {
    quote { formed(d, ${s}, ${literal("a text that reads as " + n)}, (t: string) -> ${name(n)}.from_text_form(t)) }
}

/// A text-form type read from the JSON cursor.
fn form_read_json(n: string, depth: Code, required: Code, secret: Code) -> Code {
    quote { json_formed(d, ${depth}, ${required}, ${secret}, ${literal("a text that reads as " + n)}, (t: string) -> ${name(n)}.from_text_form(t)) }
}

/// A list element's direct reader, as a fn value — absent for an
/// element with none, whose whole list the tree reads.
fn json_element(k: Kind) -> Code? {
    match k {
        .Str -> quote { json_read_text },
        .Int -> quote { json_read_int },
        .Float -> quote { json_read_float },
        .Bool -> quote { json_read_bool },
        .Named(n, _) -> if texted(n) {
            quote { (mut d: Decoding, depth: int, required: bool, secret: bool) -> ${form_read_json(n, quote { depth }, quote { required }, quote { secret })} }
        } else {
            quote {
                (mut d: Decoding, depth: int, required: bool, secret: bool) -> {
                    let got: ${k.spelled()}? = ${name(n)}.read_json(d, depth, required, secret)
                    got
                }
            }
        },
        .List(elem) -> {
            let each? = json_element(elem) else { return null }
            quote { (mut d: Decoding, depth: int, required: bool, secret: bool) -> json_list(d, depth, required, secret, ${each}) }
        },
        .Ptr or .Void or .Cell(_) or .Map(_, _) or .Opt(_) or .Result(_, _) or .Fn(_, _) or .Dyn(_) or .Var(_) or .Unspelled(_) -> null,
    }
}

/// A record's key matcher and its field names: a key is matched by
/// its length, then by its bytes; an escaped key by its text.
fn keys(t: Type) -> List<Decls> {
    if names_a_shape(t) || !t.variants.is_empty() { return [] }
    let names = literal_list([literal(f.name) for f in t.fields])
    mut chain = escaped_key(t)
    for len in lengths(t) {
        chain = quote { if end - at - 2 == ${len} { ${keyed(t, len)} } else { ${chain} } }
    }
    [
        quote {
            /// The field the key from `at` to `end` names, or -1.
            static fn field_at(d: Decoding, at: int, end: int) -> int { ${chain} }
        },
        quote { static fn field_names() -> List<string> { ${names} } },
    ]
}

/// The distinct lengths of the record's field names.
fn lengths(t: Type) -> List<int> {
    let all = [f.name.length for f in t.fields]
    [len for i, len in all if all.index_of(len) == i]
}

/// The fields of one name length, tried in turn; an escaped key of
/// that length falls to its text.
fn keyed(t: Type, len: int) -> Code {
    mut chain = escaped_key(t)
    for i in reversed([i for i, f in t.fields if f.name.length == len]) {
        chain = quote { if d.key_is(at, ${literal(t.fields[i].name)}) { ${i} } else { ${chain} } }
    }
    chain
}

/// A key its bytes matched to no field: read as text, since an escape
/// may spell a field's name.
fn escaped_key(t: Type) -> Code { quote { d.key_index(at, end, ${name(t.name)}.field_names()) } }

fn reversed(xs: List<int>) -> List<int> { [xs[xs.length - 1 - i] for i in 0..xs.length] }

fn literal_list(items: List<Code>) -> Code {
    quote { [${..items}] }
}

fn flatten<T>(xss: List<List<T>>) -> List<T> {
    mut out: List<T> = []
    for xs in xss { out = out.concat(xs) }
    out
}
