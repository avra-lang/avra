// proves: a field named like a seat of the code the derive writes (`secret`) is read as the
// field's own value: the `let` its name came to by a hole shadows the template's seat from its line
// on, in the direct reader and in the tree's.
use @std.meta.{derive}
use @std.validate.{Decode, from_json}

@derive(Decode)
type W = { depth: int, secret: string = "none" }

fn said(json: string) -> string {
    match W.from_json(json) { .Ok(w) -> "${w.depth} ${w.secret}", .Err(_) -> "refused" }
}

"${said("{\"depth\": 1}")} | ${said("{\"depth\": 2, \"secret\": \"s\"}")}"
