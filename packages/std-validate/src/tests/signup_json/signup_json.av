// proves: §11's Signup read straight from JSON text — `Signup.from_json`
// walks the bytes with no tree between — answers exactly what the tree
// path answers (signup_derived's golden, byte for byte), and a text that
// is not JSON still says why, evaluated and native alike.
use @std.meta.{derive}
use @std.validate.{Decode, Issue, Issues, email, range, length, matches, one_of, pattern, issue}

/// Lowercase letters, digits and inner hyphens.
fn slug(s: string) -> bool {
    !s.starts_with("-") &&
        !s.ends_with("-") &&
        [s.char_code(i) for i in 0..s.length].all(slug_char(it))
}

fn slug_char(c: int) -> bool { c >= 97 && c <= 122 || c >= 48 && c <= 57 || c == 45 }

@derive(Decode)
@length(min: 3, max: 32)
@pattern(slug, "slug")
type Username = string

@derive(Decode)
@one_of(["music", "maths", "code"])
type Interest = string

/// A cross-field rule: a plain fn over the whole record, run once
/// every field has passed.
fn adult_for_pro(s: Signup) -> Result<Signup, Issue> {
    if s.plan == "pro" && s.age < 18 { fail issue("plan", "pro needs an adult") }
    s
}

@derive(Decode)
@adult_for_pro
type Signup = {
    @email email: string,
    @range(13, 130) age: int,
    username: Username,
    @secret @length(min: 12) password: string,
    @secret @matches(password, "password") confirm: string,
    @one_of(["free", "pro"]) plan: string = "free",
    interests: List<Interest> = [],
    referrer: Username? = null,
}

fn submit(label: string, body: string) {
    println("── ${label}")
    let answer = match Signup.from_json(body) {
        .Ok(s) -> "accepted: ${s.username} <${s.email}>, ${s.age}, ${s.plan}, interests: ${s.interests.length}, referred by ${s.referrer ?? Username("nobody")}",
        .Err(e) -> refused(e),
    }
    println(answer)
    println("")
}

fn refused(all: Issues) -> string {
    "refused, ${all.count()} issue${if all.count() == 1 { "" } else { "s" }}:\n${all.report()}"
}

submit(
    "everything wrong at once",
    "{\"email\": \"ada@lovelace\", \"age\": 9, \"username\": \"Ada!\", \"password\": \"correct horse\", \"confirm\": \"correct house\", \"plan\": \"prp\", \"interests\": [\"music\", \"math\"], \"referrer\": \"-x\", \"admin\": true}",
)
submit(
    "a username too short",
    "{\"email\": \"ada@lovelace.dev\", \"age\": 36, \"username\": \"ad\", \"password\": \"correct horse battery\", \"confirm\": \"correct horse battery\"}",
)
submit(
    "every field passes, the record does not",
    "{\"email\": \"ada@lovelace.dev\", \"age\": 15, \"username\": \"ada\", \"password\": \"correct horse battery\", \"confirm\": \"correct horse battery\", \"plan\": \"pro\"}",
)
submit(
    "all well",
    "{\"email\": \"ada@lovelace.dev\", \"age\": 36, \"username\": \"ada-l\", \"password\": \"correct horse battery\", \"confirm\": \"correct horse battery\", \"plan\": \"pro\", \"interests\": [\"code\"], \"referrer\": \"grace\"}",
)
submit("not JSON", "{\"email\": \"ada@lovelace.dev\", \"age\": 036}")
"done"
