// `value()` is `decode`'s inverse: every field kind decode reads, nested
// records, options and named types carried into its tree, secrets
// included — so `T.decode(x.value())` answers `x`.
use @std.meta.{derive}
use @std.validate.{Decode, Value, Entry, range}

@derive(Decode)
@range(1, 9)
type Grade = int

@derive(Decode)
type Inner = { n: int, tag: string = "" }

/// A map no decode reads, written all the same.
@derive(Decode)
type Tally = { scores: Map<string, int> = {} }

@derive(Decode)
type Every = {
    text: string,
    count: int,
    ratio: float,
    on: bool,
    maybe: string? = null,
    there: int? = null,
    many: List<int> = [],
    nested: Inner,
    inners: List<Inner> = [],
    grade: Grade,
    @secret pin: string,
}

fn sample() -> Every {
    Every {
        text: "a",
        count: 2,
        ratio: 0.5,
        on: true,
        there: 7,
        many: [1, 2],
        nested: Inner { n: 3, tag: "t" },
        inners: [Inner { n: 4 }],
        grade: Grade(4),
        pin: "0000",
    }
}

fn entry(v: Value, key: string) -> Value? {
    match v { .Map(entries) -> entries.find(it.key == key)?.value, rest -> null }
}

spec "std/validate — value(), decode's inverse" {
    given "a record of every field kind" {
        then "decodes back to the value it came from" {
            let x = sample()
            match Every.decode(x.value()) {
                .Ok(y) -> y.value().shown() == x.value().shown() &&
                    y.text == "a" &&
                    y.count == 2 &&
                    y.ratio == 0.5 &&
                    y.on &&
                    y.maybe == null &&
                    y.there == 7 &&
                    y.many.length == 2 &&
                    y.nested.tag == "t" &&
                    y.inners[0].n == 4 &&
                    y.grade.of == 4 &&
                    y.pin == "0000",
                .Err(_) -> false,
            }
        }
        then "carries a secret field, which only a view may hide" {
            let pin? = entry(sample().value(), "pin") else { return false }
            pin.shown() == "\"0000\""
        }
        then "writes an absent option as null" {
            let maybe? = entry(sample().value(), "maybe") else { return false }
            maybe is .Null
        }
    }
    given "a map field, which no decode reads" {
        then "is written by its entries" { Tally { scores: {"k": 5} }.value().shown() == "{\"scores\": {\"k\": 5}}" }
    }
    given "a named type" {
        then "is its shape's value" { Grade(3).value().shown() == "3" }
    }
}
