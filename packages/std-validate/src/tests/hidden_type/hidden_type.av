// proves: a field whose type implements `Hidden` reads as `@secret` does — its shape says secret
// and no issue about it shows what it received — while a field of another type still shows it.
use @std.meta.{derive}
use @std.validate.{Decode, Decoding, Slot, Value, Hidden, FieldShape, from_json}

type Token = { text: string }

impl Hidden for Token {}

impl Token {
    static fn decoded(mut d: Decoding, s: Slot) -> Token? {
        let t? = d.text(s.secret()) else { return null }
        Token { text: t }
    }
    fn value() -> Value { Value.Text("<token>") }
}

@derive(Decode)
type Login = { user: string, token: Token }

fn marked(f: FieldShape) -> string { if f.secret { "${f.name}!" } else { f.name } }

let refused = match Login.decode(from_json("{\"user\": 7, \"token\": 8}") catch Value.Null) {
    .Ok(_) -> "read",
    .Err(e) -> e.report(),
}
"${[marked(f) for f in Login.fields()].join(",")}\n${refused}"
