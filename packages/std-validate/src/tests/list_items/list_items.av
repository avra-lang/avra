use @std.meta.{derive}
use @std.validate.{Decode, items}

@derive(Decode)
type ListItemFixture = { title: string }

@derive(Decode)
type ListItemsFixture = { @items(min: 1, max: 2) rows: List<ListItemFixture> }

let count = match ListItemsFixture.from_json("{\"rows\":[{\"title\":\"one\"}]}") {
    .Ok(form) -> form.rows.length,
    .Err(_) -> -1,
}
let refused = ListItemsFixture.from_json("{\"rows\":[]}") is .Err
"${count} ${refused}"
