// A field of a flat record — one field, a scalar — that decodes by no derive of its own is
// its scalar on the wire: read from a number, a text or a flag, wrapped once read, written
// back as the scalar, and refused at the field's own path. A named type over a scalar is one.
use @std.meta.{derive}
use @std.validate.{Decode, Value, Issues, FieldKind, from_json}

type Ratio = { r: float }
type Label = { text: string }
type Count = { n: int }
type Flag = { on: bool }
type Cents = int

/// A flat record that decodes by its own derive keeps its own shape.
@derive(Decode)
type Boxed = { b: int }

@derive(Decode)
type Mix = {
    share: Ratio,
    label: Label,
    count: Count,
    flag: Flag,
    cents: Cents,
    maybe: Ratio? = null,
    many: List<Ratio> = [],
    boxed: Boxed? = null,
}

const whole: string = "{\"share\": 0.5, \"label\": \"\", \"count\": 0, \"flag\": false, \"cents\": 7}"

fn paths(r: Result<Mix, Issues>) -> string {
    match r { .Ok(_) -> "ok", .Err(e) -> [i.path.text() + " " + i.rule for i in e.all].join(", ") }
}

/// A drawn kind's word: a scalar's own, and `other` for the rest.
fn word(k: FieldKind) -> string {
    match k {
        .Text -> "text",
        .Int -> "int",
        .Float -> "float",
        .Bool -> "bool",
        .Record(_) or .Records(_) or .Other(_) -> "other",
    }
}

fn tree(text: string) -> Value { from_json(text) catch Value.Null }

fn shown(r: Result<Mix, Issues>) -> string {
    match r {
        .Ok(m) -> "${m.share.r} [${m.label.text}] ${m.count.n} ${m.flag.on} ${m.cents.of} ${m.maybe == null} ${m.many.length}",
        .Err(_) -> "refused",
    }
}

fn round_trip() -> string {
    match Mix
        .from_json(
            "{\"share\": 0.25, \"label\": \"x\", \"count\": 3, \"flag\": true, \"cents\": 0, \"maybe\": 0.0, \"many\": [1.5]}",
        ) { .Ok(m) -> shown(Mix.decode(m.value())), .Err(_) -> "refused" }
}

spec "std/validate — a flat record field is its scalar" {
    given "JSON text" {
        then "each scalar reads into its record, zero and the empty text included" { shown(Mix.from_json(whole)) == "0.5 [] 0 false 7 true 0" }
        then "a present zero is no null" {
            match Mix
                .from_json(
                    "{\"share\": 0.5, \"label\": \"\", \"count\": 0, \"flag\": false, \"cents\": 7, \"maybe\": 0.0}",
                ) { .Ok(m) -> m.maybe != null && m.maybe!.r == 0.0, .Err(_) -> false }
        }
        then "a list of them reads each element" {
            match Mix
                .from_json(
                    "{\"share\": 0.5, \"label\": \"\", \"count\": 0, \"flag\": false, \"cents\": 7, \"many\": [1.5, 2.5]}",
                ) { .Ok(m) -> m.many.length == 2 && m.many[1].r == 2.5, .Err(_) -> false }
        }
        then "a value of the wrong kind is an issue at its field" {
            paths(
                Mix
                    .from_json(
                        "{\"share\": \"half\", \"label\": \"\", \"count\": 0, \"flag\": false, \"cents\": 7}",
                    ),
            ) == "share type"
        }
        then "a list element of the wrong kind is an issue at its index" {
            paths(
                Mix
                    .from_json(
                        "{\"share\": 0.5, \"label\": \"\", \"count\": 0, \"flag\": false, \"cents\": 7, \"many\": [1.5, \"x\"]}",
                    ),
            ) == "many[1] type"
        }
        then "a missing one is an issue at its field" {
            paths(Mix.from_json("{\"share\": 0.5, \"label\": \"\", \"flag\": false, \"cents\": 7}")) == "count required"
        }
        then "a record in its place is an issue at its field" {
            paths(
                Mix
                    .from_json(
                        "{\"share\": {\"r\": 0.5}, \"label\": \"\", \"count\": 0, \"flag\": false, \"cents\": 7}",
                    ),
            ) == "share type"
        }
        then "one that decodes by its own derive keeps its own shape" {
            match Mix
                .from_json(
                    "{\"share\": 0.5, \"label\": \"\", \"count\": 0, \"flag\": false, \"cents\": 7, \"boxed\": {\"b\": 2}}",
                ) { .Ok(m) -> m.boxed!.b == 2, .Err(_) -> false }
        }
    }
    given "a tree" {
        then "each scalar reads into its record" { shown(Mix.decode(tree(whole))) == "0.5 [] 0 false 7 true 0" }
        then "a list element of the wrong kind is an issue at its index in the tree" {
            paths(
                Mix
                    .decode(
                        tree(
                            "{\"share\": 0.5, \"label\": \"\", \"count\": 0, \"flag\": false, \"cents\": 7, \"many\": [true]}",
                        ),
                    ),
            ) == "many[0] type"
        }
        then "a value of the wrong kind is an issue at its field" {
            paths(
                Mix
                    .decode(
                        tree(
                            "{\"share\": 0.5, \"label\": 1, \"count\": 0, \"flag\": false, \"cents\": 7}",
                        ),
                    ),
            ) == "label type"
        }
    }
    given "a value written back" {
        then "is the scalar, and reads back to the same value" { round_trip() == "0.25 [x] 3 true 0 false 1" }
        then "a field draws as its scalar" {
            [word(f.kind) for f in Mix.fields()].take(5).join(" ") == "float text int bool int"
        }
    }
}
