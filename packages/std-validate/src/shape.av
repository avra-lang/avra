//! A decoded type's fields as a form reads them — `T.fields()`, which
//! `@derive(Decode)` writes from the declaration: each field's name,
//! what it holds, whether a value is owed, and whether it is secret.

/// What a field holds, as an input reads it.
export enum FieldKind {
    Text
    Int
    Float
    Bool
    /// A record of its own, by its fields — a form draws them as a group.
    Record(fields: List<FieldShape>)
    /// A list of records, by its spelling: no fixed fields to draw.
    Records(spelled: string)
    /// Any other type, by its spelling.
    Other(spelled: string)
}

/// One field of a decoded record. `required` is a field with no default
/// that cannot be null — a value the decode owes the caller.
export type FieldShape = { name: string, kind: FieldKind, required: bool, secret: bool }
