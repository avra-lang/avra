//! A scalar decodes as itself, by the same reads a record's field of
//! it takes, so a lone value (a capture, a header) is judged by the
//! one law every field is.
use decode.{Decoding, Limits, Slot, decode, read_bool, read_float, read_int, read_text}
use derive.{Decode}
use formats.{from_json as json_value_of}
use issue.{Issues}
use shape.{FieldShape}
use value.{Coercion, Value}

impl Decode for int {
    static fn decode(v: Value, coercion: Coercion, limits: Limits) -> Result<int, Issues> {
        decode(v, (mut d: Decoding, s: Slot) -> read_int(d, s), coercion, limits)
    }

    static fn fields() -> List<FieldShape> { [] }

    fn value() -> Value { Value.Int(self) }

    static fn from_json(text: string, coercion: Coercion, limits: Limits) -> Result<int, Issues> {
        decode(json_value_of(text)?, (mut d: Decoding, s: Slot) -> read_int(d, s), coercion, limits)
    }
}

impl Decode for float {
    static fn decode(v: Value, coercion: Coercion, limits: Limits) -> Result<float, Issues> {
        decode(v, (mut d: Decoding, s: Slot) -> read_float(d, s), coercion, limits)
    }

    static fn fields() -> List<FieldShape> { [] }

    fn value() -> Value { Value.Float(self) }

    static fn from_json(text: string, coercion: Coercion, limits: Limits) -> Result<float, Issues> {
        decode(
            json_value_of(text)?,
            (mut d: Decoding, s: Slot) -> read_float(d, s),
            coercion,
            limits,
        )
    }
}

