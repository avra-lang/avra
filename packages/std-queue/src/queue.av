//! @std.queue — a declared queue, the home it stands on, and the home
//! that is memory. A `Queue<T>` is a name, its terms and a `Home<T>`:
//! the verbs every home answers, typed in the item, each able to fail
//! as a `HomeError`. The memory home never fails and holds items as
//! values. Its items wait in the carrier's ring; an id set remembers
//! each live item and a lease table remembers who holds it and under
//! which epoch. Delivery
//! is at-least-once: an item is acked, buried, or still held. The two
//! terms a full queue and a busy one argue about are here too and read
//! on the send and take paths: `overflow` says what a full ring does
//! (`park`, `fail`, or one of the drops), and `order` says how many
//! deliveries may stand at once (`fifo` one, `by_key` one per key). A
//! hold past its lease is redelivered with `epoch + 1`, and the old ack
//! answers `false`. Leases and backoffs are timestamps compared here,
//! so expiry is found by the next `take`; no timer row is needed.
use @std.task.{Channel, Ring, Sink, open_channel, ring}
use @std.time.{Duration, ms, now_ms, secs}
use @std.meta.{Diagnostic, refuse}

/// An effect identity. In this home it is data: nothing dedupes.
export type Key = { text: string }

/// One hold on an item: the instant it ends and the epoch a stale ack
/// is refused by.
export type Lease = { at: int, epoch: int }

/// One delivery's handle. `epoch` fences an ack from a hold that has
/// since been redelivered; `attempt` counts handler starts.
export type Delivery<T> = {
    id: string,
    item: T,
    key: Key,
    attempt: int,
    epoch: int,
}

/// An item no handler could settle: the item, the error that failed
/// it, and the queues it passed through.
export type Dead<T, E> = { item: T, error: E, path: List<string> }

/// What a full queue does with the next send. `park` waits for room,
/// `fail` refuses the send, `drop_newest` discards the arriving item,
/// and `drop_oldest`/`latest` discard what waits to keep it — `latest`
/// dropping an item of the same key first, so a key coalesces.
export enum Overflow { park, latest, drop_oldest, drop_newest, fail }

/// The order a queue delivers in: `fifo` is one delivery at a time,
/// strictly in send order; `by_key` lets keys run apart and keeps the
/// order of each key alone.
export enum Order { fifo, by_key }

/// What a queue promises: how much it holds, how long a hold lasts,
/// how many attempts an item gets, the dead letter it fails to, what a
/// full queue does, and the order it delivers in.
export type Terms = {
    capacity: int,
    lease: Duration,
    retries: int,
    dead: string,
    overflow: Overflow,
    order: Order,
}

/// Whether an overflow policy drops an item nothing was told about.
fn drops(o: Overflow) -> bool {
    match o { .latest or .drop_oldest or .drop_newest -> true, .park or .fail -> false }
}

/// An overflow policy as the word a refusal names it by.
fn overflow_word(o: Overflow) -> string {
    match o {
        .park -> "park",
        .latest -> "latest",
        .drop_oldest -> "drop_oldest",
        .drop_newest -> "drop_newest",
        .fail -> "fail",
    }
}

/// Why a home could not answer: it cannot be reached and may be asked
/// again `after`, it refused and says `why`, the item is past the size
/// it keeps, the item's shape is one it does not know, or the caller
/// may not ask.
export enum HomeError {
    Unreachable(after: Duration)
    Refused(why: string)
    TooBig(size: int, max: int)
    Shape(hash: int)
    Denied
}

/// Where a queue's items live: the verbs a queue goes through, typed
/// in the item. `send` answers the item's id, or `null` when the terms
/// turned it away. `take` leases up to that many due items. `began`,
/// `ack`, `release` and `bury` answer `false` once the delivery's hold
/// was lost, a stale epoch among the ways. `release` hands the item
/// out again no sooner than the duration from now. `bury` settles the
/// item only when the fn it is handed took it, as one step. `depth`
/// counts the items still owed a fate.
export type Home<T> = {
    send: fn(T, Key) -> Result<string?, HomeError>,
    take: fn(int) -> Result<List<Delivery<T>>, HomeError>,
    began: fn(Delivery<T>) -> Result<bool, HomeError>,
    ack: fn(Delivery<T>) -> Result<bool, HomeError>,
    release: fn(Delivery<T>, Duration) -> Result<bool, HomeError>,
    bury: fn(Delivery<T>, fn(T) -> bool) -> Result<bool, HomeError>,
    depth: fn() -> Result<int, HomeError>,
}

/// A queue: its name, its terms, and the home its verbs go through.
export type Queue<T> = { name: string, terms: Terms, home: Home<T> }

/// A queue that holds nothing but memory.
export fn open_queue<T>(name: string, terms: Terms) -> Queue<T> {
    Queue { name: name, terms: terms, home: open_memory<T>(terms).home() }
}

impl Queue<T> {
    /// Send one item under `key`, answering its id, or `null` when the
    /// terms turned it away.
    fn send(item: T, key: Key) -> Result<string?, HomeError> {
        (self.home.send)(item, key)
    }

    /// Lease the item due next, or `null` when none may be handed out.
    fn take() -> Result<Delivery<T>?, HomeError> {
        ((self.home.take)(1)?).first()
    }

    /// Count a handler's start against the delivery's attempt. `false`
    /// once the hold was lost.
    fn began(d: Delivery<T>) -> Result<bool, HomeError> {
        (self.home.began)(d)
    }

    /// Settle a delivery; its item is done. `false` once the hold was
    /// lost.
    fn ack(d: Delivery<T>) -> Result<bool, HomeError> {
        (self.home.ack)(d)
    }

    /// Put a delivery back for another attempt, handed out no sooner
    /// than `after` from now. `false` once the hold was lost.
    fn release(d: Delivery<T>, after: Duration) -> Result<bool, HomeError> {
        (self.home.release)(d, after)
    }

    /// How many items the queue still owes a fate.
    fn depth() -> Result<int, HomeError> {
        (self.home.depth)()
    }
}

/// Move a delivery to its dead letter in one step, so it is never in
/// both or neither — and never dropped when the letter refuses it.
/// `false` once the hold was lost, or when the letter refused.
export fn bury<T, E>(q: Queue<T>, d: Delivery<T>, err: E, dead: Sink<Dead<T, E>>) -> Result<
    bool,
    HomeError,
> {
    (q.home.bury)(
        d,
        (item: T) -> dead.send(Dead { item: item, error: err, path: [q.name, q.terms.dead] }),
    )
}

/// Where a live item stands: waiting in the ring, held by a worker,
/// on its way to the dead letter, awaiting redelivery, or settled and
/// its id free to reuse.
enum Stage { Pending, Held, Burying, Retry, Settled }

/// Whether a delivery of an item at this stage is outstanding: the
/// order term waits on it and no other take is handed it.
fn stands(s: Stage) -> bool {
    match s { .Held or .Burying -> true, .Pending or .Retry or .Settled -> false }
}

/// Whether an item keeps its place in the order at `now`: a delivery
/// of it stands, or it was released and is still backing off.
fn holds(s: Stage, ready: int, now: int) -> bool {
    stands(s) || s == Stage.Retry && ready > now
}

/// A live item's bookkeeping. `ready` is the instant a released item
/// may be handed out again.
type Live<T> = { item: T, key: Key, attempt: int, stage: Stage, ready: int }

/// A memory home's answer as any home gives it.
fn kept<V>(v: V) -> Result<V, HomeError> {
    v
}

/// The in-memory home. Held by copy: every table sits behind a `Cell`,
/// so two copies are one home. Its verbs cannot fail and answer plainly;
/// `home` is the same verbs as any home's.
export type Memory<T> = {
    terms: Terms,
    ring: Channel<string>,
    live: Cell<Map<string, Live<T>>>,
    leases: Cell<Map<string, Lease>>,
    free: Ring<string>,
    seq: Cell<int>,
    count: Cell<int>,
}

/// A home that holds nothing but memory.
export fn open_memory<T>(terms: Terms) -> Memory<T> {
    let live: Cell<Map<string, Live<T>>> = Cell.new({})
    let leases: Cell<Map<string, Lease>> = Cell.new({})
    Memory {
        terms: terms,
        ring: open_channel<string>(terms.capacity),
        live: live,
        leases: leases,
        free: ring<string>(0 - 1),
        seq: Cell.new(0),
        count: Cell.new(0),
    }
}

/// A key under no label.
export fn key(text: string) -> Key {
    Key { text: text }
}

impl Key {
    /// A subkey: the same text on every attempt.
    fn at(label: string) -> Key {
        Key { text: "${self.text}/${label}" }
    }
}

impl Memory<T> {
    /// These verbs as any home's.
    fn home() -> Home<T> {
        Home {
            send: (item: T, key: Key) -> kept(self.send(item, key)),
            take: (max: int) -> kept(self.taken(max)),
            began: (d: Delivery<T>) -> kept(self.began(d)),
            ack: (d: Delivery<T>) -> kept(self.ack(d)),
            release: (d: Delivery<T>, after: Duration) -> kept(self.release(d, after)),
            bury: (d: Delivery<T>, inter: fn(T) -> bool) -> kept(self.bury(d, inter)),
            depth: () -> kept(self.depth()),
        }
    }

    /// Send one item under `key`, answering its id once the ring holds
    /// it. A full ring is the `overflow` term's to decide: `park` waits
    /// for room, `fail` answers `null`, `drop_newest` answers the id of
    /// an item the queue never keeps, and `drop_oldest`/`latest` give up
    /// what waits to keep this one. `null` too once the ring is closed.
    fn send(item: T, key: Key) -> string? {
        let id = self.mint()
        if self.terms.overflow == Overflow.park {
            if !self.ring.sink.send(id) {
                self.free.push(id)
                return null
            }
            self.enqueue(id, item, key)
            return id
        }
        match self.ring.sink.post(id) {
            .Taken -> {
                self.enqueue(id, item, key)
                id
            },
            .Ended -> {
                self.free.push(id)
                null
            },
            .Full -> self.full(id, item, key),
        }
    }

    /// Lease up to `max` due items, oldest first.
    fn taken(max: int) -> List<Delivery<T>> {
        mut out: List<Delivery<T>> = []
        while out.length < max {
            let d? = self.take() else { return out }
            out.push(d)
        }
        out
    }

    /// Lease the item due next — one awaiting redelivery first, else the
    /// ring's head — as far as the `order` term allows. `null` when none
    /// is due, or when the one due is held back by a delivery already
    /// standing or an item still backing off.
    fn take() -> Delivery<T>? {
        self.expire()
        self.drain()
        let back = self.waiting()
        if back != null {
            if !self.may_deliver(back!) { return null }
            return self.deliver(back!)
        }
        let head? = self.ring.peek() else { return null }
        if !self.may_deliver(head) { return null }
        let _ = self.ring.source.taken()
        self.deliver(head)
    }

    /// Count a handler's start against the delivery's attempt. `false`
    /// once the hold was lost.
    fn began(d: Delivery<T>) -> bool {
        let h? = self.held(d) else { return false }
        self.live.put(d.id, h with { attempt: h.attempt + 1, stage: Stage.Held })
        true
    }

    /// Settle a delivery; its item is done. `false` once the hold was
    /// lost.
    fn ack(d: Delivery<T>) -> bool {
        let h? = self.held(d) else { return false }
        self.settled(d.id, h)
        true
    }

    /// Put a delivery back for another attempt, handed out no sooner
    /// than `after` from now. `false` once the hold was lost.
    fn release(d: Delivery<T>, after: Duration) -> bool {
        let h? = self.held(d) else { return false }
        self.live.put(d.id, h with { stage: Stage.Retry, ready: now_ms() + after.ms() })
        true
    }

    /// Move a delivery out through `inter`, which hands its item to the
    /// dead letter. The item is reserved while a full letter parks the
    /// send: no lease expires it and no take is handed it until the
    /// letter answers. A letter that refuses gives the hold back.
    /// `false` once the hold was lost.
    fn bury(d: Delivery<T>, inter: fn(T) -> bool) -> bool {
        let h? = self.held(d) else { return false }
        self.live.put(d.id, h with { stage: Stage.Burying })
        if !inter(h.item) {
            self.live.put(d.id, h)
            return false
        }
        self.settled(d.id, h)
        true
    }

    /// How many items the home still owes a fate.
    fn depth() -> int {
        self.count.get()
    }

    // ── The terms ──

    /// A full ring: the overflow term decides what happens to `id`.
    fn full(id: string, item: T, key: Key) -> string? {
        match self.terms.overflow {
            .fail -> {
                self.free.push(id)
                null
            },
            .drop_newest -> id,
            .drop_oldest or .latest -> {
                if self.terms.overflow == Overflow.latest { self.discard_same(key) }
                self.discard_head()
                match self.ring.sink.post(id) {
                    .Taken -> {
                        self.enqueue(id, item, key)
                        id
                    },
                    .Ended or .Full -> {
                        self.free.push(id)
                        null
                    },
                }
            },
            .park -> {
                self.free.push(id)
                null
            },
        }
    }

    /// Record a waiting item and count it.
    fn enqueue(id: string, item: T, key: Key) {
        self.live.put(id, Live { item: item, key: key, attempt: 0, stage: Stage.Pending, ready: 0 })
        self.count.set(self.count.get() + 1)
    }

    /// Give up the ring's oldest waiting item for room: its record is a
    /// tombstone no one is told about, and its id is free once it leaves
    /// the ring.
    fn discard_head() {
        let id? = self.ring.source.taken() else { return }
        let h = self.live.get().get(id)
        if h != null && h!.stage == Stage.Pending {
            self.live.put(id, h! with { stage: Stage.Settled })
            self.count.set(self.count.get() - 1)
        }
        self.free.push(id)
    }

    /// Give up a waiting item of `key`'s own — a `latest` keeps one item
    /// per key, so the newest replaces the one that waits.
    fn discard_same(key: Key) {
        let id? = self.oldest(true, key) else { return }
        let h? = self.live.get().get(id) else { return }
        self.live.put(id, h with { stage: Stage.Settled })
        self.count.set(self.count.get() - 1)
    }

    /// The oldest waiting item, of `like`'s key alone when `same` is set.
    fn oldest(same: bool, like: Key) -> string? {
        for id, h in self.live.get() {
            if h.stage == Stage.Pending && (!same || h.key.text == like.text) { return id }
        }
        null
    }

    /// Whether the order term lets this delivery stand now: `fifo` until
    /// the queue is idle, `by_key` until this one's key is.
    fn may_deliver(id: string) -> bool {
        match self.terms.order {
            .fifo -> !self.any_held(),
            .by_key -> {
                let h? = self.live.get().get(id) else { return true }
                !self.key_held(h.key.text)
            },
        }
    }

    /// Whether any item keeps its place in the order this moment.
    fn any_held() -> bool {
        let now = now_ms()
        for id, h in self.live.get() {
            if holds(h.stage, h.ready, now) { return true }
        }
        false
    }

    /// Whether an item of `k` keeps its place in the order this moment.
    fn key_held(k: string) -> bool {
        let now = now_ms()
        for id, h in self.live.get() {
            if holds(h.stage, h.ready, now) && h.key.text == k { return true }
        }
        false
    }

    /// Drop the ring's leading tombstones — ids a drop gave up. Their ids
    /// are free only once they leave the ring, so `mint` never hands one
    /// out while it waits there.
    fn drain() {
        mut head = self.ring.peek()
        while head != null && self.gone(head!) {
            let _ = self.ring.source.taken()
            self.free.push(head!)
            head = self.ring.peek()
        }
    }

    /// Whether the ring entry `id` names nothing a delivery can take.
    fn gone(id: string) -> bool {
        let h? = self.live.get().get(id) else { return true }
        h.stage == Stage.Settled
    }

    // ── The tables ──

    /// An id no live item holds: one freed by a settle, else the next
    /// in the sequence.
    fn mint() -> string {
        let id = self.free.pop()
        if id != null { return id! }
        let n = self.seq.get()
        self.seq.set(n + 1)
        "${n}"
    }

    /// The live record a delivery may still act on, or absent once its
    /// hold was lost — settled, redelivered to another worker, or past
    /// its lease.
    fn held(d: Delivery<T>) -> Live<T>? {
        let h? = self.live.get().get(d.id) else { return null }
        if h.stage != Stage.Held { return null }
        let l? = self.leases.get().get(d.id) else { return null }
        if l.epoch != d.epoch { return null }
        h
    }

    /// Settle `id`: its item is done and its id may be reused.
    fn settled(id: string, h: Live<T>) {
        self.live.put(id, h with { stage: Stage.Settled })
        self.free.push(id)
        self.count.set(self.count.get() - 1)
    }

    /// Lease `id` again, one epoch on, and hand it out.
    fn deliver(id: string) -> Delivery<T>? {
        let h? = self.live.get().get(id) else { return null }
        let epoch = (self.leases.get().get(id)?.epoch ?? 0) + 1
        self.live.put(id, h with { stage: Stage.Held })
        self.leases.put(id, Lease { at: now_ms() + self.terms.lease.ms(), epoch: epoch })
        Delivery { id: id, item: h.item, key: h.key, attempt: h.attempt, epoch: epoch }
    }

    /// The oldest item due for redelivery, or absent.
    fn waiting() -> string? {
        let now = now_ms()
        for id, h in self.live.get() {
            if h.stage == Stage.Retry && h.ready <= now { return id }
        }
        null
    }

    /// A hold whose lease ran out is free to redeliver. Found here, on
    /// the next `take`; there is no timer row.
    fn expire() {
        let now = now_ms()
        mut due: List<string> = []
        for id, h in self.live.get() {
            if h.stage == Stage.Held {
                let l = self.leases.get().get(id)
                if l != null && l!.at <= now { due.push(id) }
            }
        }
        for id in due {
            let held = self.live.get().get(id)
            if held != null { self.live.put(id, held! with { stage: Stage.Retry }) }
        }
    }
}

/// What a queue promises about how often an item is delivered. FLOW 07
/// implements the memory home, so the promise is the contract the loop
/// keeps: an item is acked, buried, or held, never dropped.
export enum Guarantee { at_most_once, at_least_once, exactly_once }

/// A queue's declaration: the terms an instance states and the events
/// its loop emits. `homed:` is the home it stands on, memory when none
/// is named. The events
/// fire SYNCHRONOUSLY: the loop calls the field where it stands, once,
/// with the value it is handling, and installs no delivery contract of
/// its own.
export component queue<T> {
    name: string = ""
    capacity: int = 1000
    lease: Duration = secs(30)
    delivery: Guarantee = Guarantee.at_least_once
    retries: int = 3
    overflow: Overflow = Overflow.park
    order: Order = Order.fifo
    homed: Home<T>? = null
    state opened: Cell<Queue<T>?> = Cell.new(null)
    on took(d: Delivery<T>)
    on acked(d: Delivery<T>)
    /// The value laws of a queue, over the settings one instance states.
    /// A `check` is the SECOND of three tiers: it reads the field values
    /// of this declaration, and nothing else. It cannot see a TYPE or a
    /// SIGNATURE — whether a handler's answer is a `Result` is the
    /// typer's (`flow.no_fate`), not this fn's — and it cannot judge a
    /// SHAPE no single declaration owns, which a `rule` judges. So the
    /// wire is refused by the typer, the instance by this `check`, and
    /// the cross-cutting shape by a `rule`.
    fn check() -> List<Diagnostic> {
        mut said: List<Diagnostic> = []
        if self.capacity < 1 { said.push(refuse("a queue holds at least one item, and this holds ${self.capacity}")) }
        if self.retries < 0 {
            said
                .push(
                    refuse(
                        "a queue attempts an item at least never, and this attempts ${self.retries}",
                    ),
                )
        }
        if drops(self.overflow) && self.delivery == Guarantee.exactly_once {
            said
                .push(
                    refuse(
                        "a queue that drops on overflow cannot promise exactly once, and this drops with `overflow: ${overflow_word(self.overflow)}`",
                    ),
                )
        }
        said
    }
    fn home() -> Queue<T> {
        let already = self.opened.get()
        if already != null { return already! }
        let fresh = self.opening()
        self.opened.set(fresh)
        fresh
    }
    fn opening() -> Queue<T> {
        let terms = Terms {
            capacity: self.capacity,
            lease: self.lease,
            retries: self.retries,
            dead: "${self.name}/dead",
            overflow: self.overflow,
            order: self.order,
        }
        Queue { name: self.name, terms: terms, home: self.homed ?? open_memory<T>(terms).home() }
    }
}

/// A worker's declaration: the queue it drains and the handler it runs
/// for each delivery, failing in a type of its own. `dead:` is the
/// letter a failed item is buried in; `flow.no_fate` refuses a worker
/// whose handler can fail and names none. `failed` and `buried` fire
/// synchronously, where the loop stands.
export component worker<T, R, E> {
    reads: queue<T>?
    each: fn(Delivery<T>) -> Result<R, E>
    dead: Sink<Dead<T, E>>? = null
    on failed(d: Delivery<T>, e: E)
    on buried(dead: Dead<T, E>)
    /// The value laws of a worker, over the settings one instance states.
    fn check() -> List<Diagnostic> {
        if self.reads?.delivery == Guarantee.exactly_once && self.dead == null {
            return [
                refuse(
                    "a worker whose queue delivers exactly once names a `dead:` letter, and this names none",
                ),
            ]
        }
        []
    }
}

/// Why a drain stopped short: its worker reads no queue, names no dead
/// letter, or the queue's home could not answer.
export enum DrainError { NoQueue, NoLetter, Home(why: HomeError) }

/// Drain a worker's queue: take the oldest item, count the handler's
/// start, run it, and settle the hold — `Ok` acks, `Err` releases for
/// another attempt and buries once the attempts reach the terms. The
/// declared events fire where the loop stands, synchronously. Answers
/// how many items the handler settled.
export fn drain<T, R, E>(w: worker<T, R, E>) -> Result<int, DrainError> {
    let qspec? = w.reads else { return .Err(DrainError.NoQueue) }
    let dead? = w.dead else { return .Err(DrainError.NoLetter) }
    match emptied(w, qspec, dead) { .Ok(n) -> .Ok(n), .Err(e) -> .Err(DrainError.Home(e)) }
}

/// Run `w`'s handler over `qspec` until no item is due.
fn emptied<T, R, E>(w: worker<T, R, E>, qspec: queue<T>, dead: Sink<Dead<T, E>>) -> Result<
    int,
    HomeError,
> {
    let q = qspec.home()
    let each = w.each
    mut settled = 0
    mut d = q.take()?
    while d != null {
        let held = d!
        if qspec.took != null { (qspec.took!)(held) }
        let _ = q.began(held)?
        match each(held) {
            .Ok(_) -> {
                if q.ack(held)? {
                    settled = settled + 1
                    if qspec.acked != null { (qspec.acked!)(held) }
                }
            },
            .Err(e) -> {
                if w.failed != null { (w.failed!)(held, e) }
                if held.attempt + 1 >= qspec.retries {
                    let letter = Dead { item: held.item, error: e, path: [q.name, q.terms.dead] }
                    if bury(q, held, e, dead)? && w.buried != null { (w.buried!)(letter) }
                } else {
                    let _ = q.release(held, ms(0))?
                }
            },
        }
        d = q.take()?
    }
    settled
}
