//! Reading a dead letter in a test: the oldest letter taken and acked.
use queue.{Dead, queue}

/// The oldest letter `q` holds, settled out of it; absent when it holds
/// none or its home did not answer.
export fn first_letter<T, E>(q: queue<Dead<T, E>>) -> Dead<T, E>? {
    let d? = q.home().take() catch null else { return null }
    let _ = q.home().ack(d) catch false
    d.item
}

/// Whether `q` holds a letter.
export fn holds_letter<T, E>(q: queue<Dead<T, E>>) -> bool {
    (q.home().depth() catch 0) > 0
}
