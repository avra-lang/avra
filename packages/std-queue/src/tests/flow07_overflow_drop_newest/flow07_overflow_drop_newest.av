//! proves `overflow: .drop_newest` accepts a full ring's send and drops
//! the arriving item: the waiting one is kept and the queue holds one.
use @std.queue.{queue, key, Dead, Overflow}
use @std.task.{unbounded_channel}
use @std.time.{ms}

type Job = { n: int }

let letters = unbounded_channel<Dead<Job, string>>()
queue<Job> jobs {
    capacity: 1
    lease: ms(60000)
    overflow: Overflow.drop_newest
    dead: letters.sink
}
let _ = jobs.home().send(Job { n: 1 }, key("k"))
let second = jobs.home().send(Job { n: 2 }, key("k"))
let taken = jobs.home().take()
"${second != null} ${taken!.item.n} ${jobs.home().depth()}"
