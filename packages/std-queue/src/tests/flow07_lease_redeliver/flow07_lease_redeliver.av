//! proves a hold past its lease is redelivered with epoch + 1, and the
//! old ack is refused.
use @std.queue.{open_queue, key, Terms}
use @std.time.{ms}

let q = open_queue<string>("jobs", Terms { capacity: 8, lease: ms(0), retries: 3, dead: "failed" })
let _ = q.send("job", key("k"))
let first = q.take()
let second = q.take()
"${first!.epoch} ${second!.epoch} ${q.ack(first!)} ${q.ack(second!)}"
