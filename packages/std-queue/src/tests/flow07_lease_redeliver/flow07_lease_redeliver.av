//! proves a hold past its lease is redelivered with epoch + 1, and the
//! old ack is refused.
use @std.queue.{queue, key}
use @std.time.{ms}

type Job = { n: int }

queue<Job> jobs {
    capacity: 8
    lease: ms(0)
}
let _ = jobs.home().send(Job { n: 1 }, key("k"))
let first = jobs.home().take() catch null
let second = jobs.home().take() catch null
"${first!.epoch} ${second!.epoch} ${jobs.home().ack(first!) catch false} ${jobs.home().ack(second!) catch false}"
