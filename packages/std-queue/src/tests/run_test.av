// The long-lived worker under handlers that stand at once, on the
// suite's virtual clock. Compiled only: the cases park several handlers
// at a time.
use @std.queue.{queue, worker, run, key, Dead, Delivery, DrainError, Order}
use @std.time.{ms, now_ms, secs, sleep}

/// How many handlers stand at once, and the most that ever did.
type Stood = { now: Cell<int>, most: Cell<int> }

fn stood() -> Stood { Stood { now: Cell.new(0), most: Cell.new(0) } }

fn slow(s: Stood, d: Delivery<int>) -> Result<int, string> {
    s.now.set(s.now.get() + 1)
    if s.now.get() > s.most.get() { s.most.set(s.now.get()) }
    sleep(ms(10))
    s.now.set(s.now.get() - 1)
    d.item
}

fn said(r: Result<int, DrainError>) -> string {
    match r { .Ok(n) -> "settled ${n}", .Err(_) -> "failed" }
}

fn settled(r: Result<int, DrainError>) -> int {
    match r { .Ok(n) -> n, .Err(_) -> 0 - 1 }
}
use tests.support.letters.{holds_letter}

/// Nine items of nine keys under three handlers, then nine under a
/// `fifo` queue and the same three.
fn at_once() -> string {
    let apart = stood()
    let line = stood()
    queue<Dead<int, string>> letters {}
    queue<int> keyed { order: Order.by_key }
    queue<int> filed {}
    worker three {
        reads: keyed
        at_once: 3
        each: (d: Delivery<int>) -> slow(apart, d)
        dead: letters
    }
    worker one {
        reads: filed
        at_once: 3
        each: (d: Delivery<int>) -> slow(line, d)
        dead: letters
    }
    for i in 0..9 {
        let _ = keyed.home().send(i, key("k${i}"))
        let _ = filed.home().send(i, key("k${i}"))
    }
    let began = now_ms()
    let a = spawn run(three)
    sleep(ms(25))
    let after_three = keyed.home().depth() catch 0 - 1
    three.stop()
    let b = spawn run(one)
    sleep(ms(95))
    one.stop()
    "by_key most ${apart.most.get()} left ${after_three} ${said(a.await)} | fifo most ${line.most.get()} ${said(b.await)} | ${now_ms() - began} ms"
}

fn bump(counts: Cell<Map<string, int>>, d: Delivery<int>) {
    counts.put("${d.item}", (counts.get().get("${d.item}") ?? 0) + 1)
}

fn work(ran: Cell<Map<string, int>>, d: Delivery<int>) -> Result<int, string> {
    sleep(ms(d.item % 3))
    bump(ran, d)
    d.item
}

/// How many of `counts` are exactly `n`.
fn exactly(counts: Cell<Map<string, int>>, n: int) -> int {
    counts.get().values().filter(it == n).length
}

/// Sixty runs over one queue, each stopped or cancelled a few more
/// turns in than the last. After each, every item not acked is still in
/// the queue. After a stop each is free to be taken at once, and the
/// stop answered the acks its own run made; what a cancel left held
/// comes back when its lease is over, so a handler may run again for an
/// item whose ack the cancel cut, and no item is acked twice.
fn stopped_anywhere() -> string {
    let ran: Cell<Map<string, int>> = Cell.new({})
    let acks: Cell<Map<string, int>> = Cell.new({})
    let acked = Cell.new(0)
    let wrong: Cell<List<string>> = Cell.new([])
    queue<Dead<int, string>> letters {}
    queue<int> jobs {
        lease: ms(50)
        retries: 1000
        order: Order.by_key
        acked: (d: Delivery<int>) -> {
            bump(acks, d)
            acked.set(acked.get() + 1)
        }
    }
    worker crew {
        reads: jobs
        at_once: 3
        each: (d: Delivery<int>) -> work(ran, d)
        dead: letters
    }
    mut sent = 0
    for round in 0..60 {
        for _i in 0..8 {
            let _ = jobs.home().send(sent, key("k${sent}"))
            sent = sent + 1
        }
        let before = acked.get()
        let r = spawn run(crew)
        for _turn in 0..round / 2 { sleep(ms(0)) }
        if round % 4 == 3 { sleep(ms(1)) }
        if round % 2 == 0 {
            crew.stop()
            let answered = settled(r.await)
            if answered != acked.get() - before { wrong.push("round ${round}: answered ${answered}, acked ${acked.get() - before}") }
            sleep(ms(50))
            let free = jobs.home().take_many(1000) catch []
            if free.length != sent - acked.get() { wrong.push("round ${round}: ${free.length} free of ${sent - acked.get()} owed") }
            for d in free { let _ = jobs.home().release(d, ms(0)) }
        } else {
            r.cancel()
            let _ = r.await catch _c -> 0
        }
        let left = jobs.home().depth() catch 0 - 1
        if left != sent - acked.get() { wrong.push("round ${round}: ${left} left of ${sent - acked.get()} owed") }
    }
    let last = spawn run(crew)
    sleep(secs(1))
    crew.stop()
    let _ = last.await
    "sent ${sent} | ran ${ran.get().length} | acked once ${exactly(acks, 1)} | buried ${if holds_letter(letters) { 1 } else { 0 }} | depth ${jobs.home().depth() catch 0 - 1} | ${wrong.get().join("; ")}"
}

spec "std/queue run" {
    given "a worker of three handlers" {
        then "stands three at once over keys apart, one over a fifo queue, and a stop answers what it settled" {
            at_once() == "by_key most 3 left 3 settled 9 | fifo most 1 settled 9 | 120 ms"
        }
    }
    given "a run stopped or cancelled at any turn" {
        then "loses no item and settles none twice" {
            stopped_anywhere() == "sent 480 | ran 480 | acked once 480 | buried 0 | depth 0 | "
        }
    }
}
