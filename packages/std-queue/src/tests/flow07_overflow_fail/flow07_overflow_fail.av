//! proves `overflow: .fail` refuses a full ring's send — `null` — and
//! leaves what waits untouched.
use @std.queue.{queue, key, Overflow}
use @std.time.{ms}

type Job = { n: int }

queue<Job> jobs {
    capacity: 1
    lease: ms(60000)
    overflow: Overflow.fail
}
let _ = jobs.home().send(Job { n: 1 }, key("k"))
let second = jobs.home().send(Job { n: 2 }, key("k")) catch "unanswered"
let taken = jobs.home().take() catch null
"${second == null} ${taken!.item.n}"
