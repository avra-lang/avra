//! proves `order: .fifo` holds the next delivery until the one standing
//! is settled: a second take answers nothing while the first is held.
use @std.queue.{queue, key, Order}
use @std.time.{ms}

type Job = { n: int }

queue<Job> jobs {
    capacity: 4
    lease: ms(60000)
    order: Order.fifo
}
let _ = jobs.home().send(Job { n: 1 }, key("a"))
let _ = jobs.home().send(Job { n: 2 }, key("b"))
let first = jobs.home().take() catch null
let blocked = jobs.home().take() catch null
let acked = jobs.home().ack(first!) catch false
let second = jobs.home().take() catch null
"${blocked == null} ${second!.item.n} ${acked}"
