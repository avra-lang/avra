//! proves a home's failure is the drain's answer: a home that may not
//! be asked stops the loop with its own error, and no handler runs.
use @std.queue.{
    queue,
    worker,
    drain,
    key,
    open_memory,
    Dead,
    Delivery,
    Home,
    HomeError,
    Order,
    Overflow,
    Terms,
}
use @std.time.{ms}

fn denied() -> Result<List<Delivery<int>>, HomeError> { .Err(HomeError.Denied) }

fn shut() -> Home<int>? {
    let made = open_memory<int>(
        Terms {
            capacity: 8,
            lease: ms(60000),
            retries: 2,
            dead: "jobs/dead",
            overflow: Overflow.park,
            order: Order.fifo,
        },
    )
    match made { .Ok(m) -> m.home() with { take: (max: int) -> denied() }, .Err(_) -> null }
}

fn counted(ran: Cell<int>, d: Delivery<int>) -> Result<int, string> {
    ran.set(ran.get() + 1)
    d.item
}

state ran: Cell<int> = Cell.new(0)
queue<Dead<int>> letters {}
queue<int> jobs { homed: shut() }
worker settle {
    reads: jobs
    each: (d: Delivery<int>) -> counted(ran, d)
    dead: letters
}
let sent = jobs.home().send(7, key("k")) catch null
let why = match drain(settle) {
    .Ok(_) -> "drained",
    .Err(.Home(.Denied)) -> "denied",
    .Err(.Home(_)) -> "another home error",
    .Err(.NoQueue) -> "no queue",
    .Err(.NoLetter) -> "no letter",
}
"${sent != null} ${why} ${ran.get()} ${jobs.home().depth() catch 0 - 1}"
