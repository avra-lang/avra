//! proves an acked item is never delivered twice.
use @std.queue.{open_queue, key, Terms}
use @std.time.{ms}

let q = open_queue<string>(
    "jobs",
    Terms { capacity: 8, lease: ms(60000), retries: 3, dead: "failed" },
)
let _ = q.send("job", key("k"))
let d = q.take()
let first = q.ack(d!)
let again = q.take()
"${first} ${again == null} ${q.depth()}"
