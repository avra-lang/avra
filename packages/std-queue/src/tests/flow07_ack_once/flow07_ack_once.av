//! proves an acked item is never delivered twice.
use @std.queue.{queue, key, Dead}
use @std.task.{unbounded_channel}
use @std.time.{ms}

type Job = { n: int }

let letters = unbounded_channel<Dead<Job, string>>()
queue<Job> jobs {
    capacity: 8
    lease: ms(60000)
    dead: letters.sink
}
let _ = jobs.home().send(Job { n: 1 }, key("k"))
let d = jobs.home().take()
let first = jobs.home().ack(d!)
let again = jobs.home().take()
"${first} ${again == null} ${jobs.home().depth()}"
