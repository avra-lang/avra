//! proves an acked item is never delivered twice.
use @std.queue.{queue, key}
use @std.time.{ms}

type Job = { n: int }

queue<Job> jobs {
    capacity: 8
    lease: ms(60000)
}
let _ = jobs.home().send(Job { n: 1 }, key("k"))
let d = jobs.home().take() catch null
let first = jobs.home().ack(d!) catch false
let again = jobs.home().take() catch null
"${first} ${again == null} ${jobs.home().depth() catch 0 - 1}"
