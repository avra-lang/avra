//! proves `overflow: .latest` gives up what waits to keep the newest,
//! so a queue of capacity one never holds more than one.
use @std.queue.{queue, key, Dead, Overflow}
use @std.task.{unbounded_channel}
use @std.time.{ms}

type Job = { n: int }

let letters = unbounded_channel<Dead<Job, string>>()
queue<Job> jobs {
    capacity: 1
    lease: ms(60000)
    overflow: Overflow.latest
    dead: letters.sink
}
let _ = jobs.home().send(Job { n: 1 }, key("k"))
let _ = jobs.home().send(Job { n: 2 }, key("k"))
let taken = jobs.home().take()
"${taken!.item.n} ${jobs.home().depth()}"
