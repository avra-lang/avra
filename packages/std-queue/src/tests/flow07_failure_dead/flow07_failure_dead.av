//! proves a handler that keeps failing is buried once its attempts
//! reach the terms, and the letter carries the error and the path.
use @std.queue.{queue, worker, drain, key, Dead, Delivery, Fate}
use @std.time.{ms}

type Job = { n: int }
type Receipt = { ok: bool }

fn pay(d: Delivery<Job>) -> Result<Receipt, string> { .Err("job ${d.item.n} failed") }

fn why(f: Fate) -> string {
    match f { .Failed(e) -> e, .Unanswered -> "unanswered" }
}

queue<Dead<Job>> letters {}
queue<Job> jobs {
    capacity: 8
    lease: ms(60000)
    retries: 2
}
worker settle {
    reads: jobs
    each: pay
    dead: letters
}
let _ = jobs.home().send(Job { n: 7 }, key("k"))
match drain(settle) {
    .Ok(n) -> {
        let gone = first_letter(letters)
        let g = gone!
        "${n} ${g.item.n} ${why(g.fate)} ${g.path[0]} ${g.path[1]} ${jobs.home().depth() catch 0 - 1}"
    },
    .Err(_) -> "stopped",
}
use tests.support.letters.{first_letter}
