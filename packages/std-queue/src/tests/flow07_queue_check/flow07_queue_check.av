//! proves a queue's `check` states its value laws over the settings: a
//! capacity below one, a negative retries, and exactly-once with no
//! fate. The instances are built from parameters, so the check is read
//! where it stands rather than spoken at a settled instance.
use @std.queue.{queue, Guarantee}

fn said(capacity: int, retries: int, delivery: Guarantee) -> string {
    let a = queue<int> { capacity: capacity }
    let b = queue<int> { retries: retries }
    let c = queue<int> { delivery: delivery }
    "${a.check()[0].message}|${b.check()[0].message}|${c.check()[0].message}"
}
said(0, 0 - 1, Guarantee.exactly_once)
