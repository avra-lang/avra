//! proves the `check`s state their value laws over the settings: a
//! queue's capacity below one, its negative retries, and exactly-once
//! that drops on overflow; and a worker whose queue delivers exactly
//! once and that names no letter. The instances are built from
//! parameters, so the check is read where it stands rather than spoken
//! at a settled instance.
use @std.queue.{queue, worker, Dead, Delivery, Guarantee, Overflow}

fn pay(d: Delivery<int>) -> Result<int, string> { d.item }

fn said(
    capacity: int,
    retries: int,
    delivery: Guarantee,
    overflow: Overflow,
    letter: queue<Dead<int>>?,
) -> string {
    let a = queue<int> { capacity: capacity }
    let b = queue<int> { retries: retries }
    let c = queue<int> { delivery: delivery }
    let d = queue<int> {
        delivery: Guarantee.exactly_once
        overflow: overflow
    }
    let w = worker<int, int, string> {
        reads: c
        each: pay
        dead: letter
    }
    "${a.check()[0].message}|${b.check()[0].message}|${c.check().length}|${w.check()[0].message}|${d.check()[0].message}|${d.check().length}"
}
said(0, 0 - 1, Guarantee.exactly_once, Overflow.latest, null)
