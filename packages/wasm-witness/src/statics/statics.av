// proves: settled aggregates — a const list, map, record, enum and a list
// of records laid out as the binary's own data — read alike on wasm32,
// where a pointer cell is half a word
type Pair = { a: string, b: int }
enum Tone { Low, High(level: int) }

const WORDS: List<string> = ["alpha", "beta", "gamma"]
const AGES: Map<string, int> = { "ada": 36, "alan": 41 }
const PAIRS: List<Pair> = [Pair { a: "left", b: 2 }, Pair { a: "right", b: 3 }]
const TONE: Tone = Tone.High(9)

fn pitch(t: Tone) -> int {
    match t { .Low -> 0, .High(n) -> n }
}

"${WORDS.length} ${WORDS[2]} ${AGES.get("alan") ?? 0} ${PAIRS[1].a} ${PAIRS[0].b} ${pitch(TONE)}"
