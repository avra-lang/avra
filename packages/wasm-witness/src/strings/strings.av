// proves: text verbs agree on wasm32 — length, search, slicing, splitting,
// joining, replacing, numbers read and written
use @std.text.{parse_int}

let s = "wasm32 under node"
let parts = "a,b,,c".split(",")
let n = parse_int("-9223372036854775807") ?? 0
"${s.length} ${s.contains("under")} ${s.index_of("node")} ${s.substring(0, 6)} ${parts.length} ${parts.join("+")} ${s.replace(" ", "_")} ${s.starts_with("wasm")} ${n} ${7.5 * 2.0}"
