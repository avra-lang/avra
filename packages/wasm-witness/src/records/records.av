// proves: records and enums — flat, boxed, nested, with payloads — lay out
// and read alike on wasm32's 32-bit pointers
type Point = { x: int, y: int }
type Named = { name: string, at: Point }
type Id = { n: int }
enum Shape { Dot, Circle(r: int), Label(text: string) }

fn area(s: Shape) -> int {
    match s { .Dot -> 0, .Circle(r) -> 3 * r * r, .Label(t) -> t.length }
}

let p = Named { name: "origin", at: Point { x: 3, y: -4 } }
let moved = p with { at: Point { x: p.at.x + 1, y: p.at.y } }
let shapes = [Shape.Dot, Shape.Circle(2), Shape.Label("wasm")]
"${moved.name} ${moved.at.x} ${moved.at.y} ${Id { n: 7 }.n} ${[area(s) for s in shapes].length} ${area(shapes[1])} ${area(shapes[2])}"
