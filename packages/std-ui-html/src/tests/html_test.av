// Each role's exact HTML, the look as atomic classes, nesting and the
// page. Trees are Node literals, so no component is involved.
use @std.ui.{Node, Role, Setting}
use @std.ui_html.{html, css, page}

fn leaf(r: Role) -> Node { Node { role: r } }

fn muted_body() -> List<Setting> { [Setting.Color(.Muted), .Face(.Body)] }

fn tree() -> Node {
    Node {
        role: .Column,
        look: [Setting.Gap(.M), .Pad(.S)],
        children: [
            leaf(.Heading("Tasks", 1)),
            Node { role: .Row, children: [leaf(.Text("one")), leaf(.Button("Add"))] },
        ],
    }
}

spec "std/ui-html roles" {
    given "each role" {
        then "text is a paragraph" {
            html(leaf(.Text("hi"))) == "<p>hi</p>"
        }
        then "a heading takes its level" {
            html(leaf(.Heading("T", 3))) == "<h3>T</h3>"
        }
        then "a heading level below one is h1" {
            html(leaf(.Heading("T", 0))) == "<h1>T</h1>" &&
                html(leaf(.Heading("T", -4))) == "<h1>T</h1>"
        }
        then "a heading level above six is h6" {
            html(leaf(.Heading("T", 7))) == "<h6>T</h6>" &&
                html(leaf(.Heading("T", 6))) == "<h6>T</h6>"
        }
        then "an image carries src and alt" {
            html(leaf(.Image("/a.png", "A"))) == "<img src=\"/a.png\" alt=\"A\">"
        }
        then "an image with empty alt still carries alt" {
            html(leaf(.Image("/a.png", ""))) == "<img src=\"/a.png\" alt=\"\">"
        }
        then "a link carries href and its label" {
            html(leaf(.Link("go", "https://x.dev/a?b=1&c=2"))) == "<a href=\"https://x.dev/a?b=1&amp;c=2\">go</a>"
        }
        then "a button is a typed button" {
            html(leaf(.Button("Add"))) == "<button type=\"button\">Add</button>"
        }
        then "a toggle that is on is a checked switch" {
            html(leaf(.Toggle("Dark", true))) == "<label><input type=\"checkbox\" role=\"switch\" checked> Dark</label>"
        }
        then "a toggle that is off is an unchecked switch" {
            html(leaf(.Toggle("Dark", false))) == "<label><input type=\"checkbox\" role=\"switch\"> Dark</label>"
        }
        then "a field is a labelled input holding its value" {
            html(leaf(.Field("Name", "Ann"))) == "<label>Name <input type=\"text\" value=\"Ann\"></label>"
        }
        then "a section is a titled region" {
            html(Node { role: .Section("T"), children: [leaf(.Text("x"))] }) == "<section class=\"section\"><h2>T</h2><p>x</p></section>"
        }
        then "an empty section keeps its title" {
            html(leaf(.Section("T"))) == "<section class=\"section\"><h2>T</h2></section>"
        }
        then "a keyed item carries its identity" {
            html(Node { role: .Item, key: "a", children: [leaf(.Text("x"))] }) == "<li data-key=\"a\"><p>x</p></li>"
        }
        then "an unkeyed item carries none" {
            html(leaf(.Item)) == "<li></li>"
        }
        then "an empty key is still a key" {
            html(Node { role: .Item, key: "" }) == "<li data-key=\"\"></li>"
        }
        then "a list holds its items" {
            html(Node { role: .List, children: [Node { role: .Item, key: "a" }, leaf(.Item)] }) == "<ul><li data-key=\"a\"></li><li></li></ul>"
        }
    }
    given "the look" {
        then "settings become atomic classes in order" {
            html(Node { role: .Text("x"), look: muted_body() }) == "<p class=\"color-muted face-body\">x</p>"
        }
        then "every setting names its own class" {
            html(
                Node {
                    role: .Text("x"),
                    look: [
                        Setting.Gap(.None),
                        .Pad(.Xs),
                        .Radius(.L),
                        .Fill(.SurfaceRaised),
                        .Color(.Danger),
                        .Face(.Mono),
                    ],
                },
            ) == "<p class=\"gap-none pad-xs radius-l fill-surface-raised color-danger face-mono\">x</p>"
        }
        then "a column is flex with a structural class first" {
            html(Node { role: .Column, look: [Setting.Gap(.M)] }) == "<div class=\"col gap-m\"></div>"
        }
        then "a row is flex with a structural class first" {
            html(Node { role: .Row, look: [Setting.Pad(.Xl)] }) == "<div class=\"row pad-xl\"></div>"
        }
        then "a section's look follows its structural class" {
            html(Node { role: .Section("T"), look: [Setting.Fill(.Surface)] }) == "<section class=\"section fill-surface\"><h2>T</h2></section>"
        }
    }
    given "nesting" {
        then "an empty column is an empty div" {
            html(leaf(.Column)) == "<div class=\"col\"></div>"
        }
        then "children recurse in order" {
            html(tree()) == "<div class=\"col gap-m pad-s\"><h1>Tasks</h1><div class=\"row\"><p>one</p><button type=\"button\">Add</button></div></div>"
        }
        then "a leaf ignores stray children" {
            html(Node { role: .Text("x"), children: [leaf(.Text("y"))] }) == "<p>x</p>"
        }
    }
    given "the stylesheet" {
        then "it names every size" {
            ["none", "xs", "s", "m", "l", "xl"].all((z) -> css().contains("--size-${z}:"))
        }
        then "it names every tone in both schemes" {
            [
                "text",
                "muted",
                "danger",
                "surface",
                "surface-raised",
                "surface-sunk",
                "surface-hover",
            ]
                .all(
                    (t) -> css().split("prefers-color-scheme: dark")[1].contains("--tone-${t}:") &&
                        css().contains("--tone-${t}:"),
                )
        }
        then "it names every font" {
            ["body", "heading", "footnote", "mono"].all((f) -> css().contains("--font-${f}:"))
        }
        then "column and row are flex" {
            css().contains(".col{display:flex;flex-direction:column}") &&
                css().contains(".row{display:flex;flex-direction:row}")
        }
        then "atomic rules read the variables" {
            css().contains(".gap-m{gap:var(--size-m)}") &&
                css().contains(".fill-surface-raised{background-color:var(--tone-surface-raised)}") &&
                css().contains(".color-muted{color:var(--tone-muted)}") &&
                css().contains(".face-body{font-family:var(--font-body)}") &&
                css().contains(".radius-l{border-radius:var(--size-l)}") &&
                css().contains(".pad-s{padding:var(--size-s)}")
        }
        then "one rule per setting after the four base rules" {
            css().split("\n").length == 2 + 4 + 36
        }
        then "it is deterministic" {
            css() == css() && css().starts_with(":root{ --size-none:0;")
        }
        then "it holds no closing style tag" {
            !css().contains("<")
        }
        then "every class a tree uses has a rule" {
            let used = ["col", "row", "gap-m", "pad-s"]
            used.all((c) -> css().contains(".${c}{"))
        }
    }
    given "the page" {
        then "it is a complete document without script" {
            page("T", leaf(.Text("x"))) == "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>T</title><style>${css()}</style></head><body><p>x</p></body></html>"
        }
        then "it carries no script tag" {
            !page("T", tree()).contains("<script")
        }
    }
}
