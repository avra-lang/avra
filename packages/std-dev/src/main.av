//! The dev server's program. `avra dev` builds it and runs it with what it
//! found: `files` serves a directory as it stands; `page` serves a
//! package's page with the compiler, the wasm triple this machine links
//! and the page glue it was handed. It serves until it is stopped; a
//! page's loop turns on the program's first task and the server answers
//! on another, so a page is served while nothing moves. Started by a
//! process it names (`--keeper`), it ends when that process has, however
//! that one ended.
use @std.cli.{CliResult, Runnable, cli, command, option, flag, arg}
use @std.http.server.{Server, Stateless}
use @std.net.{Listener, listen}
use @std.process.{exit, Exit, tool, cmd}
use @std.text.{parse_int}
use @std.time.{ms, sleep}
use dev.{Served, dev, static_server}

extern fn avra_pid_alive(pid: int) -> int

/// The door the server answers at — or the refusal spoken, naming the
/// address and the way to any free port.
fn door(args: CliResult) -> Listener? {
    match listen(args.option("host"), parse_int(args.option("port")) ?? 0) {
        .Ok(l) -> l,
        .Err(e) -> {
            eprintln("dev: ${e.describe().message} — `--port 0` takes any free port")
            null
        },
    }
}

/// Where a server on `door` is reached.
fn address(args: CliResult, door: Listener) -> string { "http://${args.option("host")}:${door.port}/" }

/// The page opened where the developer browses: the first opener this
/// machine has.
fn opened(url: string) {
    let opener? = [t for name in ["xdg-open", "open"] for t in match tool(name) { .Ok(t) -> [t], .Err(_) -> [] }]
        .first() else {
        return
    }
    let _ = cmd(opener, [url]).outcome()
}

/// `answering` served on a task of its own while this one turns `turn`
/// every `--interval` milliseconds — until the process that started this one
/// has ended, when there is one. `ending` runs before the server stops:
/// what it holds open is let go first.
fn served_while_kept(
    args: CliResult,
    answering: Server<Stateless>,
    at: string,
    turn: fn() -> bool,
    ending: fn() -> void,
) -> int {
    spawn answering.run(1)
    if args.has_flag("open") { opened(at) }
    let pause = ms(parse_int(args.option("interval")) ?? 250)
    let keeper = parse_int(args.option("keeper")) ?? 0
    while keeper == 0 || avra_pid_alive(keeper) != 0 {
        sleep(pause)
        let _ = turn()
    }
    ending()
    answering.stop()
    0
}

fn nothing_held() {}

/// A server with nothing to build turns nothing.
fn idle() -> bool { false }

type ServeFiles = {}

impl Runnable for ServeFiles {
    fn run(args: CliResult) -> int {
        let at? = door(args) else { return 2 }
        println("dev: ${args.arg("root")} at ${address(args, at)}")
        served_while_kept(
            args,
            static_server(at, args.arg("root")),
            address(args, at),
            idle,
            nothing_held,
        )
    }
}

type ServePage = {}

impl Runnable for ServePage {
    fn run(args: CliResult) -> int {
        let compiler = match tool(args.option("compiler")) {
            .Ok(t) -> t,
            .Err(e) -> {
                eprintln("dev: ${e.describe().message}")
                return 2
            },
        }
        let at? = door(args) else { return 2 }
        let made = dev(
            Served {
                compiler: compiler,
                root: args.arg("root"),
                target: args.option("target"),
                glue: args.option("glue"),
            },
        )
        let _ = made.turn()
        println("dev: ${args.arg("root")} at ${address(args, at)}")
        let watches = !args.has_flag("unwatched")
        served_while_kept(
            args,
            made.server(at),
            address(args, at),
            () -> watches && made.turn(),
            () -> made.released(),
        )
    }
}

option compiler { description: "the avra that builds" }

option target { description: "the wasm triple this machine links" }

option glue { description: "the directory the page glue stands in" }

option host { description: "the address to serve at" }

option port { description: "the port to serve on — 0 takes any free one" }

option interval { description: "how often the build's inputs are looked at, in milliseconds" }

option keeper { description: "the process this server serves for: it ends when that one has" }

flag open { description: "open the page in the browser once it is served" }

flag unwatched { description: "build once and serve: nothing is watched" }

arg root {
    description: "the directory or package to serve"
    required: true
}

command files {
    description: "Serve a directory as it stands"
    flags: [open]
    options: [host, port, interval, keeper]
    args: [root]
    run: ServeFiles {}
}

command page {
    description: "Serve one package's page and build it again as its sources change"
    flags: [open, unwatched]
    options: [compiler, target, glue, host, port, interval, keeper]
    args: [root]
    run: ServePage {}
}

cli std_dev {
    description: "The dev server `avra dev` runs"
    version: "0.0.1"
    files
    page
}
exit(Exit.Code(std_dev.run()))
