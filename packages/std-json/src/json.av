//! @std.json — JSON as a value. `parse` reads text into a `Json`;
//! `to_text` writes one back compact, `pretty` with two-space
//! indents. An object keeps its fields in order — a list of `Field`,
//! never a map, so what is written reads back the same. A number
//! spelled as an integer is an `Int`, and one with a fraction or an
//! exponent is a `Float`; RFC 8259's grammar is the whole door, so a
//! leading zero, a bare point and a `+` are refused, and a number
//! past what its kind holds is refused by name rather than rounded to
//! infinity. Strings decode every escape, `\uXXXX` and surrogate
//! pairs included. Every refusal is a `JsonError` that says where.
//! A document nests at most `MAX_DEPTH` deep. `@json`, in the `codec`
//! module, reads a record from a value and writes it back; a misfit is
//! a `DecodeError` naming the path to it.
//!
//! A typed reader walks the text itself through the SCANS (`space`,
//! `plain_end`, `string_end`, `text_of`, `number_end`, `int_end`,
//! `int_of`, `skip`, `value_at`): each answers the position past what
//! it read, or -1 where the text is not JSON. They accept exactly the
//! texts `parse` accepts, so a reader that meets -1 asks `parse` why.
use @std.text.{builder, repeat, from_codepoint, parse_int, parse_float, admits}
use @std.errors.{Error, ErrorInfo, info}

// ── The value ───────────────────────────────────────────────────

export type Field = { key: string, value: Json }

export enum Json {
    Null
    Bool(truth: bool)
    Int(n: int)
    Float(x: float)
    Str(s: string)
    Arr(items: List<Json>)
    Obj(fields: List<Field>)
}

/// One field of an object.
export fn field(key: string, value: Json) -> Field {
    Field { key: key, value: value }
}

impl Json {
    /// The field's value, when this is an object that has it.
    fn get(key: string) -> Json? {
        self.fields().find(it.key == key)?.value
    }

    /// The item at `i`, when this is an array long enough.
    fn at(i: int) -> Json? {
        let items = self.items()
        if i < 0 || i >= items.length { return null }
        items[i]
    }

    /// The field's value, `Null` when absent — so a walk chains:
    /// `doc.member("tags").item(1).int()`.
    fn member(key: string) -> Json {
        self.get(key) ?? Json.Null
    }

    /// The item at `i`, `Null` when there is none — the chaining twin
    /// of `at`.
    fn item(i: int) -> Json {
        self.at(i) ?? Json.Null
    }

    fn text() -> string? {
        match self { .Str(s) -> s, rest -> null }
    }

    fn int() -> int? {
        match self { .Int(n) -> n, rest -> null }
    }

    /// A number spelled with a fraction or an exponent.
    fn float() -> float? {
        match self { .Float(x) -> x, rest -> null }
    }

    fn truth() -> bool? {
        match self { .Bool(b) -> b, rest -> null }
    }

    fn is_null() -> bool {
        self is .Null
    }

    /// An array's items; nothing for any other value.
    fn items() -> List<Json> {
        match self { .Arr(items) -> items, rest -> [] }
    }

    /// An object's fields in order; nothing for any other value.
    fn fields() -> List<Field> {
        match self { .Obj(fields) -> fields, rest -> [] }
    }

    fn keys() -> List<string> {
        [f.key for f in self.fields()]
    }
}

// ── Writing ─────────────────────────────────────────────────────

/// The value as compact JSON text.
export fn to_text(j: Json) -> string {
    match j {
        .Null -> "null",
        .Bool(b) -> if b { "true" } else { "false" },
        .Int(n) -> "${n}",
        .Float(x) -> float_text(x),
        .Str(s) -> quoted(s),
        .Arr(items) -> "[${[to_text(x) for x in items].join(",")}]",
        .Obj(fields) -> "{${[compact_field(f) for f in fields].join(",")}}",
    }
}

/// A float as JSON spells it: the shortest text that reads back as
/// the same float, a `.0` kept so it reads back a `Float`. JSON has
/// no spelling for infinity or NaN, so those write `null`.
fn float_text(x: float) -> string {
    if x - x == 0.0 { "${x}" } else { "null" }
}

fn compact_field(f: Field) -> string {
    "${quoted(f.key)}:${to_text(f.value)}"
}

/// The value as JSON text a person reads: two-space indents, one
/// item or field per line; an empty array or object stays `[]`/`{}`.
export fn pretty(j: Json) -> string {
    indented(j, 0)
}

/// A REGISTRY, not a projection: two arms answer, so every variant is
/// spelled. A catch-all here would route a NEW AGGREGATE to `to_text`
/// and render it compact inside a pretty document, silently — the
/// scalars delegate because for them the two forms agree.
fn indented(j: Json, depth: int) -> string {
    match j {
        .Arr(items) -> block("[", "]", [indented(x, depth + 1) for x in items], depth),
        .Obj(fields) -> block("{", "}", [pretty_field(f, depth + 1) for f in fields], depth),
        .Null or .Bool(_) or .Int(_) or .Float(_) or .Str(_) -> to_text(j),
    }
}

fn pretty_field(f: Field, depth: int) -> string {
    "${quoted(f.key)}: ${indented(f.value, depth)}"
}

/// A bracketed block: each row on its own line one level in, the
/// closer back at this level — or the bare brackets for no rows.
fn block(open: string, close: string, rows: List<string>, depth: int) -> string {
    if rows.is_empty() { return open + close }
    let inner = repeat("  ", depth + 1)
    "${open}\n${[inner + r for r in rows].join(",\n")}\n${repeat("  ", depth)}${close}"
}

/// A string as JSON spells it: quoted, the two that must be escaped
/// and the named controls as their letters, other controls as
/// `\u00XX`, everything else as itself.
fn quoted(s: string) -> string {
    "\"" + [escaped(s.char_code(i), s.substring(i, i + 1)) for i in 0..s.length].join("") + "\""
}

fn escaped(c: int, raw: string) -> string {
    when {
        c == 34 -> "\\\""
        c == 92 -> "\\\\"
        c == 10 -> "\\n"
        c == 13 -> "\\r"
        c == 9 -> "\\t"
        c == 8 -> "\\b"
        c == 12 -> "\\f"
        c < 32 -> "\\u00${hex_byte(c)}"
        _ -> raw
    }
}

fn hex_byte(c: int) -> string {
    "${hex_digit(c / 16)}${hex_digit(c % 16)}"
}

fn hex_digit(d: int) -> string {
    "0123456789abcdef".substring(d, d + 1)
}

// ── Refusals ────────────────────────────────────────────────────

/// Why text is not JSON, and where — a byte offset.
export enum JsonError {
    Unexpected(at: int, found: string)
    Unterminated(at: int)
    BadEscape(at: int)
    LeadingZero(at: int)
    Trailing(at: int)
    Overflow(at: int)
    PastFloat(at: int)
    TooDeep(at: int)
}

impl Error for JsonError {
    fn describe() -> ErrorInfo {
        match self {
            .Unexpected(at, found) -> info("json.unexpected", "unexpected ${found} at byte ${at}"),
            .Unterminated(at) -> info("json.unterminated", "the string opened at byte ${at} never closes"),
            .BadEscape(at) -> info("json.bad_escape", "the escape at byte ${at} names nothing"),
            .LeadingZero(at) -> info("json.leading_zero", "the number at byte ${at} has a leading zero"),
            .Trailing(at) -> info("json.trailing", "text goes on past the value, at byte ${at}"),
            .Overflow(at) -> info("json.overflow", "the integer at byte ${at} does not fit an int"),
            .PastFloat(at) -> info("json.past_float", "the number at byte ${at} is past the largest float"),
            .TooDeep(at) -> info(
                "json.too_deep",
                "the value at byte ${at} nests deeper than ${MAX_DEPTH} arrays and objects",
            ),
        }
    }
}

// ── Decoding into a type ─────────────────────────────────────────

/// Why a JSON value is not the type asked of it, and where: `at` is
/// the path from the document's root (`items[2].name`), empty for the
/// root itself.
export type DecodeError = { at: string, wanted: string, found: string }

/// What reads a value as a `T` — a record's `from_json` under `@json`.
export alias Decoder<T> = fn(Json) -> Result<T, DecodeError>

impl Error for DecodeError {
    fn describe() -> ErrorInfo {
        info("json.decode", "${where_said(self.at)} wants ${self.wanted}, found ${self.found}")
    }
}

fn where_said(at: string) -> string {
    if at.is_empty() { "the document" } else { "`${at}`" }
}

/// The path to a field under `at`.
export fn path_field(at: string, key: string) -> string {
    if at.is_empty() { key } else { "${at}.${key}" }
}

/// The path to an item under `at`.
export fn path_item(at: string, i: int) -> string { "${at}[${i}]" }

/// What a value is, in the words a refusal says it with. A REGISTRY:
/// every variant answers.
fn kind_said(v: Json?) -> string {
    let j? = v else { return "nothing" }
    match j {
        .Null -> "null",
        .Bool(b) -> "`${b}`",
        .Int(n) -> "the number ${n}",
        .Float(x) -> "the number ${float_text(x)}",
        .Str(_) -> "text",
        .Arr(_) -> "an array",
        .Obj(_) -> "an object",
    }
}

fn misfit(at: string, wanted: string, v: Json?) -> DecodeError {
    DecodeError { at: at, wanted: wanted, found: kind_said(v) }
}

/// The value unless it is absent or `null` — what an optional seat
/// reads.
export fn present(v: Json?) -> Json? {
    let j? = v else { return null }
    if j.is_null() { null } else { j }
}

export fn want_int(v: Json?, at: string) -> Result<int, DecodeError> {
    let n? = v?.int() else { fail misfit(at, "an integer", v) }
    n
}

/// A float, or an integer read as the float nearest it.
export fn want_float(v: Json?, at: string) -> Result<float, DecodeError> {
    let j? = v else { fail misfit(at, "a number", v) }
    match j {
        .Float(x) -> x,
        .Int(n) -> parse_float("${n}")!,
        rest -> { fail misfit(at, "a number", j) },
    }
}

export fn want_text(v: Json?, at: string) -> Result<string, DecodeError> {
    let s? = v?.text() else { fail misfit(at, "text", v) }
    s
}

export fn want_bool(v: Json?, at: string) -> Result<bool, DecodeError> {
    let b? = v?.truth() else { fail misfit(at, "`true` or `false`", v) }
    b
}

/// An array's items.
export fn want_items(v: Json?, at: string) -> Result<List<Json>, DecodeError> {
    let j? = v else { fail misfit(at, "an array", v) }
    match j { .Arr(items) -> items, rest -> { fail misfit(at, "an array", j) } }
}

/// THE MEMBER `key` OF AN OBJECT, ONCE: absent when missing, refused
/// when named twice. RFC 8259 leaves a duplicate's meaning to the
/// reader, and readers disagree — JavaScript takes the last, `get` the
/// first — so a record read from a document another reader also
/// judges would mean two things. A decoder takes neither.
export fn member_once(o: Json, key: string, at: string) -> Result<Json?, DecodeError> {
    let named = [f.value for f in o.fields() if f.key == key]
    if named.length > 1 { fail DecodeError { at: at, wanted: "one member", found: "${named.length}" } }
    named.first()
}

/// An object, as itself.
export fn want_object(v: Json?, at: string) -> Result<Json, DecodeError> {
    let j? = v else { fail misfit(at, "an object", v) }
    match j { .Obj(_) -> j, rest -> { fail misfit(at, "an object", j) } }
}

// ── Reading ─────────────────────────────────────────────────────

/// One scan's answer: the value and where the text goes on, or the
/// refusal.
enum Scan {
    Value(j: Json, next: int)
    Refused(e: JsonError)
}

/// The text as one JSON value, whitespace around it allowed.
export fn parse(text: string) -> Result<Json, JsonError> {
    let n = text.length
    match scan_value(text, n, skip_space(text, n, 0), 0) {
        .Refused(e) -> { fail e },
        .Value(j, next) -> {
            let end = skip_space(text, n, next)
            if end < n { fail JsonError.Trailing(end) }
            j
        },
    }
}

/// THE DEEPEST A DOCUMENT NESTS. The reader descends one call per
/// level, so an unbounded depth is a stack an untrusted body sizes —
/// a request of `[` repeated overflows a task's stack and takes the
/// process with it. RFC 8259 §9 lets a reader set this limit.
export const MAX_DEPTH: int = 512

/// The value at `i`, `depth` arrays and objects in.
fn scan_value(text: string, n: int, i: int, depth: int) -> Scan {
    if i >= n { return Scan.Refused(JsonError.Unexpected(i, "the end of the text")) }
    let c = text.char_code(i)
    if (c == 123 || c == 91) && depth >= MAX_DEPTH { return Scan.Refused(JsonError.TooDeep(i)) }
    when {
        c == 123 -> scan_object(text, n, i, depth + 1)
        c == 91 -> scan_array(text, n, i, depth + 1)
        c == 34 -> scan_string(text, n, i)
        c == 45 || is_digit(c) -> scan_number(text, n, i)
        is_letter(c) -> scan_word(text, n, i)
        _ -> Scan.Refused(JsonError.Unexpected(i, quoted(text.substring(i, i + 1))))
    }
}

/// `{` fields `}` — each a string key, `:`, a value; `,` between.
fn scan_object(text: string, n: int, i: int, depth: int) -> Scan {
    mut fields: List<Field> = []
    mut j = skip_space(text, n, i + 1)
    if at(text, n, j, 125) { return Scan.Value(Json.Obj([]), j + 1) }
    while true {
        if !at(text, n, j, 34) { return Scan.Refused(unexpected(text, n, j, "a field's name in quotes")) }
        let key = match scan_string(text, n, j) {
            .Refused(e) -> { return Scan.Refused(e) },
            .Value(k, next) -> {
                j = skip_space(text, n, next)
                k.text() ?? ""
            },
        }
        if !at(text, n, j, 58) { return Scan.Refused(unexpected(text, n, j, "`:` after the field's name")) }
        match scan_value(text, n, skip_space(text, n, j + 1), depth) {
            .Refused(e) -> { return Scan.Refused(e) },
            .Value(v, next) -> {
                fields.push(field(key, v))
                j = skip_space(text, n, next)
            },
        }
        if at(text, n, j, 125) { return Scan.Value(Json.Obj(fields), j + 1) }
        if !at(text, n, j, 44) { return Scan.Refused(unexpected(text, n, j, "`,` or `}`")) }
        j = skip_space(text, n, j + 1)
    }
    Scan.Refused(JsonError.Unterminated(i))
}

/// `[` values `]` — `,` between.
fn scan_array(text: string, n: int, i: int, depth: int) -> Scan {
    mut items: List<Json> = []
    mut j = skip_space(text, n, i + 1)
    if at(text, n, j, 93) { return Scan.Value(Json.Arr([]), j + 1) }
    while true {
        match scan_value(text, n, j, depth) {
            .Refused(e) -> { return Scan.Refused(e) },
            .Value(v, next) -> {
                items.push(v)
                j = skip_space(text, n, next)
            },
        }
        if at(text, n, j, 93) { return Scan.Value(Json.Arr(items), j + 1) }
        if !at(text, n, j, 44) { return Scan.Refused(unexpected(text, n, j, "`,` or `]`")) }
        j = skip_space(text, n, j + 1)
    }
    Scan.Refused(JsonError.Unterminated(i))
}

/// A quoted string: runs copied whole, escapes decoded — `\uXXXX`
/// as its code point, a surrogate pair as one.
fn scan_string(text: string, n: int, i: int) -> Scan {
    mut out = builder()
    mut run = i + 1
    mut j = i + 1
    while j < n {
        let c = text.char_code(j)
        if c == 34 {
            out.push(text.substring(run, j))
            return Scan.Value(Json.Str(out.built()), j + 1)
        }
        if c < 32 { return Scan.Refused(JsonError.Unexpected(j, "a control character inside a string")) }
        if c == 92 {
            out.push(text.substring(run, j))
            match scan_escape(text, n, j) {
                .Refused(e) -> { return Scan.Refused(e) },
                .Value(piece, next) -> {
                    out.push(piece.text() ?? "")
                    j = next
                    run = next
                },
            }
        } else {
            j = j + 1
        }
    }
    Scan.Refused(JsonError.Unterminated(i))
}

/// The escape at `j` (the backslash): its text and where it ends.
fn scan_escape(text: string, n: int, j: int) -> Scan {
    if j + 1 >= n { return Scan.Refused(JsonError.BadEscape(j)) }
    let e = text.char_code(j + 1)
    if e == 117 { return scan_unicode(text, n, j) }
    let piece? = simple_escape(e) else { return Scan.Refused(JsonError.BadEscape(j)) }
    Scan.Value(Json.Str(piece), j + 2)
}

fn simple_escape(e: int) -> string? {
    when {
        e == 34 -> "\""
        e == 92 -> "\\"
        e == 47 -> "/"
        e == 98 -> from_codepoint(8)
        e == 102 -> from_codepoint(12)
        e == 110 -> "\n"
        e == 114 -> "\r"
        e == 116 -> "\t"
        _ -> null
    }
}

/// `\uXXXX`, and a high surrogate followed by `\uXXXX` low as one
/// code point.
fn scan_unicode(text: string, n: int, j: int) -> Scan {
    let code? = hex4(text, n, j + 2) else { return Scan.Refused(JsonError.BadEscape(j)) }
    if code >= 55296 && code < 56320 && at(text, n, j + 6, 92) && at(text, n, j + 7, 117) {
        let low: int? = hex4(text, n, j + 8)
        if low != null {
            let tail = low!
            if tail >= 56320 && tail < 57344 {
                return Scan
                    .Value(
                        Json.Str(from_codepoint(65536 + (code - 55296) * 1024 + (tail - 56320))),
                        j + 12,
                    )
            }
        }
    }
    Scan.Value(Json.Str(from_codepoint(code)), j + 6)
}

/// Four hex digits at `i`, as a number; null when they are not there.
fn hex4(text: string, n: int, i: int) -> int? {
    if i + 4 > n { return null }
    mut v = 0
    mut k = 0
    while k < 4 {
        let d? = hex_value(text.char_code(i + k)) else { return null }
        v = v * 16 + d
        k = k + 1
    }
    v
}

fn hex_value(c: int) -> int? {
    when {
        is_digit(c) -> c - 48
        c >= 97 && c <= 102 -> c - 87
        c >= 65 && c <= 70 -> c - 55
        _ -> null
    }
}

/// RFC 8259's number: `-`? an integer part with no leading zero, then
/// `.` digits and an exponent each optional. Without either it is an
/// `Int`, refused past the ceiling; with one it is a `Float`, refused
/// past the largest float.
fn scan_number(text: string, n: int, i: int) -> Scan {
    mut j = i
    if at(text, n, j, 45) { j = j + 1 }
    let whole = digits_end(text, n, j)
    if whole == j { return Scan.Refused(unexpected(text, n, j, "a digit")) }
    if at(text, n, j, 48) && whole > j + 1 { return Scan.Refused(JsonError.LeadingZero(i)) }
    j = whole
    if at(text, n, j, 46) {
        let frac = digits_end(text, n, j + 1)
        if frac == j + 1 { return Scan.Refused(unexpected(text, n, j + 1, "a digit after the point")) }
        j = frac
    }
    if at(text, n, j, 101) || at(text, n, j, 69) {
        j = j + 1
        if at(text, n, j, 43) || at(text, n, j, 45) { j = j + 1 }
        let exp = digits_end(text, n, j)
        if exp == j { return Scan.Refused(unexpected(text, n, j, "a digit in the exponent")) }
        j = exp
    }
    let spelled = text.substring(i, j)
    if j == whole {
        let v? = parse_int(spelled) else { return Scan.Refused(JsonError.Overflow(i)) }
        return Scan.Value(Json.Int(v), j)
    }
    let x? = parse_float(spelled) else { return Scan.Refused(JsonError.PastFloat(i)) }
    Scan.Value(Json.Float(x), j)
}

/// Where the run of digits starting at `i` ends.
fn digits_end(text: string, n: int, i: int) -> int {
    mut j = i
    while j < n && is_digit(text.char_code(j)) { j = j + 1 }
    j
}

/// The value at `at` of text `parse` accepts — what a typed reader
/// shows of a value it refused.
export fn value_at(text: string, at: int) -> Json {
    match scan_value(text, text.length, at, 0) {
        .Value(j, _next) -> j,
        .Refused(_e) -> Json.Null,
    }
}

/// `true`, `false` or `null` — any other word is unexpected.
fn scan_word(text: string, n: int, i: int) -> Scan {
    mut j = i
    while j < n && is_letter(text.char_code(j)) { j = j + 1 }
    let word = text.substring(i, j)
    when {
        word == "true" -> Scan.Value(Json.Bool(true), j)
        word == "false" -> Scan.Value(Json.Bool(false), j)
        word == "null" -> Scan.Value(Json.Null, j)
        _ -> Scan.Refused(JsonError.Unexpected(i, "`${word}`"))
    }
}

/// The unexpected byte at `i` named — or the end of the text.
fn unexpected(text: string, n: int, i: int, wanted: string) -> JsonError {
    if i >= n { return JsonError.Unexpected(i, "the end of the text, wanting ${wanted}") }
    JsonError.Unexpected(i, "${quoted(text.substring(i, i + 1))}, wanting ${wanted}")
}

fn skip_space(text: string, n: int, i: int) -> int {
    mut j = i
    while j < n && is_space(text.char_code(j)) { j = j + 1 }
    j
}

fn at(text: string, n: int, i: int, code: int) -> bool {
    i < n && text.char_code(i) == code
}

fn is_space(c: int) -> bool { c == 32 || c == 9 || c == 10 || c == 13 }
fn is_digit(c: int) -> bool { c >= 48 && c <= 57 }
fn is_letter(c: int) -> bool { c >= 97 && c <= 122 }

// ── Scanning ────────────────────────────────────────────────────

/// A string's bytes that need no second look: not the quote, not a
/// backslash, not a control character.
fn is_plain(c: int) -> bool { c >= 32 && c != 34 && c != 92 }

const plain: Bytes = admits(is_plain)
const spaces: Bytes = admits(is_space)
const digits: Bytes = admits(is_digit)
const letters: Bytes = admits(is_letter)

/// Past the whitespace at `i`.
export fn space(b: Bytes, i: int) -> int { b.run(i, spaces) }

/// Past the string whose quote is at `i` when it holds no escape —
/// its text is then the bytes between the quotes; -1 otherwise.
export fn plain_end(b: Bytes, i: int) -> int {
    let j = b.run(i + 1, plain)
    if j < b.length && b.at(j) == 34 { j + 1 } else { -1 }
}

/// Past the string whose quote is at `i`; -1 when it is not one.
export fn string_end(b: Bytes, i: int) -> int {
    mut j = i + 1
    while j < b.length {
        j = b.run(j, plain)
        if j >= b.length { return -1 }
        let c = b.at(j)
        if c == 34 { return j + 1 }
        if c < 32 { return -1 }
        j = escape_end(b, j)
        if j < 0 { return -1 }
    }
    -1
}

/// Past the escape whose backslash is at `j`; -1 when it names
/// nothing.
fn escape_end(b: Bytes, j: int) -> int {
    if j + 1 >= b.length { return -1 }
    let e = b.at(j + 1)
    if e != 117 { return if simple_escape(e) == null { -1 } else { j + 2 } }
    if j + 6 > b.length || b.run(j + 2, hex) < j + 6 { -1 } else { j + 6 }
}

const hex: Bytes = admits(is_hex)

fn is_hex(c: int) -> bool { hex_value(c) != null }

/// The text of the string from `i` to `end`, its escapes decoded.
export fn text_of(text: string, b: Bytes, i: int, end: int) -> string {
    if b.run(i + 1, plain) == end - 1 { return text.substring(i + 1, end - 1) }
    match scan_string(text, b.length, i) { .Value(j, _next) -> j.text() ?? "", .Refused(_e) -> "" }
}

/// Past the number at `i` as `parse` reads it — `-`? an integer part
/// with no leading zero, then a fraction and an exponent each
/// optional — or -1 where there is none, or it is past what its kind
/// holds.
export fn number_end(b: Bytes, i: int) -> int {
    let from = if i < b.length && b.at(i) == 45 { i + 1 } else { i }
    let whole = b.run(from, digits)
    if whole == from || b.at(from) == 48 && whole > from + 1 { return -1 }
    let point = if whole < b.length && b.at(whole) == 46 { b.run(whole + 1, digits) } else { whole }
    if point == whole + 1 { return -1 }
    let e = if point < b.length && (b.at(point) == 101 || b.at(point) == 69) { point + 1 } else { point }
    let signed = if e > point && e < b.length && (b.at(e) == 43 || b.at(e) == 45) { e + 1 } else { e }
    let end = if e > point { b.run(signed, digits) } else { point }
    if e > point && end == signed { return -1 }
    if end == whole { return if whole - from < 19 || fits(b, i, end) { end } else { -1 } }
    let t? = b.slice(i, end).text() else { return -1 }
    if parse_float(t) == null { -1 } else { end }
}

/// Past the integer at `i` — a number with no fraction and no
/// exponent; -1 for any other.
export fn int_end(b: Bytes, i: int) -> int {
    let end = number_end(b, i)
    if end < 0 || b.run(if b.at(i) == 45 { i + 1 } else { i }, digits) != end { -1 } else { end }
}

/// Nineteen digits or more: whether they fit, as `parse_int` reads
/// them.
fn fits(b: Bytes, i: int, j: int) -> bool {
    let t? = b.slice(i, j).text() else { return false }
    parse_int(t) != null
}

/// The integer from `i` to `end`, which `int_end` passed.
export fn int_of(text: string, b: Bytes, i: int, end: int) -> int {
    let negative = b.at(i) == 45
    let from = if negative { i + 1 } else { i }
    if end - from >= 19 { return parse_int(text.substring(i, end)) ?? 0 }
    mut v = 0
    for k in from..end { v = v * 10 + b.at(k) - 48 }
    if negative { 0 - v } else { v }
}

/// Past the one value at `i`, arrays and objects nested no deeper
/// than `room` more levels — `MAX_DEPTH` less the depth `i` stands
/// at; -1 where the text is not JSON.
export fn skip(b: Bytes, i: int, room: int) -> int {
    if i >= b.length { return -1 }
    let c = b.at(i)
    when {
        c == 34 -> string_end(b, i)
        c == 45 || is_digit(c) -> number_end(b, i)
        c == 123 || c == 91 -> if room <= 0 { -1 } else { skip_items(b, i, room - 1) }
        is_letter(c) -> word_end(b, i)
        _ -> -1
    }
}

/// Past `[` values `]` or `{` fields `}`, the opener at `i`.
fn skip_items(b: Bytes, i: int, room: int) -> int {
    let object = b.at(i) == 123
    let close = if object { 125 } else { 93 }
    mut j = space(b, i + 1)
    if j < b.length && b.at(j) == close { return j + 1 }
    while j >= 0 {
        if object {
            if j >= b.length || b.at(j) != 34 { return -1 }
            let key_end = string_end(b, j)
            if key_end < 0 { return -1 }
            j = space(b, key_end)
            if j >= b.length || b.at(j) != 58 { return -1 }
            j = space(b, j + 1)
        }
        j = skip(b, j, room)
        if j < 0 { return -1 }
        j = space(b, j)
        if j >= b.length { return -1 }
        if b.at(j) == close { return j + 1 }
        if b.at(j) != 44 { return -1 }
        j = space(b, j + 1)
    }
    -1
}

/// Past `true`, `false` or `null` at `i`; -1 for any other word.
fn word_end(b: Bytes, i: int) -> int {
    let j = b.run(i, letters)
    let known = b.eq_at(i, j, "true".bytes()) ||
        b.eq_at(i, j, "false".bytes()) ||
        b.eq_at(i, j, "null".bytes())
    if known { j } else { -1 }
}
