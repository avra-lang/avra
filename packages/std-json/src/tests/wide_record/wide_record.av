// proves: `@json` reads a record of any width — fourteen fields, past the twelve a per-arity template once spelled
use @std.json.codec.{json}

@json
type Wide = {
    a: int,
    b: int,
    c: int,
    d: int,
    e: int,
    f: int,
    g: int,
    h: int,
    i: int,
    j: int,
    k: int,
    l: int,
    m: int,
    n: string,
}

let text = "{\"a\":1,\"b\":2,\"c\":3,\"d\":4,\"e\":5,\"f\":6,\"g\":7,\"h\":8,\"i\":9,\"j\":10,\"k\":11,\"l\":12,\"m\":13,\"n\":\"end\"}"

match Wide.from_json_text(text) { .Ok(w) -> "${w.a + w.l + w.m} ${w.n}", .Err(e) -> "failed: ${e}" }
