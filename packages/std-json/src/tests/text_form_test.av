// A field whose type implements `TextForm` crosses JSON as its text: written through
// `text_form`, read through `from_text_form`, a refused text filed at its path.
use @std.json.{Json, parse, to_text}
use @std.json.codec.{json}
use @std.time.{Time}

@json
type Event = { at: Time, label: string, seen: List<Time> }

const stamp: string = "1970-01-01T00:00:01.000000000Z"

spec "std/json — a text-form field is a JSON string" {
    given "an event with a Time" {
        then "it writes the time's text" {
            Event { at: Time { ns: 1000000000 }, label: "x", seen: [] }.json_text() == "{\"at\":\"${stamp}\",\"label\":\"x\",\"seen\":[]}"
        }
        then "its tree form carries the same string" {
            to_text(Event { at: Time { ns: 1000000000 }, label: "x", seen: [] }.to_json()) == "{\"at\":\"${stamp}\",\"label\":\"x\",\"seen\":[]}"
        }
        then "the text reads back to the instant, as list elements too" {
            match Event
                .from_json_text("{\"at\":\"${stamp}\",\"label\":\"x\",\"seen\":[\"${stamp}\"]}") {
                .Ok(e) -> e.at.ns == 1000000000 && e.seen[0].ns == 1000000000,
                .Err(_) -> false,
            }
        }
        then "the tree reads it back too" {
            match Event
                .from_json(parse("{\"at\":\"${stamp}\",\"label\":\"x\",\"seen\":[]}") catch Json.Null) {
                .Ok(e) -> e.at.ns == 1000000000,
                .Err(_) -> false,
            }
        }
    }
    given "a malformed time" {
        then "the tree refuses it at its path" {
            match Event
                .from_json(parse("{\"at\":\"nope\",\"label\":\"x\",\"seen\":[]}") catch Json.Null) {
                .Ok(_) -> false,
                .Err(e) -> e.at == "at" && e.found == "nope",
            }
        }
        then "the text refuses it" {
            match Event.from_json_text("{\"at\":\"nope\",\"label\":\"x\",\"seen\":[]}") {
                .Ok(_) -> false,
                .Err(_) -> true,
            }
        }
        then "a list element refuses at its index" {
            match Event
                .from_json(
                    parse("{\"at\":\"${stamp}\",\"label\":\"x\",\"seen\":[\"${stamp}\",\"nope\"]}") catch Json
                        .Null,
                ) { .Ok(_) -> false, .Err(e) -> e.at == "seen[1]" }
        }
    }
}
