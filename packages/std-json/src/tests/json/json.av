// proves: @std/json end to end, evaluated and native alike — text read
// into a value, its fields walked by name and index, escapes decoded,
// the compact and pretty forms written, and a refusal read as words.
use @std.json.{Json, field, parse, to_text, pretty}

let text = "{\"name\": \"avra\", \"version\": [0, 0, 1], \"tags\": [\"caf\\u00e9\", \"日本\"], \"ok\": true, \"none\": null}"
let doc = parse(text) catch Json.Null
println(to_text(doc))
println(doc.member("name").text() ?? "?")
println("${doc.member("version").item(2).int() ?? 0}")
println(doc.member("tags").item(0).text() ?? "?")
println(pretty(Json.Obj([field("k", Json.Arr([Json.Int(1), Json.Str("two")]))])))
let bad = match parse("[1,,2]") { .Ok(_) -> "accepted", .Err(e) -> e.describe().message }
println(bad)
"${doc.keys().length}"
