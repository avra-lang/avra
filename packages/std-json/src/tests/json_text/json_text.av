// `@json_text("put", "take")` on a type of this package: the write method and the read
// fn are declared beside the type, and the derive's names resolve where the type lands.
use @std.json.codec.{json_text}

@json_text("put", "take")
type Tag = { text: string }

impl Tag {
    fn put() -> string { self.text }
}

fn take(text: string) -> Tag? {
    if text == "" { null } else { Tag { text: text } }
}

match Tag.from_json_text("\"abc\"") { .Ok(t) -> t.text, .Err(e) -> e.wanted }
