// proves: `@json` writes a field whose type implements `TextForm` as its text form, and reads it back
use @std.json.codec.{json}
use @std.time.{Time}

@json
type Event = { at: Time, label: string }

let text = Event { at: Time { ns: 1000000000 }, label: "x" }.json_text()

match Event.from_json_text(text) {
    .Ok(e) -> "${text} ${e.at.ns}",
    .Err(e) -> "failed: ${e.describe().message}",
}
