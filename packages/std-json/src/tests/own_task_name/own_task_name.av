// proves: a derive builds the record literal of a program's own `type Task` — a name the language also owns as a constructor — as the program's declaration
use @std.json.codec.{json}

@json
type Task = { id: string, title: string, done: bool }

match Task.from_json_text("{\"id\":\"a\",\"title\":\"b\",\"done\":true}") {
    .Ok(t) -> "${t.id} ${t.title} ${t.done}",
    .Err(e) -> "failed: ${e}",
}
