//! `@std.json.typed` — JSON read and written as TEXT, with no tree between.
//! A typed reader finds the extent of each member or element by a few small
//! scans of its own and keeps it as the text it was written in; a derived
//! decoder (`from_json_text`, `@json`) reads its fields from those extents,
//! and a derived writer (`json_text`) writes its fields straight to text. A
//! program that decodes a few types therefore links these scans and its own
//! decoders, never the general value, its parser or its writer.
use @std.text.{from_codepoint, parse_float, parse_int}

/// One member of an object read: its decoded key, and its value as written.
export type Piece = { key: string, raw: string }

/// Past the blanks at `i`.
fn blanked(b: Bytes, i: int) -> int {
    mut j = i
    // LICENSED loops.push_loop: advances past blanks one octet at a time
    while j < b.length && (b.at(j) == 32 || b.at(j) == 10 || b.at(j) == 13 || b.at(j) == 9) { j = j + 1 }
    j
}

/// Past the string whose quote is at `i`; -1 when it never closes.
fn string_end(b: Bytes, i: int) -> int {
    mut j = i + 1
    // LICENSED loops.push_loop: a string ends at its first unescaped quote
    while j < b.length {
        if b.at(j) == 34 { return j + 1 }
        j = j + if b.at(j) == 92 { 2 } else { 1 }
    }
    -1
}

/// Past the value at `i`: a string, or anything else up to its balanced end
/// (a comma or closer outside every bracket and string). -1 where there is
/// none. What it means is its reader's to judge.
fn value_end(b: Bytes, i: int) -> int {
    if i >= b.length { return -1 }
    if b.at(i) == 34 { return string_end(b, i) }
    mut depth = 0
    mut j = i
    // LICENSED loops.push_loop: a value is walked octet by octet to its balanced end
    while j < b.length {
        let c = b.at(j)
        if c == 34 {
            j = string_end(b, j)
            if j < 0 { return -1 }
            continue
        }
        if c == 123 || c == 91 { depth = depth + 1 }
        if (c == 125 || c == 93) && depth == 0 { break }
        if c == 125 || c == 93 { depth = depth - 1 }
        if (c == 44 || c == 32 || c == 10 || c == 13 || c == 9) && depth == 0 { break }
        j = j + 1
    }
    if j == i || depth != 0 { -1 } else { j }
}

/// A string literal's text, its escapes decoded. A `\u` escape is one code
/// point: a surrogate pair is the tree reader's to join.
fn unescaped(raw: string, b: Bytes, from: int, end: int) -> string {
    let body = raw.substring(from + 1, end - 1)
    if !body.contains("\\") { return body }
    let out: Cell<List<string>> = Cell.new([])
    mut j = from + 1
    // LICENSED loops.push_loop: an escape is one or six octets, found where it stands
    while j < end - 1 {
        let c = b.at(j)
        if c != 92 {
            out.push(raw.substring(j, j + 1))
            j = j + 1
            continue
        }
        let e = b.at(j + 1)
        if e == 117 && j + 6 <= end - 1 {
            out.push(from_codepoint(hex4(raw.substring(j + 2, j + 6))))
            j = j + 6
            continue
        }
        out.push(plain_escape(e))
        j = j + 2
    }
    out.get().join("")
}

fn plain_escape(e: int) -> string {
    when {
        e == 110 -> "\n"
        e == 116 -> "\t"
        e == 114 -> "\r"
        e == 98 -> from_codepoint(8)
        e == 102 -> from_codepoint(12)
        _ -> from_codepoint(e)
    }
}

/// Four hex digits as a number; zero for any that is not one.
fn hex4(h: string) -> int {
    let hb = h.bytes()
    mut n = 0
    for j in 0..hb.length { n = n * 16 + digit_value(hb.at(j)) }
    n
}

fn digit_value(c: int) -> int {
    when {
        c >= 48 && c <= 57 -> c - 48
        c >= 97 && c <= 102 -> c - 87
        c >= 65 && c <= 70 -> c - 55
        _ -> 0
    }
}

/// The members of the object `raw` is, each value kept as written.
export fn members(raw: string) -> Result<List<Piece>, string> {
    let b = raw.bytes()
    mut i = blanked(b, 0)
    if i >= b.length || b.at(i) != 123 { fail "wants an object" }
    i = blanked(b, i + 1)
    let found: Cell<List<Piece>> = Cell.new([])
    if i < b.length && b.at(i) == 125 { return after(b, i + 1, found.get()) }
    // LICENSED loops.push_loop: members are read in the order they stand, each from where the last ended
    while true {
        if i >= b.length || b.at(i) != 34 { fail "wants a member name" }
        let key_end = string_end(b, i)
        if key_end < 0 { fail "wants a member name" }
        let key = unescaped(raw, b, i, key_end)
        i = blanked(b, key_end)
        if i >= b.length || b.at(i) != 58 { fail "wants `:` after a name" }
        i = blanked(b, i + 1)
        let end = value_end(b, i)
        if end < 0 { fail "wants a value" }
        found.push(Piece { key: key, raw: raw.substring(i, end) })
        i = blanked(b, end)
        if i < b.length && b.at(i) == 44 {
            i = blanked(b, i + 1)
            continue
        }
        if i < b.length && b.at(i) == 125 { return after(b, i + 1, found.get()) }
        fail "wants `,` or `}`"
    }
    found.get()
}

/// The members, when nothing but blanks follows the object.
fn after(b: Bytes, i: int, found: List<Piece>) -> Result<List<Piece>, string> {
    if blanked(b, i) != b.length { fail "has more after the object" }
    found
}

/// The elements of the array `raw` is, each kept as written.
export fn elements(raw: string) -> Result<List<string>, string> {
    let b = raw.bytes()
    mut i = blanked(b, 0)
    if i >= b.length || b.at(i) != 91 { fail "wants an array" }
    i = blanked(b, i + 1)
    let found: Cell<List<string>> = Cell.new([])
    if i < b.length && b.at(i) == 93 { return done(b, i + 1, found.get()) }
    // LICENSED loops.push_loop: elements are read in the order they stand, each from where the last ended
    while true {
        let end = value_end(b, i)
        if end < 0 { fail "wants a value" }
        found.push(raw.substring(i, end))
        i = blanked(b, end)
        if i < b.length && b.at(i) == 44 {
            i = blanked(b, i + 1)
            continue
        }
        if i < b.length && b.at(i) == 93 { return done(b, i + 1, found.get()) }
        fail "wants `,` or `]`"
    }
    found.get()
}

fn done(b: Bytes, i: int, found: List<string>) -> Result<List<string>, string> {
    if blanked(b, i) != b.length { fail "has more after the array" }
    found
}

/// The value of the member named `key`, when there is one.
export fn member(ms: List<Piece>, key: string) -> string? { ms.find(it.key == key)?.raw }

/// The integer `raw` is.
export fn as_int(raw: string) -> Result<int, string> {
    let n? = parse_int(raw.trim()) else { fail "wants an integer" }
    n
}

/// The text `raw` is, its escapes decoded.
export fn as_text(raw: string) -> Result<string, string> {
    let b = raw.bytes()
    let from = blanked(b, 0)
    if from >= b.length || b.at(from) != 34 { fail "wants text" }
    let end = string_end(b, from)
    if end < 0 || blanked(b, end) != b.length { fail "wants text" }
    unescaped(raw, b, from, end)
}

/// The truth `raw` is.
export fn as_bool(raw: string) -> Result<bool, string> {
    let t = raw.trim()
    if t == "true" { return true }
    if t == "false" { return false }
    fail "wants `true` or `false`"
}

/// Whether `raw` is `null`.
export fn is_null(raw: string) -> bool { raw.trim() == "null" }

/// A string as a JSON literal.
export fn quoted(s: string) -> string {
    let escaped = s
        .replace("\\", "\\\\")
        .replace("\"", "\\\"")
        .replace("\n", "\\n")
        .replace("\r", "\\r")
        .replace("\t", "\\t")
    "\"${escaped}\""
}

/// An object from `"name":value` members already written.
export fn object_of(members: List<string>) -> string { "{${members.join(",")}}" }

/// An array from elements already written.
export fn array_of(elements: List<string>) -> string { "[${elements.join(",")}]" }

/// A member: its name and its value as written.
export fn member_text(key: string, value: string) -> string { "${quoted(key)}:${value}" }

/// A member's value together with its name, for a map read.
export type Entry<T> = { key: string, value: T }

/// Entries, as the map from their names.
export fn map_of_entries<T>(entries: List<Entry<T>>) -> Map<string, T> {
    mut out: Map<string, T> = {}
    for e in entries { out.set(e.key, e.value) }
    out
}

/// The value of a member a field cannot do without.
export fn needed(raw: string?) -> Result<string, string> {
    let r? = raw else { fail "is missing" }
    r
}

/// The value of a member that may be absent or `null`: none then.
export fn present_raw(raw: string?) -> string? {
    let r? = raw else { return null }
    if is_null(r) { null } else { r }
}

/// The float `raw` is.
export fn as_float(raw: string) -> Result<float, string> {
    let n? = parse_float(raw.trim()) else { fail "wants a number" }
    n
}

export fn int_text(n: int) -> string { "${n}" }

export fn bool_text(b: bool) -> string { if b { "true" } else { "false" } }

/// A float written as JSON does: infinity and NaN write `null`.
export fn float_text(x: float) -> string { if x - x == 0.0 { "${x}" } else { "null" } }
