//! `@std.json.typed` — JSON read and written as TEXT, with no tree between.
//! A typed reader finds the extent of each member or element with `@std.json`'s
//! byte scans (the one scanner) and keeps it as the text it was written in; a derived
//! decoder (`from_json_text`, `@json`) reads its fields from those extents,
//! and a derived writer (`json_text`) writes its fields straight to text. A
//! program that decodes a few types therefore links these scans and its own
//! decoders, never the general value, its parser or its writer.
use @std.json.{
    DecodeError,
    path_item,
    MAX_DEPTH,
    path_field,
    int_end,
    int_of,
    number_end,
    plain_end,
    skip,
    skip_judged,
    space,
    string_end,
    text_of,
}
use @std.text.{parse_float}

/// One member of an object read: its decoded key, and its value as written.
export type Piece = { key: string, raw: string }

/// What the text `raw` is, in the words a refusal says it with.
fn said(raw: string?) -> string {
    let r? = raw else { return "nothing" }
    let t = r.trim()
    when {
        t.starts_with("\"") -> "text"
        t.starts_with("[") -> "an array"
        t.starts_with("{") -> "an object"
        t == "null" -> "null"
        t == "true" || t == "false" -> "`${t}`"
        parse_float(t) != null -> "the number ${t}"
        _ -> not_json
    }
}

/// `raw` is not what `at` wants.
fn misfit(at: string, wanted: string, raw: string?) -> DecodeError {
    DecodeError { at: at, wanted: wanted, found: said(raw) }
}

/// The members of the object `raw` is, each value kept as written and no
/// name written twice: a document that says two things of one name means neither.
export fn members(raw: string, at: string) -> Result<List<Piece>, DecodeError> { scanned(raw, at, true) }

/// The members of the object `raw` is, as `members` reads them but for names
/// written twice, which `member_once` refuses where a field reads one.
export fn fields(raw: string, at: string) -> Result<List<Piece>, DecodeError> { scanned(raw, at, false) }

fn scanned(raw: string, at: string, distinct: bool) -> Result<List<Piece>, DecodeError> {
    let b = raw.bytes()
    mut i = space(b, 0)
    if i >= b.length || b.at(i) != 123 { fail misfit(at, "an object", raw) }
    i = space(b, i + 1)
    let found: Cell<List<Piece>> = Cell.new([])
    if i < b.length && b.at(i) == 125 { return after(b, i + 1, found.get(), at, distinct) }
    // LICENSED loops.push_loop: members are read in the order they stand, each from where the last ended
    while true {
        if i >= b.length || b.at(i) != 34 { fail misfit(at, "a member name", null) }
        let key_end = string_end(b, i)
        if key_end < 0 { fail misfit(at, "a member name", null) }
        let key = text_of(raw, b, i, key_end)
        i = space(b, key_end)
        if i >= b.length || b.at(i) != 58 { fail misfit(at, "`:` after a name", null) }
        i = space(b, i + 1)
        let end = skip(b, i, MAX_DEPTH)
        if end < 0 { fail misfit(at, "a value", null) }
        found.push(Piece { key: key, raw: raw.substring(i, end) })
        i = space(b, end)
        if i < b.length && b.at(i) == 44 {
            i = space(b, i + 1)
            continue
        }
        if i < b.length && b.at(i) == 125 { return after(b, i + 1, found.get(), at, distinct) }
        fail misfit(at, "`,` or `}`", null)
    }
    found.get()
}

/// The members, when nothing but blanks follows the object and, under `distinct`,
/// no name is written twice.
fn after(b: Bytes, i: int, found: List<Piece>, at: string, distinct: bool) -> Result<
    List<Piece>,
    DecodeError,
> {
    if space(b, i) != b.length { fail misfit(at, "nothing after the object", null) }
    if !distinct { return found }
    let keys = [p.key for p in found]
    for j, k in keys {
        if keys.slice(0, j).contains(k) { fail DecodeError { at: path_field(at, k), wanted: "one member", found: "more" } }
    }
    found
}

/// The elements of the array `raw` is, each kept as written.
export fn elements(raw: string, at: string) -> Result<List<string>, DecodeError> {
    let b = raw.bytes()
    mut i = space(b, 0)
    if i >= b.length || b.at(i) != 91 { fail misfit(at, "an array", raw) }
    i = space(b, i + 1)
    let found: Cell<List<string>> = Cell.new([])
    if i < b.length && b.at(i) == 93 { return done(b, i + 1, found.get(), at) }
    // LICENSED loops.push_loop: elements are read in the order they stand, each from where the last ended
    while true {
        let end = skip(b, i, MAX_DEPTH)
        if end < 0 { fail misfit(at, "a value", null) }
        found.push(raw.substring(i, end))
        i = space(b, end)
        if i < b.length && b.at(i) == 44 {
            i = space(b, i + 1)
            continue
        }
        if i < b.length && b.at(i) == 93 { return done(b, i + 1, found.get(), at) }
        fail misfit(at, "`,` or `]`", null)
    }
    found.get()
}

fn done(b: Bytes, i: int, found: List<string>, at: string) -> Result<List<string>, DecodeError> {
    if space(b, i) != b.length { fail misfit(at, "nothing after the array", null) }
    found
}

/// The value of the member named `key`, when there is one.
export fn member(ms: List<Piece>, key: string) -> string? { ms.find(it.key == key)?.raw }

/// The value of the member named `key`, once: absent when missing, refused
/// when written twice — a document that says two things of one name means neither.
export fn member_once(ms: List<Piece>, key: string, at: string) -> Result<string?, DecodeError> {
    let named = [p.raw for p in ms if p.key == key]
    if named.length > 1 { fail DecodeError { at: at, wanted: "one member", found: "${named.length}" } }
    named.first()
}

/// The integer `raw` is.
export fn as_int(raw: string, at: string) -> Result<int, DecodeError> {
    let b = raw.bytes()
    let from = space(b, 0)
    let end = int_end(b, from)
    if end < 0 || space(b, end) != b.length { fail misfit(at, "an integer", raw) }
    int_of(raw, b, from, end)
}

/// The text `raw` is, its escapes decoded.
export fn as_text(raw: string, at: string) -> Result<string, DecodeError> {
    let b = raw.bytes()
    let from = space(b, 0)
    if from >= b.length || b.at(from) != 34 { fail misfit(at, "text", raw) }
    let end = string_end(b, from)
    if end < 0 || space(b, end) != b.length { fail misfit(at, "text", raw) }
    text_of(raw, b, from, end)
}

/// The truth `raw` is.
export fn as_bool(raw: string, at: string) -> Result<bool, DecodeError> {
    let t = raw.trim()
    if t == "true" { return true }
    if t == "false" { return false }
    fail misfit(at, "`true` or `false`", raw)
}

/// Whether `raw` is `null`.
export fn is_null(raw: string) -> bool { raw.trim() == "null" }

/// A string as a JSON literal.
export fn quoted(s: string) -> string {
    let escaped = s
        .replace("\\", "\\\\")
        .replace("\"", "\\\"")
        .replace("\n", "\\n")
        .replace("\r", "\\r")
        .replace("\t", "\\t")
    "\"${escaped}\""
}

/// An object from `"name":value` members already written.
export fn object_of(members: List<string>) -> string { "{${members.join(",")}}" }

/// An array from elements already written.
export fn array_of(elements: List<string>) -> string { "[${elements.join(",")}]" }

/// A member: its name and its value as written.
export fn member_text(key: string, value: string) -> string { "${quoted(key)}:${value}" }

/// A member's value together with its name, for a map read.
export type Entry<T> = { key: string, value: T }

/// Entries, as the map from their names.
export fn map_of_entries<T>(entries: List<Entry<T>>) -> Map<string, T> {
    mut out: Map<string, T> = {}
    for e in entries { out.set(e.key, e.value) }
    out
}

/// The value of a member a field cannot do without.
export fn needed(raw: string?, at: string, wanted: string) -> Result<string, DecodeError> {
    let r? = raw else { fail misfit(at, wanted, null) }
    r
}

/// The value of a member that may be absent or `null`: none then.
export fn present_raw(raw: string?) -> string? {
    let r? = raw else { return null }
    if is_null(r) { null } else { r }
}

/// The float `raw` is.
export fn as_float(raw: string, at: string) -> Result<float, DecodeError> {
    let n? = parse_float(raw.trim()) else { fail misfit(at, "a number", raw) }
    n
}

export fn int_text(n: int) -> string { "${n}" }

export fn bool_text(b: bool) -> string { if b { "true" } else { "false" } }

/// A float written as JSON does: infinity and NaN write `null`.
export fn float_text(x: float) -> string { if x - x == 0.0 { "${x}" } else { "null" } }

// ── the cursor ──────────────────────────────────────────────────

/// One step into a value.
export enum Step {
    Field(name: string)
    Index(at: int)
    Key(key: string)
    Variant(name: string)
}

/// A place inside a value, from its root: `items[3].qty`,
/// `payment.Card.exp`, `meta["x-y"]`. Held nearest-first — `up` walks
/// from the place back to the root — so a container filing what its
/// readers found under its own step puts that step on the end, in
/// place.
export type Path = { up: List<Step> }

impl Path {
    fn field(name: string) -> Path { self.then(Step.Field(name)) }
    fn index(at: int) -> Path { self.then(Step.Index(at)) }
    fn key(key: string) -> Path { self.then(Step.Key(key)) }
    fn variant(name: string) -> Path { self.then(Step.Variant(name)) }

    /// This path, read from `prefix` rather than the root.
    fn under(prefix: Path) -> Path {
        if prefix.up.is_empty() { return self }
        Path { up: self.up.concat(prefix.up) }
    }

    /// One step further from the root.
    fn then(s: Step) -> Path {
        // pinned: `concat` may take its argument's box, and a field of `self` is a place
        let up = self.up
        Path { up: [s].concat(up) }
    }

    /// The steps from the root down.
    fn steps() -> List<Step> { [self.up[self.up.length - 1 - j] for j in 0..self.up.length] }

    /// How many steps down from the root.
    fn depth() -> int { self.up.length }

    /// The path as code spells it; the root is empty.
    fn text() -> string {
        [spelled(j, s) for j, s in self.steps()].join("")
    }
}

fn spelled(j: int, s: Step) -> string {
    match s {
        .Field(name) or .Variant(name) -> if j == 0 { name } else { ".${name}" },
        .Index(at) -> "[${at}]",
        .Key(key) -> "[${quoted(key)}]",
    }
}

/// Where a problem read from this text stands among the others: the
/// steps filed under its containers (nearest the root last), its place
/// in the container's order, and the offset its received value starts
/// at (-1 when none is shown).
export type Place = { up: List<Step>, order: int, received_at: int }

/// A cursor over JSON text that reads each value where it stands: the
/// text, its octets, and where it is — -1 once it stepped aside, so a
/// reader that cannot go on hands the text to one that can. `places`
/// files each problem found while reading, in the order it was found.
export type Reader = { text: string, bytes: Bytes, pos: int, places: List<Place> = [], depth: int = 0 }

/// A reader at the first value `text` holds.
export fn reader_of(text: string) -> Reader {
    let b = text.bytes()
    Reader { text: text, bytes: b, pos: space(b, 0), places: [] }
}

/// A reader of nothing, already aside.
export fn no_reader() -> Reader { Reader { text: "", bytes: "".bytes(), pos: -1, places: [] } }

impl Reader {
    /// A problem found, filed at `order` in its container; its received
    /// value starts at `received_at`, or nowhere at -1.
    mut fn placed(order: int, received_at: int) {
        self.places.push(Place { up: [], order: order, received_at: received_at })
    }

    /// Every problem from `mark` on filed one step further from the
    /// root, at `order` in its container.
    mut fn stepped(mark: int, order: int, s: Step) {
        for i in mark..self.places.length {
            self.places[i].up.push(s)
            self.places[i].order = order
        }
    }

    /// The problems from `from` on put stably in their container's
    /// order: the indexes to read the old ones in, or null when they
    /// already stand so. Only a member read out of turn moves.
    mut fn sorted(from: int) -> List<int>? {
        let n = self.places.length
        mut perm = [i for i in from..n]
        mut moved = false
        for i in from + 1..n {
            let key = perm[i - from]
            mut j = i
            while j > from && self.places[perm[j - 1 - from]].order > self.places[key].order {
                perm.set(j - from, perm[j - 1 - from])
                j = j - 1
            }
            if j < i {
                perm.set(j - from, key)
                moved = true
            }
        }
        if !moved { return null }
        let old = self.places
        for k, p in perm { self.places.set(from + k, old[p]) }
        perm
    }

    /// The reader stops here.
    mut fn aside() { self.pos = -1 }

    /// Past a `null` at the cursor; false when another value stands there.
    mut fn null_here() -> bool {
        if self.here() != 110 { return false }
        let end = skip(self.bytes, self.pos, 0)
        if end != self.pos + 4 { return false }
        self.pos = end
        true
    }

    /// The octet at the cursor, or -1 past the text or aside.
    fn here() -> int { if self.pos >= 0 && self.pos < self.bytes.length { self.bytes.at(self.pos) } else { -1 } }

    /// Whether the octet at the cursor is `c`.
    fn at_byte(c: int) -> bool { self.here() == c }

    /// Whether every value the text holds was read, and nothing follows.
    fn finished() -> bool { self.pos >= 0 && space(self.bytes, self.pos) == self.bytes.length }

    /// Past the value at the cursor, nested at most `room` deeper; false
    /// where the text is not JSON.
    mut fn skipped(room: int) -> bool {
        if self.pos < 0 { return false }
        self.pos = skip_judged(self.bytes, self.pos, room)
        self.pos >= 0
    }

    /// Past the opener `c` at the cursor; false when another value stands there.
    mut fn opened(c: int) -> bool {
        if !self.at_byte(c) { return false }
        self.pos = self.pos + 1
        true
    }

    /// Just past an opener: whether an item follows, the cursor at it.
    /// At `close` the cursor passes it.
    mut fn first(close: int) -> bool {
        if self.pos < 0 { return false }
        let j = space(self.bytes, self.pos)
        if j < self.bytes.length && self.bytes.at(j) == close {
            self.pos = j + 1
            return false
        }
        self.pos = j
        true
    }

    /// Just past an item: whether another follows, the cursor at it. At
    /// `close` the cursor passes it; anything else steps aside.
    mut fn next(close: int) -> bool {
        if self.pos < 0 { return false }
        let b = self.bytes
        let j = space(b, self.pos)
        let c = if j < b.length { b.at(j) } else { -1 }
        if c == 44 {
            self.pos = space(b, j + 1)
            return true
        }
        if c == close { self.pos = j + 1 } else { self.aside() }
        false
    }

    /// The key at the cursor read and the cursor left at its value: past
    /// the key's closing quote, or -1 where the text holds no key.
    mut fn key() -> int {
        if !self.at_byte(34) {
            self.aside()
            return -1
        }
        let b = self.bytes
        let plain = plain_end(b, self.pos)
        let end = if plain >= 0 { plain } else { string_end(b, self.pos) }
        let colon = if end < 0 { end } else { space(b, end) }
        if colon < 0 || colon >= b.length || b.at(colon) != 58 {
            self.aside()
            return -1
        }
        self.pos = space(b, colon + 1)
        end
    }

    /// Whether the key whose quote is at `at` spells `name` exactly — asked
    /// once its length is known to be `name`'s.
    fn key_is(at: int, name: string) -> bool { self.bytes.eq_at(at + 1, at + 1 + name.length, name.bytes()) }

    /// The text of the key whose quotes stand at `at` and `end`.
    fn key_text(at: int, end: int) -> string { text_of(self.text, self.bytes, at, end) }

    /// The field an ESCAPED key names among `names` — a key with no escape
    /// was matched by its octets already, so it names none.
    fn key_index(at: int, end: int, names: List<string>) -> int {
        if end < 0 { return -1 }
        let key = self.key_text(at, end)
        if key.length == end - at - 2 { -1 } else { names.index_of(key) }
    }

    /// The string at the cursor, the cursor past it; null when none stands there.
    mut fn string_here() -> string? {
        if !self.at_byte(34) { return null }
        let at = self.pos
        let b = self.bytes
        let plain = plain_end(b, at)
        if plain >= 0 {
            self.pos = plain
            return self.text.substring(at + 1, plain - 1)
        }
        let end = string_end(b, at)
        if end < 0 { return null }
        self.pos = end
        text_of(self.text, b, at, end)
    }

    /// The integer at the cursor, the cursor past it; null when none stands there.
    mut fn int_here() -> int? {
        let at = self.pos
        let c = self.here()
        if c != 45 && !is_digit(c) { return null }
        let end = int_end(self.bytes, at)
        if end < 0 { return null }
        self.pos = end
        int_of(self.text, self.bytes, at, end)
    }

    /// The truth at the cursor, the cursor past it; null when none stands there.
    mut fn bool_here() -> bool? {
        let at = self.pos
        let c = self.here()
        if c != 116 && c != 102 { return null }
        let end = skip(self.bytes, at, 0)
        if !(end == at + 4 && c == 116 || end == at + 5) { return null }
        self.pos = end
        end == at + 4
    }

    /// The number with a fraction or an exponent at the cursor, the cursor
    /// past it; null when none stands there — an integer is not one, and one
    /// past what a float holds steps aside.
    mut fn float_here() -> float? {
        let at = self.pos
        let c = self.here()
        if c != 45 && !is_digit(c) { return null }
        let end = number_end(self.bytes, at)
        if end < 0 || int_end(self.bytes, at) >= 0 { return null }
        self.pos = end
        let x? = parse_float(self.text.substring(at, end)) else {
            self.aside()
            return null
        }
        x
    }
}

fn is_digit(c: int) -> bool { c >= 48 && c <= 57 }

// ── reading from the cursor ─────────────────────────────────────

/// A reader of one kind of value from the cursor, at the path `at`.
export alias ReadFn<T> = fn(mut Reader, string) -> Result<T, DecodeError>

/// What stands at the cursor, in the words a refusal says it with.
/// What a refusal says of text that is no JSON.
const not_json: string = "text that is not JSON"

fn said_here(r: Reader) -> string {
    let c = r.here()
    when {
        c == 34 -> "text"
        c == 91 -> "an array"
        c == 123 -> "an object"
        c == 110 -> "null"
        c == 116 || c == 102 -> "`${r.text.substring(r.pos, skip(r.bytes, r.pos, 0))}`"
        c == 45 || is_digit(c) -> "the number ${r.text.substring(r.pos, number_end(r.bytes, r.pos))}"
        c < 0 -> "nothing"
        _ -> not_json
    }
}

/// The value at the cursor is not what `at` wants.
fn refused_here(r: Reader, at: string, wanted: string) -> DecodeError {
    DecodeError { at: at, wanted: wanted, found: said_here(r) }
}

export fn read_int(mut r: Reader, at: string) -> Result<int, DecodeError> {
    let n? = r.int_here() else { fail refused_here(r, at, "an integer") }
    n
}

/// A float, or an integer read as the float nearest it.
export fn read_float(mut r: Reader, at: string) -> Result<float, DecodeError> {
    let x? = r.float_here() else {
        let n? = r.int_here() else { fail refused_here(r, at, "a number") }
        return parse_float("${n}")!
    }
    x
}

export fn read_text(mut r: Reader, at: string) -> Result<string, DecodeError> {
    let t? = r.string_here() else { fail refused_here(r, at, "text") }
    t
}

export fn read_bool(mut r: Reader, at: string) -> Result<bool, DecodeError> {
    let b? = r.bool_here() else { fail refused_here(r, at, "`true` or `false`") }
    b
}

/// The value at the cursor, or none for `null`.
export fn read_opt<T>(mut r: Reader, at: string, each: ReadFn<T>) -> Result<T?, DecodeError> {
    if r.null_here() { return .Ok(null) }
    let v = each(r, at)?
    .Ok(v)
}

/// The array at the cursor, each item read by `each` at its own index.
export fn read_list<T>(mut r: Reader, at: string, each: ReadFn<T>) -> Result<List<T>, DecodeError> {
    mut more = opened_in(r, at, 91, 93, "an array")?
    mut out: List<T> = []
    mut i = 0
    while more {
        out.push(each(r, path_item(at, i))?)
        i = i + 1
        more = next_in(r, at, 93, "`,` or `]`")?
    }
    out
}

/// The object at the cursor as a map, each member read by `each` at its own key.
export fn read_map<T>(mut r: Reader, at: string, each: ReadFn<T>) -> Result<
    Map<string, T>,
    DecodeError,
> {
    mut more = opened_in(r, at, 123, 125, "an object")?
    mut out: Map<string, T> = {}
    while more {
        let key = key_here(r, at)?
        let here = path_field(at, key)
        if out.has(key) { fail DecodeError { at: here, wanted: "one member", found: "more" } }
        out.set(key, each(r, here)?)
        more = next_in(r, at, 125, "`,` or `}`")?
    }
    out
}

/// Past an opener `open` at the cursor, nested at most `MAX_DEPTH` deep: whether
/// an item follows. `wanted` is what the seat takes.
export fn opened_in(mut r: Reader, at: string, open: int, close: int, wanted: string) -> Result<
    bool,
    DecodeError,
> {
    if !r.opened(open) { fail refused_here(r, at, wanted) }
    r.depth = r.depth + 1
    if r.depth > MAX_DEPTH {
        fail DecodeError {
            at: at,
            wanted: "a document nested at most ${MAX_DEPTH} deep",
            found: "deeper",
        }
    }
    let more = r.first(close)
    if !more { r.depth = r.depth - 1 }
    more
}

/// Past an item: whether another follows.
export fn next_in(mut r: Reader, at: string, close: int, wanted: string) -> Result<
    bool,
    DecodeError,
> {
    let more = r.next(close)
    if r.pos < 0 { fail DecodeError { at: at, wanted: wanted, found: not_json } }
    if !more { r.depth = r.depth - 1 }
    more
}

/// The key at the cursor, the cursor left at its value.
export fn key_here(mut r: Reader, at: string) -> Result<string, DecodeError> {
    let start = r.pos
    let end = r.key()
    if end < 0 { fail DecodeError { at: at, wanted: "a member name", found: not_json } }
    r.key_text(start, end)
}

/// Past the value at the cursor.
export fn skip_value(mut r: Reader, at: string) -> Result<bool, DecodeError> {
    if !r.skipped(MAX_DEPTH - r.depth) { fail DecodeError { at: at, wanted: "a value", found: not_json } }
    true
}

/// The member a record's field is, once: a second sight of it is refused.
export fn seen_once(count: int, at: string) -> Result<int, DecodeError> {
    if count > 0 { fail DecodeError { at: at, wanted: "one member", found: "${count + 1}" } }
    count + 1
}

/// A field's value, or the refusal for its absence.
export fn required<T>(v: T?, at: string, wanted: string) -> Result<T, DecodeError> {
    let x? = v else { fail DecodeError { at: at, wanted: wanted, found: "nothing" } }
    x
}

/// The text `raw` read whole by `each`, nothing but blanks after it.
export fn read_whole<T>(raw: string?, at: string, wanted: string, each: ReadFn<T>) -> Result<
    T,
    DecodeError,
> {
    let text = needed(raw, at, wanted)?
    // LICENSED let_stmt.unmutated_mut: `each`'s `mut` seat advances the cursor through it
    mut r = reader_of(text)
    let v = each(r, at)?
    if !r.finished() { fail DecodeError { at: at, wanted: "nothing after the value", found: "more" } }
    v
}

/// The `tag` member of the object at the cursor, which is left at its end.
export fn tag_here(mut r: Reader, at: string) -> Result<string, DecodeError> {
    let tag_at = path_field(at, "tag")
    mut more = opened_in(r, at, 123, 125, "an object")?
    mut tag = ""
    mut seen = 0
    while more {
        let key = key_here(r, at)?
        if key == "tag" {
            seen = seen_once(seen, tag_at)?
            tag = read_text(r, tag_at)?
        } else {
            let _ = skip_value(r, at)?
        }
        more = next_in(r, at, 125, "`,` or `}`")?
    }
    if seen == 0 { fail DecodeError { at: tag_at, wanted: "text", found: "nothing" } }
    tag
}
