//! `@json` — a record or enum type that reads itself from JSON and
//! writes itself back. The declaration IS the schema: each field reads the
//! member of its own name, by its own type.
//!
//!     use @std.json.codec.{json}
//!
//!     @json
//!     type Idea = { title: string, votes: int, tags: List<string>, note: string? }
//!
//! gives `Idea.from_json(j)`, answering the record or a `DecodeError`
//! naming the path that misfit (`tags[2]`), and `idea.to_json()`. An
//! ENUM is an object whose `tag` names the variant and whose other
//! members are its payload fields (`{"tag":"Both","row":1}`). A field reads an `int`, `float`, `bool`, `string`, a `T?` (absent and
//! `null` both read as null), a `List<T>` or `Map<string, T>` of any of these, or another
//! `@json` record or enum. Anything else is refused at the declaration.
//! `x.json_text()` and `T.from_json_text(raw)` write and read the same documents as TEXT,
//! straight from and into the fields with no value tree between (`typed`): a program that
//! only moves its own types links those and none of the general value. A refusal there is
//! one string, not a path.
//! `T.json_shape()` is the type's STRUCTURE as one string -- fields, variants
//! and payload kinds, down through the types it reads -- so a state saved
//! under one shape is told from one read back under another.
//!
//! Stands alone with `@std/meta` and the vocabulary it generates calls
//! to, per the derive-isolation law.
use @std.meta.{
    Type,
    Field,
    Kind,
    Variant,
    Arms,
    Directive,
    Diagnostic,
    Declared,
    Code,
    Decls,
    literal,
    name,
    refuse_as_at,
    type_named,
    stored_scalar,
    flat,
    flat_field,
}
use @std.derive.{record_of}
use @std.json.{
    Json,
    DecodeError,
    field,
    present,
    member_once,
    want_int,
    want_float,
    want_text,
    want_bool,
    want_items,
    want_object,
    path_field,
    path_item,
    unknown_tag,
    want_members,
    map_from,
    Member,
}
use @std.json.typed.{
    Entry,
    array_of,
    map_of_entries,
    as_bool,
    as_float,
    as_int,
    as_text,
    bool_text,
    elements,
    float_text,
    int_text,
    member,
    member_text,
    members,
    needed,
    object_of,
    present_raw,
    quoted,
}

/// `@json` — a record's or an enum's JSON reader and writer, and every
/// way its shape refuses one, spoken at the declaration.
export fn json(t: Type) -> Declared {
    if !t.variants.is_empty() { return enum_json(t) }
    let problems = shape_problems(t)
    if !problems.is_empty() { return refused(problems) }
    Declared { made: [Directive { twin: "", name: t.name, at: t.at, source: codec(t) }] }
}

fn codec(t: Type) -> Decls {
    let reads = [member_read(f) for f in t.fields]
    let body = record_of(t, reads)
    let members = members_of(t)
    let schema = schema_of(t)
    let schemas = listed(
        [quote { field(${literal(n)}, ${name(n)}.json_schema()) } for n in read_closure(t)],
    )
    let rec_parts = [quote { ${literal(f.name + ":")} + ${shape_code(f.kind)} } for f in t.fields]
    let text_parts = [quote { member_text(${literal(f.name)}, ${text_write(f.kind, quote { self.${f} }, 0)}) } for f in t.fields]
    let text_body = record_of(
        t,
        [text_read(f.kind, quote { member(ms, ${literal(f.name)}) }, 0) for f in t.fields],
    )
    quote {
        impl ${t} {
            /// This record read from a JSON document.
            static fn from_json(j: Json) -> Result<${t}, DecodeError> {
                ${name(t.name)}.decode_json(j, "")
            }

            /// This record read from the value at `at`, absent when the
            /// member was missing.
            static fn decode_json(v: Json?, at: string) -> Result<${t}, DecodeError> {
                let o = want_object(v, at)?
                ${body}
            }

            /// This record as a JSON object, its fields in declared order.
            fn to_json() -> Json {
                Json.Obj(${members})
            }

            /// This record's JSON Schema: an object of its fields, each
            /// named record by reference into `json_schemas`.
            static fn json_schema() -> Json {
                ${schema}
            }

            /// The schema of this record and of every record it reads,
            /// by name — the `components.schemas` its references point
            /// into.
            static fn json_schemas() -> Json {
                Json.Obj(${schemas})
            }

            /// This record as JSON text, written straight from its fields: no
            /// value tree between.
            fn json_text() -> string {
                let parts: List<string> = [${..text_parts}]
                object_of(parts)
            }

            /// This record read from JSON text, straight into its fields.
            static fn from_json_text(raw: string) -> Result<${t}, string> {
                let ms = members(raw)?
                ${text_body}
            }

            /// This record's SHAPE: its name, its fields and their kinds,
            /// down through every type it reads. A field added, dropped,
            /// renamed or retyped changes it, whatever the name.
            static fn json_shape() -> string {
                ${name(t.name)}.shape_in([])
            }

            static fn shape_in(seen: List<string>) -> string {
                let here = seen.concat([${literal(t.name)}])
                let parts: List<string> = [${..rec_parts}]
                ${literal(t.name)} + "<" + parts.join(",") + ">"
            }
        }
    }
}

// ── An enum ──────────────────────────────────────────────────────

/// A declaration that made nothing, and why.
fn refused(problems: List<Diagnostic>) -> Declared { Declared { made: [], problems: problems } }

/// An enum as an object: its variant under `tag`, and each payload field
/// under its own name. A variant with no payload is the tag alone.
fn enum_json(t: Type) -> Declared {
    let problems = enum_problems(t)
    if !problems.is_empty() { return refused(problems) }
    Declared { made: [Directive { twin: "", name: t.name, at: t.at, source: enum_codec(t) }] }
}

fn enum_codec(t: Type) -> Decls {
    let chosen = chosen_by_tag(
        [Named { name: v.name, value: built(t, v, [member_read(f) for f in v.fields]) } for v in t.variants],
        quote { { fail unknown_tag(tag_at, tag) } },
    )
    let text_chosen = chosen_by_tag(
        [Named {
            name: v.name,
            value: built(
                t,
                v,
                [text_read(f.kind, quote { member(ms, ${literal(f.name)}) }, 0) for f in v.fields],
            ),
        } for v in t.variants],
        quote { { fail "names no variant" } },
    )
    let text_writes = [text_write_arm(v) for v in t.variants]
    let writes = [write_arm(v) for v in t.variants]
    let tags = listed([quote { Json.Str(${literal(v.name)}) } for v in t.variants])
    let schemas = listed(
        [quote { field(${literal(n)}, ${name(n)}.json_schema()) } for n in read_closure(t)],
    )
    let variant_parts = [variant_shape(v) for v in t.variants]
    quote {
        impl ${t} {
            /// This enum read from a JSON document.
            static fn from_json(j: Json) -> Result<${t}, DecodeError> {
                ${name(t.name)}.decode_json(j, "")
            }

            /// This enum read from the value at `at`: its variant under
            /// `tag`, then the payload fields it names.
            static fn decode_json(v: Json?, at: string) -> Result<${t}, DecodeError> {
                let o = want_object(v, at)?
                let tag_at = path_field(at, "tag")
                let tag = want_text(member_once(o, "tag", tag_at)?, tag_at)?
                ${chosen}
            }

            /// This enum as a JSON object: its variant under `tag`.
            fn to_json() -> Json {
                match self { ${writes} }
            }

            /// This enum's JSON Schema: an object whose `tag` is one of
            /// its variants.
            static fn json_schema() -> Json {
                Json.Obj([
                    field("type", Json.Str("object")),
                    field("properties", Json.Obj([field("tag", Json.Obj([field("enum", Json.Arr(${tags}))]))])),
                    field("required", Json.Arr([Json.Str("tag")])),
                ])
            }

            /// The schema of this enum and of every record it reads.
            static fn json_schemas() -> Json {
                Json.Obj(${schemas})
            }

            /// This enum as JSON text, written straight from its variant.
            fn json_text() -> string {
                match self { ${text_writes} }
            }

            /// This enum read from JSON text: its variant under `tag`, then
            /// the payload fields it names.
            static fn from_json_text(raw: string) -> Result<${t}, string> {
                let ms = members(raw)?
                let tag = as_text(needed(member(ms, "tag"))?)?
                ${text_chosen}
            }

            /// This enum's SHAPE: its name, each variant and the kinds of its
            /// payload, down through every type it reads.
            static fn json_shape() -> string {
                ${name(t.name)}.shape_in([])
            }

            static fn shape_in(seen: List<string>) -> string {
                let here = seen.concat([${literal(t.name)}])
                let parts: List<string> = [${..variant_parts}]
                ${literal(t.name)} + "|" + parts.join("|")
            }
        }
    }
}

/// The variant `tag` names: one `if` per variant, ending in the refusal
/// for a tag that names none.
fn chosen_by_tag(by_name: List<Named>, refusal: Code) -> Code {
    mut chain = refusal
    // LICENSED loops.push_loop: each branch wraps the chain built from the variants after it
    for j in 0..by_name.length {
        let n = by_name[by_name.length - 1 - j]
        let rest = chain
        chain = quote { if tag == ${literal(n.name)} { ${n.value} } else { ${rest} } }
    }
    chain
}

/// A variant's name and the code that builds it.
type Named = { name: string, value: Code }

/// A variant's shape: its name and the kinds of its payload fields.
fn variant_shape(v: Variant) -> Code {
    let fields = [quote { ${literal(f.name + ":")} + ${shape_code(f.kind)} } for f in v.fields]
    quote {
        {
            let parts: List<string> = [${..fields}]
            ${literal(v.name)} + "(" + parts.join(",") + ")"
        }
    }
}

/// A variant of `t` built from the code at each position in `vs`.
fn built(t: Type, v: Variant, vs: List<Code>) -> Code {
    if vs.is_empty() { return quote { ${name(t.name)}.${v} } }
    quote { ${name(t.name)}.${v}(${..vs}) }
}

/// One arm of `to_json`: the tag, then each payload field under its name.
fn write_arm(v: Variant) -> Arms {
    let bs = ["b${j}" for j in 0..v.fields.length]
    let tag = quote { field("tag", Json.Str(${literal(v.name)})) }
    let fields = [quote { field(${literal(f.name)}, ${written(f.kind, name(bs[j]), 0)}) } for j, f in v.fields]
    let members = listed([tag].concat(fields))
    if v.fields.is_empty() { return quote { .${v} -> Json.Obj(${members}) } }
    quote { .${v}(${bs}) -> Json.Obj(${members}) }
}

fn enum_problems(t: Type) -> List<Diagnostic> {
    [unreadable_payload(t, v, f) for v in t.variants for f in v.fields if !readable(f.kind)]
        .concat(
            [unannotated_payload(t, v, f, n) for v in t.variants for f in v.fields for n in records_read(f.kind) if !coded(n)],
        )
}

// ── Reading ──────────────────────────────────────────────────────

/// A field's reading: its member taken once from `o`, then read by
/// the field's kind, refusing with its path.
fn member_read(f: Field) -> Code {
    let p = quote { path_field(at, ${literal(f.name)}) }
    read(f.kind, quote { member_once(o, ${literal(f.name)}, ${p})? }, p, 0)
}

/// The code reading a field of `kind` from `v` (a `Json?`), refusing
/// with the path `p`. `depth` keeps nested binders apart.
fn read(kind: Kind, v: Code, p: Code, depth: int) -> Code {
    match kind {
        .Int -> quote { want_int(${v}, ${p})? },
        .Float -> quote { want_float(${v}, ${p})? },
        .Str -> quote { want_text(${v}, ${p})? },
        .Bool -> quote { want_bool(${v}, ${p})? },
        .Opt(inner) -> read_present(inner, v, p, depth),
        .List(elem) -> read_items(elem, v, p, depth),
        .Map(_, elem) -> read_members(elem, v, p, depth),
        .Named(n, _) -> if flat(n) { quote { ${n} { ${flat_field(n)}: ${read(stored_scalar(n)!, v, p, depth)} } } } else { quote { ${name(n)}.decode_json(${v}, ${p})? } },
        rest -> quote { unreadable() },
    }
}

fn read_present(inner: Kind, v: Code, p: Code, depth: int) -> Code {
    let x = "x${depth}"
    let got = read(inner, name(x), p, depth + 1)
    quote {
        match present(${v}) {
            ${x}? -> ${got}
            null -> null
        }
    }
}

fn read_items(elem: Kind, v: Code, p: Code, depth: int) -> Code {
    let i = "i${depth}"
    let e = "e${depth}"
    let got = read(elem, name(e), quote { path_item(${p}, ${name(i)}) }, depth + 1)
    quote { [${got} for ${i}, ${e} in want_items(${v}, ${p})?] }
}

/// A map's reading: each member read by the value kind, at its own path.
fn read_members(elem: Kind, v: Code, p: Code, depth: int) -> Code {
    let m = "m${depth}"
    let got = read(
        elem,
        quote { ${name(m)}.value },
        quote { path_field(${p}, ${name(m)}.key) },
        depth + 1,
    )
    quote { map_from([Member { key: ${name(m)}.key, value: ${got} } for ${m} in want_members(${v}, ${p})?]) }
}

// ── Writing ──────────────────────────────────────────────────────

/// The object's members as one list, one `field` per record field,
/// folded where the derive runs so the literal's length is fixed.
fn members_of(t: Type) -> Code {
    listed(
        [quote { field(${literal(f.name)}, ${written(f.kind, quote { self.${f} }, 0)}) } for f in t.fields],
    )
}

/// One list of the generated elements `xs`, folded where the derive
/// runs so the literal's length is fixed.
fn listed(xs: List<Code>) -> Code {
    if xs.is_empty() { return quote { [] } }
    mut all = quote { [${xs[0]}] }
    for m in xs.slice(1, xs.length) {
        let sofar = all
        all = quote { ${sofar}.concat([${m}]) }
    }
    all
}

/// The code writing `v` of `kind` as a `Json`.
fn written(kind: Kind, v: Code, depth: int) -> Code {
    match kind {
        .Int -> quote { Json.Int(${v}) },
        .Float -> quote { Json.Float(${v}) },
        .Str -> quote { Json.Str(${v}) },
        .Bool -> quote { Json.Bool(${v}) },
        .Opt(inner) -> written_present(inner, v, depth),
        .List(elem) -> written_items(elem, v, depth),
        .Map(_, elem) -> written_members(elem, v, depth),
        .Named(_, _) -> quote { ${v}.to_json() },
        rest -> quote { unwritable() },
    }
}

fn written_present(inner: Kind, v: Code, depth: int) -> Code {
    let x = "x${depth}"
    let out = written(inner, name(x), depth + 1)
    quote {
        match ${v} {
            ${x}? -> ${out}
            null -> Json.Null
        }
    }
}

fn written_items(elem: Kind, v: Code, depth: int) -> Code {
    let e = "e${depth}"
    let out = written(elem, name(e), depth + 1)
    quote { Json.Arr([${out} for ${e} in ${v}]) }
}

fn written_members(elem: Kind, v: Code, depth: int) -> Code {
    let k = "k${depth}"
    let e = "e${depth}"
    let out = written(elem, name(e), depth + 1)
    quote { Json.Obj([field(${name(k)}, ${out}) for ${k}, ${e} in ${v}]) }
}

// ── Text, with no tree ───────────────────────────────────────────

/// The code reading a field of `kind` from `raw` (a `string?`, absent when
/// the member is) straight out of JSON text, refusing with a string.
fn text_read(kind: Kind, raw: Code, depth: int) -> Code {
    let x = "x${depth}"
    let m = "m${depth}"
    match kind {
        .Int -> quote { as_int(needed(${raw})?)? },
        .Float -> quote { as_float(needed(${raw})?)? },
        .Str -> quote { as_text(needed(${raw})?)? },
        .Bool -> quote { as_bool(needed(${raw})?)? },
        .Opt(inner) -> quote {
            match present_raw(${raw}) {
                ${x}? -> ${text_read(inner, name(x), depth + 1)}
                null -> null
            }
        },
        .List(elem) -> quote { [${text_read(elem, name(x), depth + 1)} for ${x} in elements(needed(${raw})?)?] },
        .Map(_, elem) -> quote {
            map_of_entries([Entry { key: ${name(m)}.key, value: ${text_read(elem, quote { ${name(m)}.raw }, depth + 1)} } for ${m} in members(needed(${raw})?)?])
        },
        .Named(n, _) -> quote { ${name(n)}.from_json_text(needed(${raw})?)? },
        rest -> quote { unreadable() },
    }
}

/// The code writing `v` of `kind` as JSON text.
fn text_write(kind: Kind, v: Code, depth: int) -> Code {
    let x = "x${depth}"
    let k = "k${depth}"
    match kind {
        .Int -> quote { int_text(${v}) },
        .Float -> quote { float_text(${v}) },
        .Str -> quote { quoted(${v}) },
        .Bool -> quote { bool_text(${v}) },
        .Opt(inner) -> quote {
            match ${v} {
                ${x}? -> ${text_write(inner, name(x), depth + 1)}
                null -> "null"
            }
        },
        .List(elem) -> quote { array_of([${text_write(elem, name(x), depth + 1)} for ${x} in ${v}]) },
        .Map(_, elem) -> quote { object_of([member_text(${name(k)}, ${text_write(elem, name(x), depth + 1)}) for ${k}, ${x} in ${v}]) },
        .Named(_, _) -> quote { ${v}.json_text() },
        rest -> quote { unwritable() },
    }
}

/// One arm of an enum's `json_text`: the tag, then each payload field.
fn text_write_arm(v: Variant) -> Arms {
    let bs = ["b${j}" for j in 0..v.fields.length]
    let tag = quote { member_text("tag", quoted(${literal(v.name)})) }
    let fields = [quote { member_text(${literal(f.name)}, ${text_write(f.kind, name(bs[j]), 0)}) } for j, f in v.fields]
    let members = listed([tag].concat(fields))
    if v.fields.is_empty() { return quote { .${v} -> object_of(${members}) } }
    quote { .${v}(${bs}) -> object_of(${members}) }
}

// ── Shape ────────────────────────────────────────────────────────

/// The code spelling a kind's shape. A record or enum it reads is
/// expanded in place, once down a path: met again, it is its name.
fn shape_code(kind: Kind) -> Code {
    match kind {
        .Int -> quote { "int" },
        .Float -> quote { "float" },
        .Str -> quote { "string" },
        .Bool -> quote { "bool" },
        .Opt(inner) -> quote { ${shape_code(inner)} + "?" },
        .List(elem) -> quote { "[" + ${shape_code(elem)} + "]" },
        .Map(_, elem) -> quote { "map<" + ${shape_code(elem)} + ">" },
        .Named(n, _) -> quote { if here.contains(${literal(n)}) { ${literal("~" + n)} } else { ${name(n)}.shape_in(here) } },
        rest -> quote { unwritable() },
    }
}

// ── Schema ───────────────────────────────────────────────────────

/// The JSON Schema of a record: an object, its properties, and every
/// field that is not optional required.
fn schema_of(t: Type) -> Code {
    let props = listed(
        [quote { field(${literal(f.name)}, ${kind_schema(f.kind)}) } for f in t.fields],
    )
    let required = listed(
        [quote { Json.Str(${literal(f.name)}) } for f in t.fields if !optional(f.kind)],
    )
    quote {
        Json.Obj([
            field("type", Json.Str("object")),
            field("properties", Json.Obj(${props})),
            field("required", Json.Arr(${required})),
        ])
    }
}

/// The schema of a field of `kind`: a named record by reference.
fn kind_schema(kind: Kind) -> Code {
    match kind {
        .Int -> typed("integer"),
        .Float -> typed("number"),
        .Str -> typed("string"),
        .Bool -> typed("boolean"),
        .Opt(inner) -> quote { Json.Obj([field("anyOf", Json.Arr([${kind_schema(inner)}, ${typed("null")}]))]) },
        .List(elem) -> quote { Json.Obj([field("type", Json.Str("array")), field("items", ${kind_schema(elem)})]) },
        .Map(_, elem) -> quote { Json.Obj([field("type", Json.Str("object")), field("additionalProperties", ${kind_schema(elem)})]) },
        .Named(n, _) -> if flat(n) { kind_schema(stored_scalar(n)!) } else { quote { Json.Obj([field("$ref", Json.Str(${literal("#/components/schemas/" + n)}))]) } },
        rest -> quote { unwritable() },
    }
}

fn typed(word: string) -> Code { quote { Json.Obj([field("type", Json.Str(${literal(word)}))]) } }

/// Whether a field may be absent. A PROJECTION: only `T?` answers.
fn optional(k: Kind) -> bool {
    match k { .Opt(_) -> true, rest -> false }
}

/// This record and every record it reads, transitively, each once, in
/// the order first reached — found here, where the derive runs, so a
/// record that reads itself adds nothing twice.
fn read_closure(t: Type) -> List<string> {
    mut seen = [t.name]
    mut at = 0
    while at < seen.length {
        let fields = if at == 0 { fields_of(t) } else { fields_of(type_named(seen[at])) }
        for n in [n for f in fields for n in records_read(f.kind)] {
            if !seen.contains(n) { seen = seen.concat([n]) }
        }
        at = at + 1
    }
    seen
}

// ── The shape a codec reads ──────────────────────────────────────

fn shape_problems(t: Type) -> List<Diagnostic> {
    [unreadable_field(t, f) for f in t.fields if !readable(f.kind)]
        .concat([unannotated(t, f, n) for f in t.fields for n in records_read(f.kind) if !coded(n)])
}

/// Every field a type reads: a record's own, an enum's across its variants.
fn fields_of(t: Type?) -> List<Field> {
    let d? = t else { return [] }
    d.fields.concat([f for v in d.variants for f in v.fields])
}

/// The records a field of this kind reads through — each must carry
/// its own `@json`.
fn records_read(k: Kind) -> List<string> {
    match k {
        .Named(n, _) -> if stored_scalar(n) == null { [n] } else { [] },
        .Opt(held) or .List(held) or .Map(_, held) -> records_read(held),
        rest -> [],
    }
}

/// Whether the record named `n` wears `@json` — or is not one this
/// program can see, which the typer then names.
fn coded(n: string) -> bool {
    let d? = type_named(n) else { return true }
    d.annotations.any(it.name == "json")
}

/// Whether a field of this kind has a JSON reading. A REGISTRY: every
/// kind answers.
fn readable(k: Kind) -> bool {
    match k {
        .Int or .Float or .Bool or .Str -> true,
        .Opt(inner) -> readable(inner),
        .List(elem) -> readable(elem),
        .Map(key, value) -> key is .Str && readable(value),
        .Named(_, args) -> args.is_empty(),
        .Ptr or .Void or .Cell(_) or .Result(_, _) or .Fn(_, _) or .Dyn(_) or .Var(_) or .Unspelled(_) -> false,
    }
}

// ── Voices ───────────────────────────────────────────────────────

/// What a declaration too wide to read is told to do.
const group_help: string = "group fields into a nested `@json` record"

fn unreadable_payload(t: Type, v: Variant, f: Field) -> Diagnostic {
    refuse_as_at(
        "unreadable_field",
        f.at,
        "`${t.name}.${v.name}`'s `${f.name}` is `${f.ty}`, which has no JSON reading",
        "a payload reads int, float, bool, string, `T?`, `List<T>`, `Map<string, T>`, or another `@json` record or enum",
    )
}

fn unannotated_payload(t: Type, v: Variant, f: Field, n: string) -> Diagnostic {
    refuse_as_at(
        "unannotated_record",
        f.at,
        "`${t.name}.${v.name}`'s `${f.name}` reads `${n}`, which does not wear `@json`",
        "write `@json` on `${n}` too",
    )
}

fn unannotated(t: Type, f: Field, n: string) -> Diagnostic {
    refuse_as_at(
        "unannotated_record",
        f.at,
        "`${t.name}.${f.name}` reads `${n}`, which does not wear `@json`",
        "write `@json` on `${n}` too",
    )
}

fn unreadable_field(t: Type, f: Field) -> Diagnostic {
    refuse_as_at(
        "unreadable_field",
        f.at,
        "`${t.name}.${f.name}` is `${f.ty}`, which has no JSON reading",
        "a field reads int, float, bool, string, `T?`, `List<T>`, or another `@json` record",
    )
}
