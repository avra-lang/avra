//! proves `produce` at capacity 0: the producer has no room to buffer, so
//! every `yield` parks until the `for` reads it — and the reads still
//! come in FIFO order.
use @std.task.{Source}

let pages = produce<int>(0) {
    yield 1
    yield 2
    yield 3
}
mut out: List<int> = []
// LICENSED loops.push_loop: a `Source` walk is a `for`, and its binder has no comprehension form here
for p in pages { out.push(p) }
out.map((n: int) -> "${n}").join(",")
