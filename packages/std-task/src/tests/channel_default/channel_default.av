//! `channel<T>()` takes the default `produce<T>` takes: rendezvous. A
//! non-parking `post` on an empty channel answers `.Full` only when the
//! capacity is 0 — an unbounded channel would buffer it and answer
//! `.Taken`. The default is the library's `open_channel<T>(0)`, never a
//! second meaning invented here.
use @std.task.{Channel, Posted}

let ch = channel<int>()
let posted = ch.sink.post(1)
let full = posted is .Full
ch.sink.close()
"${full}"
