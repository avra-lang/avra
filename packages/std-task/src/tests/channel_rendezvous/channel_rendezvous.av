//! `channel<T>(0)` hands each item straight to the reader: the sender
//! parks on every send until the main block takes it. The ordered
//! output is the handover, never a sum.
use @std.task.{Channel}

fn feed(ch: Channel<int>, n: int) {
    for i in 1..n {
        let _ = ch.sink.send(i)
    }
    ch.sink.close()
}

let ch = channel<int>(0)
let t = spawn feed(ch, 4)
mut out: List<int> = []
// LICENSED loops.push_loop: a `Source` walk is a `for`, and its binder has no comprehension form here
for v in ch.source { out.push(v) }
let _ = t.await
out.map((n: int) -> "${n}").join(",")
