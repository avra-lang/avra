//! A secret is a HANDLE, never the bytes. `Secret<T>` holds the key it
//! was read at and the generation it was read as; its text lives in the
//! process's secret store. So a secret prints as `<secret db.password v1>`
//! wherever it reaches — a log, an issue, an interpolation is refused
//! outright — because the value holds nothing to leak. Every read takes
//! a slot of its own, so two configs that name one path never share a
//! text.
//!
//!     password: Secret<string>          // a field of a config
//!     db.connect(password.reveal((t: string) -> t))
//!
//! `reveal` is the one door to the text a program reads, and it is
//! greppable. A SINK takes the handle itself and never hands the text
//! back: `@std.config.process`'s `with_secret_flag` and `with_secret_var`
//! give it to a child process, where every projection of the command
//! shows `<hidden>`.
use @std.meta.{sealed}
use @std.validate.{Decoding, Slot, Value, Hidden}
use @std.json.typed.{Path}

/// A handle to a secret's text: the path it was read at, its slot in the
/// store — every read takes a slot of its own, so two configs that name
/// one path keep two texts — and which generation of the slot it is.
@sealed
export type Secret<T> = { key: string, slot: int, generation: int }

impl Hidden for Secret<T> {}

/// The process's secret store: each slot's text, the slot its index.
once fn store() -> Cell<List<string>> { Cell.new([]) }

/// The text in `slot`; a slot no read made holds none.
fn text_of(slot: int) -> string {
    let all = store().get()
    if slot >= 0 && slot < all.length { all[slot] } else { "" }
}

/// `text` kept in a slot of its own, read at `key`.
fn kept<T>(key: string, text: string) -> Secret<T> {
    store().push(text)
    Secret { key: key, slot: store().get().length - 1, generation: 1 }
}

impl Secret<T> {
    /// Read as `@secret` is: what was received is never shown.
    static fn decoded(mut d: Decoding, s: Slot) -> Secret<T>? {
        let text? = d.text(s.secret()) else { return null }
        kept(s.at.text(), text)
    }

    /// Read from JSON text as `decoded` reads a slot: never shown, keyed by
    /// the path it stands at.
    static fn read_json(mut d: Decoding, depth: int, required: bool, _secret: bool, at: Path) -> Secret<
        T,
    >? {
        let text? = d.json_text(depth, required, true) else { return null }
        kept(at.text(), text)
    }

    /// The handle as a report reads it — never the text.
    fn value() -> Value { Value.Text(self.shown()) }

    /// `<secret key vN>`.
    fn shown() -> string { "<secret ${self.key} v${self.generation}>" }

    /// What `use_it` answers over the text the store holds now.
    fn reveal<A>(use_it: fn(string) -> A) -> A { use_it(text_of(self.slot)) }

    /// Whether `candidate` is the text, compared in time that depends
    /// on the lengths alone.
    fn matches(candidate: string) -> bool {
        let text = text_of(self.slot)
        if text.length != candidate.length { return false }
        [text.char_code(i) ^ candidate.char_code(i) for i in 0..text.length]
            .fold(0, (a: int, b: int) -> a | b) == 0
    }
}

