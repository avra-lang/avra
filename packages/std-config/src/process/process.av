//! The sinks that hand a secret to a child process: the text crosses
//! straight into the command, where every projection — the plan, a
//! script's match, an error, a failing child's echo — shows `<hidden>`.
//! Its own module, so a program that never runs a child never reads
//! `@std/process`.
use @std.process.{Command}
use secret.{Secret}

/// `c` with the secret as the option `name`'s value, one word the
/// child's argv holds and every projection of `c` shows as
/// `name=<hidden>`.
export fn with_secret_flag(c: Command, name: string, s: Secret<string>) -> Command {
    s.reveal((t: string) -> c.hidden_flag(name, t))
}

/// `c` with the secret as the variable `name`'s value in the child's
/// environment, which every projection of `c` shows as `NAME=<hidden>`.
export fn with_secret_var(c: Command, name: string, s: Secret<string>) -> Command {
    s.reveal((t: string) -> c.hidden_var(name, t))
}
