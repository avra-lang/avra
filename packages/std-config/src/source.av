//! A source: one place config is read from. Every source — a file, the
//! environment, the flags, a provider — answers the same trait, so the
//! list of them is the precedence, read left to right, the last winning.
use @std.validate.{FieldShape, FieldKind, Issues}
use layer.{Layer}
use origin.{joined}

export trait Source {
    /// What this source holds for the fields `want` names, each leaf
    /// with its origin — or every issue reading it found.
    fn read(want: Want) -> Result<Layer, Issues>

    /// Whether the source can change while the program runs.
    fn watch() -> Watch { Watch.Never }

    /// Whether the source is set where the process is launched (the
    /// environment, the flags): a stage's overlay is laid beneath it.
    fn at_launch() -> bool { false }

    /// The stage this source names the program to run under, if any.
    fn stage_named() -> string? { null }
}

/// Whether a source's values can change under a running program.
export enum Watch {
    Never
}

/// What a load asks of each source: the record's fields and the stage
/// it runs under ("" for none).
export type Want = { fields: List<FieldShape>, stage: string }

/// One leaf field of the record: its dotted path, what it holds, and
/// whether it is secret.
export type Leaf = { path: string, kind: FieldKind, secret: bool }

impl Want {
    /// Every leaf field, a nested record's fields under its name.
    fn leaves() -> List<Leaf> { leaves_under(self.fields, "") }
}

fn leaves_under(fields: List<FieldShape>, at: string) -> List<Leaf> {
    [leaves_of(f, joined(at, f.name)) for f in fields].flatten()
}

fn leaves_of(f: FieldShape, path: string) -> List<Leaf> {
    match f.kind {
        .Record(inner) -> leaves_under(inner, path),
        _ -> [Leaf { path: path, kind: f.kind, secret: f.secret }],
    }
}
