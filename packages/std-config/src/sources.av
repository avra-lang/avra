//! The built-in sources: a file, the environment, the flags, and a
//! directory of one file per leaf. Each is a component, so a config's
//! body lists them in precedence order:
//!
//!     @derive(Decode)
//!     component App {
//!         password: Secret<string>
//!         file "app.toml"
//!         dir "/run/secrets"
//!         env "SHOP"
//!         flags argv()
//!     }
//!
//! A leaf the environment or a flag sets is read from its text by the
//! kind the field holds, so the decode that follows stays strict.
use @std.io.{exists, read_text, list_dir, env as env_value}
use @std.text.{parse_int, parse_float, from_codepoint}
use @std.errors.{Error}
use @std.validate.{Value, Entry, Issue, Issues, FieldKind, from_json, from_toml, nearest}
use @std.json.typed.{Path}
use @std.validate.{root}
use layer.{Layer, nothing, layer_of}
use origin.{Origin, From}
use source.{Source, Want, Leaf}

/// A TOML or JSON file, read by its extension. A file that is not there
/// is a layer holding nothing, unless it is `required`.
export component file(path: string) {
    required: bool = false
}

impl Source for file {
    fn read(want: Want) -> Result<Layer, Issues> { file_layer(self.path, self.required) }
}

/// A file named for the stage the program runs under: `{stage}` in
/// `pattern` stands for its name (`overlay "app.{stage}.toml"`). Under
/// no stage it holds nothing; under one, it is that stage's file, read
/// as `file` reads one, each leaf's origin naming the stage. Only a
/// stage the config declares can name one, so no launch-time value
/// steers the path.
export component overlay(pattern: string) {
    required: bool = false
}

impl Source for overlay {
    fn read(want: Want) -> Result<Layer, Issues> {
        if !self.pattern.contains(stage_hole) { fail Issues { all: [overlay_unstaged(self.pattern)] } }
        if want.stage.is_empty() { return nothing() }
        let layer = file_layer(self.pattern.replace(stage_hole, want.stage), self.required)?
        layer with { origins: [o with { stage: want.stage } for o in layer.origins] }
    }
}

/// What a stage's name replaces in an overlay's pattern.
const stage_hole: string = "{stage}"

/// The TOML or JSON file at `path`, read by its extension; a file not
/// there holds nothing unless it is `required`.
fn file_layer(path: string, required: bool) -> Result<Layer, Issues> {
    if !exists(path) {
        if required { fail Issues { all: [missing_file(path)] } }
        return nothing()
    }
    let text = match read_text(path) {
        .Ok(t) -> t,
        .Err(e) -> { fail Issues { all: [unreadable(path, e.describe().message)] } },
    }
    let parsed = if path.ends_with(".json") { from_json(text) } else { from_toml(text) }
    let v = match parsed {
        .Ok(v) -> v,
        .Err(e) -> { fail Issues { all: [in_file(i, path) for i in e.all] } },
    }
    layer_of(v, From.File, path)
}

/// The environment: each leaf field is the variable `<PREFIX>__<PATH>`,
/// the path's steps upper-cased and joined by `__` — `db.pool` under
/// `SHOP` is `SHOP__DB__POOL`. `__` never occurs inside a step, so no
/// two paths name one variable. A leaf may instead be read from the
/// file `<VARIABLE>_FILE` names, as container platforms hand secrets
/// over; one trailing newline is not part of the value. Setting both is
/// an issue, and so is a `_FILE` variable that is also a leaf's own.
/// `only` reads a fixed environment in place of the process's, as a
/// test does.
export component env(prefix: string) {
    only: Map<string, string>? = null
}

impl Source for env {
    fn read(want: Want) -> Result<Layer, Issues> {
        let leaves = want.leaves()
        let names = [want.variables.find(it.path == l.path)?.name ?? variable_named(self.prefix, l.path) for l in leaves]
        let clashes = if want.variables.is_empty() { [] } else { [name_clash(leaves[names.index_of(n)].path, leaves[i].path, n) for i, n in names if names.index_of(n) < i] }
        if !clashes.is_empty() { fail Issues { all: clashes } }
        heard_layer([self.heard(l, names[i], names) for i, l in leaves], From.Env)
    }

    fn at_launch() -> bool { true }

    /// `<PREFIX>_STAGE`.
    fn stage_named() -> string? { self.looked("${shouted(self.prefix)}_STAGE") }
}

impl env {
    /// The variable `name`'s value, when it is set.
    fn looked(name: string) -> string? { if self.only == null { env_value(name) } else { self.only!.get(name) } }

    /// What the environment says of `leaf`, read from the variable
    /// `name`: the variable, or the file its `_FILE` variable names —
    /// never both — given every leaf's variable `names`, so a `_FILE`
    /// that is another leaf's own variable is told apart.
    fn heard(leaf: Leaf, name: string, names: List<string>) -> Heard {
        let carrier = "${name}_FILE"
        let direct = self.looked(name)
        let named? = self.looked(carrier) else {
            return if direct == null { Heard.Unset } else { Heard.Said(Said { leaf: leaf, at: name, text: direct! }) }
        }
        when {
            names.contains(carrier) -> Heard.Refused(file_twin(leaf.path, carrier))
            direct != null -> Heard.Refused(env_twice(leaf.path, name, carrier))
            !exists(named) -> Heard.Refused(carried_away(leaf.path, carrier, named))
            _ -> held(leaf, named, "${carrier} (${named})")
        }
    }
}

/// A directory holding one file per leaf, as a container platform
/// mounts secrets: the file named by the leaf's dotted path
/// (`db.password`) holds its value, one trailing newline aside. A name
/// beginning with `.` is the platform's own and is passed over; any
/// other name no leaf has is an issue. A directory that is not there is
/// a layer holding nothing, unless it is `required`.
export component dir(path: string) {
    required: bool = false
}

impl Source for dir {
    fn read(want: Want) -> Result<Layer, Issues> {
        if !exists(self.path) {
            if self.required { fail Issues { all: [missing_dir(self.path)] } }
            return nothing()
        }
        let names = match list_dir(self.path) {
            .Ok(ns) -> [n for n in ns if !n.starts_with(".")],
            .Err(e) -> { fail Issues { all: [unreadable(self.path, e.describe().message)] } },
        }
        let leaves = want.leaves()
        let paths = [l.path for l in leaves]
        let stray = [unknown_file(self.path, n, nearest(n, paths)) for n in names if !paths.contains(n)]
        if !stray.is_empty() { fail Issues { all: stray } }
        heard_layer(
            [held(l, "${self.path}/${l.path}", "${self.path}/${l.path}") for l in leaves if names.contains(l.path)],
            From.File,
        )
    }
}

/// What one source says of a leaf: nothing, a text, or why it cannot.
enum Heard {
    Unset
    Said(said: Said)
    Refused(why: Issue)
}

/// The leaf `leaf` as the file at `path` holds it, its origin `at`.
fn held(leaf: Leaf, path: string, at: string) -> Heard {
    match file_text(path) {
        .Ok(text) -> Heard.Said(Said { leaf: leaf, at: at, text: text }),
        .Err(why) -> Heard.Refused(why),
    }
}

/// The largest value a file holding one leaf may hold, in bytes.
const largest_leaf: int = 1048576

/// A file holding one leaf's value, its one trailing newline dropped.
fn file_text(path: string) -> Result<string, Issue> {
    if !exists(path) { fail missing_file(path) }
    let text = match read_text(path) {
        .Ok(t) -> t,
        .Err(e) -> { fail unreadable(path, e.describe().message) },
    }
    if text.length > largest_leaf { fail too_large(path, text.length) }
    when {
        text.ends_with("\r\n") -> text.substring(0, text.length - 2)
        text.ends_with("\n") -> text.substring(0, text.length - 1)
        _ -> text
    }
}

/// The layer `heard` sets, or every issue a leaf answered.
fn heard_layer(heard: List<Heard>, from: From) -> Result<Layer, Issues> {
    let refused = [i! for i in [refusal_of(h) for h in heard] if i != null]
    if !refused.is_empty() { fail Issues { all: refused } }
    said_layer([s! for s in [said_of(h) for h in heard] if s != null], from)
}

fn said_of(h: Heard) -> Said? {
    match h { .Said(s) -> s, .Unset or .Refused(_) -> null }
}

fn refusal_of(h: Heard) -> Issue? {
    match h { .Refused(i) -> i, .Unset or .Said(_) -> null }
}

/// The variable `path` is read from under `prefix`.
export fn variable_named(prefix: string, path: string) -> string {
    [shouted(s) for s in [prefix].concat(path.split("."))].join("__")
}

/// The program's flags: `--<path>=<value>` sets the leaf at `path`
/// (`--db.pool=20`), and `--stage=<name>` names the stage. A flag whose
/// name holds a `.` or begins at a field is this config's, and sets a
/// leaf or is an issue — a bare `--db.pool` included, since dropping it
/// would leave the value its author meant unset with nothing said. Any
/// other flag is another reader's and is left alone. A secret is never
/// set from a flag.
export component flags(args: List<string>) {}

impl Source for flags {
    fn read(want: Want) -> Result<Layer, Issues> {
        let leaves = want.leaves()
        let tops = [f.name for f in want.fields]
        let ours = [f for f in self.named() if f.name == "stage" || f.name.contains(".") || tops.contains(f.name)]
        let refused = [i! for i in [flag_refusal(f, leaves) for f in ours] if i != null]
        if !refused.is_empty() { fail Issues { all: refused } }
        said_layer(
            [Said { leaf: leaves.find(it.path == f.name)!, at: "--${f.name}", text: f.text! } for f in ours if f.name != "stage"],
            From.Flag,
        )
    }

    fn at_launch() -> bool { true }

    /// `--stage=<name>`.
    fn stage_named() -> string? { self.named().find(it.name == "stage")?.text }
}

impl flags {
    /// Every argument spelled as a flag, `--name=text` or a bare `--name`.
    fn named() -> List<Flag> { [f! for f in [flag_of(a) for a in self.args] if f != null] }
}

/// One `--name=text` argument; a bare `--name` holds no text.
type Flag = { name: string, text: string? }

fn flag_of(arg: string) -> Flag? {
    if !arg.starts_with("--") { return null }
    let eq = arg.index_of("=")
    if eq < 0 { return Flag { name: arg.substring(2, arg.length), text: null } }
    Flag { name: arg.substring(2, eq), text: arg.substring(eq + 1, arg.length) }
}

/// Why a flag of this config's sets nothing it may: no value, a record
/// where a leaf belongs, no field, or a secret.
fn flag_refusal(f: Flag, leaves: List<Leaf>) -> Issue? {
    let paths = [l.path for l in leaves]
    when {
        f.text == null -> flag_unset(f.name)
        f.name == "stage" -> null
        paths.contains(f.name) && leaves.any(it.path == f.name && it.secret) -> secret_flag(f.name)
        paths.contains(f.name) -> null
        paths.any(it.starts_with(f.name + ".")) -> flag_record(
            f.name,
            [p for p in paths if p.starts_with(f.name + ".")],
        )
        _ -> unknown_flag(f.name, nearest(f.name, paths))
    }
}

/// A leaf as one source spelled it: where, and the text.
type Said = { leaf: Leaf, at: string, text: string }

/// The leaves `said` sets, each read from its text by its kind — or
/// every text that spells no value of its kind.
fn said_layer(said: List<Said>, from: From) -> Result<Layer, Issues> {
    let wrong = [miss_spelled(s) for s in said if spelled(s.text, s.leaf.kind) == null]
    if !wrong.is_empty() { fail Issues { all: wrong } }
    mut v = Value.Map([])
    for s in said { v = placed(v, s.leaf.path.split("."), spelled(s.text, s.leaf.kind)!) }
    Layer { value: v, origins: [Origin { path: s.leaf.path, from: from, at: s.at } for s in said] }
}

/// `text` as the value a leaf of `kind` holds; null when it spells none.
/// A type read by its own decoder takes the text as it stands.
fn spelled(text: string, kind: FieldKind) -> Value? {
    match kind {
        .Text or .Other(_) -> Value.Text(text),
        .Int -> {
            let n? = parse_int(text) else { return null }
            Value.Int(n)
        },
        .Float -> {
            let x? = parse_float(text) else { return null }
            Value.Float(x)
        },
        .Bool -> when {
            text == "true" -> Value.Bool(true)
            text == "false" -> Value.Bool(false)
            _ -> null
        },
        .Record(_) or .Records(_) -> null,
    }
}

/// `v` with `leaf` set at `steps`, each map on the way made when absent.
fn placed(v: Value, steps: List<string>, leaf: Value) -> Value {
    if steps.is_empty() { return leaf }
    let entries = match v { .Map(es) -> es, _ -> [] }
    let below = entries.find(it.key == steps[0])?.value ?? Value.Map([])
    let set = Entry { key: steps[0], value: placed(below, steps.drop(1), leaf) }
    if entries.any(it.key == steps[0]) {
        Value.Map([if e.key == steps[0] { set } else { e } for e in entries])
    } else {
        Value.Map(entries.concat([set]))
    }
}

/// The path a dotted name reaches.
export fn path_of(dotted: string) -> Path {
    mut p = root()
    for s in dotted.split(".") { p = p.field(s) }
    p
}

/// `s` with each ASCII lowercase letter upper-cased.
fn shouted(s: string) -> string {
    [from_codepoint(if c >= 97 && c <= 122 { c - 32 } else { c }) for c in [s.char_code(i) for i in 0..s.length]]
        .join("")
}

/// What a leaf of `kind` must be, as an issue says it.
fn wanted(kind: FieldKind) -> string {
    match kind {
        .Text or .Other(_) -> "text",
        .Int -> "an integer",
        .Float -> "a number",
        .Bool -> "true or false",
        .Record(_) or .Records(_) -> "a value a file holds",
    }
}

// ── voices ──────────────────────────────────────────────────────

fn file_twin(path: string, carrier: string) -> Issue {
    Issue {
        path: path_of(path),
        rule: "config.file_twin",
        message: "${carrier} sets the field ${path}_file and would name the file holding ${path}: rename one of the fields",
    }
}

fn overlay_unstaged(pattern: string) -> Issue {
    Issue {
        path: root(),
        rule: "config.overlay_unstaged",
        message: "the overlay ${pattern} names no {stage}: a file read under every stage is a `file`",
    }
}

fn missing_dir(path: string) -> Issue {
    Issue {
        path: root(),
        rule: "config.file_missing",
        message: "the required directory ${path} is not there",
    }
}

fn carried_away(path: string, carrier: string, file: string) -> Issue {
    Issue {
        path: path_of(path),
        rule: "config.file_missing",
        message: "${carrier} names ${file}, which is not there",
    }
}

fn name_clash(first: string, path: string, name: string) -> Issue {
    Issue {
        path: path_of(path),
        rule: "config.name_clash",
        message: "is read from ${name}, which ${first} is read from too: one variable sets one leaf",
    }
}

fn env_twice(path: string, name: string, carrier: string) -> Issue {
    Issue {
        path: path_of(path),
        rule: "config.env_twice",
        message: "is set by both ${name} and ${carrier}: one variable says it",
    }
}

fn unknown_file(dir: string, name: string, near: string?) -> Issue {
    Issue {
        path: root(),
        rule: "config.unknown_file",
        message: "${dir}/${name} names no field",
        fix: if near == null { null } else { Value.Text(near!) },
    }
}

fn too_large(path: string, size: int) -> Issue {
    Issue {
        path: root(),
        rule: "config.too_large",
        message: "${path} holds ${size} bytes, and a file holding one value holds at most ${largest_leaf}",
    }
}

fn in_file(i: Issue, path: string) -> Issue { i with { message: "${i.message}, in ${path}" } }

fn missing_file(path: string) -> Issue {
    Issue {
        path: root(),
        rule: "config.file_missing",
        message: "the required file ${path} is not there",
    }
}

fn unreadable(path: string, why: string) -> Issue {
    Issue {
        path: root(),
        rule: "config.file_unread",
        message: "the file ${path} cannot be read: ${why}",
    }
}

fn miss_spelled(s: Said) -> Issue {
    Issue {
        path: path_of(s.leaf.path),
        rule: "config.spelling",
        message: "must be ${wanted(s.leaf.kind)}, as ${s.at} spells it",
        received: if s.leaf.secret { null } else { Value.Text(s.text) },
    }
}

fn unknown_flag(name: string, near: string?) -> Issue {
    Issue {
        path: path_of(name),
        rule: "config.unknown_flag",
        message: "--${name} names no field",
        fix: if near == null { null } else { Value.Text("--${near!}") },
    }
}

fn flag_unset(name: string) -> Issue {
    Issue {
        path: path_of(name),
        rule: "config.flag_unset",
        message: "--${name} sets nothing: a flag takes its value after `=`, as --${name}=<value>",
    }
}

fn flag_record(name: string, inside: List<string>) -> Issue {
    Issue {
        path: path_of(name),
        rule: "config.flag_record",
        message: "--${name} names a record, and a flag sets one leaf: ${["--${p}" for p in inside].join(", ")}",
    }
}

fn secret_flag(name: string) -> Issue {
    Issue {
        path: path_of(name),
        rule: "config.secret_argv",
        message: "is secret, and a secret is never set from a flag: every process can read argv",
    }
}
