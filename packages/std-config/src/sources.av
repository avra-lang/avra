//! The built-in sources: a file, the environment, the flags. Each is a
//! component, so a `config<T>` block lists them as its children, in
//! precedence order:
//!
//!     config<App> app {
//!         file "app.toml"
//!         env "SHOP"
//!         flags argv()
//!     }
//!
//! A leaf the environment or a flag sets is read from its text by the
//! kind the field holds, so the decode that follows stays strict.
use @std.io.{exists, read_text, env as variable}
use @std.text.{parse_int, parse_float, from_codepoint}
use @std.errors.{Error}
use @std.validate.{Value, Entry, Issue, Issues, FieldKind, from_json, from_toml, nearest}
use @std.json.typed.{Path}
use @std.validate.{root}
use layer.{Layer, nothing, layer_of}
use origin.{Origin, From}
use source.{Source, Want, Leaf}

/// A TOML or JSON file, read by its extension. A file that is not there
/// is a layer holding nothing, unless it is `required`.
export component file(path: string) {
    required: bool = false
}

impl Source for file {
    fn read(want: Want) -> Result<Layer, Issues> {
        if !exists(self.path) {
            if self.required { fail Issues { all: [missing_file(self.path)] } }
            return nothing()
        }
        let text = match read_text(self.path) {
            .Ok(t) -> t,
            .Err(e) -> { fail Issues { all: [unreadable(self.path, e.describe().message)] } },
        }
        let parsed = if self.path.ends_with(".json") { from_json(text) } else { from_toml(text) }
        let v = match parsed {
            .Ok(v) -> v,
            .Err(e) -> { fail Issues { all: [in_file(i, self.path) for i in e.all] } },
        }
        layer_of(v, From.File, self.path)
    }
}

/// The environment: each leaf field is the variable `<PREFIX>__<PATH>`,
/// the path's steps upper-cased and joined by `__` — `db.pool` under
/// `SHOP` is `SHOP__DB__POOL`. `__` never occurs inside a step, so no
/// two paths name one variable. `only` reads a fixed environment in
/// place of the process's, as a test does.
export component env(prefix: string) {
    only: Map<string, string>? = null
}

impl Source for env {
    fn read(want: Want) -> Result<Layer, Issues> {
        said_layer([s! for s in [self.said(l) for l in want.leaves()] if s != null], From.Env)
    }

    fn at_launch() -> bool { true }

    /// `<PREFIX>_STAGE`.
    fn stage_named() -> string? { self.looked("${shouted(self.prefix)}_STAGE") }
}

impl env {
    /// The variable `name`'s value, when it is set.
    fn looked(name: string) -> string? { if self.only == null { variable(name) } else { self.only!.get(name) } }

    /// The variable naming `leaf`, when it is set.
    fn said(leaf: Leaf) -> Said? {
        let name = variable_named(self.prefix, leaf.path)
        let text? = self.looked(name) else { return null }
        Said { leaf: leaf, at: name, text: text }
    }
}

/// The variable `path` is read from under `prefix`.
export fn variable_named(prefix: string, path: string) -> string {
    [shouted(s) for s in [prefix].concat(path.split("."))].join("__")
}

/// The program's flags: `--<path>=<value>` sets the leaf at `path`
/// (`--db.pool=20`), and `--stage=<name>` names the stage. A flag whose
/// name holds a `.` or begins at a field is this config's, and sets a
/// leaf or is an issue — a bare `--db.pool` included, since dropping it
/// would leave the value its author meant unset with nothing said. Any
/// other flag is another reader's and is left alone. A secret is never
/// set from a flag.
export component flags(args: List<string>) {}

impl Source for flags {
    fn read(want: Want) -> Result<Layer, Issues> {
        let leaves = want.leaves()
        let tops = [f.name for f in want.fields]
        let ours = [f for f in self.named() if f.name == "stage" || f.name.contains(".") || tops.contains(f.name)]
        let refused = [i! for i in [flag_refusal(f, leaves) for f in ours] if i != null]
        if !refused.is_empty() { fail Issues { all: refused } }
        said_layer(
            [Said { leaf: leaves.find(it.path == f.name)!, at: "--${f.name}", text: f.text! } for f in ours if f.name != "stage"],
            From.Flag,
        )
    }

    fn at_launch() -> bool { true }

    /// `--stage=<name>`.
    fn stage_named() -> string? { self.named().find(it.name == "stage")?.text }
}

impl flags {
    /// Every argument spelled as a flag, `--name=text` or a bare `--name`.
    fn named() -> List<Flag> { [f! for f in [flag_of(a) for a in self.args] if f != null] }
}

/// One `--name=text` argument; a bare `--name` holds no text.
type Flag = { name: string, text: string? }

fn flag_of(arg: string) -> Flag? {
    if !arg.starts_with("--") { return null }
    let eq = arg.index_of("=")
    if eq < 0 { return Flag { name: arg.substring(2, arg.length), text: null } }
    Flag { name: arg.substring(2, eq), text: arg.substring(eq + 1, arg.length) }
}

/// Why a flag of this config's sets nothing it may: no value, a record
/// where a leaf belongs, no field, or a secret.
fn flag_refusal(f: Flag, leaves: List<Leaf>) -> Issue? {
    let paths = [l.path for l in leaves]
    when {
        f.text == null -> flag_unset(f.name)
        f.name == "stage" -> null
        paths.contains(f.name) && leaves.any(it.path == f.name && it.secret) -> secret_flag(f.name)
        paths.contains(f.name) -> null
        paths.any(it.starts_with(f.name + ".")) -> flag_record(
            f.name,
            [p for p in paths if p.starts_with(f.name + ".")],
        )
        _ -> unknown_flag(f.name, nearest(f.name, paths))
    }
}

/// A leaf as one source spelled it: where, and the text.
type Said = { leaf: Leaf, at: string, text: string }

/// The leaves `said` sets, each read from its text by its kind — or
/// every text that spells no value of its kind.
fn said_layer(said: List<Said>, from: From) -> Result<Layer, Issues> {
    let wrong = [miss_spelled(s) for s in said if spelled(s.text, s.leaf.kind) == null]
    if !wrong.is_empty() { fail Issues { all: wrong } }
    mut v = Value.Map([])
    for s in said { v = placed(v, s.leaf.path.split("."), spelled(s.text, s.leaf.kind)!) }
    Layer { value: v, origins: [Origin { path: s.leaf.path, from: from, at: s.at } for s in said] }
}

/// `text` as the value a leaf of `kind` holds; null when it spells none.
/// A type read by its own decoder takes the text as it stands.
fn spelled(text: string, kind: FieldKind) -> Value? {
    match kind {
        .Text or .Other(_) -> Value.Text(text),
        .Int -> {
            let n? = parse_int(text) else { return null }
            Value.Int(n)
        },
        .Float -> {
            let x? = parse_float(text) else { return null }
            Value.Float(x)
        },
        .Bool -> when {
            text == "true" -> Value.Bool(true)
            text == "false" -> Value.Bool(false)
            _ -> null
        },
        .Record(_) or .Records(_) -> null,
    }
}

/// `v` with `leaf` set at `steps`, each map on the way made when absent.
fn placed(v: Value, steps: List<string>, leaf: Value) -> Value {
    if steps.is_empty() { return leaf }
    let entries = match v { .Map(es) -> es, _ -> [] }
    let below = entries.find(it.key == steps[0])?.value ?? Value.Map([])
    let set = Entry { key: steps[0], value: placed(below, steps.drop(1), leaf) }
    if entries.any(it.key == steps[0]) {
        Value.Map([if e.key == steps[0] { set } else { e } for e in entries])
    } else {
        Value.Map(entries.concat([set]))
    }
}

/// The path a dotted name reaches.
export fn path_of(dotted: string) -> Path {
    mut p = root()
    for s in dotted.split(".") { p = p.field(s) }
    p
}

/// `s` with each ASCII lowercase letter upper-cased.
fn shouted(s: string) -> string {
    [from_codepoint(if c >= 97 && c <= 122 { c - 32 } else { c }) for c in [s.char_code(i) for i in 0..s.length]]
        .join("")
}

/// What a leaf of `kind` must be, as an issue says it.
fn wanted(kind: FieldKind) -> string {
    match kind {
        .Text or .Other(_) -> "text",
        .Int -> "an integer",
        .Float -> "a number",
        .Bool -> "true or false",
        .Record(_) or .Records(_) -> "a value a file holds",
    }
}

// ── voices ──────────────────────────────────────────────────────

fn in_file(i: Issue, path: string) -> Issue { i with { message: "${i.message}, in ${path}" } }

fn missing_file(path: string) -> Issue {
    Issue {
        path: root(),
        rule: "config.file_missing",
        message: "the required file ${path} is not there",
    }
}

fn unreadable(path: string, why: string) -> Issue {
    Issue {
        path: root(),
        rule: "config.file_unread",
        message: "the file ${path} cannot be read: ${why}",
    }
}

fn miss_spelled(s: Said) -> Issue {
    Issue {
        path: path_of(s.leaf.path),
        rule: "config.spelling",
        message: "must be ${wanted(s.leaf.kind)}, as ${s.at} spells it",
        received: if s.leaf.secret { null } else { Value.Text(s.text) },
    }
}

fn unknown_flag(name: string, near: string?) -> Issue {
    Issue {
        path: path_of(name),
        rule: "config.unknown_flag",
        message: "--${name} names no field",
        fix: if near == null { null } else { Value.Text("--${near!}") },
    }
}

fn flag_unset(name: string) -> Issue {
    Issue {
        path: path_of(name),
        rule: "config.flag_unset",
        message: "--${name} sets nothing: a flag takes its value after `=`, as --${name}=<value>",
    }
}

fn flag_record(name: string, inside: List<string>) -> Issue {
    Issue {
        path: path_of(name),
        rule: "config.flag_record",
        message: "--${name} names a record, and a flag sets one leaf: ${["--${p}" for p in inside].join(", ")}",
    }
}

fn secret_flag(name: string) -> Issue {
    Issue {
        path: path_of(name),
        rule: "config.secret_argv",
        message: "is secret, and a secret is never set from a flag: every process can read argv",
    }
}
