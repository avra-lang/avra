//! @std.config — typed config: a component declaration's fields are the
//! schema, its body the sources it is read from, in precedence order.
//!
//!     @derive(Decode)
//!     component App {
//!         @range(1, 65535) port: int = 8080
//!         db: Db = Db {}
//!         password: Secret<string>
//!
//!         file "app.toml"
//!         env "SHOP"
//!         flags argv()
//!         stage prod {
//!             file "app.prod.toml"
//!         }
//!     }
//!
//!     let app = App.load()?.value
//!
//! Each source is read into one `Value` layer; the layers stack leaf by
//! leaf, the last winning, and the stack decodes ONCE, so every issue in
//! every layer is reported together and an unknown key is an issue. A
//! stage's sources are laid after the files and beneath the environment
//! and the flags. Every leaf keeps where it came from (`origins`), and
//! `explain()` prints them.
//!
//! ```
//! config.av  this file — the composer, stages, loading, the report
//! source.av  the `Source` trait
//! sources.av file, env, flags
//! layer.av   layers and how they stack
//! origin.av  where a value came from
//! secret.av  `Secret<T>`, a handle into the process's secret store
//! ```
use @std.meta.{
    Type,
    Field,
    Kind,
    Directive,
    Declared,
    Diagnostic,
    composes,
    name,
    implements,
    refuse_as_at,
    type_named,
    marks,
    unbranched,
    literal,
    Named,
    Marker,
    Code,
}
use @std.json.reading.{inner, literal_list}
use @std.text.{pad_right, cells, nul_at}
use @std.errors.{Error, ErrorInfo, info}
use @std.validate.{Value, Issue, Issues, FieldShape, root, secret}
use @std.json.typed.{Path}
use layer.{Stack, Layer, bottom}
use origin.{Origin, From, covers, joined}
use source.{Source, Want, Leaf, Variable}
use sources.{path_of}

/// A stage's overlay: the sources read when the program runs under its
/// name (`stage prod { file "app.prod.toml" }`).
export component stage {
    name: string = ""
    sources: List<dyn Source> = []
}

/// What a config component's body declares: its sources, in order, and
/// its stages.
export component sourced {
    sources: List<dyn Source> = []
    stages: List<stage> = []
}

/// What `Configured` adds to a component's fields: nothing.
export type Unsourced = {}

/// A COMPONENT WITH A BODY OF SOURCES IS A CONFIG: the compiler derives
/// this trait over it, and the body becomes `sourced()`.
@composes(Unsourced)
export trait Configured {
    /// The sources and stages the body declares.
    static fn sourced() -> sourced

    /// The config, read under the stage its sources name.
    static fn load() -> Result<Loaded<Self>, Unloaded>

    /// The config, read under the stage `named` ("" for none).
    static fn load_as(named: string) -> Result<Loaded<Self>, Unloaded>

    /// Each field read from an exact variable: its dotted path and the
    /// name its `@variable` claims.
    static fn variables() -> List<Variable>

    static fn derive(t: Type) -> Declared {
        let body? = t.body else { return Declared { made: [] } }
        Declared {
            problems: [secret_text(x.field, x.path) for x in texts_marked_secret(t.fields, "", [t.name])]
                .concat(claim_problems(claimed(t.fields, "", [t.name]))),
            made: [
                Directive {
                    twin: "",
                    name: t.name,
                    at: t.at,
                    source: quote {
                        impl Configured for ${t} {
                            static fn sourced() -> sourced {
                                sourced made {
                                    ${body}
                                }
                                made
                            }

                            static fn load() -> Result<Loaded<${t}>, Unloaded> {
                                loaded(${name(t.name)}.sourced(), ${name(t.name)}.fields(), (v) -> ${name(t.name)}.decode(v), (c) -> c.value(), ${name(t.name)}.variables(), null)
                            }

                            static fn variables() -> List<Variable> { ${variables_code(t)} }

                            static fn load_as(named: string) -> Result<Loaded<${t}>, Unloaded> {
                                loaded(${name(t.name)}.sourced(), ${name(t.name)}.fields(), (v) -> ${name(t.name)}.decode(v), (c) -> c.value(), ${name(t.name)}.variables(), named)
                            }
                        }
                    },
                },
            ],
        }
    }
}

/// A config read: its value, every leaf's origin, the origins later
/// layers replaced, the stage it ran under, and each leaf as a report
/// shows it.
export type Loaded<T> = { value: T, origins: List<Origin>, shadowed: List<Origin>, stage: StageName, rows: List<Row> }

/// The name of the stage a config was read under ("" for none): read —
/// printed, interpolated into a metric's label — and never chosen by
/// (`type.unbranched`). What differs by stage is a field the stage's
/// sources set. `label()` is the one door to it as plain text, for a
/// caller that must hand text on.
@unbranched
export type StageName = string

impl StageName {
    /// The name as plain text.
    fn label() -> string { "${self}" }
}

/// One leaf of a report: its path, its value as shown — a secret never
/// — and where it came from.
export type Row = { path: string, shown: string, origin: Origin }

impl Loaded<T> {
    /// Where the leaf at `path` came from.
    fn origin_of(path: string) -> Origin? { self.origins.find(it.path == path) }

    /// Every leaf, its value and its origin, one a line; then each
    /// value a later layer replaced.
    fn explain() -> string {
        let paths = widest([r.path for r in self.rows])
        let shown = widest([r.shown for r in self.rows])
        let lines = [explained(r, paths, shown) for r in self.rows]
        let replaced = [replaced_line(o) for o in self.shadowed]
        lines.concat(replaced).join("\n")
    }
}

/// A config that could not be read: every issue, and the origins of
/// the layers that were read, so each issue says where its value came
/// from.
export type Unloaded = { issues: Issues, origins: List<Origin> }

impl Unloaded {
    /// One issue a line, each with the origin of the value it judged.
    fn report() -> string {
        let paths = widest([i.path.text() for i in self.issues.all])
        [self.issue_line(i, paths) for i in self.issues.all].join("\n")
    }

    fn issue_line(i: Issue, paths: int) -> string {
        let from = self.origins.find(it.path == i.path.text())
        let got = if i.received == null { "" } else { "  got ${i.received!.shown()}" }
        let place = if from == null { "" } else { "  (${from!.from.word()} ${from!.place()})" }
        "  ${pad_right(shown_path(i.path), paths)}  ${i.message}  ${i.rule}${got}${place}"
    }
}

impl Error for Unloaded {
    fn describe() -> ErrorInfo { info("config.unloaded", unloaded(self.issues.all.length)) }
}

/// The config `fields` describes, read from `s`'s sources under the
/// stage `named` — or, when it is null, the stage the LAST source naming
/// one names, as a later source wins everywhere.
export fn loaded<T>(
    s: sourced,
    fields: List<FieldShape>,
    decode: fn(Value) -> Result<T, Issues>,
    encode: fn(T) -> Value,
    variables: List<Variable>,
    named: string?,
) -> Result<Loaded<T>, Unloaded> {
    let under = named ?? [x.stage_named()! for x in s.sources if x.stage_named() != null].last() ?? ""
    let overlay = s.stages.find(it.name == under)
    if !under.is_empty() && overlay == null {
        fail Unloaded {
            issues: Issues { all: [unknown_stage(under, [x.name for x in s.stages])] },
            origins: [],
        }
    }
    let want = Want { fields: fields, stage: under, variables: variables }
    let read = stacked(laid_order(s.sources, overlay?.sources ?? []), want, under)
    let value = match decode(read.stack.top.value) {
        .Ok(v) -> v,
        .Err(e) -> {
            fail Unloaded {
                issues: Issues { all: read.issues.concat(read.unsaid(e.all)) },
                origins: read.standing(),
            }
        },
    }
    if !read.issues.is_empty() { fail Unloaded { issues: Issues { all: read.issues }, origins: read.standing() } }
    let leaves = want.leaves()
    let origins = read.stack.top.origins.concat(defaulted(leaves, read.stack.top.origins))
    Loaded {
        value: value,
        origins: origins,
        shadowed: read.stack.shadowed,
        stage: StageName(under),
        rows: [row(l, encode(value), origins) for l in leaves],
    }
}

/// The sources in the order they are laid: those set at launch go on
/// top of the stage's overlay, everything else beneath it.
fn laid_order(base: List<dyn Source>, overlay: List<dyn Source>) -> List<Laid> {
    let first = [i for i, x in base if x.at_launch()].first() ?? base.length
    laid(base.take(first), false).concat(laid(overlay, true)).concat(laid(base.drop(first), false))
}

fn laid(xs: List<dyn Source>, staged: bool) -> List<Laid> { [Laid { source: x, staged: staged } for x in xs] }

/// A source in the laid order, and whether a stage's overlay holds it.
type Laid = { source: dyn Source, staged: bool }

/// Every layer read and stacked, and every issue a source answered.
type Read = { stack: Stack, issues: List<Issue> }

impl Read {
    /// The decode's issues a source's own issue has not already said: a
    /// leaf whose source was refused reads as unset to the decode, and
    /// one mistake is one message.
    fn unsaid(judged: List<Issue>) -> List<Issue> {
        let refused = [i.path.text() for i in self.issues]
        [j for j in judged if !refused.any(covers(it, j.path.text()))]
    }

    /// The origins an issue may be told beside: none at a path a
    /// source's own issue names, since that source's layer never stood
    /// and the origin beneath it is not where the judged value came from.
    fn standing() -> List<Origin> {
        let refused = [i.path.text() for i in self.issues]
        [o for o in self.stack.top.origins if !refused.any(covers(it, o.path))]
    }
}

fn stacked(order: List<Laid>, want: Want, under: string) -> Read {
    mut stack = bottom()
    mut issues: List<Issue> = []
    for l in order {
        match l.source.read(want) {
            .Ok(layer) -> { stack = stack.laid(marked(layer, l.staged, under)) },
            .Err(e) -> { issues = issues.concat(e.all) },
        }
    }
    Read { stack: stack, issues: issues }
}

/// `layer` with each origin marked as the stage's when its source is.
fn marked(layer: Layer, staged: bool, under: string) -> Layer {
    if !staged { return layer }
    layer with { origins: [o with { stage: under } for o in layer.origins] }
}

/// An origin for every leaf no layer set: the default spoke.
fn defaulted(leaves: List<Leaf>, set: List<Origin>) -> List<Origin> {
    [Origin { path: l.path, from: From.Default, at: "" } for l in leaves if !set.any(covers(it.path, l.path))]
}

/// A leaf's report line: its value as the config holds it — a secret
/// as its handle, never its text — and its origin.
fn row(l: Leaf, v: Value, origins: List<Origin>) -> Row {
    let shown = if l.secret { "<secret>" } else { v.at(path_of(l.path))?.shown() ?? "null" }
    Row { path: l.path, shown: shown, origin: origins.find(covers(it.path, l.path))! }
}

fn explained(r: Row, paths: int, shown: int) -> string {
    let at = r.origin.place()
    let line = "${pad_right(r.path, paths)}  ${pad_right(r.shown, shown)}  ${r.origin.from.word()}"
    if at.is_empty() { line } else { "${line}  ${at}" }
}

/// The widest of the texts, for a column.
fn widest(texts: List<string>) -> int { texts.fold(0, (w: int, t: string) -> if cells(t) > w { cells(t) } else { w }) }

fn shown_path(p: Path) -> string { if p.up.is_empty() { "(value)" } else { p.text() } }

/// A field and its dotted path from the config's root.
type Placed = { field: Field, path: string }

/// A field read from the environment variable `name` exactly, in place of
/// the `<PREFIX>__<PATH>` its path derives — for a name already in use
/// (`@variable("AVRA_CACHE_DIR") cache_dir: string? = null`). Two fields
/// claiming one name are refused where they are declared.
// LICENSED fns.dead_parameter: a mark's fn wears the mark's argument list, which its derive reads
export fn variable(_d: Named, name: string) -> Marker { Marker {} }

/// A field wearing `@variable`, at its dotted path, and the name it
/// claims — null where the mark names none.
type Claim = { field: Field, path: string, name: string?, record: bool }

/// Every field under `fields` wearing `@variable`, a dependency's
/// record's fields among them, each record walked once.
fn claimed(fields: List<Field>, at: string, seen: List<string>) -> List<Claim> {
    [claims_of(f, joined(at, f.name), seen) for f in fields].flatten()
}

fn claims_of(f: Field, path: string, seen: List<string>) -> List<Claim> {
    let below = record_below(f, seen)
    let own = [Claim { field: f, path: path, name: claimed_name(m.args), record: below != null } for m in f.marks if m.name == "variable"]
    if below == null { return own }
    own.concat(claimed(below!.fields, path, seen.concat([below!.name])))
}

/// The record a field holds, when it is one not walked already.
fn record_below(f: Field, seen: List<string>) -> Type? {
    let k = inner(f.kind)
    if hides(k) { return null }
    match k { .Named(n, _) -> if seen.contains(n) { null } else { type_named(n) }, _ -> null }
}

/// A mark's one argument as the text it spells; none where it could
/// name no variable — empty, or holding `=` or a NUL.
fn claimed_name(args: List<string>) -> string? {
    let word? = args.first() else { return null }
    let spelled = if word.length >= 2 && word.starts_with("\"") && word.ends_with("\"") { word.substring(1, word.length - 1) } else { word }
    if spelled.is_empty() || spelled.contains("=") || nul_at(spelled) >= 0 { null } else { spelled }
}

/// Every claim that cannot stand: one naming nothing, one on a record,
/// and the second of two claiming one name.
fn claim_problems(claims: List<Claim>) -> List<Diagnostic> {
    let named = [c for c in claims if c.name != null && !c.record]
    [claim_problem(c, named) for c in claims].filter(it != null).map(it!)
}

fn claim_problem(c: Claim, named: List<Claim>) -> Diagnostic? {
    when {
        c.name == null -> variable_unnamed(c.field, c.path)
        c.record -> variable_record(c.field, c.path)
        _ -> {
            let first? = named.find(it.name == c.name) else { return null }
            if first.path == c.path { null } else { variable_twice(c.field, c.path, first.path, c.name!) }
        }
    }
}

/// The claims as the list literal a load hands the environment.
fn variables_code(t: Type) -> Code {
    literal_list(
        [quote { Variable { path: ${literal(c.path)}, name: ${literal(c.name!)} } } for c in claimed(t.fields, "", [t.name]) if c.name != null && !c.record],
    )
}

/// Every field under `fields` that wears `@secret` and holds its text —
/// a dependency's record's fields among them, each record walked once.
fn texts_marked_secret(fields: List<Field>, at: string, seen: List<string>) -> List<Placed> {
    [placed_texts(f, joined(at, f.name), seen) for f in fields].flatten()
}

fn placed_texts(f: Field, path: string, seen: List<string>) -> List<Placed> {
    let k = inner(f.kind)
    if hides(k) { return [] }
    if f.annotations.any(marks(it, secret)) { return [Placed { field: f, path: path }] }
    match k {
        .Named(n, _) -> {
            let below? = type_named(n) else { return [] }
            if seen.contains(n) { return [] }
            texts_marked_secret(below.fields, path, seen.concat([n]))
        },
        _ -> [],
    }
}

/// Whether a field's type hides its value itself, as `Secret<T>` does.
fn hides(k: Kind) -> bool {
    match k { .Named(n, _) -> implements(n, "Hidden"), _ -> false }
}

// ── voices ──────────────────────────────────────────────────────

fn variable_unnamed(f: Field, path: string) -> Diagnostic {
    refuse_as_at(
        "config_variable_unnamed",
        f.at,
        "`@variable` on `${path}` names no variable",
        "name it in a literal — `@variable(\"AVRA_CACHE_DIR\")`",
    )
}

fn variable_record(f: Field, path: string) -> Diagnostic {
    refuse_as_at(
        "config_variable_record",
        f.at,
        "`@variable` on `${path}` names a record, and a variable sets one leaf",
        "move the mark to the leaf it names, inside the record",
    )
}

fn variable_twice(f: Field, path: string, first: string, name: string) -> Diagnostic {
    refuse_as_at(
        "config_variable_twice",
        f.at,
        "`${path}` claims the variable ${name}, which `${first}` claims already: one variable sets one leaf",
        "give one of the two another name",
    )
}

fn secret_text(f: Field, path: string) -> Diagnostic {
    refuse_as_at(
        "config_secret_text",
        f.at,
        "`${path}` is marked `@secret` and holds its text: every copy of the config, and its `value()`, carries it",
        "declare it `${f.name}: Secret<${f.ty}>`, a handle whose text only `reveal` reads",
    )
}

fn replaced_line(o: Origin) -> string { "${o.path} was also set by ${o.from.word()} ${o.place()}, which a later source replaced" }

fn unloaded(n: int) -> string { if n == 1 { "the config could not be read: 1 issue" } else { "the config could not be read: ${n} issues" } }

fn unknown_stage(name: string, known: List<string>) -> Issue {
    Issue {
        path: root(),
        rule: "config.unknown_stage",
        message: "names the stage ${name}, and the config declares ${if known.is_empty() { "none" } else { known.join(", ") }}",
    }
}
