//! Where each value came from: a leaf's path, the kind of source that
//! set it, and where in that source — a file, a variable, a flag.

/// The kind of source a value came from.
export enum From {
    Default
    File
    Env
    Flag
}

impl From {
    /// The word a report prints.
    fn word() -> string {
        match self { .Default -> "default", .File -> "file", .Env -> "env", .Flag -> "flag" }
    }
}

/// One leaf's provenance: its dotted path, the source kind, where in
/// that source, the stage whose overlay set it ("" for none), and the
/// source's version of it (null where the source keeps none).
export type Origin = { path: string, from: From, at: string, stage: string = "", version: string? = null }

impl Origin {
    /// Where in its source, with the stage it came under.
    fn place() -> string { if self.stage.is_empty() { self.at } else { "${self.at} (stage ${self.stage})" } }
}

/// Whether setting `over` replaces what stood at `under`: the same
/// leaf, or one path inside the other.
export fn covers(over: string, under: string) -> bool {
    over == under || under.starts_with(over + ".") || over.starts_with(under + ".")
}

/// `step` below the dotted path `at`.
export fn joined(at: string, step: string) -> string { if at.is_empty() { step } else { "${at}.${step}" } }
