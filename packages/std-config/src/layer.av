//! A layer: what one source holds, as one `Value` tree, and the origin
//! of each leaf it sets. Layers stack leaf by leaf — a map merges key by
//! key, anything else (a list included) replaces whole — and a leaf a
//! later layer replaces is kept as SHADOWED, so a report says which
//! layer lost.
use @std.validate.{Value, Entry}
use origin.{Origin, From, covers, joined}

export type Layer = { value: Value, origins: List<Origin> }

/// The layer of a source that holds nothing.
export fn nothing() -> Layer { Layer { value: Value.Map([]), origins: [] } }

/// A value read from one place, every leaf's origin that place.
export fn layer_of(v: Value, from: From, at: string) -> Layer {
    Layer { value: v, origins: [Origin { path: p, from: from, at: at } for p in leaves(v, "")] }
}

/// Every layer laid so far, and the origins later layers replaced.
export type Stack = { top: Layer, shadowed: List<Origin> }

/// The empty stack.
export fn bottom() -> Stack { Stack { top: nothing(), shadowed: [] } }

impl Stack {
    /// `over` laid on top.
    fn laid(over: Layer) -> Stack {
        let replaced = (o: Origin) -> over.origins.any(covers(it.path, o.path))
        Stack {
            top: Layer {
                value: merged(self.top.value, over.value),
                origins: [o for o in self.top.origins if !replaced(o)].concat(over.origins),
            },
            shadowed: self.shadowed.concat([o for o in self.top.origins if replaced(o)]),
        }
    }
}

/// `over` on `under`: two maps merge key by key, in `under`'s order
/// then `over`'s new keys; anything else is `over`.
fn merged(under: Value, over: Value) -> Value {
    match over {
        .Map(top) -> match under {
            .Map(low) -> Value
                .Map(
                    [kept(e, top) for e in low]
                        .concat([e for e in top if !low.any(it.key == e.key)]),
                ),
            _ -> over,
        },
        _ -> over,
    }
}

/// `e` with the entry of its key in `top` merged over it.
fn kept(e: Entry, top: List<Entry>) -> Entry {
    let t? = top.find(it.key == e.key) else { return e }
    Entry { key: e.key, value: merged(e.value, t.value) }
}

/// The dotted path of every leaf under `v`: each value that is not a
/// map, a list included.
export fn leaves(v: Value, at: string) -> List<string> {
    match v {
        .Map(entries) -> [leaves(e.value, joined(at, e.key)) for e in entries].flatten(),
        _ -> [at],
    }
}
