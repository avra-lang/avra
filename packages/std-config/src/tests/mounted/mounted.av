// proves: secrets arrive the ways container platforms hand them over and leave only through a sink —
// a mounted directory of one file per leaf (its platform's own dot-names passed over), a variable's
// `_FILE` naming the file that holds it, one trailing newline dropped, the origin naming the file;
// a secret given to a child as a flag and as a variable, every projection of the command showing
// `<hidden>`; and each way it goes wrong refused in its own words.
use @std.meta.{derive}
use @std.io.{write_text, make_dirs, env_or}
use @std.time.{stamp}
use @std.text.{repeat}
use @std.validate.{Decode}
use @std.process.{cmd, tool_at, scripted, run_through}
use @std.errors.{Error}
use @std.config.{Configured, Secret, dir, env}
use @std.config.process.{with_secret_flag, with_secret_var}

once fn run_base() -> string { "${env_or("TMPDIR", "/tmp")}/avra-config-mounted/${stamp()}" }

@derive(Decode)
type Db = { url: string = "u", password: Secret<string> }

@derive(Decode)
component Shop {
    db: Db
    token: Secret<string>
    workers: int = 1
    dir "${run_base()}/secrets"
    env "SHOP" { only: {"SHOP__TOKEN_FILE": "${run_base()}/token", "SHOP__WORKERS": "4"} }
}

@derive(Decode)
component Twice {
    token: Secret<string>
    env "T" { only: {"T__TOKEN": "a", "T__TOKEN_FILE": "${run_base()}/token"} }
}

@derive(Decode)
component Twin {
    key: string = ""
    key_file: string = ""
    env "W" { only: {"W__KEY_FILE": "x"} }
}

@derive(Decode)
component Stray {
    token: string = ""
    dir "${run_base()}/stray"
}

@derive(Decode)
component Huge {
    token: string = ""
    dir "${run_base()}/huge"
}

@derive(Decode)
component Gone {
    token: string = ""
    env "G" { only: {"G__TOKEN_FILE": "${run_base()}/none"} }
    dir "${run_base()}/none" { required: true }
}

fn loaded() -> string {
    match Shop.load() {
        .Ok(c) -> {
            let call = with_secret_var(
                with_secret_flag(
                    cmd(tool_at("curl", "/usr/bin/curl"), ["-s"]),
                    "--token",
                    c.value.token,
                ),
                "DB_PASSWORD",
                c.value.db.password,
            )
            let said = match run_through(scripted([]), call) {
                .Ok(_) -> "ran",
                .Err(e) -> e.describe().message,
            }
            let reached = "${call.args.length} ${call.args[1].length} ${call.env.get("DB_PASSWORD")!.length}"
            "${c.explain()}\n${said}\n${call.shown_env().filter(it.starts_with("DB_")).join(" ")}\nreached the child: ${reached}"
        },
        .Err(e) -> e.report(),
    }
}

fn refused(r: string) -> string { r }

fn report_of(e: string) -> string { e }

let _ = make_dirs("${run_base()}/secrets")
let _ = make_dirs("${run_base()}/stray")
let _ = make_dirs("${run_base()}/huge")
let _ = write_text("${run_base()}/secrets/db.password", "hunter2\n")
let _ = write_text("${run_base()}/secrets/db.url", "postgres://db/shop")
let _ = write_text("${run_base()}/secrets/..data", "the platform's own")
let _ = write_text("${run_base()}/token", "tok-123\r\n")
let _ = write_text("${run_base()}/stray/tokn", "x")
let _ = write_text("${run_base()}/huge/token", repeat("x", 1048577))
let twice = match Twice.load() { .Ok(_) -> "loaded", .Err(e) -> e.report() }
let twin = match Twin.load() { .Ok(_) -> "loaded", .Err(e) -> e.report() }
let stray = match Stray.load() { .Ok(_) -> "loaded", .Err(e) -> e.report() }
let huge = match Huge.load() { .Ok(_) -> "loaded", .Err(e) -> e.report() }
let gone = match Gone.load() { .Ok(_) -> "loaded", .Err(e) -> e.report() }
let all = "${loaded()}\n\n${twice}\n${twin}\n${stray}\n${huge}\n${gone}"
"${all.replace(run_base(), "<dir>")}\nthe text shown: ${all.contains("hunter2") || all.contains("tok-123")}"
