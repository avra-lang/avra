// The red team's findings against a config load, each a case that failed before its fix or held
// when attacked: a secret through every channel, precedence at its edges, flags spelled every way,
// provenance under a failing layer, and degenerate files.
use @std.meta.{derive}
use @std.io.{write_text, write_bytes, make_dirs, env_or}
use @std.time.{stamp}
use @std.text.{repeat}
use @std.validate.{Decode}
use @std.config.{Configured, Secret, file, env, flags, stage, dir, overlay, variable}
use @std.config.process.{with_secret_var}
use @std.process.{cmd, tool_at}

once fn run_base() -> string { "${env_or("TMPDIR", "/tmp")}/avra-config-adversarial/${stamp()}" }

/// Every fixture file, written once before the first case reads one.
once fn written() -> string {
    let d = run_base()
    let _ = make_dirs(d)
    let _ = write_text("${d}/base.toml", "[db]\npool = 1\n")
    let _ = write_text("${d}/prod.toml", "[db]\npool = 40\n")
    let _ = write_text("${d}/qa.toml", "[db]\npool = 7\n")
    let _ = write_text("${d}/dup.toml", "pool = 2\npool = 3\n")
    let _ = write_text("${d}/empty.toml", "")
    let _ = write_text("${d}/one.json", "{\"pool\": 9}")
    let _ = write_text("${d}/big.toml", "name = \"${repeat("é", 100000)}\"\nn = 1\n")
    let _ = write_text("${d}/secret.toml", "password = \"file-pass\"\n")
    let _ = make_dirs("${d}/mounted")
    let _ = make_dirs("${d}/int-mounted")
    let _ = write_text("${d}/int-mounted/n", "")
    let _ = write_text("${d}/mounted/n", "")
    let _ = write_text("${d}/mounted/name", "\n")
    let _ = write_text("${d}/mounted/edge", repeat("x", 1048576))
    let _ = write_text("${d}/mounted/password", "mounted-pass\n")
    let _ = make_dirs("${d}/prod-mounted")
    let _ = write_text("${d}/prod-mounted/name", "from-prod")
    let _ = make_dirs("${d}/dir-leaf/name")
    let _ = write_bytes("${d}/mounted-binary", [255, 254, 10].bytes()!)
    d
}

@derive(Decode)
type Db = { url: string = "u", pool: int = 10 }

@derive(Decode)
component One {
    password: Secret<string>
    env "A" { only: {"A__PASSWORD": "one-secret"} }
}

@derive(Decode)
component Two {
    password: Secret<string>
    env "B" { only: {"B__PASSWORD": "two-secret"} }
}

@derive(Decode)
component Shadowed {
    password: Secret<string>
    file "${written()}/secret.toml"
    env "C" { only: {"C__PASSWORD": "env-pass"} }
}

@derive(Decode)
component Staged {
    db: Db = Db {}
    file "${written()}/base.toml"
    env "S" { only: {"S__DB__POOL": "5", "S_STAGE": "prod"} }
    flags ["--stage=qa"]
    stage prod {
        file "${written()}/prod.toml"
    }
    stage qa {
        file "${written()}/qa.toml"
    }
}

@derive(Decode)
component EnvStage {
    db: Db = Db {}
    file "${written()}/base.toml"
    env "S" { only: {"S__DB__POOL": "5", "S_STAGE": "prod"} }
    stage prod {
        file "${written()}/prod.toml"
    }
}

@derive(Decode)
component Repeated {
    port: int = 1
    flags ["--port=2", "--port=3"]
}

@derive(Decode)
component Spaced {
    db: Db = Db {}
    flags ["--db.pool", "20"]
}

@derive(Decode)
component Whole {
    db: Db = Db {}
    flags ["--db=x", "--verbose", "--color=never"]
}

@derive(Decode)
component Dup {
    pool: int = 1
    file "${written()}/dup.toml"
}

@derive(Decode)
component Degenerate {
    pool: int = 1
    file "${written()}/empty.toml"
    file "${written()}/none.toml"
    file "${written()}/one.json"
}

@derive(Decode)
component Switches {
    on: bool = false
    off: bool = true
    named: bool = false
    env "SW" { only: {"SW__ON": "1", "SW__OFF": "0", "SW__NAMED": "true"} }
}

@derive(Decode)
component Unswitched {
    on: bool = false
    env "UN" { only: {"UN__ON": "yes"} }
}

@derive(Decode)
component Big {
    name: string = ""
    n: int = 0
    file "${written()}/big.toml"
    env "BIG" { only: {"BIG__N": "99999999999999999999", "BIG__NOPE": "1"} }
}

@derive(Decode)
component Huge {
    name: string = ""
    n: int = 0
    file "${written()}/big.toml"
}

@derive(Decode)
component Mounted {
    n: string = "unset"
    name: string = "x"
    edge: string = ""
    password: Secret<string>
    dir "${written()}/mounted" { required: true }
    stage prod {
        dir "${written()}/prod-mounted"
    }
}

@derive(Decode)
component MountedInt {
    n: int = 0
    dir "${written()}/int-mounted"
}

@derive(Decode)
component FileIsDir {
    name: string = ""
    env "F" { only: {"F__NAME_FILE": "${written()}/mounted"} }
}

@derive(Decode)
component LeafIsDir {
    name: string = ""
    dir "${written()}/dir-leaf"
}

@derive(Decode)
component Binary {
    name: string = ""
    env "B" { only: {"B__NAME_FILE": "${written()}/mounted-binary"} }
}

@derive(Decode)
type Store = { @variable("AVRA_STORE_DIR") root: string = "", limit: int = 1 }

@derive(Decode)
component Exact {
    store: Store = Store {}
    @variable("AVRA_TOKEN") token: Secret<string>
    @variable("AVRA_KEY") key: string = ""
    env "X" {
        only: {
            "AVRA_STORE_DIR": "/s",
            "X__STORE__LIMIT": "3",
            "AVRA_TOKEN_FILE": "${written()}/mounted/password",
            "AVRA_KEY": "k",
        }
    }
}

@derive(Decode)
component OverlayStaged {
    db: Db = Db {}
    overlay "${written()}/{stage}.toml" { required: true }
    env "O" { only: {"O_STAGE": "prod"} }
    flags ["--stage=qa"]
    stage prod {}
    stage qa {}
    stage gone {}
}

@derive(Decode)
component Signing {
    identity: string
    identity_password: Secret<string>
    env "SIGN" { only: {"SIGN__IDENTITY": "/keys/release.p12", "SIGN__IDENTITY_PASSWORD": "p12-pass"} }
}

/// A signing tool as a build hands it the identity: the path as a word, the password hidden.
fn signed() -> string {
    match Signing.load() {
        .Ok(c) -> {
            let call = with_secret_var(
                cmd(tool_at("sign", "/usr/bin/sign"), ["--p12", c.value.identity]),
                "P12_PASSWORD",
                c.value.identity_password,
            )
            "${call.shown_args().join(" ")} ${call.shown_env().filter(it.starts_with("P12_")).join(" ")} ${call.env.get("P12_PASSWORD")!.length}"
        },
        .Err(e) -> e.report(),
    }
}

fn exact() -> string {
    match Exact.load() {
        .Ok(c) -> "${c.value.store.root}|${c.value.store.limit}|${c.value.token.reveal((t: string) -> t)}|${c.value.key}",
        .Err(e) -> e.report(),
    }
}

fn overlaid(named: string?) -> string {
    let read = if named == null { OverlayStaged.load() } else { OverlayStaged.load_as(named!) }
    match read { .Ok(c) -> "${c.stage} ${c.value.db.pool}", .Err(e) -> rules_of(e.report()) }
}

fn mounted(named: string) -> string {
    match Mounted.load_as(named) {
        .Ok(c) -> "${c.value.n}|${c.value.name}|${c.value.edge.length}|${c.value.password.reveal((t: string) -> t)}",
        .Err(e) -> e.report(),
    }
}

fn rules_of(report: string) -> string {
    [w for w in report.split(" ") if w.starts_with("config.")].join(",")
}

fn revealed(r: Result<Secret<string>, string>) -> string {
    match r { .Ok(s) -> s.reveal((t: string) -> t), .Err(e) -> e }
}

fn password_of_one() -> Result<Secret<string>, string> {
    match One.load() { .Ok(c) -> c.value.password, .Err(e) -> { fail e.report() } }
}

fn password_of_two() -> Result<Secret<string>, string> {
    match Two.load() { .Ok(c) -> c.value.password, .Err(e) -> { fail e.report() } }
}

fn both() -> string {
    let a = password_of_one()
    let b = password_of_two()
    "${revealed(a)} ${revealed(b)}"
}

fn staged() -> string { match Staged.load() { .Ok(c) -> "${c.stage} ${c.value.db.pool}", .Err(e) -> e.report() } }

fn env_staged() -> string { match EnvStage.load() { .Ok(c) -> "${c.stage} ${c.value.db.pool}", .Err(e) -> e.report() } }

fn shadowed() -> string {
    match Shadowed.load() {
        .Ok(c) -> c.explain().replace(run_base(), "<dir>"),
        .Err(e) -> e.report(),
    }
}

fn rule_of(report: string) -> string { report.split("  ").filter(it.starts_with("config.")).join(",") }

spec "std/config adversarial" {
    given "a secret through every channel" {
        then "two configs with one field name keep two secrets" { both() == "one-secret two-secret" }
        then "a shadowed secret's text is shown nowhere" { !shadowed().contains("file-pass") && !shadowed().contains("env-pass") }
        then "a shadowed secret is still named as replaced" {
            shadowed() == "password  <secret>  env  C__PASSWORD\npassword was also set by file <dir>/secret.toml, which a later source replaced"
        }
        then "a handle shows its path and generation, never its text" {
            match password_of_one() {
                .Ok(s) -> s.shown() == "<secret password v1>",
                .Err(_) -> false,
            }
        }
        then "value() carries the handle, never the text" {
            match One.load() {
                .Ok(c) -> c.value.value().shown() == "{\"password\": \"<secret password v1>\"}",
                .Err(_) -> false,
            }
        }
        then "matches takes the text and refuses its neighbours" {
            match password_of_one() {
                .Ok(s) -> s.matches("one-secret") &&
                    !s.matches("one-secreT") &&
                    !s.matches("one-secre") &&
                    !s.matches(""),
                .Err(_) -> false,
            }
        }
    }
    given "precedence at its edges" {
        then "the environment beats a stage's file" { env_staged() == "prod 5" }
        then "a flag's stage beats the environment's" { staged() == "qa 5" }
        then "a later flag beats an earlier one" { match Repeated.load() { .Ok(c) -> c.value.port == 3, .Err(_) -> false } }
        then "an empty file, a missing one and a JSON one stack" {
            match Degenerate.load() { .Ok(c) -> c.value.pool == 9, .Err(_) -> false }
        }
    }
    given "flags spelled every way" {
        then "a dotted flag with no value is refused, never dropped" {
            match Spaced.load() {
                .Ok(_) -> false,
                .Err(e) -> rule_of(e.report()) == "config.flag_unset",
            }
        }
        then "a flag naming a record is refused, and another reader's flags are left alone" {
            match Whole.load() {
                .Ok(_) -> false,
                .Err(e) -> rule_of(e.report()) == "config.flag_record",
            }
        }
    }
    given "provenance under a failing layer" {
        then "a variable's issue names the variable, never the file beneath it" {
            match Big.load() { .Ok(_) -> false, .Err(e) -> !e.report().contains("(file") }
        }
        then "a file's syntax issue names the file" {
            match Dup.load() {
                .Ok(_) -> false,
                .Err(e) -> e.report().replace(run_base(), "<dir>").contains("<dir>/dup.toml"),
            }
        }
    }
    given "a mounted directory" {
        then "an empty file is empty, a newline alone is empty, a file at the bound reads whole" {
            mounted("") == "||1048576|mounted-pass"
        }
        then "a stage's directory lays over the base one" { mounted("prod") == "|from-prod|1048576|mounted-pass" }
        then "an empty file for an integer spells none" {
            match MountedInt.load() {
                .Ok(_) -> false,
                .Err(e) -> rules_of(e.report()) == "config.spelling",
            }
        }
        then "a leaf that is a directory cannot be read" {
            match LeafIsDir.load() {
                .Ok(_) -> false,
                .Err(e) -> rules_of(e.report()) == "config.file_unread",
            }
        }
    }
    given "a variable's _FILE" {
        then "naming a directory cannot be read" {
            match FileIsDir.load() {
                .Ok(_) -> false,
                .Err(e) -> rules_of(e.report()) == "config.file_unread",
            }
        }
        then "naming bytes that are not text cannot be read" {
            match Binary.load() {
                .Ok(_) -> false,
                .Err(e) -> rules_of(e.report()) == "config.file_unread",
            }
        }
        then "a mounted secret's text is shown nowhere a report reaches" {
            match Mounted.load() {
                .Ok(c) -> !c.explain().contains("mounted-pass"),
                .Err(_) -> false,
            }
        }
    }
    given "stages and exact names" {
        then "an exact name reads a dependency's leaf, a secret through its _FILE, and a leaf beside" {
            exact() == "/s|3|mounted-pass|k"
        }
        then "a flag's stage beats the environment's and names the overlay read" { overlaid(null) == "qa 7" }
        then "a stage named outright wins over both" { overlaid("prod") == "prod 40" }
        then "a required overlay that is not there is refused" { overlaid("gone") == "config.file_missing" }
        then "no stage reads no overlay" { overlaid("") == " 10" }
        then "a signing identity is its path and a hidden password" { signed() == "--p12 /keys/release.p12 P12_PASSWORD=<hidden> 8" }
    }
    given "degenerate values" {
        then "a hundred thousand accented letters read whole" {
            match Huge.load() { .Ok(c) -> c.value.name.length == 200000, .Err(_) -> false }
        }
        then "a variable no field names is not refused yet (env_names is asked for)" {
            match Big.load() { .Ok(_) -> false, .Err(e) -> !e.report().contains("NOPE") }
        }
    }
    given "a switch spelled in text" {
        then "1 and 0 read as true and false, beside true" {
            match Switches.load() {
                .Ok(c) -> c.value.on && !c.value.off && c.value.named,
                .Err(_) -> false,
            }
        }
        then "any other spelling is refused naming the variable and the four it takes" {
            match Unswitched.load() {
                .Ok(_) -> false,
                .Err(e) -> e.report().contains("UN__ON") && e.report().contains("true, false, 1 or 0"),
            }
        }
    }
}
