// proves: a stage is chosen once and read, never branched on — an overlay file named for the stage
// laid as a file is, nothing under no stage, its leaves' origins naming the stage; the stage's name
// interpolated for a label; a field read from an exact variable name its `@variable` claims, beside
// the names the rest derive; and a stage no body declares, an overlay naming no `{stage}` and an
// exact name another leaf derives each refused in their own words.
use @std.meta.{derive}
use @std.io.{write_text, make_dirs, env_or}
use @std.time.{stamp}
use @std.validate.{Decode}
use @std.config.{Configured, file, overlay, env, flags, stage, variable}

once fn run_base() -> string { "${env_or("TMPDIR", "/tmp")}/avra-config-staged/${stamp()}" }

@derive(Decode)
component Tool {
    @variable("AVRA_CACHE_DIR") cache_dir: string = ".avra-cache"
    jobs: int = 1
    sample: int = 100
    file "${run_base()}/tool.toml"
    overlay "${run_base()}/tool.{stage}.toml"
    env "TOOL" { only: {"AVRA_CACHE_DIR": "/var/cache/avra", "TOOL__JOBS": "8", "TOOL_STAGE": "ci"} }
    stage ci {}
    stage prod {}
}

@derive(Decode)
component Unstaged {
    jobs: int = 1
    overlay "${run_base()}/tool.toml"
}

@derive(Decode)
component Clash {
    @variable("CLASH__JOBS") cores: int = 1
    jobs: int = 1
    env "CLASH" { only: {} }
}

fn shown(named: string?) -> string {
    let read = if named == null { Tool.load() } else { Tool.load_as(named!) }
    match read {
        .Ok(c) -> "stage `${c.stage}` (label ${c.stage.label().length} long): cache ${c.value.cache_dir}, jobs ${c.value.jobs}, sample ${c.value.sample}%\n${c.explain()}",
        .Err(e) -> e.report(),
    }
}

let _ = make_dirs(run_base())
let _ = write_text("${run_base()}/tool.toml", "jobs = 2\nsample = 100\n")
let _ = write_text("${run_base()}/tool.ci.toml", "sample = 50\n")
let _ = write_text("${run_base()}/tool.prod.toml", "sample = 1\n")
let unstaged = match Unstaged.load() { .Ok(_) -> "loaded", .Err(e) -> e.report() }
let clash = match Clash.load() { .Ok(_) -> "loaded", .Err(e) -> e.report() }
let all = "${shown(null)}\n\n${shown("prod")}\n\n${shown("")}\n\n${shown("qa")}\n\n${unstaged}\n${clash}"
all.replace(run_base(), "<dir>")
