//! The site's views in their states, for the gallery screen.
use @std.ui_gallery.{Entry, Case}
use @std.text.{repeat}
use site.{home, why, principles_of, missing, proofs, Belief, beliefs}

/// Every view the site draws, each in the states worth seeing.
export fn site_gallery() -> List<Entry> {
    [
        Entry { view: "home", cases: [Case { name: "as served", view: home() }] },
        Entry { view: "why", cases: [Case { name: "as served", view: why() }] },
        Entry { view: "proofs", cases: [Case { name: "as served", view: proofs() }] },
        Entry { view: "missing", cases: [Case { name: "as served", view: missing() }] },
        Entry {
            view: "principles",
            cases: [
                Case { name: "zero beliefs", view: principles_of([]) },
                Case { name: "one belief", view: principles_of(beliefs().slice(0, 1)) },
                Case { name: "five beliefs", view: principles_of(beliefs()) },
                Case { name: "pathological belief", view: principles_of([hostile()]) },
            ],
        },
    ]
}

fn hostile() -> Belief { Belief { name: "<script>alert(1)</script>", says: "\"quoted\" & long " + repeat("word ", 60) } }
