//! @std.http — HTTP/1.1, strict and small.
//!
//! THE MODULES, and what each one owns:
//!
//! ```
//! frame.av   the FRAMER: a head over `Bytes`, stateless, every
//!            widening MAY refused, each refusal a named law
//! query.av   the QUERY: what follows the target's `?`, as keyed
//!            fields over raw octets; decoding is @std/url's
//! body.av    the BODY READER: an incoming body read piece by piece
//!            as it arrives, or gathered whole under a bound
//! sse.av     SERVER-SENT EVENTS: an event stream over a body stream,
//!            resumed from an observer's cursor, and a retaining feed
//! ws.av      WEBSOCKET: the upgrade both ways, the frame codec, and a
//!            socket its connection's task owns
//! codec.av   SHA-1 and base64, as the WebSocket handshake names them
//! http.av    this file — the values a handler sees and answers, and
//!            the STREAM a response's body is pulled from
//! route.av   the ROUTER: a route is a grammar over the PATH, and
//!            one table compiled from the declared list
//! server.av  the LOOP: one poller, every connection a value, a
//!            handler that writes through app state
//! client.av  the CLIENT: one connection as a value, the reply
//!            framed as it arrives, its body by the reply's rule
//! pool.av    the POOL: connections kept per origin, lent and
//!            given back under per-host and idle bounds
//! wire.av    the TRANSPORT a connection rides; TLS plugs in
//!            from @std/https
//! fetch.av   ONE REQUEST BY URL: `get(url)?` and its siblings,
//!            over a pool, each stage on its own deadline,
//!            redirects and retries by an explicit policy
//! jar.av     COOKIES a server set, kept and sent back by RFC 6265
//! date.av    DATES: the `date` field, formatted once a second
//! auth.av    CREDENTIALS as the `authorization` field
//! hpack.av   HPACK (RFC 7541): the tables, Huffman, a decoder and
//!            an encoder each connection holds and every block moves
//! h2.av      HTTP/2 (RFC 9113): frames, settings, streams and flow
//!            control as one connection value, fed bytes, owing bytes
//! h2_serve.av  a stream as the 1.1 `Request` its fields mean, and a
//!            `Response` as the stream's answer
//! cookie.av  COOKIES: read from a request, set with the safe
//!            defaults, signed over a MAC, sessions sealed in one
//! files.av   STATIC FILES: a directory as routes, never above its
//!            root, validated, conditional and ranged
//! ```
//!
//! The head's field spans index the buffer they were framed from, so
//! a `Request` keeps that buffer and slices a value only when asked.
use frame.{
    Head,
    Field,
    Method,
    ReplyBody,
    target_form,
    scheme_end,
    admits,
    is_target,
    is_tchar,
    is_vchar,
}
use query.{Query, query_of}
use @std.json.{Json, Decoder, parse, to_text}
use body.{Body, BodyError}
use date.{date_line}
use wire.{Transport}

/// What a handler receives: the raw buffer the head was framed from,
/// the head, the body — READ as the handler asks for it, never before
/// (`body.av`) — who sent it, what its route read of the path —
/// `Unrouted` until a route reads it — and the fields a layer set in
/// place of the head's own (`with_field`), which every header read
/// answers first.
export type Request<P> = { raw: Bytes, head: Head, body: Body, peer: string, params: P, set: List<Header> = [] }

/// The params of a request no route has read.
export type Unrouted = {}

impl Request {
    fn method() -> Method { self.head.method }
    /// The request target, whole — path and query as sent, ABSENT
    /// when the octets are not text. The framer ADMITS `obs-text`, so
    /// a target UTF-8 cannot spell was still sent; answering the
    /// empty string would tell a handler it never was. It is the whole
    /// target in the form it was SENT — `path()` and `authority()` are
    /// where its components are read.
    fn target() -> string? { self.raw.slice(self.head.target.lo, self.head.target.hi).text() }

    /// THE PATH COMPONENT OF THE TARGET, IN EVERY FORM IT MAY ARRIVE
    /// IN, which is what a route matches. THE ONE PLACE THE TARGET IS
    /// SPLIT — a consumer that forgets to split counts a `/` inside
    /// `?redirect=/home` as a path segment, and the route it was
    /// looking for disappears.
    ///
    /// AN ORIGIN SERVER MUST ACCEPT ABSOLUTE-FORM AND ROUTE ON ITS
    /// PATH (RFC 9112 §3.3), and this answered the WHOLE URI: `/p`
    /// answered 200 and `http://h/p` answered 404 for one resource. A
    /// 404 is not the hazard — the DIFFERENTIAL is, because a front
    /// end that normalises one form into the other and an Avra origin
    /// behind it then disagree about which route answers, and a filter
    /// on `/admin` in front of a server that reads `http://h/admin` as
    /// a different path is the whole shape of a routing bypass.
    ///
    /// ABSENT FOR THE TWO FORMS THAT NAME NO RESOURCE — `OPTIONS *`
    /// and CONNECT's authority. A router cannot route them and must
    /// not be handed a path that looks routable; the server keeps the
    /// framer's law for them, and `target()` still answers whole.
    fn path() -> Bytes? {
        match self.form() {
            .Origin -> self.raw.slice(self.head.target.lo, self.split_at()),
            .Absolute -> self.absolute_path(),
            .Asterisk or .Authority or .Other -> null,
        }
    }

    /// Whether this request is for `prefix` or anything beneath it, by
    /// WHOLE SEGMENTS of its `path()`: `/admin` is under `/admin`, and
    /// so is `/admin/users?tab=2`; `/administrator` is not. The router's
    /// own segment law decides, so a layer and the routes it guards
    /// read one path alike. A target with no path (`OPTIONS *`) is
    /// under nothing.
    fn under(prefix: string) -> bool {
        let p? = self.path() else { return false }
        falls_under(p, prefix.bytes())
    }

    /// THE AUTHORITY AN ABSOLUTE-FORM TARGET CARRIED, which `path()`
    /// strips — absent for every other form. RFC 9112 §3.3 has an
    /// origin server IGNORE the `Host` field when the target is
    /// absolute-form and take the authority from the target, so the
    /// two halves must be separately readable or that rule cannot be
    /// obeyed. A CONNECT target IS an authority and still answers
    /// absent here: it is a tunnel's destination and not this
    /// request's, and `target()` hands it over whole.
    fn authority() -> string? {
        match self.form() {
            .Absolute -> self.raw.slice(self.authority_from(), self.authority_to()).text(),
            .Origin or .Asterisk or .Authority or .Other -> null,
        }
    }

    /// Which of the four forms this request's target is in.
    fn form() -> TargetForm { target_form(self.raw, self.head.method, self.head.target.lo, self.head.target.hi) }

    /// An absolute-form target's path: from the first `/` after its
    /// authority to where the path class ends.
    ///
    /// AN EMPTY PATH IS `/` (RFC 9110 §4.2.3), and it is MINTED rather
    /// than sliced because there is nothing to slice: `http://h` names
    /// the root, and answering the empty octets would 404 the one
    /// spelling of the root that carries no `/` at all — the same
    /// differential this reader exists to close, one target further in.
    fn absolute_path() -> Bytes? {
        let stop = self.split_at()
        let from = self.authority_to()
        if from == stop { return root }
        self.raw.slice(from, stop)
    }

    /// An absolute-form target's scheme, as written; null for every
    /// other form.
    fn scheme() -> Bytes? {
        if !(self.form() is .Absolute) { return null }
        self.raw.slice(self.head.target.lo, self.authority_from() - 3)
    }

    /// Where an absolute-form target's authority begins: past `://`.
    fn authority_from() -> int { self.raw.index_in(scheme_end, self.head.target.lo, self.head.target.hi) + 3 }

    /// Where it ends: at the path's first `/`, else where the path
    /// class itself ends — a `?` or the target's own last octet.
    fn authority_to() -> int {
        let stop = self.split_at()
        let at = self.raw.index_in(slash, self.authority_from(), stop)
        if at < 0 { return stop }
        at
    }

    /// THE QUERY: what follows that `?`, as keyed fields. Built when
    /// asked, so a handler that wants it binds it once.
    fn query() -> Query { query_of(self.raw, self.query_from(), self.head.target.hi) }

    /// Whether the target carried a `?` at all. `/x?` has an EMPTY
    /// query and `/x` has NONE, and only this tells them apart.
    fn queried() -> bool { self.split_at() < self.head.target.hi }

    /// Where the path ends: the first `?` in the target, or its end.
    ///
    /// IT ASKS WHERE THE PATH CLASS ENDS, never where a `?` is. A
    /// search for the octet runs to the end of the BUFFER when the
    /// target has none, so a head with no query would be scanned
    /// whole for every request; a class that admits a target octet
    /// but not `?` stops at the query OR at the target's own end,
    /// whichever comes first, in one call.
    fn split_at() -> int {
        let stop = self.raw.run(self.head.target.lo, path_char)
        if stop > self.head.target.hi { return self.head.target.hi }
        stop
    }

    fn query_from() -> int {
        let at = self.split_at()
        if at == self.head.target.hi { return at }
        at + 1
    }
    /// The first field of this name, ASCII-folded, or null when the
    /// request carries none. Field values are ASCII by framing, so
    /// the text is total.
    fn header(name: string) -> string? {
        if !self.set.is_empty() && self.set.any(it.named(name)) { return self.set.find(it.named(name))?.value }
        let i = self.head.fields.named(self.raw, name.bytes())
        if i < 0 { return null }
        let v = self.head.fields.value_at(i)
        self.raw.slice(v.lo, v.hi).text()
    }

    /// Every field of this name, ASCII-folded, in the order sent — a
    /// field a sender may split across lines (`cookie` over HTTP/2)
    /// is read whole only this way.
    fn headers(name: string) -> List<string> {
        if !self.set.is_empty() && self.set.any(it.named(name)) { return [h.value for h in self.set if h.named(name)] }
        let fs = self.head.fields
        let wanted = name.bytes()
        [self.raw.slice(fs.value_at(i).lo, fs.value_at(i).hi).text() ?? "" for i in 0..fs.count() if self.raw.ieq_at(fs.name_at(i).lo, fs.name_at(i).hi, wanted)]
    }
}

impl Request {
    /// THE BODY AS JSON, or the response that refuses it: 415 when the
    /// request does not say `application/json` (or a `+json` type) — a
    /// form can post any bytes as `text/plain` across origins, so the
    /// media type is what a browser will not forge — 400 when the body
    /// is not UTF-8 or not JSON, naming where.
    fn json() -> Result<Json, Response> {
        if !json_typed(self.header("content-type")) { fail text(415, "the body must be `application/json`") }
        let body? = (self.gathered()?).text() else { fail text(400, "the body is not UTF-8") }
        match parse(body) {
            .Ok(j) -> j,
            .Err(e) -> { fail text(400, "the body is not JSON: ${e.describe().message}") },
        }
    }

    /// The body, whole, or the response refusing it: `Body.gathered`'s
    /// answer with its failure spoken as a status.
    fn gathered() -> Result<Bytes, Response> {
        match self.body.gathered() { .Ok(b) -> b, .Err(e) -> { fail body_refused(e) } }
    }
}

/// `q` with `name: value` in place of any field of that name it
/// carries. The head is not touched: every header read answers the
/// set field first, so a layer hands its handler a request id or a
/// trace context without copying a buffer.
export fn with_field<P>(q: Request<P>, name: string, value: string) -> Request<P> {
    q with { set: [h for h in q.set if !h.named(name)].concat([header_pair(name, value)]) }
}

/// `q` without any field named `name`, ASCII-folded.
export fn without_field<P>(q: Request<P>, name: string) -> Request<P> {
    if q.head.fields.named(q.raw, name.bytes()) < 0 { return q }
    q with { head: q.head with { fields: q.head.fields.without(q.raw, name.bytes()) } }
}

/// The response refusing a body that could not be read: 413 past the
/// bound, 408 past its deadline, 400 for any other break.
fn body_refused(e: BodyError) -> Response {
    match e {
        .TooLarge -> text(413, "the body is larger than this server takes"),
        .TimedOut -> text(408, "the body did not arrive in time"),
        .Malformed(_) or .Closed or .Net(_) or .Secure(_) -> text(400, "the body could not be read"),
    }
}

/// The request's JSON body read by `decode` — a record's `from_json`
/// under `@json` — or the response refusing it: `json`'s, or a 400
/// naming the member that misfit.
export fn json_body<P, T>(q: Request<P>, decode: Decoder<T>) -> Result<T, Response> {
    let doc = q.json()?
    match decode(doc) { .Ok(v) -> v, .Err(e) -> { fail text(400, e.describe().message) } }
}

/// Whether a `content-type` names JSON: `application/json`, or any
/// `application/…+json`, parameters after `;` aside, case folded.
fn json_typed(ct: string?) -> bool {
    let full? = ct else { return false }
    let m = media_of(full)
    let n = m.length
    m.ieq_at(0, n, json_type) ||
        n > 17 && m.ieq_at(0, 12, application) && m.ieq_at(n - 5, n, json_suffix)
}

/// A `content-type`'s media type: what precedes its parameters,
/// trimmed, as octets to compare case folded.
export fn media_of(ct: string) -> Bytes { (ct.split(";").first() ?? "").trim().bytes() }

const json_type: Bytes = "application/json".bytes()

const application: Bytes = "application/".bytes()

const json_suffix: Bytes = "+json".bytes()

/// One outgoing field.
export type Header = { name: string, value: string }

/// What a handler answers. Its body is WHOLE — `body`, written with
/// its `content-length` straight into the connection's one buffer — or
/// a `stream` the connection pulls. Never both: a response carrying a
/// stream beside a body is one no peer could read, and answers 500.
///
/// A `101` hands the connection over: its `upgrade` runs on the
/// connection's own task once the head is written, holding the socket
/// and whatever the peer sent past its request, and the connection
/// ends when it returns. `101` and an upgrade come together or not at
/// all.
export type Response = {
    status: int = 200,
    headers: List<Header> = [],
    body: Bytes = nothing(),
    stream: Stream? = null,
    upgrade: Upgrade? = null,
}

/// What a `101` hands the connection to: its transport, and the octets
/// the peer sent past its request — already the new protocol's.
export type Upgrade = { run: fn(dyn Transport, Bytes) -> void }

// ── The body stream ─────────────────────────────────────────────

/// A BODY THE CONNECTION PULLS, one piece at a time — the ONE producer
/// shape every writer of a streamed body reads: HTTP/1.1's connection
/// here, an HTTP/2 stream's writer next, the event-stream writer
/// (`sse.av`) on top.
///
/// PULLED, NEVER PUSHED. The writer asks for the next piece only once
/// the last is written, so a peer that reads slowly parks the
/// connection's OWN task inside its write, and the producer is not
/// asked again until the peer has taken what it owed. That is the
/// whole of backpressure: one piece in memory per stream, and no other
/// connection waits.
///
/// `length`, when the producer knows it, frames the body by
/// `content-length`; absent, a 1.1 peer is sent chunks and a 1.0 peer
/// reads to the close. A producer whose pieces overrun or fall short of
/// its own length has broken its framing, and the stream ends as a
/// failure does.
///
/// A FAILURE AFTER THE HEAD NEVER SPEAKS A SECOND STATUS: the head is
/// already on the wire, so the writer ends the stream where it stands
/// — no last chunk, a length never reached — and closes, and the peer
/// reads an incomplete message rather than a false one.
///
/// `ended` is called ONCE, however the pulling stops — the end, a
/// failure, a peer gone, a HEAD that sends no body, a response the
/// server replaced — so a producer holding a resource releases it.
export type Stream = { pull: fn() -> Pulled, length: int? = null, ended: fn() -> void = unheld }

/// What one pull answers: the next piece, the end, or a failure. An
/// EMPTY piece is a piece of nothing and is skipped — never read as the
/// end, which only `End` says.
export enum Pulled {
    Data(b: Bytes)
    End
    Failed
}

/// The release of a stream that holds nothing.
fn unheld() {}

/// A stream of `parts` in order, then its end. Its length is not
/// declared, so it goes out in chunks; `with { length: n }` frames it
/// by length instead.
export fn stream_of(parts: List<Bytes>) -> Stream {
    let next = Cell.new(0)
    Stream { pull: () -> piece_at(parts, next) }
}

fn piece_at(parts: List<Bytes>, next: Cell<int>) -> Pulled {
    let i = next.get()
    if i == parts.length { return .End }
    next.set(i + 1)
    .Data(parts[i])
}

/// A response's stream told it will not be pulled — the response was
/// replaced, or its request sent no body back.
export fn released(r: Response) {
    let s? = r.stream else { return }
    s.ended()
}

/// No octets: an empty body, a piece of nothing.
fn nothing() -> Bytes { "".bytes() }

impl Response {
    /// A 200 carrying `v` as JSON.
    static fn json(v: Json) -> Response {
        Response {
            headers: [Header { name: "content-type", value: "application/json" }],
            body: to_text(v).bytes(),
        }
    }

    /// The first header of this name, ASCII-folded, or null when the
    /// response carries none.
    fn header(name: string) -> string? { self.headers.find(it.named(name))?.value }

    /// This response saying it varies on `field`: added to its first
    /// `Vary`, or in a `Vary` of its own — unless one already names it,
    /// or `*`.
    fn varied(field: string) -> Response {
        if self
            .headers
            .any(it.named("vary") && (lists_token(it.value, "*") || lists_token(it.value, field))) {
            return self
        }
        let first? = self.headers.find_index(it.named("vary")) else { return self.with_header("vary", field) }
        self with { headers: [if j == first { h with { value: h.value + ", " + field } } else { h } for j, h in self.headers] }
    }

    /// This response with `name: value` after its other headers.
    fn with_header(name: string, value: string) -> Response {
        self with { headers: self.headers.concat([header_pair(name, value)]) }
    }
}

/// A field of `name` and `value`.
export fn header_pair(name: string, value: string) -> Header { Header { name: name, value: value } }

impl Header {
    /// Whether this header is named `name`, ASCII-folded as field
    /// names compare.
    fn named(name: string) -> bool { same_token(self.name, name) }
}

// ── Segments ────────────────────────────────────────────────────

/// Whether a segment ENDS at offset `i` — at a separator, or past
/// the last octet. THIS IS THE ONE DEFINITION OF A SEGMENT: a
/// pattern's shape and a target's descent both ask it, so the two can
/// never disagree about where a segment is.
///
/// It asks about SEPARATORS, not pieces: `split` drops a trailing
/// empty segment, so `/ideas/` would come up one short of
/// `/ideas/{id}` and a route would refuse its own empty capture.
export fn separates(b: Bytes, i: int) -> bool { i == b.length || b.at(i) == slash_octet() }

fn slash_octet() -> int { 47 }

/// Whether `path` is `prefix` or beneath it: it opens with the prefix,
/// and the prefix stops where a segment does — or ends in `/` itself.
export fn falls_under(path: Bytes, prefix: Bytes) -> bool {
    let n = prefix.length
    if path.length < n || path.slice(0, n) != prefix { return false }
    separates(path, n) || n > 0 && prefix.at(n - 1) == slash_octet()
}

/// What answers a request: a route's handler, a layer's `next`.
export alias Handler = fn(Request<Unrouted>) -> Response

/// How much a socket is asked for per read: h2o's figure times four,
/// one read per wake-up.
export fn read_size() -> int { 16384 }

/// A target octet that is not `?` — composed from the framer's law
/// rather than restated, so the two cannot drift apart.
const path_char: Bytes = admits((c) -> is_target(c) && c != question_octet())

fn question_octet() -> int { 63 }

/// The root path, for an absolute-form target that carried none.
const root: Bytes = "/".bytes()

const slash: Bytes = "/".bytes()

/// A plain-text response of this status.
export fn text(status: int, body: string) -> Response {
    Response {
        status: status,
        headers: [Header { name: "content-type", value: "text/plain; charset=utf-8" }],
        body: body.bytes(),
    }
}

/// A 200 of plain text.
export fn ok(body: string) -> Response { text(200, body) }

/// A bare status, no fields and no body.
export fn status(code: int) -> Response { Response { status: code } }

/// What a handler may answer with, and the reply it becomes: a
/// `Response` as it is, text as a 200 that carries it, a number as
/// that status with no body.
export trait Respond {
    fn response() -> Response
}

impl Respond for Response {
    fn response() -> Response { self }
}

impl Respond for string {
    fn response() -> Response { text(200, self) }
}

impl Respond for int {
    fn response() -> Response { status(self) }
}

/// The response on the wire: status line, the fields, the date, the
/// body's length, the connection's fate, then the body. The fate is spoken
/// when the peer cannot assume it: `close` when the connection will
/// not persist, and `keep-alive` when it will and the request was
/// HTTP/1.0 — a 1.0 peer waits for the close otherwise (RFC 9112 §9.3).
///
/// A RESPONSE NO PEER COULD READ IS THE SERVER'S OWN FAULT, and it
/// answers 500. A handler that hands a field a CRLF has written a
/// SECOND REPLY of its caller's choosing, and a caller is who fills
/// that value; refusing at the crossing is what makes the
/// reinterpretation impossible, where escaping would only move it.
export fn wire(r: Response, keep_alive: bool, minor: int) -> Bytes {
    let sent = as_sent(r)
    written(sent, whole_delimited(sent), keep_alive, minor, sent.body)
}

/// THE RESPONSE AS IT WILL BE WRITTEN — `r` when a peer could read
/// it, the server's own 500 when not. `sendable` is the one judgment:
/// `wire` writes by this, and the server judges each handler's answer
/// once by the same law, releasing a stream the 500 replaced.
export fn as_sent(r: Response) -> Response { if sendable(r) { r } else { status(500) } }

/// A RESPONSE ON THE WIRE, WRITTEN STRAIGHT INTO ONE BUFFER: the
/// status line, its fields, how its body is delimited, the connection's
/// fate, the blank line, then `body` — a whole body, or nothing for a
/// head a stream or a HEAD's answer follows. Every piece is appended in
/// place to one accumulator, never a head box joined to a body (reuse
/// in place, `docs/2026_09_23_REUSE_IN_PLACE.md`).
export fn written(r: Response, delim: ReplyBody, keep_alive: bool, minor: int, body: Bytes) -> Bytes {
    laid_out(r, delim, fate(keep_alive, minor, offered(r) != null), body)
}

/// A response's HEAD on the wire, its body to follow piece by piece.
export fn head_of(r: Response, delim: ReplyBody, keep_alive: bool, minor: int) -> Bytes {
    written(r, delim, keep_alive, minor, nothing())
}

/// The response with `closing` as its last field line, then `body`.
/// A final answer is dated; an interim one, whose date is optional
/// (RFC 9110 §6.6.1), is not.
fn laid_out(r: Response, delim: ReplyBody, closing: string, body: Bytes) -> Bytes {
    mut w = reply_line(r.status)
    for h in r.headers {
        w = w.concat(h.name.bytes())
        w = w.concat(field_colon)
        w = w.concat(h.value.bytes())
        w = w.concat(crlf)
    }
    if r.status >= 200 { w = w.concat(date_line()) }
    match delim {
        .Length(n) -> {
            w = w.concat(length_field)
            w = w.concat("${n}".bytes())
            w = w.concat(crlf)
        },
        .Chunked -> { w = w.concat(chunked_line) },
        .None or .UntilClose -> undelimited(),
    }
    w = w.concat(closing.bytes())
    w = w.concat(crlf)
    w = w.concat(body)
    w
}

/// HOW A RESPONSE'S BODY IS DELIMITED ON THE WIRE (RFC 9112 §6): a
/// whole body and a stream that knows its length by `content-length`,
/// any other stream by chunks — and, to a 1.0 peer that cannot read
/// chunks, by the close, which that response's fate must then say.
export fn delimited(r: Response, minor: int) -> ReplyBody {
    let s? = r.stream else { return whole_delimited(r) }
    match s.length {
        n? -> .Length(n)
        null -> if minor == 0 { .UntilClose } else { .Chunked }
    }
}

/// A whole body's delimiting: its length — stated by no 204 (RFC 9110
/// §8.6) and no 304, whose length would be the 200's it stands for.
fn whole_delimited(r: Response) -> ReplyBody {
    if r.status == 204 || r.status == 304 { return .None }
    .Length(r.body.length)
}

/// A body delimited by nothing written: none at all, or the close.
fn undelimited() {}

const length_field: Bytes = "content-length: ".bytes()

const chunked_line: Bytes = "transfer-encoding: chunked\r\n".bytes()

/// ONE PIECE OF A STREAMED BODY ON THE WIRE, by the body's delimiting:
/// a chunk — its size in hex, the octets, a CRLF — or the octets
/// themselves. AN EMPTY PIECE IS NOTHING ON THE WIRE: an empty chunk is
/// the LAST chunk, so writing one would end the body a producer meant
/// only to pause.
export fn piece_on_wire(b: Bytes, delim: ReplyBody) -> Bytes {
    if b.is_empty() { return b }
    match delim { .Chunked -> chunk_of(b), .None or .Length(_) or .UntilClose -> b }
}

fn chunk_of(b: Bytes) -> Bytes {
    mut w = hex_text(b.length).bytes()
    w = w.concat(crlf)
    w = w.concat(b)
    w = w.concat(crlf)
    w
}

/// What ends a streamed body on the wire: the last chunk and an empty
/// trailer section, or nothing — a length ends by being reached, and
/// the close ends itself.
export fn body_end(delim: ReplyBody) -> Bytes {
    match delim { .Chunked -> last_chunk, .None or .Length(_) or .UntilClose -> nothing() }
}

const last_chunk: Bytes = "0\r\n\r\n".bytes()

/// Whether `total` octets so far still fit the delimiting — a length is
/// never overrun.
export fn within_length(delim: ReplyBody, total: int) -> bool {
    match delim { .Length(n) -> total <= n, .None -> total == 0, .Chunked or .UntilClose -> true }
}

/// Whether a body of `total` octets is complete under the delimiting —
/// a length is met exactly.
export fn completes(delim: ReplyBody, total: int) -> bool {
    match delim { .Length(n) -> total == n, .None -> total == 0, .Chunked or .UntilClose -> true }
}

/// `n` in lowercase hex, no leading zeros — a chunk's size line.
export fn hex_text(n: int) -> string {
    if n < 16 { return hex_digits.substring(n, n + 1) }
    hex_text(n >> 4) + hex_digits.substring(n & 15, (n & 15) + 1)
}

const hex_digits: string = "0123456789abcdef"

/// Every status line a response can carry, laid out once in the binary.
const reply_lines: List<Bytes> = [reply_text(s).bytes() for s in 100..1000]

/// A status line: the binary's for a status of three digits.
fn reply_line(status: int) -> Bytes {
    if status < 100 || status > 999 { return reply_text(status).bytes() }
    reply_lines[status - 100]
}

fn reply_text(status: int) -> string { "HTTP/1.1 ${status} ${reason(status)}\r\n" }

const field_colon: Bytes = ": ".bytes()

/// The connection's fate, when the peer cannot assume it — and, when
/// the response OFFERS an upgrade, the `upgrade` option its sender must
/// list beside it (RFC 9110 §7.8). The writer owns `connection`, so
/// this is the only place the option can be written.
fn fate(keep_alive: bool, minor: int, offers: bool) -> string {
    if offers { return offering_fate(keep_alive, minor) }
    when {
        !keep_alive -> "connection: close\r\n"
        minor == 0 -> "connection: keep-alive\r\n"
        _ -> ""
    }
}

fn offering_fate(keep_alive: bool, minor: int) -> string {
    when {
        !keep_alive -> "connection: close, upgrade\r\n"
        minor == 0 -> "connection: keep-alive, upgrade\r\n"
        _ -> switching()
    }
}

/// The `connection` field of a response that offers or makes a switch
/// and says nothing else of its connection.
fn switching() -> string { "connection: upgrade\r\n" }

/// WHETHER THIS RESPONSE CAN GO ON A WIRE AT ALL: a status of three
/// digits — the status line's own grammar, which is why 1000 and 99
/// are not statuses — and a FINAL one: a 1xx is interim, never an
/// answer (RFC 9110 §15.2), save the 101 that hands the connection
/// over. No content rides a status that forbids it, every field is one
/// the framer would frame, and a 426 names
/// the protocols it wants (§15.5.22). Public so a handler can ask
/// before it answers.
export fn sendable(r: Response) -> bool {
    r.status >= 100 &&
        r.status <= 999 &&
        fields_writable(r.headers, reply_writes) &&
        (r.body.is_empty() || !contentless(r.status)) &&
        (whole_answer(r) || streamable(r) && handed_over(r)) &&
        (r.status != 426 || offered(r) != null)
}

/// AN UPGRADE AND A 101 COME TOGETHER: a 101 with nothing to hand the
/// connection to leaves a peer speaking a protocol nobody reads, and
/// an upgrade under another status hands over a connection the peer
/// still thinks is HTTP's. A 101 names what it switches to in its
/// `upgrade` field (RFC 9110 §15.2.2), and the handed-over connection
/// carries no body.
fn handed_over(r: Response) -> bool {
    if r.upgrade == null { return r.status >= 200 }
    r.status == 101 && offered(r) != null && r.body.is_empty() && r.stream == null
}

/// The protocols a response's `upgrade` field names — absent when it
/// carries none, or an empty one.
export fn offered(r: Response) -> string? {
    r.headers.find(names_upgrade(it))?.value
}

/// Whether `h` is a non-blank `upgrade` field — its length asked first,
/// since every reply's fields are asked on the way to the wire.
fn names_upgrade(h: Header) -> bool {
    h.name.length == 7 && names_one_of(h.name, upgrade_field) && !h.value.trim().is_empty()
}

const upgrade_field: List<Bytes> = ["upgrade".bytes()]

/// A SERVER SWITCHES ONLY TO WHAT IT WAS ASKED FOR (RFC 9110 §7.8):
/// every protocol a 101 names is one the request's `upgrade` field
/// listed — and an HTTP/1.0 request's field is ignored, so it asked
/// for nothing. Any other response switches nothing and passes.
export fn switch_asked<P>(q: Request<P>, r: Response) -> bool {
    if r.status != 101 { return true }
    let named? = offered(r) else { return false }
    let wanted? = q.header("upgrade") else { return false }
    q.head.minor >= 1 && named.split(",").all(lists_token(wanted, it.trim()))
}

/// Whether a comma-separated field value names `token`, ASCII-folded.
export fn lists_token(value: string, token: string) -> bool {
    value.split(",").any(same_token(it, token))
}

/// Whether `item`, trimmed, is `token`, ASCII-folded — how a coding, a
/// directive, a media type and a parameter's name compare.
export fn same_token(item: string, token: string) -> bool {
    let b = item.trim().bytes()
    b.ieq_at(0, b.length, token.bytes())
}

/// A 101's head on the wire: the status line, its fields, and the
/// `connection: upgrade` its writer owns.
export fn upgrade_head(r: Response) -> Bytes { laid_out(r, .None, switching(), nothing()) }

/// A response with a whole body and nothing to hand over: the common
/// one, judged without asking the stream and upgrade laws.
fn whole_answer(r: Response) -> bool { r.stream == null && r.upgrade == null && r.status >= 200 }

/// A STREAM STANDS ALONE: a response carrying one carries no whole
/// body beside it, declares no negative length, and has a status that
/// may carry a body at all — a 1xx, 204, 205 or 304 never does (RFC 9110
/// §15). Two bodies are one the peer cannot read.
fn streamable(r: Response) -> bool {
    let s? = r.stream else { return true }
    r.body.is_empty() && s.length ?? 0 >= 0 && r.status >= 200 && !contentless(r.status)
}

/// A status whose response carries no content (RFC 9110 §15.3.5,
/// §15.3.6, §15.4.5).
fn contentless(status: int) -> bool { status == 204 || status == 205 || status == 304 }

/// EVERY FIELD A WRITER MAY WRITE: each one a field the framer would
/// frame, and none of the ones the writer writes ITSELF. A second
/// `content-length` on the wire is a length two readers disagree
/// about, which is the whole of request smuggling — so the law is
/// ONE, and a writer says only which fields it owns. The reply's
/// writer and the request's each name their own list.
export fn fields_writable(headers: List<Header>, written_by: List<Bytes>) -> bool {
    for h in headers {
        if !writable(h) || names_one_of(h.name, written_by) { return false }
    }
    true
}

/// A FIELD LINE ON THE WIRE OBEYS THE FRAMER'S OWN LAW, or the two
/// sides of one boundary read different bytes. A name is a token and
/// a value is visible ASCII — composed from the framer's predicates
/// rather than restated, so the writer cannot drift lenient while the
/// reader stays strict. An empty VALUE is a value and passes; an
/// empty NAME is not a token.
export fn writable(h: Header) -> bool {
    !h.name.is_empty() && every_octet(h.name, token_char) && every_octet(h.value, value_char)
}

/// EVERY OCTET OF `s` IS IN `class` — the one place text is judged
/// against a framer class, so no writer narrows a law by restating
/// it. Empty text is in every class.
export fn every_octet(s: string, class: Bytes) -> bool {
    let b = s.bytes()
    b.run(0, class) == b.length
}

/// Whether `name` is one of `written_by`, ASCII-folded.
export fn names_one_of(name: string, written_by: List<Bytes>) -> bool {
    let b = name.bytes()
    written_by.any((w) -> b.ieq_at(0, b.length, w))
}

/// What octet a field NAME may carry, as a class table.
export const token_char: Bytes = admits(is_tchar)

/// What octet a field VALUE may carry, as a class table.
export const value_char: Bytes = admits(is_vchar)

/// The fields `wire` writes itself: the framing, from what it is
/// sending, and the date, from the server's clock.
const reply_writes: List<Bytes> = [w.bytes() for w in ["content-length", "connection", "transfer-encoding", "date"]]

/// The reason phrase — the registered ones, and the class's word for
/// the rest.
export fn reason(status: int) -> string {
    match status {
        100 -> "Continue",
        101 -> "Switching Protocols",
        200 -> "OK",
        201 -> "Created",
        202 -> "Accepted",
        204 -> "No Content",
        206 -> "Partial Content",
        301 -> "Moved Permanently",
        302 -> "Found",
        303 -> "See Other",
        304 -> "Not Modified",
        307 -> "Temporary Redirect",
        308 -> "Permanent Redirect",
        400 -> "Bad Request",
        401 -> "Unauthorized",
        403 -> "Forbidden",
        404 -> "Not Found",
        405 -> "Method Not Allowed",
        408 -> "Request Timeout",
        409 -> "Conflict",
        411 -> "Length Required",
        413 -> "Content Too Large",
        414 -> "URI Too Long",
        415 -> "Unsupported Media Type",
        417 -> "Expectation Failed",
        421 -> "Misdirected Request",
        422 -> "Unprocessable Content",
        426 -> "Upgrade Required",
        429 -> "Too Many Requests",
        431 -> "Request Header Fields Too Large",
        500 -> "Internal Server Error",
        501 -> "Not Implemented",
        502 -> "Bad Gateway",
        503 -> "Service Unavailable",
        504 -> "Gateway Timeout",
        505 -> "HTTP Version Not Supported",
        _ -> when {
            status < 300 -> "Success"
            status < 400 -> "Redirection"
            status < 500 -> "Client Error"
            _ -> "Server Error"
        },
    }
}
