//! @std.http — HTTP/1.1, strict and small.
//!
//! THE MODULES, and what each one owns:
//!
//! ```
//! frame.av   the FRAMER: a head over `Bytes`, stateless, every
//!            widening MAY refused, each refusal a named law
//! query.av   the QUERY: what follows the target's `?`, as keyed
//!            fields over raw octets, and the one decoder
//! http.av    this file — the values a handler sees and answers
//! route.av   the ROUTER: a route is a grammar over the PATH, and
//!            one table compiled from the declared list
//! server.av  the LOOP: one poller, every connection a value, a
//!            handler that writes through app state
//! client.av  the CLIENT: one connection as a value, the reply
//!            framed as it arrives, its body by the reply's rule
//! ```
//!
//! The head's field spans index the buffer they were framed from, so
//! a `Request` keeps that buffer and slices a value only when asked.
use frame.{Head, Field, Span, Method, admits, is_target}
use query.{Query, query_of}

/// What a handler receives: the raw buffer the head was framed from,
/// the head, the body (owned, complete), and who sent it.
export type Request = { raw: Bytes, head: Head, body: Bytes, peer: string }

impl Request {
    fn method() -> Method { self.head.method }
    /// The request target, whole — path and query as sent, ABSENT
    /// when the octets are not text. The framer ADMITS `obs-text`, so
    /// a target UTF-8 cannot spell was still sent; answering the
    /// empty string would tell a handler it never was. `path()` hands
    /// over the octets themselves and always answers.
    fn target() -> string? { self.raw.slice(self.head.target.lo, self.head.target.hi).text() }

    /// THE PATH: the target up to its first `?`, which is what a
    /// route matches. THE ONE PLACE THE TARGET IS SPLIT — a consumer
    /// that forgets to split counts a `/` inside `?redirect=/home` as
    /// a path segment, and the route it was looking for disappears.
    fn path() -> Bytes { self.raw.slice(self.head.target.lo, self.split_at()) }

    /// THE QUERY: what follows that `?`, as keyed fields. Built when
    /// asked, so a handler that wants it binds it once.
    fn query() -> Query { query_of(self.raw, self.query_from(), self.head.target.hi) }

    /// Whether the target carried a `?` at all. `/x?` has an EMPTY
    /// query and `/x` has NONE, and only this tells them apart.
    fn queried() -> bool { self.split_at() < self.head.target.hi }

    /// Where the path ends: the first `?` in the target, or its end.
    ///
    /// IT ASKS WHERE THE PATH CLASS ENDS, never where a `?` is. A
    /// search for the octet runs to the end of the BUFFER when the
    /// target has none, so a head with no query would be scanned
    /// whole for every request; a class that admits a target octet
    /// but not `?` stops at the query OR at the target's own end,
    /// whichever comes first, in one call.
    fn split_at() -> int {
        let stop = self.raw.run(self.head.target.lo, path_char())
        if stop > self.head.target.hi { return self.head.target.hi }
        stop
    }

    fn query_from() -> int {
        let at = self.split_at()
        if at == self.head.target.hi { return at }
        at + 1
    }
    /// The first field of this name, ASCII-folded, or null when the
    /// request carries none. Field values are ASCII by framing, so
    /// the text is total.
    fn header(name: string) -> string? {
        let wanted = name.bytes()
        let raw = self.raw
        let f: Field? = self.head.fields.find((f) -> raw.ieq_at(f.name.lo, f.name.hi, wanted))
        if f == null { return null }
        raw.slice(f!.value.lo, f!.value.hi).text()
    }
}

/// One outgoing field.
export type Header = { name: string, value: string }

/// What a handler answers. `content-length` is written from the body;
/// nothing here is chunked.
export type Response = { status: int = 200, headers: List<Header> = [], body: Bytes = nothing() }

fn nothing() -> Bytes { "".bytes() }

/// How much a socket is asked for per read: h2o's figure times four,
/// one read per wake-up.
export fn read_size() -> int { 16384 }

/// A target octet that is not `?` — composed from the framer's law
/// rather than restated, so the two cannot drift apart.
once fn path_char() -> Bytes { admits((c) -> is_target(c) && c != question_octet()) }

fn question_octet() -> int { 63 }

export fn text(status: int, body: string) -> Response {
    Response { status: status, headers: [Header { name: "content-type", value: "text/plain; charset=utf-8" }], body: body.bytes() }
}

export fn ok(body: string) -> Response { text(200, body) }

export fn status(code: int) -> Response { Response { status: code } }

/// The response on the wire: status line, the fields, the body's
/// length, the connection's fate, then the body. The fate is spoken
/// when the peer cannot assume it: `close` when the connection will
/// not persist, and `keep-alive` when it will and the request was
/// HTTP/1.0 — a 1.0 peer waits for the close otherwise (RFC 9112 §9.3).
export fn wire(r: Response, keep_alive: bool, minor: int) -> Bytes {
    let fields = ["${h.name}: ${h.value}\r\n" for h in r.headers].join("")
    let fate = when {
        !keep_alive -> "connection: close\r\n"
        minor == 0 -> "connection: keep-alive\r\n"
        _ -> ""
    }
    "HTTP/1.1 ${r.status} ${reason(r.status)}\r\n${fields}content-length: ${r.body.length}\r\n${fate}\r\n".bytes().concat(r.body)
}

/// The reason phrase — the registered ones, and the class's word for
/// the rest.
export fn reason(status: int) -> string {
    match status {
        100 -> "Continue", 101 -> "Switching Protocols",
        200 -> "OK", 201 -> "Created", 202 -> "Accepted", 204 -> "No Content", 206 -> "Partial Content",
        301 -> "Moved Permanently", 302 -> "Found", 303 -> "See Other", 304 -> "Not Modified", 307 -> "Temporary Redirect", 308 -> "Permanent Redirect",
        400 -> "Bad Request", 401 -> "Unauthorized", 403 -> "Forbidden", 404 -> "Not Found", 405 -> "Method Not Allowed",
        408 -> "Request Timeout", 409 -> "Conflict", 411 -> "Length Required", 413 -> "Content Too Large", 414 -> "URI Too Long",
        415 -> "Unsupported Media Type", 417 -> "Expectation Failed", 422 -> "Unprocessable Content", 429 -> "Too Many Requests",
        431 -> "Request Header Fields Too Large",
        500 -> "Internal Server Error", 501 -> "Not Implemented", 502 -> "Bad Gateway", 503 -> "Service Unavailable", 504 -> "Gateway Timeout", 505 -> "HTTP Version Not Supported",
        _ -> if status < 300 { "Success" } else if status < 400 { "Redirection" } else if status < 500 { "Client Error" } else { "Server Error" },
    }
}
