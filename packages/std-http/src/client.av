//! client.av — the CLIENT: one connection as a value, a request sent
//! whole, the reply framed as it arrives, its body gathered by the
//! reply's own rule.
//!
//! `connected` speaks plain HTTP; `over` runs a client on any
//! transport — `@std/https` gives it TLS — and everything after is the
//! same.
//!
//! `received` is one read — the calling task parked until bytes
//! arrive — answering the reply when it is whole; `fetched` sends and
//! receives until the reply, all of it within one deadline.
use @std.errors.{Error, ErrorInfo, info}
use @std.url.{UrlError}
use @std.net.{Address, NetError, connect}
use @std.time.{Duration, within}
use frame.{
    Head,
    Method,
    Reply,
    Refusal,
    Chunker,
    Limits,
    Fields,
    framed_reply,
    framed,
    unfolded,
    chunker,
    fed,
    status_of,
    admits,
    is_target,
}
use http.{Header, read_size, every_octet, fields_writable, token_char}
use wire.{Transport, WireError, plainly}

/// What a fetch answers: the status, the fields as text, the body
/// whole — and, by URL, every URL a redirect led away from, in order,
/// and how many attempts the last request took.
export type Answer = { status: int, headers: List<Header>, body: Bytes, via: List<string> = [], attempts: int = 1 }

impl Answer {
    /// The first header of this name, ASCII-folded, or null.
    fn header(name: string) -> string? { self.headers.find(it.named(name))?.value }
}

/// Why a fetch did not answer: the network, the secure layer, a
/// reply the framer refuses (with the status the refusal names, as a
/// server would answer it), the peer closing before a reply, a
/// deadline and the stage it bounded, a pool with every connection to
/// the origin already lent, a URL that does not parse or names nothing
/// this client can reach, a request the framer would not frame, or a
/// connection an earlier exchange ended.
export enum ClientError {
    Net(e: NetError)
    Refused(why: Refusal)
    Closed
    Spent
    TimedOut(stage: Stage)
    Exhausted(origin: string, per_host: int)
    Url(e: UrlError)
    Unspoken(scheme: string)
    NoTls
    NoHost
    Userinfo
    Unwritable
    Secure(e: dyn Error)
    Redirect(why: Redirected)
}

/// Why a redirect was not followed.
export enum Redirected {
    TooMany(max: int)
    Loop(url: string)
    NoLocation(status: int)
    BadLocation(e: UrlError)
    Unreplayable(status: int)
}

/// What a deadline bounded: making the connection, securing it, the
/// wait for the reply's first byte, or the whole request.
export enum Stage { Connect, Tls, FirstByte, Total }

impl Error for ClientError {
    fn describe() -> ErrorInfo {
        match self {
            .Net(e) -> e.describe(),
            .Refused(why) -> info("http.refused", "the reply breaks a framing law and would earn ${status_of(why)}"),
            .Closed -> info("http.closed", "the peer closed before a reply"),
            .Spent -> info(
                "http.spent",
                "this connection carries no further request — an earlier exchange on it ended it",
            ),
            .TimedOut(stage) -> info("http.timed_out", "${stage_word(stage)} outran its deadline"),
            .Exhausted(origin, n) -> info("http.exhausted", "all ${n} connections to ${origin} are lent"),
            .Url(e) -> e.describe(),
            .Unspoken(scheme) -> info("http.scheme", "this client speaks `http` and `https`; `${scheme}` is neither"),
            .NoTls -> info(
                "http.no_tls",
                "an `https` URL needs TLS, and these options carry none — `@std/https`'s verbs do, or `Options { tls: verified(config) }`",
            ),
            .NoHost -> info("http.no_host", "the URL names no host to connect to"),
            .Userinfo -> info(
                "http.userinfo",
                "credentials in a URL are never sent — ask for an `authorization` header by name",
            ),
            .Unwritable -> info("http.unwritable", "a method, target, host or field the framer would not frame"),
            .Secure(e) -> e.describe(),
            .Redirect(why) -> redirect_info(why),
        }
    }

    fn cause() -> dyn Error? {
        match self {
            .Net(n) -> n,
            .Secure(t) -> t,
            .Url(u) or .Redirect(.BadLocation(u)) -> u,
            .Refused(_) or .Closed or .Spent or .TimedOut(_) or .Exhausted(_, _) or .Unspoken(_) or .NoTls or .NoHost or .Userinfo or .Unwritable or .Redirect(.TooMany(_)) or .Redirect(.Loop(_)) or .Redirect(.NoLocation(_)) or .Redirect(.Unreplayable(_)) -> null,
        }
    }
}

/// A connection with a request in flight. `owing` is whether a reply
/// is owed to the request sent; `persists` is whether the connection
/// may carry another: true until an exchange ends it (RFC 9112 §9.3,
/// §9.6) — a request or a reply saying `close`, a reply read to the
/// close, a switch away from HTTP, a byte past a reply that no request
/// asked for, a reply refused or cut short, or an exchange abandoned
/// with its reply still owed, whose framing is lost. `address` is the
/// one it was dialed to, when a dial made it — what an admission
/// judges before a pool lends it again.
export type Client = {
    conn: dyn Transport,
    asked: Method,
    buf: Bytes,
    scanned: int,
    reply: Reply?,
    decoder: Chunker?,
    limits: Limits,
    owing: bool = false,
    persists: bool = true,
    address: Address? = null,
}

fn redirect_info(why: Redirected) -> ErrorInfo {
    match why {
        .TooMany(max) -> info("http.redirects", "more than ${max} redirects"),
        .Loop(url) -> info("http.redirect_loop", "a redirect led back to ${url}"),
        .NoLocation(status) -> info("http.redirect_location", "a ${status} named no `location` to follow"),
        .BadLocation(e) -> info("http.redirect_location", "a redirect's `location` is no URL: ${e.describe().message}"),
        .Unreplayable(status) -> info(
            "http.redirect_replay",
            "a ${status} asks for the body again, and a stream is sent once",
        ),
    }
}

fn stage_word(stage: Stage) -> string {
    match stage {
        .Connect -> "the connect",
        .Tls -> "the TLS handshake",
        .FirstByte -> "the wait for the reply's first byte",
        .Total -> "the request",
    }
}

/// A net result as the client's: the failure wears `.Net`.
export fn netted<T>(r: Result<T, NetError>) -> Result<T, ClientError> {
    match r { .Ok(v) -> .Ok(v), .Err(e) -> .Err(.Net(e)) }
}

/// A wire result as the client's: a socket's failure wears `.Net`,
/// as a plain connection's always has, a secure layer's own wears
/// `.Secure`, and a transport cut off before its end is `.Closed`.
export fn carried<T>(r: Result<T, WireError>) -> Result<T, ClientError> {
    match r {
        .Ok(v) -> .Ok(v),
        .Err(.Net(e)) -> .Err(.Net(e)),
        .Err(.Secure(e)) -> .Err(.Secure(e)),
        .Err(.Reset) -> .Err(.Closed),
    }
}

/// A client connected to host:port within `timeout`.
export fn connected(host: string, port: int, timeout: Duration, limits: Limits) -> Result<
    Client,
    ClientError,
> {
    let c = netted(connect(host, port, timeout))?
    .Ok(over(plainly(c), limits))
}

/// A client over `w`, any transport already connected.
export fn over(w: dyn Transport, limits: Limits) -> Client {
    Client {
        conn: w,
        asked: .Get,
        buf: "".bytes(),
        scanned: 0,
        reply: null,
        decoder: null,
        limits: limits,
    }
}

/// A request on the wire: the line, `host`, the fields, the body's
/// length when there is a body (a body-less request has length zero
/// by RFC 9112 §6.3 and needs no field), the body.
///
/// ABSENT WHEN A WORD OR A FIELD BREAKS THE FRAMER'S LAW. A method is
/// a token, a target and a host are target octets, and every field is
/// one the framer would frame — so a CRLF in a value a caller was
/// handed cannot become a SECOND REQUEST LINE, which is the whole of
/// request smuggling. A malformed request is refused rather than
/// escaped, the way `decoded` refuses a malformed escape: a builder
/// that repairs and a peer that does not disagree about what was sent.
export fn request(method: string, target: string, host: string, headers: List<Header>, body: Bytes) -> Bytes? {
    let length = if body.length > 0 { "content-length: ${body.length}\r\n" } else { "" }
    headed(method, target, host, headers, length)?.concat(body)
}

/// A request head whose body follows as CHUNKS (RFC 9112 §7.1), each
/// written by http.av's `piece_on_wire` and ended by its `body_end`;
/// absent as `request` is.
export fn chunked_request(method: string, target: string, host: string, headers: List<Header>) -> Bytes? {
    headed(method, target, host, headers, "transfer-encoding: chunked\r\n")
}

/// The line, `host`, the fields and the one framing field the caller
/// chose, ended by the blank line.
fn headed(method: string, target: string, host: string, headers: List<Header>, framing: string) -> Bytes? {
    if !sayable(method, target, host, headers) { return null }
    let fields = ["${h.name}: ${h.value}\r\n" for h in headers].join("")
    "${method} ${target} HTTP/1.1\r\nhost: ${host}\r\n${fields}${framing}\r\n".bytes()
}

/// A method's word on the request line; absent for `.Other`, whose
/// word the enum does not hold.
export fn method_word(m: Method) -> string? {
    match m {
        .Get -> "GET",
        .Head -> "HEAD",
        .Post -> "POST",
        .Put -> "PUT",
        .Delete -> "DELETE",
        .Patch -> "PATCH",
        .Options -> "OPTIONS",
        .Connect -> "CONNECT",
        .Trace -> "TRACE",
        .Other -> null,
    }
}

/// Whether every word and field of a request can be written.
fn sayable(method: string, target: string, host: string, headers: List<Header>) -> bool {
    is_token(method) && is_word(target) && is_word(host) && fields_writable(headers, request_writes)
}

fn is_token(s: string) -> bool { !s.is_empty() && every_octet(s, token_char) }

/// A word of the request line: target octets, and at least one.
fn is_word(s: string) -> bool { !s.is_empty() && every_octet(s, word_char) }

const word_char: Bytes = admits(is_target)

/// The fields `request` writes itself: the framing, and `te` — this
/// client asks for no transfer coding, and a `chunked` there is one a
/// client MUST NOT name (RFC 9112 §7.4).
const request_writes: List<Bytes> = [w.bytes() for w in ["host", "content-length", "transfer-encoding", "te"]]

impl Client {
    /// The request written whole, the task parked while the socket is
    /// full; the method is the HEAD's own, and it decides whether the
    /// reply has a body. Refused on a connection an exchange ended, and
    /// for a head the framer would not frame — it judges what a client
    /// sends by the law a server reads it by, and says whether it asked
    /// to close.
    mut fn sent(req: Bytes) -> Result<int, ClientError> {
        if self.owing { self.persists = false }
        if !self.persists { return .Err(.Spent) }
        let head? = own_head(req, self.limits) else { return .Err(.Unwritable) }
        self.persists = head.keep_alive
        self.owing = true
        self.asked = head.method
        self.reply = null
        self.decoder = null
        carried(self.conn.wire_write(req))
    }

    /// One read, the task parked until bytes arrive: the answer when
    /// the reply is whole, null while it is not.
    mut fn received() -> Result<Answer?, ClientError> {
        match carried(self.conn.wire_read(read_size()))? {
            b? -> self.grown(b)
            null -> self.ended()
        }
    }

    /// The request sent and the reply received, all within `deadline`.
    mut fn fetched(req: Bytes, deadline: Duration) -> Result<Answer, ClientError> {
        staged(.Total, within deadline { self.exchanged(req) })
    }

    mut fn exchanged(req: Bytes) -> Result<Answer, ClientError> {
        self.sent(req)?
        mut got = self.received()?
        while got == null { got = self.received()? }
        .Ok(got!)
    }

    mut fn grown(b: Bytes) -> Result<Answer?, ClientError> {
        self.buf = self.buf.concat(b)
        self.framed()
    }

    /// The buffer framed: the head first — every interim reply before
    /// it read and passed over (RFC 9110 §15.2) — then the body by its
    /// rule.
    mut fn framed() -> Result<Answer?, ClientError> {
        while self.reply == null {
            self.buf = unfolded(self.buf, 0, self.scanned)
            match framed_reply(self.buf, 0, self.scanned, self.limits, self.asked) {
                .Partial -> {
                    self.scanned = self.buf.length
                    return .Ok(null)
                },
                .Refused(why) -> { return self.lost(.Refused(why)) },
                .Complete(r) -> if passed_over(r.status) { self.consumed(r.end) } else { self.reply = r },
            }
        }
        self.bodied(self.reply!)
    }

    /// The first `end` bytes read and gone, framing starting over.
    mut fn consumed(end: int) {
        self.buf = self.buf.slice(end, self.buf.length)
        self.scanned = 0
    }

    /// A failure after which the connection's framing cannot be
    /// trusted, so it carries nothing more.
    mut fn lost(e: ClientError) -> Result<Answer?, ClientError> {
        self.persists = false
        .Err(e)
    }

    mut fn bodied(r: Reply) -> Result<Answer?, ClientError> {
        match r.body {
            .None -> self.answered(r, "".bytes(), r.end),
            .Length(n) -> if self.buf.length < r.end + n { .Ok(null) } else { self.answered(r, self.buf.slice(r.end, r.end + n), r.end + n) },
            .Chunked -> self.chunked(r),
            .UntilClose -> .Ok(null),
        }
    }

    mut fn chunked(r: Reply) -> Result<Answer?, ClientError> {
        match fed(self.decoder ?? chunker(r.end), self.buf, self.limits) {
            .More(c) -> self.decoding(c),
            .Refused(why) -> self.lost(.Refused(why)),
            .Done(body, end) -> self.answered(r, body, end),
        }
    }

    /// The decoder kept between reads; no answer yet.
    mut fn decoding(c: Chunker) -> Result<Answer?, ClientError> {
        self.decoder = c
        .Ok(null)
    }

    /// The peer has finished: a reply read to the close is whole now;
    /// anything else was cut short.
    mut fn ended() -> Result<Answer?, ClientError> {
        let r? = self.reply else { return self.lost(.Closed) }
        match r.body {
            .UntilClose -> self.answered(r, self.buf.slice(r.end, self.buf.length), self.buf.length),
            .None or .Length(_) or .Chunked -> self.lost(.Closed),
        }
    }

    /// The answer built and the consumed bytes dropped. A byte past
    /// the reply answers no request, so it is never framed as the next
    /// one's reply: the connection ends there (RFC 9112 §6.3, §9.2).
    mut fn answered(r: Reply, body: Bytes, end: int) -> Result<Answer?, ClientError> {
        let raw = self.buf
        self.buf = raw.slice(end, raw.length)
        self.scanned = 0
        self.reply = null
        self.decoder = null
        self.owing = false
        self.persists = self.persists && r.keep_alive && r.status != 101 && self.buf.is_empty()
        .Ok(
            Answer {
                status: r.status,
                headers: [header_at(raw, r.fields, i) for i in 0..r.fields.count()],
                body: body,
            },
        )
    }

    /// Whether another request may follow on this connection: nothing
    /// ended it, no reply is owed, and no byte waits that no request
    /// asked for.
    fn reusable() -> bool { self.persists && !self.owing && self.buf.is_empty() }

    /// The application protocol agreed with the server, or null.
    fn protocol() -> string? { self.conn.wire_protocol() }

    /// Closed; answers the descriptor.
    fn close() -> Result<int, ClientError> { carried(self.conn.wire_close()) }
}

/// Whether a status is an interim reply, read and passed over on the
/// way to the answer: a 1xx other than 101, which only an upgrade the
/// request asked for can earn and which ends the exchange as HTTP.
fn passed_over(status: int) -> bool { status >= 100 && status < 200 && status != 101 }

/// The head of a request this client wrote, as a server frames it.
fn own_head(req: Bytes, limits: Limits) -> Head? {
    match framed(req, 0, 0, limits) { .Complete(h) -> h, .Partial or .Refused(_) -> null }
}

/// Field `i` of a reply, as text — values are ASCII by framing.
fn header_at(raw: Bytes, fields: Fields, i: int) -> Header {
    let n = fields.name_at(i)
    let v = fields.value_at(i)
    Header { name: raw.slice(n.lo, n.hi).text() ?? "", value: raw.slice(v.lo, v.hi).text() ?? "" }
}

/// A result whose net failure was a deadline passing, as the stage
/// that deadline bounded.
export fn staged<T>(stage: Stage, r: Result<T, ClientError>) -> Result<T, ClientError> {
    match r {
        .Err(.Net(e)) if e.timed_out() -> .Err(.TimedOut(stage)),
        .Err(e) -> .Err(e),
        .Ok(a) -> .Ok(a),
    }
}
