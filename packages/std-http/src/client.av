//! client.av — the CLIENT: one connection as a value, a request sent
//! whole, the reply framed as it arrives, its body gathered by the
//! reply's own rule.
//!
//! `connected` speaks plain HTTP; `over` runs a client on any
//! transport — `@std/https` gives it TLS — and everything after is the
//! same.
//!
//! `received` is one read — the calling task parked until bytes
//! arrive — answering the reply when it is whole; `fetched` sends and
//! receives until the reply, all of it within one deadline.
use @std.errors.{Error, ErrorInfo, info}
use @std.net.{NetError, connect}
use @std.time.{Duration, within}
use frame.{
    Method,
    Reply,
    Refusal,
    Chunker,
    Limits,
    Fields,
    framed_reply,
    chunker,
    fed,
    status_of,
    admits,
    is_target,
}
use http.{Header, read_size, every_octet, fields_writable, token_char}
use wire.{Transport, WireError, plainly}

/// What a fetch answers: the status, the fields as text, the body
/// whole.
export type Answer = { status: int, headers: List<Header>, body: Bytes }

impl Answer {
    /// The first header of this name, ASCII-folded, or null.
    fn header(name: string) -> string? {
        let h: Header? = self.headers.find(same_name(it.name, name))
        h?.value
    }
}

fn same_name(a: string, b: string) -> bool {
    let octets = a.bytes()
    octets.ieq_at(0, octets.length, b.bytes())
}

/// Why a fetch did not answer: the network, the secure layer, a reply
/// the framer refuses (with the status the refusal names, as a server
/// would answer it), the peer closing before a reply, or the deadline.
export enum ClientError {
    Net(e: NetError)
    Refused(why: Refusal)
    Closed
    TimedOut
    Secure(e: dyn Error)
}

impl Error for ClientError {
    fn describe() -> ErrorInfo {
        match self {
            .Net(e) -> e.describe(),
            .Refused(why) -> info("http.refused", "the reply breaks a framing law and would earn ${status_of(why)}"),
            .Closed -> info("http.closed", "the peer closed before a reply"),
            .TimedOut -> info("http.timed_out", "no reply within the deadline"),
            .Secure(e) -> e.describe(),
        }
    }

    fn cause() -> dyn Error? {
        match self { .Net(n) -> n, .Secure(t) -> t, .Refused(_) or .Closed or .TimedOut -> null }
    }
}

/// A connection with a request in flight.
export type Client = {
    conn: dyn Transport,
    asked: Method,
    buf: Bytes,
    scanned: int,
    reply: Reply?,
    decoder: Chunker?,
    limits: Limits,
}

/// A net result as the client's: the failure wears `.Net`.
export fn netted<T>(r: Result<T, NetError>) -> Result<T, ClientError> {
    match r { .Ok(v) -> .Ok(v), .Err(e) -> .Err(.Net(e)) }
}

/// A wire result as the client's: a socket's failure wears `.Net`,
/// as a plain connection's always has, and a secure layer's own wears
/// `.Secure`.
export fn carried<T>(r: Result<T, WireError>) -> Result<T, ClientError> {
    match r {
        .Ok(v) -> .Ok(v),
        .Err(.Net(e)) -> .Err(.Net(e)),
        .Err(.Secure(e)) -> .Err(.Secure(e)),
    }
}

/// A client connected to host:port within `timeout`.
export fn connected(host: string, port: int, timeout: Duration, limits: Limits) -> Result<
    Client,
    ClientError,
> {
    let c = netted(connect(host, port, timeout))?
    .Ok(over(plainly(c), limits))
}

/// A client over `w`, any transport already connected.
export fn over(w: dyn Transport, limits: Limits) -> Client {
    Client {
        conn: w,
        asked: .Get,
        buf: "".bytes(),
        scanned: 0,
        reply: null,
        decoder: null,
        limits: limits,
    }
}

/// A request on the wire: the line, `host`, the fields, the body's
/// length when there is a body (a body-less request has length zero
/// by RFC 9112 §6.3 and needs no field), the body.
///
/// ABSENT WHEN A WORD OR A FIELD BREAKS THE FRAMER'S LAW. A method is
/// a token, a target and a host are target octets, and every field is
/// one the framer would frame — so a CRLF in a value a caller was
/// handed cannot become a SECOND REQUEST LINE, which is the whole of
/// request smuggling. A malformed request is refused rather than
/// escaped, the way `decoded` refuses a malformed escape: a builder
/// that repairs and a peer that does not disagree about what was sent.
export fn request(method: string, target: string, host: string, headers: List<Header>, body: Bytes) -> Bytes? {
    if !sayable(method, target, host, headers) { return null }
    let fields = ["${h.name}: ${h.value}\r\n" for h in headers].join("")
    let length = if body.length > 0 { "content-length: ${body.length}\r\n" } else { "" }
    "${method} ${target} HTTP/1.1\r\nhost: ${host}\r\n${fields}${length}\r\n".bytes().concat(body)
}

/// Whether every word and field of a request can be written.
fn sayable(method: string, target: string, host: string, headers: List<Header>) -> bool {
    is_token(method) && is_word(target) && is_word(host) && fields_writable(headers, request_writes)
}

fn is_token(s: string) -> bool { !s.is_empty() && every_octet(s, token_char) }

/// A word of the request line: target octets, and at least one.
fn is_word(s: string) -> bool { !s.is_empty() && every_octet(s, word_char) }

const word_char: Bytes = admits(is_target)

/// The framing fields `request` writes itself.
const request_writes: List<Bytes> = [w.bytes() for w in ["host", "content-length", "transfer-encoding"]]

impl Client {
    /// The request written whole, the task parked while the socket is
    /// full; `asked` is the method, which decides whether the reply has
    /// a body.
    mut fn sent(asked: Method, req: Bytes) -> Result<int, ClientError> {
        self.asked = asked
        self.reply = null
        self.decoder = null
        carried(self.conn.wire_write(req))
    }

    /// One read, the task parked until bytes arrive: the answer when
    /// the reply is whole, null while it is not.
    mut fn received() -> Result<Answer?, ClientError> {
        match carried(self.conn.wire_read(read_size()))? {
            b? -> self.grown(b)
            null -> self.ended()
        }
    }

    /// The request sent and the reply received, all within `deadline`.
    mut fn fetched(asked: Method, req: Bytes, deadline: Duration) -> Result<Answer, ClientError> {
        timed(within deadline { self.exchanged(asked, req) })
    }

    mut fn exchanged(asked: Method, req: Bytes) -> Result<Answer, ClientError> {
        self.sent(asked, req)?
        mut got = self.received()?
        while got == null { got = self.received()? }
        .Ok(got!)
    }

    mut fn grown(b: Bytes) -> Result<Answer?, ClientError> {
        self.buf = self.buf.concat(b)
        self.framed()
    }

    /// The buffer framed: the head first, then the body by its rule.
    mut fn framed() -> Result<Answer?, ClientError> {
        if self.reply == null {
            match framed_reply(self.buf, 0, self.scanned, self.limits, self.asked) {
                .Partial -> { self.scanned = self.buf.length },
                .Refused(why) -> { return .Err(.Refused(why)) },
                .Complete(r) -> { self.reply = r },
            }
        }
        if self.reply == null { return .Ok(null) }
        self.bodied(self.reply!)
    }

    mut fn bodied(r: Reply) -> Result<Answer?, ClientError> {
        match r.body {
            .None -> self.answered(r, "".bytes(), r.end),
            .Length(n) -> if self.buf.length < r.end + n { .Ok(null) } else { self.answered(r, self.buf.slice(r.end, r.end + n), r.end + n) },
            .Chunked -> self.chunked(r),
            .UntilClose -> .Ok(null),
        }
    }

    mut fn chunked(r: Reply) -> Result<Answer?, ClientError> {
        match fed(self.decoder ?? chunker(r.end), self.buf, self.limits) {
            .More(c) -> self.decoding(c),
            .Refused(why) -> .Err(.Refused(why)),
            .Done(body, end) -> self.answered(r, body, end),
        }
    }

    /// The decoder kept between reads; no answer yet.
    mut fn decoding(c: Chunker) -> Result<Answer?, ClientError> {
        self.decoder = c
        .Ok(null)
    }

    /// The peer has finished: a reply read to the close is whole now;
    /// anything else was cut short.
    mut fn ended() -> Result<Answer?, ClientError> {
        let r? = self.reply else { return .Err(.Closed) }
        match r.body {
            .UntilClose -> self.answered(r, self.buf.slice(r.end, self.buf.length), self.buf.length),
            .None or .Length(_) or .Chunked -> .Err(.Closed),
        }
    }

    /// The answer built, the consumed bytes dropped so a next reply
    /// on the same connection frames from the buffer's start.
    mut fn answered(r: Reply, body: Bytes, end: int) -> Result<Answer?, ClientError> {
        let raw = self.buf
        self.buf = raw.slice(end, raw.length)
        self.scanned = 0
        self.reply = null
        self.decoder = null
        .Ok(
            Answer {
                status: r.status,
                headers: [header_at(raw, r.fields, i) for i in 0..r.fields.count()],
                body: body,
            },
        )
    }

    /// The application protocol agreed with the server, or null.
    fn protocol() -> string? { self.conn.wire_protocol() }

    /// Closed; answers the descriptor.
    fn close() -> Result<int, ClientError> { carried(self.conn.wire_close()) }
}

/// A net failure that was the deadline passing reads as `.TimedOut`.
/// Field `i` of a reply, as text — values are ASCII by framing.
fn header_at(raw: Bytes, fields: Fields, i: int) -> Header {
    let n = fields.name_at(i)
    let v = fields.value_at(i)
    Header { name: raw.slice(n.lo, n.hi).text() ?? "", value: raw.slice(v.lo, v.hi).text() ?? "" }
}

fn timed(r: Result<Answer, ClientError>) -> Result<Answer, ClientError> {
    match r {
        .Err(.Net(e)) if e.timed_out() -> .Err(.TimedOut),
        .Err(e) -> .Err(e),
        .Ok(a) -> .Ok(a),
    }
}
