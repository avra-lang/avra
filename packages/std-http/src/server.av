//! server.av — the SERVER: a listener, a handler that answers a
//! `Request` with a `Response`, and one task per connection.
//!
//! `run` accepts on the calling task and spawns each connection its own
//! task, so a handler that waits — a sleep, a query, a call out —
//! stalls only its own connection. The handler is written
//! synchronously, and every connection holds its OWN COPY of the
//! application: a plain field is that connection's state, and state
//! shared across connections lives in a `Cell` the application
//! declares (`hits: Cell<int>`).
//!
//! A connection's whole state is a `Link`: its socket, the bytes read
//! and not yet consumed, how far the head scan reached, the head
//! awaiting its body, the chunked decoder in flight, the output owed,
//! whether the connection closes after this response, and how many
//! requests it has served. Nothing else is needed (the framing laws,
//! §3.2).
//!
//! THE LAWS A CONNECTION HOLDS: responses go out in the order requests
//! came in, so a pipelined tail stays in the buffer and is framed next;
//! a refusal is answered with its status and `connection: close`, then
//! the write side is shut and the socket closed; a peer's FIN is not a
//! request delimiter and not disinterest — an owed response is still
//! written; a `100 Continue` is written when a body is expected and
//! none of it has arrived; a HEAD carries the body's length and none of
//! its bytes; a connection silent past the deadline its state names is
//! dropped.
use @std.net.{Listener, Conn, NetError}
use @std.time.{Duration, ms, secs}
use frame.{Head, Chunker, Limits, framed, chunker, fed, status_of, limits}
use http.{Request, Response, wire, status, read_size, as_sent}

/// The deadlines a server names: a head must complete within `head`
/// of its last byte, a body must advance within `body` of its last
/// byte, an idle keep-alive connection lives `idle` (and a peer that
/// takes no output is given as long), and a connection serves at most
/// `requests`.
export type Timing = { head: Duration = secs(10), body: Duration = secs(60), idle: Duration = secs(75), requests: int = 1000 }

/// The default deadlines.
export fn timing() -> Timing { Timing {} }

/// A live connection.
type Link = {
    conn: Conn,
    peer: string,
    buf: Bytes,
    scanned: int,
    head: Head?,
    decoder: Chunker?,
    out: Bytes,
    closing: bool,
    served: int,
}

/// The server: its listener, the application each connection copies,
/// the handler, and two counters every copy shares.
export type Server<A> = {
    listener: Listener,
    app: A,
    handle: fn(mut A, Request) -> Response,
    limits: Limits,
    timing: Timing,
    live: Cell<int>,
    stopping: Cell<bool>,
}

/// A server on `l`, its handler given each connection's copy of `app`
/// — the handler is the last seat, so a call writes it as a trailing
/// block: `served(l, app, limits(), timing()) { mut app, q -> … }`.
export fn served<A>(l: Listener, app: A, limits: Limits, timing: Timing, handle: fn(mut A, Request) -> Response) -> Server<A> {
    Server { listener: l, app: app, handle: handle, limits: limits, timing: timing, live: Cell.new(0), stopping: Cell.new(false) }
}

once fn continue_line() -> Bytes { "HTTP/1.1 100 Continue\r\n\r\n".bytes() }

impl Server {
    /// Accepts until `stop`, each connection served on a task of its
    /// own; answers how many were accepted. A connection still open
    /// when it stops is served to its end before this answers.
    fn run() -> Result<int, NetError> {
        let conns = Tasks.new()
        mut accepted = 0
        while true {
            let next = self.listener.accept()
            if self.stopping.get() { return .Ok(accepted) }
            let c = next?
            conns.push(spawn self.connection(c))
            accepted = accepted + 1
        }
        .Ok(accepted)
    }

    /// No more connections accepted: the listener closes, and `run`
    /// answers once the open ones end.
    fn stop() {
        self.stopping.set(true)
        let _ = self.listener.close()
    }

    /// How many connections are open.
    fn connections() -> int { self.live.get() }

    // ── A connection ────────────────────────────────────────────

    /// One connection, served on its own copy of the application.
    fn connection(c: Conn) -> int {
        self.live.set(self.live.get() + 1)
        mut serving = Serving { app: self.app, handle: self.handle, limits: self.limits, timing: self.timing }
        let fd = serving.conversed(Link { conn: c, peer: c.peer(), buf: "".bytes(), scanned: 0, head: null, decoder: null, out: "".bytes(), closing: false, served: 0 })
        self.live.set(self.live.get() - 1)
        fd
    }
}

/// The server as one connection sees it: that connection's own
/// application, and the handler, bounds and deadlines it answers by.
type Serving<A> = {
    app: A,
    handle: fn(mut A, Request) -> Response,
    limits: Limits,
    timing: Timing,
}

impl Serving {

    /// Every request the buffer completes served, what is owed written,
    /// and the next bytes read under the deadline the link's state
    /// names — until the link parts, or its peer is silent too long.
    mut fn conversed(first: Link) -> int {
        mut l = first
        while true {
            l = self.advanced(l)
            if !self.flushed(l) { return self.dropped(l) }
            l = l with { out: "".bytes() }
            if l.closing { return self.parted(l) }
            match within ms(self.deadline(l)) { l.conn.read(read_size()) } {
                .Ok(b) -> { l = heard(l, b) },
                .Err(_) -> { return self.dropped(l) },
            }
        }
        l.conn.fd
    }

    /// The buffer framed as far as it goes: every complete request in
    /// it served in order, a partial one left for the next read.
    mut fn advanced(l: Link) -> Link {
        mut cur = l
        while true {
            match self.stepped(cur) {
                .Served(next) -> { cur = next },
                .Waiting(next) -> { return next },
            }
        }
        cur
    }

    /// One request's worth of progress over the buffer.
    mut fn stepped(l: Link) -> Progress {
        if l.closing { return .Waiting(l) }
        if l.head == null { return self.framing(l) }
        self.bodied(l, l.head!)
    }

    /// The head framed from the buffer's start, or waited for, or
    /// refused with its status and a close.
    mut fn framing(l: Link) -> Progress {
        match framed(l.buf, 0, l.scanned, self.limits) {
            .Partial -> .Waiting(l with { scanned: l.buf.length }),
            .Refused(why) -> self.refused(l, status_of(why)),
            .Complete(head) -> self.headed(l with { head: head, scanned: 0 }, head),
        }
    }

    /// A head in hand: a body-less request is served now; a body is
    /// awaited, with `100 Continue` written when it was asked for and
    /// none of it has arrived.
    mut fn headed(l: Link, head: Head) -> Progress {
        match head.body {
            .None -> self.answered(l, head, "".bytes(), head.end),
            .Length(_) or .Chunked -> self.bodied(self.continued(l, head), head),
        }
    }

    fn continued(l: Link, head: Head) -> Link {
        if !head.expects_continue || l.buf.length > head.end { return l }
        l with { out: l.out.concat(continue_line()) }
    }

    /// The body gathered when the buffer holds it whole.
    mut fn bodied(l: Link, head: Head) -> Progress {
        match head.body {
            .None -> self.answered(l, head, "".bytes(), head.end),
            .Length(n) -> if l.buf.length < head.end + n { .Waiting(l) } else { self.answered(l, head, l.buf.slice(head.end, head.end + n), head.end + n) },
            .Chunked -> self.chunked(l, head),
        }
    }

    mut fn chunked(l: Link, head: Head) -> Progress {
        match fed(l.decoder ?? chunker(head.end), l.buf, self.limits) {
            .More(c) -> .Waiting(l with { decoder: c }),
            .Refused(why) -> self.refused(l, status_of(why)),
            .Done(body, end) -> self.answered(l with { decoder: null }, head, body, end),
        }
    }

    /// The request answered by the handler and its response queued;
    /// the consumed bytes leave the buffer so a pipelined tail is
    /// framed next.
    mut fn answered(l: Link, head: Head, body: Bytes, end: int) -> Progress {
        let q = Request { raw: l.buf, head: head, body: body, peer: l.peer }
        let r = self.handle(self.app, q)
        let served = l.served + 1
        let keep = head.keep_alive && served < self.timing.requests
        let bytes = wired(r, keep, head)
        .Served(l with { buf: l.buf.slice(end, l.buf.length), scanned: 0, head: null, out: l.out.concat(bytes), closing: !keep, served: served })
    }

    /// A refused head: its status, `connection: close`, and no more
    /// requests read from this connection.
    fn refused(l: Link, code: int) -> Progress {
        .Served(l with { out: l.out.concat(wire(status(code), false, 1)), closing: true, head: null, buf: "".bytes() })
    }

    /// What the link owes written whole — false when the peer takes
    /// none of it within the idle deadline, or the socket fails.
    fn flushed(l: Link) -> bool {
        if l.out.is_empty() { return true }
        match within self.timing.idle { l.conn.write(l.out) } {
            .Ok(_) -> true,
            .Err(_) -> false,
        }
    }

    /// The write side shut after the last byte, the socket closed.
    fn parted(l: Link) -> int {
        let _ = l.conn.shutdown_write()
        self.dropped(l)
    }

    /// The link's socket closed.
    fn dropped(l: Link) -> int {
        let _ = l.conn.close()
        l.conn.fd
    }

    /// How long this link may stay silent, in ms: a body in flight is
    /// owed the body deadline, a head half-arrived the head's, an idle
    /// keep-alive connection the idle one.
    fn deadline(l: Link) -> int {
        when {
            l.head != null -> self.timing.body.ms
            l.buf.length > 0 -> self.timing.head.ms
            _ -> self.timing.idle.ms
        }
    }
}

/// The bytes a read brought, or — at the peer's end — a link that
/// finishes what it owes and parts.
fn heard(l: Link, b: Bytes?) -> Link {
    let got? = b else { return l with { closing: true } }
    l with { buf: l.buf.concat(got) }
}

/// Where one step over the buffer left a link: a request served and
/// its bytes consumed, or nothing more to serve until a read.
enum Progress {
    Served(l: Link)
    Waiting(l: Link)
}

/// The response on the wire for a request: a HEAD's answer carries
/// the body's length and none of its bytes.
///
/// IT MEASURES THE BODY OF THE RESPONSE THAT WAS WRITTEN, never the
/// handler's — `wire` answers the server's own 500 for a response no
/// peer could read, and measuring the handler's body against that
/// wire cuts the head mid-field.
fn wired(r: Response, keep: bool, head: Head) -> Bytes {
    let sent = as_sent(r)
    let whole = wire(sent, keep, head.minor)
    if head.method is .Head { return whole.slice(0, whole.length - sent.body.length) }
    whole
}
