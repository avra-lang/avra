//! server.av — the SERVER: a listener, a handler that answers a
//! `Request` with a `Response`, and one task per connection.
//!
//! `run` serves on every core this process may run on — one process
//! per core, sharing nothing but the listener — or on `run(cores: n)`.
//! Each core MAKES its own application with the server's `make`, so a
//! `Cell` the maker builds is that core's, and so is a database handle
//! it opens. A core accepts on its calling task and spawns each
//! connection its own task, so a handler that waits — a sleep, a
//! query, a call out — stalls only its own connection. The handler is
//! written synchronously, and every connection holds its OWN COPY of
//! its core's application: a plain field is that connection's state,
//! and state shared across a core's connections lives in a `Cell` the
//! application declares (`hits: Cell<int>`).
//!
//! A CORE THAT CRASHES STOPS THE SERVER: the rest stop as `stop` stops
//! them, and `run` traps naming the core. Placement never changes what
//! a program means, so a crash on one core of many ends the server as
//! it does on one.
//!
//! A SERVER SECURED (`secured(over_tls(config))` from `@std/https`, or
//! a declaration's `tls` setting) opens every connection through it:
//! the handshake runs on the connection's own task within
//! `timing.handshake`, then the link is served exactly as a plain one
//! is.
//!
//! A connection's whole state is a `Link`: its transport, the bytes read
//! and not yet consumed, how far the head scan reached, the output
//! owed, whether the connection closes after this response, and how
//! many requests it has served. A request's body in flight is the
//! request's own (`body.av`), read on this connection's task by the
//! handler that asks for it. Nothing else is needed (the framing laws,
//! §3.2).
//!
//! THE LAWS A CONNECTION HOLDS: responses go out in the order requests
//! came in, so a pipelined tail stays in the buffer and is framed next;
//! a refusal is answered with its status and `connection: close`, then
//! the write side is shut and the socket closed; a peer's FIN is not a
//! request delimiter and not disinterest — an owed response is still
//! written; the handler runs once its head is here and reads the body
//! as it asks, and a `100 Continue` is written before its first read
//! when none of the body has arrived — never for a body nobody reads;
//! a body the handler left is dropped up to the gathered bound, else
//! the connection closes behind the answer; a body that broke is
//! answered by the law it broke, never by the handler; a HEAD carries the body's length and none of
//! its bytes; a connection silent past the deadline its state names is
//! dropped; a streamed response is pulled one piece at a time, each
//! written before the next is asked for, and a stream that breaks after
//! its head ends the connection with no second status; a `101` hands
//! the connection to its upgrade, on this same task, and no more of it
//! is read as HTTP.
use @std.net.{Listener, Conn, NetError, listen}
use @std.time.{Duration, ms, secs, sleep, now_ms, within}
use frame.{Head, Limits, Method, ReplyBody, RequestBody, framed, status_of, limits}
use body.{Body, BodyError, measured, chunked_from, whole}
use http.{
    Request,
    Unrouted,
    Response,
    Stream,
    Upgrade,
    upgrade_head,
    wire,
    status,
    read_size,
    sendable,
    released,
    delimited,
    head_of,
    piece_on_wire,
    body_end,
    within_length,
    completes,
}
use wire.{Transport, WireError, Secure, plainly}
use route.{Route, compiled, dispatch}
use h2.{H2Conn, Exchange, h2_server, preface}
use h2_serve.{H2Side, Pour, request_of, answered_on, refused_on, scheme_of, stream_body}

extern fn avra_cores_online() -> int
extern fn avra_cores_group(n: int) -> int
extern fn avra_cores_fork(g: int, serving: int) -> int
extern fn avra_cores_stop_fd(g: int) -> int
extern fn avra_cores_stopped(g: int) -> int
extern fn avra_cores_count(g: int, core: int, live: int)
extern fn avra_cores_live(g: int) -> int
extern fn avra_cores_leave(g: int, core: int, accepted: int, err: int) -> int
extern fn avra_cores_end_fd(g: int, core: int) -> int
extern fn avra_cores_heard(g: int, core: int) -> int
extern fn avra_cores_stop(g: int)
extern fn avra_cores_result(g: int) -> int
extern fn avra_fiber_park_fd(fd: int, writable: int, timeout_ms: int) -> int

/// The deadlines a server names: a TLS handshake must complete within
/// `handshake` of the accept, a head within `head` of its last byte, a
/// body must advance within `body` of its last byte, an idle keep-alive
/// connection lives `idle` (and a peer that takes no output is given as
/// long), and a connection serves at most `requests`.
export type Timing = {
    handshake: Duration = secs(10),
    head: Duration = secs(10),
    body: Duration = secs(60),
    idle: Duration = secs(75),
    requests: int = 1000,
}

/// The default deadlines.
export fn timing() -> Timing { Timing {} }

/// A live connection.
type Link = {
    conn: dyn Transport,
    peer: string,
    buf: Bytes,
    scanned: int,
    out: Bytes,
    closing: bool,
    served: int,
}

/// The server: its listener, the maker each core builds its
/// application with, the handler, and this process's own state — its
/// open connections, whether it is stopping, and the group of cores it
/// serves in (0 alone) with its place there (-1 for the supervisor).
export type Server<A> = {
    listener: Listener,
    make: fn() -> A,
    handle: fn(mut A, Request<Unrouted>) -> Response,
    limits: Limits,
    timing: Timing,
    tls: Secure?,
    live: Cell<int>,
    stopping: Cell<bool>,
    group: Cell<int>,
    core: Cell<int>,
}

/// A server on `l`, each core's application made by `make` — isolated,
/// so what it makes is that core's own — and each connection's copy
/// of it handed to the handler — the last seat, so
/// a call writes it as a trailing block:
/// `served(l, () -> App { … }, limits(), timing()) { mut app, q -> … }`.
export fn served<A>(
    l: Listener,
    isolated make: fn() -> A,
    limits: Limits,
    timing: Timing,
    handle: fn(mut A, Request<Unrouted>) -> Response,
) -> Server<A> {
    Server {
        listener: l,
        make: make,
        handle: handle,
        limits: limits,
        timing: timing,
        tls: null,
        live: Cell.new(0),
        stopping: Cell.new(false),
        group: Cell.new(0),
        core: Cell.new(-1),
    }
}

// ── A server as a declaration ───────────────────────────────────

/// `server app { port: 8080  get "/" { … } }` — routes served at an
/// address, over TLS when `tls` is set (`@std/https`'s `over_tls`): the settings
/// by name, each route line collected in the order written (the order
/// that answers first), and each layer — written in place, or a named
/// one listed by its name — wrapped around them all, the first
/// outermost.
export component server {
    host: string = "127.0.0.1"
    port: int = 8080
    tls: Secure? = null
    layers: List<layer> = []
    routes: List<Route> = []
}

/// `layer auth { req, next -> … }` — a fn every request passes through
/// on its way to the routes: it answers itself, or hands the request
/// on to `next`. A server lists a named layer by its name.
export component layer {
    wraps: fn(Request<Unrouted>, Handler) -> Response
}

/// The way a request comes in: through each layer, the first
/// outermost, to what `inner` answers.
fn through(layers: List<layer>, inner: Handler) -> Handler {
    let outer? = layers.first() else { return inner }
    let next = through([l for j, l in layers if j > 0], inner)
    (q: Request<Unrouted>) -> outer.wraps(q, next)
}

/// What a server of routes keeps between requests: nothing.
export type Stateless = {}

impl server {
    /// This server bound and ready: its routes compiled once into the
    /// table every connection dispatches through.
    fn listening() -> Result<Server<Stateless>, NetError> {
        let l = listen(self.host, self.port)?
        let routed = compiled(self.routes)
        let handled = through(self.layers, (q: Request<Unrouted>) -> dispatch(routed, q))
        let plain = served(l, () -> Stateless {}, limits(), timing()) { _none, q -> handled(q) }
        let opener? = self.tls else { return .Ok(plain) }
        .Ok(plain.secured(opener))
    }

    /// Listens and serves on every core until stopped; answers how many
    /// connections it took.
    fn run() -> Result<int, NetError> {
        (self.listening()?).run()
    }
}

/// Every core this process may run on: where `run` serves unless told.
export fn every_core() -> int { avra_cores_online() }

once fn continue_line() -> Bytes { "HTTP/1.1 100 Continue\r\n\r\n".bytes() }

impl Server {
    /// Accepts until `stop` on `cores` processes that share nothing
    /// but the listener; answers how many connections they accepted.
    /// A connection still open when it stops is served to its end
    /// before this answers. One core serves on the calling task, with
    /// no process of its own.
    fn run(cores: int = every_core()) -> Result<int, NetError> {
        // a stopped listener's number may be another descriptor's now
        if self.stopping.get() { return .Ok(0) }
        if cores == 1 { return self.accepting(self.make()) }
        let g = avra_cores_group(cores)
        if g < 0 { return .Err(NetError { verb: "run", subject: "on ${cores} cores", errno: 0 - g }) }
        let core = avra_cores_fork(g, self.listener.fd)
        if core < 0 { return .Err(NetError { verb: "run", subject: "on ${cores} cores", errno: 0 - core }) }
        if core == cores { return self.supervised(g, cores) }
        self.cored(g, core)
    }

    /// No more connections accepted: the listener closes, every core
    /// is told to stop, and `run` answers once the open connections
    /// end.
    fn stop() {
        self.stopping.set(true)
        let _ = self.listener.close()
        if self.group.get() != 0 { avra_cores_stop(self.group.get()) }
    }

    /// How many connections are open — across every core, asked where
    /// `run` supervises them.
    fn connections() -> int {
        if self.group.get() != 0 && self.core.get() < 0 { return avra_cores_live(self.group.get()) }
        self.live.get()
    }

    // ── Cores ───────────────────────────────────────────────────

    /// Accepts until `stop`, each connection served on a task of its
    /// own over its copy of `app`; answers how many were accepted,
    /// once every one has ended.
    fn accepting(app: A) -> Result<int, NetError> {
        let conns = Tasks.new()
        mut accepted = 0
        while true {
            let next = self.listener.accept()
            if self.stopping.get() { return .Ok(accepted) }
            let c = next?
            conns.push(spawn self.connection(c, app))
            accepted = accepted + 1
        }
        .Ok(accepted)
    }

    /// This process is core `core` of group `g`: it makes its own
    /// application, serves until the group stops, and leaves the
    /// process — this never answers.
    fn cored(g: int, core: int) -> Result<int, NetError> {
        self.group.set(g)
        self.core.set(core)
        spawn self.stopped_with(g)
        match self.accepting(self.make()) {
            .Ok(n) -> .Ok(avra_cores_leave(g, core, n, 0)),
            .Err(e) -> .Ok(avra_cores_leave(g, core, 0, e.errno)),
        }
    }

    /// Parks until group `g` stops — or its supervisor is gone — then
    /// stops this core.
    fn stopped_with(g: int) {
        while avra_cores_stopped(g) == 0 { let _ = avra_fiber_park_fd(avra_cores_stop_fd(g), 0, -1) }
        self.stop()
    }

    /// This process supervises the `cores` of group `g`: every core
    /// waited for, the first to end stopping the rest, then one answer
    /// for them all. Cores that ended unasked leave the listener closed
    /// here too, so no connection waits on a port nobody accepts.
    fn supervised(g: int, cores: int) -> Result<int, NetError> {
        self.group.set(g)
        let _ = watched(g, cores)
        if !self.stopping.get() { self.stop() }
        self.group.set(0)
        let r = avra_cores_result(g)
        if r < 0 { return .Err(NetError { verb: "accept", subject: "on a core", errno: 0 - r }) }
        .Ok(r)
    }

    // ── A connection ────────────────────────────────────────────

    /// This server opening every connection through `opener` — TLS,
    /// from `@std/https`'s `over_tls`.
    fn secured(opener: Secure) -> Server<A> { self with { tls: opener } }

    /// One connection, served on its own copy of the application.
    fn connection(c: Conn, app: A) -> int {
        self.opened(1)
        let fd = self.conversation(c, app)
        self.opened(-1)
        fd
    }

    /// The connection's transport made, then its requests served —
    /// none when a TLS connection never completed its handshake.
    fn conversation(c: Conn, app: A) -> int {
        let w? = self.transport(c) else { return c.fd }
        mut serving = Serving {
            app: app,
            handle: self.handle,
            limits: self.limits,
            timing: self.timing,
        }
        serving.conversed(w)
    }

    /// The connection as it is spoken: plain, or TLS once a handshake
    /// completes within the deadline — null, the socket closed, when
    /// one does not.
    fn transport(c: Conn) -> dyn Transport? {
        let opener? = self.tls else { return plainly(c) }
        opener.open(c, self.timing.handshake)
    }

    /// This process's open connections moved by `by`, and published to
    /// the supervisor when the process is a core.
    fn opened(by: int) {
        self.live.set(self.live.get() + by)
        if self.core.get() >= 0 { avra_cores_count(self.group.get(), self.core.get(), self.live.get()) }
    }
}

/// Every one of group `g`'s `cores` waited for; the first to end
/// stops the rest.
fn watched(g: int, cores: int) -> int {
    let ends = [spawn core_ended(g, core) for core in 0..cores]
    ends.length
}

/// Parks until core `core` of group `g` ends, then stops the rest.
fn core_ended(g: int, core: int) -> int {
    while avra_cores_heard(g, core) != 0 { let _ = avra_fiber_park_fd(avra_cores_end_fd(g, core), 0, -1) }
    avra_cores_stop(g)
    core
}

/// The server as one connection sees it: that connection's own
/// application, and the handler, bounds and deadlines it answers by.
type Serving<A> = {
    app: A,
    handle: fn(mut A, Request<Unrouted>) -> Response,
    limits: Limits,
    timing: Timing,
}

impl Serving {

    /// Every request the buffer completes served, what is owed written,
    /// and the next bytes read under the deadline the link's state
    /// names — until the link parts, or its peer is silent too long.
    /// The link is ONE record, written in place for the whole
    /// conversation.
    mut fn conversed(c: dyn Transport) -> int {
        mut l = Link {
            conn: c,
            peer: c.wire_peer(),
            buf: "".bytes(),
            scanned: 0,
            out: "".bytes(),
            closing: false,
            served: 0,
        }
        if c.wire_protocol() == h2_protocol { return self.h2_conversed(l) }
        while true {
            if opens_h2(l) { return self.h2_conversed(l) }
            self.advanced(l)
            if !self.flushed(l) { return self.dropped(l) }
            l.out = "".bytes()
            if l.closing { return self.parted(l) }
            match within ms(self.deadline(l)) { l.conn.wire_read(read_size()) } {
                .Ok(b) -> heard(l, b),
                .Err(_) -> { return self.dropped(l) },
            }
        }
        l.conn.wire_fd()
    }

    /// The buffer framed as far as it goes: every complete request in
    /// it served in order, a partial one left for the next read.
    mut fn advanced(mut l: Link) {
        while self.stepped(l) { nothing_stepped() }
    }

    /// One request's worth of progress over the buffer: whether a
    /// request was served, so another may follow.
    mut fn stepped(mut l: Link) -> bool {
        if l.closing || awaits_preface(l) { return false }
        match framed(l.buf, 0, l.scanned, self.limits) {
            .Partial -> waited(l),
            .Refused(why) -> refused(l, status_of(why)),
            .Complete(head) -> {
                l.scanned = 0
                self.answered(l, head)
            },
        }
    }

    /// The request answered by the handler and its response queued.
    /// The handler runs ONCE ITS HEAD IS HERE, and reads the body as it
    /// asks for it; what it did not read is read and dropped after —
    /// or the connection closes, when that is more than a gathered body
    /// may hold or its peer was never told to send it. A body that
    /// broke is answered by the law it broke, never by the handler;
    /// what the connection read past it is framed next. Whatever this
    /// link owes is written before a body is read, so an earlier
    /// answer never waits behind a later request's body.
    mut fn answered(mut l: Link, head: Head) -> bool {
        let body = self.body_of(l, head)
        if !(head.body is .None) {
            if !self.flushed(l) { return parted_early(l) }
            l.out = "".bytes()
        }
        let q = Request { raw: l.buf, head: head, body: body, peer: l.peer, params: Unrouted {} }
        let sent = judged(self.answer(q, q.scheme(), l.conn.wire_secured()))
        l.served = l.served + 1
        let after = after_body(body, head, l.buf, self.limits)
        body.detached()
        match after {
            .Next(tail) -> self.replied(l, sent, head, tail, true),
            .Close -> self.replied(l, sent, head, "".bytes(), false),
            .Refuse(code) -> {
                released(sent)
                refused(l, code)
            },
            .Gone -> {
                released(sent)
                parted_early(l)
            },
        }
    }

    /// The body of the request `head` frames, read from this link as
    /// the handler asks — each read given the body deadline, and a
    /// `100 Continue` owed when it was asked for and none of the body
    /// has arrived.
    fn body_of(l: Link, head: Head) -> Body {
        let owed = if head.expects_continue && l.buf.length <= head.end { continue_line() } else { "".bytes() }
        match head.body {
            .None -> Body.Empty,
            .Length(n) -> measured(l.conn, l.buf, head.end, n, owed, self.timing.body, self.limits),
            .Chunked -> chunked_from(l.conn, l.buf, head.end, owed, self.timing.body, self.limits),
        }
    }

    /// `sent` queued — or poured, when it streams — with `tail` framed
    /// next; the connection kept only when `open` and the request and
    /// the response both allow it.
    fn replied(mut l: Link, sent: Response, head: Head, tail: Bytes, open: bool) -> bool {
        let delim = delimited(sent, head.minor)
        let keep = open &&
            head.keep_alive &&
            l.served < self.timing.requests &&
            !(delim is .UntilClose)
        l.buf = tail
        l.closing = !keep
        if sent.upgrade != null { return self.handed(l, sent, sent.upgrade!) }
        match sent.stream {
            s? -> self.poured(l, head_of(sent, delim, keep, head.minor), s, delim, head)
            null -> { l.out = l.out.concat(wired(sent, delim, keep, head)) }
        }
        true
    }

    /// A 101 WRITTEN AND THE CONNECTION HANDED OVER: the head after
    /// whatever this link owes, then `up` runs here, on this task, with
    /// the socket and what the peer sent past its request. Nothing more
    /// is read as HTTP; the connection ends when `up` returns.
    fn handed(mut l: Link, sent: Response, up: Upgrade) -> bool {
        let owed = l.out.concat(upgrade_head(sent))
        l.out = "".bytes()
        l.closing = true
        if self.sent(l.conn, owed) { up.run(l.conn, l.buf) }
        l.buf = "".bytes()
        false
    }

    /// A STREAMED RESPONSE WRITTEN: its head after whatever this link
    /// already owes, then each piece — a HEAD's answer ends at its head,
    /// the stream released unpulled. A stream that did not go out whole
    /// ends the connection: the head has spoken, so no second status
    /// follows it.
    fn poured(mut l: Link, said: Bytes, s: Stream, delim: ReplyBody, asked: Head) {
        let owed = l.out.concat(said)
        l.out = "".bytes()
        let whole = if asked.method is .Head { self.sent(l.conn, owed) } else { self.pumped(l.conn, owed, s, delim) }
        s.ended()
        if !whole { l.closing = true }
    }

    /// `owed`, then every piece `s` answers, each pulled only once the
    /// last is written and each written as soon as it is pulled — a
    /// piece is a flush. Whether the body went out whole: a producer's
    /// failure, a piece past its length, an end short of it, and a peer
    /// that takes nothing within the idle deadline each answer false.
    ///
    /// NO STREAM HOLDS THE CORE OR THE CONNECTION PAST AN IDLE ONE'S LIFE.
    /// Every pull is given the idle deadline, so a producer parked on a
    /// source gone quiet fails its own wait; a producer answering empty
    /// pieces is as quiet as one answering nothing, and is cut by the
    /// same clock; and every piece yields, so a peer fast enough never
    /// to fill the socket still leaves the other connections their turn.
    fn pumped(c: dyn Transport, owed: Bytes, s: Stream, delim: ReplyBody) -> bool {
        if !self.sent(c, owed) { return false }
        mut total = 0
        mut heard = now_ms()
        while true {
            match within self.timing.idle { s.pull() } {
                .Data(b) -> {
                    total = total + b.length
                    if !within_length(delim, total) || !self.sent(c, piece_on_wire(b, delim)) { return false }
                    if !b.is_empty() { heard = now_ms() }
                    if now_ms() - heard > self.timing.idle.ms { return false }
                    sleep(ms(0))
                },
                .End -> { return completes(delim, total) && self.sent(c, body_end(delim)) },
                .Failed -> { return false },
            }
        }
        false
    }

    /// `b` written whole within the idle deadline — nothing to write is
    /// written at once.
    fn sent(c: dyn Transport, b: Bytes) -> bool {
        if b.is_empty() { return true }
        match within self.timing.idle { c.wire_write(b) } { .Ok(_) -> true, .Err(_) -> false }
    }

    /// What the link owes written whole — false when the peer takes
    /// none of it within the idle deadline, or the socket fails.
    fn flushed(l: Link) -> bool { self.sent(l.conn, l.out) }

    /// The write side shut after the last byte, the socket closed.
    fn parted(l: Link) -> int {
        let _ = l.conn.wire_shutdown()
        self.dropped(l)
    }

    /// The link's socket closed.
    fn dropped(l: Link) -> int {
        let _ = l.conn.wire_close()
        l.conn.wire_fd()
    }

    /// How long this link may stay silent, in ms: a head half-arrived
    /// is owed the head deadline, an idle keep-alive connection the idle
    /// one. A body is read under its own deadline, by whoever reads it.
    fn deadline(l: Link) -> int {
        if l.buf.length > 0 { return self.timing.head.ms }
        self.timing.idle.ms
    }
}

fn nothing_stepped() {}

// ── HTTP/2 with prior knowledge ─────────────────────────────────

/// Whether a link's first octets are the HTTP/2 preface — only a link
/// that has served nothing yet may turn out to be one (RFC 9113 §3.3).
/// A link whose TLS handshake selected `h2` by ALPN enters
/// `h2_conversed` without asking: its client sends the same preface.
fn opens_h2(l: Link) -> bool { l.served == 0 && l.buf.length >= preface.length && l.buf.slice(0, preface.length) == preface }

/// Whether a fresh link's octets so far are a proper prefix of the
/// preface — neither version yet, so the 1.1 framer is not asked: the
/// preface's first eighteen octets are a whole 1.1 head, which it would
/// refuse as another major version.
fn awaits_preface(l: Link) -> bool {
    l.served == 0 &&
        l.buf.length < preface.length &&
        !l.buf.is_empty() &&
        l.buf == preface.slice(0, l.buf.length)
}

impl Serving {
    /// The link as HTTP/2: every frame fed to one connection value,
    /// every request whose head arrives answered by the same handler a
    /// 1.1 request is, every streamed answer pulled as its windows open,
    /// what is owed written — until either end goes away, the link has
    /// served its bound, or its peer is silent too long. An answer held
    /// behind a shut window that has not moved for the idle deadline
    /// ends the link, whatever else the peer sends: a window held shut
    /// behind a trickle of PINGs holds nothing longer than an idle link.
    mut fn h2_conversed(mut l: Link) -> int {
        mut h = h2_server(self.limits)
        mut pours: List<Pour> = []
        mut delivered = 0
        mut moved = now_ms()
        while true {
            let at = h.fed(l.buf, 0)
            l.buf = l.buf.slice(at, l.buf.length)
            while !h.ready.is_empty() {
                for x in h.taken() {
                    l.served = l.served + 1
                    let more = match h.arrived(x.stream) {
                        .Whole(b) -> self.h2_delivered(h, x, self.h2_reply(l, x, (_k) -> whole(b))),
                        .Flowing(b) -> {
                            let side = Cell.new(H2Side { conn: h, buf: l.buf })
                            let reply = self
                                .h2_reply(
                                    l,
                                    x,
                                    (k) -> stream_body(
                                        side,
                                        l.conn,
                                        x.stream,
                                        b,
                                        k,
                                        self.timing.body,
                                        self.limits,
                                    ),
                                )
                            let back = side.get()
                            h = back.conn
                            l.buf = back.buf
                            self.h2_delivered(h, x, reply)
                        },
                        .Cut -> [],
                    }
                    pours = pours.concat(more)
                }
            }
            pours = self.h2_poured(h, pours)
            if l.served >= self.timing.requests && !h.closing { h.ended() }
            h.parted_when_quiet()
            let waiting = h.owing() > 0 || !pours.is_empty()
            if !waiting || h.delivered != delivered { moved = now_ms() }
            delivered = h.delivered
            if waiting && now_ms() - moved > self.timing.idle.ms && !h.closing { h.ended() }
            l.out = h.drained()
            if !self.flushed(l) {
                unpoured(pours)
                return self.dropped(l)
            }
            if l.closing || h.closing { unpoured(pours) }
            if l.closing { return self.parted(l) }
            if h.closing { return self.lingered(l) }
            let pouring = pours.any((p) -> h.hungry(p.id))
            let wait = if pouring { 0 } else if h.streams.is_empty() { self.timing.idle.ms } else { self.timing.body.ms }
            match within ms(wait) { l.conn.wire_read(read_size()) } {
                .Ok(b) -> heard(l, b),
                .Err(e) -> {
                    if !(pouring && timed_out(e)) {
                        unpoured(pours)
                        return self.dropped(l)
                    }
                },
            }
        }
        l.conn.wire_fd()
    }

    /// Stream `x`'s request answered by the handler, its body what
    /// `bodied` makes — or, when its head is one the 1.1 framer refuses,
    /// that refusal's status. A body that broke while the handler read it
    /// is answered by the law it broke, never by the handler.
    mut fn h2_reply(l: Link, x: Exchange, bodied: fn(RequestBody) -> Body) -> H2Reply {
        match request_of(x, l.peer, self.limits, bodied) {
            .Ok(q) -> H2Reply {
                answer: judged(self.answer(q, scheme_of(x), l.conn.wire_secured())),
                asked: q.head.method,
                body: q.body,
            },
            .Err(code) -> H2Reply { answer: status(code), asked: Method.Get, body: Body.Empty },
        }
    }

    /// A reply sent on its stream — the law a broken body broke in
    /// place of the answer, and nothing to a peer that went away — its
    /// body cut from the connection, and whatever of it the peer still
    /// sends refused once the answer ends. The pour a streamed answer
    /// leaves, if any.
    mut fn h2_delivered(mut h: H2Conn, x: Exchange, reply: H2Reply) -> List<Pour> {
        let broke = reply.body.failure()
        reply.body.detached()
        h.unheard(x.stream)
        let e? = broke else {
            let p? = answered_on(h, x.stream, reply.answer, reply.asked) else { return [] }
            return [p]
        }
        released(reply.answer)
        let code? = broken_status(e) else {
            h.cancelled(x.stream, .Cancel)
            return []
        }
        refused_on(h, x.stream, code)
        []
    }

    /// Each streamed answer pulled as far as its windows allow; the ones
    /// still flowing.
    fn h2_poured(mut h: H2Conn, ps: List<Pour>) -> List<Pour> {
        mut going: List<Pour> = []
        for p in ps { going = going.concat(self.h2_pumped(h, p)) }
        going
    }

    /// Pieces pulled for `p` while its stream wants one — only as fast
    /// as the peer reads, so an answer holds one piece at most — until
    /// the connection owes a batch, which is written before more. Pulls
    /// are given the idle deadline, a producer answering only empty
    /// pieces is as quiet as one answering nothing, and a piece past the
    /// declared length, an end short of it and a producer's failure
    /// each reset the stream: its head has spoken, so no second status
    /// follows it. The pour, while it still flows.
    fn h2_pumped(mut h: H2Conn, p: Pour) -> List<Pour> {
        mut sent = p.sent
        mut heard = now_ms()
        while h.hungry(p.id) && h.out.length < pour_batch {
            match within self.timing.idle { p.stream.pull() } {
                .Data(b) -> {
                    sent = sent + b.length
                    if !within_length(p.delim, sent) { return ended_pour(h, p, false) }
                    if !b.is_empty() { heard = now_ms() }
                    if now_ms() - heard > self.timing.idle.ms { return ended_pour(h, p, false) }
                    h.piece(p.id, b, false)
                    sleep(ms(0))
                },
                .End -> { return ended_pour(h, p, completes(p.delim, sent)) },
                .Failed -> { return ended_pour(h, p, false) },
            }
        }
        if !h.live(p.id) { return ended_pour(h, p, false) }
        [p with { sent: sent }]
    }

    /// The write side shut after this end's GOAWAY, then what the peer
    /// still sends read and dropped until it closes — for at most eight
    /// reads of a linger's length — and only then the socket closed. A
    /// socket closed over unread octets answers the peer with a reset,
    /// and a reset may destroy the GOAWAY before the peer reads it.
    fn lingered(l: Link) -> int {
        let _ = l.conn.wire_shutdown()
        mut open = true
        mut turns = 0
        while open && turns < 8 {
            open = match within ms(125) { l.conn.wire_read(read_size()) } {
                .Ok(b) -> b != null,
                .Err(_) -> false,
            }
            turns = turns + 1
        }
        self.dropped(l)
    }

    /// The handler's answer to `q` — or `421` when `scheme` is one the
    /// connection cannot serve.
    mut fn answer(q: Request<Unrouted>, scheme: Bytes?, secured: bool) -> Response {
        if misdirected(scheme, secured) { return status(421) }
        self.handle(self.app, q)
    }
}

/// A stream's request as its handler answered it: the answer, what was
/// asked, and the body the handler read.
type H2Reply = { answer: Response, asked: Method, body: Body }

/// Pour `p` ended: its last piece — or, when it did not go out whole,
/// its stream reset if it still lives — and its producer released.
fn ended_pour(mut h: H2Conn, p: Pour, whole: bool) -> List<Pour> {
    if whole { h.piece(p.id, "".bytes(), true) } else { h.cancelled(p.id, .Internal) }
    p.stream.ended()
    []
}

/// How much a connection may owe before its pours stop pulling and
/// what they pulled is written.
const pour_batch: int = 65536

/// Whether a transport verb failed only because its deadline passed.
fn timed_out(e: WireError) -> bool {
    match e { .Net(n) -> n.timed_out(), .Secure(_) or .Reset -> false }
}

/// Every pour's producer released: the link is going.
fn unpoured(ps: List<Pour>) { for p in ps { p.stream.ended() } }

/// Whether a request's scheme is one its connection cannot serve — an
/// `https` one over a plain socket, an `http` one over TLS: it is
/// answered `421` and never reaches a route (RFC 9110 §7.4). The
/// router itself is scheme-blind; only here is the connection known.
/// A 1.1 request names a scheme only in an absolute-form target; an
/// HTTP/2 one always, in `:scheme`.
fn misdirected(scheme: Bytes?, secured: bool) -> bool {
    let s? = scheme else { return false }
    s.ieq_at(0, s.length, if secured { plain_scheme } else { secure_scheme })
}

/// HTTP/2's ALPN protocol id (RFC 9113 §3.2).
const h2_protocol: string = "h2"

const plain_scheme: Bytes = "http".bytes()

const secure_scheme: Bytes = "https".bytes()

/// A partial head: what was scanned is not scanned again.
fn waited(mut l: Link) -> bool {
    l.scanned = l.buf.length
    false
}

/// A refused request: its status, `connection: close`, and no more
/// requests read from this connection.
fn refused(mut l: Link, code: int) -> bool {
    l.out = l.out.concat(wire(status(code), false, 1))
    l.closing = true
    l.buf = "".bytes()
    true
}

/// A peer gone mid-body: nothing more is read, and nothing answered.
fn parted_early(mut l: Link) -> bool {
    l.closing = true
    l.buf = "".bytes()
    false
}

/// What follows a request's body once its handler has answered: the
/// next request's octets, a close behind the answer, the status of the
/// law a broken body broke in place of the answer, or nothing at all —
/// the peer having gone.
enum After {
    Next(tail: Bytes)
    Close
    Refuse(code: int)
    Gone
}

/// What follows `body`, of the request `head` framed from `buf`: a body
/// that broke while the handler read it is answered by its own law; one
/// left unread is dropped up to the gathered bound, else the connection
/// closes behind the answer.
fn after_body(body: Body, head: Head, buf: Bytes, lim: Limits) -> After {
    if body is .Empty { return .Next(buf.slice(head.end, buf.length)) }
    let broke? = body.failure() else {
        if body.finished() || body.skipped(lim.body) { return .Next(body.tail()) }
        return .Close
    }
    let code? = broken_status(broke) else { return .Gone }
    .Refuse(code)
}

/// The status a broken body is answered with — the law it broke — or
/// absent when its peer went away and nobody is left to answer.
fn broken_status(e: BodyError) -> int? {
    match e {
        .TooLarge -> 413,
        .Malformed(why) -> status_of(why),
        .TimedOut -> 408,
        .Closed or .Net(_) or .Secure(_) -> null,
    }
}

/// The bytes a read brought, or — at the peer's end — a link that
/// finishes what it owes and parts.
fn heard(mut l: Link, b: Bytes?) {
    let got? = b else {
        l.closing = true
        return
    }
    l.buf = l.buf.concat(got)
}

/// The handler's answer as it will be written: itself when a peer
/// could read it, the server's own 500 when not — and a stream the 500
/// replaced is released, never pulled. Judged ONCE per request, and
/// every reader of the wire after reads what this answers.
fn judged(r: Response) -> Response {
    if sendable(r) { return r }
    released(r)
    status(500)
}

/// A whole response on the wire for a request: its head, then its body
/// — none of it for a HEAD, whose head still carries the length.
fn wired(sent: Response, delim: ReplyBody, keep: bool, head: Head) -> Bytes {
    mut w = head_of(sent, delim, keep, head.minor)
    if !(head.method is .Head) { w = w.concat(sent.body) }
    w
}
