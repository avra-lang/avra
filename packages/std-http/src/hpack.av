    header_field("location", ""),
    header_field("max-forwards", ""),
    header_field("proxy-authenticate", ""),
    header_field("proxy-authorization", ""),
    header_field("range", ""),
    header_field("referer", ""),
    header_field("refresh", ""),
    header_field("retry-after", ""),
    header_field("server", ""),
    header_field("set-cookie", ""),
    header_field("strict-transport-security", ""),
    header_field("transfer-encoding", ""),
    header_field("user-agent", ""),
    header_field("vary", ""),
    header_field("via", ""),
    header_field("www-authenticate", ""),
]

/// The static table's positions by name length — the longest static
/// name is 27 octets — so a search reads only the names that could
/// match.
const static_by_length: List<List<int>> = [[i for i, f in statics if f.name.length == n] for n in 0..28]

const no_indices: List<int> = []

/// The dynamic table (§2.3.2), entries OLDEST FIRST: an insert is a
/// push and an eviction drops a prefix. `size` is the entries' summed
/// cost and never passes `max`.
export type HeaderTable = { entries: List<HeaderField>, size: int, max: int }

/// An empty dynamic table of `max` octets.
export fn dynamic_table(max: int) -> HeaderTable { HeaderTable { entries: [], size: 0, max: max } }

impl HeaderTable {
    /// The entry at dynamic index `i`, 1 the newest — or absent.
    fn at(i: int) -> HeaderField? {
        if i < 1 || i > self.entries.length { return null }
        self.entries[self.entries.length - i]
    }

    /// The field at index `i` of the one index space: the static
    /// table's 61, then this table newest first (§2.3.3).
    fn indexed(i: int) -> HeaderField? {
        if i >= 1 && i <= statics.length { return statics[i - 1] }
        self.at(i - statics.length)
    }

    /// `f` added, the oldest entries evicted until it fits. An entry
    /// larger than the whole table empties it and is not kept (§4.4).
    mut fn inserted(f: HeaderField) {
        self.evicted(self.max - cost(f))
        if cost(f) > self.max { return }
        self.entries.push(f)
        self.size = self.size + cost(f)
    }

    /// The table at a new `max`, the oldest evicted until it fits.
    mut fn resized(max: int) {
        self.max = max
        self.evicted(max)
    }

    /// The oldest entries dropped until the rest cost at most `room`.
    mut fn evicted(room: int) {
        mut dropped = 0
        mut size = self.size
        while size > room && dropped < self.entries.length {
            size = size - cost(self.entries[dropped])
            dropped = dropped + 1
        }
        if dropped == 0 { return }
        self.entries = self.entries.slice(dropped, self.entries.length)
        self.size = size
    }
}

// ── Reading a block ─────────────────────────────────────────────

/// A block and how far into it the reading stands.
export type BlockCursor = { buf: Bytes, at: int }

/// A cursor at the start of `buf`.
export fn cursor(buf: Bytes) -> BlockCursor { BlockCursor { buf: buf, at: 0 } }

impl BlockCursor {
    fn done() -> bool { self.at >= self.buf.length }

    /// The octet under the cursor, taken.
    mut fn octet() -> Result<int, HpackRefusal> {
        if self.done() { return .Err(HpackRefusal.Truncated) }
        self.at = self.at + 1
        .Ok(self.buf.at(self.at - 1))
    }

    /// An integer on a prefix of `bits` bits (§5.1). Past `int_bound`
    /// it is refused, and so is a sixth continuation octet — a run of
    /// `0x80`s adds nothing and would otherwise never end.
    mut fn int(bits: int) -> Result<int, HpackRefusal> {
        let top = (1 << bits) - 1
        let first = self.octet()? & top
        if first < top { return .Ok(first) }
        mut value = top
        mut shift = 0
        while shift <= 28 {
            let b = self.octet()?
            value = value + ((b & 127) << shift)
            if value > int_bound { return .Err(HpackRefusal.Integer) }
            if b < 128 { return .Ok(value) }
            shift = shift + 7
        }
        .Err(HpackRefusal.Integer)
    }

    /// A string literal (§5.2): its length, then its octets, raw or
    /// Huffman-coded as the length's top bit says.
    mut fn string() -> Result<Bytes, HpackRefusal> {
        if self.done() { return .Err(HpackRefusal.Truncated) }
        let coded = self.buf.at(self.at) >= 128
        let n = self.int(7)?
        if n > self.buf.length - self.at { return .Err(HpackRefusal.Truncated) }
        let raw = self.buf.slice(self.at, self.at + n)
        self.at = self.at + n
        if coded { return huffman_decoded(raw) }
        .Ok(raw)
    }
}

/// What a representation answers: the field it names — absent for a
/// resize — or the law it broke.
alias Represented = Result<HeaderField?, HpackRefusal>

/// What a decoded block answers: its fields; `TooLarge` when their
/// list passed the bound — decoded whole all the same, so the table is
/// in step and only the stream is refused; or the law it broke.
export enum Unpacked {
    Fields(list: List<HeaderField>)
    TooLarge
    Refused(why: HpackRefusal)
}

/// One end's decoding state: the dynamic table; `limit`, the most a
/// resize may name — the SETTINGS_HEADER_TABLE_SIZE this end sent;
/// `owed`, whether the next block must open with a resize; `list`, the
/// bound on a block's decoded list, costed as the table costs a field.
export type HpackDecoder = { dynamic: HeaderTable, limit: int, owed: bool, list: int }

/// A decoder that advertised `limit` octets of table and takes blocks
/// whose list costs at most `list`.
export fn decoder(limit: int, list: int) -> HpackDecoder { HpackDecoder { dynamic: dynamic_table(limit), limit: limit, owed: false, list: list } }

impl HpackDecoder {
    /// This end now advertises `n`: a smaller limit is owed a resize
    /// at the next block's start (§4.2).
    mut fn limited(n: int) {
        if n < self.dynamic.max { self.owed = true }
        self.limit = n
    }

    /// One header block decoded against the table, which it moves.
    mut fn decoded(block: Bytes) -> Unpacked {
        mut c = cursor(block)
        mut fields: List<HeaderField> = []
        mut listed = 0
        while !c.done() {
            match self.represented(c, listed == 0) {
                .Ok(got) -> { listed = listed_with(fields, got, listed, self.list) },
                .Err(why) -> { return .Refused(why) },
            }
        }
        if self.owed { return .Refused(HpackRefusal.Unresized) }
        if listed > self.list { return .TooLarge }
        .Fields(fields)
    }

    /// The representation under the cursor (§6), taken: the field it
    /// names, or absent for a resize — which only an `opening` block,
    /// one with no field yet, may carry.
    mut fn represented(mut c: BlockCursor, opening: bool) -> Represented {
        let b = c.buf.at(c.at)
        if b >= 32 && b < 64 { return self.resize(c, opening) }
        if self.owed { return .Err(HpackRefusal.Unresized) }
        when {
            b >= 128 -> self.indexed(c)
            b >= 64 -> self.literal(c, 6, true, false)
            b >= 16 -> self.literal(c, 4, false, true)
            _ -> self.literal(c, 4, false, false)
        }
    }

    /// An indexed field (§6.1): the entry, whole.
    fn indexed(mut c: BlockCursor) -> Represented {
        let f? = self.dynamic.indexed(c.int(7)?) else { return .Err(HpackRefusal.Index) }
        .Ok(f)
    }

    /// A literal field (§6.2): a name by index or as a string, then a
    /// value; `kept` enters the table, `sensitive` is never indexed.
    /// The name is read BEFORE the insert, which may evict the entry
    /// it came from (§4.4).
    mut fn literal(mut c: BlockCursor, bits: int, kept: bool, sensitive: bool) -> Represented {
        let name = self.name_at(c, c.int(bits)?)?
        let f = HeaderField { name: name, value: c.string()?, sensitive: sensitive }
        if kept { self.dynamic.inserted(f) }
        .Ok(f)
    }

    /// A literal's name: the indexed entry's, or a string when the
    /// index is zero.
    fn name_at(mut c: BlockCursor, i: int) -> Result<Bytes, HpackRefusal> {
        if i == 0 { return c.string() }
        let f? = self.dynamic.indexed(i) else { return .Err(HpackRefusal.Index) }
        .Ok(f.name)
    }

    /// A dynamic table size update (§6.3): at most the advertised
    /// limit, and only before the block's first field.
    mut fn resize(mut c: BlockCursor, opening: bool) -> Represented {
        if !opening { return .Err(HpackRefusal.Placement) }
        let n = c.int(5)?
        if n > self.limit { return .Err(HpackRefusal.TableSize) }
        self.dynamic.resized(n)
        self.owed = false
        .Ok(null)
    }
}

/// The list's cost once `got` joins it — a resize joins as nothing —
/// and `got` pushed while that cost is within `bound`.
fn listed_with(mut fields: List<HeaderField>, got: HeaderField?, listed: int, bound: int) -> int {
    let f? = got else { return listed }
    if listed + cost(f) <= bound { fields.push(f) }
    listed + cost(f)
}

// ── Writing a block ─────────────────────────────────────────────

/// One end's encoding state: the dynamic table; `huffman`, whether a
/// string is Huffman-coded when that is no longer; `cap`, the most
/// table this end will keep whatever the peer allows; `least`, the
/// smallest size since the last block, and `announce`, whether the
/// next block opens by saying so (§4.2).
export type HpackEncoder = { dynamic: HeaderTable, huffman: bool, cap: int, least: int, announce: bool }

/// An encoder at the default table size.
export fn encoder(huffman: bool) -> HpackEncoder {
    HpackEncoder {
        dynamic: dynamic_table(default_table),
        huffman: huffman,
        cap: default_table,
        least: default_table,
        announce: false,
    }
}

impl HpackEncoder {
    /// The peer allows `n` octets of table: the table takes the lesser
    /// of that and `cap` at once, and the next block announces it.
    mut fn resized(n: int) {
        let max = if n < self.cap { n } else { self.cap }
        if max < self.least { self.least = max }
        self.dynamic.resized(max)
        self.announce = true
    }

    /// `fields` as one header block, the table moved as the peer's
    /// decoder will move its own.
    mut fn encoded(fields: List<HeaderField>) -> Bytes {
        mut w = self.announced()
        for f in fields { w = w.concat(self.represented(f)) }
        w
    }

    /// The owed resizes: the least size since the last block, then
    /// the final one when they differ.
    mut fn announced() -> Bytes {
        if !self.announce { return no_bytes }
        self.announce = false
        let least = self.least
        self.least = self.dynamic.max
        if least == self.dynamic.max { return integer(least, 5, 32) }
        integer(least, 5, 32).concat(integer(self.dynamic.max, 5, 32))
    }

    /// One field's representation: its index when an entry is exactly
    /// it, else a literal — never indexed when sensitive, kept unless
    /// it would not fit the table at all.
    mut fn represented(f: HeaderField) -> Bytes {
        let exact = self.exact(f)
        if exact > 0 && !f.sensitive { return integer(exact, 7, 128) }
        let named = self.named(f.name)
        if f.sensitive { return self.literal(f, named, 4, 16) }
        if cost(f) > self.dynamic.max { return self.literal(f, named, 4, 0) }
        let w = self.literal(f, named, 6, 64)
        self.dynamic.inserted(f)
        w
    }

    /// A literal: the name's index on a prefix of `bits` under `flags`
    /// — or zero and the name — then the value.
    fn literal(f: HeaderField, named: int, bits: int, flags: int) -> Bytes {
        let head = integer(named, bits, flags)
        let value = string_literal(f.value, self.huffman)
        if named > 0 { return head.concat(value) }
        head.concat(string_literal(f.name, self.huffman)).concat(value)
    }

    /// The index of an entry that is `f` exactly — or 0.
    fn exact(f: HeaderField) -> int { self.index_where(f.name, it.name == f.name && it.value == f.value) }

    /// The index of an entry named `name` — or 0.
    fn named(name: Bytes) -> int { self.index_where(name, it.name == name) }

    /// The index of the first entry `p` admits whose name is `name`'s
    /// length, static first, the order the RFC's own examples encode in
    /// — or 0. The static table is searched in its bucket of that name
    /// length alone, a handful of entries rather than sixty-one.
    fn index_where(name: Bytes, p: fn(HeaderField) -> bool) -> int {
        let bucket = if name.length < static_by_length.length { static_by_length[name.length] } else { no_indices }
        let s? = bucket.find(p(statics[it])) else { return self.dynamic_index(self.dynamic.entries.find_index(p)) }
        s + 1
    }

    /// Where the entry at list position `p` stands in the index space.
    fn dynamic_index(p: int?) -> int {
        let at? = p else { return 0 }
        statics.length + self.dynamic.entries.length - at
    }
}

/// Every one-octet integer, laid out once: an index is most of what an
/// encoder writes, and each costs a read of this table, not a build.
const single_octets: List<Bytes> = [[i].bytes()! for i in 0..256]

/// `v` on a prefix of `bits` bits, the octet's other bits `flags` (§5.1).
export fn integer(v: int, bits: int, flags: int) -> Bytes {
    let top = (1 << bits) - 1
    if v < top { return single_octets[flags | v] }
    mut out = [flags | top]
    mut rest = v - top
    while rest >= 128 {
        out.push(rest % 128 + 128)
        rest = rest / 128
    }
    out.push(rest)
    out.bytes()!
}

/// A string literal (§5.2): Huffman-coded when `huffman` and that is
/// no longer than the octets, which the RFC's own examples do.
export fn string_literal(s: Bytes, huffman: bool) -> Bytes {
    let coded = huffman_length(s)
    if huffman && coded <= s.length { return integer(coded, 7, 128).concat(huffman_encoded(s)) }
    integer(s.length, 7, 0).concat(s)
}

// ── Huffman (Appendix B) ────────────────────────────────────────

/// One row of Appendix B: a symbol, its code as the RFC spells it in
/// hex, and the code's length in bits. Symbol 256 is EOS.
export type CodeRow = { sym: int, code: string, bits: int }

