//! HPACK — header compression for HTTP/2 (RFC 7541), over `Bytes`.
//!
//! A header block is a run of REPRESENTATIONS: an index into the one
//! index space (the static table, then the dynamic one), a literal that
//! may enter the dynamic table, or a resize of it. Both ends keep the
//! dynamic table in step, so a `HpackDecoder` and an `HpackEncoder` are values a
//! connection holds and every block moves.
//!
//! EVERY QUANTITY A PEER NAMES MEETS A BOUND BEFORE IT IS USED. An
//! integer is bounded before it can overflow, a string before it is
//! sliced, a resize by the size this end advertised, and a block's
//! decoded list by the list bound — an HPACK bomb is a small block that
//! expands, and it meets that bound, never the allocator. A block over
//! the list bound is still decoded whole, so the table stays in step
//! with the peer's and only that stream is refused.
use frame.{hex_value, no_bytes}

/// One header field as octets. `sensitive` is the never-indexed mark
/// (§7.1.3): a decoder reports it, an encoder honours it, and a field
/// wearing it never enters a dynamic table.
export type HeaderField = { name: Bytes, value: Bytes, sensitive: bool = false }

/// A field spelled as text.
export fn header_field(name: string, value: string) -> HeaderField { HeaderField { name: name.bytes(), value: value.bytes() } }

/// What a field costs a table: its name, its value, and 32 (§4.1).
export fn cost(f: HeaderField) -> int { f.name.length + f.value.length + 32 }

/// Why a block was refused — every arm a COMPRESSION_ERROR to HTTP/2,
/// which ends the connection: a decoder that refused a block no longer
/// knows the peer's table.
export enum HpackRefusal {
    /// An index of zero, or past both tables.
    Index
    /// An integer past `int_bound`, or longer than it could need.
    Integer
    /// The block ended inside a representation.
    Truncated
    /// A Huffman string that decodes to the end-of-string symbol.
    Eos
    /// Huffman padding longer than seven bits, or not all ones.
    Padding
    /// A resize past the size this end advertised.
    TableSize
    /// A resize after a field — it may only open a block.
    Placement
    /// A block that did not open with the resize this end asked for.
    Unresized
}

/// The largest integer a representation may carry: an index, a length
/// and a table size all fit in 31 bits.
export const int_bound: int = 2147483647

/// The table size both ends start from (RFC 9113 §6.5.2).
export const default_table: int = 4096

// ── The tables ──────────────────────────────────────────────────

/// The static table (Appendix A): index 1 is the first entry.
const statics: List<HeaderField> = [
    header_field(":authority", ""),
    header_field(":method", "GET"),
    header_field(":method", "POST"),
    header_field(":path", "/"),
    header_field(":path", "/index.html"),
    header_field(":scheme", "http"),
    header_field(":scheme", "https"),
