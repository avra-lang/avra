/// Each symbol's code.
const huff_code: List<int> = [hex_value(r.code.bytes(), 0, r.code.length) for r in huffman_rows]

/// Each symbol's code length in bits.
const huff_len: List<int> = [r.bits for r in huffman_rows]

/// The code as a binary tree, two slots per node: a slot holds its
/// child's node, or `-1 - symbol` at a leaf. Node 0 is the root, which
/// no slot names, so 0 is never a child. The code is complete, so no
/// slot is left 0.
const huff_tree: List<int> = grown_tree()

fn grown_tree() -> List<int> {
    mut kids = [0, 0]
    for sym in 0..257 {
        let n = huff_len[sym]
        mut node = 0
        for k in 0..n - 1 {
            let slot = 2 * node + code_bit(sym, k)
            if kids[slot] == 0 {
                kids[slot] = kids.length / 2
                kids.push(0)
                kids.push(0)
            }
            node = kids[slot]
        }
        kids[2 * node + code_bit(sym, n - 1)] = -1 - sym
    }
    kids
}

/// Bit `k` of a symbol's code, the most significant first.
fn code_bit(sym: int, k: int) -> int { (huff_code[sym] >> huff_len[sym] - 1 - k) & 1 }

const eos: int = 256

/// How many octets `s` takes Huffman-coded.
export fn huffman_length(s: Bytes) -> int {
    mut bits = 0
    for i in 0..s.length { bits = bits + huff_len[s.at(i)] }
    (bits + 7) / 8
}

/// `s` Huffman-coded, the last octet padded with the EOS code's
/// leading ones.
export fn huffman_encoded(s: Bytes) -> Bytes {
    mut out: List<int> = []
    mut acc = 0
    mut bits = 0
    for i in 0..s.length {
        let sym = s.at(i)
        acc = (acc << huff_len[sym]) | huff_code[sym]
        bits = bits + huff_len[sym]
        while bits >= 8 {
            bits = bits - 8
            out.push((acc >> bits) & 255)
        }
        acc = acc & (1 << bits) - 1
    }
    if bits > 0 { out.push(((acc << 8 - bits) | (1 << 8 - bits) - 1) & 255) }
    out.bytes()!
}

/// How many nodes the code's tree has: every one a state of the
/// decoder.
const huff_nodes: int = huff_tree.length / 2

/// The decoder's steps, a nibble at a time: node `state` reading the
/// four bits of nibble `x` is entry `16 * state + x`, packed as the node
/// it lands on plus, shifted by nine, the symbol it completes plus one
/// (0 for none). The shortest code is five bits, so a nibble completes
/// at most one symbol. Built once, at the first decode: its 4096 walks
/// are past a const's step budget.
once fn huff_steps() -> List<int> { [nibble_step(state, x) for state in 0..huff_nodes for x in 0..16] }

fn nibble_step(state: int, x: int) -> int {
    mut node = state
    mut completed = 0
    for k in 0..4 {
        let next = huff_tree[2 * node + ((x >> 3 - k) & 1)]
        if next >= 0 {
            node = next
        } else {
            completed = 0 - next
            node = 0
        }
    }
    node | (completed << 9)
}

/// The states a string may end in: the root, or a node reached from it
/// by at most seven 1-bits — the EOS code's prefix, which is all the
/// padding may be (§5.2).
const huff_endings: List<bool> = ending_states()

fn ending_states() -> List<bool> {
    mut ends = [false for n in 0..huff_nodes]
    mut node = 0
    ends[0] = true
    for depth in 0..7 {
        node = huff_tree[2 * node + 1]
        ends[node] = true
    }
    ends
}

/// A Huffman-coded string's octets (§5.2), a nibble per step. The walk
/// ends between symbols, or inside one on at most seven bits that are
/// all ones — the EOS code's prefix; EOS itself is never a symbol of a
/// string.
export fn huffman_decoded(raw: Bytes) -> Result<Bytes, HpackRefusal> {
    let steps = huff_steps()
    mut out: List<int> = []
    mut state = 0
    for i in 0..raw.length {
        let b = raw.at(i)
        let high = steps[16 * state + (b >> 4)]
        let low = steps[16 * (high & 511) + (b & 15)]
        if high >> 9 == eos + 1 || low >> 9 == eos + 1 { return .Err(HpackRefusal.Eos) }
        if high >> 9 > 0 { out.push((high >> 9) - 1) }
        if low >> 9 > 0 { out.push((low >> 9) - 1) }
        state = low & 511
    }
    if !huff_endings[state] { return .Err(HpackRefusal.Padding) }
    .Ok(out.bytes()!)
}

