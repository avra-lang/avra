//! SERVED ASSETS — bytes a program holds, answered under a prefix by
//! their content-hashed names. A response is IMMUTABLE: the name is the
//! content's, so it carries its `ETag` and a year's `Cache-Control:
//! immutable`, and a request whose `If-None-Match` names the tag is a
//! 304 with no body. A name the list does not hold is a 404 and the
//! disk is never touched — nothing undeclared is ever served. The bodies
//! are the list's own `Bytes`, which for a settled const are the
//! binary's static data: serving copies nothing.
use @std.http_message.message.{Header, Method}
use route.{Route, Reach}
use validators.{tag_listed}
use codings.{coding_weight}

/// One thing to serve: the name it is asked for by, its media type, its
/// octets, the same octets in each content coding made of them (a client
/// that accepts none is sent the octets), whether the name is the
/// content's, and the tag a fixed name is validated by.
export type Hosted = {
    name: string,
    media: string,
    octets: Bytes,
    coded: List<Coded> = [],
    kept: bool = true,
    tag: string = "",
}

/// An asset's octets in one content coding, by its HTTP name (`br`, `gzip`).
export type Coded = { coding: string, octets: Bytes }

/// The routes answering `held` under `prefix` (`/assets`): a GET and a
/// HEAD of each name in it.
export fn assets(prefix: string, held: List<Hosted>) -> List<Route> {
    let base = if prefix.ends_with("/") { prefix.substring(0, prefix.length - 1) } else { prefix }
    [asset_route(Method.Get, base, held), asset_route(Method.Head, base, held)]
}

fn asset_route(method: Method, base: string, held: List<Hosted>) -> Route {
    let under = base.bytes()
    Route {
        method: method,
        pattern: "${base}/{path...}",
        reach: Reach.Rest,
        serve: (q: Request<Unrouted>, t: Bytes) -> if falls_under(t, under) { answer(q, held, below(t, under.length)) } else { null },
        reads: (t: Bytes) -> falls_under(t, under),
    }
}

/// The path past the prefix and its separator.
fn below(t: Bytes, n: int) -> Bytes {
    if t.length <= n + 1 { "".bytes() } else { t.slice(n + 1, t.length) }
}

/// The response for the name `rel` asks, exactly as the list spells it.
fn answer(q: Request<Unrouted>, held: List<Hosted>, rel: Bytes) -> Response {
    let name? = rel.text() else { return status(404) }
    let found? = held.find(it.name == name) else { return status(404) }
    asset_answer(q, found)
}

/// `h` answered to `q`: in the coding `q` weighs highest of those `h` was
/// coded in, or as it is. Each coding is its own representation, so its
/// tag names the coding too.
export fn asset_answer(q: Request<Unrouted>, h: Hosted) -> Response {
    let weighed = [coding_weight(q.headers("accept-encoding"), c.coding) for c in h.coded]
    let chosen = [h.coded[j] for j, w in weighed if w > 0 && weighed.all(it <= w)].first()
    let tag = tag_of(h, chosen)
    let fields = [
        header_pair("content-type", h.media),
        header_pair("etag", tag),
        header_pair(
            "cache-control",
            if h.kept { "public, max-age=31536000, immutable" } else { "no-cache" },
        ),
        header_pair("x-content-type-options", "nosniff"),
    ]
        .concat(if h.coded.is_empty() { [] } else { [header_pair("vary", "accept-encoding")] })
        .concat(
            match chosen {
                c? -> [header_pair("content-encoding", c.coding)]
                null -> []
            },
        )
    if tag_listed(q.header("if-none-match"), tag) { return Response { status: 304, headers: fields } }
    Response { headers: fields, body: chosen?.octets ?? h.octets }
}

/// The strong tag of `h` in the representation `coding` names: its name
/// when the name is the content's, else the tag it was given.
fn tag_of(h: Hosted, coding: Coded?) -> string {
    let named = if h.kept || h.tag == "" { h.name } else { h.tag }
    match coding {
        c? -> "\"${named}.${c.coding}\""
        null -> "\"${named}\""
    }
}
