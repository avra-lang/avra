//! COOKIES — read from a request, set on a response, signed.
//!
//! A `Set-Cookie` IS A GRAMMAR THE BROWSER PARSES, so a value is two
//! things at once unless its characters are held to RFC 6265's
//! cookie-octets: a `;` in a value would start an attribute of the
//! caller's choosing (`x; Domain=evil`). Every name, value and
//! attribute is judged before a line is written, and a cookie that
//! fails is a `CookieFault`, never a quietly escaped line.
//!
//! THE DEFAULTS ARE THE SAFE ONES: `Secure`, `HttpOnly`,
//! `SameSite=Lax`, `Path=/`. A cookie loosens them by saying so.
//!
//! Signed cookies and sessions are `@std/http_session`'s, so a plain
//! server links no MAC.
use @std.errors.{Error, ErrorInfo, info}
use frame.{is_tchar}

/// One cookie a request carried.
export type Cookie = { name: string, value: string }

impl Request {
    /// Every cookie the request carried, across every `cookie` field,
    /// in the order sent. A pair with no `=` or an empty name is
    /// skipped; a value's surrounding quotes are dropped.
    fn cookies() -> List<Cookie> {
        [c for line in self.headers("cookie") for c in pairs_of(line)]
    }

    /// The first cookie of this name — the most specific, since a
    /// browser sends the longest path first.
    fn cookie(name: string) -> string? {
        self.cookies().find(it.name == name)?.value
    }
}

fn pairs_of(line: string) -> List<Cookie> {
    [c! for c in [cookie_pair(p) for p in line.split(";")] if c != null]
}

/// One `name=value`, trimmed, or null when it names nothing.
fn cookie_pair(piece: string) -> Cookie? {
    let at = piece.index_of("=")
    if at < 0 { return null }
    let name = piece.substring(0, at).trim()
    if name.is_empty() { return null }
    Cookie { name: name, value: unquoted(piece.substring(at + 1, piece.length).trim()) }
}

fn unquoted(v: string) -> string {
    if v.length >= 2 && v.starts_with("\"") && v.ends_with("\"") { v.substring(1, v.length - 1) } else { v }
}

// ── Setting ─────────────────────────────────────────────────────

/// Where a browser sends a cookie from another site's page.
export enum SameSite {
    Strict
    Lax
    None
}

/// A cookie to set, and its attributes. `max_age` in seconds: `0`
/// removes it, absent makes it last the session.
export type SetCookie = {
    name: string,
    value: string,
    path: string? = "/",
    domain: string? = null,
    max_age: int? = null,
    secure: bool = true,
    http_only: bool = true,
    same_site: SameSite = SameSite.Lax,
}

/// The cookie that removes `name` — at the path it was set on.
export fn removed(name: string) -> SetCookie {
    SetCookie { name: name, value: "", max_age: 0 }
}

/// Why a cookie cannot be written.
export enum CookieFault {
    Name(name: string)
    Value(name: string)
    Attribute(name: string, which: string)
    NoneInsecure(name: string)
    Prefix(name: string)
}

impl Error for CookieFault {
    fn describe() -> ErrorInfo {
        match self {
            .Name(n) -> info("cookie.name", "the cookie name `${n}` is not a token"),
            .Value(n) -> info("cookie.value", "cookie `${n}`'s value holds a character a cookie cannot carry"),
            .Attribute(n, which) -> info("cookie.attribute", "cookie `${n}`'s ${which} holds `;` or a control character"),
            .NoneInsecure(n) -> info(
                "cookie.none_insecure",
                "cookie `${n}` is `SameSite=None` without `Secure`, which browsers refuse",
            ),
            .Prefix(n) -> info(
                "cookie.prefix",
                "cookie `${n}` breaks its prefix's rule — `__Secure-` wants `Secure`, `__Host-` also `Path=/` and no `Domain`",
            ),
        }
    }
}

impl SetCookie {
    /// The `set-cookie` field that sets this cookie, or why none can.
    fn header() -> Result<Header, CookieFault> {
        if self.name.is_empty() || !every_octet(self.name, token_char) { fail CookieFault.Name(self.name) }
        if !every_octet(self.value, cookie_octet) { fail CookieFault.Value(self.name) }
        if !attribute_safe(self.path) { fail CookieFault.Attribute(self.name, "Path") }
        if !attribute_safe(self.domain) { fail CookieFault.Attribute(self.name, "Domain") }
        if self.same_site is .None && !self.secure { fail CookieFault.NoneInsecure(self.name) }
        if !self.prefix_kept() { fail CookieFault.Prefix(self.name) }
        Header { name: "set-cookie", value: self.line() }
    }

    /// `__Secure-` and `__Host-`, the two prefixes a browser enforces.
    fn prefix_kept() -> bool {
        if self.name.starts_with("__Host-") { return self.secure && self.path == "/" && self.domain == null }
        if self.name.starts_with("__Secure-") { return self.secure }
        true
    }

    fn line() -> string {
        [
            "${self.name}=${self.value}",
            attribute("Path", self.path),
            attribute("Domain", self.domain),
            attribute("Max-Age", age_text(self.max_age)),
            flag("Secure", self.secure),
            flag("HttpOnly", self.http_only),
            "; SameSite=${same_site_word(self.same_site)}",
        ]
            .join("")
    }
}

fn attribute(word: string, v: string?) -> string {
    let s? = v else { return "" }
    "; ${word}=${s}"
}

fn age_text(n: int?) -> string? {
    let s? = n else { return null }
    if s < 0 { "0" } else { "${s}" }
}

fn flag(word: string, on: bool) -> string { if on { "; ${word}" } else { "" } }

fn same_site_word(s: SameSite) -> string {
    match s { .Strict -> "Strict", .Lax -> "Lax", .None -> "None" }
}

fn attribute_safe(v: string?) -> bool {
    let s? = v else { return true }
    every_octet(s, attribute_octet)
}

/// RFC 6265's cookie-octet: visible ASCII but for DQUOTE, `,`, `;`
/// and `\`.
const cookie_octet: Bytes = admits(
    (c) -> c > 32 && c < 127 && c != 34 && c != 44 && c != 59 && c != 92,
)

/// An attribute value: visible ASCII or a space, but never `;`.
const attribute_octet: Bytes = admits((c) -> c >= 32 && c < 127 && c != 59)

impl Response {
    /// This response setting `c` too, or why it cannot.
    fn with_cookie(c: SetCookie) -> Result<Response, CookieFault> {
        self with { headers: self.headers.concat([c.header()?]) }
    }
}
