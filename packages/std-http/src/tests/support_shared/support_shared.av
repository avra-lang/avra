// A program test reads the package's shared test helpers the way a
// suite does: `use tests.support.{…}`.
use tests.support.{dateless, undated}

let wire = "HTTP/1.1 200 OK\r\ndate: Wed, 30 Sep 2026 12:00:00 GMT\r\ncontent-length: 0\r\n\r\n"
println(dateless(wire).replace("\r\n", "/"))
println(undated(wire).replace("\r\n", "/"))
