use tests.support.{dateless, undated}

spec "tests/support — the helpers every std-http test shares" {
    given "a response carrying a date line" {
        then "dateless drops the line whole" {
            dateless("HTTP/1.1 200 OK\r\ndate: Wed, 30 Sep 2026 12:00:00 GMT\r\n\r\n") == "HTTP/1.1 200 OK\r\n\r\n"
        }
        then "undated masks each value as <now>" {
            undated("date: Wed, 30 Sep 2026 12:00:00 GMT|date: Thu, 01 Oct 2026 00:00:00 GMT") == "date: <now>|date: <now>"
        }
    }
    given "a response with no date line" {
        then "both answer it unchanged" {
            dateless("HTTP/1.1 204 No Content\r\n\r\n") == "HTTP/1.1 204 No Content\r\n\r\n" &&
                undated("x") == "x"
        }
    }
}
