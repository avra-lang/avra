// proves: the most specific route answers wherever it is written or embedded — a literal beats a hole of a narrow type, which beats a hole of any text, which beats the rest — so `users` and `tasks/{id}` resolve alike in either embedding order
use @std.net.{Conn, NetError, connect, timely}
use @std.time.{ms, secs}
use @std.http.http.{text}
use @std.http.route.{get, post, group, router}
use @std.http.server.{server}
use tests.support.{up}

export router tasks {
    get "/{id}" { req -> "task " + req.params.id }
}

export router users {
    get "/users" { _req -> "users" }
}

/// `tasks` is listed first, its `/{id}` written above `/users`.
export server tasks_first {
    port: 0
    tasks
    users
}

/// `users` is listed first.
export server users_first {
    port: 0
    users
    tasks
}

/// The rest written first, then a hole, then a literal: the order the least specific would win by.
export server widest_first {
    port: 0
    get "/{path...}" { req -> "rest " + req.params.path }
    get "/a/{id}" { req -> "hole " + req.params.id }
    get "/a/b" { _req -> "literal" }
}

/// A text hole written above the narrow hole that outranks it, and a
/// literal above both.
export server ranked {
    port: 0
    get "/b/{slug}" { req -> "text " + req.params.slug }
    get "/b/{n: int}" { req -> "narrow ${req.params.n}" }
    get "/b/lit" { _req -> "literal" }
}

/// `sent` written, then read until the server closes or goes quiet.
fn exchanged(c: Conn, sent: string) -> Result<string, NetError> {
    c.write(sent.bytes())?
    mut got = "".bytes()
    while true {
        match timely(within ms(300) { c.read(65536) }) {
            .Ok(b) -> {
                let more? = b else { break }
                got = got.concat(more)
            },
            .Err(_) -> { break },
        }
    }
    let parts = (got.text() ?? "?").split("\r\n\r\n")
    let body = if parts.length > 1 { parts[1] } else { "" }
    .Ok("${parts[0].split("\r\n").first() ?? "?"} ${body}")
}

fn asked(port: int, line: string) -> Result<string, NetError> {
    let c = connect("127.0.0.1", port, secs(2))?
    defer { let _ = c.close() }
    exchanged(c, line + "\r\nHost: a\r\nConnection: close\r\nContent-Length: 4\r\n\r\nnote")
}

/// What `s` answers for each of `targets`, in the order asked.
fn answers(s: server, targets: List<string>) -> Result<string, NetError> {
    let running = up(s)?
    spawn running.run(1)
    defer running.stop()
    .Ok([asked(running.listener.port, "GET ${t} HTTP/1.1")? for t in targets].join("|"))
}

fn shown() -> Result<string, NetError> {
    let shared = ["/users", "/7", "/a/b", "/a/c", "/z/q/r"]
    .Ok(
        [
            answers(tasks_first, shared)?,
            answers(users_first, shared)?,
            answers(widest_first, shared)?,
            answers(ranked, ["/b/7", "/b/abc", "/b/lit"])?,
        ]
            .join("\n"),
    )
}

match shown() { .Ok(t) -> t, .Err(e) -> "failed: ${e.describe().message}" }

