//! proves: a server whose serving task is cancelled leaves no
//! connection behind — an open one is closed, so its client reads the
//! end, and none is counted
use @std.net.{Conn, NetError, connect, listen}
use @std.time.{ms, secs, sleep}
use @std.http.frame.{limits}
use @std.http.http.{text}
use @std.http.server.{Server, served, timing}

type Quiet = {}

/// Whether the peer ends within two seconds: everything it wrote read, then the end. Each read
/// waits on the socket, since a close reaches its peer in the kernel's time, not the clock's.
fn ended(c: Conn) -> Result<bool, NetError> {
    match within secs(2) { drained(c) } { .Ok(r) -> r, .Err(_) -> .Ok(false) }
}

/// Whether `c` reads to its end, each read parked until the peer writes or finishes.
fn drained(c: Conn) -> Result<bool, NetError> {
    if c.read(65536)? == null { return .Ok(true) }
    drained(c)
}

fn serves(s: Server<Quiet>) -> bool { s.run(cores: 1) is .Ok }

fn run() -> Result<string, NetError> {
    let l = listen("127.0.0.1", 0)?
    let s = served(l, () -> Quiet {}, limits(), timing()) { _a, q -> text(200, "ok") }
    let t = spawn serves(s)
    let c = connect("127.0.0.1", l.port, secs(2))?
    c.write("GET / HT".bytes())?
    sleep(ms(50))
    let open = s.connections()
    t.cancel()
    sleep(ms(50))
    let gone = ended(c)?
    c.close()?
    s.stop()
    .Ok("${open} ${s.connections()} ${gone}")
}

run() catch e -> "failed: ${e.verb} ${e.subject} ${e.errno}"
