// THE TARGET'S FOUR FORMS, AND THE ONE RESOURCE BEHIND TWO OF THEM.
// The framer ADMITS absolute-form because RFC 9112 §3.3 says a server
// MUST, and `path()` then answered the WHOLE URI — so `/p` routed 200
// and `http://h/p` routed 404 for one resource. THE 404 IS NOT THE
// HAZARD: a front end that normalises one form into the other and an
// Avra origin behind it disagree about WHICH ROUTE ANSWERS, and a
// filter on `/admin` in front of a server that reads `http://h/admin`
// as a different path is the whole shape of a routing bypass.
//
// EVERY CASE HERE GOES THROUGH THE REAL FRAMER AND THE REAL ROUTER.
// A test that asked `path()` alone would prove the reader and not the
// property, and the property is that ONE HANDLER answers both.
use @std.http.frame.{Method}
use @std.http.http.{Request, Unrouted, Response, text}
use @std.http.route.{Route, fixed, tailed}

fn tf_serve_admin(_q: Request<Unrouted>) -> Response { text(200, "admin") }
fn tf_serve_root(_q: Request<Unrouted>) -> Response { text(200, "root") }

fn tf_serve_static(q: Request<TfStatic>) -> Response { text(200, "static ${q.params.path}") }

grammar TfStatic = "/static/{path...}"

fn tf_routes() -> List<Route> {
    [
        fixed(Method.Get, "/admin", tf_serve_admin),
        fixed(Method.Get, "/", tf_serve_root),
        tailed<TfStatic>(
            Method.Get,
            "/static/{path...}",
            (t: Bytes) -> TfStatic.parse(t),
            tf_serve_static,
        ),
    ]
}

/// The status and body a request line earns FROM THE ROUTER, or
/// "unframed" when the framer refused the line first.
fn tf_answered(line: string) -> string { answer_of(tf_routes(), line) }

/// What one reader answers for a request line, with "unframed" when
/// the framer refused the line first — the guard the three readers
/// below share.
fn tf_read(line: string, pick: fn(Request<Unrouted>) -> string) -> string {
    let q? = asked(line) else { return "unframed" }
    pick(q)
}

/// What `path()` reads, with absence spelled — the router's input.
fn tf_path(line: string) -> string { tf_read(line, (q: Request<Unrouted>) -> q.path()?.text() ?? "<none>") }

/// What `authority()` reads, with absence spelled.
fn tf_authority(line: string) -> string { tf_read(line, (q: Request<Unrouted>) -> q.authority() ?? "<none>") }

/// The whole target as sent — unchanged by any of this.
fn tf_target(line: string) -> string { tf_read(line, (q: Request<Unrouted>) -> q.target() ?? "<not text>") }

spec "@std.http target forms" {
    given "one resource, two forms, one handler" {
        then "origin-form and absolute-form reach the SAME route" {
            tf_answered("GET /admin HTTP/1.1") == "200 admin" &&
                tf_answered("GET http://h/admin HTTP/1.1") == "200 admin"
        }
        then "the differential is gone — the two agree on the body, not only the status" {
            tf_answered("GET /admin HTTP/1.1") == tf_answered("GET http://h/admin HTTP/1.1")
        }
        then "the router is scheme-blind; the server judges https against its connection (scheme_test)" {
            tf_answered("GET https://h/admin HTTP/1.1") == "200 admin" &&
                tf_answered("GET zz://h/admin HTTP/1.1") == "200 admin"
        }
        then "a port in the authority is stripped with it" {
            tf_answered("GET http://h:8080/admin HTTP/1.1") == "200 admin"
        }
        then "userinfo is part of the authority and never of the path" {
            tf_answered("GET http://u:p@h/admin HTTP/1.1") == "200 admin"
        }
        then "a REST route reaches through absolute-form too" {
            tf_answered("GET /static/css/app.css HTTP/1.1") == "200 static css/app.css" &&
                tf_answered("GET http://h/static/css/app.css HTTP/1.1") == "200 static css/app.css"
        }
        then "a query rides behind the path in either form" {
            tf_answered("GET /admin?x=1 HTTP/1.1") == "200 admin" &&
                tf_answered("GET http://h/admin?x=1 HTTP/1.1") == "200 admin"
        }
    }
    given "the path component of each form" {

        then "origin-form IS its path" {
            tf_path("GET /admin HTTP/1.1") == "/admin"
        }
        then "absolute-form loses its scheme and authority" {
            tf_path("GET http://h/admin HTTP/1.1") == "/admin"
        }
        then "and keeps everything after the authority's first `/`" {
            tf_path("GET http://h/a/b/c HTTP/1.1") == "/a/b/c"
        }
        then "a `://` INSIDE the path is not a second authority" {
            tf_path("GET http://h/a://b HTTP/1.1") == "/a://b"
        }
        then "the query is cut in both forms, as it always was" {
            tf_path("GET /admin?x=/evil HTTP/1.1") == "/admin" &&
                tf_path("GET http://h/admin?x=/evil HTTP/1.1") == "/admin"
        }
        then "AN EMPTY PATH IS `/` — the root has a spelling with no slash in it" {
            tf_path("GET http://h HTTP/1.1") == "/" && tf_path("GET http://h?x=1 HTTP/1.1") == "/"
        }
        then "and it routes to the root, which is the whole reason it is minted" {
            tf_answered("GET http://h HTTP/1.1") == "200 root" &&
                tf_answered("GET / HTTP/1.1") == "200 root"
        }
        then "A QUERY THAT LOOKS LIKE A PATH IS STILL A QUERY" {
            // the authority ends where the PATH CLASS does, so the `/`
            // inside `?x=/admin` is past the split and neither becomes
            // the path nor extends the authority — the same law that
            // keeps `?redirect=/home` from adding a segment, reached
            // from the other side of the authority
            tf_path("GET http://h?x=/admin HTTP/1.1") == "/" &&
                tf_authority("GET http://h?x=/admin HTTP/1.1") == "h" &&
                tf_answered("GET http://h?x=/admin HTTP/1.1") == "200 root"
        }
        then "a trailing slash after the authority IS the root path" {
            tf_path("GET http://h/ HTTP/1.1") == "/" &&
                tf_answered("GET http://h/ HTTP/1.1") == "200 root"
        }
        then "an EMPTY authority names no host, and the target is refused (RFC 9110 §4.2.1)" {
            tf_answered("GET http:///admin HTTP/1.1") == "unframed"
        }
        then "a target that OPENS with `://` names no scheme and is refused" {
            tf_answered("GET ://h/admin HTTP/1.1") == "unframed"
        }
        then "asterisk-form has no path — it names the server, not a resource" {
            tf_path("OPTIONS * HTTP/1.1") == "<none>"
        }
        then "authority-form has none either — CONNECT names a tunnel" {
            tf_path("CONNECT h:443 HTTP/1.1") == "<none>"
        }
    }
    given "the authority, which `path()` strips" {

        then "absolute-form hands it over" {
            tf_authority("GET http://h/admin HTTP/1.1") == "h"
        }
        then "with its port" {
            tf_authority("GET http://h:8080/admin HTTP/1.1") == "h:8080"
        }
        then "and with no path after it" {
            tf_authority("GET http://h HTTP/1.1") == "h" &&
                tf_authority("GET http://h?x=1 HTTP/1.1") == "h"
        }
        then "origin-form carries none — the `Host` field is where it lives" {
            tf_authority("GET /admin HTTP/1.1") == "<none>"
        }
        then "nor do the two forms that name no resource" {
            tf_authority("OPTIONS * HTTP/1.1") == "<none>" &&
                tf_authority("CONNECT h:443 HTTP/1.1") == "<none>"
        }
    }
    given "a target that names no resource is not routed" {

        then "asterisk-form earns a 404 — the table is never walked" {
            tf_answered("OPTIONS * HTTP/1.1") == "404 "
        }
        then "authority-form earns the same" {
            tf_answered("CONNECT h:443 HTTP/1.1") == "404 "
        }
        then "and the framer's own laws still hold in front of all this" {
            // `*` is OPTIONS' alone and an authority is CONNECT's; a
            // path at a CONNECT is refused before the router exists
            tf_answered("GET * HTTP/1.1") == "unframed" &&
                tf_answered("GET h:443 HTTP/1.1") == "unframed" &&
                tf_answered("CONNECT /admin HTTP/1.1") == "unframed"
        }
    }
    given "what none of this moved" {

        then "`target()` still answers the form that was SENT" {
            tf_target("GET http://h/admin?x=1 HTTP/1.1") == "http://h/admin?x=1" &&
                tf_target("OPTIONS * HTTP/1.1") == "*" &&
                tf_target("CONNECT h:443 HTTP/1.1") == "h:443"
        }
        then "a fragment never travels, in either form" {
            tf_answered("GET /admin#top HTTP/1.1") == "unframed" &&
                tf_answered("GET http://h/admin#top HTTP/1.1") == "unframed"
        }
        then "a protocol-relative target is origin-form and keeps both slashes" {
            tf_path("GET //h/admin HTTP/1.1") == "//h/admin"
        }
    }
}
