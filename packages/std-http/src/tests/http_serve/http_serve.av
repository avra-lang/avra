use @std.net.{Conn, Poller, Read, NetError, listen, connect, poller}
use @std.time.{ms, secs}
use @std.http.frame.{limits}
use @std.http.http.{Request, Response, text}
use @std.http.server.{Server, served, timing}

type App = { hits: int }

fn echo(mut app: App, q: Request) -> Response {
    app.hits = app.hits + 1
    text(200, "${q.target() ?? "?"}|${q.body.text() ?? "?"}|${app.hits}")
}

type Pair = { s: Server<App>, c: Conn, p: Poller }

fn exchanged(mut pr: Pair, sent: string, expected: int) -> Result<string, NetError> {
    let out = sent.bytes()
    mut from = 0
    while from < out.length { from = from + pr.c.write(out, from)? }
    mut got = "".bytes()
    mut turns = 0
    while got.length < expected && turns < 40 {
        pr.s.turn(ms(20))?
        pr.p.wait(ms(20))?
        let chunk: Bytes? = match pr.c.read(65536)? {
            .Data(b) -> b,
            .Eof -> null,
            .Pending -> null,
        }
        got = got.concat(chunk ?? "".bytes())
        turns = turns + 1
    }
    .Ok((got.text() ?? "?").replace("\r\n", "/"))
}

fn shown() -> Result<string, NetError> {
    let l = listen("127.0.0.1", 0)?
    let s = served(l, App { hits: 0 }, echo, limits(), timing())?
    let c = connect("127.0.0.1", l.port, secs(2))?
    let p = poller()?
    p.watch(c.fd, .Read)?
    mut pr = Pair { s: s, c: c, p: p }
    let one = exchanged(pr, "GET /one HTTP/1.1\r\nHost: a\r\n\r\n", 1)?
    let two = exchanged(pr, "GET /a HTTP/1.1\r\nHost: a\r\n\r\nGET /b HTTP/1.1\r\nHost: a\r\n\r\n", 150)?
    let three = exchanged(pr, "POST /p HTTP/1.1\r\nHost: a\r\nContent-Length: 5\r\n\r\nhello", 1)?
    let four = exchanged(pr, "HEAD /h HTTP/1.1\r\nHost: a\r\n\r\n", 1)?
    .Ok("${one}\n${two}\n${three}\n${four}\n${pr.s.connections()} ${pr.s.app.hits}")
}

match shown() {
    .Ok(t) -> t,
    .Err(e) -> "failed: ${e.describe().message}",
}
