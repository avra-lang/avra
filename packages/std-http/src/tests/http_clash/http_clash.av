// proves: two routes of equal specificity that match the same targets are refused when the server starts, naming both
use @std.errors.{Error}
use @std.http.route.{get}
use @std.http.server.{server}

export server app {
    port: 0
    get "/ideas/{id}" { req -> "by id " + req.params.id }
    get "/ideas/{slug}" { req -> "by slug " + req.params.slug }
}

match app.listening() { .Ok(_) -> "started", .Err(e) -> e.describe().message }
