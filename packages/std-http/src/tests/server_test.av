//! The server loop, turned by hand on one thread: a client on the
//! loopback writes a request, the server turns until the response has
//! landed, and the client reads it. Every exchange is exact bytes.
use @std.net.{Conn, Poller, NetError, listen, connect, poller}
use @std.time.{ms, secs}
use @std.http.frame.{limits, Limits, Method}
use @std.http.http.{Request, Response, text}
use @std.http.route.{Table, routed, compiled, dispatch}
use @std.http.server.{Server, Timing, served, timing}

grammar Note = "/notes/{id}"

fn serve_note(q: Request, n: Note) -> Response {
    text(200, "note ${n.id} redirect:${q.query().has("redirect")}")
}

once fn notes_table() -> Table {
    compiled([routed<Note>(Method.Get, "/notes/{id}", (t: Bytes) -> Note.parse(t), serve_note)])
}

/// A handler that is the router: the loop hands it the request, the
/// table answers.
fn routed_app(mut app: App, q: Request) -> Response {
    app.hits = app.hits + 1
    dispatch(notes_table(), q)
}

/// The application: a counter the handler bumps, so a test can see
/// that state threads through the loop as a value.
type App = { hits: int }

fn echo(mut app: App, q: Request) -> Response {
    app.hits = app.hits + 1
    text(200, "${q.head.method is .Get} ${q.target() ?? "?"} ${q.body.text() ?? "?"} ${app.hits}")
}

/// A server on a kernel-chosen loopback port with a client attached.
type Pair = { s: Server<App>, c: Conn, p: Poller }

/// A server running `handle` under `lim` and `t`, with a client
/// attached — THE ONE PAIR BUILDER. A suite that spells its own is
/// testing its own scaffolding beside the loop.
fn paired(handle: fn(mut App, Request) -> Response, lim: Limits, t: Timing) -> Result<Pair, NetError> {
    let l = listen("127.0.0.1", 0)?
    let s = served(l, App { hits: 0 }, lim, t, handle)?
    let c = connect("127.0.0.1", l.port, secs(2))?
    let p = poller()?
    p.watch(c.fd, .Read)?
    .Ok(Pair { s: s, c: c, p: p })
}

fn pair(t: Timing) -> Result<Pair, NetError> { paired(echo, limits(), t) }

/// The client's bytes written whole — the server turned whenever the
/// socket takes none, so a write larger than the buffer cannot spin —
/// then the server turned and the client read until `expected` bytes
/// have arrived or the peer ends. Every read is one turn of the
/// server, so the exchange is deterministic.
fn exchanged_bytes(mut pr: Pair, sent: Bytes, expected: int) -> Result<Bytes, NetError> {
    mut from = 0
    while from < sent.length {
        let n = pr.c.write(sent, from)?
        if n == 0 { pr.s.turn(ms(20))? }
        from = from + n
    }
    mut got = "".bytes()
    mut turns = 0
    while got.length < expected && turns < 60 {
        pr.s.turn(ms(20))?
        pr.p.wait(ms(20))?
        let chunk: Bytes? = match pr.c.read(65536)? {
            .Data(b) -> b,
            .Eof -> { return .Ok(got) },
            .Pending -> null,
        }
        got = got.concat(chunk ?? "".bytes())
        turns = turns + 1
    }
    .Ok(got)
}

fn exchanged(mut pr: Pair, sent: string, expected: int) -> Result<Bytes, NetError> {
    exchanged_bytes(pr, sent.bytes(), expected)
}

fn reply(mut pr: Pair, sent: string) -> Result<string, NetError> {
    let got = exchanged(pr, sent, 1)?
    .Ok(got.text() ?? "<not text>")
}

fn get_root() -> Result<bool, NetError> {
    mut pr = pair(timing())?
    let r = reply(pr, "GET /x HTTP/1.1\r\nHost: a\r\n\r\n")?
    .Ok(r == "HTTP/1.1 200 OK\r\ncontent-type: text/plain; charset=utf-8\r\ncontent-length: 10\r\n\r\ntrue /x  1")
}

fn keep_alive_twice() -> Result<bool, NetError> {
    mut pr = pair(timing())?
    let first = reply(pr, "GET /a HTTP/1.1\r\nHost: a\r\n\r\n")?
    let second = reply(pr, "GET /b HTTP/1.1\r\nHost: a\r\n\r\n")?
    .Ok(first.ends_with("true /a  1") && second.ends_with("true /b  2") && pr.s.connections() == 1)
}

fn pipelined() -> Result<bool, NetError> {
    mut pr = pair(timing())?
    let both = exchanged(pr, "GET /a HTTP/1.1\r\nHost: a\r\n\r\nGET /b HTTP/1.1\r\nHost: a\r\n\r\n", 200)?
    let t = both.text() ?? ""
    .Ok(t.index_of("true /a  1") < t.index_of("true /b  2") && t.index_of("true /b  2") > 0)
}

fn posted() -> Result<bool, NetError> {
    mut pr = pair(timing())?
    let r = reply(pr, "POST /p HTTP/1.1\r\nHost: a\r\nContent-Length: 5\r\n\r\nhello")?
    .Ok(r.ends_with("false /p hello 1"))
}

fn body_in_two_reads() -> Result<bool, NetError> {
    mut pr = pair(timing())?
    let partial = exchanged(pr, "POST /p HTTP/1.1\r\nHost: a\r\nContent-Length: 5\r\n\r\nhel", 1)?
    let rest = reply(pr, "lo")?
    .Ok(partial.length == 0 && rest.ends_with("false /p hello 1"))
}

fn chunked_body() -> Result<bool, NetError> {
    mut pr = pair(timing())?
    let r = reply(pr, "POST /c HTTP/1.1\r\nHost: a\r\nTransfer-Encoding: chunked\r\n\r\n3\r\nhel\r\n2\r\nlo\r\n0\r\n\r\n")?
    .Ok(r.ends_with("false /c hello 1"))
}

fn refused_then_closed() -> Result<bool, NetError> {
    mut pr = pair(timing())?
    let got = exchanged(pr, "GET  /x HTTP/1.1\r\nHost: a\r\n\r\n", 1000)?
    let t = got.text() ?? ""
    .Ok(t.starts_with("HTTP/1.1 400 Bad Request\r\n") && t.contains("connection: close\r\n") && pr.s.connections() == 0)
}

fn head_carries_no_body() -> Result<bool, NetError> {
    mut pr = pair(timing())?
    let r = reply(pr, "HEAD /h HTTP/1.1\r\nHost: a\r\n\r\n")?
    .Ok(r.ends_with("content-length: 11\r\n\r\n"))
}

fn expect_continue() -> Result<bool, NetError> {
    mut pr = pair(timing())?
    let first = reply(pr, "POST /e HTTP/1.1\r\nHost: a\r\nContent-Length: 2\r\nExpect: 100-continue\r\n\r\n")?
    let second = reply(pr, "ok")?
    .Ok(first == "HTTP/1.1 100 Continue\r\n\r\n" && second.ends_with("false /e ok 1"))
}

fn closes_when_asked() -> Result<bool, NetError> {
    mut pr = pair(timing())?
    let got = exchanged(pr, "GET /x HTTP/1.1\r\nHost: a\r\nConnection: close\r\n\r\n", 1000)?
    let t = got.text() ?? ""
    .Ok(t.contains("connection: close\r\n") && pr.s.connections() == 0)
}

fn idle_is_dropped() -> Result<bool, NetError> {
    mut pr = pair(Timing { idle: ms(20) })?
    let _ = reply(pr, "GET /x HTTP/1.1\r\nHost: a\r\n\r\n")?
    let before = pr.s.connections()
    let _ = exchanged(pr, "", 1)?
    .Ok(before == 1 && pr.s.connections() == 0)
}

fn peer_ends_first() -> Result<bool, NetError> {
    mut pr = pair(timing())?
    let _ = pr.c.write("GET /x HTTP/1.1\r\nHost: a\r\n\r\n".bytes(), 0)?
    let _ = pr.c.shutdown_write()?
    let got = exchanged(pr, "", 1000)?
    .Ok((got.text() ?? "").ends_with("true /x  1") && pr.s.connections() == 0)
}

fn old_client_keeps_alive() -> Result<bool, NetError> {
    mut pr = pair(timing())?
    let r = reply(pr, "GET /k HTTP/1.0\r\nHost: a\r\nConnection: keep-alive\r\n\r\n")?
    .Ok(r.contains("connection: keep-alive\r\n") && pr.s.connections() == 1)
}

fn old_client_is_closed() -> Result<bool, NetError> {
    mut pr = pair(timing())?
    let got = exchanged(pr, "GET /c HTTP/1.0\r\nHost: a\r\n\r\n", 1000)?
    .Ok((got.text() ?? "").contains("connection: close\r\n") && pr.s.connections() == 0)
}

/// The loop under the router: a target with a query holding a `/`
/// still finds its route, and the query is read beside the path.
fn routed_through_the_loop() -> Result<bool, NetError> {
    mut pr = paired(routed_app, limits(), timing())?
    let found = reply(pr, "GET /notes/7?redirect=/home HTTP/1.1\r\nHost: a\r\n\r\n")?
    let missing = reply(pr, "GET /nope HTTP/1.1\r\nHost: a\r\n\r\n")?
    .Ok(found.ends_with("note 7 redirect:true") && missing.starts_with("HTTP/1.1 404 Not Found"))
}

/// A verdict's bool, or false when the exchange itself failed.
fn passes<E>(r: Result<bool, E>) -> bool {
    match r {
        .Ok(b) -> b,
        .Err(_) -> false,
    }
}

spec "std.http server" {
    given "one request" {
        then "a GET is answered exactly, and the handler saw its state" { passes(get_root()) }
        then "a POST's body arrives whole" { passes(posted()) }
        then "a body split across reads is gathered before the handler runs" { passes(body_in_two_reads()) }
        then "a chunked body is decoded before the handler runs" { passes(chunked_body()) }
        then "a HEAD carries the body's length and none of its bytes" { passes(head_carries_no_body()) }
        then "100 Continue is written before the body is sent" { passes(expect_continue()) }
    }
    given "a connection's life" {
        then "two requests ride one connection and the state counts both" { passes(keep_alive_twice()) }
        then "two pipelined requests are answered in order" { passes(pipelined()) }
        then "a refused head is answered 400 and the connection closed" { passes(refused_then_closed()) }
        then "connection: close is honoured" { passes(closes_when_asked()) }
        then "an idle connection is dropped at its deadline" { passes(idle_is_dropped()) }
        then "a peer that ends first still gets its answer" { passes(peer_ends_first()) }
        then "an HTTP/1.0 peer asking to keep alive is told the connection persists" { passes(old_client_keeps_alive()) }
        then "an HTTP/1.0 peer not asking is told close, and closed" { passes(old_client_is_closed()) }
    }
    given "the router in the loop" {
        then "a target with a slash inside its query still finds its route, and the query reads beside the path" { passes(routed_through_the_loop()) }
    }
}
