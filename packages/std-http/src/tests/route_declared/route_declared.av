// proves: a route written as a declaration is built through its pattern's
// own record — its pattern text kept, its reach read off the pattern — with
// a handler reading the request bare and one reading its params.
use @std.http.route.{Route, get}

let health: Route = get "/health" { _req -> "ok" }
let idea: Route = get "/ideas/{id}" { req -> "idea " + req.params.id }
let file: Route = get "/files/{path...}" { req -> "file " + req.params.path }

"${health.pattern} ${idea.pattern} ${file.pattern}"
