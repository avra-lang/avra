use @std.net.{Conn, NetError, connect}
use @std.time.{ms, secs, within}
use @std.http.http.{text}
use @std.http.route.{get, post, delete}
use @std.http.server.{server}

export server app {
    port: 0

    get "/health" { _req -> "ok" }
    get "/ideas/{id}" { req -> "idea " + req.params.id }
    post "/ideas" { req -> text(201, "made " + (req.body.text() ?? "?")) }
    delete "/ideas/{id}" { _req -> 204 }
}

/// `sent` written, then read until the server closes or goes quiet.
fn exchanged(c: Conn, sent: string) -> Result<string, NetError> {
    c.write(sent.bytes())?
    mut got = "".bytes()
    mut open = true
    while open {
        match within ms(300) { c.read(65536) } {
            .Ok(b) -> {
                open = b != null
                got = got.concat(b ?? "".bytes())
            },
            .Err(_) -> { open = false },
        }
    }
    let parts = (got.text() ?? "?").split("\r\n\r\n")
    let body = if parts.length > 1 { parts[1] } else { "" }
    .Ok("${parts[0].split("\r\n").first() ?? "?"} ${body}")
}

fn asked(port: int, line: string) -> Result<string, NetError> {
    let c = connect("127.0.0.1", port, secs(2))?
    defer { let _ = c.close() }
    exchanged(c, line + "\r\nHost: a\r\nConnection: close\r\nContent-Length: 4\r\n\r\nnote")
}

fn shown() -> Result<string, NetError> {
    let s = app.listening()?
    spawn s.run(1)
    defer s.stop()
    let port = s.listener.port
    let lines = [
        asked(port, "GET /health HTTP/1.1")?,
        asked(port, "GET /ideas/7 HTTP/1.1")?,
        asked(port, "POST /ideas HTTP/1.1")?,
        asked(port, "DELETE /ideas/7 HTTP/1.1")?,
        asked(port, "GET /nope HTTP/1.1")?,
    ]
    .Ok(lines.join("\n"))
}

match shown() {
    .Ok(t) -> t,
    .Err(e) -> "failed: ${e.describe().message}",
}
