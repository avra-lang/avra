// http.av UNDER ATTACK: the WRITER, and the values a handler reads.
// reply_test.av reads a peer's bytes; this file writes our own and
// asks WHAT A PEER WOULD MAKE OF THEM.
//
// THE ORACLE IS THE FRAMER, WHICH IS A DIFFERENT ALGORITHM. A test
// that compared the wire against a second copy of the interpolation
// would agree with the writer by construction; framing the bytes back
// asks the only question that matters — how many fields did the peer
// get, and did a second reply appear inside the first.
use @std.http.frame.{framed, framed_reply, limits, Method}
use @std.http.http.{
    Request,
    Unrouted,
    Response,
    Header,
    Upgrade,
    wire,
    text,
    sendable,
    writable,
    switch_asked,
}
use @std.http.body.{Body}
use @std.http.wire.{Transport}
use @std.text.{from_codepoint}

// ── Fixtures ────────────────────────────────────────────────────

/// One response carrying one handler-chosen field, which is the shape
/// every redirect, CORS and ETag handler has.
fn ha_one_field(name: string, value: string) -> Response {
    Response { status: 200, headers: [Header { name: name, value: value }], body: "b".bytes() }
}

/// The bytes as written, line ends shown.
fn ha_wired(r: Response) -> string { undated(wire(r, true, 1).text() ?? "<not text>").replace("\r\n", "|") }

/// WHAT A PEER GETS: the status and how many field lines it framed,
/// or the law that refused the reply outright.
fn ha_peer_reads(r: Response) -> string {
    match framed_reply(wire(r, true, 1), 0, 0, limits(), Method.Get) {
        .Complete(reply) -> "${reply.status} fields=${reply.fields.count()}",
        .Partial -> "partial",
        .Refused(_) -> "refused",
    }
}

/// A response naming `protocols` in its `upgrade` field.
fn ha_offering(status: int, protocols: string) -> Response {
    Response { status: status, headers: [Header { name: "upgrade", value: protocols }] }
}

/// A 101 switching to `protocols`, its handover doing nothing.
fn ha_switch(protocols: string) -> Response { ha_offering(101, protocols) with { upgrade: Upgrade { run: ha_unrun } } }

fn ha_unrun(_c: dyn Transport, _early: Bytes) {}

/// The request `head` frames, carrying nothing past its head.
fn ha_request(head: string) -> Request<Unrouted>? {
    let raw = head.bytes()
    match framed(raw, 0, 0, limits()) {
        .Complete(h) -> Request { raw: raw, head: h, body: Body.Empty, peer: "p", params: Unrouted {} },
        .Partial or .Refused(_) -> null,
    }
}

/// Whether the request `head` frames asked for the switch `r` makes.
fn ha_asked(head: string, r: Response) -> bool {
    let q? = ha_request(head) else { return false }
    switch_asked(q, r)
}

/// The status line alone — the first line of the wire.
fn ha_wire_status_line(r: Response) -> string {
    let t = wire(r, true, 1).text() ?? "<not text>"
    t.substring(0, t.index_of("\r\n"))
}

spec "@std.http http adversarial" {
    given "a field a peer would reinterpret" {
        then "A CRLF IN A VALUE IS NOT A SECOND FIELD" {
            ha_peer_reads(ha_one_field("x", "1\r\nevil: 1")) == "500 fields=2"
        }
        then "and the wire carries no injected line" {
            !ha_wired(ha_one_field("x", "1\r\nevil: 1")).contains("evil")
        }
        then "A BLANK LINE IN A VALUE IS NOT A SECOND REPLY" {
            !ha_wired(ha_one_field("x", "1\r\n\r\nHTTP/1.1 200 OK\r\n\r\npwn")).contains("pwn")
        }
        then "a bare LF in a value is refused too" {
            ha_peer_reads(ha_one_field("x", "1\nevil: 1")) == "500 fields=2"
        }
        then "a CRLF in a NAME is not a second field" {
            ha_peer_reads(ha_one_field("a\r\nevil", "1")) == "500 fields=2"
        }
        then "a colon in a name is not a second field" {
            ha_peer_reads(ha_one_field("a: 1\r\nevil", "1")) == "500 fields=2"
        }
        then "a space in a name is refused" {
            ha_peer_reads(ha_one_field("a b", "1")) == "500 fields=2"
        }
        then "an empty name is refused" {
            ha_peer_reads(ha_one_field("", "1")) == "500 fields=2"
        }
        then "an empty value is a value, and the framer frames it" {
            ha_peer_reads(ha_one_field("x", "")) == "200 fields=3"
        }
        then "A NUL IS AN OCTET HERE AND A TERMINATOR THERE, so a value carrying one is refused" {
            ha_peer_reads(ha_one_field("x", "a" + nul() + "b")) == "500 fields=2"
        }
        then "and a name carrying one is refused" {
            ha_peer_reads(ha_one_field("a" + nul() + "b", "1")) == "500 fields=2"
        }
        then "a high octet in a value is refused" {
            ha_peer_reads(ha_one_field("x", "a" + from_codepoint(233) + "b")) == "500 fields=2"
        }
    }
    given "the framing fields the writer owns" {

        then "a handler's content-length does not join the writer's" {
            ha_peer_reads(ha_one_field("content-length", "999")) == "500 fields=2"
        }
        then "and its case does not smuggle it past" {
            ha_peer_reads(ha_one_field("Content-Length", "999")) == "500 fields=2"
        }
        then "a handler's transfer-encoding is refused beside a length" {
            ha_peer_reads(ha_one_field("transfer-encoding", "chunked")) == "500 fields=2"
        }
        then "a handler's connection contradicts the fate the writer speaks" {
            ha_peer_reads(ha_one_field("connection", "close")) == "500 fields=2"
        }
    }
    given "a status the handler chose" {

        then "a status line carries three digits, so 1000 cannot be written" {
            ha_wire_status_line(Response { status: 1000 }) == "HTTP/1.1 500 Internal Server Error"
        }
        then "and neither can 99" { ha_wire_status_line(Response { status: 99 }) == "HTTP/1.1 500 Internal Server Error" }
        then "nor 0" { ha_wire_status_line(Response { status: 0 }) == "HTTP/1.1 500 Internal Server Error" }
        then "nor a negative one, which the reason phrase used to call a success" {
            ha_wire_status_line(Response { status: 0 - 1 }) == "HTTP/1.1 500 Internal Server Error"
        }
        then "999 is three digits and goes out as it was chosen" {
            ha_wire_status_line(Response { status: 999 }) == "HTTP/1.1 999 Server Error"
        }
        then "A 1xx IS INTERIM, NEVER AN ANSWER, so a handler's 100 is the server's 500" {
            ha_wire_status_line(Response { status: 100 }) == "HTTP/1.1 500 Internal Server Error"
        }
        then "and so is 103, the highest interim status a peer registers" {
            ha_wire_status_line(Response { status: 103 }) == "HTTP/1.1 500 Internal Server Error"
        }
        then "and 199, the last of the class" {
            ha_wire_status_line(Response { status: 199 }) == "HTTP/1.1 500 Internal Server Error"
        }
        then "200 is the lowest final status" { ha_wire_status_line(Response { status: 200 }) == "HTTP/1.1 200 OK" }
    }
    given "a switch of protocols (RFC 9110 §7.8)" {
        then "a 101 handing the connection over and naming its protocol is sendable" { sendable(ha_switch("websocket")) }
        then "A 101 WITH NOTHING TO HAND OVER is the server's 500" {
            ha_wire_status_line(ha_offering(101, "websocket")) == "HTTP/1.1 500 Internal Server Error"
        }
        then "A 101 NAMING NO PROTOCOL is refused, though it hands over" {
            !sendable(Response { status: 101, upgrade: Upgrade { run: ha_unrun } })
        }
        then "and so is one whose upgrade field is blank" { !sendable(ha_switch(" ")) }
        then "a handover under a final status is refused" {
            !sendable(ha_switch("websocket") with { status: 200 })
        }
        then "a 101 carries no body" { !sendable(ha_switch("websocket") with { body: "x".bytes() }) }
        then "A 426 NAMES WHAT IT WANTS, or it is the server's 500" {
            ha_wire_status_line(Response { status: 426 }) == "HTTP/1.1 500 Internal Server Error"
        }
        then "and one that does lists `upgrade` in the connection field the writer owns" {
            ha_wired(ha_offering(426, "websocket")) == "HTTP/1.1 426 Upgrade Required|upgrade: websocket|content-length: 0|connection: upgrade||"
        }
        then "the option rides beside the close a last answer speaks" {
            (wire(ha_offering(200, "h2c"), false, 1).text() ?? "")
                .contains("\r\nconnection: close, upgrade\r\n")
        }
        then "and beside the keep-alive a 1.0 peer is told" {
            (wire(ha_offering(200, "h2c"), true, 0).text() ?? "")
                .contains("\r\nconnection: keep-alive, upgrade\r\n")
        }
        then "the field is found whatever its case" {
            ha_wired(
                Response { status: 426, headers: [Header { name: "Upgrade", value: "websocket" }] },
            )
                .contains("|connection: upgrade|")
        }
        then "a response that offers nothing speaks no option" { !ha_wired(text(200, "hi")).contains("upgrade") }
        then "a switch the request asked for is allowed" {
            ha_asked(
                "GET / HTTP/1.1\r\nHost: a\r\nUpgrade: websocket\r\n\r\n",
                ha_switch("websocket"),
            )
        }
        then "a request's list is read by token, folded" {
            ha_asked(
                "GET / HTTP/1.1\r\nHost: a\r\nUpgrade: h2c, WebSocket\r\n\r\n",
                ha_switch("websocket"),
            )
        }
        then "A SWITCH TO WHAT WAS NOT ASKED FOR is refused" {
            !ha_asked("GET / HTTP/1.1\r\nHost: a\r\nUpgrade: h2c\r\n\r\n", ha_switch("websocket"))
        }
        then "and so is a switch to two protocols where one was asked for" {
            !ha_asked(
                "GET / HTTP/1.1\r\nHost: a\r\nUpgrade: websocket\r\n\r\n",
                ha_switch("websocket, h2c"),
            )
        }
        then "and a switch nobody asked for at all" { !ha_asked("GET / HTTP/1.1\r\nHost: a\r\n\r\n", ha_switch("websocket")) }
        then "AN HTTP/1.0 UPGRADE IS IGNORED, so it asked for nothing" {
            !ha_asked("GET / HTTP/1.0\r\nUpgrade: websocket\r\n\r\n", ha_switch("websocket"))
        }
        then "an answer that switches nothing is never refused by the switch law" {
            ha_asked("GET / HTTP/1.0\r\n\r\n", text(200, "hi"))
        }
    }
    given "what the keeper ACCEPTS, which making it fail never tests" {

        then "an ordinary field goes out untouched" {
            ha_wired(ha_one_field("x-tag", "t1")) == "HTTP/1.1 200 OK|x-tag: t1|content-length: 1||b"
        }
        then "a value holding a colon, a comma and a space is ordinary" {
            ha_wired(ha_one_field("x-when", "Mon, 01 Jan 2035 00:00:00 GMT")) == "HTTP/1.1 200 OK|x-when: Mon, 01 Jan 2035 00:00:00 GMT|content-length: 1||b"
        }
        then "a name of every token mark is a name" {
            sendable(ha_one_field("!#\$%&'*+-.^_`|~0aZ", "v"))
        }
        then "a value may hold a tab, which is visible ASCII by the framer's law" {
            sendable(ha_one_field("x", "a\tb"))
        }
        then "content-type is not a framing field, so a handler owns it" {
            sendable(ha_one_field("content-type", "text/plain"))
        }
        then "the library's own text() answer is writable" { sendable(text(200, "hi")) }
        then "a response with no fields at all is writable" { sendable(Response { status: 204 }) }
        then "and the field law answers about ONE field, so it can be asked before answering" {
            writable(Header { name: "x", value: "1" }) &&
                !writable(Header { name: "x", value: "1\r\ny: 2" })
        }
    }
    given "the body is octets and never a field" {

        then "a NUL in the body is written, because a body is not a line" {
            wire(text(200, "a" + nul() + "b"), true, 1).length == wire(text(200, "axb"), true, 1).length
        }
        then "an empty body is a length of zero, not an absence" {
            ha_wired(Response { status: 200 }) == "HTTP/1.1 200 OK|content-length: 0||"
        }
    }
    given "what a Request answers about octets it holds" {

        then "A TARGET THE FRAMER ADMITS AND UTF-8 CANNOT SPELL IS ABSENT, NEVER EMPTY" {
            ha_asked_for(ha_obs_target()) == null
        }
        then "and the octets are still there to be read" {
            ha_framed_target(ha_obs_target()).length == 5
        }
        then "an ordinary target answers itself" { ha_asked_for("/a?b=c".bytes()) == "/a?b=c" }
        then "an empty query is still a target" { ha_asked_for("/a?".bytes()) == "/a?" }
        then "a field value is ASCII by framing, so a header is total" {
            ha_header_of("/a", "x-tag: t1\r\n", "x-tag") == "t1"
        }
        then "a field the request does not carry is absent" {
            ha_header_of("/a", "x-tag: t1\r\n", "x-other") == null
        }
        then "A FIELD NAME IS COMPARED WHOLE, so a prefix of one is not it" {
            ha_header_of("/a", "x-tag: t1\r\n", "x-ta") == null
        }
        then "and neither is an extension of one" {
            ha_header_of("/a", "x-tag: t1\r\n", "x-tag-2") == null
        }
    }
}

/// A target carrying obs-text — an octet the framer ADMITS and no
/// UTF-8 decoding can answer.
fn ha_obs_target() -> Bytes { "/caf".bytes().concat([233].bytes()!) }

fn ha_framed_from(target: Bytes) -> Request<Unrouted>? {
    framed_from("GET ".bytes().concat(target).concat(" HTTP/1.1\r\nHost: h\r\n\r\n".bytes()))
}

fn ha_asked_for(target: Bytes) -> string? { ha_framed_from(target)!.target() }

fn ha_framed_target(target: Bytes) -> Bytes { ha_framed_from(target)!.path()! }

fn ha_header_of(target: string, fields: string, name: string) -> string? {
    framed_from(("GET " + target + " HTTP/1.1\r\nHost: h\r\n" + fields + "\r\n").bytes())?.header(name)
}
