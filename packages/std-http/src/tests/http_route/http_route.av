// ONE RESOURCE, TWO FORMS, ONE HANDLER. The framer accepts
// absolute-form because RFC 9112 §3.3 says a server MUST, and a
// router that read the whole URI answered `/admin` and
// `http://h/admin` from two different routes — the differential a
// normalising front end turns into a bypass. Both engines, one law.
use @std.http.frame.{framed, limits, Method}
use @std.http.http.{Request, Unrouted, Response, text}
use @std.http.route.{Table, fixed, compiled, dispatch}
use @std.http.body.{Body}

fn serve_admin(q: Request<Unrouted>) -> Response { text(200, "admin@${q.authority() ?? "-"}") }
fn serve_root(q: Request<Unrouted>) -> Response { text(200, "root") }

once fn routes() -> Table {
    compiled([fixed(Method.Get, "/admin", serve_admin), fixed(Method.Get, "/", serve_root)])
}

fn asked(line: string) -> Request<Unrouted>? {
    let raw = (line + "\r\nHost: h\r\n\r\n").bytes()
    match framed(raw, 0, 0, limits()) {
        .Complete(head) -> Request { raw: raw, head: head, body: Body.Empty, peer: "c", params: Unrouted {} },
        .Partial or .Refused(_) -> null,
    }
}

/// What the router answers, beside the path and authority it read.
fn row(line: string) -> string {
    let q? = asked(line) else { return "${line} -> unframed" }
    let r = dispatch(routes(), q)
    "${line} -> ${r.status} ${r.body.text() ?? ""} path=${q.path()?.text() ?? "<none>"} authority=${q.authority() ?? "<none>"}"
}

[
    row("GET /admin HTTP/1.1"),
    row("GET http://h/admin HTTP/1.1"),
    row("GET https://h:8080/admin?x=1 HTTP/1.1"),
    row("GET / HTTP/1.1"),
    row("GET http://h HTTP/1.1"),
    row("OPTIONS * HTTP/1.1"),
    row("CONNECT h:443 HTTP/1.1"),
    row("GET http://h/admin#top HTTP/1.1"),
]
    .join("\n")
