// proves: cookies end to end, evaluated and native alike — a request's
// cookies read, a set-cookie line written and one refused, a signed
// value and a session opened and a forged one not.
use @std.http.frame.{framed, limits}
use @std.http.http.{Request, Unrouted}
use @std.http.cookie.{SetCookie, SameSite, Signer, Session}

fn mac(key: Bytes, msg: Bytes) -> Bytes {
    mut acc = 7
    for i in 0..msg.length { acc = (acc * 31 + msg.at(i) + key.at(i % key.length)) % 1000003 }
    [acc % 256, acc / 256 % 256, acc / 65536 % 256].bytes()!
}

fn said(c: SetCookie) -> string {
    match c.header() { .Ok(h) -> h.value, .Err(e) -> e.describe().message }
}

let raw = "GET / HTTP/1.1\r\nHost: h\r\nCookie: a=1; b=\"two\"\r\ncookie: c=3\r\n\r\n".bytes()
let q = match framed(raw, 0, 0, limits()) {
    .Complete(head) -> Request { raw: raw, head: head, body: "".bytes(), peer: "t", params: Unrouted {} },
    .Partial or .Refused(_) -> null,
}
println([c.name + "=" + c.value for c in q!.cookies()].join(" "))
println(said(SetCookie { name: "id", value: "42", max_age: 60, same_site: SameSite.Strict }))
println(said(SetCookie { name: "id", value: "4;2" }))
let s = Signer { key: "k".bytes(), mac: mac }
let sealed = s.signed("id", "42")
println("${s.opened("id", sealed) ?? "-"} ${s.opened("other", sealed) ?? "-"}")
let session = Session { signer: s, max_age: 10 }
let cookie = session.issued("user 7", 100).value
"${session.opened(cookie, 105) ?? "-"} ${session.opened(cookie, 110) ?? "-"}"
