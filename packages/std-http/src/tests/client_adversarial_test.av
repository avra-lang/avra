//! The client under attack by a peer that speaks raw bytes: a reply
//! torn across reads, one the framer refuses, one cut short, one
//! read to the close, one chunked, one that never comes.
use @std.net.{Listener, Conn, Poller, Read, NetError, listen, poller}
use @std.time.{ms, secs}
use @std.http.frame.{limits, Limits, Method}
use @std.http.http.{Header}
use @std.http.client.{Client, Answer, ClientError, connected, request}

/// A client and the raw peer it is talking to.
type Wire = { c: Client, peer: Conn, l: Listener, p: Poller }

fn wired() -> Result<Wire, ClientError> {
    let l = lifted(listen("127.0.0.1", 0))?
    mut c = connected("127.0.0.1", l.port, secs(2), limits())?
    c.sent(.Get, request("GET", "/", "a", [], "".bytes()))?
    let p = lifted(poller())?
    lifted(p.watch(l.fd, .Read))?
    lifted(p.wait(ms(500)))?
    let peer: Conn? = lifted(l.accept())?
    if peer == null { return .Err(.Closed) }
    // the request read, so a later close is a FIN and never a reset
    lifted(p.watch(peer!.fd, .Read))?
    lifted(p.wait(ms(500)))?
    let _ = lifted(peer!.read(4096))?
    .Ok(Wire { c: c, peer: peer!, l: l, p: p })
}

/// The peer's bytes written, then the client polled until it answers
/// or errs; null when it is still waiting after `turns` polls.
fn spoken(mut w: Wire, said: string, turns: int) -> Result<Answer?, ClientError> {
    let out = said.bytes()
    mut from = 0
    while from < out.length { from = from + lifted(w.peer.write(out, from))? }
    mut n = 0
    while n < turns {
        let a: Answer? = w.c.polled(ms(20))?
        if a != null { return .Ok(a) }
        n = n + 1
    }
    .Ok(null)
}

fn outcome(r: Result<Answer?, ClientError>) -> string {
    match r {
        .Ok(a) -> if a == null { "waiting" } else { "${a!.status} ${a!.body.text() ?? "?"}" },
        .Err(e) -> e.describe().kind,
    }
}

fn torn_reply() -> Result<bool, ClientError> {
    mut w = wired()?
    let early = outcome(spoken(w, "HTTP/1.1 200 OK\r\ncontent-length: 5\r\n\r", 2))
    let late = outcome(spoken(w, "\nhello", 5))
    .Ok(early == "waiting" && late == "200 hello")
}

fn body_torn() -> Result<bool, ClientError> {
    mut w = wired()?
    let early = outcome(spoken(w, "HTTP/1.1 200 OK\r\ncontent-length: 5\r\n\r\nhel", 2))
    let late = outcome(spoken(w, "lo", 5))
    .Ok(early == "waiting" && late == "200 hello")
}

fn refused_reply() -> Result<bool, ClientError> {
    mut w = wired()?
    .Ok(outcome(spoken(w, "HTTP/1.1 200 OK\ncontent-length: 0\n\n", 5)) == "http.refused")
}

fn cut_short() -> Result<bool, ClientError> {
    mut w = wired()?
    let early = outcome(spoken(w, "HTTP/1.1 200 OK\r\ncontent-length: 5\r\n\r\nhel", 2))
    let _ = lifted(w.peer.close())?
    let late = outcome(spoken(w, "", 5))
    .Ok(early == "waiting" && late == "http.closed")
}

fn closed_before_any_reply() -> Result<bool, ClientError> {
    mut w = wired()?
    let _ = lifted(w.peer.close())?
    .Ok(outcome(spoken(w, "", 5)) == "http.closed")
}

/// A peer that closes with the request unread resets the connection:
/// the verdict is the network's, not a clean close.
fn reset_by_peer() -> Result<bool, ClientError> {
    let l = lifted(listen("127.0.0.1", 0))?
    mut c = connected("127.0.0.1", l.port, secs(2), limits())?
    c.sent(.Get, request("GET", "/", "a", [], "".bytes()))?
    let p = lifted(poller())?
    lifted(p.watch(l.fd, .Read))?
    lifted(p.wait(ms(500)))?
    let peer: Conn? = lifted(l.accept())?
    if peer == null { return .Err(.Closed) }
    let _ = lifted(peer!.close())?
    mut w = Wire { c: c, peer: peer!, l: l, p: p }
    .Ok(outcome(spoken(w, "", 5)) == "net.read")
}

fn read_to_close() -> Result<bool, ClientError> {
    mut w = wired()?
    let early = outcome(spoken(w, "HTTP/1.1 200 OK\r\ncontent-type: text/plain\r\n\r\nhel", 2))
    let mid = outcome(spoken(w, "lo", 2))
    let _ = lifted(w.peer.shutdown_write())?
    let late = outcome(spoken(w, "", 5))
    .Ok(early == "waiting" && mid == "waiting" && late == "200 hello")
}

fn chunked_reply() -> Result<bool, ClientError> {
    mut w = wired()?
    let early = outcome(spoken(w, "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\n3\r\nhel\r\n", 2))
    let late = outcome(spoken(w, "2\r\nlo\r\n0\r\n\r\n", 5))
    .Ok(early == "waiting" && late == "200 hello")
}

fn no_content() -> Result<bool, ClientError> {
    mut w = wired()?
    .Ok(outcome(spoken(w, "HTTP/1.1 204 No Content\r\n\r\n", 5)) == "204 ")
}

fn never_replies() -> Result<bool, ClientError> {
    mut w = wired()?
    let r = w.c.fetched(.Get, request("GET", "/", "a", [], "".bytes()), ms(60))
    .Ok(outcome(match r {
        .Ok(a) -> .Ok(a),
        .Err(e) -> .Err(e),
    }) == "http.timed_out")
}

fn two_replies_one_connection() -> Result<bool, ClientError> {
    mut w = wired()?
    let one = outcome(spoken(w, "HTTP/1.1 200 OK\r\ncontent-length: 1\r\n\r\na", 5))
    w.c.sent(.Get, request("GET", "/", "a", [], "".bytes()))?
    let two = outcome(spoken(w, "HTTP/1.1 201 Created\r\ncontent-length: 1\r\n\r\nb", 5))
    .Ok(one == "200 a" && two == "201 b")
}

fn reply_too_large() -> Result<bool, ClientError> {
    let l = lifted(listen("127.0.0.1", 0))?
    mut c = connected("127.0.0.1", l.port, secs(2), Limits { head: 64 })?
    c.sent(.Get, request("GET", "/", "a", [], "".bytes()))?
    let p = lifted(poller())?
    lifted(p.watch(l.fd, .Read))?
    lifted(p.wait(ms(500)))?
    let peer: Conn? = lifted(l.accept())?
    if peer == null { return .Err(.Closed) }
    mut w = Wire { c: c, peer: peer!, l: l, p: p }
    let filler = ["x" for i in 0..100].join("")
    .Ok(outcome(spoken(w, "HTTP/1.1 200 OK\r\nx-pad: ${filler}\r\n\r\n", 5)) == "http.refused")
}

fn holds(r: Result<bool, ClientError>) -> bool {
    match r {
        .Ok(b) -> b,
        .Err(_) -> false,
    }
}

spec "std.http client adversarial" {
    given "a reply in pieces" {
        then "a head torn at its terminator completes on the next bytes" { holds(torn_reply()) }
        then "a body torn across reads is gathered" { holds(body_torn()) }
        then "a chunked reply is decoded across reads" { holds(chunked_reply()) }
        then "a reply with no length is whole at the close" { holds(read_to_close()) }
    }
    given "a peer that misbehaves" {
        then "a reply the framer refuses is an error naming the law" { holds(refused_reply()) }
        then "a reply past the head bound is refused" { holds(reply_too_large()) }
        then "a body cut short by the close is an error" { holds(cut_short()) }
        then "a close before any reply is an error" { holds(closed_before_any_reply()) }
        then "a close with the request unread is a reset, and the network's verdict" { holds(reset_by_peer()) }
        then "a peer that never replies is a timeout" { holds(never_replies()) }
    }
    given "the reply's rules" {
        then "a 204 has no body and needs none" { holds(no_content()) }
        then "two replies ride one connection" { holds(two_replies_one_connection()) }
    }
}
