//! The client under attack by a peer that speaks raw bytes: a reply
//! torn across reads, one the framer refuses, one cut short, one
//! read to the close, one chunked, one that never comes.
use @std.net.{Listener, Conn, listen, poller}
use @std.time.{Duration, ms, secs}
use @std.http.frame.{framed, limits, Limits}
use @std.http.http.{Header}
use @std.http.client.{Client, Answer, ClientError, connected, request}

/// A client and the raw peer it is talking to.
type Wire = { c: Client, peer: Conn, l: Listener }

/// A client with its request WRITTEN and the peer accepted, under
/// `lim` — the scaffolding every attack here shares. The request is
/// not yet read, so a peer that closes at this point RESETS.
fn wiring(lim: Limits) -> Result<Wire, ClientError> {
    let l = lifted(listen("127.0.0.1", 0))?
    mut c = connected("127.0.0.1", l.port, secs(2), lim)?
    c.sent(request("GET", "/", "a", [], "".bytes())!)?
    let peer = lifted(within verdict_bound() { l.accept() })?
    if !arrived(peer)? { return .Err(.TimedOut(.Total)) }
    .Ok(Wire { c: c, peer: peer, l: l })
}

/// Whether the peer's receive buffer holds bytes, UNREAD — the reset
/// law's precondition. A write returning and an accept succeeding do
/// not by themselves mean delivery has landed; under load it has not.
/// The poller blocks on the kernel's own readiness signal instead of a
/// guessed budget.
fn arrived(peer: Conn) -> Result<bool, ClientError> {
    let p = lifted(poller())?
    let _ = lifted(p.watch(peer.fd, .Read))?
    let events = lifted(p.wait(verdict_bound()))?
    let _ = lifted(p.close())?
    .Ok(events.any(it.fd == peer.fd && it.readable))
}

/// The same, with the request READ, so a later close is a FIN and
/// never a reset.
fn wired() -> Result<Wire, ClientError> {
    let w = wiring(limits())?
    let _ = lifted(within verdict_bound() { w.peer.read(4096) })?
    .Ok(w)
}

/// The peer's bytes written, then the client read for a moment: null
/// while it is still waiting — the one answer a short wait can prove,
/// since a slow machine only makes it truer.
fn pending(mut w: Wire, said: string) -> Result<Answer?, ClientError> { heard(w, said, ms(40)) }

/// The peer's bytes written, then the client read until it answers or
/// errs. A VERDICT IS WAITED FOR, NEVER RACED: under a short clock a
/// descheduled test reads a reset as "waiting", so the bound only ends
/// a hang.
fn settled(mut w: Wire, said: string) -> Result<Answer?, ClientError> { heard(w, said, verdict_bound()) }

fn heard(mut w: Wire, said: string, d: Duration) -> Result<Answer?, ClientError> {
    let _ = lifted(w.peer.write(said.bytes()))?
    waiting_is_null(within d { awaited(w) })
}

/// How long a wait whose answer is due may take before it is a hang.
fn verdict_bound() -> Duration { secs(5) }

fn awaited(mut w: Wire) -> Result<Answer?, ClientError> {
    mut a: Answer? = null
    while a == null { a = w.c.received()? }
    .Ok(a)
}

/// A read the deadline cut short is a client still waiting.
fn waiting_is_null(r: Result<Answer?, ClientError>) -> Result<Answer?, ClientError> {
    match r { .Err(.Net(e)) if e.timed_out() -> .Ok(null), .Err(e) -> .Err(e), .Ok(a) -> .Ok(a) }
}

fn outcome(r: Result<Answer?, ClientError>) -> string {
    match r {
        .Ok(a) -> if a == null { "waiting" } else { "${a!.status} ${a!.body.text() ?? "?"}" },
        .Err(e) -> e.describe().kind,
    }
}

fn torn_reply() -> Result<bool, ClientError> {
    mut w = wired()?
    let early = outcome(pending(w, "HTTP/1.1 200 OK\r\ncontent-length: 5\r\n\r"))
    let late = outcome(settled(w, "\nhello"))
    .Ok(early == "waiting" && late == "200 hello")
}

fn body_torn() -> Result<bool, ClientError> {
    mut w = wired()?
    let early = outcome(pending(w, "HTTP/1.1 200 OK\r\ncontent-length: 5\r\n\r\nhel"))
    let late = outcome(settled(w, "lo"))
    .Ok(early == "waiting" && late == "200 hello")
}

fn refused_reply() -> Result<bool, ClientError> {
    mut w = wired()?
    .Ok(outcome(settled(w, "HTTP/1.1 200 OK\ncontent-length: 0\n\n")) == "http.refused")
}

fn cut_short() -> Result<bool, ClientError> {
    mut w = wired()?
    let early = outcome(pending(w, "HTTP/1.1 200 OK\r\ncontent-length: 5\r\n\r\nhel"))
    let _ = lifted(w.peer.close())?
    let late = outcome(settled(w, ""))
    .Ok(early == "waiting" && late == "http.closed")
}

fn closed_before_any_reply() -> Result<bool, ClientError> {
    mut w = wired()?
    let _ = lifted(w.peer.close())?
    .Ok(outcome(settled(w, "")) == "http.closed")
}

/// A peer that closes with the request unread resets the connection:
/// the verdict is the network's, not a clean close.
fn reset_by_peer() -> Result<bool, ClientError> {
    mut w = wiring(limits())?
    let _ = lifted(w.peer.close())?
    .Ok(outcome(settled(w, "")) == "net.read")
}

fn read_to_close() -> Result<bool, ClientError> {
    mut w = wired()?
    let early = outcome(pending(w, "HTTP/1.1 200 OK\r\ncontent-type: text/plain\r\n\r\nhel"))
    let mid = outcome(pending(w, "lo"))
    let _ = lifted(w.peer.shutdown_write())?
    let late = outcome(settled(w, ""))
    .Ok(early == "waiting" && mid == "waiting" && late == "200 hello")
}

fn chunked_reply() -> Result<bool, ClientError> {
    mut w = wired()?
    let early = outcome(
        pending(w, "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\n3\r\nhel\r\n"),
    )
    let late = outcome(settled(w, "2\r\nlo\r\n0\r\n\r\n"))
    .Ok(early == "waiting" && late == "200 hello")
}

fn no_content() -> Result<bool, ClientError> {
    mut w = wired()?
    .Ok(outcome(settled(w, "HTTP/1.1 204 No Content\r\n\r\n")) == "204 ")
}

fn never_replies() -> Result<bool, ClientError> {
    let l = lifted(listen("127.0.0.1", 0))?
    mut c = connected("127.0.0.1", l.port, secs(2), limits())?
    let r = c.fetched(request("GET", "/", "a", [], "".bytes())!, ms(60))
    .Ok(outcome(match r { .Ok(a) -> .Ok(a), .Err(e) -> .Err(e) }) == "http.timed_out")
}

fn two_replies_one_connection() -> Result<bool, ClientError> {
    mut w = wired()?
    let one = outcome(settled(w, "HTTP/1.1 200 OK\r\ncontent-length: 1\r\n\r\na"))
    w.c.sent(request("GET", "/", "a", [], "".bytes())!)?
    let two = outcome(settled(w, "HTTP/1.1 201 Created\r\ncontent-length: 1\r\n\r\nb"))
    .Ok(one == "200 a" && two == "201 b")
}

fn reply_too_large() -> Result<bool, ClientError> {
    mut w = wiring(Limits { head: 64 })?
    let filler = ["x" for i in 0..100].join("")
    .Ok(outcome(settled(w, "HTTP/1.1 200 OK\r\nx-pad: ${filler}\r\n\r\n")) == "http.refused")
}

/// What the next request on `w`'s connection comes to: its send
/// refused, or the reply the peer's `said` makes of it.
fn next_on(mut w: Wire, said: string) -> string {
    match w.c.sent(request("GET", "/", "a", [], "".bytes())!) {
        .Err(e) -> e.describe().kind,
        .Ok(_) -> outcome(settled(w, said)),
    }
}

const evil_reply: string = "HTTP/1.1 200 OK\r\ncontent-length: 4\r\n\r\nevil"

fn interims_passed() -> Result<bool, ClientError> {
    mut w = wired()?
    let one = outcome(
        settled(w, "HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 200 OK\r\ncontent-length: 1\r\n\r\na"),
    )
    w.c.sent(request("GET", "/", "a", [], "".bytes())!)?
    let early = outcome(pending(w, "HTTP/1.1 103 Early Hints\r\nlink: </s>\r\n\r\nHTTP/1.1 103 E"))
    let late = outcome(
        settled(w, "arly Hints\r\n\r\nHTTP/1.1 201 Created\r\ncontent-length: 1\r\n\r\nb"),
    )
    .Ok(one == "200 a" && early == "waiting" && late == "201 b")
}

fn switching_is_the_answer() -> Result<bool, ClientError> {
    mut w = wired()?
    let one = outcome(
        settled(w, "HTTP/1.1 101 Switching Protocols\r\nupgrade: x\r\nconnection: upgrade\r\n\r\n"),
    )
    .Ok(one == "101 " && next_on(w, evil_reply) == "http.spent")
}

fn folded_field() -> Result<bool, ClientError> {
    mut w = wired()?
    let _ = lifted(
        w.peer.write("HTTP/1.1 200 OK\r\nx: a\r\n b\r\n\t c\r\ncontent-length: 1\r\n\r\nz".bytes()),
    )?
    let a? = waiting_is_null(within ms(100) { awaited(w) })? else { return .Ok(false) }
    .Ok(a.header("x") == "a   b    c" && a.body.text() == "z")
}

fn folded_close() -> Result<string, ClientError> {
    mut w = wired()?
    let one = outcome(
        settled(
            w,
            "HTTP/1.1 200 OK\r\nconnection: keep-alive,\r\n close\r\ncontent-length: 1\r\n\r\na",
        ),
    )
    .Ok("${one} ${next_on(w, "HTTP/1.1 200 OK\r\ncontent-length: 0\r\n\r\n")}")
}

fn after_refused() -> Result<string, ClientError> {
    mut w = wired()?
    let one = outcome(settled(w, "HTTP/1.1 200 OK\r\ncontent-length: 5, 6\r\n\r\nhello"))
    .Ok("${one} ${next_on(w, evil_reply)}")
}

fn after_extra_bytes() -> Result<string, ClientError> {
    mut w = wired()?
    let one = outcome(settled(w, "HTTP/1.1 200 OK\r\ncontent-length: 0\r\n\r\n" + evil_reply))
    .Ok("${one} ${next_on(w, "")}")
}

fn after_their_close() -> Result<string, ClientError> {
    mut w = wired()?
    let one = outcome(
        settled(w, "HTTP/1.1 200 OK\r\nconnection: close\r\ncontent-length: 1\r\n\r\na"),
    )
    .Ok("${one} ${next_on(w, evil_reply)}")
}

fn after_abandoned() -> Result<string, ClientError> {
    mut w = wired()?
    let early = outcome(pending(w, "HTTP/1.1 200 OK\r\ncontent-length: 5\r\n\r\nhel"))
    .Ok("${early} ${next_on(w, "lo")}")
}

fn after_unanswered() -> Result<string, ClientError> {
    mut w = wired()?
    .Ok(next_on(w, evil_reply))
}

fn after_our_close() -> Result<string, ClientError> {
    let l = lifted(listen("127.0.0.1", 0))?
    mut c = connected("127.0.0.1", l.port, secs(2), limits())?
    c.sent(request("GET", "/", "a", [Header { name: "connection", value: "close" }], "".bytes())!)?
    let peer = lifted(within ms(500) { l.accept() })?
    let _ = lifted(within ms(500) { peer.read(4096) })?
    mut w = Wire { c: c, peer: peer, l: l }
    let one = outcome(settled(w, "HTTP/1.1 200 OK\r\ncontent-length: 1\r\n\r\na"))
    .Ok("${one} ${next_on(w, evil_reply)}")
}

/// What a SERVER makes of the bytes the builder wrote — the oracle
/// is the framer, a different algorithm, and it counts the field
/// lines a peer would actually get.
fn ca_server_reads(req: Bytes?) -> string {
    if req == null { return "unwritable" }
    match framed(req!, 0, 0, limits()) {
        .Complete(h) -> "framed fields=${h.fields.count()}",
        .Partial -> "partial",
        .Refused(_) -> "refused",
    }
}

fn ca_nothing() -> Bytes { "".bytes() }

fn unframed_unsent() -> Result<bool, ClientError> {
    let l = lifted(listen("127.0.0.1", 0))?
    mut c = connected("127.0.0.1", l.port, secs(2), limits())?
    let hostless = is_unwritable(c.sent("GET / HTTP/1.1\r\n\r\n".bytes()))
    let bare_lf = is_unwritable(c.sent("GET / HTTP/1.1\nhost: a\n\n".bytes()))
    let unended = is_unwritable(c.sent("GET / HTTP/1.1\r\nhost: a\r\n".bytes()))
    .Ok(hostless && bare_lf && unended)
}

/// Whether `r` is the text `want`.
fn ca_says(r: Result<string, ClientError>, want: string) -> bool {
    match r { .Ok(t) -> t == want, .Err(_) -> false }
}

fn is_unwritable(r: Result<int, ClientError>) -> bool {
    match r { .Err(.Unwritable) -> true, .Err(_) or .Ok(_) -> false }
}

spec "std.http client adversarial" {
    given "a request word a peer would reinterpret" {
        then "A CRLF IN THE HOST IS NOT A SECOND FIELD" {
            ca_server_reads(request("GET", "/", "h\r\nX-Evil: 1", [], ca_nothing())) == "unwritable"
        }
        then "A CRLF IN A HEADER VALUE IS NOT A SECOND FIELD" {
            ca_server_reads(
                request(
                    "GET",
                    "/",
                    "h",
                    [Header { name: "x", value: "1\r\nX-Evil: 1" }],
                    ca_nothing(),
                ),
            ) == "unwritable"
        }
        then "A CRLF IN THE TARGET IS NOT A SECOND REQUEST" {
            ca_server_reads(
                request("GET", "/ HTTP/1.1\r\nX: 1\r\n\r\nGET /evil", "h", [], ca_nothing()),
            ) == "unwritable"
        }
        then "and neither is one in the method" {
            ca_server_reads(
                request("GET / HTTP/1.1\r\nX: 1\r\n\r\nGET", "/", "h", [], ca_nothing()),
            ) == "unwritable"
        }
        then "a space in the target is not a target" {
            ca_server_reads(request("GET", "/a b", "h", [], ca_nothing())) == "unwritable"
        }
        then "an empty target is not a target" {
            ca_server_reads(request("GET", "", "h", [], ca_nothing())) == "unwritable"
        }
        then "an empty method is not a method" {
            ca_server_reads(request("", "/", "h", [], ca_nothing())) == "unwritable"
        }
        then "an empty host is not a host" {
            ca_server_reads(request("GET", "/", "", [], ca_nothing())) == "unwritable"
        }
        then "a lowercase method is a token and is written" {
            ca_server_reads(request("get", "/", "h", [], ca_nothing())) == "framed fields=1"
        }
    }
    given "the framing fields the builder owns" {

        then "a caller's content-length does not join the builder's" {
            ca_server_reads(
                request(
                    "POST",
                    "/",
                    "h",
                    [Header { name: "content-length", value: "0" }],
                    "hi".bytes(),
                ),
            ) == "unwritable"
        }
        then "and a transfer-encoding beside a length is the smuggling shape" {
            ca_server_reads(
                request(
                    "POST",
                    "/",
                    "h",
                    [Header { name: "transfer-encoding", value: "chunked" }],
                    "hi".bytes(),
                ),
            ) == "unwritable"
        }
        then "an ordinary field is written, and the server frames it" {
            ca_server_reads(
                request("GET", "/", "h", [Header { name: "x-tag", value: "t1" }], ca_nothing()),
            ) == "framed fields=2"
        }
        then "a plain request frames with its host alone" {
            ca_server_reads(request("GET", "/", "h", [], ca_nothing())) == "framed fields=1"
        }
        then "a body earns a length, which the server reads" {
            ca_server_reads(request("POST", "/p", "h", [], "hello".bytes())) == "framed fields=2"
        }
    }
    given "a reply in pieces" {

        then "a head torn at its terminator completes on the next bytes" { passes(torn_reply()) }
        then "a body torn across reads is gathered" { passes(body_torn()) }
        then "a chunked reply is decoded across reads" { passes(chunked_reply()) }
        then "a reply with no length is whole at the close" { passes(read_to_close()) }
    }
    given "a peer that misbehaves" {
        then "a reply the framer refuses is an error naming the law" { passes(refused_reply()) }
        then "a reply past the head bound is refused" { passes(reply_too_large()) }
        then "a body cut short by the close is an error" { passes(cut_short()) }
        then "a close before any reply is an error" { passes(closed_before_any_reply()) }
        then "a close with the request unread is a reset, and the network's verdict" { passes(reset_by_peer()) }
        then "a peer that never replies is a timeout" { passes(never_replies()) }
    }
    given "the reply's rules" {
        then "a 204 has no body and needs none" { passes(no_content()) }
        then "two replies ride one connection" { passes(two_replies_one_connection()) }
        then "interim replies are read and passed over, torn or whole, to the answer" { passes(interims_passed()) }
        then "a 101 is the answer, not an interim reply, and the connection is no longer HTTP's" { passes(switching_is_the_answer()) }
        then "a folded field reads with each fold as spaces" { passes(folded_field()) }
    }
    given "a connection an exchange ended carries nothing more" {
        then "a close hidden in a fold is heard" { ca_says(folded_close(), "200 a http.spent") }
        then "a refused reply ends it, and its bytes are never the next reply" {
            ca_says(after_refused(), "http.refused http.spent")
        }
        then "a reply past the one asked for is never the next request's" {
            ca_says(after_extra_bytes(), "200  http.spent")
        }
        then "an exchange abandoned mid-reply ends it" { ca_says(after_abandoned(), "waiting http.spent") }
        then "a request sent before the last one's reply is refused, never paired with that reply" {
            ca_says(after_unanswered(), "http.spent")
        }
        then "a reply saying close ends it" { ca_says(after_their_close(), "200 a http.spent") }
        then "a request saying close ends it, whatever the reply says" { ca_says(after_our_close(), "200 a http.spent") }
    }
    given "the fields the builder owns" {
        then "a caller's te is refused — chunked most of all" {
            ca_server_reads(
                    request(
                        "GET",
                        "/",
                        "h",
                        [Header { name: "te", value: "chunked" }],
                        ca_nothing(),
                    ),
                ) == "unwritable" &&
                ca_server_reads(
                    request(
                        "GET",
                        "/",
                        "h",
                        [Header { name: "TE", value: "trailers" }],
                        ca_nothing(),
                    ),
                ) == "unwritable"
        }
        then "a head the framer refuses, or one whose method is not the one asked, is not sent" { passes(unframed_unsent()) }
    }
}
