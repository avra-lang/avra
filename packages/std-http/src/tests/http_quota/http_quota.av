// proves: quotas, evaluated and native alike — a client held to its
// rate and told when to come back, a route's body bound, and the
// probes an orchestrator asks.
use @std.time.{secs}
use @std.http.frame.{framed, limits}
use @std.http.body.{Body}
use @std.http.http.{Request, Unrouted, Response, text}
use @std.http.quota.{Rate, Bounds, Readiness, rated, held_to, probes}
use @std.http.route.{compiled, dispatch}

fn asked(line: string, fields: string) -> Request<Unrouted> {
    let raw = "${line}\r\nHost: h\r\n${fields}\r\n".bytes()
    let head = match framed(raw, 0, 0, limits()) {
        .Complete(h) -> h,
        .Partial or .Refused(_) -> null,
    }
    Request { raw: raw, head: head!, body: Body.Empty, peer: "10.0.0.1:4000", params: Unrouted {} }
}

fn shown(r: Response) -> string { "${r.status} ${r.header("retry-after") ?? "-"} ${r.body.text() ?? "?"}" }

let limited = rated(Rate { requests: 2, per: secs(10) })
for _i in 0..3 { println(shown(limited(asked("GET / HTTP/1.1", ""), (_q) -> text(200, "ok")))) }
println(
    shown(
        (held_to(Bounds { body: 8 }))(
            asked("POST /u HTTP/1.1", "Content-Length: 9\r\n"),
            (_q) -> text(200, "reached"),
        ),
    ),
)
let health = compiled(probes(() -> Readiness.NotReady("warming up")))
println(shown(dispatch(health, asked("GET /livez HTTP/1.1", ""))))
shown(dispatch(health, asked("GET /readyz HTTP/1.1", "")))
