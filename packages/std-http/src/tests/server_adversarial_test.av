//! The server loop under attack: every split of a request, the head
//! grown past its bounds, garbage, torn terminators, a client that
//! speaks and vanishes — each answered with a verdict and never a
//! wreck. The fixtures are the vertical suite's, grown by an attack.
use @std.net.{Conn, NetError, listen, connect}
use @std.time.{ms, secs, sleep}
use @std.http.frame.{limits, Limits}
use @std.http.http.{Request, Unrouted, Response, Header, text}
use @std.http.server.{Server, Timing, served, timing}

fn sized_echo(app: App, q: Request<Unrouted>) -> Response {
    let n = bumped(app)
    text(200, "${q.target() ?? "?"} ${gathered_length(q)} ${n}")
}

/// How long the request's body is, gathered whole — -1 when it could not be.
fn gathered_length(q: Request<Unrouted>) -> int {
    match q.body.gathered() { .Ok(b) -> b.length, .Err(_) -> -1 }
}

fn bed_under(lim: Limits, t: Timing) -> Result<Bed, NetError> { bed_with(sized_echo, lim, t) }

fn attacked() -> Result<Bed, NetError> { bed_under(limits(), timing()) }

fn status_line(got: Bytes) -> string {
    let t = got.text() ?? ""
    let end = t.index_of("\r\n")
    if end < 0 { t } else { t.substring(0, end) }
}

// ── Splits ──────────────────────────────────────────────────────

/// The same request sent one byte at a time: every read is a turn,
/// and the verdict is the unsplit one.
fn one_byte_reads() -> Result<bool, NetError> {
    let b = attacked()?
    spawn b.s.run(cores: 1)
    defer b.done()
    let req = "GET /s HTTP/1.1\r\nHost: a\r\n\r\n".bytes()
    mut got = "".bytes()
    for i in 0..req.length {
        got = got
            .concat(exchanged_bytes(b.c, req.slice(i, i + 1), if i == req.length - 1 { 1 } else { 0 })?)
    }
    .Ok(status_line(got) == "HTTP/1.1 200 OK" && (got.text() ?? "").ends_with("/s 0 1"))
}

/// The blank line torn at every one of its three seams.
fn torn_terminator() -> Result<bool, NetError> {
    mut all = true
    for cut in 1..4 {
        let b = attacked()?
        spawn b.s.run(cores: 1)
        defer b.done()
        let req = "GET /t HTTP/1.1\r\nHost: a\r\n\r\n"
        let head = req.substring(0, req.length - 4 + cut)
        let tail = req.substring(req.length - 4 + cut, req.length)
        let silent = unanswered(b.c, head.bytes())?
        let late = reply(b.c, tail)?
        all = all && silent && late.starts_with("HTTP/1.1 200 OK")
    }
    .Ok(all)
}

/// A body split at every byte across reads.
fn body_torn_everywhere() -> Result<bool, NetError> {
    mut all = true
    let body = "hello"
    for cut in 0..body.length + 1 {
        let b = attacked()?
        spawn b.s.run(cores: 1)
        defer b.done()
        let head = "POST /b HTTP/1.1\r\nHost: a\r\nContent-Length: 5\r\n\r\n" +
            body.substring(0, cut)
        let early = exchanged_bytes(b.c, head.bytes(), if cut == body.length { 1 } else { 0 })?
        let late = if cut == body.length { early } else { exchanged_bytes(b.c, body.substring(cut, body.length).bytes(), 1)? }
        all = all && (late.text() ?? "").ends_with("/b 5 1")
    }
    .Ok(all)
}

// ── Bounds ──────────────────────────────────────────────────────

fn head_too_large() -> Result<bool, NetError> {
    let b = bed_under(Limits { head: 200 }, timing())?
    spawn b.s.run(cores: 1)
    defer b.done()
    let filler = ["x" for i in 0..300].join("")
    let got = exchanged_bytes(
        b.c,
        "GET / HTTP/1.1\r\nHost: a\r\nX-Pad: ${filler}\r\n\r\n".bytes(),
        1000,
    )?
    .Ok(status_line(got) == "HTTP/1.1 431 Request Header Fields Too Large" && settles_to(b.s, 0))
}

fn body_too_large() -> Result<bool, NetError> {
    let b = bed_under(Limits { body: 4 }, timing())?
    spawn b.s.run(cores: 1)
    defer b.done()
    let got = exchanged_bytes(
        b.c,
        "POST / HTTP/1.1\r\nHost: a\r\nContent-Length: 5\r\n\r\nhello".bytes(),
        1000,
    )?
    .Ok(status_line(got) == "HTTP/1.1 413 Content Too Large" && settles_to(b.s, 0))
}

fn too_many_fields() -> Result<bool, NetError> {
    let b = bed_under(Limits { fields: 2 }, timing())?
    spawn b.s.run(cores: 1)
    defer b.done()
    let got = exchanged_bytes(
        b.c,
        "GET / HTTP/1.1\r\nHost: a\r\nA: 1\r\nB: 2\r\n\r\n".bytes(),
        1000,
    )?
    .Ok(status_line(got) == "HTTP/1.1 431 Request Header Fields Too Large")
}

fn requests_per_connection() -> Result<bool, NetError> {
    let b = bed_under(limits(), Timing { requests: 2 })?
    spawn b.s.run(cores: 1)
    defer b.done()
    let first = reply(b.c, "GET /1 HTTP/1.1\r\nHost: a\r\n\r\n")?
    let second = exchanged_bytes(b.c, "GET /2 HTTP/1.1\r\nHost: a\r\n\r\n".bytes(), 1000)?
    .Ok(
        !first.contains("connection: close") &&
            (second.text() ?? "").contains("connection: close\r\n") &&
            settles_to(b.s, 0),
    )
}

// ── Garbage ─────────────────────────────────────────────────────

fn garbage() -> Result<bool, NetError> {
    let b = attacked()?
    spawn b.s.run(cores: 1)
    defer b.done()
    let got = exchanged_bytes(b.c, [0, 255, 13, 10, 13, 10].bytes()!, 1000)?
    .Ok(status_line(got) == "HTTP/1.1 400 Bad Request" && settles_to(b.s, 0))
}

fn bare_lf() -> Result<bool, NetError> {
    let b = attacked()?
    spawn b.s.run(cores: 1)
    defer b.done()
    let got = exchanged_bytes(b.c, "GET / HTTP/1.1\nHost: a\n\n".bytes(), 1000)?
    .Ok(status_line(got) == "HTTP/1.1 400 Bad Request")
}

fn wrong_major() -> Result<bool, NetError> {
    let b = attacked()?
    spawn b.s.run(cores: 1)
    defer b.done()
    let got = exchanged_bytes(b.c, "GET / HTTP/2.0\r\nHost: a\r\n\r\n".bytes(), 1000)?
    .Ok(status_line(got) == "HTTP/1.1 505 HTTP Version Not Supported")
}

fn empty_write_then_request() -> Result<bool, NetError> {
    let b = attacked()?
    spawn b.s.run(cores: 1)
    defer b.done()
    let nothing = exchanged_bytes(b.c, "".bytes(), 0)?
    let r = reply(b.c, "GET /e HTTP/1.1\r\nHost: a\r\n\r\n")?
    .Ok(nothing.length == 0 && r.starts_with("HTTP/1.1 200 OK"))
}

// ── Peers that vanish ───────────────────────────────────────────

fn vanish_mid_head() -> Result<bool, NetError> {
    let b = attacked()?
    spawn b.s.run(cores: 1)
    defer b.done()
    let _ = b.c.write("GET /v HTTP/1.1\r\nHo".bytes())?
    let _ = b.c.close()?
    .Ok(settles_to(b.s, 0))
}

fn vanish_after_pipeline() -> Result<bool, NetError> {
    let b = attacked()?
    spawn b.s.run(cores: 1)
    defer b.done()
    let _ = b
        .c
        .write("GET /1 HTTP/1.1\r\nHost: a\r\n\r\nGET /2 HTTP/1.1\r\nHost: a\r\n\r\n".bytes())?
    let _ = b.c.shutdown_write()?
    let got = exchanged_bytes(b.c, "".bytes(), 1000)?
    let t = got.text() ?? ""
    .Ok(t.contains("/1 0 1") && t.contains("/2 0 2") && settles_to(b.s, 0))
}

fn head_then_silence_times_out() -> Result<bool, NetError> {
    let b = bed_under(limits(), Timing { head: ms(20) })?
    spawn b.s.run(cores: 1)
    defer b.done()
    let _ = exchanged_bytes(b.c, "GET /x HTTP/1.1\r\nHo".bytes(), 0)?
    let _ = exchanged_bytes(b.c, "".bytes(), 1)?
    .Ok(settles_to(b.s, 0))
}

fn two_clients() -> Result<bool, NetError> {
    let b = attacked()?
    spawn b.s.run(cores: 1)
    defer b.done()
    let other = connect("127.0.0.1", b.s.listener.port, secs(2))?
    defer { let _ = other.close() }
    let _ = other.write("GET /o HTTP/1.1\r\nHost: a\r\n\r\n".bytes())?
    let mine = reply(b.c, "GET /m HTTP/1.1\r\nHost: a\r\n\r\n")?
    let theirs = exchanged_bytes(other, "".bytes(), 1)?
    .Ok(mine.contains("/m 0") && (theirs.text() ?? "").contains("/o 0") && b.s.connections() == 2)
}

fn many_clients() -> Result<bool, NetError> {
    let b = attacked()?
    spawn b.s.run(cores: 1)
    defer b.done()
    let port = b.s.listener.port
    let others = [connect("127.0.0.1", port, secs(2))? for i in 0..200]
    defer { for o in others { let _ = o.close() } }
    for o in others { let _ = o.write("GET /w HTTP/1.1\r\nHost: a\r\n\r\n".bytes())? }
    let got = [replied_to(o) for o in others]
    let open = b.s.connections()
    let count = reply(b.c, "GET /n HTTP/1.1\r\nHost: a\r\n\r\n")?
    .Ok(count.ends_with("/n 0 201") && got.all(it) && open == 201)
}

fn replied_to(o: Conn) -> bool {
    match exchanged_bytes(o, "".bytes(), 1) { .Ok(got) -> got.length > 0, .Err(_) -> false }
}

fn splitting_echo(app: App, _q: Request<Unrouted>) -> Response {
    let _ = bumped(app)
    Response {
        status: 200,
        headers: [Header { name: "x", value: "1\r\nevil: 1" }],
        body: "hello".bytes(),
    }
}

fn answered_500(sent: string) -> Result<string, NetError> {
    let b = bed_with(splitting_echo, limits(), timing())?
    spawn b.s.run(cores: 1)
    defer b.done()
    let got = exchanged_bytes(b.c, sent.bytes(), 1)?
    .Ok(undated(got.text() ?? "<not text>").replace("\r\n", "|"))
}

/// A network answer that must equal `want`.
fn passes_with(r: Result<string, NetError>, want: string) -> bool {
    match r { .Ok(t) -> t == want, .Err(_) -> false }
}

spec "std.http server adversarial" {
    given "a handler that answers what no peer could read" {
        then "A GET gets the server's own 500, whole" {
            passes_with(
                answered_500("GET /a HTTP/1.1\r\nHost: h\r\n\r\n"),
                "HTTP/1.1 500 Internal Server Error|content-length: 0||",
            )
        }
        then "AND SO DOES A HEAD — the body it strips is the WRITTEN response's, never the handler's" {
            passes_with(
                answered_500("HEAD /a HTTP/1.1\r\nHost: h\r\n\r\n"),
                "HTTP/1.1 500 Internal Server Error|content-length: 0||",
            )
        }
    }
    given "every split" {

        then "a request in one-byte reads is the unsplit verdict" { passes(one_byte_reads()) }
        then "a terminator torn at each of its seams completes, never refuses" { passes(torn_terminator()) }
        then "a body torn at every byte is gathered whole" { passes(body_torn_everywhere()) }
    }
    given "the bounds" {
        then "a head past its bound is 431 and the connection closes" { passes(head_too_large()) }
        then "a body past its bound is 413 and the connection closes" { passes(body_too_large()) }
        then "too many fields is 431" { passes(too_many_fields()) }
        then "the last permitted request carries connection: close" { passes(requests_per_connection()) }
    }
    given "garbage" {
        then "bytes that frame nothing are 400 and closed" { passes(garbage()) }
        then "bare LF is 400" { passes(bare_lf()) }
        then "HTTP/2.0 is 505" { passes(wrong_major()) }
        then "an empty write is not a request" { passes(empty_write_then_request()) }
    }
    given "peers that vanish" {
        then "a peer gone mid-head is dropped" { passes(vanish_mid_head()) }
        then "a peer gone after pipelining gets both answers" { passes(vanish_after_pipeline()) }
        then "a head that stalls past its deadline is dropped" { passes(head_then_silence_times_out()) }
        then "two clients are served apart" { passes(two_clients()) }
        then "two hundred clients at once are each accepted and answered" { passes(many_clients()) }
    }
}
