// The router: a route is a grammar over the FRAMED target, each
// handler keeps its own record, and one compiled table holds routes
// whose records differ. A target nothing answers is a 404 — a value.
// The adversarial half of this story is route_adversarial_test.av.
use @std.http.frame.{Method}
use @std.http.http.{Request, Unrouted, Response, text}
use @std.http.route.{Route, routed, fixed, tailed, compiled, dispatch, faults}

grammar Idea = "/ideas/{id}"
grammar Search = "/search/{term}/{page}"
grammar Static = "/static/{path...}"
grammar Png = "/img/{path...}.png"

fn serve_idea(q: Request<Idea>) -> Response { text(200, "idea " + q.params.id) }
fn serve_search(q: Request<Search>) -> Response { text(200, "search " + q.params.term + " " + q.params.page) }
fn serve_gone(_q: Request<Idea>) -> Response { Response { status: 410 } }
fn serve_static(q: Request<Static>) -> Response { text(200, "static " + q.params.path) }
fn serve_png(q: Request<Png>) -> Response { text(200, "png " + q.params.path) }
fn serve_word(_q: Request<Unrouted>) -> Response { text(200, "word") }

fn r_static() -> Route { tailed<Static>(Method.Get, "/static/{path...}", (t: Bytes) -> Static.parse(t), serve_static) }
fn r_png() -> Route { tailed<Png>(Method.Get, "/img/{path...}.png", (t: Bytes) -> Png.parse(t), serve_png) }

/// What a table of these routes answers for a target.
fn answer_of(rows: List<Route>, line: string) -> string {
    let q? = asked(line) else { return "unframed" }
    let r = dispatch(compiled(rows), q)
    "${r.status} ${r.body.text() ?? ""}"
}

fn routes() -> List<Route> {
    [
        routed<Idea>(Method.Get, "/ideas/{id}", (t: Bytes) -> Idea.parse(t), serve_idea),
        routed<Search>(
            Method.Get,
            "/search/{term}/{page}",
            (t: Bytes) -> Search.parse(t),
            serve_search,
        ),
    ]
}

/// The status and body a target earns, or "unframed" when the framer
/// refused the line before the router ever saw it.
fn answered(line: string) -> string { answer_of(routes(), line) }

spec "@std.http route" {
    given "a table of routes whose records differ" {
        then "each route answers through its own typed handler" {
            answered("GET /ideas/7 HTTP/1.1") == "200 idea 7"
        }
        then "the second route reads a record of a different type" {
            answered("GET /search/cats/2 HTTP/1.1") == "200 search cats 2"
        }
        then "a target nothing answers is a 404, and a value" {
            answered("GET /nowhere HTTP/1.1") == "404 "
        }
        then "a target that is one segment short does not match" {
            answered("GET /search/cats HTTP/1.1") == "404 "
        }
        then "a target with an extra segment does not match" {
            answered("GET /ideas/7/extra HTTP/1.1") == "404 "
        }
        then "an empty capture still matches, because a hole may take nothing" {
            answered("GET /ideas/ HTTP/1.1") == "200 idea "
        }
        then "the method is part of the match" {
            answered("POST /ideas/7 HTTP/1.1") == "404 "
        }
        then "a HEAD no HEAD route answers is answered by its GET route" {
            answered("HEAD /ideas/7 HTTP/1.1") == "200 idea 7"
        }
        then "a HEAD route answers its HEAD before the GET route does, in either order" {
            let head = fixed(Method.Head, "/ideas/7", (_q: Request<Unrouted>) -> text(200, "head"))
            answer_of(routes().concat([head]), "HEAD /ideas/7 HTTP/1.1") == "200 head" &&
                answer_of([head].concat(routes()), "HEAD /ideas/7 HTTP/1.1") == "200 head"
        }
        then "a HEAD with no GET route beside it is still a 404" {
            answered("HEAD /nowhere HTTP/1.1") == "404 " &&
                answer_of([fixed(Method.Post, "/p", serve_word)], "HEAD /p HTTP/1.1") == "404 "
        }
    }
    given "a handler's own 404" {

        then "a handler answering 410 is its answer, not a miss" {
            dispatch(
                compiled(
                    [
                        routed<Idea>(
                            Method.Get,
                            "/ideas/{id}",
                            (t: Bytes) -> Idea.parse(t),
                            serve_gone,
                        ),
                    ],
                ),
                asked("GET /ideas/7 HTTP/1.1")!,
            )
                .status == 410
        }
        then "a route that does not match still falls through to the next" {
            dispatch(
                compiled(
                    [
                        routed<Search>(
                            Method.Get,
                            "/search/{term}/{page}",
                            (t: Bytes) -> Search.parse(t),
                            serve_search,
                        ),
                        routed<Idea>(
                            Method.Get,
                            "/ideas/{id}",
                            (t: Bytes) -> Idea.parse(t),
                            serve_idea,
                        ),
                    ],
                ),
                asked("GET /ideas/7 HTTP/1.1")!,
            )
                .status == 200
        }
    }
    given "the law over a table" {

        then "two routes of one shape are named, later first" {
            faults(
                [
                    routed<Idea>(Method.Get, "/ideas/{id}", (t: Bytes) -> Idea.parse(t), serve_idea),
                    routed<Idea>(
                        Method.Get,
                        "/ideas/{slug}",
                        (t: Bytes) -> Idea.parse(t),
                        serve_gone,
                    ),
                ],
            )
                .length == 1
        }
        then "the refusal names both patterns and says which is unreachable" {
            let found = faults(
                [
                    routed<Idea>(Method.Get, "/ideas/{id}", (t: Bytes) -> Idea.parse(t), serve_idea),
                    routed<Idea>(
                        Method.Get,
                        "/ideas/{slug}",
                        (t: Bytes) -> Idea.parse(t),
                        serve_gone,
                    ),
                ],
            )
            found[0] == "`/ideas/{slug}` is unreachable — `/ideas/{id}` is declared above it and matches every target it does"
        }
        then "routes of different shapes do not conflict" {
            faults(routes()).is_empty()
        }
        then "one shape under two methods is two routes, not a conflict" {
            faults(
                [
                    routed<Idea>(Method.Get, "/ideas/{id}", (t: Bytes) -> Idea.parse(t), serve_idea),
                    routed<Idea>(
                        Method.Post,
                        "/ideas/{id}",
                        (t: Bytes) -> Idea.parse(t),
                        serve_gone,
                    ),
                ],
            )
                .is_empty()
        }
    }
    given "a route matches the path, and the query rides beside it" {

        then "a query does not join the capture" {
            answered("GET /ideas/7?q=x HTTP/1.1") == "200 idea 7"
        }
        then "A `/` INSIDE THE QUERY IS NOT A SEGMENT, so the route still matches" {
            answered("GET /ideas/7?redirect=/home HTTP/1.1") == "200 idea 7"
        }
        then "a query of several pairs changes nothing about the match" {
            answered("GET /ideas/7?a=1&b=2&c=3 HTTP/1.1") == "200 idea 7"
        }
        then "a bare `?` leaves the capture whole" {
            answered("GET /ideas/7? HTTP/1.1") == "200 idea 7"
        }
        then "the query cannot make a target match a route it does not" {
            answered("GET /nowhere?q=/ideas/7 HTTP/1.1") == "404 "
        }
    }
    given "a route that takes the rest" {

        then "it matches at its own width, binding one segment" {
            answer_of([r_static()], "GET /static/app.css HTTP/1.1") == "200 static app.css"
        }
        then "IT MATCHES DEEPER, and the hole holds every segment past its own" {
            answer_of([r_static()], "GET /static/css/app.css HTTP/1.1") == "200 static css/app.css"
        }
        then "it keeps holding however deep the target goes" {
            answer_of([r_static()], "GET /static/a/b/c/d/e.css HTTP/1.1") == "200 static a/b/c/d/e.css"
        }
        then "it does not match a target narrower than itself" {
            answer_of([r_static()], "GET /static HTTP/1.1") == "404 "
        }
        then "an empty capture at its own width is still a capture" {
            answer_of([r_static()], "GET /static/ HTTP/1.1") == "200 static "
        }
        then "a target under another prefix is not its own" {
            answer_of([r_static()], "GET /other/a/b HTTP/1.1") == "404 "
        }
        then "a rest-taking route may anchor its own end" {
            answer_of([r_png()], "GET /img/a/b/logo.png HTTP/1.1") == "200 png a/b/logo"
        }
        then "and the anchor still refuses what does not end that way" {
            answer_of([r_png()], "GET /img/a/b/logo.jpg HTTP/1.1") == "404 "
        }
        then "A ROUTE OF FIXED WIDTH IS STILL REFUSED A DEEPER TARGET, tails in the table or not" {
            answer_of([r_static(), routes()[0]], "GET /ideas/7/extra HTTP/1.1") == "404 "
        }
        then "declaration order decides between a rest-taker and a path it covers" {
            answer_of(
                [r_static(), fixed(Method.Get, "/static/logo.svg", serve_word)],
                "GET /static/logo.svg HTTP/1.1",
            ) == "200 static logo.svg"
        }
        then "and reversing them reverses the answer" {
            answer_of(
                [fixed(Method.Get, "/static/logo.svg", serve_word), r_static()],
                "GET /static/logo.svg HTTP/1.1",
            ) == "200 word"
        }
    }
    given "what the law says about a rest-taker" {

        then "A DOOR THAT TAKES THE REST NEEDS A PATTERN THAT SAYS SO" {
            faults(
                [
                    tailed<Static>(
                        Method.Get,
                        "/static/files",
                        (t: Bytes) -> Static.parse(t),
                        serve_static,
                    ),
                ],
            )[0] == "`/static/files` is declared to take the rest and its last hole does not say so — write `{name...}`, which is what its grammar spells too"
        }
        then "and a pattern without the mark is named even when it has a hole" {
            faults(
                [
                    tailed<Static>(
                        Method.Get,
                        "/static/{path}",
                        (t: Bytes) -> Static.parse(t),
                        serve_static,
                    ),
                ],
            )
                .length == 1
        }
        then "A PATTERN THAT SPELLS THE REST NEEDS A DOOR THAT TAKES IT" {
            faults(
                [
                    routed<Static>(
                        Method.Get,
                        "/static/{path...}",
                        (t: Bytes) -> Static.parse(t),
                        serve_static,
                    ),
                ],
            )[0] == "`/static/{path...}` spells a hole that takes the rest and the route was declared for one width — declare it with `tailed`, or drop the `...`"
        }
        then "a static path holding the three dots is neither, because its braces are octets" {
            faults([fixed(Method.Get, "/static/{a...}", serve_word)]).is_empty()
        }
        then "a mark on a hole that is not last is a greedy hole, not a claim on the rest" {
            faults(
                [
                    routed<Search>(
                        Method.Get,
                        "/search/{term...}/{page}",
                        (t: Bytes) -> Search.parse(t),
                        serve_search,
                    ),
                ],
            )
                .is_empty()
        }
        then "a rest-taker shadows a deeper path below it" {
            faults([r_static(), fixed(Method.Get, "/static/logo.svg", serve_word)])[0] == "`/static/logo.svg` is unreachable — `/static/{path...}` is declared above it and matches every target it does"
        }
        then "it shadows a route of greater width too, because it reaches every width" {
            faults(
                [
                    r_static(),
                    routed<Search>(
                        Method.Get,
                        "/static/{term}/{page}",
                        (t: Bytes) -> Search.parse(t),
                        serve_search,
                    ),
                ],
            )
                .length == 1
        }
        then "a path above a rest-taker is reachable" {
            faults([fixed(Method.Get, "/static/logo.svg", serve_word), r_static()]).is_empty()
        }
        then "NO ROUTE OF FIXED WIDTH CAN SHADOW A REST-TAKER — there is always a deeper target" {
            faults(
                [
                    routed<Idea>(Method.Get, "/static/{x}", (t: Bytes) -> Idea.parse(t), serve_idea),
                    r_static(),
                ],
            )
                .is_empty()
        }
        then "a rest-taker anchoring its own end shadows nothing it does not reach" {
            faults([r_png(), fixed(Method.Get, "/img/a/b.jpg", serve_word)]).is_empty()
        }
        then "two rest-takers of one shape are named" {
            faults(
                [
                    r_static(),
                    tailed<Static>(
                        Method.Get,
                        "/static/{rest...}",
                        (t: Bytes) -> Static.parse(t),
                        serve_static,
                    ),
                ],
            )
                .length == 1
        }
    }
}
