// The RFC 7541 C.6 responses decoded in turn, then re-encoded by a
// fresh encoder: the lists, the tables and the octets agree in both
// engines.
use @std.http.hpack.{HeaderField, decoder, encoder, dynamic_table, HpackEncoder}
use @std.http.frame.{hex_of}

fn octets_of(s: string) -> Bytes {
    let b = s.bytes()
    [hex_of(b.at(2 * i))! * 16 + hex_of(b.at(2 * i + 1))! for i in 0..b.length / 2].bytes()!
}

fn line(f: HeaderField) -> string { "  ${f.name.text() ?? "?"}: ${f.value.text() ?? "?"}" }

const blocks: List<string> = [
    "488264025885aec3771a4b6196d07abe941054d444a8200595040b8166e082a62d1bff6e919d29ad171863c78f0b97c8e9ae82ae43d3",
    "4883640effc1c0bf",
    "88c16196d07abe941054d444a8200595040b8166e084a62d1bffc05a839bd9ab77ad94e7821dd7f2e6c7b335dfdfcd5b3960d5af27087f3672c1ab270fb5291f9587316065c003ed4ee5b1063d5007",
]

mut d = decoder(256, 65536)
mut e = HpackEncoder {
    dynamic: dynamic_table(256),
    huffman: true,
    cap: 256,
    least: 256,
    announce: false,
}
mut out: List<string> = []
for b in blocks {
    match d.decoded(octets_of(b)) {
        .Fields(fs) -> {
            out
                .push(
                    "block of ${fs.length}, table ${d.dynamic.size}, re-encoded alike: ${e.encoded(fs) == octets_of(b)}",
                )
            out = out.concat([line(f) for f in fs])
        },
        .TooLarge -> { out.push("too large") },
        .Refused(_) -> { out.push("refused") },
    }
}
out.join("\n")
