// HTTP/2 framing and connection laws (RFC 9113): each case feeds a
// server connection the client's octets and reads what it owes back.
// A law broken on a stream answers RST_STREAM with its code; a law
// broken on the connection answers GOAWAY with its code.
use @std.http.h2.{
    H2Conn,
    Frame,
    FrameAt,
    FrameKind,
    Exchange,
    H2Error,
    h2_server,
    frame_at,
    frame_bytes,
    error_code,
    preface,
    u32_bytes,
    u32_at,
    end_stream,
    end_headers,
    padded,
    prioritised,
    ack,
    request_head_kept,
    frames_in,
}
use @std.http.hpack.{HeaderField, header_field, encoder, integer}
use @std.http.frame.{limits, Limits, no_bytes}

/// A header block of literals only, so it reads alike against any
/// decoder state.
fn block_of(fs: List<HeaderField>) -> Bytes {
    mut e = encoder(false)
    e.encoded(fs)
}

fn get_head(path: string) -> List<HeaderField> {
    [
        header_field(":method", "GET"),
        header_field(":scheme", "http"),
        header_field(":path", path),
        header_field(":authority", "a"),
    ]
}

fn h2_posted(n: int) -> List<HeaderField> {
    [
        header_field(":method", "POST"),
        header_field(":scheme", "http"),
        header_field(":path", "/p"),
        header_field(":authority", "a"),
        header_field("content-length", "${n}"),
    ]
}

/// A HEADERS frame carrying `fs` whole, with `flags` beside END_HEADERS.
fn heads(id: int, fs: List<HeaderField>, flags: int) -> Bytes { frame_bytes(.Headers, end_headers | flags, id, block_of(fs)) }

/// A GET on stream `id`, ending it.
fn get_on(id: int) -> Bytes { heads(id, get_head("/s${id}"), end_stream) }

fn data_on(id: int, body: string, flags: int) -> Bytes { frame_bytes(.Data, flags, id, body.bytes()) }

fn settings_of(rows: List<List<int>>) -> Bytes {
    frame_bytes(
        .Settings,
        0,
        0,
        [[(r[0] >> 8) & 255, r[0] & 255].bytes()!.concat(u32_bytes(r[1])) for r in rows].bytes(),
    )
}

/// What a client sends first: the preface and an empty SETTINGS.
fn hello_bytes() -> Bytes { preface.concat(frame_bytes(.Settings, 0, 0, no_bytes)) }

/// A server connection fed the client's hello and then `frames`.
fn conn_after(frames: List<Bytes>) -> H2Conn { conn_with(limits(), frames) }

fn conn_with(l: Limits, frames: List<Bytes>) -> H2Conn {
    mut c = h2_server(l)
    let b = hello_bytes().concat(frames.bytes())
    let _ = c.fed(b, 0)
    c
}

/// The code of the GOAWAY the connection owes, or -1.
fn goaway_of(c: H2Conn) -> int {
    let g? = frames_in(c.out).find(it.kind is .GoAway) else { return -1 }
    u32_at(g.payload, 4)
}

/// The code of the RST_STREAM owed on `id`, or -1.
fn reset_of(c: H2Conn, id: int) -> int {
    let r? = frames_in(c.out).find(it.kind is .Reset && it.stream == id) else { return -1 }
    u32_at(r.payload, 0)
}

fn code(e: H2Error) -> int { error_code(e) }

/// How many RST_STREAMs the connection owes.
fn resets_owed(c: H2Conn) -> int { kinds_owed(c, .Reset) }

/// The connection is whole: no GOAWAY owed.
fn alive(c: H2Conn) -> bool { goaway_of(c) == -1 && !c.closing }

/// The one frame of `kind` owed, or absent.
fn owed_one(c: H2Conn, kind: FrameKind) -> Frame? { frames_in(c.out).find(it.kind == kind) }

fn kinds_owed(c: H2Conn, kind: FrameKind) -> int { frames_in(c.out).filter(it.kind == kind).length }

/// The path of each request the connection completed.
fn paths_ready(c: H2Conn) -> string {
    [r.fields.find(it.name == ":path".bytes())?.value?.text() ?? "?" for r in c.ready].join(",")
}

spec "std.http h2" {
    given "the preface and the first SETTINGS (§3.4, §6.5)" {
        then "the server owes its SETTINGS before it reads a byte: 100 streams, the 1.1 head as the list bound" {
            let c = h2_server(limits())
            let s = frames_in(c.out)
            s.length == 1 &&
                s[0].kind == FrameKind.Settings &&
                s[0].payload == [0, 2].bytes()!
                    .concat(u32_bytes(0))
                    .concat([0, 3].bytes()!)
                    .concat(u32_bytes(100))
                    .concat([0, 6].bytes()!)
                    .concat(u32_bytes(65536))
        }
        then "a wrong preface ends the connection with PROTOCOL_ERROR" {
            mut c = h2_server(limits())
            let _ = c.fed("GET / HTTP/1.1\r\nHost: a\r\n\r\n".bytes(), 0)
            goaway_of(c) == code(.Protocol)
        }
        then "a preface torn across reads is waited for" {
            mut c = h2_server(limits())
            let whole = hello_bytes()
            let first = c.fed(whole.slice(0, 10), 0)
            let second = c.fed(whole, first)
            first == 0 && second == whole.length && alive(c) && c.settled
        }
        then "a first frame that is not SETTINGS is a PROTOCOL_ERROR" {
            mut c = h2_server(limits())
            let _ = c
                .fed(preface.concat(frame_bytes(.Ping, 0, 0, u32_bytes(0).concat(u32_bytes(0)))), 0)
            goaway_of(c) == code(.Protocol)
        }
        then "a first SETTINGS that is an ACK is a PROTOCOL_ERROR" {
            mut c = h2_server(limits())
            let _ = c.fed(preface.concat(frame_bytes(.Settings, ack, 0, no_bytes)), 0)
            goaway_of(c) == code(.Protocol)
        }
        then "the client's SETTINGS is acknowledged" {
            let c = conn_after([])
            frames_in(c.out)
                .any(it.kind == FrameKind.Settings && it.flags == ack && it.payload.is_empty())
        }
    }
    given "SETTINGS (§6.5)" {
        then "a length that is not a multiple of six is a FRAME_SIZE_ERROR" {
            goaway_of(conn_after([frame_bytes(.Settings, 0, 0, [0, 3, 0].bytes()!)])) == code(.FrameSize)
        }
        then "an ACK with a payload is a FRAME_SIZE_ERROR" {
            goaway_of(
                conn_after([frame_bytes(.Settings, ack, 0, u32_bytes(0).concat([0, 0].bytes()!))]),
            ) == code(.FrameSize)
        }
        then "SETTINGS on a stream is a PROTOCOL_ERROR" {
            goaway_of(conn_after([frame_bytes(.Settings, 0, 1, no_bytes)])) == code(.Protocol)
        }
        then "ENABLE_PUSH other than 0 or 1 is a PROTOCOL_ERROR" { goaway_of(conn_after([settings_of([[2, 2]])])) == code(.Protocol) }
        then "an initial window past 2^31-1 is a FLOW_CONTROL_ERROR" {
            goaway_of(conn_after([settings_of([[4, 2147483648]])])) == code(.FlowControl) &&
                alive(conn_after([settings_of([[4, 2147483647]])]))
        }
        then "a frame size outside 2^14 .. 2^24-1 is a PROTOCOL_ERROR" {
            goaway_of(conn_after([settings_of([[5, 16383]])])) == code(.Protocol) &&
                goaway_of(conn_after([settings_of([[5, 16777216]])])) == code(.Protocol) &&
                alive(conn_after([settings_of([[5, 16777215]])]))
        }
        then "an unknown setting is ignored" { alive(conn_after([settings_of([[255, 7]])])) }
        then "the peer's settings are held" {
            let c = conn_after([settings_of([[4, 100], [5, 20000], [3, 7]])])
            c.theirs.window == 100 && c.theirs.frame == 20000 && c.theirs.streams == 7
        }
    }
    given "frames (§4, §5.5, §6.7, §6.8)" {
        then "a frame longer than the advertised size is a FRAME_SIZE_ERROR, read from its head alone" {
            let head = [0, 64, 1, 0, 0, 0, 0, 0, 1].bytes()!
            goaway_of(conn_after([head])) == code(.FrameSize)
        }
        then "a frame of an unknown type is ignored" { alive(conn_after([frame_bytes(.Unknown, 255, 1, "x".bytes())])) }
        then "a PING is answered with an ACK carrying its payload" {
            let p = u32_bytes(7).concat(u32_bytes(9))
            let c = conn_after([frame_bytes(.Ping, 0, 0, p)])
            frames_in(c.out).any(it.kind == FrameKind.Ping && it.flags == ack && it.payload == p)
        }
        then "a PING ACK is not answered" {
            kinds_owed(
                conn_after([frame_bytes(.Ping, ack, 0, u32_bytes(0).concat(u32_bytes(0)))]),
                .Ping,
            ) == 0
        }
        then "a PING of seven octets is a FRAME_SIZE_ERROR" {
            goaway_of(conn_after([frame_bytes(.Ping, 0, 0, [0, 0, 0, 0, 0, 0, 0].bytes()!)])) == code(.FrameSize)
        }
        then "a PING on a stream is a PROTOCOL_ERROR" {
            goaway_of(conn_after([frame_bytes(.Ping, 0, 1, u32_bytes(0).concat(u32_bytes(0)))])) == code(.Protocol)
        }
        then "a GOAWAY from the peer is read past: a PING after it is still answered" {
            let bye = frame_bytes(.GoAway, 0, 0, u32_bytes(0).concat(u32_bytes(0)))
            let c = conn_after([bye, frame_bytes(.Ping, 0, 0, u32_bytes(1).concat(u32_bytes(2)))])
            c.parting &&
                !c.closing &&
                frames_in(c.out).any(it.kind == FrameKind.Ping && it.flags == ack)
        }
        then "a parting peer's open streams are answered before this end says GOAWAY" {
            mut c = conn_after(
                [get_on(1), frame_bytes(.GoAway, 0, 0, u32_bytes(1).concat(u32_bytes(0)))],
            )
            c.parted_when_quiet()
            let early = goaway_of(c)
            c.respond(1, [header_field(":status", "204")], no_bytes)
            c.parted_when_quiet()
            early == -1 && goaway_of(c) == code(.NoError) && c.closing
        }
        then "a PUSH_PROMISE from a client is a PROTOCOL_ERROR" {
            goaway_of(conn_after([frame_bytes(.PushPromise, end_headers, 1, u32_bytes(2))])) == code(.Protocol)
        }
        then "a torn frame waits for its rest, and the offset says where it begins" {
            mut c = h2_server(limits())
            let b = hello_bytes().concat(get_on(1))
            let at = c.fed(b.slice(0, b.length - 3), 0)
            let end = c.fed(b, at)
            at == hello_bytes().length && end == b.length && paths_ready(c) == "/s1"
        }
    }
    given "HEADERS and stream ids (§5.1.1, §6.2)" {
        then "a GET that ends its stream is a request, head and all" { paths_ready(conn_after([get_on(1)])) == "/s1" }
        then "three streams complete in order" { paths_ready(conn_after([get_on(1), get_on(3), get_on(5)])) == "/s1,/s3,/s5" }
        then "HEADERS on stream 0 is a PROTOCOL_ERROR" { goaway_of(conn_after([get_on(0)])) == code(.Protocol) }
        then "HEADERS on an even stream is a PROTOCOL_ERROR" { goaway_of(conn_after([get_on(2)])) == code(.Protocol) }
        then "a stream id below one already opened is a PROTOCOL_ERROR" {
            goaway_of(conn_after([get_on(5), get_on(3)])) == code(.Protocol)
        }
        then "HEADERS on a stream the peer already ended is STREAM_CLOSED" {
            let c = conn_after([get_on(1), get_on(1)])
            reset_of(c, 1) == code(.StreamClosed) && alive(c)
        }
        then "a padded HEADERS is read without its padding" {
            let b = block_of(get_head("/pad"))
            let body = [3].bytes()!.concat(b).concat([0, 0, 0].bytes()!)
            paths_ready(
                conn_after([frame_bytes(.Headers, end_headers | end_stream | padded, 1, body)]),
            ) == "/pad"
        }
        then "a HEADERS with priority is read past its five octets" {
            let body = u32_bytes(0).concat([15].bytes()!).concat(block_of(get_head("/pri")))
            paths_ready(
                conn_after([frame_bytes(.Headers, end_headers | end_stream | prioritised, 1, body)]),
            ) == "/pri"
        }
        then "a HEADERS that depends on its own stream is a stream PROTOCOL_ERROR" {
            let body = u32_bytes(1).concat([15].bytes()!).concat(block_of(get_head("/")))
            let c = conn_after(
                [frame_bytes(.Headers, end_headers | end_stream | prioritised, 1, body)],
            )
            reset_of(c, 1) == code(.Protocol) && alive(c) && c.ready.is_empty()
        }
        then "a stream past the concurrency bound is REFUSED_STREAM" {
            let c = conn_after([heads(2 * i + 1, get_head("/"), 0) for i in 0..101])
            reset_of(c, 201) == code(.RefusedStream) && reset_of(c, 199) == -1 && alive(c)
        }
        then "a stream reset while the server answers it holds its place in the bound until released" {
            mut c = conn_after([heads(2 * i + 1, get_head("/"), 0) for i in 0..99])
            let _ = c.taken()
            let _ = c
                .fed([frame_bytes(.Reset, 0, 2 * i + 1, u32_bytes(8)) for i in 0..99].bytes(), 0)
            let _ = c.fed(heads(199, get_head("/"), 0).concat(heads(201, get_head("/"), 0)), 0)
            let full = reset_of(c, 199) == -1 && reset_of(c, 201) == code(.RefusedStream)
            c.released(1)
            let _ = c.fed(heads(203, get_head("/"), 0), 0)
            full && reset_of(c, 203) == -1 && alive(c) && c.orphans.length == 98
        }
        then "a stream closed out of order leaves every other live stream found at its own place" {
            mut c = conn_after([heads(2 * i + 1, get_head("/"), 0) for i in 0..4])
            let _ = c
                .fed(
                    [
                        frame_bytes(.Reset, 0, 3, u32_bytes(8)),
                        frame_bytes(.Reset, 0, 1, u32_bytes(8)),
                    ]
                        .bytes(),
                    0,
                )
            ["${s.id}" for s in c.streams].join(",") == ["${i}" for i in c.ids].join(",") &&
                c.live(5) &&
                c.live(7) &&
                !c.live(1) &&
                !c.live(3) &&
                c.ids.length == 2
        }
        then "a malformed header block is a COMPRESSION_ERROR" {
            goaway_of(
                conn_after([frame_bytes(.Headers, end_headers | end_stream, 1, [128].bytes()!)]),
            ) == code(.Compression)
        }
    }
    given "CONTINUATION (§6.10)" {
        then "a head split across HEADERS and CONTINUATIONs is one request" {
            let b = block_of(get_head("/split"))
            let c = conn_after(
                [
                    frame_bytes(.Headers, end_stream, 1, b.slice(0, 3)),
                    frame_bytes(.Continuation, 0, 1, b.slice(3, 7)),
                    frame_bytes(.Continuation, end_headers, 1, b.slice(7, b.length)),
                ],
            )
            paths_ready(c) == "/split"
        }
        then "any other frame inside a header block is a PROTOCOL_ERROR" {
            let b = block_of(get_head("/"))
            goaway_of(
                conn_after(
                    [
                        frame_bytes(.Headers, end_stream, 1, b),
                        frame_bytes(.Ping, 0, 0, u32_bytes(0).concat(u32_bytes(0))),
                    ],
                ),
            ) == code(.Protocol)
        }
        then "a CONTINUATION on another stream is a PROTOCOL_ERROR" {
            let b = block_of(get_head("/"))
            goaway_of(
                conn_after(
                    [
                        frame_bytes(.Headers, end_stream, 1, b),
                        frame_bytes(.Continuation, end_headers, 3, no_bytes),
                    ],
                ),
            ) == code(.Protocol)
        }
        then "a CONTINUATION with no header block open is a PROTOCOL_ERROR" {
            goaway_of(conn_after([get_on(1), frame_bytes(.Continuation, end_headers, 1, no_bytes)])) == code(.Protocol)
        }
        then "a flood of empty CONTINUATIONs is ENHANCE_YOUR_CALM at the bound" {
            let b = block_of(get_head("/"))
            let flood = [frame_bytes(.Continuation, 0, 1, no_bytes) for i in 0..64]
            goaway_of(conn_after([frame_bytes(.Headers, end_stream, 1, b)].concat(flood))) == code(.EnhanceYourCalm)
        }
        then "a header block past the list bound in CONTINUATIONs is ENHANCE_YOUR_CALM" {
            let b = block_of(get_head("/"))
            let big = [frame_bytes(.Continuation, 0, 1, [97 for i in 0..16000].bytes()!) for j in 0..5]
            goaway_of(conn_after([frame_bytes(.Headers, end_stream, 1, b)].concat(big))) == code(.EnhanceYourCalm)
        }
    }
    given "DATA and the body (§6.1, §8.1.1)" {
        then "a POST's DATA is its body, charged to the connection's window" {
            mut c = conn_after(
                [heads(1, h2_posted(5), 0), data_on(1, "hel", 0), data_on(1, "lo", end_stream)],
            )
            c.ready.length == 1 &&
                kinds_owed(c, .WindowUpdate) == 0 &&
                c.recv == 65530 &&
                taken_text(c, 1) == "hello ended"
        }
        then "DATA on stream 0 is a PROTOCOL_ERROR" { goaway_of(conn_after([data_on(0, "x", 0)])) == code(.Protocol) }
        then "DATA on an idle stream is a PROTOCOL_ERROR" { goaway_of(conn_after([data_on(1, "x", 0)])) == code(.Protocol) }
        then "DATA after the stream ended is STREAM_CLOSED on the stream" {
            let c = conn_after([get_on(1), data_on(1, "x", 0)])
            reset_of(c, 1) == code(.StreamClosed) && alive(c)
        }
        then "DATA on a stream the peer reset is STREAM_CLOSED on the stream" {
            let c = conn_after(
                [
                    heads(1, h2_posted(1), 0),
                    frame_bytes(.Reset, 0, 1, u32_bytes(8)),
                    data_on(1, "x", 0),
                ],
            )
            reset_of(c, 1) == code(.StreamClosed) && alive(c)
        }
        then "DATA or HEADERS on a stream that ended both ways is STREAM_CLOSED on the connection" {
            mut c = conn_after([get_on(1)])
            c.respond(1, [header_field(":status", "204")], no_bytes)
            let _ = c.fed(data_on(1, "x", 0), 0)
            mut d = conn_after([get_on(1)])
            d.respond(1, [header_field(":status", "204")], no_bytes)
            let _ = d.fed(get_on(1), 0)
            goaway_of(c) == code(.StreamClosed) && goaway_of(d) == code(.StreamClosed)
        }
        then "HEADERS on a stream the peer reset is STREAM_CLOSED on the stream" {
            let c = conn_after(
                [heads(1, h2_posted(1), 0), frame_bytes(.Reset, 0, 1, u32_bytes(8)), get_on(1)],
            )
            reset_of(c, 1) == code(.StreamClosed) && alive(c)
        }
        then "frames in flight to a stream this end reset are ignored" {
            let c = conn_after(
                [
                    heads(1, get_head("/").concat([header_field("Bad", "x")]), 0),
                    data_on(1, "x", 0),
                    get_on(1),
                ],
            )
            reset_of(c, 1) == code(.Protocol) && alive(c)
        }
        then "padding that claims the whole frame is a PROTOCOL_ERROR" {
            goaway_of(
                conn_after(
                    [
                        heads(1, h2_posted(1), 0),
                        frame_bytes(.Data, padded, 1, [4, 1, 2, 3].bytes()!),
                    ],
                ),
            ) == code(.Protocol)
        }
        then "padded DATA is gathered without its padding" {
            mut c = conn_after(
                [
                    heads(1, h2_posted(2), 0),
                    frame_bytes(.Data, padded | end_stream, 1, [2, 104, 105, 0, 0].bytes()!),
                ],
            )
            taken_text(c, 1) == "hi ended"
        }
        then "a body shorter or longer than its content-length resets the stream" {
            reset_of(conn_after([heads(1, h2_posted(5), 0), data_on(1, "abc", end_stream)]), 1) == code(.Protocol) &&
                reset_of(conn_after([heads(1, h2_posted(1), 0), data_on(1, "abc", end_stream)]), 1) == code(.Protocol)
        }
        then "the request is ready once its head is here, before any of its body" {
            conn_after([heads(1, h2_posted(5), 0)]).ready.length == 1
        }
        then "octets nobody took hold the stream's window shut; taking them gives it back" {
            let frame = frame_bytes(.Data, 0, 1, [97 for i in 0..16384].bytes()!)
            mut c = conn_after([heads(1, h2_posted(81920), 0)].concat([frame for i in 0..3]))
            let before = stream_updates(c, 1)
            let _ = c.drained()
            let took = c.arrived(1)
            before == 0 &&
                stream_updates(c, 1) == 1 &&
                took is .Flowing &&
                c.streams[0].recv == 65535
        }
        then "a stream sent past the window nobody gave back is FLOW_CONTROL_ERROR on the stream" {
            let frame = frame_bytes(.Data, 0, 1, [97 for i in 0..16384].bytes()!)
            let c = conn_after([heads(1, h2_posted(81920), 0)].concat([frame for i in 0..5]))
            reset_of(c, 1) == code(.FlowControl) && alive(c)
        }
        then "a long body read as it arrives never shuts either window" {
            let frame = frame_bytes(.Data, 0, 1, [97 for i in 0..16384].bytes()!)
            mut c = conn_after([heads(1, h2_posted(163840), 0)])
            mut taken = 0
            for i in 0..10 {
                let _ = c.fed(frame, 0)
                taken = taken + taken_octets(c, 1)
            }
            alive(c) && taken == 163840 && c.recv * 2 >= 65535 && c.streams[0].recv * 2 >= 65535
        }
        then "a stream whose body is no longer heard drops what arrives and is reset once answered" {
            mut c = conn_after([heads(1, h2_posted(10), 0), data_on(1, "01234", 0)])
            c.unheard(1)
            let _ = c.fed(data_on(1, "56789", 0), 0)
            let held = c.streams[0].inbound.length
            c.respond(1, [header_field(":status", "200")], no_bytes)
            held == 0 && stream_updates(c, 1) == 0 && reset_of(c, 1) == code(.NoError) && alive(c)
        }
        then "a body taken from a stream the peer reset is cut" {
            mut c = conn_after(
                [heads(1, h2_posted(10), 0), frame_bytes(.Reset, 0, 1, u32_bytes(8))],
            )
            c.arrived(1) is .Cut
        }
    }
    given "RST_STREAM, PRIORITY, WINDOW_UPDATE (§6.3, §6.4, §6.9)" {
        then "RST_STREAM on an idle stream is a PROTOCOL_ERROR" { goaway_of(conn_after([frame_bytes(.Reset, 0, 1, u32_bytes(8))])) == code(.Protocol) }
        then "RST_STREAM on stream 0 is a PROTOCOL_ERROR" { goaway_of(conn_after([frame_bytes(.Reset, 0, 0, u32_bytes(8))])) == code(.Protocol) }
        then "RST_STREAM of three octets is a FRAME_SIZE_ERROR" {
            goaway_of(conn_after([get_on(1), frame_bytes(.Reset, 0, 1, [0, 0, 8].bytes()!)])) == code(.FrameSize)
        }
        then "a reset request is dropped before anything answers it" {
            let c = conn_after([get_on(1), frame_bytes(.Reset, 0, 1, u32_bytes(8)), get_on(3)])
            paths_ready(c) == "/s3" && c.churn == 1
        }
        then "PRIORITY of four octets is a FRAME_SIZE_ERROR — a reset on an opened stream, the connection's on an idle one (§6.4)" {
            reset_of(
                    conn_after(
                        [heads(1, get_head("/"), 0), frame_bytes(.Priority, 0, 1, u32_bytes(0))],
                    ),
                    1,
                ) == code(.FrameSize) &&
                resets_owed(conn_after([frame_bytes(.Priority, 0, 1, u32_bytes(0))])) == 0 &&
                goaway_of(conn_after([frame_bytes(.Priority, 0, 1, u32_bytes(0))])) == code(.FrameSize)
        }
        then "PRIORITY on stream 0 is a PROTOCOL_ERROR" {
            goaway_of(
                conn_after([frame_bytes(.Priority, 0, 0, u32_bytes(1).concat([15].bytes()!))]),
            ) == code(.Protocol)
        }
        then "PRIORITY on an idle stream is taken and opens nothing" {
            let c = conn_after(
                [frame_bytes(.Priority, 0, 3, u32_bytes(0).concat([15].bytes()!)), get_on(1)],
            )
            alive(c) && paths_ready(c) == "/s1"
        }
        then "a PRIORITY that depends on its own stream is a PROTOCOL_ERROR — a reset on an opened stream, the connection's on an idle one (§6.4)" {
            let own = frame_bytes(.Priority, 0, 1, u32_bytes(1).concat([15].bytes()!))
            reset_of(conn_after([heads(1, get_head("/"), 0), own]), 1) == code(.Protocol) &&
                resets_owed(conn_after([own])) == 0 &&
                goaway_of(conn_after([own])) == code(.Protocol)
        }
        then "a WINDOW_UPDATE of zero is a PROTOCOL_ERROR — on the stream or the connection" {
            reset_of(
                    conn_after(
                        [heads(1, get_head("/"), 0), frame_bytes(.WindowUpdate, 0, 1, u32_bytes(0))],
                    ),
                    1,
                ) == code(.Protocol) &&
                goaway_of(conn_after([frame_bytes(.WindowUpdate, 0, 0, u32_bytes(0))])) == code(.Protocol)
        }
        then "a WINDOW_UPDATE of zero on an idle stream resets nothing: the connection ends PROTOCOL_ERROR (§6.4)" {
            let c = conn_after([get_on(1), frame_bytes(.WindowUpdate, 0, 3, u32_bytes(0))])
            resets_owed(c) == 0 && goaway_of(c) == code(.Protocol)
        }
        then "a WINDOW_UPDATE past 2^31-1 is a FLOW_CONTROL_ERROR — on the stream or the connection" {
            reset_of(
                    conn_after(
                        [
                            heads(1, get_head("/"), 0),
                            frame_bytes(.WindowUpdate, 0, 1, u32_bytes(2147483647)),
                        ],
                    ),
                    1,
                ) == code(.FlowControl) &&
                goaway_of(conn_after([frame_bytes(.WindowUpdate, 0, 0, u32_bytes(2147483647))])) == code(.FlowControl)
        }
        then "a WINDOW_UPDATE of five octets is a FRAME_SIZE_ERROR" {
            goaway_of(
                conn_after([frame_bytes(.WindowUpdate, 0, 0, u32_bytes(1).concat([0].bytes()!))]),
            ) == code(.FrameSize)
        }
    }
    given "the request head (§8.2, §8.3)" {
        then "a head of the four pseudo-fields and lowercase fields is kept" {
            request_head_kept(
                get_head("/")
                    .concat([header_field("accept", "*/*"), header_field("te", "trailers")]),
            )
        }
        then "an uppercase name, a connection field, or te other than trailers is malformed" {
            !request_head_kept(get_head("/").concat([header_field("Accept", "x")])) &&
                !request_head_kept(get_head("/").concat([header_field("connection", "close")])) &&
                !request_head_kept(get_head("/").concat([header_field("te", "gzip")]))
        }
        then "a host naming another target than :authority is malformed; one agreeing, case aside, is kept (§8.3.1)" {
            !request_head_kept(get_head("/").concat([header_field("host", "b")])) &&
                !request_head_kept(get_head("/").concat([header_field("host", "a:80")])) &&
                !request_head_kept(
                    get_head("/").concat([header_field("host", "a"), header_field("host", "b")]),
                ) &&
                request_head_kept(get_head("/").concat([header_field("host", "A")])) &&
                request_head_kept(
                    [
                        header_field(":method", "GET"),
                        header_field(":scheme", "http"),
                        header_field(":path", "/"),
                        header_field("host", "b"),
                    ],
                )
        }
        then "a head whose host disagrees with :authority resets its stream PROTOCOL_ERROR and reaches no handler" {
            let c = conn_after(
                [
                    heads(1, get_head("/").concat([header_field("host", "evil")]), end_stream),
                    get_on(3),
                ],
            )
            reset_of(c, 1) == code(.Protocol) && paths_ready(c) == "/s3" && alive(c)
        }
        then "a missing, empty or doubled pseudo-field is malformed" {
            !request_head_kept(
                    [header_field(":method", "GET"), header_field(":scheme", "http")],
                ) &&
                !request_head_kept(
                    [
                        header_field(":method", "GET"),
                        header_field(":scheme", "http"),
                        header_field(":path", ""),
                    ],
                ) &&
                !request_head_kept(get_head("/").concat([header_field(":method", "GET")]))
        }
        then "a pseudo-field after a regular one, or an unknown one, is malformed" {
            !request_head_kept(
                    [
                        header_field(":method", "GET"),
                        header_field("accept", "x"),
                        header_field(":scheme", "http"),
                        header_field(":path", "/"),
                    ],
                ) &&
                !request_head_kept(get_head("/").concat([header_field(":status", "200")]))
        }
        then "a value with a CR, a NUL, or a space at an end is malformed" {
            !request_head_kept(get_head("/").concat([header_field("x", "a\rb")])) &&
                !request_head_kept(
                    get_head("/")
                        .concat([HeaderField { name: "x".bytes(), value: [97, 0].bytes()! }]),
                ) &&
                !request_head_kept(get_head("/").concat([header_field("x", " a")]))
        }
        then "CONNECT takes an authority and neither a scheme nor a path" {
            request_head_kept(
                    [header_field(":method", "CONNECT"), header_field(":authority", "h:443")],
                ) &&
                !request_head_kept(
                    [
                        header_field(":method", "CONNECT"),
                        header_field(":authority", "h:443"),
                        header_field(":path", "/"),
                    ],
                )
        }
        then "a malformed head resets its stream with PROTOCOL_ERROR" {
            let c = conn_after(
                [heads(1, get_head("/").concat([header_field("Upper", "x")]), end_stream)],
            )
            reset_of(c, 1) == code(.Protocol) && c.ready.is_empty() && alive(c)
        }
        then "trailers end the request and keep its head" {
            mut c = conn_after(
                [
                    heads(1, h2_posted(2), 0),
                    data_on(1, "ok", 0),
                    heads(1, [header_field("x-sum", "1")], end_stream),
                ],
            )
            c.ready.length == 1 && taken_text(c, 1) == "ok ended"
        }
        then "trailers that do not end the stream, or carry a pseudo-field, reset it" {
            reset_of(
                    conn_after([heads(1, h2_posted(0), 0), heads(1, [header_field("x", "1")], 0)]),
                    1,
                ) == code(.Protocol) &&
                reset_of(
                    conn_after(
                        [
                            heads(1, h2_posted(0), 0),
                            heads(1, [header_field(":path", "/")], end_stream),
                        ],
                    ),
                    1,
                ) == code(.Protocol)
        }
        then "a head past the list bound is answered 431" {
            let l = Limits { head: 200 }
            let c = conn_with(
                l,
                [
                    heads(
                        1,
                        get_head("/").concat([header_field("x", ["y" for i in 0..300].join(""))]),
                        end_stream,
                    ),
                ],
            )
            kinds_owed(c, .Headers) == 1 && c.ready.is_empty() && alive(c)
        }
    }
    given "answering and flow control (§5.2, §6.9.2)" {
        then "a small answer is HEADERS then DATA that ends the stream, and the stream closes" {
            mut c = conn_after([get_on(1)])
            let _ = c.drained()
            c.respond(1, [header_field(":status", "200")], "hi".bytes())
            let s = frames_in(c.drained())
            s.length == 2 &&
                s[0].kind == FrameKind.Headers &&
                s[0].flags == end_headers &&
                s[1].kind == FrameKind.Data &&
                s[1].flags == end_stream &&
                s[1].payload == "hi".bytes() &&
                c.streams.is_empty()
        }
        then "a bodiless answer ends the stream on its HEADERS" {
            mut c = conn_after([get_on(1)])
            let _ = c.drained()
            c.respond(1, [header_field(":status", "204")], no_bytes)
            let s = frames_in(c.drained())
            s.length == 1 && s[0].flags == end_headers | end_stream && c.streams.is_empty()
        }
        then "an answer past the window sends what fits and owes the rest until WINDOW_UPDATE" {
            mut c = conn_after([get_on(1)])
            let _ = c.drained()
            c.respond(1, [header_field(":status", "200")], [97 for i in 0..70000].bytes()!)
            let first = frames_in(c.drained()).filter(it.kind == FrameKind.Data)
            let _ = c
                .fed(
                    frame_bytes(.WindowUpdate, 0, 0, u32_bytes(10000))
                        .concat(frame_bytes(.WindowUpdate, 0, 1, u32_bytes(10000))),
                    0,
                )
            let second = frames_in(c.drained()).filter(it.kind == FrameKind.Data)
            ["${f.payload.length}" for f in first].join(",") == "16384,16384,16384,16383" &&
                second.length == 1 &&
                second[0].payload.length == 70000 - 65535 &&
                second[0].flags == end_stream
        }
        then "a window shrunk by SETTINGS below zero holds DATA until it is positive" {
            mut d = conn_after([settings_of([[4, 0]]), get_on(1)])
            let _ = d.drained()
            d.respond(1, [header_field(":status", "200")], [97 for i in 0..10].bytes()!)
            let held = frames_in(d.drained()).filter(it.kind == FrameKind.Data).length
            let _ = d.fed(frame_bytes(.WindowUpdate, 0, 1, u32_bytes(4)), 0)
            let some = frames_in(d.drained()).filter(it.kind == FrameKind.Data)
            let _ = d.fed(settings_of([[4, 100]]), 0)
            let rest = frames_in(d.drained()).filter(it.kind == FrameKind.Data)
            held == 0 &&
                some.length == 1 &&
                some[0].payload.length == 4 &&
                rest.length == 1 &&
                rest[0].payload.length == 6
        }
        then "DATA never passes the peer's frame size" {
            mut c = conn_after([settings_of([[5, 16384]]), get_on(1)])
            let _ = c.drained()
            c.respond(1, [header_field(":status", "200")], [97 for i in 0..40000].bytes()!)
            frames_in(c.drained()).all(it.payload.length <= 16384)
        }
        then "an answer's head past the frame size continues in CONTINUATIONs" {
            mut c = conn_after([get_on(1)])
            let _ = c.drained()
            c
                .respond(
                    1,
                    [
                        header_field(":status", "200"),
                        header_field("x-big", ["z" for i in 0..20000].join("")),
                    ],
                    no_bytes,
                )
            let s = frames_in(c.drained())
            s.length == 2 &&
                s[0].kind == FrameKind.Headers &&
                s[0].flags == end_stream &&
                s[1].kind == FrameKind.Continuation &&
                s[1].flags == end_headers
        }
        then "an answer on a stream that is gone writes nothing" {
            mut c = conn_after([get_on(1), frame_bytes(.Reset, 0, 1, u32_bytes(8))])
            let _ = c.drained()
            c.respond(1, [header_field(":status", "200")], "x".bytes())
            c.drained().is_empty()
        }
    }
}

/// Stream `id`'s body octets taken, as text, and ` ended` when they are
/// the last — or `cut`.
fn taken_text(mut c: H2Conn, id: int) -> string {
    match c.arrived(id) {
        .Whole(b) -> "${b.text() ?? "?"} ended",
        .Flowing(b) -> b.text() ?? "?",
        .Cut -> "cut",
    }
}

/// How many octets of stream `id`'s body a take found.
fn taken_octets(mut c: H2Conn, id: int) -> int {
    match c.arrived(id) { .Whole(b) or .Flowing(b) -> b.length, .Cut -> -1 }
}

/// How many WINDOW_UPDATEs on stream `id` are owed.
fn stream_updates(c: H2Conn, id: int) -> int { frames_in(c.out).filter(it.kind is .WindowUpdate && it.stream == id).length }
