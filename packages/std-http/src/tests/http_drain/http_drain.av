//! proves: a stop DRAINS — a request in flight at the stop is answered
//! whole, with `connection: close`, and its connection then ends; a
//! connection waiting between requests is closed at once; a body half
//! sent at the stop is read to its end and answered; a head that never
//! finishes is cut at the drain's end; and `run` answers within the
//! drain, never the idle deadline
use @std.net.{Conn, NetError, listen, connect}
use @std.time.{Duration, ms, secs, sleep, now_ms}
use @std.http.frame.{limits}
use @std.http.http.{text}
use @std.http.server.{Server, Timing, served}

type App = {}

/// Everything the peer sends until its end, or `quiet` of silence.
fn drained(c: Conn, quiet: Duration) -> string {
    mut got = "".bytes()
    while true {
        match within quiet { c.read(65536) } {
            .Ok(b) -> {
                let more? = b else { break }
                got = got.concat(more)
            },
            .Err(_) -> { break },
        }
    }
    (got.text() ?? "?").replace("\r\n", "/")
}

/// The one response a connection is owed: its status line, whether it
/// closes, and its body — read to the connection's end.
fn owed(c: Conn, body: string) -> string {
    let got = drained(c, secs(2))
    "${got.starts_with("HTTP/1.1 200")} ${got.contains("connection: close")} ${got.ends_with("/${body}")}"
}

fn shown() -> Result<string, NetError> {
    let l = listen("127.0.0.1", 0)?
    let s = served(l, () -> App {}, limits(), Timing { drain: ms(400) }) { _app, q ->
        if q.target() == "/slow" { sleep(ms(200)) }
        text(200, "${q.target() ?? "?"} ${q.body.text() ?? "?"}")
    }
    let run = spawn s.run(cores: 1)
    let idle = connect("127.0.0.1", l.port, secs(2))?
    defer { let _ = idle.close() }
    let _ = idle.write("GET /first HTTP/1.1\r\nHost: a\r\n\r\n".bytes())?
    let first = match within secs(2) { idle.read(65536) } { .Ok(b) -> b != null, .Err(_) -> false }
    let slow = connect("127.0.0.1", l.port, secs(2))?
    defer { let _ = slow.close() }
    let _ = slow.write("GET /slow HTTP/1.1\r\nHost: a\r\n\r\n".bytes())?
    let half = connect("127.0.0.1", l.port, secs(2))?
    defer { let _ = half.close() }
    let _ = half.write("POST /half HTTP/1.1\r\nHost: a\r\nContent-Length: 6\r\n\r\nabc".bytes())?
    let torn = connect("127.0.0.1", l.port, secs(2))?
    defer { let _ = torn.close() }
    let _ = torn.write("GET /torn HTTP/1.1\r\nHo".bytes())?
    sleep(ms(50))
    let asked = now_ms()
    s.stop()
    let idle_end = drained(idle, secs(2))
    let idle_ms = now_ms() - asked
    sleep(ms(100))
    let _ = half.write("def".bytes())?
    let answered = owed(slow, "slow ")
    let finished = owed(half, "half abcdef")
    let torn_end = drained(torn, secs(2))
    let served_n = run.await?
    let run_ms = now_ms() - asked
    .Ok(
        "${first}\nidle closed: ${idle_end == ""} ${idle_ms < 1000}\nin flight: ${answered}\nhalf a body: ${finished}\ntorn cut: ${torn_end == ""}\nrun answered ${served_n} within the drain: ${run_ms >= 350 && run_ms < 5000}",
    )
}

match shown() { .Ok(t) -> t, .Err(e) -> "failed: ${e.describe().message}" }
