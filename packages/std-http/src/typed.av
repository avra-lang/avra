//! TYPED READS AND ANSWERS — a handler reads its body and its query as
//! the records it declares, a capture as the text it encodes, and answers
//! through one verb per outcome:
//!
//!     post "/ideas" { req -> either(added(req.json())) }
//!
//!     fn added(asked: Result<Idea, Response>) -> Result<Response, Response> {
//!         let idea = asked?
//!         let at = ideas.add(idea)?
//!         created(idea.json(), "/ideas/${at}")
//!     }
//!
//! `?` hands any refusal straight back, and `either` makes whichever side
//! came back the reply.
//!
//! A RECORD THAT DOES NOT VALIDATE IS ONE 422, `application/problem+json`
//! (RFC 9457), listing EVERY issue at its path and, read from a request,
//! the part it was found in (`"in": "body"` or `"query"`) — `problem`, the one
//! encoder every door that judges a record answers with. A body that is
//! not JSON, or not said to be, keeps `json()`'s 400 and 415: those are
//! the request's framing, not the record's.
//!
//! THE QUERY IS DECODED ONCE, AFTER THE SPLIT, NAMES AND VALUES ALIKE —
//! an escaped `&` or `=` never moves where a field begins (query.av) —
//! and read under `Coercion.Lax` through `from_keyed`: absent takes the
//! field's default, a bare key reads `true`, an empty value is text for a
//! text field and absence for every other, and a scalar sent twice is
//! refused, never a side picked. A key the record
//! does not name is passed by. An escape that decodes to no text, or to a
//! NUL, is a 400: it is no field's value to judge.
//!
//! A FORM IS READ AS A QUERY IS (`form<T>`): its fields keyed as sent,
//! either encoding, under the same `Coercion.Lax` and the same 422.
//!
//! A CAPTURE STAYS RAW in `params` (route.av); `captured` is the typed
//! read of one, decoded once under the same law.
use @std.http_message.message.{Header}
use @std.json.{Field as JsonField, Json, field, to_text}
use @std.text.{has_nul}
use @std.url.{decoded}
use @std.validate.{
    Coercion,
    Decode,
    Entry,
    Issue,
    Issues,
    Keyed,
    Limits as DecodeLimits,
    Value,
    from_keyed,
    json_value,
}
use @std.json.typed.{Path}
use http.{Request, Response, status, text, body_json}
use query.{Pair, Query}

impl Request {
    /// THE BODY AS A `T`, or the response refusing it: `json_text`'s 415
    /// and 400, a 400 for text that is not JSON, and a 422 naming every
    /// issue for JSON that is not a `T`.
    fn json<T: Decode>() -> Result<T, Response> {
        let doc = self.json_text()?
        match T.from_json(doc, Coercion.Strict, DecodeLimits {}) {
            .Ok(v) -> v,
            .Err(issues) -> {
                let _ = body_json(doc)?
                fail problem(issues, Origin.Body)
            },
        }
    }

    /// THE FORM AS A `T`, or the response refusing it: the form's own
    /// refusal (`form_body`), or a 422 naming every issue for fields that are
    /// not a `T` — read as a query's fields are, by `T`'s own rules.
    fn form<T: Decode>() -> Result<T, Response> { lax_read(self.form_value()?, Origin.Body) }

    /// THE QUERY AS A `Q`, or the response refusing it: a 400 for a name
    /// or value that decodes to no text, a 422 naming every issue for
    /// fields that are not a `Q`.
    fn query<Q: Decode>() -> Result<Q, Response> { lax_read(self.query_value()?, Origin.Query) }

    /// The posted form as the value its fields key, or its refusal.
    fn form_value() -> Result<Value, Response> { from_keyed((self.form_body()?).keyed()) }

    /// The query as the value its fields key, or the 400 for a pair that
    /// decodes to no text.
    fn query_value() -> Result<Value, Response> { from_keyed(keyed(self.raw_query())?) }

    /// The body as an input's field `name`: a form, read as a query is, or
    /// JSON, read strictly — by what the body says it is.
    fn body_entry(name: string) -> Result<Entry, Response> {
        if self.form_posted() { return Entry { key: name, value: self.form_value()?, coercion: Coercion.Lax } }
        Entry {
            key: name,
            value: json_value(body_json(self.json_text()?)?),
            coercion: Coercion.Strict,
        }
    }

    /// The query as an input's field `name`.
    fn query_entry(name: string) -> Result<Entry, Response> {
        Entry { key: name, value: self.query_value()?, coercion: Coercion.Lax }
    }
}

/// The capture `name` as an input's field, its text decoded once as
/// `captured` reads it; a capture the route does not hold is the server's fault.
export fn path_entry(at: dyn Captures, name: string) -> Result<Entry, Response> {
    let raw? = at.at(name) else { fail text(500, no_capture(name)) }
    Entry { key: name, value: Value.Text(captured(raw)?), coercion: Coercion.Lax }
}

/// A route's captures by name.
export trait Captures {
    fn at(name: string) -> string?
}

/// A field of an input and the part it is read from.
export type FieldPart = { name: string, part: Origin }

/// AN INPUT, DECODED ONCE: its fields' values as one map, each read by its
/// own part's rule, judged by `T`'s whole law, so every issue — in any
/// part, the input's own fields' rules among them — is in the one 422,
/// each at its path within its part.
export fn input_read<T: Decode>(fields: List<Entry>, parts: List<FieldPart>) -> Result<T, Response> {
    match T.decode(Value.Map(fields), Coercion.Strict, DecodeLimits {}) {
        .Ok(v) -> v,
        .Err(issues) -> { fail problem_placed([in_part(i, parts) for i in issues.all]) },
    }
}

/// An input's issue as its part reads it: a capture by its own name, a
/// body or a query from its own root.
fn in_part(i: Issue, parts: List<FieldPart>) -> Placed {
    let part? = parts.find(it.name == top_field(i))?.part else { return Placed { issue: i, part: null } }
    if part is .Path { return placed(i, part) }
    Placed { issue: i with { path: Path { up: i.path.up.take(i.path.up.length - 1) } }, part: part }
}

/// The field an issue's path starts at, or "" at the root.
fn top_field(i: Issue) -> string {
    let first? = i.path.steps().first() else { return "" }
    match first { .Field(n) -> n, .Index(_) or .Key(_) or .Variant(_) -> "" }
}

/// A value of keyed text read as a `T` under `Lax`, or the 422 naming every
/// issue in `part`.
fn lax_read<T: Decode>(v: Value, part: Origin) -> Result<T, Response> {
    match T.decode(v, Coercion.Lax, DecodeLimits {}) {
        .Ok(x) -> x,
        .Err(issues) -> { fail problem(issues, part) },
    }
}

/// An issue and the part of the request it was found in.
export type Placed = { issue: Issue, part: Origin? }

/// The issue `i` found in `part`.
fn placed(i: Issue, part: Origin?) -> Placed { Placed { issue: i, part: part } }

/// A capture as the text it encodes, decoded once, or the 400 refusing
/// it: an escape that is malformed, decodes to no text, or to a NUL.
export fn captured(raw: string) -> Result<string, Response> {
    let s? = plain_text(raw.bytes()) else { fail text(400, not_a_segment(raw)) }
    s
}

// ── Answers ─────────────────────────────────────────────────────

/// A handler's answer when either side is the reply: what `?` refused
/// with, or what it built.
export fn either(r: Result<Response, Response>) -> Response {
    match r { .Ok(answer) -> answer, .Err(refusal) -> refusal }
}

/// 200 carrying `v` as JSON by `show`, or `missing` — a bare 404 unless
/// it says more — when there is none.
export fn found<T>(v: T?, show: fn(T) -> Json, missing: Response = status(404)) -> Response {
    let there? = v else { return missing }
    Response.json(show(there))
}

/// 201 carrying `j`, its `location` the address it now stands at.
export fn created(j: Json, at: string) -> Response {
    (Response.json(j) with { status: 201 }).with_header("location", at)
}

/// THE ONE REFUSAL OF A RECORD: 422, `application/problem+json`, every
/// issue at its path, the rule that refused and its words. What an issue
/// received is never echoed: a refusal can be read by whoever is shown it.
/// `part`, when the issues were read from a request, names where.
export fn problem(issues: Issues, part: Origin? = null) -> Response { problem_placed([placed(i, part) for i in issues.all]) }

/// The one refusal over issues found in several parts, each naming its own.
export fn problem_placed(all: List<Placed>) -> Response {
    Response {
        status: 422,
        headers: [Header { name: "content-type", value: "application/problem+json" }],
        body: to_text(problem_json(all)).bytes(),
    }
}

fn problem_json(all: List<Placed>) -> Json {
    Json
        .Obj(
            [
                field("title", Json.Str(unvalidated())),
                field("status", Json.Int(422)),
                field("issues", Json.Arr([issue_json(p.issue, p.part) for p in all])),
            ],
        )
}

/// The part of a request a record was read from.
export enum Origin { Body, Query, Path }

fn issue_json(i: Issue, part: Origin?) -> Json {
    Json
        .Obj(
            in_field(part)
                .concat(
                    [
                        field("path", Json.Str(i.path.text())),
                        field("rule", Json.Str(i.rule)),
                        field("message", Json.Str(i.message)),
                    ],
                ),
        )
}

/// `"in"` naming the part, when there is one.
fn in_field(part: Origin?) -> List<JsonField> {
    let p? = part else { return [] }
    [field("in", Json.Str(origin_word(p)))]
}

// ── The query, decoded ──────────────────────────────────────────

/// Every pair of `q`, each side decoded once, or the 400 naming the
/// first that decodes to no text.
fn keyed(q: Query) -> Result<List<Keyed>, Response> {
    [keyed_pair(q.raw, p)? for p in q.pairs]
}

fn keyed_pair(raw: Bytes, p: Pair) -> Result<Keyed, Response> {
    let name = raw.slice(p.name.lo, p.name.hi)
    let key? = plain_text(name) else { fail text(400, not_a_name(name.text() ?? "")) }
    let v? = p.value else { return Keyed { key: key, text: null } }
    let said = raw.slice(v.lo, v.hi)
    let value? = plain_text(said) else { fail text(400, not_a_value(key)) }
    Keyed { key: key, text: value }
}

/// Octets percent-decoded once into text holding no NUL.
fn plain_text(b: Bytes) -> string? {
    let s? = decoded(b)?.text() else { return null }
    if has_nul(s) { return null }
    s
}

// ── voices ──────────────────────────────────────────────────────

fn origin_word(o: Origin) -> string { match o { .Body -> "body", .Query -> "query", .Path -> "path" } }

fn unvalidated() -> string { "the request does not validate" }
fn not_a_segment(raw: string) -> string { "the segment `${raw}` is not percent-encoded text" }
fn not_a_name(raw: string) -> string { "the query name `${raw}` is not percent-encoded text" }
fn not_a_value(key: string) -> string { "the query's `${key}` is not percent-encoded text" }
fn no_capture(name: string) -> string { "the route captures no `${name}`" }
