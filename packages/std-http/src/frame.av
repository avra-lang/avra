//! THE FRAMER — an HTTP/1.1 head over `Bytes`, stateless and strict.
//! One head-end scan per read, from three bytes before what was
//! already scanned; then one pass in OFFSETS: a token is where a
//! class table stops admitting bytes, a name is compared in place, a
//! value is sliced only when asked. Every grammar-widening MAY in
//! RFC 9112 is refused — lenient framing is what request smuggling
//! rides — and a refusal names its law, so the reply's status is a
//! projection and the connection always closes behind it.

/// A byte range inside the buffer a head was framed from.
export type Span = { lo: int, hi: int }

/// One field line as two spans; the name compares in place.
export type Field = { name: Span, value: Span }

/// A head's fields as four offsets each — name lo, name hi, value lo,
/// value hi — in one list: a head costs one allocation however many
/// fields it carries. `field` reads one back as spans.
export type Fields = List<int>

impl Fields {
    /// How many fields.
    fn count() -> int { self.of.length / 4 }

    fn name_at(i: int) -> Span { Span { lo: self.of[4 * i], hi: self.of[4 * i + 1] } }

    fn value_at(i: int) -> Span { Span { lo: self.of[4 * i + 2], hi: self.of[4 * i + 3] } }

    fn field(i: int) -> Field { Field { name: self.name_at(i), value: self.value_at(i) } }

    /// These fields but every one named `unwanted`, ASCII-folded.
    fn without(buf: Bytes, unwanted: Bytes) -> Fields {
        Fields([self.of[k] for k in 0..self.of.length if !self.names(buf, k / 4, unwanted)])
    }

    /// The first field named `wanted`, ASCII-folded, by index — or -1.
    fn named(buf: Bytes, wanted: Bytes) -> int {
        for i in 0..self.count() {
            if self.names(buf, i, wanted) { return i }
        }
        -1
    }

    /// Whether field `i` is named `wanted`, ASCII-folded.
    fn names(buf: Bytes, i: int, wanted: Bytes) -> bool { buf.ieq_at(self.of[4 * i], self.of[4 * i + 1], wanted) }
}

/// The nine methods RFC 9110 registers, and `Other` for a token this
/// framer read and does not name — a method is extensible, so an
/// unknown one is well formed and not a refusal.
export enum Method { Get, Head, Post, Put, Delete, Patch, Options, Connect, Trace, Other }

/// The four shapes a request target may take (RFC 9112 §3.2), and
/// `Other` for a target in none of them. WHICH FORM IT IS DECIDES
/// WHERE ITS PATH BEGINS, which is why this is a value and not a
/// predicate: `Origin` IS its path, `Absolute` carries a scheme and an
/// authority in front of one, and `Asterisk` and `Authority` name no
/// resource and so have no path to route on.
export enum TargetForm { Origin, Absolute, Asterisk, Authority, Other }

/// How a request body is delimited (RFC 9112 §6.3).
export enum RequestBody { None, Length(n: int), Chunked }

/// A framed head. Spans index the buffer it was framed from; `end` is
/// the first byte past the blank line.
export type Head = {
    method: Method,
    verb: Span,
    target: Span,
    minor: int,
    fields: Fields,
    body: RequestBody,
    keep_alive: bool,
    expects_continue: bool,
    end: int,
}

/// Why a head was refused: each arm a law, and `status_of` its reply.
export enum Refusal {
    LineEnd
    RequestLine
    Version
    Major
    Target
    LineLength
    HeadLength
    FieldCount
    FieldLength
    FieldName
    FieldValue
    Host
    ContentLength
    BodyLength
    TransferEncoding
    Coding
    OldChunked
    Expectation
    Chunk
}

/// What a buffer holds so far: not yet a whole head, a head, or the
/// law it broke.
export enum Framed {
    Partial
    Complete(head: Head)
    Refused(why: Refusal)
}

/// The bounds a server names — inspectable, adjustable where they
/// are owned, never implicit. `body` bounds a body GATHERED whole into
/// memory; `stream` bounds a body READ piece by piece, which costs one
/// piece of memory however long it runs — so a request declaring more
/// than `stream` is refused at its head, and one declaring more than
/// `body` is refused only if something asks to gather it.
export type Limits = {
    line: int = 8192,
    field: int = 8192,
    head: int = 65536,
    fields: int = 100,
    body: int = 1048576,
    stream: int = 1073741824,
    ext: int = 4096,
    trailers: int = 16,
}

/// The default bounds.
export fn limits() -> Limits { Limits {} }

/// The reply a refusal earns.
export fn status_of(why: Refusal) -> int {
    match why {
        .Major -> 505,
        .LineLength -> 414,
        .HeadLength or .FieldCount or .FieldLength -> 431,
        .BodyLength -> 413,
        .Coding -> 501,
        .Expectation -> 417,
        .LineEnd or .RequestLine or .Version or .Target or .FieldName or .FieldValue or .Host or .ContentLength or .TransferEncoding or .OldChunked or .Chunk -> 400,
    }
}

// ── The class tables, built once ────────────────────────────────

/// A 256-entry class table: one byte per octet, 1 where the
/// predicate admits it. `run` walks a span in one call against one of
/// these, so a scan asks where a class ENDS and never what each byte
/// is.
export fn admits(pred: fn(int) -> bool) -> Bytes { [if pred(i) { 1 } else { 0 } for i in 0..256].bytes()! }
fn is_digit(c: int) -> bool { c >= "0".char_code() && c <= "9".char_code() }
fn is_alpha(c: int) -> bool { c >= "A".char_code() && c <= "Z".char_code() || c >= "a".char_code() && c <= "z".char_code() }
fn is_mark(c: int) -> bool { one_of(marks, c) }
/// Whether octet `c` is one of `set`'s.
fn one_of(set: Bytes, c: int) -> bool { set.index_of([c].bytes()!, 0) >= 0 }
/// What octet a TOKEN may carry (RFC 9110 §5.6.2) — a method, a field
/// name. Exported for the reason `is_target` is: a WRITER that must
/// not emit what this framer would refuse composes the law rather
/// than restating it.
export fn is_tchar(c: int) -> bool { is_digit(c) || is_alpha(c) || is_mark(c) }
/// What octet a FIELD VALUE may carry — visible ASCII and HTAB, and
/// so neither a CR, an LF, nor a NUL.
export fn is_vchar(c: int) -> bool { c == "\t".char_code() || c >= " ".char_code() && c <= "~".char_code() }
/// What octet a request target may carry (RFC 9112 §3.2): visible
/// ASCII, plus `obs-text`. The law lives here so a consumer that
/// narrows it — the path, which is a target minus `?` — composes
/// rather than copies.
export fn is_target(c: int) -> bool { c >= "!".char_code() && c <= "~".char_code() || c >= 128 }

const marks: Bytes = "!#\$%&'*+-.^_`|~".bytes()
const tchar: Bytes = admits(is_tchar)
const vchar: Bytes = admits(is_vchar)
const target_char: Bytes = admits(is_target)
const digit: Bytes = admits(is_digit)
const ows: Bytes = admits(is_ows)

/// The empty octets — the one spelling every file of this package uses.
export const no_bytes: Bytes = "".bytes()

const crlf: Bytes = "\r\n".bytes()
const blank_line: Bytes = "\r\n\r\n".bytes()
const http_slash: Bytes = "HTTP/".bytes()
const verbs: List<Bytes> = [w.bytes() for w in ["GET", "HEAD", "POST", "PUT", "DELETE", "PATCH", "OPTIONS", "CONNECT", "TRACE"]]
const content_length: Bytes = "content-length".bytes()
const transfer_encoding: Bytes = "transfer-encoding".bytes()
const host: Bytes = "host".bytes()
const connection: Bytes = "connection".bytes()
const expect: Bytes = "expect".bytes()
const chunked: Bytes = "chunked".bytes()
const close: Bytes = "close".bytes()
const keep_alive: Bytes = "keep-alive".bytes()
const continue_100: Bytes = "100-continue".bytes()

fn is_ows(c: int) -> bool { c == " ".char_code() || c == "\t".char_code() }

// ── The head ────────────────────────────────────────────────────

/// The head at `from`, or why not. `scanned` is how much of the
/// buffer the previous call already searched for the blank line, so
/// each read costs one scan of its new bytes and nothing more.
export fn framed(buf: Bytes, from: int, scanned: int, limits: Limits) -> Framed {
    let start = past_one_empty_line(buf, from)
    let mark = buf.index_of(blank_line, if scanned - 3 > start { scanned - 3 } else { start })
    if mark < 0 { return unfinished(buf, start, limits) }
    if mark + 4 - start > limits.head { return .Refused(.HeadLength) }
    if !crlf_only(buf, start, mark) { return .Refused(.LineEnd) }
    request_line(buf, start, mark, limits)
}

/// No blank line yet: more bytes, unless a law is already broken — a
/// bare line end, the request line's bound before any line has ended,
/// the head's bound after.
fn unfinished(buf: Bytes, start: int, limits: Limits) -> Framed {
    let first_end = buf.index_of(crlf, start)
    when {
        !crlf_only(buf, start, buf.length - 1) -> .Refused(.LineEnd)
        first_end < 0 && buf.length - start > limits.line -> .Refused(.LineLength)
        buf.length - start > limits.head -> .Refused(.HeadLength)
        _ -> .Partial
    }
}

/// Every CR in `lo..hi` is followed by LF and every LF preceded by CR:
/// a bare one is refused before anything is parsed (RFC 9112 §2.2).
/// The last byte of a torn buffer is left for the next read.
fn crlf_only(buf: Bytes, lo: int, hi: int) -> bool {
    let carriage = cr
    let feed = lf
    mut at = lo
    while at < hi {
        let cr = buf.index_in(carriage, at, hi)
        let lf = buf.index_in(feed, at, hi)
        if cr < 0 && lf < 0 { return true }
        if cr >= 0 && (cr + 1 >= buf.length || buf.at(cr + 1) != "\n".char_code()) { return false }
        if lf >= 0 && (lf == 0 || buf.at(lf - 1) != "\r".char_code()) { return false }
        at = if cr >= 0 && (lf < 0 || cr < lf) { cr + 2 } else { lf + 1 }
    }
    true
}

const cr: Bytes = "\r".bytes()
const lf: Bytes = "\n".bytes()
const hash: Bytes = "#".bytes()
const comma_mark: Bytes = ",".bytes()

/// One empty line before the request line is ignored (RFC 9112 §2.2).
fn past_one_empty_line(buf: Bytes, from: int) -> int {
    if from + 2 <= buf.length && buf.eq_at(from, from + 2, crlf) { from + 2 } else { from }
}

/// The request line — the method, its target and the version's minor
/// digit — then its fields, then the head settled.
fn request_line(buf: Bytes, start: int, mark: int, limits: Limits) -> Framed {
    let verb_end = buf.run(start, tchar)
    if verb_end == start || buf.at(verb_end) != " ".char_code() { return .Refused(.RequestLine) }
    let t_lo = verb_end + 1
    let t_end = buf.run(t_lo, target_char)
    // the head's line ends were judged whole before this ran, so a
    // target stopping at a CR is a line of two words, not a torn end
    if t_end == t_lo || buf.at(t_end) != " ".char_code() { return .Refused(.RequestLine) }
    let v_lo = t_end + 1
    let eol = buf.index_of(crlf, v_lo)
    if eol - start > limits.line { return .Refused(.LineLength) }
    if !versioned(buf, v_lo, eol) { return .Refused(.Version) }
    if buf.at(v_lo + 5) != "1".char_code() { return .Refused(.Major) }
    let method = method_of(buf, start, verb_end)
    if !target_form_fits(buf, method, t_lo, t_end) { return .Refused(.Target) }
    mut fs: List<int> = []
    let why: Refusal? = field_lines(buf, eol + 2, mark, limits, fs)
    if why != null { return .Refused(why!) }
    settled(
        buf,
        method,
        Span { lo: start, hi: verb_end },
        Span { lo: t_lo, hi: t_end },
        buf.at(v_lo + 7) - "0".char_code(),
        Fields(fs),
        mark + 4,
        limits,
    )
}

/// `HTTP/` then one digit, a point, one digit, and nothing else before
/// the line ends (RFC 9112 §2.3).
fn versioned(buf: Bytes, at: int, eol: int) -> bool {
    eol - at == 8 &&
        buf.eq_at(at, at + 5, http_slash) &&
        is_digit(buf.at(at + 5)) &&
        buf.at(at + 6) == ".".char_code() &&
        is_digit(buf.at(at + 7))
}

/// The target's form belongs to its method (RFC 9112 §3.2): origin-form
/// to any, absolute-form to any, authority-form to CONNECT alone,
/// `*` to OPTIONS alone; a fragment never travels. `.Other` alone
/// refuses, and the catch-all is the honest direction: a form the RFC
/// grows is a form, and this law admits it.
fn target_form_fits(buf: Bytes, method: Method, lo: int, hi: int) -> bool {
    if buf.index_in(hash, lo, hi) >= 0 { return false }
    !(target_form(buf, method, lo, hi) is .Other)
}

/// WHICH OF THE FOUR FORMS A TARGET IS IN (RFC 9112 §3.2), `.Other`
/// when it is in none — the shape this framer refuses.
///
/// ONE DECISION, TWO READERS. The framer's law asks it to refuse, and
/// `Request.path()` asks it to know WHERE THE PATH BEGINS: an
/// origin-form target IS its path, an absolute-form one carries a
/// scheme and an authority before it, and the other two have no path
/// at all. Spelled twice, the reader would have gone on routing the
/// whole URI — which it did, and `/p` and `http://h/p` answered from
/// two routes for one resource.
export fn target_form(buf: Bytes, method: Method, lo: int, hi: int) -> TargetForm {
    when {
        method == Method.Connect -> connect_form(buf, lo, hi)
        buf.at(lo) == "/".char_code() -> .Origin
        buf.eq_at(lo, hi, star) -> asterisk_form(method)
        schemed(buf, lo, hi) -> .Absolute
        _ -> .Other
    }
}

/// CONNECT's target is an AUTHORITY and never a path (RFC 9112 §3.2.3).
fn connect_form(buf: Bytes, lo: int, hi: int) -> TargetForm {
    if !hosted(buf, lo, hi, true) { return .Other }
    .Authority
}

/// `*` is OPTIONS' alone — the server itself, not a resource on it
/// (RFC 9112 §3.2.4).
fn asterisk_form(method: Method) -> TargetForm {
    if method != Method.Options { return .Other }
    .Asterisk
}

/// Whether a scheme opens this target — a letter, then letters,
/// digits, `+`, `-` or `.` up to `://` (RFC 3986 §3.1) — and a host
/// follows it: an `http` URI with an empty host is invalid and its
/// recipient rejects it (RFC 9110 §4.2.1), and the scheme is not the
/// axis here.
fn schemed(buf: Bytes, lo: int, hi: int) -> bool {
    let at = buf.run(lo, scheme_char)
    at > lo &&
        at + 3 <= hi &&
        is_alpha(buf.at(lo)) &&
        buf.eq_at(at, at + 3, scheme_end) &&
        authority_named(buf, at + 3, hi)
}

const scheme_char: Bytes = admits((c) -> is_digit(c) || is_alpha(c) || one_of(scheme_marks, c))
const scheme_marks: Bytes = "+-.".bytes()

/// The authority from `at` names a host: userinfo dropped, then the
/// one host law.
fn authority_named(buf: Bytes, at: int, hi: int) -> bool {
    let end = buf.run(at, authority_char)
    hosted(buf, past_userinfo(buf, at, end), if end < hi { end } else { hi }, false)
}

/// Where the host begins: past the last `@` before `end`, or `at`.
fn past_userinfo(buf: Bytes, at: int, end: int) -> int {
    mut lo = at
    mut next = buf.run(at, authority_plain)
    while next < end && buf.at(next) == "@".char_code() {
        lo = next + 1
        next = buf.run(lo, authority_plain)
    }
    lo
}

// ── The host (RFC 9110 §7.2, RFC 3986 §3.2.2) ───────────────────

/// Whether `lo..hi` is `uri-host [ ":" port ]` with a host that is not
/// empty and a port that fits one, owed when `port_owed` — THE ONE HOST LAW: the `Host`
/// field, an absolute-form authority and CONNECT's target all ask it.
fn hosted(buf: Bytes, lo: int, hi: int, port_owed: bool) -> bool {
    let name_end = host_end(buf, lo, hi)
    if name_end <= lo || name_end > hi { return false }
    if name_end == hi { return !port_owed }
    if buf.at(name_end) != ":".char_code() { return false }
    buf.run(name_end + 1, digit) == hi && port_fits(buf, name_end + 1, hi, port_owed)
}

/// Whether the digits in `lo..hi` name a port: at most 65535, and —
/// when one is owed — present and not 0 (RFC 9110 §9.3.6).
fn port_fits(buf: Bytes, lo: int, hi: int, owed: bool) -> bool {
    mut n = 0
    for i in lo..hi {
        n = n * 10 + buf.at(i) - "0".char_code()
        if n > 65535 { return false }
    }
    !owed || n > 0
}

/// Where a host ends: past an IP literal's `]`, or where a reg-name
/// stops — -1 for a literal that never closes.
fn host_end(buf: Bytes, lo: int, hi: int) -> int {
    if lo < hi && buf.at(lo) == "[".char_code() { return literal_end(buf, lo + 1, hi) }
    reg_name_end(buf, lo, hi)
}

/// Past the `]` closing an IP literal whose octets start at `lo`, or -1.
fn literal_end(buf: Bytes, lo: int, hi: int) -> int {
    let close = buf.run(lo, literal_char)
    if close == lo || close >= hi || buf.at(close) != "]".char_code() { return -1 }
    close + 1
}

/// Where a reg-name stops: its plain octets and whole `%HH` escapes;
/// a broken escape stops it at the `%`.
fn reg_name_end(buf: Bytes, lo: int, hi: int) -> int {
    mut at = buf.run(lo, reg_char)
    while at + 2 < hi &&
        buf.at(at) == "%".char_code() &&
        is_hex(buf.at(at + 1)) &&
        is_hex(buf.at(at + 2)) {
        at = buf.run(at + 3, reg_char)
    }
    at
}

fn is_reg(c: int) -> bool { is_digit(c) || is_alpha(c) || one_of(unreserved_marks, c) || one_of(sub_delims, c) }
fn is_authority(c: int) -> bool { is_target(c) && c != "/".char_code() && c != "?".char_code() && c != "#".char_code() }

const unreserved_marks: Bytes = "-._~".bytes()
const sub_delims: Bytes = "!\$&'()*+,;=".bytes()
const reg_char: Bytes = admits(is_reg)
const literal_char: Bytes = admits((c) -> is_reg(c) || c == ":".char_code())
const authority_char: Bytes = admits(is_authority)
const authority_plain: Bytes = admits((c) -> is_authority(c) && c != "@".char_code())

/// What separates an absolute-form target's scheme from its
/// authority — the octets `path()` splits on, so the reader and the
/// framer agree on where a scheme ends.
export const scheme_end: Bytes = "://".bytes()
const star: Bytes = "*".bytes()

/// The method by its bytes — one compare per verb, length first as
/// the compare does, and nothing built per head.
fn method_of(buf: Bytes, lo: int, hi: int) -> Method {
    let v = verbs
    when {
        buf.eq_at(lo, hi, v[0]) -> .Get
        buf.eq_at(lo, hi, v[1]) -> .Head
        buf.eq_at(lo, hi, v[2]) -> .Post
        buf.eq_at(lo, hi, v[3]) -> .Put
        buf.eq_at(lo, hi, v[4]) -> .Delete
        buf.eq_at(lo, hi, v[5]) -> .Patch
        buf.eq_at(lo, hi, v[6]) -> .Options
        buf.eq_at(lo, hi, v[7]) -> .Connect
        buf.eq_at(lo, hi, v[8]) -> .Trace
        _ -> .Other
    }
}

/// Every field line from `from` up to the blank line at `mark`, each
/// as its four offsets onto `out` — the walk a request and a reply
/// share — or the law a line broke.
fn field_lines(buf: Bytes, from: int, mark: int, limits: Limits, mut out: List<int>) -> Refusal? {
    mut at = from
    while at < mark {
        if out.length == 4 * limits.fields { return .FieldCount }
        let eol = buf.index_of(crlf, at)
        let why: Refusal? = field_line(buf, at, eol, limits, out)
        if why != null { return why }
        at = eol + 2
    }
    null
}

/// One field line, `at` up to its CRLF at `eol`: a token, the colon
/// against it, OWS, a value of visible ASCII, OWS — its offsets onto
/// `out`, or the law it broke.
fn field_line(buf: Bytes, at: int, eol: int, limits: Limits, mut out: List<int>) -> Refusal? {
    let n_end = buf.run(at, tchar)
    if n_end == at || buf.at(n_end) != ":".char_code() { return .FieldName }
    let v_lo = past_ows(buf, n_end + 1)
    if buf.run(v_lo, vchar) != eol { return .FieldValue }
    if eol - at > limits.field { return .FieldLength }
    out.push(at)
    out.push(n_end)
    out.push(v_lo)
    out.push(before_ows(buf, v_lo, eol))
    null
}

/// The first non-OWS position at or after `at` — one class-table
/// scan, so a run of a thousand spaces costs one call, not a frame each.
fn past_ows(buf: Bytes, at: int) -> int {
    buf.run(at, ows)
}

/// The end of the value once trailing OWS is dropped — one backward
/// class-table scan, never below `lo`.
fn before_ows(buf: Bytes, lo: int, hi: int) -> int {
    let end = buf.run_back(hi, ows)
    if end < lo { lo } else { end }
}

// ── The framing fields (RFC 9112 §6, 9110 §7.2, §10.1.1) ────────

/// What the framing fields say, folded one field at a time — a VALUE
/// RECORD, every field a scalar, so a request costs no allocation to
/// fold its fields into. `length` means something once `lengths`
/// counts a Content-Length line; `why` is the first law broken, or
/// absent — a nullable WORD ENUM spends its own spare tag, so this
/// stays a register too.
type Framing = { length: int = 0, lengths: int = 0, chunked: bool = false, codings: bool = false, hosts: int = 0, close: bool = false, keep: bool = false, expects: bool = false, why: Refusal? = null }

/// EVERY FRAMING FIELD READ, folded one at a time — the walk a
/// request and a reply share.
fn framing_of(buf: Bytes, fields: Fields) -> Framing {
    mut fr = Framing {}
    for i in 0..fields.count() { fr = noted(buf, fields.name_at(i), fields.value_at(i), fr) }
    fr
}

/// THE BODY LAWS A REQUEST AND A REPLY KEEP ALIKE, or absence. A
/// message is delimited ONE way — a length beside chunks is a length
/// two readers disagree about — a coding this framer does not
/// implement is refused rather than guessed at, and a declared length
/// past the bound is refused before a byte of it arrives. The two
/// callers keep them in ONE spelling: this file composes its classes
/// rather than restating them, and its body laws are no different.
fn body_refusal(fr: Framing, bound: int) -> Refusal? {
    when {
        fr.chunked && fr.lengths > 0 -> .TransferEncoding
        fr.codings -> .Coding
        fr.length > bound -> .BodyLength
        _ -> null
    }
}

/// Whether the connection persists past this message (RFC 9112 §9.3):
/// `close` ends it, and a 1.0 peer keeps it only by saying so.
fn persists(fr: Framing, minor: int) -> bool {
    if fr.close { return false }
    if minor == 0 { return fr.keep }
    true
}

/// The head, once the framing fields have been read and their laws
/// kept: the body's delimiting, persistence, and the expectation.
fn settled(
    buf: Bytes,
    method: Method,
    verb: Span,
    target: Span,
    minor: int,
    fields: Fields,
    end: int,
    limits: Limits,
) -> Framed {
    let fr = framing_of(buf, fields)
    if fr.why != null { return .Refused(fr.why!) }
    if fr.hosts > 1 || minor == 1 && fr.hosts == 0 { return .Refused(.Host) }
    if fr.chunked && minor == 0 { return .Refused(.OldChunked) }
    // a request's body is read piece by piece, so its bound is the stream's
    let broken: Refusal? = body_refusal(fr, limits.stream)
    if broken != null { return .Refused(broken!) }
    let body: RequestBody = when {
        fr.chunked -> .Chunked
        fr.lengths > 0 -> .Length(fr.length)
        _ -> .None
    }
    .Complete(
        Head {
            method: method,
            verb: verb,
            target: target,
            minor: minor,
            fields: fields,
            body: body,
            keep_alive: persists(fr, minor),
            expects_continue: fr.expects && minor == 1,
            end: end,
        },
    )
}

/// One field's contribution to the framing, folded into it — a value
/// in, the value it becomes out, never a write through a seat: that
/// is what keeps `Framing` a register, not a box.
fn noted(buf: Bytes, n: Span, v: Span, fr: Framing) -> Framing {
    if fr.why != null { return fr }
    when {
        buf.ieq_at(n.lo, n.hi, content_length) -> took_length(buf, v, fr)
        buf.ieq_at(n.lo, n.hi, transfer_encoding) -> took_codings(buf, v, fr)
        buf.ieq_at(n.lo, n.hi, host) -> took_host(buf, v, fr)
        buf.ieq_at(n.lo, n.hi, connection) -> took_connection(buf, v, fr)
        buf.ieq_at(n.lo, n.hi, expect) -> took_expectation(buf, v, fr)
        _ -> fr
    }
}

/// The framing refused by the law `why` names.
fn broke(fr: Framing, why: Refusal) -> Framing { fr with { why: why } }

/// A second Content-Length is refused even when it agrees — the
/// permission to merge equal values is a MAY, and this is a server.
fn took_length(buf: Bytes, v: Span, fr: Framing) -> Framing {
    let n? = decimal(buf, v) else { return broke(fr, .ContentLength) }
    if fr.lengths > 0 { return broke(fr, .ContentLength) }
    fr with { length: n, lengths: 1 }
}

/// `chunked` alone frames; other codings before a final `chunked`
/// are not implemented; `chunked` anywhere else is a smuggling shape.
fn took_codings(buf: Bytes, v: Span, fr: Framing) -> Framing {
    let ts = tokens(buf, v)
    if ts.is_empty() { return broke(fr, .TransferEncoding) }
    let last = ts.last()!
    let final_chunked = buf.ieq_at(last.lo, last.hi, chunked)
    let earlier_chunked = ts.slice(0, ts.length - 1).any((t) -> buf.ieq_at(t.lo, t.hi, chunked))
    if !final_chunked && !earlier_chunked { return broke(fr, .Coding) }
    if !final_chunked || earlier_chunked { return broke(fr, .TransferEncoding) }
    fr with { chunked: true, codings: ts.length > 1 }
}

/// A `Host` keeps the one host law; an empty one is refused, though
/// the grammar admits it.
fn took_host(buf: Bytes, v: Span, fr: Framing) -> Framing {
    if !hosted(buf, v.lo, v.hi, false) { return broke(fr, .Host) }
    fr with { hosts: fr.hosts + 1 }
}

fn took_connection(buf: Bytes, v: Span, fr: Framing) -> Framing {
    let ts = tokens(buf, v)
    fr with { close: fr.close || ts.any((t) -> buf.ieq_at(t.lo, t.hi, close)), keep: fr.keep || ts.any((t) -> buf.ieq_at(t.lo, t.hi, keep_alive)) }
}

fn took_expectation(buf: Bytes, v: Span, fr: Framing) -> Framing {
    if buf.ieq_at(v.lo, v.hi, continue_100) { return fr with { expects: true } }
    broke(fr, .Expectation)
}

/// `1*DIGIT`, at most eighteen of them, as a number — or null.
fn decimal(buf: Bytes, v: Span) -> int? {
    if v.hi == v.lo || v.hi - v.lo > 18 || buf.run(v.lo, digit) != v.hi { return null }
    mut n = 0
    for i in v.lo..v.hi { n = n * 10 + buf.at(i) - "0".char_code() }
    n
}

/// A comma-separated list's members, each without its OWS; an empty
/// member is dropped (RFC 9110 §5.6.1).
fn tokens(buf: Bytes, v: Span) -> List<Span> {
    mut out: List<Span> = []
    mut at = v.lo
    while at <= v.hi {
        let comma_at = buf.index_in(comma_mark, at, v.hi)
        let cut = if comma_at < 0 { v.hi } else { comma_at }
        let lo = past_ows(buf, at)
        let hi = before_ows(buf, lo, cut)
        if hi > lo { out.push(Span { lo: lo, hi: hi }) }
        at = cut + 1
    }
    out
}

// ── A reply's head (RFC 9112 §4, §6.3; 9110 §15) ──────────────────

/// A framed reply. Spans index the buffer it was framed from; `end`
/// is the first byte past the blank line.
export type Reply = { status: int, minor: int, fields: Fields, body: ReplyBody, keep_alive: bool, end: int }

/// How a reply's body is delimited: not at all, by a length, by
/// chunks, or by the connection's close (RFC 9112 §6.3).
export enum ReplyBody { None, Length(n: int), Chunked, UntilClose }

/// `Framed`'s twin for a reply.
export enum FramedReply {
    Partial
    Complete(reply: Reply)
    Refused(why: Refusal)
}

/// The reply at `from` to a request made with `asked`, or why not.
/// `scanned` is as `framed`'s.
export fn framed_reply(buf: Bytes, from: int, scanned: int, limits: Limits, asked: Method) -> FramedReply {
    let mark = buf.index_of(blank_line, if scanned - 3 > from { scanned - 3 } else { from })
    if mark < 0 { return reply_unfinished(buf, from, limits) }
    if mark + 4 - from > limits.head { return .Refused(.HeadLength) }
    if !crlf_only(buf, from, mark) { return .Refused(.LineEnd) }
    status_line(buf, from, mark, limits, asked)
}

/// The reply's head at `from` with every obs-fold — the whitespace
/// around a line end that continues the field before it — spelled as
/// spaces, which a user agent MUST do before it reads a value (RFC 9112
/// §5.2); the buffer itself while the head is unfinished or folds
/// nothing. A fold keeps its length, so every offset past it stands. A
/// request is never unfolded: a server refuses the fold instead.
export fn unfolded(buf: Bytes, from: int, scanned: int) -> Bytes {
    let mark = buf.index_of(blank_line, if scanned - 3 > from { scanned - 3 } else { from })
    if mark < 0 { return buf }
    let folds = folds_in(buf, from, mark)
    if folds.is_empty() { return buf }
    mut out = "".bytes()
    mut at = 0
    for f in folds {
        let lo = if f.lo > at { f.lo } else { at }
        out = out.concat(buf.slice(at, lo)).concat([32 for i in lo..f.hi].bytes()!)
        at = f.hi
    }
    out.concat(buf.slice(at, buf.length))
}

/// Every obs-fold in `from..mark` — `OWS CRLF RWS` — as the span it
/// covers, in order; a run of whitespace is walked by the one fold it
/// precedes, so the whole head costs one pass.
fn folds_in(buf: Bytes, from: int, mark: int) -> List<Span> {
    mut folds: List<Span> = []
    mut p = buf.index_of(crlf, from)
    while p >= 0 && p < mark {
        if is_ows(buf.at(p + 2)) { folds.push(Span { lo: ows_before(buf, p, from), hi: buf.run(p + 2, ows) }) }
        p = buf.index_of(crlf, p + 2)
    }
    folds
}

/// Where the whitespace ending at `at` begins, no earlier than `from`.
fn ows_before(buf: Bytes, at: int, from: int) -> int {
    mut lo = at
    while lo > from && is_ows(buf.at(lo - 1)) { lo = lo - 1 }
    lo
}

fn reply_unfinished(buf: Bytes, from: int, limits: Limits) -> FramedReply {
    match unfinished(buf, from, limits) {
        .Refused(why) -> .Refused(why),
        .Partial or .Complete(_) -> .Partial,
    }
}

/// `HTTP/1.x SP 3DIGIT SP reason` — the version's laws are the
/// request line's, the status three digits, the reason anything
/// visible.
fn status_line(buf: Bytes, from: int, mark: int, limits: Limits, asked: Method) -> FramedReply {
    let eol = buf.index_of(crlf, from)
    if eol - from > limits.line { return .Refused(.LineLength) }
    if eol - from < 12 ||
        buf.at(from + 8) != " ".char_code() ||
        buf.at(from + 12) != " ".char_code() && eol != from + 12 {
        return .Refused(.RequestLine)
    }
    if !versioned(buf, from, from + 8) { return .Refused(.Version) }
    if buf.at(from + 5) != "1".char_code() { return .Refused(.Major) }
    if buf.run(from + 9, digit) != from + 12 { return .Refused(.RequestLine) }
    let reason_lo = if eol == from + 12 { eol } else { from + 13 }
    if buf.run(reason_lo, vchar) != eol { return .Refused(.RequestLine) }
    let status = (buf.at(from + 9) - "0".char_code()) * 100 +
        (buf.at(from + 10) - "0".char_code()) * 10 +
        buf.at(from + 11) - "0".char_code()
    mut fs: List<int> = []
    let why: Refusal? = field_lines(buf, eol + 2, mark, limits, fs)
    if why != null { return .Refused(why!) }
    settled_reply(
        buf,
        status,
        buf.at(from + 7) - "0".char_code(),
        Fields(fs),
        mark + 4,
        limits,
        asked,
    )
}

/// A reply's body is delimited by its status and the request's method
/// before any field (RFC 9112 §6.3): none for a HEAD's answer, a 1xx,
/// a 204, a 304 or a CONNECT's 2xx — a tunnel, whose length fields are
/// ignored; then chunks; then a length; then the close.
fn settled_reply(
    buf: Bytes,
    status: int,
    minor: int,
    fields: Fields,
    end: int,
    limits: Limits,
    asked: Method,
) -> FramedReply {
    let fr = framing_of(buf, fields)
    if fr.why != null { return .Refused(fr.why!) }
    if fr.chunked && minor == 0 { return .Refused(.OldChunked) }
    // a reply's body is gathered whole, so its bound is the gathered one
    let broken: Refusal? = body_refusal(fr, limits.body)
    if broken != null { return .Refused(broken!) }
    let bodiless = asked is .Head ||
        status < 200 ||
        status == 204 ||
        status == 304 ||
        asked == Method.Connect && status < 300
    let body: ReplyBody = when {
        bodiless -> .None
        fr.chunked -> .Chunked
        fr.lengths > 0 -> .Length(fr.length)
        _ -> .UntilClose
    }
    .Complete(
        Reply {
            status: status,
            minor: minor,
            fields: fields,
            body: body,
            keep_alive: persists(fr, minor) && !(body is .UntilClose),
            end: end,
        },
    )
}

// ── The chunked body (RFC 9112 §7.1) ────────────────────────────

/// Where a chunked body's decoding stands: at a size line, inside a
/// chunk still owed `n` octets and then its CRLF (`Data(0)` owes only
/// the CRLF), or in the trailers.
export enum Phase {
    Size
    Data(n: int)
    Trailers
}

/// A chunked body in flight — the decoder's position in the buffer it
/// reads, its phase, the octets it has handed out, the pieces a
/// GATHERING reader keeps (`fed` fills them; a streaming one never
/// does), and the trailers seen.
export type Chunker = { at: int, phase: Phase, total: int, parts: List<Bytes>, trailers: int }

/// A decoder starting at `at` — the first byte past the head.
export fn chunker(at: int) -> Chunker { Chunker { at: at, phase: Phase.Size, total: 0, parts: [], trailers: 0 } }

/// What a GATHERING feed answers: keep the decoder and feed again, the
/// body whole with the offset past the trailers, or the law it broke.
export enum Chunked {
    More(c: Chunker)
    Done(body: Bytes, end: int)
    Refused(why: Refusal)
}

/// What one STREAMING step answers: a piece of the body, the decoder
/// wanting more octets, the body's end with the offset past its
/// trailers, or the law it broke.
export enum Decoded {
    Piece(b: Bytes, c: Chunker)
    More(c: Chunker)
    Done(end: int)
    Refused(why: Refusal)
}

enum Step {
    Again(c: Chunker)
    Piece(b: Bytes, c: Chunker)
    Wait(c: Chunker)
    Done(end: int)
    Refused(why: Refusal)
}

/// THE CHUNK DECODER, one piece at a time: the next piece of the body
/// in `buf` — as much of the current chunk as has arrived, so a chunk
/// of any size costs no more memory than one read — or the decoder
/// wanting more, or the end, or why not. `bound` is the most the body
/// may carry. Line ends are CRLF only; a size is 1..16 hex digits and
/// only an extension may follow it; trailers are field lines, parsed
/// and dropped — a trailer can never re-frame, route or authenticate.
export fn unchunked(c: Chunker, buf: Bytes, bound: int, limits: Limits) -> Decoded {
    mut cur = c
    while true {
        match stepped(cur, buf, bound, limits) {
            .Again(next) -> { cur = next },
            .Piece(b, next) -> { return .Piece(b, next) },
            .Wait(next) -> { return .More(next) },
            .Done(end) -> { return .Done(end) },
            .Refused(why) -> { return .Refused(why) },
        }
    }
    .More(cur)
}

/// The decoder advanced over `buf` as far as its bytes allow, every
/// piece KEPT: the body whole with the offset past the trailers' blank
/// line, the decoder to feed again, or why not. The gathering reader of
/// `unchunked`, bounded by `limits.body`.
export fn fed(c: Chunker, buf: Bytes, limits: Limits) -> Chunked {
    mut cur = c
    while true {
        match unchunked(cur, buf, limits.body, limits) {
            .Piece(b, next) -> { cur = next with { parts: next.parts.concat([b]) } },
            .More(next) -> { return .More(next) },
            .Done(end) -> { return .Done(cur.parts.bytes(), end) },
            .Refused(why) -> { return .Refused(why) },
        }
    }
    .More(cur)
}

fn stepped(c: Chunker, buf: Bytes, bound: int, limits: Limits) -> Step {
    match c.phase {
        .Size -> size_step(c, buf, bound, limits),
        .Data(n) -> data_step(c, n, buf),
        .Trailers -> trailer_step(c, buf, limits),
    }
}

fn size_step(c: Chunker, buf: Bytes, bound: int, limits: Limits) -> Step {
    let size_end = buf.run(c.at, hexdigit)
    if size_end - c.at > 16 { return .Refused(.Chunk) }
    if size_end == buf.length { return .Wait(c) }
    if size_end == c.at { return .Refused(.Chunk) }
    if size_end - c.at == 16 { return .Refused(.BodyLength) }
    let size = hex_value(buf, c.at, size_end)
    if c.total + size > bound { return .Refused(.BodyLength) }
    let eol = size_line_end(buf, size_end, limits)
    if eol == -1 { return .Wait(c) }
    if eol < -1 { return .Refused(.Chunk) }
    .Again(c with { at: eol + 2, phase: if size == 0 { Phase.Trailers } else { Phase.Data(size) } })
}

/// Inside a chunk: what of its `n` owed octets has arrived is a piece;
/// with none owed, its CRLF closes it.
fn data_step(c: Chunker, n: int, buf: Bytes) -> Step {
    if n == 0 { return chunk_closed(c, buf) }
    let here = buf.length - c.at
    if here <= 0 { return .Wait(c) }
    let k = if here < n { here } else { n }
    .Piece(
        buf.slice(c.at, c.at + k),
        c with { at: c.at + k, phase: Phase.Data(n - k), total: c.total + k },
    )
}

fn chunk_closed(c: Chunker, buf: Bytes) -> Step {
    if c.at + 2 > buf.length { return .Wait(c) }
    if !buf.eq_at(c.at, c.at + 2, crlf) { return .Refused(.Chunk) }
    .Again(c with { at: c.at + 2, phase: Phase.Size })
}

fn trailer_step(c: Chunker, buf: Bytes, limits: Limits) -> Step {
    if c.at + 2 > buf.length { return .Wait(c) }
    if buf.eq_at(c.at, c.at + 2, crlf) { return .Done(c.at + 2) }
    if c.trailers == limits.trailers { return .Refused(.Chunk) }
    let eol = buf.index_of(crlf, c.at)
    if eol < 0 { return if crlf_only(buf, c.at, buf.length - 1) { .Wait(c) } else { .Refused(.LineEnd) } }
    if !crlf_only(buf, c.at, eol) { return .Refused(.LineEnd) }
    // a trailer is judged by the field law and dropped
    mut dropped: List<int> = []
    let why: Refusal? = field_line(buf, c.at, eol, limits, dropped)
    if why != null { return .Refused(why!) }
    .Again(c with { at: eol + 2, trailers: c.trailers + 1 })
}

/// Where the size line's CRLF begins, past an extension: -1 when the
/// line has not fully arrived, -2 when it is malformed or too long.
/// Bad whitespace before an extension's `;` is parsed and dropped
/// (RFC 9110 §5.6.3); whitespace before anything else is refused.
fn size_line_end(buf: Bytes, at: int, limits: Limits) -> int {
    let semi = buf.run(at, ows)
    if semi - at > limits.ext { return -2 }
    if semi == buf.length { return -1 }
    let opens = buf.at(semi) == ";".char_code()
    if semi > at && !opens { return -2 }
    let ext_end = if opens { buf.run(semi, vchar) } else { at }
    if ext_end - at > limits.ext { return -2 }
    if ext_end == buf.length { return -1 }
    if buf.at(ext_end) != "\r".char_code() { return -2 }
    if ext_end + 1 == buf.length { return -1 }
    if buf.at(ext_end + 1) != "\n".char_code() { -2 } else { ext_end }
}

/// ONE HEX DIGIT'S VALUE, or absence when the octet is not one — the
/// ONE hex law this package has. A chunk size reads it and so does a
/// percent-escape; spelled twice, a lenient reader and a strict one
/// would disagree about the same two octets.
export fn hex_of(c: int) -> int? {
    if is_digit(c) { return c - "0".char_code() }
    if c >= "A".char_code() && c <= "F".char_code() { return c - "A".char_code() + 10 }
    if c >= "a".char_code() && c <= "f".char_code() { return c - "a".char_code() + 10 }
    null
}

fn is_hex(c: int) -> bool { hex_of(c) != null }
const hexdigit: Bytes = admits(is_hex)

/// The value of 1..15 hex digits — under 2^60, so it fits a signed
/// word; a sixteenth digit is past any body bound before it is read.
export fn hex_value(buf: Bytes, lo: int, hi: int) -> int {
    mut n = 0
    for i in lo..hi { n = n * 16 + hex_of(buf.at(i))! }
    n
}
