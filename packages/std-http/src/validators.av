//! VALIDATORS — the conditional-request law the files and the served
//! assets share: whether an `If-None-Match` field names the tag a
//! response carries, so the answer is a 304 and no body.

/// Whether an `If-None-Match` list names `tag` — weakly, as the field
/// compares — or is `*`.
export fn tag_listed(field: string?, tag: string) -> bool {
    let list? = field else { return false }
    list.trim() == "*" || list.split(",").any(weak_same(it.trim(), tag))
}

fn weak_same(listed: string, tag: string) -> bool {
    let opaque = if listed.starts_with("W/") { listed.substring(2, listed.length) } else { listed }
    opaque == tag
}
