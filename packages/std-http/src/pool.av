//! pool.av — connections kept between requests, one bucket per ORIGIN.
//!
//! AN ORIGIN IS (scheme, host, port), spelled once by `origin_of`, so a
//! connection made for `http://h:80` is never lent to `https://h:443`
//! nor to another host that resolves to the same address.
//!
//! A CONNECTION IS LENT, THEN GIVEN BACK OR DROPPED. `take` answers the
//! most recently kept connection that is still sound, or dials a new
//! one; whoever took it hands it back with `give`, which keeps it only
//! when the reply said it persists and nothing arrived past it, and
//! closes it otherwise. A kept connection that has turned readable
//! while idle — the peer closed it, or sent bytes nobody asked for — is
//! closed at `take`, never lent.
//!
//! TWO BOUNDS, BOTH PER ORIGIN, BOTH REFUSALS RATHER THAN WAITS.
//! `per_host` caps the connections lent out at once: the next `take`
//! answers `.Exhausted` rather than dialing past it. `idle_per_host`
//! caps how many are kept, and `idle` how long one is kept: an expired
//! one is closed the next time the pool is touched, or by `reap`.
//!
//! A CARRIER IS WHAT A POOL HOLDS. Today that is an HTTP/1.1 client,
//! one request at a time. An HTTP/2 connection carries many at once and
//! joins `Carrier` as a variant; every match over it then names what a
//! multiplexed connection does at take, give and close.
use @std.time.{Duration, now_ms, secs}
use @std.net.{NetError}
use client.{Client, ClientError}

/// What a pool keeps per origin.
export enum Carrier {
    H1(client: Client)
}

/// What makes a new carrier when none is kept.
export alias Dialer = fn() -> Result<Carrier, ClientError>

/// A kept carrier, its origin, and when it was kept.
export type Idle = { origin: string, carrier: Carrier, since: int }

/// How many carriers are lent out for one origin; an origin with none
/// out has no row, so the table holds only origins in use.
export type Lent = { origin: string, n: int }

/// Connections per origin, lent and kept under bounds a caller names.
export type Pool = {
    per_host: int = 16,
    idle_per_host: int = 4,
    idle: Duration = secs(60),
    kept: Cell<List<Idle>> = Cell.new([]),
    out: Cell<List<Lent>> = Cell.new([]),
}

/// A pool with the default bounds.
export fn pool() -> Pool { Pool {} }

/// The one spelling of an origin: the scheme, the host as a resolver
/// reads it, and the port.
export fn origin_of(scheme: string, host: string, port: int) -> string { "${scheme}://${host}:${port}" }

impl Pool {
    /// A carrier for `origin`: the most recently kept one still sound,
    /// or one `dial` makes — refused when `per_host` are already out.
    /// The slot is held before the dial parks, so tasks racing for the
    /// last one cannot both win it.
    fn take(origin: string, dial: Dialer) -> Result<Carrier, ClientError> {
        self.reap()
        let reused? = self.reused(origin) else { return self.dialed(origin, dial) }
        self.lend(origin, 1)
        .Ok(reused)
    }

    /// A lent carrier handed back: kept when it may carry another
    /// request and the origin has room, closed otherwise.
    fn give(origin: string, c: Carrier) {
        self.lend(origin, -1)
        if !reusable(c) || self.kept_for(origin) >= self.idle_per_host { return closed(c) }
        self.kept.push(Idle { origin: origin, carrier: c, since: now_ms() })
    }

    /// A lent carrier that failed, closed and its slot freed.
    fn drop(origin: string, c: Carrier) {
        self.lend(origin, -1)
        closed(c)
    }

    /// Every kept carrier past its idle time, closed; answers how many.
    fn reap() -> int {
        let now = now_ms()
        let all = self.kept.get()
        let stale = [i for i in all if now - i.since >= self.idle.ms]
        if stale.is_empty() { return 0 }
        self.kept.set([i for i in all if now - i.since < self.idle.ms])
        for i in stale { closed(i.carrier) }
        stale.length
    }

    /// Every kept carrier closed; answers how many.
    fn close_all() -> int {
        let all = self.kept.get()
        self.kept.set([])
        for i in all { closed(i.carrier) }
        all.length
    }

    /// How many carriers are lent out for `origin`.
    fn lent(origin: string) -> int { self.out.get().find(it.origin == origin)?.n ?? 0 }

    /// How many carriers are kept for `origin`.
    fn kept_for(origin: string) -> int { [i for i in self.kept.get() if i.origin == origin].length }

    /// The origin's count moved by `by`, never below zero — a give no
    /// take preceded must not buy a slot past `per_host` — and its row
    /// dropped at zero.
    fn lend(origin: string, by: int) {
        let n = self.lent(origin) + by
        let others = [l for l in self.out.get() if l.origin != origin]
        self.out.set(if n > 0 { others.concat([Lent { origin: origin, n: n }]) } else { others })
    }

    /// The newest kept carrier for `origin` that is still sound, taken
    /// out of the pool; every unsound one met on the way is closed.
    fn reused(origin: string) -> Carrier? {
        let all = self.kept.get()
        let at = [k for k, i in all if i.origin == origin].last() ?? -1
        if at < 0 { return null }
        let c = all[at].carrier
        self.kept.set([i for k, i in all if k != at])
        if sound(c) { return c }
        closed(c)
        self.reused(origin)
    }

    fn dialed(origin: string, dial: Dialer) -> Result<Carrier, ClientError> {
        if self.lent(origin) >= self.per_host { return .Err(.Exhausted(origin, self.per_host)) }
        self.lend(origin, 1)
        match dial() {
            .Ok(c) -> .Ok(c),
            .Err(e) -> {
                self.lend(origin, -1)
                .Err(e)
            },
        }
    }
}

fn reusable(c: Carrier) -> bool {
    match c { .H1(client) -> client.reusable() }
}

/// Whether a kept carrier can be lent: its socket has nothing to say.
/// A read that finds data or the end means the peer moved on.
fn sound(c: Carrier) -> bool {
    match c { .H1(client) -> client.conn.wire_silent() }
}

fn closed(c: Carrier) {
    match c { .H1(client) -> { let _ = client.close() } }
}
