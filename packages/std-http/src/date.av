//! date.av — HTTP's dates: the `date` field an origin server with a
//! clock writes on every response (RFC 9110 §6.6.1), in IMF-fixdate
//! (§5.6.7), and the civil calendar both directions of a date share.
//!
//! THE FIELD IS FORMATTED WHEN THE SECOND TURNS, never per response:
//! each core keeps its last line and the second it names, and a
//! response reads the clock and compares. A clock that steps back
//! names a different second too, so the line follows it either way.
//!
//! A CLOCK THAT CANNOT NAME THE DATE SENDS NONE: IMF-fixdate spells a
//! year in four digits from 1970's side of the epoch, and a host
//! outside that is a server with no reasonable clock, which the RFC
//! says MUST NOT send the field.
use @std.time.{wall_secs}

/// The `date` field line for this second — `date: <IMF-fixdate>` and
/// its CRLF — or empty when the clock cannot name the date.
export fn date_line() -> Bytes {
    let now = wall_secs()
    let s = stamp()
    if s.second.get() != now {
        s.second.set(now)
        s.line.set(line_at(now))
    }
    s.line.get()
}

/// A core's last date line and the second it names.
type Stamp = { second: Cell<int>, line: Cell<Bytes> }

once fn stamp() -> Stamp {
    let now = wall_secs()
    Stamp { second: Cell.new(now), line: Cell.new(line_at(now)) }
}

fn line_at(secs: int) -> Bytes {
    let d? = imf_date(secs) else { return "".bytes() }
    "date: ${d}\r\n".bytes()
}

/// Seconds since 1970 as an IMF-fixdate — `Sun, 06 Nov 1994 08:49:37
/// GMT` — or null outside 1970 through 9999.
export fn imf_date(secs: int) -> string? {
    if secs < 0 || secs >= last_second { return null }
    let days = secs / 86400
    let c = civil_of(days)
    let t = secs % 86400
    "${weekdays[(days + 4) % 7]}, ${two(c.day)} ${month_names[c.month - 1]} ${c.year} ${two(t / 3600)}:${two(t / 60 % 60)}:${two(t % 60)} GMT"
}

/// The first second past 9999-12-31 23:59:59 UTC.
const last_second: int = 253402300800

/// A number of 0 to 99 in two digits.
fn two(n: int) -> string { if n < 10 { "0${n}" } else { "${n}" } }

/// A day of the proleptic Gregorian calendar.
export type Civil = { year: int, month: int, day: int }

/// The civil date `days` after 1970-01-01, for days from 0 on.
export fn civil_of(days: int) -> Civil {
    let z = days + 719468
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let month = if mp < 10 { mp + 3 } else { mp - 9 }
    Civil {
        year: yoe + era * 400 + if month <= 2 { 1 } else { 0 },
        month: month,
        day: doy - (153 * mp + 2) / 5 + 1,
    }
}

/// Days from 1970-01-01 to a civil date, for a year from 1601 on.
export fn civil_days(year: int, month: int, day: int) -> int {
    let y = if month <= 2 { year - 1 } else { year }
    let era = y / 400
    let yoe = y - era * 400
    let doy = (153 * ((month + 9) % 12) + 2) / 5 + day - 1
    era * 146097 + yoe * 365 + yoe / 4 - yoe / 100 + doy - 719468
}

/// The days of the week from Sunday, 1970-01-01 being a Thursday.
const weekdays: List<string> = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]

const month_names: List<string> = [
    "Jan",
    "Feb",
    "Mar",
    "Apr",
    "May",
    "Jun",
    "Jul",
    "Aug",
    "Sep",
    "Oct",
    "Nov",
    "Dec",
]
