//! HTTP/2 — the framer and the connection (RFC 9113), over `Bytes`.
//!
//! A connection is ONE VALUE the server holds and feeds: `fed` takes
//! every whole frame a buffer holds, moves the streams, the windows and
//! the HPACK tables, and leaves what it owes the peer in `out` and the
//! requests it completed in `ready`. Nothing here touches a socket, so
//! every law is a fixture over bytes.
//!
//! A LAW BROKEN ON ONE STREAM RESETS THAT STREAM; a law broken on the
//! connection ends it with GOAWAY. Which is which is the RFC's, arm by
//! arm. A header block is decoded WHOLE even for a stream that will be
//! refused, because the peer's HPACK table moved when it wrote it.
//!
//! A request is whole when its stream ends: its head decoded and held
//! to §8's laws, its body gathered under the bound, its declared length
//! kept. A stream IS a request; what answers it is the server's.
use hpack.{HeaderField, Decoder, Encoder, decoder, encoder, field, int_bound}
use frame.{Limits, admits, is_tchar, is_vchar, is_target, no_bytes}

// ── Codes ───────────────────────────────────────────────────────

/// The error codes (§7) — each a law's name on the wire.
export enum H2Error {
    NoError
    Protocol
    Internal
    FlowControl
    SettingsTimeout
    StreamClosed
    FrameSize
    RefusedStream
    Cancel
    Compression
    Connect
    EnhanceYourCalm
    InadequateSecurity
    Http11Required
}

/// An error's code on the wire.
export fn error_code(e: H2Error) -> int {
    match e {
        .NoError -> 0,
        .Protocol -> 1,
        .Internal -> 2,
        .FlowControl -> 3,
        .SettingsTimeout -> 4,
        .StreamClosed -> 5,
        .FrameSize -> 6,
        .RefusedStream -> 7,
        .Cancel -> 8,
        .Compression -> 9,
        .Connect -> 10,
        .EnhanceYourCalm -> 11,
        .InadequateSecurity -> 12,
        .Http11Required -> 13,
    }
}

/// The frame types (§6), and `Unknown` for a type this end does not
/// implement — which is ignored, never refused (§5.5).
export enum FrameKind { Data, Headers, Priority, Reset, Settings, PushPromise, Ping, GoAway, WindowUpdate, Continuation, Unknown }

/// A type octet's kind.
export fn kind_of(n: int) -> FrameKind {
    match n {
        0 -> .Data,
        1 -> .Headers,
        2 -> .Priority,
        3 -> .Reset,
        4 -> .Settings,
        5 -> .PushPromise,
        6 -> .Ping,
        7 -> .GoAway,
        8 -> .WindowUpdate,
        9 -> .Continuation,
        _ -> .Unknown,
    }
}

/// A kind's type octet — `Unknown` has none of its own and writes as
/// the first unassigned type.
export fn kind_code(k: FrameKind) -> int {
    match k {
        .Data -> 0,
        .Headers -> 1,
        .Priority -> 2,
        .Reset -> 3,
        .Settings -> 4,
        .PushPromise -> 5,
        .Ping -> 6,
        .GoAway -> 7,
        .WindowUpdate -> 8,
        .Continuation -> 9,
        .Unknown -> 10,
    }
}

/// END_STREAM on DATA and HEADERS; ACK on SETTINGS and PING — one bit.
export const end_stream: int = 1
export const ack: int = 1
export const end_headers: int = 4
export const padded: int = 8
export const prioritised: int = 32

fn flagged(flags: int, bit: int) -> bool { flags & bit != 0 }

// ── Frames on the wire (§4) ─────────────────────────────────────

/// What a client sends before its first frame (§3.4).
export const preface: Bytes = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n".bytes()

/// One frame: its kind, flags, stream, and payload.
export type Frame = { kind: FrameKind, flags: int, stream: int, payload: Bytes }

/// What a buffer holds at an offset: not yet a whole frame, one frame
/// and the offset past it, or a frame longer than this end allows.
export enum FrameAt {
    Partial
    Whole(frame: Frame, end: int)
    Oversized
}

/// The frame at `at`, or why not. A length past `max` is refused from
/// the nine-octet head alone, before a byte of its payload is held.
export fn frame_at(buf: Bytes, at: int, max: int) -> FrameAt {
    if buf.length - at < 9 { return .Partial }
    let n = (buf.at(at) << 16) | (buf.at(at + 1) << 8) | buf.at(at + 2)
    if n > max { return .Oversized }
    if buf.length - at < 9 + n { return .Partial }
    let f = Frame {
        kind: kind_of(buf.at(at + 3)),
        flags: buf.at(at + 4),
        stream: u32_at(buf, at + 5) & int_bound,
        payload: buf.slice(at + 9, at + 9 + n),
    }
    .Whole(f, at + 9 + n)
}

/// A frame on the wire.
export fn frame_bytes(kind: FrameKind, flags: int, stream: int, payload: Bytes) -> Bytes {
    let n = payload.length
    [(n >> 16) & 255, (n >> 8) & 255, n & 255, kind_code(kind), flags].bytes()!
        .concat(u32_bytes(stream))
        .concat(payload)
}

/// The 32-bit word at `at`, most significant octet first.
export fn u32_at(b: Bytes, at: int) -> int { (b.at(at) << 24) | (b.at(at + 1) << 16) | (b.at(at + 2) << 8) | b.at(at + 3) }

/// `v` as a 32-bit word.
export fn u32_bytes(v: int) -> Bytes { [(v >> 24) & 255, (v >> 16) & 255, (v >> 8) & 255, v & 255].bytes()! }

// ── Settings (§6.5) ─────────────────────────────────────────────

/// One end's settings. `streams` and `list` are unbounded by default,
/// spelled as the largest word.
export type Settings = {
    header_table: int = 4096,
    push: bool = true,
    streams: int = 4294967295,
    window: int = 65535,
    frame: int = 16384,
    list: int = 4294967295,
}

/// The settings this server advertises: a hundred streams at once, a
/// header list no longer than the 1.1 head's bound.
export fn server_settings(limits: Limits) -> Settings { Settings { push: false, streams: 100, list: limits.head } }

/// Settings as a SETTINGS payload: every one that differs from the
/// protocol's default.
export fn settings_payload(s: Settings) -> Bytes {
    let d = Settings {}
    let rows = [
        setting_row(1, s.header_table, d.header_table),
        setting_row(2, if s.push { 1 } else { 0 }, 1),
        setting_row(3, s.streams, d.streams),
        setting_row(4, s.window, d.window),
        setting_row(5, s.frame, d.frame),
        setting_row(6, s.list, d.list),
    ]
    rows.bytes()
}

/// One setting's six octets, or none when it is the default.
fn setting_row(id: int, v: int, default: int) -> Bytes {
    if v == default { return no_bytes }
    [(id >> 8) & 255, id & 255].bytes()!.concat(u32_bytes(v))
}

/// A SETTINGS payload applied over `s`, or the law it broke. An
/// unknown identifier is ignored (§6.5.2).
export fn settings_applied(s: Settings, payload: Bytes) -> Result<Settings, H2Error> {
    if payload.length % 6 != 0 { return .Err(H2Error.FrameSize) }
    mut out = s
    for i in 0..payload.length / 6 {
        let at = 6 * i
        out = setting(out, (payload.at(at) << 8) | payload.at(at + 1), u32_at(payload, at + 2))?
    }
    .Ok(out)
}

/// One setting applied, or the law its value broke.
fn setting(s: Settings, id: int, v: int) -> Result<Settings, H2Error> {
    match id {
        1 -> .Ok(s with { header_table: v }),
        2 -> if v > 1 { .Err(H2Error.Protocol) } else { .Ok(s with { push: v == 1 }) },
        3 -> .Ok(s with { streams: v }),
        4 -> if v > int_bound { .Err(H2Error.FlowControl) } else { .Ok(s with { window: v }) },
        5 -> if v < 16384 || v > 16777215 { .Err(H2Error.Protocol) } else { .Ok(s with { frame: v }) },
        6 -> .Ok(s with { list: v }),
        _ -> .Ok(s),
    }
}

// ── Streams (§5.1) ──────────────────────────────────────────────

/// Where a live stream stands. Idle and closed streams are not held.
export enum StreamState { Open, HalfClosedRemote, HalfClosedLocal }

/// A live stream: its state, both windows, the request's head and the
/// body gathered so far, whether a response head has been written, and
/// the response body still owed because a window is shut.
export type H2Stream = {
    id: int,
    state: StreamState,
    send: int,
    recv: int,
    fields: List<HeaderField>,
    body: Bytes,
    answered: bool,
    owed: Bytes,
}

/// How a stream closed, which decides what a late frame on it means
/// (§5.1): one THIS END reset may still receive what was in flight, so
/// its frames are ignored; one the PEER reset is refused stream by
/// stream; one that ENDED both ways is refused on the connection.
enum Closure { Reset, PeerReset, Ended }

/// A stream no longer live: its id, and how it closed.
type Gone = { id: int, how: Closure }

/// How many closed streams are remembered.
const remembered: int = 256

/// What a stream id stands for right now.
enum Standing {
    Idle
    Live(at: int)
    Closed(how: Closure)
    Forgotten
}

/// Why a header block is being gathered: a request's head, a request's
/// trailers, or a block decoded only to keep HPACK in step — resetting
/// its stream with `why`, or with nothing when it is already gone.
enum Purpose {
    Head
    Trailers
    Discarded(why: H2Error?)
}

/// A header block arriving in pieces (§4.3): the stream, the octets so
/// far, whether the HEADERS ended the stream, why it is gathered, and
/// how many frames it has taken.
type Assembly = { stream: int, block: Bytes, ended: bool, purpose: Purpose, frames: int }

/// The most frames one header block may span.
const block_frames: int = 64

/// A request the connection completed: its stream, its head as decoded
/// and checked, and its whole body.
export type Exchange = { stream: int, fields: List<HeaderField>, body: Bytes }

// ── The connection ──────────────────────────────────────────────

/// One HTTP/2 connection, server side: the settings each end sent, the
/// HPACK state, the live streams and the recently closed ones, the
/// highest stream the peer opened, both connection windows, the header
/// block in flight, and the two things `fed` leaves behind — `out`,
/// what is owed the peer, and `ready`, the requests completed.
/// `closing` is set once GOAWAY is owed: nothing more is read.
/// `parting` is set once the peer sent GOAWAY: no stream opens, and the
/// link ends when it is quiet. `churn` counts the streams that ended in
/// a reset the peer provoked — by resetting one itself or by breaking a
/// stream's law — and `answers` the streams this end answered: churn
/// past its budget ends the connection (`churned`).
export type H2Conn = {
    ours: Settings,
    theirs: Settings,
    limits: Limits,
    decoder: Decoder,
    encoder: Encoder,
    prefaced: bool,
    settled: bool,
    streams: List<H2Stream>,
    gone: List<Gone>,
    last: int,
    send: int,
    recv: int,
    assembling: Assembly?,
    out: Bytes,
    ready: List<Exchange>,
    closing: bool,
    parting: bool,
    churn: int,
    answers: int,
}

/// A server connection awaiting the client's preface, its own SETTINGS
/// already owed (§3.4).
export fn h2_server(limits: Limits) -> H2Conn {
    let ours = server_settings(limits)
    H2Conn {
        ours: ours,
        theirs: Settings {},
        limits: limits,
        decoder: decoder(ours.header_table, ours.list),
        encoder: encoder(true),
        prefaced: false,
        settled: false,
        streams: [],
        gone: [],
        last: 0,
        send: 65535,
        recv: 65535,
        assembling: null,
        out: frame_bytes(.Settings, 0, 0, settings_payload(ours)),
        ready: [],
        closing: false,
        parting: false,
        churn: 0,
        answers: 0,
    }
}

impl H2Conn {
    /// Every whole frame in `buf` from `at` taken; answers the offset
    /// the next read continues from. A connection error leaves GOAWAY
    /// owed and `closing` set.
    mut fn fed(buf: Bytes, at: int) -> int {
        if self.closing { return buf.length }
        let start = self.past_preface(buf, at)
        if start < 0 { return at }
        mut pos = start
        while !self.closing {
            match frame_at(buf, pos, self.ours.frame) {
                .Partial -> { return pos },
                .Oversized -> {
                    self.failed(.FrameSize)
                    return buf.length
                },
                .Whole(f, end) -> {
                    pos = end
                    self.took(f)
                },
            }
        }
        buf.length
    }

    /// The offset past the client's preface — `at` itself once it has
    /// been read — or -1 while it has not all arrived. A preface that
    /// differs ends the connection (§3.4).
    mut fn past_preface(buf: Bytes, at: int) -> int {
        if self.prefaced { return at }
        let have = buf.length - at
        let n = if have < preface.length { have } else { preface.length }
        if !buf.eq_at(at, at + n, preface.slice(0, n)) {
            self.failed(.Protocol)
            return -1
        }
        if have < preface.length { return -1 }
        self.prefaced = true
        at + preface.length
    }

    /// One frame taken, its connection error answered with GOAWAY.
    mut fn took(f: Frame) {
        let why: H2Error? = self.dispatched(f)
        if why != null { self.failed(why!) }
    }

    /// The frame's law, by kind — or the connection error it broke.
    /// The first frame is SETTINGS (§3.4), and a header block in flight
    /// admits nothing but its own CONTINUATIONs (§6.10).
    mut fn dispatched(f: Frame) -> H2Error? {
        if !self.settled && !(f.kind is .Settings && !flagged(f.flags, ack)) { return .Protocol }
        if self.assembling != null &&
            !(f.kind is .Continuation && f.stream == self.assembling!.stream) {
            return .Protocol
        }
        match f.kind {
            .Data -> self.data(f),
            .Headers -> self.headers(f),
            .Priority -> self.priority(f),
            .Reset -> self.reset_by_peer(f),
            .Settings -> self.settings(f),
            .PushPromise -> .Protocol,
            .Ping -> self.ping(f),
            .GoAway -> self.goaway(f),
            .WindowUpdate -> self.window_update(f),
            .Continuation -> self.continuation(f),
            .Unknown -> null,
        }
    }

    // ── H2Stream bookkeeping ──────────────────────────────────────

    /// Where live stream `id` sits in `streams`, or absent.
    fn live_at(id: int) -> int? { self.streams.find_index(it.id == id) }

    /// What stream `id` stands for.
    fn standing(id: int) -> Standing {
        let at? = self.live_at(id) else { return self.not_live(id) }
        .Live(at)
    }

    fn not_live(id: int) -> Standing {
        if id > self.last { return .Idle }
        let g? = self.gone.find_index(it.id == id) else { return .Forgotten }
        .Closed(self.gone[g].how)
    }

    /// Stream `id` closed, remembered with how it closed.
    mut fn closed(id: int, how: Closure) {
        self.streams = [s for s in self.streams if s.id != id]
        let kept = if self.gone.length >= remembered { self.gone.slice(1, self.gone.length) } else { self.gone }
        self.gone = kept.concat([Gone { id: id, how: how }])
    }

    /// RST_STREAM owed on stream `id`, which closes.
    mut fn reset(id: int, why: H2Error) {
        self.out = self.out.concat(frame_bytes(.Reset, 0, id, u32_bytes(error_code(why))))
        self.closed(id, .Reset)
    }

    /// GOAWAY owed, naming the last stream the peer opened; nothing more
    /// is read (§5.4.1). An error also drops the requests not yet taken
    /// — the connection they came on broke a law.
    mut fn failed(why: H2Error) {
        if !(why is .NoError) { self.ready = [] }
        self.out = self
            .out
            .concat(frame_bytes(.GoAway, 0, 0, u32_bytes(self.last).concat(u32_bytes(error_code(why)))))
        self.closing = true
    }

    /// A graceful end: GOAWAY with no error, and nothing more read.
    mut fn ended() { self.failed(.NoError) }

    // ── DATA (§6.1) ─────────────────────────────────────────────

    mut fn data(f: Frame) -> H2Error? {
        if f.stream == 0 { return .Protocol }
        let body? = unpadded(f) else { return .Protocol }
        let n = f.payload.length
        if n > self.recv { return .FlowControl }
        self.recv = self.recv - n
        self.replenished(0, self.recv)
        match self.standing(f.stream) {
            .Idle or .Forgotten -> .Protocol,
            .Closed(how) -> self.late(f.stream, how),
            .Live(at) -> self.data_on(at, f, body),
        }
    }

    /// DATA on a live stream: its window charged, its body gathered,
    /// the request completed when it ends.
    mut fn data_on(at: int, f: Frame, body: Bytes) -> H2Error? {
        let s = self.streams[at]
        if s.state is .HalfClosedRemote { return self.stream_error(s.id, .StreamClosed) }
        let n = f.payload.length
        if n > s.recv { return self.stream_error(s.id, .FlowControl) }
        if s.body.length + body.length > self.limits.body { return self.refused_with(s.id, 413) }
        self.streams[at].recv = s.recv - n
        self.streams[at].body = s.body.concat(body)
        if !flagged(f.flags, end_stream) {
            self.replenished(s.id, s.recv - n)
            return null
        }
        self.remote_ended(at)
    }

    /// A window that fell below half given back whole: a body is paced
    /// by the bound on it, never by the window's size, and a flood of
    /// one-octet DATA frames earns one WINDOW_UPDATE per half a window,
    /// never one per frame.
    mut fn replenished(stream: int, left: int) {
        let n = self.ours.window - left
        if left * 2 >= self.ours.window || n <= 0 { return }
        self.out = self.out.concat(frame_bytes(.WindowUpdate, 0, stream, u32_bytes(n)))
        if stream == 0 { self.recv = self.recv + n } else { self.refilled(stream, n) }
    }

    mut fn refilled(stream: int, n: int) {
        let at? = self.live_at(stream) else { return }
        self.streams[at].recv = self.streams[at].recv + n
    }

    /// The peer ended the stream at `at`: the request is whole — its
    /// declared length kept (§8.1.1) — and ready, unless this end has
    /// already answered it, when the stream simply closes.
    mut fn remote_ended(at: int) -> H2Error? {
        let s = self.streams[at]
        if !length_kept(s.fields, s.body.length) { return self.stream_error(s.id, .Protocol) }
        if s.state is .HalfClosedLocal {
            self.closed(s.id, .Ended)
            return null
        }
        self.streams[at].state = .HalfClosedRemote
        self.ready = self.ready.concat([Exchange { stream: s.id, fields: s.fields, body: s.body }])
        null
    }

    /// A stream error: RST_STREAM owed, and the connection lives on —
    /// unless the peer's churn is past its budget.
    mut fn stream_error(id: int, why: H2Error) -> H2Error? {
        self.reset(id, why)
        self.churn = self.churn + 1
        self.churned()
    }

    /// ENHANCE_YOUR_CALM once the streams the peer made end in a reset
    /// outnumber twice the concurrency bound plus the streams answered
    /// (§10.5): a client that cancels no more than it lets finish never
    /// meets it, and a stream of open-then-reset — rapid reset, or a
    /// peer that makes this end reset for it — meets it in bounded work.
    fn churned() -> H2Error? {
        if self.churn > 2 * self.ours.streams + self.answers { return .EnhanceYourCalm }
        null
    }

    /// A request refused with a bare status. A stream the peer has not
    /// ended is then reset with NO_ERROR, asking it to stop sending
    /// (§8.1), and what it had in flight is ignored.
    mut fn refused_with(id: int, status: int) -> H2Error? {
        self.respond(id, [field(":status", "${status}")], no_bytes)
        if self.live_at(id) != null { self.reset(id, .NoError) }
        null
    }

    // ── HEADERS and CONTINUATION (§6.2, §6.10) ──────────────────

    mut fn headers(f: Frame) -> H2Error? {
        if f.stream == 0 || f.stream % 2 == 0 { return .Protocol }
        let body? = unpadded(f) else { return .Protocol }
        let lead = if flagged(f.flags, prioritised) { 5 } else { 0 }
        if body.length < lead { return .FrameSize }
        let fragment = body.slice(lead, body.length)
        let depends = if lead > 0 { u32_at(body, 0) & int_bound } else { -1 }
        let purpose = match self.purpose_of(f, depends) { .Ok(p) -> p, .Err(why) -> { return why } }
        let a = Assembly {
            stream: f.stream,
            block: fragment,
            ended: flagged(f.flags, end_stream),
            purpose: purpose,
            frames: 1,
        }
        if !flagged(f.flags, end_headers) {
            self.assembling = a
            return null
        }
        self.assembled(a)
    }

    /// Why this HEADERS is gathered, opening its stream when it is a
    /// new request — a stream past the concurrency bound is refused, and
    /// one that depends on itself is malformed (§5.3.1) — or the
    /// connection error it is: a stream id below one already opened and
    /// not remembered closed (§5.1.1), or one that ended (§5.1).
    mut fn purpose_of(f: Frame, depends: int) -> Result<Purpose, H2Error> {
        match self.standing(f.stream) {
            .Idle -> .Ok(self.opened(f.stream, depends)),
            .Live(at) -> .Ok(self.trailers_of(at, f)),
            .Closed(how) -> self.late_purpose(how),
            .Forgotten -> .Err(H2Error.Protocol),
        }
    }

    /// A late DATA on a closed stream, answered as its closure says.
    mut fn late(id: int, how: Closure) -> H2Error? {
        match how {
            .Reset -> null,
            .PeerReset -> self.stream_error(id, .StreamClosed),
            .Ended -> .StreamClosed,
        }
    }

    /// A late HEADERS on a closed stream: its block is still decoded, and
    /// then ignored, reset, or — on a stream that ended — the connection
    /// ends.
    fn late_purpose(how: Closure) -> Result<Purpose, H2Error> {
        match how {
            .Reset -> .Ok(.Discarded(null)),
            .PeerReset -> .Ok(.Discarded(H2Error.StreamClosed)),
            .Ended -> .Err(H2Error.StreamClosed),
        }
    }

    mut fn opened(id: int, depends: int) -> Purpose {
        self.last = id
        if depends == id { return .Discarded(H2Error.Protocol) }
        if self.streams.length >= self.ours.streams { return .Discarded(H2Error.RefusedStream) }
        let s = H2Stream {
            id: id,
            state: .Open,
            send: self.theirs.window,
            recv: self.ours.window,
            fields: [],
            body: no_bytes,
            answered: false,
            owed: no_bytes,
        }
        self.streams = self.streams.concat([s])
        .Head
    }

    /// A second HEADERS on a live stream is its trailers, which must
    /// end it (§8.1).
    fn trailers_of(at: int, f: Frame) -> Purpose {
        if self.streams[at].state is .HalfClosedRemote { return .Discarded(H2Error.StreamClosed) }
        if !flagged(f.flags, end_stream) { return .Discarded(H2Error.Protocol) }
        .Trailers
    }

    mut fn continuation(f: Frame) -> H2Error? {
        let a? = self.assembling else { return .Protocol }
        if a.frames == block_frames || a.block.length + f.payload.length > self.ours.list { return .EnhanceYourCalm }
        let grown = a with { block: a.block.concat(f.payload), frames: a.frames + 1 }
        if !flagged(f.flags, end_headers) {
            self.assembling = grown
            return null
        }
        self.assembling = null
        self.assembled(grown)
    }

    /// A whole header block decoded — always, so the table stays in
    /// step — then taken as its purpose says.
    mut fn assembled(a: Assembly) -> H2Error? {
        self.assembling = null
        match self.decoder.decoded(a.block) {
            .Refused(_) -> .Compression,
            .TooLarge -> self.too_large(a),
            .Fields(fs) -> self.headed(a, fs),
        }
    }

    /// A block past the list bound: a request's head is answered 431,
    /// anything else is reset or ignored as its purpose says.
    mut fn too_large(a: Assembly) -> H2Error? {
        match a.purpose {
            .Head or .Trailers -> self.refused_with(a.stream, 431),
            .Discarded(why) -> self.discarded(a.stream, why),
        }
    }

    /// A discarded block's stream reset with `why` — or left alone
    /// when there is none to give.
    mut fn discarded(id: int, why: H2Error?) -> H2Error? {
        let w? = why else { return null }
        self.stream_error(id, w)
    }

    /// A decoded block taken as its purpose says.
    mut fn headed(a: Assembly, fs: List<HeaderField>) -> H2Error? {
        match a.purpose {
            .Head -> self.head_taken(a, fs),
            .Trailers -> self.trailers_taken(a, fs),
            .Discarded(why) -> self.discarded(a.stream, why),
        }
    }

    mut fn head_taken(a: Assembly, fs: List<HeaderField>) -> H2Error? {
        let at? = self.live_at(a.stream) else { return null }
        if !request_head_kept(fs) { return self.stream_error(a.stream, .Protocol) }
        self.streams[at].fields = fs
        if !a.ended { return null }
        self.remote_ended(at)
    }

    mut fn trailers_taken(a: Assembly, fs: List<HeaderField>) -> H2Error? {
        let at? = self.live_at(a.stream) else { return null }
        if !trailers_kept(fs) { return self.stream_error(a.stream, .Protocol) }
        self.remote_ended(at)
    }

    // ── The small frames ────────────────────────────────────────

    /// PRIORITY is parsed and its laws kept, and its advice ignored
    /// (§5.3.2).
    mut fn priority(f: Frame) -> H2Error? {
        if f.stream == 0 { return .Protocol }
        if f.payload.length != 5 { return self.stream_error(f.stream, .FrameSize) }
        if u32_at(f.payload, 0) & int_bound == f.stream { return self.stream_error(f.stream, .Protocol) }
        null
    }

    mut fn reset_by_peer(f: Frame) -> H2Error? {
        if f.stream == 0 { return .Protocol }
        if f.payload.length != 4 { return .FrameSize }
        match self.standing(f.stream) {
            .Idle -> .Protocol,
            .Closed(_) or .Forgotten -> null,
            .Live(_) -> {
                self.churn = self.churn + 1
                self.ready = [r for r in self.ready if r.stream != f.stream]
                self.closed(f.stream, .PeerReset)
                self.churned()
            },
        }
    }

    mut fn settings(f: Frame) -> H2Error? {
        if f.stream != 0 { return .Protocol }
        if flagged(f.flags, ack) { return if f.payload.length != 0 { H2Error.FrameSize } else { null } }
        let next = match settings_applied(self.theirs, f.payload) {
            .Ok(s) -> s,
            .Err(why) -> { return why },
        }
        let grown = next.window - self.theirs.window
        if self.streams.any(it.send + grown > int_bound) { return .FlowControl }
        self.streams = [s with { send: s.send + grown } for s in self.streams]
        if next.header_table != self.theirs.header_table { self.encoder.resized(next.header_table) }
        self.theirs = next
        self.settled = true
        self.out = self.out.concat(frame_bytes(.Settings, ack, 0, no_bytes))
        self.flushed_all()
        null
    }

    mut fn ping(f: Frame) -> H2Error? {
        if f.stream != 0 { return .Protocol }
        if f.payload.length != 8 { return .FrameSize }
        if !flagged(f.flags, ack) { self.out = self.out.concat(frame_bytes(.Ping, ack, 0, f.payload)) }
        null
    }

    /// The peer is going away: it opens no more streams, and this end
    /// answers the ones it has — reading on, for the WINDOW_UPDATEs and
    /// PINGs those answers still need — then ends once it is quiet
    /// (§6.8).
    mut fn goaway(f: Frame) -> H2Error? {
        if f.stream != 0 { return .Protocol }
        if f.payload.length < 8 { return .FrameSize }
        self.parting = true
        null
    }

    /// GOAWAY owed once a parting peer's streams are all answered and
    /// sent.
    mut fn parted_when_quiet() {
        if self.parting && !self.closing && self.quiet() { self.ended() }
    }

    mut fn window_update(f: Frame) -> H2Error? {
        if f.payload.length != 4 { return .FrameSize }
        let grow = u32_at(f.payload, 0) & int_bound
        if f.stream == 0 { return self.connection_window(grow) }
        if grow == 0 { return self.stream_error(f.stream, .Protocol) }
        match self.standing(f.stream) {
            .Idle -> .Protocol,
            .Closed(_) or .Forgotten -> null,
            .Live(at) -> self.stream_window(at, grow),
        }
    }

    mut fn connection_window(grow: int) -> H2Error? {
        if grow == 0 { return .Protocol }
        if self.send + grow > int_bound { return .FlowControl }
        self.send = self.send + grow
        self.flushed_all()
        null
    }

    mut fn stream_window(at: int, grow: int) -> H2Error? {
        let s = self.streams[at]
        if s.send + grow > int_bound { return self.stream_error(s.id, .FlowControl) }
        self.streams[at].send = s.send + grow
        self.flushed(s.id)
        null
    }

    // ── Answering (§8.1) ────────────────────────────────────────

    /// A response on stream `id`: its head now, split to the peer's frame
    /// size, then as much of `body` as both windows allow — the rest
    /// owed until a WINDOW_UPDATE opens them. A stream that is gone takes
    /// nothing.
    mut fn respond(id: int, fields: List<HeaderField>, body: Bytes) {
        let at? = self.live_at(id) else { return }
        if self.streams[at].answered { return }
        let block = self.encoder.encoded(fields)
        self.out = self.out.concat(header_frames(id, block, body.is_empty(), self.theirs.frame))
        self.streams[at].answered = true
        self.answers = self.answers + 1
        self.streams[at].owed = body
        if body.is_empty() { return self.local_ended(id) }
        self.flushed(id)
    }

    /// Every stream's owed body sent as far as the windows allow.
    mut fn flushed_all() {
        for id in [s.id for s in self.streams if !s.owed.is_empty()] { self.flushed(id) }
    }

    /// Stream `id`'s owed body sent as far as both windows allow, in
    /// frames no longer than the peer takes; the last ends the stream.
    mut fn flushed(id: int) {
        let at? = self.live_at(id) else { return }
        let s = self.streams[at]
        if s.owed.is_empty() { return }
        let room = least(least(self.send, s.send), s.owed.length)
        if room <= 0 { return }
        mut sent = 0
        while sent < room {
            let n = least(room - sent, self.theirs.frame)
            let last = sent + n == s.owed.length
            self.out = self
                .out
                .concat(
                    frame_bytes(
                        .Data,
                        if last { end_stream } else { 0 },
                        id,
                        s.owed.slice(sent, sent + n),
                    ),
                )
            sent = sent + n
        }
        self.send = self.send - room
        self.streams[at].send = s.send - room
        self.streams[at].owed = s.owed.slice(room, s.owed.length)
        if room == s.owed.length { self.local_ended(id) }
    }

    /// This end ended stream `id`: it closes when the peer had ended it
    /// too, and is half closed otherwise.
    mut fn local_ended(id: int) {
        let at? = self.live_at(id) else { return }
        if self.streams[at].state is .HalfClosedRemote { return self.closed(id, .Ended) }
        self.streams[at].state = .HalfClosedLocal
    }

    /// The requests completed since the last ask, taken.
    mut fn taken() -> List<Exchange> {
        let r = self.ready
        self.ready = []
        r
    }

    /// What is owed the peer, taken.
    mut fn drained() -> Bytes {
        let o = self.out
        self.out = no_bytes
        o
    }

    /// How many answer octets are owed and waiting on a window.
    fn owing() -> int {
        mut n = 0
        for st in self.streams { n = n + st.owed.length }
        n
    }

    /// Whether every stream is answered and sent, so a closing link may
    /// part.
    fn quiet() -> bool { self.streams.all(it.answered && it.owed.is_empty()) }
}

fn least(a: int, b: int) -> int { if a < b { a } else { b } }

/// A header block as HEADERS then as many CONTINUATIONs as the peer's
/// frame size needs, END_HEADERS on the last (§4.3).
fn header_frames(id: int, block: Bytes, ends: bool, max: int) -> Bytes {
    let first = least(block.length, max)
    let tail = if ends { end_stream } else { 0 }
    let flags = if first == block.length { tail | end_headers } else { tail }
    mut w = frame_bytes(.Headers, flags, id, block.slice(0, first))
    mut at = first
    while at < block.length {
        let n = least(block.length - at, max)
        w = w
            .concat(
                frame_bytes(
                    .Continuation,
                    if at + n == block.length { end_headers } else { 0 },
                    id,
                    block.slice(at, at + n),
                ),
            )
        at = at + n
    }
    w
}

/// A DATA or HEADERS payload without its padding, or absent when the
/// padding claims the whole frame (§6.1).
fn unpadded(f: Frame) -> Bytes? {
    if !flagged(f.flags, padded) { return f.payload }
    if f.payload.is_empty() { return null }
    let pad = f.payload.at(0)
    if pad >= f.payload.length { return null }
    f.payload.slice(1, f.payload.length - pad)
}

// ── The message's laws (§8.2, §8.3) ─────────────────────────────

/// A request head this server takes: pseudo-fields first, each known
/// and once; `:method`, `:scheme` and a non-empty `:path` — or, for
/// CONNECT, an `:authority` and neither of the others; and every field
/// a field the 1.1 framer would frame, lowercase, and none of the
/// connection-specific ones (§8.2.2).
export fn request_head_kept(fs: List<HeaderField>) -> bool {
    let pseudo = fs.find_index(!is_pseudo(it)) ?? fs.length
    let heads = fs.slice(0, pseudo)
    let rest = fs.slice(pseudo, fs.length)
    rest.all(!is_pseudo(it) && regular_kept(it)) &&
        heads.all(pseudo_kept(it)) &&
        pseudo_shape_kept(heads)
}

/// Trailers carry no pseudo-field, and each is a regular field this
/// server takes.
export fn trailers_kept(fs: List<HeaderField>) -> bool { fs.all(!is_pseudo(it) && regular_kept(it)) }

/// Whether a field is a pseudo-field — its name opens with `:`.
export fn is_pseudo(f: HeaderField) -> bool { f.name.length > 0 && f.name.at(0) == 58 }

/// A known request pseudo-field whose value is non-empty and of its own
/// grammar: `:method` and `:scheme` a token, `:path` and `:authority`
/// the octets a 1.1 target admits — so no space in any of them, and the
/// head they spell for the router reads as the one they mean.
fn pseudo_kept(f: HeaderField) -> bool {
    let class = if f.name == method_name || f.name == scheme_name { token_octet } else { target_octet }
    pseudo_names.any(it == f.name) && !f.value.is_empty() && f.value.run(0, class) == f.value.length
}

/// Each of the four pseudo-fields once; the method's own shape.
fn pseudo_shape_kept(heads: List<HeaderField>) -> bool {
    if pseudo_names.any((n) -> heads.filter(it.name == n).length > 1) { return false }
    let method? = value_named(heads, method_name) else { return false }
    let path = value_named(heads, path_name)
    let scheme = value_named(heads, scheme_name)
    if method == connect_word { return path == null && scheme == null && value_named(heads, authority_name) != null }
    scheme != null && path != null && !path!.is_empty()
}

/// A regular field: a lowercase token name, a value of visible octets
/// with no space at either end, and not a connection-specific field —
/// `te` only as `trailers`.
fn regular_kept(f: HeaderField) -> bool {
    !f.name.is_empty() &&
        f.name.run(0, name_octet) == f.name.length &&
        f.value.run(0, value_octet) == f.value.length &&
        !edged(f.value) &&
        !connection_specific.any(it == f.name) &&
        (f.name != te_name || f.value == trailers_word)
}

fn edged(v: Bytes) -> bool { !v.is_empty() && (is_space(v.at(0)) || is_space(v.at(v.length - 1))) }

fn is_space(c: int) -> bool { c == 32 || c == 9 }

/// A declared `content-length` equals the body's length (§8.1.1); an
/// undeclared one keeps nothing to break.
export fn length_kept(fs: List<HeaderField>, n: int) -> bool {
    let v? = value_named(fs, content_length_name) else { return true }
    v == "${n}".bytes()
}

/// The first value of the field named `name`, or absent.
export fn value_named(fs: List<HeaderField>, name: Bytes) -> Bytes? { fs.find(it.name == name)?.value }

fn is_name_octet(c: int) -> bool { is_tchar(c) && !(c >= 65 && c <= 90) }

const name_octet: Bytes = admits(is_name_octet)
const value_octet: Bytes = admits(is_vchar)
const token_octet: Bytes = admits(is_tchar)
const target_octet: Bytes = admits(is_target)
export const method_name: Bytes = ":method".bytes()
const scheme_name: Bytes = ":scheme".bytes()
export const path_name: Bytes = ":path".bytes()
export const authority_name: Bytes = ":authority".bytes()
const pseudo_names: List<Bytes> = [method_name, scheme_name, path_name, authority_name]
export const connect_word: Bytes = "CONNECT".bytes()
const te_name: Bytes = "te".bytes()
const trailers_word: Bytes = "trailers".bytes()
const content_length_name: Bytes = "content-length".bytes()
export const connection_specific: List<Bytes> = [w.bytes() for w in ["connection", "keep-alive", "proxy-connection", "transfer-encoding", "upgrade"]]
