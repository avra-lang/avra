//! @std.assets — what a file is, read from its leading octets. A
//! `Picture` (PNG, JPEG or SVG) carries the size its header states; a
//! `Blob` is anything. Nothing here reads the host: the build hands
//! these the octets of a file, and a handle is a settled value.

use @std.text.{parse_int}
use @std.meta.{Provider, Marker, Named, sealed}
use @std.url.{Url}

/// Where a picture's pixels come from, and how big it draws. SEALED: a
/// bundled picture is what a kind's `provide` read from a file the build
/// has, a remote one what `remote` accepted — so no value is a remote
/// address the page may not load.
@sealed
export enum Picture {
    /// A file the build has. `name` is its public name: the content's
    /// BLAKE3 (128 bits, hex) and the extension its media type implies, so
    /// one name is one set of octets and may be cached forever. `octets`
    /// are the file itself — a settled const's bytes are the binary's own
    /// static data, so a tree holding the picture holds one pointer.
    /// `tone` is the dominant colour as 0xRRGGBB, 0 until rasters are
    /// decoded.
    Bundled(name: string, width: int, height: int, tone: int, media: string, octets: Bytes)
    /// A name for bytes someone else has, sized by the author.
    Remote(url: Url, width: int, height: int)
}

/// A picture someone else serves: an http or https address, sized by the
/// author (layout never jumps), never fetched, transformed or shipped. Absent
/// for any other scheme and for a size that is not positive.
export fn remote(url: Url, width: int, height: int) -> Picture? {
    if url.scheme != "http" && url.scheme != "https" { return null }
    if width < 1 || height < 1 { return null }
    Picture.Remote(url, width, height)
}

/// The mark an `asset` declaration wears, so a `collect` over `@bundled`
/// gathers every file a program bundles. Never run: a marker is data.
export fn bundled(_d: Named) -> Marker { Marker {} }

/// A file of no known kind: its public name, media type and octets.
export type Blob = { name: string, media: string, octets: Bytes }

/// The width and height a header states.
export type Size = { width: int, height: int }

/// Whether `head` opens a PNG, a JPEG or an SVG.
export fn is_picture(head: Bytes) -> bool { png_size(head) != null || jpeg_size(head) != null || svg_size(head) != null }

/// A picture from a file's octets and their BLAKE3 digest in hex; null when
/// they are no picture this reads. THE CALLER HAS THE DIGEST: the compiler
/// hands a provider one, and a test computes its own — so naming a picture
/// alone never reaches a hash, and a target with no hash still draws one.
export fn picture_of(octets: Bytes, digest: string) -> Picture? {
    let size? = size_of(octets) else { return null }
    let kind? = media_of(octets) else { return null }
    Picture.Bundled(named(digest, kind.ext), size.width, size.height, 0, kind.media, octets)
}

/// A blob from a file's octets and their BLAKE3 digest in hex.
export fn blob_of(octets: Bytes, digest: string) -> Blob {
    Blob { name: named(digest, "bin"), media: "application/octet-stream", octets: octets }
}

/// A media type and the extension its files carry.
type Media = { media: string, ext: string }

/// The media type a picture's header names.
fn media_of(octets: Bytes) -> Media? {
    if png_size(octets) != null { return Media { media: "image/png", ext: "png" } }
    if jpeg_size(octets) != null { return Media { media: "image/jpeg", ext: "jpg" } }
    if svg_size(octets) != null { return Media { media: "image/svg+xml", ext: "svg" } }
    null
}

/// A public name: the first 128 bits of the content's BLAKE3, in hex, and
/// an extension.
fn named(digest: string, ext: string) -> string { "${digest.substring(0, 32)}.${ext}" }

/// The name a bundled picture is served under; a remote one is its address.
export fn served_name(p: Picture) -> string {
    match p { .Bundled(name, _, _, _, _, _) -> name, .Remote(url, _, _) -> url.text() }
}

/// The size a PNG, JPEG or SVG header states.
export fn size_of(octets: Bytes) -> Size? { png_size(octets) ?? jpeg_size(octets) ?? svg_size(octets) }

const png_signature: List<int> = [137, 80, 78, 71, 13, 10, 26, 10]

/// A PNG's width and height, big-endian after the `IHDR` tag.
export fn png_size(b: Bytes) -> Size? {
    if b.length < 24 || !(0..8).all((k) -> b.at(k) == png_signature[k]) { return null }
    if be32(b, 12) != 1229472850 { return null }
    Size { width: be32(b, 16), height: be32(b, 20) }
}

/// A JPEG's width and height, from its first start-of-frame segment.
export fn jpeg_size(b: Bytes) -> Size? {
    if b.length < 4 || b.at(0) != 255 || b.at(1) != 216 { return null }
    jpeg_frame(b, 2)
}

/// The size in the first start-of-frame segment at or after `at`.
fn jpeg_frame(b: Bytes, at: int) -> Size? {
    mut i = at
    while i + 4 <= b.length {
        if b.at(i) != 255 { return null }
        let marker = b.at(i + 1)
        if marker == 255 {
            i = i + 1
        } else if is_frame(marker) {
            if i + 9 > b.length { return null }
            return Size { width: be16(b, i + 7), height: be16(b, i + 5) }
        } else if marker == 216 || marker >= 208 && marker <= 215 || marker == 1 { i = i + 2 } else { i = i + 2 + be16(b, i + 2) }
    }
    null
}

/// Whether a marker opens a frame header (SOF0..SOF15 but DHT, JPG, DAC).
fn is_frame(marker: int) -> bool { marker >= 192 && marker <= 207 && marker != 196 && marker != 200 && marker != 204 }

/// An SVG's width and height: its `width`/`height` attributes in
/// pixels, else its `viewBox`.
export fn svg_size(b: Bytes) -> Size? {
    let text? = b.text() else { return null }
    let open = text.index_of("<svg")
    if open < 0 { return null }
    let close = text.substring(open, text.length).index_of(">")
    if close < 0 { return null }
    let tag = text.substring(open, open + close)
    let w = parse_int(attribute(tag, "width") ?? "")
    let h = parse_int(attribute(tag, "height") ?? "")
    if w != null && h != null { return Size { width: w!, height: h! } }
    let box = (attribute(tag, "viewBox") ?? "").split(" ")
    if box.length != 4 { return null }
    let bw? = parse_int(box[2]) else { return null }
    let bh? = parse_int(box[3]) else { return null }
    Size { width: bw, height: bh }
}

/// The value of a quoted attribute inside a tag, or null.
fn attribute(tag: string, name: string) -> string? {
    let at = tag.index_of(" ${name}=\"")
    if at < 0 { return null }
    let rest = tag.substring(at + name.length + 3, tag.length)
    let end = rest.index_of("\"")
    if end < 0 { return null }
    rest.substring(0, end)
}

fn be16(b: Bytes, at: int) -> int { b.at(at) * 256 + b.at(at + 1) }

fn be32(b: Bytes, at: int) -> int { be16(b, at) * 65536 + be16(b, at + 2) }

impl Provider for Picture {
    static fn provide(_path: string, octets: Bytes, digest: string) -> Picture? { picture_of(octets, digest) }
}

/// A blob reads every file, so it answers when no other kind does.
impl Provider for Blob {
    static fn provide(_path: string, octets: Bytes, digest: string) -> Blob? { blob_of(octets, digest) }
}
