// Every line of every render is within the width, across a tree that
// holds each role, padding, gaps and non-ASCII text.
use @std.ui_tui.{render}
use @std.text.{codepoint_count}
use @std.ui.{Node, Role, Setting}

fn atom(r: Role) -> Node { Node { role: r } }

fn crowded() -> Node {
    let item = Node {
        role: .Item,
        children: [
            atom(Role.Text("héllo wörld and a supercalifragilistic word")),
            atom(Role.Button("Save changes")),
        ],
    }
    Node {
        role: .Column,
        look: [Setting.Pad(.L), Setting.Gap(.M)],
        children: [
            atom(Role.Heading("An overlong heading over the line", 1)),
            atom(Role.Image("i.png", "a picture of something")),
            atom(Role.Link("the documentation", "https://example.com/docs/very/long")),
            atom(Role.Toggle("Remember me on this device", true)),
            atom(Role.Field("Email address", "someone@example.com")),
            Node {
                role: .Row,
                look: [Setting.Gap(.Xl), Setting.Pad(.M)],
                children: [
                    atom(Role.Text("left side")),
                    atom(Role.Button("Go")),
                    atom(Role.Text("right side")),
                ],
            },
            Node {
                role: Role.Section("A section title"),
                children: [Node { role: .List, children: [item, item] }],
            },
        ],
    }
}

fn widest_at(w: int) -> int {
    mut most = 0
    for l in render(crowded(), w).split("\n") {
        if codepoint_count(l) > most { most = codepoint_count(l) }
    }
    most
}

spec "std/ui-tui width" {
    given "a tree holding every role" {
        then "no line passes the width, from one to sixty" {
            [w for w in 1..60 if widest_at(w) > w].length == 0
        }
        then "the tree does reach the width it is held to" {
            widest_at(30) > 20 && widest_at(60) > 40
        }
        then "a width of zero holds the width-one law" {
            widest_at(0) <= 1
        }
    }
    given "non-ASCII length" {
        then "the byte length of an accented letter is two, its code point count one" {
            "é".length == 2 && codepoint_count("é") == 1
        }
    }
}
