// Attacks on the realizer: degenerate shapes, embedded newlines in
// atoms, blank children, odd text, nesting, and settings on nodes
// that ignore them.
use @std.ui_tui.{render}
use @std.text.{from_codepoint, codepoint_count}
use @std.ui.{Node, Role, Setting, Size}

fn one(r: Role) -> Node { Node { role: r } }

fn words(s: string) -> Node { one(Role.Text(s)) }

fn holding(r: Role, look: List<Setting>, kids: List<Node>) -> Node {
    Node { role: r, look: look, children: kids }
}

spec "std/ui-tui adversarial" {
    given "degenerate shapes" {
        then "an empty row renders nothing" {
            render(holding(.Row, [], []), 20) == ""
        }
        then "an empty list renders nothing" {
            render(holding(.List, [], []), 20) == ""
        }
        then "an empty item renders nothing" {
            render(holding(.Item, [], []), 20) == ""
        }
        then "a list of an empty item renders no bullet" {
            render(holding(.List, [], [holding(.Item, [], [])]), 20) == ""
        }
        then "a section with no children is its title and rule" {
            render(holding(Role.Section("T"), [], []), 20) == "T\n-"
        }
        then "a section with an empty title is only its children" {
            render(holding(Role.Section(""), [], [words("a")]), 20) == "a"
        }
        then "a one-child row is the child" {
            render(holding(.Row, [Setting.Gap(.Xl)], [words("a")]), 20) == "a"
        }
        then "a one-child column ignores its gap" {
            render(holding(.Column, [Setting.Gap(.Xl)], [words("a")]), 20) == "a"
        }
        then "a heading level of zero or below reads as level one" {
            render(one(Role.Heading("a", 0)), 20) == "A\n=" &&
                render(one(Role.Heading("a", -4)), 20) == "A\n="
        }
        then "a very deep heading level reads as the dash rule" {
            render(one(Role.Heading("a", 9)), 20) == "A\n-"
        }
        then "a huge width changes nothing" {
            render(words("a b"), 1000000) == "a b"
        }
    }
    given "embedded newlines in atoms" {
        then "a button label with a newline is two lines" {
            render(one(Role.Button("a\nb")), 20) == "[ a\nb ]"
        }
        then "the pad reaches every line of a multi-line atom" {
            render(holding(.Column, [Setting.Pad(.S)], [one(Role.Button("a\nb"))]), 20) == "  [ a\n  b ]"
        }
        then "a list hangs the later lines of a multi-line atom" {
            render(holding(.List, [], [one(Role.Link("a\nb", "u"))]), 20) == "• a\n  b (u)"
        }
        then "a multi-line atom is cut by the width of each line, not of the whole" {
            render(one(Role.Link("aaaa\nbbbb", "x")), 6) == "aaaa\nbbbb (\nx)"
        }
        then "a field label with a newline stays within the width" {
            render(one(Role.Field("ab\ncd", "")), 20) == "ab\ncd: ____________"
        }
        then "an image alt with a newline is two lines" {
            render(one(Role.Image("s", "a\nb")), 20) == "[image: a\nb]"
        }
        then "a multi-line atom in a row is stacked" {
            render(
                holding(.Row, [Setting.Gap(.S)], [words("x"), one(Role.Button("a\nb")), words("y")]),
                20,
            ) == "x\n[ a\nb ]\ny"
        }
    }
    given "blank children" {
        then "a blank text in a row adds no gap" {
            render(holding(.Row, [Setting.Gap(.S)], [words("a"), words(" "), words("b")]), 20) == "a b"
        }
        then "a trailing blank text in a row leaves no trailing space" {
            render(holding(.Row, [Setting.Gap(.S)], [words("a"), words(" ")]), 20) == "a"
        }
        then "a leading blank text in a row leaves no leading space" {
            render(holding(.Row, [Setting.Gap(.S)], [words(" "), words("a")]), 20) == "a"
        }
    }
    given "odd text" {
        then "leading and trailing spaces are dropped" {
            render(words("  a  "), 20) == "a"
        }
        then "a trailing newline closes the last line" {
            render(words("a\n"), 20) == "a"
        }
        then "a lone newline is one blank line" {
            render(words("\n"), 20) == ""
        }
        then "a tab is an ordinary character of its word" {
            render(words("a\tb c"), 20) == "a\tb c"
        }
        then "a NUL is an ordinary character" {
            let z = "a" + from_codepoint(0) + "b"
            codepoint_count(render(words(z + " c"), 20)) == 5
        }
        then "text made only of spaces renders nothing" {
            render(words("     "), 20) == ""
        }
    }
    given "nesting" {
        then "a list in a list indents the inner bullets under the outer text" {
            let inner = holding(.List, [], [holding(.Item, [], [words("in")])])
            let outer = holding(.List, [], [holding(.Item, [], [words("out"), inner])])
            render(outer, 20) == "• out\n  • in"
        }
        then "a gap on a leaf is ignored" {
            render(holding(Role.Text("a"), [Setting.Gap(.Xl)], []), 20) == "a"
        }
        then "a leaf's children are ignored" {
            render(holding(Role.Text("a"), [], [words("b")]), 20) == "a"
        }
        then "a section inside a padded column keeps its rule as wide as its title" {
            render(holding(.Column, [Setting.Pad(.Xs)], [holding(Role.Section("Hi"), [], [])]), 20) == " Hi\n --"
        }
        then "pads add up through nesting until the room runs out" {
            let deep = holding(
                .Column,
                [Setting.Pad(.Xl)],
                [holding(.Column, [Setting.Pad(.Xl)], [words("abcd")])],
            )
            render(deep, 10) == "         a\n         b\n         c\n         d"
        }
    }
}
