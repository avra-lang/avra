// Each role's exact lines, the layout containers, and the settings
// that shape them.
use @std.ui_tui.{render}
use @std.ui.{Node, Role, Setting, Size}

fn leaf(r: Role) -> Node { Node { role: r } }

fn text(s: string) -> Node { leaf(Role.Text(s)) }

fn box(r: Role, look: List<Setting>, kids: List<Node>) -> Node {
    Node { role: r, look: look, children: kids }
}

spec "std/ui-tui roles" {
    given "the leaves" {
        then "a text is itself" {
            render(text("hello"), 40) == "hello"
        }
        then "a level one heading is upper case over an equals rule" {
            render(leaf(Role.Heading("Tasks", 1)), 40) == "TASKS\n====="
        }
        then "a deeper heading is upper case over a dash rule" {
            render(leaf(Role.Heading("Tasks", 2)), 40) == "TASKS\n-----"
        }
        then "an image is its alt in brackets" {
            render(leaf(Role.Image("a.png", "a cat")), 40) == "[image: a cat]"
        }
        then "a link is its label then its target" {
            render(leaf(Role.Link("docs", "/docs")), 40) == "docs (/docs)"
        }
        then "a button is its label in spaced brackets" {
            render(leaf(Role.Button("Add")), 40) == "[ Add ]"
        }
        then "a toggle shows its state" {
            render(leaf(Role.Toggle("Done", true)), 40) == "[x] Done" &&
                render(leaf(Role.Toggle("Done", false)), 40) == "[ ] Done"
        }
        then "a field pads its value with underscores to twelve" {
            render(leaf(Role.Field("Name", "Ada")), 40) == "Name: Ada_________"
        }
        then "an empty field is twelve underscores" {
            render(leaf(Role.Field("Name", "")), 40) == "Name: ____________"
        }
        then "a value past twelve is kept whole" {
            render(leaf(Role.Field("N", "abcdefghijklmn")), 40) == "N: abcdefghijklmn"
        }
    }
    given "the containers" {
        then "a column stacks its children with no gap by default" {
            render(box(.Column, [], [text("a"), text("b")]), 40) == "a\nb"
        }
        then "a small gap is one blank line and a large one two" {
            render(box(.Column, [Setting.Gap(.M)], [text("a"), text("b")]), 40) == "a\n\nb" &&
                render(box(.Column, [Setting.Gap(.L)], [text("a"), text("b")]), 40) == "a\n\n\nb"
        }
        then "an extra-small gap is no blank line" {
            render(box(.Column, [Setting.Gap(.Xs)], [text("a"), text("b")]), 40) == "a\nb"
        }
        then "an empty column renders nothing" {
            render(box(.Column, [], []), 40) == ""
        }
        then "an empty child leaves no extra gap" {
            render(
                box(.Column, [Setting.Gap(.M)], [text("a"), box(.Column, [], []), text("b")]),
                40,
            ) == "a\n\nb"
        }
        then "a row joins its children on one line" {
            render(
                box(.Row, [Setting.Gap(.M)], [text("a"), leaf(Role.Button("go")), text("b")]),
                40,
            ) == "a  [ go ]  b"
        }
        then "a row's gap sizes are none, one, two, three and four spaces" {
            let kids = [text("a"), text("b")]
            render(box(.Row, [Setting.Gap(.None)], kids), 40) == "ab" &&
                render(box(.Row, [Setting.Gap(.Xs)], kids), 40) == "a b" &&
                render(box(.Row, [Setting.Gap(.S)], kids), 40) == "a b" &&
                render(box(.Row, [Setting.Gap(.L)], kids), 40) == "a   b" &&
                render(box(.Row, [Setting.Gap(.Xl)], kids), 40) == "a    b"
        }
        then "a row that overflows continues on the next line" {
            render(box(.Row, [Setting.Gap(.S)], [text("aaaa"), text("bbbb"), text("cccc")]), 10) == "aaaa bbbb\ncccc"
        }
        then "a multi-line child of a row is stacked" {
            render(
                box(
                    .Row,
                    [Setting.Gap(.S)],
                    [text("x"), box(.Column, [], [text("a"), text("b")]), text("y")],
                ),
                40,
            ) == "x\na\nb\ny"
        }
        then "a section is its title, a dash rule, then its children" {
            render(box(Role.Section("Inbox"), [], [text("one"), text("two")]), 40) == "Inbox\n-----\none\ntwo"
        }
        then "a list prefixes each item with a bullet" {
            let item = (s: string) -> box(.Item, [], [text(s)])
            render(box(.List, [], [item("one"), item("two")]), 40) == "• one\n• two"
        }
        then "an item's key never prints" {
            render(Node { role: .Item, children: [text("one")], key: "k1" }, 40) == "one"
        }
        then "a list hangs a wrapped item's later lines under its text" {
            render(box(.List, [], [box(.Item, [], [text("aaa bbb ccc")])]), 9) == "• aaa bbb\n  ccc"
        }
    }
    given "the settings" {
        then "a pad indents every line of the node" {
            render(box(.Column, [Setting.Pad(.S)], [text("a"), text("b")]), 40) == "  a\n  b"
        }
        then "the pad sizes are one, two, four, six and eight spaces" {
            let pad = (z: Size) -> render(box(.Column, [Setting.Pad(z)], [text("a")]), 40)
            pad(.None) == "a" &&
                pad(.Xs) == " a" &&
                pad(.S) == "  a" &&
                pad(.M) == "    a" &&
                pad(.L) == "      a" &&
                pad(.Xl) == "        a"
        }
        then "a pad narrows the wrap of what is inside" {
            render(box(.Column, [Setting.Pad(.S)], [text("aaa bbb")]), 7) == "  aaa\n  bbb"
        }
        then "a blank gap line is never padded" {
            render(box(.Column, [Setting.Pad(.S), Setting.Gap(.M)], [text("a"), text("b")]), 40) == "  a\n\n  b"
        }
        then "a later setting of a kind wins" {
            render(box(.Column, [Setting.Pad(.S), Setting.Pad(.Xs)], [text("a")]), 40) == " a"
        }
        then "tone, font, fill, radius and color print nothing" {
            let plain = render(text("hi"), 40)
            let dressed = render(
                Node {
                    role: .Text("hi"),
                    look: [Setting.Color(.Muted), .Face(.Mono), .Fill(.Danger), .Radius(.L)],
                },
                40,
            )
            plain == dressed
        }
    }
    given "nesting" {
        then "a column in a row in a column, each padded" {
            let inner = box(.Column, [Setting.Pad(.Xs)], [text("p"), text("q")])
            let row = box(.Row, [Setting.Gap(.S), Setting.Pad(.S)], [text("x"), text("y"), inner])
            let outer = box(.Column, [Setting.Pad(.Xs), Setting.Gap(.S)], [text("top"), row])
            render(outer, 40) == " top\n\n   x y\n    p\n    q"
        }
    }
}
