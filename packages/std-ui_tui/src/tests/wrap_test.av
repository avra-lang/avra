// The wrap: greedy on word boundaries, long words cut, every line
// within the width.
use @std.ui_tui.{wrap, cut, render}
use @std.ui.{Node, Role, Setting}

fn plain(s: string) -> Node { Node { role: Role.Text(s) } }

fn shown(ls: List<string>) -> string { ls.join("|") }

spec "std/ui-tui wrap" {
    given "words" {
        then "words pack greedily to the width" {
            shown(wrap("the quick brown fox", 10)) == "the quick|brown fox"
        }
        then "a line exactly the width stays whole" {
            shown(wrap("abcde fghij", 11)) == "abcde fghij" &&
                shown(wrap("abcde fghij", 10)) == "abcde|fghij"
        }
        then "a word longer than the width is cut into runs" {
            shown(wrap("abcdefghijklmnopqrstuvwxyz", 10)) == "abcdefghij|klmnopqrst|uvwxyz"
        }
        then "a long word after a short one starts its own line" {
            shown(wrap("hi abcdefghijklmno", 10)) == "hi|abcdefghij|klmno"
        }
        then "runs of spaces collapse" {
            shown(wrap("a    b", 10)) == "a b"
        }
        then "an empty text has no lines" {
            wrap("", 10).length == 0
        }
        then "a newline starts a paragraph and a blank one stays" {
            shown(wrap("a\n\nb", 10)) == "a||b"
        }
    }
    given "the width" {
        then "a width of one puts a character on each line" {
            shown(wrap("abc de", 1)) == "a|b|c|d|e"
        }
        then "a width of zero reads as one" {
            shown(wrap("ab", 0)) == "a|b" && shown(wrap("ab", -3)) == "a|b"
        }
        then "width counts code points, not bytes" {
            shown(wrap("éé éé", 2)) == "éé|éé"
        }
        then "a cut keeps a multi-byte character whole" {
            shown(cut("ééé", 2)) == "éé|é"
        }
        then "cut leaves a fitting text alone" {
            shown(cut("abc", 3)) == "abc" && shown(cut("", 3)) == ""
        }
    }
    given "render's width law" {
        then "a text at width ten wraps at ten with a long word cut" {
            render(plain("go abcdefghijklmnopqrs stop"), 10) == "go\nabcdefghij\nklmnopqrs\nstop"
        }
        then "a heading longer than the width wraps and its rule is the widest line" {
            render(Node { role: Role.Heading("a long heading here", 1) }, 8) == "A LONG\nHEADING\nHERE\n======="
        }
        then "a width of zero renders as width one" {
            render(plain("ab"), 0) == "a\nb"
        }
        then "a width of one cuts every atom" {
            render(Node { role: Role.Button("ab") }, 1) == "[\n \na\nb\n \n]"
        }
        then "an empty text renders nothing" {
            render(plain(""), 10) == ""
        }
        then "an empty heading renders nothing" {
            render(Node { role: Role.Heading("", 1) }, 10) == ""
        }
        then "a pad wider than the width leaves one column of room" {
            render(Node { role: .Column, look: [Setting.Pad(.Xl)], children: [plain("abc")] }, 4) == "   a\n   b\n   c"
        }
        then "unicode text is one column per character" {
            render(plain("héllo wörld"), 5) == "héllo\nwörld"
        }
        then "a heading upper-cases ASCII and leaves other letters" {
            render(Node { role: Role.Heading("café", 1) }, 40) == "CAFé\n===="
        }
    }
}
