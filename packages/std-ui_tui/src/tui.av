//! `@std/ui-tui` — the terminal realizer: a `Node` tree drawn as
//! lines of plain text, no escape codes. One exhaustive match over
//! `Role` decides each node's lines; `Setting` is read through two
//! projections, `Gap` and `Pad`.
//!
//! Width is measured in code points (`@std/text`'s `codepoint_count`),
//! never bytes, so an `é` is one column. Wide glyphs and combining
//! marks still count one each.

use @std.ui.{Node, Role, Setting, Size}
use @std.text.{repeat, chars, codepoints, codepoint_count, from_codepoints}

/// The tree as text, one `\n` between lines and none after the last.
/// A width below one reads as one. Every line is at most `width`
/// code points: text wraps on word boundaries, a word or an atom
/// (button, link, image) wider than the line is cut at the width.
///
/// Column, Section, List and Item stack their children, `Gap` giving
/// the blank lines between them (None and Xs 0, S and M 1, L and Xl
/// 2). Row sets its children on one line, `Gap` giving the spaces
/// between them (None 0, Xs and S 1, M 2, L 3, Xl 4); a child that
/// renders as several lines is stacked on its own lines, and a row
/// that overflows continues on the next line. `Pad` indents every
/// non-blank line of the node (None 0, Xs 1, S 2, M 4, L 6, Xl 8),
/// never past the point where one column of room remains. A List
/// prefixes each child `• ` and hangs its later lines under the text.
/// A Field's value is padded with `_` to twelve code points. A
/// Heading reads in upper case (ASCII letters only), underlined `=`
/// at level one and `-` deeper. `Fill`, `Radius`, `Color` and `Face`
/// do not print: a Muted text and a plain one read the same.
export fn render(n: Node, width: int) -> string {
    let w = at_least_one(width)
    [part for l in lines_of(n, w) for part in cut(l, w)].join("\n")
}

// ── Wrapping ────────────────────────────────────────────────────

/// The text as lines of at most `width` code points, breaking at
/// spaces. A newline starts a fresh paragraph, a blank one keeping
/// its blank line; runs of spaces collapse; a word longer than the
/// line is cut at the width. "" has no lines.
export fn wrap(text: string, width: int) -> List<string> {
    let w = at_least_one(width)
    [l for p in text.split("\n") for l in paragraph(p, w)]
}

fn paragraph(p: string, w: int) -> List<string> {
    let words = [[piece] for word in p.split(" ") if word != "" for piece in cut(word, w)]
    if words.length == 0 { return [""] }
    flowed(words, " ", w)
}

/// `s` in runs of `width` code points; whole when it already fits.
export fn cut(s: string, width: int) -> List<string> {
    let w = at_least_one(width)
    let cs = chars(s)
    if cs.length <= w { return [s] }
    [cs.slice(at, at + w).join("") for at in [k * w for k in 0..(cs.length + w - 1) / w]]
}

/// Parts laid on lines: single-line parts share a line, `sep`
/// apart, until the next would pass `w`; a multi-line part takes
/// its own lines. Parts with no lines, or one blank line, are skipped.
fn flowed(parts: List<List<string>>, sep: string, w: int) -> List<string> {
    mut out: List<string> = []
    mut cur = ""
    for ls in [p for p in parts if !is_blank_line(p)] {
        if ls.length == 1 && cur != "" && cells(cur) + cells(sep) + cells(ls[0]) <= w {
            cur = cur + sep + ls[0]
        } else {
            if cur != "" { out.push(cur) }
            cur = ""
            if ls.length == 1 { cur = ls[0] } else { out = out.concat(ls) }
        }
    }
    if cur == "" { out } else { out.concat([cur]) }
}

fn is_blank_line(ls: List<string>) -> bool { ls.length == 1 && ls[0] == "" }

// ── Nodes ───────────────────────────────────────────────────────

fn lines_of(n: Node, w: int) -> List<string> {
    let ind = smaller(pad_columns(pad_of(n)), w - 1)
    indented(body(n, w - ind), ind)
}

fn body(n: Node, w: int) -> List<string> {
    let gap = gap_of(n)
    match n.role {
        .Text(c) -> wrap(c, w),
        .Heading(c, depth) -> titled(upper(c), if depth <= 1 { "=" } else { "-" }, w),
        .Image(_, alt) -> atom("[image: ${alt}]"),
        .Link(label, to) -> atom("${label} (${to})"),
        .Button(label) -> atom("[ ${label} ]"),
        .Toggle(label, on) -> atom(if on { "[x] ${label}" } else { "[ ] ${label}" }),
        .Field(label, value) -> atom("${label}: ${value}${repeat("_", 12 - cells(value))}"),
        .Column or .Item -> stacked(children(n, w), gap),
        .Row -> flowed(children(n, w), repeat(" ", gap_columns(gap)), w),
        .Section(title) -> titled(title, "-", w).concat(stacked(children(n, w), gap)),
        .List -> stacked([hung(ls) for ls in children(n, w - 2)], gap),
    }
}

/// A leaf's text as lines, at its own newlines.
fn atom(s: string) -> List<string> { s.split("\n") }

/// Each child's own lines, the childless ones dropped.
fn children(n: Node, w: int) -> List<List<string>> {
    [ls for ls in [lines_of(c, w) for c in n.children] if ls.length > 0]
}

/// The blocks one under another, `gap` blank lines between.
fn stacked(blocks: List<List<string>>, gap: Size) -> List<string> {
    let blank: List<string> = ["" for _k in 0..gap_lines(gap)]
    [l for i, ls in blocks for l in if i == 0 { ls } else { blank.concat(ls) }]
}

/// A bullet before the first line, its width in spaces before the rest.
fn hung(ls: List<string>) -> List<string> {
    [if i == 0 { "• " } else { "  " } + l for i, l in ls]
}

/// The title wrapped, over a rule of `mark` as wide as its widest line.
fn titled(title: string, mark: string, w: int) -> List<string> {
    let ls = wrap(title, w)
    if ls.length == 0 { return [] }
    ls.concat([repeat(mark, widest(ls))])
}

fn widest(ls: List<string>) -> int {
    mut most = 0
    for l in ls {
        most = larger(most, cells(l))
    }
    most
}

fn indented(ls: List<string>, by: int) -> List<string> {
    [if l == "" { l } else { repeat(" ", by) + l } for l in ls]
}

fn upper(s: string) -> string {
    from_codepoints([upper_code(c) for c in codepoints(s)])
}

fn upper_code(c: int) -> int {
    if c >= 97 && c <= 122 { c - 32 } else { c }
}

fn cells(s: string) -> int { codepoint_count(s) }

fn at_least_one(n: int) -> int { larger(n, 1) }

fn larger(a: int, b: int) -> int { if a > b { a } else { b } }

fn smaller(a: int, b: int) -> int { if a < b { a } else { b } }

// ── Settings ────────────────────────────────────────────────────

fn gap_of(n: Node) -> Size {
    [z for s in n.look for z in gaps(s)].last() ?? .None
}

fn pad_of(n: Node) -> Size {
    [z for s in n.look for z in pads(s)].last() ?? .None
}

fn gaps(s: Setting) -> List<Size> {
    match s { .Gap(z) -> [z], .Pad(_) or .Radius(_) or .Fill(_) or .Color(_) or .Face(_) -> [] }
}

fn pads(s: Setting) -> List<Size> {
    match s { .Pad(z) -> [z], .Gap(_) or .Radius(_) or .Fill(_) or .Color(_) or .Face(_) -> [] }
}

fn gap_lines(z: Size) -> int {
    match z { .None or .Xs -> 0, .S or .M -> 1, .L or .Xl -> 2 }
}

fn gap_columns(z: Size) -> int {
    match z { .None -> 0, .Xs or .S -> 1, .M -> 2, .L -> 3, .Xl -> 4 }
}

fn pad_columns(z: Size) -> int {
    match z { .None -> 0, .Xs -> 1, .S -> 2, .M -> 4, .L -> 6, .Xl -> 8 }
}
