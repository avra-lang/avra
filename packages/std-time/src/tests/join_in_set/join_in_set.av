// proves: one set at a time — a join between a wait row and its park
// traps, in the same words evaluated and compiled.
extern fn avra_wait_until(at_ns: int, arm: int, member: int)
extern fn avra_task_pending() -> ptr
extern fn avra_task_join(t: ptr) -> ptr

let p = avra_task_pending()
avra_wait_until(9000000000000000000, 0, 0)
let _answer = avra_task_join(p)
"unreached"
