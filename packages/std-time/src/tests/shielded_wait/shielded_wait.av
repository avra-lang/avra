// proves: a wait inside a `defer` that runs under a cancel answers the
// standing cancel at once — the body is cut at its first wait
use @std.time.{ms, secs, sleep}

let seen = Cell.new(0)
let t = spawn {
    defer {
        seen.set(seen.get() + 1)
        sleep(secs(60))
        seen.set(seen.get() + 10)
    }
    sleep(secs(60))
    0
}
sleep(ms(1))
t.cancel()
sleep(ms(1))
"${t.done} ${seen.get()}"
