// proves: a wait inside a `defer` that runs under a cancel answers the
// standing cancel at once — the body is cut at its first wait
use @std.task.{open_channel}
use @std.time.{secs, sleep}

let seen = Cell.new(0)
let up = open_channel<int>(1)
let t = spawn {
    defer {
        seen.set(seen.get() + 1)
        sleep(secs(60))
        seen.set(seen.get() + 10)
    }
    let _ = up.sink.post(1)
    sleep(secs(60))
    0
}
let _ = up.source.next()
t.cancel()
let _ = t.await catch c -> 0
"${t.done} ${seen.get()}"
