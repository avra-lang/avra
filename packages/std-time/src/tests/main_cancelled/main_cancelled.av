// proves: a cancel passes up a chain of bare awaits to the program's own
// run — its `defer` runs, then one line names the task that first asked,
// and the process exits 1
use @std.task.{open_channel}
use @std.time.{secs, sleep}

let up = open_channel<int>(1)
let first = spawn {
    let _ = up.sink.post(1)
    sleep(secs(60))
    1
}
let second = spawn { first.await + 1 }
let third = spawn { second.await + 1 }
let asker = spawn {
    let _ = up.source.next()
    first.cancel()
    0
}
defer eprintln("main's defer ran")
let v = third.await
println("unreached ${v} ${asker.done}")
