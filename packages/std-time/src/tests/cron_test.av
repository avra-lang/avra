// Cron lines: what `cron` reads and refuses, and the tick `next_after`
// answers, held against a minute-by-minute walk of the same line.
use @std.time.{Cron, CronError, CronField, Time, cron, hours, mins, parse_iso}
use @std.text.{parse_int}

fn at(iso: string) -> Time {
    parse_iso(iso)!
}

/// The tick after `iso` of `line`, as its first nineteen characters,
/// or why there is none.
fn after_of(line: string, iso: string) -> string {
    match cron(line) {
        .Ok(c) -> c.next_after(at(iso))?.iso()?.substring(0, 19) ?? "none",
        .Err(e) -> e.text(),
    }
}

/// The ticks after `iso`, `n` of them, each from the one before.
fn ticks(line: string, iso: string, n: int) -> string {
    let c = parsed(line)!
    mut t = at(iso)
    mut out: List<string> = []
    for _i in 0..n {
        let next? = c.next_after(t) else { return out.join(" ") }
        out.push(next.iso().substring(5, 16))
        t = next
    }
    out.join(" ")
}

fn parsed(line: string) -> Cron? {
    match cron(line) { .Ok(c) -> c, .Err(_) -> null }
}

fn refused(line: string) -> CronError? {
    match cron(line) { .Ok(_) -> null, .Err(e) -> e }
}

/// An error as its variant and payload, spelled for a comparison.
fn shown(e: CronError?) -> string {
    let e? = e else { return "accepted" }
    match e {
        .Fields(n) -> "Fields(${n})",
        .Nickname(t) -> "Nickname(${t})",
        .Unread(f, t) -> "Unread(${named(f)}, ${t})",
        .Range(f, v, lo, hi) -> "Range(${named(f)}, ${v}, ${lo}, ${hi})",
        .Backward(f, a, b) -> "Backward(${named(f)}, ${a}, ${b})",
        .Step(f, t) -> "Step(${named(f)}, ${t})",
        .Never -> "Never",
    }
}

fn named(f: CronField) -> string {
    match f {
        .minute -> "minute",
        .hour -> "hour",
        .day -> "day",
        .month -> "month",
        .weekday -> "weekday",
    }
}

/// What `cron` makes of `line`, as `shown` spells it.
fn read(line: string) -> string {
    shown(refused(line))
}

fn says(line: string) -> string {
    refused(line)?.text() ?? "accepted"
}

// ── The oracle ──

/// Whether `t` ticks under `line` read field by field from its ISO
/// text, no bit sets involved: an oracle written apart from the parser.
fn oracle_ticks(f: List<List<int>>, star_day: bool, star_week: bool, t: Time) -> bool {
    let s = t.iso()
    let y = parse_int(s.substring(0, 4))!
    let mo = parse_int(s.substring(5, 7))!
    let d = parse_int(s.substring(8, 10))!
    let h = parse_int(s.substring(11, 13))!
    let mi = parse_int(s.substring(14, 16))!
    let wd = zeller(y, mo, d)
    let dom = f[2].contains(d)
    let dow = f[4].contains(wd) || wd == 0 && f[4].contains(7)
    let day = if star_day || star_week { dom && dow } else { dom || dow }
    f[0].contains(mi) && f[1].contains(h) && f[3].contains(mo) && day
}

/// The weekday of a civil date, Sunday 0, by Zeller's congruence.
fn zeller(y: int, m: int, d: int) -> int {
    let mm = if m < 3 { m + 12 } else { m }
    let yy = if m < 3 { y - 1 } else { y }
    let k = yy % 100
    let j = yy / 100
    let h = (d + 13 * (mm + 1) / 5 + k + k / 4 + j / 4 + 5 * j) % 7
    (h + 6) % 7
}

/// The first minute after `from` the oracle says ticks, walking at
/// most `limit` minutes.
fn walked(f: List<List<int>>, star_day: bool, star_week: bool, from: Time, limit: int) -> Time? {
    let start = (from.ns / 60000000000 + 1) * 60000000000
    let i? = (0..limit)
        .find(oracle_ticks(f, star_day, star_week, Time { ns: start + it * 60000000000 })) else {
        return null
    }
    Time { ns: start + i * 60000000000 }
}

/// Lines whose fields the oracle reads as plain lists.
type Case = { line: string, fields: List<List<int>> }

fn all(lo: int, hi: int) -> List<int> {
    [v for v in lo..hi + 1]
}

fn every_of(lo: int, hi: int, step: int) -> List<int> {
    [v for v in lo..hi + 1 if (v - lo) % step == 0]
}

fn cases() -> List<Case> {
    [
        Case {
            line: "*/7 * * * *",
            fields: [every_of(0, 59, 7), all(0, 23), all(1, 31), all(1, 12), all(0, 7)],
        },
        Case {
            line: "5 */5 * * *",
            fields: [[5], every_of(0, 23, 5), all(1, 31), all(1, 12), all(0, 7)],
        },
        Case {
            line: "0 9-17/4 * * 1-5",
            fields: [[0], [9, 13, 17], all(1, 31), all(1, 12), all(1, 5)],
        },
        Case { line: "30 2 13 * 5", fields: [[30], [2], [13], all(1, 12), [5]] },
        Case {
            line: "15,45 0 */10 * *",
            fields: [[15, 45], [0], [1, 11, 21, 31], all(1, 12), all(0, 7)],
        },
        Case { line: "0 12 * * sun,sat", fields: [[0], [12], all(1, 31), all(1, 12), [0, 6]] },
        Case { line: "0 0 * * */3", fields: [[0], [0], all(1, 31), all(1, 12), [0, 3, 6]] },
        Case { line: "59 23 31 * *", fields: [[59], [23], [31], all(1, 12), all(0, 7)] },
    ]
}

/// Whether `next_after` and the walk agree from `from` on the case, for
/// `n` ticks in a row.
fn agrees(c: Case, from: Time, n: int) -> bool {
    let line = parsed(c.line)!
    let words = c.line.split(" ")
    let star_day = words[2].starts_with("*")
    let star_week = words[4].starts_with("*")
    mut t = from
    for _i in 0..n {
        let mine = line.next_after(t)
        let theirs = walked(c.fields, star_day, star_week, t, 60 * 24 * 62)
        if mine?.ns != theirs?.ns { return false }
        t = mine!
    }
    true
}

// ── Fuzz ──

/// A text made of cron's own pieces, chosen by `seed`.
fn fuzzed(seed: int) -> string {
    let pieces = [
        "*",
        "0",
        "5",
        "59",
        "60",
        "1-5",
        "5-1",
        "*/15",
        "/2",
        "a",
        ",",
        "-",
        "jan",
        "MON",
        "7",
        "8",
        "@daily",
        "@nope",
        "1,2",
        "3/0",
        "*/1",
        "2-",
        "-3",
        "31",
        "feb",
        "*/",
        "1-2-3",
        "99999999999999999999",
        "\t",
    ]
    mut s = seed
    mut out: List<string> = []
    let n = seed % 8
    for _i in 0..n {
        s = (s * 1103515245 + 12345) % 2147483648
        out.push(pieces[s % pieces.length])
    }
    out.join(if seed % 3 == 0 { "  " } else { " " })
}

/// Whether the line `text` either refuses with words, or ticks after
/// `t` at an instant past it that it says ticks.
fn holds(text: string, t: Time) -> bool {
    match cron(text) {
        .Err(e) -> e.text() != "",
        .Ok(c) -> {
            let next? = c.next_after(t) else { return false }
            next.ns > t.ns && c.ticks_at(next) && next.ns % 60000000000 == 0
        },
    }
}

spec "std/time — a cron line" {
    given "the five fields" {
        then "a nightly line ticks once a day at its hour" {
            ticks("0 3 * * *", "2026-01-30T12:00:00Z", 4) == "01-31T03:00 02-01T03:00 02-02T03:00 02-03T03:00"
        }
        then "the tick is strictly after the instant, even one on a tick" {
            after_of("0 3 * * *", "2026-01-01T03:00:00Z") == "2026-01-02T03:00:00" &&
                after_of("0 3 * * *", "2026-01-01T02:59:59.999999999Z") == "2026-01-01T03:00:00"
        }
        then "every minute ticks on the next whole minute" {
            after_of("* * * * *", "2026-05-05T10:20:30Z") == "2026-05-05T10:21:00"
        }
        then "a list, a range and a step each name their values" {
            ticks("10,20 1-2 * * *", "2026-01-01T00:00:00Z", 5) == "01-01T01:10 01-01T01:20 01-01T02:10 01-01T02:20 01-02T01:10" &&
                ticks("*/20 0 * * *", "2026-01-01T00:00:00Z", 3) == "01-01T00:20 01-01T00:40 01-02T00:00"
        }
        then "a stepped single value runs to the field's end" {
            ticks("50/4 0 * * *", "2026-01-01T00:00:00Z", 3) == "01-01T00:50 01-01T00:54 01-01T00:58"
        }
        then "month and weekday names read in any case" {
            after_of("0 0 1 FeB *", "2026-03-01T00:00:00Z") == "2027-02-01T00:00:00" &&
                after_of("0 0 * * fri", "2026-11-18T00:00:00Z") == "2026-11-20T00:00:00"
        }
        then "a weekday of 7 is Sunday as 0 is" {
            after_of("0 0 * * 7", "2026-11-18T00:00:00Z") == "2026-11-22T00:00:00" &&
                after_of("0 0 * * 0", "2026-11-18T00:00:00Z") == "2026-11-22T00:00:00"
        }
        then "blanks between fields may be many, and tabs" {
            after_of("  0\t3   *  * * ", "2026-01-01T00:00:00Z") == "2026-01-01T03:00:00"
        }
        then "the nicknames stand for their lines and the value keeps the text" {
            after_of("@hourly", "2026-01-01T00:30:00Z") == "2026-01-01T01:00:00" &&
                after_of("@daily", "2026-01-01T00:30:00Z") == "2026-01-02T00:00:00" &&
                after_of("@midnight", "2026-01-01T00:30:00Z") == "2026-01-02T00:00:00" &&
                after_of("@weekly", "2026-11-18T00:00:00Z") == "2026-11-22T00:00:00" &&
                after_of("@monthly", "2026-11-18T00:00:00Z") == "2026-12-01T00:00:00" &&
                after_of("@YEARLY", "2026-11-18T00:00:00Z") == "2027-01-01T00:00:00" &&
                after_of("@annually", "2026-11-18T00:00:00Z") == "2027-01-01T00:00:00" &&
                parsed("@daily")?.line == "@daily"
        }
    }
    given "the calendar" {
        then "the 31st skips the months that have none" {
            ticks("0 0 31 * *", "2026-01-31T00:00:00Z", 4) == "03-31T00:00 05-31T00:00 07-31T00:00 08-31T00:00"
        }
        then "the 29th of February waits for a leap year" {
            after_of("0 0 29 2 *", "2024-03-01T00:00:00Z") == "2028-02-29T00:00:00"
        }
        then "a century year is no leap year unless it divides by 400" {
            after_of("0 0 29 2 *", "2096-03-01T00:00:00Z") == "2104-02-29T00:00:00" &&
                after_of("0 0 29 2 *", "1996-03-01T00:00:00Z") == "2000-02-29T00:00:00"
        }
        then "the last minute of a year rolls into the next" {
            after_of("0 0 * * *", "2026-12-31T23:59:00Z") == "2027-01-01T00:00:00"
        }
        then "instants before the epoch tick too" {
            after_of("0 12 * * *", "1969-12-31T13:00:00Z") == "1970-01-01T12:00:00" &&
                after_of("0 0 1 1 *", "1900-06-01T00:00:00Z") == "1901-01-01T00:00:00"
        }
        then "a tick past the range of instants is absent" {
            after_of("0 0 1 1 *", "2262-01-02T00:00:00Z") == "none"
        }
    }
    given "the two day fields" {
        then "both written: a day of either kind ticks" {
            ticks("0 0 13 * 5", "2026-11-01T00:00:00Z", 4) == "11-06T00:00 11-13T00:00 11-20T00:00 11-27T00:00"
        }
        then "a day of the month under a starred weekday ticks on that day alone" {
            ticks("0 0 13 * *", "2026-11-01T00:00:00Z", 2) == "11-13T00:00 12-13T00:00"
        }
        then "a weekday under a starred day of the month ticks on that weekday alone" {
            ticks("0 0 * * 5", "2026-11-01T00:00:00Z", 2) == "11-06T00:00 11-13T00:00"
        }
        then "a stepped star is a star: the two fields must both match" {
            ticks("0 0 */2 * 1", "2026-11-01T00:00:00Z", 3) == "11-09T00:00 11-23T00:00 12-07T00:00"
        }
        then "the 13th under a starred weekday step must also be a Sunday or Friday" {
            after_of("0 0 13 * */5", "2026-11-14T00:00:00Z") == "2026-12-13T00:00:00"
        }
        then "a leap day that must also be a Sunday waits for one" {
            after_of("0 0 29 2 */8", "2026-01-01T00:00:00Z") == "2032-02-29T00:00:00"
        }
    }
    given "the oracle" {
        then "every case agrees with a minute-by-minute walk for ten ticks" {
            cases().all(agrees(it, at("2026-02-27T22:13:00Z"), 10))
        }
        then "and across a leap day" {
            cases().all(agrees(it, at("2028-02-27T22:13:00Z"), 4))
        }
    }
    given "a text that is no line" {
        then "four fields or six are counted" {
            read("0 3 * *") == "Fields(4)" &&
                read("0 3 * * * *") == "Fields(6)" &&
                read("") == "Fields(0)"
        }
        then "a value past its field is named with the field's reach" {
            read("60 * * * *") == "Range(minute, 60, 0, 59)" &&
                read("* 24 * * *") == "Range(hour, 24, 0, 23)" &&
                read("* * 0 * *") == "Range(day, 0, 1, 31)" &&
                read("* * 32 * *") == "Range(day, 32, 1, 31)" &&
                read("* * * 13 *") == "Range(month, 13, 1, 12)" &&
                read("* * * * 8") == "Range(weekday, 8, 0, 7)"
        }
        then "a range that runs down is refused" {
            read("5-1 * * * *") == "Backward(minute, 5, 1)"
        }
        then "a step of nothing, of a sign or of no digits is refused" {
            read("*/0 * * * *") == "Step(minute, 0)" &&
                read("*/-1 * * * *") == "Step(minute, -1)" &&
                read("*/x * * * *") == "Step(minute, x)"
        }
        then "an empty item, a dangling dash or slash, and words are unread" {
            read("1,,2 * * * *") == "Unread(minute, )" &&
                read("1, * * * *") == "Unread(minute, 1,)" &&
                read("1- * * * *") == "Unread(minute, 1-)" &&
                read("-1 * * * *") == "Unread(minute, -1)" &&
                read("*/ * * * *") == "Unread(minute, */)" &&
                read("1/2/3 * * * *") == "Unread(minute, 1/2/3)" &&
                read("1-2-3 * * * *") == "Unread(minute, 1-2-3)" &&
                read("/2 * * * *") == "Unread(minute, /2)" &&
                read("/ * * * *") == "Unread(minute, /)" &&
                read("jan * * * *") == "Unread(minute, jan)" &&
                read("* * * * monday") == "Unread(weekday, monday)"
        }
        then "a number too long for an int is unread, never a trap" {
            read("99999999999999999999 * * * *") == "Unread(minute, 99999999999999999999)"
        }
        then "a nickname cron does not know is named" {
            read("@reboot") == "Nickname(@reboot)" && read("@") == "Nickname(@)"
        }
        then "a day no month has never ticks" {
            read("0 0 30 2 *") == "Never" &&
                read("0 0 31 4,6,9,11 *") == "Never" &&
                read("0 0 30 2 1") == "accepted"
        }
        then "each error says what is wrong in words" {
            says("0 3 * *") == "a cron line has five fields — minute, hour, day of the month, month, day of the week — and this has 4" &&
                says("* * * * 8") == "a day of the week is 0 to 7, and this is 8" &&
                says("5-1 * * * *") == "a range in the minute field runs upward, and `5-1` runs down" &&
                says("*/0 * * * *") == "a step in the minute field is a whole number past zero, and this is `0`" &&
                says("x * * * *") == "the minute field reads `x`, which is no value, range, step or list of them" &&
                says("@reboot") == "`@reboot` is no cron nickname — @yearly, @annually, @monthly, @weekly, @daily, @midnight and @hourly are" &&
                says("0 0 30 2 *") == "this cron line names no day that any month has, so it never ticks"
        }
        then "four hundred texts built of cron's own pieces each refuse in words or tick past the instant" {
            (0..400).all(holds(fuzzed(it * 7919 + 13), at("2026-11-18T12:34:56Z")))
        }
    }
    given "a period" {
        then "a span ticks at its whole multiples past the epoch" {
            hours(1).next_after(at("2026-11-18T12:34:56Z"))?.iso() == "2026-11-18T13:00:00.000000000Z" &&
                mins(15).next_after(at("2026-11-18T12:45:00Z"))?.iso() == "2026-11-18T13:00:00.000000000Z"
        }
        then "a span of nothing has no tick" {
            mins(0).next_after(at("2026-11-18T12:34:56Z")) == null
        }
    }
}
