// proves: under a cancel a `defer` runs whole, so a bare await there of
// a task that has already ended cancelled has no answer to go on with —
// it traps
use @std.task.{open_channel}
use @std.time.{ms, secs, sleep}

let up = open_channel<int>(1)
let t = spawn {
    defer {
        let slow = spawn {
            sleep(secs(60))
            1
        }
        sleep(ms(0))
        slow.cancel()
        sleep(ms(0))
        let v = slow.await
        println("unreached ${v}")
    }
    let _ = up.sink.post(1)
    sleep(secs(60))
    0
}
let _ = up.source.next()
t.cancel()
let _ = t.await catch c -> 0
println("unreached ${t.done}")
