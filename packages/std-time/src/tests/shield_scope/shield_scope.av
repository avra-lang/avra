// proves: a `within` written in a `defer` that runs under a cancel is
// that cleanup's own limit — the wait under it is not cut by the cancel
use @std.task.{open_channel}
use @std.time.{ms, secs, sleep}

let seen = Cell.new(0)
let up = open_channel<int>(1)
let t = spawn {
    defer {
        seen.set(seen.get() + 1)
        let waited = within secs(1) {
            sleep(ms(20))
            10
        } catch _ -> 0
        seen.set(seen.get() + waited)
    }
    let _ = up.sink.post(1)
    sleep(secs(60))
    0
}
let _ = up.source.next()
t.cancel()
let _ = t.await catch c -> 0
"${t.done} ${seen.get()}"
