// proves: a valued await inside a `defer` that the task's own cancel
// cuts reads no answer — the deferred body leaves at the await
use @std.time.{ms, secs, sleep}

let seen = Cell.new(0)
let slow = spawn {
    sleep(secs(60))
    1
}
let holder = spawn {
    defer {
        let v = slow.await
        seen.set(seen.get() + v + 100)
    }
    seen.set(seen.get() + 10)
    0
}
sleep(ms(1))
holder.cancel()
sleep(ms(1))
let held = "${holder.done} ${seen.get()}"
slow.cancel()
held
