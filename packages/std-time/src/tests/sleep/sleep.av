//! proves: `sleep` parks the calling task and the others run — two
//! sleeping tasks overlap, the shorter wakes first, and the block that
//! holds them waits for the longer
use @std.time.{sleep, ms, now_ms}
let heard: Cell<List<string>> = Cell.new([])
let t0 = now_ms()
if true {
    let _slow = spawn {
        sleep(ms(60))
        heard.set(heard.get().concat(["slow"]))
        0
    }
    let _fast = spawn {
        sleep(ms(10))
        heard.set(heard.get().concat(["fast"]))
        0
    }
}
"${heard.get().join(",")} ${now_ms() - t0 >= 60}"
