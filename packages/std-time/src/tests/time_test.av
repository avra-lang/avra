// Durations: the constructors agree on milliseconds, arithmetic
// adds, the text picks a human's unit, and the clock only advances.
use @std.time.{ms, secs, mins, now_ms, wall_secs, duration_text, TimedOut}

spec "std/time" {
    given "durations" {
        then "the constructors agree on milliseconds" {
            secs(2).ms == 2000 && mins(1).ms == 60000 && ms(7).ms == 7
        }
        then "plus adds" {
            secs(1).plus(ms(500)).ms == 1500
        }
        then "zero is zero" {
            ms(0).is_zero() && !secs(1).is_zero()
        }
        then "the text picks the unit a human would" {
            duration_text(340) == "340ms" &&
                duration_text(1200) == "1.2s" &&
                duration_text(125000) == "2m05s" &&
                secs(90).text() == "1m30s"
        }
    }
    given "the clock" {
        then "two readings never run backwards" {
            let a = now_ms()
            let b = now_ms()
            b >= a
        }
        then "the wall clock reads a second past September 2026 and before the year 10000" {
            wall_secs() > 1790000000 && wall_secs() < 253402300800
        }
    }
    given "a deadline that passed" {
        then "carries the span it was given and the frames the task stood in" {
            let t: TimedOut = TimedOut { after: secs(2), at: [] }
            t.after.ms == 2000 && t.at.is_empty()
        }
    }
}
