// Durations: the constructors agree on milliseconds, arithmetic
// adds, the text picks a human's unit, and the clock only advances.
use @std.time.{
    ms,
    secs,
    mins,
    now_ms,
    now_ns,
    sleep,
    wall_secs,
    duration_text,
    TimedOut,
    after,
    quiet,
    every,
    stamp,
}

spec "std/time" {
    given "durations" {
        then "the constructors agree on milliseconds" {
            secs(2).ms() == 2000 && mins(1).ms() == 60000 && ms(7).ms() == 7
        }
        then "plus adds" {
            secs(1).plus(ms(500)).ms() == 1500
        }
        then "zero is zero" {
            ms(0).is_zero() && !secs(1).is_zero()
        }
        then "the text picks the unit a human would" {
            duration_text(340) == "340ms" &&
                duration_text(1200) == "1.2s" &&
                duration_text(125000) == "2m05s" &&
                secs(90).text() == "1m30s"
        }
    }
    given "the clock" {
        then "two readings never run backwards" {
            let a = now_ms()
            let b = now_ms()
            b >= a
        }
        then "the wall clock reads a second past September 2026 and before the year 10000" {
            wall_secs() > 1790000000 && wall_secs() < 253402300800
        }
    }
    given "a stamp" {
        then "two made in one instant differ" { stamp() != stamp() }
        then "is a reading and a serial, each a number" {
            let parts = stamp().split("-")
            parts.length == 2 && parts.all(!it.is_empty())
        }
    }
    given "a deadline that passed" {
        then "carries the span it was given and the frames the task stood in" {
            let t: TimedOut = TimedOut { after: secs(2), at: [] }
            t.after.ms() == 2000 && t.at.is_empty()
        }
    }
    given "a deadline" {
        then "is the instant its span from now" {
            let from = now_ns()
            let d = after(ms(40))
            d.at >= from + 40000000 && d.at <= now_ns() + 40000000
        }
        then "plus moves it by the span, in nanoseconds" {
            let d = after(secs(1))
            d.plus(ms(5)).at - d.at == 5000000
        }
        then "before it is due, something is left and nothing is late" {
            let d = after(secs(5))
            !d.due() && d.left().ms() > 4000 && d.left().ms() <= 5000 && d.late().is_zero()
        }
        then "once due, nothing is left and the lateness is counted" {
            let d = after(ms(-7))
            d.due() && d.left().is_zero() && d.late().ms() >= 7
        }
        then "what is left rounds up, so zero means due" {
            let d = after(ms(1))
            d.left().ms() == 1
        }
        then "a span past spelling is the farthest instant, never one already due" {
            let d = after(ms(9223372036854775807))
            d.at == 9223372036854775807 && d.plus(secs(1)).at == d.at && !d.due()
        }
        then "a span past spelling the other way is the clock's origin, long due" {
            let d = after(ms(0 - 9223372036854775807))
            d.at == 0 && d.due() && d.late().ms() > 0 && d.plus(ms(0 - 5)).at == 0
        }
        then "what is left rebuilds it in another process's terms" {
            let d = after(secs(3))
            let again = after(d.left())
            again.at >= d.at && again.at - d.at < 1000000000
        }
        then "a wait on a due one returns at once" {
            let d = after(ms(-1))
            d.wait()
            d.due()
        }
        then "a wait parks until the instant" {
            let d = after(ms(30))
            d.wait()
            d.due()
        }
        then "one deadline bounds every wait on it" {
            let d = after(ms(30))
            sleep(ms(20))
            d.wait()
            d.late().ms() < 20
        }
    }
    given "a quiet" {
        then "holds the span it was given" { quiet(ms(200)).span.ms() == 200 }
    }
    given "a period" {
        then "no tick is due before the first period ends" {
            let tick = every(secs(1))
            !tick.passed() && tick.missed() == 0
        }
        then "a wait takes the next tick, and the one after is a period on" {
            let tick = every(ms(10))
            let first = tick.next.get()
            tick.wait()
            now_ns() >= first && tick.next.get() - first == 10000000 && tick.missed() == 0
        }
        then "ticks stand on instants fixed at the start, whatever is done between" {
            let tick = every(ms(10))
            let first = tick.next.get()
            tick.wait()
            sleep(ms(4))
            tick.wait()
            tick.next.get() - first == 20000000
        }
        then "missed periods are counted and never delivered" {
            let tick = every(ms(10))
            let first = tick.next.get()
            sleep(ms(45))
            let took = tick.passed()
            took &&
                tick.missed() >= 3 &&
                tick.next.get() > now_ns() &&
                !tick.passed() &&
                (tick.next.get() - first) % 10000000 == 0
        }
    }
}
