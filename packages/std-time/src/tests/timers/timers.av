//! proves: a deadline and a period are values a task waits on — two
//! tasks parked on deadlines wake in the deadlines' order, one deadline
//! bounds a loop of waits, and a period's ticks coalesce what was missed
use @std.time.{after, every, sleep, ms, now_ns}

let heard: Cell<List<string>> = Cell.new([])
if true {
    let _slow = spawn {
        after(ms(60)).wait()
        heard.set(heard.get().concat(["slow"]))
        0
    }
    let _fast = spawn {
        after(ms(10)).wait()
        heard.set(heard.get().concat(["fast"]))
        0
    }
}
let limit = after(ms(50))
mut turns = 0
while !limit.due() {
    after(ms(10)).wait()
    turns = turns + 1
}
let tick = every(ms(10))
let first = tick.next.get()
tick.wait()
let on_time = now_ns() >= first && tick.missed() == 0
sleep(ms(45))
tick.wait()
"${heard.get().join(",")} ${turns >= 1 && turns <= 5} ${on_time} ${tick.missed() >= 3} ${(tick.next.get() - first) % 10000000 == 0}"
