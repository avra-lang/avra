//! @std.time — a duration is a VALUE, never a bare count, so a seat
//! that wants one cannot be handed a number that meant something
//! else; the clock is monotonic milliseconds, what a deadline is
//! made of. Two readings differ by the time between them and mean
//! nothing alone. `within d { … }` gives a block a deadline; the
//! `TimedOut` a block answers when it runs past one is here.
//!
//! TWO CLOCKS, NEVER CROSSED: `now_ms` bounds things and `wall_secs`
//! dates them. The wall clock is the host's, and it may step either
//! way, so no deadline is ever read from it.
//!
//! THREE TIMERS, each a value a task may wait on: `after(d)` is one
//! instant, `quiet(d)` a silence, `every(d)` a period. The monotonic
//! clock is this process's own: on Linux it stands still while the
//! machine is suspended, on macOS it runs on, so a timer set across a
//! suspend falls due late on the first and at once on the second.
use @std.errors.{Frame}
use @std.meta.{sealed}

extern fn avra_now_ns() -> int
extern fn avra_time_wall_s() -> int
extern fn avra_fiber_sleep(ms: int)
extern fn avra_wait_until(at_ns: int, arm: int, member: int)
extern fn avra_wait_park() -> int
extern fn avra_trap(message: string)

/// A span of time, in whole milliseconds.
export type Duration = { ms: int }

/// The deadline a block ran past: `after` is the span it was given
/// and `at` the frames the task stood in when it fired.
export type TimedOut = { after: Duration, at: List<Frame> }

/// Re-raise a caught deadline as the failure the caller hears — the
/// fold a `within … catch` arm uses where a waiting verb's own
/// timeout error stood.
export fn late<T>(t: TimedOut) -> Result<T, TimedOut> {
    fail t
}

export fn ms(n: int) -> Duration {
    Duration { ms: n }
}

export fn secs(n: int) -> Duration {
    Duration { ms: n * 1000 }
}

export fn mins(n: int) -> Duration {
    Duration { ms: n * 60000 }
}

/// The monotonic clock, in milliseconds since an origin nobody is
/// told.
export fn now_ms() -> int {
    avra_now_ns() / 1000000
}

/// The same clock in nanoseconds — what a phase timing measures, and
/// too fine a grain for a deadline.
export fn now_ns() -> int {
    avra_now_ns()
}

/// A serial for this process alone.
once fn stamps() -> Cell<int> { Cell.new(0) }

/// A name for this moment that no other call in this process shares:
/// the monotonic reading and a serial, so two made in one instant of a
/// clock that stands still differ. What a scratch path is rooted at.
export fn stamp() -> string {
    let n = stamps().get() + 1
    stamps().set(n)
    "${avra_now_ns()}-${n}"
}

/// The wall clock: whole seconds since 1970-01-01 UTC, as the host
/// says — what a date is made of.
export fn wall_secs() -> int {
    avra_time_wall_s()
}

/// The calling task parked for `d` while the others run; a program
/// with none simply waits. Under a millisecond it lets every other
/// ready task run once, then goes on.
export fn sleep(d: Duration) {
    avra_fiber_sleep(d.ms)
}

impl Duration {
    fn plus(other: Duration) -> Duration {
        Duration { ms: self.ms + other.ms }
    }
    /// The span in whole milliseconds.
    fn ms() -> int {
        self.ms
    }
    fn is_zero() -> bool {
        self.ms == 0
    }
    /// The span as a human reads it: `340ms`, `1.2s`, `2m05s`.
    fn text() -> string {
        duration_text(self.ms)
    }
}

/// Milliseconds as text, at the unit a human would pick.
export fn duration_text(total: int) -> string {
    if total < 1000 { return "${total}ms" }
    if total < 60000 { return "${total / 1000}.${total % 1000 / 100}s" }
    let s = total % 60000 / 1000
    let pad = if s < 10 { "0" } else { "" }
    "${total / 60000}m${pad}${s}s"
}

// ── Timers ──────────────────────────────────────────────────────

/// The last instant the clock can say.
const farthest: int = 9223372036854775807

const ns_per_ms: int = 1000000

/// `d` in nanoseconds — the largest count there is, either way, when
/// that is past spelling.
fn span_ns(d: Duration) -> int {
    when {
        d.ms > farthest / ns_per_ms -> farthest
        d.ms < 0 - farthest / ns_per_ms -> 0 - farthest
        _ -> d.ms * ns_per_ms
    }
}

/// The instant `ns` after `at`: never before the clock's origin, and
/// the farthest when that is past spelling.
fn later(at: int, ns: int) -> int {
    when {
        ns > farthest - at -> farthest
        ns < 0 - at -> 0
        _ -> at + ns
    }
}

/// The calling task parked until `at`, the others running meanwhile —
/// at once when `at` is due.
fn parked_until(at: int) {
    if avra_now_ns() >= at { return }
    avra_wait_until(at, 0, 0)
    let _ = avra_wait_park()
}

/// One instant of this process's monotonic clock, in nanoseconds.
/// SEALED: `after` and `plus` are its doors. The instant means nothing
/// to another process — `left()` is what crosses a wire or a store, and
/// `after(left)` rebuilds it there.
@sealed
export type Deadline = { at: int }

/// The instant `d` from now. Bound once, it is one budget for
/// everything that waits on it.
export fn after(d: Duration) -> Deadline {
    Deadline { at: later(avra_now_ns(), span_ns(d)) }
}

impl Deadline {
    /// The instant `span` after this one.
    fn plus(span: Duration) -> Deadline {
        Deadline { at: later(self.at, span_ns(span)) }
    }

    fn due() -> bool {
        avra_now_ns() >= self.at
    }

    /// What is left before it, in whole milliseconds rounded up — zero
    /// exactly when it is due.
    fn left() -> Duration {
        let ns = self.at - avra_now_ns()
        Duration { ms: if ns <= 0 { 0 } else { (ns - 1) / ns_per_ms + 1 } }
    }

    /// How far past it the clock is — zero until it is due.
    fn late() -> Duration {
        let ns = avra_now_ns() - self.at
        Duration { ms: if ns <= 0 { 0 } else { ns / ns_per_ms } }
    }

    /// The calling task parked until the instant, the others running
    /// meanwhile; at once when it is due.
    fn wait() {
        parked_until(self.at)
    }
}

/// A silence of `span`. SEALED: `quiet` is its door.
@sealed
export type Quiet = { span: Duration }

/// `d` with nothing happening: armed each time the wait it stands in is
/// entered, for `d` from that entry. Anything taken first, and the time
/// spent on it, starts it over, so it has no longest wait. IT IS A
/// DEBOUNCE, NEVER A WATCHDOG: beside a source that keeps speaking,
/// `quiet(ms(200))` never fires. A watchdog is a `Deadline` the
/// heartbeat moves — `mut dog = after(ms(200))`, written
/// `dog = after(ms(200))` at each beat, and due when the beats stop.
export fn quiet(d: Duration) -> Quiet {
    Quiet { span: d }
}

/// A period: one tick every `period`, on instants fixed when it was
/// made. SEALED: `every` is its door.
@sealed
export type Every = { period: Duration, next: Cell<int>, skipped: Cell<int> }

/// A tick every `d`, the first one `d` from now and each next one `d`
/// after the last DUE instant, whatever was done between them. A period
/// of nothing traps.
export fn every(d: Duration) -> Every {
    if d.ms <= 0 { avra_trap("a period of ${d.ms} ms is no period — `every` takes one longer than nothing") }
    Every { period: d, next: Cell.new(later(avra_now_ns(), span_ns(d))), skipped: Cell.new(0) }
}

impl Every {
    /// Whether a tick is due — and then it is taken: the next tick is
    /// the first period boundary after now. MISSED PERIODS COALESCE:
    /// the ones that went by untaken are counted, never delivered.
    fn passed() -> bool {
        let behind = avra_now_ns() - self.next.get()
        if behind < 0 { return false }
        let period = span_ns(self.period)
        let gone = behind / period
        self.skipped.set(self.skipped.get() + gone)
        self.next.set(later(self.next.get(), later(gone * period, period)))
        true
    }

    /// How many periods went by untaken.
    fn missed() -> int {
        self.skipped.get()
    }

    /// The calling task parked until the next tick, which it takes; at
    /// once when one is due.
    fn wait() {
        parked_until(self.next.get())
        let _ = self.passed()
    }
}
