//! The avra command. Every subcommand lives in its own file under
//! `commands/` — this entry composes them and nothing else. A
//! hand-off's words go to the light phase before the app reads them.
//! Exit 0 clean, 1 diagnostics, 2 usage. An entry file's top-level
//! statements ARE its program.

use @std.cli.{cli, argv}
use @std.process.{exit, Exit}
use stage.{light_phase}
use commands.{
    check,
    ir,
    emit,
    build,
    run,
    test,
    docs,
    rules,
    repr,
    writes,
    process,
    expand,
    fmt,
    fix,
    language,
    runtime_header,
    runtime_namespace,
    family_hashes,
    diagnostics,
    new,
    attack,
    cache,
    explain,
    dev,
    trace,
    tasks,
}
cli avra {
    description: "The Avra compiler"
    version: "0.0.1"
    check
    ir
    emit
    build
    run
    test
    docs
    rules
    repr
    writes
    process
    expand
    fmt
    fix
    language
    runtime_header
    runtime_namespace
    family_hashes
    diagnostics
    new
    attack
    cache
    explain
    dev
    trace
    tasks
}
exit(Exit.Code(light_phase(argv()) ?? avra.run()))
