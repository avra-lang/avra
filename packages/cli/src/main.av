//! The avra command. Every subcommand lives in its own file under
//! `commands/` — this entry composes them and nothing else. A
//! hand-off's words go to the light phase before the app reads them.
//! Exit 0 clean, 1 diagnostics, 2 usage. An entry file's top-level
//! statements ARE its program.

use @std.cli.{App, argv}
use @std.process.{exit, Exit}
use stage.{light_phase}
use commands.{
    check_command, ir_command, seats_command, emit_command, build_command,
    run_command, test_command, explain_command, expand_command, grammar_command, new_command,
}

let app = App {
    name: "avra",
    description: "The Avra compiler",
    version: "0.0.1",
    commands: [
        check_command(),
        ir_command(),
        seats_command(),
        emit_command(),
        build_command(),
        run_command(),
        test_command(),
        explain_command(),
        expand_command(),
        grammar_command(),
        new_command(),
    ],
}
exit(Exit.Code(light_phase(argv()) ?? app.run()))
