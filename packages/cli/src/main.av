//! The avra command. Every subcommand lives in its own file under
//! `commands/` — this entry composes them and nothing else.
//! Exit 0 clean, 1 diagnostics, 2 usage.
mod commands

use @std.cli.{App}
use commands.{
    check_command, ir_command, emit_command, build_command,
    run_command, test_command, explain_command, grammar_command, new_command,
}

extern fn avra_process_exit(code: int)

fn main() {
    let app = App {
        name: "avra",
        description: "The Avra compiler",
        version: "0.0.1",
        commands: [
            check_command(),
            ir_command(),
            emit_command(),
            build_command(),
            run_command(),
            test_command(),
            explain_command(),
            grammar_command(),
            new_command(),
        ],
    }
    avra_process_exit(app.run())
}
