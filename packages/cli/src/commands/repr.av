//! `avra repr <type>` — the runtime REPRESENTATION the compiler chose
//! for a type expression (features/values.av's `repr_word`): flat,
//! boxed, niche, or a one-slot box. A declared name (`Id?`) resolves
//! against the package the command stands in.
use @std.cli.{CliResult, Runnable, command, arg}

type ReprCmd = {}

impl Runnable for ReprCmd {
    fn run(args: CliResult) -> int {
        let p? = clean_program() else { return 1 }
        let type_text = args.arg("expr")
        answered(p.explain_repr(type_text), "`${type_text}` is not a type this package resolves — a scalar, `List<…>`, `Map<…>` or a declared struct, each under an optional `?`")
    }
}

export command repr {
    description: "The runtime representation the compiler chose for a type expression: flat, boxed, niche, or a one-slot box"
    arg expr {
        description: "a type expression (`int?`, `Id?`) — a declared name resolves against the package the command stands in"
        required: true
    }
    run: ReprCmd {}
}
