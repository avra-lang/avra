//! `avra repr <type>` — the runtime REPRESENTATION the compiler chose
//! for a type expression (`type_repr`, on the program layer): flat,
//! boxed, niche, a one-slot box, a pair, or a spare tag. A declared
//! name (`Id?`) resolves in the package the command stands in, where
//! the first of its files that reads the name as a type stands.
use @std.cli.{CliResult, Runnable, command, arg}
use @std.avrac.compiler.{avra_fact_definitions, type_repr}
use @std.path.{joined_path}
use @std.program.layered_store.{program_store_at}
use @std.program.query_engine.{query_engine}

type ReprCmd = {}

impl Runnable for ReprCmd {
    fn run(args: CliResult) -> int {
        let type_text = args.arg("expr")
        let found = match repr_in(here(), type_text) { .Ok(f) -> f, .Err(code) -> { return code } }
        answered(
            found,
            "`${type_text}` is not a type this package resolves — a scalar, `List<…>`, `Map<…>` or a name one of its files declares or imports, each under an optional `?`",
        )
    }
}

/// The representation of the type `text` spells in the package at `root`: the first answer one of
/// its source files gives, read on the program layer; absent where none reads it as a type. The
/// exit spoken where no std stands beside this compiler.
fn repr_in(root: string, text: string) -> Result<string?, int> {
    let disk? = disk_at(root, "") else { return .Err(std_unfound()) }
    let store = program_store_at(joined_path(root, ".avra-cache/tapes"))
    let engine = query_engine(store, avra_fact_definitions())
    let found = disk.held(engine).find_map((p) -> type_repr(engine, disk.file_at(p), text))
    store_kept(engine, store)
    found
}

export command repr {
    description: "The runtime representation the compiler chose for a type expression: flat, boxed, niche, a one-slot box, a pair, or a spare tag"
    arg expr {
        description: "a type expression (`int?`, `Id?`) — a declared name resolves in the package the command stands in"
        required: true
    }
    run: ReprCmd {}
}
