//! `avra writes <fn>` — the WRITE-FLOW CHAIN the program layer's
//! receiver survey (compiler/item_writes.av, `write_chain`) finds for
//! `fn`'s seat 0 (a method's receiver, a free fn's first parameter):
//! the fn names, in call order, from `fn` to the one whose declaration
//! or body writes it directly — the same evidence the unwritten-`mut`
//! warning reads, turned into a few seconds instead of reading every
//! callee by hand. The name is looked up in each file of the package
//! the command stands in; the first that declares such a fn answers.
use @std.cli.{CliResult, Runnable, command, arg}
use @std.avrac.compiler.{avra_fact_definitions, write_chain}
use @std.path.{joined_path}
use @std.program.layered_store.{program_store_at}
use @std.program.query_engine.{query_engine}

type WritesCmd = {}

impl Runnable for WritesCmd {
    fn run(args: CliResult) -> int {
        let fn_name = args.arg("name")
        let found = match writes_in(here(), fn_name) { .Ok(f) -> f, .Err(code) -> { return code } }
        answered(found, "no fn `${fn_name}` is declared in this package with a written seat 0")
    }
}

/// The write-flow chain of the fn `name` in the package at `root`, its hops joined in call order:
/// the first chain one of its source files gives, read on the program layer; absent where none
/// does. The exit spoken where no std stands beside this compiler.
fn writes_in(root: string, name: string) -> Result<string?, int> {
    let disk? = disk_at(root, "") else { return .Err(std_unfound()) }
    let store = program_store_at(joined_path(root, ".avra-cache/tapes"))
    let engine = query_engine(store, avra_fact_definitions())
    let found = disk.held(engine).find_map((p) -> write_chain(engine, disk.file_at(p), name))
    store_kept(engine, store)
    found?.join(" -> ")
}

export command writes {
    description: "The write-flow chain from a fn to whichever callee actually writes its seat 0"
    arg name {
        description: "a declared fn's name — a method's receiver or a free fn's first parameter is its seat 0"
        required: true
    }
    run: WritesCmd {}
}
