//! `avra docs` — one address space: what a diagnostic code means, a
//! declared symbol's own `///` doc, an annotation's signature, a
//! type's representation, a write-flow chain, `rules` — every rule
//! the compiler carries, by identity — `dump` — every exported
//! symbol's own facts, one row each — or `process` — the tools the
//! package you stand in declares, each resolved where it stands
//! today, printed before anything runs.
use @std.cli.{CliResult, Runnable, command, arg, flag}
use @std.avrac.compiler.{avra, Program, RuleEntry, rule_id, declared_law, DocRow, build_cache_root, Db, db, db_qualified, DocFacts, FileWitness, current_listing_digest, current_file_digest}
use @std.avrac.compiler.store.{Store, store_at}
use @std.avrac.diagnostics.{DiagCode, Diag, new_source_file, render}
use @std.path.{joined_path}
use @std.process.{Tool, tool, tool_from_env, ProcessError}
use @std.io.{read_text, exists}
use @std.avrac.compiler.dev.{shown_code}
use @std.avrac.compiler.host.{ToolRow, read_manifest}
use @std.json.{Json, field, to_text}

type DocsCmd = {}

impl Runnable for DocsCmd {
    fn run(args: CliResult) -> int {
        let q = args.arg("address")
        if q == "process" { return explained_process(args.arg("at")) }
        if q == "rules" { return listed_rules(args.has_flag("json")) }
        if q == "dump" { return dumped(args.has_flag("json")) }
        if q == "repr" { return explained_repr(args.arg("at")) }
        if q == "writes" { return explained_writes(args.arg("at")) }
        if q.contains(":") { return explained_kind(q) }
        if q.starts_with("@") { return explained_annotation(q.substring(1, q.length)) }
        let hit: DiagCode? = avra().rows.codes.find(it.kind == q)
        if hit != null {
            let c = hit!
            println("${c.kind} — ${c.summary}")
            shown_witness(c.kind)
            return 0
        }
        explained_decl(q)
    }
}

/// WHAT THE CODE LOOKS LIKE. The registry's witness, run: the source
/// that triggers this code and the compiler's own words over it. A
/// REAL refusal with its holes filled beats a template of the law,
/// and it is the same rendering docs/DIAGNOSTICS.md pins.
fn shown_witness(kind: string) {
    let shown? = shown_code(kind) else { return }
    if !shown.fired { return }
    println("")
    println(shown.witness_source())
    println("")
    println(shown.rendered)
}

/// `avra docs @scope/name:E1` — a PACKAGE's diagnostic kind, from
/// the annotation fns the package you stand in reaches: registered by
/// spelling the kind as a literal in `refuse_as`.
fn explained_kind(q: string) -> int {
    // the package's own refusals are not in the way: the kind asked
    // about may be the one they wear
    mut p = root_program(here())
    let hit: DiagCode? = p.kind_rows().find(it.kind == q)
    if hit == null {
        eprintln("avra: no annotation this package reaches registers `${q}` — a kind registers when `refuse_as` spells it as a literal, or when an annotation speaks it")
        return 1
    }
    println("${hit!.kind} — ${hit!.summary}")
    0
}

/// This command's package-scoped arms open through one door: the
/// package's own program, clean — its refusal already reported, so
/// every caller below answers only the absence it was written for.
fn clean_program() -> Program? {
    let p = root_program(here())
    if !p.clean() {
        eprintln(p.report())
        return null
    }
    p
}

/// A found answer prints and exits clean; an absence explains why
/// and exits 1 — the shape every package-scoped arm below closes
/// with.
fn answered(text: string?, absent: string) -> int {
    let text? = text else {
        eprintln("avra: ${absent}")
        return 1
    }
    println(text)
    0
}

/// `avra docs @name` — the annotation fn's signature, which IS
/// its effect (§3.3 of the comptime design). The package is the
/// directory the command stands in, as `docs process` reads its
/// manifest.
fn explained_annotation(name: string) -> int {
    let p? = clean_program() else { return 1 }
    answered(p.explain_annotation(name), "no fn `${name}` is declared in this package")
}

/// `avra docs <name>` — a declared fn/type/enum/trait/const's own
/// `///` doc and `@name(args)` annotations, the fallback every other
/// form of the command misses through. The package is the directory
/// the command stands in, as every other form here reads it.
///
/// THE FAST PATH: a row this package's own db already holds, once its
/// witnesses still hold, answers with no program built at all — the
/// whole point of a durable `Db` (compiler/db.av). A miss falls back
/// to today's derivation and remembers what it found for the process
/// after this one.
fn explained_decl(name: string) -> int {
    let root = here()
    let store = store_at(build_cache_root(root_workspace(root)))
    mut d = db()
    let cached? = d.decl(store, db_qualified(root, name)) else { return derived_decl(d, store, root, name) }
    println(cached.answer)
    0
}

fn derived_decl(mut d: Db, store: Store, root: string, name: string) -> int {
    let p? = clean_program() else { return 1 }
    let found? = p.explain_doc(name) else {
        eprintln("avra: nothing registered under `${name}` — no diagnostic code, kind, or declared fn/type/enum/trait/const wears it")
        return 1
    }
    d.insert_decl(store, db_qualified(root, name), DocFacts {
        root: root,
        answer: found.text,
        listing_digest: current_listing_digest(root),
        files: [FileWitness { path: f, digest: current_file_digest(f) } for f in found.files],
    })
    println(found.text)
    0
}

/// `avra docs repr <type>` — the runtime REPRESENTATION the
/// compiler chose for a type expression (features/values.av's
/// `repr_word`): flat, boxed, niche, or a one-slot box. A declared
/// name (`Id?`) resolves against the package the command stands in,
/// as `docs @name` reads it.
fn explained_repr(type_text: string) -> int {
    let p? = clean_program() else { return 1 }
    answered(p.explain_repr(type_text), "`${type_text}` is not a type this package resolves — a scalar, `List<…>`, `Map<…>` or a declared struct, each under an optional `?`")
}

/// `avra docs writes <fn>` — the WRITE-FLOW CHAIN the seats pass
/// (compiler/receivers.av) found for `fn`'s seat 0 (a method's
/// receiver, a free fn's first parameter): the fn names, in call
/// order, from `fn` to the one whose declaration or body writes it
/// directly — the same evidence F2047 warns from, turned into a few
/// seconds instead of reading every callee by hand.
fn explained_writes(fn_name: string) -> int {
    let p? = clean_program() else { return 1 }
    answered(p.explain_writes(fn_name), "no fn `${fn_name}` is declared in this package with a written seat 0")
}

/// `avra docs rules` — every rule the compiler carries (the `rules`
/// collect), by identity: the ground truth a native idiom finding's
/// kind is checked against. `--json` answers `[{id, module, name,
/// doc, law}]` — `law` is `null` for a rule whose rewrite (if any)
/// stays behind `avra fix`'s IR proof alone, else the rule's own
/// equivalence claim (`RuleEntry.law`, compiler/rules_table.av).
fn listed_rules(json: bool) -> int {
    let entries = root_program(here()).rule_listing()
    println(if json { to_text(Json.Arr([rule_json(r) for r in entries])) } else { rules_listing(entries) })
    0
}

fn rule_json(r: RuleEntry) -> Json {
    Json.Obj([
        field("id", Json.Str(rule_id(r))),
        field("module", Json.Str(r.module)),
        field("name", Json.Str(r.name)),
        field("doc", Json.Str(r.doc)),
        field("law", law_json(declared_law(r))),
    ])
}

fn law_json(law: string?) -> Json {
    match law {
        s? -> Json.Str(s)
        null -> Json.Null
    }
}

/// Every rule's identity and doc, one per line in the collect's own
/// order, under a header naming the count.
export fn rules_listing(entries: List<RuleEntry>) -> string {
    ["rules this package declares — ${entries.length}"].concat(["${rule_id(r)} — ${r.doc}" for r in entries]).join("\n")
}

/// `avra docs dump` — every EXPORTED declaration's own facts, this
/// package's own, one row per symbol: `{address, kind, signature,
/// prose_lines, package}`. A pure read, deliberately: caching each row
/// into `Db` the way a single lookup does would need the same
/// collision grouping `explain_doc` already does, and doing that
/// without an O(n²) scan over a large package is real work this
/// door doesn't owe yet — left for whoever needs it next.
fn dumped(json: bool) -> int {
    let p? = clean_program() else { return 1 }
    let rows = p.dumped_decls(here())
    println(if json { to_text(Json.Arr([dump_json(r) for r in rows])) } else { dump_listing(rows) })
    0
}

fn dump_json(r: DocRow) -> Json {
    Json.Obj([
        field("address", Json.Str(r.address)),
        field("kind", Json.Str(r.kind)),
        field("signature", Json.Str(r.signature)),
        field("prose_lines", Json.Arr([Json.Str(line) for line in r.prose_lines])),
        field("package", Json.Str(r.package)),
    ])
}

/// Every exported symbol's address and signature, one per line, under
/// a header naming the count — `rules_listing`'s shape.
export fn dump_listing(rows: List<DocRow>) -> string {
    ["this package exports — ${rows.length}"].concat(["${r.address} — ${r.signature}" for r in rows]).join("\n")
}

/// The package's declared tools, minted as the library mints them, and
/// what a child inherits — the set of doors, before any opens. `at` is
/// the package's directory; the front door stands at the root.
fn explained_process(at: string) -> int {
    let manifest = joined_path(if at.length == 0 { here() } else { at }, "avra.toml")
    if !exists(manifest) {
        eprintln("avra: no ${manifest} — `docs process` reads a package's manifest")
        return 1
    }
    let src = new_source_file(manifest, read_text(manifest) catch "")
    let m = read_manifest(src)
    for d in m.voices { eprintln(render(d, src)) }
    if m.voices.any(refuses(it)) { return 1 }
    if m.tools.is_empty() {
        println("no [process.tools] declared — the script rung: any tool a literal names, an open set")
        return 0
    }
    println("tools this package declares — ${m.tools.length}")
    for row in m.tools { println("  ${row.name}  ${resolved_text(row)}  ${provenance_text(row)}  ${terminator_text(row.terminator)}") }
    println("a child inherits the minimal base: PATH (relative entries stripped) HOME TMPDIR TERM LANG=C LC_ALL=C NO_COLOR=1")
    0
}

/// A manifest voice that refuses — a warning is said and read past.
fn refuses(d: Diag) -> bool {
    d.severity is .Error
}

fn resolved_text(row: ToolRow) -> string {
    match minted(row) {
        .Ok(t) -> t.path,
        .Err(e) -> "NOT FOUND — ${e.describe().message}",
    }
}

/// A row minted as the library would, by its provenance.
fn minted(row: ToolRow) -> Result<Tool, ProcessError> {
    match row.from {
        .Path -> tool(row.name),
        .Env -> tool_from_env(row.var ?? "", row.default ?? row.name),
        .Abs -> tool(row.at_path ?? row.name),
    }
}

fn provenance_text(row: ToolRow) -> string {
    match row.from {
        .Path -> "from the PATH",
        .Env -> "from ${row.var ?? "?"}, else `${row.default ?? row.name}`",
        .Abs -> "at its path",
    }
}

fn terminator_text(t: string?) -> string {
    if t == null { return "options never end — a dashed word needs `after_options`" }
    "options end at `${t!}`"
}

export command docs {
    description: "One address space: an F-code, a kind, a declared symbol's own doc, an annotation's signature, a package kind (`@scope/name:E1`), `process`, `rules`, `dump`, `repr <type>`, or `writes <fn>`"
    arg address {
        description: "an F-code, a kind, a declared name, `@name`, a package kind (`@scope/name:E1`), `process`, `rules`, `dump`, `repr`, or `writes`"
        required: true
    }
    arg at { description: "for `process`: the package directory (the root when absent); for `repr`: a type expression (`int?`, `Id?`); for `writes`: a fn name" }
    flag json { description: "for `rules`: one JSON array of {id, module, name, doc}; for `dump`: one JSON array of {address, kind, signature, prose_lines, package}" }
    run: DocsCmd {}
}
