//! `@derive(View)` over a component that is no well-formed primitive and
//! no well-formed composition, and
//! an instance hearing an event its component does not declare: each
//! mistake is refused where it stands, in the library's own words, under
//! the library's own kind — and nothing else is said. `avra_ran`,
//! `scratch_dir` and `exit_is_zero` are the neighbouring tests' own: this
//! module shares one namespace.
use @std.io.{make_dirs, write_text}
use @std.meta.{embed}
use @std.time.{now_ns}

/// Components whose every member breaks one law of a primitive.
const parts: string = embed("ui_view/refused_parts.txt")

/// A program instancing one of them, and hearing an event a std control
/// does not declare.
const main: string = embed("ui_view/refused_main.txt")

/// What stands for a run that never answered: no line of it is a refusal,
/// and it holds every text a test denies, so no case passes over it.
const never_ran = "the check did not run: on_ data-refused no field `style`"

/// What `avra check` says about the package, once.
once fn refused() -> string {
    let root = "${scratch_dir()}/ui_view_${now_ns()}"
    let _ = make_dirs("${root}/src")
    let _ = write_text("${root}/avra.toml", "[package]\nname = \"ui_view\"\nversion = \"0.1.0\"\n")
    let _ = write_text("${root}/src/parts.av", parts)
    let _ = write_text("${root}/src/main.av", main)
    match avra_ran(["check", root]) { .Ok(o) -> o.out.stdout, .Err(_) -> never_ran }
}

/// Every refusal the run spoke, in order: its kind and its words.
fn spoken() -> List<string> { [l for l in refused().split("\n") if l.starts_with("error[")] }

/// The help under the refusal whose words open with `opening`.
fn help_under(opening: string) -> string {
    let lines = refused().split("\n")
    let at? = [j for j, l in lines if l.starts_with(opening)].first() else { return "no such refusal" }
    lines
        .slice(at, lines.length)
        .find(it.starts_with("help: ") || it.starts_with("error[") && it != lines[at]) ?? "no help"
}

/// Every refusal the fixture owes, one per mistake, in the order written.
const owed = [
    "error[type.component_event]: `button` declares no event `hovr` — an instance hears the events its component declares",
    "error[@std/ui:unprojected]: a primitive says what each member projects to, and `value` says nothing",
    "error[@std/ui:stateful-primitive]: a primitive draws what it is told, and `held` is a place it would keep",
    "error[@std/ui:attribute]: `Lable` is no attribute of a node",
    "error[@std/ui:attribute-misfit]: `Level` carries `int`, and `words` is `string`",
    "error[@std/ui:unnamed-mark]: `@attr` names what it marks its member as, and this one names nothing",
    "error[@std/ui:children]: a node's children are views, and `kids` is `List<int>`",
    "error[@std/ui:children]: a node's children are views, and `maybe` is `List<dyn View>?`",
    "error[@std/ui:style]: `colour` is no field of a node's style",
    "error[@std/ui:style-misfit]: a style's `color` is `Tone`, and `shade` is `string`",
    "error[@std/ui:unnamed-mark]: `@style` names what it marks its member as, and this one names nothing",
    "error[@std/ui:two-marks]: a member projects to one thing, and `both` says more than one",
    "error[@std/ui:marked-event]: an event is heard by its own word, and `press` is marked `@attr` too",
    "error[@std/ui:event]: `hover` is no event a target hears",
    "error[@std/ui:unsayable]: a control says nothing, text, a flag or a number, and `input` says `amount: float`",
    "error[@std/ui:prim]: a view is a primitive or is made of views, and `loose` says neither",
    "error[@std/ui:boxed-composition]: a composition wears its view's box, and `made` spreads one of its own",
    "error[@std/ui:marked-composition]: a composition projects nothing of its own, and `title` is marked `@attr`",
    "error[@std/ui:box]: a view carries the shared box, and `boxless` spreads none",
    "error[@std/ui:not-a-prim]: `Nope` is no primitive a target draws",
    "error[@std/ui:said-twice]: a node says its own words once, and another member already says them — `Label` would be lost",
    "error[@std/ui:said-twice]: a node carries an attribute once, and `Title` is already another member's",
    "error[@std/ui:said-twice]: a node's style holds `color` once, and another member already fills it",
]

spec "@derive(View) — a component that is no primitive" {
    given "one mistake per member, and per component" {
        then "is refused once per mistake, in these words and no others" { spoken().join("\n") == owed.join("\n") }
        then "is refused as many times as there are mistakes" { spoken().length == owed.length && owed.length == 23 }
    }
    given "a member that says nothing" {
        then "is told the ways to say it" {
            help_under("error[@std/ui:unprojected]") == "help: mark it `@attr(.Label)`, `@children` or `@style(color)`, or declare it an event — `on value`"
        }
    }
    given "an attribute the node does not have" {
        then "is told the attributes there are, from their own declaration" {
            help_under("error[@std/ui:attribute]")
                .starts_with("help: the attributes are `Text`, `Label`, `Level`, `Value`, `Amount`")
        }
    }
    given "an event no target hears" {
        then "is told the events there are, from their own declaration" {
            help_under("error[@std/ui:event]") == "help: a primitive's events are `press`, `input`, `change`, `submit`"
        }
    }
    given "a primitive `Prim` does not have" {
        then "is told the primitives there are" {
            help_under("error[@std/ui:not-a-prim]")
                .starts_with("help: the primitives are `Text`, `Heading`, `Button`")
        }
    }
    given "a component that names no primitive and has no view" {
        then "is told both things a view can be" {
            help_under("error[@std/ui:prim]") == "help: name the primitive it is — `@prim(.Text)` above it — or what it is made of — `fn view()` in it"
        }
    }
    given "a primitive that would keep state" {
        then "is told who keeps it" {
            help_under("error[@std/ui:stateful-primitive]") == "help: state is kept by the composition that uses the primitive — a component with `fn view()`"
        }
    }
    given "an instance hearing an event its component does not declare" {
        then "is told the component's events" {
            help_under("error[type.component_event]") == "help: the events of `button` are `press`"
        }
    }
    given "the whole run" {
        then "never names the member an event is held in" { !refused().contains("on_") }
        then "never refuses inside the library's own source" { !refused().contains("tree/view.av") }
        then "never blames a field the derive's template reads" { !refused().contains("no field `style`") }
    }
}

/// A well-formed primitive of a user's own, declaring an event, and a
/// program hearing it.
const knob_parts: string = embed("ui_view/knob_parts.txt")

const knob_main: string = embed("ui_view/knob_main.txt")

fn knob_package() -> string {
    let root = "${scratch_dir()}/ui_knob_${now_ns()}"
    let _ = make_dirs("${root}/src")
    let _ = write_text("${root}/avra.toml", "[package]\nname = \"ui_knob\"\nversion = \"0.1.0\"\n")
    let _ = write_text("${root}/src/parts.av", knob_parts)
    let _ = write_text("${root}/src/main.av", knob_main)
    root
}

spec "@derive(View) — a user's own primitive" {
    given "a component that says what every member is, and declares an event" {
        then "is a control under its label: its attribute, its property, and all four events heard by their own words" {
            clean_stdout(avra_ran(["run", knob_package()])) == "create 0 label\ncreate 0/+control input\nattr 0/+control type=range\nattr 0/+control aria-label=Volume\nprop 0/+control value=\"0\"\nlisten 0/+control change number\nlisten 0/+control press\nlisten 0/+control input text\nlisten 0/+control submit\nplace 0/+control in 0 after -\ncreate 0/+words span\ntext 0/+words/+text Volume\nplace 0/+words/+text in 0/+words after -\nplace 0/+words in 0 after 0/+control\nplace 0 in - after -\n"
        }
        then "stands canonical as written — marks, events and handlers round-trip" {
            match avra_ran(["fmt", "--check", knob_package()]) {
                .Ok(o) -> exit_is_zero(o.exit),
                .Err(_) -> false,
            }
        }
    }
}
