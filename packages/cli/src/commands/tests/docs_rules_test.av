//! `avra docs rules` — every rule the compiler carries
//! (compiler/rules_table.av's `rules` collect), by identity and doc.
use commands.{rules_listing}
use @std.avrac.compiler.{RuleEntry, rules, rule_id}

/// A minimal `RuleEntry` — `run` answers nothing, since the listing
/// never calls it.
fn entry(module: string, name: string, doc: string) -> RuleEntry {
    RuleEntry { name: name, module: module, run: (c) -> null, root: -1, doc: doc, fixes: [], keeps: [] }
}

spec "commands/docs rules" {
    given "an empty rule list" {
        then "the header names zero and nothing follows" {
            rules_listing([]) == "rules this package declares — 0"
        }
    }
    given "a few rules" {
        then "each line is its `module.name` identity, an em dash, and its doc, in the list's own order" {
            let text = rules_listing([entry("loops", "push_loop", "a for-loop that is one push is a MAP"), entry("nullable", "if_null_ternary", "")])
            text == "rules this package declares — 2\nloops.push_loop — a for-loop that is one push is a MAP\nnullable.if_null_ternary — "
        }
    }
    given "the compiler's own live rule table" {
        then "every entry's identity and doc round-trip through the listing, one line each" {
            let text = rules_listing(rules)
            [entry_line(r) for r in rules].all((line) -> text.contains(line))
        }
        then "the header's count agrees with the list's own length" {
            rules_listing(rules).contains(" ${rules.length}")
        }
    }
}

fn entry_line(r: RuleEntry) -> string { "${rule_id(r)} — ${r.doc}" }
