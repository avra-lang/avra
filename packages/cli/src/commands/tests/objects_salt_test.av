//! A BUILD'S OBJECTS ARE A FUNCTION OF WHAT THEY ARE MADE FOR. Every key a build's objects make
//! holds `objects_salt`: the compiler, the backend's code, the level, the inlining, the target, what
//! the binary links and the tools that link it. So an object made for one target never answers for
//! another, and the same build asked again keys alike.
use commands.{BinaryAsked, salted_by}
use @std.program.{SourceFileAddress}

/// A native dev build of one file, as a build asks for it.
fn asked() -> BinaryAsked {
    BinaryAsked {
        entry: SourceFileAddress { package_name: "app", path_in_package: "src/main.av" },
        compiler: "avra",
        head: [],
        words: [],
        linked: ["runtime"],
        dir: "/w/.avra-cache/tapes-build",
        opt: "-O0",
        layered: true,
        inlined: true,
    }
}

/// The salt `a` makes its objects under, beside code hash `h`, as one text.
fn salt(a: BinaryAsked, h: string) -> string { salted_by(a, h).join("\n") }

spec "commands/tapes — the salt every object key holds" {
    given "the same build asked twice" {
        then "it salts its objects alike" { salt(asked(), "h") == salt(asked(), "h") }
    }
    given "the same build for another target" {
        then "the salt moves, so no object made for the host answers for it" {
            salt(asked() with { target: "wasm32-wasip1" }, "h") != salt(asked(), "h")
        }
        then "two targets salt apart from each other too" {
            salt(asked() with { target: "wasm32-wasip1" }, "h") != salt(asked() with { target: "wasm32-unknown-wasi" }, "h")
        }
    }
    given "the level, the inlining, and the backend's code" {
        then "each moves the salt on its own" {
            let base = salt(asked(), "h")
            salt(asked() with { opt: "-O1" }, "h") != base &&
                salt(asked() with { inlined: false }, "h") != base &&
                salt(asked(), "h2") != base
        }
    }
}
