// The light phase's two pure parts: the plan's binary, and what an
// exit means. Attacked at the edges: no `-o`, `-o` last, the exits a
// red suite, a trap and a signal produce.
use commands.{plan_binary, verdict}
use @std.process.{Exit}

spec "the link plan" {
    given "clang's words" {
        then "the binary is the word after -o" {
            plan_binary(["-w", "-O0", "m.ll", "-o", "build/m"]) == "build/m"
        }
        then "a plan without -o names no binary" {
            plan_binary(["-w", "-O0", "m.ll"]) == null
        }
        then "-o as the last word names no binary" {
            plan_binary(["-w", "m.ll", "-o"]) == null
        }
        then "an empty plan names no binary" {
            plan_binary([]) == null
        }
    }
}

spec "the verdict" {
    given "an exit" {
        then "clean is green" { verdict(Exit.Clean) is .Green }
        then "1 is red" { verdict(Exit.Code(1)) is .Red }
        then "a trap's 2 is a death" { verdict(Exit.Code(2)) is .Died }
        then "a signal is a death" { verdict(Exit.Signal(9, false)) is .Died }
    }
}
