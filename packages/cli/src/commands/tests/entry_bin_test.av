//! THE ENTRY IS `[bin]`, ELSE `src/main.av`: `avra run` of a package runs the program its
//! manifest names, or with none named its `src/main.av`. Real subprocesses over packages minted
//! fresh; `avra_said_in` and `scratch_dir` are the neighbouring tests' own.
use @std.io.{make_dirs, write_text}
use @std.time.{stamp}

/// A package minted fresh, `manifest_tail` after its `[package]` table, whose one program is the
/// file `program`, printing its own name.
fn entry_package(name: string, manifest_tail: string, program: string) -> string {
    let root = "${scratch_dir()}/entry_${name}_${stamp()}"
    let _ = make_dirs("${root}/src")
    let _ = write_text("${root}/.git", "")
    let _ = write_text(
        "${root}/avra.toml",
        "[package]\nname = \"app\"\nversion = \"0.1.0\"\n${manifest_tail}",
    )
    let _ = write_text("${root}/src/${program}.av", "println(\"${program}\")\n")
    root
}

spec "cli — the entry a package runs" {
    given "a manifest naming no program" {
        then "`src/main.av` runs" { avra_said_in(entry_package("plain", "", "main"), ["run", "."]) == "main" }
    }
    given "a manifest whose `[bin]` names a program" {
        then "that program runs" {
            avra_said_in(
                entry_package("binned", "\n[bin]\npath = \"src/app.av\"\n", "app"),
                ["run", "."],
            ) == "app"
        }
    }
}
