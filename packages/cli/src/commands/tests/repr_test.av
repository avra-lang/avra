//! `avra repr <type>` — the runtime REPRESENTATION `type_repr` names for a
//! type expression on the program layer: flat, boxed, niche, a one-slot
//! box, a pair, or a spare tag.
use @std.io.{make_dirs, write_text}
use @std.time.{stamp}

/// One directory per run, so no earlier run's cache answers for this one.
once fn repr_base() -> string { "/tmp/avra-explain-repr-test/${stamp()}" }

/// A package declaring one flat struct — enough to resolve a scalar, a
/// `List`, and a declared name, bare and under `?`.
fn pkg_with_id(name: string) -> string {
    let root = "${repr_base()}/${name}"
    let _ = make_dirs("${root}/src")
    let _ = write_text("${root}/avra.toml", "[package]\nname = \"${name}\"\nversion = \"0.0.1\"\n")
    let _ = write_text("${root}/src/main.av", "type Id = { n: int }\n\nfn main() -> int { 0 }\n")
    root
}

/// A wider package: a flat one-field record, a non-flat two-field one,
/// an enum, and a named alias — every declared-kind the resolver could
/// be asked about, not just the one it answers.
fn pkg_wide(name: string) -> string {
    let root = "${repr_base()}/${name}"
    let _ = make_dirs("${root}/src")
    let _ = write_text("${root}/avra.toml", "[package]\nname = \"${name}\"\nversion = \"0.0.1\"\n")
    let src = "type Id = { n: int }\ntype Pair = { a: int, b: string }\nenum Color { Red Green Blue }\ntype Alias = int\n\nfn main() -> int { 0 }\n"
    let _ = write_text("${root}/src/main.av", src)
    root
}

/// The representation `text` has in the package at `root`, absent where it resolves nothing.
fn repr_of(root: string, text: string) -> string? { avra_said_in(root, ["repr", text]) }

spec "commands/repr" {
    given "a package declaring a flat struct" {
        then "a nullable scalar is a register pair" {
            repr_of(pkg_with_id("pair"), "int?") == "pair"
        }
        then "a nullable string is a niche — the pointer's own null is absence" {
            repr_of(pkg_with_id("niche"), "string?") == "niche"
        }
        then "a nullable flat record is a one-slot box — a word has no spare value" {
            repr_of(pkg_with_id("boxed-opt"), "Id?") == "one-slot box"
        }
        then "a bare scalar is flat — it rides in registers, no pointer" {
            repr_of(pkg_with_id("bare-scalar"), "int") == "flat"
        }
        then "a bare flat record is flat too — it rides as its one field" {
            repr_of(pkg_with_id("bare-record"), "Id") == "flat"
        }
        then "a List is boxed — an ordinary managed pointer" {
            repr_of(pkg_with_id("list"), "List<int>") == "boxed"
        }
        then "an undeclared name resolves nothing" {
            repr_of(pkg_with_id("miss-name"), "NotDeclared") == null
        }
        then "malformed syntax resolves nothing, never a crash" {
            repr_of(pkg_with_id("miss-syntax"), "int??") == null
        }
    }
    given "a package declaring every other kind the resolver could be asked about" {
        then "a non-flat multi-field struct is boxed — an ordinary managed pointer" {
            repr_of(pkg_wide("pair-struct"), "Pair") == "boxed"
        }
        then "a non-flat struct's nullable is a niche — it already rode a pointer" {
            repr_of(pkg_wide("pair-struct-opt"), "Pair?") == "niche"
        }
        then "an enum whose variants carry nothing is flat — its tag is its whole value" {
            repr_of(pkg_wide("enum"), "Color") == "flat"
        }
        then "its nullable spends a tag no variant has" { repr_of(pkg_wide("enum-opt"), "Color?") == "tag -1" }
        then "a named alias is what it stands for" {
            repr_of(pkg_wide("alias"), "Alias") == "flat" &&
                repr_of(pkg_wide("alias-opt"), "Alias?") == "pair"
        }
        then "a declared name nested inside List/Map is read too — the list is boxed whatever it holds" {
            repr_of(pkg_wide("nested"), "List<Map<string, Id>>") == "boxed"
        }
        then "a name nothing declares, nested, resolves nothing, never a wrong word" {
            repr_of(pkg_wide("nested-miss"), "List<Map<string, Nope>>") == null
        }
        then "a map is boxed" { repr_of(pkg_wide("map"), "Map<string, int>") == "boxed" }
        then "a map keyed by anything but text is no type, and resolves nothing" {
            repr_of(pkg_wide("map-key"), "Map<int, int>") == null
        }
    }
}
