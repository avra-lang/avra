//! `avra settled <file> <name>` — a settled const read as JSON text: records by
//! field name, lists, nullables, maps and enums, each from the program's own
//! source, through the command as a shell runs it. `avra_ran` and
//! `scratch_dir` are the neighbouring tests' own: this module shares one
//! namespace.
use @std.io.{make_dirs, write_text}
use @std.time.{stamp}

/// What `avra settled` prints for the const `name` of a one-file program of `source`: its JSON, or
/// its refusal behind `refused: `.
fn json_of(source: string, name: string) -> string {
    let dir = "${scratch_dir()}/settled_${stamp()}"
    let _ = make_dirs(dir)
    let _ = write_text("${dir}/p.av", source)
    match avra_ran(["settled", "${dir}/p.av", name]) {
        .Ok(o) -> if exit_is_zero(o.exit) { o.out.stdout.trim() } else { "refused: ${o.out.stdout.trim()}" },
        .Err(_) -> "the command did not run",
    }
}

spec "avra settled — what the compiler settled, as JSON" {
    given "scalars and lists" {
        then "a list of ints is an array" { json_of("const xs: List<int> = [1, 2, 3]\n", "xs") == "[1,2,3]" }
        then "text is quoted and escaped" { json_of("const s: string = \"a\\\"b\"\n", "s") == "\"a\\\"b\"" }
        then "a bool is a word" { json_of("const b: bool = true\n", "b") == "true" }
    }
    given "records" {
        then "a record is an object by field name" {
            json_of(
                "type P = { x: int, name: string, on: bool }\nconst p: P = P { x: 3, name: \"n\", on: false }\n",
                "p",
            ) == "{\"x\":3,\"name\":\"n\",\"on\":false}"
        }
        then "a flat record of one field is an object too" {
            json_of("type Id = { n: int }\nconst i: Id = Id { n: 7 }\n", "i") == "{\"n\":7}"
        }
        then "a nullable field is its value or null" {
            json_of(
                "type P = { a: string?, b: string? }\nconst p: P = P { a: \"x\", b: null }\n",
                "p",
            ) == "{\"a\":\"x\",\"b\":null}"
        }
        then "a list of records nests" {
            json_of(
                "type P = { x: int, tags: List<string> }\nconst ps: List<P> = [P { x: 1, tags: [\"a\"] }, P { x: 2, tags: [] }]\n",
                "ps",
            ) == "[{\"x\":1,\"tags\":[\"a\"]},{\"x\":2,\"tags\":[]}]"
        }
    }
    given "enums and maps" {
        then "a payload-free variant is its name" {
            json_of("enum K { A, B }\nconst k: K = K.B\n", "k") == "\"B\""
        }
        then "a map is an object in insertion order" {
            json_of("const m: Map<string, int> = { \"a\": 1, \"b\": 2 }\n", "m") == "{\"a\":1,\"b\":2}"
        }
    }
    given "what is not a const" {
        then "an undeclared name is refused by name" {
            json_of("const xs: List<int> = [1]\n", "ys") == "refused: no const `ys` is declared here"
        }
    }
    given "floats, bytes, results and value enums" {
        then "a float is its shortest round-trip text" {
            json_of("const x: float = 0.1\n", "x") == "0.1" &&
                json_of("const y: float = 100.0\n", "y") == "100.0"
        }
        then "a float inside a record" {
            json_of("type P = { r: float }\nconst p: P = P { r: 2.5 }\n", "p") == "{\"r\":2.5}"
        }
        then "bytes are base64, named" {
            json_of("const b: Bytes = [104, 105].bytes()!\n", "b") == "{\"base64\":\"aGk=\"}"
        }
        then "a result is its one side under ok or err" {
            json_of("const r: Result<int, string> = Result.Ok(3)\n", "r") == "{\"ok\":3}" &&
                json_of("const e: Result<int, string> = Result.Err(\"no\")\n", "e") == "{\"err\":\"no\"}"
        }
        then "a value enum in a record is its variant, with its word" {
            json_of(
                "enum V { A(n: int), B }\ntype H = { x: V, y: V }\nconst h: H = H { x: V.A(5), y: V.B }\n",
                "h",
            ) == "{\"x\":{\"variant\":\"A\",\"payload\":[5]},\"y\":\"B\"}"
        }
        then "a nullable value enum is null when absent" {
            json_of(
                "enum V { A(n: int), B }\ntype H = { x: V?, y: V? }\nconst h: H = H { x: V.A(1), y: null }\n",
                "h",
            ) == "{\"x\":{\"variant\":\"A\",\"payload\":[1]},\"y\":null}"
        }
    }
}
