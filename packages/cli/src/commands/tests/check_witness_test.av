// `avra check`'s real, end-to-end use of the durable witness pack
// (avra-8sb5.57.55) — `checked_at` alone, never `witnessed_check`
// directly (witness_test.av's own subject): each call here mints a
// FRESH Workspace, so two calls over the same root are two
// "processes" sharing only the pack file `holding` now opens on its
// own, the way a real second `avra check` invocation would.
use @std.io.{make_dirs, write_text}
use commands.{checked_at}

fn root(name: string) -> string { "/tmp/avra-witness-cli-test/${name}" }

/// A two-file library with a real cross-file dependency (`b` calls
/// `a`'s `f`), the shape witness_test.av's own fixture uses — so a
/// witness that stays valid across an unrelated edit, and one that
/// refuses across a signature edit, are both exercised through the
/// CLI's own door, not the compiler's internal one.
fn two_file_pkg(name: string) -> string {
    let r = root(name)
    let _ = make_dirs("${r}/src")
    let _ = write_text("${r}/avra.toml", "[package]\nname = \"${name}\"\nversion = \"0.0.1\"\n")
    let _ = write_text("${r}/src/a.av", "export fn f() -> int {\n    1\n}\n")
    let _ = write_text("${r}/src/b.av", "export fn g() -> int {\n    f() + 1\n}\n")
    r
}

spec "cli check_witness" {
    given "a checked package, then checked again unchanged" {
        then "the second check reuses the whole-program answer" {
            let r = two_file_pkg("unchanged")
            let _ = checked_at(r)
            match checked_at(r) { .Ok(c) -> c.reused, .Err(_) -> false }
        }
    }
    given "a checked package, one file edited, checked a third time" {
        // ON A PACKAGE THIS SMALL, the HELD interface path (an older,
        // separate reuse mechanism — record.av) already reconstructs
        // the unedited file from its own record, so it never reaches
        // `says`'s witness splice at all: `held` and `witnessed`
        // divide the unedited files between them, not double-count
        // them. What this proves is the part that IS this ticket's:
        // the program-level cache correctly misses on the real edit,
        // and the answer that comes back is still exactly right —
        // never a stale warning carried over from before the edit.
        then "the whole-program cache misses, and the answer reflects the edit" {
            let r = two_file_pkg("one-edited")
            let _ = checked_at(r)
            let _ = checked_at(r)
            let _ = write_text("${r}/src/b.av", "export fn g() -> int {\n    f() + 2\n}\n")
            match checked_at(r) { .Ok(c) -> !c.reused, .Err(_) -> false }
        }
        then "a further, truly unchanged check reuses the whole program again" {
            // the edit above is now the standing content — a fourth
            // call with nothing further changed is warm exactly as
            // the first pair was, proving the edited file's own fresh
            // witness (recorded by the previous check) took.
            let r = root("one-edited")
            match checked_at(r) { .Ok(c) -> c.reused, .Err(_) -> false }
        }
    }
}
