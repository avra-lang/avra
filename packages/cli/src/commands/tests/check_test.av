//! `avra check <dir>` — a root's own SHAPE must speak. `build_workspace`'s
//! directory branch used to route every directory through `timed_workspace`
//! regardless of whether `src/` existed, so a src-less root's `root_files()`
//! walked a `src/` that was never there, answered `[]`, and `check` reported
//! clean having examined nothing — silence the law forbids. `root_workspace`
//! is the fix: the same choice `file_workspace` already makes, for a
//! directory taken as the root itself rather than a file under it.
use @std.io.{make_dirs, write_text}
use @std.time.{now_ns}
use commands.{checked_at}

/// One directory per run, so no earlier run's cache answers for this one.
once fn check_nothing_base() -> string { "/tmp/avra-check-nothing-test/${now_ns()}" }

fn dir_named(name: string) -> string { "${check_nothing_base()}/${name}" }

/// A package root of one bare manifest, no `src/` — the shape this repo's
/// own root carries, and the shape that read clean before this fix.
fn rootless_root(name: string) -> string {
    let root = dir_named(name)
    let _ = make_dirs(root)
    let _ = write_text("${root}/avra.toml", "[package]\nname = \"${name}\"\nversion = \"0.0.1\"\n")
    root
}

/// A file directly in the root — the one shape `programs_workspace` reaches.
fn direct_program(root: string, name: string, text: string) {
    let _ = write_text("${root}/${name}.av", text)
}

/// `check <root>` through the command's own door — the refusal, or what
/// merely warned ("" reads as clean).
fn report_of(root: string) -> string {
    match checked_at(root) { .Err(report) -> report, .Ok(c) -> c.warnings }
}

/// manifest.no_source's exact words — the golden this fix owes.
fn no_source_message(root: string) -> string {
    "error[manifest.no_source]: nothing to check under `${root}`: no `src/` and no program files\nhelp: add a `src/` directory, or a `.av` file directly under this root"
}

spec "commands/check root_workspace" {
    given "a src-less root with no program files directly in it" {
        then "check refuses with manifest.no_source's exact words, never silence" {
            let root = rootless_root("empty")
            report_of(root) == no_source_message(root)
        }
    }
    given "a src-less root with a direct .av file — a directory of programs" {
        then "a clean one is examined and answers clean" {
            let root = rootless_root("clean")
            direct_program(root, "a", "let a = 1\na + 1\n")
            report_of(root) == ""
        }
        then "a broken one is examined and refused, never silently clean" {
            let root = rootless_root("broken")
            direct_program(root, "a", "garbage ((((\n")
            report_of(root).contains("parse.expected")
        }
    }
    given "a src-less root with no program files AND a broken manifest" {
        then "the manifest's own refusal speaks — never shadowed by the more generic manifest.no_source" {
            let root = dir_named("broken-manifest")
            let _ = make_dirs(root)
            let _ = write_text("${root}/avra.toml", "this is not toml [[[\n")
            let report = report_of(root)
            report.contains("manifest.syntax") && !report.contains("manifest.no_source")
        }
    }
    given "a root with a real src/ — the sibling branch this fix does not touch" {
        then "the ordinary package path runs, untouched" {
            let root = dir_named("has-src")
            let _ = make_dirs("${root}/src")
            let _ = write_text(
                "${root}/avra.toml",
                "[package]\nname = \"has-src\"\nversion = \"0.0.1\"\n\n[lib]\nname = \"has-src\"\npath = \"src/main.av\"\n",
            )
            let _ = write_text("${root}/src/main.av", "export fn f() -> int { 1 }\n")
            report_of(root) == ""
        }
    }
}
