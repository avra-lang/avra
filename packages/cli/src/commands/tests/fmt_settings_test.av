//! `avra fmt` over an instance's block of settings: one canonical form for a block written on one
//! line, its settings parted by commas, and one for a block written across lines, a setting a line
//! and no commas — each its own fixed point, byte for byte. `fmt_fixture`, `fmt_ran` and `on_disk`
//! are fmt_bare_test.av's own: this module shares one namespace.

fn chip_declared() -> string { "component chip(label: string) {\n    tone: int = 0\n    size: int = 1\n}\n\n" }

const ONE_LINE: string = "let c = chip \"x\" { tone: 2, size: 3 }\n"

const ACROSS_LINES: string = "let c = chip \"x\" {\n    tone: 2\n    size: 3\n}\n"

const LINES_WITH_COMMAS: string = "let c = chip \"x\" {\n    tone: 2,\n    size: 3,\n}\n"

const CRAMPED: string = "let c = chip \"x\" {tone: 2,size: 3}\n"

/// The file `avra fmt --write` leaves of the declaration and `body`.
fn written_as(name: string, body: string) -> string {
    let path = fmt_fixture(name, chip_declared() + body)
    let _ = fmt_ran(["fmt", "--write", path])
    on_disk(path)
}

spec "avra fmt — an instance's block of settings" {
    given "a block written on one line" {
        then "it comes back as written, its settings parted by commas" { written_as("fmt_settings_line", ONE_LINE) == chip_declared() + ONE_LINE }
        then "a cramped one reaches that form" { written_as("fmt_settings_cramped", CRAMPED) == chip_declared() + ONE_LINE }
    }
    given "a block written across lines" {
        then "it comes back as written, a setting a line" { written_as("fmt_settings_lines", ACROSS_LINES) == chip_declared() + ACROSS_LINES }
        then "commas at its lines' ends are dropped, and that form is kept" {
            written_as("fmt_settings_commas", LINES_WITH_COMMAS) == chip_declared() + ACROSS_LINES &&
                written_as("fmt_settings_commas_again", ACROSS_LINES) == chip_declared() + ACROSS_LINES
        }
    }
}
