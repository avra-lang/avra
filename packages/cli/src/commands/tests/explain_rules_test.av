//! `avra explain rules` — every rule the compiler carries
//! (compiler/rules_table.av's `rules` collect), by identity: the
//! structural ground truth `tools/idioms.py`'s native-finding filter
//! reasons about (avra-8sb5.25.49), never a kind string's own shape.
use commands.{rules_listing}
use @std.avrac.compiler.{RuleEntry, rules, rule_id}

/// A minimal `RuleEntry` — `run` answers nothing, since the listing
/// never calls it.
fn entry(module: string, name: string) -> RuleEntry {
    RuleEntry { name: name, module: module, run: (c) -> null, root: -1, doc: "", fixes: [], keeps: [] }
}

spec "commands/explain rules" {
    given "an empty rule list" {
        then "the header names zero entries and nothing follows" {
            rules_listing([]) == "rules — List<RuleEntry>, rule in closure, by module then name — 0 entries"
        }
    }
    given "a few rules" {
        then "each line is two spaces and its `module.name` identity, in the list's own order" {
            let text = rules_listing([entry("loops", "push_loop"), entry("nullable", "if_null_ternary")])
            text == "rules — List<RuleEntry>, rule in closure, by module then name — 2 entries\n  loops.push_loop\n  nullable.if_null_ternary"
        }
    }
    given "the compiler's own live rule table" {
        then "every entry's identity round-trips through the listing, one line each" {
            let text = rules_listing(rules)
            [rule_id(r) for r in rules].all((id) -> text.contains("  ${id}"))
        }
        then "the header's count agrees with the list's own length" {
            rules_listing(rules).contains(" ${rules.length} entries")
        }
    }
}
