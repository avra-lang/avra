//! `avra cache` — its modes by their words, one spelling each, `held`
//! answering a check's hold file by file, and every mode naming the input an
//! edit moved — however often it is asked, since a mode keeps nothing.
use @std.io.{make_dirs, write_text}
use @std.time.{now_ns}
use @std.avrac.compiler.{Want, FileHold, HeldMismatch}
use @std.avrac.compiler.families.{Family}
use commands.{cache_mode, cache_answer, CacheMode, checked_at, root_workspace, disagreement_line}

/// A package root of one file under `src/`, holding `text` — its own path
/// each run, so nothing an earlier run kept answers for it.
fn cache_probe(name: string, text: string) -> string {
    let root = "/tmp/avra-cache-test/${name}-${now_ns()}"
    let _ = make_dirs("${root}/src")
    let _ = write_text("${root}/avra.toml", "[package]\nname = \"${name}\"\nversion = \"0.0.1\"\n")
    let _ = write_text("${root}/src/main.av", text)
    root
}

/// The package's holds as a check asks them, after a check has run.
fn holds_after_check(root: string) -> List<FileHold> {
    let _ = checked_at(root)
    root_workspace(root).hold_report(Want.Diagnostics) catch []
}

/// A package whose `main` reads one fn from a module `lib` of one file.
fn lib_probe(name: string) -> string {
    let root = cache_probe(name, "use lib.{one}\none()\n")
    let _ = make_dirs("${root}/src/lib")
    let _ = write_text("${root}/src/lib/a.av", "export fn one() -> int { 1 }\n")
    root
}

/// A lib probe checked, then its module's one file given a new signature —
/// the input every mode must name.
fn edited_lib(name: string) -> string {
    let root = lib_probe(name)
    let _ = holds_after_check(root)
    let _ = write_text("${root}/src/lib/a.av", "export fn one(n: int = 0) -> int { 1 }\n")
    root
}

/// A mode's printed lines, or none when it refused.
fn mode_lines(mode: CacheMode, root: string, target: string) -> List<string> {
    match cache_answer(mode, root, target) { .Ok(lines) -> lines, .Err(_) -> [] }
}

/// A mode's refusal, or nothing when it answered.
fn mode_refusal(mode: CacheMode, root: string, target: string) -> List<string> {
    match cache_answer(mode, root, target) { .Ok(_) -> [], .Err(lines) -> lines }
}

fn main_hold(rows: List<FileHold>) -> FileHold? { rows.find(it.path.ends_with("/src/main.av")) }

spec "commands/cache" {
    given "a mode's word" {
        then "no word is the summary" {
            cache_mode("") == CacheMode.Summary
        }
        then "each question answers to its own word" {
            ["why", "dependents", "changed", "held"].all(cache_mode(it) != null)
        }
        then "the retired spellings name no mode" {
            cache_mode("db") == null && cache_mode("explain") == null
        }
    }
    given "a package a check has just read" {
        then "every file is held" {
            let rows = holds_after_check(cache_probe("all_held", "let a = 1\na\n"))
            !rows.is_empty() && rows.all(it.held)
        }
        then "an edited file is read, because its text moved" {
            let root = cache_probe("edited", "let a = 1\na\n")
            let _ = holds_after_check(root)
            let _ = write_text("${root}/src/main.av", "let a = 2\na\n")
            let h = main_hold(root_workspace(root).hold_report(Want.Diagnostics) catch [])
            h != null && !h!.held && h!.why != null && h!.why!.says() == "its text moved"
        }
        then "a file added to a module it reads, naming nothing it reaches, holds it" {
            let root = lib_probe("grown_lib")
            let _ = holds_after_check(root)
            let _ = write_text("${root}/src/lib/b.av", "export fn two() -> int { 2 }\n")
            let h = main_hold(root_workspace(root).hold_report(Want.Diagnostics) catch [])
            h != null && h!.held && h!.moved.is_empty()
        }
        then "a signature that comes to name another file of the module names its interface, one file then and two now" {
            let root = lib_probe("reached_lib")
            let _ = write_text("${root}/src/lib/b.av", "export type Two = { n: int }\n")
            let _ = holds_after_check(root)
            let _ = write_text(
                "${root}/src/lib/a.av",
                "export fn one(t: Two? = null) -> int { 1 }\n",
            )
            let moved = main_hold(root_workspace(root).hold_report(Want.Diagnostics) catch [])?.moved ?? []
            moved.length == 1 &&
                moved[0].part.says().ends_with("lib's interface") &&
                moved[0].was.ends_with(", 1 file") &&
                moved[0].now.ends_with(", 2 files")
        }
        then "every file of the module that reads it names the move, not only the first kept" {
            let root = lib_probe("grown_lib_twice")
            let _ = write_text(
                "${root}/src/other.av",
                "use lib.{one}\nexport fn other() -> int { one() }\n",
            )
            let _ = holds_after_check(root)
            let _ = write_text("${root}/src/lib/a.av", "export fn one(n: int = 0) -> int { 1 }\n")
            let rows = root_workspace(root).hold_report(Want.Diagnostics) catch []
            let readers = rows.filter(!it.path.contains("/src/lib/"))
            readers.length == 2 &&
                readers.all(it.moved.any(it.part.says().ends_with("lib's interface")))
        }
        then "a seat's consumed mark moving names the one contract line it changed, then and now" {
            let root = cache_probe("consumed", "use lib.{kept}\nkept([1]).length\n")
            let _ = make_dirs("${root}/src/lib")
            let _ = write_text(
                "${root}/src/lib/a.av",
                "export fn kept(xs: List<int>) -> List<List<int>> { [xs] }\n",
            )
            let _ = holds_after_check(root)
            let _ = write_text(
                "${root}/src/lib/a.av",
                "export fn kept(xs: List<int>) -> List<List<int>> { [[xs.length]] }\n",
            )
            let moved = main_hold(root_workspace(root).hold_report(Want.Diagnostics) catch [])?.moved ?? []
            let lines = moved.find(it.part.says().ends_with("lib's interface"))?.lines ?? []
            lines.length == 2 &&
                lines[0].starts_with("- ") &&
                lines[1].starts_with("+ ") &&
                lines.all(it.contains("kept"))
        }
        then "an untouched module names nothing moved" {
            let root = lib_probe("still_lib")
            let _ = holds_after_check(root)
            let h = main_hold(root_workspace(root).hold_report(Want.Diagnostics) catch [])
            h != null && h!.held && h!.moved.is_empty()
        }
    }
    given "a package checked, then a module's file edited" {
        then "the summary counts the edited file as the one input whose text moved" {
            let lines = mode_lines(CacheMode.Summary, edited_lib("summary_edit"), "")
            lines.any(it == "cache: 1 input whose text moved since the kept state") &&
                lines.any(it == "cache:   src/lib/a.av")
        }
        then "changed names the moved input, then the file read again because of it" {
            let lines = mode_lines(CacheMode.Changed, edited_lib("changed_edit"), "")
            lines.any(it.starts_with("changed:   src/lib/a.av: its text ")) &&
                lines.any(it.starts_with("changed: src/main.av — read"))
        }
        then "why of the reader runs from its analysis down to the moved input's text" {
            let lines = mode_lines(CacheMode.Why, edited_lib("why_edit"), "src/main.av")
            lines.any(it == "why:   down to src/lib/a.av, whose text moved:") &&
                lines.any(it == "why:     Analysis(src/main.av)") &&
                lines.any(it.ends_with("reads Source(src/lib/a.av)"))
        }
        then "why of a query names the moved input it reads" {
            let lines = mode_lines(
                CacheMode.Why,
                edited_lib("why_query"),
                "Sig(one · src/lib/a.av)",
            )
            lines.first() ?? "" == "why: Sig(one · src/lib/a.av)" &&
                lines.any(it == "why:   down to src/lib/a.av, whose text moved:")
        }
        then "dependents of the edited file names the file a check analyses that reads it" {
            let lines = mode_lines(
                CacheMode.Dependents,
                edited_lib("dependents_edit"),
                "src/lib/a.av",
            )
            lines.first() ?? "" == "dependents: Source(src/lib/a.av)" &&
                lines.any(it == "dependents:     src/main.av")
        }
        then "a query naming nothing is refused, never answered empty" {
            let lines = mode_refusal(CacheMode.Why, edited_lib("why_nothing"), "no-such-thing")
            lines.length == 1 && lines[0].contains("matches `no-such-thing`")
        }
        then "changed asked twice answers the same move both times" {
            let root = edited_lib("changed_twice")
            let first = mode_lines(CacheMode.Changed, root, "")
            first.any(it.starts_with("changed:   src/lib/a.av: its text ")) &&
                first.join("\n") == mode_lines(CacheMode.Changed, root, "").join("\n")
        }
        then "held after changed still reads the edited file" {
            let root = edited_lib("held_after_changed")
            let _ = mode_lines(CacheMode.Changed, root, "")
            mode_lines(CacheMode.Held, root, "").any(it.starts_with("held: src/lib/a.av — read"))
        }
        then "a check after the modes keeps the edit, and only then has nothing moved" {
            let root = edited_lib("checked_after_modes")
            let _ = mode_lines(CacheMode.Changed, root, "")
            let _ = mode_lines(CacheMode.Why, root, "src/main.av")
            let _ = checked_at(root)
            mode_lines(CacheMode.Changed, root, "")
                .any(it == "changed: no input's text moved since the kept state")
        }
        then "changed refuses a target, since it answers for the whole package" {
            mode_refusal(CacheMode.Changed, edited_lib("changed_target"), "main").length == 1
        }
    }
    given "a held file a fresh reading disagrees with" {
        then "a Reference-row count reads as the rows naming the declaration, held then fresh" {
            disagreement_line(
                HeldMismatch {
                    file: "a.av",
                    decl: "check_length",
                    field: "Reference rows",
                    held: "0",
                    fresh: "1",
                },
            ) == "held:   check_length's Reference rows: 0 held, 1 fresh"
        }
        then "calls to two impls' same-named methods land on each impl, held as fresh" {
            let root = cache_probe(
                "twin_methods",
                "use lib.{A, B}\nA { n: 1 }.s() + B { n: 2 }.s() + B { n: 3 }.s()\n",
            )
            let _ = make_dirs("${root}/src/lib")
            let _ = write_text(
                "${root}/src/lib/a.av",
                "export type A = { n: int }\nexport type B = { n: int }\nimpl A {\n    fn s() -> int { self.n }\n}\nimpl B {\n    fn s() -> int { self.n }\n}\n",
            )
            let _ = holds_after_check(root)
            match root_workspace(root).verify_held(null) {
                .Ok(v) -> v.declarations > 0 && v.mismatches.is_empty(),
                .Err(_) -> false,
            }
        }
        then "a module read by a held file agrees with a fresh reading, Reference rows included" {
            let root = lib_probe("agrees")
            let _ = holds_after_check(root)
            match root_workspace(root).verify_held(null) {
                .Ok(v) -> v.declarations > 0 && v.mismatches.is_empty(),
                .Err(_) -> false,
            }
        }
    }
    given "a query's family, read from another package" {
        then "a collected enum's variant answers its declared word across the package seam" {
            let all = Family.all()
            all[22].name == "Raised" &&
                Family.Sig.name == "Sig" &&
                all.find(it.name == "DeclReads")?.ordinal ?? -1 == 31
        }
    }
}
