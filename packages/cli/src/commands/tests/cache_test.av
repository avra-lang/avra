//! `avra cache` — the pack's modes by their words, one spelling each, and
//! `held` answering a check's hold file by file.
use @std.io.{make_dirs, write_text}
use @std.time.{ms, now_ns}
use @std.process.{tool, cmd, Outcome, ProcessError}
use @std.avrac.compiler.{Want, FileHold, HeldMismatch}
use commands.{cache_mode, CacheMode, checked_at, root_workspace, disagreement_line}

/// A package root of one file under `src/`, holding `text` — its own path
/// each run, so nothing an earlier run kept answers for it.
fn cache_probe(name: string, text: string) -> string {
    let root = "/tmp/avra-cache-test/${name}-${now_ns()}"
    let _ = make_dirs("${root}/src")
    let _ = write_text("${root}/avra.toml", "[package]\nname = \"${name}\"\nversion = \"0.0.1\"\n")
    let _ = write_text("${root}/src/main.av", text)
    root
}

/// The package's holds as a check asks them, after a check has run.
fn holds_after_check(root: string) -> List<FileHold> {
    let _ = checked_at(root)
    root_workspace(root).hold_report(Want.Diagnostics) catch []
}

/// A package whose `main` reads one fn from a module `lib` of one file.
fn lib_probe(name: string) -> string {
    let root = cache_probe(name, "use lib.{one}\none()\n")
    let _ = make_dirs("${root}/src/lib")
    let _ = write_text("${root}/src/lib/a.av", "export fn one() -> int { 1 }\n")
    root
}

/// `avra cache <words>` run as a shell runs it. `avra_bin` is hang_test.av's,
/// `exit_code_1` build_report_test.av's: this module shares one namespace.
fn cache_ran(words: List<string>) -> Result<Outcome, ProcessError> {
    let t = tool(avra_bin())?
    (cmd(t, ["cache"].concat(words)) with { timeout: ms(20000) }).outcome()
}

/// Exit 1, nothing on stdout, and the rebuild named on stderr.
fn refuses_unwalked(words: List<string>) -> bool {
    match cache_ran(words) {
        .Ok(o) -> exit_code_1(o.exit) &&
            o.out.stdout.is_empty() &&
            o.out.stderr.contains("is being rebuilt as a lazy walk — not answered yet"),
        .Err(_) -> false,
    }
}

fn main_hold(rows: List<FileHold>) -> FileHold? { rows.find(it.path.ends_with("/src/main.av")) }

spec "commands/cache" {
    given "a mode's word" {
        then "no word is the summary" {
            cache_mode("") == CacheMode.Summary
        }
        then "each question answers to its own word" {
            ["why", "dependents", "changed", "held"].all(cache_mode(it) != null)
        }
        then "the retired spellings name no mode" {
            cache_mode("db") == null && cache_mode("explain") == null
        }
    }
    given "a mode the lazy walk does not answer yet" {
        then "the summary refuses, exit 1, nothing on stdout" {
            refuses_unwalked([])
        }
        then "why, changed and dependents refuse, exit 1, nothing on stdout" {
            [["why", "main"], ["changed", "main"], ["dependents", "main"]].all(refuses_unwalked(it))
        }
    }
    given "a package a check has just read" {
        then "every file is held" {
            let rows = holds_after_check(cache_probe("all_held", "let a = 1\na\n"))
            !rows.is_empty() && rows.all(it.held)
        }
        then "an edited file is read, because its text moved" {
            let root = cache_probe("edited", "let a = 1\na\n")
            let _ = holds_after_check(root)
            let _ = write_text("${root}/src/main.av", "let a = 2\na\n")
            let h = main_hold(root_workspace(root).hold_report(Want.Diagnostics) catch [])
            h != null && !h!.held && h!.why != null && h!.why!.says() == "its text moved"
        }
        then "a file added to a module it reads, naming nothing it reaches, holds it" {
            let root = lib_probe("grown_lib")
            let _ = holds_after_check(root)
            let _ = write_text("${root}/src/lib/b.av", "export fn two() -> int { 2 }\n")
            let h = main_hold(root_workspace(root).hold_report(Want.Diagnostics) catch [])
            h != null && h!.held && h!.moved.is_empty()
        }
        then "a signature that comes to name another file of the module names its interface, one file then and two now" {
            let root = lib_probe("reached_lib")
            let _ = write_text("${root}/src/lib/b.av", "export type Two = { n: int }\n")
            let _ = holds_after_check(root)
            let _ = write_text(
                "${root}/src/lib/a.av",
                "export fn one(t: Two? = null) -> int { 1 }\n",
            )
            let moved = main_hold(root_workspace(root).hold_report(Want.Diagnostics) catch [])?.moved ?? []
            moved.length == 1 &&
                moved[0].part.ends_with("lib's interface") &&
                moved[0].was.ends_with(", 1 file") &&
                moved[0].now.ends_with(", 2 files")
        }
        then "every file of the module that reads it names the move, not only the first kept" {
            let root = lib_probe("grown_lib_twice")
            let _ = write_text(
                "${root}/src/other.av",
                "use lib.{one}\nexport fn other() -> int { one() }\n",
            )
            let _ = holds_after_check(root)
            let _ = write_text("${root}/src/lib/a.av", "export fn one(n: int = 0) -> int { 1 }\n")
            let rows = root_workspace(root).hold_report(Want.Diagnostics) catch []
            let readers = rows.filter(!it.path.contains("/src/lib/"))
            readers.length == 2 && readers.all(it.moved.any(it.part.ends_with("lib's interface")))
        }
        then "a seat's consumed mark moving names the one contract line it changed, then and now" {
            let root = cache_probe("consumed", "use lib.{kept}\nkept([1]).length\n")
            let _ = make_dirs("${root}/src/lib")
            let _ = write_text(
                "${root}/src/lib/a.av",
                "export fn kept(xs: List<int>) -> List<List<int>> { [xs] }\n",
            )
            let _ = holds_after_check(root)
            let _ = write_text(
                "${root}/src/lib/a.av",
                "export fn kept(xs: List<int>) -> List<List<int>> { [[xs.length]] }\n",
            )
            let moved = main_hold(root_workspace(root).hold_report(Want.Diagnostics) catch [])?.moved ?? []
            let lines = moved.find(it.part.ends_with("lib's interface"))?.lines ?? []
            lines.length == 2 &&
                lines[0].starts_with("- ") &&
                lines[1].starts_with("+ ") &&
                lines.all(it.contains("kept"))
        }
        then "an untouched module names nothing moved" {
            let root = lib_probe("still_lib")
            let _ = holds_after_check(root)
            let h = main_hold(root_workspace(root).hold_report(Want.Diagnostics) catch [])
            h != null && h!.held && h!.moved.is_empty()
        }
    }
    given "a held file a fresh reading disagrees with" {
        then "a Reference-row count reads as the rows naming the declaration, held then fresh" {
            disagreement_line(
                HeldMismatch {
                    file: "a.av",
                    decl: "check_length",
                    field: "Reference rows",
                    held: "0",
                    fresh: "1",
                },
            ) == "held:   check_length's Reference rows: 0 held, 1 fresh"
        }
        then "calls to two impls' same-named methods land on each impl, held as fresh" {
            let root = cache_probe(
                "twin_methods",
                "use lib.{A, B}\nA { n: 1 }.s() + B { n: 2 }.s() + B { n: 3 }.s()\n",
            )
            let _ = make_dirs("${root}/src/lib")
            let _ = write_text(
                "${root}/src/lib/a.av",
                "export type A = { n: int }\nexport type B = { n: int }\nimpl A {\n    fn s() -> int { self.n }\n}\nimpl B {\n    fn s() -> int { self.n }\n}\n",
            )
            let _ = holds_after_check(root)
            match root_workspace(root).verify_held(null) {
                .Ok(v) -> v.declarations > 0 && v.mismatches.is_empty(),
                .Err(_) -> false,
            }
        }
        then "a module read by a held file agrees with a fresh reading, Reference rows included" {
            let root = lib_probe("agrees")
            let _ = holds_after_check(root)
            match root_workspace(root).verify_held(null) {
                .Ok(v) -> v.declarations > 0 && v.mismatches.is_empty(),
                .Err(_) -> false,
            }
        }
    }
}
