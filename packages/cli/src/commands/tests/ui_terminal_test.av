//! A terminal app's own read loop, natively: a program that mounts a view
//! is BUILT, and octets are piped into its standard input as a terminal
//! would send them. The last line it prints is the state the keys left.
//! `avra_ran`, `scratch_dir` and `hang_bound` are the neighbouring tests'
//! own.
use @std.io.{make_dirs, write_text}
use @std.meta.{embed}
use @std.process.{tool, cmd, ProcessError}
use @std.time.{stamp}

extern fn avra_trap(message: string)

/// A field and a counting button, mounted in the terminal.
const terminal_app: string = embed("ui_view/terminal_app.txt")

/// A button that asks the loop for a timer, mounted in the terminal.
const clock_app: string = embed("ui_view/terminal_clock.txt")

/// A button that asks for three timers due at one instant.
const burst_app: string = embed("ui_view/terminal_burst.txt")

/// A package minted fresh around `source` and built: where its binary stands
/// — "" when it did not build.
fn built(name: string, source: string) -> string {
    let root = "${scratch_dir()}/${name}_${stamp()}"
    let _ = make_dirs("${root}/src")
    let _ = write_text(
        "${root}/avra.toml",
        "[package]\nname = \"${name}\"\nversion = \"0.1.0\"\n\n[bin]\nname = \"${name}\"\npath = \"src/main.av\"\n",
    )
    let _ = write_text("${root}/src/main.av", source)
    match avra_ran(["build", root]) {
        .Ok(o) -> if exit_is_zero(o.exit) {
            o.out.stdout.trim().split("\n").last() ?? ""
        } else {
            unbuilt(name, o.out.stderr + o.out.stdout)
        },
        .Err(_) -> unbuilt(name, "the build did not run"),
    }
}

/// The fixture does not build: the test ends with the build's own words, never
/// a binary that is no binary.
fn unbuilt(name: string, said: string) -> string {
    avra_trap("the ${name} fixture did not build: ${said}")
    ""
}

/// The app, built once.
once fn terminal_binary() -> string { built("ui_terminal", terminal_app) }

/// The timer app, built once.
once fn clock_binary() -> string { built("ui_clock", clock_app) }

/// The burst app, built once.
once fn burst_binary() -> string { built("ui_burst", burst_app) }

/// What `binary` prints when its input gives one return and stays open for
/// `held` seconds.
fn held_open(binary: string, held: string) -> Result<string, ProcessError> {
    let fed = cmd(tool("sh")?, ["-c", "printf '\\n'; sleep ${held}"])
    let app = cmd(tool(binary)?, []) with { timeout: hang_bound() }
    let ran = fed.pipe(app).outcome()?
    ran.stages.last()?.out?.stdout ?? "the app did not run"
}

/// The timer app's last line after `held` seconds of open input.
fn clocked(held: string) -> string {
    match held_open(clock_binary(), held) {
        .Ok(out) -> out.trim().split("\n").last() ?? "nothing printed",
        .Err(_) -> "the pipe failed",
    }
}

/// The screens the burst app printed, as the counts they showed.
fn bursts() -> string {
    match held_open(burst_binary(), "0.6") {
        .Ok(out) -> [l.trim() for l in out.split("\n") if l.trim().starts_with("bumped ")].join("|"),
        .Err(_) -> "the pipe failed",
    }
}

/// Everything the app prints when `octets` — `printf`'s own spelling of
/// them — arrive on its standard input and the input then ends.
fn printed(octets: string) -> Result<string, ProcessError> {
    let fed = cmd(tool("printf")?, [octets])
    let app = cmd(tool(terminal_binary())?, []) with { timeout: hang_bound() }
    let ran = fed.pipe(app).outcome()?
    ran.stages.last()?.out?.stdout ?? "the app did not run"
}

/// The state the keys left: the app's last line.
fn left(octets: string) -> string {
    match printed(octets) {
        .Ok(out) -> out.trim().split("\n").last() ?? "nothing printed",
        .Err(_) -> "the pipe failed",
    }
}

/// How many screens the app drew: each opens with its field's line.
fn screens(octets: string) -> int {
    match printed(octets) {
        .Ok(out) -> [l for l in out.split("\n") if l.contains("Name: ")].length,
        .Err(_) -> -1,
    }
}

spec "a terminal app reads its own standard input" {
    given "a typed word, a tab and a return" {
        then "the word fills the field and the return presses the button" { left("abc\\t\\n") == "name=[abc] hits=1" }
    }
    given "an octet that is no character among the keys" {
        then "it is dropped alone, and every key after it is still heard" { left("a\\377b\\t\\n") == "name=[ab] hits=1" }
    }
    given "an arrow sent as a single-shift sequence" {
        then "it moves the focus and types nothing" { left("a\\033OBx\\n") == "name=[a] hits=1" }
    }
    given "a control sequence the loop has no key for" {
        then "it is dropped whole" { left("a\\033[1;5Cb") == "name=[ab] hits=0" }
    }
    given "input that ends inside a line" {
        then "what was typed is kept, and the app ends" { left("abc") == "name=[abc] hits=0" }
    }
    given "Ctrl-D among the keys" {
        then "the keys after it are not read" { left("a\\004b\\t\\n") == "name=[a] hits=0" }
    }
    given "no input at all" {
        then "the app draws one screen and ends" { screens("") == 1 && left("") == "name=[] hits=0" }
    }
    given "a timer asked for by a press, and the input held open past it" {
        then "its act runs as a turn and the screen shows it" { clocked("0.6") == "said=answered" }
    }
    given "a timer asked for, and the input ending before it is due" {
        then "the loop ends and the timer with it" { clocked("0") == "said=waiting" }
    }
    given "three timers due at one instant" {
        then "the screen is printed once for the three, not three times" {
            bursts() == "bumped 0|bumped 0|bumped 3"
        }
    }
}
