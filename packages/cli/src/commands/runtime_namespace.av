//! `avra runtime-namespace` — the runtime registry's claim on Avra
//! itself, as the generated `LowerCx` methods `features/rt.av` holds
//! (one per row — no separate `rt` namespace value). A SEPARATE VERB
//! from `emit`, matching `runtime-header`'s own reason: one word
//! meaning both a path and a subject is a value the callee
//! reinterprets.
use @std.cli.{CliResult, Runnable, command}
use @std.avrac.core.{runtime_namespace as registry_namespace}

type RuntimeNamespaceCmd = {}

impl Runnable for RuntimeNamespaceCmd {
    fn run(args: CliResult) -> int {
        println(registry_namespace())
        0
    }
}

export command runtime_namespace {
    name: "runtime-namespace"
    description: "Print the runtime registry's typed Avra namespace"
    run: RuntimeNamespaceCmd {}
}
