//! `avra settled <file> <name>` — a const of the program, as the compiler
//! settled it, printed as JSON: any tool can read what the compiler holds.
use @std.cli.{CliResult, Runnable, command, arg}
use @std.avrac.compiler.{Program}

type SettledCmd = {}

impl Runnable for SettledCmd {
    fn run(args: CliResult) -> int {
        let name = args.arg("name")
        phased(args, "settle", (p) -> printed(p.const_json(name)))
    }
}

fn printed(said: Result<string, string>) -> Result<int, string> {
    println(said?)
    0
}

export command settled {
    description: "A const of the program as the compiler settled it, printed as JSON"
    flags: [time]
    arg file {
        description: "the program's file"
        required: true
    }
    arg name {
        description: "the const to print"
        required: true
    }
    run: SettledCmd {}
}
