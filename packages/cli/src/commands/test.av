//! `avra test` — EVERY PROOF A PACKAGE CARRIES: its spec cases and its
//! program tests, one binary a suite, linked through the store a build
//! links through — so a file nothing moved is not read, compiled or
//! evaluated again. The binaries run in a fresh image of this program.
use @std.cli.{Subcommand, CliResult, Runnable}
use @std.avrac.compiler.{Workspace, BuildOutcome, Toolchain}
use @std.avrac.core.{joined}
use @std.io.{exists, is_dir}

type TestCmd = { }

impl Runnable for TestCmd {
    fn run(args: CliResult) -> int {
        let path = path_arg(args)
        if !exists(path) {
            no_such_file(path)
            return 2
        }
        let tool = match linker() { .Ok(t) -> t, .Err(e) -> { return refused_by_host(e) } }
        mut ws = build_workspace(path)
        match ws.suites(if is_dir(path) { null } else { path }, here(), Toolchain { opt: "-O1", runtime: runtime_object(), linker: tool.path }) {
            .Ok(made) -> proved(args, path, made),
            .Err(report) -> {
                println(report)
                1
            },
        }
    }
}

/// The suites said, then run by a fresh image — or the voice for none.
fn proved(args: CliResult, path: string, made: List<BuildOutcome>) -> int {
    for b in made {
        if !b.warnings.is_empty() { eprintln(b.warnings) }
        if timed(args) { eprintln(if b.reused { "time: suite · cache hit" } else { "time: ${b.phases}" }) }
    }
    if made.is_empty() { return nothing_to_prove(path) }
    handed_off([b.binary for b in made])
}

export fn test_command() -> Subcommand {
    Subcommand { meta: file_command("test", "Run a package's spec cases and its program tests"), body: TestCmd { } }
}

// ── The voices ──

/// ZERO CASES FOR A NAMED FILE IS A REFUSAL, not a green run: the whole job
/// of `test` is the verdict, and a file that yields none has none to give.
fn nothing_to_prove(path: string) -> int {
    if is_dir(path) {
        println("no spec cases here")
        return 0
    }
    eprintln("avra: ${path} holds no spec cases — a file named to `test` carries `spec`/`given`/`then` blocks")
    1
}
