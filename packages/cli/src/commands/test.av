//! `avra test` — run every spec case of a package root or a file:
//! one analysis, one lowering, and a BINARY whose entry calls each
//! case by its symbol. Native, because a suite that interprets the
//! compiler takes an hour where the machine takes seconds.
use @std.cli.{Subcommand, CliResult, Runnable}
use @std.avrac.language.{Program, TestCase, Lowered, CaseCall, cases_entry, runner_rows, emit_ll, case_words}
use @std.avrac.core.{joined_path}

type TestCmd = { }

impl Runnable for TestCmd {
    fn run(args: CliResult) -> int {
        on_cases(args, (p: Program, cases: List<TestCase>) -> {
            let t0 = avra_now_ns()
            warn(p)
            let made = p.cases_checked()
            if timed(args) { eprintln(timings(p, "lower", avra_now_ns() - t0)) }
            match made {
                .Ok(lo) -> staged_suite(p, lo, cases),
                .Err(text) -> {
                    println(text)
                    1
                }
            }
        })
    }
}

/// The cases as a binary, run by a fresh image of this program.
fn staged_suite(p: Program, lo: Lowered, cases: List<TestCase>) -> int {
    if cases.is_empty() {
        println("no spec cases here")
        return 0
    }
    let calls = [CaseCall { symbol: c.symbol, label: case_words(c) } for c in cases]
    let staged = lo with { entry: cases_entry(lo.types, calls), externs: lo.externs.concat(runner_rows()) }
    let path = staged_path(p)
    let failure: string? = emit_ll(staged, path)
    if failure != null {
        println(failure!)
        return 1
    }
    staged(path, p)
}

/// Where the test binary is written — under the root's `build/`,
/// never beside the source it tests.
fn staged_path(p: Program) -> string {
    let dir = joined_path(p.ws.root, "build")
    let _ = avra_mkdir_p(dir)
    joined_path(dir, "cases.av.ll")
}

export fn test_command() -> Subcommand {
    let body: TestCmd = TestCmd { }
    Subcommand { meta: file_command("test", "Run a package's or a file's spec cases"), body: body }
}
