//! `avra staged <plan>...` — the LIGHT phase of a suite run, in a
//! fresh image: link each module the heavy phase emitted, run its
//! binary, judge its status. A plan is clang's words, one per line;
//! the binary is the word after `-o`. The first red plan stops the
//! run, so a failure names one thing. Hidden: `test` reaches it
//! through `avra_exec_self`, never a person.
use @std.cli.{Subcommand, CliResult, Runnable, CommandSpec, ArgDef}
use @std.avrac.language.{verdict_of, plan_binary}
use @std.process.{status_of}
use @std.io.{println, eprintln, read_text}

type StagedCmd = { }

impl Runnable for StagedCmd {
    fn run(args: CliResult) -> int {
        for plan in args.args_of("file") {
            let code = plan_ran(plan)
            if code != 0 { return code }
        }
        0
    }
}

/// One plan: linked, run, judged.
fn plan_ran(plan: string) -> int {
    let words = (read_text(plan) catch "").split("\n")
    let binary: string? = plan_binary(words)
    if binary == null {
        eprintln("avra: ${plan} is not a link plan — clang's words, the binary after `-o`")
        return 2
    }
    let linked: int = match clang_ran(words) {
        .Ok(x) -> judged_link(x, binary!),
        .Err(e) -> refused_by_host(e),
    }
    if linked != 0 { return 1 }
    match run_binary(binary!) {
        .Ok(x) -> judged(status_of(x)),
        .Err(e) -> refused_by_host(e),
    }
}

/// The verdict as an exit code, its two wrecks spoken.
fn judged(status: int) -> int {
    match verdict_of(status) {
        .Green -> 0,
        .Red -> 1,
        .CouldNotStart -> {
            println("the binary could not start — the link answered a path that does not run")
            1
        }
        .Died -> {
            println("STOPPED — the case or program named above trapped, and everything after it never ran")
            1
        }
    }
}

export fn staged_command() -> Subcommand {
    let body: StagedCmd = StagedCmd { }
    let meta = CommandSpec {
        name: "staged",
        description: "Link and run the modules the heavy phase emitted (internal)",
        hidden: true,
        flags: [],
        args: [ArgDef { name: "file", description: "the link plans", required: true, variadic: true }],
        options: [],
    }
    Subcommand { meta: meta, body: body }
}
