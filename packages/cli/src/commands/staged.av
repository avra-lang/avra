//! `avra staged <plan>` — the LIGHT phase of a test or corpus run, in a
//! fresh image: link the module the heavy phase emitted, run the
//! binary, judge its status. The plan is clang's words, one per
//! line; the binary is the word after `-o`. Hidden: `test` and
//! `corpus` reach it through `avra_exec_self`, never a person.
use @std.cli.{Subcommand, CliResult, Runnable, CommandSpec, ArgDef}
use @std.process.{Exit}
use @std.io.{println, eprintln, read_text}

type StagedCmd = { }

impl Runnable for StagedCmd {
    fn run(args: CliResult) -> int {
        let words = (read_text(path_arg(args)) catch "").split("\n")
        let binary: string? = plan_binary(words)
        if binary == null {
            eprintln("avra: ${path_arg(args)} is not a link plan — clang's words, the binary after `-o`")
            return 2
        }
        let linked: int = match clang_ran(words) {
            .Ok(x) -> judged_link(x, binary!),
            .Err(e) -> refused_by_host(e),
        }
        if linked != 0 { return 1 }
        match run_binary(binary!) {
            .Ok(x) -> judged(verdict(x)),
            .Err(e) -> refused_by_host(e),
        }
    }
}

/// The binary a plan links: the word after `-o`, null when the plan
/// has none.
export fn plan_binary(words: List<string>) -> string? {
    let at = words.index_of("-o")
    if at < 0 || at + 1 >= words.length { return null }
    words[at + 1]
}

/// What a binary's exit MEANS. It says its tally itself and answers
/// clean or 1; anything else is a death — a case or program trapped,
/// or a signal killed it, and everything after it never ran. A binary
/// the host would not start is the host's refusal, spoken where it
/// happens — never an exit.
export enum Verdict {
    Green
    Red
    Died
}

export fn verdict(x: Exit) -> Verdict {
    match x {
        .Clean -> Verdict.Green,
        .Code(n) -> if n == 1 { Verdict.Red } else { Verdict.Died },
        .Signal(_, _) -> Verdict.Died,
    }
}

/// The verdict as an exit code, the wreck spoken.
fn judged(v: Verdict) -> int {
    match v {
        .Green -> 0,
        .Red -> 1,
        .Died -> {
            println("STOPPED — the case or program named above trapped, and everything after it never ran")
            1
        }
    }
}

export fn staged_command() -> Subcommand {
    let body: StagedCmd = StagedCmd { }
    let meta = CommandSpec {
        name: "staged",
        description: "Link and run a module the heavy phase emitted (internal)",
        hidden: true,
        flags: [],
        args: [ArgDef { name: "file", description: "the link plan", required: true, variadic: false }],
        options: [],
    }
    Subcommand { meta: meta, body: body }
}
