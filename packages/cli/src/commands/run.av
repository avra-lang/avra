//! `avra run` — evaluate a program and print its value.
use @std.cli.{Subcommand, CliResult, Runnable}
use @std.avrac.language.{Program}
use @std.io.{println, eprintln}

type RunCmd = { }

impl Runnable for RunCmd {
    fn run(args: CliResult) -> int {
        on_program(args, (p: Program) -> {
            let t0 = avra_now_ns()
            warn(p)
            let ran = p.run()
            if timed(args) { eprintln(timings(p, "lower+run", avra_now_ns() - t0)) }
            match ran {
                .Ok(text) -> {
                    println(text)
                    0
                }
                .Err(report) -> {
                    println(report)
                    1
                }
            }
        })
    }
}

export fn run_command() -> Subcommand {
    let body: RunCmd = RunCmd { }
    Subcommand { meta: file_command("run", "Run a program and print its value"), body: body }
}
