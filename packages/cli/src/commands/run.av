//! `avra run` — evaluate a program and print its value.
use @std.cli.{CliResult, Runnable, command}
use @std.avrac.compiler.{Program}

type RunCmd = {}

impl Runnable for RunCmd {
    fn run(args: CliResult) -> int {
        // a wasm run builds the module and hands it to the host runner; the
        // evaluator answers every other target
        if args.option("target") != "" { return run_wasm_command(args) }
        phased(args, "lower+run", ran)
    }
}

/// A trap speaks as a native binary's does: `avra: <words>` on stderr,
/// exit 2 — so the two engines end the same program the same way.
fn ran(p: Program) -> Result<int, string> {
    warn(p)
    match p.run_live()? {
        .Clean -> 0,
        .Trapped(words) -> {
            eprintln("avra: ${words}")
            2
        },
    }
}

export command run {
    description: "Run a program and print its value"
    flags: [time, wasm_reactor, wasm_debug]
    options: [target]
    args: [file]
    run: RunCmd {}
}
