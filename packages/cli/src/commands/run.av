//! `avra run` — evaluate a program and print its value.
use @std.cli.{CliResult, Runnable, command, flag}

use @std.avrac.compiler.host.{no_entry}
use @std.avrac.diagnostics.{render_among}
use @std.avrac.compiler.backend.{Ended}
use @std.avrac.compiler.{TargetRow, named_target, target_triple}
use @std.path.{dir_of, joined_path}

type RunCmd = {}

impl Runnable for RunCmd {
    fn run(args: CliResult) -> int {
        // a target runs where its host does — an app with no `--target` runs its first; a raw wasm
        // triple builds the module and hands it to the host runner; the program layer or the
        // evaluator answers every other run
        let spelled = args.option("target")
        let first = if spelled == "" { app_targets(path_arg(args)).first() } else { null }
        let row = first ?? named_target(spelled)
        if row != null { return target_ran(args, row!, first != null) }
        if spelled != "" { return run_wasm_command(args) }
        if args.has_flag("eval") { program_evaluated(args) } else { program_ran(args) }
    }
}

/// `avra run` of the target `row`, saying so first where it is the app's first, `named`: WHAT RUN
/// MEANS IS THE HOST'S. A process's binary runs attached to this terminal; a page is built and
/// served at a printed local address, its server beside it, nothing watched; an iOS app boots one
/// simulator, is installed and launched there, its output attached.
fn target_ran(args: CliResult, row: TargetRow, named: bool) -> int {
    let path = path_arg(args)
    if named { eprintln(first_target_said(row)) }
    match row.host {
        .Process -> {
            let m = manifest_at(package_root(path) ?? path)
            let binary = match built_as(args, path, target_triple(row, m), row.name) {
                .Ok(b) -> b,
                .Err(code) -> { return code },
            }
            match run_binary(binary) {
                .Ok(exit) -> status_of_exit(exit),
                .Err(e) -> refused_by_host(e),
            }
        },
        .Page -> page_served(args, path, row.triple, false),
        .Ios -> unequipped(app_unbundled(row)),
    }
}

/// `avra run` on the program layer: the program built there, then run at the terminal, its exit the
/// run's — a trap's 2, a cancelled run's 1, as an evaluated run ends.
fn program_ran(args: CliResult) -> int {
    let path = path_arg(args)
    if is_a_dir(path) && entry_written(path) == null {
        println(render_among(no_entry(path), []))
        return 1
    }
    let binary = match built_binary(args) { .Ok(b) -> b, .Err(code) -> { return code } }
    match run_binary(binary) { .Ok(exit) -> status_of_exit(exit), .Err(e) -> refused_by_host(e) }
}

/// `avra run --eval` on the program layer: the program made there and run in this compiler's own
/// evaluator, the engine a native run is held to, ending as a native run ends.
fn program_evaluated(args: CliResult) -> int {
    let path = rooted(path_arg(args))
    if !is_a_dir(path) {
        let home? = file_home(path) else { return lone_refuse_evaluated(path, live: true) }
        return program_refuse_evaluated(home, path, live: true)
    }
    let root = package_root(path) ?? path
    let entry? = entry_written(root) else {
        println(render_among(no_entry(root), []))
        return 1
    }
    program_refuse_evaluated(root, joined_path(root, entry), live: true)
}

/// AN EVALUATED RUN ENDS AS A NATIVE BINARY DOES, so the two engines
/// end one program one way: `avra: <words>` on stderr and a trap's 2 —
/// or, the program's own run cancelled, a verdict's 1.
export fn ended_as(e: Ended) -> int {
    match e { .Clean -> 0, .Trapped(words) -> said(words, 2), .Cancelled(words) -> said(words, 1) }
}

fn first_target_said(row: TargetRow) -> string { "avra: running `${row.name}`, the first of `[app] targets`" }

fn app_unbundled(row: TargetRow) -> string {
    "`${row.name}` runs as an app installed from its bundle, and a build writes no bundle for it — `avra build --target ${row.name}` builds its binary"
}

fn said(words: string, code: int) -> int {
    eprintln("avra: ${words}")
    code
}

export command run {
    description: "Run a program and print its value"
    flags: [time, wasm_reactor, wasm_debug, eval]
    options: [target, port, host]
    args: [file]
    run: RunCmd {}
}

/// `run`'s own: the program evaluated, never built.
export flag eval { description: "run the program in the compiler's own evaluator instead of building it — the engine a native run is held to" }
