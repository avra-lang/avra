//! `avra run` — evaluate a program and print its value.
use @std.cli.{Subcommand, CliResult, Runnable}
use @std.avrac.language.{Program}
use @std.io.{println}

type RunCmd = { }

impl Runnable for RunCmd {
    fn run(args: CliResult) -> int { phased(args, "lower+run", ran) }
}

fn ran(p: Program) -> Result<int, string> {
    warn(p)
    println(p.run()?)
    0
}

export fn run_command() -> Subcommand {
    Subcommand { meta: file_command("run", "Run a program and print its value"), body: RunCmd { } }
}
