//! `avra runtime-header` — the runtime registry's claim on the C,
//! as the header runtime/avra_runtime.c includes last. A SEPARATE
//! VERB from `emit`, which takes a FILE: one word meaning both a
//! path and a subject is a value the callee reinterprets, and a
//! real file of that name would change what the command did.
use @std.cli.{Subcommand, CliResult, Runnable}
use @std.avrac.core.{runtime_header}

type RuntimeHeaderCmd = { }

impl Runnable for RuntimeHeaderCmd {
    fn run(args: CliResult) -> int {
        println(runtime_header())
        0
    }
}

export fn runtime_header_command() -> Subcommand {
    Subcommand { meta: bare_command("runtime-header", "Print the runtime registry's C header"), body: RuntimeHeaderCmd { } }
}
