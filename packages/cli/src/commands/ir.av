//! `avra ir` — print a program's IR, regions as brackets.
use @std.cli.{Subcommand, CliResult, Runnable}
use @std.avrac.language.{render_ir, Program}
use @std.io.{println}

type IrCmd = { }

impl Runnable for IrCmd {
    fn run(args: CliResult) -> int { phased(args, "lower+render", rendered) }
}

fn rendered(p: Program) -> Result<int, string> {
    if !p.clean() { fail p.report() }
    println(render_ir(p.lowered()))
    0
}

export fn ir_command() -> Subcommand {
    Subcommand { meta: file_command("ir", "Print a program's IR, regions as brackets"), body: IrCmd { } }
}
