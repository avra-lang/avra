//! `avra ir` — print a program's IR, regions as brackets: the program lowered whole on the program
//! layer, the memory pass applied.
use @std.cli.{CliResult, Runnable, command}
use @std.avrac.compiler.backend.{render_laid}
use @std.avrac.compiler.lower.{Lowered}

type IrCmd = {}

impl Runnable for IrCmd {
    fn run(args: CliResult) -> int { on_lowered(args, rendered) }
}

fn rendered(l: Lowered) -> Result<int, string> {
    println(render_laid(l))
    0
}

export command ir {
    description: "Print a program's IR, regions as brackets"
    flags: [time]
    args: [file]
    run: IrCmd {}
}
