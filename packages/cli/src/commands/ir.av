//! `avra ir` — print a program's IR, regions as brackets.
use @std.cli.{Subcommand, CliResult, Runnable}
use @std.avrac.language.{render_ir, Program}

type IrCmd = { }

impl Runnable for IrCmd {
    fn run(args: CliResult) -> int {
        on_program(args, (p: Program) -> {
            let t0 = avra_now_ns()
            let clean = p.clean()
            let out = if clean { render_ir(p.lowered()) } else { p.report() }
            if timed(args) { eprintln(timings(p, "lower+render", avra_now_ns() - t0)) }
            println(out)
            if clean { 0 } else { 1 }
        })
    }
}

export fn ir_command() -> Subcommand {
    let body: IrCmd = IrCmd { }
    Subcommand { meta: file_command("ir", "Print a program's IR, regions as brackets"), body: body }
}
