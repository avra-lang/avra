//! `avra family-hashes` — each compiler family's code hash, the table a
//! saved answer is keyed by (DB 05b, design section 6.4). The rows are
//! baked at compiler build time; nothing is computed here.
use @std.cli.{CliResult, Runnable, command}
use @std.avrac.compiler.{family_code_hash}
use @std.avrac.compiler.families.{Family}

type FamilyHashesCmd = {}

impl Runnable for FamilyHashesCmd {
    fn run(_args: CliResult) -> int {
        for f in Family.all() { println("${f.name}\t${family_code_hash(f)}") }
        0
    }
}

export command family_hashes {
    name: "family-hashes"
    description: "Print each compiler family's own code hash, name -> hash"
    run: FamilyHashesCmd {}
}
