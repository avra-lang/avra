//! `avra tasks <pid>` — a running Avra process's tasks, listed by the
//! process itself (runtime/avra_fiber.c, "The listing"). An ask file in
//! the user's own directory, then SIGURG, again every tenth of a second
//! until it answers: a signal can land between the switch's load and
//! store of its countdown and be lost, and an ask repeated is never
//! misread. A process whose running task does not switch answers that it
//! has not. The answer is printed and both files are removed.
use @std.cli.{CliResult, Runnable, command, arg}
use @std.io.{exists, read_text, remove, write_text}
use @std.process.{cmd, tool}
use @std.text.{parse_int}
use @std.time.{ms, sleep}

type TasksCmd = {}

impl Runnable for TasksCmd {
    fn run(args: CliResult) -> int {
        let pid? = parse_int(args.arg("pid")) else {
            eprintln(no_pid(args.arg("pid")))
            return 2
        }
        if pid < 1 {
            eprintln(no_pid(args.arg("pid")))
            return 2
        }
        let dir = match door_dir() {
            .Ok(d) -> d,
            .Err(words) -> {
                eprintln(words)
                return 1
            },
        }
        listed(pid, dir)
    }
}

/// THE DOOR'S DIRECTORY, as the runtime finds it: macOS's per-user
/// temporary directory, else `/tmp/avra-<uid>/` — made 0700 here, and
/// refused when it is anyone else's or anyone else may write it.
fn door_dir() -> Result<string, string> {
    let darwin = said_by("getconf", ["DARWIN_USER_TEMP_DIR"]) ?? ""
    if darwin != "" { return if darwin.ends_with("/") { darwin } else { darwin + "/" } }
    let uid? = said_by("id", ["-u"]) else { fail no_uid() }
    let dir = "/tmp/avra-${uid}/"
    let _ = said_by("mkdir", ["-m", "700", "-p", dir])
    let listing? = said_by("ls", ["-ldn", dir]) else { fail not_ours(dir) }
    let fields = [f for f in listing.split(" ") if f != ""]
    if fields.length < 3 || !fields[0].starts_with("drwx------") || fields[2] != uid { fail not_ours(dir) }
    dir
}

/// What `name` prints, trimmed, when it ran and finished clean.
fn said_by(name: string, args: List<string>) -> string? {
    // LICENSED input.live_process: the asker's own machine, and no compile answer reads it
    let t = match tool(name) { .Ok(found) -> found, .Err(_) -> { return null } }
    // LICENSED input.live_process: the asker's own machine, and no compile answer reads it
    match cmd(t, args).outcome() {
        .Ok(o) -> if o.exit is .Clean { o.out.stdout.trim() } else { null },
        .Err(_) -> null,
    }
}

/// The answer a process gives, printed — 0 — or what kept it, said —
/// 1. A signal the process does not hear harms nothing: its default is to
/// be ignored.
fn listed(pid: int, dir: string) -> int {
    let ask = "${dir}avra-tasks.${pid}.ask"
    let out = "${dir}avra-tasks.${pid}"
    let _ = remove(out)
    if write_text(ask, "") is .Err {
        eprintln(unaskable(ask))
        return 1
    }
    let answer = asked(pid, out, 20)
    let _ = remove(ask)
    let said? = answer else {
        eprintln(if signalled(pid) { unanswered(pid) } else { no_process(pid) })
        return 1
    }
    let _ = remove(out)
    println(said.trim())
    0
}

/// SIGURG sent, then a tenth of a second, `turns` times at most: the
/// answer, or null when none came or the process is gone.
fn asked(pid: int, out: string, turns: int) -> string? {
    for _turn in 0..turns {
        if !signalled(pid) { return null }
        sleep(ms(100))
        // LICENSED input.live_process: a running process's answer, and no compile answer reads it
        if exists(out) { return match read_text(out) { .Ok(text) -> text, .Err(_) -> null } }
    }
    null
}

/// SIGURG sent to `pid`: whether there is such a process to send it to.
fn signalled(pid: int) -> bool { said_by("kill", ["-URG", "${pid}"]) != null }

export command tasks {
    description: "A running Avra process's tasks — where each was spawned, what it waits on, how long it has run at most — as the process itself lists them"
    arg pid { description: "the process to ask" }
    run: TasksCmd {}
}

// ── voices ──

fn no_pid(word: string) -> string {
    "avra tasks: `${word}` is no process id — `avra tasks <pid>`"
}

fn unaskable(path: string) -> string {
    "avra tasks: the ask could not be written at ${path}"
}

fn no_process(pid: int) -> string {
    "avra tasks: no process ${pid} that this user may signal"
}

fn unanswered(pid: int) -> string {
    "avra tasks: process ${pid} did not answer in 2 s — it has spawned no task, is not an Avra program, or set its SIGURG to be ignored"
}

fn no_uid() -> string { "avra tasks: `id -u` did not say who asks, so the door's directory has no name" }

fn not_ours(dir: string) -> string {
    "avra tasks: ${dir} is not this user's alone (owner and mode 0700 are checked), so no ask is written there"
}
