//! `avra tasks <pid>` — a running Avra process's tasks, listed by the
//! process itself (runtime/avra_fiber.c, "The listing"). An ask file in
//! the user's own directory, then SIGURG, again every tenth of a second
//! until it answers: a signal can land between the switch's load and
//! store of its countdown and be lost, and an ask repeated is never
//! misread. A process whose running task does not switch answers that it
//! has not. The answer is printed and both files are removed.
//!
//! THE DIRECTORY IS HELD, NEVER NAMED: it is opened once with no link
//! followed and held to its owner and mode, and the ask and the answer
//! are named from it (@std/io's `OwnDir`, runtime/avra_door.h) — the
//! same directory the program's door opens. `AVRA_TASKS_DIR` names
//! another, for both.
use @std.cli.{CliResult, Runnable, command, arg}
use @std.io.{IoError, OwnDir, own_dir, user_dir, env}
use @std.process.{Signal, Signalled, signalled}
use @std.text.{parse_int}
use @std.time.{ms, sleep}

type TasksCmd = {}

impl Runnable for TasksCmd {
    fn run(args: CliResult) -> int {
        let pid? = parse_int(args.arg("pid")) else {
            eprintln(no_pid(args.arg("pid")))
            return 2
        }
        if pid < 1 {
            eprintln(no_pid(args.arg("pid")))
            return 2
        }
        // LICENSED input.live_process: where a running process is asked, and no compile answer reads it
        let named = env("AVRA_TASKS_DIR") ?? ""
        if named != "" && !named.starts_with("/") {
            eprintln(dir_relative(named))
            return 2
        }
        let dir = match door(named) {
            .Ok(d) -> d,
            .Err(e) -> {
                eprintln(not_ours(e.describe().message))
                return 1
            },
        }
        defer dir.close()
        listed(pid, dir)
    }
}

/// The door's directory: `named` (`AVRA_TASKS_DIR`) when it is set, else
/// the user's own.
fn door(named: string) -> Result<OwnDir, IoError> {
    if named != "" {
        // LICENSED input.live_process: where a running process is asked, and no compile answer reads it
        return own_dir(named)
    }
    // LICENSED input.live_process: where a running process is asked, and no compile answer reads it
    user_dir()
}

/// The answer a process gives, printed — 0 — or what kept it, said —
/// 1. A signal the process does not hear harms nothing: its default is to
/// be ignored.
fn listed(pid: int, dir: OwnDir) -> int {
    let ask = "avra-tasks.${pid}.ask"
    let out = "avra-tasks.${pid}"
    dir.drop(out)
    if dir.put(ask, "") is .Err(e) {
        eprintln(unaskable(e.describe().message))
        return 1
    }
    let answer = asked(pid, dir, out, 20)
    dir.drop(ask)
    match answer {
        .Answered(text) -> {
            let r = read_trace(text)
            // a number reused within the wait names another process: its
            // answer is never shown as the one asked
            if whose(r) != pid {
                eprintln(another_answered(pid, whose(r)))
                return 1
            }
            println(listing_said(r))
            if r.strays.is_empty() { return 0 }
            eprintln(listing_strayed(r.strays.length, r.strays[0]))
            1
        },
        .Silent -> {
            eprintln(unanswered(pid))
            1
        },
        .Gone -> {
            eprintln(no_process(pid))
            1
        },
        .Unasked(why) -> {
            eprintln(unasked(why))
            2
        },
        .Unread(why) -> {
            eprintln(unreadable(why))
            1
        },
    }
}

/// A LIVE PROCESS'S LISTING IS A TRACE (runtime/avra_fiber.c), read by
/// `avra trace`'s own code: a line a task, in the trace's words, then who
/// waits on whom — or the one line a process that has not switched
/// answers with.
export fn listing_said(r: TraceRead) -> string {
    let lines = [listed_task(t) for t in timelines(r.events)]
    if r.events.any(said_unswitched(it.ev)) { return lines.join("\n") }
    lines.concat([graph(waits_at(r.events, null), null)]).join("\n")
}

/// The process an answer names — its listing's first line, or the
/// handler's — or null when it names none.
export fn whose(r: TraceRead) -> int? {
    let named? = r.events.find(names_process(it.ev)) else { return null }
    parse_int(field(named.rest, "pid") ?? "")
}

/// Whether an event names the process that answered.
fn names_process(ev: Happened) -> bool {
    match ev {
        .Listing or .Unswitched -> true,
        .Spawn or .SpawnAt or .Site or .Join or .Park or .Claim or .Retract or .DeadlineSet or .DeadlineFired or .Cancel or .End or .Age or .Other(_) -> false,
    }
}

/// Whether an event is the handler's own line.
fn said_unswitched(ev: Happened) -> bool {
    match ev {
        .Unswitched -> true,
        .Spawn or .SpawnAt or .Site or .Join or .Park or .Claim or .Retract or .DeadlineSet or .DeadlineFired or .Cancel or .End or .Age or .Listing or .Other(_) -> false,
    }
}

fn listed_task(t: TaskTimeline) -> string { "${task_named(t.task)}: ${[row.words for row in t.rows].join("; ")}" }

/// What an ask came to.
enum Answer {
    Answered(text: string)
    Silent
    Gone
    Unasked(why: string)
    Unread(why: string)
}

/// A signal that did not reach the process, as what the ask came to —
/// null when it was sent.
fn not_sent(s: Signalled) -> Answer? {
    match s { .Sent -> null, .NoProcess -> Answer.Gone, .Refused(why) -> Answer.Unasked(why) }
}

/// SIGURG sent, then a tenth of a second, `turns` times at most.
fn asked(pid: int, dir: OwnDir, out: string, turns: int) -> Answer {
    for _turn in 0..turns {
        // LICENSED input.live_process: asks a running process, and no compile answer reads it
        let stopped = not_sent(signalled(pid, Signal.Urgent))
        if stopped != null { return stopped! }
        sleep(ms(100))
        // LICENSED input.live_process: a running process's answer, and no compile answer reads it
        match dir.taken(out) {
            .Ok(text) -> {
                let said? = text else { continue }
                return Answer.Answered(said)
            },
            .Err(e) -> { return Answer.Unread(e.describe().message) },
        }
    }
    Answer.Silent
}

export command tasks {
    description: "A running Avra process's tasks — where each was spawned, what it waits on, how long it has run at most — as the process itself lists them"
    arg pid { description: "the process to ask" }
    run: TasksCmd {}
}

// ── voices ──

fn no_pid(word: string) -> string {
    "avra tasks: `${word}` is no process id — `avra tasks <pid>`"
}

fn unaskable(why: string) -> string { "avra tasks: the ask could not be written — ${why}" }

fn no_process(pid: int) -> string {
    "avra tasks: no process ${pid} that this user may signal"
}

fn unanswered(pid: int) -> string {
    "avra tasks: process ${pid} did not answer in 2 s — it has spawned no task, is not an Avra program, or set its SIGURG to be ignored"
}

fn not_ours(why: string) -> string {
    "avra tasks: the door's directory is not this user's alone (it must be a directory, no link, owned by this user, mode 0700) — ${why}"
}

fn dir_relative(named: string) -> string {
    "avra tasks: AVRA_TASKS_DIR=${named} is relative — it would name one directory here and another where the program runs, so it must begin with `/`"
}

fn another_answered(pid: int, named: int?) -> string {
    "avra tasks: the answer at process ${pid}'s name came from ${if named != null { "process ${named!}" } else { "no process it names" }} — the number was reused, or the file is not an answer"
}

fn listing_strayed(n: int, first: string) -> string {
    "avra tasks: ${n} line(s) of the listing were no event; the first: ${first}"
}

fn unasked(why: string) -> string { "avra tasks: ${why}" }

fn unreadable(why: string) -> string { "avra tasks: the answer could not be read — ${why}" }
