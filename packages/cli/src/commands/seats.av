//! `avra seats` — the qualifying share for a conditional ABI: how
//! many managed call seats have a callee that only reads them.
use @std.cli.{Subcommand, CliResult, Runnable}
use @std.avrac.compiler.{Program}
use @std.avrac.compiler.memory.{render_census, render_tally, retain_tally, seat_census}

type SeatsCmd = { }

impl Runnable for SeatsCmd {
    fn run(args: CliResult) -> int { phased(args, "lower+count", tallied) }
}

fn tallied(p: Program) -> Result<int, string> {
    if !p.clean() { fail p.report() }
    let l = p.lowered()
    println(render_census(seat_census(l)))
    println(render_tally(retain_tally(l)))
    0
}

export fn seats_command() -> Subcommand {
    Subcommand { meta: file_command("seats", "Count managed seats whose callee only reads them"), body: SeatsCmd { } }
}
