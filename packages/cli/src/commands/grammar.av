//! `avra grammar` — print the assembled language grammar, exactly
//! as feature merging built it.
use @std.cli.{Subcommand, CliResult, Runnable}
use @std.avrac.compiler.{avra}
use @std.grammar.{render_grammar}

type GrammarCmd = { }

impl Runnable for GrammarCmd {
    fn run(args: CliResult) -> int {
        let lang = avra()
        if lang.syntax == null {
            for d in lang.diagnostics { println("${d.kind}: ${d.message}") }
            return 1
        }
        println(render_grammar(lang.syntax!.g))
        0
    }
}

export fn grammar_command() -> Subcommand {
    Subcommand { meta: bare_command("grammar", "Print the assembled language grammar"), body: GrammarCmd { } }
}
