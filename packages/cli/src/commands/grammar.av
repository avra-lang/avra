//! `avra grammar` — print the assembled language grammar, exactly
//! as feature merging built it.
use @std.cli.{Subcommand, CliResult, Runnable}
use @std.avrac.language.{avra}
use @std.avrac.grammar.{render_grammar}

type GrammarCmd = { }

impl Runnable for GrammarCmd {
    fn run(self, args: CliResult) -> int {
        let lang = avra()
        if lang.grammar == null {
            for d in lang.diagnostics { println("${d.kind}: ${d.message}") }
            return 1
        }
        println(render_grammar(lang.grammar!))
        0
    }
}

export fn grammar_command() -> Subcommand {
    let body: GrammarCmd = GrammarCmd { }
    Subcommand { meta: bare_command("grammar", "Print the assembled language grammar"), body: body }
}
