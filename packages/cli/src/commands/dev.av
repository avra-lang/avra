//! `avra dev <path>` — one verb, and what it does follows what it is
//! pointed at. A DIRECTORY is served as it stands. A PACKAGE WHOSE
//! PROGRAM MOUNTS A PAGE is built as a wasm reactor, served with the page
//! glue, and built again when a file the build reads moves; the page hears
//! each move over an event stream (`runtime/dom/dev.js`): a new module
//! reloads it, and a build that failed is shown over it while the last
//! good module keeps running. Anything else is refused by what it is.
//!
//! A BUILD IS A CHILD: `avra build`, as anyone runs it, so what it says
//! is what a build says, and a compiler that traps takes no server with
//! it. THE WATCH IS THE BUILD'S OWN INPUTS (`Workspace.build_inputs`):
//! every file its key covers, asked again each turn, so a file that
//! arrives is seen. THE HOST SAYS WHEN TO LOOK: the loop is parked on a
//! watch over those files (`@std.io.watch`) and costs nothing between
//! saves; `--interval`, or a host that gives no watch, looks on a clock
//! instead. The loop turns on the program's first task and the server
//! answers on another.
use @std.cli.{CliResult, Runnable, command, option, flag, arg}
use @std.avrac.compiler.{Workspace, Toolchain, inputs_this_turn}
use @std.http.frame.{Method}
use @std.http.http.{Request, Unrouted, Response, Header, text}
use @std.http.route.{Route, fixed}
use @std.http.server.{server}
use @std.http.files.{Files, directory}
use @std.http.sse.{Event, Next, Source, Resume, event_stream, quiet_default}
use @std.net.{Bell, Listener}
use @std.io.{IoError, read_text, stamp}
use @std.io.watch.{Watch, watch}
use @std.path.{joined_path, file_name}
use @std.process.{Tool, cmd, inherited}
use @std.text.{parse_int}
use @std.time.{Duration, ms, sleep, now_ms}

type DevCmd = {}

/// What a path is, to a dev server.
enum Pointed {
    /// A directory that is no package: its files, as they stand.
    Files
    /// A package whose program mounts a view on a page.
    Page
    /// A package with no program: nothing in it runs.
    Library
    /// A package whose program mounts no page.
    Program
    /// No directory at all.
    File
}

/// The module a program mounts a page through.
const web_module: string = "@std.ui.web"

/// Whether a package's own sources reach for the page: one of them
/// imports the module a page is mounted through. Asked of the `use`
/// lines the workspace reads, never of a file's name.
fn mounts_a_page(ws: Workspace) -> bool {
    ws
        .all_files(ws.packages()[0].src)
        .any((path) -> ws.imported_by(path).any(it.text() == web_module))
}

/// What `path` is. A package is a directory with a manifest; what it holds
/// is the workspace's to say.
export fn pointed(path: string) -> Pointed {
    if !is_a_dir(path) { return .File }
    // LICENSED compiler.host_asked_directly: a command's read of the path it was given, at this instant — no query frame is open
    let there = match disk_host().there(joined_path(path, "avra.toml")) {
        .Exists(_, t) -> t,
        rest -> false,
    }
    if !there { return .Files }
    let ws = root_workspace(path)
    if ws.entry_of() == null { return .Library }
    if mounts_a_page(ws) { .Page } else { .Program }
}

impl Runnable for DevCmd {
    fn run(args: CliResult) -> int {
        let path = rooted(args.arg("path"))
        // LICENSED compiler.host_asked_directly: a command's read of the path it was given, at this instant — no query frame is open
        let there = match disk_host().there(path) { .Exists(_, t) -> t, rest -> false }
        if !there {
            no_such_file(path)
            return 2
        }
        match pointed(path) {
            .Files -> hosted(args, path, directory("/", fresh_files(path)), () -> false, untended),
            .Page -> match page_at(
                path,
                if args.option("target") == "" { "wasm" } else { args.option("target") },
            ) {
                .Ok(p) -> hosted(
                    args,
                    path,
                    p.routes(),
                    () -> p.turn(),
                    if args.has_flag("no_watch") { untended } else { () -> p.tended(looked_every(args)) },
                ),
                .Err(code) -> code,
            },
            .Library -> unequipped(serves_no_library(path)),
            .Program -> unequipped(serves_no_program(path)),
            .File -> unequipped(serves_no_file(path)),
        }
    }
}

/// `routes` served for `path` until the command is stopped: `turn` turned
/// once before it says where it serves — loopback and port 8787 unless
/// told — and `tend` run beside the server after.
fn hosted(
    args: CliResult,
    path: string,
    routes: List<Route>,
    turn: fn() -> bool,
    tend: fn() -> void,
) -> int {
    server site {
        host: args.option("host")
        port: parse_int(args.option("port")) ?? default_port
        routes: routes
    }
    let bound = match site.listening() {
        .Ok(s) -> s,
        .Err(e) -> { return unequipped(not_served(e.describe().message)) },
    }
    let _ = turn()
    let at = "http://${site.host}:${bound.listener.port}/"
    println("dev: ${path} at ${at} — ${reach_words(bound.listener)}")
    let serving = spawn bound.run(1)
    if args.has_flag("open") { opened(at) }
    tend()
    serving.await
    0
}

/// What is served as it stands has nothing to tend.
fn untended() {}

/// How often `--interval` asks for a look, or null when the host is to say.
fn looked_every(args: CliResult) -> Duration? {
    let every? = parse_int(args.option("interval")) else { return null }
    ms(every)
}

/// A directory as a dev server serves one: each file typed by its name,
/// and none kept by a browser without asking again.
fn fresh_files(root: string) -> Files { Files { root: root, max_age: 0 } }

/// The page opened where the developer browses: the first opener this
/// machine has. One that could not be opened is said, with where to go.
fn opened(url: string) {
    let opener? = found([tool("xdg-open"), tool("open")]).first() else {
        eprintln(not_opened(url))
        return
    }
    let ran = match cmd(opener, [url]).outcome() {
        .Ok(o) -> status_of_exit(o.exit) == 0,
        .Err(_) -> false,
    }
    if !ran { eprintln(not_opened(url)) }
}

export command dev {
    description: "Serve a directory as it stands, or a package's page — built, and built again as its sources change"
    flags: [open, no_watch]
    options: [port, host, target, interval]
    args: [path]
    run: DevCmd {}
}

/// What `dev` is pointed at.
export arg path {
    description: "a directory to serve as it stands, or a package whose program mounts a page"
    required: true
}

const default_port: int = 8787

/// How often a page's sources are looked at where the host gives no watch.
const unwatched_interval: int = 250

export option port {
    description: "the port to serve on — 0 takes any free one"
    default: "${default_port}"
}

export option host {
    description: "the address to serve at — this machine alone unless told"
    default: "127.0.0.1"
}

export option interval {
    description: "look at a page's sources this often, in milliseconds, instead of watching them"
}

export flag open {
    description: "open the page in the browser once it is served"
}

export flag no_watch {
    description: "build a page once and serve it: nothing is watched"
}

// ── what is watched ─────────────────────────────────────────────

/// What a file was when it was looked at: its stamp, or — while it is too
/// young for one to tell two writes apart — its text.
enum Mark {
    Settled(stamp: int)
    Young(text: string)
    Gone
}

fn mark_of(path: string) -> Mark {
    // LICENSED compiler.host_asked_directly: a command's read of the path it was given, at this instant — no query frame is open
    let there = match disk_host().there(path) { .Exists(_, t) -> t, rest -> false }
    if !there { return .Gone }
    match stamp(path) {
        s? -> .Settled(s)
        // LICENSED compiler.host_asked_directly: a command's read of the file it was given, at this instant — no query frame is open
        null -> .Young(disk_host().spared_text(path).as_text() ?? "")
    }
}

/// Whether the file at `path`, marked `was`, is still what it was now that
/// it is marked `now`. A young file is read, so a save that changed
/// nothing moves nothing.
fn unmoved(path: string, was: Mark, now: Mark) -> bool {
    match was {
        .Settled(a) -> match now { .Settled(b) -> a == b, .Young(_) or .Gone -> false },
        .Young(a) -> match now {
            .Settled(_) -> (read_text(path) catch "") == a,
            .Young(b) -> a == b,
            .Gone -> false,
        },
        .Gone -> match now { .Gone -> true, .Settled(_) or .Young(_) -> false },
    }
}

/// One watched file and what it was.
type Watched = { path: string, mark: Mark }

// ── a page ──────────────────────────────────────────────────────

/// What a page is served: the module as last built and the number of the
/// build that made it — 0 until one succeeds — and what the build said if
/// it failed since.
type Standing = { module: Bytes, number: int, failure: string }

/// One package's page being served. `lister` is asked what the build
/// reads; `moved` is rung when the standing changes.
export type Page = {
    root: string,
    tools: Toolchain,
    compiler: Tool,
    glue: string,
    lister: Cell<Workspace>,
    standing: Cell<Standing>,
    watched: Cell<List<Watched>>,
    moved: Bell,
}

/// The page glue beside the compiler: `runtime/dom` in a checkout,
/// `lib/avra/dom` in an install.
fn glue_dir() -> string? { toolchain_files(["../runtime/dom", "../lib/avra/dom"]).find(is_a_dir(it)) }

/// The page of the package at `root`, nothing built yet — or the exit
/// code of the refusal spoken: what this machine lacks to build one.
fn page_at(root: string, target: string) -> Result<Page, int> {
    let lister = root_workspace(root)
    let tools = toolchain(lister, target, true, false)?
    let glue? = glue_dir() else { return .Err(unequipped(no_glue())) }
    let own? = own_binary() else { return .Err(unequipped(no_compiler())) }
    match tool(own) {
        .Ok(compiler) -> page_of(lister, tools, compiler, glue),
        .Err(e) -> .Err(refused_by_host(e)),
    }
}

/// The page of the package `lister` stands over, built by `compiler` for
/// `tools` and served with the glue standing in `glue`; nothing built yet.
export fn page_of(lister: Workspace, tools: Toolchain, compiler: Tool, glue: string) -> Page {
    lister.built_for(tools)
    let none: List<Watched> = []
    Page {
        root: lister.root,
        tools: tools,
        compiler: compiler,
        glue: glue,
        lister: Cell.new(lister),
        standing: Cell.new(Standing { module: "".bytes(), number: 0, failure: "" }),
        watched: Cell.new(none),
        moved: Bell {},
    }
}

impl Page {
    /// Every file the build reads, each as it stands now.
    fn looked() -> List<Watched> {
        match inputs_this_turn(self.lister) {
            .Ok(read) -> [Watched { path: p, mark: mark_of(p) } for p in read],
            .Err(why) -> {
                eprintln("avra: ${why}")
                []
            },
        }
    }

    /// Whether no build has been asked for yet.
    fn unbuilt() -> bool { self.watched.get().is_empty() }

    /// Whether what stands now is what was last built from.
    fn still(now: List<Watched>) -> bool {
        let was = self.watched.get()
        !self.unbuilt() &&
            was.length == now.length &&
            [j for j, w in now if was[j].path != w.path || !unmoved(w.path, was[j].mark, w.mark)]
                .is_empty()
    }

    /// ONE TURN OF THE LOOP: the build's inputs looked at, and the page
    /// built again when one moved; answers whether it built. What is
    /// remembered is what the build STARTED from, so a save made while it
    /// ran is seen by the next turn; a file the build newly reached is
    /// marked as it stands after.
    export fn turn() -> bool {
        let now = self.looked()
        if self.still(now) { return false }
        self.build()
        mut at: Map<string, Mark> = {}
        for w in now { at.set(w.path, w.mark) }
        self.watched.set([w with { mark: at.get(w.path) ?? w.mark } for w in self.looked()])
        true
    }

    /// THE LOOP, FOR EVER: the page built again whenever a file the
    /// build reads moves — looked at every `every`, or, with none, when
    /// the host says one moved.
    export fn tended(every: Duration?) {
        let pause? = every else {
            match watch() {
                .Ok(w) -> self.woken(w),
                .Err(e) -> self.clocked(ms(unwatched_interval), e),
            }
            return
        }
        while true {
            sleep(pause)
            let _ = self.turn()
        }
    }

    /// AIM, LOOK, THEN PARK: the watch is aimed at what the last build
    /// read, a turn is made after it is aimed, and the task parks only
    /// when that turn found nothing moved — so a save between a build
    /// and the aim is built, and one after it wakes the park. A file
    /// gone since the build read it is no refusal: the turn sees it. A
    /// host that will not watch one that stands is said, and the clock
    /// takes over.
    fn woken(w: Watch) {
        while true {
            let refused = [e for e in w.only([f.path for f in self.watched.get()]) if !(e is .NotFound)]
            if !self.turn() {
                let why? = unparked(w, refused) else { continue }
                w.close()
                self.clocked(ms(unwatched_interval), why)
                return
            }
        }
    }

    /// The loop on a clock, said once: the host gave no watch.
    fn clocked(pause: Duration, why: IoError) {
        eprintln(not_watched(why.describe().message, pause))
        while true {
            sleep(pause)
            let _ = self.turn()
        }
    }

    /// `avra build` of the package, as a child: the module it wrote, or
    /// everything the build said.
    fn built() -> Result<Bytes, string> {
        let asked = cmd(
            self.compiler,
            ["build", "--target", self.tools.target, "--wasm_reactor", self.root],
        ) with { env: inherited() }
        let o = match asked.outcome() {
            .Ok(o) -> o,
            .Err(e) -> { return .Err(e.describe().message) },
        }
        if status_of_exit(o.exit) != 0 { return .Err([o.out.stdout.trim(), o.out.stderr.trim()].filter(it != "").join("\n")) }
        let module_path = o.out.stdout.trim().split("\n").last() ?? ""
        // LICENSED compiler.host_asked_directly: the module a build just wrote is read as it stands at this instant
        match disk_host().octets(module_path) {
            .Bytes(module) -> module,
            .Missing -> .Err(IoError.NotFound(module_path).describe().message),
            .Refused(why) -> .Err(why),
        }
    }

    /// The page built, and the standing moved to what came of it: another
    /// module under the next number, the same module still, or the last
    /// good one beside what the build said.
    fn build() {
        let began = now_ms()
        let was = self.standing.get()
        let now = match self.built() {
            .Ok(module) -> if module == was.module { was with { failure: "" } } else { Standing { module: module, number: was.number + 1, failure: "" } },
            .Err(report) -> was with { failure: report },
        }
        self.standing.set(now)
        if now.failure != "" { eprintln(now.failure) }
        println(build_line(now, now_ms() - began))
        if now.number != was.number || now.failure != was.failure { self.moved.ring() }
    }

    // ── what a page is answered ─────────────────────────────────

    /// The standing build as one event: `built` saying the module's
    /// number, or `failed` saying what the build said.
    fn standing_event() -> Event {
        let now = self.standing.get()
        if now.failure == "" { Event { event: "built", data: "${now.number}" } } else { Event { event: "failed", data: now.failure } }
    }

    /// The next event for a page that last heard the bell at `heard`
    /// rings: the standing as soon as it has rung again, nothing within
    /// `wait` when it has not.
    fn next_after(heard: Cell<int>, wait: Duration) -> Next {
        let _ = self.moved.waited_since(heard.get(), wait)
        if self.moved.rings() == heard.get() { return .Quiet }
        heard.set(self.moved.rings())
        .Event(self.standing_event())
    }

    /// THE PAGE'S CHANNEL: the standing build at once — a page that joins
    /// late, or again after the server restarted, hears where things
    /// stand — then each move as it happens.
    fn events() -> Response {
        let heard = Cell.new(-1)
        event_stream(
            Resume.From(Source { next: (wait: Duration) -> self.next_after(heard, wait) }),
            quiet_default(),
        )
    }

    /// The page: the glue's own, titled, with the dev client and the
    /// number of the module it is about to load.
    fn page() -> Response {
        match read_text(joined_path(self.glue, "page.html")) {
            .Ok(html) -> unkept(
                "text/html; charset=utf-8",
                html
                    .replace(
                        "<!--TITLE-->",
                        file_name(self.root).replace("&", "&amp;").replace("<", "&lt;"),
                    )
                    .replace("<!--DEV-->", dev_tags(self.standing.get().number))
                    .bytes(),
            ),
            .Err(e) -> text(500, e.describe().message),
        }
    }

    /// The module as last built — or, before any build succeeded, what
    /// the build said.
    fn module() -> Response {
        let now = self.standing.get()
        if now.number == 0 { return text(503, now.failure) }
        unkept("application/wasm", now.module)
    }

    /// The page, the module and the channel, then the glue's own files.
    export fn routes() -> List<Route> {
        [
            fixed(Method.Get, "/", (_q: Request<Unrouted>) -> self.page()),
            fixed(Method.Get, "/app.wasm", (_q: Request<Unrouted>) -> self.module()),
            fixed(Method.Get, "/@dev/events", (_q: Request<Unrouted>) -> self.events()),
        ]
            .concat(directory("/", fresh_files(self.glue)))
    }
}

/// An answer no cache keeps: the next ask reads what stands then.
fn unkept(kind: string, body: Bytes) -> Response {
    Response {
        headers: [
            Header { name: "content-type", value: kind },
            Header { name: "cache-control", value: "no-store" },
        ],
        body: body,
    }
}

/// What the dev page carries that a production page does not.
fn dev_tags(module: int) -> string {
    "<meta name=\"avra-module\" content=\"${module}\">\n<script type=\"module\" src=\"./dev.js\"></script>"
}

/// The task parked on `w` until a watched file moves — or why it could
/// not be: the first file the host refused to watch, or the watch's own
/// refusal.
fn unparked(w: Watch, refused: List<IoError>) -> IoError? {
    let first? = refused.first() else {
        return match w.next() { .Ok(_) -> null, .Err(e) -> e }
    }
    first
}

// ── The voices ──

fn not_watched(why: string, pause: Duration) -> string {
    "dev: this host will not watch the page's sources (${why}) — looking every ${pause.ms} ms instead"
}

fn build_line(now: Standing, took_ms: int) -> string {
    if now.failure == "" { return "dev: built module ${now.number} — ${now.module.length} bytes in ${took_ms} ms" }
    if now.number == 0 { "dev: the build failed — nothing is served yet" } else { "dev: the build failed — module ${now.number} is still served" }
}

/// Who a listener can be reached by, as the kernel holds its address.
/// Every reach spelled.
fn reach_words(door: Listener) -> string {
    match door.reach() {
        .Ok(far) -> match far {
            .Everywhere -> "every interface of this machine",
            .Loopback -> "this machine alone",
            .One -> "that address alone",
        },
        .Err(e) -> e.describe().message,
    }
}

fn not_served(why: string) -> string { "${why} — `--port 0` takes any free port" }

fn not_opened(url: string) -> string { "dev: no browser could be opened here — the page is at ${url}" }

fn serves_no_file(path: string) -> string { "`dev` serves a directory or a package — ${path} is a file" }

fn serves_no_library(path: string) -> string {
    "${path} is a library: it has no program to serve — a page is a package whose `[bin]` entry mounts a view (`use @std.ui.web.{mount}`)"
}

fn serves_no_program(path: string) -> string {
    "${path}'s program mounts no page, so there is nothing to serve — `avra run` runs it where it stands; a page's program says `use @std.ui.web.{mount}` and `mount(view)`"
}

fn no_glue() -> string { "the page glue is not beside the compiler — expected runtime/dom" }

fn no_compiler() -> string { "this compiler cannot find its own binary to build with" }
