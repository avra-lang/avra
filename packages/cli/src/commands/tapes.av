//! `avra tapes <package>` — every file of a package read off its items' tapes for what it means,
//! held to the tree the compiler's own parse makes of it: statement for statement, the same tape,
//! every node where it was; and what its top level sees held to what the workspace's namespace
//! binds, name for name, wherever the workspace's declaration was written. Says each file that
//! differs and how many it read.
use @std.cli.{CliResult, Runnable, command, flag}
use @std.avrac.compiler.{Workspace}
use @std.avrac.compiler.host.{read_manifest}
use @std.avrac.diagnostics.{new_source_file}
use @std.avrac.core.{DeclId, flatten}
use @std.avrac.compiler.{
    avra_fact_definitions,
    avra_source_world,
    FileScope,
    Space,
    file_meant,
    file_scope,
    spelled_file,
    read_back,
    respelled_origins,
    refusal_difference,
    statement_difference,
}
use @std.io.{list_dir, read_text}
use @std.path.{joined_path}
use @std.time.{now_ns}
use @std.program.address.{DirectoryAddress, SourceFileAddress}
use @std.program.disk_store.{DiskStore, disk_store_at}
use @std.program.query_engine.{QueryEngine, query_engine}
use @std.program.source_facts.{listed, use_source_world}

type TapesCmd = {}

impl Runnable for TapesCmd {
    fn run(args: CliResult) -> int {
        let root? = argued_path(args) else { return 1 }
        let named = read_manifest(
            new_source_file("avra.toml", text_at(joined_path(root, "avra.toml")) ?? ""),
        )
            .name
        let disk = Disk { root: root, name: named, std: rooted(std_root() ?? "") }
        use_source_world(
            avra_source_world(
                (f) -> text_at(disk.on_disk(f.package_name, f.path_in_package)),
                (d) -> names_at(disk.on_disk(d.package_name, d.path_in_package)),
                "avra-tapes",
            ),
        )
        let store = disk_store_at(joined_path(root, ".avra-cache/tapes"))
        let engine = query_engine(store, avra_fact_definitions())
        if args.has_flag("program_only") { return program_timed(engine, store, disk) }
        let ws = root_workspace(root)
        let files = sources(engine, disk.name, "src")
        let differing = [d! for f in files for d in [difference(engine, ws, disk, f)] if d != null]
        for d in differing { println("differs: ${d}") }
        println("tapes: ${files.length} read, ${differing.length} differing")
        if differing.is_empty() { 0 } else { 1 }
    }
}

/// The program layer alone over every file: what each means and what its top level sees, then what
/// it learned kept. Says how long it took and how many questions it answered by running them.
fn program_timed(engine: QueryEngine, store: DiskStore, disk: Disk) -> int {
    // LICENSED input.clock: a receipt's duration is timing, never an input of what is built
    let t0 = now_ns()
    let files = sources(engine, disk.name, "src")
    for f in files {
        let address = SourceFileAddress { package_name: disk.name, path_in_package: f }
        let _ = file_meant(engine, address)
        let _ = file_scope(engine, address)
    }
    let _ = store.saved()
    // LICENSED input.clock: a receipt's duration is timing, never an input of what is built
    let ms = (now_ns() - t0) / 1000000
    println("program: ${files.length} files in ${ms} ms, ${engine.computed_count()} answers made")
    0
}

/// The packages being read on disk: the one named (`root`, addressed by its manifest's `name`), and
/// the toolchain's under its std root.
type Disk = { root: string, name: string, std: string }

impl Disk {
    /// Where a package's file stands.
    fn on_disk(package: string, path: string) -> string {
        if package != self.name && package.starts_with(STD) {
            joined_path(
                joined_path(self.std, "std-${package.substring(STD.length, package.length)}"),
                path,
            )
        } else {
            joined_path(self.root, path)
        }
    }

    /// A file on disk as the program spells it: its package, then its path.
    fn spelled(path: string) -> string {
        if path.starts_with("${self.root}/") { return "${self.name}/${path.substring(self.root.length + 1, path.length)}" }
        let std_dir = "${self.std}/std-"
        if !path.starts_with(std_dir) { return path }
        let rest = path.substring(std_dir.length, path.length)
        let cut = rest.index_of("/") ?? rest.length
        "${STD}${rest.substring(0, cut)}${rest.substring(cut, rest.length)}"
    }
}

/// The toolchain's packages, by the prefix their names wear.
const STD: string = "@std/"

fn text_at(path: string) -> string? { match read_text(path) { .Ok(text) -> text, .Err(_) -> null } }

fn names_at(path: string) -> List<string>? { match list_dir(path) { .Ok(names) -> names, .Err(_) -> null } }

/// Every source under `dir` of the package being read, never through a package nested inside.
fn sources(engine: QueryEngine, package: string, dir: string) -> List<string> {
    let names = listed(engine, DirectoryAddress { package_name: package, path_in_package: dir }) ?? []
    if dir != "src" && names.contains("avra.toml") { return [] }
    flatten(
        [if name.ends_with(".av") { ["${dir}/${name}"] } else { sources(engine, package, "${dir}/${name}") } for name in names],
    )
}

/// How `path` read for what it means differs from the tree the workspace's parse makes of it,
/// absent when it doesn't.
fn difference(engine: QueryEngine, ws: Workspace, disk: Disk, path: string) -> string? {
    let back = read_back(
        path,
        file_meant(engine, SourceFileAddress { package_name: disk.name, path_in_package: path }),
    )
    let parsed = ws.parsed(ws.file_id(joined_path(disk.root, path)))
    respelled_origins(parsed.store, (path) -> disk.spelled(path))
    let refused = refusal_difference(back.store, parsed.store)
    if refused != null { return "${path}: ${refused!}" }
    if back.stmts.length != parsed.stmts.length { return "${path}: ${back.stmts.length} statements, the parse ${parsed.stmts.length}" }
    for at, s in back.stmts {
        let how? = statement_difference(back.store, s, parsed.store, parsed.stmts[at]) else { continue }
        let lo = parsed.store.stmt_span(parsed.stmts[at])?.lo ?? 0
        return "${path}: statement ${at} at ${lo}, ${how}"
    }
    scope_difference(
        file_scope(engine, SourceFileAddress { package_name: disk.name, path_in_package: path }),
        ws,
        disk,
        path,
    )
}

/// How what `path`'s top level sees differs from the workspace's namespace for it, in each space,
/// absent when it doesn't. A name the workspace bound to a declaration nobody wrote — a builtin,
/// or one an annotation made — is the workspace's alone.
fn scope_difference(scope: FileScope, ws: Workspace, disk: Disk, path: string) -> string? {
    let names = ws.visible(ws.file_id(joined_path(disk.root, path)))
    let spaces = [
        Spaced {
            space: Space.Value,
            words: names.fn_suggestions(),
            bound: (n: string) -> names.fn_decl(n),
            own: scope.own.values.keys().concat(scope.module.values.keys()),
        },
        Spaced {
            space: Space.Type,
            words: names.type_suggestions(),
            bound: (n: string) -> names.type_decl(n),
            own: scope.own.types.keys().concat(scope.module.types.keys()),
        },
        Spaced {
            space: Space.Syntax,
            words: names.syntax_names.concat(names.base?.syntax_names ?? []),
            bound: (n: string) -> names.syntax_decl(n),
            own: scope.own.syntaxes.keys().concat(scope.module.syntaxes.keys()),
        },
    ]
    for s in spaces {
        for word in s.words {
            let d? = (s.bound)(word) else { continue }
            let x = ws.decls.decl(d)
            if !x.maker.is_empty() || x.home == null { continue }
            let mine? = scope.named(s.space, word) else { return "${path}: `${word}` is bound by the workspace and seen by nothing" }
            if disk.spelled(ws.decls.file(x.file).path) != spelled_file(mine.file) ||
                x.name != mine.name {
                return "${path}: `${word}` names `${spelled_file(mine.file)}`'s `${mine.name}`, the workspace's `${x.name}`"
            }
        }
        for word in s.own { if (s.bound)(word) == null { return "${path}: `${word}` is seen and the workspace binds nothing" } }
    }
    null
}

/// One space's names: the workspace's and how it binds them, and the scope's own.
type Spaced = { space: Space, words: List<string>, bound: fn(string) -> DeclId?, own: List<string> }

export flag program_only {
    description: "run the program layer alone over every file and say how long it took"
    aliases: ["--program-only"]
}

export command tapes {
    description: "Read every file of a package off its item tapes and hold each to the parse"
    flags: [program_only]
    args: [file]
    run: TapesCmd {}
}
