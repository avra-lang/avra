//! `avra tapes <package>` — every file of a package read off its items' tapes for what it means,
//! held to the tree the compiler's own parse makes of it: statement for statement, the same tape,
//! every node where it was; and what its top level sees held to what the workspace's namespace
//! binds, name for name, wherever the workspace's declaration was written. Says each file that
//! differs and how many it read.
use @std.cli.{CliResult, Runnable, command, flag}
use @std.avrac.compiler.{Workspace}
use @std.avrac.compiler.host.{read_manifest}
use @std.avrac.diagnostics.{new_source_file}
use @std.avrac.core.{DeclId, ExprId, SignedType, TypeId, flatten}
use @std.avrac.compiler.{
    avra_fact_definitions,
    avra_source_world,
    Space,
    file_meant,
    package_read,
    package_worked,
    package_sources,
    spelled_file,
    read_back,
    file_scope,
    fn_signature,
    fn_body_spans,
    typed_fn,
    node_kinds,
    file_declares,
    ItemKind,
    elaborated_fn,
    resolved_in,
    respelled_origins,
    refusal_difference,
    seen_names,
    statement_difference,
}
use @std.io.{list_dir, read_text}
use @std.path.{joined_path}
use @std.time.{now_ns}
use @std.program.address.{SourceFileAddress}
use @std.program.disk_store.{disk_store_at}
use @std.program.query_engine.{QueryEngine, query_engine}
use @std.program.sorted.{sorted_by}
use @std.program.source_facts.{use_source_world}
use @std.text.{text_before}

type TapesCmd = {}

impl Runnable for TapesCmd {
    fn run(args: CliResult) -> int {
        let root? = argued_path(args) else { return 1 }
        let named = read_manifest(
            new_source_file("avra.toml", text_at(joined_path(root, "avra.toml")) ?? ""),
        )
            .name
        let disk = Disk { root: root, name: named, std: rooted(std_root() ?? "") }
        use_source_world(
            avra_source_world(
                (f) -> text_at(disk.on_disk(f.package_name, f.path_in_package)),
                (d) -> names_at(disk.on_disk(d.package_name, d.path_in_package)),
                "avra-tapes",
            ),
        )
        if args.has_flag("program_only") { return program_timed(joined_path(root, ".avra-cache/tapes"), disk) }
        let store = disk_store_at(joined_path(root, ".avra-cache/tapes"))
        let engine = query_engine(store, avra_fact_definitions())
        if args.has_flag("core") { return core_held(engine, disk, args.has_flag("left")) }
        let ws = root_workspace(root)
        let files = package_sources(engine, disk.name, "src")
        let differing = [d! for f in files for d in [difference(engine, ws, disk, f, args.has_flag("signatures"))] if d != null]
        for d in differing { println("differs: ${d}") }
        println("tapes: ${files.length} read, ${differing.length} differing")
        if args.has_flag("signatures") { println("typed: ${typed_share(engine, ws, disk, files, args.has_flag("left"))}") }
        if differing.is_empty() { 0 } else { 1 }
    }
}

/// The program layer alone: the package's store, its unknown files worked out across cores, then
/// the package read whole as one question and what it learned kept. Says how long it took and how
/// many questions this process answered by running them.
fn program_timed(directory: string, disk: Disk) -> int {
    // LICENSED input.clock: a receipt's duration is timing, never an input of what is built
    let t0 = now_ns()
    let worked = package_worked(directory, disk.name)
    let read = package_read(worked.engine, disk.name)
    let _ = worked.store.saved()
    // LICENSED input.clock: a receipt's duration is timing, never an input of what is built
    let ms = (now_ns() - t0) / 1000000
    println(
        "program: ${read.files.length} files, ${read.items} items, ${read.clashes} clashes in ${ms} ms, ${worked.engine.computed_count()} answers made here, ${worked.engine.records_checked_count()} records checked",
    )
    0
}

/// The packages being read on disk: the one named (`root`, addressed by its manifest's `name`), and
/// the toolchain's under its std root.
type Disk = { root: string, name: string, std: string }

impl Disk {
    /// Where a package's file stands.
    fn on_disk(package: string, path: string) -> string {
        if package != self.name && package.starts_with(STD) {
            joined_path(
                joined_path(self.std, "std-${package.substring(STD.length, package.length)}"),
                path,
            )
        } else {
            joined_path(self.root, path)
        }
    }

    /// The named package's file at `path`, as the program addresses it.
    fn file_at(path: string) -> SourceFileAddress { SourceFileAddress { package_name: self.name, path_in_package: path } }

    /// A file on disk as the program spells it: its package, then its path.
    fn spelled(path: string) -> string {
        if path.starts_with("${self.root}/") { return "${self.name}/${path.substring(self.root.length + 1, path.length)}" }
        let std_dir = "${self.std}/std-"
        if !path.starts_with(std_dir) { return path }
        let rest = path.substring(std_dir.length, path.length)
        let cut = rest.index_of("/") ?? rest.length
        "${STD}${rest.substring(0, cut)}${rest.substring(cut, rest.length)}"
    }
}

/// The toolchain's packages, by the prefix their names wear.
const STD: string = "@std/"

fn text_at(path: string) -> string? { match read_text(path) { .Ok(text) -> text, .Err(_) -> null } }

fn names_at(path: string) -> List<string>? { match list_dir(path) { .Ok(names) -> names, .Err(_) -> null } }

/// How `path` read for what it means differs from the tree the workspace's parse makes of it,
/// absent when it doesn't.
fn difference(engine: QueryEngine, ws: Workspace, disk: Disk, path: string, signed: bool) -> string? {
    let back = read_back(path, file_meant(engine, disk.file_at(path)))
    let parsed = ws.parsed(ws.file_id(joined_path(disk.root, path)))
    respelled_origins(parsed.store, (path) -> disk.spelled(path))
    let refused = refusal_difference(back.store, parsed.store)
    if refused != null { return "${path}: ${refused!}" }
    if back.stmts.length != parsed.stmts.length { return "${path}: ${back.stmts.length} statements, the parse ${parsed.stmts.length}" }
    for at, s in back.stmts {
        let how? = statement_difference(back.store, s, parsed.store, parsed.stmts[at]) else { continue }
        let lo = parsed.store.stmt_span(parsed.stmts[at])?.lo ?? 0
        return "${path}: statement ${at} at ${lo}, ${how}"
    }
    let scoped = scope_difference(engine, ws, disk, path)
    if scoped != null || !signed { return scoped }
    signature_difference(engine, ws, disk, path) ?? type_difference(engine, ws, disk, path)
}

/// How much of the fns `files` declare the program layer types: its typed nodes of all their nodes.
fn typed_share(engine: QueryEngine, ws: Workspace, disk: Disk, files: List<string>, shown: bool) -> string {
    let pairs = flatten([typed_pairs(engine, ws, disk, f) for f in files])
    let typed = pairs.filter(it.new != null).length
    mut missing: Map<string, int> = {}
    for p in pairs.filter(it.new == null) { missing.set(p.kind, (missing.get(p.kind) ?? 0) + 1) }
    let most = sorted_by([k for k, _n in missing], (a, b) -> missing.get(a)! > missing.get(b)!)
        .take(12)
    if shown {
        for kind in most {
            for p in pairs.filter(it.new == null && it.kind == kind).take(6) {
                println(
                    "left: ${kind} ${p.old} at ${p.path}:${p.lo} `${snippet(disk, p.path, p.lo)}`",
                )
            }
        }
    }
    "${typed} of the ${pairs.length} nodes the workspace types, ${if pairs.is_empty() { 0 } else { typed * 100 / pairs.length }}%; left most: ${[k + " " + "${missing.get(k)!}" for k in most].join(", ")}"
}

/// How a fn `path` declares is typed differently from the workspace's typing of its body, absent
/// when every node both type reads alike: nodes paired by where they stand, and a node the
/// workspace left untyped (a literal it folded into another) read as nothing to hold.
/// A node of a fn the workspace types, beside what the program layer types it as (absent when it
/// doesn't): its file, the fn, the node's place, its kind and the workspace's spelling.
type TypedPair = { path: string, name: string, lo: int, kind: string, new: SignedType?, old: string }

/// Each node of each fn `path` declares that the workspace typed, paired by span with the program
/// layer's node.
fn typed_pairs(engine: QueryEngine, ws: Workspace, disk: Disk, path: string) -> List<TypedPair> {
    let file = disk.file_at(path)
    let id = ws.file_id(joined_path(disk.root, path))
    let names = ws.visible(id)
    let parsed = ws.parsed(id)
    mut old_at: Map<string, List<ExprId>> = {}
    for at in 0..parsed.store.exprs.count() {
        let e = ExprId { index: at }
        let span? = parsed.store.expr_span(e) else { continue }
        let key = "${span.lo}:${span.hi}"
        old_at.set(key, (old_at.get(key) ?? []).concat([e]))
    }
    mut pairs: List<TypedPair> = []
    for own in file_declares(engine, file).names.filter(it.kind == ItemKind.Fn) {
        let d? = names.fn_decl(own.name) else { continue }
        let x = ws.decls.decl(d)
        if !x.maker.is_empty() ||
            x.home == null ||
            disk.spelled(ws.decls.file(x.file).path) != spelled_file(file) { continue }
        let mine? = typed_fn(engine, file, own.name) else { continue }
        let facts = ws.typed(d)
        let spans = fn_body_spans(engine, file, own.name)
        let kinds = node_kinds(engine, file, own.name)
        for at, ty in mine.types {
            let span? = spans[at] else { continue }
            let olds = old_at.get("${span.lo}:${span.hi}") ?? []
            if olds.length != 1 || !facts.of_expr.holds(olds[0].index) { continue }
            let old_type = facts.type_at(olds[0])
            // a node the workspace's typing never reached holds the error it was born with
            if ws.decls.types.shape_of(old_type) is .Error { continue }
            pairs
                .push(
                    TypedPair {
                        path: path,
                        name: own.name,
                        lo: span.lo,
                        kind: kinds[at],
                        new: ty,
                        old: workspace_spelled(ws, old_type),
                    },
                )
        }
    }
    pairs
}

/// The first node `path`'s fns type differently from the workspace, absent when none does.
fn type_difference(engine: QueryEngine, ws: Workspace, disk: Disk, path: string) -> string? {
    // a block that leaves never answers; the workspace dresses it in the fn's answer
    let p? = typed_pairs(engine, ws, disk, path)
        .find(it.new != null && !(it.new!.head is .Never) && it.new!.spelled() != it.old) else { return null }
    "${path}: `${p.name}` types the node at ${p.lo} ${p.new!.spelled()}, the workspace ${p.old}"
}

/// A type as the workspace writes it, each union's members in the order the program layer writes
/// them and a generic type applied by its declaration's name: a union is a set, the workspace orders
/// it by when its members were first made, and an applied type keeps the name its use spelled.
fn workspace_spelled(ws: Workspace, id: TypeId) -> string {
    let types = ws.decls.types
    match types.shape_of(id) {
        .Union(members) -> sorted_by([workspace_spelled(ws, m) for m in members], (a, b) -> text_before(a, b))
            .join(" or "),
        .Res(ok, err) -> "Result<${workspace_spelled(ws, ok)}, ${workspace_spelled(ws, err)}>",
        .Opt(inner) -> "${workspace_spelled(ws, inner)}?",
        .List(elem) -> "List<${workspace_spelled(ws, elem)}>",
        .App(decl, _, args) -> "${ws.decls.decl(decl).name}<${[workspace_spelled(ws, a) for a in args].join(", ")}>",
        .Map(k, v) -> "Map<${workspace_spelled(ws, k)}, ${workspace_spelled(ws, v)}>",
        // every other shape holds no union to order: the workspace's own spelling is the answer
        rest -> types.name_of(id),
    }
}

/// How a fn `path` declares is signed differently from the workspace's signature of it, absent when
/// every one is signed alike: each parameter's type and the answer, as the compiler writes them.
fn signature_difference(engine: QueryEngine, ws: Workspace, disk: Disk, path: string) -> string? {
    let file = disk.file_at(path)
    let names = ws.visible(ws.file_id(joined_path(disk.root, path)))
    for own in file_declares(engine, file).names.filter(it.kind == ItemKind.Fn) {
        let d? = names.fn_decl(own.name) else { continue }
        let x = ws.decls.decl(d)
        if !x.maker.is_empty() ||
            x.home == null ||
            disk.spelled(ws.decls.file(x.file).path) != spelled_file(file) { continue }
        let signed? = ws.decls.sig(d) else { continue }
        let theirs? = match signed { .Fn(sig) -> sig, rest -> null } else { continue }
        let mine? = fn_signature(engine, file, own.name) else { return "${path}: `${own.name}` is signed by the workspace and by nothing here" }
        if mine.answer.inferred() || mine.params.any(it.ty?.inferred() ?? false) { continue }
        let old = "(${[workspace_spelled(ws, p) for p in theirs.params].join(", ")}) -> ${workspace_spelled(ws, theirs.ret)}"
        let new = "(${[p.ty?.spelled() ?? "_" for p in mine.params].join(", ")}) -> ${mine.answer.spelled()}"
        if old != new { return "${path}: `${own.name}` is signed ${new}, the workspace's ${old}" }
    }
    null
}

/// How what `path`'s top level sees differs from the workspace's namespace for it, in each space,
/// absent when it doesn't. A name the workspace bound to a declaration nobody wrote — a builtin,
/// or one an annotation made — is the workspace's alone.
fn scope_difference(engine: QueryEngine, ws: Workspace, disk: Disk, path: string) -> string? {
    let file = disk.file_at(path)
    let scope? = file_scope(engine, file) else { return "${path}: has no scope" }
    let names = ws.visible(ws.file_id(joined_path(disk.root, path)))
    let spaces = [
        Spaced {
            space: Space.Value,
            words: names.fn_suggestions(),
            bound: (n: string) -> names.fn_decl(n),
            seen: seen_names(engine, scope, file, Space.Value),
        },
        Spaced {
            space: Space.Type,
            words: names.type_suggestions(),
            bound: (n: string) -> names.type_decl(n),
            seen: seen_names(engine, scope, file, Space.Type),
        },
        Spaced {
            space: Space.Syntax,
            words: names.syntax_names.concat(names.base?.syntax_names ?? []),
            bound: (n: string) -> names.syntax_decl(n),
            seen: seen_names(engine, scope, file, Space.Syntax),
        },
    ]
    for s in spaces {
        for word in s.words {
            let d? = (s.bound)(word) else { continue }
            let x = ws.decls.decl(d)
            if !x.maker.is_empty() || x.home == null { continue }
            let mine? = resolved_in(engine, scope, file, s.space, word).named() else { return "${path}: `${word}` is bound by the workspace and seen by nothing" }
            if disk.spelled(ws.decls.file(x.file).path) != spelled_file(mine.file) ||
                x.name != mine.name {
                return "${path}: `${word}` names `${spelled_file(mine.file)}`'s `${mine.name}`, the workspace's `${x.name}`"
            }
        }
        for word in s.seen { if (s.bound)(word) == null { return "${path}: `${word}` is seen and the workspace binds nothing" } }
    }
    null
}

/// One space's names: the workspace's and how it binds them, and every one the file sees.
type Spaced = { space: Space, words: List<string>, bound: fn(string) -> DeclId?, seen: List<string> }

export flag program_only {
    description: "run the program layer alone over every file and say how long it took"
    aliases: ["--program-only"]
}

export flag signatures {
    description: "hold every fn's signature to the workspace's too"
    aliases: ["--signatures"]
}

export flag left {
    description: "with --signatures or --core, show where the nodes that don't agree stand"
    aliases: ["--left"]
}

export flag core {
    description: "elaborate every fn into the core its sugars mean, and hold each sugar's type to its meaning's"
    aliases: ["--core"]
}

export command tapes {
    description: "Read every file of a package off its item tapes and hold each to the parse"
    flags: [program_only, signatures, left, core]
    args: [file]
    run: TapesCmd {}
}

/// Every fn of the package elaborated: each sugar a meaning rewrote, and whether the core it means
/// is typed as its own rule typed it. Answers 1 when any differs.
fn core_held(engine: QueryEngine, disk: Disk, shown: bool) -> int {
    mut sugars = 0
    mut alike = 0
    mut seated = 0
    mut untyped = 0
    mut differing: List<string> = []
    for path in package_sources(engine, disk.name, "src") {
        let file = disk.file_at(path)
        for own in file_declares(engine, file).names.filter(it.kind == ItemKind.Fn) {
            let body? = elaborated_fn(engine, file, own.name) else { continue }
            for e in body.sugars {
                sugars = sugars + 1
                let surface = body.surface[e.index]
                let core = body.core[e.index]
                if surface == null || core == null {
                    untyped = untyped + 1
                    if shown { println(
                            "untyped: ${path} ${own.name}: ${surface?.spelled() ?? "nothing"} on the surface, ${core?.spelled() ?? "nothing"} in the core",
                        ) }
                    continue
                }
                if surface!.spelled() == core!.spelled() {
                    alike = alike + 1
                    continue
                }
                if meets_its_seat(surface!, core!, body.seats.get("${e.index}")) {
                    seated = seated + 1
                    continue
                }
                let seat = body.seats.get("${e.index}")?.spelled() ?? "no seat"
                differing
                    .push(
                        "${path} ${own.name}: ${surface!.spelled()} on the surface, ${core!.spelled()} in the core, ${seat} wanted",
                    )
            }
        }
    }
    if shown { for d in differing { println("differs: ${d}") } }
    println(
        "core: ${sugars} sugars meant, ${alike} typed alike, ${seated} answering their seat, ${differing.length} differing, ${untyped} untyped on a side",
    )
    if differing.is_empty() { 0 } else { 1 }
}

/// Whether a core answering its seat's want stands for a surface type that fits that seat.
fn meets_its_seat(surface: SignedType, core: SignedType, seat: SignedType?) -> bool {
    let wanted? = seat else { return false }
    core.spelled() == wanted.spelled() && surface.reaches(wanted)
}

/// The source at `lo` in the package's file `path`, one line of it at most.
fn snippet(disk: Disk, path: string, lo: int) -> string {
    let text = text_at(disk.on_disk(disk.name, path)) ?? ""
    let rest = text.substring(lo, if lo + 60 < text.length { lo + 60 } else { text.length })
    let line_end = rest.index_of("\n")
    if line_end < 0 { rest } else { rest.substring(0, line_end) }
}
