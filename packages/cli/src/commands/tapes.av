//! `avra tapes <package>` — every file of a package read off its items' tapes for what it means,
//! held to the tree the compiler's own parse makes of it: statement for statement, the same tape,
//! every node where it was; and what its top level sees held to what the workspace's namespace
//! binds, name for name, wherever the workspace's declaration was written. Says each file that
//! differs and how many it read.
use @std.cli.{CliResult, Runnable, command, flag}
use @std.avrac.compiler.{Workspace}
use @std.avrac.compiler.host.{read_manifest}
use @std.avrac.diagnostics.{new_source_file}
use @std.avrac.core.{
    BoxKind,
    CalledFn,
    DeclId,
    ExprId,
    FileId,
    Ins,
    Layout,
    LiftedBody,
    Reg,
    RtFlag,
    SignedType,
    Slot,
    Static,
    StaticBox,
    TypeId,
    alpha_renamed,
    canon_not_if,
    dst_of,
    flatten,
    region_end,
    resymbolled,
    same_ins,
    same_reg,
}
use @std.avrac.compiler.lower.{Body}
use @std.avrac.features.{Namespace}
use @std.avrac.compiler.backend.{body_lines, static_block}
use @std.avrac.compiler.{
    avra_fact_definitions,
    avra_source_world,
    declared_symbol,
    Space,
    file_meant,
    package_read,
    package_worked,
    package_sources,
    spelled_file,
    read_back,
    file_scope,
    fn_signature,
    fn_body_spans,
    typed_fn,
    node_kinds,
    file_declares,
    ItemKind,
    elaborated_fn,
    lowered_fn,
    lowered_unit_of,
    LoweredFn,
    resolved_in,
    respelled_origins,
    refusal_difference,
    seen_names,
    statement_difference,
}
use @std.io.{list_dir, read_text}
use @std.path.{joined_path}
use @std.time.{now_ns}
use @std.program.address.{SourceFileAddress}
use @std.program.disk_store.{disk_store_at}
use @std.program.query_engine.{QueryEngine, query_engine}
use @std.program.sorted.{sorted_by}
use @std.program.source_facts.{use_source_world}
use @std.text.{text_before}

type TapesCmd = {}

impl Runnable for TapesCmd {
    fn run(args: CliResult) -> int {
        let root? = argued_path(args) else { return 1 }
        let named = read_manifest(
            new_source_file("avra.toml", text_at(joined_path(root, "avra.toml")) ?? ""),
        )
            .name
        let disk = Disk { root: root, name: named, std: rooted(std_root() ?? "") }
        use_source_world(
            avra_source_world(
                (f) -> text_at(disk.on_disk(f.package_name, f.path_in_package)),
                (d) -> names_at(disk.on_disk(d.package_name, d.path_in_package)),
                "avra-tapes",
            ),
        )
        if args.has_flag("program_only") { return program_timed(joined_path(root, ".avra-cache/tapes"), disk) }
        let store = disk_store_at(joined_path(root, ".avra-cache/tapes"))
        let engine = query_engine(store, avra_fact_definitions())
        if args.has_flag("core") { return core_held(engine, disk, args.has_flag("left")) }
        let ws = root_workspace(root)
        if args.has_flag("lowered") { return lowered_held(engine, ws, disk, args.has_flag("left")) }
        let files = package_sources(engine, disk.name, "src")
        let differing = [d! for f in files for d in [difference(engine, ws, disk, f, args.has_flag("signatures"))] if d != null]
        for d in differing { println("differs: ${d}") }
        println("tapes: ${files.length} read, ${differing.length} differing")
        if args.has_flag("signatures") { println("typed: ${typed_share(engine, ws, disk, files, args.has_flag("left"))}") }
        if differing.is_empty() { 0 } else { 1 }
    }
}

/// The program layer alone: the package's store, its unknown files worked out across cores, then
/// the package read whole as one question and what it learned kept. Says how long it took and how
/// many questions this process answered by running them.
fn program_timed(directory: string, disk: Disk) -> int {
    // LICENSED input.clock: a receipt's duration is timing, never an input of what is built
    let t0 = now_ns()
    let worked = package_worked(directory, disk.name)
    let read = package_read(worked.engine, disk.name)
    worked.engine.frontier_kept()
    let _ = worked.store.saved()
    // LICENSED input.clock: a receipt's duration is timing, never an input of what is built
    let ms = (now_ns() - t0) / 1000000
    println(
        "program: ${read.files.length} files, ${read.items} items, ${read.clashes} clashes in ${ms} ms, ${worked.engine.computed_count()} answers made here, ${worked.engine.records_checked_count()} records checked",
    )
    0
}

/// The packages being read on disk: the one named (`root`, addressed by its manifest's `name`), and
/// the toolchain's under its std root.
type Disk = { root: string, name: string, std: string }

impl Disk {
    /// Where a package's file stands.
    fn on_disk(package: string, path: string) -> string {
        if package != self.name && package.starts_with(STD) {
            joined_path(
                joined_path(self.std, "std-${package.substring(STD.length, package.length)}"),
                path,
            )
        } else {
            joined_path(self.root, path)
        }
    }

    /// The named package's file at `path`, as the program addresses it.
    fn file_at(path: string) -> SourceFileAddress { SourceFileAddress { package_name: self.name, path_in_package: path } }

    /// A file on disk as the program spells it: its package, then its path.
    fn spelled(path: string) -> string {
        if path.starts_with("${self.root}/") { return "${self.name}/${path.substring(self.root.length + 1, path.length)}" }
        let std_dir = "${self.std}/std-"
        if !path.starts_with(std_dir) { return path }
        let rest = path.substring(std_dir.length, path.length)
        let cut = rest.index_of("/") ?? rest.length
        "${STD}${rest.substring(0, cut)}${rest.substring(cut, rest.length)}"
    }
}

/// The toolchain's packages, by the prefix their names wear.
const STD: string = "@std/"

fn text_at(path: string) -> string? { match read_text(path) { .Ok(text) -> text, .Err(_) -> null } }

fn names_at(path: string) -> List<string>? { match list_dir(path) { .Ok(names) -> names, .Err(_) -> null } }

/// How `path` read for what it means differs from the tree the workspace's parse makes of it,
/// absent when it doesn't.
fn difference(engine: QueryEngine, ws: Workspace, disk: Disk, path: string, signed: bool) -> string? {
    let back = read_back(path, file_meant(engine, disk.file_at(path)))
    let parsed = ws.parsed(ws.file_id(joined_path(disk.root, path)))
    respelled_origins(parsed.store, (path) -> disk.spelled(path))
    let refused = refusal_difference(back.store, parsed.store)
    if refused != null { return "${path}: ${refused!}" }
    if back.stmts.length != parsed.stmts.length { return "${path}: ${back.stmts.length} statements, the parse ${parsed.stmts.length}" }
    for at, s in back.stmts {
        let how? = statement_difference(back.store, s, parsed.store, parsed.stmts[at]) else { continue }
        let lo = parsed.store.stmt_span(parsed.stmts[at])?.lo ?? 0
        return "${path}: statement ${at} at ${lo}, ${how}"
    }
    let scoped = scope_difference(engine, ws, disk, path)
    if scoped != null || !signed { return scoped }
    signature_difference(engine, ws, disk, path) ?? type_difference(engine, ws, disk, path)
}

/// How much of the fns `files` declare the program layer types: its typed nodes of all their nodes.
fn typed_share(engine: QueryEngine, ws: Workspace, disk: Disk, files: List<string>, shown: bool) -> string {
    let pairs = flatten([typed_pairs(engine, ws, disk, f) for f in files])
    let typed = pairs.filter(it.new != null).length
    mut missing: Map<string, int> = {}
    for p in pairs.filter(it.new == null) { missing.set(p.kind, (missing.get(p.kind) ?? 0) + 1) }
    let most = sorted_by([k for k, _n in missing], (a, b) -> missing.get(a)! > missing.get(b)!)
        .take(12)
    if shown {
        for kind in most {
            for p in pairs.filter(it.new == null && it.kind == kind).take(6) {
                println(
                    "left: ${kind} ${p.old} at ${p.path}:${p.lo} `${snippet(disk, p.path, p.lo)}`",
                )
            }
        }
    }
    "${typed} of the ${pairs.length} nodes the workspace types, ${if pairs.is_empty() { 0 } else { typed * 100 / pairs.length }}%; left most: ${[k + " " + "${missing.get(k)!}" for k in most].join(", ")}"
}

/// How a fn `path` declares is typed differently from the workspace's typing of its body, absent
/// when every node both type reads alike: nodes paired by where they stand, and a node the
/// workspace left untyped (a literal it folded into another) read as nothing to hold.
/// A node of a fn the workspace types, beside what the program layer types it as (absent when it
/// doesn't): its file, the fn, the node's place, its kind and the workspace's spelling.
type TypedPair = { path: string, name: string, lo: int, kind: string, new: SignedType?, old: string }

/// Each node of each fn `path` declares that the workspace typed, paired by span with the program
/// layer's node.
fn typed_pairs(engine: QueryEngine, ws: Workspace, disk: Disk, path: string) -> List<TypedPair> {
    let file = disk.file_at(path)
    let id = ws.file_id(joined_path(disk.root, path))
    let names = ws.visible(id)
    let parsed = ws.parsed(id)
    mut old_at: Map<string, List<ExprId>> = {}
    for at in 0..parsed.store.exprs.count() {
        let e = ExprId { index: at }
        let span? = parsed.store.expr_span(e) else { continue }
        let key = "${span.lo}:${span.hi}"
        old_at.set(key, (old_at.get(key) ?? []).concat([e]))
    }
    mut pairs: List<TypedPair> = []
    for own in file_declares(engine, file).names.filter(it.kind == ItemKind.Fn) {
        let d? = written_decl(ws, disk, names, file, own.name) else { continue }
        let mine? = typed_fn(engine, file, own.name) else { continue }
        let facts = ws.typed(d)
        let spans = fn_body_spans(engine, file, own.name)
        let kinds = node_kinds(engine, file, own.name)
        for at, ty in mine.types {
            let span? = spans[at] else { continue }
            let olds = old_at.get("${span.lo}:${span.hi}") ?? []
            if olds.length != 1 || !facts.of_expr.holds(olds[0].index) { continue }
            let old_type = facts.type_at(olds[0])
            // a node the workspace's typing never reached holds the error it was born with
            if ws.decls.types.shape_of(old_type) is .Error { continue }
            pairs
                .push(
                    TypedPair {
                        path: path,
                        name: own.name,
                        lo: span.lo,
                        kind: kinds[at],
                        new: ty,
                        old: workspace_spelled(ws, old_type),
                    },
                )
        }
    }
    pairs
}

/// The workspace's declaration of the fn `name` that `file` writes, absent for one generated, or
/// written somewhere else.
fn written_decl(ws: Workspace, disk: Disk, names: Namespace, file: SourceFileAddress, name: string) -> DeclId? {
    let d? = names.fn_decl(name) else { return null }
    let x = ws.decls.decl(d)
    if !x.maker.is_empty() ||
        x.home == null ||
        disk.spelled(ws.decls.file(x.file).path) != spelled_file(file) { return null }
    d
}

/// The first node `path`'s fns type differently from the workspace, absent when none does.
fn type_difference(engine: QueryEngine, ws: Workspace, disk: Disk, path: string) -> string? {
    // a block that leaves never answers; the workspace dresses it in the fn's answer
    let p? = typed_pairs(engine, ws, disk, path)
        .find(it.new != null && !(it.new!.head is .Never) && it.new!.spelled() != it.old) else { return null }
    "${path}: `${p.name}` types the node at ${p.lo} ${p.new!.spelled()}, the workspace ${p.old}"
}

/// A type as the workspace writes it, each union's members in the order the program layer writes
/// them and a generic type applied by its declaration's name: a union is a set, the workspace orders
/// it by when its members were first made, and an applied type keeps the name its use spelled.
fn workspace_spelled(ws: Workspace, id: TypeId) -> string {
    let types = ws.decls.types
    match types.shape_of(id) {
        .Union(members) -> sorted_by([workspace_spelled(ws, m) for m in members], (a, b) -> text_before(a, b))
            .join(" or "),
        .Res(ok, err) -> "Result<${workspace_spelled(ws, ok)}, ${workspace_spelled(ws, err)}>",
        .Opt(inner) -> "${workspace_spelled(ws, inner)}?",
        .List(elem) -> "List<${workspace_spelled(ws, elem)}>",
        .App(decl, _, args) -> "${ws.decls.decl(decl).name}<${[workspace_spelled(ws, a) for a in args].join(", ")}>",
        .Map(k, v) -> "Map<${workspace_spelled(ws, k)}, ${workspace_spelled(ws, v)}>",
        // every other shape holds no union to order: the workspace's own spelling is the answer
        rest -> types.name_of(id),
    }
}

/// How a fn `path` declares is signed differently from the workspace's signature of it, absent when
/// every one is signed alike: each parameter's type and the answer, as the compiler writes them.
fn signature_difference(engine: QueryEngine, ws: Workspace, disk: Disk, path: string) -> string? {
    let file = disk.file_at(path)
    let names = ws.visible(ws.file_id(joined_path(disk.root, path)))
    for own in file_declares(engine, file).names.filter(it.kind == ItemKind.Fn) {
        let d? = written_decl(ws, disk, names, file, own.name) else { continue }
        let signed? = ws.decls.sig(d) else { continue }
        let theirs? = match signed { .Fn(sig) -> sig, rest -> null } else { continue }
        let mine? = fn_signature(engine, file, own.name) else { return "${path}: `${own.name}` is signed by the workspace and by nothing here" }
        if mine.answer.inferred() || mine.params.any(it.ty?.inferred() ?? false) { continue }
        let old = "(${[workspace_spelled(ws, p) for p in theirs.params].join(", ")}) -> ${workspace_spelled(ws, theirs.ret)}"
        let new = "(${[p.ty?.spelled() ?? "_" for p in mine.params].join(", ")}) -> ${mine.answer.spelled()}"
        if old != new { return "${path}: `${own.name}` is signed ${new}, the workspace's ${old}" }
    }
    null
}

/// How what `path`'s top level sees differs from the workspace's namespace for it, in each space,
/// absent when it doesn't. A name the workspace bound to a declaration nobody wrote — a builtin,
/// or one an annotation made — is the workspace's alone.
fn scope_difference(engine: QueryEngine, ws: Workspace, disk: Disk, path: string) -> string? {
    let file = disk.file_at(path)
    let scope? = file_scope(engine, file) else { return "${path}: has no scope" }
    let names = ws.visible(ws.file_id(joined_path(disk.root, path)))
    let spaces = [
        Spaced {
            space: Space.Value,
            words: names.fn_suggestions(),
            bound: (n: string) -> names.fn_decl(n),
            seen: seen_names(engine, scope, file, Space.Value),
        },
        Spaced {
            space: Space.Type,
            words: names.type_suggestions(),
            bound: (n: string) -> names.type_decl(n),
            seen: seen_names(engine, scope, file, Space.Type),
        },
        Spaced {
            space: Space.Syntax,
            words: names.syntax_names.concat(names.base?.syntax_names ?? []),
            bound: (n: string) -> names.syntax_decl(n),
            seen: seen_names(engine, scope, file, Space.Syntax),
        },
    ]
    for s in spaces {
        for word in s.words {
            let d? = (s.bound)(word) else { continue }
            let x = ws.decls.decl(d)
            if !x.maker.is_empty() || x.home == null { continue }
            let mine? = resolved_in(engine, scope, file, s.space, word).named() else { return "${path}: `${word}` is bound by the workspace and seen by nothing" }
            if disk.spelled(ws.decls.file(x.file).path) != spelled_file(mine.file) ||
                x.name != mine.name {
                return "${path}: `${word}` names `${spelled_file(mine.file)}`'s `${mine.name}`, the workspace's `${x.name}`"
            }
        }
        for word in s.seen { if (s.bound)(word) == null { return "${path}: `${word}` is seen and the workspace binds nothing" } }
    }
    null
}

/// One space's names: the workspace's and how it binds them, and every one the file sees.
type Spaced = { space: Space, words: List<string>, bound: fn(string) -> DeclId?, seen: List<string> }

export flag program_only {
    description: "run the program layer alone over every file and say how long it took"
    aliases: ["--program-only"]
}

export flag signatures {
    description: "hold every fn's signature to the workspace's too"
    aliases: ["--signatures"]
}

export flag left {
    description: "with --signatures, --core or --lowered, show where what doesn't agree stands"
    aliases: ["--left"]
}

export flag core {
    description: "elaborate every fn into the core its sugars mean, and hold each sugar's type to its meaning's"
    aliases: ["--core"]
}

export flag lowered {
    description: "lower every fn the program layer can lower whole, and hold its IR to the workspace's"
    aliases: ["--lowered"]
}

export command tapes {
    description: "Read every file of a package off its item tapes and hold each to the parse"
    flags: [program_only, signatures, left, core, lowered]
    args: [file]
    run: TapesCmd {}
}

/// Every fn of the package elaborated: each sugar a meaning rewrote, and whether the core it means
/// is typed as its own rule typed it. Answers 1 when any differs.
fn core_held(engine: QueryEngine, disk: Disk, shown: bool) -> int {
    mut sugars = 0
    mut alike = 0
    mut seated = 0
    mut untyped = 0
    mut statements = 0
    mut nodes = 0
    mut differing: List<string> = []
    for path in package_sources(engine, disk.name, "src") {
        let file = disk.file_at(path)
        for own in file_declares(engine, file).names.filter(it.kind == ItemKind.Fn) {
            let body? = elaborated_fn(engine, file, own.name) else { continue }
            let site = "${path} ${own.name}"
            statements = statements + body.statements.length
            let roots = [e.index for e in body.sugars]
            for at, surface in body.surface {
                let surface? = surface else { continue }
                let core? = body.core[at] else { continue }
                if roots.contains(at) { continue }
                nodes = nodes + 1
                let seat = body.seat_at(at)
                if surface.spelled() != core.spelled() && !meets_its_seat(surface, core, seat) {
                    differing.push(differs(site, "a node ", surface, core, seat))
                }
            }
            for e in body.sugars {
                sugars = sugars + 1
                let surface = body.surface[e.index]
                let core = body.core[e.index]
                if surface == null || core == null {
                    untyped = untyped + 1
                    if shown {
                        println(
                            "untyped: ${site}: ${surface?.spelled() ?? "nothing"} on the surface, ${core?.spelled() ?? "nothing"} in the core",
                        )
                    }
                }
                let surface? = surface else { continue }
                let core? = core else { continue }
                if surface.spelled() == core.spelled() {
                    alike = alike + 1
                    continue
                }
                let seat = body.seat_at(e.index)
                if meets_its_seat(surface, core, seat) {
                    seated = seated + 1
                    continue
                }
                differing.push(differs(site, "", surface, core, seat))
            }
        }
    }
    if shown { for d in differing { println("differs: ${d}") } }
    println(
        "core: ${sugars} sugars and ${statements} statements meant; sugars ${alike} typed alike, ${seated} answering their seat, ${untyped} untyped on a side; ${nodes} other nodes typed on both sides; ${differing.length} differing",
    )
    if differing.is_empty() { 0 } else { 1 }
}

/// A node of the fn at `site` typed one way on the surface and another in the core.
fn differs(site: string, what: string, surface: SignedType, core: SignedType, seat: SignedType?) -> string {
    "${site}: ${what}${surface.spelled()} on the surface, ${core.spelled()} in the core, ${seat?.spelled() ?? "no seat"} wanted"
}

/// Whether a core answering its seat's want stands for a surface type that fits that seat.
fn meets_its_seat(surface: SignedType, core: SignedType, seat: SignedType?) -> bool {
    let wanted? = seat else { return false }
    core.spelled() == wanted.spelled() && surface.reaches(wanted)
}

/// The source at `lo` in the package's file `path`, one line of it at most.
fn snippet(disk: Disk, path: string, lo: int) -> string {
    let text = text_at(disk.on_disk(disk.name, path)) ?? ""
    let rest = text.substring(lo, if lo + 60 < text.length { lo + 60 } else { text.length })
    let line_end = rest.index_of("\n")
    if line_end < 0 { rest } else { rest.substring(0, line_end) }
}

/// Every fn of the package the program layer lowers whole, its IR held to the workspace's lowering
/// of the same fn: seat for seat, instruction for instruction with registers numbered as they're
/// defined, and each register's layout to the one the workspace's type for it has. The workspace
/// tests the unwinding flag after a call that may reach a cancel point, which the program layer
/// can't tell yet, and the tick at a loop's back edge where the program links a scheduler, which it
/// can't tell yet either; those tests are cut and counted. Each lambda a whole fn lifts is held to the
/// workspace's lift of the lambda written at the same place, and counted. Says what isn't lowered yet, by the first thing
/// each fn met. Answers 1 when any differs.
fn lowered_held(engine: QueryEngine, ws: Workspace, disk: Disk, shown: bool) -> int {
    mut fns = 0
    mut whole = 0
    mut alike = 0
    mut tested = 0
    mut ticked = 0
    mut lambdas = 0
    mut statics = 0
    mut differing: List<string> = []
    mut missing: Map<string, int> = {}
    let paths = package_sources(engine, disk.name, "src")
    let ids = [ws.file_id(joined_path(disk.root, p)) for p in paths]
    for id in ids { let _ = ws.parsed(id) }
    let scopes = [ws.visible(id) for id in ids]
    workspace_settled(ws)
    for at, path in paths {
        let file = disk.file_at(path)
        let names = scopes[at]
        for own in file_declares(engine, file).names.filter(it.kind == ItemKind.Fn) {
            let d? = written_decl(ws, disk, names, file, own.name) else { continue }
            let mine? = lowered_fn(engine, file, own.name) else { continue }
            fns = fns + 1
            if !mine.whole() {
                let first = mine.missing[0]
                missing.set(first, (missing.get(first) ?? 0) + 1)
                if shown && missing.get(first)! <= 3 { println("left: ${first} in ${path} ${own.name}") }
                continue
            }
            whole = whole + 1
            let unit = lowered_unit_of(ws, ws.decls.plain_want(d))
            let theirs? = unit.bodies.first() else {
                differing.push("${path} ${own.name}: the workspace lowers no body for it")
                continue
            }
            mut lifted = lift_names(ws, ids[at], mine.lifts)
            lifted.set(declared_symbol(file, own.name), ws.decls.symbol(d))
            let cut = flag_tests_cut(theirs.ins)
            let how = lowered_difference(ws, disk, mine, theirs with { ins: cut.ins }, lifted) ?? lifts_difference(
                ws,
                disk,
                mine.lifts,
                unit.bodies,
                lifted,
            ) ?? statics_difference(ws, disk, mine, unit.statics, lifted)
            if how != null {
                differing.push("${path} ${own.name}: ${how!}")
                continue
            }
            alike = alike + 1
            lambdas = lambdas + mine.lifts.length
            statics = statics + mine.statics.length
            if cut.calls > 0 { tested = tested + 1 }
            if cut.edges > 0 { ticked = ticked + 1 }
        }
    }
    if shown { for d in differing { println("differs: ${d}") } }
    let most = sorted_by([k for k, _n in missing], (a, b) -> missing.get(a)! > missing.get(b)!)
    println(
        "lowered: ${whole} of ${fns} fns whole, ${alike} held alike to the workspace's (${tested} past a cancel test cut after a call, ${ticked} past a tick test cut at a loop's back edge, ${lambdas} lambdas lifted alike, ${statics} statics laid out alike), ${differing.length} differing; not lowered yet: ${[k + " " + "${missing.get(k)!}" for k in most].join(", ")}",
    )
    if differing.is_empty() { 0 } else { 1 }
}

/// The workspace with every file it reaches named and its references gathered, before any of its
/// lowering runs: lowering a fn asks the references, whose gathering reads each file's names, and
/// naming a file the workspace hasn't met yet mints it under the question that reads them.
fn workspace_settled(ws: Workspace) {
    mut named = 0
    while ws.decls.all_files().length > named {
        let files = ws.decls.all_files()
        for x in files.drop(named) { if ws.reads_as_source(x.path) { let _ = ws.visible(x.id) } }
        named = files.length
    }
    let _ = ws.references()
}

/// The workspace's instructions with each test of the running task's flags cut out, and how many
/// were: the unwinding test after a call that may reach a cancel point, and the tick test at a loop's
/// back edge.
type CutTests = { ins: List<Ins>, calls: int, edges: int }

/// `ins` without its flag tests: each a read of a flag and the region it decides.
fn flag_tests_cut(ins: List<Ins>) -> CutTests {
    mut kept: List<Ins> = []
    mut calls = 0
    mut edges = 0
    mut at = 0
    while at < ins.length {
        let tested? = flag_tested(ins, at) else {
            kept.push(ins[at])
            at = at + 1
            continue
        }
        at = region_end(ins, at + 1) + 1
        match tested {
            .Unwinding -> {
                calls = calls + 1
            },
            .Tick -> {
                edges = edges + 1
            },
        }
    }
    CutTests { ins: kept, calls: calls, edges: edges }
}

/// The flag the instruction at `at` reads for the region that follows it, absent where it reads none.
fn flag_tested(ins: List<Ins>, at: int) -> RtFlag? {
    if at + 1 >= ins.length { return null }
    match ins[at] {
        .FlagRead(r, f) -> match ins[at + 1] { .IfStart(c) -> if same_reg(c, r) { f } else { null }, rest -> null },
        rest -> null,
    }
}

/// A body's instructions with registers numbered as they're defined, and each defined register's own
/// number, in the order defined.
type Numbered = { ins: List<Ins>, defined: List<Reg> }

fn numbered(raw: List<Ins>, seats: int) -> Numbered {
    Numbered {
        ins: alpha_renamed(raw, seats),
        defined: [d! for i in canon_not_if(raw) for d in [dst_of(i)] if d != null],
    }
}

/// Each lambda the program layer lifted, mapped to the symbol the workspace lifts the lambda written
/// at the same place under.
fn lift_names(ws: Workspace, id: FileId, lifts: List<LiftedBody>) -> Map<string, string> {
    mut names: Map<string, string> = {}
    if lifts.is_empty() { return names }
    let store = ws.parsed(id).store
    for i in 0..store.exprs.count() {
        let x = ExprId { index: i }
        let span? = store.expr_span(x) else { continue }
        if store.lambda_parts(x) == null { continue }
        let l? = lifts.find(it.lo == span.lo && it.hi == span.hi) else { continue }
        names.set(l.symbol, ws.decls.lifted_symbol(id, x))
    }
    names
}

/// How the lambdas a fn lifts here differ from the workspace's lifts of them, absent when each reads
/// alike.
fn lifts_difference(
    ws: Workspace,
    disk: Disk,
    lifts: List<LiftedBody>,
    bodies: List<Body>,
    lifted: Map<string, string>,
) -> string? {
    for l in lifts {
        let name? = lifted.get(l.symbol) else { return "the workspace lifts no lambda at ${l.lo}" }
        let theirs? = bodies.find(it.name == name) else { return "the workspace lowers no body for the lambda at ${l.lo}" }
        let mine = LoweredFn {
            params: l.params,
            answer: l.answer,
            ins: l.ins,
            layouts: l.layouts,
            callees: l.callees,
            missing: [],
            lifts: [],
            statics: [],
        }
        let how = lowered_difference(
            ws,
            disk,
            mine,
            theirs with { ins: flag_tests_cut(theirs.ins).ins },
            lifted,
        )
        if how != null { return "the lambda at ${l.lo}: ${how!}" }
    }
    null
}

/// How a fn lowered here differs from the workspace's lowering of it, absent when every seat,
/// instruction and register reads alike; `lifted` names each lambda's symbol as the workspace's.
fn lowered_difference(
    ws: Workspace,
    disk: Disk,
    mine: LoweredFn,
    theirs: Body,
    lifted: Map<string, string>,
) -> string? {
    let seats = [old_layout(ws, t) for t in theirs.params]
    if [l.spelled() for l in mine.params].join(", ") != [l.spelled() for l in seats].join(", ") {
        return "seats ${[l.spelled() for l in mine.params].join(", ")}, the workspace's ${[l.spelled() for l in seats].join(", ")}"
    }
    let answer = old_layout(ws, theirs.ret)
    if mine.answer.spelled() != answer.spelled() { return "answers ${mine.answer.spelled()}, the workspace's ${answer.spelled()}" }
    let renames = known_symbols(callee_symbols(ws, disk, mine.callees), lifted)
    let ours = numbered(
        [resymbolled(i, (s) -> workspace_symbol(ws, disk, renames, s)) for i in mine.ins],
        mine.params.length,
    )
    let workspace = numbered(theirs.ins, theirs.params.length)
    for at, i in ours.ins {
        if at >= workspace.ins.length { return "instruction ${at} is `${ins_text(i)}`, where the workspace's has ended" }
        if !same_ins(i, workspace.ins[at]) { return "instruction ${at} is `${ins_text(i)}`, the workspace's `${ins_text(workspace.ins[at])}`" }
    }
    if workspace.ins.length > ours.ins.length { return "ends at instruction ${ours.ins.length}, where the workspace's has `${ins_text(workspace.ins[ours.ins.length])}`" }
    for at, r in ours.defined {
        let old = old_layout(ws, theirs.reg_types[workspace.defined[at].index])
        let new = mine.layouts[r.index]
        if new.spelled() != old.spelled() { return "the register instruction ${at} defines is ${new.spelled()}, the workspace's ${old.spelled()}" }
    }
    null
}

/// How the data a fn and its lambdas read differs from what the workspace lays out under the same
/// names, absent when each static holds alike; `lifted` names each lambda's symbol as the workspace's.
fn statics_difference(
    ws: Workspace,
    disk: Disk,
    mine: LoweredFn,
    theirs: List<Static>,
    lifted: Map<string, string>,
) -> string? {
    let renames = known_symbols(
        callee_symbols(ws, disk, mine.callees.concat(flatten([l.callees for l in mine.lifts]))),
        lifted,
    )
    for st in mine.statics {
        let name = workspace_symbol(ws, disk, renames, st.name)
        let old? = theirs.find(it.name == name) else { return "the workspace lays out no static `${name}`" }
        let ours = static_block(
            Static {
                name: name,
                boxes: [box_renamed(b, (s) -> workspace_symbol(ws, disk, renames, s)) for b in st.boxes],
            },
        )
            .join(" ")
        let workspace = static_block(old).join(" ")
        if ours != workspace { return "the static `${name}` is `${ours}`, the workspace's `${workspace}`" }
    }
    null
}

/// `a`'s symbols beside `b`'s, `a`'s first where both name one.
fn known_symbols(a: Map<string, string>, b: Map<string, string>) -> Map<string, string> {
    mut known = b
    for k, v in a { known.set(k, v) }
    known
}

/// A symbol the program layer names, as the workspace's lowering names it: a declared fn's or a lifted
/// lambda's by `renames`, a fn value's data and its wrapper by the code they hold, and a literal's data
/// by its file's own symbol for its site.
fn workspace_symbol(ws: Workspace, disk: Disk, renames: Map<string, string>, s: string) -> string {
    if s.starts_with(FN_DATA) { return FN_DATA + workspace_symbol(ws, disk, renames, s.substring(FN_DATA.length, s.length)) }
    if s.ends_with(WRAPPER) {
        return workspace_symbol(ws, disk, renames, s.substring(0, s.length - WRAPPER.length)) +
            WRAPPER
    }
    let lit = s.index_of(LITERAL_DATA)
    if lit >= 0 {
        return literal_symbol_of(
            ws,
            disk,
            s.substring(0, lit),
            s.substring(lit + LITERAL_DATA.length, s.length),
        ) ?? s
    }
    renames.get(s) ?? s
}

/// The workspace's name for the literal data at `site` of the package's file `spelled`, absent for a
/// file the workspace doesn't know.
fn literal_symbol_of(ws: Workspace, disk: Disk, spelled: string, site: string) -> string? {
    let own = "${disk.name}/"
    if !spelled.starts_with(own) { return null }
    let id? = ws
        .decls
        .known_file_id(disk.on_disk(disk.name, spelled.substring(own.length, spelled.length))) else { return null }
    ws.decls.file_symbol(id, "lit${site}")
}

/// What a fn value's data is named for: the code it holds.
const FN_DATA: string = "fn\$"

/// What a declared fn's wrapper as a value is named for: the fn it calls.
const WRAPPER: string = "\$w"

/// What a literal's data is named for beside its file: its site.
const LITERAL_DATA: string = "\$lit"

/// `b` with each code address it holds named by `named`.
fn box_renamed(b: StaticBox, named: fn(string) -> string) -> StaticBox {
    match b {
        .Slots(cells) -> StaticBox.Slots([slot_renamed(c, named) for c in cells]),
        .Table(keys, values) -> StaticBox.Table(keys, [slot_renamed(c, named) for c in values]),
        .Octets(_) -> b,
    }
}

/// `c` named by `named` where it's a code address, else itself.
fn slot_renamed(c: Slot, named: fn(string) -> string) -> Slot {
    match c { .Code(sym) -> Slot.Code(named(sym)), rest -> c }
}

/// One instruction as the IR's text writes it.
fn ins_text(i: Ins) -> string { body_lines([i]).join(" ") }

/// Each callee's symbol, mapped to the one the workspace's lowering calls it by.
fn callee_symbols(ws: Workspace, disk: Disk, callees: List<CalledFn>) -> Map<string, string> {
    mut renames: Map<string, string> = {}
    for c in callees {
        let id? = ws.decls.known_file_id(disk.on_disk(c.file.package_name, c.file.path_in_package)) else { continue }
        let d = if c.owner == null { ws.visible(id).fn_decl(c.name) } else { method_decl(ws, id, c.owner!, c.name) }
        if d != null { renames.set(c.symbol, ws.decls.symbol(d!)) }
    }
    renames
}

/// The workspace's method `name` of the type `owner` names from the file `id`.
fn method_decl(ws: Workspace, id: FileId, owner: string, name: string) -> DeclId? {
    let t? = ws.visible(id).type_decl(owner) else { return null }
    ws.decls.method(t, name)
}

/// What a register of the workspace's type is to the machine, read off its registry the way the
/// backend reads it: the receipt's one reading of a type the program layer never sees.
fn old_layout(ws: Workspace, ty: TypeId) -> Layout {
    let types = ws.decls.types
    if types.valued_carrier(ty) { return Layout.Tagged(types.counted_mask(ty)) }
    if types.travels_wide(ty) { return Layout.Fields([old_layout(ws, f) for f in types.flat_fields(types.machine_type(ty))]) }
    match types.shape_of(types.machine_type(ty)) {
        .Int or .Error or .TypeName(_, _) or .Var(_, _, _) -> Layout.Word,
        .Void -> Layout.Void,
        .Float -> Layout.Real,
        .Bool -> Layout.Truth,
        .Ptr or .Null -> Layout.Bare,
        .Str -> Layout.Boxed(BoxKind.Text),
        .Bytes -> Layout.Boxed(BoxKind.Bytes),
        .List(_) or .EmptyList -> Layout.Boxed(BoxKind.List),
        .Map(_, _) or .EmptyMap -> Layout.Boxed(BoxKind.Map),
        .Cell(_) -> Layout.Boxed(BoxKind.Cell),
        .Task(_) or .Tasks -> Layout.Boxed(BoxKind.Task),
        .Range -> Layout.Boxed(BoxKind.Range),
        .Struct(_, _) -> Layout.Boxed(BoxKind.Record),
        .Enum(_, _) or .Res(_, _) -> Layout.Boxed(BoxKind.Enum),
        .App(d, _, _) -> match ws.decls.decl(d).kind {
            .Enum or .CollectEnum -> Layout.Boxed(BoxKind.Enum),
            .Record or .Builtin or .Named or .Alias or .Trait or .Syntax or .Default or .Impl or .Main or .Case or .Const or .Collect or .State or .Fn or .Method -> Layout.Boxed(BoxKind.Record),
        },
        .Dyn(_, _) -> Layout.Boxed(BoxKind.Dyn),
        .Fn(_, _, _) -> Layout.Boxed(BoxKind.Closure),
        .Union(_) -> Layout.Boxed(BoxKind.Union),
        .Opt(inner) -> old_nullable(ws, inner),
    }
}

/// What a nullable of the workspace's type `inner` is: the pointer itself, the same registers where
/// a spare tag stands for absence, a one-slot box over a flat record, else a pair.
fn old_nullable(ws: Workspace, inner: TypeId) -> Layout {
    let types = ws.decls.types
    let carried = old_layout(ws, inner)
    if types.seen_shape(inner) is .Opt { return Layout.Maybe(carried) }
    if types.rides_pointer(inner) { return carried }
    if types.is_word_enum(inner) { return Layout.Word }
    if types.is_flat(inner) { return Layout.Boxed(BoxKind.Slot) }
    Layout.Maybe(carried)
}
