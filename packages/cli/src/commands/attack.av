//! `avra attack <feature>` — the red team's MECHANICAL classes,
//! generated from the feature's rule and the model, printed as the
//! `<feature>_adversarial_test.av` the tree commits. A person writes
//! only the SEMANTIC attacks; this is the shape every hand red team
//! found by hand, so the next one starts where they stopped.
use @std.cli.{Subcommand, CliResult, Runnable, ArgDef}
use @std.avrac.language.{avra, attacks, attack_test_source}

type AttackCmd = { }

impl Runnable for AttackCmd {
    fn run(args: CliResult) -> int {
        let name = args.arg("feature")
        let lang = avra()
        // the annotated form (`let feature: LanguageFeature? = …`) breaks
        // self-compilation with 32 F0900s — avra-8sb5.11.117
        let feature = lang.features.find(it.name == name)
        if feature == null {
            eprintln("avra attack: no feature `${name}` — `avra grammar` lists the language")
            return 2
        }
        println(attack_test_source(name, attacks(feature!.gram)))
        0
    }
}

export fn attack_command() -> Subcommand {
    let args = [
        ArgDef { name: "feature", description: "the feature whose rule to attack", required: true, variadic: false },
    ]
    Subcommand { meta: arg_command("attack", "Generate a feature's mechanical adversarial classes", args), body: AttackCmd { } }
}