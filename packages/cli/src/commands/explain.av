//! `avra explain db [<package>]` / `avra explain why <entry>` — the
//! compiler's own durable pack, made visible: `compiler/store/explain.av`
//! holds the logic, this file is CLI wiring and text formatting alone.
use @std.cli.{CliResult, Runnable, command, arg}
use @std.avrac.compiler.{Workspace, build_cache_root, name_parts}
use @std.avrac.compiler.store.{
    Pack,
    Entry,
    pack_at,
    witnessed,
    summarized,
    real_entries,
    WitnessNode,
    Held,
}
use @std.avrac.core.{flatten}
use @std.io.{is_dir}
use @std.path.{joined_path}

type ExplainCmd = {}

impl Runnable for ExplainCmd {
    fn run(args: CliResult) -> int {
        let mode = args.arg("mode")
        when {
            mode == "db" -> explained_db(args.arg("target"))
            mode == "why" -> explained_why(args.arg("target"))
            _ -> {
                eprintln("avra: `explain` takes `db` or `why`, not `${mode}`")
                1
            }
        }
    }
}

fn pack_root(target: string) -> string {
    if target == "" { here() } else { rooted(target) }
}

fn pack_for(ws: Workspace) -> Pack {
    pack_at(joined_path(build_cache_root(ws), "pack.bin"), ws.compiler_id())
}

/// The workspace every recorded edge can be re-derived in: each file
/// the package holds admitted, the way `avra check` opens it.
fn admitted_workspace(root: string) -> Workspace {
    let ws = root_workspace(root)
    for path in ws.all_files(package_dir(root)) { let _ = ws.items(ws.file_id(path)) }
    ws.admit_all()
    ws
}

fn package_dir(root: string) -> string {
    if is_dir(joined_path(root, "src")) { joined_path(root, "src") } else { root }
}

fn family_of(name: string) -> string? { name_parts(name)?.family }

/// A name a person can read and type: its family and its argument's own
/// fields on one line, `Analysis(file · /w/src/b.av)`. A name no family
/// claims shows its own fields the same way.
fn shown(name: string) -> string {
    let parts? = name_parts(name) else { return name.split("\n").join(" · ") }
    "${parts.family}(${parts.arg.split("\n").join(" · ")})"
}

// ── `avra explain db` ──

fn explained_db(target: string) -> int {
    let s = summarized(pack_for(root_workspace(pack_root(target))), family_of)
    println(
        "db: ${s.entries} ${entry_word(s.entries)}, ${s.payload_bytes} payload byte${plural(s.payload_bytes)}",
    )
    for f in s.families {
        println(
            "db:   ${f.family}: ${f.entries} ${entry_word(f.entries)}, ${f.payload_bytes} payload byte${plural(f.payload_bytes)}",
        )
    }
    if s.disk_bytes == 0 {
        println("db: no pack file yet — nothing committed for this package")
    } else {
        println(
            "db: ${s.disk_bytes} byte${plural(s.disk_bytes)} on disk, ${garbage_word(s.disk_bytes, s.live_bytes)}",
        )
    }
    if s.referenced_only > 0 {
        println(
            "db: ${s.referenced_only} further name${plural(s.referenced_only)} referenced as a dependency, not stored here",
        )
        for r in s.referenced { println("db:   ${r.family}: ${r.names} name${plural(r.names)}") }
    }
    0
}

fn plural(n: int) -> string { if n == 1 { "" } else { "s" } }

fn entry_word(n: int) -> string { if n == 1 { "entry" } else { "entries" } }

fn garbage_word(disk: int, live: int) -> string {
    if disk <= live { "${live} live, no garbage" } else { "${live} live, ${disk - live} garbage bytes, compacts on next commit past half" }
}

// ── `avra explain why` ──

/// The entries a typed query names: an exact match on the display form
/// alone when there is one, else every entry whose display form holds
/// the query.
fn matching(entries: List<Entry>, query: string) -> List<Entry> {
    let exact = [e for e in entries if shown(e.name) == query]
    if exact.is_empty() { [e for e in entries if shown(e.name).contains(query)] } else { exact }
}

fn capped(n: int, cap: int) -> int { if n < cap { n } else { cap } }

fn listing(entries: List<Entry>) -> List<string> {
    let head = entries.slice(0, capped(entries.length, 12))
    ["why:   ${shown(e.name)}" for e in head].concat(more_line(entries.length, head.length))
}

fn more_line(total: int, listed: int) -> List<string> {
    if total > listed { ["why:   … and ${total - listed} more"] } else { [] }
}

fn explained_why(query: string) -> int {
    let ws = admitted_workspace(here())
    let pack = pack_for(ws)
    let stored = real_entries(pack)
    let named = if query == "" { stored } else { matching(stored, query) }
    if named.length != 1 {
        eprintln(why_refusal(query, named.length, stored.length))
        for line in listing(named) { eprintln(line) }
        return 1
    }
    let entry = named[0]
    println("why: ${shown(entry.name)}")
    println(
        "why:   fingerprint ${entry.fingerprint}, hash ${entry.hash}, ${entry.payload.length} payload byte${plural(entry.payload.length)}",
    )
    if entry.edges.is_empty() {
        println("why:   no recorded dependencies — an input, or a query that read nothing else")
        return 0
    }
    for line in flatten(
        [witness_lines(
            witnessed(pack, e.name, e.hash, [entry.name], (n: string) -> ws.edge_current_hash(n)),
            1,
        ) for e in entry.edges],
    ) {
        println(line)
    }
    0
}

fn why_refusal(query: string, matched: int, held: int) -> string {
    if query == "" { return "avra: `explain why` needs an entry — this package's pack holds ${holds(held)}" }
    if matched == 0 { return "avra: no entry in this package's pack matches `${query}` — it holds ${holds(held)}" }
    "avra: ${matched} entries match `${query}` — name one exactly:"
}

fn holds(held: int) -> string { if held == 0 { "none yet" } else { "${held}:" } }

fn witness_lines(node: WitnessNode, depth: int) -> List<string> {
    [indented(depth, node)].concat(flatten([witness_lines(c, depth + 1) for c in node.children]))
}

fn indent(depth: int) -> string { ["  " for _k in 0..depth].join("") }

fn indented(depth: int, node: WitnessNode) -> string {
    "why: ${indent(depth)}${held_word(node.held)} ${shown(node.name)}${hash_detail(node)}"
}

fn hash_detail(node: WitnessNode) -> string {
    match node.held {
        .Matches -> " (${node.found_hash})",
        .Stale -> " (recorded ${node.recorded_hash}, now ${node.found_hash} — recomputes)",
        .External or .Cycle -> "",
    }
}

fn held_word(h: Held) -> string {
    match h {
        .Matches -> "held",
        .Stale -> "FAILED",
        .External -> "unchecked —",
        .Cycle -> "CYCLE at",
    }
}

export command explain {
    description: "The compiler's own durable pack, made visible: `db` for its size and shape by family, `why <entry>` for one entry's witness tree"
    arg mode {
        description: "`db` or `why`"
        required: true
    }
    arg target {
        description: "for `db`, a package path (the current one when absent); for `why`, an entry as `Family(argument)` or any part of it that names exactly one"
    }
    run: ExplainCmd {}
}
