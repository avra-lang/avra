//! `avra explain` — what a diagnostic code means, from the
//! assembled registry; and `avra explain process` — the tools the
//! package you stand in declares, each resolved where it stands
//! today, printed before anything runs.
use @std.cli.{Subcommand, CliResult, Runnable, ArgDef}
use @std.avrac.language.{avra, read_manifest, ToolRow}
use @std.avrac.diagnostics.{DiagCode, Diag, new_source_file, render}
use @std.path.{joined_path}
use @std.process.{Tool, tool, tool_from_env, ProcessError}
use @std.errors.{Error}
use @std.io.{println, eprintln, read_text, exists}

type ExplainCmd = { }

impl Runnable for ExplainCmd {
    fn run(args: CliResult) -> int {
        let q = args.arg("code")
        if q == "process" { return explained_process(args.arg("at")) }
        if q.starts_with("@") { return explained_annotation(q.substring(1, q.length)) }
        let hit: DiagCode? = avra().rows.codes.find(it.id == q || it.kind == q)
        if hit == null {
            eprintln("avra: nothing registered under `${q}`")
            return 1
        }
        let c = hit!
        println("${c.id} ${c.kind} — ${c.summary}")
        0
    }
}

/// `avra explain @name` — the annotation fn's signature, which IS
/// its effect (§3.3 of the comptime design). The package is the
/// directory the command stands in, as `explain process` reads its
/// manifest.
fn explained_annotation(name: string) -> int {
    let p = root_program(".")
    if !p.clean() {
        eprintln(p.report())
        return 1
    }
    let sig = p.explain_annotation(name)
    if sig == null {
        eprintln("avra: no fn `${name}` is declared in this package")
        return 1
    }
    println(sig!)
    0
}

/// The package's declared tools, minted as the library mints them, and
/// what a child inherits — the set of doors, before any opens. `at` is
/// the package's directory; the front door stands at the root.
fn explained_process(at: string) -> int {
    let manifest = joined_path(if at.length == 0 { "." } else { at }, "avra.toml")
    if !exists(manifest) {
        eprintln("avra: no ${manifest} — `explain process` reads a package's manifest")
        return 1
    }
    let src = new_source_file(manifest, read_text(manifest) catch "")
    let m = read_manifest(src)
    for d in m.voices { eprintln(render(d, avra().rows.codes, src)) }
    if m.voices.any(refuses(it)) { return 1 }
    if m.tools.is_empty() {
        println("no [process.tools] declared — the script rung: any tool a literal names, an open set")
        return 0
    }
    println("tools this package declares — ${m.tools.length}")
    for row in m.tools { println("  ${row.name}  ${resolved_text(row)}  ${provenance_text(row)}  ${terminator_text(row.terminator)}") }
    println("a child inherits the minimal base: PATH (relative entries stripped) HOME TMPDIR TERM LANG=C LC_ALL=C NO_COLOR=1")
    0
}

/// A manifest voice that refuses — a warning is said and read past.
fn refuses(d: Diag) -> bool {
    d.severity is .Error
}

fn resolved_text(row: ToolRow) -> string {
    match minted(row) {
        .Ok(t) -> t.path,
        .Err(e) -> "NOT FOUND — ${e.describe().message}",
    }
}

/// A row minted as the library would, by its provenance.
fn minted(row: ToolRow) -> Result<Tool, ProcessError> {
    match row.from {
        .Path -> tool(row.name),
        .Env -> tool_from_env(row.var ?? "", row.default ?? row.name),
        .Abs -> tool(row.at_path ?? row.name),
    }
}

fn provenance_text(row: ToolRow) -> string {
    match row.from {
        .Path -> "from the PATH",
        .Env -> "from ${row.var ?? "?"}, else `${row.default ?? row.name}`",
        .Abs -> "at its path",
    }
}

fn terminator_text(t: string?) -> string {
    if t == null { return "options never end — a dashed word needs `after_options`" }
    "options end at `${t!}`"
}

export fn explain_command() -> Subcommand {
    let body: ExplainCmd = ExplainCmd { }
    let args = [ArgDef { name: "code", description: "an F-code, a kind, or `process`", required: true, variadic: false }, ArgDef { name: "at", description: "for `process`: the package directory (the root when absent)", required: false, variadic: false }]
    Subcommand { meta: arg_command("explain", "What a diagnostic code means; `process` — what this package may run", args), body: body }
}
