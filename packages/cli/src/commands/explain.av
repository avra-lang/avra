//! `avra explain` — what a diagnostic code means, from the
//! assembled registry.
use @std.cli.{Subcommand, CliResult, Runnable, ArgDef, result_get_arg}
use @std.avrac.language.{avra}
use @std.avrac.diagnostics.{DiagCode}

type ExplainCmd = { }

impl Runnable for ExplainCmd {
    fn run(self, args: CliResult) -> int {
        let q = result_get_arg(args, "code")
        let hit: DiagCode? = avra().rows.codes.find(it.id == q || it.kind == q)
        if hit == null {
            eprintln("avra: nothing registered under `${q}`")
            return 1
        }
        let c = hit!
        println("${c.id} ${c.kind} — ${c.summary}")
        0
    }
}

export fn explain_command() -> Subcommand {
    let body: ExplainCmd = ExplainCmd { }
    let args = [ArgDef { name: "code", description: "an F-code or a kind", required: true, variadic: false }]
    Subcommand { meta: arg_command("explain", "What a diagnostic code means", args), body: body }
}
