//! `avra explain` — the compiler's own answers, made visible (P7). Three
//! forms, one walk (compiler/cache_walk.av): `--stats` counts every answer a
//! check of the package derives, a target names answers and says what each
//! read and who reads it, and `--why` adds what moved since the kept state
//! and the way down to it. `--stats` and a target derive the program once,
//! with nothing held; only `--why` asks the hold, first. Every form keeps
//! NOTHING, so a second asking answers what the first did. This file is
//! wiring and text alone.
use @std.cli.{CliResult, Runnable, command, arg, flag}
use @std.avrac.compiler.{
    Workspace,
    CacheWalk,
    Trail,
    FileHold,
    PartMoved,
    HeldMismatch,
    Explained,
    Digested,
    FamilyCount,
    Counted,
    Compared,
    Subject,
    Graphed,
    hex_word,
    Phase,
}
use @std.avrac.core.{joined, counted}
use @std.json.{Json, Field, field, to_text}
use @std.path.{relative_path}
use @std.relation.engine.{Key}
use @std.text.{pad_left, pad_right}

type ExplainCmd = {}

/// What `avra explain` was asked: about what, in which form, and the
/// directory a relative target is read from.
export type Asked = { target: string, from: string, stats: bool = false, why: bool = false, json: bool = false, time: bool = false }

/// What an answer or a refusal prints, line by line.
alias Lines = Result<List<string>, List<string>>

impl Runnable for ExplainCmd {
    fn run(args: CliResult) -> int {
        printed(
            explain_answer(
                Asked {
                    target: args.arg("target"),
                    from: here(),
                    stats: args.has_flag("stats"),
                    why: args.has_flag("why"),
                    json: args.has_flag("json"),
                    time: args.has_flag("time"),
                },
            ),
        )
    }
}

/// An answer's lines to stdout and 0, a refusal's to stderr and 1.
fn printed(said: Lines) -> int {
    match said {
        .Ok(lines) -> {
            for line in lines { println(line) }
            0
        },
        .Err(lines) -> {
            for line in lines { eprintln(line) }
            1
        },
    }
}

/// What a form answers: the lines it prints, or the lines of its refusal.
/// Every refusal the words alone decide is spoken before anything is derived.
export fn explain_answer(a: Asked) -> Lines {
    let aim = match aimed("explain", a.target, a.from) {
        .Ok(aim) -> aim,
        .Err(why) -> { return .Err([why]) },
    }
    if a.stats && a.why { return .Err([stats_or_why()]) }
    if a.time && !a.stats { return .Err([time_wants_stats()]) }
    match aim.subject {
        .Package -> if a.stats || a.why { package_answer(a, aim.root) } else { .Err([needs_target()]) },
        .File(_) or .Decl(_) or .Query(_) -> if a.stats { .Err([stats_wants_package(a.target)]) } else { subject_answer(a, aim) },
    }
}

/// A workspace's hold against the kept state, its refusal as lines.
fn walk_of(ws: Workspace) -> Result<CacheWalk, List<string>> {
    match ws.cache_walk() { .Ok(walk) -> walk, .Err(why) -> .Err([why]) }
}

// ── what a target names ──

/// The answers a subject names in the walked graph, or its refusal's lines.
fn answers_named(g: Workspace, subject: Subject) -> Result<List<Key>, List<string>> {
    match g.meant(subject) {
        .Answers(keys) -> keys,
        .FileUnread(unread) -> .Err([file_unread(unread)]),
        .NoDecl(name) -> .Err([no_such_decl(name)]),
        .ManyDecls(name, shown) -> .Err([many_decls(shown.length, name)].concat(["  ${d}" for d in shown])),
        .DeclUnanswered(name) -> .Err([decl_unanswered(name)]),
        .NoFamily(word) -> .Err([no_such_family(word)]),
        .NoAnswer(label) -> .Err([no_such_answer(label)]),
    }
}

// ── the package: `--stats`, `--why` ──

fn package_answer(a: Asked, root: string) -> Lines {
    let ws = root_workspace(root)
    if a.stats { return stats_answer(a, ws.walk_graph()) }
    let walk = walk_of(ws)?
    if a.json { return [to_text(holds_json(walk))] }
    let read = [h for h in walk.holds if !h.held]
    [files_line(walk), attempts_line(walk), moved_line(walk)]
        .concat([line for h in walk.holds for line in text_moved(walk, h)])
        .concat([line for h in read for line in hold_lines(walk, h)])
}

fn files_line(walk: CacheWalk) -> string {
    let read = [h for h in walk.holds if !h.held].length
    "${counted(walk.holds.length, "file")} a check reads, ${walk.holds.length - read} held, ${read} read"
}

/// What judging the hold took: the attempts made, and those that did not stand.
fn attempts_line(walk: CacheWalk) -> string { "${counted(walk.attempts, "attempt")} judged the hold, ${walk.discarded} discarded" }

fn moved_line(walk: CacheWalk) -> string {
    if walk.moved.is_empty() { "no input moved since the kept state" } else { "${counted(walk.moved.length, "input")} moved since the kept state" }
}

/// A moved input's own line: its text's digest then and now.
fn text_moved(walk: CacheWalk, h: FileHold) -> List<string> {
    ["  ${at_root(walk, h.path)}: ${m.part.says()} ${m.was} -> ${m.now}" for m in h.moved if m.part is .Text]
}

/// One file's hold: held or read with why, then the rows it lacks and the
/// parts of its key that moved.
fn hold_lines(walk: CacheWalk, h: FileHold) -> List<string> {
    ["${at_root(walk, h.path)} — ${hold_word(h)}"]
        .concat(["  missing ${m}" for m in h.missing])
        .concat([line for m in h.moved for line in moved_lines(m)])
}

/// One moved part, then the contract lines it lost and gained, a field apart by two spaces.
fn moved_lines(m: PartMoved) -> List<string> {
    ["  moved ${m.part.says()}: ${m.was} -> ${m.now}"]
        .concat(["    ${l.replace("\t", "  ")}" for l in m.lines])
}

fn hold_word(h: FileHold) -> string {
    if h.held { return "held" }
    let why? = h.why else { return "read: no record of its module is kept — it was never built here" }
    "read: ${why.says()}"
}

/// A file as the package's root sees it.
fn at_root(walk: CacheWalk, file: string) -> string { relative_path(walk.root, file) }

// ── `--stats` ──

/// The graph's answers counted family by family — and under `--time`, what
/// deriving them spent.
fn stats_answer(a: Asked, g: Graphed) -> Lines {
    let tally = g.ws.family_counts()
    if a.json { return [to_text(stats_json(a, g.phases, tally))] }
    let rows = [["family", "cells", "edges", "p50", "p99", "longest"]]
        .concat(
            [[f.family, "${f.cells}", "${f.edges}", "${f.p50}", "${f.p99}", "${f.longest}"] for f in tally.families],
        )
        .concat([["total", "${tally.cells}", "${tally.edges}"]])
    let widths = [widest(rows, column) for column in 0..6]
    let timed = if a.time { ["${pad_right("time", widths[0])}  ${joined([ph.shown() for ph in g.phases], ", ")}"] } else { [] }
    [table_row(r, widths) for r in rows].concat(timed)
}

/// The widest cell of one column, among the rows that reach it.
fn widest(rows: List<List<string>>, column: int) -> int {
    mut wide = 0
    for r in rows { if column < r.length && r[column].length > wide { wide = r[column].length } }
    wide
}

/// A row with its name to the left and every count to the right of its column.
fn table_row(cells: List<string>, widths: List<int>) -> string {
    joined(
        [if i == 0 { pad_right(c, widths[i]) } else { pad_left(c, widths[i]) } for i, c in cells],
        "  ",
    )
}

// ── a target: what it read, who reads it, and `--why` ──

/// One answer on the page: itself explained, and under `--why` the way down
/// from it to each moved input.
type Shown = { said: Explained, trails: List<Trail>? }

fn subject_answer(a: Asked, aim: Aim) -> Lines {
    let ws = root_workspace(aim.root)
    if a.why { why_subject(a, aim, ws, walk_of(ws)?) } else { plain_subject(a, aim, ws) }
}

/// A subject's answers, each with what it read and who reads it.
fn plain_subject(a: Asked, aim: Aim, ws: Workspace) -> Lines {
    let g = ws.walk_graph().ws
    let answers = [Shown { said: e, trails: null } for e in g.explained_all(answers_named(g, aim.subject)?)]
    if a.json { return [to_text(page_json([], answers))] }
    [line for s in answers for line in answer_lines(s)]
}

/// A subject's answers under `--why`: its file's hold first, then each
/// answer with the way down from it to every moved input.
fn why_subject(a: Asked, aim: Aim, ws: Workspace, walk: CacheWalk) -> Lines {
    let hold = hold_of(walk, aim.subject)
    let fresh = compared_held(ws, hold)
    let g = ws.walk_graph().ws
    let keys = answers_named(g, aim.subject)?
    let answers = [Shown { said: e, trails: g.trails(keys[i], walk.moved) } for i, e in g.explained_all(keys)]
    let held? = hold else {
        if a.json { return [to_text(page_json([], answers))] }
        return [line for s in answers for line in answer_lines(s)]
    }
    if a.json { return [to_text(page_json(held_json(walk, held, fresh), answers))] }
    hold_lines(walk, held)
        .concat(compared_lines(fresh))
        .concat([line for s in answers for line in answer_lines(s)])
}

/// A held file against a fresh reading, nothing to compare for a file read or
/// for no file — made and let go before the graph is derived.
fn compared_held(ws: Workspace, hold: FileHold?) -> Compared {
    if hold?.held ?? false { ws.held_compared(hold!.path) } else { Compared { odds: [], unread: null } }
}

/// The hold of the file a subject names — none for any other subject.
fn hold_of(walk: CacheWalk, subject: Subject) -> FileHold? {
    match subject {
        .File(asked) -> walk.holds.find(it.path == asked),
        .Package or .Decl(_) or .Query(_) -> null,
    }
}

fn compared_lines(c: Compared) -> List<string> {
    [disagreement_line(m) for m in c.odds]
        .concat(if c.unread == null { [] } else { ["  no fresh reading to compare: ${c.unread!}"] })
}

export fn disagreement_line(m: HeldMismatch) -> string { "  ${m.decl}'s ${m.field}: ${m.held} held, ${m.fresh} fresh" }

fn answer_lines(s: Shown) -> List<string> {
    [cited_line(s.said.answer)]
        .concat(reads_lines(s.said))
        .concat(read_by_lines(s.said))
        .concat(if s.trails == null { [] } else { trail_lines(s.trails!) })
}

fn cited_line(c: Digested) -> string { "${c.label}  ${digest_shown(c.digest)}" }

fn reads_lines(e: Explained) -> List<string> {
    if e.reads.is_empty() { return ["  reads    nothing — it stands always"] }
    ["  reads    ${e.reads.length} directly, ${e.deep} at any depth"]
        .concat(["    ${cited_line(c)}" for c in e.reads])
}

/// Who reads an answer: each direct reader, then the files a check analyses
/// again when it moves.
fn read_by_lines(e: Explained) -> List<string> {
    if e.read_by.is_empty() { return ["  read by  nothing"] }
    ["  read by  ${e.read_by.length} directly, ${e.deep_by} at any depth"]
        .concat(["    ${cited_line(c)}" for c in e.read_by])
        .concat(["  files    ${counted(e.files.length, "file")} a check analyses read it"])
        .concat(["    ${f}" for f in e.files])
}

fn trail_lines(trails: List<Trail>) -> List<string> {
    if trails.is_empty() { return ["  moved    nothing it reads, since the kept state"] }
    [line for t in trails for line in trail_steps(t)]
}

/// One trail: the input, then each answer from this one down, one level deeper per read.
fn trail_steps(t: Trail) -> List<string> {
    ["  moved    ${t.input}, read by way of:"]
        .concat(["    ${step_line(i, s)}" for i, s in t.steps])
}

fn step_line(depth: int, label: string) -> string {
    if depth == 0 { label } else { "${["  " for _k in 0..depth].join("")}reads ${label}" }
}

/// A digest as sixteen hex digits — an answer never digested says so.
fn digest_shown(digest: int?) -> string {
    let d? = digest else { return "undigested" }
    hex_word(d)
}

// ── `--json` ──

fn cited_json(c: Digested) -> Json {
    Json.Obj([field("answer", Json.Str(c.label)), field("digest", digest_json(c.digest))])
}

fn digest_json(digest: int?) -> Json { if digest == null { Json.Null } else { Json.Str(digest_shown(digest)) } }

fn texts_json(texts: List<string>) -> Json { Json.Arr([Json.Str(t) for t in texts]) }

fn shown_json(s: Shown) -> Json {
    Json
        .Obj(
            [
                field("answer", Json.Str(s.said.answer.label)),
                field("digest", digest_json(s.said.answer.digest)),
                field("reads", Json.Arr([cited_json(c) for c in s.said.reads])),
                field("reads_at_any_depth", Json.Int(s.said.deep)),
                field("read_by", Json.Arr([cited_json(c) for c in s.said.read_by])),
                field("read_by_at_any_depth", Json.Int(s.said.deep_by)),
                field("files", texts_json(s.said.files)),
            ]
                .concat(
                    if s.trails == null { [] } else { [field("moved", Json.Arr([trail_json(t) for t in s.trails!]))] },
                ),
        )
}

fn trail_json(t: Trail) -> Json { Json.Obj([field("input", Json.Str(t.input)), field("by_way_of", texts_json(t.steps))]) }

fn hold_json(walk: CacheWalk, h: FileHold) -> Json {
    Json
        .Obj(
            [
                field("file", Json.Str(at_root(walk, h.path))),
                field("held", Json.Bool(h.held)),
                field("why", if h.held { Json.Null } else { Json.Str(hold_word(h)) }),
                field("missing", texts_json(h.missing)),
                field("moved", Json.Arr([part_json(m) for m in h.moved])),
            ],
        )
}

fn part_json(m: PartMoved) -> Json {
    Json
        .Obj(
            [
                field("part", Json.Str(m.part.says())),
                field("was", Json.Str(m.was)),
                field("now", Json.Str(m.now)),
                field("lines", texts_json(m.lines)),
            ],
        )
}

fn mismatch_json(m: HeldMismatch) -> Json {
    Json
        .Obj(
            [
                field("declaration", Json.Str(m.decl)),
                field("field", Json.Str(m.field)),
                field("held", Json.Str(m.held)),
                field("fresh", Json.Str(m.fresh)),
            ],
        )
}

/// A file's hold on the page: the hold, where a fresh reading disagrees, and
/// why none could be made.
fn held_json(walk: CacheWalk, hold: FileHold, fresh: Compared) -> List<Field> {
    [
        field("hold", hold_json(walk, hold)),
        field("disagreements", Json.Arr([mismatch_json(m) for m in fresh.odds])),
        field(
            "no_fresh_reading",
            if fresh.unread == null { Json.Null } else { Json.Str(fresh.unread!) },
        ),
    ]
}

fn page_json(held: List<Field>, answers: List<Shown>) -> Json {
    Json.Obj(held.concat([field("answers", Json.Arr([shown_json(s) for s in answers]))]))
}

fn holds_json(walk: CacheWalk) -> Json {
    Json
        .Obj(
            [
                field("files", Json.Int(walk.holds.length)),
                field("held", Json.Int([h for h in walk.holds if h.held].length)),
                field("moved", texts_json([at_root(walk, p) for p in walk.moved])),
                field("read", Json.Arr([hold_json(walk, h) for h in walk.holds if !h.held])),
                field("attempts", Json.Int(walk.attempts)),
                field("discarded", Json.Int(walk.discarded)),
            ],
        )
}

fn stats_json(a: Asked, phases: List<Phase>, tally: Counted) -> Json {
    let timed = if a.time { [field("time_ns", Json.Obj([field(ph.name, Json.Int(ph.ns)) for ph in phases]))] } else { [] }
    Json
        .Obj(
            [
                field("families", Json.Arr([family_json(f) for f in tally.families])),
                field("cells", Json.Int(tally.cells)),
                field("edges", Json.Int(tally.edges)),
            ]
                .concat(timed),
        )
}

fn family_json(f: FamilyCount) -> Json {
    Json
        .Obj(
            [
                field("family", Json.Str(f.family)),
                field("cells", Json.Int(f.cells)),
                field("edges", Json.Int(f.edges)),
                field("p50", Json.Int(f.p50)),
                field("p99", Json.Int(f.p99)),
                field("longest", Json.Int(f.longest)),
            ],
        )
}

export command explain {
    description: "The compiler's own answers, made visible: `--stats [package]` counts every answer a check derives, family by family; a target — a file, `@name`, or `Family(subject)` — says what its answers read and who reads them; `--why` adds what moved since the kept state and the way down to it, and with no target answers for the whole package. Every form keeps nothing"
    arg target {
        description: "a file, a package's directory, `@name` or `@Owner.name` for a declaration, or an answer as `Family(subject)` — the package the command stands in when absent"
    }
    flag stats { description: "count the package's answers: cells, reads and how long one answer's reads run, per family" }
    flag why { description: "what moved since the kept state: whether a check holds each file and why not, and the way down from an answer to each moved input" }
    flag json { description: "JSON instead of text, every list in the text's order" }
    flag time { description: "with `--stats`, the time each phase of the derivation took — the one row that differs run to run" }
    run: ExplainCmd {}
}

// ── voices ──

fn needs_target() -> string { "avra: `explain` needs a file, `@name` or `Family(subject)` — or `--stats` or `--why` for the whole package" }

fn stats_or_why() -> string { "avra: `explain` takes `--stats` or `--why`, never both — one counts answers, the other says what moved" }

fn time_wants_stats() -> string { "avra: `explain --time` times the derivation `--stats` counts — it goes with `--stats`" }

fn stats_wants_package(target: string) -> string { "avra: `explain --stats` counts a whole package — `${target}` names one thing in it" }

fn file_unread(file: string) -> string { "avra: `explain`: this package's check never reads ${file}" }

fn no_such_decl(name: string) -> string { "avra: `explain`: no declaration is named `${name}` in what this package's check reads" }

fn many_decls(n: int, name: string) -> string { "avra: ${n} declarations are named `${name}` — name one answer exactly, as `Family(subject)`:" }

export fn decl_unanswered(name: string) -> string { "avra: `explain`: `${name}` is declared, and no answer is keyed by it" }

fn no_such_family(word: string) -> string { "avra: `explain`: no family of answers is named `${word}` — `explain --stats` names each one a check derives" }

fn no_such_answer(label: string) -> string { "avra: `explain`: this package's check derives no answer `${label}`" }
