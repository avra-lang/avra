//! `avra build` — compile a program to a native binary: the cached
//! module when these inputs have been built before, else the emitted
//! `.ll` linked with Avra's runtime by clang.
use @std.cli.{CliResult, Runnable, command, option, flag}

type BuildCmd = {}

impl Runnable for BuildCmd {
    fn run(args: CliResult) -> int {
        let code = cached_build(args)
        if code != 0 || !args.has_flag("verify_held") { return code }
        let path? = argued_path(args) else { return 2 }
        verify_held_said(path)
    }
}

export command build {
    description: "Compile a program to a native binary"
    flags: [time, verify_held, wasm_reactor]
    options: [target]
    args: [file]
    run: BuildCmd {}
}

export option target {
    description: "compile for a target triple — `wasm` writes a .wasm"
}

export flag wasm_reactor {
    description: "link a wasm module as a reactor: no `main`, the host calls the program's exported fns"
    aliases: ["--wasm-reactor"]
}
