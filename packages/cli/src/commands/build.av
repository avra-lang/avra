//! `avra build` — compile a program to a native binary: the cached
//! module when these inputs have been built before, else the emitted
//! `.ll` linked with Avra's runtime by clang.
use @std.cli.{CliResult, Runnable, command}

type BuildCmd = {}

impl Runnable for BuildCmd {
    fn run(args: CliResult) -> int { cached_build(args) }
}

export command build {
    description: "Compile a program to a native binary"
    flags: [time]
    args: [file]
    run: BuildCmd {}
}
