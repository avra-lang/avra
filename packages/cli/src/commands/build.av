//! `avra build` — compile a program to a binary for its target (the host,
//! or `--target wasm32-wasip1`'s `.wasm` module): the cached one when these
//! inputs have been built before, else its objects linked with the target's
//! runtime.
use @std.cli.{CliResult, Runnable, command}

type BuildCmd = {}

impl Runnable for BuildCmd {
    fn run(args: CliResult) -> int {
        let code = cached_build(args)
        if code != 0 || !args.has_flag("verify_held") { return code }
        let path? = argued_path(args) else { return 2 }
        verify_held_said(path)
    }
}

export command build {
    description: "Compile a program to a binary for its target"
    flags: [time, verify_held]
    options: [target]
    args: [file]
    run: BuildCmd {}
}
