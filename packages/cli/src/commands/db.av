//! `avra db diff <file> --database <path>` — the program's whole schema, as
//! its own `const shapes: List<Shape>`, against the shapes a database has
//! recorded. The program's declarations are built with a generated entry as
//! its only one: every file's own top-level statements are silenced, so
//! nothing the program does runs. The entry prints the migration plan and
//! exits 1 when it is not empty, so a pipeline can gate on it. The compiler
//! itself carries no database library.
use @std.cli.{CliResult, Runnable, command, arg, option}
use @std.avrac.compiler.{Program}

type DbCmd = {}

impl Runnable for DbCmd {
    fn run(args: CliResult) -> int {
        if args.arg("action") != "diff" {
            eprintln("`avra db` knows one verb: `diff`")
            return 2
        }
        let database = args.option("database")
        if database == "" {
            eprintln("`avra db diff` names the database it compares with: --database <path>")
            return 2
        }
        if database.contains("\"") || database.contains("\\") || database.contains("\$") {
            eprintln("`avra db diff` reads --database as a plain path: no quote, backslash or `\$`")
            return 2
        }
        let file = path_arg(args)
        phased(args, "db diff", (p) -> diffed(p, file, database))
    }
}

/// The program run live with the diff as its only entry: its own top-level
/// statements are silenced, and the entry's, appended to the file, run in their
/// place.
fn diffed(p: Program, file: string, database: string) -> Result<int, string> {
    let source = read_or_die(file)
    let entered = p
        .entered_over(file, [source, DIFF_USES, diff_entry(database)].join("\n"), source.length)
    ended_as(entered.run_live()?)
}

const DIFF_USES: string = "use @std.db.apply.{recorded_shapes as diff_recorded}\nuse @std.db.migrate.{plan_all as diff_plan, report as diff_report}\nuse @std.process.{exit as diff_exit, Exit as DiffExit}\nuse @std.sqlite.{Db as DiffDb}"

fn diff_entry(database: string) -> string {
    [
        "fn diff_main() -> int {",
        "    let db = match DiffDb.open_read(\"${database}\") {",
        "        .Ok(d) -> d,",
        "        .Err(e) -> { return diff_refused(\"cannot open ${database}: \", e.message) },",
        "    }",
        "    let live = match diff_recorded(db) {",
        "        .Ok(s) -> s,",
        "        .Err(e) -> { return diff_refused(\"cannot read the registry of ${database}: \", e.message) },",
        "    }",
        "    let lines = diff_report(diff_plan(shapes, live, []))",
        "    for line in lines { println(line) }",
        "    if lines.is_empty() { 0 } else { 1 }",
        "}",
        "fn diff_refused(what: string, why: string) -> int {",
        "    eprintln(what + why)",
        "    2",
        "}",
        "diff_exit(DiffExit.Code(diff_main()))",
    ]
        .join("\n")
}

export command db {
    description: "The program's schema against a database: `diff` prints the migration plan and exits 1 when it is not empty"
    flags: [time]
    arg action {
        description: "`diff`"
        required: true
    }
    arg file {
        description: "the program's file; it declares `const shapes: List<Shape>`"
        required: true
    }
    option database {
        description: "the database file to compare with"
    }
    run: DbCmd {}
}
