//! `avra db diff <file> --database <path>` — the program's whole schema, as
//! its own `const shapes: List<Shape>`, against the shapes a database has
//! recorded. The program's declarations are built with a generated entry as
//! its only one, laid beside the file in its module: a program runs its
//! entry's statements alone, so nothing the program does runs. The entry prints the migration plan and
//! exits 1 when it is not empty, so a pipeline can gate on it. The compiler
//! itself carries no database library.
use @std.cli.{CliResult, Runnable, command, arg, option}
use @std.avrac.compiler.{avra_fact_definitions, declaring_text}
use @std.io.{make_dirs}
use @std.program.layered_store.{program_store_at}
use @std.program.query_engine.{query_engine}
use @std.path.{dir_of, joined_path}

type DbCmd = {}

impl Runnable for DbCmd {
    fn run(args: CliResult) -> int {
        if args.arg("action") != "diff" {
            eprintln("`avra db` knows one verb: `diff`")
            return 2
        }
        let database = args.option("database")
        if database == "" {
            eprintln("`avra db diff` names the database it compares with: --database <path>")
            return 2
        }
        if database.contains("\"") || database.contains("\\") || database.contains("\$") {
            eprintln("`avra db diff` reads --database as a plain path: no quote, backslash or `\$`")
            return 2
        }
        let file? = argued_path(args) else { return 2 }
        diffed(file, database, timed(args))
    }
}

/// THE PROGRAM BUILT ON THE PROGRAM LAYER WITH THE DIFF AS ITS ONLY ENTRY, AND RUN. Two things are
/// laid over the disk, and nothing is written beside the program's sources: the entry, a file of
/// the command's own beside `file` in `file`'s module — so it reads the module's `shapes` as any
/// file of it does — and each source of the package that runs statements at its top level, as its
/// declarations alone (`declaring_text`), so nothing the program does runs and no file but the
/// entry runs anything. The binary is kept in the package's cache. Its exit is the diff's.
fn diffed(file: string, database: string, timed: bool) -> int {
    let aimed = match program_aimed(file) { .Ok(a) -> a, .Err(code) -> { return code } }
    let base = aimed.disk
    let entry = joined_path(dir_of(aimed.bin), DIFF_ENTRY)
    mut over = declaring_sources(base)
    over.set(base.on_disk(base.name, entry), [DIFF_USES, diff_entry(database)].join("\n") + "\n")
    let disk = base with { over: over }
    disk.entered()
    let kept = joined_path(disk.root, ".avra-cache/db-diff")
    let _ = make_dirs(kept)
    let binary = match disk_built(disk, entry, joined_path(kept, "diff"), timed, null, false, false) {
        .Ok(b) -> b,
        .Err(code) -> { return code },
    }
    match run_binary(binary) { .Ok(exit) -> status_of_exit(exit), .Err(e) -> refused_by_host(e) }
}

/// Each source of the package on `disk` that runs statements at its top level, by where it stands,
/// as its declarations alone.
fn declaring_sources(disk: Disk) -> Map<string, string> {
    let engine = query_engine(
        program_store_at(joined_path(disk.root, ".avra-cache/tapes")),
        avra_fact_definitions(),
    )
    mut over: Map<string, string> = {}
    for p in disk.held(engine) {
        let full = disk.on_disk(disk.name, p)
        let declaring = declaring_text(engine, disk.file_at(p))
        if declaring != text_at(full) ?? "" { over.set(full, declaring) }
    }
    over
}

/// The file the diff's entry is laid over the disk as, beside the program's file.
const DIFF_ENTRY: string = "avra_db_diff_entry.av"

const DIFF_USES: string = "use @std.db.apply.{recorded_shapes as diff_recorded}\nuse @std.db.migrate.{plan_all as diff_plan, report as diff_report}\nuse @std.process.{exit as diff_exit, Exit as DiffExit}\nuse @std.sqlite.{Db as DiffDb}"

fn diff_entry(database: string) -> string {
    [
        "fn diff_main() -> int {",
        "    let db = match DiffDb.open_read(\"${database}\") {",
        "        .Ok(d) -> d,",
        "        .Err(e) -> { return diff_refused(\"cannot open ${database}: \", e.message) },",
        "    }",
        "    let live = match diff_recorded(db) {",
        "        .Ok(s) -> s,",
        "        .Err(e) -> { return diff_refused(\"cannot read the registry of ${database}: \", e.message) },",
        "    }",
        "    let lines = diff_report(diff_plan(shapes, live, []))",
        "    for line in lines { println(line) }",
        "    if lines.is_empty() { 0 } else { 1 }",
        "}",
        "fn diff_refused(what: string, why: string) -> int {",
        "    eprintln(what + why)",
        "    2",
        "}",
        "diff_exit(DiffExit.Code(diff_main()))",
    ]
        .join("\n")
}

export command db {
    description: "The program's schema against a database: `diff` prints the migration plan and exits 1 when it is not empty"
    flags: [time]
    arg action {
        description: "`diff`"
        required: true
    }
    arg file {
        description: "the program's file; it declares `const shapes: List<Shape>`"
        required: true
    }
    option database {
        description: "the database file to compare with"
    }
    run: DbCmd {}
}
