//! `avra check` — report everything wrong with a source file, or
//! with every file of a package root.
use @std.cli.{Subcommand, CliResult, Runnable}
use @std.avrac.language.{Program}

type CheckCmd = { }

impl Runnable for CheckCmd {
    fn run(args: CliResult) -> int {
        on_program(args, (p: Program) -> {
            let t0 = avra_now_ns()
            let out = p.check()
            if timed(args) { eprintln(timings(p, "lower", avra_now_ns() - t0)) }
            match out {
                .Ok(warned) -> {
                    if warned != "" { println(warned) }
                    0
                }
                .Err(report) -> {
                    println(report)
                    1
                }
            }
        })
    }
}

export fn check_command() -> Subcommand {
    let body: CheckCmd = CheckCmd { }
    Subcommand { meta: file_command("check", "Report everything wrong with a source file or a package root"), body: body }
}
