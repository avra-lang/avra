//! `avra check` — everything wrong with a source file, or with every file
//! of a package root. The program is DERIVED as a build derives it, so a
//! file the store stands in for is not read and still speaks its warnings.
use @std.cli.{Subcommand, CliResult, Runnable}
use @std.avrac.compiler.{Checked}
use @std.io.{exists}

type CheckCmd = { }

impl Runnable for CheckCmd {
    fn run(args: CliResult) -> int {
        let path = path_arg(args)
        if !exists(path) {
            no_such_file(path)
            return 2
        }
        mut ws = build_workspace(path)
        match ws.checked(build_entry(ws, path)) {
            .Ok(c) -> said(args, c),
            .Err(report) -> {
                println(report)
                1
            },
        }
    }
}

/// A clean program's warnings, printed; exit 0.
fn said(args: CliResult, c: Checked) -> int {
    if !c.warnings.is_empty() { println(c.warnings) }
    if timed(args) { eprintln(if c.reused { "time: check · cache hit" } else { "time: ${c.timed}" }) }
    0
}

export fn check_command() -> Subcommand {
    Subcommand { meta: file_command("check", "Report everything wrong with a source file or a package root"), body: CheckCmd { } }
}
