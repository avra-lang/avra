//! `avra check` — report everything wrong with a source file.
use @std.cli.{Subcommand, CliResult, Runnable}
use @std.avrac.language.{avra}
use @std.avrac.diagnostics.{SourceFile}

type CheckCmd = { }

impl Runnable for CheckCmd {
    fn run(self, args: CliResult) -> int {
        let src: SourceFile? = source_arg(args)
        if src == null { return 2 }
        let out = avra().check(src!)
        if out != "" {
            println(out)
            return 1
        }
        0
    }
}

export fn check_command() -> Subcommand {
    let body: CheckCmd = CheckCmd { }
    Subcommand { meta: file_command("check", "Report everything wrong with a source file"), body: body }
}
