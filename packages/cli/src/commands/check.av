//! `avra check` — everything wrong with a source file, or with every file
//! of a package root. The program is DERIVED as a build derives it, so a
//! file the store stands in for is not read and still speaks its warnings.
//! `--baseline <file>` turns the rule findings (warnings) into a ratchet:
//! a site the file does not list refuses the check, and `--baseline_accept`
//! prunes it down to sites still found — never grows it (idiom_baseline.av).
use @std.cli.{CliResult, Runnable, command, flag, option}
use @std.io.{write_text}
use @std.path.{relative_path, under_dir}
use @std.avrac.compiler.{Checked}

type CheckCmd = {}

impl Runnable for CheckCmd {
    fn run(args: CliResult) -> int {
        let path? = slotted_path(args) else { return 2 }
        let base = match checked_at(path) {
            .Ok(c) -> said(args, path, c),
            .Err(report) -> {
                println(report)
                1
            },
        }
        if base != 0 || !args.has_flag("verify_held") { return base }
        verify_held_said(path)
    }
}

/// A clean program's warnings, printed; exit 0 — unless `--baseline`
/// asks for the ratchet instead.
fn said(args: CliResult, path: string, c: Checked) -> int {
    let baseline = args.option("baseline")
    if args.has_flag("baseline_accept") { return accepted(path, baseline, c) }
    if !c.licenses.is_empty() { return refused_licenses(rendered_licenses(c.licenses)) }
    if baseline != "" {
        let bad = loaded_baseline(baseline).news(c.findings)
        if !bad.is_empty() { return refused_sites(bad) }
    }
    if !c.warnings.is_empty() { println(c.warnings) }
    if timed(args) { eprintln(if c.reused { "time: check · cache hit" } else { "time: ${c.timed}" }) }
    0
}

/// `Checked.licenses`'s own lines (`file\tline\tid`,
/// compiler/licenses.av) rendered against THIS caller's directory —
/// never cached pre-rendered, since a warm answer may be read back
/// from a different directory than the one that minted it.
fn rendered_licenses(raw: string) -> List<string> {
    [rendered_license(line) for line in raw.split("\n") if line != ""]
}

fn rendered_license(line: string) -> string {
    let parts = line.split("\t")
    "${relative_path(here(), parts[0])}:${parts[1]}: `// LICENSED ${parts[2]}` names no rule `avra rules` lists"
}

/// A stale `// LICENSED` id refuses unconditionally, baseline or not
/// — it is never idiom debt to ratchet, it is a claim nothing backs
/// (compiler/licenses.av finds them; `Checked.licenses` carries them).
fn refused_licenses(stale: List<string>) -> int {
    println("licenses: ${stale.length} stale `// LICENSED` id(s):")
    for s in stale { println("  ${s}") }
    1
}

/// `--baseline_accept`'s whole verb: prune, write, report — exit 0
/// whatever it kept, since pruning never fails the gate on its own.
/// `c` is the SAME checked answer `said` already holds for `path` —
/// the ratchet's "does it still fire" reads that check's own `Finding`
/// rows, never a second derivation that could disagree (a bare
/// `root_program` once answered `unused_import` wrong: its own analysis
/// skips the cross-file References a full check populates).
///
/// REACHED IS `path`'S OWN FILES, NEVER EVERY FILE ITS PROGRAM
/// ANALYZED: `root_program(path).files` also holds every dependency
/// `path` reaches — `packages/cli` alone pulls in `@std/grammar` — and
/// a fix to one of THIS package's files can never make a dependency's
/// own finding disappear. Counting a dependency file as REACHED would
/// read its silence as "stopped firing" and drop another package's
/// own accepted row out from under it; narrowed to files under `path`
/// itself, a dependency is simply never asked.
export fn accepted(path: string, baseline: string, c: Checked) -> int {
    // `path` ARRIVES ABSOLUTE (`argued_path` roots every path argument
    // there); a reached file's own key is `here()`-relative
    // (`sites_of`'s convention, idiom_baseline.av) — the same currency
    // on both sides, or an absolute `path` never matches a relative
    // `f` and every file reads as outside the package.
    let own = relative_path(here(), path)
    let prog = c.program ?? root_program(path)
    let reached = [f for f in [relative_path(here(), a.view.source.file) for a in prog.files] if f == own || under_dir(f, own)]
    let kept = loaded_baseline(baseline)
        .pruned(prog.ws, keyed(reached), keyed(fresh_keys(c.findings)))
    let _ = write_text(baseline, baseline_header + joined_lines(kept))
    println("baseline: ${kept.length} site(s) kept")
    0
}

fn joined_lines(lines: List<string>) -> string {
    if lines.is_empty() { "" } else { lines.join("\n") + "\n" }
}

/// A new site is a REFUSAL, the same shape `make idioms` always gave:
/// named, with what it names, never silently absorbed.
fn refused_sites(bad: List<Site>) -> int {
    println("idioms: ${bad.length} NEW violation(s) — the baseline never grows:")
    for s in bad { println("  ${s.file}\t[${s.kind}]\t${s.text}") }
    1
}

export flag baseline_accept {
    description: "prune the idiom baseline to sites still found — never adds one"
    aliases: ["--baseline-accept"]
}
export option baseline {
    description: "an idiom baseline file: refuse any rule finding it does not already list"
}

export command check {
    description: "Report everything wrong with a source file or a package root"
    flags: [time, baseline_accept, verify_held]
    options: [baseline]
    args: [file]
    run: CheckCmd {}
}
