//! `avra cache` / `cache why <entry>` / `dependents <name>` / `changed <entry>` /
//! `held [<file>]` — the compiler's own durable cache, made visible. `held`
//! reads the hold's kept parts; the other modes refuse until the lazy walk
//! answers them, never an empty answer from a pack nothing writes.
use @std.cli.{CliResult, Runnable, command, arg}
use @std.avrac.compiler.{shown_name, FileHold, PartMoved, HeldMismatch, Want}
use @std.path.{relative_path}

type CacheCmd = {}

/// What `avra cache` was asked: the pack's summary, or one of its questions.
export enum CacheMode { Summary, Why, Dependents, Changed, Held }

/// The mode a word names — the summary when there is none, and nothing for
/// a word no mode answers to.
export fn cache_mode(word: string) -> CacheMode? {
    match word {
        "" -> CacheMode.Summary,
        "why" -> CacheMode.Why,
        "dependents" -> CacheMode.Dependents,
        "changed" -> CacheMode.Changed,
        "held" -> CacheMode.Held,
        _ -> null,
    }
}

impl Runnable for CacheCmd {
    fn run(args: CliResult) -> int {
        let target = args.arg("target")
        let mode? = cache_mode(args.arg("mode")) else {
            eprintln(unknown_mode(args.arg("mode")))
            return 1
        }
        match mode {
            .Summary or .Why or .Dependents or .Changed -> {
                eprintln(unwalked(mode))
                1
            },
            .Held -> explained_held(target),
        }
    }
}

fn unknown_mode(word: string) -> string {
    "avra: `cache` takes no mode for the summary, or `why`, `dependents`, `changed` or `held` — not `${word}`"
}

// ── naming a query: shared by `why` and `dependents` ──

fn plural(n: int) -> string { if n == 1 { "" } else { "s" } }

fn capped(n: int, cap: int) -> int { if n < cap { n } else { cap } }

/// The names a refused query still lets a person choose from, at most
/// twenty, each on its own line under `prefix`.
fn listing(prefix: string, names: List<string>) -> List<string> {
    let head = names.slice(0, capped(names.length, 20))
    ["${prefix}${shown_name(n)}" for n in head].concat(more_line(prefix, names.length, head.length))
}

fn more_line(prefix: string, total: int, listed: int) -> List<string> {
    if total > listed { ["${prefix}… and ${total - listed} more"] } else { [] }
}

/// Why a query did not name exactly one thing: `mode` is the verb asked,
/// `noun` what it wants, `total` how many names the pack could answer with.
fn refusal(mode: string, noun: string, query: string, matched: int, total: int) -> string {
    if query == "" { return "avra: `cache ${mode}` needs ${noun} — this package's pack holds ${holds(total)}" }
    if matched == 0 { return "avra: nothing in this package's pack matches `${query}` — it holds ${holds(total)}" }
    "avra: ${matched} match `${query}` — name one exactly:"
}

fn holds(held: int) -> string { if held == 0 { "none yet" } else { "${held}:" } }

// ── `avra cache held` ──

fn explained_held(query: string) -> int {
    let root = here()
    let rows = match root_workspace(root).hold_report(Want.Diagnostics) {
        .Ok(found) -> found,
        .Err(why) -> {
            eprintln(why)
            return 1
        },
    }
    if query == "" { return held_summary(root, rows) }
    let named = [h for h in rows if relative_path(root, h.path).contains(query)]
    if named.length != 1 {
        eprintln(refusal("held", "a file", query, named.length, rows.length))
        for line in listing("held:   ", [relative_path(root, h.path) for h in named]) { eprintln(line) }
        return 1
    }
    for line in hold_lines(root, named[0]) { println(line) }
    if named[0].held { for line in disagreements(root, named[0].path) { println(line) } }
    0
}

/// Where a held file's declarations read differently from a fresh reading —
/// `check --verify-held`'s comparison, for this one file.
fn disagreements(root: string, path: string) -> List<string> {
    match root_workspace(root).verify_held(null) {
        .Ok(v) -> [disagreement_line(m) for m in v.mismatches if m.file == path],
        .Err(why) -> ["held:   no fresh reading to compare: ${why}"],
    }
}

export fn disagreement_line(m: HeldMismatch) -> string { "held:   ${m.decl}'s ${m.field}: ${m.held} held, ${m.fresh} fresh" }

/// Every file's hold, counted, and each read one with why.
fn held_summary(root: string, rows: List<FileHold>) -> int {
    let read = [h for h in rows if !h.held]
    println(
        "held: ${rows.length} file${plural(rows.length)} a check reads, ${rows.length - read.length} held, ${read.length} read",
    )
    for h in read { for line in hold_lines(root, h) { println(line) } }
    0
}

fn hold_lines(root: string, h: FileHold) -> List<string> {
    let head = "held: ${relative_path(root, h.path)} — ${hold_word(h)}"
    [head]
        .concat(["held:   missing ${m}" for m in h.missing])
        .concat([line for m in h.moved for line in moved_lines(m)])
}

/// One moved part, then the contract lines it lost and gained, a field apart by two spaces.
fn moved_lines(m: PartMoved) -> List<string> {
    ["held:   moved ${m.part}: ${m.was} -> ${m.now}"]
        .concat(["held:     ${l.replace("\t", "  ")}" for l in m.lines])
}

fn hold_word(h: FileHold) -> string {
    if h.held { return "held" }
    let why? = h.why else { return "read: no record of its module is kept — it was never built here" }
    "read: ${why.says()}"
}

export command cache {
    description: "The compiler's durable cache, made visible: with no mode, its size and shape by family; `why <entry>` for one entry's witness tree, `dependents <name>` for what a change to a name would recompute, `changed <entry>` for what moved under it down to the rows that moved, `held [<file>]` for whether a check holds each file and why not"
    arg mode {
        description: "none for the summary, or `why`, `dependents`, `changed` or `held`"
    }
    arg target {
        description: "for `why`, `dependents` and `changed`, a name as `Family(argument)` or any part of it that names exactly one; for `held`, part of a file's path (every read file when absent)"
    }
    run: CacheCmd {}
}

// ── voices ──

/// A mode the lazy walk does not answer yet.
fn unwalked(mode: CacheMode) -> string {
    "avra: `avra ${mode_words(mode)}` is being rebuilt as a lazy walk — not answered yet"
}

fn mode_words(mode: CacheMode) -> string {
    match mode {
        .Summary -> "cache",
        .Why -> "cache why",
        .Dependents -> "cache dependents",
        .Changed -> "cache changed",
        .Held -> "cache held",
    }
}
