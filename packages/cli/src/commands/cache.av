//! `avra cache` / `cache why <entry>` / `dependents <name>` / `changed <entry>` /
//! `held [<file>]` — the compiler's own durable cache, made visible:
//! `compiler/store/explain.av` and `compiler/explain_names.av` hold the logic,
//! this file is CLI wiring and text formatting alone.
use @std.cli.{CliResult, Runnable, command, arg}
use @std.avrac.compiler.{
    Workspace,
    build_cache_root,
    key_family,
    shown_name,
    matching_names,
    FileHold,
    PartMoved,
    HeldMismatch,
    Want,
}
use @std.avrac.compiler.store.{
    Pack,
    pack_at,
    witnessed,
    summarized,
    real_entries,
    dependents,
    family_groups,
    WitnessNode,
    Held,
    Change,
    changed,
    moved_leaves,
}
use @std.avrac.core.{flatten}
use @std.io.{is_dir}
use @std.path.{joined_path, relative_path}

type CacheCmd = {}

/// What `avra cache` was asked: the pack's summary, or one of its questions.
export enum CacheMode { Summary, Why, Dependents, Changed, Held }

/// The mode a word names — the summary when there is none, and nothing for
/// a word no mode answers to.
export fn cache_mode(word: string) -> CacheMode? {
    match word {
        "" -> CacheMode.Summary,
        "why" -> CacheMode.Why,
        "dependents" -> CacheMode.Dependents,
        "changed" -> CacheMode.Changed,
        "held" -> CacheMode.Held,
        _ -> null,
    }
}

impl Runnable for CacheCmd {
    fn run(args: CliResult) -> int {
        let target = args.arg("target")
        let mode? = cache_mode(args.arg("mode")) else {
            eprintln(unknown_mode(args.arg("mode")))
            return 1
        }
        match mode {
            .Summary -> summarized_pack(),
            .Why -> explained_why(target),
            .Dependents -> explained_dependents(target),
            .Changed -> explained_changed(target),
            .Held -> explained_held(target),
        }
    }
}

fn unknown_mode(word: string) -> string {
    "avra: `cache` takes no mode for the summary, or `why`, `dependents`, `changed` or `held` — not `${word}`"
}

fn pack_for(ws: Workspace) -> Pack {
    pack_at(joined_path(build_cache_root(ws), "pack.bin"), ws.compiler_id())
}

/// The workspace every recorded edge can be re-derived in: each file
/// the package holds admitted, the way `avra check` opens it.
fn admitted_workspace(root: string) -> Workspace {
    let ws = root_workspace(root)
    for path in ws.all_files(package_dir(root)) { let _ = ws.items(ws.file_id(path)) }
    ws.admit_all()
    ws
}

fn package_dir(root: string) -> string {
    if is_dir(joined_path(root, "src")) { joined_path(root, "src") } else { root }
}

// ── `avra cache` ──

fn summarized_pack() -> int {
    let s = summarized(pack_for(root_workspace(here())), key_family)
    println(
        "db: ${s.entries} ${entry_word(s.entries)}, ${s.payload_bytes} payload byte${plural(s.payload_bytes)}",
    )
    for f in s.families {
        println(
            "db:   ${f.family}: ${f.entries} ${entry_word(f.entries)}, ${f.payload_bytes} payload byte${plural(f.payload_bytes)}",
        )
    }
    if s.disk_bytes == 0 {
        println("db: no pack file yet — nothing committed for this package")
    } else {
        println(
            "db: ${s.disk_bytes} byte${plural(s.disk_bytes)} on disk, ${garbage_word(s.disk_bytes, s.live_bytes)}",
        )
    }
    if s.referenced_only > 0 {
        println(
            "db: ${s.referenced_only} further name${plural(s.referenced_only)} referenced as a dependency, not stored here",
        )
        for r in s.referenced { println("db:   ${r.family}: ${r.names} name${plural(r.names)}") }
    }
    0
}

fn plural(n: int) -> string { if n == 1 { "" } else { "s" } }

fn entry_word(n: int) -> string { if n == 1 { "entry" } else { "entries" } }

fn garbage_word(disk: int, live: int) -> string {
    if disk <= live { "${live} live, no garbage" } else { "${live} live, ${disk - live} garbage bytes, compacts on next commit past half" }
}

// ── naming a query: shared by `why` and `dependents` ──

fn capped(n: int, cap: int) -> int { if n < cap { n } else { cap } }

/// The names a refused query still lets a person choose from, at most
/// twenty, each on its own line under `prefix`.
fn listing(prefix: string, names: List<string>) -> List<string> {
    let head = names.slice(0, capped(names.length, 20))
    ["${prefix}${shown_name(n)}" for n in head].concat(more_line(prefix, names.length, head.length))
}

fn more_line(prefix: string, total: int, listed: int) -> List<string> {
    if total > listed { ["${prefix}… and ${total - listed} more"] } else { [] }
}

/// Why a query did not name exactly one thing: `mode` is the verb asked,
/// `noun` what it wants, `total` how many names the pack could answer with.
fn refusal(mode: string, noun: string, query: string, matched: int, total: int) -> string {
    if query == "" { return "avra: `cache ${mode}` needs ${noun} — this package's pack holds ${holds(total)}" }
    if matched == 0 { return "avra: nothing in this package's pack matches `${query}` — it holds ${holds(total)}" }
    "avra: ${matched} match `${query}` — name one exactly:"
}

fn holds(held: int) -> string { if held == 0 { "none yet" } else { "${held}:" } }

// ── `avra cache why` ──

fn explained_why(query: string) -> int {
    let ws = admitted_workspace(here())
    let pack = pack_for(ws)
    let stored = [e.name for e in real_entries(pack)]
    let named = if query == "" { stored } else { matching_names(stored, query) }
    if named.length != 1 {
        eprintln(refusal("why", "an entry", query, named.length, stored.length))
        for line in listing("why:   ", named) { eprintln(line) }
        return 1
    }
    let entry = pack.get(named[0])!
    println("why: ${shown_name(entry.name)}")
    println(
        "why:   fingerprint ${entry.fingerprint}, hash ${entry.hash}, ${entry.payload.length} payload byte${plural(entry.payload.length)}",
    )
    if entry.edges.is_empty() {
        println("why:   no recorded dependencies — an input, or a query that read nothing else")
        return 0
    }
    for line in flatten(
        [witness_lines(
            witnessed(pack, e.name, e.hash, [entry.name], (n: string) -> ws.edge_current_hash(n)),
            1,
        ) for e in entry.edges],
    ) {
        println(line)
    }
    0
}

fn witness_lines(node: WitnessNode, depth: int) -> List<string> {
    [indented(depth, node)].concat(flatten([witness_lines(c, depth + 1) for c in node.children]))
}

fn indent(depth: int) -> string { ["  " for _k in 0..depth].join("") }

fn indented(depth: int, node: WitnessNode) -> string {
    "why: ${indent(depth)}${held_word(node.held)} ${shown_name(node.name)}${hash_detail(node)}"
}

fn hash_detail(node: WitnessNode) -> string {
    match node.held {
        .Matches -> " (${node.found_hash})",
        .Stale -> " (recorded ${node.recorded_hash}, now ${node.found_hash} — recomputes)",
        .External or .Cycle -> "",
    }
}

fn held_word(h: Held) -> string {
    match h {
        .Matches -> "held",
        .Stale -> "FAILED",
        .External -> "unchecked —",
        .Cycle -> "CYCLE at",
    }
}

// ── `avra cache changed` ──

fn explained_changed(query: string) -> int {
    let ws = admitted_workspace(here())
    let pack = pack_for(ws)
    let stored = [e.name for e in real_entries(pack)]
    let named = if query == "" { stored } else { matching_names(stored, query) }
    if named.length != 1 {
        eprintln(refusal("changed", "an entry", query, named.length, stored.length))
        for line in listing("changed:   ", named) { eprintln(line) }
        return 1
    }
    let found = changed(pack, named[0], [], (n: string) -> ws.edge_current_hash(n))
    println("changed: ${shown_name(named[0])}")
    let leaf? = moved_leaves(found).first() else {
        println("changed:   nothing it read has moved — it would be reused")
        return 0
    }
    println(
        "changed:   first moved: ${shown_name(leaf.name)} (recorded ${leaf.recorded_hash}, now ${leaf.found_hash})",
    )
    for line in flatten([change_lines(c, 1) for c in found]) { println(line) }
    0
}

fn change_lines(c: Change, depth: int) -> List<string> {
    [change_line(c, depth)].concat(flatten([change_lines(u, depth + 1) for u in c.under]))
}

fn change_line(c: Change, depth: int) -> string {
    let mark = if c.under.is_empty() { "moved" } else { "via" }
    "changed: ${indent(depth)}${mark} ${shown_name(c.name)} (${c.recorded_hash} -> ${c.found_hash})"
}

// ── `avra cache held` ──

fn explained_held(query: string) -> int {
    let root = here()
    let rows = match root_workspace(root).hold_report(Want.Diagnostics) {
        .Ok(found) -> found,
        .Err(why) -> {
            eprintln(why)
            return 1
        },
    }
    if query == "" { return held_summary(root, rows) }
    let named = [h for h in rows if relative_path(root, h.path).contains(query)]
    if named.length != 1 {
        eprintln(refusal("held", "a file", query, named.length, rows.length))
        for line in listing("held:   ", [relative_path(root, h.path) for h in named]) { eprintln(line) }
        return 1
    }
    for line in hold_lines(root, named[0]) { println(line) }
    if named[0].held { for line in disagreements(root, named[0].path) { println(line) } }
    0
}

/// Where a held file's declarations read differently from a fresh reading —
/// `check --verify-held`'s comparison, for this one file.
fn disagreements(root: string, path: string) -> List<string> {
    match root_workspace(root).verify_held(null) {
        .Ok(v) -> [disagreement_line(m) for m in v.mismatches if m.file == path],
        .Err(why) -> ["held:   no fresh reading to compare: ${why}"],
    }
}

export fn disagreement_line(m: HeldMismatch) -> string { "held:   ${m.decl}'s ${m.field}: ${m.held} held, ${m.fresh} fresh" }

/// Every file's hold, counted, and each read one with why.
fn held_summary(root: string, rows: List<FileHold>) -> int {
    let read = [h for h in rows if !h.held]
    println(
        "held: ${rows.length} file${plural(rows.length)} a check reads, ${rows.length - read.length} held, ${read.length} read",
    )
    for h in read { for line in hold_lines(root, h) { println(line) } }
    0
}

fn hold_lines(root: string, h: FileHold) -> List<string> {
    let head = "held: ${relative_path(root, h.path)} — ${hold_word(h)}"
    [head]
        .concat(["held:   missing ${m}" for m in h.missing])
        .concat([line for m in h.moved for line in moved_lines(m)])
}

/// One moved part, then the contract lines it lost and gained, a field apart by two spaces.
fn moved_lines(m: PartMoved) -> List<string> {
    ["held:   moved ${m.part}: ${m.was} -> ${m.now}"]
        .concat(["held:     ${l.replace("\t", "  ")}" for l in m.lines])
}

fn hold_word(h: FileHold) -> string {
    if h.held { return "held" }
    let why? = h.why else { return "read: no record of its module is kept — it was never built here" }
    "read: ${why.says()}"
}

// ── `avra cache dependents` ──

fn explained_dependents(query: string) -> int {
    let pack = pack_for(root_workspace(here()))
    let known = pack.names()
    let named = if query == "" { known } else { matching_names(known, query) }
    if named.length != 1 {
        eprintln(refusal("dependents", "a name", query, named.length, known.length))
        for line in listing("dependents:   ", named) { eprintln(line) }
        return 1
    }
    let found = dependents(pack, named[0])
    println("dependents: ${shown_name(named[0])}")
    if found.is_empty() {
        println("dependents:   nothing in this pack depends on it")
        return 0
    }
    println("dependents:   ${found.length} ${entry_word(found.length)} recompute if it changes")
    for g in family_groups([e.name for e in found], key_family) {
        println("dependents:   ${g.family}: ${g.names.length}")
        for line in listing("dependents:     ", g.names) { println(line) }
    }
    0
}

export command cache {
    description: "The compiler's durable cache, made visible: with no mode, its size and shape by family; `why <entry>` for one entry's witness tree, `dependents <name>` for what a change to a name would recompute, `changed <entry>` for what moved under it down to the rows that moved, `held [<file>]` for whether a check holds each file and why not"
    arg mode {
        description: "none for the summary, or `why`, `dependents`, `changed` or `held`"
    }
    arg target {
        description: "for `why`, `dependents` and `changed`, a name as `Family(argument)` or any part of it that names exactly one; for `held`, part of a file's path (every read file when absent)"
    }
    run: CacheCmd {}
}
