//! `avra cache` — the older words for `avra explain`. Each mode IS one of
//! explain's forms and prints what that form prints: no mode, `changed` and
//! `held` are `explain --why`; `why <target>` and `held <file>` are `explain
//! <target> --why`; `dependents <target>` is `explain <target>`.
use @std.cli.{CliResult, Runnable, command, arg}

type CacheCmd = {}

/// What `avra cache` was asked: the summary, or one of its questions.
export enum CacheMode { Summary, Why, Dependents, Changed, Held }

/// The mode a word names — the summary when there is none, and nothing for
/// a word no mode answers to.
export fn cache_mode(word: string) -> CacheMode? {
    match word {
        "" -> CacheMode.Summary,
        "why" -> CacheMode.Why,
        "dependents" -> CacheMode.Dependents,
        "changed" -> CacheMode.Changed,
        "held" -> CacheMode.Held,
        _ -> null,
    }
}

impl Runnable for CacheCmd {
    fn run(args: CliResult) -> int {
        let mode? = cache_mode(args.arg("mode")) else {
            eprintln(unknown_mode(args.arg("mode")))
            return 1
        }
        printed(cache_answer(mode, here(), args.arg("target")))
    }
}

/// What a mode answers for the package at `root`: its form of `explain`,
/// asked there.
export fn cache_answer(mode: CacheMode, root: string, target: string) -> Result<
    List<string>,
    List<string>,
> {
    match mode {
        .Summary or .Changed -> if target == "" { why_asked(root, "") } else { .Err([takes_no_target(target)]) },
        .Why -> if target == "" { .Err([mode_needs_target("why")]) } else { why_asked(root, target) },
        .Held -> why_asked(root, target),
        .Dependents -> if target == "" { .Err([mode_needs_target("dependents")]) } else { explain_answer(Asked { target: target, from: root }) },
    }
}

/// `explain --why` of a target — of the package when there is none.
fn why_asked(root: string, target: string) -> Result<List<string>, List<string>> {
    explain_answer(Asked { target: target, from: root, why: true })
}

export command cache {
    description: "The older words for `avra explain`: no mode, `changed` and `held` are `explain --why`; `why <target>` and `held <file>` are `explain <target> --why`; `dependents <target>` is `explain <target>`"
    arg mode {
        description: "none, or `why`, `dependents`, `changed` or `held`"
    }
    arg target {
        description: "what `avra explain` takes: a file, `@name`, or an answer as `Family(subject)`"
    }
    run: CacheCmd {}
}

// ── voices ──

fn unknown_mode(word: string) -> string {
    "avra: `cache` takes no mode, or `why`, `dependents`, `changed` or `held` — not `${word}`"
}

fn mode_needs_target(mode: string) -> string { "avra: `cache ${mode}` needs a file, `@name` or `Family(subject)`" }

fn takes_no_target(target: string) -> string { "avra: this mode of `cache` answers for the whole package, not `${target}`" }
