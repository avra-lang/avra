//! `avra cache` — the program layer's store of the package the command stands
//! in, its own verbs. The store is a directory of immutable packs, each the
//! answers one compiler learned (`@std/program`'s disk_store): `clean`
//! compacts them — every pack as one for each compiler the store keeps,
//! holding only what that compiler's frontier still reaches, the packs of a
//! compiler past the ones kept let go; `log` lists the packs, oldest first;
//! `show <n>` names the questions one pack answers; `families [<store>]` weighs
//! what each query keeps there, this package's store or the one named;
//! `dependents <package>` works out and keeps what a program over that package
//! reads of it; `check [<store>]` holds what the store keeps to what every write
//! promises (`@std/program`'s store_check), and fails naming each fault.
use @std.cli.{CliResult, Runnable, command, arg}
use @std.path.{joined_path}
use @std.program.disk_store.{
    FamilyWeight,
    PackListed,
    disk_store_at,
    heavier,
    pack_families,
    pack_questions,
    pack_reads_repeated,
    packs_listed,
}
use @std.program.sorted.{sorted_by}
use @std.program.store_check.{frontier_records, store_faults_over}
use @std.program.layered_store.{program_store_at, use_machine_store}
use @std.avrac.core.{distinct}
use @std.text.{parse_int}

type CacheCmd = {}

impl Runnable for CacheCmd {
    fn run(args: CliResult) -> int {
        let action = args.arg("action")
        let dir = cache_dir()
        if action == "clean" { return cache_clean(dir) }
        if action == "log" { return cache_log(dir) }
        if action == "show" { return cache_show(dir, args.arg("rev")) }
        if action == "dependents" { return dependents_worked(rooted(args.arg("rev"))) }
        if action == "check" { return cache_check(if args.arg("rev") == "" { dir } else { rooted(args.arg("rev")) }) }
        if action == "frontier" { return cache_frontier(if args.arg("rev") == "" { dir } else { rooted(args.arg("rev")) }) }
        if action == "families" { return cache_families(if args.arg("rev") == "" { dir } else { rooted(args.arg("rev")) }) }
        eprintln(
            "avra cache: `clean`, `log`, `show <n>`, `families [<store>]`, `check [<store>]`, `frontier [<store>]` or `dependents <store>`",
        )
        2
    }
}

export command cache {
    description: "The program layer's store of this package: compact it (`clean`), list its packs (`log`), name the questions one answers (`show <n>`), weigh what each query keeps (`families [<store>]`)"
    arg action {
        description: "`clean`, `log`, `show`, `families`, `check`, `frontier` or `dependents`"
        required: true
    }
    arg rev {
        description: "the pack `show` reads, by the number `log` lists it under; the store `families` weighs, `check` holds or `frontier` says, or the package `dependents` works out, by its directory"
    }
    run: CacheCmd {}
}

/// Where the store of the package the command stands in lies: under the nearest package root at or
/// above it, else where it stands.
fn cache_dir() -> string { joined_path(package_root(here()) ?? here(), ".avra-cache/tapes") }

/// `clean` compacts the store and says what it held before and holds after; the machine's shared
/// store after it, where this process uses one.
fn cache_clean(dir: string) -> int {
    println("avra cache clean: ${compacted_said(dir)}")
    let shared? = machine_layer() else { return 0 }
    println("avra cache clean: the machine's store — ${compacted_said(shared.directory)}")
    0
}

/// The store at `dir` compacted, said: its packs and octets before and after, and the compilers it
/// keeps answers for; or why it couldn't be.
fn compacted_said(dir: string) -> string {
    let before = packs_listed(dir)
    match disk_store_at(dir).compacted() {
        .Ok(_) -> {
            let after = packs_listed(dir)
            "packs ${before.length} → ${after.length} · bytes ${octets_of(before)} → ${octets_of(after)} · ${distinct([p.print for p in after]).length} compiler(s) kept"
        },
        .Err(e) -> "not compacted: ${e.describe().message}",
    }
}

fn octets_of(packs: List<PackListed>) -> int { packs.fold(0, (sum, p) -> sum + p.octets) }

/// `log` lists every pack, oldest first, numbered, with the compiler whose answers it holds and what
/// it weighs on disk.
fn cache_log(dir: string) -> int {
    let packs = packs_listed(dir)
    if packs.is_empty() {
        println("avra cache log: no pack")
        return 0
    }
    for j, p in packs {
        println(
            "pack ${j + 1} · generation ${p.generation} · compiler ${p.print} · ${p.octets} bytes",
        )
    }
    0
}

/// `show <n>` names each question the pack `log` numbers `n` answers: its query, and what the
/// question is known by. A number no pack wears, or a pack that isn't whole, refuses.
fn cache_show(dir: string, raw: string) -> int {
    let n? = parse_int(raw) else {
        eprintln("avra cache show: `${raw}` is no pack's number — write one `log` lists")
        return 2
    }
    let packs = packs_listed(dir)
    let questions? = (if n < 1 || n > packs.length { null } else { pack_questions(dir, packs[n - 1].name) }) else {
        eprintln("avra cache show: pack ${n} holds nothing — no pack stands there, or it is torn")
        return 1
    }
    for q in questions { println("${q.query_name}\t${q.known_as.high_word}_${q.known_as.low_word}") }
    0
}

/// `check` holds the store at `dir` to what every write promises, its records read as a build reads
/// them, over the machine's store where one stands: each fault on a line of its own and a failure,
/// else what it held.
fn cache_check(dir: string) -> int {
    use_machine_store(machine_layer())
    let faults = store_faults_over(dir, program_store_at(dir))
    for f in faults { eprintln("avra cache check: ${f.line()}") }
    if !faults.is_empty() {
        eprintln("avra cache check: ${faults.length} fault(s) in ${dir}")
        return 1
    }
    println("avra cache check: ${dir} holds nothing a write may not leave")
    0
}

/// `frontier` says the frontiers the store at `dir` keeps, a record a line in question order, read as
/// a build reads them, over the machine's store where one stands: two stores keeping one frontier say
/// it alike (docs/2026_11_28_WARM_COLD.md).
fn cache_frontier(dir: string) -> int {
    use_machine_store(machine_layer())
    for line in frontier_records(dir, program_store_at(dir)) { println(line) }
    0
}

/// `families` weighs what each query keeps in the store at `dir`, every pack summed, the heaviest
/// first: its questions, the kilobytes of their records and of the answers they name.
fn cache_families(dir: string) -> int {
    let packs = packs_listed(dir)
    mut summed: Map<string, FamilyWeight> = {}
    for p in packs {
        for w in pack_families(dir, p.name) ?? [] {
            let had? = summed.get(w.query_name) else {
                summed.set(w.query_name, w)
                continue
            }
            summed
                .set(
                    w.query_name,
                    had with { questions: had.questions + w.questions, question_octets: had.question_octets + w.question_octets, answer_octets: had.answer_octets + w.answer_octets },
                )
        }
    }
    let rows = sorted_by([w for _q, w in summed], heavier)
    println("query\tquestions\trecords KB\tanswers KB\ttotal KB")
    for w in rows {
        println(
            "${w.query_name}\t${w.questions}\t${w.question_octets / 1024}\t${w.answer_octets / 1024}\t${(w.question_octets + w.answer_octets) / 1024}",
        )
    }
    let reads = [r! for p in packs for r in [pack_reads_repeated(dir, p.name)] if r != null]
    println(
        "reads: ${reads.fold(0, (sum, r) -> sum + r.whole)} whole, ${reads.fold(0, (sum, r) -> sum + r.whole_distinct)} of them distinct; ${reads.fold(0, (sum, r) -> sum + r.part)} part, ${reads.fold(0, (sum, r) -> sum + r.part_distinct)} distinct",
    )
    0
}
