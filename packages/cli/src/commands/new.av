//! `avra new` — the compiler scaffolds its own growth.
//! `feature <name>` writes the directory, the five files, and the
//! test, all compiling, then prints the three wiring edits.
//! `ins <Name>` prints the IR VOCABULARY PROTOCOL: the two
//! questions that gate growth, then the six consumers a new
//! instruction owes. Both end at `make gate`.
use @std.cli.{Subcommand, CliResult, Runnable, ArgDef, result_get_arg}

type NewCmd = { }

impl Runnable for NewCmd {
    fn run(self, args: CliResult) -> int {
        let kind = result_get_arg(args, "kind")
        let name = result_get_arg(args, "name")
        if kind == "feature" { return scaffold_feature(name) }
        if kind == "ins" { return scaffold_ins(name) }
        eprintln("avra new: `feature` or `ins`")
        2
    }
}

export fn new_command() -> Subcommand {
    let body: NewCmd = NewCmd { }
    let args = [
        ArgDef { name: "kind", description: "what to scaffold (`feature` or `ins`)", required: true, variadic: false },
        ArgDef { name: "name", description: "its snake_case name", required: true, variadic: false },
    ]
    Subcommand { meta: arg_command("new", "Scaffold the next feature, or an IR instruction's checklist", args), body: body }
}

/// `foo` -> `Foo`.
fn initial_upper(name: string) -> string {
    let lower = "abcdefghijklmnopqrstuvwxyz"
    let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    if name.length == 0 { return name }
    let head = name.substring(0, 1)
    mut out = head
    for j in 0..26 {
        if lower.substring(j, j + 1) == head { out = upper.substring(j, j + 1) }
    }
    "${out}${name.substring(1, name.length)}"
}

fn scaffold_feature(name: string) -> int {
    let dir = "packages/std-avrac/src/features/${name}"
    if avra_selfhost_file_exists("${dir}/mod.av") != 0 {
        eprintln("avra new: `${dir}` already exists")
        return 2
    }
    if avra_mkdir_p("${dir}/tests") == 0 {
        eprintln("avra new: cannot create `${dir}`")
        return 1
    }
    let ty = "${initial_upper(name)}Semantics"
    write_or_die("${dir}/mod.av", mod_template(name))
    write_or_die("${dir}/builders.av", builders_template(name))
    write_or_die("${dir}/semantics.av", semantics_template(name, ty))
    write_or_die("${dir}/check.av", check_template(name))
    write_or_die("${dir}/lower.av", lower_template(name))
    write_or_die("${dir}/tests/${name}_test.av", test_template(name))
    println("feature `${name}` scaffolded at ${dir}")
    println("wire it in (three edits):")
    println("  1. core/nodes.av — the node variant and its fingerprint arm")
    println("  2. language/program.av — import ${ty}; add the semantics_of arm")
    println("  3. language/mod.av — the feature in language_features(), in its spot")
    println("     (keywords derive from your gram's literals — nothing to list)")
    println("prove it: corpus/${name}.av with its .expected, then `make gate`")
    0
}

/// `avra new ins <Name>` — the IR vocabulary protocol, printed at
/// the moment of use: the two questions that gate growth, then the
/// six consumers the new variant owes.
fn scaffold_ins(name: string) -> int {
    println("`${name}` would join the IR vocabulary. Two questions first:")
    println("")
    println("  JUSTIFY     a new control shape, value category, memory")
    println("              boundary — or a MACHINE SHAPE the backend can")
    println("              exploit and cannot infer? Performance counts.")
    println("              If an existing instruction already says it, stop:")
    println("              every value-producing runtime need rides CallRt.")
    println("  GENERALIZE  can an EXISTING variant become more general")
    println("              instead? SwitchStart reuses ArmEnd/RegionEnd, so")
    println("              regions and 2-arm ifs stayed ONE mechanism. One")
    println("              variant that deepens a concept beats two that")
    println("              split it.")
    println("")
    println("Then declare it in core/ir.av's `Ins` and pay its eight")
    println("consumers — each dispatch is exhaustive, so the compiler")
    println("lists them for you and `make vocab` keeps it that way:")
    println("")
    println("  1. core/ir.av            dst_of      the register it defines")
    println("       .${name}(...) -> null,")
    println("  2. language/interp.av    step        its MEANING")
    println("       .${name}(...) -> <mutate the machine, answer the next pc>,")
    println("  3. language/memory.av    memory_ins  its ownership effect")
    println("       .${name}(...) -> { manages(types, reg_types, open_scopes, i)")
    println("                          out.push(i) }")
    println("  4. language/ir_text.av   body_lines  its human projection")
    println("       .${name}(...) -> lines.push(line(depth, \"...\")),")
    println("  5. language/llvm.av      emit_ins    its machine projection")
    println("       .${name}(...) -> <build it>,")
    println("  6. features/facts.av     give        does the runtime registry")
    println("       validate it — join the calling arms or the silent group")
    println("  7. core/ir.av            body_symbol   the program body it names")
    println("       .${name}(...) -> null,   (unless it calls one)")
    println("  8. core/ir.av            hosted_symbol the hosted fn it calls")
    println("       .${name}(...) -> null,   (unless it calls one)")
    println("")
    println("prove it: a corpus program (eval == native == expected) and the")
    println("`avra ir` golden that shows the new shape. Then `make gate`.")
    0
}

fn write_or_die(path: string, content: string) {
    if avra_selfhost_write_file(path, content) == 0 {
        eprintln("avra new: cannot write `${path}`")
        avra_process_exit(1)
    }
}

/// A template's holes filled. A raw block says exactly what it
/// holds, so a scaffold NAMES its holes and this fills them — which
/// is also why each template reads as the file it becomes.
fn filled_in(template: string, name: string, ty: string) -> string {
    template.replace(hole("name"), name).replace(hole("ty"), ty).replace(hole("raw"), triple())
}

/// The raw block's own delimiter. A raw block cannot hold it — that
/// is what ENDS one — so a template that writes one names a hole.
fn triple() -> string { "\"\"\"" }

/// One hole as the templates spell it, built rather than written:
/// a literal `${` inside a string would be a hole itself.
fn hole(word: string) -> string {
    "\${" + word + "}"
}

fn mod_template(name: string) -> string {
    filled_in("""//! TODO: what `${name}` IS, in one breath.
use features.{LanguageFeature, BuilderRow}
use grammar.{Grammar, Rule, Alt, Seq, Item, Prim, Rep, Build, Expect, Recover}

export fn ${name}() -> LanguageFeature {
    let rows = table<BuilderRow> {
        name      | build
        "${name}" | build_${name}
    }
    component LanguageFeature f {
        name = "${name}"
        docs = "TODO: the one-line surface."
        gram = grammar {
            TODO = TODO -> ${name}()
        }
        builders = rows
    }
    f
}
""", name, "")
}

fn builders_template(name: string) -> string {
    filled_in("""//! Parse-time lowering: captures -> the ${name} node.
use core.{Expr}
use features.{LangNode, Builder}

fn build_${name}(b: Builder) -> Result<LangNode, string> {
    b.make_expr(Expr.Error)
}
""", name, "")
}

fn semantics_template(name: string, ty: string) -> string {
    filled_in("""//! The ${name} NodeSemantics: dispatch only. Typing lives in
//! check.av; lowering — the MEANING — in lower.av.
use core.{Expr, ExprId, TypeId, Reg}
use features.{NodeSemantics, ResolveCx, TypeCx, LowerCx, nothing}

export type ${ty} = { }

impl NodeSemantics for ${ty} {
    fn kids(self, e: Expr) -> List<ExprId> {
        []
    }

    fn heirs(self, e: Expr) -> List<ExprId> {
        []
    }

    fn resolve(self, cx: ResolveCx, e: ExprId) {
        nothing()
    }

    fn type_of(self, cx: TypeCx, e: ExprId) -> TypeId {
        ${name}_type(cx, e)
    }

    fn lower(self, cx: LowerCx, e: ExprId) -> Reg {
        ${name}_lower(cx, e)
    }
}
""", name, ty)
}

fn check_template(name: string) -> string {
    filled_in("""//! The typing rule: TODO.
use core.{ExprId, TypeId}
use features.{TypeCx}

fn ${name}_type(cx: TypeCx, e: ExprId) -> TypeId {
    cx.error_type
}
""", name, "")
}

fn lower_template(name: string) -> string {
    filled_in("""//! The lowering rule — the ONE meaning: TODO.
use core.{ExprId, Reg}
use features.{LowerCx}

fn ${name}_lower(cx: LowerCx, e: ExprId) -> Reg {
    cx.result(e)
}
""", name, "")
}

fn test_template(name: string) -> string {
    filled_in("""// TODO: the vertical, tested — parse, type, run, and the IR.
use @std.avrac.testing.{shown}

spec "features/${name}" {
    given "TODO" {
        then "TODO" {
            shown("TODO") == "<refused>"
        }
    }
}
""", name, "")
}
