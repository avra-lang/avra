//! `avra records` — WRITE the interface records, one per module.
//!
//! The write half of rung 2, and it must be its own command because the
//! witness for the read half is impossible otherwise: a command that wrote
//! and then checked in one run would find every record valid by construction,
//! and the leg that matters — a record written BEFORE a change, asked AFTER it
//! — could never be taken.
//!
//! Writing happens the one moment the imports are free, while the parse is in
//! hand, and what is written is what each module was built AGAINST.
use @std.cli.{Subcommand, CliResult, Runnable}
use @std.avrac.language.{Program, build_cache_root, write_surfaces}
use @std.avrac.core.{module_path, distinct}

type RecordsCmd = { }

impl Runnable for RecordsCmd {
    fn run(args: CliResult) -> int { phased(args, "records", recorded) }
}

fn recorded(p: Program) -> Result<int, string> {
    mut ws = p.ws
    let mods = [module_path(n.split(".")) for n in distinct([ws.module_of(a.view.source.file) for a in p.files])]
    let written = write_surfaces(p, ws, build_cache_root(ws), mods)
    println("${written} interface record(s) written")
    0
}

export fn records_command() -> Subcommand {
    Subcommand { meta: file_command("records", "Write each module's interface record — rung 2's write half"), body: RecordsCmd { } }
}
