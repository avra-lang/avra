//! `avra fmt <file>` — the file as canonical Avra, SAID and never
//! written back.
//!
//! THERE IS NO `--write` YET, AND THE REASON IS A MEASUREMENT. The
//! renderer replays a file's remarks and its doc comments, but a
//! TRAILING `//` (one sharing a line with code) is still dropped, so
//! rewriting would delete those. Reading is safe; rewriting is not
//! until `fmt(x) == x` holds for every file in the tree.
//!
//! AND IDEMPOTENCE DOES NOT PROVE IT — measured, not argued.
//! `fmt(fmt(x)) == fmt(x)` was GREEN while every plain comment was
//! being deleted, because the second pass had no comments left to
//! lose. The receipt a formatter owes is LOSSLESSNESS, a different
//! question and not a weaker one.
//!
//! IT PARSES AND DOES NOT ANALYZE. Formatting moves no token that
//! typing decides, and the analyzed path cost 2.5 MINUTES for one file
//! because asking for the entry forces the whole package to type.
use @std.cli.{Subcommand, CliResult, Runnable}
use @std.io.{exists}

type FmtCmd = { }

impl Runnable for FmtCmd {
    fn run(args: CliResult) -> int {
        let path = path_arg(args)
        if !exists(path) {
            no_such_file(path)
            return 2
        }
        // ONE WORKSPACE. A `FileId` is an INDEX into the workspace that
        // minted it, so asking a second workspace to read it indexes a
        // table that never had the file — "index 0 is out of bounds
        // (length 0)", for every input.
        mut ws = file_workspace(path)
        match ws.formatted_source(ws.file_id(path)) {
            .Ok(text) -> {
                println(text)
                0
            },
            .Err(report) -> {
                println(report)
                1
            },
        }
    }
}

export fn fmt_command() -> Subcommand {
    Subcommand { meta: file_command("fmt", "Print a file as canonical Avra"), body: FmtCmd { } }
}
