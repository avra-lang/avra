//! `avra fmt <file>` — the file as canonical Avra: SAID by default,
//! or WRITTEN with `--write`, gated on the LOSSLESS RECEIPT
//! (compiler/format/receipt.av, `Workspace.write_checked_source`):
//! the same significant tokens, remarks and doc groups the input
//! carried, in order. A rewrite the receipt cannot confirm is
//! refused, and nothing on disk moves.
//!
//! AND IDEMPOTENCE DOES NOT PROVE LOSSLESSNESS — measured, not
//! argued. `fmt(fmt(x)) == fmt(x)` was GREEN while every plain
//! comment was being deleted, because the second pass had no
//! comments left to lose. `--check` is the tree-wide receipt:
//! `fmt(x) == x` for an already-canonical file, byte-exact.
//!
//! IT PARSES AND DOES NOT ANALYZE. Formatting moves no token that
//! typing decides, and the analyzed path cost 2.5 MINUTES for one file
//! because asking for the entry forces the whole package to type.
//!
//! `--check <dir|files…>` IS ONE PROCESS: every `.av` file under a
//! given directory (package boundaries found by `avra.toml`, never
//! crossed into a nested package's OWN root a second time), or the
//! files named, in ONE run — so the per-file `avra` start-up
//! `tools/fmt_lossless.sh` once paid (~730 times, ~30s of nothing but
//! process launches) is paid ONCE. A canonical file's own bytes are
//! remembered under this compiler's print in the tree's store, so a
//! warm re-run skips its parse and its print both — only a file that
//! moved, or one this compiler has never seen, pays for either.
use @std.cli.{CliResult, Runnable, command, flag, arg}
use @std.io.{write_text}
use @std.avrac.compiler.{Workspace, Phase, phase_total}
use @std.avrac.compiler.store.{Store}
use @std.avrac.core.{FileId, digest_of, joined, distinct, sorted_texts}
use @std.avrac.features.{BlockWords}
use @std.path.{dir_of, joined_path}
use @std.time.{now_ns}

type FmtCmd = {}

impl Runnable for FmtCmd {
    fn run(args: CliResult) -> int {
        if args.has_flag("check") || args.has_flag("write") { return walked(args, args.has_flag("write")) }
        let path = path_arg(args)
        // LICENSED compiler.host_asked_directly: a command's read of the path it was given, at this instant — no query frame is open
        let there = match disk_host().there(path) { .Exists(_, t) -> t, rest -> false }
        if !there {
            no_such_file(path)
            return 2
        }
        // ONE WORKSPACE. A `FileId` is an INDEX into the workspace that
        // minted it, so asking a second workspace to read it indexes a
        // table that never had the file — "index 0 is out of bounds
        // (length 0)", for every input.
        let ws = file_workspace(path)
        let f = ws.file_id(path)
        let outcome = match ws.formatted_source(f) {
            .Ok(text) -> {
                println(text)
                eprintln(printed_only_note())
                0
            },
            .Err(report) -> {
                println(report)
                1
            },
        }
        if timed(args) { eprintln(time_report(ws.phases.get())) }
        outcome
    }
}

// ── --check / --write: one process over a tree ──

/// This compiler's answer, remembered against the file's OWN bytes —
/// never the path, which a rename would falsely invalidate, and
/// never mtime, which a checkout without one would falsely trust —
/// and against the compiler's OWN print, since "canonical" is this
/// formatter's verdict and a later formatter's rules may disagree.
/// ALSO against the provider words its `use` lines read (§6.5, avra-8sb5.57.9.6):
/// a file's parse depends on the block words OTHER modules export, so a
/// provider that drops or changes one must un-canonicalize every importer
/// whose own bytes never moved.
fn canon_key(ws: Workspace, f: FileId, text: string) -> string {
    digest_of(
        "fmt.canonical\n${ws.compiler_id()}\n${block_word_key(ws, ws.block_words(f, ws.parsed(f)))}\n${text}",
    )
}

/// A file's block words, folded to ONE stable string — sorted, since
/// nothing about `use`-line order or a provider's own file order is a
/// property `canon_key` may depend on. Each PROVIDER FILE's own current
/// text stands in for its content: a word's own name never moves when
/// a grammar's internal rule changes, only the file that declares it
/// does, so the origin's bytes are what `canon_key` must depend on.
fn block_word_key(ws: Workspace, bw: BlockWords) -> string {
    let origins = distinct(
        [g.origin for g in bw.grammars].concat([c.origin for c in bw.components]),
    )
    let names = sorted_texts(["${c.word}:${c.declared}" for c in bw.components])
        .concat(sorted_texts(["${i.name}:${i.declared}" for i in bw.instances]))
    let provider_texts = sorted_texts([ws.source(ws.file_id(origin)).text for origin in origins])
    joined(names.concat(provider_texts), "\n")
}

/// examined, differing (written, under `--write`), refused, which paths
/// differed, and every phase either side of the run timed — folded
/// across every group the walk visits.
type Tally = { examined: int, differing: int, refused: int, diffs: List<string>, phases: List<Phase> }

fn empty_tally() -> Tally { Tally { examined: 0, differing: 0, refused: 0, diffs: [], phases: [] } }

fn combined(a: Tally, b: Tally) -> Tally {
    Tally {
        examined: a.examined + b.examined,
        differing: a.differing + b.differing,
        refused: a.refused + b.refused,
        diffs: a.diffs.concat(b.diffs),
        phases: a.phases.concat(b.phases),
    }
}

/// EVERY NAMED SPAN, SUMMED — `--time`'s report. `store` is
/// `build_cache_root`'s cost (the compiler's own binary digest, paid
/// once per package); `source` and `digest` are the per-file read and
/// the canonical-cache's own lookup/write; `ast` folds the lexer in
/// (there is no seam here to time it apart); `sublang` is the
/// block-grammar lookup ALONE — a provider file it falls back to
/// parsing counts under `ast`, so this phase holds only the lookup's
/// own overhead; `print` and `compare` are the render and the byte
/// check.
fn time_report(phases: List<Phase>) -> string {
    "time: ${joined(["${n} ${ms(phase_total(phases, n))}" for n in distinct([p.name for p in phases])], ", ")}"
}

/// A root's workspace, checking either its WHOLE package (`explicit`
/// absent) or only the files named — the files a directory argument
/// walked to, or a bare file argument gave outright.
type Group = { root: string, explicit: List<string>? }

/// `--check` reports what differs from canonical; `--write` puts the
/// receipt-checked canonical text on disk. Both walk every file in ONE
/// process, one workspace per package, and both remember a canonical
/// file's bytes in the store so the next walk skips it.
fn walked(args: CliResult, write: bool) -> int {
    let asked = [rooted(p) for p in args.args_of("file")]
    let t = fold_groups(expanded_groups(asked), write)
    for p in t.diffs { println(p) }
    println(walk_summary(t, write))
    if timed(args) { eprintln(time_report(t.phases)) }
    if t.refused > 0 || !write && t.differing > 0 { 1 } else { 0 }
}

fn walk_summary(t: Tally, write: bool) -> string {
    if write { "fmt --write: ${t.examined} examined, ${t.differing} written, ${t.refused} refused" } else { "fmt --check: ${t.examined} examined, ${t.differing} differing, ${t.refused} refused" }
}

fn expanded_groups(asked: List<string>) -> List<Group> {
    dir_groups([p for p in asked if is_a_dir(p)])
        .concat(loose_groups([p for p in asked if !is_a_dir(p)]))
}

fn dir_groups(dirs: List<string>) -> List<Group> {
    if dirs.is_empty() { return [] }
    [Group { root: r, explicit: null } for r in package_roots_under(dirs[0])]
        .concat(dir_groups(dirs.slice(1, dirs.length)))
}

/// Every `avra.toml`-rooted package under `dir` — `dir` itself when
/// it stands at one, never descending past it into a package nested
/// inside a package.
fn package_roots_under(dir: string) -> List<string> {
    let host = disk_host()
    // LICENSED compiler.host_asked_directly: package roots are found on disk before any workspace exists — no query frame is open
    let rooted = match host.there(joined_path(dir, "avra.toml")) {
        .Exists(_, t) -> t,
        rest -> false,
    }
    if rooted { return [dir] }
    // LICENSED compiler.host_asked_directly: package roots are found on disk before any workspace exists — no query frame is open
    match host.listing(dir) {
        .Listing(_, entries) -> roots_from(dir, [e.name for e in entries ?? []]),
        rest -> [],
    }
}

fn roots_from(dir: string, names: List<string>) -> List<string> {
    if names.is_empty() { return [] }
    let path = joined_path(dir, names[0])
    let heads = if is_a_dir(path) { package_roots_under(path) } else { [] }
    heads.concat(roots_from(dir, names.slice(1, names.length)))
}

/// The loose files, grouped by the package root each stands in — one
/// workspace per root, never one per file.
fn loose_groups(files: List<string>) -> List<Group> {
    mut roots: List<string> = []
    mut by_root: Map<string, List<string>> = {}
    for path in files {
        let root = package_root(dir_of(path)) ?? path
        if !roots.contains(root) { roots.push(root) }
        by_root.set(root, (by_root.get(root) ?? []).concat([path]))
    }
    [Group { root: r, explicit: by_root.get(r) } for r in roots]
}

/// `shared_id` is null on the top-level call (`walked`'s own): the
/// FIRST group's workspace hashes the running binary for real, and
/// every LATER group is seeded with that same answer instead of
/// hashing its own copy — one process, one binary, one hash, never
/// the process-wide cache `compiler_print` itself refuses (a rebuilt
/// binary at the SAME path inside one process must still disagree;
/// see compiler/build.av). `shared_id` is a caller's OWN knowledge
/// that ITS workspaces share one binary, never a general assumption.
///
/// `seen` counts the files every earlier group took, so a run asked to
/// stay light leaves before the group that would take it past the bound.
fn fold_groups(groups: List<Group>, write: bool, shared_id: string? = null, seen: int = 0) -> Tally {
    if groups.is_empty() { return empty_tally() }
    let g = groups[0]
    let ws = workspace_for(g.root)
    if shared_id != null { ws.seed_compiler_id(shared_id!) }
    let files = g.explicit ?? ws.all_files(joined_path(g.root, "src"))
    light_or_leave(seen + files.length)
    let t0 = now_ns()
    let store = ws.opened_store()
    let store_ns = now_ns() - t0
    let group = check_files(store, ws, files, write)
    // THE GROUP'S WORKSPACE PHASES ARE READ ONCE, after its files are
    // all checked — `ws.phases` accumulates for the whole workspace,
    // so reading it per file would fold the same early spans in again
    // with every later one.
    let all = group with { phases: group.phases.concat([Phase { name: "store", ns: store_ns }]).concat(ws.phases.get()) }
    combined(
        all,
        fold_groups(
            groups.slice(1, groups.length),
            write,
            shared_id ?? ws.compiler_id(),
            seen + files.length,
        ),
    )
}

fn workspace_for(root: string) -> Workspace {
    if is_a_dir(root) { root_workspace(root) } else { lone(root) }
}

enum Outcome { Canonical, Differs, Refused }

type Checked1 = { outcome: Outcome, phases: List<Phase> }

fn ended(outcome: Outcome, phases: List<Phase>) -> Checked1 { Checked1 { outcome: outcome, phases: phases } }

fn check_files(store: Store, ws: Workspace, files: List<string>, write: bool) -> Tally {
    mut t = empty_tally()
    for path in files {
        let c = checked_one(store, ws, path, write)
        t = Tally {
            examined: t.examined + 1,
            differing: t.differing + if c.outcome == Outcome.Differs { 1 } else { 0 },
            refused: t.refused + if c.outcome == Outcome.Refused { 1 } else { 0 },
            diffs: if c.outcome == Outcome.Differs { t.diffs.concat([path]) } else { t.diffs },
            phases: t.phases.concat(c.phases),
        }
    }
    t
}

/// A cache hit answers without a parse or a print; a miss pays for
/// both and, when the file turns out canonical, remembers so the
/// next `--check` need not ask again. `source` and `digest` are timed
/// here directly — `ast`, `sublang` and `print` ride the workspace's
/// own clock (`ws.phases`, folded in once per group by the caller).
fn checked_one(store: Store, ws: Workspace, path: string, write: bool) -> Checked1 {
    let t0 = now_ns()
    let f = ws.file_id(path)
    let src = ws.source(f)
    let source_ns = now_ns() - t0
    let t1 = now_ns()
    let key = canon_key(ws, f, src.text)
    let hit = ws.db.canon(store, key) != null
    let base = [
        Phase { name: "source", ns: source_ns },
        Phase { name: "digest", ns: now_ns() - t1 },
    ]
    if hit { return ended(Outcome.Canonical, base) }
    if write { return written_one(store, ws, f, path, src.text, base) }
    match ws.formatted_source(f) {
        .Ok(text) -> {
            let t2 = now_ns()
            let matches = "${text}\n" == src.text
            let compare = Phase { name: "compare", ns: now_ns() - t2 }
            if matches {
                let t3 = now_ns()
                ws.db.insert_canon(store, key, "")
                Checked1 {
                    outcome: Outcome.Canonical,
                    phases: base.concat([compare, Phase { name: "digest", ns: now_ns() - t3 }]),
                }
            } else {
                Checked1 { outcome: Outcome.Differs, phases: base.concat([compare]) }
            }
        },
        .Err(_) -> ended(Outcome.Refused, base),
    }
}

/// `--write`'s one file: the receipt-checked text, put on disk and
/// remembered as canonical — or refused, and nothing on disk moves.
fn written_one(
    store: Store,
    ws: Workspace,
    f: FileId,
    path: string,
    before: string,
    base: List<Phase>,
) -> Checked1 {
    match ws.write_checked_source(f) {
        .Ok(text) -> {
            let after = "${text}\n"
            ws.db.insert_canon(store, canon_key(ws, f, after), "")
            if after == before { return ended(Outcome.Canonical, base) }
            match write_text(path, after) {
                .Ok(_) -> ended(Outcome.Differs, base),
                .Err(e) -> {
                    eprintln("avra: ${path}: ${e.describe().message}")
                    ended(Outcome.Refused, base)
                },
            }
        },
        .Err(report) -> {
            eprintln("${path}: ${report}")
            ended(Outcome.Refused, base)
        },
    }
}

/// A bare run only SAYS the canonical text, so its stdout reads the same
/// whether the file changed or not; stderr names the flags that act.
fn printed_only_note() -> string {
    "avra fmt: printed the canonical text and wrote nothing — --write updates the file, --check compares it"
}

export command fmt {
    description: "Print a file as canonical Avra"
    flags: [time]
    flag write { description: "rewrite every file under a directory, or the files given, refusing any whose receipt is not lossless" }
    flag check { description: "one pass over every file under a directory, or the files given; reports what differs from canonical" }
    arg file {
        description: "the source file, or (--check) files/directories to examine"
        required: true
        variadic: true
    }
    run: FmtCmd {}
}
