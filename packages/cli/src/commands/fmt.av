//! `avra fmt <file>` — the file as canonical Avra: SAID by default,
//! or WRITTEN with `--write`, gated on the LOSSLESS RECEIPT
//! (compiler/format/receipt.av, `Workspace.write_checked_source`):
//! the same significant tokens, remarks and doc groups the input
//! carried, in order. A rewrite the receipt cannot confirm is
//! refused, and nothing on disk moves.
//!
//! AND IDEMPOTENCE DOES NOT PROVE LOSSLESSNESS — measured, not
//! argued. `fmt(fmt(x)) == fmt(x)` was GREEN while every plain
//! comment was being deleted, because the second pass had no
//! comments left to lose. `tools/fmt_lossless.sh`
//! (`make fmt-lossless`) is the tree-wide receipt: `fmt(x) == x` for
//! an already-canonical file, byte-exact.
//!
//! IT PARSES AND DOES NOT ANALYZE. Formatting moves no token that
//! typing decides, and the analyzed path cost 2.5 MINUTES for one file
//! because asking for the entry forces the whole package to type.
use @std.cli.{Subcommand, CliResult, Runnable, FlagDef}
use @std.io.{exists, write_text}
use @std.avrac.compiler.{Workspace}
use @std.avrac.core.{FileId}

type FmtCmd = {}

impl Runnable for FmtCmd {
    fn run(args: CliResult) -> int {
        let path = path_arg(args)
        if !exists(path) {
            no_such_file(path)
            return 2
        }
        // ONE WORKSPACE. A `FileId` is an INDEX into the workspace that
        // minted it, so asking a second workspace to read it indexes a
        // table that never had the file — "index 0 is out of bounds
        // (length 0)", for every input.
        let ws = file_workspace(path)
        let f = ws.file_id(path)
        if args.has_flag("write") { return written(ws, f, path) }
        match ws.formatted_source(f) {
            .Ok(text) -> {
                println(text)
                0
            },
            .Err(report) -> {
                println(report)
                1
            },
        }
    }
}

/// `--write`: the receipt-checked text, put on disk — or the reason
/// it was refused, and the file left untouched either way until the
/// receipt holds.
fn written(ws: Workspace, f: FileId, path: string) -> int {
    match ws.write_checked_source(f) {
        .Ok(text) -> match write_text(path, "${text}\n") {
            .Ok(_) -> 0,
            .Err(e) -> host_refused(e.describe().message),
        },
        .Err(report) -> {
            println(report)
            1
        },
    }
}

export fn fmt_command() -> Subcommand {
    Subcommand {
        meta: file_command("fmt", "Print a file as canonical Avra") with { flags: [
            FlagDef { name: "--time", short: "", description: "print phase timings and memo hits", aliases: [] },
            FlagDef { name: "--write", short: "", description: "rewrite the file, refusing unless the receipt is lossless", aliases: [] },
        ] },
        body: FmtCmd {},
    }
}
