//! `avra fix` on the program layer: the same applications the old path makes, read off the layer's
//! answers. Every suggestion a diagnostic of the file carries — a law's, a rule's — is one
//! application; it is PROVED where the program's code is the same with its edits spliced in (each
//! fn's, method's and the statements' lowering, read by a second engine over the edited text), and
//! a rule's rewrite the proof doesn't hold is ACCEPTED by the law its rule declares where the
//! edited program is refused nothing. Under `--repair`, each error's certain suggestion is tried
//! instead, accepted where it leaves fewer errors and none new.
use @std.cli.{CliResult}
use @std.avrac.compiler.{
    Application,
    FileCode,
    ProgramFile,
    avra_fact_definitions,
    edits_provable,
    file_code,
    file_law_diags,
    file_rule_rows,
    fix_considers,
    fix_errors,
    fix_repairs,
    fix_store,
    program_erring,
    rule_kind,
    rule_law,
    rule_rewrite,
    same_code,
    said_diag,
}
use @std.avrac.core.{SyntaxArena, flatten}
use @std.avrac.diagnostics.{Diag, is_error, spliced}
use @std.errors.{Edit, Suggestion}
use @std.path.{joined_path}
use @std.program.layered_store.{program_store_at}
use @std.program.query_engine.{QueryEngine, query_engine}

/// `avra fix` of the file, or a package's entry, the arguments name, on the program layer: a program
/// its laws refuse is said and left as it stands, exit 1, unless `--repair` asks for its errors'
/// certain remedies.
fn program_fixed(args: CliResult) -> int {
    let path? = argued_path(args) else { return 2 }
    let aimed = match program_aimed(path) { .Ok(a) -> a, .Err(code) -> { return code } }
    let disk = aimed.disk
    disk.entered()
    let engine = query_engine(
        program_store_at(joined_path(disk.root, ".avra-cache/tapes")),
        avra_fact_definitions(),
    )
    let h = program_file(disk, disk.file_at(aimed.bin))
    let repair = args.has_flag("repair")
    let erring = program_erring(engine, disk.name)
    if !erring.is_empty() && !repair {
        println([erring_said(engine, program_file(disk, f)) for f in erring].join("\n"))
        return 1
    }
    let text = text_at(h.full) ?? ""
    let named = args.option("only")
    let only = if named == "" { null } else { named }
    let at = Fixing {
        disk: disk,
        engine: engine,
        h: h,
        text: text,
        store: fix_store(engine, h.file),
    }
    let diags = [d for d in at.diags() if only == null || d.kind == only!]
    let apps = if repair { at.repairs(diags) } else { at.proved(diags) }
    disk.entered()
    match fixes_written(h.full, text, apps, args) {
        .Ok(code) -> code,
        .Err(report) -> {
            println(report)
            1
        },
    }
}

/// The file a fix stands over: its program's disk and engine, the file, its text, and its text
/// parsed whole.
type Fixing = { disk: Disk, engine: QueryEngine, h: ProgramFile, text: string, store: SyntaxArena }

impl Fixing {
    /// What the file says: its laws' diagnostics, then its rules', a rule's suggestions as its rewrites.
    fn diags() -> List<Diag> {
        file_law_diags(self.engine, self.h)
            .concat(
                [said_diag(k, self.h.full) for k in file_rule_rows(self.engine, self.disk.name, self.h.file).said],
            )
            .map((d) -> if rule_kind(d.kind) { self.rewritten(d) } else { d })
    }

    /// A rule's diagnostic, each edit of its suggestions as `avra fix` splices a rule's rewrite.
    fn rewritten(d: Diag) -> Diag {
        d with { suggestions: [sg with { edits: [rule_rewrite(self.text, e) for e in sg.edits] } for sg in d.suggestions] }
    }

    /// Each suggestion of `diags` fix considers, proved or accepted by its rule's law, or only shown.
    fn proved(diags: List<Diag>) -> List<Application> {
        let before = self.code(self.engine)
        flatten(
            [[self.proved_one(before, d.kind, sg) for sg in d.suggestions if fix_considers(self.store, sg)] for d in diags],
        )
    }

    fn proved_one(before: FileCode?, kind: string, sg: Suggestion) -> Application {
        let provable = edits_provable(self.engine, self.h.file, sg.edits)
        let after = self.after(sg.edits)
        let proved = provable && after != null && same_code(before, self.code(after!))
        let law = rule_law(kind)
        let by_law = if proved || law == null || after == null { null } else { if program_erring(after!, self.disk.name).is_empty() { law } else { null } }
        self.disk.entered()
        Application { kind: kind, edits: sg.edits, proved: proved, by_law: by_law }
    }

    /// Each certain suggestion of an error among `diags`, accepted where it clears the error.
    fn repairs(diags: List<Diag>) -> List<Application> {
        let was = fix_errors(diags)
        flatten(
            [[Application {
                kind: d.kind,
                edits: sg.edits,
                proved: false,
                by_law: null,
                repaired: self.clears(was, sg.edits),
            } for sg in d.suggestions if fix_repairs(self.store, sg)] for d in diags if is_error(d)],
        )
    }

    /// Whether `edits` leave the program erring nowhere, or its file with fewer of the errors `was`
    /// lists and none it didn't.
    fn clears(was: List<string>, edits: List<Edit>) -> bool {
        let after? = self.after(edits) else { return false }
        let now = fix_errors(file_law_diags(after, self.h))
        let clear = program_erring(after, self.disk.name).is_empty()
        self.disk.entered()
        if clear { return true }
        now.length < was.length && now.all((e) -> was.contains(e))
    }

    /// The code the file lowers to under `engine`.
    fn code(engine: QueryEngine) -> FileCode? { file_code(engine, self.h.file) }

    /// An engine over the program with `edits` spliced into the file, its world entered; absent where
    /// one reaches outside the file or two overlap. It keeps nothing: the store is read, never saved.
    fn after(edits: List<Edit>) -> QueryEngine? {
        if edits.is_empty() || edits.any(it.loc.file != null && it.loc.file! != self.h.full) { return null }
        let text? = spliced(self.text, edits) else { return null }
        mut over: Map<string, string> = {}
        over.set(self.h.full, text)
        let disk = self.disk with { over: over }
        disk.entered()
        query_engine(
            program_store_at(joined_path(disk.root, ".avra-cache/tapes")),
            avra_fact_definitions(),
        )
    }
}
