//! A `// LICENSED` comment writes a claim, and the dotted id right
//! after that word must still name a rule `avra rules` lists
//! (CLAUDE.md's exemption law) — a comment naming a retired or
//! misspelled id is undocumented debt wearing a license's clothes,
//! and nothing else refuses it. A `rule` reads `Code` (the AST) at a
//! node's own root-kind, never trivia, so this reads a file's
//! remarks directly instead of being one.
use @std.avrac.core.{Remark, flatten}
use @std.path.{relative_path}
use @std.avrac.compiler.{Program, Analysis}

/// Every remark across `p`'s files that claims a license `kinds`
/// does not know, rendered one per line.
export fn stale_licenses(p: Program, kinds: List<string>) -> List<string> {
    flatten([file_stale_licenses(a, kinds) for a in p.files])
}

fn file_stale_licenses(a: Analysis, kinds: List<string>) -> List<string> {
    flatten([remark_report(a, r, kinds) for r in a.view.store.remarks.get()])
}

fn remark_report(a: Analysis, r: Remark, kinds: List<string>) -> List<string> {
    let id? = claimed(r) else { return [] }
    if kinds.contains(id) { return [] }
    [reported(a, r, id)]
}

fn reported(a: Analysis, r: Remark, id: string) -> string {
    let line = a.view.source.linecol(r.at).line
    "${relative_path(here(), a.view.source.file)}:${line}: `// LICENSED ${id}` names no rule `avra rules` lists"
}

/// The id a remark's own text claims, or absence — a bare `// LICENSED
/// — reason` (no id: a doctrine exemption, never a rule's) claims
/// nothing, and neither does a comment that merely mentions the word.
fn claimed(r: Remark) -> string? {
    match r.trivia { .Comment(text) -> claimed_in(text), .Blank -> null }
}

fn claimed_in(text: string) -> string? {
    if !text.contains("LICENSED") { return null }
    let rest = text.substring(text.index_of("LICENSED") + "LICENSED".length, text.length).trim()
    if rest == "" || rest.starts_with("—") || rest.starts_with("-") { return null }
    let colon = rest.index_of(":")
    if colon < 0 { return null }
    let id = rest.substring(0, colon).trim()
    if id == "" { return null }
    id
}
