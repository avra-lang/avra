//! `avra emit` — print a program's verified LLVM module.
use @std.cli.{Subcommand, CliResult, Runnable}
use @std.avrac.compiler.{Program}
use @std.io.{read_text}

type EmitCmd = {}

impl Runnable for EmitCmd {
    fn run(args: CliResult) -> int { phased(args, "lower+emit", emitted) }
}

fn emitted(p: Program) -> Result<int, string> {
    println(read_text(lowered_or_report(p)?) catch "")
    0
}

export fn emit_command() -> Subcommand {
    Subcommand { meta: file_command("emit", "Print a program's verified LLVM module"), body: EmitCmd {} }
}
