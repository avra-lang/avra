//! `avra emit` — print a program's verified LLVM module.
use @std.cli.{CliResult, Runnable, command}
use @std.avrac.compiler.{Program}

type EmitCmd = {}

impl Runnable for EmitCmd {
    fn run(args: CliResult) -> int { phased(args, "lower+emit", emitted) }
}

fn emitted(p: Program) -> Result<int, string> {
    // LICENSED compiler.host_asked_directly: a command's read of the file it was given, at this instant — no query frame is open
    println(disk_host().spared_text(lowered_or_report(p)?).as_text() ?? "")
    0
}

export command emit {
    description: "Print a program's verified LLVM module"
    flags: [time]
    args: [file]
    run: EmitCmd {}
}
