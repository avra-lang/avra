//! `avra emit` — print a program's verified LLVM module. Also owns
//! the analyze-or-refuse step `build` shares.
use @std.cli.{Subcommand, CliResult, Runnable}
use @std.avrac.language.{emit_ll, Program, Analysis}

type EmitCmd = { }

impl Runnable for EmitCmd {
    fn run(self, args: CliResult) -> int {
        on_program(args, (p: Program) -> {
            match lowered_or_report(p) {
                .Ok(path) -> {
                    println(avra_selfhost_read_file(path))
                    0
                }
                .Err(report) -> {
                    println(report)
                    1
                }
            }
        })
    }
}

export fn emit_command() -> Subcommand {
    let body: EmitCmd = EmitCmd { }
    Subcommand { meta: file_command("emit", "Print a program's verified LLVM module"), body: body }
}

/// Analyze, refuse with the report, or write the verified `.ll`
/// beside the source and answer its path.
fn lowered_or_report(p: Program) -> Result<string, string> {
    if !p.clean() { return Result.Err(p.report()) }
    let entry: Analysis? = p.entry_file()
    if entry == null { return Result.Err("the program has no entry") }
    if entry!.p.stmts.is_empty() { return Result.Err("the program is empty") }
    let lo = p.lowered_checked()?
    let path = "${entry!.p.source.file}.ll"
    let failure: string? = emit_ll(lo, path)
    if failure != null { return Result.Err(failure!) }
    Result.Ok(path)
}
