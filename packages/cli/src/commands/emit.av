//! `avra emit` — print a program's verified LLVM module. Also owns
//! the analyze-or-refuse step `build` shares.
use @std.cli.{Subcommand, CliResult, Runnable}
use @std.avrac.language.{avra, emit_ll}
use @std.avrac.diagnostics.{SourceFile}

type EmitCmd = { }

impl Runnable for EmitCmd {
    fn run(self, args: CliResult) -> int {
        let src: SourceFile? = source_arg(args)
        if src == null { return 2 }
        match lowered_or_report(src!) {
            .Ok(path) -> {
                println(avra_selfhost_read_file(path))
                0
            }
            .Err(report) -> {
                println(report)
                1
            }
        }
    }
}

export fn emit_command() -> Subcommand {
    let body: EmitCmd = EmitCmd { }
    Subcommand { meta: file_command("emit", "Print a program's verified LLVM module"), body: body }
}

/// Analyze, refuse with the report, or write the verified `.ll`
/// beside the source and answer its path.
fn lowered_or_report(src: SourceFile) -> Result<string, string> {
    let a = avra().analyze(src)
    if !a.clean() { return Result.Err(a.report()) }
    if a.stmts.is_empty() { return Result.Err("the program is empty") }
    let path = "${src.file ?? "out"}.ll"
    let failure: string? = emit_ll(a.lowered(), path)
    match failure {
        let msg -> Result.Err(msg),
        null -> Result.Ok(path),
    }
}
