//! `avra keys` — the per-file BUILD KEYS, printed. The cache's input
//! identity made inspectable: a reader can see what a rebuild would
//! consider unchanged, and what it would not. Keys move on content alone,
//! so an edit anywhere in a file's bytes — a reindent, a comment — shows
//! here, and so does a change to a SIGNATURE the file can see.
use @std.cli.{Subcommand, CliResult, Runnable}
use @std.avrac.language.{Program, unit_key, module_surface, build_cache_root, surface_holds}
use @std.avrac.core.{module_path, distinct}

type KeysCmd = { }

impl Runnable for KeysCmd {
    fn run(args: CliResult) -> int { phased(args, "keys", keyed) }
}

fn keyed(p: Program) -> Result<int, string> {
    mut ws = p.ws
    for a in p.files { println("${unit_key(ws, a.view.file)}  ${a.view.source.file}") }
    let mods = [module_path(n.split(".")) for n in distinct([ws.module_of(a.view.source.file) for a in p.files])]
    for m in mods {
        println("module ${module_surface(ws, m)}  ${m.text()}")
    }
    let dir = build_cache_root(ws)
    for m in mods {
        let word = if surface_holds(ws, dir, m) { "holds" } else { "MISS " }
        println("record ${word}  ${m.text()}")
    }
    .Ok(0)
}

export fn keys_command() -> Subcommand {
    Subcommand { meta: file_command("keys", "Print each file's build key — what the cache keys on"), body: KeysCmd { } }
}
