//! `avra dev`'s server: the package a page names to answer beside it
//! (`[dev] server = "<path>"`, rooted at the page's package). It is built for
//! this machine, run on a loopback port of its own, told that port as `PORT`,
//! and run again whenever a file its build reads moves. Every request the
//! page does not own is sent on to it, so the page and what it asks for stand
//! on one origin. It is TOLD THE PAGE'S FILES — the module, where the glue
//! stands, every file the page fetches (`AVRA_PAGE_*`, what `app_page`
//! reads) — and run again when they move, so the page it draws names them.
use @std.http_message.message.{Header, Method}
use @std.http.http.{Request, Unrouted, Response, text}
use @std.http.route.{Route, Reach}
use @std.http.fetch.{Payload, fetch, options, Redirects}
use @std.http.frame.{Chunker, Decoded, chunker, limits, unchunked}
use @std.http.http.{Pulled, Stream}
use @std.net.{Conn}
use @std.net.{listen, connect}
use @std.path.{joined_path, normalized}
use @std.process.{Tool, Child, Env, EnvPair, Ready, cmd, tool_at, inherited}
use @std.text.{ascii_lower, parse_int}
use @std.time.{Clock, ms, secs, sleep, host_ms}

/// The server child of one page: its package, the build it runs, the port it
/// is told, the child running now, and what its build read when it last ran.
export type Backend = {
    root: string,
    compiler: Tool,
    port: int,
    child: Cell<Child?>,
    watched: Cell<List<Watched>>,
    binary: Cell<string>,
    page: Cell<List<EnvPair>>,
}

/// The server the page at `page_root` names, nothing built yet — absent when
/// its manifest names none, and the refusal's words when the one it names
/// cannot be served.
export fn backend_of(page_root: string, compiler: Tool) -> Result<Backend?, string> {
    let named? = manifest_at(page_root).dev_server else { return .Ok(null) }
    let root = normalized(joined_path(page_root, named))
    if !is_a_dir(root) { return .Err(no_server_package(named, root)) }
    let door = match listen("127.0.0.1", 0) {
        .Ok(l) -> l,
        .Err(e) -> { return .Err(no_server_port(e.describe().message)) },
    }
    let port = door.port
    let _ = door.close()
    let none: List<Watched> = []
    let idle: Child? = null
    let no_page: List<EnvPair> = []
    .Ok(
        Backend {
            root: root,
            compiler: compiler,
            port: port,
            child: Cell.new(idle),
            watched: Cell.new(none),
            binary: Cell.new(""),
            page: Cell.new(no_page),
        },
    )
}

impl Backend {
    /// Every file the server's build reads, each as it stands now.
    fn looked() -> List<Watched> {
        match build_reads(self.root) {
            .Ok(read) -> [Watched { path: p, mark: mark_of(p) } for p in read],
            .Err(why) -> {
                eprintln("avra: ${why}")
                []
            },
        }
    }

    /// The paths a watch aims at for the server.
    fn paths() -> List<string> { [w.path for w in self.watched.get()] }

    /// ONE TURN: the server built and run again when a file its build reads
    /// moved; answers whether it built. What is remembered is what the build
    /// started from, as the page's turn does.
    fn turn() -> bool {
        let now = self.looked()
        let was = self.watched.get()
        let still = !was.is_empty() &&
            was.length == now.length &&
            [j for j, w in now if was[j].path != w.path || !unmoved(w.path, was[j].mark, w.mark)]
                .is_empty()
        if still { return false }
        match self.built() {
            .Ok(binary) -> self.restarted(binary),
            .Err(report) -> eprintln(server_failed(self.root, report)),
        }
        mut at: Map<string, Mark> = {}
        for w in now { at.set(w.path, w.mark) }
        self.watched.set([w with { mark: at.get(w.path) ?? w.mark } for w in self.looked()])
        true
    }

    /// `avra build` of the server's package for this machine, as a child:
    /// the program it wrote, or everything the build said.
    fn built() -> Result<string, string> {
        let asked = cmd(self.compiler, ["build", self.root]) with { env: inherited() }
        // LICENSED input.live_process: dev builds the server it runs, and no compile answer reads it
        let o = match asked.outcome() {
            .Ok(o) -> o,
            .Err(e) -> { return .Err(e.describe().message) },
        }
        if status_of_exit(o.exit) != 0 { return .Err([o.out.stdout.trim(), o.out.stderr.trim()].filter(it != "").join("\n")) }
        .Ok(o.out.stdout.trim().split("\n").last() ?? "")
    }

    /// The child that ran stopped, and `binary` run in its place on the
    /// server's port, its own words reaching the terminal. The port is
    /// waited on, so the first request after a build finds it listening.
    fn restarted(binary: string) {
        self.stopped()
        self.binary.set(binary)
        let run = cmd(tool_at("server", binary), []) with { env: Env.Inherit([EnvPair { name: "PORT", value: "${self.port}" }].concat(self.page.get())), streams: .Inherited }
        // LICENSED input.live_process: the server dev runs is a child, and no compile answer reads it
        match run.start(Ready.Started, secs(5)) {
            .Ok(c) -> {
                self.child.set(c)
                println(server_line(self.root, self.port, self.listening()))
            },
            .Err(e) -> eprintln(server_failed(self.root, e.describe().message)),
        }
    }

    /// The server told the page's files, and run again with them when they
    /// moved and it has been built.
    fn told(page: List<EnvPair>) {
        if spelled(page) == spelled(self.page.get()) { return }
        self.page.set(page)
        if self.binary.get() != "" { self.restarted(self.binary.get()) }
    }

    /// The page the server draws: its answer to `q` when that is a
    /// document, else nothing — the server draws no page.
    fn drawn(q: Request<Unrouted>) -> Response? {
        let r = self.forward(q)
        if r.status != 200 || !(r.header("content-type") ?? "").starts_with("text/html") { return null }
        r
    }

    /// Whether the server's port takes a connection within five seconds of
    /// the host's time — a server's start is the host's, whatever clock runs.
    fn listening() -> bool {
        // LICENSED input.clock: how long dev waits for its server is timing, never an input of what is built
        let deadline = host_ms() + 5000
        // LICENSED input.clock: how long dev waits for its server is timing, never an input of what is built
        while host_ms() < deadline {
            // LICENSED input.live_process: whether dev's server listens yet, which no compile answer reads
            match connect("127.0.0.1", self.port, ms(200)) {
                .Ok(c) -> {
                    let _ = c.close()
                    return true
                },
                .Err(_) -> sleep(ms(50), clock: Clock.Host),
            }
        }
        false
    }

    /// The child stopped, when one runs.
    fn stopped() {
        let c? = self.child.get() else { return }
        mut running = Child { stage: c.stage, command: c.command }
        let _ = running.stop()
        let idle: Child? = null
        self.child.set(idle)
    }

    /// `q` sent on to the server as it came, and its answer sent back as it
    /// came. A server being run again is waited for, so a request made
    /// while it restarts reaches the new one; a server that does not answer
    /// is a 502 saying so.
    fn forward(q: Request<Unrouted>) -> Response {
        if wants_events(q) {
            let first = relayed(self.port, self.root, q)
            return if first.status == 502 && self.listening() { relayed(self.port, self.root, q) } else { first }
        }
        match self.sent(q) {
            .Ok(r) -> r,
            .Err(why) -> if self.listening() { self.sent(q) catch text(502, not_answered(self.root, why)) } else { text(502, not_answered(self.root, why)) },
        }
    }

    /// `q` sent on to the server once: its answer, or why none came.
    fn sent(q: Request<Unrouted>) -> Result<Response, string> {
        let target = q.target() ?? "/"
        let body = q.body.octets() ?? "".bytes()
        let payload = if body.length == 0 { Payload.Empty } else { Payload.Octets(body, q.header("content-type") ?? "application/octet-stream") }
        let options_sent = options() with { headers: [h for h in fields_of(q) if passes(h.name)], redirects: Redirects.Stop }
        // LICENSED input.live_process: a request dev forwards to its server, which no compile answer reads
        match fetch(q.method(), "http://127.0.0.1:${self.port}${target}", payload, options_sent) {
            .Ok(a) -> .Ok(
                Response {
                    status: a.status,
                    headers: [h for h in a.headers if passes(h.name)],
                    body: a.body,
                },
            ),
            .Err(e) -> .Err(e.describe().message),
        }
    }

    /// The routes the page's address space is shared by with its server. A
    /// target one of the page's files answers is the page's, and any other
    /// goes on to the server: one route per reading method, so the two
    /// never overlap. A method the page never answers is the server's alone.
    fn routes(files: List<Route>) -> List<Route> {
        [f with { serve: (q: Request<Unrouted>, t: Bytes) -> f.serve(q, t) ?? self.forward(q) } for f in files]
            .concat(
                [Route {
                    method: m,
                    pattern: "/{rest...}",
                    reach: Reach.Rest,
                    serve: (q: Request<Unrouted>, _t: Bytes) -> self.forward(q),
                } for m in methods()],
            )
    }
}

/// A request for an event stream sent on to the server and its answer relayed AS IT COMES: the
/// head, then each piece the server writes, so a page's stream reaches the browser the moment the
/// server says something. A server that does not answer is a 502 saying so.
export fn relayed(port: int, root: string, q: Request<Unrouted>) -> Response {
    let target = q.target() ?? "/"
    // LICENSED input.dev_relay: the dev server's own port, relayed for a page — no compile answer reads it
    let c = match connect("127.0.0.1", port, secs(2)) {
        .Ok(up) -> up,
        .Err(e) -> { return text(502, not_answered(root, e.describe().message)) },
    }
    let fields = [h for h in fields_of(q) if passes(h.name)]
    let asked = "GET ${target} HTTP/1.1\r\nHost: 127.0.0.1:${port}\r\nConnection: close\r\n${[f.name + ": " + f.value + "\r\n" for f in fields].join("")}\r\n"
    match c.write(asked.bytes()) {
        .Ok(_) -> {},
        .Err(e) -> { return text(502, not_answered(root, e.describe().message)) },
    }
    let head = heard_head(c)
    let answered? = head else { return text(502, not_answered(root, "the server sent no head for an event stream")) }
    let flow = Flow {
        conn: c,
        pending: Cell.new(answered.rest),
        decoder: Cell.new(chunker(0)),
        chunked: answered.chunked,
    }
    Response {
        status: answered.status,
        headers: [h for h in answered.fields if passes(h.name)],
        stream: Stream { pull: () -> flow.pulled(), ended: () -> { let _ = c.close() } },
    }
}

/// An environment's pairs as one text, for comparing two.
fn spelled(pairs: List<EnvPair>) -> string { ["${p.name}=${p.value}" for p in pairs].join("\n") }

/// Every method the page never answers: the server's alone.
fn methods() -> List<Method> { [.Post, .Put, .Delete, .Patch, .Options] }

/// Every field `q` carries, in the order sent.
fn fields_of(q: Request<Unrouted>) -> List<Header> {
    let fs = q.head.fields
    [Header {
        name: q.raw.slice(fs.name_at(i).lo, fs.name_at(i).hi).text() ?? "",
        value: q.raw.slice(fs.value_at(i).lo, fs.value_at(i).hi).text() ?? "",
    } for i in 0..fs.count()]
}

/// Whether a field passes through the forwarder: one that speaks of a single
/// hop, or that the forwarder's own server writes again (the framing, the
/// date), does not.
fn passes(name: string) -> bool {
    ![
        "host",
        "connection",
        "keep-alive",
        "transfer-encoding",
        "content-length",
        "date",
        "upgrade",
        "te",
        "trailer",
        "proxy-connection",
    ]
        .contains(ascii_lower(name))
}

// ── voices ──

fn no_server_package(named: string, root: string) -> string {
    "`[dev] server = \"${named}\"` names ${root}, which is no package — a server is a package beside the page whose program serves (`server api { … }`)"
}

fn no_server_port(why: string) -> string { "dev: no loopback port could be taken for the server (${why})" }

fn server_failed(root: string, why: string) -> string { "dev: the server ${root} did not start — ${why}" }

fn server_line(root: string, port: int, up: bool) -> string {
    if up { "dev: server ${root} runs on 127.0.0.1:${port}" } else { "dev: server ${root} started, and nothing listens on 127.0.0.1:${port} — its program serves on the `PORT` it is told" }
}

fn not_answered(root: string, why: string) -> string { "the dev server ${root} did not answer: ${why}" }

/// Whether a request asks for an event stream: it names `text/event-stream` among what it accepts.
fn wants_events(q: Request<Unrouted>) -> bool { q.header("accept")?.contains("text/event-stream") ?? false }

/// A reply's head as read off the wire: its status, its fields, whether its body is chunked, and
/// the octets that came after the head in the same reads.
type Head = { status: int, fields: List<Header>, chunked: bool, rest: Bytes }

/// The head of the reply on `c`, read until its blank line; absent when the connection ends or
/// answers nonsense before one.
fn heard_head(c: Conn) -> Head? {
    mut buf = "".bytes()
    let blank = "\r\n\r\n".bytes()
    while buf.index_of(blank, 0) < 0 {
        if buf.length > 65536 { return null }
        let more = match c.read(65536) { .Ok(b) -> b, .Err(_) -> { return null } }
        let b? = more else { return null }
        buf = buf.concat(b)
    }
    let end = buf.index_of(blank, 0)
    let lines = (buf.slice(0, end).text() ?? "").split("\r\n")
    let status = parse_int((lines.first() ?? "").split(" ")[1]) ?? 0
    let fields = [Header { name: l.substring(0, at), value: l.substring(at + 2, l.length) } for l in lines.drop(1) for at in [l.index_of(": ") ?? -1] if at > 0]
    let chunked = fields
        .any(ascii_lower(it.name) == "transfer-encoding" && it.value.contains("chunked"))
    Head { status: status, fields: fields, chunked: chunked, rest: buf.slice(end + 4, buf.length) }
}

/// The body of a relayed reply: the connection it is read from, the octets read and not yet decoded,
/// and the chunk decoder over them.
type Flow = { conn: Conn, pending: Cell<Bytes>, decoder: Cell<Chunker>, chunked: bool }

impl Flow {
    /// The next piece of the body, as the server wrote it, or its end.
    fn pulled() -> Pulled {
        if !self.chunked {
            if !self.pending.get().is_empty() {
                let held = self.pending.get()
                self.pending.set("".bytes())
                return .Data(held)
            }
            return self.more(true)
        }
        while true {
            match unchunked(self.decoder.get(), self.pending.get(), 16777216, limits()) {
                .Piece(b, next) -> {
                    self.decoder.set(next)
                    return .Data(b)
                },
                .More(next) -> {
                    let whole = next.at >= self.pending.get().length
                    self.decoder.set(if whole { next with { at: 0 } } else { next })
                    if whole { self.pending.set("".bytes()) }
                    match self.more(false) {
                        .Data(_) -> {},
                        .End -> { return .End },
                        .Failed -> { return .Failed },
                    }
                },
                .Done(_) -> { return .End },
                .Refused(_) -> { return .Failed },
            }
        }
        .End
    }

    /// What the connection says next: handed on as a piece when `raw`, else kept for the decoder
    /// (answering an empty piece, which a stream skips).
    fn more(raw: bool) -> Pulled {
        match self.conn.read(65536) {
            .Ok(b) -> {
                let said? = b else { return .End }
                if raw { return .Data(said) }
                self.pending.set(self.pending.get().concat(said))
                .Data("".bytes())
            },
            .Err(_) -> .Failed,
        }
    }
}
