//! `avra rules` — every rule the compiler carries (compiler/
//! rules_table.av's `rules` collect), by identity: the ground truth a
//! native idiom finding's kind is checked against. `--markdown` renders
//! DOGFOODING.md's generated block, and `--check-markdown <doc>` holds
//! a doc's committed block to that one rendering.
use @std.cli.{CliResult, Runnable, command, flag, option}
use @std.avrac.compiler.{RuleEntry, rule_id, declared_law, rules as rule_table}
use @std.json.{Json, field, to_text}

type RulesCmd = {}

impl Runnable for RulesCmd {
    fn run(args: CliResult) -> int {
        let doc = args.option("check-markdown")
        if doc != "" { return markdown_said(doc, rule_table) }
        println(
            if args.has_flag("json") { to_text(Json.Arr([rule_json(r) for r in rule_table])) } else if args.has_flag("markdown") { rules_markdown(rule_table) } else { rules_listing(rule_table) },
        )
        0
    }
}

fn rule_json(r: RuleEntry) -> Json {
    Json
        .Obj(
            [
                field("id", Json.Str(rule_id(r))),
                field("module", Json.Str(r.module)),
                field("name", Json.Str(r.name)),
                field("doc", Json.Str(r.doc)),
                field("law", law_json(declared_law(r))),
            ],
        )
}

fn law_json(law: string?) -> Json {
    match law {
        s? -> Json.Str(s)
        null -> Json.Null
    }
}

/// Every rule's identity and doc, one per line in the collect's own
/// order, under a header naming the count.
export fn rules_listing(entries: List<RuleEntry>) -> string {
    ["rules the compiler carries — ${entries.length}"]
        .concat(["${rule_id(r)} — ${r.doc}" for r in entries])
        .join("\n")
}

/// DOGFOODING.md's generated registry block — one bullet per
/// DOCUMENTED rule, in the doc's own established bullet shape (`- id
/// prose`, no separator: the hand-written entries this replaces
/// never used one). An UNDOCUMENTED rule is a sibling of a
/// documented one that already carries the family's doc (the
/// `_defaulted` family, the raw region Ins, the raw mint-emit Ins) —
/// it earns its own bullet the day it earns its own `///`.
export fn rules_markdown(entries: List<RuleEntry>) -> string {
    [documented_bullet(r) for r in documented(entries)].join("\n")
}

fn documented(entries: List<RuleEntry>) -> List<RuleEntry> {
    [r for r in entries if r.doc != ""]
}

fn documented_bullet(r: RuleEntry) -> string {
    "- ${rule_id(r)} ${r.doc}"
}

/// A doc's generated block held to `rules_markdown`'s rendering of
/// the same table, byte for byte: the count of rules rendered and
/// compared, or the first place the two disagree. A doc with no
/// block, or a table with no documented rule, examined nothing and
/// is refused.
export fn block_checked(path: string, doc: string, listed: List<RuleEntry>) -> Result<int, string> {
    if doc.contains("\r") { fail carriage_return(path) }
    let lines = doc.split("\n")
    let start = block_marker(path, lines, block_start)?
    let end = block_marker(path, lines, block_end)?
    if end < start { fail markers_reversed(path, start + 1, end + 1) }
    let n = documented(listed).length
    if n == 0 { fail nothing_rendered(path) }
    let committed = lines.slice(start + 1, end)
    let rendered = rules_markdown(listed).split("\n")
    let at? = first_drift(committed, rendered) else { return .Ok(n) }
    fail block_stale(path, start + at + 2, line_at(committed, at), line_at(rendered, at))
}

const block_start = "<!-- GENERATED:RULES:START -->"
const block_end = "<!-- GENERATED:RULES:END -->"

/// The one line a marker stands on — refused absent or doubled.
fn block_marker(path: string, lines: List<string>, marker: string) -> Result<int, string> {
    let count = [l for l in lines if l == marker].length
    if count == 0 { fail marker_missing(path, marker) }
    if count > 1 { fail marker_doubled(path, marker, count) }
    .Ok(lines.index_of(marker))
}

fn first_drift(committed: List<string>, rendered: List<string>) -> int? {
    let n = if committed.length > rendered.length { committed.length } else { rendered.length }
    [i for i in 0..n if line_at(committed, i) != line_at(rendered, i)].first()
}

fn line_at(lines: List<string>, i: int) -> string? {
    if i < lines.length { return lines[i] }
    null
}

/// `rules --check-markdown <doc>`: the verdict printed, 0 or 1.
fn markdown_said(path: string, entries: List<RuleEntry>) -> int {
    // LICENSED compiler.host_asked_directly: a command's read of the file it was given, at this instant — no query frame is open
    let doc? = disk_host().spared_text(rooted(path)).as_text() else {
        eprintln(unreadable(path))
        return 1
    }
    match block_checked(path, doc, entries) {
        .Ok(n) -> {
            println(block_matches(path, n, entries.length))
            0
        },
        .Err(why) -> {
            eprintln(why)
            1
        },
    }
}

export command rules {
    description: "Every rule the compiler carries, by identity — the ground truth a native idiom finding's kind is checked against"
    flag json { description: "one JSON array of {id, module, name, doc, law}" }
    flag markdown { description: "DOGFOODING.md's generated registry block: one bullet per documented rule" }
    option {
        name: "check-markdown"
        description: "hold a doc's generated registry block to the table's own rendering; refuse the first line that differs"
    }
    run: RulesCmd {}
}

// ── Voices ──────────────────────────────────────────────────────

fn block_matches(path: string, n: int, total: int) -> string {
    "${path}: the generated block matches the rule table — ${n} documented rule(s) rendered and compared, of ${total}"
}

fn unreadable(path: string) -> string {
    "${path}: cannot be read — no generated block to compare"
}

fn carriage_return(path: string) -> string {
    "${path}: holds a carriage return — the generated block is compared line by line, and a line ends at `\\n` alone"
}

fn marker_missing(path: string, marker: string) -> string {
    "${path}: no `${marker}` line — a doc with no generated block has nothing to compare"
}

fn marker_doubled(path: string, marker: string, count: int) -> string {
    "${path}: `${marker}` stands on ${count} lines — the generated block has one start and one end"
}

fn markers_reversed(path: string, start: int, end: int) -> string {
    "${path}:${end}: the block's end marker stands above its start (line ${start})"
}

fn nothing_rendered(path: string) -> string {
    "${path}: the rule table renders no documented rule — a block compared against nothing proves nothing"
}

fn block_stale(path: string, line: int, committed: string?, rendered: string?) -> string {
    "${path}:${line}: the generated block is stale — it holds ${quoted_line(committed)}, the rule table renders ${quoted_line(rendered)}; regenerate it with `avra rules --markdown`"
}

fn quoted_line(line: string?) -> string {
    match line {
        l? -> "`${l}`"
        null -> "nothing"
    }
}
