//! What every command shares: the host externs, the argued source
//! file, the analyze-or-refuse step, and the three CommandSpec shapes.
use @std.cli.{CommandSpec, CliResult, ArgDef, FlagDef}
use @std.avrac.language.{Host, Program, Analysis, TestCase, Workspace, lone_workspace, timed_workspace, programs_workspace, no_target, avra, emit_ll, stage_words}
use @std.avrac.core.{joined, distinct}
use @std.path.{dir_of, under_dir, joined_path}
use @std.process.{Tool, tool, cmd, Command, Exit, Env, Streams, ProcessError, tool_from_env, exit_text, exit}
use @std.time.{now_ns}
use @std.errors.{Error}
use @std.io.{println, eprintln, read_text, write_text, exists, is_dir, list_dir, env}

// THE ONE TRUE EXTERN: no std package owns "re-exec this image".
extern fn avra_exec_self(args: List<string>) -> int

/// The disk, as the workspace's four questions — a listing the host
/// refuses reads as empty (the workspace asks `exists` first); a FILE
/// it refuses is spoken and exits, never parsed as empty.
fn disk_host() -> Host {
    Host {
        exists: (p: string) -> exists(p),
        read: (p: string) -> read_or_die(p),
        list: (dir: string) -> list_dir(dir) catch [],
        is_dir: (dir: string) -> is_dir(dir),
    }
}

/// A source the host gives up, or the refusal spoken and exit 2 — an
/// unreadable file once parsed as an empty program and answered 0.
fn read_or_die(path: string) -> string {
    match read_text(path) {
        .Ok(text) -> text,
        .Err(e) -> {
            let _ = host_refused(e.describe().message)
            exit(Exit.Code(2))
            ""
        }
    }
}

/// The one voice for a path that is not there.
fn no_such_file(path: string) {
    eprintln("avra: no such file: ${path}")
}

/// The argued path, whatever it is.
fn path_arg(args: CliResult) -> string {
    args.arg("file")
}

/// The argued file as a PROGRAM, entered. Null when it does not exist.
fn program_arg(args: CliResult) -> Program? {
    let path = path_arg(args)
    if !exists(path) {
        no_such_file(path)
        return null
    }
    let entered: Program = file_workspace(path).program(path)
    entered
}

/// THE WORKSPACE A NAMED FILE BELONGS TO: its package when it sits
/// under one's `src/` — an `avra.toml` ancestor marks the root; the
/// DIRECTORY OF PROGRAMS when that root has no `src/`, since a program
/// test sits beside its `avra.toml` and every file there is a program
/// of its own; the lone file otherwise.
fn file_workspace(path: string) -> Workspace {
    let held: string? = package_root(dir_of(path))
    if held == null { return lone(path) }
    let root = held!
    let src = joined_path(root, "src")
    if !exists(src) { return programs_workspace(disk_host(), root, avra(), () -> now_ns()) }
    if !under_dir(path, src) { return lone(path) }
    timed_workspace(disk_host(), root, avra(), () -> now_ns())
}

/// A file outside any package: a package of one holding just it.
fn lone(path: string) -> Workspace {
    lone_workspace(path, read_or_die(path), avra())
}

/// The package the command stands in: the CALLER's directory, which
/// the `avra` shim records before moving to the tree's root — a bare
/// `.` would be the tree.
fn here() -> string {
    env("AVRA_CWD") ?? env("PWD") ?? "."
}

/// A package root as a program entered at its `[bin]` when it has
/// one — every file analyzed either way.
fn root_program(root: string) -> Program {
    let ws = timed_workspace(disk_host(), root, avra(), () -> now_ns())
    ws.program(ws.entry_of())
}

/// The argued path as a program: a directory is a package root, a
/// file is entered.
fn program_at(args: CliResult) -> Program? {
    let path = path_arg(args)
    if is_dir(path) {
        let whole: Program = root_program(path)
        return whole
    }
    program_arg(args)
}

/// THE CASE RUN'S PROGRAM: the same workspace, entered NOWHERE.
/// A spec file is not an entry — its cases are the roots, and the
/// entry-only law (a module file runs nothing) would refuse every
/// OTHER file's top level for the crime of not being the one named.
fn caseless_program(args: CliResult) -> Program? {
    let path = path_arg(args)
    if !exists(path) {
        no_such_file(path)
        return null
    }
    if is_dir(path) {
        let whole: Program = timed_workspace(disk_host(), path, avra(), () -> now_ns()).program(null)
        return whole
    }
    let held: Program = file_workspace(path).program(null)
    held
}

/// A command over every case of the argued path — the whole package
/// when a directory, the one FILE's cases when a file. A PACKAGE'S
/// CASES ARE KNOWN FROM PARSING: a package without any says so
/// before a line of it, or of its dependencies, is analyzed.
fn on_cases(args: CliResult, act: fn(Program, List<TestCase>) -> int) -> int {
    let path = path_arg(args)
    if is_dir(path) {
        let held: Workspace? = package_workspace(path)
        if held == null { return 2 }
        mut ws = held!
        let found = ws.parsed_cases()
        // no cases AND a clean parse: a broken spec file parses to no
        // cases, and its refusal is the answer, not a green. A program
        // test the package carries is a proof of its own, so the run
        // goes on.
        if found.is_empty() && ws.parse_clean() && !has_program_tests(ws) {
            println("no spec cases here")
            return 0
        }
        return act(ws.program(null), found)
    }
    let held: Program? = caseless_program(args)
    if held == null { return 2 }
    let p = held!
    let mine = p.cases_at(path)
    if mine.is_empty() { return no_cases_in(p, path) }
    act(p, mine)
}

/// The package a directory names, as a workspace; null, said, when
/// the directory is no package.
fn package_workspace(path: string) -> Workspace? {
    let root: string? = package_root(path)
    if root == null {
        no_target(path)
        return null
    }
    timed_workspace(disk_host(), root!, avra(), () -> now_ns())
}

/// ZERO CASES FOR A NAMED FILE IS A REFUSAL, not a green run: the
/// whole job of `test` is the verdict, and a file the user named
/// that yields none has none to give. A file that did not analyze
/// cleanly has no cases BECAUSE of its diagnostics — those are the
/// answer, never the no-cases voice.
fn no_cases_in(p: Program, path: string) -> int {
    if !p.clean() {
        println(p.report())
        return 1
    }
    eprintln("avra: ${path} holds no spec cases — a file named to `test` carries `spec`/`given`/`then` blocks")
    1
}

/// A command over the argued program — every command's one prologue:
/// no such file exits 2.
fn on_program(args: CliResult, act: fn(Program) -> int) -> int {
    let held: Program? = program_at(args)
    if held == null { return 2 }
    act(held!)
}

/// Analyze, refuse with the report, or write the verified `.ll`
/// beside the source and answer its path — what `emit` and `build`
/// both do before they differ.
fn lowered_or_report(p: Program) -> Result<string, string> {
    if !p.clean() { return .Err(p.report()) }
    let entry: Analysis? = p.entry_file()
    if entry == null { return .Err(p.rendered([no_target(p.ws.root)])) }
    if entry!.view.stmts.is_empty() { return .Err("the program is empty") }
    let lo = p.lowered_checked()?
    let path = "${entry!.view.source.file}.ll"
    let failure: string? = emit_ll(lo, path)
    if failure != null { return .Err(failure!) }
    .Ok(path)
}

/// A clean program's warnings, to stderr — never silent, never
/// blocking.
fn warn(p: Program) {
    let text = p.warnings()
    if text != "" { eprintln(text) }
}

/// The `--time` report: analysis by phase, then what the command
/// itself did, then the memo's hits and misses.
/// The phases, each name once with its times summed — a phase the
/// workspace timed twice (a parse before discovery, its remainder
/// under analysis) reads as one.
fn timings(p: Program, own: string, own_ns: int) -> string {
    let inner = joined(["${name} ${ms(phase_ns(p, name))}" for name in distinct([ph.name for ph in p.phases])], ", ")
    let cache = if p.cache == "" { "" } else { " · memo ${p.cache}" }
    "time: ${inner} · ${own} ${ms(own_ns)}${cache}"
}

/// Nanoseconds as milliseconds with one decimal.
fn ms(ns: int) -> string {
    let tenths = ns / 100000
    "${tenths / 10}.${tenths % 10}ms"
}

/// Every nanosecond the workspace recorded under one phase name.
fn phase_ns(p: Program, name: string) -> int {
    // LICENSED I4: a sum fold, not a scan
    mut total = 0
    for ph in p.phases { if ph.name == name { total = total + ph.ns } }
    total
}

fn timed(args: CliResult) -> bool {
    args.has_flag("time")
}

/// The nearest ancestor holding `avra.toml`, if any.
fn package_root(dir: string) -> string? {
    mut d = dir
    while d.length > 0 {
        if exists("${d}/avra.toml") { return d }
        d = dir_of(d)
    }
    null
}

/// clang links the `.ll` with Avra's runtime — and whatever the
/// program's packages promised their externs — into a native binary.
/// The command is a `Command`, never a shell line: a `[link]` row from
/// any package, the project's own or a dependency's, is one word that
/// means only itself. It runs where the developer does — their
/// environment, their terminal for its words, their Ctrl-C.
/// A PRODUCT links optimized: what `build` answers is run many times.
fn link(ll_path: string, p: Program) -> int {
    linked(ll_path, p, "-O1")
}

/// THE HAND-OFF: every binary a run needs is linked and run by a
/// FRESH image of this program — the stage word, then the plans — so
/// the workspaces this process holds are gone while clang and the
/// binaries run, and a suite peaks at the larger of the two, not
/// their sum. Answers only when the exec failed.
fn handed_off(plans: List<string>) -> int {
    let _ = avra_exec_self(stage_words(plans))
    eprintln("avra: could not run this program again for the link")
    1
}

/// A module's LINK PLAN, written beside it: clang's words one per
/// line, the binary the word after `-o`. It links at -O0 — the hot
/// code is the runtime's, compiled on its own, so the optimizer's
/// seconds buy nothing (measured: 6.6s -> 1.1s to link the suite,
/// the same run time). The plan's path, or the host's refusal.
fn plan_for(ll_path: string, p: Program) -> Result<string, string> {
    let plan = "${ll_path}.link"
    match write_text(plan, joined(clang_words(ll_path, p, "-O0"), "\n")) {
        .Ok(_) -> .Ok(plan),
        .Err(e) -> .Err(plan_unwritten(e.describe().message)),
    }
}

fn plan_unwritten(message: string) -> string {
    "avra: could not write the link plan — ${message}"
}

/// clang's words for a module: the level, the runtime, the package's
/// own objects and flags, the binary's path — the plan a hand-off
/// writes and a product links by.
fn clang_words(ll_path: string, p: Program, opt: string) -> List<string> {
    ["-w", opt, ll_path, "build/avra_runtime.o"].concat(p.ws.link_words()).concat(["-o", binary_name(ll_path)])
}

fn linked(ll_path: string, p: Program, opt: string) -> int {
    match clang_ran(clang_words(ll_path, p, opt)) {
        .Ok(x) -> judged_link(x, ll_path),
        .Err(e) -> refused_by_host(e),
    }
}

/// clang over its words, at the terminal: its exit, or the host's
/// refusal to run it at all.
export fn clang_ran(words: List<string>) -> Result<Exit, ProcessError> {
    (at_the_terminal(cmd(linker()?, words)).outcome()?).exit
}

/// The one voice for a child the host would not run.
export fn refused_by_host(e: ProcessError) -> int {
    host_refused(e.describe().message)
}

/// Anything the host refused, in the error's own words; answers 1.
fn host_refused(message: string) -> int {
    eprintln("avra: ${message}")
    1
}

/// The C compiler that links: `CC`, else `clang` on the PATH — the
/// row `[process.tools] clang` in this package's own manifest says the
/// same, and mints it the day the manifest mints.
fn linker() -> Result<Tool, ProcessError> {
    tool_from_env("CC", "clang")
}

/// A command run where the developer sits: their environment, their
/// terminal for its words, their Ctrl-C reaching it — the compiler's
/// own tools are the developer's, not a service's.
fn at_the_terminal(c: Command) -> Command {
    c with { env: Env.Inherit, streams: Streams.Inherited, own_group: false }
}

/// A binary a link wrote, run at the terminal — its exit, or the
/// host's refusal to run it at all. Spelled with a `/`, the path is
/// the tool, taken as written.
export fn run_binary(binary: string) -> Result<Exit, ProcessError> {
    (at_the_terminal(cmd(tool(binary)?, [])).outcome()?).exit
}

export fn judged_link(x: Exit, ll_path: string) -> int {
    if x is .Clean { return 0 }
    eprintln("avra: clang failed linking ${ll_path} — exited ${exit_text(x)}")
    1
}

/// Linked, and the binary's path said — what `build` answers.
fn spoken_link(ll_path: string, p: Program) -> int {
    let code = link(ll_path, p)
    if code == 0 { println(binary_name(ll_path)) }
    code
}

/// `x.av.ll` builds `x`.
fn binary_name(ll_path: string) -> string {
    let base = if ll_path.ends_with(".ll") { ll_path.substring(0, ll_path.length - 3) } else { ll_path }
    if base.ends_with(".av") { base.substring(0, base.length - 3) } else { base }
}

/// A subcommand over exactly one source-file argument.
fn file_command(name: string, description: string) -> CommandSpec {
    CommandSpec {
        name: name,
        description: description,
        hidden: false,
        flags: [FlagDef { name: "--time", short: "", description: "print phase timings and memo hits", aliases: [] }],
        args: [ArgDef { name: "file", description: "the source file", required: true, variadic: false }],
        options: [],
    }
}

/// A subcommand over positional arguments of its own.
fn arg_command(name: string, description: string, args: List<ArgDef>) -> CommandSpec {
    CommandSpec {
        name: name,
        description: description,
        hidden: false,
        flags: [],
        args: args,
        options: [],
    }
}

/// A subcommand with no arguments.
fn bare_command(name: string, description: string) -> CommandSpec {
    CommandSpec {
        name: name,
        description: description,
        hidden: false,
        flags: [],
        args: [],
        options: [],
    }
}
