//! What every command shares: the host externs, the argued source
//! file, the analyze-or-refuse step, and what every file command takes.
use @std.cli.{CliResult, flag, arg}
use @std.avrac.compiler.{
    Program,
    Workspace,
    lone_workspace,
    timed_workspace,
    programs_workspace,
    avra,
    stage_words,
    build_program,
    Toolchain,
    Checked,
    phase_total,
    BuildError,
    VerifyHeld,
    HeldMismatch,
}
use @std.avrac.core.{joined, distinct}
use @std.path.{dir_of, under_dir, joined_path, is_absolute, normalized, file_name, stem_of}
use @std.process.{
    Tool,
    tool,
    cmd,
    Command,
    Exit,
    Streams,
    inherited,
    ProcessError,
    tool_from_env,
    exit,
}
use @std.time.{now_ns}
use @std.io.{read_text, write_text, exists, is_dir, list_dir, env, make_dirs, stamp, compile_slot}
use @std.avrac.compiler.backend.{emit_ll}
use @std.avrac.compiler.host.{Host, no_target}
use @std.avrac.diagnostics.{Diag, error_at, render, new_source_file}

// THE TWO TRUE EXTERNS: no std package owns "re-exec this image" or
// "where does this image stand".
extern fn avra_exec_self(args: List<string>) -> int
extern fn avra_self_dir() -> string
extern fn avra_selfhost_get_arg_cstr(i: int) -> string

/// The disk, as the workspace's four questions — a listing the host
/// refuses reads as empty (the workspace asks `exists` first); a FILE
/// it refuses is spoken and exits, never parsed as empty.
fn disk_host() -> Host {
    Host {
        exists: (p: string) -> exists(p),
        read: (p: string) -> read_or_die(p),
        list: (dir: string) -> list_dir(dir) catch [],
        write: (p: string, text: string) -> write_file(p, text),
        is_dir: (dir: string) -> is_dir(dir),
        stamp: (p: string) -> stamp(p),
        reads_ahead: (files: int) -> light_or_leave(files),
        std_root: std_root(),
        cwd: env("PWD") ?? ".",
        compiler: own_binary(),
    }
}

/// How many files a LIGHT run may read: an edit's, never a cold tree's.
const LIGHT_READS: int = 16

/// The status a run leaves with when it was asked to stay light and cannot:
/// whoever asked runs it again where heavy work is allowed. Nothing was said
/// and nothing was read.
const TOO_HEAVY: int = 75

/// `AVRA_LIGHT` asks a run to do no heavy work where it stands — the tree's
/// shim tries every package-scale `check`, `build` and `fmt` so, and sends the ones
/// that leave through the machine's watchdog.
fn light_or_leave(files: int) {
    if files > LIGHT_READS && env("AVRA_LIGHT") != null { exit(Exit.Code(TOO_HEAVY)) }
}

/// This binary's own path — the compiler a store's rows are the work of.
fn own_binary() -> string? {
    toolchain_files([file_name(avra_selfhost_get_arg_cstr(0))]).find(exists(it))
}

/// Write a file, making its directory first — a cache keeps artifacts
/// where nothing has stood before.
fn write_file(path: string, text: string) -> string? {
    let _ = make_dirs(dir_of(path))
    match write_text(path, text) { .Ok(_) -> null, .Err(e) -> e.describe().message }
}

/// THE TOOLCHAIN'S STD ROOT, found from the binary's own directory: a
/// checkout keeps its packages beside `build/`, an install keeps them
/// under `lib/avra/std/`. Null when neither stands — a bare binary
/// with no std beside it, which resolves what its manifests declare
/// and nothing more.
fn std_root() -> string? {
    toolchain_files(["../packages", "../lib/avra/std"]).find(is_dir(it))
}

/// The runtime's library, the same two ways: beside the binary in a
/// checkout, under `lib/avra/` in an install.
fn runtime_library() -> string {
    toolchain_files(["libavra_runtime.a", "../lib/avra/libavra_runtime.a"]).find(exists(it)) ?? "build/libavra_runtime.a"
}

/// The wasm runtime archive, under the native one's own directory.
fn wasm_runtime_library() -> string {
    let at = joined_path(dir_of(runtime_library()), "wasm32/libavra_runtime.a")
    if exists(at) { at } else { joined_path("build", "wasm32/libavra_runtime.a") }
}

/// A target's one spelling. `wasm32` and `wasm32-wasi` name the toolchain's
/// own triple; anything else passes through and a backend that knows no such
/// target refuses it by name.
fn canonical_target(spelled: string) -> string {
    match spelled { "wasm" or "wasm32" or "wasm32-wasi" -> "wasm32-unknown-wasi", _ -> spelled }
}

/// Paths under the binary's directory, normalized.
fn toolchain_files(rels: List<string>) -> List<string> {
    [normalized(joined_path(avra_self_dir(), r)) for r in rels]
}

/// A source the host gives up, or the refusal spoken and exit 2 — an
/// unreadable file once parsed as an empty program and answered 0.
fn read_or_die(path: string) -> string {
    match read_text(path) {
        .Ok(text) -> text,
        .Err(e) -> {
            let _ = host_refused(e.describe().message)
            exit(Exit.Code(2))
            ""
        },
    }
}

/// The one voice for a path that is not there.
fn no_such_file(path: string) {
    eprintln("avra: no such file: ${path}")
}

/// The argued path, read where the CALLER stood: the `avra` shim moves
/// to the tree's root before this program reads its arguments, so a
/// relative path is rooted at `AVRA_CWD` — absolutely, so one spelling
/// serves every package root it may sit under, the caller's own
/// directory included.
fn path_arg(args: CliResult) -> string {
    rooted(args.arg("file"))
}

/// AN ABSOLUTE PATH IS NORMALIZED TOO — every `.`/`..` folded here, once,
/// so no downstream walk (a package root's ancestors, a directory's own
/// listing) ever sees one survive: a `..` left in a name a string walk
/// only cuts by segment can widen a path forever instead of shrinking it.
fn rooted(path: string) -> string {
    if is_absolute(path) { return normalized(path) }
    normalized(joined_path(here(), path))
}

/// The argued file as a PROGRAM, entered. Null when it does not exist.
fn program_arg(args: CliResult) -> Program? {
    let path = path_arg(args)
    if !exists(path) {
        no_such_file(path)
        return null
    }
    let ws = file_workspace(path)
    let entered: Program = ws.program(path)
    entered
}

/// THE WORKSPACE A NAMED FILE BELONGS TO: its package when it sits
/// under one's `src/` — an `avra.toml` ancestor marks the root; the
/// DIRECTORY OF PROGRAMS when that root has no `src/` and the file
/// sits DIRECTLY in it, since a program test sits beside its
/// `avra.toml` and every file there is a program of its own; the
/// lone file otherwise. A directory of programs never recurses
/// (`all_files`), so a file it would not find is not one of its
/// programs — checked on its own, never silently skipped.
export fn file_workspace(path: string) -> Workspace {
    let root? = package_root(dir_of(path)) else { return lone(path) }
    let src = joined_path(root, "src")
    if !exists(src) {
        if dir_of(path) != root { return lone(path) }
        return root_workspace(root)
    }
    if !under_dir(path, src) { return lone(path) }
    root_workspace(root)
}

/// A file outside any package: a package of one holding just it.
fn lone(path: string) -> Workspace {
    lone_workspace(path, read_or_die(path), avra())
}

/// A package ROOT'S workspace, the one choice every caller who already
/// knows where the root stands makes: `src/` when it has one, else its own
/// direct files as a directory of programs. `file_workspace` reaches here
/// once it has settled a file's ancestor root; a directory argument IS its
/// own root already, so `build_workspace` reaches here directly.
export fn root_workspace(root: string) -> Workspace {
    if exists(joined_path(root, "src")) {
        timed_workspace(disk_host(), root, avra(), () -> now_ns())
    } else {
        programs_workspace(disk_host(), root, avra(), () -> now_ns())
    }
}

/// The package the command stands in: the CALLER's directory, which
/// the `avra` shim records before moving to the tree's root — a bare
/// `.` would be the tree.
fn here() -> string {
    env("AVRA_CWD") ?? env("PWD") ?? "."
}

/// A package root as a program entered at its `[bin]` when it has
/// one — every file analyzed either way.
export fn root_program(root: string) -> Program {
    let ws = timed_workspace(disk_host(), root, avra(), () -> now_ns())
    ws.program(ws.entry_of())
}

/// A package-scoped command's one door: the package the command
/// stands in, clean — its refusal already reported, so every caller
/// below answers only the absence it was written for.
export fn clean_program() -> Program? {
    let p = root_program(here())
    if !p.clean() {
        eprintln(p.report())
        return null
    }
    p
}

/// A found answer prints and exits clean; an absence explains why and
/// exits 1 — the shape every package-scoped command closes with.
export fn answered(text: string?, absent: string) -> int {
    let text? = text else {
        eprintln("avra: ${absent}")
        return 1
    }
    println(text)
    0
}

/// The argued path as a program: a directory is a package root, a
/// file is entered.
fn program_at(args: CliResult) -> Program? {
    let path = path_arg(args)
    if is_dir(path) {
        let whole: Program = root_program(path)
        return whole
    }
    program_arg(args)
}

/// A command over the argued program — every command's one prologue:
/// no such file exits 2.
fn on_program(args: CliResult, act: fn(Program) -> int) -> int {
    let held? = program_at(args) else { return 2 }
    act(held)
}

/// Analyze, refuse with the report, or write the verified `.ll` under the
/// package's `build/` and answer its path.
fn lowered_or_report(p: Program) -> Result<string, string> {
    if !p.clean() { return .Err(p.report()) }
    let entry? = p.entry_file() else { return .Err(p.rendered([no_target(p.ws.root)])) }
    if entry.view.stmts.is_empty() { return .Err("the program is empty") }
    let lo = p.lowered_checked()?
    let path = joined_path(joined_path(p.ws.root, "build"), "${stem_of(entry.view.source.file)}.ll")
    let _ = make_dirs(dir_of(path))
    let failure: string? = emit_ll(lo, path, "")
    if failure != null { return .Err(failure!) }
    .Ok(path)
}

/// A clean program's warnings, to stderr — never silent, never
/// blocking.
fn warn(p: Program) {
    let text = p.warnings()
    if text != "" { eprintln(text) }
}

/// The `--time` report: analysis by phase, then what the command
/// itself did, then the memo's hits and misses.
/// The phases, each name once with its times summed — a phase the
/// workspace timed twice (a parse before discovery, its remainder
/// under analysis) reads as one.
fn timings(p: Program, own: string, own_ns: int) -> string {
    let inner = joined(
        ["${name} ${ms(phase_total(p.phases, name))}" for name in distinct([ph.name for ph in p.phases])],
        ", ",
    )
    let cache = if p.cache == "" { "" } else { " · memo ${p.cache}" }
    "time: ${inner} · ${own} ${ms(own_ns)}${cache}"
}

/// Nanoseconds as milliseconds with one decimal.
fn ms(ns: int) -> string {
    let tenths = ns / 100000
    "${tenths / 10}.${tenths % 10}ms"
}

fn timed(args: CliResult) -> bool {
    args.has_flag("time")
}

/// The nearest ancestor holding `avra.toml`, if any.
fn package_root(dir: string) -> string? {
    mut d = dir
    while d.length > 0 {
        if exists("${d}/avra.toml") { return d }
        d = dir_of(d)
    }
    null
}

/// THE HAND-OFF: every suite a run linked is run by a FRESH image of this
/// program — the stage word, then the binaries — so the workspaces this
/// process holds are gone while they run, and a suite peaks at the larger of
/// the two, not their sum. Answers only when the exec failed.
fn handed_off(binaries: List<string>) -> int {
    let _ = avra_exec_self(stage_words(binaries))
    eprintln("avra: could not run this program again for the suites")
    1
}

/// The one voice for a child the host would not run.
export fn refused_by_host(e: ProcessError) -> int {
    host_refused(e.describe().message)
}

/// Anything the host refused, in the error's own words; answers 1.
fn host_refused(message: string) -> int {
    eprintln("avra: ${message}")
    1
}

/// The C compiler that links: `CC`, else `clang` on the PATH — the
/// row `[process.tools] clang` in this package's own manifest says the
/// same, and mints it the day the manifest mints.
fn linker() -> Result<Tool, ProcessError> {
    tool_from_env("CC", "clang")
}

/// A command run where the developer sits: their environment, their
/// terminal for its words, their Ctrl-C reaching it — the compiler's
/// own tools are the developer's, not a service's.
fn at_the_terminal(c: Command) -> Command {
    c with { env: inherited(), streams: Streams.Inherited, own_group: false }
}

/// A binary a link wrote, run at the terminal — its exit, or the
/// host's refusal to run it at all. Spelled with a `/`, the path is
/// the tool, taken as written.
export fn run_binary(binary: string) -> Result<Exit, ProcessError> {
    (at_the_terminal(cmd(tool(binary)?, [])).outcome()?).exit
}

/// The wasm host runner beside the compiler: `wasm-node.mjs`, in a checkout
/// or under `lib/avra/` in an install. Null when the toolchain is not installed.
fn wasm_runner() -> string? {
    toolchain_files(["wasm-node.mjs", "../tools/wasm-node.mjs", "../lib/avra/wasm-node.mjs"])
        .find(exists(it))
}

/// `avra run --target wasm`: build the module, then hand it to `node` at the
/// terminal, streaming the program's output exactly as a native run does.
export fn run_wasm_command(args: CliResult) -> int {
    let wasm = match built_binary(args) { .Ok(w) -> w, .Err(code) -> { return code } }
    let runner? = wasm_runner() else {
        eprintln("avra: the wasm runner is not beside the compiler — expected wasm-node.mjs")
        return 2
    }
    let node = match tool_from_env("NODE", "node") {
        .Ok(t) -> t,
        .Err(e) -> { return refused_by_host(e) },
    }
    match at_the_terminal(cmd(node, ["--no-warnings", runner, wasm])).outcome() {
        .Ok(x) -> status_of_exit(x.exit),
        .Err(e) -> refused_by_host(e),
    }
}

/// A child's exit as our own: a trap is not a normal finish.
fn status_of_exit(e: Exit) -> int {
    match e { .Clean -> 0, .Code(n) -> n, .Signal(_, _) -> 2 }
}

// -- THE BUILD CACHE ------------------------------------------------------------------
// The cache is @std.avrac's; what a COMMAND owes it is an argued path, a host that
// can write, and clang run over the words it answers.

/// The workspace a build stands in — a directory is a package root, a file is a lone
/// program — built WITHOUT analysis, so the key is taken before a line is typed.
fn build_workspace(path: string) -> Workspace {
    if is_dir(path) { root_workspace(path) } else { file_workspace(path) }
}

/// The entry a build of this workspace runs: a package's `[bin]`, or the file itself.
fn build_entry(ws: Workspace, path: string) -> string? {
    if is_dir(path) { ws.entry_of() } else { path }
}

/// EVERY BUILD-CACHE COMMAND'S PROLOGUE — `build`, `check`, `test`: the
/// argued path, checked to exist (`no_such_file` spoken and exit 2
/// otherwise). The command mints its workspace from it IN ITS OWN
/// BINDING: a workspace is an identity its hooks capture, so one read
/// out of a record is a copy the hooks never see.
export fn argued_path(args: CliResult) -> string? {
    let path = path_arg(args)
    if !exists(path) {
        no_such_file(path)
        return null
    }
    path
}

/// The argued path, a compile slot taken first when it names a
/// package: a package-scale build, check or test takes one of the
/// machine's slots, and a single file never waits.
export fn slotted_path(args: CliResult) -> string? {
    let path? = argued_path(args) else { return null }
    if is_dir(path) { let _ = compile_slot() }
    path
}

/// `avra check`'s judgement of an argued path — the command and its tests
/// ask this one door.
export fn checked_at(path: string) -> Result<Checked, string> {
    let ws = build_workspace(path)
    ws.checked(build_entry(ws, path))
}

/// `--verify-held`'s own answer, printed the same way `checked_at`'s
/// refusal is: a report, or the ratio one line per mismatch and a summary
/// names what it examined — a check that examined nothing says so.
export fn verify_held_said(path: string) -> int {
    let ws = build_workspace(path)
    match ws.verify_held(build_entry(ws, path)) {
        .Ok(v) -> reported_verify_held(v),
        .Err(report) -> {
            println(report)
            1
        },
    }
}

fn reported_verify_held(v: VerifyHeld) -> int {
    for m in v.mismatches { println(verify_held_line(m)) }
    println(
        "verify-held: ${v.declarations} held declaration(s) in ${v.files} file(s) compared, ${v.mismatches.length} mismatch(es)",
    )
    if v.mismatches.is_empty() { 0 } else { 1 }
}

fn verify_held_line(m: HeldMismatch) -> string {
    "${m.file}\t${m.decl}\t${m.field}\theld=${m.held}\tfresh=${m.fresh}"
}

fn hit_line(reused: bool) -> string {
    if reused { "time: lower+emit · cache hit" } else { "time: lower+emit · built" }
}

/// A build's own failure, wrapped so its full cause is one render away —
/// the top line names the fact, `cause` carries what actually broke.
fn build_failed(e: BuildError) -> Diag {
    error_at("build.command_failed", null, "the build failed") with { cause: e }
}

/// A build failure's report: `Diagnosed` already IS the finished words to
/// print — a full report, sometimes several diagnostics of its own — so
/// it goes straight out rather than nesting under one more `caused by:`
/// line. Every other variant is a short leaf fact, which is exactly what
/// `build_failed`'s cause chain is for.
fn build_report(e: BuildError) -> string {
    match e {
        .Diagnosed(report) -> report,
        .Empty or .EmitFailed(_) or .ModuleUnreadable(_) or .LinkFailed(_) or .ObjectGone(_) or .NotClosed(_) or .Unpublished(_) or .UnsupportedOnWasm(_) -> render(build_failed(e), new_source_file("<build>", "")),
    }
}

/// The binary an argued build writes — or the exit code its refusal spoke.
/// The cache is the library's; the link and the print are the caller's.
export fn built_binary(args: CliResult) -> Result<string, int> {
    let path? = slotted_path(args) else { return .Err(2) }
    let ws = build_workspace(path)
    let entry = build_entry(ws, path)
    if entry == null {
        eprintln("avra: ${ws.root} declares no entry point")
        return .Err(1)
    }
    let tool = match linker() { .Ok(t) -> t, .Err(e) -> { return .Err(refused_by_host(e)) } }
    let target = canonical_target(args.option("target"))
    let runtime = if target == "" { runtime_library() } else { wasm_runtime_library() }
    let wasm_opt = match tool_from_env("WASM_OPT", "wasm-opt") { .Ok(t) -> t.path, .Err(_) -> "" }
    match build_program(
        ws,
        entry!,
        Toolchain {
            opt: if target == "" { "-O1" } else { "-Oz" },
            runtime: runtime,
            linker: tool.path,
            target: target,
            reactor: args.has_flag("wasm_reactor"),
            wasm_opt: wasm_opt,
        },
    ) {
        .Err(e) -> {
            println(build_report(e))
            .Err(1)
        },
        .Ok(b) -> {
            if b.warnings != "" { eprintln(b.warnings) }
            if timed(args) {
                eprintln(hit_line(b.reused))
                if b.phases != "" { eprintln("time: ${b.phases}") }
            }
            .Ok(b.binary)
        },
    }
}

/// `avra build`: the binary's path on stdout, or the refusal.
fn cached_build(args: CliResult) -> int {
    match built_binary(args) {
        .Ok(binary) -> {
            println(binary)
            0
        },
        .Err(code) -> code,
    }
}

/// The flag every file command takes.
export flag time { description: "print phase timings and memo hits" }

/// `check`/`build`'s own: after a warm run, diff every held declaration
/// against a fresh parse+sign of its file.
export flag verify_held {
    description: "diff every held declaration against a fresh parse+sign of its file"
    aliases: ["--verify-held"]
}

/// The source file a file command reads.
export arg file {
    description: "the source file"
    required: true
}
