//! What every command shares: the host externs, the argued source
//! file, the analyze-or-refuse step, and what every file command takes.
use @std.cli.{CliResult, flag, arg}
use @std.avrac.compiler.{
    default_opt,
    Program,
    Workspace,
    lone_workspace_on,
    timed_workspace,
    programs_workspace,
    avra,
    stage_words,
    build_program,
    Toolchain,
    Checked,
    phase_total,
    BuildError,
    BuildOutcome,
}
use @std.avrac.core.{joined, distinct, some_list}
use @std.path.{dir_of, under_dir, joined_path, is_absolute, normalized}
use @std.process.{Tool, tool_at, cmd, Command, Exit, Streams, inherited, ProcessError, exit}
use @std.time.{now_ns}
use @std.program.worked_ahead.{Apart, answered_apart, words_to}
use @std.io.{env, exists, make_dirs, compile_slot, Entry, append_bytes}
use @std.avrac.compiler.backend.{links_with_ld64}
use @std.avrac.compiler.host.{Stamp, Host}
use @std.avrac.diagnostics.{Diag, error_at, render, new_source_file}

// THE TWO TRUE EXTERNS: no std package owns "re-exec this image" or
// "where does this image stand".
extern fn avra_exec_self(args: List<string>) -> int
extern fn avra_self_dir() -> string
extern fn avra_selfhost_get_arg_cstr(i: int) -> string

/// The runtime's library, the same two ways: beside the binary in a
/// checkout, under `lib/avra/` in an install.
fn runtime_library() -> string {
    toolchain_files(["libavra_runtime.a", "../lib/avra/libavra_runtime.a"]).find(exists(it)) ?? "build/libavra_runtime.a"
}

/// The wasm runtime archive, under the native one's own directory.
fn wasm_runtime_library() -> string {
    let at = joined_path(dir_of(runtime_library()), "wasm32/libavra_runtime.a")
    if exists(at) { at } else { joined_path("build", "wasm32/libavra_runtime.a") }
}

/// The triples a toolchain may spell the WASI target, the one this compiler
/// named first leading.
const WASM_TRIPLES: List<string> = ["wasm32-unknown-wasi", "wasm32-wasip1"]

/// The triples a spelled target may mean. `wasm`, `wasm32` and `wasm32-wasi`
/// name the WASI target however this machine's toolchain spells it; anything
/// else is itself, and a backend that knows no such target refuses it by name.
fn triples_of(spelled: string) -> List<string> {
    match spelled { "wasm" or "wasm32" or "wasm32-wasi" -> WASM_TRIPLES, _ -> [spelled] }
}

/// A C compiler and a triple it links a wasm module for.
type WasmTools = { linker: Stamp, target: string }

/// Where a package manager puts an LLVM that carries a WASI libc, asked when
/// `LLVM_PREFIX` names none: the system's own clang has none on macOS. One of two
/// copies: the Makefile's `LLVM_PREFIX` default is the other.
const LLVM_PREFIXES: List<string> = ["/opt/homebrew/opt/llvm", "/usr/local/opt/llvm"]

/// The C compilers that may link a wasm module, in the order they are
/// asked: `CC` alone when it is set — the developer chose — else the LLVM
/// `LLVM_PREFIX` names, then the package managers' prefixes, then `clang`
/// on the PATH.
fn wasm_linkers(look: ToolLookup) -> List<Stamp> {
    let words = if (look.env)("CC") ?? "" != "" {
        [chosen(look, "CC", "clang")]
    } else {
        [joined_path(p, "bin/clang") for p in some_list((look.env)("LLVM_PREFIX")).concat(LLVM_PREFIXES)]
            .concat(["clang"])
    }
    [s for w in words for s in some_list((look.tool)(w))]
}

/// HOW A TOOLCHAIN IS FOUND: a variable of the environment, and the tool a word names — a
/// workspace's own doors for a build that reads one, the host's for one that doesn't.
export type ToolLookup = { env: fn(string) -> string?, tool: fn(string) -> Stamp? }

/// The workspace's doors, as a toolchain asks them.
fn ws_lookup(ws: Workspace) -> ToolLookup { ToolLookup { env: (n: string) -> ws.env(n), tool: (w: string) -> ws.tool(w) } }

/// The host's doors, as a command reads them.
export fn host_lookup() -> ToolLookup {
    ToolLookup {
        env: (n: string) -> env_of(disk_host(), n),
        tool: (w: string) -> disk_host().found(w).as_stamp(),
    }
}

/// A tool a word names, read through the door: the stamp's path with the
/// word's own record — never a second lookup. Absence is `NotFound`, the
/// word answering no tool.
export fn tool(word: string) -> Result<Tool, ProcessError> {
    let stamp? = disk_host().found(word).as_stamp() else {
        return .Err(ProcessError.NotFound(word, env_of(disk_host(), "PATH") ?? ""))
    }
    .Ok(tool_at(word, stamp.path))
}

/// A tool named by the environment through the door (`NODE`), else the
/// fallback word.
export fn tool_from_env(var: string, fallback: string) -> Result<Tool, ProcessError> {
    let named = env_of(disk_host(), var) ?? ""
    tool(if named.is_empty() { fallback } else { named })
}

/// The tools the door read, of those asked for.
fn found(asked: List<Result<Tool, ProcessError>>) -> List<Tool> {
    [t for r in asked for t in match r { .Ok(t) -> [t], .Err(_) -> [] }]
}

/// The word a variable names a tool by, taken as written — a path or a
/// name — or `fallback` when the variable is unset or empty.
fn chosen(look: ToolLookup, name: string, fallback: string) -> string {
    let named = (look.env)(name) ?? ""
    if named.is_empty() { fallback } else { named }
}

/// THE FAST LINKER: lld beside the C compiler, else under `LLVM_PREFIX`, else on the PATH. GNU ld
/// resolves the compiler's own static LLVM link in ~6 s where lld takes ~0.4 s, and a `clang`
/// reached through a symlink directory has no lld beside it.
fn fast_linker(look: ToolLookup, host: Stamp) -> Stamp? {
    let prefix = (look.env)("LLVM_PREFIX") ?? ""
    let beside = (look.tool)(joined_path(dir_of(host.path), "ld.lld"))
    if beside != null { return beside }
    let under = if prefix.is_empty() { null } else { (look.tool)(joined_path(joined_path(prefix, "bin"), "ld.lld")) }
    if under != null { return under }
    (look.tool)("ld.lld")
}

/// Whether `clang` links a module for `triple`: where it says that target's
/// startup object stands is a file. A clang with no libc for the target
/// answers the bare name.
fn links_wasm(clang: Tool, triple: string) -> bool {
    match cmd(clang, ["--target=${triple}", "-print-file-name=crt1.o"]).outcome() {
        .Ok(o) -> is_absolute(o.out.stdout.trim()) && exists(o.out.stdout.trim()),
        .Err(_) -> false,
    }
}

/// A tool the door read, from its stamp alone — the word it was asked
/// by is the path it resolved to.
fn ran(s: Stamp) -> Tool { tool_at(s.path, s.path) }

/// THE WASM TOOLCHAIN THIS MACHINE HAS: the first C compiler, of those that
/// may link, with a WASI libc for one of the triples `spelled` may mean — or
/// what was asked of which, so the refusal says what to point where.
fn wasm_tools(look: ToolLookup, spelled: string) -> Result<WasmTools, string> {
    let triples = triples_of(spelled)
    let linkers = wasm_linkers(look)
    let fits = [WasmTools { linker: clang, target: triple } for clang in linkers for triple in triples if links_wasm(ran(clang), triple)]
    let first? = fits.first() else { return .Err(no_wasm_toolchain([l.path for l in linkers], triples)) }
    first
}

/// Paths under the binary's directory, normalized.
fn toolchain_files(rels: List<string>) -> List<string> {
    [normalized(joined_path(avra_self_dir(), r)) for r in rels]
}

/// A source the host gives up, or the refusal spoken and exit 2 — an
/// unreadable file once parsed as an empty program and answered 0.
fn read_or_die(path: string) -> string {
    match disk_text(path) {
        .Ok(text) -> text,
        .Err(e) -> {
            let _ = host_refused(e.describe().message)
            exit(Exit.Code(2))
            ""
        },
    }
}

/// The one voice for a path that is not there.
fn no_such_file(path: string) {
    eprintln("avra: no such file: ${path}")
}

/// The argued path, read where the CALLER stood: the `avra` shim moves
/// to the tree's root before this program reads its arguments, so a
/// relative path is rooted at `AVRA_CWD` — absolutely, so one spelling
/// serves every package root it may sit under, the caller's own
/// directory included.
fn path_arg(args: CliResult) -> string {
    rooted(args.arg("file"))
}

/// AN ABSOLUTE PATH IS NORMALIZED TOO — every `.`/`..` folded here, once,
/// so no downstream walk (a package root's ancestors, a directory's own
/// listing) ever sees one survive: a `..` left in a name a string walk
/// only cuts by segment can widen a path forever instead of shrinking it.
fn rooted(path: string) -> string {
    if is_absolute(path) { return normalized(path) }
    normalized(joined_path(here(), path))
}

/// The argued file as a PROGRAM, entered. Null when it does not exist.
fn program_arg(args: CliResult) -> Program? {
    let path = path_arg(args)
    // LICENSED compiler.host_asked_directly: a command's read of the path it was given, at this instant — no query frame is open
    let there = match disk_host().there(path) { .Exists(_, t) -> t, rest -> false }
    if !there {
        no_such_file(path)
        return null
    }
    let ws = file_workspace(path)
    let entered: Program = ws.program(path)
    entered
}

/// THE WORKSPACE A NAMED FILE BELONGS TO: its package when it sits
/// under one's `src/` — an `avra.toml` ancestor marks the root; the
/// DIRECTORY OF PROGRAMS when that root has no `src/` and the file
/// sits DIRECTLY in it, since a program test sits beside its
/// `avra.toml` and every file there is a program of its own; the
/// lone file otherwise. A directory of programs never recurses
/// (`all_files`), so a file it would not find is not one of its
/// programs — checked on its own, never silently skipped.
export fn file_workspace(path: string) -> Workspace {
    let root? = file_home(path) else { return lone(path) }
    root_workspace(root)
}

/// THE PACKAGE A NAMED FILE BELONGS TO, by the one rule every door reads: the nearest root an
/// `avra.toml` marks above it, when the file sits under that root's `src/`, or directly in a root
/// with no `src/` — a directory of programs; absent for a lone file, whatever manifest stands
/// further up.
export fn file_home(path: string) -> string? {
    let root? = package_root(dir_of(path)) else { return null }
    let src = joined_path(root, "src")
    // LICENSED compiler.host_asked_directly: a command's read of the path it was given, at this instant — no query frame is open
    let there = match disk_host().there(src) { .Exists(_, t) -> t, rest -> false }
    if !there { return if dir_of(path) == root { root } else { null } }
    if !under_dir(path, src) { return null }
    root
}

/// A file outside any package: a package of one holding just it.
fn lone(path: string) -> Workspace {
    lone_workspace_on(disk_host(), path, read_or_die(path), avra())
}

/// A package ROOT'S workspace, the one choice every caller who already
/// knows where the root stands makes: `src/` when it has one, else its own
/// direct files as a directory of programs. `file_workspace` reaches here
/// once it has settled a file's ancestor root; a directory argument IS its
/// own root already, so `build_workspace` reaches here directly.
export fn root_workspace(root: string) -> Workspace {
    // LICENSED compiler.host_asked_directly: a command's read of the path it was given, at this instant — no query frame is open
    let there = match disk_host().there(joined_path(root, "src")) {
        .Exists(_, t) -> t,
        rest -> false,
    }
    if there {
        // LICENSED input.clock: the workspace's own phase clock, never an input of what is built
        timed_workspace(disk_host(), root, avra(), () -> now_ns())
    } else {
        // LICENSED input.clock: the workspace's own phase clock, never an input of what is built
        programs_workspace(disk_host(), root, avra(), () -> now_ns())
    }
}

/// The package the command stands in: the CALLER's directory, which
/// the `avra` shim records before moving to the tree's root — a bare
/// `.` would be the tree.
fn here() -> string {
    let host = disk_host()
    env_of(host, "AVRA_CWD") ?? env_of(host, "PWD") ?? "."
}

/// A variable through the door: the value, or none when it is unset.
fn env_of(host: Host, name: string) -> string? {
    match host.variable(name) { .Env(_, value) -> value, rest -> null }
}

/// A package root as a program entered at its `[bin]` when it has
/// one — every file analyzed either way.
export fn root_program(root: string) -> Program {
    // LICENSED input.clock: the workspace's own phase clock, never an input of what is built
    let ws = timed_workspace(disk_host(), root, avra(), () -> now_ns())
    ws.program(ws.entry_of())
}

/// A found answer prints and exits clean; an absence explains why and
/// exits 1 — the shape every package-scoped command closes with.
export fn answered(text: string?, absent: string) -> int {
    let text? = text else {
        eprintln("avra: ${absent}")
        return 1
    }
    println(text)
    0
}

/// The argued path as a program: a directory is a package root, a
/// file is entered.
fn program_at(args: CliResult) -> Program? {
    let path = path_arg(args)
    if is_a_dir(path) {
        let whole: Program = root_program(path)
        return whole
    }
    program_arg(args)
}

/// A command over the argued program — every command's one prologue:
/// no such file exits 2.
fn on_program(args: CliResult, act: fn(Program) -> int) -> int {
    let held? = program_at(args) else { return 2 }
    act(held)
}

/// A clean program's warnings, to stderr — never silent, never
/// blocking.
fn warn(p: Program) {
    let text = p.warnings()
    if text != "" { eprintln(text) }
}

/// The `--time` report: analysis by phase, then what the command
/// itself did, then the memo's hits and misses.
/// The phases, each name once with its times summed — a phase the
/// workspace timed twice (a parse before discovery, its remainder
/// under analysis) reads as one.
fn timings(p: Program, own: string, own_ns: int) -> string {
    let phases = p.ws.phases.get()
    let inner = joined(
        ["${name} ${ms(phase_total(phases, name))}" for name in distinct([ph.name for ph in phases])],
        ", ",
    )
    let cache = if p.cache == "" { "" } else { " · memo ${p.cache}" }
    "time: ${inner} · ${own} ${ms(own_ns)}${cache}"
}

/// Nanoseconds as milliseconds with one decimal.
fn ms(ns: int) -> string {
    let tenths = ns / 100000
    "${tenths / 10}.${tenths % 10}ms"
}

fn timed(args: CliResult) -> bool {
    args.has_flag("time")
}

/// The nearest ancestor holding `avra.toml`, if any.
fn package_root(dir: string) -> string? {
    let host = disk_host()
    mut d = dir
    while d.length > 0 {
        // LICENSED compiler.host_asked_directly: a command's read of the path it was given, at this instant — no query frame is open
        let there = match host.there("${d}/avra.toml") { .Exists(_, t) -> t, rest -> false }
        if there { return d }
        d = dir_of(d)
    }
    null
}

/// THE HAND-OFF: every suite a run linked is run by a FRESH image of this
/// program — the stage word, then the binaries — so the workspaces this
/// process holds are gone while they run, and a suite peaks at the larger of
/// the two, not their sum. Answers only when the exec failed.
fn handed_off(binaries: List<string>) -> int {
    let _ = avra_exec_self(stage_words(binaries))
    eprintln("avra: could not run this program again for the suites")
    1
}

/// Whether a test run goes on past a red suite: `AVRA_SUITE_ALL=1` runs every suite, each red one
/// spoken, and leaves by the first red one's code — so one run names every failing case.
// LICENSED input.test_setting: which suites run, never an input of what is built
export fn every_suite() -> bool { env("AVRA_SUITE_ALL") == "1" }

/// THE DOOR LAW, AND THE ONE PLACE A PATH IS CHOSEN: every command that reads a program — `build`,
/// `run`, `check`, `test` — takes the program layer, for a package's directory and for a lone file
/// alike, or refuses once, naming what the layer cannot do yet; it never takes the old path instead.
/// `AVRA_PROGRAM=0` alone takes the old path.
// LICENSED input.debug_flag: which path answers during the switch, never an input of an answer
export fn program_door() -> bool { env("AVRA_PROGRAM") != "0" }

/// THE NET, chosen beside the path: on the program layer the old path judges each program first — a
/// build what its own build reads, a check what its own check reads (`NetJudge`) — and what it
/// refuses stops there in its words; the program layer builds only what it
/// accepts, so a refusal the layer says after it is the layer's defect. `AVRA_PROGRAM_NET=0` takes
/// the net away.
// LICENSED input.debug_flag: which path answers during the switch, never an input of an answer
export fn program_net() -> bool { program_door() && env("AVRA_PROGRAM_NET") != "0" }

/// What the net judges a program by, as the old path's own command for it reads it: a build or a run,
/// the entry's reach, analysed, before anything is lowered; a check, the whole package as its entry
/// sees it; a test, the whole package the path stands in, which its suite reads with no entry of its
/// own.
export enum NetJudge {
    Build
    Check
    Proved
}

/// The net over `paths`: the old path's judgement of each, as `judge` names it, a refusal said in its
/// words — the exit it left by; absent where the net is off or the old path accepts every path.
export fn net_refused(paths: List<string>, judge: NetJudge) -> int? {
    if !program_net() { return null }
    let report? = paths.find_map((p) -> net_report(p, judge)) else { return null }
    println(report)
    1
}

/// What the old path refuses `path` with, judged in a process of its own so the memory it takes
/// leaves with it and never stands under the program layer's; absent where it accepts it, or ends
/// with no verdict. What that process says, and a judgement that ended with none, are the net's own
/// record (`.avra-cache/net-verdict.err`), never the program's words: a net that could not judge
/// leaves the program layer to judge alone, which is what it would say.
fn net_report(path: string, judge: NetJudge) -> string? {
    let at = if is_a_dir(path) { path } else { dir_of(rooted(path)) }
    let _ = make_dirs(joined_path(at, ".avra-cache"))
    let words = joined_path(at, ".avra-cache/net-verdict.err")
    match answered_apart(
        () -> {
            let _ = words_to(words)
            net_verdict(path, judge)
        },
        joined_path(at, ".avra-cache/net-verdict"),
        NET_WITHIN_MS,
    ) {
        .Answered(said) -> if said.starts_with(NET_REFUSED) { said.substring(NET_REFUSED.length, said.length) } else { null },
        .Ended or .Outlasted -> {
            let _ = append_bytes(
                words,
                "avra: the old path's judgement of ${path} ended with no verdict; the program layer judges it alone\n"
                    .bytes(),
            )
            null
        },
    }
}

/// The old path's judgement of `path` as one text: its refusal behind `NET_REFUSED`, or nothing.
fn net_verdict(path: string, judge: NetJudge) -> string {
    let refusal = match judge {
        .Build -> build_refusal(path),
        .Check -> check_refusal(path),
        .Proved -> check_refusal(path_root(path)),
    }
    if refusal == null { "" } else { NET_REFUSED + refusal! }
}

/// What the old path's build of `path` stops on before it lowers — its entry's reach, analysed;
/// absent where it stops on nothing.
fn build_refusal(path: string) -> string? {
    let ws = build_workspace(path)
    match ws.judged_for_build(build_entry(ws, path)) { .Ok(_) -> null, .Err(report) -> report }
}

/// What the old path's `check` of `path` refuses it with; absent where it accepts it.
fn check_refusal(path: string) -> string? {
    match checked_at(path) { .Ok(_) -> null, .Err(report) -> report }
}

/// What a refusing verdict of the net opens with.
const NET_REFUSED: string = "refused\n"

/// How long the net's check may take before it is ended.
const NET_WITHIN_MS: int = 3600000

/// What a program-layer refusal of a program the net accepted is said under: the layer's defect.
export fn false_refusal_header() -> string {
    "program-layer false refusal — the old path accepts this program, so what follows is a defect of the program layer:"
}

/// What the program layer cannot do for `command` yet, said once: exit 2, nothing done.
export fn program_door_refused(command: string, missing: string) -> int {
    eprintln(
        "avra: the program layer can't ${command} this yet — ${missing}; with AVRA_PROGRAM=0 the old path does",
    )
    2
}

/// The one voice for a child the host would not run.
export fn refused_by_host(e: ProcessError) -> int {
    host_refused(e.describe().message)
}

/// Anything the host refused, in the error's own words; answers 1.
fn host_refused(message: string) -> int {
    eprintln("avra: ${message}")
    1
}

/// A command run where the developer sits: their environment, their
/// terminal for its words, their Ctrl-C reaching it — the compiler's
/// own tools are the developer's, not a service's.
fn at_the_terminal(c: Command) -> Command {
    c with { env: inherited(), streams: Streams.Inherited, own_group: false }
}

/// A binary a link wrote, run at the terminal — its exit, or the
/// host's refusal to run it at all. Spelled with a `/`, the path is
/// the tool, taken as written.
export fn run_binary(binary: string) -> Result<Exit, ProcessError> {
    (at_the_terminal(cmd(tool(binary)?, [])).outcome()?).exit
}

/// The wasm host runner beside the compiler: `wasm-node.mjs`, in a checkout
/// or under `lib/avra/` in an install. Null when the toolchain is not installed.
fn wasm_runner() -> string? {
    toolchain_files(["wasm-node.mjs", "../tools/wasm-node.mjs", "../lib/avra/wasm-node.mjs"])
        .find(exists(it))
}

/// `avra run --target wasm`: build the module, then hand it to `node` at the
/// terminal, streaming the program's output exactly as a native run does.
export fn run_wasm_command(args: CliResult) -> int {
    let wasm = match built_binary(args) { .Ok(w) -> w, .Err(code) -> { return code } }
    let runner? = wasm_runner() else {
        eprintln("avra: the wasm runner is not beside the compiler — expected wasm-node.mjs")
        return 2
    }
    let node = match tool_from_env("NODE", "node") {
        .Ok(t) -> t,
        .Err(e) -> { return refused_by_host(e) },
    }
    match at_the_terminal(cmd(node, ["--no-warnings", runner, wasm])).outcome() {
        .Ok(x) -> status_of_exit(x.exit),
        .Err(e) -> refused_by_host(e),
    }
}

/// A child's exit as our own: a trap is not a normal finish.
fn status_of_exit(e: Exit) -> int {
    match e { .Clean -> 0, .Code(n) -> n, .Signal(_, _) -> 2 }
}

// -- THE BUILD CACHE ------------------------------------------------------------------
// The cache is @std.avrac's; what a COMMAND owes it is an argued path, a host that
// can write, and clang run over the words it answers.

/// The workspace a build stands in — a directory is a package root, a file is a lone
/// program — built WITHOUT analysis, so the key is taken before a line is typed.
fn build_workspace(path: string) -> Workspace {
    if is_a_dir(path) { root_workspace(path) } else { file_workspace(path) }
}

/// The entry a build of this workspace runs: a package's `[bin]`, or the file itself.
fn build_entry(ws: Workspace, path: string) -> string? {
    if ws.is_dir(path) { ws.entry_of() } else { path }
}

/// EVERY BUILD-CACHE COMMAND'S PROLOGUE — `build`, `check`, `test`: the
/// argued path, checked to exist (`no_such_file` spoken and exit 2
/// otherwise). The command mints its workspace from it IN ITS OWN
/// BINDING: a workspace is an identity its hooks capture, so one read
/// out of a record is a copy the hooks never see.
export fn argued_path(args: CliResult) -> string? {
    let path = path_arg(args)
    if !exists_at(path) {
        no_such_file(path)
        return null
    }
    path
}

/// Whether a path stands on the disk.
fn exists_at(path: string) -> bool {
    // LICENSED compiler.host_asked_directly: a command's read of the path it was given, at this instant — no query frame is open
    match disk_host().there(path) { .Exists(_, t) -> t, rest -> false }
}

/// A variadic `file`'s paths, each rooted and checked to exist (`no_such_file` spoken for the
/// first that does not), a compile slot taken first when the first names a package.
export fn slotted_paths(args: CliResult) -> List<string>? {
    let paths = [rooted(p) for p in args.args_of("file")]
    let gone = paths.find(!exists_at(it))
    if gone != null {
        no_such_file(gone!)
        return null
    }
    let first? = paths.first() else { return null }
    // LICENSED input.compile_slot: a package-scale command takes one of the machine's slots, which never changes a compile answer
    if is_a_dir(first) { let _ = compile_slot() }
    paths
}

/// The argued path, a compile slot taken first when it names a
/// package: a package-scale build, check or test takes one of the
/// machine's slots, and a single file never waits.
export fn slotted_path(args: CliResult) -> string? {
    let path? = argued_path(args) else { return null }
    // LICENSED input.compile_slot: a package-scale command takes one of the machine's slots, which never changes a compile answer
    if is_a_dir(path) { let _ = compile_slot() }
    path
}

/// `avra check`'s judgement of an argued path — the command and its tests
/// ask this one door.
export fn checked_at(path: string) -> Result<Checked, string> {
    let ws = build_workspace(path)
    ws.checked(build_entry(ws, path))
}

fn hit_line(reused: bool) -> string {
    if reused { "time: lower+emit · cache hit" } else { "time: lower+emit · built" }
}

/// A build's own failure, wrapped so its full cause is one render away —
/// the top line names the fact, `cause` carries what actually broke.
fn build_failed(e: BuildError) -> Diag {
    error_at("build.command_failed", null, "the build failed").caused_by(e)
}

/// A build failure's report: `Diagnosed` already IS the finished words to
/// print — a full report, sometimes several diagnostics of its own — so
/// it goes straight out rather than nesting under one more `caused by:`
/// line. Every other variant is a short leaf fact, which is exactly what
/// `build_failed`'s cause chain is for.
export fn build_report(e: BuildError) -> string {
    match e {
        .Diagnosed(report) -> report,
        .Empty or .EmitFailed(_) or .ModuleUnreadable(_) or .LinkFailed(_, _) or .ObjectGone(_) or .NotClosed(_) or .Unpublished(_) or .UnsupportedOnWasm(_) or .ObjectsMissing(_) -> render(build_failed(e), new_source_file("<build>", "")),
    }
}

/// WHAT A BUILD FOR `target` LINKS WITH — the host's own C compiler and
/// runtime for the empty target, a wasm toolchain found on this machine for
/// any other — or the exit code of the refusal it spoke, naming what is
/// missing and how to point at one. Each tool is an input of `ws`.
export fn toolchain(ws: Workspace, target: string, reactor: bool, debug: bool, fallback: bool) -> Result<
    Toolchain,
    int,
> { toolchain_with(ws_lookup(ws), target, reactor, debug, fallback) }

/// THE TOOLS A BUILD FOR `target` LINKS WITH, found through `look`: the host's C compiler and its fast
/// linker, or for a wasm target the C compiler with a WASI libc, wasm-opt and the wasm runtime
/// archive — or the exit code of the refusal that says which is missing.
export fn toolchain_with(
    look: ToolLookup,
    target: string,
    reactor: bool,
    debug: bool,
    fallback: bool,
) -> Result<Toolchain, int> {
    if target == "" {
        let word = chosen(look, "CC", "clang")
        let host? = (look.tool)(word) else { return .Err(refused_by_host(ProcessError.NotFound(word, (look.env)("PATH") ?? ""))) }
        let ld = if links_with_ld64() { null } else { fast_linker(look, host) }
        return .Ok(
            Toolchain {
                opt: default_opt(""),
                runtime: runtime_library(),
                linker: host.path,
                tools: [host].concat(some_list(ld)),
                ld: ld?.path ?? "",
            },
        )
    }
    let wasm = match wasm_tools(look, target) {
        .Ok(w) -> w,
        .Err(why) -> { return .Err(unequipped(why)) },
    }
    let wasm_opt? = (look.tool)(chosen(look, "WASM_OPT", "wasm-opt")) else { return .Err(unequipped(no_wasm_opt())) }
    if !exists(wasm_runtime_library()) { return .Err(unequipped(no_wasm_runtime(wasm_runtime_library()))) }
    Toolchain {
        opt: default_opt(wasm.target),
        runtime: wasm_runtime_library(),
        linker: wasm.linker.path,
        tools: [wasm.linker, wasm_opt],
        target: wasm.target,
        reactor: reactor,
        debug: debug,
        wasm_opt: wasm_opt.path,
        fallback: fallback,
    }
}

/// A build this machine has no tools for, spoken: exit 2 — nothing was
/// built and nothing about the program was said.
fn unequipped(why: string) -> int {
    eprintln("avra: ${why}")
    2
}

/// The binary an argued build writes — or the exit code its refusal spoke.
/// The cache is the library's; the link and the print are the caller's.
export fn built_binary(args: CliResult) -> Result<string, int> {
    let path? = slotted_path(args) else { return .Err(2) }
    if program_door() {
        let target = args.option("target")
        let tools = if target == "" {
            null
        } else {
            match toolchain_with(
                host_lookup(),
                target,
                args.has_flag("wasm_reactor"),
                args.has_flag("wasm_debug"),
                !args.has_flag("no_wasm_fallback"),
            ) { .Ok(t) -> t, .Err(code) -> { return .Err(code) } }
        }
        let refused = net_refused([path], NetJudge.Build)
        if refused != null { return .Err(refused!) }
        let net = program_net()
        let built = if is_a_dir(path) { program_built(path, timed(args), tools, net, args.has_flag("release")) } else { program_file_built(path, timed(args), tools, net, args.has_flag("release")) }
        let binary = match built { .Ok(b) -> b, .Err(code) -> { return .Err(code) } }
        if !exists_at(binary) {
            eprintln("avra: the program layer wrote no binary at ${binary}")
            return .Err(1)
        }
        return .Ok(binary)
    }
    let ws = build_workspace(path)
    let tools = match toolchain(
        ws,
        args.option("target"),
        args.has_flag("wasm_reactor"),
        args.has_flag("wasm_debug"),
        !args.has_flag("no_wasm_fallback"),
    ) { .Ok(t) -> t, .Err(code) -> { return .Err(code) } }
    let b = built_outcome(ws, path, tools)?
    if b.warnings != "" { eprintln(b.warnings) }
    if timed(args) {
        for line in b.host_fns { eprintln("host fn: ${line}") }
        eprintln(hit_line(b.reused))
        if b.phases != "" { eprintln("time: ${b.phases}") }
    }
    b.binary
}

/// What a build of `path` with `tools` came to — or the exit code its
/// refusal spoke. What it warned of is the caller's to say.
fn built_outcome(ws: Workspace, path: string, tools: Toolchain) -> Result<BuildOutcome, int> {
    let entry? = build_entry(ws, path) else {
        eprintln("avra: ${ws.root} declares no entry point")
        return .Err(1)
    }
    match build_program(ws, entry, tools) {
        .Ok(b) -> b,
        .Err(e) -> {
            println(build_report(e))
            .Err(1)
        },
    }
}

/// `avra build`: the binary's path on stdout, or the refusal.
fn cached_build(args: CliResult) -> int {
    match built_binary(args) {
        .Ok(binary) -> {
            println(binary)
            0
        },
        .Err(code) -> code,
    }
}

/// The flag every file command takes.
export flag time { description: "print phase timings and memo hits" }

/// `check`'s own: what the run did, counted exactly (compiler/work.av).
export flag counts { description: "print the run's exact work counts: files loaded, parsed and minted, queries computed, store KiB written" }

/// The source file a file command reads.
export arg file {
    description: "the source file"
    required: true
}

// ── The voices ──

fn no_wasm_toolchain(asked: List<string>, triples: List<string>) -> string {
    "no C compiler here links a wasm module: ${if asked.is_empty() { "none was found" } else { asked.join(", ") }} ${if asked.length > 1 { "have" } else { "has" }} no WASI libc for ${triples.join(" or ")} — set `CC` to a clang whose `--target=${triples.last() ?? ""} -print-file-name=crt1.o` names a file, or `LLVM_PREFIX` to an LLVM whose `bin/clang` does"
}

fn no_wasm_opt() -> string {
    "a wasm build needs `wasm-opt` (binaryen) — set `WASM_OPT` or install it; the artifact must not depend on which machine built it"
}

fn no_wasm_runtime(at: string) -> string {
    "no wasm runtime archive at ${at} — `make wasm-runtime wasm-packages` builds it"
}
