//! `avra expand <file>` — the file as compiled on the program layer
//! (`file_expanded`): its written items, what each instance and sugar in
//! them means, and each generated declaration after the item it was made
//! over.
use @std.cli.{CliResult, Runnable, command}
use @std.avrac.compiler.{avra_fact_definitions, file_expanded}
use @std.path.{joined_path}
use @std.program.layered_store.{program_store_at}
use @std.program.query_engine.{query_engine}

type ExpandCmd = {}

impl Runnable for ExpandCmd {
    fn run(args: CliResult) -> int {
        let path? = argued_path(args) else { return 2 }
        let aimed = match program_aimed(path) { .Ok(a) -> a, .Err(code) -> { return code } }
        let store = program_store_at(joined_path(aimed.disk.root, ".avra-cache/tapes"))
        let engine = query_engine(store, avra_fact_definitions())
        if timed(args) { engine.time_queries() }
        println(file_expanded(engine, aimed.disk.file_at(aimed.bin)))
        store_kept(engine, store)
        if timed(args) { eprintln(time_rows_said(engine, CHECK_ROWS)) }
        0
    }
}

export command expand {
    description: "Print a file as compiled — its generated declarations"
    flags: [time]
    args: [file]
    run: ExpandCmd {}
}
