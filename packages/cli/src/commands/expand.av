//! `avra expand <file>` — the file as compiled, its generated
//! declarations inlined after their written origins.
use @std.cli.{Subcommand, CliResult, Runnable}
use @std.avrac.compiler.{Program}

type ExpandCmd = { }

impl Runnable for ExpandCmd {
    fn run(args: CliResult) -> int { phased(args, "expand", expanded) }
}

fn expanded(p: Program) -> Result<int, string> {
    let entered? = p.entry_file() else { fail "the program is empty" }
    let a = entered
    println(p.expanded_source(a.view.file))
    0
}

export fn expand_command() -> Subcommand {
    Subcommand { meta: file_command("expand", "Print a file as compiled — its generated declarations"), body: ExpandCmd { } }
}
