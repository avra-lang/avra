// A SIGNAL IS A BROADCAST WAKE: every waiter wakes at one `wake`, a
// wait with nobody waking ends at its own timeout or its task's
// `within`, a wake nobody waits for is kept by nobody, and the
// descriptor waiters park on exists only while one waits.
use @std.net.{Signal, signal}
use @std.time.{ms, secs, sleep, now_ms, within}

/// Waits on `s` for `limit` ms: "woken" or "timed out".
fn sg_waited(s: Signal, limit: int) -> string {
    if s.wait(ms(limit)) { "woken" } else { "timed out" }
}

/// Every one of `n` waiters woken by ONE wake, and the descriptor gone
/// once the last has left.
fn sg_broadcast(n: int) -> string {
    let s = signal()
    let waiters = [spawn sg_waited(s, 2000) for i in 0..n]
    sleep(ms(20))
    let counted = s.wake()
    let said = [w.await for w in waiters]
    "${counted} ${[x for x in said if x == "woken"].length} ${s.fd.get()} ${s.waiting.get()}"
}

/// A wait nobody wakes ends at its own timeout.
fn sg_timeout() -> string {
    let s = signal()
    let t0 = now_ms()
    let said = sg_waited(s, 100)
    "${said} ${now_ms() - t0 >= 90} ${s.fd.get()}"
}

/// A task's `within` ends the wait before its own longer timeout.
fn sg_within() -> string {
    let s = signal()
    let t0 = now_ms()
    let said = within ms(100) { sg_waited(s, 5000) }
    "${said} ${now_ms() - t0 < 1000}"
}

/// A WAKE IS KEPT BY NOBODY: a wake before anyone waits is not heard
/// by a later waiter, which times out.
fn sg_unkept() -> string {
    let s = signal()
    let counted = s.wake()
    "${counted} ${sg_waited(s, 50)}"
}

/// Two wakes before the waiters run ring once, and the next episode —
/// a new descriptor — wakes again.
fn sg_twice_then_again() -> string {
    let s = signal()
    let first = spawn sg_waited(s, 2000)
    sleep(ms(20))
    let a = s.wake()
    let b = s.wake()
    let one = first.await
    let second = spawn sg_waited(s, 2000)
    sleep(ms(20))
    let c = s.wake()
    "${a} ${b} ${one} ${c} ${second.await} ${s.fd.get()}"
}

/// A budget is never a sentinel: a negative timeout is spent, answered
/// at once, and opens nothing.
fn sg_negative() -> string {
    let s = signal()
    let t0 = now_ms()
    let said = sg_waited(s, -1)
    "${said} ${now_ms() - t0 < 50} ${s.fd.get()}"
}

/// A copy is the same signal: a wake through one copy wakes a waiter on
/// another.
fn sg_copies() -> string {
    let s = signal()
    let held = [s]
    let waiter = spawn sg_waited(held[0], 2000)
    sleep(ms(20))
    let _ = s.wake()
    waiter.await
}

spec "std.net signal" {
    given "waiters and one wake" {
        then "one waiter wakes, and the descriptor closes behind it" { sg_broadcast(1) == "1 1 -1 0" }
        then "a hundred waiters all wake at one wake" { sg_broadcast(100) == "100 100 -1 0" }
        then "a copy of the signal wakes a waiter on another copy" { sg_copies() == "woken" }
    }
    given "nobody wakes" {
        then "a wait ends at its own timeout, holding no descriptor after" { sg_timeout() == "timed out true -1" }
        then "the task's within ends it sooner" { sg_within() == "timed out true" }
        then "a negative timeout is spent: answered at once, nothing opened" { sg_negative() == "timed out true -1" }
    }
    given "wakes nobody hears" {
        then "a wake before the wait is kept by nobody" { sg_unkept() == "0 timed out" }
        then "two wakes before the waiter runs ring once, and a later episode wakes again" {
            sg_twice_then_again() == "1 1 woken 1 woken -1"
        }
    }
}
