// The red team's survivors, by attack class: degenerate ports and
// hosts, a timeout that is a budget and never a sentinel, degenerate
// SIZES at the read, verbs on a descriptor that is gone, the poller's
// edges, and the empty write. Every refusal names its verb and its
// subject in the platform's words. Wrong types in every slot were
// attacked and refuse at check time; a package spec cannot pin a
// compile refusal, so they are recorded in the working log.
use @std.net.{listen, listen_all, connect, poller, Listener, Conn, Poller, Read, NetError}
use @std.time.{secs, ms}

fn words<T>(r: Result<T, NetError>) -> string {
    match r {
        .Err(e) -> e.describe().message,
        .Ok(_) -> "<ok>",
    }
}

/// A connected pair with the server side accepted and NOTHING
/// unwatched — `pair` is the settled one; this leaves the listener in
/// the poller, which is what several of these attacks need.
fn attacked() -> Result<Pair, NetError> {
    let l = listen("127.0.0.1", 0)?
    let client = connect("127.0.0.1", l.port, secs(2))?
    let p = poller()?
    p.watch(l.fd, .Read)?
    p.wait(secs(2))?
    let server = l.accept()?
    .Ok(Pair { l: l, client: client, server: server!, p: p })
}

fn gone_names_the_descriptor() -> Result<bool, NetError> {
    let pr = attacked()?
    pr.client.close()?
    let again = words(pr.client.close())
    let read = words(pr.client.read(10))
    let write = words(pr.client.write("x".bytes(), 0))
    .Ok(again.starts_with("close fd ") && read.starts_with("read fd ") && write.starts_with("write fd ") && pr.client.peer() == "")
}

fn poller_edges() -> Result<bool, NetError> {
    let p = poller()?
    let removed = p.watch(999999, .None)?
    let bad = words(p.watch(999999, .Read))
    let nothing = p.wait(ms(10))?
    let l = listen("127.0.0.1", 0)?
    p.watch(l.fd, .Read)?
    p.watch(l.fd, .Both)?
    p.watch(l.fd, .None)?
    let still_nothing = p.wait(ms(10))?
    p.close()?
    .Ok(removed == 999999 && bad.starts_with("watch fd 999999: ") && nothing.is_empty() && still_nothing.is_empty() && words(p.wait(ms(1))).starts_with("wait poller: "))
}

fn empty_writes_and_reads() -> Result<bool, NetError> {
    let pr = attacked()?
    let empty = pr.client.write("".bytes(), 0)?
    let at_end = pr.client.write("abc".bytes(), 3)?
    let huge = pr.server.read(100000000)?
    .Ok(empty == 0 && at_end == 0 && huge is .Pending)
}

fn taken(r: Read) -> int {
    match r {
        .Data(b) -> b.length,
        .Eof -> -1,
        .Pending -> -2,
    }
}

/// A READ OF ZERO TAKES NOTHING OFF THE WIRE. The size is the
/// caller's arithmetic — `read(want - have)` reaches zero the turn a
/// frame is complete — so a zero that reads one byte steals the first
/// byte of the next message and nothing says so. The empty answer is
/// a present, empty landing, told apart from EOF and from a wait.
fn a_read_of_zero_takes_nothing() -> Result<bool, NetError> {
    let pr = attacked()?
    pr.client.write("abcdef".bytes(), 0)?
    pr.p.watch(pr.server.fd, .Read)?
    pr.p.wait(secs(2))?
    let zero = taken(pr.server.read(0)?)
    let rest = taken(pr.server.read(64)?)
    .Ok(zero == 0 && rest == 6)
}

/// A NEGATIVE SIZE IS A BOUND, and a bound is refused by name rather
/// than clamped into a read of one byte.
fn a_negative_read_is_refused() -> Result<bool, NetError> {
    let pr = attacked()?
    let said = words(pr.server.read(0 - 5))
    .Ok(said.starts_with("read 127.0.0.1:") && said.ends_with(": Invalid argument"))
}

/// THE POLLER'S BUDGET IS NEVER A SENTINEL EITHER. `connect` refuses
/// a negative one by name; the wait read it as "forever" and blocked
/// with nothing watched, which is the one thing an event loop's own
/// verb must not do — and absence already spells forever.
fn a_negative_budget_never_waits() -> Result<bool, NetError> {
    let p = poller()?
    let said = words(p.wait(ms(0 - 1)))
    p.close()?
    .Ok(said == "wait poller within -1 ms: Invalid argument")
}

spec "std.net adversarial" {
    given "degenerate ports and hosts" {
        then "a port past 65535 or below 0 is refused with the verb and the subject" {
            words(listen("127.0.0.1", 65536)) == "listen 127.0.0.1:65536: Invalid argument" &&
                words(listen("127.0.0.1", -1)) == "listen 127.0.0.1:-1: Invalid argument"
        }
        then "the loopback names, both families' wildcards and localhost all listen" {
            listen("::1", 0) is .Ok && listen("localhost", 0) is .Ok && listen("0.0.0.0", 0) is .Ok && listen("::", 0) is .Ok
        }
        then "a name that resolves to nothing, a trailing space, and a port inside the host all refuse" {
            words(listen("no.such.host.invalid", 0)).starts_with("listen no.such.host.invalid:0: ") &&
                words(listen("127.0.0.1 ", 0)).starts_with("listen 127.0.0.1 :0: ") &&
                words(listen("127.0.0.1:80", 0)).starts_with("listen 127.0.0.1:80:0: ")
        }
        then "connect refuses an empty host and a port past 65535" {
            words(connect("", 80, secs(1))) == "connect \"\":80: Invalid argument" &&
                words(connect("127.0.0.1", 70000, secs(1))).starts_with("connect 127.0.0.1:70000: ")
        }
    }
    given "a timeout is a budget, never a sentinel" {
        then "a negative timeout is refused rather than read as forever" {
            words(connect("127.0.0.1", 1, ms(-1))) == "connect 127.0.0.1:1 within -1 ms: Invalid argument"
        }
        then "a zero budget looks once and reports the timeout" {
            words(connect("10.255.255.1", 9, ms(0))).contains("timed out")
        }
    }
    given "a descriptor that is gone" {
        then "close, read and write name the descriptor once the peer is gone" { passes(gone_names_the_descriptor()) }
    }
    given "the poller's edges" {
        then "removing the unwatched is fine, watching a bad descriptor refuses, and a closed poller refuses to wait" { passes(poller_edges()) }
    }
    given "the empty write and the empty read" {
        then "an empty write and a write at the end take nothing; a read of a hundred million bytes is pending" { passes(empty_writes_and_reads()) }
    }
    given "degenerate sizes at the read" {
        then "a read of zero answers an empty landing and leaves every byte on the wire" { passes(a_read_of_zero_takes_nothing()) }
        then "a negative size is refused by name, never clamped into a read of one" { passes(a_negative_read_is_refused()) }
        then "a negative budget at the wait is refused rather than read as forever" { passes(a_negative_budget_never_waits()) }
    }
}
