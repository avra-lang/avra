// Loopback, both directions: a listener on the kernel's port, a
// connect, an accept, readiness through the poller, a write and its
// exact read, EOF after a close, and the failures each verb names.
// Every case is a fn answering `Result<bool, NetError>` so `?` reads
// straight, and `passes` is the one seam to the harness.
use @std.net.{listen, listen_all, connect, poller, Listener, Conn, Poller, Read, NetError, Reach}
use @std.time.{secs, ms}

/// A listener, a connected client, the server's side of it, and a
/// poller watching the server side.
type Pair = { l: Listener, client: Conn, server: Conn, p: Poller }

fn pair() -> Result<Pair, NetError> {
    let l = listen("127.0.0.1", 0)?
    let client = connect("127.0.0.1", l.port, secs(2))?
    let p = poller()?
    p.watch(l.fd, .Read)?
    p.wait(secs(2))?
    let server = l.try_accept()?
    p.watch(l.fd, .None)?
    p.watch(server!.fd, .Read)?
    .Ok(Pair { l: l, client: client, server: server!, p: p })
}

/// A listener on any free port of `host`, asked how far it reaches and
/// closed.
fn reach_of(l: Listener) -> Result<Reach, NetError> {
    let far = l.reach()
    let _ = l.close()
    far
}

fn reaches() -> Result<bool, NetError> {
    let alone = reach_of(listen("127.0.0.1", 0)?)?
    let every = reach_of(listen("0.0.0.0", 0)?)?
    let all = reach_of(listen_all(0)?)?
    let six = reach_of(listen("::1", 0)?)?
    alone == Reach.Loopback &&
        every == Reach.Everywhere &&
        all == Reach.Everywhere &&
        six == Reach.Loopback
}

fn passes(r: Result<bool, NetError>) -> bool {
    match r { .Ok(b) -> b, .Err(_) -> false }
}

fn readable(p: Poller, fd: int) -> Result<bool, NetError> {
    let events = p.wait(secs(2))?
    .Ok(events.any(it.fd == fd && it.readable))
}

fn data_of(r: Read) -> Bytes {
    match r { .Data(b) -> b, .Eof -> "<eof>".bytes(), .Pending -> "<pending>".bytes() }
}

fn exact_read() -> Result<bool, NetError> {
    let pr = pair()?
    let sent = "GET / HTTP/1.1\r\n".bytes()
    let put = pr.client.try_write(sent, 0)?
    let ready = readable(pr.p, pr.server.fd)?
    .Ok(put == 16 && ready && data_of(pr.server.try_read(64)?) == sent)
}

fn pending_then_eof() -> Result<bool, NetError> {
    let pr = pair()?
    let before = data_of(pr.server.try_read(64)?)
    pr.client.close()?
    let ready = readable(pr.p, pr.server.fd)?
    .Ok(
        ready &&
            before == "<pending>".bytes() &&
            data_of(pr.server.try_read(64)?) == "<eof>".bytes(),
    )
}

fn half_close() -> Result<bool, NetError> {
    let pr = pair()?
    pr.client.try_write("bye".bytes(), 0)?
    pr.client.shutdown_write()?
    let ready = readable(pr.p, pr.server.fd)?
    let first = data_of(pr.server.try_read(64)?)
    // the shutdown is its own segment: waited for like the data
    let again = readable(pr.p, pr.server.fd)?
    .Ok(
        ready &&
            first == "bye".bytes() &&
            again &&
            data_of(pr.server.try_read(64)?) == "<eof>".bytes(),
    )
}

fn peers() -> Result<bool, NetError> {
    let pr = pair()?
    .Ok(pr.server.peer().starts_with("127.0.0.1:") && pr.client.peer() == "127.0.0.1:${pr.l.port}")
}

fn large_transfer() -> Result<bool, NetError> {
    let pr = pair()?
    let big = [i % 251 for i in 0..300000].bytes()!
    mut at = 0
    mut got: List<Bytes> = []
    mut total = 0
    pr.p.watch(pr.client.fd, .Write)?
    while total < big.length {
        if at < big.length { at = at + pr.client.try_write(big, at)? }
        if readable(pr.p, pr.server.fd)? {
            let piece = data_of(pr.server.try_read(65536)?)
            got.push(piece)
            total = total + piece.length
        }
    }
    .Ok(got.bytes() == big)
}

fn nothing_pending() -> Result<bool, NetError> {
    let l = listen("127.0.0.1", 0)?
    .Ok(l.try_accept()? == null)
}

fn refused_port() -> Result<bool, NetError> {
    let l = listen("127.0.0.1", 0)?
    let port = l.close()?
    let words = words(connect("127.0.0.1", port, secs(2)))
    .Ok(words.starts_with("connect 127.0.0.1:${port}: ") && words.contains("refused"))
}

fn port_in_use() -> Result<bool, NetError> {
    let l = listen("127.0.0.1", 0)?
    .Ok(
        match listen("127.0.0.1", l.port) {
            .Err(e) -> e.describe().kind == "net.listen",
            .Ok(_) -> false,
        },
    )
}

fn every_interface_by_name() -> Result<bool, NetError> {
    let l = listen_all(0)?
    let c = connect("127.0.0.1", l.port, secs(2))?
    c.close()?
    .Ok(l.port > 0)
}

fn listen_words(host: string) -> string { words(listen(host, 0)) }

fn gone_peer() -> Result<bool, NetError> {
    let pr = pair()?
    pr.server.close()?
    // the first write lands in the closed peer's buffer and provokes
    // the reset the second one then meets; its own answer says nothing
    let _ = pr.client.try_write("x".bytes(), 0)
    .Ok(
        match pr.client.try_write([1 for i in 0..100000].bytes()!, 0) {
            .Err(e) -> e.describe().kind == "net.write",
            .Ok(_) -> false,
        },
    )
}

spec "std.net" {
    given "a loopback pair" {
        then "a write on one side is read exactly on the other" { passes(exact_read()) }
        then "a read with nothing pending is Pending, and after the peer closes it is Eof" { passes(pending_then_eof()) }
        then "a shutdown of the write side is read as Eof after the data" { passes(half_close()) }
        then "the peer is the loopback address" { passes(peers()) }
        then "a listener says how far it reaches, as the kernel holds its address" { passes(reaches()) }
        then "a large transfer arrives whole through short writes" { passes(large_transfer()) }
        then "accept with nothing pending answers null" { passes(nothing_pending()) }
    }
    given "the failures each verb names" {
        then "a connect to a closed port is refused, with the verb and the peer in its words" { passes(refused_port()) }
        then "a connect that nobody answers times out within its budget" {
            words(connect("10.255.255.1", 9, ms(200))).contains("timed out")
        }
        then "a listen on a port in use is refused" { passes(port_in_use()) }
        then "an empty host is refused by name, never bound to every interface" {
            listen_words("").starts_with("listen \"\":0: ")
        }
        then "a host holding a NUL is refused by its bytes, not by a C string" {
            listen_words([0].bytes()!.text()! + "127.0.0.1").starts_with("listen ")
        }
        then "every interface is asked for by name" { passes(every_interface_by_name()) }
        then "a write to a peer that has gone is an error, never a death" { passes(gone_peer()) }
    }
}
