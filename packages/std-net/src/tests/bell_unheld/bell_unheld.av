//! proves: a bell wakes every waiter at one ring, and a wait nobody
//! rings ends at its timeout — the same in both engines
use @std.net.{Bell}
use @std.time.{ms, sleep}

fn waited(b: Bell, limit: int) -> string { if b.waited(ms(limit)) is .Ok { "woken" } else { "timed out" } }

let b = Bell {}
let waiters = [spawn waited(b, 2000) for i in 0..5]
sleep(ms(20))
let counted = b.waiting.get()
b.ring()
let said = [w.await for w in waiters]
let lone = waited(b, 30)
"${counted} ${said.join(" ")} | ${lone}"
