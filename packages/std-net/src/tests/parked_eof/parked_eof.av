//! proves: a peer's end is sticky readiness — a reader already parked on
//! a socket wakes to bytes and a FIN that landed together, reads the
//! bytes, then finds the end at once; the short read that drained the
//! bytes never hides the close behind them
use @std.net.{listen, connect, Conn, NetError}
use @std.time.{ms, secs, sleep}

/// The first read (parked until bytes come), then what a second read
/// finds within half a second.
fn two_reads(s: Conn) -> string {
    let first = match s.read(64) { .Ok(b) -> b?.text() ?? "end", .Err(_) -> "failed" }
    let second = match within ms(500) { s.read(64) } {
        .Ok(b) -> if b == null { "end" } else { "more" },
        .Err(e) -> if e.timed_out() { "stalled" } else { "failed" },
    }
    "${first} then ${second}"
}

fn run() -> Result<string, NetError> {
    let l = listen("127.0.0.1", 0)?
    let c = connect("127.0.0.1", l.port, secs(2))?
    let s = l.accept()?
    let reader = spawn two_reads(s)
    sleep(ms(20))
    let _ = c.write("abc".bytes())?
    let _ = c.shutdown_write()?
    let got = reader.await
    let _ = s.close()
    let _ = c.close()
    let _ = l.close()
    .Ok(got)
}

run() catch _ -> "failed"
