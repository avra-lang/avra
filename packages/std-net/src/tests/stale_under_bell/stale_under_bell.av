//! proves: a closed conn's number taken by a bell's pipe stays the
//! bell's — a stale copy's read, shutdown and close are refused as
//! closed, and the bell still wakes the task parked on it
use @std.net.{listen, connect, Bell, NetError}
use @std.time.{ms, secs, sleep}

fn seen<T>(r: Result<T, NetError>) -> string {
    match r { .Ok(_) -> "reached", .Err(e) -> if e.closed() { "closed" } else { e.verb } }
}

fn parked(b: Bell) -> string { if b.waited(ms(2000)) is .Ok { "woken" } else { "timed out" } }

fn run() -> Result<string, NetError> {
    let l = listen("127.0.0.1", 0)?
    let _a = connect("127.0.0.1", l.port, secs(2))?
    let first = l.accept()?
    let copies = [first]
    first.close()?
    let b = Bell {}
    let waiter = spawn parked(b)
    sleep(ms(20))
    let stale = copies[0]
    let reused = b.heard.get() == stale.fd
    let verdicts = [seen(stale.try_read(8)), seen(stale.shutdown_read()), seen(stale.close())]
    b.ring()
    .Ok("reused ${reused} | ${verdicts.join(" ")} | ${waiter.await} | pipe ${b.heard.get()}")
}

run() catch e -> "failed: ${e.verb} ${e.subject} ${e.errno}"
