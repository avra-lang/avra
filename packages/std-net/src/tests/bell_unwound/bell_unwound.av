//! proves: a task cancelled while parked on a bell unwinds — it is
//! counted out of the bell's waiters and the program goes on
use @std.net.{Bell}
use @std.time.{secs, ms, sleep}

fn waits(b: Bell) -> bool { b.waited(secs(5)) is .Ok }

let b = Bell {}
let t = spawn waits(b)
sleep(ms(20))
let parked = b.waiting.get()
t.cancel()
sleep(ms(20))
"${parked} ${b.waiting.get()}"
