// A BELL BETWEEN TASKS: a ring wakes every task parked on it, a ring
// with nobody parked wakes nobody later, a wait that outlasts its time
// fails `timed_out()`, a ring after a wait has ended still reaches the
// next one, and a task that paused between its test and its park
// learns of a ring it missed, while a rouse is no news. Both engines.
use @std.net.{Bell, bell}
use @std.time.{ms, sleep, now_ms}

/// Parks on `b` until it rings — or 2 s pass — and counts itself woken.
fn wakes(b: Bell, woke: Cell<int>) {
    if b.waited(ms(2000)) is .Ok { woke.set(woke.get() + 1) }
}

fn shown() -> string {
    let b = match bell() { .Ok(x) -> x, .Err(_) -> { return "no bell" } }
    let woke = Cell.new(0)
    let start = now_ms()
    if true {
        let parked = Tasks.new()
        for _i in 0..3 { parked.push(spawn wakes(b, woke)) }
        sleep(ms(50))
        b.ring()
    }
    let all_three = woke.get() == 3 && now_ms() - start < 1000
    b.ring()
    let t0 = now_ms()
    let unheard = b.waited(ms(100))
    let early_ring_kept = unheard is .Ok
    let timed = match unheard { .Ok(_) -> false, .Err(e) -> e.timed_out() }
    let waited_out = now_ms() - t0 >= 90
    woke.set(0)
    for _round in 0..50 {
        if true {
            let _one = spawn wakes(b, woke)
            sleep(ms(1))
            b.ring()
        }
    }
    let seen = b.rings()
    b.rouse()
    let t1 = now_ms()
    let roused_waits = b.waited_since(seen, ms(100)) is .Err && now_ms() - t1 >= 90
    b.ring()
    let t2 = now_ms()
    let rung_answers = b.waited_since(seen, ms(2000)) is .Ok && now_ms() - t2 < 50
    b.close()
    [
        "a ring wakes every parked task: ${all_three}",
        "a ring with nobody parked wakes nobody later: ${!early_ring_kept}",
        "a wait past its time fails timed out: ${timed && waited_out}",
        "fifty ring-and-park rounds, fifty wakes: ${woke.get() == 50}",
        "a rouse is no news to a counted wait: ${roused_waits}",
        "a ring since the count answers a counted wait at once: ${rung_answers}",
    ]
        .join("\n")
}

shown()
