//! The dev server, by its own verbs and with no socket: a small page is
//! written to scratch, the loop is turned by hand, and each route is asked
//! as the server frames a request. The compiler is the tree's own, run as
//! the server runs it.
use @std.ui_dev.{Served, Dev, dev}
use @std.http.frame.{framed, limits}
use @std.http.http.{Request, Unrouted, Response}
use @std.http.body.{Body}
use @std.http.route.{compiled, dispatch}
use @std.io.{env, make_dirs, write_text, read_text}
use @std.process.{tool}
use @std.time.{now_ns}

fn tree() -> string { env("PWD") ?? "." }

/// A page that says `words`.
fn page_source(words: string) -> string {
    "use @std.ui.components.{text}\nuse @std.ui.web.{mount}\n\nfn view() -> text { text \"${words}\" }\n\nmount(view)\n"
}

/// A fresh page package in scratch, saying `words`.
fn page_package(words: string) -> string {
    let root = "${tree()}/build/scratch/ui_dev_${now_ns()}"
    let _ = make_dirs("${root}/src")
    let _ = write_text(
        "${root}/avra.toml",
        "[package]\nname = \"ui_dev_page\"\nversion = \"0.1.0\"\n\n[bin]\nname = \"ui_dev_page\"\npath = \"src/main.av\"\n",
    )
    let _ = write_text("${root}/src/main.av", page_source(words))
    root
}

/// A dev server over a fresh page saying `words`, nothing built yet — none
/// when the tree has no compiler.
fn serving(words: string) -> Dev? {
    match tool("${tree()}/build/avra") {
        .Ok(compiler) -> dev(
            Served {
                compiler: compiler,
                root: page_package(words),
                target: "wasm",
                glue: "${tree()}/runtime/dom",
            },
        ),
        .Err(_) -> null,
    }
}

/// A request framed from its line and one more field, with the Host a 1.1
/// request owes.
fn requested(line: string, field: string) -> Request<Unrouted>? {
    let raw = (line + "\r\nHost: h\r\n" + field + "\r\n").bytes()
    match framed(raw, 0, 0, limits()) {
        .Complete(head) -> Request { raw: raw, head: head, body: Body.Empty, peer: "t", params: Unrouted {} },
        .Partial or .Refused(_) -> null,
    }
}

/// The server's whole answer to a GET of `target`; status 0 for one the
/// framer refused.
fn got(d: Dev, target: string) -> Response {
    let q? = requested("GET ${target} HTTP/1.1", "") else { return Response { status: 0 } }
    dispatch(compiled(d.routes()), q)
}

fn body_of(d: Dev, target: string) -> string { got(d, target).body.text() ?? "" }

/// The standing build's three parts: its number, the module's id, and what
/// a failed build said.
fn standing(d: Dev) -> List<string> { body_of(d, "/@dev/build").split("\n") }

/// What a standing says its build failed with: every line past the second.
fn failure_of(standing: List<string>) -> string { [l for j, l in standing if j > 1].join("\n") }

/// What the page's source is rewritten to.
fn rewritten(d: Dev, source: string) { let _ = write_text("${d.serves.root}/src/main.av", source) }

/// WHAT ONE SESSION SAW, each step a word: built, served, edited, broken,
/// mended — so one build of the page answers every claim below.
type Session = {
    equipped: bool,
    first_built: bool,
    idle_built: bool,
    page: string,
    wasm_status: int,
    wasm_kind: string,
    wasm_magic: bool,
    script_kind: string,
    first_id: string,
    edited_built: bool,
    edited_id: string,
    broken_built: bool,
    broken: List<string>,
    broken_wasm_same: bool,
    mended_id: string,
    mended_failure: string,
    numbers: List<string>,
}

/// Whether `module` opens as a wasm module does.
fn is_wasm(module: Bytes) -> bool {
    module.length > 4 &&
        module.at(0) == 0 &&
        module.at(1) == 97 &&
        module.at(2) == 115 &&
        module.at(3) == 109
}

once fn session() -> Session? {
    let d? = serving("one") else { return null }
    let first_built = d.turn()
    let first = standing(d)
    let idle_built = d.turn()
    let page = body_of(d, "/")
    let wasm = got(d, "/app.wasm")
    rewritten(d, page_source("two"))
    let edited_built = d.turn()
    let edited = standing(d)
    let good = got(d, "/app.wasm").body
    rewritten(d, page_source("two") + "fn broken( {\n")
    let broken_built = d.turn()
    let broken = standing(d)
    let still = got(d, "/app.wasm").body
    rewritten(d, page_source("two"))
    let _ = d.turn()
    let mended = standing(d)
    Session {
        equipped: !failure_of(first).contains("no C compiler here links a wasm module"),
        first_built: first_built,
        idle_built: idle_built,
        page: page,
        wasm_status: wasm.status,
        wasm_kind: wasm.header("content-type") ?? "",
        wasm_magic: is_wasm(wasm.body),
        script_kind: got(d, "/dev.js").header("content-type") ?? "",
        first_id: first[1],
        edited_built: edited_built,
        edited_id: edited[1],
        broken_built: broken_built,
        broken: broken,
        broken_wasm_same: still == good,
        mended_id: mended[1],
        mended_failure: failure_of(mended),
        numbers: [first[0], edited[0], broken[0], mended[0]],
    }
}

/// A claim about the session, held wherever this machine can build a page:
/// a machine with no wasm toolchain cannot say, and the compiler's own
/// refusal is what it was served.
fn seen(holds: fn(Session) -> bool) -> bool {
    let s? = session() else { return false }
    !s.equipped || holds(s)
}

spec "std/ui_dev — the loop, turned by hand" {
    given "a page nothing has built" {
        then "the first turn builds it" { seen((s) -> s.first_built && s.first_id != "") }
        then "a turn with nothing moved builds nothing" { seen((s) -> !s.idle_built) }
    }
    given "a page that built" {
        then "the page names the module it is about to load and carries the dev client" {
            seen(
                (s) -> s.page.contains("<meta name=\"avra-module\" content=\"${s.first_id}\">") &&
                    s.page.contains("<script type=\"module\" src=\"./dev.js\"></script>"),
            )
        }
        then "the page is titled by its package and leaves no hole unfilled" {
            seen((s) -> s.page.contains("<title>ui_dev_") && !s.page.contains("<!--"))
        }
        then "the module is served as wasm" {
            seen((s) -> s.wasm_status == 200 && s.wasm_kind == "application/wasm" && s.wasm_magic)
        }
        then "a script is served as a script" { seen((s) -> s.script_kind == "text/javascript; charset=utf-8") }
    }
    given "a source edited" {
        then "the next turn builds, and the module's id moves" {
            seen((s) -> s.edited_built && s.edited_id != "" && s.edited_id != s.first_id)
        }
    }
    given "a source that no longer parses" {
        then "the next turn builds and the standing says what the build said, naming the file" {
            seen((s) -> s.broken_built && failure_of(s.broken).contains("src/main.av"))
        }
        then "the module's id stays the last good one" { seen((s) -> s.broken[1] == s.edited_id) }
        then "the last good module is still what is served" { seen((s) -> s.broken_wasm_same) }
    }
    given "the source mended" {
        then "the failure is gone and the good module stands" {
            seen((s) -> s.mended_failure == "" && s.mended_id == s.edited_id)
        }
    }
    given "the standing's number" {
        then "moves each time the standing does: built, edited, broken, mended" {
            seen((s) -> s.numbers.join(",") == "1,2,3,4")
        }
    }
}

spec "std/ui_dev — what a page is answered before any build" {
    given "a server that has built nothing" {
        then "the module is not served" {
            match serving("x") {
                d? -> got(d, "/app.wasm").status == 503
                null -> false
            }
        }
        then "the standing is number 0, no module, no failure" {
            match serving("x") {
                d? -> body_of(d, "/@dev/build") == "0\n\n"
                null -> false
            }
        }
        then "a path nothing serves is not found" {
            match serving("x") {
                d? -> got(d, "/bootstrap.js.map").status == 404 &&
                    got(d, "/../avra.toml").status != 200
                null -> false
            }
        }
        then "no answer is one a cache may keep" {
            match serving("x") {
                d? -> got(d, "/").header("cache-control") == "no-store" &&
                    got(d, "/bootstrap.js").header("cache-control") == "no-store"
                null -> false
            }
        }
    }
}
