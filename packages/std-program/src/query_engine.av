//! THE ENGINE: asks questions and remembers the answers. A question is a query's name, a hash of
//! its code and its arguments' bytes. While a query runs, every question it asks is recorded as a
//! read, so no read can be forgotten. Asked again in a later process, an answer whose record still stands is reused
//! without running anything, and a recomputed answer that comes out the same leaves its readers
//! standing. Nothing here knows what the queries are about.
use answer_parts.{part_hash_seen, part_in_saved_parts}
use @std.io.{env, stamp}
use @std.text.{from_codepoints, parse_int}
use address.{SourceFileAddress}
use frontier.{Frontier, FrontierLearned, HeldEntry}
use package_sets.{NO_NAMES, NameSets, name_sets}
use input_stamps.{InputStamp, places_now}
use defect.{defect}
use hash_keyed_table.{HashKeyedTable, hash_keyed_table}
use query_times.{QueryTimes, TimedSide, query_times}
use saved_layout.{SavedBytes}
use answer_record.{
    AnswerRecord,
    ContentHash,
    KeptRecord,
    PartSeen,
    Question,
    RecordedRead,
    answer_record,
    content_hash,
    keyed_question,
    QUESTION_SHAPE,
    question,
    hashes_in,
    words_of,
}

/// The package named for a path no store places in one: no store shares it.
const UNPLACED: string = "?"

/// How a query runs.
export type QueryDefinition = {
    query_name: string,
    /// A hash of the query's code and everything it calls. Empty where it can't be known, and
    /// then its answers are never reused.
    code_hash: string,
    /// An input reads the outside world, so it runs once in every process, is never reused, and
    /// its bytes aren't kept.
    is_input: bool,
    compute: fn(QueryEngine, Bytes) -> Bytes,
    /// How its answer is worked out again where it was known before.
    folding: Folding = Folding.Full,
}

/// HOW A QUERY'S ANSWER IS WORKED OUT AGAIN: in full, or FOLDED forward by a step handed its
/// arguments' bytes, its last answer's bytes and each read whose answer moved since,
/// answering the new answer's bytes, or none where it doesn't fold that change.
///
/// THE FULL COMPUTATION IS THE ORACLE: a folded answer is byte for byte the answer the query's
/// own body gives. A fold reads everything the last answer read, as it stands now, and whatever its
/// step asks, so it never reads less than the body would. A query is folded only from its last
/// answer in this binary's frontier, kept and read by the same code; on a cold store, a moved code
/// hash or a step that answers none, the body runs. `AVRA_FOLD_OFF` runs every body in full, and
/// `AVRA_FOLD_CHECK` runs both and traps naming the query where they differ.
export enum Folding {
    Full
    By(step: fn(QueryEngine, Bytes, SavedBytes, List<MovedRead>) -> Bytes?)
}

/// A read whose answer moved since a folded answer was last worked out: its question, and the hash
/// of the answer it gave then.
export type MovedRead = { question: Question, was: ContentHash }

impl QueryDefinition {
    /// The question a call of this query asks.
    fn question_about(arguments: Bytes) -> Question { question(self.query_name, self.code_hash, arguments) }

    /// The question a call of this query asks, its arguments spelled as their keys.
    fn question_keyed(arguments: Bytes) -> Question { keyed_question(self.query_name, self.code_hash, arguments) }
}

/// Where answers outlive a process. A question may hold several records, one per set of reads
/// that answered it, so going back to an earlier state finds its earlier answer.
export trait AnswerStore {
    /// The store answers for the binary printed `print` from here on, reading no other binary's
    /// answers.
    fn answering_for(print: string)

    fn records_of(question: ContentHash) -> List<KeptRecord>

    fn keep_record(asked: Question, record: AnswerRecord)

    /// The question a hash stands for, absent when nothing is kept about it.
    fn question_known_as(question: ContentHash) -> Question?

    /// An answer's bytes where they lie, by their hash, absent when they aren't kept.
    fn answer_bytes(answer: ContentHash) -> SavedBytes?

    fn keep_answer_bytes(answer: ContentHash, bytes: Bytes)

    /// An answer's bytes for this process alone, for what the next process reads afresh anyway.
    fn hold_answer_bytes(answer: ContentHash, bytes: Bytes)

    /// The frontier the binary printed `print` leaves here as it stands, absent when there's none.
    fn frontier_of(print: string) -> Frontier?

    /// Keeps what a process of the binary printed `print` learned beside the frontier it read, for
    /// that binary's frontier, each file of it whole or not at all.
    fn keep_frontier(print: string, learned: FrontierLearned)

    /// Every input this store holds by a stamp.
    fn input_stamps() -> List<InputStamp>

    /// Keeps `stamps` as every input this store holds by a stamp, in place of those it held.
    fn keep_input_stamps(stamps: List<InputStamp>)

    /// The package whose sources hold `path`, absent where the store knows no package there.
    fn package_at(_path: string) -> string? { null }

    /// Whether the package `name` is one this store shares with every store beside it: none,
    /// unless the store is layered over one that's shared.
    fn shares_package(_name: string) -> bool { false }

    /// Keeps a record of a SHARED question: one whose every input lies in packages this store shares.
    fn keep_shared_record(asked: Question, record: AnswerRecord) { self.keep_record(asked, record) }

    /// Keeps a shared question's answer's bytes.
    fn keep_shared_answer_bytes(answer: ContentHash, bytes: Bytes) { self.keep_answer_bytes(answer, bytes) }

    /// Whether an answer's bytes lie where a shared question's answer is kept.
    fn shared_answer_kept(answer: ContentHash) -> bool { self.answer_bytes(answer) != null }
}

/// A run of a query: its answer's bytes and every read it made.
type QueryRun = { bytes: Bytes, reads: HashKeyedTable<RecordedRead> }

/// Reads gathered for work remembered outside the engine, begun while `depth` questions were open:
/// it gathers the reads made while just those are. `reader` is its own serial as a reader.
type ReadsGathered = { depth: int, reads: HashKeyedTable<RecordedRead>, reader: int }

/// A question being answered, its query, and the reads it has made so far.
type OpenQuestion = {
    question: ContentHash,
    query_name: string,
    arguments: Bytes,
    reads: HashKeyedTable<RecordedRead>,
    /// Its serial as a reader.
    reader: int,
}

/// A question this process knows the answer to, by how it came to be known.
enum SettledAnswer {
    /// Learned by its query in this process, reused through a kept record that stands or worked out
    /// from what it read: the answer as the frontier keeps it.
    Learned(entry: HeldEntry)
    /// Standing untouched at its place in this binary's frontier.
    Standing(question: ContentHash, answer: ContentHash, frontier: Frontier, place: int)
}

impl SettledAnswer {
    fn answer() -> ContentHash {
        match self { .Learned(entry) -> entry.answer, .Standing(_, answer, _, _) -> answer }
    }
}

/// What this process knows of its binary's frontier.
enum FrontierState {
    /// Not read yet: nothing has been asked.
    Unread
    /// Read, and there's none.
    Missing
    /// Read, and its reads don't lie within it: none to take answers from.
    Unusable
    /// Its inputs are being asked, so none of its answers stands yet.
    Opening
    /// Open, its suspects known.
    Open(open: OpenFrontier)
}

/// A frontier answers are taken from, the places of its inputs that changed, and whether a changed
/// input reaches each of its answers, by place: what must be checked.
type OpenFrontier = { frontier: Frontier, changed: List<int>, suspects: List<bool> }

/// What this process has learned so far. An identity: every holder asks through the one engine.
export type QueryEngine = {
    store: dyn AnswerStore,
    definitions: Cell<Map<string, QueryDefinition>>,
    /// The answer to each question settled in this process.
    settled_answers: HashKeyedTable<SettledAnswer>,
    /// The questions being answered now, innermost last.
    open_questions: Cell<List<OpenQuestion>>,
    /// The reads being gathered now, innermost last.
    gathering: Cell<List<ReadsGathered>>,
    /// How many readers, questions opened or gatherings begun, this engine has made.
    readers: Cell<int>,
    /// The query each question this process computed belongs to, in the order they ran: what a
    /// budget test reads.
    computed: Cell<List<string>>,
    /// The query each answer this process folded forward belongs to, in the order they were folded.
    folded: Cell<List<string>>,
    /// The kept records this process checked to reuse an answer: what an edit's cost is counted in.
    records_checked: Cell<int>,
    /// What this process knows of its binary's frontier.
    frontier: Cell<FrontierState>,
    /// The questions asked with nobody asking: the roots, which keep what they read in the frontier.
    asked_alone: HashKeyedTable<bool>,
    /// Where this process's asks spend their time, absent while they aren't timed.
    times: Cell<QueryTimes?>,
    /// The inputs the store held by a stamp, by question, once read.
    stamps_kept: Cell<HashKeyedTable<InputStamp>?>,
    /// The inputs this process read under one stamp, or found held by one, by question.
    stamps_seen: HashKeyedTable<InputStamp>,
    /// THE PACKAGES EACH QUESTION SETTLED HERE READ, as a set's id in `sets`: an input's, the package
    /// holding each path it read; any other's, every package its reads read. Known by what was read,
    /// never by who asked first or which way it settled.
    read_sets: HashKeyedTable<int>,
    sets: NameSets,
    /// Whether each set's every package is one the store shares, by the set's id.
    sets_shared: Cell<Map<string, bool>>,
    /// Which engine of this process it is: no two engines a process makes share one. What a table
    /// a caller keeps per engine, outside it, is keyed by.
    serial: int,
}

/// How many engines this process has made.
once fn engines_made() -> Cell<int> { Cell.new(0) }

/// A serial no engine of this process has had.
fn next_serial() -> int {
    let made = engines_made()
    made.set(made.get() + 1)
    made.get()
}

export fn query_engine(store: dyn AnswerStore, definitions: List<QueryDefinition>) -> QueryEngine {
    let by_name: Map<string, QueryDefinition> = {}
    let settled_answers: HashKeyedTable<SettledAnswer> = hash_keyed_table()
    let open_questions: Cell<List<OpenQuestion>> = Cell.new([])
    let gathering: Cell<List<ReadsGathered>> = Cell.new([])
    let computed: Cell<List<string>> = Cell.new([])
    let folded: Cell<List<string>> = Cell.new([])
    let asked_alone: HashKeyedTable<bool> = hash_keyed_table()
    let times: Cell<QueryTimes?> = Cell.new(null)
    let stamps_kept: Cell<HashKeyedTable<InputStamp>?> = Cell.new(null)
    let stamps_seen: HashKeyedTable<InputStamp> = hash_keyed_table()
    let read_sets: HashKeyedTable<int> = hash_keyed_table()
    let sets_shared: Cell<Map<string, bool>> = Cell.new({})
    let engine = QueryEngine {
        store: store,
        definitions: Cell.new(by_name),
        settled_answers: settled_answers,
        open_questions: open_questions,
        gathering: gathering,
        readers: Cell.new(0),
        computed: computed,
        folded: folded,
        records_checked: Cell.new(0),
        frontier: Cell.new(FrontierState.Unread),
        asked_alone: asked_alone,
        times: times,
        stamps_kept: stamps_kept,
        stamps_seen: stamps_seen,
        read_sets: read_sets,
        sets: name_sets(),
        sets_shared: sets_shared,
        serial: next_serial(),
    }
    for definition in definitions {
        if engine.definitions.get().has(definition.query_name) { defect(two_queries_named(definition)) }
        engine.definitions.put(definition.query_name, definition)
    }
    store.answering_for(engine.print())
    engine
}

impl QueryEngine {
    /// The answer's bytes where they lie, recorded as a read of the whole answer.
    fn answer_to(asked: Question) -> SavedBytes {
        self.answer_bytes_of(asked, self.hash_of_answer_to(asked))
    }

    /// An answer's bytes. A record may stand with its bytes no longer kept, and then it runs.
    fn answer_bytes_of(asked: Question, answer: ContentHash) -> SavedBytes {
        self.store.answer_bytes(answer) ?? self.store.answer_bytes(self.computed_answer(asked))!
    }

    /// The hash of the answer to the question known as `question`, recorded as a read of whoever is
    /// asking, as `hash_of_answer_to` records it; absent where neither this process nor the store
    /// knows the question.
    fn hash_of_answer_known_as(question: ContentHash) -> ContentHash? {
        self.frontier_read_once()
        let settled? = self.settled_now(question) else { return null }
        let answer = settled.answer()
        self.record_read(RecordedRead { question: question, whole_answer: answer, part: null })
        answer
    }

    /// The hash of the answer to `held`'s question, recorded as a read of whoever is asking, as
    /// `hash_of_answer_to` records it: settled once in this engine, and read off `held` after.
    fn hash_of_answer_held(held: HeldQuestion) -> ContentHash {
        let answer = if held.settled_in.get() == self.serial { held.answer.get() } else { self.held_settled(held) }
        self
            .record_read(RecordedRead { question: held.question.known_as, whole_answer: answer, part: null })
        answer
    }

    /// The answer `held`'s question settles to in this engine, kept on `held`.
    fn held_settled(held: HeldQuestion) -> ContentHash {
        let answer = self.settled_answer(held.question)
        held.answer.set(answer)
        held.settled_in.set(self.serial)
        answer
    }

    /// The hash of the answer, recorded as a read of whoever is asking. Nothing is decoded.
    fn hash_of_answer_to(asked: Question) -> ContentHash {
        let answer = self.settled_answer(asked)
        self
            .record_read(RecordedRead { question: asked.known_as, whole_answer: answer, part: null })
        answer
    }

    /// What this process knows the answer is, reusing a record that stands, or running the query.
    /// The frontier is read before anything is looked up, so an input it holds is asked once.
    fn settled_answer(asked: Question) -> ContentHash {
        self.frontier_read_once()
        self.settled_answers.get(asked.known_as)?.answer() ?? self
            .settled_from_frontier(asked.known_as)?.answer() ?? self.reused_answer(asked) ?? self
            .computed_answer(asked)
    }

    /// The answer of a record whose reads all still see what they saw. An input is read fresh in
    /// every process, and a query whose code has no hash can't tell its old answers from new ones.
    fn reused_answer(asked: Question) -> ContentHash? {
        let definition = self.definition_of(asked)
        if definition.is_input || definition.code_hash.is_empty() { return null }
        self.times.get()?.opened(asked.query_name, TimedSide.Reused)
        let answer = self.standing_answer(asked)
        self.times.get()?.closed()
        answer
    }

    /// The answer of a kept record of `asked` that stands, absent when none does.
    fn standing_answer(asked: Question) -> ContentHash? {
        let standing? = self
            .store
            .records_of(asked.known_as)
            .find((record) -> self.stands_now(record)) else { return null }
        let reads = standing.read_question_words()
        self.read_sets.put(asked.known_as, self.set_of_reads(reads))
        self.learned(asked, standing.answer, reads)
    }

    /// Whether every read of a record still sees what it saw.
    fn stands_now(record: KeptRecord) -> bool {
        self.records_checked.set(self.records_checked.get() + 1)
        record
            .every_read(
                (question, seen) -> self.answer_holds(question, seen),
                (question, seen, part_name, part_hash) -> self.answer_holds(question, seen) ||
                    self.part_holds(question, part_name, part_hash),
            )
    }

    /// Whether a question's whole answer is still the one seen. A question nobody can ask now never
    /// holds.
    fn answer_holds(question: ContentHash, seen: ContentHash) -> bool {
        let settled? = self.settled_now(question) else { return false }
        settled.answer().same_as(seen)
    }

    /// Whether one part of a question's answer is still the one seen. An answer this process can't
    /// read has no part to see.
    fn part_holds(question: ContentHash, part_name: ContentHash, part_hash: ContentHash) -> bool {
        let settled? = self.settled_now(question) else { return false }
        let bytes? = self.settled_bytes(question, settled.answer()) else { return false }
        part_hash_seen(part_in_saved_parts(bytes, part_name)).same_as(part_hash)
    }

    /// What this process says a question's answer is, settling it if it must, absent for a
    /// question nobody can ask now. What's settled was asked by today's code, so it isn't rechecked.
    fn settled_now(question: ContentHash) -> SettledAnswer? {
        self.settled_answers.get(question) ?? self.settled_from_frontier(question) ?? self
            .settled_by_asking(question)
    }

    /// An answer this binary's frontier holds standing, settled as it stands: one no changed input
    /// reaches, and one a change reaches whose every read is still what it read there. A change that
    /// re-settles equal stops at its readers, and no record of theirs is read.
    fn settled_from_frontier(question: ContentHash) -> SettledAnswer? {
        let open? = self.frontier_open() else { return null }
        let f = open.frontier
        let at? = f.place_of(question) else { return null }
        if !f.stands(at) || f.input_at(at) { return null }
        if open.suspects[at] && !self.reads_hold(open, at) { return null }
        self.stood(f, at)
    }

    /// How many inputs this binary's frontier read that no longer hold; absent without a frontier.
    fn inputs_moved() -> int? {
        let open? = self.frontier_open() else { return null }
        open.changed.length
    }

    /// Whether every answer the frontier's `at` read is still the one it read there: a read no
    /// change reaches holds where it stands, and one a change reaches is settled and compared.
    fn reads_hold(open: OpenFrontier, at: int) -> bool {
        let reads? = open.frontier.reads_at(at) else { return false }
        reads.all((r) -> self.read_holds(open, r))
    }

    /// Whether the frontier's answer at `r` is still its answer.
    fn read_holds(open: OpenFrontier, r: int) -> bool {
        let f = open.frontier
        if !open.suspects[r] && f.stands(r) { return true }
        let settled? = self.settled_now(f.question_at(r)) else { return false }
        settled.answer().same_as(f.answer_at(r))
    }

    /// The answer at `at` in `f`, settled as it stands there.
    fn stood(f: Frontier, at: int) -> SettledAnswer {
        let question = f.question_at(at)
        let settled = SettledAnswer.Standing(question, f.answer_at(at), f, at)
        self.settled_answers.put(question, settled)
        settled
    }

    /// This binary's frontier with its suspects known; absent while there's none, or while its
    /// inputs are being asked.
    fn frontier_open() -> OpenFrontier? {
        self.frontier_read_once()
        match self.frontier.get() {
            .Open(open) -> open,
            .Unread or .Missing or .Unusable or .Opening -> null,
        }
    }

    /// Reads this binary's frontier the first time anything is asked.
    fn frontier_read_once() {
        match self.frontier.get() {
            .Unread -> self.frontier_opened(),
            .Missing or .Unusable or .Opening or .Open(_) -> { return },
        }
    }

    /// Reads this binary's frontier and asks its standing inputs first, so every answer a changed
    /// input reaches is a suspect and each input that held stands. A frontier whose reads don't lie
    /// within it is none.
    fn frontier_opened() {
        self.frontier.set(FrontierState.Opening)
        if self.unhashed() { return self.frontier.set(FrontierState.Missing) }
        let f? = self.store.frontier_of(self.print()) else { return self.frontier.set(FrontierState.Missing) }
        let inputs = f.standing_inputs()
        let changed = inputs.filter((at) -> !self.input_holds(f, at))
        let suspects? = self.suspects_of(f, changed) else { return self.frontier.set(FrontierState.Unusable) }
        for at in inputs { if !suspects[at] { let _ = self.stood(f, at) } }
        self
            .frontier
            .set(
                FrontierState
                    .Open(OpenFrontier { frontier: f, changed: changed, suspects: suspects }),
            )
    }

    /// Whether the store held a frontier for this binary.
    fn frontier_found() -> bool {
        self.frontier_read_once()
        match self.frontier.get() {
            .Unread or .Missing -> false,
            .Unusable or .Opening or .Open(_) -> true,
        }
    }

    /// WHY `question` WAS WORKED OUT AGAIN, by the frontier it was taken from: a changed input first,
    /// then each answer that read the one before, the question last. Absent where the frontier
    /// doesn't hold it, nothing changed reaches it, or there was no frontier to take it from.
    fn worked_out_because(question: ContentHash) -> List<Question>? {
        let open? = self.frontier_open() else { return null }
        let at? = open.frontier.place_of(question) else { return null }
        if !open.suspects[at] { return null }
        let way? = open.frontier.way_to(open.changed, at) else { return null }
        let asked = [self.store.question_known_as(open.frontier.question_at(p)) for p in way]
        if asked.any(it == null) { null } else { [q! for q in asked] }
    }

    /// Whether a change in `changed` reaches each answer of `f`; absent when its reads don't lie
    /// within it.
    fn suspects_of(f: Frontier, changed: List<int>) -> List<bool>? {
        if changed.is_empty() { [false for _i in 0..f.length()] } else { f.readers_of(changed) }
    }

    /// Whether the input at `at` answers now what it answered when the frontier was written.
    fn input_holds(f: Frontier, at: int) -> bool {
        if self.stamp_holds(f.question_at(at), f.answer_at(at)) { return true }
        let asked? = self.store.question_known_as(f.question_at(at)) else { return false }
        let definition? = self.definitions.get().get(asked.query_name) else { return false }
        if definition.code_hash != asked.code_hash { return false }
        self.settled_answer(asked).same_as(f.answer_at(at))
    }

    /// What tells this binary's queries apart from another's: each one's name, its code, and whether
    /// it reads the world.
    fn print() -> string {
        let defined = ["${d.query_name}:${d.code_hash}:${d.is_input}" for d in self.definitions.get().values()]
            .join("\n")
        let h = content_hash("${QUESTION_SHAPE}\n${defined}".bytes())
        "${h.high_word}_${h.low_word}"
    }

    /// Leaves what this process learned beside the frontier it read, for its store to write as this
    /// binary's frontier. Leaves nothing when it asked nothing.
    fn frontier_kept() {
        if self.unhashed() { return }
        self.stamps_kept_now()
        match self.frontier.get() {
            .Unread or .Opening -> { return },
            .Missing or .Unusable -> self.learned_kept(null),
            .Open(open) -> self.learned_kept(open),
        }
    }

    /// Hands the store every answer this process settled that may say what `open` doesn't, and the
    /// places of the suspects it never settled; nothing when there's neither.
    fn learned_kept(open: OpenFrontier?) {
        let entries = [h! for s in self.settled_answers.values() for h in [self.learned_entry(s)] if h != null]
        let stale = self.unsettled_suspects(open)
        if entries.is_empty() && stale.is_empty() { return }
        self
            .store
            .keep_frontier(self.print(), FrontierLearned { on: open?.frontier, entries: entries, stale: stale })
    }

    /// The places of `open`'s suspects that stand and this process never settled: no longer known to
    /// hold.
    fn unsettled_suspects(open: OpenFrontier?) -> List<int> {
        let o? = open else { return [] }
        [at for at, suspect in o.suspects if suspect &&
            o.frontier.stands(at) &&
            self.settled_answers.get(o.frontier.question_at(at)) == null]
    }

    /// WHETHER A QUERY OF THIS BINARY HAS NO CODE HASH: then nothing it answers can be told from an
    /// older binary's, so the binary keeps no frontier and reads none — a frontier it can't trust
    /// would re-ask questions by arguments written by other code.
    fn unhashed() -> bool { self.definitions.get().values().any(!it.is_input && it.code_hash.is_empty()) }

    /// Whether a query reads the outside world afresh in every process.
    fn input_named(query_name: string) -> bool { self.definitions.get().get(query_name)?.is_input ?? false }

    /// Whether a query's answers are worked out afresh in every process: an input's, and one whose
    /// code has no hash, which can't tell its old answers from new ones. The frontier asks these
    /// first, so what reads one is a suspect when it moved.
    fn read_afresh(query_name: string) -> bool {
        let d = self.definitions.get().get(query_name)
        d == null || d!.is_input || d!.code_hash.is_empty()
    }

    /// A settled answer as the frontier may keep it: whatever this process worked out or reused,
    /// a root when it was asked alone, and a root it asked that stood in the frontier without being
    /// one there. Absent for any other answer that stood.
    fn learned_entry(s: SettledAnswer) -> HeldEntry? {
        match s {
            .Learned(entry) -> if self.asked_alone.get(entry.question) == null { entry } else { entry.rooted() },
            .Standing(question, _, f, place) -> if self.asked_alone.get(question) != null && !f.root_at(place) { f.held_at(place)?.rooted() } else { null },
        }
    }

    /// The answer to a question the store knows, asked again as it was asked; absent where it can't
    /// be asked now, or where its query has no code hash: such a question's stored arguments were
    /// written by code nobody can say is today's, so they're never asked again.
    fn settled_by_asking(question: ContentHash) -> SettledAnswer? {
        let asked? = self.store.question_known_as(question) else { return null }
        let definition? = self.definitions.get().get(asked.query_name) else { return null }
        if definition.code_hash.is_empty() || definition.code_hash != asked.code_hash { return null }
        let _ = self.settled_answer(asked)
        self.settled_answers.get(question)
    }

    /// A settled answer's bytes, worked out again as the store says the question was asked if
    /// they're no longer kept; absent when the store keeps neither.
    fn settled_bytes(question: ContentHash, answer: ContentHash) -> SavedBytes? {
        let kept = self.store.answer_bytes(answer)
        if kept != null { return kept }
        let asked? = self.store.question_known_as(question) else { return null }
        self.answer_bytes_of(asked, answer)
    }

    /// Holds the input being answered by the stamp of the path it just read, where that path wore
    /// `before` when the read began and wears it still.
    fn read_under(path: string, before: int?) {
        let asker? = self.open_questions.get().last() else { return }
        let held? = before else { return }
        if stamp(path) != held { return }
        self
            .stamps_seen
            .put(
                asker.question,
                InputStamp {
                    question: asker.question,
                    answer: unanswered(),
                    path: path,
                    stamp: held,
                    places: places_now(),
                },
            )
    }

    /// Whether the input `question` still answers `answer` by the stamp the store holds it under:
    /// it was read under the places this process reads under, and its path wears that stamp now.
    fn stamp_holds(question: ContentHash, answer: ContentHash) -> bool {
        let kept? = self.kept_stamps().get(question) else { return false }
        if !kept.answer.same_as(answer) ||
            kept.places != places_now() ||
            stamp(kept.path) != kept.stamp { return false }
        self.stamps_seen.put(question, kept)
        self.read_sets.put(question, self.set_at_path(kept.path))
        true
    }

    /// The inputs the store holds by a stamp, read once.
    fn kept_stamps() -> HashKeyedTable<InputStamp> {
        let read? = self.stamps_kept.get() else {
            let kept: HashKeyedTable<InputStamp> = hash_keyed_table()
            for s in self.store.input_stamps() { kept.put(s.question, s) }
            self.stamps_kept.set(kept)
            return kept
        }
        read
    }

    /// Hands the store every input this process read under one stamp or found held by one, beside
    /// the answer it settled; nothing when that is what the store holds.
    fn stamps_kept_now() {
        let now = [s with { answer: a! } for s in self.stamps_seen.values() for a in [self.settled_answers.get(s.question)?.answer()] if a != null]
        let kept = self.kept_stamps()
        if now.length == kept.values().length &&
            now.all((s) -> kept.get(s.question)?.same_as(s) ?? false) { return }
        self.store.keep_input_stamps(now)
    }

    /// Times every ask from here on, by its query; an engine already timing keeps its clock.
    fn time_queries() { if self.times.get() == null { self.times.set(query_times()) } }

    /// Where this process's asks spent their time, absent while they aren't timed.
    fn kept_times() -> QueryTimes? { self.times.get() }

    /// The query of each answer this process folded forward, in the order they were folded.
    fn folded_queries() -> List<string> { self.folded.get() }

    /// How many questions this process computed.
    fn computed_count() -> int { self.computed.get().length }

    /// How many answers this process worked out, inputs aside: what an unchanged world should leave at none.
    fn worked_count() -> int { self.computed.get().filter((name) -> !self.input_named(name)).length }

    /// How many kept records this process checked.
    fn records_checked_count() -> int { self.records_checked.get() }

    /// The query of each question this process computed, in the order they ran.
    fn computed_queries() -> List<string> { self.computed.get() }

    /// Runs the query, keeps what came out, and answers its hash, timed when asks are.
    fn computed_answer(asked: Question) -> ContentHash {
        self.times.get()?.opened(asked.query_name, TimedSide.Query)
        let answer = self.worked_out(asked)
        self.times.get()?.closed()
        answer
    }

    /// Runs the query, folded forward where it folds, keeps what came out, and answers its hash.
    fn worked_out(asked: Question) -> ContentHash {
        let run = self.checked_fold(asked, self.folded_run(asked)) ?? self.full_run(asked)
        let bytes = run.bytes
        let answer = content_hash(bytes)
        let recorded = run.reads.values()
        let reads = words_of([r.question for r in recorded])
        let read = if self.definition_of(asked).is_input { self.read_sets.get(asked.known_as) ?? NO_NAMES } else { self.set_of_reads(reads) }
        self.read_sets.put(asked.known_as, read)
        let is_shared = self.set_shared(read)
        let kept = if is_shared { self.store.shared_answer_kept(answer) } else { self.store.answer_bytes(answer) != null }
        if !kept { self.keep_or_hold(asked, answer, bytes, is_shared) }
        let record = answer_record(answer, recorded)
        if !self.store.records_of(asked.known_as).any(it.same_as(record)) { self.record_kept(asked, record, is_shared) }
        self.learned(asked, answer, reads)
    }

    /// An input's bytes are read afresh in every process, so only this process holds them.
    fn keep_or_hold(asked: Question, answer: ContentHash, bytes: Bytes, is_shared: bool) {
        when {
            self.definition_of(asked).is_input -> self.store.hold_answer_bytes(answer, bytes)
            is_shared -> self.store.keep_shared_answer_bytes(answer, bytes)
            _ -> self.store.keep_answer_bytes(answer, bytes)
        }
    }

    /// `record` kept for `asked`, beside the shared store where the question is shared.
    fn record_kept(asked: Question, record: AnswerRecord, is_shared: bool) {
        if is_shared { self.store.keep_shared_record(asked, record) } else { self.store.keep_record(asked, record) }
    }

    /// The set of packages every question `reads`' words name read.
    fn set_of_reads(reads: List<int>) -> int { hashes_in(reads).fold(NO_NAMES, (set, q) -> self.sets.union(set, self.read_set_of(q))) }

    /// The set of packages the question known as `question` read: as settled here, else as it stands
    /// in the frontier, read by read; a question this process can't tell read a package nobody shares.
    fn read_set_of(question: ContentHash) -> int {
        let known = self.read_sets.get(question)
        if known != null { return known! }
        let open? = self.frontier_open() else { return self.unplaced() }
        let at? = open.frontier.place_of(question) else { return self.unplaced() }
        let found = self.read_set_at(open.frontier, at)
        self.read_sets.put(question, found)
        found
    }

    /// The set of packages the frontier's answer at `at` read: an input's, the package holding the
    /// path its stamp names; any other's, every package its places read.
    fn read_set_at(f: Frontier, at: int) -> int {
        if f.input_at(at) {
            let kept? = self.kept_stamps().get(f.question_at(at)) else { return self.unplaced() }
            return self.set_at_path(kept.path)
        }
        let places? = f.reads_at(at) else { return self.unplaced() }
        places.fold(NO_NAMES, (set, r) -> self.sets.union(set, self.read_set_of(f.question_at(r))))
    }

    /// The set holding the package whose sources hold `path`.
    fn set_at_path(path: string) -> int { self.sets.of([self.store.package_at(path) ?? UNPLACED]) }

    /// The set holding only the package no store knows.
    fn unplaced() -> int { self.sets.of([UNPLACED]) }

    /// Whether every package of the set `id` is one the store shares.
    fn set_shared(id: int) -> bool {
        let known = self.sets_shared.get().get("${id}")
        if known != null { return known! }
        let shared = self.sets.members_of(id).all((name) -> self.store.shares_package(name))
        self.sets_shared.put("${id}", shared)
        shared
    }

    /// The packages the question known as `question` read, sorted: what decides which store keeps it
    /// and which objects may be shared. Absent for a question this process hasn't settled.
    fn packages_read(question: ContentHash) -> List<string>? {
        let id? = self.read_sets.get(question) else { return null }
        self.sets.members_of(id)
    }

    /// The input being answered read the path `path`: the package holding it joins what it read.
    fn input_read_at(path: string) {
        let asker? = self.open_questions.get().last() else { return }
        self
            .read_sets
            .put(
                asker.question,
                self
                    .sets
                    .union(self.read_sets.get(asker.question) ?? NO_NAMES, self.set_at_path(path)),
            )
    }

    /// The query's answer from its body, with every question it asks recorded.
    fn full_run(asked: Question) -> QueryRun {
        let reads: HashKeyedTable<RecordedRead> = hash_keyed_table()
        let outer = self.opened(asked, reads)
        let definition = self.definition_of(asked)
        self.computed.push(definition.query_name)
        let compute = definition.compute
        let bytes = compute(self, asked.arguments)
        self.open_questions.set(outer)
        QueryRun { bytes: bytes, reads: reads }
    }

    /// `asked` opened as the innermost question, its reads recorded in `reads`; answers the
    /// questions open before it. A question asked while it's being answered is the caller's defect.
    fn opened(asked: Question, reads: HashKeyedTable<RecordedRead>) -> List<OpenQuestion> {
        let outer = self.open_questions.get()
        if outer.any(it.question.same_as(asked.known_as)) { defect(asked_while_being_answered(asked, outer)) }
        self
            .open_questions
            .push(
                OpenQuestion {
                    question: asked.known_as,
                    query_name: asked.query_name,
                    arguments: asked.arguments,
                    reads: reads,
                    reader: self.next_reader(),
                },
            )
        outer
    }

    /// THE ANSWER FOLDED FORWARD from its last one in this binary's frontier: the step handed the
    /// last answer's bytes and each read that moved, every read the last answer made carried as it
    /// stands now. Absent where folding is off, the query doesn't fold, the frontier doesn't hold the
    /// question standing or no longer keeps its answer, a read can't be asked now, or the step
    /// answers none.
    fn folded_run(asked: Question) -> QueryRun? {
        if folds_off() != null { return null }
        let step = match self.definition_of(asked).folding { .By(s) -> s, .Full -> { return null } }
        let open? = self.frontier_open() else { return null }
        let f = open.frontier
        let at? = f.place_of(asked.known_as) else { return null }
        if !f.stands(at) || f.input_at(at) { return null }
        let last? = self.store.answer_bytes(f.answer_at(at)) else { return null }
        let places? = f.reads_at(at) else { return null }
        let now = [self.settled_now(f.question_at(r))?.answer() for r in places]
        if now.any(it == null) { return null }
        let moved = [self.moved_at(f, r) for i, r in places if !now[i]!.same_as(f.answer_at(r))]
        if moved.any(it == null) { return null }
        let reads: HashKeyedTable<RecordedRead> = hash_keyed_table()
        for i, r in places {
            let carried = RecordedRead {
                question: f.question_at(r),
                whole_answer: now[i]!,
                part: null,
            }
            reads.put(carried.read_key(), carried)
        }
        let outer = self.opened(asked, reads)
        self.times.get()?.opened(asked.query_name, TimedSide.Folded)
        let bytes = step(self, asked.arguments, last, [m! for m in moved])
        self.times.get()?.closed()
        self.open_questions.set(outer)
        let folded? = bytes else { return null }
        self.folded.push(asked.query_name)
        QueryRun { bytes: folded, reads: reads }
    }

    /// The read at `f`'s `r` as moved: its question and the answer it gave there; absent where the
    /// store no longer knows the question.
    fn moved_at(f: Frontier, r: int) -> MovedRead? {
        let q? = self.store.question_known_as(f.question_at(r)) else { return null }
        MovedRead { question: q, was: f.answer_at(r) }
    }

    /// `folded`, held to the full computation where `AVRA_FOLD_CHECK` asks: the body runs too, and a
    /// fold whose answer differs, or that forgot a read the body made, traps naming the query. The
    /// body's run stands for the fold's then.
    fn checked_fold(asked: Question, folded: QueryRun?) -> QueryRun? {
        let run? = folded else { return null }
        if folds_checked() == null { return run }
        let full = self.full_run(asked)
        if !content_hash(full.bytes).same_as(content_hash(run.bytes)) { defect(fold_differs(asked)) }
        let forgot = full.reads.values().find((r) -> run.reads.get(r.question) == null)
        if forgot != null {
            defect(
                fold_forgot(asked, self.store.question_known_as(forgot!.question)?.query_name ?? ""),
            )
        }
        full
    }

    /// One part of the answer, recorded as a read of that part alone, absent when there's none.
    fn part_of_answer_to(asked: Question, part_name: string) -> Bytes? {
        let name_hash = content_hash(part_name.bytes())
        let answer = self.settled_answer(asked)
        let part = part_in_saved_parts(self.answer_bytes_of(asked, answer), name_hash)
        let seen = PartSeen { part_name: name_hash, part_hash: part_hash_seen(part) }
        self
            .record_read(RecordedRead { question: asked.known_as, whole_answer: answer, part: seen })
        part?.value
    }

    /// Whoever is asking now has made this read; with nobody asking, the question is a root, which
    /// the frontier keeps with what it reads.
    fn record_read(read: RecordedRead) {
        self.gathered(read)
        let asker? = self.open_questions.get().last() else { return self.asked_alone.put(read.question, true) }
        asker.reads.put(read.read_key(), read)
    }

    /// `read`, made with the questions open now, gathered by each gathering begun with just those open.
    fn gathered(read: RecordedRead) {
        let gathering = self.gathering.get()
        if gathering.is_empty() { return }
        let depth = self.open_questions.get().length
        for g in gathering {
            if g.depth == depth { g.reads.put(read.read_key(), read) }
        }
    }

    /// Reads made from here on with the questions open now, gathered until `reads_gathered`: what
    /// a remembered answer keeps of the work that found it.
    fn reads_begun() {
        let reads: HashKeyedTable<RecordedRead> = hash_keyed_table()
        self
            .gathering
            .push(
                ReadsGathered {
                    depth: self.open_questions.get().length,
                    reads: reads,
                    reader: self.next_reader(),
                },
            )
    }

    /// A serial no reader of this engine has had.
    fn next_reader() -> int {
        self.readers.set(self.readers.get() + 1)
        self.readers.get()
    }

    /// Who a read made now reaches, as one serial: the innermost gathering begun with the questions
    /// open now, else the innermost question, else zero for none. Two reads under one serial reach
    /// the same tables.
    fn reader() -> int {
        let open = self.open_questions.get()
        let inner = self.gathering.get().last()
        if inner?.depth ?? -1 == open.length { return inner?.reader ?? 0 }
        open.last()?.reader ?? 0
    }

    /// The reads gathered since the innermost `reads_begun`, which ends there. Gathering none begun
    /// is the caller's defect.
    fn reads_gathered() -> List<RecordedRead> {
        let all = self.gathering.get()
        self.gathering.set(all.take(all.length - 1))
        all.last()!.reads.values()
    }

    /// `reads` made again by whoever is asking now: a remembered answer read as its work read.
    fn reads_made_again(reads: List<RecordedRead>) {
        for read in reads { self.record_read(read) }
    }

    /// Remembers the answer for the rest of this process as the frontier keeps it, the questions
    /// it read as `reads`' words, and answers it: an input when its query is read afresh.
    fn learned(asked: Question, answer: ContentHash, reads: List<int>) -> ContentHash {
        let entry = HeldEntry {
            question: asked.known_as,
            answer: answer,
            reads: reads,
            input: self.read_afresh(asked.query_name),
            root: false,
        }
        self.settled_answers.put(asked.known_as, SettledAnswer.Learned(entry))
        answer
    }

    /// Every answer this process learned, as the frontier keeps it.
    fn learned_entries() -> List<HeldEntry> {
        [e! for s in self.settled_answers.values() for e in [learned_of(s)] if e != null]
    }

    /// Every answer that stood in this process as its frontier held it, with no reads: what an
    /// answer it learned may have read beside its inputs.
    fn stood_answers() -> List<HeldEntry> {
        [e! for s in self.settled_answers.values() for e in [stood_of(s)] if e != null]
    }

    /// THE ANSWERS ANOTHER PROCESS OF THIS BUILD LEARNED, taken as this one's where everything
    /// they read beside each other is what this process reads: each input the other process
    /// settled, settled here once and its answer compared, and each answer that stood in its
    /// frontier compared with what this process says; then every entry settled as it stands, none
    /// of its reads walked. Absent where they were taken, else why not: none is taken where one
    /// differs. `proved` false takes them unproven, for a witness that the proof is what catches an
    /// input that moved.
    fn took_learned(entries: List<HeldEntry>, stood: List<HeldEntry>, proved: bool) -> string? {
        if proved {
            for e in entries {
                if !e.input { continue }
                let here? = self.settled_now(e.question) else { return "an input it read is not one this process can read" }
                if !here.answer().same_as(e.answer) { return "an input it read moved" }
            }
            for e in stood {
                let here? = self.settled_now(e.question) else { return "an answer that stood in its frontier is not one this process knows" }
                if !here.answer().same_as(e.answer) { return "an answer that stood in its frontier answers otherwise here" }
            }
        }
        for e in entries {
            if self.settled_answers.get(e.question) == null { self.settled_answers.put(e.question, SettledAnswer.Learned(e with { root: false })) }
        }
        null
    }

    /// How a question's query runs. Asking a query nobody defined is the caller's defect.
    fn definition_of(asked: Question) -> QueryDefinition { self.definitions.get().get(asked.query_name)! }
}

/// `read`'s answer, read from the file or directory at `path` for the input `engine` is answering:
/// held by the path's stamp where it wears one stamp before the read and the same after it.
export fn read_stamped<T>(engine: QueryEngine, path: string, read: fn() -> T) -> T {
    engine.input_read_at(path)
    let before = stamp(path)
    let answer = read()
    engine.read_under(path, before)
    answer
}

/// The entry a settled answer is as this process learned it; absent for one that stood in the
/// frontier.
fn learned_of(s: SettledAnswer) -> HeldEntry? {
    match s { .Learned(entry) -> entry, .Standing(_, _, _, _) -> null }
}

/// The entry a settled answer is as it stood in the frontier, with no reads; absent for one this
/// process learned.
fn stood_of(s: SettledAnswer) -> HeldEntry? {
    match s {
        .Learned(_) -> null,
        .Standing(question, answer, _, _) -> HeldEntry { question: question, answer: answer, reads: [], input: false, root: false },
    }
}

/// The answer an input's stamp names until its question settles.
fn unanswered() -> ContentHash { ContentHash { high_word: 0, low_word: 0 } }

fn asked_while_being_answered(asked: Question, through: List<OpenQuestion>) -> string {
    "`${asked.query_name}` (${arguments_spelled(asked.arguments)}) was asked while it was being answered, under ${[o.query_name for o in through].join(" -> ")}, from `${through.first()?.query_name ?? ""}` (${arguments_spelled(through.first()?.arguments ?? "".bytes())})"
}

/// A question's arguments as the text they carry: each run of printable octets, apart.
fn arguments_spelled(arguments: Bytes) -> string {
    mut runs: List<string> = []
    mut run: List<int> = []
    for at in 0..arguments.length {
        let octet = arguments.at(at)
        if octet >= 32 && octet < 127 {
            run.push(octet)
        } else if !run.is_empty() {
            runs.push(from_codepoints(run))
            run = []
        }
    }
    if !run.is_empty() { runs.push(from_codepoints(run)) }
    runs.join(" ")
}

fn fold_differs(asked: Question) -> string {
    "`${asked.query_name}` folded forward answers otherwise than its body: a fold's answer is the body's, byte for byte"
}

fn fold_forgot(asked: Question, read: string) -> string {
    "`${asked.query_name}` folded forward without a read of `${read}` its body makes: a fold reads all its body reads"
}

once fn folds_off() -> string? { env("AVRA_FOLD_OFF") }

once fn folds_checked() -> string? { env("AVRA_FOLD_CHECK") }

fn two_queries_named(definition: QueryDefinition) -> string {
    "two queries are named `${definition.query_name}`, so their saved answers would collide"
}

/// A QUESTION A QUERY'S WRAPPER HOLDS, under the key its arguments fold to, with the answer it
/// settled to in the engine whose serial `settled_in` holds: a question settles once in an engine,
/// so a later ask of it in that engine reads the answer here and looks nothing up. A wrapper's
/// table outlives an engine, and an answer settled in one is never another's.
export type HeldQuestion = { question: Question, settled_in: Cell<int>, answer: Cell<ContentHash> }

/// `question`, held, settled in no engine yet.
fn held_question(question: Question) -> HeldQuestion {
    HeldQuestion { question: question, settled_in: Cell.new(-1), answer: Cell.new(unanswered()) }
}

/// The question a query's wrapper holds under the key its arguments fold to, the key's two words;
/// absent when it holds none, and always under `AVRA_HELD_QUESTIONS_CHECK`, so each ask makes its
/// question again and `question_kept` compares the two.
export fn question_at(held: HashKeyedTable<HeldQuestion>, high: int, low: int) -> HeldQuestion? {
    if held_questions_checked() != null { return null }
    held.get_at(high, low)
}

/// `made`, held under the key its arguments fold to, so a later ask of the same arguments makes
/// nothing to know what it asks. A question held there already must be the one made.
export fn question_kept(held: HashKeyedTable<HeldQuestion>, high: int, low: int, made: Question) -> HeldQuestion {
    if !questions_held() { return held_question(made) }
    let was? = held.get_at(high, low) else {
        let fresh = held_question(made)
        held.put_at(high, low, fresh)
        return fresh
    }
    if !was.question.known_as.same_as(made.known_as) { defect(key_folded_twice(made.query_name)) }
    was
}

fn key_folded_twice(query: string) -> string { "two questions of `${query}` fold to one key: a held question's key is folded from every argument, each after a tag of its kind" }

once fn held_questions_checked() -> string? { env("AVRA_HELD_QUESTIONS_CHECK") }

/// Whether a query's wrapper holds each question it asked by its arguments' values: on, unless
/// `AVRA_HELD_QUESTIONS_OFF` is set, which writes and hashes the arguments at every ask.
export fn questions_held() -> bool { held_questions_off() == null }

once fn held_questions_off() -> string? { env("AVRA_HELD_QUESTIONS_OFF") }

/// A text argument as a question's key spells it: its kind, its length, then itself, so no two run
/// together and none passes for another kind's key.
export fn held_text(s: string) -> string { "s${s.length}:${s}" }

/// A number argument as a question's key spells it: its kind, its digits, an end.
export fn held_int(n: int) -> string { "i${n};" }

/// A truth argument as a question's key spells it: a tag of its own, so no key of another kind
/// begins as one does.
export fn held_bool(b: bool) -> string { if b { "T" } else { "F" } }

/// A file argument as a question's key spells it: its kind, then its package and its path, each a
/// text, in one spelling.
export fn held_file(a: SourceFileAddress) -> string { "fs${a.package_name.length}:${a.package_name}s${a.path_in_package.length}:${a.path_in_package}" }

/// A question's arguments as its keys spell them, as the bytes it's known by and read back from.
export fn keyed_arguments(keys: List<string>) -> Bytes { held_key_of(keys).bytes() }

/// The keys a question's arguments were spelled as, read back in order.
export type KeyReader = { keys: string, at: Cell<int> }

/// A reader of the keys `arguments` spell, from the first.
export fn key_reader(arguments: Bytes) -> KeyReader { KeyReader { keys: arguments.text() ?? "", at: Cell.new(0) } }

impl KeyReader {
    /// The next key, a text.
    fn text() -> string {
        let from = self.at.get() + 1
        let colon = from + self.keys.substring(from, self.keys.length).index_of(":")
        let length = self.counted(from, colon)
        self.at.set(colon + 1 + length)
        self.keys.substring(colon + 1, colon + 1 + length)
    }

    /// The next key, a number.
    fn int() -> int {
        let from = self.at.get() + 1
        let end = from + self.keys.substring(from, self.keys.length).index_of(";")
        self.at.set(end + 1)
        self.counted(from, end)
    }

    /// The digits between `from` and `to`, as the number a key spelled; a key that spells none was
    /// written by no wrapper.
    fn counted(from: int, to: int) -> int {
        let n? = parse_int(self.keys.substring(from, to)) else {
            defect(unread_key(self.keys))
            return 0
        }
        n
    }

    /// The next key, a truth.
    fn truth() -> bool {
        let at = self.at.get()
        self.at.set(at + 1)
        self.keys.substring(at, at + 1) == "T"
    }

    /// The next key, a file.
    fn file() -> SourceFileAddress {
        self.at.set(self.at.get() + 1)
        let package = self.text()
        SourceFileAddress { package_name: package, path_in_package: self.text() }
    }
}

/// A question's key: its arguments' spellings, in order.
export fn held_key_of(keys: List<string>) -> string { if keys.length == 1 { keys[0] } else { keys.join("") } }

/// What an answer's bytes read back as, held by a query's wrapper for every later ask of that answer.
export type HeldAnswer<T> = { value: T }

/// Whether each answer held as computed is checked to read back as it was saved:
/// `AVRA_HELD_ROUNDTRIP`.
export fn round_trips_checked() -> bool { round_trip_flag() != null }

once fn round_trip_flag() -> string? { env("AVRA_HELD_ROUNDTRIP") }

/// An answer of `query` that read back as something else than it was saved from.
export fn round_trip_broken(query: string) { defect(round_trip_voice(query)) }

fn round_trip_voice(query: string) -> string { "an answer of `${query}` reads back as something other than the value it was saved from, so holding the value would differ from reading it" }

/// An answer a query's code just computed, and the arguments it was computed for.
export type FreshAnswer<T> = { arguments: Bytes, value: T }

/// Whether a query's wrapper holds what each answer reads back as: on, unless `AVRA_HELD_ANSWERS_OFF`
/// is set, which reads every answer back at every ask — the same answers, decoded again.
export fn answers_held() -> bool { held_answers_off() == null }

once fn held_answers_off() -> string? { env("AVRA_HELD_ANSWERS_OFF") }

fn unread_key(keys: string) -> string { "a question's keys don't read back as a wrapper spells them: ${keys}" }
