//! THE ENGINE: asks questions and remembers the answers. A question is a query's name, a hash of
//! its code and its arguments' bytes. While a query runs, every question it asks is recorded as a
//! read, so no read can be forgotten. Asked again in a later process, an answer whose record still stands is reused
//! without running anything, and a recomputed answer that comes out the same leaves its readers
//! standing. Nothing here knows what the queries are about.
use answer_parts.{AnswerPart, part_hash_seen, part_in_saved_parts}
use frontier.{Frontier, FrontierEntry}
use sorted.{sorted_by}
use defect.{defect}
use hash_keyed_table.{HashKeyedTable, hash_keyed_table}
use saved_layout.{SavedBytes}
use answer_record.{
    AnswerRecord,
    ContentHash,
    KeptRecord,
    PartSeen,
    Question,
    RecordedRead,
    answer_record,
    content_hash,
    question,
}

/// How a query runs.
export type QueryDefinition = {
    query_name: string,
    /// A hash of the query's code and everything it calls. Empty where it can't be known, and
    /// then its answers are never reused.
    code_hash: string,
    /// An input reads the outside world, so it runs once in every process, is never reused, and
    /// its bytes aren't kept.
    is_input: bool,
    compute: fn(QueryEngine, Bytes) -> Bytes,
}

impl QueryDefinition {
    /// The question a call of this query asks.
    fn question_about(arguments: Bytes) -> Question { question(self.query_name, self.code_hash, arguments) }
}

/// Where answers outlive a process. A question may hold several records, one per set of reads
/// that answered it, so going back to an earlier state finds its earlier answer.
export trait AnswerStore {
    fn records_of(question: ContentHash) -> List<KeptRecord>

    fn keep_record(asked: Question, record: AnswerRecord)

    /// The question a hash stands for, absent when nothing is kept about it.
    fn question_known_as(question: ContentHash) -> Question?

    /// An answer's bytes where they lie, by their hash, absent when they aren't kept.
    fn answer_bytes(answer: ContentHash) -> SavedBytes?

    fn keep_answer_bytes(answer: ContentHash, bytes: Bytes)

    /// An answer's bytes for this process alone, for what the next process reads afresh anyway.
    fn hold_answer_bytes(answer: ContentHash, bytes: Bytes)

    /// The frontier the binary printed `print` last wrote here, absent when there's none.
    fn frontier_of(print: string) -> Frontier?

    /// Keeps `entries` as the frontier of the binary printed `print`, whole or not at all.
    fn keep_frontier(print: string, entries: List<FrontierEntry>)
}

/// A question being answered, and the reads it has made so far.
type OpenQuestion = { question: ContentHash, reads: HashKeyedTable<RecordedRead> }

/// A question this process knows the answer to: the answer, and how it came to be known.
type SettledAnswer = { question: ContentHash, answer: ContentHash, known: Known }

/// How a settled answer came to be known.
enum Known {
    /// Reused by its query through a kept record that stands, read where it lies.
    Reused(query_name: string, record: KeptRecord)
    /// Worked out by its query in this process, from what it read.
    Worked(query_name: string, reads: List<ContentHash>)
    /// Standing untouched at its place in this binary's frontier.
    Standing(frontier: Frontier, place: int)
}

/// What this process has learned so far. An identity: every holder asks through the one engine.
export type QueryEngine = {
    store: dyn AnswerStore,
    definitions: Cell<Map<string, QueryDefinition>>,
    /// The answer to each question settled in this process.
    settled_answers: HashKeyedTable<SettledAnswer>,
    /// The questions being answered now, innermost last.
    open_questions: Cell<List<OpenQuestion>>,
    /// The query each question this process computed belongs to, in the order they ran: what a
    /// budget test reads.
    computed: Cell<List<string>>,
    /// The kept records this process checked to reuse an answer: what an edit's cost is counted in.
    records_checked: Cell<int>,
    /// This binary's frontier, once read; empty when it has none.
    frontier: Cell<List<Frontier>>,
    /// Whether the frontier has been read and its inputs asked.
    frontier_read: Cell<bool>,
    /// Whether a changed input reaches each answer of the frontier, by its place: what must be checked.
    suspects: Cell<List<bool>>,
}

export fn query_engine(store: dyn AnswerStore, definitions: List<QueryDefinition>) -> QueryEngine {
    let by_name: Map<string, QueryDefinition> = {}
    let settled_answers: HashKeyedTable<SettledAnswer> = hash_keyed_table()
    let open_questions: Cell<List<OpenQuestion>> = Cell.new([])
    let computed: Cell<List<string>> = Cell.new([])
    let frontier: Cell<List<Frontier>> = Cell.new([])
    let suspects: Cell<List<bool>> = Cell.new([])
    let engine = QueryEngine {
        store: store,
        definitions: Cell.new(by_name),
        settled_answers: settled_answers,
        open_questions: open_questions,
        computed: computed,
        records_checked: Cell.new(0),
        frontier: frontier,
        frontier_read: Cell.new(false),
        suspects: suspects,
    }
    for definition in definitions {
        if engine.definitions.get().has(definition.query_name) { defect(two_queries_named(definition)) }
        engine.definitions.put(definition.query_name, definition)
    }
    engine
}

impl QueryEngine {
    /// The answer's bytes where they lie, recorded as a read of the whole answer.
    fn answer_to(asked: Question) -> SavedBytes {
        self.answer_bytes_of(asked, self.hash_of_answer_to(asked))
    }

    /// An answer's bytes. A record may stand with its bytes no longer kept, and then it runs.
    fn answer_bytes_of(asked: Question, answer: ContentHash) -> SavedBytes {
        self.store.answer_bytes(answer) ?? self.store.answer_bytes(self.computed_answer(asked))!
    }

    /// The hash of the answer, recorded as a read of whoever is asking. Nothing is decoded.
    fn hash_of_answer_to(asked: Question) -> ContentHash {
        let answer = self.settled_answer(asked)
        self
            .record_read(RecordedRead { question: asked.known_as, whole_answer: answer, part: null })
        answer
    }

    /// What this process knows the answer is, reusing a record that stands, or running the query.
    /// The frontier is read before anything is looked up, so an input it holds is asked once.
    fn settled_answer(asked: Question) -> ContentHash {
        self.frontier_read_once()
        self.settled_answers.get(asked.known_as)?.answer ?? self
            .settled_from_frontier(asked.known_as)?.answer ?? self.reused_answer(asked) ?? self
            .computed_answer(asked)
    }

    /// The answer of a record whose reads all still see what they saw. An input is read fresh in
    /// every process, and a query whose code has no hash can't tell its old answers from new ones.
    fn reused_answer(asked: Question) -> ContentHash? {
        let definition = self.definition_of(asked)
        if definition.is_input || definition.code_hash.is_empty() { return null }
        let standing? = self
            .store
            .records_of(asked.known_as)
            .find((record) -> self.stands_now(record)) else { return null }
        self.settled(asked, standing.answer, Known.Reused(asked.query_name, standing))
    }

    /// Whether every read of a record still sees what it saw.
    fn stands_now(record: KeptRecord) -> bool {
        self.records_checked.set(self.records_checked.get() + 1)
        record
            .every_read(
                (question, seen) -> self.answer_holds(question, seen),
                (question, seen, part_name, part_hash) -> self.answer_holds(question, seen) ||
                    self.part_holds(question, part_name, part_hash),
            )
    }

    /// Whether a question's whole answer is still the one seen. A question nobody can ask now never
    /// holds.
    fn answer_holds(question: ContentHash, seen: ContentHash) -> bool {
        let settled? = self.settled_now(question) else { return false }
        settled.answer.same_as(seen)
    }

    /// Whether one part of a question's answer is still the one seen.
    fn part_holds(question: ContentHash, part_name: ContentHash, part_hash: ContentHash) -> bool {
        let settled? = self.settled_now(question) else { return false }
        part_hash_seen(self.part_in(question, settled.answer, part_name, null)).same_as(part_hash)
    }

    /// What this process says a question's answer is, settling it if it must, absent for a
    /// question nobody can ask now. What's settled was asked by today's code, so it isn't rechecked.
    fn settled_now(question: ContentHash) -> SettledAnswer? {
        self.settled_answers.get(question) ?? self.settled_from_frontier(question) ?? self
            .settled_by_asking(question)
    }

    /// An answer this binary's frontier holds and no changed input reaches, settled as it stands.
    fn settled_from_frontier(question: ContentHash) -> SettledAnswer? {
        let f? = self.frontier_ready() else { return null }
        let at? = f.place_of(question) else { return null }
        if self.suspects.get()[at] || f.input_at(at) { return null }
        let settled = SettledAnswer {
            question: question,
            answer: f.answer_at(at),
            known: Known.Standing(f, at),
        }
        self.settled_answers.put(question, settled)
        settled
    }

    /// This binary's frontier with its suspects known; absent while there's none, or while its
    /// inputs are being asked.
    fn frontier_ready() -> Frontier? {
        self.frontier_read_once()
        let f? = self.frontier.get().first() else { return null }
        if self.suspects.get().length != f.length() { return null }
        f
    }

    /// Reads this binary's frontier the first time anything is asked.
    fn frontier_read_once() { if !self.frontier_read.get() { self.frontier_opened() } }

    /// Reads this binary's frontier and asks its inputs first, so every answer a changed input
    /// reaches is a suspect.
    fn frontier_opened() {
        self.frontier_read.set(true)
        let f? = self.store.frontier_of(self.print()) else { return }
        self.frontier.set([f])
        let changed = [at for at in 0..f.length() if f.input_at(at) && !self.input_holds(f, at)]
        self
            .suspects
            .set(
                if changed.is_empty() { [false for _i in 0..f.length()] } else { f.readers_of(changed) },
            )
    }

    /// Whether the input at `at` answers now what it answered when the frontier was written.
    fn input_holds(f: Frontier, at: int) -> bool {
        let asked? = self.store.question_known_as(f.question_at(at)) else { return false }
        let definition? = self.definitions.get().get(asked.query_name) else { return false }
        if definition.code_hash != asked.code_hash { return false }
        self.settled_answer(asked).same_as(f.answer_at(at))
    }

    /// What tells this binary's queries apart from another's: each one's name, its code, and whether
    /// it reads the world.
    fn print() -> string {
        let defined = ["${d.query_name}:${d.code_hash}:${d.is_input}" for d in self.definitions.get().values()]
            .join("\n")
        let h = content_hash(defined.bytes())
        "${h.high_word}_${h.low_word}"
    }

    /// Writes what this process knows as this binary's frontier: every answer it settled, with what
    /// it read, and every answer of the frontier it read that no changed input reached. Writes
    /// nothing when it asked nothing, or learned nothing the frontier doesn't hold.
    fn frontier_kept() {
        if !self.frontier_read.get() { return }
        let f = self.frontier.get().first()
        if f != null && !self.suspects.get().any(it) && !self.learned_beyond_frontier() { return }
        let settled = [self.entry_of(s) for s in self.settled_answers.values()]
        self.store.keep_frontier(self.print(), closed_entries(settled.concat(self.carried_from(f))))
    }

    /// Whether this process settled anything its frontier doesn't hold, besides what is read afresh
    /// anyway.
    fn learned_beyond_frontier() -> bool { self.settled_answers.values().any((s) -> self.learned_here(s.known)) }

    /// Whether an answer came to be known in this process by a query the next one won't work out
    /// afresh anyway.
    fn learned_here(known: Known) -> bool {
        match known {
            .Reused(name, _) or .Worked(name, _) -> !self.read_afresh(name),
            .Standing(_, _) -> false,
        }
    }

    /// The answers of `f` this process didn't settle and no changed input reached, carried as they
    /// stand; none without a frontier.
    fn carried_from(f: Frontier?) -> List<HeldEntry> {
        let held? = f else { return [] }
        [carried_entry(held, at) for at in 0..held.length() if !self.suspects.get()[at] && self.settled_answers.get(held.question_at(at)) == null]
    }

    /// Whether a query reads the outside world afresh in every process.
    fn input_named(query_name: string) -> bool { self.definitions.get().get(query_name)?.is_input ?? false }

    /// Whether a query's answers are worked out afresh in every process: an input's, and one whose
    /// code has no hash, which can't tell its old answers from new ones. The frontier asks these
    /// first, so what reads one is a suspect when it moved.
    fn read_afresh(query_name: string) -> bool {
        let d = self.definitions.get().get(query_name)
        d == null || d!.is_input || d!.code_hash.is_empty()
    }

    /// A settled answer as the frontier keeps it, before its reads are places.
    fn entry_of(s: SettledAnswer) -> HeldEntry {
        match s.known {
            .Standing(f, place) -> carried_entry(f, place),
            .Reused(name, record) -> self.learned_entry(s, name, record.read_questions()),
            .Worked(name, reads) -> self.learned_entry(s, name, reads),
        }
    }

    /// An answer this process learned, as the frontier keeps it: an input when its query is read
    /// afresh.
    fn learned_entry(s: SettledAnswer, query_name: string, reads: List<ContentHash>) -> HeldEntry {
        HeldEntry {
            question: s.question,
            answer: s.answer,
            reads: reads,
            input: self.read_afresh(query_name),
        }
    }

    fn settled_by_asking(question: ContentHash) -> SettledAnswer? {
        let asked? = self.store.question_known_as(question) else { return null }
        let definition? = self.definitions.get().get(asked.query_name) else { return null }
        if definition.code_hash != asked.code_hash { return null }
        let _ = self.settled_answer(asked)
        self.settled_answers.get(question)
    }

    /// One part of an answer, absent when there's no such part.
    fn part_in(question: ContentHash, answer: ContentHash, part_name: ContentHash, asked: Question?) -> AnswerPart? {
        let bytes? = self.settled_bytes(question, answer, asked) else { return null }
        part_in_saved_parts(bytes, part_name)
    }

    /// A settled answer's bytes, asked again of what the store says the question was if they're
    /// no longer kept.
    fn settled_bytes(question: ContentHash, answer: ContentHash, asked: Question?) -> SavedBytes? {
        let kept = self.store.answer_bytes(answer)
        if kept != null { return kept }
        let worked? = asked ?? self.store.question_known_as(question) else { return null }
        self.answer_bytes_of(worked, answer)
    }

    /// How many questions this process computed.
    fn computed_count() -> int { self.computed.get().length }

    /// How many answers this process worked out, inputs aside: what an unchanged world should leave at none.
    fn worked_count() -> int { self.computed.get().filter((name) -> !self.input_named(name)).length }

    /// How many kept records this process checked.
    fn records_checked_count() -> int { self.records_checked.get() }

    /// The query of each question this process computed, in the order they ran.
    fn computed_queries() -> List<string> { self.computed.get() }

    /// Runs the query, keeps what came out, and answers its hash.
    fn computed_answer(asked: Question) -> ContentHash {
        let reads: HashKeyedTable<RecordedRead> = hash_keyed_table()
        let bytes = self.run_recording(asked, reads)
        let answer = content_hash(bytes)
        if self.store.answer_bytes(answer) == null { self.keep_or_hold(asked, answer, bytes) }
        let record = answer_record(answer, reads.values(), false)
        if !self.store.records_of(asked.known_as).any(it.same_as(record)) { self.store.keep_record(asked, record) }
        self
            .settled(asked, answer, Known.Worked(asked.query_name, [r.question for r in reads.values()]))
    }

    /// An input's bytes are read afresh in every process, so only this process holds them.
    fn keep_or_hold(asked: Question, answer: ContentHash, bytes: Bytes) {
        if self.definition_of(asked).is_input {
            self.store.hold_answer_bytes(answer, bytes)
        } else {
            self.store.keep_answer_bytes(answer, bytes)
        }
    }

    /// The query's answer, with every question it asks recorded in `reads`.
    fn run_recording(asked: Question, reads: HashKeyedTable<RecordedRead>) -> Bytes {
        let outer = self.open_questions.get()
        if outer.any(it.question.same_as(asked.known_as)) { defect(asked_while_being_answered(asked)) }
        self.open_questions.push(OpenQuestion { question: asked.known_as, reads: reads })
        let definition = self.definition_of(asked)
        self.computed.push(definition.query_name)
        let compute = definition.compute
        let bytes = compute(self, asked.arguments)
        self.open_questions.set(outer)
        bytes
    }

    /// One part of the answer, recorded as a read of that part alone, absent when there's none.
    fn part_of_answer_to(asked: Question, part_name: string) -> Bytes? {
        let name_hash = content_hash(part_name.bytes())
        let answer = self.settled_answer(asked)
        let part = self.part_in(asked.known_as, answer, name_hash, asked)
        let seen = PartSeen { part_name: name_hash, part_hash: part_hash_seen(part) }
        self
            .record_read(RecordedRead { question: asked.known_as, whole_answer: answer, part: seen })
        part?.value
    }

    /// Whoever is asking now has made this read; with nobody asking, the question is a root, which
    /// the frontier keeps.
    fn record_read(read: RecordedRead) {
        let asker? = self.open_questions.get().last() else { return }
        asker.reads.put(read.read_key(), read)
    }

    /// Remembers the answer for the rest of this process, and answers it.
    fn settled(asked: Question, answer: ContentHash, known: Known) -> ContentHash {
        self
            .settled_answers
            .put(
                asked.known_as,
                SettledAnswer { question: asked.known_as, answer: answer, known: known },
            )
        answer
    }

    /// How a question's query runs. Asking a query nobody defined is the caller's defect.
    fn definition_of(asked: Question) -> QueryDefinition { self.definitions.get().get(asked.query_name)! }
}

fn asked_while_being_answered(asked: Question) -> string {
    "`${asked.query_name}` was asked while it was being answered"
}

fn two_queries_named(definition: QueryDefinition) -> string {
    "two queries are named `${definition.query_name}`, so their saved answers would collide"
}

/// An answer the frontier will keep, its reads still questions.
type HeldEntry = { question: ContentHash, answer: ContentHash, reads: List<ContentHash>, input: bool }

/// The frontier's answer at `at`, carried as it stands.
fn carried_entry(f: Frontier, at: int) -> HeldEntry {
    HeldEntry {
        question: f.question_at(at),
        answer: f.answer_at(at),
        reads: [f.question_at(r) for r in f.reads_at(at)],
        input: f.input_at(at),
    }
}

/// The entries as a frontier holds them: sorted by question, each read a place, and none whose
/// reads aren't all held, so the frontier stays closed.
fn closed_entries(held: List<HeldEntry>) -> List<FrontierEntry> {
    mut kept = sorted_by(held, (a, b) -> a.question.comes_before(b.question))
    while true {
        let places: HashKeyedTable<int> = hash_keyed_table()
        for at, e in kept { places.put(e.question, at) }
        let whole = kept.filter(it.reads.all((r) -> places.get(r) != null))
        if whole.length == kept.length {
            return [FrontierEntry {
                question: e.question,
                answer: e.answer,
                reads: [places.get(r)! for r in e.reads],
                input: e.input,
            } for e in kept]
        }
        kept = whole
    }
    []
}
