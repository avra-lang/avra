//! declaration, never this file. `wisp tree settings --check` holds it fresh.

use @std.io.{env}
use @std.text.{parse_int}

/// The settings this package's Avra reads, each from its exact variable.
export type ProgramSettings = {
    user: ProgramUser,
    debug: ProgramDebug,
}

export type ProgramUser = {
    qtrace: bool,
}

export type ProgramDebug = {
    fold_off: bool,
    fold_check: bool,
    held_questions_off: bool,
    held_questions_check: bool,
    held_answers_off: bool,
    held_roundtrip: bool,
    held_values_bytes: int?,
    frontier_walk_check: string?,
    wave_alone: bool,
    merged_apart_from: int?,
    merged_here: bool,
    share_unmerged: string?,
    beside: string,
    ahead_edit: string?,
    ahead_unproven: bool,
}

/// The settings, read once: an unset variable is its default, and a value
/// its type cannot read stops the program, naming the variable.
export once fn program_settings() -> ProgramSettings {
    ProgramSettings {
        user: ProgramUser { qtrace: setting_switch("AVRA_QTRACE", false) },
        debug: ProgramDebug {
            fold_off: setting_switch("AVRA_FOLD_OFF", false),
            fold_check: setting_switch("AVRA_FOLD_CHECK", false),
            held_questions_off: setting_switch("AVRA_HELD_QUESTIONS_OFF", false),
            held_questions_check: setting_switch("AVRA_HELD_QUESTIONS_CHECK", false),
            held_answers_off: setting_switch("AVRA_HELD_ANSWERS_OFF", false),
            held_roundtrip: setting_switch("AVRA_HELD_ROUNDTRIP", false),
            held_values_bytes: setting_number("AVRA_HELD_VALUES_BYTES"),
            frontier_walk_check: setting_said("AVRA_FRONTIER_WALK_CHECK"),
            wave_alone: setting_switch("AVRA_WAVE_ALONE", false),
            merged_apart_from: setting_number("AVRA_MERGED_APART_FROM"),
            merged_here: setting_switch("AVRA_MERGED_HERE", false),
            share_unmerged: setting_said("AVRA_SHARE_UNMERGED"),
            beside: setting_said("AVRA_BESIDE") ?? "",
            ahead_edit: setting_said("AVRA_AHEAD_EDIT"),
            ahead_unproven: setting_switch("AVRA_AHEAD_UNPROVEN", false),
        },
    }
}

/// A switch's variable: `1` or `true` is on, `0` or `false` off, unset its default.
export fn setting_switch(name: string, unset: bool) -> bool {
    let raw? = setting_said(name) else { return unset }
    let on? = switch_read(raw) else {
        setting_unread(name, raw, "a switch: 1, 0, true or false")
        return unset
    }
    on
}

/// A switch's text read: `1` or `true` on, `0` or `false` off, absent for any other.
export fn switch_read(raw: string) -> bool? {
    if raw == "1" || raw == "true" { return true }
    if raw == "0" || raw == "false" { return false }
    null
}

/// A number's variable.
export fn setting_number(name: string) -> int? {
    let raw? = setting_said(name) else { return null }
    let n? = parse_int(raw) else {
        setting_unread(name, raw, "a whole number")
        return null
    }
    n
}

/// The variable's text, absent when it is unset.
export fn setting_said(name: string) -> string? {
    // LICENSED input.debug_flag: the compiler's settings are the process's own, never an input of what is built
    env(name)
}

/// A value its setting's type cannot read.
fn setting_unread(name: string, raw: string, want: string) {
    avra_trap("`${name}=${raw}` is not ${want}")
}

extern fn avra_trap(message: string)
