use settings.{switch_read}

spec "settings — a switch's text" {
    given "the four spellings" {
        then "`1` and `true` are on" { switch_read("1") == true && switch_read("true") == true }
        then "`0` and `false` are off, never on by being set" { switch_read("0") == false && switch_read("false") == false }
    }
    given "any other text" {
        then "it is no switch, so its reader traps naming it" {
            switch_read("") == null && switch_read("yes") == null && switch_read("00") == null
        }
    }
}
