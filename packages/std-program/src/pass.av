//! THE PASSES A PROGRAM'S WORK FALLS INTO, declared once: every query family names the pass its
//! work belongs to where it is declared (`@query("typing")`), and every phase timed outside the
//! queries does where it is timed, so the work of a run is read pass by pass and none of it
//! unattributed. Each pass counts its work per a unit of its own — what it should do once per,
//! cold, in proportion to an edit, warm, and not at all where a verdict vouches for what it reads.
use @std.meta.{Code}

/// A pass of the program's work.
export enum Pass {
    /// A file's text lexed and read into its items' tapes.
    Tape
    /// What each item says of itself and what its file's top level sees: its summary, its face,
    /// its declarations.
    Summary
    /// A name bound to its declaration.
    Resolve
    /// A body's or a signature's types.
    Typing
    /// What the laws find in an item, and the findings said.
    Laws
    /// The cells a body reads, by itself or through what it calls.
    Reads
    /// What a generator or a derive makes, spliced into the program.
    Generate
    /// A body lowered to the program layer's IR.
    Lower
    /// The memory pass over what was lowered.
    Memory
    /// What a body's IR emits as code.
    Codegen
    /// The objects of a program linked into its binary.
    Link
    /// The store opened, and its records read back.
    StoreOpen
    /// The store's rows saved.
    StoreSave
}

/// What a pass's work is counted per.
export enum PassUnit {
    /// A source file of the program.
    File
    /// A written item of a file.
    Item
    /// A fn's or a method's body.
    Body
    /// An object a build emits.
    Object
    /// An object a build links into its binary.
    Linked
    /// The run itself.
    Run
}

/// Every pass, in the order a run meets them.
export fn every_pass() -> List<Pass> {
    [
        Pass.Tape,
        Pass.Summary,
        Pass.Resolve,
        Pass.Typing,
        Pass.Laws,
        Pass.Reads,
        Pass.Generate,
        Pass.Lower,
        Pass.Memory,
        Pass.Codegen,
        Pass.Link,
        Pass.StoreOpen,
        Pass.StoreSave,
    ]
}

/// Where `p` stands among `every_pass`: a run's counters per pass are kept by it.
export fn pass_index(p: Pass) -> int {
    match p {
        .Tape -> 0,
        .Summary -> 1,
        .Resolve -> 2,
        .Typing -> 3,
        .Laws -> 4,
        .Reads -> 5,
        .Generate -> 6,
        .Lower -> 7,
        .Memory -> 8,
        .Codegen -> 9,
        .Link -> 10,
        .StoreOpen -> 11,
        .StoreSave -> 12,
    }
}

/// What the pass `p`'s work is counted per.
export fn pass_unit(p: Pass) -> PassUnit {
    match p {
        .Tape or .Summary or .Resolve or .Laws or .Generate -> PassUnit.Item,
        .Typing or .Reads or .Lower or .Memory -> PassUnit.Body,
        .Codegen -> PassUnit.Object,
        .Link -> PassUnit.Linked,
        .StoreOpen or .StoreSave -> PassUnit.Run,
    }
}

/// The word a ledger spells the pass `p` with.
export fn pass_word(p: Pass) -> string {
    match p {
        .Tape -> "tape",
        .Summary -> "summary",
        .Resolve -> "resolve",
        .Typing -> "typing",
        .Laws -> "laws",
        .Reads -> "reads",
        .Generate -> "generate",
        .Lower -> "lower",
        .Memory -> "memory",
        .Codegen -> "codegen",
        .Link -> "link",
        .StoreOpen -> "store-open",
        .StoreSave -> "store-save",
    }
}

/// The pass the word `word` names, as `pass_word` spells it; absent for a word no pass wears.
export fn pass_named(word: string) -> Pass? { every_pass().find(pass_word(it) == word) }

/// Every pass's word, as a list reads them.
export fn pass_words() -> string { [pass_word(p) for p in every_pass()].join(", ") }

/// The word a ledger spells the unit `u` with.
export fn unit_word(u: PassUnit) -> string {
    match u {
        .File -> "files",
        .Item -> "items",
        .Body -> "bodies",
        .Object -> "objects",
        .Linked -> "linked",
        .Run -> "runs",
    }
}

/// The code naming the pass `p`, for a generator to write into what it makes.
export fn pass_code(p: Pass) -> Code {
    match p {
        .Tape -> quote { Pass.Tape },
        .Summary -> quote { Pass.Summary },
        .Resolve -> quote { Pass.Resolve },
        .Typing -> quote { Pass.Typing },
        .Laws -> quote { Pass.Laws },
        .Reads -> quote { Pass.Reads },
        .Generate -> quote { Pass.Generate },
        .Lower -> quote { Pass.Lower },
        .Memory -> quote { Pass.Memory },
        .Codegen -> quote { Pass.Codegen },
        .Link -> quote { Pass.Link },
        .StoreOpen -> quote { Pass.StoreOpen },
        .StoreSave -> quote { Pass.StoreSave },
    }
}
