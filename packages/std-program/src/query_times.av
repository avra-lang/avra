//! WHERE A PROCESS'S TIME GOES: each family of asks, its CPU time inside them with and without the
//! asks it makes in turn. A family is a query's name, or a phase a caller names outside every query.
use sorted.{sorted_by}
use @std.time.{now_ns}

// LICENSED input.clock: a timing reads the clock, never an input of what is built
extern fn avra_cpu_ns() -> int

/// Which side of the program layer a family stands on.
export enum TimedSide {
    /// A query's ask worked out, inside the engine.
    Query
    /// A query's ask answered by a kept record found to stand.
    Reused
    /// A query's step folding its last answer forward, whether or not it folded.
    Folded
    /// A phase a caller times outside every query.
    Outside
}

/// An ask being timed: its family as spoken, its side, when it began and the time its nested asks
/// took, on the process's CPU clock and on the wall's.
type OpenAsk = { family: string, side: TimedSide, began: int, nested: int, began_wall: int = 0 }

/// One family's time, summed over its asks: inside them less their nested asks, and inside them
/// whole, counted once while it stands open under itself — on the process's CPU clock; and inside them
/// whole on the wall's, which counts the work they wait on in other processes too.
export type FamilyTime = { family: string, side: TimedSide, own: int, whole: int, asks: int, whole_wall: int = 0 }

/// The time of each family this process timed, from the process's start: what it spent before the
/// clock was made is the family `START_UP`. An identity: every holder times through one.
export type QueryTimes = {
    began: int,
    open: Cell<List<OpenAsk>>,
    families: Cell<Map<string, FamilyTime>>,
}

export fn query_times() -> QueryTimes {
    let open: Cell<List<OpenAsk>> = Cell.new([])
    // LICENSED input.clock: a timing reads the clock, never an input of what is built
    let before = avra_cpu_ns()
    let families: Cell<Map<string, FamilyTime>> = Cell.new({})
    families
        .put(
            START_UP + side_word(TimedSide.Outside),
            FamilyTime {
                family: START_UP + side_word(TimedSide.Outside),
                side: TimedSide.Outside,
                own: before,
                whole: before,
                asks: 1,
            },
        )
    QueryTimes { began: 0, open: open, families: families }
}

/// The family of what a process spent before its clock was made: starting, opening its store.
export const START_UP: string = "the start-up"

impl QueryTimes {
    /// Opens an ask of `family`.
    fn opened(family: string, side: TimedSide) {
        self
            .open
            .push(
                OpenAsk {
                    family: family + side_word(side),
                    side: side,
                    // LICENSED input.clock: a timing reads the clock, never an input of what is built
                    began: avra_cpu_ns(),
                    nested: 0,
                    // LICENSED input.clock: a timing reads the clock, never an input of what is built
                    began_wall: now_ns(),
                },
            )
    }

    /// Closes the innermost ask, charging its time to its family and to whoever asked it.
    fn closed() {
        let open = self.open.get()
        let ask? = open.last() else { return }
        // LICENSED input.clock: a timing reads the clock, never an input of what is built
        let whole = avra_cpu_ns() - ask.began
        // LICENSED input.clock: a timing reads the clock, never an input of what is built
        let wall = now_ns() - ask.began_wall
        let outer = open.take(open.length - 1)
        self.open.set(outer)
        let under_itself = outer.any(it.family == ask.family)
        let was = self.families.get().get(ask.family) ?? FamilyTime {
            family: ask.family,
            side: ask.side,
            own: 0,
            whole: 0,
            asks: 0,
        }
        self
            .families
            .put(
                ask.family,
                was with { own: was.own + whole - ask.nested, whole: was.whole + if under_itself { 0 } else { whole }, asks: was.asks + 1, whole_wall: was.whole_wall + if under_itself { 0 } else { wall } },
            )
        let asker? = outer.last() else { return }
        self.open.set_at(outer.length - 1, asker with { nested: asker.nested + whole })
    }

    /// The wall time, in ms, the phases named took, each whole, summed — the work they waited on in
    /// other processes included; 0 where none of them ran. Names no one of which runs inside another.
    fn phases_wall_ms(names: List<string>) -> int {
        let all = self.families.get().values()
        [f for f in all if outside_side(f.side) && names.any(f.family == it + side_word(TimedSide.Outside))]
            .fold(0, (sum, f) -> sum + f.whole_wall) / 1000000
    }

    /// Each family timed, the most time of its own first.
    fn by_own_time() -> List<FamilyTime> { sorted_by(self.families.get().values(), (a, b) -> a.own > b.own) }

    /// The `most` families with the most time of their own, each as `family own / whole (asks)`.
    /// Every phase timed outside the engine, the slowest first.
    fn phases_spoken() -> string {
        ["${t.family} ${seconds(t.own)} / ${seconds(t.whole)} (${t.asks})" for t in self.by_own_time() if outside_side(t.side)]
            .join(", ")
    }

    /// Every family asked, one a line, the most asked first: its family as spoken, then its asks.
    fn every_family() -> string {
        ["${t.family}\t${t.asks}" for t in sorted_by(self.families.get().values(), (a, b) -> a.asks > b.asks)]
            .join("\n")
    }

    fn spoken(most: int) -> string {
        ["${t.family} ${seconds(t.own)} / ${seconds(t.whole)} (${t.asks})" for t in self.by_own_time().take(most)]
            .join(", ")
    }

    /// The process's time since these began to be kept, split between the program layer's asks, the
    /// phases timed outside it, and the rest: each by the time its asks spent as their own.
    fn split() -> string {
        // LICENSED input.clock: a timing reads the clock, never an input of what is built
        let all = avra_cpu_ns() - self.began
        let families = self.families.get().values()
        let queries = families.filter(on_the_program_layer).fold(0, (sum, f) -> sum + f.own)
        let outside = families.filter(!on_the_program_layer(it)).fold(0, (sum, f) -> sum + f.own)
        "${seconds(all)} CPU: ${seconds(queries)} asking the program layer, ${seconds(outside)} in phases timed outside it, ${seconds(all - queries - outside)} in neither"
    }
}

/// Whether a family's asks are the program layer's.
fn on_the_program_layer(f: FamilyTime) -> bool {
    match f.side { .Query or .Reused or .Folded -> true, .Outside -> false }
}

/// How a family's side is spoken after its name.
fn side_word(side: TimedSide) -> string {
    match side {
        .Query -> "",
        .Reused -> " (reused)",
        .Folded -> " (folded)",
        .Outside -> " (outside)",
    }
}

/// Nanoseconds as seconds to a tenth.
fn seconds(ns: int) -> string { "${ns / 1000000000}.${ns / 100000000 % 10}s" }

/// Whether a family is timed outside the engine.
fn outside_side(side: TimedSide) -> bool { match side { .Outside -> true, .Query or .Reused or .Folded -> false } }
