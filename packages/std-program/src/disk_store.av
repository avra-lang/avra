extern fn avra_mmap_open(path: string) -> ptr?
extern fn avra_mmap_len(mapping: ptr) -> int
extern fn avra_mmap_close(mapping: ptr)
extern fn avra_shared_made(slots: int, room: int) -> ptr?
extern fn avra_shared_ended(shared: ptr)
extern fn avra_shared_view(shared: ptr) -> ptr
extern fn avra_shared_kept(shared: ptr, kind: int, high: int, low: int, octets: Bytes, count: int) -> int
extern fn avra_shared_start(shared: ptr, kind: int, high: int, low: int) -> int
extern fn avra_shared_end(shared: ptr, kind: int, high: int, low: int) -> int
extern fn avra_shared_claimed(shared: ptr, high: int, low: int) -> int
extern fn avra_shared_let_go(shared: ptr, high: int, low: int) -> int
extern fn avra_shared_awaited(shared: ptr, high: int, low: int, holder: int) -> int

/// A pack's last octets. It names the format, and a pack that lost its tail doesn't have it.
export const PACK_SEAL: string = "avrapak6"

const PACK_SUFFIX: string = ".pack"

/// What a store may hold beyond twice what its last compaction kept before it compacts again.
const COMPACTION_SLACK: int = 67108864

/// The most octets of answers a draft holds in memory past its mapping before it maps itself again.
const UNMAPPED_OCTETS: int = 2097152

/// Where a kept thing's octets lie in a pack: the hash it's kept under, where they start, and how
/// many there are. An answer is kept under the hash of its octets, a question's records under the
/// question's hash; each is a saved answer of its own, read where it lies.
@derive(Saved)
export type KeptSpan = { key: ContentHash, at: int, length: int }

/// A pack's index, written after what it keeps: a table of answers and one of questions, each
/// sorted by hash beside a list of its keys' high words, so a search touches numbers and opens only
/// the entries it might have found. Its generation is one past the newest pack it saw; its kept
/// octets are what the store's last compaction kept, the measure the next compaction waits on.
@derive(Saved)
type PackIndex = {
    answer_high_words: List<int>,
    answers: List<KeptSpan>,
    question_high_words: List<int>,
    questions: List<KeptSpan>,
    generation: int,
    kept_octets: int,
}

/// A pack in a mapped file. Its index's tables are found once, here, and every node of it lies
/// before `end`. A mapping stays for the life of the process, so bytes read from one never dangle,
/// even after its file is gone.
type MappedPack = {
    path: string,
    length: int,
    end: int,
    source: SavedSource,
    answer_high_words: SavedList,
    answers: SavedList,
    question_high_words: SavedList,
    questions: SavedList,
    generation: int,
    kept_octets: int,
    /// The least and the greatest high word its answers' keys carry, and its questions'; where a
    /// table is empty, a least past its greatest.
    answers_from: int,
    answers_to: int,
    questions_from: int,
    questions_to: int,
}

/// The pack at `path`, absent when it can't be read or isn't a whole pack. A process maps each pack
/// once, however many stores open it: a pack is never written in place, so a path that wears the
/// stamp it wore when it was mapped holds what the mapping holds; one that wears another, or none, is
/// mapped again.
fn mapped_pack(path: string) -> MappedPack? {
    // LICENSED input.store_io: the store's own files, never an input of what is answered
    let now = stamp(path)
    let held = packs_mapped().get().get(path)
    if held != null && now != null && held!.stamp == now! { return held!.pack }
    // LICENSED input.store_io: the store's own files, never an input of what is answered
    let mapping? = avra_mmap_open(path) else { return null }
    // LICENSED input.store_io: the store's own files, never an input of what is answered
    let pack? = pack_in(path, SavedSource.Mapped(mapping), avra_mmap_len(mapping)) else {
        // LICENSED input.store_io: the store's own files, never an input of what is answered
        avra_mmap_close(mapping)
        return null
    }
    if now != null { packs_mapped().put(path, StampedPack { stamp: now!, pack: pack }) }
    pack
}

/// A pack this process mapped, and the stamp its path wore then.
type StampedPack = { stamp: int, pack: MappedPack }

/// Every pack this process mapped, by its path.
once fn packs_mapped() -> Cell<Map<string, StampedPack>> {
    let mapped: Cell<Map<string, StampedPack>> = Cell.new({})
    mapped
}

/// The pack `source` holds, `length` octets long, absent unless it ends in the seal and its index's
/// tables lie within it, each beside its keys' high words one for one.
fn pack_in(path: string, source: SavedSource, length: int) -> MappedPack? {
    let index? = sealed_root_record(source, length, PACK_SEAL) else { return null }
    let end = sealed_end(length, PACK_SEAL)
    let answer_high_words? = PackIndex.answer_high_words_within(source, index, end) else { return null }
    let answers? = PackIndex.answers_within(source, index, end) else { return null }
    let question_high_words? = PackIndex.question_high_words_within(source, index, end) else { return null }
    let questions? = PackIndex.questions_within(source, index, end) else { return null }
    if answer_high_words.length != answers.length || question_high_words.length != questions.length { return null }
    MappedPack {
        path: path,
        length: length,
        end: end,
        source: source,
        answer_high_words: answer_high_words,
        answers: answers,
        question_high_words: question_high_words,
        questions: questions,
        generation: PackIndex.generation_in(source, index),
        kept_octets: PackIndex.kept_octets_in(source, index),
        answers_from: least_of(source, answer_high_words),
        answers_to: greatest_of(source, answer_high_words),
        questions_from: least_of(source, question_high_words),
        questions_to: greatest_of(source, question_high_words),
    }
}

/// The first number of a list sorted ascending; one where it holds none.
fn least_of(source: SavedSource, numbers: SavedList) -> int { if numbers.length == 0 { 1 } else { numbers.number_at(source, 0) } }

/// The last number of a list sorted ascending; zero where it holds none.
fn greatest_of(source: SavedSource, numbers: SavedList) -> int { if numbers.length == 0 { 0 } else { numbers.number_at(source, numbers.length - 1) } }

/// A SHARE OF THE KEYS: every hash whose high word is at least `from` and, where there is a `to`,
/// below it. A table sorted by hash holds a share's keys in one run.
export type KeyShare = { from: int, to: int? }

/// The keys cut into `count` shares of one width, in order, which together hold every key.
export fn key_shares(count: int) -> List<KeyShare> {
    let width = GREATEST_WORD / count * 2
    [KeyShare {
        from: if k == 0 { LEAST_WORD } else { LEAST_WORD + k * width },
        to: if k == count - 1 { null } else { LEAST_WORD + (k + 1) * width },
    } for k in 0..count]
}

const GREATEST_WORD: int = 9223372036854775807
const LEAST_WORD: int = -9223372036854775807 - 1

impl KeyShare {
    /// The places of a table's entries this share holds, its keys' high words in `high_words`:
    /// the first, and one past the last.
    fn run_in(source: SavedSource, high_words: SavedList) -> List<int> {
        let to? = self.to else { return [high_words.first_at_or_after(source, self.from), high_words.length] }
        [high_words.first_at_or_after(source, self.from), high_words.first_at_or_after(source, to)]
    }
}

impl MappedPack {
    /// The span at `at` of `spans`, absent unless it lies within the pack: its record, its key, and
    /// the octets it names.
    fn span_at(spans: SavedList, at: int) -> KeptSpan? {
        let record? = spans.record_within_at(self.source, at, self.end) else { return null }
        let key? = KeptSpan.key_within(self.source, record, self.end) else { return null }
        let span = KeptSpan {
            key: ContentHash.read_from(self.source, key),
            at: KeptSpan.at_in(self.source, record),
            length: KeptSpan.length_in(self.source, record),
        }
        if span.at >= 0 && span.length >= 0 && span.at + span.length <= self.end { span } else { null }
    }

    /// The span keyed by `key` among `spans`, beside their keys' high words, absent when there's none
    /// that lies within the pack.
    fn span_keyed(high_words: SavedList, spans: SavedList, key: ContentHash) -> KeptSpan? {
        let at? = place_keyed_by(
            self.source,
            high_words,
            key,
            (p) -> self.span_at(spans, p)?.key?.low_word,
        ) else { return null }
        self.span_at(spans, at)
    }

    /// The records `question` has here, where they lie.
    fn question_entry(question: ContentHash) -> SavedAt<SavedRecord>? {
        if question.high_word < self.questions_from || question.high_word > self.questions_to { return null }
        let span? = self.span_keyed(self.question_high_words, self.questions, question) else { return null }
        self.saved_at(span).root_at()
    }

    fn records_of(question: ContentHash) -> List<KeptRecord> {
        let entry? = self.question_entry(question) else { return [] }
        records_in(entry)
    }

    fn question_known_as(question: ContentHash) -> Question? {
        let entry? = self.question_entry(question) else { return null }
        QuestionRecords.asked_in(entry.source, entry.node)
    }

    fn answer_bytes(answer: ContentHash) -> SavedBytes? {
        if answer.high_word < self.answers_from || answer.high_word > self.answers_to { return null }
        let span? = self.span_keyed(self.answer_high_words, self.answers, answer) else { return null }
        self.saved_at(span)
    }

    /// The octets a span names, where they lie.
    fn saved_at(span: KeptSpan) -> SavedBytes { SavedBytes { source: self.source, from: span.at, to: span.at + span.length } }

    /// How many answers and questions the pack holds.
    fn entries() -> int { self.answers.length + self.questions.length }

    /// Every answer the pack keeps that lies within it, in its order; with a `share`, those it holds.
    fn answer_spans(share: KeyShare?) -> List<KeptSpan> {
        let run = share?.run_in(self.source, self.answer_high_words) ?? [0, self.answers.length]
        [span! for i in run[0]..run[1] for span in [self.span_at(self.answers, i)] if span != null]
    }

    /// Every question the pack keeps that lies within it, in its order; with a `share`, those it
    /// holds.
    fn question_spans(share: KeyShare?) -> List<KeptSpan> {
        let run = share?.run_in(self.source, self.question_high_words) ?? [0, self.questions.length]
        [span! for i in run[0]..run[1] for span in [self.span_at(self.questions, i)] if span != null]
    }
}

/// What a draft keeps of one kind: where each lies in it, and the octets not yet mapped, held.
type DraftTable = { spans: HashKeyedTable<KeptSpan>, unviewed: HashKeyedTable<Bytes> }

fn draft_table() -> DraftTable {
    let spans: HashKeyedTable<KeptSpan> = hash_keyed_table()
    let unviewed: HashKeyedTable<Bytes> = hash_keyed_table()
    DraftTable { spans: spans, unviewed: unviewed }
}

/// What this process is writing: the draft each answer and each question's records it keeps are
/// appended to, where each lies in it, what's appended but not yet written, and what's written past
/// the draft's last mapping, held until it's mapped again. A question kept again is appended again,
/// and its newest octets are the ones it has; the older stay as dead octets until a compaction drops
/// them. A draft a write failed on is spoiled: its index would point at octets that never reached it,
/// so it's never published, and what it couldn't write stays held, so every read still answers.
type Segment = {
    draft: Draft,
    appended_octets: Cell<int>,
    answers: DraftTable,
    questions: DraftTable,
    unwritten: Cell<List<Bytes>>,
    unwritten_octets: Cell<int>,
    /// Each mapping of the draft, oldest first: a span is read through the oldest that reaches it,
    /// so a page is resident in one mapping, never in each.
    views: Cell<List<DraftView>>,
    unviewed_octets: Cell<int>,
    /// The write that spoiled the draft, if one did.
    spoiled_by: Cell<List<IoError>>,
}

/// A mapping of the draft, as far as it reached when it was made.
type DraftView = { source: SavedSource, length: int }

/// The most octets a draft gathers before writing them, so a write is never one small answer.
const UNWRITTEN_OCTETS: int = 1048576

fn segment_of(draft: Draft) -> Segment {
    let unwritten: Cell<List<Bytes>> = Cell.new([])
    let spoiled_by: Cell<List<IoError>> = Cell.new([])
    let views: Cell<List<DraftView>> = Cell.new([])
    Segment {
        draft: draft,
        appended_octets: Cell.new(0),
        answers: draft_table(),
        questions: draft_table(),
        unwritten: unwritten,
        unwritten_octets: Cell.new(0),
        views: views,
        unviewed_octets: Cell.new(0),
        spoiled_by: spoiled_by,
    }
}

impl Segment {
    /// `octets` appended, answering where they start. They reach the draft with the next write.
    fn appended(octets: Bytes) -> int {
        let at = self.appended_octets.get()
        self.appended_octets.set(at + octets.length)
        if self.is_spoiled() { return at }
        self.unwritten.push(octets)
        self.unwritten_octets.set(self.unwritten_octets.get() + octets.length)
        if self.unwritten_octets.get() >= UNWRITTEN_OCTETS { self.written() }
        at
    }

    /// Everything appended written to the draft, in one write. A write that fails spoils it.
    fn written() {
        if self.unwritten_octets.get() == 0 { return }
        if self.is_spoiled() { return }
        match self.draft.write(self.unwritten.get().bytes()) {
            .Ok(_) -> {},
            .Err(e) -> { return self.spoiled(e) },
        }
        self.unwritten.set([])
        self.unwritten_octets.set(0)
    }

    /// `bytes` kept in `kind` under `key`: appended, and held until the draft is mapped past them.
    fn keep(kind: DraftTable, key: ContentHash, bytes: Bytes) {
        kind.spans.put(key, KeptSpan { key: key, at: self.appended(bytes), length: bytes.length })
        kind.unviewed.put(key, bytes)
        self.unviewed_octets.set(self.unviewed_octets.get() + bytes.length)
        if self.unviewed_octets.get() >= UNMAPPED_OCTETS { self.mapped_again() }
    }

    /// The draft written and mapped as far as it goes, so nothing in it need be held. A draft that
    /// can't be written or mapped keeps what it holds.
    fn mapped_again() {
        self.written()
        if self.is_spoiled() { return }
        // LICENSED input.store_io: the store's own files, never an input of what is answered
        let mapping? = avra_mmap_open(self.draft.path) else { return }
        // LICENSED input.store_io: the store's own files, never an input of what is answered
        let length = avra_mmap_len(mapping)
        // LICENSED input.store_io: the store's own files, never an input of what is answered
        if length != self.appended_octets.get() { return avra_mmap_close(mapping) }
        self.views.push(DraftView { source: SavedSource.Mapped(mapping), length: length })
        self.answers.unviewed.clear()
        self.questions.unviewed.clear()
        self.unviewed_octets.set(0)
    }

    /// The draft spoiled by `e`: dropped, so its octets free the disk they hold; what it mapped is
    /// still read where it lay, and what's kept from here on, like what it couldn't write, is held.
    fn spoiled(e: IoError) {
        self.spoiled_by.push(e)
        self.draft.dropped()
        self.unwritten.set([])
        self.unwritten_octets.set(0)
    }

    fn is_spoiled() -> bool { !self.spoiled_by.get().is_empty() }

    /// What `kind` keeps under `key`, where it lies, absent when it keeps nothing there.
    fn saved_in(kind: DraftTable, key: ContentHash) -> SavedBytes? {
        let span? = kind.spans.get(key) else { return null }
        let end = span.at + span.length
        let view? = oldest_reaching(self.views.get(), end) else { return saved_bytes_in_memory(kind.unviewed.get(key)!) }
        SavedBytes { source: view.source, from: span.at, to: end }
    }
}

/// The oldest of `views` that reaches `end`, absent where none does: each view reaches further than
/// the one before, so the first that reaches it is found by halving.
fn oldest_reaching(views: List<DraftView>, end: int) -> DraftView? {
    mut lo = 0
    mut hi = views.length
    while lo < hi {
        let mid = (lo + hi) / 2
        if views[mid].length >= end { hi = mid } else { lo = mid + 1 }
    }
    if lo < views.length { views[lo] } else { null }
}

// ── What a wave's processes share while they work ──

/// How many questions, and how many answers, a wave's processes share at most, and in how many
/// octets: past either, a process keeps what it learns to itself and the others work it out.
const WAVE_SLOTS: int = 2097152
const WAVE_OCTETS: int = 4294967296

/// The kinds a wave's table keeps: a question's records, and an answer's octets.
const WAVE_RECORDS: int = 0
const WAVE_ANSWERS: int = 1

/// The table the processes of the wave this process is of share, while there is one.
once fn wave_table() -> Cell<List<ptr>> {
    let held: Cell<List<ptr>> = Cell.new([])
    held
}

/// WHAT A WAVE'S PROCESSES LEARN IS SHARED AS THEY LEARN IT, from here until `wave_sharing_ended`:
/// asked before a wave forks, so every process of it maps one table. Each keeps there the records
/// and the answers it keeps in its own draft, finds there what another kept, and claims there the
/// question it is working out, so another that needs the answer waits for it and no two work one
/// out. A record found there is checked like any kept record, read by read, by the process that
/// takes it. Whether there is a table; with none, each process works alone, as before.
export fn wave_sharing_begun() -> bool {
    if wave_alone() != null || !wave_table().get().is_empty() { return false }
    let shared? = avra_shared_made(WAVE_SLOTS, WAVE_OCTETS) else { return false }
    wave_table().set([shared])
    true
}

/// The table forgotten by this process; with `gone`, unmapped as well, which the process that made
/// it asks once its wave has ended.
export fn wave_sharing_ended(gone: bool) {
    let shared? = wave_table().get().first() else { return }
    wave_table().set([])
    if gone { avra_shared_ended(shared) }
}

/// `AVRA_WAVE_ALONE`: a wave's processes share nothing while they work.
// LICENSED input.debug_flag: a debug flag is the process's own, not an input
once fn wave_alone() -> string? { env("AVRA_WAVE_ALONE") }

/// `bytes` kept under `key` in the wave's table, for every process of the wave to find.
fn wave_kept(kind: int, key: ContentHash, bytes: Bytes) {
    let shared? = wave_table().get().first() else { return }
    let _ = avra_shared_kept(shared, kind, key.high_word, key.low_word, bytes, bytes.length)
}

/// What the wave's table keeps under `key`, read where it lies; absent where it keeps nothing.
fn wave_found(kind: int, key: ContentHash) -> SavedBytes? {
    let shared? = wave_table().get().first() else { return null }
    let from = avra_shared_start(shared, kind, key.high_word, key.low_word)
    if from < 0 { return null }
    SavedBytes {
        source: SavedSource.Mapped(avra_shared_view(shared)),
        from: from,
        to: avra_shared_end(shared, kind, key.high_word, key.low_word),
    }
}

/// The records another process of the wave kept of `question`.
export fn wave_records(question: ContentHash) -> List<KeptRecord> {
    let found? = wave_found(WAVE_RECORDS, question) else { return [] }
    records_in(found.root_at())
}

/// `question` as another process of the wave asked it.
export fn wave_question(question: ContentHash) -> Question? {
    let found? = wave_found(WAVE_RECORDS, question) else { return null }
    let entry = found.root_at()
    QuestionRecords.asked_in(entry.source, entry.node)
}

/// The octets another process of the wave kept of `answer`.
export fn wave_answer(answer: ContentHash) -> SavedBytes? { wave_found(WAVE_ANSWERS, answer) }

/// The queries whose answers are gathered from many questions, each claimed on its own.
once fn wave_gathered() -> Cell<Map<string, bool>> {
    let gathered: Cell<Map<string, bool>> = Cell.new({})
    gathered
}

/// Each query of `names` gathers its answer from many questions, each claimed on its own: a
/// process that needs such an answer while another gathers it gathers it too, the two sharing
/// what lies under it, where it would otherwise wait with nothing to do.
export fn wave_gathers(names: List<string>) {
    for name in names { wave_gathered().put(name, true) }
}

/// Whether `query_name` is one `wave_gathers` named.
export fn wave_gathered_by(query_name: string) -> bool { wave_gathered().get().has(query_name) }

/// `question` claimed by this process to work out: zero where it holds the claim now, else the
/// living process that does.
export fn wave_claimed(question: ContentHash) -> int {
    let shared? = wave_table().get().first() else { return 0 }
    avra_shared_claimed(shared, question.high_word, question.low_word)
}

/// Waits while the process `holder` holds the claim of `question` and lives.
export fn wave_awaited(question: ContentHash, holder: int) {
    let shared? = wave_table().get().first() else { return }
    let _ = avra_shared_awaited(shared, question.high_word, question.low_word, holder)
}

/// This process's claim of `question` let go.
export fn wave_let_go(question: ContentHash) {
    let shared? = wave_table().get().first() else { return }
    let _ = avra_shared_let_go(shared, question.high_word, question.low_word)
}

/// A store over a directory, plus what this process has learned and hasn't published yet. An
/// identity: every holder sees one store.
export type DiskStore = {
    directory: string,
    /// The binary this store answers for: only its packs are read, and only its answers kept.
    print: Cell<string?>,
    /// The packs of the binary this store answers for, mapped once it knows which.
    packs: Cell<List<MappedPack>>,
    /// The draft this process is writing, once it keeps anything.
    segment: Cell<List<Segment>>,
    /// Answers' bytes for this process alone, never published.
    held_answers: HashKeyedTable<Bytes>,
    /// Questions' records this process keeps without a draft, never published.
    held_questions: HashKeyedTable<Bytes>,
    /// One past the newest generation any pack's name carries: what this process writes as.
    generation: Cell<int>,
    /// Packs of its binary this store can't read, torn, and packs no binary of this format wrote.
    foreign: Cell<List<ForeignPack>>,
    /// What this process learned for its binary's frontier, written once the pack holding its
    /// answers is.
    pending_frontier: Cell<PendingFrontier?>,
    /// The packs other processes published as shares of the packs this store read, once it took
    /// them in their place.
    taken_shares: Cell<List<string>>,
}

/// What a process learned for its binary's frontier, waiting for its answers to be published:
/// whose it is, and what it learned.
type PendingFrontier = { print: string, learned: FrontierLearned }

/// A pack this store can't read, and its size: it counts against the store's room, and goes when
/// the store compacts. A binary that wrote it only ever loses work.
type ForeignPack = { path: string, length: int }

/// How many octets the file at `path` holds, zero when it can't be read.
fn octets_in(path: string) -> int {
    // LICENSED input.store_io: the store's own files, never an input of what is answered
    let mapping? = avra_mmap_open(path) else { return 0 }
    // LICENSED input.store_io: the store's own files, never an input of what is answered
    let length = avra_mmap_len(mapping)
    // LICENSED input.store_io: the store's own files, never an input of what is answered
    avra_mmap_close(mapping)
    length
}

/// The store at `directory`. A directory that isn't there yet is an empty store. A draft whose
/// process died is removed.
export fn disk_store_at(directory: string) -> DiskStore {
    saves_awaited(directory)
    // LICENSED input.store_io: the store's own files, never an input of what is answered
    for name in abandoned_drafts(directory) { let _ = remove("${directory}/${name}") }
    let print: Cell<string?> = Cell.new(null)
    let packs: Cell<List<MappedPack>> = Cell.new([])
    let foreign: Cell<List<ForeignPack>> = Cell.new([])
    let held_answers: HashKeyedTable<Bytes> = hash_keyed_table()
    let held_questions: HashKeyedTable<Bytes> = hash_keyed_table()
    let segment: Cell<List<Segment>> = Cell.new([])
    let pending: Cell<PendingFrontier?> = Cell.new(null)
    let taken_shares: Cell<List<string>> = Cell.new([])
    DiskStore {
        directory: directory,
        print: print,
        packs: packs,
        segment: segment,
        held_answers: held_answers,
        held_questions: held_questions,
        foreign: foreign,
        pending_frontier: pending,
        taken_shares: taken_shares,
        generation: Cell.new(1 + pack_names_in(directory).fold(0, (newest, p) -> max_of(newest, p.generation))),
    }
}

/// The file whose one writer is the process saving the store at `directory` after the process
/// that learned what it saves has gone.
const SAVING_FILE: string = "saving.lock"

/// The file that stands in a store while a save left to an heir is unfinished, holding what the
/// next process to open the store says of it.
const UNFINISHED_FILE: string = "saving.unfinished"

/// Whether this process is one left to save a store: it waits for no save, its own least of all.
export once fn saving_apart() -> Cell<bool> { Cell.new(false) }

/// `AVRA_QTRACE`: the store says when it reads an answer from a share.
// LICENSED input.debug_flag: a trace line is said, never read by an answer
once fn shares_traced() -> string? { env("AVRA_QTRACE") }

/// Whether this process has said it read an answer from a share.
once fn share_read() -> Cell<bool> { Cell.new(false) }

/// Whether this process has said it waits for a save.
once fn wait_said() -> Cell<bool> { Cell.new(false) }

/// Waits out a save of the store at `directory` a process left behind is still writing, so what
/// the store is read as holds everything the process before it learned; a wait is said, once a
/// process. A save that never finished is said by the first process to find it so, once.
fn saves_awaited(directory: string) {
    // LICENSED input.store_io: the store's own files, never an input of what is answered
    if saving_apart().get() || !exists("${directory}/${SAVING_FILE}") { return }
    let lock? = match opened_for_append("${directory}/${SAVING_FILE}") {
        .Ok(l) -> l,
        .Err(_) -> null,
    } else { return }
    if !(lock.free() catch true) {
        if !wait_said().get() { eprintln(waiting_for_save()) }
        wait_said().set(true)
        let _ = lock.awaited() catch 0
    }
    // LICENSED input.store_io: the store's own files, never an input of what is answered
    let unfinished = read_text("${directory}/${UNFINISHED_FILE}") catch ""
    if !unfinished.is_empty() {
        let _ = remove("${directory}/${UNFINISHED_FILE}")
        eprintln(unfinished)
    }
    let _ = lock.closed() catch 0
}

/// The store at `directory` held as its one saver: the open file that holds it until it closes
/// or its last holder dies; absent where another process is saving, or it can't be held.
export fn save_held(directory: string) -> AppendFile? {
    let _ = make_dirs(directory) catch ""
    let lock? = match opened_for_append("${directory}/${SAVING_FILE}") {
        .Ok(l) -> l,
        .Err(_) -> null,
    } else { return null }
    if lock.locked() catch false { return lock }
    let _ = lock.closed() catch 0
    null
}

/// The save of the store at `directory` left to an heir, unfinished until `save_finished`.
export fn save_left(directory: string) { let _ = write_text("${directory}/${UNFINISHED_FILE}", save_unfinished(directory)) catch "" }

/// The save of the store at `directory` finished: nothing is left to say of it, or `failed`, why it
/// kept nothing, is.
export fn save_finished(directory: string, failed: string?) {
    let why? = failed else {
        let _ = remove("${directory}/${UNFINISHED_FILE}")
        return
    }
    let _ = write_text("${directory}/${UNFINISHED_FILE}", save_failed(directory, why)) catch ""
}

// ── The voices ──

/// A process waits for the save a build before it left to its heir.
fn waiting_for_save() -> string { "avra: waiting for the last build's save" }

/// A save left to an heir ended before it finished.
fn save_unfinished(directory: string) -> string { "avra: the last build's save of ${directory} did not finish; what it learned is worked out again" }

/// A save left to an heir failed.
fn save_failed(directory: string, why: string) -> string { "avra: the last build's save of ${directory} failed: ${why}; what it learned is worked out again" }

/// What every pack's file name begins with.
const PACK_PREFIX: string = "pack-"

/// A pack's file name: the print of the binary whose answers it holds, the generation it was
/// written in, and the hash naming its index.
fn pack_file_name(print: string, generation: int, named: ContentHash) -> string {
    "${PACK_PREFIX}${print}.${generation}.${named.high_word}_${named.low_word}${PACK_SUFFIX}"
}

/// A pack file as its name says: whose answers it holds and when it was written.
type PackName = { name: string, print: string, generation: int }

/// What the name `name` says of its pack, absent for a name no binary of this format writes.
fn pack_named(name: string) -> PackName? {
    if !name.starts_with(PACK_PREFIX) || !name.ends_with(PACK_SUFFIX) { return null }
    let parts = name.substring(PACK_PREFIX.length, name.length - PACK_SUFFIX.length).split(".")
    if parts.length != 3 { return null }
    let generation? = parse_int(parts[1]) else { return null }
    PackName { name: name, print: parts[0], generation: generation }
}

/// A pack as a listing names it: its file, the binary whose answers it holds, when it was written,
/// and what it weighs on disk.
export type PackListed = { name: string, print: string, generation: int, octets: int }

/// Every pack in `directory` a binary of this format wrote, oldest first, a generation's packs in
/// name order.
export fn packs_listed(directory: string) -> List<PackListed> {
    sorted_by(
        [PackListed {
            name: p.name,
            print: p.print,
            generation: p.generation,
            octets: octets_in("${directory}/${p.name}"),
        } for p in pack_names_in(directory)],
        (a, b) -> a.generation < b.generation ||
            a.generation == b.generation && text_before(a.name, b.name),
    )
}

/// The questions the pack `name` in `directory` holds records of, in the order its index keeps
/// them; absent where no whole pack stands there.
export fn pack_questions(directory: string, name: string) -> List<Question>? {
    let pack? = mapped_pack("${directory}/${name}") else { return null }
    [q! for span in pack.question_spans(null) for q in [pack.question_known_as(span.key)] if q != null]
}

/// How many binaries' frontiers a store keeps.
const KEPT_FRONTIERS: int = 2

/// What every frontier file's name begins with.
const FRONTIER_PREFIX: string = "frontier-"

/// A frontier file in the store's directory: where it is, which binary's it is, and what it holds.
/// Its mapping stays for the process, as a pack's does.
type FoundFrontier = { path: string, print: string, file: FrontierFile }

/// What a file holding `kind` ends in.
fn suffix_of(kind: FrontierKind) -> string {
    match kind { .Base -> ".front", .Delta -> ".delta" }
}

/// Where the binary printed `print` keeps the frontier file of `kind` named by `id`.
export fn frontier_file_path(directory: string, print: string, kind: FrontierKind, id: ContentHash) -> string {
    "${directory}/${FRONTIER_PREFIX}${print}.${id.high_word}_${id.low_word}${suffix_of(kind)}"
}

/// A frontier file as its name says: where it is and whose it is. Nothing of it is read.
type FrontierName = { path: string, print: string }

/// Every frontier file in `directory`, of any binary, by its name alone.
fn frontier_names_in(directory: string) -> List<FrontierName> {
    // LICENSED input.store_io: the store's own files, never an input of what is answered
    let names = list_dir(directory) catch []
    [FrontierName {
        path: "${directory}/${name}",
        print: name.substring(FRONTIER_PREFIX.length, name.length).split(".")[0],
    } for name in names if name.starts_with(FRONTIER_PREFIX) &&
        (name.ends_with(suffix_of(FrontierKind.Base)) ||
            name.ends_with(suffix_of(FrontierKind.Delta)))]
}

/// Every frontier file of the binary printed `print` in `directory` that can be mapped.
fn frontiers_of(directory: string, print: string) -> List<FoundFrontier> {
    // LICENSED input.store_io: the store's own files, never an input of what is answered
    [found! for name in list_dir(directory) catch [] if name.starts_with("${FRONTIER_PREFIX}${print}.") for found in [found_frontier(directory, name)] if found != null]
}

/// The frontier file `name` in `directory`, absent when the name isn't a frontier file's or it
/// can't be mapped.
fn found_frontier(directory: string, name: string) -> FoundFrontier? {
    if !name.starts_with(FRONTIER_PREFIX) { return null }
    let kind? = [k for k in [FrontierKind.Base, FrontierKind.Delta] if name.ends_with(suffix_of(k))]
        .first() else { return null }
    let parts = name
        .substring(FRONTIER_PREFIX.length, name.length - suffix_of(kind).length)
        .split(".")
    if parts.length != 2 { return null }
    let id? = hash_named(parts[1]) else { return null }
    let path = "${directory}/${name}"
    // LICENSED input.store_io: the store's own files, never an input of what is answered
    let mapping? = avra_mmap_open(path) else { return null }
    // LICENSED input.store_io: the store's own files, never an input of what is answered
    let length = avra_mmap_len(mapping)
    FoundFrontier {
        path: path,
        print: parts[0],
        file: FrontierFile { kind: kind, id: id, source: SavedSource.Mapped(mapping), length: length },
    }
}

/// The hash a file name spells as its two words, absent when it spells none.
fn hash_named(spelled: string) -> ContentHash? {
    let words = spelled.split("_")
    if words.length != 2 { return null }
    let high? = parse_int(words[0]) else { return null }
    let low? = parse_int(words[1]) else { return null }
    ContentHash { high_word: high, low_word: low }
}

/// Every pack in `directory` a binary of this format wrote, as its name says.
fn pack_names_in(directory: string) -> List<PackName> {
    // LICENSED input.store_io: the store's own files, never an input of what is answered
    [p! for name in list_dir(directory) catch [] for p in [pack_named(name)] if p != null]
}

/// The packs in `directory` that hold answers for the binary printed `print`, by file name.
export fn packs_answering(directory: string, print: string) -> List<string> {
    [p.name for p in pack_names_in(directory) if answers_print(print, p.print)]
}

/// Every pack file in `directory` no binary of this format wrote.
fn unnamed_packs_in(directory: string) -> List<string> {
    // LICENSED input.store_io: the store's own files, never an input of what is answered
    (list_dir(directory) catch [])
        .filter((name) -> name.ends_with(PACK_SUFFIX) && pack_named(name) == null)
}

impl AnswerStore for DiskStore {
    /// The store answers for the binary printed `print`: that binary's packs are mapped, and no
    /// other binary's are ever read.
    fn answering_for(print: string) {
        if self.print.get() == print { return }
        self.print.set(print)
        let paths = ["${self.directory}/${p.name}" for p in pack_names_in(self.directory) if answers_print(print, p.print)]
        let packs = [pack! for path in paths for pack in [mapped_pack(path)] if pack != null]
        let torn = [ForeignPack { path: path, length: octets_in(path) } for path in paths if !packs.any(it.path == path)]
        let unnamed = [ForeignPack {
            path: "${self.directory}/${name}",
            length: octets_in("${self.directory}/${name}"),
        } for name in unnamed_packs_in(self.directory)]
        self.packs.set(packs)
        self.foreign.set(torn.concat(unnamed))
    }

    fn records_of(question: ContentHash) -> List<KeptRecord> {
        let published = [record for pack in self.packs.get() for record in pack.records_of(question)]
        let learned? = self.learned_entry(question) else { return published }
        published.concat(records_in(learned))
    }

    /// The record kept beside what this process learned of the question before: its records saved
    /// again, whole, in the draft. A store that can't write keeps them for this process alone.
    fn keep_record(asked: Question, record: AnswerRecord) {
        let earlier = [r.held() for r in self.learned_records(asked.known_as)]
        let bytes = QuestionRecords {
            question: asked.known_as,
            asked: asked,
            records: earlier.concat([record]),
            written_in: self.generation.get(),
        }
            .saved_bytes()
        wave_kept(WAVE_RECORDS, asked.known_as, bytes)
        if self.held_questions.get(asked.known_as) != null { return self.held_questions.put(asked.known_as, bytes) }
        let segment? = self.writing() else { return self.held_questions.put(asked.known_as, bytes) }
        segment.keep(segment.questions, asked.known_as, bytes)
    }

    fn question_known_as(question: ContentHash) -> Question? {
        let learned? = self.learned_entry(question) else {
            return first_answering(self.packs.get(), (pack) -> pack.question_known_as(question))
        }
        QuestionRecords.asked_in(learned.source, learned.node)
    }

    fn answer_bytes(answer: ContentHash) -> SavedBytes? {
        let unpublished? = self.unpublished_answer(answer) else {
            let read = first_answering(self.packs.get(), (pack) -> pack.answer_bytes(answer))
            if read != null && shares_traced() != null { self.share_read_said(answer) }
            return read
        }
        unpublished
    }

    /// An answer kept in the draft. A store that can't write keeps it for this process alone, so a
    /// full disk costs the next process work and never this one an answer.
    fn keep_answer_bytes(answer: ContentHash, bytes: Bytes) {
        if self.unpublished_answer(answer) != null { return }
        wave_kept(WAVE_ANSWERS, answer, bytes)
        let segment? = self.writing() else { return self.held_answers.put(answer, bytes) }
        segment.keep(segment.answers, answer, bytes)
    }

    fn hold_answer_bytes(answer: ContentHash, bytes: Bytes) { self.held_answers.put(answer, bytes) }

    /// The frontier the files of the binary printed `print` hold, read where they lie.
    fn frontier_of(print: string) -> Frontier? { frontier_over([f.file for f in frontiers_of(self.directory, print)]) }

    /// Holds what this process learned for its binary's frontier, written once the pack holding its
    /// answers is.
    fn keep_frontier(print: string, learned: FrontierLearned) { self.pending_frontier.set(PendingFrontier { print: print, learned: learned }) }

    /// The stamps kept here, each path read where it lies from this store.
    fn input_stamps() -> List<InputStamp> {
        [s with { path: normalized(joined_path(self.directory, s.path)) } for s in stamps_read("${self.directory}/${STAMPS_FILE}")]
    }

    /// Writes `stamps` at once, whole or not at all, each path named from this store, so the store
    /// names no checkout: a stamp only ever spares a read whose answer the frontier still holds.
    fn keep_input_stamps(stamps: List<InputStamp>) {
        let _ = make_dirs(self.directory) catch ""
        stamps_written(
            "${self.directory}/${STAMPS_FILE}",
            [s with { path: named_from(self.directory, s.path) } for s in stamps],
        )
    }
}

/// `path` named from the directory `dir` where the two are spelled from one root, else as it stands.
fn named_from(dir: string, path: string) -> string {
    if is_absolute(path) != is_absolute(dir) { return path }
    relative_path(dir, path)
}

/// The file a store keeps its inputs' stamps in.
const STAMPS_FILE: string = "inputs.stamps"

impl DiskStore {
    /// What a compaction keeps alive: every question its binary's frontier holds, and what this
    /// process learned for it.
    fn frontier_seeds() -> List<ContentHash> {
        let own = self.pending_frontier.get()?.print ?? self.print.get()
        let held = if own == null { [] } else { self.frontier_of(own!)?.questions() ?? [] }
        let pending? = self.pending_frontier.get() else { return held }
        let read = pending.learned.on?.questions() ?? []
        held.concat(read).concat([h.question for h in pending.learned.entries])
    }

    /// The binaries a store keeps answers for, `own` first, then the others whose packs were written
    /// newest, so two binaries sharing a store each keep theirs and a third evicts the oldest.
    fn prints_kept(own: string?) -> List<string> {
        mut newest: Map<string, int> = {}
        for p in pack_names_in(self.directory) { newest.set(p.print, max_of(newest.get(p.print) ?? 0, p.generation)) }
        for f in frontier_names_in(self.directory) { if newest.get(f.print) == null { newest.set(f.print, 0) } }
        let others = sorted_by(
            [print for print, _g in newest if print != own],
            (a, b) -> newest.get(a)! > newest.get(b)!,
        )
        let kept = if own == null { others } else { [own!].concat(others) }
        kept.take(KEPT_FRONTIERS)
    }

    /// Every pack and frontier file of a binary past the ones the store keeps removed, with every
    /// pack no binary of this format wrote. A pack gone from under a reader is a miss: its mapping
    /// stands.
    fn prints_evicted(own: string?) {
        let kept = self.prints_kept(own)
        for p in pack_names_in(self.directory) {
            if !kept.contains(p.print) { let _ = remove("${self.directory}/${p.name}") }
        }
        for name in unnamed_packs_in(self.directory) { let _ = remove("${self.directory}/${name}") }
        for f in frontier_names_in(self.directory) {
            if !kept.contains(f.print) { let _ = remove(f.path) }
        }
    }

    /// The files of the binary printed `print` its frontier no longer reads, removed: an older or
    /// unreadable base, and a delta that doesn't descend from the newest.
    fn frontier_tidied(print: string) {
        let found = frontiers_of(self.directory, print)
        let kept = files_kept([f.file for f in found])
        for f in found {
            if !kept.any(it.same_as(f.file.id)) { let _ = remove(f.path) }
        }
    }

    /// What this process learned for its frontier written, once what it names is published, beside
    /// the frontier as it stands now: a delta, or folded into a base, `whole` always. One rename
    /// makes each file, so a reader finds it whole or not at all, and a base's older files go. A
    /// frontier that can't be written costs the next process work, never a wrong answer.
    fn frontier_published(whole: bool) {
        let pending? = self.pending_frontier.get() else { return }
        self.pending_frontier.set(null)
        let write? = frontier_written(
            self.frontier_of(pending.print),
            pending.learned,
            self.generation.get(),
            whole,
        ) else { return }
        if !self.file_published(pending.print, write) { return }
        for id in write.replaces {
            let _ = remove(
                frontier_file_path(self.directory, pending.print, FrontierKind.Delta, id),
            )
        }
        match write.kind { .Base -> self.frontier_tidied(pending.print), .Delta -> { return } }
    }

    /// `write` published as the binary printed `print`'s file, by a draft and one rename; whether
    /// it was.
    fn file_published(print: string, write: FrontierWrite) -> bool {
        let draft? = match drafted("${self.directory}/frontier") { .Ok(d) -> d, .Err(_) -> null } else { return false }
        for run in write.runs {
            let wrote = draft.write(run) catch -1
            if wrote < 0 {
                draft.dropped()
                return false
            }
        }
        (draft.published(frontier_file_path(self.directory, print, write.kind, write.id)) catch "") != ""
    }

    fn unpublished_answer(answer: ContentHash) -> SavedBytes? {
        let held? = self.held_answers.get(answer) else {
            let segment? = self.segment.get().first() else { return null }
            return segment.saved_in(segment.answers, answer)
        }
        saved_bytes_in_memory(held)
    }

    /// The records this process learned of `question`, where they lie, absent when it learned none.
    fn learned_entry(question: ContentHash) -> SavedAt<SavedRecord>? {
        let held? = self.held_questions.get(question) else {
            let segment? = self.segment.get().first() else { return null }
            return segment.saved_in(segment.questions, question)?.root_at()
        }
        saved_bytes_in_memory(held).root_at()
    }

    fn learned_records(question: ContentHash) -> List<KeptRecord> {
        let entry? = self.learned_entry(question) else { return [] }
        records_in(entry)
    }

    /// The draft this process writes, opened on first use; absent when none can be. A draft a
    /// forked parent opened is left to it.
    fn writing() -> Segment? {
        let open = self.segment.get().first()
        if open != null && open!.draft.is_mine() { return open }
        let draft? = opened_draft(self.directory) else { return null }
        let segment = segment_of(draft)
        self.segment.set([segment])
        segment
    }

    /// Whether this process has learned anything it hasn't published.
    fn has_news() -> bool { self.learned() > 0 }

    /// How many answers and questions this process learned, to weigh against a pack's.
    fn entries_learned() -> int {
        let segment? = self.segment.get().first() else { return 0 }
        segment.answers.spans.values().length + segment.questions.spans.values().length
    }

    /// How many octets this process has written to its draft.
    fn learned() -> int {
        let segment? = self.segment.get().first() else { return 0 }
        segment.appended_octets.get()
    }

    /// Publishes what this process learned as one pack, absorbing packs no bigger than it, and
    /// answers how many octets it wrote. A process that learned nothing writes nothing.
    fn saved() -> Result<int, IoError> {
        if self.compacts_on_saving() { return self.compacted() }
        let written = if self.has_news() { self.published(absorbed_by(self.entries_learned(), self.packs.get()), false)? } else { 0 }
        self.frontier_published(false)
        self.prints_evicted(self.print.get())
        written
    }

    /// Whether saving now compacts: there's news, and the store has outgrown its last compaction.
    fn compacts_on_saving() -> bool { self.has_news() && self.outgrown() }

    /// Every pack as one, keeping only what the kept frontiers reach; packs it can't read go, and
    /// so does every frontier file the kept frontiers don't read. What this process learned for its
    /// own is folded into a base.
    /// A store that answers for no binary compacts each binary's packs on their own.
    fn compacted() -> Result<int, IoError> {
        let own? = self.print.get() else { return self.each_kept(it.compacted()) }
        let written = if self.packs.get().is_empty() && !self.has_news() { 0 } else { self.published(self.packs.get(), true)? }
        for pack in self.foreign.get() { let _ = remove(pack.path) }
        self.frontier_published(true)
        self.prints_evicted(own)
        self.frontier_tidied(own)
        written
    }

    /// `step` done by a store over the same directory answering for each binary the store keeps,
    /// newest first, and every other binary's files evicted. Answers the octets written in all.
    fn each_kept(step: fn(DiskStore) -> Result<int, IoError>) -> Result<int, IoError> {
        mut written = 0
        for print in self.prints_kept(null) {
            let each = disk_store_at(self.directory)
            each.answering_for(print)
            written = written + step(each)?
        }
        self.prints_evicted(null)
        written
    }

    /// Whether the store holds more than twice what its last compaction kept, and some slack. With
    /// no compaction yet, its biggest pack stands for what's kept.
    fn outgrown() -> bool {
        let packs = self.packs.get()
        let held = packs.fold(0, (sum, pack) -> sum + pack.length) +
            self.foreign.get().fold(0, (sum, pack) -> sum + pack.length)
        let kept = packs
            .fold(
                0,
                (most, pack) -> max_of(
                    most,
                    if pack.kept_octets > 0 { pack.kept_octets } else { pack.length },
                ),
            )
        held > 2 * kept + COMPACTION_SLACK
    }

    /// Publishes what this process learned as a pack of its own, for when others are publishing
    /// beside it and merging would only repeat their work.
    fn saved_alone() -> Result<int, IoError> {
        if !self.has_news() { return 0 }
        self.published([], false)
    }

    /// Every pack as one, for when several are published at once. Answers how many octets it wrote.
    fn merged() -> Result<int, IoError> {
        if self.print.get() == null { return self.each_kept(it.merged()) }
        let packs = self.packs.get()
        if packs.length < 2 { return 0 }
        self.published(packs, false)
    }

    /// How many answers and questions the store's packs hold: what merging them works through.
    fn entries_published() -> int { self.packs.get().fold(0, (sum, pack) -> sum + pack.entries()) }

    /// ONE SHARE OF EVERY PACK AS ONE PACK, published beside them by a process that learned
    /// nothing: what the packs hold under the keys `share` holds, the packs left where they lie
    /// for the process that asked every share merged to drop (`shares_taken`). Each share says it
    /// keeps what all the packs held between them, so the shares together are no more outgrown
    /// than the one pack a merge here would have made. Answers how many octets it wrote, or why
    /// nothing was published.
    fn share_merged(share: KeyShare) -> Result<int, IoError> {
        let segment? = self.writing() else { fail IoError.Failed(self.directory, 0) }
        let packs = sorted_by(self.packs.get(), (a, b) -> a.generation < b.generation)
        let questions = questions_merged(segment, packs, null, share)
        let answers = answers_merged(segment, packs, null, share)
        let runs = index_runs(
            questions,
            answers,
            self.generation.get(),
            packs.fold(0, (sum, pack) -> sum + max_of(pack.kept_octets, pack.length)),
        )
        for run in runs { let _ = segment.appended(run) }
        let _ = segment.appended(PACK_SEAL.bytes())
        segment.written()
        let spoiled? = segment.spoiled_by.get().first() else { return self.sealed(segment, [], runs_hash(runs)) }
        fail spoiled
    }

    /// Every share of the packs this store read stands published as a pack of its own: the packs
    /// it read are dropped, and it reads the directory's packs afresh.
    fn shares_taken() {
        for pack in self.packs.get() { let _ = remove(pack.path) }
        self.packs_read_again()
        self.taken_shares.set([pack.path for pack in self.packs.get()])
    }

    /// Under `AVRA_QTRACE`, the first answer this process reads from a share another process
    /// published, said once.
    fn share_read_said(answer: ContentHash) {
        if share_read().get() { return }
        let shares = self.taken_shares.get()
        let from? = self
            .packs
            .get()
            .find((pack) -> shares.contains(pack.path) && pack.answer_bytes(answer) != null) else { return }
        share_read().set(true)
        eprintln("store: an answer read from a share another process published: ${from.path}")
    }

    /// The store reads the packs its directory holds now.
    fn packs_read_again() {
        let print? = self.print.get() else { return }
        self.print.set(null)
        self.answering_for(print)
    }

    /// What this process learned and what `absorbed` holds, sealed as one pack, which the store
    /// then reads in place of `absorbed`, and has nothing new. Collecting, it keeps only what the
    /// newest frontiers reach. Answers how many octets it wrote.
    fn published(absorbed: List<MappedPack>, collecting: bool) -> Result<int, IoError> {
        let segment? = self.writing() else { return 0 }
        let spoiled_before? = segment.spoiled_by.get().first() else { return self.sealed_if_whole(segment, absorbed, collecting) }
        fail spoiled_before
    }

    /// What this process learned and what `absorbed` holds, written after the draft and sealed. A
    /// write that fails spoils the draft, and nothing is published.
    fn sealed_if_whole(segment: Segment, absorbed: List<MappedPack>, collecting: bool) -> Result<
        int,
        IoError,
    > {
        let packs = sorted_by(absorbed, (a, b) -> a.generation < b.generation)
        let live: Live? = if collecting { live_over(packs, segment, self.frontier_seeds()) } else { null }
        let questions = questions_merged(segment, packs, live)
        let answers = answers_merged(segment, packs, live)
        let runs = index_runs(
            questions,
            answers,
            self.generation.get(),
            if collecting { segment.appended_octets.get() } else { absorbed.fold(0, (most, pack) -> max_of(most, pack.kept_octets)) },
        )
        for run in runs { let _ = segment.appended(run) }
        let _ = segment.appended(PACK_SEAL.bytes())
        segment.written()
        let spoiled? = segment.spoiled_by.get().first() else { return self.sealed(segment, absorbed, runs_hash(runs)) }
        fail spoiled
    }

    /// The draft, written whole, published as the pack its index names; the store then reads it in
    /// place of `absorbed`, and has nothing new. Answers how many octets it wrote.
    fn sealed(segment: Segment, absorbed: List<MappedPack>, named: ContentHash) -> Result<
        int,
        IoError,
    > {
        let print? = self.print.get() else { return 0 }
        let path = "${self.directory}/${pack_file_name(print, self.generation.get(), named)}"
        segment.draft.published(path)?
        for pack in absorbed {
            if pack.path != path { let _ = remove(pack.path) }
        }
        let kept = self.packs.get().filter((pack) -> !absorbed.any(it.path == pack.path))
        let opened = mapped_pack(path)
        self.packs.set(if opened == null { kept } else { kept.concat([opened!]) })
        self.segment.set([])
        segment.appended_octets.get()
    }
}

/// A span among those a pack is written from, and where it lies: in the absorbed pack at `rank`,
/// oldest first, or in the draft, ranked after every pack.
type Placed = { span: KeptSpan, rank: int }

/// Every span of `packs`, oldest first, then the draft's, ordered by key and, within a key, by
/// rank: what a new pack is written from, one run of spans per key.
fn placed_runs(
    packs: List<MappedPack>,
    draft: List<KeptSpan>,
    of_pack: fn(MappedPack) -> List<KeptSpan>,
) -> List<List<Placed>> {
    let all = [Placed { span: span, rank: rank } for rank, pack in packs for span in of_pack(pack)]
        .concat([Placed { span: span, rank: packs.length } for span in draft])
    let sorted = sorted_by_hash(all, (p) -> p.span.key)
    mut runs: List<List<Placed>> = []
    mut run: List<Placed> = []
    for placed in sorted {
        if !run.is_empty() && !run[0].span.key.same_as(placed.span.key) {
            runs.push(run)
            run = []
        }
        run.push(placed)
    }
    if !run.is_empty() { runs.push(run) }
    runs
}

/// What `live` keeps of every pack's questions and the draft's, each question once: one source's
/// records are carried as they lie, and several sources' merged, oldest first, each record once.
fn questions_merged(segment: Segment, packs: List<MappedPack>, live: Live?, share: KeyShare? = null) -> List<
    KeptSpan,
> {
    let runs = placed_runs(
        packs,
        segment.questions.spans.values(),
        (pack) -> pack.question_spans(share),
    )
    [span! for run in runs if live == null || live!.questions.get(run[0].span.key) != null for span in [question_written(segment, packs, run, live != null)] if span != null]
}

/// One question's run written into the draft: carried as it lies when one source holds it and
/// nothing is dropped from it, saved again otherwise. Absent when it keeps no record.
fn question_written(segment: Segment, packs: List<MappedPack>, run: List<Placed>, collecting: bool) -> KeptSpan? {
    if run.length == 1 {
        let count = record_count(entry_placed(segment, packs, run[0]))
        if count == 0 { return null }
        if !collecting || keeps_every_record(count) { return carried(segment, packs, run[0]) }
    }
    let entries = [entry_placed(segment, packs, p) for p in run]
    let records = merged_records(entries)
    let kept = if collecting { newest_records(records) } else { records }
    if kept.is_empty() { return null }
    let newest = entries.last()!
    let bytes = QuestionRecords {
        question: run[0].span.key,
        asked: QuestionRecords.asked_in(newest.source, newest.node),
        records: [r.held() for r in kept],
        written_in: entries
            .fold(
                0,
                (most, entry) -> max_of(
                    most,
                    QuestionRecords.written_in_in(entry.source, entry.node),
                ),
            ),
    }
        .saved_bytes()
    KeptSpan { key: run[0].span.key, at: segment.appended(bytes), length: bytes.length }
}

/// A question's records as one placed span holds them, where they lie.
fn entry_placed(segment: Segment, packs: List<MappedPack>, p: Placed) -> SavedAt<SavedRecord> {
    if p.rank < packs.length { return packs[p.rank].saved_at(p.span).root_at() }
    segment.saved_in(segment.questions, p.span.key)!.root_at()
}

/// Several sources' records of one question, oldest first, each record once.
fn merged_records(entries: List<SavedAt<SavedRecord>>) -> List<KeptRecord> {
    mut merged: List<KeptRecord> = []
    for entry in entries {
        let earlier = merged
        merged = earlier
            .concat(records_in(entry).filter((record) -> !earlier.any(it.same_as(record.held()))))
    }
    merged
}

/// What `live` keeps of every pack's answers and the draft's, each answer once, from its newest
/// source: the draft's stand where they are, a pack's are copied in.
fn answers_merged(segment: Segment, packs: List<MappedPack>, live: Live?, share: KeyShare? = null) -> List<
    KeptSpan,
> {
    let runs = placed_runs(
        packs,
        segment.answers.spans.values(),
        (pack) -> pack.answer_spans(share),
    )
    [carried(segment, packs, run.last()!) for run in runs if live == null || live!.answers.get(run[0].span.key) != null]
}

/// A placed span as the new pack holds it: the draft's where it stands, a pack's octets copied in.
fn carried(segment: Segment, packs: List<MappedPack>, p: Placed) -> KeptSpan {
    if p.rank == packs.length { return p.span }
    let pack = packs[p.rank]
    p.span with { at: segment.appended(pack.source.octets_at(p.span.at, p.span.at + p.span.length)) }
}

/// What the questions `seeds` reach among `packs` and the draft, every record read where it lies.
fn live_over(packs: List<MappedPack>, segment: Segment, seeds: List<ContentHash>) -> Live {
    live_in(
        seeds,
        (question) -> merged_records(
            [entry! for pack in packs for entry in [pack.question_entry(question)] if entry != null]
                .concat(
                    [entry! for entry in [segment.saved_in(segment.questions, question)?.root_at()] if entry != null],
                ),
        ),
    )
}

fn max_of(a: int, b: int) -> int { if a > b { a } else { b } }

/// A draft beside the store's packs, absent when none can be opened.
fn opened_draft(directory: string) -> Draft? {
    let _ = make_dirs(directory) catch ""
    match drafted("${directory}/learned") { .Ok(draft) -> draft, .Err(_) -> null }
}

/// The packs a new pack of `entries` absorbs: smallest first, each holding no more than all before
/// it.
fn absorbed_by(entries: int, packs: List<MappedPack>) -> List<MappedPack> {
    mut gathered = entries
    mut absorbed: List<MappedPack> = []
    for pack in sorted_by(packs, (a, b) -> a.entries() < b.entries()) {
        if pack.entries() > gathered { return absorbed }
        gathered = gathered + pack.entries()
        absorbed.push(pack)
    }
    absorbed
}

/// A pack's index, as the runs of octets it's written in, after what it keeps and before its seal.
/// Both tables come sorted by hash.
export fn index_runs(
    questions: List<KeptSpan>,
    answers: List<KeptSpan>,
    generation: int,
    kept_octets: int,
) -> List<Bytes> {
    let index = PackIndex {
        answer_high_words: [span.key.high_word for span in answers],
        answers: answers,
        question_high_words: [span.key.high_word for span in questions],
        questions: questions,
        generation: generation,
        kept_octets: kept_octets,
    }
    let writer = saved_layout_writer()
    writer.finished_runs_of(index.written_into(writer))
}

/// What the first pack that can answer says.
fn first_answering<T>(packs: List<MappedPack>, read: fn(MappedPack) -> T?) -> T? {
    for pack in packs {
        let found? = read(pack) else { continue }
        return found
    }
    null
}
