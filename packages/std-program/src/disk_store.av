//! ANSWERS ON DISK: a directory of packs, each immutable and named by the hash of its bytes. A
//! process publishes what it learned as one new pack, with a single atomic rename. So there is no
//! log to tear and no lock to hold: any number of processes write at once, and one that dies
//! leaves everything it published. A pack is read where it lies, so opening a store costs a map
//! per pack and answers are never paged in to check a record. A new pack absorbs every pack no
//! bigger than itself, which keeps the count of packs logarithmic and each answer's rewrites few.
//! The worst a race can do is repeat work: a pack gone from under a reader is a miss.
use @std.io.{IoError, list_dir, make_dirs, remove, write_bytes}
use @std.meta.{derive}
use answer_record.{AnswerRecord, ContentHash, Question, content_hash, entry_keyed}
use hash_keyed_table.{HashKeyedTable, hash_keyed_table}
use query_engine.{AnswerStore}
use saved_derive.{Saved}
use saved_layout.{
    SavedBytes,
    SavedList,
    SavedRecord,
    SavedSlots,
    SavedSource,
    saved_bytes_in_memory,
    saved_root_record,
}
use sorted.{sorted_by}

extern fn avra_mmap_open(path: string) -> ptr?
extern fn avra_mmap_len(mapping: ptr) -> int
extern fn avra_mmap_close(mapping: ptr)

/// A pack's last octets. It names the format, and a pack that lost its tail doesn't have it.
const PACK_SEAL: string = "avrapak1"

const PACK_SUFFIX: string = ".pack"

/// An answer's bytes, under their hash.
@derive(Saved)
type KeptAnswer = { answer: ContentHash, bytes: Bytes }

/// One question, once, and every way it was answered.
@derive(Saved)
type QuestionRecords = { question: ContentHash, asked: Question, records: List<AnswerRecord> }

/// A pack's contents, each table sorted by hash. Answers are written first, so the records sit
/// together and checking them pages in none of the answers.
@derive(Saved)
type AnswerPack = {
    answer_high_words: List<int>,
    answers: List<KeptAnswer>,
    question_high_words: List<int>,
    questions: List<QuestionRecords>,
}

/// A pack in a mapped file. Its tables' labels are read once, here. A mapping stays for the life of
/// the process, so bytes read from one never dangle, even after its file is gone.
type MappedPack = {
    path: string,
    length: int,
    root: SavedRecord,
    answer_high_words: SavedList,
    answers: SavedList,
    question_high_words: SavedList,
    questions: SavedList,
}

/// The pack at `path`, absent when it can't be read or doesn't end in the seal.
fn mapped_pack(path: string) -> MappedPack? {
    let mapping? = avra_mmap_open(path) else { return null }
    let source = SavedSource.Mapped(mapping)
    let length = avra_mmap_len(mapping)
    let root_ends_at = length - PACK_SEAL.length
    if root_ends_at < PACK_SEAL.length || source.octets_at(root_ends_at, length).text() != PACK_SEAL {
        avra_mmap_close(mapping)
        return null
    }
    let root = saved_root_record(source, root_ends_at)
    MappedPack {
        path: path,
        length: length,
        root: root,
        answer_high_words: AnswerPack.answer_high_words_in_place(root),
        answers: AnswerPack.answers_in_place(root),
        question_high_words: AnswerPack.question_high_words_in_place(root),
        questions: AnswerPack.questions_in_place(root),
    }
}

impl MappedPack {
    fn question_entry(question: ContentHash) -> SavedRecord? { entry_keyed(self.question_high_words, self.questions, question) }

    fn records_of(question: ContentHash) -> List<AnswerRecord> {
        let entry? = self.question_entry(question) else { return [] }
        QuestionRecords.records_in(entry)
    }

    fn question_known_as(question: ContentHash) -> Question? {
        let entry? = self.question_entry(question) else { return null }
        QuestionRecords.asked_in(entry)
    }

    fn answer_bytes(answer: ContentHash) -> SavedBytes? {
        let entry? = entry_keyed(self.answer_high_words, self.answers, answer) else { return null }
        KeptAnswer.bytes_in_place(entry)
    }
}

/// A store over a directory, plus what this process has learned and hasn't published yet. An
/// identity: every holder sees one store.
export type DiskStore = {
    directory: string,
    packs: Cell<List<MappedPack>>,
    new_questions: HashKeyedTable<QuestionRecords>,
    new_answers: HashKeyedTable<KeptAnswer>,
    /// Bytes for this process alone, never published.
    held_answers: HashKeyedTable<Bytes>,
}

/// The store at `directory`. A directory that isn't there yet is an empty store.
export fn disk_store_at(directory: string) -> DiskStore {
    mut packs: List<MappedPack> = []
    for file_name in pack_names_in(directory) {
        let pack? = mapped_pack("${directory}/${file_name}") else { continue }
        packs.push(pack)
    }
    let new_questions: HashKeyedTable<QuestionRecords> = hash_keyed_table()
    let new_answers: HashKeyedTable<KeptAnswer> = hash_keyed_table()
    let held_answers: HashKeyedTable<Bytes> = hash_keyed_table()
    DiskStore {
        directory: directory,
        packs: Cell.new(packs),
        new_questions: new_questions,
        new_answers: new_answers,
        held_answers: held_answers,
    }
}

fn pack_names_in(directory: string) -> List<string> { (list_dir(directory) catch []).filter(it.ends_with(PACK_SUFFIX)) }

impl AnswerStore for DiskStore {
    fn records_of(question: ContentHash) -> List<AnswerRecord> {
        let published = [record for pack in self.packs.get() for record in pack.records_of(question)]
        published.concat(self.new_questions.get(question)?.records ?? [])
    }

    fn keep_record(asked: Question, record: AnswerRecord) {
        let earlier = self.new_questions.get(asked.known_as)?.records ?? []
        self.take_records(asked, earlier.concat([record]))
    }

    fn question_known_as(question: ContentHash) -> Question? {
        self.new_questions.get(question)?.asked ?? first_answering(
            self.packs.get(),
            (pack) -> pack.question_known_as(question),
        )
    }

    fn answer_bytes(answer: ContentHash) -> SavedBytes? {
        self.unpublished_answer(answer) ?? first_answering(
            self.packs.get(),
            (pack) -> pack.answer_bytes(answer),
        )
    }

    fn keep_answer_bytes(answer: ContentHash, bytes: Bytes) {
        self.new_answers.put(answer, KeptAnswer { answer: answer, bytes: bytes })
    }

    fn hold_answer_bytes(answer: ContentHash, bytes: Bytes) { self.held_answers.put(answer, bytes) }
}

impl DiskStore {
    fn unpublished_answer(answer: ContentHash) -> SavedBytes? {
        let bytes? = self.held_answers.get(answer) ?? self.new_answers.get(answer)?.bytes else { return null }
        saved_bytes_in_memory(bytes)
    }

    fn take_records(asked: Question, records: List<AnswerRecord>) {
        self
            .new_questions
            .put(
                asked.known_as,
                QuestionRecords { question: asked.known_as, asked: asked, records: records },
            )
    }

    /// Whether this process has learned anything it hasn't published.
    fn has_news() -> bool { !self.new_questions.is_empty() || !self.new_answers.is_empty() }

    /// Publishes what this process learned as one pack, absorbing packs no bigger than it, and
    /// answers how many octets it wrote. A process that learned nothing writes nothing.
    fn saved() -> Result<int, IoError> {
        if !self.has_news() { return 0 }
        let fresh = self.octets_of_new()
        let absorbed = absorbed_by(fresh.length, self.packs.get())
        self.take_in(absorbed)
        self.published(if absorbed.is_empty() { fresh } else { self.octets_of_new() }, absorbed)
    }

    /// Publishes what this process learned as a pack of its own, for when others are publishing
    /// beside it and merging would only repeat their work.
    fn saved_alone() -> Result<int, IoError> {
        if !self.has_news() { return 0 }
        self.published(self.octets_of_new(), [])
    }

    /// Every pack as one, for when several are published at once. Answers how many octets it wrote.
    fn merged() -> Result<int, IoError> {
        let packs = self.packs.get()
        if packs.length < 2 { return 0 }
        self.take_in(packs)
        self.published(self.octets_of_new(), packs)
    }

    /// `octets` as a pack on disk, which the store then reads in place of `absorbed`, and has
    /// nothing new. Answers how many octets it wrote.
    fn published(octets: Bytes, absorbed: List<MappedPack>) -> Result<int, IoError> {
        make_dirs(self.directory)?
        let hash = content_hash(octets)
        let path = "${self.directory}/${hash.high_word}_${hash.low_word}${PACK_SUFFIX}"
        write_bytes(path, octets)?
        for pack in absorbed {
            if pack.path != path { let _ = remove(pack.path) }
        }
        let kept = self.packs.get().filter((pack) -> !absorbed.any(it.path == pack.path))
        let opened = mapped_pack(path)
        self.packs.set(if opened == null { kept } else { kept.concat([opened!]) })
        self.new_questions.clear()
        self.new_answers.clear()
        octets.length
    }

    /// What `absorbed` holds, taken in as if it had been learned here.
    fn take_in(absorbed: List<MappedPack>) {
        for pack in absorbed {
            let contents = AnswerPack.read_from(pack.root)
            for entry in contents.questions {
                let earlier = self.new_questions.get(entry.question)?.records ?? []
                self.take_records(entry.asked, merged_records(earlier, entry.records))
            }
            for kept in contents.answers { self.new_answers.put(kept.answer, kept) }
        }
    }

    /// Everything learned and taken in, as one pack's octets.
    fn octets_of_new() -> Bytes { pack_octets(self.new_questions.values(), self.new_answers.values()) }
}

/// The packs a new pack of `length` absorbs: smallest first, each no bigger than all before it.
fn absorbed_by(length: int, packs: List<MappedPack>) -> List<MappedPack> {
    mut gathered = length
    mut absorbed: List<MappedPack> = []
    for pack in sorted_by(packs, (a, b) -> a.length < b.length) {
        if pack.length > gathered { return absorbed }
        gathered = gathered + pack.length
        absorbed.push(pack)
    }
    absorbed
}

/// One question's records from two packs, each set of reads once.
fn merged_records(earlier: List<AnswerRecord>, later: List<AnswerRecord>) -> List<AnswerRecord> {
    earlier.concat(later.filter((record) -> !earlier.any(it.same_as(record))))
}

fn pack_octets(questions: List<QuestionRecords>, answers: List<KeptAnswer>) -> Bytes {
    let sorted_answers = sorted_by(answers, (a, b) -> a.answer.comes_before(b.answer))
    let sorted_questions = sorted_by(questions, (a, b) -> a.question.comes_before(b.question))
    let pack = AnswerPack {
        answer_high_words: [kept.answer.high_word for kept in sorted_answers],
        answers: sorted_answers,
        question_high_words: [entry.question.high_word for entry in sorted_questions],
        questions: sorted_questions,
    }
    pack.saved_bytes().concat(PACK_SEAL.bytes())
}

/// What the first pack that can answer says.
fn first_answering<T>(packs: List<MappedPack>, read: fn(MappedPack) -> T?) -> T? {
    for pack in packs {
        let found? = read(pack) else { continue }
        return found
    }
    null
}
