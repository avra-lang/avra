//! WORK AHEAD ACROSS CORES. When a store knows too little, forked processes answer shards of the
//! work and publish packs, and the asking process then finds those answers like any others. The
//! store already lets many processes publish at once, so nothing is shared but the directory, and
//! there's no runtime or lock to reason about. Nothing here changes an answer: a process that
//! didn't work ahead reaches the same ones by itself.
use settings.{program_settings}
use pass.{Pass}
use layered_store.{LayeredStore, program_store_at}
use disk_store.{
    key_shares,
    save_finished,
    save_held,
    save_left,
    saving_apart,
    wave_sharing_begun,
    wave_writes,
}
use @std.io.{
    AppendFile,
    drafts_leaving,
    drafts_left,
    env,
    read_text,
    remove,
    this_process,
    write_text,
}
use @std.text.{parse_int}
use @std.time.{now_ms}
use query_engine.{QueryDefinition, QueryEngine, query_engine, waits_said}
use query_times.{QueryTimes, TimedSide}
use hash_keyed_table.{HashKeyedTable, hash_keyed_table}
use answer_record.{Question}

extern fn avra_cores_online() -> int
extern fn avra_cores_group(count: int) -> int
extern fn avra_cores_fork(group: int, serving: int) -> int
extern fn avra_cores_leave(group: int, core: int, accepted: int, err: int) -> int
extern fn avra_cores_end_fd(group: int, core: int) -> int
extern fn avra_cores_heard(group: int, core: int) -> int
extern fn avra_cores_killed(group: int, core: int) -> int
extern fn avra_cores_finished(group: int) -> int
extern fn avra_cores_stderr_to(path: string) -> int
extern fn avra_cores_claimed(group: int) -> int
extern fn avra_cores_heir(quiet: int) -> int
extern fn avra_cores_heir_gone() -> int
extern fn avra_fiber_park_fd(fd: int, writable: int, timeout_ms: int) -> int

/// The phase in which the asking process takes what its cores learned.
const ANSWERS_TAKEN: string = "the cores' answers taken"

/// Below this many unanswered items a fork costs more than it saves.
const WORTH_FORKING: int = 16

/// How long a wait for a core lasts before it looks again.
const WAIT_MS: int = 1000

/// No descriptor for a core to keep open.
const NO_DESCRIPTOR: int = -1

/// How many processes this machine runs at once.
// LICENSED input.work_ahead: forked workers answer what this process would, never another answer
export fn cores_online() -> int { avra_cores_online() }

/// What to work out ahead: the items, asked of the engine that works them out, whether an item's
/// answer is already kept, how to ask for it, how many processes to use, whether each process says
/// where its time went, whether the engines that ask count what they work out from the first ask
/// (`QueryEngine.worked_here`), saying nothing, and the order the items are dealt in.
export type WorkAhead<T, R> = {
    items: fn(QueryEngine) -> List<T>,
    is_known: fn(QueryEngine, T) -> bool,
    ask: fn(QueryEngine, T) -> R,
    process_count: int,
    timed: bool = false,
    counted: bool = false,
    deal: Deal = Deal.Listed,
}

/// THE ORDER A WAVE DEALS ITS ITEMS TO ITS PROCESSES: as they're listed, or the last first. What a
/// build answers and keeps is the same either way, so a deal reversed is how a run shows it.
export enum Deal {
    Listed
    Reversed
}

impl WorkAhead<T, R> {
    /// The items `engine` lists, in the order they're dealt.
    fn dealt(engine: QueryEngine) -> List<T> {
        let items = (self.items)(engine)
        match self.deal {
            .Listed -> items,
            .Reversed -> [items[items.length - 1 - at] for at in 0..items.length],
        }
    }
}

/// A store and the engine over it.
export type Worked = { store: LayeredStore, engine: QueryEngine }

/// The store at `directory` and an engine over it, its frontier the one of `program`'s, every
/// unknown item answered across processes first when there are enough to be worth it. With nothing
/// to fork, the engine is the one that asked what's known, so whatever it read stays read.
export fn engine_worked_ahead<T, R>(
    directory: string,
    definitions: List<QueryDefinition>,
    work: WorkAhead<T, R>,
    program: string = "",
) -> Worked {
    let before = program_store_at(directory)
    let asking = query_engine(before, definitions, program)
    if work.timed || work.counted { asking.time_queries() }
    asking.kept_times()?.opened("the frontier opened", TimedSide.Outside, Pass.FrontierOpen)
    let _ = asking.inputs_moved()
    asking.kept_times()?.closed()
    let wave = waves_forked().get()
    if !forked_for<T, R>(before, asking, definitions, work) { return Worked { store: before, engine: asking } }
    waves_forked().set(wave + 1)
    edited_mid_build(wave)
    merged_anew<T, R>(directory, definitions, asking, work, program)
}

/// `from` with every unknown item of `work` answered across processes that go on from everything
/// `from`'s engine has settled, the wave then taken as `engine_worked_ahead` takes one: the store at
/// `directory` opened again, the processes' packs merged, and their answers taken by a fresh engine,
/// its frontier `program`'s, which then holds every answer `from`'s engine settled, so the frontier it
/// keeps holds what the cores went on from. With nothing to fork, `from` as it stands.
export fn worked_within<T, R>(
    directory: string,
    definitions: List<QueryDefinition>,
    from: Worked,
    work: WorkAhead<T, R>,
    program: string = "",
) -> Worked {
    let wave = waves_forked().get()
    if !cores_within<T, R>(from.store, from.engine, work, () -> 0) { return from }
    edited_mid_build(wave)
    let taken = merged_anew<T, R>(directory, definitions, from.engine, work, program)
    taken.engine.settled_from(from.engine)
    taken
}

/// THE WAVE'S ANSWERS TAKEN ANEW, once its processes have gone: the store at `directory` opened
/// again, the packs they published merged, and what they learned taken by a fresh engine over it, its
/// frontier `program`'s, `asking` saying where the time went.
fn merged_anew<T, R>(
    directory: string,
    definitions: List<QueryDefinition>,
    asking: QueryEngine,
    work: WorkAhead<T, R>,
    program: string,
) -> Worked {
    asking.kept_times()?.opened("the work merged", TimedSide.Outside, Pass.StoreSave)
    let after = program_store_at(directory)
    let engine = query_engine(after, definitions, program)
    if work.counted { engine.time_queries() }
    let merging = merge_begun(after, work.process_count)
    asking.kept_times()?.closed()
    asking.kept_times()?.opened(ANSWERS_TAKEN, TimedSide.Outside, Pass.StoreOpen)
    let taken = shared_taken(after, engine, work.process_count, work.counted)
    asking.kept_times()?.closed()
    asking.kept_times()?.opened("the work merged", TimedSide.Outside, Pass.StoreSave)
    merge_ended(after, merging, work.process_count)
    asking.kept_times()?.closed()
    if work.timed { eprintln("ahead: ${taken}") }
    let times = asking.kept_times()
    if times != null { eprintln(ahead_times(times!)) }
    Worked { store: after, engine: engine }
}

/// Below this many answers and questions, merging the packs here costs less than forking to.
const WORTH_MERGING_APART: int = 50000

/// No group of processes.
const NO_GROUP: int = -1

/// THE PACKS MANY PROCESSES PUBLISHED, MERGED BY AS MANY: each of `process_count` forked processes
/// publishes one share of the keys of every pack `store` reads as a pack of its own, while the
/// asking process goes on reading the packs where they lie. Answers the group merging, or
/// `NO_GROUP` where the packs were merged here: too few to be worth a fork, or none forked.
fn merge_begun(store: LayeredStore, process_count: int) -> int {
    if process_count < 2 ||
        store.own.packs.get().length < 2 ||
        store.entries_published() < worth_merging_apart() ||
        program_settings().debug.merged_here {
        let _ = store.merged()
        return NO_GROUP
    }
    // LICENSED input.work_ahead: forked workers answer what this process would, never another answer
    let group = avra_cores_group(process_count)
    // LICENSED input.work_ahead: forked workers answer what this process would, never another answer
    let core = if group < 0 { -1 } else { avra_cores_fork(group, NO_DESCRIPTOR) }
    if core < 0 {
        let _ = store.merged()
        return NO_GROUP
    }
    if core < process_count {
        let merged = program_settings().debug.share_unmerged != "${core}" &&
            store.share_merged(key_shares(process_count)[core])
        if merged && program_settings().user.qtrace { eprintln("store: share ${core} of ${process_count} published") }
        let _ = avra_cores_leave(group, core, 1, if merged { 0 } else { 1 })
    }
    group
}

/// The merge `merge_begun` left to `group` ended: where every process published its share, the
/// packs they merged go and `store` reads the shares; where one didn't, `store` reads whatever
/// stands and merges it here, which costs time and no answer.
fn merge_ended(store: LayeredStore, group: int, process_count: int) {
    if group == NO_GROUP { return }
    if waited_for(group, process_count) == process_count { return store.shares_taken() }
    store.packs_read_again()
    let _ = store.merged()
}

/// How many answers and questions are worth merging apart: `AVRA_MERGED_APART_FROM`, a witness's way
/// to merge a small store apart, else `WORTH_MERGING_APART`.
fn worth_merging_apart() -> int { program_settings().debug.merged_apart_from ?? WORTH_MERGING_APART }

/// Answers every unknown item across processes, each taking the next item no other has taken
/// and asking it where it knows nothing of it, and says whether any process ran: none where fewer than
/// `WORTH_FORKING` are unknown. A process that didn't finish costs only time: what it published
/// stands, and the rest is answered here.
fn forked_for<T, R>(
    store: LayeredStore,
    engine: QueryEngine,
    definitions: List<QueryDefinition>,
    work: WorkAhead<T, R>,
) -> bool {
    let known_by = work.is_known
    let items = work.dealt(engine)
    if work.process_count < 2 || !at_least(items, WORTH_FORKING, (item) -> !known_by(engine, item)) { return false }
    engine.kept_times()?.opened("the cores", TimedSide.Outside, Pass.Lower)
    let _ = store.saved()
    if store.has_news() {
        eprintln(unpublished_before_fork())
        return false
    }
    // LICENSED input.work_ahead: forked workers answer what this process would, never another answer
    let group = avra_cores_group(work.process_count)
    if group < 0 { return false }
    if wave_sharing_begun(store.own.directory) { table_spoiled().set(false) }
    // LICENSED input.work_ahead: forked workers answer what this process would, never another answer
    let core = avra_cores_fork(group, NO_DESCRIPTOR)
    if core < 0 { return false }
    if core < work.process_count {
        answered_and_gone<T, R>(
            store,
            definitions,
            items,
            work.is_known,
            work.ask,
            group,
            core,
            work.timed,
        )
    }
    let finished = waited_for(group, work.process_count)
    engine.kept_times()?.closed()
    if finished < work.process_count { cores_lost(work.process_count - finished, work.process_count) }
    true
}

/// A WAVE WITHIN A BUILD: every item of `work` that `engine` knows nothing of answered across
/// forked processes, each of which goes on from everything `engine` has settled, and their answers
/// taken by `engine` itself, which goes on from them; whether any process ran. `store` is the
/// one `engine` answers from, kept at `directory`. What the asking process learned is published
/// first, so every process reads it; the cores' packs are read where they lie, the next save's to
/// absorb, and their answers taken where every input a core read since it forked is what `engine`
/// reads.
export fn asked_across<T, R>(store: LayeredStore, engine: QueryEngine, work: WorkAhead<T, R>) -> bool {
    asked_across_while<T, R>(store, engine, work, () -> 0)
}

/// `asked_across`, the asking process doing `meanwhile` once its cores are forked and before it
/// takes anything of theirs: what a witness edits an input in.
export fn asked_across_while<T, R>(
    store: LayeredStore,
    engine: QueryEngine,
    work: WorkAhead<T, R>,
    meanwhile: fn() -> int,
) -> bool {
    if !cores_within<T, R>(store, engine, work, meanwhile) { return false }
    store.packs_read_again()
    engine.kept_times()?.opened(ANSWERS_TAKEN, TimedSide.Outside, Pass.StoreOpen)
    let taken = shared_taken(store, engine, work.process_count, work.counted)
    engine.kept_times()?.closed()
    if work.timed { eprintln("within: ${taken}") }
    true
}

/// Every unknown item of `work` answered across processes that go on from everything `engine` has
/// settled, the asking process doing `meanwhile` while they run; whether any process ran: none where
/// fewer than `WORTH_FORKING` are unknown, or nothing could be forked. Nothing of theirs is taken.
fn cores_within<T, R>(
    store: LayeredStore,
    engine: QueryEngine,
    work: WorkAhead<T, R>,
    meanwhile: fn() -> int,
) -> bool {
    let known_by = work.is_known
    let items = work.dealt(engine)
    if work.process_count < 2 || !at_least(items, WORTH_FORKING, (item) -> !known_by(engine, item)) { return false }
    engine.kept_times()?.opened("the cores", TimedSide.Outside, Pass.Lower)
    let _ = store.saved()
    let wave = waves_forked().get()
    // LICENSED input.work_ahead: forked workers answer what this process would, never another answer
    let group = if store.has_news() { -1 } else { avra_cores_group(work.process_count) }
    // LICENSED input.work_ahead: forked workers answer what this process would, never another answer
    let core = if group < 0 { -1 } else { avra_cores_fork(group, NO_DESCRIPTOR) }
    if core < 0 {
        engine.kept_times()?.closed()
        return false
    }
    if core < work.process_count {
        within_and_gone<T, R>(store, engine, items, work, group, core)
    }
    wave_writes(true)
    let _ = meanwhile()
    wave_writes(false)
    let finished = waited_for(group, work.process_count)
    engine.kept_times()?.closed()
    waves_forked().set(wave + 1)
    if finished < work.process_count { cores_lost(work.process_count - finished, work.process_count) }
    true
}

/// ONE PROCESS ANSWERING `work`'s ITEMS BESIDE THE ASKING PROCESS, which does `meanwhile` with
/// the same engine and then takes what the process learned: two stretches of a build that read
/// nothing of each other, done at once. `meanwhile` answers whether the items are still wanted;
/// where they are not, the process is ended and nothing of it is taken. Whether a process was
/// forked, and so `meanwhile` done: where every item is known, or nothing can be forked, neither.
export fn asked_beside<T, R>(
    store: LayeredStore,
    engine: QueryEngine,
    work: WorkAhead<T, R>,
    meanwhile: fn() -> bool,
) -> bool {
    let known_by = work.is_known
    let items = (work.items)(engine)
    if !items.any((item) -> !known_by(engine, item)) { return false }
    engine.kept_times()?.opened("the cores", TimedSide.Outside, Pass.Lower)
    let _ = store.saved()
    let wave = waves_forked().get()
    // LICENSED input.work_ahead: forked workers answer what this process would, never another answer
    let group = if store.has_news() { -1 } else { avra_cores_group(1) }
    // LICENSED input.work_ahead: forked workers answer what this process would, never another answer
    let core = if group < 0 { -1 } else { avra_cores_fork(group, NO_DESCRIPTOR) }
    engine.kept_times()?.closed()
    if core < 0 { return false }
    if core < 1 {
        within_and_gone<T, R>(store, engine, items, work with { process_count: 1 }, group, core)
    }
    if program_settings().debug.beside == "killed" { let _ = avra_cores_killed(group, 0) }
    wave_writes(true)
    let wanted = meanwhile() && program_settings().debug.beside != "unwanted"
    wave_writes(false)
    if !wanted { let _ = avra_cores_killed(group, 0) }
    engine.kept_times()?.opened("the cores", TimedSide.Outside, Pass.Lower)
    let finished = waited_for(group, 1)
    engine.kept_times()?.closed()
    waves_forked().set(wave + 1)
    if !wanted {
        table_spoiled().set(true)
        if work.timed { eprintln("beside: the process ended, nothing of it taken") }
        return true
    }
    if finished < 1 { cores_lost(1, 1) }
    store.packs_read_again()
    engine.kept_times()?.opened(ANSWERS_TAKEN, TimedSide.Outside, Pass.StoreOpen)
    let taken = shared_taken(store, engine, 1, work.counted)
    engine.kept_times()?.closed()
    if work.timed { eprintln("beside: ${taken}") }
    true
}

/// A process forked within a build: takes turns at `items` with the engine it was forked holding,
/// publishes what it learned since, and leaves.
fn within_and_gone<T, R>(
    store: LayeredStore,
    engine: QueryEngine,
    items: List<T>,
    work: WorkAhead<T, R>,
    group: int,
    core: int,
) {
    wave_writes(true)
    let known_by = work.is_known
    let ask = work.ask
    mut answered = 0
    mut turn = avra_cores_claimed(group)
    while turn < items.length {
        if !known_by(engine, items[turn]) {
            let _ = ask(engine, items[turn])
            answered = answered + 1
        }
        turn = avra_cores_claimed(group)
    }
    let _ = store.saved_alone()
    if work.timed { eprintln("core ${core}: ${answered} answered within the build") }
    let _ = avra_cores_leave(group, core, answered, 0)
}

/// What the `processes` processes of a wave learned, taken by `engine` where they stand in `store`'s
/// table of the build, every input among them remembered as read anew where the run is `counted`:
/// how many processes' answers were taken, or why none were.
fn shared_taken(store: LayeredStore, engine: QueryEngine, processes: int, counted: bool) -> string {
    if table_spoiled().get() {
        engine.shared_let_go()
        return "no core's answers taken: a process of this build ended before it published"
    }
    let why? = engine.took_shared(!program_settings().debug.ahead_unproven) else {
        if counted { for e in store.shared_entries(true) { inputs_taken().put(e.question, true) } }
        return "${processes} cores' answers taken"
    }
    "no core's answers taken: ${why}"
}

/// Every input a core of this process read and this process took, by what its question is known as.
once fn inputs_taken() -> HashKeyedTable<bool> { hash_keyed_table() }

/// Whether the input `asked` was read by a core of this process and taken here: a core's engine dies
/// with it, so what it worked out is told here only by the inputs it read.
export fn read_by_cores(asked: Question) -> bool { inputs_taken().get(asked.known_as) != null }

/// WHETHER A PROCESS OF THIS BUILD ENDED BEFORE IT PUBLISHED: what it kept in the build's table may
/// name answers no pack holds, so from then on nothing there is taken whole, and each answer is
/// checked read by read as a kept one is, which keeps here what only the table holds.
once fn table_spoiled() -> Cell<bool> { Cell.new(false) }

/// `unfinished` of a wave's `of` processes ended before they finished: said, and the build's table
/// no longer taken whole.
fn cores_lost(unfinished: int, of: int) {
    table_spoiled().set(true)
    eprintln(cores_unfinished(unfinished, of))
}

/// Whether this process has forked a wave.
export fn has_worked_ahead() -> bool { waves_forked().get() > 0 }

/// Whether `wanted` holds of at least `count` of `items`, asking no further than it must.
fn at_least<T>(items: List<T>, count: int, wanted: fn(T) -> bool) -> bool {
    mut found = 0
    for item in items {
        if !wanted(item) { continue }
        found = found + 1
        if found >= count { return true }
    }
    false
}

/// A forked process's whole life: takes turns with the group's other processes at `items`, each
/// item one process's alone, answers each it takes that it knows nothing of, publishes, and
/// leaves without tidying up.
fn answered_and_gone<T, R>(
    store: LayeredStore,
    definitions: List<QueryDefinition>,
    items: List<T>,
    is_known: fn(QueryEngine, T) -> bool,
    ask: fn(QueryEngine, T) -> R,
    group: int,
    core: int,
    timed: bool,
) {
    wave_writes(true)
    let engine = query_engine(store, definitions)
    if timed { engine.time_queries() }
    mut answered = 0
    mut turn = avra_cores_claimed(group)
    while turn < items.length {
        if !is_known(engine, items[turn]) {
            let _ = ask(engine, items[turn])
            answered = answered + 1
        }
        turn = avra_cores_claimed(group)
    }
    let _ = store.saved_alone()
    let times = engine.kept_times()
    if times != null { eprintln(core_times(core, answered, times!)) }
    let _ = avra_cores_leave(group, core, answered, 0)
}

/// How a run in a process of its own came out: what it answered, that it ended before it
/// answered, or that it ran past its bound and was ended.
export enum Apart {
    Answered(text: string)
    Ended
    Outlasted
}

/// What `run` answers, worked out in a forked process of its own and left at `kept`, so what ends it
/// — a signal, a trap — ends only that process, and one still running after `within_ms` is killed.
/// A process `run` forks in turn that returns out of it is never that one: it leaves at once,
/// answering nothing and running nothing more of its caller's.
export fn answered_apart(run: fn() -> string, kept: string, within_ms: int) -> Apart {
    let _ = remove(kept)
    // LICENSED input.work_ahead: forked workers answer what this process would, never another answer
    let group = avra_cores_group(1)
    if group < 0 { return Apart.Ended }
    // LICENSED input.work_ahead: forked workers answer what this process would, never another answer
    let core = avra_cores_fork(group, NO_DESCRIPTOR)
    if core < 0 { return Apart.Ended }
    if core == 0 {
        // LICENSED input.work_ahead: forked workers answer what this process would, never another answer
        let mine = this_process()
        let answer = run()
        // LICENSED input.work_ahead: forked workers answer what this process would, never another answer
        if this_process() == mine { let _ = write_text(kept, answer) }
        let _ = avra_cores_leave(group, core, 0, 0)
    }
    // LICENSED input.clock: a timing reads the clock, never an input of what is built
    let deadline = now_ms() + within_ms
    while avra_cores_heard(group, 0) != 0 {
        // LICENSED input.clock: a timing reads the clock, never an input of what is built
        let left = deadline - now_ms()
        if left <= 0 {
            let _ = avra_cores_killed(group, 0)
            let _ = avra_cores_finished(group)
            return Apart.Outlasted
        }
        let _ = avra_fiber_park_fd(
            avra_cores_end_fd(group, 0),
            0,
            if left < WAIT_MS { left } else { WAIT_MS },
        )
    }
    if avra_cores_finished(group) != 1 { return Apart.Ended }
    // LICENSED input.work_ahead: forked workers answer what this process would, never another answer
    match read_text(kept) { .Ok(t) -> Apart.Answered(t), .Err(_) -> Apart.Ended }
}

/// `save` RUN BY AN HEIR, a forked process that outlives this one, so this one answers without
/// waiting for it: whether one took it; where none did, nothing has run. `save` answers why it
/// kept nothing, absent where it kept all, which the next process to open the store says. The heir holds what this
/// process learned and every draft it wrote, and is the one saver of each of `store`'s layers
/// until it ends, so a process that opens the store after this one answers waits and reads the
/// save whole. With `quiet` the heir says nothing. A layer another process is saving, or a fork
/// refused, leaves the save to the caller.
export fn saved_by_heir(store: LayeredStore, quiet: bool, save: fn() -> string?) -> bool {
    let layers = store.directories()
    let held = [l! for d in layers for l in [save_held(d)] if l != null]
    if held.length != layers.length {
        let_go(held)
        return false
    }
    save_left(layers[0])
    drafts_leaving()
    // LICENSED input.work_ahead: forked workers answer what this process would, never another answer
    let forked = avra_cores_heir(if quiet { 1 } else { 0 })
    if forked == 0 {
        drafts_left(false)
        saving_apart().set(true)
        let failed = save()
        save_finished(layers[0], failed)
        let _ = avra_cores_heir_gone()
    }
    drafts_left(forked > 0)
    let_go(held)
    if forked < 0 { save_finished(layers[0], null) }
    forked > 0
}

/// Each of `held` closed by this process.
fn let_go(held: List<AppendFile>) {
    for l in held { let _ = l.closed() catch 0 }
}

/// This process's own words written to `path` from here on, in place of the stderr it shares with the
/// process that forked it — so what a process judging apart says is its own record, never the
/// asker's: whether it now writes there.
export fn words_to(path: string) -> bool { avra_cores_stderr_to(path) == 0 }

/// Waits until every process has ended, hearing each that has ended whichever it is waiting on, so
/// none that ended stands unreaped while another runs, and says how many finished their share.
fn waited_for(group: int, process_count: int) -> int {
    while true {
        let running = [core for core in 0..process_count if avra_cores_heard(group, core) != 0]
        let first? = running.first() else { return avra_cores_finished(group) }
        let _ = avra_fiber_park_fd(avra_cores_end_fd(group, first), 0, WAIT_MS)
    }
    0
}

// ── The voices ──

/// A fork with a draft standing would hand the draft to every core.
fn unpublished_before_fork() -> string {
    "avra: what this process learned could not be published before forking, so nothing was worked ahead"
}

/// Some processes ended before finishing their share.
fn cores_unfinished(unfinished: int, of: int) -> string {
    "avra: ${unfinished} of ${of} cores working ahead didn't finish; what they left is answered here"
}

/// Where the asking process's time went around its cores.
fn ahead_times(times: QueryTimes) -> string { "ahead: time: ${times.spoken(15)}; split: ${times.split()}" }

/// Where a core's asks spent their time.
fn core_times(core: int, answered: int, times: QueryTimes) -> string {
    "core ${core}: ${answered} answered; time: ${times.spoken(15)}; split: ${times.split()}; ${waits_said()}"
}

/// How many waves this process forked.
once fn waves_forked() -> Cell<int> { Cell.new(0) }

/// THE WITNESS'S EDIT, made between a wave and its merge: `AVRA_AHEAD_EDIT` as
/// `<wave>:<path>=<text>`, written after the wave of that number, counted from 0, forked.
fn edited_mid_build(wave: int) {
    let spelled? = program_settings().debug.ahead_edit else { return }
    let colon = spelled.index_of(":")
    let equals = spelled.index_of("=")
    if colon < 0 || equals < colon || spelled.substring(0, colon) != "${wave}" { return }
    let _ = write_text(
        spelled.substring(colon + 1, equals),
        spelled.substring(equals + 1, spelled.length),
    )
}

