//! WHAT THE ENGINE REMEMBERS ABOUT ONE ANSWER: which question it answered, a hash of the answer,
//! and every answer it read to get there. The answer's own bytes live apart, under their hash, so
//! a record can be checked without touching them. A record stands only while every read still
//! holds; a question with no record has no answer, and is computed.
use @std.hash.{blake3, hasher}
use @std.meta.{derive}
use saved_derive.{Saved}
use saved_layout.{SavedList, SavedRecord, SavedSlots, word_in}

/// The first sixteen octets of a BLAKE3 hash, as two numbers: what a question or an answer's bytes
/// are known by. Two numbers compare in two instructions.
@derive(Saved)
export type ContentHash = { high_word: int, low_word: int }

impl ContentHash {
    /// An order over hashes, for keeping them sorted.
    fn comes_before(other: ContentHash) -> bool {
        self.high_word < other.high_word ||
            self.high_word == other.high_word && self.low_word < other.low_word
    }

    fn same_as(other: ContentHash) -> bool { self.high_word == other.high_word && self.low_word == other.low_word }
}

/// The hash of `octets`.
export fn content_hash(octets: Bytes) -> ContentHash { hash_of_digest(blake3(octets)) }

/// The hash of runs of octets written one after another: the same as the hash of them joined.
export fn runs_hash(runs: List<Bytes>) -> ContentHash { hash_of_digest(runs.fold(hasher(), (h, run) -> h.update(run)).digest()) }

/// A BLAKE3 digest's first sixteen octets.
fn hash_of_digest(digest: Bytes) -> ContentHash { ContentHash { high_word: word_in(digest, 0), low_word: word_in(digest, 8) } }

/// Where the key `wanted` stands in a table sorted by hash, its keys' high words held in
/// `high_words`: `low_word_at` reads the low word of the key at a place, absent when it can't be
/// read. A search touches the list of numbers, and reads a key only where it might have found it.
export fn place_keyed_by(high_words: SavedList, wanted: ContentHash, low_word_at: fn(int) -> int?) -> int? {
    mut position = high_words.first_at_or_after(wanted.high_word)
    while position < high_words.length && high_words.number_at(position) == wanted.high_word {
        let low? = low_word_at(position) else { return null }
        if low == wanted.low_word { return position }
        position = position + 1
    }
    null
}

/// Where the entry keyed by `wanted` stands in a table held in place: a list of the keys' high words
/// beside a list of entries, each entry's first field its key.
export fn place_keyed(high_words: SavedList, entries: SavedList, wanted: ContentHash) -> int? {
    place_keyed_by(
        high_words,
        wanted,
        (at) -> ContentHash.low_word_in(entries.record_at(at)!.record_at(0)!),
    )
}

/// The entry keyed by `wanted` in such a table.
export fn entry_keyed(high_words: SavedList, entries: SavedList, wanted: ContentHash) -> SavedRecord? {
    let at? = place_keyed(high_words, entries, wanted) else { return null }
    entries.record_at(at)
}

/// A question: which query, a hash of its code, and its arguments as bytes.
@derive(Saved)
export type Question = { query_name: string, code_hash: string, arguments: Bytes, known_as: ContentHash }

/// A question, with what it's known by across processes. Its code's hash is part of that, so a
/// changed query never finds its old answers. The name and the code are counted, so they can't
/// trade octets with the arguments.
export fn question(query_name: string, code_hash: string, arguments: Bytes) -> Question {
    let counted = "${query_name.length}:${query_name}${code_hash.length}:${code_hash}".bytes()
    Question {
        query_name: query_name,
        code_hash: code_hash,
        arguments: arguments,
        known_as: content_hash(counted.concat(arguments)),
    }
}

/// The part of an answer a read looked at, and the hash of what it saw there.
@derive(Saved)
export type PartSeen = { part_name: ContentHash, part_hash: ContentHash }

/// One answer read while computing another: which question was asked, the hash of its whole
/// answer then, and the part looked at if it was only a part. A part that wasn't there is recorded
/// too, as the hash of absence, so it moves when the part appears. An answer whose whole hash
/// hasn't moved proves every part of it, so most reads are checked without opening the answer.
@derive(Saved)
export type RecordedRead = { question: ContentHash, whole_answer: ContentHash, part: PartSeen? }

/// One way a question was answered: the hash that finds the answer's bytes, and everything read to
/// get there, as words, so a record is checked where it lies. A whole read is four words, its
/// question then the whole answer it saw; a part read is eight, those then the part's name and the
/// part's hash.
@derive(Saved)
export type AnswerRecord = { answer: ContentHash, whole_reads: List<int>, part_reads: List<int> }

/// The words of a whole read.
const WHOLE_READ_WORDS: int = 4

/// The words of a part read.
const PART_READ_WORDS: int = 8

/// The record of an answer and what was read to get there.
export fn answer_record(answer: ContentHash, reads: List<RecordedRead>) -> AnswerRecord {
    AnswerRecord {
        answer: answer,
        whole_reads: [word for read in reads.filter(it.part == null) for word in read.words()],
        part_reads: [word for read in reads.filter(it.part != null) for word in read.words()],
    }
}

impl AnswerRecord {
    fn kept() -> KeptRecord {
        KeptRecord {
            answer: self.answer,
            whole_reads: RecordWords.Held(self.whole_reads),
            part_reads: RecordWords.Held(self.part_reads),
        }
    }

    /// Whether two records say the same thing, so keeping both would add nothing.
    fn same_as(other: AnswerRecord) -> bool { self.kept().same_as(other) }
}

/// A record's words, held in memory or read where they lie.
export enum RecordWords {
    Held(List<int>)
    Laid(SavedList)
}

impl RecordWords {
    fn length() -> int {
        match self { .Held(words) -> words.length, .Laid(words) -> words.length }
    }

    fn at(position: int) -> int {
        match self { .Held(words) -> words[position], .Laid(words) -> words.number_at(position) }
    }

    /// The hash whose words start at `position`.
    fn hash_at(position: int) -> ContentHash { ContentHash { high_word: self.at(position), low_word: self.at(position + 1) } }

    fn same_as(other: List<int>) -> bool { self.length() == other.length && (0..other.length).all((i) -> self.at(i) == other[i]) }

    /// Every word, held.
    fn words() -> List<int> {
        match self {
            .Held(words) -> words,
            .Laid(words) -> [words.number_at(i) for i in 0..words.length],
        }
    }
}

/// A record as the engine checks it, its reads never decoded.
export type KeptRecord = { answer: ContentHash, whole_reads: RecordWords, part_reads: RecordWords }

/// The record saved at `record`, read where it lies.
export fn kept_in_place(record: SavedRecord) -> KeptRecord {
    KeptRecord {
        answer: ContentHash.read_from(AnswerRecord.answer_in_place(record)),
        whole_reads: RecordWords.Laid(AnswerRecord.whole_reads_in_place(record)),
        part_reads: RecordWords.Laid(AnswerRecord.part_reads_in_place(record)),
    }
}

impl KeptRecord {
    fn same_as(other: AnswerRecord) -> bool {
        self.answer.same_as(other.answer) &&
            self.whole_reads.same_as(other.whole_reads) &&
            self.part_reads.same_as(other.part_reads)
    }

    /// The record, its words held.
    fn held() -> AnswerRecord {
        AnswerRecord {
            answer: self.answer,
            whole_reads: self.whole_reads.words(),
            part_reads: self.part_reads.words(),
        }
    }

    /// Whether every read holds, in the order kept: each whole read asked of its question and the
    /// answer it saw, then each part read of those, the part's name and the part's hash.
    fn every_read(
        whole: fn(ContentHash, ContentHash) -> bool,
        part: fn(ContentHash, ContentHash, ContentHash, ContentHash) -> bool,
    ) -> bool {
        let wholes = self.whole_reads
        let parts = self.part_reads
        (0..wholes.length() / WHOLE_READ_WORDS)
                .all(
                    (i) -> whole(
                        wholes.hash_at(i * WHOLE_READ_WORDS),
                        wholes.hash_at(i * WHOLE_READ_WORDS + 2),
                    ),
                ) &&
            (0..parts.length() / PART_READ_WORDS)
                .all(
                    (i) -> part(
                        parts.hash_at(i * PART_READ_WORDS),
                        parts.hash_at(i * PART_READ_WORDS + 2),
                        parts.hash_at(i * PART_READ_WORDS + 4),
                        parts.hash_at(i * PART_READ_WORDS + 6),
                    ),
                )
    }

    /// The question of every read, whole reads first.
    fn read_questions() -> List<ContentHash> {
        [self.whole_reads.hash_at(i * WHOLE_READ_WORDS) for i in 0..self.whole_reads.length() / WHOLE_READ_WORDS]
            .concat(
                [self.part_reads.hash_at(i * PART_READ_WORDS) for i in 0..self.part_reads.length() / PART_READ_WORDS],
            )
    }
}

impl RecordedRead {
    /// The words this read is kept as.
    fn words() -> List<int> {
        let seen = [
            self.question.high_word,
            self.question.low_word,
            self.whole_answer.high_word,
            self.whole_answer.low_word,
        ]
        let part? = self.part else { return seen }
        seen
            .concat(
                [
                    part.part_name.high_word,
                    part.part_name.low_word,
                    part.part_hash.high_word,
                    part.part_hash.low_word,
                ],
            )
    }

    /// What makes this read one read: its question, and its part if it looked at one. A reader
    /// that reads the same thing twice has one read.
    fn read_key() -> ContentHash {
        let part? = self.part else { return self.question }
        ContentHash {
            high_word: self.question.high_word.wrapping_shl(1) ^ part.part_name.high_word,
            low_word: self.question.low_word.wrapping_shl(1) ^ part.part_name.low_word,
        }
    }
}
