//! WHAT THE ENGINE REMEMBERS ABOUT ONE ANSWER: which question it answered, a hash of the answer,
//! and every answer it read to get there. The answer's own bytes live apart, under their hash, so
//! a record can be checked without touching them. A record stands only while every read still
//! holds; a question with no record has no answer, and is computed.
use @std.io.{word_name}
use @std.hash.{blake3, hasher}
use @std.meta.{derive}
use saved_derive.{Saved}
use saved_layout.{SavedList, SavedRecord, SavedSlots, SavedSource, word_in}
use sorted.{order_by_words}

/// The first sixteen octets of a BLAKE3 hash, as two numbers: what a question or an answer's bytes
/// are known by. Two numbers compare in two instructions.
@derive(Saved)
export type ContentHash = { high_word: int, low_word: int }

impl ContentHash {
    /// The hash as one text, what a table of what its answer reads back as is keyed by.
    fn held_key() -> string { "${self.high_word}:${self.low_word}" }

    /// An order over hashes, for keeping them sorted.
    fn comes_before(other: ContentHash) -> bool {
        self.high_word < other.high_word ||
            self.high_word == other.high_word && self.low_word < other.low_word
    }

    fn same_as(other: ContentHash) -> bool { self.high_word == other.high_word && self.low_word == other.low_word }
}

/// The hash of `octets`.
export fn content_hash(octets: Bytes) -> ContentHash { hash_of_digest(blake3(octets)) }

/// The words of one hash.
export const HASH_WORDS: int = 2

/// The hash whose words start at `position` of `words`.
export fn hash_in(words: List<int>, position: int) -> ContentHash { ContentHash { high_word: words[position], low_word: words[position + 1] } }

/// `hashes` as words: each one's high word, then its low.
export fn words_of(hashes: List<ContentHash>) -> List<int> { [word for h in hashes for word in [h.high_word, h.low_word]] }

/// The hashes `words` holds, each as its two words.
export fn hashes_in(words: List<int>) -> List<ContentHash> { [hash_in(words, at * HASH_WORDS) for at in 0..words.length / HASH_WORDS] }

/// `items` in the order of the hash `key` reads from each, as `ContentHash.comes_before` says. Items
/// of one hash keep their order.
export fn sorted_by_hash<T>(items: List<T>, key: fn(T) -> ContentHash) -> List<T> {
    let keys = [key(item) for item in items]
    [items[at] for at in order_by_words([k.high_word for k in keys], [k.low_word for k in keys])]
}

/// The hash of runs of octets written one after another: the same as the hash of them joined.
export fn runs_hash(runs: List<Bytes>) -> ContentHash { hash_of_digest(runs.fold(hasher(), (h, run) -> h.update(run)).digest()) }

/// A BLAKE3 digest's first sixteen octets.
fn hash_of_digest(digest: Bytes) -> ContentHash { ContentHash { high_word: word_in(digest, 0), low_word: word_in(digest, 8) } }

/// Where the key `wanted` stands in a table sorted by hash, its keys' high words held in
/// `high_words`: `low_word_at` reads the low word of the key at a place, absent when it can't be
/// read. A search touches the list of numbers, and reads a key only where it might have found it.
/// The lists lie in `source`.
export fn place_keyed_by(
    source: SavedSource,
    high_words: SavedList,
    wanted: ContentHash,
    low_word_at: fn(int) -> int?,
) -> int? {
    mut position = high_words.first_at_or_after(source, wanted.high_word)
    while position < high_words.length && high_words.number_at(source, position) == wanted.high_word {
        let low? = low_word_at(position) else { return null }
        if low == wanted.low_word { return position }
        position = position + 1
    }
    null
}

/// Where the entry keyed by `wanted` stands in a table held in place: a list of the keys' high words
/// beside a list of entries, each entry's first field its key.
export fn place_keyed(
    source: SavedSource,
    high_words: SavedList,
    entries: SavedList,
    wanted: ContentHash,
) -> int? {
    place_keyed_by(
        source,
        high_words,
        wanted,
        (at) -> ContentHash.low_word_in(source, entries.record_in(source, at).record_in(source, 0)),
    )
}

/// The entry keyed by `wanted` in such a table.
export fn entry_keyed(
    source: SavedSource,
    high_words: SavedList,
    entries: SavedList,
    wanted: ContentHash,
) -> SavedRecord? {
    let at? = place_keyed(source, high_words, entries, wanted) else { return null }
    entries.record_at(source, at)
}

/// A question: which query, a hash of its code, its arguments as bytes, what it's known by, and
/// whether those bytes spell its arguments' keys rather than save them.
@derive(Saved)
export type Question = { query_name: string, code_hash: string, arguments: Bytes, known_as: ContentHash, keyed: bool = false }

/// A question, with what it's known by across processes. Its code's hash is part of that, so a
/// changed query never finds its old answers. The name and the code are counted, so they can't
/// trade octets with the arguments.
export fn question(query_name: string, code_hash: string, arguments: Bytes) -> Question {
    let counted = counted_for(query_name, code_hash).saved
    Question {
        query_name: query_name,
        code_hash: code_hash,
        arguments: arguments,
        known_as: content_hash(counted.concat(arguments)),
    }
}

/// What a query's questions are counted from ahead of their arguments: its code's hash, and its name
/// and that hash counted, for a question saving its arguments and for one spelling their keys.
type Counted = { code_hash: string, saved: Bytes, keyed: Bytes }

/// Each query's counted words, by its name: minted the first time it asks, and again where its code
/// moved.
once fn counted_by_query() -> Cell<Map<string, Counted>> { Cell.new({}) }

/// The counted words of the query `query_name` whose code hashes as `code_hash`.
fn counted_for(query_name: string, code_hash: string) -> Counted {
    let held = counted_by_query().get().get(query_name)
    if held != null && held!.code_hash == code_hash { return held! }
    let made = Counted {
        code_hash: code_hash,
        saved: counted_words("saved", query_name, code_hash),
        keyed: counted_words("keyed", query_name, code_hash),
    }
    counted_by_query().put(query_name, made)
    made
}

/// The query's name and code's hash counted under `kind`, in the question's shape.
fn counted_words(kind: string, query_name: string, code_hash: string) -> Bytes {
    "${kind} ${QUESTION_SHAPE} ${query_name.length}:${query_name}${code_hash.length}:${code_hash}"
        .bytes()
}

/// THE SHAPE A QUESTION'S IDENTITY IS MADE IN: how its arguments are written into what it's known
/// by. Every identity and every frontier's print names it, so a question made in another shape is
/// never known as one made in this, and a store written in another shape is simply cold.
export const QUESTION_SHAPE: string = "3"

/// A question whose arguments are spelled as their keys. It's counted apart from one whose arguments
/// are saved bytes, so no question of one kind is ever known as one of the other.
export fn keyed_question(query_name: string, code_hash: string, arguments: Bytes) -> Question {
    let counted = counted_for(query_name, code_hash).keyed
    Question {
        query_name: query_name,
        code_hash: code_hash,
        arguments: arguments,
        known_as: content_hash(counted.concat(arguments)),
        keyed: true,
    }
}

/// The part of an answer a read looked at, and the hash of what it saw there.
@derive(Saved)
export type PartSeen = { part_name: ContentHash, part_hash: ContentHash }

/// One answer read while computing another: which question was asked, the hash of its whole
/// answer then, and the part looked at if it was only a part. A part that wasn't there is recorded
/// too, as the hash of absence, so it moves when the part appears. An answer whose whole hash
/// hasn't moved proves every part of it, so most reads are checked without opening the answer.
@derive(Saved)
export type RecordedRead = { question: ContentHash, whole_answer: ContentHash, part: PartSeen? }

/// One way a question was answered: the hash that finds the answer's bytes, everything read to get
/// there, as words, so a record is checked where it lies, and the packages those reads read, sorted.
/// A whole read is four words, its question then the whole answer it saw; a part read is eight,
/// those then the part's name and the part's hash.
@derive(Saved)
export type AnswerRecord = { answer: ContentHash, whole_reads: List<int>, part_reads: List<int>, packages: List<string> }

/// The words of a whole read.
const WHOLE_READ_WORDS: int = 4

/// The words of a part read.
const PART_READ_WORDS: int = 8

/// The record of an answer, what was read to get there, and the packages those reads read.
export fn answer_record(answer: ContentHash, reads: List<RecordedRead>, packages: List<string>) -> AnswerRecord {
    AnswerRecord {
        answer: answer,
        whole_reads: [word for read in reads.filter(it.part == null) for word in read.words()],
        part_reads: [word for read in reads.filter(it.part != null) for word in read.words()],
        packages: packages,
    }
}

impl AnswerRecord {
    fn kept() -> KeptRecord {
        KeptRecord {
            answer: self.answer,
            whole_reads: RecordWords.Held(self.whole_reads),
            part_reads: RecordWords.Held(self.part_reads),
            packages: RecordTexts.Held(self.packages),
        }
    }

    /// Whether two records say the same thing, so keeping both would add nothing.
    fn same_as(other: AnswerRecord) -> bool { self.kept().same_as(other) }
}

/// A record's words, held in memory or read where they lie, in the bytes beside them.
export enum RecordWords {
    Held(List<int>)
    Laid(source: SavedSource, words: SavedList)
}

impl RecordWords {
    fn length() -> int {
        match self { .Held(words) -> words.length, .Laid(_, words) -> words.length }
    }

    fn at(position: int) -> int {
        match self {
            .Held(words) -> words[position],
            .Laid(source, words) -> words.number_at(source, position),
        }
    }

    /// The hash whose words start at `position`.
    fn hash_at(position: int) -> ContentHash { ContentHash { high_word: self.at(position), low_word: self.at(position + 1) } }

    fn same_as(other: List<int>) -> bool { self.length() == other.length && (0..other.length).all((i) -> self.at(i) == other[i]) }

    /// Every word, held.
    fn words() -> List<int> {
        match self {
            .Held(words) -> words,
            .Laid(source, words) -> [words.number_at(source, i) for i in 0..words.length],
        }
    }
}

/// A record's package names, held in memory or read where they lie, in the bytes beside them.
export enum RecordTexts {
    Held(List<string>)
    Laid(source: SavedSource, texts: SavedList)
}

impl RecordTexts {
    /// Every name, held.
    fn texts() -> List<string> {
        match self {
            .Held(texts) -> texts,
            .Laid(source, texts) -> [t! for i in 0..texts.length for t in [texts.text_at(source, i)] if t != null],
        }
    }

    fn same_as(other: List<string>) -> bool {
        let held = self.texts()
        held.length == other.length && (0..other.length).all(held[it] == other[it])
    }
}

/// A record as the engine checks it, its reads never decoded.
export type KeptRecord = { answer: ContentHash, whole_reads: RecordWords, part_reads: RecordWords, packages: RecordTexts }

/// The record saved at `record` in `source`, read where it lies.
export fn kept_in_place(source: SavedSource, record: SavedRecord) -> KeptRecord {
    KeptRecord {
        answer: ContentHash.read_from(source, AnswerRecord.answer_in_place(source, record)),
        whole_reads: RecordWords.Laid(source, AnswerRecord.whole_reads_in_place(source, record)),
        part_reads: RecordWords.Laid(source, AnswerRecord.part_reads_in_place(source, record)),
        packages: RecordTexts.Laid(source, AnswerRecord.packages_in_place(source, record)),
    }
}

impl KeptRecord {
    fn same_as(other: AnswerRecord) -> bool {
        self.answer.same_as(other.answer) &&
            self.whole_reads.same_as(other.whole_reads) &&
            self.part_reads.same_as(other.part_reads) &&
            self.packages.same_as(other.packages)
    }

    /// The record, its words held.
    fn held() -> AnswerRecord {
        AnswerRecord {
            answer: self.answer,
            whole_reads: self.whole_reads.words(),
            part_reads: self.part_reads.words(),
            packages: self.packages.texts(),
        }
    }

    /// Whether every read holds, in the order kept: each whole read asked of its question and the
    /// answer it saw, then each part read of those, the part's name and the part's hash.
    fn every_read(
        whole: fn(ContentHash, ContentHash) -> bool,
        part: fn(ContentHash, ContentHash, ContentHash, ContentHash) -> bool,
    ) -> bool {
        (0..self.whole_read_count()).all((i) -> self.whole_read_holds(i, whole)) &&
            (0..self.part_read_count()).all((i) -> self.part_read_holds(i, part))
    }

    fn whole_read_count() -> int { self.whole_reads.length() / WHOLE_READ_WORDS }

    fn part_read_count() -> int { self.part_reads.length() / PART_READ_WORDS }

    /// The question whole read `i` asked.
    fn whole_read_question(i: int) -> ContentHash { self.whole_reads.hash_at(i * WHOLE_READ_WORDS) }

    /// The question part read `i` asked.
    fn part_read_question(i: int) -> ContentHash { self.part_reads.hash_at(i * PART_READ_WORDS) }

    /// The answer whole read `i` saw.
    fn whole_read_seen(i: int) -> ContentHash { self.whole_reads.hash_at(i * WHOLE_READ_WORDS + 2) }

    /// The name of the part part read `i` took.
    fn part_read_name(i: int) -> ContentHash { self.part_reads.hash_at(i * PART_READ_WORDS + 4) }

    /// The hash of the part part read `i` took.
    fn part_read_hash(i: int) -> ContentHash { self.part_reads.hash_at(i * PART_READ_WORDS + 6) }

    /// Whether whole read `i` holds: `whole` asked of its question and the answer it saw.
    fn whole_read_holds(i: int, whole: fn(ContentHash, ContentHash) -> bool) -> bool {
        whole(self.whole_read_question(i), self.whole_read_seen(i))
    }

    /// Whether part read `i` holds: `part` asked of its question, the answer it saw, the part's name
    /// and the part's hash.
    fn part_read_holds(i: int, part: fn(ContentHash, ContentHash, ContentHash, ContentHash) -> bool) -> bool {
        part(
            self.part_read_question(i),
            self.part_reads.hash_at(i * PART_READ_WORDS + 2),
            self.part_read_name(i),
            self.part_read_hash(i),
        )
    }

    /// The question of every read, whole reads first.
    fn read_questions() -> List<ContentHash> { hashes_in(self.read_question_words()) }

    /// The words of every read's question, whole reads first.
    fn read_question_words() -> List<int> {
        [self.whole_reads.at(i * WHOLE_READ_WORDS + k) for i in 0..self.whole_reads.length() / WHOLE_READ_WORDS for k in 0..HASH_WORDS]
            .concat(
                [self.part_reads.at(i * PART_READ_WORDS + k) for i in 0..self.part_reads.length() / PART_READ_WORDS for k in 0..HASH_WORDS],
            )
    }
}

impl RecordedRead {
    /// The words this read is kept as.
    fn words() -> List<int> {
        let seen = [
            self.question.high_word,
            self.question.low_word,
            self.whole_answer.high_word,
            self.whole_answer.low_word,
        ]
        let part? = self.part else { return seen }
        seen
            .concat(
                [
                    part.part_name.high_word,
                    part.part_name.low_word,
                    part.part_hash.high_word,
                    part.part_hash.low_word,
                ],
            )
    }

    /// What makes this read one read: its question, and its part if it looked at one. A reader
    /// that reads the same thing twice has one read.
    fn read_key() -> ContentHash {
        let part? = self.part else { return self.question }
        ContentHash {
            high_word: self.question.high_word.wrapping_shl(1) ^ part.part_name.high_word,
            low_word: self.question.low_word.wrapping_shl(1) ^ part.part_name.low_word,
        }
    }
}

/// What parts a binary's print from the program a frontier of it is scoped to.
const SCOPE_MARK: string = "~"

/// THE FRONTIER OF ONE PROGRAM OF A BINARY is known by the binary's print and a hash of the program,
/// so many programs share one store each with their own frontier, and the store keeps or evicts each
/// as its binary's.
export fn scoped_print(print: string, program: string) -> string {
    let h = content_hash("${print}\n${program}".bytes())
    "${print}${SCOPE_MARK}${word_name(h.high_word)}_${word_name(h.low_word)}"
}

/// The binary a frontier's print names, the program it's scoped to aside.
export fn binary_of(print: string) -> string { print.split(SCOPE_MARK)[0] }
