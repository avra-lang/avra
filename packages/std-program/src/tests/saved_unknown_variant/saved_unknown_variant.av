// Bytes holding a variant the type doesn't have trap, and never read back as another variant.
use @std.meta.{derive}
use saved_derive.{Saved}
use saved_layout.{saved_layout_writer}

@derive(Saved)
enum TwoVariants {
    First
    Second
}

let w = saved_layout_writer()
let root = w.write_record(5, [])
let answer = w.finished(root)
let read = TwoVariants.from_saved_bytes(answer)
println(match read { .First -> "first", .Second -> "second" })
