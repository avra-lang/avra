// What an answer read is said by its kept record: a later process that reads an answer the frontier
// stands on takes that answer's read set from the record, never by walking the frontier beneath it.
use tests.support.store_in_memory.{StoreInMemory, store_in_memory}
use answer_record.{question}
use query_engine.{QueryDefinition, QueryEngine, query_engine}

/// What `query_name` answers about `argument`, as text.
fn chained_text(engine: QueryEngine, query_name: string, argument: string) -> string {
    engine.answer_to(question(query_name, "code", argument.bytes())).copied().text() ?? ""
}

/// A query answering `step` of what `reads` answers.
fn chained(query_name: string, reads: string, step: fn(string) -> string) -> QueryDefinition {
    QueryDefinition {
        query_name: query_name,
        code_hash: "code",
        is_input: false,
        compute: (e, a) -> step(chained_text(e, reads, a.text() ?? "")).bytes(),
    }
}

/// `source` reads the world; `length` says its length, `doubled` that said twice, `tripled` that marked.
fn chain(world: Cell<string>) -> List<QueryDefinition> {
    [
        QueryDefinition {
            query_name: "source",
            code_hash: "code",
            is_input: true,
            compute: (_e, _a) -> world.get().bytes(),
        },
        chained("length", "source", (t) -> "${t.length}"),
        chained("doubled", "length", (t) -> t + t),
        chained("tripled", "doubled", (t) -> t + "!"),
    ]
}

/// A process over `store` asking `query_name` while the world says `text`, its frontier kept.
fn process_asking(store: StoreInMemory, text: string, query_name: string) -> QueryEngine {
    let engine = query_engine(store, chain(Cell.new(text)))
    let _ = chained_text(engine, query_name, "w")
    engine.frontier_kept()
    engine
}

spec "read sets — an answer's kept record says what it read" {
    given "a later process reading an answer the frontier stands on" {
        then "it works out only its own question, and walks no read set" {
            let store = store_in_memory()
            let _ = process_asking(store, "four", "doubled")
            let later = process_asking(store, "four", "tripled")
            chained_text(later, "tripled", "w") == "44!" &&
                later.worked_count() == 1 &&
                later.read_sets_walked_count() == 0
        }
    }
}
