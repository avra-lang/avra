// A record survives being saved, with the empty cases first, and hashes compare by what they hash.
use answer_record.{
    AnswerRecord,
    ContentHash,
    KeptRecord,
    PartSeen,
    Question,
    RecordedRead,
    answer_record,
    content_hash,
    hashes_in,
    kept_in_place,
    question,
    words_of,
}
use package_sets.{SET_UNWORKED, set_print}
use saved_layout.{saved_bytes_in_memory}

/// The record `bytes` saves, read where it lies.
fn kept_at(bytes: Bytes) -> KeptRecord {
    let at = saved_bytes_in_memory(bytes).root_at()
    kept_in_place(at.source, at.node)
}

fn hash_of(text: string) -> ContentHash { content_hash(text.bytes()) }

fn record_reading(reads: List<RecordedRead>) -> AnswerRecord {
    answer_record(hash_of("an int"), reads, SET_UNWORKED)
}

/// A whole read of the question `q`.
fn whole_of(q: string) -> RecordedRead { RecordedRead { question: hash_of(q), whole_answer: hash_of("seen"), part: null } }

/// A part read of the question `q`.
fn part_of(q: string) -> RecordedRead {
    RecordedRead {
        question: hash_of(q),
        whole_answer: hash_of("seen"),
        part: PartSeen { part_name: hash_of("name"), part_hash: hash_of("seen") },
    }
}

/// The questions `record`'s check asks, in the order it asks them, each read holding but those
/// whose question is one of `moved`.
fn asked_by(record: KeptRecord, moved: List<string>) -> List<int> {
    let asked: Cell<List<int>> = Cell.new([])
    let gone = [hash_of(m) for m in moved]
    let _ = record
        .every_read(
            (q, _seen) -> {
                asked.push(q.high_word)
                !gone.any(it.same_as(q))
            },
            (q, _seen, _name, _hash) -> {
                asked.push(q.high_word)
                !gone.any(it.same_as(q))
            },
        )
    asked.get()
}

/// The high words of the questions `qs`.
fn words_named(qs: List<string>) -> List<int> { [hash_of(q).high_word for q in qs] }

spec "answer_record — what's remembered about an answer" {
    given "hashes" {
        then "the same bytes hash alike and different bytes don't" {
            hash_of("one").same_as(hash_of("one")) && !hash_of("one").same_as(hash_of("two"))
        }
        then "empty bytes have a hash" { !hash_of("").same_as(hash_of("one")) }
        then "one hash comes before another, and not after it" {
            let first = ContentHash { high_word: 1, low_word: 9 }
            let second = ContentHash { high_word: 2, low_word: 0 }
            first.comes_before(second) && !second.comes_before(first)
        }
    }
    given "hashes as words" {
        then "none are no words" { words_of([]).is_empty() && hashes_in([]).is_empty() }
        then "each is its high word then its low, and reads back in order" {
            let hashes = [hash_of("a"), hash_of("b")]
            let words = words_of(hashes)
            words.length == 4 &&
                words[0] == hashes[0].high_word &&
                words[3] == hashes[1].low_word &&
                hashes_in(words)[1].same_as(hashes[1])
        }
    }
    given "a question" {
        then "a name and its arguments can't trade octets" {
            !question("ab", "code", "c".bytes())
                .known_as
                .same_as(question("a", "code", "bc".bytes()).known_as)
        }
        then "another code is another question" {
            !question("a", "one", "b".bytes())
                .known_as
                .same_as(question("a", "two", "b".bytes()).known_as)
        }
    }
    given "a question saved and read back" {
        then "its arguments survive, and an empty one is empty" {
            let empty = Question.from_saved_bytes(question("q", "code", "".bytes()).saved_bytes())
            let full = Question
                .from_saved_bytes(question("q", "code", "here".bytes()).saved_bytes())
            empty.arguments.length == 0 && full.arguments.text() == "here"
        }
    }
    given "two records" {
        then "the same answer and reads are the same record" {
            let read = RecordedRead {
                question: hash_of("a"),
                whole_answer: hash_of("b"),
                part: null,
            }
            record_reading([read]).same_as(record_reading([read])) &&
                record_reading([]).same_as(record_reading([]))
        }
        then "different reads of the same count aren't" {
            let one = RecordedRead {
                question: hash_of("a"),
                whole_answer: hash_of("b"),
                part: null,
            }
            let other = RecordedRead {
                question: hash_of("a"),
                whole_answer: hash_of("c"),
                part: null,
            }
            !record_reading([one]).same_as(record_reading([other]))
        }
        then "two whole reads aren't one part read of the same words" {
            let a = RecordedRead { question: hash_of("a"), whole_answer: hash_of("b"), part: null }
            let c = RecordedRead { question: hash_of("c"), whole_answer: hash_of("d"), part: null }
            let part = RecordedRead {
                question: hash_of("a"),
                whole_answer: hash_of("b"),
                part: PartSeen { part_name: hash_of("c"), part_hash: hash_of("d") },
            }
            !record_reading([a, c]).same_as(record_reading([part]))
        }
        then "the same reads that read other packages aren't" {
            let read = RecordedRead {
                question: hash_of("a"),
                whole_answer: hash_of("b"),
                part: null,
            }
            let std = answer_record(hash_of("an int"), [read], set_print(["@std/x"]))
            let own = answer_record(hash_of("an int"), [read], set_print(["proj"]))
            !std.kept().same_as(own) && std.kept().same_as(std)
        }
    }
    given "a read's key" {
        then "a part read is apart from its whole read and from another part" {
            let whole = RecordedRead {
                question: hash_of("a"),
                whole_answer: hash_of("b"),
                part: null,
            }
            let part_a = RecordedRead {
                question: hash_of("a"),
                whole_answer: hash_of("b"),
                part: PartSeen { part_name: hash_of("x"), part_hash: hash_of("y") },
            }
            let part_b = RecordedRead {
                question: hash_of("a"),
                whole_answer: hash_of("b"),
                part: PartSeen { part_name: hash_of("z"), part_hash: hash_of("y") },
            }
            !whole.read_key().same_as(part_a.read_key()) &&
                !part_a.read_key().same_as(part_b.read_key())
        }
    }
    given "a record's read set read where it lies" {
        then "a set nobody worked out reads back as nobody worked it out" {
            kept_at(record_reading([]).saved_bytes()).read_set == SET_UNWORKED
        }
        then "a set that read no package reads back as that, apart from one nobody worked out" {
            let kept = kept_at(answer_record(hash_of("an int"), [], set_print([])).saved_bytes())
            kept.read_set == set_print([]) && kept.read_set != SET_UNWORKED
        }
        then "a set of packages reads back as its print" {
            let kept = kept_at(
                answer_record(hash_of("an int"), [], set_print(["@std/x", "proj"])).saved_bytes(),
            )
            kept.read_set == set_print(["proj", "@std/x"])
        }
        then "a shared record reads back the names of its set beside its print" {
            let names = ["@std/x", "@std/y"]
            let kept = kept_at(
                answer_record(hash_of("an int"), [], set_print(names), names).saved_bytes(),
            )
            kept.packages.texts().join(",") == "@std/x,@std/y" && kept.read_set == set_print(names)
        }
        then "an own record reads back no names" {
            kept_at(answer_record(hash_of("an int"), [], set_print(["proj"])).saved_bytes())
                .packages
                .texts()
                .is_empty()
        }
        then "two records apart only in the names they carry are two records" {
            let names = ["@std/x"]
            let shared = answer_record(hash_of("an int"), [], set_print(names), names)
            let own = answer_record(hash_of("an int"), [], set_print(names))
            !shared.kept().same_as(own) && shared.kept().same_as(shared)
        }
    }
    given "a record whose whole and part reads were made interleaved" {
        then "its check asks them in the order they were made" {
            let record = record_reading(
                [part_of("p1"), whole_of("w1"), part_of("p2"), whole_of("w2")],
            )
            asked_by(record.kept(), []) == words_named(["p1", "w1", "p2", "w2"])
        }
        then "a part read that moved is the last read asked, and a whole read after it is never asked" {
            let record = record_reading([whole_of("w1"), part_of("p1"), whole_of("w2")])
            asked_by(record.kept(), ["p1"]) == words_named(["w1", "p1"])
        }
        then "read where it lies, it asks them in the same order" {
            let record = record_reading(
                [part_of("p1"), whole_of("w1"), whole_of("w2"), part_of("p2")],
            )
            asked_by(kept_at(record.saved_bytes()), ["w1"]) == words_named(["p1", "w1"])
        }
    }
    given "a record saved and read back" {
        then "with no reads it is whole" {
            let back = AnswerRecord.from_saved_bytes(record_reading([]).saved_bytes())
            back.whole_reads.is_empty() &&
                back.part_reads.is_empty() &&
                back.answer.same_as(hash_of("an int"))
        }
        then "a whole-answer read and a part read both survive" {
            let whole_read = RecordedRead {
                question: hash_of("sig a"),
                whole_answer: hash_of("one"),
                part: null,
            }
            let part_read = RecordedRead {
                question: hash_of("names m"),
                whole_answer: hash_of("table"),
                part: PartSeen { part_name: hash_of("helper"), part_hash: hash_of("absent") },
            }
            let back = AnswerRecord
                .from_saved_bytes(record_reading([whole_read, part_read]).saved_bytes())
            back.whole_reads.length == 4 &&
                back.part_reads.length == 8 &&
                back.part_reads[4] == hash_of("helper").high_word &&
                back.kept().read_questions()[1].same_as(hash_of("names m")) &&
                hashes_in(back.kept().read_question_words())[1].same_as(hash_of("names m"))
        }
        then "read where it lies, it says what it said" {
            let read = RecordedRead {
                question: hash_of("names m"),
                whole_answer: hash_of("table"),
                part: PartSeen { part_name: hash_of("helper"), part_hash: hash_of("absent") },
            }
            let empty = record_reading([])
            let full = record_reading([read])
            kept_at(empty.saved_bytes()).same_as(empty) &&
                kept_at(full.saved_bytes()).same_as(full) &&
                !kept_at(full.saved_bytes()).same_as(empty)
        }
    }
}
