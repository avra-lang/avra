// A text's content key is minted at one door, over both lanes; texts are one key only when they are
// one text, a split of a text is not the text, and a name is found by its text's key.
use interned.{text_key}
use names.{name_of}

/// Texts of every kind a key meets: empty, one byte, a word, one that crosses a fold's eight bytes,
/// one of more than one byte a character.
const TEXTS: List<string> = [
    "",
    "a",
    "packages/std-program/src/names.av",
    "abcdefghijklmnopq",
    "héllo wörld",
]

spec "a text's content key" {
    then "two texts are one key only when they are one text" {
        [(text_key(a) == text_key(b)) == (a == b) for a in TEXTS for b in TEXTS].all(it)
    }
    then "a split of one text is not the text" { text_key("ab") != text_key("a") && text_key("abc") != text_key("ab") }
    then "a name is found by its key: one id however often it arrives" {
        name_of("worn_by").id == name_of("worn" + "_by").id &&
            name_of("worn_by").id != name_of("worn").id
    }
}
