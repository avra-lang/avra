// Nodes writing themselves to a tape through the generated body, read back in the order the schema
// says: the variant, the flags, then each field, a node's children parents first. Then whole trees
// read back through the generated reader, which writes the same tape again.
use answer_record.{content_hash}
use syntax_tape.{TapePlace, TapeReader, TapeWriter, tape_reader, tape_writer}
use tape_schema.{TypeSchema}
use tests.support.tiny_tree.{TinyId, TinyNode, TinyTree, tiny_tree}
use tests.support.tiny_taped.{Taped}

fn id(index: int) -> TinyId { TinyId { index: index } }

fn leaf(number: int) -> TinyNode { .Leaf(number, "x", 1.5, true) }

/// The tape of a tree of `nodes`, written from its last node.
fn tape_of(nodes: List<TinyNode>) -> TapeWriter { written_from(tiny_tree(nodes)) }

fn written_from(tree: TinyTree) -> TapeWriter {
    mut tape = tape_writer()
    TinyNode.taped_id(tree, tape, id(tree.all().length - 1))
    tape
}

fn read_back(nodes: List<TinyNode>) -> TapeReader { tape_reader(tape_of(nodes).finished()) }

fn root() -> TypeSchema {
    mut found: Map<string, TypeSchema> = {}
    TinyNode.tape_types_into(found)
    found.values().find(it.type_path.ends_with(".TinyNode"))!
}

/// Whether the next node is the tiny tree's `variant`.
fn is_next(tape: TapeReader, variant: string) -> bool { tape.count() == root().variant_number(variant)! }

/// Whether the next node is `leaf(number)`, with no note after it.
fn is_leaf(tape: TapeReader, number: int) -> bool {
    is_next(tape, "Leaf") &&
        tape.flags(1)[0] &&
        tape.int() == number &&
        tape.text() == "x" &&
        tape.float() == 1.5 &&
        noteless(tape)
}

/// Whether a node just read has no note after it.
fn noteless(tape: TapeReader) -> bool { !tape.flag() }

fn means_the_same(a: List<TinyNode>, b: List<TinyNode>) -> bool {
    tape_of(a).finished().meaning_hash.same_as(tape_of(b).finished().meaning_hash)
}

/// The tree a tape reads back into: each node put in as it's read, the root last.
fn read_into_tree(nodes: List<TinyNode>) -> TinyTree {
    let tree = tiny_tree([])
    let _ = TinyNode.untaped_id(tree, read_back(nodes))
    tree
}

/// Whether the tree read back from a tape writes the same tape, every node where it was, with every
/// octet read.
fn round_trips(nodes: List<TinyNode>) -> bool {
    let tape = read_back(nodes)
    let tree = tiny_tree([])
    let _ = TinyNode.untaped_id(tree, tape)
    let first = tape_of(nodes).finished()
    let again = written_from(tree).finished()
    tape.is_done() &&
        again.meaning_hash.same_as(first.meaning_hash) &&
        content_hash(again.places.places).same_as(content_hash(first.places.places))
}

fn runs(plain_a: List<int>, plain_b: List<int>, nodes_a: List<TinyId>, nodes_b: List<TinyId>) -> List<
    TinyNode,
> {
    [leaf(1), .Runs(plain_a, plain_b, nodes_a, nodes_b)]
}

fn shapes(child_outcome: Result<TinyId, string>) -> List<TinyNode> {
    let named: Map<string, int> = {"t": 4}
    let child_named: Map<string, TinyId> = {"k": id(0)}
    [
        leaf(1),
        .Shapes(
            Cell.new(2),
            Cell.new(id(0)),
            named,
            child_named,
            .Ok(3),
            child_outcome,
            "hi".bytes(),
        ),
    ]
}

spec "a generated node" {
    given "a leaf" {
        then "its variant, its one flag, then its other fields in order, and nothing else" {
            let tape = read_back([leaf(7)])
            is_leaf(tape, 7) && tape.is_done()
        }
        then "it's placed where its id says" {
            let place = read_back([leaf(7)]).place()!
            place.offset == 0 && place.width == 1
        }
    }
    given "a pair of leaves" {
        then "each child follows its parent, in the order declared, each placed" {
            let tape = read_back([leaf(1), leaf(2), .Pair(id(0), id(1))])
            let offsets = ["${tape.place()!.offset}" for _node in 0..3].join(" ")
            is_next(tape, "Pair") &&
                is_leaf(tape, 1) &&
                is_leaf(tape, 2) &&
                noteless(tape) &&
                tape.is_done() &&
                offsets == "2 0 1"
        }
    }
    given "fields whose types are names over plain values" {
        then "they're read through the name, an absent one only flagged, each text numbered once" {
            let tape = read_back([leaf(1), .Labelled("a", null, ["b", "a"], id(0))])
            is_next(tape, "Labelled") &&
                !tape.flags(1)[0] &&
                tape.text() == "a" &&
                tape.count() == 2 &&
                tape.text() == "b" &&
                tape.text() == "a" &&
                is_leaf(tape, 1) &&
                noteless(tape) &&
                tape.is_done()
        }
    }
    given "a node with an absent child, a list, an enum and optional values" {
        then "presence leads as flags, and inside a list each says its own" {
            let tape = read_back([leaf(1), .Group(null, [id(0)], .Far(9), ["a", null], 5)])
            let is_group = is_next(tape, "Group")
            let flags = tape.flags(2)
            is_group &&
                !flags[0] &&
                flags[1] &&
                tape.count() == 1 &&
                is_leaf(tape, 1) &&
                tape.count() == 1 &&
                tape.int() == 9 &&
                tape.count() == 2 &&
                tape.flag() &&
                tape.text() == "a" &&
                !tape.flag() &&
                tape.int() == 5 &&
                noteless(tape) &&
                tape.is_done()
        }
    }
    given "an item moved between two runs" {
        then "plain values mean something else" { !means_the_same(runs([1], [], [], []), runs([], [1], [], [])) }
        then "nodes mean something else" { !means_the_same(runs([], [], [id(0)], []), runs([], [], [], [id(0)])) }
    }
    given "every other shape with bytes" {
        then "they're written and no bytes are missing" { tape_of(shapes(.Ok(id(0)))).holds_only_bytes() }
        then "each side of a result means something else" { !means_the_same(shapes(.Ok(id(0))), shapes(.Err("no"))) }
    }
    given "a value with no bytes" {
        then "the tape says so, and the fields around it are still written" {
            let written = tape_of([.Opaque((n) -> n, 8)])
            let tape = tape_reader(written.finished())
            !written.holds_only_bytes() &&
                is_next(tape, "Opaque") &&
                tape.int() == 8 &&
                noteless(tape) &&
                tape.is_done()
        }
    }
    given "a field a language keeps off the tape" {
        then "it leaves nothing" {
            let tape = read_back([.Marked(6, 7)])
            is_next(tape, "Marked") && tape.int() == 6 && noteless(tape) && tape.is_done()
        }
    }
    given "a tree read back from its tape" {
        then "a leaf's every field comes back" {
            match read_into_tree([leaf(7)]).node(0) {
                .Leaf(number, label, ratio, ready) -> number == 7 && label == "x" && ratio == 1.5 && ready,
                _ -> false,
            }
        }
        then "a pair writes the same tape again" { round_trips([leaf(1), leaf(2), .Pair(id(0), id(1))]) }
        then "names over plain values, an absent one, and a list of them" {
            round_trips([leaf(1), .Labelled("a", null, ["b", "a"], id(0))])
        }
        then "an absent child, a list, an enum with a payload and optional values" {
            round_trips([leaf(1), .Group(null, [id(0)], .Far(9), ["a", null], 5)])
        }
        then "a present child, empty lists and an enum without one" {
            round_trips([leaf(1), .Group(id(0), [], .Near, [], null)])
        }
        then "runs of values and of nodes" { round_trips(runs([1, 2], [3], [id(0)], [id(0)])) }
        then "cells, maps, each side of a result, and octets" {
            round_trips(shapes(.Ok(id(0)))) && round_trips(shapes(.Err("no")))
        }
        then "a node's note comes back beside it" {
            let tree = tiny_tree([leaf(1), .Pair(id(0), id(0))])
            tree.noted(0, "first")
            let back = tiny_tree([])
            let _ = TinyNode.untaped_id(back, tape_reader(written_from(tree).finished()))
            [back.note(i) ?? "-" for i in 0..back.all().length].join(" ") == "first first -"
        }
        then "a seat comes back where it was written" {
            let tree = tiny_tree([])
            let seat = tree.seat_at(TapePlace { offset: 40, width: 3 })
            let _ = tree.added(.Seated(5, seat), TapePlace { offset: 0, width: 1 })
            let back = tiny_tree([])
            let tape = tape_reader(written_from(tree).finished())
            let read = TinyNode.untaped_id(back, tape)
            let place = match back.node(read.index) {
                .Seated(kept, back_seat) -> if kept == 5 { back.seat_place(back_seat) } else { null },
                _ -> null,
            }
            tape.is_done() && place != null && place!.offset == 40 && place!.width == 3
        }
        then "a field kept off the tape comes back as its default" {
            match read_into_tree([.Marked(6, 7)]).node(0) {
                .Marked(kept, unwritten) -> kept == 6 && unwritten == 0,
                _ -> false,
            }
        }
    }
}
