// A tree in the shape a compiler's is: nodes in an arena, gathered into one enum, each writing itself
// to a tape through a derive that any language could write.
use @std.meta.{Named, derive}
use syntax_tape.{TapePlace, TapeReader, TapeWriter}
use value_shapes.{indexes}
use tape_schema.{FieldSchema, Holds, Lying, TypeSchema, VariantSchema, Wrapping}

/// An identity: every holder of a tree reads and adds to the one arena, each node beside where it
/// was written.
export type TinyTree = { nodes: Cell<List<TinyNode>>, places: Cell<List<TapePlace?>> }

/// A tree of `nodes`, each written one byte wide at its own index.
export fn tiny_tree(nodes: List<TinyNode>) -> TinyTree {
    TinyTree { nodes: Cell.new(nodes), places: Cell.new([written_at(at) for at, _node in nodes]) }
}

fn written_at(offset: int) -> TapePlace? { TapePlace { offset: offset, width: 1 } }

impl TinyTree {
    fn node(index: int) -> TinyNode { self.nodes.get()[index] }

    fn place(index: int) -> TapePlace? { self.places.get()[index] }

    fn all() -> List<TinyNode> { self.nodes.get() }

    fn all_places() -> List<TapePlace?> { self.places.get() }

    /// `node` put in the tree where it was written, and its id.
    fn added(node: TinyNode, place: TapePlace?) -> TinyId {
        self.nodes.push(node)
        self.places.push(place)
        TinyId { index: self.nodes.get().length - 1 }
    }
}

export fn tiny_node(_t: Named) {}

/// A node's number in its tree, which on a tape is the node itself, placed where it was written.
@indexes(TinyNode)
export type TinyId = { index: int }

@derive(TinyRoot)
export collect enum TinyNode = @tiny_node in package by it.name

@tiny_node
export type Leaf = { number: int, label: string, ratio: float, ready: bool }

export type Label = string

@tiny_node
export type Labelled = { name: Label, nickname: Label?, others: List<Label>, inner: TinyId }

@tiny_node
export type Pair = { left: TinyId, right: TinyId }

@tiny_node
export type Group = { first: TinyId?, rest: List<TinyId>, side: Side, tags: List<string?>, seen: int? }

/// Two runs of plain values and two of nodes, side by side, so an item can move between them.
@tiny_node
export type Runs = { plain_a: List<int>, plain_b: List<int>, nodes_a: List<TinyId>, nodes_b: List<TinyId> }

/// Every other shape with bytes, each as words and as a child.
@tiny_node
export type Shapes = {
    held: Cell<int>,
    held_child: Cell<TinyId>,
    named: Map<string, int>,
    child_named: Map<string, TinyId>,
    outcome: Result<int, string>,
    child_outcome: Result<TinyId, string>,
    octets: Bytes,
}

/// A value with no bytes, which is allowed on a node.
@tiny_node
export type Opaque = { act: fn(int) -> int = unchanged, after: int }

fn unchanged(n: int) -> int { n }

/// A field a language keeps off the tape.
@tiny_node
export type Marked = { kept: int, unwritten: int = 0 }

@derive(Taped)
export enum Side {
    Near
    Far(distance: int)
}
