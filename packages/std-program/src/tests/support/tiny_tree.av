// A tree in the shape a compiler's is: nodes in an arena, gathered into one enum, each writing itself
// to a tape through a derive that any language could write.
use @std.meta.{Named, derive}
use syntax_tape.{SyntaxTape, TapePlace, TapeReader, TapeWriter, tape_reader, tape_writer}
use value_shapes.{indexes, nested_tape, placed}
use tape_schema.{FieldSchema, Holds, Lying, TypeSchema, VariantSchema, Wrapping}

/// An identity: every holder of a tree reads and adds to the one arena, each node beside where it
/// was written and the note kept about it, and the seats minted where they were written.
export type TinyTree = {
    nodes: Cell<List<TinyNode>>,
    places: Cell<List<TapePlace?>>,
    notes: Cell<List<string?>>,
    seats: Cell<List<TapePlace?>>,
}

/// A tree of `nodes`, each written one byte wide at its own index, with no notes.
export fn tiny_tree(nodes: List<TinyNode>) -> TinyTree {
    TinyTree {
        nodes: Cell.new(nodes),
        places: Cell.new([written_at(at) for at, _node in nodes]),
        notes: Cell.new([no_note() for _node in nodes]),
        seats: Cell.new(no_seats()),
    }
}

fn no_note() -> string? { null }

fn no_seats() -> List<TapePlace?> { [] }

fn written_at(offset: int) -> TapePlace? { TapePlace { offset: offset, width: 1 } }

impl TinyTree {
    fn node(index: int) -> TinyNode { self.nodes.get()[index] }

    fn place(index: int) -> TapePlace? { self.places.get()[index] }

    fn all() -> List<TinyNode> { self.nodes.get() }

    fn all_places() -> List<TapePlace?> { self.places.get() }

    /// `node` put in the tree where it was written, and its id.
    fn added(node: TinyNode, place: TapePlace?) -> TinyId {
        self.nodes.push(node)
        self.places.push(place)
        self.notes.push(null)
        TinyId { index: self.nodes.get().length - 1 }
    }

    fn note(index: int) -> string? { self.notes.get()[index] }

    fn noted(index: int, note: string) { self.notes.set_at(index, note) }

    /// The note kept beside a node, after the node on its tape.
    fn taped_facts(mut tape: TapeWriter, id: TinyId) {
        let note = self.note(id.index)
        tape.flag(note != null)
        if note != null { tape.text(note!) }
    }

    fn untaped_facts(tape: TapeReader, id: TinyId) {
        if tape.flag() { self.noted(id.index, tape.text()) }
    }

    /// A seat minted where it was written.
    fn seat_at(place: TapePlace?) -> TinySeat {
        self.seats.push(place)
        TinySeat { index: self.seats.get().length - 1 }
    }

    fn seat_place(seat: TinySeat) -> TapePlace? { self.seats.get()[seat.index] }

    /// A box's own tree, on a tape of its own.
    fn box_taped(b: TinyBox) -> SyntaxTape {
        mut tape = tape_writer()
        TinyNode.taped_id(b.tree, tape, b.root)
        tape.finished()
    }

    /// A box read back into this tree.
    fn box_untaped(tape: SyntaxTape) -> TinyBox { TinyBox { tree: self, root: TinyNode.untaped_id(self, tape_reader(tape)) } }
}

/// A node of another tree, held whole, as a template holds its own statements.
@nested_tape("box_taped", "box_untaped")
export type TinyBox = { tree: TinyTree, root: TinyId }

/// A seat's identity, which its tree mints, so on a tape it's where it was written.
@placed("seat_at", "seat_place")
export type TinySeat = { index: int }

export fn tiny_node(_t: Named) {}

/// A node's number in its tree, which on a tape is the node itself, placed where it was written.
@indexes(TinyNode)
export type TinyId = { index: int }

@derive(TinyRoot)
export collect enum TinyNode = @tiny_node in package by it.name

@tiny_node
export type Leaf = { number: int, label: string, ratio: float, ready: bool }

export type Label = string

@tiny_node
export type Labelled = { name: Label, nickname: Label?, others: List<Label>, inner: TinyId }

@tiny_node
export type Pair = { left: TinyId, right: TinyId }

@tiny_node
export type Group = { first: TinyId?, rest: List<TinyId>, side: Side, tags: List<string?>, seen: int? }

/// Two runs of plain values and two of nodes, side by side, so an item can move between them.
@tiny_node
export type Runs = { plain_a: List<int>, plain_b: List<int>, nodes_a: List<TinyId>, nodes_b: List<TinyId> }

/// Every other shape with bytes, each as words and as a child.
@tiny_node
export type Shapes = {
    held: Cell<int>,
    held_child: Cell<TinyId>,
    named: Map<string, int>,
    child_named: Map<string, TinyId>,
    outcome: Result<int, string>,
    child_outcome: Result<TinyId, string>,
    octets: Bytes,
}

/// A node holding a seat.
@tiny_node
export type Seated = { kept: int, seat: TinySeat }

/// A node holding a box.
@tiny_node
export type Boxed = { kept: int, held: TinyBox }

/// Where in its file a node says something stands.
@tiny_node
export type Pinned = { @offset at: int, @offset also: List<int> }

/// A field a language keeps off the tape.
@tiny_node
export type Marked = { kept: int, unwritten: int = 0 }

@derive(Taped)
export enum Side {
    Near
    Far(distance: int)
}
