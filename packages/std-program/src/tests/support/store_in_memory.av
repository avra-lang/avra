//! A store in memory, standing in for the one on disk, shared by the engine's tests.
use answer_record.{AnswerRecord, ContentHash, KeptRecord, Question}
use frontier.{Frontier, FrontierEntry, frontier_in, frontier_runs}
use hash_keyed_table.{HashKeyedTable, hash_keyed_table}
use query_engine.{AnswerStore}
use saved_layout.{SavedBytes, SavedSource, saved_bytes_in_memory}

export type StoreInMemory = {
    records: HashKeyedTable<List<AnswerRecord>>,
    questions: HashKeyedTable<Question>,
    answers: HashKeyedTable<Bytes>,
    /// Each binary's frontier, by its print, as one run of octets.
    frontiers: Cell<Map<string, Bytes>>,
}

export fn store_in_memory() -> StoreInMemory {
    let records: HashKeyedTable<List<AnswerRecord>> = hash_keyed_table()
    let questions: HashKeyedTable<Question> = hash_keyed_table()
    let answers: HashKeyedTable<Bytes> = hash_keyed_table()
    let frontiers: Cell<Map<string, Bytes>> = Cell.new({})
    StoreInMemory { records: records, questions: questions, answers: answers, frontiers: frontiers }
}

impl AnswerStore for StoreInMemory {
    fn records_of(question: ContentHash) -> List<KeptRecord> { [record.kept() for record in self.records.get(question) ?? []] }

    fn keep_record(asked: Question, record: AnswerRecord) {
        self.questions.put(asked.known_as, asked)
        self.records.put(asked.known_as, (self.records.get(asked.known_as) ?? []).concat([record]))
    }

    fn question_known_as(question: ContentHash) -> Question? { self.questions.get(question) }

    fn answer_bytes(answer: ContentHash) -> SavedBytes? {
        let bytes? = self.answers.get(answer) else { return null }
        saved_bytes_in_memory(bytes)
    }

    fn keep_answer_bytes(answer: ContentHash, bytes: Bytes) { self.answers.put(answer, bytes) }

    fn hold_answer_bytes(answer: ContentHash, bytes: Bytes) { self.answers.put(answer, bytes) }

    fn frontier_of(print: string) -> Frontier? {
        let octets? = self.frontiers.get().get(print) else { return null }
        frontier_in(SavedSource.InMemory(octets), octets.length)
    }

    fn keep_frontier(print: string, entries: List<FrontierEntry>) { self.frontiers.put(print, frontier_runs(entries, 0).bytes()) }
}
