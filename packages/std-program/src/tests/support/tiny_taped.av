// The trait a language writes around the generated code: its own tree in its own signature, and how
// an id reaches it.
use @std.meta.{Code, Declared, Field, Type as MetaType, type_named}
use tape_derive.{TapeLanguage, TreeVerbs, root_declared, tape_marks, taped_declared}
use value_shapes.{FieldRole, Reading}

export trait Taped {
    static fn marks(_t: MetaType) -> List<string> { tape_marks() }

    static fn derive(t: MetaType) -> Declared { taped_declared(t, tiny_language()) }
}

/// A root of the tiny tree's tapes: its schema, and its nodes' writer and reader.
export trait TinyRoot {
    static fn marks(_t: MetaType) -> List<string> { tape_marks() }

    static fn derive(t: MetaType) -> Declared { root_declared(t, tiny_language()) }
}

fn tiny_language() -> TapeLanguage {
    TapeLanguage {
        tree: "TinyTree",
        reading: Reading { declared: type_named, role: role_of, places: true },
        verbs: TreeVerbs {
            node: (tree: Code, id: Code, _node: string) -> quote { ${tree}.node(${id}.index) },
            place: (tree: Code, id: Code, _node: string) -> quote { ${tree}.place(${id}.index) },
            added: (tree: Code, node: Code, place: Code, _node: string) -> quote { ${tree}.added(${node}, ${place}) },
            facts_written: (tree: Code, tape: Code, id: Code, _node: string) -> quote { ${tree}.taped_facts(${tape}, ${id}) },
            facts_read: (tree: Code, tape: Code, id: Code, _node: string) -> quote { ${tree}.untaped_facts(${tape}, ${id}) },
        },
    }
}

/// The tiny tree as declared, with `unwritten` kept off its tapes.
fn role_of(f: Field) -> FieldRole { if f.name == "unwritten" { .Carried } else { .Written } }
