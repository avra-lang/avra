// Attacks on a store that streams every question's records to its draft and compacts in place: a
// question kept twice in one process, its records spread over packs and the draft, two processes
// keeping the same records, a question answered many ways, a draft read before and after it's
// mapped, a store that can't write, a draft whose write fails mid-run, a pack of the format before,
// and a compaction of a store that has only a draft.
use @std.io.{IoError, exists, list_dir, write_bytes}
use @std.time.{stamp}
use answer_parts.{AnswerParts, NamedValue, answer_parts}
use answer_record.{ContentHash}
use disk_store.{DiskStore, KeptSpan, PACK_SEAL, disk_store_at, index_runs}
use pack_collection.{QuestionRecords}
use sorted.{sorted_by}
use query_engine.{QueryEngine, query_engine}
use saved_query.{ListedQuery, definitions_of, input, parted_query, query, query_definition}

once fn kept_world() -> Cell<Map<string, string>> {
    let world: Map<string, string> = {}
    Cell.new(world)
}

@input
fn kept_text(_engine: QueryEngine, path: string) -> string { kept_world().get().get(path) ?? "" }

@query
fn kept_length(engine: QueryEngine, path: string) -> int { kept_text(engine, path).length }

@query
fn kept_echo(_engine: QueryEngine, text: string) -> string { text }

@parted_query
fn kept_words(engine: QueryEngine, path: string) -> AnswerParts {
    answer_parts(
        [NamedValue { name: word, value: word.bytes() } for word in kept_text(engine, path).split(" ")],
    )
}

@query
fn kept_has(engine: QueryEngine, path: string, word: string) -> bool { kept_words_part(engine, path, word) != null }

collect kept_queries: List<ListedQuery> = @query_definition in self as ListedQuery { definition: it } by it.name

fn engine_on(store: DiskStore) -> QueryEngine { query_engine(store, definitions_of(kept_queries)) }

fn directory_named(label: string) -> string { "/tmp/avra-disk-store-attack/${stamp()}-${label}" }

/// What `kept_length` of `path` is known by.
fn length_question(path: string) -> ContentHash {
    kept_length_definition()
        .question_about(kept_length_arguments(engine_on(disk_store_at("/dev/null/none")), path))
        .known_as
}

/// A whole process asking the length of `path` with nobody asking: its query, its record, and the
/// frontier it leaves. Answers how many queries ran.
fn length_asked(directory: string, path: string) -> int {
    let store = disk_store_at(directory)
    let engine = engine_on(store)
    let _ = kept_length(engine, path)
    engine.frontier_kept()
    let _ = store.saved()
    engine.computed_count()
}

fn packs_in(directory: string) -> List<string> { (list_dir(directory) catch []).filter(it.ends_with(".pack")) }

/// The length each record a later process finds for `path` answered, in the order it finds them:
/// a pack's oldest first.
fn lengths_found(directory: string, path: string) -> List<int> {
    let store = disk_store_at(directory)
    [store.answer_bytes(r.answer)!.root().number_at(0) for r in store.records_of(length_question(path))]
}

fn spelled(lengths: List<int>) -> string { ["${n}" for n in lengths].join(",") }

/// A text of `n` octets.
fn octets(n: int, mark: string) -> string { [mark for _i in 0..n].join("") }

spec "a store's records, streamed and compacted" {
    given "a question kept twice in one process" {
        then "the pack holds both its records, each once, oldest first" {
            let directory = directory_named("twice")
            let store = disk_store_at(directory)
            kept_world().put("a.av", "alpha")
            let _ = kept_length(engine_on(store), "a.av")
            kept_world().put("a.av", "alpha beta")
            let _ = kept_length(engine_on(store), "a.av")
            let _ = store.saved()
            spelled(lengths_found(directory, "a.av")) == "5,10"
        }
    }
    given "a question's records in a pack and in the draft that absorbs it" {
        then "the new pack holds every record once, oldest first" {
            let directory = directory_named("spread")
            kept_world().put("b.av", "alpha")
            let _ = length_asked(directory, "b.av")
            kept_world().put("b.av", "alpha beta")
            let _ = length_asked(directory, "b.av")
            packs_in(directory).length == 1 && spelled(lengths_found(directory, "b.av")) == "5,10"
        }
    }
    given "two processes keeping the same records beside each other, one with more, then merged" {
        then "each record stands once" {
            let directory = directory_named("same")
            kept_world().put("c.av", "alpha")
            let one = disk_store_at(directory)
            let other = disk_store_at(directory)
            let _ = kept_length(engine_on(one), "c.av")
            let other_engine = engine_on(other)
            let _ = kept_length(other_engine, "c.av")
            let _ = kept_echo(other_engine, "and something of its own")
            let _ = one.saved_alone()
            let _ = other.saved_alone()
            let two = packs_in(directory).length
            let _ = disk_store_at(directory).merged()
            two == 2 &&
                packs_in(directory).length == 1 &&
                spelled(lengths_found(directory, "c.av")) == "5"
        }
    }
    given "a root answered more ways than a question keeps, then compacted" {
        then "its newest records stay, and the one it reruns from runs only its input" {
            let directory = directory_named("many_ways")
            for text in ["a", "bb", "ccc", "dddd", "eeeee"] {
                kept_world().put("d.av", text)
                let _ = length_asked(directory, "d.av")
            }
            let before = lengths_found(directory, "d.av")
            let _ = disk_store_at(directory).compacted()
            before.length == 5 &&
                spelled(lengths_found(directory, "d.av")) == "3,4,5" &&
                length_asked(directory, "d.av") == 1
        }
    }
    given "answers enough to map the draft again while a process runs" {
        then "everything it kept reads the same before and after, and a later process runs nothing" {
            let directory = directory_named("mapped")
            let texts = [octets(1048576, "${i}") for i in 0..5]
            let store = disk_store_at(directory)
            let engine = engine_on(store)
            let first = [kept_echo(engine, text).length for text in texts]
            let again = [kept_echo(engine, text).length for text in texts]
            let ran = engine.computed_count()
            let _ = store.saved()
            let later = engine_on(disk_store_at(directory))
            let read_later = [kept_echo(later, text).length for text in texts]
            first.all(it == 1048576) &&
                again.all(it == 1048576) &&
                ran == 5 &&
                read_later.all(it == 1048576) &&
                later.computed_count() == 0
        }
    }
    given "a store that can't write" {
        then "its process reuses what it learned, and publishing writes nothing" {
            let store = disk_store_at("/dev/null/store")
            let engine = engine_on(store)
            kept_world().put("e.av", "alpha")
            let first = kept_length(engine, "e.av")
            let again = kept_length(engine, "e.av")
            first == 5 &&
                again == 5 &&
                engine.computed_count() == 2 &&
                store.records_of(length_question("e.av")).length == 1 &&
                (store.saved() catch -1) == 0
        }
    }
    given "a draft whose write fails mid-run" {
        then "the draft is dropped, what it kept before and after still answers, nothing runs again, and only publishing is refused" {
            let directory = directory_named("spoiled")
            kept_world().put("s.av", "alpha")
            let store = disk_store_at(directory)
            let mapped = octets(3145728, "m")
            let first = kept_length(engine_on(store), "s.av")
            let _ = kept_echo(engine_on(store), mapped)
            store.writing()!.spoiled(IoError.Failed("${directory}/learned", 28))
            let after = kept_echo(engine_on(store), "kept after")
            let refused = (store.saved() catch -1) == -1
            let later = engine_on(store)
            first == 5 &&
                after == "kept after" &&
                refused &&
                kept_length(later, "s.av") == 5 &&
                kept_echo(later, "kept after") == "kept after" &&
                kept_echo(later, mapped).length == 3145728 &&
                later.computed_count() == 1 &&
                (list_dir(directory) catch []).is_empty()
        }
    }
    given "a pack of the format before beside one of today's" {
        then "it's read as nothing, and a compaction removes it" {
            let directory = directory_named("before")
            kept_world().put("f.av", "alpha")
            let _ = length_asked(directory, "f.av")
            let _ = write_bytes(
                "${directory}/old.pack",
                "an old pack's octets, then its seal: avrapak5".bytes(),
            )
            let reused = length_asked(directory, "f.av")
            let _ = disk_store_at(directory).compacted()
            reused == 1 && !exists("${directory}/old.pack") && length_asked(directory, "f.av") == 1
        }
    }
    given "garbage ending in a pack's seal" {
        then "it's read as nothing, the answer stands, and a compaction removes it" {
            let directory = directory_named("garbage_sealed")
            kept_world().put("h.av", "alpha")
            let _ = length_asked(directory, "h.av")
            let planted = "${directory}/planted.pack"
            let _ = write_bytes(planted, (["garbage " for _i in 0..8].join("") + PACK_SEAL).bytes())
            let reused = length_asked(directory, "h.av")
            let _ = disk_store_at(directory).compacted()
            reused == 1 && !exists(planted) && length_asked(directory, "h.av") == 1
        }
    }
    given "a pack whose index names octets past its end" {
        then "what it names is found elsewhere or worked out again, and a compaction drops the pack" {
            let directory = directory_named("span_past")
            kept_world().put("i.av", "alpha")
            let _ = length_asked(directory, "i.av")
            let answer = disk_store_at(directory).records_of(length_question("i.av"))[0].answer
            let spans = [KeptSpan { key: answer, at: 0, length: 1048576 }]
            let questions = [KeptSpan { key: length_question("i.av"), at: 8, length: 1073741824 }]
            let planted = "${directory}/planted.pack"
            let runs = ["sixteen octets..".bytes()]
                .concat(index_runs(questions, spans, 1, 0))
                .concat([PACK_SEAL.bytes()])
            let _ = write_bytes(planted, runs.bytes())
            let reused = length_asked(directory, "i.av")
            let _ = disk_store_at(directory).compacted()
            reused == 1 && !exists(planted) && length_asked(directory, "i.av") == 1
        }
        then "a later process over only that pack works the answer out" {
            let directory = directory_named("span_past_alone")
            kept_world().put("j.av", "alpha")
            let _ = length_asked(directory, "j.av")
            let answer = disk_store_at(directory).records_of(length_question("j.av"))[0].answer
            for name in packs_in(directory) { let _ = write_bytes("${directory}/${name}", "".bytes()) }
            let spans = [KeptSpan { key: answer, at: 0, length: 1048576 }]
            let questions = [KeptSpan { key: length_question("j.av"), at: 8, length: 1073741824 }]
            let runs = ["sixteen octets..".bytes()]
                .concat(index_runs(questions, spans, 1, 0))
                .concat([PACK_SEAL.bytes()])
            let _ = write_bytes("${directory}/planted.pack", runs.bytes())
            let store = disk_store_at(directory)
            store.records_of(length_question("j.av")).is_empty() &&
                store.answer_bytes(answer) == null &&
                length_asked(directory, "j.av") == 2
        }
    }
    given "a compaction by a process that has only a draft and the frontier it left" {
        then "what it learned is published, and a later process runs only its input" {
            let directory = directory_named("draft_only")
            kept_world().put("g.av", "alpha")
            let store = disk_store_at(directory)
            let engine = engine_on(store)
            let _ = kept_length(engine, "g.av")
            engine.frontier_kept()
            let _ = store.compacted()
            packs_in(directory).length == 1 && length_asked(directory, "g.av") == 1
        }
    }
}

spec "a draft spoiled, and a store compacted while its process runs" {
    given "a draft spoiled before it was ever mapped, then kept past a mapping's worth" {
        then "everything it kept still answers, nothing runs again, publishing is refused, and nothing is left" {
            let directory = directory_named("spoiled_unmapped")
            kept_world().put("k.av", "alpha")
            let store = disk_store_at(directory)
            let first = kept_length(engine_on(store), "k.av")
            store.writing()!.spoiled(IoError.Failed("${directory}/learned", 28))
            let texts = [octets(1048576, "${i}") for i in 0..3]
            let kept = [kept_echo(engine_on(store), text).length for text in texts]
            let refused = (store.saved() catch -1) == -1
            let later = engine_on(store)
            first == 5 &&
                kept.all(it == 1048576) &&
                refused &&
                kept_length(later, "k.av") == 5 &&
                [kept_echo(later, text).length for text in texts].all(it == 1048576) &&
                later.computed_count() == 1 &&
                (list_dir(directory) catch []).is_empty()
        }
    }
    given "a spoiled draft's process that kept its frontier" {
        then "publishing is refused twice, no frontier file is left, and a later process works it out" {
            let directory = directory_named("spoiled_frontier")
            kept_world().put("l.av", "alpha")
            let store = disk_store_at(directory)
            let engine = engine_on(store)
            let _ = kept_length(engine, "l.av")
            store.writing()!.spoiled(IoError.Failed("${directory}/learned", 28))
            engine.frontier_kept()
            let refused = (store.saved() catch -1) == -1 && (store.saved() catch -1) == -1
            refused &&
                (list_dir(directory) catch []).is_empty() &&
                length_asked(directory, "l.av") == 2
        }
    }
    given "a process that compacts, then learns more and publishes again" {
        then "a later process finds both without running either" {
            let directory = directory_named("compacted_then_more")
            kept_world().put("m1.av", "alpha")
            kept_world().put("m2.av", "alpha beta")
            let store = disk_store_at(directory)
            let engine = engine_on(store)
            let _ = kept_length(engine, "m1.av")
            engine.frontier_kept()
            let _ = store.compacted()
            let _ = kept_length(engine, "m2.av")
            engine.frontier_kept()
            let _ = store.saved()
            let later = engine_on(disk_store_at(directory))
            kept_length(later, "m1.av") == 5 &&
                kept_length(later, "m2.av") == 10 &&
                later.computed_count() == 2
        }
    }
    given "an answer reused from a pack its own process's compaction removes" {
        then "it still answers there, and from the compacted pack in a later process" {
            let directory = directory_named("reused_then_compacted")
            kept_world().put("n.av", "alpha")
            let _ = length_asked(directory, "n.av")
            let store = disk_store_at(directory)
            let engine = engine_on(store)
            let reused = kept_length(engine, "n.av")
            engine.frontier_kept()
            let before = packs_in(directory)
            let _ = store.compacted()
            let after = packs_in(directory)
            let again = kept_length(engine, "n.av")
            let fresh = kept_length(engine_on(store), "n.av")
            reused == 5 &&
                again == 5 &&
                fresh == 5 &&
                engine.computed_count() == 1 &&
                after.length == 1 &&
                !before.contains(after[0]) &&
                length_asked(directory, "n.av") == 1
        }
    }
}

/// Three processes over `p.av`: the first asks whether it holds `beta` while it reads `alpha`; the
/// second, once it reads `alpha beta`, works out its words alone; the third asks again. With
/// `damaged`, before the third, every pack is gone but one holding the first's record of the reader,
/// its answer, and what the input was asked as — so the words the second worked out, and what they
/// were asked as, are lost. Answers what the third found.
fn beta_found_after(label: string, damaged: bool) -> bool {
    let directory = directory_named(label)
    kept_world().put("p.av", "alpha")
    let one = disk_store_at(directory)
    let first = engine_on(one)
    let _ = kept_has(first, "p.av", "beta")
    first.frontier_kept()
    let _ = one.saved()
    let reader = kept_has_definition()
        .question_about(kept_has_arguments(first, "p.av", "beta"))
        .known_as
    let records = disk_store_at(directory).records_of(reader)
    let entries = [entry_of(directory, reader)]
    let answer = disk_store_at(directory).answer_bytes(records[0].answer)!.copied()
    kept_world().put("p.av", "alpha beta")
    let two = disk_store_at(directory)
    let second = engine_on(two)
    let _ = kept_words(second, "p.av")
    second.frontier_kept()
    let _ = two.saved()
    if damaged {
        let input = kept_text_definition()
            .question_about(kept_text_arguments(second, "p.av"))
            .known_as
        let kept = entries.concat([entry_of(directory, input)])
        for name in packs_in(directory) { let _ = write_bytes("${directory}/${name}", "".bytes()) }
        let questions = [
            KeptSpan { key: reader, at: answer.length, length: kept[0].length },
            KeptSpan { key: input, at: answer.length + kept[0].length, length: kept[1].length },
        ]
        let runs = [answer]
            .concat(kept)
            .concat(
                index_runs(
                    sorted_by(questions, (a, b) -> a.key.comes_before(b.key)),
                    [KeptSpan { key: records[0].answer, at: 0, length: answer.length }],
                    1,
                    0,
                ),
            )
            .concat([PACK_SEAL.bytes()])
        let _ = write_bytes("${directory}/planted.pack", runs.bytes())
    }
    kept_has(engine_on(disk_store_at(directory)), "p.av", "beta")
}

/// A question's records as a pack keeps them, read from the store at `directory`.
fn entry_of(directory: string, question: ContentHash) -> Bytes {
    let store = disk_store_at(directory)
    QuestionRecords {
        question: question,
        asked: store.question_known_as(question)!,
        records: [r.held() for r in store.records_of(question)],
        written_in: 1,
    }
        .saved_bytes()
}

spec "a part read held to an answer nobody can read" {
    given "a reader of a part, its answer since moved on in a process that never asked the reader" {
        then "a later process finds the part" { beta_found_after("part_moved", false) }
        then "it finds it too when the words' answer and what they were asked as are lost" {
            beta_found_after("part_unread", true)
        }
    }
}
