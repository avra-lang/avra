// A compaction keeps what the questions a frontier names reach: each question's newest records, and
// the answers and questions those records read.
use answer_record.{
    AnswerRecord,
    ContentHash,
    Question,
    RecordedRead,
    answer_record,
    content_hash,
    question,
}
use pack_collection.{Live, QuestionRecords, live_in, newest_records, records_in}
use saved_layout.{SavedRecord, saved_bytes_in_memory}

fn hash_of(text: string) -> ContentHash { content_hash(text.bytes()) }

fn asked(name: string, code: string, arguments: string) -> Question { question(name, code, arguments.bytes()) }

/// A record answering `answer` that read `reads`, each a whole read of what it saw then.
fn record(answer: string, reads: List<Question>, deep: bool) -> AnswerRecord {
    answer_record(
        hash_of(answer),
        [RecordedRead { question: r.known_as, whole_answer: hash_of("seen"), part: null } for r in reads],
        deep,
    )
}

fn entry(q: Question, records: List<AnswerRecord>, written_in: int) -> QuestionRecords {
    QuestionRecords { question: q.known_as, asked: q, records: records, written_in: written_in }
}

/// Each entry saved and read where it lies, as a store reads it.
fn laid(questions: List<QuestionRecords>) -> List<SavedRecord> { [saved_bytes_in_memory(q.saved_bytes()).root() for q in questions] }

/// What a compaction of `questions` keeps alive from the questions `seeds`.
fn live_of(seeds: List<Question>, questions: List<QuestionRecords>) -> Live {
    let entries = laid(questions)
    live_in(
        [s.known_as for s in seeds],
        (question) -> [r for at, e in entries if questions[at].question.same_as(question) for r in records_in(e)],
    )
}

fn kept(live: Live, q: Question) -> bool { live.questions.get(q.known_as) != null }

/// How many of the records of `q`, the entry at `at`, a compaction keeps.
fn records_kept(questions: List<QuestionRecords>, at: int) -> int { newest_records(records_in(laid(questions)[at])).length }

spec "pack_collection — what a compaction keeps" {
    given "nothing" {
        then "nothing is kept" { live_of([], []).questions.is_empty() }
    }
    given "a root and what it read" {
        then "both stay, with the answers they found, and a question nobody reads goes" {
            let leaf = asked("leaf", "c", "x")
            let root = asked("root", "c", "x")
            let stray = asked("stray", "c", "x")
            let questions = [
                entry(leaf, [record("leaf answer", [], false)], 1),
                entry(root, [record("root answer", [leaf], true)], 1),
                entry(stray, [record("stray answer", [], false)], 1),
            ]
            let live = live_of([root], questions)
            kept(live, root) &&
                kept(live, leaf) &&
                !kept(live, stray) &&
                live.answers.get(hash_of("leaf answer")) != null &&
                live.answers.get(hash_of("stray answer")) == null
        }
    }
    given "a question answered many ways" {
        then "only its newest three records stay, and what only an older one read goes" {
            let old_read = asked("old", "c", "x")
            let root = asked("root", "c", "x")
            let questions = [
                entry(old_read, [record("old answer", [], false)], 1),
                entry(
                    root,
                    [
                        record("r1", [old_read], true),
                        record("r2", [], true),
                        record("r3", [], true),
                        record("r4", [], true),
                    ],
                    4,
                ),
            ]
            let live = live_of([root], questions)
            records_kept(questions, 1) == 3 &&
                !kept(live, old_read) &&
                live.answers.get(hash_of("r1")) == null &&
                live.answers.get(hash_of("r4")) != null
        }
    }
    given "a root reused through an old shallow record, with deep records after it" {
        then "the shallow one stays, and what it read" {
            let leaf = asked("leaf", "c", "x")
            let root = asked("root", "c", "x")
            let questions = [
                entry(leaf, [record("leaf answer", [], false)], 1),
                entry(
                    root,
                    [
                        record("r0", [leaf], false),
                        record("r1", [], true),
                        record("r2", [], true),
                        record("r3", [], true),
                    ],
                    4,
                ),
            ]
            records_kept(questions, 1) == 4 && kept(live_of([root], questions), leaf)
        }
    }
}
