// A warm run's RE-CHECKS: an answer a later engine checks against a kept record and keeps is counted
// under its family's pass, beside the asks the engine worked out — what the pass ledger says of a warm
// run's verifying, apart from its work.
use tests.support.store_in_memory.{StoreInMemory, store_in_memory}
use answer_record.{question}
use pass.{Pass, every_pass}
use query_engine.{QueryDefinition, QueryEngine, query_engine}

fn ask_text(engine: QueryEngine, query_name: string, argument: string) -> string {
    engine.answer_to(question(query_name, "code", argument.bytes())).copied().text() ?? ""
}

/// `source` is an input; `is_long`, a resolve, reads it; `summary`, a law, reads `is_long`.
fn definitions(world: Cell<string>) -> List<QueryDefinition> {
    [
        QueryDefinition {
            query_name: "source",
            code_hash: "code",
            is_input: true,
            compute: (_e, _a) -> world.get().bytes(),
            pass: Pass.Tape,
        },
        QueryDefinition {
            query_name: "is_long",
            code_hash: "code",
            is_input: false,
            compute: (e, a) -> "${ask_text(e, "source", a.text() ?? "").length > 5}".bytes(),
            pass: Pass.Resolve,
        },
        QueryDefinition {
            query_name: "summary",
            code_hash: "code",
            is_input: false,
            compute: (e, a) -> "long: ${ask_text(e, "is_long", a.text() ?? "")}".bytes(),
            pass: Pass.Laws,
        },
    ]
}

/// Every pass's re-checks in `engine`, in `every_pass`' order.
fn rechecks(engine: QueryEngine) -> List<int> { [engine.rechecked_in(p) for p in every_pass()] }

spec "pass re-checks — what a warm run verifies and keeps, by pass" {
    given "a store a first engine filled, and nothing changed" {
        then "a later engine keeps each answer by its record, one re-check under each family's pass" {
            let store = store_in_memory()
            let world = Cell.new("unchanged text")
            let first = query_engine(store, definitions(world))
            let _ = ask_text(first, "summary", "a")
            let later = query_engine(store, definitions(world))
            let answer = ask_text(later, "summary", "a")
            answer == "long: true" &&
                later.rechecked_in(Pass.Laws) == 1 &&
                later.rechecked_in(Pass.Resolve) == 1 &&
                rechecks(later).fold(0, (n, k) -> n + k) == 2
        }
        then "the engine that worked them out re-checked none" {
            let first = query_engine(store_in_memory(), definitions(Cell.new("unchanged text")))
            let _ = ask_text(first, "summary", "a")
            rechecks(first).all(it == 0)
        }
    }
    given "the input changed under a kept answer" {
        then "the answer worked out again is no re-check of its pass" {
            let store = store_in_memory()
            let world = Cell.new("unchanged text")
            let _ = ask_text(query_engine(store, definitions(world)), "summary", "a")
            world.set("abc")
            let later = query_engine(store, definitions(world))
            ask_text(later, "summary", "a") == "long: false" &&
                later.rechecked_in(Pass.Resolve) == 0 &&
                later.rechecked_in(Pass.Laws) == 0
        }
    }
}
