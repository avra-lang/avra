// The window over no keys first, then zero, keys met out of order to both sides, and far apart.
use dense_window.{dense_window}

spec "dense_window — numbers by keys that sit close together" {
    given "an empty window" {
        then "nothing is found" {
            let window = dense_window()
            window.get(0) == null && window.get(-1) == null && window.get(7) == null
        }
    }
    given "a value of zero" {
        then "it is found, and its neighbours aren't" {
            let window = dense_window()
            window.put(5, 0)
            window.get(5) == 0 && window.get(4) == null && window.get(6) == null
        }
    }
    given "keys met below the first" {
        then "every one keeps its value" {
            let window = dense_window()
            window.put(10, 1)
            window.put(3, 2)
            window.put(9, 3)
            window.put(0, 4)
            window.get(10) == 1 &&
                window.get(3) == 2 &&
                window.get(9) == 3 &&
                window.get(0) == 4 &&
                window.get(1) == null
        }
    }
    given "keys met above the first, far apart" {
        then "every one keeps its value" {
            let window = dense_window()
            for key in 0..100 { window.put(key * 37, key) }
            (0..100).all((key) -> window.get(key * 37) == key) && window.get(36) == null
        }
    }
    given "a key put twice" {
        then "the later value stands" {
            let window = dense_window()
            window.put(2, 8)
            window.put(2, 9)
            window.get(2) == 9
        }
    }
}
