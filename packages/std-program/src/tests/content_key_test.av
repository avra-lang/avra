// A content key is minted at one door: a text's key is its bytes' key, nothing copied; the length
// tells keys of different lengths apart before a word is compared; a saved key reads back the same
// key; and a name is found by its text's key, one id however often it arrives.
use answer_record.{ContentKey}
use interned.{content_key, text_key}
use names.{name_of}

/// Texts of every kind a key meets: empty, one byte, a word, one that crosses a fold's eight bytes,
/// one of more than one byte a character.
const TEXTS: List<string> = [
    "",
    "a",
    "packages/std-program/src/names.av",
    "abcdefghijklmnopq",
    "héllo wörld",
]

spec "a content key" {
    then "a text's key is its bytes' key" { TEXTS.all((t: string) -> text_key(t).same_as(content_key(t.bytes()))) }
    then "its length is the bytes'" { TEXTS.all((t: string) -> text_key(t).length == t.bytes().length) }
    then "two texts are one key only when they are one text" {
        [text_key(a).same_as(text_key(b)) == (a == b) for a in TEXTS for b in TEXTS].all(it)
    }
    then "a split of one text is not the text" {
        !text_key("ab").same_as(text_key("a")) && !text_key("abc").same_as(text_key("ab"))
    }
    then "a key saved reads back the same key" {
        TEXTS
            .all(
                (t: string) -> ContentKey
                    .from_saved_bytes(text_key(t).saved_bytes())
                    .same_as(text_key(t)),
            )
    }
    then "a name is found by its key: one id however often it arrives" {
        name_of("worn_by").id == name_of("worn" + "_by").id &&
            name_of("worn_by").id != name_of("worn").id
    }
}
