// proves: a hasher's state the door does not admit traps — octets of the
// right length, every one 255, so the chunk's buffer claims more octets
// than it holds.
use @std.hash.{Hasher, hasher}

let made = hasher().state
let forged = Hasher { state: [255 for _i in 0..made.length].bytes()! }
let _digest = forged.digest()
"unreached"
