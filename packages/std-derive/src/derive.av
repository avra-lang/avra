//! `@std/derive` — traits that write their own `impl`.
//!
//!     use @std.meta.{derive}
//!     use @std.derive.{Show, Eq}
//!
//!     @derive(Show)
//!     @derive(Eq)
//!     type Point = { x: int, y: string }
//!
//! Each trait carries an ASSOCIATED `derive(t: Type) -> List<Directive>`:
//! the compiler runs it over the annotated type and admits the code it
//! answers beside it. The templates are quotes, so their own names
//! resolve in THIS file and a hole's (`${t}`, `${f}`) at the type's. A
//! trait's `derive` must stand in another file than the type —
//! expanding needs the type's file while its names are still being
//! made — which `@std/derive` satisfies.
use @std.meta.{Type, Variant, Directive, Code, joined, spliced, literal}

/// `@derive(Show)` gives a type `fn show() -> string` — a struct
/// interpolates its fields, an enum names its variant.
export trait Show {
    static fn derive(t: Type) -> List<Directive> {
        if !t.variants.is_empty() {
            let arms = [quote { .${v} -> ${literal("${t.name}.${v.name}")} } for v in t.variants]
            return [directive(t, quote { impl ${t} { fn show() -> string { match self { ${joined(arms, ", ")} } } } })]
        }
        let fields = ["${f.name}: \${self.${f.name}}" for f in t.fields]
        [directive(t, quote { impl ${t} { fn show() -> string { ${literal("${t.name} { ${fields.join(", ")} }")} } } })]
    }
}

/// `@derive(Eq)` gives a type `fn eq(other: T) -> bool` — every field
/// equal, or the same variant with equal payloads.
export trait Eq {
    static fn derive(t: Type) -> List<Directive> {
        if !t.variants.is_empty() {
            let arms = [eq_arm(v) for v in t.variants]
            return [directive(t, quote { impl ${t} { fn eq(other: ${t}) -> bool { match self { ${joined(arms, ", ")} } } } })]
        }
        let checks = [quote { self.${f} == other.${f} } for f in t.fields]
        [directive(t, quote { impl ${t} { fn eq(other: ${t}) -> bool { ${joined(checks, " && ")} } } })]
    }
}

/// A generated impl the compiler admits beside the type — the one
/// shape both traits answer.
fn directive(t: Type, code: Code) -> Directive {
    Directive { twin: "", name: t.name, at: t.at, source: code }
}

/// One enum arm of `eq`: the same variant, its payloads compared
/// position by position. The payload names are spliced text, so the
/// binder and its read wear one origin.
fn eq_arm(v: Variant) -> Code {
    if v.payload.is_empty() { return quote { .${v} -> match other { .${v} -> true, _ -> false } } }
    let ls = [spliced("l${i}") for i in 0..v.payload.length]
    let rs = [spliced("r${i}") for i in 0..v.payload.length]
    let same = joined([quote { ${ls[i]} == ${rs[i]} } for i in 0..v.payload.length], " && ")
    quote { .${v}(${joined(ls, ", ")}) -> match other { .${v}(${joined(rs, ", ")}) -> ${same}, _ -> false } }
}
