// The rows that wait for their due instant: what a take costs past them,
// the order they are handed out in once due, and a database an earlier
// build wrote before the store kept a line.
use @std.io.{list_dir}
use @std.queue.{HomeError, Order, Overflow, Parcel, Terms, key}
use @std.sqlite.{Db, sql}
use @std.time.{Time, hours, mins, ms}
use fault.{homed}
use queue_store.{Store, store_home_with}
use rows.{found_due}
use @std.queue.tests.support.laws.{terms}
use tests.support.wires.{int_wire}

const start: int = 1700000000000000000

/// Terms under `order` with room for every row a case writes.
fn roomy(order: Order) -> Terms {
    terms(60000, order) with { capacity: 100000, overflow: Overflow.fail }
}

/// The queue `jobs` of `db`, read on the clock `at` holds.
fn on_clock(db: Db, t: Terms, at: Cell<int>) -> Result<Store<int>, HomeError> {
    store_home_with<int>(db, "jobs", t, int_wire())? with { clock: () -> Time { ns: at.get() } }
}

fn fresh_on(t: Terms, at: Cell<int>) -> Result<Store<int>, HomeError> {
    on_clock(homed(Db.memory())?, t, at)
}

/// A count read straight from the database.
fn counted(db: Db, text: string) -> Result<int, HomeError> {
    homed((homed(db.scalar(sql(text)))?).int())
}

/// Whether no row holds a place in line while a reader holds it.
fn line_holds_no_lease(db: Db) -> Result<bool, HomeError> {
    counted(
        db,
        "SELECT count(*) FROM \"FlowItem\" WHERE \"in_line\" IS NOT NULL AND \"leased_until\" IS NOT NULL",
    )? == 0
}

/// The items one call hands out, in order, joined, each settled.
fn handed(q: Store<int>, max: int) -> Result<string, HomeError> {
    let out = q.taken(max)?
    let _ = q.ack_all(out)?
    ["${d.item}" for d in out].join(" ")
}

// ── What a take costs ──

/// How the rows ahead of a due item came to wait.
enum Waits { Sent, SentInTx, Released }

/// `n` rows that wait an hour, made as `how` says.
fn waiting_rows(q: Store<int>, n: int, how: Waits) -> Result<bool, HomeError> {
    match how {
        .Sent -> {
            for i in 0..n { let _ = q.send_after(i, key("k${i}"), hours(1))? }
        },
        .SentInTx -> {
            let _ = homed(q.db.begin())?
            for i in 0..n { let _ = q.send_after(i, key("k${i}"), hours(1))? }
            let _ = homed(q.db.commit())?
        },
        .Released -> {
            let _ = q.send_all([Parcel { item: i, key: key("k${i}") } for i in 0..n])?
            for d in q.taken(n)? { let _ = q.release(d, hours(1))? }
        },
    }
    true
}

/// The steps one take costs once a due item is sent behind `n` rows that
/// wait, and the item it handed out, or -2 for none.
fn take_past(n: int, order: Order, how: Waits) -> Result<List<int>, HomeError> {
    let at: Cell<int> = Cell.new(start)
    let q = fresh_on(roomy(order), at)?
    let _ = waiting_rows(q, n, how)?
    let _ = q.send(-1, key("due"))?
    let before = spent(q.db, 4, "")
    let d = q.take()?
    [spent(q.db, 4, "") - before, d?.item ?? -2]
}

/// Whether a take past 10 000 rows that wait costs what one past none
/// does, give or take a few steps, and hands out what it should.
fn take_cost_holds(order: Order, how: Waits, answer: int) -> Result<bool, HomeError> {
    let none = take_past(0, order, how)?
    let many = take_past(10000, order, how)?
    many[0] <= none[0] + 16 && none[1] == -1 && many[1] == answer
}

/// How SQLite plans putting the due rows in line, its steps joined.
fn due_plan() -> Result<string, HomeError> {
    let at: Cell<int> = Cell.new(start)
    let q = fresh_on(roomy(Order.fifo), at)?
    let steps = homed(q.db.all(sql("EXPLAIN QUERY PLAN " + found_due, [.Text("jobs"), .Int(0)])))?
    [homed(step.text(3))? for step in steps].join("; ")
}

// ── The order once due ──

fn ties_go_by_send() -> Result<string, HomeError> {
    let at: Cell<int> = Cell.new(start)
    let q = fresh_on(roomy(Order.by_key), at)?
    let _ = q.send_after(1, key("a"), ms(5))?
    let _ = q.send(2, key("b"))?
    let _ = q.send_after(3, key("c"), ms(5))?
    let _ = q.send_after(4, key("d"), ms(5))?
    let early = handed(q, 10)?
    at.set(start + ms(5).ns)
    "${early} | ${handed(q, 10)?}"
}

fn due_at_now() -> Result<bool, HomeError> {
    let at: Cell<int> = Cell.new(start)
    let q = fresh_on(roomy(Order.fifo), at)?
    let _ = q.send_after(1, key("a"), ms(5))?
    at.set(start + ms(5).ns - 1)
    let short = q.take()?
    at.set(start + ms(5).ns)
    short == null && (q.take()?)?.item == 1
}

fn released_now_keeps_its_place() -> Result<string, HomeError> {
    let at: Cell<int> = Cell.new(start)
    let q = fresh_on(roomy(Order.fifo), at)?
    let _ = q.send(1, key("a"))?
    let _ = q.send(2, key("b"))?
    let first? = q.take()? else { return "nothing" }
    let _ = q.release(first, ms(0))?
    let _ = q.send(3, key("c"))?
    let again? = q.take()? else { return "nothing again" }
    let _ = q.ack(again)?
    "${again.item} then ${handed(q, 1)?} line ${line_holds_no_lease(q.db)?}"
}

fn one_key_waits_another_does_not() -> Result<string, HomeError> {
    let at: Cell<int> = Cell.new(start)
    let q = fresh_on(roomy(Order.by_key), at)?
    let _ = q.send_after(1, key("a"), hours(1))?
    let _ = q.send(2, key("b"))?
    let _ = q.send(3, key("a"))?
    let now = handed(q, 10)?
    at.set(start + hours(1).ns)
    "${now} | ${handed(q, 10)?}"
}

fn lapsed_and_taken_again() -> Result<bool, HomeError> {
    let at: Cell<int> = Cell.new(start)
    let q = fresh_on(roomy(Order.by_key) with { lease: mins(1) }, at)?
    let _ = q.send(1, key("a"))?
    let first? = q.take()? else { return false }
    let live = q.take()?
    at.set(start + mins(1).ns)
    let again? = q.take()? else { return false }
    live == null &&
        again.id == first.id &&
        again.epoch == first.epoch + 1 &&
        !q.ack(first)? &&
        line_holds_no_lease(q.db)? &&
        q.ack(again)? &&
        q.depth()? == 0
}

/// A row put in line before the clock stepped back is not handed out
/// before its instant on the clock that stepped.
fn in_line_then_stepped_back() -> Result<bool, HomeError> {
    let at: Cell<int> = Cell.new(start)
    let q = fresh_on(roomy(Order.fifo) with { lease: hours(2) }, at)?
    let _ = q.send(1, key("a"))?
    let _ = q.send_after(2, key("b"), hours(1))?
    let held? = q.take()? else { return false }
    at.set(start + hours(1).ns)
    let blocked = q.take()?
    let lined = counted(q.db, "SELECT count(*) FROM \"FlowItem\" WHERE \"in_line\" IS NOT NULL")?
    let _ = q.ack(held)?
    at.set(start)
    let early = q.take()?
    at.set(start + hours(1).ns)
    blocked == null && lined == 1 && early == null && (q.take()?)?.item == 2
}

fn all_due_at_once() -> Result<bool, HomeError> {
    let at: Cell<int> = Cell.new(start)
    let q = fresh_on(roomy(Order.by_key), at)?
    let n = 10000
    for i in 0..n { let _ = q.send_after(i, key("k${i}"), ms(n - i))? }
    at.set(start + ms(n).ns)
    let out = q.taken(n)?
    out.length == n && [d for i, d in out if d.item != i].is_empty() && line_holds_no_lease(q.db)?
}

fn rolled_back_take_leaves_the_line() -> Result<bool, HomeError> {
    let at: Cell<int> = Cell.new(start)
    let q = fresh_on(roomy(Order.fifo), at)?
    let _ = q.send_after(1, key("a"), ms(5))?
    at.set(start + ms(5).ns)
    let _ = homed(q.db.begin())?
    let inside = q.take()?
    let _ = homed(q.db.rollback())?
    let waits = counted(
        q.db,
        "SELECT count(*) FROM \"FlowItem\" WHERE \"in_line\" IS NULL AND \"leased_until\" IS NULL",
    )?
    let after? = q.take()? else { return false }
    inside?.item == 1 &&
        waits == 1 &&
        after.item == 1 &&
        after.epoch == 1 &&
        line_holds_no_lease(q.db)?
}

fn rolled_back_send_leaves_nothing() -> Result<bool, HomeError> {
    let at: Cell<int> = Cell.new(start)
    let q = fresh_on(roomy(Order.fifo), at)?
    let _ = homed(q.db.begin())?
    let _ = q.send_after(1, key("a"), ms(5))?
    let _ = q.send(2, key("b"))?
    let _ = homed(q.db.rollback())?
    at.set(start + ms(5).ns)
    q.take()? == null && q.depth()? == 0 && counted(q.db, "SELECT count(*) FROM \"FlowItem\"")? == 0
}

/// A row leased by a build that leaves its place in line standing: its
/// live lease still holds it.
fn lease_beside_a_place_in_line() -> Result<bool, HomeError> {
    let at: Cell<int> = Cell.new(start)
    let q = fresh_on(roomy(Order.by_key), at)?
    let _ = q.send(1, key("a"))?
    let _ = homed(
        q
            .db
            .run(
                sql(
                    "UPDATE \"FlowItem\" SET \"leased_until\" = ?1, \"epoch\" = 1",
                    [.Int(start + hours(1).ns)],
                ),
            ),
    )?
    q.take()? == null
}

// ── A database an earlier build wrote ──

/// The item table as the build before the line made it, its shape in the
/// registry, and four rows: one a reader holds until a minute past
/// `start`, one sent to wait two days, one released to back off an hour,
/// and one due from its send.
fn earlier_build() -> List<string> {
    let first = "-9223372036854775808"
    [
        "CREATE TABLE IF NOT EXISTS \"__avra_models__\" (\"table_name\" TEXT PRIMARY KEY, \"declared_at\" TEXT, \"shape\" TEXT, \"owner\" TEXT)",
        "INSERT INTO \"__avra_models__\" VALUES ('FlowItem', '@std/queue_store/src/rows.av', 'FlowItem\n__avra_version__|INTEGER|notnull|-|-|1|-|-\nattempt|INTEGER|notnull|-|-|-|-|-\nbody|BLOB|notnull|-|-|-|-|-\nepoch|INTEGER|notnull|-|-|-|-|-\nid|INTEGER|null|key|-|-|-|-\nkey|TEXT|notnull|-|-|-|-|-\nleased_until|INTEGER|null|-|-|-|-|-\nqueue|TEXT|notnull|-|-|-|-|-\nreader|TEXT|null|-|-|-|-|-\nready_at|INTEGER|notnull|-|-|-|-|-\nsent_at|INTEGER|notnull|-|-|-|-|-\nshape|INTEGER|notnull|-|-|-|-|-\nindex(queue) absent(leased_until)\nindex(queue,leased_until) present(leased_until)', '@std.queue_store')",
        "CREATE TABLE IF NOT EXISTS \"FlowItem\" (\"__avra_version__\" INTEGER NOT NULL DEFAULT 1, \"attempt\" INTEGER NOT NULL, \"body\" BLOB NOT NULL, \"epoch\" INTEGER NOT NULL, \"id\" INTEGER PRIMARY KEY AUTOINCREMENT, \"key\" TEXT NOT NULL, \"leased_until\" INTEGER, \"queue\" TEXT NOT NULL, \"reader\" TEXT, \"ready_at\" INTEGER NOT NULL, \"sent_at\" INTEGER NOT NULL, \"shape\" INTEGER NOT NULL)",
        "CREATE INDEX \"FlowItem_index(queue) absent(leased_until)\" ON \"FlowItem\" (\"queue\") WHERE \"leased_until\" IS NULL",
        "CREATE INDEX \"FlowItem_index(queue,leased_until) present(leased_until)\" ON \"FlowItem\" (\"queue\", \"leased_until\") WHERE \"leased_until\" IS NOT NULL",
        "CREATE INDEX \"FlowItem_taken\" ON \"FlowItem\" (\"queue\", \"key\") WHERE \"epoch\" > 0",
        "INSERT INTO \"FlowItem\" (\"id\", \"queue\", \"key\", \"shape\", \"body\", \"sent_at\", \"ready_at\", \"attempt\", \"epoch\", \"reader\", \"leased_until\") VALUES (1, 'jobs', 'a', 1, x'02', ${start}, ${first}, 0, 1, '', ${start + mins(1).ns})",
        "INSERT INTO \"FlowItem\" (\"id\", \"queue\", \"key\", \"shape\", \"body\", \"sent_at\", \"ready_at\", \"attempt\", \"epoch\") VALUES (2, 'jobs', 'b', 1, x'04', ${start}, ${start + hours(48).ns}, 0, 0)",
        "INSERT INTO \"FlowItem\" (\"id\", \"queue\", \"key\", \"shape\", \"body\", \"sent_at\", \"ready_at\", \"attempt\", \"epoch\") VALUES (3, 'jobs', 'c', 1, x'06', ${start}, ${start + hours(1).ns}, 0, 1)",
        "INSERT INTO \"FlowItem\" (\"id\", \"queue\", \"key\", \"shape\", \"body\", \"sent_at\", \"ready_at\", \"attempt\", \"epoch\") VALUES (4, 'jobs', 'd', 1, x'08', ${start}, ${first}, 0, 0)",
    ]
}

/// `db` holding what the earlier build wrote.
fn written_earlier(db: Db) -> Result<Db, HomeError> {
    for text in earlier_build() { let _ = homed(db.run(sql(text)))? }
    db
}

/// The items an earlier build's database hands out as the clock passes
/// each row's instant, the item table's indexes, and its depth.
fn earlier_takes(db: Db) -> Result<string, HomeError> {
    let at: Cell<int> = Cell.new(start + ms(1).ns)
    let q = on_clock(written_earlier(db)?, roomy(Order.by_key), at)?
    let owed = q.depth()?
    let now = handed(q, 10)?
    at.set(start + mins(1).ns)
    let lapsed = handed(q, 10)?
    at.set(start + hours(1).ns)
    let backed = handed(q, 10)?
    at.set(start + hours(48).ns)
    let waited = handed(q, 10)?
    let indexes = homed(
        db
            .all(
                sql(
                    "SELECT \"name\" FROM \"sqlite_master\" WHERE \"type\" = 'index' AND \"tbl_name\" = 'FlowItem' ORDER BY \"name\"",
                ),
            ),
    )?
    let named = [homed(r.text(0))? for r in indexes].join(", ")
    "owed ${owed} | ${now} | ${lapsed} | ${backed} | ${waited} | ${named}"
}

const earlier_answer: string = "owed 4 | 4 | 1 | 3 | 2 | FlowItem_held, FlowItem_index(queue) present(in_line), FlowItem_index(queue,leased_until) present(leased_until), FlowItem_taken"

fn earlier_in_memory() -> Result<string, HomeError> {
    earlier_takes(homed(Db.memory())?)
}

fn earlier_in_a_file(path: string) -> Result<bool, HomeError> {
    let answer = earlier_takes(homed(Db.open(path))?)?
    let _ = on_clock(homed(Db.open(path))?, roomy(Order.by_key), Cell.new(start))?
    let dir = path.substring(0, path.length - "/queue.db".length)
    let copies = [n for n in list_dir(dir) catch [] if n.ends_with(".bak")]
    answer == earlier_answer && copies.length == 1
}

/// An earlier build's database first opened inside a transaction is
/// refused, and grows at its next open outside one.
fn earlier_opened_inside() -> Result<string, HomeError> {
    let db = written_earlier(homed(Db.memory())?)?
    let at: Cell<int> = Cell.new(start + ms(1).ns)
    let _ = homed(db.begin())?
    let inside = match on_clock(db, roomy(Order.by_key), at) {
        .Ok(_) -> "opened",
        .Err(.Refused(m)) -> m,
        .Err(_) -> "other",
    }
    let _ = homed(db.rollback())?
    let q = on_clock(db, roomy(Order.by_key), at)?
    "${inside} | ${handed(q, 10)?}"
}

/// A database a newer build grew by a column this build does not name,
/// opened again: it hands out what it holds and takes a send.
fn newer_build_grew() -> Result<string, HomeError> {
    let db = homed(Db.memory())?
    let at: Cell<int> = Cell.new(start)
    let first = on_clock(db, roomy(Order.fifo), at)?
    let _ = first.send(1, key("a"))?
    for text in [
        "ALTER TABLE \"FlowItem\" ADD COLUMN \"later\" INTEGER",
        "UPDATE \"__avra_models__\" SET \"shape\" = replace(\"shape\", 'leased_until|', 'later|INTEGER|null|-|-|-|-|-' || char(10) || 'leased_until|') WHERE \"table_name\" = 'FlowItem'",
    ] {
        let _ = homed(db.run(sql(text)))?
    }
    let again = on_clock(db, roomy(Order.fifo), at)?
    let _ = again.send(2, key("b"))?
    handed(again, 10)
}

spec "std/queue_store — the rows that wait for their instant" {
    given "what a take costs past 10 000 rows that wait" {
        then "sent with `after:`, under fifo, it costs what a take past none does" {
            take_cost_holds(Order.fifo, Waits.Sent, -1) catch false
        }
        then "sent with `after:`, under by_key, it costs what a take past none does" {
            take_cost_holds(Order.by_key, Waits.Sent, -1) catch false
        }
        then "sent with `after:` inside a transaction, under fifo, it costs what a take past none does" {
            take_cost_holds(Order.fifo, Waits.SentInTx, -1) catch false
        }
        then "sent with `after:` inside a transaction, under by_key, it costs what a take past none does" {
            take_cost_holds(Order.by_key, Waits.SentInTx, -1) catch false
        }
        then "released to back off, under fifo, the blocked take costs what a take past none does" {
            take_cost_holds(Order.fifo, Waits.Released, -2) catch false
        }
        then "released to back off, under by_key, it costs what a take past none does" {
            take_cost_holds(Order.by_key, Waits.Released, -1) catch false
        }
        then "the rows due by now are put in line from the index of the rows that wait" {
            (due_plan() catch "").contains("USING INDEX FlowItem_held (queue=? AND ready_at<?)")
        }
    }
    given "the order once due" {
        then "rows due at one instant are handed out by their send, after a plain send due before them" {
            (ties_go_by_send() catch "failed") == "2 | 1 3 4"
        }
        then "a row due exactly now is handed out, and not a nanosecond sooner" {
            due_at_now() catch false
        }
        then "a release with no backoff keeps its place under fifo, ahead of a later send" {
            (released_now_keeps_its_place() catch "failed") == "1 then 2 line true"
        }
        then "under by_key one key's waiting item holds nothing of another key's" {
            (one_key_waits_another_does_not() catch "failed") == "2 3 | 1"
        }
        then "a lease that ran out is taken again under a new epoch, holding no place in line" {
            lapsed_and_taken_again() catch false
        }
        then "a row put in line before the clock stepped back waits for its instant again" {
            in_line_then_stepped_back() catch false
        }
        then "10 000 rows due at once, each sooner than the one sent before it, are handed out by their send" {
            all_due_at_once() catch false
        }
        then "a take rolled back with its caller's transaction leaves the row waiting, and the next take hands it out" {
            rolled_back_take_leaves_the_line() catch false
        }
        then "a send rolled back leaves no row, in line or waiting" {
            rolled_back_send_leaves_nothing() catch false
        }
        then "a live lease holds a row whatever place in line it kept" {
            lease_beside_a_place_in_line() catch false
        }
    }
    given "a database an earlier build wrote" {
        then "it opens, owes its rows, and hands each out at its instant in order, its table grown" {
            (earlier_in_memory() catch "failed") == earlier_answer
        }
        then "in a file, it grows once and opens again unchanged" {
            scratched(earlier_in_a_file)
        }
        then "one a newer build grew by a column this build does not name opens and hands out its items" {
            (newer_build_grew() catch "failed") == "1"
        }
        then "first opened inside a transaction, it is refused, and grows at its next open" {
            (earlier_opened_inside() catch "failed") == "a home's tables are made outside a transaction, and this connection holds one — open the queue before the transaction begins | 4"
        }
    }
}
