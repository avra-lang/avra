// The store home, held to the laws every home keeps.
use @std.queue.{HomeError, Queue, Terms}
use @std.queue.tests.support.laws.{broken}
use @std.sqlite.{Db}
use fault.{homed}
use queue_store.{store_home}
use tests.support.wires.{int_wire}

fn stored(t: Terms) -> Result<Queue<int>, HomeError> {
    Queue {
        name: "jobs",
        terms: t,
        home: (store_home<int>(homed(Db.memory())?, "jobs", t, int_wire())?).home(),
    }
}

spec "std/queue_store — the home laws" {
    given "the store home" {
        then "keeps every law" {
            broken(stored).join("; ") == ""
        }
    }
}
