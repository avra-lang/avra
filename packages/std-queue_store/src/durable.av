//! The durable declaration: a queue that says `durable:` stands on the
//! store home of the program's database.
//!
//!     queue<Email> emails {
//!         name: "emails"
//!         durable: stored(email_wire())
//!         dedupe: mins(1440)
//!     }
//!
//! The database is the context `db`. It has no default, so a program
//! that reaches a durable queue on a path that never set it does not
//! build. The home is opened at the queue's first use, where the
//! context stands.
use @std.queue.{Durable, HomeError, Key, Lasting, Terms}
use @std.sqlite.{Db}
use @std.time.{Duration, Time, ms, now}
use queue_store.{Store, Sync, Wire, store_home}
use waiting.{listening}

/// The database every durable queue of the program stands on.
export ctx db: Db

/// A queue's `durable:`: the store home of `ctx.db`, its items crossing
/// by `wire`, its commits pressed as `sync` asks. `poll` is the longest
/// a waiting worker goes without asking the rows again, and `clock` the
/// instant leases and backoffs are measured against.
export fn stored<T>(
    wire: Wire<T>,
    sync: Sync = Sync.every_send,
    poll: Duration = ms(250),
    clock: fn() -> Time = now,
) -> Durable<T> {
    Durable {
        open: (name: string, terms: Terms, dedupe: Duration) -> opened(
            name,
            terms,
            dedupe,
            wire,
            sync,
            poll,
            clock,
        ),
    }
}

/// The queue `name` of `ctx.db`, opened under `terms`.
fn opened<T>(
    name: string,
    terms: Terms,
    dedupe: Duration,
    wire: Wire<T>,
    sync: Sync,
    poll: Duration,
    clock: fn() -> Time,
) -> Result<Lasting<T>, HomeError> {
    let store = store_home<T>(ctx.db, name, terms, wire, sync)? with { dedupe: dedupe, clock: clock }
    let heard = listening(store, poll)
    Lasting {
        home: heard.home(),
        send_as: (item: T, k: Key, id: string) -> heard.send_as(item, k, id),
    }
}
