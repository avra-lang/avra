//! @std.queue_store — the home that is a database. A queue's items are
//! rows in SQLite, so an item sent is an item kept: it survives the
//! process that sent it, and a second process over the same file takes
//! from the same queue.
//!
//!     let jobs = store_home<Job>(db, "jobs", terms, wire)?
//!     queue<Job> work { homed: jobs.home() }
//!
//! Every verb is one transaction, joined to the caller's when one is
//! open on the connection. A take leases a row: it raises the row's
//! `epoch` and sets `leased_until`, and every later verb of that
//! delivery names the epoch, so a hold that was redelivered settles
//! nothing. A lease that ran out is found by the next take.
//!
//! A row no item can be read from never holds its queue: the take that
//! meets it sets it aside (`unreadable`) and hands out the next.
//!
//! A delivery's `id` is its row's own behind its database's mark, minted
//! by the store: a home answers no delivery of another database. A send may
//! also carry a NAME (`send_as`): within the `dedupe` window a name is
//! one item, and every send of it answers the id the first was
//! answered. A send the terms turned away put nothing in the queue and
//! is not remembered: the name's next send is a fresh one.
use @std.queue.{
    Delivery,
    Home,
    HomeError,
    Key,
    Order,
    Overflow,
    Parcel,
    Terms,
    home_terms,
    key,
    letter_terms,
}
use @std.relation.stable.{CodecFault, Reader, Writer, decoded_with, encoded_with}
use @std.sqlite.{Db, Durability, Journal, OpenConfig, Sql, SqlValue, prepared, sql}
use @std.text.{parse_int}
use @std.time.{Duration, Time, mins, now}
use fault.{ask_again, homed}
use rows.{count_standing, read_mark, tables_made, take_next, waiting_index}
use unread.{Unread, Unreadable, aside, aside_count, forget_aside, set_aside}

/// How an item crosses to its row and back: the hash of its shape, a
/// description of that shape a reader of another build can follow, and
/// the item's stable octets each way. `decode` answers absent for
/// octets that are no item.
export type Wire<T> = {
    shape: int,
    descriptor: string,
    encode: fn(T) -> Bytes,
    decode: fn(Bytes) -> T?,
}

/// A wire over the stable byte codec: `write` puts an item's fields to
/// a writer in declared order, `read` takes them back.
export fn wire_of<T>(
    shape: int,
    descriptor: string,
    write: fn(Writer, T) -> void,
    read: fn(Reader) -> Result<T, CodecFault>,
) -> Wire<T> {
    Wire {
        shape: shape,
        descriptor: descriptor,
        encode: (item: T) -> encoded_with(item, write),
        decode: (octets: Bytes) -> match decoded_with(octets, read) { .Ok(item) -> item, .Err(_) -> null },
    }
}

/// One queue in a database. `mark` is the database's own, the head of
/// every id the home answers; `dedupe` is how long a named send is
/// remembered; `reader` is the name a take leaves on the rows it holds;
/// `clock` is the instant every lease and backoff is measured against,
/// the wall's unless another is given; `eases` says the verbs that file
/// no item commit without a sync of their own (`Sync.every_send` over a
/// write-ahead log). Held by copy: every copy is the same queue.
export type Store<T> = {
    db: Db,
    queue: string,
    terms: Terms,
    wire: Wire<T>,
    mark: string,
    dedupe: Duration = mins(1440),
    reader: string = "",
    clock: fn() -> Time = now,
    eases: bool = false,
}

/// How hard a commit is pressed to the disk before a verb answers.
///
/// `every_send` syncs the commit of every send: an answered send
/// outlives the process and the power. Over a write-ahead log the
/// verbs that file no item — a take, a start, an ack, a release — ride
/// the log to the next sync: a power cut may forget the last of them,
/// and the item is then handed out again, as at-least-once allows.
/// Over a rollback journal every commit is synced.
///
/// `on_checkpoint` syncs the write-ahead log only as it is folded into
/// the file: an answered send outlives the process, and a power cut
/// may lose the last ones. It asks a file kept in a write-ahead log.
export enum Sync { every_send, on_checkpoint }

/// The durability a home's connection rests at under `sync`. A
/// connection that already flushes its drive keeps doing so.
fn resting(db: Db, sync: Sync) -> Durability {
    match sync {
        .every_send -> if db.durability().flushes() { Durability.Flushed } else { Durability.Synced },
        .on_checkpoint -> Durability.Eased,
    }
}

/// An instant as a statement binds it: its nanoseconds, the integer its
/// column holds.
fn at(t: Time) -> SqlValue {
    .Int(t.ns)
}

/// The queue named `queue` in `db`, its tables made where they are
/// missing, its item shape recorded, and the connection set to commit
/// as `sync` asks. Terms that hold no item are refused. A home is
/// opened outside a transaction: what makes
/// it is never undone with a caller's work.
export fn store_home<T>(
    db: Db,
    queue: string,
    terms: Terms,
    wire: Wire<T>,
    sync: Sync = Sync.every_send,
) -> Result<Store<T>, HomeError> {
    if db.in_transaction() { return .Err(opened_inside()) }
    let _ = home_terms(terms)?
    let _ = homed(db.commit_as(resting(db, sync)))?
    let _ = homed(tables_made(db))?
    let _ = homed(db.run(sql(count_standing, [.Text(queue)])))?
    if terms.overflow == Overflow.latest { let _ = homed(db.run(sql(waiting_index)))? }
    let _ = homed(db.run(sql(know_shape, [.Int(wire.shape), .Text(wire.descriptor)])))?
    Store {
        db: db,
        queue: queue,
        terms: terms,
        wire: wire,
        mark: "${homed((homed(db.scalar(sql(read_mark)))?).text())?}-",
        eases: sync == Sync.every_send && homed(db.journal())? == "wal",
    }
}

/// A database file kept in a write-ahead log, where a commit is one
/// sync of the log: the file a store home is fastest on.
export fn open_logged(path: string) -> Result<Db, HomeError> {
    homed(Db.open_with(OpenConfig.config_at(path) with { journal: Journal.Wal }))
}

/// Move a delivery into a letter queue of the same database, as one
/// transaction: the item is in one queue or the other, never both and
/// never neither. `false` once the hold was lost, or when the letter's
/// terms turned the item away. A letter whose terms drop on overflow is
/// refused: a full `park` or `fail` letter leaves the item held here.
export fn bury_in<T, D>(from: Store<T>, d: Delivery<T>, letter: Store<D>, dead: D) -> Result<
    bool,
    HomeError,
> {
    let _ = letter_terms(letter.queue, letter.terms)?
    transacted(from.db, () -> moved(from, d, letter with { db: from.db, mark: from.mark }, dead))
}

fn moved<T, D>(from: Store<T>, d: Delivery<T>, letter: Store<D>, dead: D) -> Result<bool, HomeError> {
    if !from.reserved(d)? { return false }
    if letter.send(dead, d.key)? == null { return false }
    from.ack(d)
}

/// `work` as one transaction on `db`: kept when it answers, undone when
/// it fails. A transaction the caller already holds is joined and left
/// for the caller to end: the work is a savepoint inside it, so a
/// failure undoes the work alone and the caller may still commit. Its
/// two ends are statements the connection keeps, as every statement of
/// a home is.
fn transacted<V>(db: Db, work: fn() -> Result<V, HomeError>) -> Result<V, HomeError> {
    let opened = !db.in_transaction()
    let _ = homed(db.run(sql(if opened { begin } else { mark })))?
    errdefer undone(db, opened)
    let v = work()?
    let _ = homed(db.run(sql(if opened { commit } else { keep })))?
    v
}

/// Undo the work of a `transacted` that failed: the transaction it
/// opened, or its own savepoint in the caller's.
fn undone(db: Db, opened: bool) {
    if opened {
        let _ = db.finish()
        return
    }
    let _ = db.run(sql(back))
    let _ = db.run(sql(keep))
}

/// `work`, a verb that files no item, committed without a sync of its
/// own where the home `eases`: the durability is lowered for this one
/// commit and raised again before the verb answers. A transaction the
/// caller holds commits at the level the caller left.
fn eased<V>(db: Db, eases: bool, work: fn() -> Result<V, HomeError>) -> Result<V, HomeError> {
    if !eases || db.in_transaction() { return work() }
    let rested = db.durability()
    let _ = homed(db.commit_as(Durability.Eased))?
    defer { let _ = db.commit_as(rested) }
    work()
}

/// One row a take leased, as its columns.
type Leased = { id: int, key: string, body: Bytes, shape: int, attempt: int, epoch: int }

/// What the terms make of one more item: it is kept, it is discarded
/// behind an id of its own, or the send is turned away.
enum Room { Keep, Discard, Refuse }

impl Store<T> {
    /// These verbs as any home's.
    fn home() -> Home<T> {
        Home {
            send: (item: T, k: Key) -> self.send(item, k),
            send_all: (batch: List<Parcel<T>>) -> self.send_all(batch),
            take: (max: int) -> self.taken(max),
            began: (d: Delivery<T>) -> self.began(d),
            ack: (d: Delivery<T>) -> self.ack(d),
            ack_all: (held: List<Delivery<T>>) -> self.ack_all(held),
            release: (d: Delivery<T>, after: Duration) -> self.release(d, after),
            bury: (d: Delivery<T>, inter: fn(T) -> bool) -> self.bury(d, inter),
            depth: () -> self.depth(),
        }
    }

    /// Send one item under `k`, answering its id, or `null` when the
    /// terms turned it away.
    fn send(item: T, k: Key) -> Result<string?, HomeError> {
        self.sent(item, k, null)
    }

    /// Send one item by name: within the dedupe window a name is one
    /// item, and each send of it answers the id the first was answered.
    /// A send the terms turned away is not remembered: it answers
    /// `null`, and the next send of its name is a fresh one.
    fn send_as(item: T, k: Key, name: string) -> Result<string?, HomeError> {
        self.sent(item, k, name)
    }

    /// Send many items as one transaction, answering each as `send`
    /// would: every item is kept or turned away by the terms in its
    /// turn, and a failure keeps none.
    fn send_all(batch: List<Parcel<T>>) -> Result<List<string?>, HomeError> {
        let bodies = [(self.wire.encode)(p.item) for p in batch]
        transacted(self.db, () -> self.filed_all(batch, bodies))
    }

    /// Lease up to `max` due items, oldest first, as far as the order
    /// term allows.
    fn taken(max: int) -> Result<List<Delivery<T>>, HomeError> {
        eased(self.db, self.eases, () -> transacted(self.db, () -> self.leased(max)))
    }

    /// Lease the item due next, or `null` when none may be handed out.
    fn take() -> Result<Delivery<T>?, HomeError> {
        (self.taken(1)?).first()
    }

    /// Count a handler's start against the delivery's attempt. `false`
    /// once the hold was lost.
    fn began(d: Delivery<T>) -> Result<bool, HomeError> {
        eased(self.db, self.eases, () -> self.over_held(count_start, d, []))
    }

    /// Settle a delivery; its row is gone. `false` once the hold was
    /// lost.
    fn ack(d: Delivery<T>) -> Result<bool, HomeError> {
        eased(self.db, self.eases, () -> self.over_held(settle, d, []))
    }

    /// Settle many deliveries as one transaction, answering which held.
    fn ack_all(held: List<Delivery<T>>) -> Result<List<bool>, HomeError> {
        eased(self.db, self.eases, () -> transacted(self.db, () -> self.settled_all(held)))
    }

    /// Put a delivery back for another attempt, handed out no sooner
    /// than `after` from now. `false` once the hold was lost.
    fn release(d: Delivery<T>, after: Duration) -> Result<bool, HomeError> {
        eased(
            self.db,
            self.eases,
            () -> self.over_held(let_go, d, [at((self.clock)().plus(after))]),
        )
    }

    /// Move a delivery out through `inter`, which hands its item to the
    /// dead letter. `inter` runs outside any transaction of this home's:
    /// the hold is renewed for one lease, the letter is asked, and the
    /// row goes only once the letter took the item. A process that dies
    /// between the two leaves the item here, to be delivered again.
    /// `false` once the hold was lost, or when the letter refused.
    fn bury(d: Delivery<T>, inter: fn(T) -> bool) -> Result<bool, HomeError> {
        if !self.reserved(d)? || !inter(d.item) { return false }
        self.ack(d)
    }

    /// How many items the queue still owes a fate. A queue with no
    /// count is counted from its rows first.
    fn depth() -> Result<int, HomeError> {
        let owed? = self.owed()? else { return transacted(self.db, () -> self.owed_anew()) }
        owed
    }

    /// The items a take set aside because no item could be read from
    /// them, oldest first.
    fn unreadable() -> Result<List<Unreadable>, HomeError> {
        aside(self.db, self.queue, self.mark)
    }

    /// How many items a take set aside.
    fn unreadable_count() -> Result<int, HomeError> {
        aside_count(self.db, self.queue)
    }

    /// Forget the items a take set aside before `before`: their rows
    /// are deleted. Answers how many went.
    fn forget_unreadable(before: Time) -> Result<int, HomeError> {
        forget_aside(self.db, self.queue, before)
    }

    // ── Sending ──

    fn sent(item: T, k: Key, name: string?) -> Result<string?, HomeError> {
        let body = (self.wire.encode)(item)
        transacted(self.db, () -> self.filed(body, k, name))
    }

    fn filed_all(batch: List<Parcel<T>>, bodies: List<Bytes>) -> Result<List<string?>, HomeError> {
        [self.filed(bodies[i], p.key, null)? for i, p in batch]
    }

    fn settled_all(held: List<Delivery<T>>) -> Result<List<bool>, HomeError> {
        [self.over_held(settle, d, [])? for d in held]
    }

    /// The send itself, inside its transaction: a name already answered
    /// an id answers it again; else the terms judge the room and the
    /// row is written. Only a send answered an id is remembered.
    fn filed(body: Bytes, k: Key, name: string?) -> Result<string?, HomeError> {
        let now = (self.clock)()
        if name != null {
            let known = self.seen(name!, now)?
            if known != null { return .Ok(known) }
        }
        let id? = self.written(body, k, now)? else { return .Ok(null) }
        if name != null {
            let _ = homed(
                self
                    .db
                    .run(
                        sql(
                            note_seen,
                            [.Text(self.queue), .Text(name!), at(now), .Text(self.named(id))],
                        ),
                    ),
            )?
        }
        .Ok(self.named(id))
    }

    /// The id a send of this name was answered, when the window still
    /// holds it. Names past the window are forgotten first.
    fn seen(name: string, now: Time) -> Result<string?, HomeError> {
        let _ = homed(
            self.db.run(sql(forget_seen, [.Text(self.queue), .Int(now.ns - self.dedupe.ns)])),
        )?
        let row? = homed(self.db.first(sql(find_seen, [.Text(self.queue), .Text(name)])))? else {
            return .Ok(null)
        }
        .Ok(homed(row.text(0))?)
    }

    /// What the terms make of one more item under `k` once the queue
    /// is full. `latest` gives up the waiting item of `k`'s own, and the
    /// oldest only when the key has none.
    fn full(k: Key) -> Result<Room, HomeError> {
        match self.terms.overflow {
            .park -> .Err(HomeError.Unreachable(ask_again)),
            .fail -> Room.Refuse,
            .drop_newest -> Room.Discard,
            .drop_oldest -> self.dropped(sql(drop_oldest, [.Text(self.queue)])),
            .latest -> {
                if self.dropped(sql(drop_same, [.Text(self.queue), .Text(k.text)]))? == Room.Keep { return Room.Keep }
                self.dropped(sql(drop_oldest, [.Text(self.queue)]))
            },
        }
    }

    /// Give up the one waiting item `drop` names. There is room once
    /// one went.
    fn dropped(drop: Sql) -> Result<Room, HomeError> {
        if homed(self.db.run(drop))? == 1 { Room.Keep } else { Room.Refuse }
    }

    /// One row written where the terms allow it; answers its id, or
    /// absent when they turned the item away. A send into a queue with
    /// room is the one statement: the row is written only while fewer
    /// than `capacity` wait. A queue with no count has no room to
    /// read: it is counted from its rows and asked again.
    fn written(body: Bytes, k: Key, now: Time) -> Result<int?, HomeError> {
        let row: List<SqlValue> = [
            .Text(self.queue),
            .Text(k.text),
            .Int(self.wire.shape),
            .Blob(body),
            at(now),
        ]
        let roomy = sql(file_in_room, [..row, .Int(self.terms.capacity)])
        if homed(self.db.run(roomy))? == 1 || self.recounted()? && homed(self.db.run(roomy))? == 1 {
            return .Ok(self.db.last_insert_rowid())
        }
        let room = self.full(k)?
        if room == Room.Refuse { return .Ok(null) }
        let _ = homed(self.db.run(sql(file_item, row)))?
        let id = self.db.last_insert_rowid()
        if room == Room.Discard { let _ = homed(self.db.run(sql(drop_row, [.Int(id)])))? }
        .Ok(id)
    }

    // ── The counts ──

    /// The items owed a fate as the queue's count holds them, or absent
    /// when the queue has no count.
    fn owed() -> Result<int?, HomeError> {
        let row? = homed(self.db.first(sql(count_owed, [.Text(self.queue)])))? else { return .Ok(null) }
        .Ok(homed(row.int(0))?)
    }

    /// Count the queue from its rows where it has no count; whether it
    /// had none. One with the caller's transaction, so the count is the
    /// rows' own.
    fn recounted() -> Result<bool, HomeError> {
        homed(self.db.run(sql(count_standing, [.Text(self.queue)])))? == 1
    }

    /// The items owed a fate, counted from the rows.
    fn owed_anew() -> Result<int, HomeError> {
        let _ = self.recounted()?
        let owed? = self.owed()? else { return .Err(uncounted(self.queue)) }
        owed
    }

    // ── Taking ──

    /// The takes of one call, each at the call's one instant. An item
    /// is handed out once in a call, however soon its hold is over.
    fn leased(max: int) -> Result<List<Delivery<T>>, HomeError> {
        let now = (self.clock)()
        mut out: List<Delivery<T>> = []
        while out.length < max {
            let d? = self.next(now, if out.is_empty() { now } else { self.lapse_after(now) })? else {
                return out
            }
            out.push(d)
        }
        out
    }

    /// The instant a lease ended by for a call's later takes to hand
    /// it out again: now, or the instant before the holds the call
    /// gives end, where a hold is over the moment it is given.
    fn lapse_after(now: Time) -> Time {
        let ends = now.plus(self.terms.lease)
        if ends.ns > now.ns { now } else { Time { ns: ends.ns - 1 } }
    }

    /// Lease the oldest item that is due, that the order term lets stand
    /// and that an item can be read from. A row no item can be read from
    /// is set aside on the way. A lease is over once it ended by `lapse`.
    fn next(now: Time, lapse: Time) -> Result<Delivery<T>?, HomeError> {
        mut row = self.reached(now, lapse)?
        while row != null {
            match self.read(row!) {
                .Ok(item) -> {
                    return .Ok(
                        Delivery {
                            id: self.named(row!.id),
                            item: item,
                            key: key(row!.key),
                            attempt: row!.attempt,
                            epoch: row!.epoch,
                        },
                    )
                },
                .Err(why) -> { let _ = set_aside(self.db, row!.id, why, now)? },
            }
            row = self.reached(now, lapse)?
        }
        .Ok(null)
    }

    /// Lease the oldest row that is due and that the order term lets
    /// stand.
    fn reached(now: Time, lapse: Time) -> Result<Leased?, HomeError> {
        let s = homed(
            prepared(
                self.db,
                sql(
                    take_next,
                    [
                        .Text(self.reader),
                        at(now.plus(self.terms.lease)),
                        .Text(self.queue),
                        at(now),
                        .Int(whole_queue(self.terms.order)),
                        at(lapse),
                    ],
                ),
            ),
        )?
        defer s.reset()
        if !homed(s.step())? { return .Ok(null) }
        .Ok(
            Leased {
                id: homed(s.int_at(0))?,
                key: homed(s.text_at(1))?,
                body: homed(s.blob_at(2))?,
                shape: homed(s.int_at(3))?,
                attempt: homed(s.int_at(4))?,
                epoch: homed(s.int_at(5))?,
            },
        )
    }

    /// The item a leased row holds, or why none can be read from it.
    fn read(row: Leased) -> Result<T, Unread> {
        if row.shape != self.wire.shape { return .Err(Unread.Shape) }
        let item? = (self.wire.decode)(row.body) else { return .Err(Unread.Octets) }
        item
    }

    // ── The hold ──

    /// Renew a delivery's hold for one lease. `false` once it was lost.
    fn reserved(d: Delivery<T>) -> Result<bool, HomeError> {
        eased(
            self.db,
            self.eases,
            () -> self.over_held(hold_on, d, [at((self.clock)().plus(self.terms.lease))]),
        )
    }

    /// One statement over the row a delivery still holds; whether it
    /// changed one.
    fn over_held(text: string, d: Delivery<T>, more: List<SqlValue>) -> Result<bool, HomeError> {
        let row? = self.row_of(d.id) else { return false }
        homed(self.db.run(sql(text, [.Int(row), .Text(self.queue), .Int(d.epoch), ..more])))? == 1
    }

    // ── The ids ──

    /// The id this home answers the row `row` by.
    fn named(row: int) -> string {
        "${self.mark}${row}"
    }

    /// The row an id names, or absent for one this home never minted:
    /// another database's, or a row's number spelled any way but its
    /// own.
    fn row_of(id: string) -> int? {
        if !id.starts_with(self.mark) { return null }
        let digits = id.substring(self.mark.length, id.length)
        if digits.starts_with("0") { return null }
        parse_int(digits)
    }
}

/// Whether the order term holds the whole queue behind one standing
/// delivery, as the take statement reads it.
fn whole_queue(o: Order) -> int {
    match o { .fifo -> 1, .by_key -> 0 }
}

// ── The statements ──

const begin: string = "BEGIN IMMEDIATE"

const commit: string = "COMMIT"

const mark: string = "SAVEPOINT \"flow_step\""

const keep: string = "RELEASE \"flow_step\""

const back: string = "ROLLBACK TO \"flow_step\""

const know_shape: string = "INSERT OR IGNORE INTO \"FlowShape\" (\"hash\", \"descriptor\") VALUES (?1, ?2)"

const file_item: string = "INSERT INTO \"FlowItem\" (\"queue\", \"key\", \"shape\", \"body\", \"sent_at\", \"ready_at\", \"attempt\", \"epoch\") VALUES (?1, ?2, ?3, ?4, ?5, -9223372036854775807 - 1, 0, 0)"

/// The row is written only while fewer than `?6` items of its queue
/// wait, as its count says: a queue with no count takes no row. A sent
/// item is due from the first: `ready_at` is the least instant there is
/// and no sender's clock, so no reader whose clock runs behind passes
/// it by.
const file_in_room: string = "INSERT INTO \"FlowItem\" (\"queue\", \"key\", \"shape\", \"body\", \"sent_at\", \"ready_at\", \"attempt\", \"epoch\") SELECT ?1, ?2, ?3, ?4, ?5, -9223372036854775807 - 1, 0, 0 WHERE (SELECT \"waiting\" FROM \"FlowRoom\" WHERE \"queue\" = ?1) < ?6"

const drop_row: string = "DELETE FROM \"FlowItem\" WHERE \"id\" = ?1"

/// The oldest waiting item goes, read from the rows no reader holds.
const drop_oldest: string = "DELETE FROM \"FlowItem\" WHERE \"id\" = (SELECT \"id\" FROM \"FlowItem\" WHERE \"queue\" = ?1 AND \"leased_until\" IS NULL AND \"epoch\" = 0 ORDER BY \"id\" LIMIT 1)"

/// The oldest waiting item of the key `?2` goes.
const drop_same: string = "DELETE FROM \"FlowItem\" WHERE \"id\" = (SELECT \"id\" FROM \"FlowItem\" WHERE \"queue\" = ?1 AND \"key\" = ?2 AND \"epoch\" = 0 ORDER BY \"id\" LIMIT 1)"

const forget_seen: string = "DELETE FROM \"FlowSeen\" WHERE \"queue\" = ?1 AND \"at\" <= ?2"

const find_seen: string = "SELECT \"answer\" FROM \"FlowSeen\" WHERE \"queue\" = ?1 AND \"name\" = ?2"

const note_seen: string = "INSERT INTO \"FlowSeen\" (\"queue\", \"name\", \"at\", \"answer\") VALUES (?1, ?2, ?3, ?4)"

const count_owed: string = "SELECT \"owed\" FROM \"FlowRoom\" WHERE \"queue\" = ?1"

/// A row is HELD while its lease stands, expired or not, under the
/// epoch its delivery was handed: `?1` the row, `?2` the queue, `?3`
/// the epoch.
const held: string = " WHERE \"id\" = ?1 AND \"queue\" = ?2 AND \"epoch\" = ?3 AND \"leased_until\" IS NOT NULL"

const count_start: string = "UPDATE \"FlowItem\" SET \"attempt\" = \"attempt\" + 1" + held

const settle: string = "DELETE FROM \"FlowItem\"" + held

const let_go: string = "UPDATE \"FlowItem\" SET \"leased_until\" = NULL, \"reader\" = NULL, \"ready_at\" = ?4" +
    held

const hold_on: string = "UPDATE \"FlowItem\" SET \"leased_until\" = ?4" + held

// ── The voices ──

fn opened_inside() -> HomeError {
    HomeError.Refused("a home is opened outside a transaction, and this connection holds one")
}

fn uncounted(queue: string) -> HomeError {
    HomeError.Refused("a queue is counted before it is read, and `${queue}` has no count")
}
