//! A coded type's shape as DATA: what a reader of one build needs to
//! judge octets a writer of another build left.
//!
//!     let mine = descriptor_unspelled(Email.codec_descriptor())
//!     verdict(mine, theirs)
//!
//! A record's slots are its wire's fields in order; an enum's are its
//! variants. A record crosses by POSITION and an enum by its variant's
//! PLACE, so either may grow at its end and nowhere else.
use @std.text.{parse_int}

/// One slot: a record's field or an enum's variant. `ty` spells what
/// it carries, marks included; `defaulted` says a reader may fill it
/// where a writer left none.
export type ShapeSlot = { name: string, ty: string, defaulted: bool = false }

/// How a reached type crosses. `Record`: its slots in order. `Variants`:
/// a variant by place, then its payload. `Over`: the one shape its only
/// slot spells. `Dense`: an id as the scope spells it. `Coded`: its own
/// codec's header `hash`, then its slots — `scoped` says how its texts
/// cross. `Unsaid`: the descriptor names it and says nothing more, as an
/// earlier spelling did and as a type with no form here does.
export enum Form {
    Unsaid
    Record
    Variants
    Over
    Dense
    Coded(hash: int, scoped: bool, tagged: bool)
}

/// A named type a shape's slots reach: its declaration's fingerprint,
/// how it crosses, and its slots.
export type ShapeReach = { name: string, shape: int, form: Form = Form.Unsaid, slots: List<ShapeSlot> = [] }

/// A coded type's shape: its name, its fingerprint, the number of the
/// byte layout it is written in, whether it is an enum, whether its
/// texts cross through a scope, its slots in wire order, and every type
/// they reach. A slot names a reached type by the reach's name, and the
/// type itself by its own.
export type Descriptor = {
    hash: int,
    format: int,
    tagged: bool,
    slots: List<ShapeSlot>,
    reached: List<ShapeReach>,
    name: string = "",
    scoped: bool = false,
}

/// What a reader makes of a writer's shape. `Same`: decode. `Grew`:
/// the writer holds more trailing slots — decode the ones known.
/// `Fills`: the writer holds fewer, and a default fills each one
/// missing. `Moved`: no item of the reader's is read from it.
export enum Verdict { Same, Grew, Fills, Moved }

/// The reader's verdict on a writer's shape.
export fn verdict(reader: Descriptor, writer: Descriptor) -> Verdict {
    if reader.hash == writer.hash { return Verdict.Same }
    if reader.format != writer.format || reader.tagged != writer.tagged { return Verdict.Moved }
    let mine = reader.slots.length
    let theirs = writer.slots.length
    let common = if mine < theirs { mine } else { theirs }
    if !(0..common).all(alike(reader.slots[it], writer.slots[it])) || !reach_agrees(reader, writer) {
        return Verdict.Moved
    }
    if theirs > mine { return Verdict.Grew }
    if theirs < mine && (reader.tagged || reader.slots.drop(theirs).all(it.defaulted)) { return Verdict.Fills }
    Verdict.Moved
}

/// Whether two slots are one: the same name over the same spelling.
fn alike(a: ShapeSlot, b: ShapeSlot) -> bool { a.name == b.name && a.ty == b.ty }

/// Whether every reached type both shapes name is declared alike.
fn reach_agrees(reader: Descriptor, writer: Descriptor) -> bool {
    mut theirs: Map<string, int> = {}
    for r in writer.reached { theirs.set(r.name, r.shape) }
    reader.reached.all((r: ShapeReach) -> theirs.get(r.name) ?? r.shape == r.shape)
}

/// The head of every spelled descriptor: the spelling's own number.
const spelling: string = "avra.shape.2"

/// The head an earlier spelling wrote: no name, no scope, and each
/// reached type its name and fingerprint alone.
const first_spelling: string = "avra.shape.1"

impl Descriptor {
    /// The descriptor as text a column keeps: its parts in order, each
    /// run behind its count.
    fn spelled() -> string {
        let head = [
            spelling,
            part(self.name),
            "${self.hash}",
            "${self.format}",
            flag(self.tagged),
            flag(self.scoped),
        ]
        head
            .concat(slots_spelled(self.slots))
            .concat(["${self.reached.length}"])
            .concat([p for r in self.reached for p in reach_spelled(r)])
            .join("|")
    }
}

fn slots_spelled(slots: List<ShapeSlot>) -> List<string> {
    ["${slots.length}"]
        .concat([p for s in slots for p in [part(s.name), part(s.ty), flag(s.defaulted)]])
}

/// A reach's parts: its name, fingerprint and form word, a coded one's
/// header and marks, then its slots.
fn reach_spelled(r: ShapeReach) -> List<string> {
    let form = match r.form {
        .Unsaid -> ["u"],
        .Record -> ["r"],
        .Variants -> ["v"],
        .Over -> ["o"],
        .Dense -> ["d"],
        .Coded(hash, scoped, tagged) -> ["c", "${hash}", flag(scoped), flag(tagged)],
    }
    [part(r.name), "${r.shape}"].concat(form).concat(slots_spelled(r.slots))
}

/// The descriptor a text spells, or absent for any other text.
export fn descriptor_unspelled(text: string) -> Descriptor? {
    let c = Parts { all: text.split("|"), at: Cell.new(1) }
    let d? = spelled_under(c.all.first() ?? "", c) else { return null }
    if c.at.get() != c.all.length { return null }
    d
}

/// The descriptor the parts after `head` spell, by the spelling it names.
fn spelled_under(head: string, c: Parts) -> Descriptor? {
    when {
        head == spelling -> spelled_now(c)
        head == first_spelling -> spelled_first(c)
        _ -> null
    }
}

fn spelled_now(c: Parts) -> Descriptor? {
    let name? = c.text() else { return null }
    let hash? = c.int() else { return null }
    let format? = c.int() else { return null }
    let tagged? = c.flag() else { return null }
    let scoped? = c.flag() else { return null }
    let slots? = c.slots() else { return null }
    let n? = c.count(reach_width) else { return null }
    mut reached: List<ShapeReach> = []
    for _i in 0..n {
        let r? = c.reach() else { return null }
        reached.push(r)
    }
    Descriptor {
        hash: hash,
        format: format,
        tagged: tagged,
        slots: slots,
        reached: reached,
        name: name,
        scoped: scoped,
    }
}

fn spelled_first(c: Parts) -> Descriptor? {
    let hash? = c.int() else { return null }
    let format? = c.int() else { return null }
    let tagged? = c.flag() else { return null }
    let slots? = c.slots() else { return null }
    let n? = c.count(2) else { return null }
    mut reached: List<ShapeReach> = []
    for _i in 0..n {
        let name? = c.text() else { return null }
        let shape? = c.int() else { return null }
        reached.push(ShapeReach { name: name, shape: shape })
    }
    Descriptor { hash: hash, format: format, tagged: tagged, slots: slots, reached: reached }
}

/// The fewest parts a reach is spelled in: name, fingerprint, form, count.
const reach_width: int = 4

/// A spelling's parts, read in order from `at`.
type Parts = { all: List<string>, at: Cell<int> }

impl Parts {
    fn next() -> string? {
        let at = self.at.get()
        if at >= self.all.length { return null }
        self.at.set(at + 1)
        self.all[at]
    }

    fn text() -> string? {
        let s? = self.next() else { return null }
        unpart(s)
    }

    fn int() -> int? {
        let s? = self.next() else { return null }
        parse_int(s)
    }

    fn flag() -> bool? {
        let s? = self.next() else { return null }
        unflag(s)
    }

    /// A run's count, refused where the parts left could not hold that
    /// many items of `width` parts.
    fn count(width: int) -> int? {
        let n? = self.int() else { return null }
        if n < 0 || n > (self.all.length - self.at.get()) / width { return null }
        n
    }

    fn slots() -> List<ShapeSlot>? {
        let n? = self.count(3) else { return null }
        mut out: List<ShapeSlot> = []
        for _i in 0..n {
            let name? = self.text() else { return null }
            let ty? = self.text() else { return null }
            let defaulted? = self.flag() else { return null }
            out.push(ShapeSlot { name: name, ty: ty, defaulted: defaulted })
        }
        out
    }

    fn reach() -> ShapeReach? {
        let name? = self.text() else { return null }
        let shape? = self.int() else { return null }
        let form? = self.form() else { return null }
        let slots? = self.slots() else { return null }
        ShapeReach { name: name, shape: shape, form: form, slots: slots }
    }

    fn form() -> Form? {
        let word? = self.next() else { return null }
        match word {
            "u" -> Form.Unsaid,
            "r" -> Form.Record,
            "v" -> Form.Variants,
            "o" -> Form.Over,
            "d" -> Form.Dense,
            "c" -> {
                let hash? = self.int() else { return null }
                let scoped? = self.flag() else { return null }
                let tagged? = self.flag() else { return null }
                Form.Coded(hash, scoped, tagged)
            },
            _ -> null,
        }
    }
}

/// A text as one part: the separator and the escape's own mark spelled
/// out.
fn part(s: string) -> string { s.replace("%", "%25").replace("|", "%7C") }

fn unpart(s: string) -> string { s.replace("%7C", "|").replace("%25", "%") }

fn flag(v: bool) -> string { if v { "1" } else { "0" } }

fn unflag(s: string) -> bool? {
    match s { "1" -> true, "0" -> false, _ -> null }
}
