//! THE DB a relation's rows live under: an identity and the KERNEL its
//! cells are read and verified in.
//! Each relation keeps its typed rows in a store of its own, indexed by
//! the Db's id, so a Db never names a row type and a relation declared
//! in any package reaches its rows the same way. A CLOSED Db refuses
//! every reach: its rows are gone, and nothing opens them again.
//!
//! ROWS HAVE AN OWNER WHERE A WRITER NAMES ONE, and an owner's rows are
//! written as a VALUE: `Rel.replaced(db, owner, rows)` files every row as
//! the owner's and removes what the owner held and these rows do not
//! name — one step, so a keyed rerun upserts, a keyless one replaces its
//! whole set, and no reader meets half of it. Two owners never write one
//! row. A `@query` WRITES NO ROWS of its own: an insert inside its body
//! is refused.
//! A KERNEL'S INSTRUMENTS ARE ITS OWNER'S TO TURN ON: a fresh Db traces
//! nothing and writes no graph. `db.engine().trace_on()` traces each
//! ask and settle through the runtime's trace row (which prints under
//! `AVRA_QTRACE`), and `.graph_on()` writes every settled cell with the
//! keys it read to stderr — the compiler turns both on for its own
//! kernel from its environment; a program does it for its own.
//!
//! A DB THAT ASKED A QUERY LIVES UNTIL IT IS CLOSED: a `@query`'s and an
//! `@input`'s answers are kept, by the Db's id, where the query is
//! declared — so they hold the Db's kernel, and a query's way to be
//! asked again holds the Db. `close` lets both go. A Db that only ever
//! held rows is let go with its last holder.
//!
use rows.{Rows, named_rows, Stamp, INT_CAP}
use engine.{Kernel, Key, new_kernel, Relation, new_memo, Table, new_table, edge_of, list_cell}
use stable.{
    Writer,
    Reader,
    CodecFault,
    encoded_with,
    decoded_with,
    spelled_with,
    written_list,
    read_list,
}

extern fn avra_trap(message: string)

extern fn avra_qtrace(message: string)

/// A Db: its dense id, whether it is closed, each relation it has reached
/// (its hash, its close, its sweep), the KERNEL its cells live in — its
/// own, or one it was given — and how that kernel is told of a write;
/// who hears a refusal, and where answers outlive the process.
/// Then what a saved answer names its reads by: the relations reached
/// here, the queries and inputs asked here, and what each answered query
/// stands on (`leaves`). Then its owners: each one's dense cell and name
/// and how many times its rows were replaced, how many `@query` bodies
/// are running here, and how many writes it has taken. A Db given another kernel registers
/// every family it holds there again (`registrars`).
export type Db = {
    id: int,
    closed: Cell<bool>,
    /// What a reach after the close is refused with: the law its owner closed it under.
    closed_voice: Cell<string>,
    hashes: Cell<List<fn() -> int>>,
    closers: Cell<List<fn() -> void>>,
    kernel: Cell<Kernel?>,
    home: Cell<Home>,
    moves: Cell<Map<string, Cell<Map<string, int>>>>,
    row_families: Cell<List<int>>,
    hears: Cell<fn(string) -> void>,
    durable: Durable,
    relations: Cell<List<RelRef>>,
    answer_refs: Cell<List<AnswerRef>>,
    leaves: Cell<Map<string, Noted>>,
    watched: Cell<Map<string, int>>,
    reach: Cell<int>,
    registrars: Cell<List<fn(fn(fn(int) -> int) -> int) -> void>>,
    cells: Cell<Map<string, int>>,
    runs: Cell<List<int>>,
    names: Cell<List<string>>,
    /// Each open `@query` body, innermost last: whether its answer is kept.
    asking: Cell<List<bool>>,
    written: Cell<int>,
    /// Settled calls one query keeps under this Db before an epoch drops them; 0 keeps all.
    cap: Cell<int>,
}

/// Whose kernel a Db's cells live in, and so how a write is heard.
/// `Own`: the Db's own kernel — a cell is verified by its live hash, and a
/// write to a cell a query read is an input arriving: the revision moves
/// and every reader is verified again. `Given`: an owner's kernel — a cell
/// is verified by the revision a write stamped it with, and a write to a
/// cell read this revision is refused: a producer runs before its readers.
enum Home {
    Own
    Given
}

/// How a write lands on a cell: it stands, it is late — a settled reader
/// read the cell this revision — or it would tear a reader still running.
enum Landing {
    Stands
    Late
    Torn
}

/// The next replacement of `owner`'s rows: its count, moved on.
fn renewed(db: Db, owner: int) -> int {
    let run = db.runs.get()[owner] + 1
    db.runs.set_at(owner, run)
    run
}

/// One read a saved answer stands on, by a name that outlives the process: a relation by
/// the hash of its rows, an input by the hash of its value at its spelled arguments.
export enum Leaf {
    Rows(name: string, digest: int)
    Input(name: string, spelled: string, digest: int)
}

impl Leaf {
    /// The read's identity, apart from its digest.
    fn id() -> string {
        match self {
            .Rows(name, _) -> "r\t${name}",
            .Input(name, spelled, _) -> "i\t${name}\t${spelled}",
        }
    }

    /// The read's digest as a saved answer spells it.
    fn digest_text() -> string {
        match self { .Rows(_, digest) or .Input(_, _, digest) -> "${digest}" }
    }
}

/// `Leaf.id`'s inverse, with the digest it was read at; absent for a spelling `id` never writes.
export fn leaf_read(id: string, d: int) -> Leaf? {
    let parts = id.split("\t")
    if parts.length == 2 && parts[0] == "r" { return Leaf.Rows(parts[1], d) }
    if parts.length < 3 || parts[0] != "i" { return null }
    Leaf.Input(parts[1], parts.slice(2, parts.length).join("\t"), d)
}

/// What a settled query stands on: named, unnamed (something it read has no name), or owed —
/// named from its cell's reads the first time a reader asks, so a query no saved answer reads
/// never walks them.
enum Noted {
    Known(leaves: List<Leaf>)
    Unnamed
    Owed(key: Key)
}

/// A relation reached in a Db, by name: its family and its rows' hash, read live.
type RelRef = { name: string, family: fn() -> int, hash: fn() -> int }

impl RelRef {
    fn family_now() -> int {
        let f = self.family
        f()
    }

    fn hash_now() -> int {
        let h = self.hash
        h()
    }
}

/// A query or input asked in a Db, by its durable name: its family, each call's spelled
/// arguments and its value's hash, read live.
export type AnswerRef = {
    name: string,
    family: fn() -> int,
    spelled: fn(int) -> string?,
    arg: fn(string) -> int?,
    hash: fn(int) -> int?,
    /// Whether a reader of one of these answers stands on the answer itself, by its name and
    /// digest, rather than on what it read: a query's, whose key is a name another process reads.
    by_answer: bool = false,
}

impl AnswerRef {
    fn family_now() -> int {
        let f = self.family
        f()
    }

    fn spelled_at(arg: int) -> string? {
        let f = self.spelled
        f(arg)
    }

    fn arg_of(spelled: string) -> int? {
        let f = self.arg
        f(spelled)
    }

    fn hash_at(arg: int) -> int? {
        let f = self.hash
        f(arg)
    }
}

/// Queries open now, process-wide, and the reads some query made of rows it could not hear.
once fn open_queries() -> Cell<int> { Cell.new(0) }

once fn foreign_reads() -> Cell<int> { Cell.new(0) }

/// Where an owner keeps query answers past the process, by a query's
/// durable name and its arguments' stable hash: `answer` reads a kept
/// record back, `keep` hands one over. What key a record lives under,
/// and whether it still stands, is the owner's.
export type Durable = { answer: fn(string, int) -> Bytes?, keep: fn(string, int, Bytes) -> void }

/// An owner that keeps nothing past the process.
export fn transient() -> Durable {
    Durable {
        answer: (_query: string, _args: int) -> no_bytes(),
        keep: (_query: string, _args: int, _record: Bytes) -> no_word(),
    }
}

fn no_bytes() -> Bytes? { null }

fn no_word() {}

/// A refusal no owner hears ends the program, in its own words.
fn trapped(words: string) { avra_trap(words) }

/// The longest spelled query key a name can be: a path is bounded by PATH_MAX.
const KEY_BOUND = 4096

fn key_too_long(n: int) -> string {
    "a query's key is a name, not a text — this key is ${n} bytes, past the ${KEY_BOUND}-byte bound; read the text through an @input"
}

/// The next Db id this process mints.
once fn minted() -> Cell<int> { Cell.new(0) }

/// A fresh Db under the next dense id. Its kernel is its own, made when
/// a query is first asked of it — a Db that only holds rows has none —
/// and a write to a cell a query read is an input arriving.
export fn new_db() -> Db { made(transient()) }

/// `new_db`, its query answers kept past the process where `durable`
/// keeps them.
export fn durable_db(durable: Durable) -> Db { made(durable) }

fn made(durable: Durable) -> Db {
    let next = minted()
    let id = next.get()
    next.set(id + 1)
    let hashes: Cell<List<fn() -> int>> = Cell.new([])
    let closers: Cell<List<fn() -> void>> = Cell.new([])
    let moves: Cell<Map<string, Cell<Map<string, int>>>> = Cell.new({})
    let row_families: Cell<List<int>> = Cell.new([])
    let cells: Cell<Map<string, int>> = Cell.new({})
    let runs: Cell<List<int>> = Cell.new([0])
    let asking: Cell<List<bool>> = Cell.new([])
    let names: Cell<List<string>> = Cell.new([""])
    let registrars: Cell<List<fn(fn(fn(int) -> int) -> int) -> void>> = Cell.new([])
    let relations: Cell<List<RelRef>> = Cell.new([])
    let answer_refs: Cell<List<AnswerRef>> = Cell.new([])
    let leaves: Cell<Map<string, Noted>> = Cell.new({})
    let watched: Cell<Map<string, int>> = Cell.new({})
    let none: Kernel? = null
    Db {
        id: id,
        closed: Cell.new(false),
        closed_voice: Cell.new(closed_db(id)),
        hashes: hashes,
        closers: closers,
        kernel: Cell.new(none),
        home: Cell.new(Home.Own),
        moves: moves,
        row_families: row_families,
        hears: Cell.new(trapped),
        durable: durable,
        relations: relations,
        answer_refs: answer_refs,
        leaves: leaves,
        watched: watched,
        reach: Cell.new(0 - 1),
        registrars: registrars,
        cells: cells,
        runs: runs,
        names: names,
        asking: asking,
        cap: Cell.new(0),
        written: Cell.new(0),
    }
}

impl Db {
    /// This Db, keeping at most `n` settled calls per query before an epoch drops
    /// them. A Db made without it keeps every call, as before.
    fn with_cap(n: int) -> Db {
        self.cap.set(n)
        self
    }

    /// A relation reached here for the first time: its name, its family, its set hash
    /// and its close, each already bound to this Db.
    fn joined(name: string, family: fn() -> int, hash: fn() -> int, close: fn() -> void) {
        self.joined_unnamed(hash, close)
        self.relations.push(RelRef { name: name, family: family, hash: hash })
        self.reached(name)
        self.named_in(name, family())
    }

    /// A relation's declared name given to the kernel as its family's trace name, so a read
    /// of it is reported by name; none while the Db has no kernel (`homed` names them then).
    fn named_in(name: string, family: int) {
        let kernel? = self.kernel.get() else { return }
        kernel.named(family, name)
    }

    /// A column reached here that no saved answer can name: its hash and its close only.
    fn joined_unnamed(hash: fn() -> int, close: fn() -> void) {
        self.hashes.push(hash)
        self.closers.push(close)
    }

    /// Whether a read here is heard by no one: no query is open in the
    /// kernel, or there is no kernel yet.
    fn unheard() -> bool { self.reader_now() < 0 }

    /// The Db's kernel, made on the first reach when it has none: every
    /// family registered here so far is registered in it then. A program
    /// that traces a plain Db asks for it: `db.engine().trace_on()`.
    fn engine() -> Kernel {
        let held? = self.kernel.get() else {
            let made = new_kernel()
            self.homed(made)
            return made
        }
        held
    }

    /// A family registered in this Db's kernel when it has one, and again
    /// in any kernel it comes to have — `again` receives the register fn,
    /// so it never holds the Db itself. -1 while there is no kernel.
    fn registered(verify: fn(int) -> int, again: fn(fn(fn(int) -> int) -> int) -> void) -> int {
        self.registrars.push(again)
        let kernel? = self.kernel.get() else { return 0 - 1 }
        self.family(kernel, verify)
    }

    /// A family of `kernel` over `verify`, a cell's live hash: verified
    /// by that hash, or by the revision a write last stamped the cell with.
    fn family(kernel: Kernel, verify: fn(int) -> int) -> int {
        let family = match self.home.get() {
            .Own -> kernel.hashed_family(verify),
            .Given -> self.stamped_family(kernel),
        }
        self.row_families.push(family)
        family
    }

    /// A family of `kernel` verified by the revision a write last stamped
    /// each cell with.
    fn stamped_family(kernel: Kernel) -> int {
        let moved_at: Cell<Map<string, int>> = Cell.new({})
        let family = kernel.family()
        kernel.set_verify(family, (cell: int) -> moved_at.get().get("${cell}") ?? 0)
        self.moves.put("${family}", moved_at)
        family
    }

    /// The Db handed to an owner's kernel: every family registered here
    /// is registered there. Refused once a query has read here — what it
    /// read was told to the kernel being left.
    fn given_to(kernel: Kernel) {
        if self.read_ever() {
            self.refuse(given_after_read(self.id))
            return
        }
        self.home.set(Home.Given)
        self.homed(kernel)
    }

    /// `kernel` taken as this Db's, every family here registered in it.
    fn homed(kernel: Kernel) {
        self.forgotten()
        self.kernel.set(kernel)
        for again in self.registrars.get() { again((verify: fn(int) -> int) -> self.family(kernel, verify)) }
        for r in self.relations.get() { self.named_in(r.name, r.family()) }
    }

    /// Everything kept about the kernel being left: its families' ids and
    /// stamps, and the cell answers read back depend on — the next kernel
    /// numbers its own from the start. Each
    /// relation forgets its read marks as it registers again.
    fn forgotten() {
        let no_moves: Map<string, Cell<Map<string, int>>> = {}
        let no_rows: List<int> = []
        self.moves.set(no_moves)
        self.row_families.set(no_rows)
        let no_refs: List<AnswerRef> = []
        let no_leaves: Map<string, Noted> = {}
        let no_watch: Map<string, int> = {}
        self.answer_refs.set(no_refs)
        self.leaves.set(no_leaves)
        self.watched.set(no_watch)
        self.reach.set(0 - 1)
    }

    /// The Db let go by its owner — back to no kernel, its families in none.
    fn released() {
        let none: Kernel? = null
        self.forgotten()
        self.kernel.set(none)
        self.home.set(Home.Own)
        for again in self.registrars.get() { again((_verify: fn(int) -> int) -> 0 - 1) }
    }

    /// Who hears a refusal, in place of ending the program.
    fn heard_by(hears: fn(string) -> void) { self.hears.set(hears) }

    /// The open kernel query's token, -1 with none open.
    fn reader_now() -> int { self.kernel.get()?.reader() ?? 0 - 1 }

    /// One more write taken — a row filed or removed.
    fn counted() { self.written.set(self.written.get() + 1) }

    /// Whether a write with no owner named is refused: inside a
    /// `@query`'s body it is, spoken — anywhere else it is no one's.
    fn unowned_refused() -> bool {
        if self.asking.get().is_empty() { return false }
        self.refuse(query_writes())
        true
    }

    /// A write `owner` makes between two replacements of its rows.
    fn stamp_of(owner: int) -> Stamp { Stamp { owner: owner, run: self.runs.get()[owner] } }

    /// An owner named by its writer: its dense cell, never 0 — 0 is no one.
    fn owner_named(key: string) -> int {
        let known? = self.cells.get().get(key) else {
            let made = self.runs.get().length
            self.cells.put(key, made)
            self.runs.push(0)
            self.names.push(key)
            return made
        }
        known
    }

    /// A writer in words: a query by its key, or the driver.
    fn writer(edge: int) -> string {
        let kernel? = self.kernel.get() else { return "the driver" }
        if edge < 0 { "the driver" } else { "query ${kernel.edge_text(edge)}" }
    }

    /// Whose a row stamped `owner` is, in words.
    fn whose(owner: int) -> string { if owner == 0 { "no one's" } else { "`${self.names.get()[owner]}`'s" } }

    /// A `@query`'s body entered, and left: whether its answer is kept.
    fn entered() {
        self.asking.push(true)
        open_queries().set(open_queries().get() + 1)
    }

    fn left() -> bool {
        let open = self.asking.get()
        self.asking.set(open.slice(0, open.length - 1))
        open_queries().set(open_queries().get() - 1)
        open.last() ?? true
    }

    /// The running `@query` cannot finish its answer: it reaches the asker, and no cell holds
    /// it, so the next ask computes again.
    fn unkept() {
        let open = self.asking.get()
        if open.is_empty() { trapped(unkept_outside()) }
        self.asking.set_at(open.length - 1, false)
    }

    /// A read of this Db's rows that no open query hears: some query is open elsewhere,
    /// so that query stands on rows its record can never name.
    fn foreign_read() {
        if open_queries().get() > 0 && self.asking.get().is_empty() {
            foreign_reads().set(foreign_reads().get() + 1)
        }
    }

    /// How a write would land on `cell` of `family`, last read at
    /// revision `read_at` (-1 never) by `reader` — asked, nothing moved. A
    /// cell read this revision that a query still running holds is never
    /// moved; one only settled readers hold refuses the write where late
    /// writes are refused.
    fn landing(family: int, cell: int, read_at: int, reader: int) -> Landing {
        let kernel? = self.kernel.get() else { return Landing.Stands }
        if read_at != kernel.revision() { return Landing.Stands }
        if kernel.open_reader_of(family, cell, reader) >= 0 { return Landing.Torn }
        match self.home.get() { .Given -> Landing.Late, .Own -> Landing.Stands }
    }

    /// The query still running that holds `cell` of `family`, -1 for none.
    fn running(family: int, cell: int, last: int) -> int {
        self.kernel.get()?.open_reader_of(family, cell, last) ?? 0 - 1
    }

    /// A write that lands moves `cell`, last read at `read_at`: where late
    /// writes are taken, a cell any reader ever read moves the revision.
    fn moved(family: int, cell: int, read_at: int) {
        let kernel? = self.kernel.get() else { return }
        if read_at >= 0 && self.takes_late() { kernel.bump() }
        self.stamped(family, cell, kernel.revision())
    }

    /// Whether a late write here is an input arriving.
    fn takes_late() -> bool {
        match self.home.get() { .Given -> false, .Own -> true }
    }

    /// A relation first reached here: the answers read back while it was unreached are told.
    fn reached(name: string) {
        let cell? = self.watched.get().get(name) else { return }
        self.engine().set_input(self.reach_key(cell), 1)
    }

    fn reach_key(cell: int) -> Key { Key { family: self.reach.get(), arg: cell } }

    /// An answer read back stands on a relation not yet reached here: it is told when
    /// the relation is.
    fn watch_reach(name: string) {
        let kernel = self.engine()
        if self.reach.get() < 0 { self.reach.set(kernel.input_family()) }
        let known = self.watched.get().get(name)
        let cell = known ?? self.watched.get().length
        if known == null {
            self.watched.put(name, cell)
            kernel.set_input(self.reach_key(cell), 0)
        }
        kernel.record_at(self.reach.get(), cell)
    }

    /// What a query that read `deps` stands on, by names that outlive the process: each
    /// relation by its rows' hash, each input by its value's. A query read stands for
    /// what it stood on. Absent when any read has no such name.
    fn leaves_of(deps: List<Key>) -> List<Leaf>? {
        mut seen: Map<string, bool> = {}
        mut out: List<Leaf> = []
        for k in deps {
            let found? = self.leaves_at(k) else { return null }
            for l in found {
                let id = l.id()
                if !(seen.get(id) ?? false) {
                    seen.set(id, true)
                    out.push(l)
                }
            }
        }
        out
    }

    fn leaves_at(k: Key) -> List<Leaf>? {
        let rel? = self.relations.get().find(it.family_now() == k.family) else { return self.answer_leaves(k) }
        [Leaf.Rows(rel.name, rel.hash_now())]
    }

    fn answer_leaves(k: Key) -> List<Leaf>? {
        let owner? = self.answer_refs.get().find(it.family_now() == k.family) else { return null }
        if owner.by_answer {
            let named = self.spelled_leaves(owner, k)
            if named != null { return named }
        }
        let edge = edge_of(k)
        let noted? = self.leaves.get().get("${edge}") else { return self.spelled_leaves(owner, k) }
        self.known(edge, noted)
    }

    /// A cell no query settled, named by its owner's spelling of its argument.
    fn spelled_leaves(owner: AnswerRef, k: Key) -> List<Leaf>? {
        let spelled? = owner.spelled_at(k.arg) else { return null }
        let digest? = owner.hash_at(k.arg) else { return null }
        [Leaf.Input(owner.name, spelled, digest)]
    }

    /// What the query at `edge` settled standing on.
    fn noted(edge: int, leaves: List<Leaf>?) {
        self
            .leaves
            .put("${edge}", if leaves == null { Noted.Unnamed } else { Noted.Known(leaves!) })
    }

    /// The query at `edge` settled on its cell's reads, named when first asked.
    fn owed(edge: int, key: Key) { self.leaves.put("${edge}", Noted.Owed(key)) }

    fn leaves_noted(edge: int) -> List<Leaf>? {
        let noted? = self.leaves.get().get("${edge}") else { return null }
        self.known(edge, noted)
    }

    /// What a noted query stands on, an owed one named now and kept.
    fn known(edge: int, noted: Noted) -> List<Leaf>? {
        match noted {
            .Known(leaves) -> leaves,
            .Unnamed -> null,
            .Owed(key) -> {
                let found = self.leaves_of(self.engine().deps_of(key))
                self.noted(edge, found)
                found
            },
        }
    }

    /// Whether every read still has the digest it was kept at.
    fn leaves_hold(ls: List<Leaf>) -> bool { ls.all((l) -> self.leaf_holds(l)) }

    fn leaf_holds(l: Leaf) -> bool {
        match l {
            .Rows(name, digest) -> self.rows_digest(name) == digest,
            .Input(name, spelled, digest) -> {
                let now? = self.input_digest(name, spelled) else { return self.unstaged(name) }
                now == digest
            },
        }
    }

    /// The digest of the read `Leaf.id` names, as it stands here; absent when this Db cannot
    /// name the read.
    fn leaf_digest(id: string) -> string? {
        if id.starts_with("r\t") { return "${self.rows_digest(id.substring(2, id.length))}" }
        if !id.starts_with("i\t") { return null }
        let rest = id.substring(2, id.length)
        let at = rest.index_of("\t")
        if at < 0 { return null }
        let now? = self.input_digest(rest.substring(0, at), rest.substring(at + 1, rest.length)) else { return null }
        "${now}"
    }

    /// An input the record names that this process never set or asked: a miss, never a
    /// lazy load, and counted in the trace.
    fn unstaged(name: string) -> bool {
        let kernel? = self.kernel.get() else { return false }
        if kernel.tracing.get() { avra_qtrace("Q\tleaf\tunstaged\t${name}\n") }
        false
    }

    /// A relation's rows' hash here; an unreached relation holds none.
    fn rows_digest(name: string) -> int {
        let rel = self.relations.get().find(it.name == name)
        rel?.hash_now() ?? 0
    }

    /// An input's value hash here, absent when this Db has not been asked it.
    fn input_digest(name: string, spelled: string) -> int? {
        let owner? = self.answer_named(name) else { return null }
        let arg? = owner.arg_of(spelled) else { return null }
        owner.hash_at(arg)
    }

    /// The one query or input asked here wearing `name`; none when two do.
    fn answer_named(name: string) -> AnswerRef? {
        let all = self.answer_refs.get().filter(it.name == name)
        if all.length == 1 { all.first() } else { null }
    }

    /// An answer read back reads what it stood on: the same cells a run of it would.
    fn read_leaves(ls: List<Leaf>) {
        let kernel = self.engine()
        for l in ls {
            match l {
                .Rows(name, _) -> self.read_rows_leaf(kernel, name),
                .Input(name, spelled, _) -> self.read_input_leaf(kernel, name, spelled),
            }
        }
    }

    fn read_rows_leaf(kernel: Kernel, name: string) {
        let rel = self.relations.get().find(it.name == name)
        if rel != null { kernel.record_at(rel!.family_now(), 0) } else { self.watch_reach(name) }
    }

    /// An answer no kernel cell carries (its family is below zero) has nothing to record.
    fn read_input_leaf(kernel: Kernel, name: string, spelled: string) {
        let owner? = self.answer_named(name) else { return }
        if owner.family_now() < 0 { return }
        let arg? = owner.arg_of(spelled) else { return }
        kernel.record_at(owner.family_now(), arg)
    }

    /// A query or input asked here, as a saved answer may name it.
    fn answer_known(ref: AnswerRef) { self.answer_refs.push(ref) }

    /// The answers named here, forgotten: each holds the owner that named it.
    fn answers_forgotten() {
        let none: List<AnswerRef> = []
        self.answer_refs.set(none)
    }

    /// The revision `cell` moved at, kept where a family verifies by it.
    fn stamped(family: int, cell: int, rev: int) {
        let moved_at? = self.moves.get().get("${family}") else { return }
        moved_at.put("${cell}", rev)
    }

    /// Whether any cell here can have a reader: no query ever opened in
    /// the kernel means no write can be late.
    fn read_ever() -> bool { self.kernel.get()?.opened_ever() ?? false }

    /// Whether a query ever read a cell of `family` — one registered in
    /// this Db's kernel: until one has, a write there has no reader to
    /// ask and no reader to tell.
    fn read_in(family: int) -> bool { family >= 0 && self.kernel.get()?.read_any(family) ?? false }

    /// The name a reader's token stands for.
    fn reader(token: int) -> string {
        let kernel? = self.kernel.get() else { return "a query (reader ${token})" }
        "a query (reader ${token}, ${kernel.reader_text(token)})"
    }

    /// Who is writing now, in words: the innermost open query, or the driver.
    fn writing() -> string { self.writer(self.kernel.get()?.asking_edge() ?? 0 - 1) }

    /// A write the law refuses, told to whoever hears.
    fn refuse(words: string) {
        let heard = self.hears.get()
        heard(words)
    }

    /// Every reached relation's set hash, in the order they were reached.
    fn set_hashes() -> List<int> { [h() for h in self.hashes.get()] }

    /// Every reached relation's rows let go, and every later reach
    /// refused.
    fn close() {
        self.closed.set(true)
        for c in self.closers.get() { c() }
    }

    /// `close`, a later reach refused with `voice` — the law the owner let
    /// its rows go under.
    fn close_saying(voice: string) {
        self.closed_voice.set(voice)
        self.close()
    }
}

/// One Db's rows of one relation: never reached, open, or let go when
/// the Db closed — three states, never one absence standing for two.
enum Slot<R> {
    Unreached
    Open(rows: Rows<R>)
    Closed
}

/// One relation's rows under every Db, indexed by the Db's id, each
/// opened with the relation's own name and indexes: how many, and a bit
/// per index set where it hashes in order.
export type Stores<R> = { slots: Cell<List<Slot<R>>>, name: string, indexes: int, ordered: int }

export fn stores<R>(name: string, indexes: int, ordered: int) -> Stores<R> {
    let none: List<Slot<R>> = []
    Stores { slots: Cell.new(none), name: name, indexes: indexes, ordered: ordered }
}

impl Stores<R> {
    /// The rows under `db`: opened and kept on the first reach, the Db
    /// told how to hash them and let them go; refused once it closed. A
    /// close turns every reached slot `Closed`, so only a first reach
    /// asks the Db whether it closed.
    fn reach(db: Db) -> Rows<R> {
        let held = self.slots.get()
        let at = db.id
        if at >= held.length { return self.first_reach(db) }
        match held[at] {
            .Open(rows) -> rows,
            .Unreached -> self.first_reach(db),
            .Closed -> self.refused(db),
        }
    }

    /// A Db's first reach: refused once it closed, opened otherwise.
    fn first_reach(db: Db) -> Rows<R> {
        if db.closed.get() { return self.refused(db) }
        while self.slots.get().length <= db.id { self.slots.push(Slot.Unreached) }
        self.opened(db)
    }

    /// Fresh rows under `db`, kept, the Db told, the owner's family
    /// registered to verify them.
    fn opened(db: Db) -> Rows<R> {
        let made = self.fresh()
        self.slots.set_at(db.id, Slot.Open(made))
        let slots = self.slots
        let id = db.id
        let verify = (cell: int) -> cell_hash(slots.get()[id], cell)
        made
            .family
            .set(
                db
                    .registered(
                        verify,
                        (register: fn(fn(int) -> int) -> int) -> {
                            made.unmarked()
                            made.family.set(register(verify))
                        },
                    ),
            )
        let family = made.family
        db
            .joined(
                self.name,
                () -> family.get(),
                () -> open_hash(slots.get()[id]),
                () -> slots.set_at(id, Slot.Closed),
            )
        made
    }

    fn refused(db: Db) -> Rows<R> {
        avra_trap(db.closed_voice.get())
        self.fresh()
    }

    fn fresh() -> Rows<R> { named_rows(self.name, [(self.ordered >> i) & 1 == 1 for i in 0..self.indexes]) }
}

/// A cell's live hash: cell 0 the relation's set, cell `b + 1` bucket
/// `b`; none while unreached or closed.
fn cell_hash<R>(s: Slot<R>, cell: int) -> int {
    match s {
        .Open(held) -> if cell == 0 { held.set_hash() } else { held.bucket_hash(cell - 1) },
        .Unreached or .Closed -> 0,
    }
}

/// A slot's set hash: its rows', none while unreached or closed.
fn open_hash<R>(s: Slot<R>) -> int {
    match s { .Open(held) -> held.set_hash(), .Unreached or .Closed -> 0 }
}

// ── queries and inputs ──

/// One `@query`'s or `@input`'s answers under every Db, by the Db's id: `name` keeps them past
/// the process, `word` names their family in the kernel's counts and traces.
export type Answers<V> = { held: Cell<List<AnswersUnder<V>?>>, name: string, word: string, dense: bool }

/// One query's answers under one Db: its kernel family with the typed
/// values, every call's spelled arguments interned to a dense arg, and
/// how each call is asked again when the kernel verifies it.
type AnswersUnder<V> = {
    memo: Relation<V>,
    args: Cell<Map<string, int>>,
    spells: Cell<List<string>>,
    ints: Cell<List<int>>,
    again: Table<fn() -> V>,
    cap: int,
    since: Cell<int>,
    next: Cell<int>,
    free: Cell<List<int>>,
    /// Whether a call is keyed by a process's own number, which only `named` makes durable.
    dense: bool,
    /// Each int-keyed call's number, by its arg.
    numbers: Cell<List<int>>,
    named: Cell<DenseNames?>,
}

/// How a query keyed by one dense number names its calls past the process: the number's
/// durable spelling, its inverse in this process, and the call asked by its number alone.
export type DenseNames = { spell: fn(int) -> string?, number: fn(string) -> int?, ask: fn(int) -> void }

export fn answers<V>(name: string, word: string, dense: bool) -> Answers<V> {
    let none: List<AnswersUnder<V>?> = []
    Answers { held: Cell.new(none), name: name, word: word, dense: dense }
}

impl Answers<V> {
    /// The answers under `db`: its family registered in the Db's kernel
    /// on the first ask, and dropped — to register again, empty — when
    /// the Db closes or is given another kernel.
    fn under(db: Db) -> AnswersUnder<V> {
        let held = self.held.get()
        if db.id >= held.length { return self.opened(db) }
        held[db.id] ?? self.opened(db)
    }

    fn opened(db: Db) -> AnswersUnder<V> {
        while self.held.get().length <= db.id { self.held.push(null) }
        let slots = self.held
        let id = db.id
        let kernel = db.engine()
        let family = kernel.family()
        kernel.named(family, self.word)
        kernel.set_verify(family, (arg: int) -> reasked(slots.get()[id], arg))
        self.placed(db, held_in(kernel, family, db.cap.get(), self.dense))
    }

    /// `made` kept as the answers under `db`, until the Db closes or is
    /// given another kernel.
    fn placed(db: Db, made: AnswersUnder<V>) -> AnswersUnder<V> {
        let slots = self.held
        let id = db.id
        self.held.set_at(id, made)
        db.registrars.push((_register: fn(fn(int) -> int) -> int) -> slots.set_at(id, null))
        db.closers.push(() -> slots.set_at(id, null))
        db
            .answer_known(
                AnswerRef {
                    name: self.name,
                    family: () -> held_family(slots, id),
                    spelled: (arg: int) -> held_spelled(slots, id, arg),
                    arg: (spelled: string) -> held_arg(slots, id, spelled),
                    hash: (arg: int) -> held_hash(slots, id, arg),
                    by_answer: true,
                },
            )
        made
    }
}

/// The family the answers under Db `id` live in, -1 once they are dropped.
fn held_family<V>(slots: Cell<List<AnswersUnder<V>?>>, id: int) -> int {
    let h? = slots.get()[id] else { return 0 - 1 }
    h.memo.query_key(0).family
}

/// The arguments call `arg` was asked with, spelled so another process reads the same call.
fn held_spelled<V>(slots: Cell<List<AnswersUnder<V>?>>, id: int, arg: int) -> string? {
    let h? = slots.get()[id] else { return null }
    h.durable_at(arg)
}

/// The call a durable spelling names here — asked by its number when this process never
/// asked it; none for a spelling that names nothing here.
fn held_arg<V>(slots: Cell<List<AnswersUnder<V>?>>, id: int, spelled: string) -> int? {
    let h? = slots.get()[id] else { return null }
    h.durable_arg(spelled)
}

/// The hash of call `arg`'s settled value — the call asked first, by its number, when it
/// never settled here; none for one nothing can ask.
fn held_hash<V>(slots: Cell<List<AnswersUnder<V>?>>, id: int, arg: int) -> int? {
    let h? = slots.get()[id] else { return null }
    h.hash_asked(arg)
}

/// A query's empty answers in one kernel family.
fn held_in<V>(kernel: Kernel, family: int, cap: int, dense: bool) -> AnswersUnder<V> {
    let none: DenseNames? = null
    let free: Cell<List<int>> = Cell.new([])
    let memo: Relation<V> = new_memo(kernel, family)
    let args: Cell<Map<string, int>> = Cell.new({})
    let spells: Cell<List<string>> = Cell.new([])
    let ints: Cell<List<int>> = Cell.new([])
    let again: Table<fn() -> V> = new_table()
    AnswersUnder {
        memo: memo,
        args: args,
        spells: spells,
        ints: ints,
        again: again,
        cap: cap,
        since: Cell.new(0),
        next: Cell.new(0),
        free: free,
        dense: dense,
        numbers: list_cell(),
        named: Cell.new(none),
    }
}

/// A kept record read back: what the answer stood on, and the answer.
type Kept<V> = { leaves: List<Leaf>, value: V }

/// A kept record's answer, read back only when it was kept for `spelled`.
fn proved<V>(r: Reader, spelled: string, read: fn(Reader) -> Result<V, CodecFault>) -> Result<
    Kept<V>,
    CodecFault,
> {
    let kept = r.text()?
    if kept != spelled { fail CodecFault.OtherArguments }
    let leaves = read_list(r, read_leaf)?
    let value = read(r)?
    Kept { leaves: leaves, value: value }
}

fn write_leaf(w: Writer, l: Leaf) {
    match l {
        .Rows(name, digest) -> {
            w.int(0)
            w.text(name)
            w.int(digest)
        },
        .Input(name, spelled, digest) -> {
            w.int(1)
            w.text(name)
            w.text(spelled)
            w.int(digest)
        },
    }
}

fn read_leaf(r: Reader) -> Result<Leaf, CodecFault> {
    let tag = r.int()?
    match tag {
        0 -> {
            let name = r.text()?
            let digest = r.int()?
            Leaf.Rows(name, digest)
        },
        1 -> {
            let name = r.text()?
            let spelled = r.text()?
            let digest = r.int()?
            Leaf.Input(name, spelled, digest)
        },
        _ -> {
            fail CodecFault.NotVariant
        },
    }
}

/// A call verified: asked again when it is a query's, then the revision
/// its cell last changed at.
fn reasked<V>(held: AnswersUnder<V>?, arg: int) -> int {
    let h? = held else { return 0 }
    match h.again.entry(arg) {
        .Present(ask) -> {
            let _ = ask()
        },
        .Missing -> no_word(),
    }
    h.memo.kernel.changed_at(h.memo.query_key(arg))
}

impl AnswersUnder<V> {
    /// A new call's room. Past the cap, every settled call not in flight is dropped at
    /// once — its value, its cell, its `again`, its spelled-key entry and its int slot —
    /// the revision moves once so dependents re-verify, and the count starts over. A
    /// dropped call is new the next time it is asked: its arg number is never reused.
    fn make_room() {
        if self.cap == 0 { return }
        if self.since.get() < self.cap {
            self.since.set(self.since.get() + 1)
            return
        }
        mut kept: Map<string, int> = {}
        mut dropped: List<int> = []
        for e in self.args.get().entries() {
            if self.memo.open(e.value) {
                kept.set(e.key, e.value)
            } else {
                self.memo.evict_call(e.value)
                self.again.drop(e.value)
                dropped.push(e.value)
            }
        }
        self.args.set(kept)
        self.free.set(self.free.get().concat(dropped))
        self.ints.set([if x >= 0 && self.memo.open(x) { x } else { -1 } for x in self.ints.get()])
        self.memo.kernel.bump()
        self.since.set(1)
    }

    /// A dense arg for a new call: the newest one an epoch freed, else one never used before.
    /// A freed arg comes back with a new cell, which settles at a revision past any stale
    /// dependent's verification, so that dependent re-verifies and never reuses.
    fn take_arg() -> int {
        let free = self.free.get()
        let reused? = free.last() else {
            let made = self.next.get()
            self.next.set(made + 1)
            return made
        }
        self.free.set(free.slice(0, free.length - 1))
        reused
    }

    fn arg(spelled: string) -> int {
        if spelled.length > KEY_BOUND { trapped(key_too_long(spelled.length)) }
        let known? = self.args.get().get(spelled) else {
            self.make_room()
            let made = self.take_arg()
            self.args.put(spelled, made)
            self.spell(made, spelled)
            return made
        }
        known
    }

    /// Call `at`'s arguments, kept to be read back. Marked, since no arguments spell as "".
    fn spell(at: int, spelled: string) {
        while self.spells.get().length <= at { self.spells.push("") }
        self.spells.set_at(at, "#${spelled}")
    }

    fn spelled_at(arg: int) -> string? {
        if arg < 0 || arg >= self.spells.get().length { return null }
        let marked = self.spells.get()[arg]
        if marked.is_empty() { null } else { marked.substring(1, marked.length) }
    }

    /// An int argument's dense arg: read from the int table below the cap, else
    /// interned by its spelled form, as `arg` interns it.
    fn int_arg(n: int) -> int {
        let inside = n >= 0 && n < INT_CAP
        if inside {
            let known = self.ints.get()
            if n < known.length && known[n] >= 0 { return known[n] }
        }
        let made = self.arg(spelled_with([(w: Writer) -> w.int(n)]))
        if inside { self.remember_int(n, made) }
        while self.numbers.get().length <= made { self.numbers.push(-1) }
        self.numbers.set_at(made, n)
        made
    }

    /// Whether this query's calls name themselves past the process yet.
    fn durably_named() -> bool { !self.dense || self.named.get() != null }

    /// How a dense-keyed query's calls are named past the process, set by its first call.
    fn durable_by(names: DenseNames) { self.named.set(names) }

    /// Call `arg`'s spelling another process reads alike: its arguments as the codec spells
    /// them, or — keyed by a dense number — that number's durable name; none for a number no
    /// name stands for.
    fn durable_at(arg: int) -> string? {
        if !self.dense { return self.spelled_at(arg) }
        let names? = self.named.get() else { return null }
        let n? = self.number_at(arg) else { return null }
        let spell = names.spell
        spell(n)
    }

    /// `durable_at`'s inverse: the call a spelling names here, interned when never asked.
    fn durable_arg(spelled: string) -> int? {
        if !self.dense { return self.args.get().get(spelled) }
        let names? = self.named.get() else { return null }
        let number = names.number
        let n? = number(spelled) else { return null }
        self.int_arg(n)
    }

    /// The number call `arg` was asked with, when it was asked by one.
    fn number_at(arg: int) -> int? {
        if arg < 0 || arg >= self.numbers.get().length { return null }
        let n = self.numbers.get()[arg]
        if n < 0 { null } else { n }
    }

    /// Call `arg`'s settled hash, the call asked by its number first when it never settled.
    fn hash_asked(arg: int) -> int? {
        let key = self.memo.query_key(arg)
        let held = self.memo.kernel.value_hash_of(key)
        if held != null { return held }
        let names? = self.named.get() else { return null }
        let n? = self.number_at(arg) else { return null }
        let ask = names.ask
        ask(n)
        self.memo.kernel.value_hash_of(key)
    }

    fn remember_int(n: int, made: int) {
        while self.ints.get().length <= n { self.ints.push(-1) }
        self.ints.set_at(n, made)
    }

    /// An open call computed: `body` run, its answer settled under the
    /// reads the kernel recorded.
    fn ran(db: Db, arg: int, body: fn() -> V, again: fn() -> V, digest: fn(V) -> int) -> V {
        self.run(db, arg, body, again, digest).value
    }

    /// `ran`, for an answer that reads back: a call this process never
    /// answered takes the owner's record when it has one and every read the
    /// record names still has its digest; else it runs, and hands its answer
    /// over when it wrote no rows and every read has a name. A call
    /// answered here and gone stale was moved in this process, which no
    /// record saw: it runs.
    fn ran_lasting(
        db: Db,
        arg: int,
        spelled: string,
        body: fn() -> V,
        again: fn() -> V,
        digest: fn(V) -> int,
        record: KeptRecord<V>,
    ) -> V {
        let query? = record.query else { return self.ran(db, arg, body, again, digest) }
        if self.answered(arg) { return self.ran(db, arg, body, again, digest) }
        let kept? = self.restored(db, query, record, spelled) else {
            return self.made_lasting(db, arg, query, spelled, body, again, digest, record)
        }
        if !db.leaves_hold(kept.leaves) {
            return self.made_lasting(db, arg, query, spelled, body, again, digest, record)
        }
        self.again.keep(arg, again)
        db.read_leaves(kept.leaves)
        db.noted(edge_of(self.memo.query_key(arg)), kept.leaves)
        self.memo.finish(arg, kept.value, digest(kept.value))
    }

    /// What a settled call stands on, noted: unnamed when a read of rows it could not hear
    /// happened since `foreign`, else owed to its first reader.
    fn note_leaves(db: Db, key: Key, foreign: int) {
        if foreign_reads().get() > foreign { db.noted(edge_of(key), null) } else { db.owed(edge_of(key), key) }
    }

    /// A call run, its answer kept with what it stood on.
    fn made_lasting(
        db: Db,
        arg: int,
        query: string,
        spelled: string,
        body: fn() -> V,
        again: fn() -> V,
        digest: fn(V) -> int,
        record: KeptRecord<V>,
    ) -> V {
        let done = self.run(db, arg, body, again, digest)
        let leaves = db.leaves_noted(edge_of(self.memo.query_key(arg)))
        if !done.wrote && leaves != null {
            let keep = db.durable.keep
            keep(
                query,
                record.args,
                encoded_with(
                    done.value,
                    (w, v) -> {
                        w.text(spelled)
                        written_list(w, leaves!, write_leaf)
                        record.write(w, v)
                    },
                ),
            )
        }
        done.value
    }

    /// Whether this process ever answered the call.
    fn answered(arg: int) -> bool {
        match self.again.entry(arg) { .Present(_) -> true, .Missing -> false }
    }

    /// The owner's record for a call, read back — one that does not read
    /// back is recomputed, never guessed at.
    fn restored(db: Db, query: string, record: KeptRecord<V>, spelled: string) -> Kept<V>? {
        let answer = db.durable.answer
        let bytes? = answer(query, record.args) else { return null }
        match decoded_with(bytes, (r: Reader) -> proved(r, spelled, record.read)) {
            .Ok(value) -> value,
            .Err(_) -> null,
        }
    }

    fn run(db: Db, arg: int, body: fn() -> V, again: fn() -> V, digest: fn(V) -> int) -> Run<V> {
        let settled = Cell.new(false)
        self.again.keep(arg, again)
        let before = db.written.get()
        let foreign = foreign_reads().get()
        db.entered()
        defer self.abandoned_unless(db, settled, arg)
        let value = body()
        let kept = db.left()
        settled.set(true)
        if !kept {
            self.memo.kernel.abandon(self.memo.query_key(arg))
            return Run { value: value, wrote: true }
        }
        // digested as it settles: its readers cut off on that digest
        let answer = self.memo.finish(arg, value, digest(value))
        let key = self.memo.query_key(arg)
        self.note_leaves(db, key, foreign)
        Run { value: answer, wrote: db.written.get() > before }
    }

    /// A call left before it settled leaves no body counted as running
    /// here and no open query in the kernel.
    fn abandoned_unless(db: Db, settled: Cell<bool>, arg: int) {
        if settled.get() { return }
        let _ = db.left()
        self.memo.kernel.abandon(self.memo.query_key(arg))
    }

    /// The driver's own value for an input's call.
    fn set(_db: Db, arg: int, value: V, digest: fn(V) -> int) {
        self.memo.set(arg, value, digest(value))
    }
}

/// A run's answer and whether a row was filed or removed while it ran — an unkept run counts
/// as one, so no record keeps its answer.
type Run<V> = { value: V, wrote: bool }

/// How an answer is kept past the process: the query's durable name, the
/// call's arguments' stable hash, and the answer's codec.
/// The name a query's answers are kept under: its durable name and its
/// code's hash — none when the code has no hash, so nothing is kept.
export fn code_keyed(name: string, hash: string?) -> string? {
    let h? = hash else { return null }
    "${name}#${h}"
}

export type KeptRecord<V> = { query: string?, args: int, write: fn(Writer, V) -> void, read: fn(Reader) -> Result<V, CodecFault> }

// ── voices ──

fn unkept_outside() -> string {
    "`unkept()` says a running `@query` cannot finish its answer, and no query is running here"
}

fn query_writes() -> string {
    "a `@query` wrote a row with no owner — a query answers, it writes no rows of its own; hand the rows to a named owner (`Rel.replaced(db, owner, rows)`)"
}

fn given_after_read(id: int) -> string {
    "Db ${id} is given a kernel after a query read it — a Db takes its owner's kernel before anything is asked of it"
}

fn closed_db(id: int) -> string {
    "relation rows reached through Db ${id} after it closed — a closed Db's rows are gone; open a new Db"
}
