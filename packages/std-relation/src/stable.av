//! STABLE ENCODINGS — a hash and a byte codec that answer from a value's
//! CONTENT alone: never a dense id, an address, or the process that
//! built it, so an answer written by one process is checked by the next.
//!
//! Every variable-length part carries its own length or count ahead of
//! it, and every `?` layer its own presence flag: the arity is fixed per
//! kind, so no two shapes spell the same bytes. The hash mixes at every
//! step — a mix only at the end keeps every collision a linear fold made
//! on the way.

/// splitmix64's finalizer: a nonlinear 64-bit mix.
export fn mix(x: int) -> int {
    let a = (x ^ shifted(x, 30)) * -4658895280553007687
    let b = (a ^ shifted(a, 27)) * -7723592293110705685
    b ^ shifted(b, 31)
}

/// `z` shifted right by `k` with zeros in from the top — `>>` carries
/// the sign bit.
fn shifted(z: int, k: int) -> int {
    (z >> k) & (1 << 64 - k) - 1
}

/// A hash under construction — one word, so it rides a register and a
/// field costs no allocation.
export type StableHasher = { z: int }

export fn stable_hasher(seed: int) -> StableHasher {
    StableHasher { z: mix(seed) }
}

/// A text's own stable hash — the seed a relation's stable name gives
/// its rows.
export fn text_hash(s: string) -> int {
    stable_hasher(0).text(s).finish()
}

/// A multiset's hash: the wrapping sum of its members' finished hashes —
/// order-free, and a duplicate counts twice. The empty set is zero.
export fn set_hash(hashes: List<int>) -> int {
    mut sum = 0
    for h in hashes { sum = sum + h }
    sum
}

impl StableHasher {
    fn word(w: int) -> StableHasher { StableHasher { z: mix(self.z ^ w) } }

    fn int(v: int) -> StableHasher { self.word(v) }

    fn bool(v: bool) -> StableHasher { self.word(flag(v)) }

    /// One `?` layer: whether a value is there.
    fn present(p: bool) -> StableHasher { self.bool(p) }

    /// A list's length, ahead of its elements.
    fn count(n: int) -> StableHasher { self.word(n) }

    fn text(s: string) -> StableHasher { self.octets(s.bytes()) }

    /// The length first, then every eight octets as one little-endian
    /// word.
    fn octets(b: Bytes) -> StableHasher {
        mut h = self.word(b.length)
        // LICENSED loops.index_walk: a stride of eight — no element walk says it
        mut at = 0
        while at < b.length {
            h = h.word(word_at(b, at))
            at = at + 8
        }
        h
    }

    fn finish() -> int { mix(self.z) }
}

/// Up to eight octets from `at`, little-endian; the length ahead of
/// them says where a short final word ends.
fn word_at(b: Bytes, at: int) -> int {
    mut w = 0
    for k in 0..8 {
        if at + k < b.length { w = w | (b.at(at + k) << 8 * k) }
    }
    w
}

/// A `?` layer folded in: its presence, then the value when there is one.
export fn hashed_opt<T>(h: StableHasher, v: T?, each: fn(StableHasher, T) -> StableHasher) -> StableHasher {
    match v {
        x? -> each(h.present(true), x)
        null -> h.present(false)
    }
}

/// A list folded in: its count, then every element in order.
export fn hashed_list<T>(h: StableHasher, xs: List<T>, each: fn(StableHasher, T) -> StableHasher) -> StableHasher {
    mut acc = h.count(xs.length)
    for x in xs { acc = each(acc, x) }
    acc
}

fn flag(v: bool) -> int {
    if v { 1 } else { 0 }
}

// ── The codec ──

/// HOW A DENSE ID CROSSES A PROCESS. A `@dense` id is an arena's index, which means nothing
/// outside the process that minted it, so a codec writes it through the scope its owner
/// hands in: a spelling of the id — a durable name for a declaration, an offset from a
/// window's base for an expression — and an inverse that answers absent for a spelling it
/// does not hold. `kind` is the id type's own name.
export trait Scope {
    fn spelled(kind: string, index: int) -> string

    fn unspelled(kind: string, text: string) -> int?
}

/// The scope that spells an id by its index, which only the process that wrote it reads back.
export type Indexed = {}

impl Scope for Indexed {
    fn spelled(kind: string, index: int) -> string { "${index}" }

    fn unspelled(kind: string, text: string) -> int? {
        if text.is_empty() || text.length > 18 { return null }
        mut n = 0
        for i in 0..text.length {
            let c = text.char_code(i)
            if c < 48 || c > 57 { return null }
            n = n * 10 + (c - 48)
        }
        n
    }
}

/// The index scope, as a value.
export fn indexed_scope() -> dyn Scope { Indexed {} }

/// A record under construction, as octets. An IDENTITY: every holder
/// of a writer writes the one record, so no seat needs `mut`.
export type Writer = { out: Cell<List<int>>, scope: dyn Scope }

export fn writer() -> Writer { writer_in(indexed_scope()) }

/// A writer whose dense ids cross by `scope`.
export fn writer_in(scope: dyn Scope) -> Writer {
    let out: Cell<List<int>> = Cell.new([])
    Writer { out: out, scope: scope }
}

impl Writer {
    fn byte(v: int) { self.out.push(v & 255) }

    /// Unsigned LEB128 over all 64 bits: seven at a time, low first.
    fn varint(v: int) {
        mut rest = v
        while rest < 0 || rest > 127 {
            self.byte((rest & 127) | 128)
            rest = shifted(rest, 7)
        }
        self.byte(rest)
    }

    /// A word as exactly eight octets, low first: a hash is uniform, so a varint would cost
    /// nine or ten of them.
    fn fixed(v: int) {
        for k in 0..8 { self.byte(v >> 8 * k) }
    }

    /// Zigzag, so a small negative is a short varint.
    fn int(v: int) { self.varint((v << 1) ^ (v >> 63)) }

    fn bool(v: bool) { self.byte(flag(v)) }

    fn present(p: bool) { self.bool(p) }

    fn count(n: int) { self.varint(n) }

    fn text(s: string) { self.octets(s.bytes()) }

    /// A dense id of the type named `kind`, as its scope spells it.
    fn dense(kind: string, index: int) { self.text(self.scope.spelled(kind, index)) }

    fn octets(b: Bytes) {
        self.count(b.length)
        for i in 0..b.length { self.byte(b.at(i)) }
    }

    fn bytes() -> Bytes { self.out.get().bytes()! }

    /// The octets as text no other octets spell: what a record is
    /// interned by.
    fn spelled() -> string { ["${octet}" for octet in self.out.get()].join(".") }
}

/// What `parts` write, in order, spelled out.
export fn spelled_with(parts: List<fn(Writer) -> void>) -> string {
    let w = writer()
    for part in parts { part(w) }
    w.spelled()
}

/// A `?` layer written: its presence, then the value when there is one.
export fn written_opt<T>(w: Writer, v: T?, each: fn(Writer, T) -> void) {
    match v {
        x? -> {
            w.present(true)
            each(w, x)
        }
        null -> w.present(false)
    }
}

/// A list written: its count, then every element in order.
/// A value written through each of its columns' writers, in order — a
/// nested record's fixed arity.
export fn written_all<T>(w: Writer, v: T, columns: List<fn(Writer, T) -> void>) {
    for each in columns { each(w, v) }
}

/// A map written: its count, then every entry's key and value in insertion order.
export fn written_map<V>(w: Writer, m: Map<string, V>, each: fn(Writer, V) -> void) {
    w.count(m.length)
    for e in m.entries() {
        w.text(e.key)
        each(w, e.value)
    }
}

export fn written_list<T>(w: Writer, xs: List<T>, each: fn(Writer, T) -> void) {
    w.count(xs.length)
    for x in xs { each(w, x) }
}

/// A tagged value: its variant's name, then its payload's writers in order.
export fn written_tagged(w: Writer, tag: string, parts: List<fn(Writer) -> void>) {
    w.text(tag)
    for part in parts { part(w) }
}

/// A variant of a fingerprinted codec: its place in the declaration, then its payload's writers.
export fn written_ordinal(w: Writer, at: int, parts: List<fn(Writer) -> void>) {
    w.count(at)
    for part in parts { part(w) }
}

/// One value as a record, through its writer.
export fn encoded_with<T>(v: T, each: fn(Writer, T) -> void) -> Bytes {
    let w = writer()
    each(w, v)
    w.bytes()
}

/// A record read back through its reader — one with octets to spare
/// refused, never half read.
export fn decoded_with<T>(b: Bytes, each: fn(Reader) -> Result<T, CodecFault>) -> Result<
    T,
    CodecFault,
> {
    let r = reader(b)
    let v = each(r)?
    if !r.done() { fail CodecFault.Trailing }
    v
}

/// Why a record does not decode. A record that does not decode is
/// dropped and recomputed, never guessed at.
export enum CodecFault {
    Truncated
    Overlong
    NotFlag
    NotText
    /// octets left after the last field
    Trailing
    /// a variant name the enum does not declare
    NotVariant
    /// a record kept for other arguments than the call's
    OtherArguments
    /// a record written under another shape than the type's own
    OtherShape
    /// a dense id whose spelling the scope does not hold
    Unresolved
}

impl CodecFault {
    fn word() -> string {
        match self {
            .Truncated -> "truncated",
            .Overlong -> "overlong",
            .NotFlag -> "not_flag",
            .NotText -> "not_text",
            .Trailing -> "trailing",
            .NotVariant -> "not_variant",
            .OtherArguments -> "other_arguments",
            .OtherShape -> "other_shape",
            .Unresolved -> "unresolved",
        }
    }
}

/// A record being read: its octets and the position reached. An
/// IDENTITY, as a writer is: every holder reads on from one position.
export type Reader = { b: Bytes, at: Cell<int>, scope: dyn Scope }

export fn reader(b: Bytes) -> Reader { reader_in(indexed_scope(), b) }

/// A reader whose dense ids return by `scope`.
export fn reader_in(scope: dyn Scope, b: Bytes) -> Reader {
    Reader { b: b, at: Cell.new(0), scope: scope }
}

impl Reader {
    fn byte() -> Result<int, CodecFault> {
        let at = self.at.get()
        if at >= self.b.length { fail CodecFault.Truncated }
        self.at.set(at + 1)
        self.b.at(at)
    }

    /// One value has one encoding: a tenth octet holds only bit 63,
    /// and no continuation ends in a zero octet.
    fn varint() -> Result<int, CodecFault> {
        mut v = 0
        for k in 0..10 {
            let o = self.byte()?
            if k == 9 && o > 1 { fail CodecFault.Overlong }
            v = v | ((o & 127) << 7 * k)
            if o < 128 {
                if k > 0 && o == 0 { fail CodecFault.Overlong }
                return v
            }
        }
        fail CodecFault.Overlong
    }

    /// Eight octets, low first: `fixed`'s reader.
    fn fixed() -> Result<int, CodecFault> {
        mut v = 0
        for k in 0..8 { v = v | (self.byte()? << 8 * k) }
        v
    }

    fn int() -> Result<int, CodecFault> {
        let z = self.varint()?
        shifted(z, 1) ^ 0 - (z & 1)
    }

    fn bool() -> Result<bool, CodecFault> {
        match self.byte()? { 0 -> false, 1 -> true, rest -> { fail CodecFault.NotFlag } }
    }

    fn present() -> Result<bool, CodecFault> { self.bool() }

    /// A count, never past what is left to read.
    fn count() -> Result<int, CodecFault> {
        let n = self.varint()?
        if n < 0 || n > self.b.length - self.at.get() { fail CodecFault.Truncated }
        n
    }

    fn octets() -> Result<Bytes, CodecFault> {
        let n = self.count()?
        let at = self.at.get()
        self.at.set(at + n)
        self.b.slice(at, at + n)
    }

    fn text() -> Result<string, CodecFault> {
        let s? = (self.octets()?).text() else { fail CodecFault.NotText }
        s
    }

    /// A dense id of the type named `kind`, read back through the scope.
    fn dense(kind: string) -> Result<int, CodecFault> {
        let spelling = self.text()?
        let index? = self.scope.unspelled(kind, spelling) else { fail CodecFault.Unresolved }
        index
    }

    /// A variant's place among `n` declared, refused past the last.
    fn ordinal(n: int) -> Result<int, CodecFault> {
        let at = self.varint()?
        if at < 0 || at >= n { fail CodecFault.NotVariant }
        at
    }

    /// A variant read back by its NAME: its place among `names`, the
    /// enum's variants in declared order.
    fn variant(names: List<string>) -> Result<int, CodecFault> {
        let at = names.index_of(self.text()?)
        if at < 0 { fail CodecFault.NotVariant }
        at
    }

    /// Whether every octet has been read.
    fn done() -> bool { self.at.get() == self.b.length }
}

/// A dense id read back through the reader's scope and built by `make`.
export fn dense_read<T>(r: Reader, kind: string, make: fn(int) -> T) -> Result<T, CodecFault> {
    .Ok(make(r.dense(kind)?))
}

/// A tagged enum's variant, read back by its place among the names.
export fn tagged<T>(at: Result<int, CodecFault>, variants: List<T>) -> Result<T, CodecFault> {
    variants[at?]
}

/// A nullable read back: its presence, then the value when present.
export fn read_opt<T>(r: Reader, each: fn(Reader) -> Result<T, CodecFault>) -> Result<
    T?,
    CodecFault,
> {
    if !r.present()? { return .Ok(null) }
    .Ok(each(r)?)
}

/// A list read back: its count, then every element in order.
export fn read_list<T>(r: Reader, each: fn(Reader) -> Result<T, CodecFault>) -> Result<
    List<T>,
    CodecFault,
> {
    let n = r.count()?
    .Ok([each(r)? for i in 0..n])
}

/// A map read back: its count, then every entry in order.
export fn read_map<V>(r: Reader, each: fn(Reader) -> Result<V, CodecFault>) -> Result<
    Map<string, V>,
    CodecFault,
> {
    let n = r.count()?
    mut m: Map<string, V> = {}
    for i in 0..n {
        let k = r.text()?
        m.set(k, each(r)?)
    }
    m
}

/// A value read through `read`, then made into the type that stands over it.
export fn read_over<A, B>(r: Reader, read: fn(Reader) -> Result<A, CodecFault>, make: fn(A) -> B) -> Result<
    B,
    CodecFault,
> {
    make(read(r)?)
}
