// A codec's cost is one reading of the declaration plus its arms: forty variants, each naming
// the same records three times, settle inside the default budget.
use @std.meta.{derive}
use @std.relation.{codec}
use @std.relation.stable.{indexed_scope}

type Pin = { x: int, s: string }
type Pair = { pin: Pin, tags: List<string> }

@codec
enum Wide {
    V0(a: Pin, b: Pair, c: List<Pin>)
    V1(a: Pin, b: Pair, c: List<Pin>)
    V2(a: Pin, b: Pair, c: List<Pin>)
    V3(a: Pin, b: Pair, c: List<Pin>)
    V4(a: Pin, b: Pair, c: List<Pin>)
    V5(a: Pin, b: Pair, c: List<Pin>)
    V6(a: Pin, b: Pair, c: List<Pin>)
    V7(a: Pin, b: Pair, c: List<Pin>)
    V8(a: Pin, b: Pair, c: List<Pin>)
    V9(a: Pin, b: Pair, c: List<Pin>)
    V10(a: Pin, b: Pair, c: List<Pin>)
    V11(a: Pin, b: Pair, c: List<Pin>)
    V12(a: Pin, b: Pair, c: List<Pin>)
    V13(a: Pin, b: Pair, c: List<Pin>)
    V14(a: Pin, b: Pair, c: List<Pin>)
    V15(a: Pin, b: Pair, c: List<Pin>)
    V16(a: Pin, b: Pair, c: List<Pin>)
    V17(a: Pin, b: Pair, c: List<Pin>)
    V18(a: Pin, b: Pair, c: List<Pin>)
    V19(a: Pin, b: Pair, c: List<Pin>)
    V20(a: Pin, b: Pair, c: List<Pin>)
    V21(a: Pin, b: Pair, c: List<Pin>)
    V22(a: Pin, b: Pair, c: List<Pin>)
    V23(a: Pin, b: Pair, c: List<Pin>)
    V24(a: Pin, b: Pair, c: List<Pin>)
    V25(a: Pin, b: Pair, c: List<Pin>)
    V26(a: Pin, b: Pair, c: List<Pin>)
    V27(a: Pin, b: Pair, c: List<Pin>)
    V28(a: Pin, b: Pair, c: List<Pin>)
    V29(a: Pin, b: Pair, c: List<Pin>)
    V30(a: Pin, b: Pair, c: List<Pin>)
    V31(a: Pin, b: Pair, c: List<Pin>)
    V32(a: Pin, b: Pair, c: List<Pin>)
    V33(a: Pin, b: Pair, c: List<Pin>)
    V34(a: Pin, b: Pair, c: List<Pin>)
    V35(a: Pin, b: Pair, c: List<Pin>)
    V36(a: Pin, b: Pair, c: List<Pin>)
    V37(a: Pin, b: Pair, c: List<Pin>)
    V38(a: Pin, b: Pair, c: List<Pin>)
    V39(a: Pin, b: Pair, c: List<Pin>)
}

fn pin(x: int) -> Pin { Pin { x: x, s: "p${x}" } }

/// The last variant, written and read back.
fn last_back() -> string {
    let w = Wide.V39(pin(1), Pair { pin: pin(2), tags: ["t"] }, [pin(3), pin(4)])
    match Wide.decoded_in(indexed_scope(), w.encoded_in(indexed_scope())) {
        .Ok(v) -> match v {
            .V39(a, b, c) -> "${a.s} ${b.pin.s} ${b.tags.join(",")} ${c.length}",
            rest -> "another variant",
        },
        .Err(_) -> "refused",
    }
}

spec "std/relation — a wide codec" {
    given "forty variants over shared records" {
        then "the last one reads back whole" { last_back() == "p1 p2 t 2" }
    }
}
