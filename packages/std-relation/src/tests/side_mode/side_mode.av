use @std.relation.{relation, side}
use @std.avrac.core.{SideTable, side_table}

@relation
@side
type Node = { label: string }

mut store: SideTable<Node> = side_table("test", 10, 12, Node { label: "seed" })
store.set(10, Node { label: "a" })
store.set(11, Node { label: "b" })
let miss = Node.get(store, 99)
"${Node.get(store, 10)?.label ?? "?"} ${Node.get(store, 11)?.label ?? "?"} ${miss?.label ?? "none"} ${Node.all(store).length}"
