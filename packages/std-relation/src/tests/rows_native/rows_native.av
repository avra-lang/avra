// proves: a store's cell written just before a loop survives the loop's
// first iteration natively — the loop binding's slot starts zeroed, so
// its first settle releases nothing. Before every local was zeroed, a
// slot LLVM reused from a value that had just died held that value's
// pointer, and the settle freed a live cell (eval and native disagreed).
use @std.relation.rows.{rows, IndexKey}

type P = { id: int, a: string }

let rt = rows<P>(1)
rt.put(0, P { id: 0, a: "x" }, 5, [IndexKey.Text("x")])
"set ${rt.set_hash()} count ${rt.count()} bh ${rt.bucket_hash(0)}"
