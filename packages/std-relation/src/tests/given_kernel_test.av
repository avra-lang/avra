// A `@query` under a Db its owner gave a kernel — the compiler's shape,
// where a late write is refused — is a cell of THAT kernel: it stands
// across revisions that moved nothing it read, and runs again when a row
// arrives, at a later revision, in a relation it read.
use @std.relation.{relation, query}
use @std.relation.db.{Db, new_db}
use @std.relation.engine.{Kernel, Key, new_kernel}

@relation
type Glyph = { @key name: string, @index set: string }

@relation
type Face = { @key name: string }

@relation
type Speck = { @index set: string }

@query
fn specks_in(db: Db, set: string) -> int { Speck.all(db).length + Speck.by_set(db, set).length }

once fn glyph_runs() -> Cell<List<string>> { Cell.new([]) }

fn ran(word: string) {
    let r = glyph_runs()
    r.push(word)
}

fn since(from: int) -> string { glyph_runs().get().slice(from, glyph_runs().get().length).join(",") }

@query
fn glyphs_in(db: Db, set: string) -> int {
    ran("glyphs")
    Glyph.by_set(db, set).length
}

@query
fn next_after(_db: Db, n: int) -> int {
    ran("next")
    n + 1
}

/// The owner's kernel and the Db given to it.
type Owned = { kernel: Kernel, db: Db }

fn under_owner() -> Owned {
    let kernel = new_kernel()
    let db = new_db()
    db.given_to(kernel)
    Owned { kernel: kernel, db: db }
}

spec "std/relation — a @query under an owner's kernel" {
    then "an answer that read nothing runs once across writes and revisions" {
        let o = under_owner()
        let from = glyph_runs().get().length
        let first = next_after(o.db, 1)
        let _ = Face.insert(o.db, name: "f")
        o.kernel.bump()
        let _ = Glyph.insert(o.db, name: "a", set: "s")
        o.kernel.bump()
        let again = next_after(o.db, 1)
        first == 2 && again == 2 && since(from) == "next"
    }
    then "an answer that read a bucket stands when a row lands in another, and runs again when one lands in its own" {
        let o = under_owner()
        let _ = Glyph.insert(o.db, name: "a", set: "s")
        let from = glyph_runs().get().length
        let one = glyphs_in(o.db, "s")
        o.kernel.bump()
        let _ = Glyph.insert(o.db, name: "b", set: "t")
        let still = glyphs_in(o.db, "s")
        o.kernel.bump()
        let _ = Glyph.insert(o.db, name: "c", set: "s")
        let two = glyphs_in(o.db, "s")
        one == 1 && still == 1 && two == 2 && since(from) == "glyphs,glyphs"
    }
    then "the call is a cell of the owner's kernel, holding the bucket it read" {
        let o = under_owner()
        let before = o.kernel.settled_keys().length
        let _ = Glyph.insert(o.db, name: "a", set: "s")
        let _ = glyphs_in(o.db, "s")
        let cells = o.kernel.settled_keys()
        let made = cells[cells.length - 1]
        cells.length == before + 1 && o.kernel.deps_of(made).length == 1
    }
    then "a row written to a bucket the query read this revision is refused, where the owner refuses late writes" {
        let o = under_owner()
        let heard: Cell<List<string>> = Cell.new([])
        o.db.heard_by((w: string) -> heard.push(w))
        let _ = Glyph.insert(o.db, name: "a", set: "s")
        let _ = glyphs_in(o.db, "s")
        let _ = Glyph.insert(o.db, name: "b", set: "s")
        heard.get().length == 1 && heard.get()[0].contains("a producer runs before its readers")
    }
    then "a large replacement refused for its last row files nothing and moves no cell: an answer over another bucket it names stands" {
        let o = under_owner()
        let heard: Cell<List<string>> = Cell.new([])
        o.db.heard_by((w: string) -> heard.push(w))
        let _ = Glyph.replaced(o.db, "glyphs", [Glyph { name: "seed", set: "first" }])
        let from = glyph_runs().get().length
        let first = glyphs_in(o.db, "first")
        o.kernel.bump()
        let _ = glyphs_in(o.db, "last")
        let rows = [Glyph { name: "g${i}", set: "first" } for i in 0..500]
        let stored = Glyph.replaced(o.db, "glyphs", rows.concat([Glyph { name: "z", set: "last" }]))
        o.kernel.bump()
        let again = glyphs_in(o.db, "first")
        stored.is_empty() &&
            heard.get().length == 1 &&
            heard.get()[0].contains("a producer runs before its readers") &&
            Glyph.all(o.db).length == 1 &&
            first == 1 &&
            again == 1 &&
            since(from) == "glyphs,glyphs"
    }
    then "a Db a query has read is given no kernel: refused by name, on its own kernel as on an owner's" {
        let own = new_db()
        let heard: Cell<List<string>> = Cell.new([])
        own.heard_by((w: string) -> heard.push(w))
        let _ = Glyph.insert(own, name: "a", set: "s")
        let _ = glyphs_in(own, "s")
        own.given_to(new_kernel())
        let o = under_owner()
        o.db.heard_by((w: string) -> heard.push(w))
        let _ = glyphs_in(o.db, "s")
        o.db.given_to(new_kernel())
        heard.get().length == 2 &&
            heard.get().all(it.contains("is given a kernel after a query read it")) &&
            glyphs_in(own, "s") == 1
    }
    then "a Db nothing was asked of is given a kernel unrefused, rows and all" {
        let db = new_db()
        let heard: Cell<List<string>> = Cell.new([])
        db.heard_by((w: string) -> heard.push(w))
        let _ = Glyph.insert(db, name: "a", set: "s")
        let _ = Glyph.by_set(db, "s")
        db.given_to(new_kernel())
        heard.get().is_empty() && glyphs_in(db, "s") == 1
    }
    then "a Db its owner released takes another kernel, and no read told to the first stands in it" {
        let o = under_owner()
        let heard: Cell<List<string>> = Cell.new([])
        o.db.heard_by((w: string) -> heard.push(w))
        let _ = Glyph.insert(o.db, name: "a", set: "s")
        let reader = Key { family: o.kernel.family(), arg: 0 }
        o.kernel.begin(reader)
        let _ = Glyph.by_set(o.db, "s")
        o.kernel.settle(reader, 0)
        o.db.released()
        let second = new_kernel()
        let asked = Key { family: second.family(), arg: 0 }
        second.begin(asked)
        second.settle(asked, 0)
        o.db.given_to(second)
        let _ = Glyph.insert(o.db, name: "b", set: "s")
        heard.get().is_empty()
    }
    then "a replacement moves a cell once, however many rows file under it: keyed rows into one read bucket move the revision by one" {
        let db = new_db()
        let _ = glyphs_in(db, "s")
        let kernel = db.engine()
        let before = kernel.revision()
        let stored = Glyph
            .replaced(db, "glyphs", [Glyph { name: "g${i}", set: "s" } for i in 0..300])
        stored.length == 300 && kernel.revision() == before + 1
    }
    then "keyless rows into one read bucket of a relation read whole move the revision by two" {
        let db = new_db()
        let _ = specks_in(db, "s")
        let kernel = db.engine()
        let before = kernel.revision()
        let stored = Speck.replaced(db, "specks", [Speck { set: "s" } for _i in 0..70])
        stored.length == 70 && kernel.revision() == before + 2
    }
    then "a relation no query has read is told of the whole alone, and of each cell once a query has read it" {
        let o = under_owner()
        let _ = Face.insert(o.db, name: "f")
        let reader = Key { family: o.kernel.family(), arg: 0 }
        o.kernel.begin(reader)
        let _ = Face.all(o.db)
        o.kernel.settle(reader, 0)
        let _ = Glyph.replaced(o.db, "glyphs", [Glyph { name: "a", set: "s" }])
        o.kernel.bump()
        let _ = Glyph.replaced(o.db, "glyphs", [Glyph { name: "b", set: "s" }])
        let rs = Glyph.rows_in(o.db)
        let family = rs.family.get()
        let cell = rs.bucket_of_text(1, "s") + 1
        let unread = o.kernel.verified(family, cell) == 0 &&
            o.kernel.verified(family, 0) == o.kernel.revision()
        let from = glyph_runs().get().length
        let one = glyphs_in(o.db, "s")
        o.kernel.bump()
        let _ = Glyph
            .replaced(o.db, "glyphs", [Glyph { name: "c", set: "s" }, Glyph { name: "d", set: "s" }])
        let read = o.kernel.verified(family, cell) == o.kernel.revision()
        unread && read && one == 1 && glyphs_in(o.db, "s") == 2 && since(from) == "glyphs,glyphs"
    }
    then "a replacement is refused for a bucket only a row it removes stands in" {
        let o = under_owner()
        let heard: Cell<List<string>> = Cell.new([])
        o.db.heard_by((w: string) -> heard.push(w))
        let _ = Glyph.replaced(o.db, "glyphs", [Glyph { name: "a", set: "s" }])
        o.kernel.bump()
        let _ = glyphs_in(o.db, "s")
        let stored = Glyph.replaced(o.db, "glyphs", [Glyph { name: "c", set: "t" }])
        stored.is_empty() &&
            heard.get().length == 1 &&
            [g.name for g in Glyph.all(o.db)].join(",") == "a"
    }
}
