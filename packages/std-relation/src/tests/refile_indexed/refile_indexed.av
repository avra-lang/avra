// proves: re-filing a keyed row checks every bucket the row leaves and every bucket it lands in, index
// by index — a row with several indexes re-filed is not walked past them
use @std.relation.{relation}
use @std.relation.db.{new_db}

@relation
type Item = { @key name: string, @index shade: string, @index size: int, n: int }

let db = new_db()
let _ = Item.insert(db, name: "a", shade: "red", size: 1, n: 1)
let _ = Item.insert(db, name: "a", shade: "blue", size: 2, n: 2)
"${Item.all(db).length} ${Item.by_key(db, ItemKey { name: "a" })?.n ?? 0} ${Item.by_shade(db, "red").length} ${Item.by_shade(db, "blue").length}"
