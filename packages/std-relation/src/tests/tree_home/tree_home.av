// proves: a saved answer keyed by texts that name paths under the Db's tree is read
// back by a Db standing in another tree, at a path of another length — each text is
// spelled from the tree before its length is — and a path outside the tree stays its own
use @std.relation.{query}
use @std.relation.db.{Db, Durable, durable_db}

once fn disk() -> Cell<Map<string, Bytes>> { Cell.new({}) }

once fn computes() -> Cell<int> { Cell.new(0) }

fn read_record(query: string, args: int) -> Bytes? { disk().get().get("${query}\t${args}") }

fn keep_record(query: string, args: int, record: Bytes) { disk().put("${query}\t${args}", record) }

/// A Db standing for a process whose tree is `home`.
fn process(home: string) -> Db { durable_db(Durable { answer: read_record, keep: keep_record, home: () -> home }) }

@query
fn paired(_db: Db, a: string, b: string) -> string {
    computes().set(computes().get() + 1)
    "ok"
}

let _ = paired(process("/a/bb"), "/a/bb/src/x.av", "/a/bb/src/y.av")
let moved = paired(
    process("/cccc/ddddd/eee"),
    "/cccc/ddddd/eee/src/x.av",
    "/cccc/ddddd/eee/src/y.av",
)
let first = computes().get()
let _ = paired(process("/cccc/ddddd/eee"), "/a/bb/src/x.av", "/a/bb/src/y.av")
"${moved} ${first} ${computes().get()}"
