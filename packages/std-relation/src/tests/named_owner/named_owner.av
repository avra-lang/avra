// proves: a named owner's rows are replaced in one step — what the new
// rows do not name is removed from every bucket and the set, a kept row
// keeps its id, an empty replacement empties the owner, a row filed by id
// for the owner between replacements is removed by the next unless named
// again or kept, no other owner's row moves, a second owner of one row is
// refused, a removal is a write a kept answer hears, and a removal under
// a read bucket is late and removes nothing — in both engines
use @std.relation.{relation, query}
use @std.relation.db.{Db, new_db, db_over, Verifying, Late}
use @std.relation.engine.{Key, new_kernel}

@relation
type Fact = { id: int, @key name: string, @index tag: string }

once fn heard() -> Cell<List<string>> { Cell.new([]) }

once fn counts() -> Cell<int> { Cell.new(0) }

fn noted(w: string) {
    let h = heard()
    h.push(w)
}

/// A Db whose refusals are heard.
fn logged() -> Db {
    let db = new_db()
    db.heard_by(noted)
    db
}

/// `name` filed under `tag` for `owner`, by id.
fn put_as(db: Db, owner: string, name: string, tag: string) -> int {
    let rs = Fact.rows_in(db)
    let at = Fact.by_key(db, FactKey { name: name })?.id ?? rs.next_id()
    let row = Fact { id: at, name: name, tag: tag }
    rs.put_owned(db, "Fact", at, row, row.stable_hash(), row.index_keys(), db.owner_named(owner))
    at
}

fn tagged(db: Db, tag: string) -> string { [f.name for f in Fact.by_tag(db, tag)].join(",") }

fn bucket(db: Db, tag: string) -> int {
    let rs = Fact.rows_in(db)
    rs.bucket_hash(rs.bucket_of_text(1, tag))
}

/// `owner`'s rows replaced by one per `name:tag` pair.
fn ran(db: Db, owner: string, pairs: List<string>) {
    let _ = Fact
        .replaced(db, owner, [Fact { id: 0, name: p.split(":")[0], tag: p.split(":")[1] } for p in pairs])
}

/// Every Fact counted — rerun only after a write.
@query
fn facts(db: Db) -> int {
    counts().set(counts().get() + 1)
    Fact.all(db).length
}

/// Three rows, then a run keeping two: the third is gone from its
/// bucket, the set and its id, the kept row's id stands, and every hash
/// agrees with a Db that only ever held the two.
fn replaced() -> string {
    let db = new_db()
    let o = "a.av"
    ran(db, o, ["a:x", "b:x", "c:y"])
    let a = Fact.by_key(db, FactKey { name: "a" })!.id
    let c = Fact.by_key(db, FactKey { name: "c" })!.id
    ran(db, o, ["a:x", "b:y"])
    let fresh = new_db()
    ran(fresh, "a.av", ["a:x", "b:y"])
    let same = db.set_hashes()[0] == fresh.set_hashes()[0] &&
        bucket(db, "x") == bucket(fresh, "x") &&
        bucket(db, "y") == bucket(fresh, "y")
    "${Fact.all(db).length} ${tagged(db, "x")} ${tagged(db, "y")} ${Fact.get(db, c) == null} ${Fact.by_key(db, FactKey { name: "a" })!.id == a} ${same}"
}

/// A run over nothing removes nothing; a run writing nothing empties
/// its owner.
fn emptied() -> string {
    let db = new_db()
    let o = "e.av"
    ran(db, o, [])
    let before = Fact.all(db).length
    ran(db, o, ["a:x"])
    ran(db, o, [])
    "${before} ${Fact.all(db).length} ${tagged(db, "x") == ""}"
}

/// A row filed by id for an owner stands until its rows are next
/// replaced, which removes it unless it is named again — and `kept`
/// keeps exactly the ids it is handed.
fn between() -> string {
    let db = new_db()
    let o = "g.av"
    ran(db, o, ["a:x"])
    let _ = put_as(db, o, "late", "x")
    let _ = put_as(db, o, "kept", "x")
    let held = tagged(db, "x")
    ran(db, o, ["a:x", "kept:x"])
    let replaced = tagged(db, "x")
    let last = put_as(db, o, "last", "x")
    Fact.rows_in(db).kept(db, db.owner_named(o), [last])
    "${held} ${replaced} ${tagged(db, "x")}"
}

/// Another owner's rows, and rows no owner wrote, never move.
fn apart() -> string {
    let db = new_db()
    let o = "a.av"
    let p = "b.av"
    let _ = Fact.insert(db, name: "loose", tag: "x")
    ran(db, o, ["a:x"])
    ran(db, p, ["b:x"])
    ran(db, o, [])
    tagged(db, "x")
}

/// A row one owner holds, written by another, is refused.
fn rival() -> string {
    let db = logged()
    let before = heard().get().length
    ran(db, "a.av", ["a:x"])
    ran(db, "b.av", ["a:y"])
    "${heard().get().length - before}"
}

/// A run that only removes is a write: a kept answer over the relation
/// is computed again, never reused stale.
fn heard_removal() -> string {
    let db = logged()
    let o = "a.av"
    ran(db, o, ["a:x", "b:x"])
    let first = facts(db)
    let runs = counts().get()
    ran(db, o, [])
    let second = facts(db)
    "${first}${second} ${counts().get() - runs}"
}

/// A removal from a bucket a reader read this revision is refused, as a
/// filing there is — where the Db's owner refuses a late write.
fn late() -> string {
    let kernel = new_kernel()
    let db = db_over(kernel, Verifying.ByHash, Late.Refused)
    db.heard_by(noted)
    let o = "a.av"
    ran(db, o, ["a:x", "b:y"])
    let reader = Key { family: kernel.family((_arg: int) -> 0), arg: 0 }
    kernel.begin(reader)
    let _ = Fact.by_tag(db, "y")
    kernel.settle(reader, 0)
    let before = heard().get().length
    ran(db, o, [])
    "${heard().get().length - before} ${Fact.all(db).length} ${heard().get().last() ?? "-"}"
}

"${replaced()} | ${emptied()} | ${between()} | ${apart()} | ${rival()} | ${heard_removal()} | ${late()}"
