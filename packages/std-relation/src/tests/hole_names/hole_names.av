// proves: a `@relation` row type named like a type std-relation's own
// files import (`Field`, `Type`) derives its accessors where the row is
// declared, not where the derive's template is written.
use @std.relation.{relation}
use @std.relation.db.{new_db}

@relation
type Field = { @key id: int, name: string }

@relation
type Type = { @key name: string }

let db = new_db()
let _ = Field.insert(db, name: "a")
let _ = Type.insert(db, name: "t")
"${Field.all(db).length} ${Type.all(db).length}"
