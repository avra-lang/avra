// A `@side` column's family verifies ONE SLOT, never the whole column: a
// query that read slot A stands across an edit to slot B and is computed
// again only across an edit to A itself (avra-8sb5.57.9.7). Asked of the
// kernel the column's Db lives in, the way a query's own verification is.
//
// `store` IS A `Cell<SideTable<Row>>`, never a bare table: the family's
// verify closure is bound once, at the first read, so it must re-read the
// CURRENT table through the Cell on every invocation — a closure over a
// bare table would answer that first read's snapshot forever.
use @std.relation.{relation, side}
use @std.relation.db.{Db, db_over, Verifying, Late}
use @std.relation.engine.{Kernel, Key, new_kernel}
use @std.relation.rows.{SideRows, side_rows}
use @std.avrac.core.{SideTable, side_table}

@relation
@side
type Row = { n: int }

fn two_row_store() -> Cell<SideTable<Row>> {
    mut tbl = side_table("rows", 0, 2, Row { n: 0 })
    tbl.set(0, Row { n: 1 })
    tbl.set(1, Row { n: 2 })
    Cell.new(tbl)
}

/// A kernel, a query key in it, and a Db over it.
type Rig = { kernel: Kernel, query: Key, db: Db, store: Cell<SideTable<Row>>, side: SideRows<Row> }

fn rig() -> Rig {
    let kernel = new_kernel()
    let side: SideRows<Row> = side_rows()
    Rig {
        kernel: kernel,
        query: Key { family: kernel.family((_arg: int) -> 0), arg: 0 },
        db: db_over(kernel, Verifying.ByHash, Late.Refused, false),
        store: two_row_store(),
        side: side,
    }
}

impl Rig {
    /// The query run: it reads slot `id`, and nothing else.
    fn reads(id: int) {
        self.kernel.begin(self.query)
        let _ = Row.get_db(self.db, self.store, self.side, id)
        self.kernel.settle(self.query, 0)
    }

    /// The query run once, and again at a later revision — so each cell
    /// it read has a hash the kernel has seen.
    fn settled_reading(id: int) {
        self.reads(id)
        self.kernel.bump()
        let _ = self.kernel.ask(self.query)
        self.reads(id)
    }

    /// Slot `id` rewritten, at a new revision.
    // LICENSED compiler.cell_get_copy: a test's one edit of a two-slot table, never a hot path
    fn edited(id: int, n: int) {
        mut tbl = self.store.get()
        tbl.set(id, Row { n: n })
        self.store.set(tbl)
        self.kernel.bump()
    }

    fn stands() -> bool { self.kernel.ask(self.query) is .Reuse }
}

spec "std/relation — a @side column's family verifies one slot at a time" {
    given "a column with two slots, one read by a query" {
        then "editing slot B leaves the reader of slot A standing" {
            let r = rig()
            r.settled_reading(0)
            r.edited(1, 99)
            r.stands()
        }
        then "editing slot A computes its reader again" {
            let r = rig()
            r.settled_reading(0)
            r.edited(0, 100)
            !r.stands()
        }
        then "a reader of a slot past the column reads the whole of it, and any edit moves it" {
            let r = rig()
            r.settled_reading(7)
            r.edited(1, 999)
            !r.stands()
        }
        then "with nothing edited the reader stands at a later revision" {
            let r = rig()
            r.settled_reading(0)
            r.kernel.bump()
            r.stands()
        }
    }
}
