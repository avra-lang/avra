// Every `@query` declares its row under `@query_row`: a `collect` lists the queries of a scope
// with the type each is keyed by, whether or not any was asked.
use @std.relation.{query, query_row, QueryRow}
use @std.relation.db.{Db}

@query
fn doubled(_db: Db, n: int) -> int { n * 2 }

@query
fn named_length(_db: Db, word: string) -> int { word.length }

@query
fn whole(_db: Db) -> int { 1 }

type Listed = { row: fn() -> QueryRow }

collect listed: List<Listed> = @query_row in self as Listed { row: it } by it.name

fn rows() -> List<QueryRow> { [(l.row)() for l in listed] }

fn seat_of(name: string) -> string? { rows().find(it.name == name)?.seat }

spec "std/relation — a query's row, listed unasked" {
    then "each query is listed with the type its calls are keyed by, none asked" {
        rows().length == 3 && seat_of("doubled") == "int" && seat_of("named_length") == "string"
    }
    then "a query over the Db alone is keyed by none" { seat_of("whole") == "" }
}
