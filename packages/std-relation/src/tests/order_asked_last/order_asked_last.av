// proves: a coded type's shape is its declarations' alone — asked after every type it reaches,
// imported in the other order, `Top` and `Ping` answer what `order_asked_first` answers.
use @std.relation.{Storable}
use tests.order_home.{Pong, Base, Right, Left, Ping, Top}

let _ = [Base.codec_shape(), Right.codec_shape(), Left.codec_shape(), Pong.codec_shape()]
"${Top.codec_shape()} ${Ping.codec_shape()} ${Pong.codec_shape()}"
