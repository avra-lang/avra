// The other build of `reach_twin_one.av`'s types: each outer type written alike, what it
// reaches through a coded type changed, and `Ping` and `Pong` declared in the other order.
use @std.relation.{Storable, codec}

type Sprig = { x: int, y: int }

@codec
type Bough = { s: Sprig }

@codec
type Trunk = { b: Bough }

@codec
type Hollow = { n: int }

@codec
type Core = { h: Hollow }

@codec
type Shell = { c: Core }

type Left = { x: int }

type Right = { y: int, z: int }

@codec
type Joint = { l: Left, r: Right }

@codec
type Frame = { j: Joint }

@codec
type Crate = { o: Bough?, os: List<Bough> }

@codec
type Vine = { kids: List<Vine>, b: Bough }

@codec
type Pong = { ping: Ping? }

@codec
type Ping = { pongs: List<Pong> }

@codec
type Arm = { b: Bough }

@codec
type Lattice = { a: Arm, b: Bough }

@codec
type Tick = { tock: Tock? }

@codec
type Tock = { ticks: List<Tick>, n: int }

export fn two_trunk() -> int { Trunk.codec_shape() }

export fn two_bough() -> int { Bough.codec_shape() }

export fn two_shell() -> int { Shell.codec_shape() }

export fn two_frame() -> int { Frame.codec_shape() }

export fn two_crate() -> int { Crate.codec_shape() }

export fn two_vine() -> int { Vine.codec_shape() }

export fn two_ping() -> int { Ping.codec_shape() }

export fn two_pong() -> int { Pong.codec_shape() }

export fn two_tick() -> int { Tick.codec_shape() }

export fn two_lattice() -> int { Lattice.codec_shape() }

/// Each family's shape and descriptor, one line a type.
export fn two_pinned() -> List<string> {
    [
        "Bough ${Bough.codec_shape()} ${Bough.codec_descriptor()}",
        "Trunk ${Trunk.codec_shape()} ${Trunk.codec_descriptor()}",
        "Hollow ${Hollow.codec_shape()} ${Hollow.codec_descriptor()}",
        "Core ${Core.codec_shape()} ${Core.codec_descriptor()}",
        "Shell ${Shell.codec_shape()} ${Shell.codec_descriptor()}",
        "Joint ${Joint.codec_shape()} ${Joint.codec_descriptor()}",
        "Frame ${Frame.codec_shape()} ${Frame.codec_descriptor()}",
        "Crate ${Crate.codec_shape()} ${Crate.codec_descriptor()}",
        "Vine ${Vine.codec_shape()} ${Vine.codec_descriptor()}",
        "Ping ${Ping.codec_shape()} ${Ping.codec_descriptor()}",
        "Pong ${Pong.codec_shape()} ${Pong.codec_descriptor()}",
        "Tick ${Tick.codec_shape()} ${Tick.codec_descriptor()}",
        "Tock ${Tock.codec_shape()} ${Tock.codec_descriptor()}",
    ]
}
