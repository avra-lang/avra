// The other build of `reach_twin_one.av`'s types: each outer type written alike, and what it
// reaches through a coded type changed.
use @std.relation.{Storable, codec}

type Sprig = { x: int, y: int }

@codec
type Bough = { s: Sprig }

@codec
type Trunk = { b: Bough }

export fn two_trunk() -> int { Trunk.codec_shape() }

export fn two_bough() -> int { Bough.codec_shape() }
