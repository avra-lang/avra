// proves: a `@query` over a context crosses a `@codec` type declared in another module under
// the context's scope — the dense ids inside it are spelled, never their process numbers — so
// a later process that numbers its items otherwise never reads an answer made for another item
use @std.relation.{query}
use @std.relation.db.{Db, Durable, durable_db}
use @std.relation.stable.{Scope}
use @std.text.{parse_int}
use tests.codec_scope.wants.{Item, Want}

/// A process's view of items: its own number for each, `by` past the name.
type Counted = { db: Db, by: int }

impl Counted {
    fn query_db() -> Db { self.db }

    fn query_scope() -> dyn Scope { Shifted { by: self.by } }
}

/// A scope naming an item by its number less `by`.
type Shifted = { by: int }

impl Scope for Shifted {
    fn spelled(_kind: string, index: int) -> string { "item ${named_from(index, self.by)}" }

    fn unspelled(_kind: string, text: string) -> int? {
        if !text.starts_with("item ") { return null }
        let n? = parse_int(text.substring(5, text.length)) else { return null }
        n + self.by
    }

    fn placed(_file: string, _lo: int, _hi: int) -> List<int>? { null }

    fn unplaced(_file: string, _at: List<int>) -> List<int>? { null }
}

once fn disk() -> Cell<Map<string, Bytes>> { Cell.new({}) }

fn read_record(query: string, args: int) -> Bytes? { disk().get().get("${query}\t${args}") }

fn keep_record(query: string, args: int, record: Bytes) { disk().put("${query}\t${args}", record) }

fn process() -> Db { durable_db(Durable { answer: read_record, keep: keep_record, home: () -> "" }) }

/// The want after `w`: its item's neighbour, and the item's name as a number.
@query
fn next_want(c: Counted, w: Want) -> Want { Want { item: Item { index: w.item.index + 1 }, at: named_from(w.item.index, c.by) } }

/// The name a process numbering its items `by` past their names gives item `index`.
fn named_from(index: int, by: int) -> int { index - by }

fn main_run() -> string {
    let first = next_want(Counted { db: process(), by: 0 }, Want { item: Item { index: 4 }, at: 0 })
    let later = Counted { db: process(), by: 100 }
    let same = next_want(later, Want { item: Item { index: 104 }, at: 0 })
    let other = next_want(later, Want { item: Item { index: 4 }, at: 0 })
    "${first.item.index} ${first.at} | ${same.item.index} ${same.at} | ${other.item.index} ${other.at}"
}

main_run()
