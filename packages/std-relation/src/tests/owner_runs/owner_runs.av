// proves: rows written while an owner's run is open are that owner's,
// under an open kernel query as outside one — a second owner of one key
// refused, a read of a relation an open run wrote refused by name, the
// same read free once the run closes — and a write with no run open is
// no one's, in both engines
use @std.relation.{relation}
use @std.relation.db.{Db, db_over, Verifying, Late}
use @std.relation.engine.{Kernel, Key, new_kernel}

@relation
type Fact = { @key name: string, n: int }

@relation
type Tag = { tag: string }

once fn heard() -> Cell<List<string>> { Cell.new([]) }

fn noted(w: string) {
    let h = heard()
    h.push(w)
}

/// A Db whose owner runs its own queries, its refusals heard.
fn owner_db(kernel: Kernel) -> Db {
    let db = db_over(kernel, Verifying.ByHash, Late.Refused)
    db.heard_by(noted)
    db
}

fn run() -> string {
    let kernel = new_kernel()
    let queries = kernel.family((_arg: int) -> 0)
    let db = owner_db(kernel)
    let first = Key { family: queries, arg: 7 }
    let second = Key { family: queries, arg: 8 }
    let one = db.owner_named("one")
    let two = db.owner_named("two")
    kernel.begin(first)
    let _ = db.opened_run(one)
    let _ = Fact.insert(db, name: "a", n: 1)
    db.closed_run(one)
    kernel.settle(first, 0)
    kernel.begin(second)
    let _ = db.opened_run(two)
    let _ = Fact.insert(db, name: "a", n: 2)
    let _ = Tag.insert(db, tag: "t")
    let _ = Tag.all(db)
    db.closed_run(two)
    let _ = Fact.insert(db, name: "loose", n: 0)
    kernel.settle(second, 0)
    "${heard().get().length} ${Tag.all(db).length} ${Fact.all(db).length} | ${heard().get().join(" | ")}"
}

run()
