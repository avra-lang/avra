// proves: an answer is digested by its type — a codec's bytes (a `@local` field
// is none of them), else its own `fingerprint()` — so an answer that moves while
// its digest stands leaves the reader standing; `@recursive`
// lets a call re-entered before it settles compute again, a smaller view,
// where a plain query answers the cycle; and an answer the body leaves
// `unkept()` reaches its asker and no cell holds it, so the next ask runs
// again; and a query's doors — `_key` names the cell a call settled in, `_held`
// peeks its answer, `_seat_of` reads a key's seat back, `_dropped` lets every
// answer go — in both engines
use @std.relation.{query, input, codec, recursive}
use @std.relation.db.{Db, new_db}

once fn runs() -> Cell<List<string>> { Cell.new([]) }

fn ran(word: string) {
    let r = runs()
    r.push(word)
}

fn since(from: int) -> string { runs().get().slice(from, runs().get().length).join(",") }

@input
fn width(_db: Db, _of: string) -> int { 10 }

@codec
type Measure = { wide: bool, @local width: int = 0 }

@query
fn measure(db: Db, of: string) -> Measure {
    ran("measure")
    let w = width(db, of)
    Measure { width: w, wide: w >= 100 }
}

/// An answer that stays in the process, digested by its own `fingerprint()`: the box is not on it.
type Bag = { box: Cell<int>, tag: int }

impl Bag {
    fn fingerprint() -> int { self.tag }
}

@query
fn bag(db: Db, of: string) -> Bag {
    ran("bag")
    let w = width(db, of)
    Bag { box: Cell.new(w), tag: if w >= 100 { 1 } else { 0 } }
}

@query
fn bag_shown(db: Db, of: string) -> string {
    ran("bag_shown")
    "t${bag(db, of).tag}"
}

@query
fn shown(db: Db, of: string) -> string {
    ran("shown")
    if measure(db, of).wide { "wide" } else { "narrow" }
}

once fn entered_depth() -> Cell<int> { Cell.new(0) }

/// A view that asks itself until it is two deep: each re-entry computes again.
@query
@recursive
fn view(db: Db, k: string) -> int {
    ran("view")
    let d = entered_depth().get()
    if d >= 2 { return d }
    entered_depth().set(d + 1)
    let inner = view(db, k)
    entered_depth().set(d)
    inner + 1
}

@query
fn doubled(_db: Db, n: int) -> int { n * 2 }

@query
fn halfway(db: Db, of: string) -> int {
    ran("halfway")
    if width(db, of) < 50 { db.unkept() }
    width(db, of)
}

fn main_run() -> string {
    let db = new_db()
    let a = shown(db, "x")
    let n0 = runs().get().length
    set_width(db, "x", 20)
    let b = shown(db, "x")
    let cut = since(n0)
    let n1 = runs().get().length
    set_width(db, "x", 200)
    let c = shown(db, "x")
    let moved = since(n1)
    let nv = runs().get().length
    let v = view(db, "k")
    let viewed = since(nv)
    let nw = runs().get().length
    let v2 = view(db, "k")
    let d = "${v} [${viewed}] ${v2} [${since(nw)}]"
    let n2 = runs().get().length
    let h1 = halfway(db, "y")
    let h2 = halfway(db, "y")
    let unkept = since(n2)
    set_width(db, "y", 60)
    let n3 = runs().get().length
    let h3 = halfway(db, "y")
    let h4 = halfway(db, "y")
    let late = since(n3)
    let k = measure_key(db, "x")
    let door = if db.engine().value_hash_of(k) != null { "keyed" } else { "unkeyed" }
    let seated = if measure_held(db, "x") != null { "seated" } else { "unseated" }
    let held_x = if measure_held(db, "x")?.wide ?? false { 1 } else { 0 }
    let held_none = measure_held(db, "never") == null
    let _ = doubled(db, 7)
    let seat = doubled_seat_of(db, doubled_key(db, 7)) ?? -1
    let foreign = doubled_seat_of(db, measure_key(db, "x")) == null
    measure_dropped(db)
    let gone = measure_held(db, "x") == null
    let doors = "${held_x} ${held_none} ${seat} ${foreign} ${gone}"
    let nb = runs().get().length
    let g1 = bag_shown(db, "z")
    set_width(db, "z", 20)
    let g2 = bag_shown(db, "z")
    let bagged = "${g1} ${g2} [${since(nb)}]"
    "${a} ${b} [${cut}] ${c} [${moved}] | ${d} | ${h1} ${h2} [${unkept}] ${h3} ${h4} [${late}] | ${door} ${seated} | ${doors} | ${bagged}"
}

main_run()
