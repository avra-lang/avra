// proves: an owner's replacement that writes nothing and so removes every row
// it wrote before is a write — a kept answer that read those rows is
// computed again, never reused stale — in both engines
use @std.relation.{relation, query}
use @std.relation.db.{Db, new_db}

@relation
type Input = { @key name: string, live: bool }

@relation
type Loose = { tag: string }

/// A loose tag per live input — keyless, so a rerun replaces the set.
@query
fn mirror(db: Db) -> int {
    let live = [i for i in Input.all(db) if i.live]
    let _ = Loose.replaced(db, "mirror", [Loose { tag: i.name } for i in live])
    live.length
}

@query
fn loose(db: Db) -> int { Loose.all(db).length }

fn run() -> string {
    let db = new_db()
    let _ = Input.insert(db, name: "a", live: true)
    let _ = mirror(db)
    let first = loose(db)
    let _ = Input.insert(db, name: "a", live: false)
    let between = loose(db)
    let _ = mirror(db)
    "${first} ${between} ${loose(db)}"
}

run()
