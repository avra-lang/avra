// proves: a query keyed by a text, not a name, trips the key bound — its key
// spells the whole text, past KEY_BOUND
use @std.relation.{query}
use @std.relation.db.{new_db, Db}

@query
fn by_text(_db: Db, text: string) -> int {
    text.length
}

let text = ["x" for i in 0..5000].join("")
by_text(new_db(), text)
