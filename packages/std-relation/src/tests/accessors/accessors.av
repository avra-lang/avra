// A relation's generated store accessors: `store`, `index_keys`,
// `insert` in each of its four shapes, `by_key` answering a key's row,
// and `by_<field>` answering one row or every row.
use @std.relation.{relation}

/// Ided, keyless: every insert is a new row.
@relation
type Flag = { id: int, @unique name: string, @index on: bool, @index rank: int }

/// Idless, keyless.
@relation
type Note = { @index tag: string, text: string }

/// Ided and keyed: an insert under a known key replaces that row, id kept.
@relation
type Account = { id: int, @index team: string, @key handle: string }

/// Idless and keyed.
@relation
type Tagged = { @key name: string, tags: List<string> }

fn names(fs: List<Flag>) -> string { [f.name for f in fs].join(",") }

fn flags() -> string {
    let fs = Flag.store()
    let x = Flag.insert(fs, Flag { id: 0, name: "x", on: true, rank: 1 })
    let y = Flag.insert(fs, Flag { id: 0, name: "y", on: true, rank: 2 })
    let _ = Flag.insert(fs, Flag { id: 0, name: "z", on: false, rank: 1 })
    let found = Flag.by_name(fs, "y")?.rank ?? -1
    "${x.id}${y.id} ${names(Flag.by_on(fs, true))} ${names(Flag.by_rank(fs, 1))} ${found} ${Flag.by_name(fs, "nope") == null}"
}

fn notes() -> string {
    let ns = Note.store()
    let _ = Note.insert(ns, Note { tag: "a", text: "one" })
    let _ = Note.insert(ns, Note { tag: "a", text: "one" })
    "${ns.count()} ${Note.by_tag(ns, "a").length}"
}

fn accounts() -> string {
    let accs = Account.store()
    let a = Account.insert(accs, Account { id: 0, team: "red", handle: "ann" })
    let b = Account.insert(accs, Account { id: 0, team: "red", handle: "bo" })
    let moved = Account.insert(accs, Account { id: 9, team: "blue", handle: "ann" })
    let team = Account.by_key(accs, "ann")?.team ?? "-"
    "${a.id}${b.id}${moved.id} ${accs.count()} ${team} ${Account.by_team(accs, "red").length}"
}

fn tagged() -> string {
    let ts = Tagged.store()
    let _ = Tagged.insert(ts, Tagged { name: "n", tags: ["a"] })
    let _ = Tagged.insert(ts, Tagged { name: "n", tags: ["b", "c"] })
    "${ts.count()} ${(Tagged.by_key(ts, "n")?.tags ?? []).join(",")}"
}

"${flags()} | ${notes()} | ${accounts()} | ${tagged()}"
