// proves: a Db closed under its owner's law refuses a later reach with
// that law, never the bare closed-Db words
use @std.relation.{relation}
use @std.relation.db.{new_db}

@relation
type Note = { @index tag: string }

let db = new_db()
let _ = Note.insert(db, tag: "a")
db.close_saying("an owner's rows are read while it stands")
Note.all(db).length
