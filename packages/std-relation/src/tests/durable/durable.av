// proves: a `@query` answer outlives its Db where the owner keeps it — a
// fresh Db (a later process) reads the record back instead of running;
// a moved owner key, a record that does not read back, and a run that
// wrote rows each run again; an answer that read an input is never kept,
// and an input set moves every answer read back; what a record cannot
// see — another Db's rows, this Db's rows held differently — is pinned
// as it stands today — in both engines
use @std.relation.{relation, query, input}
use @std.relation.db.{Db, Durable, durable_db}

@relation
type Note = { @key name: string }

enum Mood {
    Calm
    Loud
}

type Pair = { a: int, b: int }

/// The owner's disk: each record under the key it was kept at.
once fn disk() -> Cell<Map<string, Bytes>> { Cell.new({}) }

/// The owner's key for what the checked file is made of.
once fn file_key() -> Cell<string> { Cell.new("f1") }

/// Every key the owner kept a record at, in order.
once fn kept_keys() -> Cell<List<string>> { Cell.new([]) }

once fn computes() -> Cell<int> { Cell.new(0) }

fn counted() {
    let c = computes()
    c.set(c.get() + 1)
}

fn at(query: string, args: int) -> string { "${file_key().get()}\t${query}\t${args}" }

fn read_record(query: string, args: int) -> Bytes? { disk().get().get(at(query, args)) }

fn keep_record(query: string, args: int, record: Bytes) {
    kept_keys().push(at(query, args))
    disk().put(at(query, args), record)
}

/// A Db standing for a fresh process over the same disk.
fn process() -> Db { durable_db(Durable { answer: read_record, keep: keep_record }) }

@query
fn total(_db: Db, n: int) -> int {
    counted()
    n * 10
}

@query
fn fixed(_db: Db) -> string {
    counted()
    "fixed"
}

@query
fn absent(_db: Db, k: string) -> string? {
    counted()
    if k == "none" { null } else { k }
}

@query
fn words(_db: Db) -> List<string> {
    counted()
    ["a", "", "c"]
}

@query
fn mood(_db: Db, loud: bool) -> Mood {
    counted()
    if loud { Mood.Loud } else { Mood.Calm }
}

@query
fn writes(db: Db) -> int {
    counted()
    let _ = Note.replaced(db, "writes", [Note { name: "n" }])
    1
}

@query
fn paired(_db: Db) -> Pair {
    counted()
    Pair { a: 1, b: 2 }
}

/// Reads a relation it never writes.
@query
fn notes(db: Db) -> int {
    counted()
    Note.all(db).length
}

/// Seats named like the wrapper's own words.
@query
fn shadow(_db: Db, cell: int, args: int, m: int, held: int) -> int {
    counted()
    cell * 1000 + args * 100 + m * 10 + held
}

@input
fn size(_db: Db, _k: string) -> int { 1 }

/// Reads an input: its record would bring no word of it.
@query
fn doubled(db: Db, k: string) -> int {
    counted()
    size(db, k) * 2
}

fn since(before: int) -> int { computes().get() - before }

fn mood_word(m: Mood) -> string {
    match m { .Calm -> "calm", .Loud -> "loud" }
}

/// cold, warm in a fresh Db, and a moved key.
fn survives() -> string {
    let before = computes().get()
    let cold = total(process(), 4)
    let warm = total(process(), 4)
    let other = total(process(), 5)
    let warm_runs = since(before)
    file_key().set("f2")
    let moved = total(process(), 4)
    file_key().set("f1")
    "${cold} ${warm} ${other} ${warm_runs} ${moved} ${since(before)}"
}

/// A query with no arguments, a null answer, a list with an empty text,
/// and a tagged enum each read back as they were kept.
fn shapes() -> string {
    let _ = fixed(process())
    let _ = absent(process(), "none")
    let _ = absent(process(), "x")
    let _ = words(process())
    let _ = mood(process(), true)
    let before = computes().get()
    let f = fixed(process())
    let a = absent(process(), "none") ?? "null"
    let x = absent(process(), "x") ?? "null"
    let w = words(process())
    let m = mood_word(mood(process(), true))
    "${f} ${a} ${x} ${w.length}:${w.join("|")} ${m} ${since(before)}"
}

/// A record that does not read back runs again; so does a run that
/// wrote rows, and an answer with no codec.
fn reruns() -> string {
    let _ = total(process(), 9)
    for k in kept_keys().get() { disk().put(k, [1, 2, 3].bytes()!) }
    let before = computes().get()
    let _ = total(process(), 9)
    let _ = writes(process())
    let _ = writes(process())
    let _ = paired(process())
    let _ = paired(process())
    "${since(before)}"
}

/// A write in this process moves a restored answer, and the rerun it
/// forces is never kept: the next process reads the first record.
fn midway() -> string {
    let before = computes().get()
    let cold = notes(process())
    let db = process()
    let restored = notes(db)
    let _ = Note.insert(db, name: "late")
    let moved = notes(db)
    let next = notes(process())
    "${cold}${restored}${moved}${next} ${since(before)}"
}

/// An answer that read an input runs in every process, so a set input
/// is answered.
fn input_read() -> string {
    let before = computes().get()
    let cold = doubled(process(), "x")
    let db = process()
    let warm = doubled(db, "x")
    set_size(db, "x", 5)
    "${cold} ${warm} ${doubled(db, "x")} ${since(before)}"
}

/// An input set in this process moves an answer read back, whatever it
/// read when it was kept.
fn input_set() -> string {
    let _ = fixed(process())
    let before = computes().get()
    let db = process()
    let restored = fixed(db)
    set_size(db, "y", 3)
    "${restored} ${fixed(db)} ${since(before)}"
}

once fn elsewhere() -> Db { process() }

/// KNOWN, UNTIL A RECORD CARRIES ITS READS: an answer over this Db's rows is
/// read back by a process whose Db holds other rows before it asks (0,
/// where 1 is right) — the owner's key alone decides.
fn blind() -> string {
    file_key().set("f3")
    let empty = notes(process())
    let filled = process()
    let _ = Note.insert(filled, name: "here")
    let other = notes(filled)
    file_key().set("f1")
    "${empty}${other}"
}

/// Seats named like the wrapper's locals reach the body as written.
fn shadowed() -> string {
    let first = shadow(process(), 1, 2, 3, 4)
    let again = shadow(process(), 1, 2, 3, 4)
    "${first} ${again}"
}

"${survives()} | ${shapes()} | ${reruns()} | ${midway()} | ${shadowed()} | ${input_read()} | ${input_set()} | ${blind()}"
