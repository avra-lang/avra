// proves: a Db with no owner still holds a running query to the law — a
// query that `get`s a row of a relation it writes is refused
use @std.relation.{relation, query}
use @std.relation.db.{Db, new_db}

@relation
type Note = { @index tag: string }

@query
fn looping(db: Db) -> int {
    let _ = Note.insert(db, tag: "x")
    if Note.get(db, 0) == null { 0 } else { 1 }
}

looping(new_db())
