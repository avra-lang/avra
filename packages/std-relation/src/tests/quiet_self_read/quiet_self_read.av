// proves: a Db no one hears still holds a run to the law — a `get` of a
// row in a relation an open run wrote is refused, by the trap
use @std.relation.{relation, query}
use @std.relation.db.{Db, new_db}

@relation
type Note = { @index tag: string }

@query
fn looping(db: Db) -> int {
    let owner = db.owner_named("notes")
    let _ = db.opened_run(owner)
    let _ = Note.insert(db, tag: "x")
    let held = Note.get(db, 0) != null
    db.closed_run(owner)
    if held { 1 } else { 0 }
}

looping(new_db())
