// proves: a `@query` over the Db with TWO plain text seats is kept past the process: restored in a
// later process without running, run again for a seat value it never saw, and run again once an
// input it read moves.
use @std.relation.{query, input}
use @std.relation.db.{Db, Durable, durable_db}

once fn disk() -> Cell<Map<string, Bytes>> { Cell.new({}) }

once fn computes() -> Cell<int> { Cell.new(0) }

fn counted() {
    let c = computes()
    c.set(c.get() + 1)
}

fn read_record(query: string, args: int) -> Bytes? { disk().get().get("${query}\t${args}") }

fn keep_record(query: string, args: int, record: Bytes) { disk().put("${query}\t${args}", record) }

fn process() -> Db { durable_db(Durable { answer: read_record, keep: keep_record }) }

@input
fn base(_db: Db, _at: string) -> int { 0 }

@query
fn joined(db: Db, a: string, b: string) -> string {
    counted()
    "${a}+${b}=${base(db, a)}"
}

fn main_run() -> string {
    let db = process()
    set_base(db, "x", 7)
    let first = joined(db, "x", "y")
    let ran = computes().get()
    let later = process()
    set_base(later, "x", 7)
    let before = computes().get()
    let restored = joined(later, "x", "y")
    let kept = computes().get() == before
    let other = joined(later, "x", "z")
    let new_seat = computes().get() == before + 1
    let third = process()
    set_base(third, "x", 8)
    let before_moved = computes().get()
    let moved = joined(third, "x", "y")
    let reran = computes().get() == before_moved + 1
    "${first} ${ran} | ${restored} ${kept} | ${other} ${new_seat} | ${moved} ${reran}"
}

main_run()
