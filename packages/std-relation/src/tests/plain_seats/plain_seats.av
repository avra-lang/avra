// proves: a `@query` over a CONTEXT whose seats are plain text, naming no dense id, is kept past
// the process like one over the Db alone: restored in a later process without running, run
// again for a seat value it never saw, and run again once an input it read moves.
use @std.relation.{query, input}
use @std.relation.db.{Db, Durable, durable_db, LEAF_CHUNK}
use @std.relation.stable.{Scope}

/// What a query's body reads beside its Db.
type Shelf = { db: Db }

impl Shelf {
    fn query_db() -> Db { self.db }

    fn query_scope() -> dyn Scope { Nameless {} }
}

/// A scope that names no id.
type Nameless = {}

impl Scope for Nameless {
    fn spelled(_kind: string, _index: int) -> string { "" }

    fn unspelled(_kind: string, _text: string) -> int? { null }

    fn placed(_file: string, _lo: int, _hi: int) -> List<int>? { null }

    fn unplaced(_file: string, _at: List<int>) -> List<int>? { null }
}

once fn disk() -> Cell<Map<string, Bytes>> { Cell.new({}) }

once fn computes() -> Cell<int> { Cell.new(0) }

fn counted() {
    let c = computes()
    c.set(c.get() + 1)
}

fn read_record(query: string, args: int) -> Bytes? { disk().get().get("${query}\t${args}") }

fn keep_record(query: string, args: int, record: Bytes) { disk().put("${query}\t${args}", record) }

fn process() -> Db { durable_db(Durable { answer: read_record, keep: keep_record }) }

@input
fn base(_db: Db, _at: string) -> int { 0 }

@query
fn joined(s: Shelf, a: string, b: string) -> string {
    counted()
    "${a}+${b}=${base(s.db, a)}"
}

fn main_run() -> string {
    let db = process()
    set_base(db, "x", 7)
    let first = joined(Shelf { db: db }, "x", "y")
    let again = joined(Shelf { db: db }, "x", "y")
    let ran = computes().get()
    let later = process()
    set_base(later, "x", 7)
    let before = computes().get()
    let restored = joined(Shelf { db: later }, "x", "y")
    let kept = computes().get() == before
    let other = joined(Shelf { db: later }, "x", "z")
    let new_seat = computes().get() == before + 1
    let third = process()
    set_base(third, "x", 8)
    let before_moved = computes().get()
    let moved = joined(Shelf { db: third }, "x", "y")
    let reran = computes().get() == before_moved + 1
    "${first} ${again} ${ran} | ${restored} ${kept} | ${other} ${new_seat} | ${moved} ${reran}"
}

main_run()
