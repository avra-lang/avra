spec "std/relation — a shape is what an earlier build defined" {
    given "the nested coded types of one build and the other" {
        then "each family answers its earlier shape and descriptor" {
            one_pinned().join("\n") == twin_one.join("\n") &&
                two_pinned().join("\n") == twin_two.join("\n")
        }
    }
    given "a coded type whose reach is private to its module" {
        then "it answers its earlier shape and descriptor" {
            "Limb ${Limb.codec_shape()} ${Limb.codec_descriptor()}" == "Limb -3035650426618244728 avra.shape.2|Limb|-3035650426618244728|3|0|0|1|t|Twig|0|1|Twig|-8469613031128693669|r|1|x|int|0"
        }
    }
