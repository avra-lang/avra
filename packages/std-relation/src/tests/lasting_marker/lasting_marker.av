// proves: a context query with plain seats stays in the process unless it wears `@lasting`. An
// unmarked one is run again in a later process; a marked one that reads only recorded inputs is
// restored there with its saved parent, and re-run once an input moves; and a marked one that reads the context's root
// unrecorded is served another root's answer, which is why each marked query states its invariant.
use @std.relation.{query, input, lasting}
use @std.relation.db.{Db, Durable, durable_db}
use @std.relation.stable.{Scope}

/// A context: a Db and the root it stands in, which no frame records.
type Room = { db: Db, root: string }

impl Room {
    fn query_db() -> Db { self.db }

    fn query_scope() -> dyn Scope { Nameless {} }
}

/// A scope that names no id.
type Nameless = {}

impl Scope for Nameless {
    fn spelled(_kind: string, _index: int) -> string { "" }

    fn unspelled(_kind: string, _text: string) -> int? { null }

    fn placed(_file: string, _lo: int, _hi: int) -> List<int>? { null }

    fn unplaced(_file: string, _at: List<int>) -> List<int>? { null }
}

once fn disk() -> Cell<Map<string, Bytes>> { Cell.new({}) }

once fn computes() -> Cell<int> { Cell.new(0) }

fn counted() {
    let c = computes()
    c.set(c.get() + 1)
}

fn read_record(query: string, args: int) -> Bytes? { disk().get().get("${query}\t${args}") }

fn keep_record(query: string, args: int, record: Bytes) { disk().put("${query}\t${args}", record) }

fn process() -> Db { durable_db(Durable { answer: read_record, keep: keep_record }) }

@input
fn base(_db: Db, _at: string) -> int { 0 }

@query
fn plain_word(r: Room, w: string) -> string {
    counted()
    "${w}=${base(r.db, w)}"
}

@query
@lasting
fn kept_word(r: Room, w: string) -> string {
    counted()
    "${w}=${base(r.db, w)}"
}

@query
@lasting
fn parent_word(r: Room, w: string) -> string {
    counted()
    "<${kept_word(r, w)}>"
}

@query
@lasting
fn rooted_word(r: Room, w: string) -> string {
    counted()
    "${w}@${r.root}"
}

fn main_run() -> string {
    let db = process()
    set_base(db, "x", 7)
    let a = Room { db: db, root: "A" }
    let _ = plain_word(a, "x")
    let _ = kept_word(a, "x")
    let _ = rooted_word(a, "x")
    let _ = parent_word(a, "x")
    let later = process()
    set_base(later, "x", 7)
    let b = Room { db: later, root: "B" }
    let before_plain = computes().get()
    let plain = plain_word(b, "x")
    let plain_ran = computes().get() == before_plain + 1
    let before_kept = computes().get()
    let kept = kept_word(b, "x")
    let kept_restored = computes().get() == before_kept
    let leaked = rooted_word(b, "x")
    let before_parent = computes().get()
    let parent = parent_word(b, "x")
    let parent_restored = computes().get() == before_parent
    let third = process()
    set_base(third, "x", 8)
    let moved_before = computes().get()
    let moved = kept_word(Room { db: third, root: "A" }, "x")
    let moved_ran = computes().get() == moved_before + 1
    "${plain} ${plain_ran} | ${kept} ${kept_restored} | ${leaked} | ${parent} ${parent_restored} | ${moved} ${moved_ran}"
}

main_run()
