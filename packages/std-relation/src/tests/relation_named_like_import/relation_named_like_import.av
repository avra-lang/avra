// A relation named like a name `relation.av` imports (`Field`, `Type`,
// `Kind`) takes its own accessors: a generated body names the row where
// the row is declared, not where the template was written.
use @std.relation.{relation}
use @std.relation.db.{new_db}

@relation
type Field = { id: int, @key name: string }

@relation
type Kind = { id: int, @key label: string }

let db = new_db()
let f = Field.insert(db, name: "a")
let k = Kind.insert(db, label: "b")
"${f.name} ${k.label} ${Field.by_key(db, FieldKey { name: "a" })?.name ?? "-"}"
