// The red team's survivors, one `given` per attack class. Every case
// here failed, or was silent, before its fix.
use @std.relation.{relation_problems, problems_under, NamedShape}
use tests.twins_a.{a_name, a_hash}
use tests.twins_b.{b_name, b_hash}
use @std.relation.stable.{reader}
use @std.meta.{Type, Field, Kind, Mark}

fn marked_field(name: string, marks: List<string>) -> Field {
    Field {
        name: name,
        ty: "int",
        at: null,
        kind: Kind.Int,
        marks: [Mark { name: m, args: [], at: null } for m in marks],
    }
}

fn one_row(fields: List<Field>) -> Type {
    Type {
        name: "R",
        fields: fields,
        variants: [],
        at: null,
        doc: null,
        annotations: [],
        module: "m",
    }
}

fn refusals(t: Type) -> string {
    [d.kind ?? "?" for d in relation_problems(t)].join(",")
}

/// A field of kind `k` spelled `ty`, wearing `marks`.
fn kinded(name: string, ty: string, k: Kind, marks: List<string>) -> Field {
    Field {
        name: name,
        ty: ty,
        at: null,
        kind: k,
        marks: [Mark { name: m, args: [], at: null } for m in marks],
    }
}

/// The shapes a declaration table would answer: `NodeId` a dense id,
/// `Shade` a tagged enum, anything else plain.
fn shapes(n: string) -> NamedShape {
    match n {
        "NodeId" -> NamedShape.Dense("index"),
        "Shade" -> NamedShape.Tagged(["Red", "Green"]),
        rest -> NamedShape.Plain,
    }
}

fn id_field(marks: List<string>) -> Field { kinded("at", "NodeId", Kind.Named("NodeId", []), marks) }

fn shaped(fields: List<Field>) -> string {
    [d.kind ?? "?" for d in problems_under(one_row(fields), shapes)].join(",")
}

/// What the reader answers for an int encoded as `octets`.
fn int_read(octets: List<int>) -> string {
    match reader(octets.bytes()!).int() { .Ok(v) -> "${v}", .Err(f) -> f.word() }
}

spec "std/relation — adversarial" {
    given "malformed records" {
        then "a tenth varint byte carrying bits past 64 is overlong, never a wrapped value" {
            int_read([255, 255, 255, 255, 255, 255, 255, 255, 255, 127]) == "overlong"
        }
        then "a varint padded with a zero continuation is overlong — one value has one encoding" {
            int_read([128, 0]) == "overlong"
        }
        then "the widest canonical varint still reads" {
            int_read([255, 255, 255, 255, 255, 255, 255, 255, 255, 1]) == "-9223372036854775808"
        }
        then "a lone zero is zero" {
            int_read([0]) == "0"
        }
    }
    given "names against names: the generated members" {
        then "a field named `get` collides with the generated accessor" {
            refusals(one_row([Field { name: "get", ty: "int", at: null, kind: Kind.Int }])) == "name_collision"
        }
        then "a field named `all` collides with the generated accessor" {
            refusals(one_row([Field { name: "all", ty: "int", at: null, kind: Kind.Int }])) == "name_collision"
        }
        then "a field named `rows_in` collides with the generated accessor" {
            refusals(one_row([Field { name: "rows_in", ty: "int", at: null, kind: Kind.Int }])) == "name_collision"
        }
        then "a field named `key` is free while no field wears `@key`" {
            refusals(one_row([marked_field("key", ["index"])])) == ""
        }
        then "a field named `key` collides with `key()` once another field wears `@key`" {
            refusals(one_row([marked_field("handle", ["key"]), marked_field("key", [])])) == "name_collision"
        }
        then "a `key` lookup beside a `@key` field wears `by_key` twice, and speaks once" {
            refusals(one_row([marked_field("handle", ["key"]), marked_field("key", ["unique"])])) == "lookup_collision"
        }
        then "a field named after another field's lookup collides with it" {
            refusals(one_row([marked_field("ann", ["unique"]), marked_field("by_ann", [])])) == "name_collision"
        }
        then "a field named `db` collides with `insert`'s own Db seat" {
            refusals(one_row([marked_field("db", [])])) == "seat_collision"
        }
        then "a field named `by_key` collides only when a key exists" {
            refusals(one_row([marked_field("by_key", [])])) == "" &&
                refusals(one_row([marked_field("a", ["key"]), marked_field("by_key", [])])) == "name_collision"
        }
    }
    given "dense ids and tagged enums (decision 10)" {
        then "an unmarked dense id is refused, at any depth" {
            shaped([id_field([])]) == "dense_unmarked" &&
                shaped([kinded("up", "NodeId?", Kind.Opt(Kind.Named("NodeId", [])), [])]) == "dense_unmarked" &&
                shaped([kinded("kids", "List<NodeId>", Kind.List(Kind.Named("NodeId", [])), [])]) == "dense_unmarked"
        }
        then "a dense id marked `@local` is accepted, and may be indexed" {
            shaped([id_field(["local"])]) == "" && shaped([id_field(["local", "index"])]) == ""
        }
        then "a `@dense` type may be the row's own `id`; any other named type may not" {
            shaped([kinded("id", "NodeId", Kind.Named("NodeId", []), [])]) == "" &&
                shaped([kinded("id", "Point", Kind.Named("Point", []), [])]) == "id_not_int"
        }
        then "`@index` takes `ordered` and `grain`; any other argument, or one on another mark, is refused" {
            shaped(
                    [
                        kinded("f", "int", Kind.Int, ["index"]) with { marks: [Mark { name: "index", args: ["ordered", "grain"], at: null }] },
                    ],
                ) == "" &&
                shaped(
                    [
                        kinded("f", "int", Kind.Int, []) with { marks: [Mark { name: "index", args: ["sorted"], at: null }] },
                    ],
                ) == "mark_args" &&
                shaped(
                    [
                        kinded("f", "int", Kind.Int, []) with { marks: [Mark { name: "key", args: ["ordered"], at: null }] },
                    ],
                ) == "mark_args"
        }
        then "a second `@index(grain)` is refused — `get` records through one bucket" {
            shaped(
                [
                    kinded("f", "int", Kind.Int, []) with { marks: [Mark { name: "index", args: ["grain"], at: null }] },
                    kinded("g", "int", Kind.Int, []) with { marks: [Mark { name: "index", args: ["grain"], at: null }] },
                ],
            ) == "grain_twice"
        }
        then "`@key` with `@local` is refused — a key is the stable name" {
            shaped([kinded("n", "int", Kind.Int, ["key", "local"])]) == "key_local"
        }
        then "a tagged enum is carried, and files in a lookup" {
            shaped([kinded("shade", "Shade", Kind.Named("Shade", []), ["index"])]) == "" &&
                shaped([kinded("shades", "List<Shade>", Kind.List(Kind.Named("Shade", [])), [])]) == ""
        }
        then "any other named type is still not carried, unless it is `@local`" {
            shaped([kinded("p", "Point", Kind.Named("Point", []), [])]) == "kind_not_carried" &&
                shaped([kinded("p", "Point", Kind.Named("Point", []), ["local"])]) == ""
        }
    }
    given "names against names: the marks" {
        then "a misspelled mark is refused rather than ignored" {
            refusals(one_row([marked_field("a", ["indx"])])) == "unknown_mark"
        }
        then "a mark written twice on one field is refused" {
            refusals(one_row([marked_field("a", ["key", "key"])])) == "duplicate_mark"
        }
        then "a key that is also an index is accepted — marks stack" {
            refusals(one_row([marked_field("a", ["key", "index"])])) == ""
        }
        then "a key that is also unique is accepted" {
            refusals(one_row([marked_field("a", ["key", "unique"])])) == ""
        }
        then "`@unique` with `@index` is refused — one row or every row, never both" {
            refusals(one_row([marked_field("a", ["key", "unique", "index"])])) == "answer_clash"
        }
        then "a doubled mark speaks alone — no lookup law judges the field" {
            refusals(one_row([marked_field("a", ["unique", "index", "unique"])])) == "duplicate_mark"
        }
        then "a mark on the store's `id` is judged like any other" {
            refusals(one_row([marked_field("id", ["indx"])])) == "unknown_mark"
        }
    }
}

spec "std/relation — the stable name" {
    given "two modules each declaring a relation named `Row`" {
        then "each is named by its own module" {
            a_name() != b_name() &&
                a_name().ends_with("twins_a.Row") &&
                b_name().ends_with("twins_b.Row")
        }
        then "the same values hash apart, each seeded by its own name" {
            a_hash() != b_hash()
        }
    }
}
