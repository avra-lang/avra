// proves: a row files one key list per index — filed again under a
// different number of lists it is refused by name, never read past the
// end of either
use @std.relation.rows.{named_rows, IndexKey}

type P = { id: int, a: string, b: string }

let rt = named_rows<P>("P", [false, false])
rt.put(0, P { id: 0, a: "x", b: "y" }, 5, [[IndexKey.Text("x")], [IndexKey.Text("y")]])
rt.put(0, P { id: 0, a: "z", b: "y" }, 6, [[IndexKey.Text("z")]])
rt.count()
