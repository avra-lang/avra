// proves: a call whose ids its scope names as nothing is never kept, so a later process asking
// another item computes its own answer and never reads one made for the item asked first
use @std.relation.{query}
use @std.relation.db.{Db, Durable, durable_db}
use @std.relation.stable.{Scope}
use tests.nameless_key.wants.{Item, Want}

/// A process's view of items, under a scope that names none of them.
type Unnamed = { db: Db }

impl Unnamed {
    fn query_db() -> Db { self.db }

    fn query_scope() -> dyn Scope { Nameless {} }
}

/// A scope that names no item past the process.
type Nameless = {}

impl Scope for Nameless {
    fn spelled(_kind: string, _index: int) -> string { "" }

    fn unspelled(_kind: string, _text: string) -> int? { null }

    fn placed(_file: string, _lo: int, _hi: int) -> List<int>? { null }

    fn unplaced(_file: string, _at: List<int>) -> List<int>? { null }
}

once fn disk() -> Cell<Map<string, Bytes>> { Cell.new({}) }

fn read_record(query: string, args: int) -> Bytes? { disk().get().get("${query}\t${args}") }

fn keep_record(query: string, args: int, record: Bytes) { disk().put("${query}\t${args}", record) }

fn process() -> Db { durable_db(Durable { answer: read_record, keep: keep_record }) }

/// The want after `w`: its item's neighbour.
@query
fn next_want(_u: Unnamed, w: Want) -> Want { Want { item: Item { index: w.item.index + 1 }, at: 0 } }

fn main_run() -> string {
    let first = next_want(Unnamed { db: process() }, Want { item: Item { index: 4 }, at: 0 })
    let other = next_want(Unnamed { db: process() }, Want { item: Item { index: 5 }, at: 0 })
    "${first.item.index} ${other.item.index} kept ${disk().get().length}"
}

main_run()
