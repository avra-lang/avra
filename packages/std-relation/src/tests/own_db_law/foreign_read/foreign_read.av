// proves: a query reading a Db made before it opened refuses, naming the law.
use @std.relation.{relation, query}
use @std.relation.db.{Db, new_db}

@relation
type Note = { @key name: string }

once fn outside() -> Db { new_db() }

@query
fn read_outside(_db: Db) -> int { Note.all(outside()).length }

let _ = Note.insert(outside(), name: "x")
read_outside(new_db())
