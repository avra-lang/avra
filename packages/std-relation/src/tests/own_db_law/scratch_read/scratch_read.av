// proves: a Db made inside an open query is that query's scratch — its reads
// answer as usual and are invisible to the outer query.
use @std.relation.{relation, query}
use @std.relation.db.{Db, new_db}

@relation
type Note = { @key name: string }

@query
fn scratch(_db: Db) -> int {
    let inner = new_db()
    let _ = Note.insert(inner, name: "a")
    let _ = Note.insert(inner, name: "b")
    Note.all(inner).length
}

scratch(new_db())
