// proves: the Db handed to a query as its first seat is that query's own, though it was
// made before the query opened — a driver's Db is the input door, not another query's input.
use @std.relation.{relation, query}
use @std.relation.db.{Db, new_db}

@relation
type Note = { @key name: string }

@query
fn seated(db: Db) -> int { Note.all(db).length }

let driver = new_db()
let _ = Note.insert(driver, name: "a")
let _ = Note.insert(driver, name: "b")
seated(driver)
