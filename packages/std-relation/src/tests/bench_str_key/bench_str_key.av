// proves: the per-call cost of a @query with a path (string) argument
use @std.relation.{query}
use @std.relation.db.{new_db, Db}

@query
fn by_path(_db: Db, path: string) -> bool {
    path.length > 3
}

let db = new_db()
let p = "packages/cli/src/commands/check.av"
[by_path(db, p) for i in 0..20000].length
