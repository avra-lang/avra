use @std.relation.{relation, arena}
use @std.avrac.core.{Arena, new_arena}

@relation
@arena
type Node = { label: string }

let store: Arena<Node> = new_arena()
let a = store.add(Node { label: "a" }, null)
let b = store.add(Node { label: "b" }, null)
"${store.node_at(a).label} ${store.node_at(b).label} ${store.count()}"
