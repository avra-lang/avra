// proves: a Db no one hears still refuses a replacement that moves what
// the query making it read this revision — by the trap
use @std.relation.{relation, query}
use @std.relation.db.{Db, new_db}

@relation
type Note = { @index tag: string }

@query
fn looping(db: Db) -> int {
    let seen = Note.all(db).length
    let _ = Note.replaced(db, "notes", [Note { tag: "x" }])
    seen
}

looping(new_db())
