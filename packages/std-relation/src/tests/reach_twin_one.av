// One build's declarations of the types `reach_twin_two.av` declares again: each family's
// outer type is written alike in both, and only what it reaches through a coded type differs.
use @std.relation.{Storable, codec}

type Sprig = { x: int }

@codec
type Bough = { s: Sprig }

@codec
type Trunk = { b: Bough }

export fn one_trunk() -> int { Trunk.codec_shape() }

export fn one_bough() -> int { Bough.codec_shape() }
