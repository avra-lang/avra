//! Typed values over the query kernel. A family owns one memo; copies
//! share both its database and its value table, so higher-order query
//! bodies may safely capture either handle.
extern fn avra_qtrace(line: string)

export enum MemoAsk<T> {
    Reuse(T)
    Compute
    Cycle
}

export enum MemoStart<T> { Reuse(T), Compute }

/// One input read with the fingerprint of the bytes that produced it.
export type Loaded<T> = { value: T, fingerprint: int }

/// A family's dense value table over the Kernel: the shape a compile's
/// 22 in-process query families and, later, a `Db`'s durable relations
/// both are — ONE DEFINITION (COMPILER DB townhall §6.2).
export type Relation<T> = { kernel: Kernel, family: int, values: Table<T> }

/// `Memo<T>`'s old name, kept as the same type: nothing that already
/// spells `Memo<T>` moves.
export alias Memo<T> = Relation<T>

export fn new_memo<T>(db: Kernel, family: int) -> Relation<T> {
    Relation { kernel: db, family: family, values: new_table<T>() }
}

impl Relation {
    fn query_key(arg: int) -> Key { Key { family: self.family, arg: arg } }

    fn ask(arg: int) -> MemoAsk<T> {
        let a = match self.kernel.ask(self.query_key(arg)) {
            .Reuse -> match self.values.entry(arg) {
                .Present(value) -> MemoAsk.Reuse(value),
                .Missing -> missing_value(self.family, arg),
            },
            .Compute -> MemoAsk.Compute,
            .Cycle -> MemoAsk.Cycle,
        }
        if self.kernel.tracing.get() { avra_qtrace("Q\task\t${self.family}\t${arg}\t${ask_tag(a)}\n") }
        a
    }

    /// Open an acyclic query unless its typed value is reusable. The
    /// explicit answer remains sound when `T` itself is nullable.
    fn start(arg: int) -> MemoStart<T> {
        match self.ask(arg) {
            .Reuse(value) -> MemoStart.Reuse(value),
            .Cycle -> MemoStart.Reuse(self.cycle_value(arg)),
            .Compute -> {
                self.kernel.begin(self.query_key(arg))
                MemoStart.Compute
            },
        }
    }

    /// Open a query whose computation deliberately makes progress on
    /// re-entry. Lowering uses this while its annotation is hidden by
    /// the recursive view; that smaller view is the cycle answer.
    fn start_recursive(arg: int) -> MemoStart<T> {
        match self.ask(arg) {
            .Reuse(value) -> MemoStart.Reuse(value),
            .Cycle or .Compute -> {
                self.kernel.begin(self.query_key(arg))
                MemoStart.Compute
            },
        }
    }

    fn finish(arg: int, value: T, fingerprint: int) -> T {
        self.settle(arg, value, fingerprint)
    }

    /// `finish`'s lazy twin: `fingerprint` folds `value` only when the
    /// kernel finds a prior settle to compare it against — never on a
    /// key's first-ever settle, the common case on a cold compile.
    fn finish_lazy(arg: int, value: T, fingerprint: fn(T) -> int) -> T {
        self.settle_lazy(arg, value, fingerprint)
    }

    fn begin(arg: int) { self.kernel.begin(self.query_key(arg)) }

    /// Whether the query at `arg` is in flight — asked by a query that
    /// would otherwise re-enter it from another family.
    fn open(arg: int) -> bool { self.kernel.active(self.query_key(arg)) }

    /// Release this family's values and matching kernel cells
    /// together. Used to break retained closure cycles at shutdown.
    fn evict() {
        self.values.clear()
        self.kernel.evict_family(self.family)
    }

    fn settle(arg: int, value: T, fingerprint: int) -> T {
        self.kernel.settle(self.query_key(arg), fingerprint)
        self.values.keep(arg, value)
        if self.kernel.tracing.get() { avra_qtrace("Q\tsettle\t${self.family}\t${arg}\t${fingerprint}\n") }
        value
    }

    /// `settle`'s lazy twin: `fingerprint` runs at most once, only
    /// when the kernel's own cell already stands (the kernel's
    /// `settle_lazy`) — traced by reading the hash back rather than
    /// by holding what `fingerprint` answered, since it may never run.
    fn settle_lazy(arg: int, value: T, fingerprint: fn(T) -> int) -> T {
        let key = self.query_key(arg)
        self.kernel.settle_lazy(key, () -> fingerprint(value))
        self.values.keep(arg, value)
        if self.kernel.tracing.get() {
            avra_qtrace(
                "Q\tsettle\t${self.family}\t${arg}\t${self.kernel.value_hash_of(key) ?? -1}\n",
            )
        }
        value
    }

    /// A once-read input. Its loader runs on first sight; later reads
    /// record the dependency and return the shared typed value.
    fn input(arg: int, load: fn() -> T, fingerprint: fn(T) -> int) -> T {
        match self.values.entry(arg) {
            .Present(value) -> {
                self.kernel.record_at(self.family, arg)
                return value
            },
            .Missing -> {},
        }
        let value = load()
        self.kernel.set_input(self.query_key(arg), fingerprint(value))
        self.kernel.record_at(self.family, arg)
        self.values.keep(arg, value)
        value
    }

    /// The driver's own value for an input: kept, and every reader moved
    /// when its fingerprint differs from the one it replaces.
    fn set(arg: int, value: T, fingerprint: int) {
        self.kernel.set_input(self.query_key(arg), fingerprint)
        self.values.keep(arg, value)
    }

    /// An input whose semantic value does not retain its source bytes.
    /// The loader reads once and returns both products of that read.
    fn input_loaded(arg: int, load: fn() -> Loaded<T>) -> T {
        match self.values.entry(arg) {
            .Present(value) -> {
                self.kernel.record_at(self.family, arg)
                return value
            },
            .Missing -> {},
        }
        let loaded = load()
        self.kernel.set_input(self.query_key(arg), loaded.fingerprint)
        self.kernel.record_at(self.family, arg)
        self.values.keep(arg, loaded.value)
        loaded.value
    }

    /// The whole protocol for an acyclic derived family.
    fn demand(arg: int, compute: fn() -> T, fingerprint: fn(T) -> int) -> T {
        match self.ask(arg) {
            .Reuse(value) -> value,
            .Cycle -> self.cycle_value(arg),
            .Compute -> {
                self.kernel.begin(self.query_key(arg))
                let value = compute()
                self.settle(arg, value, fingerprint(value))
            },
        }
    }

    fn cycle_value(arg: int) -> T {
        match self.values.entry(arg) {
            .Present(value) -> value,
            .Missing -> missing_value(self.family, arg),
        }
    }
}

/// A query event's outcome, by name alone — never the payload, which
/// rides an opaque `T` the trace cannot stringify.
fn ask_tag<T>(a: MemoAsk<T>) -> string {
    match a { .Reuse(_) -> "reuse", .Compute -> "compute", .Cycle -> "cycle" }
}

fn missing_value<T>(family: int, arg: int) -> T {
    avra_trap("defect: memo family ${family} reused missing key ${arg}")
    missing_value<T>(family, arg)
}
