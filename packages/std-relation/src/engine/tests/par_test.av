// The scheduler's cut: contiguous, covering, deterministic, balanced.
use @std.relation.engine.{shards_of, workers_for}

fn join_ids(x: List<int>) -> string { ["${i}" for i in x].join(",") }

/// Shards spelled as text: ids joined by `,`, shards by `|`.
fn spelled(xs: List<List<int>>) -> string {
    [join_ids(x) for x in xs].join("|")
}

spec "relation/engine — par cuts shards by cost" {
    given "equal costs" {
        then "units are dealt round the shards" {
            spelled(shards_of([1, 1, 1, 1, 1, 1], 3)) == "0,3|1,4|2,5"
        }
    }
    given "one heavy id" {
        then "it stands alone and the rest follow" {
            spelled(shards_of([100, 1, 1, 1], 2)) == "0|1,2,3"
        }
    }
    given "more shards than ids" {
        then "every id is in exactly one shard" {
            spelled(shards_of([5, 5], 4)) == "0|1||"
        }
        then "there are still n shards" {
            shards_of([5, 5], 4).length == 4
        }
    }
    given "unequal costs" {
        then "the heaviest units go to separate shards and the light ones fill the lightest" {
            spelled(shards_of([9, 1, 8, 1, 1, 7], 3)) == "0,4|2,3|1,5"
        }
    }
    given "no ids" {
        then "every shard is empty" {
            spelled(shards_of([], 3)) == "||"
        }
    }
    given "the same costs twice" {
        then "the cut is the same" {
            spelled(shards_of([3, 1, 4, 1, 5], 2)) == spelled(shards_of([3, 1, 4, 1, 5], 2))
        }
    }
}

spec "relation/engine — par caps its workers" {
    given "memory for fewer than the cores" {
        then "memory decides" { workers_for(8, 8, 3000, 1000) == 3 }
    }
    given "fewer cores than asked" {
        then "the cores decide" { workers_for(8, 4, 90000, 1000) == 4 }
    }
    given "no memory to spare" {
        then "one worker runs" { workers_for(8, 8, 10, 1000) == 1 }
    }
    given "an unmeasured peak" {
        then "the cores and the ask decide" { workers_for(8, 8, 1, 0) == 8 }
    }
}
