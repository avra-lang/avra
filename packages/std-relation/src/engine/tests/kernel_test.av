// The kernel's laws, over a toy family: an input `n` and a derived
// `double` that reads it. Runs are counted so reuse is observable.
use @std.relation.engine.{Kernel, new_kernel, Key, new_memo, same_key}

/// A derived family over the kernel: computes 2n, counting runs.
/// The tally and values are explicit shared cells, so the verifier's
/// captured Toy and the caller's Toy observe the same query state.
type Toy = { db: Kernel, input: int, double_family: int, runs: Cell<int>, values: Cell<List<int>> }

fn toy() -> Toy {
    let db = new_kernel()
    let input = db.family((arg: int) -> db.changed_at(Key { family: 0, arg: arg }))
    let t = Toy {
        db: db,
        input: input,
        double_family: 0,
        runs: Cell.new(0),
        values: Cell.new([0, 0, 0, 0]),
    }
    let double_family = db.family(verified_double(t, it))
    t with { double_family: double_family }
}

fn verified_double(t: Toy, arg: int) -> int {
    let _ = double_of(t, arg)
    t.db.changed_at(Key { family: t.double_family, arg: arg })
}

fn set(t: Toy, arg: int, v: int) {
    t.db.set_input(Key { family: t.input, arg: arg }, v)
}

/// The derived query: reads the input, answers 2n; the hash IS the
/// value, so an unchanged answer cuts the wave.
fn double_of(t: Toy, arg: int) -> int {
    let key = Key { family: t.double_family, arg: arg }
    match t.db.ask(key) {
        .Reuse -> t.values.get()[arg],
        .Cycle -> 0 - 1,
        // LICENSED compiler.cell_get_copy: a test double's per-call write, never a hot path
        .Compute -> {
            t.db.begin(key)
            let in_key = Key { family: t.input, arg: arg }
            t.db.record_dep(in_key)
            let v = t.db.changed_at(in_key) * 0 + read_input(t, arg) * 2
            t.runs.set(t.runs.get() + 1)
            mut vs = t.values.get()
            vs.set(arg, v)
            t.values.set(vs)
            t.db.settle(key, v)
            v
        },
    }
}

/// The input's value rides beside the kernel — its hash is the value.
fn read_input(t: Toy, arg: int) -> int {
    t.values.get()[arg + 2]
}

// LICENSED compiler.cell_get_copy: a test double's per-call write, never a hot path
fn put(t: Toy, arg: int, v: int) {
    mut vs = t.values.get()
    vs.set(arg + 2, v)
    t.values.set(vs)
    set(t, arg, v)
}

spec "relation/engine — the kernel's laws" {
    given "reuse" {
        then "an unchanged input reuses the derived answer without running" {
            mut t = toy()
            put(t, 0, 21)
            let a = double_of(t, 0)
            put(t, 0, 21)
            let b = double_of(t, 0)
            a == 42 && b == 42 && t.runs.get() == 1
        }
        then "a changed input recomputes" {
            mut t = toy()
            put(t, 0, 1)
            let _ = double_of(t, 0)
            put(t, 0, 5)
            double_of(t, 0) == 10 && t.runs.get() == 2
        }
        then "the counters tell the story" {
            mut t = toy()
            put(t, 0, 1)
            let _ = double_of(t, 0)
            let _ = double_of(t, 0)
            t.db.stats() == "rev 1: 1 hits, 1 misses"
        }
    }
    given "early cutoff" {
        then "a recomputed answer with the same hash keeps its changed_at" {
            mut t = toy()
            put(t, 0, 4)
            let _ = double_of(t, 0)
            let before = t.db.changed_at(Key { family: t.double_family, arg: 0 })
            put(t, 0, 4)
            let _ = double_of(t, 0)
            t.db.changed_at(Key { family: t.double_family, arg: 0 }) == before
        }
    }
    given "cycles and sweeps" {
        then "a query that reaches itself is answered Cycle, not recursed" {
            mut db = new_kernel()
            let fam = db.family((arg: int) -> 0)
            let key = Key { family: fam, arg: 0 }
            db.begin(key)
            let v = db.ask(key)
            db.settle(key, 0)
            v is .Cycle
        }
        then "a sweep drops what the last revision never verified" {
            mut t = toy()
            put(t, 0, 1)
            put(t, 1, 2)
            let _ = double_of(t, 0)
            let _ = double_of(t, 1)
            put(t, 0, 3)
            let _ = double_of(t, 0)
            t.db.sweep()
            t.db.cell(Key { family: t.double_family, arg: 1 }) == null &&
                t.db.cell(Key { family: t.double_family, arg: 0 }) != null
        }
    }
    given "verification that re-enters or moves the database" {
        then "a verifier re-asking the key under verification reuses rather than recursing" {
            mut db = new_kernel()
            let fam = db.family((arg: int) -> 0)
            let key = Key { family: fam, arg: 0 }
            let dep = db
                .family(
                    (arg: int) -> {
                        let _ = db.ask(key)
                        0
                    },
                )
            db.begin(key)
            db.record_dep(Key { family: dep, arg: 0 })
            db.settle(key, 0)
            db.bump()
            db.ask(key) is .Reuse
        }
        then "a revision that moves during the walk leaves the cell stale, so the next ask walks again" {
            mut db = new_kernel()
            let walks: Cell<int> = Cell.new(0)
            let fam = db.family((arg: int) -> 0)
            let key = Key { family: fam, arg: 0 }
            let dep = db
                .family(
                    (arg: int) -> {
                        walks.set(walks.get() + 1)
                        db.bump()
                        0
                    },
                )
            db.begin(key)
            db.record_dep(Key { family: dep, arg: 0 })
            db.settle(key, 0)
            db.bump()
            let _ = db.ask(key)
            let _ = db.ask(key)
            walks.get() == 2
        }
    }
    given "the open stack — `active` is the bracket, seen from outside" {
        then "an unopened key is not active" {
            mut db = new_kernel()
            let fam = db.family((arg: int) -> 0)
            !db.active(Key { family: fam, arg: 0 })
        }
        then "a key is active between begin and settle, and not after" {
            mut db = new_kernel()
            let fam = db.family((arg: int) -> 0)
            let key = Key { family: fam, arg: 0 }
            db.begin(key)
            let during = db.active(key)
            db.settle(key, 0)
            during && !db.active(key)
        }
        then "the OUTER key stays active while an inner one is open" {
            mut db = new_kernel()
            let fam = db.family((arg: int) -> 0)
            let outer = Key { family: fam, arg: 0 }
            let inner = Key { family: fam, arg: 1 }
            db.begin(outer)
            db.begin(inner)
            let both = db.active(outer) && db.active(inner)
            db.settle(inner, 0)
            let outer_only = db.active(outer) && !db.active(inner)
            db.settle(outer, 0)
            both && outer_only && !db.active(outer)
        }
    }
    given "the flat layout — arg-major, grown by appending" {
        then "a cell far past every earlier arg is written, and the earlier ones stand" {
            mut t = toy()
            put(t, 0, 4)
            t.db.set_input(Key { family: t.input, arg: 300 }, 7)
            t.db.changed_at(Key { family: t.input, arg: 0 }) == 1 &&
                t.db.changed_at(Key { family: t.input, arg: 300 }) == 1
        }
        then "two families at one arg keep apart" {
            mut t = toy()
            t.db.set_input(Key { family: t.input, arg: 5 }, 1)
            t.db.set_input(Key { family: t.input, arg: 5 }, 2)
            t.db.set_input(Key { family: t.double_family, arg: 5 }, 9)
            t.db.set_input(Key { family: t.input, arg: 5 }, 3)
            t.db.changed_at(Key { family: t.double_family, arg: 5 }) == 2 &&
                t.db.changed_at(Key { family: t.input, arg: 5 }) == 3
        }
        then "a key the kernel never saw is as new as now, wherever it would sit" {
            let t = toy()
            t.db.changed_at(Key { family: t.double_family, arg: 9999 }) == t.db.revision()
        }
    }
    given "an input set again before any reader read it" {
        then "it holds the new hash, and no revision moves" {
            mut db = new_kernel()
            let fam = db.family((arg: int) -> 0)
            let key = Key { family: fam, arg: 0 }
            db.input_unread(key, 1)
            db.input_unread(key, 2)
            db.value_hash_of(key) == 2 && db.revision() == 1
        }
        then "once read, it keeps the hash its reader saw" {
            mut db = new_kernel()
            let fam = db.family((arg: int) -> 0)
            let key = Key { family: fam, arg: 0 }
            db.input_unread(key, 1)
            let reader = Key { family: fam, arg: 1 }
            db.begin(reader)
            db.record_dep(key)
            db.settle(reader, 1)
            db.input_unread(key, 2)
            db.value_hash_of(key) == 1 && db.revision() == 1
        }
    }
    given "the last-reader stamp" {
        then "repeat reads of one key within one query record one dep, not N" {
            mut db = new_kernel()
            let fam = db.family((arg: int) -> 0)
            let key = Key { family: fam, arg: 0 }
            db.set_input(key, 1)
            let outer = Key { family: fam, arg: 1 }
            db.begin(outer)
            for i in 0..50 { db.record_dep(key) }
            db.settle(outer, 1)
            db.cell(outer)!.deps.length == 1
        }
        then "reads of two different keys record two deps, never merged" {
            mut db = new_kernel()
            let fam = db.family((arg: int) -> 0)
            let a = Key { family: fam, arg: 0 }
            let b = Key { family: fam, arg: 1 }
            db.set_input(a, 1)
            db.set_input(b, 2)
            let outer = Key { family: fam, arg: 2 }
            db.begin(outer)
            db.record_dep(a)
            db.record_dep(b)
            db.settle(outer, 1)
            db.cell(outer)!.deps.length == 2
        }
        then "a later query's read of the same key is its own dep, never skipped as an earlier reader's" {
            mut db = new_kernel()
            let fam = db.family((arg: int) -> 0)
            let key = Key { family: fam, arg: 0 }
            db.set_input(key, 1)
            let first = Key { family: fam, arg: 1 }
            db.begin(first)
            db.record_dep(key)
            db.settle(first, 1)
            let second = Key { family: fam, arg: 2 }
            db.begin(second)
            db.record_dep(key)
            db.settle(second, 1)
            db.cell(first)!.deps.length == 1 && db.cell(second)!.deps.length == 1
        }
        then "a nested query's read of a shared key does not cost the outer query a second dep" {
            mut db = new_kernel()
            let fam = db.family((arg: int) -> 0)
            let shared = Key { family: fam, arg: 0 }
            db.set_input(shared, 1)
            let outer = Key { family: fam, arg: 1 }
            let nested = Key { family: fam, arg: 2 }
            db.begin(outer)
            db.record_dep(shared)
            db.begin(nested)
            db.record_dep(shared)
            db.settle(nested, 1)
            db.record_dep(shared)
            db.settle(outer, 1)
            db.cell(outer)!.deps.length == 1
        }
        then "two nested levels both reading the shared key unwind their restores in order" {
            mut db = new_kernel()
            let fam = db.family((arg: int) -> 0)
            let shared = Key { family: fam, arg: 0 }
            db.set_input(shared, 1)
            let outer = Key { family: fam, arg: 1 }
            let nested = Key { family: fam, arg: 2 }
            let deeper = Key { family: fam, arg: 3 }
            db.begin(outer)
            db.record_dep(shared)
            db.begin(nested)
            db.record_dep(shared)
            db.begin(deeper)
            db.record_dep(shared)
            db.settle(deeper, 1)
            db.record_dep(shared)
            db.settle(nested, 1)
            db.record_dep(shared)
            db.settle(outer, 1)
            db.cell(outer)!.deps.length == 1 &&
                db.cell(nested)!.deps.length == 1 &&
                db.cell(deeper)!.deps.length == 1
        }
    }
    given "the frame-local last key" {
        then "the outer frame's own last key survives a nested frame reading a different key" {
            mut db = new_kernel()
            let fam = db.family((arg: int) -> 0)
            let shared = Key { family: fam, arg: 0 }
            let other = Key { family: fam, arg: 1 }
            db.set_input(shared, 1)
            db.set_input(other, 2)
            let outer = Key { family: fam, arg: 2 }
            let nested = Key { family: fam, arg: 3 }
            db.begin(outer)
            db.record_dep(shared)
            db.record_dep(shared)
            db.begin(nested)
            db.record_dep(other)
            db.record_dep(other)
            db.settle(nested, 1)
            db.record_dep(shared)
            db.record_dep(shared)
            db.settle(outer, 1)
            db.cell(outer)!.deps.length == 1 && db.cell(nested)!.deps.length == 1
        }
        then "a deeper nested frame's own last key does not leak into any ancestor's, three levels unwinding" {
            mut db = new_kernel()
            let fam = db.family((arg: int) -> 0)
            let shared = Key { family: fam, arg: 0 }
            db.set_input(shared, 1)
            let outer = Key { family: fam, arg: 1 }
            let nested = Key { family: fam, arg: 2 }
            let deeper = Key { family: fam, arg: 3 }
            db.begin(outer)
            db.record_dep(shared)
            db.begin(nested)
            db.record_dep(shared)
            db.begin(deeper)
            db.record_dep(shared)
            db.record_dep(shared)
            db.settle(deeper, 1)
            db.record_dep(shared)
            db.settle(nested, 1)
            db.record_dep(shared)
            db.settle(outer, 1)
            db.cell(outer)!.deps.length == 1 &&
                db.cell(nested)!.deps.length == 1 &&
                db.cell(deeper)!.deps.length == 1
        }
    }
}

spec "relation/engine — typed answers" {
    given "a typed family" {
        then "copies share values and dependency state" {
            let db = new_kernel()
            let family = db.family((arg: int) -> db.changed_at(Key { family: 0, arg: arg }))
            let memo = new_memo<int>(db, family)
            let copy = memo
            let runs = Cell.new(0)
            let first = copy
                .demand(
                    0,
                    () -> {
                        runs.set(runs.get() + 1)
                        21
                    },
                    (v: int) -> v,
                )
            let second = memo
                .demand(
                    0,
                    () -> {
                        runs.set(runs.get() + 1)
                        99
                    },
                    (v: int) -> v,
                )
            first == 21 && second == 21 && runs.get() == 1
        }
        then "a memo's query is open between begin and finish, and not after" {
            let db = new_kernel()
            let family = db.family((arg: int) -> 0)
            let memo = new_memo<int>(db, family)
            let before = memo.open(3)
            memo.begin(3)
            let during = memo.open(3)
            let _ = memo.finish(3, 1, 1)
            !before && during && !memo.open(3)
        }
        then "eviction removes values and kernel reuse together" {
            let db = new_kernel()
            let family = db.family((arg: int) -> db.changed_at(Key { family: 0, arg: arg }))
            let memo = new_memo<int>(db, family)
            let _ = memo.demand(0, () -> 21, (v: int) -> v)
            memo.evict()
            memo.demand(0, () -> 34, (v: int) -> v) == 34
        }
        then "eviction leaves neighboring families intact" {
            let db = new_kernel()
            let left_family = db.family((arg: int) -> 0)
            let right_family = db.family((arg: int) -> 0)
            let left = new_memo<int>(db, left_family)
            let right = new_memo<int>(db, right_family)
            let _ = left.demand(0, () -> 11, (v: int) -> v)
            let _ = right.demand(0, () -> 22, (v: int) -> v)
            left.evict()
            left.demand(0, () -> 33, (v: int) -> v) == 33 &&
                right.demand(0, () -> 44, (v: int) -> v) == 22
        }
    }
}

// A cell's address must never depend on a count that can grow — a
// family registered AFTER others have already written cells must not
// remap a single one of them (avra-8sb5.57.81: a flat, multiplied
// address once did exactly this the moment a later family registered).
spec "relation/engine — the kernel: a family registers without disturbing cells already written" {
    then "an existing family's settled cell answers the same after a new family joins, over many args" {
        mut db = new_kernel()
        let early = db.family((arg: int) -> 0)
        for i in 0..50 {
            db.begin(Key { family: early, arg: i })
            db.settle(Key { family: early, arg: i }, i * 7)
        }
        let before = [db.value_hash_of(Key { family: early, arg: i }) for i in 0..50]
        let _ = db.family((arg: int) -> 0)
        let after = [db.value_hash_of(Key { family: early, arg: i }) for i in 0..50]
        before.all((h: int?) -> h != null) &&
            before.length == after.length &&
            [i for i in 0..50].all((i: int) -> before[i] == after[i])
    }
    then "an existing family's cell still answers Reuse after a new family joins" {
        mut db = new_kernel()
        let early = db.family((arg: int) -> 0)
        let key = Key { family: early, arg: 3 }
        db.begin(key)
        db.settle(key, 9)
        let _ = db.family((arg: int) -> 0)
        db.ask(key) is .Reuse
    }
    then "a relation reached for the first time after other families are busy still answers its own values, never another family's" {
        mut db = new_kernel()
        let busy = db.family((arg: int) -> 0)
        for i in 0..20 {
            db.begin(Key { family: busy, arg: i })
            db.settle(Key { family: busy, arg: i }, i)
        }
        let late = new_memo<int>(db, db.family((arg: int) -> 0))
        late.demand(3, () -> 999, (v: int) -> v) == 999
    }
}

spec "relation/engine — the kernel: an abandoned frame" {
    given "an inner query abandoned inside an outer one" {
        then "keeps no cell for the inner key, and its reads are the outer's" {
            mut db = new_kernel()
            let fam = db.family((arg: int) -> 0)
            let read = Key { family: fam, arg: 0 }
            db.set_input(read, 1)
            let outer = Key { family: fam, arg: 1 }
            let inner = Key { family: fam, arg: 2 }
            db.begin(outer)
            db.begin(inner)
            db.record_dep(read)
            db.abandon(inner)
            db.settle(outer, 1)
            db.cell(inner) == null && db.deps_of(outer).any((k: Key) -> same_key(k, read))
        }
        then "a read the outer already made is still one dep" {
            mut db = new_kernel()
            let fam = db.family((arg: int) -> 0)
            let read = Key { family: fam, arg: 0 }
            db.set_input(read, 1)
            let outer = Key { family: fam, arg: 1 }
            let inner = Key { family: fam, arg: 2 }
            db.begin(outer)
            db.record_dep(read)
            db.begin(inner)
            db.record_dep(read)
            db.abandon(inner)
            db.record_dep(read)
            db.settle(outer, 1)
            db.deps_of(outer).length == 1
        }
        then "asked again, the abandoned key computes" {
            mut db = new_kernel()
            let fam = db.family((arg: int) -> 0)
            let inner = Key { family: fam, arg: 2 }
            db.begin(inner)
            db.abandon(inner)
            db.ask(inner) is .Compute
        }
    }
}

/// A family whose verifier answers each cell's own changed_at.
fn plain_family(db: Kernel) -> int {
    let at: Cell<int> = Cell.new(0)
    let fam = db.family((arg: int) -> db.changed_at(Key { family: at.get(), arg: arg }))
    at.set(fam)
    fam
}

spec "relation/engine — the kernel: an edge is its key, whole" {
    given "keys far apart in family and arg" {
        then "a late family's large arg reads back as itself" {
            mut db = new_kernel()
            let a = plain_family(db)
            let _ = plain_family(db)
            let c = plain_family(db)
            let far = Key { family: c, arg: 300000 }
            db.set_input(far, 7)
            let reader = Key { family: a, arg: 0 }
            db.begin(reader)
            db.record_dep(far)
            db.settle(reader, 1)
            let deps = db.deps_of(reader)
            deps.length == 1 && same_key(deps[0], far)
        }
        then "one arg under two families is two edges" {
            mut db = new_kernel()
            let a = plain_family(db)
            let b = plain_family(db)
            db.set_input(Key { family: a, arg: 3 }, 1)
            db.set_input(Key { family: b, arg: 3 }, 2)
            let reader = Key { family: a, arg: 0 }
            db.begin(reader)
            db.record_at(a, 3)
            db.record_at(b, 3)
            db.record_at(a, 3)
            db.settle(reader, 1)
            let deps = db.deps_of(reader)
            deps.length == 2 &&
                same_key(deps[0], Key { family: a, arg: 3 }) &&
                same_key(deps[1], Key { family: b, arg: 3 })
        }
        then "a thousand reads keep their first-read order" {
            mut db = new_kernel()
            let fam = plain_family(db)
            let reader = Key { family: fam, arg: 0 }
            db.begin(reader)
            for i in 0..1000 { db.record_at(fam, 2000 - i) }
            for i in 0..1000 { db.record_at(fam, 2000 - i) }
            db.settle(reader, 1)
            let deps = db.deps_of(reader)
            deps.length == 1000 && [i for i, d in deps if d.arg != 2000 - i].is_empty()
        }
        then "a key open under one family is no cycle for the same arg under another" {
            mut db = new_kernel()
            let a = plain_family(db)
            let b = plain_family(db)
            db.begin(Key { family: a, arg: 5 })
            let other = db.ask(Key { family: b, arg: 5 })
            let own = db.ask(Key { family: a, arg: 5 })
            db.settle(Key { family: a, arg: 5 }, 0)
            other is .Compute && own is .Cycle
        }
    }
    given "verification over edges of two families" {
        then "a moved dep in the second family recomputes, an unrelated move does not" {
            mut db = new_kernel()
            let a = plain_family(db)
            let b = plain_family(db)
            let left = Key { family: a, arg: 1 }
            let right = Key { family: b, arg: 1 }
            let unrelated = Key { family: b, arg: 2 }
            db.set_input(left, 1)
            db.set_input(right, 1)
            db.set_input(unrelated, 1)
            let reader = Key { family: a, arg: 0 }
            db.begin(reader)
            db.record_dep(left)
            db.record_dep(right)
            db.settle(reader, 1)
            db.set_input(unrelated, 2)
            let stood = db.ask(reader)
            db.set_input(right, 2)
            let moved = db.ask(reader)
            stood is .Reuse && moved is .Compute
        }
    }
}

spec "relation/engine — the kernel: the open stack, attacked" {
    given "stamps under nesting" {
        then "a sibling nested after the first restores the outer's stamp again" {
            mut db = new_kernel()
            let fam = plain_family(db)
            let shared = Key { family: fam, arg: 0 }
            db.set_input(shared, 1)
            let outer = Key { family: fam, arg: 1 }
            let first = Key { family: fam, arg: 2 }
            let second = Key { family: fam, arg: 3 }
            db.begin(outer)
            db.record_dep(shared)
            db.begin(first)
            db.record_dep(shared)
            db.settle(first, 1)
            db.begin(second)
            db.record_dep(shared)
            db.record_dep(shared)
            db.settle(second, 1)
            db.record_dep(shared)
            db.settle(outer, 1)
            db.deps_of(outer).length == 1 &&
                db.deps_of(first).length == 1 &&
                db.deps_of(second).length == 1
        }
        then "a grandchild overwriting the outer's stamp hands it back through the frame between" {
            mut db = new_kernel()
            let fam = plain_family(db)
            let shared = Key { family: fam, arg: 0 }
            db.set_input(shared, 1)
            let outer = Key { family: fam, arg: 1 }
            let middle = Key { family: fam, arg: 2 }
            let inner = Key { family: fam, arg: 3 }
            db.begin(outer)
            db.record_dep(shared)
            db.begin(middle)
            db.begin(inner)
            db.record_dep(shared)
            db.settle(inner, 1)
            db.settle(middle, 1)
            db.record_dep(shared)
            db.settle(outer, 1)
            db.deps_of(outer).length == 1 &&
                db.deps_of(middle).is_empty() &&
                db.deps_of(inner).length == 1
        }
        then "a key the nested frame read last is still the outer's to record" {
            mut db = new_kernel()
            let fam = plain_family(db)
            let outer = Key { family: fam, arg: 1 }
            let nested = Key { family: fam, arg: 2 }
            db.begin(outer)
            db.record_at(fam, 10)
            db.begin(nested)
            db.record_at(fam, 11)
            db.settle(nested, 1)
            db.record_at(fam, 11)
            db.settle(outer, 1)
            ["${d.arg}" for d in db.deps_of(outer)].join(",") == "10,11"
        }
        then "a key the outer read last is the nested frame's to record too" {
            mut db = new_kernel()
            let fam = plain_family(db)
            let outer = Key { family: fam, arg: 1 }
            let nested = Key { family: fam, arg: 2 }
            db.begin(outer)
            db.record_at(fam, 10)
            db.begin(nested)
            db.record_at(fam, 10)
            db.settle(nested, 1)
            db.settle(outer, 1)
            db.deps_of(nested).length == 1 && db.deps_of(outer).length == 1
        }
        then "the reader is the outer's own again once the nested frame closes" {
            mut db = new_kernel()
            let fam = plain_family(db)
            db.begin(Key { family: fam, arg: 1 })
            let outer = db.reader()
            db.begin(Key { family: fam, arg: 2 })
            let nested = db.reader()
            db.settle(Key { family: fam, arg: 2 }, 1)
            let back = db.reader()
            db.settle(Key { family: fam, arg: 1 }, 1)
            outer == back && nested != outer && db.reader() == 0 - 1
        }
    }
    given "an abandoned frame" {
        then "its reads join the outer's in the order it made them, each once" {
            mut db = new_kernel()
            let fam = plain_family(db)
            let outer = Key { family: fam, arg: 0 }
            let inner = Key { family: fam, arg: 1 }
            db.begin(outer)
            db.record_at(fam, 10)
            db.begin(inner)
            db.record_at(fam, 12)
            db.record_at(fam, 10)
            db.record_at(fam, 11)
            db.record_at(fam, 12)
            db.abandon(inner)
            db.record_at(fam, 11)
            db.settle(outer, 1)
            ["${d.arg}" for d in db.deps_of(outer)].join(",") == "10,12,11"
        }
        then "an abandoned frame that overwrote the outer's stamp hands it back" {
            mut db = new_kernel()
            let fam = plain_family(db)
            let outer = Key { family: fam, arg: 0 }
            let inner = Key { family: fam, arg: 1 }
            let after = Key { family: fam, arg: 2 }
            db.begin(outer)
            db.record_at(fam, 10)
            db.begin(inner)
            db.record_at(fam, 10)
            db.abandon(inner)
            db.begin(after)
            db.settle(after, 1)
            db.record_at(fam, 10)
            db.settle(outer, 1)
            db.deps_of(outer).length == 1
        }
        then "the frame around it still settles and is reused" {
            mut db = new_kernel()
            let fam = plain_family(db)
            let outer = Key { family: fam, arg: 0 }
            let inner = Key { family: fam, arg: 1 }
            db.set_input(Key { family: fam, arg: 10 }, 1)
            db.begin(outer)
            db.begin(inner)
            db.record_at(fam, 10)
            db.abandon(inner)
            db.settle(outer, 1)
            db.bump()
            db.ask(outer) is .Reuse && !db.active(outer) && !db.active(inner)
        }
    }
    given "a write while a query is open" {
        then "a query whose input moved mid-flight is recomputed at its next ask" {
            mut db = new_kernel()
            let fam = plain_family(db)
            let input = Key { family: fam, arg: 0 }
            let reader = Key { family: fam, arg: 1 }
            db.set_input(input, 1)
            db.begin(reader)
            db.record_dep(input)
            db.set_input(input, 2)
            db.settle(reader, 1)
            db.ask(reader) is .Compute
        }
        then "a query whose input was set to the same value mid-flight stands" {
            mut db = new_kernel()
            let fam = plain_family(db)
            let input = Key { family: fam, arg: 0 }
            let reader = Key { family: fam, arg: 1 }
            db.set_input(input, 1)
            db.begin(reader)
            db.record_dep(input)
            db.set_input(input, 1)
            db.settle(reader, 1)
            db.ask(reader) is .Reuse
        }
        then "an outer query settles at its own beginning, not at a nested one's" {
            mut db = new_kernel()
            let fam = plain_family(db)
            let input = Key { family: fam, arg: 0 }
            let outer = Key { family: fam, arg: 1 }
            let nested = Key { family: fam, arg: 2 }
            db.set_input(input, 1)
            db.begin(outer)
            db.record_dep(input)
            db.set_input(input, 2)
            db.begin(nested)
            db.record_dep(input)
            db.settle(nested, 1)
            db.settle(outer, 1)
            let inner_stands = db.ask(nested)
            db.ask(outer) is .Compute && inner_stands is .Reuse
        }
    }
    given "a cycle through two keys" {
        then "the far key is a cycle from inside, and both stand after" {
            mut db = new_kernel()
            let fam = plain_family(db)
            let a = Key { family: fam, arg: 0 }
            let b = Key { family: fam, arg: 1 }
            db.begin(a)
            db.begin(b)
            let back = db.ask(a)
            db.settle(b, 1)
            db.settle(a, 1)
            let a_again = db.ask(a)
            let b_again = db.ask(b)
            back is .Cycle &&
                a_again is .Reuse &&
                b_again is .Reuse &&
                same_key(db.deps_of(b)[0], a)
        }
        then "a family is in flight only while one of its keys is open" {
            mut db = new_kernel()
            let a = plain_family(db)
            let b = plain_family(db)
            db.begin(Key { family: b, arg: 4 })
            let during = db.family_active(b) && !db.family_active(a)
            db.settle(Key { family: b, arg: 4 }, 1)
            during && !db.family_active(b)
        }
        then "a family's stamp row only grows: read once, it is read through a sweep, an eviction and a disarm" {
            mut db = new_kernel()
            let cells = plain_family(db)
            let queries = plain_family(db)
            let before = db.read_any(cells)
            db.begin(Key { family: queries, arg: 0 })
            db.record_at(cells, 3)
            db.settle(Key { family: queries, arg: 0 }, 1)
            db.bump()
            db.sweep()
            db.evict_family(cells)
            db.evict_family(queries)
            db.disarm()
            !before && db.read_any(cells)
        }
    }
}
