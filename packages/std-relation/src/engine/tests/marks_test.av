// A key's mark: 0 until marked, then what was marked, apart from every other key.
use @std.relation.engine.{Key, no_key_marks}

spec "relation/engine — key marks" {
    then "a key never marked reads 0, in a family never touched too" {
        no_key_marks().mark_of(Key { family: 3, arg: 9 }) == 0
    }
    then "a mark reads back, and its neighbours in either axis stay 0" {
        let m = no_key_marks()
        m.mark(Key { family: 2, arg: 5 }, 7)
        m.mark_of(Key { family: 2, arg: 5 }) == 7 &&
            m.mark_of(Key { family: 2, arg: 4 }) == 0 &&
            m.mark_of(Key { family: 1, arg: 5 }) == 0
    }
    then "a copy of the marks is the same marks" {
        let m = no_key_marks()
        let n = m
        n.mark(Key { family: 0, arg: 0 }, 1)
        m.mark_of(Key { family: 0, arg: 0 }) == 1
    }
}
