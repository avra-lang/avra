//! `@query` — a fn over a Db whose answer is kept per call. Its written
//! body moves behind a wrapper (WRAP): a call is a CELL of the Db's
//! kernel, named by its arguments' encoding, so its answer stands while
//! everything it read stands and is computed again when one of them
//! moves. The body writes no rows of its own: an insert there is refused,
//! and rows it produces are handed to a named owner as a value
//! (`Rel.replaced`).
//!
//! A kept answer OUTLIVES THE PROCESS where the Db's owner keeps it
//! (`durable_db`): a call no answer here stands for asks the owner for
//! its record, by the query's durable name, its code's hash (`code_hash`:
//! an edit to anything the body reaches reads no old record) and the
//! arguments' hash, and a run that wrote no rows hands its answer over.
//! An answer whose kind does not read back stays in the process.
//!
//! The first seat is the `Db`, or a CONTEXT that answers one through
//! `query_db()` — a call over a context reads what the context holds, so
//! its answer stays in the process (`saved`), re-asked whenever a read it
//! recorded moves. A dense id (`@dense`) is a seat in the process too.
//!
//! Two marks shape a query's cell. `@digested_by(f)` names the fn its
//! answer is digested by — what its readers cut off on — where the
//! answer's own fold would read more than the readers do.
//! `@recursive` lets a call re-entered before it settles compute again,
//! a smaller view, where a plain query answers the cycle with the value
//! it last held. A body that cannot finish its answer says so with
//! `db.unkept()`: the answer reaches its asker and no cell holds it.
//!
//!     @query
//!     fn open_for(db: Db, owner: string) -> int { … }
//!
//! `@over(lister)` rides on a PRODUCER — a query keyed by one value:
//! it implies the `@query` and adds `<name>_listed(db)`, the producer
//! asked once per key the lister answers. "Those asked so far" is never
//! the lister, so a reader can bring every producer up to date.
use @std.meta.{
    Fn,
    Param,
    Kind,
    Annotation,
    Directive,
    Declared,
    Diagnostic,
    Decls,
    Code,
    Stmts,
    name,
    wrapped,
    literal,
    as_code,
    bool_node,
    refuse_as_at,
    code_hash,
}
use db.{Db, Answers, answers, KeptRecord, code_keyed, DenseNames}
use @std.text.{ascii_lower}
use stable.{
    stable_hasher,
    text_hash,
    hashed_opt,
    hashed_list,
    StableHasher,
    written_opt,
    written_list,
    written_all,
    read_opt,
    read_list,
    tagged,
    spelled_with,
    Writer,
    Reader,
}

/// What a query's answer codec calls its helpers on: the answer's own name, every record inline.
fn answer_owner(f: Fn) -> Owner { own_of(f.answer) }

/// `@query`: the wrapper and the query's contract, from one reading.
export fn query(f: Fn) -> Declared {
    let problems = query_problems(f)
    if !problems.is_empty() { return nothing_made(problems) }
    let kept = kept_name(f)
    Declared {
        made: [
            Directive { twin: "", name: kept, at: f.at, source: kept_source(f, kept) },
            Directive { twin: "", name: f.name, at: f.at, wraps: true, source: wrapper(f) },
        ],
        problems: [],
    }
}

/// Where a query's answers are kept: a dense-keyed one is named past the process only by its
/// context's speller (`named_by`).
fn kept_source(f: Fn, kept: string) -> Decls {
    quote {
        once fn ${kept}() -> Answers<${f.answer}> {
            answers(${literal(durable_name(f))}, ${literal(f.name)}, ${as_code(bool_node(keyed_densely(f)))})
        }
    }
}

/// Whether a call is keyed by a dense number of the process's own.
fn keyed_densely(f: Fn) -> bool { f.params.slice(1, f.params.length).any(dense_field(it.kind) != null) }

/// A DENSE KEY NAMED PAST THE PROCESS: a query of one dense seat, asked through a context,
/// names its calls by the context's own speller for that seat's type —
/// `<type>_spelled(id) -> string?` and `<type>_numbered(spelled) -> <type>?` — set by its first
/// call. A missing speller is the ordinary refusal at the generated site.
fn named_by(f: Fn) -> List<Stmts> {
    if f.params.length != 2 || is_db(f.params[0].kind) { return [] }
    let seat = f.params[1]
    let field? = dense_field(seat.kind) else { return [] }
    let ctx = name(f.params[0].name)
    let stem = snake_of(seat.ty)
    let id = quote { ${seat.ty} { ..${[quote { W { ${field}: n } }]} } }
    [
        quote {
            if !held.durably_named() {
                held.durable_by(
                    DenseNames {
                        spell: (n: int) -> ${ctx}.${"${stem}_spelled"}(${id}),
                        number: (s: string) -> ${ctx}.${"${stem}_numbered"}(s)?.${field},
                        ask: (n: int) -> {
                            let _ = ${f.name}(${ctx}, ${id})
                        },
                    },
                )
            }
        },
    ]
}

/// A type's name in snake case: `DeclId` is `decl_id`.
fn snake_of(ty: string) -> string {
    mut out = ""
    for j in 0..ty.length {
        let c = ty.substring(j, j + 1)
        let lower = ascii_lower(c)
        out = if j > 0 && lower != c { "${out}_${lower}" } else { "${out}${lower}" }
    }
    out
}

/// The reader a record answer needs, bound beside the call: a TYPED LET
/// PINS A LAMBDA'S ANSWER where a seat does not, and a `?` inside an
/// inferred answer has no door to carry its failure through.
fn answer_reader(f: Fn) -> List<Stmts> {
    if !record_answer(f.answers) { return [] }
    match f.answers {
        .Named(ty, _) -> match named_shape(ty) {
            .Record(fs) -> record_reader_let(reader_name(f), ty, f.answer, fs),
            rest -> [],
        },
        rest -> [],
    }
}

/// The answer read back: a record's own binding, every other kind's
/// lambda.
fn answer_read(f: Fn) -> Code {
    if !record_answer(f.answers) { return read_each(f.answers, answer_owner(f)) }
    name(reader_name(f))
}

/// The name a record answer's reader is bound under.
fn reader_name(f: Fn) -> string { "${f.name}_reader" }

/// `@over(lister)`: a `@query` whose calls are LISTED by `lister`, so
/// the producer drives every key a reader has not asked yet — "those
/// asked so far" is never the answer. It generates the query, the
/// `Db`-less twin and the wrapper a `@query` does, PLUS
/// `<name>_listed(db)`: the lister asked for its keys, then the producer
/// once per key, in listed order.
///
///     @over(icon_dirs)
///     fn icons_in(db: Db, dir: string) -> List<Icon> { … }
///
///     @query
///     fn icon_dirs(db: Db) -> List<string> { … }
///
/// `icons_in_listed(db)` answers every row the listed producers own,
/// flattened in listed order — the same set a read of the relation
/// enumerates. A lister takes the `Db` alone and answers `List<K>` for
/// the producer's one key seat; the producer answers the rows (`List<R>`)
/// its key owns.
export fn over(f: Fn, lister: Fn) -> Declared {
    let base = query(f)
    if !base.problems.is_empty() { return base }
    let problems = over_problems(f, lister)
    if !problems.is_empty() { return nothing_made(problems) }
    Declared {
        made: base
            .made
            .concat(
                [
                    Directive {
                        twin: "",
                        name: listed_name(f),
                        at: f.at,
                        source: listed_source(f, lister),
                    },
                ],
            ),
        problems: [],
    }
}

/// Every way a listing breaks its law: a producer that takes no single
/// key, a lister that is no query over the Db alone, a lister whose
/// answer is not the producer's keys.
export fn over_problems(f: Fn, lister: Fn) -> List<Diagnostic> {
    if f.annotations.any((a: Annotation) -> a.name == "query") { return [over_beside_query(f)] }
    let first? = f.params.first() else { return [over_no_db(f)] }
    if !is_db(first.kind) { return [over_no_db(f)] }
    if f.params.length != 2 { return [over_one_key(f)] }
    if !is_list(f.answers) { return [over_rows(f)] }
    let seats = lister.params
    if seats.length != 1 || !is_db(seats[0].kind) { return [over_lister_db(f, lister)] }
    if lister.answer != "List<${f.params[1].ty}>" { return [over_lister_list(f, lister)] }
    []
}

/// The fn a listing generates: the producer asked once per listed key.
fn listed_name(f: Fn) -> string { "${f.name}_listed" }

fn listed_source(f: Fn, lister: Fn) -> Decls {
    let db = f.params[0].name
    let key = f.params[1].name
    quote {
        export fn ${listed_name(f)}(${db}: Db) -> ${f.answer} {
            [row for k in ${lister.name}(${name(db)}) for row in ${f.name}(${name(db)}, k)]
        }
    }
}

/// A declaration that makes nothing, carrying the refusals it spoke —
/// the one shape every refusal here answers.
fn nothing_made(problems: List<Diagnostic>) -> Declared { Declared { made: [], problems: problems } }

/// Every way a fn breaks the query law: a first seat that is no `Db`, an
/// argument or an answer with no stable encoding, and a record or payload
/// enum named there whose type declares no codec.
export fn query_problems(f: Fn) -> List<Diagnostic> {
    let first? = f.params.first() else { return [no_db(f)] }
    if !seated(first.kind) { return [no_db(f)] }
    let args = [arg_not_carried(f, p) for p in f.params.slice(1, f.params.length) if !asked_by(p.kind)]
    let answer = if carried(f.answers, in_process) || digest_word(f) != null { [] } else { [answer_not_carried(f)] }
    let seats = args.concat(answer)
    if !seats.is_empty() { return seats }
    codec_problems(f)
}

/// A query's first seat: the `Db`, or a context that answers one through `query_db()`.
fn seated(k: Kind) -> bool { match k { .Named(_, _) -> true, rest -> false } }

/// The `Db` a call is kept under, read off its first seat.
fn db_code(f: Fn) -> Code {
    let first = name(f.params[0].name)
    if is_db(f.params[0].kind) { first } else { quote { ${first}.query_db() } }
}

/// Whether an argument can name a call: a stable encoding, or a dense id the process spells.
fn asked_by(k: Kind) -> bool { carried(k, named_shape) || dense_field(k) != null }

/// A dense id's one field, none for any other kind.
fn dense_field(k: Kind) -> string? {
    match k {
        .Named(n, _) -> match named_shape(n) { .Dense(field) -> field, rest -> null },
        rest -> null,
    }
}

/// A seat as a number, when it is one: an int's own, a dense id's.
fn numbered(p: Param) -> Code? {
    if p.kind is .Int { return name(p.name) }
    let field? = dense_field(p.kind) else { return null }
    quote { ${name(p.name)}.${field} }
}

/// A shape as the process hashes it: a dense id is its number.
fn in_process(n: string) -> NamedShape {
    let shape = named_shape(n)
    match shape { .Dense(_) -> NamedShape.Tagged([]), rest -> shape }
}

/// `@digested_by(f)`: the fn a query's answer is digested by — one seat of the answer, an int out.
export fn digested_by(f: Fn, by: Fn) -> List<Diagnostic> {
    if by.params.length != 1 || by.params[0].ty != f.answer || by.answer != "int" { return [digest_shape(f, by)] }
    if !queried(f) { return [mark_alone(f, "digested_by")] }
    []
}

/// `@recursive`: a call re-entered before it settles computes again — the smaller view.
export fn recursive(f: Fn) -> List<Diagnostic> { if queried(f) { [] } else { [mark_alone(f, "recursive")] } }

/// Whether a fn is a query.
fn queried(f: Fn) -> bool { f.annotations.any((a: Annotation) -> a.name == "query" || a.name == "over") }

/// The fn a query's answer is digested by, when it names one.
fn digest_word(f: Fn) -> string? {
    let mark? = f.annotations.find((a: Annotation) -> a.name == "digested_by") else { return null }
    mark.args.first()
}

/// The answer's digest: the named fn, else the answer's own fold.
fn digest_code(f: Fn) -> Code {
    let by? = digest_word(f) else { return answer_hash(f) }
    name(by)
}

/// How a call opens: a recursive query computes again on re-entry.
fn opened(f: Fn) -> Code {
    if f.annotations.any((a: Annotation) -> a.name == "recursive") { quote { held.memo.start_recursive(arg) } } else { quote { held.memo.start(arg) } }
}

/// THE DURABILITY LAW: an answer outlives the process exactly when every read it makes is
/// recorded and its key names the same call in the next one — the `Db` alone as its first
/// seat, every argument a stable encoding, an answer that reads back. Nothing declares it.
fn saved(f: Fn) -> bool {
    is_db(f.params[0].kind) &&
        f.params.slice(1, f.params.length).all((p: Param) -> carried(p.kind, named_shape)) &&
        decodable(f.answers)
}

/// A record and a payload enum are called by name on the way through a query — hashed for the
/// cell, written and read for the record — so the type must hold its own codec. `@codec` is
/// opt-in: nothing else gives a type one.
fn codec_problems(f: Fn) -> List<Diagnostic> {
    let args = [arg_needs_codec(f, p) for p in f.params.slice(1, f.params.length) if !codec_declared(p.kind, [])]
    let answer = if codec_declared(f.answers, []) { [] } else { [answer_needs_codec(f)] }
    args.concat(answer)
}

/// The signature law `@query` and `@input` (input.av) share: a `Db`
/// first, then arguments and an answer that each fold through the
/// stable encoding. Each directive names its own three voices, so a
/// refusal reads as ITS law, never a borrowed one. A SEAT NAMED LIKE A
/// DECLARATION IN ITS OWN FILE CALLS THE DECLARATION: this file also
/// declares top-level `no_db`/`arg_not_carried`/`answer_not_carried`,
/// so these seats are spelled `voice_*` to stay distinct from them —
/// under the shadowing names, every call here answered `@query`'s own
/// words regardless of which fn a caller passed.
export fn seat_problems(
    f: Fn,
    voice_no_db: fn(Fn) -> Diagnostic,
    voice_arg: fn(Fn, Param) -> Diagnostic,
    voice_answer: fn(Fn) -> Diagnostic,
) -> List<Diagnostic> {
    let first? = f.params.first() else { return [voice_no_db(f)] }
    if !is_db(first.kind) { return [voice_no_db(f)] }
    let args = [voice_arg(f, p) for p in f.params.slice(1, f.params.length) if !carried(p.kind, named_shape)]
    let answer = if carried(f.answers, named_shape) { [] } else { [voice_answer(f)] }
    args.concat(answer)
}

fn is_db(k: Kind) -> bool {
    match k { .Named(n, _) -> n == "Db", rest -> false }
}

/// Whether a query's answer is a plain list — the rows a listing collects.
/// A nullable list is not one: the rows are never absent.
fn is_list(k: Kind) -> bool { match k { .List(_) -> true, rest -> false } }

/// The fn holding a query's kept answers.
fn kept_name(f: Fn) -> string { "${f.name}_answers" }

/// The wrapper under the written name: a lasting one when the answer
/// reads back.
fn wrapper(f: Fn) -> Decls {
    let seats = [quote { fn _(${p.name}: ${p.ty}) {} } for p in f.params]
    let args = [name(p.name) for p in f.params]
    let db = db_code(f)
    let body = quote { () -> ${wrapped(f)}(${..args}) }
    let again = quote { () -> ${f.name}(${..args}) }
    if saved(f) {
        let record = quote { KeptRecord { query: code_keyed(${literal(durable_name(f))}, code_hash(${name(wrapped(f).name)})), args: ${args_hash(f)}, write: ${write_each(f.answers, answer_owner(f))}, read: ${answer_read(f)} } }
        return quote {
            fn ${f.name}(..${seats}) -> ${f.answer} {
                let held = ${kept_name(f)}().under(${db})
                ${named_by(f)}
                let arg = ${arg_code(f)}
                match ${opened(f)} {
                    .Reuse(value) -> value,
                    .Compute -> {
                        ${answer_reader(f)}
                        let spelled = ${args_spelled(f)}
                        held.ran_lasting(${db}, arg, spelled, ${body}, ${again}, ${digest_code(f)}, ${record})
                    },
                }
            }
        }
    }
    quote {
        fn ${f.name}(..${seats}) -> ${f.answer} {
            let held = ${kept_name(f)}().under(${db})
            ${named_by(f)}
            let arg = ${arg_code(f)}
            match ${opened(f)} {
                .Reuse(value) -> value,
                .Compute -> held.ran(${db}, arg, ${body}, ${again}, ${digest_code(f)}),
            }
        }
    }
}

/// A call's arguments as text no other arguments spell: each written in
/// order through the codec, the octets spelled out. What a call's cell
/// is interned by — never a hash, which two calls may share.
export fn args_spelled(f: Fn) -> Code {
    let writes = [quote { (w: Writer) -> ${seat_written(p, answer_owner(f))} } for p in f.params.slice(1, f.params.length)]
    quote { spelled_with([${..writes}]) }
}

/// One seat written: a number as its number, any other kind through the codec.
fn seat_written(p: Param, owner: Owner) -> Code {
    let n? = numbered(p) else { return written(quote { w }, name(p.name), p.kind, owner) }
    quote { w.int(${n}) }
}

/// The dense arg a call is asked under: a lone numbered seat's own number, else its spelled
/// arguments.
fn arg_code(f: Fn) -> Code {
    let n? = lone_number(f) else { return quote { held.arg(${args_spelled(f)}) } }
    quote { held.int_arg(${n}) }
}

/// A query's one argument as a number, when it has one and it is one.
fn lone_number(f: Fn) -> Code? {
    if f.params.length != 2 { return null }
    numbered(f.params[1])
}

/// The answer's own stable hash, one value folded alone.
export fn answer_hash(f: Fn) -> Code {
    quote { (v: ${f.answer}) -> ${hashed(quote { stable_hasher(0) }, quote { v }, f.answers, answer_owner(f))}.finish() }
}

/// The name a query's answers are kept under past the process: its
/// name and every seat's and the answer's spelling, so a changed
/// signature never reads an old record.
fn durable_name(f: Fn) -> string { "${f.name}(${[p.ty for p in f.params].join(",")}) -> ${f.answer}" }

/// A call's arguments folded in order through the stable encoding, the
/// query's own name the seed — two queries never share a cell.
fn args_hash(f: Fn) -> Code {
    mut acc: Code = quote { stable_hasher(${text_hash(f.name)}) }
    for p in f.params.slice(1, f.params.length) { acc = hashed(acc, name(p.name), p.kind, answer_owner(f)) }
    quote { ${acc}.finish() }
}

// ── voices ──

fn no_db(f: Fn) -> Diagnostic {
    refuse_as_at(
        "query_db",
        f.at,
        "`@query fn ${f.name}` takes the `Db` its answer is kept under, or a context answering it through `query_db()`, as its first seat",
        "write `fn ${f.name}(db: Db, …)`",
    )
}

fn over_beside_query(f: Fn) -> Diagnostic {
    refuse_as_at(
        "over_query",
        f.at,
        "`@over` is already a `@query`, so `${f.name}` wears it once",
        "drop the `@query` — `@over(lister)` generates the query and its listing together",
    )
}

fn over_no_db(f: Fn) -> Diagnostic {
    refuse_as_at(
        "over_db",
        f.at,
        "`@over` lists a producer's keys, so `${f.name}` takes the `Db` it is asked under first",
        "write `fn ${f.name}(db: Db, key: K)`",
    )
}

fn over_one_key(f: Fn) -> Diagnostic {
    refuse_as_at(
        "over_key",
        f.at,
        "`@over` lists a producer's keys, so `${f.name}` takes the `Db` and one key",
        "write `fn ${f.name}(db: Db, key: K)` and list the keys with `List<K>`",
    )
}

fn over_lister_db(f: Fn, lister: Fn) -> Diagnostic {
    refuse_as_at(
        "over_lister",
        lister.at ?? f.at,
        "the lister `${lister.name}` answers `${f.name}`'s keys, so it takes the `Db` and nothing else",
        "write `fn ${lister.name}(db: Db) -> List<K>`",
    )
}

fn over_lister_list(f: Fn, lister: Fn) -> Diagnostic {
    refuse_as_at(
        "over_lister_answer",
        lister.at ?? f.at,
        "the lister `${lister.name}` answers `${lister.answer}`, and `${f.name}`'s key is `${f.params[1].ty}`",
        "answer `List<${f.params[1].ty}>` — the producer's own key type",
    )
}

fn over_rows(f: Fn) -> Diagnostic {
    refuse_as_at(
        "over_rows",
        f.at,
        "a listing collects the rows its producers own, so `${f.name}` answers a plain `List<R>`, this is `${f.answer}`",
        "answer `List<R>` — the rows its key owns",
    )
}

fn digest_shape(f: Fn, by: Fn) -> Diagnostic {
    refuse_as_at(
        "query_digest",
        by.at ?? f.at,
        "`${by.name}` digests `${f.name}`'s answer, so it takes one `${f.answer}` and answers an `int`",
        "write `fn ${by.name}(v: ${f.answer}) -> int`",
    )
}

fn mark_alone(f: Fn, mark: string) -> Diagnostic {
    refuse_as_at(
        "query_mark",
        f.at,
        "`@${mark}` shapes a query's cell, and `${f.name}` is no query",
        "write `@query` over `${f.name}`",
    )
}

fn arg_not_carried(f: Fn, p: Param) -> Diagnostic {
    refuse_as_at(
        "query_arg",
        p.at ?? f.at,
        "`${f.name}`'s seat `${p.name}` is `${p.ty}`, which has no stable encoding — a query's call is named by its arguments' hash",
        "take an int, a bool, a string, a tagged enum, a dense id or a nested record of those",
    )
}

fn arg_needs_codec(f: Fn, p: Param) -> Diagnostic {
    refuse_as_at(
        "query_arg_codec",
        p.at ?? f.at,
        "`${f.name}`'s seat `${p.name}` is `${p.ty}`, which a query hash and record call by name — its type declares no codec",
        "annotate `${p.ty}` `@codec`, which gives it the write, read and hash a query calls",
    )
}

fn answer_needs_codec(f: Fn) -> Diagnostic {
    refuse_as_at(
        "query_answer_codec",
        f.at,
        "`${f.name}` answers `${f.answer}`, which a query hash and record call by name — its type declares no codec",
        "annotate `${f.answer}` `@codec`, which gives it the write, read and hash a query calls",
    )
}

fn answer_not_carried(f: Fn) -> Diagnostic {
    refuse_as_at(
        "query_answer",
        f.at,
        "`${f.name}` answers `${f.answer}`, which has no stable encoding — a query's answer is kept and compared by its hash",
        "answer an int, a bool, a string, a tagged enum or a nested record of those",
    )
}
