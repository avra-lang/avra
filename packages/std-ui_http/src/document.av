//! `@std/ui_http` — a `Document` is a titled view; answered from a route,
//! it is the page `@std/ui` draws for it. Given a `module`, the page runs
//! that web app over the HTML it holds, adopting it rather than drawing
//! again, and names every file it fetches so they are all asked for as the
//! document arrives. `app_page` is the document a server is TOLD to serve —
//! by `avra dev`, or by whatever deploys a built page: the one door both go
//! through.
//!
//!     server site {
//!         port: 8080
//!         get "/" { _req -> Document { title: "Home", body: home() } }
//!     }
use @std.http_message.message.{Header}
use @std.http.{Response, Respond}
use @std.ui.realize.html.html.{Page, page, takeover}
use @std.ui.shipped.{carried}
use @std.ui.tree.view.{View, tree_of}
use @std.io.{env_or}

/// A titled view. Answered by a handler, it is a `text/html` page of
/// its status. `fetched` is every file the page fetches.
export type Document = {
    title: string,
    body: dyn View,
    status: int = 200,
    module: string = "",
    host: string = "/avra",
    fetched: List<string> = [],
}

/// THE WEB APP'S PAGE as this server was told to serve it: the module it
/// runs (`AVRA_PAGE_MODULE`), where the host's scripts stand
/// (`AVRA_PAGE_HOST`) and every file the page fetches (`AVRA_PAGE_FETCHED`,
/// space-separated). A server told none answers the page with no script.
export fn app_page(title: string, body: dyn View) -> Document {
    Document {
        title: title,
        body: body,
        module: env_or("AVRA_PAGE_MODULE", ""),
        host: env_or("AVRA_PAGE_HOST", "/avra"),
        fetched: [f for f in env_or("AVRA_PAGE_FETCHED", "").split(" ") if f != ""],
    }
}

impl Respond for Document {
    fn response() -> Response {
        let shown = Page { title: self.title }
        let root = tree_of(self.body)
        html_response(
            self.status,
            if self.module == "" { page(shown, root) } else { takeover(shown, root, self.module, self.host, carried(), self.fetched) },
        )
    }
}

/// A full page as a response of this status.
export fn html_response(status: int, document: string) -> Response {
    Response {
        status: status,
        headers: [Header { name: "content-type", value: "text/html; charset=utf-8" }],
        body: document.bytes(),
    }
}
