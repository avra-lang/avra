//! `@std/ui_http` — a `Document` is a titled view; answered from a route,
//! it is the page `@std/ui` draws for it, with no script.
//!
//!     server site {
//!         port: 8080
//!         get "/" { _req -> Document { title: "Home", body: home() } }
//!     }
use @std.http.{Response, Header, Respond}
use @std.ui.realize.html.html.{Page, page}
use @std.ui.tree.view.{View}

/// A titled view. Answered by a handler, it is a `text/html` page of
/// its status.
export type Document = { title: string, body: dyn View, status: int = 200 }

impl Respond for Document {
    fn response() -> Response { html_response(self.status, page(Page { title: self.title }, self.body.describe())) }
}

/// A full page as a response of this status.
export fn html_response(status: int, document: string) -> Response {
    Response {
        status: status,
        headers: [Header { name: "content-type", value: "text/html; charset=utf-8" }],
        body: document.bytes(),
    }
}
