// A Screen answers a text/html page carrying its title and its body.
use @std.http.{Respond}
use @std.ui.components.{column, heading, text}
use @std.ui.realize.view.{View}
use @std.ui_http.{Screen, html_response}

fn home() -> dyn View {
    column {
        heading "Boards"
        text "Hello"
    }
}

fn document(title: string) -> string { Screen { title: title, body: home() }.response().body.text() ?? "" }

spec "a screen answered over HTTP" {
    given "a screen" {
        then "it answers 200 text/html" {
            let r = Screen { title: "Home", body: home() }.response()
            r.status == 200 && r.headers[0].value == "text/html; charset=utf-8"
        }
        then "the document carries the title, escaped, and the body" {
            document("Home <1>").contains("<title>Home &lt;1&gt;</title>") &&
                document("x").contains("<h1>Boards</h1>")
        }
        then "the document carries no script" { !document("x").contains("<script") }
        then "a screen may answer another status" {
            Screen { title: "Gone", body: home(), status: 404 }.response().status == 404
        }
        then "a status rides a document unchanged" { html_response(404, "<p>gone</p>").body.text() == "<p>gone</p>" }
    }
}
