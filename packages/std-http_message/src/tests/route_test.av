use route.{Routes, routes_at}

fn served() -> Routes<int> { routes_at("/tasks") }

fn at(base: string) -> Routes<int> { routes_at(base) }

spec "std/http_message routes" {
    given "a base that is not the plain path" {
        then "a trailing slash names the same doors" {
            at("/tasks/").list.path == "/tasks" && at("/tasks/").find.path == "/tasks/{id}"
        }
        then "the root serves its collection at the slash and a row under it" {
            at("/").list.path == "/" && at("/").create.path == "/" && at("/").find.path == "/{id}"
        }
        then "no base is the root" { at("").list.path == "/" && at("").update.path == "/{id}" }
    }
    given "the doors of a model served at a path" {
        then "the collection is at the path" { served().list.path == "/tasks" && served().create.path == "/tasks" }
        then "a row is at the path and its key" { served().find.path == "/tasks/{id}" && served().remove.path == "/tasks/{id}" }
        then "each is served by its own method" {
            served().list.method is .Get &&
                served().create.method is .Post &&
                served().update.method is .Patch &&
                served().remove.method is .Delete
        }
    }
}
