use message.{Method}
use route.{Nothing, Route, Routes}

/// A model whose mount left out everything but a read.
fn read_only() -> Routes<int> {
    let list: Route<Nothing, List<int>> = Route { method: Method.Get, path: "/tasks" }
    let none_list: Route<Nothing, List<int>>? = list
    let no_key: Route<int, int>? = null
    let no_row: Route<int, Nothing>? = null
    let no_write: Route<int, int>? = null
    let no_nothing: Route<Nothing, Nothing>? = null
    Routes {
        list: none_list,
        find: no_key,
        create: no_write,
        update: no_write,
        remove: no_row,
        trash: none_list,
        restore: no_key,
        events: no_nothing,
    }
}

spec "std/http_message routes" {
    given "a descriptor of one door" {
        then "carries its method and path, and the others are absent" {
            let r = read_only()
            r.list!.path == "/tasks" && r.list!.method is .Get && r.find == null && r.remove == null
        }
    }
}
