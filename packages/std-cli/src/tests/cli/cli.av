// proves: @std/cli end to end, evaluated and native alike — an app
// declared as components, its help rendered, a line parsed into flags, an
// option, positionals and a variadic's rest, each refusal in its own
// words, and a command run to its verdict. Refusals are read as values
// here, since stderr is not the answer.
use @std.cli.{cli, command, flag, option, arg, Runnable, CliResult, CliError, parse, command_help}

type Greet = {}

impl Runnable for Greet {
    fn run(args: CliResult) -> int {
        let loud = args.has_flag("loud")
        let who = args.arg("name")
        println(if loud { "HELLO ${who}!" } else { "hello ${who} (${args.option("times")} times)" })
        args.args_of("extras").length
    }
}

fn said(r: Result<CliResult, CliError>) -> string {
    match r {
        .Ok(p) -> "ok ${p.command}",
        .Err(e) -> e.describe().message,
    }
}

command greet {
    description: "Say hello"
    flag loud {
        short: "-L"
        description: "shout"
    }
    option times {
        description: "how often"
        default: "1"
    }
    arg name {
        description: "who to greet"
        required: true
    }
    arg extras {
        description: "more names"
        variadic: true
    }
    run: Greet {}
}
cli hi {
    description: "Greetings"
    version: "0.1"
    greet
}
println(command_help(hi, greet))
println("--")
println("${hi.run_argv(["greet", "ada"])}")
println("${hi.run_argv(["greet", "-L", "bob", "carol", "dan"])}")
println("${hi.run_argv(["greet", "--times=3", "eve"])}")
println("${hi.run_argv(["--version"])}")
println(said(parse(hi, ["greet"])))
println(said(parse(hi, ["greet", "--quiet", "x"])))
println(said(parse(hi, ["wave"])))
"done"
