// builds: a fold's seed with no type of its own (`[]`, `null`) takes the type its seat says the
// fold answers.
fn doubled(xs: List<int>) -> List<int> { xs.fold([], (acc, x) -> acc.concat([x * 2])) }

fn largest(xs: List<int>) -> int? { xs.fold(null, (acc, x) -> if acc ?? x > x { acc } else { x }) }

fn kept(xs: List<int>) -> int {
    let evens: List<int> = xs.fold([], (acc, x) -> if x % 2 == 0 { acc.concat([x]) } else { acc })
    evens.length
}

println("${doubled([1, 2, 3]).length} ${largest([3, 9, 4]) ?? 0} ${kept([1, 2, 3, 4])}")
