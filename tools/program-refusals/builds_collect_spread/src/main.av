// proves: a list a `collect` keeps joins it element by element, each boxed into the `dyn` element its seat wants, and a list of a list's elements keeps its lists whole
trait Shown {
    fn say() -> string
}

type Word = { text: string }

impl Shown for Word {
    fn say() -> string { self.text }
}

fn shown(names: List<string>) -> List<dyn Shown> {
    collect {
        Word { text: "<" }
        [w for n in names for w in [Word { text: n }, Word { text: "${n}!" }]]
        Word { text: ">" }
    }
}

fn rows(names: List<string>) -> List<List<string>> {
    collect {
        names
        [n for n in names]
    }
}

println("${[s.say() for s in shown(["a", "b"])].join(" ")} ${rows(["x", "y"]).length}")
