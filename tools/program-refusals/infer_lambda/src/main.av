// builds: a `?` inside a lambda nested in a `_` fn counts toward that fn's set, so a total catch
// names both members.
enum A { A(n: int) }
enum B { B(n: int) }
fn inner(k: int) -> Result<int, B> {
    if k == 0 { fail B.B(0) }
    k
}
fn outer(k: int) -> Result<int, _> {
    let f: fn(int) -> Result<int, B> = (j) -> {
        let v = inner(j)?
        v
    }
    if k == 1 { fail A.A(1) }
    k
}
fn read(k: int) -> int {
    outer(k) catch {
        .A(e) -> 1
        .B(e) -> 2
    }
}
println("${read(1)} ${read(3)}")
