type P = { x: int, y: int }

type Q = { x: int }

fn other(q: Q) -> int {
    match q {
        P { x, .. } -> x,
    }
}

fn fieldless(p: P) -> int {
    match p {
        P { z, .. } -> z,
    }
}

fn twice(p: P) -> int {
    match p {
        P { x, x: 1, .. } -> x,
        _ -> 0,
    }
}

fn unlisted(p: P) -> int {
    match p {
        P { x } -> x,
    }
}

fn after_rest(p: P) -> int {
    match p {
        P { .., x } -> x,
    }
}

fn rests(p: P) -> int {
    match p {
        P { x, .., .. } -> x,
    }
}

fn apart(p: P) -> int {
    let P { x } = p
    x
}

println("${apart(P { x: 1, y: 2 })}")
