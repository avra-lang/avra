use @std.meta.{Diagnostic, refuse}

component tray<T> {
    held: List<T> = []
    limit: int = 1
    fn check() -> List<Diagnostic> {
        if self.held.length > self.limit { [refuse("a tray of ${self.limit} holds ${self.held.length}")] } else { [] }
    }
}

tray<string> t {
    held: ["a", "b"]
}
"${t.held.length}"
