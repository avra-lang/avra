type Box = { n: int }

impl Box {
    fn wrapped<U>(x: U) -> List<U> { [x] }
    fn made<U>() -> List<U> { [] }
}

type Holder<T> = { item: T }

impl Holder<T> {
    fn paired<U>(other: U) -> List<U> { [other] }
}

let b = Box { n: 1 }
let xs = b.wrapped<string>("a")
let ys = b.made<int>()
let h = Holder { item: 2 }
let few = b.n < 3
println("${xs[0]} ${ys.length} ${h.paired<string>("p")[0]} ${few}")
