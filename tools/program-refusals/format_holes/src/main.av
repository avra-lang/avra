grammar Narrow = "/b/{n: int}"
grammar Hole = "/a/{id}"

fn narrow(t: string) -> string {
    let got? = Narrow.parse_octets(t.bytes()) else { return "none" }
    "${got.n}"
}

fn hole(t: string) -> string {
    let got? = Hole.parse_octets(t.bytes()) else { return "none" }
    got.id
}

"${narrow("/b/7")} ${narrow("/b/abc")} ${hole("/a/c")} ${hole("/a/b/c")}"
