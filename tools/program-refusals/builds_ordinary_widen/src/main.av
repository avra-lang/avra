// proves: a bare `quote` widens into `Fix.Rewrite` the same way
// under an ORDINARY fn as under `rule` sugar — the declared answer
// plants the want before the match's arms walk, the same channel a
// rule's synthesized match takes — so the lift needs no `rule` at all,
// only a `fn(Code) -> Fix?` shape, applied to the program layer's items.
use @std.avrac.features.{Code, Fix}
use @std.avrac.compiler.{example_roots, nearest_fix}
use @std.avrac.testing.{judged}

fn widen_add(e: Code) -> Fix? {
    match e { quote { ${x} + 1 } -> quote { ${x} }, _ -> null }
}

match example_roots(judged("a + 1").rule_items("/alone/src/main.av")).first() {
    root? -> match nearest_fix(widen_add, root) {
        r? -> r.rendered() ?? "no text"
        null -> "miss"
    }
    null -> "no root"
}
