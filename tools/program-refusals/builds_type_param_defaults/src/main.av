type Dead<T, E = never> = { item: T, why: E? }

enum Settled<T, E = string> {
    Done(value: T)
    Failed(why: E)
}

alias Rows<T = int> = List<T>

fn first(rows: Rows) -> int { rows.first() ?? 0 }

fn said(s: Settled<int>) -> string {
    match s { .Done(v) -> "done ${v}", .Failed(why) -> why }
}

let dead: Dead<int> = Dead { item: 3, why: null }
let late: Settled<int> = .Failed("late")
println("${dead.item} ${dead.why == null} ${first([4, 5])} ${said(late)} ${said(.Done(7))}")
