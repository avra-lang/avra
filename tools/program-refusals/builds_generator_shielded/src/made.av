use @std.meta.{Fn, Directive}

/// Said once the making leaves.
fn noted() -> int { 0 }

/// A twin whose making defers a call, which brackets it under the task's shield.
export fn counted(f: Fn) -> List<Directive> {
    defer noted()
    [Directive { twin: "${f.name}_counted", name: f.name, at: f.at }]
}
