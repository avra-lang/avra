use @std.meta.{Fn, Named, Diagnostic, warn}
export fn deprecated(f: Fn, instead: string) -> List<Diagnostic> { [warn("`${f.name}` is deprecated — use ${instead}")] }
export fn fading(n: Named) -> List<Diagnostic> { [Diagnostic { message: "`${n.name}` fades", help: "pick another", at: null, warning: true }] }
@deprecated("add")
export fn sum(a: int, b: int) -> int { a + b }
