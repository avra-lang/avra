use @x.c.{deprecated, fading, sum}
fn call() -> int { old(1) + sum(1, 2) }
@deprecated("fresh")
fn old(a: int) -> int { a }
@fading
const limit: int = 3
@fading
type Dot = { v: int = 0 }
fn hidden(old: int) -> int { old + limit }
fn made() -> Dot { Dot { v: 1 } }
let f = old
println("${call() + hidden(1) + made().v + f(2)}")
