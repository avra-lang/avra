use @std.meta.{embed, provided, Provider}
type K = { n: int, d: string }
impl Provider for K {
    static fn provide(path: string, octets: Bytes, digest: string) -> K? {
        if octets.length > 4 { K { n: octets.length, d: digest.substring(0, 12) } } else { null }
    }
}
const T: string = embed("../../outside.txt")
println(T)
