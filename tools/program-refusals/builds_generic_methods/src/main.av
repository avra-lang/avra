trait Shown {
    fn shown() -> string
}

type Box = { n: int }

impl Shown for Box {
    fn shown() -> string { "box ${self.n}" }
}

impl Box {
    fn tagged<U>(x: U) -> List<U> { [x, x] }
    fn made<U = string>() -> List<U> { [] }
    fn put<T: Shown>(x: T) -> string { "${self.n}: ${x.shown()}" }
}

type Holder<T> = { item: T }

impl Holder<T> {
    fn paired<U>(other: U) -> List<U> { [other] }
    fn kept<U>(other: U) -> T { self.item }
}

let b = Box { n: 1 }
let none: List<int> = b.made()
let h = Holder { item: 5 }
println(
    "${b.tagged(3).length} ${b.tagged("a")[1]} ${none.length} ${b.made().length} ${b.put(Box { n: 2 })}",
)
println(
    "${h.paired("x")[0]} ${Holder { item: "s" }.paired(2)[0]} ${h.kept("q")} ${Holder { item: "z" }.kept(1)}",
)
