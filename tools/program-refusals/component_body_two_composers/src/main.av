// proves: a component's body two composing traits would both say is refused naming both — never
// composed by neither in silence, which only a later `no method` would betray
use @std.ui.components.{text}
use @std.ui.tree.view.{View}
use kit.{told}

component note(name: string) {
    text self.name
}

let v: dyn View = note "a"
println("${told()}")
