// proves: a cache bounded by bytes lets the least recently read go one at a time, re-puts a key in
// place, and packs its record of reads, on the program layer as on the old.
use @std.program.answer_record.{ContentHash, content_hash}
use @std.program.bounded_cache.{bounded_cache}

fn key(text: string) -> ContentHash { content_hash(text.bytes()) }

let cache = bounded_cache<List<string>>(100)
for round in 0..5000 {
    let word = "k${round % 37}"
    if cache.get(key(word)) == null { cache.put(key(word), ["v${round}", word], 7 + round % 5) }
    if round % 11 == 0 { cache.put(key("k${round % 13}"), ["again"], 9) }
}
println("${cache.count()} ${cache.bytes()} ${(cache.get(key("k1")) ?? []).join(",")}")
