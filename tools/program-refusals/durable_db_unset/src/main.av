use @std.queue.{queue}
use @std.queue_store.{wire_of}
use @std.queue_store.durable.{stored}
use @std.relation.stable.{Reader, Writer}

queue<int> jobs {
    name: "jobs"
    durable: stored(wire_of<int>(1, "int", (w: Writer, n: int) -> w.int(n), (r: Reader) -> r.int()))
}
let _ = jobs.send(1)
println("held")
