// proves: an enum a gathering leaves empty is refused, never a trap — reading the name of a value
// of it, which no value can be, lowers to what is never seen
use @std.meta.{Named}
fn command(_what: Named) {}
collect enum Command = @command in self by it.name
let held: Command? = null
let names = [c.name for c in Command.all()].join(",")
println("${held?.name ?? "-"} ${names}")
