ctx db: string

trait Shows {
    fn show() -> string
}

type Plain = { n: int }

type Report = { n: int }

impl Shows for Plain {
    fn show() -> string { "plain" }
}

impl Shows for Report {
    fn show() -> string { ctx.db }
}

fn pick(report: bool) -> dyn Shows {
    if report { Report { n: 2 } } else { Plain { n: 1 } }
}

fn drawn(s: dyn Shows) -> string { s.show() }

println(drawn(pick(false)))
