// proves: whether one grammar accepts every text another does is one question a library asks of
// their shapes — the very function the compiler's match law asks
use @std.meta.{format_subsumes}

grammar A = "/items/{id}"
grammar B = "/items/new/{x}"
grammar N = "/pages/{n: int}"
grammar K = "/pages/{k: int}"

fn said(a: FormatShape, b: FormatShape) -> string {
    match format_subsumes(a, b) { .Covers -> "covers", .Misses -> "misses", .Unknown -> "unknown" }
}

println("${said(A.parts(), B.parts())} ${said(B.parts(), A.parts())} ${said(N.parts(), K.parts())}")
