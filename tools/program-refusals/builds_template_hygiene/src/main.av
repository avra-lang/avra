// proves: a template's binders and the names its holes bring never capture each other — the
// instance's block reads the user's `seen` and `step`, nested instances each keep their own.
use @test.tally.{tally, Tally}

let seen = 1000
let step = 7
let single = tally (Tally { n: 1 }) { seen + step }
let nested = tally (Tally { n: 10 }) { tally (Tally { n: seen }) { seen } + seen }
let shadowing = tally (Tally { n: 2 }) {
    let seen = 3
    seen
}
"${single} ${nested} ${shadowing}"
