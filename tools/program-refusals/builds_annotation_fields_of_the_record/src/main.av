use @std.meta.{Type, Field, Diagnostic, refuse}
fn keyed(t: Type, ..fields: List<Field>) -> List<Diagnostic> {
    let said = [f.name + ":" + f.ty for f in fields].join(",")
    if said == "entity:string,property:string,value:string" { [] } else { [refuse("keyed saw ${said}")] }
}
fn one(_t: Type, f: Field) -> List<Diagnostic> { if f.name == "id" && f.defaulted { [] } else { [refuse("one saw ${f.name}")] } }
@keyed(entity, property, value)
@one(id)
type Fact = { id: int = 0, entity: string, property: string, value: string }
println("${Fact { entity: "e", property: "p", value: "v" }.id}")
