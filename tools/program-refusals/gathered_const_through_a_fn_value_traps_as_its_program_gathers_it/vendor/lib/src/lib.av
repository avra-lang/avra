use @std.meta.{Named, Marker}

export fn row(_d: Named) -> Marker { Marker {} }

export type Row = { name: string }

collect rows: List<Row> = @row in closure as Row { name: it.name } by it.name

extern fn avra_trap(s: string)

fn named_well(r: Row) -> string {
    if r.name.starts_with("bad") { avra_trap("`${r.name}` is no name a row may wear") }
    r.name
}

fn all_rows() -> List<Row> { rows }

fn through(f: fn() -> List<Row>) -> List<string> { [named_well(r) for r in f()] }

const names: List<string> = through(all_rows)

export fn listed() -> string { names.join(",") }
