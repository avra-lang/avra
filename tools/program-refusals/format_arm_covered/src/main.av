// proves: an arm whose every text an earlier format arm accepts never runs, and is said so — a
// literal the format scans, a format whose holes stand where the earlier one's do, and two `int`
// holes under different names
fn untyped(t: string) -> string {
    match t {
        "/items/{id}" -> "id ${id}",
        "/items/{slug}" -> "slug ${slug}",
        "/items/new" -> "new",
        _ -> "miss",
    }
}

fn typed(t: string) -> string {
    match t { "/pages/{n: int}" -> "n ${n}", "/pages/{k: int}" -> "k ${k}", _ -> "miss" }
}

println("${untyped("/items/new")} ${untyped("/items/x")} ${typed("/pages/3")}")
