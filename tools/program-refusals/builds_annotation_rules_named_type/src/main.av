use @std.meta.{derive}
use @std.validate.{Decode, length, pattern, from_json}

fn slug(s: string) -> bool { !s.starts_with("-") }

@derive(Decode)
@length(min: 3, max: 32)
@pattern(slug, "slug")
type Username = string

fn said(text: string) -> string { match Username.from_json(text) { .Ok(u) -> "ok", .Err(e) -> e.report() } }

"${said("\"-ab\"")}|${said("\"abcd\"")}|${said("\"ab\"")}"
