use @std.meta.{Named, Marker}

fn row(_d: Named) -> Marker { Marker {} }

type Row = { name: string }

collect rows: List<Row> = @row in closure as Row { name: it.name } by it.name

extern fn avra_trap(s: string)

fn named_well(r: Row) -> string {
    if r.name.starts_with("bad") { avra_trap("`${r.name}` is no name a row may wear") }
    r.name
}

const names: List<string> = [named_well(r) for r in rows]

@row
fn good() {}

@row
fn bad_one() {}

println(names.join(","))
