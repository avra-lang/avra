trait Shown {
    fn shown() -> string
}

trait Respond {
    fn response() -> string
}

type Created<T> = { value: T, at: string }

impl Respond for Created<T: Shown> {
    fn response() -> string { "201 ${self.at} ${self.value.shown()}" }
}

fn answered<X: Respond>(x: X) -> string { x.response() }

println(answered(Created { value: "s", at: "/" }))
