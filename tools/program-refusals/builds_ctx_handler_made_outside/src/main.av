ctx db: string
ctx tone: string = "plain"

type Worker = { handle: fn(int) -> string }

fn run(w: Worker) -> string { (w.handle)(7) }

fn worker() -> Worker {
    ctx tone = "loud"
    Worker { handle: (job: int) -> "${ctx.db}:${ctx.tone}:${job}" }
}

fn go(w: Worker) -> string {
    ctx db = "B"
    ctx tone = "soft"
    let t = spawn run(w)
    "${t.await} ${run(w)}"
}

println(go(worker()))
