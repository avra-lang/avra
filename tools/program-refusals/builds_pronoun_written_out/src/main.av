type Lives = { last: List<int> }

impl Lives {
    fn dies_at(r: int, at: int) -> bool { self.last[r] == at }
}

fn under(limit: List<int>, x: int) -> bool { limit.contains(x) }

fn part_dies(open: List<int>, life: Lives, elems: List<int>, at: int) -> bool { elems.any((r) -> under(open, r) && life.dies_at(r, at)) }

"${part_dies([0, 1], Lives { last: [3, 4, 5] }, [1, 2], 4)}"
