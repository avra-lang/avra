type Seven = { n: int }

fn got() -> Result<Seven, string> { Seven { n: 1 } }

fn opt() -> Seven? { Seven { n: 2 } }

fn widened() -> Result<int, string> {
    let s: Seven? = got()?
    s?.n ?? 0
}

fn absent() -> int? {
    let s: Seven? = opt()?
    s?.n
}

fn shown(r: Result<int, string>) -> string {
    match r { .Ok(n) -> "${n}", .Err(why) -> why }
}

println("${shown(widened())} ${absent() ?? 0}")
