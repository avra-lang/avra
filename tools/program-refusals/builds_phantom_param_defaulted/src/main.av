type Qd<E, T = never> = { name: string = "", hint: List<E> = [] }

export component qd<E, T = never> {
    hint: List<E> = []
}

fn go() -> int {
    let q = Qd { hint: ["a"] }
    let a: Qd<string, int> = Qd { hint: ["b", "c"] }
    qd c { hint: [1, 2, 3] }
    q.hint.length + a.hint.length + c.hint.length
}

println("${go()}")
