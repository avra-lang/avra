// builds: a `_` fn read as a value carries its inferred union to a caller that isn't `_`.
enum E { E(n: int) }
enum F { F(n: int) }
fn base(k: int) -> Result<int, _> {
    if k == 0 { fail E.E(0) }
    if k == 1 { fail F.F(1) }
    k
}
fn read(k: int) -> int {
    let h = base
    h(k) catch {
        .E(e) -> 10
        .F(f) -> 20
    }
}
println("${read(0)} ${read(1)} ${read(5)}")
