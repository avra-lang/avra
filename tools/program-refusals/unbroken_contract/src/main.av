use @std.meta.{unbroken}
extern fn avra_wait_park() -> int
extern fn avra_fiber_sleep(ms: int)
fn helper(n: int) -> int { n + 1 }
trait Show {
    fn show() -> int
}
type P = { n: int }
impl Show for P {
    fn show() -> int { 1 }
}
@unbroken
fn ring(s: dyn Show) -> int { s.show() }
println("${ring(P { n: 1 })}")
