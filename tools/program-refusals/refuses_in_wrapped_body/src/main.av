use @std.program.query_engine.{QueryEngine}
use @std.program.saved_query.{query}

/// Twice `n`, its text bound where a number is wanted: an annotation that wraps the fn moves this
/// body beside it, and the refusal is still said where it was written.
@query
fn doubled(engine: QueryEngine, n: int) -> int {
    let shown: int = "${n}"
    n * 2
}

"${2 * 2}"
