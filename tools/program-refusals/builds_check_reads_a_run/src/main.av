use @std.meta.{Diagnostic, refuse}

component tray {
    capacity: int = 1
    fn check() -> List<Diagnostic> {
        if self.capacity < 1 { [refuse("a tray holds at least one, and this holds ${self.capacity}")] } else { [] }
    }
}

fn made(n: int) -> int {
    tray t { capacity: n }
    t.capacity
}

"${made(0)}"
