trait Named {
    fn name() -> string
}

type Dog = { legs: int }

impl Named for Dog {
    fn name() -> string { "dog ${self.legs}" }
}

fn named_of<T: Named>(x: T) -> string { x.name() }

fn maybe_named<T: Named>(x: T?) -> string { x?.name() ?? "none" }

"${named_of(Dog { legs: 2 })} ${maybe_named(Dog { legs: 1 })}"
