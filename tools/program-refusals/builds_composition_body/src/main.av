// proves: a composition is derived over the trait that composes it, its body copied as the nodes it
// was written as — interpolated strings and other components' words read as written
use @std.ui.components.{button, column, text}
use @std.ui.tree.view.{View}

component names(label: string) {
    state n: int = 0
    column {
        text "${self.label}: ${self.n} of \"${self.label}\""
        button "${self.label}+" { on press { self.n = self.n + 1 } }
    }
}

let n = names "a"
let boxed: List<dyn View> = [n, names "b"]
println("${n.stand().key == null} ${boxed.length} ${boxed[1].stand().key == null}")
