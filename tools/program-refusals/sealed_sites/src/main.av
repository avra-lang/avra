use urls.{Scheme, Url, scheme_name, url_of}
alias U = Url
type Mine = Url
let made = Url("x")
let absent: Url? = null
let filled: Url = absent ?? "x"
let aliased: U = "x"
let mine: Mine = "x"
let wanted: Scheme = .Other("ftp")
let read = Scheme.Http
let called = Scheme.Other("ftp")
let asked = url_of("y")
"${scheme_name(.Http)} ${scheme_name(read)} ${asked == made}"
