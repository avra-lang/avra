use @std.meta.{Type, Directive, declares}

/// `@derive(Twin)`: a private `<T>Twin` holding `T`'s fields.
export trait Twin {
    static fn derive(t: Type) -> List<Directive> {
        let fields = [quote { type _ = { ${f.name}: ${f.ty} } } for f in t.fields]
        [declares("${t.name}Twin", t.at, quote { type ${t.name}Twin = { ..${fields} } })]
    }
}
