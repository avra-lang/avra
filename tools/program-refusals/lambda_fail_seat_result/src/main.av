type Source = { run: fn() -> Result<int, string> }

fn source(n: int) -> Source {
    Source {
        run: () -> {
            if n < 0 { fail "negative" }
            n
        },
    }
}

fn said(r: Result<int, string>) -> string {
    match r { .Ok(v) -> "ok ${v}", .Err(e) -> e }
}

println("${said(source(1).run())} ${said(source(-1).run())}")
