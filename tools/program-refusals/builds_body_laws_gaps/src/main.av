fn one() -> int { 41 }

fn first<T>(x: T?, d: T) -> T {
    if x != null { return x! }
    d
}

fn apply(g: fn(int) -> Result<int, string>, n: int) -> Result<int, string> { g(n) }

fn f(n: int) -> int {
    let t: Task<int>? = spawn one()
    let ts: List<Task<int>> = [spawn one()]
    let r = apply(
        (m) -> {
            if m == 0 { fail "zero" }
            .Ok(m)
        },
        n,
    ) catch 0
    let held = if t != null { t!.await } else { 0 }
    r + ts.length + held
}

let none: int? = null
let five: int? = 5
println("${first(none, 3)} ${first(five, 3)} ${f(2)} ${f(0)}")
0
