// proves: a literal's left-out `Site` holds its own site, a sited instance's `Words` says its text again, and a value of a named fn type is called as its fn
use @std.meta.{Site, Words}

type Spot = { name: string, site: Site }

fn first() -> Spot { Spot { name: "b" } }

fn second() -> Spot { Spot { name: "b" } }

fn quiet() -> string { "(default)" }

component said(message: string) {
    words: Words = Words(quiet)
}

state n: int = 3

let held = said "n is ${n}"
let before = (held.words)()
n = 4
println("${first().site == first().site} ${first().site == second().site} ${before} / ${(held.words)()}")
