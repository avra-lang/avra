type Email = { to: string }
type Durable<T> = { items: List<T> }
fn stored<T>() -> Durable<T> { Durable { items: [] } }
type Box = { durable: Durable<Email>? = null }
component holder {
    durable: Durable<Email>? = stored()
}
holder h {}
let b = Box { durable: stored() }
let e: Durable<Email>? = stored()
println(
    "${b.durable?.items?.length ?? 9} ${e?.items?.length ?? 9} ${h.durable?.items?.length ?? 9}",
)
