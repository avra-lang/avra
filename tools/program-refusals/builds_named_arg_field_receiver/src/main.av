type Q<T> = { held: List<T> }

impl Q<T> {
    fn send(item: T, id: int) -> int { id }
}

type Job = { n: int }

type W = { item: Job }

impl W {
    fn go(q: Q<Job>, x: int) -> int { q.send(self.item, id: x) }
}

type Tally = { counts: List<int> }

fn put(n: int, mut into: List<int>) { into.push(n) }

impl Tally {
    mut fn add(n: int) { put(into: self.counts, n: n) }
}

component worker {
    item: int = 2
    q: Q<int> = Q { held: [] }
    fn go(x: int) -> int { self.q.send(self.item, id: x) }
}

worker w {}

mut t = Tally { counts: [] }
t.add(4)
t.add(5)
println("${W { item: Job { n: 1 } }.go(Q { held: [] }, 3)} ${w.go(7)} ${t.counts.length}")
