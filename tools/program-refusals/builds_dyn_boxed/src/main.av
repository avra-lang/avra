trait Show {
    fn show() -> string
}
impl Show for int {
    fn show() -> string { "i" }
}
type P = { x: int }
impl Show for P {
    fn show() -> string { "p" }
}
fn find(b: bool) -> P? { if b { P { x: 1 } } else { null } }
let s: dyn Show = 5
let m: dyn Show? = null
let xs: List<dyn Show> = [P { x: 2 }, 3]
println("${s.show()} ${xs.length} ${m?.show() ?? "-"}")
