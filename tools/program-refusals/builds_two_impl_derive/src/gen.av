use @std.meta.{Type, Directive, beside, name}

export type Lim = { max: int = 3 }

export trait Shown {
    fn shown() -> string
}

/// Writes a static `made` on the annotated type.
export trait Makes {
    static fn derive(t: Type) -> List<Directive> {
        [beside(t, quote {
            impl Shown for ${t} {
                fn shown() -> string { "x" }
            }

            impl ${t} {
                static fn made(n: int, lim: Lim = Lim {}) -> Result<${t}, Lim> {
                    if n > lim.max { return .Err(lim) }
                    .Ok(${t} { legs: n })
                }
            }
        })]
    }
}
