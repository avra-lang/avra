// refuses, and prints its unions: the package being built declares its members before a
// dependency's, whatever the packages are named; written and inferred alike.
use @w.adep.{Aye, Bee}
enum Zed { Zed(n: int) }
enum Cee { Cee(n: int) }
fn written(k: int) -> Result<int, Zed or Bee or Cee or Aye> { fail Aye.Aye(k) }
fn inferred(k: int) -> Result<int, _> {
    if k == 0 { fail Cee.Cee(0) }
    if k == 1 { fail Aye.Aye(1) }
    if k == 2 { fail Zed.Zed(2) }
    fail Bee.Bee(3)
}
let u: string = written(0)
let v: string = inferred(0)
