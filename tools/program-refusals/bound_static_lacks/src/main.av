trait Named {
    static fn kind() -> string
    static fn made(n: int) -> Self
    fn n() -> int
}
type P = { v: int }
impl Named for P {
    static fn kind() -> string { "p" }
    static fn made(n: int) -> P { P { v: n } }
    fn n() -> int { self.v }
}
type Q = { w: int }
impl Named for Q {
    static fn kind() -> string { "q" }
    static fn made(n: int) -> Q { Q { w: n * 2 } }
    fn n() -> int { self.w }
}
fn k<T: Named>(x: T) -> string { T.nope() }
k(P { v: 1 })