use @std.meta.{derive}
use @std.validate.{Decode, secret}
use @std.config.{Configured, env}

@derive(Decode)
type Db = { url: string = "u", @secret pw: string = "" }

@derive(Decode)
component Shop {
    db: Db = Db {}
    env "SHOP"
}

match Shop.load() { .Ok(c) -> c.value.db.pw.length, .Err(_) -> 0 }
