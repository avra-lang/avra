type Counter = { n: int }
fn touched(mut c: Counter, f: fn(mut Counter) -> int) -> int { f(c) }
mut c = Counter { n: 1 }
let blocked = touched(c) { mut c ->
    c.n = c.n + 10
    c.n
}
let lambda = touched(c, (mut c: Counter) -> {
    c.n = c.n * 2
    c.n
})
println("${blocked} ${lambda} ${c.n}")
