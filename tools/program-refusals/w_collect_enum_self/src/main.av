use @std.meta.{Named}
fn numbered(what: Named, ordinal: int) -> void {}
trait Rank {
    fn versus(other: Self) -> int
}
@numbered(0)
type Dot = { at: int }
impl Rank for Dot {
    fn versus(other: Dot) -> int { self.at - other.at }
}
collect enum Item: Rank = @numbered in self by it.mark.args[0] dense
