use @std.meta.{Code}
use @std.meta.{plans, plans_all}
export type Row = { n: int, tag: string }
impl Row {
    @plans_all
    static fn all(db: int) -> List<Row> { [Row { n: db, tag: "a" }] }
    @plans("tag")
    static fn by_tag(db: int, v: string) -> List<Row> { [] }
    @plans("n")
    static fn by_n(db: int, v: string) -> List<Row> { [] }
}
export fn ok(r: Row) -> bool { r.n > 0 }
export fn same(r: Row) -> Row { r }
