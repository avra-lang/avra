use @std.meta.{derive}
use @std.validate.{Decode}
use @std.config.{Configured, env, variable}

@derive(Decode)
type Db = { url: string = "u" }

@derive(Decode)
component Tool {
    @variable("DATABASE") db: Db = Db {}
    env "TOOL"
}

match Tool.load() { .Ok(c) -> c.value.db.url.length, .Err(_) -> 0 }
