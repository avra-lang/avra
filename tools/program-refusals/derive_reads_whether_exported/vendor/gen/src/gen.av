use @std.meta.{Type, Directive, beside, literal, type_exported}

/// `@derive(Seen)`: `T.seen()`, whether the module exports `T`.
export trait Seen {
    static fn derive(t: Type) -> List<Directive> {
        let said = "${t.module}.${t.name} exported=${type_exported(t.module, t.name) != null}"
        [beside(t, quote { impl ${t} { static fn seen() -> string { ${literal(said)} } } })]
    }
}
