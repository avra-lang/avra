// refuses, and prints its unions: an imported file's members before the importing file's, each file's in
// declaration order.
use a0.{Aye, Bee}
enum Zed { Zed(n: int) }
enum Cee { Cee(n: int) }
fn sites(k: int) -> Result<int, _> {
    if k == 0 { fail Cee.Cee(0) }
    if k == 1 { fail Aye.Aye(1) }
    if k == 2 { fail Zed.Zed(1) }
    fail Bee.Bee(2)
}
fn written(k: int) -> Result<int, Zed or Bee or Aye or Cee> { fail Aye.Aye(k) }
let s: string = sites(0)
let u: string = written(0)
