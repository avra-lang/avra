trait A {
    fn a() -> int
}

trait B {
    fn b() -> int
}

trait Tr {
    fn tr() -> int
}

type OnlyA = { n: int }

impl A for OnlyA {
    fn a() -> int { 1 }
}

type OnlyB = { n: int }

impl B for OnlyB {
    fn b() -> int { 2 }
}

type Both = { n: int }

impl A for Both {
    fn a() -> int { 3 }
}

impl B for Both {
    fn b() -> int { 4 }
}

component boxed<T: A>(head: T) {
    n: int = 1
}

impl Tr for boxed<T: B> {
    fn tr() -> int { self.head.b() }
}

let p = Both { n: 0 }
let x = boxed p {}
println("${x.tr()}")
