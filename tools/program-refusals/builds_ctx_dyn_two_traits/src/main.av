ctx db: string

trait Shows {
    fn show() -> string
}

trait Draws {
    fn show() -> string
}

type Plain = { n: int }

type Report = { n: int }

impl Shows for Plain {
    fn show() -> string { "plain" }
}

impl Draws for Report {
    fn show() -> string { ctx.db }
}

fn shown(s: dyn Shows) -> string { s.show() }

fn kept(d: dyn Draws) -> string { "kept" }

println(shown(Plain { n: 1 }))
println(kept(Report { n: 2 }))
