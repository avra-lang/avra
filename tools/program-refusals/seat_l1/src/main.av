type Memo<V> = { held: V? }

impl Memo<V> {
    fn answer(f: fn() -> V?) -> V? { self.held ?? f() }
}

fn text() -> string { "x" }

fn pick<R>(f: fn() -> R?) -> R? { f() }

fn one() -> int { 1 }

let m = Memo<string> { held: null }
let a = m.answer(() -> text()) ?? ""
let b = pick(() -> 1) ?? 0
"${a} ${b}"
