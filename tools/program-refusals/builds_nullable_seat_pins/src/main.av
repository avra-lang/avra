type Box<T> = { v: List<T> }

fn made<T>() -> Box<T> { Box<T> { v: [] } }

fn take(b: Box<int>?) -> bool { b != null }

type Holder = { b: Box<int>? }

export component holder<T> {
    b: Box<T>? = null
}

fn go() -> bool {
    holder<int> h { b: made() }
    h.b != null
}

let b: Box<int>? = made()
println("${take(made())} ${b != null} ${Holder { b: made() }.b != null} ${go()}")
