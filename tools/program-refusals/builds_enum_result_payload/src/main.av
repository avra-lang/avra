enum Step {
    Idle
    Done(r: Result<int, string>)
}
fn found(n: int) -> Result<int, string> { if n < -1 { .Err("gone") } else { .Ok(n) } }
fn read(r: Result<int, string>) -> int { match r { .Ok(id) -> id, .Err(e) -> e.length * 1000 } }
fn stepped(s: Step) -> int { match s { .Idle -> -9, .Done(r) -> read(r) } }
println("${stepped(Step.Idle)} ${stepped(Step.Done(found(-1)))} ${stepped(Step.Done(found(-4)))}")
