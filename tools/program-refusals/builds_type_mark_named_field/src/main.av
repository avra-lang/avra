// proves: a type's annotation reads a named argument written as a bare word among the type's
// fields, as its positional ones and a field's own mark do, never as a name of the program
use tag.{tag}

@tag(lane, absent: done_at)
type Card = {
    id: int = 0,
    @tag(absent: done_at) lane: string,
    done_at: int? = null,
}

println("${Card { lane: "a" }.lane}")
