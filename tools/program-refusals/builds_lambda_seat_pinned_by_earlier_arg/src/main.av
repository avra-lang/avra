trait Made {
    static fn made() -> Self
}

type Req<R> = { params: R }

type Idea = { title: string }

impl Made for Idea {
    static fn made() -> Idea { Idea { title: "a" } }
}

fn door<R, B: Made>(q: Req<R>, serve: fn(Req<R>, B) -> string) -> string { serve(q, B.made()) }

println(door(Req { params: 3 }, (req, idea: Idea) -> "${req.params} ${idea.title}"))
