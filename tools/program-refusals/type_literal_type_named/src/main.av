enum Sp { Int, Str, Bool, Opt(inner: Sp), List(elem: Sp), Map(k: Sp, v: Sp), Res(ok: Sp, err: Sp), Fn(ps: List<Sp>, muts: List<bool>, consts: List<bool>, ret: Sp), Id(id: int), Float, Ptr, Void }
type N = { held: List<string> }
impl N {
    fn interned(t: Sp) -> string {
        match t {
            .Int -> "int", .Str -> "string", .Bool -> "bool", .Float -> "float", .Ptr -> "ptr", .Void -> "void",
            .Opt(i) -> "${self.interned(i)}?", .List(e) -> "List<${self.interned(e)}>",
            .Map(k, v) -> "Map<${self.interned(k)}, ${self.interned(v)}>", .Res(a, b) -> "Result<${self.interned(a)}, ${self.interned(b)}>",
            .Fn(ps, muts, _, r) -> "fn${ps.length}${muts.length} -> ${self.interned(r)}", .Id(id) -> self.held[id],
        }
    }
}
let n = N { held: ["H", "K"] }
let h = 0
N.type(int)