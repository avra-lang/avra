use @std.meta.{Code}

type Req<R> = { p: R }

type In = { a: int }

export fn declared(read: fn(int) -> int?, serve: fn(Req<int>) -> int) -> int { 1 }

export component post(name: string) {
    body: Code
    fn expand() -> Code {
        quote { declared((t: int) -> null, ${self.body}) }
    }
}

fn routes() -> int { post "x" { (inp: In) -> inp.a } }

println("${routes()}")
