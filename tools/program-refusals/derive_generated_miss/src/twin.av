use @std.meta.{Type, Directive}

export trait Twin {
    fn twin() -> int

    static fn derive(t: Type) -> List<Directive> {
        [
            Directive {
                twin: "",
                name: t.name,
                at: t.at,
                source: quote {
                    impl Twin for ${t} {
                        fn twin() -> int { self.no_such_field }
                    }
                },
            },
        ]
    }
}
