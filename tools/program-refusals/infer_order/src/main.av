// refuses, and prints its unions: members in declaration order, whatever order the sites raise
// them in, an inferred union and a written one alike.
enum Mid { Mid(n: int) }
enum Alpha { Alpha(n: int) }
enum Zeta { Zeta(n: int) }
fn later() -> Result<int, Mid> { fail Mid.Mid(1) }
fn sites(k: int) -> Result<int, _> {
    if k == 0 { fail Alpha.Alpha(0) }
    if k == 1 { fail Zeta.Zeta(1) }
    let v = later()?
    v
}
fn other(k: int) -> Result<int, _> {
    if k == 1 { fail Zeta.Zeta(1) }
    if k == 2 { let w = later()? }
    if k == 0 { fail Alpha.Alpha(0) }
    k
}
let s: string = sites(0)
let t: string = other(0)
fn written(k: int) -> Result<int, Zeta or Mid> { fail Mid.Mid(k) }
let u: string = written(0)
type Rec = { a: Alpha }
