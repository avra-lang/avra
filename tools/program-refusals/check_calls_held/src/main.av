use @std.meta.{Diagnostic, refuse}

fn at_least(n: int) -> bool { n >= 1 }

fn spoken(n: int) -> string { "a tray holds at least one, and this holds ${n}" }

component tray {
    capacity: int = 1
    fits: fn(int) -> bool = at_least
    said: fn(int) -> string = spoken
    fn check() -> List<Diagnostic> {
        if (self.fits)(self.capacity) { [] } else { [refuse((self.said)(self.capacity))] }
    }
}

tray t { capacity: 0 }
"${t.capacity}"
