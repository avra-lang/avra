export enum Op {
    Ptr(n: int)
    Row(name: string)
    Other
}
export type Notes = { met: Cell<List<string>> }
impl Notes {
    fn noted(made: fn(int) -> string) { self.met.push(made(1)) }

    fn noted_row(row: string) {
        if row.length > 1 { self.noted((at: int) -> "${row}${at}") }
    }

    fn noted_op(op: Op) {
        match op {
            .Ptr(_) -> self.noted((at: int) -> "ptr${at}"),
            .Row(row) -> self.noted_row(row),
            rest -> {},
        }
    }
}
