// proves: a hole of a number, a truth, text, a list's element or length, and a narrowed read prints
fn shown(xs: List<int>, name: string?) -> string {
    let n? = name else { return "${xs.length} ${xs[0]} ${1.5} ${true}" }
    "${n} ${xs.length} ${xs[0]} ${1.5} ${true}"
}

"${shown([4, 5], "a")}|${shown([6], null)}"
