type Bag = { items: List<int> }

impl Bag {
    mut fn add(n: int) {
        self.items.push(n)
    }
}

const start = Bag { items: [1] }

fn go() -> int {
    let c = start
    c.add(3)
    c.items.length
}

fn fresh() -> int {
    let c = Bag { items: [1] }
    c.add(3)
    c.items.length
}

"${go()} ${fresh()} ${start.items.length}"
