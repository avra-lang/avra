// proves: an instance its component judges by `check` is the component's value, not the check's
// answer — its `check` is called, then indexed in a hole, on the program layer as on the old.
use @std.queue.{queue}

fn said(capacity: int) -> string {
    let a = queue<int> { capacity: capacity }
    let b = queue<int> { capacity: 3 }
    "${a.check()[0].message}|${b.check().length}"
}
said(0)
