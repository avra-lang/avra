trait Shown {
    fn shown() -> string
}

trait Respond {
    fn response() -> string
}

impl Shown for int {
    fn shown() -> string { "${self}" }
}

type Created<T> = { value: T, at: string }

impl Respond for Created<T: Shown> {
    fn response() -> string { "201 ${self.at} ${self.value.shown()}" }
}

impl Created<T: Shown> {
    fn told() -> string { "told ${self.value.shown()}" }
}

fn answered<X: Respond>(x: X) -> string { x.response() }

let c = Created { value: 7, at: "/ideas/7" }
println("${c.response()} | ${c.told()} | ${answered(c)}")
