use @std.meta.{Fn, Diagnostic, refuse}
type Impact = { grade: int = 0, note: string = "" }
const routine: Impact = Impact { grade: 5, note: "low" }
fn impact(_f: Fn, i: Impact) -> List<Diagnostic> { if i.grade > 3 { [refuse("too high")] } else { [] } }
@impact(routine)
fn work() -> int { 1 }
println("${work()}")
