use @std.meta.{Diagnostic, refuse}

component tray {
    capacity: int = 0
    label: string = "tray"
    fn check() -> List<Diagnostic> {
        if self.capacity < 1 { [refuse("`${self.label}` holds at least one, and its default holds ${self.capacity}")] } else { [] }
    }
}

tray t { label: "shelf" }
"${t.label}"
