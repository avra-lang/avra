use @std.meta.{Type, Directive, beside}

/// `@derive(Gen)`: `T.hi()`, its answer built with a bare `flatten` the generator's file never defines.
export trait Gen {
    static fn derive(t: Type) -> List<Directive> { flatten([[beside(t, quote { impl ${t} { static fn hi() -> string { "hi" } } })], []]) }
}
