// refuses: a `?` on a call through a fn value inside a `_` fn names no callee the inference can
// follow, so the fn's `_` refuses rather than under-approximate.
enum E { E(n: int) }
fn base(k: int) -> Result<int, _> {
    if k == 0 { fail E.E(0) }
    k
}
fn through(k: int) -> Result<int, _> {
    let h = base
    let v = h(k)?
    v
}
fn read(k: int) -> int { through(k) catch e -> 1 }
println("${read(0)}")
