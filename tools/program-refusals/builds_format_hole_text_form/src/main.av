// proves: a format hole reads its span as any type that crosses text — through the type's own
// `from_text_form` in a match arm and a grammar's `parse`, and back through its `text_form` in `print`
use @std.text.{TextForm}

type IdeaId = { v: int }

impl TextForm for IdeaId {
    fn text_form() -> string { "i${self.v}" }
    static fn from_text_form(text: string) -> IdeaId? {
        if !text.starts_with("i") { return null }
        IdeaId { v: 7 }
    }
}

grammar Item = "/items/{id: IdeaId}"

fn arm(t: string) -> string {
    match t { "/items/{id: IdeaId}" -> "matched ${id.v}", _ -> "miss" }
}

let parsed = Item.parse("/items/i7")
let printed = Item.print(Item { id: IdeaId { v: 7 } }) ?? "refused"
println("${arm("/items/i7")} ${arm("/items/x")} ${parsed!.id.v} ${printed}")
