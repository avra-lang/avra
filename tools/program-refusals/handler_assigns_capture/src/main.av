component tray<T> {
    label: string = "x"
    on took(item: T)
}

fn fed<T>(t: tray<T>, x: T) -> int {
    if t.took != null { (t.took!)(x) }
    1
}

mut seen = 0
tray<int> t {
    label: "y"
    on took { n -> seen = seen + n }
}
tray<int> quiet { label: "q" }
"${fed(t, 4)} ${fed(t, 5)} ${fed(quiet, 6)} ${seen}"
