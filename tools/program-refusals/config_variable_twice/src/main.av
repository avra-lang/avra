use @std.meta.{derive}
use @std.validate.{Decode}
use @std.config.{Configured, env, variable}

@derive(Decode)
component Tool {
    @variable("AVRA_CACHE_DIR") cache: string = ""
    @variable("AVRA_CACHE_DIR") store: string = ""
    env "TOOL"
}

match Tool.load() { .Ok(c) -> c.value.cache.length, .Err(_) -> 0 }
