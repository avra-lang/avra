type Lim = { max: int = 3 }

type Fx = { title: string }

impl Fx {
    static fn from_text(text: string, strict: bool = true, lim: Lim = Lim {}) -> Result<Fx, string> {
        if text.length > lim.max && strict { return .Err("long") }
        .Ok(Fx { title: text })
    }
}

let n = match Fx.from_text("ab") {
    .Ok(f) -> f.title.length,
    .Err(_) -> -1,
}
"${n}"
