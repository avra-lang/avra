use @std.meta.{placed}

ctx tone: string = "plain"

@placed
trait Shows {
    fn show() -> string
}

type Said = { t: string }

impl Shows for Said {
    fn show() -> string { "${ctx.tone}:${self.t}" }
}

fn made() -> List<dyn Shows> {
    collect {
        Said { t: "a" }
        ctx tone = "loud"
        Said { t: "b" }
    }
}

println([s.show() for s in made()].join(" "))
