trait Made {
    static fn made(n: int) -> Self
}

type Seven = { n: int }

impl Made for Seven {
    static fn made(n: int) -> Seven { Seven { n: n } }
}

type Box<P> = { held: P, n: int }

impl Box {
    fn as_made<T: Made>() -> Result<T, string> {
        if self.n < 0 { fail "negative" }
        T.made(self.n)
    }
}

fn through_generic<P>(b: Box<P>) -> Result<int, string> {
    let s: Seven = b.as_made()?
    s.n
}

fn through_plain(b: Box<string>) -> Result<int, string> {
    let s: Seven = b.as_made()?
    s.n
}

fn shown(r: Result<int, string>) -> string {
    match r { .Ok(n) -> "${n}", .Err(why) -> why }
}

println(
    "${shown(through_generic(Box { held: 1, n: 7 }))} ${shown(through_plain(Box { held: "s", n: -1 }))}",
)
