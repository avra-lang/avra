extern fn frexp(x: float, mut exponent: i32) -> float

fn grow(by: int, mut xs: List<int>) { xs.push(by) }

let ys = [1]
grow(xs: ys, by: 2)
grow(by: 2, xs: [5])
let e = 0
let _ = frexp(exponent: e, x: 0.25)
mut ok = [1]
grow(xs: ok, by: 3)
mut f = 0
let _ = frexp(exponent: f, x: 0.25)
"${ok.length} ${f}"
