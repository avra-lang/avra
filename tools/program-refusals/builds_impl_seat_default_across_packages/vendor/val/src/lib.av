use @x.json.{Json}

export enum Coercion {
    Strict
    Loose
}

export type Limits = { depth: int = 8 }

export trait Decode {
    static fn from_json(n: int, coercion: Coercion = Coercion.Strict, limits: Limits = Limits {}) -> Self
}

impl Decode for Json {
    static fn from_json(n: int, coercion: Coercion, limits: Limits) -> Json {
        Json { v: n + limits.depth + if coercion is .Strict { 0 } else { 100 } }
    }
}
