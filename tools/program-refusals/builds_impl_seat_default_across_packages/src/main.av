//! A trait's seat defaults reach an impl another package gives: `@x/val` implements its own
//! `Decode` for `@x/json`'s `Json`, and a call through a bound that leaves both seats out takes the
//! trait's defaults — `Strict` and `Limits { depth: 8 }`.
use @x.json.{Json}
use @x.val.{Decode}

fn body_as<T: Decode>(n: int) -> T { T.from_json(n) }

let j: Json = body_as(2)
println("${j.v}")
