trait Marked {}

type Dog = { legs: int }

impl Marked for Dog {}

impl Dog {
    fn name() -> string { "dog ${self.legs}" }
}

type Box<T> = { v: T, w: T? }

impl Box<T> {
    fn size() -> int { self.v.count() }

    fn held() -> string { self.w?.name() ?? "none" }
}

fn named_of<T: Marked>(x: T) -> string { x.name() }

fn maybe_named<T: Marked>(x: T?) -> string { x?.name() ?? "none" }

fn sized<T>(x: T) -> int { x.size() }

"${named_of(Dog { legs: 2 })} ${maybe_named(Dog { legs: 1 })} ${sized(Dog { legs: 1 })}"
