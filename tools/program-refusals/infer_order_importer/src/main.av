// refuses, and prints its unions: members by the path of the file declaring each, then each file's
// declaration order, so the importer's own type stands before those its imports declare.
use y.{Wy}
use x.{Ex}
enum Am { Am(n: int) }
fn written(k: int) -> Result<int, Ex or Am or Wy> { fail Ex.Ex(k) }
fn inferred(k: int) -> Result<int, _> {
    if k == 0 { fail Wy.Wy(0) }
    if k == 1 { fail Ex.Ex(1) }
    fail Am.Am(2)
}
let u: string = written(0)
let v: string = inferred(0)
