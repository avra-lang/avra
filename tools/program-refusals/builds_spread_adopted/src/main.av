fn f(xs: List<int>) -> List<int?> { [null, ..xs] }
let c = f([1, 2])
let d: List<int?> = collect {
    null
    [3, 4]
}
println("${c.length} ${c[1] ?? 0} ${c[2] ?? 0} ${c[0] ?? 9} ${d.length} ${d[2] ?? 0}")
fn g(ss: List<string>) -> List<string?> { [..ss, null] }
let e = g(["a", "b"])
let fl: List<float?> = [..[1.5, 2.5], null]
println("${e.length} ${e[1] ?? "-"} ${e[2] ?? "-"} ${fl[1] ?? 0.0} ${fl[2] ?? 9.0}")
