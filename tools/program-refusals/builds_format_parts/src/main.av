// proves: a declared grammar's shape is a value — its head, and each hole's name, type, greed and
// the literal after it — read off the format, never re-read from its spelling
grammar Copy = "copy {src} to {dst...}:{mode: int}"

fn usage(shape: FormatShape) -> string {
    [if h.greedy { "<${h.name}:${h.ty}...>" } else { "<${h.name}:${h.ty}>" } for h in shape.holes]
        .join(" ")
}

println(
    "${Copy.parts().holes.length} [${Copy.parts().head}] ${usage(Copy.parts())} [${Copy.parts().holes[1].piece}]",
)
