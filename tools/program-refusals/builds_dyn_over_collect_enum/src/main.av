// proves: a value boxed into a `dyn` seat implements the seat's trait by an impl a generator made
// for a type other than the one the generator stands on — `collect enum Shape: Size` writes
// `impl Size for Shape` on an enum no annotation marks — and the seat takes it
use @std.meta.{Named}

fn numbered(what: Named, ordinal: int) {}

trait Size {
    fn size() -> int
}

@numbered(0)
type Dot = {}

impl Size for Dot {
    fn size() -> int { 1 }
}

@numbered(1)
type Line = { from: int }

impl Size for Line {
    fn size() -> int { self.from }
}

collect enum Shape: Size = @numbered in self by it.mark.args[0] dense

fn total(xs: List<dyn Size>) -> int { xs.fold(0, (a, s) -> a + s.size()) }

println("${total([Shape.Dot, Shape.Line(5)])}")
