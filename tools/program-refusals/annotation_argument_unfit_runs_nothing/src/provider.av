use @std.meta.{Fn, Type, Code, Declared, Directive, Diagnostic, refuse}
export fn defaulted(f: Fn, value: int = 7) -> List<Diagnostic> { if value == 7 { [] } else { [refuse("wrong default value")] } }
export fn chosen(f: Fn, expected: int, value: int = 7) -> List<Diagnostic> { if value == expected { [] } else { [refuse("wrong default value")] } }
fn computed() -> int { 9 }
export fn calculated(f: Fn, value: int = computed()) -> List<Diagnostic> { if value == 9 { [] } else { [refuse("wrong computed default")] } }
export fn pair(f: Fn, first: string = "a", second: string = "b") -> List<Diagnostic> { if first == "a" && second == "b" { [] } else { [refuse("wrong pair")] } }
export fn projected(t: Type, value: Code = quote { 7 }) -> Declared {
    Declared {
        made: [
            Directive {
                twin: "",
                name: t.name,
                at: t.at,
                source: quote { impl ${t} { static fn configured() -> int { ${value} } } },
            },
        ],
    }
}
