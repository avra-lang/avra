type P = { xs: List<int>, n: int }

fn chain() -> int {
    const A: int = 6
    const B: int = A * 7
    const C: List<int> = [1, 2, 3].map((x) -> x * B)
    C[2]
}

fn held() -> int {
    const XS: List<int> = [4, 5]
    const P1: P = P { xs: XS, n: XS.length }
    P1.xs[1] + P1.n
}

println("${chain()} ${held()}")
