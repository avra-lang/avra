use @std.ui.components.{column, text}
use @std.ui.tree.view.{View}
use @std.ui.realize.tests.support.{drawn_text}
use @std.ui.tree.view.{tree_of}

component split {
    left: List<dyn View> = []
    right: List<dyn View> = []
    column {
        self.left
        self.right
    }
}

let s = split {
    right {
        text "b"
    }
    left {
        text "a"
    }
}
println(drawn_text(tree_of(s)))
