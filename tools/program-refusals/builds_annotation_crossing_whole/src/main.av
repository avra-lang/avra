use @x.c.{dump_type, dump_fn}

/// A documented record,
/// on two lines.
@dump_type
type P = {
    /// the x
    x: int,
    y: string? = null,
    zs: List<int> = [],
}

/// A documented enum.
@dump_type
enum E {
    /// the unit one
    A
    B(n: int, s: string)
}

@dump_type
type Id = int

/// A documented fn.
@dump_fn
fn f(mut a: List<int>, const b: int, c: string = "d") -> int? { null }

@dump_fn
fn plain() {}

"${dump_P}\n${dump_E}\n${dump_Id}\n${dump_f}\n${dump_plain}"
