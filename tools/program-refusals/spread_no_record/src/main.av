type C = { a: int }

enum E { X }

type Id = int

trait T {
    fn m() -> int
}

type OfOwned = { ..int }

type OfList = { ..List<int> }

type OfAbsent = { ..C? }

type OfDyn = { ..dyn T }

type OfEnum = { ..E }

type OfAlias = { ..Id }

type OfParam<P> = { ..P, x: int }

type Fine = { ..C, b: int }

println("${Fine { a: 1, b: 2 }.a}")
