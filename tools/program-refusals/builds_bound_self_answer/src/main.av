trait Remade<X> {
    fn remade(x: X) -> Self
}

type Held = { n: int }

impl Remade<int> for Held {
    fn remade(x: int) -> Held { Held { n: x } }
}

fn f<R: Remade<int>>(r: R) -> R { r.remade(4) }

fn g<R: Remade<int>>(r: R) -> R {
    let x: R = r.remade(5)
    x
}

println("${f(Held { n: 1 }).n} ${g(Held { n: 1 }).n}")
