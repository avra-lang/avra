use @std.meta.{Diagnostic, refuse}

fn spoken(n: int) -> string { "never said: ${n}" }

component tray {
    capacity: int = 1
    said: fn(int) -> string = spoken
    fn check() -> List<Diagnostic> {
        if self.capacity < 1 { [refuse("a tray holds at least one")] } else { [] }
    }
}

tray t { capacity: 0 }
"${t.capacity}"
