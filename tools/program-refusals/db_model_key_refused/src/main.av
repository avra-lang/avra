use @std.db.{Many, model, unique}

@model
type Tag = { id: int = 0, word: string }

@model
@unique(word, word)
type Dup = { id: int = 0, word: string }

@model
@unique(tags)
type Over = { id: int = 0, tags: Many<Tag> }

@model
@unique(a, b)
@unique(a, b)
type Twice = { id: int = 0, a: string, b: string }

@model
@unique
type Bare = { id: int = 0, a: string }

@model
@unique(wrod)
type Miss = { id: int = 0, word: string }

println("x")
