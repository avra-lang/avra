// A LAMBDA A TEMPLATE WROTE IS EACH COPY'S OWN: two expansions of one component each lift the lambda
// the template writes, though both stand at the template's place, so each reader reads its own
// pattern — the narrow hole refuses `abc` and the text hole takes it — and each walk scales by its
// own factor.
use reader.{Reader, hole, scaled}

let narrow: Reader = hole "/b/{n: int}" {}
let wide: Reader = hole "/b/{slug}" {}
let tens: List<int> = scaled 10 {}
let hundreds: List<int> = scaled 100 {}
"${narrow.pattern} ${(narrow.read)("/b/abc".bytes())} ${wide.pattern} ${(wide.read)("/b/abc".bytes())} ${tens[1]} ${hundreds[1]}"
