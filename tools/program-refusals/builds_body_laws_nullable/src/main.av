fn pick(n: int?) -> int {
    if n != null { return n! + 1 }
    0
}

fn half(n: int?) -> int? {
    let m = n?
    m / 2
}

fn checked(n: int) -> Result<int, string> {
    if n < 0 { fail "negative" }
    .Ok((n << 63) >> 63)
}

let xs: List<int?> = [null, null]
println("${pick(4)} ${pick(null)} ${half(8) ?? 0} ${half(null) ?? 9} ${checked(1) catch 5} ${checked(-1) catch 5} ${xs.length}")
0
