type Ref<T> = { id: string }

impl Ref<T> {
    static fn made(id: string) -> Ref<T>? {
        if id.is_empty() { return null }
        Ref { id: id }
    }
}

type Person = { name: string }

fn pick(id: string) -> string {
    let got: Ref<Person>? = Ref.made(id)
    got?.id ?? "none"
}

"${pick("p1")} ${pick("")}"
