use @std.meta.{Named, Marker}

export fn shape(_d: Named) -> Marker { Marker {} }

trait Area {
    fn area() -> int
}

@shape
type Square = { side: int }

@shape
type Dot = {}

impl Area for Square {
    fn area() -> int { self.side * self.side }
}

collect enum Shape: Area = @shape in self by it.name

println("1")
