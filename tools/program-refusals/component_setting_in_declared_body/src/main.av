// proves: a setting a component's own body writes is refused where it is written, in the setting's
// words: never at the component's head, and never as a record literal's field
use @std.ui.components.{button, row}
use @std.ui.tree.view.{View}

enum Show { All, Done }

enum Mode { Light, System }

state filter: Show = .All
state mode: Mode = .Light

component tab(label: string, state chosen: Show) {
    shows: Show
    button self.label {
        on press { self.chosen = self.shows }
    }
}

component filters {
    row {
        tab "All" { chosen: filter, shows: .All }
        tab "Auto" { chosen: mode, shows: .Done }
    }
}

let boxed: List<dyn View> = [filters {}]
println("${boxed.length}")
