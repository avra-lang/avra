use @std.meta.{Named}
trait Mark {
    fn label() -> string
}
impl Mark for int {
    fn label() -> string { "i" }
}
impl Mark for string {
    fn label() -> string { self }
}
fn mark(what: Named, label: dyn Mark) -> void {}
@mark("a")
fn alpha() {}
@mark(1)
fn beta() {}
type Entry = { name: string }
collect xs: List<Entry> = @mark in self as Entry { name: it.name } by it.mark.args[0]
1
