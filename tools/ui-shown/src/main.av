//! A box and a field each held to what the program shows. Their gestures are heard and change
//! nothing, so after a click the box is unticked again and after typing the field reads "abc".
use @std.ui.components.{checkbox, column, field}
use @std.ui.web.{mount}

fn view() -> column {
    column {
        items: [
            checkbox "x" {
                shown: false
                on change { checked -> }
            },
            field "y" { shown: "abc" },
        ]
    }
}

mount(view)
