// A model's generated impl lands in THIS file, which imports the `text`
// component: the template's own names are judged where the template was
// written, so the impl's `text` is no block word here and the page builds.
use @std.db.{model}
use @std.ui.components.{text}
use @std.ui.web.{mount}

@model
type Todo = { id: int = 0, title: string }

fn shown() -> string {
    match Todo.from_json("{\"id\":3,\"title\":\"a\"}") { .Ok(t) -> t.title, .Err(_) -> "bad" }
}

mount(() -> text shown())
