type St = { rev: int, open: List<int> }
type K = { state: Cell<St>, readers: Cell<List<int>>, stamps: Cell<List<int>> }
fn new_k() -> K {
    let st = St { rev: 1, open: [] }
    let none: List<int> = []
    K { state: Cell.new(st), readers: Cell.new(none), stamps: Cell.new(none) }
}
impl K {
    fn begin(r: int) { self.readers.push(r) }
    fn finish() {
        mut open = self.readers.get()
        let _ = open.pop()
        self.readers.set(open)
    }
    fn stamped(at: int, v: int) {
        while self.stamps.get().length <= at { self.stamps.push(0) }
        self.stamps.set_at(at, v)
    }
}
fn run(n: int) -> int {
    let k = new_k()
    k.begin(7)
    for i in 0..n { k.stamped(i, 7) }
    k.finish()
    k.stamps.get().length * 100000 + k.readers.get().length
}
"${run(1000)}"
