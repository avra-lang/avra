type Reg = { state hits: int = 0 }
state top: int = 0
fn by_seat(state s: int) { s = s + 1 }
fn through_decl() { top = 5 }
fn go() -> string {
    let r = Reg {}
    state local: int = 0
    local = 1
    r.hits = 2
    by_seat(local)
    through_decl()
    let f = () -> { local = 3 }
    f()
    "${local} ${top} ${r.hits}"
}
println(go())
