//! WHAT ONE RECORDED READ COSTS, COUNTED. `DBM_MODE` picks the read and
//! `DBM_N` how many; run under a census runtime at N and at 2N, the
//! difference is N reads and nothing else (tools/db_measure/read_cost.sh).
//!
//!   kernel.last     the key the query appended last, again
//!   kernel.earlier  a key the query read before, another read between
//!   kernel.new      a key the query has not read: a new edge
//!   row.unheard     a relation row by its key, no query open
//!   row.repeat      the same, inside one query, a hundred keys in turn
//!   row.new         the same, a new query every hundred reads
//!   ask.int         a `@query` asked again, its answer standing, by an int
//!   ask.text        the same, by a text
//!   write.unowned   a keyless row with two indexes written, no kernel, no owner
//!   write.owned     the same, in an owner's open run under an open query
use @std.relation.{relation, query}
use @std.relation.db.{Db, new_db}
use @std.relation.engine.{Kernel, Key, new_kernel}
use @std.io.{env_or}
use @std.text.{parse_int}

@relation
type Row = { @key name: string, @index tag: string, n: int }

/// The query cell a bench frame is opened under.
fn asking(queries: int, q: int) -> Key { Key { family: queries, arg: q } }

fn kernel_reads(mode: string, n: int) -> int {
    let kernel = new_kernel()
    let queries = kernel.family((_arg: int) -> 0)
    let cells = kernel.family((_arg: int) -> 0)
    if mode == "kernel.new" {
        for q in 0..n / 1000 {
            kernel.begin(asking(queries, q))
            for i in 0..1000 { kernel.record_at(cells, (q * 37 + i) % 50000) }
            kernel.settle(asking(queries, q), 1)
        }
        return kernel.deps_of(asking(queries, 0)).length
    }
    let one = asking(queries, 0)
    kernel.begin(one)
    let spread = if mode == "kernel.earlier" { 2 } else { 1 }
    for i in 0..n { kernel.record_at(cells, 7 + i % spread) }
    kernel.settle(one, 1)
    kernel.deps_of(one).length
}

fn filled(kernel: Kernel, names: List<string>) -> Db {
    let db = new_db()
    db.given_to(kernel)
    for i, name in names { let _ = Row.insert(db, name: name, tag: "t${i % 10}", n: i) }
    db
}

fn row_reads(mode: string, n: int) -> int {
    let kernel = new_kernel()
    let queries = kernel.family((_arg: int) -> 0)
    let names = ["r${i}" for i in 0..100]
    let db = filled(kernel, names)
    mut sum = 0
    if mode == "row.unheard" {
        for i in 0..n { sum = sum + (Row.by_key(db, RowKey { name: names[i % 100] })?.n ?? 0) }
        return sum
    }
    let per_query = if mode == "row.new" { 100 } else { n }
    for q in 0..n / per_query {
        kernel.begin(asking(queries, q))
        for i in 0..per_query { sum = sum + (Row.by_key(db, RowKey { name: names[i % 100] })?.n ?? 0) }
        kernel.settle(asking(queries, q), 1)
    }
    sum + kernel.deps_of(asking(queries, 0)).length
}

@query
fn after(_db: Db, n: int) -> int { n + 1 }

@query
fn measure(_db: Db, name: string) -> int { name.length }

/// A hundred calls asked once, then `n` asks of them again.
fn asks(mode: string, n: int) -> int {
    let db = new_db()
    let names = ["a_declaration_named_${i}" for i in 0..100]
    mut sum = 0
    for i in 0..100 { sum = sum + after(db, i) + measure(db, names[i]) }
    if mode == "ask.int" {
        for i in 0..n { sum = sum + after(db, i % 100) }
        return sum
    }
    for i in 0..n { sum = sum + measure(db, names[i % 100]) }
    sum
}

@relation
type Use = { @index of: int, @index within: int, n: int }

/// `n` keyless rows written: with no kernel and no owner, or as one run
/// of an owner in a Db its owner's kernel holds, a query open.
fn writes(mode: string, n: int) -> int {
    let db = new_db()
    if mode == "write.unowned" {
        for i in 0..n { let _ = Use.insert(db, of: i % 50, within: i % 7, n: i) }
        return Use.all(db).length
    }
    let kernel = new_kernel()
    db.given_to(kernel)
    let asked = asking(kernel.family((_arg: int) -> 0), 0)
    kernel.begin(asked)
    let owner = db.owner_named("uses")
    let _ = db.opened_run(owner)
    for i in 0..n { let _ = Use.insert(db, of: i % 50, within: i % 7, n: i) }
    db.closed_run(owner)
    kernel.settle(asked, 1)
    Use.all(db).length
}

fn ran(mode: string, n: int) -> int {
    if mode.starts_with("kernel.") { return kernel_reads(mode, n) }
    if mode.starts_with("write.") { return writes(mode, n) }
    if mode.starts_with("ask.") { asks(mode, n) } else { row_reads(mode, n) }
}

println("${ran(env_or("DBM_MODE", "kernel.last"), parse_int(env_or("DBM_N", "0")) ?? 0)}")
