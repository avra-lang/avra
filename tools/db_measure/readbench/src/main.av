//! WHAT ONE ROW READ COSTS, in nanoseconds: a dense list index, `get` on a
//! relation no query is reading, and `get` inside a kernel query — once
//! with the same query throughout (a repeat is the mark's fast path) and
//! once with a new query each pass (every read is a new edge, as a
//! query's first read is) — and a `@query` ASKED again, its answer
//! standing: by an int argument and by a text one.
use @std.relation.{relation, query}
use @std.meta.{dense}
use @std.relation.db.{new_db, Db}
use @std.relation.engine.{Key}
use @std.time.{now_ns}

@dense
type RowId = { index: int }

@relation
type Row = {
    id: RowId,
    @index name: string,
    exported: bool,
    owner: string,
}

type Plain = { name: string, exported: bool, owner: string }

fn filled(db: Db, n: int) {
    for i in 0..n {
        let _ = Row.insert(db, name: "n${i}", exported: i % 3 == 0, owner: "")
    }
}

fn read_rows(db: Db, n: int) -> int {
    mut sum = 0
    for i in 1..n + 1 {
        let x = Row.get(db, RowId { index: i })
        if x != null && x!.exported { sum = sum + 1 }
    }
    sum
}

@query
fn after(_db: Db, n: int) -> int { n + 1 }

@query
fn measure(_db: Db, name: string) -> int { name.length }

fn ask_ints(db: Db, n: int) -> int {
    mut sum = 0
    for i in 0..n { sum = sum + after(db, i) }
    sum
}

fn ask_texts(db: Db, names: List<string>) -> int {
    mut sum = 0
    for name in names { sum = sum + measure(db, name) }
    sum
}

fn read_list(rows: List<Plain>) -> int {
    mut sum = 0
    for r in rows {
        if r.exported { sum = sum + 1 }
    }
    sum
}

fn timed(label: string, n: int, rounds: int, pass: fn(int) -> int) {
    let t = now_ns()
    mut sum = 0
    for r in 0..rounds { sum = sum + pass(r) }
    println("${label}\tns_per_read=${(now_ns() - t) / (n * rounds)}\tchecksum=${sum}")
}

let n = 20000
let rounds = 50
let rows = [Plain { name: "n${i}", exported: i % 3 == 0, owner: "" } for i in 0..n]
timed("list", n, rounds, (_r: int) -> read_list(rows))

let quiet = new_db()
filled(quiet, n)
timed("relation.unrecorded", n, rounds, (_r: int) -> read_rows(quiet, n))

let heard = new_db()
filled(heard, n)
let kernel = heard.engine()
let queries = kernel.family((_arg: int) -> 0)
let one = Key { family: queries, arg: 0 }
kernel.begin(one)
timed("relation.repeat", n, rounds, (_r: int) -> read_rows(heard, n))
kernel.settle(one, 0)
println("edges\t${kernel.deps_of(one).length}")
timed(
    "relation.new_reader",
    n,
    rounds,
    (r: int) -> {
        let each = Key { family: queries, arg: r + 1 }
        kernel.begin(each)
        let sum = read_rows(heard, n)
        kernel.settle(each, 0)
        sum
    },
)
println("edges\t${kernel.deps_of(Key { family: queries, arg: 1 }).length}")

let asked = new_db()
let names = ["a_declaration_named_${i}" for i in 0..n]
let _ = ask_ints(asked, n) + ask_texts(asked, names)
timed("query.ask.int", n, rounds, (_r: int) -> ask_ints(asked, n))
timed("query.ask.text", n, rounds, (_r: int) -> ask_texts(asked, names))
