// proves: a `state` local written without its type is a Cell as one written
// with it is — each call seeds its own, a lambda's write and push land in
// that call's cell, and the binary's own literal is never written.
type R = { xs: List<string> }

fn replaced() -> int {
    state r = R { xs: ["a"] }
    let f = () -> {
        r = R { xs: ["b", "c"] }
        1
    }
    let n = r.xs.length
    let _ = f()
    n * 10 + r.xs.length
}

fn read() -> int {
    state r = R { xs: ["a"] }
    r.xs.push("b")
    r.xs.length
}

fn pushed() -> int {
    state r = R { xs: ["a"] }
    let f = () -> { r.xs.push("b") }
    f()
    r.xs.length
}

fn counted() -> int {
    state n = 1
    let f = () -> { n = n + 1 }
    f()
    n
}

"${replaced()} ${replaced()} ${read()} ${pushed()} ${pushed()} ${counted()} ${counted()}"
