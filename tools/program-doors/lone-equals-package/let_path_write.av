// A WRITE THROUGH A PATH BELOW A PLAIN `let` opens the path's boxes: a writing method on a field of a
// non-`mut` local seeded by a literal writes the local's own copy, never the binary's data, and the
// same literal reads the same on the next run of its statement.
type Bag = { items: List<int> }

impl Bag {
    mut fn add(v: int) { self.items.push(v) }
}

type Shelf = { bag: Bag }

fn grown() -> int {
    let shelf = Shelf { bag: Bag { items: [1] } }
    shelf.bag.add(9)
    shelf.bag.items.length
}

let shelf = Shelf { bag: Bag { items: [1] } }
shelf.bag.add(9)
let first = grown()
let second = grown()
"${shelf.bag.items.length} ${shelf.bag.items[1]} ${first} ${second}"
