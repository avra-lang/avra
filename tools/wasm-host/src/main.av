// A reactor with one host fn that parks: the page's callback enters it, and
// what that callback may do depends on how it entered (tools/wasm-host-check.sh).
use @std.time.{ms, sleep}

// the wait is long enough that a cold engine never finds it already due
extern fn avra_probe_wait(n: int) -> int {
    sleep(ms(20))
    n + 1
}

println("ready")
