//! The board's own paints as the neutral frame: read back, they are the
//! patches the diff made, at every size the board is measured at.
use frame.{native_paints, read_back_whole}

fn whole(n: int) -> bool {
    let paints = native_paints(n)
    read_back_whole(paints.first) && read_back_whole(paints.toggled)
}

spec "the board, as the neutral frame" {
    given "the board with no tasks" {
        then "its paints read back whole" { whole(0) }
    }
    given "the board with one task" {
        then "its paints read back whole" { whole(1) }
    }
    given "the board with a hundred tasks" {
        then "its paints read back whole" { whole(100) }
    }
    given "the board with a thousand tasks" {
        then "its paints read back whole" { whole(1000) }
    }
}
