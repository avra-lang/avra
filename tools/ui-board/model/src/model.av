//! The task board's model, declared once. The server mounts its doors (`Todo.routes`) and the page asks them by
//! their description (`Todo.paths`), so the two cannot disagree about a task's fields or where its doors are.
use @std.crud.{crud}
use @std.json.codec.{json}

/// A task. `Todo` and not `Task`, which is a built-in name.
@crud
@json
export type Todo = { id: int = 0, title: string, done: bool = false }
