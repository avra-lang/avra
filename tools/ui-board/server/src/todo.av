//! A task: one declaration is its table and, read back, its wire shape.
//!
//! It stands here rather than beside the board until two gaps close: a page
//! built for wasm refuses a package's C it never calls, so it cannot carry a
//! model; and `@model` derives a reader but no writer, and cannot stand beside
//! `@json`, so `main.av` spells the writer.
use @std.db.{model}

@model
export type Todo = { id: int = 0, title: string, done: bool = false }
