//! The task board's server: its tasks as a model and the model's doors as
//! routes, over a database file kept under `.avra/`, and the board's page
//! DRAWN HERE, its tasks in it, for the module to adopt. `avra dev` runs this
//! beside the page (`[dev] server = "server"`), tells it the page's files,
//! and forwards every path the page does not own, so the page asks `/tasks`
//! of its own origin.
use @ui.board_model.model.{Todo}
use @ui.board.{view, ship_state, tasks_written}
use @std.json.typed.{array_of}
use @std.ui_http.{Document, app_page}
use @std.errors.{Error}
use @std.http.route.{get, group, Mounted}
use @std.http.server.{server}
use @std.io.{env_or, make_dirs}
use @std.sqlite.{Db}

/// The database file, made and brought to the model's shape.
fn opened() -> Result<Db, string> {
    let path = env_or("BOARD_DB", ".avra/board.db")
    let _ = make_dirs(".avra")
    let db = match Db.open(path) {
        .Ok(d) -> d,
        .Err(e) -> { return .Err("cannot open ${path}: ${e.message}") },
    }
    match Todo.migrate(db) {
        .Ok(_) -> .Ok(db),
        .Err(e) -> .Err("cannot prepare ${path}: ${e.describe().message}"),
    }
}

/// The board's page as it stands now: the tasks read from the database are
/// the answer of the page's own ask, so the page is drawn with them.
fn drawn(db: Db) -> Document {
    let listed = match Todo.all(db) { .Ok(all) -> all, .Err(_) -> [] }
    let _ = tasks_written(array_of([t.json_text() for t in listed]))
    app_page("Tasks", view())
}

fn serving() -> Result<int, string> {
    let db = opened()?
    ship_state()
    server board {
        get "/" { _req -> drawn(db) }
        group "/tasks" { Todo.routes(db) }
    }
    match board.run() { .Ok(n) -> .Ok(n), .Err(e) -> .Err(e.describe().message) }
}

match serving() { .Ok(n) -> "served ${n} connections", .Err(why) -> "ui-board-server: ${why}" }
