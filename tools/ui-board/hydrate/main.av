//! The board's first page as a server draws it: the print the module checks
//! itself against, then the bytes of the HTML around it. It stands in the
//! board's own package (`tools/ui_board.sh` copies it over `src/main.av`), so
//! every site the board wrote has the name the page's module gave it.
use @std.ui.realize.html.html.{hydration}
use @std.ui.tree.view.{tree_of}

let sent = hydration(tree_of(view()), theme())
println("${sent.print}")
println("${sent.html.bytes().length}")
