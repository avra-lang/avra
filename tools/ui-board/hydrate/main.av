//! The board's first page as a server draws it: the print the module checks
//! itself against, the bytes of the HTML around it, then the whole document a
//! page loads (from the fourth line on: its sheet spans lines), after the shipped state's one line. It stands in the board's own package (`tools/ui_board.sh`
//! copies it over `src/main.av`), so every site the board wrote has the name
//! the page's module gave it.
use @std.ui.env.{Env}
use @std.ui.realize.html.html.{Page, hydration, takeover}
use @std.ui.shipped.{document}
use @std.ui.tree.view.{tree_of}

// A server's handler reads its tasks from its database before it draws; this stands in for that read.
let _ = tasks_written(
    "[{\"id\":\"1\",\"title\":\"Draft the spec\",\"done\":true},{\"id\":\"2\",\"title\":\"Wire the event channel\",\"done\":false},{\"id\":\"3\",\"title\":\"Land the wasm board\",\"done\":false},{\"id\":\"4\",\"title\":\"Write the tour\",\"done\":true}]",
)
requested()
ship_state()
let sent = hydration(tree_of(view()), theme())
println("${sent.print}")
println("${sent.html.bytes().length}")
println(document())
println(
    takeover(
        Page { title: "Tasks", env: Env { theme: theme() } },
        tree_of(view()),
        "/app.wasm",
        "/avra",
        document(),
    ),
)
