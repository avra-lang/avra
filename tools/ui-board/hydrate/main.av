//! The board's first page as a server draws it: the print the module checks
//! itself against, the bytes of the HTML around it, then the whole document a
//! page loads (from the third line on: its sheet spans lines). It stands in the board's own package (`tools/ui_board.sh`
//! copies it over `src/main.av`), so every site the board wrote has the name
//! the page's module gave it.
use @std.ui.env.{Env}
use @std.ui.realize.html.html.{Page, hydration, takeover}
use @std.ui.tree.view.{tree_of}

let sent = hydration(tree_of(view()), theme())
println("${sent.print}")
println("${sent.html.bytes().length}")
println(
    takeover(
        Page { title: "Tasks", env: Env { theme: theme() } },
        tree_of(view()),
        "/app.wasm",
        "/avra",
    ),
)
